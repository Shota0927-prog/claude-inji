//@version=6
// =============================================================================
//  ZoneEngineV2_Rebuild_VisualHarness
//  One engine instance, one update per confirmed 5m bar, display only.
//  Nothing in this file may change an engine decision: it reads views and
//  events and drives reused drawing objects.
//
//  !! Before compiling: replace YOUR_TV_USERNAME and the library version with
//     the values TradingView issues when ZoneEngineV2_Rebuild is published.
// =============================================================================
indicator("ZoneEngine v2 Rebuild - Visual Harness", "ZEV2R", overlay = true,
     max_boxes_count = 120, max_lines_count = 120, max_labels_count = 120, max_bars_back = 1000)

import YOUR_TV_USERNAME/ZoneEngineV2_Rebuild/1 as ze

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
gL = "Zone logic"
i_M          = input.float(20.0, "M / clusterMaxWidth", minval = 0.01, group = gL)
i_denseRatio = input.float(0.50, "denseRatio", minval = 0.01, maxval = 1.0, group = gL)
i_reset      = input.float(10.0, "touchResetDistance", minval = 0.01, group = gL)
i_strongUntil = input.int(1, "strongUntilTouch", minval = 1, group = gL)
i_strongUnl   = input.bool(false, "strongUnlimited", group = gL)
i_weakFrom    = input.int(2, "weakFromTouch", minval = 2, group = gL)
i_weakFromOff = input.bool(false, "weakFromTouch OFF", group = gL)
i_weakDepth   = input.float(50.0, "weakDepthPct", minval = 0.0, maxval = 100.0, group = gL)
i_weakDepthOff = input.bool(false, "weakDepth OFF", group = gL)
i_breakBuf    = input.float(2.0, "breakBuffer", minval = 0.0, group = gL)
i_touchTol    = input.float(0.0, "touchTolerance", minval = 0.0, group = gL)

gS = "Sources"
i_slopeLb = input.int(60, "EMA slope lookback (1m bars)", minval = 1, group = gS)
i_len5    = input.int(10, "Swing pivot 5m", minval = 1, group = gS)
i_len15   = input.int(8,  "Swing pivot 15m", minval = 1, group = gS)
i_len1h   = input.int(6,  "Swing pivot 1H", minval = 1, group = gS)

gA = "Accum detection"
i_acRange  = input.int(10, "accumRangeLen", minval = 2, group = gA)
i_acBase   = input.int(20, "accumBaseLen", minval = 2, group = gA)
i_acAtr    = input.int(14, "accumAtrLen", minval = 1, group = gA)
i_acUpper  = input.int(4, "accumMinUpperCloses", minval = 0, group = gA)
i_acLower  = input.int(4, "accumMinLowerCloses", minval = 0, group = gA)
i_acRun    = input.int(4, "accumMaxSameColorRun", minval = 1, group = gA)
i_acMult   = input.float(2.5, "accumAtrMult", minval = 0.1, group = gA)
i_acRatio  = input.float(0.70, "accumBarRatioMax", minval = 0.1, group = gA)
i_acDrift  = input.float(0.30, "accumDriftMax", minval = 0.0, group = gA)

gTime = "Time settings (spec 3.4: timezone and cut times are configurable)"
i_tz        = input.string("Asia/Tokyo", "zoneTimezone", group = gTime)
i_asiaMin   = input.int(540,  "Asia session start (minutes from local midnight)", minval = 0, maxval = 1440, group = gTime)
i_europeMin = input.int(840,  "Europe session start", minval = 0, maxval = 1440, group = gTime)
i_nyStartMin = input.int(1140, "New York session start", minval = 0, maxval = 1440, group = gTime)
i_nyEndMin   = input.int(180,  "New York session end (next day)", minval = 0, maxval = 1440, group = gTime)
i_dayCutMin  = input.int(300,  "Day cut", minval = 0, maxval = 1439, group = gTime)
i_weekCutDow = input.int(2,    "Week cut day of week (1=Sun .. 7=Sat)", minval = 1, maxval = 7, group = gTime)

gC = "Categories"
i_catMa    = input.bool(true, "MA", group = gC)
i_catSwing = input.bool(true, "Swing", group = gC)
i_catAccum = input.bool(true, "Accum", group = gC)
i_catTime  = input.bool(true, "Time high/low", group = gC)
i_catFvg   = input.bool(true, "HTF FVG", group = gC)
i_catPsych = input.bool(true, "Psychological", group = gC)

gT = "Storage"
i_maxSwing = input.int(180, "maxSwingRoots", minval = 1, group = gT)
i_maxAccum = input.int(60, "maxAccumBoxes", minval = 1, group = gT)
i_maxFvg   = input.int(120, "maxFvgRoots", minval = 1, group = gT)
i_maxTime  = input.int(32, "maxTimeRoots", minval = 1, group = gT)
i_maxCores = input.int(80, "maxZoneCores", minval = 1, group = gT)
i_maxEnded = input.int(30, "maxEndedGenerations", minval = 0, group = gT)
i_maxMarks = input.int(64, "maxTouchMarksPerCore", minval = 1, group = gT)
i_dormant  = input.float(500.0, "dormantDistance", minval = 1.0, group = gT)

gD = "Display"
i_maxZones  = input.int(30, "maxZonesDrawn", minval = 1, maxval = 60, group = gD)
i_showLabel = input.bool(true, "Labels", group = gD)
i_showDebug = input.bool(true, "Debug table", group = gD)
i_showRootDbg = input.bool(false, "Root debug table", group = gD)
i_showFvg50 = input.bool(false, "FVG NativeRange 50% line (DISPLAY ONLY)", group = gD)
i_zoneBars  = input.int(60, "Zone box width (bars)", minval = 5, group = gD)

// -----------------------------------------------------------------------------
// Configuration object. Every ZoneCfg field the specification allows to change
// is wired to an input; the engine re-validates it on every confirmed bar.
// -----------------------------------------------------------------------------
var ze.ZoneCfg cfg = ze.newCfg()
if barstate.isfirst
    cfg.clusterMaxWidth := i_M
    cfg.denseRatio := i_denseRatio
    cfg.touchResetDistance := i_reset
    cfg.strongUntilTouch := i_strongUntil
    cfg.strongUnlimited := i_strongUnl
    cfg.weakFromTouch := i_weakFrom
    cfg.weakFromTouchOff := i_weakFromOff
    cfg.weakDepthPct := i_weakDepth
    cfg.weakDepthOff := i_weakDepthOff
    cfg.breakBuffer := i_breakBuf
    cfg.touchTolerance := i_touchTol
    cfg.emaSlopeLookback := i_slopeLb
    cfg.swingLen5m := i_len5
    cfg.swingLen15m := i_len15
    cfg.swingLen1h := i_len1h
    cfg.accumRangeLen := i_acRange
    cfg.accumBaseLen := i_acBase
    cfg.accumAtrLen := i_acAtr
    cfg.accumMinUpperCloses := i_acUpper
    cfg.accumMinLowerCloses := i_acLower
    cfg.accumMaxSameColorRun := i_acRun
    cfg.accumAtrMult := i_acMult
    cfg.accumBarRatioMax := i_acRatio
    cfg.accumDriftMax := i_acDrift
    cfg.zoneTimezone := i_tz
    cfg.asiaStartMin := i_asiaMin
    cfg.europeStartMin := i_europeMin
    cfg.nyStartMin := i_nyStartMin
    cfg.nyEndMin := i_nyEndMin
    cfg.dayCutMin := i_dayCutMin
    cfg.weekCutDow := i_weekCutDow
    cfg.catMa := i_catMa
    cfg.catSwing := i_catSwing
    cfg.catAccum := i_catAccum
    cfg.catTime := i_catTime
    cfg.catFvg := i_catFvg
    cfg.catPsych := i_catPsych
    cfg.maxSwingRoots := i_maxSwing
    cfg.maxAccumBoxes := i_maxAccum
    cfg.maxFvgRoots := i_maxFvg
    cfg.maxTimeRoots := i_maxTime
    cfg.maxZoneCores := i_maxCores
    cfg.maxEndedGenerations := i_maxEnded
    cfg.maxTouchMarksPerCore := i_maxMarks
    cfg.dormantDistance := i_dormant
    cfg.mintick := syminfo.mintick

var ze.ZoneEngine eng = ze.newEngine()

// -----------------------------------------------------------------------------
// Source feeds - one request context per timeframe, lookahead_off everywhere.
//   1m   : EMA2000 / EMA3000 / both slopes / source close time
//   5m   : swing computed directly on the chart (same confirmed values)
//   15m  : swing
//   1H   : swing + accum + FVG + confirmed source bar
//   4H/1D: accum + FVG + confirmed source bar
// Total: 5 request contexts, 5 + 8 + 29 + 21 + 21 = 84 tuple elements.
// -----------------------------------------------------------------------------
[m_e2, m_s2, m_e3, m_s3, m_t] = request.security(syminfo.tickerid, "1",
     ze.maPackV2(i_slopeLb), lookahead = barmerge.lookahead_off)

[p5hP, p5hO, p5hE, p5hC, p5lP, p5lO, p5lE, p5lC] = ze.pivotPackV2(i_len5)

[p15hP, p15hO, p15hE, p15hC, p15lP, p15lO, p15lE, p15lC] = request.security(syminfo.tickerid, "15",
     ze.pivotPackV2(i_len15), lookahead = barmerge.lookahead_off)

[h1phP, h1phO, h1phE, h1phC, h1plP, h1plO, h1plE, h1plC,
 h1aNew, h1aTop, h1aBot, h1aId, h1aStart, h1aConf,
 h1fbN, h1fbT, h1fbB, h1fbO, h1fbC, h1fsN, h1fsT, h1fsB, h1fsO, h1fsC,
 h1sH, h1sL, h1sC, h1sOT, h1sCT] = request.security(syminfo.tickerid, "60",
     ze.htfPackSwingV2(i_len1h, i_acRange, i_acBase, i_acAtr, i_acUpper, i_acLower, i_acRun, i_acMult, i_acRatio, i_acDrift),
     lookahead = barmerge.lookahead_off)

[h4aNew, h4aTop, h4aBot, h4aId, h4aStart, h4aConf,
 h4fbN, h4fbT, h4fbB, h4fbO, h4fbC, h4fsN, h4fsT, h4fsB, h4fsO, h4fsC,
 h4sH, h4sL, h4sC, h4sOT, h4sCT] = request.security(syminfo.tickerid, "240",
     ze.htfPackV2(i_acRange, i_acBase, i_acAtr, i_acUpper, i_acLower, i_acRun, i_acMult, i_acRatio, i_acDrift),
     lookahead = barmerge.lookahead_off)

[hDaNew, hDaTop, hDaBot, hDaId, hDaStart, hDaConf,
 hDfbN, hDfbT, hDfbB, hDfbO, hDfbC, hDfsN, hDfsT, hDfsB, hDfsO, hDfsC,
 hDsH, hDsL, hDsC, hDsOT, hDsCT] = request.security(syminfo.tickerid, "1D",
     ze.htfPackV2(i_acRange, i_acBase, i_acAtr, i_acUpper, i_acLower, i_acRun, i_acMult, i_acRatio, i_acDrift),
     lookahead = barmerge.lookahead_off)

// -----------------------------------------------------------------------------
// Engine update: exactly once per confirmed base bar
// -----------------------------------------------------------------------------
bool engineRan = false
if barstate.isconfirmed
    ze.BaseFeed bf = ze.newBaseFeed(open, high, low, close, close[1], time, time_close, 0, true, syminfo.mintick)
    ze.MaPack ma = ze.newMaPack(m_e2, m_s2, m_e3, m_s3, m_t)
    ze.PivotPack sw5  = ze.newPivotPack(5,   p5hP,  p5hO,  p5hE,  p5hC,  p5lP,  p5lO,  p5lE,  p5lC)
    ze.PivotPack sw15 = ze.newPivotPack(15,  p15hP, p15hO, p15hE, p15hC, p15lP, p15lO, p15lE, p15lC)
    ze.PivotPack sw1h = ze.newPivotPack(60,  h1phP, h1phO, h1phE, h1phC, h1plP, h1plO, h1plE, h1plC)
    ze.AccumPack ac1  = ze.newAccumPack(60,   h1aNew, h1aTop, h1aBot, h1aId, h1aStart, h1aConf)
    ze.AccumPack ac4  = ze.newAccumPack(240,  h4aNew, h4aTop, h4aBot, h4aId, h4aStart, h4aConf)
    ze.AccumPack acD  = ze.newAccumPack(1440, hDaNew, hDaTop, hDaBot, hDaId, hDaStart, hDaConf)
    ze.FvgPack fv1 = ze.newFvgPack(60,   h1fbN, h1fbT, h1fbB, h1fbO, h1fbC, h1fsN, h1fsT, h1fsB, h1fsO, h1fsC, h1sH, h1sL, h1sC, h1sOT, h1sCT)
    ze.FvgPack fv4 = ze.newFvgPack(240,  h4fbN, h4fbT, h4fbB, h4fbO, h4fbC, h4fsN, h4fsT, h4fsB, h4fsO, h4fsC, h4sH, h4sL, h4sC, h4sOT, h4sCT)
    ze.FvgPack fvD = ze.newFvgPack(1440, hDfbN, hDfbT, hDfbB, hDfbO, hDfbC, hDfsN, hDfsT, hDfsB, hDfsO, hDfsC, hDsH, hDsL, hDsC, hDsOT, hDsCT)
    engineRan := ze.update(eng, cfg, bf, ma, sw5, sw15, sw1h, ac1, ac4, acD, fv1, fv4, fvD)

// -----------------------------------------------------------------------------
// Drawing objects are created once and updated with setters. They are never
// deleted and re-created, and drawing never writes back into the engine.
// -----------------------------------------------------------------------------
var array<box>   zBox   = array.new<box>()
var array<line>  zLine  = array.new<line>()
var array<label> zLabel = array.new<label>()
var line fvg50Line = na
var label fvg50Label = na

if barstate.isfirst
    for i = 0 to i_maxZones - 1
        array.push(zBox, box.new(bar_index, close, bar_index, close,
             border_color = color.new(color.gray, 100), bgcolor = color.new(color.gray, 100)))
        array.push(zLine, line.new(bar_index, close, bar_index, close,
             color = color.new(color.gray, 100), width = 1))
        array.push(zLabel, label.new(bar_index, close, "", style = label.style_label_left,
             color = color.new(color.gray, 100), textcolor = color.new(color.white, 100), size = size.tiny))
    fvg50Line := line.new(bar_index, close, bar_index, close, color = color.new(color.gray, 100), style = line.style_dotted)
    fvg50Label := label.new(bar_index, close, "", style = label.style_label_left,
         color = color.new(color.gray, 100), textcolor = color.new(color.white, 100), size = size.tiny)

zoneColor(int side, int grade, int phase, bool broad) =>
    color baseCol = grade == ze.codeGradeUnavail() or phase == ze.codePhaseBroken() or phase == ze.codePhaseFlipWait() ?
         color.gray : side == ze.codeSideSupport() ? color.green : color.red
    int tr = broad ? 93 : grade == ze.codeGradeStrong() ? 72 : grade == ze.codeGradeNeutral() ? 84 : 91
    color.new(baseCol, tr)

zoneBorder(int side, int grade, int phase) =>
    color baseCol = grade == ze.codeGradeUnavail() or phase == ze.codePhaseBroken() or phase == ze.codePhaseFlipWait() ?
         color.gray : side == ze.codeSideSupport() ? color.green : color.red
    color.new(baseCol, phase == ze.codePhaseActive() ? 0 : 35)

if barstate.islast
    int vn = ze.viewCount(eng)
    array<float> dist = array.new<float>()
    if vn > 0
        for i = 0 to vn - 1
            ze.ZoneView v = ze.viewAt(eng, i)
            float d = na(v.effectiveBottom) ? 1.0e9 :
                 v.effectiveTop < close ? close - v.effectiveTop :
                 v.effectiveBottom > close ? v.effectiveBottom - close : 0.0
            array.push(dist, d)
    array<int> ord = array.size(dist) > 0 ? array.sort_indices(dist, order.ascending) : array.new<int>()
    int drawCount = array.size(ord) < i_maxZones ? array.size(ord) : i_maxZones
    for s = 0 to i_maxZones - 1
        box b = array.get(zBox, s)
        line l = array.get(zLine, s)
        label lb = array.get(zLabel, s)
        if s < drawCount
            ze.ZoneView v = ze.viewAt(eng, array.get(ord, s))
            bool oneLine = v.effectiveTop <= v.effectiveBottom
            color fill = zoneColor(v.side, v.grade, v.phase, v.isBroadContext)
            color brd = zoneBorder(v.side, v.grade, v.phase)
            int leftX = bar_index - i_zoneBars
            int rightX = bar_index + 3
            if oneLine
                box.set_bgcolor(b, color.new(color.gray, 100))
                box.set_border_color(b, color.new(color.gray, 100))
                line.set_xy1(l, leftX, v.effectiveBottom)
                line.set_xy2(l, rightX, v.effectiveBottom)
                line.set_color(l, brd)
                line.set_style(l, v.phase == ze.codePhaseBroken() or v.phase == ze.codePhaseFlipWait() ?
                     line.style_dashed : line.style_solid)
                line.set_width(l, v.phase == ze.codePhaseActive() ? 2 : 1)
            else
                line.set_color(l, color.new(color.gray, 100))
                box.set_lefttop(b, leftX, v.effectiveTop)
                box.set_rightbottom(b, rightX, v.effectiveBottom)
                box.set_bgcolor(b, fill)
                box.set_border_color(b, brd)
                box.set_border_style(b, v.isBroadContext or v.phase == ze.codePhaseBroken() or v.phase == ze.codePhaseFlipWait() ?
                     line.style_dashed : line.style_solid)
                box.set_border_width(b, v.phase == ze.codePhaseActive() ? 2 : 1)
            if i_showLabel
                label.set_xy(lb, rightX, oneLine ? v.effectiveBottom : (v.effectiveTop + v.effectiveBottom) * 0.5)
                label.set_text(lb, ze.viewLabelText(eng, v))
                label.set_color(lb, color.new(color.black, 20))
                label.set_textcolor(lb, color.white)
            else
                label.set_text(lb, "")
                label.set_color(lb, color.new(color.gray, 100))
                label.set_textcolor(lb, color.new(color.gray, 100))
        else
            box.set_bgcolor(b, color.new(color.gray, 100))
            box.set_border_color(b, color.new(color.gray, 100))
            line.set_color(l, color.new(color.gray, 100))
            label.set_text(lb, "")
            label.set_color(lb, color.new(color.gray, 100))
            label.set_textcolor(lb, color.new(color.gray, 100))
    // FVG 50% is the midpoint of the participating FVG NativeRange, display
    // only, and is never passed back into the engine.
    float mid50 = na
    if i_showFvg50 and drawCount > 0
        for s = 0 to drawCount - 1
            ze.ZoneView vv = ze.viewAt(eng, array.get(ord, s))
            if na(mid50)
                mid50 := ze.fvgNativeMid(vv)
    if not na(mid50)
        line.set_xy1(fvg50Line, bar_index - i_zoneBars, mid50)
        line.set_xy2(fvg50Line, bar_index + 3, mid50)
        line.set_color(fvg50Line, color.new(color.silver, 30))
        label.set_xy(fvg50Label, bar_index + 3, mid50)
        label.set_text(fvg50Label, "FVG NativeRange 50% - DISPLAY ONLY")
        label.set_color(fvg50Label, color.new(color.black, 30))
        label.set_textcolor(fvg50Label, color.silver)
    else
        line.set_color(fvg50Line, color.new(color.gray, 100))
        label.set_text(fvg50Label, "")
        label.set_color(fvg50Label, color.new(color.gray, 100))
        label.set_textcolor(fvg50Label, color.new(color.gray, 100))

// -----------------------------------------------------------------------------
// Debug tables. Switching them off must not change any engine result.
// -----------------------------------------------------------------------------
var table dbg = table.new(position.top_right, 2, 18, border_width = 1)
var table rdbg = table.new(position.bottom_right, 1, 12, border_width = 1)

dbgRow(table t, int r, string k, string v) =>
    table.cell(t, 0, r, k, text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.black, 30), text_halign = text.align_left)
    table.cell(t, 1, r, v, text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.black, 30), text_halign = text.align_left)

tstr(int t) =>
    na(t) ? "-" : str.format_time(t, "MM-dd HH:mm", "Asia/Tokyo")

if barstate.islast and i_showDebug
    int evn = ze.eventCount(eng)
    string evTxt = ""
    if evn > 0
        for i = 0 to evn - 1
            evTxt += ze.eventName(ze.eventAt(eng, i).eventType) + " "
    int rc = ze.rootCount(eng)
    int cc = ze.coreCount(eng)
    int vc = ze.viewCount(eng)
    int kc = ze.candidateCount(eng)
    string zeroWhy = vc > 0 ? "-" :
         not ze.engineConfigValid(eng) ? "config invalid" :
         na(ze.lastBaseTime(eng)) ? "engine never updated" :
         rc == 0 ? "engine updated, 0 roots" :
         kc == 0 ? "engine updated, roots present, 0 candidates" :
         cc == 0 ? "candidates present, 0 cores" : "cores present, 0 views"
    dbgRow(dbg, 0,  "build", ze.buildId())
    dbgRow(dbg, 1,  "config", ze.engineConfigValid(eng) ? "valid" : "INVALID: " + ze.engineConfigError(eng))
    dbgRow(dbg, 2,  "last base bar", tstr(ze.lastBaseTime(eng)) + "  seq " + str.tostring(ze.lastBaseSeq(eng)))
    dbgRow(dbg, 3,  "src 1m MA", tstr(ze.lastMaSourceTime(eng)))
    dbgRow(dbg, 4,  "src FVG 1H/4H/1D", tstr(ze.lastFvgSourceTime(eng, 60)) + " / " + tstr(ze.lastFvgSourceTime(eng, 240)) + " / " + tstr(ze.lastFvgSourceTime(eng, 1440)))
    dbgRow(dbg, 5,  "src Accum 1H/4H/1D", tstr(ze.lastAccumConfirmTime(eng, 60)) + " / " + tstr(ze.lastAccumConfirmTime(eng, 240)) + " / " + tstr(ze.lastAccumConfirmTime(eng, 1440)))
    dbgRow(dbg, 6,  "roots", str.tostring(rc))
    dbgRow(dbg, 7,  "candidates", str.tostring(kc))
    dbgRow(dbg, 8,  "cores / views", str.tostring(cc) + " / " + str.tostring(vc))
    dbgRow(dbg, 9,  "zone 0 reason", zeroWhy)
    dbgRow(dbg, 10, "pending topo / gen", str.tostring(ze.pendingTopologyCount(eng)) + " / " + str.tostring(ze.pendingGenerationCount(eng)) + "  deferred " + str.tostring(ze.statDeferred(eng)))
    dbgRow(dbg, 11, "merge / split", str.tostring(ze.statMerges(eng)) + " / " + str.tostring(ze.statSplits(eng)) + "  matches " + str.tostring(ze.statCoreMatches(eng)))
    dbgRow(dbg, 12, "window evals / rounds", str.tostring(ze.statWindowEvals(eng)) + " / " + str.tostring(ze.statDenseRounds(eng)))
    dbgRow(dbg, 13, "prune", (ze.storagePruned(eng) ? "yes" : "no") + " r" + str.tostring(ze.prunedRootCount(eng)) + " z" + str.tostring(ze.prunedZoneCount(eng)) +
         (ze.touchHistoryTruncated(eng) ? " TOUCH-TRUNC" : "") + (ze.storageOverLimit(eng) ? " OVER-LIMIT" : "") + (ze.scratchOverflow(eng) ? " SCRATCH" : ""))
    dbgRow(dbg, 14, "ended generations", str.tostring(ze.endedGenerationCount(eng)))
    dbgRow(dbg, 15, "MA slope", ze.maSlopeText(eng))
    dbgRow(dbg, 16, "session / day / week", str.tostring(ze.sessionId(eng)) + " / " + str.tostring(ze.dayKey(eng)) + " / " + str.tostring(ze.weekKey(eng)))
    dbgRow(dbg, 17, "bar events", evn == 0 ? "-" : evTxt)

if barstate.islast and i_showRootDbg
    int rn = ze.rootCount(eng)
    table.cell(rdbg, 0, 0, "roots " + str.tostring(rn) + (timeframe.period == "5" ? "" : "  << chart TF is not 5m"),
         text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.black, 30), text_halign = text.align_left)
    for i = 0 to 10
        string txt = i < rn ? ze.rootInfo(ze.rootAt(eng, i)) : ""
        table.cell(rdbg, 0, i + 1, txt, text_size = size.tiny, text_color = color.white,
             bgcolor = color.new(color.black, 40), text_halign = text.align_left)

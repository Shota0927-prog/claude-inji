//@version=6
// =====================================================================================
// ZoneEngineV2_Rebuild_VisualHarness.pine
// Imports the Production Library exactly once and owns ONE Engine instance.
// Responsibilities: the five source requests, Feed assembly, last-bar drawing.
// Forbidden here (App. C 22.5): strategy(), entries, win/loss, environment filters,
// picking a single Zone, or any re-implementation of Zone logic.
//
// IMPORTANT: replace USERNAME/ZoneEngineV2_Rebuild/1 with the published library path.
// =====================================================================================
indicator("ZoneEngineV2 Rebuild - Visual Harness", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

import USERNAME/ZoneEngineV2_Rebuild/1 as ZE

// -------------------------------------------------------------------------------------
// Inputs (App. A 4 initial values; nothing is hard coded inside a decision)
// -------------------------------------------------------------------------------------
gLogic          = "Logic"
inClusterMax    = input.float(20.0, "M  clusterMaxWidth", group = gLogic)
inDenseRatio    = input.float(0.50, "denseRatio", group = gLogic)
inResetDist     = input.float(10.0, "touchResetDistance", group = gLogic)
inStrongUntil   = input.int(1, "strongUntilTouch", group = gLogic)
inStrongUnlim   = input.bool(false, "strongUnlimited", group = gLogic)
inWeakFrom      = input.int(2, "weakFromTouch", group = gLogic)
inWeakFromOff   = input.bool(false, "weakFromTouchOff", group = gLogic)
inWeakDepthPct  = input.float(50.0, "weakDepthPct", group = gLogic)
inWeakDepthOff  = input.bool(false, "weakDepthOff", group = gLogic)
inBreakBuffer   = input.float(2.0, "breakBuffer", group = gLogic)
inTouchTol      = input.float(0.0, "touchTolerance", group = gLogic)
inEmaLookback   = input.int(60, "emaSlopeLookback (1m bars)", group = gLogic)
inSwing5        = input.int(10, "swingLen5m", group = gLogic)
inSwing15       = input.int(8, "swingLen15m", group = gLogic)
inSwing1h       = input.int(6, "swingLen1h", group = gLogic)

gAccum          = "Accum"
inAccRangeLen   = input.int(10, "accumRangeLen", group = gAccum)
inAccBaseLen    = input.int(20, "accumBaseLen", group = gAccum)
inAccAtrLen     = input.int(14, "accumAtrLen", group = gAccum)
inAccMinUpper   = input.int(4, "accumMinUpperCloses", group = gAccum)
inAccMinLower   = input.int(4, "accumMinLowerCloses", group = gAccum)
inAccMaxRun     = input.int(4, "accumMaxSameColorRun", group = gAccum)
inAccAtrMult    = input.float(2.5, "accumAtrMult", group = gAccum)
inAccBarRatio   = input.float(0.70, "accumBarRatioMax", group = gAccum)
inAccDrift      = input.float(0.30, "accumDriftMax", group = gAccum)

gCat            = "Categories"
inCatMa         = input.bool(true, "MA", group = gCat)
inCatSwing      = input.bool(true, "Swing", group = gCat)
inCatAccum      = input.bool(true, "Accum", group = gCat)
inCatTime       = input.bool(true, "Time High/Low", group = gCat)
inCatFvg        = input.bool(true, "HTF FVG", group = gCat)
inCatPsych      = input.bool(true, "Psychological", group = gCat)

gStore          = "Storage / display"
inMaxSwing      = input.int(180, "maxSwingRoots", group = gStore)
inMaxAccum      = input.int(60, "maxAccumBoxes", group = gStore)
inMaxFvg        = input.int(120, "maxFvgRoots", group = gStore)
inMaxTime       = input.int(32, "maxTimeRoots", group = gStore)
inMaxCores      = input.int(80, "maxZoneCores", group = gStore)
inMaxEndedGen   = input.int(30, "maxEndedGenerations", group = gStore)
inMaxTouchMarks = input.int(64, "maxTouchMarksPerCore", group = gStore)
inDormant       = input.float(500.0, "dormantDistance", group = gStore)
inMaxZonesDrawn = input.int(30, "maxZonesDrawn", group = gStore)
inMaxLabels     = input.int(30, "maxLabelsDrawn", group = gStore)
inTz            = input.string("Asia/Tokyo", "zoneTimezone", group = gStore)
inDebug         = input.bool(false, "Debug table / root list", group = gStore)

// -------------------------------------------------------------------------------------
// Cfg (validated by the library; never auto corrected here)
// -------------------------------------------------------------------------------------
var ZE.ZoneCfg cfg = ZE.newCfg()
if barstate.isfirst or bar_index == 0
    cfg.clusterMaxWidth := inClusterMax
    cfg.denseRatio := inDenseRatio
    cfg.touchResetDistance := inResetDist
    cfg.strongUntilTouch := inStrongUntil
    cfg.strongUnlimited := inStrongUnlim
    cfg.weakFromTouch := inWeakFrom
    cfg.weakFromTouchOff := inWeakFromOff
    cfg.weakDepthPct := inWeakDepthPct
    cfg.weakDepthOff := inWeakDepthOff
    cfg.breakBuffer := inBreakBuffer
    cfg.touchTolerance := inTouchTol
    cfg.emaSlopeLookback := inEmaLookback
    cfg.swingLen5m := inSwing5
    cfg.swingLen15m := inSwing15
    cfg.swingLen1h := inSwing1h
    cfg.accumRangeLen := inAccRangeLen
    cfg.accumBaseLen := inAccBaseLen
    cfg.accumAtrLen := inAccAtrLen
    cfg.accumMinUpperCloses := inAccMinUpper
    cfg.accumMinLowerCloses := inAccMinLower
    cfg.accumMaxSameColorRun := inAccMaxRun
    cfg.accumAtrMult := inAccAtrMult
    cfg.accumBarRatioMax := inAccBarRatio
    cfg.accumDriftMax := inAccDrift
    cfg.catMaOn := inCatMa
    cfg.catSwingOn := inCatSwing
    cfg.catAccumOn := inCatAccum
    cfg.catTimeHlOn := inCatTime
    cfg.catFvgOn := inCatFvg
    cfg.catPsychOn := inCatPsych
    cfg.maxSwingRoots := inMaxSwing
    cfg.maxAccumBoxes := inMaxAccum
    cfg.maxFvgRoots := inMaxFvg
    cfg.maxTimeRoots := inMaxTime
    cfg.maxZoneCores := inMaxCores
    cfg.maxEndedGenerations := inMaxEndedGen
    cfg.maxTouchMarksPerCore := inMaxTouchMarks
    cfg.dormantDistance := inDormant
    cfg.maxZonesDrawn := inMaxZonesDrawn
    cfg.maxLabelsDrawn := inMaxLabels
    cfg.zoneTimezone := inTz
    cfg.mintick := syminfo.mintick
    cfg.baseTfMinutes := 5

var ZE.ZoneEngine eng = ZE.newEngine(cfg)
var ZE.Feed feed = ZE.newFeed()

// =====================================================================================
// Source helpers (I7). Exactly five request contexts, gaps_off + lookahead_off,
// adoption driven by sourceCloseTime -- never a mechanical [1].
// =====================================================================================
f_maPack(int lookback) =>
    e2 = ta.ema(close, 2000)
    e3 = ta.ema(close, 3000)
    [e2, e2 - e2[lookback], e3, e3 - e3[lookback], time_close]

f_pivotPack(int len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    [ph, pl, time[len], time_close[len], time_close]

// Accum formation formula exactly as specified in App. A 7.4
f_accumPack(int N, int B, int atrLen, int minUp, int minLow, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    bodyTop = math.max(open, close)
    bodyBot = math.min(open, close)
    rangeHigh = ta.highest(bodyTop, N)
    rangeLow = ta.lowest(bodyBot, N)
    rangeNow = rangeHigh - rangeLow
    rangeMid = (rangeHigh + rangeLow) * 0.5
    rangeBase = ta.highest(bodyTop, B) - ta.lowest(bodyBot, B)
    atrValue = ta.atr(atrLen)
    upperCloses = 0
    lowerCloses = 0
    if (N - 1) >= (0)
        for i = 0 to N - 1
            c = close[i]
            if c > rangeMid
                upperCloses += 1
            else if c < rangeMid
                lowerCloses += 1
    startMid = (open[N - 1] + close[N - 1]) * 0.5
    endMid = (open + close) * 0.5
    drift = math.abs(endMid - startMid)
    bullRun = 0
    bearRun = 0
    maxBullRun = 0
    maxBearRun = 0
    if (N - 1) >= (0)
        for i = 0 to N - 1
            if close[i] > open[i]
                bullRun += 1
                bearRun := 0
            else if close[i] < open[i]
                bearRun += 1
                bullRun := 0
            else
                bullRun := 0
                bearRun := 0
            maxBullRun := math.max(maxBullRun, bullRun)
            maxBearRun := math.max(maxBearRun, bearRun)
    condAtr = not na(atrValue) and atrValue > 0 and rangeNow <= atrValue * atrMult
    condBar = rangeBase > 0 and rangeNow <= rangeBase * barRatioMax
    condBalance = upperCloses >= minUp and lowerCloses >= minLow
    condDrift = rangeNow > 0 and drift / rangeNow <= driftMax
    condColor = maxBullRun <= maxRun and maxBearRun <= maxRun
    isAccum = condAtr and condBar and condBalance and condDrift and condColor
    var bool candActive = false
    var float candTop = na
    var float candBot = na
    var int candStart = 0
    bool newBox = false
    float boxTop = na
    float boxBot = na
    int boxStart = 0
    if isAccum
        if not candActive
            candActive := true
            candTop := rangeHigh
            candBot := rangeLow
            candStart := time
        else
            candTop := math.max(candTop, bodyTop)
            candBot := math.min(candBot, bodyBot)
    else
        if candActive
            newBox := true
            boxTop := candTop
            boxBot := candBot
            boxStart := candStart
            candActive := false
            candTop := na
            candBot := na
    [newBox ? 1 : 0, boxTop, boxBot, boxStart]

f_fvgPack() =>
    bull = low > high[2]
    bear = high < low[2]
    [bull ? 1 : 0, high[2], low, bear ? 1 : 0, high, low[2], time]

f_htfPack(int swingLen, bool withSwing, int N, int B, int atrLen, int minUp, int minLow, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    [ph, pl, pOrigin, pOriginEnd, pConfirm] = f_pivotPack(swingLen)
    [newBox, boxTop, boxBot, boxStart] = f_accumPack(N, B, atrLen, minUp, minLow, maxRun, atrMult, barRatioMax, driftMax)
    [bullF, bullBot, bullTop, bearF, bearBot, bearTop, fvgOrigin] = f_fvgPack()
    [withSwing ? ph : na, withSwing ? pl : na, pOrigin, pOriginEnd, newBox, boxTop, boxBot, boxStart, bullF, bullBot, bullTop, bearF, bearBot, bearTop, fvgOrigin, close, high, low, time, time_close]

// ---- the five contexts ---------------------------------------------------------------
[ema2000, ema2000Slope, ema3000, ema3000Slope, emaTime] = request.security(syminfo.tickerid, "1", f_maPack(inEmaLookback), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[ph15, pl15, o15, oe15, c15] = request.security(syminfo.tickerid, "15", f_pivotPack(inSwing15), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[ph60, pl60, o60, oe60, nb60, bt60, bb60, bs60, bf60, bbb60, bbt60, rf60, rbb60, rbt60, fo60, cl60, hi60, lo60, ot60, ct60] = request.security(syminfo.tickerid, "60", f_htfPack(inSwing1h, true, inAccRangeLen, inAccBaseLen, inAccAtrLen, inAccMinUpper, inAccMinLower, inAccMaxRun, inAccAtrMult, inAccBarRatio, inAccDrift), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[ph240, pl240, o240, oe240, nb240, bt240, bb240, bs240, bf240, bbb240, bbt240, rf240, rbb240, rbt240, fo240, cl240, hi240, lo240, ot240, ct240] = request.security(syminfo.tickerid, "240", f_htfPack(inSwing1h, false, inAccRangeLen, inAccBaseLen, inAccAtrLen, inAccMinUpper, inAccMinLower, inAccMaxRun, inAccAtrMult, inAccBarRatio, inAccDrift), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[phD, plD, oD, oeD, nbD, btD, bbD, bsD, bfD, bbbD, bbtD, rfD, rbbD, rbtD, foD, clD, hiD, loD, otD, ctD] = request.security(syminfo.tickerid, "D", f_htfPack(inSwing1h, false, inAccRangeLen, inAccBaseLen, inAccAtrLen, inAccMinUpper, inAccMinLower, inAccMaxRun, inAccAtrMult, inAccBarRatio, inAccDrift), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// 5m swing comes from chart data -- no extra request (I7.1)
ph5 = ta.pivothigh(high, inSwing5, inSwing5)
pl5 = ta.pivotlow(low, inSwing5, inSwing5)

// ---- adoption bookkeeping per timeframe and event kind ---------------------------------
var int lastSwing15 = 0
var int lastSwing60 = 0
var int lastAccum60 = 0
var int lastAccum240 = 0
var int lastAccumD = 0
var int lastFvg60 = 0
var int lastFvg240 = 0
var int lastFvgD = 0
var int lastSrc60 = 0
var int lastSrc240 = 0
var int lastSrcD = 0

// =====================================================================================
// Feed assembly + engine update -- once per confirmed 5m bar
// =====================================================================================
var int lastProcessedTime = 0
if barstate.isconfirmed and time > lastProcessedTime
    lastProcessedTime := time
    ZE.resetFeedEvents(feed)
    feed.baseOpen := open
    feed.baseHigh := high
    feed.baseLow := low
    feed.baseClose := close
    feed.basePrevClose := nz(close[1], close)
    feed.baseOpenTime := time
    feed.baseCloseTime := time_close
    feed.baseSeq := bar_index
    feed.baseConfirmed := true
    feed.mintick := syminfo.mintick
    feed.baseTfMinutes := 5
    feed.ema2000 := ema2000
    feed.ema2000Slope := ema2000Slope
    feed.ema3000 := ema3000
    feed.ema3000Slope := ema3000Slope
    feed.emaSourceTime := emaTime
    // ---- 5m swings (chart data, confirmed by the pivot definition itself) -------------
    if not na(ph5)
        ZE.pushSwing(feed, 5, true, ph5, time[inSwing5], time_close[inSwing5], time_close)
    if not na(pl5)
        ZE.pushSwing(feed, 5, false, pl5, time[inSwing5], time_close[inSwing5], time_close)
    // ---- 15m swings ---------------------------------------------------------------------
    if time_close >= c15 and c15 > lastSwing15
        lastSwing15 := c15
        if not na(ph15)
            ZE.pushSwing(feed, 15, true, ph15, o15, oe15, c15)
        if not na(pl15)
            ZE.pushSwing(feed, 15, false, pl15, o15, oe15, c15)
    // ---- 1H -------------------------------------------------------------------------------
    if time_close >= ct60 and ct60 > lastSrc60
        lastSrc60 := ct60
        ZE.pushSourceClose(feed, 60, cl60, hi60, lo60, ot60, ct60)
        if ct60 > lastSwing60
            lastSwing60 := ct60
            if not na(ph60)
                ZE.pushSwing(feed, 60, true, ph60, o60, oe60, ct60)
            if not na(pl60)
                ZE.pushSwing(feed, 60, false, pl60, o60, oe60, ct60)
        if nb60 == 1 and ct60 > lastAccum60
            lastAccum60 := ct60
            ZE.pushAccumBox(feed, 60, bt60, bb60, bs60, ct60)
        if ct60 > lastFvg60
            lastFvg60 := ct60
            if bf60 == 1
                ZE.pushFvg(feed, 60, 1, bbb60, bbt60, fo60, ct60)
            if rf60 == 1
                ZE.pushFvg(feed, 60, -1, rbb60, rbt60, fo60, ct60)
    // ---- 4H -------------------------------------------------------------------------------
    if time_close >= ct240 and ct240 > lastSrc240
        lastSrc240 := ct240
        ZE.pushSourceClose(feed, 240, cl240, hi240, lo240, ot240, ct240)
        if nb240 == 1 and ct240 > lastAccum240
            lastAccum240 := ct240
            ZE.pushAccumBox(feed, 240, bt240, bb240, bs240, ct240)
        if ct240 > lastFvg240
            lastFvg240 := ct240
            if bf240 == 1
                ZE.pushFvg(feed, 240, 1, bbb240, bbt240, fo240, ct240)
            if rf240 == 1
                ZE.pushFvg(feed, 240, -1, rbb240, rbt240, fo240, ct240)
    // ---- Daily ------------------------------------------------------------------------------
    if time_close >= ctD and ctD > lastSrcD
        lastSrcD := ctD
        ZE.pushSourceClose(feed, 1440, clD, hiD, loD, otD, ctD)
        if nbD == 1 and ctD > lastAccumD
            lastAccumD := ctD
            ZE.pushAccumBox(feed, 1440, btD, bbD, bsD, ctD)
        if ctD > lastFvgD
            lastFvgD := ctD
            if bfD == 1
                ZE.pushFvg(feed, 1440, 1, bbbD, bbtD, foD, ctD)
            if rfD == 1
                ZE.pushFvg(feed, 1440, -1, rbbD, rbtD, foD, ctD)
    ZE.updateConfirmed5m(eng, cfg, feed)

// =====================================================================================
// Drawing (App. C 22.2 - 22.4). Object pools are created once and re-used with setters.
// Every string and every sort happens on the last bar only (I19.2).
// =====================================================================================
var array<box>   zoneBoxes  = array.new<box>(0)
var array<line>  zoneLines  = array.new<line>(0)
var array<label> zoneLabels = array.new<label>(0)
var table dbg = na

if barstate.isfirst
    if (inMaxZonesDrawn - 1) >= (0)
        for i = 0 to inMaxZonesDrawn - 1
            array.push(zoneBoxes, box.new(bar_index, 0.0, bar_index, 0.0, border_color = color.new(color.gray, 100), bgcolor = color.new(color.gray, 100)))
            array.push(zoneLines, line.new(bar_index, 0.0, bar_index, 0.0, color = color.new(color.gray, 100)))
    if (inMaxLabels - 1) >= (0)
        for i = 0 to inMaxLabels - 1
            array.push(zoneLabels, label.new(bar_index, 0.0, "", color = color.new(color.gray, 100), textcolor = color.new(color.white, 100), style = label.style_label_left, size = size.small))
    dbg := table.new(position.top_right, 2, 22, border_width = 1)

zoneColor(int side, int grade, int phase, bool eligible, bool broadCtx) =>
    color c = color.gray
    if not eligible or grade == 3 or phase == 4
        c := color.gray
    else if side == 1
        c := grade == 0 ? color.new(color.green, 55) : grade == 1 ? color.new(color.green, 75) : color.new(color.green, 88)
    else
        c := grade == 0 ? color.new(color.red, 55) : grade == 1 ? color.new(color.red, 75) : color.new(color.red, 88)
    broadCtx ? color.new(c, 92) : c

if barstate.islast
    nViews = ZE.viewCount(eng)
    // distance ordering for display only -- last bar only, never inside the Engine
    idxs = array.new<int>(0)
    dists = array.new<float>(0)
    if (nViews - 1) >= (0)
        for i = 0 to nViews - 1
            v = ZE.viewAt(eng, i)
            if not na(v.effectiveBottom) and not na(v.effectiveTop) and v.eligible
                d = close > v.effectiveTop ? close - v.effectiveTop : (close < v.effectiveBottom ? v.effectiveBottom - close : 0.0)
                array.push(idxs, i)
                array.push(dists, d)
    n = array.size(idxs)
    if (n - 1) >= (1)
        for i = 1 to n - 1
            ki = array.get(idxs, i)
            kd = array.get(dists, i)
            j = i - 1
            while j >= 0 and array.get(dists, j) > kd
                array.set(idxs, j + 1, array.get(idxs, j))
                array.set(dists, j + 1, array.get(dists, j))
                j -= 1
            array.set(idxs, j + 1, ki)
            array.set(dists, j + 1, kd)
    shown = math.min(n, inMaxZonesDrawn)
    left = bar_index - 120
    right = bar_index + 12
    if (inMaxZonesDrawn - 1) >= (0)
        for k = 0 to inMaxZonesDrawn - 1
            b = array.get(zoneBoxes, k)
            l = array.get(zoneLines, k)
            if k < shown
                v = ZE.viewAt(eng, array.get(idxs, k))
                c = zoneColor(v.side, v.grade, v.phase, v.eligible, v.isBroadContext)
                bstyle = v.phase == 3 or v.phase == 4 or v.isBroadContext ? line.style_dashed : line.style_solid
                bwidth = v.phase == 2 ? 2 : 1
                if v.effectiveTop > v.effectiveBottom
                    box.set_lefttop(b, left, v.effectiveTop)
                    box.set_rightbottom(b, right, v.effectiveBottom)
                    box.set_bgcolor(b, color.new(c, 85))
                    box.set_border_color(b, c)
                    box.set_border_style(b, bstyle)
                    box.set_border_width(b, bwidth)
                    line.set_xy1(l, bar_index, v.effectiveTop)
                    line.set_xy2(l, bar_index, v.effectiveTop)
                    line.set_color(l, color.new(color.gray, 100))
                else
                    // single line Zone: logical width stays 0
                    box.set_lefttop(b, bar_index, close)
                    box.set_rightbottom(b, bar_index, close)
                    box.set_bgcolor(b, color.new(color.gray, 100))
                    box.set_border_color(b, color.new(color.gray, 100))
                    line.set_xy1(l, left, v.effectiveBottom)
                    line.set_xy2(l, right, v.effectiveBottom)
                    line.set_color(l, c)
                    line.set_style(l, bstyle)
                    line.set_width(l, bwidth)
            else
                box.set_lefttop(b, bar_index, close)
                box.set_rightbottom(b, bar_index, close)
                box.set_bgcolor(b, color.new(color.gray, 100))
                box.set_border_color(b, color.new(color.gray, 100))
                line.set_xy1(l, bar_index, close)
                line.set_xy2(l, bar_index, close)
                line.set_color(l, color.new(color.gray, 100))
    shownL = math.min(shown, inMaxLabels)
    if (inMaxLabels - 1) >= (0)
        for k = 0 to inMaxLabels - 1
            lb = array.get(zoneLabels, k)
            if k < shownL
                v = ZE.viewAt(eng, array.get(idxs, k))
                c = zoneColor(v.side, v.grade, v.phase, v.eligible, v.isBroadContext)
                txt = str.tostring(v.coreId) + "/" + str.tostring(v.generationId) + "/" + ZE.sideName(v.side) + "\n" + ZE.phaseName(v.phase) + " | " + ZE.gradeName(v.grade) + "\n" + str.tostring(v.effectiveBottom, format.mintick) + " - " + str.tostring(v.effectiveTop, format.mintick) + "  ref " + str.tostring(v.referencePrice, format.mintick) + "\nC" + str.tostring(v.cCount) + " H" + str.tostring(v.hCount) + " " + ZE.densityName(v.density) + (v.baseStrong ? " BaseStrong" : "") + "\nTouch cur " + str.tostring(v.currentTouchNo) + " / next " + str.tostring(v.upcomingTouchNo) + "\n" + ZE.weakReasonName(v.weakReason) + " maxDepth " + str.tostring(v.maxDepthPct, "#.##") + "%\nZoneFresh " + (v.zoneFresh ? "Y" : "N") + " SideFresh " + (v.sideFresh ? "Y" : "N") + "\nFVG mask " + str.tostring(v.fvgDirectionMask) + " n=" + str.tostring(v.fvgRootCount) + " fresh=" + str.tostring(v.fvgFreshCount) + " state=" + str.tostring(v.fvgStructuralStateMask) + "\nCat mask " + str.tostring(v.categoryMask) + " High mask " + str.tostring(v.highMask) + " roots " + str.tostring(v.rootCount)
                label.set_xy(lb, right, (v.effectiveTop + v.effectiveBottom) * 0.5)
                label.set_text(lb, txt)
                label.set_color(lb, color.new(c, 20))
                label.set_textcolor(lb, color.white)
            else
                label.set_xy(lb, bar_index, close)
                label.set_text(lb, "")
                label.set_color(lb, color.new(color.gray, 100))
                label.set_textcolor(lb, color.new(color.white, 100))
    // ---- Debug table (App. C 22.4). OFF produces no strings and no root scan ------------
    if inDebug
        d = ZE.diag(eng)
        table.cell(dbg, 0, 0, "Build", text_color = color.white, bgcolor = color.new(color.blue, 70))
        table.cell(dbg, 1, 0, ZE.buildId(), text_color = color.white, bgcolor = color.new(color.blue, 70))
        table.cell(dbg, 0, 1, "configValid / err")
        table.cell(dbg, 1, 1, (d.configValid ? "true" : "false") + " / " + str.tostring(d.cfgError))
        table.cell(dbg, 0, 2, "Live cores / views")
        table.cell(dbg, 1, 2, str.tostring(d.liveCores) + " / " + str.tostring(d.viewRows))
        table.cell(dbg, 0, 3, "Live roots")
        table.cell(dbg, 1, 3, str.tostring(d.liveRoots))
        table.cell(dbg, 0, 4, "Events this bar")
        table.cell(dbg, 1, 4, str.tostring(d.events))
        table.cell(dbg, 0, 5, "Armed / ActiveTouch")
        table.cell(dbg, 1, 5, str.tostring(d.armedViews) + " / " + str.tostring(d.activeTouches))
        table.cell(dbg, 0, 6, "PendingTopo / Gen")
        table.cell(dbg, 1, 6, str.tostring(d.pendingTopology) + " / " + str.tostring(d.pendingGeneration))
        table.cell(dbg, 0, 7, "storagePruned")
        table.cell(dbg, 1, 7, (d.storagePruned ? "true" : "false") + " r=" + str.tostring(d.prunedRoots) + " z=" + str.tostring(d.prunedZones))
        table.cell(dbg, 0, 8, "touchTruncated")
        table.cell(dbg, 1, 8, d.touchTruncated ? "true" : "false")
        table.cell(dbg, 0, 9, "MA slope 2000/3000")
        table.cell(dbg, 1, 9, str.tostring(d.maSlope2000) + " / " + str.tostring(d.maSlope3000))
        table.cell(dbg, 0, 10, "Session / day / week")
        table.cell(dbg, 1, 10, str.tostring(d.sessionCode) + " / " + str.tostring(d.dayKey) + " / " + str.tostring(d.weekKey))
        table.cell(dbg, 0, 11, "Last base time")
        table.cell(dbg, 1, 11, str.format_time(d.lastBaseTime, "yyyy-MM-dd HH:mm", inTz))
        table.cell(dbg, 0, 12, "Last base seq")
        table.cell(dbg, 1, 12, str.tostring(d.lastBaseSeq))
        table.cell(dbg, 0, 13, "Components / cache h/m")
        table.cell(dbg, 1, 13, str.tostring(d.components) + " / " + str.tostring(d.cacheHit) + "/" + str.tostring(d.cacheMiss))
        table.cell(dbg, 0, 14, "Merges / splits")
        table.cell(dbg, 1, 14, str.tostring(d.merges) + " / " + str.tostring(d.splits))
        table.cell(dbg, 0, 15, "Local inserts / sorts")
        table.cell(dbg, 1, 15, str.tostring(d.localInserts) + " / " + str.tostring(d.fullSorts))
        table.cell(dbg, 0, 16, "Candidate windows")
        table.cell(dbg, 1, 16, str.tostring(d.candidateWindows))
        ne = ZE.eventCount(eng)
        lastEv = ""
        if (ne - 1) >= (0)
            for i = 0 to ne - 1
                e = ZE.eventAt(eng, i)
                lastEv := lastEv + ZE.eventName(e.eventType) + "(" + str.tostring(e.coreId) + "/" + ZE.sideName(e.side) + ") "
        table.cell(dbg, 0, 17, "Bar events")
        table.cell(dbg, 1, 17, lastEv)

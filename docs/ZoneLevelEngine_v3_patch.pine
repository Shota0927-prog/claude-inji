// ============================================================================
//  ZoneLevelEngine v3 パッチ (任意)
// ----------------------------------------------------------------------------
//  ★ これは「呼び名を増やすだけ」の追加パッチです ★
//    Strategy 側 (Zone_Level_Rebound_Strategy_Lite.pine) は v2 のままで
//    すでに完全に動作しています。Projected Level は v2 の export
//        zl.levelFrom(birthScore, touchCount + 1, cfg)
//    経由で取得しており、これは Library 内部で実 Level 計算と同じ
//    private 関数 f_levelOf() を呼ぶため、二重実装は発生していません。
//
//  ★ v2 に必要な切り出しは既に済んでいます ★
//    v2 の feedZone() 内:            int _lv = f_levelOf(_bs, _tc, c)
//    v2 の export:                   levelFrom(...) => f_levelOf(...)
//    → Level 判定は既に private 関数 1 本 (f_levelOf) に集約済み。
//      追加の切り出し作業は不要で、既存の判定結果も 1 件も変わりません。
//
//  ★ このパッチを当てる意味 ★
//    「次 Touch 後 Level を取る」という意図が API 名から読めるようになるだけ。
//    計算結果は levelFrom(tc + 1) と完全に同一です。不要なら当てなくて構いません。
// ============================================================================

// ----------------------------------------------------------------------------
//  手順 1 : ZoneLevelEngine v2 のソース末尾 (export levelFrom() の直後が分かり
//           やすい) へ、下の関数をそのまま追加する。
//           ★ 既存の行は 1 文字も変更しないこと ★
//           (f_levelOf / f_levelName / feedZone / endBaseBar / 閾値 / 順序 /
//            条件を触らない。触らなければ v2 の Level 判定結果は不変)
// ----------------------------------------------------------------------------

// @function            次に Touch が 1 回起きた場合の zoneLevel を返す。
//                      実際の Level 計算 (feedZone 内) と同じ内部関数
//                      f_levelOf() を使うので、二重実装にならない。
//                      変えるのは touchCount を +1 することだけで、
//                      birthScore など他の値は現在 Zone の値をそのまま使う。
// @param z             現在の ZoneLevel
// @param c             ZoneLevelCfg (実 Level 計算へ渡しているものと同じ設定)
// @returns             1 〜 4 (Weak / Medium / Strong / Very Strong)
export projectLevelAfterNextTouch(ZoneLevel z, ZoneLevelCfg c) =>
    f_levelOf(z.birthScore, z.touchCount + 1, c)

// ----------------------------------------------------------------------------
//  手順 2 : v3 として publish する (v2 は壊さない)。
//
//  手順 3 : Strategy 側を 2 箇所だけ差し替える。
//
//    (a) import
//          import sekine3310/ZoneLevelEngine/2 as zl
//        →
//          import sekine3310/ZoneLevelEngine/3 as zl
//
//    (b) Section 04B の f_projectedLevel()
//          f_projectedLevel(z) =>
//              zl.levelFrom(z.birthScore, z.touchCount + 1, lvlCfg)
//        →
//          f_projectedLevel(z) =>
//              zl.projectLevelAfterNextTouch(z, lvlCfg)
//
//        ※ Section 11 の CSV Parity Audit で表示している
//          "Projected Source" の文字列も必要なら書き換える。
//
//  ★ 差し替え後も Projected Mismatch は 0 のままであること ★
//    もし 0 でなくなったら、それは f_levelOf() を通していない実装になっている
//    サイン。Strategy 側で帳尻を合わせず、Library 側を直すこと。
// ----------------------------------------------------------------------------

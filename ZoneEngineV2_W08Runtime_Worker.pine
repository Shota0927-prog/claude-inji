// Marks changed every Core of a (coreId, rootId) pair of A that B does not hold (pair key coreId * k + rootId).
depMarkMissingRaw(array<int> ac, array<int> ar, array<int> bc, array<int> br, int k, map<int, bool> changed) =>
    map<int, bool> inB = map.new<int, bool>()
    int i = 0
    while i < array.size(bc)
        map.put(inB, array.get(bc, i) * k + array.get(br, i), true)
        i += 1
    i := 0
    while i < array.size(ac)
        if not map.contains(inB, array.get(ac, i) * k + array.get(ar, i))
            map.put(changed, array.get(ac, i), true)
        i += 1
    true
// Adds the rootId (> 0) of every (coreId, rootId) pair of a changed Core to dep.
depCollectRaw(array<int> c, array<int> r, map<int, bool> changed, map<int, bool> dep) =>
    int i = 0
    while i < array.size(c)
        if map.contains(changed, array.get(c, i)) and array.get(r, i) > 0
            map.put(dep, array.get(r, i), true)
        i += 1
    true
sideActiveRaw(W08Core.CoreRegistryStore cr, int coreSlot) =>
    array.get(cr.sidePhases, coreSlot * 2) == PH_ACTIVE_TOUCH or array.get(cr.sidePhases, coreSlot * 2 + 1) == PH_ACTIVE_TOUCH

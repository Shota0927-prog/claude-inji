    s.coreRegistry                                := newCoreRegistryStoreRaw()
    s

// currentCoreId = the Core ID of a live Core at coreSlot, ID_NONE when the slot is out of
// range or not live (caller side). The physical range is read by the caller and passed in.
// B04-A: every interval mutation keeps the bottom-order index (coreIntervalOrderData) and the
// top-order index (coreIntervalTopOrderData) as the same tuple set. The target entry is located
// in both before any write; a target present in only one index, different ticks between the
// two, or unequal index sizes fail the call with no write (local checks only, no full audit).
// B07-D: the input / storage predicate of intervalInsert (shared with coreIndexCanInstall)
intervalInsertInputOkRaw(W08Store store, int coreSlot, int expectedCoreId, int currentCoreId, float physicalBottom, float physicalTop, float mintick) =>
    int dataSize = array.size(store.coreIntervalOrderData)
    coreSlot >= 0 and expectedCoreId != ID_NONE and currentCoreId == expectedCoreId and mintick > 0 and physicalBottom <= physicalTop and dataSize % 4 == 0 and array.size(store.coreIntervalTopOrderData) == dataSize

export intervalInsert(W08Store store, int coreSlot, int expectedCoreId, int currentCoreId, float physicalBottom, float physicalTop, float mintick) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if intervalInsertInputOkRaw(store, coreSlot, expectedCoreId, currentCoreId, physicalBottom, physicalTop, mintick)
        int bTick = int(math.round(physicalBottom / mintick))
        int tTick = int(math.round(physicalTop    / mintick))
        int k     = 0
        while k < dataSize and (array.get(d, k) != coreSlot or array.get(d, k + 1) != expectedCoreId)
            k += 4
        int j = 0
        while j < dataSize and (array.get(e, j) != coreSlot or array.get(e, j + 1) != expectedCoreId)
            j += 4
        if k < dataSize and j < dataSize
            ok := array.get(d, k + 2) == bTick and array.get(d, k + 3) == tTick and array.get(e, j + 2) == bTick and array.get(e, j + 3) == tTick
        else if k == dataSize and j == dataSize
            ok := true
            array.push(d, coreSlot)
            array.push(d, expectedCoreId)
            array.push(d, bTick)
            array.push(d, tTick)
            while k > 0 and (array.get(d, k - 2) > bTick or (array.get(d, k - 2) == bTick and (array.get(d, k - 1) > tTick or (array.get(d, k - 1) == tTick and array.get(d, k - 3) > expectedCoreId))))
                for n = 0 to 3
                    array.set(d, k + n, array.get(d, k - 4 + n))
                k -= 4
            array.set(d, k,     coreSlot)
            array.set(d, k + 1, expectedCoreId)
            array.set(d, k + 2, bTick)
            array.set(d, k + 3, tTick)
            array.push(e, coreSlot)
            array.push(e, expectedCoreId)
            array.push(e, bTick)
            array.push(e, tTick)
            while j > 0 and (array.get(e, j - 1) > tTick or (array.get(e, j - 1) == tTick and (array.get(e, j - 2) > bTick or (array.get(e, j - 2) == bTick and array.get(e, j - 3) > expectedCoreId))))
                for n = 0 to 3
                    array.set(e, j + n, array.get(e, j - 4 + n))
                j -= 4
            array.set(e, j,     coreSlot)
            array.set(e, j + 1, expectedCoreId)
            array.set(e, j + 2, bTick)
            array.set(e, j + 3, tTick)
            changed := true
    [ok, changed]

// B07-D: the read-only failure predicate of intervalDetach (shared with coreIndexCanRelease). Returns [ok, k, j]:
// the tuple positions in the bottom / top order (dataSize = absent from both).
intervalDetachCheckRaw(W08Store store, int coreSlot, int expectedCoreId) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool ok       = false
    int  dataSize = array.size(d)
    int  k        = 0
    int  j        = 0
    if coreSlot >= 0 and expectedCoreId != ID_NONE and dataSize % 4 == 0 and array.size(e) == dataSize
        while k < dataSize and (array.get(d, k) != coreSlot or array.get(d, k + 1) != expectedCoreId)
            k += 4
        while j < dataSize and (array.get(e, j) != coreSlot or array.get(e, j + 1) != expectedCoreId)
            j += 4
        if k == dataSize and j == dataSize
            ok := true
        else if k < dataSize and j < dataSize
            ok := array.get(d, k + 2) == array.get(e, j + 2) and array.get(d, k + 3) == array.get(e, j + 3)
    [ok, k, j]

export intervalDetach(W08Store store, int coreSlot, int expectedCoreId) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool changed  = false
    int  dataSize = array.size(d)
    [ok, k0, j0] = intervalDetachCheckRaw(store, coreSlot, expectedCoreId)
    if ok
        int k = k0
        int j = j0
        if k < dataSize and j < dataSize
            if ok
                while k < dataSize - 4
                    array.set(d, k, array.get(d, k + 4))
                    k += 1
                while j < dataSize - 4
                    array.set(e, j, array.get(e, j + 4))
                    j += 1
                for n = 1 to 4
                    array.pop(d)
                    array.pop(e)
                changed := true
    [ok, changed]


// B04-A: exact interval collection. Writes every [coreSlot, expectedCoreId] whose entry has
// bottomTick <= candidateTopTick + mTick and topTick >= candidateBottomTick - mTick (interval
// gap <= M, equality included) into outCores (stride 2, physical index order: not the
// canonical pair order, never an Identity tie-break) and returns the count; -1 with an empty
// outCores for bottom > top, mTick < 0 or bad storage. Binary search gives the bottom-index
// prefix meeting the first bound and the top-index suffix meeting the second; only the
// smaller of the two is scanned (bottom on a tie) and each scanned entry is checked against
// the other bound. No cap, no live Core check (the caller matches coreIds[coreSlot]).
export intervalCollect(W08Store store, int candidateBottomTick, int candidateTopTick, int mTick, array<int> outCores) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    array.clear(outCores)
    int result   = -1
    int dataSize = array.size(d)
    if candidateBottomTick <= candidateTopTick and mTick >= 0 and dataSize % 4 == 0 and array.size(e) == dataSize
        int hiTick = candidateTopTick + mTick
        int loTick = candidateBottomTick - mTick
        int n  = int(dataSize / 4)
        int lo = 0
        int hi = n
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(d, mid * 4 + 2) <= hiTick
                lo := mid + 1
            else
                hi := mid
        int bottomPrefixCount = lo
        lo := 0
        hi := n
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(e, mid * 4 + 3) < loTick
                lo := mid + 1
            else
                hi := mid
        int topSuffixStart = lo
        if bottomPrefixCount <= n - topSuffixStart
            int i = 0
            while i < bottomPrefixCount * 4
                if array.get(d, i + 3) >= loTick
                    array.push(outCores, array.get(d, i))
                    array.push(outCores, array.get(d, i + 1))
                i += 4
        else
            int i = topSuffixStart * 4
            while i < dataSize
                if array.get(e, i + 2) <= hiTick
                    array.push(outCores, array.get(e, i))
                    array.push(outCores, array.get(e, i + 1))
                i += 4
        result := int(array.size(outCores) / 2)
    result

// B07-D: the input predicate of originAdd (shared with coreIndexCanInstall)
originAddInputOkRaw(int coreSlot, int currentCoreId, int rootId) =>
    coreSlot >= 0 and currentCoreId != ID_NONE and rootId >= 1

export originAdd(W08Store store, int coreSlot, int currentCoreId, int currentGenerationId, int rootId) =>
    bool ok      = false
    bool changed = false
    if originAddInputOkRaw(coreSlot, currentCoreId, rootId)
        ok := true
        while array.size(store.coreZoneOriginRootCounts) <= coreSlot
            array.push(store.coreZoneOriginRootHeadNodeIndexes, SLOT_INVALID)
            array.push(store.coreZoneOriginRootTailNodeIndexes, SLOT_INVALID)
            array.push(store.coreZoneOriginRootCounts,          0)
        int cur = array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        if cur != SLOT_INVALID and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) != currentCoreId
            cur := SLOT_INVALID
            array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootCounts,          coreSlot, 0)
        int prevNode = SLOT_INVALID
        while cur != SLOT_INVALID and array.get(store.coreZoneOriginRootNodeRootIds, cur) < rootId
            prevNode := cur
            cur      := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
        if cur == SLOT_INVALID or array.get(store.coreZoneOriginRootNodeRootIds, cur) != rootId
            int nodeIndex = array.size(store.coreZoneOriginRootNodeRootIds)
            if array.size(store.coreZoneOriginRootNodeFreeIndexes) > 0
                nodeIndex := array.pop(store.coreZoneOriginRootNodeFreeIndexes)
                array.set(store.coreZoneOriginRootNodeRootIds,               nodeIndex, rootId)
                array.set(store.coreZoneOriginRootNodeNextIndexes,           nodeIndex, cur)
                array.set(store.coreZoneOriginRootNodeOwnerCoreSlots,        nodeIndex, coreSlot)
                array.set(store.coreZoneOriginRootNodeExpectedCoreIds,       nodeIndex, currentCoreId)
                array.set(store.coreZoneOriginRootNodeExpectedGenerationIds, nodeIndex, currentGenerationId)
                array.set(store.coreZoneOriginRootNodeLiveFlags,             nodeIndex, true)
            else
                array.push(store.coreZoneOriginRootNodeRootIds,               rootId)
                array.push(store.coreZoneOriginRootNodeNextIndexes,           cur)
                array.push(store.coreZoneOriginRootNodeOwnerCoreSlots,        coreSlot)
                array.push(store.coreZoneOriginRootNodeExpectedCoreIds,       currentCoreId)
                array.push(store.coreZoneOriginRootNodeExpectedGenerationIds, currentGenerationId)
                array.push(store.coreZoneOriginRootNodeLiveFlags,             true)
            if prevNode == SLOT_INVALID
                array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, nodeIndex)
            else
                array.set(store.coreZoneOriginRootNodeNextIndexes, prevNode, nodeIndex)
            if cur == SLOT_INVALID
                array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, nodeIndex)
            array.set(store.coreZoneOriginRootCounts, coreSlot, array.get(store.coreZoneOriginRootCounts, coreSlot) + 1)
            store.topologyRevision := store.topologyRevision + 1
            changed := true
    [ok, changed]


// Copies the origin Root ID set of the live Core at coreSlot into outRootIds in rootId ASC
// order and returns its count; -1 with an empty outRootIds for an invalid slot, a non-live
// Core (currentCoreId = ID_NONE) or an out-of-range node index (never a partial set).
export originReadAsc(W08Store store, int coreSlot, int currentCoreId, array<int> outRootIds) =>
    array.clear(outRootIds)
    int result = -1
    if coreSlot >= 0 and currentCoreId != ID_NONE
        int nodeRows = array.size(store.coreZoneOriginRootNodeRootIds)
        int cur      = coreSlot < array.size(store.coreZoneOriginRootCounts) ? array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot) : SLOT_INVALID
        if cur >= 0 and cur < nodeRows and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) != currentCoreId
            cur := SLOT_INVALID
        while cur >= 0 and cur < nodeRows
            array.push(outRootIds, array.get(store.coreZoneOriginRootNodeRootIds, cur))
            cur := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
        if cur == SLOT_INVALID
            result := array.size(outRootIds)
        else
            array.clear(outRootIds)
    result

// B07-D: the input / storage predicate of inverseOriginAdd (shared with coreIndexCanInstall)
inverseOriginInputOkRaw(W08Store store, int fvgOriginRootId, int coreSlot, int currentCoreId) =>
    fvgOriginRootId >= 1 and coreSlot >= 0 and currentCoreId != ID_NONE and array.size(store.inverseOriginData) % 3 == 0

export inverseOriginAdd(W08Store store, int fvgOriginRootId, int coreSlot, int currentCoreId) =>
    array<int> d = store.inverseOriginData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if inverseOriginInputOkRaw(store, fvgOriginRootId, coreSlot, currentCoreId)
        ok := true
        int k = dataSize
        while k > 0 and (array.get(d, k - 3) > fvgOriginRootId or (array.get(d, k - 3) == fvgOriginRootId and (array.get(d, k - 1) > currentCoreId or (array.get(d, k - 1) == currentCoreId and array.get(d, k - 2) > coreSlot))))
            k -= 3
        if k == 0 or array.get(d, k - 3) != fvgOriginRootId or array.get(d, k - 2) != coreSlot or array.get(d, k - 1) != currentCoreId
            array.push(d, fvgOriginRootId)
            array.push(d, coreSlot)
            array.push(d, currentCoreId)
            int j = dataSize - 1
            while j >= k
                array.set(d, j + 3, array.get(d, j))
                j -= 1
            array.set(d, k,     fvgOriginRootId)
            array.set(d, k + 1, coreSlot)
            array.set(d, k + 2, currentCoreId)
            changed := true
    [ok, changed]


// Writes every [coreSlot, expectedCoreId] registered for fvgOriginRootId into outCores
// (stride 2, index order, no cap) and returns the candidate count; -1 with an empty
// outCores for an invalid origin or storage. Only that origin's run is read (binary search
// to its first entry).
export inverseOriginCollect(W08Store store, int fvgOriginRootId, array<int> outCores) =>
    array<int> d = store.inverseOriginData
    array.clear(outCores)
    int result   = -1
    int dataSize = array.size(d)
    if fvgOriginRootId >= 1 and dataSize % 3 == 0
        int lo = 0
        int hi = int(dataSize / 3)
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(d, mid * 3) < fvgOriginRootId
                lo := mid + 1
            else
                hi := mid
        int k = lo * 3
        while k < dataSize and array.get(d, k) == fvgOriginRootId
            array.push(outCores, array.get(d, k + 1))
            array.push(outCores, array.get(d, k + 2))
            k += 3
        result := int(array.size(outCores) / 2)
    result

export identityGatherReset(W08Store store) =>
    array.clear(store.identityGatherData)
    true

// Adds the physical Core (currentCoreId at coreSlot) once, at its coreId ASC position. Same
// coreId and slot again: no-op. Same coreId with another slot, or the slot already held by
// another coreId: ok = false with no write (never merged or repaired here).
export identityGatherOffer(W08Store store, int coreSlot, int currentCoreId) =>
    array<int> d = store.identityGatherData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if coreSlot >= 0 and currentCoreId >= 1 and dataSize % 2 == 0
        bool conflict = false
        bool exact    = false
        int  pos      = dataSize
        int  k        = 0
        while k < dataSize and not conflict
            int id = array.get(d, k)
            int sl = array.get(d, k + 1)
            if id == currentCoreId
                exact    := sl == coreSlot
                conflict := sl != coreSlot
            else if sl == coreSlot
                conflict := true
            if pos == dataSize and id > currentCoreId
                pos := k
            k += 2
        if not conflict
            ok := true
            if not exact
                array.push(d, currentCoreId)
                array.push(d, coreSlot)
                int j = dataSize - 1
                while j >= pos
                    array.set(d, j + 2, array.get(d, j))
                    j -= 1
                array.set(d, pos,     currentCoreId)
                array.set(d, pos + 1, coreSlot)
                changed := true
    [ok, changed]

// Writes the gathered Cores into outPairs as [coreSlot, coreId] (stride 2), coreId ASC, and
// returns the count; -1 with an empty outPairs when the scratch is not a strictly ascending
// stride-2 list (checked in the same read pass, never a partial result).
export identityGatherReadAsc(W08Store store, array<int> outPairs) =>
    array<int> d = store.identityGatherData
    array.clear(outPairs)
    int  result   = -1
    int  dataSize = array.size(d)
    bool valid    = dataSize % 2 == 0
    int  lastId   = 0
    int  k        = 0
    while valid and k < dataSize
        int id = array.get(d, k)
        valid := id > lastId
        if valid
            array.push(outPairs, array.get(d, k + 1))
            array.push(outPairs, id)
            lastId := id
        k += 2
    if valid
        result := int(dataSize / 2)
    else
        array.clear(outPairs)
    result

export pairingReset(W08Store store) =>
    array.clear(store.pairingSupportBottomOrderData)
    array.clear(store.pairingSupportTopOrderData)
    array.clear(store.pairingResistanceBottomOrderData)
    array.clear(store.pairingResistanceTopOrderData)
    true

// side: Support = 1, Resistance = -1. The winner is located in both indexes of its Side before
// any write: absent from both -> inserted into both at the canonical positions; present in both
// with the same range -> no-op; any other case (other range, present in one index only, unequal
// index sizes) -> ok = false with no write. Local checks only, no full audit.
export pairingAddCandidate(W08Store store, int side, int candidateWinnerIndex, int bottomTick, int topTick) =>
    bool ok      = false
    bool changed = false
    if (side == 1 or side == -1) and candidateWinnerIndex >= 0 and bottomTick <= topTick
        array<int> d = side == 1 ? store.pairingSupportBottomOrderData : store.pairingResistanceBottomOrderData
        array<int> e = side == 1 ? store.pairingSupportTopOrderData    : store.pairingResistanceTopOrderData
        int dataSize = array.size(d)
        if dataSize % 3 == 0 and array.size(e) == dataSize
            int k = 0
            while k < dataSize and array.get(d, k) != candidateWinnerIndex
                k += 3
            int j = 0
            while j < dataSize and array.get(e, j) != candidateWinnerIndex
                j += 3
            if k < dataSize and j < dataSize
                ok := array.get(d, k + 1) == bottomTick and array.get(d, k + 2) == topTick and array.get(e, j + 1) == bottomTick and array.get(e, j + 2) == topTick
            else if k == dataSize and j == dataSize
                ok := true
                array.push(d, candidateWinnerIndex)
                array.push(d, bottomTick)
                array.push(d, topTick)
                while k > 0 and (array.get(d, k - 2) > bottomTick or (array.get(d, k - 2) == bottomTick and (array.get(d, k - 1) > topTick or (array.get(d, k - 1) == topTick and array.get(d, k - 3) > candidateWinnerIndex))))
                    for n = 0 to 2
                        array.set(d, k + n, array.get(d, k - 3 + n))
                    k -= 3
                array.set(d, k,     candidateWinnerIndex)
                array.set(d, k + 1, bottomTick)
                array.set(d, k + 2, topTick)
                array.push(e, candidateWinnerIndex)
                array.push(e, bottomTick)
                array.push(e, topTick)
                while j > 0 and (array.get(e, j - 1) > topTick or (array.get(e, j - 1) == topTick and (array.get(e, j - 2) > bottomTick or (array.get(e, j - 2) == bottomTick and array.get(e, j - 3) > candidateWinnerIndex))))
                    for n = 0 to 2
                        array.set(e, j + n, array.get(e, j - 3 + n))
                    j -= 3
                array.set(e, j,     candidateWinnerIndex)
                array.set(e, j + 1, bottomTick)
                array.set(e, j + 2, topTick)
                changed := true
    [ok, changed]

// Writes every (supportWinnerIndex, resistanceWinnerIndex) with R.bottom <= S.top + mTick and
// R.top >= S.bottom - mTick (interval gap <= M, equality included) into outPairs, stride 2,
// ordered by supportWinnerIndex ASC then resistanceWinnerIndex ASC, and returns the count; -1
// with an empty outPairs for mTick < 0 or bad storage. Sweep over the Support intervals widened
// by mTick and the Resistance intervals: starts come from the two bottom orders, expiries from
// the two top orders; each new interval pairs with the live intervals of the other Side (exact
// condition re-checked), so each pair is found once and no Support x Resistance scan is made.
// The pairs are then put in canonical order by a stable two-pass counting sort.
export pairingCollectPairs(W08Store store, int mTick, array<int> outPairs) =>
    array<int> sb = store.pairingSupportBottomOrderData
    array<int> st = store.pairingSupportTopOrderData
    array<int> rb = store.pairingResistanceBottomOrderData
    array<int> rt = store.pairingResistanceTopOrderData
    array.clear(outPairs)
    int  sSize = array.size(sb)
    int  rSize = array.size(rb)
    bool ok    = mTick >= 0 and sSize % 3 == 0 and rSize % 3 == 0 and array.size(st) == sSize and array.size(rt) == rSize
    array<int> activeS = array.new_int(0)
    array<int> activeR = array.new_int(0)
    array<int> ps      = array.new_int(0)
    array<int> pr      = array.new_int(0)
    int maxS = 0
    int maxR = 0
    int si = 0
    int ri = 0
    int se = 0
    int re = 0
    while ok and (si < sSize or ri < rSize)
        bool takeS    = ri >= rSize or (si < sSize and array.get(sb, si + 1) - mTick <= array.get(rb, ri + 1))
        int  curStart = 0
        if takeS
            curStart := array.get(sb, si + 1) - mTick
        else
            curStart := array.get(rb, ri + 1)
        while ok and se < sSize and array.get(st, se + 2) + mTick < curStart
            int idx = array.get(st, se)
            int a   = 0
            while a < array.size(activeS) and array.get(activeS, a) != idx
                a += 3
            ok := a < array.size(activeS)
            if ok
                int last = array.size(activeS) - 3
                for n = 0 to 2
                    array.set(activeS, a + n, array.get(activeS, last + n))
                for n = 1 to 3
                    array.pop(activeS)
            se += 3
        while ok and re < rSize and array.get(rt, re + 2) < curStart
            int idx = array.get(rt, re)
            int a   = 0
            while a < array.size(activeR) and array.get(activeR, a) != idx
                a += 3
            ok := a < array.size(activeR)
            if ok
                int last = array.size(activeR) - 3
                for n = 0 to 2
                    array.set(activeR, a + n, array.get(activeR, last + n))
                for n = 1 to 3
                    array.pop(activeR)
            re += 3
        if ok
            if takeS
                int sIdx = array.get(sb, si)
                int sBot = array.get(sb, si + 1)
                int sTop = array.get(sb, si + 2)
                int a = 0
                while a < array.size(activeR)
                    if array.get(activeR, a + 1) <= sTop + mTick and array.get(activeR, a + 2) >= sBot - mTick
                        array.push(ps, sIdx)
                        array.push(pr, array.get(activeR, a))
                        maxS := math.max(maxS, sIdx)
                        maxR := math.max(maxR, array.get(activeR, a))
                    a += 3
                array.push(activeS, sIdx)
                array.push(activeS, sBot)
                array.push(activeS, sTop)
                si += 3
            else
                int rIdx = array.get(rb, ri)
                int rBot = array.get(rb, ri + 1)
                int rTop = array.get(rb, ri + 2)
                int a = 0
                while a < array.size(activeS)
                    if rBot <= array.get(activeS, a + 2) + mTick and rTop >= array.get(activeS, a + 1) - mTick
                        array.push(ps, array.get(activeS, a))
                        array.push(pr, rIdx)
                        maxS := math.max(maxS, array.get(activeS, a))
                        maxR := math.max(maxR, rIdx)
                    a += 3
                array.push(activeR, rIdx)
                array.push(activeR, rBot)
                array.push(activeR, rTop)
                ri += 3
    int result = -1
    if ok
        int count = array.size(ps)
        array<int> byR  = array.new_int(count, 0)
        array<int> cntR = array.new_int(maxR + 2, 0)
        int x = 0
        while x < count
            array.set(cntR, array.get(pr, x) + 1, array.get(cntR, array.get(pr, x) + 1) + 1)
            x += 1
        x := 1
        while x < maxR + 2
            array.set(cntR, x, array.get(cntR, x) + array.get(cntR, x - 1))
            x += 1
        x := 0
        while x < count
            int key = array.get(pr, x)
            array.set(byR, array.get(cntR, key), x)
            array.set(cntR, key, array.get(cntR, key) + 1)
            x += 1
        array<int> finalOrder = array.new_int(count, 0)
        array<int> cntS       = array.new_int(maxS + 2, 0)
        x := 0
        while x < count
            array.set(cntS, array.get(ps, x) + 1, array.get(cntS, array.get(ps, x) + 1) + 1)
            x += 1
        x := 1
        while x < maxS + 2
            array.set(cntS, x, array.get(cntS, x) + array.get(cntS, x - 1))
            x += 1
        x := 0
        while x < count
            int p   = array.get(byR, x)
            int key = array.get(ps, p)
            array.set(finalOrder, array.get(cntS, key), p)
            array.set(cntS, key, array.get(cntS, key) + 1)
            x += 1
        x := 0
        while x < count
            int p = array.get(finalOrder, x)
            array.push(outPairs, array.get(ps, p))
            array.push(outPairs, array.get(pr, p))
            x += 1
        result := count
    result

// Maximum matching cardinality of the eligible graph (Kuhn augmenting paths, iterative stack,
// no recursion, no cap). adjStart / edgeR: edges grouped by Support rank, Resistance rank ASC
// inside a group, so an edge position is its canonical edge order. Only edges with position >
// minEdgePos whose two endpoints are not used take part. Support ranks are tried in rank order
// and edges in position order; the returned cardinality does not depend on that order.
matchingMaxCardinalityRaw(array<int> adjStart, array<int> edgeR, int nS, int nR, int minEdgePos, array<bool> usedS, array<bool> usedR) =>
    array<int> matchR  = array.new_int(nR, -1)
    array<int> seenR   = array.new_int(nR, -1)
    array<int> stackS  = array.new_int(0)
    array<int> stackC  = array.new_int(0)
    array<int> stackR  = array.new_int(0)
    int result = 0
    int u = 0
    while u < nS
        if not array.get(usedS, u)
            array.clear(stackS)
            array.clear(stackC)
            array.clear(stackR)
            array.push(stackS, u)
            array.push(stackC, array.get(adjStart, u))
            array.push(stackR, -1)
            bool found = false
            while not found and array.size(stackS) > 0
                int top = array.size(stackS) - 1
                int v   = array.get(stackS, top)
                int c   = array.get(stackC, top)
                if c >= array.get(adjStart, v + 1)
                    array.pop(stackS)
                    array.pop(stackC)
                    array.pop(stackR)
                else
                    array.set(stackC, top, c + 1)
                    int r = array.get(edgeR, c)
                    if c > minEdgePos and not array.get(usedR, r) and array.get(seenR, r) != u
                        array.set(seenR, r, u)
                        array.set(stackR, top, r)
                        int owner = array.get(matchR, r)
                        if owner == -1
                            found := true
                        else
                            array.push(stackS, owner)
                            array.push(stackC, array.get(adjStart, owner))
                            array.push(stackR, -1)
            if found
                int d = array.size(stackS) - 1
                while d >= 0
                    array.set(matchR, array.get(stackR, d), array.get(stackS, d))
                    d -= 1
                result += 1
        u += 1
    result

// Selects the canonical maximum matching of the eligible Support x Resistance pairs into
// outMatchedPairs (stride 2 [supportWinnerIndex, resistanceWinnerIndex], canonical edge order)
// and returns its cardinality; 0 with an empty output for an empty graph. -1 with an empty
// output (no partial write) for an odd length, a negative index, a Support index absent from
// the Support bottom order, a Resistance index absent from the Resistance bottom order, a
// duplicated edge or bad pairing storage. Step A: K = maximum cardinality. Step C: edges in
// canonical order; an edge free of selected endpoints is taken when, forced in, the edges after
// it still complete the remaining count. Nothing is deduplicated silently, no cap.
// Canonical maximum matching over rank edges (es[i], er[i]) of nS row ranks and nR column ranks (B07-A1 machinery).
// edgeS / edgeR receive the edges in canonical order (row rank, then column rank ASC, stable counting sorts); a repeated
// edge fails. K = maximum cardinality, then each edge in canonical order free of chosen endpoints is taken when, forced
// in, the edges after it still complete the remaining count. pickS / pickR receive the chosen edges in canonical order.
// Returns K, or -1 (a repeated edge / incomplete selection).
matchingCanonicalRaw(array<int> es, array<int> er, int nS, int nR, array<int> edgeS, array<int> edgeR, array<int> pickS, array<int> pickR) =>
    int nE = array.size(es)
    int result = -1
    array.clear(edgeS)
    array.clear(edgeR)
    array.clear(pickS)
    array.clear(pickR)
    bool ok = true
    if nS >= 0
        // canonical edge order: stable counting sort by Resistance rank, then by Support rank
        array<int> cnt  = array.new_int(nR + 1, 0)
        array<int> byR  = array.new_int(nE, 0)
        int x = 0
        while x < nE
            array.set(cnt, array.get(er, x) + 1, array.get(cnt, array.get(er, x) + 1) + 1)
            x += 1
        x := 1
        while x <= nR
            array.set(cnt, x, array.get(cnt, x) + array.get(cnt, x - 1))
            x += 1
        x := 0
        while x < nE
            int key = array.get(er, x)
            array.set(byR, array.get(cnt, key), x)
            array.set(cnt, key, array.get(cnt, key) + 1)
            x += 1
        array<int> adjStart = array.new_int(nS + 1, 0)
        int x0 = 0
        while x0 < nE
            array.push(edgeS, 0)
            array.push(edgeR, 0)
            x0 += 1
        x := 0
        while x < nE
            array.set(adjStart, array.get(es, x) + 1, array.get(adjStart, array.get(es, x) + 1) + 1)
            x += 1
        x := 1
        while x <= nS
            array.set(adjStart, x, array.get(adjStart, x) + array.get(adjStart, x - 1))
            x += 1
        array<int> fill = array.copy(adjStart)
        x := 0
        while x < nE
            int p   = array.get(byR, x)
            int key = array.get(es, p)
            array.set(edgeS, array.get(fill, key), key)
            array.set(edgeR, array.get(fill, key), array.get(er, p))
            array.set(fill, key, array.get(fill, key) + 1)
            x += 1
        // a repeated (S, R) edge is a structural failure, never deduplicated
        x := 1
        while ok and x < nE
            ok := not (array.get(edgeS, x) == array.get(edgeS, x - 1) and array.get(edgeR, x) == array.get(edgeR, x - 1))
            x += 1
        if ok
            array<bool> usedS = array.new_bool(nS, false)
            array<bool> usedR = array.new_bool(nR, false)
            int need     = matchingMaxCardinalityRaw(adjStart, edgeR, nS, nR, -1, usedS, usedR)
            int total    = need
            int selected = 0
            int e = 0
            while need > 0 and e < nE
                int s = array.get(edgeS, e)
                int r = array.get(edgeR, e)
                if not array.get(usedS, s) and not array.get(usedR, r)
                    array.set(usedS, s, true)
                    array.set(usedR, r, true)
                    int rest = matchingMaxCardinalityRaw(adjStart, edgeR, nS, nR, e, usedS, usedR)
                    if 1 + rest >= need
                        array.push(pickS, s)
                        array.push(pickR, r)
                        selected += 1
                        need     -= 1
                    else
                        array.set(usedS, s, false)
                        array.set(usedR, r, false)
                e += 1
            if selected == total
                result := total
    result

export pairingSelectCanonicalMatching(W08Store store, array<int> eligiblePairs, array<int> outMatchedPairs) =>
    array<int> sb = store.pairingSupportBottomOrderData
    array<int> rb = store.pairingResistanceBottomOrderData
    array.clear(outMatchedPairs)
    int  sSize = array.size(sb)
    int  rSize = array.size(rb)
    int  eSize = array.size(eligiblePairs)
    bool ok    = sSize % 3 == 0 and rSize % 3 == 0 and array.size(store.pairingSupportTopOrderData) == sSize and array.size(store.pairingResistanceTopOrderData) == rSize and eSize % 2 == 0
    int nS = int(sSize / 3)
    int nR = int(rSize / 3)
    int nE = int(eSize / 2)
    // winnerIndex -> Side rank (position in the Side bottom order)
    int maxS = -1
    int maxR = -1
    int k = 0
    while ok and k < sSize
        ok   := array.get(sb, k) >= 0
        maxS := math.max(maxS, array.get(sb, k))
        k += 3
    k := 0
    while ok and k < rSize
        ok   := array.get(rb, k) >= 0
        maxR := math.max(maxR, array.get(rb, k))
        k += 3
    array<int> rankOfS = array.new_int(ok ? maxS + 1 : 0, -1)
    array<int> rankOfR = array.new_int(ok ? maxR + 1 : 0, -1)
    k := 0
    while ok and k < sSize
        ok := array.get(rankOfS, array.get(sb, k)) == -1
        if ok
            array.set(rankOfS, array.get(sb, k), int(k / 3))
        k += 3
    k := 0
    while ok and k < rSize
        ok := array.get(rankOfR, array.get(rb, k)) == -1
        if ok
            array.set(rankOfR, array.get(rb, k), int(k / 3))
        k += 3
    // eligible pairs -> ranks
    array<int> es = array.new_int(0)
    array<int> er = array.new_int(0)
    k := 0
    while ok and k < eSize
        int s = array.get(eligiblePairs, k)
        int r = array.get(eligiblePairs, k + 1)
        ok := s >= 0 and r >= 0 and s <= maxS and r <= maxR
        if ok
            ok := array.get(rankOfS, s) != -1 and array.get(rankOfR, r) != -1
        if ok
            array.push(es, array.get(rankOfS, s))
            array.push(er, array.get(rankOfR, r))
        k += 2
    int result = -1
    if ok
        array<int> pickS = array.new_int(0)
        array<int> pickR = array.new_int(0)
        result := matchingCanonicalRaw(es, er, nS, nR, array.new_int(0), array.new_int(0), pickS, pickR)
        ok := result >= 0
        int x = 0
        while ok and x < result
            array.push(outMatchedPairs, array.get(sb, array.get(pickS, x) * 3))
            array.push(outMatchedPairs, array.get(rb, array.get(pickR, x) * 3))
            x += 1
    if not ok
        array.clear(outMatchedPairs)
    result

// Appends one physical Candidate of Support winner sIdx and / or Resistance winner rIdx (-1 = absent side). Each
// present slice must lie in [0, rootIdLength) with Root IDs >= 1 strictly ascending; the union is merged by two
// pointers (a shared Root ID once). minRootId = first union ID and must equal the min winner minRootId; tick envelope
// bottom <= top; exact envelope set, bottom <= top, each price rounding to its envelope tick. false -> nothing checked
// further (the caller clears the whole physical storage).
physicalAppendRaw(W08Store store, int sIdx, int rIdx, array<int> bottomTicks, array<int> topTicks, array<float> exactPrices, array<int> minRootIds, array<int> rootIdOffsets, array<int> rootIdLengths, array<int> rootIds, int rootIdLength, float mintick) =>
    int a    = 0
    int aEnd = 0
    int b    = 0
    int bEnd = 0
    if sIdx >= 0
        a    := array.get(rootIdOffsets, sIdx)
        aEnd := a + array.get(rootIdLengths, sIdx)
    if rIdx >= 0
        b    := array.get(rootIdOffsets, rIdx)
        bEnd := b + array.get(rootIdLengths, rIdx)
    bool ok    = a >= 0 and a <= aEnd and aEnd <= rootIdLength and b >= 0 and b <= bEnd and bEnd <= rootIdLength and aEnd - a + bEnd - b > 0
    int  start = array.size(store.physicalCandidateRootIds)
    int  lastA = 0
    int  lastB = 0
    int  last  = 0
    while ok and (a < aEnd or b < bEnd)
        int x = 0
        int y = 0
        if a < aEnd
            x := array.get(rootIds, a)
        if b < bEnd
            y := array.get(rootIds, b)
        int v = b >= bEnd or (a < aEnd and x <= y) ? x : y
        if a < aEnd and x == v
            ok    := x > lastA
            lastA := x
            a     += 1
        if b < bEnd and y == v
            ok    := ok and y > lastB
            lastB := y
            b     += 1
        ok := ok and v > last
        last := v
        array.push(store.physicalCandidateRootIds, v)
    int   bt = 0
    int   tt = 0
    float bp = na
    float tp = na
    int   mr = 0
    if ok
        bool first = true
        int i = 0
        while i < 2
            int w = i == 0 ? sIdx : rIdx
            if w >= 0
                int   wb  = array.get(bottomTicks, w)
                int   wt  = array.get(topTicks, w)
                float wbp = array.get(exactPrices, 2 * w)
                float wtp = array.get(exactPrices, 2 * w + 1)
                int   wmr = array.get(minRootIds, w)
                ok := ok and not na(wbp) and not na(wtp)
                bt := first ? wb : math.min(bt, wb)
                tt := first ? wt : math.max(tt, wt)
                bp := first ? wbp : math.min(bp, wbp)
                tp := first ? wtp : math.max(tp, wtp)
                mr := first ? wmr : math.min(mr, wmr)
                first := false
            i += 1
        ok := ok and mr == array.get(store.physicalCandidateRootIds, start) and bt <= tt and bp <= tp and int(math.round(bp / mintick)) == bt and int(math.round(tp / mintick)) == tt
    if ok
        array.push(store.physicalCandidateSupportWinnerIndexes, sIdx)
        array.push(store.physicalCandidateResistanceWinnerIndexes, rIdx)
        array.push(store.physicalCandidateBottomTicks, bt)
        array.push(store.physicalCandidateTopTicks, tt)
        array.push(store.physicalCandidateExactPrices, bp)
        array.push(store.physicalCandidateExactPrices, tp)
        array.push(store.physicalCandidateMinRootIds, mr)
        array.push(store.physicalCandidateRootIdOffsets, start)
        array.push(store.physicalCandidateRootIdLengths, array.size(store.physicalCandidateRootIds) - start)
    ok

// Builds the current-pass physical Candidates from the winner arrays and the canonical matching of
// pairingSelectCanonicalMatching (stride 2 [supportWinnerIndex, resistanceWinnerIndex]) and returns their count
// (winners - matched pairs); the unmatched winners are read from the pairing bottom orders of this pass (built by
// pairingAddCandidate for every winner). Physical storage is reset first; -1 with empty physical storage (no partial
// output) for bad sizes, an odd / out-of-range / wrong-Side / repeated matched endpoint, a pairing order entry that is
// not a winner of that Side with the same ticks, a winner left unassigned, or any physicalAppendRaw failure.
export physicalBuild(W08Store store, int candidateWinnerLogicalCount, array<int> candidateWinnerSides, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<float> candidateWinnerExactPrices, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerRootIdOffsets, array<int> candidateWinnerRootIdLengths, array<int> candidateWinnerRootIds, int candidateWinnerRootIdLength, array<int> matchedPairs, float mintick) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalCandidateSupportWinnerIndexes)
    array.clear(store.physicalCandidateResistanceWinnerIndexes)
    array.clear(store.physicalCandidateBottomTicks)
    array.clear(store.physicalCandidateTopTicks)
    array.clear(store.physicalCandidateExactPrices)
    array.clear(store.physicalCandidateMinRootIds)
    array.clear(store.physicalCandidateRootIdOffsets)
    array.clear(store.physicalCandidateRootIdLengths)
    array.clear(store.physicalCandidateRootIds)
    int  n    = candidateWinnerLogicalCount
    int  mLen = array.size(matchedPairs)
    bool ok   = n >= 0 and n <= array.size(candidateWinnerSides) and n <= array.size(candidateWinnerEffectiveBottomTicks) and n <= array.size(candidateWinnerEffectiveTopTicks) and 2 * n <= array.size(candidateWinnerExactPrices) and n <= array.size(candidateWinnerMinRootIds) and n <= array.size(candidateWinnerRootIdOffsets) and n <= array.size(candidateWinnerRootIdLengths) and candidateWinnerRootIdLength >= 0 and candidateWinnerRootIdLength <= array.size(candidateWinnerRootIds) and mLen % 2 == 0 and not na(mintick) and mintick > 0
    array<bool> assigned = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < mLen
        int sIdx = array.get(matchedPairs, k)
        int rIdx = array.get(matchedPairs, k + 1)
        ok := sIdx >= 0 and sIdx < n and rIdx >= 0 and rIdx < n
        if ok
            ok := array.get(candidateWinnerSides, sIdx) == 1 and array.get(candidateWinnerSides, rIdx) == -1 and not array.get(assigned, sIdx) and not array.get(assigned, rIdx)
        if ok
            array.set(assigned, sIdx, true)
            array.set(assigned, rIdx, true)
            ok := physicalAppendRaw(store, sIdx, rIdx, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerExactPrices, candidateWinnerMinRootIds, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds, candidateWinnerRootIdLength, mintick)
        k += 2
    int side = 1
    while ok and side >= -1
        array<int> d = side == 1 ? store.pairingSupportBottomOrderData : store.pairingResistanceBottomOrderData
        ok := array.size(d) % 3 == 0
        k := 0
        while ok and k < array.size(d)
            int w = array.get(d, k)
            ok := w >= 0 and w < n
            if ok
                ok := array.get(candidateWinnerSides, w) == side and array.get(candidateWinnerEffectiveBottomTicks, w) == array.get(d, k + 1) and array.get(candidateWinnerEffectiveTopTicks, w) == array.get(d, k + 2)
            if ok and not array.get(assigned, w)
                array.set(assigned, w, true)
                ok := physicalAppendRaw(store, side == 1 ? w : -1, side == 1 ? -1 : w, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerExactPrices, candidateWinnerMinRootIds, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds, candidateWinnerRootIdLength, mintick)
            k += 3
        side -= 2
    k := 0
    while ok and k < n
        ok := array.get(assigned, k)
        k += 1
    int count = array.size(store.physicalCandidateMinRootIds)
    if ok
        ok := count == n - int(mLen / 2)
    if not ok
        array.clear(store.physicalCandidateSupportWinnerIndexes)
        array.clear(store.physicalCandidateResistanceWinnerIndexes)
        array.clear(store.physicalCandidateBottomTicks)
        array.clear(store.physicalCandidateTopTicks)
        array.clear(store.physicalCandidateExactPrices)
        array.clear(store.physicalCandidateMinRootIds)
        array.clear(store.physicalCandidateRootIdOffsets)
        array.clear(store.physicalCandidateRootIdLengths)
        array.clear(store.physicalCandidateRootIds)
    store.physicalCandidateLogicalCount := ok ? count : 0
    store.physicalCandidateRootIdLength := ok ? array.size(store.physicalCandidateRootIds) : 0
    ok ? count : -1

// New canonical order of two physical Candidates: bottomTick, topTick, minRootId, then the complete rootId ASC Root
// set lexicographic (first differing ID, else the shorter set first). -1 / 1, or 0 on a complete tie.
physicalNewCompareRaw(W08Store store, int p, int q) =>
    int c  = 0
    int ka = array.get(store.physicalCandidateBottomTicks, p) - array.get(store.physicalCandidateBottomTicks, q)
    int kb = array.get(store.physicalCandidateTopTicks, p) - array.get(store.physicalCandidateTopTicks, q)
    int kc = array.get(store.physicalCandidateMinRootIds, p) - array.get(store.physicalCandidateMinRootIds, q)
    c := ka != 0 ? ka : kb != 0 ? kb : kc
    int a    = array.get(store.physicalCandidateRootIdOffsets, p)
    int b    = array.get(store.physicalCandidateRootIdOffsets, q)
    int aEnd = a + array.get(store.physicalCandidateRootIdLengths, p)
    int bEnd = b + array.get(store.physicalCandidateRootIdLengths, q)
    while c == 0 and a < aEnd and b < bEnd
        c := array.get(store.physicalCandidateRootIds, a) - array.get(store.physicalCandidateRootIds, b)
        a += 1
        b += 1
    if c == 0
        c := (aEnd - a) - (bEnd - b)
    c > 0 ? 1 : c < 0 ? -1 : 0

// Builds the physical Identity plan from rawEdges (stride 4 [physicalCandidateIndex, oldCoreSlot, oldCoreId,
// oldCoreCreatedTime], any order; exact Identity already decided by the caller) for physicalCount Candidates (must be
// this pass's physicalCandidateLogicalCount). Old / new ranks as in the header, canonical edges and the canonical
// maximum continuation matching are stored; returns the match count. -1 with both lists empty (no partial plan) for
// bad input, an index out of range, a na createdTime, a coreId seen with another slot / createdTime, a repeated edge, or
// two edge-bearing Candidates that tie on the complete new order. The physical Candidate storage is never touched.
export identityPlanBuild(W08Store store, int physicalCount, array<int> rawEdges) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalIdentityEdges)
    array.clear(store.physicalIdentityMatches)
    int  rLen = array.size(rawEdges)
    bool ok   = physicalCount >= 0 and physicalCount == store.physicalCandidateLogicalCount and rLen % 4 == 0
    // old: distinct coreIds sorted by (createdTime, coreId); new: distinct Candidates sorted by the new order
    array<int> oldIds   = array.new_int(0)
    array<int> oldSlots = array.new_int(0)
    array<int> oldTimes = array.new_int(0)
    array<int> newIdx   = array.new_int(0)
    int k = 0
    while ok and k < rLen
        int p  = array.get(rawEdges, k)
        int sl = array.get(rawEdges, k + 1)
        int id = array.get(rawEdges, k + 2)
        int ct = array.get(rawEdges, k + 3)
        ok := p >= 0 and p < physicalCount and sl >= 0 and id >= 1 and not na(ct)
        int pos = 0
        bool found = false
        while ok and not found and pos < array.size(oldIds)
            int oid = array.get(oldIds, pos)
            if oid == id
                found := true
                ok    := array.get(oldSlots, pos) == sl and array.get(oldTimes, pos) == ct
            else if array.get(oldTimes, pos) > ct or (array.get(oldTimes, pos) == ct and oid > id)
                break
            else
                pos += 1
        if ok and not found
            array.insert(oldIds, pos, id)
            array.insert(oldSlots, pos, sl)
            array.insert(oldTimes, pos, ct)
        pos   := 0
        found := false
        while ok and not found and pos < array.size(newIdx)
            int c = array.get(newIdx, pos) == p ? 0 : physicalNewCompareRaw(store, p, array.get(newIdx, pos))
            if array.get(newIdx, pos) == p
                found := true
            else if c == 0
                ok := false
            else if c < 0
                break
            else
                pos += 1
        if ok and not found
            array.insert(newIdx, pos, p)
        k += 4
    map<int, int> oldRank = map.new<int, int>()
    map<int, int> newRank = map.new<int, int>()
    k := 0
    while ok and k < array.size(oldIds)
        map.put(oldRank, array.get(oldIds, k), k)
        k += 1
    k := 0
    while ok and k < array.size(newIdx)
        map.put(newRank, array.get(newIdx, k), k)
        k += 1
    array<int> es    = array.new_int(0)
    array<int> er    = array.new_int(0)
    k := 0
    while ok and k < rLen
        array.push(es, map.get(oldRank, array.get(rawEdges, k + 2)))
        array.push(er, map.get(newRank, array.get(rawEdges, k)))
        k += 4
    array<int> edgeS = array.new_int(0)
    array<int> edgeR = array.new_int(0)
    array<int> pickS = array.new_int(0)
    array<int> pickR = array.new_int(0)
    int result = -1
    if ok
        result := matchingCanonicalRaw(es, er, array.size(oldIds), array.size(newIdx), edgeS, edgeR, pickS, pickR)
        ok := result >= 0
    int side = 0
    while ok and side < 2
        array<int> os  = side == 0 ? edgeS : pickS
        array<int> ns  = side == 0 ? edgeR : pickR
        array<int> out = side == 0 ? store.physicalIdentityEdges : store.physicalIdentityMatches
        k := 0
        while k < array.size(os)
            array.push(out, array.get(newIdx, array.get(ns, k)))
            array.push(out, array.get(oldSlots, array.get(os, k)))
            array.push(out, array.get(oldIds, array.get(os, k)))
            k += 1
        side += 1
    if not ok
        array.clear(store.physicalIdentityEdges)
        array.clear(store.physicalIdentityMatches)
    store.physicalIdentityEdgeCount  := ok ? int(array.size(store.physicalIdentityEdges) / 3) : 0
    store.physicalIdentityMatchCount := ok ? result : 0
    ok ? result : -1

// Side provenance order of two winners (-1 = the Side is absent): presence, Stage, effective bottom / top tick,
// minRootId, complete rootId ASC Root set lexicographic (shorter first on a common prefix), FVG mode, Psych presence,
// Psych tick. -1 / 1, or 0 on a complete tie.
winnerProvenanceCompareRaw(int v, int w, array<int> stages, array<int> bottomTicks, array<int> topTicks, array<int> minRootIds, array<int> fvgModes, array<int> psychLevelTicks, array<int> rootIdOffsets, array<int> rootIdLengths, array<int> rootIds) =>
    int c = (v >= 0 ? 1 : 0) - (w >= 0 ? 1 : 0)
    if c == 0 and v >= 0
        int pv = array.get(psychLevelTicks, v)
        int pw = array.get(psychLevelTicks, w)
        int k  = 0
        while c == 0 and k < 7
            int x = k == 0 ? array.get(stages, v) : k == 1 ? array.get(bottomTicks, v) : k == 2 ? array.get(topTicks, v) : k == 3 ? array.get(minRootIds, v) : k == 4 ? array.get(fvgModes, v) : k == 5 ? (na(pv) ? 0 : 1) : (na(pv) ? 0 : pv)
            int y = k == 0 ? array.get(stages, w) : k == 1 ? array.get(bottomTicks, w) : k == 2 ? array.get(topTicks, w) : k == 3 ? array.get(minRootIds, w) : k == 4 ? array.get(fvgModes, w) : k == 5 ? (na(pw) ? 0 : 1) : (na(pw) ? 0 : pw)
            c := x - y
            // the Root set is compared right after minRootId (key 4 of the descriptor)
            if c == 0 and k == 3
                int a    = array.get(rootIdOffsets, v)
                int b    = array.get(rootIdOffsets, w)
                int aEnd = a + array.get(rootIdLengths, v)
                int bEnd = b + array.get(rootIdLengths, w)
                while c == 0 and a < aEnd and b < bEnd
                    c := array.get(rootIds, a) - array.get(rootIds, b)
                    a += 1
                    b += 1
                if c == 0
                    c := (aEnd - a) - (bEnd - b)
            k += 1
    c > 0 ? 1 : c < 0 ? -1 : 0

// Builds the ownership plan of the current physical Candidates from physicalIdentityMatches (identityMatchCount must
// equal this pass's physicalIdentityMatchCount) and returns the fresh count. Every selected match must name a live old
// Core with coreIds[slot] == coreId >= 1 and generationId >= 1, each physical Candidate and each old Core at most once.
// Fresh Candidates are ranked by physicalNewCompareRaw, then Support and Resistance winnerProvenanceCompareRaw; a
// complete tie fails (no index or storage fallback). -1 with empty ownership storage on any fault.
export ownershipPlanBuild(W08Store store, int identityMatchCount, array<bool> coreLive, array<int> coreIds, array<int> coreGenerationIds, array<int> candidateWinnerStages, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerFvgModes, array<int> candidateWinnerPsychLevelTicks, array<int> candidateWinnerRootIdOffsets, array<int> candidateWinnerRootIdLengths, array<int> candidateWinnerRootIds, int candidateWinnerRootIdLength) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalOwnershipKinds)
    array.clear(store.physicalContinuationOldCoreSlots)
    array.clear(store.physicalContinuationCoreIds)
    array.clear(store.physicalContinuationGenerationIds)
    array.clear(store.physicalFreshAllocationRanks)
    int  n  = store.physicalCandidateLogicalCount
    bool ok = identityMatchCount >= 0 and identityMatchCount == store.physicalIdentityMatchCount and array.size(store.physicalIdentityMatches) == 3 * identityMatchCount and candidateWinnerRootIdLength <= array.size(candidateWinnerRootIds)
    int k = 0
    while ok and k < n
        array.push(store.physicalOwnershipKinds, 1)
        array.push(store.physicalContinuationOldCoreSlots, -1)
        array.push(store.physicalContinuationCoreIds, 0)
        array.push(store.physicalContinuationGenerationIds, 0)
        array.push(store.physicalFreshAllocationRanks, -1)
        // every present Side winner must hold a valid Root slice (read by the provenance order)
        int side = 0
        while ok and side < 2
            int w = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, k) : array.get(store.physicalCandidateResistanceWinnerIndexes, k)
            if w >= 0
                ok := w < array.size(candidateWinnerStages) and w < array.size(candidateWinnerEffectiveBottomTicks) and w < array.size(candidateWinnerEffectiveTopTicks) and w < array.size(candidateWinnerMinRootIds) and w < array.size(candidateWinnerFvgModes) and w < array.size(candidateWinnerPsychLevelTicks) and w < array.size(candidateWinnerRootIdOffsets) and w < array.size(candidateWinnerRootIdLengths)
                if ok
                    ok := array.get(candidateWinnerRootIdOffsets, w) >= 0 and array.get(candidateWinnerRootIdLengths, w) >= 0 and array.get(candidateWinnerRootIdOffsets, w) + array.get(candidateWinnerRootIdLengths, w) <= candidateWinnerRootIdLength
            side += 1
        k += 1
    map<int, bool> usedOld = map.new<int, bool>()
    k := 0
    while ok and k < identityMatchCount
        int p    = array.get(store.physicalIdentityMatches, 3 * k)
        int slot = array.get(store.physicalIdentityMatches, 3 * k + 1)
        int id   = array.get(store.physicalIdentityMatches, 3 * k + 2)
        ok := p >= 0 and p < n and slot >= 0 and slot < array.size(coreLive) and slot < array.size(coreIds) and slot < array.size(coreGenerationIds) and id >= 1 and not map.contains(usedOld, id)
        if ok
            ok := array.get(store.physicalOwnershipKinds, p) == 1 and array.get(coreLive, slot) and array.get(coreIds, slot) == id and array.get(coreGenerationIds, slot) >= 1
        if ok
            map.put(usedOld, id, true)
            array.set(store.physicalOwnershipKinds, p, 0)
            array.set(store.physicalContinuationOldCoreSlots, p, slot)
            array.set(store.physicalContinuationCoreIds, p, id)
            array.set(store.physicalContinuationGenerationIds, p, array.get(coreGenerationIds, slot))
        k += 1
    // fresh allocation order (insertion into a sorted list)
    array<int> fresh = array.new_int(0)
    k := 0
    while ok and k < n
        if array.get(store.physicalOwnershipKinds, k) == 1
            int pos = 0
            int c   = 1
            while ok and c > 0 and pos < array.size(fresh)
                int q = array.get(fresh, pos)
                c := physicalNewCompareRaw(store, k, q)
                int side = 0
                while c == 0 and side < 2
                    int v = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, k) : array.get(store.physicalCandidateResistanceWinnerIndexes, k)
                    int w = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, q) : array.get(store.physicalCandidateResistanceWinnerIndexes, q)
                    c := winnerProvenanceCompareRaw(v, w, candidateWinnerStages, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerMinRootIds, candidateWinnerFvgModes, candidateWinnerPsychLevelTicks, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds)
                    side += 1
                ok := c != 0
                if c > 0
                    pos += 1
            if ok
                array.insert(fresh, pos, k)
        k += 1
    k := 0
    while ok and k < array.size(fresh)
        array.set(store.physicalFreshAllocationRanks, array.get(fresh, k), k)
        k += 1
    if not ok
        array.clear(store.physicalOwnershipKinds)
        array.clear(store.physicalContinuationOldCoreSlots)
        array.clear(store.physicalContinuationCoreIds)
        array.clear(store.physicalContinuationGenerationIds)
        array.clear(store.physicalFreshAllocationRanks)
    store.physicalFreshAllocationCount := ok ? array.size(fresh) : 0
    ok ? array.size(fresh) : -1

// Read-only failure predicate of coreIndexRelease: the origin chain of coreSlot holds only live nodes of this slot and
// expectedCoreId and its length matches the row count, the interval tuple is in both orders or in neither with the
// same ticks (intervalDetachCheckRaw), and the inverse storage has whole 3-value groups.
export coreIndexCanRelease(W08Store store, int coreSlot, int expectedCoreId) =>
    bool ok    = coreSlot >= 0 and expectedCoreId != ID_NONE and array.size(store.inverseOriginData) % 3 == 0
    int  cur   = SLOT_INVALID
    int  total = 0
    if ok and coreSlot < array.size(store.coreZoneOriginRootCounts)
        cur   := array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        total := array.get(store.coreZoneOriginRootCounts, coreSlot)
    int n = 0
    while ok and cur != SLOT_INVALID
        ok := cur >= 0 and cur < array.size(store.coreZoneOriginRootNodeRootIds) and n < total
        if ok
            ok := array.get(store.coreZoneOriginRootNodeLiveFlags, cur) and array.get(store.coreZoneOriginRootNodeOwnerCoreSlots, cur) == coreSlot and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) == expectedCoreId
        n += 1
        if ok
            cur := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
    ok := ok and n == total
    if ok
        [iOk, iK, iJ] = intervalDetachCheckRaw(store, coreSlot, expectedCoreId)
        ok := iOk
    ok

// Removes every Worker entry of the Core (coreSlot, expectedCoreId): its whole origin chain (each node reclaimed to the
// free list, topologyRevision bumped once when a node goes), its interval tuple in both orders and every inverse-origin
// tuple of that slot and ID. Applies only when coreIndexCanRelease holds (then nothing below can fail); else false and
// nothing changes.
export coreIndexRelease(W08Store store, int coreSlot, int expectedCoreId) =>
    bool ok = coreIndexCanRelease(store, coreSlot, expectedCoreId)
    if ok
        [dOk, dChanged] = intervalDetach(store, coreSlot, expectedCoreId)
        int cur = SLOT_INVALID
        if coreSlot < array.size(store.coreZoneOriginRootCounts)
            cur := array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        if cur != SLOT_INVALID
            array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootCounts,          coreSlot, 0)
            store.topologyRevision := store.topologyRevision + 1
        while cur != SLOT_INVALID
            int nx = array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
            array.set(store.coreZoneOriginRootNodeRootIds,               cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeNextIndexes,           cur, SLOT_INVALID)
            array.set(store.coreZoneOriginRootNodeOwnerCoreSlots,        cur, SLOT_INVALID)
            array.set(store.coreZoneOriginRootNodeExpectedCoreIds,       cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeExpectedGenerationIds, cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeLiveFlags,             cur, false)
            array.push(store.coreZoneOriginRootNodeFreeIndexes, cur)
            cur := nx
        array<int> d = store.inverseOriginData
        int w = 0
        int k = 0
        while k < array.size(d)
            if not (array.get(d, k + 1) == coreSlot and array.get(d, k + 2) == expectedCoreId)
                array.set(d, w,     array.get(d, k))
                array.set(d, w + 1, array.get(d, k + 1))
                array.set(d, w + 2, array.get(d, k + 2))
                w += 3
            k += 3
        while array.size(d) > w
            array.pop(d)
    ok

// Read-only install predicate of one target Core after its release (or on a clean slot): every Root ID passes the
// originAdd / inverseOriginAdd input predicates and is strictly ascending (no duplicate node), and the interval tuple
// passes the intervalInsert input predicate. With no tuple of (coreSlot, coreId) left, originAdd / intervalInsert /
// inverseOriginAdd then cannot fail on this Core.
export coreIndexCanInstall(W08Store store, int coreSlot, int coreId, float physicalBottom, float physicalTop, float mintick, array<int> rootIds, int rootStart, int rootLen) =>
    bool ok   = rootStart >= 0 and rootLen > 0 and rootStart + rootLen <= array.size(rootIds) and intervalInsertInputOkRaw(store, coreSlot, coreId, coreId, physicalBottom, physicalTop, mintick)
    int  last = 0
    int  r    = 0
    while ok and r < rootLen
        int rootId = array.get(rootIds, rootStart + r)
        ok   := rootId > last and originAddInputOkRaw(coreSlot, coreId, rootId) and inverseOriginInputOkRaw(store, rootId, coreSlot, coreId)
        last := rootId
        r += 1
    ok

// true when coreSlot holds no Worker entry of any Core ID: no origin node counted on the slot, no interval tuple in
// either order and no inverse-origin tuple naming the slot.
export coreIndexClean(W08Store store, int coreSlot) =>
    bool clean = coreSlot >= 0 and array.size(store.coreIntervalTopOrderData) == array.size(store.coreIntervalOrderData)
    if clean and coreSlot < array.size(store.coreZoneOriginRootCounts)
        clean := array.get(store.coreZoneOriginRootCounts, coreSlot) == 0 and array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot) == SLOT_INVALID
    int k = 0
    while clean and k < array.size(store.coreIntervalOrderData)
        clean := array.get(store.coreIntervalOrderData, k) != coreSlot and array.get(store.coreIntervalTopOrderData, k) != coreSlot
        k += 4
    k := 0
    while clean and k < array.size(store.inverseOriginData)
        clean := array.get(store.inverseOriginData, k + 1) != coreSlot
        k += 3
    clean

// Canonical Identity edge order: old canonical order (coreCreatedTime, coreId ASC), inside one old strictly ascending
// physicalNewCompareRaw (so no edge repeats). Edge k (> 0) must follow the previous edge (lastCt, lastId, lastP).
identityEdgeFollowsRaw(W08Store store, int k, int ct, int id, int p, int lastCt, int lastId, int lastP) =>
    bool ok = k == 0 or ct > lastCt or (ct == lastCt and id > lastId)
    if not ok and k > 0 and ct == lastCt and id == lastId
        ok := physicalNewCompareRaw(store, lastP, p) < 0
    ok

// Builds the Merge relations of the current pass from physicalIdentityEdges and physicalIdentityMatches (ownershipResult
// must equal this pass's physicalFreshAllocationCount) and returns the relation count. Every edge must name a live old
// Core with coreIds[slot] == coreId >= 1, a set coreCreatedTime and one slot per coreId, edges in canonical old order
// with no repeat; a Candidate holds at most one match and that match must be one of its edges. Relation order =
// physicalNewCompareRaw (complete ties fail). Only the Merge storage is written; -1 with it empty on any fault.
export mergePlanBuild(W08Store store, int ownershipResult, array<bool> coreLive, array<int> coreIds, array<int> coreCreatedTimes) =>
    array.clear(store.mergeRelations)
    array.clear(store.mergeAbsorbed)
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nm = store.physicalIdentityMatchCount
    array<int> ed = store.physicalIdentityEdges
    bool ok = ownershipResult >= 0 and ownershipResult == store.physicalFreshAllocationCount and array.size(ed) == 3 * ne and array.size(store.physicalIdentityMatches) == 3 * nm
    array<int>  deg      = array.new_int(ok ? n : 0, 0)
    array<int>  matchId  = array.new_int(ok ? n : 0, 0)
    array<int>  matchSl  = array.new_int(ok ? n : 0, -1)
    array<bool> matchHit = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < nm
        int p = array.get(store.physicalIdentityMatches, 3 * k)
        ok := p >= 0 and p < n
        if ok
            ok := array.get(matchId, p) == 0 and array.get(store.physicalIdentityMatches, 3 * k + 2) >= 1
            array.set(matchSl, p, array.get(store.physicalIdentityMatches, 3 * k + 1))
            array.set(matchId, p, array.get(store.physicalIdentityMatches, 3 * k + 2))
        k += 1
    map<int, int> slotOf = map.new<int, int>()
    int lastCt = 0
    int lastId = 0
    int lastP  = -1
    k := 0
    while ok and k < ne
        int p  = array.get(ed, 3 * k)
        int sl = array.get(ed, 3 * k + 1)
        int id = array.get(ed, 3 * k + 2)
        ok := p >= 0 and p < n and sl >= 0 and sl < array.size(coreLive) and sl < array.size(coreIds) and sl < array.size(coreCreatedTimes) and id >= 1
        if ok
            ok := array.get(coreLive, sl) and array.get(coreIds, sl) == id and not na(array.get(coreCreatedTimes, sl)) and (not map.contains(slotOf, id) or map.get(slotOf, id) == sl)
        if ok
            int ct = array.get(coreCreatedTimes, sl)
            ok := identityEdgeFollowsRaw(store, k, ct, id, p, lastCt, lastId, lastP)
            map.put(slotOf, id, sl)
            array.set(deg, p, array.get(deg, p) + 1)
            if array.get(matchId, p) == id
                ok := ok and array.get(matchSl, p) == sl and not array.get(matchHit, p)
                array.set(matchHit, p, true)
            lastCt := ct
            lastId := id
            lastP  := p
        k += 1
    k := 0
    while ok and k < n
        ok := array.get(matchId, k) == 0 or array.get(matchHit, k)
        k += 1
    // Merge targets (degree >= 2) in new canonical order
    array<int> targets = array.new_int(0)
    k := 0
    while ok and k < n
        if array.get(deg, k) >= 2
            int pos = 0
            int c   = 1
            while ok and c > 0 and pos < array.size(targets)
                c  := physicalNewCompareRaw(store, k, array.get(targets, pos))
                ok := c != 0
                if c > 0
                    pos += 1
            if ok
                array.insert(targets, pos, k)
        k += 1
    int t = 0
    while ok and t < array.size(targets)
        int p   = array.get(targets, t)
        int off = int(array.size(store.mergeAbsorbed) / 2)
        k := 0
        while k < ne
            if array.get(ed, 3 * k) == p and array.get(ed, 3 * k + 2) != array.get(matchId, p)
                array.push(store.mergeAbsorbed, array.get(ed, 3 * k + 1))
                array.push(store.mergeAbsorbed, array.get(ed, 3 * k + 2))
            k += 1
        array.push(store.mergeRelations, p)
        array.push(store.mergeRelations, array.get(matchSl, p))
        array.push(store.mergeRelations, array.get(matchId, p))
        array.push(store.mergeRelations, off)
        array.push(store.mergeRelations, int(array.size(store.mergeAbsorbed) / 2) - off)
        t += 1
    if not ok
        array.clear(store.mergeRelations)
        array.clear(store.mergeAbsorbed)
    store.mergeRelationCount        := ok ? array.size(targets) : 0
    store.mergeAbsorbedLogicalCount := ok ? int(array.size(store.mergeAbsorbed) / 2) : 0
    ok ? array.size(targets) : -1

// Builds the Split relations of the current pass from physicalIdentityEdges, physicalIdentityMatches and the ownership
// plan (mergeResult must equal this pass's mergeRelationCount) and returns the relation count. Edge rows are validated
// as in mergePlanBuild; every match must be a full edge, each old / Candidate matched at most once, and the matched
// Candidate must be the continuation of that old in the ownership plan (the continuation count equals the match
// count). Edges already run in old canonical order with each old's Candidates in new canonical order, so a relation is
// one old's edge run of length >= 2. Only the Split storage is written; -1 with it empty on any fault.
export splitPlanBuild(W08Store store, int mergeResult, array<bool> coreLive, array<int> coreIds, array<int> coreCreatedTimes) =>
    array.clear(store.splitRelations)
    array.clear(store.splitChildren)
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nm = store.physicalIdentityMatchCount
    array<int> ed = store.physicalIdentityEdges
    array<int> mt = store.physicalIdentityMatches
    bool ok = mergeResult >= 0 and mergeResult == store.mergeRelationCount and array.size(ed) == 3 * ne and array.size(mt) == 3 * nm and array.size(store.physicalOwnershipKinds) == n and array.size(store.physicalContinuationOldCoreSlots) == n and array.size(store.physicalContinuationCoreIds) == n
    map<int, int> contOf = map.new<int, int>()
    array<bool> usedP = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < nm
        int p  = array.get(mt, 3 * k)
        int sl = array.get(mt, 3 * k + 1)
        int id = array.get(mt, 3 * k + 2)
        ok := p >= 0 and p < n and id >= 1 and not map.contains(contOf, id)
        if ok
            ok := not array.get(usedP, p) and array.get(store.physicalOwnershipKinds, p) == 0 and array.get(store.physicalContinuationOldCoreSlots, p) == sl and array.get(store.physicalContinuationCoreIds, p) == id
            array.set(usedP, p, true)
            map.put(contOf, id, p)
        k += 1
    int conts = 0
    k := 0
    while ok and k < n
        if array.get(store.physicalOwnershipKinds, k) == 0
            conts += 1
        k += 1
    ok := ok and conts == nm
    map<int, int> slotOf = map.new<int, int>()
    int hits   = 0
    int lastCt = 0
    int lastId = 0
    int lastP  = -1
    k := 0
    while ok and k < ne
        int p  = array.get(ed, 3 * k)
        int sl = array.get(ed, 3 * k + 1)
        int id = array.get(ed, 3 * k + 2)
        ok := p >= 0 and p < n and sl >= 0 and sl < array.size(coreLive) and sl < array.size(coreIds) and sl < array.size(coreCreatedTimes) and id >= 1
        if ok
            ok := array.get(coreLive, sl) and array.get(coreIds, sl) == id and not na(array.get(coreCreatedTimes, sl)) and (not map.contains(slotOf, id) or map.get(slotOf, id) == sl)
        if ok
            int ct = array.get(coreCreatedTimes, sl)
            ok := identityEdgeFollowsRaw(store, k, ct, id, p, lastCt, lastId, lastP)
            map.put(slotOf, id, sl)
            if map.contains(contOf, id)
                if map.get(contOf, id) == p
                    ok := ok and array.get(store.physicalContinuationOldCoreSlots, p) == sl
                    hits += 1
            lastCt := ct
            lastId := id
            lastP  := p
        k += 1
    ok := ok and hits == nm
    // one relation per old edge run of length >= 2 (run order = old canonical order, rows = new canonical order)
    int a = 0
    while ok and a < ne
        int id = array.get(ed, 3 * a + 2)
        int b  = a + 1
        while b < ne and array.get(ed, 3 * b + 2) == id
            b += 1
        if b - a >= 2
            int off  = array.size(store.splitChildren)
            int cont = -1
            if map.contains(contOf, id)
                cont := map.get(contOf, id)
            k := a
            while k < b
                array.push(store.splitChildren, array.get(ed, 3 * k))
                k += 1
            array.push(store.splitRelations, array.get(ed, 3 * a + 1))
            array.push(store.splitRelations, id)
            array.push(store.splitRelations, cont)
            array.push(store.splitRelations, off)
            array.push(store.splitRelations, b - a)
        a := b
    if not ok
        array.clear(store.splitRelations)
        array.clear(store.splitChildren)
    store.splitRelationCount     := ok ? int(array.size(store.splitRelations) / 5) : 0
    store.splitChildLogicalCount := ok ? array.size(store.splitChildren) : 0
    ok ? int(array.size(store.splitRelations) / 5) : -1

export type PendingTopologyStore
    array<bool>  corePendingTopologyFlags
    array<int>   corePendingTopologyChildHeadIndexes
    array<int>   corePendingTopologyChildTailIndexes
    array<int>   corePendingTopologyChildCounts
    array<int>   pendingTopologyChildNextIndexes
    array<int>   pendingTopologyChildOwnerCoreSlots
    array<int>   pendingTopologyChildExpectedCoreIds
    array<int>   pendingTopologyChildExpectedGenerationIds
    array<int>   pendingTopologyChildRootHeadNodeIndexes
    array<int>   pendingTopologyChildRootTailNodeIndexes
    array<int>   pendingTopologyChildRootCounts
    array<bool>  pendingTopologyChildLiveFlags
    array<int>   pendingTopologyChildFreeIndexes
    array<int>   pendingTopologyRootNodeRootIds
    array<int>   pendingTopologyRootNodeNextIndexes
    array<int>   pendingTopologyRootNodeOwnerChildIndexes
    array<int>   pendingTopologyRootNodeExpectedCoreIds
    array<int>   pendingTopologyRootNodeExpectedGenerationIds
    array<bool>  pendingTopologyRootNodeLiveFlags
    array<int>   pendingTopologyRootNodeFreeIndexes












// ==== TC-A: former W08Touch /7 body, verbatim (mergePlanBuild / splitPlanBuild -> touchMergePlanBuild / touchSplitPlanBuild; duplicate constants kept once) ====

const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SIDE_NONE       = 0
const int SEQ_UNSET       = -1

// W09 B07-R3B1 scratch-format contract (read-only, compile-time constants; the producer is ZoneEngineV2_W09State_Worker /22,
// checked by tests/r3b1_scratch_contract_check.py; no import of W09State, no W09 type). Episode rows (ei): stride 10,
// col 0 Side slot (Core slot * 2 + 0 Support / + 1 Resistance), 1 touchNo, 2 flags (bit 32 = the mark is WeakByDepth),
// 3 Core ID, 4 generation ID, 7 TouchStart plan row (-1 = existing ActiveTouch), 8 ring row of the existing mark (-1 = none),
// 9 override. Episode floats (ef): stride 6, col 0 / 1 range bottom / top, 4 Episode max depth pct. TouchStart plan ints:
// stride 30, col 1 Core slot, 2 Core ID, 3 generation ID, 4 side, 6 touchNo, 16 start seq (mark baseSeq), 17 start time (mark time),
// 27 isNormal (1). TouchStart plan floats: stride 7, col 2 / 3 contact bottom / top, 4 close at touch.
const int EI_STRIDE          = 10
const int EI_SIDE_SLOT       = 0
const int EI_TOUCH_NO        = 1
const int EI_FLAGS           = 2
const int EI_CORE_ID         = 3
const int EI_GENERATION_ID   = 4
const int EI_PLAN_ROW        = 7
const int EI_MARK_ROW        = 8
const int EI_OVERRIDE        = 9
const int EI_FLAG_MARK_WEAK  = 32
const int EF_STRIDE          = 6
const int EF_RANGE_BOTTOM    = 0
const int EF_RANGE_TOP       = 1
const int EF_EPISODE_MAX     = 4
const int PI_STRIDE          = 30
const int PI_CORE_SLOT       = 1
const int PI_CORE_ID         = 2
const int PI_GENERATION_ID   = 3
const int PI_SIDE            = 4
const int PI_TOUCH_NO        = 6
const int PI_BASE_SEQ        = 16
const int PI_TIME            = 17
const int PI_IS_NORMAL       = 27
const int PF_STRIDE          = 7
const int PF_CONTACT_BOTTOM  = 2
const int PF_CONTACT_TOP     = 3
const int PF_CLOSE           = 4

export type TouchRing
    array<int>   touchMarkRingOwnerCoreIds
    array<int>   touchMarkRingHeads
    array<int>   touchMarkRingCounts
    array<int>   touchMarkBaseSeqs
    array<int>   touchMarkTimes
    array<int>   touchMarkSides
    array<float> touchMarkContactBottoms
    array<float> touchMarkContactTops
    array<float> touchMarkCloseAtTouches
    array<int>   touchMarkGenerationIds
    array<bool>  touchMarkIsNormalTouchFlags
    array<bool>  sideTouchHistoryTruncatedFlags
    array<int>   coreIds
    array<bool>  coreSlotLiveFlags
    int          touchMarkCapacityPerCore = 0
    array<int>   touchMarkTouchNos
    array<bool>  touchMarkWeakByDepthFlags
    array<float> touchMarkMaxDepthPcts

export type TouchPlan
    array<int>   mergeTouchPlanOffsets
    array<int>   mergeTouchPlanCounts
    array<bool>  mergeTouchPlanTruncatedFlags
    array<int>   mergeTouchPlanBaseSeqs
    array<int>   mergeTouchPlanTimes
    array<int>   mergeTouchPlanSides
    array<float> mergeTouchPlanContactBottoms
    array<float> mergeTouchPlanContactTops
    array<float> mergeTouchPlanCloseAtTouches
    array<int>   mergeTouchPlanGenerationIds
    array<bool>  mergeTouchPlanIsNormalFlags
    array<int>   mergeTouchPlanTouchNos
    array<bool>  mergeTouchPlanWeakByDepthFlags
    array<float> mergeTouchPlanMaxDepthPcts

export type SplitTouchPlan
    array<int>   targetPhysicalIndexes
    array<int>   sourceOldCoreSlots
    array<int>   sourceOldCoreIds
    array<int>   markOffsets
    array<int>   markCounts
    array<bool>  truncatedFlags
    array<int>   baseSeqs
    array<int>   times
    array<int>   sides
    array<float> contactBottoms
    array<float> contactTops
    array<float> closeAtTouches
    array<int>   generationIds
    array<bool>  isNormalFlags
    array<int>   touchNos
    array<bool>  weakByDepthFlags
    array<float> maxDepthPcts

export newSplitTouchPlan() =>
    SplitTouchPlan.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_bool(0), array.new_float(0))

// Appends one TouchMark to the ring of coreSlot (full ring: the oldest mark is overwritten). Returns the physical row
// (SLOT_INVALID when the capacity is 0).
// W08 B10: a mark that is dropped (capacity 0) or overwritten (full ring: the oldest mark) sets
// sideTouchHistoryTruncatedFlags of the Side that loses it; a merely full ring does not.
// B06-B2C-C1: + the Episode fields (touchNo, weakByDepth, maxDepthPct; defaults 0 / false / 0.0) of the same row.
export markAppend(TouchRing ring, int coreSlot, int baseSeq, int touchTime, int side, float contactBottom, float contactTop, float closeAtTouch, int generationId, bool isNormalTouch, int touchNo = 0, bool weakByDepth = false, float maxDepthPct = 0.0) =>
    int capacity      = ring.touchMarkCapacityPerCore
    int physicalIndex = SLOT_INVALID
    int lostSide      = capacity > 0 ? SIDE_NONE : side
    if capacity > 0
        int head      = array.get(ring.touchMarkRingHeads,  coreSlot)
        int count     = array.get(ring.touchMarkRingCounts, coreSlot)
        int blockBase = coreSlot * capacity
        int ringOffset = count < capacity ? (head + count) % capacity : head
        physicalIndex := blockBase + ringOffset
        if count >= capacity
            lostSide := array.get(ring.touchMarkSides, physicalIndex)
        array.set(ring.touchMarkBaseSeqs,           physicalIndex, baseSeq)
        array.set(ring.touchMarkTimes,              physicalIndex, touchTime)
        array.set(ring.touchMarkSides,              physicalIndex, side)
        array.set(ring.touchMarkContactBottoms,     physicalIndex, contactBottom)
        array.set(ring.touchMarkContactTops,        physicalIndex, contactTop)
        array.set(ring.touchMarkCloseAtTouches,     physicalIndex, closeAtTouch)
        array.set(ring.touchMarkGenerationIds,      physicalIndex, generationId)
        array.set(ring.touchMarkIsNormalTouchFlags, physicalIndex, isNormalTouch)
        array.set(ring.touchMarkTouchNos,           physicalIndex, touchNo)
        array.set(ring.touchMarkWeakByDepthFlags,   physicalIndex, weakByDepth)
        array.set(ring.touchMarkMaxDepthPcts,       physicalIndex, maxDepthPct)
        if count < capacity
            array.set(ring.touchMarkRingCounts, coreSlot, count + 1)
        else
            array.set(ring.touchMarkRingHeads, coreSlot, (head + 1) % capacity)
    if lostSide == SIDE_SUPPORT or lostSide == SIDE_RESISTANCE
        array.set(ring.sideTouchHistoryTruncatedFlags, coreSlot * 2 + (lostSide == SIDE_SUPPORT ? 0 : 1), true)
    physicalIndex
// W08 B10: read-only extraction of the TouchMarks one Side of a live Core still holds, oldest first (ring logical order
// from head = insertion order; the marks of the other Side are skipped). Output rows go to the caller-owned arrays
// (cleared first): time, contact bottom, contact top, ring physical index (the payload row). Returns [count, stored truncated flag of that Side]; [-1, false]
// with the outputs empty when the slot is not live with expectedCoreId (Core and ring owner), the Side is not
// SIDE_SUPPORT / SIDE_RESISTANCE, the ring head / count / backing arrays are out of bounds, a held mark has no valid
// Side, or a mark of this Side has a na time / contact, bottom > top or a time before the previous one.
export historyExtract(TouchRing ring, int coreSlot, int expectedCoreId, int side, array<int> outTimes, array<float> outBottoms, array<float> outTops, array<int> outIndexes) =>
    array.clear(outTimes)
    array.clear(outBottoms)
    array.clear(outTops)
    array.clear(outIndexes)
    int  cap = ring.touchMarkCapacityPerCore
    bool ok  = coreSlot >= 0 and coreSlot < array.size(ring.coreIds) and coreSlot < array.size(ring.coreSlotLiveFlags) and coreSlot < array.size(ring.touchMarkRingOwnerCoreIds) and coreSlot < array.size(ring.touchMarkRingHeads) and coreSlot < array.size(ring.touchMarkRingCounts) and 2 * coreSlot + 1 < array.size(ring.sideTouchHistoryTruncatedFlags) and expectedCoreId >= 1 and (side == SIDE_SUPPORT or side == SIDE_RESISTANCE) and cap >= 0
    if ok
        ok := array.get(ring.coreSlotLiveFlags, coreSlot) and array.get(ring.coreIds, coreSlot) == expectedCoreId and array.get(ring.touchMarkRingOwnerCoreIds, coreSlot) == expectedCoreId
    int head  = 0
    int count = 0
    if ok
        head  := array.get(ring.touchMarkRingHeads, coreSlot)
        count := array.get(ring.touchMarkRingCounts, coreSlot)
    ok := ok and count >= 0 and count <= cap and head >= 0 and (head < cap or (cap == 0 and head == 0))
    ok := ok and (count == 0 or ((coreSlot + 1) * cap <= array.size(ring.touchMarkTimes) and (coreSlot + 1) * cap <= array.size(ring.touchMarkSides) and (coreSlot + 1) * cap <= array.size(ring.touchMarkContactBottoms) and (coreSlot + 1) * cap <= array.size(ring.touchMarkContactTops)))
    int i = 0
    while ok and i < count
        int phys = coreSlot * cap + (head + i) % cap
        int ms   = array.get(ring.touchMarkSides, phys)
        ok := ms == SIDE_SUPPORT or ms == SIDE_RESISTANCE
        if ok and ms == side
            int   t = array.get(ring.touchMarkTimes, phys)
            float b = array.get(ring.touchMarkContactBottoms, phys)
            float u = array.get(ring.touchMarkContactTops, phys)
            ok := not na(t) and not na(b) and not na(u) and b <= u
            if ok and array.size(outTimes) > 0
                ok := t >= array.get(outTimes, array.size(outTimes) - 1)
            if ok
                array.push(outTimes, t)
                array.push(outBottoms, b)
                array.push(outTops, u)
                array.push(outIndexes, phys)
        i += 1
    bool truncated = false
    if ok
        truncated := array.get(ring.sideTouchHistoryTruncatedFlags, coreSlot * 2 + (side == SIDE_SUPPORT ? 0 : 1))
    else
        array.clear(outTimes)
        array.clear(outBottoms)
        array.clear(outTops)
        array.clear(outIndexes)
    [ok ? array.size(outTimes) : -1, truncated]
// W08 B11: canonical merged TouchMark order of two ring rows (physical indexes): time, baseSeq, Side rank (Support 0,
// Resistance 1), contact bottom, contact top ASC. Used only to store / cap a Merge touch plan.
// B06-B2C-C2 (/5, structural): the canonical order compare on one set of payload arrays (time, baseSeq, Support < Resistance,
// contact bottom, contact top); the ring and the Merge plan orders below are this compare on their arrays.
keyCompareRaw(int ta, int tb, int qa, int qb, int sa, int sb, float ba, float bb, float ua, float ub) =>
    int c = ta - tb
    if c == 0
        c := qa - qb
    if c == 0
        c := (sa == SIDE_SUPPORT ? 0 : 1) - (sb == SIDE_SUPPORT ? 0 : 1)
    if c == 0
        c := ba < bb ? -1 : ba > bb ? 1 : ua < ub ? -1 : ua > ub ? 1 : 0
    c > 0 ? 1 : c < 0 ? -1 : 0
rowCompareRaw(array<int> ts, array<int> qs, array<int> sd, array<float> bs, array<float> us, int a, int b) =>
    keyCompareRaw(array.get(ts, a), array.get(ts, b), array.get(qs, a), array.get(qs, b), array.get(sd, a), array.get(sd, b), array.get(bs, a), array.get(bs, b), array.get(us, a), array.get(us, b))
// W09 B07-R3B1 (/7): projected source rows. A row index x >= 0 is a ring row (physical); x <= -2 is the projected new mark
// of TouchStart plan row -x - 2 (the mark Main appends after F0 with markAppend). Field k: 0 time, 1 baseSeq, 2 side,
// 3 generation, 4 touchNo (ints); 0 contact bottom, 1 contact top, 2 close (floats).
projIntRaw(TouchRing ring, array<int> pI, int x, int k) =>
    int v = na
    if x >= 0
        v := k == 0 ? array.get(ring.touchMarkTimes, x) : k == 1 ? array.get(ring.touchMarkBaseSeqs, x) : k == 2 ? array.get(ring.touchMarkSides, x) : k == 3 ? array.get(ring.touchMarkGenerationIds, x) : array.get(ring.touchMarkTouchNos, x)
    else
        v := array.get(pI, PI_STRIDE * (-x - 2) + (k == 0 ? PI_TIME : k == 1 ? PI_BASE_SEQ : k == 2 ? PI_SIDE : k == 3 ? PI_GENERATION_ID : PI_TOUCH_NO))
    v
projFloatRaw(TouchRing ring, array<float> pF, int x, int k) =>
    float v = na
    if x >= 0
        v := k == 0 ? array.get(ring.touchMarkContactBottoms, x) : k == 1 ? array.get(ring.touchMarkContactTops, x) : array.get(ring.touchMarkCloseAtTouches, x)
    else
        v := array.get(pF, PF_STRIDE * (-x - 2) + (k == 0 ? PF_CONTACT_BOTTOM : k == 1 ? PF_CONTACT_TOP : PF_CLOSE))
    v
// canonical merged order of two projected rows (the B11 compare on the projected keys)
projCompareRaw(TouchRing ring, array<int> pI, array<float> pF, int a, int b) =>
    keyCompareRaw(projIntRaw(ring, pI, a, 0), projIntRaw(ring, pI, b, 0), projIntRaw(ring, pI, a, 1), projIntRaw(ring, pI, b, 1), projIntRaw(ring, pI, a, 2), projIntRaw(ring, pI, b, 2), projFloatRaw(ring, pF, a, 0), projFloatRaw(ring, pF, b, 0), projFloatRaw(ring, pF, a, 1), projFloatRaw(ring, pF, b, 1))
// complete TouchStart plan rows (both the int and the float row present); na arrays read as none
projPlanRowsRaw(array<int> pI, array<float> pF) =>
    na(pI) or na(pF) ? 0 : math.min(int(math.floor(array.size(pI) / PI_STRIDE)), int(math.floor(array.size(pF) / PF_STRIDE)))
// appends of this bar to the source ring (slot, Core ID) among the plan rows before row upTo (all rows when upTo < 0)
projAppendsRaw(array<int> pI, array<float> pF, int sl, int id, int upTo) =>
    int nP  = projPlanRowsRaw(pI, pF)
    int lim = upTo < 0 ? nP : math.min(upTo, nP)
    int n   = 0
    int r   = 0
    while r < lim
        if array.get(pI, PI_STRIDE * r + PI_CORE_SLOT) == sl and array.get(pI, PI_STRIDE * r + PI_CORE_ID) == id
            n += 1
        r += 1
    n
// source ring projected append (markAppend semantics): with count + appends above the ring capacity the oldest logical rows
// of the combined sequence (ring rows, then the appends in plan order) are gone; returns how many
projDropRaw(TouchRing ring, array<int> pI, array<float> pF, int sl, int id) =>
    math.max(0, array.get(ring.touchMarkRingCounts, sl) + projAppendsRaw(pI, pF, sl, id, -1) - ring.touchMarkCapacityPerCore)
// logical position (0 = oldest) of the ring row x of slot sl
projLogicalRaw(TouchRing ring, int sl, int x) =>
    int cap = ring.touchMarkCapacityPerCore
    (x - sl * cap - array.get(ring.touchMarkRingHeads, sl) + cap) % cap
// Episode row (ei offset) whose mark is the projected row x, -1 none. Canonical key: Side slot (Core slot and Side), Core
// ID, generation ID, touchNo; A (existing mark): the Episode's ring row (col 8) inside the slot block, the ring owner and
// the ring row fields; B (new mark): the Episode's TouchStart plan row (col 7) with the plan Core slot / Core ID / side /
// generation / touchNo (its baseSeq, time and isNormal are that plan row's).
projEpisodeRaw(TouchRing ring, array<int> ei, array<float> ef, array<int> pI, int x) =>
    int nE  = na(ei) ? 0 : array.size(ei)
    int nF  = na(ef) ? 0 : array.size(ef)
    int cap = ring.touchMarkCapacityPerCore
    int e   = -1
    int i   = 0
    while e < 0 and i + EI_STRIDE <= nE and int(i / EI_STRIDE) * EF_STRIDE + EF_STRIDE <= nF
        int  s   = array.get(ei, i + EI_SIDE_SLOT)
        int  sl  = int(math.floor(s / 2))
        int  sv  = s - 2 * sl == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE
        int  cid = array.get(ei, i + EI_CORE_ID)
        bool hit = false
        if x >= 0
            hit := array.get(ei, i + EI_MARK_ROW) == x and cap > 0 and int(math.floor(x / cap)) == sl and sl < array.size(ring.touchMarkRingOwnerCoreIds)
            if hit
                hit := array.get(ring.touchMarkRingOwnerCoreIds, sl) == cid and array.get(ring.touchMarkSides, x) == sv and array.get(ring.touchMarkGenerationIds, x) == array.get(ei, i + EI_GENERATION_ID) and array.get(ring.touchMarkTouchNos, x) == array.get(ei, i + EI_TOUCH_NO)
        else
            int r = -x - 2
            hit := array.get(ei, i + EI_PLAN_ROW) == r
            if hit
                int o = PI_STRIDE * r
                hit := array.get(pI, o + PI_CORE_SLOT) == sl and array.get(pI, o + PI_CORE_ID) == cid and array.get(pI, o + PI_SIDE) == sv and array.get(pI, o + PI_GENERATION_ID) == array.get(ei, i + EI_GENERATION_ID) and array.get(pI, o + PI_TOUCH_NO) == array.get(ei, i + EI_TOUCH_NO)
        if hit
            e := i
        i += EI_STRIDE
    e
// one projected row appended whole (11 fields) to a plan's payload arrays (Merge and Split plans). A ring row keeps its
// payload; a projected new mark takes the TouchStart plan payload with markAppend's WeakByDepth false / max 0.0; the mark
// of an Episode row then carries the Episode WeakByDepth (flags bit 32) and max depth pct (ef col 4), the two fields
// episodeApply writes after F0. Nothing else is changed.
rowPushRaw(TouchRing ring, array<int> ei, array<float> ef, array<int> pI, array<float> pF, int x, array<int> q, array<int> t, array<int> sd, array<float> b, array<float> u, array<float> c, array<int> g, array<bool> nm, array<int> no, array<bool> wd, array<float> md) =>
    int   e = projEpisodeRaw(ring, ei, ef, pI, x)
    bool  w = false
    float m = 0.0
    if x >= 0
        array.push(q,  array.get(ring.touchMarkBaseSeqs, x))
        array.push(t,  array.get(ring.touchMarkTimes, x))
        array.push(sd, array.get(ring.touchMarkSides, x))
        array.push(b,  array.get(ring.touchMarkContactBottoms, x))
        array.push(u,  array.get(ring.touchMarkContactTops, x))
        array.push(c,  array.get(ring.touchMarkCloseAtTouches, x))
        array.push(g,  array.get(ring.touchMarkGenerationIds, x))
        array.push(nm, array.get(ring.touchMarkIsNormalTouchFlags, x))
        array.push(no, array.get(ring.touchMarkTouchNos, x))
        w := array.get(ring.touchMarkWeakByDepthFlags, x)
        m := array.get(ring.touchMarkMaxDepthPcts, x)
    else
        int o = PI_STRIDE * (-x - 2)
        int f = PF_STRIDE * (-x - 2)
        array.push(q,  array.get(pI, o + PI_BASE_SEQ))
        array.push(t,  array.get(pI, o + PI_TIME))
        array.push(sd, array.get(pI, o + PI_SIDE))
        array.push(b,  array.get(pF, f + PF_CONTACT_BOTTOM))
        array.push(u,  array.get(pF, f + PF_CONTACT_TOP))
        array.push(c,  array.get(pF, f + PF_CLOSE))
        array.push(g,  array.get(pI, o + PI_GENERATION_ID))
        array.push(nm, array.get(pI, o + PI_IS_NORMAL) == 1)
        array.push(no, array.get(pI, o + PI_TOUCH_NO))
    if e >= 0
        w := array.get(ei, e + EI_FLAGS) % (2 * EI_FLAG_MARK_WEAK) >= EI_FLAG_MARK_WEAK
        m := array.get(ef, int(e / EI_STRIDE) * EF_STRIDE + EF_EPISODE_MAX)
    array.push(wd, w)
    array.push(md, m)
planClearRaw(TouchPlan plan) =>
    array.clear(plan.mergeTouchPlanOffsets)
    array.clear(plan.mergeTouchPlanCounts)
    array.clear(plan.mergeTouchPlanTruncatedFlags)
    array.clear(plan.mergeTouchPlanBaseSeqs)
    array.clear(plan.mergeTouchPlanTimes)
    array.clear(plan.mergeTouchPlanSides)
    array.clear(plan.mergeTouchPlanContactBottoms)
    array.clear(plan.mergeTouchPlanContactTops)
    array.clear(plan.mergeTouchPlanCloseAtTouches)
    array.clear(plan.mergeTouchPlanGenerationIds)
    array.clear(plan.mergeTouchPlanIsNormalFlags)
    array.clear(plan.mergeTouchPlanTouchNos)
    array.clear(plan.mergeTouchPlanWeakByDepthFlags)
    array.clear(plan.mergeTouchPlanMaxDepthPcts)
// W08 B11: Merge TouchMark inheritance plan (read-only; no ring is written) of the r B08 Merge relations (r = the Main
// Merge plan result; -1 fails). Per Merge relation r (B08 order) and Side
// (plan index r * 2 + 0 Support / + 1 Resistance): when the target Candidate has that Side winner, every source old
// (survivor first, then mergeAbsorbed in old canonical order) is read with historyExtract; marks whose contact
// intersects the winner exact EffectiveRange (inclusive, exact floats) are kept and one mark per (time, contact bottom,
// contact top) survives: the first in source priority, then chronological order (payload kept whole). Both Sides are
// ordered by the canonical compare and capped once at the shared ring capacity (oldest rows dropped, each drop sets its
// Side's truncated flag); truncated also ORs the same-Side source flags. A Side without a target winner holds 0 rows,
// not truncated. Only the plan arrays are written. Returns the relation count; -1 with the plan empty on an upstream or
// structural fault.
export touchMergePlanBuild(TouchRing ring, TouchPlan plan, int r, int mergeRelationCount, array<int> mergeRelations, array<int> mergeAbsorbed, int physicalCount, array<int> supportWinnerIndexes, array<int> resistanceWinnerIndexes, array<float> winnerExactPrices, array<int> ei, array<float> ef, array<int> pI, array<float> pF) =>
    planClearRaw(plan)
    bool ok  = r >= 0 and r == mergeRelationCount and array.size(mergeRelations) == 5 * r
    int  cap = ring.touchMarkCapacityPerCore
    array<int>   tT   = array.new_int(0)
    array<float> tB   = array.new_float(0)
    array<float> tU   = array.new_float(0)
    array<int>   tI   = array.new_int(0)
    array<int>   rows = array.new_int(0)
    int j = 0
    while ok and j < r
        int p   = array.get(mergeRelations, 5 * j)
        int sSl = array.get(mergeRelations, 5 * j + 1)
        int sId = array.get(mergeRelations, 5 * j + 2)
        int off = array.get(mergeRelations, 5 * j + 3)
        int cnt = array.get(mergeRelations, 5 * j + 4)
        ok := p >= 0 and p < physicalCount and p < array.size(supportWinnerIndexes) and p < array.size(resistanceWinnerIndexes) and off >= 0 and cnt >= 1 and 2 * (off + cnt) <= array.size(mergeAbsorbed)
        array.clear(rows)
        bool trS  = false
        bool trR  = false
        int  side = 0
        while ok and side < 2
            int w = side == 0 ? array.get(supportWinnerIndexes, p) : array.get(resistanceWinnerIndexes, p)
            if w >= 0
                ok := 2 * w + 1 < array.size(winnerExactPrices)
                float tb = na
                float tt = na
                if ok
                    tb := array.get(winnerExactPrices, 2 * w)
                    tt := array.get(winnerExactPrices, 2 * w + 1)
                    ok := not na(tb) and not na(tt) and tb <= tt
                int start = array.size(rows)
                int s     = sId >= 1 ? -1 : 0
                while ok and s < cnt
                    int sl = sSl
                    int id = sId
                    if s >= 0
                        sl := array.get(mergeAbsorbed, 2 * (off + s))
                        id := array.get(mergeAbsorbed, 2 * (off + s) + 1)
                        ok := id != sId
                    int sv = side == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE
                    [n, tr] = historyExtract(ring, sl, id, sv, tT, tB, tU, tI)
                    ok := ok and n >= 0
                    // R3-B1 (A, source ring projected append): the projected history of this Side = the ring rows this bar's
                    // appends do not push out, then this bar's new marks of this Side in plan order; a pushed-out row
                    // truncates this Side. The rows then go through the unchanged B11 steps (range, dedupe, order, cap).
                    bool trP = tr
                    int  dr  = ok ? projDropRaw(ring, pI, pF, sl, id) : 0
                    int  nV  = ok ? projPlanRowsRaw(pI, pF) : 0
                    int  c0  = ok ? array.get(ring.touchMarkRingCounts, sl) : 0
                    int k = 0
                    while ok and k < n + nV
                        int  x   = k < n ? array.get(tI, k) : -(k - n) - 2
                        bool use = true
                        if k < n
                            if projLogicalRaw(ring, sl, x) < dr
                                use := false
                                trP := true
                        else
                            int o = PI_STRIDE * (k - n)
                            use := array.get(pI, o + PI_CORE_SLOT) == sl and array.get(pI, o + PI_CORE_ID) == id and array.get(pI, o + PI_SIDE) == sv
                            if use and c0 + projAppendsRaw(pI, pF, sl, id, k - n) < dr
                                use := false
                                trP := true
                        if use
                            int   ti = projIntRaw(ring, pI, x, 0)
                            float b  = projFloatRaw(ring, pF, x, 0)
                            float u  = projFloatRaw(ring, pF, x, 1)
                            if u >= tb and b <= tt
                                bool dup = false
                                int  q   = start
                                while not dup and q < array.size(rows)
                                    int y = array.get(rows, q)
                                    dup := projIntRaw(ring, pI, y, 0) == ti and projFloatRaw(ring, pF, y, 0) == b and projFloatRaw(ring, pF, y, 1) == u
                                    q += 1
                                if not dup
                                    array.push(rows, x)
                        k += 1
                    if side == 0
                        trS := trS or trP
                    else
                        trR := trR or trP
                    s += 1
            side += 1
        // canonical order over both Sides (insertion sort; the order is total after the per-Side dedupe)
        int a = 1
        while ok and a < array.size(rows)
            int x = array.get(rows, a)
            int b = a - 1
            while b >= 0 and projCompareRaw(ring, pI, pF, array.get(rows, b), x) > 0
                array.set(rows, b + 1, array.get(rows, b))
                b -= 1
            array.set(rows, b + 1, x)
            ok := b < 0 or projCompareRaw(ring, pI, pF, array.get(rows, b), x) < 0
            a += 1
        // shared S/R ring capacity: the oldest rows are dropped, each drop truncates its own Side
        int drop = math.max(0, array.size(rows) - cap)
        int k = 0
        while ok and k < drop
            if projIntRaw(ring, pI, array.get(rows, k), 2) == SIDE_SUPPORT
                trS := true
            else
                trR := true
            k += 1
        side := 0
        while ok and side < 2
            int sv = side == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE
            array.push(plan.mergeTouchPlanOffsets, array.size(plan.mergeTouchPlanTimes))
            k := drop
            while k < array.size(rows)
                int x = array.get(rows, k)
                if projIntRaw(ring, pI, x, 2) == sv
                    rowPushRaw(ring, ei, ef, pI, pF, x, plan.mergeTouchPlanBaseSeqs, plan.mergeTouchPlanTimes, plan.mergeTouchPlanSides, plan.mergeTouchPlanContactBottoms, plan.mergeTouchPlanContactTops, plan.mergeTouchPlanCloseAtTouches, plan.mergeTouchPlanGenerationIds, plan.mergeTouchPlanIsNormalFlags, plan.mergeTouchPlanTouchNos, plan.mergeTouchPlanWeakByDepthFlags, plan.mergeTouchPlanMaxDepthPcts)
                k += 1
            array.push(plan.mergeTouchPlanCounts, array.size(plan.mergeTouchPlanTimes) - array.get(plan.mergeTouchPlanOffsets, 2 * j + side))
            array.push(plan.mergeTouchPlanTruncatedFlags, side == 0 ? trS : trR)
            side += 1
        j += 1
    if not ok
        planClearRaw(plan)
    ok ? r : -1
splitPlanClearRaw(SplitTouchPlan plan) =>
    array.clear(plan.targetPhysicalIndexes)
    array.clear(plan.sourceOldCoreSlots)
    array.clear(plan.sourceOldCoreIds)
    array.clear(plan.markOffsets)
    array.clear(plan.markCounts)
    array.clear(plan.truncatedFlags)
    array.clear(plan.baseSeqs)
    array.clear(plan.times)
    array.clear(plan.sides)
    array.clear(plan.contactBottoms)
    array.clear(plan.contactTops)
    array.clear(plan.closeAtTouches)
    array.clear(plan.generationIds)
    array.clear(plan.isNormalFlags)
    array.clear(plan.touchNos)
    array.clear(plan.weakByDepthFlags)
    array.clear(plan.maxDepthPcts)
// W08 B12: Split TouchMark assignment plan (read-only; no ring is written). s = the W08Core Split plan result (must equal
// splitRelationCount), m = the B11 Merge TouchMark plan result (must equal mergeRelationCount; the B11 relation-side
// arrays must hold 2 * m rows). A Split child that is a Merge target (one B08 relation per Candidate, else fail) is
// delegated to the B11 plan (no row). Every other child is SPLIT_LOCAL: it must appear in one Split relation only (else
// fail) and gets one row in Split relation / child order: the source old ring is read with historyExtract per Side (the
// B10 validation) and walked in its logical order across both Sides; a mark is copied whole (no dedupe, no re-sort)
// when the child has a winner on the mark's Side whose exact EffectiveRange intersects the contact (inclusive, exact
// floats; na / inverted range fails). Truncated per Side = the child has that Side winner and the source Side flag is
// set. A row above the ring capacity fails. Returns the SPLIT_LOCAL target count; -1 with the plan empty on any fault.
export touchSplitPlanBuild(TouchRing ring, SplitTouchPlan plan, int s, int splitRelationCount, array<int> splitRelations, array<int> splitChildren, int m, int mergeRelationCount, array<int> mergeRelations, array<int> mergePlanOffsets, array<int> mergePlanCounts, array<bool> mergePlanTruncatedFlags, int physicalCount, array<int> supportWinnerIndexes, array<int> resistanceWinnerIndexes, array<float> winnerExactPrices, array<int> ei, array<float> ef, array<int> pI, array<float> pF) =>
    splitPlanClearRaw(plan)
    int  cap = ring.touchMarkCapacityPerCore
    bool ok  = s >= 0 and s == splitRelationCount and array.size(splitRelations) == 5 * s and m >= 0 and m == mergeRelationCount and array.size(mergeRelations) == 5 * m and array.size(mergePlanOffsets) == 2 * m and array.size(mergePlanCounts) == 2 * m and array.size(mergePlanTruncatedFlags) == 2 * m and physicalCount >= 0 and physicalCount <= array.size(supportWinnerIndexes) and physicalCount <= array.size(resistanceWinnerIndexes)
    array<int>  mergeOf = array.new_int(ok ? physicalCount : 0, -1)
    array<bool> seenLocal = array.new_bool(ok ? physicalCount : 0, false)
    int j = 0
    while ok and j < m
        int p = array.get(mergeRelations, 5 * j)
        ok := p >= 0 and p < physicalCount
        if ok
            ok := array.get(mergeOf, p) == -1
            array.set(mergeOf, p, j)
        j += 1
    array<int>   tT  = array.new_int(0)
    array<float> tB  = array.new_float(0)
    array<float> tU  = array.new_float(0)
    array<int>   iS  = array.new_int(0)
    array<int>   iR  = array.new_int(0)
    array<int>   src = array.new_int(0)
    int i = 0
    while ok and i < s
        int sl  = array.get(splitRelations, 5 * i)
        int id  = array.get(splitRelations, 5 * i + 1)
        int off = array.get(splitRelations, 5 * i + 3)
        int cnt = array.get(splitRelations, 5 * i + 4)
        ok := off >= 0 and cnt >= 1 and off + cnt <= array.size(splitChildren)
        // source ring in logical order across both Sides (merge of the two per-Side extractions by ring position)
        [nS, trS] = historyExtract(ring, sl, id, SIDE_SUPPORT, tT, tB, tU, iS)
        [nR, trR] = historyExtract(ring, sl, id, SIDE_RESISTANCE, tT, tB, tU, iR)
        ok := ok and nS >= 0 and nR >= 0
        array.clear(src)
        if ok and nS + nR > 0
            int base = sl * cap
            int head = array.get(ring.touchMarkRingHeads, sl)
            int a    = 0
            int b    = 0
            while a < nS or b < nR
                bool takeS = b >= nR
                if a < nS and b < nR
                    takeS := (array.get(iS, a) - base - head + cap) % cap < (array.get(iR, b) - base - head + cap) % cap
                if takeS
                    array.push(src, array.get(iS, a))
                    a += 1
                else
                    array.push(src, array.get(iR, b))
                    b += 1
        // R3-B1 (A, source ring projected append): the oldest dr logical rows are gone (each truncates its own Side), then this
        // bar's new marks of the Core are appended in plan order; logical order kept, no dedupe, no re-sort. The child cap
        // below is unchanged: a child above the capacity FAILS (never trimmed).
        bool pS = trS
        bool pR = trR
        if ok
            int dr = projDropRaw(ring, pI, pF, sl, id)
            int c0 = array.get(ring.touchMarkRingCounts, sl)
            int dq = 0
            while dq < math.min(dr, c0)
                if array.get(ring.touchMarkSides, array.remove(src, 0)) == SIDE_SUPPORT
                    pS := true
                else
                    pR := true
                dq += 1
            int nV = projPlanRowsRaw(pI, pF)
            int rk = 0
            int r0 = 0
            while r0 < nV
                int o = PI_STRIDE * r0
                if array.get(pI, o + PI_CORE_SLOT) == sl and array.get(pI, o + PI_CORE_ID) == id
                    if c0 + rk < dr
                        if array.get(pI, o + PI_SIDE) == SIDE_SUPPORT
                            pS := true
                        else
                            pR := true
                    else
                        array.push(src, -r0 - 2)
                    rk += 1
                r0 += 1
        int k = 0
        while ok and k < cnt
            int p = array.get(splitChildren, off + k)
            ok := p >= 0 and p < physicalCount
            if ok and array.get(mergeOf, p) < 0
                ok := not array.get(seenLocal, p)
                array.set(seenLocal, p, true)
                int   wS  = array.get(supportWinnerIndexes, p)
                int   wR  = array.get(resistanceWinnerIndexes, p)
                float sb  = na
                float st  = na
                float rb  = na
                float rt  = na
                if ok and wS >= 0
                    ok := 2 * wS + 1 < array.size(winnerExactPrices)
                    if ok
                        sb := array.get(winnerExactPrices, 2 * wS)
                        st := array.get(winnerExactPrices, 2 * wS + 1)
                        ok := not na(sb) and not na(st) and sb <= st
                if ok and wR >= 0
                    ok := 2 * wR + 1 < array.size(winnerExactPrices)
                    if ok
                        rb := array.get(winnerExactPrices, 2 * wR)
                        rt := array.get(winnerExactPrices, 2 * wR + 1)
                        ok := not na(rb) and not na(rt) and rb <= rt
                if ok
                    int start = array.size(plan.times)
                    array.push(plan.targetPhysicalIndexes, p)
                    array.push(plan.sourceOldCoreSlots, sl)
                    array.push(plan.sourceOldCoreIds, id)
                    array.push(plan.markOffsets, start)
                    int q = 0
                    while q < array.size(src)
                        int   x    = array.get(src, q)
                        bool  isS  = projIntRaw(ring, pI, x, 2) == SIDE_SUPPORT
                        float cb   = projFloatRaw(ring, pF, x, 0)
                        float ct   = projFloatRaw(ring, pF, x, 1)
                        bool  take = isS ? (wS >= 0 and ct >= sb and cb <= st) : (wR >= 0 and ct >= rb and cb <= rt)
                        if take
                            rowPushRaw(ring, ei, ef, pI, pF, x, plan.baseSeqs, plan.times, plan.sides, plan.contactBottoms, plan.contactTops, plan.closeAtTouches, plan.generationIds, plan.isNormalFlags, plan.touchNos, plan.weakByDepthFlags, plan.maxDepthPcts)
                        q += 1
                    array.push(plan.markCounts, array.size(plan.times) - start)
                    array.push(plan.truncatedFlags, wS >= 0 and pS)
                    array.push(plan.truncatedFlags, wR >= 0 and pR)
                    ok := array.size(plan.times) - start <= cap
            k += 1
        i += 1
    if not ok
        splitPlanClearRaw(plan)
    ok ? array.size(plan.targetPhysicalIndexes) : -1

// W08 B15-B2: B11 canonical order of two Merge plan rows (the canonical compare keys on the copied payload).
planRowCompareRaw(TouchPlan plan, int a, int b) =>
    rowCompareRaw(plan.mergeTouchPlanTimes, plan.mergeTouchPlanBaseSeqs, plan.mergeTouchPlanSides, plan.mergeTouchPlanContactBottoms, plan.mergeTouchPlanContactTops, a, b)
// Target ring block shape shared by both apply preflights: slot rows, truncated flags, payload capacity.
ringTargetOkRaw(TouchRing ring, int targetSlot) =>
    int cap = ring.touchMarkCapacityPerCore
    int end = (targetSlot + 1) * cap
    cap >= 0 and targetSlot >= 0 and targetSlot < array.size(ring.touchMarkRingOwnerCoreIds) and targetSlot < array.size(ring.touchMarkRingHeads) and targetSlot < array.size(ring.touchMarkRingCounts) and 2 * targetSlot + 1 < array.size(ring.sideTouchHistoryTruncatedFlags) and end <= array.size(ring.touchMarkBaseSeqs) and end <= array.size(ring.touchMarkTimes) and end <= array.size(ring.touchMarkSides) and end <= array.size(ring.touchMarkContactBottoms) and end <= array.size(ring.touchMarkContactTops) and end <= array.size(ring.touchMarkCloseAtTouches) and end <= array.size(ring.touchMarkGenerationIds) and end <= array.size(ring.touchMarkIsNormalTouchFlags) and end <= array.size(ring.touchMarkTouchNos) and end <= array.size(ring.touchMarkWeakByDepthFlags) and end <= array.size(ring.touchMarkMaxDepthPcts)
ringRowWriteRaw(TouchRing ring, int phys, int baseSeq, int t, int side, float b, float u, float c, int g, bool normal, int no, bool wd, float md) =>
    array.set(ring.touchMarkBaseSeqs,           phys, baseSeq)
    array.set(ring.touchMarkTimes,              phys, t)
    array.set(ring.touchMarkSides,              phys, side)
    array.set(ring.touchMarkContactBottoms,     phys, b)
    array.set(ring.touchMarkContactTops,        phys, u)
    array.set(ring.touchMarkCloseAtTouches,     phys, c)
    array.set(ring.touchMarkGenerationIds,      phys, g)
    array.set(ring.touchMarkIsNormalTouchFlags, phys, normal)
    array.set(ring.touchMarkTouchNos,           phys, no)
    array.set(ring.touchMarkWeakByDepthFlags,   phys, wd)
    array.set(ring.touchMarkMaxDepthPcts,       phys, md)
// Rows n .. capacity - 1 of the target block back to the empty-row defaults (coreAlloc values), then head / count / owner
// / truncated flags.
ringFinishRaw(TouchRing ring, int targetSlot, int targetCoreId, int n, bool trS, bool trR) =>
    int cap = ring.touchMarkCapacityPerCore
    int i   = n
    while i < cap
        ringRowWriteRaw(ring, targetSlot * cap + i, SEQ_UNSET, int(na), SIDE_NONE, float(na), float(na), float(na), ID_NONE, false, 0, false, 0.0)
        i += 1
    array.set(ring.touchMarkRingHeads,        targetSlot, 0)
    array.set(ring.touchMarkRingCounts,       targetSlot, n)
    array.set(ring.touchMarkRingOwnerCoreIds, targetSlot, targetCoreId)
    array.set(ring.sideTouchHistoryTruncatedFlags, targetSlot * 2,     trS)
    array.set(ring.sideTouchHistoryTruncatedFlags, targetSlot * 2 + 1, trR)
// W08 B15-B2: read-only preflight of mergeApplyCommit for Merge relation j: plan relation-side rows (offset / count /
// truncated for both Sides, equal payload array sizes), each Side block holds only its Side with a valid time / contact
// (bottom <= top) in strictly increasing B11 order, both Sides together within the ring capacity. The target slot may not
// exist yet (fresh Core appended by the commit), so its block shape is an invariant of the commit.
export mergeApplyPreflight(TouchRing ring, TouchPlan plan, int j) =>
    int  cap   = ring.touchMarkCapacityPerCore
    int  nRows = array.size(plan.mergeTouchPlanTimes)
    bool ok    = j >= 0 and 2 * j + 1 < array.size(plan.mergeTouchPlanOffsets) and 2 * j + 1 < array.size(plan.mergeTouchPlanCounts) and 2 * j + 1 < array.size(plan.mergeTouchPlanTruncatedFlags) and cap >= 0 and array.size(plan.mergeTouchPlanBaseSeqs) == nRows and array.size(plan.mergeTouchPlanSides) == nRows and array.size(plan.mergeTouchPlanContactBottoms) == nRows and array.size(plan.mergeTouchPlanContactTops) == nRows and array.size(plan.mergeTouchPlanCloseAtTouches) == nRows and array.size(plan.mergeTouchPlanGenerationIds) == nRows and array.size(plan.mergeTouchPlanIsNormalFlags) == nRows and array.size(plan.mergeTouchPlanTouchNos) == nRows and array.size(plan.mergeTouchPlanWeakByDepthFlags) == nRows and array.size(plan.mergeTouchPlanMaxDepthPcts) == nRows
    int total = 0
    int side  = 0
    while ok and side < 2
        int off = array.get(plan.mergeTouchPlanOffsets, 2 * j + side)
        int cnt = array.get(plan.mergeTouchPlanCounts,  2 * j + side)
        ok := off >= 0 and cnt >= 0 and off + cnt <= nRows
        int k = 0
        while ok and k < cnt
            int   x = off + k
            float b = array.get(plan.mergeTouchPlanContactBottoms, x)
            float u = array.get(plan.mergeTouchPlanContactTops, x)
            ok := array.get(plan.mergeTouchPlanSides, x) == (side == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE) and not na(array.get(plan.mergeTouchPlanTimes, x)) and not na(b) and not na(u) and b <= u
            if ok and k > 0
                ok := planRowCompareRaw(plan, x - 1, x) < 0
            k += 1
        total += cnt
        side += 1
    ok and total <= cap
// Commit of Merge relation j onto targetSlot (after mergeApplyPreflight and the Core materialization): both Side blocks
// merged in B11 order into rows 0 .. n - 1, the rest reset, owner targetCoreId, truncated flags = the plan relation-side
// flags. Returns n; -1 when the target is not the live targetCoreId or its block does not exist (invariant break).
export mergeApplyCommit(TouchRing ring, TouchPlan plan, int j, int targetSlot, int targetCoreId) =>
    int  cap  = ring.touchMarkCapacityPerCore
    int  offS = array.get(plan.mergeTouchPlanOffsets, 2 * j)
    int  cntS = array.get(plan.mergeTouchPlanCounts,  2 * j)
    int  offR = array.get(plan.mergeTouchPlanOffsets, 2 * j + 1)
    int  cntR = array.get(plan.mergeTouchPlanCounts,  2 * j + 1)
    bool ok   = targetCoreId >= 1 and ringTargetOkRaw(ring, targetSlot) and targetSlot < array.size(ring.coreIds) and targetSlot < array.size(ring.coreSlotLiveFlags) and cntS + cntR <= cap
    if ok
        ok := array.get(ring.coreSlotLiveFlags, targetSlot) and array.get(ring.coreIds, targetSlot) == targetCoreId
    int a = 0
    int b = 0
    while ok and (a < cntS or b < cntR)
        bool takeS = b >= cntR
        if a < cntS and b < cntR
            takeS := planRowCompareRaw(plan, offS + a, offR + b) < 0
        int x = takeS ? offS + a : offR + b
        ringRowWriteRaw(ring, targetSlot * cap + a + b, array.get(plan.mergeTouchPlanBaseSeqs, x), array.get(plan.mergeTouchPlanTimes, x), array.get(plan.mergeTouchPlanSides, x), array.get(plan.mergeTouchPlanContactBottoms, x), array.get(plan.mergeTouchPlanContactTops, x), array.get(plan.mergeTouchPlanCloseAtTouches, x), array.get(plan.mergeTouchPlanGenerationIds, x), array.get(plan.mergeTouchPlanIsNormalFlags, x), array.get(plan.mergeTouchPlanTouchNos, x), array.get(plan.mergeTouchPlanWeakByDepthFlags, x), array.get(plan.mergeTouchPlanMaxDepthPcts, x))
        if takeS
            a += 1
        else
            b += 1
    if ok
        ringFinishRaw(ring, targetSlot, targetCoreId, cntS + cntR, array.get(plan.mergeTouchPlanTruncatedFlags, 2 * j), array.get(plan.mergeTouchPlanTruncatedFlags, 2 * j + 1))
    ok ? cntS + cntR : -1
// W08 B15-B2: read-only preflight of splitApplyCommit for SPLIT_LOCAL row k: plan row arrays (offset / count / two
// truncated flags, equal payload sizes), every mark a Support / Resistance mark with a valid time / contact, count within
// the ring capacity (target block shape: invariant of the commit, as for Merge).
export splitApplyPreflight(TouchRing ring, SplitTouchPlan plan, int k) =>
    int  cap   = ring.touchMarkCapacityPerCore
    int  nRows = array.size(plan.times)
    bool ok    = k >= 0 and k < array.size(plan.targetPhysicalIndexes) and k < array.size(plan.markOffsets) and k < array.size(plan.markCounts) and 2 * k + 1 < array.size(plan.truncatedFlags) and cap >= 0 and array.size(plan.baseSeqs) == nRows and array.size(plan.sides) == nRows and array.size(plan.contactBottoms) == nRows and array.size(plan.contactTops) == nRows and array.size(plan.closeAtTouches) == nRows and array.size(plan.generationIds) == nRows and array.size(plan.isNormalFlags) == nRows and array.size(plan.touchNos) == nRows and array.size(plan.weakByDepthFlags) == nRows and array.size(plan.maxDepthPcts) == nRows
    int off = 0
    int cnt = 0
    if ok
        off := array.get(plan.markOffsets, k)
        cnt := array.get(plan.markCounts, k)
    ok := ok and off >= 0 and cnt >= 0 and off + cnt <= nRows and cnt <= cap
    int i = 0
    while ok and i < cnt
        int   x  = off + i
        int   sd = array.get(plan.sides, x)
        float b  = array.get(plan.contactBottoms, x)
        float u  = array.get(plan.contactTops, x)
        ok := (sd == SIDE_SUPPORT or sd == SIDE_RESISTANCE) and not na(array.get(plan.times, x)) and not na(b) and not na(u) and b <= u
        i += 1
    ok
// Commit of SPLIT_LOCAL row k onto targetSlot (after splitApplyPreflight and the Core materialization): marks in plan order
// into rows 0 .. n - 1, the rest reset, owner targetCoreId, truncated flags = the plan row flags. Returns n; -1 on an
// invariant break as for Merge.
export splitApplyCommit(TouchRing ring, SplitTouchPlan plan, int k, int targetSlot, int targetCoreId) =>
    int  cap = ring.touchMarkCapacityPerCore
    int  off = array.get(plan.markOffsets, k)
    int  cnt = array.get(plan.markCounts, k)
    bool ok  = targetCoreId >= 1 and ringTargetOkRaw(ring, targetSlot) and targetSlot < array.size(ring.coreIds) and targetSlot < array.size(ring.coreSlotLiveFlags) and cnt <= cap
    if ok
        ok := array.get(ring.coreSlotLiveFlags, targetSlot) and array.get(ring.coreIds, targetSlot) == targetCoreId
    int i = 0
    while ok and i < cnt
        int x = off + i
        ringRowWriteRaw(ring, targetSlot * cap + i, array.get(plan.baseSeqs, x), array.get(plan.times, x), array.get(plan.sides, x), array.get(plan.contactBottoms, x), array.get(plan.contactTops, x), array.get(plan.closeAtTouches, x), array.get(plan.generationIds, x), array.get(plan.isNormalFlags, x), array.get(plan.touchNos, x), array.get(plan.weakByDepthFlags, x), array.get(plan.maxDepthPcts, x))
        i += 1
    if ok
        ringFinishRaw(ring, targetSlot, targetCoreId, cnt, array.get(plan.truncatedFlags, 2 * k), array.get(plan.truncatedFlags, 2 * k + 1))
    ok ? cnt : -1

// ==== TC-A: W08Runtime body (W08Core. / W08Touch. qualifiers resolved in-library; duplicate constants / helpers kept once) ====


const int CAT_FVG         = 4
const int PH_WAITING      = 0
const int PH_ARMED        = 1
const int PH_BROKEN       = 3
const int PH_FLIP_WAIT    = 4
const int PH_DORMANT      = 5
const int GR_UNAVAILABLE  = 3
const int FVG_MASK_NONE   = 0
const int DEP_TICK_NA = -2147483647
const int CAT_MA       = 0
const int CAT_SWING    = 1
const int CAT_ACCUM    = 2
const int CAT_TIME_HL  = 3
const int ROOT_ACTIVE  = 1

export type RootView
    array<int>    rootIds
    array<bool>   rootSlotLiveFlags
    map<int, int> rootIdToSlot
    array<int>    rootCategories
    array<bool>   rootIsBroadFvgFlags
    array<int>    rootParticipationHeadEdgeIndexes
    array<int>    rootParticipationCounts
    array<int>    rootPriceOrderSlots
    array<int>    rootPointTicks
    array<int>    rootStates
    array<int>    rootDirections
    array<int>    rootNativeBottomTicks
    array<int>    rootNativeTopTicks

export type ParticipationView
    array<int>  participationEdgeRootSlots
    array<int>  participationEdgeExpectedRootIds
    array<int>  participationEdgeSideSlots
    array<int>  participationEdgeExpectedCoreIds
    array<int>  participationEdgeNextByRootIndexes
    array<bool> participationEdgeLiveFlags
    array<int>  participationEdgeFreeIndexes

export type PhaseSetView
    array<int> phaseWaitingSideSlots
    array<int> phaseArmedSideSlots
    array<int> phaseActiveTouchSideSlots
    array<int> phaseBrokenSideSlots
    array<int> phaseFlipWaitSideSlots
    array<int> phaseDormantSideSlots

export type WinnerView
    int          candidateWinnerLogicalCount = 0
    int          candidateWinnerRootIdLength = 0
    array<int>   candidateWinnerSides
    array<int>   candidateWinnerStages
    array<int>   candidateWinnerEffectiveBottomTicks
    array<int>   candidateWinnerEffectiveTopTicks
    array<int>   candidateWinnerMinRootIds
    array<int>   candidateWinnerFvgModes
    array<int>   candidateWinnerPsychLevelTicks
    array<float> candidateWinnerExactPrices
    array<int>   candidateWinnerRootIdOffsets
    array<int>   candidateWinnerRootIdLengths
    array<int>   candidateWinnerRootIds

export type ComponentMetaView
    array<int>  rootCandComponentIds
    array<int>  candComponentIds
    array<int>  candComponentMemberOffsets
    array<int>  candComponentMemberLengths
    array<int>  candMemberRootIds
    array<int>  candMemberRoleFlags
    array<int>  candSemanticChangedRootIds
    array<int>  candSemanticChangedCurrentComponentIds
    array<bool> candChangedScopeFull

export type ShadowScalars
    int  nextCoreId        = 1
    int  nextGenerationId  = 1
    int  nextRootId        = 1
    int  coreRangeRevision = 0
    bool rangeChanged      = false

export type ShadowContext
    W08Store             ws
    RootView                     rv
    ParticipationView            pv
    PhaseSetView                 hv
    WinnerView                   wv
    ComponentMetaView            mv
    PendingTopologyStore ps
    PendingTopologyStore psPlan
    TouchPlan           tp
    SplitTouchPlan      sp
    ShadowScalars                sc
    float                        clusterMaxWidth = 0.0
    float                        mintick         = 0.0
    bool                         pendingPoolTrusted = false
    // W09 B07-R3B1: the projected-mark scratch of this bar (references, never copied; read by the two W08Touch plan builds):
    // Episode ints / floats and TouchStart plan ints / floats (W09State /22 layout; na when a caller does not set them)
    array<int>                   episodeInts
    array<float>                 episodeFloats
    array<int>                   touchStartPlanInts
    array<float>                 touchStartPlanFloats

// One shadow pass. planResult = the B14 changed component count (-1 plan fault). Per changed component applyComp (not
// pending); per physical Candidate applyP, mergeOfP (B08 relation of an applied Merge target) and splitOfP (B12
// SPLIT_LOCAL row of an applied target); consumed READY pending parents; the EXPLICIT_MERGE_ABSORBED free set (canonical,
// unique) with its expected IDs; counters of the plan, F0 and commit.
export type ShadowPass
    int         planResult        = -1
    int         pendingComponents = 0
    int         appliedComponents = 0
    int         appliedTargets    = 0
    int         retained          = 0
    int         guardRejected     = 0
    int         poolScans         = 0
    int         invRange          = 0
    int         invTick           = 0
    int         invOrigin         = 0
    int         invPass1          = 0
    int         invPair           = 0
    int         freshApplied      = 0
    int         touchRowsWritten  = 0
    int         freed             = 0
    bool        preflightOk       = false
    bool        committed         = false
    array<bool> applyComp
    array<bool> applyP
    array<int>  mergeOfP
    array<int>  splitOfP
    array<int>  consumedSlots
    array<int>  freeSlots
    array<int>  freeCoreIds
    array<int>  freeGenerationIds
    array<int>  dependencyChangedRootIds

participationEdgeResetRaw(ShadowContext ctx, int edgeIndex) =>
    array.set(ctx.pv.participationEdgeRootSlots,         edgeIndex, SLOT_INVALID)
    array.set(ctx.pv.participationEdgeExpectedRootIds,   edgeIndex, ID_NONE)
    array.set(ctx.pv.participationEdgeSideSlots,         edgeIndex, SLOT_INVALID)
    array.set(ctx.pv.participationEdgeExpectedCoreIds,   edgeIndex, ID_NONE)
    array.set(ctx.pv.participationEdgeNextByRootIndexes, edgeIndex, SLOT_INVALID)
    array.set(ctx.pv.participationEdgeLiveFlags,         edgeIndex, false)
participationEdgeAllocRaw(ShadowContext ctx) =>
    int edgeIndex = SLOT_INVALID
    if array.size(ctx.pv.participationEdgeFreeIndexes) > 0
        edgeIndex := array.pop(ctx.pv.participationEdgeFreeIndexes)
        participationEdgeResetRaw(ctx, edgeIndex)
    else
        edgeIndex := array.size(ctx.pv.participationEdgeRootSlots)
        array.push(ctx.pv.participationEdgeRootSlots,         SLOT_INVALID)
        array.push(ctx.pv.participationEdgeExpectedRootIds,   ID_NONE)
        array.push(ctx.pv.participationEdgeSideSlots,         SLOT_INVALID)
        array.push(ctx.pv.participationEdgeExpectedCoreIds,   ID_NONE)
        array.push(ctx.pv.participationEdgeNextByRootIndexes, SLOT_INVALID)
        array.push(ctx.pv.participationEdgeLiveFlags,         false)
    edgeIndex
participationEdgeFreeRaw(ShadowContext ctx, int edgeIndex) =>
    bool freed = false
    if edgeIndex >= 0 and edgeIndex < array.size(ctx.pv.participationEdgeLiveFlags)
        if array.get(ctx.pv.participationEdgeLiveFlags, edgeIndex)
            participationEdgeResetRaw(ctx, edgeIndex)
            array.push(ctx.pv.participationEdgeFreeIndexes, edgeIndex)
            freed := true
    freed
participationRootChainValidRaw(ShadowContext ctx, int rootSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool valid = false
    bool ok = rootSlot >= 0 and rootSlot < array.size(ctx.rv.rootIds) and rootSlot < array.size(ctx.rv.rootSlotLiveFlags) and rootSlot < array.size(ctx.rv.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(ctx.rv.rootParticipationCounts)
    if ok
        ok := array.get(ctx.rv.rootSlotLiveFlags, rootSlot) and array.get(ctx.rv.rootIds, rootSlot) != ID_NONE
    int edgeRowCount = array.size(ctx.pv.participationEdgeRootSlots)
    if ok
        ok := edgeRowCount == array.size(ctx.pv.participationEdgeExpectedRootIds) and edgeRowCount == array.size(ctx.pv.participationEdgeSideSlots) and edgeRowCount == array.size(ctx.pv.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(ctx.pv.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(ctx.pv.participationEdgeLiveFlags)
    if ok
        int rootId = array.get(ctx.rv.rootIds,                           rootSlot)
        int head   = array.get(ctx.rv.rootParticipationHeadEdgeIndexes,  rootSlot)
        int count  = array.get(ctx.rv.rootParticipationCounts,           rootSlot)
        if count < 0 or count > edgeRowCount
            ok := false
        if ok and count == 0
            valid := head == SLOT_INVALID
        if ok and count > 0
            bool chainOk   = head != SLOT_INVALID
            int  edgeIndex = head
            int  seen      = 0
            while chainOk and seen < count
                bool rowOk = edgeIndex >= 0 and edgeIndex < edgeRowCount
                if rowOk
                    rowOk := array.get(ctx.pv.participationEdgeLiveFlags, edgeIndex)
                if rowOk
                    rowOk := array.get(ctx.pv.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(ctx.pv.participationEdgeExpectedRootIds, edgeIndex) == rootId
                int edgeSideSlot = SLOT_INVALID
                int edgeCoreSlot = SLOT_INVALID
                if rowOk
                    edgeSideSlot := array.get(ctx.pv.participationEdgeSideSlots, edgeIndex)
                    rowOk := edgeSideSlot >= 0 and edgeSideSlot < array.size(cr.sidePhases)
                if rowOk
                    edgeCoreSlot := int(math.floor(edgeSideSlot / 2))
                    int edgeSideIndex = edgeSideSlot - edgeCoreSlot * 2
                    rowOk := (edgeSideIndex == 0 or edgeSideIndex == 1) and edgeCoreSlot >= 0 and edgeCoreSlot < array.size(cr.coreIds) and edgeCoreSlot < array.size(cr.coreSlotLiveFlags)
                if rowOk
                    rowOk := array.get(cr.coreSlotLiveFlags, edgeCoreSlot)
                if rowOk
                    int edgeExpectedCoreId = array.get(ctx.pv.participationEdgeExpectedCoreIds, edgeIndex)
                    rowOk := edgeExpectedCoreId != ID_NONE and array.get(cr.coreIds, edgeCoreSlot) == edgeExpectedCoreId
                if rowOk
                    edgeIndex := array.get(ctx.pv.participationEdgeNextByRootIndexes, edgeIndex)
                    seen      += 1
                else
                    chainOk := false
            if chainOk
                valid := seen == count and edgeIndex == SLOT_INVALID
    valid
participationDuplicateExistsRaw(ShadowContext ctx, int rootSlot, int expectedRootId, int sideSlot, int expectedCoreId) =>
    bool found = false
    int edgeRowCount = array.size(ctx.pv.participationEdgeRootSlots)
    if rootSlot >= 0 and rootSlot < array.size(ctx.rv.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(ctx.rv.rootParticipationCounts)
        int count     = array.get(ctx.rv.rootParticipationCounts,          rootSlot)
        int edgeIndex = array.get(ctx.rv.rootParticipationHeadEdgeIndexes, rootSlot)
        int seen      = 0
        while not found and seen < count and edgeIndex >= 0 and edgeIndex < edgeRowCount
            bool sameEdge = array.get(ctx.pv.participationEdgeLiveFlags, edgeIndex)
            if sameEdge
                sameEdge := array.get(ctx.pv.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(ctx.pv.participationEdgeExpectedRootIds, edgeIndex) == expectedRootId and array.get(ctx.pv.participationEdgeSideSlots, edgeIndex) == sideSlot and array.get(ctx.pv.participationEdgeExpectedCoreIds, edgeIndex) == expectedCoreId
            if sameEdge
                found := true
            else
                edgeIndex := array.get(ctx.pv.participationEdgeNextByRootIndexes, edgeIndex)
                seen      += 1
    found
// W08 B07-D: the Root-side and free-list predicates of participationAddRaw (shared with the materialization preflight)
participationRootAddableRaw(ShadowContext ctx, int rootSlot) =>
    bool rootOk = rootSlot >= 0 and rootSlot < array.size(ctx.rv.rootIds) and rootSlot < array.size(ctx.rv.rootSlotLiveFlags)
    if rootOk
        rootOk := array.get(ctx.rv.rootSlotLiveFlags, rootSlot)
    if rootOk
        rootOk := array.get(ctx.rv.rootIds, rootSlot) != ID_NONE
    rootOk and participationRootChainValidRaw(ctx, rootSlot)
participationEdgeFreeEntryOkRaw(ShadowContext ctx, int edgeIndex) =>
    edgeIndex >= 0 and edgeIndex < array.size(ctx.pv.participationEdgeRootSlots) and edgeIndex < array.size(ctx.pv.participationEdgeLiveFlags) and not array.get(ctx.pv.participationEdgeLiveFlags, edgeIndex)
participationAddRaw(ShadowContext ctx, int rootSlot, int sideSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool added = false
    bool rootOk         = participationRootAddableRaw(ctx, rootSlot)
    int  expectedRootId = ID_NONE
    if rootOk
        expectedRootId := array.get(ctx.rv.rootIds, rootSlot)
    bool sideOk         = rootOk and sideSlot >= 0 and sideSlot < array.size(cr.sidePhases)
    int  coreSlot       = SLOT_INVALID
    int  expectedCoreId = ID_NONE
    if sideOk
        coreSlot      := int(math.floor(sideSlot / 2))
        int sideIndex = sideSlot - coreSlot * 2
        sideOk        := (sideIndex == 0 or sideIndex == 1) and coreSlot >= 0 and coreSlot < array.size(cr.coreIds) and coreSlot < array.size(cr.coreSlotLiveFlags)
    if sideOk
        sideOk := array.get(cr.coreSlotLiveFlags, coreSlot)
    if sideOk
        expectedCoreId := array.get(cr.coreIds, coreSlot)
        sideOk         := expectedCoreId != ID_NONE
    bool ready = sideOk
    if ready
        ready := not participationDuplicateExistsRaw(ctx, rootSlot, expectedRootId, sideSlot, expectedCoreId)
    if ready
        int freeCount = array.size(ctx.pv.participationEdgeFreeIndexes)
        if freeCount > 0
            ready := participationEdgeFreeEntryOkRaw(ctx, array.get(ctx.pv.participationEdgeFreeIndexes, freeCount - 1))
    if ready
        int oldHead   = array.get(ctx.rv.rootParticipationHeadEdgeIndexes, rootSlot)
        int oldCount  = array.get(ctx.rv.rootParticipationCounts,          rootSlot)
        int edgeIndex = participationEdgeAllocRaw(ctx)
        array.set(ctx.pv.participationEdgeRootSlots,         edgeIndex, rootSlot)
        array.set(ctx.pv.participationEdgeExpectedRootIds,   edgeIndex, expectedRootId)
        array.set(ctx.pv.participationEdgeSideSlots,         edgeIndex, sideSlot)
        array.set(ctx.pv.participationEdgeExpectedCoreIds,   edgeIndex, expectedCoreId)
        array.set(ctx.pv.participationEdgeNextByRootIndexes, edgeIndex, oldHead)
        array.set(ctx.rv.rootParticipationHeadEdgeIndexes,   rootSlot,  edgeIndex)
        array.set(ctx.rv.rootParticipationCounts,            rootSlot,  oldCount + 1)
        array.set(ctx.pv.participationEdgeLiveFlags,         edgeIndex, true)
        added := true
    added
// W08 B07-D: read-only failure predicate of participationDetachAllForCoreRaw (shared with the materialization / free
// preflight): Core live, edge / root table sizes, every live Root chain valid, dead Roots empty, each live edge's slot and
// expected Core ID agree, chain total == live edge total. Returns [ready, expectedCoreId, targetEdgeCount].
participationDetachAllReadyRaw(ShadowContext ctx, int coreSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool coreOk         = coreSlot >= 0 and coreSlot < array.size(cr.coreIds) and coreSlot < array.size(cr.coreSlotLiveFlags)
    int  expectedCoreId = ID_NONE
    if coreOk
        coreOk := array.get(cr.coreSlotLiveFlags, coreSlot)
    if coreOk
        expectedCoreId := array.get(cr.coreIds, coreSlot)
        coreOk         := expectedCoreId != ID_NONE
    int  supportSideSlot    = coreSlot * 2
    int  resistanceSideSlot = coreSlot * 2 + 1
    bool ready = coreOk and supportSideSlot >= 0 and resistanceSideSlot < array.size(cr.sidePhases)
    int edgeRowCount = array.size(ctx.pv.participationEdgeRootSlots)
    if ready
        ready := edgeRowCount == array.size(ctx.pv.participationEdgeExpectedRootIds) and edgeRowCount == array.size(ctx.pv.participationEdgeSideSlots) and edgeRowCount == array.size(ctx.pv.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(ctx.pv.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(ctx.pv.participationEdgeLiveFlags)
    int rootRowCount = array.size(ctx.rv.rootIds)
    if ready
        ready := rootRowCount == array.size(ctx.rv.rootSlotLiveFlags) and rootRowCount == array.size(ctx.rv.rootParticipationHeadEdgeIndexes) and rootRowCount == array.size(ctx.rv.rootParticipationCounts)
    int chainEdgeCount = 0
    if ready
        int rootScan = 0
        while ready and rootScan < rootRowCount
            if array.get(ctx.rv.rootSlotLiveFlags, rootScan)
                if participationRootChainValidRaw(ctx, rootScan)
                    chainEdgeCount += array.get(ctx.rv.rootParticipationCounts, rootScan)
                else
                    ready := false
            else
                ready := array.get(ctx.rv.rootParticipationHeadEdgeIndexes, rootScan) == SLOT_INVALID and array.get(ctx.rv.rootParticipationCounts, rootScan) == 0
            rootScan += 1
    int liveEdgeCount   = 0
    int targetEdgeCount = 0
    if ready
        int edgeScan = 0
        while ready and edgeScan < edgeRowCount
            if array.get(ctx.pv.participationEdgeLiveFlags, edgeScan)
                liveEdgeCount += 1
                int scanSideSlot = array.get(ctx.pv.participationEdgeSideSlots, edgeScan)
                int scanCoreSlot = scanSideSlot >= 0 ? int(math.floor(scanSideSlot / 2)) : SLOT_INVALID
                bool slotMatch = scanCoreSlot == coreSlot
                bool idMatch   = array.get(ctx.pv.participationEdgeExpectedCoreIds, edgeScan) == expectedCoreId
                if slotMatch != idMatch
                    ready := false
                else if slotMatch
                    targetEdgeCount += 1
            edgeScan += 1
    if ready
        ready := chainEdgeCount == liveEdgeCount
    [ready, expectedCoreId, targetEdgeCount]
participationDetachAllForCoreRaw(ShadowContext ctx, int coreSlot) =>
    bool done = false
    [ready, expectedCoreId, targetEdgeCount] = participationDetachAllReadyRaw(ctx, coreSlot)
    int edgeRowCount = array.size(ctx.pv.participationEdgeRootSlots)
    int rootRowCount = array.size(ctx.rv.rootIds)
    if ready and targetEdgeCount == 0
        done := true
    bool commitReady = ready and targetEdgeCount > 0
    if commitReady
        int rootIdx = 0
        while rootIdx < rootRowCount
            if array.get(ctx.rv.rootSlotLiveFlags, rootIdx)
                int oldHead  = array.get(ctx.rv.rootParticipationHeadEdgeIndexes, rootIdx)
                int oldCount = array.get(ctx.rv.rootParticipationCounts,          rootIdx)
                int removeCount = 0
                int countIdx    = oldHead
                int counted     = 0
                while counted < oldCount
                    int countSideSlot = array.get(ctx.pv.participationEdgeSideSlots, countIdx)
                    int countCoreSlot = countSideSlot >= 0 ? int(math.floor(countSideSlot / 2)) : SLOT_INVALID
                    if countCoreSlot == coreSlot and array.get(ctx.pv.participationEdgeExpectedCoreIds, countIdx) == expectedCoreId
                        removeCount += 1
                    countIdx := array.get(ctx.pv.participationEdgeNextByRootIndexes, countIdx)
                    counted  += 1
                if removeCount > 0
                    int  newHead               = SLOT_INVALID
                    int  previousKeptEdgeIndex = SLOT_INVALID
                    int  keptCount             = 0
                    int  rebuildIdx            = oldHead
                    int  walked                = 0
                    while walked < oldCount
                        int  nextEdgeIndex   = array.get(ctx.pv.participationEdgeNextByRootIndexes, rebuildIdx)
                        int  rebuildSideSlot = array.get(ctx.pv.participationEdgeSideSlots, rebuildIdx)
                        int  rebuildCoreSlot = rebuildSideSlot >= 0 ? int(math.floor(rebuildSideSlot / 2)) : SLOT_INVALID
                        bool isTarget        = rebuildCoreSlot == coreSlot and array.get(ctx.pv.participationEdgeExpectedCoreIds, rebuildIdx) == expectedCoreId
                        if not isTarget
                            if newHead == SLOT_INVALID
                                newHead := rebuildIdx
                            if previousKeptEdgeIndex != SLOT_INVALID
                                array.set(ctx.pv.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, rebuildIdx)
                            previousKeptEdgeIndex := rebuildIdx
                            keptCount             += 1
                        rebuildIdx := nextEdgeIndex
                        walked     += 1
                    if previousKeptEdgeIndex != SLOT_INVALID
                        array.set(ctx.pv.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, SLOT_INVALID)
                    array.set(ctx.rv.rootParticipationHeadEdgeIndexes, rootIdx, newHead)
                    array.set(ctx.rv.rootParticipationCounts,          rootIdx, keptCount)
            rootIdx += 1
        int freeIdx = 0
        while freeIdx < edgeRowCount
            if array.get(ctx.pv.participationEdgeLiveFlags, freeIdx)
                int freeSideSlot = array.get(ctx.pv.participationEdgeSideSlots, freeIdx)
                int freeCoreSlot = freeSideSlot >= 0 ? int(math.floor(freeSideSlot / 2)) : SLOT_INVALID
                if freeCoreSlot == coreSlot and array.get(ctx.pv.participationEdgeExpectedCoreIds, freeIdx) == expectedCoreId
                    participationEdgeFreeRaw(ctx, freeIdx)
            freeIdx += 1
        done := true
    done
phaseSetMembershipValidRaw(ShadowContext ctx, int sideSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool valid = false
    if sideSlot >= 0 and sideSlot < array.size(cr.sidePhases) and sideSlot < array.size(cr.sidePhaseSetPositions)
        int phase = array.get(cr.sidePhases,            sideSlot)
        int pos   = array.get(cr.sidePhaseSetPositions, sideSlot)
        if pos >= 0
            if phase == PH_WAITING
                if pos < array.size(ctx.hv.phaseWaitingSideSlots)
                    valid := array.get(ctx.hv.phaseWaitingSideSlots, pos) == sideSlot
            else if phase == PH_ARMED
                if pos < array.size(ctx.hv.phaseArmedSideSlots)
                    valid := array.get(ctx.hv.phaseArmedSideSlots, pos) == sideSlot
            else if phase == PH_ACTIVE_TOUCH
                if pos < array.size(ctx.hv.phaseActiveTouchSideSlots)
                    valid := array.get(ctx.hv.phaseActiveTouchSideSlots, pos) == sideSlot
            else if phase == PH_BROKEN
                if pos < array.size(ctx.hv.phaseBrokenSideSlots)
                    valid := array.get(ctx.hv.phaseBrokenSideSlots, pos) == sideSlot
            else if phase == PH_FLIP_WAIT
                if pos < array.size(ctx.hv.phaseFlipWaitSideSlots)
                    valid := array.get(ctx.hv.phaseFlipWaitSideSlots, pos) == sideSlot
            else if phase == PH_DORMANT
                if pos < array.size(ctx.hv.phaseDormantSideSlots)
                    valid := array.get(ctx.hv.phaseDormantSideSlots, pos) == sideSlot
    valid
phaseSetAddRaw(ShadowContext ctx, int sideSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool added = false
    if sideSlot >= 0 and sideSlot < array.size(cr.sidePhases) and sideSlot < array.size(cr.sidePhaseSetPositions)
        int pos = array.get(cr.sidePhaseSetPositions, sideSlot)
        if pos == SLOT_INVALID
            int phase  = array.get(cr.sidePhases, sideSlot)
            int newPos = SLOT_INVALID
            if phase == PH_WAITING
                newPos := array.size(ctx.hv.phaseWaitingSideSlots)
                array.push(ctx.hv.phaseWaitingSideSlots, sideSlot)
            else if phase == PH_ARMED
                newPos := array.size(ctx.hv.phaseArmedSideSlots)
                array.push(ctx.hv.phaseArmedSideSlots, sideSlot)
            else if phase == PH_ACTIVE_TOUCH
                newPos := array.size(ctx.hv.phaseActiveTouchSideSlots)
                array.push(ctx.hv.phaseActiveTouchSideSlots, sideSlot)
            else if phase == PH_BROKEN
                newPos := array.size(ctx.hv.phaseBrokenSideSlots)
                array.push(ctx.hv.phaseBrokenSideSlots, sideSlot)
            else if phase == PH_FLIP_WAIT
                newPos := array.size(ctx.hv.phaseFlipWaitSideSlots)
                array.push(ctx.hv.phaseFlipWaitSideSlots, sideSlot)
            else if phase == PH_DORMANT
                newPos := array.size(ctx.hv.phaseDormantSideSlots)
                array.push(ctx.hv.phaseDormantSideSlots, sideSlot)
            if newPos != SLOT_INVALID
                array.set(cr.sidePhaseSetPositions, sideSlot, newPos)
                added := true
    added
phaseSetDetachRaw(ShadowContext ctx, int sideSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool detached = false
    if phaseSetMembershipValidRaw(ctx, sideSlot)
        int phase        = array.get(cr.sidePhases,            sideSlot)
        int pos          = array.get(cr.sidePhaseSetPositions, sideSlot)
        int lastPos      = SLOT_INVALID
        int lastSideSlot = SLOT_INVALID
        if phase == PH_WAITING
            lastPos      := array.size(ctx.hv.phaseWaitingSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseWaitingSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseWaitingSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseWaitingSideSlots)
        else if phase == PH_ARMED
            lastPos      := array.size(ctx.hv.phaseArmedSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseArmedSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseArmedSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseArmedSideSlots)
        else if phase == PH_ACTIVE_TOUCH
            lastPos      := array.size(ctx.hv.phaseActiveTouchSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseActiveTouchSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseActiveTouchSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseActiveTouchSideSlots)
        else if phase == PH_BROKEN
            lastPos      := array.size(ctx.hv.phaseBrokenSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseBrokenSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseBrokenSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseBrokenSideSlots)
        else if phase == PH_FLIP_WAIT
            lastPos      := array.size(ctx.hv.phaseFlipWaitSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseFlipWaitSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseFlipWaitSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseFlipWaitSideSlots)
        else if phase == PH_DORMANT
            lastPos      := array.size(ctx.hv.phaseDormantSideSlots) - 1
            lastSideSlot := array.get(ctx.hv.phaseDormantSideSlots, lastPos)
            if pos != lastPos
                array.set(ctx.hv.phaseDormantSideSlots, pos, lastSideSlot)
                array.set(cr.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(ctx.hv.phaseDormantSideSlots)
        array.set(cr.sidePhaseSetPositions, sideSlot, SLOT_INVALID)
        detached := true
    detached
// W08 B15-B2 (I27-12): the Merge-deferred Core / Side state fields (73: the 55 MERGE_DEFERRED_STATE_FIELDS and the 18
// Side re-evaluation fields without a W08 producer) at their coreResetSlotRaw defaults. write = true sets the defaults (the
// reset); write = false only compares (the MERGE_STATE_DEFAULT_GUARD of an absorbed Core). One table for both, so the
// guard can never drift from the reset. Returns true when every field already held its default.
// W09 B06-B1 (/5): the reset (write = true) keeps all 73 fields; the guard (write = false) checks 70. The Side current Root
// list metadata (sideCurrentRootHeadNodeIndexes / TailNodeIndexes / Counts) is reset-only: it has a producer (the W09 current
// Root list, complete replace from the applied Candidate's Side winner after commit) and the caller releases the list of
// every freed Core (nodes back to the free stack) before commitPass, so a non-empty list is not a guard violation.
// W09 B06-B2B1 (/6): the reset keeps 75 fields / 145 rows, the guard still checks 70 / 135. The Side categoryMask / highMask
// (sideCategoryMasks / sideHighMasks) are reset-only as well: they will get a producer (the applied Side winner masks),
// so a non-zero mask is a normal state of a live Core.
// W09 B06-B2B2 (/7): the 10 derived SideViewState fields (sideEffectiveBottoms / Tops, sideReferencePrices, sideCCounts /
// HCounts / Densities, sideBaseStrongFlags, sideHasNonPsychRootFlags, sideIsBroadContextFlags, sideEligibleFlags) are
// reset-only too: the W09 SideView producer writes them from the applied Side winner. Reset 75 / 145, guard 60 / 115.
// W09 B06-B2B3-B (/8): sideGrades / sideUpcomingTouchNos (derived) and sidePhases / sideArmedFromSeqs /
// sideLastArmedRangeBottoms / Tops (persistent; the W09 Merge / Split transfer baseline and Stage J write them) are
// reset-only as well. Reset 75 / 145, guard 54 / 103.
// W09 B06-B2C-B0 (/9): coreZoneFreshFlags / sideFreshFlags have their transfer (W09 new generation / Merge / Split
// Fresh) and are reset-only as well. Reset 75 / 145, guard 52 / 100.
// W09 B10 (/19): sideFlipAttemptCounts and sideLastFlipConfirmSeqs (the W09 Flip state transfer, F0-proven) are reset-only
// as well; sideInverseAttemptCounts and every other guard field unchanged.
// W09 B08-A (/18): the 14 BreakSnapshot fields (valid, coreId, generationId, oldSide, range bottom / top, breakSeq,
// breakTime, wasGapBreak, movedAway, retestSeen, Root list head / tail / count) have their transfer (W09 BreakSnapshot
// Merge / Split transfer, F0-proven) and are reset-only as well; no other guard field changes.
stateIntRaw(array<int> a, int i, int v, bool write) =>
    int  x    = array.get(a, i)
    bool same = na(v) ? na(x) : x == v
    if write
        array.set(a, i, v)
    same
stateFloatRaw(array<float> a, int i, float v, bool write) =>
    float x    = array.get(a, i)
    bool  same = na(v) ? na(x) : x == v
    if write
        array.set(a, i, v)
    same
stateBoolRaw(array<bool> a, int i, bool v, bool write) =>
    bool same = array.get(a, i) == v
    if write
        array.set(a, i, v)
    same
coreDeferredStateRaw(CoreRegistryStore cr, int coreSlot, bool write) =>
    bool same = true
    if write
        stateBoolRaw(cr.coreZoneFreshFlags, coreSlot, false, write)
    same := stateIntRaw(cr.coreLastSeenTimes, coreSlot, int(na), write) and same
    same := stateBoolRaw(cr.coreDormantFlags, coreSlot, false, write) and same
    same := stateIntRaw(cr.corePruneRevisions, coreSlot, 0, write) and same
    same := stateBoolRaw(cr.corePendingGenerationFlags, coreSlot, false, write) and same
    // both Side slots of the Core (coreSlot * 2 + 0 Support / + 1 Resistance): the same rows for each Side
    int k = 0
    while k < 2
        int s = coreSlot * 2 + k
        if write
            stateIntRaw(cr.sideTouchCounts, s, 0, write)
            stateBoolRaw(cr.sideWeakByTouchFlags, s, false, write)
            stateBoolRaw(cr.sideWeakByDepthFlags, s, false, write)
            stateFloatRaw(cr.sideMaxDepthPcts, s, 0.0, write)
            stateBoolRaw(cr.sideFreshFlags, s, false, write)
            stateIntRaw(cr.sidePhases, s, PH_WAITING, write)
            stateIntRaw(cr.sideGrades, s, GR_UNAVAILABLE, write)
            stateIntRaw(cr.sideCurrentTouchNos, s, 0, write)
            stateIntRaw(cr.sideUpcomingTouchNos, s, 0, write)
            stateIntRaw(cr.sideArmedFromSeqs, s, SEQ_UNSET, write)
            stateFloatRaw(cr.sideLastArmedRangeBottoms, s, float(na), write)
            stateFloatRaw(cr.sideLastArmedRangeTops, s, float(na), write)
            stateIntRaw(cr.sideLastNormalTouchTimes, s, int(na), write)
            stateFloatRaw(cr.sideEffectiveBottoms, s, float(na), write)
            stateFloatRaw(cr.sideEffectiveTops, s, float(na), write)
            stateFloatRaw(cr.sideReferencePrices, s, float(na), write)
            stateIntRaw(cr.sideCCounts, s, 0, write)
            stateIntRaw(cr.sideHCounts, s, 0, write)
            stateIntRaw(cr.sideDensities, s, int(na), write)
            stateBoolRaw(cr.sideBaseStrongFlags, s, false, write)
            stateBoolRaw(cr.sideHasNonPsychRootFlags, s, false, write)
            stateBoolRaw(cr.sideIsBroadContextFlags, s, false, write)
            stateBoolRaw(cr.sideEligibleFlags, s, false, write)
            stateBoolRaw(cr.sideTouchStartSnapshotValidFlags, s, false, write)
            stateIntRaw(cr.sideTouchStartSnapshotCoreIds, s, ID_NONE, write)
            stateIntRaw(cr.sideTouchStartSnapshotGenerationIds, s, ID_NONE, write)
            stateIntRaw(cr.sideTouchStartSnapshotSides, s, SIDE_NONE, write)
            stateFloatRaw(cr.sideTouchStartSnapshotRangeBottoms, s, float(na), write)
            stateFloatRaw(cr.sideTouchStartSnapshotRangeTops, s, float(na), write)
            stateIntRaw(cr.sideTouchStartSnapshotCategoryMasks, s, 0, write)
            stateIntRaw(cr.sideTouchStartSnapshotHighMasks, s, 0, write)
            stateIntRaw(cr.sideTouchStartSnapshotCCounts, s, 0, write)
            stateIntRaw(cr.sideTouchStartSnapshotHCounts, s, 0, write)
            stateIntRaw(cr.sideTouchStartSnapshotDensities, s, int(na), write)
            stateIntRaw(cr.sideTouchStartSnapshotGrades, s, GR_UNAVAILABLE, write)
            stateIntRaw(cr.sideTouchStartSnapshotCurrentTouchNos, s, 0, write)
            stateIntRaw(cr.sideTouchStartSnapshotApproachSides, s, SIDE_NONE, write)
            stateIntRaw(cr.sideTouchStartSnapshotStartSeqs, s, SEQ_UNSET, write)
            stateIntRaw(cr.sideTouchStartSnapshotStartTimes, s, int(na), write)
            stateFloatRaw(cr.sideTouchStartSnapshotDeepestCloses, s, float(na), write)
            stateFloatRaw(cr.sideTouchStartSnapshotMaxDepthPcts, s, 0.0, write)
            stateIntRaw(cr.sideTouchStartSnapshotRootHeadNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideTouchStartSnapshotRootTailNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideTouchStartSnapshotRootCounts, s, 0, write)
            stateIntRaw(cr.sideCurrentRootHeadNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideCurrentRootTailNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideCurrentRootCounts, s, 0, write)
            stateIntRaw(cr.sideCategoryMasks, s, 0, write)
            stateIntRaw(cr.sideHighMasks, s, 0, write)
        // W09 B10 (/19): sideFlipAttemptCounts / sideLastFlipConfirmSeqs are reset-only (the W09 Flip state transfer owns
        // them); sideInverseAttemptCounts stays guarded (B12)
        if write
            stateIntRaw(cr.sideFlipAttemptCounts, s, 0, write)
        same := stateIntRaw(cr.sideInverseAttemptCounts, s, 0, write) and same
        if write
            stateIntRaw(cr.sideLastFlipConfirmSeqs, s, SEQ_UNSET, write)
        // W09 B08-A (/18): the 14 BreakSnapshot fields are reset-only (the W09 BreakSnapshot transfer owns them)
        if write
            stateBoolRaw(cr.sideBreakSnapshotValidFlags, s, false, write)
            stateIntRaw(cr.sideBreakSnapshotCoreIds, s, ID_NONE, write)
            stateIntRaw(cr.sideBreakSnapshotGenerationIds, s, ID_NONE, write)
            stateIntRaw(cr.sideBreakSnapshotOldSides, s, SIDE_NONE, write)
            stateFloatRaw(cr.sideBreakSnapshotRangeBottoms, s, float(na), write)
            stateFloatRaw(cr.sideBreakSnapshotRangeTops, s, float(na), write)
            stateIntRaw(cr.sideBreakSnapshotBreakSeqs, s, SEQ_UNSET, write)
            stateIntRaw(cr.sideBreakSnapshotBreakTimes, s, int(na), write)
            stateBoolRaw(cr.sideBreakSnapshotWasGapBreakFlags, s, false, write)
            stateBoolRaw(cr.sideBreakSnapshotMovedAwayFlags, s, false, write)
            stateBoolRaw(cr.sideBreakSnapshotRetestSeenFlags, s, false, write)
            stateIntRaw(cr.sideBreakSnapshotRootHeadNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideBreakSnapshotRootTailNodeIndexes, s, SLOT_INVALID, write)
            stateIntRaw(cr.sideBreakSnapshotRootCounts, s, 0, write)
        same := stateIntRaw(cr.sideFvgDirectionMasks, s, FVG_MASK_NONE, write) and same
        same := stateIntRaw(cr.sideFvgRootCounts, s, 0, write) and same
        same := stateIntRaw(cr.sideFvgFreshCounts, s, 0, write) and same
        same := stateIntRaw(cr.sideFvgStructuralStateMasks, s, 0, write) and same
        k += 1
    same
coreResetSlotRaw(ShadowContext ctx, int coreSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    array.set(cr.coreIds,             coreSlot, ID_NONE)
    array.set(cr.coreGenerationIds,   coreSlot, ID_NONE)
    array.set(cr.corePhysicalBottoms, coreSlot, float(na))
    array.set(cr.corePhysicalTops,    coreSlot, float(na))
    array.set(cr.coreCreatedTimes,    coreSlot, int(na))
    array.set(cr.coreSlotLiveFlags, coreSlot, false)
    array.set(cr.touchMarkRingOwnerCoreIds, coreSlot, ID_NONE)
    array.set(cr.touchMarkRingHeads,        coreSlot, 0)
    array.set(cr.touchMarkRingCounts,       coreSlot, 0)
    int supportSideSlot    = coreSlot * 2
    int resistanceSideSlot = coreSlot * 2 + 1
    array.set(cr.sideTouchHistoryTruncatedFlags, supportSideSlot   , false)
    array.set(cr.sideTouchHistoryTruncatedFlags, resistanceSideSlot, false)
    array.set(cr.sidePhaseSetPositions, supportSideSlot,    SLOT_INVALID)
    array.set(cr.sidePhaseSetPositions, resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideArmedEffectiveBottomOrderPositions,  supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideArmedEffectiveTopOrderPositions,     supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideDormantRecoveryBottomOrderPositions, supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideDormantRecoveryTopOrderPositions,    supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideArmedEffectiveBottomOrderPositions,  resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideArmedEffectiveTopOrderPositions,     resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideDormantRecoveryBottomOrderPositions, resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideDormantRecoveryTopOrderPositions,    resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideBrokenSnapshotBottomOrderPositions, supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideBrokenSnapshotTopOrderPositions,    supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideFlipSnapshotBottomOrderPositions,   supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideFlipSnapshotTopOrderPositions,      supportSideSlot,    SLOT_INVALID)
    array.set(cr.sideBrokenSnapshotBottomOrderPositions, resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideBrokenSnapshotTopOrderPositions,    resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideFlipSnapshotBottomOrderPositions,   resistanceSideSlot, SLOT_INVALID)
    array.set(cr.sideFlipSnapshotTopOrderPositions,      resistanceSideSlot, SLOT_INVALID)
    array.set(cr.corePendingTopologyFlags,   coreSlot, false)
    array.set(cr.corePendingTopologyChildHeadIndexes, coreSlot, SLOT_INVALID)
    array.set(cr.corePendingTopologyChildTailIndexes, coreSlot, SLOT_INVALID)
    array.set(cr.corePendingTopologyChildCounts     , coreSlot, 0)
// W08 B07-D: one fresh Core on the next free slot (else an appended slot) with the caller-planned coreId / generationId /
// coreCreatedTime. No ID counter is touched here: the caller plans the IDs in fresh rank order and moves nextCoreId /
// nextGenerationId once, after the whole commit (IDs are never reused).
    coreDeferredStateRaw(cr, coreSlot, true)
// W08 B07-D: one fresh Core on the next free slot (else an appended slot) with the caller-planned coreId / generationId /
// coreCreatedTime. No ID counter is touched here: the caller plans the IDs in fresh rank order and moves nextCoreId /
// nextGenerationId once, after the whole commit (IDs are never reused).
coreAllocSlotRaw(ShadowContext ctx, int newCoreId, int newGenerationId, int createdTime) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    int coreSlot = SLOT_INVALID
    if array.size(cr.coreFreeSlots) > 0
        coreSlot := array.pop(cr.coreFreeSlots)
        coreResetSlotRaw(ctx, coreSlot)
    else
        coreSlot := array.size(cr.coreIds)
        array.push(cr.coreIds,             ID_NONE)
        array.push(cr.coreGenerationIds,   ID_NONE)
        array.push(cr.coreZoneFreshFlags,  false)
        array.push(cr.corePhysicalBottoms, float(na))
        array.push(cr.corePhysicalTops,    float(na))
        array.push(cr.coreCreatedTimes,    int(na))
        array.push(cr.coreLastSeenTimes,   int(na))
        array.push(cr.coreDormantFlags,    false)
        array.push(cr.coreSlotLiveFlags, false)
        array.push(cr.touchMarkRingOwnerCoreIds, ID_NONE)
        array.push(cr.touchMarkRingHeads,        0)
        array.push(cr.touchMarkRingCounts,       0)
        int touchCapacity = cr.touchMarkCapacityPerCore
        if touchCapacity > 0
            for touchOffset = 0 to touchCapacity - 1
                array.push(cr.touchMarkBaseSeqs,           SEQ_UNSET)
                array.push(cr.touchMarkTimes,              int(na))
                array.push(cr.touchMarkSides,              SIDE_NONE)
                array.push(cr.touchMarkContactBottoms,     float(na))
                array.push(cr.touchMarkContactTops,        float(na))
                array.push(cr.touchMarkCloseAtTouches,     float(na))
                array.push(cr.touchMarkGenerationIds,      ID_NONE)
                array.push(cr.touchMarkIsNormalTouchFlags, false)
                array.push(cr.touchMarkTouchNos,           0)
                array.push(cr.touchMarkWeakByDepthFlags,   false)
                array.push(cr.touchMarkMaxDepthPcts,       0.0)
        // Support (sideIndex 0) then Resistance (1): each Side row array gets its default twice, in slot order
        for sideIndex = 0 to 1
            array.push(cr.sideTouchCounts,           0)
            array.push(cr.sideWeakByTouchFlags,      false)
            array.push(cr.sideWeakByDepthFlags,      false)
            array.push(cr.sideMaxDepthPcts,          0.0)
            array.push(cr.sideFreshFlags,            false)
            array.push(cr.sidePhases,                PH_WAITING)
            array.push(cr.sideGrades,                GR_UNAVAILABLE)
            array.push(cr.sideCurrentTouchNos,       0)
            array.push(cr.sideUpcomingTouchNos,      0)
            array.push(cr.sideArmedFromSeqs,         SEQ_UNSET)
            array.push(cr.sideLastArmedRangeBottoms, float(na))
            array.push(cr.sideLastArmedRangeTops,    float(na))
            array.push(cr.sideLastNormalTouchTimes,  int(na))
            array.push(cr.sideFlipAttemptCounts,     0)
            array.push(cr.sideInverseAttemptCounts,  0)
            array.push(cr.sideLastFlipConfirmSeqs,   SEQ_UNSET)
            array.push(cr.sideEffectiveBottoms,      float(na))
            array.push(cr.sideEffectiveTops,         float(na))
            array.push(cr.sideReferencePrices,       float(na))
            array.push(cr.sideCCounts,               0)
            array.push(cr.sideHCounts,               0)
            array.push(cr.sideDensities,             int(na))
            array.push(cr.sideBaseStrongFlags,       false)
            array.push(cr.sideHasNonPsychRootFlags,  false)
            array.push(cr.sideIsBroadContextFlags,   false)
            array.push(cr.sideEligibleFlags,         false)
            array.push(cr.sideCategoryMasks,         0)
            array.push(cr.sideHighMasks,             0)
            array.push(cr.sidePhaseSetPositions, SLOT_INVALID)
            array.push(cr.sideTouchHistoryTruncatedFlags, false)
            array.push(cr.sideTouchStartSnapshotValidFlags,      false)
            array.push(cr.sideTouchStartSnapshotCoreIds,         ID_NONE)
            array.push(cr.sideTouchStartSnapshotGenerationIds,   ID_NONE)
            array.push(cr.sideTouchStartSnapshotSides,           SIDE_NONE)
            array.push(cr.sideTouchStartSnapshotRangeBottoms,    float(na))
            array.push(cr.sideTouchStartSnapshotRangeTops,       float(na))
            array.push(cr.sideTouchStartSnapshotCategoryMasks,   0)
            array.push(cr.sideTouchStartSnapshotHighMasks,       0)
            array.push(cr.sideTouchStartSnapshotCCounts,         0)
            array.push(cr.sideTouchStartSnapshotHCounts,         0)
            array.push(cr.sideTouchStartSnapshotDensities,       int(na))
            array.push(cr.sideTouchStartSnapshotGrades,          GR_UNAVAILABLE)
            array.push(cr.sideTouchStartSnapshotCurrentTouchNos, 0)
            array.push(cr.sideTouchStartSnapshotApproachSides,   SIDE_NONE)
            array.push(cr.sideTouchStartSnapshotStartSeqs,       SEQ_UNSET)
            array.push(cr.sideTouchStartSnapshotStartTimes,      int(na))
            array.push(cr.sideTouchStartSnapshotDeepestCloses,   float(na))
            array.push(cr.sideTouchStartSnapshotMaxDepthPcts,    0.0)
            array.push(cr.sideTouchStartSnapshotRootHeadNodeIndexes, SLOT_INVALID)
            array.push(cr.sideTouchStartSnapshotRootTailNodeIndexes, SLOT_INVALID)
            array.push(cr.sideTouchStartSnapshotRootCounts,          0)
            array.push(cr.sideBreakSnapshotValidFlags,       false)
            array.push(cr.sideBreakSnapshotCoreIds,          ID_NONE)
            array.push(cr.sideBreakSnapshotGenerationIds,    ID_NONE)
            array.push(cr.sideBreakSnapshotOldSides,         SIDE_NONE)
            array.push(cr.sideBreakSnapshotRangeBottoms,     float(na))
            array.push(cr.sideBreakSnapshotRangeTops,        float(na))
            array.push(cr.sideBreakSnapshotBreakSeqs,        SEQ_UNSET)
            array.push(cr.sideBreakSnapshotBreakTimes,       int(na))
            array.push(cr.sideBreakSnapshotWasGapBreakFlags, false)
            array.push(cr.sideBreakSnapshotMovedAwayFlags,   false)
            array.push(cr.sideBreakSnapshotRetestSeenFlags,  false)
            array.push(cr.sideBreakSnapshotRootHeadNodeIndexes, SLOT_INVALID)
            array.push(cr.sideBreakSnapshotRootTailNodeIndexes, SLOT_INVALID)
            array.push(cr.sideBreakSnapshotRootCounts         , 0)
            array.push(cr.sideCurrentRootHeadNodeIndexes, SLOT_INVALID)
            array.push(cr.sideCurrentRootTailNodeIndexes, SLOT_INVALID)
            array.push(cr.sideCurrentRootCounts         , 0)
            array.push(cr.sideFvgDirectionMasks      , FVG_MASK_NONE)
            array.push(cr.sideFvgRootCounts          , 0)
            array.push(cr.sideFvgFreshCounts         , 0)
            array.push(cr.sideFvgStructuralStateMasks, 0)
            array.push(cr.sideArmedEffectiveBottomOrderPositions,  SLOT_INVALID)
            array.push(cr.sideArmedEffectiveTopOrderPositions,     SLOT_INVALID)
            array.push(cr.sideDormantRecoveryBottomOrderPositions, SLOT_INVALID)
            array.push(cr.sideDormantRecoveryTopOrderPositions,    SLOT_INVALID)
            array.push(cr.sideBrokenSnapshotBottomOrderPositions, SLOT_INVALID)
            array.push(cr.sideBrokenSnapshotTopOrderPositions,    SLOT_INVALID)
            array.push(cr.sideFlipSnapshotBottomOrderPositions,   SLOT_INVALID)
            array.push(cr.sideFlipSnapshotTopOrderPositions,      SLOT_INVALID)
        array.push(cr.corePruneRevisions, 0)
        array.push(cr.corePendingTopologyFlags,   false)
        array.push(cr.corePendingGenerationFlags, false)
        array.push(cr.corePendingTopologyChildHeadIndexes, SLOT_INVALID)
        array.push(cr.corePendingTopologyChildTailIndexes, SLOT_INVALID)
        array.push(cr.corePendingTopologyChildCounts     , 0)
    array.set(cr.coreIds,           coreSlot, newCoreId)
    array.set(cr.coreGenerationIds, coreSlot, newGenerationId)
    array.set(cr.coreCreatedTimes,  coreSlot, createdTime)
    array.set(cr.coreSlotLiveFlags, coreSlot, true)
    array.set(cr.touchMarkRingOwnerCoreIds, coreSlot, newCoreId)
    array.set(cr.touchMarkRingHeads,        coreSlot, 0)
    array.set(cr.touchMarkRingCounts,       coreSlot, 0)
    phaseSetAddRaw(ctx, coreSlot * 2)
    phaseSetAddRaw(ctx, coreSlot * 2 + 1)
    map.put(cr.coreIdToSlot, newCoreId, coreSlot)
    array.push(cr.coreLiveSlots, coreSlot)
    array.push(cr.coreIdOrderSlots, coreSlot)
    coreSlot
// W08 B15-B2: the pending pool of the chain = the pass scratch copy (ctx.psPlan, made by planPass); the real pool
// (ctx.ps) is written only by commitPass.
pendingStoreViewRaw(ShadowContext ctx) =>
    ctx.psPlan
// W08 B01: the Core origin Root membership (rootId ASC chain per physical Core) and the W08 topology revision are
// owned by W08Core (Worker /2, engine.w08CoreStore: originAdd / originRemove / originReadAsc, topologyRevision).
// W08 B02: the Core identity interval index is owned by W08Core (Worker /1, engine.w08CoreStore); callers use
// intervalInsert / intervalDetach / intervalMove directly. Main keeps the Core state, the physical float range
// (corePhysicalBottoms / Tops) and coreRangeRevision: after intervalMove returns changed = true the caller writes the new
// physical range and bumps coreRangeRevision, also when the float range changes but its ticks do not.
// W08 B04-C: indexed Identity candidate gather for one Candidate winner (record index, not a comparator order). Old
// physical Cores are discovered through the Root -> participation chain of every Candidate Root, the W08Core interval
// index (interval gap <= M on ticks, mTick = int(math.round(clusterMaxWidth / mintick)) as W05 / W06) and the W08Core
// inverse-origin index of every FVG Root of the Candidate (no state / direction / Broad filter), each hit guarded by the
// current registry (GUARD_03 / 01 / 02: live slot and coreIds[slot] == the stored expected Core ID; a stale hit is skipped),
// then united in the W08Core gather scratch by coreId. Writes [coreSlot, coreId] (stride 2, coreId ASC) and returns the
// count; a structural fault (winner slice, Root registry, participation chain, Worker call) returns -1 with an empty
// outPairs. Candidate discovery only: no Identity decision. outPairs doubles as the collect scratch.
identityGatherForCandidateRaw(ShadowContext ctx, int candidateWinnerIndex, array<int> outPairs) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    WinnerView w3 = ctx.wv
    W08Store   ws = ctx.ws
    identityGatherReset(ws)
    array.clear(outPairs)
    int  coreCount = array.size(cr.coreIds)
    int  rootRows  = array.size(ctx.rv.rootIds)
    int  edgeRows  = array.size(ctx.pv.participationEdgeRootSlots)
    bool ok = candidateWinnerIndex >= 0 and candidateWinnerIndex < w3.candidateWinnerLogicalCount and candidateWinnerIndex < array.size(w3.candidateWinnerRootIdOffsets) and candidateWinnerIndex < array.size(w3.candidateWinnerRootIdLengths) and candidateWinnerIndex < array.size(w3.candidateWinnerEffectiveBottomTicks) and candidateWinnerIndex < array.size(w3.candidateWinnerEffectiveTopTicks) and ctx.mintick > 0 and array.size(cr.coreSlotLiveFlags) == coreCount and array.size(ctx.rv.rootSlotLiveFlags) == rootRows and array.size(ctx.rv.rootCategories) == rootRows and array.size(ctx.rv.rootParticipationHeadEdgeIndexes) == rootRows and array.size(ctx.rv.rootParticipationCounts) == rootRows and array.size(ctx.pv.participationEdgeExpectedRootIds) == edgeRows and array.size(ctx.pv.participationEdgeSideSlots) == edgeRows and array.size(ctx.pv.participationEdgeExpectedCoreIds) == edgeRows and array.size(ctx.pv.participationEdgeNextByRootIndexes) == edgeRows and array.size(ctx.pv.participationEdgeLiveFlags) == edgeRows
    int rootStart = 0
    int rootLen   = 0
    if ok
        rootStart := array.get(w3.candidateWinnerRootIdOffsets, candidateWinnerIndex)
        rootLen   := array.get(w3.candidateWinnerRootIdLengths, candidateWinnerIndex)
        ok := rootStart >= 0 and rootLen >= 0 and rootStart + rootLen <= w3.candidateWinnerRootIdLength and rootStart + rootLen <= array.size(w3.candidateWinnerRootIds)
    // PATH 1: Root -> participating Core (GUARD_03)
    int r = 0
    while ok and r < rootLen
        int rootId   = array.get(w3.candidateWinnerRootIds, rootStart + r)
        int rootSlot = map.contains(ctx.rv.rootIdToSlot, rootId) ? map.get(ctx.rv.rootIdToSlot, rootId) : SLOT_INVALID
        ok := rootSlot >= 0 and rootSlot < rootRows
        if ok
            ok := array.get(ctx.rv.rootSlotLiveFlags, rootSlot) and array.get(ctx.rv.rootIds, rootSlot) == rootId
        int count = 0
        int edge  = SLOT_INVALID
        int seen  = 0
        if ok
            count := array.get(ctx.rv.rootParticipationCounts, rootSlot)
            edge  := array.get(ctx.rv.rootParticipationHeadEdgeIndexes, rootSlot)
            ok    := count >= 0
        while ok and seen < count
            ok := edge >= 0 and edge < edgeRows
            if ok
                ok := array.get(ctx.pv.participationEdgeLiveFlags, edge) and array.get(ctx.pv.participationEdgeRootSlots, edge) == rootSlot and array.get(ctx.pv.participationEdgeExpectedRootIds, edge) == rootId
            if ok
                int sideSlot = array.get(ctx.pv.participationEdgeSideSlots, edge)
                int coreSlot = int(math.floor(sideSlot / 2))
                ok := sideSlot >= 0 and coreSlot < coreCount
                if ok and array.get(cr.coreSlotLiveFlags, coreSlot) and array.get(cr.coreIds, coreSlot) == array.get(ctx.pv.participationEdgeExpectedCoreIds, edge)
                    [rootOfferOk, rootOfferChanged] = identityGatherOffer(ws, coreSlot, array.get(cr.coreIds, coreSlot))
                    ok := rootOfferOk
                edge := array.get(ctx.pv.participationEdgeNextByRootIndexes, edge)
                seen += 1
        ok := ok and edge == SLOT_INVALID
        r += 1
    // PATH 2: interval gap <= M (GUARD_01)
    if ok
        int mTick = int(math.round(ctx.clusterMaxWidth / ctx.mintick))
        int n     = intervalCollect(ws, array.get(w3.candidateWinnerEffectiveBottomTicks, candidateWinnerIndex), array.get(w3.candidateWinnerEffectiveTopTicks, candidateWinnerIndex), mTick, outPairs)
        ok := n >= 0 and array.size(outPairs) == n * 2
        int i = 0
        while ok and i < n * 2
            int coreSlot = array.get(outPairs, i)
            ok := coreSlot >= 0 and coreSlot < coreCount
            if ok and array.get(cr.coreSlotLiveFlags, coreSlot) and array.get(cr.coreIds, coreSlot) == array.get(outPairs, i + 1)
                [intervalOfferOk, intervalOfferChanged] = identityGatherOffer(ws, coreSlot, array.get(cr.coreIds, coreSlot))
                ok := intervalOfferOk
            i += 2
        array.clear(outPairs)
    // PATH 3: inverse-origin of every FVG Root of the Candidate (GUARD_02)
    r := 0
    while ok and r < rootLen
        int rootId   = array.get(w3.candidateWinnerRootIds, rootStart + r)
        int rootSlot = map.get(ctx.rv.rootIdToSlot, rootId)
        if array.get(ctx.rv.rootCategories, rootSlot) == CAT_FVG
            int n = inverseOriginCollect(ws, rootId, outPairs)
            ok := n >= 0 and array.size(outPairs) == n * 2
            int i = 0
            while ok and i < n * 2
                int coreSlot = array.get(outPairs, i)
                ok := coreSlot >= 0 and coreSlot < coreCount
                if ok and array.get(cr.coreSlotLiveFlags, coreSlot) and array.get(cr.coreIds, coreSlot) == array.get(outPairs, i + 1)
                    [inverseOfferOk, inverseOfferChanged] = identityGatherOffer(ws, coreSlot, array.get(cr.coreIds, coreSlot))
                    ok := inverseOfferOk
                i += 2
            array.clear(outPairs)
        r += 1
    int result = -1
    array.clear(outPairs)
    if ok
        result := identityGatherReadAsc(ws, outPairs)
    result
// W08 B05: exact Identity predicate for one old physical Core x one Candidate winner (A17.1), read-only. matched = both
// (A) a shared origin Root ID that is not a Broad FVG (two-pointer walk of the old Core's full origin set from W08Core
// originReadAsc and the Candidate's rootId ASC Root slice; a shared Broad FVG alone never counts, Broad Roots stay stored)
// and (B) interval gap <= M on ticks (old range = corePhysicalBottoms / Tops rounded only here, Candidate = its effective
// ticks, gap = max(0, candidateBottom - oldTop, oldBottom - candidateTop), mTick as W05 / W06 / B04, equality included).
// No centre / reference / median distance, no source, side, state, direction, generation or comparator term. Returns
// [ok, matched]: ok = false on a structural fault (winner slice, old Core not live / not expectedOldCoreId, range, Worker
// origin read, shared Root registry, mintick / M), else matched. Cannot pick among several matched Cores (B07).
// W08 B07-B: the B05 predicate on any rootId ASC Root slice (rootIds[rootStart .. rootStart + rootLen)) with its
// effective ticks [candBottomTick, candTopTick]: the Candidate winner (identityExactMatchRaw) and the physical Candidate
// (buildPhysicalIdentityPlanRaw) share this one body, semantics unchanged.
identityExactSliceRaw(ShadowContext ctx, array<int> rootIds, int rootStart, int rootLen, int candBottomTick, int candTopTick, int oldCoreSlot, int expectedOldCoreId) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool ok = ctx.mintick > 0 and ctx.clusterMaxWidth >= 0 and expectedOldCoreId >= 1 and oldCoreSlot >= 0 and oldCoreSlot < array.size(cr.coreIds) and oldCoreSlot < array.size(cr.coreSlotLiveFlags) and oldCoreSlot < array.size(cr.corePhysicalBottoms) and oldCoreSlot < array.size(cr.corePhysicalTops) and rootStart >= 0 and rootLen >= 0 and rootStart + rootLen <= array.size(rootIds)
    if ok
        ok := array.get(cr.coreSlotLiveFlags, oldCoreSlot) and array.get(cr.coreIds, oldCoreSlot) == expectedOldCoreId
    bool rangeMatched = false
    if ok
        float oldBottom = array.get(cr.corePhysicalBottoms, oldCoreSlot)
        float oldTop    = array.get(cr.corePhysicalTops,    oldCoreSlot)
        int   oldBottomTick = int(math.round(oldBottom / ctx.mintick))
        int   oldTopTick    = int(math.round(oldTop    / ctx.mintick))
        ok := oldBottomTick <= oldTopTick and candBottomTick <= candTopTick
        if ok
            int mTick = int(math.round(ctx.clusterMaxWidth / ctx.mintick))
            rangeMatched := math.max(0, candBottomTick - oldTopTick, oldBottomTick - candTopTick) <= mTick
    bool originMatched = false
    if ok
        array<int> oldRoots = array.new_int(0)
        int oldCount = originReadAsc(ctx.ws, oldCoreSlot, expectedOldCoreId, oldRoots)
        ok := oldCount >= 0 and oldCount == array.size(oldRoots)
        int a = 0
        int b = 0
        while ok and not originMatched and a < oldCount and b < rootLen
            int oldRootId  = array.get(oldRoots, a)
            int candRootId = array.get(rootIds, rootStart + b)
            if oldRootId < candRootId
                a += 1
            else if oldRootId > candRootId
                b += 1
            else
                int rootSlot = map.contains(ctx.rv.rootIdToSlot, oldRootId) ? map.get(ctx.rv.rootIdToSlot, oldRootId) : SLOT_INVALID
                ok := rootSlot >= 0 and rootSlot < array.size(ctx.rv.rootIds) and rootSlot < array.size(ctx.rv.rootSlotLiveFlags) and rootSlot < array.size(ctx.rv.rootCategories) and rootSlot < array.size(ctx.rv.rootIsBroadFvgFlags)
                if ok
                    ok := array.get(ctx.rv.rootSlotLiveFlags, rootSlot) and array.get(ctx.rv.rootIds, rootSlot) == oldRootId
                if ok
                    originMatched := not (array.get(ctx.rv.rootCategories, rootSlot) == CAT_FVG and array.get(ctx.rv.rootIsBroadFvgFlags, rootSlot))
                a += 1
                b += 1
    [ok, ok and originMatched and rangeMatched]
// W08 B06-B: Side Candidate -> physical Core pairing of the current pass (A10.7 / I15.1 PATH A), read-only on the Engine.
// Every winner (record index, Side 1 / -1) goes into the W08Core pairing indexes; pairingCollectPairs gives the
// Support x Resistance pairs with interval gap <= M (mTick as W05 / W06 / B04 / B05) in (supportIndex, resistanceIndex)
// ASC order; each pair is kept only when the tick ranges re-check gap <= M and the two rootId ASC Root slices share at
// least one non-FVG Root (two-pointer; normal, Broad and Inverse FVG never count). PATH B (the same FVG origin before /
// after Inverse) cannot occur inside one pass: W05 makes an FVG Root eligible for one Side only, so a shared FVG Root
// between a Support and a Resistance winner breaks that invariant and fails the whole call. Writes the kept pairs
// (stride 2, order kept by in-place forward compaction) and returns their count; -1 with an empty outPairs on any
// structural or invariant fault. No Core allocation, no Identity, no runtime call site yet.
pairCurrentCandidatesRaw(ShadowContext ctx, array<int> outPairs) =>
    WinnerView w3 = ctx.wv
    W08Store   ws = ctx.ws
    pairingReset(ws)
    array.clear(outPairs)
    int  count       = w3.candidateWinnerLogicalCount
    int  rootBacking = w3.candidateWinnerRootIdLength
    bool ok = count >= 0 and count <= array.size(w3.candidateWinnerSides) and count <= array.size(w3.candidateWinnerEffectiveBottomTicks) and count <= array.size(w3.candidateWinnerEffectiveTopTicks) and count <= array.size(w3.candidateWinnerRootIdOffsets) and count <= array.size(w3.candidateWinnerRootIdLengths) and rootBacking >= 0 and rootBacking <= array.size(w3.candidateWinnerRootIds) and ctx.mintick > 0 and ctx.clusterMaxWidth >= 0
    int i = 0
    while ok and i < count
        int side = array.get(w3.candidateWinnerSides, i)
        int bot  = array.get(w3.candidateWinnerEffectiveBottomTicks, i)
        int top  = array.get(w3.candidateWinnerEffectiveTopTicks, i)
        int off  = array.get(w3.candidateWinnerRootIdOffsets, i)
        int len  = array.get(w3.candidateWinnerRootIdLengths, i)
        ok := (side == SIDE_SUPPORT or side == SIDE_RESISTANCE) and bot <= top and off >= 0 and len >= 0 and off + len <= rootBacking
        if ok
            [addOk, addChanged] = pairingAddCandidate(ws, side, i, bot, top)
            ok := addOk
        i += 1
    int mTick = 0
    int n     = 0
    if ok
        mTick := int(math.round(ctx.clusterMaxWidth / ctx.mintick))
        n     := pairingCollectPairs(ws, mTick, outPairs)
        ok    := n >= 0 and array.size(outPairs) == n * 2
    int w = 0
    int p = 0
    while ok and p < n * 2
        int sIdx = array.get(outPairs, p)
        int rIdx = array.get(outPairs, p + 1)
        ok := sIdx >= 0 and sIdx < count and rIdx >= 0 and rIdx < count
        if ok
            ok := array.get(w3.candidateWinnerSides, sIdx) == SIDE_SUPPORT and array.get(w3.candidateWinnerSides, rIdx) == SIDE_RESISTANCE
        bool sharedNonFvg = false
        if ok
            int sOff = array.get(w3.candidateWinnerRootIdOffsets, sIdx)
            int sEnd = sOff + array.get(w3.candidateWinnerRootIdLengths, sIdx)
            int rOff = array.get(w3.candidateWinnerRootIdOffsets, rIdx)
            int rEnd = rOff + array.get(w3.candidateWinnerRootIdLengths, rIdx)
            while ok and sOff < sEnd and rOff < rEnd
                int sRootId = array.get(w3.candidateWinnerRootIds, sOff)
                int rRootId = array.get(w3.candidateWinnerRootIds, rOff)
                if sRootId < rRootId
                    sOff += 1
                else if sRootId > rRootId
                    rOff += 1
                else
                    int rootSlot = map.contains(ctx.rv.rootIdToSlot, sRootId) ? map.get(ctx.rv.rootIdToSlot, sRootId) : SLOT_INVALID
                    ok := rootSlot >= 0 and rootSlot < array.size(ctx.rv.rootIds) and rootSlot < array.size(ctx.rv.rootSlotLiveFlags) and rootSlot < array.size(ctx.rv.rootCategories)
                    if ok
                        ok := array.get(ctx.rv.rootSlotLiveFlags, rootSlot) and array.get(ctx.rv.rootIds, rootSlot) == sRootId
                    if ok
                        ok := array.get(ctx.rv.rootCategories, rootSlot) != CAT_FVG
                        sharedNonFvg := true
                    sOff += 1
                    rOff += 1
        if ok and sharedNonFvg
            int sBot = array.get(w3.candidateWinnerEffectiveBottomTicks, sIdx)
            int sTop = array.get(w3.candidateWinnerEffectiveTopTicks,    sIdx)
            int rBot = array.get(w3.candidateWinnerEffectiveBottomTicks, rIdx)
            int rTop = array.get(w3.candidateWinnerEffectiveTopTicks,    rIdx)
            if rBot <= sTop + mTick and rTop >= sBot - mTick
                array.set(outPairs, w,     sIdx)
                array.set(outPairs, w + 1, rIdx)
                w += 2
        p += 2
    int result = -1
    if ok
        while array.size(outPairs) > w
            array.pop(outPairs)
        result := int(w / 2)
    else
        array.clear(outPairs)
    result
// W08 B07-A3: physical Candidates of the current pass into the W08Core physical storage: B06-B exact pairs ->
// W08Core canonical maximum matching -> physicalBuild (every winner exactly once, Root union, tick / exact float
// envelope). Returns the physical Candidate count; -1 with empty physical storage (a failed step passes count -1 on).
// No Core allocation, no Identity, no runtime call site yet.
buildPhysicalCandidatesRaw(ShadowContext ctx) =>
    WinnerView w3 = ctx.wv
    array<int> eligiblePairs = array.new_int(0)
    array<int> matchedPairs  = array.new_int(0)
    int k = pairCurrentCandidatesRaw(ctx, eligiblePairs)
    if k >= 0
        k := pairingSelectCanonicalMatching(ctx.ws, eligiblePairs, matchedPairs)
    physicalBuild(ctx.ws, k >= 0 ? w3.candidateWinnerLogicalCount : -1, w3.candidateWinnerSides, w3.candidateWinnerEffectiveBottomTicks, w3.candidateWinnerEffectiveTopTicks, w3.candidateWinnerExactPrices, w3.candidateWinnerMinRootIds, w3.candidateWinnerRootIdOffsets, w3.candidateWinnerRootIdLengths, w3.candidateWinnerRootIds, w3.candidateWinnerRootIdLength, matchedPairs, ctx.mintick)
// W08 B07-B: physical Identity plan of the current pass. Per physical Candidate: old Core candidates = union of the
// B04 gather of each constituent winner and the W08Core interval hits of the physical envelope (live and coreIds[slot]
// == stored ID), united by coreId in the W08Core gather scratch (a coreId on two slots fails); each is kept when the B05
// predicate holds on the physical Root union and envelope ticks (a live matched Core with na coreCreatedTime fails).
// identityPlanBuild stores every edge and the canonical continuation matching. Returns the match count; -1 with
// an empty plan. No Core allocation, no ID inheritance, no runtime call site yet.
buildPhysicalIdentityPlanRaw(ShadowContext ctx) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    W08Store ws = ctx.ws
    int  n     = buildPhysicalCandidatesRaw(ctx)
    bool ok    = n >= 0
    int  mTick = ok ? int(math.round(ctx.clusterMaxWidth / ctx.mintick)) : 0
    array<int> rawEdges = array.new_int(0)
    array<int> cand     = array.new_int(0)
    array<int> hits     = array.new_int(0)
    int p = 0
    while ok and p < n
        array.clear(cand)
        int side = 0
        while ok and side < 2
            int w = side == 0 ? array.get(ws.physicalCandidateSupportWinnerIndexes, p) : array.get(ws.physicalCandidateResistanceWinnerIndexes, p)
            if w >= 0
                ok := identityGatherForCandidateRaw(ctx, w, hits) >= 0
                int j = 0
                while ok and j < array.size(hits)
                    array.push(cand, array.get(hits, j))
                    j += 1
            side += 1
        int bt = array.get(ws.physicalCandidateBottomTicks, p)
        int tt = array.get(ws.physicalCandidateTopTicks, p)
        if ok
            ok := intervalCollect(ws, bt, tt, mTick, hits) >= 0
        int i = 0
        while ok and i < array.size(hits)
            int slot = array.get(hits, i)
            if slot >= 0 and slot < array.size(cr.coreIds) and slot < array.size(cr.coreSlotLiveFlags)
                if array.get(cr.coreSlotLiveFlags, slot) and array.get(cr.coreIds, slot) == array.get(hits, i + 1)
                    array.push(cand, slot)
                    array.push(cand, array.get(hits, i + 1))
            i += 2
        identityGatherReset(ws)
        i := 0
        while ok and i < array.size(cand)
            [offerOk, offerChanged] = identityGatherOffer(ws, array.get(cand, i), array.get(cand, i + 1))
            ok := offerOk
            i += 2
        if ok
            ok := identityGatherReadAsc(ws, hits) >= 0
        i := 0
        while ok and i < array.size(hits)
            int slot = array.get(hits, i)
            int id   = array.get(hits, i + 1)
            [xOk, matched] = identityExactSliceRaw(ctx, ws.physicalCandidateRootIds, array.get(ws.physicalCandidateRootIdOffsets, p), array.get(ws.physicalCandidateRootIdLengths, p), bt, tt, slot, id)
            ok := xOk
            if ok and matched
                int ct = array.get(cr.coreCreatedTimes, slot)
                ok := not na(ct)
                array.push(rawEdges, p)
                array.push(rawEdges, slot)
                array.push(rawEdges, id)
                array.push(rawEdges, ct)
            i += 2
        p += 1
    identityPlanBuild(ws, ok ? n : -1, rawEdges)
// W08 B07-C: ownership plan of the current pass (continuation = the B07-B selected match, inheriting the old coreId /
// generationId; fresh = no match, ranked by W08Core fresh allocation order). Returns the fresh count; -1 with empty
// ownership storage. No ID / generation counter, allocation, createdTime or runtime call site.
buildPhysicalOwnershipPlanRaw(ShadowContext ctx) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    WinnerView w3 = ctx.wv
    int k = buildPhysicalIdentityPlanRaw(ctx)
    ownershipPlanBuild(ctx.ws, k, cr.coreSlotLiveFlags, cr.coreIds, cr.coreGenerationIds, w3.candidateWinnerStages, w3.candidateWinnerEffectiveBottomTicks, w3.candidateWinnerEffectiveTopTicks, w3.candidateWinnerMinRootIds, w3.candidateWinnerFvgModes, w3.candidateWinnerPsychLevelTicks, w3.candidateWinnerRootIdOffsets, w3.candidateWinnerRootIdLengths, w3.candidateWinnerRootIds, w3.candidateWinnerRootIdLength)
// W08 B08: Merge topology relations of the current pass (planning only): ownership plan, then mergePlanBuild
// over the full Identity edges and the B07-B survivor matches. Returns the relation count; -1 (Merge storage empty) when
// any upstream stage or the Merge plan fails. Nothing is applied (no materialization, free or ID write); no runtime call site.
buildPhysicalMergePlanRaw(ShadowContext ctx) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    int f = buildPhysicalOwnershipPlanRaw(ctx)
    mergePlanBuild(ctx.ws, f, cr.coreSlotLiveFlags, cr.coreIds, cr.coreCreatedTimes)
// W08 B07-D: transactional materialization of the stored B07-C ownership plan (the plan is not rebuilt). F0 proves the
// whole commit without any write, with the same predicates the commit primitives use: plan / physical sizes, fresh ranks
// 0 .. F - 1 with sentinels, continuation targets (live, coreId, generationId, createdTime, each once; participation
// detach ready, coreIndexCanRelease), baseCloseTime, ID counters (fresh IDs never registered), the planned fresh
// slots (free stack top first, then appended; no participation edge, coreIndexClean), every Root ID (issued, live,
// strictly ascending per slice, participationRootAddableRaw for the Side slices), the exact range against its ticks,
// coreIndexCanInstall per target, the participation free list and the array capacities. Commit (only after F0):
// continuation release in place, fresh allocation in rank order with planned coreId = nextCoreId + rank /
// generationId = nextGenerationId + rank / createdTime = baseCloseTime, then exact range, origin (rootId ASC), inverse per
// FVG origin (Broad included), Side participation (own winner Root set), one interval tuple; the counters move once at the
// end. A commit primitive reporting false after F0 is an invariant break (runtime.error), never a partial -1. Returns the
// materialized count (mapping in physicalMaterialized*); -1 when F0 fails (nothing written). Unmatched old Cores are not
// freed here. No runtime call site yet.
// W08 B15-B2: materializeAppliedRaw = the B07-D materialization above restricted to applyP (the applied Candidates of the
// shadow pass): applied fresh rows take ranks 0 .. fa - 1 in B07-C fresh rank order (coreId = nextCoreId + rank,
// generationId = nextGenerationId + rank; a deferred fresh row reserves no ID / slot); commit = false stops after F0 (no
// write); a non-applied Candidate keeps SLOT_INVALID / ID_NONE in physicalMaterialized*; the range change is recorded in
// ctx.sc.rangeChanged and the revision moves once at the end of commitPass. Returns fa (applied fresh count); -1 when F0 fails.
materializeAppliedRaw(ShadowContext ctx, array<bool> applyP, int materializeBaseCloseTime, bool commit) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    WinnerView w3 = ctx.wv
    W08Store   ws = ctx.ws
    int  n      = ws.physicalCandidateLogicalCount
    int  fc     = ws.physicalFreshAllocationCount
    int  nFree  = array.size(cr.coreFreeSlots)
    int  nCore  = array.size(cr.coreIds)
    int  maxArr = 100000
    bool ok = n >= 0 and fc >= 0 and fc <= n and array.size(ws.physicalOwnershipKinds) == n and array.size(ws.physicalContinuationOldCoreSlots) == n and array.size(ws.physicalContinuationCoreIds) == n and array.size(ws.physicalContinuationGenerationIds) == n and array.size(ws.physicalFreshAllocationRanks) == n and array.size(ws.physicalCandidateBottomTicks) == n and array.size(ws.physicalCandidateTopTicks) == n and array.size(ws.physicalCandidateRootIdOffsets) == n and array.size(ws.physicalCandidateRootIdLengths) == n and array.size(ws.physicalCandidateSupportWinnerIndexes) == n and array.size(ws.physicalCandidateResistanceWinnerIndexes) == n and array.size(ws.physicalCandidateExactPrices) == 2 * n and not na(materializeBaseCloseTime) and materializeBaseCloseTime > 0 and ctx.mintick > 0 and ctx.sc.nextCoreId >= 1 and ctx.sc.nextGenerationId >= 1 and array.size(applyP) == n
    // B15-B2: only applied Candidates (changed component, not pending) materialize. Applied fresh rows take ranks 0 .. fa - 1
    // in B07-C fresh rank order; a deferred fresh row reserves no ID / slot (no ID gap).
    array<int> aRank = array.new_int(ok ? n : 0, -1)
    array<int> rankP = array.new_int(ok ? fc : 0, SLOT_INVALID)
    int freshRows = 0
    int q0 = 0
    while ok and q0 < n
        if array.get(ws.physicalOwnershipKinds, q0) == 1
            int rk = array.get(ws.physicalFreshAllocationRanks, q0)
            ok := rk >= 0 and rk < fc
            if ok
                ok := array.get(rankP, rk) == SLOT_INVALID
                array.set(rankP, rk, q0)
            freshRows += 1
        q0 += 1
    ok := ok and freshRows == fc
    int fa = 0
    int f0 = 0
    while ok and f0 < fc
        int q = array.get(rankP, f0)
        if array.get(applyP, q)
            array.set(aRank, q, fa)
            fa += 1
        f0 += 1
    array<int> byRank  = array.new_int(ok ? fa : 0, SLOT_INVALID)
    array<int> tSlot   = array.new_int(ok ? n : 0, SLOT_INVALID)
    array<int> tId     = array.new_int(ok ? n : 0, ID_NONE)
    map<int, bool> contIds = map.new<int, bool>()
    int newEdges = 0
    int newNodes = 0
    int newInv   = 0
    int p = 0
    while ok and p < n
        if array.get(applyP, p)
            int slot = array.get(ws.physicalContinuationOldCoreSlots, p)
            int id   = array.get(ws.physicalContinuationCoreIds, p)
            int gen  = array.get(ws.physicalContinuationGenerationIds, p)
            int rank = array.get(ws.physicalFreshAllocationRanks, p)
            if array.get(ws.physicalOwnershipKinds, p) == 1
                ok := slot == SLOT_INVALID and id == ID_NONE and gen == ID_NONE and rank >= 0 and rank < fc
                if ok
                    ok := array.get(aRank, p) >= 0 and array.get(byRank, array.get(aRank, p)) == SLOT_INVALID
                    if ok
                        array.set(byRank, array.get(aRank, p), p)
                    // planned fresh slot: the free stack top first (pop order), then appended slots; planned IDs by rank
                    slot := nCore + array.get(aRank, p) - nFree
                    if array.get(aRank, p) < nFree
                        slot := array.get(cr.coreFreeSlots, nFree - 1 - array.get(aRank, p))
                    id   := ctx.sc.nextCoreId + array.get(aRank, p)
                    ok   := ok and slot >= 0 and not map.contains(cr.coreIdToSlot, id) and coreIndexClean(ws, slot)
                    if ok and slot < nCore
                        ok := not array.get(cr.coreSlotLiveFlags, slot)
                    int e = 0
                    while ok and e < array.size(ctx.pv.participationEdgeSideSlots)
                        ok := not (array.get(ctx.pv.participationEdgeLiveFlags, e) and int(math.floor(array.get(ctx.pv.participationEdgeSideSlots, e) / 2)) == slot)
                        e += 1
            else
                ok := array.get(ws.physicalOwnershipKinds, p) == 0 and rank == -1 and slot >= 0 and slot < nCore and id >= 1 and gen >= 1 and not map.contains(contIds, id)
                if ok
                    ok := array.get(cr.coreSlotLiveFlags, slot) and array.get(cr.coreIds, slot) == id and array.get(cr.coreGenerationIds, slot) == gen and not na(array.get(cr.coreCreatedTimes, slot))
                    map.put(contIds, id, true)
                if ok
                    [partReady, partCoreId, partTargets] = participationDetachAllReadyRaw(ctx, slot)
                    ok := partReady and partCoreId == id and coreIndexCanRelease(ws, slot, id)
            if ok
                array.set(tSlot, p, slot)
                array.set(tId, p, id)
            // exact range, then the install predicate of this target
            float xb = array.get(ws.physicalCandidateExactPrices, 2 * p)
            float xt = array.get(ws.physicalCandidateExactPrices, 2 * p + 1)
            if ok
                ok := not na(xb) and not na(xt) and xb <= xt and int(math.round(xb / ctx.mintick)) == array.get(ws.physicalCandidateBottomTicks, p) and int(math.round(xt / ctx.mintick)) == array.get(ws.physicalCandidateTopTicks, p)
            if ok
                ok := coreIndexCanInstall(ws, slot, id, xb, xt, ctx.mintick, ws.physicalCandidateRootIds, array.get(ws.physicalCandidateRootIdOffsets, p), array.get(ws.physicalCandidateRootIdLengths, p))
            // Root IDs: the physical union (Core origin) and the Side winner slices (participation), issued, live, resolved
            int part = 0
            while ok and part < 3
                array<int> ids = part == 0 ? ws.physicalCandidateRootIds : w3.candidateWinnerRootIds
                int w   = part == 1 ? array.get(ws.physicalCandidateSupportWinnerIndexes, p) : part == 2 ? array.get(ws.physicalCandidateResistanceWinnerIndexes, p) : 0
                int off = 0
                int len = 0
                if part == 0
                    off := array.get(ws.physicalCandidateRootIdOffsets, p)
                    len := array.get(ws.physicalCandidateRootIdLengths, p)
                else if w >= 0
                    ok  := w < w3.candidateWinnerLogicalCount
                    if ok
                        off := array.get(w3.candidateWinnerRootIdOffsets, w)
                        len := array.get(w3.candidateWinnerRootIdLengths, w)
                ok := ok and off >= 0 and len >= 0 and off + len <= array.size(ids) and (part != 0 or len > 0)
                int last = 0
                int r = 0
                while ok and r < len
                    int rootId = array.get(ids, off + r)
                    ok := rootId > last and rootId < ctx.sc.nextRootId and map.contains(ctx.rv.rootIdToSlot, rootId)
                    last := rootId
                    if ok
                        int rs = map.get(ctx.rv.rootIdToSlot, rootId)
                        ok := rs >= 0 and rs < array.size(ctx.rv.rootIds) and array.get(ctx.rv.rootSlotLiveFlags, rs) and array.get(ctx.rv.rootIds, rs) == rootId and rs < array.size(ctx.rv.rootCategories)
                        if ok and part == 0 and array.get(ctx.rv.rootCategories, rs) == CAT_FVG
                            newInv += 1
                        if ok and part > 0
                            ok := participationRootAddableRaw(ctx, rs)
                    r += 1
                if part == 0
                    newNodes += len
                else
                    newEdges += len
                part += 1
        p += 1
    // participation free list (each entry a distinct dead edge row) and array capacities
    map<int, bool> freeSeen = map.new<int, bool>()
    int fi = 0
    while ok and fi < array.size(ctx.pv.participationEdgeFreeIndexes)
        int edge = array.get(ctx.pv.participationEdgeFreeIndexes, fi)
        ok := participationEdgeFreeEntryOkRaw(ctx, edge) and not map.contains(freeSeen, edge)
        map.put(freeSeen, edge, true)
        fi += 1
    if ok
        int appended = math.max(0, fa - nFree)
        ok := 2 * (nCore + appended) <= maxArr and array.size(ctx.pv.participationEdgeRootSlots) + newEdges <= maxArr and array.size(ws.coreZoneOriginRootNodeRootIds) + newNodes <= maxArr and array.size(ws.coreIntervalOrderData) + 4 * n <= maxArr and array.size(ws.inverseOriginData) + 3 * newInv <= maxArr
    // ---- commit (every step below was proven by F0) ----
    if ok and commit
        int baseId  = ctx.sc.nextCoreId
        int baseGen = ctx.sc.nextGenerationId
        array.clear(ws.physicalMaterializedCoreSlots)
        array.clear(ws.physicalMaterializedCoreIds)
        array.clear(ws.physicalMaterializedGenerationIds)
        ws.physicalMaterializedLogicalCount := 0
        bool fine = true
        p := 0
        while p < n
            array.push(ws.physicalMaterializedCoreSlots, array.get(tSlot, p))
            array.push(ws.physicalMaterializedCoreIds, array.get(tId, p))
            array.push(ws.physicalMaterializedGenerationIds, array.get(applyP, p) ? array.get(ws.physicalContinuationGenerationIds, p) : ID_NONE)
            if array.get(ws.physicalOwnershipKinds, p) == 0 and array.get(applyP, p)
                fine := fine and participationDetachAllForCoreRaw(ctx, array.get(tSlot, p)) and coreIndexRelease(ws, array.get(tSlot, p), array.get(tId, p))
            p += 1
        int f = 0
        while f < fa
            int q = array.get(byRank, f)
            fine := fine and coreAllocSlotRaw(ctx, baseId + f, baseGen + f, materializeBaseCloseTime) == array.get(tSlot, q)
            array.set(ws.physicalMaterializedGenerationIds, q, baseGen + f)
            f += 1
        bool rangeChanged = false
        p := 0
        while p < n
            if array.get(applyP, p)
                int   slot = array.get(tSlot, p)
                int   id   = array.get(tId, p)
                int   gen  = array.get(ws.physicalMaterializedGenerationIds, p)
                float xb   = array.get(ws.physicalCandidateExactPrices, 2 * p)
                float xt   = array.get(ws.physicalCandidateExactPrices, 2 * p + 1)
                rangeChanged := rangeChanged or array.get(cr.corePhysicalBottoms, slot) != xb or array.get(cr.corePhysicalTops, slot) != xt
                array.set(cr.corePhysicalBottoms, slot, xb)
                array.set(cr.corePhysicalTops, slot, xt)
                int off = array.get(ws.physicalCandidateRootIdOffsets, p)
                int r = 0
                while r < array.get(ws.physicalCandidateRootIdLengths, p)
                    int rootId = array.get(ws.physicalCandidateRootIds, off + r)
                    [aOk, aChanged] = originAdd(ws, slot, id, gen, rootId)
                    fine := fine and aOk
                    if array.get(ctx.rv.rootCategories, map.get(ctx.rv.rootIdToSlot, rootId)) == CAT_FVG
                        [vOk, vChanged] = inverseOriginAdd(ws, rootId, slot, id)
                        fine := fine and vOk
                    r += 1
                int side = 0
                while side < 2
                    int w = side == 0 ? array.get(ws.physicalCandidateSupportWinnerIndexes, p) : array.get(ws.physicalCandidateResistanceWinnerIndexes, p)
                    if w >= 0
                        int wo = array.get(w3.candidateWinnerRootIdOffsets, w)
                        int wr = 0
                        while wr < array.get(w3.candidateWinnerRootIdLengths, w)
                            fine := fine and participationAddRaw(ctx, map.get(ctx.rv.rootIdToSlot, array.get(w3.candidateWinnerRootIds, wo + wr)), slot * 2 + side)
                            wr += 1
                    side += 1
                [iOk, iChanged] = intervalInsert(ws, slot, id, id, xb, xt, ctx.mintick)
                fine := fine and iOk
            p += 1
        if not fine
            runtime.error("W08 B07-D: materialization commit broke its F0 preflight")
        // B15-B2: the range revision moves once at the end of the pass commit (commitPass)
        ctx.sc.rangeChanged     := ctx.sc.rangeChanged or rangeChanged
        ctx.sc.nextCoreId       := baseId + fa
        ctx.sc.nextGenerationId := baseGen + fa
        ws.physicalMaterializedLogicalCount := n
    ok ? fa : -1
// W08 B10 / B11: the TouchMark algorithms live in W08Touch (ring append / truncation, markPhysicalIndex, historyExtract,
// Merge TouchMark plan); the ring lives in CoreRegistryStore (B15-B1), the plans in W08TouchStore; Main passes
// references (touchRingViewRaw).
touchRingViewRaw(ShadowContext ctx) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    TouchRing.new(cr.touchMarkRingOwnerCoreIds, cr.touchMarkRingHeads, cr.touchMarkRingCounts, cr.touchMarkBaseSeqs, cr.touchMarkTimes, cr.touchMarkSides, cr.touchMarkContactBottoms, cr.touchMarkContactTops, cr.touchMarkCloseAtTouches, cr.touchMarkGenerationIds, cr.touchMarkIsNormalTouchFlags, cr.sideTouchHistoryTruncatedFlags, cr.coreIds, cr.coreSlotLiveFlags, cr.touchMarkCapacityPerCore, cr.touchMarkTouchNos, cr.touchMarkWeakByDepthFlags, cr.touchMarkMaxDepthPcts)
// W08 B11: Merge TouchMark inheritance plan of the current pass (mergePlanBuild over the B08 Merge plan and the
// target winner exact EffectiveRanges; written to engine.w02Aux.w08Touch). Returns the relation count; -1 with the plan
// empty on an upstream or structural fault. No ring write; no runtime call site.
buildMergeTouchPlanRaw(ShadowContext ctx) =>
    int r = buildPhysicalMergePlanRaw(ctx)
    W08Store ws = ctx.ws
    TouchPlan t = ctx.tp
    touchMergePlanBuild(touchRingViewRaw(ctx), t, r, ws.mergeRelationCount, ws.mergeRelations, ws.mergeAbsorbed, ws.physicalCandidateLogicalCount, ws.physicalCandidateSupportWinnerIndexes, ws.physicalCandidateResistanceWinnerIndexes, ctx.wv.candidateWinnerExactPrices, ctx.episodeInts, ctx.episodeFloats, ctx.touchStartPlanInts, ctx.touchStartPlanFloats)
// W08 B12: Split TouchMark assignment plan of the current pass: B11 Merge TouchMark plan, W08Core Split plan, then
// splitPlanBuild (SPLIT_LOCAL children only; Merge-target children stay with the B11 plan). An upstream -1 is
// passed on so the Split plan is cleared and -1 returned. No ring write; no runtime call site.
buildSplitTouchPlanRaw(ShadowContext ctx) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    int m = buildMergeTouchPlanRaw(ctx)
    W08Store ws = ctx.ws
    TouchPlan t = ctx.tp
    int s = splitPlanBuild(ws, m, cr.coreSlotLiveFlags, cr.coreIds, cr.coreCreatedTimes)
    touchSplitPlanBuild(touchRingViewRaw(ctx), ctx.sp, s, ws.splitRelationCount, ws.splitRelations, ws.splitChildren, m, ws.mergeRelationCount, ws.mergeRelations, t.mergeTouchPlanOffsets, t.mergeTouchPlanCounts, t.mergeTouchPlanTruncatedFlags, ws.physicalCandidateLogicalCount, ws.physicalCandidateSupportWinnerIndexes, ws.physicalCandidateResistanceWinnerIndexes, ctx.wv.candidateWinnerExactPrices, ctx.episodeInts, ctx.episodeFloats, ctx.touchStartPlanInts, ctx.touchStartPlanFloats)
// (W08 B15-B2: ported from W08Core /16, private there; same text.)
// Pool shape: the 9 child arrays and the 7 Root-node arrays have one row count each, the per-Core arrays one size, and
// every free-list entry is an in-range, non-live row listed once.
pendingPoolsOkRaw(PendingTopologyStore ps) =>
    int  cN = array.size(ps.pendingTopologyChildLiveFlags)
    int  rN = array.size(ps.pendingTopologyRootNodeLiveFlags)
    int  nC = array.size(ps.corePendingTopologyFlags)
    bool ok = array.size(ps.pendingTopologyChildNextIndexes) == cN and array.size(ps.pendingTopologyChildOwnerCoreSlots) == cN and array.size(ps.pendingTopologyChildExpectedCoreIds) == cN and array.size(ps.pendingTopologyChildExpectedGenerationIds) == cN and array.size(ps.pendingTopologyChildRootHeadNodeIndexes) == cN and array.size(ps.pendingTopologyChildRootTailNodeIndexes) == cN and array.size(ps.pendingTopologyChildRootCounts) == cN
    ok := ok and array.size(ps.pendingTopologyRootNodeRootIds) == rN and array.size(ps.pendingTopologyRootNodeNextIndexes) == rN and array.size(ps.pendingTopologyRootNodeOwnerChildIndexes) == rN and array.size(ps.pendingTopologyRootNodeExpectedCoreIds) == rN and array.size(ps.pendingTopologyRootNodeExpectedGenerationIds) == rN
    ok := ok and array.size(ps.corePendingTopologyChildHeadIndexes) == nC and array.size(ps.corePendingTopologyChildTailIndexes) == nC and array.size(ps.corePendingTopologyChildCounts) == nC
    map<int, bool> seen = map.new<int, bool>()
    int k = 0
    while ok and k < array.size(ps.pendingTopologyChildFreeIndexes)
        int r = array.get(ps.pendingTopologyChildFreeIndexes, k)
        ok := r >= 0 and r < cN and not map.contains(seen, r)
        if ok
            ok := not array.get(ps.pendingTopologyChildLiveFlags, r)
            map.put(seen, r, true)
        k += 1
    map.clear(seen)
    k := 0
    while ok and k < array.size(ps.pendingTopologyRootNodeFreeIndexes)
        int r = array.get(ps.pendingTopologyRootNodeFreeIndexes, k)
        ok := r >= 0 and r < rN and not map.contains(seen, r)
        if ok
            ok := not array.get(ps.pendingTopologyRootNodeLiveFlags, r)
            map.put(seen, r, true)
        k += 1
    ok
// (W08 B15-B2: ported from W08Core /16, private there; same text.)
// Chain integrity of the pending of coreSlot (coreSlot < per-Core size): flag false = empty chain; else exactly count
// live children owned by coreSlot, each visited once, with the expected coreId / generationId, each holding exactly its
// count of live Root nodes owned by it with the same expected IDs and strictly ascending Root IDs >= 1; head / tail /
// next links consistent. Returns [ok, child rows, Root-node rows].
pendingChainOkRaw(PendingTopologyStore ps, int coreSlot, int coreId, int generationId) =>
    int  cN   = array.size(ps.pendingTopologyChildLiveFlags)
    int  rN   = array.size(ps.pendingTopologyRootNodeLiveFlags)
    int  cnt  = array.get(ps.corePendingTopologyChildCounts, coreSlot)
    int  ci   = array.get(ps.corePendingTopologyChildHeadIndexes, coreSlot)
    bool flag = array.get(ps.corePendingTopologyFlags, coreSlot)
    bool ok   = cnt >= 0 and cnt <= cN and (flag or (cnt == 0 and ci == SLOT_INVALID and array.get(ps.corePendingTopologyChildTailIndexes, coreSlot) == SLOT_INVALID))
    map<int, bool> vc = map.new<int, bool>()
    int seen  = 0
    int last  = SLOT_INVALID
    int roots = 0
    while ok and seen < cnt
        ok := ci >= 0 and ci < cN and not map.contains(vc, ci)
        if ok
            map.put(vc, ci, true)
            ok := array.get(ps.pendingTopologyChildLiveFlags, ci) and array.get(ps.pendingTopologyChildOwnerCoreSlots, ci) == coreSlot and array.get(ps.pendingTopologyChildExpectedCoreIds, ci) == coreId and array.get(ps.pendingTopologyChildExpectedGenerationIds, ci) == generationId
        if ok
            int rn  = array.get(ps.pendingTopologyChildRootHeadNodeIndexes, ci)
            int rc  = array.get(ps.pendingTopologyChildRootCounts, ci)
            int rs  = 0
            int rl  = SLOT_INVALID
            int rid = 0
            ok := rc >= 0 and rc <= rN
            while ok and rs < rc
                ok := rn >= 0 and rn < rN
                if ok
                    ok := array.get(ps.pendingTopologyRootNodeLiveFlags, rn) and array.get(ps.pendingTopologyRootNodeOwnerChildIndexes, rn) == ci and array.get(ps.pendingTopologyRootNodeExpectedCoreIds, rn) == coreId and array.get(ps.pendingTopologyRootNodeExpectedGenerationIds, rn) == generationId and array.get(ps.pendingTopologyRootNodeRootIds, rn) > rid
                if ok
                    rid := array.get(ps.pendingTopologyRootNodeRootIds, rn)
                    rl  := rn
                    rn  := array.get(ps.pendingTopologyRootNodeNextIndexes, rn)
                    rs  += 1
            ok := ok and rn == SLOT_INVALID and array.get(ps.pendingTopologyChildRootTailNodeIndexes, ci) == rl
            roots += rc
            last := ci
            if ok
                ci := array.get(ps.pendingTopologyChildNextIndexes, ci)
            seen += 1
    ok := ok and ci == SLOT_INVALID and array.get(ps.corePendingTopologyChildTailIndexes, coreSlot) == last
    [ok, cnt, roots]
// (W08 B15-B2: ported from W08Core /16, private there; same text.)
// Returns every child and Root node of coreSlot's pending to the free lists (sentinels reset) and empties the parent.
// Callers run pendingChainOkRaw first.
pendingClearChainRaw(PendingTopologyStore ps, int coreSlot) =>
    int ci  = array.get(ps.corePendingTopologyChildHeadIndexes, coreSlot)
    int cnt = array.get(ps.corePendingTopologyChildCounts, coreSlot)
    int k   = 0
    while k < cnt
        int nx = array.get(ps.pendingTopologyChildNextIndexes, ci)
        int rn = array.get(ps.pendingTopologyChildRootHeadNodeIndexes, ci)
        int rc = array.get(ps.pendingTopologyChildRootCounts, ci)
        int j  = 0
        while j < rc
            int nr = array.get(ps.pendingTopologyRootNodeNextIndexes, rn)
            array.set(ps.pendingTopologyRootNodeRootIds, rn, ID_NONE)
            array.set(ps.pendingTopologyRootNodeNextIndexes, rn, SLOT_INVALID)
            array.set(ps.pendingTopologyRootNodeOwnerChildIndexes, rn, SLOT_INVALID)
            array.set(ps.pendingTopologyRootNodeExpectedCoreIds, rn, ID_NONE)
            array.set(ps.pendingTopologyRootNodeExpectedGenerationIds, rn, ID_NONE)
            array.set(ps.pendingTopologyRootNodeLiveFlags, rn, false)
            array.push(ps.pendingTopologyRootNodeFreeIndexes, rn)
            rn := nr
            j  += 1
        array.set(ps.pendingTopologyChildNextIndexes, ci, SLOT_INVALID)
        array.set(ps.pendingTopologyChildOwnerCoreSlots, ci, SLOT_INVALID)
        array.set(ps.pendingTopologyChildExpectedCoreIds, ci, ID_NONE)
        array.set(ps.pendingTopologyChildExpectedGenerationIds, ci, ID_NONE)
        array.set(ps.pendingTopologyChildRootHeadNodeIndexes, ci, SLOT_INVALID)
        array.set(ps.pendingTopologyChildRootTailNodeIndexes, ci, SLOT_INVALID)
        array.set(ps.pendingTopologyChildRootCounts, ci, 0)
        array.set(ps.pendingTopologyChildLiveFlags, ci, false)
        array.push(ps.pendingTopologyChildFreeIndexes, ci)
        ci := nx
        k  += 1
    array.set(ps.corePendingTopologyFlags, coreSlot, false)
    array.set(ps.corePendingTopologyChildHeadIndexes, coreSlot, SLOT_INVALID)
    array.set(ps.corePendingTopologyChildTailIndexes, coreSlot, SLOT_INVALID)
    array.set(ps.corePendingTopologyChildCounts, coreSlot, 0)
ufFindRaw(array<int> uf, int x) =>
    int r = x
    while array.get(uf, r) != r
        array.set(uf, r, array.get(uf, array.get(uf, r)))
        r := array.get(uf, r)
    r
pendingNewChildRaw(PendingTopologyStore ps) =>
    int r = SLOT_INVALID
    if array.size(ps.pendingTopologyChildFreeIndexes) > 0
        r := array.pop(ps.pendingTopologyChildFreeIndexes)
    else
        r := array.size(ps.pendingTopologyChildLiveFlags)
        array.push(ps.pendingTopologyChildNextIndexes, SLOT_INVALID)
        array.push(ps.pendingTopologyChildOwnerCoreSlots, SLOT_INVALID)
        array.push(ps.pendingTopologyChildExpectedCoreIds, ID_NONE)
        array.push(ps.pendingTopologyChildExpectedGenerationIds, ID_NONE)
        array.push(ps.pendingTopologyChildRootHeadNodeIndexes, SLOT_INVALID)
        array.push(ps.pendingTopologyChildRootTailNodeIndexes, SLOT_INVALID)
        array.push(ps.pendingTopologyChildRootCounts, 0)
        array.push(ps.pendingTopologyChildLiveFlags, false)
    r
pendingNewRootRaw(PendingTopologyStore ps) =>
    int r = SLOT_INVALID
    if array.size(ps.pendingTopologyRootNodeFreeIndexes) > 0
        r := array.pop(ps.pendingTopologyRootNodeFreeIndexes)
    else
        r := array.size(ps.pendingTopologyRootNodeLiveFlags)
        array.push(ps.pendingTopologyRootNodeRootIds, ID_NONE)
        array.push(ps.pendingTopologyRootNodeNextIndexes, SLOT_INVALID)
        array.push(ps.pendingTopologyRootNodeOwnerChildIndexes, SLOT_INVALID)
        array.push(ps.pendingTopologyRootNodeExpectedCoreIds, ID_NONE)
        array.push(ps.pendingTopologyRootNodeExpectedGenerationIds, ID_NONE)
        array.push(ps.pendingTopologyRootNodeLiveFlags, false)
    r
// Shared B13 / B14 topology component builder (read-only on the stores): validates every physical Root union (non-empty,
// strictly ascending, issued live Roots), the pool shape and every Identity edge (as in mergePlanBuild), unions each old
// slot with its Candidates (uf over nc old slots + n Candidates), records each slot's edge run (runStart / runLen),
// validates every live old Core's existing pending chain (a dead slot or a flag-false slot holds none), records its rows
// (oldChildRows / oldRootRows) and unions pending parents that share a Root ID. The five arrays come in empty.
topologyComponentsRaw(W08Store store, PendingTopologyStore ps, array<bool> coreLive, array<int> coreIds, array<int> coreGenerationIds, array<int> coreCreatedTimes, map<int, int> rootIdToSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> uf, array<int> runStart, array<int> runLen, array<int> oldChildRows, array<int> oldRootRows, bool poolTrusted) =>
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nc = array.size(coreLive)
    array<int> ed = store.physicalIdentityEdges
    bool ok = n >= 0 and array.size(ed) == 3 * ne and array.size(coreIds) >= nc and array.size(coreGenerationIds) >= nc and array.size(coreCreatedTimes) >= nc and array.size(ps.corePendingTopologyFlags) == nc and poolTrusted and n <= array.size(store.physicalCandidateRootIdOffsets) and n <= array.size(store.physicalCandidateRootIdLengths)
    // physical Root unions
    int k = 0
    while ok and k < n
        int o = array.get(store.physicalCandidateRootIdOffsets, k)
        int l = array.get(store.physicalCandidateRootIdLengths, k)
        ok := o >= 0 and l >= 1 and o + l <= array.size(store.physicalCandidateRootIds)
        int j    = 0
        int last = 0
        while ok and j < l
            int id = array.get(store.physicalCandidateRootIds, o + j)
            ok := id > last and map.contains(rootIdToSlot, id)
            if ok
                int rs = map.get(rootIdToSlot, id)
                ok := rs >= 0 and rs < array.size(rootIds) and rs < array.size(rootSlotLiveFlags)
                if ok
                    ok := array.get(rootSlotLiveFlags, rs) and array.get(rootIds, rs) == id
            last := id
            j += 1
        k += 1
    // Identity edges (validated as in mergePlanBuild); union old slot <-> Candidate; per-slot edge run
    k := 0
    while ok and k < nc + n
        array.push(uf, k)
        k += 1
    k := 0
    while ok and k < nc
        array.push(runStart, -1)
        array.push(runLen, 0)
        array.push(oldChildRows, 0)
        array.push(oldRootRows, 0)
        k += 1
    map<int, int> slotOf = map.new<int, int>()
    int lastCt = 0
    int lastId = 0
    int lastP  = -1
    k := 0
    while ok and k < ne
        int p  = array.get(ed, 3 * k)
        int sl = array.get(ed, 3 * k + 1)
        int id = array.get(ed, 3 * k + 2)
        ok := p >= 0 and p < n and sl >= 0 and sl < nc and id >= 1
        if ok
            ok := array.get(coreLive, sl) and array.get(coreIds, sl) == id and not na(array.get(coreCreatedTimes, sl)) and (not map.contains(slotOf, id) or map.get(slotOf, id) == sl)
        if ok
            int ct = array.get(coreCreatedTimes, sl)
            ok := identityEdgeFollowsRaw(store, k, ct, id, p, lastCt, lastId, lastP)
            map.put(slotOf, id, sl)
            if array.get(runStart, sl) < 0
                array.set(runStart, sl, k)
            ok := ok and array.get(runStart, sl) + array.get(runLen, sl) == k
            array.set(runLen, sl, array.get(runLen, sl) + 1)
            array.set(uf, ufFindRaw(uf, sl), ufFindRaw(uf, nc + p))
            lastCt := ct
            lastId := id
            lastP  := p
        k += 1
    // existing pending: chain integrity, rows, and Root-sharing links between pending parents
    map<int, int> rootOwner = map.new<int, int>()
    int cs = 0
    while ok and cs < nc
        if not (array.get(coreLive, cs) and array.get(ps.corePendingTopologyFlags, cs))
            ok := not array.get(ps.corePendingTopologyFlags, cs) and array.get(ps.corePendingTopologyChildCounts, cs) == 0 and array.get(ps.corePendingTopologyChildHeadIndexes, cs) == SLOT_INVALID and array.get(ps.corePendingTopologyChildTailIndexes, cs) == SLOT_INVALID
        else
            [cOk, cRows, rRows] = pendingChainOkRaw(ps, cs, array.get(coreIds, cs), array.get(coreGenerationIds, cs))
            ok := cOk
            array.set(oldChildRows, cs, cRows)
            array.set(oldRootRows, cs, rRows)
            int ci = array.get(ps.corePendingTopologyChildHeadIndexes, cs)
            int c  = 0
            while ok and c < cRows
                int rn = array.get(ps.pendingTopologyChildRootHeadNodeIndexes, ci)
                int r  = 0
                while r < array.get(ps.pendingTopologyChildRootCounts, ci)
                    int rid = array.get(ps.pendingTopologyRootNodeRootIds, rn)
                    if map.contains(rootOwner, rid)
                        array.set(uf, ufFindRaw(uf, cs), ufFindRaw(uf, map.get(rootOwner, rid)))
                    else
                        map.put(rootOwner, rid, cs)
                    rn := array.get(ps.pendingTopologyRootNodeNextIndexes, rn)
                    r  += 1
                ci := array.get(ps.pendingTopologyChildNextIndexes, ci)
                c  += 1
        cs += 1
    ok
// B13 PendingTopology planner over the current pass (upstreamResult = the Main B12 chain result, >= 0). F0 (read-only):
// Identity edges as in mergePlanBuild, every physical Root union non-empty, strictly ascending, of issued live Roots, the
// pool shape, every live old Core's existing pending chain (a dead slot holds none), the component classification, the
// exact same-snapshot test and the pool capacity (free rows, rows freed by the replaced parents, then appended rows up to
// 100000). Commit (only after F0): every parent of each changed active component is cleared, then rewritten (latest
// state). Returns [immediate, pending, ready] component counts over live old Cores and physical Candidates; [-1, -1, -1]
// with nothing written on any fault.
pendingPlanTrustedRaw(W08Store store, PendingTopologyStore ps, int upstreamResult, array<bool> coreLive, array<int> coreIds, array<int> coreGenerationIds, array<int> coreCreatedTimes, array<int> sidePhases, map<int, int> rootIdToSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, bool poolTrusted) =>
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nc = array.size(coreLive)
    array<int> ed = store.physicalIdentityEdges
    array<int> uf           = array.new_int(0)
    array<int> runStart     = array.new_int(0)
    array<int> runLen       = array.new_int(0)
    array<int> oldChildRows = array.new_int(0)
    array<int> oldRootRows  = array.new_int(0)
    bool ok = upstreamResult >= 0 and array.size(sidePhases) >= 2 * nc
    ok := ok and topologyComponentsRaw(store, ps, coreLive, coreIds, coreGenerationIds, coreCreatedTimes, rootIdToSlot, rootIds, rootSlotLiveFlags, uf, runStart, runLen, oldChildRows, oldRootRows, poolTrusted)
    int k  = 0
    int cs = 0
    // component classification (roots of live old Cores and of Candidates)
    int m = nc + n
    array<bool> seenC  = array.new_bool(ok ? m : 0, false)
    array<bool> active = array.new_bool(ok ? m : 0, false)
    array<bool> pend   = array.new_bool(ok ? m : 0, false)
    array<bool> diff   = array.new_bool(ok ? m : 0, false)
    cs := 0
    while ok and cs < nc
        if array.get(coreLive, cs)
            int r = ufFindRaw(uf, cs)
            array.set(seenC, r, true)
            if array.get(sidePhases, 2 * cs) == PH_ACTIVE_TOUCH or array.get(sidePhases, 2 * cs + 1) == PH_ACTIVE_TOUCH
                array.set(active, r, true)
            if array.get(ps.corePendingTopologyFlags, cs)
                array.set(pend, r, true)
        cs += 1
    k := 0
    while ok and k < n
        array.set(seenC, ufFindRaw(uf, nc + k), true)
        k += 1
    // exact same-snapshot test per parent of an active component (children in edge-run order, exact Root lists)
    cs := 0
    while ok and cs < nc
        if array.get(coreLive, cs)
            int r = ufFindRaw(uf, cs)
            if array.get(active, r) and not array.get(diff, r)
                bool same = array.get(ps.corePendingTopologyFlags, cs) and array.get(ps.corePendingTopologyChildCounts, cs) == array.get(runLen, cs)
                int  ci   = array.get(ps.corePendingTopologyChildHeadIndexes, cs)
                int  c    = 0
                while same and c < array.get(runLen, cs)
                    int p  = array.get(ed, 3 * (array.get(runStart, cs) + c))
                    int o  = array.get(store.physicalCandidateRootIdOffsets, p)
                    int l  = array.get(store.physicalCandidateRootIdLengths, p)
                    same := array.get(ps.pendingTopologyChildRootCounts, ci) == l
                    int rn = array.get(ps.pendingTopologyChildRootHeadNodeIndexes, ci)
                    int j  = 0
                    while same and j < l
                        same := array.get(ps.pendingTopologyRootNodeRootIds, rn) == array.get(store.physicalCandidateRootIds, o + j)
                        rn   := array.get(ps.pendingTopologyRootNodeNextIndexes, rn)
                        j    += 1
                    ci := array.get(ps.pendingTopologyChildNextIndexes, ci)
                    c  += 1
                if not same
                    array.set(diff, r, true)
        cs += 1
    // capacity: rows needed by the rewritten parents vs free rows + rows they release + appendable rows
    int needC = 0
    int needR = 0
    int freeC = array.size(ps.pendingTopologyChildFreeIndexes)
    int freeR = array.size(ps.pendingTopologyRootNodeFreeIndexes)
    cs := 0
    while ok and cs < nc
        if array.get(coreLive, cs)
            if array.get(diff, ufFindRaw(uf, cs))
                freeC += array.get(oldChildRows, cs)
                freeR += array.get(oldRootRows, cs)
                needC += array.get(runLen, cs)
                int c = 0
                while c < array.get(runLen, cs)
                    needR += array.get(store.physicalCandidateRootIdLengths, array.get(ed, 3 * (array.get(runStart, cs) + c)))
                    c += 1
        cs += 1
    ok := ok and array.size(ps.pendingTopologyChildLiveFlags) + math.max(0, needC - freeC) <= 100000 and array.size(ps.pendingTopologyRootNodeLiveFlags) + math.max(0, needR - freeR) <= 100000
    int imm = 0
    int pen = 0
    int rdy = 0
    k := 0
    while ok and k < m
        if array.get(seenC, k) and ufFindRaw(uf, k) == k
            if array.get(active, k)
                pen += 1
            else if array.get(pend, k)
                rdy += 1
            else
                imm += 1
        k += 1
    // commit: clear every parent of a changed active component, then write its latest children / Root lists
    if ok
        cs := 0
        while cs < nc
            if array.get(coreLive, cs)
                if array.get(diff, ufFindRaw(uf, cs))
                    pendingClearChainRaw(ps, cs)
            cs += 1
        cs := 0
        while cs < nc
            if array.get(coreLive, cs)
                if array.get(diff, ufFindRaw(uf, cs))
                    int cid  = array.get(coreIds, cs)
                    int gid  = array.get(coreGenerationIds, cs)
                    int prev = SLOT_INVALID
                    int c    = 0
                    while c < array.get(runLen, cs)
                        int p  = array.get(ed, 3 * (array.get(runStart, cs) + c))
                        int o  = array.get(store.physicalCandidateRootIdOffsets, p)
                        int l  = array.get(store.physicalCandidateRootIdLengths, p)
                        int ci = pendingNewChildRaw(ps)
                        array.set(ps.pendingTopologyChildNextIndexes, ci, SLOT_INVALID)
                        array.set(ps.pendingTopologyChildOwnerCoreSlots, ci, cs)
                        array.set(ps.pendingTopologyChildExpectedCoreIds, ci, cid)
                        array.set(ps.pendingTopologyChildExpectedGenerationIds, ci, gid)
                        array.set(ps.pendingTopologyChildRootCounts, ci, l)
                        array.set(ps.pendingTopologyChildLiveFlags, ci, true)
                        int rPrev = SLOT_INVALID
                        int j     = 0
                        while j < l
                            int rn = pendingNewRootRaw(ps)
                            array.set(ps.pendingTopologyRootNodeRootIds, rn, array.get(store.physicalCandidateRootIds, o + j))
                            array.set(ps.pendingTopologyRootNodeNextIndexes, rn, SLOT_INVALID)
                            array.set(ps.pendingTopologyRootNodeOwnerChildIndexes, rn, ci)
                            array.set(ps.pendingTopologyRootNodeExpectedCoreIds, rn, cid)
                            array.set(ps.pendingTopologyRootNodeExpectedGenerationIds, rn, gid)
                            array.set(ps.pendingTopologyRootNodeLiveFlags, rn, true)
                            if rPrev == SLOT_INVALID
                                array.set(ps.pendingTopologyChildRootHeadNodeIndexes, ci, rn)
                            else
                                array.set(ps.pendingTopologyRootNodeNextIndexes, rPrev, rn)
                            rPrev := rn
                            j     += 1
                        array.set(ps.pendingTopologyChildRootTailNodeIndexes, ci, rPrev)
                        if rPrev == SLOT_INVALID
                            array.set(ps.pendingTopologyChildRootHeadNodeIndexes, ci, SLOT_INVALID)
                        if prev == SLOT_INVALID
                            array.set(ps.corePendingTopologyChildHeadIndexes, cs, ci)
                        else
                            array.set(ps.pendingTopologyChildNextIndexes, prev, ci)
                        prev := ci
                        c    += 1
                    array.set(ps.corePendingTopologyChildTailIndexes, cs, prev)
                    array.set(ps.corePendingTopologyChildCounts, cs, array.get(runLen, cs))
                    array.set(ps.corePendingTopologyFlags, cs, true)
            cs += 1
    [ok ? imm : -1, ok ? pen : -1, ok ? rdy : -1]
// B14 changed-topology planner (see the header). upstreamResult = the Main B13 result (>= 0). Old ranges are the Main
// corePhysicalBottoms / Tops; Candidate ranges physicalCandidateExactPrices; ticks = round(price / mintick). Returns the
// changed component count; -1 with the changed storage empty on any fault (nothing else is written).
changedPlanTrustedRaw(W08Store store, PendingTopologyStore ps, int upstreamResult, array<bool> coreLive, array<int> coreIds, array<int> coreGenerationIds, array<int> coreCreatedTimes, array<float> corePhysicalBottoms, array<float> corePhysicalTops, array<int> sidePhases, map<int, int> rootIdToSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCandComponentIds, array<int> candComponentIds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> changedRootIds, array<int> changedComponentIds, bool scopeFull, float mintick, bool poolTrusted) =>
    array.clear(store.changedOldCores)
    array.clear(store.changedTargets)
    int n  = store.physicalCandidateLogicalCount
    int nc = array.size(coreLive)
    array<int> uf           = array.new_int(0)
    array<int> runStart     = array.new_int(0)
    array<int> runLen       = array.new_int(0)
    array<int> oldChildRows = array.new_int(0)
    array<int> oldRootRows  = array.new_int(0)
    bool ok = upstreamResult >= 0 and mintick > 0 and array.size(sidePhases) >= 2 * nc and array.size(corePhysicalBottoms) >= nc and array.size(corePhysicalTops) >= nc and array.size(rootCandComponentIds) >= array.size(rootIds) and array.size(candComponentMemberOffsets) == array.size(candComponentIds) and array.size(candComponentMemberLengths) == array.size(candComponentIds) and array.size(candMemberRoleFlags) == array.size(candMemberRootIds) and array.size(store.physicalOwnershipKinds) == n and array.size(store.physicalContinuationOldCoreSlots) == n and array.size(store.physicalFreshAllocationRanks) == n and array.size(store.physicalCandidateExactPrices) == 2 * n and array.size(store.mergeRelations) == 5 * store.mergeRelationCount and array.size(store.splitChildren) == store.splitChildLogicalCount
    ok := ok and topologyComponentsRaw(store, ps, coreLive, coreIds, coreGenerationIds, coreCreatedTimes, rootIdToSlot, rootIds, rootSlotLiveFlags, uf, runStart, runLen, oldChildRows, oldRootRows, poolTrusted)
    // W06 semantic change sets
    map<int, bool> chRoot  = map.new<int, bool>()
    map<int, bool> chComp  = map.new<int, bool>()
    map<int, bool> chBroad = map.new<int, bool>()
    int k = 0
    while ok and k < array.size(changedRootIds)
        ok := array.get(changedRootIds, k) >= 1 and (k == 0 or array.get(changedRootIds, k) > array.get(changedRootIds, k - 1))
        map.put(chRoot, array.get(changedRootIds, k), true)
        k += 1
    k := 0
    while ok and k < array.size(changedComponentIds)
        map.put(chComp, array.get(changedComponentIds, k), true)
        k += 1
    k := 0
    while ok and k < array.size(candComponentIds)
        if map.contains(chComp, array.get(candComponentIds, k))
            int o = array.get(candComponentMemberOffsets, k)
            int l = array.get(candComponentMemberLengths, k)
            ok := o >= 0 and l >= 0 and o + l <= array.size(candMemberRootIds)
            int j = 0
            while ok and j < l
                if array.get(candMemberRoleFlags, o + j) == CAND_MEMBER_ROLE_INCLUDED_BROAD
                    map.put(chBroad, array.get(candMemberRootIds, o + j), true)
                j += 1
        k += 1
    // seeds -> changed components (B13 topology closure)
    int m = nc + n
    array<bool> seedC   = array.new_bool(ok ? m : 0, scopeFull)
    array<bool> activeC = array.new_bool(ok ? m : 0, false)
    k := 0
    while ok and k < n
        int o = array.get(store.physicalCandidateRootIdOffsets, k)
        int l = array.get(store.physicalCandidateRootIdLengths, k)
        bool hit = false
        int j = 0
        while not hit and j < l
            int id = array.get(store.physicalCandidateRootIds, o + j)
            int cid = array.get(rootCandComponentIds, map.get(rootIdToSlot, id))
            hit := map.contains(chRoot, id) or (cid != 0 and map.contains(chComp, cid)) or (cid == 0 and map.contains(chBroad, id))
            j += 1
        if hit
            array.set(seedC, ufFindRaw(uf, nc + k), true)
        k += 1
    array<int> orig = array.new_int(0)
    int cs = 0
    while ok and cs < nc
        if array.get(coreLive, cs)
            int r = ufFindRaw(uf, cs)
            if array.get(sidePhases, 2 * cs) == PH_ACTIVE_TOUCH or array.get(sidePhases, 2 * cs + 1) == PH_ACTIVE_TOUCH
                array.set(activeC, r, true)
            ok := originReadAsc(store, cs, array.get(coreIds, cs), orig) >= 0
            int j = 0
            while ok and j < array.size(orig)
                if map.contains(chRoot, array.get(orig, j))
                    array.set(seedC, r, true)
                j += 1
        cs += 1
    cs := 0
    while ok and cs < nc
        if array.get(coreLive, cs) and array.get(ps.corePendingTopologyFlags, cs)
            int r = ufFindRaw(uf, cs)
            if not array.get(activeC, r)
                array.set(seedC, r, true)
        cs += 1
    // canonical component numbering: live olds in old canonical order, then Candidates in new canonical order
    array<int> olds = array.new_int(0)
    cs := 0
    while ok and cs < nc
        if array.get(coreLive, cs)
            ok := not na(array.get(coreCreatedTimes, cs))
            int pos = array.size(olds)
            while ok and pos > 0 and (array.get(coreCreatedTimes, array.get(olds, pos - 1)) > array.get(coreCreatedTimes, cs) or (array.get(coreCreatedTimes, array.get(olds, pos - 1)) == array.get(coreCreatedTimes, cs) and array.get(coreIds, array.get(olds, pos - 1)) > array.get(coreIds, cs)))
                pos -= 1
            array.insert(olds, pos, cs)
        cs += 1
    array<int> news = array.new_int(0)
    k := 0
    while ok and k < n
        int pos = array.size(news)
        int c   = 1
        while ok and pos > 0 and c > 0
            int q = array.get(news, pos - 1)
            c := physicalNewCompareRaw(store, q, k)
            if c == 0
                // complete new-order tie: only edge-less (fresh) Candidates can tie; B07-C fresh allocation rank decides
                ok := array.get(store.physicalFreshAllocationRanks, q) >= 0 and array.get(store.physicalFreshAllocationRanks, k) >= 0
                c  := array.get(store.physicalFreshAllocationRanks, q) - array.get(store.physicalFreshAllocationRanks, k)
            ok := ok and c != 0
            if c > 0
                pos -= 1
        array.insert(news, pos, k)
        k += 1
    array<int> ord = array.new_int(ok ? m : 0, -1)
    int nComp = 0
    k := 0
    while ok and k < array.size(olds) + array.size(news)
        int node = SLOT_INVALID
        if k < array.size(olds)
            node := array.get(olds, k)
        else
            node := nc + array.get(news, k - array.size(olds))
        int r = ufFindRaw(uf, node)
        if array.get(seedC, r)
            if array.get(ord, r) < 0
                array.set(ord, r, nComp)
                nComp += 1
            if k < array.size(olds)
                array.push(store.changedOldCores, node)
                array.push(store.changedOldCores, array.get(ord, r))
            else
                int p     = node - nc
                int kind  = array.get(store.physicalOwnershipKinds, p)
                int osl   = kind == 0 ? array.get(store.physicalContinuationOldCoreSlots, p) : -1
                int flags = 16
                if kind == 0
                    ok := osl >= 0 and osl < nc
                    float ob = na
                    float ot = na
                    if ok
                        ob := array.get(corePhysicalBottoms, osl)
                        ot := array.get(corePhysicalTops, osl)
                        ok := not na(ob) and not na(ot) and originReadAsc(store, osl, array.get(coreIds, osl), orig) >= 0
                    if ok
                        float nb = array.get(store.physicalCandidateExactPrices, 2 * p)
                        float nt = array.get(store.physicalCandidateExactPrices, 2 * p + 1)
                        if ob != nb or ot != nt
                            flags += 1
                        if int(math.round(ob / mintick)) != array.get(store.physicalCandidateBottomTicks, p) or int(math.round(ot / mintick)) != array.get(store.physicalCandidateTopTicks, p)
                            flags += 2
                        int o = array.get(store.physicalCandidateRootIdOffsets, p)
                        int l = array.get(store.physicalCandidateRootIdLengths, p)
                        bool same = l == array.size(orig)
                        int j = 0
                        while same and j < l
                            same := array.get(orig, j) == array.get(store.physicalCandidateRootIds, o + j)
                            j += 1
                        if not same
                            flags += 4
                bool rel = false
                int j = 0
                while not rel and j < store.mergeRelationCount
                    rel := array.get(store.mergeRelations, 5 * j) == p
                    j += 1
                j := 0
                while not rel and j < store.splitChildLogicalCount
                    rel := array.get(store.splitChildren, j) == p
                    j += 1
                if kind != 0 or rel or flags % 8 != 0
                    flags += 8
                array.push(store.changedTargets, p)
                array.push(store.changedTargets, array.get(ord, r))
                array.push(store.changedTargets, kind)
                array.push(store.changedTargets, osl)
                array.push(store.changedTargets, flags)
        k += 1
    if not ok
        array.clear(store.changedOldCores)
        array.clear(store.changedTargets)
    store.changedComponentCount := ok ? nComp : 0
    ok ? nComp : -1
// W08 B13: PendingTopology plan of the current pass (recompute model): the B12 chain once (buildSplitTouchPlanRaw), then
// the B13 planner (pendingPlanTrustedRaw = pendingPlanBuild on the pass-trusted pool) over the Identity components (any old Side in ActiveTouch -> the whole component is pending,
// latest-state replace in the existing W02Aux pool). Returns [immediate, pending, ready] component counts, -1s on any
// fault (pool unchanged). No topology / Touch / phase / generation write; no runtime call site.
buildPendingTopologyPlanRaw(ShadowContext ctx, array<int> phases) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    int s = buildSplitTouchPlanRaw(ctx)
    pendingPlanTrustedRaw(ctx.ws, pendingStoreViewRaw(ctx), s, cr.coreSlotLiveFlags, cr.coreIds, cr.coreGenerationIds, cr.coreCreatedTimes, phases, ctx.rv.rootIdToSlot, ctx.rv.rootIds, ctx.rv.rootSlotLiveFlags, ctx.pendingPoolTrusted)
// W08 B14: changed topology scope of the current pass: the B13 chain once, then changedPlanTrustedRaw (changedPlanBuild on the
// pass-trusted pool) with the W06
// /18 semantic change metadata (changed Root IDs, changed current component IDs, scope full) and the W06 component
// dependency (rootCandComponentIds, member pool). Returns the changed component count; -1 on any fault. Planning only:
// no revision / cache / index write; no runtime call site.
buildChangedTopologyPlanRaw(ShadowContext ctx, array<int> phases) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    [imm, pen, rdy] = buildPendingTopologyPlanRaw(ctx, phases)
    ComponentMetaView a = ctx.mv
    changedPlanTrustedRaw(ctx.ws, pendingStoreViewRaw(ctx), imm, cr.coreSlotLiveFlags, cr.coreIds, cr.coreGenerationIds, cr.coreCreatedTimes, cr.corePhysicalBottoms, cr.corePhysicalTops, phases, ctx.rv.rootIdToSlot, ctx.rv.rootIds, ctx.rv.rootSlotLiveFlags, a.rootCandComponentIds, a.candComponentIds, a.candComponentMemberOffsets, a.candComponentMemberLengths, a.candMemberRootIds, a.candMemberRoleFlags, a.candSemanticChangedRootIds, a.candSemanticChangedCurrentComponentIds, array.get(a.candChangedScopeFull, 0), ctx.mintick, ctx.pendingPoolTrusted)
// W08 B15-B2: the pass scratch copy of the pending pool (B13 pendingPlanBuild rewrites the pool while planning; the shadow
// plan runs on this copy, the real pool changes only in commit step 1).
pendingCopyRaw(PendingTopologyStore ps) =>
    PendingTopologyStore.new(array.copy(ps.corePendingTopologyFlags), array.copy(ps.corePendingTopologyChildHeadIndexes), array.copy(ps.corePendingTopologyChildTailIndexes), array.copy(ps.corePendingTopologyChildCounts), array.copy(ps.pendingTopologyChildNextIndexes), array.copy(ps.pendingTopologyChildOwnerCoreSlots), array.copy(ps.pendingTopologyChildExpectedCoreIds), array.copy(ps.pendingTopologyChildExpectedGenerationIds), array.copy(ps.pendingTopologyChildRootHeadNodeIndexes), array.copy(ps.pendingTopologyChildRootTailNodeIndexes), array.copy(ps.pendingTopologyChildRootCounts), array.copy(ps.pendingTopologyChildLiveFlags), array.copy(ps.pendingTopologyChildFreeIndexes), array.copy(ps.pendingTopologyRootNodeRootIds), array.copy(ps.pendingTopologyRootNodeNextIndexes), array.copy(ps.pendingTopologyRootNodeOwnerChildIndexes), array.copy(ps.pendingTopologyRootNodeExpectedCoreIds), array.copy(ps.pendingTopologyRootNodeExpectedGenerationIds), array.copy(ps.pendingTopologyRootNodeLiveFlags), array.copy(ps.pendingTopologyRootNodeFreeIndexes))
intReplaceRaw(array<int> dst, array<int> src) =>
    array.clear(dst)
    array.concat(dst, src)
boolReplaceRaw(array<bool> dst, array<bool> src) =>
    array.clear(dst)
    array.concat(dst, src)
// Commit step 1: the real pool (same array objects) takes the planned pool contents.
pendingReplaceRaw(PendingTopologyStore dst, PendingTopologyStore src) =>
    boolReplaceRaw(dst.corePendingTopologyFlags, src.corePendingTopologyFlags)
    intReplaceRaw(dst.corePendingTopologyChildHeadIndexes, src.corePendingTopologyChildHeadIndexes)
    intReplaceRaw(dst.corePendingTopologyChildTailIndexes, src.corePendingTopologyChildTailIndexes)
    intReplaceRaw(dst.corePendingTopologyChildCounts, src.corePendingTopologyChildCounts)
    intReplaceRaw(dst.pendingTopologyChildNextIndexes, src.pendingTopologyChildNextIndexes)
    intReplaceRaw(dst.pendingTopologyChildOwnerCoreSlots, src.pendingTopologyChildOwnerCoreSlots)
    intReplaceRaw(dst.pendingTopologyChildExpectedCoreIds, src.pendingTopologyChildExpectedCoreIds)
    intReplaceRaw(dst.pendingTopologyChildExpectedGenerationIds, src.pendingTopologyChildExpectedGenerationIds)
    intReplaceRaw(dst.pendingTopologyChildRootHeadNodeIndexes, src.pendingTopologyChildRootHeadNodeIndexes)
    intReplaceRaw(dst.pendingTopologyChildRootTailNodeIndexes, src.pendingTopologyChildRootTailNodeIndexes)
    intReplaceRaw(dst.pendingTopologyChildRootCounts, src.pendingTopologyChildRootCounts)
    boolReplaceRaw(dst.pendingTopologyChildLiveFlags, src.pendingTopologyChildLiveFlags)
    intReplaceRaw(dst.pendingTopologyChildFreeIndexes, src.pendingTopologyChildFreeIndexes)
    intReplaceRaw(dst.pendingTopologyRootNodeRootIds, src.pendingTopologyRootNodeRootIds)
    intReplaceRaw(dst.pendingTopologyRootNodeNextIndexes, src.pendingTopologyRootNodeNextIndexes)
    intReplaceRaw(dst.pendingTopologyRootNodeOwnerChildIndexes, src.pendingTopologyRootNodeOwnerChildIndexes)
    intReplaceRaw(dst.pendingTopologyRootNodeExpectedCoreIds, src.pendingTopologyRootNodeExpectedCoreIds)
    intReplaceRaw(dst.pendingTopologyRootNodeExpectedGenerationIds, src.pendingTopologyRootNodeExpectedGenerationIds)
    boolReplaceRaw(dst.pendingTopologyRootNodeLiveFlags, src.pendingTopologyRootNodeLiveFlags)
    intReplaceRaw(dst.pendingTopologyRootNodeFreeIndexes, src.pendingTopologyRootNodeFreeIndexes)
// W08 B15-B2: free preflight of one EXPLICIT_MERGE_ABSORBED old Core, read-only (the coreFreeSlotRaw preflight without the
// per-free global pending pool scan, which the pass F0 runs once): live slot with the expected coreId / generationId,
// live-list / ID-order / ID-map entries, Phase set membership of both Sides, participation detach ready,
// coreIndexCanRelease, the pending chain of the slot (per-Core chain check only).
coreFreePreflightRaw(ShadowContext ctx, PendingTopologyStore ps, int coreSlot, int expectedCoreId, int expectedGenerationId) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    bool ok = expectedCoreId != ID_NONE and coreSlot >= 0 and coreSlot < array.size(cr.coreIds) and coreSlot < array.size(cr.coreSlotLiveFlags) and coreSlot < array.size(cr.coreGenerationIds) and coreSlot < array.size(ps.corePendingTopologyFlags)
    if ok
        ok := array.get(cr.coreSlotLiveFlags, coreSlot) and array.get(cr.coreIds, coreSlot) == expectedCoreId and array.get(cr.coreGenerationIds, coreSlot) == expectedGenerationId and map.contains(cr.coreIdToSlot, expectedCoreId)
    if ok
        ok := map.get(cr.coreIdToSlot, expectedCoreId) == coreSlot and array.includes(cr.coreLiveSlots, coreSlot) and array.includes(cr.coreIdOrderSlots, coreSlot) and phaseSetMembershipValidRaw(ctx, coreSlot * 2) and phaseSetMembershipValidRaw(ctx, coreSlot * 2 + 1)
    if ok
        [partReady, partCoreId, partTargets] = participationDetachAllReadyRaw(ctx, coreSlot)
        ok := partReady and partCoreId == expectedCoreId and coreIndexCanRelease(ctx.ws, coreSlot, expectedCoreId)
    if ok
        [cOk, cRows, rRows] = pendingChainOkRaw(ps, coreSlot, expectedCoreId, expectedGenerationId)
        ok := cOk
    ok
// Free commit (after coreFreePreflightRaw): the coreFreeSlotRaw apply - participation, Worker origin / interval / inverse
// entries, pending chain (commit-only), Phase sets, live list (swap-remove) / ID order (shift) / ID map, reset, free stack.
// No business failure: a step reporting false is an invariant break (runtime.error).
coreFreeCommitRaw(ShadowContext ctx, PendingTopologyStore ps, int coreSlot) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    int oldCoreId  = array.get(cr.coreIds, coreSlot)
    int livePos    = array.indexof(cr.coreLiveSlots, coreSlot)
    int idOrderPos = array.indexof(cr.coreIdOrderSlots, coreSlot)
    if livePos < 0 or idOrderPos < 0 or not (participationDetachAllForCoreRaw(ctx, coreSlot) and coreIndexRelease(ctx.ws, coreSlot, oldCoreId))
        runtime.error("W08 B15-B2: core free commit broke its preflight")
    pendingClearChainRaw(ps, coreSlot)
    phaseSetDetachRaw(ctx, coreSlot * 2)
    phaseSetDetachRaw(ctx, coreSlot * 2 + 1)
    int lastPos = array.size(cr.coreLiveSlots) - 1
    if livePos != lastPos
        array.set(cr.coreLiveSlots, livePos, array.get(cr.coreLiveSlots, lastPos))
    array.pop(cr.coreLiveSlots)
    int idSize = array.size(cr.coreIdOrderSlots)
    int j = idOrderPos
    while j < idSize - 1
        array.set(cr.coreIdOrderSlots, j, array.get(cr.coreIdOrderSlots, j + 1))
        j += 1
    array.pop(cr.coreIdOrderSlots)
    map.remove(cr.coreIdToSlot, oldCoreId)
    coreResetSlotRaw(ctx, coreSlot)
    array.push(cr.coreFreeSlots, coreSlot)
    true
// W08 B15-B3: W06 dependency snapshot of the committed Core state: live Core IDs with their canonical bottom / top ticks (na ->
// DEP_TICK_NA), the live participation (coreId, rootId) pairs and the live PendingTopology Root node (coreId, rootId) pairs.
// Read-only.
depSnapshotRaw(ShadowContext ctx, PendingTopologyStore ps) =>
    CoreRegistryStore cr = ctx.ws.coreRegistry
    map<int, int> bt = map.new<int, int>()
    map<int, int> tt = map.new<int, int>()
    array<int> pc = array.new_int(0)
    array<int> pr = array.new_int(0)
    array<int> qc = array.new_int(0)
    array<int> qr = array.new_int(0)
    int s = 0
    while s < array.size(cr.coreIds) and s < array.size(cr.coreSlotLiveFlags) and s < array.size(cr.corePhysicalBottoms) and s < array.size(cr.corePhysicalTops)
        int id = array.get(cr.coreIds, s)
        if array.get(cr.coreSlotLiveFlags, s) and id != ID_NONE
            float b = array.get(cr.corePhysicalBottoms, s)
            float t = array.get(cr.corePhysicalTops, s)
            map.put(bt, id, na(b) ? DEP_TICK_NA : int(math.round(b / ctx.mintick)))
            map.put(tt, id, na(t) ? DEP_TICK_NA : int(math.round(t / ctx.mintick)))
        s += 1
    int e = 0
    while e < array.size(ctx.pv.participationEdgeLiveFlags) and e < array.size(ctx.pv.participationEdgeExpectedCoreIds) and e < array.size(ctx.pv.participationEdgeExpectedRootIds)
        if array.get(ctx.pv.participationEdgeLiveFlags, e)
            array.push(pc, array.get(ctx.pv.participationEdgeExpectedCoreIds, e))
            array.push(pr, array.get(ctx.pv.participationEdgeExpectedRootIds, e))
        e += 1
    int rn = 0
    while rn < array.size(ps.pendingTopologyRootNodeLiveFlags) and rn < array.size(ps.pendingTopologyRootNodeExpectedCoreIds) and rn < array.size(ps.pendingTopologyRootNodeRootIds)
        if array.get(ps.pendingTopologyRootNodeLiveFlags, rn)
            array.push(qc, array.get(ps.pendingTopologyRootNodeExpectedCoreIds, rn))
            array.push(qr, array.get(ps.pendingTopologyRootNodeRootIds, rn))
        rn += 1
    [bt, tt, pc, pr, qc, qr]
// I27-14: the W06 L7 neighborhood of one canonical Core tick range: the W06 /19 compPointRangeScanRaw(bottomTick - mTick,
// topTick + mTick) walk (rootPriceOrderSlots order, stop at the first tick above the bound, both bounds inclusive) with its
// capable PC predicate (compSideMaskRaw == 3: slot within the 9 Root arrays, live, rootId != 0, MA / Swing / Accum / TimeHL,
// ROOT_ACTIVE, pointTick not na). Skipped when a tick is na or bottomTick > topTick (the W06 Core expansion guard). Adds
// the rootIds to dep; returns the count added.
depL7ScanRaw(ShadowContext ctx, int bottomTick, int topTick, int mTick, map<int, bool> dep) =>
    RootView rv = ctx.rv
    int added = 0
    if bottomTick != DEP_TICK_NA and topTick != DEP_TICK_NA and bottomTick <= topTick
        int  lo   = bottomTick - mTick
        int  hi   = topTick + mTick
        bool done = false
        int  p    = 0
        while not done and p < array.size(rv.rootPriceOrderSlots)
            int slot = array.get(rv.rootPriceOrderSlots, p)
            if slot >= 0 and slot < array.size(rv.rootIds) and slot < array.size(rv.rootPointTicks)
                int tick = array.get(rv.rootPointTicks, slot)
                if not na(tick)
                    if tick > hi
                        done := true
                    else if tick >= lo and slot < array.size(rv.rootSlotLiveFlags) and slot < array.size(rv.rootCategories) and slot < array.size(rv.rootStates) and slot < array.size(rv.rootDirections) and slot < array.size(rv.rootNativeBottomTicks) and slot < array.size(rv.rootNativeTopTicks)
                        int category = array.get(rv.rootCategories, slot)
                        if array.get(rv.rootSlotLiveFlags, slot) and array.get(rv.rootIds, slot) != ID_NONE and (category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL) and array.get(rv.rootStates, slot) == ROOT_ACTIVE
                            map.put(dep, array.get(rv.rootIds, slot), true)
                            added += 1
            p += 1
    added
// Marks changed every Core of a (coreId, rootId) pair of A that B does not hold (pair key coreId * k + rootId).
depMarkMissingRaw(array<int> ac, array<int> ar, array<int> bc, array<int> br, int k, map<int, bool> changed) =>
    map<int, bool> inB = map.new<int, bool>()
    int i = 0
    while i < array.size(bc)
        map.put(inB, array.get(bc, i) * k + array.get(br, i), true)
        i += 1
    i := 0
    while i < array.size(ac)
        if not map.contains(inB, array.get(ac, i) * k + array.get(ar, i))
            map.put(changed, array.get(ac, i), true)
        i += 1
    true
// Adds the rootId (> 0) of every (coreId, rootId) pair of a changed Core to dep.
depCollectRaw(array<int> c, array<int> r, map<int, bool> changed, map<int, bool> dep) =>
    int i = 0
    while i < array.size(c)
        if map.contains(changed, array.get(c, i)) and array.get(r, i) > 0
            map.put(dep, array.get(r, i), true)
        i += 1
    true
sideActiveRaw(array<int> phases, int coreSlot) =>
    array.get(phases, coreSlot * 2) == PH_ACTIVE_TOUCH or array.get(phases, coreSlot * 2 + 1) == PH_ACTIVE_TOUCH
// W08 B15-B2: plan of one shadow pass. The global pending pool integrity scan runs once on a scratch copy of the pending
// pool, then the chain runs once (buildChangedTopologyPlanRaw; computed pairing -> physical -> Identity -> ownership ->
// Merge -> Split -> Merge Touch -> Split Touch -> Pending -> Changed, each build once) on that copy with the B13 / B14
// planners trusting the scan; nothing persistent is written (Core registry, participation, Phase sets, origin / interval / inverse index, ring,
// pending pool, scalars). Then the apply set: a changed component is pending when one of its old Cores has a Side in
// ActiveTouch (B13 unit), else applied; applied Candidates = the changedTargets rows of applied components (an unchanged
// component is never planned for apply); the applied Merge target / SPLIT_LOCAL row of each applied Candidate (at most one
// Touch source each); the consumed READY pending parents (old Cores of applied components still pending in the planned
// pool); the EXPLICIT_MERGE_ABSORBED old Cores of applied Merge relations that no applied Candidate continues (canonical
// relation / absorbed order, unique);
// the retained no-successor count and the B14 invalidation flag counts of the applied Candidates.
// W09 B07-R1 (/15): planPassWithActiveTouchOverlay takes the projected Active override: an entry e >= 0 is FORCE_ACTIVE of
// Side slot e, an entry e < 0 is FORCE_INACTIVE of Side slot -(e + 1), a Side without an entry keeps its actual Phase
// (NO_OVERRIDE). A na entry, a decoded slot out of range or a decoded slot listed twice (either encoding) fails the plan.
// No other change (/14 was the superseded B07 overflow build; its overlay had no duplicate check).
// W09 B06-B2C-C2 (/13): coreDeferredStateRaw keeps the same reset rows (write = true, 145) and runs the Side rows once
// per Side slot (loop); MERGE_STATE_DEFAULT_GUARD releases the Touch history (sideTouchCounts, sideWeakByTouchFlags,
// sideWeakByDepthFlags, sideMaxDepthPcts, sideCurrentTouchNos, sideLastNormalTouchTimes) and the TouchStartSnapshot (18
// scalars, Root list metadata 3): the W09 Merge / Split Touch history transfer and completed-TSS clear own them (guard
// 52 fields / 100 rows -> 25 / 46). The other guard fields are unchanged.
// W09 C1 token repair (/12): coreAllocSlotRaw pushes the per-Side default rows through one Support / Resistance loop
// (the two former literal blocks held the same 80 (array, default) pairs; each Side array still gets two identical
// default pushes). No other change.
// W09 B06-B2C-C1 (/11): W08Core /18 / W08Touch /4 (11-field TouchMark): coreAlloc pushes the 3 Episode rows per ring slot
// (defaults 0 / false / 0.0), touchRingViewRaw passes them. No planner / commit semantics change.
// W09 B06-B2C-B (/10): the planner body with a current-bar ActiveTouch overlay (Side slots about to start a Touch this
// bar). A Side counts as ActiveTouch in the "component with an ActiveTouch old Side -> Pending" predicate (B13 pending
// plan, B14 changed plan, apply set) when it is persistent ActiveTouch or in the overlay; nothing else reads the overlay
// (pairing / Identity / winners / Merge / Split relations / TouchMark extraction / Fresh / ownership / IDs / order read
// the persistent state). Empty overlay: the persistent sidePhases array itself (planPass). An overlay slot out of range
// fails the plan (planResult -1). No persistent write. (/15: projected Active override, see the B07-R1 note above.)
export planPassWithActiveTouchOverlay(ShadowContext ctx, array<int> activeTouchOverlaySideSlots) =>
    CoreRegistryStore cr0 = ctx.ws.coreRegistry
    bool ovOk = true
    array<int> phases = cr0.sidePhases
    if array.size(activeTouchOverlaySideSlots) > 0
        phases := array.copy(cr0.sidePhases)
        int o = 0
        while ovOk and o < array.size(activeTouchOverlaySideSlots)
            int ss = array.get(activeTouchOverlaySideSlots, o)
            int sl = na(ss) ? -1 : ss >= 0 ? ss : -(ss + 1)
            ovOk := sl >= 0 and sl < array.size(phases)
            int q = 0
            while ovOk and q < o
                int sq = array.get(activeTouchOverlaySideSlots, q)
                ovOk := (sq >= 0 ? sq : -(sq + 1)) != sl
                q += 1
            if ovOk
                array.set(phases, sl, ss >= 0 ? PH_ACTIVE_TOUCH : PH_WAITING)
            o += 1
    ctx.psPlan := pendingCopyRaw(ctx.ps)
    ctx.sc.rangeChanged := false
    // the pass's only global pending pool integrity scan (free lists included), on the scratch pool before the chain; the
    // B13 / B14 planners of this pass take it as their trusted precondition
    ctx.pendingPoolTrusted := pendingPoolsOkRaw(ctx.psPlan)
    int c = -1
    if ctx.pendingPoolTrusted and ovOk
        c := buildChangedTopologyPlanRaw(ctx, phases)
    W08Store          ws = ctx.ws
    CoreRegistryStore cr = ws.coreRegistry
    int  n  = ws.physicalCandidateLogicalCount
    int  nt = int(array.size(ws.changedTargets) / 5)
    int  no = int(array.size(ws.changedOldCores) / 2)
    bool ok = c >= 0 and n >= 0 and array.size(ws.changedTargets) == 5 * nt and array.size(ws.changedOldCores) == 2 * no
    ShadowPass pr = ShadowPass.new(applyComp = array.new_bool(ok ? c : 0, true), applyP = array.new_bool(ok ? n : 0, false), mergeOfP = array.new_int(ok ? n : 0, -1), splitOfP = array.new_int(ok ? n : 0, -1), consumedSlots = array.new_int(0), freeSlots = array.new_int(0), freeCoreIds = array.new_int(0), freeGenerationIds = array.new_int(0), dependencyChangedRootIds = array.new_int(0))
    pr.poolScans := 1
    int i = 0
    while ok and i < no
        int slot = array.get(ws.changedOldCores, 2 * i)
        int comp = array.get(ws.changedOldCores, 2 * i + 1)
        ok := comp >= 0 and comp < c and slot >= 0 and 2 * slot + 1 < array.size(cr.sidePhases)
        if ok
            if sideActiveRaw(phases, slot)
                array.set(pr.applyComp, comp, false)
        i += 1
    int k = 0
    while ok and k < c
        if array.get(pr.applyComp, k)
            pr.appliedComponents := pr.appliedComponents + 1
        else
            pr.pendingComponents := pr.pendingComponents + 1
        k += 1
    array<bool> contOld = array.new_bool(ok ? array.size(cr.coreIds) : 0, false)
    i := 0
    while ok and i < nt
        int p     = array.get(ws.changedTargets, 5 * i)
        int comp  = array.get(ws.changedTargets, 5 * i + 1)
        int flags = array.get(ws.changedTargets, 5 * i + 4)
        ok := p >= 0 and p < n and comp >= 0 and comp < c
        if ok and array.get(pr.applyComp, comp)
            ok := not array.get(pr.applyP, p)
            array.set(pr.applyP, p, true)
            pr.appliedTargets := pr.appliedTargets + 1
            pr.invRange  := pr.invRange + int(flags / 1) % 2
            pr.invTick   := pr.invTick + int(flags / 2) % 2
            pr.invOrigin := pr.invOrigin + int(flags / 4) % 2
            pr.invPass1  := pr.invPass1 + int(flags / 8) % 2
            pr.invPair   := pr.invPair + int(flags / 16) % 2
            if ok and array.get(ws.physicalOwnershipKinds, p) == 0
                int os = array.get(ws.physicalContinuationOldCoreSlots, p)
                ok := os >= 0 and os < array.size(contOld)
                if ok
                    array.set(contOld, os, true)
        i += 1
    int m = ws.mergeRelationCount
    ok := ok and array.size(ws.mergeRelations) == 5 * m
    int j = 0
    while ok and j < m
        int p = array.get(ws.mergeRelations, 5 * j)
        ok := p >= 0 and p < n
        if ok and array.get(pr.applyP, p)
            ok := array.get(pr.mergeOfP, p) == -1
            array.set(pr.mergeOfP, p, j)
        j += 1
    k := 0
    while ok and k < array.size(ctx.sp.targetPhysicalIndexes)
        int p = array.get(ctx.sp.targetPhysicalIndexes, k)
        ok := p >= 0 and p < n
        if ok and array.get(pr.applyP, p)
            ok := array.get(pr.splitOfP, p) == -1 and array.get(pr.mergeOfP, p) == -1
            array.set(pr.splitOfP, p, k)
        k += 1
    // absorbed olds of applied Merge relations (EXPLICIT_MERGE_ABSORBED), canonical and unique
    map<int, bool> absorbed = map.new<int, bool>()
    j := 0
    while ok and j < m
        int p = array.get(ws.mergeRelations, 5 * j)
        if array.get(pr.applyP, p)
            int off = array.get(ws.mergeRelations, 5 * j + 3)
            int cnt = array.get(ws.mergeRelations, 5 * j + 4)
            ok := off >= 0 and cnt >= 1 and 2 * (off + cnt) <= array.size(ws.mergeAbsorbed)
            int s = 0
            while ok and s < cnt
                int slot = array.get(ws.mergeAbsorbed, 2 * (off + s))
                int id   = array.get(ws.mergeAbsorbed, 2 * (off + s) + 1)
                ok := slot >= 0 and slot < array.size(cr.coreIds) and slot < array.size(cr.coreGenerationIds) and slot < array.size(contOld)
                // an absorbed old that an applied Candidate continues (Merge / Split coexisting) keeps living there: it
                // has a post-commit reference, so it is not freed (I27-11 condition 5)
                if ok and not map.contains(absorbed, slot) and not array.get(contOld, slot)
                    map.put(absorbed, slot, true)
                    array.push(pr.freeSlots, slot)
                    array.push(pr.freeCoreIds, id)
                    array.push(pr.freeGenerationIds, array.get(cr.coreGenerationIds, slot))
                s += 1
        j += 1
    // consumed READY parents and retained no-successor olds of applied components
    i := 0
    while ok and i < no

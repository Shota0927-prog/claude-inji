//@version=6
// ============================================================
// ZoneEngineV2_W08Runtime_Worker - W08 runtime orchestration worker
//
// Future home (B15-B1 onward) of the W08 confirmed-5m pass orchestration: moved identity gather, pairing collection,
// chain orchestration, pass F0 and commit orchestration. Storage primitives stay in W08Core (registry, alloc / reset /
// free, origin / interval / inverse, physical / Identity / Merge / Split / Pending / Changed) and W08Touch (ring, plans,
// ring apply). It never imports the Main library; it imports W08Core and W08Touch only (no cycle).
//
// B15-B0: type / reference probe only. The exports below take the real B15 UDTs (W08Core.W08Store,
// W08Core.PendingTopologyStore, W08Touch.TouchRing / TouchPlan / SplitTouchPlan) and mutate through the array
// references they carry, so a harness can prove that a cross-library UDT argument compiles and that every write is
// visible to the caller (no copy). No production caller.
// ============================================================
library("ZoneEngineV2_W08Runtime_Worker", overlay = false)

import sekine3310/ZoneEngineV2_W08Core_Worker/15 as W08Core
import sekine3310/ZoneEngineV2_W08Touch_Worker/2 as W08Touch

// Bare array argument: writes values[index] := value, returns the previous value.
export probeArrayWrite(array<int> values, int index, int value) =>
    int prev = array.get(values, index)
    array.set(values, index, value)
    prev

// Array held inside a UDT: writes store.changedTargets[index] := value through a local alias of the field and bumps the
// scalar field changedComponentCount. Returns the new changedComponentCount.
export probeStoreWrite(W08Core.W08Store store, int index, int value) =>
    array<int> targets = store.changedTargets
    array.set(targets, index, value)
    store.changedComponentCount := store.changedComponentCount + 1
    store.changedComponentCount

// Worker-to-worker hand-off of a caller-built PendingTopologyStore: W08Core.pendingClearCore on it.
export probePendingClear(W08Core.PendingTopologyStore ps, int coreSlot, int coreId, int generationId) =>
    W08Core.pendingClearCore(ps, coreSlot, coreId, generationId)

// Worker-to-worker hand-off of a caller-built TouchRing: W08Touch.markAppend on it. Returns the written physical row.
export probeTouchAppend(W08Touch.TouchRing ring, int coreSlot, int baseSeq, int touchTime, int side, float contactBottom, float contactTop, float closeAtTouch, int generationId) =>
    W08Touch.markAppend(ring, coreSlot, baseSeq, touchTime, side, contactBottom, contactTop, closeAtTouch, generationId, true)

// Arrays held inside the two Touch plan UDTs: pushes value to plan.mergeTouchPlanOffsets and
// splitPlan.targetPhysicalIndexes. Returns the sum of both sizes.
export probeTouchPlanWrite(W08Touch.TouchPlan plan, W08Touch.SplitTouchPlan splitPlan, int value) =>
    array.push(plan.mergeTouchPlanOffsets, value)
    array.push(splitPlan.targetPhysicalIndexes, value)
    array.size(plan.mergeTouchPlanOffsets) + array.size(splitPlan.targetPhysicalIndexes)

    intReplaceRaw(dst.pendingTopologyChildRootTailNodeIndexes, src.pendingTopologyChildRootTailNodeIndexes)
    intReplaceRaw(dst.pendingTopologyChildRootCounts, src.pendingTopologyChildRootCounts)

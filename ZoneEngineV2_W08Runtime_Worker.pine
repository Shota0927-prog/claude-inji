        int comp = array.get(ws.changedOldCores, 2 * i + 1)
        if array.get(pr.applyComp, comp)
            ok := slot < array.size(ctx.psPlan.corePendingTopologyFlags) and slot < array.size(contOld)
            if ok and array.get(ctx.psPlan.corePendingTopologyFlags, slot)
                array.push(pr.consumedSlots, slot)
            if ok and not array.get(contOld, slot) and not map.contains(absorbed, slot)
                pr.retained := pr.retained + 1
        i += 1
    pr.planResult := ok ? c : -1
    pr
// W08 B15-B2: pass F0, read-only on the persistent state. Checks: plan result and the pass's single global pending pool
// integrity scan (done once by planPass before the chain; nothing here rescans the free lists; per-Core checks below are
// chain-only); the materialization of the applied Candidates (B07-D
// F0 predicates, applied fresh ranks); the Touch plan rows of every applied Merge target / SPLIT_LOCAL row (W08Touch
// preflight); the consumed READY pending chains; per absorbed old Core: no applied Candidate continues it (no
// post-commit reference), MERGE_STATE_DEFAULT_GUARD (every Merge-deferred field at its reset default, else the pass is
// rejected), coreFreePreflightRaw. Returns ok and stores it in pass.preflightOk.
export preflightPass(ShadowContext ctx, ShadowPass pr, int materializeBaseCloseTime) =>
    W08Store          ws = ctx.ws
    CoreRegistryStore cr = ws.coreRegistry
    int  n  = ws.physicalCandidateLogicalCount
    bool ok = pr.planResult >= 0 and array.size(pr.applyP) == n and array.size(ctx.tp.mergeTouchPlanOffsets) == 2 * ws.mergeRelationCount
    // the global pool integrity was scanned once by planPass (the trusted precondition of this pass); F0 re-checks per
    // Core chains only
    ok := ok and ctx.pendingPoolTrusted and pr.poolScans == 1
    if ok
        ok := materializeAppliedRaw(ctx, pr.applyP, materializeBaseCloseTime, false) >= 0
    TouchRing ring = touchRingViewRaw(ctx)
    int p = 0
    while ok and p < n
        if array.get(pr.mergeOfP, p) >= 0
            ok := mergeApplyPreflight(ring, ctx.tp, array.get(pr.mergeOfP, p))
        else if array.get(pr.splitOfP, p) >= 0
            ok := splitApplyPreflight(ring, ctx.sp, array.get(pr.splitOfP, p))
        p += 1
    int i = 0
    while ok and i < array.size(pr.consumedSlots)
        int slot = array.get(pr.consumedSlots, i)
        ok := slot < array.size(cr.coreIds) and slot < array.size(cr.coreGenerationIds)
        if ok
            [cOk, cRows, rRows] = pendingChainOkRaw(ctx.psPlan, slot, array.get(cr.coreIds, slot), array.get(cr.coreGenerationIds, slot))
            ok := cOk
        i += 1
    i := 0
    while ok and i < array.size(pr.freeSlots)
        int slot = array.get(pr.freeSlots, i)
        p := 0
        while ok and p < n
            if array.get(pr.applyP, p) and array.get(ws.physicalOwnershipKinds, p) == 0
                ok := array.get(ws.physicalContinuationOldCoreSlots, p) != slot
            p += 1
        if ok
            ok := slot < array.size(cr.coreIds) and array.get(cr.coreSlotLiveFlags, slot)
        if ok
            ok := coreDeferredStateRaw(cr, slot, false)
            if not ok
                pr.guardRejected := pr.guardRejected + 1
        if ok
            ok := coreFreePreflightRaw(ctx, ctx.psPlan, slot, array.get(pr.freeCoreIds, i), array.get(pr.freeGenerationIds, i))
        i += 1
    pr.preflightOk := ok
    ok
// W08 B15-B2: commit of a pass whose preflightPass passed (else runtime.error, nothing written). Order: 1 pending replace
// (the planned pool), 2 materialization of the applied Candidates, 3 TouchMark ring replacement of every applied Merge
// target / SPLIT_LOCAL row, 4 (index: in 2), 5 invalidation counts (pass.inv*), 6 consumed READY pending clear, 7 absorbed
// free, 8 range revision (once). Every step was proven by the F0; a step reporting a fault is an invariant break
// (runtime.error). Scalar results (nextCoreId / nextGenerationId / coreRangeRevision) stay in ctx.sc for the caller.
export commitPass(ShadowContext ctx, ShadowPass pr, int materializeBaseCloseTime) =>
    if not pr.preflightOk or pr.committed
        runtime.error("W08 B15-B2: commitPass without a passed preflightPass")
    W08Store ws = ctx.ws
    CoreRegistryStore cr = ws.coreRegistry
    int n = ws.physicalCandidateLogicalCount
    // B15-B3: W06 dependency snapshot before step 1, and the pre-commit origin of every Core the commit can change
    // (continued, freed, consumed READY, pending in the current or the planned pool)
    [bt0, tt0, pc0, pr0, qc0, qr0] = depSnapshotRaw(ctx, ctx.ps)
    array<int> oc0 = array.new_int(0)
    array<int> or0 = array.new_int(0)
    array<int> orig = array.new_int(0)
    array<bool> candSlot = array.new_bool(array.size(cr.coreIds), false)
    int p = 0
    while p < n
        if array.get(pr.applyP, p) and array.get(ws.physicalOwnershipKinds, p) == 0
            array.set(candSlot, array.get(ws.physicalContinuationOldCoreSlots, p), true)
        p += 1
    int i = 0
    while i < array.size(pr.freeSlots)
        array.set(candSlot, array.get(pr.freeSlots, i), true)
        i += 1
    i := 0
    while i < array.size(pr.consumedSlots)
        array.set(candSlot, array.get(pr.consumedSlots, i), true)
        i += 1
    int cs = 0
    while cs < array.size(cr.coreIds)
        bool cand = array.get(candSlot, cs)
        if not cand and cs < array.size(ctx.ps.corePendingTopologyFlags)
            cand := array.get(ctx.ps.corePendingTopologyFlags, cs)
        if not cand and cs < array.size(ctx.psPlan.corePendingTopologyFlags)
            cand := array.get(ctx.psPlan.corePendingTopologyFlags, cs)
        if cand and array.get(cr.coreSlotLiveFlags, cs)
            int cid = array.get(cr.coreIds, cs)
            if originReadAsc(ws, cs, cid, orig) >= 0
                int j = 0
                while j < array.size(orig)
                    array.push(oc0, cid)
                    array.push(or0, array.get(orig, j))
                    j += 1
        cs += 1
    pendingReplaceRaw(ctx.ps, ctx.psPlan)
    int fa = materializeAppliedRaw(ctx, pr.applyP, materializeBaseCloseTime, true)
    if fa < 0
        runtime.error("W08 B15-B2: materialization broke the pr preflight")
    pr.freshApplied := fa
    TouchRing ring = touchRingViewRaw(ctx)
    p := 0
    while p < n
        int rows = 0
        if array.get(pr.mergeOfP, p) >= 0
            rows := mergeApplyCommit(ring, ctx.tp, array.get(pr.mergeOfP, p), array.get(ws.physicalMaterializedCoreSlots, p), array.get(ws.physicalMaterializedCoreIds, p))
        else if array.get(pr.splitOfP, p) >= 0
            rows := splitApplyCommit(ring, ctx.sp, array.get(pr.splitOfP, p), array.get(ws.physicalMaterializedCoreSlots, p), array.get(ws.physicalMaterializedCoreIds, p))
        if rows < 0
            runtime.error("W08 B15-B2: TouchMark apply broke the pr preflight")
        pr.touchRowsWritten := pr.touchRowsWritten + rows
        p += 1
    i := 0
    while i < array.size(pr.consumedSlots)
        pendingClearChainRaw(ctx.ps, array.get(pr.consumedSlots, i))
        i += 1
    i := 0
    while i < array.size(pr.freeSlots)
        coreFreeCommitRaw(ctx, ctx.ps, array.get(pr.freeSlots, i))
        pr.freed := pr.freed + 1
        i += 1
    if ctx.sc.rangeChanged
        ctx.sc.coreRangeRevision := ctx.sc.coreRangeRevision + 1
        ctx.sc.rangeChanged := false
    // B15-B3: W06 dependency carry = the old and new participation / origin / pending Roots of every Core whose L6 / L7 /
    // L8 snapshot changed
    [bt1, tt1, pc1, pr1, qc1, qr1] = depSnapshotRaw(ctx, ctx.ps)
    int k = math.max(ctx.sc.nextRootId, 1) + 1
    map<int, bool> changed = map.new<int, bool>()
    array<int> ids0 = map.keys(bt0)
    i := 0
    while i < array.size(ids0)
        int id = array.get(ids0, i)
        if not map.contains(bt1, id)
            map.put(changed, id, true)
        else if map.get(bt1, id) != map.get(bt0, id) or map.get(tt1, id) != map.get(tt0, id)
            map.put(changed, id, true)
        i += 1
    array<int> ids1 = map.keys(bt1)
    i := 0
    while i < array.size(ids1)
        if not map.contains(bt0, array.get(ids1, i))
            map.put(changed, array.get(ids1, i), true)
        i += 1
    depMarkMissingRaw(pc0, pr0, pc1, pr1, k, changed)
    depMarkMissingRaw(pc1, pr1, pc0, pr0, k, changed)
    depMarkMissingRaw(qc0, qr0, qc1, qr1, k, changed)
    depMarkMissingRaw(qc1, qr1, qc0, qr0, k, changed)
    map<int, bool> dep = map.new<int, bool>()
    depCollectRaw(pc0, pr0, changed, dep)
    depCollectRaw(pc1, pr1, changed, dep)
    depCollectRaw(qc0, qr0, changed, dep)
    depCollectRaw(qc1, qr1, changed, dep)
    depCollectRaw(oc0, or0, changed, dep)
    array<int> chIds = map.keys(changed)
    i := 0
    while i < array.size(chIds)
        int id = array.get(chIds, i)
        if map.contains(cr.coreIdToSlot, id)
            if originReadAsc(ws, map.get(cr.coreIdToSlot, id), id, orig) >= 0
                int j = 0
                while j < array.size(orig)
                    if array.get(orig, j) > 0
                        map.put(dep, array.get(orig, j), true)
                    j += 1
        i += 1
    // I27-14 L7: the PC neighborhood of the old range (free, tick change) and of the new range (alloc, tick change)
    int mTick = int(math.round(ctx.clusterMaxWidth / ctx.mintick))
    i := 0
    while i < array.size(chIds)
        int  id  = array.get(chIds, i)
        bool in0 = map.contains(bt0, id)
        bool in1 = map.contains(bt1, id)
        bool tickChanged = in0 and in1
        if tickChanged
            tickChanged := map.get(bt0, id) != map.get(bt1, id) or map.get(tt0, id) != map.get(tt1, id)
        if (in0 and not in1) or tickChanged
            depL7ScanRaw(ctx, map.get(bt0, id), map.get(tt0, id), mTick, dep)
        if (in1 and not in0) or tickChanged
            depL7ScanRaw(ctx, map.get(bt1, id), map.get(tt1, id), mTick, dep)
        i += 1
    array.clear(pr.dependencyChangedRootIds)
    array.concat(pr.dependencyChangedRootIds, map.keys(dep))
    array.sort(pr.dependencyChangedRootIds, order.ascending)
    ctx.pendingPoolTrusted := false
    pr.committed := true
    pr
// W08 B15-B3: W06 dependency carry helpers (the caller's persistent carry and seed arrays, by reference; no W06 import).
// dependencyCarryMerge: the committed pass's dependencyChangedRootIds joins the unconsumed carry (never overwritten):
// union, rootId ASC, unique; an empty input writes nothing. Returns the carry size.
export dependencyCarryMerge(array<int> carry, array<int> add) =>
    if array.size(add) > 0
        array.concat(carry, add)
        array.sort(carry, order.ascending)
        int i = array.size(carry) - 1
        while i > 0
            if array.get(carry, i) == array.get(carry, i - 1)
                array.remove(carry, i)
            i -= 1
    array.size(carry)
// dependencyCarryInject: every carry Root not already among the seeds 0 .. seedCount - 1 is appended as a dependency-only
// seed (reason mask 0; set within the physical size, push beyond); an existing seed keeps its mask (mask OR 0). The carry
// is never cleared here (the caller clears it after a W06 build that used it succeeded). Returns the new seed count.
export dependencyCarryInject(array<int> carry, array<int> seedRootIds, array<int> seedReasonMasks, int seedCount) =>
    int n = seedCount
    int i = 0
    while i < array.size(carry)
        int  id    = array.get(carry, i)
        bool found = false
        int  j     = 0
        while not found and j < n
            found := array.get(seedRootIds, j) == id
            j += 1
        if not found
            if n < array.size(seedRootIds)
                array.set(seedRootIds, n, id)
            else
                array.push(seedRootIds, id)
            if n < array.size(seedReasonMasks)
                array.set(seedReasonMasks, n, 0)
            else
                array.push(seedReasonMasks, 0)
            n += 1
        i += 1
    n

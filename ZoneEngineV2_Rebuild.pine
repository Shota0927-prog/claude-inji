    int   cCount        = 0
    int   hCount        = 0
    int   density       = 1
    int   touchStartGrade = 1
    int   currentTouchNo  = 0
    int   approachSide    = 0
    int   startSeq        = 0
    int   startTime       = na
    float deepestClose    = na
    float maxDepthPct     = 0.0


        ok := oldState == ROOT_ACTIVE and newState == ROOT_INVALIDATED
    // Step 3
    // the target FVG Root: ownership, logical identity and every index it must hold
    if ok
        ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootLastUpdateSeqs) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions) and rootSlot < array.size(engine.rootFvgNativeBottomOrderPositions) and rootSlot < array.size(engine.rootFvgNativeTopOrderPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        int bottomTick = array.get(engine.rootNativeBottomTicks, rootSlot)
        int topTick    = array.get(engine.rootNativeTopTicks,    rootSlot)
        ok := array.get(engine.rootCategories, rootSlot) == CAT_FVG and array.get(engine.rootTfCodes, rootSlot) == tfCode and array.get(engine.rootOriginKeys, rootSlot) == originKey and array.get(engine.rootSubtypes, rootSlot) == subtype and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == direction and array.get(engine.rootIsRangeRootFlags, rootSlot) and not array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootLabelMasks, rootSlot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, rootSlot) == SWING_TF_MASK_NONE and na(array.get(engine.rootPointPrices, rootSlot)) and not na(array.get(engine.rootNativeBottoms, rootSlot)) and not na(array.get(engine.rootNativeTops, rootSlot)) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick and array.get(engine.rootPriceOrderPositions, rootSlot) == SLOT_INVALID
    if ok
        int bottomPos = array.get(engine.rootFvgNativeBottomOrderPositions, rootSlot)
        int topPos    = array.get(engine.rootFvgNativeTopOrderPositions,    rootSlot)
        ok := bottomPos >= 0 and topPos >= 0 and bottomPos < array.size(engine.fvgNativeBottomOrderRootSlots) and topPos < array.size(engine.fvgNativeTopOrderRootSlots)
        if ok
            ok := array.get(engine.fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(engine.fvgNativeTopOrderRootSlots, topPos) == rootSlot
    if ok
        ok := rootSetMembershipValidRaw(engine, rootSlot)
    if ok
        ok := fvgSetMembershipValidRaw(engine, rootSlot, expectedRootId)
    // Step 4 : ACTIVE now; the journal carries the current Fresh and Broad snapshots
    if ok
        ok := array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and array.get(engine.rootFvgFreshFlags, rootSlot) == fvgFresh and array.get(engine.rootIsBroadFvgFlags, rootSlot) == isBroad
    // Step 5 : commit. Structural set, then state set, then the logical state.
    bool structuralDetached = false
    bool stateMoved         = false
    if ok
        structuralDetached := fvgStructuralActiveSetDetachRaw(engine, rootSlot, expectedRootId)
        stateMoved         := rootStateSetMoveRaw(engine, rootSlot, expectedRootId, ROOT_ACTIVE, ROOT_INVALIDATED)
        if structuralDetached and stateMoved
            array.set(engine.rootStates, rootSlot, ROOT_INVALIDATED)
    structuralDetached and stateMoved

// ============================================================
// W03 Batch 18A : Stage F virtual preflight (F0)
// Source: I8 (Stage F / F0), I10, I11-1 .. I11-6, A7.2 - A7.6, D12
//
// Internal only and fully READ-ONLY: no Root, index, map, journal, revision or
// scalar is written, and no shadow Engine, clone, scratch or pending array / map is
// created. The journal itself is the virtual transition log: the state a row sees
// in F1 - F4 is the committed state plus every row applied before it in the
// canonical order (group E1 -> E4, append order inside a group).
// w03StageFPreflightRaw proves, for the whole journal, every failure path of
// newRootApplyRaw, maUpdateApplyRaw, swingTfMergeApplyRaw, timeHlLabelApplyRaw,
// rootRetireApplyRaw, fvgFreshEndApplyRaw and fvgInvalidateApplyRaw (including the
// index helpers they call) before F1 writes anything; any failure raises
// runtime.error("W03_JOURNAL_PREFLIGHT"). Same-bar chains on one Root (INVALIDATE ->
// FRESH_END, LABEL -> RETIRE, several MERGE / LABEL, Accum Upper -> Lower mate,
// E2 inserts -> E3 MA moves) are read through the virtual helpers below.
// Path B: a FRESH_END row for an FVG created on the same bar carries SLOT_INVALID /
// ID_NONE and is matched to exactly one NEW_ROOT FVG row by (Category, TF,
// Direction, originTime); B18B copies that row's written-back target into it.
// Business call sites = 0 in this Batch (F1 - F6 wiring is B18B / B18C).
// ============================================================

// true when journal row rowA is applied before row rowB in Stage F: a lower group,
// or the same group and an earlier append. Read-only. Both rows are logical rows.
journalAppliedBeforeRaw(ZoneEngine engine, int rowA, int rowB) =>
    int groupA = array.get(engine.w03Store.journalGroups, rowA)
    int groupB = array.get(engine.w03Store.journalGroups, rowB)
    groupA < groupB or (groupA == groupB and rowA < rowB)

// The physical rootSlot rootAllocSlotRaw will return for NEW_ROOT row newRow in F2:
// the free stack is popped LIFO first, then the Root arrays grow. Derived from the
// number of NEW_ROOT rows applied before it. Read-only; SLOT_INVALID when newRow is
// not a NEW_ROOT row.
predictedNewRootSlotRaw(ZoneEngine engine, int newRow) =>
    int slot = SLOT_INVALID
    if array.get(engine.w03Store.journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < engine.w03Store.journalCount
            if row != newRow and array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(engine, row, newRow)
                rank += 1
            row += 1
        int freeSize = array.size(engine.rootFreeSlots)
        slot := rank < freeSize ? array.get(engine.rootFreeSlots, freeSize - 1 - rank) : array.size(engine.rootIds) + (rank - freeSize)
    slot

// The Root ID rootAllocSlotRaw will hand to NEW_ROOT row newRow in F2: F0 runs
// before any E2 alloc, so engine.nextRootId is this bar's first new Root ID and every
// NEW_ROOT applied before newRow takes exactly one. Read-only; ID_NONE when newRow is
// not a NEW_ROOT row.
predictedNewRootIdRaw(ZoneEngine engine, int newRow) =>
    int rootId = ID_NONE
    if array.get(engine.w03Store.journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < engine.w03Store.journalCount
            if row != newRow and array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(engine, row, newRow)
                rank += 1
            row += 1
        rootId := engine.nextRootId + rank
    rootId

// The NEW_ROOT rows applied before beforeRow whose predicted rootSlot and predicted
// Root ID are exactly (rootSlot, expectedRootId). Returns [matchRow, matchCount]:
// 0 = not a Root of this bar, 1 = that row creates it, 2+ = invariant failure.
// Read-only.
pendingNewRootRowByAddressRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    int matchRow   = SLOT_INVALID
    int matchCount = 0
    if rootSlot != SLOT_INVALID and expectedRootId != ID_NONE
        int row = 0
        while row < engine.w03Store.journalCount
            if row != beforeRow and array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(engine, row, beforeRow)
                if predictedNewRootSlotRaw(engine, row) == rootSlot and predictedNewRootIdRaw(engine, row) == expectedRootId
                    matchRow   := row
                    matchCount += 1
            row += 1
    [matchRow, matchCount]

// Path B: the NEW_ROOT FVG rows applied before FRESH_END row freshRow with the same
// FVG identity (Category, TF, Direction, originTime). Returns [matchRow, matchCount];
// matchRow is the last match or SLOT_INVALID. Read-only.
pendingNewFvgRowRaw(ZoneEngine engine, int freshRow) =>
    int matchRow   = SLOT_INVALID
    int matchCount = 0
    int tfCode     = array.get(engine.w03Store.journalTfCodes,     freshRow)
    int direction  = array.get(engine.w03Store.journalDirections,  freshRow)
    int originTime = array.get(engine.w03Store.journalOriginTimes, freshRow)
    int row = 0
    while row < engine.w03Store.journalCount
        if row != freshRow and array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, row) == CAT_FVG and journalAppliedBeforeRaw(engine, row, freshRow)
            if array.get(engine.w03Store.journalTfCodes, row) == tfCode and array.get(engine.w03Store.journalDirections, row) == direction and array.get(engine.w03Store.journalOriginTimes, row) == originTime
                matchRow   := row
                matchCount += 1
        row += 1
    [matchRow, matchCount]

// rootStates of a Root as row beforeRow will see it. Base: the committed state of a
// live Root owned by expectedRootId, else the newState of the one NEW_ROOT row of this
// bar that creates (rootSlot, expectedRootId). Then the newState of every
// FVG_INVALIDATE / ROOT_RETIRE row on the same Root applied after the base and before
// beforeRow, in Stage F order. Read-only. int(na) when neither base exists.
virtualRootStateBeforeRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    int  state    = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootStates)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
            state    := array.get(engine.rootStates, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            state    := array.get(engine.w03Store.journalNewStates, newRow)
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < engine.w03Store.journalCount
                if row != beforeRow and array.get(engine.w03Store.journalGroups, row) == group and journalAppliedBeforeRaw(engine, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(engine, baseRow, row)) and array.get(engine.w03Store.journalTargetRootSlots, row) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == expectedRootId
                    int op = array.get(engine.w03Store.journalOps, row)
                    if op == JOP_FVG_INVALIDATE or op == JOP_ROOT_RETIRE
                        state := array.get(engine.w03Store.journalNewStates, row)
                row += 1
            group += 1
    state

// rootSwingTfMasks of a Root as row beforeRow will see it. Base: the committed mask,
// else the pending NEW_ROOT row's newMask for a Swing (SWING_TF_MASK_NONE otherwise).
// Then the newMask of every later SWING_TF_MERGE row on the same Root applied before
// beforeRow. Read-only. int(na) when neither base exists.
virtualSwingTfMaskBeforeRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    int  mask     = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
            mask     := array.get(engine.w03Store.rootSwingTfMasks, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            mask     := array.get(engine.w03Store.journalCategories, newRow) == CAT_SWING ? array.get(engine.w03Store.journalNewMasks, newRow) : SWING_TF_MASK_NONE
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < engine.w03Store.journalCount
                if row != beforeRow and array.get(engine.w03Store.journalGroups, row) == group and journalAppliedBeforeRaw(engine, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(engine, baseRow, row)) and array.get(engine.w03Store.journalTargetRootSlots, row) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == expectedRootId
                    if array.get(engine.w03Store.journalOps, row) == JOP_SWING_TF_MERGE
                        mask := array.get(engine.w03Store.journalNewMasks, row)
                row += 1
            group += 1
    mask

// rootLabelMasks of a Root as row beforeRow will see it. Base: the committed mask,
// else the pending NEW_ROOT row's newMask for a TimeHL (0 otherwise). Then the
// newMask of every later TIMEHL_LABEL row on the same Root applied before beforeRow.
// Read-only. int(na) when neither base exists.
virtualTimeHlLabelMaskBeforeRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    int  mask     = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootLabelMasks)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
            mask     := array.get(engine.rootLabelMasks, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            mask     := array.get(engine.w03Store.journalCategories, newRow) == CAT_TIME_HL ? array.get(engine.w03Store.journalNewMasks, newRow) : 0
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < engine.w03Store.journalCount
                if row != beforeRow and array.get(engine.w03Store.journalGroups, row) == group and journalAppliedBeforeRaw(engine, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(engine, baseRow, row)) and array.get(engine.w03Store.journalTargetRootSlots, row) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == expectedRootId
                    if array.get(engine.w03Store.journalOps, row) == JOP_TIMEHL_LABEL
                        mask := array.get(engine.w03Store.journalNewMasks, row)
                row += 1
            group += 1
    mask

// rootFvgFreshFlags of a Root as row beforeRow will see it. Base: the committed flag,
// else the pending NEW_ROOT row's Fresh flag for an FVG (false otherwise); false once
// a later FVG_FRESH_END row on the same Root is applied before beforeRow.
// Returns [fresh, resolved]; resolved is false (fresh false) when neither base
// exists, so a caller always fails on it. Read-only.
virtualFvgFreshBeforeRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    bool fresh    = false
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootFvgFreshFlags)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
            fresh    := array.get(engine.rootFvgFreshFlags, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            fresh    := array.get(engine.w03Store.journalCategories, newRow) == CAT_FVG ? array.get(engine.w03Store.journalFvgFreshFlags, newRow) : false
            baseRow  := newRow
            resolved := true
    if resolved
        int row = 0
        while row < engine.w03Store.journalCount
            if row != beforeRow and journalAppliedBeforeRaw(engine, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(engine, baseRow, row)) and array.get(engine.w03Store.journalOps, row) == JOP_FVG_FRESH_END and array.get(engine.w03Store.journalTargetRootSlots, row) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == expectedRootId
                fresh := false
            row += 1
    [fresh, resolved]

// Virtual common price order for one point NEW_ROOT (E2 insert) or MA_UPDATE (E3
// move) row: proves that rootPriceOrderInsertRaw / rootPriceOrderMoveRaw succeed on
// the order that exists right before this row in Stage F. Read-only; true / false.
// The virtual order is never materialised. Its members are the committed entries of
// rootPriceOrderSlots plus the point NEW_ROOT rows applied before this row (no point
// Root leaves the order in W03 Stage F). A member's current tick is its committed
// tick or round(NEW price / mintick), replaced by its last MA_UPDATE applied before
// this row. Order: tick ascending; equal ticks put members with no placement event
// of this bar first, in committed position order, then placed members in the Stage
// F order of their latest placement (NEW_ROOT insert or MA_UPDATE move, even at an
// unchanged tick) - exactly the upper_bound insert and the equal-tick-passing move.
// Every virtual position is derived by counting members. The committed upper bound
// (rootPriceOrderUpperBoundRaw) gives only the committed base rank: a committed
// entry moved by an earlier MA_UPDATE has its committed-tick contribution removed and
// its latest virtual tick added; an earlier NEW_ROOT adds its virtual tick only.
virtualPointOrderPreflightRaw(ZoneEngine engine, int row, float mintick) =>
    int  count     = engine.w03Store.journalCount
    int  op        = array.get(engine.w03Store.journalOps, row)
    int  orderSize = array.size(engine.rootPriceOrderSlots)
    bool ok        = not na(mintick) and mintick > 0 and ((op == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, row) != CAT_FVG) or op == JOP_MA_UPDATE) and not na(array.get(engine.w03Store.journalPointPrices, row))
    int  newTick   = int(na)
    if ok
        newTick := int(math.round(array.get(engine.w03Store.journalPointPrices, row) / mintick))
        ok      := not na(newTick)
    // virtual size before this row: committed entries + earlier point NEW_ROOT rows
    int virtualSize = orderSize
    if ok
        int j = 0
        while j < count
            if j != row and array.get(engine.w03Store.journalOps, j) == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, j) != CAT_FVG and journalAppliedBeforeRaw(engine, j, row)
                virtualSize += 1
            j += 1
    // committed members with tick <= newTick (the committed upper bound)
    int newUpperC = SLOT_INVALID
    if ok
        [ubPos, ubOk] = rootPriceOrderUpperBoundRaw(engine, newTick)
        ok        := ubOk
        newUpperC := ubPos
    // the moving target (MA_UPDATE only): a committed entry (exactly one, at its
    // stored position) or the one earlier NEW_ROOT MA of this bar with this address
    int  rootSlot       = SLOT_INVALID
    int  expectedRootId = ID_NONE
    bool eCommitted     = false
    int  eCpos          = SLOT_INVALID
    int  eNewRow        = SLOT_INVALID
    int  oldTick        = int(na)
    int  oldPlace       = SLOT_INVALID
    int  eCommittedTick = int(na)
    if ok and op == JOP_MA_UPDATE
        rootSlot       := array.get(engine.w03Store.journalTargetRootSlots, row)
        expectedRootId := array.get(engine.w03Store.journalExpectedRootIds, row)
        if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
            if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
                eCommitted := true
                eCpos      := array.get(engine.rootPriceOrderPositions, rootSlot)
                ok := eCpos >= 0 and eCpos < orderSize and not array.get(engine.rootIsRangeRootFlags, rootSlot)
                if ok
                    ok := array.get(engine.rootPriceOrderSlots, eCpos) == rootSlot
        if ok and not eCommitted
            [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, row)
            ok := newCount == 1
            if ok
                eNewRow := newRow
                ok := array.get(engine.w03Store.journalCategories, newRow) == CAT_MA
    // the target's current tick and latest placement (its last earlier MA_UPDATE)
    if ok and op == JOP_MA_UPDATE
        if eCommitted
            eCommittedTick := array.get(engine.rootPointTicks, rootSlot)
            oldTick        := eCommittedTick
        else
            oldTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, eNewRow) / mintick))
            oldPlace := eNewRow
        int j = 0
        while j < count
            if j != row and array.get(engine.w03Store.journalOps, j) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, j, row) and array.get(engine.w03Store.journalTargetRootSlots, j) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, j) == expectedRootId
                if oldPlace == SLOT_INVALID or journalAppliedBeforeRaw(engine, oldPlace, j)
                    oldPlace := j
                    oldTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, j) / mintick))
            j += 1
        ok := not na(oldTick)
    bool eUnplaced = eCommitted and oldPlace == SLOT_INVALID
    int  oldUpperC = SLOT_INVALID
    if ok and op == JOP_MA_UPDATE
        [oPos, oOk] = rootPriceOrderUpperBoundRaw(engine, oldTick)
        ok        := oOk
        oldUpperC := oPos
    // every other member with a placement event this bar: committed entries moved by
    // an earlier MA_UPDATE (their committed-tick contribution to a committed upper
    // bound is removed, their latest virtual tick is added) and earlier point
    // NEW_ROOT rows (no committed contribution, virtual tick only)
    int movedBeforeCpos = 0          // moved committed entries at committed index < eCpos
    int movedLeOld      = 0          // moved committed entries, committed tick <= oldTick
    int movedLeNew      = 0          // moved committed entries, committed tick <= newTick
    int placedLessOld   = 0          // placed members before the target now
    int placedLeNew     = 0          // placed members with virtual tick <= newTick
    int rightStopTick   = int(na)    // placed member with the lowest key, tick > newTick
    int rightStopPlace  = SLOT_INVALID
    int leftStopTick    = int(na)    // placed member with the highest key, tick <= newTick
    int leftStopPlace   = SLOT_INVALID
    if ok
        int f = 0
        while ok and f < count
            bool fMember = false
            int  fTick   = int(na)
            int  fPlace  = SLOT_INVALID
            bool fMoved  = false
            int  fCTick  = int(na)
            int  fCPos   = SLOT_INVALID
            if f != row and journalAppliedBeforeRaw(engine, f, row)
                int fOp = array.get(engine.w03Store.journalOps, f)
                if fOp == JOP_MA_UPDATE
                    // a committed Root this MA_UPDATE moved, counted once (its latest move); a
                    // pending NEW_ROOT target is counted through its own NEW_ROOT row
                    int  fSlot   = array.get(engine.w03Store.journalTargetRootSlots, f)
                    int  fId     = array.get(engine.w03Store.journalExpectedRootIds, f)
                    bool fLatest = not (fSlot == rootSlot and fId == expectedRootId)
                    int  fK      = 0
                    while fLatest and fK < count
                        if fK != row and fK != f and array.get(engine.w03Store.journalOps, fK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, fK, row) and journalAppliedBeforeRaw(engine, f, fK) and array.get(engine.w03Store.journalTargetRootSlots, fK) == fSlot and array.get(engine.w03Store.journalExpectedRootIds, fK) == fId
                            fLatest := false
                        fK += 1
                    if fLatest and fSlot >= 0 and fSlot < array.size(engine.rootIds) and fSlot < array.size(engine.rootSlotLiveFlags) and fSlot < array.size(engine.rootPointTicks) and fSlot < array.size(engine.rootPriceOrderPositions)
                        if array.get(engine.rootSlotLiveFlags, fSlot) and fId != ID_NONE and array.get(engine.rootIds, fSlot) == fId
                            fCPos := array.get(engine.rootPriceOrderPositions, fSlot)
                            ok := fCPos >= 0 and fCPos < orderSize and not na(array.get(engine.rootPointTicks, fSlot))
                            if ok
                                ok := array.get(engine.rootPriceOrderSlots, fCPos) == fSlot
                            if ok
                                fMoved  := true
                                fMember := true
                                fCTick  := array.get(engine.rootPointTicks, fSlot)
                                fTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, f) / mintick))
                                fPlace  := f
                else if fOp == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, f) != CAT_FVG and f != eNewRow
                    // an earlier point NEW_ROOT: its own price and placement, or its latest move
                    int fSlot = predictedNewRootSlotRaw(engine, f)
                    int fId   = predictedNewRootIdRaw(engine, f)
                    fMember := true
                    fTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, f) / mintick))
                    fPlace  := f
                    int fK = 0
                    while fK < count
                        if fK != row and array.get(engine.w03Store.journalOps, fK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, fK, row) and array.get(engine.w03Store.journalTargetRootSlots, fK) == fSlot and array.get(engine.w03Store.journalExpectedRootIds, fK) == fId
                            if journalAppliedBeforeRaw(engine, fPlace, fK)
                                fPlace := fK
                                fTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, fK) / mintick))
                        fK += 1
            if ok and fMember
                ok := not na(fTick)
            if ok and fMember
                if fMoved
                    movedBeforeCpos += eUnplaced and fCPos < eCpos ? 1 : 0
                    movedLeOld      += fCTick <= oldTick ? 1 : 0
                    movedLeNew      += fCTick <= newTick ? 1 : 0
                // before the target: lower tick, or an equal tick placed earlier than
                // the target's own placement (an unplaced target comes first)
                if fTick < oldTick or (fTick == oldTick and oldPlace != SLOT_INVALID and journalAppliedBeforeRaw(engine, fPlace, oldPlace))
                    placedLessOld += 1
                if fTick <= newTick
                    placedLeNew += 1
                    if leftStopPlace == SLOT_INVALID or fTick > leftStopTick or (fTick == leftStopTick and journalAppliedBeforeRaw(engine, leftStopPlace, fPlace))
                        leftStopTick  := fTick
                        leftStopPlace := fPlace
                else
                    if rightStopPlace == SLOT_INVALID or fTick < rightStopTick or (fTick == rightStopTick and journalAppliedBeforeRaw(engine, fPlace, rightStopPlace))
                        rightStopTick  := fTick
                        rightStopPlace := fPlace
            f += 1
    // ---------------- E2 : point NEW_ROOT insert ----------------
    if ok and op == JOP_NEW_ROOT
        // insert position = members with virtual tick <= newTick (upper_bound: after the
        // equal-tick group, whose placements are all earlier than this row). Unplaced
        // committed members: the committed upper bound minus the moved entries it
        // counted at their committed tick; placed members: by their virtual tick.
        int insertPos = newUpperC - movedLeNew + placedLeNew
        ok := insertPos >= 0 and insertPos <= virtualSize
        // phase 0 : the binary search rootPriceOrderUpperBoundRaw runs on the virtual
        // order, probe by probe; phase 1 : left neighbour; phase 2 : right neighbour
        int lo    = 0
        int hi    = virtualSize
        int phase = 0
        while ok and phase < 3
            int probe = SLOT_INVALID
            if phase == 0
                if lo < hi
                    probe := int(math.floor((lo + hi) / 2.0))
                else
                    // the simulated upper bound is the derived insert position
                    ok    := lo == insertPos
                    phase := 1
            if ok and phase == 1 and probe == SLOT_INVALID
                if insertPos > 0
                    probe := insertPos - 1
                else
                    phase := 2
            if ok and phase == 2 and probe == SLOT_INVALID
                if insertPos < virtualSize
                    probe := insertPos
                else
                    phase := 3
            if ok and probe != SLOT_INVALID
                // the member at virtual index probe: a placed member whose own virtual
                // position is probe, else the unplaced committed entry of that rank
                int  probeTick    = int(na)
                bool placedHit    = false
                int  placedBefore = 0
                int  a = 0
                while ok and a < count
                    bool aMember = false
                    int  aTick   = int(na)
                    int  aPlace  = SLOT_INVALID
                    bool aMoved  = false
                    int  aCTick  = int(na)
                    int  aCPos   = SLOT_INVALID
                    if a != row and journalAppliedBeforeRaw(engine, a, row)
                        int aOp = array.get(engine.w03Store.journalOps, a)
                        if aOp == JOP_MA_UPDATE
                            // a committed Root this MA_UPDATE moved, counted once (its latest move); a
                            // pending NEW_ROOT target is counted through its own NEW_ROOT row
                            int  aSlot   = array.get(engine.w03Store.journalTargetRootSlots, a)
                            int  aId     = array.get(engine.w03Store.journalExpectedRootIds, a)
                            bool aLatest = not (aSlot == rootSlot and aId == expectedRootId)
                            int  aK      = 0
                            while aLatest and aK < count
                                if aK != row and aK != a and array.get(engine.w03Store.journalOps, aK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, aK, row) and journalAppliedBeforeRaw(engine, a, aK) and array.get(engine.w03Store.journalTargetRootSlots, aK) == aSlot and array.get(engine.w03Store.journalExpectedRootIds, aK) == aId
                                    aLatest := false
                                aK += 1
                            if aLatest and aSlot >= 0 and aSlot < array.size(engine.rootIds) and aSlot < array.size(engine.rootSlotLiveFlags) and aSlot < array.size(engine.rootPointTicks) and aSlot < array.size(engine.rootPriceOrderPositions)
                                if array.get(engine.rootSlotLiveFlags, aSlot) and aId != ID_NONE and array.get(engine.rootIds, aSlot) == aId
                                    aCPos := array.get(engine.rootPriceOrderPositions, aSlot)
                                    ok := aCPos >= 0 and aCPos < orderSize and not na(array.get(engine.rootPointTicks, aSlot))
                                    if ok
                                        ok := array.get(engine.rootPriceOrderSlots, aCPos) == aSlot
                                    if ok
                                        aMoved  := true
                                        aMember := true
                                        aCTick  := array.get(engine.rootPointTicks, aSlot)
                                        aTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, a) / mintick))
                                        aPlace  := a
                        else if aOp == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, a) != CAT_FVG and a != eNewRow
                            // an earlier point NEW_ROOT: its own price and placement, or its latest move
                            int aSlot = predictedNewRootSlotRaw(engine, a)
                            int aId   = predictedNewRootIdRaw(engine, a)
                            aMember := true
                            aTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, a) / mintick))
                            aPlace  := a
                            int aK = 0
                            while aK < count
                                if aK != row and array.get(engine.w03Store.journalOps, aK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, aK, row) and array.get(engine.w03Store.journalTargetRootSlots, aK) == aSlot and array.get(engine.w03Store.journalExpectedRootIds, aK) == aId
                                    if journalAppliedBeforeRaw(engine, aPlace, aK)
                                        aPlace := aK
                                        aTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, aK) / mintick))
                                aK += 1
                    if ok and aMember
                        ok := not na(aTick)
                    if ok and aMember
                        // its virtual position: unplaced committed members with tick <= its
                        // tick, plus placed members ordered before it
                        [aUpper, aUpperOk] = rootPriceOrderUpperBoundRaw(engine, aTick)
                        ok := aUpperOk
                        int aPos = aUpper
                        int b = 0
                        while ok and b < count
                            bool bMember = false
                            int  bTick   = int(na)
                            int  bPlace  = SLOT_INVALID
                            bool bMoved  = false
                            int  bCTick  = int(na)
                            int  bCPos   = SLOT_INVALID
                            if b != row and journalAppliedBeforeRaw(engine, b, row)
                                int bOp = array.get(engine.w03Store.journalOps, b)
                                if bOp == JOP_MA_UPDATE
                                    // a committed Root this MA_UPDATE moved, counted once (its latest move); a
                                    // pending NEW_ROOT target is counted through its own NEW_ROOT row
                                    int  bSlot   = array.get(engine.w03Store.journalTargetRootSlots, b)
                                    int  bId     = array.get(engine.w03Store.journalExpectedRootIds, b)
                                    bool bLatest = not (bSlot == rootSlot and bId == expectedRootId)
                                    int  bK      = 0
                                    while bLatest and bK < count
                                        if bK != row and bK != b and array.get(engine.w03Store.journalOps, bK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, bK, row) and journalAppliedBeforeRaw(engine, b, bK) and array.get(engine.w03Store.journalTargetRootSlots, bK) == bSlot and array.get(engine.w03Store.journalExpectedRootIds, bK) == bId
                                            bLatest := false
                                        bK += 1
                                    if bLatest and bSlot >= 0 and bSlot < array.size(engine.rootIds) and bSlot < array.size(engine.rootSlotLiveFlags) and bSlot < array.size(engine.rootPointTicks) and bSlot < array.size(engine.rootPriceOrderPositions)
                                        if array.get(engine.rootSlotLiveFlags, bSlot) and bId != ID_NONE and array.get(engine.rootIds, bSlot) == bId
                                            bCPos := array.get(engine.rootPriceOrderPositions, bSlot)
                                            ok := bCPos >= 0 and bCPos < orderSize and not na(array.get(engine.rootPointTicks, bSlot))
                                            if ok
                                                ok := array.get(engine.rootPriceOrderSlots, bCPos) == bSlot
                                            if ok
                                                bMoved  := true
                                                bMember := true
                                                bCTick  := array.get(engine.rootPointTicks, bSlot)
                                                bTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, b) / mintick))
                                                bPlace  := b
                                else if bOp == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, b) != CAT_FVG and b != eNewRow
                                    // an earlier point NEW_ROOT: its own price and placement, or its latest move
                                    int bSlot = predictedNewRootSlotRaw(engine, b)
                                    int bId   = predictedNewRootIdRaw(engine, b)
                                    bMember := true
                                    bTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, b) / mintick))
                                    bPlace  := b
                                    int bK = 0
                                    while bK < count
                                        if bK != row and array.get(engine.w03Store.journalOps, bK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, bK, row) and array.get(engine.w03Store.journalTargetRootSlots, bK) == bSlot and array.get(engine.w03Store.journalExpectedRootIds, bK) == bId
                                            if journalAppliedBeforeRaw(engine, bPlace, bK)
                                                bPlace := bK
                                                bTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, bK) / mintick))
                                        bK += 1
                            if ok and bMember
                                ok := not na(bTick)
                            if ok and bMember
                                if bMoved and bCTick <= aTick
                                    aPos -= 1
                                if b != a and (bTick < aTick or (bTick == aTick and journalAppliedBeforeRaw(engine, bPlace, aPlace)))
                                    aPos += 1
                            b += 1
                        if aPos == probe
                            placedHit := true
                            probeTick := aTick
                        else if aPos < probe
                            placedBefore += 1
                    a += 1
                if ok and not placedHit
                    // the unplaced committed entry of rank probe - placedBefore: the least
                    // committed index whose unplaced prefix holds exactly that rank
                    int  unplacedRank = probe - placedBefore
                    int  cIdx         = unplacedRank
                    bool settled      = false
                    int  guard        = 0
                    while ok and not settled and guard <= count
                        int movedUpTo = 0
                        int m = 0
                        while ok and m < count
                            bool mMember = false
                            int  mTick   = int(na)
                            int  mPlace  = SLOT_INVALID
                            bool mMoved  = false
                            int  mCTick  = int(na)
                            int  mCPos   = SLOT_INVALID
                            if m != row and journalAppliedBeforeRaw(engine, m, row)
                                int mOp = array.get(engine.w03Store.journalOps, m)
                                if mOp == JOP_MA_UPDATE
                                    // a committed Root this MA_UPDATE moved, counted once (its latest move); a
                                    // pending NEW_ROOT target is counted through its own NEW_ROOT row
                                    int  mSlot   = array.get(engine.w03Store.journalTargetRootSlots, m)
                                    int  mId     = array.get(engine.w03Store.journalExpectedRootIds, m)
                                    bool mLatest = not (mSlot == rootSlot and mId == expectedRootId)
                                    int  mK      = 0
                                    while mLatest and mK < count
                                        if mK != row and mK != m and array.get(engine.w03Store.journalOps, mK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, mK, row) and journalAppliedBeforeRaw(engine, m, mK) and array.get(engine.w03Store.journalTargetRootSlots, mK) == mSlot and array.get(engine.w03Store.journalExpectedRootIds, mK) == mId
                                            mLatest := false
                                        mK += 1
                                    if mLatest and mSlot >= 0 and mSlot < array.size(engine.rootIds) and mSlot < array.size(engine.rootSlotLiveFlags) and mSlot < array.size(engine.rootPointTicks) and mSlot < array.size(engine.rootPriceOrderPositions)
                                        if array.get(engine.rootSlotLiveFlags, mSlot) and mId != ID_NONE and array.get(engine.rootIds, mSlot) == mId
                                            mCPos := array.get(engine.rootPriceOrderPositions, mSlot)
                                            ok := mCPos >= 0 and mCPos < orderSize and not na(array.get(engine.rootPointTicks, mSlot))
                                            if ok
                                                ok := array.get(engine.rootPriceOrderSlots, mCPos) == mSlot
                                            if ok
                                                mMoved  := true
                                                mMember := true
                                                mCTick  := array.get(engine.rootPointTicks, mSlot)
                                                mTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, m) / mintick))
                                                mPlace  := m
                                else if mOp == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, m) != CAT_FVG and m != eNewRow
                                    // an earlier point NEW_ROOT: its own price and placement, or its latest move
                                    int mSlot = predictedNewRootSlotRaw(engine, m)
                                    int mId   = predictedNewRootIdRaw(engine, m)
                                    mMember := true
                                    mTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, m) / mintick))
                                    mPlace  := m
                                    int mK = 0
                                    while mK < count
                                        if mK != row and array.get(engine.w03Store.journalOps, mK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, mK, row) and array.get(engine.w03Store.journalTargetRootSlots, mK) == mSlot and array.get(engine.w03Store.journalExpectedRootIds, mK) == mId
                                            if journalAppliedBeforeRaw(engine, mPlace, mK)
                                                mPlace := mK
                                                mTick  := int(math.round(array.get(engine.w03Store.journalPointPrices, mK) / mintick))
                                        mK += 1
                            if ok and mMember
                                ok := not na(mTick)
                            if ok and mMoved and mCPos <= cIdx
                                movedUpTo += 1
                            m += 1
                        int nextIdx = unplacedRank + movedUpTo
                        if nextIdx == cIdx
                            settled := true
                        else
                            cIdx := nextIdx
                        guard += 1
                    ok := ok and settled and unplacedRank >= 0 and cIdx >= 0 and cIdx < orderSize
                    if ok
                        // the upper-bound / neighbour member checks
                        int slot = array.get(engine.rootPriceOrderSlots, cIdx)
                        ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, slot) and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == cIdx
                        if ok
                            probeTick := array.get(engine.rootPointTicks, slot)
                if ok
                    if phase == 0
                        if probeTick <= newTick
                            lo := probe + 1
                        else
                            hi := probe
                    else if phase == 1
                        // left neighbour: tick <= newTick
                        ok    := probeTick <= newTick
                        phase := 2
                    else
                        // right neighbour: tick > newTick
                        ok    := probeTick > newTick
                        phase := 3
        // every member the insert shifts right: the unplaced committed entries with
        // tick > newTick; placed members were placed by F2 / an earlier row
        if ok
            int c = newUpperC
            while ok and c < orderSize
                int slot = array.get(engine.rootPriceOrderSlots, c)
                ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
                bool placed = false
                if ok
                    int k = 0
                    while not placed and k < count
                        if k != row and array.get(engine.w03Store.journalOps, k) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, k, row) and array.get(engine.w03Store.journalTargetRootSlots, k) == slot and array.get(engine.w03Store.journalExpectedRootIds, k) == array.get(engine.rootIds, slot)
                            placed := true
                        k += 1
                if ok and not placed
                    ok := array.get(engine.rootSlotLiveFlags, slot) and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == c
                c += 1
    // ---------------- E3 : MA_UPDATE move ----------------
    if ok and op == JOP_MA_UPDATE
        // oldPos : members before the target; targetPos : members (other than the
        // target) with tick <= newTick - where the move leaves it, the end of the
        // newTick group, for both scan directions
        int oldPos    = SLOT_INVALID
        int targetPos = SLOT_INVALID
        if ok
            int unplacedLessOld = eUnplaced ? eCpos - movedBeforeCpos : oldUpperC - movedLeOld - (eCommitted and eCommittedTick <= oldTick ? 1 : 0)
            int unplacedLeNew   = newUpperC - movedLeNew - (eCommitted and eCommittedTick <= newTick ? 1 : 0)
            oldPos    := unplacedLessOld + placedLessOld
            targetPos := unplacedLeNew + placedLeNew
            ok := oldPos >= 0 and oldPos < virtualSize and targetPos >= 0 and targetPos < virtualSize and (newTick >= oldTick ? targetPos >= oldPos : targetPos <= oldPos)
        // the committed unplaced members the scan passes, then its stop neighbour
        if ok
            bool rightScan = newTick >= oldTick
            int  cFrom     = rightScan ? (eUnplaced ? eCpos + 1 : oldUpperC) : newUpperC
            int  cTo       = rightScan ? newUpperC : (eUnplaced ? eCpos : oldUpperC)
            int  phase     = 0
            int  c         = cFrom
            while ok and phase < 2
                int  slot    = SLOT_INVALID
                bool inRange = false
                if phase == 0
                    inRange := c < cTo
                    if not inRange
                        // the stop neighbour: the first unplaced committed entry past the range
                        phase := 1
                        c     := rightScan ? newUpperC : newUpperC - 1
                if phase == 1
                    inRange := rightScan ? c < orderSize : c >= 0
                    if not inRange
                        phase := 2
                if ok and inRange
                    slot := array.get(engine.rootPriceOrderSlots, c)
                    ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
                    // skip the target and every entry an earlier MA_UPDATE moved
                    bool placed = false
                    if ok
                        placed := eCommitted and slot == rootSlot
                        int k = 0
                        while not placed and k < count
                            if k != row and array.get(engine.w03Store.journalOps, k) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, k, row) and array.get(engine.w03Store.journalTargetRootSlots, k) == slot and array.get(engine.w03Store.journalExpectedRootIds, k) == array.get(engine.rootIds, slot)
                                placed := true
                            k += 1
                    if ok and not placed
                        // phase 1 : this unplaced entry is the stop neighbour only when no
                        // placed member is nearer (equal tick: unplaced members come first)
                        int  cTick   = array.get(engine.rootPointTicks, slot)
                        bool visited = phase == 0 or (rightScan ? (rightStopPlace == SLOT_INVALID or na(cTick) or cTick <= rightStopTick) : (leftStopPlace == SLOT_INVALID or na(cTick) or cTick > leftStopTick))
                        if visited
                            // the move-scan member checks
                            ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and not array.get(engine.rootIsRangeRootFlags, slot) and not na(cTick) and array.get(engine.rootPriceOrderPositions, slot) == c
                            if ok and phase == 1
                                // the stop condition of the scan direction
                                ok := rightScan ? cTick > newTick : cTick <= newTick
                        if phase == 1
                            phase := 2
                    if phase == 0
                        c += 1
                    else if phase == 1
                        c := rightScan ? c + 1 : c - 1
            // a nearer placed stop neighbour was placed by F2 / an earlier F3 row
            if ok and rightScan and rightStopPlace != SLOT_INVALID
                ok := rightStopTick > newTick
            if ok and not rightScan and leftStopPlace != SLOT_INVALID
                ok := leftStopTick <= newTick
    ok

// ============================================================
// W03 Batch 18A-R2 : chained swap-pop replay for F0
// Source: I8 (Stage F / F0), I11-4, I11-6, D12
//
// Internal only and READ-ONLY for the Engine. Seven swap-pop sets are replayed
// exactly in Stage F order (E1 -> E4, append order inside a group):
//   ACTIVE state set                : POP FVG_INVALIDATE (E1), PUSH NEW_ROOT (E2,
//                                     every Category), POP ROOT_RETIRE (E4)
//   FVG structurally-active 1H/4H/D : POP FVG_INVALIDATE (E1), PUSH NEW_ROOT FVG (E2)
//   FVG Fresh 1H/4H/D               : PUSH NEW_ROOT FVG Fresh (E2), POP FVG_FRESH_END
//                                     (E3; canonical Path B for a same-bar FVG)
// The virtual set is the committed set plus an overlay held in two local scratch
// arrays owned by w03StageFPreflightRaw: scratchRootSlots[i] -> its current virtual
// position scratchVirtualPositions[i] (SLOT_INVALID once detached). Only Roots whose
// position changes in this bar enter the overlay (pushed, detached, moved-last), so
// its size is bounded by the journal, never by the Root count. A POP reproduces the
// raw swap-pop exactly: target position, the virtual last entry, its reverse
// position, target -> SLOT_INVALID, moved-last -> target position, size - 1.
// No committed set is copied or scanned, and no Engine or journal field is written.
// Business call sites = 0 (only F0 calls them).
// ============================================================

const int SET_SIM_ACTIVE         = 1   // general ACTIVE state set
const int SET_SIM_FVG_STRUCTURAL = 2   // FVG structurally-active set of one TF
const int SET_SIM_FVG_FRESH      = 3   // FVG Fresh set of one TF

// Committed size of the simulated set; SLOT_INVALID for an unknown set / TF.
virtualSetCommittedSizeRaw(ZoneEngine engine, int setKind, int tfCode) =>
    int size = SLOT_INVALID
    if setKind == SET_SIM_ACTIVE
        size := array.size(engine.stateActiveRootSlots)
    else if setKind == SET_SIM_FVG_STRUCTURAL
        if tfCode == TF_1H
            size := array.size(engine.structurallyActiveFvg1hRootSlots)
        else if tfCode == TF_4H
            size := array.size(engine.structurallyActiveFvg4hRootSlots)
        else if tfCode == TF_D
            size := array.size(engine.structurallyActiveFvgDRootSlots)
    else if setKind == SET_SIM_FVG_FRESH
        if tfCode == TF_1H
            size := array.size(engine.freshFvg1hRootSlots)
        else if tfCode == TF_4H
            size := array.size(engine.freshFvg4hRootSlots)
        else if tfCode == TF_D
            size := array.size(engine.freshFvgDRootSlots)
    size

// Committed member rootSlot at index of the simulated set; SLOT_INVALID when the
// index is outside the committed set or the set / TF is unknown.
virtualSetCommittedSlotAtRaw(ZoneEngine engine, int setKind, int tfCode, int index) =>
    int slot = SLOT_INVALID
    if index >= 0 and index < virtualSetCommittedSizeRaw(engine, setKind, tfCode)
        if setKind == SET_SIM_ACTIVE
            slot := array.get(engine.stateActiveRootSlots, index)
        else if setKind == SET_SIM_FVG_STRUCTURAL
            if tfCode == TF_1H
                slot := array.get(engine.structurallyActiveFvg1hRootSlots, index)
            else if tfCode == TF_4H
                slot := array.get(engine.structurallyActiveFvg4hRootSlots, index)
            else if tfCode == TF_D
                slot := array.get(engine.structurallyActiveFvgDRootSlots, index)
        else if setKind == SET_SIM_FVG_FRESH
            if tfCode == TF_1H
                slot := array.get(engine.freshFvg1hRootSlots, index)
            else if tfCode == TF_4H
                slot := array.get(engine.freshFvg4hRootSlots, index)
            else if tfCode == TF_D
                slot := array.get(engine.freshFvgDRootSlots, index)
    slot

// Committed reverse position of rootSlot in the simulated set: the stored position
// of a live Root that belongs to this set (ACTIVE state; FVG of this TF), else
// SLOT_INVALID. A slot outside the Root arrays or a free slot has none.
virtualSetCommittedPositionRaw(ZoneEngine engine, int setKind, int tfCode, int rootSlot) =>
    int pos = SLOT_INVALID
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStateSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgFreshSetPositions)
        if array.get(engine.rootSlotLiveFlags, rootSlot)
            if setKind == SET_SIM_ACTIVE
                if array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE
                    pos := array.get(engine.rootStateSetPositions, rootSlot)
            else if array.get(engine.rootCategories, rootSlot) == CAT_FVG and array.get(engine.rootTfCodes, rootSlot) == tfCode and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D)
                if setKind == SET_SIM_FVG_STRUCTURAL
                    pos := array.get(engine.rootFvgStructuralStateSetPositions, rootSlot)
                else if setKind == SET_SIM_FVG_FRESH
                    pos := array.get(engine.rootFvgFreshSetPositions, rootSlot)
    pos

// Current virtual position of rootSlot: the overlay entry when the Root is in it,
// else the committed reverse position, which must then point back at the Root inside
// the committed set. Returns [position, ok]; ok false on a broken committed entry.
virtualSetOverlayPositionRaw(ZoneEngine engine, int setKind, int tfCode, array<int> scratchRootSlots, array<int> scratchVirtualPositions, int rootSlot) =>
    int  pos   = SLOT_INVALID
    bool ok    = rootSlot >= 0
    bool found = false
    if ok
        int i = 0
        while not found and i < array.size(scratchRootSlots)
            if array.get(scratchRootSlots, i) == rootSlot
                found := true
                pos   := array.get(scratchVirtualPositions, i)
            i += 1
    if ok and not found
        pos := virtualSetCommittedPositionRaw(engine, setKind, tfCode, rootSlot)
        if pos != SLOT_INVALID
            ok := pos >= 0 and pos < virtualSetCommittedSizeRaw(engine, setKind, tfCode) and virtualSetCommittedSlotAtRaw(engine, setKind, tfCode, pos) == rootSlot
    [pos, ok]

// Replays every PUSH / POP of one simulated set over the whole journal in Stage F
// order and proves each raw helper step succeeds on the virtual set it meets.
// The overlay arrays are the caller's local scratch, cleared before the call.
virtualSwapPopSetReplayRaw(ZoneEngine engine, int setKind, int tfCode, array<int> scratchRootSlots, array<int> scratchVirtualPositions) =>
    int  count         = engine.w03Store.journalCount
    int  committedSize = virtualSetCommittedSizeRaw(engine, setKind, tfCode)
    bool ok            = committedSize >= 0 and array.size(scratchRootSlots) == 0 and array.size(scratchVirtualPositions) == 0
    int  virtualSize   = committedSize
    int  group         = JGROUP_E1
    while ok and group <= JGROUP_E4
        int row = 0
        while ok and row < count
            if array.get(engine.w03Store.journalGroups, row) == group
                int  op        = array.get(engine.w03Store.journalOps,     row)
                int  rowTf     = array.get(engine.w03Store.journalTfCodes, row)
                bool isFvgRow  = array.get(engine.w03Store.journalCategories, row) == CAT_FVG
                bool isPush    = false
                bool isPop     = false
                int  eventSlot = SLOT_INVALID
                // the operations of this set, and nothing else
                if op == JOP_NEW_ROOT
                    isPush := setKind == SET_SIM_ACTIVE or (isFvgRow and rowTf == tfCode and (setKind == SET_SIM_FVG_STRUCTURAL or (setKind == SET_SIM_FVG_FRESH and array.get(engine.w03Store.journalFvgFreshFlags, row))))
                    if isPush
                        eventSlot := predictedNewRootSlotRaw(engine, row)
                else if op == JOP_FVG_INVALIDATE
                    isPop := setKind == SET_SIM_ACTIVE or (setKind == SET_SIM_FVG_STRUCTURAL and rowTf == tfCode)
                else if op == JOP_ROOT_RETIRE
                    isPop := setKind == SET_SIM_ACTIVE
                else if op == JOP_FVG_FRESH_END
                    isPop := setKind == SET_SIM_FVG_FRESH and rowTf == tfCode
                // the POP target rootSlot: committed, canonical Path B, or a pending NEW
                if isPop
                    int targetSlot = array.get(engine.w03Store.journalTargetRootSlots, row)
                    int targetId   = array.get(engine.w03Store.journalExpectedRootIds, row)
                    if op == JOP_FVG_FRESH_END and targetSlot == SLOT_INVALID and targetId == ID_NONE
                        [matchRow, matchCount] = pendingNewFvgRowRaw(engine, row)
                        ok := matchCount == 1
                        if ok
                            eventSlot := predictedNewRootSlotRaw(engine, matchRow)
                    else
                        bool committedTarget = targetSlot >= 0 and targetSlot < array.size(engine.rootIds) and targetSlot < array.size(engine.rootSlotLiveFlags)
                        if committedTarget
                            committedTarget := array.get(engine.rootSlotLiveFlags, targetSlot) and targetId != ID_NONE and array.get(engine.rootIds, targetSlot) == targetId
                        if committedTarget
                            eventSlot := targetSlot
                        else if op == JOP_ROOT_RETIRE
                            [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, targetSlot, targetId, row)
                            ok := newCount == 1
                            if ok
                                eventSlot := predictedNewRootSlotRaw(engine, newRow)
                        else
                            ok := false
                // PUSH : a non-member goes to the tail
                if ok and isPush
                    [curPos, curOk] = virtualSetOverlayPositionRaw(engine, setKind, tfCode, scratchRootSlots, scratchVirtualPositions, eventSlot)
                    ok := eventSlot >= 0 and curOk and curPos == SLOT_INVALID
                    if ok
                        int wIdx = SLOT_INVALID
                        int w    = 0
                        while wIdx == SLOT_INVALID and w < array.size(scratchRootSlots)
                            if array.get(scratchRootSlots, w) == eventSlot
                                wIdx := w
                            w += 1
                        if wIdx == SLOT_INVALID
                            array.push(scratchRootSlots,        eventSlot)
                            array.push(scratchVirtualPositions, virtualSize)
                        else
                            array.set(scratchVirtualPositions, wIdx, virtualSize)
                        virtualSize += 1
                // POP : the exact swap-pop
                if ok and isPop
                    [targetPos, targetOk] = virtualSetOverlayPositionRaw(engine, setKind, tfCode, scratchRootSlots, scratchVirtualPositions, eventSlot)
                    ok := targetOk and targetPos >= 0 and targetPos < virtualSize
                    int lastIndex    = virtualSize - 1
                    int lastRootSlot = SLOT_INVALID
                    // the virtual entry at lastIndex: exactly one overlay Root there, else the
                    // committed entry, unless that entry already moved or left in this replay
                    if ok
                        int hitCount = 0
                        int hitSlot  = SLOT_INVALID
                        int s = 0
                        while s < array.size(scratchVirtualPositions)
                            if array.get(scratchVirtualPositions, s) == lastIndex
                                hitCount += 1
                                hitSlot  := array.get(scratchRootSlots, s)
                            s += 1
                        if hitCount == 1
                            lastRootSlot := hitSlot
                        else if hitCount > 1
                            ok := false
                        else if lastIndex < committedSize
                            int candidate = virtualSetCommittedSlotAtRaw(engine, setKind, tfCode, lastIndex)
                            bool candidateMoved = false
                            int  candidateMovedI = 0
                            while not candidateMoved and candidateMovedI < array.size(scratchRootSlots)
                                if array.get(scratchRootSlots, candidateMovedI) == candidate
                                    candidateMoved := true
                                candidateMovedI += 1
                            ok := candidate != SLOT_INVALID and not candidateMoved
                            if ok
                                lastRootSlot := candidate
                                // a committed last entry: the live, owned Root the swap-pop moves
                                ok := candidate >= 0 and candidate < array.size(engine.rootIds) and candidate < array.size(engine.rootSlotLiveFlags)
                                if ok
                                    ok := array.get(engine.rootSlotLiveFlags, candidate) and array.get(engine.rootIds, candidate) != ID_NONE
                        else
                            ok := false
                    // its reverse position is exactly lastIndex
                    if ok
                        [lastPos, lastOk] = virtualSetOverlayPositionRaw(engine, setKind, tfCode, scratchRootSlots, scratchVirtualPositions, lastRootSlot)
                        ok := lastOk and lastPos == lastIndex
                    // commit to the overlay: target out, moved-last into the target position
                    if ok
                        if targetPos == lastIndex
                            ok := lastRootSlot == eventSlot
                            if ok
                                int wIdx = SLOT_INVALID
                                int w    = 0
                                while wIdx == SLOT_INVALID and w < array.size(scratchRootSlots)
                                    if array.get(scratchRootSlots, w) == eventSlot
                                        wIdx := w
                                    w += 1
                                if wIdx == SLOT_INVALID
                                    array.push(scratchRootSlots,        eventSlot)
                                    array.push(scratchVirtualPositions, SLOT_INVALID)
                                else
                                    array.set(scratchVirtualPositions, wIdx, SLOT_INVALID)
                        else
                            ok := lastRootSlot != eventSlot
                            if ok
                                int wIdx = SLOT_INVALID
                                int w    = 0
                                while wIdx == SLOT_INVALID and w < array.size(scratchRootSlots)
                                    if array.get(scratchRootSlots, w) == eventSlot
                                        wIdx := w
                                    w += 1
                                if wIdx == SLOT_INVALID
                                    array.push(scratchRootSlots,        eventSlot)
                                    array.push(scratchVirtualPositions, SLOT_INVALID)
                                else
                                    array.set(scratchVirtualPositions, wIdx, SLOT_INVALID)
                                int movedIdx = SLOT_INVALID
                                int mv = 0
                                while movedIdx == SLOT_INVALID and mv < array.size(scratchRootSlots)
                                    if array.get(scratchRootSlots, mv) == lastRootSlot
                                        movedIdx := mv
                                    mv += 1
                                if movedIdx == SLOT_INVALID
                                    array.push(scratchRootSlots,        lastRootSlot)
                                    array.push(scratchVirtualPositions, targetPos)
                                else
                                    array.set(scratchVirtualPositions, movedIdx, targetPos)
                        if ok
                            virtualSize -= 1
                            ok := virtualSize >= 0
                    // after the POP: target out, moved-last at the old target position, and
                    // nothing left at the old last index
                    if ok
                        [afterTargetPos, afterTargetOk] = virtualSetOverlayPositionRaw(engine, setKind, tfCode, scratchRootSlots, scratchVirtualPositions, eventSlot)
                        ok := afterTargetOk and afterTargetPos == SLOT_INVALID and virtualSize == lastIndex
                    if ok and targetPos != lastIndex
                        [afterLastPos, afterLastOk] = virtualSetOverlayPositionRaw(engine, setKind, tfCode, scratchRootSlots, scratchVirtualPositions, lastRootSlot)
                        ok := afterLastOk and afterLastPos == targetPos
                    if ok
                        int s = 0
                        while ok and s < array.size(scratchVirtualPositions)
                            ok := array.get(scratchVirtualPositions, s) != lastIndex
                            s += 1
                        if ok and lastIndex < committedSize
                            int oldLast = virtualSetCommittedSlotAtRaw(engine, setKind, tfCode, lastIndex)
                            bool oldLastLeft = false
                            int  oldLastLeftI = 0
                            while not oldLastLeft and oldLastLeftI < array.size(scratchRootSlots)
                                if array.get(scratchRootSlots, oldLastLeftI) == oldLast
                                    oldLastLeft := true
                                oldLastLeftI += 1
                            ok := oldLastLeft
            row += 1
        group += 1
    ok

// F0 : proves the whole journal applies in F1 - F4 with no apply helper returning
// false. Read-only. Returns true; any failure is runtime.error("W03_JOURNAL_PREFLIGHT").
w03StageFPreflightRaw(ZoneEngine engine, float mintick) =>
    int count = engine.w03Store.journalCount
    // Step 1 : store level - no raised lookup violation, all 23 arrays hold every row
    bool ok = not engine.w03Store.journalInvariantViolation and count >= 0 and count <= array.size(engine.w03Store.journalOps) and count <= array.size(engine.w03Store.journalGroups) and count <= array.size(engine.w03Store.journalTargetRootSlots) and count <= array.size(engine.w03Store.journalExpectedRootIds) and count <= array.size(engine.w03Store.journalCategories) and count <= array.size(engine.w03Store.journalSubtypes) and count <= array.size(engine.w03Store.journalTfCodes) and count <= array.size(engine.w03Store.journalOriginKeys) and count <= array.size(engine.w03Store.journalOriginTimes) and count <= array.size(engine.w03Store.journalOriginEndTimes) and count <= array.size(engine.w03Store.journalConfirmedTimes) and count <= array.size(engine.w03Store.journalPointPrices) and count <= array.size(engine.w03Store.journalNativeBottoms) and count <= array.size(engine.w03Store.journalNativeTops) and count <= array.size(engine.w03Store.journalOldStates) and count <= array.size(engine.w03Store.journalNewStates) and count <= array.size(engine.w03Store.journalFvgFreshFlags) and count <= array.size(engine.w03Store.journalIsBroadFlags) and count <= array.size(engine.w03Store.journalDirections) and count <= array.size(engine.w03Store.journalOldMasks) and count <= array.size(engine.w03Store.journalNewMasks) and count <= array.size(engine.w03Store.journalPairKeys) and count <= array.size(engine.w03Store.journalSlopeDirs)
    if ok and count > 0
        ok := engine.w03Store.journalBaseSeq != SEQ_UNSET
    // Step 2 : op / group pairing, and what the later steps must cover
    bool anyFvgNew       = false
    int  newRowCount     = 0
    if ok
        int row = 0
        while ok and row < count
            int rowOp    = array.get(engine.w03Store.journalOps,     row)
            int rowGroup = array.get(engine.w03Store.journalGroups,  row)
            ok := (rowOp == JOP_FVG_INVALIDATE and rowGroup == JGROUP_E1) or (rowOp == JOP_NEW_ROOT and rowGroup == JGROUP_E2) or ((rowOp == JOP_MA_UPDATE or rowOp == JOP_SWING_TF_MERGE or rowOp == JOP_TIMEHL_LABEL or rowOp == JOP_FVG_FRESH_END) and rowGroup == JGROUP_E3) or (rowOp == JOP_ROOT_RETIRE and rowGroup == JGROUP_E4)
            if ok
                if rowOp == JOP_NEW_ROOT
                    newRowCount += 1
                    if array.get(engine.w03Store.journalCategories, row) == CAT_FVG
                        anyFvgNew := true
            row += 1
    // Step 3 : the free-stack entries F2 will pop - in range, not live, distinct
    if ok and newRowCount > 0
        int freeSize   = array.size(engine.rootFreeSlots)
        int reuseCount = math.min(newRowCount, freeSize)
        int i = freeSize - reuseCount
        while ok and i < freeSize
            int slot = array.get(engine.rootFreeSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags)
            if ok
                ok := not array.get(engine.rootSlotLiveFlags, slot)
            int j = i + 1
            while ok and j < freeSize
                ok := array.get(engine.rootFreeSlots, j) != slot
                j += 1
            i += 1
    // Step 4 : the common price order is proven row by row on the virtual order of
    // each point NEW_ROOT / MA_UPDATE row (virtualPointOrderPreflightRaw, Step 7)
    // Step 5 : both NativeRange orders, whole, when E2 inserts FVG Roots
    if ok and anyFvgNew
        int side = 0
        while ok and side < 2
            array<int> orderSlots     = side == 0 ? engine.fvgNativeBottomOrderRootSlots : engine.fvgNativeTopOrderRootSlots
            array<int> orderPositions = side == 0 ? engine.rootFvgNativeBottomOrderPositions : engine.rootFvgNativeTopOrderPositions
            array<int> orderTicks     = side == 0 ? engine.rootNativeBottomTicks : engine.rootNativeTopTicks
            int orderSize = array.size(orderSlots)
            int prevTick  = int(na)
            int i = 0
            while ok and i < orderSize
                int slot = array.get(orderSlots, i)
                ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(orderTicks) and slot < array.size(orderPositions)
                if ok
                    int entryTf  = array.get(engine.rootTfCodes,    slot)
                    int entryDir = array.get(engine.rootDirections, slot)
                    ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(orderTicks, slot)) and array.get(orderPositions, slot) == i
                if ok
                    int tick = array.get(orderTicks, slot)
                    if i > 0
                        ok := prevTick <= tick
                    prevTick := tick
                i += 1
            side += 1
    // Step 6 : the seven swap-pop sets, each replayed exactly in Stage F order on its
    // own overlay (virtualSwapPopSetReplayRaw). The two scratch arrays live only in
    // this call, are cleared before each set and never reach the Engine or journal.
    if ok
        array<int> scratchRootSlots        = array.new_int(0)
        array<int> scratchVirtualPositions = array.new_int(0)
        int k = 0
        while ok and k < 7
            int setKind = k == 0 ? SET_SIM_ACTIVE : k <= 3 ? SET_SIM_FVG_STRUCTURAL : SET_SIM_FVG_FRESH
            int setTf   = k == 0 ? int(na) : (k == 1 or k == 4) ? TF_1H : (k == 2 or k == 5) ? TF_4H : TF_D
            while array.size(scratchRootSlots) > 0
                array.pop(scratchRootSlots)
            while array.size(scratchVirtualPositions) > 0
                array.pop(scratchVirtualPositions)
            ok := virtualSwapPopSetReplayRaw(engine, setKind, setTf, scratchRootSlots, scratchVirtualPositions)
            k += 1
    // Step 7 : every row in Stage F order, against the state it will see
    int group = JGROUP_E1
    while ok and group <= JGROUP_E4
        int row = 0
        while ok and row < count
            if array.get(engine.w03Store.journalGroups, row) == group
                int   op             = array.get(engine.w03Store.journalOps,             row)
                int   rootSlot       = array.get(engine.w03Store.journalTargetRootSlots, row)
                int   expectedRootId = array.get(engine.w03Store.journalExpectedRootIds, row)
                int   category       = array.get(engine.w03Store.journalCategories,      row)
                int   subtype        = array.get(engine.w03Store.journalSubtypes,        row)
                int   tfCode         = array.get(engine.w03Store.journalTfCodes,         row)
                int   originKey      = array.get(engine.w03Store.journalOriginKeys,      row)
                int   originTime     = array.get(engine.w03Store.journalOriginTimes,     row)
                int   originEndTime  = array.get(engine.w03Store.journalOriginEndTimes,  row)
                int   confirmedTime  = array.get(engine.w03Store.journalConfirmedTimes,  row)
                float pointPrice     = array.get(engine.w03Store.journalPointPrices,     row)
                float nativeBottom   = array.get(engine.w03Store.journalNativeBottoms,   row)
                float nativeTop      = array.get(engine.w03Store.journalNativeTops,      row)
                int   oldState       = array.get(engine.w03Store.journalOldStates,       row)
                int   newState       = array.get(engine.w03Store.journalNewStates,       row)
                bool  fvgFresh       = array.get(engine.w03Store.journalFvgFreshFlags,   row)
                bool  isBroad        = array.get(engine.w03Store.journalIsBroadFlags,    row)
                int   direction      = array.get(engine.w03Store.journalDirections,      row)
                int   oldMask        = array.get(engine.w03Store.journalOldMasks,        row)
                int   newMask        = array.get(engine.w03Store.journalNewMasks,        row)
                int   pairKey        = array.get(engine.w03Store.journalPairKeys,        row)
                int   slopeDir       = array.get(engine.w03Store.journalSlopeDirs,       row)
                if op == JOP_NEW_ROOT
                    // newRootApplyRaw Step 1 - 3 : the row contract
                    ok := rootSlot == SLOT_INVALID and expectedRootId == ID_NONE and not na(mintick) and mintick > 0
                    if ok
                        ok := originKey != ID_NONE and not na(originTime) and not na(confirmedTime) and newState == ROOT_ACTIVE
                    if ok
                        if category == CAT_MA
                            ok := (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and tfCode == TF_1M and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == SWING_TF_MASK_NONE
                        else if category == CAT_SWING
                            int tfMask = tfCode == TF_5M ? SWING_TF_MASK_5M : tfCode == TF_15M ? SWING_TF_MASK_15M : tfCode == TF_1H ? SWING_TF_MASK_1H : SWING_TF_MASK_NONE
                            ok := (subtype == SUB_SWING_HIGH or subtype == SUB_SWING_LOW) and (tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H) and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and not na(originEndTime) and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == tfMask
                        else if category == CAT_ACCUM
                            ok := (subtype == SUB_ACCUM_UPPER or subtype == SUB_ACCUM_LOWER) and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and na(originEndTime) and pairKey != ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == 0
                        else if category == CAT_TIME_HL
                            ok := (subtype == SUB_TIMEHL_HIGH or subtype == SUB_TIMEHL_LOW) and tfCode == TF_5M and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and not na(originEndTime) and originEndTime == confirmedTime and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask >= 1 and newMask <= 63
                        else if category == CAT_FVG
                            ok := (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and na(pointPrice) and not na(nativeBottom) and not na(nativeTop) and not na(originEndTime) and originEndTime == confirmedTime and pairKey == ID_NONE and (direction == FVG_BULLISH or direction == FVG_BEARISH) and fvgFresh and newMask == 0
                            if ok
                                ok := math.round(nativeBottom / mintick) <= math.round(nativeTop / mintick)
                        else
                            ok := false
                    // the slot the alloc will return (Step 3 proved a reused slot is free)
                    int newSlot = SLOT_INVALID
                    if ok
                        newSlot := predictedNewRootSlotRaw(engine, row)
                        ok := newSlot >= 0
                    // Attach 1 : the origin head the attach will link under
                    if ok
                        bool pendingHead = false
                        int  j = 0
                        while j < count
                            if j != row and array.get(engine.w03Store.journalOps, j) == JOP_NEW_ROOT and journalAppliedBeforeRaw(engine, j, row) and array.get(engine.w03Store.journalOriginKeys, j) == originKey
                                pendingHead := true
                            j += 1
                        // an earlier NEW_ROOT of this bar is the head: a new, valid bucket member
                        if not pendingHead and map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
                            int oldHead = map.get(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
                            ok := oldHead != newSlot and oldHead >= 0 and oldHead < array.size(engine.rootIds) and oldHead < array.size(engine.rootSlotLiveFlags) and oldHead < array.size(engine.rootOriginKeys) and oldHead < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
                            if ok
                                ok := array.get(engine.rootSlotLiveFlags, oldHead)
                            if ok
                                ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, oldHead) == array.get(engine.rootIds, oldHead) and array.get(engine.rootOriginKeys, oldHead) == originKey
                    // Attach 4 : the Accum pair side (the price attach follows below / Step 5)
                    if ok and category == CAT_ACCUM
                        bool isUpper = subtype == SUB_ACCUM_UPPER
                        map<int, int> chosenMap   = isUpper ? engine.accumPairUpperRootSlotByKey : engine.accumPairLowerRootSlotByKey
                        map<int, int> oppositeMap = isUpper ? engine.accumPairLowerRootSlotByKey : engine.accumPairUpperRootSlotByKey
                        bool pendingSame     = false
                        bool pendingOpposite = false
                        int  j = 0
                        while j < count
                            if j != row and array.get(engine.w03Store.journalOps, j) == JOP_NEW_ROOT and journalAppliedBeforeRaw(engine, j, row) and array.get(engine.w03Store.journalCategories, j) == CAT_ACCUM and array.get(engine.w03Store.journalPairKeys, j) == pairKey
                                if (array.get(engine.w03Store.journalSubtypes, j) == SUB_ACCUM_UPPER) == isUpper
                                    pendingSame := true
                                else
                                    pendingOpposite := true
                            j += 1
                        // the chosen side is never overwritten, committed or pending
                        ok := not map.contains(chosenMap, pairKey) and not pendingSame
                        // a pending opposite side is a new, valid mate; else check the committed one
                        if ok and not pendingOpposite and map.contains(oppositeMap, pairKey)
                            int mateSlot = map.get(oppositeMap, pairKey)
                            ok := mateSlot >= 0 and mateSlot != newSlot and mateSlot < array.size(engine.rootIds) and mateSlot < array.size(engine.rootSlotLiveFlags) and mateSlot < array.size(engine.rootCategories) and mateSlot < array.size(engine.rootTfCodes) and mateSlot < array.size(engine.rootPairKeys)
                            if ok
                                int mateTf = array.get(engine.rootTfCodes, mateSlot)
                                ok := array.get(engine.rootSlotLiveFlags, mateSlot) and array.get(engine.rootIds, mateSlot) != ID_NONE and array.get(engine.rootCategories, mateSlot) == CAT_ACCUM and (mateTf == TF_1H or mateTf == TF_4H or mateTf == TF_D) and array.get(engine.rootPairKeys, mateSlot) == pairKey
                    // Attach 3 : the common price order insert of a point Root, proven on the
                    // virtual order this row meets in F2 (NativeRange for FVG is Step 5)
                    if ok and category != CAT_FVG
                        ok := virtualPointOrderPreflightRaw(engine, row, mintick)
                else if op == JOP_MA_UPDATE
                    // maUpdateApplyRaw Step 1 - 2 : the row contract
                    ok := rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and not na(mintick) and mintick > 0
                    if ok
                        ok := category == CAT_MA and (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and tfCode == TF_1M and originKey != ID_NONE and not na(originTime) and not na(confirmedTime) and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and oldState == ROOT_ACTIVE and newState == ROOT_ACTIVE and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and oldMask == 0 and newMask == 0 and (na(slopeDir) or slopeDir == -1 or slopeDir == 0 or slopeDir == 1)
                    // Step 3 - 4 : the target MA Root - a committed live Root, or the Root one
                    // earlier NEW_ROOT MA of this bar creates at this predicted address
                    bool committedTarget = false
                    if ok
                        committedTarget := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags)
                        if committedTarget
                            committedTarget := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
                    if ok and committedTarget
                        if ok
                            ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootOriginTimes) and rootSlot < array.size(engine.rootConfirmedTimes) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootLastUpdateSeqs) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
                        if ok
                            ok := array.get(engine.rootCategories, rootSlot) == CAT_MA and array.get(engine.rootSubtypes, rootSlot) == subtype and array.get(engine.rootTfCodes, rootSlot) == TF_1M and array.get(engine.rootOriginKeys, rootSlot) == originKey and virtualRootStateBeforeRaw(engine, rootSlot, expectedRootId, row) == ROOT_ACTIVE and not array.get(engine.rootIsRangeRootFlags, rootSlot) and array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == FVG_NONE and not array.get(engine.rootFvgFreshFlags, rootSlot) and not array.get(engine.rootIsBroadFvgFlags, rootSlot) and array.get(engine.rootLabelMasks, rootSlot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, rootSlot) == SWING_TF_MASK_NONE and na(array.get(engine.rootNativeBottoms, rootSlot)) and na(array.get(engine.rootNativeTops, rootSlot))

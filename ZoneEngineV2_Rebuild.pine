// ZoneEngineV2_Rebuild.pine
// ZoneEngine v2 Production Library
// D01: library name / file name fixed. Visual / Conformance / StrategyBenchmark are separate files.
// I3-1: this file holds Zone logic, state, numeric Events and numeric Views only.
//       No request.*(), no box/line/label/table, no historical debug strings.

//@version=6
library("ZoneEngineV2_Rebuild", overlay = false)

// ============================================================
// W01 Batch 1 : fixed int constants / enums / masks
// Source: D02, D03, D04, A5
// ============================================================

// ---- D02 ID / slot / sentinel ------------------------------
// rootId / coreId / generationId : 1-based, 0 = none, never reused.
const int ID_NONE         = 0
// slot : >= 0, invalid = -1, only free slots are reused.
const int SLOT_INVALID    = -1
// baseSeq : >= 0, unprocessed = -1.
const int SEQ_UNSET       = -1

// ---- D03 Category ------------------------------------------
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int CAT_COUNT       = 6

// Category mask = 1 << categoryCode (D03).
// Pine has no bitwise operators, so the identical power-of-two values are fixed as constants.
const int CAT_MASK_MA      = 1
const int CAT_MASK_SWING   = 2
const int CAT_MASK_ACCUM   = 4
const int CAT_MASK_TIME_HL = 8
const int CAT_MASK_FVG     = 16
const int CAT_MASK_PSYCH   = 32
const int CAT_MASK_NONE    = 0
const int CAT_MASK_ALL     = 63

// ---- D03 Side ----------------------------------------------
const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SIDE_NONE       = 0

// ---- D03 Phase ---------------------------------------------
const int PH_WAITING      = 0
const int PH_ARMED        = 1
const int PH_ACTIVE_TOUCH = 2
const int PH_BROKEN       = 3
const int PH_FLIP_WAIT    = 4
const int PH_DORMANT      = 5

// ---- D03 Grade ---------------------------------------------
const int GR_STRONG       = 0
const int GR_NEUTRAL      = 1
const int GR_WEAK         = 2
const int GR_UNAVAILABLE  = 3

// ---- D03 Density -------------------------------------------
const int DEN_HIGH          = 0
const int DEN_NORMAL        = 1
const int DEN_BROAD_CONTEXT = 2

// ---- D03 Root state ----------------------------------------
const int ROOT_CANDIDATE      = 0
const int ROOT_ACTIVE         = 1
const int ROOT_INVALIDATED    = 2
const int ROOT_INVERSE_WAIT   = 3
const int ROOT_INVERSE_ACTIVE = 4
const int ROOT_RETIRED        = 5

// ---- D03 FVG direction -------------------------------------
const int FVG_NONE     = 0
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
// Aggregated direction mask is OR of the above; both present = 3.
const int FVG_MASK_NONE     = 0
const int FVG_MASK_BULLISH  = 1
const int FVG_MASK_BEARISH  = 2
const int FVG_MASK_BOTH     = 3

// ---- D03 Weak reason ---------------------------------------
const int WEAK_NONE     = 0
const int WEAK_BY_TOUCH = 1
const int WEAK_BY_DEPTH = 2
const int WEAK_BY_BOTH  = 3

// ---- D03 / A5 Event type -----------------------------------
// 0 is reserved as internal none. 1..15 follow the spec order.
const int EV_NONE           = 0
const int EV_TOUCH_START    = 1
const int EV_TOUCH_RESET    = 2
const int EV_WEAK_DEPTH     = 3
const int EV_LOCAL_BREAK    = 4
const int EV_GAP_BREAK      = 5
const int EV_FLIP_ATTEMPT   = 6
const int EV_FLIP_CONFIRM   = 7
const int EV_RECLAIM        = 8
const int EV_FVG_INVALIDATE = 9
const int EV_INVERSE_ATTEMPT = 10
const int EV_INVERSE_CONFIRM = 11
const int EV_GENERATION_START = 12
const int EV_MERGE          = 13
const int EV_SPLIT          = 14
const int EV_STORAGE_PRUNE  = 15

// ---- D04 fixed timeframe codes -----------------------------
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_D   = 1440

// ---- D04 fixed EMA lengths ---------------------------------
// Fixed constants. Never ZoneCfg fields. Only the slope lookback is configurable.
const int EMA_LEN_FAST = 2000
const int EMA_LEN_SLOW = 3000

// ---- D06 config error codes --------------------------------
// Smaller code wins when several violations hold.
const int ERR_OK                       = 0
const int ERR_CHART_TF_NOT_5M          = 1
const int ERR_MINTICK_INVALID          = 2
const int ERR_FIXED_TF_METADATA        = 3
const int ERR_STRONG_UNLIMITED_CONFLICT = 4
const int ERR_TOUCH_THRESHOLD_ORDER    = 5
// Stage A feed validation only (D06 / D07). Never a persistent Cfg validation failure
// and never bound to the Cfg fingerprint.
const int ERR_FEED_METADATA_MISMATCH   = 6

// ============================================================
// W01 Batch 1 : ZoneCfg
// Source: D05, A4.1, A4.2, A4.3, A4.4, A6.1, logical spec 18
// ============================================================

export type ZoneCfg
    // ---- A4.1 logical parameters (logical spec 18) ----
    float clusterMaxWidth      = 20.0
    float denseRatio           = 0.50
    float touchResetDistance   = 10.0
    int   strongUntilTouch     = 1
    bool  strongUnlimited      = false
    int   weakFromTouch        = 2
    bool  weakFromTouchOff     = false
    float weakDepthPct         = 50.0
    bool  weakDepthOff         = false
    float breakBuffer          = 2.0
    float touchTolerance       = 0.0
    int   emaSlopeLookback     = 60
    int   swingLen5m           = 10
    int   swingLen15m          = 8
    int   swingLen1h           = 6

    // ---- A4.2 Accum ----
    int   accumRangeLen        = 10
    int   accumBaseLen         = 20
    int   accumAtrLen          = 14
    int   accumMinUpperCloses  = 4
    int   accumMinLowerCloses  = 4
    int   accumMaxSameColorRun = 4
    float accumAtrMult         = 2.5
    float accumBarRatioMax     = 0.70
    float accumDriftMax        = 0.30

    // ---- A4.3 session / day / week ----
    string zoneTimezone        = "Asia/Tokyo"
    int   asiaStartHour        = 9
    int   asiaEndHour          = 14
    int   europeStartHour      = 14
    int   europeEndHour        = 19
    int   nyStartHour          = 19
    int   nyEndHour            = 3
    int   dayBoundaryHour      = 5
    int   weekBoundaryDow      = 2
    int   weekBoundaryHour     = 5

    // ---- A4.4 storage / display limits ----
    int   maxSwingRoots        = 180
    int   maxAccumBoxes        = 60
    int   maxFvgRoots          = 120
    int   maxTimeRoots         = 32
    int   maxZoneCores         = 80
    int   maxEndedGenerations  = 30
    int   maxTouchMarksPerCore = 64
    float dormantDistance      = 500.0
    int   maxZonesDrawn        = 30
    int   maxLabelsDrawn       = 30

    // ---- D05 / A6.1 category ON / OFF ----
    bool  useMa                = true
    bool  useSwing             = true
    bool  useAccum             = true
    bool  useTimeHl            = true
    bool  useFvg               = true
    bool  usePsych             = true

    // ---- D04 / A6.1 fixed timeframe metadata ----
    // Values must stay equal to TF_1M / TF_5M / TF_15M / TF_1H / TF_1H / TF_4H / TF_D.
    int   tfMa                 = 1
    int   tfBase               = 5
    int   tfSwing15            = 15
    int   tfSwing1h            = 60
    int   tfHtf1h              = 60
    int   tfHtf4h              = 240
    int   tfHtfD               = 1440

    // ---- D05 host metadata ----
    // newCfg() leaves sentinels. Harness / Main assigns real chart values before newEngine().
    int   chartTfMinutes       = 0
    float mintick              = na

// Factory (A4 / A6.1). Spec initial values only, no auto-correction of any value.
export newCfg() =>
    ZoneCfg.new()

// ============================================================
// W01 Batch 2 : read-only projection UDTs
// Source: A6.2 (Root), A6.10 (ZoneView), I5 / A6.5 / A6.6 (ZoneEvent), D09, I19.1
//
// These three UDTs are external read-only projections only.
// The internal Root / Core / Side registries stay Structure of Arrays (I6.1, D12);
// they are never rebuilt as arrays of these objects.
//
// Default / sentinel rule (D02, D03):
//   id-like field (rootId / coreId / generationId / originKey / pairKey) : ID_NONE = 0
//   baseSeq / lastUpdateSeq                                             : SEQ_UNSET = -1
//   time                                                                : na
//   price                                                               : na
//   side                                                                : SIDE_NONE
//   event type                                                          : EV_NONE
//   enum with a spec-defined none / initial value                       : that value
//   enum with no spec-defined none value (category / subtype / tfCode / density) : na
//   mask / count                                                        : 0
//   bool                                                                : false (state not yet established)
// ============================================================

// ---- A6.2 Root : read-only projection of one registry entry ----
// originKey and pairKey are ints, never strings: no origin / debug string enters the
// Production hot path (I6.5, D09). originKey is a stability key for diagnostics and
// indexing only; origin identity is decided by the full tuple comparison held in the
// Engine, never by an originKey hash match alone (I4).
export type Root
    int   rootId         = 0
    int   originKey      = 0
    int   category
    int   subtype
    int   tfCode
    int   originTime     = na
    int   originEndTime  = na
    int   confirmedTime  = na
    float pointPrice     = na
    float nativeBottom   = na
    float nativeTop      = na
    bool  isRangeRoot    = false
    bool  isDynamic      = false
    int   state          = 0
    int   pairKey        = 0
    int   direction      = 0
    bool  fvgFresh       = false
    bool  isBroadFvg     = false
    int   labelMask      = 0
    int   lastUpdateSeq  = -1

// ---- A6.10 ZoneView : per-Side read-only projection ----
// Numeric / bool only. No string field (D09, I19.1): the spec's Root / Category
// diagnostic display is rebuilt by the Visual Harness on the final bar from
// rootCountInView / categoryMask / highMask plus the name APIs.
export type ZoneView
    int   coreId                 = 0
    int   generationId           = 0
    int   side                   = 0
    float effectiveBottom        = na
    float effectiveTop           = na
    float referencePrice         = na
    int   phase                  = 0
    int   grade                  = 3
    int   cCount                 = 0
    int   hCount                 = 0
    int   density
    bool  baseStrong             = false
    int   currentTouchNo         = 0
    int   upcomingTouchNo        = 0
    bool  zoneFresh              = false
    bool  sideFresh              = false
    int   weakReason             = 0
    float maxDepthPct            = 0.0
    bool  isBroadContext         = false
    int   fvgDirectionMask       = 0
    int   fvgRootCount           = 0
    int   fvgFreshCount          = 0
    int   fvgStructuralStateMask = 0
    bool  eligible               = false
    // numeric Root / Category diagnostics (replaces the spec's diagnostic strings)
    int   rootCountInView        = 0
    int   categoryMask           = 0
    int   highMask               = 0

// ---- I5 ZoneEvent : read-only numeric projection of one current-bar Event ----
// No info / description / debug string field. Values needed to reference a fixed
// Snapshot (A6.5, A6.6) are carried as numeric fields.
export type ZoneEvent
    int   eventType    = 0
    int   time         = na
    int   baseSeq      = -1
    int   coreId       = 0
    int   generationId = 0
    int   side         = 0
    float rangeBottom  = na
    float rangeTop     = na
    int   touchNo      = 0
    int   gradeAtStart = 3
    int   weakReason   = 0
    int   rootId       = 0

// ============================================================
// W01 Batch 3 : Feed
// Source: D07, I7, A7.1, D04, D05
//
// Window 01 fixes the Base bar and metadata contract only. Field names, types and
// semantics below are frozen for later windows.
// No request.*() and no Source detection here (I3-1): the Harness fills the Feed.
// UDT field defaults use literals: Pine v6 rejects const variables as field defaults.
// ============================================================

export type Feed
    // ---- confirmed Base (5m) bar ----
    float baseOpen       = na
    float baseHigh       = na
    float baseLow        = na
    float baseClose      = na
    float basePrevClose  = na

    // ---- Base bar timing / sequence (D02, D07, A4.3) ----
    // baseOpenTime = bar open time, baseCloseTime = confirm time, epoch ms, unset = na.
    // baseSeq >= 0, unprocessed = -1.
    int   baseOpenTime   = na
    int   baseCloseTime  = na
    int   baseSeq        = -1
    bool  baseConfirmed  = false

    // ---- host metadata (D05) ----
    float mintick        = na
    int   chartTfMinutes = 0

    // ---- fixed timeframe metadata (D04), same semantics as ZoneCfg ----
    int   tfMa           = 1
    int   tfBase         = 5
    int   tfSwing15      = 15
    int   tfSwing1h      = 60
    int   tfHtf1h        = 60
    int   tfHtf4h        = 240
    int   tfHtfD         = 1440

// Factory (D07). Sentinel / na only: no confirmed Base bar, logical event count 0.
export newFeed() =>
    Feed.new()

// ============================================================
// W01 Batch 5 : Cfg validation, Cfg fingerprint, Feed metadata validation
// Source: I5, D05, D06, D07, D10, A4.1, A6.1
//
// validateCfg() is the only exported item here. Codes 0..5 only: code 6 belongs to
// the Stage A Feed check and is never a persistent Cfg failure (D06, D07).
// Fingerprint helpers are internal and never used for Root / Core / Candidate
// identity (D10), and never stored as strings (D09).
// ============================================================

// ---- fingerprint constants (physical detail, logical result unaffected) ----
const int    FP_MOD           = 2147483647
const int    FP_SEED_A        = 16777619
const int    FP_MULT_A        = 1000003
const int    FP_SEED_B        = 987654323
const int    FP_MULT_B        = 31
const int    FP_NA_KEY        = -1
const float  FP_FLOAT_SCALE   = 100000000.0
const int    FP_CHAR_FALLBACK = 127
const string FP_ALPHABET      = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/_+-:. "

// ---- internal fingerprint helpers ----
fpMixInt(int acc, int mult, int value) =>
    int t  = value % FP_MOD
    int tp = t < 0 ? t + FP_MOD : t
    (acc * mult + tp) % FP_MOD

fpIntKey(int v) =>
    na(v) ? FP_NA_KEY : v

fpBoolKey(bool v) =>
    v ? 1 : 0

fpFloatKey(float v) =>
    na(v) ? FP_NA_KEY : int(math.round(v * FP_FLOAT_SCALE))

fpStrCode(string s, int i) =>
    int pos = str.pos(FP_ALPHABET, str.substring(s, i, i + 1))
    na(pos) ? FP_CHAR_FALLBACK : pos + 1

fpMixString(int acc, int mult, string s) =>
    int a = fpMixInt(acc, mult, na(s) ? FP_NA_KEY : str.length(s))
    if not na(s) and str.length(s) > 0
        for i = 0 to str.length(s) - 1
            a := fpMixInt(a, mult, fpStrCode(s, i))
    a

// Folds every ZoneCfg field in a fixed order. Called twice with different
// seed / multiplier pairs to produce two independent int fingerprints (D10).
cfgFingerprint(ZoneCfg cfg, int seed, int mult) =>
    int h = seed
    // A4.1 logical parameters
    h := fpMixInt(h, mult, fpFloatKey(cfg.clusterMaxWidth))
    h := fpMixInt(h, mult, fpFloatKey(cfg.denseRatio))
    h := fpMixInt(h, mult, fpFloatKey(cfg.touchResetDistance))
    h := fpMixInt(h, mult, fpIntKey(cfg.strongUntilTouch))
    h := fpMixInt(h, mult, fpBoolKey(cfg.strongUnlimited))
    h := fpMixInt(h, mult, fpIntKey(cfg.weakFromTouch))
    h := fpMixInt(h, mult, fpBoolKey(cfg.weakFromTouchOff))
    h := fpMixInt(h, mult, fpFloatKey(cfg.weakDepthPct))
    h := fpMixInt(h, mult, fpBoolKey(cfg.weakDepthOff))
    h := fpMixInt(h, mult, fpFloatKey(cfg.breakBuffer))
    h := fpMixInt(h, mult, fpFloatKey(cfg.touchTolerance))
    h := fpMixInt(h, mult, fpIntKey(cfg.emaSlopeLookback))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen5m))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen15m))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen1h))
    // A4.2 Accum
    h := fpMixInt(h, mult, fpIntKey(cfg.accumRangeLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumBaseLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumAtrLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMinUpperCloses))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMinLowerCloses))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMaxSameColorRun))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumAtrMult))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumBarRatioMax))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumDriftMax))
    // A4.3 session / day / week
    h := fpMixString(h, mult, cfg.zoneTimezone)
    h := fpMixInt(h, mult, fpIntKey(cfg.asiaStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.asiaEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.europeStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.europeEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.nyStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.nyEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.dayBoundaryHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.weekBoundaryDow))
    h := fpMixInt(h, mult, fpIntKey(cfg.weekBoundaryHour))
    // A4.4 storage / display limits
    h := fpMixInt(h, mult, fpIntKey(cfg.maxSwingRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxAccumBoxes))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxFvgRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxTimeRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxZoneCores))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxEndedGenerations))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxTouchMarksPerCore))
    h := fpMixInt(h, mult, fpFloatKey(cfg.dormantDistance))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxZonesDrawn))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxLabelsDrawn))
    // D05 category ON / OFF
    h := fpMixInt(h, mult, fpBoolKey(cfg.useMa))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useSwing))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useAccum))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useTimeHl))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useFvg))
    h := fpMixInt(h, mult, fpBoolKey(cfg.usePsych))
    // D04 fixed timeframe metadata
    h := fpMixInt(h, mult, fpIntKey(cfg.tfMa))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfBase))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfSwing15))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfSwing1h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtf1h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtf4h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtfD))
    // D05 host metadata
    h := fpMixInt(h, mult, fpIntKey(cfg.chartTfMinutes))
    h := fpMixInt(h, mult, fpFloatKey(cfg.mintick))
    h

// ---- D06 Cfg validation. Smallest violating code wins, no auto-correction ----
export validateCfg(ZoneCfg cfg) =>
    int code = 0
    if cfg.chartTfMinutes != 5
        code := ERR_CHART_TF_NOT_5M
    else if na(cfg.mintick) or cfg.mintick <= 0
        code := ERR_MINTICK_INVALID
    else if cfg.tfMa != 1 or cfg.tfBase != 5 or cfg.tfSwing15 != 15 or cfg.tfSwing1h != 60 or cfg.tfHtf1h != 60 or cfg.tfHtf4h != 240 or cfg.tfHtfD != 1440
        code := ERR_FIXED_TF_METADATA
    else if cfg.strongUnlimited and not cfg.weakFromTouchOff
        code := ERR_STRONG_UNLIMITED_CONFLICT
    else if not cfg.strongUnlimited and not cfg.weakFromTouchOff and cfg.strongUntilTouch >= cfg.weakFromTouch
        code := ERR_TOUCH_THRESHOLD_ORDER
    code

// ---- D07 Feed metadata validation. Internal, Stage A only. Returns 0 or 6 ----
// No epsilon and no tick rounding: this is metadata identity, not a price comparison.
validateFeedMetadata(ZoneCfg cfg, Feed feed) =>
    bool mismatch = na(feed.mintick) or feed.mintick != cfg.mintick or feed.chartTfMinutes != cfg.chartTfMinutes or feed.tfMa != cfg.tfMa or feed.tfBase != cfg.tfBase or feed.tfSwing15 != cfg.tfSwing15 or feed.tfSwing1h != cfg.tfSwing1h or feed.tfHtf1h != cfg.tfHtf1h or feed.tfHtf4h != cfg.tfHtf4h or feed.tfHtfD != cfg.tfHtfD
    mismatch ? ERR_FEED_METADATA_MISMATCH : ERR_OK


// ============================================================
// W01 Batch 4 : ZoneEngine container + empty SoA skeleton
// Source: A6.9, I6.1, I6.4, D02, D10, D11, D12, A4.4
//
// Engine body is a UDT holding field-wise parallel arrays.
// Root registry  : Structure of Arrays, index = rootSlot.
// Core registry  : Structure of Arrays, index = coreSlot.
// Side state     : flattened parallel arrays, sideSlot = coreSlot * 2 + sideIndex
//                  (sideIndex 0 = Support view, 1 = Resistance view).
// Current-bar Events : Structure of Arrays, logical length in eventLogicalCount.
// These registries are never rebuilt as array<Root> / array<ZoneView> / array<ZoneEvent>
// or any other per-object UDT registry (I6.1, D12).
// Batch 4 provides the empty container only: no registry, Candidate, Core, Touch,
// Break, prune or validation processing.
// ============================================================

export type ZoneEngine
    // ---- scalar : config validation (Batch 5 connects validateCfg results) ----
    bool  configValid            = false
    int   cfgErrorCode           = 0
    // Cfg fingerprint x2 (D10). na = not yet computed; real computation is Batch 5.
    int   cfgFingerprintA        = na
    int   cfgFingerprintB        = na

    // ---- scalar : last processed Base (D02, D07). Committed in Stage L ----
    int   lastBaseSeq            = -1
    int   lastBaseCloseTime      = na

    // ---- scalar : ID sequences (D02). 1-based, 0 = none, never reused ----
    int   nextRootId             = 1
    int   nextCoreId             = 1
    int   nextGenerationId       = 1

    // ---- scalar : storage prune diagnostics (A4.4). Persistent, never reset per Base bar ----
    bool  storagePruned          = false
    int   prunedRootCount        = 0
    int   prunedZoneCount        = 0
    bool  touchHistoryTruncated  = false

    // ---- scalar : current-bar Event logical length. Stage B reset is Batch 7 ----
    int   eventLogicalCount      = 0

    // ---- W02 Batch 1 : scalar : revision state (I9). 17 independent revisions ----
    // Storage only. No increment, no invalidation wiring, no cache in this Batch.
    // Never merged into one dirty / topologyDirty flag (I9) and never the same thing
    // as cfgFingerprintA / cfgFingerprintB (D10).
    int   cfgRevision                       = 0
    int   rootRegistryRevision              = 0
    int   rootPriceRevision                 = 0
    int   rootEligibilityRevisionSupport    = 0
    int   rootEligibilityRevisionResistance = 0
    int   rootQualityRevision               = 0
    int   fvgStateRevision                  = 0
    int   fvgFreshRevision                  = 0
    int   priceOrderRevision                = 0
    int   candidateRevisionSupport          = 0
    int   candidateRevisionResistance       = 0
    int   coreTopologyRevision              = 0
    int   coreRangeRevision                 = 0
    int   sideStateRevision                 = 0
    int   snapshotRevision                  = 0
    int   pendingRevision                   = 0
    int   presentationRevision              = 0

    // ---- Root SoA (A6.2), index = rootSlot ----
    array<int>   rootIds
    array<int>   rootOriginKeys
    array<int>   rootCategories
    array<int>   rootSubtypes
    array<int>   rootTfCodes
    array<int>   rootOriginTimes
    array<int>   rootOriginEndTimes
    array<int>   rootConfirmedTimes
    array<float> rootPointPrices
    array<float> rootNativeBottoms
    array<float> rootNativeTops
    array<bool>  rootIsRangeRootFlags
    array<bool>  rootIsDynamicFlags
    array<int>   rootStates
    array<int>   rootPairKeys
    array<int>   rootDirections
    array<bool>  rootFvgFreshFlags
    array<bool>  rootIsBroadFvgFlags
    array<int>   rootLabelMasks
    array<int>   rootLastUpdateSeqs
    // tick-normalised comparison values kept beside the original float prices (I6.4)
    array<int>   rootPointTicks
    array<int>   rootNativeBottomTicks
    array<int>   rootNativeTopTicks

    // ---- W02 Batch 1 : Root physical slot lifecycle (I6.2, I17.1) ----
    // rootSlotLiveFlags : index = rootSlot. true = a Live Root currently owns this
    //   physical slot, false = unused or free slot. Physical slot life is a different
    //   concept from the A6.2 Root state: ROOT_RETIRED is never treated as slot dead.
    // rootFreeSlots     : LIFO free stack holding freed rootSlots only. Future alloc
    //   pops, future free pushes. array.remove(0) / array.unshift() are never used.
    // rootLiveSlots     : physical rootSlot set of currently Live Roots. Not price
    //   order, not Root ID order, not Candidate tie-break order, not a public order;
    //   each Live rootSlot appears at most once.
    // rootIdOrderSlots  : rootSlots (not rootIds) of Live Roots in Root ID ascending
    //   order. Separate array from the price order (I6.2).
    // Ownership token for a Root slot is rootIds[rootSlot] itself: no separate owner
    // token array is introduced. A stale-capable reference keeps rootSlot +
    // expectedRootId and is valid only when the slot is in range, rootSlotLiveFlags
    // is true and rootIds[rootSlot] == expectedRootId.
    // Batch 1 adds the storage only: no alloc / free / reset / validation helper.
    array<bool>  rootSlotLiveFlags
    array<int>   rootFreeSlots
    array<int>   rootLiveSlots
    array<int>   rootIdOrderSlots
    // W02 Batch 4 : I11-1 Root ID -> rootSlot. Live keys only: a freed Root ID is
    // removed from the map, ID_NONE is never a key, and one rootId never maps to
    // two slots. A map hit alone is not ownership proof (see the Batch 2 helpers).
    map<int, int> rootIdToSlot

    // ---- W02 Batch 15 : Root Category / TF / state set index storage (I11-4) ----
    // Search index foundation for the Category, timeframe and Root state sets: six
    // independent sets per dimension, one per existing enum value (no new Category,
    // TF code or state is introduced). Every element is a physical rootSlot, never a
    // rootId, originKey, category / tf / state code, price or public Root index.
    // rootCategorySetPositions / rootTfSetPositions / rootStateSetPositions are
    // indexed by rootSlot and hold that Root's position inside the set it currently
    // belongs to in that dimension, SLOT_INVALID when it belongs to none, which is
    // what later makes a detach an O(1) swap-pop.
    // The sets carry no order semantics: never a Root ID, price, Candidate
    // tie-break, public Root, prune or Event order, and nothing is sorted.
    // engine.rootCategories / rootTfCodes / rootStates stay the logical source of
    // truth; these sets are an index and never write back into those fields. Once
    // connected, a registered Root owning a slot belongs to exactly one set per
    // dimension, never to two and never twice to the same one.
    // ROOT_RETIRED is a Root state, not a physical free slot: a Retired Root that
    // still owns its slot stays in the Retired set. Conversely a slot fresh out of
    // rootAllocSlotRaw has no Root content yet (category and tfCode are na even
    // though rootStates holds the ROOT_CANDIDATE sentinel), so it holds no
    // membership in any dimension; membership is established atomically for all
    // three dimensions by the later Root content registration path.
    // Batch 15 added this storage; Batch 16 connected the three reverse-position
    // arrays to the Root physical slot growth / reset lifecycle; Batch 17 added the
    // validation, add-all and detach-all raw helpers. Real membership is still 0
    // entries and their call sites = 0: Root content registration, Root state
    // transition and the detach on free come later.
    array<int>   categoryMaRootSlots
    array<int>   categorySwingRootSlots
    array<int>   categoryAccumRootSlots
    array<int>   categoryTimeHlRootSlots
    array<int>   categoryFvgRootSlots
    array<int>   categoryPsychRootSlots

    array<int>   tf1mRootSlots
    array<int>   tf5mRootSlots
    array<int>   tf15mRootSlots
    array<int>   tf1hRootSlots
    array<int>   tf4hRootSlots
    array<int>   tfDRootSlots

    array<int>   stateCandidateRootSlots
    array<int>   stateActiveRootSlots
    array<int>   stateInvalidatedRootSlots
    array<int>   stateInverseWaitRootSlots
    array<int>   stateInverseActiveRootSlots
    array<int>   stateRetiredRootSlots

    array<int>   rootCategorySetPositions
    array<int>   rootTfSetPositions
    array<int>   rootStateSetPositions

    // ---- W02 Batch 18 : Accum pair upper / lower Root index storage (I11-5) ----
    // Foundation for pairKey -> upper boundary Root and pairKey -> lower boundary
    // Root. The key is the existing engine.rootPairKeys value of the Accum boundary
    // Roots: no pair identity key is invented here, nothing is re-hashed, and an
    // originKey, a Root ID combination, a price or a string is never used as the
    // key. The value is a physical rootSlot, never a rootId (read rootIds[rootSlot]
    // when the ID is needed) and never a public Root index.
    // Upper and lower live in two separate maps, at most one entry each per pairKey,
    // so a pair whose second boundary is not registered yet is representable; pair
    // completeness is not decided here.
    // The index carries no order semantics: never a Root ID, price, Candidate,
    // prune, Event or public Root order. Only Accum Roots ever enter it, and
    // pairKey ID_NONE is never registered.
    // Which boundary is upper and which is lower is decided by the later Accum
    // registration path from the spec's boundary identity; this Batch depends on no
    // numeric subtype mapping.
    // Batch 18 adds the storage only: both maps stay empty (no map.put / map.remove
    // anywhere), no helper exists and nothing is connected (call sites = 0).
    // Registration, validation, detach, Root free and prune come later. The logical
    // source of truth stays the Root SoA (rootCategories, rootSubtypes,
    // rootPairKeys, rootIds, rootSlotLiveFlags); this index never writes back to it.
    map<int, int> accumPairUpperRootSlotByKey
    map<int, int> accumPairLowerRootSlotByKey

    // ---- W02 Batch 19 : FVG non-price set index storage (I11-6 / I14) ----
    // Foundation for the non-price FVG sets. The FVG Source timeframes are exactly
    // TF_1H, TF_4H and TF_D, so Fresh and structurally active have three sets each
    // and no 1m / 5m / 15m FVG set exists.
    // Every element is a physical rootSlot, never a rootId, originKey, public Root
    // index, tfCode, direction code or price.
    // Four independent dimensions, each with its own reverse lookup indexed by
    // rootSlot (SLOT_INVALID while the Root belongs to no set of that dimension):
    //   Fresh            -> freshFvg1h / 4h / D              : rootFvgFreshSetPositions
    //   Structural state -> structurallyActiveFvg1h / 4h / D,
    //                       inverseWaitFvg, inverseActiveFvg  : rootFvgStructuralStateSetPositions
    //   Direction        -> bullishFvg, bearishFvg           : rootFvgDirectionSetPositions
    //   Broad            -> broadFvg                         : rootFvgBroadSetPositions
    // Inside one dimension a Root belongs to at most one set; across dimensions it
    // may belong to one set of each (a Bullish, 1H Fresh, 1H structurally active,
    // Broad FVG is legal). FVG_NONE joins no direction set, and a Root whose
    // isBroadFvg is false stays SLOT_INVALID in the Broad dimension.
    // The sets carry no order semantics, so a later detach can be a swap-pop.
    // The logical source of truth stays the Root SoA (rootFvgFreshFlags,
    // rootTfCodes, rootStates, rootDirections, rootIsBroadFvgFlags); this index is
    // never written back into those fields.
    // Batch 19 adds the storage only: all eleven sets stay empty, membership is 0
    // entries, no helper exists and call sites = 0. The physical slot growth /
    // reset connection, FVG creation, structural invalidation, the Fresh, Inverse
    // and direction lifecycles and the Broad decision come later, and the
    // NativeRange interval index (fvgNativeRangeIntervalIndex) is a separate later
    // Batch: no price sort, binary search or interval query is added here.
    array<int>   freshFvg1hRootSlots
    array<int>   freshFvg4hRootSlots
    array<int>   freshFvgDRootSlots

    array<int>   structurallyActiveFvg1hRootSlots
    array<int>   structurallyActiveFvg4hRootSlots
    array<int>   structurallyActiveFvgDRootSlots

    array<int>   inverseWaitFvgRootSlots
    array<int>   inverseActiveFvgRootSlots

    array<int>   bullishFvgRootSlots
    array<int>   bearishFvgRootSlots

    array<int>   broadFvgRootSlots

    array<int>   rootFvgFreshSetPositions
    array<int>   rootFvgStructuralStateSetPositions
    array<int>   rootFvgDirectionSetPositions
    array<int>   rootFvgBroadSetPositions

    // ---- Core SoA (A6.8), index = coreSlot ----
    array<int>   coreIds
    array<int>   coreGenerationIds
    array<bool>  coreZoneFreshFlags
    array<float> corePhysicalBottoms
    array<float> corePhysicalTops
    array<int>   coreCreatedTimes
    array<int>   coreLastSeenTimes
    array<bool>  coreDormantFlags

    // ---- W02 Batch 1 : Core physical slot lifecycle (I6.3, I17.1) ----
    // coreSlotLiveFlags : index = coreSlot. true = a Live or Dormant ZoneCore owns
    //   this physical slot. Separate from coreDormantFlags: a Dormant Core keeps
    //   coreSlotLiveFlags = true with coreDormantFlags = true and is never treated
    //   as a free slot.
    // coreFreeSlots     : LIFO free stack holding freed coreSlots only. Future alloc
    //   pops, future free pushes. array.remove(0) / array.unshift() are never used.
    // coreLiveSlots     : physical coreSlot set of the held Live / Dormant Cores.
    //   One physical Core = one coreSlot; Support and Resistance are never registered
    //   as separate Cores and keep using the flattened Side SoA. This order is not
    //   used as the public View order or a Merge / Split tie-break order.
    // Ownership token for a Core slot is coreIds[coreSlot] itself: no separate owner
    // token array. A stale-capable reference keeps coreSlot + expectedCoreId and is
    // valid only when the slot is in range, coreSlotLiveFlags is true and
    // coreIds[coreSlot] == expectedCoreId. Side ownership is identified by
    // coreId + sideIndex, with no separate Side token. The Generation ID is the Zone
    // generation's logical identity and is never used as the slot ownership token.
    // Batch 1 adds the storage only: no alloc / free / reset / validation helper.
    array<bool>  coreSlotLiveFlags
    array<int>   coreFreeSlots
    array<int>   coreLiveSlots
    // W02 Batch 6 : coreIdOrderSlots : physical coreSlots (not coreIds) of the held
    //   Live / Dormant Cores in Core ID ascending order, at most one entry per
    //   coreSlot and never one entry per Side. This is the foundation of the future
    //   Public View order; it is not a price, Merge / Split, Phase or prune order.
    //   Maintained by coreAllocSlotRaw / coreFreeSlotRaw, never by the raw reset.
    array<int>   coreIdOrderSlots
    // W02 Batch 4 : I11-8 Core ID -> coreSlot. Keys are the Core IDs whose slot is
    // currently owned, Dormant Cores included: only a free removes a key. ID_NONE is
    // never a key, and Support / Resistance never get separate keys.
    map<int, int> coreIdToSlot

    // ---- W02 Batch 10 : TouchMark ring storage (I17.2) ----
    // A TouchMark keeps the 8 logical fields of A6.4 only: baseSeq, time, side,
    // contactBottom, contactTop, closeAtTouch, generationId, isNormalTouch. The
    // owner / head / count values below are physical ring metadata, not TouchMark
    // fields, and no TouchMark UDT or array<TouchMark> is ever created.
    // Layout: one fixed-length block per Core, flattened into Engine-wide SoA.
    //   blockBase     = coreSlot * touchMarkCapacityPerCore
    //   physicalIndex = blockBase + ringOffset, 0 <= ringOffset < capacity
    // touchMarkCapacityPerCore is a physical addressing snapshot of the capacity
    // source cfg.maxTouchMarksPerCore (no new constant, no 64 fallback, no clamp
    // and no new validation); newEngine() copies it and updateConfirmed5m never
    // changes it. Rebuilding blocks after a Cfg change is a later Batch.
    // touchMarkRingOwnerCoreIds : index = coreSlot, the Core ID owning the block
    //   right now, ID_NONE when unowned or free. It is a Core ID, never a
    //   Generation ID, and a reused slot must not keep the old Core ID.
    // touchMarkRingHeads : index = coreSlot, ring offset of the OLDEST logical
    //   TouchMark; 0 while empty and while the capacity is 0.
    // touchMarkRingCounts : index = coreSlot, number of logically valid TouchMarks;
    //   0 while empty, and later never above the capacity.
    // Logical chronology is read from the head - offset = (head + logicalIndex) %
    // capacity - and the physical ring order is never used as the public order, the
    // Merge / Split order or the Event order (I17.2).
    // Batch 10 adds the storage schema only: the flattened arrays stay empty, no
    // block is allocated and no helper exists. Block allocation on Core slot
    // creation and the ownership / metadata reset on reuse are Batch 11.
    int          touchMarkCapacityPerCore = 0
    array<int>   touchMarkRingOwnerCoreIds
    array<int>   touchMarkRingHeads
    array<int>   touchMarkRingCounts
    array<int>   touchMarkBaseSeqs
    array<int>   touchMarkTimes
    array<int>   touchMarkSides
    array<float> touchMarkContactBottoms
    array<float> touchMarkContactTops
    array<float> touchMarkCloseAtTouches
    array<int>   touchMarkGenerationIds
    array<bool>  touchMarkIsNormalTouchFlags

    // ---- Side SoA (A6.3 SideHistory), index = sideSlot = coreSlot * 2 + sideIndex ----
    array<int>   sideTouchCounts
    array<bool>  sideWeakByTouchFlags
    array<bool>  sideWeakByDepthFlags
    array<float> sideMaxDepthPcts
    array<bool>  sideFreshFlags
    array<int>   sidePhases
    array<int>   sideGrades
    array<int>   sideCurrentTouchNos
    array<int>   sideUpcomingTouchNos
    array<int>   sideArmedFromSeqs
    array<float> sideLastArmedRangeBottoms
    array<float> sideLastArmedRangeTops
    array<int>   sideLastNormalTouchTimes
    array<int>   sideFlipAttemptCounts
    array<int>   sideInverseAttemptCounts
    array<int>   sideLastFlipConfirmSeqs

    // ---- Side SoA (A6.7 SideViewState scalars), same sideSlot index ----
    array<float> sideEffectiveBottoms
    array<float> sideEffectiveTops
    array<float> sideReferencePrices
    array<int>   sideCCounts
    array<int>   sideHCounts
    array<int>   sideDensities
    array<bool>  sideBaseStrongFlags
    array<bool>  sideHasNonPsychRootFlags
    array<bool>  sideIsBroadContextFlags
    array<bool>  sideEligibleFlags

    // ---- W02 Batch 13 : Side Phase set index storage (I11-9) ----
    // Search index foundation for the Phase sets. One independent set per Phase
    // enum (Waiting, Armed, ActiveTouch, Broken, FlipWait, Dormant); every element
    // is a physical sideSlot (= coreSlot * 2 + sideIndex, 0 = Support,
    // 1 = Resistance) and never a coreSlot, Core ID, Generation ID or public View
    // index.
    // sidePhaseSetPositions : index = physical sideSlot, value = that Side's
    // position inside the Phase set it currently belongs to, SLOT_INVALID when it
    // belongs to none. It is the reverse lookup that later makes a detach O(1) via
    // swap-pop.
    // The sets carry no order semantics: they are never read as the public View,
    // Core ID, Generation, Merge / Split, Event or price order, and anything
    // extracted from them is put back into the canonical order by its caller.
    // engine.sidePhases stays the logical source of truth; these sets are only an
    // index, and a later transition updates the Phase field and the membership
    // together.
    // Batch 13 adds the storage only: the arrays stay empty, no membership exists,
    // no helper is created and nothing is connected (call sites = 0). Side slot
    // growth, ownership start, free / reset and Phase transitions come later.
    array<int>   phaseWaitingSideSlots
    array<int>   phaseArmedSideSlots
    array<int>   phaseActiveTouchSideSlots
    array<int>   phaseBrokenSideSlots
    array<int>   phaseFlipWaitSideSlots
    array<int>   phaseDormantSideSlots
    array<int>   sidePhaseSetPositions

    // ---- W02 Batch 9 : Candidate reusable scratch (I17.1) ----
    // Engine-owned scratch for Candidate evaluation. Four independent regions -
    // Support old structure, Support new structure, Resistance old structure,
    // Resistance new structure - so the areas needed at the same time never share
    // an array; none of the four is ever aliased to another.
    // Each region is one array<int> holding physical rootSlots (not rootIds, since
    // the Candidate hot path reads the Root SoA directly) plus its logical length.
    // The array keeps its physical capacity: a future reuse resets the region by
    // setting its logical length to 0 and overwriting entries, never with
    // array.clear() or a fresh array.new (I17.1). Only indices 0 .. length - 1 are
    // logically valid.
    // An adopted Candidate / Core / Side / Snapshot Root set is never stored here
    // and never holds a reference to a scratch array: a winner copies what it needs
    // into independently owned storage.
    // Batch 9 adds the storage only: no reset / append / read helper, no Candidate
    // evaluation, and no data is written yet (call sites = 0).
    array<int>   candidateScratchSupportOldRootSlots
    int          candidateScratchSupportOldLength       = 0
    array<int>   candidateScratchSupportNewRootSlots
    int          candidateScratchSupportNewLength       = 0
    array<int>   candidateScratchResistanceOldRootSlots
    int          candidateScratchResistanceOldLength    = 0
    array<int>   candidateScratchResistanceNewRootSlots
    int          candidateScratchResistanceNewLength    = 0

    // ---- current-bar Event SoA (I5, ZoneEvent contract) ----
    array<int>   eventTypes
    array<int>   eventTimes
    array<int>   eventBaseSeqs
    array<int>   eventCoreIds
    array<int>   eventGenerationIds
    array<int>   eventSides
    array<float> eventRangeBottoms
    array<float> eventRangeTops
    array<int>   eventTouchNos
    array<int>   eventGradeAtStarts
    array<int>   eventWeakReasons
    array<int>   eventRootIds

// Factory (A6.9). Always returns a ZoneEngine object, even for an invalid cfg (D05):
// configValid stays false until Batch 5 connects validateCfg(). No validation here.
export newEngine(ZoneCfg cfg) =>
    ZoneEngine e = ZoneEngine.new()

    e.rootIds                   := array.new_int(0)
    e.rootOriginKeys            := array.new_int(0)
    e.rootCategories            := array.new_int(0)
    e.rootSubtypes              := array.new_int(0)
    e.rootTfCodes               := array.new_int(0)
    e.rootOriginTimes           := array.new_int(0)
    e.rootOriginEndTimes        := array.new_int(0)
    e.rootConfirmedTimes        := array.new_int(0)
    e.rootPointPrices           := array.new_float(0)
    e.rootNativeBottoms         := array.new_float(0)
    e.rootNativeTops            := array.new_float(0)
    e.rootIsRangeRootFlags      := array.new_bool(0)
    e.rootIsDynamicFlags        := array.new_bool(0)
    e.rootStates                := array.new_int(0)
    e.rootPairKeys              := array.new_int(0)
    e.rootDirections            := array.new_int(0)
    e.rootFvgFreshFlags         := array.new_bool(0)
    e.rootIsBroadFvgFlags       := array.new_bool(0)
    e.rootLabelMasks            := array.new_int(0)
    e.rootLastUpdateSeqs        := array.new_int(0)
    e.rootPointTicks            := array.new_int(0)
    e.rootNativeBottomTicks     := array.new_int(0)
    e.rootNativeTopTicks        := array.new_int(0)

    // W02 Batch 1 : Root slot lifecycle storage, empty at Engine creation.
    e.rootSlotLiveFlags         := array.new_bool(0)
    e.rootFreeSlots             := array.new_int(0)
    e.rootLiveSlots             := array.new_int(0)
    e.rootIdOrderSlots          := array.new_int(0)
    // W02 Batch 4 : per-Engine Root ID index, never a global.
    e.rootIdToSlot              := map.new<int, int>()

    e.coreIds                   := array.new_int(0)
    e.coreGenerationIds         := array.new_int(0)
    e.coreZoneFreshFlags        := array.new_bool(0)
    e.corePhysicalBottoms       := array.new_float(0)
    e.corePhysicalTops          := array.new_float(0)
    e.coreCreatedTimes          := array.new_int(0)
    e.coreLastSeenTimes         := array.new_int(0)
    e.coreDormantFlags          := array.new_bool(0)

    // W02 Batch 1 : Core slot lifecycle storage, empty at Engine creation.
    e.coreSlotLiveFlags         := array.new_bool(0)
    e.coreFreeSlots             := array.new_int(0)
    e.coreLiveSlots             := array.new_int(0)
    // W02 Batch 6 : Core ID ascending order foundation for the Public View order.
    e.coreIdOrderSlots          := array.new_int(0)
    // W02 Batch 4 : per-Engine Core ID index, never a global.
    e.coreIdToSlot              := map.new<int, int>()

    e.sideTouchCounts           := array.new_int(0)
    e.sideWeakByTouchFlags      := array.new_bool(0)
    e.sideWeakByDepthFlags      := array.new_bool(0)
    e.sideMaxDepthPcts          := array.new_float(0)
    e.sideFreshFlags            := array.new_bool(0)
    e.sidePhases                := array.new_int(0)
    e.sideGrades                := array.new_int(0)
    e.sideCurrentTouchNos       := array.new_int(0)
    e.sideUpcomingTouchNos      := array.new_int(0)
    e.sideArmedFromSeqs         := array.new_int(0)
    e.sideLastArmedRangeBottoms := array.new_float(0)
    e.sideLastArmedRangeTops    := array.new_float(0)
    e.sideLastNormalTouchTimes  := array.new_int(0)
    e.sideFlipAttemptCounts     := array.new_int(0)
    e.sideInverseAttemptCounts  := array.new_int(0)
    e.sideLastFlipConfirmSeqs   := array.new_int(0)

    e.sideEffectiveBottoms      := array.new_float(0)
    e.sideEffectiveTops         := array.new_float(0)
    e.sideReferencePrices       := array.new_float(0)
    e.sideCCounts               := array.new_int(0)
    e.sideHCounts               := array.new_int(0)
    e.sideDensities             := array.new_int(0)
    e.sideBaseStrongFlags       := array.new_bool(0)
    e.sideHasNonPsychRootFlags  := array.new_bool(0)
    e.sideIsBroadContextFlags   := array.new_bool(0)
    e.sideEligibleFlags         := array.new_bool(0)

    // W02 Batch 15 : Root Category / TF / state index sets and their reverse
    // position lookups, all empty. Each array.new_int(0) is its own instance.
    e.categoryMaRootSlots          := array.new_int(0)
    e.categorySwingRootSlots       := array.new_int(0)
    e.categoryAccumRootSlots       := array.new_int(0)
    e.categoryTimeHlRootSlots      := array.new_int(0)
    e.categoryFvgRootSlots         := array.new_int(0)
    e.categoryPsychRootSlots       := array.new_int(0)
    e.tf1mRootSlots                := array.new_int(0)
    e.tf5mRootSlots                := array.new_int(0)
    e.tf15mRootSlots               := array.new_int(0)
    e.tf1hRootSlots                := array.new_int(0)
    e.tf4hRootSlots                := array.new_int(0)
    e.tfDRootSlots                 := array.new_int(0)
    e.stateCandidateRootSlots      := array.new_int(0)
    e.stateActiveRootSlots         := array.new_int(0)
    e.stateInvalidatedRootSlots    := array.new_int(0)
    e.stateInverseWaitRootSlots    := array.new_int(0)
    e.stateInverseActiveRootSlots  := array.new_int(0)
    e.stateRetiredRootSlots        := array.new_int(0)
    e.rootCategorySetPositions     := array.new_int(0)
    e.rootTfSetPositions           := array.new_int(0)
    e.rootStateSetPositions        := array.new_int(0)

    // W02 Batch 19 : FVG non-price index sets and their reverse position
    // lookups, all empty. Each array.new_int(0) is its own instance.
    e.freshFvg1hRootSlots                  := array.new_int(0)
    e.freshFvg4hRootSlots                  := array.new_int(0)
    e.freshFvgDRootSlots                   := array.new_int(0)
    e.structurallyActiveFvg1hRootSlots     := array.new_int(0)
    e.structurallyActiveFvg4hRootSlots     := array.new_int(0)
    e.structurallyActiveFvgDRootSlots      := array.new_int(0)
    e.inverseWaitFvgRootSlots              := array.new_int(0)
    e.inverseActiveFvgRootSlots            := array.new_int(0)
    e.bullishFvgRootSlots                  := array.new_int(0)
    e.bearishFvgRootSlots                  := array.new_int(0)
    e.broadFvgRootSlots                    := array.new_int(0)
    e.rootFvgFreshSetPositions             := array.new_int(0)
    e.rootFvgStructuralStateSetPositions   := array.new_int(0)
    e.rootFvgDirectionSetPositions         := array.new_int(0)
    e.rootFvgBroadSetPositions             := array.new_int(0)

    // W02 Batch 18 : Accum pair upper / lower Root indexes, one instance each and
    // both empty. Per-Engine maps, never globals and never aliased to each other.
    e.accumPairUpperRootSlotByKey  := map.new<int, int>()
    e.accumPairLowerRootSlotByKey  := map.new<int, int>()

    // W02 Batch 10 : TouchMark ring geometry and storage. The capacity comes from
    // the Cfg as received, without correction; the blocks themselves are allocated
    // in a later Batch, so every array starts empty.
    e.touchMarkCapacityPerCore     := cfg.maxTouchMarksPerCore
    e.touchMarkRingOwnerCoreIds    := array.new_int(0)
    e.touchMarkRingHeads           := array.new_int(0)
    e.touchMarkRingCounts          := array.new_int(0)
    e.touchMarkBaseSeqs            := array.new_int(0)
    e.touchMarkTimes               := array.new_int(0)
    e.touchMarkSides               := array.new_int(0)
    e.touchMarkContactBottoms      := array.new_float(0)
    e.touchMarkContactTops         := array.new_float(0)
    e.touchMarkCloseAtTouches      := array.new_float(0)
    e.touchMarkGenerationIds       := array.new_int(0)
    e.touchMarkIsNormalTouchFlags  := array.new_bool(0)

    // W02 Batch 13 : six independent Phase sets plus the sideSlot -> position
    // reverse lookup, all empty. Each array.new_int(0) creates its own instance.
    e.phaseWaitingSideSlots      := array.new_int(0)
    e.phaseArmedSideSlots        := array.new_int(0)
    e.phaseActiveTouchSideSlots  := array.new_int(0)
    e.phaseBrokenSideSlots       := array.new_int(0)
    e.phaseFlipWaitSideSlots     := array.new_int(0)
    e.phaseDormantSideSlots      := array.new_int(0)
    e.sidePhaseSetPositions      := array.new_int(0)

    // W02 Batch 9 : four independent Candidate scratch regions, empty and logically
    // zero-length. Each array.new_int(0) call creates its own instance: no aliasing.
    e.candidateScratchSupportOldRootSlots    := array.new_int(0)
    e.candidateScratchSupportOldLength       := 0
    e.candidateScratchSupportNewRootSlots    := array.new_int(0)
    e.candidateScratchSupportNewLength       := 0
    e.candidateScratchResistanceOldRootSlots := array.new_int(0)
    e.candidateScratchResistanceOldLength    := 0
    e.candidateScratchResistanceNewRootSlots := array.new_int(0)
    e.candidateScratchResistanceNewLength    := 0

    e.eventTypes                := array.new_int(0)
    e.eventTimes                := array.new_int(0)
    e.eventBaseSeqs             := array.new_int(0)
    e.eventCoreIds              := array.new_int(0)
    e.eventGenerationIds        := array.new_int(0)
    e.eventSides                := array.new_int(0)
    e.eventRangeBottoms         := array.new_float(0)
    e.eventRangeTops            := array.new_float(0)
    e.eventTouchNos             := array.new_int(0)
    e.eventGradeAtStarts        := array.new_int(0)
    e.eventWeakReasons          := array.new_int(0)
    e.eventRootIds              := array.new_int(0)

    // Batch 5 : connect cfg validation and the two Cfg fingerprints (D06, D10).
    // An invalid cfg still returns an object; cfg is never auto-corrected.
    // Feed metadata (code 6) is never mixed into this persistent Cfg state.
    int errorCode = validateCfg(cfg)
    e.cfgErrorCode     := errorCode
    e.configValid      := errorCode == ERR_OK
    e.cfgFingerprintA  := cfgFingerprint(cfg, FP_SEED_A, FP_MULT_A)
    e.cfgFingerprintB  := cfgFingerprint(cfg, FP_SEED_B, FP_MULT_B)

    e

// ============================================================
// W02 Batch 2 : Root physical slot lifecycle (raw helpers)
// Source: I6.2, I17.1, D02, D12
//
// Internal only. These three helpers own the physical Root slot lifecycle of the
// Root SoA, of the Batch 1 lifecycle arrays and of the Batch 4 Root ID index, and
// nothing else:
//   - Batch 2 built the raw lifecycle; Batch 4 connected the I11-1
//     Root ID -> rootSlot index (rootIdToSlot) into the alloc / free paths below,
//     where a free also requires the index entry to agree with the slot
//   - Batch 16 connected the I11-4 reverse-position arrays (Category / TF / state)
//     and Batch 20 the I11-6 FVG reverse-position arrays (Fresh, structural state,
//     direction, Broad) to the Root physical slot growth / reset lifecycle; the
//     sets of both indexes stay empty, so no membership exists yet
//   - still not connected: Category / TF / state membership, FVG membership and
//     the FVG NativeRange interval index, origin tuple index, price order,
//     participation index
//   - no revision increment (I9 revisions stay untouched here)
//   - no Root content (category, price, tick, time, state semantics)
// They are therefore not wired into any Stage or Public API in this Batch:
// call sites = 0 until a later Batch adds the index + revision aware registry
// mutation on top of them.
//
// Slot ownership token is rootIds[rootSlot] itself (Batch 1 contract): no separate
// owner token array exists. A stale-capable reference keeps rootSlot +
// expectedRootId and is valid only when the slot is in range,
// rootSlotLiveFlags[rootSlot] is true and rootIds[rootSlot] == expectedRootId.
// The ownership validation helper is not created in this Batch.
//
// array.remove(0), array.shift() and array.unshift() are never used (D12, I17.2).
// Unset values keep their spec sentinel: na stays na and is never replaced by 0
// (I18), while the element type of every array is preserved.
// ============================================================

// Returns one existing physical rootSlot to the unused / free sentinel state.
// Precondition: rootSlot already exists inside the physical arrays. No range check
// helper and no runtime.error is added here.
// Touches the Root SoA 23 arrays, rootSlotLiveFlags and the seven index
// reverse-position arrays of this slot (Category, TF, state, FVG Fresh, FVG
// structural state, FVG direction, FVG Broad) only: the index sets themselves,
// rootFreeSlots, rootLiveSlots, rootIdOrderSlots, rootIdToSlot, nextRootId and the
// revisions are left alone.
rootResetSlotRaw(ZoneEngine engine, int rootSlot) =>
    array.set(engine.rootIds,               rootSlot, ID_NONE)
    array.set(engine.rootOriginKeys,        rootSlot, ID_NONE)
    array.set(engine.rootCategories,        rootSlot, int(na))
    array.set(engine.rootSubtypes,          rootSlot, int(na))
    array.set(engine.rootTfCodes,           rootSlot, int(na))
    array.set(engine.rootOriginTimes,       rootSlot, int(na))
    array.set(engine.rootOriginEndTimes,    rootSlot, int(na))
    array.set(engine.rootConfirmedTimes,    rootSlot, int(na))
    array.set(engine.rootPointPrices,       rootSlot, float(na))
    array.set(engine.rootNativeBottoms,     rootSlot, float(na))
    array.set(engine.rootNativeTops,        rootSlot, float(na))
    array.set(engine.rootIsRangeRootFlags,  rootSlot, false)
    array.set(engine.rootIsDynamicFlags,    rootSlot, false)
    array.set(engine.rootStates,            rootSlot, ROOT_CANDIDATE)
    array.set(engine.rootPairKeys,          rootSlot, ID_NONE)
    array.set(engine.rootDirections,        rootSlot, FVG_NONE)
    array.set(engine.rootFvgFreshFlags,     rootSlot, false)
    array.set(engine.rootIsBroadFvgFlags,   rootSlot, false)
    array.set(engine.rootLabelMasks,        rootSlot, 0)
    array.set(engine.rootLastUpdateSeqs,    rootSlot, SEQ_UNSET)
    array.set(engine.rootPointTicks,        rootSlot, int(na))
    array.set(engine.rootNativeBottomTicks, rootSlot, int(na))
    array.set(engine.rootNativeTopTicks,    rootSlot, int(na))
    array.set(engine.rootSlotLiveFlags,     rootSlot, false)
    // W02 Batch 16 : this slot belongs to no Category / TF / state set (I11-4). The
    // sets themselves are not scanned here, and the ROOT_CANDIDATE sentinel written
    // above is a raw slot state, never an automatic membership of the Candidate set.
    array.set(engine.rootCategorySetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootTfSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootStateSetPositions,    rootSlot, SLOT_INVALID)
    // W02 Batch 20 : the same for the four FVG index dimensions (I11-6 / I14). The
    // FVG sets are not scanned here, and the raw sentinels written above
    // (FVG_NONE, fvgFresh false, isBroadFvg false, ROOT_CANDIDATE) never mean a
    // membership of the direction, Fresh, structural state or Broad sets.
    array.set(engine.rootFvgFreshSetPositions,           rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgDirectionSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgBroadSetPositions,           rootSlot, SLOT_INVALID)

// Starts ownership of one physical Root slot and returns that rootSlot.
// Free slots are reused first (LIFO pop), otherwise the physical arrays grow by one
// sentinel entry. A reused slot never reuses the old Root ID: nextRootId only
// increases (D02). Only rootId and physical ownership are written here.
rootAllocSlotRaw(ZoneEngine engine) =>
    int rootSlot = SLOT_INVALID
    // Step 1 / Step 2 : free stack first, LIFO. Never array.shift / array.remove(0).
    if array.size(engine.rootFreeSlots) > 0
        rootSlot := array.pop(engine.rootFreeSlots)
        rootResetSlotRaw(engine, rootSlot)
    else
        rootSlot := array.size(engine.rootIds)
        array.push(engine.rootIds,               ID_NONE)
        array.push(engine.rootOriginKeys,        ID_NONE)
        array.push(engine.rootCategories,        int(na))
        array.push(engine.rootSubtypes,          int(na))
        array.push(engine.rootTfCodes,           int(na))
        array.push(engine.rootOriginTimes,       int(na))
        array.push(engine.rootOriginEndTimes,    int(na))
        array.push(engine.rootConfirmedTimes,    int(na))
        array.push(engine.rootPointPrices,       float(na))
        array.push(engine.rootNativeBottoms,     float(na))
        array.push(engine.rootNativeTops,        float(na))
        array.push(engine.rootIsRangeRootFlags,  false)
        array.push(engine.rootIsDynamicFlags,    false)
        array.push(engine.rootStates,            ROOT_CANDIDATE)
        array.push(engine.rootPairKeys,          ID_NONE)
        array.push(engine.rootDirections,        FVG_NONE)
        array.push(engine.rootFvgFreshFlags,     false)
        array.push(engine.rootIsBroadFvgFlags,   false)
        array.push(engine.rootLabelMasks,        0)
        array.push(engine.rootLastUpdateSeqs,    SEQ_UNSET)
        array.push(engine.rootPointTicks,        int(na))
        array.push(engine.rootNativeBottomTicks, int(na))
        array.push(engine.rootNativeTopTicks,    int(na))
        array.push(engine.rootSlotLiveFlags,     false)
        // W02 Batch 16 : one reverse-position entry per dimension for this new
        // physical slot, so each array's size stays equal to size(rootIds). A reused
        // slot never comes here and the arrays are never shrunk on a free.
        array.push(engine.rootCategorySetPositions, SLOT_INVALID)
        array.push(engine.rootTfSetPositions,       SLOT_INVALID)
        array.push(engine.rootStateSetPositions,    SLOT_INVALID)
        // W02 Batch 20 : one entry per FVG index dimension for this new physical
        // slot, keeping each array's size equal to size(rootIds). A reused slot
        // never comes here and a free never shrinks them.
        array.push(engine.rootFvgFreshSetPositions,           SLOT_INVALID)
        array.push(engine.rootFvgStructuralStateSetPositions, SLOT_INVALID)
        array.push(engine.rootFvgDirectionSetPositions,       SLOT_INVALID)
        array.push(engine.rootFvgBroadSetPositions,           SLOT_INVALID)
    // Step 3 : new Root ID. 1-based, 0 = none, never reused (D02).
    int newRootId = engine.nextRootId
    engine.nextRootId := newRootId + 1
    // Step 4 : slot ownership starts. rootIds[rootSlot] is the ownership token.
    array.set(engine.rootIds,           rootSlot, newRootId)
    array.set(engine.rootSlotLiveFlags, rootSlot, true)
    // W02 Batch 4 : I11-1 index entry for the new Root ID. Root IDs are never
    // reused, so this key is always new and is never written twice.
    map.put(engine.rootIdToSlot, newRootId, rootSlot)
    // Step 5 : Live collection. One push per ownership start, never twice.
    array.push(engine.rootLiveSlots, rootSlot)
    // Step 6 : Root ID order. Root IDs increase monotonically and are never reused,
    // so a tail push alone keeps Root ID ascending order. No sort, no insert search.
    array.push(engine.rootIdOrderSlots, rootSlot)
    // Step 7
    rootSlot

// Moves one currently Live physical Root slot back to the free state.
// Returns true only when the slot was freed. An invalid slot, a non-live slot or a
// lifecycle collection that does not hold the slot returns false with no mutation:
// this raw helper never repairs an inconsistent lifecycle state by itself and never
// raises runtime.error.
rootFreeSlotRaw(ZoneEngine engine, int rootSlot) =>
    // Step 1 : validity
    bool validSlot = rootSlot >= 0 and rootSlot < array.size(engine.rootIds)
    bool isLive    = validSlot and array.get(engine.rootSlotLiveFlags, rootSlot)
    // W02 Batch 4 Step A : the Root ID owning this slot, read before any mutation.
    int  oldRootId = isLive ? array.get(engine.rootIds, rootSlot) : ID_NONE
    // W02 Batch 4 Step B : the I11-1 index must already agree with this slot.
    bool idIndexValid = isLive and oldRootId != ID_NONE and map.contains(engine.rootIdToSlot, oldRootId) and map.get(engine.rootIdToSlot, oldRootId) == rootSlot
    bool freed     = false
    if isLive
        // Step 2 : position inside rootLiveSlots. The index always advances.
        int livePos = SLOT_INVALID
        int i = 0
        while i < array.size(engine.rootLiveSlots) and livePos == SLOT_INVALID
            if array.get(engine.rootLiveSlots, i) == rootSlot
                livePos := i
            else
                i += 1
        // Step 3 : position inside rootIdOrderSlots. The index always advances.
        int idOrderPos = SLOT_INVALID
        int k = 0
        while k < array.size(engine.rootIdOrderSlots) and idOrderPos == SLOT_INVALID
            if array.get(engine.rootIdOrderSlots, k) == rootSlot
                idOrderPos := k
            else
                k += 1
        // Step 4 : atomic guard. Both positions and the ID index entry must agree,
        // otherwise nothing is mutated and the inconsistency is never repaired here.
        if livePos != SLOT_INVALID and idOrderPos != SLOT_INVALID and idIndexValid
            // Step 5 : rootLiveSlots has no order semantics -> swap-pop.
            int liveLastPos = array.size(engine.rootLiveSlots) - 1
            if livePos != liveLastPos
                array.set(engine.rootLiveSlots, livePos, array.get(engine.rootLiveSlots, liveLastPos))
            array.pop(engine.rootLiveSlots)
            // Step 6 : rootIdOrderSlots must keep Root ID ascending order ->
            // order preserving shift with array.set / array.get, then pop.
            int idSize = array.size(engine.rootIdOrderSlots)
            int j = idOrderPos
            while j < idSize - 1
                array.set(engine.rootIdOrderSlots, j, array.get(engine.rootIdOrderSlots, j + 1))
                j += 1
            array.pop(engine.rootIdOrderSlots)
            // W02 Batch 4 Step D : the freed Root ID leaves the I11-1 index. A freed
            // Root ID is never kept as a stale key and is never re-added.
            map.remove(engine.rootIdToSlot, oldRootId)
            // Step 7 : field reset, including rootSlotLiveFlags -> false.
            rootResetSlotRaw(engine, rootSlot)
            // Step 8 : freed slot enters the free stack exactly once.
            array.push(engine.rootFreeSlots, rootSlot)
            freed := true
    // Step 9
    freed

// ============================================================
// W02 Batch 17 : Root Category / TF / state set raw helpers (I11-4)
//
// Internal only. They maintain a Root's membership in the three index dimensions
// added in Batch 15 and nothing else: engine.rootCategories / rootTfCodes /
// rootStates stay the logical source of truth and are never written here, and no
// Root content, ownership, revision or Generation state is touched. A Phase-style
// transition (detach, change the logical field, add again) is a later path.
// The set of each dimension is chosen by an explicit branch over the existing enum
// values only: no new dimension enum, no magic number, no map, no nested array and
// no per-object UDT. An unknown or na Category, TF code or state is never accepted.
// A membership is all-or-nothing across the three dimensions: an add that cannot
// complete all three writes nothing, and a detach runs only after the full
// validation. A removal is a swap-pop - the sets carry no order semantics - and
// array.remove / array.shift / array.unshift / array.clear are never used.
// Call sites = 0 in this Batch, so no real membership exists yet.
// ============================================================

// True only when the slot is a live, owned Root whose three stored positions each
// point back at it inside the set of its current Category, TF code and state.
// It never mutates and never repairs an inconsistency.
rootSetMembershipValidRaw(ZoneEngine engine, int rootSlot) =>
    bool valid = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootCategorySetPositions) and rootSlot < array.size(engine.rootTfSetPositions) and rootSlot < array.size(engine.rootStateSetPositions)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
            int category = array.get(engine.rootCategories,          rootSlot)
            int tfCode   = array.get(engine.rootTfCodes,             rootSlot)
            int state    = array.get(engine.rootStates,              rootSlot)
            int catPos   = array.get(engine.rootCategorySetPositions, rootSlot)
            int tfPos    = array.get(engine.rootTfSetPositions,       rootSlot)
            int statePos = array.get(engine.rootStateSetPositions,    rootSlot)
            bool catValid   = false
            bool tfValid    = false
            bool stateValid = false
            if catPos >= 0
                if category == CAT_MA
                    if catPos < array.size(engine.categoryMaRootSlots)
                        catValid := array.get(engine.categoryMaRootSlots, catPos) == rootSlot
                else if category == CAT_SWING
                    if catPos < array.size(engine.categorySwingRootSlots)
                        catValid := array.get(engine.categorySwingRootSlots, catPos) == rootSlot
                else if category == CAT_ACCUM
                    if catPos < array.size(engine.categoryAccumRootSlots)
                        catValid := array.get(engine.categoryAccumRootSlots, catPos) == rootSlot
                else if category == CAT_TIME_HL
                    if catPos < array.size(engine.categoryTimeHlRootSlots)
                        catValid := array.get(engine.categoryTimeHlRootSlots, catPos) == rootSlot
                else if category == CAT_FVG
                    if catPos < array.size(engine.categoryFvgRootSlots)
                        catValid := array.get(engine.categoryFvgRootSlots, catPos) == rootSlot
                else if category == CAT_PSYCH
                    if catPos < array.size(engine.categoryPsychRootSlots)
                        catValid := array.get(engine.categoryPsychRootSlots, catPos) == rootSlot
            if tfPos >= 0
                if tfCode == TF_1M
                    if tfPos < array.size(engine.tf1mRootSlots)
                        tfValid := array.get(engine.tf1mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_5M
                    if tfPos < array.size(engine.tf5mRootSlots)
                        tfValid := array.get(engine.tf5mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_15M
                    if tfPos < array.size(engine.tf15mRootSlots)
                        tfValid := array.get(engine.tf15mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_1H
                    if tfPos < array.size(engine.tf1hRootSlots)
                        tfValid := array.get(engine.tf1hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_4H
                    if tfPos < array.size(engine.tf4hRootSlots)
                        tfValid := array.get(engine.tf4hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_D
                    if tfPos < array.size(engine.tfDRootSlots)
                        tfValid := array.get(engine.tfDRootSlots, tfPos) == rootSlot
            if statePos >= 0
                if state == ROOT_CANDIDATE
                    if statePos < array.size(engine.stateCandidateRootSlots)
                        stateValid := array.get(engine.stateCandidateRootSlots, statePos) == rootSlot
                else if state == ROOT_ACTIVE
                    if statePos < array.size(engine.stateActiveRootSlots)
                        stateValid := array.get(engine.stateActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_INVALIDATED
                    if statePos < array.size(engine.stateInvalidatedRootSlots)
                        stateValid := array.get(engine.stateInvalidatedRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_WAIT
                    if statePos < array.size(engine.stateInverseWaitRootSlots)
                        stateValid := array.get(engine.stateInverseWaitRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_ACTIVE
                    if statePos < array.size(engine.stateInverseActiveRootSlots)
                        stateValid := array.get(engine.stateInverseActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_RETIRED
                    if statePos < array.size(engine.stateRetiredRootSlots)
                        stateValid := array.get(engine.stateRetiredRootSlots, statePos) == rootSlot
            valid := catValid and tfValid and stateValid
    valid

// Registers one Root in all three dimensions at once. The preflight requires a
// live, owned slot, a known Category, TF code and state, and no existing membership
// in any dimension; otherwise nothing at all is written. A raw slot straight out of
// rootAllocSlotRaw fails it, because its Category and TF code are still na and its
// ROOT_CANDIDATE is only a sentinel, never a reason to join the Candidate set.
// ROOT_RETIRED, by contrast, is a valid state: a Retired Root that still owns its
// slot belongs in the Retired set.
rootSetAddAllRaw(ZoneEngine engine, int rootSlot) =>
    bool added = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootCategorySetPositions) and rootSlot < array.size(engine.rootTfSetPositions) and rootSlot < array.size(engine.rootStateSetPositions)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
            int category = array.get(engine.rootCategories,          rootSlot)
            int tfCode   = array.get(engine.rootTfCodes,             rootSlot)
            int state    = array.get(engine.rootStates,              rootSlot)
            int catPos   = array.get(engine.rootCategorySetPositions, rootSlot)
            int tfPos    = array.get(engine.rootTfSetPositions,       rootSlot)
            int statePos = array.get(engine.rootStateSetPositions,    rootSlot)
            bool categoryKnown = category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL or category == CAT_FVG or category == CAT_PSYCH
            bool tfKnown       = tfCode == TF_1M or tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D
            bool stateKnown    = state == ROOT_CANDIDATE or state == ROOT_ACTIVE or state == ROOT_INVALIDATED or state == ROOT_INVERSE_WAIT or state == ROOT_INVERSE_ACTIVE or state == ROOT_RETIRED
            if catPos == SLOT_INVALID and tfPos == SLOT_INVALID and statePos == SLOT_INVALID and categoryKnown and tfKnown and stateKnown
                // Category, then TF, then state. Each is a tail push; nothing is sorted.
                int catNewPos = SLOT_INVALID
                if category == CAT_MA
                    catNewPos := array.size(engine.categoryMaRootSlots)
                    array.push(engine.categoryMaRootSlots, rootSlot)
                else if category == CAT_SWING
                    catNewPos := array.size(engine.categorySwingRootSlots)
                    array.push(engine.categorySwingRootSlots, rootSlot)
                else if category == CAT_ACCUM
                    catNewPos := array.size(engine.categoryAccumRootSlots)
                    array.push(engine.categoryAccumRootSlots, rootSlot)
                else if category == CAT_TIME_HL
                    catNewPos := array.size(engine.categoryTimeHlRootSlots)
                    array.push(engine.categoryTimeHlRootSlots, rootSlot)
                else if category == CAT_FVG
                    catNewPos := array.size(engine.categoryFvgRootSlots)
                    array.push(engine.categoryFvgRootSlots, rootSlot)
                else if category == CAT_PSYCH
                    catNewPos := array.size(engine.categoryPsychRootSlots)
                    array.push(engine.categoryPsychRootSlots, rootSlot)
                array.set(engine.rootCategorySetPositions, rootSlot, catNewPos)
                int tfNewPos = SLOT_INVALID
                if tfCode == TF_1M
                    tfNewPos := array.size(engine.tf1mRootSlots)
                    array.push(engine.tf1mRootSlots, rootSlot)
                else if tfCode == TF_5M
                    tfNewPos := array.size(engine.tf5mRootSlots)
                    array.push(engine.tf5mRootSlots, rootSlot)
                else if tfCode == TF_15M
                    tfNewPos := array.size(engine.tf15mRootSlots)
                    array.push(engine.tf15mRootSlots, rootSlot)
                else if tfCode == TF_1H
                    tfNewPos := array.size(engine.tf1hRootSlots)
                    array.push(engine.tf1hRootSlots, rootSlot)
                else if tfCode == TF_4H
                    tfNewPos := array.size(engine.tf4hRootSlots)
                    array.push(engine.tf4hRootSlots, rootSlot)
                else if tfCode == TF_D
                    tfNewPos := array.size(engine.tfDRootSlots)
                    array.push(engine.tfDRootSlots, rootSlot)
                array.set(engine.rootTfSetPositions, rootSlot, tfNewPos)
                int stateNewPos = SLOT_INVALID
                if state == ROOT_CANDIDATE
                    stateNewPos := array.size(engine.stateCandidateRootSlots)
                    array.push(engine.stateCandidateRootSlots, rootSlot)
                else if state == ROOT_ACTIVE
                    stateNewPos := array.size(engine.stateActiveRootSlots)
                    array.push(engine.stateActiveRootSlots, rootSlot)
                else if state == ROOT_INVALIDATED
                    stateNewPos := array.size(engine.stateInvalidatedRootSlots)
                    array.push(engine.stateInvalidatedRootSlots, rootSlot)
                else if state == ROOT_INVERSE_WAIT
                    stateNewPos := array.size(engine.stateInverseWaitRootSlots)
                    array.push(engine.stateInverseWaitRootSlots, rootSlot)
                else if state == ROOT_INVERSE_ACTIVE
                    stateNewPos := array.size(engine.stateInverseActiveRootSlots)
                    array.push(engine.stateInverseActiveRootSlots, rootSlot)
                else if state == ROOT_RETIRED
                    stateNewPos := array.size(engine.stateRetiredRootSlots)
                    array.push(engine.stateRetiredRootSlots, rootSlot)
                array.set(engine.rootStateSetPositions, rootSlot, stateNewPos)
                added := true
    added

// Removes one Root from all three dimensions at once, Category then TF then state.
// Runs only after the full membership validation, so a broken membership detaches
// nothing and is never repaired. Each removal moves the last entry into the freed
// position, updates that entry's stored position and pops the tail; this Root's
// three positions end at SLOT_INVALID. The logical Category / TF / state fields are
// left exactly as they are.
rootSetDetachAllRaw(ZoneEngine engine, int rootSlot) =>
    bool detached = false
    if rootSetMembershipValidRaw(engine, rootSlot)
        int category     = array.get(engine.rootCategories,           rootSlot)
        int tfCode       = array.get(engine.rootTfCodes,              rootSlot)
        int state        = array.get(engine.rootStates,               rootSlot)
        int catPos       = array.get(engine.rootCategorySetPositions, rootSlot)
        int tfPos        = array.get(engine.rootTfSetPositions,       rootSlot)
        int statePos     = array.get(engine.rootStateSetPositions,    rootSlot)
        int lastPos      = SLOT_INVALID
        int lastRootSlot = SLOT_INVALID
        if category == CAT_MA
            lastPos      := array.size(engine.categoryMaRootSlots) - 1
            lastRootSlot := array.get(engine.categoryMaRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryMaRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryMaRootSlots)
        else if category == CAT_SWING
            lastPos      := array.size(engine.categorySwingRootSlots) - 1
            lastRootSlot := array.get(engine.categorySwingRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categorySwingRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categorySwingRootSlots)
        else if category == CAT_ACCUM
            lastPos      := array.size(engine.categoryAccumRootSlots) - 1
            lastRootSlot := array.get(engine.categoryAccumRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryAccumRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryAccumRootSlots)
        else if category == CAT_TIME_HL
            lastPos      := array.size(engine.categoryTimeHlRootSlots) - 1
            lastRootSlot := array.get(engine.categoryTimeHlRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryTimeHlRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryTimeHlRootSlots)
        else if category == CAT_FVG
            lastPos      := array.size(engine.categoryFvgRootSlots) - 1
            lastRootSlot := array.get(engine.categoryFvgRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryFvgRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryFvgRootSlots)
        else if category == CAT_PSYCH
            lastPos      := array.size(engine.categoryPsychRootSlots) - 1
            lastRootSlot := array.get(engine.categoryPsychRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryPsychRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryPsychRootSlots)
        array.set(engine.rootCategorySetPositions, rootSlot, SLOT_INVALID)
        if tfCode == TF_1M
            lastPos      := array.size(engine.tf1mRootSlots) - 1
            lastRootSlot := array.get(engine.tf1mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf1mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf1mRootSlots)
        else if tfCode == TF_5M
            lastPos      := array.size(engine.tf5mRootSlots) - 1
            lastRootSlot := array.get(engine.tf5mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf5mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf5mRootSlots)
        else if tfCode == TF_15M
            lastPos      := array.size(engine.tf15mRootSlots) - 1
            lastRootSlot := array.get(engine.tf15mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf15mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf15mRootSlots)
        else if tfCode == TF_1H
            lastPos      := array.size(engine.tf1hRootSlots) - 1
            lastRootSlot := array.get(engine.tf1hRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf1hRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf1hRootSlots)
        else if tfCode == TF_4H
            lastPos      := array.size(engine.tf4hRootSlots) - 1
            lastRootSlot := array.get(engine.tf4hRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf4hRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf4hRootSlots)
        else if tfCode == TF_D
            lastPos      := array.size(engine.tfDRootSlots) - 1
            lastRootSlot := array.get(engine.tfDRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tfDRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tfDRootSlots)
        array.set(engine.rootTfSetPositions, rootSlot, SLOT_INVALID)
        if state == ROOT_CANDIDATE
            lastPos      := array.size(engine.stateCandidateRootSlots) - 1
            lastRootSlot := array.get(engine.stateCandidateRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateCandidateRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateCandidateRootSlots)
        else if state == ROOT_ACTIVE
            lastPos      := array.size(engine.stateActiveRootSlots) - 1
            lastRootSlot := array.get(engine.stateActiveRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateActiveRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateActiveRootSlots)
        else if state == ROOT_INVALIDATED
            lastPos      := array.size(engine.stateInvalidatedRootSlots) - 1
            lastRootSlot := array.get(engine.stateInvalidatedRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInvalidatedRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInvalidatedRootSlots)
        else if state == ROOT_INVERSE_WAIT
            lastPos      := array.size(engine.stateInverseWaitRootSlots) - 1
            lastRootSlot := array.get(engine.stateInverseWaitRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInverseWaitRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInverseWaitRootSlots)
        else if state == ROOT_INVERSE_ACTIVE
            lastPos      := array.size(engine.stateInverseActiveRootSlots) - 1
            lastRootSlot := array.get(engine.stateInverseActiveRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInverseActiveRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInverseActiveRootSlots)
        else if state == ROOT_RETIRED
            lastPos      := array.size(engine.stateRetiredRootSlots) - 1
            lastRootSlot := array.get(engine.stateRetiredRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateRetiredRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateRetiredRootSlots)
        array.set(engine.rootStateSetPositions, rootSlot, SLOT_INVALID)
        detached := true
    detached

// ============================================================
// W02 Batch 14 : Side Phase set index raw helpers (I11-9)
//
// Internal only. They maintain the Batch 13 membership of one Side in the Phase set
// matching engine.sidePhases[sideSlot], and nothing else: engine.sidePhases stays
// the logical source of truth and is never written here, and no Core ownership,
// Core ID, Generation ID, revision or other Side state is touched. They implement
// no Phase transition (detach old, change the Phase, add new) - that path belongs
// to a later Batch - and no Touch / Break / Flip / Dormant decision.
// A Side belongs to at most one set, at most once; an unknown Phase is never
// accepted; nothing is sorted; a removal is a swap-pop, never array.remove /
// array.shift / array.unshift; and no helper raises runtime.error.
// ============================================================

// True only when this Side's stored position really points at itself inside the set
// of its current Phase. Used as a free-time consistency guard; it never repairs.
phaseSetMembershipValidRaw(ZoneEngine engine, int sideSlot) =>
    bool valid = false
    if sideSlot >= 0 and sideSlot < array.size(engine.sidePhases) and sideSlot < array.size(engine.sidePhaseSetPositions)
        int phase = array.get(engine.sidePhases,            sideSlot)
        int pos   = array.get(engine.sidePhaseSetPositions, sideSlot)
        if pos >= 0
            if phase == PH_WAITING
                if pos < array.size(engine.phaseWaitingSideSlots)
                    valid := array.get(engine.phaseWaitingSideSlots, pos) == sideSlot
            else if phase == PH_ARMED
                if pos < array.size(engine.phaseArmedSideSlots)
                    valid := array.get(engine.phaseArmedSideSlots, pos) == sideSlot
            else if phase == PH_ACTIVE_TOUCH
                if pos < array.size(engine.phaseActiveTouchSideSlots)
                    valid := array.get(engine.phaseActiveTouchSideSlots, pos) == sideSlot
            else if phase == PH_BROKEN
                if pos < array.size(engine.phaseBrokenSideSlots)
                    valid := array.get(engine.phaseBrokenSideSlots, pos) == sideSlot
            else if phase == PH_FLIP_WAIT
                if pos < array.size(engine.phaseFlipWaitSideSlots)
                    valid := array.get(engine.phaseFlipWaitSideSlots, pos) == sideSlot
            else if phase == PH_DORMANT
                if pos < array.size(engine.phaseDormantSideSlots)
                    valid := array.get(engine.phaseDormantSideSlots, pos) == sideSlot
    valid

// Adds a Side that currently belongs to no set into the set of its current Phase,
// as a tail push, and records its position. Returns false with no mutation when the
// slot is out of range, when it already belongs to a set or when its Phase is not
// one of the six known ones.
phaseSetAddRaw(ZoneEngine engine, int sideSlot) =>
    bool added = false
    if sideSlot >= 0 and sideSlot < array.size(engine.sidePhases) and sideSlot < array.size(engine.sidePhaseSetPositions)
        int pos = array.get(engine.sidePhaseSetPositions, sideSlot)
        if pos == SLOT_INVALID
            int phase  = array.get(engine.sidePhases, sideSlot)
            int newPos = SLOT_INVALID
            if phase == PH_WAITING
                newPos := array.size(engine.phaseWaitingSideSlots)
                array.push(engine.phaseWaitingSideSlots, sideSlot)
            else if phase == PH_ARMED
                newPos := array.size(engine.phaseArmedSideSlots)
                array.push(engine.phaseArmedSideSlots, sideSlot)
            else if phase == PH_ACTIVE_TOUCH
                newPos := array.size(engine.phaseActiveTouchSideSlots)
                array.push(engine.phaseActiveTouchSideSlots, sideSlot)
            else if phase == PH_BROKEN
                newPos := array.size(engine.phaseBrokenSideSlots)
                array.push(engine.phaseBrokenSideSlots, sideSlot)
            else if phase == PH_FLIP_WAIT
                newPos := array.size(engine.phaseFlipWaitSideSlots)
                array.push(engine.phaseFlipWaitSideSlots, sideSlot)
            else if phase == PH_DORMANT
                newPos := array.size(engine.phaseDormantSideSlots)
                array.push(engine.phaseDormantSideSlots, sideSlot)
            if newPos != SLOT_INVALID
                array.set(engine.sidePhaseSetPositions, sideSlot, newPos)
                added := true
    added

// Removes a Side from the set of its current Phase with a swap-pop, moving the last
// entry into the freed position and updating that entry's stored position, then
// marks this Side as belonging to no set. Returns false with no mutation when the
// membership is not valid; an inconsistent membership is never repaired here.
phaseSetDetachRaw(ZoneEngine engine, int sideSlot) =>
    bool detached = false
    if phaseSetMembershipValidRaw(engine, sideSlot)
        int phase        = array.get(engine.sidePhases,            sideSlot)
        int pos          = array.get(engine.sidePhaseSetPositions, sideSlot)
        int lastPos      = SLOT_INVALID
        int lastSideSlot = SLOT_INVALID
        if phase == PH_WAITING
            lastPos      := array.size(engine.phaseWaitingSideSlots) - 1
            lastSideSlot := array.get(engine.phaseWaitingSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseWaitingSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseWaitingSideSlots)
        else if phase == PH_ARMED
            lastPos      := array.size(engine.phaseArmedSideSlots) - 1
            lastSideSlot := array.get(engine.phaseArmedSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseArmedSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseArmedSideSlots)
        else if phase == PH_ACTIVE_TOUCH
            lastPos      := array.size(engine.phaseActiveTouchSideSlots) - 1
            lastSideSlot := array.get(engine.phaseActiveTouchSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseActiveTouchSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseActiveTouchSideSlots)
        else if phase == PH_BROKEN
            lastPos      := array.size(engine.phaseBrokenSideSlots) - 1
            lastSideSlot := array.get(engine.phaseBrokenSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseBrokenSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseBrokenSideSlots)
        else if phase == PH_FLIP_WAIT
            lastPos      := array.size(engine.phaseFlipWaitSideSlots) - 1
            lastSideSlot := array.get(engine.phaseFlipWaitSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseFlipWaitSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseFlipWaitSideSlots)
        else if phase == PH_DORMANT
            lastPos      := array.size(engine.phaseDormantSideSlots) - 1
            lastSideSlot := array.get(engine.phaseDormantSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseDormantSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseDormantSideSlots)
        array.set(engine.sidePhaseSetPositions, sideSlot, SLOT_INVALID)
        detached := true
    detached

// ============================================================
// W02 Batch 3 : Core physical slot lifecycle (raw helpers)
// Source: I6.1, I6.3, I17.1, D02, D12
//
// Internal only, and raw in the same sense as the Batch 2 Root helpers: they own
// the physical Core slot and its two flattened Side slots
// (sideSlot = coreSlot * 2 + sideIndex, sideIndex 0 = Support, 1 = Resistance)
// and nothing else:
//   - Batch 3 built the raw lifecycle; Batch 4 connected the I11-8
//     Core ID -> coreSlot index (coreIdToSlot) into the alloc / free paths below,
//     where a free also requires the index entry to agree with the slot
//   - Batch 6 added coreIdOrderSlots, the Core ID ascending list maintained by the
//     alloc / free paths below as the future Public View order foundation; a free
//     also requires its entry to be present
//   - Batch 11 connected the TouchMark ring storage: a new physical slot allocates
//     its metadata entry and its fixed block once, and a reset returns the block to
//     unowned and empty without touching the rows
//   - Batch 14 connected the I11-9 Side Phase set index to the Core ownership
//     start / free / reset lifecycle
//   - still not connected: Root participation, Zone origin Root set,
//     range / topology index, Snapshot, PendingTopology, PendingGeneration
//   - no revision increment (I9 revisions stay untouched here)
//   - no Generation start: nextGenerationId is never read or written and
//     coreGenerationIds stays ID_NONE. Physical slot ownership and the logical Zone
//     generation are separate contracts (A6.8), so a Generation ID is issued only
//     where the spec establishes a generation start.
// External call sites = 0 in this Batch: coreResetSlotRaw is called only from
// coreAllocSlotRaw and coreFreeSlotRaw.
//
// Slot ownership token is coreIds[coreSlot] itself (Batch 1 contract): no separate
// owner token array, and no Side token - Side ownership is coreId + sideIndex. A
// stale-capable reference keeps coreSlot + expectedCoreId and is valid only when the
// slot is in range, coreSlotLiveFlags[coreSlot] is true and
// coreIds[coreSlot] == expectedCoreId. The Generation ID is never the ownership
// token. The ownership validation helper is not created in this Batch.
//
// Physical size invariant, kept by growth only (free never shrinks the arrays):
//   size(coreIds) == size of every other Core SoA array == size(coreSlotLiveFlags)
//   size(every Side SoA array) == size(coreIds) * 2
//
// array.remove(0), array.shift() and array.unshift() are never used (D12, I17.2).
// Unset values keep their spec sentinel and element type: na stays na, never 0.
// ============================================================

// Returns one existing physical coreSlot and its two sideSlots to the unused / free
// sentinel state. Precondition: the coreSlot and both sideSlots already exist in the
// physical arrays. No range check helper and no runtime.error is added here.
// PH_WAITING / GR_UNAVAILABLE are used as the spec enum sentinels of a raw slot and
// do not mean that a logical Waiting Core was created: physical ownership is stated
// by coreSlotLiveFlags alone.
// Touches the Core SoA 8 arrays, coreSlotLiveFlags and the Side SoA 26 arrays for
// both sides only: coreFreeSlots, coreLiveSlots, nextCoreId, nextGenerationId, the
// revisions, the Root arrays and the Event arrays are left alone.
coreResetSlotRaw(ZoneEngine engine, int coreSlot) =>
    // Step 1 : Core SoA
    array.set(engine.coreIds,             coreSlot, ID_NONE)
    array.set(engine.coreGenerationIds,   coreSlot, ID_NONE)
    array.set(engine.coreZoneFreshFlags,  coreSlot, false)
    array.set(engine.corePhysicalBottoms, coreSlot, float(na))
    array.set(engine.corePhysicalTops,    coreSlot, float(na))
    array.set(engine.coreCreatedTimes,    coreSlot, int(na))
    array.set(engine.coreLastSeenTimes,   coreSlot, int(na))
    array.set(engine.coreDormantFlags,    coreSlot, false)
    // Step 2 : physical ownership off
    array.set(engine.coreSlotLiveFlags, coreSlot, false)
    // W02 Batch 11 : TouchMark ring metadata of this block back to unowned and
    // empty (I17.2). The 8 TouchMark field arrays are deliberately NOT cleared:
    // ownerCoreId = ID_NONE with count = 0 already makes every physical row of the
    // block logically invalid, so a free or a reuse never costs a capacity-long
    // loop and the block's rows are simply overwritten later.
    array.set(engine.touchMarkRingOwnerCoreIds, coreSlot, ID_NONE)
    array.set(engine.touchMarkRingHeads,        coreSlot, 0)
    array.set(engine.touchMarkRingCounts,       coreSlot, 0)
    // Step 3 : both flattened Side slots. sideIndex 0 = Support, 1 = Resistance.
    int supportSideSlot    = coreSlot * 2
    int resistanceSideSlot = coreSlot * 2 + 1
    // Support side (sideIndex 0)
    array.set(engine.sideTouchCounts,           supportSideSlot   , 0)
    array.set(engine.sideWeakByTouchFlags,      supportSideSlot   , false)
    array.set(engine.sideWeakByDepthFlags,      supportSideSlot   , false)
    array.set(engine.sideMaxDepthPcts,          supportSideSlot   , 0.0)
    array.set(engine.sideFreshFlags,            supportSideSlot   , false)
    array.set(engine.sidePhases,                supportSideSlot   , PH_WAITING)
    array.set(engine.sideGrades,                supportSideSlot   , GR_UNAVAILABLE)
    array.set(engine.sideCurrentTouchNos,       supportSideSlot   , 0)
    array.set(engine.sideUpcomingTouchNos,      supportSideSlot   , 0)
    array.set(engine.sideArmedFromSeqs,         supportSideSlot   , SEQ_UNSET)
    array.set(engine.sideLastArmedRangeBottoms, supportSideSlot   , float(na))
    array.set(engine.sideLastArmedRangeTops,    supportSideSlot   , float(na))
    array.set(engine.sideLastNormalTouchTimes,  supportSideSlot   , int(na))
    array.set(engine.sideFlipAttemptCounts,     supportSideSlot   , 0)
    array.set(engine.sideInverseAttemptCounts,  supportSideSlot   , 0)
    array.set(engine.sideLastFlipConfirmSeqs,   supportSideSlot   , SEQ_UNSET)
    array.set(engine.sideEffectiveBottoms,      supportSideSlot   , float(na))
    array.set(engine.sideEffectiveTops,         supportSideSlot   , float(na))
    array.set(engine.sideReferencePrices,       supportSideSlot   , float(na))
    array.set(engine.sideCCounts,               supportSideSlot   , 0)
    array.set(engine.sideHCounts,               supportSideSlot   , 0)
    array.set(engine.sideDensities,             supportSideSlot   , int(na))
    array.set(engine.sideBaseStrongFlags,       supportSideSlot   , false)
    array.set(engine.sideHasNonPsychRootFlags,  supportSideSlot   , false)
    array.set(engine.sideIsBroadContextFlags,   supportSideSlot   , false)
    array.set(engine.sideEligibleFlags,         supportSideSlot   , false)
    // W02 Batch 14 : both Sides belong to no Phase set while the slot is free. The
    // Phase sets themselves are not scanned here: a free detaches before this reset,
    // and a slot taken from the free stack is already outside every set (I11-9).
    array.set(engine.sidePhaseSetPositions, supportSideSlot,    SLOT_INVALID)
    array.set(engine.sidePhaseSetPositions, resistanceSideSlot, SLOT_INVALID)
    // Resistance side (sideIndex 1)
    array.set(engine.sideTouchCounts,           resistanceSideSlot, 0)
    array.set(engine.sideWeakByTouchFlags,      resistanceSideSlot, false)
    array.set(engine.sideWeakByDepthFlags,      resistanceSideSlot, false)
    array.set(engine.sideMaxDepthPcts,          resistanceSideSlot, 0.0)
    array.set(engine.sideFreshFlags,            resistanceSideSlot, false)
    array.set(engine.sidePhases,                resistanceSideSlot, PH_WAITING)
    array.set(engine.sideGrades,                resistanceSideSlot, GR_UNAVAILABLE)
    array.set(engine.sideCurrentTouchNos,       resistanceSideSlot, 0)
    array.set(engine.sideUpcomingTouchNos,      resistanceSideSlot, 0)
    array.set(engine.sideArmedFromSeqs,         resistanceSideSlot, SEQ_UNSET)
    array.set(engine.sideLastArmedRangeBottoms, resistanceSideSlot, float(na))
    array.set(engine.sideLastArmedRangeTops,    resistanceSideSlot, float(na))
    array.set(engine.sideLastNormalTouchTimes,  resistanceSideSlot, int(na))
    array.set(engine.sideFlipAttemptCounts,     resistanceSideSlot, 0)
    array.set(engine.sideInverseAttemptCounts,  resistanceSideSlot, 0)
    array.set(engine.sideLastFlipConfirmSeqs,   resistanceSideSlot, SEQ_UNSET)
    array.set(engine.sideEffectiveBottoms,      resistanceSideSlot, float(na))
    array.set(engine.sideEffectiveTops,         resistanceSideSlot, float(na))
    array.set(engine.sideReferencePrices,       resistanceSideSlot, float(na))
    array.set(engine.sideCCounts,               resistanceSideSlot, 0)
    array.set(engine.sideHCounts,               resistanceSideSlot, 0)
    array.set(engine.sideDensities,             resistanceSideSlot, int(na))
    array.set(engine.sideBaseStrongFlags,       resistanceSideSlot, false)
    array.set(engine.sideHasNonPsychRootFlags,  resistanceSideSlot, false)
    array.set(engine.sideIsBroadContextFlags,   resistanceSideSlot, false)
    array.set(engine.sideEligibleFlags,         resistanceSideSlot, false)

// Starts ownership of one physical Core slot and returns that coreSlot.
// Free slots are reused first (LIFO pop, then reset); only a genuinely new physical
// slot grows the Core arrays by one element and every Side array by two elements,
// pushed Support first then Resistance. A reused slot never reuses the old Core ID:
// nextCoreId only increases (D02). One physical Core is one coreSlot: Support and
// Resistance are never allocated as separate Cores (I6.3).
coreAllocSlotRaw(ZoneEngine engine) =>
    int coreSlot = SLOT_INVALID
    // Step 1 / Step 2 : free stack first, LIFO. Never array.shift / array.remove(0).
    if array.size(engine.coreFreeSlots) > 0
        coreSlot := array.pop(engine.coreFreeSlots)
        // Existing slot, existing Side slots: reset, never push.
        coreResetSlotRaw(engine, coreSlot)
    else
        coreSlot := array.size(engine.coreIds)
        array.push(engine.coreIds,             ID_NONE)
        array.push(engine.coreGenerationIds,   ID_NONE)
        array.push(engine.coreZoneFreshFlags,  false)
        array.push(engine.corePhysicalBottoms, float(na))
        array.push(engine.corePhysicalTops,    float(na))
        array.push(engine.coreCreatedTimes,    int(na))
        array.push(engine.coreLastSeenTimes,   int(na))
        array.push(engine.coreDormantFlags,    false)
        array.push(engine.coreSlotLiveFlags, false)
        // W02 Batch 11 : one TouchMark ring metadata entry per physical Core slot,
        // so the metadata index stays equal to coreSlot (I17.2).
        array.push(engine.touchMarkRingOwnerCoreIds, ID_NONE)
        array.push(engine.touchMarkRingHeads,        0)
        array.push(engine.touchMarkRingCounts,       0)
        // W02 Batch 11 : first-time TouchMark block for this new physical slot,
        // touchMarkCapacityPerCore rows of sentinels. The capacity is used exactly
        // as the Cfg gave it: no clamp, no fallback and no new validation, so a
        // capacity of 0 or less simply allocates no row. A reused slot never comes
        // here, so a block is allocated once per physical Core slot and is never
        // shrunk afterwards.
        int touchCapacity = engine.touchMarkCapacityPerCore
        if touchCapacity > 0
            for touchOffset = 0 to touchCapacity - 1
                array.push(engine.touchMarkBaseSeqs,           SEQ_UNSET)
                array.push(engine.touchMarkTimes,              int(na))
                array.push(engine.touchMarkSides,              SIDE_NONE)
                array.push(engine.touchMarkContactBottoms,     float(na))
                array.push(engine.touchMarkContactTops,        float(na))
                array.push(engine.touchMarkCloseAtTouches,     float(na))
                array.push(engine.touchMarkGenerationIds,      ID_NONE)
                array.push(engine.touchMarkIsNormalTouchFlags, false)
        // Step 3 : the two Side slots of this new coreSlot, Support then Resistance.
        // Support side (sideIndex 0)
        array.push(engine.sideTouchCounts,           0)
        array.push(engine.sideWeakByTouchFlags,      false)
        array.push(engine.sideWeakByDepthFlags,      false)
        array.push(engine.sideMaxDepthPcts,          0.0)
        array.push(engine.sideFreshFlags,            false)
        array.push(engine.sidePhases,                PH_WAITING)
        array.push(engine.sideGrades,                GR_UNAVAILABLE)
        array.push(engine.sideCurrentTouchNos,       0)
        array.push(engine.sideUpcomingTouchNos,      0)
        array.push(engine.sideArmedFromSeqs,         SEQ_UNSET)
        array.push(engine.sideLastArmedRangeBottoms, float(na))
        array.push(engine.sideLastArmedRangeTops,    float(na))
        array.push(engine.sideLastNormalTouchTimes,  int(na))
        array.push(engine.sideFlipAttemptCounts,     0)
        array.push(engine.sideInverseAttemptCounts,  0)
        array.push(engine.sideLastFlipConfirmSeqs,   SEQ_UNSET)
        array.push(engine.sideEffectiveBottoms,      float(na))
        array.push(engine.sideEffectiveTops,         float(na))
        array.push(engine.sideReferencePrices,       float(na))
        array.push(engine.sideCCounts,               0)
        array.push(engine.sideHCounts,               0)
        array.push(engine.sideDensities,             int(na))
        array.push(engine.sideBaseStrongFlags,       false)
        array.push(engine.sideHasNonPsychRootFlags,  false)
        array.push(engine.sideIsBroadContextFlags,   false)
        array.push(engine.sideEligibleFlags,         false)
        // W02 Batch 14 : this Support Side starts outside every Phase set.
        array.push(engine.sidePhaseSetPositions, SLOT_INVALID)
        // Resistance side (sideIndex 1)
        array.push(engine.sideTouchCounts,           0)
        array.push(engine.sideWeakByTouchFlags,      false)
        array.push(engine.sideWeakByDepthFlags,      false)
        array.push(engine.sideMaxDepthPcts,          0.0)
        array.push(engine.sideFreshFlags,            false)
        array.push(engine.sidePhases,                PH_WAITING)
        array.push(engine.sideGrades,                GR_UNAVAILABLE)
        array.push(engine.sideCurrentTouchNos,       0)
        array.push(engine.sideUpcomingTouchNos,      0)
        array.push(engine.sideArmedFromSeqs,         SEQ_UNSET)
        array.push(engine.sideLastArmedRangeBottoms, float(na))
        array.push(engine.sideLastArmedRangeTops,    float(na))
        array.push(engine.sideLastNormalTouchTimes,  int(na))
        array.push(engine.sideFlipAttemptCounts,     0)
        array.push(engine.sideInverseAttemptCounts,  0)
        array.push(engine.sideLastFlipConfirmSeqs,   SEQ_UNSET)
        array.push(engine.sideEffectiveBottoms,      float(na))
        array.push(engine.sideEffectiveTops,         float(na))
        array.push(engine.sideReferencePrices,       float(na))
        array.push(engine.sideCCounts,               0)
        array.push(engine.sideHCounts,               0)
        array.push(engine.sideDensities,             int(na))
        array.push(engine.sideBaseStrongFlags,       false)
        array.push(engine.sideHasNonPsychRootFlags,  false)
        array.push(engine.sideIsBroadContextFlags,   false)
        array.push(engine.sideEligibleFlags,         false)
        // W02 Batch 14 : this Resistance Side starts outside every Phase set.
        array.push(engine.sidePhaseSetPositions, SLOT_INVALID)
    // Step 4 : new Core ID. 1-based, 0 = none, never reused (D02).
    int newCoreId = engine.nextCoreId
    engine.nextCoreId := newCoreId + 1
    // Step 5 : no Generation ID is issued here. nextGenerationId is untouched and
    // coreGenerationIds[coreSlot] stays ID_NONE.
    // Step 6 : slot ownership starts. coreIds[coreSlot] is the ownership token.
    array.set(engine.coreIds,           coreSlot, newCoreId)
    array.set(engine.coreSlotLiveFlags, coreSlot, true)
    // W02 Batch 11 : the TouchMark block follows the same ownership. Its owner token
    // is the Core ID, never the Generation ID, and a reused slot never keeps the old
    // Core ID. The ring starts empty, so the existing physical rows stay invisible.
    array.set(engine.touchMarkRingOwnerCoreIds, coreSlot, newCoreId)
    array.set(engine.touchMarkRingHeads,        coreSlot, 0)
    array.set(engine.touchMarkRingCounts,       coreSlot, 0)
    // W02 Batch 14 : both Sides of the newly owned Core enter the Phase set matching
    // their current Phase, which is PH_WAITING after the growth push or the reset.
    // Support first, Resistance second; the position inside a set carries no order
    // semantics (I11-9).
    phaseSetAddRaw(engine, coreSlot * 2)
    phaseSetAddRaw(engine, coreSlot * 2 + 1)
    // W02 Batch 4 : I11-8 index entry for the new Core ID. Core IDs are never
    // reused, so this key is always new and is never written twice.
    map.put(engine.coreIdToSlot, newCoreId, coreSlot)
    // Step 7 : held-Core collection. One push per ownership start, never one per Side.
    array.push(engine.coreLiveSlots, coreSlot)
    // W02 Batch 6 : Core ID order. Core IDs increase monotonically and are never
    // reused - a reused physical slot still gets a fresh, larger Core ID - so a tail
    // push alone keeps Core ID ascending order. No sort, no array.insert.
    array.push(engine.coreIdOrderSlots, coreSlot)
    // Step 8
    coreSlot

// Moves one currently held physical Core slot back to the free state.
// Returns true only when the slot was freed. An invalid slot, a non-live slot or a
// coreLiveSlots collection that does not hold the slot returns false with no
// mutation: this raw helper never repairs an inconsistent lifecycle state by itself
// and never raises runtime.error. A Dormant Core is still owned
// (coreSlotLiveFlags true, coreDormantFlags true) and is never freed for being
// Dormant; only an explicit call frees a slot.
coreFreeSlotRaw(ZoneEngine engine, int coreSlot) =>
    // Step 1 : validity
    bool validSlot = coreSlot >= 0 and coreSlot < array.size(engine.coreIds)
    bool isLive    = validSlot and array.get(engine.coreSlotLiveFlags, coreSlot)
    // W02 Batch 4 Step A : the Core ID owning this slot, read before any mutation.
    int  oldCoreId = isLive ? array.get(engine.coreIds, coreSlot) : ID_NONE
    // W02 Batch 4 Step B : the I11-8 index must already agree with this slot.
    bool idIndexValid = isLive and oldCoreId != ID_NONE and map.contains(engine.coreIdToSlot, oldCoreId) and map.get(engine.coreIdToSlot, oldCoreId) == coreSlot
    bool freed     = false
    if isLive
        // Step 2 : position inside coreLiveSlots. The index always advances.
        int livePos = SLOT_INVALID
        int i = 0
        while i < array.size(engine.coreLiveSlots) and livePos == SLOT_INVALID
            if array.get(engine.coreLiveSlots, i) == coreSlot
                livePos := i
            else
                i += 1
        // W02 Batch 6 Step A : position inside coreIdOrderSlots. Index always advances.
        int idOrderPos = SLOT_INVALID
        int k = 0
        while k < array.size(engine.coreIdOrderSlots) and idOrderPos == SLOT_INVALID
            if array.get(engine.coreIdOrderSlots, k) == coreSlot
                idOrderPos := k
            else
                k += 1
        // W02 Batch 14 : both Sides must sit correctly in the Phase set of their
        // current Phase before anything is freed (I11-9).
        int  supportSideSlot      = coreSlot * 2
        int  resistanceSideSlot   = coreSlot * 2 + 1
        bool supportPhaseValid    = phaseSetMembershipValidRaw(engine, supportSideSlot)
        bool resistancePhaseValid = phaseSetMembershipValidRaw(engine, resistanceSideSlot)
        // Step 3 : atomic guard. Both positions and the ID index entry must agree,
        // otherwise nothing is mutated and the inconsistency is never repaired here.
        if livePos != SLOT_INVALID and idOrderPos != SLOT_INVALID and idIndexValid and supportPhaseValid and resistancePhaseValid
            // W02 Batch 14 : leave the Phase sets first, Support then Resistance.
            // Both were validated by the guard, so neither detach can fail here.
            phaseSetDetachRaw(engine, supportSideSlot)
            phaseSetDetachRaw(engine, resistanceSideSlot)
            // Step 4 : coreLiveSlots carries no public View or Merge / Split order
            // semantics -> swap-pop.
            int lastPos = array.size(engine.coreLiveSlots) - 1
            if livePos != lastPos
                array.set(engine.coreLiveSlots, livePos, array.get(engine.coreLiveSlots, lastPos))
            array.pop(engine.coreLiveSlots)
            // W02 Batch 6 Step D : coreIdOrderSlots must keep Core ID ascending order
            // -> order preserving shift with array.set / array.get, then pop. Never
            // swap-pop, array.remove, array.shift or array.unshift here.
            int idSize = array.size(engine.coreIdOrderSlots)
            int j = idOrderPos
            while j < idSize - 1
                array.set(engine.coreIdOrderSlots, j, array.get(engine.coreIdOrderSlots, j + 1))
                j += 1
            array.pop(engine.coreIdOrderSlots)
            // W02 Batch 4 Step D : the freed Core ID leaves the I11-8 index. A freed
            // Core ID is never kept as a stale key and is never re-added.
            map.remove(engine.coreIdToSlot, oldCoreId)
            // Step 5 : Core 8 + coreSlotLiveFlags + Support 26 + Resistance 26 reset,
            // and with W02 Batch 11 the TouchMark ring metadata of this block as well
            // (owner ID_NONE, head 0, count 0). The TouchMark rows themselves are kept
            // and the arrays are never shrunk.
            coreResetSlotRaw(engine, coreSlot)
            // Step 6 : freed slot enters the free stack exactly once. Physical array
            // sizes are never shrunk.
            array.push(engine.coreFreeSlots, coreSlot)
            // Step 7
            freed := true
    freed

// ============================================================
// W02 Batch 12 : TouchMark ring raw helpers
// Source: I17.2, A6.4, D12
//
// Internal only. They work on the fixed block a Core slot owns since Batch 11 and
// do nothing else: no Core ID / live flag / map ownership validation, no Side,
// generation or price validation, no Touch predicate, no dedupe, no Merge / Split
// assignment, no Snapshot, no SideTouchCount, Weak or Grade update, and no
// touchHistoryTruncated change (the spec bundle fixes no mapping from a ring wrap
// to that diagnostic, so no meaning is invented here).
// The caller guarantees that coreSlot is an owned Core slot whose block exists and
// whose owner token already matches.
// Nothing is allocated: the existing block rows are overwritten with array.set, and
// array.remove(0) / array.shift() / array.unshift() / array.clear() are never used.
// Call sites = 0 in this Batch.
// ============================================================

// Stores one TouchMark at the ring tail of this Core block and returns the
// flattened physical index it was written to, or SLOT_INVALID when nothing could be
// stored. A capacity of 0 or less stores nothing and leaves head, count and every
// TouchMark field untouched; the capacity is never clamped and never falls back.
// While the ring is not full the tail offset is (head + count) % capacity and only
// count grows; once it is full the oldest entry at head is overwritten, head
// advances by one modulo the capacity and count stays at the capacity.
touchMarkAppendRaw(ZoneEngine engine, int coreSlot, int baseSeq, int touchTime, int side, float contactBottom, float contactTop, float closeAtTouch, int generationId, bool isNormalTouch) =>
    // Step 1 : capacity, then the ring metadata of this block.
    int capacity      = engine.touchMarkCapacityPerCore
    int physicalIndex = SLOT_INVALID
    if capacity > 0
        int head      = array.get(engine.touchMarkRingHeads,  coreSlot)
        int count     = array.get(engine.touchMarkRingCounts, coreSlot)
        int blockBase = coreSlot * capacity
        // Step 2 : the physical row to write.
        int ringOffset = count < capacity ? (head + count) % capacity : head
        physicalIndex := blockBase + ringOffset
        // Step 3 : all 8 A6.4 fields, never partly.
        array.set(engine.touchMarkBaseSeqs,           physicalIndex, baseSeq)
        array.set(engine.touchMarkTimes,              physicalIndex, touchTime)
        array.set(engine.touchMarkSides,              physicalIndex, side)
        array.set(engine.touchMarkContactBottoms,     physicalIndex, contactBottom)
        array.set(engine.touchMarkContactTops,        physicalIndex, contactTop)
        array.set(engine.touchMarkCloseAtTouches,     physicalIndex, closeAtTouch)
        array.set(engine.touchMarkGenerationIds,      physicalIndex, generationId)
        array.set(engine.touchMarkIsNormalTouchFlags, physicalIndex, isNormalTouch)
        // Step 4 / Step 5 : metadata after the write. Not full -> count grows and the
        // head stays; full -> the head advances over the overwritten oldest entry and
        // the count is left as it is. No entry is ever shifted forward.
        if count < capacity
            array.set(engine.touchMarkRingCounts, coreSlot, count + 1)
        else
            array.set(engine.touchMarkRingHeads, coreSlot, (head + 1) % capacity)
    // Step 6
    physicalIndex

// Translates a logical chronological position into the flattened physical index of
// this Core block: logicalIndex 0 is the oldest TouchMark currently held and
// count - 1 the newest, so the physical ring order is never read as chronology
// (I17.2). Returns SLOT_INVALID when the capacity is 0 or less or when the logical
// index is outside 0 .. count - 1; it never raises runtime.error and validates no
// ownership.
touchMarkPhysicalIndexRaw(ZoneEngine engine, int coreSlot, int logicalIndex) =>
    int capacity      = engine.touchMarkCapacityPerCore
    int physicalIndex = SLOT_INVALID
    if capacity > 0
        int count = array.get(engine.touchMarkRingCounts, coreSlot)
        if logicalIndex >= 0 and logicalIndex < count
            int head       = array.get(engine.touchMarkRingHeads, coreSlot)
            int ringOffset = (head + logicalIndex) % capacity
            physicalIndex := coreSlot * capacity + ringOffset
    physicalIndex

// ============================================================
// W02 Batch 8 : current-bar Event reusable pool writer (raw helper)
// Source: I17.2, I5, D11, D12
//
// Internal only. The current-bar Event list is a reuse pool (I17.2): Stage B resets
// eventLogicalCount to 0 and the 12 physical Event arrays are never cleared, never
// rebuilt and never shrunk. This writer puts one Event at the logical tail, reusing
// the physical row when the capacity already covers it and growing all 12 arrays by
// one row only when it does not.
//
// It is a raw writer, so it decides nothing:
//   - no Event detection and no Event ordering. The caller appends in the order the
//     spec requires (canonical Stage / Substage order, then coreId, generationId,
//     Support before Resistance); nothing is compared or sorted here.
//   - no validation and no correction of eventType, coreId, generationId, side,
//     Root ownership, range bottom / top, grade or weak reason: the values are
//     stored exactly as received.
// No ZoneEvent object is ever stored: the pool stays Structure of Arrays (I6.1).
// array.clear(), array.remove(), array.shift() and array.unshift() are never used.
//
// Call sites = 0 in this Batch: Stage C..K stay no-op placeholders and Stage B is
// unchanged. eventCount() / eventAt() keep exposing the logical length only, so the
// physical rows above it are never public.
eventAppendRaw(ZoneEngine engine, int eventType, int eventTime, int baseSeq, int coreId, int generationId, int side, float rangeBottom, float rangeTop, int touchNo, int gradeAtStart, int weakReason, int rootId) =>
    // Step 1 : logical tail of the current bar, 0-based and independent of capacity.
    int eventIndex = engine.eventLogicalCount
    if eventIndex < array.size(engine.eventTypes)
        // Step 2 : the physical row exists -> overwrite all 12 fields, never partly.
        array.set(engine.eventTypes,         eventIndex, eventType)
        array.set(engine.eventTimes,         eventIndex, eventTime)
        array.set(engine.eventBaseSeqs,      eventIndex, baseSeq)
        array.set(engine.eventCoreIds,       eventIndex, coreId)
        array.set(engine.eventGenerationIds, eventIndex, generationId)
        array.set(engine.eventSides,         eventIndex, side)
        array.set(engine.eventRangeBottoms,  eventIndex, rangeBottom)
        array.set(engine.eventRangeTops,     eventIndex, rangeTop)
        array.set(engine.eventTouchNos,      eventIndex, touchNo)
        array.set(engine.eventGradeAtStarts, eventIndex, gradeAtStart)
        array.set(engine.eventWeakReasons,   eventIndex, weakReason)
        array.set(engine.eventRootIds,       eventIndex, rootId)
    else
        // Step 3 : the pool has never been this long -> grow all 12 arrays by one row.
        array.push(engine.eventTypes,         eventType)
        array.push(engine.eventTimes,         eventTime)
        array.push(engine.eventBaseSeqs,      baseSeq)
        array.push(engine.eventCoreIds,       coreId)
        array.push(engine.eventGenerationIds, generationId)
        array.push(engine.eventSides,         side)
        array.push(engine.eventRangeBottoms,  rangeBottom)
        array.push(engine.eventRangeTops,     rangeTop)
        array.push(engine.eventTouchNos,      touchNo)
        array.push(engine.eventGradeAtStarts, gradeAtStart)
        array.push(engine.eventWeakReasons,   weakReason)
        array.push(engine.eventRootIds,       rootId)
    // Step 4 : the logical length grows only after all 12 fields are written.
    engine.eventLogicalCount := eventIndex + 1
    // Step 5
    eventIndex

// ============================================================
// W01 Batch 6A : name APIs (category / side / phase)
// Source: I5, A5, D03
//
// Conversion to text happens here only. No Engine state is read or written,
// no array / map is used and no debug string is produced (I6.5, D09).
// Unknown codes always return "UNKNOWN" (D03).
// ============================================================

export categoryName(int code) =>
    string name = "UNKNOWN"
    if code == CAT_MA
        name := "MA"
    else if code == CAT_SWING
        name := "Swing"
    else if code == CAT_ACCUM
        name := "Accum"
    else if code == CAT_TIME_HL
        name := "TimeHL"
    else if code == CAT_FVG
        name := "FVG"
    else if code == CAT_PSYCH
        name := "Psych"
    name

export sideName(int code) =>
    string name = "UNKNOWN"
    if code == SIDE_SUPPORT
        name := "Support"
    else if code == SIDE_RESISTANCE
        name := "Resistance"
    else if code == SIDE_NONE
        name := "None"
    name

export phaseName(int code) =>
    string name = "UNKNOWN"
    if code == PH_WAITING
        name := "Waiting"
    else if code == PH_ARMED
        name := "Armed"
    else if code == PH_ACTIVE_TOUCH
        name := "ActiveTouch"
    else if code == PH_BROKEN
        name := "Broken"
    else if code == PH_FLIP_WAIT
        name := "FlipWait"
    else if code == PH_DORMANT
        name := "Dormant"
    name

// ============================================================
// W01 Batch 6B : name APIs (grade / density / event)
// Source: I5, A5, D03
// Same rules as Batch 6A: pure conversion, no state access, no array / map,
// no debug string, "UNKNOWN" for any code outside the spec set.
// ============================================================

export gradeName(int code) =>
    string name = "UNKNOWN"
    if code == GR_STRONG
        name := "Strong"
    else if code == GR_NEUTRAL
        name := "Neutral"
    else if code == GR_WEAK
        name := "Weak"
    else if code == GR_UNAVAILABLE
        name := "Unavailable"
    name

export densityName(int code) =>
    string name = "UNKNOWN"
    if code == DEN_HIGH
        name := "High"
    else if code == DEN_NORMAL
        name := "Normal"
    else if code == DEN_BROAD_CONTEXT
        name := "BroadContext"
    name

export eventName(int code) =>
    string name = "UNKNOWN"
    if code == EV_NONE
        name := "None"
    else if code == EV_TOUCH_START
        name := "TouchStart"
    else if code == EV_TOUCH_RESET
        name := "TouchReset"
    else if code == EV_WEAK_DEPTH
        name := "WeakDepth"
    else if code == EV_LOCAL_BREAK
        name := "LocalBreak"
    else if code == EV_GAP_BREAK
        name := "GapBreak"
    else if code == EV_FLIP_ATTEMPT
        name := "FlipAttempt"
    else if code == EV_FLIP_CONFIRM
        name := "FlipConfirm"
    else if code == EV_RECLAIM
        name := "Reclaim"
    else if code == EV_FVG_INVALIDATE
        name := "FvgInvalidate"
    else if code == EV_INVERSE_ATTEMPT
        name := "InverseAttempt"
    else if code == EV_INVERSE_CONFIRM
        name := "InverseConfirm"
    else if code == EV_GENERATION_START
        name := "GenerationStart"
    else if code == EV_MERGE
        name := "Merge"
    else if code == EV_SPLIT
        name := "Split"
    else if code == EV_STORAGE_PRUNE
        name := "StoragePrune"
    name

// ============================================================
// W01 Batch 6C : buildId + read-only accessors (configErrorCode / rootCount)
// Source: I5, D01, D06, D08, D11
//
// Accessors are strictly read-only: no assignment, no array mutation, no
// validation, no lazy init, no debug string. Only updateConfirmed5m() may ever
// change Engine state (D11).
// ============================================================

// D01 fixed build string. Never derived from Cfg, Engine state or time, and never
// used in any logic decision (I5).
export buildId() =>
    "ZoneEngineV2_Rebuild_Strict20sV3"

// Persistent Cfg validation result stored at newEngine() time (D06).
// Code 6 is a Stage A Feed result and is never produced here.
export configErrorCode(ZoneEngine engine) =>
    engine.cfgErrorCode

// W02 Batch 5 : Public logical Root count, not the physical Root SoA capacity.
// Free physical slots are never exposed: the count is the length of
// rootIdOrderSlots, the Root ID ascending list of the Roots currently owning a
// slot (I6.2). rootLiveSlots is swap-popped and carries no public order, so it is
// never read here. No Root state / category / distance / display filtering, and
// not a configured limit: a Root that owns a slot is counted whatever its A6.2
// state (Candidate, Active, Invalidated, InverseWait, InverseActive, Retired).
export rootCount(ZoneEngine engine) =>
    array.size(engine.rootIdOrderSlots)

// ============================================================
// W01 Batch 6D : rootAt / eventCount / eventAt
// Source: I5, D08, I6.1, I19.1
//
// Read-only accessors. Each *At() builds a fresh projection UDT from the SoA
// registry and never returns an internal array or mutable reference (D08).
// Out-of-range index is always runtime.error("INDEX_OUT_OF_RANGE"): no clamping,
// no sentinel object, no na. No SoA length cross-checks are added here.
// ============================================================

// W02 Batch 5 : index is the Public logical Root index over rootIdOrderSlots
// (Root ID ascending), never a physical rootSlot. It is translated once into the
// physical rootSlot and every Root SoA read below uses that slot, so a reused or
// free physical slot never shifts the public order. No ownership re-validation is
// done here: rootIdOrderSlots is maintained atomically by the Batch 2 / Batch 4
// lifecycle helpers.
export rootAt(ZoneEngine engine, int index) =>
    if index < 0 or index >= array.size(engine.rootIdOrderSlots)
        runtime.error("INDEX_OUT_OF_RANGE")
    int rootSlot = array.get(engine.rootIdOrderSlots, index)
    // Root A6.2 contract only: the internal tick arrays stay out of the projection.
    Root.new(rootId        = array.get(engine.rootIds, rootSlot), originKey     = array.get(engine.rootOriginKeys, rootSlot), category      = array.get(engine.rootCategories, rootSlot), subtype       = array.get(engine.rootSubtypes, rootSlot), tfCode        = array.get(engine.rootTfCodes, rootSlot), originTime    = array.get(engine.rootOriginTimes, rootSlot), originEndTime = array.get(engine.rootOriginEndTimes, rootSlot), confirmedTime = array.get(engine.rootConfirmedTimes, rootSlot), pointPrice    = array.get(engine.rootPointPrices, rootSlot), nativeBottom  = array.get(engine.rootNativeBottoms, rootSlot), nativeTop     = array.get(engine.rootNativeTops, rootSlot), isRangeRoot   = array.get(engine.rootIsRangeRootFlags, rootSlot), isDynamic     = array.get(engine.rootIsDynamicFlags, rootSlot), state         = array.get(engine.rootStates, rootSlot), pairKey       = array.get(engine.rootPairKeys, rootSlot), direction     = array.get(engine.rootDirections, rootSlot), fvgFresh      = array.get(engine.rootFvgFreshFlags, rootSlot), isBroadFvg    = array.get(engine.rootIsBroadFvgFlags, rootSlot), labelMask     = array.get(engine.rootLabelMasks, rootSlot), lastUpdateSeq = array.get(engine.rootLastUpdateSeqs, rootSlot))

// Logical length of the current-bar Event list, never the physical array size.
export eventCount(ZoneEngine engine) =>
    engine.eventLogicalCount

export eventAt(ZoneEngine engine, int index) =>
    if index < 0 or index >= engine.eventLogicalCount
        runtime.error("INDEX_OUT_OF_RANGE")
    ZoneEvent.new(eventType    = array.get(engine.eventTypes, index), time         = array.get(engine.eventTimes, index), baseSeq      = array.get(engine.eventBaseSeqs, index), coreId       = array.get(engine.eventCoreIds, index), generationId = array.get(engine.eventGenerationIds, index), side         = array.get(engine.eventSides, index), rangeBottom  = array.get(engine.eventRangeBottoms, index), rangeTop     = array.get(engine.eventRangeTops, index), touchNo      = array.get(engine.eventTouchNos, index), gradeAtStart = array.get(engine.eventGradeAtStarts, index), weakReason   = array.get(engine.eventWeakReasons, index), rootId       = array.get(engine.eventRootIds, index))

// ============================================================
// W01 Batch 6E : viewCount / viewAt
// Source: I5, A6.8, A6.10, D08, D09, I19.1
//
// One physical ZoneCore is never duplicated per side: each held Core yields
// exactly two View rows, Support first then Resistance (A6.8).
// Views are built on request from the current Core / Side state only; no
// per-bar projection array is stored (I19.1).
// ============================================================

// W02 Batch 7 : Public logical View count, not the physical Core SoA capacity.
// Every held Core (Live + Dormant) in coreIdOrderSlots contributes its Support and
// Resistance rows, so free physical Core slots are never exposed. Never narrowed by
// distance, Grade, eligibility, strength or Dormant (I5). coreLiveSlots is
// swap-popped and carries no public order, so it is never read here.
export viewCount(ZoneEngine engine) =>
    array.size(engine.coreIdOrderSlots) * 2

// W02 Batch 7 : index is the Public logical View index, never a physical slot.
// The order is coreIdOrderSlots (Core ID ascending), and inside each Core the two
// rows are Support first then Resistance (A6.8). The index is split into the
// logical Core position and the side, the position is translated into the physical
// coreSlot, and the Side state is read at coreSlot * 2 + sideIndex, so a reused or
// free physical slot never shifts the public order. No ownership re-validation is
// done here (coreIdOrderSlots is maintained atomically by the Batch 6 lifecycle
// paths) and no per-bar projection array is stored (I19.1).
export viewAt(ZoneEngine engine, int index) =>
    if index < 0 or index >= array.size(engine.coreIdOrderSlots) * 2
        runtime.error("INDEX_OUT_OF_RANGE")
    int logicalCoreIndex = int(index / 2)
    int sideIndex        = index % 2
    int coreSlot         = array.get(engine.coreIdOrderSlots, logicalCoreIndex)
    int sideSlot         = coreSlot * 2 + sideIndex
    // A6.3 consumption flags -> A5 weak reason code
    bool weakByTouch = array.get(engine.sideWeakByTouchFlags, sideSlot)
    bool weakByDepth = array.get(engine.sideWeakByDepthFlags, sideSlot)
    int  weakReason  = weakByTouch and weakByDepth ? WEAK_BY_BOTH : weakByTouch ? WEAK_BY_TOUCH : weakByDepth ? WEAK_BY_DEPTH : WEAK_NONE
    // Side View range is used as is: the physical Core range never overrides it (A6.8).
    // The seven FVG / Root diagnostic fields have no backing state in Window 01 and
    // stay at their contract sentinel 0 until the owning Window supplies them.
    ZoneView.new(coreId = array.get(engine.coreIds, coreSlot), generationId = array.get(engine.coreGenerationIds, coreSlot), side = sideIndex == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, effectiveBottom = array.get(engine.sideEffectiveBottoms, sideSlot), effectiveTop = array.get(engine.sideEffectiveTops, sideSlot), referencePrice = array.get(engine.sideReferencePrices, sideSlot), phase = array.get(engine.sidePhases, sideSlot), grade = array.get(engine.sideGrades, sideSlot), cCount = array.get(engine.sideCCounts, sideSlot), hCount = array.get(engine.sideHCounts, sideSlot), density = array.get(engine.sideDensities, sideSlot), baseStrong = array.get(engine.sideBaseStrongFlags, sideSlot), currentTouchNo = array.get(engine.sideCurrentTouchNos, sideSlot), upcomingTouchNo = array.get(engine.sideUpcomingTouchNos, sideSlot), zoneFresh = array.get(engine.coreZoneFreshFlags, coreSlot), sideFresh = array.get(engine.sideFreshFlags, sideSlot), weakReason = weakReason, maxDepthPct = array.get(engine.sideMaxDepthPcts, sideSlot), isBroadContext = array.get(engine.sideIsBroadContextFlags, sideSlot), fvgDirectionMask = 0, fvgRootCount = 0, fvgFreshCount = 0, fvgStructuralStateMask = 0, eligible = array.get(engine.sideEligibleFlags, sideSlot), rootCountInView = 0, categoryMask = 0, highMask = 0)

// ============================================================
// W01 Batch 7 : updateConfirmed5m - update gate skeleton
// Source: I5, I8, D06, D07, D10, D11
//
// The only Public API that mutates a running ZoneEngine (D11).
// Stage order A..L is absolute. Window 01 implements Stage A, Stage B and the
// Base commit of Stage L; Stage C..K are ordered no-op placeholders owned by
// later windows.
// ============================================================

export updateConfirmed5m(ZoneEngine engine, ZoneCfg cfg, Feed feed) =>
    bool committed = false

    // ---- Stage A : validate Feed and config, reject duplicate Base bars ----
    // A-1 : revalidate only when a Cfg fingerprint changed (D10).
    int fpA = cfgFingerprint(cfg, FP_SEED_A, FP_MULT_A)
    int fpB = cfgFingerprint(cfg, FP_SEED_B, FP_MULT_B)
    if fpA != engine.cfgFingerprintA or fpB != engine.cfgFingerprintB
        int recheckedCode = validateCfg(cfg)
        engine.cfgFingerprintA := fpA
        engine.cfgFingerprintB := fpB
        engine.cfgErrorCode    := recheckedCode
        engine.configValid     := recheckedCode == ERR_OK

    // Invalid Cfg: no commit, no Event clear, no Base state change.
    if engine.configValid
        // A-2 : Feed metadata. Code 6 is transient and never written into the
        // persistent Cfg validation state (D06, D07).
        if validateFeedMetadata(cfg, feed) == ERR_OK
            // A-3 : unconfirmed Feed is not committed (D07).
            if feed.baseConfirmed
                // A-4 : duplicate / past Feed, evaluated only after the first commit.
                bool firstCommitDone = engine.lastBaseSeq != SEQ_UNSET
                bool duplicateOrPast = firstCommitDone and (feed.baseSeq <= engine.lastBaseSeq or feed.baseCloseTime <= engine.lastBaseCloseTime)
                if not duplicateOrPast
                    // ---- Stage B : current-bar Event logical length back to 0 ----
                    // Logical length only: the physical Event SoA arrays are kept.
                    engine.eventLogicalCount := 0

                    // Stage C
                    // Stage D
                    // Stage E
                    // Stage F
                    // Stage G
                    // Stage H
                    // Stage I
                    // Stage J
                    // Stage K

                    // ---- Stage L : commit Events and confirmed state ----
                    engine.lastBaseSeq       := feed.baseSeq
                    engine.lastBaseCloseTime := feed.baseCloseTime
                    committed := true

    committed

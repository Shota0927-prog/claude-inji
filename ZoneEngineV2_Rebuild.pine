        ok := map.contains(chosenMap, pairKey)
        if ok
            ok := map.get(chosenMap, pairKey) == rootSlot
    if ok and map.contains(oppositeMap, pairKey)
        int mateSlot = map.get(oppositeMap, pairKey)
        ok := mateSlot >= 0 and mateSlot != rootSlot and mateSlot < array.size(engine.rootIds) and mateSlot < array.size(engine.rootSlotLiveFlags) and mateSlot < array.size(engine.rootCategories) and mateSlot < array.size(engine.rootTfCodes) and mateSlot < array.size(engine.rootPairKeys)

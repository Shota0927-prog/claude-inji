                    array.pop(engine.rootLiveSlots)
                    // Step 6 : rootIdOrderSlots must keep Root ID ascending order ->
                    // order preserving shift with array.set / array.get, then pop.
                    int idSize = array.size(engine.rootIdOrderSlots)
                    int j = idOrderPos
                    while j < idSize - 1
                        array.set(engine.rootIdOrderSlots, j, array.get(engine.rootIdOrderSlots, j + 1))
                        j += 1
                    array.pop(engine.rootIdOrderSlots)
                    // W02 Batch 4 Step D : the freed Root ID leaves the I11-1 index. A freed
                    // Root ID is never kept as a stale key and is never re-added.
                    map.remove(engine.rootIdToSlot, oldRootId)
                    // Step 7 : field reset, including rootSlotLiveFlags -> false. Every
                    // index above has already released the Root.
                    rootResetSlotRaw(engine, rootSlot)
                    // Step 8 : freed slot enters the free stack exactly once.
                    array.push(engine.rootFreeSlots, rootSlot)
                    freed := true

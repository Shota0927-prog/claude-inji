fvgSetMembershipValidRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions)
    int  tf    = int(na)
    int  dir   = int(na)
    int  state = int(na)
    if ok
        tf    := array.get(engine.rootTfCodes,    rootSlot)
        dir   := array.get(engine.rootDirections, rootSlot)
        state := array.get(engine.rootStates,     rootSlot)
        ok    := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and (state == ROOT_ACTIVE or state == ROOT_INVALIDATED)
    if ok
        array<int> freshSet  = tf == TF_1H ? engine.freshFvg1hRootSlots : tf == TF_4H ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
        array<int> activeSet = tf == TF_1H ? engine.structurallyActiveFvg1hRootSlots : tf == TF_4H ? engine.structurallyActiveFvg4hRootSlots : engine.structurallyActiveFvgDRootSlots
        array<int> dirSet    = dir == FVG_BULLISH ? engine.bullishFvgRootSlots : engine.bearishFvgRootSlots
        int freshPos  = array.get(engine.rootFvgFreshSetPositions,           rootSlot)
        int structPos = array.get(engine.rootFvgStructuralStateSetPositions, rootSlot)
        int dirPos    = array.get(engine.rootFvgDirectionSetPositions,       rootSlot)
        int broadPos  = array.get(engine.rootFvgBroadSetPositions,           rootSlot)
        if array.get(engine.rootFvgFreshFlags, rootSlot)
            ok := freshPos >= 0 and freshPos < array.size(freshSet)
            if ok
                ok := array.get(freshSet, freshPos) == rootSlot
        else
            ok := freshPos == SLOT_INVALID
        if ok
            if state == ROOT_ACTIVE
                ok := structPos >= 0 and structPos < array.size(activeSet)
                if ok
                    ok := array.get(activeSet, structPos) == rootSlot
            else
                ok := structPos == SLOT_INVALID
        if ok
            ok := dirPos >= 0 and dirPos < array.size(dirSet)
            if ok
                ok := array.get(dirSet, dirPos) == rootSlot
        if ok
            if array.get(engine.rootIsBroadFvgFlags, rootSlot)
                ok := broadPos >= 0 and broadPos < array.size(engine.broadFvgRootSlots)
                if ok
                    ok := array.get(engine.broadFvgRootSlots, broadPos) == rootSlot
            else
                ok := broadPos == SLOT_INVALID

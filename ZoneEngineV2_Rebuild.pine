        array.push(engine.w02Aux.corePendingTopologyChildCounts     , 0)
    int newCoreId = engine.nextCoreId
    engine.nextCoreId := newCoreId + 1
    array.set(engine.coreIds,           coreSlot, newCoreId)
    array.set(engine.coreSlotLiveFlags, coreSlot, true)
    array.set(engine.touchMarkRingOwnerCoreIds, coreSlot, newCoreId)
    array.set(engine.touchMarkRingHeads,        coreSlot, 0)
    array.set(engine.touchMarkRingCounts,       coreSlot, 0)
    phaseSetAddRaw(engine, coreSlot * 2)
    phaseSetAddRaw(engine, coreSlot * 2 + 1)
    map.put(engine.coreIdToSlot, newCoreId, coreSlot)
    array.push(engine.coreLiveSlots, coreSlot)
    array.push(engine.coreIdOrderSlots, coreSlot)
    coreSlot
coreFreeSlotRaw(ZoneEngine engine, int coreSlot) =>
    bool validSlot = coreSlot >= 0 and coreSlot < array.size(engine.coreIds)
    bool isLive    = validSlot and array.get(engine.coreSlotLiveFlags, coreSlot)
    int  oldCoreId = isLive ? array.get(engine.coreIds, coreSlot) : ID_NONE
    bool idIndexValid = isLive and oldCoreId != ID_NONE and map.contains(engine.coreIdToSlot, oldCoreId) and map.get(engine.coreIdToSlot, oldCoreId) == coreSlot
    bool freed     = false
    if isLive
        int livePos = SLOT_INVALID
        int i = 0
        while i < array.size(engine.coreLiveSlots) and livePos == SLOT_INVALID
            if array.get(engine.coreLiveSlots, i) == coreSlot
                livePos := i
            else
                i += 1
        int idOrderPos = SLOT_INVALID
        int k = 0
        while k < array.size(engine.coreIdOrderSlots) and idOrderPos == SLOT_INVALID
            if array.get(engine.coreIdOrderSlots, k) == coreSlot
                idOrderPos := k
            else
                k += 1
        int  supportSideSlot      = coreSlot * 2
        int  resistanceSideSlot   = coreSlot * 2 + 1
        bool supportPhaseValid    = phaseSetMembershipValidRaw(engine, supportSideSlot)
        bool resistancePhaseValid = phaseSetMembershipValidRaw(engine, resistanceSideSlot)
        if livePos != SLOT_INVALID and idOrderPos != SLOT_INVALID and idIndexValid and supportPhaseValid and resistancePhaseValid
            bool participationDetached = participationDetachAllForCoreRaw(engine, coreSlot)
            if participationDetached
                phaseSetDetachRaw(engine, supportSideSlot)
                phaseSetDetachRaw(engine, resistanceSideSlot)
                int lastPos = array.size(engine.coreLiveSlots) - 1
                if livePos != lastPos
                    array.set(engine.coreLiveSlots, livePos, array.get(engine.coreLiveSlots, lastPos))
                array.pop(engine.coreLiveSlots)
                int idSize = array.size(engine.coreIdOrderSlots)
                int j = idOrderPos
                while j < idSize - 1
                    array.set(engine.coreIdOrderSlots, j, array.get(engine.coreIdOrderSlots, j + 1))
                    j += 1
                array.pop(engine.coreIdOrderSlots)
                map.remove(engine.coreIdToSlot, oldCoreId)
                coreResetSlotRaw(engine, coreSlot)
                array.push(engine.coreFreeSlots, coreSlot)
                freed := true
    freed
touchMarkAppendRaw(ZoneEngine engine, int coreSlot, int baseSeq, int touchTime, int side, float contactBottom, float contactTop, float closeAtTouch, int generationId, bool isNormalTouch) =>
    int capacity      = engine.touchMarkCapacityPerCore
    int physicalIndex = SLOT_INVALID
    if capacity > 0
        int head      = array.get(engine.touchMarkRingHeads,  coreSlot)
        int count     = array.get(engine.touchMarkRingCounts, coreSlot)
        int blockBase = coreSlot * capacity
        int ringOffset = count < capacity ? (head + count) % capacity : head
        physicalIndex := blockBase + ringOffset
        array.set(engine.touchMarkBaseSeqs,           physicalIndex, baseSeq)
        array.set(engine.touchMarkTimes,              physicalIndex, touchTime)
        array.set(engine.touchMarkSides,              physicalIndex, side)
        array.set(engine.touchMarkContactBottoms,     physicalIndex, contactBottom)
        array.set(engine.touchMarkContactTops,        physicalIndex, contactTop)
        array.set(engine.touchMarkCloseAtTouches,     physicalIndex, closeAtTouch)
        array.set(engine.touchMarkGenerationIds,      physicalIndex, generationId)
        array.set(engine.touchMarkIsNormalTouchFlags, physicalIndex, isNormalTouch)
        if count < capacity
            array.set(engine.touchMarkRingCounts, coreSlot, count + 1)
        else
            array.set(engine.touchMarkRingHeads, coreSlot, (head + 1) % capacity)
    physicalIndex
touchMarkPhysicalIndexRaw(ZoneEngine engine, int coreSlot, int logicalIndex) =>
    int capacity      = engine.touchMarkCapacityPerCore
    int physicalIndex = SLOT_INVALID
    if capacity > 0
        int count = array.get(engine.touchMarkRingCounts, coreSlot)
        if logicalIndex >= 0 and logicalIndex < count
            int head       = array.get(engine.touchMarkRingHeads, coreSlot)
            int ringOffset = (head + logicalIndex) % capacity
            physicalIndex := coreSlot * capacity + ringOffset
    physicalIndex
eventAppendRaw(ZoneEngine engine, int eventType, int eventTime, int baseSeq, int coreId, int generationId, int side, float rangeBottom, float rangeTop, int touchNo, int gradeAtStart, int weakReason, int rootId) =>
    int eventIndex = engine.eventLogicalCount
    if eventIndex < array.size(engine.eventTypes)
        array.set(engine.eventTypes,         eventIndex, eventType)
        array.set(engine.eventTimes,         eventIndex, eventTime)
        array.set(engine.eventBaseSeqs,      eventIndex, baseSeq)
        array.set(engine.eventCoreIds,       eventIndex, coreId)
        array.set(engine.eventGenerationIds, eventIndex, generationId)
        array.set(engine.eventSides,         eventIndex, side)
        array.set(engine.eventRangeBottoms,  eventIndex, rangeBottom)
        array.set(engine.eventRangeTops,     eventIndex, rangeTop)
        array.set(engine.eventTouchNos,      eventIndex, touchNo)
        array.set(engine.eventGradeAtStarts, eventIndex, gradeAtStart)
        array.set(engine.eventWeakReasons,   eventIndex, weakReason)
        array.set(engine.eventRootIds,       eventIndex, rootId)
    else
        array.push(engine.eventTypes,         eventType)
        array.push(engine.eventTimes,         eventTime)
        array.push(engine.eventBaseSeqs,      baseSeq)
        array.push(engine.eventCoreIds,       coreId)
        array.push(engine.eventGenerationIds, generationId)
        array.push(engine.eventSides,         side)
        array.push(engine.eventRangeBottoms,  rangeBottom)
        array.push(engine.eventRangeTops,     rangeTop)
        array.push(engine.eventTouchNos,      touchNo)
        array.push(engine.eventGradeAtStarts, gradeAtStart)
        array.push(engine.eventWeakReasons,   weakReason)
        array.push(engine.eventRootIds,       rootId)
    engine.eventLogicalCount := eventIndex + 1
    eventIndex

                else if op == JOP_SWING_TF_MERGE or op == JOP_TIMEHL_LABEL or op == JOP_ROOT_RETIRE
                    // Step 1 : the row contract shared by the three point-Root helpers
                    int rowNewState = op == JOP_ROOT_RETIRE ? ROOT_RETIRED : ROOT_ACTIVE
                    ok := rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and oldState == ROOT_ACTIVE and newState == rowNewState and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad
                    // Step 2 : the op's own row contract
                    if ok
                        if op == JOP_SWING_TF_MERGE
                            ok := category == CAT_SWING and (subtype == SUB_SWING_HIGH or subtype == SUB_SWING_LOW) and (tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H)
                            if ok
                                if tfCode == TF_5M
                                    ok := (oldMask == 2 or oldMask == 4 or oldMask == 6) and newMask == oldMask + SWING_TF_MASK_5M
                                else if tfCode == TF_15M
                                    ok := (oldMask == 1 or oldMask == 4 or oldMask == 5) and newMask == oldMask + SWING_TF_MASK_15M
                                else
                                    ok := (oldMask == 1 or oldMask == 2 or oldMask == 3) and newMask == oldMask + SWING_TF_MASK_1H
                        else if op == JOP_TIMEHL_LABEL
                            ok := category == CAT_TIME_HL and (subtype == SUB_TIMEHL_HIGH or subtype == SUB_TIMEHL_LOW) and tfCode == TF_5M and oldMask >= 1 and oldMask <= 63 and newMask >= 0 and newMask <= 63 and newMask != oldMask
                        else
                            ok := category == CAT_TIME_HL and (subtype == SUB_TIMEHL_HIGH or subtype == SUB_TIMEHL_LOW) and tfCode == TF_5M and oldMask == 0 and newMask == 0
                    // Step 3 : the target point Root - a committed live Root, or the Root one
                    // earlier NEW_ROOT of this bar creates at this predicted address
                    bool committedTarget = false
                    int  targetCategory  = int(na)
                    int  targetTf        = int(na)
                    int  targetOriginKey = ID_NONE
                    if ok
                        committedTarget := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags)
                        if committedTarget
                            committedTarget := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
                    if ok and committedTarget
                        if ok
                            ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.rootStateSetPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootSubtypes, rootSlot) == subtype and virtualRootStateBeforeRaw(engine, rootSlot, expectedRootId, row) == ROOT_ACTIVE and not array.get(engine.rootIsRangeRootFlags, rootSlot) and not array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == FVG_NONE and not array.get(engine.rootFvgFreshFlags, rootSlot) and not array.get(engine.rootIsBroadFvgFlags, rootSlot) and not na(array.get(engine.rootPointPrices, rootSlot)) and na(array.get(engine.rootNativeBottoms, rootSlot)) and na(array.get(engine.rootNativeTops, rootSlot))
                        if ok
                            ok := rootSetMembershipValidRaw(engine, rootSlot)
                        if ok

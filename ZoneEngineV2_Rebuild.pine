    float clusterMaxWidth    = 20.0
    float denseRatio         = 0.50
    float touchResetDistance = 10.0
    int   strongUntilTouch   = 1
    bool  strongUnlimited    = false
    int   weakFromTouch      = 2
    bool  weakFromTouchOff   = false
    float weakDepthPct       = 50.0
    bool  weakDepthOff       = false
    float breakBuffer        = 2.0
    float touchTolerance     = 0.0
    int   emaSlopeLookback   = 60
    int   swingLen5m         = 10
    int   swingLen15m        = 8
    int   swingLen1h         = 6
    // --- accum detection (appendix A 4.2) ----------------------------------
    int   accumRangeLen       = 10
    int   accumBaseLen        = 20
    int   accumAtrLen         = 14
    int   accumMinUpperCloses = 4
    int   accumMinLowerCloses = 4
    int   accumMaxSameColorRun = 4
    float accumAtrMult        = 2.5
    float accumBarRatioMax    = 0.70
    float accumDriftMax       = 0.30
    // --- time settings (appendix A 4.3) ------------------------------------
    string zoneTimezone   = "Asia/Tokyo"
    int    asiaStartMin   = 540    // 09:00
    int    europeStartMin = 840    // 14:00
    int    nyStartMin     = 1140   // 19:00
    int    nyEndMin       = 180    // 03:00 next day
    int    dayCutMin      = 300    // 05:00
    int    weekCutDow     = 2      // dayofweek.monday
    // --- categories on/off --------------------------------------------------
    bool catMa    = true
    bool catSwing = true
    bool catAccum = true
    bool catTime  = true
    bool catFvg   = true
    bool catPsych = true
    // --- storage / display limits (appendix A 4.4) --------------------------
    int   maxSwingRoots       = 180
    int   maxAccumBoxes       = 60
    int   maxFvgRoots         = 120
    int   maxTimeRoots        = 32
    int   maxZoneCores        = 80
    int   maxEndedGenerations = 30
    int   maxTouchMarksPerCore = 64
    float dormantDistance     = 500.0
    // --- feed ---------------------------------------------------------------
    float mintick = 0.01
    // --- derived / validation ----------------------------------------------
    float denseWidth = 10.0
    bool  valid      = true
    string errorText = ""


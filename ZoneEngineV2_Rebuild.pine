    freed

// ============================================================
// W03 Batch 14 : NEW_ROOT apply helper (Stage F / E2)
// Source: I8 (Stage F), I10, I11-1 .. I11-6, A7.3 - A7.6, D02, D12
//
// Internal only. Applies one JOP_NEW_ROOT / JGROUP_E2 journal row synchronously:
// row validation -> rootAllocSlotRaw (Root ID from nextRootId, never generated
// here) -> created slot + Root ID written back to the row -> Root SoA content ->
// rootWritePricesAndTicksRaw -> index attach in this fixed order:
//   point Root : origin -> Category / TF / state -> common price order -> Accum pair
//   FVG        : origin -> Category / TF / state -> NativeRange -> FVG non-price sets
// Only the row itself is validated before the alloc. The later Stage F preflight
// (F0) must prove that every attach after the alloc succeeds, so there is no
// failure branch, rollback or rootFreeSlotRaw after the alloc.
// W03 creates no Candidate or Psych Root; FVG never enters the common price order.
// MA slope, MA / TimeHL refs, nextAccumPairKey and revisions are committed
// elsewhere (F5 / F6) and are not written here. Business call sites = 0.
// ============================================================

// Applies one NEW_ROOT journal row. Returns the created rootSlot, or SLOT_INVALID
// with zero mutation when the row itself is not a valid W03 NEW_ROOT row.
newRootApplyRaw(ZoneEngine engine, int journalRow, float mintick) =>
    int result = SLOT_INVALID
    // Step 1 : the row exists and is an unapplied NEW_ROOT of group E2
    bool ok = journalRow >= 0 and journalRow < engine.w03Store.journalCount and journalRow < array.size(engine.w03Store.journalOps) and journalRow < array.size(engine.w03Store.journalGroups) and journalRow < array.size(engine.w03Store.journalTargetRootSlots) and journalRow < array.size(engine.w03Store.journalExpectedRootIds) and journalRow < array.size(engine.w03Store.journalCategories) and journalRow < array.size(engine.w03Store.journalSubtypes) and journalRow < array.size(engine.w03Store.journalTfCodes) and journalRow < array.size(engine.w03Store.journalOriginKeys) and journalRow < array.size(engine.w03Store.journalOriginTimes) and journalRow < array.size(engine.w03Store.journalOriginEndTimes) and journalRow < array.size(engine.w03Store.journalConfirmedTimes) and journalRow < array.size(engine.w03Store.journalPointPrices) and journalRow < array.size(engine.w03Store.journalNativeBottoms) and journalRow < array.size(engine.w03Store.journalNativeTops) and journalRow < array.size(engine.w03Store.journalOldStates) and journalRow < array.size(engine.w03Store.journalNewStates) and journalRow < array.size(engine.w03Store.journalFvgFreshFlags) and journalRow < array.size(engine.w03Store.journalIsBroadFlags) and journalRow < array.size(engine.w03Store.journalDirections) and journalRow < array.size(engine.w03Store.journalOldMasks) and journalRow < array.size(engine.w03Store.journalNewMasks) and journalRow < array.size(engine.w03Store.journalPairKeys) and journalRow < array.size(engine.w03Store.journalSlopeDirs)
    if ok
        ok := array.get(engine.w03Store.journalOps, journalRow) == JOP_NEW_ROOT and array.get(engine.w03Store.journalGroups, journalRow) == JGROUP_E2 and array.get(engine.w03Store.journalTargetRootSlots, journalRow) == SLOT_INVALID and array.get(engine.w03Store.journalExpectedRootIds, journalRow) == ID_NONE and not na(mintick) and mintick > 0 and engine.w03Store.journalBaseSeq != SEQ_UNSET
    int   category      = int(na)
    int   subtype       = int(na)
    int   tfCode        = int(na)
    int   originKey     = ID_NONE
    int   originTime    = int(na)
    int   originEndTime = int(na)
    int   confirmedTime = int(na)
    float pointPrice    = na
    float nativeBottom  = na
    float nativeTop     = na
    int   newState      = int(na)
    bool  fvgFresh      = false
    bool  isBroad       = false
    int   direction     = int(na)
    int   newMask       = int(na)
    int   pairKey       = int(na)
    if ok
        category      := array.get(engine.w03Store.journalCategories,     journalRow)
        subtype       := array.get(engine.w03Store.journalSubtypes,       journalRow)
        tfCode        := array.get(engine.w03Store.journalTfCodes,        journalRow)
        originKey     := array.get(engine.w03Store.journalOriginKeys,     journalRow)
        originTime    := array.get(engine.w03Store.journalOriginTimes,    journalRow)
        originEndTime := array.get(engine.w03Store.journalOriginEndTimes, journalRow)
        confirmedTime := array.get(engine.w03Store.journalConfirmedTimes, journalRow)
        pointPrice    := array.get(engine.w03Store.journalPointPrices,    journalRow)
        nativeBottom  := array.get(engine.w03Store.journalNativeBottoms,  journalRow)
        nativeTop     := array.get(engine.w03Store.journalNativeTops,     journalRow)
        newState      := array.get(engine.w03Store.journalNewStates,      journalRow)
        fvgFresh      := array.get(engine.w03Store.journalFvgFreshFlags,  journalRow)
        isBroad       := array.get(engine.w03Store.journalIsBroadFlags,   journalRow)
        direction     := array.get(engine.w03Store.journalDirections,     journalRow)
        newMask       := array.get(engine.w03Store.journalNewMasks,       journalRow)
        pairKey       := array.get(engine.w03Store.journalPairKeys,       journalRow)
        // Step 2 : common NEW_ROOT contract
        ok := originKey != ID_NONE and not na(originTime) and not na(confirmedTime) and newState == ROOT_ACTIVE
    // Step 3 : the Category row contract (Psych and unknown Categories are refused)
    if ok
        if category == CAT_MA
            ok := (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and tfCode == TF_1M and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == SWING_TF_MASK_NONE
        else if category == CAT_SWING
            int tfMask = tfCode == TF_5M ? SWING_TF_MASK_5M : tfCode == TF_15M ? SWING_TF_MASK_15M : tfCode == TF_1H ? SWING_TF_MASK_1H : SWING_TF_MASK_NONE
            ok := (subtype == SUB_SWING_HIGH or subtype == SUB_SWING_LOW) and (tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H) and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and not na(originEndTime) and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == tfMask
        else if category == CAT_ACCUM
            ok := (subtype == SUB_ACCUM_UPPER or subtype == SUB_ACCUM_LOWER) and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and na(originEndTime) and pairKey != ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask == 0
        else if category == CAT_TIME_HL
            ok := (subtype == SUB_TIMEHL_HIGH or subtype == SUB_TIMEHL_LOW) and tfCode == TF_5M and not na(pointPrice) and na(nativeBottom) and na(nativeTop) and not na(originEndTime) and originEndTime == confirmedTime and pairKey == ID_NONE and direction == FVG_NONE and not fvgFresh and not isBroad and newMask >= 1 and newMask <= 63
        else if category == CAT_FVG
            ok := (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and na(pointPrice) and not na(nativeBottom) and not na(nativeTop) and not na(originEndTime) and originEndTime == confirmedTime and pairKey == ID_NONE and (direction == FVG_BULLISH or direction == FVG_BEARISH) and fvgFresh and newMask == 0
            if ok
                // comparison ticks with the one existing rule, never a float comparison
                ok := math.round(nativeBottom / mintick) <= math.round(nativeTop / mintick)
        else
            ok := false
    // Step 4 : commit. Nothing below branches on success; F0 has proven every attach.
    if ok
        bool isFvg = category == CAT_FVG
        int rootSlot  = rootAllocSlotRaw(engine)
        int newRootId = array.get(engine.rootIds, rootSlot)
        // the created identity goes back into this row for F6
        array.set(engine.w03Store.journalTargetRootSlots, journalRow, rootSlot)
        array.set(engine.w03Store.journalExpectedRootIds, journalRow, newRootId)
        // Root SoA content (rootIds and the live flag belong to rootAllocSlotRaw)
        array.set(engine.rootOriginKeys,       rootSlot, originKey)
        array.set(engine.rootCategories,       rootSlot, category)
        array.set(engine.rootSubtypes,         rootSlot, subtype)
        array.set(engine.rootTfCodes,          rootSlot, tfCode)
        array.set(engine.rootOriginTimes,      rootSlot, originTime)
        array.set(engine.rootOriginEndTimes,   rootSlot, originEndTime)
        array.set(engine.rootConfirmedTimes,   rootSlot, confirmedTime)
        array.set(engine.rootStates,           rootSlot, ROOT_ACTIVE)
        array.set(engine.rootPairKeys,         rootSlot, category == CAT_ACCUM ? pairKey : ID_NONE)
        array.set(engine.rootDirections,       rootSlot, isFvg ? direction : FVG_NONE)
        array.set(engine.rootFvgFreshFlags,    rootSlot, isFvg)
        array.set(engine.rootIsBroadFvgFlags,  rootSlot, isFvg ? isBroad : false)
        array.set(engine.rootLabelMasks,       rootSlot, category == CAT_TIME_HL ? newMask : 0)
        array.set(engine.rootLastUpdateSeqs,   rootSlot, engine.w03Store.journalBaseSeq)
        array.set(engine.rootIsRangeRootFlags, rootSlot, isFvg)
        array.set(engine.rootIsDynamicFlags,   rootSlot, category == CAT_MA)
        if category == CAT_SWING
            array.set(engine.w03Store.rootSwingTfMasks, rootSlot, newMask)
        // float prices and their comparison ticks, through the one existing writer
        rootWritePricesAndTicksRaw(engine, rootSlot, pointPrice, nativeBottom, nativeTop, mintick)
        // Attach 1 : origin bucket
        bool originAttached = originBucketAttachRaw(engine, rootSlot, newRootId)
        // Attach 2 : general Category / TF / state sets
        bool setAttached = rootSetAddAllRaw(engine, rootSlot)
        // Attach 3 : price index - NativeRange for FVG, the common order otherwise
        bool priceAttached = isFvg ? fvgNativeRangeOrderInsertRaw(engine, rootSlot, newRootId) : rootPriceOrderInsertRaw(engine, rootSlot, newRootId)
        // Attach 4 : Category-specific index
        if category == CAT_ACCUM
            // the registration path fixes the boundary; the pair helper never infers it
            bool pairAttached = accumPairAttachRaw(engine, rootSlot, newRootId, subtype == SUB_ACCUM_UPPER)
        else if isFvg
            bool fvgSetAttached = fvgSetAddAllRaw(engine, rootSlot, newRootId)
        result := rootSlot
    result

// ============================================================
// W03 Batch 15 : MA_UPDATE apply helper (Stage F / E3)
// Source: I7.1 (1m EMA adoption), I10 (fixed MA Root), A7.2, D12
//
// Internal only. Applies one JOP_MA_UPDATE / JGROUP_E3 journal row to the existing
// MA Root it targets: no Root is created, the Root ID and origin bucket stay, and
// no Category / TF / state / FVG index moves. The row and the target Root are
// validated first; then originTime, confirmedTime and lastUpdateSeq are written and
// the existing rootPriceOrderMoveRaw writes the point price, its tick and the price
// order position in one call. It runs even when the price is unchanged (a slope or
// 1m time change also emits MA_UPDATE). originEndTime is never written.
// The MA slope and Root ref scalars, revisions and the journal are not written
// here (F5 / F6). F0 proves the move succeeds, so there is no rollback after the
// first write. Business call sites = 0.
// ============================================================

// Applies one MA_UPDATE journal row. true when applied; false with zero mutation
// when the row or its target Root does not meet the MA_UPDATE contract.
maUpdateApplyRaw(ZoneEngine engine, int journalRow, float mintick) =>
    // Step 1 : the row exists and is an MA_UPDATE of group E3
    bool ok = journalRow >= 0 and journalRow < engine.w03Store.journalCount and journalRow < array.size(engine.w03Store.journalOps) and journalRow < array.size(engine.w03Store.journalGroups) and journalRow < array.size(engine.w03Store.journalTargetRootSlots) and journalRow < array.size(engine.w03Store.journalExpectedRootIds) and journalRow < array.size(engine.w03Store.journalCategories) and journalRow < array.size(engine.w03Store.journalSubtypes) and journalRow < array.size(engine.w03Store.journalTfCodes) and journalRow < array.size(engine.w03Store.journalOriginKeys) and journalRow < array.size(engine.w03Store.journalOriginTimes) and journalRow < array.size(engine.w03Store.journalOriginEndTimes) and journalRow < array.size(engine.w03Store.journalConfirmedTimes) and journalRow < array.size(engine.w03Store.journalPointPrices) and journalRow < array.size(engine.w03Store.journalNativeBottoms) and journalRow < array.size(engine.w03Store.journalNativeTops) and journalRow < array.size(engine.w03Store.journalOldStates) and journalRow < array.size(engine.w03Store.journalNewStates) and journalRow < array.size(engine.w03Store.journalFvgFreshFlags) and journalRow < array.size(engine.w03Store.journalIsBroadFlags) and journalRow < array.size(engine.w03Store.journalDirections) and journalRow < array.size(engine.w03Store.journalOldMasks) and journalRow < array.size(engine.w03Store.journalNewMasks) and journalRow < array.size(engine.w03Store.journalPairKeys) and journalRow < array.size(engine.w03Store.journalSlopeDirs)
    int   rootSlot       = SLOT_INVALID
    int   expectedRootId = ID_NONE
    int   subtype        = int(na)
    int   originKey      = ID_NONE
    int   originTime     = int(na)
    int   confirmedTime  = int(na)
    float pointPrice     = na
    if ok
        rootSlot       := array.get(engine.w03Store.journalTargetRootSlots, journalRow)
        expectedRootId := array.get(engine.w03Store.journalExpectedRootIds, journalRow)
        subtype        := array.get(engine.w03Store.journalSubtypes,        journalRow)
        originKey      := array.get(engine.w03Store.journalOriginKeys,      journalRow)
        originTime     := array.get(engine.w03Store.journalOriginTimes,     journalRow)
        confirmedTime  := array.get(engine.w03Store.journalConfirmedTimes,  journalRow)
        pointPrice     := array.get(engine.w03Store.journalPointPrices,     journalRow)
        int slopeDir = array.get(engine.w03Store.journalSlopeDirs, journalRow)
        ok := array.get(engine.w03Store.journalOps, journalRow) == JOP_MA_UPDATE and array.get(engine.w03Store.journalGroups, journalRow) == JGROUP_E3 and rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and not na(mintick) and mintick > 0 and engine.w03Store.journalBaseSeq != SEQ_UNSET
        // Step 2 : the MA row contract
        if ok
            ok := array.get(engine.w03Store.journalCategories, journalRow) == CAT_MA and (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and array.get(engine.w03Store.journalTfCodes, journalRow) == TF_1M and originKey != ID_NONE and not na(originTime) and not na(confirmedTime) and not na(pointPrice) and na(array.get(engine.w03Store.journalNativeBottoms, journalRow)) and na(array.get(engine.w03Store.journalNativeTops, journalRow)) and array.get(engine.w03Store.journalOldStates, journalRow) == ROOT_ACTIVE and array.get(engine.w03Store.journalNewStates, journalRow) == ROOT_ACTIVE and array.get(engine.w03Store.journalPairKeys, journalRow) == ID_NONE and array.get(engine.w03Store.journalDirections, journalRow) == FVG_NONE and not array.get(engine.w03Store.journalFvgFreshFlags, journalRow) and not array.get(engine.w03Store.journalIsBroadFlags, journalRow) and array.get(engine.w03Store.journalOldMasks, journalRow) == 0 and array.get(engine.w03Store.journalNewMasks, journalRow) == 0 and (na(slopeDir) or slopeDir == -1 or slopeDir == 0 or slopeDir == 1)
    // Step 3 : the target Root is the live, owned MA Root the row names
    if ok
        ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootOriginTimes) and rootSlot < array.size(engine.rootConfirmedTimes) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootLastUpdateSeqs) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        ok := array.get(engine.rootCategories, rootSlot) == CAT_MA and array.get(engine.rootSubtypes, rootSlot) == subtype and array.get(engine.rootTfCodes, rootSlot) == TF_1M and array.get(engine.rootOriginKeys, rootSlot) == originKey and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and not array.get(engine.rootIsRangeRootFlags, rootSlot) and array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == FVG_NONE and not array.get(engine.rootFvgFreshFlags, rootSlot) and not array.get(engine.rootIsBroadFvgFlags, rootSlot) and array.get(engine.rootLabelMasks, rootSlot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, rootSlot) == SWING_TF_MASK_NONE and na(array.get(engine.rootNativeBottoms, rootSlot)) and na(array.get(engine.rootNativeTops, rootSlot))
    // Step 4 : general set membership and its own price-order position
    if ok
        ok := rootSetMembershipValidRaw(engine, rootSlot)
    if ok
        int pricePos = array.get(engine.rootPriceOrderPositions, rootSlot)
        ok := pricePos >= 0 and pricePos < array.size(engine.rootPriceOrderSlots)
        if ok
            ok := array.get(engine.rootPriceOrderSlots, pricePos) == rootSlot
    // Step 5 : commit. Times first, then the price through the existing move helper.
    if ok
        array.set(engine.rootOriginTimes,    rootSlot, originTime)
        array.set(engine.rootConfirmedTimes, rootSlot, confirmedTime)
        array.set(engine.rootLastUpdateSeqs, rootSlot, engine.w03Store.journalBaseSeq)
        bool moved = rootPriceOrderMoveRaw(engine, rootSlot, expectedRootId, pointPrice, mintick)
    ok

// ============================================================
// W03 Batch 16 : SWING_TF_MERGE, TIMEHL_LABEL and ROOT_RETIRE apply helpers
// Source: I8 (Stage F / E3 / E4), I10, A7.3, A7.6, D12
//
// Internal only. Each applies one journal row to the existing point Root it names,
// after validating the row and the target Root, and writes only:
//   swingTfMergeApplyRaw : rootSwingTfMasks (exactly one new TF bit). The merged
//                          Root keeps its creation TF, times and price.
//   timeHlLabelApplyRaw  : rootLabelMasks (0 is legal; ROOT_RETIRE follows in E4).
//                          Why the labels changed is the emitter's decision.
//   rootRetireApplyRaw   : a TimeHL Root with labelMask 0, ACTIVE -> RETIRED, the
//                          state set through rootStateSetMoveRaw, then rootStates.
// A retired Root is not freed: its origin bucket, Category / TF sets, common price
// order and lifecycle entries stay. No price, time, lastUpdateSeq, origin,
// revision or journal field is written. Business call sites = 0.
// ============================================================

// Adds one detection TF bit to a Swing Root. true when applied; false with zero
// mutation when the row or the target Root does not meet the merge contract.
swingTfMergeApplyRaw(ZoneEngine engine, int journalRow) =>
    // Step 1 : an E3 SWING_TF_MERGE row
    bool ok = journalRow >= 0 and journalRow < engine.w03Store.journalCount and journalRow < array.size(engine.w03Store.journalOps) and journalRow < array.size(engine.w03Store.journalGroups) and journalRow < array.size(engine.w03Store.journalTargetRootSlots) and journalRow < array.size(engine.w03Store.journalExpectedRootIds) and journalRow < array.size(engine.w03Store.journalCategories) and journalRow < array.size(engine.w03Store.journalSubtypes) and journalRow < array.size(engine.w03Store.journalTfCodes) and journalRow < array.size(engine.w03Store.journalOriginKeys) and journalRow < array.size(engine.w03Store.journalOriginTimes) and journalRow < array.size(engine.w03Store.journalOriginEndTimes) and journalRow < array.size(engine.w03Store.journalConfirmedTimes) and journalRow < array.size(engine.w03Store.journalPointPrices) and journalRow < array.size(engine.w03Store.journalNativeBottoms) and journalRow < array.size(engine.w03Store.journalNativeTops) and journalRow < array.size(engine.w03Store.journalOldStates) and journalRow < array.size(engine.w03Store.journalNewStates) and journalRow < array.size(engine.w03Store.journalFvgFreshFlags) and journalRow < array.size(engine.w03Store.journalIsBroadFlags) and journalRow < array.size(engine.w03Store.journalDirections) and journalRow < array.size(engine.w03Store.journalOldMasks) and journalRow < array.size(engine.w03Store.journalNewMasks) and journalRow < array.size(engine.w03Store.journalPairKeys) and journalRow < array.size(engine.w03Store.journalSlopeDirs)
    int rootSlot       = SLOT_INVALID
    int expectedRootId = ID_NONE
    int subtype        = int(na)
    int originKey      = ID_NONE
    int oldMask        = int(na)
    int newMask        = int(na)
    if ok
        rootSlot       := array.get(engine.w03Store.journalTargetRootSlots, journalRow)
        expectedRootId := array.get(engine.w03Store.journalExpectedRootIds, journalRow)
        subtype        := array.get(engine.w03Store.journalSubtypes,        journalRow)
        originKey      := array.get(engine.w03Store.journalOriginKeys,      journalRow)
        oldMask        := array.get(engine.w03Store.journalOldMasks,        journalRow)
        newMask        := array.get(engine.w03Store.journalNewMasks,        journalRow)
        ok := array.get(engine.w03Store.journalOps, journalRow) == JOP_SWING_TF_MERGE and array.get(engine.w03Store.journalGroups, journalRow) == JGROUP_E3 and rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and engine.w03Store.journalBaseSeq != SEQ_UNSET and array.get(engine.w03Store.journalOldStates, journalRow) == ROOT_ACTIVE and array.get(engine.w03Store.journalNewStates, journalRow) == ROOT_ACTIVE and array.get(engine.w03Store.journalPairKeys, journalRow) == ID_NONE and array.get(engine.w03Store.journalDirections, journalRow) == FVG_NONE and not array.get(engine.w03Store.journalFvgFreshFlags, journalRow) and not array.get(engine.w03Store.journalIsBroadFlags, journalRow)
    // Step 2 : the Swing row contract and exactly one new incoming TF bit
    if ok
        int tfCode = array.get(engine.w03Store.journalTfCodes, journalRow)
        ok := array.get(engine.w03Store.journalCategories, journalRow) == CAT_SWING and (subtype == SUB_SWING_HIGH or subtype == SUB_SWING_LOW) and (tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H)
        if ok
            if tfCode == TF_5M
                ok := (oldMask == 2 or oldMask == 4 or oldMask == 6) and newMask == oldMask + SWING_TF_MASK_5M
            else if tfCode == TF_15M
                ok := (oldMask == 1 or oldMask == 4 or oldMask == 5) and newMask == oldMask + SWING_TF_MASK_15M
            else
                ok := (oldMask == 1 or oldMask == 2 or oldMask == 3) and newMask == oldMask + SWING_TF_MASK_1H
    // Step 3 : the target Swing Root (its creation TF is not required to match)
    if ok
        ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.rootStateSetPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootSubtypes, rootSlot) == subtype and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and not array.get(engine.rootIsRangeRootFlags, rootSlot) and not array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == FVG_NONE and not array.get(engine.rootFvgFreshFlags, rootSlot) and not array.get(engine.rootIsBroadFvgFlags, rootSlot) and not na(array.get(engine.rootPointPrices, rootSlot)) and na(array.get(engine.rootNativeBottoms, rootSlot)) and na(array.get(engine.rootNativeTops, rootSlot))
    if ok
        ok := rootSetMembershipValidRaw(engine, rootSlot)
    if ok
        int pricePos = array.get(engine.rootPriceOrderPositions, rootSlot)
        ok := pricePos >= 0 and pricePos < array.size(engine.rootPriceOrderSlots)
        if ok
            ok := array.get(engine.rootPriceOrderSlots, pricePos) == rootSlot
    if ok
        int rootTf = array.get(engine.rootTfCodes, rootSlot)
        ok := array.get(engine.rootCategories, rootSlot) == CAT_SWING and (rootTf == TF_5M or rootTf == TF_15M or rootTf == TF_1H) and array.get(engine.rootLabelMasks, rootSlot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, rootSlot) == oldMask
    // Step 4 : commit, exactly one write
    if ok
        array.set(engine.w03Store.rootSwingTfMasks, rootSlot, newMask)
    ok

// Replaces one TimeHL Root's period label mask. true when applied; false with zero
// mutation when the row or the target Root does not meet the label contract.
timeHlLabelApplyRaw(ZoneEngine engine, int journalRow) =>
    // Step 1 : an E3 TIMEHL_LABEL row

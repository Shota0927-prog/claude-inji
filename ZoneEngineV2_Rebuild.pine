// ============================================================
// W03 Batch 17 : FVG_FRESH_END and FVG_INVALIDATE apply helpers
// Source: I8 (Stage F / E1 / E3), I11-6, I14, A7.5, D12
//
// Internal only. Each applies one journal row to the existing FVG Root it names,
// after validating the row, the Root and every index it must hold (general sets,
// FVG non-price sets, both NativeRange orders, absence from the common order):
//   fvgFreshEndApplyRaw   : Fresh true -> false. The Fresh set entry goes first,
//                           then rootFvgFreshFlags. ACTIVE and INVALIDATED Roots
//                           both qualify: E1 invalidation runs before E3 Fresh end.
//   fvgInvalidateApplyRaw : ACTIVE -> INVALIDATED. The structurally-active set
//                           entry, then the state set, then rootStates. Fresh,
//                           Direction, Broad and NativeRange are kept; W03 never
//                           reaches an Inverse state.
// The later Stage F preflight (F0) proves every step succeeds before the first
// write, so there is no rollback or repair here. No origin, price, lastUpdateSeq,
// revision or journal field is written. Business call sites = 0.
// ============================================================

// Ends one FVG Root's Fresh state. true when applied; false with zero mutation
// when the row, the Root or its indexes do not meet the Fresh-end contract.
fvgFreshEndApplyRaw(ZoneEngine engine, int journalRow) =>
    // Step 1 : an E3 FVG_FRESH_END row
    bool ok = journalRow >= 0 and journalRow < engine.w03Store.journalCount and journalRow < array.size(engine.w03Store.journalOps) and journalRow < array.size(engine.w03Store.journalGroups) and journalRow < array.size(engine.w03Store.journalTargetRootSlots) and journalRow < array.size(engine.w03Store.journalExpectedRootIds) and journalRow < array.size(engine.w03Store.journalCategories) and journalRow < array.size(engine.w03Store.journalSubtypes) and journalRow < array.size(engine.w03Store.journalTfCodes) and journalRow < array.size(engine.w03Store.journalOriginKeys) and journalRow < array.size(engine.w03Store.journalOriginTimes) and journalRow < array.size(engine.w03Store.journalOriginEndTimes) and journalRow < array.size(engine.w03Store.journalConfirmedTimes) and journalRow < array.size(engine.w03Store.journalPointPrices) and journalRow < array.size(engine.w03Store.journalNativeBottoms) and journalRow < array.size(engine.w03Store.journalNativeTops) and journalRow < array.size(engine.w03Store.journalOldStates) and journalRow < array.size(engine.w03Store.journalNewStates) and journalRow < array.size(engine.w03Store.journalFvgFreshFlags) and journalRow < array.size(engine.w03Store.journalIsBroadFlags) and journalRow < array.size(engine.w03Store.journalDirections) and journalRow < array.size(engine.w03Store.journalOldMasks) and journalRow < array.size(engine.w03Store.journalNewMasks) and journalRow < array.size(engine.w03Store.journalPairKeys) and journalRow < array.size(engine.w03Store.journalSlopeDirs)
    int  rootSlot       = SLOT_INVALID
    int  expectedRootId = ID_NONE
    int  tfCode         = int(na)
    int  originKey      = ID_NONE
    int  direction      = int(na)
    int  subtype        = int(na)
    int  oldState       = int(na)
    int  newState       = int(na)
    bool fvgFresh       = false
    bool isBroad        = false
    if ok
        rootSlot       := array.get(engine.w03Store.journalTargetRootSlots, journalRow)
        expectedRootId := array.get(engine.w03Store.journalExpectedRootIds, journalRow)
        tfCode         := array.get(engine.w03Store.journalTfCodes,         journalRow)
        originKey      := array.get(engine.w03Store.journalOriginKeys,      journalRow)
        direction      := array.get(engine.w03Store.journalDirections,      journalRow)
        subtype        := array.get(engine.w03Store.journalSubtypes,        journalRow)
        oldState       := array.get(engine.w03Store.journalOldStates,       journalRow)
        newState       := array.get(engine.w03Store.journalNewStates,       journalRow)
        fvgFresh       := array.get(engine.w03Store.journalFvgFreshFlags,   journalRow)
        isBroad        := array.get(engine.w03Store.journalIsBroadFlags,    journalRow)
        // the op, the target and the common FVG journal identity
        ok := array.get(engine.w03Store.journalOps, journalRow) == JOP_FVG_FRESH_END and array.get(engine.w03Store.journalGroups, journalRow) == JGROUP_E3 and rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and engine.w03Store.journalBaseSeq != SEQ_UNSET and array.get(engine.w03Store.journalCategories, journalRow) == CAT_FVG and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and originKey != ID_NONE and array.get(engine.w03Store.journalPairKeys, journalRow) == ID_NONE and (direction == FVG_BULLISH or direction == FVG_BEARISH) and array.get(engine.w03Store.journalOldMasks, journalRow) == 0 and array.get(engine.w03Store.journalNewMasks, journalRow) == 0
    // Step 2 : the state is kept (ACTIVE or INVALIDATED); the journal Fresh result is false
    if ok
        ok := (oldState == ROOT_ACTIVE or oldState == ROOT_INVALIDATED) and newState == oldState and not fvgFresh
    // Step 3
    // the target FVG Root: ownership, logical identity and every index it must hold
    if ok
        ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootLastUpdateSeqs) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions) and rootSlot < array.size(engine.rootFvgNativeBottomOrderPositions) and rootSlot < array.size(engine.rootFvgNativeTopOrderPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
    if ok

    array.set(engine.rootNativeBottomTicks, rootSlot, bottomTick)
    array.set(engine.rootNativeTopTicks,    rootSlot, topTick)
rootPriceOrderMoveRaw(ZoneEngine engine, int rootSlot, int expectedRootId, float newPointPrice, float mintick) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int   orderSize       = array.size(engine.rootPriceOrderSlots)
    int   oldPos          = SLOT_INVALID
    int   oldTick         = int(na)
    int   newPointTick    = int(na)
    float oldNativeBottom = na
    float oldNativeTop    = na
    if ok
        ok := not na(mintick) and mintick > 0 and not na(newPointPrice)
    if ok
        newPointTick := int(math.round(newPointPrice / mintick))
        ok := not na(newPointTick)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and not array.get(engine.rootIsRangeRootFlags, rootSlot)
    if ok
        oldTick := array.get(engine.rootPointTicks, rootSlot)
        oldPos  := array.get(engine.rootPriceOrderPositions, rootSlot)
        ok      := not na(oldTick) and oldPos != SLOT_INVALID and oldPos >= 0 and oldPos < orderSize
    if ok
        ok := array.get(engine.rootPriceOrderSlots, oldPos) == rootSlot
    if ok
        oldNativeBottom := array.get(engine.rootNativeBottoms, rootSlot)
        oldNativeTop    := array.get(engine.rootNativeTops,    rootSlot)
    int targetPos = oldPos
    if ok
        bool scanning = true
        int  i        = newPointTick >= oldTick ? oldPos + 1 : oldPos - 1
        while ok and scanning and i >= 0 and i < orderSize
            int slot = array.get(engine.rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == i
            if ok
                int neighborTick = array.get(engine.rootPointTicks, slot)
                if newPointTick >= oldTick
                    if neighborTick <= newPointTick
                        targetPos := i
                        i += 1
                    else
                        scanning := false
                else
                    if neighborTick > newPointTick
                        targetPos := i
                        i -= 1
                    else
                        scanning := false
    if ok
        if targetPos > oldPos
            int i = oldPos
            while i < targetPos
                int movedSlot = array.get(engine.rootPriceOrderSlots, i + 1)
                array.set(engine.rootPriceOrderSlots, i, movedSlot)
                array.set(engine.rootPriceOrderPositions, movedSlot, i)
                i += 1
        else if targetPos < oldPos
            int i = oldPos
            while i > targetPos
                int movedSlot = array.get(engine.rootPriceOrderSlots, i - 1)
                array.set(engine.rootPriceOrderSlots, i, movedSlot)
                array.set(engine.rootPriceOrderPositions, movedSlot, i)
                i -= 1
        rootWritePricesAndTicksRaw(engine, rootSlot, newPointPrice, oldNativeBottom, oldNativeTop, mintick)
        if targetPos != oldPos
            array.set(engine.rootPriceOrderSlots, targetPos, rootSlot)
            array.set(engine.rootPriceOrderPositions, rootSlot, targetPos)
    ok

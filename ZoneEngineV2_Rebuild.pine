// One ContactSpan per confirmed base bar on which the bar range actually
// intersected the TouchStartSnapshot range. The real contact prices and times
// are kept (spec 12.3), so a Merge or a Split decides membership from the real
// contacts and never from a min..max envelope of the whole Episode.
export type ContactSpan
    int   baseSeq = 0
    int   time    = na
    float bottom  = na
    float top     = na

// One record per touch Episode. A normal touch keeps its own consumption facts
// (deepest close, max depth, WeakByDepth) so Merge and Split rebuild the side
// history from the Episodes that really belong to the new range instead of
// copying an aggregated parent value.
export type TouchEpisode
    int   episodeId     = 0
    int   side          = 0
    int   startSeq      = 0
    int   startTime     = na
    int   generationId  = 0
    int   touchNo       = 0
    float snapBottom    = na
    float snapTop       = na
    float closeAtTouch  = na
    float deepestClose  = na
    float maxDepthPct   = 0.0
    bool  weakByDepth   = false
    bool  isNormalTouch = true
    array<ContactSpan> spans = na


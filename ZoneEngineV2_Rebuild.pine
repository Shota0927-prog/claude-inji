// ZoneEngineV2_Rebuild.pine
// ZoneEngine v2 Production Library
// D01: library name / file name fixed. Visual / Conformance / StrategyBenchmark are separate files.
// I3-1: this file holds Zone logic, state, numeric Events and numeric Views only.
//       No request.*(), no box/line/label/table, no historical debug strings.

//@version=6
library("ZoneEngineV2_Rebuild", overlay = false)

// ============================================================
// W01 Batch 1 : fixed int constants / enums / masks
// Source: D02, D03, D04, A5
// ============================================================

// ---- D02 ID / slot / sentinel ------------------------------
// rootId / coreId / generationId : 1-based, 0 = none, never reused.
const int ID_NONE         = 0
// slot : >= 0, invalid = -1, only free slots are reused.
const int SLOT_INVALID    = -1
// baseSeq : >= 0, unprocessed = -1.
const int SEQ_UNSET       = -1

// ---- D03 Category ------------------------------------------
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int CAT_COUNT       = 6

// Category mask = 1 << categoryCode (D03).
// Pine has no bitwise operators, so the identical power-of-two values are fixed as constants.
const int CAT_MASK_MA      = 1
const int CAT_MASK_SWING   = 2
const int CAT_MASK_ACCUM   = 4
const int CAT_MASK_TIME_HL = 8
const int CAT_MASK_FVG     = 16
const int CAT_MASK_PSYCH   = 32
const int CAT_MASK_NONE    = 0
const int CAT_MASK_ALL     = 63

// ---- D03 Side ----------------------------------------------
const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SIDE_NONE       = 0

// ---- D03 Phase ---------------------------------------------
const int PH_WAITING      = 0
const int PH_ARMED        = 1
const int PH_ACTIVE_TOUCH = 2
const int PH_BROKEN       = 3
const int PH_FLIP_WAIT    = 4
const int PH_DORMANT      = 5

// ---- D03 Grade ---------------------------------------------
const int GR_STRONG       = 0
const int GR_NEUTRAL      = 1
const int GR_WEAK         = 2
const int GR_UNAVAILABLE  = 3

// ---- D03 Density -------------------------------------------
const int DEN_HIGH          = 0
const int DEN_NORMAL        = 1
const int DEN_BROAD_CONTEXT = 2

// ---- D03 Root state ----------------------------------------
const int ROOT_CANDIDATE      = 0
const int ROOT_ACTIVE         = 1
const int ROOT_INVALIDATED    = 2
const int ROOT_INVERSE_WAIT   = 3
const int ROOT_INVERSE_ACTIVE = 4
const int ROOT_RETIRED        = 5

// ---- D03 FVG direction -------------------------------------
const int FVG_NONE     = 0
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
// Aggregated direction mask is OR of the above; both present = 3.
const int FVG_MASK_NONE     = 0
const int FVG_MASK_BULLISH  = 1
const int FVG_MASK_BEARISH  = 2
const int FVG_MASK_BOTH     = 3

// ---- D03 Weak reason ---------------------------------------
const int WEAK_NONE     = 0
const int WEAK_BY_TOUCH = 1
const int WEAK_BY_DEPTH = 2
const int WEAK_BY_BOTH  = 3

// ---- D03 / A5 Event type -----------------------------------
// 0 is reserved as internal none. 1..15 follow the spec order.
const int EV_NONE           = 0
const int EV_TOUCH_START    = 1
const int EV_TOUCH_RESET    = 2
const int EV_WEAK_DEPTH     = 3
const int EV_LOCAL_BREAK    = 4
const int EV_GAP_BREAK      = 5
const int EV_FLIP_ATTEMPT   = 6
const int EV_FLIP_CONFIRM   = 7
const int EV_RECLAIM        = 8
const int EV_FVG_INVALIDATE = 9
const int EV_INVERSE_ATTEMPT = 10
const int EV_INVERSE_CONFIRM = 11
const int EV_GENERATION_START = 12
const int EV_MERGE          = 13
const int EV_SPLIT          = 14
const int EV_STORAGE_PRUNE  = 15

// ---- D04 fixed timeframe codes -----------------------------
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_D   = 1440

// ---- D04 fixed EMA lengths ---------------------------------
// Fixed constants. Never ZoneCfg fields. Only the slope lookback is configurable.
const int EMA_LEN_FAST = 2000
const int EMA_LEN_SLOW = 3000

// ---- D06 config error codes --------------------------------
// Smaller code wins when several violations hold.
const int ERR_OK                       = 0
const int ERR_CHART_TF_NOT_5M          = 1
const int ERR_MINTICK_INVALID          = 2
const int ERR_FIXED_TF_METADATA        = 3
const int ERR_STRONG_UNLIMITED_CONFLICT = 4
const int ERR_TOUCH_THRESHOLD_ORDER    = 5
// Stage A feed validation only (D06 / D07). Never a persistent Cfg validation failure
// and never bound to the Cfg fingerprint.
const int ERR_FEED_METADATA_MISMATCH   = 6

// ============================================================
// W01 Batch 1 : ZoneCfg
// Source: D05, A4.1, A4.2, A4.3, A4.4, A6.1, logical spec 18
// ============================================================

export type ZoneCfg
    // ---- A4.1 logical parameters (logical spec 18) ----
    float clusterMaxWidth      = 20.0
    float denseRatio           = 0.50
    float touchResetDistance   = 10.0
    int   strongUntilTouch     = 1
    bool  strongUnlimited      = false
    int   weakFromTouch        = 2
    bool  weakFromTouchOff     = false
    float weakDepthPct         = 50.0
    bool  weakDepthOff         = false
    float breakBuffer          = 2.0
    float touchTolerance       = 0.0
    int   emaSlopeLookback     = 60
    int   swingLen5m           = 10
    int   swingLen15m          = 8
    int   swingLen1h           = 6

    // ---- A4.2 Accum ----
    int   accumRangeLen        = 10
    int   accumBaseLen         = 20
    int   accumAtrLen          = 14
    int   accumMinUpperCloses  = 4
    int   accumMinLowerCloses  = 4
    int   accumMaxSameColorRun = 4
    float accumAtrMult         = 2.5
    float accumBarRatioMax     = 0.70
    float accumDriftMax        = 0.30

    // ---- A4.3 session / day / week ----
    string zoneTimezone        = "Asia/Tokyo"
    int   asiaStartHour        = 9
    int   asiaEndHour          = 14
    int   europeStartHour      = 14
    int   europeEndHour        = 19
    int   nyStartHour          = 19
    int   nyEndHour            = 3
    int   dayBoundaryHour      = 5
    int   weekBoundaryDow      = 2
    int   weekBoundaryHour     = 5

    // ---- A4.4 storage / display limits ----
    int   maxSwingRoots        = 180
    int   maxAccumBoxes        = 60
    int   maxFvgRoots          = 120
    int   maxTimeRoots         = 32
    int   maxZoneCores         = 80
    int   maxEndedGenerations  = 30
    int   maxTouchMarksPerCore = 64
    float dormantDistance      = 500.0
    int   maxZonesDrawn        = 30
    int   maxLabelsDrawn       = 30

    // ---- D05 / A6.1 category ON / OFF ----
    bool  useMa                = true
    bool  useSwing             = true
    bool  useAccum             = true
    bool  useTimeHl            = true
    bool  useFvg               = true
    bool  usePsych             = true

    // ---- D04 / A6.1 fixed timeframe metadata ----
    // Values must stay equal to TF_1M / TF_5M / TF_15M / TF_1H / TF_1H / TF_4H / TF_D.
    int   tfMa                 = 1
    int   tfBase               = 5
    int   tfSwing15            = 15
    int   tfSwing1h            = 60
    int   tfHtf1h              = 60
    int   tfHtf4h              = 240
    int   tfHtfD               = 1440

    // ---- D05 host metadata ----
    // newCfg() leaves sentinels. Harness / Main assigns real chart values before newEngine().
    int   chartTfMinutes       = 0
    float mintick              = na

// Factory (A4 / A6.1). Spec initial values only, no auto-correction of any value.
export newCfg() =>
    ZoneCfg.new()

// ============================================================
// W01 Batch 2 : read-only projection UDTs
// Source: A6.2 (Root), A6.10 (ZoneView), I5 / A6.5 / A6.6 (ZoneEvent), D09, I19.1
//
// These three UDTs are external read-only projections only.
// The internal Root / Core / Side registries stay Structure of Arrays (I6.1, D12);
// they are never rebuilt as arrays of these objects.
//
// Default / sentinel rule (D02, D03):
//   id-like field (rootId / coreId / generationId / originKey / pairKey) : ID_NONE = 0
//   baseSeq / lastUpdateSeq                                             : SEQ_UNSET = -1
//   time                                                                : na
//   price                                                               : na
//   side                                                                : SIDE_NONE
//   event type                                                          : EV_NONE
//   enum with a spec-defined none / initial value                       : that value
//   enum with no spec-defined none value (category / subtype / tfCode / density) : na
//   mask / count                                                        : 0
//   bool                                                                : false (state not yet established)
// ============================================================

// ---- A6.2 Root : read-only projection of one registry entry ----
// originKey and pairKey are ints, never strings: no origin / debug string enters the
// Production hot path (I6.5, D09). originKey is a stability key for diagnostics and
// indexing only; origin identity is decided by the full tuple comparison held in the
// Engine, never by an originKey hash match alone (I4).
export type Root
    int   rootId         = ID_NONE
    int   originKey      = ID_NONE
    int   category
    int   subtype
    int   tfCode
    int   originTime     = na
    int   originEndTime  = na
    int   confirmedTime  = na
    float pointPrice     = na
    float nativeBottom   = na
    float nativeTop      = na
    bool  isRangeRoot    = false
    bool  isDynamic      = false
    int   state          = ROOT_CANDIDATE
    int   pairKey        = ID_NONE
    int   direction      = FVG_NONE
    bool  fvgFresh       = false
    bool  isBroadFvg     = false
    int   labelMask      = 0
    int   lastUpdateSeq  = SEQ_UNSET

// ---- A6.10 ZoneView : per-Side read-only projection ----
// Numeric / bool only. No string field (D09, I19.1): the spec's Root / Category
// diagnostic display is rebuilt by the Visual Harness on the final bar from
// rootCountInView / categoryMask / highMask plus the name APIs.
export type ZoneView
    int   coreId                 = ID_NONE
    int   generationId           = ID_NONE
    int   side                   = SIDE_NONE
    float effectiveBottom        = na
    float effectiveTop           = na
    float referencePrice         = na
    int   phase                  = PH_WAITING
    int   grade                  = GR_UNAVAILABLE
    int   cCount                 = 0
    int   hCount                 = 0
    int   density
    bool  baseStrong             = false
    int   currentTouchNo         = 0
    int   upcomingTouchNo        = 0
    bool  zoneFresh              = false
    bool  sideFresh              = false
    int   weakReason             = WEAK_NONE
    float maxDepthPct            = 0.0
    bool  isBroadContext         = false
    int   fvgDirectionMask       = FVG_MASK_NONE
    int   fvgRootCount           = 0
    int   fvgFreshCount          = 0
    int   fvgStructuralStateMask = 0
    bool  eligible               = false
    // numeric Root / Category diagnostics (replaces the spec's diagnostic strings)
    int   rootCountInView        = 0
    int   categoryMask           = CAT_MASK_NONE
    int   highMask               = CAT_MASK_NONE

// ---- I5 ZoneEvent : read-only numeric projection of one current-bar Event ----
// No info / description / debug string field. Values needed to reference a fixed
// Snapshot (A6.5, A6.6) are carried as numeric fields.
export type ZoneEvent
    int   eventType    = EV_NONE
    int   time         = na
    int   baseSeq      = SEQ_UNSET
    int   coreId       = ID_NONE
    int   generationId = ID_NONE
    int   side         = SIDE_NONE
    float rangeBottom  = na
    float rangeTop     = na
    int   touchNo      = 0
    int   gradeAtStart = GR_UNAVAILABLE
    int   weakReason   = WEAK_NONE
    int   rootId       = ID_NONE

                            ok := pricePos >= 0 and pricePos < array.size(engine.rootPriceOrderSlots)
                            if ok
                                ok := array.get(engine.rootPriceOrderSlots, pricePos) == rootSlot
                        if ok
                            targetCategory  := array.get(engine.rootCategories, rootSlot)
                            targetTf        := array.get(engine.rootTfCodes,    rootSlot)
                            targetOriginKey := array.get(engine.rootOriginKeys, rootSlot)
                    else if ok
                        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, row)
                        ok := newCount == 1
                        if ok
                            // the Root identity comes from that NEW_ROOT row, which passed F0 above:
                            // a point Root (not FVG), not dynamic (not MA), no pair / direction /
                            // Fresh / Broad; its attaches give the general set membership (ACTIVE
                            // set) and the price-order membership, kept by every later move
                            int newCategory = array.get(engine.w03Store.journalCategories, newRow)
                            ok := newCategory != CAT_FVG and newCategory != CAT_MA and array.get(engine.w03Store.journalSubtypes, newRow) == subtype and virtualRootStateBeforeRaw(engine, rootSlot, expectedRootId, row) == ROOT_ACTIVE and array.get(engine.w03Store.journalPairKeys, newRow) == ID_NONE and array.get(engine.w03Store.journalDirections, newRow) == FVG_NONE and not array.get(engine.w03Store.journalFvgFreshFlags, newRow) and not array.get(engine.w03Store.journalIsBroadFlags, newRow) and not na(array.get(engine.w03Store.journalPointPrices, newRow)) and na(array.get(engine.w03Store.journalNativeBottoms, newRow)) and na(array.get(engine.w03Store.journalNativeTops, newRow))
                            if ok
                                targetCategory  := newCategory
                                targetTf        := array.get(engine.w03Store.journalTfCodes,    newRow)
                                targetOriginKey := array.get(engine.w03Store.journalOriginKeys, newRow)
                    // the op's own Root contract, on the virtual masks
                    if ok
                        if op == JOP_SWING_TF_MERGE
                            ok := targetCategory == CAT_SWING and (targetTf == TF_5M or targetTf == TF_15M or targetTf == TF_1H) and virtualTimeHlLabelMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == 0 and virtualSwingTfMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == oldMask
                        else if op == JOP_TIMEHL_LABEL
                            ok := targetCategory == CAT_TIME_HL and targetTf == TF_5M and virtualTimeHlLabelMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == oldMask and virtualSwingTfMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == SWING_TF_MASK_NONE and (originKey == ID_NONE or targetOriginKey == originKey)
                        else
                            // ROOT_RETIRE : no label left; the ACTIVE entry is proven by the
                            // membership above (or the pending NEW attach) and the moved last
                            // entry by Step 6
                            ok := targetCategory == CAT_TIME_HL and targetTf == TF_5M and virtualTimeHlLabelMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == 0 and virtualSwingTfMaskBeforeRaw(engine, rootSlot, expectedRootId, row) == SWING_TF_MASK_NONE
                else
                    // FVG_INVALIDATE (E1) or FVG_FRESH_END (E3): the common FVG row identity
                    ok := category == CAT_FVG and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D) and originKey != ID_NONE and pairKey == ID_NONE and (direction == FVG_BULLISH or direction == FVG_BEARISH) and oldMask == 0 and newMask == 0
                    if ok
                        if op == JOP_FVG_INVALIDATE
                            ok := oldState == ROOT_ACTIVE and newState == ROOT_INVALIDATED
                        else
                            ok := (oldState == ROOT_ACTIVE or oldState == ROOT_INVALIDATED) and newState == oldState and not fvgFresh
                    bool pathB = op == JOP_FVG_FRESH_END and rootSlot == SLOT_INVALID and expectedRootId == ID_NONE
                    if ok and pathB
                        // Path B : exactly one NEW_ROOT FVG row of this bar is the target
                        [matchRow, matchCount] = pendingNewFvgRowRaw(engine, row)
                        ok := matchCount == 1
                        if ok
                            // the new Root is ACTIVE and Fresh with the NEW row's identity
                            ok := array.get(engine.w03Store.journalOriginKeys, matchRow) == originKey and array.get(engine.w03Store.journalSubtypes, matchRow) == subtype and array.get(engine.w03Store.journalIsBroadFlags, matchRow) == isBroad and oldState == ROOT_ACTIVE
                        if ok
                            // its Fresh ends once: no earlier Path B row on the same identity
                            int j = 0
                            while ok and j < count
                                if j != row and array.get(engine.w03Store.journalOps, j) == JOP_FVG_FRESH_END and journalAppliedBeforeRaw(engine, j, row) and array.get(engine.w03Store.journalTargetRootSlots, j) == SLOT_INVALID and array.get(engine.w03Store.journalExpectedRootIds, j) == ID_NONE and array.get(engine.w03Store.journalTfCodes, j) == tfCode and array.get(engine.w03Store.journalDirections, j) == direction and array.get(engine.w03Store.journalOriginTimes, j) == originTime
                                    ok := false
                                j += 1
                    else if ok
                        // an existing FVG Root named by (rootSlot, expectedRootId)
                        ok := rootSlot != SLOT_INVALID and expectedRootId != ID_NONE
                        bool committedTarget = false
                        if ok
                            committedTarget := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags)
                            if committedTarget
                                committedTarget := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
                        if ok and committedTarget
                            // a committed FVG Root: ownership, identity and every index it holds
                            if ok
                                ok := rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootSubtypes) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootLabelMasks) and rootSlot < array.size(engine.rootLastUpdateSeqs) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootIsDynamicFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootPriceOrderPositions) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions) and rootSlot < array.size(engine.rootFvgNativeBottomOrderPositions) and rootSlot < array.size(engine.rootFvgNativeTopOrderPositions) and rootSlot < array.size(engine.w03Store.rootSwingTfMasks)
                            if ok
                                ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId
                            if ok
                                int bottomTick = array.get(engine.rootNativeBottomTicks, rootSlot)
                                int topTick    = array.get(engine.rootNativeTopTicks,    rootSlot)
                                ok := array.get(engine.rootCategories, rootSlot) == CAT_FVG and array.get(engine.rootTfCodes, rootSlot) == tfCode and array.get(engine.rootOriginKeys, rootSlot) == originKey and array.get(engine.rootSubtypes, rootSlot) == subtype and array.get(engine.rootPairKeys, rootSlot) == ID_NONE and array.get(engine.rootDirections, rootSlot) == direction and array.get(engine.rootIsRangeRootFlags, rootSlot) and not array.get(engine.rootIsDynamicFlags, rootSlot) and array.get(engine.rootLabelMasks, rootSlot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, rootSlot) == SWING_TF_MASK_NONE and na(array.get(engine.rootPointPrices, rootSlot)) and not na(array.get(engine.rootNativeBottoms, rootSlot)) and not na(array.get(engine.rootNativeTops, rootSlot)) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick and array.get(engine.rootPriceOrderPositions, rootSlot) == SLOT_INVALID
                            if ok
                                int bottomPos = array.get(engine.rootFvgNativeBottomOrderPositions, rootSlot)
                                int topPos    = array.get(engine.rootFvgNativeTopOrderPositions,    rootSlot)
                                ok := bottomPos >= 0 and topPos >= 0 and bottomPos < array.size(engine.fvgNativeBottomOrderRootSlots) and topPos < array.size(engine.fvgNativeTopOrderRootSlots)
                                if ok
                                    ok := array.get(engine.fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(engine.fvgNativeTopOrderRootSlots, topPos) == rootSlot
                            // the committed memberships; every earlier move keeps them exact
                            if ok
                                ok := rootSetMembershipValidRaw(engine, rootSlot)
                            if ok
                                ok := fvgSetMembershipValidRaw(engine, rootSlot, expectedRootId)
                            // Step 4 : the virtual state / Fresh this row sees; Broad never changes
                            if ok
                                int virtualState = virtualRootStateBeforeRaw(engine, rootSlot, expectedRootId, row)
                                [virtualFresh, freshResolved] = virtualFvgFreshBeforeRaw(engine, rootSlot, expectedRootId, row)
                                if op == JOP_FVG_INVALIDATE
                                    ok := freshResolved and virtualState == ROOT_ACTIVE and virtualFresh == fvgFresh and array.get(engine.rootIsBroadFvgFlags, rootSlot) == isBroad
                                else
                                    ok := freshResolved and virtualState == oldState and virtualFresh and array.get(engine.rootIsBroadFvgFlags, rootSlot) == isBroad
                        else
                            // not a committed Root: an FVG created this bar is reached only by
                            // canonical Path B above, never by a predicted address
                            ok := false
            row += 1
        group += 1
    // Step 8 : any failure stops the bar before F1 writes anything
    if not ok
        runtime.error("W03_JOURNAL_PREFLIGHT")
    ok

// ============================================================
// W03 Batch 18B : Stage F executor F0 -> F5 (journal apply and revision commit)
// Source: I8 (Stage F / F0 - F5), I9, I11-1 .. I11-6, D12
//
// Internal only. w03StageFApplyThroughF5Raw runs, in this exact order:
//   F0 w03StageFPreflightRaw - nothing is written before it succeeds
//   F1 E1 rows (FVG_INVALIDATE)                          -> fvgInvalidateApplyRaw
//   F2 E2 rows (NEW_ROOT)                                -> newRootApplyRaw
//   F3 E3 rows (MA_UPDATE / SWING_TF_MERGE / TIMEHL_LABEL / FVG_FRESH_END)
//   F4 E4 rows (ROOT_RETIRE)                             -> rootRetireApplyRaw
//   F5 each dirty revision of the eight W03 revisions + 1, at most once per bar
// Inside a group the rows are applied in append order; the journal is never
// sorted. The only journal write is the canonical Path B handoff: right before F3
// applies a FVG_FRESH_END row carrying SLOT_INVALID / ID_NONE, the target and Root
// ID that newRootApplyRaw wrote back into its one matching NEW_ROOT FVG row are
// copied into it. F6 (lastConsumed, MA / TimeHL refs, Accum mirror, TimeHL tracker,
// nextAccumPairKey) and the journal lifetime belong to B18C: nothing of them is
// written here and the journal is left as it is. F0 proved every apply, so a false
// return is an invariant breach: runtime.error("W03_JOURNAL_PREFLIGHT"), no
// rollback, no recovery. Business call sites = 0 in this Batch.
// ============================================================

// Runs Stage F F0 -> F5 on this bar's journal. Returns true.
w03StageFApplyThroughF5Raw(ZoneEngine engine, float mintick) =>
    // F0 : whole-journal preflight (raises W03_JOURNAL_PREFLIGHT on any failure)
    bool ok = w03StageFPreflightRaw(engine, mintick)
    // the eight W03 revision dirty flags of this bar (local only)
    bool dirtyRootRegistry          = false
    bool dirtyRootPrice             = false
    bool dirtyEligibilitySupport    = false
    bool dirtyEligibilityResistance = false
    bool dirtyRootQuality           = false
    bool dirtyFvgState              = false
    bool dirtyFvgFresh              = false
    bool dirtyPriceOrder            = false
    // the slope sign each MA Root had before the current row: the persistent value,
    // then the slopeDir of every MA_UPDATE row of that EMA already applied this bar
    int  virtualSlope2000 = engine.w03Store.ema2000SlopeDir
    int  virtualSlope3000 = engine.w03Store.ema3000SlopeDir
    int  count = engine.w03Store.journalCount
    // F1 - F4 : group E1 -> E4, append order inside each group
    int group = JGROUP_E1
    while ok and group <= JGROUP_E4
        int row = 0
        while ok and row < count
            if array.get(engine.w03Store.journalGroups, row) == group
                int op        = array.get(engine.w03Store.journalOps,        row)
                int category  = array.get(engine.w03Store.journalCategories, row)
                int direction = array.get(engine.w03Store.journalDirections, row)
                if op == JOP_FVG_INVALIDATE
                    // F1
                    ok := fvgInvalidateApplyRaw(engine, row)
                    if ok
                        dirtyFvgState := true
                        if direction == FVG_BULLISH
                            dirtyEligibilitySupport := true
                        else
                            dirtyEligibilityResistance := true
                else if op == JOP_NEW_ROOT
                    // F2 : alloc + identity write-back + attaches, all inside the helper
                    ok := newRootApplyRaw(engine, row, mintick) != SLOT_INVALID
                    if ok
                        dirtyRootRegistry := true
                        dirtyPriceOrder   := true
                        if category == CAT_FVG
                            if direction == FVG_BULLISH
                                dirtyEligibilitySupport := true
                            else
                                dirtyEligibilityResistance := true
                        else
                            dirtyEligibilitySupport    := true
                            dirtyEligibilityResistance := true
                else if op == JOP_MA_UPDATE
                    // F3 : what the move changes, captured before the apply
                    int rootSlot  = array.get(engine.w03Store.journalTargetRootSlots, row)
                    int oldTick   = array.get(engine.rootPointTicks,          rootSlot)
                    int oldPos    = array.get(engine.rootPriceOrderPositions, rootSlot)
                    int subtype   = array.get(engine.w03Store.journalSubtypes,  row)
                    int newSlope  = array.get(engine.w03Store.journalSlopeDirs, row)
                    int prevSlope = subtype == SUB_MA_EMA2000 ? virtualSlope2000 : virtualSlope3000
                    ok := maUpdateApplyRaw(engine, row, mintick)
                    if ok
                        int newTick = array.get(engine.rootPointTicks,          rootSlot)
                        int newPos  = array.get(engine.rootPriceOrderPositions, rootSlot)
                        if newTick != oldTick
                            dirtyRootPrice := true
                        if newPos != oldPos
                            dirtyPriceOrder := true
                        // na is its own value: na -> sign and sign -> na are changes
                        bool slopeChanged = na(prevSlope) != na(newSlope) or (not na(prevSlope) and not na(newSlope) and prevSlope != newSlope)
                        if slopeChanged
                            dirtyRootQuality := true
                        if subtype == SUB_MA_EMA2000
                            virtualSlope2000 := newSlope
                        else
                            virtualSlope3000 := newSlope
                else if op == JOP_SWING_TF_MERGE
                    // F3
                    ok := swingTfMergeApplyRaw(engine, row)
                    if ok
                        dirtyRootQuality := true
                else if op == JOP_TIMEHL_LABEL
                    // F3
                    ok := timeHlLabelApplyRaw(engine, row)
                    if ok
                        dirtyRootQuality := true
                else if op == JOP_FVG_FRESH_END
                    // F3 : canonical Path B - physical identity handoff from the NEW_ROOT FVG
                    // row newRootApplyRaw already wrote back in F2, right before the apply
                    if array.get(engine.w03Store.journalTargetRootSlots, row) == SLOT_INVALID and array.get(engine.w03Store.journalExpectedRootIds, row) == ID_NONE
                        [newRow, matchCount] = pendingNewFvgRowRaw(engine, row)
                        ok := matchCount == 1 and newRow >= 0 and newRow < count
                        if ok
                            int actualSlot = array.get(engine.w03Store.journalTargetRootSlots, newRow)
                            int actualId   = array.get(engine.w03Store.journalExpectedRootIds, newRow)
                            ok := actualSlot != SLOT_INVALID and actualId != ID_NONE
                            if ok
                                array.set(engine.w03Store.journalTargetRootSlots, row, actualSlot)
                                array.set(engine.w03Store.journalExpectedRootIds, row, actualId)
                    if ok
                        ok := fvgFreshEndApplyRaw(engine, row)
                    if ok
                        dirtyFvgFresh := true
                else if op == JOP_ROOT_RETIRE
                    // F4
                    ok := rootRetireApplyRaw(engine, row)
                    if ok
                        dirtyRootRegistry          := true
                        dirtyEligibilitySupport    := true
                        dirtyEligibilityResistance := true
                else
                    ok := false
            row += 1
        group += 1
    // an apply F0 proved cannot fail did: an invariant breach, never repaired
    if not ok
        runtime.error("W03_JOURNAL_PREFLIGHT")
    // F5 : each dirty revision exactly once per bar
    if dirtyRootRegistry
        engine.rootRegistryRevision := engine.rootRegistryRevision + 1
    if dirtyRootPrice
        engine.rootPriceRevision := engine.rootPriceRevision + 1
    if dirtyEligibilitySupport
        engine.rootEligibilityRevisionSupport := engine.rootEligibilityRevisionSupport + 1
    if dirtyEligibilityResistance
        engine.rootEligibilityRevisionResistance := engine.rootEligibilityRevisionResistance + 1
    if dirtyRootQuality
        engine.rootQualityRevision := engine.rootQualityRevision + 1
    if dirtyFvgState
        engine.fvgStateRevision := engine.fvgStateRevision + 1
    if dirtyFvgFresh
        engine.fvgFreshRevision := engine.fvgFreshRevision + 1
    if dirtyPriceOrder
        engine.priceOrderRevision := engine.priceOrderRevision + 1
    ok

// ============================================================
// W03 Batch 18C : Stage F final executor F0 -> F6 (persistent scalar commit)
// Source: I8 (Stage F / F6), I10, A7.2, A7.4, A7.6, D12
//
// Internal only. w03StageFApplyAndCommitRaw runs w03StageFApplyThroughF5Raw
// exactly once (F0 - F5), then F6 commits the 58 persistent scalars of
// W03SourceRootStore:
//   derived from the applied journal (31) : MA Root refs 4 + slope 2, TimeHL refs 24,
//                                           nextAccumPairKey 1
//   explicit arguments (27)               : lastConsumed 11, Accum Candidate mirror
//                                           12, TimeHL tracker 4 - the E-stage
//                                           locals B26 passes in, assigned as is
// The 31 derived values are all settled in locals first, from the current persistent
// values plus the journal read in Stage F order (E2 NEW_ROOT carries the identity
// newRootApplyRaw wrote back; E3 MA_UPDATE / TIMEHL_LABEL carry their targets), and
// only then are the 58 fields assigned. A TimeHL label turned off clears its ref only
// while the ref still names that Root, so a same-bar hand-over never loses the new
// holder. ROOT_RETIRE never touches a ref (its labels were cleared by TIMEHL_LABEL).
// nextAccumPairKey becomes max(current, largest Accum pairKey of this bar + 1).
// F6 writes no Root, index, revision or journal field, reads no Feed and makes no
// business decision; the journal is left as it is (its reset is B26).
// Business call sites = 0 in this Batch.
// ============================================================

// Runs Stage F F0 -> F6 once on this bar's journal and the 27 E-stage payload
// values. Returns true.
w03StageFApplyAndCommitRaw(ZoneEngine engine, float mintick, int nextLastConsumed15mSwingCloseTime, int nextLastConsumed1hSwingCloseTime, int nextLastConsumed1hAccumCloseTime, int nextLastConsumed1hFvgFormationCloseTime, int nextLastConsumed1hFvgStructuralCloseTime, int nextLastConsumed4hAccumCloseTime, int nextLastConsumed4hFvgFormationCloseTime, int nextLastConsumed4hFvgStructuralCloseTime, int nextLastConsumedDAccumCloseTime, int nextLastConsumedDFvgFormationCloseTime, int nextLastConsumedDFvgStructuralCloseTime, bool nextAccum1hCandidateActive, int nextAccum1hCandidateStartTime, float nextAccum1hCandidateTop, float nextAccum1hCandidateBottom, bool nextAccum4hCandidateActive, int nextAccum4hCandidateStartTime, float nextAccum4hCandidateTop, float nextAccum4hCandidateBottom, bool nextAccumDCandidateActive, int nextAccumDCandidateStartTime, float nextAccumDCandidateTop, float nextAccumDCandidateBottom, int nextTimeHlSessionKind, int nextTimeHlSessionStartTime, int nextTimeHlDayStartTime, int nextTimeHlWeekStartTime) =>
    // F0 : read-only journal preflight (F0 worker); a failure stops the bar with
    // runtime.error("W03_JOURNAL_PREFLIGHT") before any write
    bool preflightOk = W03F0.preflight(engine.rootIds, engine.rootOriginKeys, engine.rootCategories, engine.rootSubtypes, engine.rootTfCodes, engine.rootOriginTimes, engine.rootConfirmedTimes, engine.rootPointPrices, engine.rootNativeBottoms, engine.rootNativeTops, engine.rootIsRangeRootFlags, engine.rootIsDynamicFlags, engine.rootStates, engine.rootPairKeys, engine.rootDirections, engine.rootFvgFreshFlags, engine.rootIsBroadFvgFlags, engine.rootLabelMasks, engine.rootLastUpdateSeqs, engine.rootPointTicks, engine.rootNativeBottomTicks, engine.rootNativeTopTicks, engine.rootSlotLiveFlags, engine.rootFreeSlots, engine.rootPriceOrderSlots, engine.rootPriceOrderPositions, engine.categoryMaRootSlots, engine.categorySwingRootSlots, engine.categoryAccumRootSlots, engine.categoryTimeHlRootSlots, engine.categoryFvgRootSlots, engine.categoryPsychRootSlots, engine.tf1mRootSlots, engine.tf5mRootSlots, engine.tf15mRootSlots, engine.tf1hRootSlots, engine.tf4hRootSlots, engine.tfDRootSlots, engine.stateCandidateRootSlots, engine.stateActiveRootSlots, engine.stateInvalidatedRootSlots, engine.stateInverseWaitRootSlots, engine.stateInverseActiveRootSlots, engine.stateRetiredRootSlots, engine.rootCategorySetPositions, engine.rootTfSetPositions, engine.rootStateSetPositions, engine.accumPairUpperRootSlotByKey, engine.accumPairLowerRootSlotByKey, engine.freshFvg1hRootSlots, engine.freshFvg4hRootSlots, engine.freshFvgDRootSlots, engine.structurallyActiveFvg1hRootSlots, engine.structurallyActiveFvg4hRootSlots, engine.structurallyActiveFvgDRootSlots, engine.bullishFvgRootSlots, engine.bearishFvgRootSlots, engine.broadFvgRootSlots, engine.rootFvgFreshSetPositions, engine.rootFvgStructuralStateSetPositions, engine.rootFvgDirectionSetPositions, engine.rootFvgBroadSetPositions, engine.fvgNativeBottomOrderRootSlots, engine.fvgNativeTopOrderRootSlots, engine.rootFvgNativeBottomOrderPositions, engine.rootFvgNativeTopOrderPositions, engine.w03Store.journalOps, engine.w03Store.journalGroups, engine.w03Store.journalTargetRootSlots, engine.w03Store.journalExpectedRootIds, engine.w03Store.journalCategories, engine.w03Store.journalSubtypes, engine.w03Store.journalTfCodes, engine.w03Store.journalOriginKeys, engine.w03Store.journalOriginTimes, engine.w03Store.journalOriginEndTimes, engine.w03Store.journalConfirmedTimes, engine.w03Store.journalPointPrices, engine.w03Store.journalNativeBottoms, engine.w03Store.journalNativeTops, engine.w03Store.journalOldStates, engine.w03Store.journalNewStates, engine.w03Store.journalFvgFreshFlags, engine.w03Store.journalIsBroadFlags, engine.w03Store.journalDirections, engine.w03Store.journalOldMasks, engine.w03Store.journalNewMasks, engine.w03Store.journalPairKeys, engine.w03Store.journalSlopeDirs, engine.w03Store.rootSwingTfMasks, engine.w02Aux.originKeyBucketHeadRootSlots, engine.w02Aux.rootOriginBucketExpectedRootIds, engine.w03Store.journalCount, engine.w03Store.journalBaseSeq, engine.w03Store.journalInvariantViolation, engine.nextRootId, mintick)
    // F1 - F4 : apply E1 -> E4 (Apply worker, same collections by reference); then
    // the Root ID counter and the F5 revisions (each at most once) here, before F6
    bool ok = false
    if preflightOk
        [applyOk, nextRootIdOut, dirtyRootRegistry, dirtyRootPrice, dirtyEligibilitySupport, dirtyEligibilityResistance, dirtyRootQuality, dirtyFvgState, dirtyFvgFresh, dirtyPriceOrder] = W03Apply.applyThroughF4(engine.rootIds, engine.rootOriginKeys, engine.rootCategories, engine.rootSubtypes, engine.rootTfCodes, engine.rootOriginTimes, engine.rootOriginEndTimes, engine.rootConfirmedTimes, engine.rootPointPrices, engine.rootNativeBottoms, engine.rootNativeTops, engine.rootIsRangeRootFlags, engine.rootIsDynamicFlags, engine.rootStates, engine.rootPairKeys, engine.rootDirections, engine.rootFvgFreshFlags, engine.rootIsBroadFvgFlags, engine.rootLabelMasks, engine.rootLastUpdateSeqs, engine.rootPointTicks, engine.rootNativeBottomTicks, engine.rootNativeTopTicks, engine.rootSlotLiveFlags, engine.rootFreeSlots, engine.rootLiveSlots, engine.rootIdOrderSlots, engine.rootIdToSlot, engine.rootPriceOrderSlots, engine.rootPriceOrderPositions, engine.categoryMaRootSlots, engine.categorySwingRootSlots, engine.categoryAccumRootSlots, engine.categoryTimeHlRootSlots, engine.categoryFvgRootSlots, engine.categoryPsychRootSlots, engine.tf1mRootSlots, engine.tf5mRootSlots, engine.tf15mRootSlots, engine.tf1hRootSlots, engine.tf4hRootSlots, engine.tfDRootSlots, engine.stateCandidateRootSlots, engine.stateActiveRootSlots, engine.stateInvalidatedRootSlots, engine.stateInverseWaitRootSlots, engine.stateInverseActiveRootSlots, engine.stateRetiredRootSlots, engine.rootCategorySetPositions, engine.rootTfSetPositions, engine.rootStateSetPositions, engine.accumPairUpperRootSlotByKey, engine.accumPairLowerRootSlotByKey, engine.freshFvg1hRootSlots, engine.freshFvg4hRootSlots, engine.freshFvgDRootSlots, engine.structurallyActiveFvg1hRootSlots, engine.structurallyActiveFvg4hRootSlots, engine.structurallyActiveFvgDRootSlots, engine.bullishFvgRootSlots, engine.bearishFvgRootSlots, engine.broadFvgRootSlots, engine.rootFvgFreshSetPositions, engine.rootFvgStructuralStateSetPositions, engine.rootFvgDirecti
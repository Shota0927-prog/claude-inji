var int SWM_15M = 2
var int SWM_1H  = 4

var int MS_DAY = 86400000

// Psychological prices carry a stable logical ID derived from the normalised
// price level itself (spec 7.7). The base is far above any sequential Root ID
// so the two spaces can never collide, and the same price always returns the
// same ID without a lookup table that could be cleared.
var int PSYCH_ID_BASE = 1000000000

// Diagnostic threshold only. Nothing is discarded when it is exceeded.
var int SCRATCH_MAX_ROOTS = 512

// -----------------------------------------------------------------------------
// 2. Name conversion (presentation only) and code accessors for the harness
// -----------------------------------------------------------------------------
export categoryName(int c) =>
    switch c
        0 => "MA"
        1 => "Swing"
        2 => "Accum"
        3 => "TimeHL"
        4 => "FVG"
        5 => "Psych"
        => "?"

export sideName(int s) =>
    s == 1 ? "Support" : s == -1 ? "Resistance" : "None"

export phaseName(int p) =>
    switch p
        0 => "Waiting"
        1 => "Armed"
        2 => "ActiveTouch"
        3 => "Broken"
        4 => "FlipWait"
        5 => "Dormant"
        => "?"

export gradeName(int g) =>
    switch g
        0 => "Strong"
        1 => "Neutral"
        2 => "Weak"
        3 => "Unavailable"
        => "?"

export densityName(int d) =>
    switch d
        0 => "High"
        1 => "Normal"
        2 => "BroadContext"
        => "?"

export weakReasonName(int w) =>
    switch w
        0 => "None"
        1 => "WeakByTouch"
        2 => "WeakByDepth"
        3 => "WeakByBoth"
        => "?"

export rootStateName(int s) =>
    switch s
        1 => "Active"
        2 => "Invalidated"
        3 => "InverseWait"
        4 => "InverseActive"
        5 => "Retired"
        => "?"

export fvgDirName(int d) =>
    d == 1 ? "Bullish" : d == 2 ? "Bearish" : "None"

export eventName(int e) =>
    switch e
        0  => "TouchStart"
        1  => "TouchReset"
        2  => "WeakDepth"
        3  => "LocalBreak"
        4  => "GapBreak"
        5  => "FlipAttempt"
        6  => "FlipConfirm"
        7  => "Reclaim"
        8  => "FvgInvalidate"
        9  => "InverseAttempt"
        10 => "InverseConfirm"
        11 => "GenerationStart"
        12 => "Merge"
        13 => "Split"
        14 => "StoragePrune"
        => "?"

export tfName(int tf) =>
    switch tf
        1    => "1m"
        5    => "5m"
        15   => "15m"
        60   => "1H"
        240  => "4H"
        1440 => "1D"
        => str.tostring(tf) + "m"

// Bit mask of FVG root states, decoded for display.
export fvgStateText(int mask) =>
    string s = ""
    s += (mask & 2) != 0 ? "Active " : ""
    s += (mask & 8) != 0 ? "InverseWait " : ""
    s += (mask & 16) != 0 ? "InverseActive " : ""
    s == "" ? "-" : s

export fvgDirText(int mask) =>
    string s = ""
    s += (mask & 2) != 0 ? "Bullish " : ""
    s += (mask & 4) != 0 ? "Bearish " : ""
    s == "" ? "-" : s

export codeSideSupport()    => 1
export codeSideResistance() => -1
export codeGradeStrong()    => 0
export codeGradeNeutral()   => 1
export codeGradeWeak()      => 2
export codeGradeUnavail()   => 3
export codePhaseWaiting()   => 0
export codePhaseArmed()     => 1
export codePhaseActive()    => 2
export codePhaseBroken()    => 3
export codePhaseFlipWait()  => 4
export codePhaseDormant()   => 5
export codeDensityHigh()    => 0
export codeDensityNormal()  => 1
export codeDensityBroad()   => 2


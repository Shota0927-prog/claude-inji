candTieBreakDirtyRaw(ZoneEngine engine) =>
    bool dirty = false
    int  count = engine.w03Store.journalCount
    int  row   = 0
    while row < count and not dirty
        bool rowOk = row < array.size(engine.w03Store.journalOps) and row < array.size(engine.w03Store.journalTargetRootSlots) and row < array.size(engine.w03Store.journalExpectedRootIds) and row < array.size(engine.w03Store.journalConfirmedTimes)
        if rowOk
            if array.get(engine.w03Store.journalOps, row) == JOP_MA_UPDATE
                int rootSlot       = array.get(engine.w03Store.journalTargetRootSlots, row)
                int expectedRootId = array.get(engine.w03Store.journalExpectedRootIds, row)
                int newConfirmed   = array.get(engine.w03Store.journalConfirmedTimes, row)
                bool targetOk = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootConfirmedTimes) and rootSlot < array.size(engine.rootSlotLiveFlags)
                if targetOk
                    targetOk := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
                if targetOk
                    int  oldConfirmed = array.get(engine.rootConfirmedTimes, rootSlot)
                    bool oldNa = na(oldConfirmed)
                    bool newNa = na(newConfirmed)
                    if oldNa != newNa
                        dirty := true
                    else if not oldNa
                        dirty := oldConfirmed != newConfirmed
        row += 1
    dirty
// W05 B17: Side Candidate revision +1 only when its inputs were dirty and it was recomputed; returns side validity
candRevisionCommitRaw(ZoneEngine engine, int side, bool inputDirty, bool recomputed) =>
    bool validSide = side == SIDE_SUPPORT or side == SIDE_RESISTANCE
    if validSide and inputDirty and recomputed
        if side == SIDE_SUPPORT
            engine.candidateRevisionSupport := engine.candidateRevisionSupport + 1
        else
            engine.candidateRevisionResistance := engine.candidateRevisionResistance + 1
    validSide
// W05 B19: Side cache hit only when valid and all 7 revision snapshots equal the current revisions; read-only
candCacheHitRaw(ZoneEngine engine, int side) =>
    bool hit = false
    if side == SIDE_SUPPORT
        hit := engine.w02Aux.candidateCacheSupportValid and engine.w02Aux.candidateCacheSupportEligibilityRevision == engine.rootEligibilityRevisionSupport and engine.w02Aux.candidateCacheSupportRootPriceRevision == engine.rootPriceRevision and engine.w02Aux.candidateCacheSupportRootQualityRevision == engine.rootQualityRevision and engine.w02Aux.candidateCacheSupportPriceOrderRevision == engine.priceOrderRevision and engine.w02Aux.candidateCacheSupportFvgStateRevision == engine.fvgStateRevision and engine.w02Aux.candidateCacheSupportCfgRevision == engine.cfgRevision and engine.w02Aux.candidateCacheSupportTieBreakRevision == engine.candidateTieBreakRevision
    else if side == SIDE_RESISTANCE
        hit := engine.w02Aux.candidateCacheResistanceValid and engine.w02Aux.candidateCacheResistanceEligibilityRevision == engine.rootEligibilityRevisionResistance and engine.w02Aux.candidateCacheResistanceRootPriceRevision == engine.rootPriceRevision and engine.w02Aux.candidateCacheResistanceRootQualityRevision == engine.rootQualityRevision and engine.w02Aux.candidateCacheResistancePriceOrderRevision == engine.priceOrderRevision and engine.w02Aux.candidateCacheResistanceFvgStateRevision == engine.fvgStateRevision and engine.w02Aux.candidateCacheResistanceCfgRevision == engine.cfgRevision and engine.w02Aux.candidateCacheResistanceTieBreakRevision == engine.candidateTieBreakRevision
    hit
// W05 B20: save the Side cache key (7 current revisions, then valid = true); returns side validity
candCacheSaveRaw(ZoneEngine engine, int side) =>
    bool validSide = side == SIDE_SUPPORT or side == SIDE_RESISTANCE
    if side == SIDE_SUPPORT
        engine.w02Aux.candidateCacheSupportEligibilityRevision := engine.rootEligibilityRevisionSupport
        engine.w02Aux.candidateCacheSupportRootPriceRevision := engine.rootPriceRevision
        engine.w02Aux.candidateCacheSupportRootQualityRevision := engine.rootQualityRevision
        engine.w02Aux.candidateCacheSupportPriceOrderRevision := engine.priceOrderRevision
        engine.w02Aux.candidateCacheSupportFvgStateRevision := engine.fvgStateRevision
        engine.w02Aux.candidateCacheSupportCfgRevision := engine.cfgRevision
        engine.w02Aux.candidateCacheSupportTieBreakRevision := engine.candidateTieBreakRevision
        engine.w02Aux.candidateCacheSupportValid := true
    else if side == SIDE_RESISTANCE
        engine.w02Aux.candidateCacheResistanceEligibilityRevision := engine.rootEligibilityRevisionResistance
        engine.w02Aux.candidateCacheResistanceRootPriceRevision := engine.rootPriceRevision
        engine.w02Aux.candidateCacheResistanceRootQualityRevision := engine.rootQualityRevision
        engine.w02Aux.candidateCacheResistancePriceOrderRevision := engine.priceOrderRevision
        engine.w02Aux.candidateCacheResistanceFvgStateRevision := engine.fvgStateRevision
        engine.w02Aux.candidateCacheResistanceCfgRevision := engine.cfgRevision
        engine.w02Aux.candidateCacheResistanceTieBreakRevision := engine.candidateTieBreakRevision
        engine.w02Aux.candidateCacheResistanceValid := true
    validSide

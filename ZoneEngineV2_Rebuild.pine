rootWritePricesAndTicksRaw(ZoneEngine engine, int rootSlot, float pointPrice, float nativeBottom, float nativeTop, float mintick) =>
    array.set(engine.rootPointPrices,   rootSlot, pointPrice)
    array.set(engine.rootNativeBottoms, rootSlot, nativeBottom)
    array.set(engine.rootNativeTops,    rootSlot, nativeTop)
    int pointTick  = na(pointPrice)   ? int(na) : int(math.round(pointPrice   / mintick))
    int bottomTick = na(nativeBottom) ? int(na) : int(math.round(nativeBottom / mintick))
    int topTick    = na(nativeTop)    ? int(na) : int(math.round(nativeTop    / mintick))

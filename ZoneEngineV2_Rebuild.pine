virtualPointOrderPreflightRaw(ZoneEngine engine, int row, float mintick) =>
    int  count     = engine.w03Store.journalCount
    int  op        = array.get(engine.w03Store.journalOps, row)
    int  orderSize = array.size(engine.rootPriceOrderSlots)
    bool ok        = not na(mintick) and mintick > 0 and ((op == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, row) != CAT_FVG) or op == JOP_MA_UPDATE) and not na(array.get(engine.w03Store.journalPointPrices, row))
    int  newTick   = int(na)
    if ok
        newTick := int(math.round(array.get(engine.w03Store.journalPointPrices, row) / mintick))
        ok      := not na(newTick)
    int virtualSize = orderSize
    if ok
        int j = 0
        while j < count
            if j != row and array.get(engine.w03Store.journalOps, j) == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, j) != CAT_FVG and journalAppliedBeforeRaw(engine, j, row)
                virtualSize += 1
            j += 1
    int newUpperC = SLOT_INVALID
    if ok
        [ubPos, ubOk] = rootPriceOrderUpperBoundRaw(engine, newTick)
        ok        := ubOk
        newUpperC := ubPos
    int  rootSlot       = SLOT_INVALID
    int  expectedRootId = ID_NONE
    bool eCommitted     = false
    int  eCpos          = SLOT_INVALID
    int  eNewRow        = SLOT_INVALID
    int  oldTick        = int(na)
    int  oldPlace       = SLOT_INVALID
    int  eCommittedTick = int(na)
    if ok and op == JOP_MA_UPDATE
        rootSlot       := array.get(engine.w03Store.journalTargetRootSlots, row)
        expectedRootId := array.get(engine.w03Store.journalExpectedRootIds, row)
        if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
            if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
                eCommitted := true
                eCpos      := array.get(engine.rootPriceOrderPositions, rootSlot)
                ok := eCpos >= 0 and eCpos < orderSize and not array.get(engine.rootIsRangeRootFlags, rootSlot)
                if ok
                    ok := array.get(engine.rootPriceOrderSlots, eCpos) == rootSlot
        if ok and not eCommitted
            [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, row)
            ok := newCount == 1
            if ok
                eNewRow := newRow
                ok := array.get(engine.w03Store.journalCategories, newRow) == CAT_MA
    if ok and op == JOP_MA_UPDATE
        if eCommitted
            eCommittedTick := array.get(engine.rootPointTicks, rootSlot)

    float htfDClose                 = na

// Factory (D07). Sentinel / na only: no confirmed Base bar, logical event count 0.
export newFeed() =>
    Feed.new()

// ============================================================
// W01 Batch 5 : Cfg validation, Cfg fingerprint, Feed metadata validation
// Source: I5, D05, D06, D07, D10, A4.1, A6.1
//
// validateCfg() is the only exported item here. Codes 0..5 only: code 6 belongs to
// the Stage A Feed check and is never a persistent Cfg failure (D06, D07).
// Fingerprint helpers are internal and never used for Root / Core / Candidate
// identity (D10), and never stored as strings (D09).
// ============================================================

// ---- fingerprint constants (physical detail, logical result unaffected) ----
const int    FP_MOD           = 2147483647
const int    FP_SEED_A        = 16777619
const int    FP_MULT_A        = 1000003
const int    FP_SEED_B        = 987654323
const int    FP_MULT_B        = 31
const int    FP_NA_KEY        = -1
const float  FP_FLOAT_SCALE   = 100000000.0
const int    FP_CHAR_FALLBACK = 127
const string FP_ALPHABET      = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz/_+-:. "

// ---- internal fingerprint helpers ----
fpMixInt(int acc, int mult, int value) =>
    int t  = value % FP_MOD
    int tp = t < 0 ? t + FP_MOD : t
    (acc * mult + tp) % FP_MOD

fpIntKey(int v) =>
    na(v) ? FP_NA_KEY : v

fpBoolKey(bool v) =>
    v ? 1 : 0

fpFloatKey(float v) =>
    na(v) ? FP_NA_KEY : int(math.round(v * FP_FLOAT_SCALE))

fpStrCode(string s, int i) =>
    int pos = str.pos(FP_ALPHABET, str.substring(s, i, i + 1))
    na(pos) ? FP_CHAR_FALLBACK : pos + 1

fpMixString(int acc, int mult, string s) =>
    int a = fpMixInt(acc, mult, na(s) ? FP_NA_KEY : str.length(s))
    if not na(s) and str.length(s) > 0
        for i = 0 to str.length(s) - 1
            a := fpMixInt(a, mult, fpStrCode(s, i))
    a

// Folds every ZoneCfg field in a fixed order. Called twice with different
// seed / multiplier pairs to produce two independent int fingerprints (D10).
cfgFingerprint(ZoneCfg cfg, int seed, int mult) =>
    int h = seed
    // A4.1 logical parameters
    h := fpMixInt(h, mult, fpFloatKey(cfg.clusterMaxWidth))
    h := fpMixInt(h, mult, fpFloatKey(cfg.denseRatio))
    h := fpMixInt(h, mult, fpFloatKey(cfg.touchResetDistance))
    h := fpMixInt(h, mult, fpIntKey(cfg.strongUntilTouch))
    h := fpMixInt(h, mult, fpBoolKey(cfg.strongUnlimited))
    h := fpMixInt(h, mult, fpIntKey(cfg.weakFromTouch))
    h := fpMixInt(h, mult, fpBoolKey(cfg.weakFromTouchOff))
    h := fpMixInt(h, mult, fpFloatKey(cfg.weakDepthPct))
    h := fpMixInt(h, mult, fpBoolKey(cfg.weakDepthOff))
    h := fpMixInt(h, mult, fpFloatKey(cfg.breakBuffer))
    h := fpMixInt(h, mult, fpFloatKey(cfg.touchTolerance))
    h := fpMixInt(h, mult, fpIntKey(cfg.emaSlopeLookback))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen5m))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen15m))
    h := fpMixInt(h, mult, fpIntKey(cfg.swingLen1h))
    // A4.2 Accum
    h := fpMixInt(h, mult, fpIntKey(cfg.accumRangeLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumBaseLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumAtrLen))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMinUpperCloses))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMinLowerCloses))
    h := fpMixInt(h, mult, fpIntKey(cfg.accumMaxSameColorRun))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumAtrMult))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumBarRatioMax))
    h := fpMixInt(h, mult, fpFloatKey(cfg.accumDriftMax))
    // A4.3 session / day / week
    h := fpMixString(h, mult, cfg.zoneTimezone)
    h := fpMixInt(h, mult, fpIntKey(cfg.asiaStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.asiaEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.europeStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.europeEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.nyStartHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.nyEndHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.dayBoundaryHour))
    h := fpMixInt(h, mult, fpIntKey(cfg.weekBoundaryDow))
    h := fpMixInt(h, mult, fpIntKey(cfg.weekBoundaryHour))
    // A4.4 storage / display limits
    h := fpMixInt(h, mult, fpIntKey(cfg.maxSwingRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxAccumBoxes))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxFvgRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxTimeRoots))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxZoneCores))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxEndedGenerations))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxTouchMarksPerCore))
    h := fpMixInt(h, mult, fpFloatKey(cfg.dormantDistance))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxZonesDrawn))
    h := fpMixInt(h, mult, fpIntKey(cfg.maxLabelsDrawn))
    // D05 category ON / OFF
    h := fpMixInt(h, mult, fpBoolKey(cfg.useMa))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useSwing))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useAccum))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useTimeHl))
    h := fpMixInt(h, mult, fpBoolKey(cfg.useFvg))
    h := fpMixInt(h, mult, fpBoolKey(cfg.usePsych))
    // D04 fixed timeframe metadata
    h := fpMixInt(h, mult, fpIntKey(cfg.tfMa))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfBase))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfSwing15))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfSwing1h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtf1h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtf4h))
    h := fpMixInt(h, mult, fpIntKey(cfg.tfHtfD))
    // D05 host metadata
    h := fpMixInt(h, mult, fpIntKey(cfg.chartTfMinutes))
    h := fpMixInt(h, mult, fpFloatKey(cfg.mintick))
    h

// ---- D06 Cfg validation. Smallest violating code wins, no auto-correction ----
export validateCfg(ZoneCfg cfg) =>
    int code = 0
    if cfg.chartTfMinutes != 5
        code := ERR_CHART_TF_NOT_5M
    else if na(cfg.mintick) or cfg.mintick <= 0
        code := ERR_MINTICK_INVALID
    else if cfg.tfMa != 1 or cfg.tfBase != 5 or cfg.tfSwing15 != 15 or cfg.tfSwing1h != 60 or cfg.tfHtf1h != 60 or cfg.tfHtf4h != 240 or cfg.tfHtfD != 1440
        code := ERR_FIXED_TF_METADATA
    else if cfg.strongUnlimited and not cfg.weakFromTouchOff
        code := ERR_STRONG_UNLIMITED_CONFLICT
    else if not cfg.strongUnlimited and not cfg.weakFromTouchOff and cfg.strongUntilTouch >= cfg.weakFromTouch
        code := ERR_TOUCH_THRESHOLD_ORDER
    code

// ---- D07 Feed metadata validation. Internal, Stage A only. Returns 0 or 6 ----
// No epsilon and no tick rounding: this is metadata identity, not a price comparison.
validateFeedMetadata(ZoneCfg cfg, Feed feed) =>
    bool mismatch = na(feed.mintick) or feed.mintick != cfg.mintick or feed.chartTfMinutes != cfg.chartTfMinutes or feed.tfMa != cfg.tfMa or feed.tfBase != cfg.tfBase or feed.tfSwing15 != cfg.tfSwing15 or feed.tfSwing1h != cfg.tfSwing1h or feed.tfHtf1h != cfg.tfHtf1h or feed.tfHtf4h != cfg.tfHtf4h or feed.tfHtfD != cfg.tfHtfD
    mismatch ? ERR_FEED_METADATA_MISMATCH : ERR_OK


// ============================================================
// W01 Batch 4 : ZoneEngine container + empty SoA skeleton
// Source: A6.9, I6.1, I6.4, D02, D10, D11, D12, A4.4
//
// Engine body is a UDT holding field-wise parallel arrays.
// Root registry  : Structure of Arrays, index = rootSlot.
// Core registry  : Structure of Arrays, index = coreSlot.
// Side state     : flattened parallel arrays, sideSlot = coreSlot * 2 + sideIndex
//                  (sideIndex 0 = Support view, 1 = Resistance view).
// Current-bar Events : Structure of Arrays, logical length in eventLogicalCount.
// These registries are never rebuilt as array<Root> / array<ZoneView> / array<ZoneEvent>
// or any other per-object UDT registry (I6.1, D12).
// Batch 4 provides the empty container only: no registry, Candidate, Core, Touch,
// Break, prune or validation processing.
// ============================================================

// ============================================================
// W02 Batch 36R : W02AuxStore - Engine-owned auxiliary storage container
// Source: I11-13, I17.3, I6.1, D12
//
// One singleton storage object held by ZoneEngine, introduced purely as a physical
// grouping: Pine counts every collection field of an exported type as an external
// element of that type's generated constructor, and ZoneEngine.new had reached 259
// against the limit of 254 (CE10116). Moving the Batch 36 arrays one level down
// replaces seventeen collection fields of ZoneEngine with one object reference,
// with no logical change at all.
// It is exported only because ZoneEngine is an exported type and holds a field of
// this type; it is not a new business API, and the 19 Public API functions keep
// their signatures.
// What it is NOT: a per-Root, per-Core or per-Side object registry. Its contents
// stay Structure-of-Arrays / flat parallel storage, exactly as before, and
// array<Root>, array<Core>, array<Side>, nested arrays and map<int, array<int>>
// remain forbidden (I6.1, D12). It holds no scalar business state.
// ============================================================

export type W02AuxStore
    // Physical container only. The source calls I11-13 a queue but fixes no physical
    // representation, so Batch 36 fixes one: a per-Category priority heap held as a
    // Structure of Arrays, exactly four queues, for CAT_SWING, CAT_ACCUM, CAT_FVG
    // and CAT_TIME_HL. MA and Psych Roots are not prune queue material and get no
    // queue here.
    // Each queue is four parallel arrays that together are one logical heap row:
    // the same index in all four always belongs to the same entry.
    // An entry deliberately does NOT hold a physical rootSlot as its identity
    // token, because slots are reused while Root IDs never are (D02). It holds
    //   Root ID                -> prune*RootIds
    //   Root prune revision    -> prune*RootRevisions
    //   Root state snapshot    -> prune*RootStateSnapshots
    //   confirmedTime snapshot -> prune*RootConfirmedTimeSnapshots
    // The confirmedTime snapshot is also the slot where a future heap keeps its
    // priority metadata; no comparator and no tie-break rule is fixed here.
    // rootPruneRevisions is a Root-SoA-shaped array indexed by physical rootSlot,
    // starting at 0, whose only purpose is to let a later reader tell a live entry
    // from a stale one. It is not a Root ID, and it is not an eighteenth I9
    // revision: the 17 global revisions are untouched by it.
    // The stale test a later reader is expected to perform - resolve the Root ID to
    // a slot, require the slot live, rootIds[slot] == the entry's Root ID,
    // rootPruneRevisions[slot] == the entry's revision, rootStates[slot] == the
    // state snapshot and rootConfirmedTimes[slot] == the confirmedTime snapshot -
    // is only a contract here: no validation helper is created. Freeing a Root will
    // therefore never scan the heaps to delete entries linearly; the entries simply
    // stop matching.
    // Real queue entries in this Batch = 0: all sixteen queue arrays stay size 0.
    // Not implemented here: the heap operations (push, pop, swap, bubble up / down,
    // head read, front remove), any sort or per-bar full rebuild, the Category
    // eligibility test, the prune predicate, the protection rules (ActiveTouch,
    // Broken, FlipWait, InverseWait, PendingGeneration and protected Accum pairs
    // are never dropped for capacity), the Accum pair mate lookup and atomic
    // retire, the current-period TimeHL protection, the Stage K connection and
    // EV_STORAGE_PRUNE. The revision is also never incremented yet: a later Batch
    // advances it on Root creation, Root state change and Core ownership grant or
    // release to requeue an entry.
    array<int>   rootPruneRevisions

    array<int>   pruneSwingRootIds
    array<int>   pruneSwingRootRevisions
    array<int>   pruneSwingRootStateSnapshots
    array<int>   pruneSwingRootConfirmedTimeSnapshots

    array<int>   pruneAccumRootIds
    array<int>   pruneAccumRootRevisions
    array<int>   pruneAccumRootStateSnapshots
    array<int>   pruneAccumRootConfirmedTimeSnapshots

    array<int>   pruneFvgRootIds
    array<int>   pruneFvgRootRevisions
    array<int>   pruneFvgRootStateSnapshots
    array<int>   pruneFvgRootConfirmedTimeSnapshots

    array<int>   pruneTimeHlRootIds
    array<int>   pruneTimeHlRootRevisions
    array<int>   pruneTimeHlRootStateSnapshots
    array<int>   pruneTimeHlRootConfirmedTimeSnapshots

    // ---- W02 Batch 37 : Core prune priority-queue foundation (I11-13 / I17.3) ----
    // The Core half of I11-13, built exactly like the Root half above and living in
    // this same singleton so that ZoneEngine.new stays under its external-element
    // limit. One queue only: the Dormant Zone Cores. A Core that is not Dormant is
    // never put into it, but the Dormant test and the queue eligibility test are
    // not written here.
    // The four queue arrays are one logical heap row per index:
    //   Core ID                     -> pruneCoreIds
    //   Core prune revision         -> pruneCoreRevisions
    //   unique Root count snapshot  -> pruneCoreRootCountSnapshots
    //   lastSeenTime snapshot       -> pruneCoreLastSeenTimeSnapshots
    // As on the Root side, an entry never holds a physical coreSlot as its identity
    // token: coreSlots are reused, Core IDs are not (D02).
    // The priority a later heap must implement is fixed here as a contract, in this
    // exact order: lastSeenTime ascending, then unique Root count ascending, then
    // Core ID ascending - oldest first, then the ones holding the fewest Roots,
    // then the lowest Core ID. No comparator is written.
    // What counts as the unique Root count is deliberately NOT decided here: it is
    // not fixed to the participation edge count, to a per-Side Root count or to the
    // plain sum of Support and Resistance, and no counting helper is added.
    // corePruneRevisions is a Core-SoA-shaped array indexed by physical coreSlot,
    // starting at 0, used only to tell a live entry from a stale one. It is not a
    // Core ID and it is not an eighteenth I9 revision.
    // The stale test a later reader is expected to perform - resolve the Core ID to
    // a slot, require the slot live, coreIds[slot] == the entry's Core ID,
    // corePruneRevisions[slot] == the entry's revision, the current unique Root
    // count == the entry's count snapshot and coreLastSeenTimes[slot] == the
    // lastSeenTime snapshot - is a contract only: no validation helper is created,
    // and freeing a Core never scans the heap to delete entries linearly.
    // Real queue entries in this Batch = 0: all four queue arrays stay size 0.
    // Not implemented here: the heap operations (push, pop, swap, bubble up / down,
    // head read, front removal), any sort or per-bar full rebuild over all Cores,
    // the Dormant eligibility test, the unique Root count, the protection rules
    // (an ActiveTouch, Broken, FlipWait or PendingGeneration Core is never pruned,
    // and no new eligibility condition such as PendingTopology is decided here),
    // the Stage K connection and EV_STORAGE_PRUNE. The revision is never
    // incremented yet: a later Batch advances it on a Phase change, a Root
    // membership change, a PendingGeneration change or any other change that moves
    // this Core's priority, and requeues it.
    array<int>   corePruneRevisions

    array<int>   pruneCoreIds
    array<int>   pruneCoreRevisions
    array<int>   pruneCoreRootCountSnapshots
    array<int>   pruneCoreLastSeenTimeSnapshots

    // ---- W02 Batch 38 : TouchStartSnapshot scalar storage (A6.5) ----
    // The scalar half of the A6.5 TouchStartSnapshot, kept in this singleton so
    // ZoneEngine.new stays under its external-element limit. A TouchStartSnapshot
    // is owned per Side, so every array here is indexed by physical sideSlot
    // (= coreSlot * 2 + sideIndex, 0 = Support, 1 = Resistance). The logical field
    // `side` is still stored in its own array rather than derived from the index,
    // because A6.5 lists it as a field of the Snapshot.
    // Logical field -> physical array:
    //   valid           -> sideTouchStartSnapshotValidFlags
    //   coreId          -> sideTouchStartSnapshotCoreIds
    //   generationId    -> sideTouchStartSnapshotGenerationIds
    //   side            -> sideTouchStartSnapshotSides
    //   rangeBottom     -> sideTouchStartSnapshotRangeBottoms
    //   rangeTop        -> sideTouchStartSnapshotRangeTops
    //   Category mask   -> sideTouchStartSnapshotCategoryMasks
    //   High mask       -> sideTouchStartSnapshotHighMasks
    //   cCount          -> sideTouchStartSnapshotCCounts
    //   hCount          -> sideTouchStartSnapshotHCounts
    //   density         -> sideTouchStartSnapshotDensities
    //   touchStartGrade -> sideTouchStartSnapshotGrades
    //   currentTouchNo  -> sideTouchStartSnapshotCurrentTouchNos
    //   approachSide    -> sideTouchStartSnapshotApproachSides
    //   startSeq        -> sideTouchStartSnapshotStartSeqs
    //   startTime       -> sideTouchStartSnapshotStartTimes
    //   deepestClose    -> sideTouchStartSnapshotDeepestCloses
    //   maxDepthPct     -> sideTouchStartSnapshotMaxDepthPcts
    // Immutability contract (A6.5): once a Touch has started, coreId, generationId,
    // side, rangeBottom, rangeTop, the participating Root IDs, categoryMask,
    // highMask, cCount, hCount, density, touchStartGrade, currentTouchNo,
    // approachSide, startSeq and startTime are frozen for the whole Episode. Only
    // deepestClose and maxDepthPct may change while the Episode runs. No mutation
    // logic exists yet, so nothing enforces or exercises this here.
    // This is frozen historical state and never an alias of the current Side state:
    // sideEffectiveBottoms, sideEffectiveTops, sideCCounts, sideHCounts,
    // sideDensities, sideGrades and sideCurrentTouchNos stay the live values and are
    // never used as a substitute for a Snapshot. density and touchStartGrade are
    // two separate stored fields, not references.
    // The Snapshot shares no storage with BreakSnapshot, PendingTopology or
    // PendingGeneration, and is never aliased to the Candidate scratch.
    // The participating Root ID copy of A6.5 is not here: a Snapshot must own its
    // copy independently, so scalar storage and Root-copy storage stay unmixed.
    // W02 Batch 40 fixes that copy's physical scheme in its own section below: a
    // flat singly-linked node pool with a per-Side head / tail / count, nodes that
    // hold the Root ID itself, an owner token of sideSlot + Core ID + Generation ID
    // + TouchNo, and a free node index stack. Real nodes = 0 there, and the copy,
    // alloc, free and validation helpers are still unimplemented.
    // Since W02 Batch 39 all eighteen arrays follow the physical Side lifecycle: a
    // new physical Core growth appends one row for the Support Side and one for the
    // Resistance Side, so each array keeps
    // size(...) == size(sidePhases) == size(coreIds) * 2, and on a reuse or a free
    // coreResetSlotRaw returns both of that Core's rows to the unset sentinel.
    // Real TouchStartSnapshots are still 0: nothing writes valid = true, so every
    // row holds the unset sentinel and no row describes a Touch that happened.
    // Still not implemented: the participating Root ID copy, Snapshot creation, the
    // valid / Core ID / Generation ID write, the range, mask and Grade freeze, the
    // TouchStart and the Episode update, the deepestClose and maxDepthPct business
    // logic with its depth formula, and the Stage C / state logic connection.
    array<bool>  sideTouchStartSnapshotValidFlags
    array<int>   sideTouchStartSnapshotCoreIds
    array<int>   sideTouchStartSnapshotGenerationIds
    array<int>   sideTouchStartSnapshotSides
    array<float> sideTouchStartSnapshotRangeBottoms
    array<float> sideTouchStartSnapshotRangeTops
    array<int>   sideTouchStartSnapshotCategoryMasks
    array<int>   sideTouchStartSnapshotHighMasks
    array<int>   sideTouchStartSnapshotCCounts
    array<int>   sideTouchStartSnapshotHCounts
    array<int>   sideTouchStartSnapshotDensities
    array<int>   sideTouchStartSnapshotGrades
    array<int>   sideTouchStartSnapshotCurrentTouchNos
    array<int>   sideTouchStartSnapshotApproachSides
    array<int>   sideTouchStartSnapshotStartSeqs
    array<int>   sideTouchStartSnapshotStartTimes
    array<float> sideTouchStartSnapshotDeepestCloses
    array<float> sideTouchStartSnapshotMaxDepthPcts

    // ---- W02 Batch 40 : TouchStartSnapshot participating-Root copy storage (A6.5) ----
    // A6.5 requires each TouchStartSnapshot to own a copy of the Root IDs that took
    // part, fixed at the start of the Touch and shared with nothing. The source does
    // not fix a physical representation, so Batch 40 fixes one: a flat singly-linked
    // node pool with three metadata arrays per Side. Nested collections stay
    // forbidden - no array of arrays, no map to an array and no per-Snapshot UDT.
    // Per Side, indexed by physical sideSlot:
    //   head node index -> sideTouchStartSnapshotRootHeadNodeIndexes
    //   tail node index -> sideTouchStartSnapshotRootTailNodeIndexes
    //   node count      -> sideTouchStartSnapshotRootCounts
    // Unset sentinel: head and tail SLOT_INVALID, count 0.
    // Per node, indexed by node index in the pool:
    //   Root ID               -> touchStartSnapshotRootNodeRootIds
    //   next node index       -> touchStartSnapshotRootNodeNextIndexes
    //   owner sideSlot        -> touchStartSnapshotRootNodeOwnerSideSlots
    //   expected Core ID      -> touchStartSnapshotRootNodeExpectedCoreIds
    //   expected Generation   -> touchStartSnapshotRootNodeExpectedGenerationIds
    //   expected TouchNo      -> touchStartSnapshotRootNodeExpectedTouchNos
    //   live flag             -> touchStartSnapshotRootNodeLiveFlags
    // Reusable node rows come back through touchStartSnapshotRootNodeFreeIndexes.
    // A node stores the Root ID, never a rootSlot: rootSlots are reused (D02), so
    // only the ID keeps the Snapshot's Root identity stable after the Root that
    // produced it is gone. The copy is the truth: the Snapshot's Root set is never
    // rebuilt from the current rootSlot, the participation edges, the current Side
    // Root set or the Candidate scratch.
    // The owner token is all four of sideSlot, expected Core ID, expected Generation
    // ID and expected TouchNo. A sideSlot alone is not enough because the slot is
    // reused after a Core free, and Core ID + Generation ID alone is not enough
    // either because one Core and Generation can run several Touch Episodes on the
    // same Side. No ownership validation helper is written here.
    // Node sentinel contract for a future row: Root ID ID_NONE, next SLOT_INVALID,
    // owner sideSlot SLOT_INVALID, expected Core ID and Generation ID ID_NONE,
    // expected TouchNo 0, live false. Batch 40 creates no node row at all, so
    // nothing exercises it yet.
    // This pool is its own: it shares no storage with the TouchMark ring, the
    // participation edge pool, the Candidate scratch (which holds rootSlots, not
    // Root IDs, and is never reused as Snapshot storage), BreakSnapshot,
    // PendingTopology or PendingGeneration, and no shared Snapshot pool is created.
    // head and tail exist so a later copy can append in the order it receives the
    // Roots; no canonical ordering of the Root IDs is decided here, and no append
    // helper, comparator or sort is added.
    // Since Batch 40 the three Side metadata arrays follow the physical Side
    // lifecycle: a new physical Core growth appends one unset row for Support and
    // one for Resistance, so they keep
    // size(...) == size(sidePhases) == size(coreIds) * 2, and coreResetSlotRaw puts
    // both of a Core's rows back to the unset sentinel on a reuse or a free. The
    // seven node arrays and the free stack are independent of the Side count.
    // Real Root-copy nodes = 0 and every rootCount is 0, because no path copies a
    // Root ID yet. rootCount > 0 would still never mean a Snapshot exists: the
    // valid flag stays the only truth, and nothing writes it true.
    // W02 Batch 41 adds the raw physical node lifecycle for this pool - reset,
    // alloc and free - in its own section further below. Those three helpers have
    // no Production call site, so real nodes are still 0 and both the node arrays
    // and the free stack stay size 0.
    // Still not implemented: the Root ID copy itself, the append and detach-all
    // helpers, the ownership validation, and the Snapshot clear that a later Batch
    // must connect before a reset can ever meet a live node - at that point
    // coreResetSlotRaw will return the nodes to the free stack first.
    array<int>   sideTouchStartSnapshotRootHeadNodeIndexes
    array<int>   sideTouchStartSnapshotRootTailNodeIndexes
    array<int>   sideTouchStartSnapshotRootCounts

    array<int>   touchStartSnapshotRootNodeRootIds
    array<int>   touchStartSnapshotRootNodeNextIndexes
    array<int>   touchStartSnapshotRootNodeOwnerSideSlots
    array<int>   touchStartSnapshotRootNodeExpectedCoreIds
    array<int>   touchStartSnapshotRootNodeExpectedGenerationIds
    array<int>   touchStartSnapshotRootNodeExpectedTouchNos
    array<bool>  touchStartSnapshotRootNodeLiveFlags

    array<int>   touchStartSnapshotRootNodeFreeIndexes

    // ---- W02 Batch 42 : origin identity -> rootSlot index foundation (I11-2) ----
    // Physical container only, and the physical form is fixed here as an originKey
    // bucket: a map from originKey to the head rootSlot of its bucket, plus a
    // doubly-linked chain over the physical Root slots themselves.
    //   originKeyBucketHeadRootSlots     key = rootOriginKeys[rootSlot],
    //                                    value = that bucket's head rootSlot
    //   rootOriginBucketPrevRootSlots    rootSlot -> previous rootSlot in its bucket
    //   rootOriginBucketNextRootSlots    rootSlot -> next rootSlot in its bucket
    //   rootOriginBucketExpectedRootIds  rootSlot -> the Root ID it was indexed under
    // Unset sentinel: prev and next SLOT_INVALID, expected Root ID ID_NONE. ID_NONE
    // is never a map key.
    // THIS IS NOT originKey -> unique Root. An originKey is a coarse bucket and a
    // prefilter, never a proof of identity: two Roots may share one originKey and
    // still be different origins. A future lookup must, at a minimum, take the
    // bucket by originKey, walk its chain, require the rootSlot live, require
    // rootOriginBucketExpectedRootIds[rootSlot] == rootIds[rootSlot] (the slot was
    // reused otherwise, and Root IDs are never reused), require
    // rootOriginKeys[rootSlot] to equal the originKey it looked up, and only then
    // compare the full origin tuple of the source before accepting a Root. Matching
    // a key, a hash or a fingerprint alone is never enough to accept one.
    // The full origin tuple is deliberately NOT written here: which fields it holds
    // for each Category - category, tf, origin time, origin end time, boundary
    // subtype, direction and whatever else - is NOT_FIXED_IN_SOURCE, so no
    // fullOriginEqual, no origin tuple comparator and no per-Category identity
    // helper (Swing, Accum, TimeHL, FVG, Psych, EMA) is invented. They are connected
    // once the Source / Root generation Window fixes them.
    // prev and next are both stored so a later attach and detach can work inside one
    // bucket, without scanning every Root and without rebuilding the index each bar.
    // The chain carries no order semantics: it is never a Root ID, price, Candidate
    // tie-break or Event order, only the candidate set of a full-tuple lookup.
    // This index is distinct from I11-1: rootIdToSlot indexes the logical Root ID,
    // this one only narrows the search for an origin.
    // Real membership in this Batch = 0: the map stays empty, there is no map.put or
    // map.remove, every prev / next is SLOT_INVALID and every expected Root ID is
    // ID_NONE. The three arrays follow the physical Root lifecycle, so their size
    // always equals size(rootIds). Not implemented: the attach, detach and lookup
    // helpers, the full tuple comparison and the Root registration connection.
    map<int, int> originKeyBucketHeadRootSlots
    array<int>    rootOriginBucketPrevRootSlots
    array<int>    rootOriginBucketNextRootSlots
    array<int>    rootOriginBucketExpectedRootIds

    // ---- W02 Batch 43 : BreakSnapshot scalar storage (A6.6) ----
    // The scalar half of the A6.6 BreakSnapshot. A6.7 makes a BreakSnapshot the
    // property of one Side, so every array here is indexed by physical sideSlot
    // (= coreSlot * 2 + sideIndex, 0 = Support, 1 = Resistance) and never by
    // coreSlot: Support and Resistance never share a BreakSnapshot.
    // Logical field -> physical array:
    //   valid        -> sideBreakSnapshotValidFlags
    //   coreId       -> sideBreakSnapshotCoreIds
    //   generationId -> sideBreakSnapshotGenerationIds
    //   oldSide      -> sideBreakSnapshotOldSides
    //   rangeBottom  -> sideBreakSnapshotRangeBottoms
    //   rangeTop     -> sideBreakSnapshotRangeTops
    //   breakSeq     -> sideBreakSnapshotBreakSeqs
    //   breakTime    -> sideBreakSnapshotBreakTimes
    //   wasGapBreak  -> sideBreakSnapshotWasGapBreakFlags
    //   movedAway    -> sideBreakSnapshotMovedAwayFlags
    //   retestSeen   -> sideBreakSnapshotRetestSeenFlags
    // Fixed-range contract: rangeBottom and rangeTop are the range as it stood at
    // the Break, frozen from then on. A later Flip, FlipAttempt or Reclaim must read
    // this range and nothing else - the current EMA, a Zone range after a
    // recluster, the current sideEffectiveBottom / sideEffectiveTop and the current
    // corePhysicalBottom / corePhysicalTop are never a substitute for it. No such
    // logic exists yet.
    // wasGapBreak, movedAway and retestSeen carry no added meaning here: they hold
    // their false sentinel and a later state transition is what writes them. No
    // Local Break or Gap Break test and no movedAway / retest rule is introduced.
    // The Root-origin ID copy that A6.6 also requires is not in these eleven: it
    // needs its own independent ownership, and W02 Batch 44 fixes its physical
    // scheme - a flat linked node pool with a per-Side head / tail / count, an owner
    // token and a free stack - in its own section below. Real nodes are 0 there and
    // the copy itself is still unimplemented.
    // This storage is its own: it shares nothing with the TouchStartSnapshot scalars
    // or its Root-copy node pool, PendingTopology, PendingGeneration, the Candidate
    // scratch, the TouchMark ring, the participation adjacency, the current Side
    // Root list or the Zone origin Root set, and it aliases no TouchStartSnapshot
    // array.
    // It is also not the I11-11 price index: brokenSnapshot* / flipSnapshot* and
    // their reverse positions (Batch 34) order Sides by a frozen range, while these
    // eleven arrays are the Snapshot itself. Neither stands in for the other.
    // The eleven arrays follow the physical Side lifecycle, so each keeps
    // size(...) == size(sidePhases) == size(coreIds) * 2.
    // Real BreakSnapshots = 0: nothing writes valid = true, so every row holds the
    // unset sentinel. Not implemented: the Break capture, the Local / Gap Break
    // predicates, FlipAttempt, FlipConfirm, Reclaim, the movedAway and retest
    // decisions and the Stage connection.
    array<bool>  sideBreakSnapshotValidFlags
    array<int>   sideBreakSnapshotCoreIds
    array<int>   sideBreakSnapshotGenerationIds
    array<int>   sideBreakSnapshotOldSides
    array<float> sideBreakSnapshotRangeBottoms
    array<float> sideBreakSnapshotRangeTops
    array<int>   sideBreakSnapshotBreakSeqs
    array<int>   sideBreakSnapshotBreakTimes
    array<bool>  sideBreakSnapshotWasGapBreakFlags
    array<bool>  sideBreakSnapshotMovedAwayFlags
    array<bool>  sideBreakSnapshotRetestSeenFlags

    // ---- W02 Batch 44 : BreakSnapshot Root-origin-ID copy storage (A6.6) ----
    // A6.6 gives a BreakSnapshot its own copy of the Root origin IDs that made up
    // the Side at the Break, and A6.7 makes the Snapshot the property of one Side.
    // The source fixes no physical representation, so Batch 44 fixes one, in the
    // same shape as the Batch 40 TouchStart copy but as a completely separate pool:
    // a flat singly-linked node pool with three metadata arrays per Side. No nested
    // collection and no per-Snapshot UDT.
    // Per Side, indexed by physical sideSlot:
    //   head node index -> sideBreakSnapshotRootHeadNodeIndexes
    //   tail node index -> sideBreakSnapshotRootTailNodeIndexes
    //   node count      -> sideBreakSnapshotRootCounts
    // Unset sentinel: head and tail SLOT_INVALID, count 0.
    // Per node, indexed by node index in this pool:
    //   Root ID             -> breakSnapshotRootNodeRootIds
    //   next node index     -> breakSnapshotRootNodeNextIndexes
    //   owner sideSlot      -> breakSnapshotRootNodeOwnerSideSlots
    //   expected Core ID    -> breakSnapshotRootNodeExpectedCoreIds
    //   expected Generation -> breakSnapshotRootNodeExpectedGenerationIds
    //   expected break Seq  -> breakSnapshotRootNodeExpectedBreakSeqs
    //   live flag           -> breakSnapshotRootNodeLiveFlags
    // Reusable rows come back through breakSnapshotRootNodeFreeIndexes.
    // A node stores the Root ID and only the Root ID. A rootSlot is reused (D02), so
    // it cannot carry the identity of a Root that existed at the Break, and an
    // originKey, a pairKey, a Category or a price is never a substitute for the ID:
    // rootOriginKeys in particular is a coarse bucket (I11-2), never this copy.
    // The owner token is sideSlot + expected Core ID + expected Generation ID +
    // expected break Seq. A sideSlot alone is reused after a Core free, and Core ID
    // with Generation ID alone cannot separate one Break from the next inside the
    // same Generation - breakSeq is the Break Episode identity here, matching the
    // A6.6 scalar field, and TouchNo is not used. A later reader is expected to
    // check a node against sideBreakSnapshotBreakSeqs; no such helper exists yet.
    // Node sentinel contract for a future row: Root ID ID_NONE, next SLOT_INVALID,
    // owner sideSlot SLOT_INVALID, expected Core ID and Generation ID ID_NONE,
    // expected break Seq SEQ_UNSET, live false. Batch 44 creates no node row.
    // This pool is separate from the TouchStartSnapshot one in every array,
    // including its free stack: the two are never merged into a shared Snapshot
    // pool. It shares nothing with PendingTopology, PendingGeneration, the Candidate
    // scratch, the TouchMark ring or the participation adjacency either.
    // The copy is the truth once it exists: after the Break the Side's live
    // composition may change, and the Snapshot must still describe the Break, so it
    // is never rebuilt from the participation adjacency, the current valid Side Root
    // list, the Zone origin Root set or the Candidate scratch. The Root IDs are
    // copied when the Snapshot is taken - that copy does not happen yet.
    // head and tail exist so a later copy can append in the order it receives the
    // Roots; no canonical ordering of the Root IDs is decided here, and no
    // comparator or sort is added.
    // Since Batch 44 the three Side metadata arrays follow the physical Side
    // lifecycle: a new physical Core growth appends one unset row for Support and
    // one for Resistance, so they keep
    // size(...) == size(sidePhases) == size(coreIds) * 2, and coreResetSlotRaw puts
    // both of a Core's rows back to the unset sentinel. The seven node arrays and
    // the free stack are independent of the Side count.
    // Real Root-copy nodes = 0 and every rootCount is 0. A rootCount above 0 would
    // still never mean a BreakSnapshot exists: sideBreakSnapshotValidFlags stays the
    // only truth and nothing writes it true.
    // W02 Batch 45 adds the raw physical node lifecycle for this pool - reset,
    // alloc and free - in its own section further below, kept separate from the
    // TouchStart helpers. Those three have no Production call site, so real nodes
    // are still 0 and both the node arrays and the free stack stay size 0.
    // Still not implemented: the Root ID copy itself, append, detach-all, the
    // ownership validation, the BreakSnapshot clear that a later Batch must connect
    // before a reset can meet a live node, the Break capture and the Flip / Reclaim
    // logic.
    array<int>   sideBreakSnapshotRootHeadNodeIndexes
    array<int>   sideBreakSnapshotRootTailNodeIndexes
    array<int>   sideBreakSnapshotRootCounts

    array<int>   breakSnapshotRootNodeRootIds
    array<int>   breakSnapshotRootNodeNextIndexes
    array<int>   breakSnapshotRootNodeOwnerSideSlots
    array<int>   breakSnapshotRootNodeExpectedCoreIds
    array<int>   breakSnapshotRootNodeExpectedGenerationIds
    array<int>   breakSnapshotRootNodeExpectedBreakSeqs
    array<bool>  breakSnapshotRootNodeLiveFlags

    array<int>   breakSnapshotRootNodeFreeIndexes

    // ---- W02 Batch 46 : Side current valid Root ID list storage (A6.7) ----
    // A6.7 gives each Side the list of the Root IDs that are valid for it right now.
    // The source fixes the logical requirement only, so Batch 46 fixes the physical
    // form: a flat singly-linked node pool with three metadata arrays per Side, a
    // third pool independent of the two Snapshot pools above. No nested collection
    // and no per-Side UDT.
    // Per Side, indexed by physical sideSlot:
    //   head node index -> sideCurrentRootHeadNodeIndexes
    //   tail node index -> sideCurrentRootTailNodeIndexes
    //   node count      -> sideCurrentRootCounts
    // Unset sentinel: head and tail SLOT_INVALID, count 0.
    // Per node, indexed by node index in this pool:
    //   Root ID             -> sideCurrentRootNodeRootIds
    //   next node index     -> sideCurrentRootNodeNextIndexes
    //   owner sideSlot      -> sideCurrentRootNodeOwnerSideSlots
    //   expected Core ID    -> sideCurrentRootNodeExpectedCoreIds
    //   expected Generation -> sideCurrentRootNodeExpectedGenerationIds
    //   live flag           -> sideCurrentRootNodeLiveFlags
    // Reusable rows come back through sideCurrentRootNodeFreeIndexes.
    // A node stores the Root ID, never a rootSlot: a rootSlot is reused (D02) and so
    // can never be the logical identity of a Root in this list.
    // The owner token is sideSlot + expected Core ID + expected Generation ID. A
    // sideSlot alone is reused after a Core free; a Core ID is never reused; and a
    // change of Generation makes the Side's current Root composition a different
    // generation, so the Generation ID belongs in the token. No validation helper is
    // written here.
    // Node sentinel contract for a future row: Root ID ID_NONE, next SLOT_INVALID,
    // owner sideSlot SLOT_INVALID, expected Core ID and Generation ID ID_NONE, live
    // false. Batch 46 creates no node row at all.
    // This is CURRENT live state, not a Snapshot. The TouchStartSnapshot and
    // BreakSnapshot Root copies above are historical and frozen; this list is meant
    // to follow Candidate adoption, Core topology, Generation transitions and Root
    // eligibility as they happen. None of that updating exists yet.
    // It is also not the I11-7 participation adjacency, which is read from the Root
    // side to find the Cores and Sides a Root takes part in; this is the Side's own
    // list, read from the Side. Neither replaces the other. And it is not the A6.8
    // Zone origin Root set, which gets its own separate storage later - no pool is
    // shared with it.
    // head and tail exist so a later helper can append in the order it receives the
    // Roots. A6.7 asks for the list only, so no canonical ordering is fixed here:
    // Root ID ascending, price order and a Candidate tie-break order are all equally
    // undecided, and no comparator or sort is added.
    // Since Batch 46 the three Side metadata arrays follow the physical Side
    // lifecycle: a new physical Core growth appends one unset row for Support and
    // one for Resistance, so they keep
    // size(...) == size(sidePhases) == size(coreIds) * 2, and coreResetSlotRaw puts
    // both of a Core's rows back to the unset sentinel. The six node arrays and the
    // free stack are independent of the Side count.
    // Real nodes = 0, every count is 0 and no Root ID is written: the membership,
    // the node reset / alloc / free helpers, append, detach, the clear, the
    // duplicate and ownership checks, the Candidate adoption and Core association,
    // the Generation transition connection, the ZoneView projection and the Stage
    // connection are all unimplemented. A later Batch must connect the clear or
    // detach before any real membership starts, so a Core free never leaves a node
    // behind.
    array<int>   sideCurrentRootHeadNodeIndexes
    array<int>   sideCurrentRootTailNodeIndexes
    array<int>   sideCurrentRootCounts

    array<int>   sideCurrentRootNodeRootIds
    array<int>   sideCurrentRootNodeNextIndexes
    array<int>   sideCurrentRootNodeOwnerSideSlots
    array<int>   sideCurrentRootNodeExpectedCoreIds
    array<int>   sideCurrentRootNodeExpectedGenerationIds
    array<bool>  sideCurrentRootNodeLiveFlags

    array<int>   sideCurrentRootNodeFreeIndexes

    // ---- W02 Batch 47 : ZoneCore origin Root ID set storage (A6.8) ----
    // A6.8 gives a ZoneCore the set of the Root IDs it originated from. The source
    // fixes the logical requirement only, so Batch 47 fixes the physical form: a
    // flat singly-linked node pool with three metadata arrays per Core - a fourth
    // pool, independent of the two Snapshot Root copies and of the Batch 46 Side
    // current list. No nested collection and no per-Core UDT.
    // Ownership is per Core, so the metadata is indexed by physical coreSlot and
    // there is exactly one set per Core: Support and Resistance never get their own
    // duplicated origin set.
    //   head node index -> coreZoneOriginRootHeadNodeIndexes
    //   tail node index -> coreZoneOriginRootTailNodeIndexes
    //   node count      -> coreZoneOriginRootCounts
    // Unset sentinel: head and tail SLOT_INVALID, count 0.
    // Per node, indexed by node index in this pool:
    //   Root ID             -> coreZoneOriginRootNodeRootIds
    //   next node index     -> coreZoneOriginRootNodeNextIndexes
    //   owner coreSlot      -> coreZoneOriginRootNodeOwnerCoreSlots
    //   expected Core ID    -> coreZoneOriginRootNodeExpectedCoreIds
    //   expected Generation -> coreZoneOriginRootNodeExpectedGenerationIds
    //   live flag           -> coreZoneOriginRootNodeLiveFlags
    // Reusable rows come back through coreZoneOriginRootNodeFreeIndexes.
    // A node stores the Root ID and never treats a rootSlot as the Root's identity,
    // because a rootSlot is reused (D02).
    // The owner token is coreSlot + expected Core ID + expected Generation ID. A
    // coreSlot is reused after a free, a Core ID never is, and a ZoneCore carries a
    // generationId, so the Generation ID is kept as well to stop a node of an
    // earlier generation being read as belonging to the current one. No validation
    // helper is written here, and what a Generation means or when it advances is
    // not changed by this Batch.
    // Node sentinel contract for a future row: Root ID ID_NONE, next SLOT_INVALID,
    // owner coreSlot SLOT_INVALID, expected Core ID and Generation ID ID_NONE, live
    // false. Batch 47 creates no node row at all.
    // This is the Core's own origin set and nothing else. It is not the A6.7 Side
    // current valid Root list of Batch 46, which is per Side and follows the live
    // composition; it is not the I11-7 participation adjacency, which is read from
    // the Root side, and the origin set is never rebuilt from it; and it is not a
    // Snapshot, so it is never aliased to the TouchStart or Break Root-copy pools.
    // Touch historical, Break historical, Side current and Core origin are four
    // separate storages that are never merged into one pool.
    // A6.8 asks for a set, so no canonical ordering is fixed here: Root ID
    // ascending, price order and a Candidate order are equally undecided, and no
    // comparator or sort is added. head and tail exist only so a later helper can
    // append locally. Duplicate prevention is not implemented either.
    // Since Batch 47 the three Core metadata arrays follow the physical Core
    // lifecycle: a new physical Core growth appends exactly one unset row - one per
    // Core, not one per Side - so they keep size(...) == size(coreIds), and
    // coreResetSlotRaw puts that Core's row back to the unset sentinel. The six node
    // arrays and the free stack are independent of the Core count.
    // Real nodes = 0, every count is 0 and no Root ID is written: the membership,
    // the node reset / alloc / free helpers, append, detach, the clear, the
    // duplicate and ownership checks, the Candidate adoption, the Core creation
    // logic, the Generation transition, Merge / Split, PendingTopology,
    // PendingGeneration and the Stage connection are all unimplemented. A later
    // Batch must connect the clear or detach before any real membership starts, so
    // a Core free never leaves a node behind.
    array<int>   coreZoneOriginRootHeadNodeIndexes
    array<int>   coreZoneOriginRootTailNodeIndexes
    array<int>   coreZoneOriginRootCounts

    array<int>   coreZoneOriginRootNodeRootIds
    array<int>   coreZoneOriginRootNodeNextIndexes
    array<int>   coreZoneOriginRootNodeOwnerCoreSlots
    array<int>   coreZoneOriginRootNodeExpectedCoreIds
    array<int>   coreZoneOriginRootNodeExpectedGenerationIds
    array<bool>  coreZoneOriginRootNodeLiveFlags

    array<int>   coreZoneOriginRootNodeFreeIndexes

    // ---- W02 Batch 48 : PendingTopology / PendingGeneration flags (A6.8) ----
    // Existence flags only, one entry per ZoneCore, indexed by physical coreSlot.
    // Never per Side: Support and Resistance do not get their own flags.
    //   corePendingTopologyFlags   : a deferred Topology plan exists for this Core
    //   corePendingGenerationFlags : a new generation is a pending candidate
    // Both sentinel false, and Batch 48 never writes either true - no business path
    // can set them yet, so their runtime effect is nil.
    // What true is to mean later: for Topology, that a Topology change could not be
    // applied immediately (during an ActiveTouch) and waits as a plan; for
    // Generation, that the conditions for a new generation are a candidate but the
    // update has not been committed. None of the deciding logic exists here: no
    // ActiveTouch test, no Topology diff, no Merge or Split, no Candidate handling,
    // no plan creation, refresh or apply, no generation test and no generation
    // start.
    // The payloads are deliberately NOT invented. I6.1 requires a PendingTopology to
    // own its Root array independently of every Snapshot, and a PendingGeneration to
    // carry the state of the candidate generation, but the full field list of either
    // is not fixed in the source, so nothing beyond these two flags is added: no
    // head / tail / count, no node pool, no free stack, no Candidate scalar, range,
    // mask, density, Side, Root set, reference price, reset distance, re-approach
    // threshold, base range or armed state. An older Reference's fields are not
    // treated as the spec and are not copied. Those physical payloads are fixed in a
    // later Batch.
    // The flags follow the physical Core lifecycle: a new physical Core growth
    // appends one false per Core - not per Side - so both keep
    // size(...) == size(coreIds), and coreResetSlotRaw puts a Core's pair back to
    // false, which is also what a free or a reuse does since the free path ends in
    // that reset. There is no business clear yet.
    // Not connected here, on purpose: the I17.3 prune protection (a
    // PendingGeneration Core must not be pruned) and the rule that a Core with
    // either pending must not go Dormant. No prune queue, prune predicate,
    // protection rule or Dormant transition is touched, and PendingTopology is not
    // added to any protection condition on our own initiative. The Stage I use of
    // PendingTopology belongs to a later Window.
    // Generation state is untouched: no Generation ID is issued, nextGenerationId
    // and coreGenerationIds are not written and no EV_GENERATION_START exists.
    array<bool>  corePendingTopologyFlags
    array<bool>  corePendingGenerationFlags

    // ---- W02 Batch 50 : EndedGeneration ring payload storage (I17.2 / A6.9) ----
    // The payload half of the bounded EndedGeneration history, as a Structure of
    // Arrays. There is exactly ONE ring for the whole Engine: it is not per Core and
    // not per Side, and cfg.maxEndedGenerations is the Engine-wide limit on how many
    // ended generations are kept. Its head and count live as scalars on ZoneEngine,
    // never faked as per-row arrays.
    // Row i of the ring is the same index in all seven arrays:
    //   coreId               -> endedGenerationCoreIds
    //   generationId         -> endedGenerationGenerationIds
    //   endedTime            -> endedGenerationEndedTimes
    //   supportTouches       -> endedGenerationSupportTouches
    //   resistanceTouches    -> endedGenerationResistanceTouches
    //   supportWeakReason    -> endedGenerationSupportWeakReasons
    //   resistanceWeakReason -> endedGenerationResistanceWeakReasons
    // Provenance of these seven: they are the diagnostic record the existing v2
    // implementation has used, kept here for compatibility. The current source does
    // NOT fix the complete EndedGeneration payload, so this list is not claimed as
    // the canonical one and it does not constrain the later Generation spec - if the
    // source turns out to require more, a later Window adds it. Equally, nothing
    // else is invented into the record here: no Root ID, range, grade, FVG,
    // Snapshot, TouchMark, PendingTopology or PendingGeneration payload.
    // Unused-row sentinel contract, for when a later Batch creates rows: coreId and
    // generationId ID_NONE, endedTime int(na), both touch counts 0 and both weak
    // reasons WEAK_NONE. Batch 50 creates no row, so nothing is written.
    // Ring principle, fixed here as a contract: logical entry i sits at physical
    // index (endedGenerationRingHead + i) % capacity, so reading 0 .. count - 1
    // walks the ended generations in chronological order. A full ring overwrites
    // its oldest entry and advances the head - it never shifts rows forward, and
    // array.remove(0), array.shift and array.unshift are never used on it. The
    // physical order inside the ring is never used directly as an Event, Merge /
    // Split or Public API order.
    // Capacity is cfg.maxEndedGenerations and nothing else: 30 is that setting's
    // default, never a hard-coded capacity here. Batch 50 preallocates nothing,
    // because no append exists yet, so the seven arrays stay size 0 with head 0 and
    // count 0.
    // Real entries = 0. Not implemented: the append, the overwrite, the physical
    // index and read helpers, any reset, the generation start and end, the ended
    // generation record itself and EV_GENERATION_START.
    array<int>   endedGenerationCoreIds
    array<int>   endedGenerationGenerationIds
    array<int>   endedGenerationEndedTimes
    array<int>   endedGenerationSupportTouches
    array<int>   endedGenerationResistanceTouches
    array<int>   endedGenerationSupportWeakReasons
    array<int>   endedGenerationResistanceWeakReasons

    // ---- W02 Batch 51 : per-Side FVG diagnostic storage foundation (A6.7 / A6.8) ----
    // A6.8 has a ZoneCore keep FVG diagnostic information, and a ZoneCore holds two
    // SideViewStates. The four diagnostics exist per Side in A6.7 and are returned
    // per Side by the W01 ZoneView, so this storage is per Side and indexed by
    // physical sideSlot (= coreSlot * 2 + sideIndex, 0 = Support, 1 = Resistance).
    // No new Core-global aggregate of them is invented.
    //   fvgDirectionMask       -> sideFvgDirectionMasks
    //   fvgRootCount           -> sideFvgRootCounts
    //   fvgFreshCount          -> sideFvgFreshCounts
    //   fvgStructuralStateMask -> sideFvgStructuralStateMasks
    // These are the storage behind the four ZoneView fields of the same name, but
    // Window 02 does not connect them: viewAt keeps returning the W01 sentinels and
    // is not touched.
    // Unset sentinel: direction FVG_MASK_NONE, both counts 0, structural state mask
    // 0. Batch 51 writes nothing but those sentinels.
    // The direction mask uses only the existing D03 codes - FVG_MASK_NONE,
    // FVG_MASK_BULLISH, FVG_MASK_BEARISH, FVG_MASK_BOTH - and no Inverse direction
    // code is added, because Inverse lives in the Root state.
    // The structural-state mask's bit layout is deliberately NOT defined here: no
    // bit is assigned to Active, Invalidated, InverseWait or InverseActive. The
    // encoding is fixed by the Window that owns FVG, and until then the field only
    // ever holds its 0 sentinel.
    // What counts as one Root for fvgRootCount, and what makes an FVG Fresh for
    // fvgFreshCount, are equally undecided here: no FVG Candidate participation,
    // Broad localization or structurally-active rule is invented, and neither count
    // is wired to Root.fvgFresh or to any FVG state index.
    // Business calculation = 0: the FVG formation, invalidation, Fresh update and
    // Inverse paths, the existing FVG index memberships and the Candidate / Side
    // state arrays are all untouched, and nothing derives these four from them yet.
    // The four follow the physical Side lifecycle, so each keeps
    // size(...) == size(sidePhases) == size(coreIds) * 2.
    array<int>   sideFvgDirectionMasks
    array<int>   sideFvgRootCounts
    array<int>   sideFvgFreshCounts
    array<int>   sideFvgStructuralStateMasks

    // ---- W02 Batch 52 : PendingTopology multi-child Root-copy storage foundation (I6.1 / A6.8) ----
    // I6.1 requires the Root array of a PendingTopology to be an independent copy,
    // shared with nothing. This is that storage, and it shares no array and no free
    // stack with the TouchStartSnapshot pool, the BreakSnapshot pool, the Side
    // current valid Root list, the Core Zone origin Root set, the Candidate scratch
    // or the participation adjacency, and it is never merged with PendingGeneration.
    // It is two levels, not a single Core -> Root list, because a deferred Strict
    // topology plan may have to hold one old Core against several child candidates:
    //   Core -> 0..N child rows -> each child owns its own Root ID list
    // No cap on the number of children and no cap on a child's Roots is introduced.
    // Per Core, indexed by physical coreSlot (sentinel head / tail SLOT_INVALID,
    // count 0):
    //   corePendingTopologyChildHeadIndexes / ...ChildTailIndexes / ...ChildCounts
    // Per child row, indexed by child index in the child pool:
    //   next child index    -> pendingTopologyChildNextIndexes
    //   owner coreSlot      -> pendingTopologyChildOwnerCoreSlots
    //   expected Core ID    -> pendingTopologyChildExpectedCoreIds
    //   expected Generation -> pendingTopologyChildExpectedGenerationIds
    //   its Root list       -> pendingTopologyChildRootHeadNodeIndexes /
    //                          ...ChildRootTailNodeIndexes / ...ChildRootCounts
    //   live flag           -> pendingTopologyChildLiveFlags
    // Reusable child rows come back through pendingTopologyChildFreeIndexes.
    // Per Root-copy node, indexed by node index in its own pool:
    //   Root ID             -> pendingTopologyRootNodeRootIds
    //   next node index     -> pendingTopologyRootNodeNextIndexes
    //   owner child index   -> pendingTopologyRootNodeOwnerChildIndexes
    //   expected Core ID    -> pendingTopologyRootNodeExpectedCoreIds
    //   expected Generation -> pendingTopologyRootNodeExpectedGenerationIds
    //   live flag           -> pendingTopologyRootNodeLiveFlags
    // Reusable nodes come back through pendingTopologyRootNodeFreeIndexes.
    // A node stores the Root ID, never a rootSlot, because a rootSlot is reused
    // (D02); the copy is the truth and a plan's Root set is never rebuilt later from
    // the Root registry, the participation adjacency or any other index.
    // A child's owner token is ownerCoreSlot + expected Core ID + expected
    // Generation ID: a coreSlot is reused after a free, a Core ID never is, and a
    // plan made under one Generation is not a plan of the next. A Root node carries
    // its owner child index plus the same two expected IDs. No validation helper is
    // written here.
    // Child sentinel contract for a future row: next SLOT_INVALID, owner coreSlot
    // SLOT_INVALID, expected Core ID and Generation ID ID_NONE, Root head and tail
    // SLOT_INVALID, Root count 0, live false. Root node sentinel contract: Root ID
    // ID_NONE, next SLOT_INVALID, owner child index SLOT_INVALID, expected Core ID
    // and Generation ID ID_NONE, live false. Batch 52 creates neither kind of row.
    // No canonical order is fixed - not for the children of a Core and not for the
    // Root IDs of a child. Root ID ascending, price order and a Candidate
    // comparator order are all equally undecided, and no comparator or sort is
    // added; head and tail exist only so a later helper can append locally.
    // The Candidate scalars of a plan are NOT here: no Side, stage, effective
    // bottom / top, reference price, cCount, hCount, density, baseStrong, broad,
    // FVG direction / count / Fresh / state, created time, minimum Root ID or psych
    // tick, because the full PendingTopology payload is not fixed in this Window's
    // source. Only the Root-copy container is built ahead.
    // Real children = 0, real Root-copy nodes = 0, no Root ID is written and both
    // free stacks are empty. The Batch 48 corePendingTopologyFlags stays false and
    // its relation to a Core's child count is not enforced at runtime here.
    // Not implemented: the child and node reset / alloc / free helpers, append,
    // detach, clear, duplicate prevention, ownership validation, the ActiveTouch
    // test, Merge and Split, the deferred plan's creation, refresh and apply, and
    // the Stage connection.
    // IMPORTANT for a later Batch: before any real plan is created, the child and
    // Root detach-clear must be connected ahead of coreResetSlotRaw and the Core
    // free path, so freeing a Core can never leave a child row or a Root node
    // behind.
    array<int>   corePendingTopologyChildHeadIndexes
    array<int>   corePendingTopologyChildTailIndexes
    array<int>   corePendingTopologyChildCounts

    array<int>   pendingTopologyChildNextIndexes
    array<int>   pendingTopologyChildOwnerCoreSlots
    array<int>   pendingTopologyChildExpectedCoreIds
    array<int>   pendingTopologyChildExpectedGenerationIds
    array<int>   pendingTopologyChildRootHeadNodeIndexes
    array<int>   pendingTopologyChildRootTailNodeIndexes
    array<int>   pendingTopologyChildRootCounts
    array<bool>  pendingTopologyChildLiveFlags
    array<int>   pendingTopologyChildFreeIndexes

    array<int>   pendingTopologyRootNodeRootIds
    array<int>   pendingTopologyRootNodeNextIndexes
    array<int>   pendingTopologyRootNodeOwnerChildIndexes
    array<int>   pendingTopologyRootNodeExpectedCoreIds
    array<int>   pendingTopologyRootNodeExpectedGenerationIds
    array<bool>  pendingTopologyRootNodeLiveFlags
    array<int>   pendingTopologyRootNodeFreeIndexes

// ============================================================
// W03 Batch 03 : Root mutation journal group / op codes (internal)
// Source: I8 Stage E (E1 .. E4)
// ============================================================
const int JGROUP_E1 = 1   // FVG structural invalidation
const int JGROUP_E2 = 2   // NEW_ROOT
const int JGROUP_E3 = 3   // Root update
const int JGROUP_E4 = 4   // ROOT_RETIRE

// Accum Confirmed uses JOP_NEW_ROOT; there is no Accum Candidate op.
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_MA_UPDATE      = 3
const int JOP_SWING_TF_MERGE = 4
const int JOP_TIMEHL_LABEL   = 5
const int JOP_FVG_FRESH_END  = 6
const int JOP_ROOT_RETIRE    = 7

// Swing detection TF mask (internal). Combined masks are the sum of distinct bits,
// e.g. 5m + 15m = 3, 5m + 15m + 1H = 7.
const int SWING_TF_MASK_NONE = 0
const int SWING_TF_MASK_5M   = 1
const int SWING_TF_MASK_15M  = 2
const int SWING_TF_MASK_1H   = 4

// W03 Batch 14 : Root subtype codes (internal, Q0 physical choice). FVG uses no
// subtype for identity and Psych is not materialized in W03, so neither has one.
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
const int SUB_SWING_HIGH   = 1
const int SUB_SWING_LOW    = 2
const int SUB_ACCUM_UPPER  = 1
const int SUB_ACCUM_LOWER  = 2
const int SUB_TIMEHL_HIGH  = 1
const int SUB_TIMEHL_LOW   = 2

// W03 Batch 16 : TimeHL period label bits (internal). A combined mask is 0 .. 63.
const int TIMEHL_LABEL_CUR_SESSION  = 1
const int TIMEHL_LABEL_LAST_SESSION = 2
const int TIMEHL_LABEL_TODAY        = 4
const int TIMEHL_LABEL_PREV_DAY     = 8
const int TIMEHL_LABEL_CUR_WEEK     = 16
const int TIMEHL_LABEL_PREV_WEEK    = 32

// ============================================================
// W05 Batch 01 : Candidate internal codes + tick limits
// Source: I12, A10.1, A10.2, D12, HANDOFF_W04 section 7
//
// Internal only, never exported. Each code equals the W04 Reference REF_* value of
// the same meaning one-to-one (REF_STAGE_*, REF_FVG_RANGE_*, REF_BROAD_LOCAL_*).
// No new Stage, FVG mode or Broad condition. Business call sites = 0 in this Batch.
// ============================================================

// Candidate Stage (REF_STAGE_*)
const int CAND_STAGE_A             = 0
const int CAND_STAGE_B             = 1
const int CAND_STAGE_C             = 2
const int CAND_STAGE_BROAD_CONTEXT = 3

// FVG Candidate EffectiveRange mode (REF_FVG_RANGE_*)
const int CAND_FVG_RANGE_NONE          = 0
const int CAND_FVG_RANGE_STANDALONE    = 1
const int CAND_FVG_RANGE_INSIDE        = 2
const int CAND_FVG_RANGE_PROXIMAL      = 3
const int CAND_FVG_RANGE_OVERLAP       = 4
const int CAND_FVG_RANGE_BROAD_CONTEXT = 5

// Broad FVG localization condition (REF_BROAD_LOCAL_*)
const int CAND_BROAD_LOCAL_C1 = 1
const int CAND_BROAD_LOCAL_C2 = 2
const int CAND_BROAD_LOCAL_C3 = 3
const int CAND_BROAD_LOCAL_C4 = 4

// Candidate width limits in ticks (A10.1, D12): [denseTick, mTick].
//   mTick     = round(clusterMaxWidth / mintick)
//   denseTick = round((clusterMaxWidth * denseRatio) / mintick)
// Inputs are already validated by Stage A: no validation, clamp or correction here.
candTickLimitsRaw(ZoneCfg cfg, float mintick) =>
    int mTick     = int(math.round(cfg.clusterMaxWidth / mintick))
    int denseTick = int(math.round((cfg.clusterMaxWidth * cfg.denseRatio) / mintick))
    [denseTick, mTick]

// ============================================================
// W03 Batch 02 : W03SourceRootStore - Engine-owned Source / Root scalar store
// Source: I7.1, I10, A7.4, A7.6, D02, D12
//
// One singleton held by ZoneEngine, independent of W02AuxStore. Exported only
// because ZoneEngine is exported and holds a field of this type; it is not a
// business API. It is not a per-Root, per-Core or per-Side object. Scalars only
// in this Batch: no array, no map, no nested collection, no Source history.
// A rootSlot is never an identity: every ref is rootSlot + expectedRootId and is
// valid only while the slot is live and rootIds[slot] == expectedRootId.
// Nothing reads or writes these fields yet; the type defaults are the sentinels.
// ============================================================

export type W03SourceRootStore
    // ---- lastConsumedSourceCloseTime per timeframe / event family (I7.1) ----
    int   lastConsumed15mSwingCloseTime          = na
    int   lastConsumed1hSwingCloseTime           = na
    int   lastConsumed1hAccumCloseTime           = na
    int   lastConsumed1hFvgFormationCloseTime    = na
    int   lastConsumed1hFvgStructuralCloseTime   = na
    int   lastConsumed4hAccumCloseTime           = na
    int   lastConsumed4hFvgFormationCloseTime    = na
    int   lastConsumed4hFvgStructuralCloseTime   = na
    int   lastConsumedDAccumCloseTime            = na
    int   lastConsumedDFvgFormationCloseTime     = na
    int   lastConsumedDFvgStructuralCloseTime    = na

    // ---- MA persistent Root refs and slope sign (1 / 0 / -1, na = unset) ----
    int   ema2000RootSlot                        = -1
    int   ema2000ExpectedRootId                  = 0
    int   ema2000SlopeDir                        = na
    int   ema3000RootSlot                        = -1
    int   ema3000ExpectedRootId                  = 0
    int   ema3000SlopeDir                        = na

    // ---- Accum Candidate Source state mirror. Never a Root, never ROOT_CANDIDATE ----
    bool  accum1hCandidateActive                 = false
    int   accum1hCandidateStartTime              = na
    float accum1hCandidateTop                    = na
    float accum1hCandidateBottom                 = na
    bool  accum4hCandidateActive                 = false
    int   accum4hCandidateStartTime              = na
    float accum4hCandidateTop                    = na
    float accum4hCandidateBottom                 = na
    bool  accumDCandidateActive                  = false
    int   accumDCandidateStartTime               = na
    float accumDCandidateTop                     = na
    float accumDCandidateBottom                  = na

    // ---- TimeHL period tracker. timeHlSessionKind 0 = unset / no current session ----
    int   timeHlSessionKind                      = 0
    int   timeHlSessionStartTime                 = na
    int   timeHlDayStartTime                     = na
    int   timeHlWeekStartTime                    = na

    // ---- TimeHL Root refs : 12 logical refs, each rootSlot + expectedRootId ----
    int   curSessionHighRootSlot                 = -1
    int   curSessionHighExpectedRootId           = 0
    int   curSessionLowRootSlot                  = -1
    int   curSessionLowExpectedRootId            = 0
    int   lastSessionHighRootSlot                = -1
    int   lastSessionHighExpectedRootId          = 0
    int   lastSessionLowRootSlot                 = -1
    int   lastSessionLowExpectedRootId           = 0
    int   todayHighRootSlot                      = -1
    int   todayHighExpectedRootId                = 0
    int   todayLowRootSlot                       = -1
    int   todayLowExpectedRootId                 = 0
    int   prevDayHighRootSlot                    = -1
    int   prevDayHighExpectedRootId              = 0
    int   prevDayLowRootSlot                     = -1
    int   prevDayLowExpectedRootId               = 0
    int   curWeekHighRootSlot                    = -1
    int   curWeekHighExpectedRootId              = 0
    int   curWeekLowRootSlot                     = -1
    int   curWeekLowExpectedRootId               = 0
    int   prevWeekHighRootSlot                   = -1
    int   prevWeekHighExpectedRootId             = 0
    int   prevWeekLowRootSlot                    = -1
    int   prevWeekLowExpectedRootId              = 0

    // ---- Accum pair sequence. 1-based, 0 = no pair, shared by Upper / Lower ----
    int   nextAccumPairKey                       = 1

    // ---- W03 Batch 03 : Root mutation journal meta ----
    // journalCount is the logical length of the current Base bar's journal;
    // journalInvariantViolation is the future preflight flag (nothing sets it yet).
    int   journalCount                           = 0
    int   journalBaseSeq                         = -1
    int   journalBaseCloseTime                   = na
    bool  journalInvariantViolation              = false

    // ---- W03 Batch 03 : Root mutation journal SoA (one row = one mutation) ----
    // Reuse pool: rows 0 .. journalCount - 1 are logically valid. All 23 arrays
    // share one physical size and are never cleared or shrunk.
    array<int>   journalOps
    array<int>   journalGroups
    array<int>   journalTargetRootSlots
    array<int>   journalExpectedRootIds
    array<int>   journalCategories
    array<int>   journalSubtypes
    array<int>   journalTfCodes
    array<int>   journalOriginKeys
    array<int>   journalOriginTimes
    array<int>   journalOriginEndTimes
    array<int>   journalConfirmedTimes
    array<float> journalPointPrices
    array<float> journalNativeBottoms
    array<float> journalNativeTops
    array<int>   journalOldStates
    array<int>   journalNewStates
    array<bool>  journalFvgFreshFlags
    array<bool>  journalIsBroadFlags
    array<int>   journalDirections
    array<int>   journalOldMasks
    array<int>   journalNewMasks
    array<int>   journalPairKeys
    array<int>   journalSlopeDirs

    // ---- W03 Batch 04 : Swing detection TF mask, Root-SoA-shaped ----
    // index = physical rootSlot, value = OR of SWING_TF_MASK_* (5m 1, 15m 2, 1H 4).
    // 0 for a non-Swing Root and for an unset, freed or reused slot. Its size always
    // equals size(rootIds): grown by rootAllocSlotRaw, reset by rootResetSlotRaw.
    array<int>   rootSwingTfMasks

    // ---- W05 Batch 02 : Candidate scratch storage (I12.1, I17.1) ----
    // Temporary Candidate-selection state only, one independent set per Side. Never a
    // Root identity or a persistent Root attribute, and never reused as Core, Side,
    // Snapshot, Touch or Generation storage. Not grown by the W03 Workers (their
    // interface is frozen): a later Batch grows these to size(rootIds) itself.
    // Scratch position by rootSlot : index = physical rootSlot, value = the logical
    // position in candidateScratch*NewRootSlots, SLOT_INVALID when unset / stale. Never
    // valid alone: pos >= 0, pos < candidateScratch*NewLength and
    // candidateScratch*NewRootSlots[pos] == rootSlot must all hold.
    array<int>   candidateSupportScratchPosByRootSlot
    array<int>   candidateResistanceScratchPosByRootSlot
    // Used by rootSlot : index = physical rootSlot, true while that Point Root or
    // non-Broad FVG is used by this Side's winner selection. A Broad FVG is never used.
    array<bool>  candidateSupportUsedByRootSlot
    array<bool>  candidateResistanceUsedByRootSlot
    // Eligible FVG scratch : physical rootSlots (never Root IDs), built rootId ASC by a
    // later Batch. Logical range 0 .. length - 1; reset by length = 0, never array.clear.
    array<int>   candidateSupportFvgRootSlots
    int          candidateSupportFvgLength               = 0
    array<int>   candidateResistanceFvgRootSlots
    int          candidateResistanceFvgLength            = 0

    // ---- W05 Batch 04 : Candidate window monotonic deques (I12.2) ----
    // Temporary, shared by both Sides (Stage G runs the Sides one after the other).
    // Values are indexes into the current Side's Point eligible scratch, never rootSlots,
    // Root IDs or times. The logical range head .. tail - 1 lives in the caller's
    // scalars; a new traversal resets head = tail = 0 and reuses the capacity. Never a
    // business identity, winner storage or Snapshot.
    array<int>   candidateWindowMinRootIdDequeScratchIndexes
    array<int>   candidateWindowMaxConfirmedTimeDequeScratchIndexes

export type ZoneEngine
    // ---- scalar : config validation (Batch 5 connects validateCfg results) ----
    bool  configValid            = false
    int   cfgErrorCode           = 0
    // Cfg fingerprint x2 (D10). na = not yet computed; real computation is Batch 5.
    int   cfgFingerprintA        = na
    int   cfgFingerprintB        = na

    // ---- scalar : last processed Base (D02, D07). Committed in Stage L ----
    int   lastBaseSeq            = -1
    int   lastBaseCloseTime      = na

    // ---- scalar : ID sequences (D02). 1-based, 0 = none, never reused ----
    int   nextRootId             = 1
    int   nextCoreId             = 1
    int   nextGenerationId       = 1

    // ---- scalar : storage prune diagnostics (A4.4). Persistent, never reset per Base bar ----
    bool  storagePruned          = false
    int   prunedRootCount        = 0
    int   prunedZoneCount        = 0
    bool  touchHistoryTruncated  = false

    // ---- scalar : current-bar Event logical length. Stage B reset is Batch 7 ----
    int   eventLogicalCount      = 0

    // ---- W02 Batch 50 : Engine-global EndedGeneration ring metadata (I17.2 / A6.9) ----
    // One ring for the whole Engine, not one per Core or per Side. head is the
    // physical index of the oldest entry, count the number of logical entries, and
    // logical entry i is at (head + i) % capacity, with capacity taken from
    // cfg.maxEndedGenerations - never a hard-coded 30. The seven payload arrays live
    // in W02AuxStore; these two are Engine-global scalar metadata and are never
    // faked as per-row arrays. Both stay 0 in this Batch: no append, overwrite or
    // read exists, so there are no entries.
    int   endedGenerationRingHead  = 0
    int   endedGenerationRingCount = 0

    // ---- W02 Batch 1 : scalar : revision state (I9). 17 independent revisions ----
    // Storage only. No increment, no invalidation wiring, no cache in this Batch.
    // Never merged into one dirty / topologyDirty flag (I9) and never the same thing
    // as cfgFingerprintA / cfgFingerprintB (D10).
    int   cfgRevision                       = 0
    int   rootRegistryRevision              = 0
    int   rootPriceRevision                 = 0
    int   rootEligibilityRevisionSupport    = 0
    int   rootEligibilityRevisionResistance = 0
    int   rootQualityRevision               = 0
    int   fvgStateRevision                  = 0
    int   fvgFreshRevision                  = 0
    int   priceOrderRevision                = 0
    int   candidateRevisionSupport          = 0
    int   candidateRevisionResistance       = 0
    int   coreTopologyRevision              = 0
    int   coreRangeRevision                 = 0
    int   sideStateRevision                 = 0
    int   snapshotRevision                  = 0
    int   pendingRevision                   = 0
    int   presentationRevision              = 0

    // ---- Root SoA (A6.2), index = rootSlot ----
    array<int>   rootIds
    array<int>   rootOriginKeys
    array<int>   rootCategories
    array<int>   rootSubtypes
    array<int>   rootTfCodes
    array<int>   rootOriginTimes
    array<int>   rootOriginEndTimes
    array<int>   rootConfirmedTimes
    array<float> rootPointPrices
    array<float> rootNativeBottoms
    array<float> rootNativeTops
    array<bool>  rootIsRangeRootFlags
    array<bool>  rootIsDynamicFlags
    array<int>   rootStates
    array<int>   rootPairKeys
    array<int>   rootDirections
    array<bool>  rootFvgFreshFlags
    array<bool>  rootIsBroadFvgFlags
    array<int>   rootLabelMasks
    array<int>   rootLastUpdateSeqs
    // tick-normalised comparison values kept beside the original float prices (I6.4)
    array<int>   rootPointTicks
    array<int>   rootNativeBottomTicks
    array<int>   rootNativeTopTicks

    // ---- W02 Batch 1 : Root physical slot lifecycle (I6.2, I17.1) ----
    // rootSlotLiveFlags : index = rootSlot. true = a Live Root currently owns this
    //   physical slot, false = unused or free slot. Physical slot life is a different
    //   concept from the A6.2 Root state: ROOT_RETIRED is never treated as slot dead.
    // rootFreeSlots     : LIFO free stack holding freed rootSlots only. Future alloc
    //   pops, future free pushes. array.remove(0) / array.unshift() are never used.
    // rootLiveSlots     : physical rootSlot set of currently Live Roots. Not price
    //   order, not Root ID order, not Candidate tie-break order, not a public order;
    //   each Live rootSlot appears at most once.
    // rootIdOrderSlots  : rootSlots (not rootIds) of Live Roots in Root ID ascending
    //   order. Separate array from the price order (I6.2).
    // Ownership token for a Root slot is rootIds[rootSlot] itself: no separate owner
    // token array is introduced. A stale-capable reference keeps rootSlot +
    // expectedRootId and is valid only when the slot is in range, rootSlotLiveFlags
    // is true and rootIds[rootSlot] == expectedRootId.
    // Batch 1 adds the storage only: no alloc / free / reset / validation helper.
    array<bool>  rootSlotLiveFlags
    array<int>   rootFreeSlots
    array<int>   rootLiveSlots
    array<int>   rootIdOrderSlots
    // W02 Batch 4 : I11-1 Root ID -> rootSlot. Live keys only: a freed Root ID is
    // removed from the map, ID_NONE is never a key, and one rootId never maps to
    // two slots. A map hit alone is not ownership proof (see the Batch 2 helpers).
    map<int, int> rootIdToSlot

    // ---- W02 Batch 32 : live Root common price-order foundation (I11-3 / I6.2) ----
    // Physical container only. rootPriceOrderSlots is the single canonical order
    // array of live Roots and holds physical rootSlot values and nothing else: no
    // rootId, no price, no tick, no originKey and no public Root index is ever
    // copied into it. rootPriceOrderPositions is its I6.2 reverse map, indexed by
    // physical rootSlot, whose value is that Root's position inside
    // rootPriceOrderSlots; SLOT_INVALID means the Root is not in the order.
    // One common order serves both Sides (I11): Support and Resistance never get
    // their own duplicated Root order and will later read this one through a filter.
    // Real membership in this Batch = 0: rootPriceOrderSlots stays size 0 and every
    // rootPriceOrderPositions entry stays SLOT_INVALID.
    // Not implemented here, and deliberately not decided here: the canonical sort
    // key (no price source among pointPrice, nativeBottom, nativeTop, midpoint,
    // proximal or distal is chosen), the stable tie-break comparison order, any
    // comparator, binary search / lower_bound / upper_bound, local insert, detach,
    // reinsert, full sort and the Root free connection.
    // This is a maintained order, not a per-bar rebuild buffer: it is never cleared
    // and re-sorted from scratch on every bar.
    array<int>   rootPriceOrderSlots
    array<int>   rootPriceOrderPositions

    // ---- W02 Batch 15 : Root Category / TF / state set index storage (I11-4) ----
    // Search index foundation for the Category, timeframe and Root state sets: six
    // independent sets per dimension, one per existing enum value (no new Category,
    // TF code or state is introduced). Every element is a physical rootSlot, never a
    // rootId, originKey, category / tf / state code, price or public Root index.
    // rootCategorySetPositions / rootTfSetPositions / rootStateSetPositions are
    // indexed by rootSlot and hold that Root's position inside the set it currently
    // belongs to in that dimension, SLOT_INVALID when it belongs to none, which is
    // what later makes a detach an O(1) swap-pop.
    // The sets carry no order semantics: never a Root ID, price, Candidate
    // tie-break, public Root, prune or Event order, and nothing is sorted.
    // engine.rootCategories / rootTfCodes / rootStates stay the logical source of
    // truth; these sets are an index and never write back into those fields. Once
    // connected, a registered Root owning a slot belongs to exactly one set per
    // dimension, never to two and never twice to the same one.
    // ROOT_RETIRED is a Root state, not a physical free slot: a Retired Root that
    // still owns its slot stays in the Retired set. Conversely a slot fresh out of
    // rootAllocSlotRaw has no Root content yet (category and tfCode are na even
    // though rootStates holds the ROOT_CANDIDATE sentinel), so it holds no
    // membership in any dimension; membership is established atomically for all
    // three dimensions by the later Root content registration path.
    // Batch 15 added this storage; Batch 16 connected the three reverse-position
    // arrays to the Root physical slot growth / reset lifecycle; Batch 17 added the
    // validation, add-all and detach-all raw helpers. Real membership is still 0
    // entries and their call sites = 0: Root content registration, Root state
    // transition and the detach on free come later.
    array<int>   categoryMaRootSlots
    array<int>   categorySwingRootSlots
    array<int>   categoryAccumRootSlots
    array<int>   categoryTimeHlRootSlots
    array<int>   categoryFvgRootSlots
    array<int>   categoryPsychRootSlots

    array<int>   tf1mRootSlots
    array<int>   tf5mRootSlots
    array<int>   tf15mRootSlots
    array<int>   tf1hRootSlots
    array<int>   tf4hRootSlots
    array<int>   tfDRootSlots

    array<int>   stateCandidateRootSlots
    array<int>   stateActiveRootSlots
    array<int>   stateInvalidatedRootSlots
    array<int>   stateInverseWaitRootSlots
    array<int>   stateInverseActiveRootSlots
    array<int>   stateRetiredRootSlots

    array<int>   rootCategorySetPositions
    array<int>   rootTfSetPositions
    array<int>   rootStateSetPositions

    // ---- W02 Batch 18 : Accum pair upper / lower Root index storage (I11-5) ----
    // Foundation for pairKey -> upper boundary Root and pairKey -> lower boundary
    // Root. The key is the existing engine.rootPairKeys value of the Accum boundary
    // Roots: no pair identity key is invented here, nothing is re-hashed, and an
    // originKey, a Root ID combination, a price or a string is never used as the
    // key. The value is a physical rootSlot, never a rootId (read rootIds[rootSlot]
    // when the ID is needed) and never a public Root index.
    // Upper and lower live in two separate maps, at most one entry each per pairKey,
    // so a pair whose second boundary is not registered yet is representable; pair
    // completeness is not decided here.
    // The index carries no order semantics: never a Root ID, price, Candidate,
    // prune, Event or public Root order. Only Accum Roots ever enter it, and
    // pairKey ID_NONE is never registered.
    // Which boundary is upper and which is lower is decided by the later Accum
    // registration path from the spec's boundary identity; this Batch depends on no
    // numeric subtype mapping.
    // Batch 18 adds the storage only: both maps stay empty (no map.put / map.remove
    // anywhere), no helper exists and nothing is connected (call sites = 0).
    // Registration, validation, detach, Root free and prune come later. The logical
    // source of truth stays the Root SoA (rootCategories, rootSubtypes,
    // rootPairKeys, rootIds, rootSlotLiveFlags); this index never writes back to it.
    map<int, int> accumPairUpperRootSlotByKey
    map<int, int> accumPairLowerRootSlotByKey

    // ---- W02 Batch 19 : FVG non-price set index storage (I11-6 / I14) ----
    // Foundation for the non-price FVG sets. The FVG Source timeframes are exactly
    // TF_1H, TF_4H and TF_D, so Fresh and structurally active have three sets each
    // and no 1m / 5m / 15m FVG set exists.
    // Every element is a physical rootSlot, never a rootId, originKey, public Root
    // index, tfCode, direction code or price.
    // Four independent dimensions, each with its own reverse lookup indexed by
    // rootSlot (SLOT_INVALID while the Root belongs to no set of that dimension):
    //   Fresh            -> freshFvg1h / 4h / D              : rootFvgFreshSetPositions
    //   Structural state -> structurallyActiveFvg1h / 4h / D,
    //                       inverseWaitFvg, inverseActiveFvg  : rootFvgStructuralStateSetPositions
    //   Direction        -> bullishFvg, bearishFvg           : rootFvgDirectionSetPositions
    //   Broad            -> broadFvg                         : rootFvgBroadSetPositions
    // Inside one dimension a Root belongs to at most one set; across dimensions it
    // may belong to one set of each (a Bullish, 1H Fresh, 1H structurally active,
    // Broad FVG is legal). FVG_NONE joins no direction set, and a Root whose
    // isBroadFvg is false stays SLOT_INVALID in the Broad dimension.
    // The sets carry no order semantics, so a later detach can be a swap-pop.
    // The logical source of truth stays the Root SoA (rootFvgFreshFlags,
    // rootTfCodes, rootStates, rootDirections, rootIsBroadFvgFlags); this index is
    // never written back into those fields.
    // W02 Batch 35 : inverseWaitFvgRootSlots has a second role. It is the I11-6
    // structural-state set of the InverseWait FVGs, and it is at the same time the
    // state component of the I11-11 Inverse-wait threshold foundation, paired with
    // rootFvgStructuralStateSetPositions as its reverse lookup. The price component
    // of that foundation is not duplicated here: it is the shared Batch 21
    // NativeRange bottom / top price index below, whose comparison source is the
    // existing rootNativeBottomTicks / rootNativeTopTicks. No Inverse-specific
    // price order exists and none may be added, so one Root is never maintained in
    // two parallel price orders. inverseActiveFvgRootSlots keeps its I11-6 role
    // unchanged. Real membership and the lifecycle logic that would decide it
    // (InverseWait entry and exit, Invalidated, InverseActive) are still
    // unconnected, and the departure-threshold rule is not fixed here.
    // Batch 19 adds the storage only: all eleven sets stay empty, membership is 0
    // entries, no helper exists and call sites = 0. The physical slot growth /
    // reset connection, FVG creation, structural invalidation, the Fresh, Inverse
    // and direction lifecycles and the Broad decision come later, and the
    // NativeRange interval index (fvgNativeRangeIntervalIndex) is a separate later
    // Batch: no price sort, binary search or interval query is added here.
    array<int>   freshFvg1hRootSlots
    array<int>   freshFvg4hRootSlots
    array<int>   freshFvgDRootSlots

    array<int>   structurallyActiveFvg1hRootSlots
    array<int>   structurallyActiveFvg4hRootSlots
    array<int>   structurallyActiveFvgDRootSlots

    array<int>   inverseWaitFvgRootSlots
    array<int>   inverseActiveFvgRootSlots

    array<int>   bullishFvgRootSlots
    array<int>   bearishFvgRootSlots

    array<int>   broadFvgRootSlots

    array<int>   rootFvgFreshSetPositions
    array<int>   rootFvgStructuralStateSetPositions
    array<int>   rootFvgDirectionSetPositions
    array<int>   rootFvgBroadSetPositions

    // ---- W02 Batch 21 : FVG NativeRange interval index storage (I11-6 / I14) ----
    // Foundation for fvgNativeRangeIntervalIndex, the price side of the FVG index.
    // Two independent orders, one over the NativeRange bottoms and one over the
    // NativeRange tops, each with its own reverse lookup:
    //   fvgNativeBottomOrderRootSlots    <-> rootFvgNativeBottomOrderPositions
    //   fvgNativeTopOrderRootSlots       <-> rootFvgNativeTopOrderPositions
    // Every order element is a physical rootSlot: no rootId, public Root index,
    // originKey, NativeBottom / NativeTop price and no tick value is ever copied
    // into this index. The comparison source stays the existing tick SoA
    // (rootNativeBottomTicks, rootNativeTopTicks), while rootNativeBottoms /
    // rootNativeTops remain the logical and output prices.
    // A reverse lookup is indexed by rootSlot and holds that Root's position in the
    // corresponding order, SLOT_INVALID while it is in neither.
    // Only CAT_FVG Roots will ever enter this index, but no Category test exists
    // yet, and how the FVG structural state (Active, Invalidated, InverseWait,
    // InverseActive) governs entering or leaving it is deliberately not decided
    // here: that lifecycle is fixed later and is not guessed.
    // Batch 21 added this storage and Batch 22 connected the two reverse-position
    // arrays to the Root physical slot growth / reset lifecycle. Both order arrays
    // themselves stay empty: order membership is 0 entries and their call sites = 0.
    // W02 Batch 35 : these two orders are shared. They are the price side of the
    // I11-6 FVG interval index and, without being duplicated, the price component
    // of the I11-11 Inverse-wait threshold foundation as well. The InverseWait
    // filtering never happens inside them: it is done on the state side, through
    // inverseWaitFvgRootSlots (Batch 19) with rootStates as the logical source of
    // truth. No Inverse-specific price order is added, so the same rootSlot is
    // never maintained in a second parallel order. Still unimplemented for that
    // role as well: the departure-threshold predicate (no NativeBottom /
    // NativeTop offset, touchResetDistance or breakBuffer formula is fixed here),
    // the Bullish / Bearish direction tests, the interval query, binary search and
    // the membership maintenance.
    // Still missing, deliberately: order maintenance (insert, detach, reinsert),
    // the stable tie-break for equal ticks, binary search, interval query, Fresh and
    // Candidate lookup, and the FVG lifecycle rule that decides membership.
    array<int>   fvgNativeBottomOrderRootSlots
    array<int>   fvgNativeTopOrderRootSlots
    array<int>   rootFvgNativeBottomOrderPositions
    array<int>   rootFvgNativeTopOrderPositions

    // ---- W02 Batch 23 : Root participation adjacency storage (I11-7) ----
    // Foundation for rootSlot -> participating Core / Side. The relation is
    // many-to-many (one Root may take part in several Cores and in both Sides, and
    // one Core / Side has several Roots), so it is stored as a flat adjacency edge
    // pool - never a nested collection: no array<array<int>>, no
    // map<int, array<int>> and no map of maps.
    //   rootParticipationHeadEdgeIndexes : index = rootSlot, first edge index of
    //     that Root's chain, SLOT_INVALID while it takes part in nothing.
    //   rootParticipationCounts          : index = rootSlot, number of live edges
    //     of that Root, 0 while it takes part in nothing.
    //   participationEdgeRootSlots       : the edge's physical rootSlot (not a
    //     rootId and not a public Root index).
    //   participationEdgeExpectedRootIds : the Root ID that owned the slot when the
    //     edge was made.
    //   participationEdgeSideSlots       : the edge's physical sideSlot
    //     (= coreSlot * 2 + sideIndex, 0 = Support, 1 = Resistance). The
    //     SIDE_SUPPORT / SIDE_RESISTANCE codes are never stored here: this is a
    //     flattened Side address.
    //   participationEdgeExpectedCoreIds : the Core ID that owned that slot when
    //     the edge was made.
    //   participationEdgeNextByRootIndexes : next edge of the same Root,
    //     SLOT_INVALID at the end of the chain.
    //   participationEdgeLiveFlags       : index = edge index, true while the row
    //     is live, false while it is unused or free.
    //   participationEdgeFreeIndexes     : LIFO free stack of released edge rows,
    //     reused later with array.pop; array.remove(0) / array.shift() /
    //     array.unshift() are never used.
    // The two expected IDs exist because slots are reused: a rootSlot or a sideSlot
    // alone is never proof of an edge's identity. No Generation ID is stored - this
    // is a participation index, not a generation history - and one live edge per
    // (Root ID, Core ID, Side) is the later contract, with no duplicate check yet.
    // The edge chain carries no order semantics: it is never read as a Candidate
    // comparator, Root ID, Core ID, View, Event, Merge / Split or price order.
    // This storage is neither the A6.7 list of currently valid Root IDs of a Side
    // View nor the A6.8 Zone origin Root set; neither is replaced by it.
    // Implemented so far: this storage (Batch 23), the Root head / count lifecycle
    // on physical slot growth and reset (Batch 24), the edge row physical lifecycle
    // (Batch 25), the chain validation, duplicate prevention and atomic add
    // (Batch 26), the atomic single detach (Batch 27), the atomic detach-all for one
    // Root (Batch 28), the Root free lifecycle connection (Batch 29), the atomic
    // detach-all for one Core (Batch 30) and the Core free lifecycle connection
    // (Batch 31).
    // Still missing, deliberately: Candidate adoption and Core association. No
    // Production business path calls any of it, so the runtime holds 0 edges.
    array<int>   rootParticipationHeadEdgeIndexes
    array<int>   rootParticipationCounts
    array<int>   participationEdgeRootSlots
    array<int>   participationEdgeExpectedRootIds
    array<int>   participationEdgeSideSlots
    array<int>   participationEdgeExpectedCoreIds
    array<int>   participationEdgeNextByRootIndexes
    array<bool>  participationEdgeLiveFlags
    array<int>   participationEdgeFreeIndexes

    // ---- Core SoA (A6.8), index = coreSlot ----
    array<int>   coreIds
    array<int>   coreGenerationIds
    array<bool>  coreZoneFreshFlags
    array<float> corePhysicalBottoms
    array<float> corePhysicalTops
    array<int>   coreCreatedTimes
    array<int>   coreLastSeenTimes
    array<bool>  coreDormantFlags

    // ---- W02 Batch 1 : Core physical slot lifecycle (I6.3, I17.1) ----
    // coreSlotLiveFlags : index = coreSlot. true = a Live or Dormant ZoneCore owns
    //   this physical slot. Separate from coreDormantFlags: a Dormant Core keeps
    //   coreSlotLiveFlags = true with coreDormantFlags = true and is never treated
    //   as a free slot.
    // coreFreeSlots     : LIFO free stack holding freed coreSlots only. Future alloc
    //   pops, future free pushes. array.remove(0) / array.unshift() are never used.
    // coreLiveSlots     : physical coreSlot set of the held Live / Dormant Cores.
    //   One physical Core = one coreSlot; Support and Resistance are never registered
    //   as separate Cores and keep using the flattened Side SoA. This order is not
    //   used as the public View order or a Merge / Split tie-break order.
    // Ownership token for a Core slot is coreIds[coreSlot] itself: no separate owner
    // token array. A stale-capable reference keeps coreSlot + expectedCoreId and is
    // valid only when the slot is in range, coreSlotLiveFlags is true and
    // coreIds[coreSlot] == expectedCoreId. Side ownership is identified by
    // coreId + sideIndex, with no separate Side token. The Generation ID is the Zone
    // generation's logical identity and is never used as the slot ownership token.
    // Batch 1 adds the storage only: no alloc / free / reset / validation helper.
    array<bool>  coreSlotLiveFlags
    array<int>   coreFreeSlots
    array<int>   coreLiveSlots
    // W02 Batch 6 : coreIdOrderSlots : physical coreSlots (not coreIds) of the held
    //   Live / Dormant Cores in Core ID ascending order, at most one entry per
    //   coreSlot and never one entry per Side. This is the foundation of the future
    //   Public View order; it is not a price, Merge / Split, Phase or prune order.
    //   Maintained by coreAllocSlotRaw / coreFreeSlotRaw, never by the raw reset.
    array<int>   coreIdOrderSlots
    // W02 Batch 4 : I11-8 Core ID -> coreSlot. Keys are the Core IDs whose slot is
    // currently owned, Dormant Cores included: only a free removes a key. ID_NONE is
    // never a key, and Support / Resistance never get separate keys.
    map<int, int> coreIdToSlot

    // ---- W02 Batch 10 : TouchMark ring storage (I17.2) ----
    // A TouchMark keeps the 8 logical fields of A6.4 only: baseSeq, time, side,
    // contactBottom, contactTop, closeAtTouch, generationId, isNormalTouch. The
    // owner / head / count values below are physical ring metadata, not TouchMark
    // fields, and no TouchMark UDT or array<TouchMark> is ever created.
    // Layout: one fixed-length block per Core, flattened into Engine-wide SoA.
    //   blockBase     = coreSlot * touchMarkCapacityPerCore
    //   physicalIndex = blockBase + ringOffset, 0 <= ringOffset < capacity
    // touchMarkCapacityPerCore is a physical addressing snapshot of the capacity
    // source cfg.maxTouchMarksPerCore (no new constant, no 64 fallback, no clamp
    // and no new validation); newEngine() copies it and updateConfirmed5m never
    // changes it. Rebuilding blocks after a Cfg change is a later Batch.
    // touchMarkRingOwnerCoreIds : index = coreSlot, the Core ID owning the block
    //   right now, ID_NONE when unowned or free. It is a Core ID, never a
    //   Generation ID, and a reused slot must not keep the old Core ID.
    // touchMarkRingHeads : index = coreSlot, ring offset of the OLDEST logical
    //   TouchMark; 0 while empty and while the capacity is 0.
    // touchMarkRingCounts : index = coreSlot, number of logically valid TouchMarks;
    //   0 while empty, and later never above the capacity.
    // Logical chronology is read from the head - offset = (head + logicalIndex) %
    // capacity - and the physical ring order is never used as the public order, the
    // Merge / Split order or the Event order (I17.2).
    // Batch 10 adds the storage schema only: the flattened arrays stay empty, no
    // block is allocated and no helper exists. Block allocation on Core slot
    // creation and the ownership / metadata reset on reuse are Batch 11.
    int          touchMarkCapacityPerCore = 0
    array<int>   touchMarkRingOwnerCoreIds
    array<int>   touchMarkRingHeads
    array<int>   touchMarkRingCounts
    array<int>   touchMarkBaseSeqs
    array<int>   touchMarkTimes
    array<int>   touchMarkSides
    array<float> touchMarkContactBottoms
    array<float> touchMarkContactTops
    array<float> touchMarkCloseAtTouches
    array<int>   touchMarkGenerationIds
    array<bool>  touchMarkIsNormalTouchFlags

    // ---- Side SoA (A6.3 SideHistory), index = sideSlot = coreSlot * 2 + sideIndex ----
    array<int>   sideTouchCounts
    array<bool>  sideWeakByTouchFlags
    array<bool>  sideWeakByDepthFlags
    array<float> sideMaxDepthPcts
    array<bool>  sideFreshFlags
    array<int>   sidePhases
    array<int>   sideGrades
    array<int>   sideCurrentTouchNos
    array<int>   sideUpcomingTouchNos
    array<int>   sideArmedFromSeqs
    array<float> sideLastArmedRangeBottoms
    array<float> sideLastArmedRangeTops
    array<int>   sideLastNormalTouchTimes
    array<int>   sideFlipAttemptCounts
    array<int>   sideInverseAttemptCounts
    array<int>   sideLastFlipConfirmSeqs

    // ---- Side SoA (A6.7 SideViewState scalars), same sideSlot index ----
    array<float> sideEffectiveBottoms
    array<float> sideEffectiveTops
    array<float> sideReferencePrices
    array<int>   sideCCounts
    array<int>   sideHCounts
    array<int>   sideDensities
    array<bool>  sideBaseStrongFlags
    array<bool>  sideHasNonPsychRootFlags
    array<bool>  sideIsBroadContextFlags
    array<bool>  sideEligibleFlags

    // ---- W02 Batch 13 : Side Phase set index storage (I11-9) ----
    // Search index foundation for the Phase sets. One independent set per Phase
    // enum (Waiting, Armed, ActiveTouch, Broken, FlipWait, Dormant); every element
    // is a physical sideSlot (= coreSlot * 2 + sideIndex, 0 = Support,
    // 1 = Resistance) and never a coreSlot, Core ID, Generation ID or public View
    // index.
    // sidePhaseSetPositions : index = physical sideSlot, value = that Side's
    // position inside the Phase set it currently belongs to, SLOT_INVALID when it
    // belongs to none. It is the reverse lookup that later makes a detach O(1) via
    // swap-pop.
    // The sets carry no order semantics: they are never read as the public View,
    // Core ID, Generation, Merge / Split, Event or price order, and anything
    // extracted from them is put back into the canonical order by its caller.
    // engine.sidePhases stays the logical source of truth; these sets are only an
    // index, and a later transition updates the Phase field and the membership
    // together.
    // Batch 13 adds the storage only: the arrays stay empty, no membership exists,
    // no helper is created and nothing is connected (call sites = 0). Side slot
    // growth, ownership start, free / reset and Phase transitions come later.
    array<int>   phaseWaitingSideSlots
    array<int>   phaseArmedSideSlots
    array<int>   phaseActiveTouchSideSlots
    array<int>   phaseBrokenSideSlots
    array<int>   phaseFlipWaitSideSlots
    array<int>   phaseDormantSideSlots
    array<int>   sidePhaseSetPositions

    // ---- W02 Batch 33 : Armed / Dormant state price-index foundations (I11-10 / I11-12) ----
    // Physical containers only. The source does not fix a physical representation
    // for either index, so Batch 33 fixes one: each price index is a bottom order
    // plus a top order, each with its own reverse-position array.
    // The four order arrays hold physical sideSlot values (= coreSlot * 2 +
    // sideIndex, 0 = Support, 1 = Resistance) and nothing else: no price, no tick,
    // no coreSlot, no Core ID, no Generation ID and no public View index is ever
    // copied into them.
    // The four reverse-position arrays are indexed by physical sideSlot and hold
    // that Side's position inside the matching order array; SLOT_INVALID means the
    // Side is in no order. Their size always equals size(sidePhases), that is
    // size(coreIds) * 2.
    // I11-10 (armed*) is the Armed View EffectiveRange index: its future price
    // source is the existing sideEffectiveBottoms / sideEffectiveTops, which are
    // neither read nor compared here, and no new price field is introduced.
    // I11-12 (dormantRecovery*) is the Dormant recovery-band index. The recovery
    // range formula is deliberately NOT decided here: no combination of
    // corePhysicalBottom / corePhysicalTop, sideEffectiveBottom / sideEffectiveTop
    // or referencePrice with dormantDistance is fixed as canonical.
    // These are independent of the I11-9 Phase sets above: a Side being PH_ARMED or
    // PH_DORMANT never adds it here automatically, and the Phase helpers are not
    // changed by this Batch.
    // The orders carry no other semantics: they are never read as the public View,
    // Core ID, Generation, Event, Merge / Split or Candidate comparator order, and
    // their enumeration order is never used directly as an Event order.
    // Real membership in this Batch = 0: all four order arrays stay size 0 and every
    // reverse position stays SLOT_INVALID. Not implemented here: the price
    // comparison, the stable tie-break, any comparator, binary search /
    // lower_bound / upper_bound, local insert, detach, reinsert, full sort,
    // per-bar rebuild and the Core free connection.
    array<int>   armedEffectiveBottomOrderSideSlots
    array<int>   armedEffectiveTopOrderSideSlots
    array<int>   sideArmedEffectiveBottomOrderPositions
    array<int>   sideArmedEffectiveTopOrderPositions
    array<int>   dormantRecoveryBottomOrderSideSlots
    array<int>   dormantRecoveryTopOrderSideSlots
    array<int>   sideDormantRecoveryBottomOrderPositions
    array<int>   sideDormantRecoveryTopOrderPositions

    // ---- W02 Batch 34 : Broken / Flip frozen-snapshot price-index foundations (I11-11) ----
    // Physical containers only, and the same shape Batch 33 fixed: the source does
    // not fix a physical representation for I11-11, so Batch 34 fixes one per state
    // - a bottom order and a top order, each with its own reverse-position array.
    // broken* is the PH_BROKEN index over the frozen BreakSnapshot range, ordered by
    // its bottom and by its top. flip* is the same for PH_FLIP_WAIT over the frozen
    // BreakSnapshot range that Side corresponds to.
    // The four order arrays hold physical sideSlot values only: no price, no tick,
    // no coreSlot, no Core ID, no Generation ID and no public View index is ever
    // copied into them. The four reverse-position arrays are indexed by physical
    // sideSlot and hold that Side's position inside the matching order;
    // SLOT_INVALID means the Side is in no order. Their size always equals
    // size(sidePhases), that is size(coreIds) * 2.
    // Reclaim gets no order of its own: a future Reclaim test reads the frozen
    // BreakSnapshot range of a PH_BROKEN Side, so the broken* index above is its
    // foundation. No Reclaim predicate, Event or transition exists yet.
    // Which physical Side's BreakSnapshot a PH_FLIP_WAIT Side corresponds to is
    // deliberately NOT decided here: same Side, opposite Side, Core owner and
    // Generation owner are all still open and no owner-resolution helper exists.
    // The BreakSnapshot body itself is not introduced either: no valid, coreId,
    // generationId, oldSide, rangeBottom, rangeTop, Root ID copy, breakSeq,
    // breakTime, wasGapBreak, movedAway or retestSeen field is added.
    // These are independent of the I11-9 Phase sets: entering PH_BROKEN or
    // PH_FLIP_WAIT never registers a Side here, and the Phase helpers are unchanged.
    // The orders carry no other semantics: never the public View, Core ID,
    // Generation, Event, Merge / Split or Candidate comparator order.
    // Real membership in this Batch = 0: all four order arrays stay size 0 and every
    // reverse position stays SLOT_INVALID. Not implemented here: the price
    // comparison, the stable tie-break, any comparator, binary search /
    // lower_bound / upper_bound, local insert, detach, reinsert, full sort, per-bar
    // rebuild and the Core free connection.
    // W02 Batch 35 completes the I11-11 physical foundation, in two parts. The
    // Break and Flip side is this Batch 34 frozen-BreakSnapshot index, which the
    // Reclaim side shares rather than duplicating. The Inverse-wait side is a
    // composition of existing storage and adds nothing new: the Batch 19
    // InverseWait structural-state set (inverseWaitFvgRootSlots with
    // rootFvgStructuralStateSetPositions) as its state component, and the Batch 21
    // FVG NativeRange bottom / top price index (with its reverse positions and the
    // rootNativeBottomTicks / rootNativeTopTicks comparison source) as its price
    // component. No Inverse-specific Root price order exists here or anywhere else.
    array<int>   brokenSnapshotBottomOrderSideSlots
    array<int>   brokenSnapshotTopOrderSideSlots
    array<int>   sideBrokenSnapshotBottomOrderPositions
    array<int>   sideBrokenSnapshotTopOrderPositions
    array<int>   flipSnapshotBottomOrderSideSlots
    array<int>   flipSnapshotTopOrderSideSlots
    array<int>   sideFlipSnapshotBottomOrderPositions
    array<int>   sideFlipSnapshotTopOrderPositions

    // ---- W02 Batch 36 : Root prune priority-queue foundation (I11-13 / I17.3) ----
    // The seventeen arrays of this foundation live in the W02AuxStore singleton
    // above, reached as engine.w02Aux.<field>. Batch 36R moved them there without
    // renaming, retyping or changing the meaning of a single one: Pine counts every
    // collection field of an exported type as an external element of its generated
    // constructor, and ZoneEngine.new had crossed the 254 limit (CE10116). This is
    // a physical grouping only - the store is an Engine-owned singleton of parallel
    // arrays, never a per-Root, per-Core or per-Side object registry.
    W02AuxStore  w02Aux
    // W03 Batch 02 : Engine-owned singleton scalar store, independent of w02Aux.
    W03SourceRootStore w03Store

    // ---- W02 Batch 9 : Candidate reusable scratch (I17.1) ----
    // Engine-owned scratch for Candidate evaluation. Four independent regions -
    // Support old structure, Support new structure, Resistance old structure,
    // Resistance new structure - so the areas needed at the same time never share
    // an array; none of the four is ever aliased to another.
    // Each region is one array<int> holding physical rootSlots (not rootIds, since
    // the Candidate hot path reads the Root SoA directly) plus its logical length.
    // The array keeps its physical capacity: a future reuse resets the region by
    // setting its logical length to 0 and overwriting entries, never with
    // array.clear() or a fresh array.new (I17.1). Only indices 0 .. length - 1 are
    // logically valid.
    // An adopted Candidate / Core / Side / Snapshot Root set is never stored here
    // and never holds a reference to a scratch array: a winner copies what it needs
    // into independently owned storage.
    // Batch 9 adds the storage only: no reset / append / read helper, no Candidate
    // evaluation, and no data is written yet (call sites = 0).
    array<int>   candidateScratchSupportOldRootSlots
    int          candidateScratchSupportOldLength       = 0
    array<int>   candidateScratchSupportNewRootSlots
    int          candidateScratchSupportNewLength       = 0
    array<int>   candidateScratchResistanceOldRootSlots
    int          candidateScratchResistanceOldLength    = 0
    array<int>   candidateScratchResistanceNewRootSlots
    int          candidateScratchResistanceNewLength    = 0

    // ---- current-bar Event SoA (I5, ZoneEvent contract) ----
    array<int>   eventTypes
    array<int>   eventTimes
    array<int>   eventBaseSeqs
    array<int>   eventCoreIds
    array<int>   eventGenerationIds
    array<int>   eventSides
    array<float> eventRangeBottoms
    array<float> eventRangeTops
    array<int>   eventTouchNos
    array<int>   eventGradeAtStarts
    array<int>   eventWeakReasons
    array<int>   eventRootIds

// Factory (A6.9). Always returns a ZoneEngine object, even for an invalid cfg (D05):
// configValid stays false until Batch 5 connects validateCfg(). No validation here.
export newEngine(ZoneCfg cfg) =>
    ZoneEngine e = ZoneEngine.new()

    // W02 Batch 50 : the Engine-global EndedGeneration ring starts empty (I17.2).
    e.endedGenerationRingHead   := 0
    e.endedGenerationRingCount  := 0

    e.rootIds                   := array.new_int(0)
    e.rootOriginKeys            := array.new_int(0)
    e.rootCategories            := array.new_int(0)
    e.rootSubtypes              := array.new_int(0)
    e.rootTfCodes               := array.new_int(0)
    e.rootOriginTimes           := array.new_int(0)
    e.rootOriginEndTimes        := array.new_int(0)
    e.rootConfirmedTimes        := array.new_int(0)
    e.rootPointPrices           := array.new_float(0)
    e.rootNativeBottoms         := array.new_float(0)
    e.rootNativeTops            := array.new_float(0)
    e.rootIsRangeRootFlags      := array.new_bool(0)
    e.rootIsDynamicFlags        := array.new_bool(0)
    e.rootStates                := array.new_int(0)
    e.rootPairKeys              := array.new_int(0)
    e.rootDirections            := array.new_int(0)
    e.rootFvgFreshFlags         := array.new_bool(0)
    e.rootIsBroadFvgFlags       := array.new_bool(0)
    e.rootLabelMasks            := array.new_int(0)
    e.rootLastUpdateSeqs        := array.new_int(0)
    e.rootPointTicks            := array.new_int(0)
    e.rootNativeBottomTicks     := array.new_int(0)
    e.rootNativeTopTicks        := array.new_int(0)

    // W02 Batch 1 : Root slot lifecycle storage, empty at Engine creation.
    e.rootSlotLiveFlags         := array.new_bool(0)
    e.rootFreeSlots             := array.new_int(0)
    e.rootLiveSlots             := array.new_int(0)
    e.rootIdOrderSlots          := array.new_int(0)
    // W02 Batch 4 : per-Engine Root ID index, never a global.
    e.rootIdToSlot              := map.new<int, int>()
    // W02 Batch 32 : I11-3 / I6.2 price-order foundation, both empty at Engine
    // creation. The order array stays empty until a later Batch inserts Roots.
    e.rootPriceOrderSlots       := array.new_int(0)
    e.rootPriceOrderPositions   := array.new_int(0)

    e.coreIds                   := array.new_int(0)
    e.coreGenerationIds         := array.new_int(0)
    e.coreZoneFreshFlags        := array.new_bool(0)
    e.corePhysicalBottoms       := array.new_float(0)
    e.corePhysicalTops          := array.new_float(0)
    e.coreCreatedTimes          := array.new_int(0)
    e.coreLastSeenTimes         := array.new_int(0)
    e.coreDormantFlags          := array.new_bool(0)

    // W02 Batch 1 : Core slot lifecycle storage, empty at Engine creation.
    e.coreSlotLiveFlags         := array.new_bool(0)
    e.coreFreeSlots             := array.new_int(0)
    e.coreLiveSlots             := array.new_int(0)
    // W02 Batch 6 : Core ID ascending order foundation for the Public View order.
    e.coreIdOrderSlots          := array.new_int(0)
    // W02 Batch 4 : per-Engine Core ID index, never a global.
    e.coreIdToSlot              := map.new<int, int>()

    e.sideTouchCounts           := array.new_int(0)
    e.sideWeakByTouchFlags      := array.new_bool(0)
    e.sideWeakByDepthFlags      := array.new_bool(0)
    e.sideMaxDepthPcts          := array.new_float(0)
    e.sideFreshFlags            := array.new_bool(0)
    e.sidePhases                := array.new_int(0)
    e.sideGrades                := array.new_int(0)
    e.sideCurrentTouchNos       := array.new_int(0)
    e.sideUpcomingTouchNos      := array.new_int(0)
    e.sideArmedFromSeqs         := array.new_int(0)
    e.sideLastArmedRangeBottoms := array.new_float(0)
    e.sideLastArmedRangeTops    := array.new_float(0)
    e.sideLastNormalTouchTimes  := array.new_int(0)
    e.sideFlipAttemptCounts     := array.new_int(0)
    e.sideInverseAttemptCounts  := array.new_int(0)
    e.sideLastFlipConfirmSeqs   := array.new_int(0)

    e.sideEffectiveBottoms      := array.new_float(0)
    e.sideEffectiveTops         := array.new_float(0)
    e.sideReferencePrices       := array.new_float(0)
    e.sideCCounts               := array.new_int(0)
    e.sideHCounts               := array.new_int(0)
    e.sideDensities             := array.new_int(0)
    e.sideBaseStrongFlags       := array.new_bool(0)
    e.sideHasNonPsychRootFlags  := array.new_bool(0)
    e.sideIsBroadContextFlags   := array.new_bool(0)
    e.sideEligibleFlags         := array.new_bool(0)

    // W02 Batch 15 : Root Category / TF / state index sets and their reverse
    // position lookups, all empty. Each array.new_int(0) is its own instance.
    e.categoryMaRootSlots          := array.new_int(0)
    e.categorySwingRootSlots       := array.new_int(0)
    e.categoryAccumRootSlots       := array.new_int(0)
    e.categoryTimeHlRootSlots      := array.new_int(0)
    e.categoryFvgRootSlots         := array.new_int(0)
    e.categoryPsychRootSlots       := array.new_int(0)
    e.tf1mRootSlots                := array.new_int(0)
    e.tf5mRootSlots                := array.new_int(0)
    e.tf15mRootSlots               := array.new_int(0)
    e.tf1hRootSlots                := array.new_int(0)
    e.tf4hRootSlots                := array.new_int(0)
    e.tfDRootSlots                 := array.new_int(0)
    e.stateCandidateRootSlots      := array.new_int(0)
    e.stateActiveRootSlots         := array.new_int(0)
    e.stateInvalidatedRootSlots    := array.new_int(0)
    e.stateInverseWaitRootSlots    := array.new_int(0)
    e.stateInverseActiveRootSlots  := array.new_int(0)
    e.stateRetiredRootSlots        := array.new_int(0)
    e.rootCategorySetPositions     := array.new_int(0)
    e.rootTfSetPositions           := array.new_int(0)
    e.rootStateSetPositions        := array.new_int(0)

    // W02 Batch 19 : FVG non-price index sets and their reverse position
    // lookups, all empty. Each array.new_int(0) is its own instance.
    e.freshFvg1hRootSlots                  := array.new_int(0)
    e.freshFvg4hRootSlots                  := array.new_int(0)
    e.freshFvgDRootSlots                   := array.new_int(0)
    e.structurallyActiveFvg1hRootSlots     := array.new_int(0)
    e.structurallyActiveFvg4hRootSlots     := array.new_int(0)
    e.structurallyActiveFvgDRootSlots      := array.new_int(0)
    e.inverseWaitFvgRootSlots              := array.new_int(0)
    e.inverseActiveFvgRootSlots            := array.new_int(0)
    e.bullishFvgRootSlots                  := array.new_int(0)
    e.bearishFvgRootSlots                  := array.new_int(0)
    e.broadFvgRootSlots                    := array.new_int(0)
    e.rootFvgFreshSetPositions             := array.new_int(0)
    e.rootFvgStructuralStateSetPositions   := array.new_int(0)
    e.rootFvgDirectionSetPositions         := array.new_int(0)
    e.rootFvgBroadSetPositions             := array.new_int(0)

    // W02 Batch 23 : Root participation adjacency storage, all empty. Each
    // array.new_* call is its own instance; no edge row exists yet.
    e.rootParticipationHeadEdgeIndexes   := array.new_int(0)
    e.rootParticipationCounts            := array.new_int(0)
    e.participationEdgeRootSlots         := array.new_int(0)
    e.participationEdgeExpectedRootIds   := array.new_int(0)
    e.participationEdgeSideSlots         := array.new_int(0)
    e.participationEdgeExpectedCoreIds   := array.new_int(0)
    e.participationEdgeNextByRootIndexes := array.new_int(0)
    e.participationEdgeLiveFlags         := array.new_bool(0)
    e.participationEdgeFreeIndexes       := array.new_int(0)

    // W02 Batch 21 : FVG NativeRange interval index orders and their reverse
    // position lookups, all empty. Each array.new_int(0) is its own instance.
    e.fvgNativeBottomOrderRootSlots      := array.new_int(0)
    e.fvgNativeTopOrderRootSlots         := array.new_int(0)
    e.rootFvgNativeBottomOrderPositions  := array.new_int(0)
    e.rootFvgNativeTopOrderPositions     := array.new_int(0)

    // W02 Batch 18 : Accum pair upper / lower Root indexes, one instance each and
    // both empty. Per-Engine maps, never globals and never aliased to each other.
    e.accumPairUpperRootSlotByKey  := map.new<int, int>()
    e.accumPairLowerRootSlotByKey  := map.new<int, int>()

    // W02 Batch 10 : TouchMark ring geometry and storage. The capacity comes from
    // the Cfg as received, without correction; the blocks themselves are allocated
    // in a later Batch, so every array starts empty.
    e.touchMarkCapacityPerCore     := cfg.maxTouchMarksPerCore
    e.touchMarkRingOwnerCoreIds    := array.new_int(0)
    e.touchMarkRingHeads           := array.new_int(0)
    e.touchMarkRingCounts          := array.new_int(0)
    e.touchMarkBaseSeqs            := array.new_int(0)
    e.touchMarkTimes               := array.new_int(0)
    e.touchMarkSides               := array.new_int(0)
    e.touchMarkContactBottoms      := array.new_float(0)
    e.touchMarkContactTops         := array.new_float(0)
    e.touchMarkCloseAtTouches      := array.new_float(0)
    e.touchMarkGenerationIds       := array.new_int(0)
    e.touchMarkIsNormalTouchFlags  := array.new_bool(0)

    // W02 Batch 13 : six independent Phase sets plus the sideSlot -> position
    // reverse lookup, all empty. Each array.new_int(0) creates its own instance.
    e.phaseWaitingSideSlots      := array.new_int(0)
    e.phaseArmedSideSlots        := array.new_int(0)
    e.phaseActiveTouchSideSlots  := array.new_int(0)
    e.phaseBrokenSideSlots       := array.new_int(0)
    e.phaseFlipWaitSideSlots     := array.new_int(0)
    e.phaseDormantSideSlots      := array.new_int(0)
    e.sidePhaseSetPositions      := array.new_int(0)

    // W02 Batch 33 : the two Armed / Dormant price-index foundations (I11-10 /
    // I11-12), all empty. Each array.new_int(0) creates its own instance: the four
    // order arrays and the four reverse-position arrays are never aliased.
    e.armedEffectiveBottomOrderSideSlots      := array.new_int(0)
    e.armedEffectiveTopOrderSideSlots         := array.new_int(0)
    e.sideArmedEffectiveBottomOrderPositions  := array.new_int(0)
    e.sideArmedEffectiveTopOrderPositions     := array.new_int(0)
    e.dormantRecoveryBottomOrderSideSlots     := array.new_int(0)
    e.dormantRecoveryTopOrderSideSlots        := array.new_int(0)
    e.sideDormantRecoveryBottomOrderPositions := array.new_int(0)
    e.sideDormantRecoveryTopOrderPositions    := array.new_int(0)

    // W02 Batch 34 : the two Broken / Flip frozen-snapshot price-index foundations
    // (I11-11), all empty. Each array.new_int(0) creates its own instance: the four
    // order arrays and the four reverse-position arrays are never aliased.
    e.brokenSnapshotBottomOrderSideSlots     := array.new_int(0)
    e.brokenSnapshotTopOrderSideSlots        := array.new_int(0)
    e.sideBrokenSnapshotBottomOrderPositions := array.new_int(0)
    e.sideBrokenSnapshotTopOrderPositions    := array.new_int(0)
    e.flipSnapshotBottomOrderSideSlots       := array.new_int(0)
    e.flipSnapshotTopOrderSideSlots          := array.new_int(0)
    e.sideFlipSnapshotBottomOrderPositions   := array.new_int(0)
    e.sideFlipSnapshotTopOrderPositions      := array.new_int(0)

    // W02 Batch 36 / 36R : the I11-13 Root prune foundation, all empty, inside the
    // W02AuxStore singleton. rootPruneRevisions grows with the physical Root slots;
    // the four per-Category heaps stay empty until a later Batch enqueues anything.
    // Each array.new_int(0) creates its own instance: no queue array is ever aliased
    // to another, and the store itself is created once and attached to the Engine.
    W02AuxStore aux = W02AuxStore.new()

    aux.rootPruneRevisions                    := array.new_int(0)

    aux.pruneSwingRootIds                     := array.new_int(0)
    aux.pruneSwingRootRevisions               := array.new_int(0)
    aux.pruneSwingRootStateSnapshots          := array.new_int(0)
    aux.pruneSwingRootConfirmedTimeSnapshots  := array.new_int(0)

    aux.pruneAccumRootIds                     := array.new_int(0)
    aux.pruneAccumRootRevisions               := array.new_int(0)
    aux.pruneAccumRootStateSnapshots          := array.new_int(0)
    aux.pruneAccumRootConfirmedTimeSnapshots  := array.new_int(0)

    aux.pruneFvgRootIds                       := array.new_int(0)
    aux.pruneFvgRootRevisions                 := array.new_int(0)
    aux.pruneFvgRootStateSnapshots            := array.new_int(0)
    aux.pruneFvgRootConfirmedTimeSnapshots    := array.new_int(0)

    aux.pruneTimeHlRootIds                    := array.new_int(0)
    aux.pruneTimeHlRootRevisions              := array.new_int(0)
    aux.pruneTimeHlRootStateSnapshots         := array.new_int(0)
    aux.pruneTimeHlRootConfirmedTimeSnapshots := array.new_int(0)

    // W02 Batch 37 : the I11-13 Core prune foundation, on the same single
    // W02AuxStore instance. corePruneRevisions grows with the physical Core slots;
    // the Dormant Core heap stays empty until a later Batch enqueues anything.
    aux.corePruneRevisions                    := array.new_int(0)

    aux.pruneCoreIds                          := array.new_int(0)
    aux.pruneCoreRevisions                    := array.new_int(0)
    aux.pruneCoreRootCountSnapshots           := array.new_int(0)
    aux.pruneCoreLastSeenTimeSnapshots        := array.new_int(0)

    // W02 Batch 38 : the A6.5 TouchStartSnapshot scalar storage, on the same single
    // W02AuxStore instance. All eighteen stay empty: the Core physical lifecycle is
    // connected in a later Batch, so no Side row exists yet and real Snapshots = 0.
    // Each array.new_* call creates its own instance: no aliasing between these
    // eighteen, and none of them aliases a current Side state array.
    aux.sideTouchStartSnapshotValidFlags      := array.new_bool(0)
    aux.sideTouchStartSnapshotCoreIds         := array.new_int(0)
    aux.sideTouchStartSnapshotGenerationIds   := array.new_int(0)
    aux.sideTouchStartSnapshotSides           := array.new_int(0)
    aux.sideTouchStartSnapshotRangeBottoms    := array.new_float(0)
    aux.sideTouchStartSnapshotRangeTops       := array.new_float(0)
    aux.sideTouchStartSnapshotCategoryMasks   := array.new_int(0)
    aux.sideTouchStartSnapshotHighMasks       := array.new_int(0)
    aux.sideTouchStartSnapshotCCounts         := array.new_int(0)
    aux.sideTouchStartSnapshotHCounts         := array.new_int(0)
    aux.sideTouchStartSnapshotDensities       := array.new_int(0)
    aux.sideTouchStartSnapshotGrades          := array.new_int(0)
    aux.sideTouchStartSnapshotCurrentTouchNos := array.new_int(0)
    aux.sideTouchStartSnapshotApproachSides   := array.new_int(0)
    aux.sideTouchStartSnapshotStartSeqs       := array.new_int(0)
    aux.sideTouchStartSnapshotStartTimes      := array.new_int(0)
    aux.sideTouchStartSnapshotDeepestCloses   := array.new_float(0)
    aux.sideTouchStartSnapshotMaxDepthPcts    := array.new_float(0)

    // W02 Batch 40 : the A6.5 participating-Root copy storage, on the same single
    // W02AuxStore instance. The three Side metadata arrays grow with the physical
    // Side slots; the seven node arrays and the free stack stay empty until a later
    // Batch allocates a node. Each array.new_* call creates its own instance: no
    // aliasing between these eleven, and none of them aliases the Candidate scratch,
    // the TouchMark ring or the participation edge pool.
    aux.sideTouchStartSnapshotRootHeadNodeIndexes       := array.new_int(0)
    aux.sideTouchStartSnapshotRootTailNodeIndexes       := array.new_int(0)
    aux.sideTouchStartSnapshotRootCounts                := array.new_int(0)

    aux.touchStartSnapshotRootNodeRootIds               := array.new_int(0)
    aux.touchStartSnapshotRootNodeNextIndexes           := array.new_int(0)
    aux.touchStartSnapshotRootNodeOwnerSideSlots        := array.new_int(0)
    aux.touchStartSnapshotRootNodeExpectedCoreIds       := array.new_int(0)
    aux.touchStartSnapshotRootNodeExpectedGenerationIds := array.new_int(0)
    aux.touchStartSnapshotRootNodeExpectedTouchNos      := array.new_int(0)
    aux.touchStartSnapshotRootNodeLiveFlags             := array.new_bool(0)

    aux.touchStartSnapshotRootNodeFreeIndexes           := array.new_int(0)

    // W02 Batch 42 : the I11-2 origin bucket foundation, on the same single
    // W02AuxStore instance. The map starts empty and stays empty in this Batch; the
    // three chain arrays grow with the physical Root slots. Each call creates its
    // own instance: no aliasing, and none of them aliases rootIdToSlot.
    aux.originKeyBucketHeadRootSlots                    := map.new<int, int>()
    aux.rootOriginBucketPrevRootSlots                   := array.new_int(0)
    aux.rootOriginBucketNextRootSlots                   := array.new_int(0)
    aux.rootOriginBucketExpectedRootIds                 := array.new_int(0)

    // W02 Batch 43 : the A6.6 BreakSnapshot scalar storage, on the same single
    // W02AuxStore instance. All eleven start empty and grow with the physical Side
    // slots. Each array.new_* call creates its own instance: no aliasing between
    // these eleven, and none of them aliases a TouchStartSnapshot array or a live
    // Side state array.
    aux.sideBreakSnapshotValidFlags       := array.new_bool(0)
    aux.sideBreakSnapshotCoreIds          := array.new_int(0)
    aux.sideBreakSnapshotGenerationIds    := array.new_int(0)
    aux.sideBreakSnapshotOldSides         := array.new_int(0)
    aux.sideBreakSnapshotRangeBottoms     := array.new_float(0)
    aux.sideBreakSnapshotRangeTops        := array.new_float(0)
    aux.sideBreakSnapshotBreakSeqs        := array.new_int(0)
    aux.sideBreakSnapshotBreakTimes       := array.new_int(0)
    aux.sideBreakSnapshotWasGapBreakFlags := array.new_bool(0)
    aux.sideBreakSnapshotMovedAwayFlags   := array.new_bool(0)
    aux.sideBreakSnapshotRetestSeenFlags  := array.new_bool(0)

    // W02 Batch 44 : the A6.6 BreakSnapshot Root-origin-ID copy storage, on the same
    // single W02AuxStore instance. The three Side metadata arrays grow with the
    // physical Side slots; the seven node arrays and the free stack stay empty until
    // a later Batch allocates a node. Each array.new_* call creates its own
    // instance: no aliasing inside these eleven and none with the TouchStartSnapshot
    // Root-copy pool, which stays a completely separate pool.
    aux.sideBreakSnapshotRootHeadNodeIndexes       := array.new_int(0)
    aux.sideBreakSnapshotRootTailNodeIndexes       := array.new_int(0)
    aux.sideBreakSnapshotRootCounts                := array.new_int(0)

    aux.breakSnapshotRootNodeRootIds               := array.new_int(0)
    aux.breakSnapshotRootNodeNextIndexes           := array.new_int(0)
    aux.breakSnapshotRootNodeOwnerSideSlots        := array.new_int(0)
    aux.breakSnapshotRootNodeExpectedCoreIds       := array.new_int(0)
    aux.breakSnapshotRootNodeExpectedGenerationIds := array.new_int(0)
    aux.breakSnapshotRootNodeExpectedBreakSeqs     := array.new_int(0)
    aux.breakSnapshotRootNodeLiveFlags             := array.new_bool(0)

    aux.breakSnapshotRootNodeFreeIndexes           := array.new_int(0)

    // W02 Batch 46 : the A6.7 Side current valid Root ID list storage, on the same
    // single W02AuxStore instance. The three Side metadata arrays grow with the
    // physical Side slots; the six node arrays and the free stack stay empty until a
    // later Batch allocates a node. Each array.new_* call creates its own instance:
    // no aliasing inside these ten and none with either Snapshot Root-copy pool or
    // the participation adjacency - this is a third, independent pool.
    aux.sideCurrentRootHeadNodeIndexes           := array.new_int(0)
    aux.sideCurrentRootTailNodeIndexes           := array.new_int(0)
    aux.sideCurrentRootCounts                    := array.new_int(0)

    aux.sideCurrentRootNodeRootIds               := array.new_int(0)
    aux.sideCurrentRootNodeNextIndexes           := array.new_int(0)
    aux.sideCurrentRootNodeOwnerSideSlots        := array.new_int(0)
    aux.sideCurrentRootNodeExpectedCoreIds       := array.new_int(0)
    aux.sideCurrentRootNodeExpectedGenerationIds := array.new_int(0)
    aux.sideCurrentRootNodeLiveFlags             := array.new_bool(0)

    aux.sideCurrentRootNodeFreeIndexes           := array.new_int(0)

    // W02 Batch 47 : the A6.8 ZoneCore origin Root ID set storage, on the same
    // single W02AuxStore instance. The three Core metadata arrays grow with the
    // physical Core slots; the six node arrays and the free stack stay empty until a
    // later Batch allocates a node. Each array.new_* call creates its own instance:
    // no aliasing inside these ten and none with the Side current list, either
    // Snapshot Root-copy pool or the participation adjacency.
    aux.coreZoneOriginRootHeadNodeIndexes           := array.new_int(0)
    aux.coreZoneOriginRootTailNodeIndexes           := array.new_int(0)
    aux.coreZoneOriginRootCounts                    := array.new_int(0)

    aux.coreZoneOriginRootNodeRootIds               := array.new_int(0)
    aux.coreZoneOriginRootNodeNextIndexes           := array.new_int(0)
    aux.coreZoneOriginRootNodeOwnerCoreSlots        := array.new_int(0)
    aux.coreZoneOriginRootNodeExpectedCoreIds       := array.new_int(0)
    aux.coreZoneOriginRootNodeExpectedGenerationIds := array.new_int(0)
    aux.coreZoneOriginRootNodeLiveFlags             := array.new_bool(0)

    aux.coreZoneOriginRootNodeFreeIndexes           := array.new_int(0)

    // W02 Batch 48 : the A6.8 Pending existence flags, on the same single
    // W02AuxStore instance. Both grow with the physical Core slots and hold only
    // their false sentinel; each array.new_bool(0) creates its own instance.
    aux.corePendingTopologyFlags                    := array.new_bool(0)
    aux.corePendingGenerationFlags                  := array.new_bool(0)

    // W02 Batch 50 : the EndedGeneration ring payload, on the same single
    // W02AuxStore instance. Nothing is preallocated to cfg.maxEndedGenerations
    // because no append exists yet, so all seven stay size 0 beside head 0 and
    // count 0. Each array.new_int(0) creates its own instance.
    aux.endedGenerationCoreIds               := array.new_int(0)
    aux.endedGenerationGenerationIds         := array.new_int(0)
    aux.endedGenerationEndedTimes            := array.new_int(0)
    aux.endedGenerationSupportTouches        := array.new_int(0)
    aux.endedGenerationResistanceTouches     := array.new_int(0)
    aux.endedGenerationSupportWeakReasons    := array.new_int(0)
    aux.endedGenerationResistanceWeakReasons := array.new_int(0)

    // W02 Batch 51 : the four per-Side FVG diagnostics, on the same single
    // W02AuxStore instance. They grow with the physical Side slots and hold only
    // their sentinels; each array.new_int(0) creates its own instance.
    aux.sideFvgDirectionMasks       := array.new_int(0)
    aux.sideFvgRootCounts           := array.new_int(0)
    aux.sideFvgFreshCounts          := array.new_int(0)
    aux.sideFvgStructuralStateMasks := array.new_int(0)

    // W02 Batch 52 : the I6.1 PendingTopology multi-child Root-copy storage, on the
    // same single W02AuxStore instance. The three per-Core metadata arrays grow with
    // the physical Core slots; the child pool, the Root-copy node pool and both free
    // stacks stay empty until a later Batch allocates a row. Each array.new_* call
    // creates its own instance: no aliasing inside these nineteen and none with any
    // Snapshot pool, the Side current list, the Zone origin set or the Candidate
    // scratch.
    aux.corePendingTopologyChildHeadIndexes          := array.new_int(0)
    aux.corePendingTopologyChildTailIndexes          := array.new_int(0)
    aux.corePendingTopologyChildCounts               := array.new_int(0)

    aux.pendingTopologyChildNextIndexes              := array.new_int(0)
    aux.pendingTopologyChildOwnerCoreSlots           := array.new_int(0)
    aux.pendingTopologyChildExpectedCoreIds          := array.new_int(0)
    aux.pendingTopologyChildExpectedGenerationIds    := array.new_int(0)
    aux.pendingTopologyChildRootHeadNodeIndexes      := array.new_int(0)
    aux.pendingTopologyChildRootTailNodeIndexes      := array.new_int(0)
    aux.pendingTopologyChildRootCounts               := array.new_int(0)
    aux.pendingTopologyChildLiveFlags                := array.new_bool(0)
    aux.pendingTopologyChildFreeIndexes              := array.new_int(0)

    aux.pendingTopologyRootNodeRootIds               := array.new_int(0)
    aux.pendingTopologyRootNodeNextIndexes           := array.new_int(0)
    aux.pendingTopologyRootNodeOwnerChildIndexes     := array.new_int(0)
    aux.pendingTopologyRootNodeExpectedCoreIds       := array.new_int(0)
    aux.pendingTopologyRootNodeExpectedGenerationIds := array.new_int(0)
    aux.pendingTopologyRootNodeLiveFlags             := array.new_bool(0)
    aux.pendingTopologyRootNodeFreeIndexes           := array.new_int(0)

    e.w02Aux := aux

    // W03 Batch 02 : one W03SourceRootStore per Engine, all fields at their type
    // default sentinels. No collection is created.
    W03SourceRootStore w03 = W03SourceRootStore.new()
    // W03 Batch 03 : 23 independent, empty journal arrays. Journal meta keeps its
    // type defaults.
    w03.journalOps              := array.new_int(0)
    w03.journalGroups           := array.new_int(0)
    w03.journalTargetRootSlots  := array.new_int(0)
    w03.journalExpectedRootIds  := array.new_int(0)
    w03.journalCategories       := array.new_int(0)
    w03.journalSubtypes         := array.new_int(0)
    w03.journalTfCodes          := array.new_int(0)
    w03.journalOriginKeys       := array.new_int(0)
    w03.journalOriginTimes      := array.new_int(0)
    w03.journalOriginEndTimes   := array.new_int(0)
    w03.journalConfirmedTimes   := array.new_int(0)
    w03.journalPointPrices      := array.new_float(0)
    w03.journalNativeBottoms    := array.new_float(0)
    w03.journalNativeTops       := array.new_float(0)
    w03.journalOldStates        := array.new_int(0)
    w03.journalNewStates        := array.new_int(0)
    w03.journalFvgFreshFlags    := array.new_bool(0)
    w03.journalIsBroadFlags     := array.new_bool(0)
    w03.journalDirections       := array.new_int(0)
    w03.journalOldMasks         := array.new_int(0)
    w03.journalNewMasks         := array.new_int(0)
    w03.journalPairKeys         := array.new_int(0)
    w03.journalSlopeDirs        := array.new_int(0)
    // W03 Batch 04 : Swing TF mask storage, empty; grows with the Root slots.
    w03.rootSwingTfMasks        := array.new_int(0)
    // W05 Batch 02 : Candidate scratch storage, every array its own instance
    w03.candidateSupportScratchPosByRootSlot    := array.new_int(0)
    w03.candidateResistanceScratchPosByRootSlot := array.new_int(0)
    w03.candidateSupportUsedByRootSlot          := array.new_bool(0)
    w03.candidateResistanceUsedByRootSlot       := array.new_bool(0)
    w03.candidateSupportFvgRootSlots            := array.new_int(0)
    w03.candidateSupportFvgLength               := 0
    w03.candidateResistanceFvgRootSlots         := array.new_int(0)
    w03.candidateResistanceFvgLength            := 0
    // W05 Batch 04 : Candidate window deques, each its own instance
    w03.candidateWindowMinRootIdDequeScratchIndexes        := array.new_int(0)
    w03.candidateWindowMaxConfirmedTimeDequeScratchIndexes := array.new_int(0)
    e.w03Store := w03

    // W02 Batch 9 : four independent Candidate scratch regions, empty and logically
    // zero-length. Each array.new_int(0) call creates its own instance: no aliasing.
    e.candidateScratchSupportOldRootSlots    := array.new_int(0)
    e.candidateScratchSupportOldLength       := 0
    e.candidateScratchSupportNewRootSlots    := array.new_int(0)
    e.candidateScratchSupportNewLength       := 0
    e.candidateScratchResistanceOldRootSlots := array.new_int(0)
    e.candidateScratchResistanceOldLength    := 0
    e.candidateScratchResistanceNewRootSlots := array.new_int(0)
    e.candidateScratchResistanceNewLength    := 0

    e.eventTypes                := array.new_int(0)
    e.eventTimes                := array.new_int(0)
    e.eventBaseSeqs             := array.new_int(0)
    e.eventCoreIds              := array.new_int(0)
    e.eventGenerationIds        := array.new_int(0)
    e.eventSides                := array.new_int(0)
    e.eventRangeBottoms         := array.new_float(0)
    e.eventRangeTops            := array.new_float(0)
    e.eventTouchNos             := array.new_int(0)
    e.eventGradeAtStarts        := array.new_int(0)
    e.eventWeakReasons          := array.new_int(0)
    e.eventRootIds              := array.new_int(0)

    // Batch 5 : connect cfg validation and the two Cfg fingerprints (D06, D10).
    // An invalid cfg still returns an object; cfg is never auto-corrected.
    // Feed metadata (code 6) is never mixed into this persistent Cfg state.
    int errorCode = validateCfg(cfg)
    e.cfgErrorCode     := errorCode
    e.configValid      := errorCode == ERR_OK
    e.cfgFingerprintA  := cfgFingerprint(cfg, FP_SEED_A, FP_MULT_A)
    e.cfgFingerprintB  := cfgFingerprint(cfg, FP_SEED_B, FP_MULT_B)

    e

// ============================================================
// W03 Batch 03 : Root mutation journal raw helpers
// Source: I8 (Stage E / F), I17.1, D12
//
// Internal only and physical only. The journal is a reuse pool: a reset puts the
// logical length back to 0 and never clears, pops or recreates the 23 arrays, and
// an append overwrites an existing physical row or grows all 23 arrays by one row.
// The 23 arrays always keep one physical size: an append writes all of them or
// pushes all of them, never part. Values are stored exactly as the caller passes
// them - no sentinel is filled in, inferred or corrected here.
// No Stage, Root mutation, preflight, revision or index is touched, and call
// sites = 0 in this Batch.
// ============================================================

// Starts a new logical journal for one Base bar. Scalars only.
journalResetRaw(ZoneEngine engine, int baseSeq, int baseCloseTime) =>
    engine.w03Store.journalCount              := 0
    engine.w03Store.journalBaseSeq            := baseSeq
    engine.w03Store.journalBaseCloseTime      := baseCloseTime
    engine.w03Store.journalInvariantViolation := false

// Appends one journal row at the logical tail and returns its row index. The
// logical length grows only after all 23 fields are written.
journalAppendRaw(ZoneEngine engine, int op, int group, int targetRootSlot, int expectedRootId, int category, int subtype, int tfCode, int originKey, int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom, float nativeTop, int oldState, int newState, bool fvgFresh, bool isBroad, int direction, int oldMask, int newMask, int pairKey, int slopeDir) =>
    int row = engine.w03Store.journalCount
    if row < array.size(engine.w03Store.journalOps)
        // the physical row exists -> overwrite all 23 fields
        array.set(engine.w03Store.journalOps,             row, op)
        array.set(engine.w03Store.journalGroups,          row, group)
        array.set(engine.w03Store.journalTargetRootSlots, row, targetRootSlot)
        array.set(engine.w03Store.journalExpectedRootIds, row, expectedRootId)
        array.set(engine.w03Store.journalCategories,      row, category)
        array.set(engine.w03Store.journalSubtypes,        row, subtype)
        array.set(engine.w03Store.journalTfCodes,         row, tfCode)
        array.set(engine.w03Store.journalOriginKeys,      row, originKey)
        array.set(engine.w03Store.journalOriginTimes,     row, originTime)
        array.set(engine.w03Store.journalOriginEndTimes,  row, originEndTime)
        array.set(engine.w03Store.journalConfirmedTimes,  row, confirmedTime)
        array.set(engine.w03Store.journalPointPrices,     row, pointPrice)
        array.set(engine.w03Store.journalNativeBottoms,   row, nativeBottom)
        array.set(engine.w03Store.journalNativeTops,      row, nativeTop)
        array.set(engine.w03Store.journalOldStates,       row, oldState)
        array.set(engine.w03Store.journalNewStates,       row, newState)
        array.set(engine.w03Store.journalFvgFreshFlags,   row, fvgFresh)
        array.set(engine.w03Store.journalIsBroadFlags,    row, isBroad)
        array.set(engine.w03Store.journalDirections,      row, direction)
        array.set(engine.w03Store.journalOldMasks,        row, oldMask)
        array.set(engine.w03Store.journalNewMasks,        row, newMask)
        array.set(engine.w03Store.journalPairKeys,        row, pairKey)
        array.set(engine.w03Store.journalSlopeDirs,       row, slopeDir)
    else
        // the pool has never been this long -> grow all 23 arrays by one row
        array.push(engine.w03Store.journalOps,             op)
        array.push(engine.w03Store.journalGroups,          group)
        array.push(engine.w03Store.journalTargetRootSlots, targetRootSlot)
        array.push(engine.w03Store.journalExpectedRootIds, expectedRootId)
        array.push(engine.w03Store.journalCategories,      category)
        array.push(engine.w03Store.journalSubtypes,        subtype)
        array.push(engine.w03Store.journalTfCodes,         tfCode)
        array.push(engine.w03Store.journalOriginKeys,      originKey)
        array.push(engine.w03Store.journalOriginTimes,     originTime)
        array.push(engine.w03Store.journalOriginEndTimes,  originEndTime)
        array.push(engine.w03Store.journalConfirmedTimes,  confirmedTime)
        array.push(engine.w03Store.journalPointPrices,     pointPrice)
        array.push(engine.w03Store.journalNativeBottoms,   nativeBottom)
        array.push(engine.w03Store.journalNativeTops,      nativeTop)
        array.push(engine.w03Store.journalOldStates,       oldState)
        array.push(engine.w03Store.journalNewStates,       newState)
        array.push(engine.w03Store.journalFvgFreshFlags,   fvgFresh)
        array.push(engine.w03Store.journalIsBroadFlags,    isBroad)
        array.push(engine.w03Store.journalDirections,      direction)
        array.push(engine.w03Store.journalOldMasks,        oldMask)
        array.push(engine.w03Store.journalNewMasks,        newMask)
        array.push(engine.w03Store.journalPairKeys,        pairKey)
        array.push(engine.w03Store.journalSlopeDirs,       slopeDir)
    engine.w03Store.journalCount := row + 1
    row

// ============================================================
// W03 Batch 05 : originKey and origin bucket lifecycle helpers (I11-2)
// Source: I4, I11-2, D02, D10, D12
//
// Internal only. An originKey is a coarse bucket / prefilter, never an identity
// proof: several Roots may share one key, and a key, hash or fingerprint match
// alone never makes two Roots the same. Identity is decided only by the full
// origin comparator (a later Batch).
// The bucket is the existing W02 Batch 42 storage: the originKey -> head rootSlot
// map plus the prev / next / expectedRootId chain arrays indexed by rootSlot. The
// chain carries no order semantics; a new Root is inserted at the head.
// attach and detach validate everything first and only then mutate, so a false
// result means zero mutation, no repair and no rebuild. Neither scans all Roots.
// Call sites = 0 in this Batch.
// ============================================================

// Computes the coarse origin bucket key from the Category's bucket fields only,
// mixed in a fixed per-Category order with the existing fpMixInt (seed / mult A).
// na is mixed through the existing fpIntKey. A result of 0 becomes 1, because
// ID_NONE is never a key. An unknown Category is a runtime error, never a fallback.
originKeyComputeRaw(int category, int subtype, int tfCode, int pointTick, int originTime, int direction) =>
    int h = FP_SEED_A
    h := fpMixInt(h, FP_MULT_A, fpIntKey(category))
    if category == CAT_MA
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
    else if category == CAT_SWING
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_ACCUM
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_TIME_HL
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_FVG
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(direction))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_PSYCH
        // pointTick is the normalized 50-dollar psych tick
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    h == 0 ? 1 : h

// Inserts one owned Root at the head of the bucket of rootOriginKeys[rootSlot].
// Returns true when committed; false with zero mutation on any failed check.
originBucketAttachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.w02Aux.rootOriginBucketPrevRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
    int key     = ID_NONE
    int oldHead = SLOT_INVALID
    // Step 1 : the Root itself is live, owned and not linked anywhere
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        key := array.get(engine.rootOriginKeys, rootSlot)
        ok  := key != ID_NONE and array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, rootSlot) == SLOT_INVALID and array.get(engine.w02Aux.rootOriginBucketNextRootSlots, rootSlot) == SLOT_INVALID and array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot) == ID_NONE
    // Step 2 : an existing head must be a valid, owned member of the same bucket
    if ok and map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, key)
        oldHead := map.get(engine.w02Aux.originKeyBucketHeadRootSlots, key)
        ok      := oldHead != rootSlot and oldHead >= 0 and oldHead < array.size(engine.rootIds)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, oldHead)
        if ok
            ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, oldHead) == array.get(engine.rootIds, oldHead) and array.get(engine.rootOriginKeys, oldHead) == key
    // Step 3 : commit. Nothing below can fail.
    if ok
        array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, oldHead)
        array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, expectedRootId)
        if oldHead != SLOT_INVALID
            array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, oldHead, rootSlot)
        map.put(engine.w02Aux.originKeyBucketHeadRootSlots, key, rootSlot)
    ok

// Unlinks one owned Root from its bucket. Returns true when committed; false with
// zero mutation when the Root, its own chain entry or either neighbour fails.
originBucketDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.w02Aux.rootOriginBucketPrevRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
    int key  = ID_NONE
    int prev = SLOT_INVALID
    int next = SLOT_INVALID
    // Step 1 : the Root is live, owned and indexed under the same Root ID
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        key  := array.get(engine.rootOriginKeys, rootSlot)
        ok   := key != ID_NONE and array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot) == expectedRootId
    if ok
        prev := array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, rootSlot)
        next := array.get(engine.w02Aux.rootOriginBucketNextRootSlots, rootSlot)
        ok   := prev != rootSlot and next != rootSlot
    // Step 2 : predecessor, or the map head when there is none
    if ok
        if prev == SLOT_INVALID
            ok := map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, key)
            if ok
                ok := map.get(engine.w02Aux.originKeyBucketHeadRootSlots, key) == rootSlot
        else
            ok := prev >= 0 and prev < array.size(engine.rootIds)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, prev)
            if ok
                ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, prev) == array.get(engine.rootIds, prev) and array.get(engine.rootOriginKeys, prev) == key and array.get(engine.w02Aux.rootOriginBucketNextRootSlots, prev) == rootSlot
    // Step 3 : successor
    if ok and next != SLOT_INVALID
        ok := next >= 0 and next < array.size(engine.rootIds)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, next)
        if ok
            ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, next) == array.get(engine.rootIds, next) and array.get(engine.rootOriginKeys, next) == key and array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, next) == rootSlot
    // Step 4 : commit. Unlink, then clear this Root's own entry. Nothing can fail.
    if ok
        if prev == SLOT_INVALID
            if next == SLOT_INVALID
                map.remove(engine.w02Aux.originKeyBucketHeadRootSlots, key)
            else
                map.put(engine.w02Aux.originKeyBucketHeadRootSlots, key, next)
                array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, next, SLOT_INVALID)
        else
            array.set(engine.w02Aux.rootOriginBucketNextRootSlots, prev, next)
            if next != SLOT_INVALID
                array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, next, prev)
        array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, ID_NONE)
    ok

// ============================================================
// W03 Batch 06 : full origin tuple comparator and unique origin lookup (I11-2)
// Source: I4, I11-2, A7.3 - A7.7, D02, D12
//
// Internal only. Root identity is decided as: originKey bucket -> ownership
// validation -> full tuple comparison. An originKey match alone is never
// identity, and no fallback (lowest Root ID, first or last Root) is ever chosen.
// The lookup reads the committed origin bucket and the current Base bar's pending
// NEW_ROOT journal rows. Its only write is raising journalInvariantViolation, which
// only journalResetRaw clears. A matched Swing Root keeps its creation tfCode,
// originTime and originEndTime: nothing here writes a Root field.
// Business call sites = 0 in this Batch.
// ============================================================

// True when the incoming origin and the stored origin are the same Root origin.
// Read-only. An unknown incoming Category is a runtime error.
originTupleEqualRaw(int incomingCategory, int incomingSubtype, int incomingTfCode, int incomingPointTick, int incomingOriginTime, int incomingOriginEndTime, int incomingDirection, int storedCategory, int storedSubtype, int storedTfCode, int storedPointTick, int storedOriginTime, int storedOriginEndTime, int storedDirection) =>
    bool equal = false
    if incomingCategory == CAT_MA
        // fixed Root per EMA subtype on the 1m timeframe
        equal := storedCategory == CAT_MA and incomingTfCode == TF_1M and storedTfCode == TF_1M and not na(incomingSubtype) and incomingSubtype == storedSubtype
    else if incomingCategory == CAT_SWING
        bool tfOk   = (incomingTfCode == TF_5M or incomingTfCode == TF_15M or incomingTfCode == TF_1H) and (storedTfCode == TF_5M or storedTfCode == TF_15M or storedTfCode == TF_1H)
        bool baseOk = storedCategory == CAT_SWING and tfOk and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
        bool timeOk = not na(incomingOriginTime) and not na(incomingOriginEndTime) and not na(storedOriginTime) and not na(storedOriginEndTime)
        if baseOk and timeOk
            if incomingTfCode == storedTfCode
                // same TF: the same pivot only
                equal := incomingOriginTime == storedOriginTime and incomingOriginEndTime == storedOriginEndTime
            else if storedTfCode < incomingTfCode
                // stored is the lower TF: its origin inside the incoming [start, end)
                equal := storedOriginTime >= incomingOriginTime and storedOriginTime < incomingOriginEndTime
            else
                // incoming is the lower TF: its origin inside the stored [start, end)
                equal := incomingOriginTime >= storedOriginTime and incomingOriginTime < storedOriginEndTime
    else if incomingCategory == CAT_ACCUM
        // originTime is the Candidate start time; pairKey is never identity
        equal := storedCategory == CAT_ACCUM and not na(incomingTfCode) and incomingTfCode == storedTfCode and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_TIME_HL
        equal := storedCategory == CAT_TIME_HL and incomingTfCode == TF_5M and storedTfCode == TF_5M and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else if incomingCategory == CAT_FVG
        // originTime is the 3rd source bar open time
        equal := storedCategory == CAT_FVG and not na(incomingTfCode) and incomingTfCode == storedTfCode and (incomingDirection == FVG_BULLISH or incomingDirection == FVG_BEARISH) and incomingDirection == storedDirection and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_PSYCH
        // pointTick is the caller-normalized 50-dollar tick
        equal := storedCategory == CAT_PSYCH and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    equal

// Finds the unique existing origin among the committed bucket chain and the
// current bar's pending NEW_ROOT rows. Returns [rootSlot, pendingJournalRow]:
// [-1, -1] no match, [slot, -1] one committed match, [-1, row] one pending match.
// Two or more matches, a broken chain node or a chain longer than the Root slot
// count raise journalInvariantViolation and return [-1, -1].
originLookupUniqueRaw(ZoneEngine engine, int originKey, int category, int subtype, int tfCode, int pointTick, int originTime, int originEndTime, int direction, float mintick) =>
    int  matchCount        = 0
    int  matchedRootSlot   = SLOT_INVALID
    int  matchedPendingRow = SLOT_INVALID
    bool violation         = false
    if originKey != ID_NONE
        // Step 1 : committed Roots of this bucket only, never every Root
        if map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
            int slot      = map.get(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
            int stepLimit = array.size(engine.rootIds)
            int steps     = 0
            while slot != SLOT_INVALID and not violation and steps < stepLimit
                bool nodeOk = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootOriginKeys) and slot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and slot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
                if nodeOk
                    nodeOk := array.get(engine.rootSlotLiveFlags, slot)
                if nodeOk
                    int bucketRootId = array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, slot)
                    nodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(engine.rootIds, slot) and array.get(engine.rootOriginKeys, slot) == originKey
                if not nodeOk
                    violation := true
                else
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(engine.rootCategories, slot), array.get(engine.rootSubtypes, slot), array.get(engine.rootTfCodes, slot), array.get(engine.rootPointTicks, slot), array.get(engine.rootOriginTimes, slot), array.get(engine.rootOriginEndTimes, slot), array.get(engine.rootDirections, slot))
                        matchCount += 1
                        if matchCount == 1
                            matchedRootSlot := slot
                        else
                            violation := true
                    slot  := array.get(engine.w02Aux.rootOriginBucketNextRootSlots, slot)
                    steps += 1
            // a chain still running after one step per Root slot is a cycle
            if not violation and slot != SLOT_INVALID
                violation := true
        // Step 2 : pending NEW_ROOT rows of the current bar, logical rows only
        if not violation
            int journalCount = engine.w03Store.journalCount
            int row = 0
            while row < journalCount and not violation
                if array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and array.get(engine.w03Store.journalOriginKeys, row) == originKey
                    float pendingPrice = array.get(engine.w03Store.journalPointPrices, row)
                    int   pendingTick  = na(pendingPrice) ? int(na) : int(math.round(pendingPrice / mintick))
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(engine.w03Store.journalCategories, row), array.get(engine.w03Store.journalSubtypes, row), array.get(engine.w03Store.journalTfCodes, row), pendingTick, array.get(engine.w03Store.journalOriginTimes, row), array.get(engine.w03Store.journalOriginEndTimes, row), array.get(engine.w03Store.journalDirections, row))
                        matchCount += 1
                        if matchCount == 1
                            matchedPendingRow := row
                        else
                            violation := true
                row += 1
    // Step 3 : the only write - raise the preflight flag, never clear it
    if violation
        engine.w03Store.journalInvariantViolation := true
    [violation ? SLOT_INVALID : matchedRootSlot, violation ? SLOT_INVALID : matchedPendingRow]

// ============================================================
// W03 Batch 07 : point Root common price-order helpers (I11-3 / I6.2)
// Source: I6.2, I6.4, I11-3, D12
//
// Internal only. rootPriceOrderSlots holds point Roots only (MA, Swing, Confirmed
// Accum, TimeHL); a range Root (FVG) is never inserted, because the common-order
// key of a range Root is not fixed in W03. The key is rootPointTicks ascending -
// never a float price, never nativeBottom / nativeTop / midpoint.
// Equal ticks carry no business tie-break: a new Root goes after the existing
// equal-tick group (upper_bound) purely as a physical rule, and the order inside
// an equal-tick group is never a Candidate, Root ID, Category or slot order.
// Every helper validates first and mutates only after that, so false means zero
// mutation and no repair. Only the order array and its reverse positions change:
// no Root content, lifecycle, index or revision is touched, nothing is sorted or
// rebuilt, and no array.insert / array.remove is used.
// Business call sites = 0 in this Batch (upper bound is called by insert only).
// ============================================================

// Upper bound of pointTick in the order: the first position whose tick is greater.
// Returns [position, true], or [SLOT_INVALID, false] for a na tick or a visited
// entry that is not a valid point Root member. Read-only.
rootPriceOrderUpperBoundRaw(ZoneEngine engine, int pointTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(pointTick)
    if ok
        int lo = 0
        int hi = array.size(engine.rootPriceOrderSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2))
            int slot = array.get(engine.rootPriceOrderSlots, mid)
            bool entryOk = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if entryOk
                entryOk := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootPriceOrderPositions, slot) == mid and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot))
            if not entryOk
                ok := false
            else if array.get(engine.rootPointTicks, slot) <= pointTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Inserts one owned point Root at the upper bound of its tick. Returns true when
// committed; false with zero mutation on any failed check.
rootPriceOrderInsertRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int newTick   = int(na)
    int insertPos = SLOT_INVALID
    int oldSize   = array.size(engine.rootPriceOrderSlots)
    // Step 1 : the Root is a live, owned point Root not yet in the order
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        newTick := array.get(engine.rootPointTicks, rootSlot)
        ok      := not array.get(engine.rootIsRangeRootFlags, rootSlot) and not na(newTick) and array.get(engine.rootPriceOrderPositions, rootSlot) == SLOT_INVALID
    // Step 2 : insert position
    if ok
        [upperPos, upperOk] = rootPriceOrderUpperBoundRaw(engine, newTick)
        ok        := upperOk
        insertPos := upperPos
    // Step 3 : every entry that will shift right, plus the left neighbour
    if ok
        int i = insertPos
        while ok and i < oldSize
            int slot = array.get(engine.rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, slot) and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == i
            i += 1
    if ok and insertPos > 0
        int leftSlot = array.get(engine.rootPriceOrderSlots, insertPos - 1)
        ok := leftSlot >= 0 and leftSlot < array.size(engine.rootIds) and leftSlot < array.size(engine.rootSlotLiveFlags) and leftSlot < array.size(engine.rootPointTicks) and leftSlot < array.size(engine.rootIsRangeRootFlags) and leftSlot < array.size(engine.rootPriceOrderPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, leftSlot) and not array.get(engine.rootIsRangeRootFlags, leftSlot) and not na(array.get(engine.rootPointTicks, leftSlot)) and array.get(engine.rootPriceOrderPositions, leftSlot) == insertPos - 1
        if ok
            ok := array.get(engine.rootPointTicks, leftSlot) <= newTick
    if ok and insertPos < oldSize
        // upper_bound: the right neighbour must be strictly greater
        ok := array.get(engine.rootPointTicks, array.get(engine.rootPriceOrderSlots, insertPos)) > newTick
    // Step 4 : commit. Grow by one, shift the suffix right, then place the Root.
    if ok
        array.push(engine.rootPriceOrderSlots, rootSlot)
        int i = oldSize
        while i > insertPos
            int movedSlot = array.get(engine.rootPriceOrderSlots, i - 1)
            array.set(engine.rootPriceOrderSlots, i, movedSlot)
            array.set(engine.rootPriceOrderPositions, movedSlot, i)
            i -= 1
        array.set(engine.rootPriceOrderSlots, insertPos, rootSlot)
        array.set(engine.rootPriceOrderPositions, rootSlot, insertPos)
    ok

// Removes one owned point Root from the order. Returns true when committed;
// false with zero mutation on any failed check. The Root itself stays as it is.
rootPriceOrderDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int pos       = SLOT_INVALID
    int orderSize = array.size(engine.rootPriceOrderSlots)
    // Step 1 : the Root is a live, owned point Root sitting at its stored position
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        pos := array.get(engine.rootPriceOrderPositions, rootSlot)
        ok  := pos != SLOT_INVALID and pos >= 0 and pos < orderSize
    if ok
        ok := array.get(engine.rootPriceOrderSlots, pos) == rootSlot and not array.get(engine.rootIsRangeRootFlags, rootSlot) and not na(array.get(engine.rootPointTicks, rootSlot))
    // Step 2 : every entry that will shift left
    if ok
        int i = pos + 1
        while ok and i < orderSize
            int movedSlot = array.get(engine.rootPriceOrderSlots, i)
            ok := movedSlot >= 0 and movedSlot < array.size(engine.rootIds) and movedSlot < array.size(engine.rootSlotLiveFlags) and movedSlot < array.size(engine.rootPointTicks) and movedSlot < array.size(engine.rootIsRangeRootFlags) and movedSlot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, movedSlot) and not array.get(engine.rootIsRangeRootFlags, movedSlot) and not na(array.get(engine.rootPointTicks, movedSlot)) and array.get(engine.rootPriceOrderPositions, movedSlot) == i
            i += 1
    // Step 3 : commit. Shift the suffix left, drop the tail, clear the position.
    if ok
        int i = pos
        while i < orderSize - 1
            int movedSlot = array.get(engine.rootPriceOrderSlots, i + 1)
            array.set(engine.rootPriceOrderSlots, i, movedSlot)
            array.set(engine.rootPriceOrderPositions, movedSlot, i)
            i += 1
        array.pop(engine.rootPriceOrderSlots)
        array.set(engine.rootPriceOrderPositions, rootSlot, SLOT_INVALID)
    ok

// ============================================================
// W02 Batch 25 : participation edge row physical lifecycle (I11-7)
//
// Internal only, and physical only: these three helpers own one row of the flat
// participation edge pool and nothing else. They never touch
// rootParticipationHeadEdgeIndexes, rootParticipationCounts or any other edge's
// participationEdgeNextByRootIndexes, so a chain is never repaired, rebuilt or
// broken here; a later detach caller finishes its chain mutation first and calls
// the free helper last.
// An alloc hands back a physical row that is deliberately NOT live: its identity
// fields stay at their sentinels until a later add helper, in one synchronous path,
// validates everything, checks for a duplicate, fills the row, links the chain,
// updates the count and only then sets the live flag. A row must never be left
// allocated but uncommitted.
// Slots are reused, so a rootSlot or a sideSlot alone never proves an edge's
// identity: the row keeps expectedRootId and expectedCoreId as ownership tokens,
// and a reset returns both to ID_NONE so an old owner token is never carried over.
// The future validation, which this Batch does not implement, is
//   Root : rootSlot in range, rootSlotLiveFlags[rootSlot], rootIds[rootSlot] ==
//          expectedRootId
//   Core : sideSlot >= 0, coreSlot = int(math.floor(sideSlot / 2)) in range,
//          coreSlotLiveFlags[coreSlot], coreIds[coreSlot] == expectedCoreId
// and a Generation ID is never an ownership token, so none is stored in a row.
// The future detach contract, also not implemented here: validate the Root
// ownership, walk the chain to find the edge and its predecessor, verify the edge's
// live flag and all four identity fields, check rootParticipationCounts against the
// real chain length, and only once all of that holds update the predecessor's next
// or the Root head, decrement the count, and free the row last. On any mismatch:
// zero mutation, no repair and no partial detach.
// The Side address stays the physical sideSlot (coreSlot * 2 + sideIndex, 0 =
// Support, 1 = Resistance); the SIDE_SUPPORT / SIDE_RESISTANCE codes are never
// stored in a row.
// participationEdgeFreeIndexes is a LIFO stack: alloc pops, free pushes, and
// array.remove(0) / array.shift() / array.unshift() are never used. The six row
// arrays always share one size and are never shrunk.
// Call sites: participationEdgeResetRaw is called by the alloc and free helpers
// below, participationEdgeAllocRaw by the Batch 26 add helper, and
// participationEdgeFreeRaw by the Batch 27 single detach, the Batch 28 detach-all
// for a Root and the Batch 30 detach-all for a Core. No Production Stage, Candidate
// or Core association path calls any of them, so the runtime still holds no
// physical edge row, no free row and no live edge.
// ============================================================

// Returns one existing physical edge row to the unused / free sentinel state: it
// owns no Root, no Core / Side, has no chain successor and is not live. The free
// stack is not touched. Precondition: the row already exists; no range check helper
// and no runtime.error is added here.
participationEdgeResetRaw(ZoneEngine engine, int edgeIndex) =>
    array.set(engine.participationEdgeRootSlots,         edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeExpectedRootIds,   edgeIndex, ID_NONE)
    array.set(engine.participationEdgeSideSlots,         edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeExpectedCoreIds,   edgeIndex, ID_NONE)
    array.set(engine.participationEdgeNextByRootIndexes, edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeLiveFlags,         edgeIndex, false)

// Reserves one physical edge row and returns its index. A freed row is reused first
// (LIFO pop, then reset), otherwise the six row arrays grow by exactly one sentinel
// entry. The row comes back NOT live and with every identity field at its sentinel:
// making it live is the later add helper's atomic commit.
participationEdgeAllocRaw(ZoneEngine engine) =>
    int edgeIndex = SLOT_INVALID
    if array.size(engine.participationEdgeFreeIndexes) > 0
        edgeIndex := array.pop(engine.participationEdgeFreeIndexes)
        participationEdgeResetRaw(engine, edgeIndex)
    else
        edgeIndex := array.size(engine.participationEdgeRootSlots)
        array.push(engine.participationEdgeRootSlots,         SLOT_INVALID)
        array.push(engine.participationEdgeExpectedRootIds,   ID_NONE)
        array.push(engine.participationEdgeSideSlots,         SLOT_INVALID)
        array.push(engine.participationEdgeExpectedCoreIds,   ID_NONE)
        array.push(engine.participationEdgeNextByRootIndexes, SLOT_INVALID)
        array.push(engine.participationEdgeLiveFlags,         false)
    edgeIndex

// Releases one live physical edge row and returns true. An index out of range or a
// row that is not live returns false with zero mutation, so freeing the same row
// twice never pushes it onto the free stack twice. The row is reset and then enters
// the free stack exactly once; the arrays are never shrunk. The Root head, the Root
// count and every other edge's chain link are left exactly as they are: the caller
// must have completed its chain detach before calling this.
participationEdgeFreeRaw(ZoneEngine engine, int edgeIndex) =>
    bool freed = false
    if edgeIndex >= 0 and edgeIndex < array.size(engine.participationEdgeLiveFlags)
        if array.get(engine.participationEdgeLiveFlags, edgeIndex)
            participationEdgeResetRaw(engine, edgeIndex)
            array.push(engine.participationEdgeFreeIndexes, edgeIndex)
            freed := true
    freed

// ============================================================
// W02 Batch 26 : participation chain validation, duplicate check, atomic add (I11-7)
//
// Internal only. An edge's identity is Root ID + Core ID + Side, never a rootSlot
// or a sideSlot on its own, so the row keeps expectedRootId and expectedCoreId and
// both are re-checked against the slots that hold them.
// The two validation helpers are strictly read-only: no head, count, row, chain or
// free stack write, and no repair of an inconsistency they find.
// The add helper decides everything before it touches anything: Root ownership,
// Side address and Core ownership, the whole chain, the duplicate check and the
// free stack top are all settled first, so a rejected add allocates nothing, frees
// nothing and mutates nothing. Only after that does it take a row, fill it, link it
// at the head, raise the count and set the live flag last, as the commit marker,
// with no fallible step after it.
// A new edge goes to the head because the chain has no order semantics: it is never
// a Root ID, Core ID, Side, Candidate or price order.
// The atomic detach lives in the Batch 27 section below. The Root free detach, the
// Core free detach, Candidate adoption and Core association are still absent, and no
// Production Stage, Candidate or Core logic calls any of this: the runtime holds 0
// edges.
// ============================================================

// True only when this Root's participation chain is exactly consistent: the Root is
// live and owned, the six edge row arrays share one size, head and count agree with
// each other, and walking count edges from the head visits count live rows that all
// belong to this Root, whose Side address and Core ownership still hold, and ends
// exactly at SLOT_INVALID. A short chain, a long chain, a cycle or a stale row makes
// it false. Read-only: nothing is mutated and nothing is repaired.
participationRootChainValidRaw(ZoneEngine engine, int rootSlot) =>
    bool valid = false
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if ok
        // every edge row array must share one physical size
        ok := edgeRowCount == array.size(engine.participationEdgeExpectedRootIds) and edgeRowCount == array.size(engine.participationEdgeSideSlots) and edgeRowCount == array.size(engine.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(engine.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(engine.participationEdgeLiveFlags)
    if ok
        int rootId = array.get(engine.rootIds,                           rootSlot)
        int head   = array.get(engine.rootParticipationHeadEdgeIndexes,  rootSlot)
        int count  = array.get(engine.rootParticipationCounts,           rootSlot)
        if count < 0 or count > edgeRowCount
            ok := false
        if ok and count == 0
            valid := head == SLOT_INVALID
        if ok and count > 0
            bool chainOk   = head != SLOT_INVALID
            int  edgeIndex = head
            int  seen      = 0
            // bounded by count: every pass either advances seen or ends the walk
            while chainOk and seen < count
                bool rowOk = edgeIndex >= 0 and edgeIndex < edgeRowCount
                if rowOk
                    rowOk := array.get(engine.participationEdgeLiveFlags, edgeIndex)
                if rowOk
                    rowOk := array.get(engine.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, edgeIndex) == rootId
                int edgeSideSlot = SLOT_INVALID
                int edgeCoreSlot = SLOT_INVALID
                if rowOk
                    edgeSideSlot := array.get(engine.participationEdgeSideSlots, edgeIndex)
                    rowOk := edgeSideSlot >= 0 and edgeSideSlot < array.size(engine.sidePhases)
                if rowOk
                    edgeCoreSlot := int(math.floor(edgeSideSlot / 2))
                    int edgeSideIndex = edgeSideSlot - edgeCoreSlot * 2
                    rowOk := (edgeSideIndex == 0 or edgeSideIndex == 1) and edgeCoreSlot >= 0 and edgeCoreSlot < array.size(engine.coreIds) and edgeCoreSlot < array.size(engine.coreSlotLiveFlags)
                if rowOk
                    rowOk := array.get(engine.coreSlotLiveFlags, edgeCoreSlot)
                if rowOk
                    int edgeExpectedCoreId = array.get(engine.participationEdgeExpectedCoreIds, edgeIndex)
                    rowOk := edgeExpectedCoreId != ID_NONE and array.get(engine.coreIds, edgeCoreSlot) == edgeExpectedCoreId
                if rowOk
                    edgeIndex := array.get(engine.participationEdgeNextByRootIndexes, edgeIndex)
                    seen      += 1
                else
                    chainOk := false
            if chainOk
                valid := seen == count and edgeIndex == SLOT_INVALID
    valid

// True when this Root already holds a live edge with the same Root ID, Side address
// and Core ID. The caller has validated the chain and the ownership first; the walk
// is bounded by the Root's count. Read-only.
participationDuplicateExistsRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int sideSlot, int expectedCoreId) =>
    bool found = false
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if rootSlot >= 0 and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
        int count     = array.get(engine.rootParticipationCounts,          rootSlot)
        int edgeIndex = array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        int seen      = 0
        while not found and seen < count and edgeIndex >= 0 and edgeIndex < edgeRowCount
            bool sameEdge = array.get(engine.participationEdgeLiveFlags, edgeIndex)
            if sameEdge
                sameEdge := array.get(engine.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, edgeIndex) == expectedRootId and array.get(engine.participationEdgeSideSlots, edgeIndex) == sideSlot and array.get(engine.participationEdgeExpectedCoreIds, edgeIndex) == expectedCoreId
            if sameEdge
                found := true
            else
                edgeIndex := array.get(engine.participationEdgeNextByRootIndexes, edgeIndex)
                seen      += 1
    found

// Adds one participation edge for this Root and this physical Side, returning true
// only when it was committed. Every rejection happens before the row is taken, so a
// false result means zero mutation: no alloc, no free, no head, count or row write.
participationAddRaw(ZoneEngine engine, int rootSlot, int sideSlot) =>
    bool added = false
    // Step 1 : Root ownership preflight
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    // Step 2 : target Side address and Core ownership preflight
    bool sideOk         = rootOk and sideSlot >= 0 and sideSlot < array.size(engine.sidePhases)
    int  coreSlot       = SLOT_INVALID
    int  expectedCoreId = ID_NONE
    if sideOk
        coreSlot      := int(math.floor(sideSlot / 2))
        int sideIndex = sideSlot - coreSlot * 2
        sideOk        := (sideIndex == 0 or sideIndex == 1) and coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    if sideOk
        sideOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if sideOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        sideOk         := expectedCoreId != ID_NONE
    // Step 3 : the Root's whole chain must already be consistent
    bool ready = sideOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    // Step 4 : one live edge per Root ID + Core ID + Side
    if ready
        ready := not participationDuplicateExistsRaw(engine, rootSlot, expectedRootId, sideSlot, expectedCoreId)
    // Step 5 : the row the free stack would hand back must be usable
    if ready
        int freeCount = array.size(engine.participationEdgeFreeIndexes)
        if freeCount > 0
            int topIndex = array.get(engine.participationEdgeFreeIndexes, freeCount - 1)
            ready := topIndex >= 0 and topIndex < array.size(engine.participationEdgeRootSlots)
            if ready
                ready := not array.get(engine.participationEdgeLiveFlags, topIndex)
    // Step 6..9 : commit. Nothing below can fail.
    if ready
        int oldHead   = array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        int oldCount  = array.get(engine.rootParticipationCounts,          rootSlot)
        int edgeIndex = participationEdgeAllocRaw(engine)
        array.set(engine.participationEdgeRootSlots,         edgeIndex, rootSlot)
        array.set(engine.participationEdgeExpectedRootIds,   edgeIndex, expectedRootId)
        array.set(engine.participationEdgeSideSlots,         edgeIndex, sideSlot)
        array.set(engine.participationEdgeExpectedCoreIds,   edgeIndex, expectedCoreId)
        array.set(engine.participationEdgeNextByRootIndexes, edgeIndex, oldHead)
        array.set(engine.rootParticipationHeadEdgeIndexes,   rootSlot,  edgeIndex)
        array.set(engine.rootParticipationCounts,            rootSlot,  oldCount + 1)
        // live last: this is the commit marker of the whole add
        array.set(engine.participationEdgeLiveFlags,         edgeIndex, true)
        added := true
    added

// ============================================================
// W02 Batch 27 : participation atomic detach (I11-7)
//
// Internal only. The edge to remove is identified as Root ID + Core ID + Side, so
// all four stored fields (rootSlot, expectedRootId, sideSlot, expectedCoreId) must
// match; a rootSlot or a sideSlot alone never selects an edge.
// Nothing is written until the target and its predecessor are fully settled: the
// Root ownership, the Side address, the Core ownership, the whole chain, a unique
// match and the predecessor link are all decided first. A rejection therefore
// leaves head, count, every row and the free stack untouched - no repair, no
// partial detach, and a broken or duplicated chain is never patched up here.
// Once it commits, the order is fixed: unlink (Root head or the predecessor's
// next), decrement the count, and free the row last, with nothing fallible after
// the free.
// The chain keeps no order semantics after a detach either: it is never a Root ID,
// Core ID, Side, Candidate, price or Event order.
// This helper removes ONE edge. Releasing every edge of a Root is the Batch 28
// helper below, which is a separate all-or-nothing implementation and never a loop
// over this one, and which rootFreeSlotRaw calls before it ends a Root's ownership.
// This single-edge helper itself has no call site yet. The Core free detach,
// Candidate adoption and Core association are still absent, and no Production
// business path reaches any of it, so the runtime still holds 0 edges.
// ============================================================

// Removes this Root's live edge for the given physical Side and returns true only
// when it was committed. Returns false with zero mutation when any preflight fails,
// when the chain is inconsistent, when no edge matches, or when more than one does.
participationDetachRaw(ZoneEngine engine, int rootSlot, int sideSlot) =>
    bool detached = false
    // Step 1 : Root ownership preflight
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    // Step 2 : target Side address and Core ownership preflight
    bool sideOk         = rootOk and sideSlot >= 0 and sideSlot < array.size(engine.sidePhases)
    int  coreSlot       = SLOT_INVALID
    int  expectedCoreId = ID_NONE
    if sideOk
        coreSlot      := int(math.floor(sideSlot / 2))
        int sideIndex = sideSlot - coreSlot * 2
        sideOk        := (sideIndex == 0 or sideIndex == 1) and coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    if sideOk
        sideOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if sideOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        sideOk         := expectedCoreId != ID_NONE
    // Step 3 : the whole chain must already be consistent, and hold at least one edge
    bool ready    = sideOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    int oldHead  = SLOT_INVALID
    int oldCount = 0
    if ready
        oldHead  := array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        oldCount := array.get(engine.rootParticipationCounts,          rootSlot)
        ready    := oldCount > 0
    // Step 4 : bounded scan for the target, its predecessor and its successor
    int targetEdgeIndex         = SLOT_INVALID
    int targetPreviousEdgeIndex = SLOT_INVALID
    int targetNextEdgeIndex     = SLOT_INVALID
    int matchCount              = 0
    int seen                    = 0
    int scanEdgeIndex           = oldHead
    int previousEdgeIndex       = SLOT_INVALID
    if ready
        int edgeRowCount = array.size(engine.participationEdgeRootSlots)
        // bounded by oldCount: every pass advances seen
        while seen < oldCount and scanEdgeIndex >= 0 and scanEdgeIndex < edgeRowCount
            bool isTarget = array.get(engine.participationEdgeLiveFlags, scanEdgeIndex)
            if isTarget
                isTarget := array.get(engine.participationEdgeRootSlots, scanEdgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, scanEdgeIndex) == expectedRootId and array.get(engine.participationEdgeSideSlots, scanEdgeIndex) == sideSlot and array.get(engine.participationEdgeExpectedCoreIds, scanEdgeIndex) == expectedCoreId
            int nextEdgeIndex = array.get(engine.participationEdgeNextByRootIndexes, scanEdgeIndex)
            if isTarget
                matchCount += 1
                if matchCount == 1
                    targetEdgeIndex         := scanEdgeIndex
                    targetPreviousEdgeIndex := previousEdgeIndex
                    targetNextEdgeIndex     := nextEdgeIndex
            previousEdgeIndex := scanEdgeIndex
            scanEdgeIndex     := nextEdgeIndex
            seen              += 1
        // the scan itself must have covered exactly the whole chain
        ready := seen == oldCount and scanEdgeIndex == SLOT_INVALID
    // Step 5 : exactly one edge may match. 0 = nothing to detach, >1 = corruption.
    if ready
        ready := matchCount == 1
    if ready
        ready := targetEdgeIndex >= 0 and targetEdgeIndex < array.size(engine.participationEdgeLiveFlags)
    if ready
        ready := array.get(engine.participationEdgeLiveFlags, targetEdgeIndex)
    // Step 6 : the predecessor link must agree with where the target was found
    if ready
        if targetPreviousEdgeIndex == SLOT_INVALID
            ready := targetEdgeIndex == oldHead
        else
            ready := targetPreviousEdgeIndex >= 0 and targetPreviousEdgeIndex < array.size(engine.participationEdgeNextByRootIndexes)
            if ready
                ready := array.get(engine.participationEdgeNextByRootIndexes, targetPreviousEdgeIndex) == targetEdgeIndex
    // Step 7 : commit. Unlink, then the count, then the row. Nothing below can fail.
    if ready
        if targetPreviousEdgeIndex == SLOT_INVALID
            array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, targetNextEdgeIndex)
        else
            array.set(engine.participationEdgeNextByRootIndexes, targetPreviousEdgeIndex, targetNextEdgeIndex)
        array.set(engine.rootParticipationCounts, rootSlot, oldCount - 1)
        // free last: the row was verified live above and its flag was not touched since
        detached := participationEdgeFreeRaw(engine, targetEdgeIndex)
    detached

// ============================================================
// W02 Batch 28 : participation atomic detach-all for Root (I11-7)
//
// Internal only. This releases every participation edge of one Root in a single
// all-or-nothing step. It is deliberately NOT a loop over the Batch 27 single
// detach: repeating that helper would leave the earlier edges gone if a later one
// failed, which is exactly the partial detach this contract forbids. Instead the
// whole chain is validated and re-walked first, and only then is anything written.
// A rejection leaves the head, the count, every row and the free stack untouched,
// and a broken chain or an edge pointing at a stale Core is never repaired here.
// The free order follows the chain from head to tail, which carries no meaning: it
// is never a Root ID, Core ID, Side, Candidate, price or Event order.
// rootFreeSlotRaw calls this before it ends a Root's ownership, so a freed Root
// never leaves participation edges behind; a false from here simply cancels that
// free. The matching Core-side helper is the Batch 30 section below, which
// coreFreeSlotRaw calls the same way since Batch 31. No Production Stage,
// Candidate or Core association path reaches either, so the runtime still holds
// 0 edges.
// ============================================================

// Detaches and frees all participation edges of this Root, returning true when the
// Root ends with no participation. A Root that already has none returns true
// without mutating anything. Returns false with zero mutation when the Root is not
// a live owned slot, when its chain is inconsistent, or when the pre-commit walk
// does not match the recorded count exactly.
participationDetachAllForRootRaw(ZoneEngine engine, int rootSlot) =>
    bool done = false
    // Step 1 : Root ownership preflight
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    // Step 2 : the whole chain must already be consistent
    bool ready = rootOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    int oldHead  = SLOT_INVALID
    int oldCount = 0
    if ready
        oldHead  := array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        oldCount := array.get(engine.rootParticipationCounts,          rootSlot)
    // Step 3 : nothing to detach is a success, and writes nothing. The chain
    // validation already guarantees head = SLOT_INVALID when the count is 0.
    if ready and oldCount == 0
        done := true
    // Step 4 : pre-commit walk of exactly oldCount edges
    bool commitReady = ready and oldCount > 0
    if commitReady
        int  edgeRowCount  = array.size(engine.participationEdgeRootSlots)
        int  scanEdgeIndex = oldHead
        int  seen          = 0
        bool scanOk        = true
        // bounded by oldCount: every pass advances seen or ends the walk
        while scanOk and seen < oldCount
            bool rowOk = scanEdgeIndex >= 0 and scanEdgeIndex < edgeRowCount
            if rowOk
                rowOk := array.get(engine.participationEdgeLiveFlags, scanEdgeIndex)
            if rowOk
                rowOk := array.get(engine.participationEdgeRootSlots, scanEdgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, scanEdgeIndex) == expectedRootId
            if rowOk
                scanEdgeIndex := array.get(engine.participationEdgeNextByRootIndexes, scanEdgeIndex)
                seen          += 1
            else
                scanOk := false
        commitReady := scanOk and seen == oldCount and scanEdgeIndex == SLOT_INVALID
    // Step 5 : commit. Root metadata first, then every row. Nothing below can fail.
    if commitReady
        array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, SLOT_INVALID)
        array.set(engine.rootParticipationCounts,          rootSlot, 0)
        int freeEdgeIndex = oldHead
        int freed         = 0
        while freed < oldCount
            // read the successor before the row is reset by the free
            int nextEdgeIndex = array.get(engine.participationEdgeNextByRootIndexes, freeEdgeIndex)
            participationEdgeFreeRaw(engine, freeEdgeIndex)
            freeEdgeIndex := nextEdgeIndex
            freed         += 1
        done := true
    done

// ============================================================
// W02 Batch 30 : participation atomic detach-all for Core (I11-7)
//
// Internal only. It removes every participation edge that points at one Core - both
// its Support and its Resistance Side - from every Root chain, in a single
// all-or-nothing step. It is deliberately not a loop over the single detach, which
// would leave the earlier Roots changed if a later one failed.
// The index has no Core -> edge reverse chain and none is added here: no new field,
// no map and no nested collection. The Root chains and the flat edge pool are all
// it uses, so the work is a global preflight followed by a global commit.
// The preflight is strict and never repairs anything: Core ownership, both Side
// addresses, the edge pool and Root metadata sizes, every live Root's chain, dead
// Roots carrying no participation, and the sum of the chain counts matching the
// number of live rows, so a live row that no chain reaches (an orphan) is rejected
// rather than silently freed. An edge whose slot says this Core but whose
// expectedCoreId does not, or the reverse, is a stale identity conflict and is
// rejected too.
// The commit then runs in two phases: Phase A rebuilds the chains of the affected
// Roots without touching the target rows, and Phase B frees those rows, which are
// still live because Phase A never changed a live flag, a Side slot or an expected
// Core ID. Nothing after the commit begins can fail.
// This helper touches participation only: no Root ownership, no Core ownership and
// no Phase set membership. Since Batch 31 coreFreeSlotRaw calls it before it ends
// a Core's ownership, so a freed Core never leaves participation edges behind and a
// false from here simply cancels that free. No Production Stage, Candidate or Core
// association path reaches it, so the runtime holds 0 edges.
// ============================================================

// Detaches and frees every participation edge of this Core's two Sides, returning
// true when the Core ends with no participation. A Core that has none returns true
// without mutating anything. Returns false with zero mutation when the Core is not
// a live owned slot, when any live Root chain is inconsistent, when a dead Root
// still carries participation metadata, when a live row is unreachable from every
// chain, or when an edge's Core identity is self-contradictory.
participationDetachAllForCoreRaw(ZoneEngine engine, int coreSlot) =>
    bool done = false
    // Step 1 : Core ownership preflight
    bool coreOk         = coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    int  expectedCoreId = ID_NONE
    if coreOk
        coreOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if coreOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        coreOk         := expectedCoreId != ID_NONE
    // Step 2 : both physical Side addresses of this Core must exist
    int  supportSideSlot    = coreSlot * 2
    int  resistanceSideSlot = coreSlot * 2 + 1
    bool ready = coreOk and supportSideSlot >= 0 and resistanceSideSlot < array.size(engine.sidePhases)
    // Step 3 : the six edge row arrays must share one physical size
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if ready
        ready := edgeRowCount == array.size(engine.participationEdgeExpectedRootIds) and edgeRowCount == array.size(engine.participationEdgeSideSlots) and edgeRowCount == array.size(engine.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(engine.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(engine.participationEdgeLiveFlags)
    // Step 4 : the Root metadata arrays must match the Root SoA size
    int rootRowCount = array.size(engine.rootIds)
    if ready
        ready := rootRowCount == array.size(engine.rootSlotLiveFlags) and rootRowCount == array.size(engine.rootParticipationHeadEdgeIndexes) and rootRowCount == array.size(engine.rootParticipationCounts)
    // Step 5 : every live Root's chain must be valid, every dead Root must carry no
    // participation, and the chain counts are summed.
    int chainEdgeCount = 0
    if ready
        int rootScan = 0
        while ready and rootScan < rootRowCount
            if array.get(engine.rootSlotLiveFlags, rootScan)
                if participationRootChainValidRaw(engine, rootScan)
                    chainEdgeCount += array.get(engine.rootParticipationCounts, rootScan)
                else
                    ready := false
            else
                ready := array.get(engine.rootParticipationHeadEdgeIndexes, rootScan) == SLOT_INVALID and array.get(engine.rootParticipationCounts, rootScan) == 0
            rootScan += 1
    // Step 6 : count the live rows and this Core's rows, rejecting identity conflicts
    int liveEdgeCount   = 0
    int targetEdgeCount = 0
    if ready
        int edgeScan = 0
        while ready and edgeScan < edgeRowCount
            if array.get(engine.participationEdgeLiveFlags, edgeScan)
                liveEdgeCount += 1
                int scanSideSlot = array.get(engine.participationEdgeSideSlots, edgeScan)
                int scanCoreSlot = scanSideSlot >= 0 ? int(math.floor(scanSideSlot / 2)) : SLOT_INVALID
                bool slotMatch = scanCoreSlot == coreSlot
                bool idMatch   = array.get(engine.participationEdgeExpectedCoreIds, edgeScan) == expectedCoreId
                if slotMatch != idMatch
                    // stale identity: this Core's slot with another Core ID, or this
                    // Core ID on another slot. Never cleaned up here.
                    ready := false
                else if slotMatch
                    targetEdgeCount += 1
            edgeScan += 1
    // Step 7 : every live row must be reachable from exactly the chains
    if ready
        ready := chainEdgeCount == liveEdgeCount
    // Step 8 : a Core with no participation is already done, and writes nothing
    if ready and targetEdgeCount == 0
        done := true
    bool commitReady = ready and targetEdgeCount > 0
    // Step 9 : commit Phase A - rebuild the chains of the affected Roots only
    if commitReady
        int rootIdx = 0
        while rootIdx < rootRowCount
            if array.get(engine.rootSlotLiveFlags, rootIdx)
                int oldHead  = array.get(engine.rootParticipationHeadEdgeIndexes, rootIdx)
                int oldCount = array.get(engine.rootParticipationCounts,          rootIdx)
                // how many of this chain's edges belong to the Core. No mutation.
                int removeCount = 0
                int countIdx    = oldHead
                int counted     = 0
                while counted < oldCount
                    int countSideSlot = array.get(engine.participationEdgeSideSlots, countIdx)
                    int countCoreSlot = countSideSlot >= 0 ? int(math.floor(countSideSlot / 2)) : SLOT_INVALID
                    if countCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, countIdx) == expectedCoreId
                        removeCount += 1
                    countIdx := array.get(engine.participationEdgeNextByRootIndexes, countIdx)
                    counted  += 1
                // an unaffected Root keeps its head, its count and every link
                if removeCount > 0
                    int  newHead               = SLOT_INVALID
                    int  previousKeptEdgeIndex = SLOT_INVALID
                    int  keptCount             = 0
                    int  rebuildIdx            = oldHead
                    int  walked                = 0
                    while walked < oldCount
                        // the successor is read before any link is rewritten
                        int  nextEdgeIndex   = array.get(engine.participationEdgeNextByRootIndexes, rebuildIdx)
                        int  rebuildSideSlot = array.get(engine.participationEdgeSideSlots, rebuildIdx)
                        int  rebuildCoreSlot = rebuildSideSlot >= 0 ? int(math.floor(rebuildSideSlot / 2)) : SLOT_INVALID
                        bool isTarget        = rebuildCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, rebuildIdx) == expectedCoreId
                        if not isTarget
                            if newHead == SLOT_INVALID
                                newHead := rebuildIdx
                            if previousKeptEdgeIndex != SLOT_INVALID
                                array.set(engine.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, rebuildIdx)
                            previousKeptEdgeIndex := rebuildIdx
                            keptCount             += 1
                        // a target row is left completely untouched until Phase B
                        rebuildIdx := nextEdgeIndex
                        walked     += 1
                    if previousKeptEdgeIndex != SLOT_INVALID
                        array.set(engine.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, SLOT_INVALID)
                    array.set(engine.rootParticipationHeadEdgeIndexes, rootIdx, newHead)
                    array.set(engine.rootParticipationCounts,          rootIdx, keptCount)
            rootIdx += 1
        // Step 10 : commit Phase B - free this Core's rows. They are still live.
        int freeIdx = 0
        while freeIdx < edgeRowCount
            if array.get(engine.participationEdgeLiveFlags, freeIdx)
                int freeSideSlot = array.get(engine.participationEdgeSideSlots, freeIdx)
                int freeCoreSlot = freeSideSlot >= 0 ? int(math.floor(freeSideSlot / 2)) : SLOT_INVALID
                if freeCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, freeIdx) == expectedCoreId
                    participationEdgeFreeRaw(engine, freeIdx)
            freeIdx += 1
        done := true
    done

// ============================================================
// W02 Batch 41 : TouchStartSnapshot Root-copy node raw lifecycle
// Source: A6.5, I6.1, D02, D12
//
// Internal only, and raw in the same sense as the Batch 25 participation edge
// helpers: they own one physical row of the Batch 40 Root-copy node pool and
// nothing else. They never touch a Side's head, tail or count, never follow or
// repair a chain, never look at ownerSideSlot / expectedCoreId /
// expectedGenerationId / expectedTouchNo to decide anything, and never read or
// write a Snapshot scalar.
// The seven node arrays always share one physical size, so one node index names
// the same row in all seven. They are never shrunk: a freed row goes back through
// the free stack (LIFO) and is reused, exactly as the Root, Core and participation
// pools do. Only a row that is currently not live and not reachable from any chain
// may sit in the free stack, and never twice.
// alloc is not an ownership commit: a newly allocated row stays live = false and
// carries only sentinels. A later append helper writes the Root ID, the owner
// token and the chain link, updates the Side metadata and sets live = true last,
// so a row that is live is a row that is fully committed. Batch 41 never writes
// live = true and never writes a real Root ID, Core ID, Generation ID or TouchNo.
// free is the mirror: it only accepts a live row, resets it and returns it to the
// free stack, so freeing the same row twice pushes it once. Its precondition is
// that the caller has already detached the row from its chain - this helper leaves
// head, tail, count and every other node's next untouched, and validates no
// ownership. That detach helper does not exist yet.
// Production call sites = 0 in this Batch: nothing allocates or frees a node, so
// the pool and the free stack both stay empty and real Root-copy nodes = 0.
// ============================================================

// Returns one existing physical Root-copy node row to the unset sentinel.
// Precondition: the row already exists in the seven node arrays. No range check
// and no runtime.error is added here, and the free stack is not touched.
touchStartSnapshotRootNodeResetRaw(ZoneEngine engine, int nodeIndex) =>
    array.set(engine.w02Aux.touchStartSnapshotRootNodeRootIds,               nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeNextIndexes,           nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeOwnerSideSlots,        nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedCoreIds,       nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedGenerationIds, nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedTouchNos,      nodeIndex, 0)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags,             nodeIndex, false)

// Starts one physical Root-copy node row and returns its node index.
// Free rows are reused first (LIFO pop, then reset); otherwise the seven node
// arrays grow by one sentinel entry each. The returned row is NOT committed: it
// stays live = false with sentinel identity, and a later append helper is what
// turns it into a member of a Snapshot's chain.
touchStartSnapshotRootNodeAllocRaw(ZoneEngine engine) =>
    int nodeIndex = SLOT_INVALID
    // Step 1 / Step 2 : free stack first, LIFO. Never array.shift / array.remove(0).
    if array.size(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes) > 0
        nodeIndex := array.pop(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes)
        touchStartSnapshotRootNodeResetRaw(engine, nodeIndex)
    else
        nodeIndex := array.size(engine.w02Aux.touchStartSnapshotRootNodeRootIds)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeRootIds,               ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeNextIndexes,           SLOT_INVALID)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeOwnerSideSlots,        SLOT_INVALID)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedCoreIds,       ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedGenerationIds, ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedTouchNos,      0)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags,             false)
    // Step 3 : the row exists and is unset. live stays false - allocation is not
    // ownership, and nothing here joins a chain or a Side.
    nodeIndex

// Moves one currently live physical Root-copy node row back to the free state.
// Returns true only when the row was freed. An out-of-range index or a row that is
// not live returns false with no mutation, so a second free of the same row never
// pushes it into the free stack twice.
// Precondition: the caller has already detached this row from its Side's chain.
// This helper never touches head, tail, count or another node's next, and never
// validates the owner token.
touchStartSnapshotRootNodeFreeRaw(ZoneEngine engine, int nodeIndex) =>
    bool freed = false
    // Step 1 : range. The live read is nested so it never runs on a bad index.
    if nodeIndex >= 0 and nodeIndex < array.size(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags)
        if array.get(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags, nodeIndex)
            // Step 2 : the row goes back to the unset sentinel, live last of all
            // because the reset writes it false.
            touchStartSnapshotRootNodeResetRaw(engine, nodeIndex)
            // Step 3 : freed row enters the free stack exactly once. The arrays are
            // never shrunk.
            array.push(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes, nodeIndex)
            freed := true
    freed

// ============================================================
// W02 Batch 45 : BreakSnapshot Root-copy node raw lifecycle
// Source: A6.6, A6.7, I6.1, D02, D12
//
// Internal only, and raw in the same sense as the Batch 41 TouchStart node helpers:
// they own one physical row of the Batch 44 BreakSnapshot Root-copy pool and
// nothing else. They never touch a Side's head, tail or count, never follow or
// repair a chain, never look at ownerSideSlot / expectedCoreId /
// expectedGenerationId / expectedBreakSeq to decide anything, and never read or
// write a BreakSnapshot scalar.
// This is a separate pool from the TouchStart one, so these three helpers are
// separate too: they are never merged with the Batch 41 helpers and never touch
// the TouchStart arrays or its free stack.
// The seven node arrays always share one physical size, so one node index names
// the same row in all seven. They are never shrunk: a freed row goes back through
// the free stack (LIFO) and is reused, as the Root, Core, participation and
// TouchStart pools all do. Only a row that is not live and reachable from no chain
// may sit in the free stack, and never twice.
// alloc is not an ownership commit: a newly allocated row stays live = false and
// carries only sentinels. A later append helper writes the Root ID, the owner token
// (sideSlot, Core ID, Generation ID, break Seq) and the chain link, updates the Side
// metadata and sets live = true last, so a live row is a fully committed row. Batch
// 45 never writes live = true and never writes a real Root ID, Core ID, Generation
// ID or break Seq.
// free is the mirror: it accepts only a live row, resets it and returns it to the
// free stack, so freeing the same row twice pushes it once. Its precondition is
// that the caller has already detached the row from its chain - this helper leaves
// head, tail, count and every other node's next untouched, and validates no
// ownership. That detach helper does not exist yet.
// Production call sites = 0 in this Batch: nothing allocates or frees a node, so
// the pool and the free stack both stay empty and real Root-copy nodes = 0.
// ============================================================

// Returns one existing physical BreakSnapshot Root-copy node row to the unset
// sentinel. Precondition: the row already exists in the seven node arrays. No range
// check and no runtime.error is added here, and the free stack is not touched.
breakSnapshotRootNodeResetRaw(ZoneEngine engine, int nodeIndex) =>
    array.set(engine.w02Aux.breakSnapshotRootNodeRootIds,               nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeNextIndexes,           nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.breakSnapshotRootNodeOwnerSideSlots,        nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedCoreIds,       nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedGenerationIds, nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedBreakSeqs,     nodeIndex, SEQ_UNSET)
    array.set(engine.w02Aux.breakSnapshotRootNodeLiveFlags,             nodeIndex, false)

// Starts one physical BreakSnapshot Root-copy node row and returns its node index.
// Free rows are reused first (LIFO pop, then reset); otherwise the seven node
// arrays grow by one sentinel entry each. The returned row is NOT committed: it
// stays live = false with sentinel identity, and a later append helper is what
// turns it into a member of a Snapshot's chain.
breakSnapshotRootNodeAllocRaw(ZoneEngine engine) =>
    int nodeIndex = SLOT_INVALID
    // Step 1 / Step 2 : free stack first, LIFO. Never array.shift / array.remove(0).
    if array.size(engine.w02Aux.breakSnapshotRootNodeFreeIndexes) > 0
        nodeIndex := array.pop(engine.w02Aux.breakSnapshotRootNodeFreeIndexes)
        breakSnapshotRootNodeResetRaw(engine, nodeIndex)
    else
        nodeIndex := array.size(engine.w02Aux.breakSnapshotRootNodeRootIds)
        array.push(engine.w02Aux.breakSnapshotRootNodeRootIds,               ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeNextIndexes,           SLOT_INVALID)
        array.push(engine.w02Aux.breakSnapshotRootNodeOwnerSideSlots,        SLOT_INVALID)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedCoreIds,       ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedGenerationIds, ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedBreakSeqs,     SEQ_UNSET)
        array.push(engine.w02Aux.breakSnapshotRootNodeLiveFlags,             false)
    // Step 3 : the row exists and is unset. live stays false - allocation is not
    // ownership, and nothing here joins a chain or a Side.
    nodeIndex

// Moves one currently live physical BreakSnapshot Root-copy node row back to the
// free state. Returns true only when the row was freed. An out-of-range index or a
// row that is not live returns false with no mutation, so a second free of the same
// row never pushes it into the free stack twice.
// Precondition: the caller has already detached this row from its Side's chain.
// This helper never touches head, tail, count or another node's next, and never
// validates the owner token.
breakSnapshotRootNodeFreeRaw(ZoneEngine engine, int nodeIndex) =>
    bool freed = false
    // Step 1 : range. The live read is nested rather than joined by and, because
    // Pine evaluates both sides of an and eagerly.
    if nodeIndex >= 0 and nodeIndex < array.size(engine.w02Aux.breakSnapshotRootNodeLiveFlags)
        if array.get(engine.w02Aux.breakSnapshotRootNodeLiveFlags, nodeIndex)
            // Step 2 : the row goes back to the unset sentinel, live included
            // because the reset writes it false.
            breakSnapshotRootNodeResetRaw(engine, nodeIndex)
            // Step 3 : freed row enters the free stack exactly once. The arrays are
            // never shrunk.
            array.push(engine.w02Aux.breakSnapshotRootNodeFreeIndexes, nodeIndex)
            freed := true
    freed

// ============================================================
// W02 Batch 2 : Root physical slot lifecycle (raw helpers)
// Source: I6.2, I17.1, D02, D12
//
// Internal only. These three helpers own the physical Root slot lifecycle of the
// Root SoA, of the Batch 1 lifecycle arrays and of the Batch 4 Root ID index, and
// nothing else:
//   - Batch 2 built the raw lifecycle; Batch 4 connected the I11-1
//     Root ID -> rootSlot index (rootIdToSlot) into the alloc / free paths below,
//     where a free also requires the index entry to agree with the slot
//   - Batch 16 connected the I11-4 reverse-position arrays (Category / TF / state),
//     Batch 20 the I11-6 FVG reverse-position arrays (Fresh, structural state,
//     direction, Broad) and Batch 22 the two FVG NativeRange order positions to the
//     Root physical slot growth / reset lifecycle - nine reverse-position arrays in
//     total; every set and order they point into stays empty, so no membership
//     exists yet
//   - Batch 24 connected the I11-7 participation Root metadata (head edge index,
//     live edge count) to the same growth / reset lifecycle; the edge pool itself
//     stays empty
//   - Batch 29 connected the I11-7 participation index to the free path:
//     rootFreeSlotRaw releases every participation edge of the Root, through the
//     all-or-nothing detach-all helper, before it writes any Root lifecycle state,
//     and a failed detach cancels the free with nothing mutated
//   - still not connected: Category / TF / state membership, FVG membership, FVG
//     NativeRange order maintenance, the participation detach on Core free, origin
//     tuple index, price order
//   - no revision increment (I9 revisions stay untouched here)
//   - no Root content (category, price, tick, time, state semantics). W02 Batch 49
//     adds a raw float + tick write helper in its own section below, but it has 0
//     Production call sites and is not wired into the registry mutation, so no Root
//     price or tick is written anywhere yet
// They are therefore not wired into any Stage or Public API in this Batch:
// call sites = 0 until a later Batch adds the index + revision aware registry
// mutation on top of them.
//
// Slot ownership token is rootIds[rootSlot] itself (Batch 1 contract): no separate
// owner token array exists. A stale-capable reference keeps rootSlot +
// expectedRootId and is valid only when the slot is in range,
// rootSlotLiveFlags[rootSlot] is true and rootIds[rootSlot] == expectedRootId.
// The ownership validation helper is not created in this Batch.
//
// array.remove(0), array.shift() and array.unshift() are never used (D12, I17.2).
// Unset values keep their spec sentinel: na stays na and is never replaced by 0
// (I18), while the element type of every array is preserved.
// ============================================================

// Returns one existing physical rootSlot to the unused / free sentinel state.
// Precondition: rootSlot already exists inside the physical arrays. No range check
// helper and no runtime.error is added here.
// Touches the Root SoA 23 arrays, rootSlotLiveFlags, the nine index
// reverse-position arrays of this slot (Category, TF, state, FVG Fresh, FVG
// structural state, FVG direction, FVG Broad, FVG NativeRange bottom order, FVG
// NativeRange top order), its price-order position (rootPriceOrderPositions) and
// its two participation metadata entries (head edge index, live edge count) only:
// the index sets and orders, rootPriceOrderSlots, the participation edge pool,
// rootFreeSlots, rootLiveSlots, rootIdOrderSlots, rootIdToSlot, nextRootId and the
// revisions are left alone.
rootResetSlotRaw(ZoneEngine engine, int rootSlot) =>
    array.set(engine.rootIds,               rootSlot, ID_NONE)
    array.set(engine.rootOriginKeys,        rootSlot, ID_NONE)
    array.set(engine.rootCategories,        rootSlot, int(na))
    array.set(engine.rootSubtypes,          rootSlot, int(na))
    array.set(engine.rootTfCodes,           rootSlot, int(na))
    array.set(engine.rootOriginTimes,       rootSlot, int(na))
    array.set(engine.rootOriginEndTimes,    rootSlot, int(na))
    array.set(engine.rootConfirmedTimes,    rootSlot, int(na))
    array.set(engine.rootPointPrices,       rootSlot, float(na))
    array.set(engine.rootNativeBottoms,     rootSlot, float(na))
    array.set(engine.rootNativeTops,        rootSlot, float(na))
    array.set(engine.rootIsRangeRootFlags,  rootSlot, false)
    array.set(engine.rootIsDynamicFlags,    rootSlot, false)
    array.set(engine.rootStates,            rootSlot, ROOT_CANDIDATE)
    array.set(engine.rootPairKeys,          rootSlot, ID_NONE)
    array.set(engine.rootDirections,        rootSlot, FVG_NONE)
    array.set(engine.rootFvgFreshFlags,     rootSlot, false)
    array.set(engine.rootIsBroadFvgFlags,   rootSlot, false)
    array.set(engine.rootLabelMasks,        rootSlot, 0)
    array.set(engine.rootLastUpdateSeqs,    rootSlot, SEQ_UNSET)
    array.set(engine.rootPointTicks,        rootSlot, int(na))
    array.set(engine.rootNativeBottomTicks, rootSlot, int(na))
    array.set(engine.rootNativeTopTicks,    rootSlot, int(na))
    array.set(engine.rootSlotLiveFlags,     rootSlot, false)
    // W02 Batch 16 : this slot belongs to no Category / TF / state set (I11-4). The
    // sets themselves are not scanned here, and the ROOT_CANDIDATE sentinel written
    // above is a raw slot state, never an automatic membership of the Candidate set.
    array.set(engine.rootCategorySetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootTfSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootStateSetPositions,    rootSlot, SLOT_INVALID)
    // W02 Batch 20 : the same for the four FVG index dimensions (I11-6 / I14). The
    // FVG sets are not scanned here, and the raw sentinels written above
    // (FVG_NONE, fvgFresh false, isBroadFvg false, ROOT_CANDIDATE) never mean a
    // membership of the direction, Fresh, structural state or Broad sets.
    array.set(engine.rootFvgFreshSetPositions,           rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgDirectionSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgBroadSetPositions,           rootSlot, SLOT_INVALID)
    // W02 Batch 22 : the same for the two FVG NativeRange order dimensions. The
    // order arrays themselves are not scanned or mutated here.
    array.set(engine.rootFvgNativeBottomOrderPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgNativeTopOrderPositions,    rootSlot, SLOT_INVALID)
    // W02 Batch 24 : this slot takes part in no Core / Side (I11-7). The edge pool
    // is never scanned, detached or mutated here: since Batch 29 a Root free has
    // already released every edge of the Root before this reset runs.
    array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, SLOT_INVALID)
    array.set(engine.rootParticipationCounts,          rootSlot, 0)
    // W02 Batch 32 : this slot sits in no price order (I11-3 / I6.2). Only the
    // reverse position is returned to SLOT_INVALID: rootPriceOrderSlots itself is
    // never scanned, detached or mutated in this Batch, and real membership is 0.
    array.set(engine.rootPriceOrderPositions, rootSlot, SLOT_INVALID)
    // W02 Batch 36 : the prune revision of this slot restarts at 0 (I11-13). The
    // four prune heaps are never scanned or mutated here. An entry of the previous
    // owner is judged by the full match of Root ID, revision, state and
    // confirmedTime, and since Root IDs are never reused (D02) its Root ID alone
    // can never match this slot's next owner - the restart to 0 is not what makes
    // it stale, and a later entry may legitimately carry revision 0 again.
    array.set(engine.w02Aux.rootPruneRevisions, rootSlot, 0)
    // W02 Batch 42 : this slot is in no originKey bucket (I11-2). Only the chain
    // entry of this slot is cleared: the bucket head map is never touched here,
    // because real membership is 0. Once a later Batch can attach a Root, the
    // detach it adds must unlink the slot from its bucket before this reset runs.
    // The expected Root ID going back to ID_NONE is what makes a stale bucket entry
    // fail its ownership test, together with Root IDs never being reused (D02).
    array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
    array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, SLOT_INVALID)
    array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, ID_NONE)
    // W03 Batch 04 : physical slot reset of the Swing TF mask, for every slot
    // whatever its Category or state, so no previous owner's mask survives a
    // free or a reuse. Not a Swing business reset.
    array.set(engine.w03Store.rootSwingTfMasks, rootSlot, SWING_TF_MASK_NONE)

// Starts ownership of one physical Root slot and returns that rootSlot.
// Free slots are reused first (LIFO pop), otherwise the physical arrays grow by one
// sentinel entry. A reused slot never reuses the old Root ID: nextRootId only
// increases (D02). Only rootId and physical ownership are written here.
rootAllocSlotRaw(ZoneEngine engine) =>
    int rootSlot = SLOT_INVALID
    // Step 1 / Step 2 : free stack first, LIFO. Never array.shift / array.remove(0).
    if array.size(engine.rootFreeSlots) > 0
        rootSlot := array.pop(engine.rootFreeSlots)
        rootResetSlotRaw(engine, rootSlot)
    else
        rootSlot := array.size(engine.rootIds)
        array.push(engine.rootIds,               ID_NONE)
        array.push(engine.rootOriginKeys,        ID_NONE)
        array.push(engine.rootCategories,        int(na))
        array.push(engine.rootSubtypes,          int(na))
        array.push(engine.rootTfCodes,           int(na))
        array.push(engine.rootOriginTimes,       int(na))
        array.push(engine.rootOriginEndTimes,    int(na))
        array.push(engine.rootConfirmedTimes,    int(na))
        array.push(engine.rootPointPrices,       float(na))
        array.push(engine.rootNativeBottoms,     float(na))
        array.push(engine.rootNativeTops,        float(na))
        array.push(engine.rootIsRangeRootFlags,  false)
        array.push(engine.rootIsDynamicFlags,    false)
        array.push(engine.rootStates,            ROOT_CANDIDATE)
        array.push(engine.rootPairKeys,          ID_NONE)
        array.push(engine.rootDirections,        FVG_NONE)
        array.push(engine.rootFvgFreshFlags,     false)
        array.push(engine.rootIsBroadFvgFlags,   false)
        array.push(engine.rootLabelMasks,        0)
        array.push(engine.rootLastUpdateSeqs,    SEQ_UNSET)
        array.push(engine.rootPointTicks,        int(na))
        array.push(engine.rootNativeBottomTicks, int(na))
        array.push(engine.rootNativeTopTicks,    int(na))
        array.push(engine.rootSlotLiveFlags,     false)
        // W02 Batch 16 : one reverse-position entry per dimension for this new
        // physical slot, so each array's size stays equal to size(rootIds). A reused
        // slot never comes here and the arrays are never shrunk on a free.
        array.push(engine.rootCategorySetPositions, SLOT_INVALID)
        array.push(engine.rootTfSetPositions,       SLOT_INVALID)
        array.push(engine.rootStateSetPositions,    SLOT_INVALID)
        // W02 Batch 20 : one entry per FVG index dimension for this new physical
        // slot, keeping each array's size equal to size(rootIds). A reused slot
        // never comes here and a free never shrinks them.
        array.push(engine.rootFvgFreshSetPositions,           SLOT_INVALID)
        array.push(engine.rootFvgStructuralStateSetPositions, SLOT_INVALID)
        array.push(engine.rootFvgDirectionSetPositions,       SLOT_INVALID)
        array.push(engine.rootFvgBroadSetPositions,           SLOT_INVALID)
        // W02 Batch 22 : one entry per FVG NativeRange order dimension for this new
        // physical slot, keeping both arrays the same size as rootIds.
        array.push(engine.rootFvgNativeBottomOrderPositions, SLOT_INVALID)
        array.push(engine.rootFvgNativeTopOrderPositions,    SLOT_INVALID)
        // W02 Batch 24 : participation metadata of this new physical slot: no chain
        // and no live edge. Both arrays stay the same size as rootIds.
        array.push(engine.rootParticipationHeadEdgeIndexes, SLOT_INVALID)
        array.push(engine.rootParticipationCounts,          0)
        // W02 Batch 32 : one price-order reverse position for this new physical
        // slot, so size(rootPriceOrderPositions) stays equal to size(rootIds)
        // (I6.2). A reused slot never comes here - rootResetSlotRaw puts its
        // position back to SLOT_INVALID instead - and a free never shrinks the
        // array. rootPriceOrderSlots is not touched: it is an independent logical
        // order array and does not grow with the physical slots.
        array.push(engine.rootPriceOrderPositions, SLOT_INVALID)
        // W02 Batch 36 : the prune revision of this new physical slot starts at 0,
        // so size(rootPruneRevisions) stays equal to size(rootIds) (I11-13). A
        // reused slot never comes here - rootResetSlotRaw puts its revision back to
        // 0 instead - and a free never shrinks the array. The sixteen prune queue
        // arrays are not touched: they are logical heaps and do not grow with the
        // physical Root slots.
        array.push(engine.w02Aux.rootPruneRevisions, 0)
        // W02 Batch 42 : the origin bucket chain entry of this new physical slot,
        // unlinked and unowned, so all three arrays stay the same size as rootIds
        // (I11-2). A reused slot never comes here - rootResetSlotRaw clears its
        // entry instead - and a free never shrinks them. The bucket head map is not
        // touched: a slot joins a bucket only when a later attach puts it there.
        array.push(engine.w02Aux.rootOriginBucketPrevRootSlots,   SLOT_INVALID)
        array.push(engine.w02Aux.rootOriginBucketNextRootSlots,   SLOT_INVALID)
        array.push(engine.w02Aux.rootOriginBucketExpectedRootIds, ID_NONE)
        // W03 Batch 04 : Swing TF mask of this new physical slot, unset, so
        // size(rootSwingTfMasks) stays equal to size(rootIds). A reused slot never
        // comes here - rootResetSlotRaw puts its mask back to 0 instead.
        array.push(engine.w03Store.rootSwingTfMasks, SWING_TF_MASK_NONE)
    // Step 3 : new Root ID. 1-based, 0 = none, never reused (D02).
    int newRootId = engine.nextRootId
    engine.nextRootId := newRootId + 1
    // Step 4 : slot ownership starts. rootIds[rootSlot] is the ownership token.
    array.set(engine.rootIds,           rootSlot, newRootId)
    array.set(engine.rootSlotLiveFlags, rootSlot, true)
    // W02 Batch 4 : I11-1 index entry for the new Root ID. Root IDs are never
    // reused, so this key is always new and is never written twice.
    map.put(engine.rootIdToSlot, newRootId, rootSlot)
    // Step 5 : Live collection. One push per ownership start, never twice.
    array.push(engine.rootLiveSlots, rootSlot)
    // Step 6 : Root ID order. Root IDs increase monotonically and are never reused,
    // so a tail push alone keeps Root ID ascending order. No sort, no insert search.
    array.push(engine.rootIdOrderSlots, rootSlot)
    // Step 7
    rootSlot

// ============================================================
// W02 Batch 49 : Root float + tick raw write foundation
// Source: I6.4, D12
//
// Internal only, and raw: this helper writes one Root's three prices and the three
// comparison ticks that go with them, and nothing else.
// I6.4 keeps the original float price and, for comparisons only, an int tick of
// round(price / mintick). The float is therefore stored exactly as it arrives - no
// rounding, no floor or ceil, no epsilon, no snapping back to a multiple of
// mintick and no digit rounding - and only the tick is derived. A na price stays
// na and its tick is int(na); a na price is never turned into tick 0.
// mintick is a precondition, not something this helper repairs: it applies no
// fallback, default, abs or epsilon and raises no runtime.error, because the
// validity of mintick is the Cfg / Feed validation contract one level up.
// It reads no Category and no isRangeRoot, so a point Root, a range Root, an FVG,
// an Accum, an EMA, a Swing, a TimeHL and a Psych Root are all written the same
// way, and it never checks or swaps nativeBottom against nativeTop - the caller
// passes the prices the spec says it should.
// It validates no ownership either: a valid physical rootSlot is the caller's
// precondition, and the ownership-aware wrapper is a later Window.
// Index and revision mutation = 0. Writing a price invalidates the price orders,
// the FVG NativeRange orders and the origin index in the logical sense, but this
// helper deliberately does not touch them or any of the 17 I9 revisions: the later
// registry mutation layer is what will detach, write, reinsert and increment in
// the right order.
// Production call sites = 0 in this Batch: nothing calls it, so no real Root price
// is written anywhere.
// ============================================================

// Writes one Root's three prices and their comparison ticks together (I6.4).
// Precondition: rootSlot is a valid physical Root slot and mintick is valid.
rootWritePricesAndTicksRaw(ZoneEngine engine, int rootSlot, float pointPrice, float nativeBottom, float nativeTop, float mintick) =>
    // Step 1 : the float prices are stored exactly as received.
    array.set(engine.rootPointPrices,   rootSlot, pointPrice)
    array.set(engine.rootNativeBottoms, rootSlot, nativeBottom)
    array.set(engine.rootNativeTops,    rootSlot, nativeTop)
    // Step 2 : the comparison ticks, round(price / mintick) each, with na kept as
    // the int na sentinel rather than collapsing to 0.
    int pointTick  = na(pointPrice)   ? int(na) : int(math.round(pointPrice   / mintick))
    int bottomTick = na(nativeBottom) ? int(na) : int(math.round(nativeBottom / mintick))
    int topTick    = na(nativeTop)    ? int(na) : int(math.round(nativeTop    / mintick))
    // Step 3 : each tick goes beside its own price. The three are independent.
    array.set(engine.rootPointTicks,        rootSlot, pointTick)
    array.set(engine.rootNativeBottomTicks, rootSlot, bottomTick)
    array.set(engine.rootNativeTopTicks,    rootSlot, topTick)

// ============================================================
// W03 Batch 08 : point Root price-order move (I11-3 / I6.2 / I6.4)
// Source: I6.2, I6.4, I11-3, D12
//
// Internal only. One atomic helper for a point Root whose price changes while it
// stays in the common order: every check and the target position are settled
// first with zero writes, then a single commit shifts the entries between the old
// and the new position, writes the new point price and tick through
// rootWritePricesAndTicksRaw (native prices re-written unchanged) and places the
// Root. It never calls the Batch 07 detach / insert helpers, never rolls back and
// never changes the order size. The key stays rootPointTicks ascending with the
// Batch 07 physical upper_bound rule for equal ticks; no business tie-break.
// No revision, index other than the price order, lifecycle or Stage is touched.
// Business call sites = 0 in this Batch.
// ============================================================

// Moves one owned point Root to the position of its new price. Returns true when
// committed; false with zero mutation on any failed check.
rootPriceOrderMoveRaw(ZoneEngine engine, int rootSlot, int expectedRootId, float newPointPrice, float mintick) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPointPrices) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootNativeBottoms) and rootSlot < array.size(engine.rootNativeTops) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int   orderSize       = array.size(engine.rootPriceOrderSlots)
    int   oldPos          = SLOT_INVALID
    int   oldTick         = int(na)
    int   newPointTick    = int(na)
    float oldNativeBottom = na
    float oldNativeTop    = na
    // Step 1 : mintick, new price and new tick (round(price / mintick) only)
    if ok
        ok := not na(mintick) and mintick > 0 and not na(newPointPrice)
    if ok
        newPointTick := int(math.round(newPointPrice / mintick))
        ok := not na(newPointTick)
    // Step 2 : the Root is a live, owned point Root at its stored position
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and not array.get(engine.rootIsRangeRootFlags, rootSlot)
    if ok
        oldTick := array.get(engine.rootPointTicks, rootSlot)
        oldPos  := array.get(engine.rootPriceOrderPositions, rootSlot)
        ok      := not na(oldTick) and oldPos != SLOT_INVALID and oldPos >= 0 and oldPos < orderSize
    if ok
        ok := array.get(engine.rootPriceOrderSlots, oldPos) == rootSlot
    if ok
        oldNativeBottom := array.get(engine.rootNativeBottoms, rootSlot)
        oldNativeTop    := array.get(engine.rootNativeTops,    rootSlot)
    // Step 3 : target position by a local scan; every neighbour touched is validated
    int targetPos = oldPos
    if ok
        bool scanning = true
        int  i        = newPointTick >= oldTick ? oldPos + 1 : oldPos - 1
        while ok and scanning and i >= 0 and i < orderSize
            int slot = array.get(engine.rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == i
            if ok
                int neighborTick = array.get(engine.rootPointTicks, slot)
                if newPointTick >= oldTick
                    // right: pass every tick <= new tick, equal ticks included
                    if neighborTick <= newPointTick
                        targetPos := i
                        i += 1
                    else
                        scanning := false
                else
                    // left: pass every tick > new tick, stop at the first <= new tick
                    if neighborTick > newPointTick
                        targetPos := i
                        i -= 1
                    else
                        scanning := false
    // Step 4 : single commit. Nothing below can fail.
    if ok
        if targetPos > oldPos
            int i = oldPos
            while i < targetPos
                int movedSlot = array.get(engine.rootPriceOrderSlots, i + 1)
                array.set(engine.rootPriceOrderSlots, i, movedSlot)
                array.set(engine.rootPriceOrderPositions, movedSlot, i)
                i += 1
        else if targetPos < oldPos
            int i = oldPos
            while i > targetPos
                int movedSlot = array.get(engine.rootPriceOrderSlots, i - 1)
                array.set(engine.rootPriceOrderSlots, i, movedSlot)
                array.set(engine.rootPriceOrderPositions, movedSlot, i)
                i -= 1
        rootWritePricesAndTicksRaw(engine, rootSlot, newPointPrice, oldNativeBottom, oldNativeTop, mintick)
        if targetPos != oldPos
            array.set(engine.rootPriceOrderSlots, targetPos, rootSlot)
            array.set(engine.rootPriceOrderPositions, rootSlot, targetPos)
    ok

// ============================================================
// W03 Batch 09 : FVG NativeRange bottom / top order helpers (I11-6 / I14)
// Source: I6.2, I6.4, I11-6, D12
//
// Internal only. The two NativeRange orders hold FVG range Roots only (CAT_FVG,
// isRangeRoot, TF 1H / 4H / D, Bullish or Bearish); a point Root is always
// refused. Keys are rootNativeBottomTicks and rootNativeTopTicks ascending - never
// a float price, midpoint, point tick, origin time or Root ID. Equal ticks carry
// no business tie-break: a new Root goes after its equal-tick group (upper_bound)
// as a physical rule only.
// insert and detach are atomic over both orders: the Root, both positions, both
// shifted suffixes and both boundaries are validated before the first write, with
// no rollback. Only these two orders and their reverse positions change - no Root
// content, FVG set, state rule, common price order, revision or Stage is touched.
// Business call sites = 0 in this Batch (the upper bounds are called by insert).
// ============================================================

// Upper bound of targetTick in the NativeRange bottom order: the first position
// whose bottom tick is greater. [position, true], or [SLOT_INVALID, false] for a na
// tick or a visited entry that is not a valid FVG member. Read-only.
fvgNativeBottomOrderUpperBoundRaw(ZoneEngine engine, int targetTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(targetTick)
    if ok
        int lo = 0
        int hi = array.size(engine.fvgNativeBottomOrderRootSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2.0))
            int slot = array.get(engine.fvgNativeBottomOrderRootSlots, mid)
            bool entryOk = false
            entryOk := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootFvgNativeBottomOrderPositions)
            if entryOk
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                entryOk := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeBottomTicks, slot)) and array.get(engine.rootFvgNativeBottomOrderPositions, slot) == mid
            if not entryOk
                ok := false
            else if array.get(engine.rootNativeBottomTicks, slot) <= targetTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Upper bound of targetTick in the NativeRange top order: the first position
// whose top tick is greater. [position, true], or [SLOT_INVALID, false] for a na
// tick or a visited entry that is not a valid FVG member. Read-only.
fvgNativeTopOrderUpperBoundRaw(ZoneEngine engine, int targetTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(targetTick)
    if ok
        int lo = 0
        int hi = array.size(engine.fvgNativeTopOrderRootSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2.0))
            int slot = array.get(engine.fvgNativeTopOrderRootSlots, mid)
            bool entryOk = false
            entryOk := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeTopTicks) and slot < array.size(engine.rootFvgNativeTopOrderPositions)
            if entryOk
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                entryOk := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeTopTicks, slot)) and array.get(engine.rootFvgNativeTopOrderPositions, slot) == mid
            if not entryOk
                ok := false
            else if array.get(engine.rootNativeTopTicks, slot) <= targetTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Inserts one owned FVG range Root into both NativeRange orders at the upper
// bound of its bottom and top ticks. true when committed; false with zero mutation.
fvgNativeRangeOrderInsertRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootFvgNativeBottomOrderPositions) and rootSlot < array.size(engine.rootFvgNativeTopOrderPositions)
    int bottomTick      = int(na)
    int topTick         = int(na)
    int bottomInsertPos = SLOT_INVALID
    int topInsertPos    = SLOT_INVALID
    int oldBottomSize   = array.size(engine.fvgNativeBottomOrderRootSlots)
    int oldTopSize      = array.size(engine.fvgNativeTopOrderRootSlots)
    // Step 1 : the Root is a live, owned FVG range Root in neither order
    if ok
        int rootTf  = array.get(engine.rootTfCodes,    rootSlot)
        int rootDir = array.get(engine.rootDirections, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (rootTf == TF_1H or rootTf == TF_4H or rootTf == TF_D) and (rootDir == FVG_BULLISH or rootDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, rootSlot)
    if ok
        bottomTick := array.get(engine.rootNativeBottomTicks, rootSlot)
        topTick    := array.get(engine.rootNativeTopTicks,    rootSlot)
        ok := not na(bottomTick) and not na(topTick) and bottomTick <= topTick and array.get(engine.rootFvgNativeBottomOrderPositions, rootSlot) == SLOT_INVALID and array.get(engine.rootFvgNativeTopOrderPositions, rootSlot) == SLOT_INVALID
    // Step 2 : both insert positions
    if ok
        [bPos, bOk] = fvgNativeBottomOrderUpperBoundRaw(engine, bottomTick)
        [tPos, tOk] = fvgNativeTopOrderUpperBoundRaw(engine, topTick)
        ok              := bOk and tOk
        bottomInsertPos := bPos
        topInsertPos    := tPos
    // Step 3b : bottom order - every entry that will shift right and both neighbours
    if ok
        int i = bottomInsertPos
        while ok and i < oldBottomSize
            int slot = array.get(engine.fvgNativeBottomOrderRootSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootFvgNativeBottomOrderPositions)
            if ok
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeBottomTicks, slot)) and array.get(engine.rootFvgNativeBottomOrderPositions, slot) == i
            i += 1
    if ok and bottomInsertPos > 0
        int leftSlot = array.get(engine.fvgNativeBottomOrderRootSlots, bottomInsertPos - 1)
        ok := leftSlot >= 0 and leftSlot < array.size(engine.rootIds) and leftSlot < array.size(engine.rootSlotLiveFlags) and leftSlot < array.size(engine.rootCategories) and leftSlot < array.size(engine.rootTfCodes) and leftSlot < array.size(engine.rootDirections) and leftSlot < array.size(engine.rootIsRangeRootFlags) and leftSlot < array.size(engine.rootNativeBottomTicks) and leftSlot < array.size(engine.rootFvgNativeBottomOrderPositions)
        if ok
            int entryTf  = array.get(engine.rootTfCodes,    leftSlot)
            int entryDir = array.get(engine.rootDirections, leftSlot)
            ok := array.get(engine.rootSlotLiveFlags, leftSlot) and array.get(engine.rootIds, leftSlot) != ID_NONE and array.get(engine.rootCategories, leftSlot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, leftSlot) and not na(array.get(engine.rootNativeBottomTicks, leftSlot)) and array.get(engine.rootFvgNativeBottomOrderPositions, leftSlot) == bottomInsertPos - 1
        if ok
            ok := array.get(engine.rootNativeBottomTicks, leftSlot) <= bottomTick
    if ok and bottomInsertPos < oldBottomSize
        // upper_bound: the right neighbour must be strictly greater
        ok := array.get(engine.rootNativeBottomTicks, array.get(engine.fvgNativeBottomOrderRootSlots, bottomInsertPos)) > bottomTick
    // Step 3t : top order - every entry that will shift right and both neighbours
    if ok
        int i = topInsertPos
        while ok and i < oldTopSize
            int slot = array.get(engine.fvgNativeTopOrderRootSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeTopTicks) and slot < array.size(engine.rootFvgNativeTopOrderPositions)
            if ok
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeTopTicks, slot)) and array.get(engine.rootFvgNativeTopOrderPositions, slot) == i
            i += 1
    if ok and topInsertPos > 0
        int leftSlot = array.get(engine.fvgNativeTopOrderRootSlots, topInsertPos - 1)
        ok := leftSlot >= 0 and leftSlot < array.size(engine.rootIds) and leftSlot < array.size(engine.rootSlotLiveFlags) and leftSlot < array.size(engine.rootCategories) and leftSlot < array.size(engine.rootTfCodes) and leftSlot < array.size(engine.rootDirections) and leftSlot < array.size(engine.rootIsRangeRootFlags) and leftSlot < array.size(engine.rootNativeTopTicks) and leftSlot < array.size(engine.rootFvgNativeTopOrderPositions)
        if ok
            int entryTf  = array.get(engine.rootTfCodes,    leftSlot)
            int entryDir = array.get(engine.rootDirections, leftSlot)
            ok := array.get(engine.rootSlotLiveFlags, leftSlot) and array.get(engine.rootIds, leftSlot) != ID_NONE and array.get(engine.rootCategories, leftSlot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, leftSlot) and not na(array.get(engine.rootNativeTopTicks, leftSlot)) and array.get(engine.rootFvgNativeTopOrderPositions, leftSlot) == topInsertPos - 1
        if ok
            ok := array.get(engine.rootNativeTopTicks, leftSlot) <= topTick
    if ok and topInsertPos < oldTopSize
        // upper_bound: the right neighbour must be strictly greater
        ok := array.get(engine.rootNativeTopTicks, array.get(engine.fvgNativeTopOrderRootSlots, topInsertPos)) > topTick
    // Step 4 : commit both orders. Nothing below can fail.
    if ok
        array.push(engine.fvgNativeBottomOrderRootSlots, rootSlot)
        int i = oldBottomSize
        while i > bottomInsertPos
            int movedSlot = array.get(engine.fvgNativeBottomOrderRootSlots, i - 1)
            array.set(engine.fvgNativeBottomOrderRootSlots, i, movedSlot)
            array.set(engine.rootFvgNativeBottomOrderPositions, movedSlot, i)
            i -= 1
        array.set(engine.fvgNativeBottomOrderRootSlots, bottomInsertPos, rootSlot)
        array.set(engine.rootFvgNativeBottomOrderPositions, rootSlot, bottomInsertPos)
        array.push(engine.fvgNativeTopOrderRootSlots, rootSlot)
        int j = oldTopSize
        while j > topInsertPos
            int movedSlot = array.get(engine.fvgNativeTopOrderRootSlots, j - 1)
            array.set(engine.fvgNativeTopOrderRootSlots, j, movedSlot)
            array.set(engine.rootFvgNativeTopOrderPositions, movedSlot, j)
            j -= 1
        array.set(engine.fvgNativeTopOrderRootSlots, topInsertPos, rootSlot)
        array.set(engine.rootFvgNativeTopOrderPositions, rootSlot, topInsertPos)
    ok

// Removes one owned FVG range Root from both NativeRange orders. true when
// committed; false with zero mutation. The Root itself stays as it is.
fvgNativeRangeOrderDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootNativeBottomTicks) and rootSlot < array.size(engine.rootNativeTopTicks) and rootSlot < array.size(engine.rootFvgNativeBottomOrderPositions) and rootSlot < array.size(engine.rootFvgNativeTopOrderPositions)
    int bottomSize = array.size(engine.fvgNativeBottomOrderRootSlots)
    int topSize    = array.size(engine.fvgNativeTopOrderRootSlots)
    int bottomPos  = SLOT_INVALID
    int topPos     = SLOT_INVALID
    // Step 1 : the Root is a live, owned FVG range Root at both stored positions
    if ok
        int rootTf  = array.get(engine.rootTfCodes,    rootSlot)
        int rootDir = array.get(engine.rootDirections, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (rootTf == TF_1H or rootTf == TF_4H or rootTf == TF_D) and (rootDir == FVG_BULLISH or rootDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, rootSlot)
    if ok
        int bottomTick = array.get(engine.rootNativeBottomTicks, rootSlot)
        int topTick    = array.get(engine.rootNativeTopTicks,    rootSlot)
        bottomPos := array.get(engine.rootFvgNativeBottomOrderPositions, rootSlot)
        topPos    := array.get(engine.rootFvgNativeTopOrderPositions,    rootSlot)
        ok := not na(bottomTick) and not na(topTick) and bottomTick <= topTick and bottomPos != SLOT_INVALID and topPos != SLOT_INVALID and bottomPos >= 0 and topPos >= 0 and bottomPos < bottomSize and topPos < topSize
    if ok
        ok := array.get(engine.fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(engine.fvgNativeTopOrderRootSlots, topPos) == rootSlot
    // Step 2b : bottom order - every entry that will shift left
    if ok
        int i = bottomPos + 1
        while ok and i < bottomSize
            int slot = array.get(engine.fvgNativeBottomOrderRootSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootFvgNativeBottomOrderPositions)
            if ok
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeBottomTicks, slot)) and array.get(engine.rootFvgNativeBottomOrderPositions, slot) == i
            i += 1
    // Step 2t : top order - every entry that will shift left
    if ok
        int i = topPos + 1
        while ok and i < topSize
            int slot = array.get(engine.fvgNativeTopOrderRootSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeTopTicks) and slot < array.size(engine.rootFvgNativeTopOrderPositions)
            if ok
                int entryTf  = array.get(engine.rootTfCodes,    slot)
                int entryDir = array.get(engine.rootDirections, slot)
                ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeTopTicks, slot)) and array.get(engine.rootFvgNativeTopOrderPositions, slot) == i
            i += 1
    // Step 3 : commit both orders, then clear both positions. Nothing can fail.
    if ok
        int i = bottomPos
        while i < bottomSize - 1
            int movedSlot = array.get(engine.fvgNativeBottomOrderRootSlots, i + 1)
            array.set(engine.fvgNativeBottomOrderRootSlots, i, movedSlot)
            array.set(engine.rootFvgNativeBottomOrderPositions, movedSlot, i)
            i += 1
        array.pop(engine.fvgNativeBottomOrderRootSlots)
        int j = topPos
        while j < topSize - 1
            int movedSlot = array.get(engine.fvgNativeTopOrderRootSlots, j + 1)
            array.set(engine.fvgNativeTopOrderRootSlots, j, movedSlot)
            array.set(engine.rootFvgNativeTopOrderPositions, movedSlot, j)
            j += 1
        array.pop(engine.fvgNativeTopOrderRootSlots)
        array.set(engine.rootFvgNativeBottomOrderPositions, rootSlot, SLOT_INVALID)
        array.set(engine.rootFvgNativeTopOrderPositions,    rootSlot, SLOT_INVALID)
    ok

// ============================================================
// W03 Batch 10 : FVG non-price set lifecycle helpers (I11-6 / I14)
// Source: I11-6, I14, D03, D12
//
// Internal only. Four dimensions per FVG Root, each with its reverse position:
//   Fresh      : freshFvg1h / 4h / D (the Root's TF), only while fvgFresh is true
//   Structural : structurallyActiveFvg1h / 4h / D (the Root's TF), only while
//                ROOT_ACTIVE; a ROOT_INVALIDATED FVG belongs to no structural set
//   Direction  : bullishFvg or bearishFvg, always exactly one
//   Broad      : broadFvg, only while isBroadFvg is true
// W03 has no Inverse runtime: nothing is ever added to inverseWaitFvg /
// inverseActiveFvg, and an InverseWait / InverseActive state fails validation.
// add-all (a new FVG) and detach-all (before a free) validate everything first
// and then commit; false means zero mutation, no repair and no rollback. Only
// the sets and their four reverse positions change: no Root field, NativeRange
// order, general Root set, revision or Stage is touched. No set is scanned.
// Business call sites = 0 in this Batch.
// ============================================================

// True only when the owned FVG Root sits exactly where its logical fields say in
// all four dimensions. Read-only; it never repairs.
fvgSetMembershipValidRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions)
    int  tf    = int(na)
    int  dir   = int(na)
    int  state = int(na)
    if ok
        tf    := array.get(engine.rootTfCodes,    rootSlot)
        dir   := array.get(engine.rootDirections, rootSlot)
        state := array.get(engine.rootStates,     rootSlot)
        ok    := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and (state == ROOT_ACTIVE or state == ROOT_INVALIDATED)
    if ok
        array<int> freshSet  = tf == TF_1H ? engine.freshFvg1hRootSlots : tf == TF_4H ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
        array<int> activeSet = tf == TF_1H ? engine.structurallyActiveFvg1hRootSlots : tf == TF_4H ? engine.structurallyActiveFvg4hRootSlots : engine.structurallyActiveFvgDRootSlots
        array<int> dirSet    = dir == FVG_BULLISH ? engine.bullishFvgRootSlots : engine.bearishFvgRootSlots
        int freshPos  = array.get(engine.rootFvgFreshSetPositions,           rootSlot)
        int structPos = array.get(engine.rootFvgStructuralStateSetPositions, rootSlot)
        int dirPos    = array.get(engine.rootFvgDirectionSetPositions,       rootSlot)
        int broadPos  = array.get(engine.rootFvgBroadSetPositions,           rootSlot)
        // Fresh : member of its TF set exactly while fvgFresh is true
        if array.get(engine.rootFvgFreshFlags, rootSlot)
            ok := freshPos >= 0 and freshPos < array.size(freshSet)
            if ok
                ok := array.get(freshSet, freshPos) == rootSlot
        else
            ok := freshPos == SLOT_INVALID
        // Structural : active set of its TF while ACTIVE, none while INVALIDATED
        if ok
            if state == ROOT_ACTIVE
                ok := structPos >= 0 and structPos < array.size(activeSet)
                if ok
                    ok := array.get(activeSet, structPos) == rootSlot
            else
                ok := structPos == SLOT_INVALID
        // Direction : always exactly one of Bullish / Bearish
        if ok
            ok := dirPos >= 0 and dirPos < array.size(dirSet)
            if ok
                ok := array.get(dirSet, dirPos) == rootSlot
        // Broad : member exactly while isBroadFvg is true
        if ok
            if array.get(engine.rootIsBroadFvgFlags, rootSlot)
                ok := broadPos >= 0 and broadPos < array.size(engine.broadFvgRootSlots)
                if ok
                    ok := array.get(engine.broadFvgRootSlots, broadPos) == rootSlot
            else
                ok := broadPos == SLOT_INVALID
    ok

// Registers one new FVG Root (ACTIVE, Fresh) in all four dimensions: Fresh,
// Structural active, Direction, then Broad when isBroadFvg. true when committed;
// false with zero mutation.
fvgSetAddAllRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootIsBroadFvgFlags) and rootSlot < array.size(engine.rootFvgFreshSetPositions) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions) and rootSlot < array.size(engine.rootFvgDirectionSetPositions) and rootSlot < array.size(engine.rootFvgBroadSetPositions)
    int  tf  = int(na)
    int  dir = int(na)
    // Step 1 : a live, owned, ACTIVE, Fresh FVG with no membership in any dimension
    if ok
        tf  := array.get(engine.rootTfCodes,    rootSlot)
        dir := array.get(engine.rootDirections, rootSlot)
        ok  := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and (dir == FVG_BULLISH or dir == FVG_BEARISH) and array.get(engine.rootFvgFreshFlags, rootSlot)
    if ok
        ok := array.get(engine.rootFvgFreshSetPositions, rootSlot) == SLOT_INVALID and array.get(engine.rootFvgStructuralStateSetPositions, rootSlot) == SLOT_INVALID and array.get(engine.rootFvgDirectionSetPositions, rootSlot) == SLOT_INVALID and array.get(engine.rootFvgBroadSetPositions, rootSlot) == SLOT_INVALID
    // Step 2 : commit, tail pushes only. Nothing below can fail.
    if ok
        array<int> freshSet  = tf == TF_1H ? engine.freshFvg1hRootSlots : tf == TF_4H ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
        array<int> activeSet = tf == TF_1H ? engine.structurallyActiveFvg1hRootSlots : tf == TF_4H ? engine.structurallyActiveFvg4hRootSlots : engine.structurallyActiveFvgDRootSlots
        array<int> dirSet    = dir == FVG_BULLISH ? engine.bullishFvgRootSlots : engine.bearishFvgRootSlots
        array.set(engine.rootFvgFreshSetPositions, rootSlot, array.size(freshSet))
        array.push(freshSet, rootSlot)
        array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, array.size(activeSet))
        array.push(activeSet, rootSlot)
        array.set(engine.rootFvgDirectionSetPositions, rootSlot, array.size(dirSet))
        array.push(dirSet, rootSlot)
        if array.get(engine.rootIsBroadFvgFlags, rootSlot)
            array.set(engine.rootFvgBroadSetPositions, rootSlot, array.size(engine.broadFvgRootSlots))
            array.push(engine.broadFvgRootSlots, rootSlot)
    ok

// Removes one owned FVG Root from every dimension it belongs to, by swap-pop.
// true when committed; false with zero mutation. Logical Root fields stay as they are.
fvgSetDetachAllRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    // Step 1 : the full membership must already be exact
    bool ok = fvgSetMembershipValidRaw(engine, rootSlot, expectedRootId)
    bool isFresh  = false
    bool isActive = false
    bool isBroad  = false
    int  tf       = int(na)
    int  dir      = int(na)
    if ok
        tf       := array.get(engine.rootTfCodes,    rootSlot)
        dir      := array.get(engine.rootDirections, rootSlot)
        isFresh  := array.get(engine.rootFvgFreshFlags, rootSlot)
        isActive := array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE
        isBroad  := array.get(engine.rootIsBroadFvgFlags, rootSlot)
    array<int> freshSet  = tf == TF_1H ? engine.freshFvg1hRootSlots : tf == TF_4H ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
    array<int> activeSet = tf == TF_1H ? engine.structurallyActiveFvg1hRootSlots : tf == TF_4H ? engine.structurallyActiveFvg4hRootSlots : engine.structurallyActiveFvgDRootSlots
    array<int> dirSet    = dir == FVG_BULLISH ? engine.bullishFvgRootSlots : engine.bearishFvgRootSlots
    // Step 2 : the last entry each swap-pop will move must hold its own position
    if ok and isFresh
        int lastPos      = array.size(freshSet) - 1
        int lastRootSlot = lastPos >= 0 ? array.get(freshSet, lastPos) : SLOT_INVALID
        ok := lastPos >= 0 and lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgFreshSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgFreshSetPositions, lastRootSlot) == lastPos and array.get(freshSet, lastPos) == lastRootSlot
    if ok and isActive
        int lastPos      = array.size(activeSet) - 1
        int lastRootSlot = lastPos >= 0 ? array.get(activeSet, lastPos) : SLOT_INVALID
        ok := lastPos >= 0 and lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgStructuralStateSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgStructuralStateSetPositions, lastRootSlot) == lastPos and array.get(activeSet, lastPos) == lastRootSlot
    if ok
        int lastPos      = array.size(dirSet) - 1
        int lastRootSlot = lastPos >= 0 ? array.get(dirSet, lastPos) : SLOT_INVALID
        ok := lastPos >= 0 and lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgDirectionSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgDirectionSetPositions, lastRootSlot) == lastPos and array.get(dirSet, lastPos) == lastRootSlot
    if ok and isBroad
        int lastPos      = array.size(engine.broadFvgRootSlots) - 1
        int lastRootSlot = lastPos >= 0 ? array.get(engine.broadFvgRootSlots, lastPos) : SLOT_INVALID
        ok := lastPos >= 0 and lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgBroadSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgBroadSetPositions, lastRootSlot) == lastPos and array.get(engine.broadFvgRootSlots, lastPos) == lastRootSlot
    // Step 3 : commit, Fresh -> Structural -> Direction -> Broad. Nothing can fail.
    if ok
        int freshPos  = array.get(engine.rootFvgFreshSetPositions,           rootSlot)
        int structPos = array.get(engine.rootFvgStructuralStateSetPositions, rootSlot)
        int dirPos    = array.get(engine.rootFvgDirectionSetPositions,       rootSlot)
        int broadPos  = array.get(engine.rootFvgBroadSetPositions,           rootSlot)
        if isFresh
            int lastPos      = array.size(freshSet) - 1
            int lastRootSlot = array.get(freshSet, lastPos)
            if freshPos != lastPos
                array.set(freshSet, freshPos, lastRootSlot)
                array.set(engine.rootFvgFreshSetPositions, lastRootSlot, freshPos)
            array.pop(freshSet)
            array.set(engine.rootFvgFreshSetPositions, rootSlot, SLOT_INVALID)
        if isActive
            int lastPos      = array.size(activeSet) - 1
            int lastRootSlot = array.get(activeSet, lastPos)
            if structPos != lastPos
                array.set(activeSet, structPos, lastRootSlot)
                array.set(engine.rootFvgStructuralStateSetPositions, lastRootSlot, structPos)
            array.pop(activeSet)
            array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
        if dirPos != SLOT_INVALID
            int lastPos      = array.size(dirSet) - 1
            int lastRootSlot = array.get(dirSet, lastPos)
            if dirPos != lastPos
                array.set(dirSet, dirPos, lastRootSlot)
                array.set(engine.rootFvgDirectionSetPositions, lastRootSlot, dirPos)
            array.pop(dirSet)
            array.set(engine.rootFvgDirectionSetPositions, rootSlot, SLOT_INVALID)
        if isBroad
            int lastPos      = array.size(engine.broadFvgRootSlots) - 1
            int lastRootSlot = array.get(engine.broadFvgRootSlots, lastPos)
            if broadPos != lastPos
                array.set(engine.broadFvgRootSlots, broadPos, lastRootSlot)
                array.set(engine.rootFvgBroadSetPositions, lastRootSlot, broadPos)
            array.pop(engine.broadFvgRootSlots)
            array.set(engine.rootFvgBroadSetPositions, rootSlot, SLOT_INVALID)
    ok

// ============================================================
// W03 Batch 11 : FVG transition set helpers and general state-set move (I11-4 / I11-6)
// Source: I11-4, I11-6, I14, D03, D12
//
// Internal only and index-only. Each helper changes one index dimension and never
// the logical field behind it: rootFvgFreshFlags and rootStates are left exactly as
// they are, because the later Stage F apply writes the logical field right after
// the index change inside the same commit.
//   fvgFreshSetDetachRaw            : the Fresh dimension only (Fresh true -> end)
//   fvgStructuralActiveSetDetachRaw : the structurally-active dimension only
//   rootStateSetMoveRaw             : the general state dimension, old -> new set
// Every helper validates the target, its current membership and the entry a
// swap-pop would move before writing; false means zero mutation and no repair.
// Category / TF / Direction / Broad sets, NativeRange orders and the Inverse sets
// are never touched, no set is scanned, and no revision is written.
// Business call sites = 0 in this Batch; the helpers do not call each other.
// ============================================================

// Removes one owned, Fresh FVG Root from the Fresh set of its TF by swap-pop.
// true when committed; false with zero mutation. rootFvgFreshFlags stays true.
fvgFreshSetDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgFreshFlags) and rootSlot < array.size(engine.rootFvgFreshSetPositions)
    int tf       = int(na)
    int freshPos = SLOT_INVALID
    // Step 1 : a live, owned, Fresh FVG (ACTIVE or INVALIDATED) at a valid position
    if ok
        tf := array.get(engine.rootTfCodes, rootSlot)
        int state = array.get(engine.rootStates,     rootSlot)
        int dir   = array.get(engine.rootDirections, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and (state == ROOT_ACTIVE or state == ROOT_INVALIDATED) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and array.get(engine.rootFvgFreshFlags, rootSlot)
    array<int> targetSet = tf == TF_1H ? engine.freshFvg1hRootSlots : tf == TF_4H ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
    if ok
        freshPos := array.get(engine.rootFvgFreshSetPositions, rootSlot)
        ok := freshPos >= 0 and freshPos < array.size(targetSet)
        if ok
            ok := array.get(targetSet, freshPos) == rootSlot
    // Step 2 : the last entry the swap-pop will move must hold its own position
    int lastPos      = array.size(targetSet) - 1
    int lastRootSlot = SLOT_INVALID
    if ok
        ok := lastPos >= 0
        if ok
            lastRootSlot := array.get(targetSet, lastPos)
            ok := lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgFreshSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgFreshSetPositions, lastRootSlot) == lastPos and array.get(targetSet, lastPos) == lastRootSlot
    // Step 3 : commit. Nothing below can fail.
    if ok
        if freshPos != lastPos
            array.set(targetSet, freshPos, lastRootSlot)
            array.set(engine.rootFvgFreshSetPositions, lastRootSlot, freshPos)
        array.pop(targetSet)
        array.set(engine.rootFvgFreshSetPositions, rootSlot, SLOT_INVALID)
    ok

// Removes one owned, ACTIVE FVG Root from the structurally-active set of its TF by
// swap-pop. true when committed; false with zero mutation. rootStates stays ACTIVE.
fvgStructuralActiveSetDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootDirections) and rootSlot < array.size(engine.rootFvgStructuralStateSetPositions)
    int tf        = int(na)
    int structPos = SLOT_INVALID
    // Step 1 : a live, owned, ACTIVE FVG at a valid structural position
    if ok
        tf := array.get(engine.rootTfCodes, rootSlot)
        int dir = array.get(engine.rootDirections, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and (dir == FVG_BULLISH or dir == FVG_BEARISH)
    array<int> targetSet = tf == TF_1H ? engine.structurallyActiveFvg1hRootSlots : tf == TF_4H ? engine.structurallyActiveFvg4hRootSlots : engine.structurallyActiveFvgDRootSlots
    if ok
        structPos := array.get(engine.rootFvgStructuralStateSetPositions, rootSlot)
        ok := structPos >= 0 and structPos < array.size(targetSet)
        if ok
            ok := array.get(targetSet, structPos) == rootSlot
    // Step 2 : the last entry the swap-pop will move must hold its own position
    int lastPos      = array.size(targetSet) - 1
    int lastRootSlot = SLOT_INVALID
    if ok
        ok := lastPos >= 0
        if ok
            lastRootSlot := array.get(targetSet, lastPos)
            ok := lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgStructuralStateSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgStructuralStateSetPositions, lastRootSlot) == lastPos and array.get(targetSet, lastPos) == lastRootSlot
    // Step 3 : commit. Nothing below can fail.
    if ok
        if structPos != lastPos
            array.set(targetSet, structPos, lastRootSlot)
            array.set(engine.rootFvgStructuralStateSetPositions, lastRootSlot, structPos)
        array.pop(targetSet)
        array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
    ok

// Moves one owned Root's general state-set membership from the oldState set to the
// tail of the newState set. rootStates must already equal oldState and is never
// written here. true when committed; false with zero mutation.
rootStateSetMoveRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int oldState, int newState) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootStateSetPositions)
    int statePos = SLOT_INVALID
    // Step 1 : ownership, the logical old state and two distinct known states
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootStates, rootSlot) == oldState and (oldState == ROOT_CANDIDATE or oldState == ROOT_ACTIVE or oldState == ROOT_INVALIDATED or oldState == ROOT_INVERSE_WAIT or oldState == ROOT_INVERSE_ACTIVE or oldState == ROOT_RETIRED) and (newState == ROOT_CANDIDATE or newState == ROOT_ACTIVE or newState == ROOT_INVALIDATED or newState == ROOT_INVERSE_WAIT or newState == ROOT_INVERSE_ACTIVE or newState == ROOT_RETIRED) and oldState != newState
    array<int> oldSet = oldState == ROOT_CANDIDATE ? engine.stateCandidateRootSlots : oldState == ROOT_ACTIVE ? engine.stateActiveRootSlots : oldState == ROOT_INVALIDATED ? engine.stateInvalidatedRootSlots : oldState == ROOT_INVERSE_WAIT ? engine.stateInverseWaitRootSlots : oldState == ROOT_INVERSE_ACTIVE ? engine.stateInverseActiveRootSlots : engine.stateRetiredRootSlots
    array<int> newSet = newState == ROOT_CANDIDATE ? engine.stateCandidateRootSlots : newState == ROOT_ACTIVE ? engine.stateActiveRootSlots : newState == ROOT_INVALIDATED ? engine.stateInvalidatedRootSlots : newState == ROOT_INVERSE_WAIT ? engine.stateInverseWaitRootSlots : newState == ROOT_INVERSE_ACTIVE ? engine.stateInverseActiveRootSlots : engine.stateRetiredRootSlots
    // Step 2 : the current membership in the old state set
    if ok
        statePos := array.get(engine.rootStateSetPositions, rootSlot)
        ok := statePos >= 0 and statePos < array.size(oldSet)
        if ok
            ok := array.get(oldSet, statePos) == rootSlot
    // Step 3 : the last entry the swap-pop will move must hold its own position
    int oldLastPos      = array.size(oldSet) - 1
    int oldLastRootSlot = SLOT_INVALID
    if ok
        ok := oldLastPos >= 0
        if ok
            oldLastRootSlot := array.get(oldSet, oldLastPos)
            ok := oldLastRootSlot >= 0 and oldLastRootSlot < array.size(engine.rootIds) and oldLastRootSlot < array.size(engine.rootSlotLiveFlags) and oldLastRootSlot < array.size(engine.rootStateSetPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, oldLastRootSlot) and array.get(engine.rootIds, oldLastRootSlot) != ID_NONE and array.get(engine.rootStateSetPositions, oldLastRootSlot) == oldLastPos and array.get(oldSet, oldLastPos) == oldLastRootSlot
    // Step 4 : the new tail position, fixed before any write
    int newPos = array.size(newSet)
    // Step 5 : commit. Swap-pop out of the old set, tail push into the new set.
    if ok
        if statePos != oldLastPos
            array.set(oldSet, statePos, oldLastRootSlot)
            array.set(engine.rootStateSetPositions, oldLastRootSlot, statePos)
        array.pop(oldSet)
        array.push(newSet, rootSlot)
        array.set(engine.rootStateSetPositions, rootSlot, newPos)
    ok

// ============================================================
// W03 Batch 12 : Accum pair index helpers (I11-5)
// Source: I11-5, A7.4, D02, D12
//
// Internal only. The two existing maps are the whole index:
//   accumPairUpperRootSlotByKey : pairKey -> physical rootSlot of the Upper boundary
//   accumPairLowerRootSlotByKey : pairKey -> physical rootSlot of the Lower boundary
// The key is rootPairKeys[rootSlot] and nothing else; the value is the rootSlot and
// nothing else. Upper / Lower routing comes only from the caller's isUpper - no
// subtype value is read or inferred - and no pair price relation is checked.
// A partial pair (one side registered) is legal; when the other side is present
// it must be a valid, owned mate with the same pairKey. Every helper validates
// first and writes at most one map entry after that; false means zero mutation,
// no overwrite and no repair. No Root field, other index or revision is touched,
// and no map is scanned.
// Business call sites = 0 in this Batch.
// ============================================================

// True when this owned Accum Root is the chosen side of its pair and the other
// side, if registered, is a valid mate. Read-only.
accumPairMembershipValidRaw(ZoneEngine engine, int rootSlot, int expectedRootId, bool isUpper) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootPairKeys)
    int pairKey = ID_NONE
    map<int, int> chosenMap   = isUpper ? engine.accumPairUpperRootSlotByKey : engine.accumPairLowerRootSlotByKey
    map<int, int> oppositeMap = isUpper ? engine.accumPairLowerRootSlotByKey : engine.accumPairUpperRootSlotByKey
    if ok
        int tf = array.get(engine.rootTfCodes, rootSlot)
        pairKey := array.get(engine.rootPairKeys, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_ACCUM and (tf == TF_1H or tf == TF_4H or tf == TF_D) and pairKey != ID_NONE
    // chosen map: must hold exactly this slot
    if ok
        ok := map.contains(chosenMap, pairKey)
        if ok
            ok := map.get(chosenMap, pairKey) == rootSlot
    // opposite map: absent is legal (partial pair); present must be a valid mate
    if ok and map.contains(oppositeMap, pairKey)
        int mateSlot = map.get(oppositeMap, pairKey)
        ok := mateSlot >= 0 and mateSlot != rootSlot and mateSlot < array.size(engine.rootIds) and mateSlot < array.size(engine.rootSlotLiveFlags) and mateSlot < array.size(engine.rootCategories) and mateSlot < array.size(engine.rootTfCodes) and mateSlot < array.size(engine.rootPairKeys)
        if ok
            int mateTf = array.get(engine.rootTfCodes, mateSlot)
            ok := array.get(engine.rootSlotLiveFlags, mateSlot) and array.get(engine.rootIds, mateSlot) != ID_NONE and array.get(engine.rootCategories, mateSlot) == CAT_ACCUM and (mateTf == TF_1H or mateTf == TF_4H or mateTf == TF_D) and array.get(engine.rootPairKeys, mateSlot) == pairKey
    ok

// Registers one owned, ACTIVE, Confirmed Accum point Root as the chosen side of
// its pair. true when committed; false with zero mutation. Never overwrites.
accumPairAttachRaw(ZoneEngine engine, int rootSlot, int expectedRootId, bool isUpper) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootPairKeys) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPointTicks)
    int pairKey = ID_NONE
    map<int, int> chosenMap   = isUpper ? engine.accumPairUpperRootSlotByKey : engine.accumPairLowerRootSlotByKey
    map<int, int> oppositeMap = isUpper ? engine.accumPairLowerRootSlotByKey : engine.accumPairUpperRootSlotByKey
    // Step 1 : the target and its pairKey
    if ok
        int tf = array.get(engine.rootTfCodes, rootSlot)
        pairKey := array.get(engine.rootPairKeys, rootSlot)
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_ACCUM and (tf == TF_1H or tf == TF_4H or tf == TF_D) and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE and pairKey != ID_NONE and not array.get(engine.rootIsRangeRootFlags, rootSlot) and not na(array.get(engine.rootPointTicks, rootSlot))
    // Step 2 : the chosen side must be free - never overwritten
    if ok
        ok := not map.contains(chosenMap, pairKey)
    // Step 3
    // opposite map: absent is legal (partial pair); present must be a valid mate
    if ok and map.contains(oppositeMap, pairKey)
        int mateSlot = map.get(oppositeMap, pairKey)
        ok := mateSlot >= 0 and mateSlot != rootSlot and mateSlot < array.size(engine.rootIds) and mateSlot < array.size(engine.rootSlotLiveFlags) and mateSlot < array.size(engine.rootCategories) and mateSlot < array.size(engine.rootTfCodes) and mateSlot < array.size(engine.rootPairKeys)
        if ok
            int mateTf = array.get(engine.rootTfCodes, mateSlot)
            ok := array.get(engine.rootSlotLiveFlags, mateSlot) and array.get(engine.rootIds, mateSlot) != ID_NONE and array.get(engine.rootCategories, mateSlot) == CAT_ACCUM and (mateTf == TF_1H or mateTf == TF_4H or mateTf == TF_D) and array.get(engine.rootPairKeys, mateSlot) == pairKey
    // Step 4 : commit, exactly one write
    if ok
        map.put(chosenMap, pairKey, rootSlot)
    ok

// Removes one owned Accum Root from the chosen side of its pair. The other side is
// left as it is. true when committed; false with zero mutation.
accumPairDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId, bool isUpper) =>
    // Step 1 : ownership, chosen membership and mate - state is not restricted
    bool ok = accumPairMembershipValidRaw(engine, rootSlot, expectedRootId, isUpper)
    // Step 2 : commit, exactly one removal
    if ok
        map<int, int> chosenMap = isUpper ? engine.accumPairUpperRootSlotByKey : engine.accumPairLowerRootSlotByKey
        map.remove(chosenMap, array.get(engine.rootPairKeys, rootSlot))
    ok

// ============================================================
// W02 Batch 17 : Root Category / TF / state set raw helpers (I11-4)
//
// Internal only. They maintain a Root's membership in the three index dimensions
// added in Batch 15 and nothing else: engine.rootCategories / rootTfCodes /
// rootStates stay the logical source of truth and are never written here, and no
// Root content, ownership, revision or Generation state is touched. A Phase-style
// transition (detach, change the logical field, add again) is a later path.
// The set of each dimension is chosen by an explicit branch over the existing enum
// values only: no new dimension enum, no magic number, no map, no nested array and
// no per-object UDT. An unknown or na Category, TF code or state is never accepted.
// A membership is all-or-nothing across the three dimensions: an add that cannot
// complete all three writes nothing, and a detach runs only after the full
// validation. A removal is a swap-pop - the sets carry no order semantics - and
// array.remove / array.shift / array.unshift / array.clear are never used.
// Call sites = 0 in this Batch, so no real membership exists yet.
// ============================================================

// True only when the slot is a live, owned Root whose three stored positions each
// point back at it inside the set of its current Category, TF code and state.
// It never mutates and never repairs an inconsistency.
rootSetMembershipValidRaw(ZoneEngine engine, int rootSlot) =>
    bool valid = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootCategorySetPositions) and rootSlot < array.size(engine.rootTfSetPositions) and rootSlot < array.size(engine.rootStateSetPositions)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
            int category = array.get(engine.rootCategories,          rootSlot)
            int tfCode   = array.get(engine.rootTfCodes,             rootSlot)
            int state    = array.get(engine.rootStates,              rootSlot)
            int catPos   = array.get(engine.rootCategorySetPositions, rootSlot)
            int tfPos    = array.get(engine.rootTfSetPositions,       rootSlot)
            int statePos = array.get(engine.rootStateSetPositions,    rootSlot)
            bool catValid   = false
            bool tfValid    = false
            bool stateValid = false
            if catPos >= 0
                if category == CAT_MA
                    if catPos < array.size(engine.categoryMaRootSlots)
                        catValid := array.get(engine.categoryMaRootSlots, catPos) == rootSlot
                else if category == CAT_SWING
                    if catPos < array.size(engine.categorySwingRootSlots)
                        catValid := array.get(engine.categorySwingRootSlots, catPos) == rootSlot
                else if category == CAT_ACCUM
                    if catPos < array.size(engine.categoryAccumRootSlots)
                        catValid := array.get(engine.categoryAccumRootSlots, catPos) == rootSlot
                else if category == CAT_TIME_HL
                    if catPos < array.size(engine.categoryTimeHlRootSlots)
                        catValid := array.get(engine.categoryTimeHlRootSlots, catPos) == rootSlot
                else if category == CAT_FVG
                    if catPos < array.size(engine.categoryFvgRootSlots)
                        catValid := array.get(engine.categoryFvgRootSlots, catPos) == rootSlot
                else if category == CAT_PSYCH
                    if catPos < array.size(engine.categoryPsychRootSlots)
                        catValid := array.get(engine.categoryPsychRootSlots, catPos) == rootSlot
            if tfPos >= 0
                if tfCode == TF_1M
                    if tfPos < array.size(engine.tf1mRootSlots)
                        tfValid := array.get(engine.tf1mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_5M
                    if tfPos < array.size(engine.tf5mRootSlots)
                        tfValid := array.get(engine.tf5mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_15M
                    if tfPos < array.size(engine.tf15mRootSlots)
                        tfValid := array.get(engine.tf15mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_1H
                    if tfPos < array.size(engine.tf1hRootSlots)
                        tfValid := array.get(engine.tf1hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_4H
                    if tfPos < array.size(engine.tf4hRootSlots)
                        tfValid := array.get(engine.tf4hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_D
                    if tfPos < array.size(engine.tfDRootSlots)
                        tfValid := array.get(engine.tfDRootSlots, tfPos) == rootSlot
            if statePos >= 0
                if state == ROOT_CANDIDATE
                    if statePos < array.size(engine.stateCandidateRootSlots)
                        stateValid := array.get(engine.stateCandidateRootSlots, statePos) == rootSlot
                else if state == ROOT_ACTIVE
                    if statePos < array.size(engine.stateActiveRootSlots)
                        stateValid := array.get(engine.stateActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_INVALIDATED
                    if statePos < array.size(engine.stateInvalidatedRootSlots)
                        stateValid := array.get(engine.stateInvalidatedRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_WAIT
                    if statePos < array.size(engine.stateInverseWaitRootSlots)
                        stateValid := array.get(engine.stateInverseWaitRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_ACTIVE
                    if statePos < array.size(engine.stateInverseActiveRootSlots)
                        stateValid := array.get(engine.stateInverseActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_RETIRED
                    if statePos < array.size(engine.stateRetiredRootSlots)
                        stateValid := array.get(engine.stateRetiredRootSlots, statePos) == rootSlot
            valid := catValid and tfValid and stateValid
    valid

// Registers one Root in all three dimensions at once. The preflight requires a
// live, owned slot, a known Category, TF code and state, and no existing membership
// in any dimension; otherwise nothing at all is written. A raw slot straight out of
// rootAllocSlotRaw fails it, because its Category and TF code are still na and its
// ROOT_CANDIDATE is only a sentinel, never a reason to join the Candidate set.
// ROOT_RETIRED, by contrast, is a valid state: a Retired Root that still owns its
// slot belongs in the Retired set.
rootSetAddAllRaw(ZoneEngine engine, int rootSlot) =>
    bool added = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootCategorySetPositions) and rootSlot < array.size(engine.rootTfSetPositions) and rootSlot < array.size(engine.rootStateSetPositions)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
            int category = array.get(engine.rootCategories,          rootSlot)
            int tfCode   = array.get(engine.rootTfCodes,             rootSlot)
            int state    = array.get(engine.rootStates,              rootSlot)
            int catPos   = array.get(engine.rootCategorySetPositions, rootSlot)
            int tfPos    = array.get(engine.rootTfSetPositions,       rootSlot)
            int statePos = array.get(engine.rootStateSetPositions,    rootSlot)
            bool categoryKnown = category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL or category == CAT_FVG or category == CAT_PSYCH
            bool tfKnown       = tfCode == TF_1M or tfCode == TF_5M or tfCode == TF_15M or tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D
            bool stateKnown    = state == ROOT_CANDIDATE or state == ROOT_ACTIVE or state == ROOT_INVALIDATED or state == ROOT_INVERSE_WAIT or state == ROOT_INVERSE_ACTIVE or state == ROOT_RETIRED
            if catPos == SLOT_INVALID and tfPos == SLOT_INVALID and statePos == SLOT_INVALID and categoryKnown and tfKnown and stateKnown
                // Category, then TF, then state. Each is a tail push; nothing is sorted.
                int catNewPos = SLOT_INVALID
                if category == CAT_MA
                    catNewPos := array.size(engine.categoryMaRootSlots)
                    array.push(engine.categoryMaRootSlots, rootSlot)
                else if category == CAT_SWING
                    catNewPos := array.size(engine.categorySwingRootSlots)
                    array.push(engine.categorySwingRootSlots, rootSlot)
                else if category == CAT_ACCUM
                    catNewPos := array.size(engine.categoryAccumRootSlots)
                    array.push(engine.categoryAccumRootSlots, rootSlot)
                else if category == CAT_TIME_HL
                    catNewPos := array.size(engine.categoryTimeHlRootSlots)
                    array.push(engine.categoryTimeHlRootSlots, rootSlot)
                else if category == CAT_FVG
                    catNewPos := array.size(engine.categoryFvgRootSlots)
                    array.push(engine.categoryFvgRootSlots, rootSlot)
                else if category == CAT_PSYCH
                    catNewPos := array.size(engine.categoryPsychRootSlots)
                    array.push(engine.categoryPsychRootSlots, rootSlot)
                array.set(engine.rootCategorySetPositions, rootSlot, catNewPos)
                int tfNewPos = SLOT_INVALID
                if tfCode == TF_1M
                    tfNewPos := array.size(engine.tf1mRootSlots)
                    array.push(engine.tf1mRootSlots, rootSlot)
                else if tfCode == TF_5M
                    tfNewPos := array.size(engine.tf5mRootSlots)
                    array.push(engine.tf5mRootSlots, rootSlot)
                else if tfCode == TF_15M
                    tfNewPos := array.size(engine.tf15mRootSlots)
                    array.push(engine.tf15mRootSlots, rootSlot)
                else if tfCode == TF_1H
                    tfNewPos := array.size(engine.tf1hRootSlots)
                    array.push(engine.tf1hRootSlots, rootSlot)
                else if tfCode == TF_4H
                    tfNewPos := array.size(engine.tf4hRootSlots)
                    array.push(engine.tf4hRootSlots, rootSlot)
                else if tfCode == TF_D
                    tfNewPos := array.size(engine.tfDRootSlots)
                    array.push(engine.tfDRootSlots, rootSlot)
                array.set(engine.rootTfSetPositions, rootSlot, tfNewPos)
                int stateNewPos = SLOT_INVALID
                if state == ROOT_CANDIDATE
                    stateNewPos := array.size(engine.stateCandidateRootSlots)
                    array.push(engine.stateCandidateRootSlots, rootSlot)
                else if state == ROOT_ACTIVE
                    stateNewPos := array.size(engine.stateActiveRootSlots)
                    array.push(engine.stateActiveRootSlots, rootSlot)
                else if state == ROOT_INVALIDATED
                    stateNewPos := array.size(engine.stateInvalidatedRootSlots)
                    array.push(engine.stateInvalidatedRootSlots, rootSlot)
                else if state == ROOT_INVERSE_WAIT
                    stateNewPos := array.size(engine.stateInverseWaitRootSlots)
                    array.push(engine.stateInverseWaitRootSlots, rootSlot)
                else if state == ROOT_INVERSE_ACTIVE
                    stateNewPos := array.size(engine.stateInverseActiveRootSlots)
                    array.push(engine.stateInverseActiveRootSlots, rootSlot)
                else if state == ROOT_RETIRED
                    stateNewPos := array.size(engine.stateRetiredRootSlots)
                    array.push(engine.stateRetiredRootSlots, rootSlot)
                array.set(engine.rootStateSetPositions, rootSlot, stateNewPos)
                added := true
    added

// Removes one Root from all three dimensions at once, Category then TF then state.
// Runs only after the full membership validation, so a broken membership detaches
// nothing and is never repaired. Each removal moves the last entry into the freed
// position, updates that entry's stored position and pops the tail; this Root's
// three positions end at SLOT_INVALID. The logical Category / TF / state fields are
// left exactly as they are.
rootSetDetachAllRaw(ZoneEngine engine, int rootSlot) =>
    bool detached = false
    if rootSetMembershipValidRaw(engine, rootSlot)
        int category     = array.get(engine.rootCategories,           rootSlot)
        int tfCode       = array.get(engine.rootTfCodes,              rootSlot)
        int state        = array.get(engine.rootStates,               rootSlot)
        int catPos       = array.get(engine.rootCategorySetPositions, rootSlot)
        int tfPos        = array.get(engine.rootTfSetPositions,       rootSlot)
        int statePos     = array.get(engine.rootStateSetPositions,    rootSlot)
        int lastPos      = SLOT_INVALID
        int lastRootSlot = SLOT_INVALID
        if category == CAT_MA
            lastPos      := array.size(engine.categoryMaRootSlots) - 1
            lastRootSlot := array.get(engine.categoryMaRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryMaRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryMaRootSlots)
        else if category == CAT_SWING
            lastPos      := array.size(engine.categorySwingRootSlots) - 1
            lastRootSlot := array.get(engine.categorySwingRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categorySwingRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categorySwingRootSlots)
        else if category == CAT_ACCUM
            lastPos      := array.size(engine.categoryAccumRootSlots) - 1
            lastRootSlot := array.get(engine.categoryAccumRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryAccumRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryAccumRootSlots)
        else if category == CAT_TIME_HL
            lastPos      := array.size(engine.categoryTimeHlRootSlots) - 1
            lastRootSlot := array.get(engine.categoryTimeHlRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryTimeHlRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryTimeHlRootSlots)
        else if category == CAT_FVG
            lastPos      := array.size(engine.categoryFvgRootSlots) - 1
            lastRootSlot := array.get(engine.categoryFvgRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryFvgRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryFvgRootSlots)
        else if category == CAT_PSYCH
            lastPos      := array.size(engine.categoryPsychRootSlots) - 1
            lastRootSlot := array.get(engine.categoryPsychRootSlots, lastPos)
            if catPos != lastPos
                array.set(engine.categoryPsychRootSlots, catPos, lastRootSlot)
                array.set(engine.rootCategorySetPositions, lastRootSlot, catPos)
            array.pop(engine.categoryPsychRootSlots)
        array.set(engine.rootCategorySetPositions, rootSlot, SLOT_INVALID)
        if tfCode == TF_1M
            lastPos      := array.size(engine.tf1mRootSlots) - 1
            lastRootSlot := array.get(engine.tf1mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf1mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf1mRootSlots)
        else if tfCode == TF_5M
            lastPos      := array.size(engine.tf5mRootSlots) - 1
            lastRootSlot := array.get(engine.tf5mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf5mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf5mRootSlots)
        else if tfCode == TF_15M
            lastPos      := array.size(engine.tf15mRootSlots) - 1
            lastRootSlot := array.get(engine.tf15mRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf15mRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf15mRootSlots)
        else if tfCode == TF_1H
            lastPos      := array.size(engine.tf1hRootSlots) - 1
            lastRootSlot := array.get(engine.tf1hRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf1hRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf1hRootSlots)
        else if tfCode == TF_4H
            lastPos      := array.size(engine.tf4hRootSlots) - 1
            lastRootSlot := array.get(engine.tf4hRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tf4hRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tf4hRootSlots)
        else if tfCode == TF_D
            lastPos      := array.size(engine.tfDRootSlots) - 1
            lastRootSlot := array.get(engine.tfDRootSlots, lastPos)
            if tfPos != lastPos
                array.set(engine.tfDRootSlots, tfPos, lastRootSlot)
                array.set(engine.rootTfSetPositions, lastRootSlot, tfPos)
            array.pop(engine.tfDRootSlots)
        array.set(engine.rootTfSetPositions, rootSlot, SLOT_INVALID)
        if state == ROOT_CANDIDATE
            lastPos      := array.size(engine.stateCandidateRootSlots) - 1
            lastRootSlot := array.get(engine.stateCandidateRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateCandidateRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateCandidateRootSlots)
        else if state == ROOT_ACTIVE
            lastPos      := array.size(engine.stateActiveRootSlots) - 1
            lastRootSlot := array.get(engine.stateActiveRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateActiveRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateActiveRootSlots)
        else if state == ROOT_INVALIDATED
            lastPos      := array.size(engine.stateInvalidatedRootSlots) - 1
            lastRootSlot := array.get(engine.stateInvalidatedRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInvalidatedRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInvalidatedRootSlots)
        else if state == ROOT_INVERSE_WAIT
            lastPos      := array.size(engine.stateInverseWaitRootSlots) - 1
            lastRootSlot := array.get(engine.stateInverseWaitRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInverseWaitRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInverseWaitRootSlots)
        else if state == ROOT_INVERSE_ACTIVE
            lastPos      := array.size(engine.stateInverseActiveRootSlots) - 1
            lastRootSlot := array.get(engine.stateInverseActiveRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateInverseActiveRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateInverseActiveRootSlots)
        else if state == ROOT_RETIRED
            lastPos      := array.size(engine.stateRetiredRootSlots) - 1
            lastRootSlot := array.get(engine.stateRetiredRootSlots, lastPos)
            if statePos != lastPos
                array.set(engine.stateRetiredRootSlots, statePos, lastRootSlot)
                array.set(engine.rootStateSetPositions, lastRootSlot, statePos)
            array.pop(engine.stateRetiredRootSlots)

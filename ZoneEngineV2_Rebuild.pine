// -----------------------------------------------------------------------------
// 4. Numeric helpers. Every price comparison that decides a boundary goes
//    through the minimum tick first (appendix D), with no extra epsilon and no
//    private rounding.
// -----------------------------------------------------------------------------
toTick(float price, float mintick) =>
    na(price) or na(mintick) or mintick <= 0.0 ? na : int(math.round(price / mintick))

tGe(float a, float b, float mt) => toTick(a, mt) >= toTick(b, mt)
tLe(float a, float b, float mt) => toTick(a, mt) <= toTick(b, mt)
tGt(float a, float b, float mt) => toTick(a, mt) > toTick(b, mt)
tLt(float a, float b, float mt) => toTick(a, mt) < toTick(b, mt)

originKey3(int a, int b, int c) =>
    int h = 2166136261
    h := (h * 16777619 + a) % 2147483647
    h := (h * 16777619 + b) % 2147483647
    h := (h * 16777619 + c) % 2147483647
    h < 0 ? -h : h

intervalGap(float aBot, float aTop, float bBot, float bTop) =>
    aTop < bBot ? bBot - aTop : bTop < aBot ? aBot - bTop : 0.0

// Inclusive intersection, decided on ticks.
intersectsT(float aBot, float aTop, float bBot, float bTop, float mt) =>
    tGe(aTop, bBot, mt) and tGe(bTop, aBot, mt)

popCount6(int mask) =>
    int n = 0
    for i = 0 to 5
        n += (mask & (1 << i)) != 0 ? 1 : 0
    n

// -----------------------------------------------------------------------------
// 5. Configuration factory and validation
//    validateCfg() runs on every confirmed base bar: the configuration object is
//    caller owned and can change at any time, so no fingerprint shortcut is used.
// -----------------------------------------------------------------------------
export newCfg() =>
    ZoneCfg.new()

export validateCfg(ZoneCfg cfg) =>
    string err = ""
    err := cfg.clusterMaxWidth <= 0.0 ? err + "clusterMaxWidth<=0; " : err
    err := cfg.denseRatio <= 0.0 or cfg.denseRatio > 1.0 ? err + "denseRatio out of range; " : err
    err := cfg.touchResetDistance <= 0.0 ? err + "touchResetDistance<=0; " : err
    err := cfg.breakBuffer < 0.0 ? err + "breakBuffer<0; " : err
    err := cfg.touchTolerance < 0.0 ? err + "touchTolerance<0; " : err
    err := cfg.emaSlopeLookback < 1 ? err + "emaSlopeLookback<1; " : err
    err := cfg.swingLen5m < 1 or cfg.swingLen15m < 1 or cfg.swingLen1h < 1 ? err + "swing pivot length<1; " : err
    err := cfg.weakDepthPct < 0.0 or cfg.weakDepthPct > 100.0 ? err + "weakDepthPct out of range; " : err
    err := cfg.strongUnlimited and not cfg.weakFromTouchOff ? err + "strongUnlimited requires weakFromTouchOff; " : err
    err := not cfg.strongUnlimited and cfg.strongUntilTouch < 1 ? err + "strongUntilTouch<1; " : err
    err := not cfg.weakFromTouchOff and cfg.weakFromTouch < 2 ? err + "weakFromTouch<2; " : err
    err := not cfg.strongUnlimited and not cfg.weakFromTouchOff and cfg.strongUntilTouch >= cfg.weakFromTouch ? err + "strongUntilTouch must be < weakFromTouch; " : err
    err := cfg.mintick <= 0.0 ? err + "mintick<=0; " : err
    err := cfg.accumRangeLen < 2 or cfg.accumBaseLen < cfg.accumRangeLen ? err + "accum range/base length invalid; " : err
    err := cfg.accumAtrLen < 1 ? err + "accumAtrLen<1; " : err
    err := cfg.accumMinUpperCloses < 0 or cfg.accumMinUpperCloses > cfg.accumRangeLen ? err + "accumMinUpperCloses out of range; " : err
    err := cfg.accumMinLowerCloses < 0 or cfg.accumMinLowerCloses > cfg.accumRangeLen ? err + "accumMinLowerCloses out of range; " : err
    err := cfg.accumMaxSameColorRun < 1 ? err + "accumMaxSameColorRun<1; " : err
    err := cfg.accumAtrMult <= 0.0 or cfg.accumBarRatioMax <= 0.0 or cfg.accumDriftMax < 0.0 ? err + "accum ratio invalid; " : err
    err := cfg.dormantDistance <= 0.0 ? err + "dormantDistance<=0; " : err
    err := cfg.maxSwingRoots < 1 or cfg.maxAccumBoxes < 1 or cfg.maxFvgRoots < 1 or cfg.maxTimeRoots < 1 ? err + "root storage limit<1; " : err
    err := cfg.maxZoneCores < 1 or cfg.maxEndedGenerations < 0 or cfg.maxTouchMarksPerCore < 1 ? err + "core storage limit invalid; " : err
    err := str.length(cfg.zoneTimezone) == 0 ? err + "zoneTimezone empty; " : err
    err := cfg.asiaStartMin < 0 or cfg.asiaStartMin > 1440 or cfg.europeStartMin < 0 or cfg.europeStartMin > 1440 ? err + "session start out of range; " : err
    err := cfg.nyStartMin < 0 or cfg.nyStartMin > 1440 or cfg.nyEndMin < 0 or cfg.nyEndMin > 1440 ? err + "NY session out of range; " : err
    err := cfg.dayCutMin < 0 or cfg.dayCutMin >= 1440 ? err + "dayCutMin out of range; " : err
    err := cfg.weekCutDow < 1 or cfg.weekCutDow > 7 ? err + "weekCutDow out of range; " : err
    cfg.denseWidth := cfg.clusterMaxWidth * cfg.denseRatio
    cfg.valid := str.length(err) == 0
    cfg.errorText := err
    cfg.valid

export cfgValid(ZoneCfg cfg) => cfg.valid
export cfgError(ZoneCfg cfg) => cfg.errorText
export cfgDenseWidth(ZoneCfg cfg) => cfg.denseWidth

// =============================================================================
// 6. Source / Feed helpers
//    These are evaluated inside the caller's request.security() context. The
//    library itself never calls request.*. Every helper reports the source bar
//    close time so the engine can refuse values from a still forming source bar
//    instead of relying on a blanket [1] offset.
// =============================================================================

// 6.1 MA pack - one 1m context for both EMAs, both slopes and the source time.
export maPackV2(simple int slopeLookback) =>
    float e2 = ta.ema(close, 2000)
    float e3 = ta.ema(close, 3000)
    float s2 = e2 - e2[slopeLookback]
    float s3 = e3 - e3[slopeLookback]
    [e2, s2, e3, s3, time_close]

// 6.2 Pivot pack - price, OriginTime, OriginEndTime and ConfirmedTime split.
export pivotPackV2(simple int len) =>
    var float phP = na
    var int   phO = na
    var int   phE = na
    var int   phC = na
    var float plP = na
    var int   plO = na
    var int   plE = na
    var int   plC = na
    float ph = ta.pivothigh(len, len)
    float pl = ta.pivotlow(len, len)
    if not na(ph)
        phP := ph
        phO := time[len]
        phE := time_close[len]
        phC := time_close
    if not na(pl)
        plP := pl
        plO := time[len]
        plE := time_close[len]
        plC := time_close
    [phP, phO, phE, phC, plP, plO, plE, plC]

// 6.3 Accum detection.
//     Formation condition transcribed from appendix A 7.4 of the instruction
//     document (the normative f_accumBoxCore expression). Body extremes, the
//     single window rangeMid, the body-midpoint drift, and the separate bull /
//     bear run counters are reproduced exactly, including the comparison
//     operators and the counter initialisation. No rounding, no tick
//     normalisation and no extra warm-up guard is added to these intermediates.
//     rangeHigh / rangeLow are returned so the Candidate start range uses the
//     same intermediate values instead of recomputing the window.
accumCondV2(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    float bodyTop = math.max(open, close)
    float bodyBot = math.min(open, close)
    float rangeHigh = ta.highest(bodyTop, rangeLen)
    float rangeLow  = ta.lowest(bodyBot, rangeLen)
    float rangeNow  = rangeHigh - rangeLow
    float rangeMid  = (rangeHigh + rangeLow) * 0.5
    float rangeBase = ta.highest(bodyTop, baseLen) - ta.lowest(bodyBot, baseLen)
    float atrValue  = ta.atr(atrLen)
    int upperCloses = 0
    int lowerCloses = 0
    int bullRun     = 0
    int bearRun     = 0
    int maxBullRun  = 0
    int maxBearRun  = 0
    for i = 0 to rangeLen - 1
        upperCloses += close[i] > rangeMid ? 1 : 0
        lowerCloses += close[i] < rangeMid ? 1 : 0
        if close[i] > open[i]
            bullRun += 1
            bearRun := 0
        else if close[i] < open[i]
            bearRun += 1
            bullRun := 0
        else
            bullRun := 0
            bearRun := 0
        maxBullRun := bullRun > maxBullRun ? bullRun : maxBullRun
        maxBearRun := bearRun > maxBearRun ? bearRun : maxBearRun
    float startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    float endMid   = (open + close) * 0.5
    float drift    = math.abs(endMid - startMid)
    bool condAtr      = atrValue > 0 and rangeNow <= atrValue * atrMult
    bool condBar      = rangeBase > 0 and rangeNow <= rangeBase * barRatioMax
    bool condBalance  = upperCloses >= minUpper and lowerCloses >= minLower
    bool condDrift    = rangeNow > 0 and drift / rangeNow <= driftMax
    bool condColorRun = maxBullRun <= maxRun and maxBearRun <= maxRun
    bool isAccum = condAtr and condBar and condBalance and condDrift and condColorRun
    [isAccum, rangeHigh, rangeLow]

// Candidate is never exported as a Root. A Box is emitted exactly once, on the
// source bar where the condition turns true -> false, and that closing bar is
// not part of the Box.
export accumPackV2(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    var bool  inCand   = false
    var float candTop  = na
    var float candBot  = na
    var int   candStart = na
    var bool  outNew   = false
    var float outTop   = na
    var float outBot   = na
    var int   outId    = na
    var int   outStart = na
    var int   outConf  = na
    [cond, rangeHigh, rangeLow] = accumCondV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    float bodyTop = math.max(open, close)
    float bodyBot = math.min(open, close)
    outNew := false
    if cond and not inCand
        inCand := true
        candStart := time
        candTop := rangeHigh
        candBot := rangeLow
    else if cond and inCand
        candTop := math.max(candTop, bodyTop)
        candBot := math.min(candBot, bodyBot)
    else if not cond and inCand
        outNew := true
        outTop := candTop
        outBot := candBot
        outStart := candStart
        outConf := time_close
        outId := originKey3(candStart, int(math.round(candTop * 100000)), int(math.round(candBot * 100000)))
        inCand := false
        candTop := na
        candBot := na
        candStart := na
    [outNew, outTop, outBot, outId, outStart, outConf]

// 6.4 FVG pack - three confirmed source bars, plus the newly confirmed source
//     bar used for structural invalidation and for Fresh bookkeeping.
export fvgPackV2() =>
    var bool  bullNew = false
    var float bullTop = na
    var float bullBot = na
    var int   bullOrg = na
    var int   bullCnf = na
    var bool  bearNew = false
    var float bearTop = na
    var float bearBot = na
    var int   bearOrg = na
    var int   bearCnf = na
    bool isBull = low > high[2]
    bool isBear = high < low[2]
    bullNew := isBull
    bearNew := isBear
    if isBull
        bullBot := high[2]
        bullTop := low
        bullOrg := time
        bullCnf := time_close
    if isBear
        bearBot := high
        bearTop := low[2]
        bearOrg := time
        bearCnf := time_close
    [bullNew, bullTop, bullBot, bullOrg, bullCnf, bearNew, bearTop, bearBot, bearOrg, bearCnf, high, low, close, time, time_close]

// 6.5 Consolidated per-timeframe packs. One request context per timeframe.
//     1H carries Swing + Accum + FVG + confirmed source bar in a single call.
export htfPackSwingV2(simple int swingLen, simple int rangeLen, simple int baseLen,
     simple int atrLen, simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [phP, phO, phE, phC, plP, plO, plE, plC] = pivotPackV2(swingLen)
    [aNew, aTop, aBot, aId, aStart, aConf] = accumPackV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [fbN, fbT, fbB, fbO, fbC, fsN, fsT, fsB, fsO, fsC, sH, sL, sC, sOT, sCT] = fvgPackV2()
    [phP, phO, phE, phC, plP, plO, plE, plC, aNew, aTop, aBot, aId, aStart, aConf, fbN, fbT, fbB, fbO, fbC, fsN, fsT, fsB, fsO, fsC, sH, sL, sC, sOT, sCT]

export htfPackV2(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [aNew, aTop, aBot, aId, aStart, aConf] = accumPackV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [fbN, fbT, fbB, fbO, fbC, fsN, fsT, fsB, fsO, fsC, sH, sL, sC, sOT, sCT] = fvgPackV2()
    [aNew, aTop, aBot, aId, aStart, aConf, fbN, fbT, fbB, fbO, fbC, fsN, fsT, fsB, fsO, fsC, sH, sL, sC, sOT, sCT]

// 6.6 Pack constructors used by the harness after destructuring the tuples.
export newBaseFeed(float o, float h, float l, float c, float prevClose,
     int openTime, int closeTime, int seq, bool confirmed, float mintick) =>
    BaseFeed.new(o, h, l, c, prevClose, openTime, closeTime, seq, confirmed, mintick)

export newMaPack(float e2, float s2, float e3, float s3, int srcCloseTime) =>
    MaPack.new(e2, s2, e3, s3, srcCloseTime)

export newPivotPack(int tfCode, float hP, int hO, int hE, int hC, float lP, int lO, int lE, int lC) =>
    PivotPack.new(tfCode, hP, hO, hE, hC, lP, lO, lE, lC)

export newAccumPack(int tfCode, bool newBox, float top, float bottom, int boxId, int candStart, int confirmed) =>
    AccumPack.new(tfCode, newBox, top, bottom, boxId, candStart, confirmed)

export newFvgPack(int tfCode, bool bullNew, float bullTop, float bullBot, int bullOrg, int bullCnf,
     bool bearNew, float bearTop, float bearBot, int bearOrg, int bearCnf,
     float srcHigh, float srcLow, float srcClose, int srcOpenTime, int srcCloseTime) =>
    FvgPack.new(tfCode, bullNew, bullTop, bullBot, bullOrg, bullCnf, bearNew, bearTop, bearBot, bearOrg, bearCnf, srcHigh, srcLow, srcClose, srcOpenTime, srcCloseTime)

// =============================================================================
// 7. Engine factory and root registry
//    Logical Root ID and physical slot are separate. Freed slots are reused,
//    logical IDs are never reused, and liveOrder keeps a deterministic scan
//    order (ascending Root ID) independent of the slot layout.
// =============================================================================
export newEngine() =>
    ZoneEngine e = ZoneEngine.new()
    e.roots      := array.new<Root>()
    e.freeSlots  := array.new<int>()
    e.liveOrder  := array.new<int>()
    e.idToSlot   := map.new<int, int>()
    e.originToId := map.new<int, int>()
    e.ownerOfRoot := map.new<int, int>()
    e.catCount   := array.new<int>(6, 0)
    e.idxMa      := array.new<int>()
    e.idxSwing   := array.new<int>()
    e.idxAccum   := array.new<int>()
    e.idxTime    := array.new<int>()
    e.idxFvg     := array.new<int>()
    e.idxPsych   := array.new<int>()
    e.cores      := array.new<ZoneCore>()
    e.events     := array.new<ZoneEvent>()
    e.views      := array.new<ZoneView>()
    e.endedGenCores := array.new<int>()
    e.endedGenIds   := array.new<int>()
    e.sLotSlot   := array.new<int>()
    e.sLotPrice  := array.new<float>()
    e.sLotTick   := array.new<int>()
    e.sUsed      := array.new<int>()
    e.sCatCnt    := array.new<int>(6, 0)
    e.sPairs     := array.new<int>()
    e.sTmpA      := array.new<int>()
    e.sTmpB      := array.new<int>()
    e.sTmpF      := array.new<float>()
    e.sRefs      := array.new<float>()
    e.sFvgId     := array.new<int>()
    e.sFvgBot    := array.new<float>()
    e.sFvgTop    := array.new<float>()
    e.sFvgProx   := array.new<float>()
    e.sFvgBroad  := array.new<int>()
    e.sFvgTf     := array.new<int>()
    e.sFvgDir    := array.new<int>()
    e.sFvgConf   := array.new<int>()
    e.sFvgUsed   := array.new<int>()
    e.sFvgLocal  := array.new<int>()
    e.sAttach    := array.new<int>()
    e.sPsyBot    := array.new<float>()
    e.sPsyTop    := array.new<float>()
    e.sPsyUsed   := array.new<int>()
    e.candSide   := array.new<int>()
    e.candStart  := array.new<int>()
    e.candLen    := array.new<int>()
    e.candRootIds := array.new<int>()
    e.candBottom := array.new<float>()
    e.candTop    := array.new<float>()
    e.candC      := array.new<int>()
    e.candH      := array.new<int>()
    e.candDensity := array.new<int>()
    e.candStrong := array.new<int>()
    e.candCatMask := array.new<int>()
    e.candHighMask := array.new<int>()
    e.candRefPrice := array.new<float>()
    e.candBroadCtx := array.new<int>()
    e.candFormTime := array.new<int>()
    e.candMinId    := array.new<int>()
    e.snapCoreIdx    := array.new<int>()
    e.snapOriginStart := array.new<int>()
    e.snapOriginLen  := array.new<int>()
    e.snapOrigins    := array.new<int>()
    e.snapBot        := array.new<float>()
    e.snapTop        := array.new<float>()
    e.snapBroadCtx   := array.new<int>()
    e.snapActive     := array.new<int>()
    e.edgeCand       := array.new<int>()
    e.edgeNode       := array.new<int>()
    e.ufParent       := array.new<int>()
    e.compOfCand     := array.new<int>()
    e.compOfSnap     := array.new<int>()
    e.slotCoreIdx    := array.new<int>()
    e.slotSupCand    := array.new<int>()
    e.slotResCand    := array.new<int>()
    e.orderBuf       := array.new<int>()
    e.compRep        := array.new<int>()
    e.compMinCore    := array.new<int>()
    e.compSnapBuf    := array.new<int>()
    e.episodeSnap    := array.new<TouchEpisode>()
    e

catIndexArr(ZoneEngine e, int cat) =>
    switch cat
        0 => e.idxMa
        1 => e.idxSwing
        2 => e.idxAccum
        3 => e.idxTime
        4 => e.idxFvg
        => e.idxPsych

catEnabled(ZoneCfg cfg, int cat) =>
    switch cat
        0 => cfg.catMa
        1 => cfg.catSwing
        2 => cfg.catAccum
        3 => cfg.catTime
        4 => cfg.catFvg
        => cfg.catPsych

slotOf(ZoneEngine e, int rootId) =>
    map.contains(e.idToSlot, rootId) ? map.get(e.idToSlot, rootId) : -1

rootOf(ZoneEngine e, int rootId) =>
    int s = slotOf(e, rootId)
    s >= 0 ? array.get(e.roots, s) : na

liveOrderInsert(ZoneEngine e, int slot, int rootId) =>
    int n = array.size(e.liveOrder)
    Root rlast = n > 0 ? array.get(e.roots, array.get(e.liveOrder, n - 1)) : na
    if n == 0 or rlast.rootId < rootId
        array.push(e.liveOrder, slot)
    else
        int lo = 0
        int hi = n
        while lo < hi
            int mid = int((lo + hi) / 2)
            Root rm = array.get(e.roots, array.get(e.liveOrder, mid))
            if rm.rootId < rootId
                lo := mid + 1
            else
                hi := mid
        array.insert(e.liveOrder, lo, slot)

liveOrderRemove(ZoneEngine e, int slot) =>
    int n = array.size(e.liveOrder)
    int found = -1
    if n > 0
        for i = 0 to n - 1
            if array.get(e.liveOrder, i) == slot
                found := i
                break
    if found >= 0
        array.remove(e.liveOrder, found)

registerRoot(ZoneEngine e, Root r) =>
    int slot = array.size(e.freeSlots) > 0 ? array.pop(e.freeSlots) : -1
    if slot >= 0
        array.set(e.roots, slot, r)
    else
        array.push(e.roots, r)
        slot := array.size(e.roots) - 1
    map.put(e.idToSlot, r.rootId, slot)
    map.put(e.originToId, r.originKey, r.rootId)
    liveOrderInsert(e, slot, r.rootId)
    array.push(catIndexArr(e, r.category), slot)
    array.set(e.catCount, r.category, array.get(e.catCount, r.category) + 1)
    e.dirtyRootSet := true
    e.dirtyRootPrice := true
    slot

unregisterRoot(ZoneEngine e, int rootId) =>
    int slot = slotOf(e, rootId)
    if slot >= 0
        Root r = array.get(e.roots, slot)
        array<int> ci = catIndexArr(e, r.category)
        int n = array.size(ci)
        int at = -1
        if n > 0
            for i = 0 to n - 1
                if array.get(ci, i) == slot
                    at := i
                    break
        if at >= 0
            array.remove(ci, at)
        liveOrderRemove(e, slot)
        map.remove(e.idToSlot, rootId)
        if map.contains(e.originToId, r.originKey) and map.get(e.originToId, r.originKey) == rootId
            map.remove(e.originToId, r.originKey)
        int cc = array.get(e.catCount, r.category) - 1
        array.set(e.catCount, r.category, cc < 0 ? 0 : cc)
        r.state := 5
        array.push(e.freeSlots, slot)
        e.dirtyRootSet := true
        e.dirtyRootPrice := true
    slot >= 0

export rootCount(ZoneEngine e) =>
    array.size(e.liveOrder)

export rootAt(ZoneEngine e, int i) =>
    array.get(e.roots, array.get(e.liveOrder, i))

export rootInfo(Root r) =>
    categoryName(r.category) + "#" + str.tostring(r.rootId) + " " + tfName(r.tfCode) + " " +
     (r.isRangeRoot ? str.tostring(r.nativeBottom, format.mintick) + "-" + str.tostring(r.nativeTop, format.mintick)
      : str.tostring(r.pointPrice, format.mintick)) + " " + rootStateName(r.state)

// =============================================================================
// 8. Root ingestion (step E of the bar update)
// =============================================================================

// 8.1 MA - two fixed IDs, current price only, no historical EMA trail.
ingestMa(ZoneEngine e, ZoneCfg cfg, MaPack ma, int baseCloseTime) =>
    if cfg.catMa and not na(ma.ema2000) and not na(ma.srcCloseTime) and ma.srcCloseTime <= baseCloseTime
        e.lastMaSrcTime := ma.srcCloseTime
        for k = 0 to 1
            float px = k == 0 ? ma.ema2000 : ma.ema3000
            float slp = k == 0 ? ma.ema2000Slope : ma.ema3000Slope
            int   sub = k == 0 ? 0 : 1
            int   ok = originKey3(1000, sub, 0)
            int   dir = na(slp) ? 0 : slp > 0.0 ? 1 : slp < 0.0 ? -1 : 0
            int   tick = toTick(px, cfg.mintick)
            if map.contains(e.originToId, ok)
                Root r = rootOf(e, map.get(e.originToId, ok))
                if not na(r)
                    e.dirtyRootPrice := e.dirtyRootPrice or r.priceTick != tick
                    e.dirtyQuality := e.dirtyQuality or r.slopeDir != dir
                    r.pointPrice := px
                    r.priceTick := tick
                    r.slopeDir := dir
                    r.lastUpdateSeq := e.seq
            else
                Root r = Root.new(rootId = e.nextRootId, originKey = ok, category = 0, subtype = sub, tfCode = 1,
                     originTime = ma.srcCloseTime, originEndTime = ma.srcCloseTime, confirmedTime = ma.srcCloseTime,
                     pointPrice = px, priceTick = tick, isRangeRoot = false, isDynamic = true, state = 1,
                     fvgFresh = false, slopeDir = dir, lastUpdateSeq = e.seq)
                e.nextRootId += 1
                registerRoot(e, r)

// 8.2 Swing - ConfirmedTime gate, same-event merge across timeframes.
//     A Swing High and a Swing Low are different origin tags even at the same
//     price tick and in the same interval, so the merge is restricted to the
//     same extreme type (subtype).
swingIngestOne(ZoneEngine e, ZoneCfg cfg, int tfCode, int tfMask, float price,
     int originTime, int originEndTime, int confirmedTime, bool isHigh) =>
    int tick = toTick(price, cfg.mintick)
    int sub = isHigh ? 2 : 3
    int mergeId = 0
    int n = array.size(e.idxSwing)
    if n > 0
        for i = n - 1 to 0
            Root r = array.get(e.roots, array.get(e.idxSwing, i))
            bool sameEvent = r.subtype == sub and r.priceTick == tick
            bool contained = originTime >= r.originTime and originTime < r.originEndTime
            bool contains = r.originTime >= originTime and r.originTime < originEndTime
            if sameEvent and (contained or contains)
                mergeId := r.rootId
                break
    if mergeId != 0
        Root r = rootOf(e, mergeId)
        if not na(r) and (r.labelMask & tfMask) == 0
            r.labelMask := r.labelMask | tfMask
            if tfCode > r.tfCode
                r.tfCode := tfCode
                r.originTime := originTime
                r.originEndTime := originEndTime
            r.confirmedTime := confirmedTime < r.confirmedTime ? confirmedTime : r.confirmedTime
            e.dirtyQuality := true
    else
        int ok = originKey3(2000 + tfCode, originTime, tick * 2 + (isHigh ? 1 : 0))
        Root r = Root.new(rootId = e.nextRootId, originKey = ok, category = 1, subtype = sub, tfCode = tfCode,
             originTime = originTime, originEndTime = originEndTime, confirmedTime = confirmedTime,
             pointPrice = price, priceTick = tick, isRangeRoot = false, state = 1, fvgFresh = false,
             labelMask = tfMask, lastUpdateSeq = e.seq)
        e.nextRootId += 1
        registerRoot(e, r)

ingestSwing(ZoneEngine e, ZoneCfg cfg, PivotPack pk, int tfMask, int baseCloseTime, int lastHighOrigin, int lastLowOrigin) =>
    int newHigh = lastHighOrigin
    int newLow  = lastLowOrigin
    if cfg.catSwing
        if not na(pk.highPrice) and not na(pk.highConfirmed) and pk.highConfirmed <= baseCloseTime and pk.highOrigin != lastHighOrigin
            swingIngestOne(e, cfg, pk.tfCode, tfMask, pk.highPrice, pk.highOrigin, pk.highOriginEnd, pk.highConfirmed, true)
            newHigh := pk.highOrigin
        if not na(pk.lowPrice) and not na(pk.lowConfirmed) and pk.lowConfirmed <= baseCloseTime and pk.lowOrigin != lastLowOrigin
            swingIngestOne(e, cfg, pk.tfCode, tfMask, pk.lowPrice, pk.lowOrigin, pk.lowOriginEnd, pk.lowConfirmed, false)
            newLow := pk.lowOrigin
    [newHigh, newLow]

// 8.3 Accum - confirmed Box only; upper and lower share a pairKey and are a
//     mutually exclusive pair for every clustering and storage decision.
ingestAccum(ZoneEngine e, ZoneCfg cfg, AccumPack ap, int baseCloseTime, int lastConfirm) =>
    int outConfirm = lastConfirm
    if cfg.catAccum and ap.newBox and not na(ap.confirmedTime) and ap.confirmedTime <= baseCloseTime and ap.confirmedTime != lastConfirm and not na(ap.boxTop) and not na(ap.boxBottom)
        int pairKey = originKey3(3000 + ap.tfCode, ap.candStartTime, ap.boxId)
        if not map.contains(e.originToId, originKey3(pairKey, 1, 0))
            for k = 0 to 1
                bool isUpper = k == 0
                float px = isUpper ? ap.boxTop : ap.boxBottom
                int ok = originKey3(pairKey, isUpper ? 1 : 2, 0)
                Root r = Root.new(rootId = e.nextRootId, originKey = ok, category = 2, subtype = isUpper ? 4 : 5,
                     tfCode = ap.tfCode, originTime = ap.candStartTime, originEndTime = ap.confirmedTime,
                     confirmedTime = ap.confirmedTime, pointPrice = px, priceTick = toTick(px, cfg.mintick),
                     isRangeRoot = false, state = 1, pairKey = pairKey, fvgFresh = false, lastUpdateSeq = e.seq)
                e.nextRootId += 1
                registerRoot(e, r)
        outConfirm := ap.confirmedTime
    outConfirm

// 8.4 FVG creation - third source bar must be confirmed.
fvgIngestOne(ZoneEngine e, ZoneCfg cfg, int tfCode, int dir, float top, float bottom, int originTime, int confirmedTime) =>
    int ok = originKey3(4000 + tfCode, originTime, dir)
    if not map.contains(e.originToId, ok) and not na(top) and not na(bottom) and tGt(top, bottom, cfg.mintick)
        Root r = Root.new(rootId = e.nextRootId, originKey = ok, category = 4, subtype = 8, tfCode = tfCode,
             originTime = originTime, originEndTime = originTime, confirmedTime = confirmedTime,
             nativeBottom = bottom, nativeTop = top, bottomTick = toTick(bottom, cfg.mintick),
             topTick = toTick(top, cfg.mintick), isRangeRoot = true, state = 1, direction = dir,
             fvgFresh = true, isBroadFvg = tGt(top - bottom, cfg.clusterMaxWidth, cfg.mintick), lastUpdateSeq = e.seq)
        e.nextRootId += 1
        registerRoot(e, r)
        e.dirtyFvgState := true

ingestFvgNew(ZoneEngine e, ZoneCfg cfg, FvgPack fp, int baseCloseTime) =>
    if cfg.catFvg and not na(fp.srcCloseTime) and fp.srcCloseTime <= baseCloseTime
        if fp.bullNew and not na(fp.bullConfirmed) and fp.bullConfirmed <= baseCloseTime
            fvgIngestOne(e, cfg, fp.tfCode, 1, fp.bullTop, fp.bullBottom, fp.bullOrigin, fp.bullConfirmed)
        if fp.bearNew and not na(fp.bearConfirmed) and fp.bearConfirmed <= baseCloseTime
            fvgIngestOne(e, cfg, fp.tfCode, 2, fp.bearTop, fp.bearBottom, fp.bearOrigin, fp.bearConfirmed)

// 8.5 Session / day / week keys (JST cuts by default, all configurable).
minOfDayTz(int t, string tz) =>
    hour(t, tz) * 60 + minute(t, tz)

dayKeyTz(int t, ZoneCfg cfg) =>
    int t2 = t - cfg.dayCutMin * 60000
    year(t2, cfg.zoneTimezone) * 10000 + month(t2, cfg.zoneTimezone) * 100 + dayofmonth(t2, cfg.zoneTimezone)

weekKeyTz(int t, ZoneCfg cfg) =>
    int t2 = t - cfg.dayCutMin * 60000
    int dow = dayofweek(t2, cfg.zoneTimezone)
    int back = (dow + 7 - cfg.weekCutDow) % 7
    int t3 = t2 - back * MS_DAY
    year(t3, cfg.zoneTimezone) * 10000 + month(t3, cfg.zoneTimezone) * 100 + dayofmonth(t3, cfg.zoneTimezone)

sessionIdxOf(int m, ZoneCfg cfg) =>
    m >= cfg.asiaStartMin and m < cfg.europeStartMin ? 1 :
     m >= cfg.europeStartMin and m < cfg.nyStartMin ? 2 :
     (m >= cfg.nyStartMin or m < cfg.nyEndMin) ? 3 : 0

// 8.6 Time high/low. One real extreme event = one Root; the period labels are a
//     bit mask on it, so a rollover keeps the same Root ID. A period High and a
//     period Low are different origin tags and are never merged into one Root.
timeLabelDrop(ZoneEngine e, int rootId, int bit) =>
    if rootId != 0
        Root r = rootOf(e, rootId)
        if not na(r)
            r.labelMask := (r.labelMask & bit) != 0 ? r.labelMask - bit : r.labelMask
            if r.labelMask == 0
                unregisterRoot(e, rootId)

timeLabelMove(ZoneEngine e, int rootId, int fromBit, int toBit) =>
    int outId = 0
    if rootId != 0
        Root r = rootOf(e, rootId)
        if not na(r)
            r.labelMask := (r.labelMask & fromBit) != 0 ? r.labelMask - fromBit : r.labelMask
            r.labelMask := r.labelMask | toBit
            outId := rootId
    outId

timeLabelSet(ZoneEngine e, ZoneCfg cfg, int bit, float price, int t, bool isHigh) =>
    int tick = toTick(price, cfg.mintick)
    int sub = isHigh ? 9 : 10
    int found = 0
    int n = array.size(e.idxTime)
    if n > 0
        for i = n - 1 to 0
            Root r = array.get(e.roots, array.get(e.idxTime, i))
            if r.subtype == sub and r.priceTick == tick and r.originTime == t
                found := r.rootId
                break
    if found != 0
        Root r = rootOf(e, found)
        r.labelMask := r.labelMask | bit
    else
        Root r = Root.new(rootId = e.nextRootId, originKey = originKey3(5000, t, tick * 2 + (isHigh ? 1 : 0)),
             category = 3, subtype = sub, tfCode = 5, originTime = t, originEndTime = t, confirmedTime = t,
             pointPrice = price, priceTick = tick, isRangeRoot = false, state = 1, fvgFresh = false,
             labelMask = bit, lastUpdateSeq = e.seq)
        e.nextRootId += 1
        registerRoot(e, r)
        found := r.rootId
    e.dirtyQuality := true
    found

updateTimeHL(ZoneEngine e, ZoneCfg cfg, BaseFeed f) =>
    if cfg.catTime
        int m = minOfDayTz(f.openTime, cfg.zoneTimezone)
        int sIdx = sessionIdxOf(m, cfg)
        int dKey = dayKeyTz(f.openTime, cfg)
        int wKey = weekKeyTz(f.openTime, cfg)
        int sKey = sIdx == 0 ? -1 : dKey * 10 + sIdx
        if na(e.curWeekKey) or e.curWeekKey != wKey
            if not na(e.curWeekKey)
                timeLabelDrop(e, e.prevWeekHighRoot, 32)
                timeLabelDrop(e, e.prevWeekLowRoot, 32)
                e.prevWeekHighRoot := timeLabelMove(e, e.curWeekHighRoot, 16, 32)
                e.prevWeekLowRoot  := timeLabelMove(e, e.curWeekLowRoot, 16, 32)
            e.curWeekKey := wKey
            e.curWeekHigh := na
            e.curWeekLow := na
            e.curWeekHighRoot := 0
            e.curWeekLowRoot := 0
        if na(e.curDayKey) or e.curDayKey != dKey
            if not na(e.curDayKey)
                timeLabelDrop(e, e.prevDayHighRoot, 8)
                timeLabelDrop(e, e.prevDayLowRoot, 8)
                e.prevDayHighRoot := timeLabelMove(e, e.curDayHighRoot, 4, 8)
                e.prevDayLowRoot  := timeLabelMove(e, e.curDayLowRoot, 4, 8)
            e.curDayKey := dKey
            e.curDayHigh := na
            e.curDayLow := na
            e.curDayHighRoot := 0
            e.curDayLowRoot := 0
        if na(e.curSessionId) or e.curSessionId != sKey
            if not na(e.curSessionId) and e.curSessionId != -1
                timeLabelDrop(e, e.lastSessHighRoot, 2)
                timeLabelDrop(e, e.lastSessLowRoot, 2)
                e.lastSessHighRoot := timeLabelMove(e, e.curSessHighRoot, 1, 2)
                e.lastSessLowRoot  := timeLabelMove(e, e.curSessLowRoot, 1, 2)
            e.curSessionId := sKey
            e.curSessHigh := na
            e.curSessLow := na
            e.curSessHighRoot := 0
            e.curSessLowRoot := 0
        if na(e.curWeekHigh) or tGt(f.h, e.curWeekHigh, cfg.mintick)
            e.curWeekHigh := f.h
            timeLabelDrop(e, e.curWeekHighRoot, 16)
            e.curWeekHighRoot := timeLabelSet(e, cfg, 16, f.h, f.openTime, true)
        if na(e.curWeekLow) or tLt(f.l, e.curWeekLow, cfg.mintick)
            e.curWeekLow := f.l
            timeLabelDrop(e, e.curWeekLowRoot, 16)
            e.curWeekLowRoot := timeLabelSet(e, cfg, 16, f.l, f.openTime, false)
        if na(e.curDayHigh) or tGt(f.h, e.curDayHigh, cfg.mintick)
            e.curDayHigh := f.h
            timeLabelDrop(e, e.curDayHighRoot, 4)
            e.curDayHighRoot := timeLabelSet(e, cfg, 4, f.h, f.openTime, true)
        if na(e.curDayLow) or tLt(f.l, e.curDayLow, cfg.mintick)
            e.curDayLow := f.l
            timeLabelDrop(e, e.curDayLowRoot, 4)
            e.curDayLowRoot := timeLabelSet(e, cfg, 4, f.l, f.openTime, false)
        if sIdx != 0
            if na(e.curSessHigh) or tGt(f.h, e.curSessHigh, cfg.mintick)
                e.curSessHigh := f.h
                timeLabelDrop(e, e.curSessHighRoot, 1)
                e.curSessHighRoot := timeLabelSet(e, cfg, 1, f.h, f.openTime, true)
            if na(e.curSessLow) or tLt(f.l, e.curSessLow, cfg.mintick)
                e.curSessLow := f.l
                timeLabelDrop(e, e.curSessLowRoot, 1)
                e.curSessLowRoot := timeLabelSet(e, cfg, 1, f.l, f.openTime, false)

// 8.7 FVG per-bar state. The structural invalidation fact is marked before any
//     state transition runs, so it outranks Reclaim on the same bar (spec 15).
markFvgInvalidation(ZoneEngine e, ZoneCfg cfg, BaseFeed f, FvgPack fp, int lastSrcClose) =>
    bool newSrc = not na(fp.srcCloseTime) and fp.srcCloseTime <= f.closeTime and fp.srcCloseTime != lastSrcClose
    int n = array.size(e.idxFvg)
    if newSrc and n > 0 and cfg.catFvg and not na(fp.srcClose)
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxFvg, i))
            if r.tfCode == fp.tfCode and r.state == 1
                r.pendingInvalidate := (r.direction == 1 and tLt(fp.srcClose, r.nativeBottom, cfg.mintick)) or
                     (r.direction == 2 and tGt(fp.srcClose, r.nativeTop, cfg.mintick))

applyFvgState(ZoneEngine e, ZoneCfg cfg, BaseFeed f, FvgPack fp, int lastSrcClose) =>
    int outSrc = lastSrcClose
    bool newSrc = not na(fp.srcCloseTime) and fp.srcCloseTime <= f.closeTime and fp.srcCloseTime != lastSrcClose
    int n = array.size(e.idxFvg)
    if n > 0 and cfg.catFvg
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxFvg, i))
            if r.tfCode == fp.tfCode
                r.isBroadFvg := tGt(r.nativeTop - r.nativeBottom, cfg.clusterMaxWidth, cfg.mintick)
                if r.fvgFresh and f.closeTime > r.confirmedTime and intersectsT(f.l, f.h, r.nativeBottom, r.nativeTop, cfg.mintick)
                    r.fvgFresh := false
                    e.dirtyFvgState := true
                if r.pendingInvalidate
                    r.pendingInvalidate := false
                    r.state := 3
                    r.movedAway := false
                    r.retestSeen := false
                    e.dirtyFvgState := true
                    array.push(e.events, ZoneEvent.new(eventType = 8, time = f.closeTime, baseSeq = f.seq,
                         side = 0, rangeBottom = r.nativeBottom, rangeTop = r.nativeTop, rootId = r.rootId))
    if newSrc
        outSrc := fp.srcCloseTime
    outSrc

// Inverse staging on confirmed base closes. Within one bar only one of
// "moved away" and "retest + recovery" can advance, so the intra-bar order is
// never assumed.
updateFvgInverse(ZoneEngine e, ZoneCfg cfg, BaseFeed f) =>
    int n = array.size(e.idxFvg)
    if n > 0 and cfg.catFvg
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxFvg, i))
            if r.state == 3
                bool bull = r.direction == 1
                float awayLevel = bull ? r.nativeBottom - cfg.touchResetDistance : r.nativeTop + cfg.touchResetDistance
                if not r.movedAway
                    r.movedAway := bull ? tLe(f.c, awayLevel, cfg.mintick) : tGe(f.c, awayLevel, cfg.mintick)
                else
                    bool retest = intersectsT(f.l, f.h, r.nativeBottom, r.nativeTop, cfg.mintick)
                    bool confirm = bull ? tLe(f.c, r.nativeBottom, cfg.mintick) : tGe(f.c, r.nativeTop, cfg.mintick)
                    if retest and confirm
                        r.state := 4
                        r.retestSeen := true
                        r.inverseConfirmSeq := f.seq
                        e.dirtyFvgState := true
                        array.push(e.events, ZoneEvent.new(eventType = 10, time = f.closeTime, baseSeq = f.seq,
                             side = bull ? -1 : 1, rangeBottom = r.nativeBottom, rangeTop = r.nativeTop, rootId = r.rootId))
                    else if retest
                        r.retestSeen := true
                        array.push(e.events, ZoneEvent.new(eventType = 9, time = f.closeTime, baseSeq = f.seq,
                             side = bull ? -1 : 1, rangeBottom = r.nativeBottom, rangeTop = r.nativeTop, rootId = r.rootId))

// =============================================================================
// 9. Price ordering, psychological prices, and the per side FVG working set
//    Only non-FVG, non-psychological roots enter the ordered list: appendix A
//    10.2 stage A enumerates candidate windows from those roots and only then
//    synthesises psychological prices around the candidate.
// =============================================================================
collectPoints(ZoneEngine e, ZoneCfg cfg) =>
    array.clear(e.sTmpA)
    array.clear(e.sTmpF)
    for c = 0 to 3
        if catEnabled(cfg, c)
            array<int> ci = catIndexArr(e, c)
            int n = array.size(ci)
            if n > 0
                for i = 0 to n - 1
                    int slot = array.get(ci, i)
                    Root r = array.get(e.roots, slot)
                    if r.state == 1 and not r.isRangeRoot and not na(r.pointPrice)
                        array.push(e.sTmpA, slot)
                        array.push(e.sTmpF, r.pointPrice)
    array.clear(e.sLotSlot)
    array.clear(e.sLotPrice)
    array.clear(e.sLotTick)
    int m = array.size(e.sTmpA)
    e.scratchOverflow := e.scratchOverflow or m > SCRATCH_MAX_ROOTS
    if m > 0
        array<int> ord = array.sort_indices(e.sTmpF, order.ascending)
        for i = 0 to m - 1
            int slot = array.get(e.sTmpA, array.get(ord, i))
            Root r = array.get(e.roots, slot)
            array.push(e.sLotSlot, slot)
            array.push(e.sLotPrice, r.pointPrice)
            array.push(e.sLotTick, r.priceTick)
        if m > 1
            for i = 1 to m - 1
                int j = i
                bool go = true
                while j > 0 and go
                    Root ra = array.get(e.roots, array.get(e.sLotSlot, j))
                    Root rb = array.get(e.roots, array.get(e.sLotSlot, j - 1))
                    if ra.priceTick == rb.priceTick and ra.rootId < rb.rootId
                        int sTmp = array.get(e.sLotSlot, j)
                        array.set(e.sLotSlot, j, array.get(e.sLotSlot, j - 1))
                        array.set(e.sLotSlot, j - 1, sTmp)
                        float pTmp = array.get(e.sLotPrice, j)
                        array.set(e.sLotPrice, j, array.get(e.sLotPrice, j - 1))
                        array.set(e.sLotPrice, j - 1, pTmp)
                        int tTmp = array.get(e.sLotTick, j)
                        array.set(e.sLotTick, j, array.get(e.sLotTick, j - 1))
                        array.set(e.sLotTick, j - 1, tTmp)
                        j -= 1
                    else
                        go := false
    m

sortedHasInt(array<int> a, int v) =>
    int lo = 0
    int hi = array.size(a) - 1
    bool found = false
    while lo <= hi and not found
        int mid = int((lo + hi) / 2)
        int x = array.get(a, mid)
        if x == v
            found := true
        else if x < v
            lo := mid + 1
        else
            hi := mid - 1
    found

// The logical ID of a psychological price comes from its 50-dollar level, so
// the same price always returns the same ID (spec 7.7) without a lookup table.
psychIdOfLevel(int level) =>
    PSYCH_ID_BASE + level

syncPsych(ZoneEngine e, ZoneCfg cfg, float refClose) =>
    array.clear(e.sTmpB)
    if cfg.catPsych
        int m = array.size(e.sLotSlot)
        if m > 0
            for i = 0 to m - 1
                float p = array.get(e.sLotPrice, i)
                if math.abs(p - refClose) <= cfg.dormantDistance
                    float lo = p - cfg.clusterMaxWidth
                    float hi = p + cfg.clusterMaxWidth
                    int lvl = int(math.ceil(lo / 50.0))
                    while lvl * 50.0 <= hi
                        int sz = array.size(e.sTmpB)
                        if sz == 0 or array.get(e.sTmpB, sz - 1) < lvl
                            array.push(e.sTmpB, lvl)
                        lvl += 1
    int pn = array.size(e.idxPsych)
    if pn > 0
        for i = pn - 1 to 0
            Root r = array.get(e.roots, array.get(e.idxPsych, i))
            if not sortedHasInt(e.sTmpB, r.rootId - PSYCH_ID_BASE)
                unregisterRoot(e, r.rootId)
    int wn = array.size(e.sTmpB)
    if wn > 0
        for i = 0 to wn - 1
            int lvl = array.get(e.sTmpB, i)
            int rid = psychIdOfLevel(lvl)
            if slotOf(e, rid) < 0
                float px = lvl * 50.0
                bool major = lvl % 2 == 0
                Root r = Root.new(rootId = rid, originKey = originKey3(6000, lvl, 0), category = 5,
                     subtype = major ? 6 : 7, tfCode = 5, originTime = 0, originEndTime = 0, confirmedTime = 0,
                     pointPrice = px, priceTick = toTick(px, cfg.mintick), isRangeRoot = false, isDynamic = true,
                     state = 1, fvgFresh = false, lastUpdateSeq = e.seq)
                registerRoot(e, r)

// A root is eligible on a side through its formation direction or a confirmed
// Inverse. Side eligibility and the FVG formation direction are separate:
// reinforcement between two FVGs always requires the same formation direction.
fvgSideEligible(Root r, int side, ZoneCfg cfg) =>
    cfg.catFvg and ((r.direction == 1 and r.state == 1 and side == 1) or
     (r.direction == 2 and r.state == 1 and side == -1) or
     (r.direction == 1 and r.state == 4 and side == -1) or
     (r.direction == 2 and r.state == 4 and side == 1))

fvgProximal(Root r, int side) => side == 1 ? r.nativeTop : r.nativeBottom

buildFvgSet(ZoneEngine e, ZoneCfg cfg, int side) =>
    array.clear(e.sFvgId)
    array.clear(e.sFvgBot)
    array.clear(e.sFvgTop)
    array.clear(e.sFvgProx)
    array.clear(e.sFvgBroad)
    array.clear(e.sFvgTf)
    array.clear(e.sFvgDir)
    array.clear(e.sFvgConf)
    array.clear(e.sFvgUsed)
    array.clear(e.sFvgLocal)
    int n = array.size(e.idxFvg)
    if n > 0 and cfg.catFvg
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxFvg, i))
            if fvgSideEligible(r, side, cfg)
                array.push(e.sFvgId, r.rootId)
                array.push(e.sFvgBot, r.nativeBottom)
                array.push(e.sFvgTop, r.nativeTop)
                array.push(e.sFvgProx, fvgProximal(r, side))
                array.push(e.sFvgBroad, r.isBroadFvg ? 1 : 0)
                array.push(e.sFvgTf, r.tfCode)
                array.push(e.sFvgDir, r.direction)
                array.push(e.sFvgConf, r.confirmedTime)
                array.push(e.sFvgUsed, 0)
                array.push(e.sFvgLocal, 0)
    array.size(e.sFvgId)

// Does the common interval of FVG i with a same-direction, different timeframe
// FVG actually cover this candidate range? Both the Broad localisation
// condition 2 and the non-Broad "different timeframe overlap" quality must be
// spatially tied to that common interval: quality is only evaluated from roots
// that really take part in the EffectiveZoneRange.
fvgOverlapCovers(ZoneEngine e, ZoneCfg cfg, int i, float bot, float top) =>
    int m = array.size(e.sFvgId)
    bool ok = false
    if m > 1
        for q = 0 to m - 1
            if q != i and array.get(e.sFvgDir, q) == array.get(e.sFvgDir, i) and array.get(e.sFvgTf, q) != array.get(e.sFvgTf, i)
                float ob = math.max(array.get(e.sFvgBot, i), array.get(e.sFvgBot, q))
                float ot = math.min(array.get(e.sFvgTop, i), array.get(e.sFvgTop, q))
                if tGe(ot, ob, cfg.mintick) and intersectsT(bot, top, ob, ot, cfg.mintick)
                    ok := true
                    break
    ok

denseTickLimit(ZoneCfg cfg) => int(math.round(cfg.denseWidth / cfg.mintick))
mTickLimit(ZoneCfg cfg)     => int(math.round(cfg.clusterMaxWidth / cfg.mintick))

// Broad FVG localisation: one of the four conditions of spec 3.5 must hold.
// Conditions 3 and 4 say "inside", so they are only evaluated when the
// candidate actually intersects the NativeRange; the Proximal case is
// condition 1 and the real FVG overlap is condition 2.
broadLocalizeOkAt(ZoneEngine e, ZoneCfg cfg, int i, float bot, float top, int den,
     int hMaskPoint, int catMaskPoint, bool inside, bool proximalAnchored) =>
    int nonFvgCats = popCount6(catMaskPoint - (catMaskPoint & 16))
    bool cond1 = proximalAnchored and den == 0
    bool cond2 = fvgOverlapCovers(e, cfg, i, bot, top)
    bool cond3 = inside and (hMaskPoint - (hMaskPoint & 16)) != 0
    bool cond4 = inside and nonFvgCats >= 2 and den == 0
    cond1 or cond2 or cond3 or cond4

// FVG localisation onto a point-root window. Returns the completed range and
// masks; the attached working-set indices are left in e.sAttach.
// preDenseStrong is the Base Strong state of the point window BEFORE any FVG
// joined it, so a candidate that only becomes Strong through the FVG is never
// treated as an established Dense Base Strong core.
fvgAugment(ZoneEngine e, ZoneCfg cfg, int side, float bot, float top, int catMask, int hMask,
     int den, bool preDenseStrong) =>
    array.clear(e.sAttach)
    float nb = bot
    float nt = top
    int cm = catMask
    int hm = hMask
    int m = array.size(e.sFvgId)
    if m > 0
        for i = 0 to m - 1
            if array.get(e.sFvgUsed, i) == 0
                float fb = array.get(e.sFvgBot, i)
                float ft = array.get(e.sFvgTop, i)
                bool broad = array.get(e.sFvgBroad, i) == 1
                bool inside = intersectsT(nb, nt, fb, ft, cfg.mintick)
                bool prox = false
                float tb = nb
                float tt = nt
                if not inside and den == 0
                    float pEdge = array.get(e.sFvgProx, i)
                    bool outside = side == 1 ? tGt(nb, pEdge, cfg.mintick) : tLt(nt, pEdge, cfg.mintick)
                    if outside
                        float cb2 = side == 1 ? pEdge : nb
                        float ct2 = side == 1 ? nt : pEdge
                        int wT = toTick(ct2, cfg.mintick) - toTick(cb2, cfg.mintick)
                        int limitT = preDenseStrong ? denseTickLimit(cfg) : mTickLimit(cfg)
                        if wT <= limitT
                            prox := true
                            tb := cb2
                            tt := ct2
                if inside or prox
                    bool localOk = true
                    bool high = false
                    if broad
                        localOk := broadLocalizeOkAt(e, cfg, i, nb, nt, den, hm, cm, inside, prox)
                        high := localOk
                    else
                        high := array.get(e.sFvgTf, i) >= 240 or fvgOverlapCovers(e, cfg, i, nb, nt)
                    if localOk
                        nb := tb
                        nt := tt
                        cm := cm | 16
                        hm := high ? hm | 16 : hm
                        array.push(e.sAttach, i)
    [nb, nt, cm, hm]

// =============================================================================
// 10. Candidate evaluation per Side (appendix A 10.2)
//     Stage A : dense windows of non-FVG, non-psych roots; psychological
//               prices are synthesised onto the candidate and the FVG
//               localisation is applied, and only then Base Strong and the
//               competition comparator run.
//     Stage B : FVG candidates - local point roots inside an FVG, Proximal
//               localisation, same-direction real overlap, FVG standalone and
//               Broad context, in that order.
//     Stage C : normal candidates from the roots stages A and B did not take.
//     Comparator, in exactly one place:
//       C desc, H desc, effective width asc, formation time asc, min Root ID asc
// =============================================================================

// Synthesise the psychological prices that can take part in this candidate.
// They never start or maintain a candidate and are never window boundaries
// during enumeration: they are only added to an already enumerated window.
// Every distinct participation is produced as its own candidate range, so no
// reachable candidate is lost when clusterMaxWidth is raised and several
// 50 dollar levels fall inside M. A level that lies inside the resulting range
// always takes part, so a range fully determines the participating set.
psychLevelFree(ZoneEngine e, int lvl) =>
    not array.includes(e.sPsyUsed, lvl)

psychVariants(ZoneEngine e, ZoneCfg cfg, float bot, float top, int limitTick) =>
    array.clear(e.sPsyBot)
    array.clear(e.sPsyTop)
    if cfg.catPsych
        array.clear(e.sTmpA)
        int loLvl = int(math.floor((bot - cfg.clusterMaxWidth) / 50.0))
        int hiLvl = int(math.ceil((top + cfg.clusterMaxWidth) / 50.0))
        for lvl = loLvl to hiLvl
            if slotOf(e, psychIdOfLevel(lvl)) >= 0 and psychLevelFree(e, lvl)
                float px = lvl * 50.0
                if tGe(px, bot - cfg.clusterMaxWidth, cfg.mintick) and tLe(px, top + cfg.clusterMaxWidth, cfg.mintick)
                    array.push(e.sTmpA, lvl)
        int n = array.size(e.sTmpA)
        if n > 0
            int belowCnt = 0
            int insideCnt = 0
            for i = 0 to n - 1
                float px = array.get(e.sTmpA, i) * 50.0
                if tLt(px, bot, cfg.mintick)
                    belowCnt += 1
                else if tLe(px, top, cfg.mintick)
                    insideCnt += 1
            int aboveCnt = n - belowCnt - insideCnt
            for dLow = 0 to belowCnt
                for dHigh = 0 to aboveCnt
                    float nb = dLow == 0 ? bot : array.get(e.sTmpA, belowCnt - dLow) * 50.0
                    float nt = dHigh == 0 ? top : array.get(e.sTmpA, belowCnt + insideCnt + dHigh - 1) * 50.0
                    bool joins = dLow > 0 or dHigh > 0 or insideCnt > 0
                    int wT = toTick(nt, cfg.mintick) - toTick(nb, cfg.mintick)
                    if joins and wT <= limitTick
                        array.push(e.sPsyBot, nb)
                        array.push(e.sPsyTop, nt)
    array.size(e.sPsyBot)

// Every live, still unowned psychological price inside the adopted range takes
// part, and is then owned by this Zone for the rest of this Side's stages. A
// psychological Root is an ordinary Root: it is never shared between two Zones
// of the same Side (only a Broad FVG may be shared).
collectPsychRoots(ZoneEngine e, ZoneCfg cfg, float bot, float top) =>
    array.clear(e.sTmpB)
    int loLvl = int(math.floor(bot / 50.0))
    int hiLvl = int(math.ceil(top / 50.0))
    for lvl = loLvl to hiLvl
        int rid = psychIdOfLevel(lvl)
        if slotOf(e, rid) >= 0 and psychLevelFree(e, lvl)
            float px = lvl * 50.0
            if tGe(px, bot, cfg.mintick) and tLe(px, top, cfg.mintick)
                array.push(e.sTmpB, rid)
                array.push(e.sPsyUsed, lvl)
    array.size(e.sTmpB)

// Complete a candidate: MA quality from the final point density, then the FVG
// localisation, then C / H / Density / Base Strong. Attached FVG working-set
// indices are left in e.sAttach.
completeCandidate(ZoneEngine e, ZoneCfg cfg, int side, float bot, float top, int catMask,
     int hMaskNoMa, int maCnt, int maUp, int maDn, int maGapTick, bool useFvg) =>
    int denseTick = denseTickLimit(cfg)
    int wT = toTick(top, cfg.mintick) - toTick(bot, cfg.mintick)
    int denP = wT <= denseTick ? 0 : 1
    int hm0 = hMaskNoMa
    hm0 := maCnt == 2 and denP == 0 and maGapTick <= denseTick and (side == 1 ? maUp == 2 : maDn == 2) ? hm0 | 1 : hm0
    int cP = popCount6(catMask)
    int hP = popCount6(hm0)
    bool preStrong = denP == 0 and ((cP == 2 and hP >= 1) or cP >= 3)
    float aBot = bot
    float aTop = top
    int aCm = catMask
    int aHm = hm0
    array.clear(e.sAttach)
    if useFvg and array.size(e.sFvgId) > 0
        [nb, nt, cm, hm] = fvgAugment(e, cfg, side, bot, top, catMask, hm0, denP, preStrong)
        aBot := nb
        aTop := nt
        aCm := cm
        aHm := hm
    int awT = toTick(aTop, cfg.mintick) - toTick(aBot, cfg.mintick)
    int aden = awT <= denseTick ? 0 : 1
    int cCnt = popCount6(aCm)
    int hCnt = popCount6(aHm)
    bool strong = aden == 0 and ((cCnt == 2 and hCnt >= 1) or cCnt >= 3)
    [aBot, aTop, aCm, aHm, awT, aden, cCnt, hCnt, strong ? 1 : 0]

scanBest(ZoneEngine e, ZoneCfg cfg, int side, int limitTick, bool requireStrong, bool requireFvg, bool useFvg) =>
    int n = array.size(e.sLotSlot)
    int bestI = -1
    int bestJ = -1
    float bestBot = na
    float bestTop = na
    int bestCm = 0
    int bestHm = 0
    int bestMaCnt = 0
    int bestMaUp = 0
    int bestMaDn = 0
    int bestMaGap = 0
    int bestPsych = 0
    int bestC = -1
    int bestH = -1
    int bestW = 0
    int bestT = 0
    int bestId = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(e.sUsed, i) == 0
                array.clear(e.sPairs)
                int catMask = 0
                int maCnt = 0
                int maUp = 0
                int maDn = 0
                int maMinT = 0
                int maMaxT = 0
                bool swHas1h = false
                bool swHasBoth = false
                bool acHas4hD = false
                int acTfMask = 0
                int acFirstPair = 0
                bool acMultiBox = false
                int tmCnt = 0
                bool tmStrongLabel = false
                int formTime = 0
                int minId = 0
                int baseTick = array.get(e.sLotTick, i)
                for j = i to n - 1
                    if array.get(e.sUsed, j) == 1
                        continue
                    int wTick = array.get(e.sLotTick, j) - baseTick
                    if wTick > limitTick
                        break
                    Root r = array.get(e.roots, array.get(e.sLotSlot, j))
                    bool conflict = false
                    int np = array.size(e.sPairs)
                    if r.pairKey != 0 and np > 0
                        for q = 0 to np - 1
                            if array.get(e.sPairs, q) == r.pairKey
                                conflict := true
                                break
                    if conflict
                        break
                    if r.pairKey != 0
                        array.push(e.sPairs, r.pairKey)
                        acMultiBox := acMultiBox or (acFirstPair != 0 and acFirstPair != r.pairKey)
                        acFirstPair := acFirstPair == 0 ? r.pairKey : acFirstPair
                    catMask := catMask | (1 << r.category)
                    int rct = nz(r.confirmedTime)
                    formTime := rct > formTime ? rct : formTime
                    minId := minId == 0 or r.rootId < minId ? r.rootId : minId
                    if r.category == 0
                        maCnt += 1
                        maUp += r.slopeDir > 0 ? 1 : 0
                        maDn += r.slopeDir < 0 ? 1 : 0
                        maMinT := maMinT == 0 or r.priceTick < maMinT ? r.priceTick : maMinT
                        maMaxT := maMaxT == 0 or r.priceTick > maMaxT ? r.priceTick : maMaxT
                    else if r.category == 1
                        swHas1h := swHas1h or r.tfCode >= 60
                        swHasBoth := swHasBoth or ((r.labelMask & 1) != 0 and (r.labelMask & 2) != 0)
                    else if r.category == 2
                        acHas4hD := acHas4hD or r.tfCode >= 240
                        acTfMask := acTfMask | (1 << (r.tfCode == 60 ? 0 : r.tfCode == 240 ? 1 : 2))
                    else if r.category == 3
                        tmCnt += 1
                        tmStrongLabel := tmStrongLabel or (r.labelMask & 56) != 0
                    int hMaskNoMa = 0
                    hMaskNoMa := swHas1h or swHasBoth ? hMaskNoMa | 2 : hMaskNoMa
                    hMaskNoMa := acHas4hD or (acMultiBox and popCount6(acTfMask) >= 2) ? hMaskNoMa | 4 : hMaskNoMa
                    hMaskNoMa := tmStrongLabel or tmCnt >= 2 ? hMaskNoMa | 8 : hMaskNoMa
                    int maGap = maCnt == 2 ? maMaxT - maMinT : 0
                    float wBot = array.get(e.sLotPrice, i)
                    float wTop = array.get(e.sLotPrice, j)
                    int pv = psychVariants(e, cfg, wBot, wTop, limitTick)
                    for vi = 0 to pv
                        float vBot = vi == 0 ? wBot : array.get(e.sPsyBot, vi - 1)
                        float vTop = vi == 0 ? wTop : array.get(e.sPsyTop, vi - 1)
                        int vCm = vi == 0 ? catMask : catMask | 32
                        [aBot, aTop, aCm, aHm, awT, aden, cCnt, hCnt, strongI] =
                             completeCandidate(e, cfg, side, vBot, vTop, vCm, hMaskNoMa, maCnt, maUp, maDn, maGap, useFvg)
                        bool okStrong = not requireStrong or strongI == 1
                        bool okFvg = not requireFvg or (aCm & 16) != 0
                        if okStrong and okFvg
                            int aFt = formTime
                            int aId = minId
                            int an = array.size(e.sAttach)
                            if an > 0
                                for q = 0 to an - 1
                                    int fi = array.get(e.sAttach, q)
                                    int fct = nz(array.get(e.sFvgConf, fi))
                                    aFt := fct > aFt ? fct : aFt
                                    int fid = array.get(e.sFvgId, fi)
                                    aId := fid < aId ? fid : aId
                            bool better = cCnt > bestC
                            better := better or (cCnt == bestC and hCnt > bestH)
                            better := better or (cCnt == bestC and hCnt == bestH and awT < bestW)
                            better := better or (cCnt == bestC and hCnt == bestH and awT == bestW and aFt < bestT)
                            better := better or (cCnt == bestC and hCnt == bestH and awT == bestW and aFt == bestT and aId < bestId)
                            if bestI < 0 or better
                                bestI := i
                                bestJ := j
                                bestBot := vBot
                                bestTop := vTop
                                bestCm := vCm
                                bestHm := hMaskNoMa
                                bestMaCnt := maCnt
                                bestMaUp := maUp
                                bestMaDn := maDn
                                bestMaGap := maGap
                                bestPsych := vi == 0 ? 0 : 1
                                bestC := cCnt
                                bestH := hCnt
                                bestW := awT
                                bestT := aFt
                                bestId := aId
                        e.statWindowEvals += 1
    [bestI, bestJ, bestBot, bestTop, bestCm, bestHm, bestMaCnt, bestMaUp, bestMaDn, bestMaGap, bestPsych]

// Adoption: only now is per candidate data materialised. The completion is
// replayed for the winning window, which is deterministic for the same inputs,
// and the participating roots are consumed here.
adoptWindow(ZoneEngine e, ZoneCfg cfg, int side, int i, int j, float wBot, float wTop,
     int cm, int hmNoMa, int maCnt, int maUp, int maDn, int maGap, int psychJoins, bool useFvg) =>
    [nb, nt, aCm, aHm, awT, aden, c, h, strongI] =
         completeCandidate(e, cfg, side, wBot, wTop, cm, hmNoMa, maCnt, maUp, maDn, maGap, useFvg)
    int start = array.size(e.candRootIds)
    int len = 0
    for k = i to j
        if array.get(e.sUsed, k) == 0
            Root r = array.get(e.roots, array.get(e.sLotSlot, k))
            array.push(e.candRootIds, r.rootId)
            array.set(e.sUsed, k, 1)
            len += 1
    if psychJoins != 0
        int pn = collectPsychRoots(e, cfg, wBot, wTop)
        if pn > 0
            for q = 0 to pn - 1
                array.push(e.candRootIds, array.get(e.sTmpB, q))
                len += 1
    int an = array.size(e.sAttach)
    if an > 0
        for q = 0 to an - 1
            int fi = array.get(e.sAttach, q)
            array.push(e.candRootIds, array.get(e.sFvgId, fi))
            len += 1
            if array.get(e.sFvgBroad, fi) == 1
                array.set(e.sFvgLocal, fi, 1)
            else
                array.set(e.sFvgUsed, fi, 1)
    array.push(e.candSide, side)
    array.push(e.candStart, start)
    array.push(e.candLen, len)
    array.push(e.candBottom, nb)
    array.push(e.candTop, nt)
    array.push(e.candC, c)
    array.push(e.candH, h)
    array.push(e.candDensity, aden)
    array.push(e.candStrong, strongI)
    array.push(e.candCatMask, aCm)
    array.push(e.candHighMask, aHm)
    array.push(e.candRefPrice, na)
    array.push(e.candBroadCtx, 0)
    int fTime = 0
    int mId = 0
    for q = start to start + len - 1
        Root r = rootOf(e, array.get(e.candRootIds, q))
        if not na(r)
            int rct = nz(r.confirmedTime)
            fTime := rct > fTime ? rct : fTime
            mId := mId == 0 or r.rootId < mId ? r.rootId : mId
    array.push(e.candFormTime, fTime)
    array.push(e.candMinId, mId)
    e.statCandidates += 1

// Stage B, steps 3-5: same-direction real overlap, FVG standalone, Broad
// context. A Broad FVG that never localised keeps its whole NativeRange as a
// Broad Neutral context; it is never dropped.
fvgStandalone(ZoneEngine e, ZoneCfg cfg, int side) =>
    int m = array.size(e.sFvgId)
    if m > 0
        for i = 0 to m - 1
            if array.get(e.sFvgUsed, i) == 0 and array.get(e.sFvgLocal, i) == 0
                float bot = array.get(e.sFvgBot, i)
                float top = array.get(e.sFvgTop, i)
                bool ovHigh = false
                array.clear(e.sTmpB)
                array.push(e.sTmpB, array.get(e.sFvgId, i))
                if i + 1 <= m - 1
                    for q = i + 1 to m - 1
                        if array.get(e.sFvgUsed, q) == 0 and array.get(e.sFvgLocal, q) == 0 and array.get(e.sFvgDir, q) == array.get(e.sFvgDir, i)
                            if intersectsT(bot, top, array.get(e.sFvgBot, q), array.get(e.sFvgTop, q), cfg.mintick)
                                bot := math.max(bot, array.get(e.sFvgBot, q))
                                top := math.min(top, array.get(e.sFvgTop, q))
                                ovHigh := ovHigh or array.get(e.sFvgTf, q) != array.get(e.sFvgTf, i)
                                array.push(e.sTmpB, array.get(e.sFvgId, q))
                                array.set(e.sFvgUsed, q, 1)
                array.set(e.sFvgUsed, i, 1)
                bool broadCtx = array.get(e.sFvgBroad, i) == 1 and array.size(e.sTmpB) == 1
                int wTick = toTick(top, cfg.mintick) - toTick(bot, cfg.mintick)
                int den = broadCtx ? 2 : wTick <= denseTickLimit(cfg) ? 0 : 1
                bool high = ovHigh or (array.get(e.sFvgBroad, i) == 0 and array.get(e.sFvgTf, i) >= 240)
                int start = array.size(e.candRootIds)
                int cnt = array.size(e.sTmpB)
                for q = 0 to cnt - 1
                    array.push(e.candRootIds, array.get(e.sTmpB, q))
                array.push(e.candSide, side)
                array.push(e.candStart, start)
                array.push(e.candLen, cnt)
                array.push(e.candBottom, bot)
                array.push(e.candTop, top)
                array.push(e.candC, 1)
                array.push(e.candH, high ? 1 : 0)
                array.push(e.candDensity, den)
                array.push(e.candStrong, 0)
                array.push(e.candCatMask, 16)
                array.push(e.candHighMask, high ? 16 : 0)
                array.push(e.candRefPrice, na)
                array.push(e.candBroadCtx, broadCtx ? 1 : 0)
                int fTime2 = 0
                int mId2 = 0
                for q = start to start + cnt - 1
                    Root r2 = rootOf(e, array.get(e.candRootIds, q))
                    if not na(r2)
                        int rct2 = nz(r2.confirmedTime)
                        fTime2 := rct2 > fTime2 ? rct2 : fTime2
                        mId2 := mId2 == 0 or r2.rootId < mId2 ? r2.rootId : mId2
                array.push(e.candFormTime, fTime2)
                array.push(e.candMinId, mId2)
                e.statCandidates += 1

// 10.1 Reference price - display and tracking only. It is never read by any
//      Phase, Grade, Armed, Dormant, Touch, Break, Merge, Split or generation
//      decision.
medianOfScratch(array<float> a) =>
    int n = array.size(a)
    float out = na
    if n > 0
        array.sort(a, order.ascending)
        out := n % 2 == 1 ? array.get(a, int(n / 2)) : (array.get(a, int(n / 2) - 1) + array.get(a, int(n / 2))) * 0.5
    out

computeRefPrice(ZoneEngine e, ZoneCfg cfg, int k) =>
    int side = array.get(e.candSide, k)
    int st = array.get(e.candStart, k)
    int ln = array.get(e.candLen, k)
    array.clear(e.sRefs)
    int pointCats = 0
    float maA = na
    float maB = na
    for c = 0 to 5
        if c != 0 and c != 4
            array.clear(e.sTmpF)
            for q = st to st + ln - 1
                Root r = rootOf(e, array.get(e.candRootIds, q))
                if not na(r) and r.category == c and not r.isRangeRoot
                    array.push(e.sTmpF, r.pointPrice)
            if array.size(e.sTmpF) > 0
                array.push(e.sRefs, medianOfScratch(e.sTmpF))
                pointCats += 1
    for q = st to st + ln - 1
        Root r = rootOf(e, array.get(e.candRootIds, q))
        if not na(r) and r.category == 0
            maA := na(maA) ? r.pointPrice : maA
            maB := na(maA) or r.pointPrice == maA ? maB : r.pointPrice
    float out = na
    if not na(maA)
        float anchor = array.size(e.sRefs) > 0 ? medianOfScratch(e.sRefs) : na
        float maRep = na(maB) ? maA : na(anchor) ? (maA + maB) * 0.5 :
             math.abs(maA - anchor) <= math.abs(maB - anchor) ? maA : maB
        array.push(e.sRefs, maRep)
        pointCats += 1
    if pointCats > 0
        out := medianOfScratch(e.sRefs)
    else
        out := side == 1 ? array.get(e.candTop, k) : array.get(e.candBottom, k)
    array.set(e.candRefPrice, k, out)

buildCandidates(ZoneEngine e, ZoneCfg cfg) =>
    array.clear(e.candSide)
    array.clear(e.candStart)
    array.clear(e.candLen)
    array.clear(e.candRootIds)
    array.clear(e.candBottom)
    array.clear(e.candTop)
    array.clear(e.candC)
    array.clear(e.candH)
    array.clear(e.candDensity)
    array.clear(e.candStrong)
    array.clear(e.candCatMask)
    array.clear(e.candHighMask)
    array.clear(e.candRefPrice)
    array.clear(e.candBroadCtx)
    array.clear(e.candFormTime)
    array.clear(e.candMinId)
    int n = array.size(e.sLotSlot)
    for si = 0 to 1
        int side = si == 0 ? 1 : -1
        array.clear(e.sUsed)
        array.clear(e.sPsyUsed)
        if n > 0
            for i = 0 to n - 1
                array.push(e.sUsed, 0)
        buildFvgSet(e, cfg, side)
        // --- stage A: dense Base Strong cores ------------------------------
        bool more = true
        while more
            [bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy] =
                 scanBest(e, cfg, side, denseTickLimit(cfg), true, false, true)
            if bi < 0
                more := false
            else
                adoptWindow(e, cfg, side, bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy, true)
                e.statDenseRounds += 1
        // --- stage B steps 1-2: FVG localised onto the remaining point roots
        more := true
        while more
            [bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy] =
                 scanBest(e, cfg, side, mTickLimit(cfg), false, true, true)
            if bi < 0
                more := false
            else
                adoptWindow(e, cfg, side, bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy, true)
        // --- stage B steps 3-5: overlap / standalone / Broad context -------
        fvgStandalone(e, cfg, side)
        // --- stage C: normal candidates from the roots A and B did not take
        more := true
        while more
            [bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy] =
                 scanBest(e, cfg, side, mTickLimit(cfg), false, false, false)
            if bi < 0
                more := false
            else
                adoptWindow(e, cfg, side, bi, bj, bBot, bTop, bCm, bHm, bMaC, bMaU, bMaD, bMaG, bPsy, false)
    int kn = array.size(e.candSide)
    if kn > 0
        for k = 0 to kn - 1
            computeRefPrice(e, cfg, k)
    kn

// =============================================================================
// 11. Core association - fully order independent (spec 12.1 / 12.2 / 12.3)
//     Phase 1  immutable snapshot of every live Core
//     Phase 2  match every Candidate against the snapshot only
//     Phase 3  connected components of the Candidate / Core graph
//     Phase 4  a component containing an ActiveTouch Core is deferred
//     Phase 5  the resolved topology is applied to the live Cores
//     Phase 6  Root ownership is finalised once, then ranges and origins
//     Phase 7  Zone lifetime
//     Nothing in phases 1-4 reads or writes live Core state, so the order in
//     which Candidates happen to sit in the buffer cannot change the result.
// =============================================================================
newSideView() =>
    SideViewState.new(rootIds = array.new<int>(), history = SideHistory.new(),
         touchSnapshot = TouchStartSnapshot.new())

viewOf(ZoneCore c, int side) =>
    side == 1 ? c.supportView : c.resistanceView

coreHasActiveTouch(ZoneCore c) =>
    c.supportView.history.phase == 2 or c.resistanceView.history.phase == 2

pushEvent(ZoneEngine e, int evType, BaseFeed f, ZoneCore c, int side, float bot, float top, int touchNo, int gradeAtStart, int weakReason, int rootId) =>
    array.push(e.events, ZoneEvent.new(eventType = evType, time = f.closeTime, baseSeq = f.seq,
         coreId = na(c) ? 0 : c.coreId, generationId = na(c) ? 0 : c.generationId, side = side,
         rangeBottom = bot, rangeTop = top, touchNo = touchNo, gradeAtStart = gradeAtStart,
         weakReason = weakReason, rootId = rootId))

weakReasonOf(ZoneCfg cfg, SideHistory h, int targetTouchNo) =>
    bool byTouch = not cfg.weakFromTouchOff and targetTouchNo >= cfg.weakFromTouch
    byTouch and h.weakByDepth ? 3 : byTouch ? 1 : h.weakByDepth ? 2 : 0

gradeOf(ZoneCfg cfg, SideViewState sv, int targetTouchNo) =>
    SideHistory h = sv.history
    bool byTouch = not cfg.weakFromTouchOff and targetTouchNo >= cfg.weakFromTouch
    not sv.eligible or not sv.hasNonPsychRoot ? 3 :
     (h.weakByDepth or byTouch) ? 2 :
     (sv.baseStrong and (cfg.strongUnlimited or targetTouchNo <= cfg.strongUntilTouch)) ? 0 : 1

refreshCoreRange(ZoneCore c) =>
    float bot = na
    float top = na
    if not na(c.supportView.effectiveBottom)
        bot := c.supportView.effectiveBottom
        top := c.supportView.effectiveTop
    if not na(c.resistanceView.effectiveBottom)
        bot := na(bot) ? c.resistanceView.effectiveBottom : math.min(bot, c.resistanceView.effectiveBottom)
        top := na(top) ? c.resistanceView.effectiveTop : math.max(top, c.resistanceView.effectiveTop)
    c.physBottom := bot
    c.physTop := top

// Identity origins. A Broad FVG never decides the identity of a local zone, but
// a standalone Broad context is identified by its own FVG origin so the same
// context is tracked instead of being rebuilt every bar.
rebuildOriginIds(ZoneEngine e, ZoneCore c) =>
    array.clear(c.originRootIds)
    for si = 0 to 1
        SideViewState sv = si == 0 ? c.supportView : c.resistanceView
        int n = array.size(sv.rootIds)
        if n > 0
            for i = 0 to n - 1
                int rid = array.get(sv.rootIds, i)
                Root r = rootOf(e, rid)
                bool broad = not na(r) and r.category == 4 and r.isBroadFvg
                if not broad and not array.includes(c.originRootIds, rid)
                    array.push(c.originRootIds, rid)
    c.isBroadContextCore := array.size(c.originRootIds) == 0
    if c.isBroadContextCore
        for si = 0 to 1
            SideViewState sv = si == 0 ? c.supportView : c.resistanceView
            int n = array.size(sv.rootIds)
            if n > 0
                for i = 0 to n - 1
                    int rid = array.get(sv.rootIds, i)
                    if not array.includes(c.originRootIds, rid)
                        array.push(c.originRootIds, rid)

// Live Side Structure is rebuilt every bar. Clearing it never touches the
// persistent side history, snapshots or generation records.
clearLiveSide(SideViewState sv) =>
    array.clear(sv.rootIds)
    sv.effectiveBottom := na
    sv.effectiveTop := na
    sv.referencePrice := na
    sv.cCount := 0
    sv.hCount := 0
    sv.catMask := 0
    sv.highMask := 0
    sv.density := 1
    sv.baseStrong := false
    sv.hasNonPsychRoot := false
    sv.isBroadContext := false
    sv.eligible := false
    sv.fvgDirMask := 0
    sv.fvgRootCount := 0
    sv.fvgFreshCount := 0
    sv.fvgStateMask := 0

// Rebuild the Core origin set from the CURRENT Live Side Structure, then give
// back the waiting Roots this Core still owns (an invalidated FVG takes part in
// no Side but keeps the Core alive as InverseWait | Unavailable).
rebuildCoreOrigins(ZoneEngine e, ZoneCore c) =>
    array.clear(e.sTmpB)
    int on = array.size(c.originRootIds)
    if on > 0
        for q = 0 to on - 1
            int rid = array.get(c.originRootIds, q)
            Root r = rootOf(e, rid)
            bool moved = map.contains(e.ownerOfRoot, rid) and map.get(e.ownerOfRoot, rid) != c.coreId
            if not na(r) and not moved and r.state == 3
                array.push(e.sTmpB, rid)
    rebuildOriginIds(e, c)
    int wn = array.size(e.sTmpB)
    if wn > 0
        for q = 0 to wn - 1
            int rid = array.get(e.sTmpB, q)
            if not array.includes(c.originRootIds, rid)
                array.push(c.originRootIds, rid)
    bool anyNonBroad = false
    int n2 = array.size(c.originRootIds)
    if n2 > 0
        for q = 0 to n2 - 1
            Root r = rootOf(e, array.get(c.originRootIds, q))
            if not na(r) and not (r.category == 4 and r.isBroadFvg)
                anyNonBroad := true
                break
    c.isBroadContextCore := not anyNonBroad

applyCandidate(ZoneEngine e, ZoneCfg cfg, ZoneCore c, int k, BaseFeed f) =>
    int side = array.get(e.candSide, k)
    SideViewState sv = viewOf(c, side)
    int st = array.get(e.candStart, k)
    int ln = array.get(e.candLen, k)
    array.clear(sv.rootIds)
    bool nonPsych = false
    int fvgDirMask = 0
    int fvgCount = 0
    int fvgFresh = 0
    int fvgStateMask = 0
    for q = st to st + ln - 1
        int rid = array.get(e.candRootIds, q)
        array.push(sv.rootIds, rid)
        Root r = rootOf(e, rid)
        if not na(r)
            nonPsych := nonPsych or r.category != 5
            if r.category == 4
                fvgCount += 1
                fvgDirMask := fvgDirMask | (1 << r.direction)
                fvgFresh += r.fvgFresh ? 1 : 0
                fvgStateMask := fvgStateMask | (1 << r.state)
    sv.effectiveBottom := array.get(e.candBottom, k)
    sv.effectiveTop := array.get(e.candTop, k)
    sv.referencePrice := array.get(e.candRefPrice, k)
    sv.cCount := array.get(e.candC, k)
    sv.hCount := array.get(e.candH, k)
    sv.catMask := array.get(e.candCatMask, k)
    sv.highMask := array.get(e.candHighMask, k)
    sv.density := array.get(e.candDensity, k)
    sv.baseStrong := array.get(e.candStrong, k) == 1
    sv.hasNonPsychRoot := nonPsych
    sv.isBroadContext := sv.density == 2
    sv.fvgDirMask := fvgDirMask
    sv.fvgRootCount := fvgCount
    sv.fvgFreshCount := fvgFresh
    sv.fvgStateMask := fvgStateMask
    sv.eligible := nonPsych and not c.breakSnap.valid
    c.lastSeenTime := f.openTime

// ---------------------------------------------------------------------------
// 11.1 Touch Episodes
// ---------------------------------------------------------------------------
// Stable Episode identity across Cores: two Cores that recorded the same real
// event carry the same Side, start time and sequence, touch number, generation
// and TouchStartSnapshot range. Two different Episodes on the same 5m bar are
// never merged just because the bar is the same.
sameEpisodeKey(ZoneCfg cfg, TouchEpisode a, TouchEpisode b) =>
    a.side == b.side and a.startTime == b.startTime and a.startSeq == b.startSeq and
     a.touchNo == b.touchNo and a.generationId == b.generationId and
     a.isNormalTouch == b.isNormalTouch and
     toTick(a.snapBottom, cfg.mintick) == toTick(b.snapBottom, cfg.mintick) and
     toTick(a.snapTop, cfg.mintick) == toTick(b.snapTop, cfg.mintick)

newEpisode(ZoneEngine e, int side, int seq, int t, int genId, int touchNo,
     float snapBot, float snapTop, float closeAtTouch, bool isNormal) =>
    TouchEpisode ep = TouchEpisode.new(episodeId = e.nextEpisodeId, side = side, startSeq = seq,
         startTime = t, generationId = genId, touchNo = touchNo, snapBottom = snapBot,
         snapTop = snapTop, closeAtTouch = closeAtTouch, deepestClose = na, maxDepthPct = 0.0,
         weakByDepth = false, isNormalTouch = isNormal, spans = array.new<ContactSpan>())
    e.nextEpisodeId += 1
    ep

// One span per confirmed bar; the same bar and the same range is not stored twice.
addContactSpan(ZoneCfg cfg, TouchEpisode ep, int seq, int t, float bottom, float top) =>
    int n = array.size(ep.spans)
    bool dup = false
    if n > 0
        for i = 0 to n - 1
            ContactSpan cs = array.get(ep.spans, i)
            if cs.baseSeq == seq and toTick(cs.bottom, cfg.mintick) == toTick(bottom, cfg.mintick) and
                 toTick(cs.top, cfg.mintick) == toTick(top, cfg.mintick)
                dup := true
                break
    if not dup
        array.push(ep.spans, ContactSpan.new(baseSeq = seq, time = t, bottom = bottom, top = top))

// Membership is decided by the real contacts, never by an envelope.
episodeTouchesRange(ZoneCfg cfg, TouchEpisode ep, float bot, float top) =>
    int n = array.size(ep.spans)
    bool hit = false
    if n > 0
        for i = 0 to n - 1
            ContactSpan cs = array.get(ep.spans, i)
            if intersectsT(cs.bottom, cs.top, bot, top, cfg.mintick)
                hit := true
                break
    hit

episodeIsDuplicate(ZoneCfg cfg, array<TouchEpisode> dst, TouchEpisode ep) =>
    int n = array.size(dst)
    bool dup = false
    if n > 0
        for i = 0 to n - 1
            TouchEpisode o = array.get(dst, i)
            if o.episodeId == ep.episodeId or sameEpisodeKey(cfg, o, ep)
                dup := true
                break
    dup

// maxTouchMarksPerCore is the Episode history limit. Whole Episodes are dropped,
// never single ContactSpans, so an incomplete Episode is never produced.
trimEpisodes(ZoneEngine e, ZoneCfg cfg, ZoneCore c) =>
    while array.size(c.episodes) > cfg.maxTouchMarksPerCore
        array.shift(c.episodes)
        c.marksTruncated := true
        e.touchHistoryTruncated := true

// Rebuild one Side's consumption history from the Episodes that really touch
// the current range. A truncated history can never lower the count, clear Weak
// or revive Fresh.
rebuildSideHistory(ZoneEngine e, ZoneCfg cfg, ZoneCore c, int side) =>
    SideViewState sv = viewOf(c, side)
    SideHistory h = sv.history
    float rb = na(sv.effectiveBottom) ? c.physBottom : sv.effectiveBottom
    float rt = na(sv.effectiveBottom) ? c.physTop : sv.effectiveTop
    if not na(rb)
        int cnt = 0
        bool wDepth = false
        float mDepth = 0.0
        int n = array.size(c.episodes)
        if n > 0
            for i = 0 to n - 1
                TouchEpisode ep = array.get(c.episodes, i)
                if ep.side == side and ep.isNormalTouch and episodeTouchesRange(cfg, ep, rb, rt)
                    bool seen = false
                    if i > 0
                        for q = 0 to i - 1
                            TouchEpisode o = array.get(c.episodes, q)
                            if o.side == side and o.isNormalTouch and episodeTouchesRange(cfg, o, rb, rt) and sameEpisodeKey(cfg, o, ep)
                                seen := true
                                break
                    if not seen
                        cnt += 1
                    wDepth := wDepth or ep.weakByDepth
                    mDepth := math.max(mDepth, ep.maxDepthPct)
        if c.marksTruncated
            cnt := cnt < h.sideTouchCount ? h.sideTouchCount : cnt
            wDepth := wDepth or h.weakByDepth
            mDepth := math.max(mDepth, h.maxDepthPct)
        h.sideTouchCount := cnt
        h.upcomingTouchNo := cnt + 1
        h.sideFresh := cnt == 0
        h.weakByDepth := wDepth
        h.maxDepthPct := mDepth
        h.weakByTouch := not cfg.weakFromTouchOff and (cnt + 1) >= cfg.weakFromTouch

rebuildCoreHistory(ZoneEngine e, ZoneCfg cfg, ZoneCore c) =>
    rebuildSideHistory(e, cfg, c, 1)
    rebuildSideHistory(e, cfg, c, -1)
    int n = array.size(c.episodes)
    int normals = 0
    if n > 0
        for i = 0 to n - 1
            normals += array.get(c.episodes, i).isNormalTouch ? 1 : 0
    if not c.marksTruncated
        c.zoneFresh := normals == 0

// Episodes that never touched the current physical Core range are dropped after
// a Merge or a Split, for one sided Cores as well. The Episode of a running
// ActiveTouch is never removed.
pruneEpisodesToRange(ZoneEngine e, ZoneCfg cfg, ZoneCore c) =>
    if not na(c.physBottom)
        int n = array.size(c.episodes)
        if n > 0
            for i = n - 1 to 0
                TouchEpisode ep = array.get(c.episodes, i)
                bool isActive = (not na(c.supportView.activeEpisode) and c.supportView.activeEpisode == ep) or
                     (not na(c.resistanceView.activeEpisode) and c.resistanceView.activeEpisode == ep)
                if not isActive and not episodeTouchesRange(cfg, ep, c.physBottom, c.physTop)
                    array.remove(c.episodes, i)

// ---------------------------------------------------------------------------
// 11.2 Phase 1: immutable snapshot of the live Cores
// ---------------------------------------------------------------------------
snapshotCores(ZoneEngine e) =>
    array.clear(e.snapCoreIdx)
    array.clear(e.snapOriginStart)
    array.clear(e.snapOriginLen)
    array.clear(e.snapOrigins)
    array.clear(e.snapBot)
    array.clear(e.snapTop)
    array.clear(e.snapBroadCtx)
    array.clear(e.snapActive)
    int n = array.size(e.cores)
    if n > 0
        for i = 0 to n - 1
            ZoneCore c = array.get(e.cores, i)
            if c.alive
                int start = array.size(e.snapOrigins)
                int on = array.size(c.originRootIds)
                if on > 0
                    for q = 0 to on - 1
                        array.push(e.snapOrigins, array.get(c.originRootIds, q))
                array.push(e.snapCoreIdx, i)
                array.push(e.snapOriginStart, start)
                array.push(e.snapOriginLen, array.size(e.snapOrigins) - start)
                array.push(e.snapBot, c.physBottom)
                array.push(e.snapTop, c.physTop)
                array.push(e.snapBroadCtx, c.isBroadContextCore ? 1 : 0)
                array.push(e.snapActive, coreHasActiveTouch(c) ? 1 : 0)
    array.size(e.snapCoreIdx)

candIsBroadContext(ZoneEngine e, int k) =>
    array.get(e.candBroadCtx, k) == 1

// Roots of candidate k that can decide identity: every non-Broad Root, or the
// Broad FVG origins when the candidate is a standalone Broad context.
candIdentityHasRoot(ZoneEngine e, int k, int rid, bool broadCtx) =>
    int st = array.get(e.candStart, k)
    int ln = array.get(e.candLen, k)
    bool found = false
    for q = st to st + ln - 1
        if array.get(e.candRootIds, q) == rid
            Root r = rootOf(e, rid)
            bool broad = not na(r) and r.category == 4 and r.isBroadFvg
            if broadCtx == broad
                found := true
                break
    found

// Phase 2: match against the snapshot only.
candMatchesSnap(ZoneEngine e, ZoneCfg cfg, int k, int si) =>
    bool broadCtx = candIsBroadContext(e, k)
    bool ok = false
    if broadCtx == (array.get(e.snapBroadCtx, si) == 1)
        float sb = array.get(e.snapBot, si)
        float stp = array.get(e.snapTop, si)
        if not na(sb) and tLe(intervalGap(sb, stp, array.get(e.candBottom, k), array.get(e.candTop, k)), cfg.clusterMaxWidth, cfg.mintick)
            int os = array.get(e.snapOriginStart, si)
            int ol = array.get(e.snapOriginLen, si)
            if ol > 0
                for q = os to os + ol - 1
                    if candIdentityHasRoot(e, k, array.get(e.snapOrigins, q), broadCtx)
                        ok := true
                        break
    ok

// Two candidates belong to the same physical Core when they share a non-Broad
// origin Root and stay within M of each other (spec 10.7).
candSharesWithCand(ZoneEngine e, ZoneCfg cfg, int k1, int k2) =>
    bool ok = false
    if tLe(intervalGap(array.get(e.candBottom, k1), array.get(e.candTop, k1),
         array.get(e.candBottom, k2), array.get(e.candTop, k2)), cfg.clusterMaxWidth, cfg.mintick)
        int st = array.get(e.candStart, k1)
        int ln = array.get(e.candLen, k1)
        for q = st to st + ln - 1
            int rid = array.get(e.candRootIds, q)
            Root r = rootOf(e, rid)
            bool broad = not na(r) and r.category == 4 and r.isBroadFvg
            if not broad and candIdentityHasRoot(e, k2, rid, false)
                ok := true
                break
    ok

// ---------------------------------------------------------------------------
// 11.3 Phase 3: connected components. Node ids are [0, kn) for candidates and
//      [kn, kn + sn) for Core snapshots.
// ---------------------------------------------------------------------------
ufFind(ZoneEngine e, int x) =>
    int r = x
    while array.get(e.ufParent, r) != r
        r := array.get(e.ufParent, r)
    int cur = x
    while array.get(e.ufParent, cur) != cur
        int nxt = array.get(e.ufParent, cur)
        array.set(e.ufParent, cur, r)
        cur := nxt
    r

ufUnion(ZoneEngine e, int a, int b) =>
    int ra = ufFind(e, a)
    int rb = ufFind(e, b)
    if ra != rb
        if ra < rb
            array.set(e.ufParent, rb, ra)
        else
            array.set(e.ufParent, ra, rb)

// Canonical competition order of two candidates (spec 10.4), with the buffer
// index only as the very last, never reachable, tie break.
candBetter(ZoneEngine e, ZoneCfg cfg, int k1, int k2) =>
    int c1 = array.get(e.candC, k1)
    int c2 = array.get(e.candC, k2)
    int h1 = array.get(e.candH, k1)
    int h2 = array.get(e.candH, k2)
    int w1 = toTick(array.get(e.candTop, k1), cfg.mintick) - toTick(array.get(e.candBottom, k1), cfg.mintick)
    int w2 = toTick(array.get(e.candTop, k2), cfg.mintick) - toTick(array.get(e.candBottom, k2), cfg.mintick)
    int t1 = array.get(e.candFormTime, k1)
    int t2 = array.get(e.candFormTime, k2)
    int i1 = array.get(e.candMinId, k1)
    int i2 = array.get(e.candMinId, k2)
    c1 != c2 ? c1 > c2 : h1 != h2 ? h1 > h2 : w1 != w2 ? w1 < w2 :
     t1 != t2 ? t1 < t2 : i1 != i2 ? i1 < i2 : k1 < k2

// ---------------------------------------------------------------------------
// 11.4 Phase 5 helpers: Merge and Split on the resolved topology
// ---------------------------------------------------------------------------
sortEpisodesByStart(ZoneCore c) =>
    int n = array.size(c.episodes)
    if n > 1
        for i = 1 to n - 1
            int j = i
            bool go = true
            while j > 0 and go
                TouchEpisode a = array.get(c.episodes, j)
                TouchEpisode b = array.get(c.episodes, j - 1)
                bool swap = a.startSeq < b.startSeq or (a.startSeq == b.startSeq and a.episodeId < b.episodeId)
                if swap
                    array.set(c.episodes, j, b)
                    array.set(c.episodes, j - 1, a)
                    j -= 1
                else
                    go := false

// All Episodes of the merged Cores are collected once, deduplicated on the
// stable Episode key, and only then does the side history get rebuilt.
mergeCoreInto(ZoneEngine e, ZoneCfg cfg, ZoneCore dst, ZoneCore src, BaseFeed f) =>
    int n = array.size(src.episodes)
    if n > 0
        for i = 0 to n - 1
            TouchEpisode ep = array.get(src.episodes, i)
            if not episodeIsDuplicate(cfg, dst.episodes, ep)
                array.push(dst.episodes, ep)
    sortEpisodesByStart(dst)
    trimEpisodes(e, cfg, dst)
    for si = 0 to 1
        int side = si == 0 ? 1 : -1
        SideHistory a = viewOf(dst, side).history
        SideHistory b = viewOf(src, side).history
        a.flipAttemptCount := a.flipAttemptCount + b.flipAttemptCount
        a.inverseAttemptCount := a.inverseAttemptCount + b.inverseAttemptCount
        a.everUsed := a.everUsed or b.everUsed
        // only the truncated floor is carried; the real values come from the
        // Episodes in rebuildSideHistory()
        a.sideTouchCount := b.sideTouchCount > a.sideTouchCount ? b.sideTouchCount : a.sideTouchCount
        a.weakByDepth := a.weakByDepth or b.weakByDepth
        a.maxDepthPct := math.max(a.maxDepthPct, b.maxDepthPct)
    dst.zoneFresh := dst.zoneFresh and src.zoneFresh
    dst.marksTruncated := dst.marksTruncated or src.marksTruncated
    if not dst.breakSnap.valid and src.breakSnap.valid
        dst.breakSnap := src.breakSnap
    src.alive := false
    e.statMerges += 1
    pushEvent(e, 12, f, dst, 0, dst.physBottom, dst.physTop, 0, 1, 0, src.coreId)

newCoreFrom(ZoneEngine e, BaseFeed f, ZoneCore parent) =>
    ZoneCore c = ZoneCore.new(coreId = e.nextCoreId,
         generationId = na(parent) ? e.nextGenId : parent.generationId,
         originRootIds = array.new<int>(), supportView = newSideView(), resistanceView = newSideView(),
         episodes = array.new<TouchEpisode>(), breakSnap = BreakSnapshot.new(),
         createdTime = f.openTime, lastSeenTime = f.openTime,
         zoneFresh = na(parent) ? true : parent.zoneFresh,
         genBaselineCatMask = na(parent) ? 0 : parent.genBaselineCatMask,
         marksTruncated = na(parent) ? false : parent.marksTruncated)
    e.nextCoreId += 1
    if na(parent)
        e.nextGenId += 1
    else
        for si = 0 to 1
            int side = si == 0 ? 1 : -1
            SideHistory ph = viewOf(parent, side).history
            SideHistory h = viewOf(c, side).history
            h.weakByTouch := ph.weakByTouch
            h.weakByDepth := ph.weakByDepth
            h.maxDepthPct := ph.maxDepthPct
            h.sideTouchCount := ph.sideTouchCount
            h.everUsed := ph.everUsed
    array.push(e.cores, c)
    c

// Split children are all built from the same pre-split Episode snapshot, so
// giving history to one child can never keep it from another.
assignEpisodesFromSnapshot(ZoneEngine e, ZoneCfg cfg, ZoneCore c) =>
    array.clear(c.episodes)
    int n = array.size(e.episodeSnap)
    if n > 0 and not na(c.physBottom)
        for i = 0 to n - 1
            TouchEpisode ep = array.get(e.episodeSnap, i)
            if episodeTouchesRange(cfg, ep, c.physBottom, c.physTop)
                array.push(c.episodes, ep)
    trimEpisodes(e, cfg, c)

// ---------------------------------------------------------------------------
// 11.5 The association pass
// ---------------------------------------------------------------------------
associateCandidates(ZoneEngine e, ZoneCfg cfg, BaseFeed f) =>
    int kn = array.size(e.candSide)
    int sn = snapshotCores(e)
    int total = kn + sn
    int cn0 = array.size(e.cores)
    if cn0 > 0
        for i = 0 to cn0 - 1
            ZoneCore c = array.get(e.cores, i)
            c.supportView.history.everUsed := c.supportView.history.everUsed or not na(c.supportView.effectiveBottom)
            c.resistanceView.history.everUsed := c.resistanceView.history.everUsed or not na(c.resistanceView.effectiveBottom)
    // --- Phase 2 / 3: match against the snapshot, then components ----------
    array.clear(e.ufParent)
    if total > 0
        for i = 0 to total - 1
            array.push(e.ufParent, i)
    if kn > 0 and sn > 0
        for k = 0 to kn - 1
            for si = 0 to sn - 1
                if candMatchesSnap(e, cfg, k, si)
                    e.statCoreMatches += 1
                    ufUnion(e, k, kn + si)
    if kn > 1
        for k1 = 0 to kn - 2
            for k2 = k1 + 1 to kn - 1
                if candSharesWithCand(e, cfg, k1, k2)
                    ufUnion(e, k1, k2)
    // component representatives in a canonical order: lowest old Core ID first,
    // then, for components without an old Core, the best Candidate
    array.clear(e.compRep)
    array.clear(e.compMinCore)
    if total > 0
        for i = 0 to total - 1
            int r = ufFind(e, i)
            if not array.includes(e.compRep, r)
                array.push(e.compRep, r)
                array.push(e.compMinCore, 2147483647)
    int rn = array.size(e.compRep)
    if rn > 0 and sn > 0
        for si = 0 to sn - 1
            int r = ufFind(e, kn + si)
            int at = array.indexof(e.compRep, r)
            ZoneCore c = array.get(e.cores, array.get(e.snapCoreIdx, si))
            if at >= 0 and c.coreId < array.get(e.compMinCore, at)
                array.set(e.compMinCore, at, c.coreId)
    if rn > 1
        for i = 1 to rn - 1
            int j = i
            bool go = true
            while j > 0 and go
                int ra = array.get(e.compRep, j)
                int rb = array.get(e.compRep, j - 1)
                int ma = array.get(e.compMinCore, j)
                int mb = array.get(e.compMinCore, j - 1)
                bool swap = ma < mb
                if ma == mb and ma == 2147483647
                    int ba = -1
                    int bb = -1
                    if kn > 0
                        for k = 0 to kn - 1
                            int rr = ufFind(e, k)
                            if rr == ra and (ba < 0 or candBetter(e, cfg, k, ba))
                                ba := k
                            if rr == rb and (bb < 0 or candBetter(e, cfg, k, bb))
                                bb := k
                    swap := ba >= 0 and bb >= 0 and candBetter(e, cfg, ba, bb)
                if swap
                    array.set(e.compRep, j, rb)
                    array.set(e.compRep, j - 1, ra)
                    array.set(e.compMinCore, j, mb)
                    array.set(e.compMinCore, j - 1, ma)
                    j -= 1
                else
                    go := false
    e.statComponents += rn
    // --- Phase 4 / 5: resolve each component -------------------------------
    if rn > 0
        for ri = 0 to rn - 1
            int rep = array.get(e.compRep, ri)
            // snapshots of this component, ordered by Core ID
            array.clear(e.compSnapBuf)
            bool anyActive = false
            if sn > 0
                for si = 0 to sn - 1
                    if ufFind(e, kn + si) == rep
                        array.push(e.compSnapBuf, si)
                        anyActive := anyActive or array.get(e.snapActive, si) == 1
            int cs = array.size(e.compSnapBuf)
            if cs > 1
                for i = 1 to cs - 1
                    int j = i
                    bool go = true
                    while j > 0 and go
                        ZoneCore ca = array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, j)))
                        ZoneCore cb = array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, j - 1)))
                        if ca.coreId < cb.coreId
                            int tmp = array.get(e.compSnapBuf, j)
                            array.set(e.compSnapBuf, j, array.get(e.compSnapBuf, j - 1))
                            array.set(e.compSnapBuf, j - 1, tmp)
                            j -= 1
                        else
                            go := false
            // candidates of this component, in canonical competition order
            array.clear(e.orderBuf)
            if kn > 0
                for k = 0 to kn - 1
                    if ufFind(e, k) == rep
                        array.push(e.orderBuf, k)
            int ck = array.size(e.orderBuf)
            if ck > 1
                for i = 1 to ck - 1
                    int j = i
                    bool go = true
                    while j > 0 and go
                        int ka = array.get(e.orderBuf, j)
                        int kb = array.get(e.orderBuf, j - 1)
                        if candBetter(e, cfg, ka, kb)
                            array.set(e.orderBuf, j, kb)
                            array.set(e.orderBuf, j - 1, ka)
                            j -= 1
                        else
                            go := false
            if anyActive
                // Phase 4: nothing in this component is merged, split, reshaped
                // or re-owned while an Episode is running.
                if cs > 0
                    for q = 0 to cs - 1
                        ZoneCore c = array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, q)))
                        c.pendingTopology := true
                        c.lastMatchSeq := f.seq
                e.statDeferred += 1
            else
                ZoneCore primary = na
                bool merged = false
                if cs > 0
                    primary := array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, 0)))
                    if cs > 1
                        for q = 1 to cs - 1
                            ZoneCore other = array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, q)))
                            mergeCoreInto(e, cfg, primary, other, f)
                            merged := true
                // Episode snapshot taken once, before any child is created
                array.clear(e.episodeSnap)
                if not na(primary)
                    int pn = array.size(primary.episodes)
                    if pn > 0
                        for q = 0 to pn - 1
                            array.push(e.episodeSnap, array.get(primary.episodes, q))
                // slot assignment: one slot is one physical Core
                array.clear(e.slotCoreIdx)
                array.clear(e.slotSupCand)
                array.clear(e.slotResCand)
                if ck > 0
                    for q = 0 to ck - 1
                        int k = array.get(e.orderBuf, q)
                        int side = array.get(e.candSide, k)
                        int placed = -1
                        int slots = array.size(e.slotSupCand)
                        if slots > 0
                            for sl = 0 to slots - 1
                                int mine = side == 1 ? array.get(e.slotSupCand, sl) : array.get(e.slotResCand, sl)
                                int other = side == 1 ? array.get(e.slotResCand, sl) : array.get(e.slotSupCand, sl)
                                if placed < 0 and mine < 0 and (other < 0 or candSharesWithCand(e, cfg, k, other))
                                    placed := sl
                        if placed < 0
                            array.push(e.slotSupCand, -1)
                            array.push(e.slotResCand, -1)
                            array.push(e.slotCoreIdx, -1)
                            placed := array.size(e.slotSupCand) - 1
                        if side == 1
                            array.set(e.slotSupCand, placed, k)
                        else
                            array.set(e.slotResCand, placed, k)
                int slotN = array.size(e.slotSupCand)
                bool splitHappened = slotN > 1 and not na(primary)
                if slotN > 0
                    for sl = 0 to slotN - 1
                        ZoneCore target = na
                        bool isChild = false
                        if sl == 0 and not na(primary)
                            target := primary
                        else
                            target := newCoreFrom(e, f, primary)
                            isChild := not na(primary)
                        int kSup = array.get(e.slotSupCand, sl)
                        int kRes = array.get(e.slotResCand, sl)
                        if kSup >= 0
                            applyCandidate(e, cfg, target, kSup, f)
                            target.appliedSupSeq := f.seq
                            if target.genBaselineCatMask == 0
                                target.genBaselineCatMask := array.get(e.candCatMask, kSup)
                        if kRes >= 0
                            applyCandidate(e, cfg, target, kRes, f)
                            target.appliedResSeq := f.seq
                            if target.genBaselineCatMask == 0
                                target.genBaselineCatMask := array.get(e.candCatMask, kRes)
                        target.lastMatchSeq := f.seq
                        refreshCoreRange(target)
                        if isChild
                            e.statSplits += 1
                            pushEvent(e, 13, f, target, 0, target.physBottom, target.physTop, 0, 1, 0, primary.coreId)
                        if merged or splitHappened
                            if sl == 0 and not na(primary)
                                pruneEpisodesToRange(e, cfg, target)
                            else if not na(primary)
                                assignEpisodesFromSnapshot(e, cfg, target)
                            rebuildCoreHistory(e, cfg, target)
                else if cs > 0
                    // no candidate in this component: the old Cores keep their
                    // state and the lifetime check below decides
                    for q = 0 to cs - 1
                        array.get(e.cores, array.get(e.snapCoreIdx, array.get(e.compSnapBuf, q))).lastMatchSeq := f.seq
    // --- Phase 6: single ownership pass, then ranges and origins -----------
    int cnA = array.size(e.cores)
    if cnA > 0
        for i = cnA - 1 to 0
            if not array.get(e.cores, i).alive
                array.remove(e.cores, i)
    map.clear(e.ownerOfRoot)
    array.clear(e.sTmpA)
    int cnB = array.size(e.cores)
    // A PendingTopology Core is frozen: its Roots are registered first and can
    // never be moved to another Core, and nothing below reshapes it.
    if cnB > 0
        for i = 0 to cnB - 1
            ZoneCore c = array.get(e.cores, i)
            if c.pendingTopology
                for si = 0 to 1
                    SideViewState sv = si == 0 ? c.supportView : c.resistanceView
                    int rn1 = array.size(sv.rootIds)
                    if rn1 > 0
                        for q = 0 to rn1 - 1
                            int rid = array.get(sv.rootIds, q)
                            Root r = rootOf(e, rid)
                            bool broad = not na(r) and r.category == 4 and r.isBroadFvg
                            if not broad and not map.contains(e.ownerOfRoot, rid)
                                map.put(e.ownerOfRoot, rid, c.coreId)
                                array.push(e.sTmpA, rid)
    if cnB > 0
        for i = 0 to cnB - 1
            ZoneCore c = array.get(e.cores, i)
            if not c.pendingTopology
                for si = 0 to 1
                    SideViewState sv = si == 0 ? c.supportView : c.resistanceView
                    int rn2 = array.size(sv.rootIds)
                    if rn2 > 0
                        for q = rn2 - 1 to 0
                            int rid = array.get(sv.rootIds, q)
                            Root r = rootOf(e, rid)
                            bool broad = not na(r) and r.category == 4 and r.isBroadFvg
                            if not broad
                                if map.contains(e.ownerOfRoot, rid) and map.get(e.ownerOfRoot, rid) != c.coreId
                                    array.remove(sv.rootIds, q)
                                    if array.includes(e.sTmpA, rid)
                                        e.statPendingHold += 1
                                    else
                                        e.statOwnerConflict += 1
                                else
                                    map.put(e.ownerOfRoot, rid, c.coreId)
    if cnB > 0
        for i = cnB - 1 to 0
            ZoneCore c = array.get(e.cores, i)
            if not c.pendingTopology
                for si = 0 to 1
                    int side = si == 0 ? 1 : -1
                    SideViewState sv = viewOf(c, side)
                    bool applied = (side == 1 ? c.appliedSupSeq : c.appliedResSeq) == f.seq
                    if not applied and sv.history.phase != 2
                        clearLiveSide(sv)
                refreshCoreRange(c)
                rebuildCoreOrigins(e, c)
            // --- Phase 7: Zone lifetime (spec 14) --------------------------
            bool waitingState = coreHasActiveTouch(c) or c.breakSnap.valid or c.pendingTopology or
                 c.pendingGeneration or c.supportView.history.phase == 3 or c.supportView.history.phase == 4 or
                 c.resistanceView.history.phase == 3 or c.resistanceView.history.phase == 4
            bool hasEffective = false
            bool hasWaitingRoot = false
            int on2 = array.size(c.originRootIds)
            if on2 > 0
                for q = 0 to on2 - 1
                    Root r = rootOf(e, array.get(c.originRootIds, q))
                    if not na(r) and r.category != 5
                        hasEffective := hasEffective or r.state == 1 or r.state == 4
                        hasWaitingRoot := hasWaitingRoot or r.state == 3
            if not hasEffective and not hasWaitingRoot and not waitingState
                array.push(e.endedGenCores, c.coreId)
                array.push(e.endedGenIds, c.generationId)
                array.remove(e.cores, i)
// =============================================================================
// 12. State transitions
//     Detection runs against the structure that was final at the previous
//     confirmed bar: last armed range, TouchStartSnapshot, BreakSnapshot.
//     Every boundary comparison is normalised to the minimum tick first.
// =============================================================================
sideHasLiveNonPsych(ZoneEngine e, ZoneCfg cfg, SideViewState sv, int side) =>
    int n = array.size(sv.rootIds)
    bool ok = false
    if n > 0
        for i = 0 to n - 1
            Root r = rootOf(e, array.get(sv.rootIds, i))
            if not na(r) and r.category != 5 and catEnabled(cfg, r.category)
                bool live = r.category == 4 ? (fvgSideEligible(r, side, cfg) and not r.pendingInvalidate) : r.state == 1
                if live
                    ok := true
                    break
    ok

startGeneration(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, int catMaskNow) =>
    array.push(e.endedGenCores, c.coreId)
    array.push(e.endedGenIds, c.generationId)
    while array.size(e.endedGenCores) > cfg.maxEndedGenerations
        array.shift(e.endedGenCores)
        array.shift(e.endedGenIds)
    c.generationId := e.nextGenId
    e.nextGenId += 1
    for si = 0 to 1
        SideViewState sv = si == 0 ? c.supportView : c.resistanceView
        SideHistory h = sv.history
        h.sideTouchCount := 0
        h.weakByTouch := false
        h.weakByDepth := false
        h.maxDepthPct := 0.0
        h.sideFresh := true
        h.currentTouchNo := 0
        h.upcomingTouchNo := 1
        h.flipAttemptCount := 0
        h.inverseAttemptCount := 0
        h.phase := h.phase == 1 ? 1 : 0
        sv.touchSnapshot.valid := false
        sv.activeEpisode := na
    c.zoneFresh := true
    c.breakSnap := BreakSnapshot.new()
    array.clear(c.episodes)
    c.genCandidateReady := false
    c.genCandidateMovedAway := false
    c.genCandidateSide := 0
    c.pendingGeneration := false
    c.genBaselineCatMask := catMaskNow
    pushEvent(e, 11, f, c, 0, c.physBottom, c.physTop, 0, 1, 0, 0)

applyBreak(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, int side, float bot, float top, bool gap, int touchNo) =>
    SideViewState ov = viewOf(c, side)
    BreakSnapshot bs = c.breakSnap
    bs.valid := true
    bs.coreId := c.coreId
    bs.generationId := c.generationId
    bs.oldSide := side
    bs.rangeBottom := bot
    bs.rangeTop := top
    bs.rootIds := array.copy(ov.rootIds)
    bs.breakSeq := f.seq
    bs.breakTime := f.closeTime
    bs.wasGapBreak := gap
    bs.movedAway := false
    bs.retestSeen := false
    ov.history.phase := 3
    viewOf(c, -side).history.phase := 4
    ov.history.currentTouchNo := 0
    c.supportView.eligible := false
    c.resistanceView.eligible := false
    c.genBaselineCatMask := ov.catMask
    pushEvent(e, gap ? 4 : 3, f, c, side, bot, top, touchNo, ov.history.grade, weakReasonOf(cfg, ov.history, touchNo), 0)

activeEval(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, SideViewState sv, int side) =>
    TouchStartSnapshot sn = sv.touchSnapshot
    SideHistory h = sv.history
    float bot = sn.rangeBottom
    float top = sn.rangeTop
    bool brk = side == 1 ? tLe(f.c, bot - cfg.breakBuffer, cfg.mintick) : tGe(f.c, top + cfg.breakBuffer, cfg.mintick)
    if brk
        applyBreak(e, cfg, f, c, side, bot, top, false, h.currentTouchNo)
        sv.activeEpisode := na
    else
        // real contact of this confirmed bar, kept as its own ContactSpan
        if not na(sv.activeEpisode) and intersectsT(f.l, f.h, bot, top, cfg.mintick)
            addContactSpan(cfg, sv.activeEpisode, f.seq, f.closeTime, math.max(f.l, bot), math.min(f.h, top))
        int botT = toTick(bot, cfg.mintick)
        int topT = toTick(top, cfg.mintick)
        int cT = toTick(f.c, cfg.mintick)
        int widthT = topT - botT
        if widthT > 0 and not cfg.weakDepthOff
            float raw = side == 1 ? (topT - cT) * 100.0 / widthT : (cT - botT) * 100.0 / widthT
            float depth = math.max(0.0, math.min(100.0, raw))
            if depth > sn.maxDepthPct
                sn.maxDepthPct := depth
                sn.deepestClose := f.c
            h.maxDepthPct := math.max(h.maxDepthPct, depth)
            if not na(sv.activeEpisode)
                TouchEpisode am = sv.activeEpisode
                if depth > am.maxDepthPct
                    am.maxDepthPct := depth
                    am.deepestClose := f.c
            if depth >= cfg.weakDepthPct and not h.weakByDepth
                h.weakByDepth := true
                if not na(sv.activeEpisode)
                    sv.activeEpisode.weakByDepth := true
                pushEvent(e, 2, f, c, side, bot, top, h.currentTouchNo, sn.touchStartGrade, weakReasonOf(cfg, h, h.currentTouchNo), 0)
            else if depth >= cfg.weakDepthPct and not na(sv.activeEpisode)
                sv.activeEpisode.weakByDepth := true
        bool reset = side == 1 ? tGe(f.c, top + cfg.touchResetDistance, cfg.mintick) : tLe(f.c, bot - cfg.touchResetDistance, cfg.mintick)
        if reset
            h.phase := 0
            pushEvent(e, 1, f, c, side, bot, top, h.currentTouchNo, sn.touchStartGrade, weakReasonOf(cfg, h, h.currentTouchNo), 0)
            h.currentTouchNo := 0
            sv.activeEpisode := na

startTouch(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, SideViewState sv, int side) =>
    SideHistory h = sv.history
    bool otherActive = viewOf(c, -side).history.phase == 2
    if c.genCandidateReady and c.genCandidateMovedAway and c.genCandidateSide == side and not otherActive
        startGeneration(e, cfg, f, c, sv.catMask)
    else if c.genCandidateReady and c.genCandidateMovedAway and otherActive
        c.pendingGeneration := true
    h.sideTouchCount += 1
    h.currentTouchNo := h.sideTouchCount
    h.upcomingTouchNo := h.sideTouchCount + 1
    h.phase := 2
    h.sideFresh := false
    h.everUsed := true
    h.lastNormalTouchTime := f.closeTime
    c.zoneFresh := false
    int gr = gradeOf(cfg, sv, h.currentTouchNo)
    TouchStartSnapshot sn = sv.touchSnapshot
    sn.valid := true
    sn.coreId := c.coreId
    sn.generationId := c.generationId
    sn.side := side
    sn.rangeBottom := h.lastArmedRangeBottom
    sn.rangeTop := h.lastArmedRangeTop
    sn.rootIds := array.copy(sv.rootIds)
    sn.catMask := sv.catMask
    sn.highMask := sv.highMask
    sn.cCount := sv.cCount
    sn.hCount := sv.hCount
    sn.density := sv.density
    sn.touchStartGrade := gr
    sn.currentTouchNo := h.currentTouchNo
    sn.approachSide := side
    sn.startSeq := f.seq
    sn.startTime := f.closeTime
    sn.deepestClose := na
    sn.maxDepthPct := 0.0
    c.genBaselineCatMask := sv.catMask
    TouchEpisode ep = newEpisode(e, side, f.seq, f.closeTime, c.generationId, h.currentTouchNo,
         sn.rangeBottom, sn.rangeTop, f.c, true)
    addContactSpan(cfg, ep, f.seq, f.closeTime, math.max(f.l, sn.rangeBottom), math.min(f.h, sn.rangeTop))
    array.push(c.episodes, ep)
    sv.activeEpisode := ep
    trimEpisodes(e, cfg, c)
    pushEvent(e, 0, f, c, side, sn.rangeBottom, sn.rangeTop, h.currentTouchNo, gr, weakReasonOf(cfg, h, h.currentTouchNo), 0)
    activeEval(e, cfg, f, c, sv, side)

armedEval(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, SideViewState sv, int side) =>
    SideHistory h = sv.history
    float bot = h.lastArmedRangeBottom
    float top = h.lastArmedRangeTop
    if not na(bot) and h.armedFromSeq <= f.seq and sv.eligible
        bool touched = toTick(top, cfg.mintick) > toTick(bot, cfg.mintick) ?
             (tGe(f.h, bot, cfg.mintick) and tLe(f.l, top, cfg.mintick)) :
             (tLe(f.l, bot + cfg.touchTolerance, cfg.mintick) and tGe(f.h, bot - cfg.touchTolerance, cfg.mintick))
        if touched
            startTouch(e, cfg, f, c, sv, side)
        else
            bool gapBrk = side == 1 ? (tLt(f.h, bot, cfg.mintick) and tLe(f.c, bot - cfg.breakBuffer, cfg.mintick)) :
                 (tGt(f.l, top, cfg.mintick) and tGe(f.c, top + cfg.breakBuffer, cfg.mintick))
            if gapBrk
                applyBreak(e, cfg, f, c, side, bot, top, true, 0)

processBreakState(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c) =>
    BreakSnapshot bs = c.breakSnap
    if bs.valid and bs.breakSeq != f.seq
        int oldSide = bs.oldSide
        SideViewState ov = viewOf(c, oldSide)
        SideViewState nv = viewOf(c, -oldSide)
        bool oldRootsLive = sideHasLiveNonPsych(e, cfg, ov, oldSide)
        bool reclaim = oldSide == 1 ? tGe(f.c, bs.rangeTop + cfg.breakBuffer, cfg.mintick) : tLe(f.c, bs.rangeBottom - cfg.breakBuffer, cfg.mintick)
        if reclaim and oldRootsLive
            bs.valid := false
            ov.history.phase := 0
            nv.history.phase := 0
            pushEvent(e, 7, f, c, oldSide, bs.rangeBottom, bs.rangeTop, 0, ov.history.grade, weakReasonOf(cfg, ov.history, ov.history.sideTouchCount + 1), 0)
        else if not reclaim
            float awayLevel = oldSide == 1 ? bs.rangeBottom - cfg.touchResetDistance : bs.rangeTop + cfg.touchResetDistance
            if not bs.movedAway
                bs.movedAway := oldSide == 1 ? tLe(f.c, awayLevel, cfg.mintick) : tGe(f.c, awayLevel, cfg.mintick)
            else
                bool retest = intersectsT(f.l, f.h, bs.rangeBottom, bs.rangeTop, cfg.mintick)
                if retest
                    bs.retestSeen := true
                    bool confirm = oldSide == 1 ? tLe(f.c, bs.rangeBottom, cfg.mintick) : tGe(f.c, bs.rangeTop, cfg.mintick)
                    if confirm
                        bs.valid := false
                        nv.history.phase := 0
                        nv.history.lastFlipConfirmSeq := f.seq
                        ov.history.phase := 0
                        TouchEpisode fep = newEpisode(e, -oldSide, f.seq, f.closeTime, c.generationId, 0,
                             bs.rangeBottom, bs.rangeTop, f.c, false)
                        addContactSpan(cfg, fep, f.seq, f.closeTime, math.max(f.l, bs.rangeBottom), math.min(f.h, bs.rangeTop))
                        array.push(c.episodes, fep)
                        trimEpisodes(e, cfg, c)
                        pushEvent(e, 6, f, c, -oldSide, bs.rangeBottom, bs.rangeTop, 0, nv.history.grade, 0, 0)
                    else
                        nv.history.flipAttemptCount += 1
                        pushEvent(e, 5, f, c, -oldSide, bs.rangeBottom, bs.rangeTop, 0, nv.history.grade, 0, 0)

// =============================================================================
// 13. Generation candidate, per bar finalisation, storage, views
// =============================================================================
updateGenerationCandidate(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c) =>
    for si = 0 to 1
        int side = si == 0 ? 1 : -1
        SideViewState sv = viewOf(c, side)
        SideHistory h = sv.history
        if sv.baseStrong and not na(sv.effectiveBottom)
            int newCats = sv.catMask - (sv.catMask & c.genBaselineCatMask)
            newCats := newCats - (newCats & 32)
            bool consumed = h.sideTouchCount > 0 or h.weakByDepth or c.breakSnap.valid or not c.zoneFresh
            if newCats != 0 and consumed
                c.genCandidateReady := true
                c.genCandidateSide := side
    if c.genCandidateReady and c.genCandidateSide != 0
        SideViewState gv = viewOf(c, c.genCandidateSide)
        if not na(gv.effectiveBottom)
            bool away = c.genCandidateSide == 1 ? tGe(f.c, gv.effectiveTop + cfg.touchResetDistance, cfg.mintick) :
                 tLe(f.c, gv.effectiveBottom - cfg.touchResetDistance, cfg.mintick)
            c.genCandidateMovedAway := c.genCandidateMovedAway or away

// A side whose FVG root confirmed its Inverse on this bar cannot complete the
// reset on that same bar, exactly like a FlipConfirm bar (spec 12 / 15.4).
sideInverseConfirmedNow(ZoneEngine e, SideViewState sv, int seq) =>
    int n = array.size(sv.rootIds)
    bool now = false
    if n > 0
        for i = 0 to n - 1
            Root r = rootOf(e, array.get(sv.rootIds, i))
            if not na(r) and r.category == 4 and r.inverseConfirmSeq == seq
                now := true
                break
    now

// Dormant uses the physical distance to the EffectiveZoneRange, never the
// display-only reference price.
finalizeSide(ZoneEngine e, ZoneCfg cfg, BaseFeed f, ZoneCore c, SideViewState sv, int side) =>
    SideHistory h = sv.history
    if h.phase == 2
        sv.eligible := sideHasLiveNonPsych(e, cfg, sv, side)
    if not na(sv.effectiveBottom)
        float dist = intervalGap(sv.effectiveBottom, sv.effectiveTop, f.c, f.c)
        if h.phase == 5 and dist <= cfg.dormantDistance
            h.phase := 0
        bool confirmBar = f.seq <= h.lastFlipConfirmSeq or sideInverseConfirmedNow(e, sv, f.seq)
        if h.phase == 0 and sv.eligible and not confirmBar
            bool armCond = side == 1 ? tGe(f.c, sv.effectiveTop + cfg.touchResetDistance, cfg.mintick) :
                 tLe(f.c, sv.effectiveBottom - cfg.touchResetDistance, cfg.mintick)
            if armCond
                h.phase := 1
                h.armedFromSeq := f.seq + 1
        if h.phase == 1
            h.lastArmedRangeBottom := sv.effectiveBottom
            h.lastArmedRangeTop := sv.effectiveTop
        if (h.phase == 0 or h.phase == 1) and dist > cfg.dormantDistance
            h.phase := 5
    h.upcomingTouchNo := h.sideTouchCount + 1
    int target = h.phase == 2 ? h.currentTouchNo : h.upcomingTouchNo
    h.weakByTouch := not cfg.weakFromTouchOff and target >= cfg.weakFromTouch
    h.grade := gradeOf(cfg, sv, target)

// 13.1 Storage. Protected items are never pruned. Cores are taken from the
//      oldest Dormant with the fewest roots first; a non-Dormant Core is only
//      considered when no unprotected Dormant Core exists at all. When only
//      protected items remain above the limit nothing is deleted silently.
buildProtectedSet(ZoneEngine e) =>
    map<int, int> prot = map.new<int, int>()
    int cn = array.size(e.cores)
    if cn > 0
        for i = 0 to cn - 1
            ZoneCore c = array.get(e.cores, i)
            for si = 0 to 1
                SideViewState sv = si == 0 ? c.supportView : c.resistanceView
                int n = array.size(sv.rootIds)
                if n > 0
                    for q = 0 to n - 1
                        map.put(prot, array.get(sv.rootIds, q), 1)
                if sv.touchSnapshot.valid and not na(sv.touchSnapshot.rootIds)
                    int m = array.size(sv.touchSnapshot.rootIds)
                    if m > 0
                        for q = 0 to m - 1
                            map.put(prot, array.get(sv.touchSnapshot.rootIds, q), 1)
            if c.breakSnap.valid and not na(c.breakSnap.rootIds)
                int m2 = array.size(c.breakSnap.rootIds)
                if m2 > 0
                    for q = 0 to m2 - 1
                        map.put(prot, array.get(c.breakSnap.rootIds, q), 1)
            int on = array.size(c.originRootIds)
            if on > 0
                for q = 0 to on - 1
                    map.put(prot, array.get(c.originRootIds, q), 1)
    prot

rootProtected(map<int, int> prot, Root r) =>
    map.contains(prot, r.rootId) or r.state == 3 or r.state == 4

pruneCategorySimple(ZoneEngine e, map<int, int> prot, int cat, int limit) =>
    array<int> ci = catIndexArr(e, cat)
    bool stop = false
    while array.size(ci) > limit and not stop
        int victim = 0
        int oldest = 0
        int n = array.size(ci)
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(ci, i))
            if not rootProtected(prot, r) and (victim == 0 or nz(r.confirmedTime) < oldest)
                victim := r.rootId
                oldest := nz(r.confirmedTime)
        if victim == 0
            e.storageOverLimit := true
            stop := true
        else
            unregisterRoot(e, victim)
            e.prunedRootCount += 1
            e.storagePruned := true

accumBoxCount(ZoneEngine e) =>
    array.clear(e.sTmpB)
    int n = array.size(e.idxAccum)
    if n > 0
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxAccum, i))
            if r.pairKey != 0 and not array.includes(e.sTmpB, r.pairKey)
                array.push(e.sTmpB, r.pairKey)
    array.size(e.sTmpB)

// maxAccumBoxes counts Boxes. Both boundaries of a pair are removed together,
// and a pair is only removed when neither boundary is protected.
pruneAccumBoxes(ZoneEngine e, ZoneCfg cfg, map<int, int> prot) =>
    bool stop = false
    while accumBoxCount(e) > cfg.maxAccumBoxes and not stop
        int n = array.size(e.idxAccum)
        int victimPair = 0
        int oldest = 0
        if n > 0
            for i = 0 to n - 1
                Root r = array.get(e.roots, array.get(e.idxAccum, i))
                if r.pairKey != 0
                    bool bothFree = true
                    int pairTime = 0
                    for q = 0 to n - 1
                        Root r2 = array.get(e.roots, array.get(e.idxAccum, q))
                        if r2.pairKey == r.pairKey
                            bothFree := bothFree and not rootProtected(prot, r2)
                            pairTime := pairTime == 0 or nz(r2.confirmedTime) < pairTime ? nz(r2.confirmedTime) : pairTime
                    if bothFree and (victimPair == 0 or pairTime < oldest)
                        victimPair := r.pairKey
                        oldest := pairTime
        if victimPair == 0
            e.storageOverLimit := true
            stop := true
        else
            int m = array.size(e.idxAccum)
            if m > 0
                for i = m - 1 to 0
                    Root r = array.get(e.roots, array.get(e.idxAccum, i))
                    if r.pairKey == victimPair
                        unregisterRoot(e, r.rootId)
                        e.prunedRootCount += 1
            e.storagePruned := true

coreProtected(ZoneEngine e, ZoneCore c) =>
    bool p = coreHasActiveTouch(c) or c.breakSnap.valid or c.pendingTopology or c.pendingGeneration or
         c.supportView.history.phase == 3 or c.supportView.history.phase == 4 or
         c.resistanceView.history.phase == 3 or c.resistanceView.history.phase == 4
    int on = array.size(c.originRootIds)
    if not p and on > 0
        for q = 0 to on - 1
            Root r = rootOf(e, array.get(c.originRootIds, q))
            if not na(r) and (r.state == 3 or r.state == 4)
                p := true
                break
    p

pruneStorage(ZoneEngine e, ZoneCfg cfg, BaseFeed f) =>
    bool stop = false
    while array.size(e.cores) > cfg.maxZoneCores and not stop
        int victim = -1
        int fewest = 0
        int oldest = 0
        for pass = 0 to 1
            if victim < 0
                int n = array.size(e.cores)
                for i = 0 to n - 1
                    ZoneCore c = array.get(e.cores, i)
                    bool cand = not coreProtected(e, c) and (pass == 0 ? c.dormant : not c.dormant)
                    if cand
                        int roots = array.size(c.originRootIds)
                        int seen = nz(c.lastSeenTime)
                        bool better = victim < 0 or roots < fewest or (roots == fewest and seen < oldest)
                        if better
                            victim := i
                            fewest := roots
                            oldest := seen
        if victim < 0
            e.storageOverLimit := true
            stop := true
        else
            ZoneCore vc = array.get(e.cores, victim)
            array.push(e.endedGenCores, vc.coreId)
            array.push(e.endedGenIds, vc.generationId)
            array.remove(e.cores, victim)
            e.prunedZoneCount += 1
            e.storagePruned := true
            pushEvent(e, 14, f, na, 0, na, na, 0, 1, 0, 0)
    bool needRoot = array.size(e.idxSwing) > cfg.maxSwingRoots or array.size(e.idxFvg) > cfg.maxFvgRoots or
         array.size(e.idxTime) > cfg.maxTimeRoots or accumBoxCount(e) > cfg.maxAccumBoxes
    if needRoot
        map<int, int> prot = buildProtectedSet(e)
        pruneCategorySimple(e, prot, 1, cfg.maxSwingRoots)
        pruneCategorySimple(e, prot, 4, cfg.maxFvgRoots)
        pruneCategorySimple(e, prot, 3, cfg.maxTimeRoots)
        pruneAccumBoxes(e, cfg, prot)
        pushEvent(e, 14, f, na, 0, na, na, 0, 1, 0, 0)
    while array.size(e.endedGenCores) > cfg.maxEndedGenerations
        array.shift(e.endedGenCores)
        array.shift(e.endedGenIds)

// 13.2 Read only projections. Every zone is returned; the engine never filters
//      by distance or strength.
buildViews(ZoneEngine e, ZoneCfg cfg) =>
    array.clear(e.views)
    int n = array.size(e.cores)
    if n > 0
        for i = 0 to n - 1
            ZoneCore c = array.get(e.cores, i)
            for si = 0 to 1
                int side = si == 0 ? 1 : -1
                SideViewState sv = viewOf(c, side)
                if not na(sv.effectiveBottom)
                    SideHistory h = sv.history
                    int target = h.phase == 2 ? h.currentTouchNo : h.upcomingTouchNo
                    array.push(e.views, ZoneView.new(coreId = c.coreId, generationId = c.generationId,
                         side = side, effectiveBottom = sv.effectiveBottom, effectiveTop = sv.effectiveTop,
                         referencePrice = sv.referencePrice, phase = h.phase, grade = h.grade,
                         cCount = sv.cCount, hCount = sv.hCount, density = sv.density,
                         baseStrong = sv.baseStrong, currentTouchNo = h.currentTouchNo,
                         upcomingTouchNo = h.upcomingTouchNo, zoneFresh = c.zoneFresh,
                         sideFresh = h.sideTouchCount == 0, weakReason = weakReasonOf(cfg, h, target),
                         maxDepthPct = h.maxDepthPct, isBroadContext = sv.isBroadContext,
                         fvgDirMask = sv.fvgDirMask, fvgRootCount = sv.fvgRootCount,
                         fvgFreshCount = sv.fvgFreshCount, fvgStateMask = sv.fvgStateMask,
                         eligible = sv.eligible, catMask = sv.catMask, highMask = sv.highMask,
                         rootIds = array.copy(sv.rootIds)))

// =============================================================================
// 14. Public API
// =============================================================================
export update(ZoneEngine e, ZoneCfg cfg, BaseFeed bf, MaPack ma,
     PivotPack sw5, PivotPack sw15, PivotPack sw1h,
     AccumPack ac1, AccumPack ac4, AccumPack acD,
     FvgPack fv1, FvgPack fv4, FvgPack fvD) =>
    bool processed = false
    if not na(bf.mintick) and bf.mintick > 0.0
        cfg.mintick := bf.mintick
    e.configValid := validateCfg(cfg)
    e.configError := cfg.errorText
    if e.configValid and bf.confirmed and not na(bf.openTime) and (na(e.lastBaseOpenTime) or bf.openTime > e.lastBaseOpenTime)
        e.lastBaseOpenTime := bf.openTime
        e.seq += 1
        e.lastBaseSeq := e.seq
        bf.seq := e.seq
        array.clear(e.events)
        e.statWindowEvals := 0
        e.statDenseRounds := 0
        e.statCoreMatches := 0
        e.statCandidates := 0
        e.statDeferred := 0
        e.statComponents := 0
        // --- facts that outrank later structure changes --------------------
        markFvgInvalidation(e, cfg, bf, fv1, e.lastFvg1hSrcClose)
        markFvgInvalidation(e, cfg, bf, fv4, e.lastFvg4hSrcClose)
        markFvgInvalidation(e, cfg, bf, fvD, e.lastFvgDSrcClose)
        // --- A..D: detection against the previous confirmed structure ------
        int cn = array.size(e.cores)
        if cn > 0
            for i = 0 to cn - 1
                ZoneCore c = array.get(e.cores, i)
                c.pendingTopology := false
                processBreakState(e, cfg, bf, c)
                for si = 0 to 1
                    int side = si == 0 ? 1 : -1
                    SideViewState sv = viewOf(c, side)
                    int ph = sv.history.phase
                    if ph == 2
                        activeEval(e, cfg, bf, c, sv, side)
                    else if ph == 1
                        armedEval(e, cfg, bf, c, sv, side)
        // --- E: root registry changes --------------------------------------
        e.lastFvg1hSrcClose := applyFvgState(e, cfg, bf, fv1, e.lastFvg1hSrcClose)
        e.lastFvg4hSrcClose := applyFvgState(e, cfg, bf, fv4, e.lastFvg4hSrcClose)
        e.lastFvgDSrcClose  := applyFvgState(e, cfg, bf, fvD, e.lastFvgDSrcClose)
        updateFvgInverse(e, cfg, bf)
        ingestMa(e, cfg, ma, bf.closeTime)
        [h5, l5] = ingestSwing(e, cfg, sw5, 1, bf.closeTime, e.lastSw5Origin, e.lastSw5LowOrigin)
        e.lastSw5Origin := h5
        e.lastSw5LowOrigin := l5
        [h15, l15] = ingestSwing(e, cfg, sw15, 2, bf.closeTime, e.lastSw15Origin, e.lastSw15LowOrigin)
        e.lastSw15Origin := h15
        e.lastSw15LowOrigin := l15
        [h1h, l1h] = ingestSwing(e, cfg, sw1h, 4, bf.closeTime, e.lastSw1hOrigin, e.lastSw1hLowOrigin)
        e.lastSw1hOrigin := h1h
        e.lastSw1hLowOrigin := l1h
        e.lastAccum1hConfirm := ingestAccum(e, cfg, ac1, bf.closeTime, e.lastAccum1hConfirm)
        e.lastAccum4hConfirm := ingestAccum(e, cfg, ac4, bf.closeTime, e.lastAccum4hConfirm)
        e.lastAccumDConfirm  := ingestAccum(e, cfg, acD, bf.closeTime, e.lastAccumDConfirm)
        ingestFvgNew(e, cfg, fv1, bf.closeTime)
        ingestFvgNew(e, cfg, fv4, bf.closeTime)
        ingestFvgNew(e, cfg, fvD, bf.closeTime)
        updateTimeHL(e, cfg, bf)
        // --- G: re-clustering ----------------------------------------------
        collectPoints(e, cfg)
        syncPsych(e, cfg, bf.c)
        buildCandidates(e, cfg)
        associateCandidates(e, cfg, bf)
        // --- H, I: generation candidates and next bar state ----------------
        int cn2 = array.size(e.cores)
        if cn2 > 0
            for i = 0 to cn2 - 1
                ZoneCore c = array.get(e.cores, i)
                updateGenerationCandidate(e, cfg, bf, c)
                finalizeSide(e, cfg, bf, c, c.supportView, 1)
                finalizeSide(e, cfg, bf, c, c.resistanceView, -1)
                c.dormant := c.supportView.history.phase == 5 and c.resistanceView.history.phase == 5
                c.pendingGeneration := c.pendingGeneration and coreHasActiveTouch(c)
        // --- J: storage and read only projections --------------------------
        pruneStorage(e, cfg, bf)
        buildViews(e, cfg)
        e.dirtyRootSet := false
        e.dirtyRootPrice := false
        e.dirtyQuality := false
        e.dirtyFvgState := false
        processed := true
    processed

export viewCount(ZoneEngine e) => array.size(e.views)
export viewAt(ZoneEngine e, int i) => array.get(e.views, i)
export eventCount(ZoneEngine e) => array.size(e.events)
export eventAt(ZoneEngine e, int i) => array.get(e.events, i)
export coreCount(ZoneEngine e) => array.size(e.cores)
export candidateCount(ZoneEngine e) => e.statCandidates
export lastBaseTime(ZoneEngine e) => e.lastBaseOpenTime
export lastBaseSeq(ZoneEngine e) => e.lastBaseSeq
export engineConfigValid(ZoneEngine e) => e.configValid
export engineConfigError(ZoneEngine e) => e.configError
export storagePruned(ZoneEngine e) => e.storagePruned
export storageOverLimit(ZoneEngine e) => e.storageOverLimit
export prunedRootCount(ZoneEngine e) => e.prunedRootCount
export prunedZoneCount(ZoneEngine e) => e.prunedZoneCount
export touchHistoryTruncated(ZoneEngine e) => e.touchHistoryTruncated
export scratchOverflow(ZoneEngine e) => e.scratchOverflow
export lastMaSourceTime(ZoneEngine e) => e.lastMaSrcTime
export lastFvgSourceTime(ZoneEngine e, int tfCode) =>
    tfCode == 60 ? e.lastFvg1hSrcClose : tfCode == 240 ? e.lastFvg4hSrcClose : e.lastFvgDSrcClose
export lastAccumConfirmTime(ZoneEngine e, int tfCode) =>
    tfCode == 60 ? e.lastAccum1hConfirm : tfCode == 240 ? e.lastAccum4hConfirm : e.lastAccumDConfirm
export sessionId(ZoneEngine e) => e.curSessionId
export dayKey(ZoneEngine e) => e.curDayKey
export weekKey(ZoneEngine e) => e.curWeekKey
export endedGenerationCount(ZoneEngine e) => array.size(e.endedGenCores)
export pendingTopologyCount(ZoneEngine e) =>
    int n = array.size(e.cores)
    int k = 0
    if n > 0
        for i = 0 to n - 1
            k += array.get(e.cores, i).pendingTopology ? 1 : 0
    k
export pendingGenerationCount(ZoneEngine e) =>
    int n = array.size(e.cores)
    int k = 0
    if n > 0
        for i = 0 to n - 1
            k += array.get(e.cores, i).pendingGeneration ? 1 : 0
    k
export statWindowEvals(ZoneEngine e) => e.statWindowEvals
export statDenseRounds(ZoneEngine e) => e.statDenseRounds
export statCoreMatches(ZoneEngine e) => e.statCoreMatches
export statMerges(ZoneEngine e) => e.statMerges
export statSplits(ZoneEngine e) => e.statSplits
export statDeferred(ZoneEngine e) => e.statDeferred
export statComponents(ZoneEngine e) => e.statComponents
export statOwnerConflict(ZoneEngine e) => e.statOwnerConflict
export statPendingHold(ZoneEngine e) => e.statPendingHold
export maSlopeText(ZoneEngine e) =>
    string s = ""
    int n = array.size(e.idxMa)
    if n > 0
        for i = 0 to n - 1
            Root r = array.get(e.roots, array.get(e.idxMa, i))
            s += (r.subtype == 0 ? "EMA2000 " : "EMA3000 ") + (r.slopeDir > 0 ? "up" : r.slopeDir < 0 ? "down" : "flat") + " "
    s == "" ? "-" : s

// Presentation helpers. They never change engine state and are only called for
// the zones the harness actually draws.
export categorySummary(ZoneView v) =>
    string s = ""
    for c = 0 to 5
        if (v.catMask & (1 << c)) != 0
            s += categoryName(c) + ((v.highMask & (1 << c)) != 0 ? "(H) " : " ")
    s == "" ? "-" : s

export rootSummary(ZoneEngine e, ZoneView v) =>
    string s = ""
    int n = na(v.rootIds) ? 0 : array.size(v.rootIds)
    if n > 0
        for i = 0 to n - 1
            Root r = rootOf(e, array.get(v.rootIds, i))
            if not na(r)
                s += categoryName(r.category) + str.tostring(r.rootId) + "/" + tfName(r.tfCode) + " "
    s == "" ? "-" : s

export viewLabelText(ZoneEngine e, ZoneView v) =>
    string s = "#" + str.tostring(v.coreId) + " / G" + str.tostring(v.generationId) + " / " + sideName(v.side) + "\n"
    s += phaseName(v.phase) + " | " + gradeName(v.grade) + "\n"
    s += "Range " + str.tostring(v.effectiveBottom, format.mintick) + "-" + str.tostring(v.effectiveTop, format.mintick) +
         " / Ref " + str.tostring(v.referencePrice, format.mintick) + "\n"
    s += "C" + str.tostring(v.cCount) + " H" + str.tostring(v.hCount) + " " + densityName(v.density) +
         (v.baseStrong ? " BaseStrong" : "") + "\n"
    s += (v.phase == 2 ? "Current Touch " + str.tostring(v.currentTouchNo) : "Upcoming Touch " + str.tostring(v.upcomingTouchNo)) + "\n"
    s += weakReasonName(v.weakReason) + " / MaxDepth " + str.tostring(v.maxDepthPct, "#.#") + "%\n"
    s += "ZoneFresh " + (v.zoneFresh ? "Y" : "N") + " / SideFresh " + (v.sideFresh ? "Y" : "N") + "\n"
    s += "FVG dir " + fvgDirText(v.fvgDirMask) + "| fresh " + str.tostring(v.fvgFreshCount) + "/" + str.tostring(v.fvgRootCount) +
         " | " + fvgStateText(v.fvgStateMask) + (v.isBroadContext ? "| BROAD CONTEXT" : "") + "\n"
    s += "Cat " + categorySummary(v) + "\n"
    s += "Roots " + rootSummary(e, v)
    s

                                        aPlace  := a
                        else if aOp == JOP_NEW_ROOT and array.get(engine.w03Store.journalCategories, a) != CAT_FVG and a != eNewRow
                            int aSlot = predictedNewRootSlotRaw(engine, a)
                            int aId   = predictedNewRootIdRaw(engine, a)
                            aMember := true
                            aTick   := int(math.round(array.get(engine.w03Store.journalPointPrices, a) / mintick))
                            aPlace  := a
                            int aK = 0
                            while aK < count
                                if aK != row and array.get(engine.w03Store.journalOps, aK) == JOP_MA_UPDATE and journalAppliedBeforeRaw(engine, aK, row) and array.get(engine.w03Store.journalTargetRootSlots, aK) == aSlot and array.get(engine.w03Store.journalExpectedRootIds, aK) == aId

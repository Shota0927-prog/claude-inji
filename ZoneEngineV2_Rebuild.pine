        ok := bottomPos >= 0 and topPos >= 0 and bottomPos < array.size(engine.fvgNativeBottomOrderRootSlots) and topPos < array.size(engine.fvgNativeTopOrderRootSlots)
        if ok
            ok := array.get(engine.fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(engine.fvgNativeTopOrderRootSlots, topPos) == rootSlot
    if ok
        ok := rootSetMembershipValidRaw(engine, rootSlot)
    if ok
        ok := fvgSetMembershipValidRaw(engine, rootSlot, expectedRootId)
    // Step 4 : Fresh true -> false only, on the state the row names, Broad unchanged
    if ok
        ok := array.get(engine.rootStates, rootSlot) == oldState and array.get(engine.rootFvgFreshFlags, rootSlot) and array.get(engine.rootIsBroadFvgFlags, rootSlot) == isBroad
    // Step 5 : commit. The Fresh set entry first, then the logical flag.
    bool detached = false
    if ok
        detached := fvgFreshSetDetachRaw(engine, rootSlot, expectedRootId)
        if detached
            array.set(engine.rootFvgFreshFlags, rootSlot, false)
    detached

// Structurally invalidates one ACTIVE FVG Root: ACTIVE -> INVALIDATED. true when
// applied; false with zero mutation when the row, the Root or its indexes do not
// meet the invalidation contract.
fvgInvalidateApplyRaw(ZoneEngine engine, int journalRow) =>
    // Step 1 : an E1 FVG_INVALIDATE row
    bool ok = journalRow >= 0 and journalRow < engine.w03Store.journalCount and journalRow < array.size(engine.w03Store.journalOps) and journalRow < array.size(engine.w03Store.journalGroups) and journalRow < array.size(engine.w03Store.journalTargetRootSlots) and journalRow < array.size(engine.w03Store.journalExpectedRootIds) and journalRow < array.size(engine.w03Store.journalCategories) and journalRow < array.size(engine.w03Store.journalSubtypes) and journalRow < array.size(engine.w03Store.journalTfCodes) and journalRow < array.size(engine.w03Store.journalOriginKeys) and journalRow < array.size(engine.w03Store.journalOriginTimes) and journalRow < array.size(engine.w03Store.journalOriginEndTimes) and journalRow < array.size(engine.w03Store.journalConfirmedTimes) and journalRow < array.size(engine.w03Store.journalPointPrices) and journalRow < array.size(engine.w03Store.journalNativeBottoms) and journalRow < array.size(engine.w03Store.journalNativeTops) and journalRow < array.size(engine.w03Store.journalOldStates) and journalRow < array.size(engine.w03Store.journalNewStates) and journalRow < array.size(engine.w03Store.journalFvgFreshFlags) and journalRow < array.size(engine.w03Store.journalIsBroadFlags) and journalRow < array.size(engine.w03Store.journalDirections) and journalRow < array.size(engine.w03Store.journalOldMasks) and journalRow < array.size(engine.w03Store.journalNewMasks) and journalRow < array.size(engine.w03Store.journalPairKeys) and journalRow < array.size(engine.w03Store.journalSlopeDirs)

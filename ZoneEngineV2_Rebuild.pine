virtualFvgFreshBeforeRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int beforeRow) =>
    bool fresh    = false
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootFvgFreshFlags)
        if array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
            fresh    := array.get(engine.rootFvgFreshFlags, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(engine, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            fresh    := array.get(engine.w03Store.journalCategories, newRow) == CAT_FVG ? array.get(engine.w03Store.journalFvgFreshFlags, newRow) : false
            baseRow  := newRow
            resolved := true
    if resolved

                    if ok
                        int entryTf  = array.get(engine.rootTfCodes,    slot)
                        int entryDir = array.get(engine.rootDirections, slot)
                        ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeTopTicks, slot)) and array.get(engine.rootFvgNativeTopOrderPositions, slot) == t
                    t += 1
            // Step 4f : participation last among the checks - it is all-or-nothing, so
            // a false here still leaves every index and the Root untouched.
            if ok
                bool participationDetached = participationDetachAllForRootRaw(engine, rootSlot)
                if participationDetached

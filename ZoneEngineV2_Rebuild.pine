    array<int> newSet = newState == ROOT_CANDIDATE ? engine.stateCandidateRootSlots : newState == ROOT_ACTIVE ? engine.stateActiveRootSlots : newState == ROOT_INVALIDATED ? engine.stateInvalidatedRootSlots : newState == ROOT_INVERSE_WAIT ? engine.stateInverseWaitRootSlots : newState == ROOT_INVERSE_ACTIVE ? engine.stateInverseActiveRootSlots : engine.stateRetiredRootSlots

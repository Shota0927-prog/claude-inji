                    ok := structPos >= 0 and structPos < array.size(activeSet)
                    if ok
                        ok := array.get(activeSet, structPos) == rootSlot
                    if ok
                        int lastPos      = array.size(activeSet) - 1
                        int lastRootSlot = array.get(activeSet, lastPos)
                        ok := lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgStructuralStateSetPositions)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgStructuralStateSetPositions, lastRootSlot) == lastPos and array.get(activeSet, lastPos) == lastRootSlot
            if isFvg
                if ok
                    ok := dirPos >= 0 and dirPos < array.size(dirSet)
                    if ok
                        ok := array.get(dirSet, dirPos) == rootSlot
                    if ok
                        int lastPos      = array.size(dirSet) - 1
                        int lastRootSlot = array.get(dirSet, lastPos)
                        ok := lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgDirectionSetPositions)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgDirectionSetPositions, lastRootSlot) == lastPos and array.get(dirSet, lastPos) == lastRootSlot
            if isFvg and fvgBroad
                if ok
                    ok := broadPos >= 0 and broadPos < array.size(engine.broadFvgRootSlots)
                    if ok
                        ok := array.get(engine.broadFvgRootSlots, broadPos) == rootSlot
                    if ok
                        int lastPos      = array.size(engine.broadFvgRootSlots) - 1
                        int lastRootSlot = array.get(engine.broadFvgRootSlots, lastPos)
                        ok := lastRootSlot >= 0 and lastRootSlot < array.size(engine.rootIds) and lastRootSlot < array.size(engine.rootSlotLiveFlags) and lastRootSlot < array.size(engine.rootFvgBroadSetPositions)
                        if ok
                            ok := array.get(engine.rootSlotLiveFlags, lastRootSlot) and array.get(engine.rootIds, lastRootSlot) != ID_NONE and array.get(engine.rootFvgBroadSetPositions, lastRootSlot) == lastPos and array.get(engine.broadFvgRootSlots, lastPos) == lastRootSlot
            if ok and isFvg
                // NativeRange orders, mirroring fvgNativeRangeOrderDetachRaw read-only
                int bottomTick = array.get(engine.rootNativeBottomTicks, rootSlot)
                int topTick    = array.get(engine.rootNativeTopTicks,    rootSlot)
                int bottomPos  = array.get(engine.rootFvgNativeBottomOrderPositions, rootSlot)
                int topPos     = array.get(engine.rootFvgNativeTopOrderPositions,    rootSlot)
                int bottomSize = array.size(engine.fvgNativeBottomOrderRootSlots)
                int topSize    = array.size(engine.fvgNativeTopOrderRootSlots)
                ok := not na(bottomTick) and not na(topTick) and bottomTick <= topTick and bottomPos != SLOT_INVALID and topPos != SLOT_INVALID and bottomPos >= 0 and topPos >= 0 and bottomPos < bottomSize and topPos < topSize
                if ok
                    ok := array.get(engine.fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(engine.fvgNativeTopOrderRootSlots, topPos) == rootSlot
                int b = bottomPos + 1
                while ok and b < bottomSize
                    int slot = array.get(engine.fvgNativeBottomOrderRootSlots, b)
                    ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootFvgNativeBottomOrderPositions)
                    if ok
                        int entryTf  = array.get(engine.rootTfCodes,    slot)
                        int entryDir = array.get(engine.rootDirections, slot)
                        ok := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootIds, slot) != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootNativeBottomTicks, slot)) and array.get(engine.rootFvgNativeBottomOrderPositions, slot) == b
                    b += 1
                int t = topPos + 1

                    else if lastSessionOld
                        if isHigh and lastSessionHighSlot == tSlot and lastSessionHighId == tId
                            lastSessionHighSlot := SLOT_INVALID
                            lastSessionHighId   := ID_NONE
                        else if isLow and lastSessionLowSlot == tSlot and lastSessionLowId == tId
                            lastSessionLowSlot := SLOT_INVALID
                            lastSessionLowId   := ID_NONE
                    bool todayOld = int(math.floor(oldMask / TIMEHL_LABEL_TODAY)) % 2 == 1
                    bool todayNew = int(math.floor(newMask / TIMEHL_LABEL_TODAY)) % 2 == 1
                    if todayNew
                        if isHigh
                            todayHighSlot := tSlot
                            todayHighId   := tId
                        else if isLow
                            todayLowSlot := tSlot
                            todayLowId   := tId
                    else if todayOld
                        if isHigh and todayHighSlot == tSlot and todayHighId == tId
                            todayHighSlot := SLOT_INVALID
                            todayHighId   := ID_NONE
                        else if isLow and todayLowSlot == tSlot and todayLowId == tId
                            todayLowSlot := SLOT_INVALID
                            todayLowId   := ID_NONE
                    bool prevDayOld = int(math.floor(oldMask / TIMEHL_LABEL_PREV_DAY)) % 2 == 1
                    bool prevDayNew = int(math.floor(newMask / TIMEHL_LABEL_PREV_DAY)) % 2 == 1
                    if prevDayNew
                        if isHigh
                            prevDayHighSlot := tSlot
                            prevDayHighId   := tId
                        else if isLow
                            prevDayLowSlot := tSlot
                            prevDayLowId   := tId
                    else if prevDayOld
                        if isHigh and prevDayHighSlot == tSlot and prevDayHighId == tId
                            prevDayHighSlot := SLOT_INVALID
                            prevDayHighId   := ID_NONE
                        else if isLow and prevDayLowSlot == tSlot and prevDayLowId == tId
                            prevDayLowSlot := SLOT_INVALID
                            prevDayLowId   := ID_NONE
                    bool curWeekOld = int(math.floor(oldMask / TIMEHL_LABEL_CUR_WEEK)) % 2 == 1
                    bool curWeekNew = int(math.floor(newMask / TIMEHL_LABEL_CUR_WEEK)) % 2 == 1
                    if curWeekNew
                        if isHigh
                            curWeekHighSlot := tSlot
                            curWeekHighId   := tId
                        else if isLow
                            curWeekLowSlot := tSlot
                            curWeekLowId   := tId
                    else if curWeekOld
                        if isHigh and curWeekHighSlot == tSlot and curWeekHighId == tId
                            curWeekHighSlot := SLOT_INVALID
                            curWeekHighId   := ID_NONE
                        else if isLow and curWeekLowSlot == tSlot and curWeekLowId == tId
                            curWeekLowSlot := SLOT_INVALID
                            curWeekLowId   := ID_NONE
                    bool prevWeekOld = int(math.floor(oldMask / TIMEHL_LABEL_PREV_WEEK)) % 2 == 1
                    bool prevWeekNew = int(math.floor(newMask / TIMEHL_LABEL_PREV_WEEK)) % 2 == 1
                    if prevWeekNew
                        if isHigh
                            prevWeekHighSlot := tSlot
                            prevWeekHighId   := tId
                        else if isLow
                            prevWeekLowSlot := tSlot
                            prevWeekLowId   := tId
                    else if prevWeekOld
                        if isHigh and prevWeekHighSlot == tSlot and prevWeekHighId == tId
                            prevWeekHighSlot := SLOT_INVALID
                            prevWeekHighId   := ID_NONE
                        else if isLow and prevWeekLowSlot == tSlot and prevWeekLowId == tId
                            prevWeekLowSlot := SLOT_INVALID
                            prevWeekLowId   := ID_NONE
            row += 1
        group += 1
    if ok
        engine.w03Store.lastConsumed15mSwingCloseTime := nextLastConsumed15mSwingCloseTime
        engine.w03Store.lastConsumed1hSwingCloseTime := nextLastConsumed1hSwingCloseTime
        engine.w03Store.lastConsumed1hAccumCloseTime := nextLastConsumed1hAccumCloseTime
        engine.w03Store.lastConsumed1hFvgFormationCloseTime := nextLastConsumed1hFvgFormationCloseTime
        engine.w03Store.lastConsumed1hFvgStructuralCloseTime := nextLastConsumed1hFvgStructuralCloseTime
        engine.w03Store.lastConsumed4hAccumCloseTime := nextLastConsumed4hAccumCloseTime
        engine.w03Store.lastConsumed4hFvgFormationCloseTime := nextLastConsumed4hFvgFormationCloseTime
        engine.w03Store.lastConsumed4hFvgStructuralCloseTime := nextLastConsumed4hFvgStructuralCloseTime
        engine.w03Store.lastConsumedDAccumCloseTime := nextLastConsumedDAccumCloseTime
        engine.w03Store.lastConsumedDFvgFormationCloseTime := nextLastConsumedDFvgFormationCloseTime
        engine.w03Store.lastConsumedDFvgStructuralCloseTime := nextLastConsumedDFvgStructuralCloseTime
        engine.w03Store.ema2000RootSlot       := ema2000Slot
        engine.w03Store.ema2000ExpectedRootId := ema2000Id
        engine.w03Store.ema2000SlopeDir       := ema2000Slope
        engine.w03Store.ema3000RootSlot       := ema3000Slot
        engine.w03Store.ema3000ExpectedRootId := ema3000Id
        engine.w03Store.ema3000SlopeDir       := ema3000Slope
        engine.w03Store.accum1hCandidateActive := nextAccum1hCandidateActive
        engine.w03Store.accum1hCandidateStartTime := nextAccum1hCandidateStartTime
        engine.w03Store.accum1hCandidateTop := nextAccum1hCandidateTop
        engine.w03Store.accum1hCandidateBottom := nextAccum1hCandidateBottom
        engine.w03Store.accum4hCandidateActive := nextAccum4hCandidateActive
        engine.w03Store.accum4hCandidateStartTime := nextAccum4hCandidateStartTime
        engine.w03Store.accum4hCandidateTop := nextAccum4hCandidateTop
        engine.w03Store.accum4hCandidateBottom := nextAccum4hCandidateBottom
        engine.w03Store.accumDCandidateActive := nextAccumDCandidateActive
        engine.w03Store.accumDCandidateStartTime := nextAccumDCandidateStartTime
        engine.w03Store.accumDCandidateTop := nextAccumDCandidateTop
        engine.w03Store.accumDCandidateBottom := nextAccumDCandidateBottom
        engine.w03Store.timeHlSessionKind := nextTimeHlSessionKind
        engine.w03Store.timeHlSessionStartTime := nextTimeHlSessionStartTime
        engine.w03Store.timeHlDayStartTime := nextTimeHlDayStartTime
        engine.w03Store.timeHlWeekStartTime := nextTimeHlWeekStartTime
        engine.w03Store.curSessionHighRootSlot       := curSessionHighSlot
        engine.w03Store.curSessionHighExpectedRootId := curSessionHighId
        engine.w03Store.curSessionLowRootSlot       := curSessionLowSlot
        engine.w03Store.curSessionLowExpectedRootId := curSessionLowId
        engine.w03Store.lastSessionHighRootSlot       := lastSessionHighSlot
        engine.w03Store.lastSessionHighExpectedRootId := lastSessionHighId
        engine.w03Store.lastSessionLowRootSlot       := lastSessionLowSlot
        engine.w03Store.lastSessionLowExpectedRootId := lastSessionLowId
        engine.w03Store.todayHighRootSlot       := todayHighSlot
        engine.w03Store.todayHighExpectedRootId := todayHighId
        engine.w03Store.todayLowRootSlot       := todayLowSlot
        engine.w03Store.todayLowExpectedRootId := todayLowId
        engine.w03Store.prevDayHighRootSlot       := prevDayHighSlot
        engine.w03Store.prevDayHighExpectedRootId := prevDayHighId
        engine.w03Store.prevDayLowRootSlot       := prevDayLowSlot
        engine.w03Store.prevDayLowExpectedRootId := prevDayLowId
        engine.w03Store.curWeekHighRootSlot       := curWeekHighSlot
        engine.w03Store.curWeekHighExpectedRootId := curWeekHighId
        engine.w03Store.curWeekLowRootSlot       := curWeekLowSlot
        engine.w03Store.curWeekLowExpectedRootId := curWeekLowId
        engine.w03Store.prevWeekHighRootSlot       := prevWeekHighSlot
        engine.w03Store.prevWeekHighExpectedRootId := prevWeekHighId
        engine.w03Store.prevWeekLowRootSlot       := prevWeekLowSlot
        engine.w03Store.prevWeekLowExpectedRootId := prevWeekLowId
        engine.w03Store.nextAccumPairKey := pairKeyNext
    ok
sourceAdoptableRaw(int sourceOpenTime, int sourceCloseTime, int lastConsumedCloseTime, int baseCloseTime) =>
    not na(sourceOpenTime) and not na(sourceCloseTime) and not na(baseCloseTime) and baseCloseTime >= sourceCloseTime and (na(lastConsumedCloseTime) or sourceCloseTime > lastConsumedCloseTime)
maSlopeDirRaw(float rawSlope) =>
    int dir = int(na)
    if not na(rawSlope)
        dir := rawSlope > 0 ? 1 : rawSlope < 0 ? -1 : 0
    dir
w03StageEMaRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed) =>
    bool usable  = cfg.useMa and not na(feed.maSourceOpenTime) and not na(feed.maSourceCloseTime) and not na(feed.baseCloseTime) and feed.maSourceCloseTime <= feed.baseCloseTime and not na(feed.mintick) and feed.mintick > 0
    bool stopped = false
    int  k = 0
    while usable and not stopped and k < 2
        int   subtype  = k == 0 ? SUB_MA_EMA2000 : SUB_MA_EMA3000
        float emaPrice = k == 0 ? feed.ema2000 : feed.ema3000
        float rawSlope = k == 0 ? feed.ema2000Slope : feed.ema3000Slope
        int   oldSlope = k == 0 ? engine.w03Store.ema2000SlopeDir : engine.w03Store.ema3000SlopeDir
        if not na(emaPrice)
            int pointTick = int(math.round(emaPrice / feed.mintick))
            int originKey = originKeyComputeRaw(CAT_MA, subtype, TF_1M, pointTick, feed.maSourceOpenTime, FVG_NONE)
            int newSlope  = maSlopeDirRaw(rawSlope)
            [rootSlot, pendingRow] = originLookupUniqueRaw(engine, originKey, CAT_MA, subtype, TF_1M, pointTick, feed.maSourceOpenTime, int(na), FVG_NONE, feed.mintick)
            if engine.w03Store.journalInvariantViolation
                stopped := true
            else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                int newRow = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_MA, subtype, TF_1M, originKey, feed.maSourceOpenTime, int(na), feed.maSourceCloseTime, emaPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, SWING_TF_MASK_NONE, ID_NONE, newSlope)
            else if rootSlot != SLOT_INVALID and pendingRow == SLOT_INVALID
                int  expectedRootId   = array.get(engine.rootIds, rootSlot)
                bool priceChanged     = array.get(engine.rootPointPrices, rootSlot) != emaPrice
                bool slopeChanged     = (na(oldSlope) and not na(newSlope)) or (not na(oldSlope) and na(newSlope)) or (not na(oldSlope) and not na(newSlope) and oldSlope != newSlope)
                bool openTimeChanged  = array.get(engine.rootOriginTimes, rootSlot) != feed.maSourceOpenTime
                bool closeTimeChanged = array.get(engine.rootConfirmedTimes, rootSlot) != feed.maSourceCloseTime
                if priceChanged or slopeChanged or openTimeChanged or closeTimeChanged
                    int updateRow = journalAppendRaw(engine, JOP_MA_UPDATE, JGROUP_E3, rootSlot, expectedRootId, CAT_MA, subtype, TF_1M, originKey, feed.maSourceOpenTime, int(na), feed.maSourceCloseTime, emaPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, SWING_TF_MASK_NONE, ID_NONE, newSlope)
        k += 1
    true
w03StageESwingRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed, int nextLastConsumed15mSwingCloseTime, int nextLastConsumed1hSwingCloseTime) =>
    int  out15m   = nextLastConsumed15mSwingCloseTime
    int  out1h    = nextLastConsumed1hSwingCloseTime
    bool stopped  = not cfg.useSwing
    bool adopt15m = false
    bool adopt1h  = false
    int  e = 0
    while not stopped and e < 6
        if e == 2
            adopt15m := sourceAdoptableRaw(feed.src15mOpenTime, feed.src15mCloseTime, nextLastConsumed15mSwingCloseTime, feed.baseCloseTime)
            if adopt15m
                out15m := feed.src15mCloseTime
        if e == 4
            adopt1h := sourceAdoptableRaw(feed.src1hOpenTime, feed.src1hCloseTime, nextLastConsumed1hSwingCloseTime, feed.baseCloseTime)
            if adopt1h
                out1h := feed.src1hCloseTime
        bool  sourceOk      = e < 2 or (e < 4 and adopt15m) or (e >= 4 and adopt1h)
        int   subtype       = e % 2 == 0 ? SUB_SWING_HIGH : SUB_SWING_LOW
        int   tfCode        = e < 2 ? TF_5M : e < 4 ? TF_15M : TF_1H
        int   tfMask        = e < 2 ? SWING_TF_MASK_5M : e < 4 ? SWING_TF_MASK_15M : SWING_TF_MASK_1H
        float pointPrice    = e == 0 ? feed.swing5mHighPrice         : e == 1 ? feed.swing5mLowPrice         : e == 2 ? feed.swing15mHighPrice         : e == 3 ? feed.swing15mLowPrice         : e == 4 ? feed.swing1hHighPrice         : feed.swing1hLowPrice
        int   originTime    = e == 0 ? feed.swing5mHighOriginTime    : e == 1 ? feed.swing5mLowOriginTime    : e == 2 ? feed.swing15mHighOriginTime    : e == 3 ? feed.swing15mLowOriginTime    : e == 4 ? feed.swing1hHighOriginTime    : feed.swing1hLowOriginTime
        int   originEndTime = e == 0 ? feed.swing5mHighOriginEndTime : e == 1 ? feed.swing5mLowOriginEndTime : e == 2 ? feed.swing15mHighOriginEndTime : e == 3 ? feed.swing15mLowOriginEndTime : e == 4 ? feed.swing1hHighOriginEndTime : feed.swing1hLowOriginEndTime
        int   confirmedTime = e == 0 ? feed.swing5mHighConfirmedTime : e == 1 ? feed.swing5mLowConfirmedTime : e == 2 ? feed.swing15mHighConfirmedTime : e == 3 ? feed.swing15mLowConfirmedTime : e == 4 ? feed.swing1hHighConfirmedTime : feed.swing1hLowConfirmedTime
        bool usable = sourceOk and not na(pointPrice) and not na(originTime) and not na(originEndTime) and not na(confirmedTime) and not na(feed.baseCloseTime) and confirmedTime <= feed.baseCloseTime and not na(feed.mintick) and feed.mintick > 0
        if usable
            int pointTick = int(math.round(pointPrice / feed.mintick))
            int originKey = originKeyComputeRaw(CAT_SWING, subtype, tfCode, pointTick, originTime, FVG_NONE)
            [rootSlot, pendingRow] = originLookupUniqueRaw(engine, originKey, CAT_SWING, subtype, tfCode, pointTick, originTime, originEndTime, FVG_NONE, feed.mintick)
            if engine.w03Store.journalInvariantViolation
                stopped := true
            else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                int newRow = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_SWING, subtype, tfCode, originKey, originTime, originEndTime, confirmedTime, pointPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, tfMask, ID_NONE, int(na))
            else
                int targetSlot  = SLOT_INVALID
                int targetId    = ID_NONE
                int virtualMask = int(na)
                if rootSlot != SLOT_INVALID
                    targetSlot  := rootSlot
                    targetId    := array.get(engine.rootIds, rootSlot)
                    virtualMask := array.get(engine.w03Store.rootSwingTfMasks, rootSlot)
                else
                    targetSlot  := predictedNewRootSlotRaw(engine, pendingRow)
                    targetId    := predictedNewRootIdRaw(engine, pendingRow)
                    virtualMask := array.get(engine.w03Store.journalNewMasks, pendingRow)
                int row = 0
                while row < engine.w03Store.journalCount
                    if array.get(engine.w03Store.journalOps, row) == JOP_SWING_TF_MERGE and array.get(engine.w03Store.journalTargetRootSlots, row) == targetSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == targetId
                        virtualMask := array.get(engine.w03Store.journalNewMasks, row)
                    row += 1
                bool bitOn = int(math.floor(virtualMask / tfMask)) % 2 == 1
                if not bitOn
                    int mergeRow = journalAppendRaw(engine, JOP_SWING_TF_MERGE, JGROUP_E3, targetSlot, targetId, CAT_SWING, subtype, tfCode, originKey, originTime, originEndTime, confirmedTime, pointPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, virtualMask, virtualMask + tfMask, ID_NONE, int(na))
        e += 1
    [true, out15m, out1h]
w03StageEAccumRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed, int nextLastConsumed1hAccumCloseTime, int nextLastConsumed4hAccumCloseTime, int nextLastConsumedDAccumCloseTime, bool nextAccum1hCandidateActive, int nextAccum1hCandidateStartTime, float nextAccum1hCandidateTop, float nextAccum1hCandidateBottom, bool nextAccum4hCandidateActive, int nextAccum4hCandidateStartTime, float nextAccum4hCandidateTop, float nextAccum4hCandidateBottom, bool nextAccumDCandidateActive, int nextAccumDCandidateStartTime, float nextAccumDCandidateTop, float nextAccumDCandidateBottom) =>
    int   outLastConsumed1hAccumCloseTime = nextLastConsumed1hAccumCloseTime
    int   outLastConsumed4hAccumCloseTime = nextLastConsumed4hAccumCloseTime
    int   outLastConsumedDAccumCloseTime  = nextLastConsumedDAccumCloseTime
    bool  outAccum1hCandidateActive       = nextAccum1hCandidateActive
    int   outAccum1hCandidateStartTime    = nextAccum1hCandidateStartTime
    float outAccum1hCandidateTop          = nextAccum1hCandidateTop
    float outAccum1hCandidateBottom       = nextAccum1hCandidateBottom
    bool  outAccum4hCandidateActive       = nextAccum4hCandidateActive
    int   outAccum4hCandidateStartTime    = nextAccum4hCandidateStartTime
    float outAccum4hCandidateTop          = nextAccum4hCandidateTop
    float outAccum4hCandidateBottom       = nextAccum4hCandidateBottom
    bool  outAccumDCandidateActive        = nextAccumDCandidateActive
    int   outAccumDCandidateStartTime     = nextAccumDCandidateStartTime
    float outAccumDCandidateTop           = nextAccumDCandidateTop
    float outAccumDCandidateBottom        = nextAccumDCandidateBottom
    int   pairKeyCursor = engine.w03Store.nextAccumPairKey
    bool  stopped       = not cfg.useAccum
    int   t = 0
    while not stopped and t < 3
        int  tfCode      = t == 0 ? TF_1H : t == 1 ? TF_4H : TF_D
        int  srcOpen     = t == 0 ? feed.src1hOpenTime  : t == 1 ? feed.src4hOpenTime  : feed.srcDOpenTime
        int  srcClose    = t == 0 ? feed.src1hCloseTime : t == 1 ? feed.src4hCloseTime : feed.srcDCloseTime
        int  lastClose   = t == 0 ? outLastConsumed1hAccumCloseTime : t == 1 ? outLastConsumed4hAccumCloseTime : outLastConsumedDAccumCloseTime
        bool adopted     = sourceAdoptableRaw(srcOpen, srcClose, lastClose, feed.baseCloseTime)
        if adopted
            if t == 0
                outLastConsumed1hAccumCloseTime := feed.src1hCloseTime
                outAccum1hCandidateActive       := feed.accum1hCandidateActive
                outAccum1hCandidateStartTime    := feed.accum1hCandidateStartTime
                outAccum1hCandidateTop          := feed.accum1hCandidateTop
                outAccum1hCandidateBottom       := feed.accum1hCandidateBottom
            else if t == 1
                outLastConsumed4hAccumCloseTime := feed.src4hCloseTime
                outAccum4hCandidateActive       := feed.accum4hCandidateActive
                outAccum4hCandidateStartTime    := feed.accum4hCandidateStartTime
                outAccum4hCandidateTop          := feed.accum4hCandidateTop
                outAccum4hCandidateBottom       := feed.accum4hCandidateBottom
            else
                outLastConsumedDAccumCloseTime := feed.srcDCloseTime
                outAccumDCandidateActive       := feed.accumDCandidateActive
                outAccumDCandidateStartTime    := feed.accumDCandidateStartTime
                outAccumDCandidateTop          := feed.accumDCandidateTop
                outAccumDCandidateBottom       := feed.accumDCandidateBottom
            bool  newBox        = t == 0 ? feed.accum1hNewConfirmedBox    : t == 1 ? feed.accum4hNewConfirmedBox    : feed.accumDNewConfirmedBox
            float boxTop        = t == 0 ? feed.accum1hBoxTop             : t == 1 ? feed.accum4hBoxTop             : feed.accumDBoxTop
            float boxBottom     = t == 0 ? feed.accum1hBoxBottom          : t == 1 ? feed.accum4hBoxBottom          : feed.accumDBoxBottom
            int   startTime     = t == 0 ? feed.accum1hCandidateStartTime : t == 1 ? feed.accum4hCandidateStartTime : feed.accumDCandidateStartTime
            int   confirmedTime = t == 0 ? feed.accum1hConfirmedTime      : t == 1 ? feed.accum4hConfirmedTime      : feed.accumDConfirmedTime
            bool  usable = newBox and not na(boxTop) and not na(boxBottom) and not na(startTime) and not na(confirmedTime) and not na(feed.baseCloseTime) and confirmedTime <= feed.baseCloseTime and not na(feed.mintick) and feed.mintick > 0
            if usable
                int upperTick = int(math.round(boxTop    / feed.mintick))
                int lowerTick = int(math.round(boxBottom / feed.mintick))
                int upperKey  = originKeyComputeRaw(CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperTick, startTime, FVG_NONE)
                int lowerKey  = originKeyComputeRaw(CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerTick, startTime, FVG_NONE)
                [upperSlot, upperPending] = originLookupUniqueRaw(engine, upperKey, CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperTick, startTime, int(na), FVG_NONE, feed.mintick)
                int lowerSlot    = SLOT_INVALID
                int lowerPending = SLOT_INVALID
                if not engine.w03Store.journalInvariantViolation
                    [lSlot, lPending] = originLookupUniqueRaw(engine, lowerKey, CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerTick, startTime, int(na), FVG_NONE, feed.mintick)
                    lowerSlot    := lSlot
                    lowerPending := lPending
                if engine.w03Store.journalInvariantViolation
                    stopped := true
                else
                    bool upperFound = upperSlot != SLOT_INVALID or upperPending != SLOT_INVALID
                    bool lowerFound = lowerSlot != SLOT_INVALID or lowerPending != SLOT_INVALID
                    if not upperFound and not lowerFound
                        int pairKey  = pairKeyCursor
                        int upperRow = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperKey, startTime, int(na), confirmedTime, boxTop, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, 0, 0, pairKey, int(na))
                        int lowerRow = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerKey, startTime, int(na), confirmedTime, boxBottom, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, 0, 0, pairKey, int(na))
                        pairKeyCursor += 1
                    else if upperFound and lowerFound
                        int upperPair = ID_NONE
                        int lowerPair = ID_NONE
                        if upperSlot != SLOT_INVALID
                            upperPair := array.get(engine.rootPairKeys, upperSlot)
                        else
                            upperPair := array.get(engine.w03Store.journalPairKeys, upperPending)
                        if lowerSlot != SLOT_INVALID
                            lowerPair := array.get(engine.rootPairKeys, lowerSlot)
                        else
                            lowerPair := array.get(engine.w03Store.journalPairKeys, lowerPending)
                        if na(upperPair) or na(lowerPair) or upperPair == ID_NONE or upperPair != lowerPair
                            engine.w03Store.journalInvariantViolation := true
                            stopped := true
                    else
                        engine.w03Store.journalInvariantViolation := true
                        stopped := true
        t += 1
    [true, outLastConsumed1hAccumCloseTime, outLastConsumed4hAccumCloseTime, outLastConsumedDAccumCloseTime, outAccum1hCandidateActive, outAccum1hCandidateStartTime, outAccum1hCandidateTop, outAccum1hCandidateBottom, outAccum4hCandidateActive, outAccum4hCandidateStartTime, outAccum4hCandidateTop, outAccum4hCandidateBottom, outAccumDCandidateActive, outAccumDCandidateStartTime, outAccumDCandidateTop, outAccumDCandidateBottom]
const int TIMEHL_SESSION_NONE   = 0   // unset, or no current session
const int TIMEHL_SESSION_ASIA   = 1
const int TIMEHL_SESSION_EUROPE = 2
const int TIMEHL_SESSION_NY     = 3
timeHlPeriodKeysRaw(ZoneCfg cfg, int baseOpenTime) =>
    int sessionKind      = TIMEHL_SESSION_NONE
    int sessionStartTime = int(na)
    int dayStartTime     = int(na)
    int weekStartTime    = int(na)
    if not na(baseOpenTime)
        int localYear  = year(baseOpenTime, cfg.zoneTimezone)
        int localMonth = month(baseOpenTime, cfg.zoneTimezone)
        int localDay   = dayofmonth(baseOpenTime, cfg.zoneTimezone)
        int localDow   = dayofweek(baseOpenTime, cfg.zoneTimezone)
        int localHour  = hour(baseOpenTime, cfg.zoneTimezone)
        if localHour >= cfg.asiaStartHour and localHour < cfg.asiaEndHour
            sessionKind      := TIMEHL_SESSION_ASIA
            sessionStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay, cfg.asiaStartHour, 0, 0)
        else if localHour >= cfg.europeStartHour and localHour < cfg.europeEndHour
            sessionKind      := TIMEHL_SESSION_EUROPE
            sessionStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay, cfg.europeStartHour, 0, 0)
        else if localHour >= cfg.nyStartHour or localHour < cfg.nyEndHour
            sessionKind := TIMEHL_SESSION_NY
            if localHour >= cfg.nyStartHour
                sessionStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay, cfg.nyStartHour, 0, 0)
            else
                sessionStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay - 1, cfg.nyStartHour, 0, 0)
        int sameDayStart = timestamp(cfg.zoneTimezone, localYear, localMonth, localDay, cfg.dayBoundaryHour, 0, 0)
        if baseOpenTime >= sameDayStart
            dayStartTime := sameDayStart
        else
            dayStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay - 1, cfg.dayBoundaryHour, 0, 0)
        int daysBack      = (localDow - cfg.weekBoundaryDow + 7) % 7
        int weekCandidate = timestamp(cfg.zoneTimezone, localYear, localMonth, localDay - daysBack, cfg.weekBoundaryHour, 0, 0)
        if baseOpenTime >= weekCandidate
            weekStartTime := weekCandidate
        else
            weekStartTime := timestamp(cfg.zoneTimezone, localYear, localMonth, localDay - daysBack - 7, cfg.weekBoundaryHour, 0, 0)
    [sessionKind, sessionStartTime, dayStartTime, weekStartTime]
timeHlVirtualMaskNowRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int pendingNewRow) =>
    int  mask = int(na)
    bool ok   = false
    if pendingNewRow == SLOT_INVALID
        if rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootCategories) and rootSlot < array.size(engine.rootTfCodes) and rootSlot < array.size(engine.rootStates) and rootSlot < array.size(engine.rootLabelMasks)
            if array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) == expectedRootId and array.get(engine.rootCategories, rootSlot) == CAT_TIME_HL and array.get(engine.rootTfCodes, rootSlot) == TF_5M and array.get(engine.rootStates, rootSlot) == ROOT_ACTIVE
                mask := array.get(engine.rootLabelMasks, rootSlot)
                ok   := true
    else
        if pendingNewRow >= 0 and pendingNewRow < engine.w03Store.journalCount
            if array.get(engine.w03Store.journalOps, pendingNewRow) == JOP_NEW_ROOT and array.get(engine.w03Store.journalGroups, pendingNewRow) == JGROUP_E2 and array.get(engine.w03Store.journalCategories, pendingNewRow) == CAT_TIME_HL
                if predictedNewRootSlotRaw(engine, pendingNewRow) == rootSlot and predictedNewRootIdRaw(engine, pendingNewRow) == expectedRootId
                    mask := array.get(engine.w03Store.journalNewMasks, pendingNewRow)
                    ok   := true
    if ok
        int row = 0
        while row < engine.w03Store.journalCount
            if array.get(engine.w03Store.journalOps, row) == JOP_TIMEHL_LABEL and array.get(engine.w03Store.journalTargetRootSlots, row) == rootSlot and array.get(engine.w03Store.journalExpectedRootIds, row) == expectedRootId
                mask := array.get(engine.w03Store.journalNewMasks, row)
            row += 1
    mask
w03StageETimeHlRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed, int nextTimeHlSessionKind, int nextTimeHlSessionStartTime, int nextTimeHlDayStartTime, int nextTimeHlWeekStartTime) =>
    int  outTimeHlSessionKind      = nextTimeHlSessionKind
    int  outTimeHlSessionStartTime = nextTimeHlSessionStartTime
    int  outTimeHlDayStartTime     = nextTimeHlDayStartTime
    int  outTimeHlWeekStartTime    = nextTimeHlWeekStartTime
    bool usable  = cfg.useTimeHl and not na(feed.baseOpenTime) and not na(feed.baseCloseTime) and not na(feed.baseHigh) and not na(feed.baseLow) and not na(feed.mintick) and feed.mintick > 0
    bool stopped = not usable
    if usable
        [currentSessionKind, currentSessionStartTime, currentDayStartTime, currentWeekStartTime] = timeHlPeriodKeysRaw(cfg, feed.baseOpenTime)
        array<int> planRootSlots       = array.new_int(0)
        array<int> planExpectedRootIds = array.new_int(0)
        array<int> planPendingNewRows  = array.new_int(0)
        array<int> planInitialMasks    = array.new_int(0)
        array<int> planFinalMasks      = array.new_int(0)
        array<int> planSubtypes        = array.new_int(0)
        int curSessionHighSlot = engine.w03Store.curSessionHighRootSlot
        int curSessionHighId   = engine.w03Store.curSessionHighExpectedRootId
        int curSessionLowSlot = engine.w03Store.curSessionLowRootSlot
        int curSessionLowId   = engine.w03Store.curSessionLowExpectedRootId
        int lastSessionHighSlot = engine.w03Store.lastSessionHighRootSlot
        int lastSessionHighId   = engine.w03Store.lastSessionHighExpectedRootId
        int lastSessionLowSlot = engine.w03Store.lastSessionLowRootSlot
        int lastSessionLowId   = engine.w03Store.lastSessionLowExpectedRootId
        int todayHighSlot = engine.w03Store.todayHighRootSlot
        int todayHighId   = engine.w03Store.todayHighExpectedRootId
        int todayLowSlot = engine.w03Store.todayLowRootSlot
        int todayLowId   = engine.w03Store.todayLowExpectedRootId
        int prevDayHighSlot = engine.w03Store.prevDayHighRootSlot
        int prevDayHighId   = engine.w03Store.prevDayHighExpectedRootId
        int prevDayLowSlot = engine.w03Store.prevDayLowRootSlot
        int prevDayLowId   = engine.w03Store.prevDayLowExpectedRootId
        int curWeekHighSlot = engine.w03Store.curWeekHighRootSlot
        int curWeekHighId   = engine.w03Store.curWeekHighExpectedRootId
        int curWeekLowSlot = engine.w03Store.curWeekLowRootSlot
        int curWeekLowId   = engine.w03Store.curWeekLowExpectedRootId
        int prevWeekHighSlot = engine.w03Store.prevWeekHighRootSlot
        int prevWeekHighId   = engine.w03Store.prevWeekHighExpectedRootId
        int prevWeekLowSlot = engine.w03Store.prevWeekLowRootSlot
        int prevWeekLowId   = engine.w03Store.prevWeekLowExpectedRootId
        int k = 0
        while not stopped and k < 12
            int refSlot = k == 0 ? curSessionHighSlot : k == 1 ? curSessionLowSlot : k == 2 ? lastSessionHighSlot : k == 3 ? lastSessionLowSlot : k == 4 ? todayHighSlot : k == 5 ? todayLowSlot : k == 6 ? prevDayHighSlot : k == 7 ? prevDayLowSlot : k == 8 ? curWeekHighSlot : k == 9 ? curWeekLowSlot : k == 10 ? prevWeekHighSlot : prevWeekLowSlot
            int refId   = k == 0 ? curSessionHighId : k == 1 ? curSessionLowId : k == 2 ? lastSessionHighId : k == 3 ? lastSessionLowId : k == 4 ? todayHighId : k == 5 ? todayLowId : k == 6 ? prevDayHighId : k == 7 ? prevDayLowId : k == 8 ? curWeekHighId : k == 9 ? curWeekLowId : k == 10 ? prevWeekHighId : prevWeekLowId
            if (refSlot == SLOT_INVALID) != (refId == ID_NONE)
                engine.w03Store.journalInvariantViolation := true
                stopped := true
            k += 1
        bool weekChanged    = na(nextTimeHlWeekStartTime) or nextTimeHlWeekStartTime != currentWeekStartTime
        bool dayChanged     = na(nextTimeHlDayStartTime) or nextTimeHlDayStartTime != currentDayStartTime
        bool sessionChanged = nextTimeHlSessionKind != currentSessionKind or na(nextTimeHlSessionStartTime) != na(currentSessionStartTime) or (not na(nextTimeHlSessionStartTime) and not na(currentSessionStartTime) and nextTimeHlSessionStartTime != currentSessionStartTime)
        bool weekRoll    = weekChanged and not na(nextTimeHlWeekStartTime)
        bool dayRoll     = dayChanged and not na(nextTimeHlDayStartTime)
        bool sessionRoll = sessionChanged and nextTimeHlSessionKind != TIMEHL_SESSION_NONE and not na(nextTimeHlSessionStartTime)
        int s = 0
        while not stopped and s < 12
            int  period   = int(math.floor(s / 4))
            int  side     = int(math.floor((s % 4) / 2))
            int  part     = s % 2
            bool doRoll   = period == 0 ? weekRoll : period == 1 ? dayRoll : sessionRoll
            int  curLabel = period == 0 ? 4 : period == 1 ? 2 : 0
            int  curBit   = period == 0 ? TIMEHL_LABEL_CUR_WEEK : period == 1 ? TIMEHL_LABEL_TODAY : TIMEHL_LABEL_CUR_SESSION
            int  prevBit  = period == 0 ? TIMEHL_LABEL_PREV_WEEK : period == 1 ? TIMEHL_LABEL_PREV_DAY : TIMEHL_LABEL_LAST_SESSION
            if doRoll
                int kRef      = (part == 0 ? curLabel + 1 : curLabel) * 2 + side
                int tSub      = side == 0 ? SUB_TIMEHL_HIGH : SUB_TIMEHL_LOW
                int removeBit = part == 0 ? prevBit : curBit
                int addBit    = part == 0 ? 0 : prevBit
                int tSlot     = kRef == 0 ? curSessionHighSlot : kRef == 1 ? curSessionLowSlot : kRef == 2 ? lastSessionHighSlot : kRef == 3 ? lastSessionLowSlot : kRef == 4 ? todayHighSlot : kRef == 5 ? todayLowSlot : kRef == 6 ? prevDayHighSlot : kRef == 7 ? prevDayLowSlot : kRef == 8 ? curWeekHighSlot : kRef == 9 ? curWeekLowSlot : kRef == 10 ? prevWeekHighSlot : prevWeekLowSlot
                int tId       = kRef == 0 ? curSessionHighId : kRef == 1 ? curSessionLowId : kRef == 2 ? lastSessionHighId : kRef == 3 ? lastSessionLowId : kRef == 4 ? todayHighId : kRef == 5 ? todayLowId : kRef == 6 ? prevDayHighId : kRef == 7 ? prevDayLowId : kRef == 8 ? curWeekHighId : kRef == 9 ? curWeekLowId : kRef == 10 ? prevWeekHighId : prevWeekLowId
                if not (tSlot == SLOT_INVALID and tId == ID_NONE)
                    int pIdx = SLOT_INVALID
                    int pIdxI = 0
                    while pIdx == SLOT_INVALID and pIdxI < array.size(planRootSlots)
                        if array.get(planRootSlots, pIdxI) == tSlot and array.get(planExpectedRootIds, pIdxI) == tId
                            pIdx := pIdxI
                        pIdxI += 1
                    int  curMask = int(na)
                    bool valid   = true
                    if pIdx == SLOT_INVALID
                        int tPending = SLOT_INVALID
                        curMask := timeHlVirtualMaskNowRaw(engine, tSlot, tId, tPending)
                        valid   := not na(curMask)
                        if valid
                            if tPending == SLOT_INVALID
                                valid := tSlot < array.size(engine.rootSubtypes)
                                if valid
                                    valid := array.get(engine.rootSubtypes, tSlot) == tSub
                            else
                                valid := array.get(engine.w03Store.journalSubtypes, tPending) == tSub
                        if valid
                            array.push(planRootSlots,       tSlot)
                            array.push(planExpectedRootIds, tId)
                            array.push(planPendingNewRows,  tPending)
                            array.push(planInitialMasks,    curMask)
                            array.push(planFinalMasks,      curMask)
                            array.push(planSubtypes,        tSub)
                            pIdx := array.size(planRootSlots) - 1
                    else
                        curMask := array.get(planFinalMasks, pIdx)
                        valid   := array.get(planSubtypes, pIdx) == tSub
                    if valid and removeBit > 0
                        valid := int(math.floor(curMask / removeBit)) % 2 == 1
                    if valid and addBit > 0
                        valid := int(math.floor((curMask - removeBit) / addBit)) % 2 == 0
                    if valid
                        array.set(planFinalMasks, pIdx, curMask - removeBit + addBit)
                    else
                        engine.w03Store.journalInvariantViolation := true
                        stopped := true
                if not stopped and part == 1
                    int kPrev = (curLabel + 1) * 2 + side
                    if kPrev == 0
                        curSessionHighSlot := tSlot
                        curSessionHighId   := tId
                    else if kPrev == 1
                        curSessionLowSlot := tSlot
                        curSessionLowId   := tId
                    else if kPrev == 2
                        lastSessionHighSlot := tSlot
                        lastSessionHighId   := tId
                    else if kPrev == 3
                        lastSessionLowSlot := tSlot
                        lastSessionLowId   := tId
                    else if kPrev == 4
                        todayHighSlot := tSlot
                        todayHighId   := tId
                    else if kPrev == 5
                        todayLowSlot := tSlot
                        todayLowId   := tId
                    else if kPrev == 6
                        prevDayHighSlot := tSlot
                        prevDayHighId   := tId
                    else if kPrev == 7
                        prevDayLowSlot := tSlot
                        prevDayLowId   := tId
                    else if kPrev == 8
                        curWeekHighSlot := tSlot
                        curWeekHighId   := tId
                    else if kPrev == 9
                        curWeekLowSlot := tSlot
                        curWeekLowId   := tId
                    else if kPrev == 10
                        prevWeekHighSlot := tSlot
                        prevWeekHighId   := tId
                    else if kPrev == 11
                        prevWeekLowSlot := tSlot
                        prevWeekLowId   := tId
                    if kRef == 0
                        curSessionHighSlot := SLOT_INVALID
                        curSessionHighId   := ID_NONE
                    else if kRef == 1
                        curSessionLowSlot := SLOT_INVALID
                        curSessionLowId   := ID_NONE
                    else if kRef == 2
                        lastSessionHighSlot := SLOT_INVALID
                        lastSessionHighId   := ID_NONE
                    else if kRef == 3
                        lastSessionLowSlot := SLOT_INVALID
                        lastSessionLowId   := ID_NONE
                    else if kRef == 4
                        todayHighSlot := SLOT_INVALID
                        todayHighId   := ID_NONE
                    else if kRef == 5
                        todayLowSlot := SLOT_INVALID
                        todayLowId   := ID_NONE
                    else if kRef == 6
                        prevDayHighSlot := SLOT_INVALID
                        prevDayHighId   := ID_NONE
                    else if kRef == 7
                        prevDayLowSlot := SLOT_INVALID
                        prevDayLowId   := ID_NONE
                    else if kRef == 8
                        curWeekHighSlot := SLOT_INVALID
                        curWeekHighId   := ID_NONE
                    else if kRef == 9
                        curWeekLowSlot := SLOT_INVALID
                        curWeekLowId   := ID_NONE
                    else if kRef == 10
                        prevWeekHighSlot := SLOT_INVALID
                        prevWeekHighId   := ID_NONE
                    else if kRef == 11
                        prevWeekLowSlot := SLOT_INVALID
                        prevWeekLowId   := ID_NONE
            s += 1
        int baseHighTick = int(math.round(feed.baseHigh / feed.mintick))
        int baseLowTick  = int(math.round(feed.baseLow  / feed.mintick))
        int newHighMask  = 0
        int newLowMask   = 0
        int c = 0
        while not stopped and c < 6
            int side     = int(math.floor(c / 3))
            int which    = c % 3
            int curLabel = which == 0 ? 0 : which == 1 ? 2 : 4
            int curBit   = which == 0 ? TIMEHL_LABEL_CUR_SESSION : which == 1 ? TIMEHL_LABEL_TODAY : TIMEHL_LABEL_CUR_WEEK
            if which > 0 or currentSessionKind != TIMEHL_SESSION_NONE
                int kRef  = curLabel * 2 + side
                int tSlot = kRef == 0 ? curSessionHighSlot : kRef == 1 ? curSessionLowSlot : kRef == 2 ? lastSessionHighSlot : kRef == 3 ? lastSessionLowSlot : kRef == 4 ? todayHighSlot : kRef == 5 ? todayLowSlot : kRef == 6 ? prevDayHighSlot : kRef == 7 ? prevDayLowSlot : kRef == 8 ? curWeekHighSlot : kRef == 9 ? curWeekLowSlot : kRef == 10 ? prevWeekHighSlot : prevWeekLowSlot
                int tId   = kRef == 0 ? curSessionHighId : kRef == 1 ? curSessionLowId : kRef == 2 ? lastSessionHighId : kRef == 3 ? lastSessionLowId : kRef == 4 ? todayHighId : kRef == 5 ? todayLowId : kRef == 6 ? prevDayHighId : kRef == 7 ? prevDayLowId : kRef == 8 ? curWeekHighId : kRef == 9 ? curWeekLowId : kRef == 10 ? prevWeekHighId : prevWeekLowId
                bool isNew = false
                if tSlot == SLOT_INVALID and tId == ID_NONE
                    isNew := true
                else
                    int curMask = timeHlVirtualMaskNowRaw(engine, tSlot, tId, SLOT_INVALID)
                    int cIdx = SLOT_INVALID
                    int cIdxI = 0
                    while cIdx == SLOT_INVALID and cIdxI < array.size(planRootSlots)
                        if array.get(planRootSlots, cIdxI) == tSlot and array.get(planExpectedRootIds, cIdxI) == tId
                            cIdx := cIdxI
                        cIdxI += 1
                    if cIdx != SLOT_INVALID
                        curMask := array.get(planFinalMasks, cIdx)
                    bool valid = not na(curMask)
                    if valid
                        valid := tSlot < array.size(engine.rootSubtypes) and tSlot < array.size(engine.rootPointTicks)
                    if valid
                        valid := array.get(engine.rootSubtypes, tSlot) == (side == 0 ? SUB_TIMEHL_HIGH : SUB_TIMEHL_LOW) and int(math.floor(curMask / curBit)) % 2 == 1 and not na(array.get(engine.rootPointTicks, tSlot))
                    if valid
                        int refTick = array.get(engine.rootPointTicks, tSlot)
                        isNew := side == 0 ? baseHighTick > refTick : baseLowTick < refTick
                    else
                        engine.w03Store.journalInvariantViolation := true
                        stopped := true
                if not stopped and isNew
                    if side == 0
                        newHighMask += curBit
                    else
                        newLowMask += curBit
            c += 1
        int eventSlot = SLOT_INVALID
        int eventId   = ID_NONE
        int x = 0
        while not stopped and x < 8
            int   side    = int(math.floor(x / 4))
            int   part    = x % 4
            int   evMask  = side == 0 ? newHighMask : newLowMask
            int   evSub   = side == 0 ? SUB_TIMEHL_HIGH : SUB_TIMEHL_LOW
            int   evTick  = side == 0 ? baseHighTick : baseLowTick
            float evPrice = side == 0 ? feed.baseHigh : feed.baseLow
            if evMask != 0 and part == 0
                eventSlot := SLOT_INVALID
                eventId   := ID_NONE
                int originKey = originKeyComputeRaw(CAT_TIME_HL, evSub, TF_5M, evTick, feed.baseOpenTime, FVG_NONE)
                [rootSlot, pendingRow] = originLookupUniqueRaw(engine, originKey, CAT_TIME_HL, evSub, TF_5M, evTick, feed.baseOpenTime, feed.baseCloseTime, FVG_NONE, feed.mintick)
                if engine.w03Store.journalInvariantViolation
                    stopped := true
                else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                    int newRow = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_TIME_HL, evSub, TF_5M, originKey, feed.baseOpenTime, feed.baseCloseTime, feed.baseCloseTime, evPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, 0, evMask, ID_NONE, int(na))
                else
                    int evPending = SLOT_INVALID
                    if rootSlot != SLOT_INVALID
                        eventSlot := rootSlot
                        eventId   := array.get(engine.rootIds, rootSlot)
                    else
                        evPending := pendingRow
                        eventSlot := predictedNewRootSlotRaw(engine, pendingRow)
                        eventId   := predictedNewRootIdRaw(engine, pendingRow)
                    int bitLoop = 1
                    while not stopped and bitLoop <= 16
                        if int(math.floor(evMask / bitLoop)) % 2 == 1
                            int haveMask = timeHlVirtualMaskNowRaw(engine, eventSlot, eventId, evPending)
                            int hIdx = SLOT_INVALID
                            int hIdxI = 0
                            while hIdx == SLOT_INVALID and hIdxI < array.size(planRootSlots)
                                if array.get(planRootSlots, hIdxI) == eventSlot and array.get(planExpectedRootIds, hIdxI) == eventId
                                    hIdx := hIdxI
                                hIdxI += 1
                            if hIdx != SLOT_INVALID
                                haveMask := array.get(planFinalMasks, hIdx)
                            if na(haveMask)
                                engine.w03Store.journalInvariantViolation := true
                                stopped := true
                            else if int(math.floor(haveMask / bitLoop)) % 2 == 0
                                int tSlot     = eventSlot
                                int tId       = eventId
                                int tSub      = evSub
                                int removeBit = 0
                                int addBit    = bitLoop
                                if not (tSlot == SLOT_INVALID and tId == ID_NONE)
                                    int pIdx = SLOT_INVALID
                                    int pIdxI = 0
                                    while pIdx == SLOT_INVALID and pIdxI < array.size(planRootSlots)
                                        if array.get(planRootSlots, pIdxI) == tSlot and array.get(planExpectedRootIds, pIdxI) == tId
                                            pIdx := pIdxI
                                        pIdxI += 1
                                    int  curMask = int(na)
                                    bool valid   = true
                                    if pIdx == SLOT_INVALID
                                        int tPending = evPending
                                        curMask := timeHlVirtualMaskNowRaw(engine, tSlot, tId, tPending)
                                        valid   := not na(curMask)
                                        if valid
                                            if tPending == SLOT_INVALID
                                                valid := tSlot < array.size(engine.rootSubtypes)
                                                if valid
                                                    valid := array.get(engine.rootSubtypes, tSlot) == tSub
                                            else
                                                valid := array.get(engine.w03Store.journalSubtypes, tPending) == tSub
                                        if valid
                                            array.push(planRootSlots,       tSlot)
                                            array.push(planExpectedRootIds, tId)
                                            array.push(planPendingNewRows,  tPending)
                                            array.push(planInitialMasks,    curMask)
                                            array.push(planFinalMasks,      curMask)
                                            array.push(planSubtypes,        tSub)
                                            pIdx := array.size(planRootSlots) - 1
                                    else
                                        curMask := array.get(planFinalMasks, pIdx)
                                        valid   := array.get(planSubtypes, pIdx) == tSub
                                    if valid and removeBit > 0
                                        valid := int(math.floor(curMask / removeBit)) % 2 == 1
                                    if valid and addBit > 0
                                        valid := int(math.floor((curMask - removeBit) / addBit)) % 2 == 0
                                    if valid
                                        array.set(planFinalMasks, pIdx, curMask - removeBit + addBit)
                                    else
                                        engine.w03Store.journalInvariantViolation := true
                                        stopped := true
                        bitLoop := bitLoop * 4
            else if part > 0
                int which     = part - 1
                int curLabel  = which == 0 ? 0 : which == 1 ? 2 : 4
                int removeBit = which == 0 ? TIMEHL_LABEL_CUR_SESSION : which == 1 ? TIMEHL_LABEL_TODAY : TIMEHL_LABEL_CUR_WEEK
                if int(math.floor(evMask / removeBit)) % 2 == 1
                    int kRef   = curLabel * 2 + side
                    int tSub   = evSub
                    int addBit = 0
                    int tSlot  = kRef == 0 ? curSessionHighSlot : kRef == 1 ? curSessionLowSlot : kRef == 2 ? lastSessionHighSlot : kRef == 3 ? lastSessionLowSlot : kRef == 4 ? todayHighSlot : kRef == 5 ? todayLowSlot : kRef == 6 ? prevDayHighSlot : kRef == 7 ? prevDayLowSlot : kRef == 8 ? curWeekHighSlot : kRef == 9 ? curWeekLowSlot : kRef == 10 ? prevWeekHighSlot : prevWeekLowSlot
                    int tId    = kRef == 0 ? curSessionHighId : kRef == 1 ? curSessionLowId : kRef == 2 ? lastSessionHighId : kRef == 3 ? lastSessionLowId : kRef == 4 ? todayHighId : kRef == 5 ? todayLowId : kRef == 6 ? prevDayHighId : kRef == 7 ? prevDayLowId : kRef == 8 ? curWeekHighId : kRef == 9 ? curWeekLowId : kRef == 10 ? prevWeekHighId : prevWeekLowId
                    if eventSlot != SLOT_INVALID and tSlot == eventSlot and tId == eventId
                        tSlot := SLOT_INVALID
                        tId   := ID_NONE
                    if not (tSlot == SLOT_INVALID and tId == ID_NONE)
                        int pIdx = SLOT_INVALID
                        int pIdxI = 0
                        while pIdx == SLOT_INVALID and pIdxI < array.size(planRootSlots)
                            if array.get(planRootSlots, pIdxI) == tSlot and array.get(planExpectedRootIds, pIdxI) == tId
                                pIdx := pIdxI
                            pIdxI += 1
                        int  curMask = int(na)
                        bool valid   = true
                        if pIdx == SLOT_INVALID
                            int tPending = SLOT_INVALID
                            curMask := timeHlVirtualMaskNowRaw(engine, tSlot, tId, tPending)
                            valid   := not na(curMask)
                            if valid
                                if tPending == SLOT_INVALID
                                    valid := tSlot < array.size(engine.rootSubtypes)
                                    if valid
                                        valid := array.get(engine.rootSubtypes, tSlot) == tSub
                                else
                                    valid := array.get(engine.w03Store.journalSubtypes, tPending) == tSub
                            if valid
                                array.push(planRootSlots,       tSlot)
                                array.push(planExpectedRootIds, tId)
                                array.push(planPendingNewRows,  tPending)
                                array.push(planInitialMasks,    curMask)
                                array.push(planFinalMasks,      curMask)
                                array.push(planSubtypes,        tSub)
                                pIdx := array.size(planRootSlots) - 1
                        else
                            curMask := array.get(planFinalMasks, pIdx)
                            valid   := array.get(planSubtypes, pIdx) == tSub
                        if valid and removeBit > 0
                            valid := int(math.floor(curMask / removeBit)) % 2 == 1
                        if valid and addBit > 0
                            valid := int(math.floor((curMask - removeBit) / addBit)) % 2 == 0
                        if valid
                            array.set(planFinalMasks, pIdx, curMask - removeBit + addBit)
                        else
                            engine.w03Store.journalInvariantViolation := true
                            stopped := true
            x += 1
        int p = 0
        while not stopped and p < array.size(planRootSlots)
            int initMask  = array.get(planInitialMasks, p)
            int finalMask = array.get(planFinalMasks,   p)
            if initMask != finalMask
                int labelRow = journalAppendRaw(engine, JOP_TIMEHL_LABEL, JGROUP_E3, array.get(planRootSlots, p), array.get(planExpectedRootIds, p), CAT_TIME_HL, array.get(planSubtypes, p), TF_5M, ID_NONE, int(na), int(na), int(na), float(na), float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, initMask, finalMask, ID_NONE, int(na))
            p += 1
        p := 0
        while not stopped and p < array.size(planRootSlots)
            if array.get(planInitialMasks, p) != array.get(planFinalMasks, p) and array.get(planFinalMasks, p) == 0
                int retireRow = journalAppendRaw(engine, JOP_ROOT_RETIRE, JGROUP_E4, array.get(planRootSlots, p), array.get(planExpectedRootIds, p), CAT_TIME_HL, array.get(planSubtypes, p), TF_5M, ID_NONE, int(na), int(na), int(na), float(na), float(na), float(na), ROOT_ACTIVE, ROOT_RETIRED, false, false, FVG_NONE, 0, 0, ID_NONE, int(na))
            p += 1
        outTimeHlSessionKind      := currentSessionKind
        outTimeHlSessionStartTime := currentSessionStartTime
        outTimeHlDayStartTime     := currentDayStartTime
        outTimeHlWeekStartTime    := currentWeekStartTime
    [true, outTimeHlSessionKind, outTimeHlSessionStartTime, outTimeHlDayStartTime, outTimeHlWeekStartTime]
w03StageEFvgRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed, int nextLastConsumed1hFvgFormationCloseTime, int nextLastConsumed4hFvgFormationCloseTime, int nextLastConsumedDFvgFormationCloseTime) =>
    int  outLastConsumed1hFvgFormationCloseTime = nextLastConsumed1hFvgFormationCloseTime
    int  outLastConsumed4hFvgFormationCloseTime = nextLastConsumed4hFvgFormationCloseTime
    int  outLastConsumedDFvgFormationCloseTime  = nextLastConsumedDFvgFormationCloseTime
    bool stopped = not cfg.useFvg
    bool mintickOk = not na(feed.mintick) and feed.mintick > 0
    bool adoptedTf = false
    int  e = 0
    while not stopped and e < 6
        int  t         = int(math.floor(e / 2))
        bool isBull    = e % 2 == 0
        int  tfCode    = t == 0 ? TF_1H : t == 1 ? TF_4H : TF_D
        int  srcOpen   = t == 0 ? feed.src1hOpenTime  : t == 1 ? feed.src4hOpenTime  : feed.srcDOpenTime
        int  srcClose  = t == 0 ? feed.src1hCloseTime : t == 1 ? feed.src4hCloseTime : feed.srcDCloseTime
        if isBull
            int lastClose = t == 0 ? outLastConsumed1hFvgFormationCloseTime : t == 1 ? outLastConsumed4hFvgFormationCloseTime : outLastConsumedDFvgFormationCloseTime
            adoptedTf := sourceAdoptableRaw(srcOpen, srcClose, lastClose, feed.baseCloseTime)
            if adoptedTf
                if t == 0
                    outLastConsumed1hFvgFormationCloseTime := srcClose
                else if t == 1
                    outLastConsumed4hFvgFormationCloseTime := srcClose
                else
                    outLastConsumedDFvgFormationCloseTime := srcClose
        if adoptedTf
            bool  isNew      = e == 0 ? feed.fvg1hBullNew    : e == 1 ? feed.fvg1hBearNew    : e == 2 ? feed.fvg4hBullNew    : e == 3 ? feed.fvg4hBearNew    : e == 4 ? feed.fvgDBullNew    : feed.fvgDBearNew
            float bottom     = e == 0 ? feed.fvg1hBullBottom : e == 1 ? feed.fvg1hBearBottom : e == 2 ? feed.fvg4hBullBottom : e == 3 ? feed.fvg4hBearBottom : e == 4 ? feed.fvgDBullBottom : feed.fvgDBearBottom
            float top        = e == 0 ? feed.fvg1hBullTop    : e == 1 ? feed.fvg1hBearTop    : e == 2 ? feed.fvg4hBullTop    : e == 3 ? feed.fvg4hBearTop    : e == 4 ? feed.fvgDBullTop    : feed.fvgDBearTop
            int   direction  = isBull ? FVG_BULLISH : FVG_BEARISH
            bool  usable     = isNew and not na(bottom) and not na(top) and not na(srcOpen) and not na(srcClose) and mintickOk
            int   bottomTick = int(na)
            int   topTick    = int(na)
            if usable
                bottomTick := int(math.round(bottom / feed.mintick))
                topTick    := int(math.round(top    / feed.mintick))
                usable     := bottomTick <= topTick
            if usable
                int originKey = originKeyComputeRaw(CAT_FVG, FVG_NONE, tfCode, int(na), srcOpen, direction)
                [rootSlot, pendingRow] = originLookupUniqueRaw(engine, originKey, CAT_FVG, FVG_NONE, tfCode, int(na), srcOpen, srcClose, direction, feed.mintick)
                if engine.w03Store.journalInvariantViolation
                    stopped := true
                else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                    int  mTick   = int(math.round(cfg.clusterMaxWidth / feed.mintick))
                    bool isBroad = topTick - bottomTick > mTick
                    int  newRow  = journalAppendRaw(engine, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_FVG, FVG_NONE, tfCode, originKey, srcOpen, srcClose, srcClose, float(na), bottom, top, ROOT_ACTIVE, ROOT_ACTIVE, true, isBroad, direction, 0, 0, ID_NONE, int(na))
        e += 1
    bool freshGate = not na(feed.baseCloseTime) and not na(feed.baseHigh) and not na(feed.baseLow) and mintickOk
    if not stopped and freshGate
        int baseLowTick  = int(math.round(feed.baseLow  / feed.mintick))
        int baseHighTick = int(math.round(feed.baseHigh / feed.mintick))
        int t = 0
        while not stopped and t < 3
            array<int> freshSet = t == 0 ? engine.freshFvg1hRootSlots : t == 1 ? engine.freshFvg4hRootSlots : engine.freshFvgDRootSlots
            int scanTf = t == 0 ? TF_1H : t == 1 ? TF_4H : TF_D
            int i = 0
            while not stopped and i < array.size(freshSet)
                int  slot = array.get(freshSet, i)
                bool valid = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootSubtypes) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootFvgFreshFlags) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootNativeBottoms) and slot < array.size(engine.rootNativeTops) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootNativeTopTicks) and slot < array.size(engine.rootConfirmedTimes) and slot < array.size(engine.rootOriginTimes) and slot < array.size(engine.rootOriginEndTimes) and slot < array.size(engine.rootOriginKeys) and slot < array.size(engine.rootStates) and slot < array.size(engine.rootIsBroadFvgFlags)
                int  rootId = ID_NONE
                if valid
                    rootId := array.get(engine.rootIds, slot)
                    int dir = array.get(engine.rootDirections, slot)
                    int bTick = array.get(engine.rootNativeBottomTicks, slot)
                    int tTick = array.get(engine.rootNativeTopTicks,    slot)
                    valid := array.get(engine.rootSlotLiveFlags, slot) and rootId != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and array.get(engine.rootTfCodes, slot) == scanTf and array.get(engine.rootFvgFreshFlags, slot) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and not na(bTick) and not na(tTick) and bTick <= tTick and not na(array.get(engine.rootConfirmedTimes, slot)) and not na(array.get(engine.rootOriginTimes, slot)) and array.get(engine.rootOriginKeys, slot) != ID_NONE
                if not valid
                    engine.w03Store.journalInvariantViolation := true
                    stopped := true
                else
                    int  virtualState = array.get(engine.rootStates, slot)
                    int  invalidates  = 0
                    bool freshEnded   = false
                    int  row = 0
                    while row < engine.w03Store.journalCount
                        if array.get(engine.w03Store.journalTargetRootSlots, row) == slot and array.get(engine.w03Store.journalExpectedRootIds, row) == rootId
                            int op = array.get(engine.w03Store.journalOps, row)
                            if op == JOP_FVG_INVALIDATE and array.get(engine.w03Store.journalGroups, row) == JGROUP_E1
                                invalidates += 1
                                virtualState := ROOT_INVALIDATED
                            else if op == JOP_FVG_FRESH_END
                                freshEnded := true
                        row += 1
                    if invalidates > 1 or not (virtualState == ROOT_ACTIVE or virtualState == ROOT_INVALIDATED)
                        engine.w03Store.journalInvariantViolation := true
                        stopped := true
                    else if not freshEnded
                        bool touched = baseLowTick <= array.get(engine.rootNativeTopTicks, slot) and baseHighTick >= array.get(engine.rootNativeBottomTicks, slot)
                        if feed.baseCloseTime > array.get(engine.rootConfirmedTimes, slot) and touched
                            int freshRow = journalAppendRaw(engine, JOP_FVG_FRESH_END, JGROUP_E3, slot, rootId, CAT_FVG, array.get(engine.rootSubtypes, slot), array.get(engine.rootTfCodes, slot), array.get(engine.rootOriginKeys, slot), array.get(engine.rootOriginTimes, slot), array.get(engine.rootOriginEndTimes, slot), array.get(engine.rootConfirmedTimes, slot), float(na), array.get(engine.rootNativeBottoms, slot), array.get(engine.rootNativeTops, slot), virtualState, virtualState, false, array.get(engine.rootIsBroadFvgFlags, slot), array.get(engine.rootDirections, slot), 0, 0, ID_NONE, int(na))
                i += 1
            t += 1
        int scanEnd = engine.w03Store.journalCount
        int n = 0
        while not stopped and n < scanEnd
            if array.get(engine.w03Store.journalOps, n) == JOP_NEW_ROOT and array.get(engine.w03Store.journalGroups, n) == JGROUP_E2 and array.get(engine.w03Store.journalCategories, n) == CAT_FVG
                int   nTf        = array.get(engine.w03Store.journalTfCodes,        n)
                int   nDir       = array.get(engine.w03Store.journalDirections,     n)
                int   nOrigin    = array.get(engine.w03Store.journalOriginTimes,    n)
                int   nConfirmed = array.get(engine.w03Store.journalConfirmedTimes, n)
                float nBottom    = array.get(engine.w03Store.journalNativeBottoms,  n)
                float nTop       = array.get(engine.w03Store.journalNativeTops,     n)
                bool  valid = (nTf == TF_1H or nTf == TF_4H or nTf == TF_D) and (nDir == FVG_BULLISH or nDir == FVG_BEARISH) and not na(nOrigin) and not na(nConfirmed) and not na(nBottom) and not na(nTop) and array.get(engine.w03Store.journalOriginKeys, n) != ID_NONE and array.get(engine.w03Store.journalFvgFreshFlags, n) and array.get(engine.w03Store.journalTargetRootSlots, n) == SLOT_INVALID and array.get(engine.w03Store.journalExpectedRootIds, n) == ID_NONE
                int  sameNew    = 0
                bool pathBFound = false
                int  j = 0
                while valid and j < engine.w03Store.journalCount
                    int jOp = array.get(engine.w03Store.journalOps, j)
                    if array.get(engine.w03Store.journalCategories, j) == CAT_FVG and array.get(engine.w03Store.journalTfCodes, j) == nTf and array.get(engine.w03Store.journalDirections, j) == nDir and array.get(engine.w03Store.journalOriginTimes, j) == nOrigin
                        if jOp == JOP_NEW_ROOT
                            sameNew += 1
                        else if jOp == JOP_FVG_FRESH_END and array.get(engine.w03Store.journalTargetRootSlots, j) == SLOT_INVALID and array.get(engine.w03Store.journalExpectedRootIds, j) == ID_NONE
                            pathBFound := true
                    j += 1
                if not valid or sameNew != 1
                    engine.w03Store.journalInvariantViolation := true
                    stopped := true
                else if not pathBFound
                    int  nBottomTick = int(math.round(nBottom / feed.mintick))
                    int  nTopTick    = int(math.round(nTop    / feed.mintick))
                    bool touched     = baseLowTick <= nTopTick and baseHighTick >= nBottomTick
                    if feed.baseCloseTime > nConfirmed and touched
                        int pathBRow = journalAppendRaw(engine, JOP_FVG_FRESH_END, JGROUP_E3, SLOT_INVALID, ID_NONE, CAT_FVG, array.get(engine.w03Store.journalSubtypes, n), nTf, array.get(engine.w03Store.journalOriginKeys, n), nOrigin, array.get(engine.w03Store.journalOriginEndTimes, n), nConfirmed, float(na), nBottom, nTop, ROOT_ACTIVE, ROOT_ACTIVE, false, array.get(engine.w03Store.journalIsBroadFlags, n), nDir, 0, 0, ID_NONE, int(na))
            n += 1
    [true, outLastConsumed1hFvgFormationCloseTime, outLastConsumed4hFvgFormationCloseTime, outLastConsumedDFvgFormationCloseTime]
w03StageDFvgFactsRaw(ZoneEngine engine, ZoneCfg cfg, Feed feed, int nextLastConsumed1hFvgStructuralCloseTime, int nextLastConsumed4hFvgStructuralCloseTime, int nextLastConsumedDFvgStructuralCloseTime) =>
    int  outLastConsumed1hFvgStructuralCloseTime = nextLastConsumed1hFvgStructuralCloseTime
    int  outLastConsumed4hFvgStructuralCloseTime = nextLastConsumed4hFvgStructuralCloseTime
    int  outLastConsumedDFvgStructuralCloseTime  = nextLastConsumedDFvgStructuralCloseTime
    bool stopped = not cfg.useFvg
    int  t = 0
    while not stopped and t < 3
        int   tfCode     = t == 0 ? TF_1H : t == 1 ? TF_4H : TF_D
        int   srcOpen    = t == 0 ? feed.src1hOpenTime  : t == 1 ? feed.src4hOpenTime  : feed.srcDOpenTime
        int   srcClose   = t == 0 ? feed.src1hCloseTime : t == 1 ? feed.src4hCloseTime : feed.srcDCloseTime
        float closePrice = t == 0 ? feed.htf1hClose     : t == 1 ? feed.htf4hClose     : feed.htfDClose
        int   lastClose  = t == 0 ? outLastConsumed1hFvgStructuralCloseTime : t == 1 ? outLastConsumed4hFvgStructuralCloseTime : outLastConsumedDFvgStructuralCloseTime
        if sourceAdoptableRaw(srcOpen, srcClose, lastClose, feed.baseCloseTime)
            if t == 0
                outLastConsumed1hFvgStructuralCloseTime := srcClose
            else if t == 1
                outLastConsumed4hFvgStructuralCloseTime := srcClose
            else
                outLastConsumedDFvgStructuralCloseTime := srcClose
            if not na(closePrice) and not na(feed.mintick) and feed.mintick > 0
                int closeTick = int(math.round(closePrice / feed.mintick))
                int side = 0
                while not stopped and side < 2
                    array<int> order     = side == 0 ? engine.fvgNativeBottomOrderRootSlots : engine.fvgNativeTopOrderRootSlots
                    array<int> positions = side == 0 ? engine.rootFvgNativeBottomOrderPositions : engine.rootFvgNativeTopOrderPositions
                    int expectedDir = side == 0 ? FVG_BULLISH : FVG_BEARISH
                    int i = 0
                    while not stopped and i < array.size(order)
                        int  slot   = array.get(order, i)
                        bool inRange = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootCategories) and slot < array.size(engine.rootSubtypes) and slot < array.size(engine.rootTfCodes) and slot < array.size(engine.rootDirections) and slot < array.size(engine.rootStates) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootIsDynamicFlags) and slot < array.size(engine.rootPointPrices) and slot < array.size(engine.rootPairKeys) and slot < array.size(engine.rootLabelMasks) and slot < array.size(engine.w03Store.rootSwingTfMasks) and slot < array.size(engine.rootOriginKeys) and slot < array.size(engine.rootOriginTimes) and slot < array.size(engine.rootOriginEndTimes) and slot < array.size(engine.rootConfirmedTimes) and slot < array.size(engine.rootNativeBottoms) and slot < array.size(engine.rootNativeTops) and slot < array.size(engine.rootNativeBottomTicks) and slot < array.size(engine.rootNativeTopTicks) and slot < array.size(engine.rootPriceOrderPositions) and slot < array.size(engine.rootFvgFreshFlags) and slot < array.size(engine.rootIsBroadFvgFlags) and slot < array.size(positions)
                        if not inRange
                            engine.w03Store.journalInvariantViolation := true
                            stopped := true
                        else if array.get(engine.rootTfCodes, slot) == tfCode and array.get(engine.rootDirections, slot) == expectedDir and array.get(engine.rootStates, slot) == ROOT_ACTIVE
                            int  rootId     = array.get(engine.rootIds, slot)
                            int  bottomTick = array.get(engine.rootNativeBottomTicks, slot)
                            int  topTick    = array.get(engine.rootNativeTopTicks,    slot)
                            bool valid = array.get(engine.rootSlotLiveFlags, slot) and rootId != ID_NONE and array.get(engine.rootCategories, slot) == CAT_FVG and array.get(engine.rootIsRangeRootFlags, slot) and not array.get(engine.rootIsDynamicFlags, slot) and na(array.get(engine.rootPointPrices, slot)) and array.get(engine.rootPairKeys, slot) == ID_NONE and array.get(engine.rootLabelMasks, slot) == 0 and array.get(engine.w03Store.rootSwingTfMasks, slot) == SWING_TF_MASK_NONE and array.get(engine.rootOriginKeys, slot) != ID_NONE and not na(array.get(engine.rootOriginTimes, slot)) and not na(array.get(engine.rootConfirmedTimes, slot)) and not na(array.get(engine.rootNativeBottoms, slot)) and not na(array.get(engine.rootNativeTops, slot)) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick and array.get(engine.rootPriceOrderPositions, slot) == SLOT_INVALID and array.get(positions, slot) == i
                            if valid
                                valid := rootSetMembershipValidRaw(engine, slot)
                            if valid
                                valid := fvgSetMembershipValidRaw(engine, slot, rootId)
                            if not valid
                                engine.w03Store.journalInvariantViolation := true
                                stopped := true
                            else
                                bool broken = side == 0 ? closeTick < bottomTick : closeTick > topTick
                                if broken
                                    bool already = false
                                    int  row = 0
                                    while not already and row < engine.w03Store.journalCount
                                        if array.get(engine.w03Store.journalOps, row) == JOP_FVG_INVALIDATE and array.get(engine.w03Store.journalGroups, row) == JGROUP_E1 and array.get(engine.w03Store.journalTargetRootSlots, row) == slot and array.get(engine.w03Store.journalExpectedRootIds, row) == rootId
                                            already := true
                                        row += 1
                                    if not already
                                        int invalidateRow = journalAppendRaw(engine, JOP_FVG_INVALIDATE, JGROUP_E1, slot, rootId, CAT_FVG, array.get(engine.rootSubtypes, slot), array.get(engine.rootTfCodes, slot), array.get(engine.rootOriginKeys, slot), array.get(engine.rootOriginTimes, slot), array.get(engine.rootOriginEndTimes, slot), array.get(engine.rootConfirmedTimes, slot), float(na), array.get(engine.rootNativeBottoms, slot), array.get(engine.rootNativeTops, slot), ROOT_ACTIVE, ROOT_INVALIDATED, array.get(engine.rootFvgFreshFlags, slot), array.get(engine.rootIsBroadFvgFlags, slot), array.get(engine.rootDirections, slot), 0, 0, ID_NONE, int(na))
                        i += 1
                    side += 1
        t += 1
    [true, outLastConsumed1hFvgStructuralCloseTime, outLastConsumed4hFvgStructuralCloseTime, outLastConsumedDFvgStructuralCloseTime]
phaseSetMembershipValidRaw(ZoneEngine engine, int sideSlot) =>
    bool valid = false
    if sideSlot >= 0 and sideSlot < array.size(engine.sidePhases) and sideSlot < array.size(engine.sidePhaseSetPositions)
        int phase = array.get(engine.sidePhases,            sideSlot)
        int pos   = array.get(engine.sidePhaseSetPositions, sideSlot)
        if pos >= 0
            if phase == PH_WAITING
                if pos < array.size(engine.phaseWaitingSideSlots)
                    valid := array.get(engine.phaseWaitingSideSlots, pos) == sideSlot
            else if phase == PH_ARMED
                if pos < array.size(engine.phaseArmedSideSlots)
                    valid := array.get(engine.phaseArmedSideSlots, pos) == sideSlot
            else if phase == PH_ACTIVE_TOUCH
                if pos < array.size(engine.phaseActiveTouchSideSlots)
                    valid := array.get(engine.phaseActiveTouchSideSlots, pos) == sideSlot
            else if phase == PH_BROKEN
                if pos < array.size(engine.phaseBrokenSideSlots)
                    valid := array.get(engine.phaseBrokenSideSlots, pos) == sideSlot
            else if phase == PH_FLIP_WAIT
                if pos < array.size(engine.phaseFlipWaitSideSlots)
                    valid := array.get(engine.phaseFlipWaitSideSlots, pos) == sideSlot
            else if phase == PH_DORMANT
                if pos < array.size(engine.phaseDormantSideSlots)
                    valid := array.get(engine.phaseDormantSideSlots, pos) == sideSlot
    valid
phaseSetAddRaw(ZoneEngine engine, int sideSlot) =>
    bool added = false
    if sideSlot >= 0 and sideSlot < array.size(engine.sidePhases) and sideSlot < array.size(engine.sidePhaseSetPositions)
        int pos = array.get(engine.sidePhaseSetPositions, sideSlot)
        if pos == SLOT_INVALID
            int phase  = array.get(engine.sidePhases, sideSlot)
            int newPos = SLOT_INVALID
            if phase == PH_WAITING
                newPos := array.size(engine.phaseWaitingSideSlots)
                array.push(engine.phaseWaitingSideSlots, sideSlot)
            else if phase == PH_ARMED
                newPos := array.size(engine.phaseArmedSideSlots)
                array.push(engine.phaseArmedSideSlots, sideSlot)
            else if phase == PH_ACTIVE_TOUCH
                newPos := array.size(engine.phaseActiveTouchSideSlots)
                array.push(engine.phaseActiveTouchSideSlots, sideSlot)
            else if phase == PH_BROKEN
                newPos := array.size(engine.phaseBrokenSideSlots)
                array.push(engine.phaseBrokenSideSlots, sideSlot)
            else if phase == PH_FLIP_WAIT
                newPos := array.size(engine.phaseFlipWaitSideSlots)
                array.push(engine.phaseFlipWaitSideSlots, sideSlot)
            else if phase == PH_DORMANT
                newPos := array.size(engine.phaseDormantSideSlots)
                array.push(engine.phaseDormantSideSlots, sideSlot)
            if newPos != SLOT_INVALID
                array.set(engine.sidePhaseSetPositions, sideSlot, newPos)
                added := true
    added
phaseSetDetachRaw(ZoneEngine engine, int sideSlot) =>
    bool detached = false
    if phaseSetMembershipValidRaw(engine, sideSlot)
        int phase        = array.get(engine.sidePhases,            sideSlot)
        int pos          = array.get(engine.sidePhaseSetPositions, sideSlot)
        int lastPos      = SLOT_INVALID
        int lastSideSlot = SLOT_INVALID
        if phase == PH_WAITING
            lastPos      := array.size(engine.phaseWaitingSideSlots) - 1
            lastSideSlot := array.get(engine.phaseWaitingSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseWaitingSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseWaitingSideSlots)
        else if phase == PH_ARMED
            lastPos      := array.size(engine.phaseArmedSideSlots) - 1
            lastSideSlot := array.get(engine.phaseArmedSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseArmedSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseArmedSideSlots)
        else if phase == PH_ACTIVE_TOUCH
            lastPos      := array.size(engine.phaseActiveTouchSideSlots) - 1
            lastSideSlot := array.get(engine.phaseActiveTouchSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseActiveTouchSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseActiveTouchSideSlots)
        else if phase == PH_BROKEN
            lastPos      := array.size(engine.phaseBrokenSideSlots) - 1
            lastSideSlot := array.get(engine.phaseBrokenSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseBrokenSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseBrokenSideSlots)
        else if phase == PH_FLIP_WAIT
            lastPos      := array.size(engine.phaseFlipWaitSideSlots) - 1
            lastSideSlot := array.get(engine.phaseFlipWaitSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseFlipWaitSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseFlipWaitSideSlots)
        else if phase == PH_DORMANT
            lastPos      := array.size(engine.phaseDormantSideSlots) - 1
            lastSideSlot := array.get(engine.phaseDormantSideSlots, lastPos)
            if pos != lastPos
                array.set(engine.phaseDormantSideSlots, pos, lastSideSlot)
                array.set(engine.sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(engine.phaseDormantSideSlots)
        array.set(engine.sidePhaseSetPositions, sideSlot, SLOT_INVALID)
        detached := true
    detached
coreResetSlotRaw(ZoneEngine engine, int coreSlot) =>
    array.set(engine.coreIds,             coreSlot, ID_NONE)
    array.set(engine.coreGenerationIds,   coreSlot, ID_NONE)
    array.set(engine.coreZoneFreshFlags,  coreSlot, false)
    array.set(engine.corePhysicalBottoms, coreSlot, float(na))
    array.set(engine.corePhysicalTops,    coreSlot, float(na))
    array.set(engine.coreCreatedTimes,    coreSlot, int(na))
    array.set(engine.coreLastSeenTimes,   coreSlot, int(na))
    array.set(engine.coreDormantFlags,    coreSlot, false)
    array.set(engine.coreSlotLiveFlags, coreSlot, false)
    array.set(engine.touchMarkRingOwnerCoreIds, coreSlot, ID_NONE)
    array.set(engine.touchMarkRingHeads,        coreSlot, 0)
    array.set(engine.touchMarkRingCounts,       coreSlot, 0)
    int supportSideSlot    = coreSlot * 2
    int resistanceSideSlot = coreSlot * 2 + 1
    array.set(engine.sideTouchCounts,           supportSideSlot   , 0)
    array.set(engine.sideWeakByTouchFlags,      supportSideSlot   , false)
    array.set(engine.sideWeakByDepthFlags,      supportSideSlot   , false)
    array.set(engine.sideMaxDepthPcts,          supportSideSlot   , 0.0)
    array.set(engine.sideFreshFlags,            supportSideSlot   , false)
    array.set(engine.sidePhases,                supportSideSlot   , PH_WAITING)
    array.set(engine.sideGrades,                supportSideSlot   , GR_UNAVAILABLE)
    array.set(engine.sideCurrentTouchNos,       supportSideSlot   , 0)
    array.set(engine.sideUpcomingTouchNos,      supportSideSlot   , 0)
    array.set(engine.sideArmedFromSeqs,         supportSideSlot   , SEQ_UNSET)
    array.set(engine.sideLastArmedRangeBottoms, supportSideSlot   , float(na))
    array.set(engine.sideLastArmedRangeTops,    supportSideSlot   , float(na))
    array.set(engine.sideLastNormalTouchTimes,  supportSideSlot   , int(na))
    array.set(engine.sideFlipAttemptCounts,     supportSideSlot   , 0)
    array.set(engine.sideInverseAttemptCounts,  supportSideSlot   , 0)
    array.set(engine.sideLastFlipConfirmSeqs,   supportSideSlot   , SEQ_UNSET)
    array.set(engine.sideEffectiveBottoms,      supportSideSlot   , float(na))
    array.set(engine.sideEffectiveTops,         supportSideSlot   , float(na))
    array.set(engine.sideReferencePrices,       supportSideSlot   , float(na))
    array.set(engine.sideCCounts,               supportSideSlot   , 0)
    array.set(engine.sideHCounts,               supportSideSlot   , 0)
    array.set(engine.sideDensities,             supportSideSlot   , int(na))
    array.set(engine.sideBaseStrongFlags,       supportSideSlot   , false)
    array.set(engine.sideHasNonPsychRootFlags,  supportSideSlot   , false)
    array.set(engine.sideIsBroadContextFlags,   supportSideSlot   , false)
    array.set(engine.sideEligibleFlags,         supportSideSlot   , false)
    array.set(engine.sidePhaseSetPositions, supportSideSlot,    SLOT_INVALID)
    array.set(engine.sidePhaseSetPositions, resistanceSideSlot, SLOT_INVALID)
    array.set(engine.sideArmedEffectiveBottomOrderPositions,  supportSideSlot,    SLOT_INVALID)
    array.set(engine.sideArmedEffectiveTopOrderPositions,     supportSideSlot,    SLOT_INVALID)
    array.set(engine.sideDormantRecoveryBottomOrderPositions, supportSideSlot,    SLOT_INVALID)
    array.set(engine.sideDormantRecoveryTopOrderPositions,    supportSideSlot,    SLOT_INVALID)
    array.set(engine.sideArmedEffectiveBottomOrderPositions,  resistanceSideSlot, SLOT_INVALID)

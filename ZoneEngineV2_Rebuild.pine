                    bool originDone = originBucketDetachRaw(engine, rootSlot, oldRootId)
                    // Commit 2 : price index - common order for a point Root, NativeRange for FVG
                    bool priceDone = isFvg ? fvgNativeRangeOrderDetachRaw(engine, rootSlot, oldRootId) : rootPriceOrderDetachRaw(engine, rootSlot, oldRootId)
                    // Commit 3 : Category-specific index

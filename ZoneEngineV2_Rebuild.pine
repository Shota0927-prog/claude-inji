//@version=6
// =====================================================================================
// ZoneEngineV2_Rebuild.pine  -- Production Library
// Build          : ZEV2-REBUILD-STRICT20S-001
// Logical canon  : Zone_definition_spec_v2(5).md
//                  SHA-256 f0ada2d851477850aa3d65463056e0318434b0c362383d475d49f9f6e1049cd1
// Implementation : Claude_ZoneEngine_v2_Strict_20s_Implementation_Instructions.md
//                  SHA-256 db5b1f7d980ecda6f07ea7522d4a4af4a3b7c57b8bcc8ddb2b84049791125c09
//
// This file contains Zone logic, numeric state, numeric Events and numeric Views only.
// It contains NO request.*(), NO box/line/label/table, NO history debug strings (I3-1).
//
// Numeric enum codes (harnesses mirror these literals; Pine v6 cannot export constants):
//   Category : MA=0 SWING=1 ACCUM=2 TIME_HL=3 FVG=4 PSYCH=5
//   Side     : SUPPORT=1 RESISTANCE=-1 NONE=0        (sideIdx 0=Support 1=Resistance)
//   Phase    : WAITING=0 ARMED=1 ACTIVE_TOUCH=2 BROKEN=3 FLIP_WAIT=4 DORMANT=5
//   Grade    : STRONG=0 NEUTRAL=1 WEAK=2 UNAVAILABLE=3
//   Density  : HIGH=0 NORMAL=1 BROAD_CONTEXT=2
//   RootState: CANDIDATE=0 ACTIVE=1 INVALIDATED=2 INVERSE_WAIT=3 INVERSE_ACTIVE=4 RETIRED=5
//   FVG dir  : NONE=0 BULLISH=1 BEARISH=-1     (view mask: bit0=bullish bit1=bearish)
//   WeakWhy  : NONE=0 BY_TOUCH=1 BY_DEPTH=2 BY_BOTH=3
//   Event    : TOUCH_START=1 TOUCH_RESET=2 WEAK_DEPTH=3 LOCAL_BREAK=4 GAP_BREAK=5
//              FLIP_ATTEMPT=6 FLIP_CONFIRM=7 RECLAIM=8 FVG_INVALIDATE=9
//              INVERSE_ATTEMPT=10 INVERSE_CONFIRM=11 GENERATION_START=12
//              MERGE=13 SPLIT=14 STORAGE_PRUNE=15
//   TF code  : 1 5 15 60 240 1440(D)
//   cfgError : 0=ok 1=bad timeframe 2=bad mintick 3=tf mismatch 4=strongUnlimited+weakOn
//              5=strongUntilTouch>=weakFromTouch 6=bad numeric bound 7=feed metadata
// =====================================================================================
library("ZoneEngineV2_Rebuild", overlay = false)

// -------------------------------------------------------------------------------------
// Types
// -------------------------------------------------------------------------------------

// Generic owned int list (Pine cannot nest collections directly; UDT wrapper is used).
export type IntList
    array<int> a

export type ZoneCfg
    // --- logical parameters (App. A 4.1) -------------------------------------------
    float clusterMaxWidth    = 20.0
    float denseRatio         = 0.50
    float touchResetDistance = 10.0
    int   strongUntilTouch   = 1
    bool  strongUnlimited    = false
    int   weakFromTouch      = 2
    bool  weakFromTouchOff   = false
    float weakDepthPct       = 50.0
    bool  weakDepthOff       = false
    float breakBuffer        = 2.0
    float touchTolerance     = 0.0
    int   emaSlopeLookback   = 60
    int   swingLen5m         = 10
    int   swingLen15m        = 8
    int   swingLen1h         = 6
    // --- accum detection (App. A 4.2) ----------------------------------------------
    int   accumRangeLen      = 10
    int   accumBaseLen       = 20
    int   accumAtrLen        = 14
    int   accumMinUpperCloses = 4
    int   accumMinLowerCloses = 4
    int   accumMaxSameColorRun = 4
    float accumAtrMult       = 2.5
    float accumBarRatioMax   = 0.70
    float accumDriftMax      = 0.30
    // --- sessions / day / week (App. A 4.3) ----------------------------------------
    string zoneTimezone      = "Asia/Tokyo"
    int   asiaStartHour      = 9
    int   europeStartHour    = 14
    int   newYorkStartHour   = 19
    int   sessionNoneHour    = 3
    int   dayBoundaryHour    = 5
    int   weekBoundaryDow    = 2          // dayofweek.monday == 2
    // --- storage / presentation (App. A 4.4) ---------------------------------------
    int   maxSwingRoots      = 180
    int   maxAccumBoxes      = 60
    int   maxFvgRoots        = 120
    int   maxTimeRoots       = 32
    int   maxZoneCores       = 80
    int   maxEndedGenerations = 30
    int   maxTouchMarksPerCore = 64
    float dormantDistance    = 500.0
    int   maxZonesDrawn      = 30
    int   maxLabelsDrawn     = 30
    // --- category enables ------------------------------------------------------------
    bool  catMaOn            = true
    bool  catSwingOn         = true
    bool  catAccumOn         = true
    bool  catTimeHlOn        = true
    bool  catFvgOn           = true
    bool  catPsychOn         = true
    // --- environment ------------------------------------------------------------------
    float mintick            = 0.01
    int   baseTfMinutes      = 5
    int   candidateCacheSize = 64

export type Feed
    // --- base bar ---------------------------------------------------------------------
    float baseOpen      = na
    float baseHigh      = na
    float baseLow       = na
    float baseClose     = na
    float basePrevClose = na
    int   baseOpenTime  = na
    int   baseCloseTime = na
    int   baseSeq       = na
    bool  baseConfirmed = false
    float mintick       = na
    int   baseTfMinutes = 5
    // --- MA context (1m) ----------------------------------------------------------------
    float ema2000       = na
    float ema2000Slope  = na
    float ema3000       = na
    float ema3000Slope  = na
    int   emaSourceTime = na
    // --- swing events adopted on this base bar -------------------------------------------
    // packed as parallel arrays: tfCode, isHigh, price, originTime, originEndTime, confirmedTime
    array<int>   swTf
    array<int>   swIsHigh
    array<float> swPrice
    array<int>   swOriginTime
    array<int>   swOriginEndTime
    array<int>   swConfirmedTime
    // --- accum confirmed boxes adopted on this base bar ------------------------------------
    array<int>   acTf
    array<float> acTop
    array<float> acBottom
    array<int>   acCandidateStart
    array<int>   acConfirmedTime
    // --- fvg creation events adopted on this base bar --------------------------------------
    array<int>   fvTf
    array<int>   fvDirection
    array<float> fvNativeBottom
    array<float> fvNativeTop
    array<int>   fvOriginTime
    array<int>   fvConfirmedTime
    // --- htf closes adopted on this base bar (for FVG structural invalidation) -------------
    array<int>   srcTf
    array<float> srcClose
    array<float> srcHigh
    array<float> srcLow
    array<int>   srcOpenTime
    array<int>   srcCloseTime


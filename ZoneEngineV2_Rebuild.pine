                            ok := array.get(engine.w03Store.journalCategories, newRow) == CAT_MA and array.get(engine.w03Store.journalSubtypes, newRow) == subtype and array.get(engine.w03Store.journalOriginKeys, newRow) == originKey and virtualRootStateBeforeRaw(engine, rootSlot, expectedRootId, row) == ROOT_ACTIVE

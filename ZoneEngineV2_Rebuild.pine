    n = math.max(0, cfg.candidateCacheSize)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            array.push(e.ccValid, false)
            array.push(e.ccSide, 0)
            array.push(e.ccHash, 0)
            array.push(e.ccCfgRev, -1)
            array.push(e.ccGeomRev, -1)
            array.push(e.ccQualRev, -1)
            array.push(e.ccFvgRev, -1)
            array.push(e.ccTieRev, -1)
            array.push(e.ccEpoch, -1)
            array.push(e.ccInputRoots, newIntList())
            array.push(e.ccWinnerPack, newIntList())
            array.push(e.ccLru, 0)
    e

// =====================================================================================
// Config validation (I5). Re-validated only when the fingerprint changes.
// =====================================================================================

cfgFingerprint(ZoneCfg cfg) =>
    h = 17
    h := mixHash(h, int(math.round(cfg.clusterMaxWidth * 1000000)))
    h := mixHash(h, int(math.round(cfg.denseRatio * 1000000)))
    h := mixHash(h, int(math.round(cfg.touchResetDistance * 1000000)))
    h := mixHash(h, cfg.strongUntilTouch)
    h := mixHash(h, cfg.strongUnlimited ? 1 : 0)
    h := mixHash(h, cfg.weakFromTouch)
    h := mixHash(h, cfg.weakFromTouchOff ? 1 : 0)
    h := mixHash(h, int(math.round(cfg.weakDepthPct * 1000000)))
    h := mixHash(h, cfg.weakDepthOff ? 1 : 0)
    h := mixHash(h, int(math.round(cfg.breakBuffer * 1000000)))
    h := mixHash(h, int(math.round(cfg.touchTolerance * 1000000)))
    h := mixHash(h, cfg.emaSlopeLookback)
    h := mixHash(h, cfg.swingLen5m)
    h := mixHash(h, cfg.swingLen15m)
    h := mixHash(h, cfg.swingLen1h)
    h := mixHash(h, cfg.accumRangeLen)
    h := mixHash(h, cfg.accumBaseLen)
    h := mixHash(h, cfg.accumAtrLen)
    h := mixHash(h, cfg.accumMinUpperCloses)
    h := mixHash(h, cfg.accumMinLowerCloses)
    h := mixHash(h, cfg.accumMaxSameColorRun)
    h := mixHash(h, int(math.round(cfg.accumAtrMult * 1000000)))
    h := mixHash(h, int(math.round(cfg.accumBarRatioMax * 1000000)))
    h := mixHash(h, int(math.round(cfg.accumDriftMax * 1000000)))
    h := mixHash(h, cfg.asiaStartHour)
    h := mixHash(h, cfg.europeStartHour)
    h := mixHash(h, cfg.newYorkStartHour)
    h := mixHash(h, cfg.sessionNoneHour)
    h := mixHash(h, cfg.dayBoundaryHour)
    h := mixHash(h, cfg.weekBoundaryDow)
    h := mixHash(h, cfg.maxSwingRoots)
    h := mixHash(h, cfg.maxAccumBoxes)
    h := mixHash(h, cfg.maxFvgRoots)
    h := mixHash(h, cfg.maxTimeRoots)
    h := mixHash(h, cfg.maxZoneCores)
    h := mixHash(h, cfg.maxEndedGenerations)
    h := mixHash(h, cfg.maxTouchMarksPerCore)
    h := mixHash(h, int(math.round(cfg.dormantDistance * 1000000)))
    h := mixHash(h, (cfg.catMaOn ? 1 : 0) + (cfg.catSwingOn ? 2 : 0) + (cfg.catAccumOn ? 4 : 0) + (cfg.catTimeHlOn ? 8 : 0) + (cfg.catFvgOn ? 16 : 0) + (cfg.catPsychOn ? 32 : 0))
    h := mixHash(h, int(math.round(cfg.mintick * 100000000)))
    h := mixHash(h, cfg.baseTfMinutes)
    h

// Returns the numeric config error code. 0 == valid. No auto correction (I5).
export validateCfg(ZoneCfg cfg) =>
    int code = 0
    if cfg.baseTfMinutes != 5
        code := 1
    else if na(cfg.mintick) or cfg.mintick <= 0
        code := 2
    else if cfg.strongUnlimited and not cfg.weakFromTouchOff
        code := 4
    else if (not cfg.strongUnlimited) and (not cfg.weakFromTouchOff) and cfg.strongUntilTouch >= cfg.weakFromTouch
        code := 5
    else if cfg.clusterMaxWidth <= 0 or cfg.denseRatio <= 0 or cfg.denseRatio > 1 or cfg.touchResetDistance <= 0 or cfg.breakBuffer < 0 or cfg.touchTolerance < 0 or cfg.weakDepthPct < 0 or cfg.weakDepthPct > 100 or cfg.strongUntilTouch < 1 or cfg.weakFromTouch < 2 or cfg.emaSlopeLookback < 1 or cfg.swingLen5m < 1 or cfg.swingLen15m < 1 or cfg.swingLen1h < 1
        code := 6
    code

export configErrorCode(ZoneEngine eng) =>
    eng.cfgErrorCode

export buildId() =>
    "ZEV2-REBUILD-STRICT20S-001"

// =====================================================================================
// Name conversion (display only -- never called from the hot path)
// =====================================================================================

export categoryName(int code) =>
    switch code
        0 => "MA"
        1 => "Swing"
        2 => "Accum"
        3 => "TimeHL"
        4 => "FVG"
        5 => "Psych"
        => "?"

export sideName(int code) =>
    switch code
        1 => "Support"
        -1 => "Resistance"
        => "None"

export phaseName(int code) =>
    switch code
        0 => "Waiting"
        1 => "Armed"
        2 => "ActiveTouch"
        3 => "Broken"
        4 => "FlipWait"
        5 => "Dormant"
        => "?"

export gradeName(int code) =>
    switch code
        0 => "Strong"
        1 => "Neutral"
        2 => "Weak"
        3 => "Unavailable"
        => "?"

export densityName(int code) =>
    switch code
        0 => "High"
        1 => "Normal"
        2 => "BroadContext"
        => "?"

export weakReasonName(int code) =>
    switch code
        0 => "None"
        1 => "WeakByTouch"
        2 => "WeakByDepth"
        3 => "WeakByBoth"
        => "?"

export eventName(int code) =>
    switch code
        1 => "TouchStart"
        2 => "TouchReset"
        3 => "WeakDepth"
        4 => "LocalBreak"
        5 => "GapBreak"
        6 => "FlipAttempt"
        7 => "FlipConfirm"
        8 => "Reclaim"
        9 => "FvgInvalidate"
        10 => "InverseAttempt"
        11 => "InverseConfirm"
        12 => "GenerationStart"
        13 => "Merge"
        14 => "Split"
        15 => "StoragePrune"
        => "?"

// =====================================================================================
// Event pool (I16). Physical capacity reused, logical length reset per bar.
// =====================================================================================

evClear(ZoneEngine eng) =>
    eng.evLen := 0

evEmit(ZoneEngine eng, int etype, int etime, int eseq, int coreId, int genId, int side, float bot, float top, int touchNo, int grade, int weak, int rootId, float price, float depth) =>
    i = eng.evLen
    if array.size(eng.evType) <= i
        array.push(eng.evType, etype)
        array.push(eng.evTime, etime)
        array.push(eng.evSeq, eseq)
        array.push(eng.evCoreId, coreId)
        array.push(eng.evGenId, genId)
        array.push(eng.evSide, side)
        array.push(eng.evBot, bot)
        array.push(eng.evTop, top)
        array.push(eng.evTouchNo, touchNo)
        array.push(eng.evGrade, grade)
        array.push(eng.evWeak, weak)
        array.push(eng.evRootId, rootId)
        array.push(eng.evPrice, price)
        array.push(eng.evDepth, depth)
    else
        array.set(eng.evType, i, etype)
        array.set(eng.evTime, i, etime)
        array.set(eng.evSeq, i, eseq)
        array.set(eng.evCoreId, i, coreId)
        array.set(eng.evGenId, i, genId)
        array.set(eng.evSide, i, side)
        array.set(eng.evBot, i, bot)
        array.set(eng.evTop, i, top)
        array.set(eng.evTouchNo, i, touchNo)
        array.set(eng.evGrade, i, grade)
        array.set(eng.evWeak, i, weak)
        array.set(eng.evRootId, i, rootId)
        array.set(eng.evPrice, i, price)
        array.set(eng.evDepth, i, depth)
    eng.evLen := i + 1

export eventCount(ZoneEngine eng) =>
    eng.evLen

export eventAt(ZoneEngine eng, int index) =>
    ZoneEvent ev = ZoneEvent.new()
    if index >= 0 and index < eng.evLen
        ev.eventType := array.get(eng.evType, index)
        ev.time := array.get(eng.evTime, index)
        ev.baseSeq := array.get(eng.evSeq, index)
        ev.coreId := array.get(eng.evCoreId, index)
        ev.generationId := array.get(eng.evGenId, index)
        ev.side := array.get(eng.evSide, index)
        ev.rangeBottom := array.get(eng.evBot, index)
        ev.rangeTop := array.get(eng.evTop, index)
        ev.touchNo := array.get(eng.evTouchNo, index)
        ev.gradeAtStart := array.get(eng.evGrade, index)
        ev.weakReason := array.get(eng.evWeak, index)
        ev.rootId := array.get(eng.evRootId, index)
        ev.price := array.get(eng.evPrice, index)
        ev.depthPct := array.get(eng.evDepth, index)
    ev

// =====================================================================================
// Root registry (I6.2 / I11). Root ID and slot are strictly separated; IDs are never
// reused, slots are recycled through a free stack with full field re-initialisation.
// =====================================================================================

catSetAdd(ZoneEngine eng, int cat, int slot) =>
    if cat >= 0 and cat <= 5
        array.push(array.get(eng.catSets, cat).a, slot)

catSetRemove(ZoneEngine eng, int cat, int slot) =>
    if cat >= 0 and cat <= 5
        a = array.get(eng.catSets, cat).a
        n = array.size(a)
        idx = -1
        if (n - 1) >= (0)
            for i = 0 to n - 1
                if array.get(a, i) == slot
                    idx := i
                    break
        if idx >= 0
            last = array.get(a, n - 1)
            array.set(a, idx, last)
            array.pop(a)

// price order key comparison: (priceTick asc, rootId asc) -- deterministic tie-break.
poKeyLess(ZoneEngine eng, int slotA, int tickB, int idB) =>
    ta = array.get(eng.rPriceTick, slotA)
    ia = array.get(eng.rId, slotA)
    ta < tickB or (ta == tickB and ia < idB)

poBinarySearch(ZoneEngine eng, array<int> order, int tick, int id) =>
    lo = 0
    hi = array.size(order)
    while lo < hi
        mid = int(math.floor((lo + hi) / 2))
        s = array.get(order, mid)
        if poKeyLess(eng, s, tick, id)
            lo := mid + 1
        else
            hi := mid
    lo

poRemoveAt(ZoneEngine eng, array<int> order, int pos) =>
    n = array.size(order)
    if pos >= 0 and pos < n
        if pos < n - 1
            if (n - 2) >= (pos)
                for i = pos to n - 2
                    s = array.get(order, i + 1)
                    array.set(order, i, s)
                    array.set(eng.rPricePos, s, i)
        array.pop(order)

poInsertAt(ZoneEngine eng, array<int> order, int pos, int slot) =>
    array.push(order, slot)
    n = array.size(order)
    if pos < n - 1
        for i = n - 1 to pos + 1
            s = array.get(order, i - 1)
            array.set(order, i, s)
            array.set(eng.rPricePos, s, i)
    array.set(order, pos, slot)
    array.set(eng.rPricePos, slot, pos)

priceOrderInsert(ZoneEngine eng, int slot) =>
    order = array.get(eng.rIsRange, slot) ? eng.fvgOrder : eng.priceOrder
    tick = array.get(eng.rIsRange, slot) ? array.get(eng.rNatBotTick, slot) : array.get(eng.rPriceTick, slot)
    // range roots are keyed on their native bottom
    pos = 0
    if array.get(eng.rIsRange, slot)
        lo = 0
        hi = array.size(order)
        idr = array.get(eng.rId, slot)
        while lo < hi
            mid = int(math.floor((lo + hi) / 2))
            s = array.get(order, mid)
            tb = array.get(eng.rNatBotTick, s)
            ib = array.get(eng.rId, s)
            if tb < tick or (tb == tick and ib < idr)
                lo := mid + 1
            else
                hi := mid
        pos := lo
    else
        pos := poBinarySearch(eng, order, tick, array.get(eng.rId, slot))
    poInsertAt(eng, order, pos, slot)
    if eng.instrument
        eng.statLocalInsert += 1

priceOrderRemove(ZoneEngine eng, int slot) =>
    order = array.get(eng.rIsRange, slot) ? eng.fvgOrder : eng.priceOrder
    pos = array.get(eng.rPricePos, slot)
    if pos >= 0 and pos < array.size(order) and array.get(order, pos) == slot
        poRemoveAt(eng, order, pos)
    else
        n = array.size(order)
        idx = -1
        if (n - 1) >= (0)
            for i = 0 to n - 1
                if array.get(order, i) == slot
                    idx := i
                    break
        if idx >= 0
            poRemoveAt(eng, order, idx)
    array.set(eng.rPricePos, slot, -1)

originHashOf(int cat, int sub, int tf, int originTime, int originEndTime, int dir, int pairKey, int priceTick) =>
    h = 1469598103
    h := mixHash(h, cat)
    h := mixHash(h, sub)
    h := mixHash(h, tf)
    h := mixHash(h, originTime)
    h := mixHash(h, originEndTime)
    h := mixHash(h, dir)
    h := mixHash(h, pairKey)
    h := mixHash(h, priceTick)
    h

// Full origin tuple comparison. A hash match alone never identifies a Root (I6.2).
originEquals(ZoneEngine eng, int slot, int cat, int sub, int tf, int originTime, int originEndTime, int dir, int pairKey, int priceTick) =>
    array.get(eng.rLive, slot) and array.get(eng.rCat, slot) == cat and array.get(eng.rSub, slot) == sub and array.get(eng.rTf, slot) == tf and array.get(eng.rOriginTime, slot) == originTime and array.get(eng.rOriginEndTime, slot) == originEndTime and array.get(eng.rDir, slot) == dir and array.get(eng.rPairKey, slot) == pairKey and (array.get(eng.rIsRange, slot) or array.get(eng.rPriceTick, slot) == priceTick)

findRootByOrigin(ZoneEngine eng, int cat, int sub, int tf, int originTime, int originEndTime, int dir, int pairKey, int priceTick) =>
    h = originHashOf(cat, sub, tf, originTime, originEndTime, dir, pairKey, priceTick)
    found = -1
    if map.contains(eng.originHashToSlot, h)
        cand = map.get(eng.originHashToSlot, h)
        if originEquals(eng, cand, cat, sub, tf, originTime, originEndTime, dir, pairKey, priceTick)
            found := cand
    if found < 0
        // hash miss or collision: exact scan of the category set (bounded by storage caps)
        a = array.get(eng.catSets, cat).a
        n = array.size(a)
        if (n - 1) >= (0)
            for i = 0 to n - 1
                s = array.get(a, i)
                if originEquals(eng, s, cat, sub, tf, originTime, originEndTime, dir, pairKey, priceTick)
                    found := s
                    break
    found

rootAlloc(ZoneEngine eng) =>
    int slot = -1
    if array.size(eng.rFree) > 0
        slot := array.pop(eng.rFree)
    else
        slot := array.size(eng.rLive)
        array.push(eng.rLive, false)
        array.push(eng.rId, 0)
        array.push(eng.rCat, 0)
        array.push(eng.rSub, 0)
        array.push(eng.rTf, 0)
        array.push(eng.rTfMask, 0)
        array.push(eng.rState, 0)
        array.push(eng.rDir, 0)
        array.push(eng.rPrice, na)
        array.push(eng.rPriceTick, 0)
        array.push(eng.rNatBot, na)
        array.push(eng.rNatTop, na)
        array.push(eng.rNatBotTick, 0)
        array.push(eng.rNatTopTick, 0)
        array.push(eng.rIsRange, false)
        array.push(eng.rIsDyn, false)
        array.push(eng.rFresh, false)
        array.push(eng.rBroad, false)
        array.push(eng.rIntrHigh, false)
        array.push(eng.rSlope, 0)
        array.push(eng.rOriginTime, 0)
        array.push(eng.rOriginEndTime, 0)
        array.push(eng.rConfirmedTime, 0)
        array.push(eng.rPairKey, 0)
        array.push(eng.rLabelMask, 0)
        array.push(eng.rLastUpdSeq, 0)
        array.push(eng.rPricePos, -1)
        array.push(eng.rOriginHash, 0)
        array.push(eng.rMovedAway, false)
        array.push(eng.rGeomRev, 0)
        array.push(eng.rQualRev, 0)
        array.push(eng.rStateRev, 0)
        array.push(eng.rCoreSup, -1)
        array.push(eng.rCoreRes, -1)
        array.push(eng.rootUsedSup, false)
        array.push(eng.rootUsedRes, false)
        array.push(eng.scMark, -1)
    // full re-initialisation of every field on slot reuse (I6.2)
    array.set(eng.rLive, slot, false)
    array.set(eng.rId, slot, 0)
    array.set(eng.rCat, slot, 0)
    array.set(eng.rSub, slot, 0)
    array.set(eng.rTf, slot, 0)
    array.set(eng.rTfMask, slot, 0)
    array.set(eng.rState, slot, 0)
    array.set(eng.rDir, slot, 0)
    array.set(eng.rPrice, slot, na)
    array.set(eng.rPriceTick, slot, 0)
    array.set(eng.rNatBot, slot, na)
    array.set(eng.rNatTop, slot, na)
    array.set(eng.rNatBotTick, slot, 0)
    array.set(eng.rNatTopTick, slot, 0)
    array.set(eng.rIsRange, slot, false)
    array.set(eng.rIsDyn, slot, false)
    array.set(eng.rFresh, slot, false)
    array.set(eng.rBroad, slot, false)
    array.set(eng.rIntrHigh, slot, false)
    array.set(eng.rSlope, slot, 0)
    array.set(eng.rOriginTime, slot, 0)
    array.set(eng.rOriginEndTime, slot, 0)
    array.set(eng.rConfirmedTime, slot, 0)
    array.set(eng.rPairKey, slot, 0)
    array.set(eng.rLabelMask, slot, 0)
    array.set(eng.rLastUpdSeq, slot, 0)
    array.set(eng.rPricePos, slot, -1)
    array.set(eng.rOriginHash, slot, 0)
    array.set(eng.rMovedAway, slot, false)
    array.set(eng.rGeomRev, slot, 0)
    array.set(eng.rQualRev, slot, 0)
    array.set(eng.rStateRev, slot, 0)
    array.set(eng.rCoreSup, slot, -1)
    array.set(eng.rCoreRes, slot, -1)
    array.set(eng.rootUsedSup, slot, false)
    array.set(eng.rootUsedRes, slot, false)
    array.set(eng.scMark, slot, -1)
    slot

seedRoot(ZoneEngine eng, int slot, int oldLo, int oldHi) =>
    array.push(eng.seedRoots, slot)
    array.push(eng.seedOldLo, oldLo)
    array.push(eng.seedOldHi, oldHi)

rootCreate(ZoneEngine eng, ZoneCfg cfg, int cat, int sub, int tf, int tfMask, float price, float natBot, float natTop, bool isRange, bool isDyn, int dir, int originTime, int originEndTime, int confirmedTime, int pairKey, int labelMask, bool intrinsicHigh, bool broad, bool fresh, int state, int seq) =>
    mt = eng.mintick
    ptick = isRange ? toTick(natBot, mt) : toTick(price, mt)
    slot = rootAlloc(eng)
    id = eng.nextRootId
    eng.nextRootId += 1
    array.set(eng.rLive, slot, true)
    array.set(eng.rId, slot, id)
    array.set(eng.rCat, slot, cat)
    array.set(eng.rSub, slot, sub)
    array.set(eng.rTf, slot, tf)
    array.set(eng.rTfMask, slot, tfMask)
    array.set(eng.rState, slot, state)
    array.set(eng.rDir, slot, dir)
    array.set(eng.rPrice, slot, price)
    array.set(eng.rPriceTick, slot, isRange ? toTick(natBot, mt) : ptick)
    array.set(eng.rNatBot, slot, natBot)
    array.set(eng.rNatTop, slot, natTop)
    array.set(eng.rNatBotTick, slot, toTick(natBot, mt))
    array.set(eng.rNatTopTick, slot, toTick(natTop, mt))
    array.set(eng.rIsRange, slot, isRange)
    array.set(eng.rIsDyn, slot, isDyn)
    array.set(eng.rFresh, slot, fresh)
    array.set(eng.rBroad, slot, broad)
    array.set(eng.rIntrHigh, slot, intrinsicHigh)
    array.set(eng.rOriginTime, slot, originTime)
    array.set(eng.rOriginEndTime, slot, originEndTime)
    array.set(eng.rConfirmedTime, slot, confirmedTime)
    array.set(eng.rPairKey, slot, pairKey)
    array.set(eng.rLabelMask, slot, labelMask)
    array.set(eng.rLastUpdSeq, slot, seq)
    h = originHashOf(cat, sub, tf, originTime, originEndTime, dir, pairKey, isRange ? 0 : ptick)
    array.set(eng.rOriginHash, slot, h)
    map.put(eng.rootIdToSlot, id, slot)
    map.put(eng.originHashToSlot, h, slot)
    catSetAdd(eng, cat, slot)
    priceOrderInsert(eng, slot)
    eng.liveRootCount += 1
    eng.rootRegistryRevision += 1
    eng.rootPriceRevision += 1
    eng.priceOrderRevision += 1
    lo = isRange ? array.get(eng.rNatBotTick, slot) : ptick
    hi = isRange ? array.get(eng.rNatTopTick, slot) : ptick
    seedRoot(eng, slot, lo, hi)
    slot

detachRootFromCores(ZoneEngine eng, int slot) =>
    for k = 0 to 1
        cs = k == 0 ? array.get(eng.rCoreSup, slot) : array.get(eng.rCoreRes, slot)
        if cs >= 0
            ss = cs * 2 + k
            if ss < array.size(eng.sRoots)
                a = array.get(eng.sRoots, ss).a
                n = array.size(a)
                if (n - 1) >= (0)
                    for i = 0 to n - 1
                        if array.get(a, i) == slot
                            array.set(a, i, array.get(a, n - 1))
                            array.pop(a)
                            break
            if k == 0
                array.set(eng.rCoreSup, slot, -1)
            else
                array.set(eng.rCoreRes, slot, -1)

rootRetire(ZoneEngine eng, int slot) =>
    if array.get(eng.rLive, slot)
        detachRootFromCores(eng, slot)
        lo = array.get(eng.rIsRange, slot) ? array.get(eng.rNatBotTick, slot) : array.get(eng.rPriceTick, slot)
        hi = array.get(eng.rIsRange, slot) ? array.get(eng.rNatTopTick, slot) : array.get(eng.rPriceTick, slot)
        seedRoot(eng, slot, lo, hi)
        priceOrderRemove(eng, slot)
        catSetRemove(eng, array.get(eng.rCat, slot), slot)
        id = array.get(eng.rId, slot)
        if map.contains(eng.rootIdToSlot, id)
            map.remove(eng.rootIdToSlot, id)
        h = array.get(eng.rOriginHash, slot)
        if map.contains(eng.originHashToSlot, h)
            if map.get(eng.originHashToSlot, h) == slot
                map.remove(eng.originHashToSlot, h)
        array.set(eng.rLive, slot, false)
        array.set(eng.rState, slot, 5)
        array.push(eng.rFree, slot)
        eng.liveRootCount -= 1
        eng.rootRegistryRevision += 1
        eng.priceOrderRevision += 1

// Price update for dynamic Roots (EMA). Old and new price positions are both seeded (I25-28).
rootUpdatePrice(ZoneEngine eng, int slot, float newPrice, int seq) =>
    mt = eng.mintick
    oldTick = array.get(eng.rPriceTick, slot)
    newTick = toTick(newPrice, mt)
    if newTick != oldTick
        priceOrderRemove(eng, slot)
        array.set(eng.rPrice, slot, newPrice)
        array.set(eng.rPriceTick, slot, newTick)
        priceOrderInsert(eng, slot)
        array.set(eng.rGeomRev, slot, array.get(eng.rGeomRev, slot) + 1)
        eng.rootPriceRevision += 1
        eng.priceOrderRevision += 1
        seedRoot(eng, slot, math.min(oldTick, newTick), math.max(oldTick, newTick))
    else
        array.set(eng.rPrice, slot, newPrice)
    array.set(eng.rLastUpdSeq, slot, seq)

export rootCount(ZoneEngine eng) =>
    array.size(eng.rLive)

export rootAt(ZoneEngine eng, int slot) =>
    RootRow r = RootRow.new()
    if slot >= 0 and slot < array.size(eng.rLive) and array.get(eng.rLive, slot)
        r.rootId := array.get(eng.rId, slot)
        r.category := array.get(eng.rCat, slot)
        r.subtype := array.get(eng.rSub, slot)
        r.tfCode := array.get(eng.rTf, slot)
        r.tfMask := array.get(eng.rTfMask, slot)
        r.state := array.get(eng.rState, slot)
        r.direction := array.get(eng.rDir, slot)
        r.pointPrice := array.get(eng.rPrice, slot)
        r.nativeBottom := array.get(eng.rNatBot, slot)
        r.nativeTop := array.get(eng.rNatTop, slot)
        r.isRangeRoot := array.get(eng.rIsRange, slot)
        r.isDynamic := array.get(eng.rIsDyn, slot)
        r.fvgFresh := array.get(eng.rFresh, slot)
        r.isBroadFvg := array.get(eng.rBroad, slot)
        r.intrinsicHigh := array.get(eng.rIntrHigh, slot)
        r.slope := array.get(eng.rSlope, slot)
        r.originTime := array.get(eng.rOriginTime, slot)
        r.originEndTime := array.get(eng.rOriginEndTime, slot)
        r.confirmedTime := array.get(eng.rConfirmedTime, slot)
        r.pairKey := array.get(eng.rPairKey, slot)
        r.labelMask := array.get(eng.rLabelMask, slot)
        r.lastUpdateSeq := array.get(eng.rLastUpdSeq, slot)
    r

// =====================================================================================
// Core registry + flattened Side state (I6.3). One physical Core carries both Views.
// =====================================================================================

newTouchRing(int cap) =>
    TouchRing.new(baseSeq = array.new<int>(cap, 0), time = array.new<int>(cap, 0), side = array.new<int>(cap, 0), contactBottom = array.new<float>(cap, na), contactTop = array.new<float>(cap, na), closeAtTouch = array.new<float>(cap, na), generationId = array.new<int>(cap, 0), isNormalTouch = array.new<bool>(cap, false), head = 0, count = 0)

ringPush(TouchRing ring, int cap, int seq, int t, int side, float cbot, float ctop, float closeAt, int genId, bool normal) =>
    pos = (ring.head + ring.count) % cap
    if ring.count == cap
        pos := ring.head
        ring.head := (ring.head + 1) % cap
    else
        ring.count += 1
    array.set(ring.baseSeq, pos, seq)
    array.set(ring.time, pos, t)
    array.set(ring.side, pos, side)
    array.set(ring.contactBottom, pos, cbot)
    array.set(ring.contactTop, pos, ctop)
    array.set(ring.closeAtTouch, pos, closeAt)
    array.set(ring.generationId, pos, genId)
    array.set(ring.isNormalTouch, pos, normal)

// logical (chronological) index -> physical ring index
ringIndex(TouchRing ring, int cap, int logical) =>
    (ring.head + logical) % cap

sideSlotOf(int coreSlot, int sideIdx) =>
    coreSlot * 2 + sideIdx

sideIdxOfSide(int side) =>
    side == 1 ? 0 : 1

sideOfIdx(int sideIdx) =>
    sideIdx == 0 ? 1 : -1

phaseSetAdd(ZoneEngine eng, int sideSlot, int phase) =>
    a = array.get(eng.phSets, phase).a
    array.push(a, sideSlot)
    array.set(eng.sPhasePos, sideSlot, array.size(a) - 1)

phaseSetRemove(ZoneEngine eng, int sideSlot, int phase) =>
    a = array.get(eng.phSets, phase).a
    pos = array.get(eng.sPhasePos, sideSlot)
    n = array.size(a)
    if pos >= 0 and pos < n and array.get(a, pos) == sideSlot
        last = array.get(a, n - 1)
        array.set(a, pos, last)
        array.set(eng.sPhasePos, last, pos)
        array.pop(a)
    else
        idx = -1
        if (n - 1) >= (0)
            for i = 0 to n - 1
                if array.get(a, i) == sideSlot
                    idx := i
                    break
        if idx >= 0
            last = array.get(a, n - 1)
            array.set(a, idx, last)
            array.set(eng.sPhasePos, last, idx)
            array.pop(a)
    array.set(eng.sPhasePos, sideSlot, -1)

// Armed range index (I11-10): side slots sorted by effective bottom tick.
armedIndexSearch(ZoneEngine eng, int tick, int sideSlot) =>
    lo = 0
    hi = array.size(eng.armedOrder)
    while lo < hi
        mid = int(math.floor((lo + hi) / 2))
        s = array.get(eng.armedOrder, mid)
        tb = array.get(eng.sArmedBotTick, s)
        if tb < tick or (tb == tick and s < sideSlot)
            lo := mid + 1
        else
            hi := mid
    lo

armedIndexInsert(ZoneEngine eng, int sideSlot) =>
    pos = armedIndexSearch(eng, array.get(eng.sArmedBotTick, sideSlot), sideSlot)
    array.push(eng.armedOrder, sideSlot)
    n = array.size(eng.armedOrder)
    if pos < n - 1
        for i = n - 1 to pos + 1
            array.set(eng.armedOrder, i, array.get(eng.armedOrder, i - 1))
    array.set(eng.armedOrder, pos, sideSlot)

armedIndexRemove(ZoneEngine eng, int sideSlot) =>
    pos = armedIndexSearch(eng, array.get(eng.sArmedBotTick, sideSlot), sideSlot)
    n = array.size(eng.armedOrder)
    if pos < n and array.get(eng.armedOrder, pos) == sideSlot
        if pos < n - 1
            if (n - 2) >= (pos)
                for i = pos to n - 2
                    array.set(eng.armedOrder, i, array.get(eng.armedOrder, i + 1))
        array.pop(eng.armedOrder)
    else
        idx = -1
        if (n - 1) >= (0)
            for i = 0 to n - 1
                if array.get(eng.armedOrder, i) == sideSlot
                    idx := i
                    break
        if idx >= 0
            if idx < n - 1
                if (n - 2) >= (idx)
                    for i = idx to n - 2
                        array.set(eng.armedOrder, i, array.get(eng.armedOrder, i + 1))
            array.pop(eng.armedOrder)

setPhase(ZoneEngine eng, int sideSlot, int newPhase) =>
    old = array.get(eng.sPhase, sideSlot)
    if old != newPhase
        if old == 1
            armedIndexRemove(eng, sideSlot)
        phaseSetRemove(eng, sideSlot, old)
        array.set(eng.sPhase, sideSlot, newPhase)
        phaseSetAdd(eng, sideSlot, newPhase)
        if newPhase == 1
            armedIndexInsert(eng, sideSlot)
        eng.sideStateRevision += 1

ensureSideSlots(ZoneEngine eng, int coreSlot) =>
    need = coreSlot * 2 + 1
    ensureB(eng.sEligible, need, false), ensureF(eng.sEffBot, need, na), ensureF(eng.sEffTop, need, na)
    ensureI(eng.sEffBotTick, need, 0), ensureI(eng.sEffTopTick, need, 0), ensureF(eng.sRefPrice, need, na)
    ensureI(eng.sC, need, 0), ensureI(eng.sH, need, 0), ensureI(eng.sCatMask, need, 0)
    ensureI(eng.sHighMask, need, 0), ensureI(eng.sDensity, need, 1), ensureB(eng.sBaseStrong, need, false)
    ensureB(eng.sHasNonPsych, need, false), ensureB(eng.sBroadCtx, need, false)
    ensureI(eng.sPhase, need, 0), ensureI(eng.sGrade, need, 3), ensureI(eng.sTouchCount, need, 0)
    ensureB(eng.sWeakTouch, need, false), ensureB(eng.sWeakDepth, need, false)
    ensureF(eng.sMaxDepth, need, 0.0), ensureB(eng.sFresh, need, true)
    ensureI(eng.sCurTouchNo, need, 0), ensureI(eng.sArmedFromSeq, need, 0)
    ensureF(eng.sArmedBot, need, na), ensureF(eng.sArmedTop, need, na)
    ensureI(eng.sArmedBotTick, need, 0), ensureI(eng.sArmedTopTick, need, 0)
    ensureI(eng.sLastTouchTime, need, 0), ensureI(eng.sFlipAttempts, need, 0)
    ensureI(eng.sInvAttempts, need, 0), ensureI(eng.sLastFlipSeq, need, -1)
    ensureB(eng.sUsedSide, need, false), ensureI(eng.sFvgDirMask, need, 0)
    ensureI(eng.sFvgCount, need, 0), ensureI(eng.sFvgFreshCount, need, 0)
    ensureI(eng.sFvgStateMask, need, 0), ensureL(eng.sRoots, need)
    ensureI(eng.sPhasePos, need, -1)
    ensureB(eng.tsValid, need, false), ensureI(eng.tsCoreId, need, 0), ensureI(eng.tsGenId, need, 0)
    ensureI(eng.tsSide, need, 0), ensureF(eng.tsBot, need, na), ensureF(eng.tsTop, need, na)
    ensureI(eng.tsCatMask, need, 0), ensureI(eng.tsHighMask, need, 0), ensureI(eng.tsC, need, 0)
    ensureI(eng.tsH, need, 0), ensureI(eng.tsDensity, need, 1), ensureI(eng.tsGrade, need, 3)
    ensureI(eng.tsTouchNo, need, 0), ensureI(eng.tsApproach, need, 0)
    ensureI(eng.tsStartSeq, need, 0), ensureI(eng.tsStartTime, need, 0)
    ensureF(eng.tsDeepest, need, na), ensureF(eng.tsMaxDepth, need, 0.0), ensureL(eng.tsRoots, need)
    ensureB(eng.bsValid, need, false), ensureI(eng.bsCoreId, need, 0), ensureI(eng.bsGenId, need, 0)
    ensureI(eng.bsOldSide, need, 0), ensureF(eng.bsBot, need, na), ensureF(eng.bsTop, need, na)
    ensureI(eng.bsSeq, need, 0), ensureI(eng.bsTime, need, 0), ensureB(eng.bsWasGap, need, false)
    ensureB(eng.bsMovedAway, need, false), ensureB(eng.bsRetest, need, false), ensureL(eng.bsRoots, need)

clearSideGeometry(ZoneEngine eng, int sideSlot) =>
    a = array.get(eng.sRoots, sideSlot).a
    n = array.size(a)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(a, i)
            if s >= 0 and s < array.size(eng.rLive)
                if array.get(eng.rCoreSup, s) == int(math.floor(sideSlot / 2)) and sideSlot % 2 == 0
                    array.set(eng.rCoreSup, s, -1)
                if array.get(eng.rCoreRes, s) == int(math.floor(sideSlot / 2)) and sideSlot % 2 == 1
                    array.set(eng.rCoreRes, s, -1)
    array.clear(a)
    array.set(eng.sEligible, sideSlot, false)
    array.set(eng.sC, sideSlot, 0)
    array.set(eng.sH, sideSlot, 0)
    array.set(eng.sCatMask, sideSlot, 0)
    array.set(eng.sHighMask, sideSlot, 0)
    array.set(eng.sBaseStrong, sideSlot, false)
    array.set(eng.sHasNonPsych, sideSlot, false)
    array.set(eng.sFvgDirMask, sideSlot, 0)
    array.set(eng.sFvgCount, sideSlot, 0)
    array.set(eng.sFvgFreshCount, sideSlot, 0)
    array.set(eng.sFvgStateMask, sideSlot, 0)

resetSideSlot(ZoneEngine eng, int sideSlot, bool keepHistory) =>
    array.set(eng.sEligible, sideSlot, false)
    array.set(eng.sEffBot, sideSlot, na)
    array.set(eng.sEffTop, sideSlot, na)
    array.set(eng.sEffBotTick, sideSlot, 0)
    array.set(eng.sEffTopTick, sideSlot, 0)
    array.set(eng.sRefPrice, sideSlot, na)
    array.set(eng.sC, sideSlot, 0)
    array.set(eng.sH, sideSlot, 0)
    array.set(eng.sCatMask, sideSlot, 0)
    array.set(eng.sHighMask, sideSlot, 0)
    array.set(eng.sDensity, sideSlot, 1)
    array.set(eng.sBaseStrong, sideSlot, false)
    array.set(eng.sHasNonPsych, sideSlot, false)
    array.set(eng.sBroadCtx, sideSlot, false)
    array.set(eng.sFvgDirMask, sideSlot, 0)
    array.set(eng.sFvgCount, sideSlot, 0)
    array.set(eng.sFvgFreshCount, sideSlot, 0)
    array.set(eng.sFvgStateMask, sideSlot, 0)
    array.clear(array.get(eng.sRoots, sideSlot).a)
    if not keepHistory
        array.set(eng.sGrade, sideSlot, 3)
        array.set(eng.sTouchCount, sideSlot, 0)
        array.set(eng.sWeakTouch, sideSlot, false)
        array.set(eng.sWeakDepth, sideSlot, false)
        array.set(eng.sWeakReason, sideSlot, 0)
        array.set(eng.sMaxDepth, sideSlot, 0.0)
        array.set(eng.sFresh, sideSlot, true)
        array.set(eng.sCurTouchNo, sideSlot, 0)
        array.set(eng.sArmedFromSeq, sideSlot, 0)
        array.set(eng.sLastTouchTime, sideSlot, 0)
        array.set(eng.sFlipAttempts, sideSlot, 0)
        array.set(eng.sInvAttempts, sideSlot, 0)
        array.set(eng.sLastFlipSeq, sideSlot, -1)
        array.set(eng.sUsedSide, sideSlot, false)
        array.set(eng.tsValid, sideSlot, false)
        array.set(eng.bsValid, sideSlot, false)
        array.clear(array.get(eng.tsRoots, sideSlot).a)
        array.clear(array.get(eng.bsRoots, sideSlot).a)

coreAlloc(ZoneEngine eng, ZoneCfg cfg, int createdTime) =>
    int slot = -1
    if array.size(eng.cFree) > 0
        slot := array.pop(eng.cFree)
    else
        slot := array.size(eng.cLive)
        array.push(eng.cLive, false)
        array.push(eng.cId, 0)
        array.push(eng.cGenId, 0)
        array.push(eng.cCreated, 0)
        array.push(eng.cLastSeen, 0)
        array.push(eng.cDormant, false)
        array.push(eng.cZoneFresh, true)
        array.push(eng.cRangeBot, na)
        array.push(eng.cRangeTop, na)
        array.push(eng.cPending, false)
        array.push(eng.cPendingGen, false)
        array.push(eng.cOriginRoots, newIntList())
        array.push(eng.cTouch, newTouchRing(cfg.maxTouchMarksPerCore))
        array.push(eng.cGenStartTime, 0)
        array.push(eng.cGenBaseCatMask, 0)
        array.push(eng.cGenCandActive, false)
        array.push(eng.cGenCandBot, na)
        array.push(eng.cGenCandTop, na)
        array.push(eng.cGenCandSide, 0)
        array.push(eng.cGenCandReset, false)
        array.push(eng.cGenCandArmed, false)
        array.push(eng.cGenCandCatMask, 0)
        array.push(eng.cLivePos, -1)
    ensureSideSlots(eng, slot)
    // full re-initialisation on slot reuse, including the TouchMark ring metadata (I17.2)
    ring = array.get(eng.cTouch, slot)
    ring.head := 0
    ring.count := 0
    array.set(eng.cLive, slot, true)
    array.set(eng.cId, slot, eng.nextCoreId)
    array.set(eng.cGenId, slot, eng.nextGenId)
    eng.nextCoreId += 1
    eng.nextGenId += 1
    array.set(eng.cCreated, slot, createdTime)
    array.set(eng.cLastSeen, slot, createdTime)
    array.set(eng.cDormant, slot, false)
    array.set(eng.cZoneFresh, slot, true)
    array.set(eng.cRangeBot, slot, na)
    array.set(eng.cRangeTop, slot, na)
    array.set(eng.cPending, slot, false)
    array.set(eng.cPendingGen, slot, false)
    array.clear(array.get(eng.cOriginRoots, slot).a)
    array.set(eng.cGenStartTime, slot, createdTime)
    array.set(eng.cGenBaseCatMask, slot, 0)
    array.set(eng.cGenCandActive, slot, false)
    array.set(eng.cGenCandBot, slot, na)
    array.set(eng.cGenCandTop, slot, na)
    array.set(eng.cGenCandSide, slot, 0)
    array.set(eng.cGenCandReset, slot, false)
    array.set(eng.cGenCandArmed, slot, false)
    array.set(eng.cGenCandCatMask, slot, 0)
    for k = 0 to 1
        ss = sideSlotOf(slot, k)
        array.set(eng.sPhase, ss, 0)
        array.set(eng.sPhasePos, ss, -1)
        resetSideSlot(eng, ss, false)
        phaseSetAdd(eng, ss, 0)
    array.set(eng.cLivePos, slot, array.size(eng.cLiveList))
    array.push(eng.cLiveList, slot)
    eng.coreTopologyRevision += 1
    slot

pushEndedGeneration(ZoneEngine eng, ZoneCfg cfg, int coreSlot) =>
    cap = math.max(1, cfg.maxEndedGenerations)
    while array.size(eng.egCoreId) < cap
        array.push(eng.egCoreId, 0)
        array.push(eng.egGenId, 0)
        array.push(eng.egStartTime, 0)
        array.push(eng.egEndTime, 0)
        array.push(eng.egLastGrade, 3)
    pos = (eng.egHead + eng.egCount) % cap
    if eng.egCount == cap
        pos := eng.egHead
        eng.egHead := (eng.egHead + 1) % cap
    else
        eng.egCount += 1
    array.set(eng.egCoreId, pos, array.get(eng.cId, coreSlot))
    array.set(eng.egGenId, pos, array.get(eng.cGenId, coreSlot))
    array.set(eng.egStartTime, pos, array.get(eng.cGenStartTime, coreSlot))
    array.set(eng.egEndTime, pos, array.get(eng.cLastSeen, coreSlot))
    array.set(eng.egLastGrade, pos, array.get(eng.sGrade, sideSlotOf(coreSlot, 0)))

coreFree(ZoneEngine eng, ZoneCfg cfg, int coreSlot) =>
    if array.get(eng.cLive, coreSlot)
        pushEndedGeneration(eng, cfg, coreSlot)
        for k = 0 to 1
            ss = sideSlotOf(coreSlot, k)
            ph = array.get(eng.sPhase, ss)
            if ph == 1
                armedIndexRemove(eng, ss)
            phaseSetRemove(eng, ss, ph)
            clearSideGeometry(eng, ss)
            resetSideSlot(eng, ss, false)
        array.set(eng.cLive, coreSlot, false)
        pos = array.get(eng.cLivePos, coreSlot)
        n = array.size(eng.cLiveList)
        if pos >= 0 and pos < n and array.get(eng.cLiveList, pos) == coreSlot
            last = array.get(eng.cLiveList, n - 1)
            array.set(eng.cLiveList, pos, last)
            array.set(eng.cLivePos, last, pos)
            array.pop(eng.cLiveList)
        array.set(eng.cLivePos, coreSlot, -1)
        array.push(eng.cFree, coreSlot)
        eng.coreTopologyRevision += 1
        eng.prunedZoneCount += 1

// =====================================================================================
// Stage E -- Source facts -> Root mutation journal (I8 / I10)
// TF bit indices: 5m=0 15m=1 1H=2 4H=3 D=4 1m=5
// =====================================================================================

tfBitIndex(int tf) =>
    switch tf
        5 => 0
        15 => 1
        60 => 2
        240 => 3
        1440 => 4
        1 => 5
        => 5

swingIntrinsicHigh(int tf, int tfMask) =>
    tf == 60 or hasBit(tfMask, 2) or (hasBit(tfMask, 1) and hasBit(tfMask, 0))

// --- MA (I10: the two EMA Roots keep fixed Root IDs; only price/slope are updated) -----
stageE_ma(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catMaOn and not na(feed.ema2000) and not na(feed.ema3000)
        if eng.slotEma2000 < 0
            eng.slotEma2000 := rootCreate(eng, cfg, 0, 0, 1, bit(5), feed.ema2000, float(na), float(na), false, true, 0, feed.emaSourceTime, feed.emaSourceTime, feed.emaSourceTime, 0, 0, false, false, false, 1, feed.baseSeq)
        if eng.slotEma3000 < 0
            eng.slotEma3000 := rootCreate(eng, cfg, 0, 1, 1, bit(5), feed.ema3000, float(na), float(na), false, true, 0, feed.emaSourceTime, feed.emaSourceTime, feed.emaSourceTime, 0, 0, false, false, false, 1, feed.baseSeq)
        rootUpdatePrice(eng, eng.slotEma2000, feed.ema2000, feed.baseSeq)
        rootUpdatePrice(eng, eng.slotEma3000, feed.ema3000, feed.baseSeq)
        sl2 = na(feed.ema2000Slope) ? 0 : (feed.ema2000Slope > 0 ? 1 : (feed.ema2000Slope < 0 ? -1 : 0))
        sl3 = na(feed.ema3000Slope) ? 0 : (feed.ema3000Slope > 0 ? 1 : (feed.ema3000Slope < 0 ? -1 : 0))
        if array.get(eng.rSlope, eng.slotEma2000) != sl2
            array.set(eng.rSlope, eng.slotEma2000, sl2)
            array.set(eng.rQualRev, eng.slotEma2000, array.get(eng.rQualRev, eng.slotEma2000) + 1)
            eng.rootQualityRevision += 1
            seedRoot(eng, eng.slotEma2000, array.get(eng.rPriceTick, eng.slotEma2000), array.get(eng.rPriceTick, eng.slotEma2000))
        if array.get(eng.rSlope, eng.slotEma3000) != sl3
            array.set(eng.rSlope, eng.slotEma3000, sl3)
            array.set(eng.rQualRev, eng.slotEma3000, array.get(eng.rQualRev, eng.slotEma3000) + 1)
            eng.rootQualityRevision += 1
            seedRoot(eng, eng.slotEma3000, array.get(eng.rPriceTick, eng.slotEma3000), array.get(eng.rPriceTick, eng.slotEma3000))

// --- Swing (same-event unification, spec 3.2) ---------------------------------------------
stageE_swing(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catSwingOn
        n = array.size(feed.swTf)
        if (n - 1) >= (0)
            for i = 0 to n - 1
                tf = array.get(feed.swTf, i)
                isHigh = array.get(feed.swIsHigh, i) == 1
                price = array.get(feed.swPrice, i)
                oT = array.get(feed.swOriginTime, i)
                oE = array.get(feed.swOriginEndTime, i)
                cT = array.get(feed.swConfirmedTime, i)
                ptick = toTick(price, eng.mintick)
                sub = isHigh ? 0 : 1
                // exact duplicate of an already adopted event
                dup = findRootByOrigin(eng, 1, sub, tf, oT, oE, 0, 0, ptick)
                if dup < 0
                    merged = -1
                    a = array.get(eng.catSets, 1).a
                    m = array.size(a)
                    if (m - 1) >= (0)
                        for k = 0 to m - 1
                            s = array.get(a, k)
                            if array.get(eng.rSub, s) == sub and array.get(eng.rPriceTick, s) == ptick
                                sOT = array.get(eng.rOriginTime, s)
                                sOE = array.get(eng.rOriginEndTime, s)
                                // lower TF origin inside the higher TF pivot interval [origin, originEnd)
                                if (oT >= sOT and oT < sOE) or (sOT >= oT and sOT < oE)
                                    merged := s
                                    break
                    if merged >= 0
                        newMask = array.get(eng.rTfMask, merged) + (hasBit(array.get(eng.rTfMask, merged), tfBitIndex(tf)) ? 0 : bit(tfBitIndex(tf)))
                        array.set(eng.rTfMask, merged, newMask)
                        if tf > array.get(eng.rTf, merged)
                            array.set(eng.rTf, merged, tf)
                            array.set(eng.rOriginTime, merged, oT)
                            array.set(eng.rOriginEndTime, merged, oE)
                        hi = swingIntrinsicHigh(array.get(eng.rTf, merged), newMask)
                        if hi != array.get(eng.rIntrHigh, merged)
                            array.set(eng.rIntrHigh, merged, hi)
                            eng.rootQualityRevision += 1
                        array.set(eng.rQualRev, merged, array.get(eng.rQualRev, merged) + 1)
                        array.set(eng.rConfirmedTime, merged, math.min(array.get(eng.rConfirmedTime, merged), cT))
                        seedRoot(eng, merged, ptick, ptick)
                    else
                        mask = bit(tfBitIndex(tf))
                        rootCreate(eng, cfg, 1, sub, tf, mask, price, float(na), float(na), false, false, 0, oT, oE, cT, 0, 0, swingIntrinsicHigh(tf, mask), false, false, 1, feed.baseSeq)

// --- Accum confirmed boxes (two mutually exclusive boundary Roots per box) ------------------
stageE_accum(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catAccumOn
        n = array.size(feed.acTf)
        if (n - 1) >= (0)
            for i = 0 to n - 1
                tf = array.get(feed.acTf, i)
                top = array.get(feed.acTop, i)
                bot = array.get(feed.acBottom, i)
                cs = array.get(feed.acCandidateStart, i)
                cT = array.get(feed.acConfirmedTime, i)
                pairKey = mixHash(mixHash(7, tf), cs)
                hiIntr = (tf == 240 or tf == 1440)
                if findRootByOrigin(eng, 2, 0, tf, cs, cT, 0, pairKey, toTick(top, eng.mintick)) < 0
                    rootCreate(eng, cfg, 2, 0, tf, bit(tfBitIndex(tf)), top, float(na), float(na), false, false, 0, cs, cT, cT, pairKey, 0, hiIntr, false, false, 1, feed.baseSeq)
                if findRootByOrigin(eng, 2, 1, tf, cs, cT, 0, pairKey, toTick(bot, eng.mintick)) < 0
                    rootCreate(eng, cfg, 2, 1, tf, bit(tfBitIndex(tf)), bot, float(na), float(na), false, false, 0, cs, cT, cT, pairKey, 0, hiIntr, false, false, 1, feed.baseSeq)

// --- FVG creation ---------------------------------------------------------------------------
stageE_fvgCreate(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catFvgOn
        n = array.size(feed.fvTf)
        if (n - 1) >= (0)
            for i = 0 to n - 1
                tf = array.get(feed.fvTf, i)
                dir = array.get(feed.fvDirection, i)
                nb = array.get(feed.fvNativeBottom, i)
                nt = array.get(feed.fvNativeTop, i)
                oT = array.get(feed.fvOriginTime, i)
                cT = array.get(feed.fvConfirmedTime, i)
                if findRootByOrigin(eng, 4, dir > 0 ? 0 : 1, tf, oT, oT, dir, 0, 0) < 0
                    broad = (nt - nb) > cfg.clusterMaxWidth
                    intr = (not broad) and (tf == 240 or tf == 1440)
                    rootCreate(eng, cfg, 4, dir > 0 ? 0 : 1, tf, bit(tfBitIndex(tf)), float(na), nb, nt, true, false, dir, oT, oT, cT, 0, 0, intr, broad, true, 1, feed.baseSeq)
                    eng.fvgStateRevision += 1

// --- FVG structural invalidation on a new source close (spec 3.5) -----------------------------
stageE_fvgInvalidate(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catFvgOn
        ns = array.size(feed.srcTf)
        if (ns - 1) >= (0)
            for i = 0 to ns - 1
                tf = array.get(feed.srcTf, i)
                c = array.get(feed.srcClose, i)
                cTick = toTick(c, eng.mintick)
                a = array.get(eng.catSets, 4).a
                m = array.size(a)
                if (m - 1) >= (0)
                    for k = 0 to m - 1
                        s = array.get(a, k)
                        if array.get(eng.rTf, s) == tf
                            st = array.get(eng.rState, s)
                            dirNow = array.get(eng.rDir, s) * (st == 4 ? -1 : 1)
                            if st == 1 or st == 4
                                bad = (dirNow > 0 and cTick < array.get(eng.rNatBotTick, s)) or (dirNow < 0 and cTick > array.get(eng.rNatTopTick, s))
                                if bad
                                    array.set(eng.rState, s, 3)
                                    array.set(eng.rMovedAway, s, false)
                                    array.set(eng.rStateRev, s, array.get(eng.rStateRev, s) + 1)
                                    eng.fvgStateRevision += 1
                                    evEmit(eng, 9, feed.baseCloseTime, feed.baseSeq, 0, 0, dirNow, array.get(eng.rNatBot, s), array.get(eng.rNatTop, s), 0, 3, 0, array.get(eng.rId, s), c, 0.0)
                                    seedRoot(eng, s, array.get(eng.rNatBotTick, s), array.get(eng.rNatTopTick, s))

// --- FVG Fresh consumption (only for Roots still in the fresh set) -----------------------------
stageE_fvgFresh(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catFvgOn
        hiTick = toTick(feed.baseHigh, eng.mintick)
        loTick = toTick(feed.baseLow, eng.mintick)
        a = array.get(eng.catSets, 4).a
        m = array.size(a)
        if (m - 1) >= (0)
            for k = 0 to m - 1
                s = array.get(a, k)
                if array.get(eng.rFresh, s) and feed.baseCloseTime > array.get(eng.rConfirmedTime, s)
                    if hiTick >= array.get(eng.rNatBotTick, s) and loTick <= array.get(eng.rNatTopTick, s)
                        array.set(eng.rFresh, s, false)
                        eng.fvgFreshRevision += 1

// --- Time high/low (spec 3.4, App. A 7.6) ------------------------------------------------------
sessionCodeOf(ZoneCfg cfg, int t) =>
    h = hour(t, cfg.zoneTimezone)
    h >= cfg.asiaStartHour and h < cfg.europeStartHour ? 1 : h >= cfg.europeStartHour and h < cfg.newYorkStartHour ? 2 : (h >= cfg.newYorkStartHour or h < cfg.sessionNoneHour) ? 3 : 0

dayKeyOf(ZoneCfg cfg, int t) =>
    shifted = t - cfg.dayBoundaryHour * 3600000
    year(shifted, cfg.zoneTimezone) * 10000 + month(shifted, cfg.zoneTimezone) * 100 + dayofmonth(shifted, cfg.zoneTimezone)

weekKeyOf(ZoneCfg cfg, int t) =>
    shifted = t - cfg.dayBoundaryHour * 3600000
    dow = dayofweek(shifted, cfg.zoneTimezone)
    daysSinceStart = (dow + 7 - cfg.weekBoundaryDow) % 7
    ws = shifted - daysSinceStart * 86400000
    year(ws, cfg.zoneTimezone) * 10000 + month(ws, cfg.zoneTimezone) * 100 + dayofmonth(ws, cfg.zoneTimezone)

// Retire the Root currently carrying a "current period" label.
dropTimeRoot(ZoneEngine eng, int slot) =>
    if slot >= 0
        if array.get(eng.rLive, slot)
            rootRetire(eng, slot)

// Relabel keeps the same Root ID (spec 3.4: same origin, label migration only).
relabelTimeRoot(ZoneEngine eng, int slot, int labelMask, bool intrinsicHigh) =>
    if slot >= 0 and array.get(eng.rLive, slot)
        array.set(eng.rLabelMask, slot, labelMask)
        if array.get(eng.rIntrHigh, slot) != intrinsicHigh
            array.set(eng.rIntrHigh, slot, intrinsicHigh)
            array.set(eng.rQualRev, slot, array.get(eng.rQualRev, slot) + 1)
            eng.rootQualityRevision += 1
            seedRoot(eng, slot, array.get(eng.rPriceTick, slot), array.get(eng.rPriceTick, slot))

newTimeRoot(ZoneEngine eng, ZoneCfg cfg, bool isHigh, float price, int originTime, int labelMask, bool intrinsicHigh, int seq) =>
    rootCreate(eng, cfg, 3, isHigh ? 0 : 1, 5, bit(0), price, float(na), float(na), false, false, 0, originTime, originTime, originTime, 0, labelMask, intrinsicHigh, false, false, 1, seq)

stageE_timeHl(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    if cfg.catTimeHlOn
        t = feed.baseOpenTime
        sess = sessionCodeOf(cfg, t)
        dk = dayKeyOf(cfg, t)
        wk = weekKeyOf(cfg, t)
        // ---- session boundary ------------------------------------------------------------
        if sess != eng.curSessionCode
            if eng.curSessionCode != 0
                dropTimeRoot(eng, eng.slotLastSessHigh)
                dropTimeRoot(eng, eng.slotLastSessLow)
                eng.slotLastSessHigh := eng.slotSessHigh
                eng.slotLastSessLow := eng.slotSessLow
                relabelTimeRoot(eng, eng.slotLastSessHigh, bit(1), false)
                relabelTimeRoot(eng, eng.slotLastSessLow, bit(1), false)
            eng.slotSessHigh := -1
            eng.slotSessLow := -1
            eng.curSessionHigh := na
            eng.curSessionLow := na
            eng.curSessionCode := sess
            eng.curSessionStart := t
        // ---- day boundary -----------------------------------------------------------------
        if dk != eng.curDayIndex
            if eng.curDayIndex >= 0
                dropTimeRoot(eng, eng.slotPrevDayHigh)
                dropTimeRoot(eng, eng.slotPrevDayLow)
                eng.slotPrevDayHigh := eng.slotDayHigh
                eng.slotPrevDayLow := eng.slotDayLow
                relabelTimeRoot(eng, eng.slotPrevDayHigh, bit(3), true)
                relabelTimeRoot(eng, eng.slotPrevDayLow, bit(3), true)
            eng.slotDayHigh := -1
            eng.slotDayLow := -1
            eng.curDayHigh := na
            eng.curDayLow := na
            eng.curDayIndex := dk
        // ---- week boundary ------------------------------------------------------------------
        if wk != eng.curWeekIndex
            if eng.curWeekIndex >= 0
                dropTimeRoot(eng, eng.slotPrevWeekHigh)
                dropTimeRoot(eng, eng.slotPrevWeekLow)
                eng.slotPrevWeekHigh := eng.slotWeekHigh
                eng.slotPrevWeekLow := eng.slotWeekLow
                relabelTimeRoot(eng, eng.slotPrevWeekHigh, bit(5), true)
                relabelTimeRoot(eng, eng.slotPrevWeekLow, bit(5), true)
            eng.slotWeekHigh := -1
            eng.slotWeekLow := -1
            eng.curWeekHigh := na
            eng.curWeekLow := na
            eng.curWeekIndex := wk
        h = feed.baseHigh
        l = feed.baseLow
        // ---- current session extremes (no Root between 03:00 and 09:00 JST) -------------------
        if sess != 0
            if na(eng.curSessionHigh) or h > eng.curSessionHigh
                eng.curSessionHigh := h
                dropTimeRoot(eng, eng.slotSessHigh)
                eng.slotSessHigh := newTimeRoot(eng, cfg, true, h, t, bit(0), false, feed.baseSeq)
            if na(eng.curSessionLow) or l < eng.curSessionLow
                eng.curSessionLow := l
                dropTimeRoot(eng, eng.slotSessLow)
                eng.slotSessLow := newTimeRoot(eng, cfg, false, l, t, bit(0), false, feed.baseSeq)
        // ---- day extremes -----------------------------------------------------------------------
        if na(eng.curDayHigh) or h > eng.curDayHigh
            eng.curDayHigh := h
            dropTimeRoot(eng, eng.slotDayHigh)
            eng.slotDayHigh := newTimeRoot(eng, cfg, true, h, t, bit(2), false, feed.baseSeq)
        if na(eng.curDayLow) or l < eng.curDayLow
            eng.curDayLow := l
            dropTimeRoot(eng, eng.slotDayLow)
            eng.slotDayLow := newTimeRoot(eng, cfg, false, l, t, bit(2), false, feed.baseSeq)
        // ---- week extremes -----------------------------------------------------------------------
        if na(eng.curWeekHigh) or h > eng.curWeekHigh
            eng.curWeekHigh := h
            dropTimeRoot(eng, eng.slotWeekHigh)
            eng.slotWeekHigh := newTimeRoot(eng, cfg, true, h, t, bit(4), true, feed.baseSeq)
        if na(eng.curWeekLow) or l < eng.curWeekLow
            eng.curWeekLow := l
            dropTimeRoot(eng, eng.slotWeekLow)
            eng.slotWeekLow := newTimeRoot(eng, cfg, false, l, t, bit(4), true, feed.baseSeq)

// =====================================================================================
// Side-specific Root eligibility (App. A 9)
// =====================================================================================

sideEligibleRoot(ZoneEngine eng, int slot, int side) =>
    bool ok = false
    if array.get(eng.rLive, slot)
        cat = array.get(eng.rCat, slot)
        st = array.get(eng.rState, slot)
        if cat == 4
            // Bullish active -> Support only, Bearish active -> Resistance only,
            // Inverse active flips the participating side. Invalidated / InverseWait: neither.
            dirNow = st == 1 ? array.get(eng.rDir, slot) : (st == 4 ? -array.get(eng.rDir, slot) : 0)
            ok := (dirNow > 0 and side == 1) or (dirNow < 0 and side == -1)
        else
            ok := st == 1
    ok

densityOf(int widthTick, int denseTick, int mTick) =>
    widthTick <= denseTick ? 0 : (widthTick <= mTick ? 1 : -1)

baseStrongOf(int c, int h, int density) =>
    density == 0 and ((c == 2 and h >= 1) or c >= 3)

// =====================================================================================
// Candidate pool scratch (I12.3: only scalars are kept while comparing)
// =====================================================================================

cdReset(ZoneEngine eng) =>
    eng.cdLen := 0

cdPush(ZoneEngine eng, int side, int stage, float bot, float top, int botTick, int topTick, int c, int h, int catMask, int highMask, int density, bool strong, int created, int minRootId, int fvgMask, bool broadCtx) =>
    i = eng.cdLen
    if array.size(eng.cdSide) <= i
        array.push(eng.cdSide, side)
        array.push(eng.cdStage, stage)
        array.push(eng.cdBot, bot)
        array.push(eng.cdTop, top)
        array.push(eng.cdBotTick, botTick)
        array.push(eng.cdTopTick, topTick)
        array.push(eng.cdC, c)
        array.push(eng.cdH, h)
        array.push(eng.cdCatMask, catMask)
        array.push(eng.cdHighMask, highMask)
        array.push(eng.cdDensity, density)
        array.push(eng.cdStrong, strong)
        array.push(eng.cdCreated, created)
        array.push(eng.cdMinRootId, minRootId)
        array.push(eng.cdFvgMask, fvgMask)
        array.push(eng.cdBroadCtx, broadCtx)
        array.push(eng.cdRoots, newIntList())
        array.push(eng.cdOrder, i)
    else
        array.set(eng.cdSide, i, side)
        array.set(eng.cdStage, i, stage)
        array.set(eng.cdBot, i, bot)
        array.set(eng.cdTop, i, top)
        array.set(eng.cdBotTick, i, botTick)
        array.set(eng.cdTopTick, i, topTick)
        array.set(eng.cdC, i, c)
        array.set(eng.cdH, i, h)
        array.set(eng.cdCatMask, i, catMask)
        array.set(eng.cdHighMask, i, highMask)
        array.set(eng.cdDensity, i, density)
        array.set(eng.cdStrong, i, strong)
        array.set(eng.cdCreated, i, created)
        array.set(eng.cdMinRootId, i, minRootId)
        array.set(eng.cdFvgMask, i, fvgMask)
        array.set(eng.cdBroadCtx, i, broadCtx)
        array.set(eng.cdOrder, i, i)
        array.clear(array.get(eng.cdRoots, i).a)
    eng.cdLen := i + 1
    i

// I12.4 -- the single comparator used by every stage.
// returns true when candidate a ranks before candidate b.
cdLess(ZoneEngine eng, int a, int b) =>
    ca = array.get(eng.cdC, a)
    cb = array.get(eng.cdC, b)
    bool res = false
    if ca != cb
        res := ca > cb
    else
        ha = array.get(eng.cdH, a)
        hb = array.get(eng.cdH, b)
        if ha != hb
            res := ha > hb
        else
            wa = array.get(eng.cdTopTick, a) - array.get(eng.cdBotTick, a)
            wb = array.get(eng.cdTopTick, b) - array.get(eng.cdBotTick, b)
            if wa != wb
                res := wa < wb
            else
                ta = array.get(eng.cdCreated, a)
                tb = array.get(eng.cdCreated, b)
                if ta != tb
                    res := ta < tb
                else
                    res := array.get(eng.cdMinRootId, a) < array.get(eng.cdMinRootId, b)
    res

// Insertion sort over the candidate order index (pool is component sized, not global).
cdSortOrder(ZoneEngine eng, int from, int to) =>
    if (to) >= (from + 1)
        for i = from + 1 to to
            key = array.get(eng.cdOrder, i)
            j = i - 1
            while j >= from and cdLess(eng, key, array.get(eng.cdOrder, j))
                array.set(eng.cdOrder, j + 1, array.get(eng.cdOrder, j))
                j -= 1
            array.set(eng.cdOrder, j + 1, key)

// =====================================================================================
// Psychological price synthesis (I10 / spec 3.6): arithmetic only, never pre-generated.
// Returns the tick of the best psych level for the window, or na when none can join.
// =====================================================================================

psychBestTick(ZoneEngine eng, ZoneCfg cfg, int botTick, int topTick, int limitTick) =>
    mt = eng.mintick
    botP = botTick * mt
    topP = topTick * mt
    inside = math.floor(topP / 50.0) * 50.0
    int res = na
    if inside >= botP - mt * 0.5
        res := toTick(inside, mt)
    else
        below = math.floor(botP / 50.0) * 50.0
        above = math.ceil(topP / 50.0) * 50.0
        bTick = toTick(below, mt)
        aTick = toTick(above, mt)
        wb = topTick - bTick
        wa = aTick - botTick
        if wb <= limitTick and (wb <= wa or wa > limitTick)
            res := bTick
        else if wa <= limitTick
            res := aTick
    res

psychRootIdSeed(int priceTick) =>
    priceTick

// Materialise a psych Root only when an accepted candidate uses it (I10).
materialisePsych(ZoneEngine eng, ZoneCfg cfg, int priceTick, int seq) =>
    price = priceTick * eng.mintick
    isMajor = math.abs(price / 100.0 - math.round(price / 100.0)) < 0.0000001
    found = findRootByOrigin(eng, 5, isMajor ? 0 : 1, 0, psychRootIdSeed(priceTick), psychRootIdSeed(priceTick), 0, 0, priceTick)
    slot = found
    if slot < 0
        slot := rootCreate(eng, cfg, 5, isMajor ? 0 : 1, 0, 0, price, float(na), float(na), false, false, 0, psychRootIdSeed(priceTick), psychRootIdSeed(priceTick), 0, 0, 0, false, false, false, 1, seq)
    slot

// =====================================================================================
// Component gathering
// =====================================================================================

// first index in priceOrder whose tick >= target
priceOrderLowerBound(ZoneEngine eng, int tick) =>
    lo = 0
    hi = array.size(eng.priceOrder)
    while lo < hi
        mid = int(math.floor((lo + hi) / 2))
        s = array.get(eng.priceOrder, mid)
        if array.get(eng.rPriceTick, s) < tick
            lo := mid + 1
        else
            hi := mid
    lo

// Collect side-eligible point Roots (non FVG, non psych) inside a tick window.
gatherPointRoots(ZoneEngine eng, ZoneCfg cfg, int side, int loTick, int hiTick) =>
    len = 0
    start = priceOrderLowerBound(eng, loTick)
    n = array.size(eng.priceOrder)
    i = start
    while i < n
        s = array.get(eng.priceOrder, i)
        t = array.get(eng.rPriceTick, s)
        if t > hiTick
            break
        cat = array.get(eng.rCat, s)
        if cat != 5 and cat != 4
            if sideEligibleRoot(eng, s, side)
                len := scPush(eng.scSlots, len, s)
        i += 1
    len

// Collect side-eligible FVG Roots whose native range can interact with the window.
gatherFvgRoots(ZoneEngine eng, ZoneCfg cfg, int side, int loTick, int hiTick) =>
    len = 0
    n = array.size(eng.fvgOrder)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(eng.fvgOrder, i)
            if sideEligibleRoot(eng, s, side)
                nb = array.get(eng.rNatBotTick, s)
                nt = array.get(eng.rNatTopTick, s)
                if nt >= loTick and nb <= hiTick
                    len := scPush(eng.scAux, len, s)
    len

// =====================================================================================
// FVG attachment to a point-Root window (spec 5.5, 3.5 Broad, I14)
// Accepted FVG slots are written to eng.scAux2; returns
// [botTick, topTick, fvgJoined, fvgHigh, fvgMask, acceptedCount]
// =====================================================================================
fvgAttach(ZoneEngine eng, ZoneCfg cfg, int side, int botTick0, int topTick0, int limitTick, int denseTick, int nonFvgC, int nonFvgH, int fvgLen) =>
    curBot = botTick0
    curTop = topTick0
    cnt = 0
    mask = 0
    bool anyHigh = false
    pointDense = (topTick0 - botTick0) <= denseTick
    if (fvgLen - 1) >= (0)
        for i = 0 to fvgLen - 1
            f = array.get(eng.scAux, i)
            fb = array.get(eng.rNatBotTick, f)
            ft = array.get(eng.rNatTopTick, f)
            st = array.get(eng.rState, f)
            dirNow = st == 1 ? array.get(eng.rDir, f) : -array.get(eng.rDir, f)
            bool accepted = false
            bool viaProximal = false
            if ft >= curBot and fb <= curTop
                accepted := true
            else
                prox = dirNow > 0 ? ft : fb
                nb2 = math.min(curBot, prox)
                nt2 = math.max(curTop, prox)
                if (nt2 - nb2) <= limitTick
                    accepted := true
                    viaProximal := true
                    curBot := nb2
                    curTop := nt2
            if accepted
                cnt := scPush(eng.scAux2, cnt, f)
                mask := mask + (dirNow > 0 ? (hasBit(mask, 0) ? 0 : 1) : (hasBit(mask, 1) ? 0 : 2))
                if array.get(eng.rIntrHigh, f)
                    anyHigh := true
                if array.get(eng.rBroad, f)
                    // Broad localisation conditions (spec 3.5): (a) proximal edge with a dense
                    // other-category cluster, (c) a High quality other category inside,
                    // (d) two or more non-FVG independent categories densely inside.
                    if (viaProximal and pointDense and nonFvgC >= 1) or nonFvgH >= 1 or (nonFvgC >= 2 and pointDense)
                        anyHigh := true
    // (b) real overlap of same-direction FVGs from different timeframes
    if cnt >= 2
        if (cnt - 2) >= (0)
            for i = 0 to cnt - 2
                fa = array.get(eng.scAux2, i)
                sa = array.get(eng.rState, fa)
                da = sa == 1 ? array.get(eng.rDir, fa) : -array.get(eng.rDir, fa)
                if (cnt - 1) >= (i + 1)
                    for j = i + 1 to cnt - 1
                        fb2 = array.get(eng.scAux2, j)
                        sb = array.get(eng.rState, fb2)
                        db = sb == 1 ? array.get(eng.rDir, fb2) : -array.get(eng.rDir, fb2)
                        if da == db and array.get(eng.rTf, fa) != array.get(eng.rTf, fb2)
                            if array.get(eng.rNatTopTick, fa) >= array.get(eng.rNatBotTick, fb2) and array.get(eng.rNatBotTick, fa) <= array.get(eng.rNatTopTick, fb2)
                                anyHigh := true
    [curBot, curTop, cnt > 0, anyHigh, mask, cnt]

// =====================================================================================
// I12.2 -- window enumeration with differential C / H aggregation.
// Windows are contiguous in price order; for each left the exact dominating window is
// the narrowest one that still reaches the maximal (C, H) of that left (comparator
// order C desc, H desc, width asc), so only dominated windows are discarded.
// =====================================================================================
scanPointCandidates(ZoneEngine eng, ZoneCfg cfg, int side, int stage, int limitTick, int n, int denseTick, int mTick, int fvgLen) =>
    if (n - 1) >= (0)
        for left = 0 to n - 1
            slL = array.get(eng.scSlots, left)
            tickL = array.get(eng.rPriceTick, slL)
            catCnt0 = 0
            catCnt1 = 0
            catCnt2 = 0
            catCnt3 = 0
            catHi1 = 0
            catHi2 = 0
            catHi3 = 0
            maA = -1
            maB = -1
            acc60 = 0
            acc240 = 0
            accD = 0
            curMinId = 2147483647
            curCreated = 0
            prevC = 0
            prevH = 0
            snapIdx = left
            snapC = 0
            snapH = 0
            snapCat = 0
            snapHigh = 0
            snapMinId = 0
            snapCreated = 0
            rr = left
            while rr < n
                s = array.get(eng.scSlots, rr)
                bool ok = true
                if rr > left
                    w = array.get(eng.rPriceTick, s) - tickL
                    if w > limitTick
                        ok := false
                    else
                        pk = array.get(eng.rPairKey, s)
                        if pk != 0
                            if (rr - 1) >= (left)
                                for q = left to rr - 1
                                    if array.get(eng.rPairKey, array.get(eng.scSlots, q)) == pk
                                        ok := false
                                        break
                if not ok
                    break
                cat = array.get(eng.rCat, s)
                hiR = array.get(eng.rIntrHigh, s)
                if cat == 0
                    catCnt0 += 1
                    if maA < 0
                        maA := s
                    else
                        maB := s
                else if cat == 1
                    catCnt1 += 1
                    if hiR
                        catHi1 += 1
                else if cat == 2
                    catCnt2 += 1
                    if hiR
                        catHi2 += 1
                    tfa = array.get(eng.rTf, s)
                    if tfa == 60
                        acc60 += 1
                    else if tfa == 240
                        acc240 += 1
                    else
                        accD += 1
                else if cat == 3
                    catCnt3 += 1
                    if hiR
                        catHi3 += 1
                rid = array.get(eng.rId, s)
                if rid < curMinId
                    curMinId := rid
                ct = array.get(eng.rConfirmedTime, s)
                if ct > curCreated
                    curCreated := ct
                // --- masks (differential, no re-scan of the window) ---
                catMask = (catCnt0 > 0 ? 1 : 0) + (catCnt1 > 0 ? 2 : 0) + (catCnt2 > 0 ? 4 : 0) + (catCnt3 > 0 ? 8 : 0)
                bool maHigh = false
                if maA >= 0 and maB >= 0
                    dt = math.abs(array.get(eng.rPriceTick, maA) - array.get(eng.rPriceTick, maB))
                    sa = array.get(eng.rSlope, maA)
                    sb = array.get(eng.rSlope, maB)
                    maHigh := dt <= denseTick and ((side == 1 and sa == 1 and sb == 1) or (side == -1 and sa == -1 and sb == -1))
                accTfCount = (acc60 > 0 ? 1 : 0) + (acc240 > 0 ? 1 : 0) + (accD > 0 ? 1 : 0)
                highMask = (maHigh ? 1 : 0) + (catHi1 > 0 ? 2 : 0) + ((catHi2 > 0 or accTfCount >= 2) ? 4 : 0) + ((catHi3 > 0 or catCnt3 >= 2) ? 8 : 0)
                cNow = popcount6(catMask)
                hNow = popcount6(highMask)
                if cNow > prevC or hNow > prevH or rr == left
                    snapIdx := rr
                    snapC := cNow
                    snapH := hNow
                    snapCat := catMask
                    snapHigh := highMask
                    snapMinId := curMinId
                    snapCreated := curCreated
                    prevC := cNow
                    prevH := hNow
                rr += 1
                if eng.instrument
                    eng.statCandidateWindows += 1
            // ---- materialise the dominating window for this left --------------------------
            botTick = tickL
            topTick = array.get(eng.rPriceTick, array.get(eng.scSlots, snapIdx))
            cC = snapC
            hH = snapH
            catMaskF = snapCat
            highMaskF = snapHigh
            int psychTick = na
            if cfg.catPsychOn
                pt = psychBestTick(eng, cfg, botTick, topTick, limitTick)
                if not na(pt)
                    psychTick := pt
                    botTick := math.min(botTick, pt)
                    topTick := math.max(topTick, pt)
                    catMaskF := catMaskF + 32
                    cC += 1
            nonFvgC = cC
            nonFvgH = hH
            fvgBot = botTick
            fvgTop = topTick
            int fvgCnt = 0
            int fvgMask = 0
            bool fvgJoin = false
            bool fvgHigh = false
            if cfg.catFvgOn and fvgLen > 0
                [nb, nt, joined, fhigh, fmask, fcnt] = fvgAttach(eng, cfg, side, botTick, topTick, limitTick, denseTick, nonFvgC, nonFvgH, fvgLen)
                fvgBot := nb
                fvgTop := nt
                fvgJoin := joined
                fvgHigh := fhigh
                fvgMask := fmask
                fvgCnt := fcnt
            if fvgJoin
                botTick := fvgBot
                topTick := fvgTop
                catMaskF := catMaskF + 16
                cC += 1
                if fvgHigh
                    highMaskF := highMaskF + 16
                    hH += 1
            widthTick = topTick - botTick
            dens = densityOf(widthTick, denseTick, mTick)
            if dens >= 0
                strong = baseStrongOf(cC, hH, dens)
                if (stage == 0 and strong and dens == 0) or stage == 1
                    mt = eng.mintick
                    ci = cdPush(eng, side, stage, botTick * mt, topTick * mt, botTick, topTick, cC, hH, catMaskF, highMaskF, dens, strong, snapCreated, snapMinId, fvgMask, false)
                    lst = array.get(eng.cdRoots, ci).a
                    if (snapIdx) >= (left)
                        for q = left to snapIdx
                            array.push(lst, array.get(eng.scSlots, q))
                    if not na(psychTick)
                        array.push(lst, -(psychTick + 1))
                    if (fvgCnt - 1) >= (0)
                        for q = 0 to fvgCnt - 1
                            array.push(lst, array.get(eng.scAux2, q))

// =====================================================================================
// Stage B -- standalone FVG candidates (spec 5.5 / 10.2)
// =====================================================================================
scanFvgCandidates(ZoneEngine eng, ZoneCfg cfg, int side, int stage, int limitTick, int denseTick, int mTick, int fvgLen, int loTick, int hiTick) =>
    mt = eng.mintick
    if (fvgLen - 1) >= (0)
        for i = 0 to fvgLen - 1
            f = array.get(eng.scAux, i)
            fb = array.get(eng.rNatBotTick, f)
            ft = array.get(eng.rNatTopTick, f)
            // ownership rule: the component that contains the native bottom owns the
            // standalone FVG candidate, so overlapping components cannot duplicate it
            if fb < loTick or fb > hiTick
                continue
            broad = array.get(eng.rBroad, f)
            botTick = fb
            topTick = ft
            cC = 1
            hH = array.get(eng.rIntrHigh, f) ? 1 : 0
            catMaskF = 16
            highMaskF = hH > 0 ? 16 : 0
            int psychTick = na
            if broad
                // Broad, not localised: keep the whole NativeRange as Neutral context (I14)
                ci = cdPush(eng, side, stage, fb * mt, ft * mt, fb, ft, 1, 0, 16, 0, 2, false, array.get(eng.rConfirmedTime, f), array.get(eng.rId, f), array.get(eng.rDir, f) > 0 ? 1 : 2, true)
                array.push(array.get(eng.cdRoots, ci).a, f)
            else
                if cfg.catPsychOn
                    pt = psychBestTick(eng, cfg, botTick, topTick, limitTick)
                    if not na(pt)
                        nb2 = math.min(botTick, pt)
                        nt2 = math.max(topTick, pt)
                        if (nt2 - nb2) <= limitTick
                            psychTick := pt
                            botTick := nb2
                            topTick := nt2
                            catMaskF := catMaskF + 32
                            cC += 1
                dens = densityOf(topTick - botTick, denseTick, mTick)
                if dens >= 0
                    strong = baseStrongOf(cC, hH, dens)
                    if (stage == 0 and strong and dens == 0) or stage == 1
                        ci = cdPush(eng, side, stage, botTick * mt, topTick * mt, botTick, topTick, cC, hH, catMaskF, highMaskF, dens, strong, array.get(eng.rConfirmedTime, f), array.get(eng.rId, f), array.get(eng.rDir, f) > 0 ? 1 : 2, false)
                        lst = array.get(eng.cdRoots, ci).a
                        array.push(lst, f)
                        if not na(psychTick)
                            array.push(lst, -(psychTick + 1))
    // real overlap of same-direction FVGs from different timeframes -> common interval
    if fvgLen >= 2
        if (fvgLen - 2) >= (0)
            for i = 0 to fvgLen - 2
                fa = array.get(eng.scAux, i)
                sa = array.get(eng.rState, fa)
                da = sa == 1 ? array.get(eng.rDir, fa) : -array.get(eng.rDir, fa)
                if (fvgLen - 1) >= (i + 1)
                    for j = i + 1 to fvgLen - 1
                        fb2 = array.get(eng.scAux, j)
                        sb = array.get(eng.rState, fb2)
                        db = sb == 1 ? array.get(eng.rDir, fb2) : -array.get(eng.rDir, fb2)
                        if da == db and array.get(eng.rTf, fa) != array.get(eng.rTf, fb2)
                            lo = math.max(array.get(eng.rNatBotTick, fa), array.get(eng.rNatBotTick, fb2))
                            hi = math.min(array.get(eng.rNatTopTick, fa), array.get(eng.rNatTopTick, fb2))
                            if hi >= lo and lo >= loTick and lo <= hiTick
                                dens = densityOf(hi - lo, denseTick, mTick)
                                if dens >= 0 and stage == 1
                                    ci = cdPush(eng, side, stage, lo * mt, hi * mt, lo, hi, 1, 1, 16, 16, dens, false, math.max(array.get(eng.rConfirmedTime, fa), array.get(eng.rConfirmedTime, fb2)), math.min(array.get(eng.rId, fa), array.get(eng.rId, fb2)), da > 0 ? 1 : 2, false)
                                    lst = array.get(eng.cdRoots, ci).a
                                    array.push(lst, fa)
                                    array.push(lst, fb2)

// =====================================================================================
// Reference price (spec 5.6 / App. A 10.6). Display and tracking only -- never used by
// touch, break, density, strong or weak logic.
// =====================================================================================
medianOfScratch(ZoneEngine eng, int len) =>
    // insertion sort on the scratch tick buffer, then median
    if (len - 1) >= (1)
        for i = 1 to len - 1
            key = array.get(eng.scTicks, i)
            j = i - 1
            while j >= 0 and array.get(eng.scTicks, j) > key
                array.set(eng.scTicks, j + 1, array.get(eng.scTicks, j))
                j -= 1
            array.set(eng.scTicks, j + 1, key)
    float res = na
    if len > 0
        if len % 2 == 1
            res := array.get(eng.scTicks, int(math.floor(len / 2))) * eng.mintick
        else
            a = array.get(eng.scTicks, int(len / 2) - 1)
            b = array.get(eng.scTicks, int(len / 2))
            res := (a + b) * 0.5 * eng.mintick
    res

categoryMedian(ZoneEngine eng, array<int> roots, int cat) =>
    n = array.size(roots)
    len = 0
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(roots, i)
            if s >= 0
                if array.get(eng.rCat, s) == cat and not array.get(eng.rIsRange, s)
                    len := scPush(eng.scTicks, len, array.get(eng.rPriceTick, s))
    medianOfScratch(eng, len)

computeReferencePrice(ZoneEngine eng, ZoneCfg cfg, int side, array<int> roots, float effBot, float effTop) =>
    // category representatives for the point categories
    repSwing = categoryMedian(eng, roots, 1)
    repAccum = categoryMedian(eng, roots, 2)
    repTime  = categoryMedian(eng, roots, 3)
    repPsych = categoryMedian(eng, roots, 5)
    // MA representative: the real EMA closest to the other-category core, never a synthetic average
    float repMa = na
    n = array.size(roots)
    cnt = 0
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(roots, i)
            if s >= 0
                if array.get(eng.rCat, s) == 0
                    cnt += 1
    if cnt > 0
        float anchor = na
        anchorCnt = 0
        anchorSum = 0.0
        if not na(repSwing)
            anchorSum += repSwing
            anchorCnt += 1
        if not na(repAccum)
            anchorSum += repAccum
            anchorCnt += 1
        if not na(repTime)
            anchorSum += repTime
            anchorCnt += 1
        if anchorCnt > 0
            anchor := anchorSum / anchorCnt
        float best = na
        float bestD = na
        float sum = 0.0
        int msum = 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                s = array.get(roots, i)
                if s >= 0
                    if array.get(eng.rCat, s) == 0
                        p = array.get(eng.rPrice, s)
                        sum += p
                        msum += 1
                        if not na(anchor)
                            d = math.abs(p - anchor)
                            if na(bestD) or d < bestD
                                bestD := d
                                best := p
        repMa := na(anchor) ? (msum > 0 ? sum / msum : na) : best
    len = 0
    if not na(repMa)
        len := scPush(eng.scTicks, len, toTick(repMa, eng.mintick))
    if not na(repSwing)
        len := scPush(eng.scTicks, len, toTick(repSwing, eng.mintick))
    if not na(repAccum)
        len := scPush(eng.scTicks, len, toTick(repAccum, eng.mintick))
    if not na(repTime)
        len := scPush(eng.scTicks, len, toTick(repTime, eng.mintick))
    if not na(repPsych)
        len := scPush(eng.scTicks, len, toTick(repPsych, eng.mintick))
    float res = na
    if len > 0
        res := medianOfScratch(eng, len)
    else
        // FVG only / FVG overlap -> approach side proximal edge (never the 50% level)
        res := side == 1 ? effTop : effBot
    res

// =====================================================================================
// Winner list
// =====================================================================================
wcReset(ZoneEngine eng) =>
    eng.wcLen := 0

wcPush(ZoneEngine eng, ZoneCfg cfg, int cdIdx, int seq) =>
    i = eng.wcLen
    if array.size(eng.wcSide) <= i
        array.push(eng.wcSide, 0)
        array.push(eng.wcBot, na)
        array.push(eng.wcTop, na)
        array.push(eng.wcC, 0)
        array.push(eng.wcH, 0)
        array.push(eng.wcCatMask, 0)
        array.push(eng.wcHighMask, 0)
        array.push(eng.wcDensity, 1)
        array.push(eng.wcStrong, false)
        array.push(eng.wcBroadCtx, false)
        array.push(eng.wcFvgMask, 0)
        array.push(eng.wcCreated, 0)
        array.push(eng.wcMinRootId, 0)
        array.push(eng.wcCoreSlot, -1)
        array.push(eng.wcGroup, -1)
        array.push(eng.wcRoots, newIntList())
    side = array.get(eng.cdSide, cdIdx)
    array.set(eng.wcSide, i, side)
    array.set(eng.wcBot, i, array.get(eng.cdBot, cdIdx))
    array.set(eng.wcTop, i, array.get(eng.cdTop, cdIdx))
    array.set(eng.wcC, i, array.get(eng.cdC, cdIdx))
    array.set(eng.wcH, i, array.get(eng.cdH, cdIdx))
    array.set(eng.wcCatMask, i, array.get(eng.cdCatMask, cdIdx))
    array.set(eng.wcHighMask, i, array.get(eng.cdHighMask, cdIdx))
    array.set(eng.wcDensity, i, array.get(eng.cdDensity, cdIdx))
    array.set(eng.wcStrong, i, array.get(eng.cdStrong, cdIdx))
    array.set(eng.wcBroadCtx, i, array.get(eng.cdBroadCtx, cdIdx))
    array.set(eng.wcFvgMask, i, array.get(eng.cdFvgMask, cdIdx))
    array.set(eng.wcCreated, i, array.get(eng.cdCreated, cdIdx))
    array.set(eng.wcMinRootId, i, array.get(eng.cdMinRootId, cdIdx))
    array.set(eng.wcCoreSlot, i, -1)
    array.set(eng.wcGroup, i, -1)
    dst = array.get(eng.wcRoots, i).a
    array.clear(dst)
    src = array.get(eng.cdRoots, cdIdx).a
    m = array.size(src)
    if (m - 1) >= (0)
        for k = 0 to m - 1
            v = array.get(src, k)
            if v < 0
                // psych placeholder -> materialise only now that the candidate is accepted
                ps = materialisePsych(eng, cfg, -v - 1, seq)
                array.push(dst, ps)
                if side == 1
                    array.set(eng.rootUsedSup, ps, true)
                else
                    array.set(eng.rootUsedRes, ps, true)
            else
                array.push(dst, v)
    eng.wcLen := i + 1
    i

// A Root is exclusive per side; only Broad FVG may be shared between local Zones (5.3).
rootShareable(ZoneEngine eng, int slot) =>
    array.get(eng.rCat, slot) == 4 and array.get(eng.rBroad, slot)

candidateAvailable(ZoneEngine eng, int cdIdx) =>
    side = array.get(eng.cdSide, cdIdx)
    src = array.get(eng.cdRoots, cdIdx).a
    m = array.size(src)
    bool ok = true
    if (m - 1) >= (0)
        for k = 0 to m - 1
            v = array.get(src, k)
            if v >= 0
                if not rootShareable(eng, v)
                    if side == 1 ? array.get(eng.rootUsedSup, v) : array.get(eng.rootUsedRes, v)
                        ok := false
                        break
            else
                // a psych level that is already materialised and used by another Zone
                ptick = -v - 1
                price = ptick * eng.mintick
                isMajor = math.abs(price / 100.0 - math.round(price / 100.0)) < 0.0000001
                ex = findRootByOrigin(eng, 5, isMajor ? 0 : 1, 0, ptick, ptick, 0, 0, ptick)
                if ex >= 0
                    if side == 1 ? array.get(eng.rootUsedSup, ex) : array.get(eng.rootUsedRes, ex)
                        ok := false
                        break
    ok

markCandidateUsed(ZoneEngine eng, int cdIdx) =>
    side = array.get(eng.cdSide, cdIdx)
    src = array.get(eng.cdRoots, cdIdx).a
    m = array.size(src)
    if (m - 1) >= (0)
        for k = 0 to m - 1
            v = array.get(src, k)
            if v >= 0
                if not rootShareable(eng, v)
                    if side == 1
                        array.set(eng.rootUsedSup, v, true)
                    else
                        array.set(eng.rootUsedRes, v, true)

// =====================================================================================
// Core assembly: Side winners -> physical ZoneCore (App. A 10.7), Identity / Merge /
// Split against the previous generation (App. A 17, I15).
// =====================================================================================

intervalGapTick(int a1, int a2, int b1, int b2) =>
    math.max(0, math.max(a1, b1) - math.min(a2, b2))

// Do two Side winners describe the same physical Zone?
winnersShareCore(ZoneEngine eng, ZoneCfg cfg, int i, int j, int mTick) =>
    ai = array.get(eng.wcRoots, i).a
    aj = array.get(eng.wcRoots, j).a
    bool shared = false
    ni = array.size(ai)
    nj = array.size(aj)
    if (ni - 1) >= (0)
        for x = 0 to ni - 1
            sx = array.get(ai, x)
            cx = array.get(eng.rCat, sx)
            if cx != 5
                if (nj - 1) >= (0)
                    for y = 0 to nj - 1
                        if array.get(aj, y) == sx
                            if cx != 4 or not array.get(eng.rBroad, sx)
                                shared := true
                                break
            if shared
                break
    bool res = false
    if shared
        gap = intervalGapTick(toTick(array.get(eng.wcBot, i), eng.mintick), toTick(array.get(eng.wcTop, i), eng.mintick), toTick(array.get(eng.wcBot, j), eng.mintick), toTick(array.get(eng.wcTop, j), eng.mintick))
        res := gap <= mTick
    res

// Number of shared non Broad-FVG, non psych origin Roots between a winner and a Core.
sharedOriginCount(ZoneEngine eng, int wcIdx, int coreSlot) =>
    a = array.get(eng.wcRoots, wcIdx).a
    b = array.get(eng.cOriginRoots, coreSlot).a
    n = array.size(a)
    m = array.size(b)
    cnt = 0
    if (n - 1) >= (0)
        for x = 0 to n - 1
            sx = array.get(a, x)
            if array.get(eng.rCat, sx) != 5 and not (array.get(eng.rCat, sx) == 4 and array.get(eng.rBroad, sx))
                id = array.get(eng.rId, sx)
                if (m - 1) >= (0)
                    for y = 0 to m - 1
                        if array.get(b, y) == id
                            cnt += 1
                            break
    cnt

ringHasSame(ZoneEngine eng, ZoneCfg cfg, int coreSlot, int t, int side, float cbot, float ctop) =>
    ring = array.get(eng.cTouch, coreSlot)
    cap = math.max(1, cfg.maxTouchMarksPerCore)
    bool found = false
    if (ring.count - 1) >= (0)
        for i = 0 to ring.count - 1
            p = ringIndex(ring, cap, i)
            if array.get(ring.time, p) == t and array.get(ring.side, p) == side
                if array.get(ring.contactBottom, p) == cbot and array.get(ring.contactTop, p) == ctop
                    found := true
                    break
    found

// Copy TouchMarks that actually touched the target range (App. A 17.2 / 17.3).
ringTransfer(ZoneEngine eng, ZoneCfg cfg, int dstSlot, int srcSlot, float fBot, float fTop) =>
    src = array.get(eng.cTouch, srcSlot)
    dst = array.get(eng.cTouch, dstSlot)
    cap = math.max(1, cfg.maxTouchMarksPerCore)
    if (src.count - 1) >= (0)
        for i = 0 to src.count - 1
            p = ringIndex(src, cap, i)
            cb = array.get(src.contactBottom, p)
            ct = array.get(src.contactTop, p)
            bool keep = true
            if not na(fBot) and not na(fTop)
                keep := not na(cb) and not na(ct) and ct >= fBot and cb <= fTop
            if keep
                if not ringHasSame(eng, cfg, dstSlot, array.get(src.time, p), array.get(src.side, p), cb, ct)
                    if dst.count >= cap
                        eng.touchHistoryTruncated := true
                    ringPush(dst, cap, array.get(src.baseSeq, p), array.get(src.time, p), array.get(src.side, p), cb, ct, array.get(src.closeAtTouch, p), array.get(src.generationId, p), array.get(src.isNormalTouch, p))


applyWinnerToSide(ZoneEngine eng, ZoneCfg cfg, int coreSlot, int wcIdx, int barTime) =>
    side = array.get(eng.wcSide, wcIdx)
    sideIdx = sideIdxOfSide(side)
    ss = sideSlotOf(coreSlot, sideIdx)
    clearSideGeometry(eng, ss)
    array.set(eng.sEligible, ss, true)
    array.set(eng.sEffBot, ss, array.get(eng.wcBot, wcIdx))
    array.set(eng.sEffTop, ss, array.get(eng.wcTop, wcIdx))
    array.set(eng.sEffBotTick, ss, toTick(array.get(eng.wcBot, wcIdx), eng.mintick))
    array.set(eng.sEffTopTick, ss, toTick(array.get(eng.wcTop, wcIdx), eng.mintick))
    array.set(eng.sC, ss, array.get(eng.wcC, wcIdx))
    array.set(eng.sH, ss, array.get(eng.wcH, wcIdx))
    array.set(eng.sCatMask, ss, array.get(eng.wcCatMask, wcIdx))
    array.set(eng.sHighMask, ss, array.get(eng.wcHighMask, wcIdx))
    array.set(eng.sDensity, ss, array.get(eng.wcDensity, wcIdx))
    array.set(eng.sBaseStrong, ss, array.get(eng.wcStrong, wcIdx))
    array.set(eng.sBroadCtx, ss, array.get(eng.wcBroadCtx, wcIdx))
    array.set(eng.sFvgDirMask, ss, array.get(eng.wcFvgMask, wcIdx))
    dst = array.get(eng.sRoots, ss).a
    src = array.get(eng.wcRoots, wcIdx).a
    n = array.size(src)
    bool nonPsych = false
    fvgCnt = 0
    fvgFresh = 0
    fvgState = 0
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(src, i)
            array.push(dst, s)
            cat = array.get(eng.rCat, s)
            if cat != 5
                nonPsych := true
            if cat == 4
                fvgCnt += 1
                if array.get(eng.rFresh, s)
                    fvgFresh += 1
                st = array.get(eng.rState, s)
                fvgState := fvgState + (hasBit(fvgState, st) ? 0 : bit(st))
            if sideIdx == 0
                array.set(eng.rCoreSup, s, coreSlot)
            else
                array.set(eng.rCoreRes, s, coreSlot)
    array.set(eng.sHasNonPsych, ss, nonPsych)
    array.set(eng.sFvgCount, ss, fvgCnt)
    array.set(eng.sFvgFreshCount, ss, fvgFresh)
    array.set(eng.sFvgStateMask, ss, fvgState)
    array.set(eng.sRefPrice, ss, computeReferencePrice(eng, cfg, side, dst, array.get(eng.wcBot, wcIdx), array.get(eng.wcTop, wcIdx)))
    eng.coreRangeRevision += 1

// Core origin Root ID set = union of both Side Root sets (non psych).
refreshCoreOrigins(ZoneEngine eng, int coreSlot, int barTime) =>
    a = array.get(eng.cOriginRoots, coreSlot).a
    array.clear(a)
    float lo = na
    float hi = na
    for k = 0 to 1
        ss = sideSlotOf(coreSlot, k)
        if array.get(eng.sEligible, ss)
            b = array.get(eng.sRoots, ss).a
            n = array.size(b)
            if (n - 1) >= (0)
                for i = 0 to n - 1
                    s = array.get(b, i)
                    if array.get(eng.rCat, s) != 5
                        id = array.get(eng.rId, s)
                        bool dup = false
                        m = array.size(a)
                        if (m - 1) >= (0)
                            for y = 0 to m - 1
                                if array.get(a, y) == id
                                    dup := true
                                    break
                        if not dup
                            array.push(a, id)
            bb = array.get(eng.sEffBot, ss)
            tt = array.get(eng.sEffTop, ss)
            lo := na(lo) ? bb : math.min(lo, bb)
            hi := na(hi) ? tt : math.max(hi, tt)
    if not na(lo)
        array.set(eng.cRangeBot, coreSlot, lo)
        array.set(eng.cRangeTop, coreSlot, hi)
    array.set(eng.cLastSeen, coreSlot, barTime)

// =====================================================================================
// Side winner construction for one component (I12 three stages)
// =====================================================================================
selectFromPool(ZoneEngine eng, ZoneCfg cfg, int seq) =>
    if eng.cdLen > 0
        cdSortOrder(eng, 0, eng.cdLen - 1)
        if (eng.cdLen - 1) >= (0)
            for k = 0 to eng.cdLen - 1
                idx = array.get(eng.cdOrder, k)
                if candidateAvailable(eng, idx)
                    markCandidateUsed(eng, idx)
                    wcPush(eng, cfg, idx, seq)

buildSideWinners(ZoneEngine eng, ZoneCfg cfg, int side, int loTick, int hiTick, int denseTick, int mTick, int seq) =>
    n = gatherPointRoots(eng, cfg, side, loTick, hiTick)
    fvgLen = gatherFvgRoots(eng, cfg, side, loTick, hiTick)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(eng.scSlots, i)
            if side == 1
                array.set(eng.rootUsedSup, s, false)
            else
                array.set(eng.rootUsedRes, s, false)
    if (fvgLen - 1) >= (0)
        for i = 0 to fvgLen - 1
            s = array.get(eng.scAux, i)
            if side == 1
                array.set(eng.rootUsedSup, s, false)
            else
                array.set(eng.rootUsedRes, s, false)
    ps = array.get(eng.catSets, 5).a
    pn = array.size(ps)
    if (pn - 1) >= (0)
        for i = 0 to pn - 1
            s = array.get(ps, i)
            t = array.get(eng.rPriceTick, s)
            if t >= loTick - mTick and t <= hiTick + mTick
                if side == 1
                    array.set(eng.rootUsedSup, s, false)
                else
                    array.set(eng.rootUsedRes, s, false)
    // ---- stage A/B: Dense Base Strong cores have priority over normal clustering (5.2)
    cdReset(eng)
    if n > 0
        scanPointCandidates(eng, cfg, side, 0, denseTick, n, denseTick, mTick, fvgLen)
    selectFromPool(eng, cfg, seq)
    // ---- stage C: normal candidates from the Roots that were not taken by a Dense core
    m2 = 0
    if (n - 1) >= (0)
        for i = 0 to n - 1
            s = array.get(eng.scSlots, i)
            bool used = side == 1 ? array.get(eng.rootUsedSup, s) : array.get(eng.rootUsedRes, s)
            if not used
                array.set(eng.scSlots, m2, s)
                m2 += 1
    cdReset(eng)
    if m2 > 0
        scanPointCandidates(eng, cfg, side, 1, mTick, m2, denseTick, mTick, fvgLen)
    if cfg.catFvgOn and fvgLen > 0
        scanFvgCandidates(eng, cfg, side, 1, mTick, denseTick, mTick, fvgLen, loTick, hiTick)
    selectFromPool(eng, cfg, seq)

// =====================================================================================
// LiveStructure (App. A 16.1 / I11.2): participation loss is applied immediately even
// while an Episode is running; only the shape change is deferred to PendingTopology.
// =====================================================================================
liveStructureUpdate(ZoneEngine eng, ZoneCfg cfg, int coreSlot) =>
    for k = 0 to 1
        ss = sideSlotOf(coreSlot, k)
        if array.get(eng.sEligible, ss)
            side = sideOfIdx(k)
            a = array.get(eng.sRoots, ss).a
            n = array.size(a)
            w = 0
            catMask = 0
            highMask = 0
            bool nonPsych = false
            fvgCnt = 0
            fvgFresh = 0
            fvgState = 0
            fvgMask = 0
            maA = -1
            maB = -1
            catHi1 = 0
            catHi2 = 0
            catHi3 = 0
            catCnt3 = 0
            acc60 = 0
            acc240 = 0
            accD = 0
            bool fvgHigh = false
            if (n - 1) >= (0)
                for i = 0 to n - 1
                    s = array.get(a, i)
                    bool keep = array.get(eng.rLive, s)
                    if keep and array.get(eng.rCat, s) != 5
                        keep := sideEligibleRoot(eng, s, side)
                    if keep
                        array.set(a, w, s)
                        w += 1
                        cat = array.get(eng.rCat, s)
                        catMask := catMask + (hasBit(catMask, cat) ? 0 : bit(cat))
                        if cat != 5
                            nonPsych := true
                        if cat == 0
                            if maA < 0
                                maA := s
                            else
                                maB := s
                        else if cat == 1
                            if array.get(eng.rIntrHigh, s)
                                catHi1 += 1
                        else if cat == 2
                            if array.get(eng.rIntrHigh, s)
                                catHi2 += 1
                            tfa = array.get(eng.rTf, s)
                            if tfa == 60
                                acc60 += 1
                            else if tfa == 240
                                acc240 += 1
                            else
                                accD += 1
                        else if cat == 3
                            catCnt3 += 1
                            if array.get(eng.rIntrHigh, s)
                                catHi3 += 1
                        else if cat == 4
                            fvgCnt += 1
                            if array.get(eng.rFresh, s)
                                fvgFresh += 1
                            st = array.get(eng.rState, s)
                            fvgState := fvgState + (hasBit(fvgState, st) ? 0 : bit(st))
                            dirNow = st == 1 ? array.get(eng.rDir, s) : -array.get(eng.rDir, s)
                            fvgMask := fvgMask + (dirNow > 0 ? (hasBit(fvgMask, 0) ? 0 : 1) : (hasBit(fvgMask, 1) ? 0 : 2))
                            if array.get(eng.rIntrHigh, s)
                                fvgHigh := true
                    else
                        if k == 0
                            array.set(eng.rCoreSup, s, -1)
                        else
                            array.set(eng.rCoreRes, s, -1)
            while array.size(a) > w
                array.pop(a)
            denseTick = toTick(cfg.clusterMaxWidth * cfg.denseRatio, eng.mintick)
            bool maHigh = false
            if maA >= 0 and maB >= 0
                dt = math.abs(array.get(eng.rPriceTick, maA) - array.get(eng.rPriceTick, maB))
                sa = array.get(eng.rSlope, maA)
                sb = array.get(eng.rSlope, maB)
                maHigh := dt <= denseTick and ((side == 1 and sa == 1 and sb == 1) or (side == -1 and sa == -1 and sb == -1))
            accTfCount = (acc60 > 0 ? 1 : 0) + (acc240 > 0 ? 1 : 0) + (accD > 0 ? 1 : 0)
            highMask := (maHigh ? 1 : 0) + (catHi1 > 0 ? 2 : 0) + ((catHi2 > 0 or accTfCount >= 2) ? 4 : 0) + ((catHi3 > 0 or catCnt3 >= 2) ? 8 : 0) + (fvgHigh ? 16 : 0)
            c = popcount6(catMask)
            h = popcount6(highMask)
            array.set(eng.sC, ss, c)
            array.set(eng.sH, ss, h)
            array.set(eng.sCatMask, ss, catMask)
            array.set(eng.sHighMask, ss, highMask)
            array.set(eng.sHasNonPsych, ss, nonPsych)
            array.set(eng.sFvgCount, ss, fvgCnt)
            array.set(eng.sFvgFreshCount, ss, fvgFresh)
            array.set(eng.sFvgStateMask, ss, fvgState)
            array.set(eng.sFvgDirMask, ss, fvgMask)
            array.set(eng.sBaseStrong, ss, baseStrongOf(c, h, array.get(eng.sDensity, ss)))
            array.set(eng.sEligible, ss, nonPsych)

coreHasProtectedState(ZoneEngine eng, int coreSlot) =>
    bool prot = array.get(eng.cPendingGen, coreSlot)
    for k = 0 to 1
        ph = array.get(eng.sPhase, sideSlotOf(coreSlot, k))
        if ph == 2 or ph == 3 or ph == 4
            prot := true
    prot

// =====================================================================================
// Candidate cache (I12.7). The key carries every revision the computation reads.
// A hash match is never accepted without the exact input Root list comparison.
// A hit proves the winners are unchanged, so the live Cores are reused as the result;
// candidate count 0 is a normal cached result too.
// =====================================================================================
componentSignature(ZoneEngine eng, ZoneCfg cfg, int loTick, int hiTick) =>
    len = 0
    h = 2166136261
    start = priceOrderLowerBound(eng, loTick)
    n = array.size(eng.priceOrder)
    i = start
    while i < n
        s = array.get(eng.priceOrder, i)
        if array.get(eng.rPriceTick, s) > hiTick
            break
        len := scPush(eng.scTicks, len, array.get(eng.rId, s))
        len := scPush(eng.scTicks, len, array.get(eng.rPriceTick, s))
        len := scPush(eng.scTicks, len, array.get(eng.rGeomRev, s))
        len := scPush(eng.scTicks, len, array.get(eng.rQualRev, s))
        len := scPush(eng.scTicks, len, array.get(eng.rStateRev, s))
        i += 1
    m = array.size(eng.fvgOrder)
    if (m - 1) >= (0)
        for k = 0 to m - 1
            s = array.get(eng.fvgOrder, k)
            nb = array.get(eng.rNatBotTick, s)
            nt = array.get(eng.rNatTopTick, s)
            if nt >= loTick and nb <= hiTick
                len := scPush(eng.scTicks, len, array.get(eng.rId, s))
                len := scPush(eng.scTicks, len, nb)
                len := scPush(eng.scTicks, len, nt)
                len := scPush(eng.scTicks, len, array.get(eng.rState, s))
                len := scPush(eng.scTicks, len, array.get(eng.rFresh, s) ? 1 : 0)
    if (len - 1) >= (0)
        for k = 0 to len - 1
            h := mixHash(h, array.get(eng.scTicks, k))
    [h, len]

ccExactMatch(ZoneEngine eng, int entry, int len) =>
    a = array.get(eng.ccInputRoots, entry).a
    bool same = array.size(a) == len
    if same
        if (len - 1) >= (0)
            for i = 0 to len - 1
                if array.get(a, i) != array.get(eng.scTicks, i)
                    same := false
                    break
    same

ccLookup(ZoneEngine eng, ZoneCfg cfg, int h, int len) =>
    cap = array.size(eng.ccValid)
    found = -1
    if (cap - 1) >= (0)
        for i = 0 to cap - 1
            if array.get(eng.ccValid, i) and array.get(eng.ccHash, i) == h and array.get(eng.ccSide, i) == 0
                if array.get(eng.ccCfgRev, i) == eng.cfgRevision and array.get(eng.ccQualRev, i) == eng.rootQualityRevision and array.get(eng.ccFvgRev, i) == eng.fvgStateRevision and array.get(eng.ccTieRev, i) == eng.rootRegistryRevision and array.get(eng.ccGeomRev, i) == eng.rootPriceRevision and array.get(eng.ccEpoch, i) == eng.fvgFreshRevision
                    if ccExactMatch(eng, i, len)
                        found := i
                        break
    found

ccStore(ZoneEngine eng, ZoneCfg cfg, int h, int len) =>
    cap = array.size(eng.ccValid)
    if cap > 0
        slot = -1
        if (cap - 1) >= (0)
            for i = 0 to cap - 1
                if not array.get(eng.ccValid, i)
                    slot := i
                    break
        if slot < 0
            oldest = array.get(eng.ccLru, 0)
            slot := 0
            if (cap - 1) >= (1)
                for i = 1 to cap - 1
                    if array.get(eng.ccLru, i) < oldest
                        oldest := array.get(eng.ccLru, i)
                        slot := i
        eng.ccClock += 1
        array.set(eng.ccValid, slot, true)
        array.set(eng.ccSide, slot, 0)
        array.set(eng.ccHash, slot, h)
        array.set(eng.ccCfgRev, slot, eng.cfgRevision)
        array.set(eng.ccGeomRev, slot, eng.rootPriceRevision)
        array.set(eng.ccQualRev, slot, eng.rootQualityRevision)
        array.set(eng.ccFvgRev, slot, eng.fvgStateRevision)
        array.set(eng.ccTieRev, slot, eng.rootRegistryRevision)
        array.set(eng.ccEpoch, slot, eng.fvgFreshRevision)
        array.set(eng.ccLru, slot, eng.ccClock)
        a = array.get(eng.ccInputRoots, slot).a
        array.clear(a)
        if (len - 1) >= (0)
            for i = 0 to len - 1
                array.push(a, array.get(eng.scTicks, i))

// =====================================================================================
// Component recomputation (I13): Identity -> Merge / Split -> new Cores
// =====================================================================================
recomputeComponent(ZoneEngine eng, ZoneCfg cfg, Feed feed, int loTick, int hiTick) =>
    mt = eng.mintick
    mTick = toTick(cfg.clusterMaxWidth, mt)
    denseTick = toTick(cfg.clusterMaxWidth * cfg.denseRatio, mt)
    barTime = feed.baseCloseTime
    seq = feed.baseSeq
    if eng.instrument
        eng.statComponents += 1
    // ---- 1. old Cores that can correspond to this component ---------------------------
    oldLen = 0
    nlive = array.size(eng.cLiveList)
    if (nlive - 1) >= (0)
        for i = 0 to nlive - 1
            cs = array.get(eng.cLiveList, i)
            cb = array.get(eng.cRangeBot, cs)
            ct = array.get(eng.cRangeTop, cs)
            bool hit = na(cb) or na(ct)
            if not hit
                hit := toTick(ct, mt) >= loTick - mTick and toTick(cb, mt) <= hiTick + mTick
            if hit
                oldLen := scPush(eng.oldCoreList, oldLen, cs)
    // Root -> Core index: pull in Cores that own a Root of this component but sit outside
    start = priceOrderLowerBound(eng, loTick)
    np = array.size(eng.priceOrder)
    i2 = start
    while i2 < np
        s = array.get(eng.priceOrder, i2)
        if array.get(eng.rPriceTick, s) > hiTick
            break
        for k = 0 to 1
            cs = k == 0 ? array.get(eng.rCoreSup, s) : array.get(eng.rCoreRes, s)
            if cs >= 0
                bool dup = false
                if (oldLen - 1) >= (0)
                    for q = 0 to oldLen - 1
                        if array.get(eng.oldCoreList, q) == cs
                            dup := true
                            break
                if not dup
                    oldLen := scPush(eng.oldCoreList, oldLen, cs)
        i2 += 1
    // ---- 2. ActiveTouch freeze: shape changes are deferred (App. A 16, I8 Stage I) ------
    bool pending = false
    if (oldLen - 1) >= (0)
        for q = 0 to oldLen - 1
            cs = array.get(eng.oldCoreList, q)
            for k = 0 to 1
                if array.get(eng.sPhase, sideSlotOf(cs, k)) == 2
                    pending := true
    if pending
        if (oldLen - 1) >= (0)
            for q = 0 to oldLen - 1
                cs = array.get(eng.oldCoreList, q)
                array.set(eng.cPending, cs, true)
                liveStructureUpdate(eng, cfg, cs)
        array.push(eng.pendSeedRoots, loTick)
        array.push(eng.pendSeedRoots, hiTick)
        eng.pendingRevision += 1
    else
        // ---- 3. candidate cache -----------------------------------------------------------
        [sigHash, sigLen] = componentSignature(eng, cfg, loTick, hiTick)
        hitEntry = ccLookup(eng, cfg, sigHash, sigLen)
        if hitEntry >= 0
            if eng.instrument
                eng.statCacheHit += 1
            array.set(eng.ccLru, hitEntry, eng.ccClock + 1)
            eng.ccClock += 1
        else
            if eng.instrument
                eng.statCacheMiss += 1
            ccStore(eng, cfg, sigHash, sigLen)
            // ---- 4. Side winners -------------------------------------------------------------
            wcReset(eng)
            buildSideWinners(eng, cfg, 1, loTick, hiTick, denseTick, mTick, seq)
            buildSideWinners(eng, cfg, -1, loTick, hiTick, denseTick, mTick, seq)
            // ---- 5. group Support / Resistance winners into physical Cores (10.7) -----------
            grpLen = 0
            if (eng.wcLen - 1) >= (0)
                for a = 0 to eng.wcLen - 1
                    if array.get(eng.wcSide, a) == 1 and array.get(eng.wcGroup, a) < 0
                        g = grpLen
                        grpLen := scPush(eng.grpFirst, grpLen, a)
                        scPush(eng.grpSecond, g, -1)
                        scPush(eng.grpCore, g, -1)
                        scPush(eng.grpBestOld, g, -1)
                        array.set(eng.wcGroup, a, g)
                        if (eng.wcLen - 1) >= (0)
                            for b = 0 to eng.wcLen - 1
                                if array.get(eng.wcSide, b) == -1 and array.get(eng.wcGroup, b) < 0
                                    if winnersShareCore(eng, cfg, a, b, mTick)
                                        array.set(eng.grpSecond, g, b)
                                        array.set(eng.wcGroup, b, g)
                                        break
            if (eng.wcLen - 1) >= (0)
                for b = 0 to eng.wcLen - 1
                    if array.get(eng.wcSide, b) == -1 and array.get(eng.wcGroup, b) < 0
                        g = grpLen
                        grpLen := scPush(eng.grpFirst, grpLen, -1)
                        scPush(eng.grpSecond, g, b)
                        scPush(eng.grpCore, g, -1)
                        scPush(eng.grpBestOld, g, -1)
                        array.set(eng.wcGroup, b, g)
            // ---- 6. Identity: primary old Core per group (oldest matching Core ID) ----------
            if (oldLen - 1) >= (0)
                for q = 0 to oldLen - 1
                    scPush(eng.oldChosenBy, q, -1)
            if (grpLen - 1) >= (0)
                for g = 0 to grpLen - 1
                    w1 = array.get(eng.grpFirst, g)
                    w2 = array.get(eng.grpSecond, g)
                    gb = 2147483647
                    gt = -2147483647
                    if w1 >= 0
                        gb := math.min(gb, toTick(array.get(eng.wcBot, w1), mt))
                        gt := math.max(gt, toTick(array.get(eng.wcTop, w1), mt))
                    if w2 >= 0
                        gb := math.min(gb, toTick(array.get(eng.wcBot, w2), mt))
                        gt := math.max(gt, toTick(array.get(eng.wcTop, w2), mt))
                    best = -1
                    bestId = 2147483647
                    if (oldLen - 1) >= (0)
                        for q = 0 to oldLen - 1
                            cs = array.get(eng.oldCoreList, q)
                            if array.get(eng.cLive, cs)
                                sh = (w1 >= 0 ? sharedOriginCount(eng, w1, cs) : 0) + (w2 >= 0 ? sharedOriginCount(eng, w2, cs) : 0)
                                if sh >= 1
                                    cb = array.get(eng.cRangeBot, cs)
                                    ct = array.get(eng.cRangeTop, cs)
                                    gap = (na(cb) or na(ct)) ? 0 : intervalGapTick(toTick(cb, mt), toTick(ct, mt), gb, gt)
                                    if gap <= mTick
                                        if eng.instrument
                                            eng.statCorePairs += 1
                                        if array.get(eng.cId, cs) < bestId
                                            bestId := array.get(eng.cId, cs)
                                            best := q
                    array.set(eng.grpBestOld, g, best)
            // ---- 7. Split: one old Core claimed by several groups ----------------------------
            if (oldLen - 1) >= (0)
                for q = 0 to oldLen - 1
                    cnt = 0
                    keep = -1
                    keepShared = -1
                    keepMinId = 2147483647
                    if (grpLen - 1) >= (0)
                        for g = 0 to grpLen - 1
                            if array.get(eng.grpBestOld, g) == q
                                cnt += 1
                                w1 = array.get(eng.grpFirst, g)
                                w2 = array.get(eng.grpSecond, g)
                                cs = array.get(eng.oldCoreList, q)
                                sh = (w1 >= 0 ? sharedOriginCount(eng, w1, cs) : 0) + (w2 >= 0 ? sharedOriginCount(eng, w2, cs) : 0)
                                mid = w1 >= 0 ? array.get(eng.wcMinRootId, w1) : array.get(eng.wcMinRootId, w2)
                                if sh > keepShared or (sh == keepShared and mid < keepMinId)
                                    keepShared := sh
                                    keepMinId := mid
                                    keep := g
                    if cnt >= 2
                        cs = array.get(eng.oldCoreList, q)
                        if (grpLen - 1) >= (0)
                            for g = 0 to grpLen - 1
                                if array.get(eng.grpBestOld, g) == q and g != keep
                                    array.set(eng.grpBestOld, g, -1)
                        evEmit(eng, 14, barTime, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), 0, array.get(eng.cRangeBot, cs), array.get(eng.cRangeTop, cs), 0, 3, 0, 0, float(na), 0.0)
                        if eng.instrument
                            eng.statSplits += 1
                    if cnt >= 1 and keep >= 0
                        array.set(eng.oldChosenBy, q, keep)
            // ---- 8. apply groups to Cores ------------------------------------------------------
            if (grpLen - 1) >= (0)
                for g = 0 to grpLen - 1
                    w1 = array.get(eng.grpFirst, g)
                    w2 = array.get(eng.grpSecond, g)
                    q = array.get(eng.grpBestOld, g)
                    int coreSlot = -1
                    if q >= 0
                        coreSlot := array.get(eng.oldCoreList, q)
                    else
                        coreSlot := coreAlloc(eng, cfg, barTime)
                    array.set(eng.grpCore, g, coreSlot)
                    // Split children inherit only the TouchMarks that really touched them
                    if q < 0
                        if (oldLen - 1) >= (0)
                            for qq = 0 to oldLen - 1
                                cs2 = array.get(eng.oldCoreList, qq)
                                if array.get(eng.cLive, cs2) and cs2 != coreSlot
                                    sh = (w1 >= 0 ? sharedOriginCount(eng, w1, cs2) : 0) + (w2 >= 0 ? sharedOriginCount(eng, w2, cs2) : 0)
                                    if sh >= 1
                                        fb = w1 >= 0 ? array.get(eng.wcBot, w1) : array.get(eng.wcBot, w2)
                                        ft = w1 >= 0 ? array.get(eng.wcTop, w1) : array.get(eng.wcTop, w2)
                                        if w2 >= 0 and w1 >= 0
                                            fb := math.min(fb, array.get(eng.wcBot, w2))
                                            ft := math.max(ft, array.get(eng.wcTop, w2))
                                        ringTransfer(eng, cfg, coreSlot, cs2, fb, ft)
                    if w1 >= 0
                        applyWinnerToSide(eng, cfg, coreSlot, w1, barTime)
                    else
                        clearSideGeometry(eng, sideSlotOf(coreSlot, 0))
                    if w2 >= 0
                        applyWinnerToSide(eng, cfg, coreSlot, w2, barTime)
                    else
                        clearSideGeometry(eng, sideSlotOf(coreSlot, 1))
                    refreshCoreOrigins(eng, coreSlot, barTime)
            // ---- 9. Merge: remaining matching old Cores fold into the group survivor ---------
            if (grpLen - 1) >= (0)
                for g = 0 to grpLen - 1
                    coreSlot = array.get(eng.grpCore, g)
                    w1 = array.get(eng.grpFirst, g)
                    w2 = array.get(eng.grpSecond, g)
                    if (oldLen - 1) >= (0)
                        for q = 0 to oldLen - 1
                            cs = array.get(eng.oldCoreList, q)
                            if array.get(eng.cLive, cs) and cs != coreSlot and array.get(eng.oldChosenBy, q) < 0
                                sh = (w1 >= 0 ? sharedOriginCount(eng, w1, cs) : 0) + (w2 >= 0 ? sharedOriginCount(eng, w2, cs) : 0)
                                if sh >= 1
                                    cb = array.get(eng.cRangeBot, cs)
                                    ct = array.get(eng.cRangeTop, cs)
                                    nb2 = array.get(eng.cRangeBot, coreSlot)
                                    nt2 = array.get(eng.cRangeTop, coreSlot)
                                    gap = (na(cb) or na(ct) or na(nb2) or na(nt2)) ? 0 : intervalGapTick(toTick(cb, mt), toTick(ct, mt), toTick(nb2, mt), toTick(nt2, mt))
                                    if gap <= mTick and not coreHasProtectedState(eng, cs)
                                        ringTransfer(eng, cfg, coreSlot, cs, float(na), float(na))
                                        evEmit(eng, 13, barTime, seq, array.get(eng.cId, coreSlot), array.get(eng.cGenId, coreSlot), 0, nb2, nt2, 0, 3, 0, 0, float(na), 0.0)
                                        array.set(eng.oldChosenBy, q, g)
                                        coreFree(eng, cfg, cs)
                                        if eng.instrument
                                            eng.statMerges += 1
            // ---- 10. old Cores that no longer correspond to any candidate ----------------------
            if (oldLen - 1) >= (0)
                for q = 0 to oldLen - 1
                    cs = array.get(eng.oldCoreList, q)
                    if array.get(eng.cLive, cs) and array.get(eng.oldChosenBy, q) < 0
                        bool claimed = false
                        if (grpLen - 1) >= (0)
                            for g = 0 to grpLen - 1
                                if array.get(eng.grpCore, g) == cs
                                    claimed := true
                                    break
                        if not claimed
                            liveStructureUpdate(eng, cfg, cs)
                            bool keep = coreHasProtectedState(eng, cs)
                            if not keep
                                keep := array.get(eng.sEligible, sideSlotOf(cs, 0)) or array.get(eng.sEligible, sideSlotOf(cs, 1))
                            if not keep
                                coreFree(eng, cfg, cs)
                            else
                                array.set(eng.cLastSeen, cs, barTime)
            eng.coreTopologyRevision += 1
            eng.candidateRevSupport += 1
            eng.candidateRevResistance += 1

// =====================================================================================
// Stage G -- fixed point component expansion (I13.2). No count based cut-off: the
// interval grows until no Root or Core within clusterMaxWidth remains outside.
// =====================================================================================
expandComponent(ZoneEngine eng, ZoneCfg cfg, int lo0, int hi0) =>
    mt = eng.mintick
    mTick = toTick(cfg.clusterMaxWidth, mt)
    lo = lo0
    hi = hi0
    bool changed = true
    while changed
        changed := false
        idx = priceOrderLowerBound(eng, lo)
        while idx - 1 >= 0
            s = array.get(eng.priceOrder, idx - 1)
            t = array.get(eng.rPriceTick, s)
            if t >= lo - mTick
                lo := t
                idx -= 1
                changed := true
            else
                break
        n = array.size(eng.priceOrder)
        idx2 = priceOrderLowerBound(eng, hi + 1)
        while idx2 < n
            s = array.get(eng.priceOrder, idx2)
            t = array.get(eng.rPriceTick, s)
            if t <= hi + mTick
                hi := t
                idx2 += 1
                changed := true
            else
                break
        nlive = array.size(eng.cLiveList)
        if (nlive - 1) >= (0)
            for i = 0 to nlive - 1
                cs = array.get(eng.cLiveList, i)
                cb = array.get(eng.cRangeBot, cs)
                ct = array.get(eng.cRangeTop, cs)
                if not na(cb) and not na(ct)
                    cbt = toTick(cb, mt)
                    ctt = toTick(ct, mt)
                    if ctt >= lo - mTick and cbt <= hi + mTick
                        if cbt < lo
                            lo := cbt
                            changed := true
                        if ctt > hi
                            hi := ctt
                            changed := true
    [lo, hi]

stageGH_topology(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    // PendingTopology release: a Core whose Episode ended re-enters the seed set (16.2)
    nlive = array.size(eng.cLiveList)
    if (nlive - 1) >= (0)
        for i = 0 to nlive - 1
            cs = array.get(eng.cLiveList, i)
            if array.get(eng.cPending, cs)
                bool stillActive = false
                for k = 0 to 1
                    if array.get(eng.sPhase, sideSlotOf(cs, k)) == 2
                        stillActive := true
                if not stillActive
                    array.set(eng.cPending, cs, false)
                    cb = array.get(eng.cRangeBot, cs)
                    ct = array.get(eng.cRangeTop, cs)
                    if not na(cb)
                        array.push(eng.seedRoots, -1)
                        array.push(eng.seedOldLo, toTick(cb, eng.mintick))
                        array.push(eng.seedOldHi, toTick(ct, eng.mintick))
                    eng.pendingRevision += 1
    np = array.size(eng.pendSeedRoots)
    if np >= 2
        i = 0
        while i + 1 < np
            array.push(eng.seedRoots, -1)
            array.push(eng.seedOldLo, array.get(eng.pendSeedRoots, i))
            array.push(eng.seedOldHi, array.get(eng.pendSeedRoots, i + 1))
            i += 2
        array.clear(eng.pendSeedRoots)
    ns = array.size(eng.seedRoots)
    if ns > 0
        compLen = 0
        if (ns - 1) >= (0)
            for i = 0 to ns - 1
                slot = array.get(eng.seedRoots, i)
                lo = array.get(eng.seedOldLo, i)
                hi = array.get(eng.seedOldHi, i)
                if slot >= 0 and array.get(eng.rLive, slot)
                    t = array.get(eng.rIsRange, slot) ? array.get(eng.rNatBotTick, slot) : array.get(eng.rPriceTick, slot)
                    t2 = array.get(eng.rIsRange, slot) ? array.get(eng.rNatTopTick, slot) : array.get(eng.rPriceTick, slot)
                    lo := math.min(lo, t)
                    hi := math.max(hi, t2)
                [elo, ehi] = expandComponent(eng, cfg, lo, hi)
                compLen := scPush(eng.compLo, compLen, elo)
                scPush(eng.compHi, compLen - 1, ehi)
        // sort intervals by low edge, then merge the overlapping ones
        if (compLen - 1) >= (1)
            for i = 1 to compLen - 1
                klo = array.get(eng.compLo, i)
                khi = array.get(eng.compHi, i)
                j = i - 1
                while j >= 0 and array.get(eng.compLo, j) > klo
                    array.set(eng.compLo, j + 1, array.get(eng.compLo, j))
                    array.set(eng.compHi, j + 1, array.get(eng.compHi, j))
                    j -= 1
                array.set(eng.compLo, j + 1, klo)
                array.set(eng.compHi, j + 1, khi)
        w = 0
        if (compLen - 1) >= (0)
            for i = 0 to compLen - 1
                if w == 0
                    array.set(eng.compLo, 0, array.get(eng.compLo, i))
                    array.set(eng.compHi, 0, array.get(eng.compHi, i))
                    w := 1
                else
                    if array.get(eng.compLo, i) <= array.get(eng.compHi, w - 1)
                        array.set(eng.compHi, w - 1, math.max(array.get(eng.compHi, w - 1), array.get(eng.compHi, i)))
                    else
                        array.set(eng.compLo, w, array.get(eng.compLo, i))
                        array.set(eng.compHi, w, array.get(eng.compHi, i))
                        w += 1
        array.clear(eng.seedRoots)
        array.clear(eng.seedOldLo)
        array.clear(eng.seedOldHi)
        if (w - 1) >= (0)
            for i = 0 to w - 1
                recomputeComponent(eng, cfg, feed, array.get(eng.compLo, i), array.get(eng.compHi, i))

// Full rebuild (initial construction and Cfg change only, I13.3)
rebuildAll(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    n = array.size(eng.priceOrder)
    if n > 0
        lo = array.get(eng.rPriceTick, array.get(eng.priceOrder, 0))
        hi = array.get(eng.rPriceTick, array.get(eng.priceOrder, n - 1))
        m = array.size(eng.fvgOrder)
        if (m - 1) >= (0)
            for i = 0 to m - 1
                s = array.get(eng.fvgOrder, i)
                lo := math.min(lo, array.get(eng.rNatBotTick, s))
                hi := math.max(hi, array.get(eng.rNatTopTick, s))
        recomputeComponent(eng, cfg, feed, lo, hi)
        eng.statFullSort += 1

// =====================================================================================
// Grade evaluation (spec 7.2 / App. A 13.4). Order is fixed and never re-ordered.
// =====================================================================================
evalGrade(ZoneEngine eng, ZoneCfg cfg, int sideSlot, int touchNo) =>
    int g = 3
    ph = array.get(eng.sPhase, sideSlot)
    if not array.get(eng.sEligible, sideSlot) or not array.get(eng.sHasNonPsych, sideSlot) or ph == 3 or ph == 4
        g := 3
    else if array.get(eng.sWeakDepth, sideSlot) or ((not cfg.weakFromTouchOff) and touchNo >= cfg.weakFromTouch)
        g := 2
    else if array.get(eng.sBaseStrong, sideSlot) and (cfg.strongUnlimited or touchNo <= cfg.strongUntilTouch)
        g := 0
    else
        g := 1
    g

evalTouchNoRaw(ZoneEngine eng, int sideSlot) =>
    array.get(eng.sPhase, sideSlot) == 2 ? array.get(eng.sCurTouchNo, sideSlot) : array.get(eng.sTouchCount, sideSlot) + 1

weakReasonOf(ZoneEngine eng, ZoneCfg cfg, int sideSlot) =>
    wt = array.get(eng.sWeakTouch, sideSlot) or ((not cfg.weakFromTouchOff) and evalTouchNoRaw(eng, sideSlot) >= cfg.weakFromTouch)
    wd = array.get(eng.sWeakDepth, sideSlot)
    r = wt and wd ? 3 : (wt ? 1 : (wd ? 2 : 0))
    array.set(eng.sWeakReason, sideSlot, r)
    r

evalTouchNo(ZoneEngine eng, int sideSlot) =>
    array.get(eng.sPhase, sideSlot) == 2 ? array.get(eng.sCurTouchNo, sideSlot) : array.get(eng.sTouchCount, sideSlot) + 1

// =====================================================================================
// New Zone generation (spec 13 / App. A 18). Only a new independent category plus
// Base Strong plus reset plus re-approach can clear the consumption history.
// =====================================================================================
startNewGeneration(ZoneEngine eng, ZoneCfg cfg, Feed feed, int coreSlot) =>
    pushEndedGeneration(eng, cfg, coreSlot)
    array.set(eng.cGenId, coreSlot, eng.nextGenId)
    eng.nextGenId += 1
    array.set(eng.cZoneFresh, coreSlot, true)
    array.set(eng.cGenStartTime, coreSlot, feed.baseCloseTime)
    array.set(eng.cGenCandActive, coreSlot, false)
    array.set(eng.cGenCandReset, coreSlot, false)
    array.set(eng.cGenCandArmed, coreSlot, false)
    array.set(eng.cPendingGen, coreSlot, false)
    for k = 0 to 1
        ss = sideSlotOf(coreSlot, k)
        array.set(eng.sTouchCount, ss, 0)
        array.set(eng.sCurTouchNo, ss, 0)
        array.set(eng.sWeakTouch, ss, false)
        array.set(eng.sWeakDepth, ss, false)
        array.set(eng.sWeakReason, ss, 0)
        array.set(eng.sMaxDepth, ss, 0.0)
        array.set(eng.sFresh, ss, true)
        array.set(eng.sUsedSide, ss, false)
        array.set(eng.tsValid, ss, false)
        array.set(eng.bsValid, ss, false)
        array.set(eng.sFlipAttempts, ss, 0)
        array.set(eng.sInvAttempts, ss, 0)
        ph = array.get(eng.sPhase, ss)
        if ph == 3 or ph == 4
            setPhase(eng, ss, 0)
    array.set(eng.cGenBaseCatMask, coreSlot, array.get(eng.sCatMask, sideSlotOf(coreSlot, 0)) + array.get(eng.sCatMask, sideSlotOf(coreSlot, 1)))
    evEmit(eng, 12, feed.baseCloseTime, feed.baseSeq, array.get(eng.cId, coreSlot), array.get(eng.cGenId, coreSlot), 0, array.get(eng.cRangeBot, coreSlot), array.get(eng.cRangeTop, coreSlot), 0, 3, 0, 0, float(na), 0.0)

// =====================================================================================
// Touch start (App. A 13.1)
// =====================================================================================
startTouch(ZoneEngine eng, ZoneCfg cfg, Feed feed, int coreSlot, int sideIdx, float contactBot, float contactTop) =>
    ss = sideSlotOf(coreSlot, sideIdx)
    side = sideOfIdx(sideIdx)
    // the deterministic re-approach of a pending new generation switches just before
    // the normal Touch is recorded, so this contact becomes Touch 1 of the new generation
    if array.get(eng.cGenCandActive, coreSlot) and array.get(eng.cGenCandReset, coreSlot) and array.get(eng.cGenCandArmed, coreSlot)
        startNewGeneration(eng, cfg, feed, coreSlot)
    cnt = array.get(eng.sTouchCount, ss) + 1
    array.set(eng.sTouchCount, ss, cnt)
    array.set(eng.sCurTouchNo, ss, cnt)
    array.set(eng.sUsedSide, ss, true)
    if (not cfg.weakFromTouchOff) and cnt >= cfg.weakFromTouch
        array.set(eng.sWeakTouch, ss, true)
    grade = evalGrade(eng, cfg, ss, cnt)
    // TouchStartSnapshot -- frozen for the whole Episode (App. A 6.5)
    array.set(eng.tsValid, ss, true)
    array.set(eng.tsCoreId, ss, array.get(eng.cId, coreSlot))
    array.set(eng.tsGenId, ss, array.get(eng.cGenId, coreSlot))
    array.set(eng.tsSide, ss, side)
    array.set(eng.tsBot, ss, array.get(eng.sArmedBot, ss))
    array.set(eng.tsTop, ss, array.get(eng.sArmedTop, ss))
    array.set(eng.tsCatMask, ss, array.get(eng.sCatMask, ss))
    array.set(eng.tsHighMask, ss, array.get(eng.sHighMask, ss))
    array.set(eng.tsC, ss, array.get(eng.sC, ss))
    array.set(eng.tsH, ss, array.get(eng.sH, ss))
    array.set(eng.tsDensity, ss, array.get(eng.sDensity, ss))
    array.set(eng.tsGrade, ss, grade)
    array.set(eng.tsTouchNo, ss, cnt)
    array.set(eng.tsApproach, ss, side)
    array.set(eng.tsStartSeq, ss, feed.baseSeq)
    array.set(eng.tsStartTime, ss, feed.baseCloseTime)
    array.set(eng.tsDeepest, ss, feed.baseClose)
    array.set(eng.tsMaxDepth, ss, 0.0)
    snapRoots = array.get(eng.tsRoots, ss).a
    array.clear(snapRoots)
    src = array.get(eng.sRoots, ss).a
    n = array.size(src)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            array.push(snapRoots, array.get(eng.rId, array.get(src, i)))
    ring = array.get(eng.cTouch, coreSlot)
    cap = math.max(1, cfg.maxTouchMarksPerCore)
    if ring.count >= cap
        eng.touchHistoryTruncated := true
    ringPush(ring, cap, feed.baseSeq, feed.baseCloseTime, side, contactBot, contactTop, feed.baseClose, array.get(eng.cGenId, coreSlot), true)
    array.set(eng.cZoneFresh, coreSlot, false)
    array.set(eng.sFresh, ss, false)
    array.set(eng.sLastTouchTime, ss, feed.baseCloseTime)
    setPhase(eng, ss, 2)
    array.set(eng.sGrade, ss, grade)
    eng.snapshotRevision += 1
    evEmit(eng, 1, feed.baseCloseTime, feed.baseSeq, array.get(eng.cId, coreSlot), array.get(eng.cGenId, coreSlot), side, array.get(eng.tsBot, ss), array.get(eng.tsTop, ss), cnt, grade, weakReasonOf(eng, cfg, ss), 0, feed.baseClose, 0.0)

// =====================================================================================
// Local Break / GapBreak (App. A 14)
// =====================================================================================
doBreak(ZoneEngine eng, ZoneCfg cfg, Feed feed, int coreSlot, int sideIdx, float refBot, float refTop, bool isGap) =>
    ss = sideSlotOf(coreSlot, sideIdx)
    other = sideSlotOf(coreSlot, 1 - sideIdx)
    side = sideOfIdx(sideIdx)
    array.set(eng.bsValid, ss, true)
    array.set(eng.bsCoreId, ss, array.get(eng.cId, coreSlot))
    array.set(eng.bsGenId, ss, array.get(eng.cGenId, coreSlot))
    array.set(eng.bsOldSide, ss, side)
    array.set(eng.bsBot, ss, refBot)
    array.set(eng.bsTop, ss, refTop)
    array.set(eng.bsSeq, ss, feed.baseSeq)
    array.set(eng.bsTime, ss, feed.baseCloseTime)
    array.set(eng.bsWasGap, ss, isGap)
    array.set(eng.bsMovedAway, ss, false)
    array.set(eng.bsRetest, ss, false)
    bRoots = array.get(eng.bsRoots, ss).a
    array.clear(bRoots)
    src = array.get(eng.sRoots, ss).a
    n = array.size(src)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            array.push(bRoots, array.get(eng.rId, array.get(src, i)))
    setPhase(eng, ss, 3)
    setPhase(eng, other, 4)
    array.set(eng.sGrade, ss, 3)
    array.set(eng.sGrade, other, 3)
    array.set(eng.tsValid, ss, false)
    eng.snapshotRevision += 1
    evEmit(eng, isGap ? 5 : 4, feed.baseCloseTime, feed.baseSeq, array.get(eng.cId, coreSlot), array.get(eng.cGenId, coreSlot), side, refBot, refTop, array.get(eng.sCurTouchNo, ss), array.get(eng.tsGrade, ss), weakReasonOf(eng, cfg, ss), 0, feed.baseClose, 0.0)

// =====================================================================================
// Deterministic evaluation order: coreId asc, generationId asc, Support before Resistance
// (I16: index extraction never decides evaluation order)
// =====================================================================================
sortSideSlots(ZoneEngine eng, array<int> arr, int len) =>
    if (len - 1) >= (1)
        for i = 1 to len - 1
            key = array.get(arr, i)
            kc = array.get(eng.cId, int(math.floor(key / 2)))
            kg = array.get(eng.cGenId, int(math.floor(key / 2)))
            ks = key % 2
            j = i - 1
            bool go = true
            while j >= 0 and go
                o = array.get(arr, j)
                oc = array.get(eng.cId, int(math.floor(o / 2)))
                og = array.get(eng.cGenId, int(math.floor(o / 2)))
                os = o % 2
                bool greater = oc > kc or (oc == kc and (og > kg or (og == kg and os > ks)))
                if greater
                    array.set(arr, j + 1, o)
                    j -= 1
                else
                    go := false
            array.set(arr, j + 1, key)

// =====================================================================================
// Stage D -- facts of the current confirmed bar
// =====================================================================================
stageD_states(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    mt = eng.mintick
    hiT = toTick(feed.baseHigh, mt)
    loT = toTick(feed.baseLow, mt)
    clT = toTick(feed.baseClose, mt)
    pcT = na(feed.basePrevClose) ? clT : toTick(feed.basePrevClose, mt)
    mTick = toTick(cfg.clusterMaxWidth, mt)
    resT = toTick(cfg.touchResetDistance, mt)
    bufT = toTick(cfg.breakBuffer, mt)
    tolT = toTick(cfg.touchTolerance, mt)
    seq = feed.baseSeq
    bt = feed.baseCloseTime
    // ---- D4 pre-pass: FVG structural invalidation wins over Reclaim on the same bar ----
    eng.invCoreLen := 0
    ns = array.size(feed.srcTf)
    if (ns - 1) >= (0)
        for i = 0 to ns - 1
            tf = array.get(feed.srcTf, i)
            cT = toTick(array.get(feed.srcClose, i), mt)
            a = array.get(eng.catSets, 4).a
            m = array.size(a)
            if (m - 1) >= (0)
                for k = 0 to m - 1
                    s = array.get(a, k)
                    if array.get(eng.rTf, s) == tf
                        st = array.get(eng.rState, s)
                        if st == 1 or st == 4
                            dirNow = st == 1 ? array.get(eng.rDir, s) : -array.get(eng.rDir, s)
                            if (dirNow > 0 and cT < array.get(eng.rNatBotTick, s)) or (dirNow < 0 and cT > array.get(eng.rNatTopTick, s))
                                for q = 0 to 1
                                    cs = q == 0 ? array.get(eng.rCoreSup, s) : array.get(eng.rCoreRes, s)
                                    if cs >= 0
                                        eng.invCoreLen := scPush(eng.invCoreList, eng.invCoreLen, cs)
    // ---- D1: Touch / GapBreak, restricted to Views that were Armed at the previous close
    scanLo = math.min(pcT, loT) - mTick
    scanHi = math.max(pcT, hiT)
    alen = 0
    astart = armedIndexSearch(eng, scanLo, -1)
    an = array.size(eng.armedOrder)
    ai = astart
    while ai < an
        ssx = array.get(eng.armedOrder, ai)
        if array.get(eng.sArmedBotTick, ssx) > scanHi
            break
        alen := scPush(eng.scSlots, alen, ssx)
        ai += 1
    sortSideSlots(eng, eng.scSlots, alen)
    if (alen - 1) >= (0)
        for i = 0 to alen - 1
            ss = array.get(eng.scSlots, i)
            cs = int(math.floor(ss / 2))
            sideIdx = ss % 2
            side = sideOfIdx(sideIdx)
            if array.get(eng.sPhase, ss) == 1 and seq >= array.get(eng.sArmedFromSeq, ss)
                bTick = array.get(eng.sArmedBotTick, ss)
                tTick = array.get(eng.sArmedTopTick, ss)
                bool touched = false
                if bTick == tTick
                    touched := loT <= bTick + tolT and hiT >= bTick - tolT
                else
                    touched := hiT >= bTick and loT <= tTick
                if touched
                    cb = math.max(feed.baseLow, array.get(eng.sArmedBot, ss))
                    ct = math.min(feed.baseHigh, array.get(eng.sArmedTop, ss))
                    startTouch(eng, cfg, feed, cs, sideIdx, cb, ct)
                else
                    // complete gap through the Zone with a Break close and no trade inside
                    bool gap = false
                    if side == 1
                        gap := tTick < pcT and hiT < bTick and clT <= bTick - bufT
                    else
                        gap := bTick > pcT and loT > tTick and clT >= tTick + bufT
                    if gap
                        doBreak(eng, cfg, feed, cs, sideIdx, array.get(eng.sArmedBot, ss), array.get(eng.sArmedTop, ss), true)
    // ---- D2 / D3: ActiveTouch Episodes evaluated on the frozen TouchStartSnapshot -------
    act = array.get(eng.phSets, 2).a
    blen = 0
    an2 = array.size(act)
    if (an2 - 1) >= (0)
        for i = 0 to an2 - 1
            blen := scPush(eng.scAux, blen, array.get(act, i))
    sortSideSlots(eng, eng.scAux, blen)
    if (blen - 1) >= (0)
        for i = 0 to blen - 1
            ss = array.get(eng.scAux, i)
            cs = int(math.floor(ss / 2))
            sideIdx = ss % 2
            side = sideOfIdx(sideIdx)
            if array.get(eng.sPhase, ss) == 2 and array.get(eng.tsValid, ss)
                sb = array.get(eng.tsBot, ss)
                st2 = array.get(eng.tsTop, ss)
                sbT = toTick(sb, mt)
                stT = toTick(st2, mt)
                bool broke = side == 1 ? clT <= sbT - bufT : clT >= stT + bufT
                if broke
                    doBreak(eng, cfg, feed, cs, sideIdx, sb, st2, false)
                else
                    // WeakDepth (only for Zones with width; equality with the threshold is Weak)
                    width = st2 - sb
                    if width > 0 and not cfg.weakDepthOff
                        raw = side == 1 ? (st2 - feed.baseClose) / width * 100.0 : (feed.baseClose - sb) / width * 100.0
                        depth = math.max(0.0, math.min(100.0, raw))
                        if depth > array.get(eng.tsMaxDepth, ss)
                            array.set(eng.tsMaxDepth, ss, depth)
                            array.set(eng.tsDeepest, ss, feed.baseClose)
                        if depth > array.get(eng.sMaxDepth, ss)
                            array.set(eng.sMaxDepth, ss, depth)
                        if depth >= cfg.weakDepthPct and not array.get(eng.sWeakDepth, ss)
                            array.set(eng.sWeakDepth, ss, true)
                            evEmit(eng, 3, bt, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), side, sb, st2, array.get(eng.sCurTouchNo, ss), array.get(eng.tsGrade, ss), weakReasonOf(eng, cfg, ss), 0, feed.baseClose, depth)
                    // Episode separation
                    bool reset = side == 1 ? feed.baseClose >= st2 + cfg.touchResetDistance : feed.baseClose <= sb - cfg.touchResetDistance
                    if reset
                        setPhase(eng, ss, 0)
                        array.set(eng.sArmedFromSeq, ss, seq + 1)
                        evEmit(eng, 2, bt, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), side, sb, st2, array.get(eng.sCurTouchNo, ss), array.get(eng.tsGrade, ss), weakReasonOf(eng, cfg, ss), 0, feed.baseClose, array.get(eng.tsMaxDepth, ss))
                    array.set(eng.sGrade, ss, evalGrade(eng, cfg, ss, array.get(eng.sCurTouchNo, ss)))
    // ---- D3: Broken sides -- Reclaim, Flip, FlipAttempt on the frozen BreakSnapshot -------
    brk = array.get(eng.phSets, 3).a
    clen = 0
    an3 = array.size(brk)
    if (an3 - 1) >= (0)
        for i = 0 to an3 - 1
            clen := scPush(eng.scSlots, clen, array.get(brk, i))
    sortSideSlots(eng, eng.scSlots, clen)
    if (clen - 1) >= (0)
        for i = 0 to clen - 1
            ss = array.get(eng.scSlots, i)
            cs = int(math.floor(ss / 2))
            sideIdx = ss % 2
            side = sideOfIdx(sideIdx)
            other = sideSlotOf(cs, 1 - sideIdx)
            if array.get(eng.sPhase, ss) == 3 and array.get(eng.bsValid, ss)
                sb = array.get(eng.bsBot, ss)
                st2 = array.get(eng.bsTop, ss)
                sbT = toTick(sb, mt)
                stT = toTick(st2, mt)
                bool invalidationPriority = false
                if (eng.invCoreLen - 1) >= (0)
                    for q = 0 to eng.invCoreLen - 1
                        if array.get(eng.invCoreList, q) == cs
                            invalidationPriority := true
                            break
                bool gapBarBlock = array.get(eng.bsWasGap, ss) and array.get(eng.bsSeq, ss) == seq
                bool reclaimed = false
                if not invalidationPriority and not gapBarBlock
                    reclaimed := side == 1 ? feed.baseClose >= st2 + cfg.breakBuffer : feed.baseClose <= sb - cfg.breakBuffer
                if reclaimed
                    array.set(eng.bsValid, ss, false)
                    setPhase(eng, ss, 0)
                    setPhase(eng, other, 0)
                    evEmit(eng, 8, bt, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), side, sb, st2, array.get(eng.sTouchCount, ss), 3, weakReasonOf(eng, cfg, ss), 0, feed.baseClose, 0.0)
                else if not gapBarBlock
                    if not array.get(eng.bsMovedAway, ss)
                        bool moved = side == 1 ? feed.baseClose <= sb - cfg.touchResetDistance : feed.baseClose >= st2 + cfg.touchResetDistance
                        if moved
                            array.set(eng.bsMovedAway, ss, true)
                    else
                        bool retest = hiT >= sbT and loT <= stT
                        if retest
                            array.set(eng.bsRetest, ss, true)
                            bool confirm = side == 1 ? feed.baseClose <= sb : feed.baseClose >= st2
                            if confirm
                                array.set(eng.bsValid, ss, false)
                                setPhase(eng, other, 0)
                                array.set(eng.sArmedFromSeq, other, seq + 1)
                                array.set(eng.sLastFlipSeq, other, seq)
                                evEmit(eng, 7, bt, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), sideOfIdx(1 - sideIdx), sb, st2, array.get(eng.sTouchCount, other), 3, weakReasonOf(eng, cfg, other), 0, feed.baseClose, 0.0)
                            else
                                array.set(eng.sFlipAttempts, other, array.get(eng.sFlipAttempts, other) + 1)
                                evEmit(eng, 6, bt, seq, array.get(eng.cId, cs), array.get(eng.cGenId, cs), sideOfIdx(1 - sideIdx), sb, st2, 0, 3, 0, 0, feed.baseClose, 0.0)
    // ---- D3: Inverse FVG state machine (App. A 15.4) ----------------------------------------
    af = array.get(eng.catSets, 4).a
    fn = array.size(af)
    if (fn - 1) >= (0)
        for i = 0 to fn - 1
            s = array.get(af, i)
            if array.get(eng.rState, s) == 3
                nb = array.get(eng.rNatBot, s)
                ntp = array.get(eng.rNatTop, s)
                nbT = array.get(eng.rNatBotTick, s)
                ntT = array.get(eng.rNatTopTick, s)
                origDir = array.get(eng.rDir, s)
                if not array.get(eng.rMovedAway, s)
                    bool moved = origDir > 0 ? feed.baseClose <= nb - cfg.touchResetDistance : feed.baseClose >= ntp + cfg.touchResetDistance
                    if moved
                        array.set(eng.rMovedAway, s, true)
                else
                    bool retest = hiT >= nbT and loT <= ntT
                    if retest
                        bool confirm = origDir > 0 ? feed.baseClose <= nb : feed.baseClose >= ntp
                        if confirm
                            array.set(eng.rState, s, 4)
                            array.set(eng.rStateRev, s, array.get(eng.rStateRev, s) + 1)
                            eng.fvgStateRevision += 1
                            seedRoot(eng, s, nbT, ntT)
                            evEmit(eng, 11, bt, seq, 0, 0, origDir > 0 ? -1 : 1, nb, ntp, 0, 3, 0, array.get(eng.rId, s), feed.baseClose, 0.0)
                        else
                            evEmit(eng, 10, bt, seq, 0, 0, origDir > 0 ? -1 : 1, nb, ntp, 0, 3, 0, array.get(eng.rId, s), feed.baseClose, 0.0)

// =====================================================================================
// Stage J -- Phase / Grade / Armed / Dormant for the NEXT bar (spec 7.4, 12)
// =====================================================================================
updateArmedRange(ZoneEngine eng, int ss, float bot, float top) =>
    wasArmed = array.get(eng.sPhase, ss) == 1
    if wasArmed
        armedIndexRemove(eng, ss)
    array.set(eng.sArmedBot, ss, bot)
    array.set(eng.sArmedTop, ss, top)
    array.set(eng.sArmedBotTick, ss, toTick(bot, eng.mintick))
    array.set(eng.sArmedTopTick, ss, toTick(top, eng.mintick))
    if wasArmed
        armedIndexInsert(eng, ss)

stageJ_phases(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    mt = eng.mintick
    seq = feed.baseSeq
    close = feed.baseClose
    n = array.size(eng.cLiveList)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            cs = array.get(eng.cLiveList, i)
            prot = coreHasProtectedState(eng, cs) or array.get(eng.cPending, cs)
            cb = array.get(eng.cRangeBot, cs)
            ct = array.get(eng.cRangeTop, cs)
            float dist = na
            if not na(cb) and not na(ct)
                dist := close > ct ? close - ct : (close < cb ? cb - close : 0.0)
            // ---- Dormant is a calculation pause, never a history deletion -------------------
            if not prot and not na(dist)
                if dist > cfg.dormantDistance
                    for k = 0 to 1
                        ss = sideSlotOf(cs, k)
                        if array.get(eng.sPhase, ss) == 0 or array.get(eng.sPhase, ss) == 1
                            setPhase(eng, ss, 5)
                    array.set(eng.cDormant, cs, true)
                else if array.get(eng.cDormant, cs)
                    for k = 0 to 1
                        ss = sideSlotOf(cs, k)
                        if array.get(eng.sPhase, ss) == 5
                            setPhase(eng, ss, 0)
                    array.set(eng.cDormant, cs, false)
            for k = 0 to 1
                ss = sideSlotOf(cs, k)
                side = sideOfIdx(k)
                ph = array.get(eng.sPhase, ss)
                elig = array.get(eng.sEligible, ss) and array.get(eng.sHasNonPsych, ss)
                if ph == 0 and elig
                    eb = array.get(eng.sEffBot, ss)
                    et = array.get(eng.sEffTop, ss)
                    if not na(eb) and not na(et)
                        bool far = side == 1 ? close >= et + cfg.touchResetDistance : close <= eb - cfg.touchResetDistance
                        if far and seq >= array.get(eng.sArmedFromSeq, ss)
                            updateArmedRange(eng, ss, eb, et)
                            setPhase(eng, ss, 1)
                            array.set(eng.sArmedFromSeq, ss, seq + 1)
                else if ph == 1
                    if elig
                        // the range that the next bar will be measured against is this close's range
                        updateArmedRange(eng, ss, array.get(eng.sEffBot, ss), array.get(eng.sEffTop, ss))
                    else
                        setPhase(eng, ss, 0)
                array.set(eng.sGrade, ss, evalGrade(eng, cfg, ss, evalTouchNo(eng, ss)))
                wrStored = weakReasonOf(eng, cfg, ss)
            // ---- new generation candidate tracking (App. A 18) ---------------------------------
            ss0 = sideSlotOf(cs, 0)
            ss1 = sideSlotOf(cs, 1)
            baseMask = array.get(eng.cGenBaseCatMask, cs)
            if array.get(eng.tsValid, ss0)
                baseMask := array.get(eng.tsCatMask, ss0)
            else if array.get(eng.tsValid, ss1)
                baseMask := array.get(eng.tsCatMask, ss1)
            curMask = array.get(eng.sCatMask, ss0)
            m1 = array.get(eng.sCatMask, ss1)
            for b = 0 to 5
                if hasBit(m1, b) and not hasBit(curMask, b)
                    curMask := curMask + bit(b)
            newCats = 0
            for b = 0 to 4
                if hasBit(curMask, b) and not hasBit(baseMask, b)
                    newCats += 1
            bool history = array.get(eng.sTouchCount, ss0) > 0 or array.get(eng.sTouchCount, ss1) > 0
            ph0 = array.get(eng.sPhase, ss0)
            ph1 = array.get(eng.sPhase, ss1)
            if ph0 == 3 or ph0 == 4 or ph1 == 3 or ph1 == 4
                history := true
            bool strongAny = array.get(eng.sBaseStrong, ss0) or array.get(eng.sBaseStrong, ss1)
            bool active = ph0 == 2 or ph1 == 2
            if history and newCats > 0 and strongAny
                if active
                    array.set(eng.cPendingGen, cs, true)
                else
                    if not array.get(eng.cGenCandActive, cs)
                        array.set(eng.cGenCandActive, cs, true)
                        array.set(eng.cGenCandReset, cs, false)
                        array.set(eng.cGenCandArmed, cs, false)
                        gs = array.get(eng.sBaseStrong, ss0) ? 0 : 1
                        array.set(eng.cGenCandSide, cs, sideOfIdx(gs))
                        array.set(eng.cGenCandBot, cs, array.get(eng.sEffBot, sideSlotOf(cs, gs)))
                        array.set(eng.cGenCandTop, cs, array.get(eng.sEffTop, sideSlotOf(cs, gs)))
                        array.set(eng.cGenCandCatMask, cs, curMask)
            else
                array.set(eng.cGenCandActive, cs, false)
                array.set(eng.cGenCandReset, cs, false)
                array.set(eng.cGenCandArmed, cs, false)
                array.set(eng.cPendingGen, cs, false)
            if array.get(eng.cGenCandActive, cs)
                gb = array.get(eng.cGenCandBot, cs)
                gt = array.get(eng.cGenCandTop, cs)
                if not na(gb) and not na(gt)
                    if array.get(eng.cGenCandReset, cs)
                        array.set(eng.cGenCandArmed, cs, true)
                    else
                        gside = array.get(eng.cGenCandSide, cs)
                        bool far = gside == 1 ? close >= gt + cfg.touchResetDistance : close <= gb - cfg.touchResetDistance
                        if far
                            array.set(eng.cGenCandReset, cs, true)

// =====================================================================================
// Stage K -- storage housekeeping (App. A 4.4 / I17.3). Protected states are never cut.
// =====================================================================================
rootProtected(ZoneEngine eng, int slot) =>
    bool p = false
    st = array.get(eng.rState, slot)
    if array.get(eng.rCat, slot) == 4 and (st == 3 or st == 4)
        p := true
    for k = 0 to 1
        cs = k == 0 ? array.get(eng.rCoreSup, slot) : array.get(eng.rCoreRes, slot)
        if cs >= 0
            if array.get(eng.cLive, cs)
                if coreHasProtectedState(eng, cs) or array.get(eng.cPending, cs)
                    p := true
    p

pruneCategory(ZoneEngine eng, ZoneCfg cfg, int cat, int cap) =>
    a = array.get(eng.catSets, cat).a
    while array.size(a) > cap
        // oldest confirmed, unprotected candidate first
        victim = -1
        vTime = 4102444800000
        n = array.size(a)
        if (n - 1) >= (0)
            for i = 0 to n - 1
                s = array.get(a, i)
                if not rootProtected(eng, s)
                    t = array.get(eng.rConfirmedTime, s)
                    if t < vTime
                        vTime := t
                        victim := s
        if victim < 0
            break
        rootRetire(eng, victim)
        eng.storagePruned := true
        eng.prunedRootCount += 1

stageK_prune(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    // psych Roots never sustain a Zone on their own
    ps = array.get(eng.catSets, 5).a
    i = array.size(ps) - 1
    while i >= 0
        s = array.get(ps, i)
        if array.get(eng.rCoreSup, s) < 0 and array.get(eng.rCoreRes, s) < 0
            rootRetire(eng, s)
        i -= 1
    pruneCategory(eng, cfg, 1, cfg.maxSwingRoots)
    pruneCategory(eng, cfg, 2, cfg.maxAccumBoxes * 2)
    pruneCategory(eng, cfg, 4, cfg.maxFvgRoots)
    pruneCategory(eng, cfg, 3, cfg.maxTimeRoots)
    while array.size(eng.cLiveList) > cfg.maxZoneCores
        victim = -1
        vRoots = 2147483647
        vTime = 4102444800000
        n = array.size(eng.cLiveList)
        if (n - 1) >= (0)
            for k = 0 to n - 1
                cs = array.get(eng.cLiveList, k)
                if not coreHasProtectedState(eng, cs) and not array.get(eng.cPending, cs) and array.get(eng.cDormant, cs)
                    rc = array.size(array.get(eng.cOriginRoots, cs).a)
                    t = array.get(eng.cLastSeen, cs)
                    if rc < vRoots or (rc == vRoots and t < vTime)
                        vRoots := rc
                        vTime := t
                        victim := cs
        if victim < 0
            break
        evEmit(eng, 15, feed.baseCloseTime, feed.baseSeq, array.get(eng.cId, victim), array.get(eng.cGenId, victim), 0, array.get(eng.cRangeBot, victim), array.get(eng.cRangeTop, victim), 0, 3, 0, 0, float(na), 0.0)
        coreFree(eng, cfg, victim)
        eng.storagePruned := true

// =====================================================================================
// Read only projections (I19.1: built only when requested, never stored per bar)
// =====================================================================================
export viewCount(ZoneEngine eng) =>
    array.size(eng.cLiveList) * 2

export viewAt(ZoneEngine eng, int index) =>
    ZoneView v = ZoneView.new()
    n = array.size(eng.cLiveList)
    ci = int(math.floor(index / 2))
    k = index % 2
    if ci >= 0 and ci < n
        cs = array.get(eng.cLiveList, ci)
        ss = sideSlotOf(cs, k)
        v.coreId := array.get(eng.cId, cs)
        v.generationId := array.get(eng.cGenId, cs)
        v.side := sideOfIdx(k)
        v.effectiveBottom := array.get(eng.sEffBot, ss)
        v.effectiveTop := array.get(eng.sEffTop, ss)
        v.referencePrice := array.get(eng.sRefPrice, ss)
        v.phase := array.get(eng.sPhase, ss)
        v.grade := array.get(eng.sGrade, ss)
        v.cCount := array.get(eng.sC, ss)
        v.hCount := array.get(eng.sH, ss)
        v.density := array.get(eng.sDensity, ss)
        v.baseStrong := array.get(eng.sBaseStrong, ss)
        v.currentTouchNo := array.get(eng.sPhase, ss) == 2 ? array.get(eng.sCurTouchNo, ss) : 0
        v.upcomingTouchNo := array.get(eng.sTouchCount, ss) + 1
        v.zoneFresh := array.get(eng.cZoneFresh, cs)
        v.sideFresh := array.get(eng.sTouchCount, ss) == 0
        v.weakReason := array.get(eng.sWeakReason, ss)
        v.maxDepthPct := array.get(eng.sMaxDepth, ss)
        v.isBroadContext := array.get(eng.sBroadCtx, ss)
        v.fvgDirectionMask := array.get(eng.sFvgDirMask, ss)
        v.fvgRootCount := array.get(eng.sFvgCount, ss)
        v.fvgFreshCount := array.get(eng.sFvgFreshCount, ss)
        v.fvgStructuralStateMask := array.get(eng.sFvgStateMask, ss)
        v.eligible := array.get(eng.sEligible, ss) and array.get(eng.sHasNonPsych, ss)
        v.categoryMask := array.get(eng.sCatMask, ss)
        v.highMask := array.get(eng.sHighMask, ss)
        v.rootCount := array.size(array.get(eng.sRoots, ss).a)
        v.dormant := array.get(eng.cDormant, cs)
        v.pendingTopology := array.get(eng.cPending, cs)
        v.pendingGeneration := array.get(eng.cPendingGen, cs)
    v

// Numeric diagnostics for the Harnesses (no strings are produced inside the Engine).
export type EngineDiag
    int liveCores = 0
    int liveRoots = 0
    int viewRows = 0
    int events = 0
    int cfgError = 0
    bool configValid = false
    bool storagePruned = false
    int prunedRoots = 0
    int prunedZones = 0
    bool touchTruncated = false
    int lastBaseTime = 0
    int lastBaseSeq = 0
    int sessionCode = 0
    int dayKey = 0
    int weekKey = 0
    int maSlope2000 = 0
    int maSlope3000 = 0
    int pendingTopology = 0
    int pendingGeneration = 0
    int activeTouches = 0
    int armedViews = 0
    int candidateWindows = 0
    int cacheHit = 0
    int cacheMiss = 0
    int components = 0
    int merges = 0
    int splits = 0
    int localInserts = 0
    int fullSorts = 0
    int corePairs = 0

export diag(ZoneEngine eng) =>
    EngineDiag d = EngineDiag.new()
    d.liveCores := array.size(eng.cLiveList)
    d.liveRoots := eng.liveRootCount
    d.viewRows := array.size(eng.cLiveList) * 2
    d.events := eng.evLen
    d.cfgError := eng.cfgErrorCode
    d.configValid := eng.configValid
    d.storagePruned := eng.storagePruned
    d.prunedRoots := eng.prunedRootCount
    d.prunedZones := eng.prunedZoneCount
    d.touchTruncated := eng.touchHistoryTruncated
    d.lastBaseTime := eng.lastBaseCloseTime
    d.lastBaseSeq := eng.lastBaseSeq
    d.sessionCode := eng.curSessionCode
    d.dayKey := eng.curDayIndex
    d.weekKey := eng.curWeekIndex
    d.maSlope2000 := eng.slotEma2000 >= 0 ? array.get(eng.rSlope, eng.slotEma2000) : 0
    d.maSlope3000 := eng.slotEma3000 >= 0 ? array.get(eng.rSlope, eng.slotEma3000) : 0
    pt = 0
    pg = 0
    n = array.size(eng.cLiveList)
    if (n - 1) >= (0)
        for i = 0 to n - 1
            cs = array.get(eng.cLiveList, i)
            if array.get(eng.cPending, cs)
                pt += 1
            if array.get(eng.cPendingGen, cs)
                pg += 1
    d.pendingTopology := pt
    d.pendingGeneration := pg
    d.activeTouches := array.size(array.get(eng.phSets, 2).a)
    d.armedViews := array.size(array.get(eng.phSets, 1).a)
    d.candidateWindows := eng.statCandidateWindows
    d.cacheHit := eng.statCacheHit
    d.cacheMiss := eng.statCacheMiss
    d.components := eng.statComponents
    d.merges := eng.statMerges
    d.splits := eng.statSplits
    d.localInserts := eng.statLocalInsert
    d.fullSorts := eng.statFullSort
    d.corePairs := eng.statCorePairs
    d

export setInstrumentation(ZoneEngine eng, bool on) =>
    eng.instrument := on
    eng

// =====================================================================================
// I8 -- the only entry point that mutates Engine state.
// Stage A validate / duplicate guard      Stage G component expansion
// Stage B clear current bar events        Stage H Side candidates, Core, Merge / Split
// Stage C previous confirmed structure    Stage I PendingTopology
// Stage D current bar facts               Stage J next bar Phase / Grade / Armed
// Stage E Source facts -> Root journal    Stage K storage housekeeping
// Stage F journal applied, indices        Stage L commit
// =====================================================================================
export updateConfirmed5m(ZoneEngine eng, ZoneCfg cfg, Feed feed) =>
    // ---- Stage A ---------------------------------------------------------------------
    fp = cfgFingerprint(cfg)
    bool cfgChanged = fp != eng.cfgFingerprint and eng.everUpdated
    if fp != eng.cfgFingerprint
        eng.cfgFingerprint := fp
        eng.cfgRevision += 1
        eng.cfgErrorCode := validateCfg(cfg)
        eng.configValid := eng.cfgErrorCode == 0
        eng.mintick := cfg.mintick
    bool ok = false
    if eng.configValid
        bool feedOk = feed.baseConfirmed and not na(feed.baseSeq) and not na(feed.baseClose) and not na(feed.mintick)
        if feedOk
            feedOk := feed.mintick == cfg.mintick and feed.baseTfMinutes == cfg.baseTfMinutes
            if not feedOk
                eng.cfgErrorCode := 7
        if feedOk
            bool dup = eng.everUpdated and (feed.baseSeq <= eng.lastBaseSeq or feed.baseOpenTime <= eng.lastBaseOpenTime)
            if not dup
                // ---- Stage B -------------------------------------------------------------
                evClear(eng)
                // ---- Stage C / D ---------------------------------------------------------
                stageD_states(eng, cfg, feed)
                // ---- Stage E / F ---------------------------------------------------------
                stageE_fvgInvalidate(eng, cfg, feed)
                stageE_ma(eng, cfg, feed)
                stageE_swing(eng, cfg, feed)
                stageE_accum(eng, cfg, feed)
                stageE_fvgCreate(eng, cfg, feed)
                stageE_timeHl(eng, cfg, feed)
                stageE_fvgFresh(eng, cfg, feed)
                // ---- Stage G / H / I -----------------------------------------------------
                if cfgChanged
                    // a Cfg change is the only trigger for a full reconstruction (I13.3)
                    array.clear(eng.seedRoots)
                    array.clear(eng.seedOldLo)
                    array.clear(eng.seedOldHi)
                    rebuildAll(eng, cfg, feed)
                else
                    stageGH_topology(eng, cfg, feed)
                // ---- Stage J -------------------------------------------------------------
                stageJ_phases(eng, cfg, feed)
                // ---- Stage K -------------------------------------------------------------
                stageK_prune(eng, cfg, feed)
                // ---- Stage L -------------------------------------------------------------
                eng.lastBaseOpenTime := feed.baseOpenTime
                eng.lastBaseCloseTime := feed.baseCloseTime
                eng.lastBaseSeq := feed.baseSeq
                eng.lastClose := feed.baseClose
                eng.everUpdated := true
                eng.presentationRevision += 1
                ok := true
    ok

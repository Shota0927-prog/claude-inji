// Per-core TouchMark ring buffer (App. A 6.4 / I17.2). Physical capacity is fixed,
// logical order is derived from head/count -- never array.remove(0).
export type TouchRing
    array<int>   baseSeq
    array<int>   time
    array<int>   side
    array<float> contactBottom
    array<float> contactTop
    array<float> closeAtTouch
    array<int>   generationId
    array<bool>  isNormalTouch
    int head  = 0
    int count = 0


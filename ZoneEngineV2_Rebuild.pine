journalResetRaw(ZoneEngine engine, int baseSeq, int baseCloseTime) =>
    engine.w03Store.journalCount              := 0
    engine.w03Store.journalBaseSeq            := baseSeq
    engine.w03Store.journalBaseCloseTime      := baseCloseTime
    engine.w03Store.journalInvariantViolation := false
journalAppendRaw(ZoneEngine engine, int op, int group, int targetRootSlot, int expectedRootId, int category, int subtype, int tfCode, int originKey, int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom, float nativeTop, int oldState, int newState, bool fvgFresh, bool isBroad, int direction, int oldMask, int newMask, int pairKey, int slopeDir) =>
    int row = engine.w03Store.journalCount
    if row < array.size(engine.w03Store.journalOps)
        array.set(engine.w03Store.journalOps,             row, op)
        array.set(engine.w03Store.journalGroups,          row, group)
        array.set(engine.w03Store.journalTargetRootSlots, row, targetRootSlot)
        array.set(engine.w03Store.journalExpectedRootIds, row, expectedRootId)
        array.set(engine.w03Store.journalCategories,      row, category)
        array.set(engine.w03Store.journalSubtypes,        row, subtype)
        array.set(engine.w03Store.journalTfCodes,         row, tfCode)
        array.set(engine.w03Store.journalOriginKeys,      row, originKey)
        array.set(engine.w03Store.journalOriginTimes,     row, originTime)
        array.set(engine.w03Store.journalOriginEndTimes,  row, originEndTime)
        array.set(engine.w03Store.journalConfirmedTimes,  row, confirmedTime)
        array.set(engine.w03Store.journalPointPrices,     row, pointPrice)
        array.set(engine.w03Store.journalNativeBottoms,   row, nativeBottom)
        array.set(engine.w03Store.journalNativeTops,      row, nativeTop)
        array.set(engine.w03Store.journalOldStates,       row, oldState)
        array.set(engine.w03Store.journalNewStates,       row, newState)
        array.set(engine.w03Store.journalFvgFreshFlags,   row, fvgFresh)
        array.set(engine.w03Store.journalIsBroadFlags,    row, isBroad)
        array.set(engine.w03Store.journalDirections,      row, direction)
        array.set(engine.w03Store.journalOldMasks,        row, oldMask)
        array.set(engine.w03Store.journalNewMasks,        row, newMask)
        array.set(engine.w03Store.journalPairKeys,        row, pairKey)
        array.set(engine.w03Store.journalSlopeDirs,       row, slopeDir)
    else
        array.push(engine.w03Store.journalOps,             op)
        array.push(engine.w03Store.journalGroups,          group)
        array.push(engine.w03Store.journalTargetRootSlots, targetRootSlot)
        array.push(engine.w03Store.journalExpectedRootIds, expectedRootId)
        array.push(engine.w03Store.journalCategories,      category)
        array.push(engine.w03Store.journalSubtypes,        subtype)
        array.push(engine.w03Store.journalTfCodes,         tfCode)
        array.push(engine.w03Store.journalOriginKeys,      originKey)
        array.push(engine.w03Store.journalOriginTimes,     originTime)
        array.push(engine.w03Store.journalOriginEndTimes,  originEndTime)
        array.push(engine.w03Store.journalConfirmedTimes,  confirmedTime)
        array.push(engine.w03Store.journalPointPrices,     pointPrice)
        array.push(engine.w03Store.journalNativeBottoms,   nativeBottom)
        array.push(engine.w03Store.journalNativeTops,      nativeTop)
        array.push(engine.w03Store.journalOldStates,       oldState)
        array.push(engine.w03Store.journalNewStates,       newState)
        array.push(engine.w03Store.journalFvgFreshFlags,   fvgFresh)
        array.push(engine.w03Store.journalIsBroadFlags,    isBroad)
        array.push(engine.w03Store.journalDirections,      direction)
        array.push(engine.w03Store.journalOldMasks,        oldMask)
        array.push(engine.w03Store.journalNewMasks,        newMask)
        array.push(engine.w03Store.journalPairKeys,        pairKey)
        array.push(engine.w03Store.journalSlopeDirs,       slopeDir)
    engine.w03Store.journalCount := row + 1
    row
originKeyComputeRaw(int category, int subtype, int tfCode, int pointTick, int originTime, int direction) =>
    int h = FP_SEED_A
    h := fpMixInt(h, FP_MULT_A, fpIntKey(category))
    if category == CAT_MA
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
    else if category == CAT_SWING
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_ACCUM
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_TIME_HL
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_FVG
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(direction))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_PSYCH
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    h == 0 ? 1 : h
originBucketAttachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.w02Aux.rootOriginBucketPrevRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
    int key     = ID_NONE
    int oldHead = SLOT_INVALID
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        key := array.get(engine.rootOriginKeys, rootSlot)
        ok  := key != ID_NONE and array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, rootSlot) == SLOT_INVALID and array.get(engine.w02Aux.rootOriginBucketNextRootSlots, rootSlot) == SLOT_INVALID and array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot) == ID_NONE
    if ok and map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, key)
        oldHead := map.get(engine.w02Aux.originKeyBucketHeadRootSlots, key)
        ok      := oldHead != rootSlot and oldHead >= 0 and oldHead < array.size(engine.rootIds)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, oldHead)
        if ok
            ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, oldHead) == array.get(engine.rootIds, oldHead) and array.get(engine.rootOriginKeys, oldHead) == key
    if ok
        array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, oldHead)
        array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, expectedRootId)
        if oldHead != SLOT_INVALID
            array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, oldHead, rootSlot)
        map.put(engine.w02Aux.originKeyBucketHeadRootSlots, key, rootSlot)
    ok
originBucketDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootOriginKeys) and rootSlot < array.size(engine.w02Aux.rootOriginBucketPrevRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and rootSlot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
    int key  = ID_NONE
    int prev = SLOT_INVALID
    int next = SLOT_INVALID
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        key  := array.get(engine.rootOriginKeys, rootSlot)
        ok   := key != ID_NONE and array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot) == expectedRootId
    if ok
        prev := array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, rootSlot)
        next := array.get(engine.w02Aux.rootOriginBucketNextRootSlots, rootSlot)
        ok   := prev != rootSlot and next != rootSlot
    if ok
        if prev == SLOT_INVALID
            ok := map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, key)
            if ok
                ok := map.get(engine.w02Aux.originKeyBucketHeadRootSlots, key) == rootSlot
        else
            ok := prev >= 0 and prev < array.size(engine.rootIds)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, prev)
            if ok
                ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, prev) == array.get(engine.rootIds, prev) and array.get(engine.rootOriginKeys, prev) == key and array.get(engine.w02Aux.rootOriginBucketNextRootSlots, prev) == rootSlot
    if ok and next != SLOT_INVALID
        ok := next >= 0 and next < array.size(engine.rootIds)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, next)
        if ok
            ok := array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, next) == array.get(engine.rootIds, next) and array.get(engine.rootOriginKeys, next) == key and array.get(engine.w02Aux.rootOriginBucketPrevRootSlots, next) == rootSlot
    if ok
        if prev == SLOT_INVALID
            if next == SLOT_INVALID
                map.remove(engine.w02Aux.originKeyBucketHeadRootSlots, key)
            else
                map.put(engine.w02Aux.originKeyBucketHeadRootSlots, key, next)
                array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, next, SLOT_INVALID)
        else
            array.set(engine.w02Aux.rootOriginBucketNextRootSlots, prev, next)
            if next != SLOT_INVALID
                array.set(engine.w02Aux.rootOriginBucketPrevRootSlots, next, prev)
        array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, SLOT_INVALID)
        array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, ID_NONE)
    ok
originTupleEqualRaw(int incomingCategory, int incomingSubtype, int incomingTfCode, int incomingPointTick, int incomingOriginTime, int incomingOriginEndTime, int incomingDirection, int storedCategory, int storedSubtype, int storedTfCode, int storedPointTick, int storedOriginTime, int storedOriginEndTime, int storedDirection) =>
    bool equal = false
    if incomingCategory == CAT_MA
        equal := storedCategory == CAT_MA and incomingTfCode == TF_1M and storedTfCode == TF_1M and not na(incomingSubtype) and incomingSubtype == storedSubtype
    else if incomingCategory == CAT_SWING
        bool tfOk   = (incomingTfCode == TF_5M or incomingTfCode == TF_15M or incomingTfCode == TF_1H) and (storedTfCode == TF_5M or storedTfCode == TF_15M or storedTfCode == TF_1H)
        bool baseOk = storedCategory == CAT_SWING and tfOk and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
        bool timeOk = not na(incomingOriginTime) and not na(incomingOriginEndTime) and not na(storedOriginTime) and not na(storedOriginEndTime)
        if baseOk and timeOk
            if incomingTfCode == storedTfCode
                equal := incomingOriginTime == storedOriginTime and incomingOriginEndTime == storedOriginEndTime
            else if storedTfCode < incomingTfCode
                equal := storedOriginTime >= incomingOriginTime and storedOriginTime < incomingOriginEndTime
            else
                equal := incomingOriginTime >= storedOriginTime and incomingOriginTime < storedOriginEndTime
    else if incomingCategory == CAT_ACCUM
        equal := storedCategory == CAT_ACCUM and not na(incomingTfCode) and incomingTfCode == storedTfCode and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_TIME_HL
        equal := storedCategory == CAT_TIME_HL and incomingTfCode == TF_5M and storedTfCode == TF_5M and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else if incomingCategory == CAT_FVG
        equal := storedCategory == CAT_FVG and not na(incomingTfCode) and incomingTfCode == storedTfCode and (incomingDirection == FVG_BULLISH or incomingDirection == FVG_BEARISH) and incomingDirection == storedDirection and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_PSYCH
        equal := storedCategory == CAT_PSYCH and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    equal
originLookupUniqueRaw(ZoneEngine engine, int originKey, int category, int subtype, int tfCode, int pointTick, int originTime, int originEndTime, int direction, float mintick) =>
    int  matchCount        = 0
    int  matchedRootSlot   = SLOT_INVALID
    int  matchedPendingRow = SLOT_INVALID
    bool violation         = false
    if originKey != ID_NONE
        if map.contains(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
            int slot      = map.get(engine.w02Aux.originKeyBucketHeadRootSlots, originKey)
            int stepLimit = array.size(engine.rootIds)
            int steps     = 0
            while slot != SLOT_INVALID and not violation and steps < stepLimit
                bool nodeOk = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootOriginKeys) and slot < array.size(engine.w02Aux.rootOriginBucketNextRootSlots) and slot < array.size(engine.w02Aux.rootOriginBucketExpectedRootIds)
                if nodeOk
                    nodeOk := array.get(engine.rootSlotLiveFlags, slot)
                if nodeOk
                    int bucketRootId = array.get(engine.w02Aux.rootOriginBucketExpectedRootIds, slot)
                    nodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(engine.rootIds, slot) and array.get(engine.rootOriginKeys, slot) == originKey
                if not nodeOk
                    violation := true
                else
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(engine.rootCategories, slot), array.get(engine.rootSubtypes, slot), array.get(engine.rootTfCodes, slot), array.get(engine.rootPointTicks, slot), array.get(engine.rootOriginTimes, slot), array.get(engine.rootOriginEndTimes, slot), array.get(engine.rootDirections, slot))
                        matchCount += 1
                        if matchCount == 1
                            matchedRootSlot := slot
                        else
                            violation := true
                    slot  := array.get(engine.w02Aux.rootOriginBucketNextRootSlots, slot)
                    steps += 1
            if not violation and slot != SLOT_INVALID
                violation := true
        if not violation
            int journalCount = engine.w03Store.journalCount
            int row = 0
            while row < journalCount and not violation
                if array.get(engine.w03Store.journalOps, row) == JOP_NEW_ROOT and array.get(engine.w03Store.journalOriginKeys, row) == originKey
                    float pendingPrice = array.get(engine.w03Store.journalPointPrices, row)
                    int   pendingTick  = na(pendingPrice) ? int(na) : int(math.round(pendingPrice / mintick))
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(engine.w03Store.journalCategories, row), array.get(engine.w03Store.journalSubtypes, row), array.get(engine.w03Store.journalTfCodes, row), pendingTick, array.get(engine.w03Store.journalOriginTimes, row), array.get(engine.w03Store.journalOriginEndTimes, row), array.get(engine.w03Store.journalDirections, row))
                        matchCount += 1
                        if matchCount == 1
                            matchedPendingRow := row
                        else
                            violation := true
                row += 1
    if violation
        engine.w03Store.journalInvariantViolation := true
    [violation ? SLOT_INVALID : matchedRootSlot, violation ? SLOT_INVALID : matchedPendingRow]
rootPriceOrderUpperBoundRaw(ZoneEngine engine, int pointTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(pointTick)
    if ok
        int lo = 0
        int hi = array.size(engine.rootPriceOrderSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2))
            int slot = array.get(engine.rootPriceOrderSlots, mid)
            bool entryOk = slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if entryOk
                entryOk := array.get(engine.rootSlotLiveFlags, slot) and array.get(engine.rootPriceOrderPositions, slot) == mid and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot))
            if not entryOk
                ok := false
            else if array.get(engine.rootPointTicks, slot) <= pointTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]
rootPriceOrderInsertRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int newTick   = int(na)
    int insertPos = SLOT_INVALID
    int oldSize   = array.size(engine.rootPriceOrderSlots)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        newTick := array.get(engine.rootPointTicks, rootSlot)
        ok      := not array.get(engine.rootIsRangeRootFlags, rootSlot) and not na(newTick) and array.get(engine.rootPriceOrderPositions, rootSlot) == SLOT_INVALID
    if ok
        [upperPos, upperOk] = rootPriceOrderUpperBoundRaw(engine, newTick)
        ok        := upperOk
        insertPos := upperPos
    if ok
        int i = insertPos
        while ok and i < oldSize
            int slot = array.get(engine.rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(engine.rootIds) and slot < array.size(engine.rootSlotLiveFlags) and slot < array.size(engine.rootPointTicks) and slot < array.size(engine.rootIsRangeRootFlags) and slot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, slot) and not array.get(engine.rootIsRangeRootFlags, slot) and not na(array.get(engine.rootPointTicks, slot)) and array.get(engine.rootPriceOrderPositions, slot) == i
            i += 1
    if ok and insertPos > 0
        int leftSlot = array.get(engine.rootPriceOrderSlots, insertPos - 1)
        ok := leftSlot >= 0 and leftSlot < array.size(engine.rootIds) and leftSlot < array.size(engine.rootSlotLiveFlags) and leftSlot < array.size(engine.rootPointTicks) and leftSlot < array.size(engine.rootIsRangeRootFlags) and leftSlot < array.size(engine.rootPriceOrderPositions)
        if ok
            ok := array.get(engine.rootSlotLiveFlags, leftSlot) and not array.get(engine.rootIsRangeRootFlags, leftSlot) and not na(array.get(engine.rootPointTicks, leftSlot)) and array.get(engine.rootPriceOrderPositions, leftSlot) == insertPos - 1
        if ok
            ok := array.get(engine.rootPointTicks, leftSlot) <= newTick
    if ok and insertPos < oldSize
        ok := array.get(engine.rootPointTicks, array.get(engine.rootPriceOrderSlots, insertPos)) > newTick
    if ok
        array.push(engine.rootPriceOrderSlots, rootSlot)
        int i = oldSize
        while i > insertPos
            int movedSlot = array.get(engine.rootPriceOrderSlots, i - 1)
            array.set(engine.rootPriceOrderSlots, i, movedSlot)
            array.set(engine.rootPriceOrderPositions, movedSlot, i)
            i -= 1
        array.set(engine.rootPriceOrderSlots, insertPos, rootSlot)
        array.set(engine.rootPriceOrderPositions, rootSlot, insertPos)
    ok
rootPriceOrderDetachRaw(ZoneEngine engine, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootPointTicks) and rootSlot < array.size(engine.rootIsRangeRootFlags) and rootSlot < array.size(engine.rootPriceOrderPositions)
    int pos       = SLOT_INVALID
    int orderSize = array.size(engine.rootPriceOrderSlots)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(engine.rootIds, rootSlot) == expectedRootId
    if ok
        pos := array.get(engine.rootPriceOrderPositions, rootSlot)
        ok  := pos != SLOT_INVALID and pos >= 0 and pos < orderSize
    if ok
        ok := array.get(engine.rootPriceOrderSlots, pos) == rootSlot and not array.get(engine.rootIsRangeRootFlags, rootSlot) and not na(array.get(engine.rootPointTicks, rootSlot))
    if ok
        int i = pos + 1
        while ok and i < orderSize
            int movedSlot = array.get(engine.rootPriceOrderSlots, i)
            ok := movedSlot >= 0 and movedSlot < array.size(engine.rootIds) and movedSlot < array.size(engine.rootSlotLiveFlags) and movedSlot < array.size(engine.rootPointTicks) and movedSlot < array.size(engine.rootIsRangeRootFlags) and movedSlot < array.size(engine.rootPriceOrderPositions)
            if ok
                ok := array.get(engine.rootSlotLiveFlags, movedSlot) and not array.get(engine.rootIsRangeRootFlags, movedSlot) and not na(array.get(engine.rootPointTicks, movedSlot)) and array.get(engine.rootPriceOrderPositions, movedSlot) == i
            i += 1
    if ok
        int i = pos
        while i < orderSize - 1
            int movedSlot = array.get(engine.rootPriceOrderSlots, i + 1)
            array.set(engine.rootPriceOrderSlots, i, movedSlot)
            array.set(engine.rootPriceOrderPositions, movedSlot, i)
            i += 1
        array.pop(engine.rootPriceOrderSlots)
        array.set(engine.rootPriceOrderPositions, rootSlot, SLOT_INVALID)
    ok
participationEdgeResetRaw(ZoneEngine engine, int edgeIndex) =>
    array.set(engine.participationEdgeRootSlots,         edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeExpectedRootIds,   edgeIndex, ID_NONE)
    array.set(engine.participationEdgeSideSlots,         edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeExpectedCoreIds,   edgeIndex, ID_NONE)
    array.set(engine.participationEdgeNextByRootIndexes, edgeIndex, SLOT_INVALID)
    array.set(engine.participationEdgeLiveFlags,         edgeIndex, false)
participationEdgeAllocRaw(ZoneEngine engine) =>
    int edgeIndex = SLOT_INVALID
    if array.size(engine.participationEdgeFreeIndexes) > 0
        edgeIndex := array.pop(engine.participationEdgeFreeIndexes)
        participationEdgeResetRaw(engine, edgeIndex)
    else
        edgeIndex := array.size(engine.participationEdgeRootSlots)
        array.push(engine.participationEdgeRootSlots,         SLOT_INVALID)
        array.push(engine.participationEdgeExpectedRootIds,   ID_NONE)
        array.push(engine.participationEdgeSideSlots,         SLOT_INVALID)
        array.push(engine.participationEdgeExpectedCoreIds,   ID_NONE)
        array.push(engine.participationEdgeNextByRootIndexes, SLOT_INVALID)
        array.push(engine.participationEdgeLiveFlags,         false)
    edgeIndex
participationEdgeFreeRaw(ZoneEngine engine, int edgeIndex) =>
    bool freed = false
    if edgeIndex >= 0 and edgeIndex < array.size(engine.participationEdgeLiveFlags)
        if array.get(engine.participationEdgeLiveFlags, edgeIndex)
            participationEdgeResetRaw(engine, edgeIndex)
            array.push(engine.participationEdgeFreeIndexes, edgeIndex)
            freed := true
    freed
participationRootChainValidRaw(ZoneEngine engine, int rootSlot) =>
    bool valid = false
    bool ok = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    if ok
        ok := array.get(engine.rootSlotLiveFlags, rootSlot) and array.get(engine.rootIds, rootSlot) != ID_NONE
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if ok
        ok := edgeRowCount == array.size(engine.participationEdgeExpectedRootIds) and edgeRowCount == array.size(engine.participationEdgeSideSlots) and edgeRowCount == array.size(engine.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(engine.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(engine.participationEdgeLiveFlags)
    if ok
        int rootId = array.get(engine.rootIds,                           rootSlot)
        int head   = array.get(engine.rootParticipationHeadEdgeIndexes,  rootSlot)
        int count  = array.get(engine.rootParticipationCounts,           rootSlot)
        if count < 0 or count > edgeRowCount
            ok := false
        if ok and count == 0
            valid := head == SLOT_INVALID
        if ok and count > 0
            bool chainOk   = head != SLOT_INVALID
            int  edgeIndex = head
            int  seen      = 0
            while chainOk and seen < count
                bool rowOk = edgeIndex >= 0 and edgeIndex < edgeRowCount
                if rowOk
                    rowOk := array.get(engine.participationEdgeLiveFlags, edgeIndex)
                if rowOk
                    rowOk := array.get(engine.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, edgeIndex) == rootId
                int edgeSideSlot = SLOT_INVALID
                int edgeCoreSlot = SLOT_INVALID
                if rowOk
                    edgeSideSlot := array.get(engine.participationEdgeSideSlots, edgeIndex)
                    rowOk := edgeSideSlot >= 0 and edgeSideSlot < array.size(engine.sidePhases)
                if rowOk
                    edgeCoreSlot := int(math.floor(edgeSideSlot / 2))
                    int edgeSideIndex = edgeSideSlot - edgeCoreSlot * 2
                    rowOk := (edgeSideIndex == 0 or edgeSideIndex == 1) and edgeCoreSlot >= 0 and edgeCoreSlot < array.size(engine.coreIds) and edgeCoreSlot < array.size(engine.coreSlotLiveFlags)
                if rowOk
                    rowOk := array.get(engine.coreSlotLiveFlags, edgeCoreSlot)
                if rowOk
                    int edgeExpectedCoreId = array.get(engine.participationEdgeExpectedCoreIds, edgeIndex)
                    rowOk := edgeExpectedCoreId != ID_NONE and array.get(engine.coreIds, edgeCoreSlot) == edgeExpectedCoreId
                if rowOk
                    edgeIndex := array.get(engine.participationEdgeNextByRootIndexes, edgeIndex)
                    seen      += 1
                else
                    chainOk := false
            if chainOk
                valid := seen == count and edgeIndex == SLOT_INVALID
    valid
participationDuplicateExistsRaw(ZoneEngine engine, int rootSlot, int expectedRootId, int sideSlot, int expectedCoreId) =>
    bool found = false
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if rootSlot >= 0 and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
        int count     = array.get(engine.rootParticipationCounts,          rootSlot)
        int edgeIndex = array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        int seen      = 0
        while not found and seen < count and edgeIndex >= 0 and edgeIndex < edgeRowCount
            bool sameEdge = array.get(engine.participationEdgeLiveFlags, edgeIndex)
            if sameEdge
                sameEdge := array.get(engine.participationEdgeRootSlots, edgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, edgeIndex) == expectedRootId and array.get(engine.participationEdgeSideSlots, edgeIndex) == sideSlot and array.get(engine.participationEdgeExpectedCoreIds, edgeIndex) == expectedCoreId
            if sameEdge
                found := true
            else
                edgeIndex := array.get(engine.participationEdgeNextByRootIndexes, edgeIndex)
                seen      += 1
    found
participationAddRaw(ZoneEngine engine, int rootSlot, int sideSlot) =>
    bool added = false
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    bool sideOk         = rootOk and sideSlot >= 0 and sideSlot < array.size(engine.sidePhases)
    int  coreSlot       = SLOT_INVALID
    int  expectedCoreId = ID_NONE
    if sideOk
        coreSlot      := int(math.floor(sideSlot / 2))
        int sideIndex = sideSlot - coreSlot * 2
        sideOk        := (sideIndex == 0 or sideIndex == 1) and coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    if sideOk
        sideOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if sideOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        sideOk         := expectedCoreId != ID_NONE
    bool ready = sideOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    if ready
        ready := not participationDuplicateExistsRaw(engine, rootSlot, expectedRootId, sideSlot, expectedCoreId)
    if ready
        int freeCount = array.size(engine.participationEdgeFreeIndexes)
        if freeCount > 0
            int topIndex = array.get(engine.participationEdgeFreeIndexes, freeCount - 1)
            ready := topIndex >= 0 and topIndex < array.size(engine.participationEdgeRootSlots)
            if ready
                ready := not array.get(engine.participationEdgeLiveFlags, topIndex)
    if ready
        int oldHead   = array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        int oldCount  = array.get(engine.rootParticipationCounts,          rootSlot)
        int edgeIndex = participationEdgeAllocRaw(engine)
        array.set(engine.participationEdgeRootSlots,         edgeIndex, rootSlot)
        array.set(engine.participationEdgeExpectedRootIds,   edgeIndex, expectedRootId)
        array.set(engine.participationEdgeSideSlots,         edgeIndex, sideSlot)
        array.set(engine.participationEdgeExpectedCoreIds,   edgeIndex, expectedCoreId)
        array.set(engine.participationEdgeNextByRootIndexes, edgeIndex, oldHead)
        array.set(engine.rootParticipationHeadEdgeIndexes,   rootSlot,  edgeIndex)
        array.set(engine.rootParticipationCounts,            rootSlot,  oldCount + 1)
        array.set(engine.participationEdgeLiveFlags,         edgeIndex, true)
        added := true
    added
participationDetachRaw(ZoneEngine engine, int rootSlot, int sideSlot) =>
    bool detached = false
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    bool sideOk         = rootOk and sideSlot >= 0 and sideSlot < array.size(engine.sidePhases)
    int  coreSlot       = SLOT_INVALID
    int  expectedCoreId = ID_NONE
    if sideOk
        coreSlot      := int(math.floor(sideSlot / 2))
        int sideIndex = sideSlot - coreSlot * 2
        sideOk        := (sideIndex == 0 or sideIndex == 1) and coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    if sideOk
        sideOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if sideOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        sideOk         := expectedCoreId != ID_NONE
    bool ready    = sideOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    int oldHead  = SLOT_INVALID
    int oldCount = 0
    if ready
        oldHead  := array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        oldCount := array.get(engine.rootParticipationCounts,          rootSlot)
        ready    := oldCount > 0
    int targetEdgeIndex         = SLOT_INVALID
    int targetPreviousEdgeIndex = SLOT_INVALID
    int targetNextEdgeIndex     = SLOT_INVALID
    int matchCount              = 0
    int seen                    = 0
    int scanEdgeIndex           = oldHead
    int previousEdgeIndex       = SLOT_INVALID
    if ready
        int edgeRowCount = array.size(engine.participationEdgeRootSlots)
        while seen < oldCount and scanEdgeIndex >= 0 and scanEdgeIndex < edgeRowCount
            bool isTarget = array.get(engine.participationEdgeLiveFlags, scanEdgeIndex)
            if isTarget
                isTarget := array.get(engine.participationEdgeRootSlots, scanEdgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, scanEdgeIndex) == expectedRootId and array.get(engine.participationEdgeSideSlots, scanEdgeIndex) == sideSlot and array.get(engine.participationEdgeExpectedCoreIds, scanEdgeIndex) == expectedCoreId
            int nextEdgeIndex = array.get(engine.participationEdgeNextByRootIndexes, scanEdgeIndex)
            if isTarget
                matchCount += 1
                if matchCount == 1
                    targetEdgeIndex         := scanEdgeIndex
                    targetPreviousEdgeIndex := previousEdgeIndex
                    targetNextEdgeIndex     := nextEdgeIndex
            previousEdgeIndex := scanEdgeIndex
            scanEdgeIndex     := nextEdgeIndex
            seen              += 1
        ready := seen == oldCount and scanEdgeIndex == SLOT_INVALID
    if ready
        ready := matchCount == 1
    if ready
        ready := targetEdgeIndex >= 0 and targetEdgeIndex < array.size(engine.participationEdgeLiveFlags)
    if ready
        ready := array.get(engine.participationEdgeLiveFlags, targetEdgeIndex)
    if ready
        if targetPreviousEdgeIndex == SLOT_INVALID
            ready := targetEdgeIndex == oldHead
        else
            ready := targetPreviousEdgeIndex >= 0 and targetPreviousEdgeIndex < array.size(engine.participationEdgeNextByRootIndexes)
            if ready
                ready := array.get(engine.participationEdgeNextByRootIndexes, targetPreviousEdgeIndex) == targetEdgeIndex
    if ready
        if targetPreviousEdgeIndex == SLOT_INVALID
            array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, targetNextEdgeIndex)
        else
            array.set(engine.participationEdgeNextByRootIndexes, targetPreviousEdgeIndex, targetNextEdgeIndex)
        array.set(engine.rootParticipationCounts, rootSlot, oldCount - 1)
        detached := participationEdgeFreeRaw(engine, targetEdgeIndex)
    detached
participationDetachAllForRootRaw(ZoneEngine engine, int rootSlot) =>
    bool done = false
    bool rootOk         = rootSlot >= 0 and rootSlot < array.size(engine.rootIds) and rootSlot < array.size(engine.rootSlotLiveFlags) and rootSlot < array.size(engine.rootParticipationHeadEdgeIndexes) and rootSlot < array.size(engine.rootParticipationCounts)
    int  expectedRootId = ID_NONE
    if rootOk
        rootOk := array.get(engine.rootSlotLiveFlags, rootSlot)
    if rootOk
        expectedRootId := array.get(engine.rootIds, rootSlot)
        rootOk         := expectedRootId != ID_NONE
    bool ready = rootOk
    if ready
        ready := participationRootChainValidRaw(engine, rootSlot)
    int oldHead  = SLOT_INVALID
    int oldCount = 0
    if ready
        oldHead  := array.get(engine.rootParticipationHeadEdgeIndexes, rootSlot)
        oldCount := array.get(engine.rootParticipationCounts,          rootSlot)
    if ready and oldCount == 0
        done := true
    bool commitReady = ready and oldCount > 0
    if commitReady
        int  edgeRowCount  = array.size(engine.participationEdgeRootSlots)
        int  scanEdgeIndex = oldHead
        int  seen          = 0
        bool scanOk        = true
        while scanOk and seen < oldCount
            bool rowOk = scanEdgeIndex >= 0 and scanEdgeIndex < edgeRowCount
            if rowOk
                rowOk := array.get(engine.participationEdgeLiveFlags, scanEdgeIndex)
            if rowOk
                rowOk := array.get(engine.participationEdgeRootSlots, scanEdgeIndex) == rootSlot and array.get(engine.participationEdgeExpectedRootIds, scanEdgeIndex) == expectedRootId
            if rowOk
                scanEdgeIndex := array.get(engine.participationEdgeNextByRootIndexes, scanEdgeIndex)
                seen          += 1
            else
                scanOk := false
        commitReady := scanOk and seen == oldCount and scanEdgeIndex == SLOT_INVALID
    if commitReady
        array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, SLOT_INVALID)
        array.set(engine.rootParticipationCounts,          rootSlot, 0)
        int freeEdgeIndex = oldHead
        int freed         = 0
        while freed < oldCount
            int nextEdgeIndex = array.get(engine.participationEdgeNextByRootIndexes, freeEdgeIndex)
            participationEdgeFreeRaw(engine, freeEdgeIndex)
            freeEdgeIndex := nextEdgeIndex
            freed         += 1
        done := true
    done
participationDetachAllForCoreRaw(ZoneEngine engine, int coreSlot) =>
    bool done = false
    bool coreOk         = coreSlot >= 0 and coreSlot < array.size(engine.coreIds) and coreSlot < array.size(engine.coreSlotLiveFlags)
    int  expectedCoreId = ID_NONE
    if coreOk
        coreOk := array.get(engine.coreSlotLiveFlags, coreSlot)
    if coreOk
        expectedCoreId := array.get(engine.coreIds, coreSlot)
        coreOk         := expectedCoreId != ID_NONE
    int  supportSideSlot    = coreSlot * 2
    int  resistanceSideSlot = coreSlot * 2 + 1
    bool ready = coreOk and supportSideSlot >= 0 and resistanceSideSlot < array.size(engine.sidePhases)
    int edgeRowCount = array.size(engine.participationEdgeRootSlots)
    if ready
        ready := edgeRowCount == array.size(engine.participationEdgeExpectedRootIds) and edgeRowCount == array.size(engine.participationEdgeSideSlots) and edgeRowCount == array.size(engine.participationEdgeExpectedCoreIds) and edgeRowCount == array.size(engine.participationEdgeNextByRootIndexes) and edgeRowCount == array.size(engine.participationEdgeLiveFlags)
    int rootRowCount = array.size(engine.rootIds)
    if ready
        ready := rootRowCount == array.size(engine.rootSlotLiveFlags) and rootRowCount == array.size(engine.rootParticipationHeadEdgeIndexes) and rootRowCount == array.size(engine.rootParticipationCounts)
    int chainEdgeCount = 0
    if ready
        int rootScan = 0
        while ready and rootScan < rootRowCount
            if array.get(engine.rootSlotLiveFlags, rootScan)
                if participationRootChainValidRaw(engine, rootScan)
                    chainEdgeCount += array.get(engine.rootParticipationCounts, rootScan)
                else
                    ready := false
            else
                ready := array.get(engine.rootParticipationHeadEdgeIndexes, rootScan) == SLOT_INVALID and array.get(engine.rootParticipationCounts, rootScan) == 0
            rootScan += 1
    int liveEdgeCount   = 0
    int targetEdgeCount = 0
    if ready
        int edgeScan = 0
        while ready and edgeScan < edgeRowCount
            if array.get(engine.participationEdgeLiveFlags, edgeScan)
                liveEdgeCount += 1
                int scanSideSlot = array.get(engine.participationEdgeSideSlots, edgeScan)
                int scanCoreSlot = scanSideSlot >= 0 ? int(math.floor(scanSideSlot / 2)) : SLOT_INVALID
                bool slotMatch = scanCoreSlot == coreSlot
                bool idMatch   = array.get(engine.participationEdgeExpectedCoreIds, edgeScan) == expectedCoreId
                if slotMatch != idMatch
                    ready := false
                else if slotMatch
                    targetEdgeCount += 1
            edgeScan += 1
    if ready
        ready := chainEdgeCount == liveEdgeCount
    if ready and targetEdgeCount == 0
        done := true
    bool commitReady = ready and targetEdgeCount > 0
    if commitReady
        int rootIdx = 0
        while rootIdx < rootRowCount
            if array.get(engine.rootSlotLiveFlags, rootIdx)
                int oldHead  = array.get(engine.rootParticipationHeadEdgeIndexes, rootIdx)
                int oldCount = array.get(engine.rootParticipationCounts,          rootIdx)
                int removeCount = 0
                int countIdx    = oldHead
                int counted     = 0
                while counted < oldCount
                    int countSideSlot = array.get(engine.participationEdgeSideSlots, countIdx)
                    int countCoreSlot = countSideSlot >= 0 ? int(math.floor(countSideSlot / 2)) : SLOT_INVALID
                    if countCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, countIdx) == expectedCoreId
                        removeCount += 1
                    countIdx := array.get(engine.participationEdgeNextByRootIndexes, countIdx)
                    counted  += 1
                if removeCount > 0
                    int  newHead               = SLOT_INVALID
                    int  previousKeptEdgeIndex = SLOT_INVALID
                    int  keptCount             = 0
                    int  rebuildIdx            = oldHead
                    int  walked                = 0
                    while walked < oldCount
                        int  nextEdgeIndex   = array.get(engine.participationEdgeNextByRootIndexes, rebuildIdx)
                        int  rebuildSideSlot = array.get(engine.participationEdgeSideSlots, rebuildIdx)
                        int  rebuildCoreSlot = rebuildSideSlot >= 0 ? int(math.floor(rebuildSideSlot / 2)) : SLOT_INVALID
                        bool isTarget        = rebuildCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, rebuildIdx) == expectedCoreId
                        if not isTarget
                            if newHead == SLOT_INVALID
                                newHead := rebuildIdx
                            if previousKeptEdgeIndex != SLOT_INVALID
                                array.set(engine.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, rebuildIdx)
                            previousKeptEdgeIndex := rebuildIdx
                            keptCount             += 1
                        rebuildIdx := nextEdgeIndex
                        walked     += 1
                    if previousKeptEdgeIndex != SLOT_INVALID
                        array.set(engine.participationEdgeNextByRootIndexes, previousKeptEdgeIndex, SLOT_INVALID)
                    array.set(engine.rootParticipationHeadEdgeIndexes, rootIdx, newHead)
                    array.set(engine.rootParticipationCounts,          rootIdx, keptCount)
            rootIdx += 1
        int freeIdx = 0
        while freeIdx < edgeRowCount
            if array.get(engine.participationEdgeLiveFlags, freeIdx)
                int freeSideSlot = array.get(engine.participationEdgeSideSlots, freeIdx)
                int freeCoreSlot = freeSideSlot >= 0 ? int(math.floor(freeSideSlot / 2)) : SLOT_INVALID
                if freeCoreSlot == coreSlot and array.get(engine.participationEdgeExpectedCoreIds, freeIdx) == expectedCoreId
                    participationEdgeFreeRaw(engine, freeIdx)
            freeIdx += 1
        done := true
    done
touchStartSnapshotRootNodeResetRaw(ZoneEngine engine, int nodeIndex) =>
    array.set(engine.w02Aux.touchStartSnapshotRootNodeRootIds,               nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeNextIndexes,           nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeOwnerSideSlots,        nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedCoreIds,       nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedGenerationIds, nodeIndex, ID_NONE)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeExpectedTouchNos,      nodeIndex, 0)
    array.set(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags,             nodeIndex, false)
touchStartSnapshotRootNodeAllocRaw(ZoneEngine engine) =>
    int nodeIndex = SLOT_INVALID
    if array.size(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes) > 0
        nodeIndex := array.pop(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes)
        touchStartSnapshotRootNodeResetRaw(engine, nodeIndex)
    else
        nodeIndex := array.size(engine.w02Aux.touchStartSnapshotRootNodeRootIds)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeRootIds,               ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeNextIndexes,           SLOT_INVALID)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeOwnerSideSlots,        SLOT_INVALID)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedCoreIds,       ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedGenerationIds, ID_NONE)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeExpectedTouchNos,      0)
        array.push(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags,             false)
    nodeIndex
touchStartSnapshotRootNodeFreeRaw(ZoneEngine engine, int nodeIndex) =>
    bool freed = false
    if nodeIndex >= 0 and nodeIndex < array.size(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags)
        if array.get(engine.w02Aux.touchStartSnapshotRootNodeLiveFlags, nodeIndex)
            touchStartSnapshotRootNodeResetRaw(engine, nodeIndex)
            array.push(engine.w02Aux.touchStartSnapshotRootNodeFreeIndexes, nodeIndex)
            freed := true
    freed
breakSnapshotRootNodeResetRaw(ZoneEngine engine, int nodeIndex) =>
    array.set(engine.w02Aux.breakSnapshotRootNodeRootIds,               nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeNextIndexes,           nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.breakSnapshotRootNodeOwnerSideSlots,        nodeIndex, SLOT_INVALID)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedCoreIds,       nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedGenerationIds, nodeIndex, ID_NONE)
    array.set(engine.w02Aux.breakSnapshotRootNodeExpectedBreakSeqs,     nodeIndex, SEQ_UNSET)
    array.set(engine.w02Aux.breakSnapshotRootNodeLiveFlags,             nodeIndex, false)
breakSnapshotRootNodeAllocRaw(ZoneEngine engine) =>
    int nodeIndex = SLOT_INVALID
    if array.size(engine.w02Aux.breakSnapshotRootNodeFreeIndexes) > 0
        nodeIndex := array.pop(engine.w02Aux.breakSnapshotRootNodeFreeIndexes)
        breakSnapshotRootNodeResetRaw(engine, nodeIndex)
    else
        nodeIndex := array.size(engine.w02Aux.breakSnapshotRootNodeRootIds)
        array.push(engine.w02Aux.breakSnapshotRootNodeRootIds,               ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeNextIndexes,           SLOT_INVALID)
        array.push(engine.w02Aux.breakSnapshotRootNodeOwnerSideSlots,        SLOT_INVALID)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedCoreIds,       ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedGenerationIds, ID_NONE)
        array.push(engine.w02Aux.breakSnapshotRootNodeExpectedBreakSeqs,     SEQ_UNSET)
        array.push(engine.w02Aux.breakSnapshotRootNodeLiveFlags,             false)
    nodeIndex
breakSnapshotRootNodeFreeRaw(ZoneEngine engine, int nodeIndex) =>
    bool freed = false
    if nodeIndex >= 0 and nodeIndex < array.size(engine.w02Aux.breakSnapshotRootNodeLiveFlags)
        if array.get(engine.w02Aux.breakSnapshotRootNodeLiveFlags, nodeIndex)
            breakSnapshotRootNodeResetRaw(engine, nodeIndex)
            array.push(engine.w02Aux.breakSnapshotRootNodeFreeIndexes, nodeIndex)
            freed := true
    freed
rootResetSlotRaw(ZoneEngine engine, int rootSlot) =>
    array.set(engine.rootIds,               rootSlot, ID_NONE)
    array.set(engine.rootOriginKeys,        rootSlot, ID_NONE)
    array.set(engine.rootCategories,        rootSlot, int(na))
    array.set(engine.rootSubtypes,          rootSlot, int(na))
    array.set(engine.rootTfCodes,           rootSlot, int(na))
    array.set(engine.rootOriginTimes,       rootSlot, int(na))
    array.set(engine.rootOriginEndTimes,    rootSlot, int(na))
    array.set(engine.rootConfirmedTimes,    rootSlot, int(na))
    array.set(engine.rootPointPrices,       rootSlot, float(na))
    array.set(engine.rootNativeBottoms,     rootSlot, float(na))
    array.set(engine.rootNativeTops,        rootSlot, float(na))
    array.set(engine.rootIsRangeRootFlags,  rootSlot, false)
    array.set(engine.rootIsDynamicFlags,    rootSlot, false)
    array.set(engine.rootStates,            rootSlot, ROOT_CANDIDATE)
    array.set(engine.rootPairKeys,          rootSlot, ID_NONE)
    array.set(engine.rootDirections,        rootSlot, FVG_NONE)
    array.set(engine.rootFvgFreshFlags,     rootSlot, false)
    array.set(engine.rootIsBroadFvgFlags,   rootSlot, false)
    array.set(engine.rootLabelMasks,        rootSlot, 0)
    array.set(engine.rootLastUpdateSeqs,    rootSlot, SEQ_UNSET)
    array.set(engine.rootPointTicks,        rootSlot, int(na))
    array.set(engine.rootNativeBottomTicks, rootSlot, int(na))
    array.set(engine.rootNativeTopTicks,    rootSlot, int(na))
    array.set(engine.rootSlotLiveFlags,     rootSlot, false)
    array.set(engine.rootCategorySetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootTfSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootStateSetPositions,    rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgFreshSetPositions,           rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgDirectionSetPositions,       rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgBroadSetPositions,           rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgNativeBottomOrderPositions, rootSlot, SLOT_INVALID)
    array.set(engine.rootFvgNativeTopOrderPositions,    rootSlot, SLOT_INVALID)
    array.set(engine.rootParticipationHeadEdgeIndexes, rootSlot, SLOT_INVALID)
    array.set(engine.rootParticipationCounts,          rootSlot, 0)
    array.set(engine.rootPriceOrderPositions, rootSlot, SLOT_INVALID)
    array.set(engine.w02Aux.rootPruneRevisions, rootSlot, 0)
    array.set(engine.w02Aux.rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
    array.set(engine.w02Aux.rootOriginBucketNextRootSlots,   rootSlot, SLOT_INVALID)
    array.set(engine.w02Aux.rootOriginBucketExpectedRootIds, rootSlot, ID_NONE)
    array.set(engine.w03Store.rootSwingTfMasks, rootSlot, SWING_TF_MASK_NONE)
rootAllocSlotRaw(ZoneEngine engine) =>
    int rootSlot = SLOT_INVALID
    if array.size(engine.rootFreeSlots) > 0
        rootSlot := array.pop(engine.rootFreeSlots)
        rootResetSlotRaw(engine, rootSlot)
    else
        rootSlot := array.size(engine.rootIds)
        array.push(engine.rootIds,               ID_NONE)
        array.push(engine.rootOriginKeys,        ID_NONE)
        array.push(engine.rootCategories,        int(na))
        array.push(engine.rootSubtypes,          int(na))
        array.push(engine.rootTfCodes,           int(na))
        array.push(engine.rootOriginTimes,       int(na))
        array.push(engine.rootOriginEndTimes,    int(na))
        array.push(engine.rootConfirmedTimes,    int(na))
        array.push(engine.rootPointPrices,       float(na))
        array.push(engine.rootNativeBottoms,     float(na))
        array.push(engine.rootNativeTops,        float(na))
        array.push(engine.rootIsRangeRootFlags,  false)
        array.push(engine.rootIsDynamicFlags,    false)
        array.push(engine.rootStates,            ROOT_CANDIDATE)
        array.push(engine.rootPairKeys,          ID_NONE)
        array.push(engine.rootDirections,        FVG_NONE)
        array.push(engine.rootFvgFreshFlags,     false)
        array.push(engine.rootIsBroadFvgFlags,   false)
        array.push(engine.rootLabelMasks,        0)
        array.push(engine.rootLastUpdateSeqs,    SEQ_UNSET)
        array.push(engine.rootPointTicks,        int(na))
        array.push(engine.rootNativeBottomTicks, int(na))
        array.push(engine.rootNativeTopTicks,    int(na))
        array.push(engine.rootSlotLiveFlags,     false)
        array.push(engine.rootCategorySetPositions, SLOT_INVALID)
        array.push(engine.rootTfSetPositions,       SLOT_INVALID)
        array.push(engine.rootStateSetPositions,    SLOT_INVALID)
        array.push(engine.rootFvgFreshSetPositions,           SLOT_INVALID)
        array.push(engine.rootFvgStructuralStateSetPositions, SLOT_INVALID)
        array.push(engine.rootFvgDirectionSetPositions,       SLOT_INVALID)
        array.push(engine.rootFvgBroadSetPositions,           SLOT_INVALID)
        array.push(engine.rootFvgNativeBottomOrderPositions, SLOT_INVALID)
        array.push(engine.rootFvgNativeTopOrderPositions,    SLOT_INVALID)
        array.push(engine.rootParticipationHeadEdgeIndexes, SLOT_INVALID)
        array.push(engine.rootParticipationCounts,          0)
        array.push(engine.rootPriceOrderPositions, SLOT_INVALID)
        array.push(engine.w02Aux.rootPruneRevisions, 0)
        array.push(engine.w02Aux.rootOriginBucketPrevRootSlots,   SLOT_INVALID)
        array.push(engine.w02Aux.rootOriginBucketNextRootSlots,   SLOT_INVALID)
        array.push(engine.w02Aux.rootOriginBucketExpectedRootIds, ID_NONE)
        array.push(engine.w03Store.rootSwingTfMasks, SWING_TF_MASK_NONE)
    int newRootId = engine.nextRootId
    engine.nextRootId := newRootId + 1

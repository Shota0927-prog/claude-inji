// =====================================================================================
// Low level helpers
// =====================================================================================

// Owned empty int list.
newIntList() =>
    IntList.new(array.new<int>(0))

// Tick normalisation (App. A 6.2). Every equality / boundary comparison runs on ticks.
toTick(float price, float mt) =>
    int r = na
    if not na(price) and not na(mt) and mt > 0
        r := int(math.round(price / mt))
    r

popcount6(int mask) =>
    c = 0
    m = mask
    for i = 0 to 5
        if (m % 2) != 0
            c += 1
        m := int(math.floor(m / 2))
    c

bit(int index) =>
    int r = 1
    if (index) >= (1)
        for i = 1 to index
            r *= 2
    r

hasBit(int mask, int index) =>
    (int(math.floor(mask / bit(index))) % 2) != 0

// Deterministic 63 bit mix used for fast NEGATIVE matching only (I11 / I25-34).
// A hash hit is never accepted without a full tuple / root-id comparison.
mixHash(int acc, int v) =>
    math.abs((acc * 1000003 + v) % 2147483647)

// Logical-length scratch helpers: capacity is reused, never re-allocated (I17.1).
scPush(array<int> a, int len, int v) =>
    if array.size(a) <= len
        array.push(a, v)
    else
        array.set(a, len, v)
    len + 1

scPushF(array<float> a, int len, float v) =>
    if array.size(a) <= len
        array.push(a, v)
    else
        array.set(a, len, v)
    len + 1

scPushB(array<bool> a, int len, bool v) =>
    if array.size(a) <= len
        array.push(a, v)
    else
        array.set(a, len, v)
    len + 1

// Grow a per-slot array so that index `slot` exists.
ensureI(array<int> a, int slot, int fill) =>
    while array.size(a) <= slot
        array.push(a, fill)

ensureF(array<float> a, int slot, float fill) =>
    while array.size(a) <= slot
        array.push(a, fill)

ensureB(array<bool> a, int slot, bool fill) =>
    while array.size(a) <= slot
        array.push(a, fill)

ensureL(array<IntList> a, int slot) =>
    while array.size(a) <= slot
        array.push(a, newIntList())

// =====================================================================================
// Factories
// =====================================================================================

export newCfg() =>
    ZoneCfg.new()

export newFeed() =>
    Feed.new(swTf = array.new<int>(0), swIsHigh = array.new<int>(0), swPrice = array.new<float>(0), swOriginTime = array.new<int>(0), swOriginEndTime = array.new<int>(0), swConfirmedTime = array.new<int>(0), acTf = array.new<int>(0), acTop = array.new<float>(0), acBottom = array.new<float>(0), acCandidateStart = array.new<int>(0), acConfirmedTime = array.new<int>(0), fvTf = array.new<int>(0), fvDirection = array.new<int>(0), fvNativeBottom = array.new<float>(0), fvNativeTop = array.new<float>(0), fvOriginTime = array.new<int>(0), fvConfirmedTime = array.new<int>(0), srcTf = array.new<int>(0), srcClose = array.new<float>(0), srcHigh = array.new<float>(0), srcLow = array.new<float>(0), srcOpenTime = array.new<int>(0), srcCloseTime = array.new<int>(0))

// Clear the per-bar event payload arrays of a Feed without reallocating them.
export resetFeedEvents(Feed feed) =>
    array.clear(feed.swTf)
    array.clear(feed.swIsHigh)
    array.clear(feed.swPrice)
    array.clear(feed.swOriginTime)
    array.clear(feed.swOriginEndTime)
    array.clear(feed.swConfirmedTime)
    array.clear(feed.acTf)
    array.clear(feed.acTop)
    array.clear(feed.acBottom)
    array.clear(feed.acCandidateStart)
    array.clear(feed.acConfirmedTime)
    array.clear(feed.fvTf)
    array.clear(feed.fvDirection)
    array.clear(feed.fvNativeBottom)
    array.clear(feed.fvNativeTop)
    array.clear(feed.fvOriginTime)
    array.clear(feed.fvConfirmedTime)
    array.clear(feed.srcTf)
    array.clear(feed.srcClose)
    array.clear(feed.srcHigh)
    array.clear(feed.srcLow)
    array.clear(feed.srcOpenTime)
    array.clear(feed.srcCloseTime)
    feed

export pushSwing(Feed feed, int tfCode, bool isHigh, float price, int originTime, int originEndTime, int confirmedTime) =>
    if not na(price)
        array.push(feed.swTf, tfCode)
        array.push(feed.swIsHigh, isHigh ? 1 : 0)
        array.push(feed.swPrice, price)
        array.push(feed.swOriginTime, originTime)
        array.push(feed.swOriginEndTime, originEndTime)
        array.push(feed.swConfirmedTime, confirmedTime)
    feed

export pushAccumBox(Feed feed, int tfCode, float boxTop, float boxBottom, int candidateStart, int confirmedTime) =>
    if not na(boxTop) and not na(boxBottom)
        array.push(feed.acTf, tfCode)
        array.push(feed.acTop, boxTop)
        array.push(feed.acBottom, boxBottom)
        array.push(feed.acCandidateStart, candidateStart)
        array.push(feed.acConfirmedTime, confirmedTime)
    feed

export pushFvg(Feed feed, int tfCode, int direction, float nativeBottom, float nativeTop, int originTime, int confirmedTime) =>
    if not na(nativeBottom) and not na(nativeTop) and direction != 0
        array.push(feed.fvTf, tfCode)
        array.push(feed.fvDirection, direction)
        array.push(feed.fvNativeBottom, nativeBottom)
        array.push(feed.fvNativeTop, nativeTop)
        array.push(feed.fvOriginTime, originTime)
        array.push(feed.fvConfirmedTime, confirmedTime)
    feed

export pushSourceClose(Feed feed, int tfCode, float srcClose, float srcHigh, float srcLow, int srcOpenTime, int srcCloseTime) =>
    if not na(srcClose)
        array.push(feed.srcTf, tfCode)
        array.push(feed.srcClose, srcClose)
        array.push(feed.srcHigh, srcHigh)
        array.push(feed.srcLow, srcLow)
        array.push(feed.srcOpenTime, srcOpenTime)
        array.push(feed.srcCloseTime, srcCloseTime)
    feed


//@version=6
// =============================================================================
//  ZoneEngineV2_Rebuild
//  Zone definition spec v2 (Zone_definition_spec_v2.md) - logic unchanged.
//  Rebuilt data structures / evaluation order for runtime + memory economy.
//
//  Build ID .......... ZEV2R-20260919-001
//  Base timeframe .... confirmed 5m bar, engine updates exactly once per bar
//  Logic contract .... spec v2 sections 1-21 + instruction appendix A
//
//  Layering (instruction M3). Do not reorder State/Candidate execution:
//    Source/Feed      -> helper packs evaluated in their own request context
//    Root registry    -> id/slot split, origin + category indices
//    Candidate eval   -> per-side dense/normal/FVG candidates, numeric only
//    Core association -> identity / merge / split / pending topology
//    State transition -> touch / weak / break / flip / reclaim / inverse
//    Read API         -> views + events, read-only projections
//    Presentation     -> harness only, never feeds back into logic
// =============================================================================
library("ZoneEngineV2_Rebuild", overlay = true)

// -----------------------------------------------------------------------------
// 0. Build identity
// -----------------------------------------------------------------------------
export buildId() =>
    "ZEV2R-20260919-001"

// -----------------------------------------------------------------------------
// 1. Constants (int codes only; strings are produced at presentation time)
// -----------------------------------------------------------------------------
// Category
var int CAT_MA      = 0
var int CAT_SWING   = 1
var int CAT_ACCUM   = 2
var int CAT_TIME_HL = 3
var int CAT_FVG     = 4
var int CAT_PSYCH   = 5
var int CAT_COUNT   = 6

// Side
var int SIDE_SUPPORT    = 1
var int SIDE_RESISTANCE = -1
var int SIDE_NONE       = 0

// Phase
var int PH_WAITING      = 0
var int PH_ARMED        = 1
var int PH_ACTIVE_TOUCH = 2
var int PH_BROKEN       = 3
var int PH_FLIP_WAIT    = 4
var int PH_DORMANT      = 5

// Grade
var int GR_STRONG      = 0
var int GR_NEUTRAL     = 1
var int GR_WEAK        = 2
var int GR_UNAVAILABLE = 3

// Density
var int DEN_HIGH          = 0
var int DEN_NORMAL        = 1
var int DEN_BROAD_CONTEXT = 2

// Root state
var int ROOT_CANDIDATE      = 0
var int ROOT_ACTIVE         = 1
var int ROOT_INVALIDATED    = 2
var int ROOT_INVERSE_WAIT   = 3
var int ROOT_INVERSE_ACTIVE = 4
var int ROOT_RETIRED        = 5

// FVG direction
var int FVG_NONE    = 0
var int FVG_BULLISH = 1
var int FVG_BEARISH = 2

// Weak reason
var int WEAK_NONE     = 0
var int WEAK_BY_TOUCH = 1
var int WEAK_BY_DEPTH = 2
var int WEAK_BY_BOTH  = 3

// Event type
var int EV_TOUCH_START      = 0
var int EV_TOUCH_RESET      = 1
var int EV_WEAK_DEPTH       = 2
var int EV_LOCAL_BREAK      = 3
var int EV_GAP_BREAK        = 4
var int EV_FLIP_ATTEMPT     = 5
var int EV_FLIP_CONFIRM     = 6
var int EV_RECLAIM          = 7
var int EV_FVG_INVALIDATE   = 8
var int EV_INVERSE_ATTEMPT  = 9
var int EV_INVERSE_CONFIRM  = 10
var int EV_GENERATION_START = 11
var int EV_MERGE            = 12
var int EV_SPLIT            = 13
var int EV_STORAGE_PRUNE    = 14

// Timeframe codes (minutes; daily = 1440). tfRank uses the same ordering.
var int TF_1M  = 1
var int TF_5M  = 5
var int TF_15M = 15
var int TF_1H  = 60
var int TF_4H  = 240
var int TF_D   = 1440

// Subtypes
var int SUB_EMA2000      = 0
var int SUB_EMA3000      = 1
var int SUB_SWING_HIGH   = 2
var int SUB_SWING_LOW    = 3
var int SUB_ACCUM_UPPER  = 4
var int SUB_ACCUM_LOWER  = 5
var int SUB_PSYCH_MAJOR  = 6
var int SUB_PSYCH_STD    = 7
var int SUB_FVG          = 8
var int SUB_TIME_HIGH    = 9
var int SUB_TIME_LOW     = 10

// Time high/low period labels (bit mask; one root can carry several labels)
var int LBL_CUR_SESSION  = 1
var int LBL_LAST_SESSION = 2
var int LBL_TODAY        = 4
var int LBL_PREV_DAY     = 8
var int LBL_CUR_WEEK     = 16
var int LBL_PREV_WEEK    = 32

// Swing detection timeframe mask (same-event merge keeps every detecting TF)
var int SWM_5M  = 1
var int SWM_15M = 2
var int SWM_1H  = 4

var int MS_DAY  = 86400000
var int MS_HOUR = 3600000

// Internal fixed capacities for scratch structures (not logical storage limits;
// exceeding them routes to the exact recomputation path, never to empty results)
var int SCRATCH_MAX_ROOTS = 512
var int MAX_PSYCH_ROOTS   = 64

// -----------------------------------------------------------------------------
// 2. Name conversion (presentation only) and code accessors for the harness
// -----------------------------------------------------------------------------
export categoryName(int c) =>
    switch c
        0 => "MA"
        1 => "Swing"
        2 => "Accum"
        3 => "TimeHL"
        4 => "FVG"
        5 => "Psych"
        => "?"

export sideName(int s) =>
    s == 1 ? "Support" : s == -1 ? "Resistance" : "None"

export phaseName(int p) =>
    switch p
        0 => "Waiting"
        1 => "Armed"
        2 => "ActiveTouch"
        3 => "Broken"
        4 => "FlipWait"
        5 => "Dormant"
        => "?"

export gradeName(int g) =>
    switch g
        0 => "Strong"
        1 => "Neutral"
        2 => "Weak"
        3 => "Unavailable"
        => "?"

export densityName(int d) =>
    switch d
        0 => "High"
        1 => "Normal"
        2 => "BroadContext"
        => "?"

export weakReasonName(int w) =>
    switch w
        0 => "None"
        1 => "WeakByTouch"
        2 => "WeakByDepth"
        3 => "WeakByBoth"
        => "?"

export rootStateName(int s) =>
    switch s
        0 => "Candidate"
        1 => "Active"
        2 => "Invalidated"
        3 => "InverseWait"
        4 => "InverseActive"
        5 => "Retired"
        => "?"

export fvgDirName(int d) =>
    d == 1 ? "Bullish" : d == 2 ? "Bearish" : "None"

export eventName(int e) =>
    switch e
        0  => "TouchStart"
        1  => "TouchReset"
        2  => "WeakDepth"
        3  => "LocalBreak"
        4  => "GapBreak"
        5  => "FlipAttempt"
        6  => "FlipConfirm"
        7  => "Reclaim"
        8  => "FvgInvalidate"
        9  => "InverseAttempt"
        10 => "InverseConfirm"
        11 => "GenerationStart"
        12 => "Merge"
        13 => "Split"
        14 => "StoragePrune"
        => "?"

export tfName(int tf) =>
    switch tf
        1    => "1m"
        5    => "5m"
        15   => "15m"
        60   => "1H"
        240  => "4H"
        1440 => "1D"
        => str.tostring(tf) + "m"

// Code accessors: the harness must never hardcode the numeric codes.
export codeSideSupport()    => 1
export codeSideResistance() => -1
export codeGradeStrong()    => 0
export codeGradeNeutral()   => 1
export codeGradeWeak()      => 2
export codeGradeUnavail()   => 3
export codePhaseWaiting()   => 0
export codePhaseArmed()     => 1
export codePhaseActive()    => 2
export codePhaseBroken()    => 3
export codePhaseFlipWait()  => 4
export codePhaseDormant()   => 5
export codeDensityHigh()    => 0
export codeDensityNormal()  => 1
export codeDensityBroad()   => 2
export codeCatCount()       => 6


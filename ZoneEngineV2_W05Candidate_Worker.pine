                ok := rightSlot >= 0 and rightSlot < array.size(ctx.rootPointTicks) and not na(array.get(ctx.rootPointTicks, rightSlot)) and wMinRootId != ID_NONE and not na(wMaxConfirmedTime)
                int baseBottom = leftTick
                int baseTop    = ok ? array.get(ctx.rootPointTicks, rightSlot) : int(na)
                if ok
                    ok := baseTop - baseBottom <= mTick
                [loLevel, hiLevel, hasLevels] = candPsychLevelBoundsRaw(ctx, baseBottom, baseTop, mTick, mintick)
                bool psychPhase    = false
                bool variantsDone  = false
                int  level         = loLevel
                int  lastPsychTick = int(na)
                while ok and not variantsDone
                    bool pp        = psychPhase
                    int  pt        = int(na)
                    bool runVariant = true
                    if pp
                        if not hasLevels or level > hiLevel
                            variantsDone := true
                            runVariant   := false
                        else
                            pt := int(math.round((level * 50.0) / mintick))
                            runVariant := (na(lastPsychTick) or pt != lastPsychTick) and math.max(baseTop, pt) - math.min(baseBottom, pt) <= mTick
                            lastPsychTick := pt
                            level += 1
                    else
                        psychPhase := true
                    if runVariant
                        int localBottom = pp ? math.min(baseBottom, pt) : baseBottom
                        int localTop    = pp ? math.max(baseTop,    pt) : baseTop
                        int vCategory   = pp ? wCategoryMask + CAT_MASK_PSYCH : wCategoryMask
                        int vHigh       = wHighMask
                        [pOk, pCategory, pHigh, pC, pH, pDensity, pStrong] = candQualityFinishRaw(ctx, side, CAND_STAGE_C, localBottom, localTop, denseTick, mTick, wMa, wEma2000, wEma3000, vCategory, vHigh, false)
                        if pOk and (pDensity == DEN_HIGH or pDensity == DEN_NORMAL)
                            ok := candOfferRaw(ctx, mintick, side, CAND_STAGE_C, left, j, localBottom, localTop, pC, pH, pDensity, pStrong, wMaxConfirmedTime, wMinRootId, CAND_FVG_RANGE_NONE, SLOT_INVALID, pCategory, pHigh, pt, SLOT_INVALID)
                        int k = 0
                        while ok and k < fvgN
                            int f = array.get(fvgScratch, k)
                            ok := f >= 0 and f < array.size(ctx.rootIds) and f < array.size(ctx.rootIsBroadFvgFlags) and f < array.size(ctx.rootConfirmedTimes)
                            bool fBroad = false
                            int  fConf  = int(na)
                            int  fId    = ID_NONE
                            if ok
                                fBroad := array.get(ctx.rootIsBroadFvgFlags, f)
                                fConf  := array.get(ctx.rootConfirmedTimes, f)
                                fId    := array.get(ctx.rootIds, f)
                                ok := not na(fConf) and fId != ID_NONE
                            int a = 0
                            while ok and a < 2
                                bool gOk  = false
                                int  gBottom = int(na)
                                int  gTop    = int(na)
                                int  mode    = CAND_FVG_RANGE_NONE
                                bool broadLocalized = false
                                if not fBroad
                                    mode := a == 0 ? CAND_FVG_RANGE_INSIDE : CAND_FVG_RANGE_PROXIMAL
                                    [rOk, rBottom, rTop] = candFvgRangeRaw(ctx, side, mode, f, SLOT_INVALID, true, localBottom, localTop, denseTick)
                                    gOk     := rOk
                                    gBottom := rBottom
                                    gTop    := rTop
                                else if a == 0
                                    mode := CAND_FVG_RANGE_PROXIMAL
                                    [lOk, lLoc, lBottom, lTop] = candBroadLocalizationRaw(ctx, side, CAND_STAGE_C, CAND_BROAD_LOCAL_C1, f, SLOT_INVALID, true, baseBottom, baseTop, pp, pt, wMa, wEma2000, wEma3000, wCategoryMask, wHighMask, denseTick, mTick)
                                    ok             := lOk
                                    gOk            := lOk and lLoc
                                    gBottom        := lBottom
                                    gTop           := lTop
                                    broadLocalized := true
                                else
                                    mode := CAND_FVG_RANGE_INSIDE
                                    [c3Ok, c3Loc, c3Bottom, c3Top] = candBroadLocalizationRaw(ctx, side, CAND_STAGE_C, CAND_BROAD_LOCAL_C3, f, SLOT_INVALID, true, baseBottom, baseTop, pp, pt, wMa, wEma2000, wEma3000, wCategoryMask, wHighMask, denseTick, mTick)
                                    [c4Ok, c4Loc, c4Bottom, c4Top] = candBroadLocalizationRaw(ctx, side, CAND_STAGE_C, CAND_BROAD_LOCAL_C4, f, SLOT_INVALID, true, baseBottom, baseTop, pp, pt, wMa, wEma2000, wEma3000, wCategoryMask, wHighMask, denseTick, mTick)
                                    ok := c3Ok and c4Ok
                                    if ok and c3Loc and c4Loc
                                        ok := c3Bottom == c4Bottom and c3Top == c4Top
                                    gOk            := ok and (c3Loc or c4Loc)
                                    gBottom        := c3Loc ? c3Bottom : c4Bottom
                                    gTop           := c3Loc ? c3Top : c4Top
                                    broadLocalized := true
                                if ok and gOk
                                    [hOk, hHigh] = candFvgHighRaw(ctx, side, f, SLOT_INVALID, broadLocalized)
                                    ok := hOk
                                    if ok
                                        int fCategory = vCategory + CAT_MASK_FVG
                                        int fHigh     = vHigh + (hHigh ? CAT_MASK_FVG : 0)
                                        [qOk, qCategory, qHigh, qC, qH, qDensity, qStrong] = candQualityFinishRaw(ctx, side, CAND_STAGE_C, gBottom, gTop, denseTick, mTick, wMa, wEma2000, wEma3000, fCategory, fHigh, false)
                                        if qOk and (qDensity == DEN_HIGH or qDensity == DEN_NORMAL)
                                            int vCreated = math.max(wMaxConfirmedTime, fConf)
                                            int vMinId   = math.min(wMinRootId, fId)
                                            ok := candOfferRaw(ctx, mintick, side, CAND_STAGE_C, left, j, gBottom, gTop, qC, qH, qDensity, qStrong, vCreated, vMinId, mode, f, qCategory, qHigh, pt, SLOT_INVALID)
                                a += 1
                            k += 1
            j += 1
        left += 1
    int fi = 0
    while ok and fi < fvgN
        int fa = array.get(fvgScratch, fi)
        ok := fa >= 0 and fa < array.size(ctx.rootIds) and fa < array.size(ctx.rootIsBroadFvgFlags) and fa < array.size(ctx.rootConfirmedTimes)
        bool faBroad = false
        int  faConf  = int(na)
        int  faId    = ID_NONE
        if ok
            faBroad := array.get(ctx.rootIsBroadFvgFlags, fa)
            faConf  := array.get(ctx.rootConfirmedTimes, fa)
            faId    := array.get(ctx.rootIds, fa)
            ok := not na(faConf) and faId != ID_NONE
        int fj = fi
        while ok and fj < fvgN
            int  fb        = fj == fi ? SLOT_INVALID : array.get(fvgScratch, fj)
            bool zBaseOk   = false
            int  zBottom   = int(na)
            int  zTop      = int(na)
            int  zMode     = CAND_FVG_RANGE_NONE
            bool zLocal    = false
            int  zCreated  = faConf
            if fb == SLOT_INVALID
                if not faBroad
                    zMode := CAND_FVG_RANGE_STANDALONE
                    [sOk, sBottom, sTop] = candFvgRangeRaw(ctx, side, CAND_FVG_RANGE_STANDALONE, fa, SLOT_INVALID, false, int(na), int(na), denseTick)
                    zBaseOk := sOk
                    zBottom := sBottom
                    zTop    := sTop
            else
                ok := fb >= 0 and fb < array.size(ctx.rootIds) and fb < array.size(ctx.rootIsBroadFvgFlags) and fb < array.size(ctx.rootConfirmedTimes)
                bool fbBroad = false
                if ok
                    fbBroad := array.get(ctx.rootIsBroadFvgFlags, fb)
                    int fbConf = array.get(ctx.rootConfirmedTimes, fb)
                    ok := not na(fbConf) and array.get(ctx.rootIds, fb) > faId
                    zCreated := ok ? math.max(faConf, fbConf) : zCreated
                if ok
                    zMode := CAND_FVG_RANGE_OVERLAP
                    if not faBroad and not fbBroad
                        [oOk, oBottom, oTop] = candFvgRangeRaw(ctx, side, CAND_FVG_RANGE_OVERLAP, fa, fb, false, int(na), int(na), denseTick)
                        zBaseOk := oOk
                        zBottom := oBottom
                        zTop    := oTop
                    else
                        int broadSlot = faBroad ? fa : fb
                        int peerSlot  = faBroad ? fb : fa
                        [c2Ok, c2Loc, c2Bottom, c2Top] = candBroadLocalizationRaw(ctx, side, CAND_STAGE_C, CAND_BROAD_LOCAL_C2, broadSlot, peerSlot, false, int(na), int(na), false, int(na), 0, 0, 0, CAT_MASK_NONE, CAT_MASK_NONE, denseTick, mTick)
                        ok      := c2Ok
                        zBaseOk := c2Ok and c2Loc
                        zBottom := c2Bottom
                        zTop    := c2Top
                        zLocal  := true
            if ok and zBaseOk
                [zhOk, zhHigh] = candFvgHighRaw(ctx, side, fa, fb, zLocal)
                ok := zhOk
                int zBaseHigh = zhHigh ? CAT_MASK_FVG : CAT_MASK_NONE
                [zLo, zHi, zHas] = candPsychLevelBoundsRaw(ctx, zBottom, zTop, mTick, mintick)
                bool zPsychPhase   = false
                bool zVariantsDone = false
                int  zLevel        = zLo
                int  zLastTick     = int(na)
                while ok and not zVariantsDone
                    bool zp    = zPsychPhase
                    int  zt    = int(na)
                    bool zRun  = true
                    if zp
                        if not zHas or zLevel > zHi
                            zVariantsDone := true
                            zRun          := false
                        else
                            zt := int(math.round((zLevel * 50.0) / mintick))
                            zRun := (na(zLastTick) or zt != zLastTick) and math.max(zTop, zt) - math.min(zBottom, zt) <= mTick
                            zLastTick := zt
                            zLevel += 1
                    else
                        zPsychPhase := true
                    if zRun
                        int zvBottom   = zp ? math.min(zBottom, zt) : zBottom
                        int zvTop      = zp ? math.max(zTop,    zt) : zTop
                        int zvCategory = zp ? CAT_MASK_FVG + CAT_MASK_PSYCH : CAT_MASK_FVG
                        [zqOk, zqCategory, zqHigh, zqC, zqH, zqDensity, zqStrong] = candQualityFinishRaw(ctx, side, CAND_STAGE_C, zvBottom, zvTop, denseTick, mTick, 0, 0, 0, zvCategory, zBaseHigh, false)
                        if zqOk and (zqDensity == DEN_HIGH or zqDensity == DEN_NORMAL)
                            ok := candOfferRaw(ctx, mintick, side, CAND_STAGE_C, SLOT_INVALID, SLOT_INVALID, zvBottom, zvTop, zqC, zqH, zqDensity, zqStrong, zCreated, faId, zMode, fa, zqCategory, zqHigh, zt, fb)
            fj += 1
        fi += 1
    ok
candReferencePriceRaw(CandidateCtx ctx, float mintick, int side, int fvgMode, int effectiveBottomTick, int effectiveTopTick, int psychLevelTick, int rootIdOffset, int rootIdLength) =>
    array<int>   ids  = ctx.candidateWinnerRootIds
    array<float> vals = ctx.candidateWinnerRefValueScratch
    array<float> reps = ctx.candidateWinnerRefRepScratch
    bool psychPresent = not na(psychLevelTick)
    bool ok = (side == SIDE_SUPPORT or side == SIDE_RESISTANCE) and not na(mintick) and mintick > 0 and not na(effectiveBottomTick) and not na(effectiveTopTick) and effectiveBottomTick <= effectiveTopTick and fvgMode >= CAND_FVG_RANGE_NONE and fvgMode <= CAND_FVG_RANGE_BROAD_CONTEXT and not na(rootIdOffset) and not na(rootIdLength) and rootIdOffset >= 0 and rootIdLength >= 1 and rootIdOffset + rootIdLength <= array.size(ids)
    int   fvgCount     = 0
    int   fvgSlotA     = SLOT_INVALID
    int   fvgSlotB     = SLOT_INVALID
    int   ema2000Count = 0
    int   ema3000Count = 0
    float ema2000Price = na
    float ema3000Price = na
    int   ema2000Id    = ID_NONE
    int   ema3000Id    = ID_NONE
    int i = 0
    while ok and i < rootIdLength
        int id = array.get(ids, rootIdOffset + i)
        ok := not na(id) and id != ID_NONE and map.contains(ctx.rootIdToSlot, id)
        int d = 0
        while ok and d < i
            ok := array.get(ids, rootIdOffset + d) != id
            d += 1
        int s = ok ? map.get(ctx.rootIdToSlot, id) : SLOT_INVALID
        if ok
            ok := s >= 0 and s < array.size(ctx.rootIds) and s < array.size(ctx.rootSlotLiveFlags) and s < array.size(ctx.rootCategories) and s < array.size(ctx.rootSubtypes) and s < array.size(ctx.rootPointPrices) and s < array.size(ctx.rootNativeBottoms) and s < array.size(ctx.rootNativeTops) and s < array.size(ctx.rootIsBroadFvgFlags) and s < array.size(ctx.rootDirections)
        if ok
            ok := array.get(ctx.rootSlotLiveFlags, s) and array.get(ctx.rootIds, s) == id
        if ok
            int category = array.get(ctx.rootCategories, s)
            if category == CAT_FVG
                float nb = array.get(ctx.rootNativeBottoms, s)
                float nt = array.get(ctx.rootNativeTops, s)
                ok := not na(nb) and not na(nt) and nb <= nt
                if ok
                    fvgCount += 1
                    if fvgCount == 1
                        fvgSlotA := s
                    else if fvgCount == 2
                        fvgSlotB := s
            else if category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL
                float price = array.get(ctx.rootPointPrices, s)
                ok := not na(price)
                if ok and category == CAT_MA
                    int subtype = array.get(ctx.rootSubtypes, s)
                    if subtype == SUB_MA_EMA2000
                        ema2000Count += 1
                        ema2000Price := price
                        ema2000Id    := id
                    else if subtype == SUB_MA_EMA3000
                        ema3000Count += 1
                        ema3000Price := price
                        ema3000Id    := id
                    else
                        ok := false
            else
                ok := false
        i += 1
    if ok
        ok := ema2000Count <= 1 and ema3000Count <= 1
    int repLen = 0
    int c = 0
    while ok and c < 4
        float rep = na
        if c < 3
            int wanted = c == 0 ? CAT_SWING : c == 1 ? CAT_ACCUM : CAT_TIME_HL
            int valLen = 0
            int k = 0
            while k < rootIdLength
                int s = map.get(ctx.rootIdToSlot, array.get(ids, rootIdOffset + k))
                if array.get(ctx.rootCategories, s) == wanted
                    float price = array.get(ctx.rootPointPrices, s)
                    if valLen == array.size(vals)
                        array.push(vals, price)
                    int  pos    = valLen
                    bool moving = true
                    while moving and pos > 0
                        float prev = array.get(vals, pos - 1)
                        if price < prev
                            array.set(vals, pos, prev)
                            pos -= 1
                        else
                            moving := false
                    array.set(vals, pos, price)
                    valLen += 1
                k += 1
            ctx.candidateWinnerRefValueLength := valLen
            if valLen > 0
                rep := valLen % 2 == 1 ? array.get(vals, int((valLen - 1) / 2)) : (array.get(vals, int(valLen / 2) - 1) + array.get(vals, int(valLen / 2))) / 2.0
        else if psychPresent
            rep := float(psychLevelTick) * mintick
        if not na(rep)
            if repLen == array.size(reps)
                array.push(reps, rep)
            int  pos    = repLen
            bool moving = true
            while moving and pos > 0
                float prev = array.get(reps, pos - 1)
                if rep < prev
                    array.set(reps, pos, prev)
                    pos -= 1
                else
                    moving := false
            array.set(reps, pos, rep)
            repLen += 1
        c += 1
    int otherLen = repLen
    float maRep = na
    if ok
        if ema2000Count == 1 and ema3000Count == 1
            if otherLen > 0
                float target = otherLen % 2 == 1 ? array.get(reps, int((otherLen - 1) / 2)) : (array.get(reps, int(otherLen / 2) - 1) + array.get(reps, int(otherLen / 2))) / 2.0
                float d2000  = math.abs(ema2000Price - target)
                float d3000  = math.abs(ema3000Price - target)
                maRep := d2000 < d3000 ? ema2000Price : d3000 < d2000 ? ema3000Price : (ema2000Id < ema3000Id ? ema2000Price : ema3000Price)
            else
                maRep := (ema2000Price + ema3000Price) / 2.0
        else if ema2000Count == 1
            maRep := ema2000Price
        else if ema3000Count == 1
            maRep := ema3000Price
    float fvgRep = na
    if ok
        if fvgMode == CAND_FVG_RANGE_NONE
            ok := fvgCount == 0
        else if fvgMode == CAND_FVG_RANGE_INSIDE
            ok := fvgCount == 1 and (otherLen > 0 or not na(maRep))
        else if fvgMode == CAND_FVG_RANGE_PROXIMAL or fvgMode == CAND_FVG_RANGE_STANDALONE or fvgMode == CAND_FVG_RANGE_BROAD_CONTEXT
            ok := fvgCount == 1
            if ok and fvgMode == CAND_FVG_RANGE_BROAD_CONTEXT
                ok := rootIdLength == 1 and array.get(ctx.rootIsBroadFvgFlags, fvgSlotA) and not psychPresent
            if ok
                fvgRep := side == SIDE_SUPPORT ? array.get(ctx.rootNativeTops, fvgSlotA) : array.get(ctx.rootNativeBottoms, fvgSlotA)
        else
            ok := fvgCount == 2
            if ok
                ok := array.get(ctx.rootDirections, fvgSlotA) == array.get(ctx.rootDirections, fvgSlotB)
            if ok
                float ob = math.max(array.get(ctx.rootNativeBottoms, fvgSlotA), array.get(ctx.rootNativeBottoms, fvgSlotB))
                float ot = math.min(array.get(ctx.rootNativeTops,    fvgSlotA), array.get(ctx.rootNativeTops,    fvgSlotB))
                ok := ob <= ot
                if ok
                    fvgRep := side == SIDE_SUPPORT ? ot : ob
    float refPrice = na
    if ok
        int e = 0
        while e < 2
            float rep = e == 0 ? maRep : fvgRep
            if not na(rep)
                if repLen == array.size(reps)
                    array.push(reps, rep)
                int  pos    = repLen
                bool moving = true
                while moving and pos > 0
                    float prev = array.get(reps, pos - 1)
                    if rep < prev
                        array.set(reps, pos, prev)
                        pos -= 1
                    else
                        moving := false
                array.set(reps, pos, rep)
                repLen += 1
            e += 1
        ok := repLen > 0
        if ok
            refPrice := repLen % 2 == 1 ? array.get(reps, int((repLen - 1) / 2)) : (array.get(reps, int(repLen / 2) - 1) + array.get(reps, int(repLen / 2))) / 2.0
    ctx.candidateWinnerRefRepLength := repLen
    [ok, ok ? refPrice : float(na)]
candMaterializeWinnerRaw(CandidateCtx ctx, float mintick, int side, int stage, int leftIndex, int rightIndex, int effectiveBottomTick, int effectiveTopTick, int cCount, int hCount, int density, bool baseStrong, int createdTime, int minRootId, int fvgMode, int fvgRootSlot, int categoryMask, int highMask) =>
    [cOk, completionCount, psychLevelTick, fvgRootSlot2] = candCompletionCountRaw(ctx, mintick, side, stage, leftIndex, rightIndex, effectiveBottomTick, effectiveTopTick, cCount, hCount, density, baseStrong, createdTime, minRootId, fvgMode, fvgRootSlot, categoryMask, highMask)
    bool ok = cOk and completionCount == 1
    if ok
        bool psychBit   = categoryMask % (2 * CAT_MASK_PSYCH) >= CAT_MASK_PSYCH
        bool psychFound = not na(psychLevelTick)
        ok := psychBit == psychFound
    if ok
        ok := fvgMode == CAND_FVG_RANGE_NONE ? (fvgRootSlot == SLOT_INVALID and fvgRootSlot2 == SLOT_INVALID) : fvgMode == CAND_FVG_RANGE_OVERLAP ? (fvgRootSlot != SLOT_INVALID and fvgRootSlot2 != SLOT_INVALID) : (fvgRootSlot != SLOT_INVALID and fvgRootSlot2 == SLOT_INVALID)
    int recordIndex = ctx.candidateWinnerLogicalCount
    int rootStart   = ctx.candidateWinnerRootIdLength
    int recordSize  = array.size(ctx.candidateWinnerSides)
    array<int> ids  = ctx.candidateWinnerRootIds
    if ok
        ok := array.size(ctx.candidateWinnerStages) == recordSize and array.size(ctx.candidateWinnerEffectiveBottomTicks) == recordSize and array.size(ctx.candidateWinnerEffectiveTopTicks) == recordSize and array.size(ctx.candidateWinnerCCounts) == recordSize and array.size(ctx.candidateWinnerHCounts) == recordSize and array.size(ctx.candidateWinnerDensities) == recordSize and array.size(ctx.candidateWinnerBaseStrongFlags) == recordSize and array.size(ctx.candidateWinnerCategoryMasks) == recordSize and array.size(ctx.candidateWinnerHighMasks) == recordSize and array.size(ctx.candidateWinnerCreatedTimes) == recordSize and array.size(ctx.candidateWinnerMinRootIds) == recordSize and array.size(ctx.candidateWinnerFvgModes) == recordSize and array.size(ctx.candidateWinnerPsychLevelTicks) == recordSize and array.size(ctx.candidateWinnerReferencePrices) == recordSize and array.size(ctx.candidateWinnerRootIdOffsets) == recordSize and array.size(ctx.candidateWinnerRootIdLengths) == recordSize
    if ok
        ok := recordIndex >= 0 and recordIndex <= recordSize and rootStart >= 0 and rootStart <= array.size(ids)
    int  rootCount  = 0
    int  maxCreated = int(na)
    int  minId      = ID_NONE
    bool isSupport  = side == SIDE_SUPPORT
    array<int> scratch = isSupport ? ctx.candidateScratchSupportNewRootSlots : ctx.candidateScratchResistanceNewRootSlots
    int  scratchLength = isSupport ? ctx.candidateScratchSupportNewLength : ctx.candidateScratchResistanceNewLength
    bool noPoint = leftIndex == SLOT_INVALID and rightIndex == SLOT_INVALID
    if ok and not noPoint
        ok := leftIndex >= 0 and rightIndex >= leftIndex and rightIndex < scratchLength and rightIndex < array.size(scratch)
    int nPoint  = ok and not noPoint ? rightIndex - leftIndex + 1 : 0
    int nMember = nPoint + 2
    int m = 0
    while ok and m < nMember
        bool isPoint = m < nPoint
        int  slot    = fvgRootSlot2
        if isPoint
            slot := array.get(scratch, leftIndex + m)
        else if m == nPoint
            slot := fvgRootSlot
        if slot != SLOT_INVALID or isPoint
            ok := slot >= 0 and slot < array.size(ctx.rootIds) and slot < array.size(ctx.rootSlotLiveFlags) and slot < array.size(ctx.rootCategories) and slot < array.size(ctx.rootConfirmedTimes)
            int id = ID_NONE
            if ok
                int category = array.get(ctx.rootCategories, slot)
                id := array.get(ctx.rootIds, slot)
                ok := array.get(ctx.rootSlotLiveFlags, slot) and not na(id) and id != ID_NONE and not na(array.get(ctx.rootConfirmedTimes, slot)) and (isPoint ? (category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL) : category == CAT_FVG)
            int d = 0
            while ok and d < rootCount
                ok := array.get(ids, rootStart + d) != id
                d += 1
            if ok
                int at = rootStart + rootCount
                if at == array.size(ids)
                    array.push(ids, id)
                else
                    array.set(ids, at, id)
                rootCount += 1
                int conf = array.get(ctx.rootConfirmedTimes, slot)
                maxCreated := na(maxCreated) ? conf : math.max(maxCreated, conf)
                minId      := minId == ID_NONE ? id : math.min(minId, id)
        m += 1
    if ok
        ok := rootCount >= 1 and maxCreated == createdTime and minId == minRootId
    if ok
        int x = 1
        while x < rootCount
            int  v      = array.get(ids, rootStart + x)
            int  pos    = x
            bool moving = true
            while moving and pos > 0
                int prev = array.get(ids, rootStart + pos - 1)
                if v < prev
                    array.set(ids, rootStart + pos, prev)
                    pos -= 1
                else
                    moving := false
            array.set(ids, rootStart + pos, v)
            x += 1
    float referencePrice = na
    if ok
        [pOk, pPrice] = candReferencePriceRaw(ctx, mintick, side, fvgMode, effectiveBottomTick, effectiveTopTick, psychLevelTick, rootStart, rootCount)
        ok             := pOk
        referencePrice := pPrice
    if ok
        bool grow = recordIndex == recordSize
        if grow
            array.push(ctx.candidateWinnerSides,                side)
            array.push(ctx.candidateWinnerStages,               stage)
            array.push(ctx.candidateWinnerEffectiveBottomTicks, effectiveBottomTick)
            array.push(ctx.candidateWinnerEffectiveTopTicks,    effectiveTopTick)
            array.push(ctx.candidateWinnerCCounts,              cCount)
            array.push(ctx.candidateWinnerHCounts,              hCount)
            array.push(ctx.candidateWinnerDensities,            density)
            array.push(ctx.candidateWinnerBaseStrongFlags,      baseStrong)
            array.push(ctx.candidateWinnerCategoryMasks,        categoryMask)
            array.push(ctx.candidateWinnerHighMasks,            highMask)
            array.push(ctx.candidateWinnerCreatedTimes,         createdTime)
            array.push(ctx.candidateWinnerMinRootIds,           minRootId)
            array.push(ctx.candidateWinnerFvgModes,             fvgMode)
            array.push(ctx.candidateWinnerPsychLevelTicks,      psychLevelTick)
            array.push(ctx.candidateWinnerReferencePrices,      referencePrice)
            array.push(ctx.candidateWinnerRootIdOffsets,        rootStart)
            array.push(ctx.candidateWinnerRootIdLengths,        rootCount)
        else
            array.set(ctx.candidateWinnerSides,                recordIndex, side)
            array.set(ctx.candidateWinnerStages,               recordIndex, stage)
            array.set(ctx.candidateWinnerEffectiveBottomTicks, recordIndex, effectiveBottomTick)
            array.set(ctx.candidateWinnerEffectiveTopTicks,    recordIndex, effectiveTopTick)
            array.set(ctx.candidateWinnerCCounts,              recordIndex, cCount)
            array.set(ctx.candidateWinnerHCounts,              recordIndex, hCount)
            array.set(ctx.candidateWinnerDensities,            recordIndex, density)
            array.set(ctx.candidateWinnerBaseStrongFlags,      recordIndex, baseStrong)
            array.set(ctx.candidateWinnerCategoryMasks,        recordIndex, categoryMask)
            array.set(ctx.candidateWinnerHighMasks,            recordIndex, highMask)
            array.set(ctx.candidateWinnerCreatedTimes,         recordIndex, createdTime)
            array.set(ctx.candidateWinnerMinRootIds,           recordIndex, minRootId)
            array.set(ctx.candidateWinnerFvgModes,             recordIndex, fvgMode)
            array.set(ctx.candidateWinnerPsychLevelTicks,      recordIndex, psychLevelTick)
            array.set(ctx.candidateWinnerReferencePrices,      recordIndex, referencePrice)
            array.set(ctx.candidateWinnerRootIdOffsets,        recordIndex, rootStart)
            array.set(ctx.candidateWinnerRootIdLengths,        recordIndex, rootCount)
        ctx.candidateWinnerRootIdLength := rootStart + rootCount
        ctx.candidateWinnerLogicalCount := recordIndex + 1
    ok
candSelectWinnersRaw(CandidateCtx ctx, float mintick, int side, int denseTick, int mTick) =>
    bool isSupport = side == SIDE_SUPPORT
    bool ok = (side == SIDE_SUPPORT or side == SIDE_RESISTANCE) and not na(mintick) and mintick > 0 and not na(denseTick) and not na(mTick) and denseTick >= 0 and mTick >= 0 and denseTick <= mTick
    if side == SIDE_SUPPORT
        ctx.candidateFailedSupport      := false
        ctx.candidateWinnerLogicalCount := 0
        ctx.candidateWinnerRootIdLength := 0
    else if side == SIDE_RESISTANCE
        ctx.candidateFailedResistance := false
    int sideStartWinnerCount  = ctx.candidateWinnerLogicalCount
    int sideStartRootIdLength = ctx.candidateWinnerRootIdLength
    ctx.candidatePoolMode := CAND_POOL_NONE
    array<bool> usedBySlot = isSupport ? ctx.candidateSupportUsedByRootSlot : ctx.candidateResistanceUsedByRootSlot
    // used : every rootSlot false (Broad included; Virtual Psych has no Root)
    if ok
        int rootCount = array.size(ctx.rootIds)
        int usedSize  = math.max(rootCount, array.size(usedBySlot))
        int u = 0
        while u < usedSize
            if u < array.size(usedBySlot)
                array.set(usedBySlot, u, false)
            else
                array.push(usedBySlot, false)
            u += 1
    // phase 0 : Dense (Stage A + B, DEN_HIGH and baseStrong), phase 1 : Stage C
    int phase = 0
    while ok and phase < 2
        bool phaseDone = false
        while ok and not phaseDone
            int pointLen = candBuildEligibleScratchRaw(ctx, side)
            int fvgLen   = candBuildFvgScratchRaw(ctx, side)
            // round best reset : B07 defaults, all 16 + tie
            ctx.candidateBestSide                := SIDE_NONE
            ctx.candidateBestStage               := int(na)
            ctx.candidateBestLeftIndex           := SLOT_INVALID
            ctx.candidateBestRightIndex          := SLOT_INVALID
            ctx.candidateBestEffectiveBottomTick := int(na)
            ctx.candidateBestEffectiveTopTick    := int(na)
            ctx.candidateBestCCount              := 0
            ctx.candidateBestHCount              := 0
            ctx.candidateBestDensity             := int(na)
            ctx.candidateBestBaseStrong          := false
            ctx.candidateBestCreatedTime         := int(na)
            ctx.candidateBestMinRootId           := ID_NONE
            ctx.candidateBestFvgMode             := CAND_FVG_RANGE_NONE
            ctx.candidateBestFvgRootSlot         := SLOT_INVALID
            ctx.candidateBestCategoryMask        := CAT_MASK_NONE
            ctx.candidateBestHighMask            := CAT_MASK_NONE
            ctx.candidateRoundTie                := false
            if phase == 0
                ctx.candidatePoolMode := CAND_POOL_DENSE
                ok := candEnumerateStageARaw(ctx, mintick, side, denseTick, mTick)
                if ok
                    ok := candEnumerateStageBRaw(ctx, mintick, side, denseTick, mTick)
            else
                ctx.candidatePoolMode := CAND_POOL_STAGE_C
                ok := candEnumerateStageCRaw(ctx, mintick, side, denseTick, mTick)
            ctx.candidatePoolMode := CAND_POOL_NONE
            if ok
                if ctx.candidateBestSide == SIDE_NONE
                    phaseDone := true
                else if ctx.candidateRoundTie
                    ok := false
                else
                    ok := candMaterializeWinnerRaw(ctx, mintick, ctx.candidateBestSide, ctx.candidateBestStage, ctx.candidateBestLeftIndex, ctx.candidateBestRightIndex, ctx.candidateBestEffectiveBottomTick, ctx.candidateBestEffectiveTopTick, ctx.candidateBestCCount, ctx.candidateBestHCount, ctx.candidateBestDensity, ctx.candidateBestBaseStrong, ctx.candidateBestCreatedTime, ctx.candidateBestMinRootId, ctx.candidateBestFvgMode, ctx.candidateBestFvgRootSlot, ctx.candidateBestCategoryMask, ctx.candidateBestHighMask)
                    // used : Point Roots and non-Broad FVGs of the new winner; Broad never
                    if ok
                        int w   = ctx.candidateWinnerLogicalCount - 1
                        int off = array.get(ctx.candidateWinnerRootIdOffsets, w)
                        int len = array.get(ctx.candidateWinnerRootIdLengths, w)
                        int m = 0
                        while ok and m < len
                            int id = array.get(ctx.candidateWinnerRootIds, off + m)
                            ok := map.contains(ctx.rootIdToSlot, id)
                            int s = ok ? map.get(ctx.rootIdToSlot, id) : SLOT_INVALID
                            if ok
                                ok := s >= 0 and s < array.size(ctx.rootIds) and s < array.size(ctx.rootSlotLiveFlags) and s < array.size(ctx.rootCategories) and s < array.size(ctx.rootIsBroadFvgFlags) and s < array.size(usedBySlot)
                            if ok
                                ok := array.get(ctx.rootSlotLiveFlags, s) and array.get(ctx.rootIds, s) == id
                            if ok
                                int category = array.get(ctx.rootCategories, s)
                                if category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL
                                    array.set(usedBySlot, s, true)
                                else if category == CAT_FVG
                                    if not array.get(ctx.rootIsBroadFvgFlags, s)
                                        array.set(usedBySlot, s, true)
                                else
                                    ok := false
                            m += 1
        phase += 1
    // final BroadContext : Broads in no non-context Candidate of the final used state
    if ok
        int pointLen  = candBuildEligibleScratchRaw(ctx, side)
        int fvgLen    = candBuildFvgScratchRaw(ctx, side)
        array<int> seen = ctx.candidateBroadSeenEpochByRootSlot
        ctx.candidateBroadSeenEpoch += 1
        int rootCount = array.size(ctx.rootIds)
        while array.size(seen) < rootCount
            array.push(seen, 0)
        ctx.candidatePoolMode := CAND_POOL_CONTEXT_SCAN
        ok := candEnumerateStageARaw(ctx, mintick, side, denseTick, mTick)
        if ok
            ok := candEnumerateStageBRaw(ctx, mintick, side, denseTick, mTick)
        if ok
            ok := candEnumerateStageCRaw(ctx, mintick, side, denseTick, mTick)
        ctx.candidatePoolMode := CAND_POOL_NONE
        // FVG scratch order = rootId ASC
        array<int> fvgScratch = isSupport ? ctx.candidateSupportFvgRootSlots : ctx.candidateResistanceFvgRootSlots
        int        fvgN       = isSupport ? ctx.candidateSupportFvgLength : ctx.candidateResistanceFvgLength
        if ok
            ok := fvgN >= 0 and fvgN <= array.size(fvgScratch)
        int k = 0
        while ok and k < fvgN
            int f = array.get(fvgScratch, k)
            ok := f >= 0 and f < array.size(ctx.rootIds) and f < array.size(ctx.rootSlotLiveFlags) and f < array.size(ctx.rootCategories) and f < array.size(ctx.rootIsBroadFvgFlags) and f < array.size(ctx.rootNativeBottomTicks) and f < array.size(ctx.rootNativeTopTicks) and f < array.size(ctx.rootConfirmedTimes) and f < array.size(seen)
            if ok
                if array.get(ctx.rootSlotLiveFlags, f) and array.get(ctx.rootCategories, f) == CAT_FVG and array.get(ctx.rootIsBroadFvgFlags, f) and candEligibleRaw(ctx, f, side) and array.get(seen, f) != ctx.candidateBroadSeenEpoch and ctx.runDomain != CAND_RUN_DOMAIN_LOCAL_NORMAL
                    int nb   = array.get(ctx.rootNativeBottomTicks, f)
                    int nt   = array.get(ctx.rootNativeTopTicks, f)
                    int conf = array.get(ctx.rootConfirmedTimes, f)
                    int id   = array.get(ctx.rootIds, f)
                    if not na(nb) and not na(nt) and nb <= nt and not na(conf) and id != ID_NONE
                        ok := candMaterializeWinnerRaw(ctx, mintick, side, CAND_STAGE_BROAD_CONTEXT, SLOT_INVALID, SLOT_INVALID, nb, nt, 1, 0, DEN_BROAD_CONTEXT, false, conf, id, CAND_FVG_RANGE_BROAD_CONTEXT, f, CAT_MASK_FVG, CAT_MASK_NONE)
            k += 1
    ctx.candidatePoolMode := CAND_POOL_NONE
    int result = -1
    if ok
        result := ctx.candidateWinnerLogicalCount - sideStartWinnerCount
    else
        // Side failure : this Side's segment rolled back, the other Side untouched
        ctx.candidateWinnerLogicalCount := sideStartWinnerCount
        ctx.candidateWinnerRootIdLength := sideStartRootIdLength
        if side == SIDE_SUPPORT
            ctx.candidateFailedSupport := true
        else if side == SIDE_RESISTANCE
            ctx.candidateFailedResistance := true
    result

export selectBothSides(array<int> rootIds, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<int> rootPointTicks, array<float> rootNativeBottoms, array<float> rootNativeTops, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, array<int> rootSwingTfMasks, int ema2000RootSlot, int ema2000ExpectedRootId, int ema2000SlopeDir, int ema3000RootSlot, int ema3000ExpectedRootId, int ema3000SlopeDir, float clusterMaxWidth, float denseRatio, bool useMa, bool useSwing, bool useAccum, bool useTimeHl, bool useFvg, bool usePsych, float mintick, array<int> candidateScratchSupportNewRootSlots, array<int> candidateScratchResistanceNewRootSlots, array<int> candidateSupportScratchPosByRootSlot, array<int> candidateResistanceScratchPosByRootSlot, array<bool> candidateSupportUsedByRootSlot, array<bool> candidateResistanceUsedByRootSlot, array<int> candidateSupportFvgRootSlots, array<int> candidateResistanceFvgRootSlots, array<int> candidateWindowMinRootIdDequeScratchIndexes, array<int> candidateWindowMaxConfirmedTimeDequeScratchIndexes, array<int> candidateWinnerSides, array<int> candidateWinnerStages, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<int> candidateWinnerCCounts, array<int> candidateWinnerHCounts, array<int> candidateWinnerDensities, array<bool> candidateWinnerBaseStrongFlags, array<int> candidateWinnerCategoryMasks, array<int> candidateWinnerHighMasks, array<int> candidateWinnerCreatedTimes, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerFvgModes, array<int> candidat
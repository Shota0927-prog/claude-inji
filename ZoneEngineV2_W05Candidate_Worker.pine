// W06 B02: selectBothSides with a Candidate run domain; returns its 31 values + the CONTEXT_SCAN epoch of each Side (na when not reached).
// An invalid runDomain runs no scan and returns both Sides failed (-1, failed flags true, no winner).
export selectComponentBothSides(array<int> rootIds, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<int> rootPointTicks, array<float> rootNativeBottoms, array<float> rootNativeTops, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, array<int> rootSwingTfMasks, int ema2000RootSlot, int ema2000ExpectedRootId, int ema2000SlopeDir, int ema3000RootSlot, int ema3000ExpectedRootId, int ema3000SlopeDir, float clusterMaxWidth, float denseRatio, bool useMa, bool useSwing, bool useAccum, bool useTimeHl, bool useFvg, bool usePsych, float mintick, array<int> candidateScratchSupportNewRootSlots, array<int> candidateScratchResistanceNewRootSlots, array<int> candidateSupportScratchPosByRootSlot, array<int> candidateResistanceScratchPosByRootSlot, array<bool> candidateSupportUsedByRootSlot, array<bool> candidateResistanceUsedByRootSlot, array<int> candidateSupportFvgRootSlots, array<int> candidateResistanceFvgRootSlots, array<int> candidateWindowMinRootIdDequeScratchIndexes, array<int> candidateWindowMaxConfirmedTimeDequeScratchIndexes, array<int> candidateWinnerSides, array<int> candidateWinnerStages, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<int> candidateWinnerCCounts, array<int> candidateWinnerHCounts, array<int> candidateWinnerDensities, array<bool> candidateWinnerBaseStrongFlags, array<int> candidateWinnerCategoryMasks, array<int> candidateWinnerHighMasks, array<int> candidateWinnerCreatedTimes, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerFvgModes, array<int> candidateWinnerPsychLevelTicks, array<float> candidateWinnerReferencePrices, array<int> candidateWinnerRootIdOffsets, array<int> candidateWinnerRootIdLengths, array<int> candidateWinnerRootIds, array<float> candidateWinnerRefValueScratch, array<float> candidateWinnerRefRepScratch, array<int> candidateBroadSeenEpochByRootSlot, int candidateScratchSupportNewLength, int candidateScratchResistanceNewLength, int candidateSupportFvgLength, int candidateResistanceFvgLength, int candidateBestSide, int candidateBestStage, int candidateBestLeftIndex, int candidateBestRightIndex, int candidateBestEffectiveBottomTick, int candidateBestEffectiveTopTick, int candidateBestCCount, int candidateBestHCount, int candidateBestDensity, bool candidateBestBaseStrong, int candidateBestCreatedTime, int candidateBestMinRootId, int candidateBestFvgMode, int candidateBestFvgRootSlot, int candidateBestCategoryMask, int candidateBestHighMask, bool candidateRoundTie, bool candidateFailedSupport, bool candidateFailedResistance, int candidateWinnerLogicalCount, int candidateWinnerRootIdLength, int candidateWinnerRefValueLength, int candidateWinnerRefRepLength, int candidatePoolMode, int candidateBroadSeenEpoch, int runDomain) =>
    CandidateCtx ctx = CandidateCtx.new(rootIds, rootCategories, rootSubtypes, rootTfCodes, rootConfirmedTimes, rootPointPrices, rootPointTicks, rootNativeBottoms, rootNativeTops, rootNativeBottomTicks, rootNativeTopTicks, rootStates, rootPairKeys, rootDirections, rootIsBroadFvgFlags, rootLabelMasks, rootSlotLiveFlags, rootPriceOrderSlots, rootIdOrderSlots, rootIdToSlot, accumPairUpperRootSlotByKey, accumPairLowerRootSlotByKey, rootSwingTfMasks, ema2000RootSlot, ema2000ExpectedRootId, ema2000SlopeDir, ema3000RootSlot, ema3000ExpectedRootId, ema3000SlopeDir, clusterMaxWidth, denseRatio, useMa, useSwing, useAccum, useTimeHl, useFvg, usePsych, mintick, candidateScratchSupportNewRootSlots, candidateScratchResistanceNewRootSlots, candidateSupportScratchPosByRootSlot, candidateResistanceScratchPosByRootSlot, candidateSupportUsedByRootSlot, candidateResistanceUsedByRootSlot, candidateSupportFvgRootSlots, candidateResistanceFvgRootSlots, candidateWindowMinRootIdDequeScratchIndexes, candidateWindowMaxConfirmedTimeDequeScratchIndexes, candidateWinnerSides, candidateWinnerStages, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerCCounts, candidateWinnerHCounts, candidateWinnerDensities, candidateWinnerBaseStrongFlags, candidateWinnerCategoryMasks, candidateWinnerHighMasks, candidateWinnerCreatedTimes, candidateWinnerMinRootIds, candidateWinnerFvgModes, candidateWinnerPsychLevelTicks, candidateWinnerReferencePrices, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds, candidateWinnerRefValueScratch, candidateWinnerRefRepScratch, candidateBroadSeenEpochByRootSlot, candidateScratchSupportNewLength, candidateScratchResistanceNewLength, candidateSupportFvgLength, candidateResistanceFvgLength, candidateBestSide, candidateBestStage, candidateBestLeftIndex, candidateBestRightIndex, candidateBestEffectiveBottomTick, candidateBestEffectiveTopTick, candidateBestCCount, candidateBestHCount, candidateBestDensity, candidateBestBaseStrong, candidateBestCreatedTime, candidateBestMinRootId, candidateBestFvgMode, candidateBestFvgRootSlot, candidateBestCategoryMask, candidateBestHighMask, candidateRoundTie, candidateFailedSupport, candidateFailedResistance, candidateWinnerLogicalCount, candidateWinnerRootIdLength, candidateWinnerRefValueLength, candidateWinnerRefRepLength, candidatePoolMode, candidateBroadSeenEpoch, runDomain, candidateSupportFvgBottomOrder = array.new_int(0), candidateSupportFvgTopOrder = array.new_int(0), candidateResistanceFvgBottomOrder = array.new_int(0), candidateResistanceFvgTopOrder = array.new_int(0), candidateFvgMatchSlots = array.new_int(0))
    bool domainValid           = runDomain == CAND_RUN_DOMAIN_FULL or runDomain == CAND_RUN_DOMAIN_LOCAL_NORMAL or runDomain == CAND_RUN_DOMAIN_BROAD_ONLY
    int  supportWinnerCount    = -1
    int  resistanceWinnerCount = -1
    int  supportScanEpoch      = int(na)
    int  resistanceScanEpoch   = int(na)
    if domainValid
        [candidateDenseTick, candidateMTick] = candTickLimitsRaw(ctx, ctx.mintick)
        int supportEpochBefore = ctx.candidateBroadSeenEpoch
        supportWinnerCount := candSelectWinnersRaw(ctx, ctx.mintick, SIDE_SUPPORT, candidateDenseTick, candidateMTick)
        if ctx.candidateBroadSeenEpoch != supportEpochBefore
            supportScanEpoch := ctx.candidateBroadSeenEpoch
        int resistanceEpochBefore = ctx.candidateBroadSeenEpoch
        resistanceWinnerCount := candSelectWinnersRaw(ctx, ctx.mintick, SIDE_RESISTANCE, candidateDenseTick, candidateMTick)
        if ctx.candidateBroadSeenEpoch != resistanceEpochBefore
            resistanceScanEpoch := ctx.candidateBroadSeenEpoch
    else
        ctx.candidateFailedSupport      := true
        ctx.candidateFailedResistance   := true
        ctx.candidateWinnerLogicalCount := 0
        ctx.candidateWinnerRootIdLength := 0
    [supportWinnerCount, resistanceWinnerCount, ctx.candidateScratchSupportNewLength, ctx.candidateScratchResistanceNewLength, ctx.candidateSupportFvgLength, ctx.candidateResistanceFvgLength, ctx.candidateBestSide, ctx.candidateBestStage, ctx.candidateBestLeftIndex, ctx.candidateBestRightIndex, ctx.candidateBestEffectiveBottomTick, ctx.candidateBestEffectiveTopTick, ctx.candidateBestCCount, ctx.candidateBestHCount, ctx.candidateBestDensity, ctx.candidateBestBaseStrong, ctx.candidateBestCreatedTime, ctx.candidateBestMinRootId, ctx.candidateBestFvgMode, ctx.candidateBestFvgRootSlot, ctx.candidateBestCategoryMask, ctx.candidateBestHighMask, ctx.candidateRoundTie, ctx.candidateFailedSupport, ctx.candidateFailedResistance, ctx.candidateWinnerLogicalCount, ctx.candidateWinnerRootIdLength, ctx.candidateWinnerRefValueLength, ctx.candidateWinnerRefRepLength, ctx.candidatePoolMode, ctx.candidateBroadSeenEpoch, supportScanEpoch, resistanceScanEpoch]

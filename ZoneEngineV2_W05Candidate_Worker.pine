estBaseStrong, candidateBestCreatedTime, candidateBestMinRootId, candidateBestFvgMode, candidateBestFvgRootSlot, candidateBestCategoryMask, candidateBestHighMask, candidateRoundTie, candidateFailedSupport, candidateFailedResistance, candidateWinnerLogicalCount, candidateWinnerRootIdLength, candidateWinnerRefValueLength, candidateWinnerRefRepLength, candidatePoolMode, candidateBroadSeenEpoch, candidateSupportFvgBottomOrder = array.new_int(0), candidateSupportFvgTopOrder = array.new_int(0), candidateResistanceFvgBottomOrder = array.new_int(0), candidateResistanceFvgTopOrder = array.new_int(0), candidateFvgMatchSlots = array.new_int(0))

// --- 採用パターンのデバッグラベル (hsEnvLabelTF の LS/頭/RS/N1/N2 を時刻アンカーで描画) ---
var array<label> hsEnvLbls = array.new_label()
if hsEnvShowLabels and barstate.islast
    if array.size(hsEnvLbls) > 0
        for _i = 0 to array.size(hsEnvLbls) - 1
            label.delete(array.get(hsEnvLbls, _i))
        array.clear(hsEnvLbls)
    if not na(hsLblHdP) and not na(hsLblHdT)
        string _hsHeadTxt = "頭  Sc:" + str.tostring(hsDbgScore, "#.##") + "  W:" + str.tostring(hsDbgPat) + "  T:" + str.tostring(hsDbgTime, "#.##") + "  Sh:" + str.tostring(hsDbgShDf, "#.##") + "  Pr:" + str.tostring(hsDbgProm, "#.##") + "  Nk:" + str.tostring(hsDbgNeck, "#.##")
        array.push(hsEnvLbls, label.new(hsLblLsT, hsLblLsP, "LS", xloc = xloc.bar_time, style = label.style_label_up,   color = color.new(color.gray, 20),  textcolor = color.white, size = size.tiny))
        array.push(hsEnvLbls, label.new(hsLblHdT, hsLblHdP, _hsHeadTxt, xloc = xloc.bar_time, style = label.style_label_up,   color = color.new(color.orange, 10), textcolor = color.white, size = size.tiny))
        array.push(hsEnvLbls, label.new(hsLblRsT, hsLblRsP, "RS", xloc = xloc.bar_time, style = label.style_label_up,   color = color.new(color.gray, 20),  textcolor = color.white, size = size.tiny))
        array.push(hsEnvLbls, label.new(hsLblN1T, hsLblN1P, "N1", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.blue, 20),  textcolor = color.white, size = size.tiny))
        array.push(hsEnvLbls, label.new(hsLblN2T, hsLblN2P, "N2", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.blue, 20),  textcolor = color.white, size = size.tiny))

// --- 三尊 / 逆三尊 候補 + 確定 パターン描画 (hsEnvLabelTF・時刻アンカー) ---
//   ・候補 (ブレイク前・_upReady/_dnReady 未消費) = 透明度60 で表示。
//   ・確定 (ブレイク後) = 透明度0 で明確に表示し、holdBars 失効後も「最新の確定パターン」を保持。
//     → 環境バイアスの保持 (holdBars = _out) と 描画の保持 (下記 hsCf* スナップショット) を分離。
//   ・検知ロジックが採用した5点 (LS/N1/Head/N2/RS) をそのまま使用 (再計算しない)。
//   ・ネックラインは検知で使うのと同一の N1/N2 を結んで右延長 (別計算しない)。
//   ・全て表示専用。canLong/canShort・検知条件・ブレイク条件・状態保持には一切干渉しない。
//   ・毎バー無制限生成を防ぐため配列で管理し、再描画前に必ず削除する。
//   色分け : 逆三尊=緑 / 三尊=赤 / ネックライン=青 (候補=透明度60 / 確定=透明度0)。
var array<line>  hsEnvPatternLines = array.new_line()
var array<label> hsEnvBreakLabels  = array.new_label()

f_hsEnvPatColor(int _pt, int _transp) =>
    _pt == 1 ? color.new(color.green, _transp) : _pt == -1 ? color.new(color.red, _transp) : color.new(color.gray, _transp)

// 確定パターンの持続スナップショット (holdBars 保持中に最新の確定パターンを捕捉し、失効後も保持)。
//   毎バー実行 (barstate.islast の外)。hsLblPatType が 0 (=保持切れ) の間は上書きしないので、
//   直近に確定したパターンがチャートに残り続ける。次の確定で置き換わる。
var int   hsCfType   = 0
var float hsCfLsP = na
var int   hsCfLsT = na
var float hsCfHdP = na
var int   hsCfHdT = na
var float hsCfRsP = na
var int   hsCfRsT = na
var float hsCfN1P = na
var int   hsCfN1T = na
var float hsCfN2P = na
var int   hsCfN2T = na
var int   hsCfBreakT = na
var float hsCfBreakP = na
if hsLblPatType != 0 and not na(hsLblLsT) and not na(hsLblN1T) and not na(hsLblHdT) and not na(hsLblN2T) and not na(hsLblRsT)
    hsCfType := hsLblPatType
    hsCfLsP := hsLblLsP
    hsCfLsT := hsLblLsT
    hsCfHdP := hsLblHdP
    hsCfHdT := hsLblHdT
    hsCfRsP := hsLblRsP
    hsCfRsT := hsLblRsT
    hsCfN1P := hsLblN1P
    hsCfN1T := hsLblN1T
    hsCfN2P := hsLblN2P
    hsCfN2T := hsLblN2T
    hsCfBreakT := hsLblBreakT
    hsCfBreakP := hsLblBreakP

if barstate.islast
    // --- 既存オブジェクトを削除 (パターンライン + ネックラインを一括管理) ---
    if array.size(hsEnvPatternLines) > 0
        for _i = 0 to array.size(hsEnvPatternLines) - 1
            line.delete(array.get(hsEnvPatternLines, _i))
        array.clear(hsEnvPatternLines)
    // --- 既存オブジェクトを削除 (確定ラベル) ---
    if array.size(hsEnvBreakLabels) > 0
        for _i = 0 to array.size(hsEnvBreakLabels) - 1
            label.delete(array.get(hsEnvBreakLabels, _i))
        array.clear(hsEnvBreakLabels)
    // === 候補 (ブレイク前) : 透明度60 ===
    bool _hsHasCand = hsLblCandType != 0 and not na(hsLblCLsT) and not na(hsLblCN1T) and not na(hsLblCHdT) and not na(hsLblCN2T) and not na(hsLblCRsT)
    if _hsHasCand
        color _candCol = f_hsEnvPatColor(hsLblCandType, 60)
        // パターンライン : LS → N1 → Head → N2 → RS (4本)
        if hsEnvShowPatternLines
            array.push(hsEnvPatternLines, line.new(hsLblCLsT, hsLblCLsP, hsLblCN1T, hsLblCN1P, xloc = xloc.bar_time, color = _candCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsLblCN1T, hsLblCN1P, hsLblCHdT, hsLblCHdP, xloc = xloc.bar_time, color = _candCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsLblCHdT, hsLblCHdP, hsLblCN2T, hsLblCN2P, xloc = xloc.bar_time, color = _candCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsLblCN2T, hsLblCN2P, hsLblCRsT, hsLblCRsP, xloc = xloc.bar_time, color = _candCol, width = hsEnvPatternLineWidth))
        // ネックライン : N1 → N2 (右延長)。検知ロジックと同一の N1/N2 を使用。
        if hsEnvShowNeckline
            array.push(hsEnvPatternLines, line.new(hsLblCN1T, hsLblCN1P, hsLblCN2T, hsLblCN2P, xloc = xloc.bar_time, color = color.new(color.blue, 60), width = hsEnvNeckLineWidth, extend = extend.right))
    // === 確定 (ブレイク後・持続) : 透明度0 ===
    bool _hsHasConf = hsCfType != 0 and not na(hsCfLsT) and not na(hsCfN1T) and not na(hsCfHdT) and not na(hsCfN2T) and not na(hsCfRsT)
    if _hsHasConf
        color _confCol = f_hsEnvPatColor(hsCfType, 0)
        // パターンライン : LS → N1 → Head → N2 → RS (4本)
        if hsEnvShowPatternLines
            array.push(hsEnvPatternLines, line.new(hsCfLsT, hsCfLsP, hsCfN1T, hsCfN1P, xloc = xloc.bar_time, color = _confCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsCfN1T, hsCfN1P, hsCfHdT, hsCfHdP, xloc = xloc.bar_time, color = _confCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsCfHdT, hsCfHdP, hsCfN2T, hsCfN2P, xloc = xloc.bar_time, color = _confCol, width = hsEnvPatternLineWidth))
            array.push(hsEnvPatternLines, line.new(hsCfN2T, hsCfN2P, hsCfRsT, hsCfRsP, xloc = xloc.bar_time, color = _confCol, width = hsEnvPatternLineWidth))
        // ネックライン : N1 → N2 (右延長)。検知ロジックと同一の N1/N2 を使用。
        if hsEnvShowNeckline
            array.push(hsEnvPatternLines, line.new(hsCfN1T, hsCfN1P, hsCfN2T, hsCfN2P, xloc = xloc.bar_time, color = color.new(color.blue, 0), width = hsEnvNeckLineWidth, extend = extend.right))
        // 確定ラベル : 実際にネックラインをブレイクした上位足の確定足に表示
        if hsEnvShowBreakLabel and not na(hsCfBreakT) and not na(hsCfBreakP)
            string _hsBreakTxt = hsCfType == -1 ? "三尊確定" : "逆三尊確定"
            array.push(hsEnvBreakLabels, label.new(hsCfBreakT, hsCfBreakP, _hsBreakTxt, xloc = xloc.bar_time, style = hsCfType == -1 ? label.style_label_down : label.style_label_up, color = _confCol, textcolor = color.white, size = size.small))

// ============================================================
//  12e. Fib 環境認識 (MTF) 表示 (テーブル + Data Window)
// ============================================================
f_fibEnvBiasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_fibEnvBiasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
f_fibEnvFilterText(bool _active, bool _lOk, bool _sOk) =>
    not _active ? "OFF" : _lOk and _sOk ? "BOTH OK" : _lOk ? "LONG OK" : _sOk ? "SHORT OK" : "BLOCK"
f_fibEnvFilterColor(bool _active, bool _lOk, bool _sOk) =>
    not _active ? color.new(color.gray, 40) : _lOk and _sOk ? color.new(color.green, 0) : _lOk ? color.new(color.green, 0) : _sOk ? color.new(color.red, 0) : color.new(color.orange, 0)

var table fibEnvTbl = na
if fibEnvShowTable
    if na(fibEnvTbl)
        fibEnvTbl := table.new(position.middle_left, 7, 7, border_width = 1)
    if barstate.islast
        table.cell(fibEnvTbl, 0, 0, "FibEnv", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 1, 0, "方向",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 2, 0, "戻/押%", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 3, 0, "基礎L",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 4, 0, "基礎S",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 5, 0, "加重L",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 6, 0, "加重S",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // Daily
        table.cell(fibEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 1, useFibEnvD ? f_fibEnvDirText(fibEnvDirection_D) : "-", text_color = color.white, bgcolor = f_fibEnvDirColor(fibEnvDirection_D, useFibEnvD), text_size = size.small)
        table.cell(fibEnvTbl, 2, 1, useFibEnvD and not na(fibEnvRetr_D) ? str.tostring(fibEnvRetr_D * 100.0, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 1, useFibEnvD ? str.tostring(fibEnvLongScore_D) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 1, useFibEnvD ? str.tostring(fibEnvShortScore_D) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 1, useFibEnvD and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedLong_D, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 6, 1, useFibEnvD and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedShort_D, "#.#") : "-", text_color = color.white, text_size = size.small)
        // 4H
        table.cell(fibEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 2, useFibEnvH4 ? f_fibEnvDirText(fibEnvDirection_H4) : "-", text_color = color.white, bgcolor = f_fibEnvDirColor(fibEnvDirection_H4, useFibEnvH4), text_size = size.small)
        table.cell(fibEnvTbl, 2, 2, useFibEnvH4 and not na(fibEnvRetr_H4) ? str.tostring(fibEnvRetr_H4 * 100.0, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 2, useFibEnvH4 ? str.tostring(fibEnvLongScore_H4) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 2, useFibEnvH4 ? str.tostring(fibEnvShortScore_H4) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 2, useFibEnvH4 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedLong_H4, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 6, 2, useFibEnvH4 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedShort_H4, "#.#") : "-", text_color = color.white, text_size = size.small)
        // 1H
        table.cell(fibEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 3, useFibEnvH1 ? f_fibEnvDirText(fibEnvDirection_H1) : "-", text_color = color.white, bgcolor = f_fibEnvDirColor(fibEnvDirection_H1, useFibEnvH1), text_size = size.small)
        table.cell(fibEnvTbl, 2, 3, useFibEnvH1 and not na(fibEnvRetr_H1) ? str.tostring(fibEnvRetr_H1 * 100.0, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 3, useFibEnvH1 ? str.tostring(fibEnvLongScore_H1) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 3, useFibEnvH1 ? str.tostring(fibEnvShortScore_H1) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 3, useFibEnvH1 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedLong_H1, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 6, 3, useFibEnvH1 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedShort_H1, "#.#") : "-", text_color = color.white, text_size = size.small)
        // 15M
        table.cell(fibEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 4, useFibEnvM15 ? f_fibEnvDirText(fibEnvDirection_M15) : "-", text_color = color.white, bgcolor = f_fibEnvDirColor(fibEnvDirection_M15, useFibEnvM15), text_size = size.small)
        table.cell(fibEnvTbl, 2, 4, useFibEnvM15 and not na(fibEnvRetr_M15) ? str.tostring(fibEnvRetr_M15 * 100.0, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 4, useFibEnvM15 ? str.tostring(fibEnvLongScore_M15) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 4, useFibEnvM15 ? str.tostring(fibEnvShortScore_M15) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 4, useFibEnvM15 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedLong_M15, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 6, 4, useFibEnvM15 and fibEnvShowWeightedScore ? str.tostring(fibEnvWeightedShort_M15, "#.#") : "-", text_color = color.white, text_size = size.small)
        // TOTAL (加重合計 / Net / Bias)
        table.cell(fibEnvTbl, 0, 5, "合計", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 1, 5, fibEnvShowWeightedScore ? f_fibEnvBiasText(fibEnvBias) : "-", text_color = color.white, bgcolor = fibEnvShowWeightedScore ? f_fibEnvBiasColor(fibEnvBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fibEnvTbl, 2, 5, fibEnvShowWeightedScore ? ("Net:" + str.tostring(fibEnvNetScore, "#.#")) : "-", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 5, "", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 5, "", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 5, fibEnvShowWeightedScore ? str.tostring(fibEnvLongTotal, "#.#") : "-", text_color = color.white, bgcolor = color.new(color.green, 70), text_size = size.small)
        table.cell(fibEnvTbl, 6, 5, fibEnvShowWeightedScore ? str.tostring(fibEnvShortTotal, "#.#") : "-", text_color = color.white, bgcolor = color.new(color.red, 70), text_size = size.small)
        // FILTER (エントリー接続状態)
        table.cell(fibEnvTbl, 0, 6, "Filter", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 1, 6, f_fibEnvFilterText(fibEnvFilterActive, allowLongByFibEnv, allowShortByFibEnv), text_color = color.white, bgcolor = f_fibEnvFilterColor(fibEnvFilterActive, allowLongByFibEnv, allowShortByFibEnv), text_size = size.small)
        table.cell(fibEnvTbl, 2, 6, "Thr:" + str.tostring(fibEnvScoreThreshold, "#.#"), text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 3, 6, "", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 4, 6, "", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 5, 6, "L:" + (allowLongByFibEnv ? "OK" : "NG"),  text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 6, 6, "S:" + (allowShortByFibEnv ? "OK" : "NG"), text_color = color.white, text_size = size.small)

// Data Window : 各TFの Direction / Long / Short / Retr
// plot(fibEnvDirection_D,   "fibEnvDirection_D",   display = display.data_window)
// plot(fibEnvLongScore_D,   "fibEnvLongScore_D",   display = display.data_window)
// plot(fibEnvShortScore_D,  "fibEnvShortScore_D",  display = display.data_window)
// plot(fibEnvRetr_D,        "fibEnvRetr_D",        display = display.data_window)
// plot(fibEnvDirection_H4,  "fibEnvDirection_H4",  display = display.data_window)
// plot(fibEnvLongScore_H4,  "fibEnvLongScore_H4",  display = display.data_window)
// plot(fibEnvShortScore_H4, "fibEnvShortScore_H4", display = display.data_window)
// plot(fibEnvRetr_H4,       "fibEnvRetr_H4",       display = display.data_window)
// plot(fibEnvDirection_H1,  "fibEnvDirection_H1",  display = display.data_window)
// plot(fibEnvLongScore_H1,  "fibEnvLongScore_H1",  display = display.data_window)
// plot(fibEnvShortScore_H1, "fibEnvShortScore_H1", display = display.data_window)
// plot(fibEnvRetr_H1,       "fibEnvRetr_H1",       display = display.data_window)
// plot(fibEnvDirection_M15, "fibEnvDirection_M15", display = display.data_window)
// plot(fibEnvLongScore_M15, "fibEnvLongScore_M15", display = display.data_window)
// plot(fibEnvShortScore_M15,"fibEnvShortScore_M15",display = display.data_window)
// plot(fibEnvRetr_M15,      "fibEnvRetr_M15",      display = display.data_window)
// Data Window : 加重スコア (時間足重み × 基礎点) と合計 / Net / Bias
plot(fibEnvWeightedLong_D,   "fibEnvWeightedLong_D",   display = display.data_window)
plot(fibEnvWeightedShort_D,  "fibEnvWeightedShort_D",  display = display.data_window)
plot(fibEnvWeightedLong_H4,  "fibEnvWeightedLong_H4",  display = display.data_window)
plot(fibEnvWeightedShort_H4, "fibEnvWeightedShort_H4", display = display.data_window)
plot(fibEnvWeightedLong_H1,  "fibEnvWeightedLong_H1",  display = display.data_window)
plot(fibEnvWeightedShort_H1, "fibEnvWeightedShort_H1", display = display.data_window)
plot(fibEnvWeightedLong_M15, "fibEnvWeightedLong_M15", display = display.data_window)
plot(fibEnvWeightedShort_M15,"fibEnvWeightedShort_M15",display = display.data_window)
plot(fibEnvLongTotal,  "fibEnvLongTotal",  display = display.data_window)
plot(fibEnvShortTotal, "fibEnvShortTotal", display = display.data_window)
plot(fibEnvNetScore,   "fibEnvNetScore",   display = display.data_window)
plot(fibEnvBias,       "fibEnvBias",       display = display.data_window)
// Data Window : エントリーフィルター状態 (bool は 1/0 に変換)
plot(fibEnvScoreThreshold,        "fibEnvScoreThreshold", display = display.data_window)
plot(fibEnvFilterActive ? 1 : 0, "fibEnvFilterActive",   display = display.data_window)
plot(allowLongByFibEnv  ? 1 : 0, "allowLongByFibEnv",    display = display.data_window)
plot(allowShortByFibEnv ? 1 : 0, "allowShortByFibEnv",   display = display.data_window)

// ============================================================
//  12f. Volume Breakout 環境認識 (MTF) 表示 / 背景 / アラート
// ============================================================
f_volEnvStateText(int s) =>
    s == 1 ? "Bull" : s == -1 ? "Bear" : "Neutral"
f_volEnvStateColor(int s, bool on) =>
    not on ? color.new(color.black, 0) : s == 1 ? color.new(color.green, 0) : s == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
f_volEnvPtsText(float p) =>
    (p > 0 ? "+" : "") + str.tostring(p, "#.#")

// --- テーブル ---
var table volEnvTbl = na
if volEnvShowTable
    if na(volEnvTbl)
        volEnvTbl := table.new(position.bottom_left, 3, 8, border_width = 1)
    if barstate.islast
        color _envCol = f_volEnvStateColor(volumeEnvCode, true)
        table.cell(volEnvTbl, 0, 0, "VolEnv", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(volEnvTbl, 1, 0, "状態",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(volEnvTbl, 2, 0, "点",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // D
        table.cell(volEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(volEnvTbl, 1, 1, useVolEnvD ? f_volEnvStateText(volumeStateD) : "-", text_color = color.white, bgcolor = f_volEnvStateColor(volumeStateD, volumeEnvEnabled and useVolEnvD), text_size = size.small)
        table.cell(volEnvTbl, 2, 1, useVolEnvD ? f_volEnvPtsText(volEnvPtsD) : "-", text_color = color.white, text_size = size.small)
        // 4H
        table.cell(volEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(volEnvTbl, 1, 2, useVolEnvH4 ? f_volEnvStateText(volumeState4H) : "-", text_color = color.white, bgcolor = f_volEnvStateColor(volumeState4H, volumeEnvEnabled and useVolEnvH4), text_size = size.small)
        table.cell(volEnvTbl, 2, 2, useVolEnvH4 ? f_volEnvPtsText(volEnvPtsH4) : "-", text_color = color.white, text_size = size.small)
        // 1H
        table.cell(volEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(volEnvTbl, 1, 3, useVolEnvH1 ? f_volEnvStateText(volumeState1H) : "-", text_color = color.white, bgcolor = f_volEnvStateColor(volumeState1H, volumeEnvEnabled and useVolEnvH1), text_size = size.small)
        table.cell(volEnvTbl, 2, 3, useVolEnvH1 ? f_volEnvPtsText(volEnvPtsH1) : "-", text_color = color.white, text_size = size.small)
        // 15M
        table.cell(volEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(volEnvTbl, 1, 4, useVolEnvM15 ? f_volEnvStateText(volumeState15M) : "-", text_color = color.white, bgcolor = f_volEnvStateColor(volumeState15M, volumeEnvEnabled and useVolEnvM15), text_size = size.small)
        table.cell(volEnvTbl, 2, 4, useVolEnvM15 ? f_volEnvPtsText(volEnvPtsM15) : "-", text_color = color.white, text_size = size.small)
        // Score
        table.cell(volEnvTbl, 0, 5, "Score", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(volEnvTbl, 1, 5, f_volEnvPtsText(volumeEnvScore), text_color = color.white, text_size = size.small)
        table.cell(volEnvTbl, 2, 5, "", text_color = color.white, text_size = size.small)
        // Bull/Bear Count
        table.cell(volEnvTbl, 0, 6, "Count", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(volEnvTbl, 1, 6, "Bull:" + str.tostring(volumeBullCount), text_color = color.white, bgcolor = color.new(color.green, 70), text_size = size.small)
        table.cell(volEnvTbl, 2, 6, "Bear:" + str.tostring(volumeBearCount), text_color = color.white, bgcolor = color.new(color.red, 70), text_size = size.small)
        // Environment
        table.cell(volEnvTbl, 0, 7, "Env", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(volEnvTbl, 1, 7, f_volEnvStateText(volumeEnvCode), text_color = color.white, bgcolor = _envCol, text_size = size.small)
        table.cell(volEnvTbl, 2, 7, "Thr:" + str.tostring(volEnvBullThreshold, "#.#") + "/" + str.tostring(volEnvBearThreshold, "#.#"), text_color = color.white, text_size = size.small)

// --- チャート背景 (上昇=薄緑 / 下降=薄赤 / 中立=なし) ---
color volEnvBgCol = not volEnvShowBG ? na : volumeBullEnv ? color.new(color.green, 90) : volumeBearEnv ? color.new(color.red, 90) : na
bgcolor(volEnvBgCol, title = "Volume環境 背景")

// --- アラート (最終環境が切り替わった瞬間だけ発火) ---
bool volEnvChanged = volumeEnvEnabled and volumeEnvCode != volumeEnvCode[1]
alertcondition(volEnvChanged, "Volume環境 変化", "Volume環境が変化しました")
if volEnvChanged
    string _volEnvMsg = "Volume環境: " + f_volEnvStateText(volumeEnvCode[1]) + " → " + f_volEnvStateText(volumeEnvCode) + " (Score:" + f_volEnvPtsText(volumeEnvScore) + " Bull:" + str.tostring(volumeBullCount) + " Bear:" + str.tostring(volumeBearCount) + ")"
    alert(_volEnvMsg, alert.freq_once_per_bar_close)

// --- Data Window ---
plot(volumeStateD,    "volumeStateD",    display = display.data_window)
plot(volumeState4H,   "volumeState4H",   display = display.data_window)
plot(volumeState1H,   "volumeState1H",   display = display.data_window)
plot(volumeState15M,  "volumeState15M",  display = display.data_window)
plot(volEnvPtsD,      "volEnvPtsD",      display = display.data_window)
plot(volEnvPtsH4,     "volEnvPtsH4",     display = display.data_window)
plot(volEnvPtsH1,     "volEnvPtsH1",     display = display.data_window)
plot(volEnvPtsM15,    "volEnvPtsM15",    display = display.data_window)
plot(volumeEnvScore,  "volumeEnvScore",  display = display.data_window)
plot(volumeBullCount, "volumeBullCount", display = display.data_window)
plot(volumeBearCount, "volumeBearCount", display = display.data_window)
plot(volumeBullEnv    ? 1 : 0, "volumeBullEnv",    display = display.data_window)
plot(volumeBearEnv    ? 1 : 0, "volumeBearEnv",    display = display.data_window)
plot(volumeNeutralEnv ? 1 : 0, "volumeNeutralEnv", display = display.data_window)
plot(volumeEnvCode,   "volumeEnvCode",   display = display.data_window)
plot(useVolEnvBias  ? 1 : 0, "useVolEnvBias",  display = display.data_window)
plot(volEnvLongOk   ? 1 : 0, "volEnvLongOk",   display = display.data_window)
plot(volEnvShortOk  ? 1 : 0, "volEnvShortOk",  display = display.data_window)

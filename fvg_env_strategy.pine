//
// ============================================================
//  FVG 環境認識ストラテジー (FVG Multi-Timeframe Environment)
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing) + 任意トリガー
//  ・環境認識     : 従来のEMAトレンド認識 + 新規 FVG環境認識 (日足/4H/1H/15M) を結合
//  ・場所条件     : WinZone(FVG/出来高/フィボ/EMA/水平線/トレンドライン/BB/H&S/…) は全て不使用
//  ・その他       : ボラフィルタ / リスク管理 / 時間帯フィルタ / Accumulation NoTrade を維持
//  ・Momentum(Stoch/MACD) / Intermarket(DXY/金利/Silver) は不使用
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "FVG Env Strategy",
     shorttitle        = "FVGENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 200
 )

// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 下位足トリガー確認 (OFF で request.security を呼ばない)
useLowerTFTrigger = input.bool(false, "下位足トリガー確認 (重い)")
triggerTF         = input.timeframe("5", "下位足TF")
triggerTFMode     = input.string("CurrentOnly", "現在足/下位足 結合", options = ["CurrentOnly", "LowerOnly", "CurrentAndLower", "CurrentOrLower"])

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
useOppositeTriggerNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useTrendEnv = input.bool(true, "トレンド環境認識(EMAスコア)を使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"])
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時")
slFixed     = input.float(12, "固定SL幅 (価格) ※固定時")
rrRatio     = input.float(1.0, "リスクリワード比 (TP)")

useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4f. 入力 : FVG 環境認識モジュール (日足 / 4H / 1H / 15M)
// ------------------------------------------------------------
//  上位足の「最新の有効な Bullish/Bearish FVG」を確定足のみで監視し、
//  FVG吸収のみから各足の優勢(1/0/-1)を判定 (反発 / iFVG は不使用)。
//  複数足を統合し、従来のトレンド環境認識(EMAスコア)と結合する。
//  ※ 非リペイント: request.security + lookahead_on + 確定1本前[1] を使用。
// ============================================================
grpEFVG = "FVG 環境認識"
useEFVGEnv = input.bool(false, "FVG環境認識を使う (重い/OFFで軽量)", group = grpEFVG)
// --- 対象時間足 (OFFにした足は request.security を呼ばない) ---
useEFVGDaily = input.bool(true, "日足FVGを使う", group = grpEFVG)
useEFVG4H    = input.bool(true, "4時間足FVGを使う", group = grpEFVG)
useEFVG1H    = input.bool(true, "1時間足FVGを使う", group = grpEFVG)
useEFVG15M   = input.bool(true, "15分足FVGを使う", group = grpEFVG)
efvgDailyTF = input.timeframe("D",   "日足TF", group = grpEFVG)
efvg4HTF    = input.timeframe("240", "4時間足TF", group = grpEFVG)
efvg1HTF    = input.timeframe("60",  "1時間足TF", group = grpEFVG)
efvg15MTF   = input.timeframe("15",  "15分足TF", group = grpEFVG)
// --- 状態保持本数 (各足の足数。イベント確定後この本数だけ優勢を保持) ---
efvgHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpEFVG)
efvgHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpEFVG)
efvgHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpEFVG)
efvgHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpEFVG)
// --- FVG / 吸収 パラメータ ---
//  吸収の最低条件は常に「終値でFVG全体を抜けること」。以下3条件は個別にON/OFF可能。
//   OFFにした条件は吸収判定に含めない (終値抜けだけの単純吸収まで緩められる)。
efvgMinThick   = input.float(0.10, "FVG最小厚み (幅/ATR)", step = 0.05, group = grpEFVG)
useAbsCandleColor = input.bool(true, "吸収: 方向と同じローソク色を要求", group = grpEFVG)
useAbsBodyFilter  = input.bool(true, "吸収: 最低実体率を要求", group = grpEFVG)
useAbsEdgeFilter  = input.bool(true, "吸収: 終値端寄せを要求", group = grpEFVG)
efvgAbsBodyMin = input.float(0.50, "吸収 実体最小比率", step = 0.05, group = grpEFVG)
efvgAbsEdge    = input.float(0.60, "吸収 終値端寄せ比率", step = 0.05, group = grpEFVG)
// --- 複数足 統合方式 ---
efvgIntegrationMode = input.string("WeightedScore", "統合方式", options = ["AllAgree", "MatchCount", "WeightedScore", "HTFPriority"], group = grpEFVG)
efvgReqMatch  = input.int(3, "必要一致足数 (MatchCount時)", minval = 1, maxval = 4, group = grpEFVG)
efvgWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpEFVG)
efvgWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpEFVG)
efvgWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpEFVG)
efvgWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpEFVG)
efvgScoreThresh = input.int(3, "スコア閾値 (±・WeightedScore時)", minval = 1, group = grpEFVG)
efvgMode4Allow  = input.bool(false, "HTF優先時 下位逆行でもエントリー許可 (falseでNoTrade)", group = grpEFVG)
// --- 表示 / デバッグ ---
efvgShowTable = input.bool(true,  "FVG環境テーブルを表示", group = grpEFVG)
efvgShowDebug = input.bool(false, "デバッグ(スコア/状態)を表示", group = grpEFVG)
efvgShowZones = input.bool(false, "選択中FVGの上下限を表示", group = grpEFVG)

// ============================================================
//  4g. 入力 : EMA 環境認識モジュール (50 / 200 / 1000 EMA)
// ------------------------------------------------------------
//  日足/4H/1H/15M の EMA状態 (パーフェクトオーダー / GC・DC保持 + 傾き減点) を
//  時間足の重みで加重合算し、EMAロング/ショート/イーブンを独立して返す。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。
// ============================================================
grpEEMA = "EMA 環境認識"
useEEMAEnv = input.bool(false, "EMA環境認識をエントリーに使う (OFFで既存挙動を維持)", group = grpEEMA)
// --- 対象時間足 (OFFにした足は request.security を呼ばない) ---
useEEMADaily = input.bool(true, "日足EMAを使う", group = grpEEMA)
useEEMA4H    = input.bool(true, "4時間足EMAを使う", group = grpEEMA)
useEEMA1H    = input.bool(true, "1時間足EMAを使う", group = grpEEMA)
useEEMA15M   = input.bool(true, "15分足EMAを使う", group = grpEEMA)
eemaDailyTF = input.timeframe("D",   "日足TF", group = grpEEMA)
eema4HTF    = input.timeframe("240", "4時間足TF", group = grpEEMA)
eema1HTF    = input.timeframe("60",  "1時間足TF", group = grpEEMA)
eema15MTF   = input.timeframe("15",  "15分足TF", group = grpEEMA)
// --- 時間足の重み (小数可・float) ---
eemaWeightD   = input.float(2.0, "重み 日足",  step = 0.1, group = grpEEMA)
eemaWeight4H  = input.float(1.5, "重み 4H",   step = 0.1, group = grpEEMA)
eemaWeight1H  = input.float(1.0, "重み 1H",   step = 0.1, group = grpEEMA)
eemaWeight15M = input.float(0.5, "重み 15M",  step = 0.1, group = grpEEMA)
// --- EMA長さ ---
eemaLenFast = input.int(50,   "短期EMA", minval = 1, group = grpEEMA)
eemaLenMid  = input.int(200,  "中期EMA", minval = 1, group = grpEEMA)
eemaLenSlow = input.int(1000, "長期EMA", minval = 1, group = grpEEMA)
// --- 点数 / 減点 ---
eemaPOScore  = input.float(4.0, "パーフェクトオーダー 点数", step = 0.5, group = grpEEMA)
eemaGCScore  = input.float(2.0, "GC/DC 点数", step = 0.5, group = grpEEMA)
eemaSlopePen = input.float(1.0, "傾き消失の減点", step = 0.5, group = grpEEMA)
// --- GC/DC 保持本数 (足ごと) ---
eemaHoldDaily = input.int(3,  "日足 GC/DC保持本数",  minval = 1, group = grpEEMA)
eemaHold4H    = input.int(6,  "4H GC/DC保持本数",   minval = 1, group = grpEEMA)
eemaHold1H    = input.int(12, "1H GC/DC保持本数",   minval = 1, group = grpEEMA)
eemaHold15M   = input.int(24, "15M GC/DC保持本数",  minval = 1, group = grpEEMA)
// --- 傾き判定 ---
eemaSlopeBars = input.int(3, "傾き判定本数", minval = 1, group = grpEEMA)
eemaSlopeMin  = input.float(0.0, "傾きの最低値 (価格)", step = 0.1, minval = 0.0, group = grpEEMA)
// --- 最終判定 ---
eemaThreshold = input.float(6.0, "EMA合計スコア閾値 (±・ロング/ショート共通)", step = 0.5, group = grpEEMA)
// --- 表示 ---
eemaShowTable = input.bool(true,  "EMA環境テーブルを表示", group = grpEEMA)
eemaShowDebug = input.bool(false, "EMAデバッグ表示", group = grpEEMA)

// ============================================================
//  4h. 入力 : Stochastic 環境認識モジュール (折り返しのみ)
// ------------------------------------------------------------
//  EMA環境認識と同じ設計。ストキャスの「折り返し」だけを評価する。
//    ・K が 10以下へ到達 → 上向き折り返し = +2 (Long)
//    ・K が 90以上へ到達 → 下向き折り返し = +2 (Short)
//  張り付き評価・マイナス点は無し。到達履歴は EMA と同じ状態管理で保持。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。
// ============================================================
grpEStoch = "Stochastic 環境認識"
useEStochEnv = input.bool(false, "Stochastic環境認識をエントリーに使う (OFFで既存挙動を維持)", group = grpEStoch)
// --- 対象時間足 (OFFにした足は request.security を呼ばない) ---
useEStochDaily = input.bool(true, "日足Stochを使う", group = grpEStoch)
useEStoch4H    = input.bool(true, "4時間足Stochを使う", group = grpEStoch)
useEStoch1H    = input.bool(true, "1時間足Stochを使う", group = grpEStoch)
useEStoch15M   = input.bool(true, "15分足Stochを使う", group = grpEStoch)
eStochDailyTF = input.timeframe("D",   "日足TF", group = grpEStoch)
eStoch4HTF    = input.timeframe("240", "4時間足TF", group = grpEStoch)
eStoch1HTF    = input.timeframe("60",  "1時間足TF", group = grpEStoch)
eStoch15MTF   = input.timeframe("15",  "15分足TF", group = grpEStoch)
// --- 時間足の重み (小数可・float) ---
eStochWeightD   = input.float(2.0, "重み 日足",  step = 0.1, group = grpEStoch)
eStochWeight4H  = input.float(1.5, "重み 4H",   step = 0.1, group = grpEStoch)
eStochWeight1H  = input.float(1.0, "重み 1H",   step = 0.1, group = grpEStoch)
eStochWeight15M = input.float(0.5, "重み 15M",  step = 0.1, group = grpEStoch)
// --- ストキャス設定 (%K Length / %K Smooth / %D Length) ---
eStochKLen    = input.int(21, "%K Length",   minval = 1, group = grpEStoch)
eStochKSmooth = input.int(3,  "%K Smooth",   minval = 1, group = grpEStoch)
eStochDLen    = input.int(3,  "%D Length",   minval = 1, group = grpEStoch)
// --- 折り返し判定 ---
stochArmLow   = input.float(9.0,  "Long 到達ライン",  group = grpEStoch)
stochExitLow  = input.float(10.0, "Long 脱出ライン",  group = grpEStoch)
stochArmHigh  = input.float(91.0, "Short 到達ライン", group = grpEStoch)
stochExitHigh = input.float(90.0, "Short 脱出ライン", group = grpEStoch)
useEStochKDConfirm = input.bool(false, "折り返しに K/D 位置も要求 (Long:K>D / Short:K<D)", group = grpEStoch)
eStochTurnScore    = input.float(2.0, "折り返し 点数", step = 0.5, group = grpEStoch)
eStochArmMaxBars   = input.int(3, "Extreme到達後 折り返し待機上限本数", minval = 1, group = grpEStoch)
// --- 状態保持本数 (足ごと。到達→折り返し確定後この本数だけ優勢を保持) ---
eStochHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpEStoch)
eStochHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpEStoch)
eStochHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpEStoch)
eStochHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpEStoch)
// --- 最終判定 ---
eStochScoreThreshold = input.float(6.0, "Stoch合計スコア閾値 (±・ロング/ショート共通)", step = 0.5, group = grpEStoch)
// --- 表示 ---
eStochShowTable = input.bool(true,  "Stoch環境テーブルを表示", group = grpEStoch)
eStochShowDebug = input.bool(false, "Stochデバッグ表示", group = grpEStoch)

// ============================================================
//  4i. 入力 : 三尊 / 逆三尊 環境認識モジュール (H&S WinZone とは別)
// ------------------------------------------------------------
//  三尊完成後のネックライン下抜け → 下降環境 / 逆三尊完成後の上抜け → 上昇環境。
//  ネックラインブレイク後、一定期間だけ方向バイアス(hsEnvBias)を保持する。
//  既存の H&S WinZone とは完全に独立 (接頭辞 hsEnv)。方向必須の環境フィルターとして接続。
//  非リペイント: request.security + lookahead_off + 上位足内 確定1本前[1]。
// ============================================================
grpHSEnv = "環境: 三尊 / 逆三尊"
useHSEnvEnv = input.bool(true, "三尊環境認識を使う", group = grpHSEnv)
useHSEnvD   = input.bool(true, "日足を使う", group = grpHSEnv)
useHSEnv4H  = input.bool(true, "4Hを使う",  group = grpHSEnv)
useHSEnv1H  = input.bool(true, "1Hを使う",  group = grpHSEnv)
useHSEnv15M = input.bool(true, "15Mを使う", group = grpHSEnv)
hsEnvDailyTF = input.timeframe("D",   "日足TF", group = grpHSEnv)
hsEnv4HTF    = input.timeframe("240", "4H TF",  group = grpHSEnv)
hsEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpHSEnv)
hsEnv15MTF   = input.timeframe("15",  "15M TF", group = grpHSEnv)
// --- 検知パラメータ (直近Nピボットを配列保持し、L-H-L-H-L 等の並びから最良候補を探索) ---
hsEnvPivotLen       = input.int(4, "Pivot Length", minval = 1, group = grpHSEnv)
hsEnvMaxPivots      = input.int(16, "保持Pivot数 (探索対象)", minval = 5, maxval = 24, group = grpHSEnv)
hsEnvNoiseATR       = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率", step = 0.05, group = grpHSEnv)
hsEnvHeadPromMult   = input.float(0.7, "頭と肩の最低差 ATR倍率", step = 0.1, group = grpHSEnv)
hsEnvShoulderATR    = input.float(1.5, "左右肩の価格差 ATR上限", step = 0.1, group = grpHSEnv)
hsEnvTimeRatioMin   = input.float(0.35, "肩の時間比 下限", step = 0.05, group = grpHSEnv)
hsEnvTimeRatioMax   = input.float(3.0,  "肩の時間比 上限", step = 0.1, group = grpHSEnv)
hsEnvNeckDiffATR    = input.float(2.0, "ネックライン高低差 ATR上限", step = 0.1, group = grpHSEnv)
hsEnvMinPatternBars = input.int(20,  "パターン最小横幅", minval = 1, group = grpHSEnv)
hsEnvMaxPatternBars = input.int(150, "パターン最大横幅", minval = 2, group = grpHSEnv)
hsEnvBreakBufferATR = input.float(0.05, "ネックラインブレイクのATRバッファ", step = 0.05, group = grpHSEnv)
hsEnvBreakMaxBars   = input.int(40, "右肩完成後のブレイク期限", minval = 1, group = grpHSEnv)
useHSEnvBodyFilter  = input.bool(true, "ブレイク実体率フィルターを使う", group = grpHSEnv)
hsEnvMinBodyRatio   = input.float(0.45, "最低ブレイク実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpHSEnv)
// --- 状態保持本数 (各足の足数) ---
hsEnvHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpHSEnv)
hsEnvHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpHSEnv)
hsEnvHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpHSEnv)
hsEnvHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpHSEnv)
// --- 統合方法 ---
hsEnvCombineMode = input.string("WeightedScore", "三尊環境の結合方法", options = ["HigherTF", "WeightedScore"], group = grpHSEnv)
hsEnvWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpHSEnv)
hsEnvWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpHSEnv)
hsEnvWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpHSEnv)
hsEnvWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpHSEnv)
hsEnvScoreThreshold = input.int(3, "WeightedScore 閾値 (±)", minval = 1, group = grpHSEnv)
// --- エントリー接続 (方向必須フィルター: EMA/FVG/Stochと同型) ---
useHSEnvBias = input.bool(false, "三尊方向バイアスを使う (OFFで既存挙動を維持)", group = grpHSEnv)
// --- 表示 ---
hsEnvShowTable  = input.bool(true,  "三尊環境テーブルを表示", group = grpHSEnv)
hsEnvShowDebug  = input.bool(false, "三尊環境デバッグ表示", group = grpHSEnv)
hsEnvShowLabels = input.bool(true, "採用パターンのラベルを表示 (LS/頭/RS/N1/N2)", group = grpHSEnv)
hsEnvLabelTF    = input.string("15M", "ラベル表示TF", options = ["D", "4H", "1H", "15M"], group = grpHSEnv)
// --- パターン視覚化 (描画のみ・検知/エントリーには一切影響しない。表示対象は hsEnvLabelTF を共用) ---
hsEnvShowPatternLines = input.bool(true, "三尊パターンラインを表示", group = grpHSEnv)
hsEnvShowNeckline     = input.bool(true,  "三尊ネックラインを表示", group = grpHSEnv)
hsEnvShowBreakLabel   = input.bool(true,  "三尊確定地点を表示", group = grpHSEnv)
hsEnvPatternLineWidth = input.int(2, "パターンライン太さ", minval = 1, maxval = 4, group = grpHSEnv)
hsEnvNeckLineWidth    = input.int(2, "ネックライン太さ", minval = 1, maxval = 4, group = grpHSEnv)

// ============================================================
//  4j. 入力 : Fib 環境認識モジュール (MTF・大きな波の押し/戻り評価)
// ------------------------------------------------------------
//  「現在の大きな波に対してどの程度 押し/戻し が入っているか」を評価する環境認識。
//  日足/4H/1H/15M を各足の中で独立して計算 (request.security)。Bull/Bear/Neutral の
//  1状態のみ保持し、小さな押し戻しで波を切り替えない。接頭辞 fibEnv。
//  ※ 今回は出力のみ。既存 canLong/canShort・環境スコア・アラートには接続しない。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。
// ============================================================
grpFibEnv = "Fib 環境認識 (MTF)"
useFibEnvEnv = input.bool(false, "Fib環境認識を使う (出力のみ)", group = grpFibEnv)
useFibEnvD   = input.bool(true, "日足を使う", group = grpFibEnv)
useFibEnvH4  = input.bool(true, "4Hを使う",  group = grpFibEnv)
useFibEnvH1  = input.bool(true, "1Hを使う",  group = grpFibEnv)
useFibEnvM15 = input.bool(true, "15Mを使う", group = grpFibEnv)
fibEnvDailyTF = input.timeframe("D",   "日足TF", group = grpFibEnv)
fibEnv4HTF    = input.timeframe("240", "4H TF",  group = grpFibEnv)
fibEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpFibEnv)
fibEnv15MTF   = input.timeframe("15",  "15M TF", group = grpFibEnv)
fibEnvAtrLen          = input.int(14, "Fib環境 ATR期間", minval = 1, group = grpFibEnv)
fibEnvSwingLen        = input.int(3,  "Fib環境 スイング検出 左右本数", minval = 1, group = grpFibEnv)
fibEnvMinSwingAtrMult = input.float(3.0, "Fib環境 最低波幅 (ATR倍)", minval = 0.1, step = 0.1, group = grpFibEnv)
// --- 時間足の重み (基礎点 × 重み。OFF足は合計に含めない) ---
fibEnvWeightD   = input.float(4.0, "日足 重み", step = 0.5, group = grpFibEnv)
fibEnvWeightH4  = input.float(3.0, "4H 重み",  step = 0.5, group = grpFibEnv)
fibEnvWeightH1  = input.float(2.0, "1H 重み",  step = 0.5, group = grpFibEnv)
fibEnvWeightM15 = input.float(1.0, "15M 重み", step = 0.5, group = grpFibEnv)
fibEnvScoreThreshold = input.float(6.0, "Fib環境 合計スコア閾値", minval = 0.0, step = 0.5, group = grpFibEnv)
fibEnvShowTable = input.bool(true, "Fib環境テーブルを表示", group = grpFibEnv)
fibEnvShowWeightedScore = input.bool(true, "Fib加重スコアを表示", group = grpFibEnv)
// --- エントリー接続 (OFF = 出力/表示のみ。既存バックテストを完全維持) ---
useFibEnvBias = input.bool(false, "Fib環境方向バイアスをエントリーに使う", group = grpFibEnv)

// ============================================================
//  4z. 入力 : Volume Breakout 環境認識 (MTF) 接頭辞 volEnv
// ------------------------------------------------------------
//  WinZone の「C: 出来高急増ブレイク」ロジックのみを使う環境認識。
//  ・上抜けブレイク → Bull / 下抜けブレイク → Bear を各時間足で一定本数保持。
//  ・A(POC定着)・B(POCリジェクト)・D(クライマックス) は使わない。
//  ・request.security(lookahead_off)＋上位足内 確定1本前[1] で非リペイント。
//  ・保持本数は各時間足のバー基準でカウント (チャート足では数えない)。
//  ・エントリー接続 : useVolEnvBias=ON で Bull環境=ロングのみ / Bear環境=
//    ショートのみ / Neutral=新規禁止 の方向フィルターになる (下記 8i / canLong)。
//    OFF なら テーブル・背景・アラートのみ動作し、エントリーには影響しない。
// ============================================================
grpVolEnv = "Volume Breakout 環境認識 (MTF)"
volumeEnvEnabled = input.bool(false, "Volume環境認識を使う (計算ON/OFF)", group = grpVolEnv)
useVolEnvD   = input.bool(true, "日足を使う", group = grpVolEnv)
useVolEnvH4  = input.bool(true, "4Hを使う",  group = grpVolEnv)
useVolEnvH1  = input.bool(true, "1Hを使う",  group = grpVolEnv)
useVolEnvM15 = input.bool(true, "15Mを使う", group = grpVolEnv)
volEnvDailyTF = input.timeframe("D",   "日足TF", group = grpVolEnv)
volEnv4HTF    = input.timeframe("240", "4H TF",  group = grpVolEnv)
volEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpVolEnv)
volEnv15MTF   = input.timeframe("15",  "15M TF", group = grpVolEnv)
// --- C: 出来高ブレイク パラメータ (元WinZoneロジックと同一) ---
volEnvBreakoutLookback  = input.int(20, "ブレイク 参照本数", minval = 1, group = grpVolEnv)
volEnvVolumeSmaLen      = input.int(20, "出来高SMA期間",     minval = 1, group = grpVolEnv)
volEnvVolumeSpikeMult   = input.float(1.5, "出来高急増 倍率", minval = 0.0, step = 0.1, group = grpVolEnv)
volEnvBodyRatioMin      = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpVolEnv)
volEnvAtrLen            = input.int(14, "ATR期間", minval = 1, group = grpVolEnv)
volEnvUseAtrExpansion   = input.bool(false, "ATR拡大フィルター", group = grpVolEnv)
volEnvAtrExpansionMult  = input.float(1.2, "ATR拡大 倍率", minval = 0.0, step = 0.05, group = grpVolEnv)
volEnvUseCompression    = input.bool(false, "圧縮→爆発フィルター", group = grpVolEnv)
volEnvCompressionLookback = input.int(10, "圧縮 参照本数", minval = 1, group = grpVolEnv)
volEnvCompressionATRMult  = input.float(1.0, "圧縮 レンジ <= ATR×", minval = 0.0, step = 0.1, group = grpVolEnv)
// --- 状態保持本数 (各時間足のバー基準。ブレイク後この本数だけ方向を保持) ---
volEnvHoldD   = input.int(10, "日足 保持本数", minval = 1, group = grpVolEnv)
volEnvHoldH4  = input.int(10, "4H 保持本数",  minval = 1, group = grpVolEnv)
volEnvHoldH1  = input.int(10, "1H 保持本数",  minval = 1, group = grpVolEnv)
volEnvHoldM15 = input.int(10, "15M 保持本数", minval = 1, group = grpVolEnv)
// --- 時間足の重み (Bull:+重み / Bear:-重み / Neutral:0) ---
volEnvWeightD   = input.float(4.0, "日足 重み", step = 0.5, group = grpVolEnv)
volEnvWeightH4  = input.float(3.0, "4H 重み",  step = 0.5, group = grpVolEnv)
volEnvWeightH1  = input.float(2.0, "1H 重み",  step = 0.5, group = grpVolEnv)
volEnvWeightM15 = input.float(1.0, "15M 重み", step = 0.5, group = grpVolEnv)
// --- 閾値 / 最低同方向時間足数 ---
volEnvBullThreshold = input.float(3.0,  "上昇判定閾値 (合計スコア >=)", step = 0.5, group = grpVolEnv)
volEnvBearThreshold = input.float(-3.0, "下降判定閾値 (合計スコア <=)", step = 0.5, group = grpVolEnv)
volEnvMinAlignedTF  = input.int(1, "最低同方向時間足数", minval = 1, maxval = 4, group = grpVolEnv)
// --- 表示 / 背景 ---
volEnvShowTable = input.bool(true,  "Volume環境テーブルを表示", group = grpVolEnv)
volEnvShowBG    = input.bool(false, "チャート背景に環境を表示", group = grpVolEnv)
// --- エントリー接続 (ON = 方向フィルターとして canLong/canShort に反映) ---
useVolEnvBias = input.bool(true, "Volume環境方向バイアスをエントリーに使う", group = grpVolEnv)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

bool finalBullTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur :
     triggerTFMode == "LowerOnly"       ? trigBullLower :
     triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBullCur or trigBullLower) :
     trigBullCur

bool finalBearTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur :
     triggerTFMode == "LowerOnly"       ? trigBearLower :
     triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBearCur or trigBearLower) :
     trigBearCur

bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

bool allowLongByTrigger  = enabledTrigCount == 0 ? true : (finalBullTrig and not trigNoTrade and trigCooldownOk)
bool allowShortByTrigger = enabledTrigCount == 0 ? true : (finalBearTrig and not trigNoTrade and trigCooldownOk)

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
//   request.security(..., f_envTrendConfirmed(...), lookahead = barmerge.lookahead_on)
//   と組み合わせると、形成途中の上位足ではなく「直近で確定した上位足」の判定を得られる。
//   ・lookahead_on だけでは未来参照になるが、[1] で確定済み1本前に固定するため未来参照は発生しない。
//   ・関数呼び出し結果への直接 [1] を避けるため、いったん変数に受けてから [1] を返す。
//   ・判定ロジック(f_envTrend)自体は不変。取得する足を確定足にするだけ。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useTrendEnv
    // 4H / 1H / 15M : 確定済み上位足のみ参照 (lookahead_on + 確定1本前 → 完全非リペイント)
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    // 5M / 1M : 現状の仕様を維持
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8f. FVG 環境認識モジュール 本体
// ------------------------------------------------------------
//  f_efvgState : 呼ばれた足(=上位足)のコンテキストで、最新の有効な
//    Bull/Bear FVG を1本ずつ保持し、FVG吸収のみから優勢を判定する。
//    (反発 / 包み足反発 / ピンバー反発 / iFVG / 逆リテストは一切使用しない)
//    吸収の方向定義は既存エンジンと同一:
//      ・Bearish FVG を終値で上抜け吸収 → Long優勢
//      ・Bullish FVG を終値で下抜け吸収 → Short優勢
//    各FVGにつき吸収は1回だけ。新FVG形成で吸収判定を再度可能にする。
//  戻り値 [bias, reason, remain, bullTop, bullBot, bearTop, bearBot]。
//    bias : 1=Long優勢 / 0=Even / -1=Short優勢
//    reason: 2=Bear吸収(Long) / -2=Bull吸収(Short) / 0=吸収なし
//    remain: 状態保持の残り本数
// ============================================================
f_efvgState(int holdBars, float minThickR, float absBodyMin, float absEdge) =>
    float _ref = ta.atr(14)
    var float _btop = na          // Bullish FVG 上端 (= low)
    var float _bbot = na          // Bullish FVG 下端 (= high[2])
    var int   _bbar = na
    var bool  _babs  = false       // Bullish FVG が吸収済み (重複防止)
    var float _rtop = na          // Bearish FVG 上端 (= low[2])
    var float _rbot = na          // Bearish FVG 下端 (= high)
    var int   _rbar = na
    var bool  _rabs  = false       // Bearish FVG が吸収済み (重複防止)
    var int   _bias   = 0
    var int   _reason = 0
    var int   _evbar  = na
    // --- ローソク指標 ---
    float _body = math.abs(close - open)
    float _rng  = high - low
    // --- FVG形成 (最新を1本だけ保持・吸収フラグをリセット) ---
    bool _newBull = _ref > 0 and low > high[2] and ((low - high[2]) / _ref) >= minThickR
    bool _newBear = _ref > 0 and high < low[2] and ((low[2] - high) / _ref) >= minThickR
    if _newBull
        _btop := low
        _bbot := high[2]
        _bbar := bar_index
        _babs := false
    if _newBear
        _rtop := low[2]
        _rbot := high
        _rbar := bar_index
        _rabs := false
    bool _bodyStrong  = _rng > 0 and (_body / _rng) >= absBodyMin
    bool _closeNearHi = _rng > 0 and (close - low) / _rng >= absEdge
    bool _closeNearLo = _rng > 0 and (high - close) / _rng >= absEdge
    // --- 吸収イベント (各FVG1回のみ) ---
    //   最低条件 = 終値でFVG全体を抜ける (Bear上端上抜け=Long / Bull下端下抜け=Short)。
    //   ローソク色 / 実体率 / 終値端寄せ は個別トグルで任意追加 (OFFなら条件から除外)。
    bool _absLong  = not na(_rtop) and not _rabs and bar_index > _rbar and close > _rtop and (not useAbsCandleColor or close > open) and (not useAbsBodyFilter or _bodyStrong) and (not useAbsEdgeFilter or _closeNearHi)
    bool _absShort = not na(_btop) and not _babs and bar_index > _bbar and close < _bbot and (not useAbsCandleColor or close < open) and (not useAbsBodyFilter or _bodyStrong) and (not useAbsEdgeFilter or _closeNearLo)
    // --- イベント確定 ---
    if _absLong and _absShort
        // 同時吸収 → 方向を予想せず Even (保持もクリア)。両FVGは使用済みに。
        _bias := 0
        _reason := 0
        _evbar := na
        _rabs := true
        _babs := true
    else if _absLong
        _bias := 1
        _reason := 2
        _evbar := bar_index
        _rabs := true
    else if _absShort
        _bias := -1
        _reason := -2
        _evbar := bar_index
        _babs := true
    // --- 状態保持 / 失効 (イベント足を1本目として数える: bar_index - evbar < holdBars) ---
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias   = _active ? _bias : 0
    int _outReason = _active ? _reason : 0
    int _outRemain = _active ? holdBars - (bar_index - _evbar) : 0
    [_outBias, _outReason, _outRemain, _btop, _bbot, _rtop, _rbot]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_efvgConfirmed(int holdBars, float minThickR, float absBodyMin, float absEdge) =>
    [_b, _r, _rem, _bt, _bb, _rt, _rb] = f_efvgState(holdBars, minThickR, absBodyMin, absEdge)
    [_b[1], _r[1], _rem[1], _bt[1], _bb[1], _rt[1], _rb[1]]

// --- テキスト変換 ---
f_efvgBiasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_efvgReasonText(int c) =>
    c == 2 ? "Bear FVG Absorption" : c == -2 ? "Bull FVG Absorption" : "No Absorption"

// --- 各足の確定FVG状態 (OFF足は request.security を呼ばない) ---
int efvgDBias = 0
int efvgDReason = 0
int efvgDRem = 0
int efvgHBias = 0
int efvgHReason = 0
int efvgHRem = 0
int efvgOBias = 0
int efvgOReason = 0
int efvgORem = 0
int efvgMBias = 0
int efvgMReason = 0
int efvgMRem = 0
float efvgDBT = na
float efvgDBB = na
float efvgDRT = na
float efvgDRB = na
float efvgHBT = na
float efvgHBB = na
float efvgHRT = na
float efvgHRB = na
float efvgOBT = na
float efvgOBB = na
float efvgORT = na
float efvgORB = na
float efvgMBT = na
float efvgMBB = na
float efvgMRT = na
float efvgMRB = na
if useEFVGEnv and useEFVGDaily
    [_b, _r, _rem, _bt, _bb, _rt, _rb] = request.security(syminfo.tickerid, efvgDailyTF, f_efvgConfirmed(efvgHoldDaily, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge), lookahead = barmerge.lookahead_on)
    efvgDBias := _b
    efvgDReason := _r
    efvgDRem := _rem
    efvgDBT := _bt
    efvgDBB := _bb
    efvgDRT := _rt
    efvgDRB := _rb
if useEFVGEnv and useEFVG4H
    [_b, _r, _rem, _bt, _bb, _rt, _rb] = request.security(syminfo.tickerid, efvg4HTF, f_efvgConfirmed(efvgHold4H, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge), lookahead = barmerge.lookahead_on)
    efvgHBias := _b
    efvgHReason := _r
    efvgHRem := _rem
    efvgHBT := _bt
    efvgHBB := _bb
    efvgHRT := _rt
    efvgHRB := _rb
if useEFVGEnv and useEFVG1H
    [_b, _r, _rem, _bt, _bb, _rt, _rb] = request.security(syminfo.tickerid, efvg1HTF, f_efvgConfirmed(efvgHold1H, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge), lookahead = barmerge.lookahead_on)
    efvgOBias := _b
    efvgOReason := _r
    efvgORem := _rem
    efvgOBT := _bt
    efvgOBB := _bb
    efvgORT := _rt
    efvgORB := _rb
if useEFVGEnv and useEFVG15M
    [_b, _r, _rem, _bt, _bb, _rt, _rb] = request.security(syminfo.tickerid, efvg15MTF, f_efvgConfirmed(efvgHold15M, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge), lookahead = barmerge.lookahead_on)
    efvgMBias := _b
    efvgMReason := _r
    efvgMRem := _rem
    efvgMBT := _bt
    efvgMBB := _bb
    efvgMRT := _rt
    efvgMRB := _rb

// --- 複数足 統合 (AllAgree / MatchCount / WeightedScore / HTFPriority) ---
int efvgEnabledCount = (useEFVGDaily ? 1 : 0) + (useEFVG4H ? 1 : 0) + (useEFVG1H ? 1 : 0) + (useEFVG15M ? 1 : 0)
// AllAgree
bool efvgAllLong  = efvgEnabledCount > 0 and (not useEFVGDaily or efvgDBias == 1) and (not useEFVG4H or efvgHBias == 1) and (not useEFVG1H or efvgOBias == 1) and (not useEFVG15M or efvgMBias == 1)
bool efvgAllShort = efvgEnabledCount > 0 and (not useEFVGDaily or efvgDBias == -1) and (not useEFVG4H or efvgHBias == -1) and (not useEFVG1H or efvgOBias == -1) and (not useEFVG15M or efvgMBias == -1)
// MatchCount
int efvgLongCnt  = (useEFVGDaily and efvgDBias == 1 ? 1 : 0) + (useEFVG4H and efvgHBias == 1 ? 1 : 0) + (useEFVG1H and efvgOBias == 1 ? 1 : 0) + (useEFVG15M and efvgMBias == 1 ? 1 : 0)
int efvgShortCnt = (useEFVGDaily and efvgDBias == -1 ? 1 : 0) + (useEFVG4H and efvgHBias == -1 ? 1 : 0) + (useEFVG1H and efvgOBias == -1 ? 1 : 0) + (useEFVG15M and efvgMBias == -1 ? 1 : 0)
bool efvgCntLong  = efvgLongCnt  >= efvgReqMatch
bool efvgCntShort = efvgShortCnt >= efvgReqMatch
// WeightedScore
int efvgScore = (useEFVGDaily ? efvgWeightD * efvgDBias : 0) + (useEFVG4H ? efvgWeight4H * efvgHBias : 0) + (useEFVG1H ? efvgWeight1H * efvgOBias : 0) + (useEFVG15M ? efvgWeight15M * efvgMBias : 0)
bool efvgScoreLong  = efvgScore >= efvgScoreThresh
bool efvgScoreShort = efvgScore <= -efvgScoreThresh
// HTFPriority (日足/4H を優先。下位足が逆行なら NoTrade 既定)
int efvgHtfScore = (useEFVGDaily ? efvgWeightD * efvgDBias : 0) + (useEFVG4H ? efvgWeight4H * efvgHBias : 0)
int efvgHtfDir = efvgHtfScore > 0 ? 1 : efvgHtfScore < 0 ? -1 : 0
bool efvgLoConflictLong  = (useEFVG1H and efvgOBias == -1) or (useEFVG15M and efvgMBias == -1)
bool efvgLoConflictShort = (useEFVG1H and efvgOBias == 1) or (useEFVG15M and efvgMBias == 1)
bool efvgHtfLong  = efvgHtfDir == 1 and (efvgMode4Allow or not efvgLoConflictLong)
bool efvgHtfShort = efvgHtfDir == -1 and (efvgMode4Allow or not efvgLoConflictShort)
// 最終 FVGバイアス
bool efvgBiasLong =
     efvgIntegrationMode == "AllAgree"     ? efvgAllLong :
     efvgIntegrationMode == "MatchCount"   ? efvgCntLong :
     efvgIntegrationMode == "WeightedScore" ? efvgScoreLong :
     efvgHtfLong
bool efvgBiasShort =
     efvgIntegrationMode == "AllAgree"     ? efvgAllShort :
     efvgIntegrationMode == "MatchCount"   ? efvgCntShort :
     efvgIntegrationMode == "WeightedScore" ? efvgScoreShort :
     efvgHtfShort
int efvgFinalBias = efvgBiasLong and not efvgBiasShort ? 1 : efvgBiasShort and not efvgBiasLong ? -1 : 0

// (環境認識の結合は EMA環境モジュールの後で allEnvLongOk / allEnvShortOk に一本化)

// ============================================================
//  8g. EMA 環境認識モジュール 本体 (50/200/1000 EMA)
// ------------------------------------------------------------
//  f_eemaState : 呼ばれた足(=上位足)コンテキストで EMA状態スコアを算出。
//    優先順位 = 1.パーフェクトオーダー > 2.GC/DC保持 > 3.方向なし。
//    PO成立中は GC/DC点を加算しない (同方向の二重評価を防止)。
//    傾きは加点に使わず、方向性に対して 50/200EMA の傾きが消えた分だけ 0方向へ減点。
//    1000EMA の傾きは評価しない。
//  戻り値 [score(float), reason(int)]。
//    reason: 2=上昇PO / 1=GC保持 / 0=方向なし / -1=DC保持 / -2=下降PO
// ============================================================
f_eemaState(int holdBars) =>
    float _e50   = ta.ema(close, eemaLenFast)
    float _e200  = ta.ema(close, eemaLenMid)
    float _e1000 = ta.ema(close, eemaLenSlow)
    // パーフェクトオーダー
    bool _upPO = _e50 > _e200 and _e200 > _e1000
    bool _dnPO = _e50 < _e200 and _e200 < _e1000
    // GC/DC (50 vs 200 のみ) を保持
    var int _gcBar = na
    var int _dcBar = na
    if ta.crossover(_e50, _e200)
        _gcBar := bar_index
    if ta.crossunder(_e50, _e200)
        _dcBar := bar_index
    bool _gcHeld = not na(_gcBar) and (bar_index - _gcBar) < holdBars
    bool _dcHeld = not na(_dcBar) and (bar_index - _dcBar) < holdBars
    bool _gcActive = _gcHeld and (na(_dcBar) or _gcBar >= _dcBar)
    bool _dcActive = _dcHeld and (na(_gcBar) or _dcBar >  _gcBar)
    // 傾き (50 / 200 のみ)
    float _s50  = _e50  - _e50[eemaSlopeBars]
    float _s200 = _e200 - _e200[eemaSlopeBars]
    bool _up50  = _s50  >  eemaSlopeMin
    bool _up200 = _s200 >  eemaSlopeMin
    bool _dn50  = _s50  < -eemaSlopeMin
    bool _dn200 = _s200 < -eemaSlopeMin
    float _score = 0.0
    int _reason = 0
    if _upPO
        _reason := 2
        _score := eemaPOScore
        if not _up50
            _score -= eemaSlopePen
        if not _up200
            _score -= eemaSlopePen
    else if _dnPO
        _reason := -2
        _score := -eemaPOScore
        if not _dn50
            _score += eemaSlopePen
        if not _dn200
            _score += eemaSlopePen
    else if _gcActive
        _reason := 1
        _score := eemaGCScore
        if not _up50
            _score -= eemaSlopePen
        if not _up200
            _score -= eemaSlopePen
    else if _dcActive
        _reason := -1
        _score := -eemaGCScore
        if not _dn50
            _score += eemaSlopePen
        if not _dn200
            _score += eemaSlopePen
    [_score, _reason]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_eemaConfirmed(int holdBars) =>
    [_s, _r] = f_eemaState(holdBars)
    [_s[1], _r[1]]

f_eemaReasonText(int c) =>
    c == 2 ? "Up PO" : c == 1 ? "GC Hold" : c == -1 ? "DC Hold" : c == -2 ? "Down PO" : "None"

// --- 各足の確定EMA状態 (エントリー使用 or テーブル表示時のみ算出。OFF足は呼ばない) ---
bool eemaCompute = useEEMAEnv or eemaShowTable
float eemaDScore = 0.0
int   eemaDReason = 0
float eemaHScore = 0.0
int   eemaHReason = 0
float eemaOScore = 0.0
int   eemaOReason = 0
float eemaMScore = 0.0
int   eemaMReason = 0
if eemaCompute and useEEMADaily
    [_s, _r] = request.security(syminfo.tickerid, eemaDailyTF, f_eemaConfirmed(eemaHoldDaily), lookahead = barmerge.lookahead_on)
    eemaDScore := _s
    eemaDReason := _r
if eemaCompute and useEEMA4H
    [_s, _r] = request.security(syminfo.tickerid, eema4HTF, f_eemaConfirmed(eemaHold4H), lookahead = barmerge.lookahead_on)
    eemaHScore := _s
    eemaHReason := _r
if eemaCompute and useEEMA1H
    [_s, _r] = request.security(syminfo.tickerid, eema1HTF, f_eemaConfirmed(eemaHold1H), lookahead = barmerge.lookahead_on)
    eemaOScore := _s
    eemaOReason := _r
if eemaCompute and useEEMA15M
    [_s, _r] = request.security(syminfo.tickerid, eema15MTF, f_eemaConfirmed(eemaHold15M), lookahead = barmerge.lookahead_on)
    eemaMScore := _s
    eemaMReason := _r

// --- 加重合算 → 最終EMAバイアス ---
float eemaDW = useEEMADaily ? eemaDScore * eemaWeightD   : 0.0
float eemaHW = useEEMA4H    ? eemaHScore * eemaWeight4H  : 0.0
float eemaOW = useEEMA1H    ? eemaOScore * eemaWeight1H  : 0.0
float eemaMW = useEEMA15M   ? eemaMScore * eemaWeight15M : 0.0
float eemaTotal = eemaDW + eemaHW + eemaOW + eemaMW
bool eemaBiasLong  = eemaTotal >= eemaThreshold
bool eemaBiasShort = eemaTotal <= -eemaThreshold
int eemaFinalBias = eemaBiasLong and not eemaBiasShort ? 1 : eemaBiasShort and not eemaBiasLong ? -1 : 0

// ============================================================
//  8g-2. Stochastic 環境認識モジュール 本体 (折り返しのみ)
// ------------------------------------------------------------
//  f_eStochState : 呼ばれた足(=上位足)コンテキストで %K/%D を算出し、
//    「10以下へ到達→上向き折り返し=Long / 90以上へ到達→下向き折り返し=Short」
//    のみをスコア化 (+eStochTurnScore)。張り付き・マイナス点は無し。
//    到達フラグは折り返し確定で消費し、再到達で再アーム (毎バー再発火しない)。
//  戻り値 [score(float), reason(int)]。 reason: 1=Long折返し / -1=Short折返し / 0=なし
// ============================================================
f_eStochState(int holdBars) =>
    float _rawK = ta.stoch(close, high, low, eStochKLen)
    float _k = ta.sma(_rawK, eStochKSmooth)
    float _d = ta.sma(_k, eStochDLen)
    var bool _lowArmed  = false
    var bool _highArmed = false
    var int  _lowArmBar  = na
    var int  _highArmBar = na
    var float _score  = 0.0
    var int   _reason = 0
    var int   _evbar  = na
    if _k <= stochArmLow
        _lowArmed := true
        _lowArmBar := bar_index
    if _k >= stochArmHigh
        _highArmed := true
        _highArmBar := bar_index
    // 到達から折り返しまでの待機上限を超えたら到達履歴を無効化
    if _lowArmed and bar_index - _lowArmBar > eStochArmMaxBars
        _lowArmed := false
        _lowArmBar := na
    if _highArmed and bar_index - _highArmBar > eStochArmMaxBars
        _highArmed := false
        _highArmBar := na
    // 折り返し = Extremeゾーンから脱出した瞬間 (armed 中に K が Extreme を上抜け/下抜け)
    bool _turnUp = _lowArmed  and _k >= stochExitLow  and _k[1] < stochExitLow  and (not useEStochKDConfirm or _k > _d)
    bool _turnDn = _highArmed and _k <= stochExitHigh and _k[1] > stochExitHigh and (not useEStochKDConfirm or _k < _d)
    if _turnUp and not _turnDn
        _score := eStochTurnScore
        _reason := 1
        _evbar := bar_index
        // 成立側の到達履歴 + 逆側の古い到達履歴を同時にリセット
        _lowArmed := false
        _lowArmBar := na
        _highArmed := false
        _highArmBar := na
    else if _turnDn and not _turnUp
        _score := eStochTurnScore
        _reason := -1
        _evbar := bar_index
        _highArmed := false
        _highArmBar := na
        _lowArmed := false
        _lowArmBar := na
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    float _outScore  = _active ? (_reason == 1 ? _score : -_score) : 0.0
    int   _outReason = _active ? _reason : 0
    [_outScore, _outReason]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_eStochConfirmed(int holdBars) =>
    [_s, _r] = f_eStochState(holdBars)
    [_s[1], _r[1]]

f_eStochReasonText(int c) =>
    c == 1 ? "Long Turn (OS)" : c == -1 ? "Short Turn (OB)" : "No Turn"

// --- 各足の確定Stoch状態 (エントリー使用 or テーブル表示時のみ算出。OFF足は呼ばない) ---
bool eStochCompute = useEStochEnv or eStochShowTable
float eStochDScore = 0.0
int   eStochDReason = 0
float eStochHScore = 0.0
int   eStochHReason = 0
float eStochOScore = 0.0
int   eStochOReason = 0
float eStochMScore = 0.0
int   eStochMReason = 0
if eStochCompute and useEStochDaily
    [_s, _r] = request.security(syminfo.tickerid, eStochDailyTF, f_eStochConfirmed(eStochHoldDaily), lookahead = barmerge.lookahead_on)
    eStochDScore := _s
    eStochDReason := _r
if eStochCompute and useEStoch4H
    [_s, _r] = request.security(syminfo.tickerid, eStoch4HTF, f_eStochConfirmed(eStochHold4H), lookahead = barmerge.lookahead_on)
    eStochHScore := _s
    eStochHReason := _r
if eStochCompute and useEStoch1H
    [_s, _r] = request.security(syminfo.tickerid, eStoch1HTF, f_eStochConfirmed(eStochHold1H), lookahead = barmerge.lookahead_on)
    eStochOScore := _s
    eStochOReason := _r
if eStochCompute and useEStoch15M
    [_s, _r] = request.security(syminfo.tickerid, eStoch15MTF, f_eStochConfirmed(eStochHold15M), lookahead = barmerge.lookahead_on)
    eStochMScore := _s
    eStochMReason := _r

// --- 加重合算 → 最終Stochバイアス ---
float eStochDW = useEStochDaily ? eStochDScore * eStochWeightD   : 0.0
float eStochHW = useEStoch4H    ? eStochHScore * eStochWeight4H  : 0.0
float eStochOW = useEStoch1H    ? eStochOScore * eStochWeight1H  : 0.0
float eStochMW = useEStoch15M   ? eStochMScore * eStochWeight15M : 0.0
float eStochTotal = eStochDW + eStochHW + eStochOW + eStochMW
bool eStochBiasLong  = eStochTotal >= eStochScoreThreshold
bool eStochBiasShort = eStochTotal <= -eStochScoreThreshold
int eStochFinalBias = eStochBiasLong and not eStochBiasShort ? 1 : eStochBiasShort and not eStochBiasLong ? -1 : 0

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  各環境モジュールを個別の使用ON/OFFで管理し、ONのモジュールをすべて
//  通過した場合のみエントリー許可。OFFのモジュールは常に通過扱い。
//  今後モジュールを増やす場合も「xxxLongOk = not useXxxEnv or xxxBiasLong」を
//  1行足して allEnvLongOk / allEnvShortOk の and に加えるだけで拡張できる。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool fvgLongOk   = not useEFVGEnv  or efvgBiasLong
bool emaLongOk   = not useEEMAEnv  or eemaBiasLong
bool stochLongOk = not useEStochEnv or eStochBiasLong
bool allEnvLongOk =
     trendLongOk and
     fvgLongOk and
     emaLongOk and
     stochLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool fvgShortOk   = not useEFVGEnv  or efvgBiasShort
bool emaShortOk   = not useEEMAEnv  or eemaBiasShort
bool stochShortOk = not useEStochEnv or eStochBiasShort
bool allEnvShortOk =
     trendShortOk and
     fvgShortOk and
     emaShortOk and
     stochShortOk

// ============================================================
//  8i. 三尊 / 逆三尊 環境認識モジュール 本体 (H&S WinZone とは別)
// ------------------------------------------------------------
//  f_hsEnvState : 呼ばれた足(=上位足)コンテキストで、直近複数Pivotを配列保持し、
//    L-H-L-H-L (三尊は H-L-H-L-H) の全候補を探索して最良候補を採用。ネックライン(斜め線)を
//    現在バーへ延長し、± ATRバッファ を終値ブレイクした時点で方向を確定
//    (三尊下抜け=-1 / 逆三尊上抜け=+1)。holdBars 本だけ保持し失効で0。
//    同一パターンでは再更新しない (新Pivot形成で再探索)。反対確定で即上書き。
//  戻り値 tuple (bias, 採用5点の価格/時刻, スコア, 横幅, 時間比, 肩差ATR, 頭突出ATR, ネック差ATR, 不採用理由)。
// ============================================================
// Pivot を配列へ追加 (同方向連続は極値のみ残す / 前Pivotから ATR×hsEnvNoiseATR 未満はノイズ除外 / 上限で最古を捨てる)
f_hsEnvPush(array<float> _pr, array<int> _bar, array<int> _tm, array<bool> _hi, float _price, int _b, int _t, bool _isHigh, float _atr) =>
    int _n = array.size(_pr)
    if _n == 0
        array.push(_pr, _price)
        array.push(_bar, _b)
        array.push(_tm, _t)
        array.push(_hi, _isHigh)
    else
        bool _lastHigh = array.get(_hi, _n - 1)
        if _isHigh == _lastHigh
            float _lastP = array.get(_pr, _n - 1)
            if (_isHigh and _price > _lastP) or (not _isHigh and _price < _lastP)
                array.set(_pr, _n - 1, _price)
                array.set(_bar, _n - 1, _b)
                array.set(_tm, _n - 1, _t)
        else
            float _lastP = array.get(_pr, _n - 1)
            if math.abs(_price - _lastP) >= _atr * hsEnvNoiseATR
                array.push(_pr, _price)
                array.push(_bar, _b)
                array.push(_tm, _t)
                array.push(_hi, _isHigh)
    while array.size(_pr) > hsEnvMaxPivots
        array.shift(_pr)
        array.shift(_bar)
        array.shift(_tm)
        array.shift(_hi)

// 配列内から H&S / 逆H&S の最良候補インデックスを探索。inv=true→逆三尊(肩/頭=安値, ネック=高値)。
//   戻り値 [lsIdx, hdIdx, rsIdx, n1Idx, n2Idx] (未検出は全て -1)。
f_hsFindHS(array<float> _pr, array<int> _bar, array<bool> _hi, float _atr, bool _inv) =>
    int _n = array.size(_pr)
    float _best = -1e18
    int _rLs = -1
    int _rHd = -1
    int _rRs = -1
    int _rN1 = -1
    int _rN2 = -1
    int   _rejCode = 0
    float _rejProm = -1e18
    if _n >= 5 and _atr > 0
        // 頭は両側に「肩+ネック」を置ける範囲のみ (_h>=2 かつ _h<=_n-3)。開始>終了のforは実行されない。
        for _h = 2 to _n - 3
            if array.get(_hi, _h) != _inv
                float _hdP = array.get(_pr, _h)
                int   _hdB = array.get(_bar, _h)
                // 左肩は _h-2 まで / 右肩は _h+2 から (間にネック候補が1つ以上入る)
                for _i = 0 to _h - 2
                    if array.get(_hi, _i) != _inv
                        for _j = _h + 2 to _n - 1
                            if array.get(_hi, _j) != _inv
                                float _lsP = array.get(_pr, _i)
                                float _rsP = array.get(_pr, _j)
                                int   _lsB = array.get(_bar, _i)
                                int   _rsB = array.get(_bar, _j)
                                int   _n1 = -1
                                float _n1P = na
                                if _i + 1 <= _h - 1
                                    for _a = _i + 1 to _h - 1
                                        if array.get(_hi, _a) == _inv
                                            float _v = array.get(_pr, _a)
                                            if _n1 == -1 or (_inv ? _v > _n1P : _v < _n1P)
                                                _n1 := _a
                                                _n1P := _v
                                int   _n2 = -1
                                float _n2P = na
                                if _h + 1 <= _j - 1
                                    for _a = _h + 1 to _j - 1
                                        if array.get(_hi, _a) == _inv
                                            float _v = array.get(_pr, _a)
                                            if _n2 == -1 or (_inv ? _v > _n2P : _v < _n2P)
                                                _n2 := _a
                                                _n2P := _v
                                if _n1 != -1 and _n2 != -1
                                    float _avgSh = (_lsP + _rsP) / 2.0
                                    float _prom  = _inv ? (_avgSh - _hdP) : (_hdP - _avgSh)
                                    // ヘッドが両肩より個別に外側にあること (必須)
                                    bool  _headPosOk = _inv ? (_hdP < _lsP and _hdP < _rsP) : (_hdP > _lsP and _hdP > _rsP)
                                    bool  _promOk = _prom >= _atr * hsEnvHeadPromMult
                                    bool  _symOk  = math.abs(_lsP - _rsP) <= _atr * hsEnvShoulderATR
                                    float _t1 = _hdB - _lsB
                                    float _t2 = _rsB - _hdB
                                    bool  _timeOk = _t1 > 0 and _t2 > 0 and (_t1 / _t2) >= hsEnvTimeRatioMin and (_t1 / _t2) <= hsEnvTimeRatioMax
                                    // ネックライン高低差が極端でないこと (必須)
                                    bool  _neckOk = math.abs(_n1P - _n2P) <= _atr * hsEnvNeckDiffATR
                                    // パターン横幅が範囲内であること (必須)
                                    int   _patBars = _rsB - _lsB
                                    bool  _widthOk = _patBars >= hsEnvMinPatternBars and _patBars <= hsEnvMaxPatternBars
                                    bool  _allOk = _headPosOk and _promOk and _symOk and _timeOk and _neckOk and _widthOk
                                    if _allOk
                                        float _midW = (hsEnvMinPatternBars + hsEnvMaxPatternBars) / 2.0
                                        float _rngW = math.max(hsEnvMaxPatternBars - hsEnvMinPatternBars, 1)
                                        // 頭突出↑ / 肩差↓ / 時間差↓ / ネック差↓ / 横幅の極端さ↓ を加点
                                        float _sc = _prom / _atr - math.abs(_lsP - _rsP) / _atr - math.abs(_t1 - _t2) / math.max(_t1 + _t2, 1.0) * 2.0 - math.abs(_n1P - _n2P) / _atr - math.abs(_patBars - _midW) / _rngW
                                        if _sc > _best
                                            _best := _sc
                                            _rLs := _i
                                            _rHd := _h
                                            _rRs := _j
                                            _rN1 := _n1
                                            _rN2 := _n2
                                    else if _prom > _rejProm
                                        // 不採用理由: 突出が最大の失敗候補を代表として記録 (優先順)
                                        _rejProm := _prom
                                        _rejCode := not _headPosOk ? 1 : not _promOk ? 2 : not _symOk ? 3 : not _timeOk ? 4 : not _neckOk ? 5 : 6
    float _outSc = _best <= -1e17 ? na : _best
    [_rLs, _rHd, _rRs, _rN1, _rN2, _outSc, _rejCode]

f_hsEnvState(int holdBars) =>
    float _atr = ta.atr(14)
    float _ph = ta.pivothigh(hsEnvPivotLen, hsEnvPivotLen)
    float _pl = ta.pivotlow(hsEnvPivotLen, hsEnvPivotLen)
    var array<float> _pPr   = array.new_float()
    var array<int>   _pBar  = array.new_int()
    var array<int>   _pTime = array.new_int()
    var array<bool>  _pHigh = array.new_bool()
    // 採用中の 逆三尊(up) / 三尊(dn) パターン (価格/時刻=ラベル用, bar=ネックライン傾き用)
    var bool  _upReady = false
    var bool  _upConsumed = false
    var int   _upHdBar = na
    var float _upLsP = na
    var int   _upLsT = na
    var float _upHdP = na
    var int   _upHdT = na
    var float _upRsP = na
    var int   _upRsT = na
    var float _upN1P = na
    var int   _upN1T = na
    var int   _upN1B = na
    var float _upN2P = na
    var int   _upN2T = na
    var int   _upN2B = na
    var bool  _dnReady = false
    var bool  _dnConsumed = false
    var int   _dnHdBar = na
    var float _dnLsP = na
    var int   _dnLsT = na
    var float _dnHdP = na
    var int   _dnHdT = na
    var float _dnRsP = na
    var int   _dnRsT = na
    var float _dnN1P = na
    var int   _dnN1T = na
    var int   _dnN1B = na
    var float _dnN2P = na
    var int   _dnN2T = na
    var int   _dnN2B = na
    var int   _upLsBar = na
    var int   _upRsBar = na
    var float _upScoreV = na
    var int   _upRej = 0
    var int   _dnLsBar = na
    var int   _dnRsBar = na
    var float _dnScoreV = na
    var int   _dnRej = 0
    var int   _bias  = 0
    var int   _evbar = na
    // 確定地点 (実際にブレイクが確定した上位足の時刻/価格を保持。チャート描画で使用)
    var int   _evtime  = na
    var float _evprice = na
    bool _newPivot = not na(_ph) or not na(_pl)
    if not na(_ph)
        f_hsEnvPush(_pPr, _pBar, _pTime, _pHigh, _ph, bar_index - hsEnvPivotLen, time[hsEnvPivotLen], true, _atr)
    if not na(_pl)
        f_hsEnvPush(_pPr, _pBar, _pTime, _pHigh, _pl, bar_index - hsEnvPivotLen, time[hsEnvPivotLen], false, _atr)
    // 新Pivotのたびに両方向を再探索し、採用候補を更新 (古い候補は残さない)
    if _newPivot
        // 配列サイズ整合 (push/shiftは同時実行だが念のため検証)
        int  _hsSz = array.size(_pPr)
        bool _hsSzOk = array.size(_pBar) == _hsSz and array.size(_pTime) == _hsSz and array.size(_pHigh) == _hsSz
        [_uLs, _uHd, _uRs, _uN1, _uN2, _uSc, _uRj] = f_hsFindHS(_pPr, _pBar, _pHigh, _atr, true)
        _upRej := _uRj
        _upReady := false
        // 使用する全インデックスが [0, size) の範囲内のときだけ array.get を実行
        bool _upIdxOk = _hsSzOk and _uLs >= 0 and _uLs < _hsSz and _uHd >= 0 and _uHd < _hsSz and _uRs >= 0 and _uRs < _hsSz and _uN1 >= 0 and _uN1 < _hsSz and _uN2 >= 0 and _uN2 < _hsSz
        if _upIdxOk
            int _hb = array.get(_pBar, _uHd)
            if _hb != _upHdBar
                _upConsumed := false
            _upHdBar := _hb
            _upLsP := array.get(_pPr, _uLs)
            _upLsT := array.get(_pTime, _uLs)
            _upLsBar := array.get(_pBar, _uLs)
            _upHdP := array.get(_pPr, _uHd)
            _upHdT := array.get(_pTime, _uHd)
            _upRsP := array.get(_pPr, _uRs)
            _upRsT := array.get(_pTime, _uRs)
            _upRsBar := array.get(_pBar, _uRs)
            _upN1P := array.get(_pPr, _uN1)
            _upN1T := array.get(_pTime, _uN1)
            _upN1B := array.get(_pBar, _uN1)
            _upN2P := array.get(_pPr, _uN2)
            _upN2T := array.get(_pTime, _uN2)
            _upN2B := array.get(_pBar, _uN2)
            _upScoreV := _uSc
            _upReady := true
        [_dLs, _dHd, _dRs, _dN1, _dN2, _dSc, _dRj] = f_hsFindHS(_pPr, _pBar, _pHigh, _atr, false)
        _dnRej := _dRj
        _dnReady := false
        // 使用する全インデックスが [0, size) の範囲内のときだけ array.get を実行
        bool _dnIdxOk = _hsSzOk and _dLs >= 0 and _dLs < _hsSz and _dHd >= 0 and _dHd < _hsSz and _dRs >= 0 and _dRs < _hsSz and _dN1 >= 0 and _dN1 < _hsSz and _dN2 >= 0 and _dN2 < _hsSz
        if _dnIdxOk
            int _hbd = array.get(_pBar, _dHd)
            if _hbd != _dnHdBar
                _dnConsumed := false
            _dnHdBar := _hbd
            _dnLsP := array.get(_pPr, _dLs)
            _dnLsT := array.get(_pTime, _dLs)
            _dnLsBar := array.get(_pBar, _dLs)
            _dnHdP := array.get(_pPr, _dHd)
            _dnHdT := array.get(_pTime, _dHd)
            _dnRsP := array.get(_pPr, _dRs)
            _dnRsT := array.get(_pTime, _dRs)
            _dnRsBar := array.get(_pBar, _dRs)
            _dnN1P := array.get(_pPr, _dN1)
            _dnN1T := array.get(_pTime, _dN1)
            _dnN1B := array.get(_pBar, _dN1)
            _dnN2P := array.get(_pPr, _dN2)
            _dnN2T := array.get(_pTime, _dN2)
            _dnN2B := array.get(_pBar, _dN2)
            _dnScoreV := _dSc
            _dnReady := true
    // ネックラインを斜め線として現在バーへ延長し、終値ブレイク + 実体率 + 方向ローソク + 右肩後ブレイク期限で確定
    float _bodyRatio = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool _bodyOk = not useHSEnvBodyFilter or _bodyRatio >= hsEnvMinBodyRatio
    float _neckUp = (_upReady and not na(_upN1B) and not na(_upN2B) and _upN2B != _upN1B) ? _upN1P + (_upN2P - _upN1P) / (_upN2B - _upN1B) * (bar_index - _upN1B) : na
    float _neckDn = (_dnReady and not na(_dnN1B) and not na(_dnN2B) and _dnN2B != _dnN1B) ? _dnN1P + (_dnN2P - _dnN1P) / (_dnN2B - _dnN1B) * (bar_index - _dnN1B) : na
    bool _breakTimeUpOk = not na(_upRsBar) and (bar_index - _upRsBar) <= hsEnvBreakMaxBars
    bool _breakTimeDnOk = not na(_dnRsBar) and (bar_index - _dnRsBar) <= hsEnvBreakMaxBars
    bool _buyConfirm  = _upReady and not _upConsumed and _breakTimeUpOk and not na(_neckUp) and close > _neckUp + _atr * hsEnvBreakBufferATR and close > open and _bodyOk
    bool _sellConfirm = _dnReady and not _dnConsumed and _breakTimeDnOk and not na(_neckDn) and close < _neckDn - _atr * hsEnvBreakBufferATR and close < open and _bodyOk
    if _buyConfirm and not _sellConfirm
        _bias := 1
        _evbar := bar_index
        _evtime := time
        _evprice := close
        _upConsumed := true
    else if _sellConfirm and not _buyConfirm
        _bias := -1
        _evbar := bar_index
        _evtime := time
        _evprice := close
        _dnConsumed := true
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _out = _active ? _bias : 0
    // ラベル用: 採用方向(=_out)のパターン5点
    float _aLsP = _out == 1 ? _upLsP : _out == -1 ? _dnLsP : na
    int   _aLsT = _out == 1 ? _upLsT : _out == -1 ? _dnLsT : na
    float _aHdP = _out == 1 ? _upHdP : _out == -1 ? _dnHdP : na
    int   _aHdT = _out == 1 ? _upHdT : _out == -1 ? _dnHdT : na
    float _aRsP = _out == 1 ? _upRsP : _out == -1 ? _dnRsP : na
    int   _aRsT = _out == 1 ? _upRsT : _out == -1 ? _dnRsT : na
    float _aN1P = _out == 1 ? _upN1P : _out == -1 ? _dnN1P : na
    int   _aN1T = _out == 1 ? _upN1T : _out == -1 ? _dnN1T : na
    float _aN2P = _out == 1 ? _upN2P : _out == -1 ? _dnN2P : na
    int   _aN2T = _out == 1 ? _upN2T : _out == -1 ? _dnN2T : na
    // デバッグ用メトリクス (採用方向の候補から算出)
    int   _aLsB = _out == 1 ? _upLsBar : _out == -1 ? _dnLsBar : na
    int   _aHdB = _out == 1 ? _upHdBar : _out == -1 ? _dnHdBar : na
    int   _aRsB = _out == 1 ? _upRsBar : _out == -1 ? _dnRsBar : na
    float _mScore = _out == 1 ? _upScoreV : _out == -1 ? _dnScoreV : na
    int   _mPat   = (not na(_aRsB) and not na(_aLsB)) ? _aRsB - _aLsB : na
    float _mTime  = (not na(_aHdB) and not na(_aLsB) and not na(_aRsB) and (_aRsB - _aHdB) != 0) ? (_aHdB - _aLsB) / math.max(_aRsB - _aHdB, 1) : na
    float _mShDf  = (not na(_aLsP) and not na(_aRsP) and _atr > 0) ? math.abs(_aLsP - _aRsP) / _atr : na
    float _mProm  = (not na(_aHdP) and not na(_aLsP) and not na(_aRsP) and _atr > 0) ? math.abs((_aLsP + _aRsP) / 2.0 - _aHdP) / _atr : na
    float _mNeck  = (not na(_aN1P) and not na(_aN2P) and _atr > 0) ? math.abs(_aN1P - _aN2P) / _atr : na
    // 不採用理由 (採用時は0)。ブレイク期限切れ=7を優先、次に構造探索の失敗理由。
    int _rejOut = _out != 0 ? 0 : (_upReady and not _upConsumed and not _breakTimeUpOk) or (_dnReady and not _dnConsumed and not _breakTimeDnOk) ? 7 : _upRej != 0 ? _upRej : _dnRej
    // パターン種別 (採用パターンの種別。bias とは別に保持: 1=逆三尊 / -1=三尊 / 0=候補なし)。
    //   採用5点(_aLsP…)と同じ _out に連動するため、描画側は5点が揃うとき常に種別を判定できる。
    int   _patType = _out
    // 確定地点 (実際に上位足でブレイクが確定した足の時刻/価格。保持中のみ有効・失効時は na)。
    int   _evTimeOut  = _active ? _evtime  : na
    float _evPriceOut = _active ? _evprice : na
    // --- 描画用 候補 (ネックラインブレイク前の未消費 _upReady/_dnReady を選択) ---
    //   候補種別 : 1=逆三尊候補 / -1=三尊候補 / 0=候補なし (bias・_out とは独立)。
    //   両方向とも候補あり → 候補探索スコアが高い方 / 同点 → 右肩(RS)が新しい方を採用。
    //   ※ 検知・スコアリング・ブレイク条件・状態には一切干渉しない (表示専用の派生出力)。
    bool  _upCand = _upReady and not _upConsumed
    bool  _dnCand = _dnReady and not _dnConsumed
    float _upSc = nz(_upScoreV, -1e18)
    float _dnSc = nz(_dnScoreV, -1e18)
    int   _candType = 0
    if _upCand and _dnCand
        _candType := _upSc > _dnSc ? 1 : _upSc < _dnSc ? -1 : (nz(_upRsBar, -1) >= nz(_dnRsBar, -1) ? 1 : -1)
    else if _upCand
        _candType := 1
    else if _dnCand
        _candType := -1
    float _cLsP = _candType == 1 ? _upLsP : _candType == -1 ? _dnLsP : na
    int   _cLsT = _candType == 1 ? _upLsT : _candType == -1 ? _dnLsT : na
    float _cHdP = _candType == 1 ? _upHdP : _candType == -1 ? _dnHdP : na
    int   _cHdT = _candType == 1 ? _upHdT : _candType == -1 ? _dnHdT : na
    float _cRsP = _candType == 1 ? _upRsP : _candType == -1 ? _dnRsP : na
    int   _cRsT = _candType == 1 ? _upRsT : _candType == -1 ? _dnRsT : na
    float _cN1P = _candType == 1 ? _upN1P : _candType == -1 ? _dnN1P : na
    int   _cN1T = _candType == 1 ? _upN1T : _candType == -1 ? _dnN1T : na
    float _cN2P = _candType == 1 ? _upN2P : _candType == -1 ? _dnN2P : na
    int   _cN2T = _candType == 1 ? _upN2T : _candType == -1 ? _dnN2T : na
    [_out, _aLsP, _aLsT, _aHdP, _aHdT, _aRsP, _aRsT, _aN1P, _aN1T, _aN2P, _aN2T, _mScore, _mPat, _mTime, _mShDf, _mProm, _mNeck, _rejOut, _patType, _evTimeOut, _evPriceOut, _candType, _cLsP, _cLsT, _cHdP, _cHdT, _cRsP, _cRsT, _cN1P, _cN1T, _cN2P, _cN2T]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助 (lookahead_on + [1] = FVG/EMA/Stochと統一)。
f_hsEnvConfirmed(int holdBars) =>
    [_b, _lp, _lt, _hp, _ht, _rp, _rt, _p1, _t1, _p2, _t2, _sc, _pb, _tr, _sd, _pr, _nd, _rj, _pt, _et, _ep, _ct, _clp, _clt, _chp, _cht, _crp, _crt, _cn1p, _cn1t, _cn2p, _cn2t] = f_hsEnvState(holdBars)
    [_b[1], _lp[1], _lt[1], _hp[1], _ht[1], _rp[1], _rt[1], _p1[1], _t1[1], _p2[1], _t2[1], _sc[1], _pb[1], _tr[1], _sd[1], _pr[1], _nd[1], _rj[1], _pt[1], _et[1], _ep[1], _ct[1], _clp[1], _clt[1], _chp[1], _cht[1], _crp[1], _crt[1], _cn1p[1], _cn1t[1], _cn2p[1], _cn2t[1]]

f_hsEnvRejText(int c) =>
    c == 1 ? "HEAD_POSITION" : c == 2 ? "HEAD_PROMINENCE" : c == 3 ? "SHOULDER_DIFF" : c == 4 ? "TIME_RATIO" : c == 5 ? "NECK_SLOPE" : c == 6 ? "PATTERN_WIDTH" : c == 7 ? "BREAK_TIMEOUT" : "-"

f_hsEnvText(int b) =>
    b == 1 ? "逆三尊 / UP" : b == -1 ? "三尊 / DOWN" : "中立 / EVEN"
f_hsEnvColor(int b, bool on) =>
    not on ? color.new(color.black, 0) : b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- 各足の確定 三尊環境状態 (使用 or 表示時のみ算出。OFF足は request.security を呼ばない) ---
//   描画トグル (ライン/ネックライン/確定ラベル) も算出トリガーに含める。ただしこれらは
//   すべて表示専用で、hsEnvBias→canLong/canShort へは接続しない (バックテスト不変)。
bool hsEnvWantDraw = hsEnvShowLabels or hsEnvShowPatternLines or hsEnvShowNeckline or hsEnvShowBreakLabel
bool hsEnvCompute = useHSEnvEnv and (useHSEnvBias or hsEnvShowTable or hsEnvWantDraw)
int hsEnvD   = 0
int hsEnv4H  = 0
int hsEnv1H  = 0
int hsEnv15M = 0
// 各足の不採用理由コード (デバッグ)
int hsRejD   = 0
int hsRej4H  = 0
int hsRej1H  = 0
int hsRej15M = 0
// ラベル用: 採用パターン5点 + メトリクス (hsEnvLabelTF の足の分だけ取得)
float hsLblLsP = na
int   hsLblLsT = na
float hsLblHdP = na
int   hsLblHdT = na
float hsLblRsP = na
int   hsLblRsT = na
float hsLblN1P = na
int   hsLblN1T = na
float hsLblN2P = na
int   hsLblN2T = na
float hsDbgScore = na
int   hsDbgPat   = na
float hsDbgTime  = na
float hsDbgShDf  = na
float hsDbgProm  = na
float hsDbgNeck  = na
int   hsDbgRej   = 0
// パターン視覚化用 : 採用パターン種別 (1=逆三尊 / -1=三尊 / 0=なし) + 確定地点 (時刻/価格)
int   hsLblPatType = 0
int   hsLblBreakT  = na
float hsLblBreakP  = na
// パターン視覚化用 : 候補 (ブレイク前) の種別 + 5点 (1=逆三尊候補 / -1=三尊候補 / 0=なし)
int   hsLblCandType = 0
float hsLblCLsP = na
int   hsLblCLsT = na
float hsLblCHdP = na
int   hsLblCHdT = na
float hsLblCRsP = na
int   hsLblCRsT = na
float hsLblCN1P = na
int   hsLblCN1T = na
float hsLblCN2P = na
int   hsLblCN2T = na
if hsEnvCompute and useHSEnvD
    [_b, _lp, _lt, _hp, _ht, _rp, _rt, _p1, _t1, _p2, _t2, _sc, _pb, _tr, _sd, _pr, _nd, _rj, _pt, _et, _ep, _ct, _clp, _clt, _chp, _cht, _crp, _crt, _cn1p, _cn1t, _cn2p, _cn2t] = request.security(syminfo.tickerid, hsEnvDailyTF, f_hsEnvConfirmed(hsEnvHoldDaily), lookahead = barmerge.lookahead_on)
    hsEnvD := _b
    hsRejD := _rj
    if hsEnvWantDraw and hsEnvLabelTF == "D"
        hsLblLsP := _lp
        hsLblLsT := _lt
        hsLblHdP := _hp
        hsLblHdT := _ht
        hsLblRsP := _rp
        hsLblRsT := _rt
        hsLblN1P := _p1
        hsLblN1T := _t1
        hsLblN2P := _p2
        hsLblN2T := _t2
        hsDbgScore := _sc
        hsDbgPat := _pb
        hsDbgTime := _tr
        hsDbgShDf := _sd
        hsDbgProm := _pr
        hsDbgNeck := _nd
        hsDbgRej := _rj
        hsLblPatType := _pt
        hsLblBreakT := _et
        hsLblBreakP := _ep
        hsLblCandType := _ct
        hsLblCLsP := _clp
        hsLblCLsT := _clt
        hsLblCHdP := _chp
        hsLblCHdT := _cht
        hsLblCRsP := _crp
        hsLblCRsT := _crt
        hsLblCN1P := _cn1p
        hsLblCN1T := _cn1t
        hsLblCN2P := _cn2p
        hsLblCN2T := _cn2t
if hsEnvCompute and useHSEnv4H
    [_b, _lp, _lt, _hp, _ht, _rp, _rt, _p1, _t1, _p2, _t2, _sc, _pb, _tr, _sd, _pr, _nd, _rj, _pt, _et, _ep, _ct, _clp, _clt, _chp, _cht, _crp, _crt, _cn1p, _cn1t, _cn2p, _cn2t] = request.security(syminfo.tickerid, hsEnv4HTF, f_hsEnvConfirmed(hsEnvHold4H), lookahead = barmerge.lookahead_on)
    hsEnv4H := _b
    hsRej4H := _rj
    if hsEnvWantDraw and hsEnvLabelTF == "4H"
        hsLblLsP := _lp
        hsLblLsT := _lt
        hsLblHdP := _hp
        hsLblHdT := _ht
        hsLblRsP := _rp
        hsLblRsT := _rt
        hsLblN1P := _p1
        hsLblN1T := _t1
        hsLblN2P := _p2
        hsLblN2T := _t2
        hsDbgScore := _sc
        hsDbgPat := _pb
        hsDbgTime := _tr
        hsDbgShDf := _sd
        hsDbgProm := _pr
        hsDbgNeck := _nd
        hsDbgRej := _rj
        hsLblPatType := _pt
        hsLblBreakT := _et
        hsLblBreakP := _ep
        hsLblCandType := _ct
        hsLblCLsP := _clp
        hsLblCLsT := _clt
        hsLblCHdP := _chp
        hsLblCHdT := _cht
        hsLblCRsP := _crp
        hsLblCRsT := _crt
        hsLblCN1P := _cn1p
        hsLblCN1T := _cn1t
        hsLblCN2P := _cn2p
        hsLblCN2T := _cn2t
if hsEnvCompute and useHSEnv1H
    [_b, _lp, _lt, _hp, _ht, _rp, _rt, _p1, _t1, _p2, _t2, _sc, _pb, _tr, _sd, _pr, _nd, _rj, _pt, _et, _ep, _ct, _clp, _clt, _chp, _cht, _crp, _crt, _cn1p, _cn1t, _cn2p, _cn2t] = request.security(syminfo.tickerid, hsEnv1HTF, f_hsEnvConfirmed(hsEnvHold1H), lookahead = barmerge.lookahead_on)
    hsEnv1H := _b
    hsRej1H := _rj
    if hsEnvWantDraw and hsEnvLabelTF == "1H"
        hsLblLsP := _lp
        hsLblLsT := _lt
        hsLblHdP := _hp
        hsLblHdT := _ht
        hsLblRsP := _rp
        hsLblRsT := _rt
        hsLblN1P := _p1
        hsLblN1T := _t1
        hsLblN2P := _p2
        hsLblN2T := _t2
        hsDbgScore := _sc
        hsDbgPat := _pb
        hsDbgTime := _tr
        hsDbgShDf := _sd
        hsDbgProm := _pr
        hsDbgNeck := _nd
        hsDbgRej := _rj
        hsLblPatType := _pt
        hsLblBreakT := _et
        hsLblBreakP := _ep
        hsLblCandType := _ct
        hsLblCLsP := _clp
        hsLblCLsT := _clt
        hsLblCHdP := _chp
        hsLblCHdT := _cht
        hsLblCRsP := _crp
        hsLblCRsT := _crt
        hsLblCN1P := _cn1p
        hsLblCN1T := _cn1t
        hsLblCN2P := _cn2p
        hsLblCN2T := _cn2t
if hsEnvCompute and useHSEnv15M
    [_b, _lp, _lt, _hp, _ht, _rp, _rt, _p1, _t1, _p2, _t2, _sc, _pb, _tr, _sd, _pr, _nd, _rj, _pt, _et, _ep, _ct, _clp, _clt, _chp, _cht, _crp, _crt, _cn1p, _cn1t, _cn2p, _cn2t] = request.security(syminfo.tickerid, hsEnv15MTF, f_hsEnvConfirmed(hsEnvHold15M), lookahead = barmerge.lookahead_on)
    hsEnv15M := _b
    hsRej15M := _rj
    if hsEnvWantDraw and hsEnvLabelTF == "15M"
        hsLblLsP := _lp
        hsLblLsT := _lt
        hsLblHdP := _hp
        hsLblHdT := _ht
        hsLblRsP := _rp
        hsLblRsT := _rt
        hsLblN1P := _p1
        hsLblN1T := _t1
        hsLblN2P := _p2
        hsLblN2T := _t2
        hsDbgScore := _sc
        hsDbgPat := _pb
        hsDbgTime := _tr
        hsDbgShDf := _sd
        hsDbgProm := _pr
        hsDbgNeck := _nd
        hsDbgRej := _rj
        hsLblPatType := _pt
        hsLblBreakT := _et
        hsLblBreakP := _ep
        hsLblCandType := _ct
        hsLblCLsP := _clp
        hsLblCLsT := _clt
        hsLblCHdP := _chp
        hsLblCHdT := _cht
        hsLblCRsP := _crp
        hsLblCRsT := _crt
        hsLblCN1P := _cn1p
        hsLblCN1T := _cn1t
        hsLblCN2P := _cn2p
        hsLblCN2T := _cn2t

// --- 統合 (HigherTF: 上位足優先で最初の非ゼロ / WeightedScore: 重み合計を閾値判定) ---
int hsEnvHigherTF =
     (useHSEnvD   and hsEnvD   != 0) ? hsEnvD   :
     (useHSEnv4H  and hsEnv4H  != 0) ? hsEnv4H  :
     (useHSEnv1H  and hsEnv1H  != 0) ? hsEnv1H  :
     (useHSEnv15M and hsEnv15M != 0) ? hsEnv15M : 0
int hsEnvScore = (useHSEnvD ? hsEnvWeightD * hsEnvD : 0) + (useHSEnv4H ? hsEnvWeight4H * hsEnv4H : 0) + (useHSEnv1H ? hsEnvWeight1H * hsEnv1H : 0) + (useHSEnv15M ? hsEnvWeight15M * hsEnv15M : 0)
int hsEnvWeighted = hsEnvScore >= hsEnvScoreThreshold ? 1 : hsEnvScore <= -hsEnvScoreThreshold ? -1 : 0
int hsEnvBias = not useHSEnvEnv ? 0 : hsEnvCombineMode == "HigherTF" ? hsEnvHigherTF : hsEnvWeighted

// --- 方向必須フィルター (EMA/FVG/Stochと同型: bias==1→ロングのみ / -1→ショートのみ / 0→両方禁止) ---
bool hsEnvFilterActive = useHSEnvEnv and useHSEnvBias
bool allowLongByHSEnv  = not hsEnvFilterActive or hsEnvBias == 1
bool allowShortByHSEnv = not hsEnvFilterActive or hsEnvBias == -1

// ============================================================
//  8j. Fib 環境認識モジュール 本体 (MTF・大きな波の押し/戻り)
// ------------------------------------------------------------
//  f_fibEnvState : 呼ばれた足(=上位足)コンテキストで、その足のPivot/波/起点/終点を
//    独立管理。Bull/Bear/Neutral の1状態のみ保持。起点固定・終点のみ更新。
//    起点の終値突破で反対波へ直接反転 (Neutral経由なし。新起点=旧終点・新終点=突破足の高安)。
//    ヒゲ突破では反転しない。波中の逆行=押し/戻し。Neutralは初期/最初の波未確定時のみ。
//  戻り値 [direction, longScore, shortScore, retr, origin, extreme]。
//  ※ 出力のみ。canLong/canShort・環境スコア・アラートには接続しない。
// ============================================================
// Fibリトレース位置 → スコア (境界は下側 >= 上側 < で重複なし)
f_fibEnvScore(float r) =>
    na(r) ? 0 :
     r >= 0.786 ? 0 :
     r >= 0.618 ? 2 :
     r >= 0.500 ? 3 :
     r >= 0.382 ? 2 :
     r >= 0.236 ? 1 : 0

f_fibEnvState(int atrLen, int swingLen, float minMult) =>
    float _atr = ta.atr(atrLen)
    float _ph  = ta.pivothigh(high, swingLen, swingLen)
    float _pl  = ta.pivotlow(low,  swingLen, swingLen)
    float _minSwing = _atr * minMult
    var int   _state   = 0
    var float _origin  = na
    var float _extreme = na
    var float _pendLow     = na
    var int   _pendLowBar  = na
    var float _pendHigh    = na
    var int   _pendHighBar = na
    // 有意Pivotを起点候補として更新
    if not na(_pl)
        _pendLow    := _pl
        _pendLowBar := bar_index - swingLen
    if not na(_ph)
        _pendHigh    := _ph
        _pendHighBar := bar_index - swingLen
    int _prev = _state
    // アクティブ波: 終点のみ更新 / 起点の終値突破で 反対波へ直接反転 (Neutralを経由しない)
    if _state == 1
        if high > _extreme          // Bull終点: 最高値更新時のみ更新
            _extreme := high
        if close < _origin          // 起点安値を終値で下抜け → Bearへ直接反転
            float _oldExtreme = _extreme   // 旧Bull終点(最高値)を先に退避
            _state   := -1
            _origin  := _oldExtreme        // 新Bear起点 = 旧Bull最高値 (以後固定)
            _extreme := low                // 新Bear終点 = 起点割れバーの安値 (以後 新安値で更新)
    else if _state == -1
        if low < _extreme           // Bear終点: 最安値更新時のみ更新
            _extreme := low
        if close > _origin          // 起点高値を終値で上抜け → Bullへ直接反転
            float _oldExtreme = _extreme   // 旧Bear終点(最安値)を先に退避
            _state   := 1
            _origin  := _oldExtreme        // 新Bull起点 = 旧Bear最安値 (以後固定)
            _extreme := high               // 新Bull終点 = 起点突破バーの高値 (以後 新高値で更新)
    // 最初の有意波の確定 (初期Neutralのときのみ。反転後はここを通らない = 直接切替を維持)
    if _prev == 0 and _state == 0
        bool _bullOk = not na(_ph) and not na(_pendLow)  and _pendLowBar  < (bar_index - swingLen) and (_ph - _pendLow) >= _minSwing
        bool _bearOk = not na(_pl) and not na(_pendHigh) and _pendHighBar < (bar_index - swingLen) and (_pendHigh - _pl) >= _minSwing
        if _bullOk and (not _bearOk or (_ph - _pendLow) >= (_pendHigh - _pl))
            _state   := 1
            _origin  := _pendLow
            _extreme := math.max(_ph, high)
        else if _bearOk
            _state   := -1
            _origin  := _pendHigh
            _extreme := math.min(_pl, low)
    // リトレース率 (毎バー現在値・0〜1・最大値は保持しない)
    float _retr = na
    if _state == 1 and not na(_extreme) and not na(_origin) and (_extreme - _origin) > 0
        _retr := math.max(0.0, math.min(1.0, (_extreme - close) / (_extreme - _origin)))
    else if _state == -1 and not na(_extreme) and not na(_origin) and (_origin - _extreme) > 0
        _retr := math.max(0.0, math.min(1.0, (close - _extreme) / (_origin - _extreme)))
    int _scoreRaw = f_fibEnvScore(_retr)
    int _long  = _state == 1  ? _scoreRaw : 0
    int _short = _state == -1 ? _scoreRaw : 0
    [_state, _long, _short, _retr, _origin, _extreme]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助 (lookahead_on + [1])。
f_fibEnvConfirmed(int atrLen, int swingLen, float minMult) =>
    [_d, _l, _s, _r, _o, _e] = f_fibEnvState(atrLen, swingLen, minMult)
    [_d[1], _l[1], _s[1], _r[1], _o[1], _e[1]]

f_fibEnvDirText(int d) =>
    d == 1 ? "BULL" : d == -1 ? "BEAR" : "NEUTRAL"
f_fibEnvDirColor(int d, bool on) =>
    not on ? color.new(color.black, 0) : d == 1 ? color.new(color.green, 0) : d == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- 各足の確定 Fib環境状態 (OFF足は request.security を呼ばない) ---
int   fibEnvDirection_D   = 0
int   fibEnvLongScore_D   = 0
int   fibEnvShortScore_D  = 0
float fibEnvRetr_D        = na
float fibEnvOrigin_D      = na
float fibEnvExtreme_D     = na
int   fibEnvDirection_H4  = 0
int   fibEnvLongScore_H4  = 0
int   fibEnvShortScore_H4 = 0
float fibEnvRetr_H4       = na
float fibEnvOrigin_H4     = na
float fibEnvExtreme_H4    = na
int   fibEnvDirection_H1  = 0
int   fibEnvLongScore_H1  = 0
int   fibEnvShortScore_H1 = 0
float fibEnvRetr_H1       = na
float fibEnvOrigin_H1     = na
float fibEnvExtreme_H1    = na
int   fibEnvDirection_M15 = 0
int   fibEnvLongScore_M15 = 0
int   fibEnvShortScore_M15= 0
float fibEnvRetr_M15      = na
float fibEnvOrigin_M15    = na
float fibEnvExtreme_M15   = na
if useFibEnvEnv and useFibEnvD
    [_d, _l, _s, _r, _o, _e] = request.security(syminfo.tickerid, fibEnvDailyTF, f_fibEnvConfirmed(fibEnvAtrLen, fibEnvSwingLen, fibEnvMinSwingAtrMult), lookahead = barmerge.lookahead_on)
    fibEnvDirection_D := _d
    fibEnvLongScore_D := _l
    fibEnvShortScore_D := _s
    fibEnvRetr_D := _r
    fibEnvOrigin_D := _o
    fibEnvExtreme_D := _e
if useFibEnvEnv and useFibEnvH4
    [_d, _l, _s, _r, _o, _e] = request.security(syminfo.tickerid, fibEnv4HTF, f_fibEnvConfirmed(fibEnvAtrLen, fibEnvSwingLen, fibEnvMinSwingAtrMult), lookahead = barmerge.lookahead_on)
    fibEnvDirection_H4 := _d
    fibEnvLongScore_H4 := _l
    fibEnvShortScore_H4 := _s
    fibEnvRetr_H4 := _r
    fibEnvOrigin_H4 := _o
    fibEnvExtreme_H4 := _e
if useFibEnvEnv and useFibEnvH1
    [_d, _l, _s, _r, _o, _e] = request.security(syminfo.tickerid, fibEnv1HTF, f_fibEnvConfirmed(fibEnvAtrLen, fibEnvSwingLen, fibEnvMinSwingAtrMult), lookahead = barmerge.lookahead_on)
    fibEnvDirection_H1 := _d
    fibEnvLongScore_H1 := _l
    fibEnvShortScore_H1 := _s
    fibEnvRetr_H1 := _r
    fibEnvOrigin_H1 := _o
    fibEnvExtreme_H1 := _e
if useFibEnvEnv and useFibEnvM15
    [_d, _l, _s, _r, _o, _e] = request.security(syminfo.tickerid, fibEnv15MTF, f_fibEnvConfirmed(fibEnvAtrLen, fibEnvSwingLen, fibEnvMinSwingAtrMult), lookahead = barmerge.lookahead_on)
    fibEnvDirection_M15 := _d
    fibEnvLongScore_M15 := _l
    fibEnvShortScore_M15 := _s
    fibEnvRetr_M15 := _r
    fibEnvOrigin_M15 := _o
    fibEnvExtreme_M15 := _e

// --- Fib環境 加重スコア (時間足重み × 基礎点。OFF足は 0 で合計に含めない) ---
// canLong / canShort へは接続しない (出力・表示のみ)
float fibEnvWeightedLong_D   = useFibEnvEnv and useFibEnvD   ? fibEnvLongScore_D   * fibEnvWeightD   : 0.0
float fibEnvWeightedShort_D  = useFibEnvEnv and useFibEnvD   ? fibEnvShortScore_D  * fibEnvWeightD   : 0.0
float fibEnvWeightedLong_H4  = useFibEnvEnv and useFibEnvH4  ? fibEnvLongScore_H4  * fibEnvWeightH4  : 0.0
float fibEnvWeightedShort_H4 = useFibEnvEnv and useFibEnvH4  ? fibEnvShortScore_H4 * fibEnvWeightH4  : 0.0
float fibEnvWeightedLong_H1  = useFibEnvEnv and useFibEnvH1  ? fibEnvLongScore_H1  * fibEnvWeightH1  : 0.0
float fibEnvWeightedShort_H1 = useFibEnvEnv and useFibEnvH1  ? fibEnvShortScore_H1 * fibEnvWeightH1  : 0.0
float fibEnvWeightedLong_M15 = useFibEnvEnv and useFibEnvM15 ? fibEnvLongScore_M15 * fibEnvWeightM15 : 0.0
float fibEnvWeightedShort_M15= useFibEnvEnv and useFibEnvM15 ? fibEnvShortScore_M15* fibEnvWeightM15 : 0.0

float fibEnvLongTotal  = fibEnvWeightedLong_D  + fibEnvWeightedLong_H4  + fibEnvWeightedLong_H1  + fibEnvWeightedLong_M15
float fibEnvShortTotal = fibEnvWeightedShort_D + fibEnvWeightedShort_H4 + fibEnvWeightedShort_H1 + fibEnvWeightedShort_M15
float fibEnvNetScore   = fibEnvLongTotal - fibEnvShortTotal
int   fibEnvBias       = fibEnvNetScore >= fibEnvScoreThreshold ? 1 : fibEnvNetScore <= -fibEnvScoreThreshold ? -1 : 0

// --- Fib環境 方向バイアス エントリーフィルター ---
// フィルタが実際に効くのは、接続ON かつ 計算ON のときだけ。
// これにより useFibEnvBias=ON / useFibEnvEnv=OFF でも全面禁止にならない。
bool fibEnvFilterActive = useFibEnvBias and useFibEnvEnv
bool allowLongByFibEnv  = not fibEnvFilterActive or fibEnvNetScore >=  fibEnvScoreThreshold
bool allowShortByFibEnv = not fibEnvFilterActive or fibEnvNetScore <= -fibEnvScoreThreshold

// ============================================================
//  8i. Volume Breakout 環境認識 (MTF) 計算  接頭辞 volEnv
// ------------------------------------------------------------
//  各時間足のコンテキストで「C:出来高ブレイク」を判定し、その方向を
//  保持本数だけ維持する。状態は var で上位足バーごとに保持する。
//  非リペイント : 他環境モジュールと同じ「確定上位足」方式 =
//    request.security(..., f_volEnvState(...)[1], lookahead = lookahead_on)。
//    lookahead_on + 上位足内 [1] は、進行中の上位足では判定せず、上位足が
//    確定した直後の値を余計な遅延なく反映する (lookahead_off + [1] のような
//    追加1本遅れを生じない)。
//  戻り値: 状態コード (Bull=1 / Neutral=0 / Bear=-1)。
// ============================================================
// パラメータ入力はグローバル定数として関数内で直接参照 (f_envTrend と同方式)。
// 時間足ごとに変わるのは保持本数だけなので、引数は _holdBars のみ。
f_volEnvState(int _holdBars) =>
    float _atr      = ta.atr(volEnvAtrLen)
    float _rng      = high - low
    float _bodyRat  = _rng > 0 ? math.abs(close - open) / _rng : 0.0
    float _volSMA   = ta.sma(volume, volEnvVolumeSmaLen)
    float _rHigh    = ta.highest(high, volEnvBreakoutLookback)[1]
    float _rLow     = ta.lowest(low,  volEnvBreakoutLookback)[1]
    bool  _volSpike = not na(_volSMA) and volume > _volSMA * volEnvVolumeSpikeMult
    bool  _atrExp   = _atr > nz(_atr[volEnvBreakoutLookback]) * volEnvAtrExpansionMult
    bool  _comp     = (ta.highest(high, volEnvCompressionLookback) - ta.lowest(low, volEnvCompressionLookback)) <= _atr * volEnvCompressionATRMult
    // 上抜け / 下抜け ブレイク (元 brkBuyCore / brkSellCore と同一条件)
    bool  _brkBuy   = not na(_rHigh) and close > _rHigh and _volSpike and _bodyRat >= volEnvBodyRatioMin and (not volEnvUseAtrExpansion or _atrExp) and (not volEnvUseCompression or _comp[1])
    bool  _brkSell  = not na(_rLow)  and close < _rLow  and _volSpike and _bodyRat >= volEnvBodyRatioMin and (not volEnvUseAtrExpansion or _atrExp) and (not volEnvUseCompression or _comp[1])
    // 状態保持 : ブレイクで方向確定＋カウントリセット、無ければ減衰、0でNeutral
    var int _state = 0
    var int _hold  = 0
    if _brkBuy
        _state := 1
        _hold  := _holdBars
    else if _brkSell
        _state := -1
        _hold  := _holdBars
    else if _hold > 0
        _hold := _hold - 1
        if _hold == 0
            _state := 0
    _state

// 非リペイント : 上位足コンテキスト内で確定1本前 [1] を返す
f_volEnvConfirmed(int _holdBars) =>
    _s = f_volEnvState(_holdBars)
    _s[1]

// --- 各時間足の確定状態 (OFF足・モジュールOFF時は request.security を呼ばない) ---
//   確定上位足方式 : lookahead_on + 関数内 [1]。他環境モジュールと統一。
int volumeStateD   = 0
int volumeState4H  = 0
int volumeState1H  = 0
int volumeState15M = 0
if volumeEnvEnabled and useVolEnvD
    volumeStateD := request.security(syminfo.tickerid, volEnvDailyTF, f_volEnvConfirmed(volEnvHoldD), lookahead = barmerge.lookahead_on)
if volumeEnvEnabled and useVolEnvH4
    volumeState4H := request.security(syminfo.tickerid, volEnv4HTF, f_volEnvConfirmed(volEnvHoldH4), lookahead = barmerge.lookahead_on)
if volumeEnvEnabled and useVolEnvH1
    volumeState1H := request.security(syminfo.tickerid, volEnv1HTF, f_volEnvConfirmed(volEnvHoldH1), lookahead = barmerge.lookahead_on)
if volumeEnvEnabled and useVolEnvM15
    volumeState15M := request.security(syminfo.tickerid, volEnv15MTF, f_volEnvConfirmed(volEnvHoldM15), lookahead = barmerge.lookahead_on)

// --- 各時間足の加点 / 減点 (OFF足は 0。Bull:+重み / Bear:-重み / Neutral:0) ---
float volEnvPtsD   = (volumeEnvEnabled and useVolEnvD)   ? volumeStateD   * volEnvWeightD   : 0.0
float volEnvPtsH4  = (volumeEnvEnabled and useVolEnvH4)  ? volumeState4H  * volEnvWeightH4  : 0.0
float volEnvPtsH1  = (volumeEnvEnabled and useVolEnvH1)  ? volumeState1H  * volEnvWeightH1  : 0.0
float volEnvPtsM15 = (volumeEnvEnabled and useVolEnvM15) ? volumeState15M * volEnvWeightM15 : 0.0

// --- 合計スコア (反対方向は必ず相殺) ---
float volumeEnvScore = volEnvPtsD + volEnvPtsH4 + volEnvPtsH1 + volEnvPtsM15

// --- Bull / Bear 時間足数 (ONかつ状態が該当のTFのみカウント) ---
int volumeBullCount =
     ((volumeEnvEnabled and useVolEnvD   and volumeStateD   == 1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvH4  and volumeState4H  == 1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvH1  and volumeState1H  == 1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvM15 and volumeState15M == 1) ? 1 : 0)
int volumeBearCount =
     ((volumeEnvEnabled and useVolEnvD   and volumeStateD   == -1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvH4  and volumeState4H  == -1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvH1  and volumeState1H  == -1) ? 1 : 0) +
     ((volumeEnvEnabled and useVolEnvM15 and volumeState15M == -1) ? 1 : 0)

// --- 最終環境判定 (スコア閾値 かつ 最低同方向TF数) ---
//   日足単独で+4でも Bull数1 なら閾値未達扱い → 中立。
bool volumeBullEnv = volumeEnvEnabled and volumeEnvScore >= volEnvBullThreshold and volumeBullCount >= volEnvMinAlignedTF
bool volumeBearEnv = volumeEnvEnabled and volumeEnvScore <= volEnvBearThreshold and volumeBearCount >= volEnvMinAlignedTF
bool volumeNeutralEnv = not volumeBullEnv and not volumeBearEnv
// 環境コード (1=Bull / -1=Bear / 0=Neutral)
int volumeEnvCode = volumeBullEnv ? 1 : volumeBearEnv ? -1 : 0

// --- Volume環境 方向バイアス エントリーフィルター ---
//   フィルタが効くのは 計算ON かつ 接続ON のときだけ。
//   これにより volumeEnvEnabled=OFF / useVolEnvBias=ON でも全面禁止にならない
//   (計算OFF時は Bull/Bear がどちらも false のため、パススルーが必須)。
//   volumeEnvEnabled=OFF          … 完全パススルー (Volume条件で制限しない)。
//   ON / useVolEnvBias=OFF         … 計算・表示のみ。エントリーには影響しない。
//   ON / useVolEnvBias=ON          … Bull=ロングのみ / Bear=ショートのみ / Neutral=両方禁止。
bool volEnvFilterActive = volumeEnvEnabled and useVolEnvBias
bool volEnvLongOk  = not volEnvFilterActive or volumeBullEnv
bool volEnvShortOk = not volEnvFilterActive or volumeBearEnv

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

// 15分足コンテキストで箱を構築 (var で 15分足の生存期間だけ上下限を拡張)。
//   返り値: [isAccum, boxHigh, boxLow, boxStartBar]  boxStartBar = 箱識別子。
f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

// 確定済み1本前の15分足 box を「15分足コンテキスト内」で参照して返す。
//   [1] を関数内 (= 15分足コンテキスト) で適用し、lookahead_on と組み合わせることで、
//   ヒストリカル/リアルタイムとも「直前に確定した15分足」の box を一貫して取得する
//   (未来参照なし・非リペイント)。チャート側では [1] を一切使わない。
f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        // 新規Accum確定 → 配列へ追加。4つ目 (accumNTKeep超) で最古を削除。
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        // 形成中は最新箱の上下限を拡張 (配列の末尾=最新も更新)
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    // 内部判定 : 直近保持のどれか1つでも close が上限〜下限 (端一致含む) にあれば内部
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
//   確定参照は 15分足コンテキスト内で [1] を適用する f_accumNT15Confirmed + lookahead_on。
//   → 返る box は常に「直前に確定した15分足」の最終値 (ヒストリカル/リアルタイム一致)。
//   登録/更新は ta.change(time(15分足)) で「新しい15分足が始まった最初の5分足」だけ。
//   ※ チャート側では [1] を一切使わない。形成途中の15分足値は配列に入らない。
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        // 直前に確定した15分足の box をこの1本だけで処理 (3本に1回)
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            // 新しい15分Accum箱 → 登録 (箱識別子が変わった時のみ = 重複登録なし)
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            // 同一箱が拡張 (確定15分足で更新) → 最新エントリーの上下限を更新
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    // 内部判定は毎5分足で実施 (保持中の確定箱に対して現在の終値を判定)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
//   Accum外へ出た最初の足では許可せず、accumExitConfirmBars 本連続で外部維持後に許可。
//   離脱足は計数に含めず、その次の足から連続外部本数を数える。
//   確認中にAccum内へ戻ったらカウント完全リセット。最初から外部なら待機なし (従来どおり即許可)。
//   ※ WinZone/Momentum/Trigger/各状態管理・有効期限・リセットには一切干渉しない。
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        // Accum内 (または戻った) → 待機・カウント完全リセット
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        // 離脱足 → 待機開始 (この足は計数に含めない)
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        // 離脱の次足以降、外部維持で計数
        accumOutsideConfirmCount += 1
    // 確認完了 → 待機解除 (この確定バーで許可)
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

// 確認完了前だけ新規エントリー禁止 (blockedByAccum とは別条件)
bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
//   Accum内NoTrade・離脱待機確認は不変。離脱後のみ、抜けた方向にエントリーを限定する。
//   方向判定は「直前バーで実際に内部にいた保持箱」ごとに close 基準 (ヒゲ無視) で行う。
//   ・最初から外部 (一度もAccumを通過していない) → 方向制限なし (accumBreakDirectionActive=false)。
//   ・Accum内へ戻る / 有効期限切れ / 方向不明 → 状態リセット。
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        // Accum内へ戻った → 方向状態リセット (Accum内なので両方向禁止のまま)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        // 離脱足 : 直前バーで内部にいた箱ごとに close 基準で上抜け/下抜けを判定
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            // 上抜け/下抜け同時成立 or どちらも不成立 → 方向不明 (両方禁止しない=非アクティブ)
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    // 有効期限切れ → リセット
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

// 方向別許可 (非アクティブ時=最初から外部/方向不明/期限切れ は従来どおり両方向許可)
bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + FVG)
// ------------------------------------------------------------
//  WinZone / Momentum / Intermarket は本ストラテジーでは不使用。
//  環境認識は allEnvLongOk/allEnvShortOk (ON中の全環境モジュールのAND) に一本化。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
bool canLong =
     useLong and
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     allEnvLongOk and
     allowLongByHSEnv and
     allowLongByFibEnv and
     volEnvLongOk and
     allowLongByTrigger and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk and
     longRisk > 0 and
     longQty >= 1

bool canShort =
     useShort and
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     allEnvShortOk and
     allowShortByHSEnv and
     allowShortByFibEnv and
     volEnvShortOk and
     allowShortByTrigger and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk and
     shortRisk > 0 and
     shortQty >= 1

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)

// ============================================================
//  12. FVG 環境認識 表示 (テーブル / デバッグ / ゾーン)
// ============================================================
f_efvgBiasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

var table efvgTbl = na
if efvgShowTable
    if na(efvgTbl)
        efvgTbl := table.new(position.top_right, 4, 6, border_width = 1)
    if barstate.islast
        table.cell(efvgTbl, 0, 0, "TF",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 1, 0, "FVG",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 2, 0, "理由", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 3, 0, "残",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // Daily
        table.cell(efvgTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 1, useEFVGDaily ? f_efvgBiasText(efvgDBias) : "-", text_color = color.white, bgcolor = useEFVGDaily ? f_efvgBiasColor(efvgDBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 1, useEFVGDaily ? f_efvgReasonText(efvgDReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 1, useEFVGDaily ? str.tostring(efvgDRem) : "-", text_color = color.white, text_size = size.small)
        // 4H
        table.cell(efvgTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 2, useEFVG4H ? f_efvgBiasText(efvgHBias) : "-", text_color = color.white, bgcolor = useEFVG4H ? f_efvgBiasColor(efvgHBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 2, useEFVG4H ? f_efvgReasonText(efvgHReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 2, useEFVG4H ? str.tostring(efvgHRem) : "-", text_color = color.white, text_size = size.small)
        // 1H
        table.cell(efvgTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 3, useEFVG1H ? f_efvgBiasText(efvgOBias) : "-", text_color = color.white, bgcolor = useEFVG1H ? f_efvgBiasColor(efvgOBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 3, useEFVG1H ? f_efvgReasonText(efvgOReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 3, useEFVG1H ? str.tostring(efvgORem) : "-", text_color = color.white, text_size = size.small)
        // 15M
        table.cell(efvgTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 4, useEFVG15M ? f_efvgBiasText(efvgMBias) : "-", text_color = color.white, bgcolor = useEFVG15M ? f_efvgBiasColor(efvgMBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 4, useEFVG15M ? f_efvgReasonText(efvgMReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 4, useEFVG15M ? str.tostring(efvgMRem) : "-", text_color = color.white, text_size = size.small)
        // FINAL
        string _finalTxt = "FINAL FVG BIAS: " + f_efvgBiasText(efvgFinalBias)
        table.cell(efvgTbl, 0, 5, _finalTxt, text_color = color.white, bgcolor = f_efvgBiasColor(efvgFinalBias), text_size = size.small)
        table.cell(efvgTbl, 1, 5, efvgShowDebug ? ("Score:" + str.tostring(efvgScore)) : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 2, 5, efvgShowDebug ? efvgIntegrationMode : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 5, efvgShowDebug ? ("Trend:" + ((not useTrendEnv or allowByEnv) ? "OK" : "NG")) : "", text_color = color.white, text_size = size.small)

// --- 選択中FVGの上下限ゾーン (デバッグ・最新バーで更新) ---
var line[] efvgZoneLines = array.new_line()
f_efvgDrawZone(float _p, color _c) =>
    if not na(_p)
        line _ln = line.new(bar_index - 50, _p, bar_index, _p, color = _c, width = 1, extend = extend.right)
        array.push(efvgZoneLines, _ln)
if efvgShowZones and barstate.islast
    if array.size(efvgZoneLines) > 0
        for _i = 0 to array.size(efvgZoneLines) - 1
            line.delete(array.get(efvgZoneLines, _i))
        array.clear(efvgZoneLines)
    if useEFVGDaily
        f_efvgDrawZone(efvgDBT, color.new(color.lime, 0))
        f_efvgDrawZone(efvgDBB, color.new(color.lime, 40))
        f_efvgDrawZone(efvgDRT, color.new(color.red, 0))
        f_efvgDrawZone(efvgDRB, color.new(color.red, 40))
    if useEFVG4H
        f_efvgDrawZone(efvgHBT, color.new(color.aqua, 0))
        f_efvgDrawZone(efvgHBB, color.new(color.aqua, 40))
        f_efvgDrawZone(efvgHRT, color.new(color.orange, 0))
        f_efvgDrawZone(efvgHRB, color.new(color.orange, 40))


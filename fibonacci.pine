//
// ============================================================
//  フィボナッチ・エントリーモジュール (Fibonacci Entry Module)
// ------------------------------------------------------------
//  環境認識モジュールと接続できる形で、
//  フィボ戻し/押し目を A/B/C ランクで検出する単体モジュール。
//
//  - ADX 不使用 / HH-HL 判定 不使用
//  - BUY : 上昇環境で直近上昇波に対する押し目
//  - SELL: 下降環境で直近下降波に対する戻り
//  - 環境認識モジュールの allow* は input.bool で代用（後で接続）
//  - 現在足ベース / request.security 不使用
//  - リペイント回避のため確定足判定を選択可
//  - 後で接続しやすいよう関数化
// ============================================================

//@version=5
indicator(
     title         = "Fibonacci Entry Module",
     shorttitle    = "FIB",
     overlay       = true,
     max_bars_back = 500,
     max_boxes_count  = 50,
     max_labels_count = 100
 )

// ============================================================
//  1. 入力 : モジュール ON/OFF
// ============================================================
grpMod = "モジュール ON/OFF"
useFibModule = input.bool(true, "フィボモジュール ON", group = grpMod)
useFibBuy    = input.bool(true, "BUY 検出 ON",        group = grpMod)
useFibSell   = input.bool(true, "SELL 検出 ON",       group = grpMod)

// ============================================================
//  2. 入力 : 環境認識モジュール接続 (一旦 input.bool で代用)
// ============================================================
grpEnv = "環境フィルター (環境認識モジュール接続用)"
allowLongByEnvironment  = input.bool(true,  "allowLongByEnvironment",  group = grpEnv)
allowShortByEnvironment = input.bool(true,  "allowShortByEnvironment", group = grpEnv)
isRangeEnvironment      = input.bool(false, "isRangeEnvironment",      group = grpEnv)
suppressInRange         = input.bool(true,  "レンジ環境では検出を抑制する", group = grpEnv)

// ============================================================
//  3. 入力 : ランク ON/OFF
// ============================================================
grpRank = "ランク ON/OFF"
useFibRankA = input.bool(true, "A ランク (深い 0.618〜0.786)", group = grpRank)
useFibRankB = input.bool(true, "B ランク (王道 0.500〜0.618)", group = grpRank)
useFibRankC = input.bool(true, "C ランク (浅い 0.382〜0.500)", group = grpRank)

// ============================================================
//  4. 入力 : 反転確認 ON/OFF
// ============================================================
grpConf = "反転確認 ON/OFF"
useFibRejectConfirm    = input.bool(true,  "反転確認を使う",        group = grpConf)
useBullCandleConfirm   = input.bool(true,  "陽線確定 (BUY)",        group = grpConf)
useBearCandleConfirm   = input.bool(true,  "陰線確定 (SELL)",       group = grpConf)
usePinbarConfirm       = input.bool(true,  "ピンバー (下/上ヒゲ)",  group = grpConf)
useEngulfingConfirm    = input.bool(true,  "包み足 (engulfing)",    group = grpConf)
useEma20Confirm        = input.bool(true,  "close と EMA20 の関係", group = grpConf)
useBreakPrevCandleConfirm = input.bool(true, "直近足の高値/安値更新", group = grpConf)

// ============================================================
//  5. 入力 : 調整パラメータ
// ============================================================
grpParam = "調整パラメータ"
fibLookback   = input.int(30,  "fibLookback (基準波の参照本数)", minval = 2, group = grpParam)
atrLen        = input.int(14,  "atrLen",                        minval = 1, group = grpParam)
fibMinWaveATR = input.float(2.0, "fibMinWaveATR (最低波幅 ATR倍率)", minval = 0, step = 0.1, group = grpParam)
ema20Len      = input.int(20,  "ema20Len",                      minval = 1, group = grpParam)
requireConfirmedBar = input.bool(true, "確定足でのみシグナル (リペイント回避)", group = grpParam)

grpFix = "基準波の固定"
useFixedFibWave          = input.bool(true,  "基準波を固定する",                group = grpFix)
resetFibWaveOnNewHighLow = input.bool(true,  "新高値/新安値で波を更新",          group = grpFix)
resetFibWaveOnSignal     = input.bool(false, "シグナル発生後に波をリセット",      group = grpFix)
resetFibWaveAfterBars    = input.int(0,      "Nバー経過で波をリセット (0=無効)", minval = 0, group = grpFix)

grpFibLv = "フィボ レベル"
fibAStart = input.float(0.618, "fibAStart", step = 0.001, group = grpFibLv)
fibAEnd   = input.float(0.786, "fibAEnd",   step = 0.001, group = grpFibLv)
fibBStart = input.float(0.500, "fibBStart", step = 0.001, group = grpFibLv)
fibBEnd   = input.float(0.618, "fibBEnd",   step = 0.001, group = grpFibLv)
fibCStart = input.float(0.382, "fibCStart", step = 0.001, group = grpFibLv)
fibCEnd   = input.float(0.500, "fibCEnd",   step = 0.001, group = grpFibLv)

grpPattern = "ローソク足パターン"
pinbarWickRatio    = input.float(2.0, "pinbarWickRatio (ヒゲ/実体比)", minval = 0, step = 0.1, group = grpPattern)
engulfingBodyRatio = input.float(1.0, "engulfingBodyRatio (実体比)",   minval = 0, step = 0.1, group = grpPattern)

// ============================================================
//  6. 入力 : 表示
// ============================================================
grpDisp = "表示設定"
showFibZones     = input.bool(true, "フィボゾーンを表示",     group = grpDisp)
showFibLabels    = input.bool(true, "シグナルラベルを表示",   group = grpDisp)
showFibDebugTable = input.bool(true, "デバッグテーブルを表示", group = grpDisp)

colBuyA  = input.color(color.new(color.green, 60), "BUY A カラー", group = grpDisp)
colBuyB  = input.color(color.new(color.green, 75), "BUY B カラー", group = grpDisp)
colBuyC  = input.color(color.new(color.green, 88), "BUY C カラー", group = grpDisp)
colSellA = input.color(color.new(color.red,   60), "SELL A カラー", group = grpDisp)
colSellB = input.color(color.new(color.red,   75), "SELL B カラー", group = grpDisp)
colSellC = input.color(color.new(color.red,   88), "SELL C カラー", group = grpDisp)

// ============================================================
//  7. 基礎計算
// ============================================================
atr   = ta.atr(atrLen)
ema20 = ta.ema(close, ema20Len)

// レンジ環境抑制
envBlock = isRangeEnvironment and suppressInRange

buyEnabled  = useFibModule and useFibBuy  and allowLongByEnvironment  and not envBlock
sellEnabled = useFibModule and useFibSell and allowShortByEnvironment and not envBlock

// ============================================================
//  8. フィボ基準波の検出 (RAW)
// ------------------------------------------------------------
//  BUY : swingLow=直近N本の最安値 → swingLow以降の最高値=swingHigh
//  SELL: swingHigh=直近N本の最高値 → swingHigh以降の最安値=swingLow
//  ※ RAW は毎足更新される暫定波。固定処理を通して実効波を決める。
// ============================================================
// --- BUY RAW ---
rawBuyLowOffset = ta.lowestbars(low, fibLookback)        // <=0 (最安値までのオフセット)
rawBarsSinceLow = -rawBuyLowOffset                        // >=0
rawBuySwingLow  = ta.lowest(low, fibLookback)
// 最安値以降の最高値を for ループで計算 (series length を使わない)
rawBuySwingHigh = high
for i = 0 to fibLookback - 1
    if i <= rawBarsSinceLow
        rawBuySwingHigh := math.max(rawBuySwingHigh, high[i])
rawBuyRange     = rawBuySwingHigh - rawBuySwingLow
rawBuyValid     = rawBuyRange > 0 and rawBuyRange >= atr * fibMinWaveATR
rawBuyLowBar    = bar_index - rawBarsSinceLow

// --- SELL RAW ---
rawSellHighOffset = ta.highestbars(high, fibLookback)    // <=0
rawBarsSinceHigh  = -rawSellHighOffset
rawSellSwingHigh  = ta.highest(high, fibLookback)
// 最高値以降の最安値を for ループで計算 (series length を使わない)
rawSellSwingLow = low
for i = 0 to fibLookback - 1
    if i <= rawBarsSinceHigh
        rawSellSwingLow := math.min(rawSellSwingLow, low[i])
rawSellRange      = rawSellSwingHigh - rawSellSwingLow
rawSellValid      = rawSellRange > 0 and rawSellRange >= atr * fibMinWaveATR
rawSellHighBar    = bar_index - rawBarsSinceHigh

// ============================================================
//  8b. 基準波の固定 (推進波を検出したら波を固定する)
// ------------------------------------------------------------
//  useFixedFibWave=true の場合、有効な波を検出したら固定し、
//  押し目/戻りがゾーンに入るまで同じ波を使い続ける。
//  ・resetFibWaveOnNewHighLow : 新高値(BUY)/新安値(SELL)で波を更新
//  ・resetFibWaveAfterBars    : 固定から N バー経過で波をリセット
//  ・resetFibWaveOnSignal     : シグナル発生後に波をリセット (section 13b)
// ============================================================
var float fixBuyLow    = na
var float fixBuyHigh   = na
var int   fixBuyBar    = na   // 固定した bar
var int   fixBuyLowBar = na   // swingLow の bar (描画用)
var bool  buyLocked    = false

var float fixSellHigh   = na
var float fixSellLow    = na
var int   fixSellBar    = na
var int   fixSellHighBar = na
var bool  sellLocked    = false

// --- BUY 固定処理 ---
if not useFixedFibWave
    buyLocked := false
else if buyEnabled
    newHigh = buyLocked and not na(fixBuyHigh) and high > fixBuyHigh
    agedOut = buyLocked and resetFibWaveAfterBars > 0 and not na(fixBuyBar) and (bar_index - fixBuyBar) >= resetFibWaveAfterBars
    needRelock = (not buyLocked) or (resetFibWaveOnNewHighLow and newHigh) or agedOut
    if needRelock and rawBuyValid
        fixBuyLow    := rawBuySwingLow
        fixBuyHigh   := rawBuySwingHigh
        fixBuyBar    := bar_index
        fixBuyLowBar := rawBuyLowBar
        buyLocked    := true
    else if agedOut and not rawBuyValid
        buyLocked := false
else
    buyLocked := false

// --- SELL 固定処理 ---
if not useFixedFibWave
    sellLocked := false
else if sellEnabled
    newLow  = sellLocked and not na(fixSellLow) and low < fixSellLow
    agedOutS = sellLocked and resetFibWaveAfterBars > 0 and not na(fixSellBar) and (bar_index - fixSellBar) >= resetFibWaveAfterBars
    needRelockS = (not sellLocked) or (resetFibWaveOnNewHighLow and newLow) or agedOutS
    if needRelockS and rawSellValid
        fixSellHigh    := rawSellSwingHigh
        fixSellLow     := rawSellSwingLow
        fixSellBar     := bar_index
        fixSellHighBar := rawSellHighBar
        sellLocked     := true
    else if agedOutS and not rawSellValid
        sellLocked := false
else
    sellLocked := false

// ============================================================
//  8c. 実効波 (固定中は固定波、それ以外は RAW)
// ============================================================
useFixB = useFixedFibWave and buyLocked
buySwingLow  = useFixB ? fixBuyLow    : rawBuySwingLow
buySwingHigh = useFixB ? fixBuyHigh   : rawBuySwingHigh
buyLowBar    = useFixB ? fixBuyLowBar : rawBuyLowBar
buyRangeVal  = buySwingHigh - buySwingLow
buyWaveValid = buyRangeVal > 0 and buyRangeVal >= atr * fibMinWaveATR

useFixS = useFixedFibWave and sellLocked
sellSwingHigh = useFixS ? fixSellHigh    : rawSellSwingHigh
sellSwingLow  = useFixS ? fixSellLow     : rawSellSwingLow
sellHighBar   = useFixS ? fixSellHighBar : rawSellHighBar
sellRangeVal  = sellSwingHigh - sellSwingLow
sellWaveValid = sellRangeVal > 0 and sellRangeVal >= atr * fibMinWaveATR

// ============================================================
//  9. retracePct 計算 (0.0〜1.0)
// ------------------------------------------------------------
//  BUY : 上昇波の高値からどれだけ押したか
//  SELL: 下降波の安値からどれだけ戻したか
// ============================================================
f_clamp01(float v) => math.max(0.0, math.min(1.0, v))

buyRetracePct  = buyWaveValid  ? f_clamp01((buySwingHigh - close)  / buyRangeVal)  : na
sellRetracePct = sellWaveValid ? f_clamp01((close - sellSwingLow) / sellRangeVal) : na

// ============================================================
//  10. ランク判定 (A>B>C / 境界は非重複)
// ------------------------------------------------------------
//  A : [fibAStart, fibAEnd]      (61.8%〜78.6%)
//  B : [fibBStart, fibBEnd)      (50.0%〜61.8%)
//  C : [fibCStart, fibCEnd)      (38.2%〜50.0%)
//  戻り : 0=なし / 1=C / 2=B / 3=A
// ============================================================
f_rank(float pct) =>
    int r = 0
    if not na(pct)
        if useFibRankA and pct >= fibAStart and pct <= fibAEnd
            r := 3
        else if useFibRankB and pct >= fibBStart and pct < fibBEnd
            r := 2
        else if useFibRankC and pct >= fibCStart and pct < fibCEnd
            r := 1
    r

f_rankName(int r) => r == 3 ? "A" : r == 2 ? "B" : r == 1 ? "C" : "None"

buyRank  = buyEnabled  ? f_rank(buyRetracePct)  : 0
sellRank = sellEnabled ? f_rank(sellRetracePct) : 0

// ============================================================
//  11. 各ランクのゾーン価格 (BUY / SELL)
// ============================================================
// --- BUY (高値から下方向に押す) ---
buyZoneAHigh = buySwingHigh - fibAStart * buyRangeVal
buyZoneALow  = buySwingHigh - fibAEnd   * buyRangeVal
buyZoneBHigh = buySwingHigh - fibBStart * buyRangeVal
buyZoneBLow  = buySwingHigh - fibBEnd   * buyRangeVal
buyZoneCHigh = buySwingHigh - fibCStart * buyRangeVal
buyZoneCLow  = buySwingHigh - fibCEnd   * buyRangeVal

// --- SELL (安値から上方向に戻す) ---
sellZoneALow  = sellSwingLow + fibAStart * sellRangeVal
sellZoneAHigh = sellSwingLow + fibAEnd   * sellRangeVal
sellZoneBLow  = sellSwingLow + fibBStart * sellRangeVal
sellZoneBHigh = sellSwingLow + fibBEnd   * sellRangeVal
sellZoneCLow  = sellSwingLow + fibCStart * sellRangeVal
sellZoneCHigh = sellSwingLow + fibCEnd   * sellRangeVal

// アクティブランクのゾーン高安
buyZoneHigh  = buyRank == 3 ? buyZoneAHigh : buyRank == 2 ? buyZoneBHigh : buyRank == 1 ? buyZoneCHigh : na
buyZoneLow   = buyRank == 3 ? buyZoneALow  : buyRank == 2 ? buyZoneBLow  : buyRank == 1 ? buyZoneCLow  : na
sellZoneHigh = sellRank == 3 ? sellZoneAHigh : sellRank == 2 ? sellZoneBHigh : sellRank == 1 ? sellZoneCHigh : na
sellZoneLow  = sellRank == 3 ? sellZoneALow  : sellRank == 2 ? sellZoneBLow  : sellRank == 1 ? sellZoneCLow  : na

// ============================================================
//  12. ローソク足 / 反転確認
// ============================================================
body     = math.abs(close - open)
bodyPrev = math.abs(close[1] - open[1])
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bullCandle = close > open
bearCandle = close < open

buyPinbar  = body > 0 and lowerWick >= pinbarWickRatio * body and lowerWick > upperWick
sellPinbar = body > 0 and upperWick >= pinbarWickRatio * body and upperWick > lowerWick

bullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1] and body >= engulfingBodyRatio * bodyPrev
bearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1] and body >= engulfingBodyRatio * bodyPrev

breakPrevHigh = high > high[1]
breakPrevLow  = low  < low[1]

// BUY 反転確認 : ON の条件のいずれかを満たせば OK
buyConfirm = (useBullCandleConfirm and bullCandle) or (usePinbarConfirm and buyPinbar) or (useEngulfingConfirm and bullEngulf) or (useEma20Confirm and close > ema20) or (useBreakPrevCandleConfirm and breakPrevHigh)
// SELL 反転確認
sellConfirm = (useBearCandleConfirm and bearCandle) or (usePinbarConfirm and sellPinbar) or (useEngulfingConfirm and bearEngulf) or (useEma20Confirm and close < ema20) or (useBreakPrevCandleConfirm and breakPrevLow)

// ============================================================
//  13. ゾーン到達 / シグナル
// ============================================================
confirmedOK = not requireConfirmedBar or barstate.isconfirmed

fibBuyZone  = buyEnabled  and buyWaveValid  and buyRank  > 0
fibSellZone = sellEnabled and sellWaveValid and sellRank > 0

fibBuySignal  = fibBuyZone  and (not useFibRejectConfirm or buyConfirm)  and confirmedOK
fibSellSignal = fibSellZone and (not useFibRejectConfirm or sellConfirm) and confirmedOK

// ============================================================
//  13b. シグナル発生後の波リセット
// ------------------------------------------------------------
//  当該足ではゾーン到達済みの固定波を使用済みなので、
//  ロックを解除して次足で新しい波を再固定させる。
// ============================================================
if useFixedFibWave and resetFibWaveOnSignal
    if fibBuySignal
        buyLocked := false
    if fibSellSignal
        sellLocked := false

// ============================================================
//  14. 出力
// ============================================================
// --- BUY ---
fibBuyRank      = buyRank
fibBuyRankName  = f_rankName(buyRank)
fibBuyRetracePct = buyRetracePct
fibBuyZoneHigh  = buyZoneHigh
fibBuyZoneLow   = buyZoneLow
fibBuySwingLow  = buyWaveValid ? buySwingLow  : na
fibBuySwingHigh = buyWaveValid ? buySwingHigh : na

// --- SELL ---
fibSellRank      = sellRank
fibSellRankName  = f_rankName(sellRank)
fibSellRetracePct = sellRetracePct
fibSellZoneHigh  = sellZoneHigh
fibSellZoneLow   = sellZoneLow
fibSellSwingHigh = sellWaveValid ? sellSwingHigh : na
fibSellSwingLow  = sellWaveValid ? sellSwingLow  : na

// --- 共通 ---
fibActive    = fibBuyZone or fibSellZone
fibDirection = fibBuySignal ? 1 : fibSellSignal ? -1 : fibBuyZone ? 1 : fibSellZone ? -1 : 0
fibRank      = fibDirection == 1 ? buyRank : fibDirection == -1 ? sellRank : 0
fibRankName  = f_rankName(fibRank)

// ============================================================
//  15. ゾーン描画
// ============================================================
var box bxBuyA  = na
var box bxBuyB  = na
var box bxBuyC  = na
var box bxSellA = na
var box bxSellB = na
var box bxSellC = na

f_delBox(box b) =>
    if not na(b)
        box.delete(b)

if barstate.islast
    f_delBox(bxBuyA)
    f_delBox(bxBuyB)
    f_delBox(bxBuyC)
    f_delBox(bxSellA)
    f_delBox(bxSellB)
    f_delBox(bxSellC)
    bxBuyA := na
    bxBuyB := na
    bxBuyC := na
    bxSellA := na
    bxSellB := na
    bxSellC := na

    if showFibZones and buyEnabled and buyWaveValid
        leftBuy  = buyLowBar
        rightBuy = bar_index + 5
        if useFibRankA
            bxBuyA := box.new(leftBuy, buyZoneAHigh, rightBuy, buyZoneALow, border_color = color.new(color.green, 0), bgcolor = colBuyA)
        if useFibRankB
            bxBuyB := box.new(leftBuy, buyZoneBHigh, rightBuy, buyZoneBLow, border_color = color.new(color.green, 0), bgcolor = colBuyB)
        if useFibRankC
            bxBuyC := box.new(leftBuy, buyZoneCHigh, rightBuy, buyZoneCLow, border_color = color.new(color.green, 0), bgcolor = colBuyC)

    if showFibZones and sellEnabled and sellWaveValid
        leftSell  = sellHighBar
        rightSell = bar_index + 5
        if useFibRankA
            bxSellA := box.new(leftSell, sellZoneAHigh, rightSell, sellZoneALow, border_color = color.new(color.red, 0), bgcolor = colSellA)
        if useFibRankB
            bxSellB := box.new(leftSell, sellZoneBHigh, rightSell, sellZoneBLow, border_color = color.new(color.red, 0), bgcolor = colSellB)
        if useFibRankC
            bxSellC := box.new(leftSell, sellZoneCHigh, rightSell, sellZoneCLow, border_color = color.new(color.red, 0), bgcolor = colSellC)

// ============================================================
//  16. シグナルラベル
// ============================================================
if showFibLabels and fibBuySignal
    label.new(bar_index, low, "BUY " + fibBuyRankName + "\n" + str.tostring(math.round(buyRetracePct * 100, 1)) + "%", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)

if showFibLabels and fibSellSignal
    label.new(bar_index, high, "SELL " + fibSellRankName + "\n" + str.tostring(math.round(sellRetracePct * 100, 1)) + "%", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

// ============================================================
//  17. デバッグテーブル (右下)
// ============================================================
var table dbg = table.new(position.bottom_right, 2, 6, border_width = 1)

f_dir2txt(int d) => d == 1 ? "BUY" : d == -1 ? "SELL" : "None"

if showFibDebugTable and barstate.islast
    activeRetrace = fibDirection == 1 ? buyRetracePct : fibDirection == -1 ? sellRetracePct : na
    activeZone    = fibDirection == 1 ? fibBuyZone : fibDirection == -1 ? fibSellZone : false
    activeSignal  = fibDirection == 1 ? fibBuySignal : fibDirection == -1 ? fibSellSignal : false
    dirCol = fibDirection == 1 ? color.new(color.green, 0) : fibDirection == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

    table.cell(dbg, 0, 0, "FIB", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, "値",   text_color = color.white, bgcolor = color.new(color.blue, 0))

    table.cell(dbg, 0, 1, "direction", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(dbg, 1, 1, f_dir2txt(fibDirection), text_color = color.white, bgcolor = dirCol)

    table.cell(dbg, 0, 2, "retrace %", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(dbg, 1, 2, na(activeRetrace) ? "-" : str.tostring(math.round(activeRetrace * 100, 1)) + "%", text_color = color.white, bgcolor = color.new(color.gray, 50))

    table.cell(dbg, 0, 3, "rank", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(dbg, 1, 3, fibRankName, text_color = color.white, bgcolor = color.new(color.gray, 50))

    table.cell(dbg, 0, 4, "zone", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(dbg, 1, 4, activeZone ? "true" : "false", text_color = color.white, bgcolor = activeZone ? color.new(color.teal, 20) : color.new(color.gray, 50))

    table.cell(dbg, 0, 5, "signal", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(dbg, 1, 5, activeSignal ? "true" : "false", text_color = color.white, bgcolor = activeSignal ? color.new(color.orange, 0) : color.new(color.gray, 50))

// ============================================================
//  18. アラート
// ============================================================
fibA_buy  = fibBuySignal  and fibBuyRank  == 3
fibB_buy  = fibBuySignal  and fibBuyRank  == 2
fibC_buy  = fibBuySignal  and fibBuyRank  == 1
fibA_sell = fibSellSignal and fibSellRank == 3
fibB_sell = fibSellSignal and fibSellRank == 2
fibC_sell = fibSellSignal and fibSellRank == 1

alertcondition(fibBuySignal,  "Fib BUY Signal",  "{{ticker}} : フィボ BUY シグナル ({{close}})")
alertcondition(fibSellSignal, "Fib SELL Signal", "{{ticker}} : フィボ SELL シグナル ({{close}})")
alertcondition(fibA_buy,  "Fib A BUY",  "{{ticker}} : フィボ A ランク BUY ({{close}})")
alertcondition(fibB_buy,  "Fib B BUY",  "{{ticker}} : フィボ B ランク BUY ({{close}})")
alertcondition(fibC_buy,  "Fib C BUY",  "{{ticker}} : フィボ C ランク BUY ({{close}})")
alertcondition(fibA_sell, "Fib A SELL", "{{ticker}} : フィボ A ランク SELL ({{close}})")
alertcondition(fibB_sell, "Fib B SELL", "{{ticker}} : フィボ B ランク SELL ({{close}})")
alertcondition(fibC_sell, "Fib C SELL", "{{ticker}} : フィボ C ランク SELL ({{close}})")

// ============================================================
//  19. Data Window 出力
// ============================================================
plot(fibDirection,     "fibDirection",     display = display.data_window)
plot(fibRank,          "fibRank",          display = display.data_window)
plot(fibActive ? 1 : 0, "fibActive",       display = display.data_window)
plot(fibBuyRank,       "fibBuyRank",       display = display.data_window)
plot(fibBuyRetracePct, "fibBuyRetracePct", display = display.data_window)
plot(fibBuyZone ? 1 : 0,  "fibBuyZone",    display = display.data_window)
plot(fibBuySignal ? 1 : 0, "fibBuySignal", display = display.data_window)
plot(fibBuyZoneHigh,   "fibBuyZoneHigh",   display = display.data_window)
plot(fibBuyZoneLow,    "fibBuyZoneLow",    display = display.data_window)
plot(fibBuySwingLow,   "fibBuySwingLow",   display = display.data_window)
plot(fibBuySwingHigh,  "fibBuySwingHigh",  display = display.data_window)
plot(fibSellRank,      "fibSellRank",      display = display.data_window)
plot(fibSellRetracePct, "fibSellRetracePct", display = display.data_window)
plot(fibSellZone ? 1 : 0,  "fibSellZone",  display = display.data_window)
plot(fibSellSignal ? 1 : 0, "fibSellSignal", display = display.data_window)
plot(fibSellZoneHigh,  "fibSellZoneHigh",  display = display.data_window)
plot(fibSellZoneLow,   "fibSellZoneLow",   display = display.data_window)
plot(fibSellSwingHigh, "fibSellSwingHigh", display = display.data_window)
plot(fibSellSwingLow,  "fibSellSwingLow",  display = display.data_window)

// --- 固定波の情報 ---
plot(buyLocked  ? 1 : 0, "buyWaveLocked",  display = display.data_window)
plot(sellLocked ? 1 : 0, "sellWaveLocked", display = display.data_window)
plot(useFixB ? fixBuyLow   : na, "fixBuyLow",   display = display.data_window)
plot(useFixB ? fixBuyHigh  : na, "fixBuyHigh",  display = display.data_window)
plot(useFixS ? fixSellHigh : na, "fixSellHigh", display = display.data_window)
plot(useFixS ? fixSellLow  : na, "fixSellLow",  display = display.data_window)
plot(useFixB and not na(fixBuyBar)  ? bar_index - fixBuyBar  : na, "buyWaveAgeBars",  display = display.data_window)
plot(useFixS and not na(fixSellBar) ? bar_index - fixSellBar : na, "sellWaveAgeBars", display = display.data_window)

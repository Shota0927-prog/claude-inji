//
// ============================================================
//  Trade Management Module (Strategy 貼り付け用)
// ============================================================
//  既存 strategy に貼り付けて使う「決済管理モジュール」。
//    1. 建値移動 (Breakeven)
//    2. 建値決済後の再エントリー
//    3. MA に沿った SL 調整 (損切り側 MA へスナップ)
//    4. MA に沿った TP 調整 (利確側 MA へスナップ)
//    5. 部分利確 (Accum15 / RR / Dollar)
//
//  ※ これは indicator ではなく strategy。strategy.entry/exit/close/
//    closedtrades/opentrades を使用する。
//  ※ Pine v5 制約: strategy.* は user-defined function 内から呼べないため、
//    エントリー記録/BE/再エントリーは global スコープの if ブロックで実装。
//  ※ 既存 tag と衝突しないよう tm_ / TM_ / RE_ prefix を使用。
//
//  ▼ 接続方法:
//    下の「ユーザー接続部」のブリッジ変数を、既存戦略の値へ差し替える。
//    tmEntryLong / tmEntryShort … エントリーシグナル (bool)
//    tmRiskWidth … リスク幅($)   tmRR … リワード倍率   tmQty … 数量
//    newAccum15  … 部分利確(Accum15)用シグナル
//    maArr       … 既存の MA 配列があればそれを使用 (無ければ本モジュールが生成)
// ============================================================

// ============================================================
//  ※ これは貼り付け用モジュール (コードブロック) です。
//    strategy() 宣言は持ちません。既存 strategy ファイルの中に
//    そのまま貼り付けて使ってください (//@version=5 と strategy() は
//    ホスト側の既存戦略のものを使用)。
//
//  注意：このモジュールを使う場合、既存strategy側のstrategy.entryはOFFにすること。
//  二重発注を避けるため、エントリー実行はこのTrade Management Moduleに集約する (A案)。
// ============================================================

// ============================================================
//  1. Input
// ============================================================
groupTradeMgmt = "Trade Management Module"

useTradeMgmtModule = input.bool(true, "Trade Managementを使う", group = groupTradeMgmt)

useBE     = input.bool(true, "建値移動ON", group = groupTradeMgmt)
beTrigger = input.float(15.0, "建値移動 発動幅($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)
beOffset  = input.float(0.0, "建値オフセット($)", step = 0.1, group = groupTradeMgmt)

useReentry = input.bool(true, "建値決済後に再エントリー", group = groupTradeMgmt)
maxReentry = input.int(1, "再エントリー最大回数", minval = 1, group = groupTradeMgmt)

useMaSLTP = input.bool(true,  "MAでSL/TP調整ON", group = groupTradeMgmt)
useMaSL   = input.bool(true,  "MAでSL調整ON", group = groupTradeMgmt)
useMaTP   = input.bool(false, "MAでTP調整ON", group = groupTradeMgmt)

maSlBuffer      = input.float(3.0,  "MAスナップ余白 SL($)", minval = 0.0, step = 0.1, group = groupTradeMgmt)
maTpBuffer      = input.float(1.0,  "MAスナップ余白 TP($)", minval = 0.0, step = 0.1, group = groupTradeMgmt)
maSnapMaxMult   = input.float(1.5,  "SLスナップ許容倍率", minval = 1.0, step = 0.1, group = groupTradeMgmt)
maTpSnapBandPct = input.float(10.0, "TPスナップ許容バンド(±%)", minval = 0.0, step = 1.0, group = groupTradeMgmt)

usePartialTP = input.bool(true, "部分利確ON", group = groupTradeMgmt)
partialPct   = input.float(70.0, "部分利確割合(%)", minval = 1, maxval = 100, group = groupTradeMgmt)

partialTriggerMode = input.string("Accum15", "部分利確条件", options = ["Accum15", "RR", "Dollar"], group = groupTradeMgmt)
partialRR     = input.float(1.0,  "部分利確RR", minval = 0.1, step = 0.1, group = groupTradeMgmt)
partialDollar = input.float(15.0, "部分利確幅($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)

// --- Fibonacci Expansion ---
useFibExpansion = input.bool(true, "Fib Expansionを使う", group = groupTradeMgmt)
fibSwingLen     = input.int(20, "Fib Expansion Swing Lookback", minval = 2, group = groupTradeMgmt)
fibExpTPMode    = input.string("Off", "Fib Expansion TP調整", options = ["Off", "TP1_100", "TP2_127", "TP3_161", "TP4_200"], group = groupTradeMgmt)

useFibPartialTP = input.bool(false, "Fib到達で部分利確", group = groupTradeMgmt)
fibPartialLevel = input.string("127.2", "Fib部分利確Level", options = ["100", "127.2", "161.8", "200"], group = groupTradeMgmt)

useFibRoomFilter = input.bool(false, "Fib伸びしろ不足でNoTrade", group = groupTradeMgmt)
minFibRoomDollar = input.float(5.0, "最低Fib伸びしろ($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)

useFibOverExtensionFilter = input.bool(false, "Fib伸び切りで追いかけ禁止", group = groupTradeMgmt)
fibOverExtensionLevel     = input.string("161.8", "伸び切り判定Level", options = ["127.2", "161.8", "200"], group = groupTradeMgmt)

// ============================================================
//  2. 接続用ブリッジ変数
//  既存strategy側で以下を定義してから、このモジュールを貼り付けること
// ============================================================
// bool  tmEntryLong   = entrySignalLong
// bool  tmEntryShort  = entrySignalShort
// float tmRiskWidth   = riskWidth
// float tmRR          = rrValue
// float tmQty         = qty
// bool  newAccum15    = newAccum15_from_existing_logic
//
// (任意) 既存のエントリータグを使う場合のみ有効化:
// string tmBaseTag    = entryTag
//
// 注意：このモジュール内では上記変数を再定義しない。
// 既存strategy側の変数をそのまま参照する。

// ============================================================
//  3. MA 配列 (既存 maArr があれば不要 / 確定値・lookahead_off)
//  ※ 既存strategy側に maArr がある場合は、このMA生成ブロックを削除し、
//    既存 maArr を使うこと。
// ============================================================
ema_1m_1000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_1m_3000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_5m_1000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_5m_3000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_15m_1000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_15m_3000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_1h_1000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_1h_3000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_4h_1000  = request.security(syminfo.tickerid, "240", ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_4h_3000  = request.security(syminfo.tickerid, "240", ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
maArr = array.from(ema_1m_1000, ema_1m_3000, ema_5m_1000, ema_5m_3000, ema_15m_1000, ema_15m_3000, ema_1h_1000, ema_1h_3000, ema_4h_1000, ema_4h_3000)

// ============================================================
//  4. MA SL スナップ関数 (損切り側 MA だけを見る)
// ============================================================
f_snap_sl_to_ema(_dir, _entry, _slRaw) =>
    _sl = _slRaw
    if useTradeMgmtModule and useMaSLTP and useMaSL and array.size(maArr) > 0
        float _bestMA = na
        float _bestD  = na
        for i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, i)
            // BUY は entry より下の MA / SELL は entry より上の MA
            _valid = _dir == 1 ? _m < _entry : _m > _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _slRaw)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maSlBuffer : _bestMA + maSlBuffer
            _riskRaw  = math.abs(_entry - _slRaw)
            _riskSnap = math.abs(_entry - _cand)
            if _riskRaw > 0 and _riskSnap <= _riskRaw * maSnapMaxMult
                _sl := _cand
    _sl

// ============================================================
//  5. MA TP スナップ関数 (利確側 MA だけを見る)
// ============================================================
f_snap_tp_to_ema(_dir, _entry, _tpRaw) =>
    _tp = _tpRaw
    if useTradeMgmtModule and useMaSLTP and useMaTP and array.size(maArr) > 0
        _rewardRaw = math.abs(_tpRaw - _entry)
        float _bestMA = na
        float _bestD  = na
        for i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, i)
            // BUY は entry より上の MA / SELL は entry より下の MA
            _valid = _dir == 1 ? _m > _entry : _m < _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _tpRaw)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maTpBuffer : _bestMA + maTpBuffer
            _candReward = _dir == 1 ? _cand - _entry : _entry - _cand
            _band = maTpSnapBandPct / 100.0
            _loR  = _rewardRaw * (1.0 - _band)
            _hiR  = _rewardRaw * (1.0 + _band)
            if _candReward >= _loR and _candReward <= _hiR
                _tp := _cand
    _tp

// ============================================================
//  5'. Fibonacci Expansion 計算 (直近高安ベース・簡易版)
// ============================================================
float fibSwingHigh = ta.highest(high, fibSwingLen)
float fibSwingLow  = ta.lowest(low,  fibSwingLen)
float fibRange     = fibSwingHigh - fibSwingLow

// BUY Expansion (上方向)
float fibExpBuy100 = fibSwingLow + fibRange * 1.0
float fibExpBuy127 = fibSwingLow + fibRange * 1.272
float fibExpBuy161 = fibSwingLow + fibRange * 1.618
float fibExpBuy200 = fibSwingLow + fibRange * 2.0

// SELL Expansion (下方向)
float fibExpSell100 = fibSwingHigh - fibRange * 1.0
float fibExpSell127 = fibSwingHigh - fibRange * 1.272
float fibExpSell161 = fibSwingHigh - fibRange * 1.618
float fibExpSell200 = fibSwingHigh - fibRange * 2.0

// Fib TP 選択 (_dir: 1=BUY / -1=SELL)
f_fib_tp(_dir) =>
    float _tp = na
    if _dir == 1
        _tp := fibExpTPMode == "TP1_100" ? fibExpBuy100 :
               fibExpTPMode == "TP2_127" ? fibExpBuy127 :
               fibExpTPMode == "TP3_161" ? fibExpBuy161 :
               fibExpTPMode == "TP4_200" ? fibExpBuy200 : na
    if _dir == -1
        _tp := fibExpTPMode == "TP1_100" ? fibExpSell100 :
               fibExpTPMode == "TP2_127" ? fibExpSell127 :
               fibExpTPMode == "TP3_161" ? fibExpSell161 :
               fibExpTPMode == "TP4_200" ? fibExpSell200 : na
    _tp

// Fib 伸びしろ判定 (次ターゲット = 127.2)
float fibNextTargetLong  = fibExpBuy127
float fibNextTargetShort = fibExpSell127
float fibRoomLong  = fibNextTargetLong - close
float fibRoomShort = close - fibNextTargetShort
bool fibRoomOkLong  = not useFibRoomFilter or not useFibExpansion or fibRoomLong  >= minFibRoomDollar
bool fibRoomOkShort = not useFibRoomFilter or not useFibExpansion or fibRoomShort >= minFibRoomDollar

// Fib 伸び切り判定
bool fibOverLong =
     fibOverExtensionLevel == "127.2" ? close >= fibExpBuy127 :
     fibOverExtensionLevel == "161.8" ? close >= fibExpBuy161 :
     close >= fibExpBuy200
bool fibOverShort =
     fibOverExtensionLevel == "127.2" ? close <= fibExpSell127 :
     fibOverExtensionLevel == "161.8" ? close <= fibExpSell161 :
     close <= fibExpSell200
bool fibOverOkLong  = not useFibOverExtensionFilter or not useFibExpansion or not fibOverLong
bool fibOverOkShort = not useFibOverExtensionFilter or not useFibExpansion or not fibOverShort

// ============================================================
//  6. 状態変数
// ============================================================
var map<string, float> tmTpMap = map.new<string, float>()

var string tmCurTag      = na
var bool   tmPartialDone = false
var bool   tmBeMoved     = false
var bool   tmArmReentry  = false

var bool   tmReCurIsLong = false
var float  tmReEntryPx   = na
var float  tmReRiskW     = na
var float  tmReRR        = na
var int    tmReentryCount = 0

var int    tmLastEntryBar = na

var float  tmFinalSL = na
var float  tmFinalTP = na

// バー内イベントフラグ (Alert 用)
bool tmPartialEvent  = false
bool tmBeEvent       = false
bool tmBeClosedEvent = false
bool tmReentryEvent  = false
bool tmFibPartialEvent = false

// ============================================================
//  7. エントリー時の記録 (strategy.entry 直後に SL/TP スナップ + 状態保存)
// ============================================================
bool tmFlat = strategy.position_size == 0

// ---- BUY ----
if useTradeMgmtModule and tmEntryLong and tmFlat and fibRoomOkLong and fibOverOkLong
    float _entry = close
    float _slRaw = _entry - tmRiskWidth
    float _tpRaw = _entry + tmRiskWidth * tmRR
    // Fib Expansion TP を反映 (entry より上のときのみ採用)
    float _fibTP = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(1) : na
    if not na(_fibTP) and _fibTP > _entry
        _tpRaw := _fibTP
    float _slF = f_snap_sl_to_ema(1, _entry, _slRaw)
    float _tpF = f_snap_tp_to_ema(1, _entry, _tpRaw)
    // 既存 entryTag を使う場合は次行に差し替え:
    // string _tag = na(tmBaseTag) ? "TM_" + str.tostring(bar_index) : tmBaseTag + "_" + str.tostring(bar_index)
    string _tag = "TM_" + str.tostring(bar_index)
    strategy.entry(_tag, strategy.long, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _slF, limit = _tpF)
    map.put(tmTpMap, _tag, _tpF)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmReCurIsLong  := true
    tmReEntryPx    := _entry
    tmReRiskW      := math.abs(_entry - _slF)
    tmReRR         := tmRR
    tmBeMoved      := false
    tmReentryCount := 0
    tmLastEntryBar := bar_index
    tmFinalSL      := _slF
    tmFinalTP      := _tpF

// ---- SELL ----
if useTradeMgmtModule and tmEntryShort and tmFlat and fibRoomOkShort and fibOverOkShort
    float _entry = close
    float _slRaw = _entry + tmRiskWidth
    float _tpRaw = _entry - tmRiskWidth * tmRR
    // Fib Expansion TP を反映 (entry より下のときのみ採用)
    float _fibTP = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(-1) : na
    if not na(_fibTP) and _fibTP < _entry
        _tpRaw := _fibTP
    float _slF = f_snap_sl_to_ema(-1, _entry, _slRaw)
    float _tpF = f_snap_tp_to_ema(-1, _entry, _tpRaw)
    // 既存 entryTag を使う場合は次行に差し替え:
    // string _tag = na(tmBaseTag) ? "TM_" + str.tostring(bar_index) : tmBaseTag + "_" + str.tostring(bar_index)
    string _tag = "TM_" + str.tostring(bar_index)
    strategy.entry(_tag, strategy.short, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _slF, limit = _tpF)
    map.put(tmTpMap, _tag, _tpF)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmReCurIsLong  := false
    tmReEntryPx    := _entry
    tmReRiskW      := math.abs(_entry - _slF)
    tmReRR         := tmRR
    tmBeMoved      := false
    tmReentryCount := 0
    tmLastEntryBar := bar_index
    tmFinalSL      := _slF
    tmFinalTP      := _tpF

// ============================================================
//  8. 部分利確 (1 トレード 1 回 / エントリー足では発動しない)
// ============================================================
bool tmAfterEntryBar = bar_index > nz(tmLastEntryBar, -1)

// Fib 部分利確ターゲット価格 (方向別)
float fibPartialTarget = tmReCurIsLong ?
     (fibPartialLevel == "100" ? fibExpBuy100 : fibPartialLevel == "127.2" ? fibExpBuy127 : fibPartialLevel == "161.8" ? fibExpBuy161 : fibExpBuy200) :
     (fibPartialLevel == "100" ? fibExpSell100 : fibPartialLevel == "127.2" ? fibExpSell127 : fibPartialLevel == "161.8" ? fibExpSell161 : fibExpSell200)
bool fibPartialTrigger = useFibExpansion and useFibPartialTP and (tmReCurIsLong ? high >= fibPartialTarget : low <= fibPartialTarget)

bool partialTrigger =
     (partialTriggerMode == "Accum15" ? newAccum15 :
      partialTriggerMode == "RR"      ? (tmReCurIsLong ? high >= tmReEntryPx + tmReRiskW * partialRR : low <= tmReEntryPx - tmReRiskW * partialRR) :
      (tmReCurIsLong ? high >= tmReEntryPx + partialDollar : low <= tmReEntryPx - partialDollar))
     or fibPartialTrigger

if useTradeMgmtModule and usePartialTP and strategy.position_size != 0 and not tmPartialDone and not na(tmCurTag) and tmAfterEntryBar
    if partialTrigger
        strategy.close(tmCurTag, qty_percent = partialPct, comment = "PT")
        tmPartialDone := true
        tmPartialEvent := true
        if fibPartialTrigger
            tmFibPartialEvent := true

// ============================================================
//  9. 建値移動 (含み益が beTrigger に到達したら SL を建値へ / 1 回だけ)
// ============================================================
if useTradeMgmtModule and useBE and not tmBeMoved and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        _eid  = strategy.opentrades.entry_id(i)
        _ep   = strategy.opentrades.entry_price(i)
        _long = strategy.opentrades.size(i) > 0
        float _tp = map.contains(tmTpMap, _eid) ? map.get(tmTpMap, _eid) : na
        if _long and high >= _ep + beTrigger
            strategy.exit(_eid + "_x", from_entry = _eid, stop = _ep + beOffset, limit = _tp)
            tmBeMoved := true
            tmBeEvent := true
            tmFinalSL := _ep + beOffset
        if not _long and low <= _ep - beTrigger
            strategy.exit(_eid + "_x", from_entry = _eid, stop = _ep - beOffset, limit = _tp)
            tmBeMoved := true
            tmBeEvent := true
            tmFinalSL := _ep - beOffset

// ============================================================
//  10. 建値決済検知 (BE 後にポジションが建値で閉じたか)
// ============================================================
if useTradeMgmtModule and useReentry and tmBeMoved and strategy.position_size == 0 and strategy.position_size[1] != 0 and strategy.closedtrades > 0 and tmReentryCount < maxReentry
    float _exitP  = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float _entryP = strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    if not na(_exitP) and not na(_entryP) and math.abs(_exitP - _entryP) <= syminfo.mintick * 5
        tmArmReentry := true
        tmBeClosedEvent := true

// ============================================================
//  11. 再エントリー実行 (MA SL/TP スナップを再適用)
// ============================================================
if useTradeMgmtModule and tmArmReentry and strategy.position_size == 0
    int   _dir  = tmReCurIsLong ? 1 : -1
    float _e2   = close
    float _sl2r = tmReCurIsLong ? _e2 - tmReRiskW : _e2 + tmReRiskW
    float _tp2r = tmReCurIsLong ? _e2 + tmReRiskW * tmReRR : _e2 - tmReRiskW * tmReRR
    // Fib Expansion TP を反映 (entry より有利方向のときのみ採用)
    float _fibTP2 = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(_dir) : na
    if not na(_fibTP2) and ((tmReCurIsLong and _fibTP2 > _e2) or (not tmReCurIsLong and _fibTP2 < _e2))
        _tp2r := _fibTP2
    float _sl2  = f_snap_sl_to_ema(_dir, _e2, _sl2r)
    float _tp2  = f_snap_tp_to_ema(_dir, _e2, _tp2r)
    string _tag = "RE_" + str.tostring(bar_index)
    strategy.entry(_tag, tmReCurIsLong ? strategy.long : strategy.short, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _sl2, limit = _tp2)
    map.put(tmTpMap, _tag, _tp2)
    tmReentryCount := tmReentryCount + 1
    tmReEntryPx    := _e2
    tmReRiskW      := math.abs(_e2 - _sl2)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmBeMoved      := false
    tmLastEntryBar := bar_index
    tmFinalSL      := _sl2
    tmFinalTP      := _tp2
    tmReentryEvent := true
    tmArmReentry   := false

// ============================================================
//  12. 出力 (Data Window)
// ============================================================
plot(tmFinalSL,  "tmFinalSL",  display = display.data_window)
plot(tmFinalTP,  "tmFinalTP",  display = display.data_window)
plot(tmReRiskW,  "tmReRiskW",  display = display.data_window)
plot(tmReRR,     "tmReRR",     display = display.data_window)
plot(tmPartialDone ? 1 : 0, "tmPartialDone",  display = display.data_window)
plot(tmBeMoved     ? 1 : 0, "tmBeMoved",      display = display.data_window)
plot(tmArmReentry  ? 1 : 0, "tmArmReentry",   display = display.data_window)
plot(tmReentryCount,        "tmReentryCount", display = display.data_window)

// --- Fib Expansion 出力 ---
plot(fibExpBuy100, "fibExpBuy100", display = display.data_window)
plot(fibExpBuy127, "fibExpBuy127", display = display.data_window)
plot(fibExpBuy161, "fibExpBuy161", display = display.data_window)
plot(fibExpBuy200, "fibExpBuy200", display = display.data_window)
plot(fibExpSell100, "fibExpSell100", display = display.data_window)
plot(fibExpSell127, "fibExpSell127", display = display.data_window)
plot(fibExpSell161, "fibExpSell161", display = display.data_window)
plot(fibExpSell200, "fibExpSell200", display = display.data_window)
plot(fibRoomLong,  "fibRoomLong",  display = display.data_window)
plot(fibRoomShort, "fibRoomShort", display = display.data_window)
plot(fibRoomOkLong  ? 1 : 0, "fibRoomOkLong",  display = display.data_window)
plot(fibRoomOkShort ? 1 : 0, "fibRoomOkShort", display = display.data_window)
plot(fibOverLong  ? 1 : 0, "fibOverLong",  display = display.data_window)
plot(fibOverShort ? 1 : 0, "fibOverShort", display = display.data_window)
plot(fibOverOkLong  ? 1 : 0, "fibOverOkLong",  display = display.data_window)
plot(fibOverOkShort ? 1 : 0, "fibOverOkShort", display = display.data_window)
plot(fibPartialTarget,        "fibPartialTarget",  display = display.data_window)
plot(fibPartialTrigger ? 1 : 0, "fibPartialTrigger", display = display.data_window)

// ============================================================
//  13. Alert
// ============================================================
alertcondition(tmPartialEvent,  "TradeMgmt Partial TP", "{{ticker}} 部分利確")
alertcondition(tmBeEvent,       "TradeMgmt BE Moved",   "{{ticker}} 建値移動")
alertcondition(tmBeClosedEvent, "TradeMgmt BE Closed",  "{{ticker}} 建値決済")
alertcondition(tmReentryEvent,  "TradeMgmt Reentry",    "{{ticker}} 再エントリー")
alertcondition(tmFibPartialEvent, "TradeMgmt Fib Partial TP", "{{ticker}} Fib部分利確")
alertcondition(useFibExpansion and useFibRoomFilter and not fibRoomOkLong,  "TradeMgmt Fib Room NG Long",  "{{ticker}} Fib伸びしろ不足(Long)")
alertcondition(useFibExpansion and useFibRoomFilter and not fibRoomOkShort, "TradeMgmt Fib Room NG Short", "{{ticker}} Fib伸びしろ不足(Short)")
alertcondition(useFibExpansion and fibOverLong,  "TradeMgmt Fib Over Long",  "{{ticker}} Fib伸び切り(Long)")
alertcondition(useFibExpansion and fibOverShort, "TradeMgmt Fib Over Short", "{{ticker}} Fib伸び切り(Short)")

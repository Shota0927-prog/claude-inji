// ============================================================
//  Silver 補助モジュール (Indicator版)
// ============================================================
//  ・Gold と Silver の関係で Goldエントリーの
//    先行確認 / 方向確認 / 逆行警戒 / 乖離確認 を行う。
//  ・このモジュール単体ではエントリーしない (補助)。
//  ・後で 環境認識 / フィボ / FVG / 出来高 / EMA / 水平線 /
//    DXY・金利 モジュールと AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・request.security は lookahead_off。ADX は使わない。
// ============================================================

//@version=5
indicator(
     title          = "Silver Aux Module",
     shorttitle     = "SILVER",
     overlay        = true,
     max_bars_back  = 1000
 )

// ============================================================
//  シンボル設定
// ============================================================
grpSym = "シンボル"
goldSymbol   = input.symbol("TVC:GOLD",   "Gold",   group = grpSym)
silverSymbol = input.symbol("TVC:SILVER", "Silver", group = grpSym)

// ============================================================
//  時間足 / 期間
// ============================================================
grpTF = "時間足 / 期間"
silverTF       = input.timeframe("60", "Silver 時間足", group = grpTF)
leadLookback   = input.int(10, "先行/方向 判定期間", minval = 1, group = grpTF)
recentLookback = input.int(3,  "直近 確認期間",     minval = 1, group = grpTF)

// ============================================================
//  ON/OFF
// ============================================================
grpSw = "ON/OFF"
useSilverModule    = input.bool(true, "Silverモジュール全体", group = grpSw)
useSilverLead      = input.bool(true, "A: Silver先行",        group = grpSw)
useSilverConfirm   = input.bool(true, "B: Silver方向一致",    group = grpSw)
useSilverConflict  = input.bool(true, "C: Silver逆行警戒",    group = grpSw)
useSilverDivergence= input.bool(true, "D: Gold/Silver乖離",   group = grpSw)
useSilverRank      = input.bool(true, "E: Silver確認ランク",  group = grpSw)

// ============================================================
//  Gold エントリー条件 (接続用 仮入力)
//   後で Gold側エントリーモジュールから受け取る
// ============================================================
grpGold = "Gold セットアップ (接続用 仮)"
goldLongSetup  = input.bool(false, "Gold ロング条件", group = grpGold)
goldShortSetup = input.bool(false, "Gold ショート条件", group = grpGold)

// ============================================================
//  しきい値
// ============================================================
grpTh = "しきい値"
silverMinChange     = input.float(0.5, "Silver 最小変化率(%)", minval = 0.0, step = 0.05, group = grpTh)
leadRatio           = input.float(2.0, "先行 比率 (silver/leadRatio)", minval = 0.1, step = 0.1, group = grpTh)
goldLagThreshold    = input.float(0.1, "Gold 未反応 変化率(%)", minval = 0.0, step = 0.05, group = grpTh)
divergenceThreshold = input.float(0.8, "乖離 しきい値(%)",     minval = 0.0, step = 0.05, group = grpTh)

// ============================================================
//  ボラフィルター
// ============================================================
grpVol = "ボラフィルター"
useSilverVolFilter = input.bool(false, "ボラフィルターを使う", group = grpVol)
atrLen          = input.int(14,  "Gold ATR期間",       minval = 1, group = grpVol)
atrRankLookback = input.int(100, "ATR percentile 期間", minval = 1, group = grpVol)
atrRankMin      = input.float(30, "ATR rank 最小(%)",   minval = 0.0, maxval = 100.0, step = 5, group = grpVol)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showSilverLabels    = input.bool(true, "シグナルラベル",   group = grpDisp)
showSilverDebugTable= input.bool(true, "デバッグテーブル", group = grpDisp)
showSilverBg        = input.bool(true, "背景色",           group = grpDisp)

// ============================================================
//  データ取得 (request.security / lookahead_off)
// ============================================================
float goldC   = request.security(goldSymbol,   silverTF, close, lookahead = barmerge.lookahead_off)
float silverC = request.security(silverSymbol, silverTF, close, lookahead = barmerge.lookahead_off)
float goldATR = request.security(goldSymbol,   silverTF, ta.atr(atrLen), lookahead = barmerge.lookahead_off)

// ============================================================
//  変化率計算
// ============================================================
f_chg(src, len) =>
    (na(src[len]) or src[len] == 0) ? 0.0 : (src - src[len]) / src[len] * 100.0

float silverChange       = f_chg(silverC, leadLookback)
float goldChange         = f_chg(goldC,   leadLookback)
float silverRecentChange = f_chg(silverC, recentLookback)
float goldRecentChange   = f_chg(goldC,   recentLookback)

bool sAct = useSilverModule

// ============================================================
//  A: Silver先行
// ============================================================
bool goldLag = math.abs(goldChange) <= goldLagThreshold
bool silverLeadLong  = sAct and useSilverLead and (silverChange >=  silverMinChange) and (goldLag or goldChange < silverChange / leadRatio)
bool silverLeadShort = sAct and useSilverLead and (silverChange <= -silverMinChange) and (goldLag or goldChange > silverChange / leadRatio)
int  silverLeadDirection = silverLeadLong ? 1 : silverLeadShort ? -1 : 0

// ============================================================
//  B: Silver方向一致
// ============================================================
bool silverConfirmLong  = sAct and useSilverConfirm and goldLongSetup  and silverChange > 0 and silverRecentChange > 0
bool silverConfirmShort = sAct and useSilverConfirm and goldShortSetup and silverChange < 0 and silverRecentChange < 0

// ============================================================
//  C: Silver逆行警戒
// ============================================================
bool silverConflictLong  = goldLongSetup  and silverChange < 0
bool silverConflictShort = goldShortSetup and silverChange > 0
bool silverConflict = sAct and useSilverConflict and (silverConflictLong or silverConflictShort)
int  silverConflictDirection = silverConflictLong ? 1 : silverConflictShort ? -1 : 0

// ============================================================
//  D: Gold/Silver乖離
// ============================================================
float divergenceAbs = math.abs(silverChange - goldChange)
bool  silverDivergence = sAct and useSilverDivergence and divergenceAbs >= divergenceThreshold
int   silverDivergenceDirection = silverDivergence ? (silverChange > goldChange ? 1 : -1) : 0

// ============================================================
//  ボラフィルター (Gold ATR percentile)
// ============================================================
float goldAtrRank = ta.percentrank(goldATR, atrRankLookback)
bool  silverVolOK = not useSilverVolFilter or (not na(goldAtrRank) and goldAtrRank >= atrRankMin)

// ============================================================
//  E: Silver確認ランク
//   0なし /1 方向一致 /2 先行 /3 先行+方向一致 /4 先行+一致+ボラOK
// ============================================================
bool hasLead    = silverLeadLong or silverLeadShort
bool hasConfirm = silverConfirmLong or silverConfirmShort
int  silverRank = (sAct and useSilverRank) ? (
                   (hasLead and hasConfirm and silverVolOK) ? 4 :
                   (hasLead and hasConfirm) ? 3 :
                   hasLead ? 2 :
                   hasConfirm ? 1 : 0) : 0

// ============================================================
//  Signal Type (0None/1Lead/2Confirm/3Conflict/4Divergence)
//   優先: Conflict > Lead > Divergence > Confirm
// ============================================================
int silverSignalType = not sAct ? 0 :
                        silverConflict ? 3 :
                        hasLead ? 1 :
                        silverDivergence ? 4 :
                        hasConfirm ? 2 : 0

// ============================================================
//  Direction (1=Gold BUY方向 / -1=SELL / 0=なし)
//   エントリー方向は Lead → Confirm → Divergence の順で採用
// ============================================================
int silverDirection = not sAct ? 0 :
                       hasLead ? silverLeadDirection :
                       hasConfirm ? (silverConfirmLong ? 1 : -1) :
                       silverDivergence ? silverDivergenceDirection : 0

// ============================================================
//  接続用出力
// ============================================================
bool allowLongBySilver  = sAct and not silverConflict and (silverLeadLong  or silverConfirmLong)
bool allowShortBySilver = sAct and not silverConflict and (silverLeadShort or silverConfirmShort)
bool silverNoTrade = silverConflict

// ============================================================
//  表示 : 背景色
// ============================================================
bgcolor(showSilverBg and silverConflict ? color.new(color.red, 90) : na, title = "Conflict BG")
bgcolor(showSilverBg and (silverLeadLong or silverLeadShort) ? color.new(color.blue, 92) : na, title = "Lead BG")

// ============================================================
//  表示 : ラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, isBuy ? low : high, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, yloc = isBuy ? yloc.belowbar : yloc.abovebar, size = size.small)

if showSilverLabels
    if silverLeadLong
        f_mkLabel(true,  "Lead↑", color.new(color.aqua, 0))
    if silverLeadShort
        f_mkLabel(false, "Lead↓", color.new(color.fuchsia, 0))
    if silverConfirmLong
        f_mkLabel(true,  "Confirm↑", color.new(color.green, 0))
    if silverConfirmShort
        f_mkLabel(false, "Confirm↓", color.new(color.red, 0))
    if silverConflict
        f_mkLabel(false, "⚠ Conflict", color.new(color.gray, 0))
    if silverDivergence
        f_mkLabel(silverDivergenceDirection == 1, "Div", color.new(color.orange, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Lead" : t == 2 ? "Confirm" : t == 3 ? "Conflict" : t == 4 ? "Divergence" : "-"

var table dbg = table.new(position.top_right, 2, 7, border_width = 1)
if showSilverDebugTable and barstate.islast
    string sDir = silverDirection == 1 ? "BUY" : silverDirection == -1 ? "SELL" : "-"
    table.cell(dbg, 0, 0, "Silver", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, silverNoTrade ? "NoTrade" : (silverDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = silverNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "Silver chg %", text_color = color.white)
    table.cell(dbg, 1, 1, na(silverChange) ? "-" : str.tostring(silverChange, "#.##"), text_color = color.white)
    table.cell(dbg, 0, 2, "Gold chg %", text_color = color.white)
    table.cell(dbg, 1, 2, na(goldChange) ? "-" : str.tostring(goldChange, "#.##"), text_color = color.white)
    table.cell(dbg, 0, 3, "Signal type", text_color = color.white)
    table.cell(dbg, 1, 3, f_typeStr(silverSignalType), text_color = color.white)
    table.cell(dbg, 0, 4, "Direction", text_color = color.white)
    table.cell(dbg, 1, 4, sDir, text_color = color.white)
    table.cell(dbg, 0, 5, "Rank", text_color = color.white)
    table.cell(dbg, 1, 5, str.tostring(silverRank), text_color = color.white)
    table.cell(dbg, 0, 6, "NoTrade", text_color = color.white)
    table.cell(dbg, 1, 6, silverNoTrade ? "Y" : "N", text_color = silverNoTrade ? color.red : color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(silverChange,       "silverChange",       display = display.data_window)
plot(goldChange,         "goldChange",         display = display.data_window)
plot(silverRecentChange, "silverRecentChange", display = display.data_window)
plot(goldRecentChange,   "goldRecentChange",   display = display.data_window)
plot(silverLeadLong  ? 1 : 0, "silverLeadLong",  display = display.data_window)
plot(silverLeadShort ? 1 : 0, "silverLeadShort", display = display.data_window)
plot(silverConfirmLong  ? 1 : 0, "silverConfirmLong",  display = display.data_window)
plot(silverConfirmShort ? 1 : 0, "silverConfirmShort", display = display.data_window)
plot(silverConflict   ? 1 : 0, "silverConflict",   display = display.data_window)
plot(silverDivergence ? 1 : 0, "silverDivergence", display = display.data_window)
plot(silverSignalType, "silverSignalType", display = display.data_window)
plot(silverDirection,  "silverDirection",  display = display.data_window)
plot(silverRank,       "silverRank",       display = display.data_window)
plot(allowLongBySilver  ? 1 : 0, "allowLongBySilver",  display = display.data_window)
plot(allowShortBySilver ? 1 : 0, "allowShortBySilver", display = display.data_window)
plot(silverNoTrade ? 1 : 0, "silverNoTrade", display = display.data_window)
plot(silverLeadDirection,       "silverLeadDirection",       display = display.data_window)
plot(silverConflictDirection,   "silverConflictDirection",   display = display.data_window)
plot(silverDivergenceDirection, "silverDivergenceDirection", display = display.data_window)
plot(goldAtrRank, "goldAtrRank", display = display.data_window)

// ============================================================
//  シグナル形状
// ============================================================
plotshape(allowLongBySilver,  title = "Allow Long",  style = shape.triangleup,   location = location.bottom, color = color.new(color.green, 0), size = size.tiny)
plotshape(allowShortBySilver, title = "Allow Short", style = shape.triangledown, location = location.top,    color = color.new(color.red, 0),   size = size.tiny)

// ============================================================
//  アラート
// ============================================================
alertcondition(silverLeadLong,     "Silver Lead Long",   "{{ticker}} Silver先行 ロング準備")
alertcondition(silverLeadShort,    "Silver Lead Short",  "{{ticker}} Silver先行 ショート準備")
alertcondition(silverConfirmLong,  "Silver Confirm Long","{{ticker}} Silver方向一致 ロング")
alertcondition(silverConfirmShort, "Silver Confirm Short","{{ticker}} Silver方向一致 ショート")
alertcondition(silverConflict,     "Silver Conflict",    "{{ticker}} Silver逆行警戒")
alertcondition(silverDivergence,   "Silver Divergence",  "{{ticker}} Gold/Silver乖離")
alertcondition(allowLongBySilver,  "Allow Long Silver",  "{{ticker}} Silver ロング許可")
alertcondition(allowShortBySilver, "Allow Short Silver", "{{ticker}} Silver ショート許可")
alertcondition(silverNoTrade,      "Silver NoTrade",     "{{ticker}} Silver ノートレード")

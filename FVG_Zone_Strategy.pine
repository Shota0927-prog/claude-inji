// ============================================================================
//  FVG + Support/Resistance Zone Engine Strategy
//  (Structural SL / TP · Multi Entry Logic 対応 共通Trade Engine)
// ============================================================================
//  設計思想:
//    ・Zone Engine      … 「どこが支えられ / 抵抗になり / どれだけ強いか」を検出する共通基盤。
//                          Entry Logicの存在を知らない。
//    ・Entry Logic      … 「エントリー条件が成立した」ことだけを返す。
//                          SL/TP計算・発注・勝敗管理を一切持たない。
//    ・Trade Engine     … Entry Price / Direction を受け取り、
//                          Zone EngineへStructural SL / TPを問い合わせ、
//                          RR判定 → Qty計算 → 発注 → SL/TP固定 まで一括で行う共通層。
//
//  セクション構成 (Entry Moduleを追加する場合は 06〜07 だけ触ればよい):
//    01. Common Inputs
//    02. Zone Engine Inputs
//    03. Zone Engine
//    04. TradePlan / Structural SLTP
//    05. Common Trade Engine
//    06. Entry Module - FVG
//    07. Future Entry Modules
//    08. Order Execution
//    09. Display / Debug
//
//  前提:
//    ・チャート時間足 = 5分足。Entry判定は5分足確定時に行う。
//    ・Zone Engine内の 2000MA / 3000MA は 1分足コンテキストで直接計算し、
//      その結果を5分足側へ取得する (5分足closeからは計算しない)。
//
//  既知の制約 (Pine Script仕様上のもの):
//   L1. request.security で下位足 (1分足) を参照した場合、TradingViewは
//       「そのチャート足に含まれる最後の確定intrabar値」を返す。
//       本Strategyはこれを仕様として利用する
//       (= 5分足の判定時点で利用可能な最新の1分足MA値)。
//   L2. SMA 3000 は1分足で3000本の履歴を要求する。履歴が足りない場合 MA Zone は na となり
//       Zone生成から除外される (既定は EMA)。
//   L3. Pineには連想配列が無いため、毎バー作り直されるCluster Zoneと永続的な
//       Break/Flip状態の紐付けは「価格帯の近さ + Source構成の連続性」で行っている。
//   L4. box / label は最大500個。描画は現在価格に近い maxZonesDraw 本のみ。
//   L5. TradingView Strategyは「単一ネットポジション」しか持てない。したがって
//       反対方向Logicの同時保有は構造上できない。既定では反対方向シグナルを
//       スキップし、各Logicのトレードが互いを打ち消さないようにしている
//       (allowOppositeEntry = true で従来どおりネット決済を許可)。
// ============================================================================

//@version=5
strategy(
     title             = "FVG + Zone Engine Strategy",
     shorttitle        = "FVG-ZONE",
     overlay           = true,
     pyramiding        = 100,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ============================================================================
// 01. COMMON INPUTS
// ----------------------------------------------------------------------------
//  全Entry Logicが共有する設定。Logic固有の設定は Section 06〜07 に置く。
// ============================================================================

// ---- 1.1 Position Size / Risk ---------------------------------------------
var string G_RISK = "01 · Common · Risk"
riskPct     = input.float(5.0, "1トレード損失率 (%)", step = 0.1, group = G_RISK,
     tooltip = "Risk Amount ÷ Structural SL距離 でQtyを計算する。")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = G_RISK)

// ---- 1.2 Trade Engine ------------------------------------------------------
var string G_TE = "01 · Common · Trade Engine"
fallbackRR         = input.float(2.0, "Fallback RR (Structural TPが無い場合のみ使用)", step = 0.1, minval = 0.1, group = G_TE,
     tooltip = "有効なTP Zoneが見つからない場合のみ、Structural SL距離 × この値でTPを作る。")
maxOpenPerLogic    = input.int(1, "Logicごとの最大同時保有トレード数", minval = 1, maxval = 50, group = G_TE,
     tooltip = "同一logicIdのポジションをいくつまで同時に持てるか。Logic間は互いに影響しない。")
allowOppositeEntry = input.bool(false, "反対方向Logicの同時Entryを許可", group = G_TE,
     tooltip = "TradingView Strategyは単一ネットポジションのため、反対方向Entryは既存Tradeを\n" +
               "打ち消してしまう。既定 (false) では反対方向シグナルをスキップし、\n" +
               "各Logicのトレード結果が汚染されないようにする。")

// ---- 1.3 Break Even (共通Trade Engine側で Entry ID 単位に管理) --------------
var string G_BE = "01 · Common · Break Even"
useBreakEven         = input.bool(false, "建値移動を使う", group = G_BE,
     tooltip = "既定OFF。OFF時はStructural SL / TPの結果をそのまま検証できる。")
breakEvenTrigger     = input.float(10.0, "建値移動開始幅 ($)", step = 0.1, group = G_BE)
breakEvenTriggerMode = input.string("到達瞬間", "建値移動判定", options = ["到達瞬間", "確定足"], group = G_BE)

// ---- 1.4 Session / News Filter (共通・どのLogicからも参照可) ---------------
var string G_SESS = "01 · Common · Session / News"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = G_SESS)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = G_SESS)
useEUSession     = input.bool(true, "EU 16:00-21:00", group = G_SESS)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = G_SESS)
useNewsTimeFilter = input.bool(false, "重要指標時間を除外", group = G_SESS)
newsSession1 = input.session("2130-2230", "指標除外時間1", group = G_SESS)
newsSession2 = input.session("2330-0030", "指標除外時間2", group = G_SESS)
newsSession3 = input.session("0300-0400", "指標除外時間3", group = G_SESS)

// ---- 1.5 Common Debug ------------------------------------------------------
var string G_DBGC = "01 · Common · Debug"
showEntryLabel = input.bool(true,  "Entry Debug Label を表示", group = G_DBGC,
     tooltip = "Logic / Direction / Entry / SL / TP / RR / TP Type を発注時に表示する。")
showTradeDebug = input.bool(true,  "Trade Debug 行 (最新TradePlan) を表示", group = G_DBGC)

// ---- 1.6 Common Filter Calculation ----------------------------------------
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================================
// 02. ZONE ENGINE INPUTS
// ----------------------------------------------------------------------------
//  Support / Resistance Zone Engine の設定。Entry Logicからは触らない。
// ============================================================================

// ---- 2.1 Zone Geometry -----------------------------------------------------
var string G_ZONE = "02 · Zone Geometry"
zoneHalfWidth = input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE,
     tooltip = "Zone = 中心価格 ± この値。Strengthによって幅は変えない。")

// ---- 2.2 MA Source (1分足コンテキストで直接計算) ---------------------------
var string G_MA = "02 · MA Source"
maTf        = input.timeframe("1",  "MA Timeframe",           group = G_MA,
     tooltip = "既定 1分足。1分足コンテキスト内でMAを計算し、その結果を5分足へ取得する。")
maType      = input.string("EMA",   "MA Type", options = ["SMA", "EMA"], group = G_MA)
ma1Len      = input.int(2000,       "MA #1 Length", minval = 1, maxval = 4999, group = G_MA)
ma2Len      = input.int(3000,       "MA #2 Length", minval = 1, maxval = 4999, group = G_MA)
scoreMa1    = input.float(2.0,      "Base Score · MA #1", step = 0.5, group = G_MA)
scoreMa2    = input.float(2.0,      "Base Score · MA #2", step = 0.5, group = G_MA)
useMaSource = input.bool(true,      "Enable MA Source",   group = G_MA)

// ---- 2.3 MA Slope ----------------------------------------------------------
var string G_SLOPE = "02 · MA Slope"
slopeLookback   = input.int(60,   "Slope Lookback (MA TF bars)", minval = 1, group = G_SLOPE)
slopeThrMod     = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_SLOPE)
slopeThrStrong  = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_SLOPE)
slopeBonusFlat  = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_SLOPE)
slopeBonusMod   = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_SLOPE)
slopeBonusStr   = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_SLOPE)
slopeBonusMode  = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster",
     options = ["Sum (per MA)", "Max"], group = G_SLOPE,
     tooltip = "同一Cluster内に2000MAと3000MAが両方入った場合、Slope Bonusを合算するか最大値のみ採用するか。")
maClusterDist   = input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_SLOPE)
maClusterBonusV = input.float(1.0, "MA Cluster Bonus",              step = 0.5, group = G_SLOPE)
maClusterDirBns = input.float(1.0, "MA Cluster Bonus · Same Slope", step = 0.5, group = G_SLOPE)

// ---- 2.4 Horizontal Source -------------------------------------------------
var string G_HZ = "02 · Horizontal Source (Swing)"
useHzSource = input.bool(true,      "Enable Horizontal Source", group = G_HZ)
hzTf1       = input.timeframe("5",  "Horizontal TF #1", group = G_HZ)
hzTf2       = input.timeframe("15", "Horizontal TF #2", group = G_HZ)
hzTf3       = input.timeframe("60", "Horizontal TF #3", group = G_HZ)
pivLen1     = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_HZ)
pivLen2     = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_HZ)
pivLen3     = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_HZ)
// Swingの役割は「価格帯の発見 + Horizontal Zoneの生成」まで。
// 同一価格帯に何本Swingが出ても Base Score は増えない (同一TFにつき1回だけ加点)。
// 「その価格帯が実際に何回機能したか」は Reaction Bonus 側で評価する。
scoreHz1    = input.float(1.0, "Base Score · TF #1 Swing", step = 0.5, group = G_HZ)
scoreHz2    = input.float(2.0, "Base Score · TF #2 Swing", step = 0.5, group = G_HZ)
scoreHz3    = input.float(3.0, "Base Score · TF #3 Swing", step = 0.5, group = G_HZ)

// ---- 2.5 Horizontal Reaction ----------------------------------------------
var string G_REACT = "02 · Horizontal Reaction"
reactionDist    = input.float(20.0, "Reaction Distance ($)", step = 0.5, group = G_REACT,
     tooltip = "Zoneに接触したあと、来た方向へこの距離以上戻ればReaction 1回。")
reactionBonus1  = input.float(1.0, "Reaction Bonus · 1 time",   step = 0.5, group = G_REACT)
reactionBonus2  = input.float(2.0, "Reaction Bonus · 2 times",  step = 0.5, group = G_REACT)
reactionBonus3  = input.float(3.0, "Reaction Bonus · 3+ times", step = 0.5, group = G_REACT)
reactionRearmDist = input.float(10.0, "Reaction Re-arm Distance ($)", step = 0.5, group = G_REACT,
     tooltip = "Reaction成立後は受付をロックする。ローソク全体がZoneからこの距離以上離れて\n" +
               "「一度明確にZoneを離れた」と確認できたときだけ、次のReaction受付を再開する。")
reactionAllSrc  = input.bool(false, "Track Reaction on Accum / DayHL too", group = G_REACT,
     tooltip = "既定は OFF (水平線のみ)。ONにすると静的Zone全般でReactionを数える。")

// ---- 2.6 Day High / Low ----------------------------------------------------
var string G_DHL = "02 · Day High / Low"
useDayHL        = input.bool(true, "Enable Day High / Low Source", group = G_DHL)
dayTz           = input.string("Asia/Tokyo", "Day Session Timezone", group = G_DHL)
dayResetHour    = input.int(5, "Day Reset Hour (取引日の開始時刻)", minval = 0, maxval = 23, group = G_DHL,
     tooltip = "既定 5 = 日本時間 05:00 ～ 翌 04:59 を1取引日として扱う。0 にすると暦日基準に戻る。")
scoreDayHL      = input.float(3.0, "Base Score · Day High / Low", step = 0.5, group = G_DHL)
carryPrevDayHL  = input.bool(false, "Carry Previous Day H/L as Horizontal Zone", group = G_DHL)
scorePrevDayHL  = input.float(2.0, "Base Score · Carried Prev Day H/L", step = 0.5, group = G_DHL)
lifePrevDayHL   = input.float(5.0, "Lifetime · Carried Prev Day H/L (days)", step = 1.0, group = G_DHL)

// ---- 2.7 Accumulation ------------------------------------------------------
var string G_ACC = "02 · Accumulation"
useAccSource = input.bool(true,       "Enable Accumulation Source", group = G_ACC)
accumModule  = input.string("Accum Box (ported)", "Accum Detection Module",
     options = ["Accum Box (ported)", "Provisional ATR (暫定)"], group = G_ACC,
     tooltip = "Accum Box (ported) = 実運用のAccum判定ロジック。\nProvisional ATR = 暫定簡易判定 (本番用ではない)。")
accTf1       = input.timeframe("60",  "Accum TF #1", group = G_ACC)
accTf2       = input.timeframe("240", "Accum TF #2", group = G_ACC)
accTf3       = input.timeframe("D",   "Accum TF #3", group = G_ACC)
scoreAcc1    = input.float(3.0, "Base Score · TF #1 Accum", step = 0.5, group = G_ACC)
scoreAcc2    = input.float(4.0, "Base Score · TF #2 Accum", step = 0.5, group = G_ACC)
scoreAcc3    = input.float(5.0, "Base Score · TF #3 Accum", step = 0.5, group = G_ACC)
accKeep1     = input.int(3, "Keep Count · TF #1 Accum (instances)", minval = 1, group = G_ACC,
     tooltip = "最新N個のAccumインスタンスを保持する。High / Low のペアで1個と数える。")
accKeep2     = input.int(2, "Keep Count · TF #2 Accum (instances)", minval = 1, group = G_ACC)
accKeep3     = input.int(1, "Keep Count · TF #3 Accum (instances)", minval = 1, group = G_ACC)

// ---- 2.7a Accum Box (ported) パラメータ ------------------------------------
var string G_ACCP = "02a · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",            minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",                minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

// ---- 2.7b Provisional ATR (暫定) パラメータ --------------------------------
var string G_ACCQ = "02b · Provisional ATR Accum (暫定・本番未使用)"
accLen1      = input.int(20, "[暫定] Accum Lookback · TF #1 (bars)", minval = 3, group = G_ACCQ)
accLen2      = input.int(20, "[暫定] Accum Lookback · TF #2 (bars)", minval = 3, group = G_ACCQ)
accLen3      = input.int(15, "[暫定] Accum Lookback · TF #3 (bars)", minval = 3, group = G_ACCQ)
accMult      = input.float(1.2, "[暫定] Accum Max Range / ATR", step = 0.1, minval = 0.1, group = G_ACCQ)

// ---- 2.8 Cluster -----------------------------------------------------------
var string G_CLU = "02 · Cluster"
clusterDist = input.float(20.0, "Cluster Distance ($)", step = 1.0, group = G_CLU,
     tooltip = "Raw Zone中心同士がこの距離以内ならCluster候補。統合後も全Sourceが最終Centerからこの距離以内であることを検証する。")

// ---- 2.9 Strength Score ----------------------------------------------------
var string G_SCORE = "02 · Strength Score"
thrMedium   = input.float(5.0,  "Medium Score Threshold",      step = 0.5, group = G_SCORE)
thrStrong   = input.float(10.0, "Strong Score Threshold",      step = 0.5, group = G_SCORE)
thrVStrong  = input.float(15.0, "Very Strong Score Threshold", step = 0.5, group = G_SCORE)
confBonus2  = input.float(1.0, "Confluence Bonus · 2 categories",  step = 0.5, group = G_SCORE)
confBonus3  = input.float(2.0, "Confluence Bonus · 3 categories",  step = 0.5, group = G_SCORE)
confBonus4  = input.float(3.0, "Confluence Bonus · 4+ categories", step = 0.5, group = G_SCORE)
flipBonusV  = input.float(2.0, "Flip Bonus", step = 0.5, group = G_SCORE)

// ---- 2.9a Very Strong · Higher Timeframe Structure -------------------------
var string G_HTF = "02a · Very Strong · Higher TF Structure"
requireHtfForVStrong = input.bool(true, "Require Higher TF Structure for Very Strong", group = G_HTF)
htfSwing1H  = input.bool(true,  "Count 1H Swing (TF #3) as Higher TF",   group = G_HTF)
htfAccum1H  = input.bool(true,  "Count 1H Accum (TF #1) as Higher TF",   group = G_HTF)
htfAccum4H  = input.bool(true,  "Count 4H Accum (TF #2) as Higher TF",   group = G_HTF)
htfAccumD   = input.bool(true,  "Count Daily Accum (TF #3) as Higher TF", group = G_HTF)
htfSwing15M = input.bool(false, "Count 15M Swing (TF #2) as Higher TF",  group = G_HTF)
htfMa1      = input.bool(false, "Count MA #1 (2000) as Higher TF",       group = G_HTF)
htfMa2      = input.bool(false, "Count MA #2 (3000) as Higher TF",       group = G_HTF)
htfDayHL    = input.bool(false, "Count Day High / Low as Higher TF",     group = G_HTF)

// ---- 2.10 Break / Flip -----------------------------------------------------
var string G_BF = "02 · Break / Flip"
breakTf         = input.timeframe("5", "Break Evaluation Timeframe", group = G_BF,
     tooltip = "Breakはヒゲではなくこの時間足の確定終値で判定する。")
breakBuffer     = input.float(5.0,  "Break Buffer ($)",         step = 0.5, group = G_BF)
flipConfirmDist = input.float(10.0, "Flip Confirm Distance ($)", step = 0.5, group = G_BF)
resetOnReclaim  = input.bool(true,  "Reset Broken on Reclaim", group = G_BF)
trackStaleBars  = input.int(500, "Zone State Retention (bars without match)", minval = 10, group = G_BF)
trackContinuity = input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_BF,
     tooltip = "ZoneTrackを継承する条件。Center距離が近いだけでは継承せず、Source構成の重なり率が\nこの値以上であることを要求する。1.0 = Source構成完全一致のみ継承。")

// ---- 2.11 Zone Lifetime ----------------------------------------------------
var string G_LIFE = "02 · Zone Lifetime"
lifeHz1         = input.float(5.0,  "Lifetime · TF #1 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeHz2         = input.float(10.0, "Lifetime · TF #2 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeHz3         = input.float(30.0, "Lifetime · TF #3 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeExtendOn    = input.bool(true,  "Extend Lifetime on Reaction / Flip", group = G_LIFE)
lifeExtendRatio = input.float(0.5,  "Lifetime Extension Ratio", step = 0.1, minval = 0.0, group = G_LIFE)
maxPersistZones = input.int(200, "Max Persistent Raw Zones", minval = 20, maxval = 800, group = G_LIFE)

// ---- 2.12 Structural SL / TP (Trade Engine 接続点) -------------------------
var string G_SLTP = "02 · Structural SL / TP"
slBuffer      = input.float(5.0,  "SL Buffer ($)", step = 0.5, group = G_SLTP)
tpBuffer      = input.float(5.0,  "TP Buffer ($)", step = 0.5, group = G_SLTP)
maxSlDist     = input.float(30.0, "Max SL Distance ($)", step = 1.0, group = G_SLTP)
minStructRR   = input.float(1.0,  "Minimum Structural RR", step = 0.1, group = G_SLTP,
     tooltip = "Structural TPが存在する場合、この値未満のRRならエントリー禁止 (固定RR TPへ逃げない)。")
slMinScore    = input.float(4.0,  "SL Zone · Min Score", step = 0.5, group = G_SLTP)
slMinStrStr   = input.string("Medium", "SL Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
tpMinScore    = input.float(7.0,  "TP Zone · Min Score", step = 0.5, group = G_SLTP)
tpMinStrStr   = input.string("Strong", "TP Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
obsMinStrStr  = input.string("Medium", "Obstacle · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)

// ---- 2.13 Zone Display -----------------------------------------------------
var string G_DISP = "02 · Zone Display"
showZones      = input.bool(true,  "Show Zones (box)",        group = G_DISP)
showMaLines    = input.bool(true,  "Plot MA Source Lines",    group = G_DISP)
showLabels     = input.bool(true,  "Show Zone Labels",        group = G_DISP)
showDetailLbl  = input.bool(false, "Detailed Labels (sources)", group = G_DISP)
maxZonesDraw   = input.int(30, "Max Zones Drawn", minval = 1, maxval = 120, group = G_DISP)
zoneLeftBars   = input.int(150, "Zone Box · Left Extension (bars)",  minval = 1, group = G_DISP)
zoneRightBars  = input.int(30,  "Zone Box · Right Extension (bars)", minval = 1, group = G_DISP)
colSupport     = input.color(color.new(#26A69A, 0), "Color · Support",    group = G_DISP)
colResistance  = input.color(color.new(#EF5350, 0), "Color · Resistance", group = G_DISP)
colActive      = input.color(color.new(#FFB300, 0), "Color · Active",     group = G_DISP)
colBroken      = input.color(color.new(#78909C, 0), "Color · Broken",     group = G_DISP)
trWeak         = input.int(90, "Transparency · Weak",        minval = 0, maxval = 100, group = G_DISP)
trMedium       = input.int(80, "Transparency · Medium",      minval = 0, maxval = 100, group = G_DISP)
trStrong       = input.int(68, "Transparency · Strong",      minval = 0, maxval = 100, group = G_DISP)
trVStrong      = input.int(55, "Transparency · Very Strong", minval = 0, maxval = 100, group = G_DISP)

// ---- 2.14 Zone Debug -------------------------------------------------------
var string G_DBG = "02 · Zone Debug"
showDebugTable = input.bool(true, "Show Zone Debug Table", group = G_DBG)
dbgPosStr      = input.string("Top Right", "Debug Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = G_DBG)
dbgNearestN    = input.int(3, "Nearest Zones per Side", minval = 1, maxval = 5, group = G_DBG)
dbgTextSize    = input.string("Small", "Debug Table Text Size", options = ["Tiny", "Small", "Normal"], group = G_DBG)

// ============================================================================
// 03. ZONE ENGINE
// ----------------------------------------------------------------------------
//  Support / Resistance Zone Engine 本体。
//  MA2000/3000 · MA slope · Swing · Reaction · Day High/Low · Accumulation ·
//  Accum Keep Count · Cluster · Strength Score · Very Strong条件 · Zone State ·
//  Break · Retest · Flip · ZoneTrack continuity · Live Zone Map
//  → ロジックは Zone Engine 単体版から変更していない。
//  Entry Logicはこのセクションを一切参照しない (Section 04 の関数経由でのみ使う)。
// ============================================================================

// ---- 3.1 Constants ---------------------------------------------------------
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3

int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

string CAT_MA   = "MA"
string CAT_HZ   = "Horizontal"
string CAT_DHL  = "DayHL"
string CAT_ACC  = "Accum"

int MS_PER_DAY = 86400000

// ---- 3.2 User Defined Types ------------------------------------------------
// RawZone : 個々のSourceが生成する単位Zone
type RawZone
    int    uid          = 0
    int    instId       = 0
    string srcId        = ""
    string srcCat       = ""
    string srcTf        = ""
    string srcLabel     = ""
    float  center       = 0.0
    float  top          = 0.0
    float  bottom       = 0.0
    float  baseScore    = 0.0
    int    slopeState   = 0
    int    slopeDir     = 0
    float  slopeBonus   = 0.0
    float  maClusterBonus = 0.0
    int    reactionCnt  = 0
    float  reactionBonus = 0.0
    bool   flipped      = false
    float  flipBonus    = 0.0
    int    entrySide    = 0
    bool   reactionArmed = true
    int    createdBar   = 0
    int    createdTime  = 0
    int    expireTime   = 0
    int    lifeMs       = 0
    bool   dynamic      = false

// Zone : Cluster統合後の最終Zone。Live Zone Mapの構成要素
type Zone
    float  center       = 0.0
    float  top          = 0.0
    float  bottom       = 0.0
    float  score        = 0.0
    float  baseSum      = 0.0
    float  slopeBonus   = 0.0
    float  maBonus      = 0.0
    float  reactionBonus = 0.0
    float  flipBonus    = 0.0
    float  confBonus    = 0.0
    int    strength     = 1
    int    state        = 0
    bool   flipped      = false
    int    flipDir      = 0
    int    catCount     = 0
    int    memberCount  = 0
    string sources      = ""
    int    trackId      = -1
    array<int> memberUids
    string sourceSig    = ""
    int    reactionCnt  = 0
    bool   hasHtf       = false
    string htfSources   = ""

// ZoneTrack : Zone State / Break / Flip の永続ステート
type ZoneTrack
    int   id          = 0
    float center      = 0.0
    float top         = 0.0
    float bottom      = 0.0
    int   state       = 0
    int   lastRole    = 0
    int   breakDir    = 0
    int   breakBar    = 0
    bool  retested    = false
    bool  flipped     = false
    int   flipDir     = 0
    int   lastSeenBar = 0
    bool  matched     = false
    array<int> memberUids
    string sourceSig  = ""

// ---- 3.3 Utility Functions -------------------------------------------------
f_tfName(string tf) =>
    tf == "1"    ? "1M"  : tf == "3"   ? "3M"  : tf == "5"   ? "5M"  :
     tf == "15"  ? "15M" : tf == "30"  ? "30M" : tf == "45"  ? "45M" :
     tf == "60"  ? "1H"  : tf == "120" ? "2H"  : tf == "180" ? "3H"  :
     tf == "240" ? "4H"  : tf == "360" ? "6H"  : tf == "720" ? "12H" : tf

f_strengthOf(float score, bool hasHtf) =>
    int t = score < thrMedium ? SR_WEAK : score < thrStrong ? SR_MEDIUM : score < thrVStrong ? SR_STRONG : SR_VSTRONG
    if t == SR_VSTRONG and requireHtfForVStrong and not hasHtf
        t := SR_STRONG
    t

f_strengthName(int s) =>
    s == SR_VSTRONG ? "VERY STRONG" : s == SR_STRONG ? "STRONG" : s == SR_MEDIUM ? "MEDIUM" : "WEAK"

f_strengthIdx(string s) =>
    s == "Very Strong" ? SR_VSTRONG : s == "Strong" ? SR_STRONG : s == "Medium" ? SR_MEDIUM : SR_WEAK

f_stateName(int st) =>
    st == ST_SUPPORT ? "SUP" : st == ST_RESIST ? "RES" : st == ST_ACTIVE ? "ACT" : "BRK"

f_stateFull(int st) =>
    st == ST_SUPPORT ? "Support" : st == ST_RESIST ? "Resistance" : st == ST_ACTIVE ? "Active" : "Broken"

f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)

f_arrow(int dir) =>
    dir > 0 ? "↑" : dir < 0 ? "↓" : "→"

f_slopeState(float delta) =>
    float a = math.abs(nz(delta))
    a >= slopeThrStrong ? 2 : a >= slopeThrMod ? 1 : 0

f_slopeDir(float delta) =>
    nz(delta) > 0 ? 1 : nz(delta) < 0 ? -1 : 0

f_slopeBonusValue(int st) =>
    st == 2 ? slopeBonusStr : st == 1 ? slopeBonusMod : slopeBonusFlat

f_reactionBonus(int cnt) =>
    cnt <= 0 ? 0.0 : cnt == 1 ? reactionBonus1 : cnt == 2 ? reactionBonus2 : reactionBonus3

f_confluenceBonus(int catCount) =>
    catCount >= 4 ? confBonus4 : catCount == 3 ? confBonus3 : catCount == 2 ? confBonus2 : 0.0

f_days2ms(float d) =>
    int(d * MS_PER_DAY)

// ---- 3.4 MA Source Module --------------------------------------------------
// ★ 1分足 2000MA / 3000MA。
//   f_maPack() は request.security によって「maTf (=1分足) のコンテキスト内」で
//   評価されるため、EMA/SMA は 1分足 close 系列から直接計算される。
//   5分足 close から 2000MA / 3000MA を計算しているのではない。
//   5分足側では「その5分足時点で利用可能な最新の1分足MA値」を受け取る。
f_ma(float src, simple int len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

f_maPack() =>
    float m1 = f_ma(close, ma1Len)          // ← close は1分足のclose
    float m2 = f_ma(close, ma2Len)
    float d1 = m1 - m1[slopeLookback]       // ← slopeも1分足ベース
    float d2 = m2 - m2[slopeLookback]
    [m1, d1, m2, d2]

[ma1Val, ma1Delta, ma2Val, ma2Delta] = request.security(syminfo.tickerid, maTf, f_maPack(),
     lookahead = barmerge.lookahead_off)

int   ma1Dir   = f_slopeDir(ma1Delta)
int   ma2Dir   = f_slopeDir(ma2Delta)
int   ma1State = f_slopeState(ma1Delta)
int   ma2State = f_slopeState(ma2Delta)

f_maSlopeBonus(float maVal, int dir, int st) =>
    bool aligned = (dir > 0 and close > maVal) or (dir < 0 and close < maVal)
    aligned ? f_slopeBonusValue(st) : 0.0

float ma1SlopeBonus = na(ma1Val) ? 0.0 : f_maSlopeBonus(ma1Val, ma1Dir, ma1State)
float ma2SlopeBonus = na(ma2Val) ? 0.0 : f_maSlopeBonus(ma2Val, ma2Dir, ma2State)

float maClusterBonus = 0.0
if not na(ma1Val) and not na(ma2Val) and math.abs(ma1Val - ma2Val) <= maClusterDist
    maClusterBonus := maClusterBonusV
    if ma1Dir != 0 and ma1Dir == ma2Dir
        maClusterBonus += maClusterDirBns

// ---- 3.5 Horizontal Source Module (Swing Pivot) ---------------------------
f_pivotPack(simple int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low,  len, len)
    int   pt = na(ph) ? int(na) : time
    int   lt = na(pl) ? int(na) : time
    [ph, pt, pl, lt]

[ph1, ph1T, pl1, pl1T] = request.security(syminfo.tickerid, hzTf1, f_pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
[ph2, ph2T, pl2, pl2T] = request.security(syminfo.tickerid, hzTf2, f_pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
[ph3, ph3T, pl3, pl3T] = request.security(syminfo.tickerid, hzTf3, f_pivotPack(pivLen3), lookahead = barmerge.lookahead_off)

// ---- 3.6 Day High / Low Module --------------------------------------------
int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo   = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / MS_PER_DAY)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo
bool isNewDay = na(tradingDayId[1]) or tradingDayId != tradingDayId[1]

var float dayHigh     = na
var float dayLow      = na
var float prevDayHigh = na
var float prevDayLow  = na

if isNewDay
    prevDayHigh := dayHigh
    prevDayLow  := dayLow
    dayHigh     := high
    dayLow      := low
else
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow  := na(dayLow)  ? low  : math.min(dayLow,  low)

// ---- 3.7 Accumulation Module (差し替え可能) -------------------------------
//  対外契約: f_accumPack(...) => [accumUpper, accumLower, accumInstId]
bool usePortedAccum = accumModule == "Accum Box (ported)"

f_accumBoxCore(_atrMult, _barRatioMax, _driftMax) =>
    _atr = ta.atr(accumAtrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * _atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, accumRangeLen) - ta.lowest(_bodyBotNow, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, accumBaseLen)  - ta.lowest(_bodyBotNow, accumBaseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _barRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _driftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_accumBoxState() =>
    _isAccum   = f_accumBoxCore(accumAtrMult, accumBarRatioMax, accumDriftMax)
    _accumHigh = ta.highest(math.max(open, close), accumRangeLen)
    _accumLow  = ta.lowest(math.min(open, close), accumRangeLen)
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if barstate.isconfirmed
        if _isStart
            _top := _accumHigh
            _bot := _accumLow
            _sid := time
        if _isAccum
            _bt = math.max(open, close)
            _bb = math.min(open, close)
            _top := math.max(nz(_top, _bt), _bt)
            _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot]

f_accumDetectProvisional(simple int len, float mult) =>
    float hh   = ta.highest(high, len)
    float ll   = ta.lowest(low,  len)
    float atrv = ta.atr(len)
    bool  isAcc = not na(atrv) and atrv > 0 and (hh - ll) <= atrv * mult
    [hh, ll, isAcc]

f_accumPack(simple int provLen, float provMult) =>
    [pSid, pTop, pBot] = f_accumBoxState()
    [qHi, qLo, qIsAcc] = f_accumDetectProvisional(provLen, provMult)
    bool qNew = qIsAcc and not qIsAcc[1]
    var int qSid = na
    if not nz(qIsAcc[1], false)
        qSid := int(na)
    if nz(qNew[1], false)
        qSid := time[1]

    float upper  = usePortedAccum ? pTop : qHi[1]
    float lower  = usePortedAccum ? pBot : qLo[1]
    int   instId = usePortedAccum ? pSid : qSid
    [upper, lower, instId]

[acc1Hi, acc1Lo, acc1Id] = request.security(syminfo.tickerid, accTf1, f_accumPack(accLen1, accMult), lookahead = barmerge.lookahead_off)
[acc2Hi, acc2Lo, acc2Id] = request.security(syminfo.tickerid, accTf2, f_accumPack(accLen2, accMult), lookahead = barmerge.lookahead_off)
[acc3Hi, acc3Lo, acc3Id] = request.security(syminfo.tickerid, accTf3, f_accumPack(accLen3, accMult), lookahead = barmerge.lookahead_off)

// ---- 3.8 Break Timeframe Feed ---------------------------------------------
[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low],
     lookahead = barmerge.lookahead_off)

bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

// ---- 3.9 Raw Zone Generation ----------------------------------------------
var array<RawZone> gPersist = array.new<RawZone>()
var array<int> gUidSeq = array.new_int(1, 0)
int UID_MA1 = -1
int UID_MA2 = -2

f_nextUid() =>
    int u = array.get(gUidSeq, 0) + 1
    array.set(gUidSeq, 0, u)
    u

var int gDayHighUid = 0
var int gDayLowUid  = 0
if isNewDay or gDayHighUid == 0
    gDayHighUid := f_nextUid()
    gDayLowUid  := f_nextUid()

f_makeRaw(int uid, string id, string cat, string tf, string lbl, float c, float bs, bool dyn) =>
    RawZone.new(uid = uid, srcId = id, srcCat = cat, srcTf = tf, srcLabel = lbl,
         center = c, top = c + zoneHalfWidth, bottom = c - zoneHalfWidth,
         baseScore = bs, createdBar = bar_index, createdTime = time, dynamic = dyn)

f_registerStatic(bool trig, float price, string id, string cat, string tf, string lbl, float bs, float lifeDays) =>
    if trig and not na(price)
        int life = f_days2ms(lifeDays)
        bool dup = false
        if array.size(gPersist) > 0
            for i = 0 to array.size(gPersist) - 1
                RawZone z = array.get(gPersist, i)
                if z.srcId == id and z.srcTf == tf and math.abs(z.center - price) <= zoneHalfWidth
                    dup := true
                    if life > 0
                        z.expireTime := time + life
                    break
        if not dup
            RawZone rz = f_makeRaw(f_nextUid(), id, cat, tf, lbl, price, bs, false)
            rz.lifeMs     := life
            rz.expireTime := life > 0 ? time + life : 0
            array.push(gPersist, rz)

bool nPh1 = not na(ph1T)  and (na(ph1T[1])  or ph1T  != ph1T[1])
bool nPl1 = not na(pl1T)  and (na(pl1T[1])  or pl1T  != pl1T[1])
bool nPh2 = not na(ph2T)  and (na(ph2T[1])  or ph2T  != ph2T[1])
bool nPl2 = not na(pl2T)  and (na(pl2T[1])  or pl2T  != pl2T[1])
bool nPh3 = not na(ph3T)  and (na(ph3T[1])  or ph3T  != ph3T[1])
bool nPl3 = not na(pl3T)  and (na(pl3T[1])  or pl3T  != pl3T[1])

bool nAc1 = (not na(acc1Id) and (na(acc1Id[1]) or acc1Id != acc1Id[1]))
          or (not na(acc1Hi) and (na(acc1Hi[1]) or acc1Hi != acc1Hi[1]))
          or (not na(acc1Lo) and (na(acc1Lo[1]) or acc1Lo != acc1Lo[1]))
bool nAc2 = (not na(acc2Id) and (na(acc2Id[1]) or acc2Id != acc2Id[1]))
          or (not na(acc2Hi) and (na(acc2Hi[1]) or acc2Hi != acc2Hi[1]))
          or (not na(acc2Lo) and (na(acc2Lo[1]) or acc2Lo != acc2Lo[1]))
bool nAc3 = (not na(acc3Id) and (na(acc3Id[1]) or acc3Id != acc3Id[1]))
          or (not na(acc3Hi) and (na(acc3Hi[1]) or acc3Hi != acc3Hi[1]))
          or (not na(acc3Lo) and (na(acc3Lo[1]) or acc3Lo != acc3Lo[1]))

f_registerAccumZone(bool trig, float price, int instId, string id, string tf, string lbl, float bs) =>
    if trig and not na(price) and not na(instId)
        bool found = false
        if array.size(gPersist) > 0
            for i = 0 to array.size(gPersist) - 1
                RawZone z = array.get(gPersist, i)
                if z.srcCat == CAT_ACC and z.srcId == id and z.srcTf == tf and z.instId == instId
                    found    := true
                    z.center := price
                    z.top    := price + zoneHalfWidth
                    z.bottom := price - zoneHalfWidth
                    break
        if not found
            RawZone rz = f_makeRaw(f_nextUid(), id, CAT_ACC, tf, lbl, price, bs, false)
            rz.instId     := instId
            rz.lifeMs     := 0
            rz.expireTime := 0
            array.push(gPersist, rz)

f_pruneAccumGenerations(string tf, int keepCount) =>
    if keepCount >= 1
        array<int> ids = array.new_int()
        if array.size(gPersist) > 0
            for i = 0 to array.size(gPersist) - 1
                RawZone z = array.get(gPersist, i)
                if z.srcCat == CAT_ACC and z.srcTf == tf and not array.includes(ids, z.instId)
                    array.push(ids, z.instId)
        while array.size(ids) > keepCount
            int oldest = array.get(ids, 0)
            int oi = 0
            if array.size(ids) > 1
                for k = 1 to array.size(ids) - 1
                    if array.get(ids, k) < oldest
                        oldest := array.get(ids, k)
                        oi     := k
            array.remove(ids, oi)
            if array.size(gPersist) > 0
                for i = array.size(gPersist) - 1 to 0
                    if i < array.size(gPersist)
                        RawZone z = array.get(gPersist, i)
                        if z.srcCat == CAT_ACC and z.srcTf == tf and z.instId == oldest
                            array.remove(gPersist, i)

f_registerStatic(useHzSource and nPh1, ph1, "SWING_H", CAT_HZ, hzTf1, hzTf1 + " Swing High", scoreHz1, lifeHz1)
f_registerStatic(useHzSource and nPl1, pl1, "SWING_L", CAT_HZ, hzTf1, hzTf1 + " Swing Low",  scoreHz1, lifeHz1)
f_registerStatic(useHzSource and nPh2, ph2, "SWING_H", CAT_HZ, hzTf2, hzTf2 + " Swing High", scoreHz2, lifeHz2)
f_registerStatic(useHzSource and nPl2, pl2, "SWING_L", CAT_HZ, hzTf2, hzTf2 + " Swing Low",  scoreHz2, lifeHz2)
f_registerStatic(useHzSource and nPh3, ph3, "SWING_H", CAT_HZ, hzTf3, hzTf3 + " Swing High", scoreHz3, lifeHz3)
f_registerStatic(useHzSource and nPl3, pl3, "SWING_L", CAT_HZ, hzTf3, hzTf3 + " Swing Low",  scoreHz3, lifeHz3)

f_registerAccumZone(useAccSource and nAc1, acc1Hi, acc1Id, "ACC_HI", accTf1, accTf1 + " Accum High", scoreAcc1)
f_registerAccumZone(useAccSource and nAc1, acc1Lo, acc1Id, "ACC_LO", accTf1, accTf1 + " Accum Low",  scoreAcc1)
f_registerAccumZone(useAccSource and nAc2, acc2Hi, acc2Id, "ACC_HI", accTf2, accTf2 + " Accum High", scoreAcc2)
f_registerAccumZone(useAccSource and nAc2, acc2Lo, acc2Id, "ACC_LO", accTf2, accTf2 + " Accum Low",  scoreAcc2)
f_registerAccumZone(useAccSource and nAc3, acc3Hi, acc3Id, "ACC_HI", accTf3, accTf3 + " Accum High", scoreAcc3)
f_registerAccumZone(useAccSource and nAc3, acc3Lo, acc3Id, "ACC_LO", accTf3, accTf3 + " Accum Low",  scoreAcc3)

f_pruneAccumGenerations(accTf1, accKeep1)
f_pruneAccumGenerations(accTf2, accKeep2)
f_pruneAccumGenerations(accTf3, accKeep3)

f_registerStatic(useDayHL and carryPrevDayHL and isNewDay, prevDayHigh, "PDH", CAT_HZ, "PD", "Prev Day High", scorePrevDayHL, lifePrevDayHL)
f_registerStatic(useDayHL and carryPrevDayHL and isNewDay, prevDayLow,  "PDL", CAT_HZ, "PD", "Prev Day Low",  scorePrevDayHL, lifePrevDayHL)

// ---- 3.10 Horizontal Reaction 計測 ----------------------------------------
f_updateReactions() =>
    if array.size(gPersist) > 0
        for i = 0 to array.size(gPersist) - 1
            RawZone z = array.get(gPersist, i)
            bool target = z.srcCat == CAT_HZ or (reactionAllSrc and (z.srcCat == CAT_ACC or z.srcCat == CAT_DHL))
            if target
                bool touching = low <= z.top and high >= z.bottom

                if not z.reactionArmed
                    bool awayUp   = low  >= z.top    + reactionRearmDist
                    bool awayDown = high <= z.bottom - reactionRearmDist
                    if awayUp or awayDown
                        z.reactionArmed := true

                if touching and z.entrySide == 0 and z.reactionArmed
                    z.entrySide := close[1] > z.top ? 1 : close[1] < z.bottom ? -1 : 0

                if z.entrySide == 1
                    if high >= z.top + reactionDist
                        z.reactionCnt   := z.reactionCnt + 1
                        z.entrySide     := 0
                        z.reactionArmed := false
                        if lifeExtendOn and z.expireTime > 0
                            z.expireTime := z.expireTime + int(z.lifeMs * lifeExtendRatio)
                    else if close <= z.bottom - reactionDist
                        z.entrySide     := 0
                        z.reactionArmed := false
                else if z.entrySide == -1
                    if low <= z.bottom - reactionDist
                        z.reactionCnt   := z.reactionCnt + 1
                        z.entrySide     := 0
                        z.reactionArmed := false
                        if lifeExtendOn and z.expireTime > 0
                            z.expireTime := z.expireTime + int(z.lifeMs * lifeExtendRatio)
                    else if close >= z.top + reactionDist
                        z.entrySide     := 0
                        z.reactionArmed := false
                z.reactionBonus := f_reactionBonus(z.reactionCnt)
f_updateReactions()

// ---- 3.11 寿命切れ / 上限超過の破棄 ---------------------------------------
f_prunePersist() =>
    if array.size(gPersist) > 0
        for i = array.size(gPersist) - 1 to 0
            if i < array.size(gPersist)
                RawZone z = array.get(gPersist, i)
                if z.expireTime > 0 and time > z.expireTime
                    array.remove(gPersist, i)
    while array.size(gPersist) > maxPersistZones
        RawZone z0 = array.get(gPersist, 0)
        if z0.srcCat == CAT_ACC
            string tf0 = z0.srcTf
            int    id0 = z0.instId
            for i = array.size(gPersist) - 1 to 0
                if i < array.size(gPersist)
                    RawZone z = array.get(gPersist, i)
                    if z.srcCat == CAT_ACC and z.srcTf == tf0 and z.instId == id0
                        array.remove(gPersist, i)
        else
            array.shift(gPersist)
f_prunePersist()

// ---- 3.12 このバーで評価するRaw Zone一式 ----------------------------------
array<RawZone> gRaw = array.new<RawZone>()

if array.size(gPersist) > 0
    for i = 0 to array.size(gPersist) - 1
        array.push(gRaw, array.get(gPersist, i))

if useMaSource and not na(ma1Val)
    RawZone rMa1 = f_makeRaw(UID_MA1, "MA1", CAT_MA, maTf, str.tostring(ma1Len) + "MA" + f_arrow(ma1Dir), ma1Val, scoreMa1, true)
    rMa1.slopeState     := ma1State
    rMa1.slopeDir       := ma1Dir
    rMa1.slopeBonus     := ma1SlopeBonus
    rMa1.maClusterBonus := maClusterBonus
    array.push(gRaw, rMa1)

if useMaSource and not na(ma2Val)
    RawZone rMa2 = f_makeRaw(UID_MA2, "MA2", CAT_MA, maTf, str.tostring(ma2Len) + "MA" + f_arrow(ma2Dir), ma2Val, scoreMa2, true)
    rMa2.slopeState     := ma2State
    rMa2.slopeDir       := ma2Dir
    rMa2.slopeBonus     := ma2SlopeBonus
    rMa2.maClusterBonus := maClusterBonus
    array.push(gRaw, rMa2)

if useDayHL and not na(dayHigh)
    array.push(gRaw, f_makeRaw(gDayHighUid, "DAY_HIGH", CAT_DHL, "D", "Day High", dayHigh, scoreDayHL, true))
if useDayHL and not na(dayLow)
    array.push(gRaw, f_makeRaw(gDayLowUid, "DAY_LOW", CAT_DHL, "D", "Day Low", dayLow, scoreDayHL, true))

// ---- 3.13 Cluster Engine ---------------------------------------------------
f_weightOf(RawZone z) =>
    math.max(z.baseScore, 0.01)

f_finalizeCluster(array<RawZone> members) =>
    float tw      = 0.0
    float ts      = 0.0
    float baseSum = 0.0
    float slopeB  = 0.0
    float maB     = 0.0
    float reactB  = 0.0
    bool  hasMA   = false
    bool  hasHZ   = false
    bool  hasDHL  = false
    bool  hasACC  = false

    bool swHit1 = false
    bool swHit2 = false
    bool swHit3 = false
    int  reactCnt = 0
    bool accHi1 = false
    bool accLo1 = false
    bool accHi2 = false
    bool accLo2 = false
    bool accHi3 = false
    bool accLo3 = false
    bool htfSw1h = false
    bool htfAc1  = false
    bool htfAc2  = false
    bool htfAc3  = false
    bool htfSw15 = false
    bool htfM1   = false
    bool htfM2   = false
    bool htfDay  = false

    string srcStr = ""
    string sigStr = ""
    array<int>    uids   = array.new_int()
    array<string> grpKey = array.new_string()
    array<int>    grpCnt = array.new_int()

    int n = array.size(members)
    for j = 0 to n - 1
        RawZone m = array.get(members, j)

        float w = f_weightOf(m)
        tw += w
        ts += m.center * w

        bool isSwing = m.srcCat == CAT_HZ and (m.srcId == "SWING_H" or m.srcId == "SWING_L")
        bool isAccHi = m.srcId == "ACC_HI"
        if isSwing
            if m.srcTf == hzTf1
                if not swHit1
                    swHit1  := true
                    baseSum += scoreHz1
            else if m.srcTf == hzTf2
                if not swHit2
                    swHit2  := true
                    baseSum += scoreHz2
            else if m.srcTf == hzTf3
                if not swHit3
                    swHit3  := true
                    baseSum += scoreHz3
            else
                baseSum += m.baseScore
        else if m.srcCat == CAT_ACC
            if m.srcTf == accTf1
                if isAccHi and not accHi1
                    accHi1  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo1
                    accLo1  := true
                    baseSum += m.baseScore
            else if m.srcTf == accTf2
                if isAccHi and not accHi2
                    accHi2  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo2
                    accLo2  := true
                    baseSum += m.baseScore
            else if m.srcTf == accTf3
                if isAccHi and not accHi3
                    accHi3  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo3
                    accLo3  := true
                    baseSum += m.baseScore
            else
                baseSum += m.baseScore
        else
            baseSum += m.baseScore

        slopeB  := slopeBonusMode == "Max" ? math.max(slopeB, m.slopeBonus) : slopeB + m.slopeBonus
        maB     := math.max(maB, m.maClusterBonus)
        reactB   := math.max(reactB, m.reactionBonus)
        reactCnt := math.max(reactCnt, m.reactionCnt)

        if isSwing and m.srcTf == hzTf3 and htfSwing1H
            htfSw1h := true
        if isSwing and m.srcTf == hzTf2 and htfSwing15M
            htfSw15 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf1 and htfAccum1H
            htfAc1 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf2 and htfAccum4H
            htfAc2 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf3 and htfAccumD
            htfAc3 := true
        if m.srcId == "MA1" and htfMa1
            htfM1 := true
        if m.srcId == "MA2" and htfMa2
            htfM2 := true
        if m.srcCat == CAT_DHL and htfDayHL
            htfDay := true

        sigStr  := sigStr + (j > 0 ? "+" : "") + m.srcId + "@" + m.srcTf + "#" + str.tostring(m.uid)
        array.push(uids, m.uid)
        hasMA   := hasMA  or m.srcCat == CAT_MA
        hasHZ   := hasHZ  or m.srcCat == CAT_HZ
        hasDHL  := hasDHL or m.srcCat == CAT_DHL
        hasACC  := hasACC or m.srcCat == CAT_ACC

        string gk = m.srcLabel
        if isSwing
            gk := m.srcTf + " Swing"
        else if m.srcCat == CAT_ACC
            gk := m.srcTf + " Accum " + (isAccHi ? "High" : "Low")
        int gi = array.indexof(grpKey, gk)
        if gi >= 0
            array.set(grpCnt, gi, array.get(grpCnt, gi) + 1)
        else
            array.push(grpKey, gk)
            array.push(grpCnt, 1)

    string htfStr = ""
    if htfSw1h
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(hzTf3) + " Swing"
    if htfAc1
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf1) + " Accum"
    if htfAc2
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf2) + " Accum"
    if htfAc3
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf3) + " Accum"
    if htfSw15
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(hzTf2) + " Swing"
    if htfM1
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + str.tostring(ma1Len) + "MA"
    if htfM2
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + str.tostring(ma2Len) + "MA"
    if htfDay
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + "Day H/L"
    bool hasHtfStruct = htfStr != ""

    if array.size(grpKey) > 0
        for k = 0 to array.size(grpKey) - 1
            int c = array.get(grpCnt, k)
            srcStr := srcStr + (k > 0 ? " / " : "") + array.get(grpKey, k) + (c > 1 ? " x" + str.tostring(c) : "")

    float ctr = tw > 0 ? ts / tw : na
    int   cat = (hasMA ? 1 : 0) + (hasHZ ? 1 : 0) + (hasDHL ? 1 : 0) + (hasACC ? 1 : 0)
    float confB = f_confluenceBonus(cat)
    Zone.new(
         center = ctr, top = ctr + zoneHalfWidth, bottom = ctr - zoneHalfWidth,
         score = baseSum + slopeB + maB + reactB + confB,
         baseSum = baseSum, slopeBonus = slopeB, maBonus = maB,
         reactionBonus = reactB, flipBonus = 0.0, confBonus = confB,
         strength = SR_WEAK, state = ST_ACTIVE, flipped = false, flipDir = 0,
         catCount = cat, memberCount = n, sources = srcStr, trackId = -1,
         memberUids = uids, sourceSig = sigStr, reactionCnt = reactCnt,
         hasHtf = hasHtfStruct, htfSources = htfStr)

f_buildClusters(array<RawZone> src) =>
    array<Zone> out = array.new<Zone>()
    int n = array.size(src)
    if n > 0
        array<float> centers = array.new_float()
        for i = 0 to n - 1
            array.push(centers, array.get(src, i).center)
        array<int> ord = array.sort_indices(centers, order.ascending)

        array<RawZone> cur = array.new<RawZone>()
        for k = 0 to n - 1
            RawZone z = array.get(src, array.get(ord, k))
            if array.size(cur) == 0
                array.push(cur, z)
            else
                float tw = 0.0
                float ts = 0.0
                for j = 0 to array.size(cur) - 1
                    RawZone m = array.get(cur, j)
                    float w = f_weightOf(m)
                    tw += w
                    ts += m.center * w
                float wz = f_weightOf(z)
                float newCenter = (ts + z.center * wz) / (tw + wz)

                bool ok = math.abs(z.center - newCenter) <= clusterDist
                if ok
                    for j = 0 to array.size(cur) - 1
                        if math.abs(array.get(cur, j).center - newCenter) > clusterDist
                            ok := false
                            break
                if ok
                    array.push(cur, z)
                else
                    array.push(out, f_finalizeCluster(cur))
                    cur := array.new<RawZone>()
                    array.push(cur, z)
        if array.size(cur) > 0
            array.push(out, f_finalizeCluster(cur))
    out

array<Zone> gZones = f_buildClusters(gRaw)

// ---- 3.14 Strength Score Engine -------------------------------------------
f_applyStrength(Zone z) =>
    z.score    := z.baseSum + z.slopeBonus + z.maBonus + z.reactionBonus + z.flipBonus + z.confBonus
    z.strength := f_strengthOf(z.score, z.hasHtf)

if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        f_applyStrength(array.get(gZones, i))

// ---- 3.15 Zone State Engine (ZoneTrack) -----------------------------------
var array<ZoneTrack> gTracks   = array.new<ZoneTrack>()
var int              gTrackSeq = 0

f_uidOverlap(array<int> a, array<int> b) =>
    int c = 0
    if not na(a) and not na(b) and array.size(a) > 0 and array.size(b) > 0
        for i = 0 to array.size(a) - 1
            if array.includes(b, array.get(a, i))
                c += 1
    c

f_trackContinuous(ZoneTrack t, Zone z) =>
    int ov = f_uidOverlap(z.memberUids, t.memberUids)
    int sz = na(z.memberUids) ? 0 : array.size(z.memberUids)
    int st = na(t.memberUids) ? 0 : array.size(t.memberUids)
    int mx = math.max(sz, st)
    ov >= 1 and mx > 0 and (float(ov) / float(mx)) >= trackContinuity

f_findTrack(Zone z) =>
    int best = -1
    float bestD = 1e20
    if array.size(gTracks) > 0
        for i = 0 to array.size(gTracks) - 1
            ZoneTrack t = array.get(gTracks, i)
            if not t.matched
                float d = math.abs(t.center - z.center)
                if d <= clusterDist and d < bestD and f_trackContinuous(t, z)
                    bestD := d
                    best  := i
    best

f_naturalState(float top, float bottom) =>
    close > top ? ST_SUPPORT : close < bottom ? ST_RESIST : ST_ACTIVE

// ---- 3.16 Break / Flip Engine ---------------------------------------------
f_updateTrack(ZoneTrack t, bool evalBar, float bc, float bh, float bl) =>
    int ev = 0

    int  prevState = t.state
    bool handled   = false

    int evalState = prevState == ST_ACTIVE ? (t.lastRole > 0 ? ST_SUPPORT : t.lastRole < 0 ? ST_RESIST : ST_ACTIVE) : prevState

    if evalBar
        if evalState == ST_RESIST and bc > t.top + breakBuffer
            t.state    := ST_BROKEN
            t.breakDir := 1
            t.breakBar := bar_index
            t.retested := false
            t.flipped  := false
            t.flipDir  := 0
            handled    := true
            ev := 1
        else if evalState == ST_SUPPORT and bc < t.bottom - breakBuffer
            t.state    := ST_BROKEN
            t.breakDir := -1
            t.breakBar := bar_index
            t.retested := false
            t.flipped  := false
            t.flipDir  := 0
            handled    := true
            ev := -1
        else if prevState == ST_BROKEN and t.breakDir == 1
            handled := true
            if bc < t.bottom - breakBuffer
                t.breakDir := 0
                t.retested := false
                if resetOnReclaim
                    t.state := f_naturalState(t.top, t.bottom)
            else if not t.retested
                if bl <= t.top and bh >= t.bottom
                    t.retested := true
            else if bc >= t.top + flipConfirmDist
                t.flipped  := true
                t.flipDir  := 1
                t.state    := ST_SUPPORT
                t.breakDir := 0
                t.retested := false
                ev := 2
        else if prevState == ST_BROKEN and t.breakDir == -1
            handled := true
            if bc > t.top + breakBuffer
                t.breakDir := 0
                t.retested := false
                if resetOnReclaim
                    t.state := f_naturalState(t.top, t.bottom)
            else if not t.retested
                if bh >= t.bottom and bl <= t.top
                    t.retested := true
            else if bc <= t.bottom - flipConfirmDist
                t.flipped  := true
                t.flipDir  := -1
                t.state    := ST_RESIST
                t.breakDir := 0
                t.retested := false
                ev := -2

    if not handled and t.state != ST_BROKEN
        t.state := f_naturalState(t.top, t.bottom)

    if t.state == ST_SUPPORT
        t.lastRole := 1
    else if t.state == ST_RESIST
        t.lastRole := -1
    ev

bool evUpBreak   = false
bool evDownBreak = false
bool evFlipSup   = false
bool evFlipRes   = false

if array.size(gTracks) > 0
    for i = 0 to array.size(gTracks) - 1
        ZoneTrack tt = array.get(gTracks, i)
        tt.matched := false

if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        Zone z = array.get(gZones, i)
        int ti = f_findTrack(z)
        ZoneTrack t = na
        if ti >= 0
            t := array.get(gTracks, ti)
        else
            gTrackSeq += 1
            t := ZoneTrack.new(id = gTrackSeq, center = z.center, top = z.top, bottom = z.bottom,
                 state = f_naturalState(z.top, z.bottom), lastSeenBar = bar_index,
                 memberUids = array.copy(z.memberUids), sourceSig = z.sourceSig)
            array.push(gTracks, t)
        t.matched     := true
        t.center      := z.center
        t.top         := z.top
        t.bottom      := z.bottom
        t.lastSeenBar := bar_index
        t.memberUids  := array.copy(z.memberUids)
        t.sourceSig   := z.sourceSig

        int ev = f_updateTrack(t, brEval, brClose, brHigh, brLow)
        evUpBreak   := evUpBreak   or ev == 1
        evDownBreak := evDownBreak or ev == -1
        evFlipSup   := evFlipSup   or ev == 2
        evFlipRes   := evFlipRes   or ev == -2

        z.state     := t.state
        z.flipped   := t.flipped
        z.flipDir   := t.flipDir
        z.flipBonus := t.flipped ? flipBonusV : 0.0
        z.trackId   := t.id
        f_applyStrength(z)

if array.size(gTracks) > 0
    for i = array.size(gTracks) - 1 to 0
        if i < array.size(gTracks)
            ZoneTrack t = array.get(gTracks, i)
            if bar_index - t.lastSeenBar > trackStaleBars
                array.remove(gTracks, i)

// ---- 3.17 Live Zone Map ----------------------------------------------------
// Entry Logic / Trade Engine が参照する唯一の中心データ。
var array<Zone> gLiveMap = array.new<Zone>()
array.clear(gLiveMap)
if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        array.push(gLiveMap, array.get(gZones, i))

f_zoneCount() => array.size(gLiveMap)
f_zoneAt(int i) => array.get(gLiveMap, i)

// ============================================================================
// 04. TRADEPLAN / STRUCTURAL SL-TP
// ----------------------------------------------------------------------------
//  Entry Logic からは f_buildTradePlan(direction, entryPrice) だけを呼ぶ。
//  Entry Logic は Zone がどう作られたかを知らなくてよい。
//
//  優先順位:
//    Structural SL 必須 (無ければ NO TRADE。固定SL / パターンSL / ATR SL へは
//                        フォールバックしない)
//    Structural TP あり → そのTPを必ず使う → RR不足なら NO TRADE
//    Structural TP なし → Structural SL基準の Fallback RR TP
// ============================================================================

// ---- 4.1 TradePlan Type ----------------------------------------------------
type TradePlan
    bool   valid         = false
    string status        = "FAIL"
    string reason        = "NO_ENTRY"
    string logicId       = ""
    int    dir           = 0        // +1 Long / -1 Short
    float  entry         = 0.0
    float  sl            = 0.0
    float  tp            = 0.0
    float  risk          = 0.0
    float  reward        = 0.0
    float  rr            = 0.0
    int    obstacles     = 0
    float  slZoneCenter  = 0.0
    float  slZoneScore   = 0.0
    float  tpZoneCenter  = 0.0
    float  tpZoneScore   = 0.0
    bool   usedFallbackTP = false
    string tpType        = "-"      // "STRUCTURAL" / "FALLBACK_RR"

int SL_MIN_STR  = f_strengthIdx(slMinStrStr)
int TP_MIN_STR  = f_strengthIdx(tpMinStrStr)
int OBS_MIN_STR = f_strengthIdx(obsMinStrStr)

// ---- 4.2 Structural SL -----------------------------------------------------
// Long : zoneTop < entryPrice / state == ST_SUPPORT / Strength>=指定 / Score>=指定
//        の最も近いZone → SL = Zone Bottom - slBuffer
//        (例: center 4580 / half 5 → 下端 4575 / buffer 5 → SL 4570)
// ★ ST_ACTIVE と ST_BROKEN は常にStructural SL候補から除外する。
f_getLongStructuralSL(float entryPrice) =>
    float sl = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_SUPPORT
            if z.top < entryPrice and z.strength >= SL_MIN_STR and z.score >= slMinScore and okState
                float d = entryPrice - z.top
                if d < bestD
                    bestD := d
                    sl    := z.bottom - slBuffer
                    idx   := i
    [sl, idx]

// Short : zoneBottom > entryPrice / state == ST_RESIST → SL = Zone Top + slBuffer
f_getShortStructuralSL(float entryPrice) =>
    float sl = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_RESIST
            if z.bottom > entryPrice and z.strength >= SL_MIN_STR and z.score >= slMinScore and okState
                float d = z.bottom - entryPrice
                if d < bestD
                    bestD := d
                    sl    := z.top + slBuffer
                    idx   := i
    [sl, idx]

// ---- 4.3 Structural TP -----------------------------------------------------
// Long : Entryより上の ST_RESIST Zone のうち最も近いもの → TP = Zone Bottom - tpBuffer
f_getLongStructuralTP(float entryPrice) =>
    float tp = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_RESIST
            if z.bottom > entryPrice and z.strength >= TP_MIN_STR and z.score >= tpMinScore and okState
                float d = z.bottom - entryPrice
                if d < bestD
                    bestD := d
                    tp    := z.bottom - tpBuffer
                    idx   := i
    [tp, idx]

// Short : Entryより下の ST_SUPPORT Zone → TP = Zone Top + tpBuffer
f_getShortStructuralTP(float entryPrice) =>
    float tp = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_SUPPORT
            if z.top < entryPrice and z.strength >= TP_MIN_STR and z.score >= tpMinScore and okState
                float d = entryPrice - z.top
                if d < bestD
                    bestD := d
                    tp    := z.top + tpBuffer
                    idx   := i
    [tp, idx]

// ---- 4.4 Obstacle Count ----------------------------------------------------
f_getObstacleCount(float entryPrice, float tpPrice, int direction) =>
    int cnt = 0
    if not na(entryPrice) and not na(tpPrice) and array.size(gLiveMap) > 0
        float boundary = direction > 0 ? tpPrice + tpBuffer : tpPrice - tpBuffer
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = direction > 0 ? z.state == ST_RESIST : z.state == ST_SUPPORT
            if z.strength >= OBS_MIN_STR and okState
                bool inWay = direction > 0 ? (z.bottom > entryPrice and z.top < boundary)
                                           : (z.top < entryPrice and z.bottom > boundary)
                if inWay
                    cnt += 1
    cnt

// ---- 4.5 Trade Plan Builder (Entry Module 共通API) ------------------------
//  戻り値 TradePlan:
//    valid = true  → 発注してよい
//    valid = false → reason に理由:
//        NO_ENTRY / NO_SL_ZONE / INVALID_SL / SL_TOO_FAR /
//        TP_WRONG_SIDE / LOW_STRUCTURAL_RR
f_buildTradePlan(int direction, float entryPrice) =>
    [lSl, lSi] = f_getLongStructuralSL(entryPrice)
    [lTp, lTi] = f_getLongStructuralTP(entryPrice)
    [sSl, sSi] = f_getShortStructuralSL(entryPrice)
    [sTp, sTi] = f_getShortStructuralTP(entryPrice)

    float sl  = direction > 0 ? lSl : direction < 0 ? sSl : na
    int   si  = direction > 0 ? lSi : direction < 0 ? sSi : -1
    float tpZ = direction > 0 ? lTp : direction < 0 ? sTp : na
    int   ti  = direction > 0 ? lTi : direction < 0 ? sTi : -1

    float risk = na(sl) or na(entryPrice) ? na : math.abs(entryPrice - sl)

    TradePlan p = TradePlan.new(dir = direction, entry = entryPrice)
    p.sl   := sl
    p.risk := risk
    if si >= 0
        Zone zs = array.get(gLiveMap, si)
        p.slZoneCenter := zs.center
        p.slZoneScore  := zs.score
    if ti >= 0
        Zone zt = array.get(gLiveMap, ti)
        p.tpZoneCenter := zt.center
        p.tpZoneScore  := zt.score

    if direction == 0
        p.status := "FAIL"
        p.reason := "NO_ENTRY"
    else if si < 0 or na(sl)
        // ★ Structural SL必須。固定SL / パターンSL / ATR SL へのフォールバックは無い。
        p.status := "FAIL"
        p.reason := "NO_SL_ZONE"
    else if na(risk) or risk <= 0
        p.status := "FAIL"
        p.reason := "INVALID_SL"
    else if risk > maxSlDist
        p.status := "FAIL"
        p.reason := "SL_TOO_FAR"
    else if ti >= 0
        // ---- Structural TP が存在する場合 : 必ずこのTPを使う ----
        //      RRが足りなくても「遠い固定RR TP」へ逃げてはいけない → NO TRADE。
        p.tp             := tpZ
        p.reward         := math.abs(tpZ - entryPrice)
        p.rr             := risk > 0 ? p.reward / risk : na
        p.usedFallbackTP := false
        p.tpType         := "STRUCTURAL"
        p.obstacles      := f_getObstacleCount(entryPrice, tpZ, direction)
        if p.reward <= 0
            p.status := "FAIL"
            p.reason := "TP_WRONG_SIDE"
        else if na(p.rr) or p.rr < minStructRR
            p.status := "FAIL"
            p.reason := "LOW_STRUCTURAL_RR"
        else
            p.valid  := true
            p.status := "PASS"
            p.reason := "OK_STRUCTURAL_TP"
    else
        // ---- Structural TP が無い場合のみ : Structural SL基準の固定RR TP ----
        float ftp = entryPrice + direction * risk * fallbackRR
        p.tp             := ftp
        p.reward         := math.abs(ftp - entryPrice)
        p.rr             := fallbackRR
        p.usedFallbackTP := true
        p.tpType         := "FALLBACK_RR"
        p.obstacles      := f_getObstacleCount(entryPrice, ftp, direction)
        p.valid  := true
        p.status := "PASS"
        p.reason := "OK_FALLBACK_TP"
    p

// ============================================================================
// 05. COMMON TRADE ENGINE
// ----------------------------------------------------------------------------
//  Entry ID生成 / Qty計算 / 発注 / SL-TP固定 / Break Even を一括で持つ共通層。
//  Entry Module 側には strategy.entry / strategy.exit / SL計算 / TP計算 /
//  勝敗管理を一切書かない。
//
//  Entry ID 書式 : <LOGIC_ID>_L_<seq> / <LOGIC_ID>_S_<seq>
//     例 : FVG_L_1 / FVG_S_2 / EMA_L_3 / HORIZONTAL_S_4
//  → List of Trades からどのLogicのトレードか判別できる。
// ============================================================================

// ---- 5.1 State -------------------------------------------------------------
// Entry ID 連番 (関数内から書き換えるため配列で保持)
var array<int> gSeq = array.new_int(1, 0)
// Entry IDごとの固定TP (Break Even で SL のみ更新する際にTPを不変で再指定するため)
var map<string, float> gTradeTP = map.new<string, float>()
// Entry IDごとの建値到達フラグ (一度trueになったら元SLへ戻さない一方向遷移)
var map<string, bool>  gTradeBE = map.new<string, bool>()
// 直近TradePlanのDebug文字列 (Display / Debug セクションで表示)
var array<string> gLastPlan = array.new_string(2, "-")

// ---- 5.2 Position Size (Structural SL距離ベース) --------------------------
//  Risk Amount ÷ Structural SL距離 でQtyを計算する。Long / Short 共通。
f_riskCapital() =>
    (useCompound ? strategy.equity : strategy.initial_capital) * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? f_riskCapital() / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

// ---- 5.3 Logic別 保有数カウント -------------------------------------------
//  Entry ID の接頭辞で数える → Logic間は互いに干渉しない。
f_openCountForLogic(string logicId) =>
    int c = 0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string oid = strategy.opentrades.entry_id(i)
            // "<LOGIC>_L_" / "<LOGIC>_S_" で厳密に判定する (別Logicの前方一致を拾わない)
            if str.startswith(oid, logicId + "_L_") or str.startswith(oid, logicId + "_S_")
                c += 1
    c

// ---- 5.4 Debug 記録 --------------------------------------------------------
f_planText(string logicId, TradePlan p) =>
    logicId + " " + (p.dir > 0 ? "LONG" : p.dir < 0 ? "SHORT" : "-") +
     " | E " + f_num(p.entry, "#.##") +
     " | SL " + f_num(p.sl, "#.##") +
     " | TP " + f_num(p.tp, "#.##") +
     " | RR " + f_num(p.rr, "#.##") +
     " | " + p.tpType +
     " | Obst " + str.tostring(p.obstacles)

f_recordPlan(string logicId, TradePlan p, string extra) =>
    array.set(gLastPlan, 0, f_planText(logicId, p))
    array.set(gLastPlan, 1, p.status + " · " + p.reason + (extra == "" ? "" : " · " + extra))
    true

// ---- 5.5 発注 (共通) -------------------------------------------------------
//  ★ ここが唯一 strategy.entry / strategy.exit を呼ぶ場所。
//    Entry時点の Structural SL / TP (または Fallback TP) を strategy.exit へ
//    渡して固定する。以後Zoneが動いても、そのトレードのSL/TPは変更しない。
f_executeTrade(string logicId, int dir, float entryPrice, TradePlan p) =>
    string eid  = ""
    bool   done = false
    if dir != 0
        if not p.valid
            // Structural SL無し / RR不足 など → 発注しない (理由はDebugへ)
            f_recordPlan(logicId, p, "")
            done := true
        else
            float qty = f_qty(p.risk)
            // 反対方向Entryの扱い (TV単一ネットポジション制約)
            bool oppositeConflict = not allowOppositeEntry and
                 ((dir > 0 and strategy.position_size < 0) or (dir < 0 and strategy.position_size > 0))
            bool logicFull = f_openCountForLogic(logicId) >= maxOpenPerLogic
            if logicFull
                f_recordPlan(logicId, p, "SKIP_LOGIC_LIMIT")
                done := true
            else if oppositeConflict
                f_recordPlan(logicId, p, "SKIP_OPPOSITE_POSITION")
                done := true
            else if qty < 1
                f_recordPlan(logicId, p, "SKIP_NO_QTY")
                done := true
            else
                int n = array.get(gSeq, 0) + 1
                array.set(gSeq, 0, n)
                eid := logicId + (dir > 0 ? "_L_" : "_S_") + str.tostring(n)
                strategy.entry(eid, dir > 0 ? strategy.long : strategy.short, qty = qty)
                // ★ Entry時点の SL / TP をここで固定する。以後Zoneが変化しても更新しない。
                strategy.exit(eid + "X", from_entry = eid, stop = p.sl, limit = p.tp,
                     comment_profit = "TP", comment_loss = "SL")
                // Break Even ON時のみ Entry ID → 固定TP を保持する (OFF時はmapを育てない)
                if useBreakEven
                    gTradeTP.put(eid, p.tp)
                    gTradeBE.put(eid, false)
                f_recordPlan(logicId, p, eid)
                if showEntryLabel
                    // Logic / Direction / Entry / SL / TP / RR / TP Type
                    string ltxt = eid + "\n" + (dir > 0 ? "LONG" : "SHORT")
                    ltxt := ltxt + "\nE  " + f_num(p.entry, "#.##")
                    ltxt := ltxt + "\nSL " + f_num(p.sl, "#.##")
                    ltxt := ltxt + "\nTP " + f_num(p.tp, "#.##")
                    ltxt := ltxt + "\nRR " + f_num(p.rr, "#.##")
                    ltxt := ltxt + "\n" + p.tpType
                    label.new(bar_index, dir > 0 ? low : high, text = ltxt,
                         style = dir > 0 ? label.style_label_up : label.style_label_down,
                         color = dir > 0 ? color.new(color.teal, 20) : color.new(color.maroon, 20),
                         textcolor = color.white, size = size.small)
                done := true
    done ? eid : ""

// ---- 5.6 Entry Signal → 発注 の共通パイプライン ---------------------------
//  Entry Module は「logicId / direction / entrySignal / entryPrice」だけを渡す。
//  Structural SL取得 → Structural TP取得 → RR確認 → PASSなら発注 は全てここ。
f_submitSignal(string logicId, bool signal, int dir, float entryPrice) =>
    string eid = ""
    if signal
        TradePlan p = f_buildTradePlan(dir, entryPrice)
        p.logicId := logicId
        eid := f_executeTrade(logicId, dir, entryPrice, p)
    eid

// ---- 5.7 Break Even (Entry ID 単位) ---------------------------------------
//  useBreakEven=OFF → 何もしない (Structural SL/TPの結果をそのまま検証できる)。
//  ON → 各Entry IDが建値幅に到達したら、そのEntry IDのSLのみエントリー価格へ。
//       TPは Entry時点で固定した値 (gTradeTP) をそのまま再指定する。
f_updateBreakEven() =>
    if useBreakEven and strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string eid = strategy.opentrades.entry_id(i)
            if gTradeTP.contains(eid)
                float ep     = strategy.opentrades.entry_price(i)
                bool  isLong = strategy.opentrades.size(i) > 0
                bool  wasOn  = gTradeBE.contains(eid) and gTradeBE.get(eid)
                bool  reach  = false
                if isLong
                    reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close >= ep + breakEvenTrigger) : (high >= ep + breakEvenTrigger)
                else
                    reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close <= ep - breakEvenTrigger) : (low <= ep - breakEvenTrigger)
                if wasOn or reach
                    gTradeBE.put(eid, true)
                    strategy.exit(eid + "X", from_entry = eid, stop = ep, limit = gTradeTP.get(eid),
                         comment_loss = "BE", comment_profit = "TP")

// ============================================================================
// 06. ENTRY MODULE - FVG  (logicId = "FVG")
// ----------------------------------------------------------------------------
//  FVG Rebound Env Strategy の Entry Logic をそのまま移植したモジュール。
//    ・環境認識 (EMAトレンド) / FVG反発判定 / BOS / Trigger /
//      Volatility Filter / Session Filter / News Filter / Accum NoTrade /
//      Armed管理 / Trigger Cooldown  … すべて変更していない。
//    ・SL/TP計算・発注・勝敗管理は一切持たない。
//  このモジュールの出力は次の3つだけ:
//      LOGIC_FVG (logicId) / fvgLongSignal / fvgShortSignal / fvgEntryPrice
// ============================================================================

string LOGIC_FVG = "FVG"

// ---- 6.1 Inputs : エントリー / トリガー -----------------------------------
var string GF_ENT = "06 · FVG · Entry"
useLong      = input.bool(true,  "ロングを有効", group = GF_ENT)
useShort     = input.bool(false, "ショートを有効", group = GF_ENT)
strictEngulf = input.bool(true,  "実体が前足を完全に包む", group = GF_ENT)
reqOppColor  = input.bool(true,  "前足が反対色であることを要求", group = GF_ENT)

var string GF_TRG = "06 · FVG · Trigger"
useEngulfingTrigger    = input.bool(false, "包み足", group = GF_TRG)
usePinbarTrigger       = input.bool(false, "ピンバー", group = GF_TRG)
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新", group = GF_TRG)
useEMARejectTrigger    = input.bool(false, "EMAリジェクト", group = GF_TRG)
useFVGTriggerFormation = input.bool(false, "FVG形成", group = GF_TRG)
useStrongCandleTrigger = input.bool(false, "強ローソク", group = GF_TRG)

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"], group = GF_TRG)
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)", group = GF_TRG)

useLowerTFTrigger = input.bool(true, "1分足トリガーを使う", group = GF_TRG)
triggerTF         = input.timeframe("1", "トリガー時間足", group = GF_TRG)

emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)", group = GF_TRG)
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター", group = GF_TRG)
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数", group = GF_TRG)
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率", group = GF_TRG)
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間", group = GF_TRG)
bosLookback        = input.int(10,  "BOS Lookback", group = GF_TRG)
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率", group = GF_TRG)
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限", group = GF_TRG)
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター", group = GF_TRG)
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率", group = GF_TRG)
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター", group = GF_TRG)
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間", group = GF_TRG)
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率", group = GF_TRG)
strongBodyRatio    = input.float(0.6, "強ローソク 実体率", group = GF_TRG)
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率", group = GF_TRG)
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター", group = GF_TRG)
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率", group = GF_TRG)
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター", group = GF_TRG)
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率", group = GF_TRG)
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター", group = GF_TRG)
engulfAtrLen               = input.int(14, "包み足 ATR期間", group = GF_TRG)
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率", group = GF_TRG)

useTriggerCooldown        = input.bool(false, "トリガークールダウン", group = GF_TRG)
triggerCooldownBars       = input.int(3, "クールダウン本数", group = GF_TRG)
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade", group = GF_TRG)

// ---- 6.2 Inputs : ボラフィルタ --------------------------------------------
var string GF_VOL = "06 · FVG · Volatility"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = GF_VOL)

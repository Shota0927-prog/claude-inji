tf1H        = input.timeframe("60",  "TF", inline = "tf1", group = GF_ENV)
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15", group = GF_ENV)

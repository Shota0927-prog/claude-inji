reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5", group = GF_ENV)
tf5M        = input.timeframe("5",   "TF", inline = "tf5", group = GF_ENV)
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m", group = GF_ENV)
tf1M        = input.timeframe("1",   "TF", inline = "tf1m", group = GF_ENV)

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50", group = GF_ENV)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き", group = GF_ENV)

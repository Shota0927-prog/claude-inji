useCloseAboveEma50  = input.bool(true, "4. close > EMA50", group = GF_ENV)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200", group = GF_ENV)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い", group = GF_ENV)

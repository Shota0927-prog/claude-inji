//@version=5
// =====================================================================================
// POINT MASTER TP ANALYZER（検証専用・軽量版）
// =====================================================================================
// Production（PointMasterFvgAbsRebound.pine）のロジックは一切複製しない独立 script。
// Production が Data Window へ出力している "PHASE CODE" を input.source で受け取り、
// その値を正本として PARTIAL TP / FULL TP の事後成績を集計する（Phase 判定の再計算はしない）。
//
// 【使い方】
//   1. 5分足チャートに POINT MASTER（Production）と本 Analyzer を両方追加する
//   2. Analyzer の設定 → 「POINT MASTER PHASE CODE」で
//      POINT MASTER FVG ABS REBOUND : PHASE CODE を選択する
//   3. テーブル最上段の SOURCE が CONNECTED になっていることを確認する
//      （未接続のまま close 等を選ぶと -4〜+4 の範囲外になり INVALID 表示・イベント生成なし）
// request.security / request.security_lower_tf は一切使わない。
// =====================================================================================
indicator(
     title      = "POINT MASTER TP ANALYZER",
     shorttitle = "PM-TP-ANA",
     overlay    = true
 )

// ---- PHASE CODE 外部入力（Production の PHASE CODE plot を選択する）--------------------
phaseSource = input.source(close, "POINT MASTER PHASE CODE")
int  phaseCode  = int(math.round(phaseSource))
bool phaseValid = not na(phaseCode) and phaseCode >= -4 and phaseCode <= 4

// ---- 表示・チャート判定（Analyzer 専用。Production とは独立）----------------------------
bool isChart5M = timeframe.isminutes and timeframe.multiplier == 5
color colLong  = color.new(#26a69a, 0)
color colShort = color.new(#ef5350, 0)
color colBg    = color.new(#1e222d, 20)
color colTxt   = color.new(#d1d4dc, 0)
string tblSize = size.small

// =====================================================================================
// TP ANALYZER V2（PHASE LADDER / CONTROL 比較）
// =====================================================================================
// 目的：Production の phaseCode が出す PARTIAL TP / FULL TP が、その後の価格推移から見て
//       どれだけ利確シグナルとして有効だったかを過去データで集計する。
//
// 【評価モード : CONFIRMED 5M】
//   ・5分足チャートの確定足（barstate.isconfirmed）でのみ新規 TP イベントを採用する。
//   ・Production の Phase D alert はリアルタイム中、確定1Mにより5M形成中でも変化し得るが、
//     Historical 実行ではその5M足内部で一瞬だけ発生した Phase transition を完全再構築できない
//     （intrabar replay 設計が別途必要）。V1 は「5分足確定時点でも残っている TP signal」の統計。
//
// 【イベント定義 : PHASE ENTRY】全 Phase を「新しい Phase へ入った瞬間」のイベントとして比較する
//   （HOLD / CAUTION を「その Phase である全5分足」として数えない。サンプル方式を公平にするため）。
//   entry = curSide != 0 and (side 変化 or severity 上昇)。確定5M足1本につき最大1イベント。
//   初回（anaPrevPhaseCode が na）は baseline 保存のみ。downgrade / 同一Phase継続 / NEUTRAL への遷移は 0。
//   PARTIAL / FULL（severity 3 / 4）については V1 LIGHT の条件（sev >= 2 and (side 変化 or sev 上昇)）と
//   完全に同じになる（sev >= 3 なら curSide != 0 / sev >= 2 は自明に成立するため）。
//   CLASS 0 = LONG HOLD (+1) / 1 = LONG CAUTION (+2) / 2 = LONG PARTIAL (+3) / 3 = LONG FULL (+4)
//         4 = SHORT HOLD (-1) / 5 = SHORT CAUTION (-2) / 6 = SHORT PARTIAL (-3) / 7 = SHORT FULL (-4)
//   Reversal / Extension / signed の向きは severity に関係なく side で決める（LONG = class 0〜3）。
//
// 【評価】signalPrice = シグナル確定足の close。評価は必ず次の5M足から（シグナル足の high / low は使わない）。
//   LONG     : Reversal = signalPrice - futureLow  / Extension = futureHigh - signalPrice / signed = signalPrice - futureClose
//   SHORT    : Reversal = futureHigh - signalPrice / Extension = signalPrice - futureLow  / signed = futureClose - signalPrice
//   （Reversal / Extension は負値を 0 に丸めて最大値を保持）
//   Horizon : 5m = 1 bar / 15m = 3 / 30m = 6 / 60m = 12 / 120m = 24（120m で active event から削除）
//
// 【No Lookahead】未来オフセット・負の履歴参照・過去イベントの書き換え・追加 request.* は一切使わない。
//   バーを時系列で進み、未来データが到着した時点でのみ active event を更新する。
// phaseCode は Production の PHASE CODE（input.source）をそのまま使う。Phase の再計算はしない。
grpTpAna = "⑨ TP Analyzer"
tpAnaEnable        = input.bool(true,  "TP Analyzer を有効にする",          group = grpTpAna)
tpAnaShowTable     = input.bool(true,  "TP Analyzer テーブルを表示 (左下)", group = grpTpAna)
tpAnaUseDateFilter = input.bool(false, "Signal 発生日で期間フィルター",     group = grpTpAna)
tpAnaStart         = input.time(timestamp("01 Jan 2020 00:00 +0000"), "期間 開始", group = grpTpAna)
tpAnaEnd           = input.time(timestamp("31 Dec 2099 23:59 +0000"), "期間 終了", group = grpTpAna)
revTh1             = input.float(5.0,  "Reversal Threshold 1 ($)", group = grpTpAna, step = 1.0, minval = 0)
revTh2             = input.float(10.0, "Reversal Threshold 2 ($)", group = grpTpAna, step = 1.0, minval = 0)
revTh3             = input.float(15.0, "Reversal Threshold 3 ($)", group = grpTpAna, step = 1.0, minval = 0)
revTh4             = input.float(20.0, "Reversal Threshold 4 ($)", group = grpTpAna, step = 1.0, minval = 0)
anaView            = input.string("PHASE LADDER", "表示ビュー", options = ["PHASE LADDER", "TP DETAIL", "TRADE LIFECYCLE", "FULL OPTIMIZER", "FEATURE TOURNAMENT"], group = grpTpAna)
ladderSide         = input.string("SHORT", "PHASE LADDER の Side",  options = ["LONG", "SHORT"],          group = grpTpAna)

// --- Active event（未成熟イベントのみ。120m 成熟で削除）---
var array<int>   EV_CLASS       = array.new_int()
var array<int>   EV_START_BAR   = array.new_int()
var array<float> EV_START_PRICE = array.new_float()
var array<float> EV_MAX_REV     = array.new_float()
var array<float> EV_MAX_EXT     = array.new_float()

// --- Aggregate（class index 0〜7）---
var array<int>   SIGNAL_COUNT      = array.new_int(8, 0)
var array<int>   MATURE_5          = array.new_int(8, 0)
var array<int>   MATURE_15         = array.new_int(8, 0)
var array<int>   MATURE_30         = array.new_int(8, 0)
var array<int>   MATURE_60         = array.new_int(8, 0)
var array<int>   MATURE_120        = array.new_int(8, 0)
var array<int>   CLOSE_SUCCESS_5   = array.new_int(8, 0)
var array<int>   CLOSE_SUCCESS_15  = array.new_int(8, 0)
var array<int>   CLOSE_SUCCESS_30  = array.new_int(8, 0)
var array<int>   CLOSE_SUCCESS_60  = array.new_int(8, 0)
var array<int>   CLOSE_SUCCESS_120 = array.new_int(8, 0)
var array<float> SUM_SIGNED_5      = array.new_float(8, 0.0)
var array<float> SUM_SIGNED_15     = array.new_float(8, 0.0)
var array<float> SUM_SIGNED_30     = array.new_float(8, 0.0)
var array<float> SUM_SIGNED_60     = array.new_float(8, 0.0)
var array<float> SUM_SIGNED_120    = array.new_float(8, 0.0)
var array<float> SUM_MAX_REV_30    = array.new_float(8, 0.0)
var array<float> SUM_MAX_EXT_30    = array.new_float(8, 0.0)
var array<float> SUM_MAX_REV_60    = array.new_float(8, 0.0)
var array<float> SUM_MAX_EXT_60    = array.new_float(8, 0.0)
var array<float> SUM_MAX_REV_120   = array.new_float(8, 0.0)
var array<float> SUM_MAX_EXT_120   = array.new_float(8, 0.0)
var array<int>   REV_HIT_5         = array.new_int(8, 0)
var array<int>   REV_HIT_10        = array.new_int(8, 0)
var array<int>   REV_HIT_15        = array.new_int(8, 0)
var array<int>   REV_HIT_20        = array.new_int(8, 0)

var int anaPrevPhaseCode = na

// =====================================================================================
// V3 TRADE LIFECYCLE（1つの方向 Episode につき PARTIAL 最大1回 / FULL 最大1回）
// =====================================================================================
// Episode = phaseCode の side（LONG > 0 / SHORT < 0）が同じ方向で続いている期間。
//   ・反対 side へ変わった瞬間だけ新 Episode（NEUTRAL = 0 ではリセットしない。最後の非0 side を保持）
//   ・PARTIAL : severity 3 で、その Episode でまだ PARTIAL も FULL も取っていない時だけ 1回
//   ・FULL    : severity 4 で、その Episode でまだ FULL を取っていない時だけ 1回（PARTIAL なしの直行も可）
//   ・FULL 後はその Episode を実運用上終了扱いとし、同じ side の TP はすべてノーカウント
//   ・初回 valid phase は baseline のみ（event 0）。severity から既に進んでいる状態を同期する
//     （PARTIAL → partial=true / FULL → partial=true, full=true）
//   ・初回 baseline の Episode は開始時点が不明なため Episode 統計（Episodes / 終了分類）には数えない
// event 生成方法以外（signal price / 次足からの tracking / 統計式）は既存と完全同一。
// 集計 array は既存（PHASE LADDER / TP DETAIL）と完全分離した LF_* を使う。
//   Lifecycle class : 0 = LONG PARTIAL / 1 = LONG FULL / 2 = SHORT PARTIAL / 3 = SHORT FULL
var int  lifeSide         = 0
var bool lifePartialTaken = false
var bool lifeFullTaken    = false
var bool lifeInitialized  = false
var bool lifeEpCounted    = false   // 現 Episode が Episode 統計の対象か（初回 baseline Episode は false）

// --- Lifecycle active event（既存 EV_* とは別）---
var array<int>   LF_EV_CLASS       = array.new_int()
var array<int>   LF_EV_START_BAR   = array.new_int()
var array<float> LF_EV_START_PRICE = array.new_float()
var array<float> LF_EV_MAX_REV     = array.new_float()
var array<float> LF_EV_MAX_EXT     = array.new_float()

// --- Lifecycle TP aggregate（class 0〜3）---
var array<int>   LF_SIGNAL_COUNT      = array.new_int(4, 0)
var array<int>   LF_MATURE_5          = array.new_int(4, 0)
var array<int>   LF_MATURE_15         = array.new_int(4, 0)
var array<int>   LF_MATURE_30         = array.new_int(4, 0)
var array<int>   LF_MATURE_60         = array.new_int(4, 0)
var array<int>   LF_MATURE_120        = array.new_int(4, 0)
var array<int>   LF_CLOSE_SUCCESS_5   = array.new_int(4, 0)
var array<int>   LF_CLOSE_SUCCESS_15  = array.new_int(4, 0)
var array<int>   LF_CLOSE_SUCCESS_30  = array.new_int(4, 0)
var array<int>   LF_CLOSE_SUCCESS_60  = array.new_int(4, 0)
var array<int>   LF_CLOSE_SUCCESS_120 = array.new_int(4, 0)
var array<float> LF_SUM_SIGNED_5      = array.new_float(4, 0.0)
var array<float> LF_SUM_SIGNED_15     = array.new_float(4, 0.0)
var array<float> LF_SUM_SIGNED_30     = array.new_float(4, 0.0)
var array<float> LF_SUM_SIGNED_60     = array.new_float(4, 0.0)
var array<float> LF_SUM_SIGNED_120    = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_REV_30    = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_EXT_30    = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_REV_60    = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_EXT_60    = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_REV_120   = array.new_float(4, 0.0)
var array<float> LF_SUM_MAX_EXT_120   = array.new_float(4, 0.0)
var array<int>   LF_REV_HIT_5         = array.new_int(4, 0)
var array<int>   LF_REV_HIT_10        = array.new_int(4, 0)
var array<int>   LF_REV_HIT_15        = array.new_int(4, 0)
var array<int>   LF_REV_HIT_20        = array.new_int(4, 0)

// --- Episode 統計（index 0 = LONG / 1 = SHORT）---
var array<int>   EP_COUNT         = array.new_int(2, 0)
var array<int>   EP_PARTIAL       = array.new_int(2, 0)
var array<int>   EP_FULL          = array.new_int(2, 0)
var array<int>   EP_PARTIAL_FULL  = array.new_int(2, 0)
var array<int>   EP_DIRECT_FULL   = array.new_int(2, 0)
var array<int>   EP_PARTIAL_ONLY  = array.new_int(2, 0)

// horizon 成熟時の close 統計（matured / success / signed sum）
f_anaCloseStat(array<int> mature, array<int> success, array<float> sumSigned, int cls, float signed) =>
    array.set(mature,    cls, array.get(mature, cls) + 1)
    array.set(sumSigned, cls, array.get(sumSigned, cls) + signed)
    if signed > 0
        array.set(success, cls, array.get(success, cls) + 1)
    cls

// Max Reversal / Extension snapshot
f_anaExcSnap(array<float> sumRev, array<float> sumExt, int cls, float mRev, float mExt) =>
    array.set(sumRev, cls, array.get(sumRev, cls) + mRev)
    array.set(sumExt, cls, array.get(sumExt, cls) + mExt)
    cls

// threshold hit（120m Max Reversal）
f_anaHit(array<int> hits, int cls, float mRev, float th) =>
    if mRev >= th
        array.set(hits, cls, array.get(hits, cls) + 1)
    cls

bool tpAnaRun = tpAnaEnable and isChart5M and barstate.isconfirmed

if tpAnaRun
    // ---- STEP 1 / 2 : 既存 active event を現在足で更新 → 成熟判定（後ろから回して削除に対応）----
    int nEv = array.size(EV_CLASS)
    if nEv > 0
        for i = nEv - 1 to 0
            int   cls    = array.get(EV_CLASS, i)
            int   sBar   = array.get(EV_START_BAR, i)
            float sPrice = array.get(EV_START_PRICE, i)
            bool  isLong = cls <= 3
            if sBar < bar_index
                // STEP 1 : 次の足以降の high / low だけで Max Reversal / Extension を更新
                float rev = isLong ? sPrice - low  : high - sPrice
                float ext = isLong ? high - sPrice : sPrice - low
                array.set(EV_MAX_REV, i, math.max(array.get(EV_MAX_REV, i), math.max(rev, 0.0)))
                array.set(EV_MAX_EXT, i, math.max(array.get(EV_MAX_EXT, i), math.max(ext, 0.0)))
                // STEP 2 : age 判定
                int   age    = bar_index - sBar
                float signed = isLong ? sPrice - close : close - sPrice
                float mRev   = array.get(EV_MAX_REV, i)
                float mExt   = array.get(EV_MAX_EXT, i)
                if age == 1
                    f_anaCloseStat(MATURE_5, CLOSE_SUCCESS_5, SUM_SIGNED_5, cls, signed)
                else if age == 3
                    f_anaCloseStat(MATURE_15, CLOSE_SUCCESS_15, SUM_SIGNED_15, cls, signed)
                else if age == 6
                    f_anaCloseStat(MATURE_30, CLOSE_SUCCESS_30, SUM_SIGNED_30, cls, signed)
                    f_anaExcSnap(SUM_MAX_REV_30, SUM_MAX_EXT_30, cls, mRev, mExt)
                else if age == 12
                    f_anaCloseStat(MATURE_60, CLOSE_SUCCESS_60, SUM_SIGNED_60, cls, signed)
                    f_anaExcSnap(SUM_MAX_REV_60, SUM_MAX_EXT_60, cls, mRev, mExt)
                else if age >= 24
                    f_anaCloseStat(MATURE_120, CLOSE_SUCCESS_120, SUM_SIGNED_120, cls, signed)
                    f_anaExcSnap(SUM_MAX_REV_120, SUM_MAX_EXT_120, cls, mRev, mExt)
                    f_anaHit(REV_HIT_5,  cls, mRev, revTh1)
                    f_anaHit(REV_HIT_10, cls, mRev, revTh2)
                    f_anaHit(REV_HIT_15, cls, mRev, revTh3)
                    f_anaHit(REV_HIT_20, cls, mRev, revTh4)
                    array.remove(EV_CLASS, i)
                    array.remove(EV_START_BAR, i)
                    array.remove(EV_START_PRICE, i)
                    array.remove(EV_MAX_REV, i)
                    array.remove(EV_MAX_EXT, i)

    // ---- STEP 1 / 2（Lifecycle）: 既存と同一の tracking を LF_* に対して行う ----
    int nLf = array.size(LF_EV_CLASS)
    if nLf > 0
        for i = nLf - 1 to 0
            int   cls    = array.get(LF_EV_CLASS, i)
            int   sBar   = array.get(LF_EV_START_BAR, i)
            float sPrice = array.get(LF_EV_START_PRICE, i)
            bool  isLong = cls <= 1
            if sBar < bar_index
                float rev = isLong ? sPrice - low  : high - sPrice
                float ext = isLong ? high - sPrice : sPrice - low
                array.set(LF_EV_MAX_REV, i, math.max(array.get(LF_EV_MAX_REV, i), math.max(rev, 0.0)))
                array.set(LF_EV_MAX_EXT, i, math.max(array.get(LF_EV_MAX_EXT, i), math.max(ext, 0.0)))
                int   age    = bar_index - sBar
                float signed = isLong ? sPrice - close : close - sPrice
                float mRev   = array.get(LF_EV_MAX_REV, i)
                float mExt   = array.get(LF_EV_MAX_EXT, i)
                if age == 1
                    f_anaCloseStat(LF_MATURE_5, LF_CLOSE_SUCCESS_5, LF_SUM_SIGNED_5, cls, signed)
                else if age == 3
                    f_anaCloseStat(LF_MATURE_15, LF_CLOSE_SUCCESS_15, LF_SUM_SIGNED_15, cls, signed)
                else if age == 6
                    f_anaCloseStat(LF_MATURE_30, LF_CLOSE_SUCCESS_30, LF_SUM_SIGNED_30, cls, signed)
                    f_anaExcSnap(LF_SUM_MAX_REV_30, LF_SUM_MAX_EXT_30, cls, mRev, mExt)
                else if age == 12
                    f_anaCloseStat(LF_MATURE_60, LF_CLOSE_SUCCESS_60, LF_SUM_SIGNED_60, cls, signed)
                    f_anaExcSnap(LF_SUM_MAX_REV_60, LF_SUM_MAX_EXT_60, cls, mRev, mExt)
                else if age >= 24
                    f_anaCloseStat(LF_MATURE_120, LF_CLOSE_SUCCESS_120, LF_SUM_SIGNED_120, cls, signed)
                    f_anaExcSnap(LF_SUM_MAX_REV_120, LF_SUM_MAX_EXT_120, cls, mRev, mExt)
                    f_anaHit(LF_REV_HIT_5,  cls, mRev, revTh1)
                    f_anaHit(LF_REV_HIT_10, cls, mRev, revTh2)
                    f_anaHit(LF_REV_HIT_15, cls, mRev, revTh3)
                    f_anaHit(LF_REV_HIT_20, cls, mRev, revTh4)
                    array.remove(LF_EV_CLASS, i)
                    array.remove(LF_EV_START_BAR, i)
                    array.remove(LF_EV_START_PRICE, i)
                    array.remove(LF_EV_MAX_REV, i)
                    array.remove(LF_EV_MAX_EXT, i)

    // ---- STEP 3 : PHASE ENTRY 判定（PARTIAL / FULL は Phase D / V1 LIGHT と同じ semantics）----
    if phaseValid and not na(anaPrevPhaseCode) and phaseCode != anaPrevPhaseCode
        int  aCurSev   = math.abs(phaseCode)
        int  aPrevSev  = math.abs(anaPrevPhaseCode)
        int  aCurSide  = phaseCode > 0 ? 1 : phaseCode < 0 ? -1 : 0
        int  aPrevSide = anaPrevPhaseCode > 0 ? 1 : anaPrevPhaseCode < 0 ? -1 : 0
        bool aEntry    = aCurSide != 0 and (aCurSide != aPrevSide or aCurSev > aPrevSev)
        bool inRange   = not tpAnaUseDateFilter or (time >= tpAnaStart and time <= tpAnaEnd)
        if aEntry and inRange
            // +1〜+4 → class 0〜3 / -1〜-4 → class 4〜7
            int newCls = phaseCode > 0 ? phaseCode - 1 : 3 - phaseCode
            array.push(EV_CLASS,       newCls)
            array.push(EV_START_BAR,   bar_index)
            array.push(EV_START_PRICE, close)
            array.push(EV_MAX_REV,     0.0)
            array.push(EV_MAX_EXT,     0.0)
            array.set(SIGNAL_COUNT, newCls, array.get(SIGNAL_COUNT, newCls) + 1)

    // ---- STEP 3（Lifecycle）: Episode / PARTIAL / FULL の重複排除 ----
    if phaseValid
        int  lSide    = phaseCode > 0 ? 1 : phaseCode < 0 ? -1 : 0
        int  lSev     = math.abs(phaseCode)
        bool lInRange = not tpAnaUseDateFilter or (time >= tpAnaStart and time <= tpAnaEnd)
        if not lifeInitialized
            // 初回 valid phase : baseline 同期のみ（event 0・Episode 統計対象外）
            lifeInitialized  := true
            lifeSide         := lSide
            lifePartialTaken := lSide != 0 and lSev >= 3
            lifeFullTaken    := lSide != 0 and lSev >= 4
            lifeEpCounted    := false
        else
            // 反対 side への切替（NEUTRAL からの最初の side 確定を含む）→ 旧 Episode を finalize して新 Episode
            if lSide != 0 and lSide != lifeSide
                if lifeSide != 0 and lifeEpCounted
                    int oIdx = lifeSide == 1 ? 0 : 1
                    if lifePartialTaken and not lifeFullTaken
                        array.set(EP_PARTIAL_ONLY, oIdx, array.get(EP_PARTIAL_ONLY, oIdx) + 1)
                    else if lifePartialTaken and lifeFullTaken
                        array.set(EP_PARTIAL_FULL, oIdx, array.get(EP_PARTIAL_FULL, oIdx) + 1)
                    else if lifeFullTaken
                        array.set(EP_DIRECT_FULL, oIdx, array.get(EP_DIRECT_FULL, oIdx) + 1)
                lifeSide         := lSide
                lifePartialTaken := false
                lifeFullTaken    := false
                lifeEpCounted    := lInRange
                if lifeEpCounted
                    int nIdx = lSide == 1 ? 0 : 1
                    array.set(EP_COUNT, nIdx, array.get(EP_COUNT, nIdx) + 1)
            // 同じ Episode 内の PARTIAL / FULL（NEUTRAL 中は何もしない）
            if lSide != 0 and lSide == lifeSide
                int  eIdx   = lSide == 1 ? 0 : 1
                int  lfCls  = -1
                if lSev == 3 and not lifePartialTaken and not lifeFullTaken
                    lifePartialTaken := true
                    lfCls := lSide == 1 ? 0 : 2
                    if lifeEpCounted
                        array.set(EP_PARTIAL, eIdx, array.get(EP_PARTIAL, eIdx) + 1)
                else if lSev == 4 and not lifeFullTaken
                    lifeFullTaken := true
                    lfCls := lSide == 1 ? 1 : 3
                    if lifeEpCounted
                        array.set(EP_FULL, eIdx, array.get(EP_FULL, eIdx) + 1)
                if lfCls >= 0 and lInRange
                    array.push(LF_EV_CLASS,       lfCls)
                    array.push(LF_EV_START_BAR,   bar_index)
                    array.push(LF_EV_START_PRICE, close)
                    array.push(LF_EV_MAX_REV,     0.0)
                    array.push(LF_EV_MAX_EXT,     0.0)
                    array.set(LF_SIGNAL_COUNT, lfCls, array.get(LF_SIGNAL_COUNT, lfCls) + 1)

    // ---- STEP 4 : baseline 更新（date filter 外でも更新。INVALID な source 値は baseline にしない）----
    if phaseValid
        anaPrevPhaseCode := phaseCode


// =====================================================================================
// V4 FULL TP THRESHOLD OPTIMIZER（Lifecycle 方式 / TRAIN-TEST）
// =====================================================================================
// Production の Data Window 出力（CURRENT DOMINANCE / PRE DOMINANCE / PRE TOTAL /
// OPPOSITE PRE TF COUNT）を input.source で受け取り、Phase C V2 の STRONG（FULL TP）構造
//   routeA = oppDom >= STR and opp >= OPP
//   routeB = curStrength <= CDOM and oppDom >= CPRE and opp >= OPP
//   candidateFull = preTotal >= optMinPreTotal and (routeA or routeB)
// の閾値だけを固定 Grid（7 × 5 × 2 × 2 = 140 configs）で差し替えて比較する。
// 各 config は選択 side の 1 Episode につき FULL event 最大1回（Episode = CURRENT DOM 符号の連続。
// NEUTRAL ではリセットせず、反対 side から選択 side へ切り替わった時だけ全 config の taken をリセット）。
// Signal price / 次足からの tracking / 120m 統計式は既存 Analyzer と同一。
// TRAIN / TEST は loaded bar_index の optTrainPct% で時系列分割し、Signal 発生バーで区分を固定する。
// 順位付けは TRAIN だけで行い、TEST は検証表示専用（順位に使わない）。
// 既存 View（PHASE LADDER / TP DETAIL / TRADE LIFECYCLE）の array・処理とは完全分離。
// 処理は FULL OPTIMIZER View 選択中・5M 確定足・source valid の時だけ実行する（性能対策）。
grpOpt = "⑩ FULL Optimizer"
optCurrentDomSource = input.source(close, "OPT : CURRENT DOMINANCE",       group = grpOpt)
optPreDomSource     = input.source(close, "OPT : PRE DOMINANCE",           group = grpOpt)
optPreTotalSource   = input.source(close, "OPT : PRE TOTAL",               group = grpOpt)
optOppCountSource   = input.source(close, "OPT : OPPOSITE PRE TF COUNT",   group = grpOpt)
optSide             = input.string("SHORT", "OPT Side", options = ["SHORT", "LONG"], group = grpOpt)
optMinPreTotal      = input.float(2.0,  "OPT 最低PRE証拠量 (PRE TOTAL)", group = grpOpt, minval = 0.0, step = 0.1)
optTrainPct         = input.int(70,     "TRAIN %",                       group = grpOpt, minval = 50, maxval = 90, step = 5)
optMetric           = input.string("Close Rev 120m", "Optimization Metric", options = ["Close Rev 120m", "Rev >= $10 / 120m", "Rev >= $15 / 120m", "Rev >= $20 / 120m", "REV10 before EXT5"], group = grpOpt)
optTargetPct        = input.float(70.0, "Target %",                      group = grpOpt, step = 1.0)
optMinTrain         = input.int(50,     "Min TRAIN matured",             group = grpOpt, minval = 1)
optMinTest          = input.int(20,     "Min TEST matured",              group = grpOpt, minval = 1)
// V5 FIRST HIT : FULL TP 後、元方向へ EXT $ 伸びるより先に逆方向へ REV $ 反転したか（Grid には含めない）
optFirstHitRev      = input.float(10.0, "First Hit REV ($)",             group = grpOpt, minval = 0.1, step = 1.0)
optFirstHitExt      = input.float(5.0,  "First Hit EXT ($)",             group = grpOpt, minval = 0.1, step = 1.0)
bool optIsFH        = optMetric == "REV10 before EXT5"

// ---- source validation ----
float optCurDom  = optCurrentDomSource
float optPreDom  = optPreDomSource
float optPreTot  = optPreTotalSource
int   optOppCnt  = int(math.round(optOppCountSource))
bool  optValid   = not na(optCurDom) and optCurDom >= -1.0 and optCurDom <= 1.0 and not na(optPreDom) and optPreDom >= -1.0 and optPreDom <= 1.0 and not na(optPreTot) and optPreTot >= 0 and not na(optOppCnt) and optOppCnt >= 0 and optOppCnt <= 4
int   optSel     = optSide == "LONG" ? 1 : -1

// ---- 固定 Grid（140 configs）。config index = ((s * 5 + p) * 2 + d) * 2 + o ----
var array<float> OPT_STR_GRID  = array.from(0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70)
var array<float> OPT_CPRE_GRID = array.from(0.15, 0.20, 0.25, 0.30, 0.35)
var array<float> OPT_CDOM_GRID = array.from(0.03, 0.05)
var array<int>   OPT_OPP_GRID  = array.from(3, 4)
int OPT_N = 140
var array<float> CFG_STR  = array.new_float()
var array<float> CFG_CPRE = array.new_float()
var array<float> CFG_CDOM = array.new_float()
var array<int>   CFG_OPP  = array.new_int()
if array.size(CFG_STR) == 0
    for si = 0 to 6
        for pi = 0 to 4
            for di = 0 to 1
                for oi = 0 to 1
                    array.push(CFG_STR,  array.get(OPT_STR_GRID,  si))
                    array.push(CFG_CPRE, array.get(OPT_CPRE_GRID, pi))
                    array.push(CFG_CDOM, array.get(OPT_CDOM_GRID, di))
                    array.push(CFG_OPP,  array.get(OPT_OPP_GRID,  oi))
// Production 既定値（STR .40 / CPRE .15 / CDOM .05 / OPP 3）の config index
int OPT_PROD_CFG = ((0 * 5 + 0) * 2 + 1) * 2 + 0

// ---- Lifecycle 状態（config 別 FULL taken）----
var array<bool> OPT_FULL_TAKEN = array.new_bool(140, false)
var int  optEpSide = 0
var bool optInit   = false

// ---- Active event（120m で remove）----
var array<int>   OPT_EV_CFG   = array.new_int()
var array<int>   OPT_EV_BAR   = array.new_int()
var array<float> OPT_EV_PRICE = array.new_float()
var array<float> OPT_EV_REV   = array.new_float()
var array<float> OPT_EV_EXT   = array.new_float()
var array<int>   OPT_EV_SPLIT = array.new_int()     // 0 = TRAIN / 1 = TEST（Signal 時に固定）
var array<int>   OPT_EV_FH    = array.new_int()     // V5 First Hit : 0 = 未決着 / 1 = REV_FIRST / 2 = EXT_FIRST / 3 = AMBIGUOUS

// ---- 集計（index = config * 2 + split）----
var array<int>   OPT_SIG     = array.new_int(280, 0)
var array<int>   OPT_MAT     = array.new_int(280, 0)
var array<int>   OPT_CS      = array.new_int(280, 0)
var array<float> OPT_SSUM    = array.new_float(280, 0.0)
var array<float> OPT_REVSUM  = array.new_float(280, 0.0)
var array<float> OPT_EXTSUM  = array.new_float(280, 0.0)
var array<int>   OPT_HIT10   = array.new_int(280, 0)
var array<int>   OPT_HIT15   = array.new_int(280, 0)
var array<int>   OPT_HIT20   = array.new_int(280, 0)
// V5 First Hit 集計（index = config * 2 + split。120m 成熟時に確定。合計 = OPT_MAT）
var array<int>   OPT_FH_REV  = array.new_int(280, 0)    // REV_FIRST
var array<int>   OPT_FH_EXT  = array.new_int(280, 0)    // EXT_FIRST
var array<int>   OPT_FH_AMB  = array.new_int(280, 0)    // 同一5M足で両方 hit（順序不明 → 成功扱い禁止）
var array<int>   OPT_FH_UNR  = array.new_int(280, 0)    // 24bar 以内にどちらも未到達

// candidate FULL（Production Phase C V2 STRONG と同じ構造で閾値だけ config 値）
f_optCand(int c, float oppDomV, float curStrV, float preTotV, int oppV) =>
    int  o  = array.get(CFG_OPP, c)
    bool rA = oppDomV >= array.get(CFG_STR, c) and oppV >= o
    bool rB = curStrV <= array.get(CFG_CDOM, c) and oppDomV >= array.get(CFG_CPRE, c) and oppV >= o
    preTotV >= optMinPreTotal and (rA or rB)

f_optInc(array<int> arr, int k) =>
    array.set(arr, k, array.get(arr, k) + 1)
    k

if tpAnaRun and anaView == "FULL OPTIMIZER" and optValid
    bool optIsLong = optSel == 1
    // ---- STEP 1 / 2 : active event 更新（次足以降の high / low）→ 120m 成熟 ----
    int nOpt = array.size(OPT_EV_CFG)
    if nOpt > 0
        for i = nOpt - 1 to 0
            int   sBar   = array.get(OPT_EV_BAR, i)
            float sPrice = array.get(OPT_EV_PRICE, i)
            if sBar < bar_index
                float rev = optIsLong ? sPrice - low  : high - sPrice
                float ext = optIsLong ? high - sPrice : sPrice - low
                array.set(OPT_EV_REV, i, math.max(array.get(OPT_EV_REV, i), math.max(rev, 0.0)))
                array.set(OPT_EV_EXT, i, math.max(array.get(OPT_EV_EXT, i), math.max(ext, 0.0)))
                // V5 First Hit（未決着の間だけ判定。signal bar 自身は sBar < bar_index で除外済み）
                if array.get(OPT_EV_FH, i) == 0
                    bool fhRev = optIsLong ? low  <= sPrice - optFirstHitRev : high >= sPrice + optFirstHitRev
                    bool fhExt = optIsLong ? high >= sPrice + optFirstHitExt : low  <= sPrice - optFirstHitExt
                    if fhRev and fhExt
                        array.set(OPT_EV_FH, i, 3)      // AMBIGUOUS（同一足内の順序は OHLC では不明）
                    else if fhRev
                        array.set(OPT_EV_FH, i, 1)      // REV_FIRST
                    else if fhExt
                        array.set(OPT_EV_FH, i, 2)      // EXT_FIRST
                if bar_index - sBar >= 24
                    int   k      = array.get(OPT_EV_CFG, i) * 2 + array.get(OPT_EV_SPLIT, i)
                    float signed = optIsLong ? sPrice - close : close - sPrice
                    float mRev   = array.get(OPT_EV_REV, i)
                    f_optInc(OPT_MAT, k)
                    if signed > 0
                        f_optInc(OPT_CS, k)
                    array.set(OPT_SSUM,   k, array.get(OPT_SSUM, k)   + signed)
                    array.set(OPT_REVSUM, k, array.get(OPT_REVSUM, k) + mRev)
                    array.set(OPT_EXTSUM, k, array.get(OPT_EXTSUM, k) + array.get(OPT_EV_EXT, i))
                    if mRev >= 10.0
                        f_optInc(OPT_HIT10, k)
                    if mRev >= 15.0
                        f_optInc(OPT_HIT15, k)
                    if mRev >= 20.0
                        f_optInc(OPT_HIT20, k)
                    int fh = array.get(OPT_EV_FH, i)
                    if fh == 1
                        f_optInc(OPT_FH_REV, k)
                    else if fh == 2
                        f_optInc(OPT_FH_EXT, k)
                    else if fh == 3
                        f_optInc(OPT_FH_AMB, k)
                    else
                        f_optInc(OPT_FH_UNR, k)         // UNRESOLVED_120
                    array.remove(OPT_EV_CFG, i)
                    array.remove(OPT_EV_BAR, i)
                    array.remove(OPT_EV_PRICE, i)
                    array.remove(OPT_EV_REV, i)
                    array.remove(OPT_EV_EXT, i)
                    array.remove(OPT_EV_SPLIT, i)
                    array.remove(OPT_EV_FH, i)

    // ---- STEP 3 : Episode / config 別 FULL（Lifecycle）----
    int   oSide    = optCurDom > 0 ? 1 : optCurDom < 0 ? -1 : 0
    float oCurStr  = math.abs(optCurDom)
    float oOppDom  = oSide == 1 ? -optPreDom : oSide == -1 ? optPreDom : 0.0
    bool  oInRange = not tpAnaUseDateFilter or (time >= tpAnaStart and time <= tpAnaEnd)
    int   oSplit   = bar_index <= int(math.floor(last_bar_index * optTrainPct / 100.0)) ? 0 : 1
    if not optInit
        // 初回 valid source : baseline のみ（event 0）。選択 side で開始していれば成立済み config を taken に同期
        optInit   := true
        optEpSide := oSide
        if oSide == optSel
            for c = 0 to OPT_N - 1
                array.set(OPT_FULL_TAKEN, c, f_optCand(c, oOppDom, oCurStr, optPreTot, optOppCnt))
    else
        // 反対 side へ切替（NEUTRAL ではリセットしない）。選択 side に入った時だけ全 config の taken をリセット
        if oSide != 0 and oSide != optEpSide
            optEpSide := oSide
            if oSide == optSel
                array.fill(OPT_FULL_TAKEN, false)
        if oSide == optSel
            for c = 0 to OPT_N - 1
                if not array.get(OPT_FULL_TAKEN, c) and f_optCand(c, oOppDom, oCurStr, optPreTot, optOppCnt)
                    array.set(OPT_FULL_TAKEN, c, true)
                    if oInRange
                        array.push(OPT_EV_CFG,   c)
                        array.push(OPT_EV_BAR,   bar_index)
                        array.push(OPT_EV_PRICE, close)
                        array.push(OPT_EV_REV,   0.0)
                        array.push(OPT_EV_EXT,   0.0)
                        array.push(OPT_EV_SPLIT, oSplit)
                        array.push(OPT_EV_FH,    0)
                        f_optInc(OPT_SIG, c * 2 + oSplit)


// =====================================================================================
// V6 PRE-REVERSAL FEATURE TOURNAMENT（REV before EXT / Lifecycle / TRAIN-TEST）
// =====================================================================================
// Production の OPPOSITE PRE FEATURE PACK（Data Window）を input.source で受け取り、
// 既存 Optimizer の 4 source（CURRENT DOM / PRE DOM / PRE TOTAL / OPP COUNT）と併用する。
// base FULL（Production 既定値の routeA / routeB）に先行 Feature の Recipe（48 固定）を AND し、
// Route Mode（ANY / A_ONLY / B_ONLY）× 48 = 144 configs を V4/V5 と同じ Lifecycle・First Hit・TRAIN/TEST で比較する。
// 処理は FEATURE TOURNAMENT View 選択中・5M 確定足・全 source valid の時だけ（FULL OPTIMIZER と同時実行しない）。
// 既存 View / Optimizer の array・処理とは完全分離。
grpFt = "⑪ Feature Tournament"
// Production の OPPOSITE PRE FEATURE PACK（現在の CURRENT side に対する逆方向 PRE Feature。0〜255）
//   bit0 STRUCTURE / bit1 FIB / bit2 SAT / bit3 STOCH / bit4 SAT 2/3 / bit5 FIB618 / bit6 15M+1H / bit7 5M+15M+1H
ftOppFeaturePackSource = input.source(close, "FT : OPPOSITE PRE FEATURE PACK", group = grpFt)
ftStrongDom      = input.float(0.40, "FT base : Strong PRE DOM",       group = grpFt, step = 0.01)
ftCollapsePreDom = input.float(0.15, "FT base : Collapse PRE DOM",     group = grpFt, step = 0.01)
ftCollapseCurDom = input.float(0.05, "FT base : Collapse CURRENT DOM", group = grpFt, step = 0.01)
ftBaseOpp        = input.int(3,      "FT base : OPP Count",            group = grpFt, minval = 0, maxval = 4)
ftMinPreTotal    = input.float(2.0,  "FT base : Min PRE TOTAL",        group = grpFt, step = 0.1)

// ---- source validation（PACK は 0〜255 の整数相当。既存 Optimizer 4 source と合わせて 5 本）----
f_ftPackOk(float v) => not na(v) and v >= 0 and v <= 255 and math.abs(v - math.round(v)) < 0.001
bool ftValid = optValid and f_ftPackOk(ftOppFeaturePackSource)

// ---- PRE acceleration（毎バー計算して履歴を保つ。選択 side 基準の oppDom）----
//   SHORT : oppDom = preDom / LONG : oppDom = -preDom。現在〜3本前がすべて選択 side の時だけ valid
int   ftSideNow  = optCurDom > 0 ? 1 : optCurDom < 0 ? -1 : 0
float ftOppDomS  = optSel == -1 ? optPreDom : -optPreDom
bool  ftAccelOk  = ftSideNow == optSel and nz(ftSideNow[1]) == optSel and nz(ftSideNow[2]) == optSel and nz(ftSideNow[3]) == optSel and not na(ftOppDomS[3])
float ftAccel15  = ftAccelOk ? ftOppDomS - ftOppDomS[3] : na

// ---- Recipe（48 固定）: 必要 Feature bit の和 ----
//   F2=1 F3=2 F4=4 S=8 SAT2=16 F618=32 ST=64 M15=128 M5=256 A10=512 A15=1024 P4=2048 P6=4096
var array<int>    FT_RECIPE_REQ   = array.from(0, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 24, 136, 144, 10, 18, 130, 514, 2050, 40, 72, 96, 104, 152, 26, 138, 146, 154, 666, 1178, 2202, 4250, 258, 280, 282, 794, 2330, 153, 156, 42, 74, 106, 58, 90, 250)
var array<string> FT_RECIPE_LABEL = array.from("NONE", "F2", "F3", "F4", "S", "SAT2", "F618", "ST", "M15", "M5", "A10", "A15", "P4", "P6", "S+SAT2", "S+M15", "SAT2+M15", "F3+S", "F3+SAT2", "F3+M15", "F3+A10", "F3+P4", "S+F618", "S+ST", "F618+ST", "S+F618+ST", "S+SAT2+M15", "F3+S+SAT2", "F3+S+M15", "F3+SAT2+M15", "F3+S+SAT2+M15", "F3+S+SAT2+M15+A10", "F3+S+SAT2+M15+A15", "F3+S+SAT2+M15+P4", "F3+S+SAT2+M15+P6", "F3+M5", "S+SAT2+M5", "F3+S+SAT2+M5", "F3+S+SAT2+M5+A10", "F3+S+SAT2+M5+P4", "F2+S+SAT2+M15", "F4+S+SAT2+M15", "F3+F618+S", "F3+ST+S", "F3+F618+ST+S", "F3+SAT2+F618+S", "F3+SAT2+ST+S", "F3+SAT2+F618+ST+S+M15")
int FT_N_RECIPE = 48
int FT_N        = 144     // config = recipe * 3 + routeMode（0 = ANY / 1 = A_ONLY / 2 = B_ONLY）

// bit 判定（mask は整数相当の float / int）
f_ftBit(float v, int b) => math.floor(math.round(v) / math.pow(2, b)) % 2 == 1

// ---- Lifecycle / active event / 集計（index = config * 2 + split）----
var array<bool>  FT_TAKEN    = array.new_bool(144, false)
var int  ftEpSide = 0
var bool ftInit   = false
var array<int>   FT_EV_CFG   = array.new_int()
var array<int>   FT_EV_BAR   = array.new_int()
var array<float> FT_EV_PRICE = array.new_float()
var array<int>   FT_EV_SPLIT = array.new_int()
var array<int>   FT_EV_FH    = array.new_int()     // 0 未決着 / 1 REV_FIRST / 2 EXT_FIRST / 3 AMBIG
var array<int>   FT_SIG = array.new_int(288, 0)
var array<int>   FT_MAT = array.new_int(288, 0)
var array<int>   FT_REV = array.new_int(288, 0)
var array<int>   FT_EXT = array.new_int(288, 0)
var array<int>   FT_AMB = array.new_int(288, 0)
var array<int>   FT_UNR = array.new_int(288, 0)

if tpAnaRun and anaView == "FEATURE TOURNAMENT" and ftValid
    bool ftIsLong = optSel == 1
    // ---- STEP 1 / 2 : First Hit（次足以降）→ 24bar 成熟 ----
    int nFt = array.size(FT_EV_CFG)
    if nFt > 0
        for i = nFt - 1 to 0
            int   sBar   = array.get(FT_EV_BAR, i)
            float sPrice = array.get(FT_EV_PRICE, i)
            if sBar < bar_index
                if array.get(FT_EV_FH, i) == 0
                    bool fhRev = ftIsLong ? low  <= sPrice - optFirstHitRev : high >= sPrice + optFirstHitRev
                    bool fhExt = ftIsLong ? high >= sPrice + optFirstHitExt : low  <= sPrice - optFirstHitExt
                    if fhRev and fhExt
                        array.set(FT_EV_FH, i, 3)
                    else if fhRev
                        array.set(FT_EV_FH, i, 1)
                    else if fhExt
                        array.set(FT_EV_FH, i, 2)
                if bar_index - sBar >= 24
                    int k  = array.get(FT_EV_CFG, i) * 2 + array.get(FT_EV_SPLIT, i)
                    int fh = array.get(FT_EV_FH, i)
                    f_optInc(FT_MAT, k)
                    if fh == 1
                        f_optInc(FT_REV, k)
                    else if fh == 2
                        f_optInc(FT_EXT, k)
                    else if fh == 3
                        f_optInc(FT_AMB, k)
                    else
                        f_optInc(FT_UNR, k)
                    array.remove(FT_EV_CFG, i)
                    array.remove(FT_EV_BAR, i)
                    array.remove(FT_EV_PRICE, i)
                    array.remove(FT_EV_SPLIT, i)
                    array.remove(FT_EV_FH, i)

    // ---- STEP 3 : Feature 計算（選択 side から見た逆方向 PRE）----
    // PACK は Production 側で既に「CURRENT side の逆方向」を詰めている（評価は side == 選択 side の時だけ）
    float oppMask  = ftOppFeaturePackSource
    bool  fStruct  = f_ftBit(oppMask, 0)
    bool  fFibAny  = f_ftBit(oppMask, 1)
    bool  fSatAny  = f_ftBit(oppMask, 2)
    bool  fStoch   = f_ftBit(oppMask, 3)
    bool  fSat2    = f_ftBit(oppMask, 4)
    bool  fFib618  = f_ftBit(oppMask, 5)
    int   famCnt   = (fStruct ? 1 : 0) + (fFibAny ? 1 : 0) + (fSatAny ? 1 : 0) + (fStoch ? 1 : 0)
    // MTF alignment（Production 側で strict 判定済み）: bit6 = 15M+1H / bit7 = 5M+15M+1H
    bool  fM15     = f_ftBit(oppMask, 6)
    bool  fM5      = f_ftBit(oppMask, 7)
    bool  fA10     = not na(ftAccel15) and ftAccel15 >= 0.10
    bool  fA15     = not na(ftAccel15) and ftAccel15 >= 0.15
    bool  fP4      = optPreTot >= 4.0
    bool  fP6      = optPreTot >= 6.0
    array<bool> feat = array.from(famCnt >= 2, famCnt >= 3, famCnt >= 4, fStruct, fSat2, fFib618, fStoch, fM15, fM5, fA10, fA15, fP4, fP6)
    array<bool> recOk = array.new_bool(48, false)
    for r = 0 to FT_N_RECIPE - 1
        int  req = array.get(FT_RECIPE_REQ, r)
        bool ok  = true
        for b = 0 to 12
            if math.floor(req / math.pow(2, b)) % 2 == 1 and not array.get(feat, b)
                ok := false
        array.set(recOk, r, ok)

    // ---- base FULL（routeA / routeB）----
    int   fSide    = ftSideNow
    float fCurStr  = math.abs(optCurDom)
    float fOppDom  = fSide == 1 ? -optPreDom : fSide == -1 ? optPreDom : 0.0
    bool  rA       = fOppDom >= ftStrongDom and optOppCnt >= ftBaseOpp
    bool  rB       = fCurStr <= ftCollapseCurDom and fOppDom >= ftCollapsePreDom and optOppCnt >= ftBaseOpp
    bool  preOk    = optPreTot >= ftMinPreTotal
    bool  baseAny  = preOk and (rA or rB)
    bool  baseA    = preOk and rA
    bool  baseB    = preOk and rB
    bool  fInRange = not tpAnaUseDateFilter or (time >= tpAnaStart and time <= tpAnaEnd)
    int   fSplit   = bar_index <= int(math.floor(last_bar_index * optTrainPct / 100.0)) ? 0 : 1

    // ---- STEP 4 : Lifecycle（config 別 FULL 最大1回 / Episode）----
    if not ftInit
        ftInit   := true
        ftEpSide := fSide
        if fSide == optSel
            for c = 0 to FT_N - 1
                int  md = c % 3
                bool bs = md == 0 ? baseAny : md == 1 ? baseA : baseB
                array.set(FT_TAKEN, c, bs and array.get(recOk, int(c / 3)))
    else
        if fSide != 0 and fSide != ftEpSide
            ftEpSide := fSide
            if fSide == optSel
                array.fill(FT_TAKEN, false)
        if fSide == optSel and baseAny
            for c = 0 to FT_N - 1
                int  md = c % 3
                bool bs = md == 0 ? baseAny : md == 1 ? baseA : baseB
                if not array.get(FT_TAKEN, c) and bs and array.get(recOk, int(c / 3))
                    array.set(FT_TAKEN, c, true)
                    if fInRange
                        array.push(FT_EV_CFG,   c)
                        array.push(FT_EV_BAR,   bar_index)
                        array.push(FT_EV_PRICE, close)
                        array.push(FT_EV_SPLIT, fSplit)
                        array.push(FT_EV_FH,    0)
                        f_optInc(FT_SIG, c * 2 + fSplit)

// ---- Result Table（左下。Production の右上メイン / 右下詳細とは別）-------------------------
f_anaPct(int num, int den) => den > 0 ? str.tostring(num * 100.0 / den, "0.0") + "%" : "-"
f_anaAvg(float sum, int den) => den > 0 ? str.tostring(sum / den, "0.00") : "-"
f_anaSgn(float v) => v > 0 ? "+" : v < 0 ? "-" : ""

// Lift vs HOLD（percentage point）: Phase rate - HOLD rate。どちらかの分母が 0 なら "-"
f_anaLiftPt(int num, int den, int hNum, int hDen) =>
    float d = den > 0 and hDen > 0 ? num * 100.0 / den - hNum * 100.0 / hDen : na
    na(d) ? "-" : f_anaSgn(d) + str.tostring(math.abs(d), "0.0") + "pt"
// Lift vs HOLD（$）: Phase 平均 - HOLD 平均
f_anaLiftUsd(float sum, int den, float hSum, int hDen) =>
    float d = den > 0 and hDen > 0 ? sum / den - hSum / hDen : na
    na(d) ? "-" : f_anaSgn(d) + str.tostring(math.abs(d), "0.00") + "$"

var anaTbl = table.new(position.bottom_left, 5, 32, border_width = 1)

// 1行ぶん（列 1〜4 に cols の class を並べる）
f_anaCell(int col, int row, string txt) =>
    table.cell(anaTbl, col, row, txt, text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    col

f_anaRowPct(int row, string label, array<int> num, array<int> den, array<int> cols) =>
    f_anaCell(0, row, label)
    for c = 0 to 3
        int k = array.get(cols, c)
        f_anaCell(c + 1, row, f_anaPct(array.get(num, k), array.get(den, k)))
    row

f_anaRowAvg(int row, string label, array<float> sum, array<int> den, array<int> cols) =>
    f_anaCell(0, row, label)
    for c = 0 to 3
        int k = array.get(cols, c)
        f_anaCell(c + 1, row, f_anaAvg(array.get(sum, k), array.get(den, k)))
    row

f_anaRowCnt(int row, string label, array<int> cnt, array<int> cols) =>
    f_anaCell(0, row, label)
    for c = 0 to 3
        f_anaCell(c + 1, row, str.tostring(array.get(cnt, array.get(cols, c))))
    row

// Lift 行（cols[0] = HOLD を baseline とする）
f_anaRowLiftPt(int row, string label, array<int> num, array<int> den, array<int> cols) =>
    f_anaCell(0, row, label)
    int h = array.get(cols, 0)
    for c = 0 to 3
        int k = array.get(cols, c)
        f_anaCell(c + 1, row, f_anaLiftPt(array.get(num, k), array.get(den, k), array.get(num, h), array.get(den, h)))
    row

f_anaRowLiftUsd(int row, string label, array<float> sum, array<int> den, array<int> cols) =>
    f_anaCell(0, row, label)
    int h = array.get(cols, 0)
    for c = 0 to 3
        int k = array.get(cols, c)
        f_anaCell(c + 1, row, f_anaLiftUsd(array.get(sum, k), array.get(den, k), array.get(sum, h), array.get(den, h)))
    row

// 上部の情報行（col1 に値、col2〜4 は空）
f_anaInfo(int row, string label, string val, color valCol) =>
    f_anaCell(0, row, label)
    table.cell(anaTbl, 1, row, val, text_color = valCol, bgcolor = colBg, text_size = tblSize)
    for c = 2 to 4
        f_anaCell(c, row, "")
    row

// Episode Summary 行（col1 = LONG / col2 = SHORT / col3〜4 は空）
f_lfEpCnt(int row, string label, array<int> cnt) =>
    f_anaCell(0, row, label)
    f_anaCell(1, row, str.tostring(array.get(cnt, 0)))
    f_anaCell(2, row, str.tostring(array.get(cnt, 1)))
    f_anaCell(3, row, "")
    f_anaCell(4, row, "")
    row

f_lfEpRate(int row, string label, array<int> num, array<int> den) =>
    f_anaCell(0, row, label)
    f_anaCell(1, row, f_anaPct(array.get(num, 0), array.get(den, 0)))
    f_anaCell(2, row, f_anaPct(array.get(num, 1), array.get(den, 1)))
    f_anaCell(3, row, "")
    f_anaCell(4, row, "")
    row

// Raw → Lifecycle Reduction（1 - Lifecycle / Raw）。Raw が 0 なら "-"
f_lfReduction(int raw, int life) => raw > 0 ? str.tostring((1.0 - life * 1.0 / raw) * 100.0, "0.0") + "%" : "-"


        table.cell(anaTbl, 4, 2, "SHORT\nFULL",     text_color = colShort, bgcolor = colBg, text_size = tblSize)
        f_anaRowCnt(3,  "Signals",            SIGNAL_COUNT,                  tc)
        f_anaRowCnt(4,  "Matured 120m",       MATURE_120,                    tc)
        f_anaRowPct(5,  "Close Rev 5m %",     CLOSE_SUCCESS_5,   MATURE_5,   tc)
        f_anaRowPct(6,  "Close Rev 15m %",    CLOSE_SUCCESS_15,  MATURE_15,  tc)
        f_anaRowPct(7,  "Close Rev 30m %",    CLOSE_SUCCESS_30,  MATURE_30,  tc)
        f_anaRowPct(8,  "Close Rev 60m %",    CLOSE_SUCCESS_60,  MATURE_60,  tc)
        f_anaRowPct(9,  "Close Rev 120m %",   CLOSE_SUCCESS_120, MATURE_120, tc)
        f_anaRowAvg(10, "Avg Signed 5m $",    SUM_SIGNED_5,      MATURE_5,   tc)
        f_anaRowAvg(11, "Avg Signed 15m $",   SUM_SIGNED_15,     MATURE_15,  tc)
        f_anaRowAvg(12, "Avg Signed 30m $",   SUM_SIGNED_30,     MATURE_30,  tc)
        f_anaRowAvg(13, "Avg Signed 60m $",   SUM_SIGNED_60,     MATURE_60,  tc)
        f_anaRowAvg(14, "Avg Signed 120m $",  SUM_SIGNED_120,    MATURE_120, tc)
        f_anaRowAvg(15, "Avg Max Rev 30m $",  SUM_MAX_REV_30,    MATURE_30,  tc)
        f_anaRowAvg(16, "Avg Max Ext 30m $",  SUM_MAX_EXT_30,    MATURE_30,  tc)
        f_anaRowAvg(17, "Avg Max Rev 60m $",  SUM_MAX_REV_60,    MATURE_60,  tc)
        f_anaRowAvg(18, "Avg Max Ext 60m $",  SUM_MAX_EXT_60,    MATURE_60,  tc)
        f_anaRowAvg(19, "Avg Max Rev 120m $", SUM_MAX_REV_120,   MATURE_120, tc)
        f_anaRowAvg(20, "Avg Max Ext 120m $", SUM_MAX_EXT_120,   MATURE_120, tc)
        f_anaRowPct(21, "Rev >= $" + str.tostring(revTh1) + " / 120m %", REV_HIT_5,  MATURE_120, tc)
        f_anaRowPct(22, "Rev >= $" + str.tostring(revTh2) + " / 120m %", REV_HIT_10, MATURE_120, tc)
        f_anaRowPct(23, "Rev >= $" + str.tostring(revTh3) + " / 120m %", REV_HIT_15, MATURE_120, tc)
        f_anaRowPct(24, "Rev >= $" + str.tostring(revTh4) + " / 120m %", REV_HIT_20, MATURE_120, tc)
else if barstate.islast
    table.clear(anaTbl, 0, 0, 4, 31)

// ---- FULL OPTIMIZER Table（既存 metric = 12列 / REV10 before EXT5 = 14列。FULL OPTIMIZER View 選択時のみ）-------------------------
// metric（%）: CS / HIT10 / HIT15 / HIT20 ÷ MAT。MAT 0 は na
// V5 First Hit 率
//   FH %   = REV_FIRST / (REV_FIRST + EXT_FIRST)          （AMBIGUOUS は分母から除外）
//   CONS % = REV_FIRST / (REV_FIRST + EXT_FIRST + AMBIG)  （保守的）
f_optFhPct(int k) =>
    int d = array.get(OPT_FH_REV, k) + array.get(OPT_FH_EXT, k)
    d > 0 ? array.get(OPT_FH_REV, k) * 100.0 / d : na
f_optConsPct(int k) =>
    int d = array.get(OPT_FH_REV, k) + array.get(OPT_FH_EXT, k) + array.get(OPT_FH_AMB, k)
    d > 0 ? array.get(OPT_FH_REV, k) * 100.0 / d : na
f_optRatePct(array<int> arr, int k) =>
    int m = array.get(OPT_MAT, k)
    m > 0 ? array.get(arr, k) * 100.0 / m : na
f_optMetricPct(int k) =>
    float r = na
    if optIsFH
        r := f_optFhPct(k)
    else
        int   m   = array.get(OPT_MAT, k)
        int   num = optMetric == "Close Rev 120m" ? array.get(OPT_CS, k) : optMetric == "Rev >= $10 / 120m" ? array.get(OPT_HIT10, k) : optMetric == "Rev >= $15 / 120m" ? array.get(OPT_HIT15, k) : array.get(OPT_HIT20, k)
        r := m > 0 ? num * 100.0 / m : na
    r
// 件数ゲート / 件数順位に使う N : 既存 metric は matured、REV10 before EXT5 は resolved（REV + EXT）
f_optN(int k) => optIsFH ? array.get(OPT_FH_REV, k) + array.get(OPT_FH_EXT, k) : array.get(OPT_MAT, k)
f_optAvg(array<float> sumArr, int k) =>
    int m = array.get(OPT_MAT, k)
    m > 0 ? array.get(sumArr, k) / m : na
// GROUP A : TRAIN matured >= optMinTrain and TRAIN metric >= target
f_optIsA(int c) =>
    float mt = f_optMetricPct(c * 2)
    f_optN(c * 2) >= optMinTrain and not na(mt) and mt >= optTargetPct
// TEST TARGET : TEST matured >= optMinTest and TEST metric >= target
f_optTestHit(int c) =>
    float mt = f_optMetricPct(c * 2 + 1)
    f_optN(c * 2 + 1) >= optMinTest and not na(mt) and mt >= optTargetPct
// a が b より上位か（TRAIN だけで比較。TEST は使わない）
f_optBetter(int a, int b) =>
    bool r = false
    if b < 0
        r := true
    else
        bool  gA = f_optIsA(a)
        bool  gB = f_optIsA(b)
        int   nA = f_optN(a * 2)
        int   nB = f_optN(b * 2)
        float mA = nz(f_optMetricPct(a * 2), -1.0)
        float mB = nz(f_optMetricPct(b * 2), -1.0)
        float vA = nz(f_optAvg(OPT_SSUM, a * 2), -1e9)
        float vB = nz(f_optAvg(OPT_SSUM, b * 2), -1e9)
        if gA != gB
            r := gA
        else if gA
            // GROUP A : 件数 → metric → Avg Signed
            r := nA > nB or (nA == nB and (mA > mB or (mA == mB and vA > vB)))
        else
            // GROUP A 以外 : metric → 件数 → Avg Signed
            r := mA > mB or (mA == mB and (nA > nB or (nA == nB and vA > vB)))
    r

f_optFmtPct(float v) => na(v) ? "-" : str.tostring(v, "0.0") + "%"
f_optFmtUsd(float v) => na(v) ? "-" : str.tostring(v, "0.00")

var optTbl = table.new(position.bottom_left, 14, 30, border_width = 1)

f_optCell(int col, int row, string txt) =>
    table.cell(optTbl, col, row, txt, text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    col

// config 1行（RANK 列ラベル + 11 指標）
f_optRow(int row, string rankLabel, int c) =>
    int   kTe   = c * 2 + 1
    float teRev = f_optAvg(OPT_REVSUM, kTe)
    float teExt = f_optAvg(OPT_EXTSUM, kTe)
    float teRE  = na
    if not na(teRev) and not na(teExt)
        teRE := teRev - teExt
    f_optCell(0,  row, rankLabel)
    f_optCell(1,  row, str.tostring(array.get(CFG_STR, c),  "0.00"))
    f_optCell(2,  row, str.tostring(array.get(CFG_CPRE, c), "0.00"))
    f_optCell(3,  row, str.tostring(array.get(CFG_CDOM, c), "0.00"))
    f_optCell(4,  row, str.tostring(array.get(CFG_OPP, c)))
    f_optCell(5,  row, str.tostring(array.get(OPT_MAT, c * 2)))
    f_optCell(6,  row, f_optFmtPct(f_optMetricPct(c * 2)))
    f_optCell(7,  row, str.tostring(array.get(OPT_MAT, kTe)))
    f_optCell(8,  row, f_optFmtPct(f_optMetricPct(kTe)))
    f_optCell(9,  row, f_optFmtUsd(f_optAvg(OPT_SSUM, kTe)))
    f_optCell(10, row, f_optFmtUsd(teRE))
    f_optCell(11, row, f_optTestHit(c) ? "YES" : "NO")
    row

// V5 First Hit 用 1行（14列）
f_optRowFH(int row, string rankLabel, int c) =>
    int kTr = c * 2
    int kTe = c * 2 + 1
    f_optCell(0,  row, rankLabel)
    f_optCell(1,  row, str.tostring(array.get(CFG_STR, c),  "0.00"))
    f_optCell(2,  row, str.tostring(array.get(CFG_CPRE, c), "0.00"))
    f_optCell(3,  row, str.tostring(array.get(CFG_CDOM, c), "0.00"))
    f_optCell(4,  row, str.tostring(array.get(CFG_OPP, c)))
    f_optCell(5,  row, str.tostring(f_optN(kTr)))          // FH % の N = resolved（REV_FIRST + EXT_FIRST）
    f_optCell(6,  row, f_optFmtPct(f_optFhPct(kTr)))
    f_optCell(7,  row, f_optFmtPct(f_optConsPct(kTr)))
    f_optCell(8,  row, str.tostring(f_optN(kTe)))          // FH % の N = resolved（REV_FIRST + EXT_FIRST）
    f_optCell(9,  row, f_optFmtPct(f_optFhPct(kTe)))
    f_optCell(10, row, f_optFmtPct(f_optConsPct(kTe)))
    f_optCell(11, row, f_optFmtPct(f_optRatePct(OPT_FH_AMB, kTe)))
    f_optCell(12, row, f_optFmtPct(f_optRatePct(OPT_FH_UNR, kTe)))
    f_optCell(13, row, f_optTestHit(c) ? "YES" : "NO")
    row

// V5 Current Production の First Hit 内訳（split = 0 TRAIN / 1 TEST）
f_optFhDetail(int row, string label, int k) =>
    f_optCell(0, row, label)
    f_optCell(1, row, str.tostring(f_optN(k)))             // N = resolved（REV_FIRST + EXT_FIRST）
    f_optCell(2, row, f_optFmtPct(f_optFhPct(k)))
    f_optCell(3, row, f_optFmtPct(f_optConsPct(k)))
    f_optCell(4, row, str.tostring(array.get(OPT_FH_REV, k)))
    f_optCell(5, row, str.tostring(array.get(OPT_FH_EXT, k)))
    f_optCell(6, row, str.tostring(array.get(OPT_FH_AMB, k)))
    f_optCell(7, row, str.tostring(array.get(OPT_FH_UNR, k)))
    f_optCell(8, row, str.tostring(array.get(OPT_MAT, k)))      // MAT N = 120m 成熟 event 数（参考）
    row

f_optInfo(int row, string label, string val) =>
    f_optCell(0, row, label)
    f_optCell(1, row, val)
    row

if barstate.islast
    table.clear(optTbl, 0, 0, 13, 29)
    if tpAnaShowTable and isChart5M and anaView == "FULL OPTIMIZER"
        f_optInfo(0, "OPT SOURCE",   optValid ? "CONNECTED" : "INVALID")
        f_optInfo(1, "MODE",         "CONFIRMED 5M")
        f_optInfo(2, "SIDE",         optSide)
        f_optInfo(3, "GRID",         str.tostring(OPT_N))
        f_optInfo(4, "TRAIN / TEST", str.tostring(optTrainPct) + " / " + str.tostring(100 - optTrainPct))
        f_optInfo(5, "METRIC",       optIsFH ? optMetric + " (REV $" + str.tostring(optFirstHitRev) + " / EXT $" + str.tostring(optFirstHitExt) + ")" : optMetric)
        f_optInfo(6, "TARGET",       str.tostring(optTargetPct, "0.0") + "%")
        f_optInfo(7, "MIN TRAIN",    str.tostring(optMinTrain))
        f_optInfo(8, "MIN TEST",     str.tostring(optMinTest))
        // ---- header ----
        array<string> hdr = optIsFH ? array.from("RANK", "STR", "CPRE", "CDOM", "OPP", "TR N", "TR FH %", "TR CONS %", "TE N", "TE FH %", "TE CONS %", "TE AMB %", "TE UNRES %", "TARGET") : array.from("RANK", "STR", "CPRE", "CDOM", "OPP", "TR N", "TR %", "TE N", "TE %", "TE AVG$", "TE R-E$", "TARGET")
        for h = 0 to array.size(hdr) - 1
            f_optCell(h, 9, array.get(hdr, h))
        // ---- TRAIN だけで Top10 を選ぶ（選択ソート）----
        array<bool> used = array.new_bool(OPT_N, false)
        array<int>  top  = array.new_int()
        for r = 0 to 9
            int best = -1
            for c = 0 to OPT_N - 1
                if not array.get(used, c) and f_optBetter(c, best)
                    best := c
            if best >= 0
                array.set(used, best, true)
                array.push(top, best)
        int trainTargetCnt = 0
        for c = 0 to OPT_N - 1
            if f_optIsA(c)
                trainTargetCnt += 1
        int testTargetTop = 0
        for r = 0 to array.size(top) - 1
            int c = array.get(top, r)
            if optIsFH
                f_optRowFH(10 + r, str.tostring(r + 1), c)
            else
                f_optRow(10 + r, str.tostring(r + 1), c)
            if f_optTestHit(c)
                testTargetTop += 1
        // ---- summary ----
        f_optInfo(21, "TRAIN Target configs",    str.tostring(trainTargetCnt))
        f_optInfo(22, "TEST Target among Top10", str.tostring(testTargetTop))
        string bestCov = "-"
        if trainTargetCnt > 0 and array.size(top) > 0
            int b0 = array.get(top, 0)
            bestCov := "STR " + str.tostring(array.get(CFG_STR, b0), "0.00") + " / CPRE " + str.tostring(array.get(CFG_CPRE, b0), "0.00") + " / CDOM " + str.tostring(array.get(CFG_CDOM, b0), "0.00") + " / OPP " + str.tostring(array.get(CFG_OPP, b0))
        f_optInfo(23, "BEST TRAIN COVERAGE", bestCov)
        // ---- Production 既定値 config（比較用）----
        for h = 0 to array.size(hdr) - 1
            f_optCell(h, 25, array.get(hdr, h))
        if optIsFH
            f_optRowFH(26, "CURRENT", OPT_PROD_CFG)
            // Current Production の First Hit 内訳（TRAIN / TEST）
            array<string> fhHdr = array.from("CURRENT FH", "N (RESOLVED)", "FH %", "CONS %", "REV_FIRST", "EXT_FIRST", "AMBIG", "UNRESOLVED", "MAT N")
            for h = 0 to 8
                f_optCell(h, 27, array.get(fhHdr, h))
            f_optFhDetail(28, "TRAIN", OPT_PROD_CFG * 2)
            f_optFhDetail(29, "TEST",  OPT_PROD_CFG * 2 + 1)
        else
            f_optRow(26, "CURRENT", OPT_PROD_CFG)

// ---- FEATURE TOURNAMENT Table（FEATURE TOURNAMENT View 選択時のみ）-------------------------
f_ftRes(int k)  => array.get(FT_REV, k) + array.get(FT_EXT, k)
f_ftFh(int k)   => f_ftRes(k) > 0 ? array.get(FT_REV, k) * 100.0 / f_ftRes(k) : na
f_ftCons(int k) =>
    int d = f_ftRes(k) + array.get(FT_AMB, k)
    d > 0 ? array.get(FT_REV, k) * 100.0 / d : na
f_ftRate(array<int> arr, int k) => array.get(FT_MAT, k) > 0 ? array.get(arr, k) * 100.0 / array.get(FT_MAT, k) : na
f_ftIsA(int c) =>
    float fh = f_ftFh(c * 2)
    f_ftRes(c * 2) >= optMinTrain and not na(fh) and fh >= optTargetPct
f_ftTestHit(int c) =>
    float fh = f_ftFh(c * 2 + 1)
    f_ftRes(c * 2 + 1) >= optMinTest and not na(fh) and fh >= optTargetPct
// a が b より上位か（TRAIN だけ。GROUP A : resolved → FH → CONS / その他 : FH → resolved → CONS）
f_ftBetter(int a, int b) =>
    bool r = false
    if b < 0
        r := true
    else
        bool  gA = f_ftIsA(a)
        bool  gB = f_ftIsA(b)
        int   nA = f_ftRes(a * 2)
        int   nB = f_ftRes(b * 2)
        float mA = nz(f_ftFh(a * 2), -1.0)
        float mB = nz(f_ftFh(b * 2), -1.0)
        float cA = nz(f_ftCons(a * 2), -1.0)
        float cB = nz(f_ftCons(b * 2), -1.0)
        if gA != gB
            r := gA
        else if gA
            r := nA > nB or (nA == nB and (mA > mB or (mA == mB and cA > cB)))
        else
            r := mA > mB or (mA == mB and (nA > nB or (nA == nB and cA > cB)))
    r
f_ftRouteLabel(int c) => c % 3 == 0 ? "ANY" : c % 3 == 1 ? "A" : "B"
f_ftRecId(int r) => "R" + (r < 10 ? "0" : "") + str.tostring(r)

var ftTbl = table.new(position.bottom_left, 12, 52, border_width = 1)

f_ftCell(int col, int row, string txt) =>
    table.cell(ftTbl, col, row, txt, text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    col

f_ftRow(int row, string rankLabel, int c) =>
    int kTr = c * 2
    int kTe = c * 2 + 1
    f_ftCell(0,  row, rankLabel)
    f_ftCell(1,  row, f_ftRouteLabel(c))
    f_ftCell(2,  row, f_ftRecId(int(c / 3)))
    f_ftCell(3,  row, str.tostring(f_ftRes(kTr)))
    f_ftCell(4,  row, f_optFmtPct(f_ftFh(kTr)))
    f_ftCell(5,  row, f_optFmtPct(f_ftCons(kTr)))
    f_ftCell(6,  row, str.tostring(f_ftRes(kTe)))
    f_ftCell(7,  row, f_optFmtPct(f_ftFh(kTe)))
    f_ftCell(8,  row, f_optFmtPct(f_ftCons(kTe)))
    f_ftCell(9,  row, f_optFmtPct(f_ftRate(FT_AMB, kTe)))
    f_ftCell(10, row, f_optFmtPct(f_ftRate(FT_UNR, kTe)))
    f_ftCell(11, row, f_ftTestHit(c) ? "YES" : "NO")
    row

f_ftInfo(int row, string label, string val) =>
    f_ftCell(0, row, label)
    f_ftCell(1, row, val)
    row

// 指定 config 群から TRAIN 基準で最良を返す（-1 = なし）
f_ftBestOf(array<int> cand) =>
    int best = -1
    for i = 0 to array.size(cand) - 1
        int c = array.get(cand, i)
        if f_ftBetter(c, best)
            best := c
    best
f_ftBestText(int c) =>
    c < 0 ? "-" : f_ftRecId(int(c / 3)) + " " + f_ftRouteLabel(c) + " = " + array.get(FT_RECIPE_LABEL, int(c / 3)) + " | TR N " + str.tostring(f_ftRes(c * 2)) + " | TR FH " + f_optFmtPct(f_ftFh(c * 2))

if barstate.islast
    table.clear(ftTbl, 0, 0, 11, 51)
    if tpAnaShowTable and isChart5M and anaView == "FEATURE TOURNAMENT"
        f_ftInfo(0, "FT SOURCE",    ftValid ? "CONNECTED" : "INVALID")
        f_ftInfo(1, "MODE",         "CONFIRMED 5M")
        f_ftInfo(2, "SIDE",         optSide)
        f_ftInfo(3, "CONFIGS",      str.tostring(FT_N))
        f_ftInfo(4, "TRAIN / TEST", str.tostring(optTrainPct) + " / " + str.tostring(100 - optTrainPct))
        f_ftInfo(5, "FIRST HIT",    "REV $" + str.tostring(optFirstHitRev) + " / EXT $" + str.tostring(optFirstHitExt))
        f_ftInfo(6, "TARGET",       str.tostring(optTargetPct, "0.0") + "%")
        f_ftInfo(7, "MIN TRAIN",    str.tostring(optMinTrain))
        f_ftInfo(8, "MIN TEST",     str.tostring(optMinTest))
        array<string> hdr = array.from("RANK", "ROUTE", "RECIPE", "TR N", "TR FH %", "TR CONS %", "TE N", "TE FH %", "TE CONS %", "TE AMB %", "TE UNRES %", "TARGET")
        for h = 0 to 11
            f_ftCell(h, 9, array.get(hdr, h))
        // ---- Top10（TRAIN だけで選択ソート）----
        array<bool> used = array.new_bool(FT_N, false)
        array<int>  top  = array.new_int()
        for r = 0 to 9
            int best = -1
            for c = 0 to FT_N - 1
                if not array.get(used, c) and f_ftBetter(c, best)
                    best := c
            if best >= 0
                array.set(used, best, true)
                array.push(top, best)
        int testTargetTop = 0
        array<int> legendRec = array.new_int()
        for r = 0 to array.size(top) - 1
            int c = array.get(top, r)
            f_ftRow(10 + r, str.tostring(r + 1), c)
            if f_ftTestHit(c)
                testTargetTop += 1
            if not array.includes(legendRec, int(c / 3))
                array.push(legendRec, int(c / 3))
        // ---- CONTROL（R00 NONE / ANY = Production 相当の base FULL）----
        f_ftRow(20, "CONTROL", 0)
        // ---- Legend（Top10 に出た Recipe のみ・重複なし）----
        f_ftCell(0, 21, "LEGEND")
        for i = 0 to array.size(legendRec) - 1
            int rr = array.get(legendRec, i)
            f_ftCell(0, 22 + i, f_ftRecId(rr) + " = " + array.get(FT_RECIPE_LABEL, rr))
        // ---- Single Feature（R01〜R13 / Route ANY）----
        array<string> sh = array.from("FEATURE", "TR N", "TR FH", "TE N", "TE FH", "TE CONS")
        for h = 0 to 5
            f_ftCell(h, 32, array.get(sh, h))
        for r = 1 to 13
            int c = r * 3
            f_ftCell(0, 32 + r, f_ftRecId(r) + " " + array.get(FT_RECIPE_LABEL, r))
            f_ftCell(1, 32 + r, str.tostring(f_ftRes(c * 2)))
            f_ftCell(2, 32 + r, f_optFmtPct(f_ftFh(c * 2)))
            f_ftCell(3, 32 + r, str.tostring(f_ftRes(c * 2 + 1)))
            f_ftCell(4, 32 + r, f_optFmtPct(f_ftFh(c * 2 + 1)))
            f_ftCell(5, 32 + r, f_optFmtPct(f_ftCons(c * 2 + 1)))
        // ---- Summary（BEST は TRAIN ranking 基準）----
        int trainTargetCnt = 0
        array<int> candSingle = array.new_int()
        array<int> candCombo  = array.new_int()
        array<int> candA      = array.new_int()
        array<int> candB      = array.new_int()
        for c = 0 to FT_N - 1
            if f_ftIsA(c)
                trainTargetCnt += 1
            int rr = int(c / 3)
            if c % 3 == 0 and rr >= 1 and rr <= 13
                array.push(candSingle, c)
            if rr >= 14
                array.push(candCombo, c)
            if c % 3 == 1
                array.push(candA, c)
            if c % 3 == 2
                array.push(candB, c)
        f_ftInfo(46, "TRAIN Target Configs",    str.tostring(trainTargetCnt))
        f_ftInfo(47, "TEST Target among Top10", str.tostring(testTargetTop))
        f_ftInfo(48, "BEST SINGLE FEATURE",     f_ftBestText(f_ftBestOf(candSingle)))
        f_ftInfo(49, "BEST COMBO",              f_ftBestText(f_ftBestOf(candCombo)))
        f_ftInfo(50, "BEST ROUTE A",            f_ftBestText(f_ftBestOf(candA)))
        f_ftInfo(51, "BEST ROUTE B",            f_ftBestText(f_ftBestOf(candB)))

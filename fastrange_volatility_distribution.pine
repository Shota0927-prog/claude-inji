// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © ka.mickey15
//
// ============================================================
//  fastRange ボラ分布 集計インジケーター (XAUUSD 5分足)
// ------------------------------------------------------------
//  目的 :
//    既存「5min Engulfing Strategy」の高速ボラ固定値モードが使う
//    ボラ値 fastRange を過去1年間集計し、ボラランクの境界値を決める
//    ための分布・統計を可視化する集計専用ツール。
//
//  ★ ストラテジー本体は一切変更しない。これは別の集計専用インジケーター。
//
//  集計するボラ値 (既存の高速ボラ固定値モードと完全に同じ計算) :
//     fastRange   = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
//     bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
//     fastRangeOk = fastRange >= fastFixedMin
//     bodyAvgOk   = bodyAvgFast >= bodyAvgMin
//     fastVolPass = fastRangeOk and bodyAvgOk
//   ※ ATR化・価格比率正規化・日足ATR・可変しきい値は実装しない。
//     固定ドル値 (fastRange) の分布だけを見る。
//
//  ※ 5分足チャートに適用してください (overlay = false)。
// ============================================================

//@version=5
indicator(
     title      = "fastRange ボラ分布 (XAUUSD 5m)",
     shorttitle = "fastRange Dist",
     overlay    = false,
     max_bars_back = 500,
     max_boxes_count = 1,
     max_labels_count = 1
 )

// ============================================================
//  1. 入力 : fastRange 計算 (既存ストラテジーと同一)
// ============================================================
grpCalc = "fastRange 計算 (既存ロジックと同一)"
fastAtrLen = input.int(5, "fastRange 参照本数 (直近N本の高安幅)", minval = 1, group = grpCalc)

// 既存高速ボラ固定値モードの判定パラメータ (現在値表示・平均実体条件用)
grpExisting = "既存 高速ボラ 固定値モード パラメータ"
fastFixedMin = input.float(3.0, "fastFixedMin (直近値幅 最低$)", minval = 0.0, step = 0.1, group = grpExisting)
bodyAvgLen   = input.int(5,     "bodyAvgLen (実体平均本数)",      minval = 1,   group = grpExisting)
bodyAvgMin   = input.float(0.5, "bodyAvgMin (実体平均最低$)",     minval = 0.0, step = 0.1, group = grpExisting)

// ============================================================
//  2. 入力 : 集計期間
// ------------------------------------------------------------
//  直近日数 / 日付指定 の2モード。指定期間外のバーは集計しない。
// ============================================================
grpPeriod = "集計期間"
periodMode   = input.string("直近日数", "期間モード", options = ["直近日数", "日付指定"], group = grpPeriod)
lookbackDays = input.int(365, "直近日数 (直近N日)", minval = 1, group = grpPeriod)
startDate    = input.time(timestamp("2024-01-01 00:00 +0000"), "開始日 (日付指定時)", group = grpPeriod)
endDate      = input.time(timestamp("2025-01-01 00:00 +0000"), "終了日 (日付指定時)", group = grpPeriod)
confirmedOnly = input.bool(true, "確定足のみ集計 (リペイント/重複防止)", group = grpPeriod)

// ============================================================
//  3. 入力 : 集計単位 (ビン)
// ------------------------------------------------------------
//  0.5ドル刻み / 1.0ドル刻み。最大集計値以上は「最大値以上」にまとめる。
// ============================================================
grpBin = "集計単位 (ヒストグラム)"
binWidthStr  = input.string("0.5ドル", "ビン幅", options = ["0.5ドル", "1.0ドル"], group = grpBin)
maxHistValue = input.float(20.0, "最大集計値 ($ / これ以上は最終ビンにまとめる)", minval = 1.0, step = 0.5, group = grpBin)
float binWidth = binWidthStr == "0.5ドル" ? 0.5 : 1.0

// ============================================================
//  4. 入力 : 集計対象 (分布モード)
// ------------------------------------------------------------
//  A: 全バーの fastRange 分布 (純粋なボラ値分布)
//  B: 平均実体条件 (bodyAvgOk) を満たしたバーだけの fastRange 分布
//  ※ メインの分布は fastRange 単体。平均実体で絞るのはBを選んだ時だけ。
// ============================================================
grpDist = "分布モード"
distributionMode = input.string("全バー", "集計対象", options = ["全バー", "平均実体条件通過のみ"], group = grpDist)

// ============================================================
//  4b. 入力 : 集計時間帯フィルター (東京時間 JST)
// ------------------------------------------------------------
//  全時間 … 時間帯フィルターなし。
//  既存ストラテジー稼働時間のみ … 既存ストラテジーの時間帯フィルタと同じ。
//    Asia/Tokyo 基準 : 09:00-16:00 / 16:00-21:00 / 21:00-翌03:00。
//    03:00-09:00 は除外。
// ============================================================
grpSess = "集計時間帯フィルター (東京時間)"
sessionAggMode = input.string("既存ストラテジー稼働時間のみ", "集計対象時間帯", options = ["全時間", "既存ストラテジー稼働時間のみ"], group = grpSess)

// ============================================================
//  5. 入力 : 候補ランク境界 (仮集計 / 確定はしない)
// ------------------------------------------------------------
//  境界1 < 境界2 < 境界3 でなければならない。不正なら警告表示。
// ============================================================
grpRank = "候補ランク境界 (仮)"
bound1 = input.float(3.0, "境界1 ($)", minval = 0.0, step = 0.1, group = grpRank)
bound2 = input.float(5.0, "境界2 ($)", minval = 0.0, step = 0.1, group = grpRank)
bound3 = input.float(7.0, "境界3 ($)", minval = 0.0, step = 0.1, group = grpRank)

// ============================================================
//  6. 入力 : パーセンタイル用サンプル上限 (循環バッファ / 負荷対策)
// ------------------------------------------------------------
//  ★ 制限と対応内容 (仕様変更ではなく負荷対策) :
//    直近365日を5分足で集計するとバー数が非常に多くなる
//    (XAUUSD で概算 7万本超)。ヒストグラム/件数/割合/ランク集計は
//    「全期間」を対象にするが、中央値・各パーセンタイルは配列を
//    昇順ソートして求めるため、循環バッファ (固定長 maxSamples) で保持する。
//    ・maxSamples 到達までは順に array.set で埋める。
//    ・到達後は array.shift を使わず、最古の書込位置を array.set で上書き
//      する循環バッファ方式 (大容量 shift の高負荷を回避)。
//    ・集計期間内バー数 <= maxSamples … パーセンタイルも全期間 = 正確。
//    ・集計期間内バー数 >  maxSamples … 直近 maxSamples 本を保持し、
//      パーセンタイルは「直近 maxSamples 本」に基づく近似となる
//      (ヒストグラム/件数は全期間)。テーブルに実サンプル数を表示。
//    ・平均/最小/最大は配列に依存せず全期間で正確 (逐次集計)。
//    ・パーセンタイル計算時は循環バッファの有効データを別配列へ
//      コピーしてからソートする (バッファ自体は破壊しない)。
//    初期値 100000 でXAUUSD 1年の5分足を原則保持できる
//    (Pine配列上限は10万・ソート負荷とのトレードオフ)。
// ============================================================
grpPerf = "パーセンタイル サンプル上限"
maxSamples = input.int(100000, "パーセンタイル最大サンプル数 (循環バッファ長)", minval = 100, maxval = 100000, group = grpPerf)

// ============================================================
//  7. 入力 : チャート表示
// ============================================================
grpShow = "チャート表示"
showPlot   = input.bool(true,  "fastRange をサブウィンドウにプロット", group = grpShow)
showHlines = input.bool(true,  "境界1〜3 の水平線を表示",             group = grpShow)
showBg     = input.bool(false, "現在のランクで背景色を変更",           group = grpShow)
showTables = input.bool(true,  "集計テーブルを表示",                   group = grpShow)

// ============================================================
//  8. fastRange / 平均実体 計算 (既存ロジックと完全同一)
// ============================================================
float fastRange   = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)

// 既存 高速ボラ固定値モードの各判定
bool fastRangeOk = fastRange >= fastFixedMin
bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
bool fastVolPass = fastRangeOk and bodyAvgOk

// ウォームアップ完了 (fastRange / bodyAvgFast が有効になったか)
bool valuesReady = not na(fastRange) and not na(bodyAvgFast)

// ============================================================
//  9. 期間判定 (指定期間外は集計しない)
// ------------------------------------------------------------
//  直近日数 … time >= (timenow - lookbackDays 日)。未来参照なし。
//  日付指定 … startDate <= time <= endDate。
// ============================================================
int msPerDay = 86400000
int requestedStart = periodMode == "直近日数" ? timenow - lookbackDays * msPerDay : startDate
bool inPeriod =
     periodMode == "直近日数" ? (time >= requestedStart) :
     (time >= startDate and time <= endDate)

// --- 集計時間帯フィルター (東京時間 JST) ---
//   既存ストラテジーと同じ : 09:00-16:00 / 16:00-21:00 / 21:00-翌03:00。
//   03:00-09:00 は除外 (= jstHour>=9 or jstHour<3)。
int  jstHour  = hour(time, "Asia/Tokyo")
bool inAsia   = jstHour >= 9  and jstHour < 16
bool inEU     = jstHour >= 16 and jstHour < 21
bool inNY     = jstHour >= 21 or  jstHour < 3
bool inStrategyHours = inAsia or inEU or inNY
bool sessionAggOk = sessionAggMode == "全時間" ? true : inStrategyHours

// 分布モードによる対象バー絞り込み (Bのみ平均実体条件を要求)
bool includeBar = distributionMode == "全バー" ? true : bodyAvgOk

// ============================================================
//  10. 境界の妥当性チェック (境界1 < 境界2 < 境界3)
// ============================================================
bool boundsValid = bound1 < bound2 and bound2 < bound3

// ============================================================
//  11. ヒストグラム / 統計 集計用の永続配列・変数
// ------------------------------------------------------------
//  ・ビン数 = 最大集計値 / ビン幅 (+ オーバーフロー1ビン)。
//  ・毎バー全体ソートはしない。集計は逐次、ソートは barstate.islast のみ。
//  ・var で保持し、確定足単位で1回だけ加算 → 重複加算しない。
// ============================================================
int nMainBins  = math.max(1, int(math.round(maxHistValue / binWidth)))  // 通常ビン数
int nBinsTotal = nMainBins + 1                                          // + 「最大値以上」

var array<int>   histCounts = array.new_int(nBinsTotal, 0)  // 各ビンの件数 (全期間)

// パーセンタイル用 循環バッファ (固定長 = maxSamples。array.shift を使わない)
//   pWrite  … 次に書き込む位置 (到達後は 0 に戻り最古を上書き)
//   pFilled … 有効データ数 (maxSamples で頭打ち)
var array<float> pBuf   = array.new_float(maxSamples, na)
var int          pWrite = 0
var int          pFilled = 0

// 全期間の逐次統計 (配列に依存しない・正確)
var int   totalCount = 0
var float sumVal     = 0.0
var float minVal     = na
var float maxVal     = na

// 候補ランク別件数 (全期間)
var int rank1Count = 0
var int rank2Count = 0
var int rank3Count = 0
var int rank4Count = 0

// 同一バー重複加算防止 (確定足ON以外でも1バー1回)
var int lastAddedBar = na

// 実際に読み込めたバーの範囲 (履歴カバレッジ確認用)
var int firstLoadedTime = na   // チャートに読み込めた最古バーの時刻
if na(firstLoadedTime)
    firstLoadedTime := time

// --- ビンインデックス算出 (maxHistValue 以上は最終ビン) ---
f_binIndex(float v) =>
    int idx = v >= maxHistValue ? nMainBins : int(math.floor(v / binWidth))
    math.max(0, math.min(nBinsTotal - 1, idx))

// ============================================================
//  12. 集計本体 (期間内・対象バーを 1本1回だけ加算)
// ------------------------------------------------------------
//  confirmedOnly = true  … 確定足 (barstate.isconfirmed) のみ加算。
//  confirmedOnly = false … 確定足に加え、リアルタイム最終足も1回だけ
//                          加算 (bar_index で重複防止)。
//  どちらも同一バーを2回加算しない → 二重加算・リペイントを防止。
// ============================================================
bool baseOk = inPeriod and sessionAggOk and includeBar and valuesReady
bool doAdd  = false
if baseOk
    if confirmedOnly
        doAdd := barstate.isconfirmed
    else
        doAdd := (barstate.isconfirmed or barstate.islast) and (na(lastAddedBar) or bar_index != lastAddedBar)

if doAdd
    lastAddedBar := bar_index
    // ヒストグラム (全期間)
    int bi = f_binIndex(fastRange)
    array.set(histCounts, bi, array.get(histCounts, bi) + 1)
    // 逐次統計 (全期間・正確)
    totalCount += 1
    sumVal += fastRange
    minVal := na(minVal) ? fastRange : math.min(minVal, fastRange)
    maxVal := na(maxVal) ? fastRange : math.max(maxVal, fastRange)
    // 候補ランク別件数 (全期間)
    if fastRange < bound1
        rank1Count += 1
    else if fastRange < bound2
        rank2Count += 1
    else if fastRange < bound3
        rank3Count += 1
    else
        rank4Count += 1
    // パーセンタイル用 循環バッファへ書き込み (array.shift 不使用)
    //   pWrite の位置に上書き → 次位置へ。maxSamples 到達で 0 に戻り最古を上書き。
    array.set(pBuf, pWrite, fastRange)
    pWrite := pWrite + 1
    if pWrite >= maxSamples
        pWrite := 0
    pFilled := math.min(pFilled + 1, maxSamples)

// ============================================================
//  13. パーセンタイル計算 (barstate.islast で 1回だけソート)
// ------------------------------------------------------------
//  期間内 fastRange を昇順ソートし、位置から百分位を取得。
//  ソート順で母集団を破壊しないよう copy してからソートする。
// ============================================================
f_percentile(array<float> sortedArr, float p) =>
    int n = array.size(sortedArr)
    float res = na
    if n > 0
        int idx = int(math.round(p / 100.0 * (n - 1)))
        idx := math.max(0, math.min(n - 1, idx))
        res := array.get(sortedArr, idx)
    res

// ============================================================
//  14. 現在のランク (背景色 / 現在値表示用)
// ============================================================
int curRank = na(fastRange) ? na : fastRange < bound1 ? 1 : fastRange < bound2 ? 2 : fastRange < bound3 ? 3 : 4

// ============================================================
//  15. チャート描画 (プロット / 水平線 / 背景色)
// ------------------------------------------------------------
//  plot / hline はグローバルで宣言し、ON/OFF は na で切り替える。
// ============================================================
plot(showPlot ? fastRange : na, "fastRange", color = color.new(color.blue, 0), linewidth = 1)

plot(showHlines ? bound1 : na, "境界1", color = color.new(color.green,  0), linewidth = 1, style = plot.style_line)
plot(showHlines ? bound2 : na, "境界2", color = color.new(color.orange, 0), linewidth = 1, style = plot.style_line)
plot(showHlines ? bound3 : na, "境界3", color = color.new(color.red,    0), linewidth = 1, style = plot.style_line)

color bgRankCol =
     not showBg or na(curRank) ? na :
     curRank == 1 ? color.new(color.gray,   85) :
     curRank == 2 ? color.new(color.teal,   85) :
     curRank == 3 ? color.new(color.orange, 85) :
                    color.new(color.red,    85)
bgcolor(bgRankCol, title = "ランク背景色")

// ============================================================
//  16. テーブル描画 (集計・ソートは barstate.islast のみ)
// ============================================================
// 数値整形ヘルパー
f_fmt1(float v) => na(v) ? "-" : str.tostring(v, "#.0")
f_fmt2(float v) => na(v) ? "-" : str.tostring(v, "#.00")
f_pct(float part, float whole) => whole > 0 ? str.tostring(part / whole * 100.0, "#.00") + "%" : "-"

var table tblDist  = table.new(position.top_right,    4, nBinsTotal + 2, border_width = 1, frame_width = 1)
var table tblStats = table.new(position.middle_right, 2, 10,             border_width = 1, frame_width = 1)
var table tblCur   = table.new(position.bottom_right, 2, 7,              border_width = 1, frame_width = 1)
var table tblRank  = table.new(position.top_left,     3, 7,             border_width = 1, frame_width = 1)
var table tblCov   = table.new(position.bottom_left,  2, 6,             border_width = 1, frame_width = 1)

if showTables and barstate.islast
    color hdrBg  = color.new(color.blue, 0)
    color cellBg = color.new(color.gray, 30)
    color txtCol = color.white

    // ---------- ① 分布テーブル (ボラ帯 / 件数 / 割合 / 累積割合) ----------
    table.cell(tblDist, 0, 0, "ボラ帯 ($)",  text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 1, 0, "バー数",       text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 2, 0, "割合",         text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 3, 0, "累積",         text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)

    int cum = 0
    for i = 0 to nBinsTotal - 1
        int c = array.get(histCounts, i)
        cum += c
        string band = i == nMainBins ? (f_fmt1(maxHistValue) + "以上") : (f_fmt1(i * binWidth) + "〜" + f_fmt1((i + 1) * binWidth))
        table.cell(tblDist, 0, i + 1, band,                    text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
        table.cell(tblDist, 1, i + 1, str.tostring(c),         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
        table.cell(tblDist, 2, i + 1, f_pct(c, totalCount),    text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
        table.cell(tblDist, 3, i + 1, f_pct(cum, totalCount),  text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)

    table.cell(tblDist, 0, nBinsTotal + 1, "合計",                  text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 1, nBinsTotal + 1, str.tostring(totalCount), text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 2, nBinsTotal + 1, "",                      text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblDist, 3, nBinsTotal + 1, "",                      text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)

    // ---------- ② 統計テーブル (平均 / 中央値 / パーセンタイル) ----------
    // 循環バッファの有効データ (先頭 pFilled 本) を別配列へコピー → 昇順ソート
    //   (islast で1回だけ。バッファ本体は破壊しない)。有効域は常に 0..pFilled-1。
    array<float> sortedArr = array.new_float()
    if pFilled > 0
        for i = 0 to pFilled - 1
            array.push(sortedArr, array.get(pBuf, i))
        array.sort(sortedArr, order.ascending)
    int    nSamp   = array.size(sortedArr)
    float  meanVal = totalCount > 0 ? sumVal / totalCount : na
    float  medVal  = f_percentile(sortedArr, 50)
    float  p25     = f_percentile(sortedArr, 25)
    float  p50     = f_percentile(sortedArr, 50)
    float  p75     = f_percentile(sortedArr, 75)
    float  p90     = f_percentile(sortedArr, 90)

    table.cell(tblStats, 0, 0, "統計 (fastRange)", text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblStats, 1, 0, distributionMode,   text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblStats, 0, 1, "集計バー数",        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 1, str.tostring(totalCount), text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 2, "平均値",            text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 2, f_fmt2(meanVal),     text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 3, "中央値",            text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 3, f_fmt2(medVal),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 4, "最小値",            text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 4, f_fmt2(minVal),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 5, "最大値",            text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 5, f_fmt2(maxVal),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 6, "25%tile",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 6, f_fmt2(p25),         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 7, "50%tile",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 7, f_fmt2(p50),         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 8, "75%tile",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 8, f_fmt2(p75),         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 0, 9, "90%tile",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblStats, 1, 9, f_fmt2(p90),         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)

    // %tile のサンプル母数が全期間と異なる場合の注記 (上限到達時)
    if nSamp < totalCount
        table.cell(tblStats, 0, 0, "統計 (%tile=直近" + str.tostring(nSamp) + "本)", text_color = color.yellow, bgcolor = hdrBg, text_size = size.tiny)

    // ---------- ③ 現在値テーブル (既存高速ボラ判定) ----------
    table.cell(tblCur, 0, 0, "現在値 (既存高速ボラ)", text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblCur, 1, 0, "",                       text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblCur, 0, 1, "現在 fastRange",         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 1, f_fmt2(fastRange),        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 0, 2, "現在 直近" + str.tostring(bodyAvgLen) + "本平均実体", text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 2, f_fmt2(bodyAvgFast),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 0, 3, "fastRange判定 (>=" + f_fmt1(fastFixedMin) + ")", text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 3, fastRangeOk ? "OK" : "NG", text_color = txtCol, bgcolor = fastRangeOk ? color.new(color.green, 0) : color.new(color.red, 0), text_size = size.tiny)
    table.cell(tblCur, 0, 4, "平均実体判定 (>=" + f_fmt1(bodyAvgMin) + ")", text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 4, bodyAvgOk ? "OK" : "NG", text_color = txtCol, bgcolor = bodyAvgOk ? color.new(color.green, 0) : color.new(color.red, 0), text_size = size.tiny)
    table.cell(tblCur, 0, 5, "高速ボラ最終判定",       text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 5, fastVolPass ? "PASS" : "BLOCK", text_color = txtCol, bgcolor = fastVolPass ? color.new(color.green, 0) : color.new(color.red, 0), text_size = size.tiny)
    table.cell(tblCur, 0, 6, "現在ランク",             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCur, 1, 6, na(curRank) ? "-" : ("R" + str.tostring(curRank)), text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)

    // ---------- ④ 候補ランク別テーブル (件数 / 割合) ----------
    table.cell(tblRank, 0, 0, "候補ランク",  text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblRank, 1, 0, "バー数",       text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblRank, 2, 0, "割合",         text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)

    table.cell(tblRank, 0, 1, "R1: <" + f_fmt1(bound1),                             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 1, 1, str.tostring(rank1Count),                             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 2, 1, f_pct(rank1Count, totalCount),                        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 0, 2, "R2: " + f_fmt1(bound1) + "〜" + f_fmt1(bound2),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 1, 2, str.tostring(rank2Count),                             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 2, 2, f_pct(rank2Count, totalCount),                        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 0, 3, "R3: " + f_fmt1(bound2) + "〜" + f_fmt1(bound3),      text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 1, 3, str.tostring(rank3Count),                             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 2, 3, f_pct(rank3Count, totalCount),                        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 0, 4, "R4: >=" + f_fmt1(bound3),                            text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 1, 4, str.tostring(rank4Count),                             text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 2, 4, f_pct(rank4Count, totalCount),                        text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)

    // 境界の妥当性 (境界1 < 境界2 < 境界3)
    table.cell(tblRank, 0, 5, "境界チェック", text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblRank, 1, 5, boundsValid ? "OK" : "不正",
                 text_color = txtCol,
                 bgcolor = boundsValid ? color.new(color.green, 0) : color.new(color.red, 0),
                 text_size = size.tiny)
    table.cell(tblRank, 2, 5, boundsValid ? "b1<b2<b3" : "境界1<境界2<境界3 にしてください",
                 text_color = txtCol,
                 bgcolor = boundsValid ? cellBg : color.new(color.red, 0),
                 text_size = size.tiny)

    // 集計対象 (期間 / モード) の注記
    string periodTxt = periodMode == "直近日数" ? ("直近" + str.tostring(lookbackDays) + "日") : "日付指定"
    table.cell(tblRank, 0, 6, "集計対象", text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblRank, 1, 6, periodTxt,  text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblRank, 2, 6, distributionMode, text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)

    // ---------- ⑤ 履歴カバレッジ テーブル (実際に読み込めた範囲) ----------
    //   要求期間に対し、TradingView が実際に読み込めた履歴の範囲と、
    //   要求期間を完全に取得できているか (最古バーが要求開始以前か) を表示。
    int  lastBarTime = time
    bool covFull = not na(firstLoadedTime) and firstLoadedTime <= requestedStart   // 要求開始まで履歴が届いているか
    table.cell(tblCov, 0, 0, "履歴カバレッジ (JST)", text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblCov, 1, 0, "",                       text_color = txtCol, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(tblCov, 0, 1, "要求開始日時",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 1, 1, str.format_time(requestedStart, "yyyy-MM-dd HH:mm", "Asia/Tokyo"), text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 0, 2, "最古バー日時",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 1, 2, na(firstLoadedTime) ? "-" : str.format_time(firstLoadedTime, "yyyy-MM-dd HH:mm", "Asia/Tokyo"), text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 0, 3, "最新バー日時",           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 1, 3, str.format_time(lastBarTime, "yyyy-MM-dd HH:mm", "Asia/Tokyo"), text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 0, 4, "要求期間 完全取得?",     text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 1, 4, covFull ? "OK (完全)" : "不足 (履歴不足)",
                 text_color = txtCol,
                 bgcolor = covFull ? color.new(color.green, 0) : color.new(color.red, 0),
                 text_size = size.tiny)
    table.cell(tblCov, 0, 5, "集計対象時間帯",         text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)
    table.cell(tblCov, 1, 5, sessionAggMode,           text_color = txtCol, bgcolor = cellBg, text_size = size.tiny)

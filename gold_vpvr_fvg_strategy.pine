//@version=5
strategy("Gold VPVR FVG Acceptance Strategy v2",
     overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     pyramiding=1,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_boxes_count=500,
     max_labels_count=500,
     max_lines_count=500)

// ============================================================
// Gold VPVR FVG Acceptance Strategy v2
//   XAUUSD / 5min 推奨
//   JST 10:00-02:59 のみエントリー（日跨ぎ）
//   単利（初期資本×5%リスク固定）/ 可変SL,TP / RR 1:3 以上
//   ロット：整数（四捨五入）、1未満は不発
//
//   BUY = ①下から来た → ②POCゾーンに接近 → ③Bear FVG吸収
//        → ④POCゾーン完全上抜け → ⑤上で定着
//   SELL = 完全対称
// ============================================================

// ===== Inputs =====
// ===== 00. ボラ基準 =====
grpVol2        = "00. Volatility Base"
atrLenBase     = input.int(14, "基準ATR本数", minval=1, group=grpVol2)
atrTf          = input.timeframe("", "基準ATR時間足(空=チャート)", group=grpVol2)
useVolAdaptive = input.bool(true, "全$パラメータをボラ連動にする", group=grpVol2)
baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead=barmerge.lookahead_on)

// ===== 係数（方式B）=====
grpVolK   = "00. Volatility Coefficients"
kPocZone  = input.float(0.19, "POCゾーン幅 ×ATR",   step=0.01, group=grpVolK)
kFvgMin   = input.float(0.19, "FVG最小 ×ATR",       step=0.01, group=grpVolK)
kSlBuffer = input.float(0.94, "SLバッファ ×ATR",    step=0.01, group=grpVolK)
kMinSl    = input.float(1.51, "SL下限 ×ATR",        step=0.01, group=grpVolK)
kMaxSl    = input.float(3.0, "SL上限 ×ATR",        step=0.01, group=grpVolK)
kMaSl     = input.float(0.94, "MA余白SL ×ATR",      step=0.01, group=grpVolK)
kMaTp     = input.float(0.19, "MA余白TP ×ATR",      step=0.01, group=grpVolK)
kMinGuard = input.float(1.51, "MA後最小SL ×ATR",    step=0.01, group=grpVolK)
kBe       = input.float(2.0, "建値移動 ×ATR",      step=0.01, group=grpVolK)
kPocSl    = input.float(0.2, "POC-SLバッファ ×ATR", step=0.01, group=grpVolK)

g0 = "Capital"
initCap = input.float(1000, "Initial capital (USD) ※strategyプロパティと一致させること", group=g0)
riskPct = input.float(3.0, "Risk per trade (% of initial capital)", minval=0.1, maxval=100, step=0.1, group=g0)
useCompound = input.bool(false, "複利ON（現在の総資金ベースでリスク計算）", group=g0)   // ★追加

g1 = "VPVR (TV内蔵VPVR準拠)"
vpLookback   = input.int(100, "Width [bars]", minval=20, group=g1)
vpBins       = input.int(110, "Rows", minval=10, maxval=200, group=g1)
pocZoneWidthIn = input.float(1.0, "POC zone half-width (price)", step=0.1, group=g1)
pocZoneWidth   = useVolAdaptive ? baseAtr * kPocZone : pocZoneWidthIn

g2 = "FVG"
fvgMinSizeIn = input.float(1.0, "FVG min size (price)", step=0.1, group=g2)
fvgMinSize   = useVolAdaptive ? baseAtr * kFvgMin : fvgMinSizeIn
useFvgFilled = input.bool(false, "Skip used FVGs (一度抜けたFVGは使わない・案D)", group=g2)
useFvgAge    = input.bool(false, "Skip aged FVGs (古いFVG除外・案C)", group=g2)
fvgMaxAge    = input.int(100, "FVG max age (bars)", minval=1, group=g2)

g3 = "Cross / Approach / Acceptance"
crossLookback = input.int(20, "Cross & Approach lookback bars", minval=2, group=g3)
acceptBars    = input.int(2,  "Acceptance bars (consecutive above/below zone)", minval=1, group=g3)

g4 = "Risk"
slBufferIn = input.float(5.0,  "SL buffer (price)", step=0.1, group=g4)
slBuffer   = useVolAdaptive ? baseAtr * kSlBuffer : slBufferIn
minSlIn = input.float(8.0,  "Min SL (price)", step=0.1, group=g4)
minSl   = useVolAdaptive ? baseAtr * kMinSl : minSlIn
maxSlIn = input.float(25.0, "Max SL (price)", step=0.1, group=g4)
maxSl   = useVolAdaptive ? baseAtr * kMaxSl : maxSlIn
rr       = input.float(3.0,  "Risk:Reward (>=3)", minval=2.0, step=0.1, group=g4)
useAtrSL  = input.bool(true, "SLをATR可変にする", group=g4)
atrSLLen  = input.int(14, "SL用ATR本数", minval=1, group=g4)
atrSLMult = input.float(2.0, "SL用ATR係数", minval=0.1, step=0.1, group=g4)

usePocSL      = input.bool(true, "SLをPOC基準にする（出来高ライン基準）", group=g4)
pocSlBufferIn = input.float(5.0, "POC SL buffer (price)", step=0.1, group=g4)
pocSlBuffer   = useVolAdaptive ? baseAtr * kPocSl : pocSlBufferIn

useMaSLTP    = input.bool(false,  "MAでSL/TP調整", group=g4)
maNearPct    = input.float(0.30, "MA近接判定（リスク幅の割合）", minval=0.01, maxval=1.0, step=0.01, group=g4)
maSlBufferIn = input.float(5.0, "MAスナップ余白：SL($)", minval=0.0, step=0.1, group=g4)
maSlBuffer   = useVolAdaptive ? baseAtr * kMaSl : maSlBufferIn
maTpBufferIn = input.float(1.0, "MAスナップ余白：TP($)", minval=0.0, step=0.1, group=g4)
maTpBuffer   = useVolAdaptive ? baseAtr * kMaTp : maTpBufferIn
minRiskGuardIn = input.float(8.0, "MAスナップ後の最小SL($)", minval=0.1, step=0.1, group=g4)
minRiskGuard   = useVolAdaptive ? baseAtr * kMinGuard : minRiskGuardIn

g5 = "Time (Asia/Tokyo)"
startHour = input.int(10, "Start hour", minval=0, maxval=23, group=g5)
endHour   = input.int(3,  "End hour",   minval=0, maxval=23, group=g5)

g6 = "Trend Filter (EMA)"
emaLen      = input.int(200, "EMA length", minval=10, group=g6)
useEmaFilter = input.bool(true, "Enable EMA trend filter", group=g6)
useEmaSlope  = input.bool(false, "Require EMA slope direction (EMA傾き必須)", group=g6)
emaSlopeBars = input.int(5, "EMA slope lookback bars", minval=1, group=g6)

g7 = "Candle Quality / Breakout Distance"
bodyRatioMin = input.float(0.6, "Min body/range ratio (実体率)", minval=0.0, maxval=1.0, step=0.05, group=g7)
atrLen       = input.int(14,  "ATR length", minval=1, group=g7)
atrBreakMult = input.float(0.3, "POC breakout distance (ATR multiple)", minval=0.0, step=0.1, group=g7)
useBodyFilter   = input.bool(false, "Enable body filter", group=g7)
useBreakDistOk  = input.bool(false, "Enable ATR breakout distance filter", group=g7)
// 既存の g7 = "Candle Quality / Breakout Distance" の最後に追加
volSmaLen    = input.int(20, "Volume SMA length", minval=2, group=g7)
volMult      = input.float(1.3, "Volume multiplier vs SMA", minval=1.0, step=0.05, group=g7)
useVolFilter = input.bool(false, "Enable volume filter", group=g7)
useFirstBreakout = input.bool(true, "First breakout only (1 entry per setup)", group=g7)
useHoldFilter = input.bool(false, "Require no-wick hold above/below POC (ヒゲ戻し排除)", group=g7)
useDirFilter = input.bool(false, "Entry candle direction (SELL=陰線/BUY=陽線)", group=g7)

g8 = "Compression Filter"
useCompression = input.bool(true, "Require compression before breakout (圧縮→爆発限定)", group=g8)
compLookback   = input.int(10, "Compression lookback bars (pre-breakout)", minval=3, group=g8)
compMult       = input.float(2.5, "Max range as ATR multiple", minval=0.5, step=0.1, group=g8)

g9 = "Break-Even"
useBreakeven  = input.bool(true, "Move SL to breakeven after profit (建値移動)", group=g9)
beTriggerUSDIn = input.float(10.0, "Profit ($) to move SL to BE", minval=0.1, step=0.5, group=g9)
beTriggerUSD   = useVolAdaptive ? baseAtr * kBe : beTriggerUSDIn

g10 = "Reacceleration"
useReaccel     = input.bool(true, "Require reacceleration after acceptance (再加速確認)", group=g10)
reaccelMaxWait = input.int(1, "Max bars to wait for reacceleration", minval=1, group=g10)

g11 = "ADX (Trend Strength Filter)"
useAdxFilter = input.bool(true, "Require ADX > threshold (トレンド相場のみ)", group=g11)
adxLen       = input.int(14, "ADX length", minval=1, group=g11)
adxThreshold = input.float(30.0, "ADX min threshold (20=弱、25=標準、30=強)", minval=0, step=1, group=g11)
adxTf = input.timeframe("60", "ADX timeframe (HTF)", group=g11)

g12 = "Chop / POC Revisit Filter"
useChopFilter   = input.bool(false, "Skip choppy POC revisits", group=g12)
chopLookback    = input.int(20, "POC cross lookback bars", minval=5, group=g12)
chopMaxCrosses  = input.int(2,  "Max POC crosses allowed", minval=1, group=g12)

g13 = "Efficiency Ratio"
useErFilter = input.bool(false, "Require trending (ER)", group=g13)
erLen       = input.int(10, "ER length", minval=2, group=g13)
erMin       = input.float(0.35, "Min efficiency (0-1)", minval=0, maxval=1, step=0.05, group=g13)
erChange = math.abs(close - close[erLen])
erVol    = math.sum(math.abs(close - close[1]), erLen)
efficiency = erVol > 0 ? erChange / erVol : 0.0
erOk = not useErFilter or efficiency >= erMin

g14 = "Choppiness Index"
useChopIdx = input.bool(false, "Skip if Choppiness high", group=g14)
chopIdxLen = input.int(14, "Choppiness length", minval=2, group=g14)
chopIdxMax = input.float(50.0, "Max choppiness (under=trend)", step=1, group=g14)

ciHigh = ta.highest(high, chopIdxLen)
ciLow  = ta.lowest(low, chopIdxLen)
chopIndex = 100 * math.log10(math.sum(ta.atr(1), chopIdxLen) / (ciHigh - ciLow)) / math.log10(chopIdxLen)
chopIdxOk = not useChopIdx or chopIndex < chopIdxMax

// ===== Time filter =====
hJst = hour(time, "Asia/Tokyo")
inSession = startHour > endHour
     ? (hJst >= startHour or hJst < endHour)
     : (hJst >= startHour and hJst < endHour)

// ===== Trend filter (EMA) =====
emaVal = ta.ema(close, emaLen)
plot(emaVal, "EMA Trend", color=color.new(color.blue, 30), linewidth=2)

ema_1m_1000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1m_3000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_5m_1000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_5m_3000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_15m_1000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_15m_3000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_1h_1000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1h_3000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_4h_1000  = request.security(syminfo.tickerid, "240", ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_4h_3000  = request.security(syminfo.tickerid, "240", ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
maArr = array.from(ema_1m_1000, ema_1m_3000, ema_5m_1000, ema_5m_3000, ema_15m_1000, ema_15m_3000, ema_1h_1000, ema_1h_3000, ema_4h_1000, ema_4h_3000)
// ===== Pseudo VPVR (TV内蔵VPVR準拠) =====
//   ・Rows = 110、Width = 100 本（内蔵デフォルトと同じ）
//   ・各ローソクの volume を H-L レンジ全体に等分配（内蔵と同等）
//   ・POC = 最大ビンの中心価格
hh = ta.highest(high, vpLookback)
ll = ta.lowest(low,   vpLookback)
binSize = (hh - ll) / vpBins

var float[] binVols = array.new_float(0)
var float pocPrice = na
var float pocUpper = na
var float pocLower = na

if barstate.isconfirmed and binSize > 0
    array.clear(binVols)
    for i = 0 to vpBins - 1
        array.push(binVols, 0.0)

    // ★各ローソクの volume を H-L レンジ全ビンに按分（TV内蔵と同じ）
    for i = 0 to vpLookback - 1
        cHigh = high[i]
        cLow  = low[i]
        cVol  = volume[i]
        cRange = cHigh - cLow

        if cRange <= 0
            // 単一価格のバー → 1ビンに全部
            idx = int(math.floor((cHigh - ll) / binSize))
            idx := math.max(0, math.min(vpBins - 1, idx))
            array.set(binVols, idx, array.get(binVols, idx) + cVol)
        else
            startIdx = int(math.floor((cLow  - ll) / binSize))
            endIdx   = int(math.floor((cHigh - ll) / binSize))
            startIdx := math.max(0, math.min(vpBins - 1, startIdx))
            endIdx   := math.max(0, math.min(vpBins - 1, endIdx))
            numBins  = endIdx - startIdx + 1
            volPerBin = cVol / numBins
            for j = startIdx to endIdx
                array.set(binVols, j, array.get(binVols, j) + volPerBin)

    // 最大ビン = POC
    maxIdx = 0
    maxVol = 0.0
    for i = 0 to vpBins - 1
        v = array.get(binVols, i)
        if v > maxVol
            maxVol := v
            maxIdx := i
    pocPrice := ll + (maxIdx + 0.5) * binSize
    pocUpper := pocPrice + pocZoneWidth
    pocLower := pocPrice - pocZoneWidth

// POCゾーン描画
var box pocBox = na
if not na(pocUpper) and not na(pocLower)
    if na(pocBox)
        pocBox := box.new(bar_index - 50, pocUpper, bar_index + 5, pocLower,
             border_color=color.new(color.orange, 40),
             bgcolor=color.new(color.orange, 88))
    else
        box.set_lefttop(pocBox,     bar_index - 50, pocUpper)
        box.set_rightbottom(pocBox, bar_index + 5,  pocLower)

plot(pocPrice, "POC", color=color.new(color.orange, 0), linewidth=1, style=plot.style_circles)

crossedPoc = not na(pocPrice) and ((close > pocPrice and close[1] <= pocPrice) or (close < pocPrice and close[1] >= pocPrice))
pocCrossCount = math.sum(crossedPoc ? 1 : 0, chopLookback)
chopOk = not useChopFilter or pocCrossCount <= chopMaxCrosses

// ===== Candle quality & breakout distance =====
atrVal = useVolAdaptive ? baseAtr : ta.atr(atrLen)
candleRange = high - low
candleBody  = math.abs(close - open)
bodyRatio   = candleRange > 0 ? candleBody / candleRange : 0.0

// 実体60%以上か
strongBody = not useBodyFilter or bodyRatio >= bodyRatioMin

// POC上抜け/下抜け距離が ATR×0.3 以上か
buyBreakDistOk  = not useBreakDistOk or (not na(pocUpper) and (close - pocUpper) >= atrVal * atrBreakMult)
sellBreakDistOk = not useBreakDistOk or (not na(pocLower) and (pocLower - close) >= atrVal * atrBreakMult)

// 出来高フィルター
volSma = ta.sma(volume, volSmaLen)
volOk  = not useVolFilter or volume > volSma * volMult

// ★③ Compression → Expansion フィルター
//   ブレイク前 compLookback 本の合計レンジが ATR × compMult より小さければ「圧縮」と判定
//   Acceptance期間+ブレイクバーをスキップして、本当の「ブレイク前」を測る
preBreakOffset = acceptBars + 1
preCompHigh  = ta.highest(high[preBreakOffset], compLookback)
preCompLow   = ta.lowest( low[preBreakOffset],  compLookback)
preCompRange = preCompHigh - preCompLow
compressed   = not useCompression or (not na(preCompRange) and preCompRange < atrVal * compMult)

// ★ADX フィルター（トレンド相場限定）
//   ADX = トレンドの「強さ」指標
//     〜20: レンジ相場（無視）
//     20〜25: 弱トレンド
//     25〜30: 標準トレンド
//     30〜: 強トレンド
// 上位時間足の ADX を取得
adxHtfFunc() =>
    [dp, dm, ax] = ta.dmi(adxLen, adxLen)
    [dp[1], dm[1], ax[1]]
[diPlus, diMinus, adxVal] = request.security(syminfo.tickerid, adxTf, adxHtfFunc(), lookahead=barmerge.lookahead_on)

adxOk = not useAdxFilter or adxVal > adxThreshold

// ===== FVG =====
bullFvgRaw = low > high[2]
bearFvgRaw = high < low[2]
bullFvgSize = bullFvgRaw ? (low - high[2]) : 0.0
bearFvgSize = bearFvgRaw ? (low[2] - high) : 0.0
bullFvgValid = bullFvgRaw and bullFvgSize >= fvgMinSize
bearFvgValid = bearFvgRaw and bearFvgSize >= fvgMinSize

var float lastBullTop    = na   // Bullish FVG top    = low
var float lastBullBottom = na   // Bullish FVG bottom = high[2]
var float lastBearTop    = na   // Bearish FVG top    = low[2]
var float lastBearBottom = na   // Bearish FVG bottom = high
var bool bullFvgFilled = false
var bool bearFvgFilled = false
var int  bullFvgBar    = na
var int  bearFvgBar    = na

if barstate.isconfirmed
        // ★案D：未到達フラグ管理
    //   終値が境界を超えたら「使用済み」マーク
    //   ※判定タイミングがbar確定後なので、エントリー側は [1] 参照で時差を作る
    if not na(lastBearTop) and close > lastBearTop
        bearFvgFilled := true
    if not na(lastBullBottom) and close < lastBullBottom
        bullFvgFilled := true

    // 新規FVG発生 → 上書き＋fillフラグリセット＋作成バー記録
    if bullFvgValid
        lastBullTop    := low
        lastBullBottom := high[2]
        bullFvgFilled  := false
        bullFvgBar     := bar_index
    if bearFvgValid
        lastBearTop    := low[2]
        lastBearBottom := high
        bearFvgFilled  := false
        bearFvgBar     := bar_index

if bullFvgValid and barstate.isconfirmed
    box.new(bar_index - 2, low, bar_index + 5, high[2],
         border_color=color.new(color.green, 60),
         bgcolor=color.new(color.green, 90))
if bearFvgValid and barstate.isconfirmed
    box.new(bar_index - 2, low[2], bar_index + 5, high,
         border_color=color.new(color.red, 60),
         bgcolor=color.new(color.red, 90))

// ===== State tracking =====

// ① 下から来た：直近で pocLower より下に終値があったか
var int lastBelowBar = na
if barstate.isconfirmed and not na(pocLower) and close < pocLower
    lastBelowBar := bar_index

// ① 上から来た：直近で pocUpper より上に終値があったか
var int lastAboveBar = na
if barstate.isconfirmed and not na(pocUpper) and close > pocUpper
    lastAboveBar := bar_index

// ② POCゾーン接近：直近で価格レンジがゾーンに重なったか（wick含む）
zoneTouchBar = not na(pocUpper) and not na(pocLower) and low <= pocUpper and high >= pocLower
var int lastTouchBar = na
if barstate.isconfirmed and zoneTouchBar
    lastTouchBar := bar_index

cameFromBelow     = not na(lastBelowBar) and (bar_index - lastBelowBar) <= crossLookback
cameFromAbove     = not na(lastAboveBar) and (bar_index - lastAboveBar) <= crossLookback
approachedZone    = not na(lastTouchBar) and (bar_index - lastTouchBar) <= crossLookback

// ⑤ Acceptance カウンタ：pocUpper上 / pocLower下 の連続終値
var int aboveCount = 0
var int belowCount = 0
if barstate.isconfirmed
    aboveCount := (not na(pocUpper) and close > pocUpper) ? aboveCount + 1 : 0
    belowCount := (not na(pocLower) and close < pocLower) ? belowCount + 1 : 0

// ★②保持フィルター：close + low 両方が pocUpper より上で連続したか
//   ヒゲがゾーンに戻ったらカウントリセット
var int aboveHoldCount = 0
var int belowHoldCount = 0
if barstate.isconfirmed
    aboveHoldCount := (not na(pocUpper) and close > pocUpper and low  > pocUpper) ? aboveHoldCount + 1 : 0
    belowHoldCount := (not na(pocLower) and close < pocLower and high < pocLower) ? belowHoldCount + 1 : 0

// ③ FVG吸収（案D：未到達FVG限定 + 案C：有効期限）
//   ※ bearFvgFilled[1] = 「1バー前」の状態を参照
//      これにより、吸収バー自体で立てたフラグが今バーの判定をブロックしない
fvgFilledOkBear = not useFvgFilled or not bearFvgFilled[1]
fvgFilledOkBull = not useFvgFilled or not bullFvgFilled[1]
fvgAgeOkBear    = not useFvgAge    or (not na(bearFvgBar) and (bar_index - bearFvgBar) <= fvgMaxAge)
fvgAgeOkBull    = not useFvgAge    or (not na(bullFvgBar) and (bar_index - bullFvgBar) <= fvgMaxAge)

bearFvgEaten = not na(lastBearTop)    and close > lastBearTop    and fvgFilledOkBear and fvgAgeOkBear
bullFvgEaten = not na(lastBullBottom) and close < lastBullBottom and fvgFilledOkBull and fvgAgeOkBull

// ===== 統合シグナル =====
emaOkBuy  = not useEmaFilter or close > emaVal
emaOkSell = not useEmaFilter or close < emaVal
// ★B3 EMA傾きフィルター
emaSlopeOkBuy  = not useEmaSlope or emaVal > emaVal[emaSlopeBars]
emaSlopeOkSell = not useEmaSlope or emaVal < emaVal[emaSlopeBars]

// ★②保持フィルター
holdOkBuy  = not useHoldFilter or aboveHoldCount >= acceptBars
holdOkSell = not useHoldFilter or belowHoldCount >= acceptBars

// Raw（全条件成立中はずっとtrue）
buySignalRaw  = cameFromBelow and approachedZone and bearFvgEaten and close > pocUpper and aboveCount >= acceptBars and emaOkBuy and strongBody and buyBreakDistOk and volOk and holdOkBuy and compressed and emaSlopeOkBuy and adxOk and chopOk and erOk and chopIdxOk                                 // ⑬ ★ADX

sellSignalRaw = cameFromAbove and approachedZone and bullFvgEaten and close < pocLower and belowCount >= acceptBars and emaOkSell and strongBody and sellBreakDistOk and volOk and holdOkSell and compressed and emaSlopeOkSell and adxOk and chopOk and erOk and chopIdxOk                             // ⑬ ★
// ===== ★案①：Reacceleration =====
//   Acceptance完了（Rawがfalse→true）→ armed → reaccelMaxWait 本以内に高値/安値更新 → 発火
var float buyArmHigh = na
var int   buyArmBar  = na
var float sellArmLow = na
var int   sellArmBar = na

if barstate.isconfirmed
    // 期限切れなら解除
    if not na(buyArmBar) and (bar_index - buyArmBar) > reaccelMaxWait
        buyArmHigh := na
        buyArmBar  := na
    if not na(sellArmBar) and (bar_index - sellArmBar) > reaccelMaxWait
        sellArmLow := na
        sellArmBar := na

    // Acceptance完了の瞬間（Rawの立ち上がり）→ arm
    //   その時点の高値/安値を「越えるべき基準値」として記録
    if buySignalRaw and not buySignalRaw[1]
        buyArmHigh := high
        buyArmBar  := bar_index
    if sellSignalRaw and not sellSignalRaw[1]
        sellArmLow := low
        sellArmBar := bar_index

// Reaccel発火：armed状態で、後続バーが高値/安値を更新
reaccelBuy  = not na(buyArmHigh) and bar_index > buyArmBar  and high > buyArmHigh
reaccelSell = not na(sellArmLow) and bar_index > sellArmBar and low  < sellArmLow

// 初回突破限定：Rawがfalse→trueに切り替わる瞬間だけtrue
// Reaccel ON 時は reaccel優先、OFF 時は従来の初回突破ロジック
buySignal  = useReaccel ? reaccelBuy
           : useFirstBreakout ? (buySignalRaw  and not buySignalRaw[1])
           : buySignalRaw
sellSignal = useReaccel ? reaccelSell
           : useFirstBreakout ? (sellSignalRaw and not sellSignalRaw[1])
           : sellSignalRaw
// ===== Break-even tracking =====
var bool  beApplied = false
var float currentTp = na

// ポジションがフラットになったらリセット
if strategy.position_size == 0
    beApplied := false
    currentTp := na

f_adjust_sl_tp(_dir, _entry, _slRaw, _tpRaw) =>
    _risk0 = math.abs(_entry - _slRaw)
    _thr   = _risk0 * maNearPct
    _slOut = _slRaw
    _tpOut = _tpRaw
    if useMaSLTP and _risk0 > 0 and array.size(maArr) > 0
        _slMA = float(na)
        _slBest = float(na)
        _tpMA = float(na)
        _tpBest = float(na)
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            if not na(_m)
                _dSL = math.abs(_m - _slRaw)
                if _dSL <= _thr and (na(_slBest) or _dSL < _slBest)
                    _slBest := _dSL
                    _slMA := _m
                _dTP = math.abs(_m - _tpRaw)
                if _dTP <= _thr and (na(_tpBest) or _dTP < _tpBest)
                    _tpBest := _dTP
                    _tpMA := _m
        if _dir == 1
            if not na(_slMA)
                _slOut := math.min(_slMA - maSlBuffer, _entry - minRiskGuard)
            if not na(_tpMA) and (_tpMA - maTpBuffer) > _entry
                _tpOut := _tpMA - maTpBuffer
        else
            if not na(_slMA)
                _slOut := math.max(_slMA + maSlBuffer, _entry + minRiskGuard)
            if not na(_tpMA) and (_tpMA + maTpBuffer) < _entry
                _tpOut := _tpMA + maTpBuffer
    [_slOut, _tpOut]

// ===== Risk / SL / TP =====
buyRisk     = close - (lastBearBottom - slBuffer)
sellRisk    = (lastBullTop + slBuffer) - close
atrSlDist = (useVolAdaptive ? baseAtr : ta.atr(atrSLLen)) * atrSLMult

// ★POCベースSL（出来高ライン基準）
//   BUY  : POCゾーン下端(pocLower) - バッファ … 仮説崩壊点
//   SELL : POCゾーン上端(pocUpper) + バッファ
//   生の距離は maxSl 判定に使い、下限のみ minSl でクランプ
pocBuyRisk  = not na(pocLower) ? close - (pocLower - pocSlBuffer) : na
pocSellRisk = not na(pocUpper) ? (pocUpper + pocSlBuffer) - close : na

// 「ATR相当より狭くしない」= 狭すぎ問題を解消しつつPOC論理を残す
buyRiskAdj  = usePocSL ? math.max(pocBuyRisk,  atrSlDist) : useAtrSL ? atrSlDist : (buyRisk  < minSl ? minSl : buyRisk)
sellRiskAdj = usePocSL ? math.max(pocSellRisk, atrSlDist) : useAtrSL ? atrSlDist : (sellRisk < minSl ? minSl : sellRisk)

buyEntry  = close
sellEntry = close
buySl     = buyEntry  - buyRiskAdj
sellSl    = sellEntry + sellRiskAdj
buyTp     = buyEntry  + buyRiskAdj  * rr
sellTp    = sellEntry - sellRiskAdj * rr

[_bSl, _bTp] = f_adjust_sl_tp(1, buyEntry, buySl, buyTp)
buySl := _bSl
buyTp := _bTp
buyRiskAdj := buyEntry - buySl

[_sSl, _sTp] = f_adjust_sl_tp(-1, sellEntry, sellSl, sellTp)
sellSl := _sSl
sellTp := _sTp
sellRiskAdj := sellSl - sellEntry

// ===== ポジションサイズ（単利・整数ロット・1未満不発） =====
equityNow = strategy.initial_capital + strategy.netprofit   // 現在の確定資金（初期＋確定損益）
riskUSD   = (useCompound ? equityNow : initCap) * (riskPct / 100.0)
buyQtyRaw  = buyRiskAdj  > 0 ? riskUSD / buyRiskAdj  : 0.0
sellQtyRaw = sellRiskAdj > 0 ? riskUSD / sellRiskAdj : 0.0
buyQty  = math.round(buyQtyRaw)
sellQty = math.round(sellQtyRaw)

dirOkBuy  = not useDirFilter or close > open   // BUYは陽線
dirOkSell = not useDirFilter or close < open   // SELLは陰線

flat = strategy.position_size == 0

// maxSl判定：POCモード時はPOCベースの生リスクで判定（超過なら不発）
buyMaxRisk  = usePocSL ? pocBuyRisk  : buyRisk
sellMaxRisk = usePocSL ? pocSellRisk : sellRisk

buyOk  = inSession and buySignal  and buyMaxRisk  <= maxSl and not na(lastBearBottom) and buyQty  >= 1 and dirOkBuy
sellOk = inSession and sellSignal and sellMaxRisk <= maxSl and not na(lastBullTop)    and sellQty >= 1 and dirOkSell

// ===== Entry =====
if barstate.isconfirmed and buyOk
    strategy.entry("BUY", strategy.long, qty=buyQty)
    strategy.exit("BUY-X", from_entry="BUY", stop=buySl, limit=buyTp)
    // セットアップを使い切り、次のサイクルを待つためリセット
    lastBelowBar  := na
    lastTouchBar  := na
    aboveCount    := 0
    aboveHoldCount := 0
    beApplied := false
    currentTp := buyTp
    buyArmHigh := na
    buyArmBar  := na
    label.new(bar_index, low,
         "BUY x" + str.tostring(buyQty, "#") +
         "\nE:"  + str.tostring(buyEntry, "#.##") +
         "\nSL:" + str.tostring(buySl, "#.##") +
         "\nTP:" + str.tostring(buyTp, "#.##") +
         "\nRisk$:" + str.tostring(riskUSD, "#.##"),
         style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if barstate.isconfirmed and sellOk
    strategy.entry("SELL", strategy.short, qty=sellQty)
    strategy.exit("SELL-X", from_entry="SELL", stop=sellSl, limit=sellTp)
    lastAboveBar := na
    lastTouchBar := na
    belowCount   := 0
    belowHoldCount := 0
    beApplied := false
    currentTp := sellTp
    sellArmLow := na
    sellArmBar := na
    label.new(bar_index, high,
         "SELL x" + str.tostring(sellQty, "#") +
         "\nE:"   + str.tostring(sellEntry, "#.##") +
         "\nSL:"  + str.tostring(sellSl, "#.##") +
         "\nTP:"  + str.tostring(sellTp, "#.##") +
         "\nRisk$:" + str.tostring(riskUSD, "#.##"),
         style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ===== マーカー =====
plotshape(bearFvgEaten and barstate.isconfirmed, title="Bear FVG Eaten", style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 70),    size=size.tiny)
plotshape(bullFvgEaten and barstate.isconfirmed, title="Bull FVG Eaten", style=shape.triangledown, location=location.abovebar, color=color.new(color.fuchsia, 70), size=size.tiny)
plotshape(buySignal,  title="BUY Signal",  style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(sellSignal, title="SELL Signal", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0),   size=size.tiny)

// ===== アラート =====
alertcondition(buyOk,  "BUY Acceptance Entry",  "BUY XAUUSD")
alertcondition(sellOk, "SELL Acceptance Entry", "SELL XAUUSD")

if buyOk
    alert("BUY | E=" + str.tostring(buyEntry, "#.##") +
         " SL=" + str.tostring(buySl, "#.##") +
         " TP=" + str.tostring(buyTp, "#.##") +
         " RR=" + str.tostring(rr) +
         " Qty=" + str.tostring(buyQty, "#") +
         " POC=" + str.tostring(pocPrice, "#.##"),
         alert.freq_once_per_bar_close)
if sellOk
    alert("SELL | E=" + str.tostring(sellEntry, "#.##") +
         " SL=" + str.tostring(sellSl, "#.##") +
         " TP=" + str.tostring(sellTp, "#.##") +
         " RR=" + str.tostring(rr) +
         " Qty=" + str.tostring(sellQty, "#") +
         " POC=" + str.tostring(pocPrice, "#.##"),
         alert.freq_once_per_bar_close)

// ===== Break-even logic =====
//   含み益が beTriggerUSD 以上になったら SL を建値（entry price）に移動
if useBreakeven and not beApplied and not na(currentTp)
    if strategy.position_size > 0
        // BUY: 高値が entry + beTriggerUSD 以上に達したら BE
        if high - strategy.position_avg_price >= beTriggerUSD
            strategy.exit("BUY-X", from_entry="BUY", stop=strategy.position_avg_price, limit=currentTp)
            beApplied := true
    if strategy.position_size < 0
        // SELL: 安値が entry - beTriggerUSD 以下に達したら BE
        if strategy.position_avg_price - low >= beTriggerUSD
            strategy.exit("SELL-X", from_entry="SELL", stop=strategy.position_avg_price, limit=currentTp)
            beApplied := true

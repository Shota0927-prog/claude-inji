//@version=6
// ZoneEngineV2_W06Component_Worker - W06 dependency component / Candidate cache subsystem, kept out of
// the Main library for the compiled token limit (PLAN A). Every enum value below mirrors the Production
// Main constant of the same name; nothing here changes a Main or W05 Candidate rule.
library("ZoneEngineV2_W06Component_Worker", overlay = false)
import sekine3310/ZoneEngineV2_W05Candidate_Worker/3 as W05Cand

const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int ROOT_ACTIVE         = 1
const int ROOT_INVERSE_ACTIVE = 4
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int JGROUP_E1 = 1
const int JGROUP_E4 = 4
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_MA_UPDATE      = 3
const int JOP_SWING_TF_MERGE = 4
const int JOP_TIMEHL_LABEL   = 5
const int JOP_FVG_FRESH_END  = 6
const int JOP_ROOT_RETIRE    = 7
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
// W06 B04 seed reason bits (private, never exported)
const int CAND_SEED_REASON_ADDED     = 1
const int CAND_SEED_REASON_STATE     = 2
const int CAND_SEED_REASON_GEOMETRY  = 4
const int CAND_SEED_REASON_QUALITY   = 8
const int CAND_SEED_REASON_TIEBREAK  = 16
const int CAND_SEED_REASON_FVG       = 32
const int CAND_SEED_REASON_BROAD     = 64

// W06 B04: dependency Side mask of one Root slot (a superset of the Candidate eligibility: no use flag, no Fresh, no TF).
// 0 neither / 1 Support / 2 Resistance / 3 both.
//   Point (MA / Swing / Accum / TimeHL): live, rootId != 0, ACTIVE, pointTick not na -> 3
//   FVG: live, rootId != 0, Bullish / Bearish, ACTIVE / INVERSE_ACTIVE, native ticks not na and bottom <= top ->
//        Support for Bullish ACTIVE or Bearish INVERSE_ACTIVE, Resistance for Bearish ACTIVE or Bullish INVERSE_ACTIVE
compSideMaskRaw(int rootSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks) =>
    int  mask = 0
    bool ok   = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootDirections) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks)
    if ok
        ok := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) != ID_NONE
    if ok
        int category = array.get(rootCategories, rootSlot)
        int state    = array.get(rootStates, rootSlot)
        if category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL
            if state == ROOT_ACTIVE and not na(array.get(rootPointTicks, rootSlot))
                mask := 3
        else if category == CAT_FVG
            int direction  = array.get(rootDirections, rootSlot)
            int bottomTick = array.get(rootNativeBottomTicks, rootSlot)
            int topTick    = array.get(rootNativeTopTicks, rootSlot)
            bool capable = (direction == FVG_BULLISH or direction == FVG_BEARISH) and (state == ROOT_ACTIVE or state == ROOT_INVERSE_ACTIVE) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick
            if capable
                if (direction == FVG_BULLISH and state == ROOT_ACTIVE) or (direction == FVG_BEARISH and state == ROOT_INVERSE_ACTIVE)
                    mask := 1
                else
                    mask := 2
    mask

// W06 B04: seed reasons of the committed Roots that the pending Stage F journal changes, read BEFORE the journal is
// applied. Rows are visited in the Stage F apply order (group E1 .. E4, row ascending). A row whose target does not
// resolve to a live committed Root with the expected rootId adds nothing (NEW_ROOT and same-bar targets: B05).
//   MA_UPDATE      : GEOMETRY (float pointPrice or pointTick differs), TIEBREAK (confirmedTime differs, na-aware),
//                    QUALITY (slope direction of its EMA subtype differs from the chained pre-apply slope, na-aware)
//   SWING_TF_MERGE : QUALITY          TIMEHL_LABEL : QUALITY          ROOT_RETIRE : STATE
//   FVG_INVALIDATE : STATE | FVG (| BROAD for a Broad FVG), and the FVG changed list
//   FVG_FRESH_END  : the Fresh changed list only (never a Candidate seed)
//   NEW_ROOT       : nothing here
// Every output list keeps first-appearance order; a rootId already present is never appended again (seed masks OR).
// Returns [seedCount, fvgChangedCount, freshCount].
export seedPreApply(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalSubtypes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<int> journalSlopeDirs, int journalCount, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootSubtypes, array<float> rootPointPrices, array<int> rootPointTicks, array<int> rootConfirmedTimes, array<bool> rootIsBroadFvgFlags, int ema2000SlopeDir, int ema3000SlopeDir, float mintick, array<int> candSeedRootIds, array<int> candSeedReasonMasks, array<int> candFvgChangedRootIds, array<int> candFvgFreshChangedRootIds, int seedCount, int fvgChangedCount, int freshCount) =>
    int seedLen  = seedCount
    int fvgLen   = fvgChangedCount
    int freshLen = freshCount
    int virtualSlope2000 = ema2000SlopeDir
    int virtualSlope3000 = ema3000SlopeDir
    int count = journalCount
    int group = JGROUP_E1
    while group <= JGROUP_E4
        int row = 0
        while row < count
            bool rowOk = row < array.size(journalOps) and row < array.size(journalGroups) and row < array.size(journalTargetRootSlots) and row < array.size(journalExpectedRootIds) and row < array.size(journalSubtypes) and row < array.size(journalConfirmedTimes) and row < array.size(journalPointPrices) and row < array.size(journalSlopeDirs)
            if rowOk
                rowOk := array.get(journalGroups, row) == group
            if rowOk
                int op             = array.get(journalOps, row)
                int rootSlot       = array.get(journalTargetRootSlots, row)
                int expectedRootId = array.get(journalExpectedRootIds, row)
                bool targetOk = rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootSubtypes) and rootSlot < array.size(rootPointPrices) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootConfirmedTimes) and rootSlot < array.size(rootIsBroadFvgFlags)
                if targetOk
                    targetOk := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId
                int seedMask   = 0
                bool fvgAdd    = false
                bool freshAdd  = false
                if op == JOP_MA_UPDATE
                    // the chained pre-apply slope advances on every MA_UPDATE row, as in the Stage F apply loop
                    int subtype   = array.get(journalSubtypes, row)
                    int newSlope  = array.get(journalSlopeDirs, row)
                    int prevSlope = subtype == SUB_MA_EMA2000 ? virtualSlope2000 : virtualSlope3000
                    if targetOk
                        float oldPrice  = array.get(rootPointPrices, rootSlot)
                        float newPrice  = array.get(journalPointPrices, row)
                        int   oldTick   = array.get(rootPointTicks, rootSlot)
                        int   newTick   = na(newPrice) or na(mintick) or mintick <= 0 ? int(na) : int(math.round(newPrice / mintick))
                        bool  priceDiff = na(oldPrice) != na(newPrice) or (not na(oldPrice) and not na(newPrice) and oldPrice != newPrice)
                        bool  tickDiff  = na(oldTick) != na(newTick) or (not na(oldTick) and not na(newTick) and oldTick != newTick)
                        if priceDiff or tickDiff
                            seedMask += CAND_SEED_REASON_GEOMETRY
                        int oldConfirmed = array.get(rootConfirmedTimes, rootSlot)
                        int newConfirmed = array.get(journalConfirmedTimes, row)
                        if na(oldConfirmed) != na(newConfirmed) or (not na(oldConfirmed) and not na(newConfirmed) and oldConfirmed != newConfirmed)
                            seedMask += CAND_SEED_REASON_TIEBREAK
                        if (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and array.get(rootSubtypes, rootSlot) == subtype
                            if na(prevSlope) != na(newSlope) or (not na(prevSlope) and not na(newSlope) and prevSlope != newSlope)
                                seedMask += CAND_SEED_REASON_QUALITY
                    if subtype == SUB_MA_EMA2000
                        virtualSlope2000 := newSlope
                    else if subtype == SUB_MA_EMA3000
                        virtualSlope3000 := newSlope
                else if op == JOP_SWING_TF_MERGE
                    if targetOk
                        seedMask := CAND_SEED_REASON_QUALITY
                else if op == JOP_TIMEHL_LABEL
                    if targetOk
                        seedMask := CAND_SEED_REASON_QUALITY
                else if op == JOP_FVG_INVALIDATE
                    if targetOk
                        seedMask := CAND_SEED_REASON_STATE + CAND_SEED_REASON_FVG + (array.get(rootIsBroadFvgFlags, rootSlot) ? CAND_SEED_REASON_BROAD : 0)
                        fvgAdd   := true
                else if op == JOP_ROOT_RETIRE
                    if targetOk
                        seedMask := CAND_SEED_REASON_STATE
                else if op == JOP_FVG_FRESH_END
                    if targetOk
                        freshAdd := true
                else if op == JOP_NEW_ROOT
                    seedMask := 0
                if seedMask != 0
                    int pos = SLOT_INVALID
                    int i   = 0
                    while pos == SLOT_INVALID and i < seedLen
                        if array.get(candSeedRootIds, i) == expectedRootId
                            pos := i
                        i += 1
                    if pos != SLOT_INVALID
                        int oldMask = array.get(candSeedReasonMasks, pos)
                        int merged  = 0
                        int bit     = 1
                        while bit <= CAND_SEED_REASON_BROAD
                            if oldMask % (2 * bit) >= bit or seedMask % (2 * bit) >= bit
                                merged += bit
                            bit := bit * 2
                        array.set(candSeedReasonMasks, pos, merged)
                    else
                        if seedLen < array.size(candSeedRootIds)
                            array.set(candSeedRootIds, seedLen, expectedRootId)
                        else
                            array.push(candSeedRootIds, expectedRootId)
                        if seedLen < array.size(candSeedReasonMasks)
                            array.set(candSeedReasonMasks, seedLen, seedMask)
                        else
                            array.push(candSeedReasonMasks, seedMask)
                        seedLen += 1
                if fvgAdd
                    bool found = false
                    int  i     = 0
                    while not found and i < fvgLen
                        found := array.get(candFvgChangedRootIds, i) == expectedRootId
                        i += 1
                    if not found
                        if fvgLen < array.size(candFvgChangedRootIds)
                            array.set(candFvgChangedRootIds, fvgLen, expectedRootId)
                        else
                            array.push(candFvgChangedRootIds, expectedRootId)
                        fvgLen += 1
                if freshAdd
                    bool found = false
                    int  i     = 0
                    while not found and i < freshLen
                        found := array.get(candFvgFreshChangedRootIds, i) == expectedRootId
                        i += 1
                    if not found
                        if freshLen < array.size(candFvgFreshChangedRootIds)
                            array.set(candFvgFreshChangedRootIds, freshLen, expectedRootId)
                        else
                            array.push(candFvgFreshChangedRootIds, expectedRootId)
                        freshLen += 1
            row += 1
        group += 1
    [seedLen, fvgLen, freshLen]

// W06 B05: seed completion AFTER a successful Stage F apply (the journal is fully in the Root SoA).
//   A. the six W06 Root arrays grow to array.size(rootIds) with 0 (never shrink, never reset)
//   B. rootCandComponentExpectedRootIds[slot] := rootId for every live slot still holding 0
//   C. NEW_ROOT rows (group E1 .. E4, row ascending) resolving to a live Root with the journal rootId are seeded:
//      ADDED, | FVG for an FVG Root, | BROAD for a Broad FVG Root; an FVG Root also enters the FVG changed list
//   D. FVG_FRESH_END rows resolving the same way enter the Fresh changed list (path A already there is skipped)
//   E. every seeded Root (resolved by rootIdToSlot, live, same rootId, same expected rootId) gets its revisions:
//      ADDED -> geometry, quality, tieBreak, state +1 each; otherwise GEOMETRY / QUALITY / TIEBREAK / STATE +1 each
//      when set (FVG and BROAD never increment a revision). Lists keep first-appearance order, no duplicate rootId.
// Returns [seedCount, fvgChangedCount, freshCount].
export seedPostApply(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, int journalCount, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<bool> rootIsBroadFvgFlags, map<int, int> rootIdToSlot, array<int> rootCandGeometryRevisions, array<int> rootCandQualityRevisions, array<int> rootCandTieBreakRevisions, array<int> rootCandStateRevisions, array<int> rootCandComponentIds, array<int> rootCandComponentExpectedRootIds, array<int> candSeedRootIds, array<int> candSeedReasonMasks, array<int> candFvgChangedRootIds, array<int> candFvgFreshChangedRootIds, int seedCount, int fvgChangedCount, int freshCount) =>
    int seedLen  = seedCount
    int fvgLen   = fvgChangedCount
    int freshLen = freshCount
    int slotCount = array.size(rootIds)
    // A. grow the W06 Root arrays to the post-apply slot count
    while array.size(rootCandGeometryRevisions) < slotCount
        array.push(rootCandGeometryRevisions, 0)
    while array.size(rootCandQualityRevisions) < slotCount
        array.push(rootCandQualityRevisions, 0)
    while array.size(rootCandTieBreakRevisions) < slotCount
        array.push(rootCandTieBreakRevisions, 0)
    while array.size(rootCandStateRevisions) < slotCount
        array.push(rootCandStateRevisions, 0)
    while array.size(rootCandComponentIds) < slotCount
        array.push(rootCandComponentIds, 0)
    while array.size(rootCandComponentExpectedRootIds) < slotCount
        array.push(rootCandComponentExpectedRootIds, 0)
    // B. expected rootId of every live slot not yet bound
    int s = 0
    while s < slotCount
        if s < array.size(rootSlotLiveFlags)
            int id = array.get(rootIds, s)
            if array.get(rootSlotLiveFlags, s) and id != ID_NONE and array.get(rootCandComponentExpectedRootIds, s) == 0
                array.set(rootCandComponentExpectedRootIds, s, id)
        s += 1
    // C + D. NEW_ROOT seeds and FVG_FRESH_END Fresh entries, Stage F apply order
    int group = JGROUP_E1
    while group <= JGROUP_E4
        int row = 0
        while row < journalCount
            bool rowOk = row < array.size(journalOps) and row < array.size(journalGroups) and row < array.size(journalTargetRootSlots) and row < array.size(journalExpectedRootIds)
            if rowOk
                rowOk := array.get(journalGroups, row) == group
            if rowOk
                int op             = array.get(journalOps, row)
                int rootSlot       = array.get(journalTargetRootSlots, row)
                int expectedRootId = array.get(journalExpectedRootIds, row)
                bool targetOk = (op == JOP_NEW_ROOT or op == JOP_FVG_FRESH_END) and rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < slotCount and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootIsBroadFvgFlags)
                if targetOk
                    targetOk := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId
                if targetOk and op == JOP_NEW_ROOT
                    bool isFvg    = array.get(rootCategories, rootSlot) == CAT_FVG
                    int  seedMask = CAND_SEED_REASON_ADDED + (isFvg ? CAND_SEED_REASON_FVG : 0) + (isFvg and array.get(rootIsBroadFvgFlags, rootSlot) ? CAND_SEED_REASON_BROAD : 0)
                    int pos = SLOT_INVALID
                    int i   = 0
                    while pos == SLOT_INVALID and i < seedLen
                        if array.get(candSeedRootIds, i) == expectedRootId
                            pos := i
                        i += 1
                    if pos != SLOT_INVALID
                        int oldMask = array.get(candSeedReasonMasks, pos)
                        int merged  = 0
                        int bit     = 1
                        while bit <= CAND_SEED_REASON_BROAD
                            if oldMask % (2 * bit) >= bit or seedMask % (2 * bit) >= bit
                                merged += bit
                            bit := bit * 2
                        array.set(candSeedReasonMasks, pos, merged)
                    else
                        if seedLen < array.size(candSeedRootIds)
                            array.set(candSeedRootIds, seedLen, expectedRootId)
                        else
                            array.push(candSeedRootIds, expectedRootId)
                        if seedLen < array.size(candSeedReasonMasks)
                            array.set(candSeedReasonMasks, seedLen, seedMask)
                        else
                            array.push(candSeedReasonMasks, seedMask)
                        seedLen += 1
                    if isFvg
                        bool found = false
                        int  k     = 0
                        while not found and k < fvgLen
                            found := array.get(candFvgChangedRootIds, k) == expectedRootId
                            k += 1
                        if not found
                            if fvgLen < array.size(candFvgChangedRootIds)
                                array.set(candFvgChangedRootIds, fvgLen, expectedRootId)
                            else
                                array.push(candFvgChangedRootIds, expectedRootId)
                            fvgLen += 1
                if targetOk and op == JOP_FVG_FRESH_END
                    bool found = false
                    int  k     = 0
                    while not found and k < freshLen
                        found := array.get(candFvgFreshChangedRootIds, k) == expectedRootId
                        k += 1
                    if not found
                        if freshLen < array.size(candFvgFreshChangedRootIds)
                            array.set(candFvgFreshChangedRootIds, freshLen, expectedRootId)
                        else
                            array.push(candFvgFreshChangedRootIds, expectedRootId)
                        freshLen += 1
            row += 1
        group += 1
    // E. Root revisions of every seeded Root, at most +1 per revision per bar
    int q = 0
    while q < seedLen
        int id   = array.get(candSeedRootIds, q)
        int mask = array.get(candSeedReasonMasks, q)
        int slot = SLOT_INVALID
        if map.contains(rootIdToSlot, id)
            slot := map.get(rootIdToSlot, id)
        bool slotOk = slot != SLOT_INVALID and slot >= 0 and slot < slotCount and slot < array.size(rootSlotLiveFlags)
        if slotOk
            slotOk := array.get(rootSlotLiveFlags, slot) and id != ID_NONE and array.get(rootIds, slot) == id and array.get(rootCandComponentExpectedRootIds, slot) == id
        if slotOk
            bool added = mask % (2 * CAND_SEED_REASON_ADDED) >= CAND_SEED_REASON_ADDED
            if added or mask % (2 * CAND_SEED_REASON_GEOMETRY) >= CAND_SEED_REASON_GEOMETRY
                array.set(rootCandGeometryRevisions, slot, array.get(rootCandGeometryRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_QUALITY) >= CAND_SEED_REASON_QUALITY
                array.set(rootCandQualityRevisions, slot, array.get(rootCandQualityRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_TIEBREAK) >= CAND_SEED_REASON_TIEBREAK
                array.set(rootCandTieBreakRevisions, slot, array.get(rootCandTieBreakRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_STATE) >= CAND_SEED_REASON_STATE
                array.set(rootCandStateRevisions, slot, array.get(rootCandStateRevisions, slot) + 1)
        q += 1
    [seedLen, fvgLen, freshLen]

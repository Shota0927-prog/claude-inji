//@version=5
// POINT MASTER REVERSE ENTRY SHORT — TradingView Strategy Tester 版
// Source : Production "POINT MASTER FVG ABS REBOUND" の Data Window plot "VALIDATED TP CODE" を input.source で接続
// Rule   : VALIDATED TP CODE == +2 (LONG VALIDATED FULL TP) の確定5M足 → 次5M始値で SHORT 成行
// Exit   : strategy.exit profit / loss (tick) = 実際の Entry fill price 基準 TP / SL
// Both hit同一足 : TradingView Broker Emulator 標準処理 (独自判定なし)
strategy("POINT MASTER REVERSE ENTRY SHORT", shorttitle = "PM-REV-S", overlay = true,
     pyramiding = 0, process_orders_on_close = false, calc_on_every_tick = false,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     use_bar_magnifier = true)

// ── Inputs ──
vtCodeSrc = input.source(close, "VALIDATED TP CODE (Production)", tooltip = "Production の Data Window plot \"VALIDATED TP CODE\" を選択")
tpDist    = input.float(10.0, "TP Distance", minval = 0.01, step = 0.5, tooltip = "Entry fill price からの価格差 (XAUUSD)")
slDist    = input.float(15.0, "SL Distance", minval = 0.01, step = 0.5, tooltip = "Entry fill price からの価格差 (XAUUSD)")
showLvls  = input.bool(true, "Entry / TP / SL Plot (保有中のみ)")

// ── Core ──
bool is5M    = timeframe.isminutes and timeframe.multiplier == 5
int  vtCode  = na(vtCodeSrc) ? 0 : int(math.round(vtCodeSrc))
int  tpTicks = int(math.round(tpDist / syminfo.mintick))
int  slTicks = int(math.round(slDist / syminfo.mintick))
bool isFlat  = strategy.position_size == 0 and strategy.opentrades == 0

// 保有中は ±2 を全て無視 / ドテンなし / 1 signal 足につき entry 1回
bool shortSignal = is5M and barstate.isconfirmed and vtCode == 2 and isFlat

if shortSignal
    strategy.entry("REV SHORT", strategy.short)

if is5M
    strategy.exit("REV SHORT X", from_entry = "REV SHORT", profit = tpTicks, loss = slTicks)

// ── Display ──
bool  inPos   = strategy.position_size < 0
float entryPx = inPos ? strategy.position_avg_price : na
plot(showLvls ? entryPx : na, "Entry", color = color.new(color.gray, 0), style = plot.style_linebr, linewidth = 1)
plot(showLvls and inPos ? entryPx - tpTicks * syminfo.mintick : na, "TP", color = color.new(color.lime, 0), style = plot.style_linebr, linewidth = 1)
plot(showLvls and inPos ? entryPx + slTicks * syminfo.mintick : na, "SL", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 1)

var table tfTbl = table.new(position.top_right, 1, 1)
if barstate.islast and not is5M
    table.cell(tfTbl, 0, 0, "5M ONLY", text_color = color.white, bgcolor = color.new(color.red, 20), text_size = size.small)

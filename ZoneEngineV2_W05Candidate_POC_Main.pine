//@version=6
// W05 B14R R0B: imported CandidateStore held in an exported host type (POC only).
library("ZoneEngineV2_W05Candidate_POC_Main", overlay = false)

import sekine3310/ZoneEngineV2_W05Candidate_POC_Worker/1 as W05Cand

export type HostState
    W05Cand.CandidateStore candidateStore
    int marker = 0

export newHost() =>
    HostState.new(W05Cand.newStore(), 7)

export logicalCount(HostState host) =>
    W05Cand.probeLogicalCount(host.candidateStore)

export markerValue(HostState host) =>
    host.marker

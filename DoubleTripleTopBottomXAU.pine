// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  Double / Triple Top Bottom XAU (DTB-1)  —  XAUUSD 5分足・ダブル / トリプル トップ・ボトム早期検知の単体インジケーター
//
//  抽出元: AccumStrategyXAU.pine の ACC-5B (ブランチ claude/vibrant-turing-80o0xg の b109d91 = 抽出時の先端 1f16f48 と同一の
//    AccumStrategyXAU.pine)。(B3d) の検知器 (足の取り込み → 山・谷の基準 → 各基準 ① 無効化 → ② 反転待ち → ③ 接近 → ④ 離れ幅 → 削除)
//    を、比較演算子・EPS・ループ順・初期値・設定範囲を変えずに写した。検知ロジックの変更・改善はしていない。
//  持ち込まないもの: Accum・FVG・Zone・候補選択・注文・SL / TP / BE・資金管理・注文時間帯・ポジション、P5 / P6 待機への根拠保存と
//    その有効期限 (dvEvLife)、モジュール ON / OFF (dvUse)、集計カウンタ・集計表、同じ足の検知を 1 個のラベルへまとめる代表表示。
//  動作は元コードと同じ:
//    ・5分足チャート専用 (それ以外の時間足では何もしない)。接近・反転・無効化はすべて 5分足で判定する。
//    ・上位足 (15分 / 1時間 / 4時間 / 日足) は確定した 1 本を [1]・lookahead_on で受け取り、time が変わったときだけ取り込む。
//    ・山・谷は確認足 (右側 N 本) が揃った時点で登録し、登録した足の次の 5分足から監視する (登録足では接近・反転を見ない)。
//    ・判定は確定した 5分足だけ (形成中の足では検知状態もラベルも変えない)。
//    ・検知 = アキュムへの接触や待機の有無に関係なく、発生したすべての検知 (時間足・基準ごと) を表示する。
//
//  表示の見方 (#番号 = 基準 ID。すべての表示に ID と基準の時間足を付ける):
//    ・灰色の吹き出し「基準#ID 時間足 山 / 谷 価格」: 1 回目 = 基準となった実際の山・谷の足 (上位足ならその上位足の開始時刻) と価格。
//      基準が利用可能になった後に描く「基準位置の注記」で、この足でシグナルが出たという意味ではない。
//    ・灰色の「#ID 登録」と点線: Pivot が確定して検知器へ登録された (利用可能になった) 5分足。監視はこの次の足から。
//    ・◆「#ID 2回目 / 3回目」: 実際に接近を数えた 5分足。価格はトップならその足の高値、ボトムなら安値 (基準価格とは別)。
//      下の行が結果 (反転待ち / 検知 / 期限切れ / 無効化)。基準の山・谷から各接近点へ破線を引く。
//    ・「ダブルトップ 15分」などの吹き出し: 反転を検知した実際の 5分足 (接近足と同じ足なら同じ足に重なる)。
//      同じ足に複数の検知があれば、すべて縦に並べて表示する (代表 1 個にまとめない)。
//  表示設定は描画だけを変える (時間足ごとの表示 OFF・描画を残す基準数でも、検知処理と有効な基準は変わらない)。
//  上位足の山・谷の時刻: 元コードの DvBase.pTime には窓の中央足ではなく、取り込んだ (最新の) 足の time が入っている。
//    検知には使われていないため元のまま残し、描画専用の時刻履歴 (DvTs) から中央足の実際の time を取る。
// ============================================================================

//@version=5
indicator("Double / Triple Top Bottom XAU", shorttitle = "DTB-XAU", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ---- 5分足専用 (元コードと同じ判定) ---------------------------------------------
bool is5mChart = timeframe.isminutes and timeframe.multiplier == 5

// ============================================================================
// 01. INPUTS
// ============================================================================
var string G_DV = "1 · ダブル / トリプル トップ・ボトム (AccumStrategyXAU.pine ACC-5B と同じ検知)"
dvPiv    = input.int(2, "山・谷の前後の本数", minval = 1, group = G_DV,
     tooltip = "左右この本数の足より高値が厳密に高い足を山、安値が厳密に低い足を谷にする (同値は山・谷にしない)。全時間足で共通。")
dvWait   = input.int(3, "反転待ちの本数", minval = 0, group = G_DV,
     tooltip = "接近足 = 0 本目。接近足とその後この本数までの 5分足で、最初の陰線 (トップ) / 陽線 (ボトム) の確定を待つ。")
dvB0 = input.float(2.0,  "5分足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD0 = input.float(6.0,  "5分足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvB1 = input.float(3.0,  "15分足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD1 = input.float(9.0,  "15分足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvB2 = input.float(5.0,  "1時間足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD2 = input.float(15.0, "1時間足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvB3 = input.float(10.0, "4時間足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD3 = input.float(30.0, "4時間足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvB4 = input.float(20.0, "日足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD4 = input.float(60.0, "日足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV,
     tooltip = "検証開始用の仮初期値 (時間足ごとに buffer と最低離れ幅を独立に設定)。")

var string G_DS = "2 · 表示 (描画だけ。検知処理と有効な基準は変わらない)"
dsTf0    = input.bool(true, "5分足の基準を表示", group = G_DS)
dsTf1    = input.bool(true, "15分足の基準を表示", group = G_DS)
dsTf2    = input.bool(true, "1時間足の基準を表示", group = G_DS)
dsTf3    = input.bool(true, "4時間足の基準を表示", group = G_DS)
dsTf4    = input.bool(true, "日足の基準を表示", group = G_DS,
     tooltip = "OFF: その時間足の基準・接近・検知を描かない (検知処理と有効な基準の監視は続ける)。")
dsAllB   = input.bool(false, "接近がない基準の注記も表示", group = G_DS,
     tooltip = "OFF: 2 回目の接近を数えた基準だけ、その接近足で基準位置・登録足の注記を描く。ON: 登録した足ですべての基準の注記を描く。")
dsMaxGrp = input.int(40, "描画を残す基準の最大数", minval = 1, maxval = 80, group = G_DS,
     tooltip = "基準ごとの描画 (注記・接近点・線・検知ラベル) を、最後に描いた順で古いものから削除する。内部の有効な基準は削除しない。")
dsTz     = input.string("Asia/Tokyo", "ラベルの時刻のタイムゾーン", group = G_DS)

// ============================================================================
// 02. DATA
// ============================================================================
// 15分 / 1時間 / 4時間 / 日足の確定した 1 本 (上位足の中で [1]・lookahead_on。届くのは確定した足だけ) — 元コードと同一
[dvh1, dvl1, dvt1] = request.security(syminfo.tickerid, "15",  [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh2, dvl2, dvt2] = request.security(syminfo.tickerid, "60",  [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh3, dvl3, dvt3] = request.security(syminfo.tickerid, "240", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh4, dvl4, dvt4] = request.security(syminfo.tickerid, "D",   [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)

// 表示専用: 同じ足に複数の検知ラベルを縦にずらす幅 (検知には使わない)
float dsAtr = ta.atr(14)

// ============================================================================
// 03. LOGIC
// ============================================================================
// ==== DTB Logic (begin) ======================================================
//  (この区間は tests/dtb_sim.py が tests/acc_pine.py の変換器で Python へ機械変換して実行する)
float EPS = 1e-7     // 浮動小数の誤差だけ吸収 (USD) — 元コードと同一

// 時間足ごとの直近 (2N + 1) 本の高値・安値 (山・谷の判定用) — 元コードと同一
type DvTf
    array<float> hs
    array<float> ls
    int   lastT               // 最後に取り込んだ足の time

// ダブル / トリプルの基準 (山 = トップ / 谷 = ボトム) — 元コードと同一 (pTime の中身も元コードのまま)
type DvBase
    int   id
    int   tf
    int   side                // -1 = トップ (H、SHORT 側) / 1 = ボトム (L、LONG 側)
    float lvl
    int   pTime               // 山・谷の足の time
    int   aBar                // 基準が届いた (使えるようになった) 5分足
    bool  away                // 最低離れ幅を満たしている (次の接近を数えられる)
    int   cnt      = 1        // 接近回数 (山・谷そのものが 1 回目)
    bool  waiting  = false    // 接近後の反転待ち
    int   appBar
    int   waitEnd             // 反転待ちの最後の足

// 描画専用: DvTf.hs / ls と同じ並びの各足の time (中央足 = 実際の山・谷の足の time を取るため)
type DvTs
    array<int> ts

// 描画専用: 基準 1 個の表示 (dvBases と同じ並びで持つ。検知処理からは読まない)
type DvDr
    int    id
    int    tf
    int    side
    float  lvl
    int    pvT                // 実際の山・谷の足の time (上位足はその上位足の開始時刻)
    int    avT                // 利用可能になった (登録した) 5分足の time
    bool   shown    = false   // 描画を保持している
    array<label> lbs
    array<line>  lns
    label  apLb               // 最新の接近マーカー (結果の表示を更新する)
    string apTx
    int    apT                // 最新の接近足の time
    float  apP                // 最新の接近足の高値 (トップ) / 安値 (ボトム)
    int    apCnt              // 最新の接近の回数 (2 / 3)

var array<DvTf>   dvTfs   = array.new<DvTf>()
var array<DvBase> dvBases = array.new<DvBase>()
var int dvSeq = 0
var array<DvTs>   dvTss   = array.new<DvTs>()     // 描画専用
var array<DvDr>   dvDrs   = array.new<DvDr>()     // 描画専用 (dvBases と同じ並び)
var array<DvDr>   dvDrQ   = array.new<DvDr>()     // 描画専用: 描画を保持している基準 (最後に描いた順)

f_tfJa(int k) =>
    k == 0 ? "5分" : k == 1 ? "15分" : k == 2 ? "1時間" : k == 3 ? "4時間" : "日足"

f_dsOn(int k) =>
    k == 0 ? dsTf0 : k == 1 ? dsTf1 : k == 2 ? dsTf2 : k == 3 ? dsTf3 : dsTf4

f_tm(int t) =>
    str.format_time(t, "MM/dd HH:mm", dsTz)

f_baseTx(DvDr r) =>
    "基準#" + str.tostring(r.id) + " " + f_tfJa(r.tf) + "足 " + (r.side == -1 ? "山 " : "谷 ") + str.tostring(r.lvl, "#.##")

// 描画の保持: 初めてなら基準位置・登録足の注記を描いて末尾へ、既に保持していれば末尾へ移す。上限を超えたら古い描画を削除
//  (削除するのは描画オブジェクトだけ。dvBases / dvDrs の内部状態には触れない)
f_grpOpen(DvDr r) =>
    if r.shown
        int n  = array.size(dvDrQ)
        int ix = -1
        if n > 0
            for i = 0 to n - 1
                DvDr q = array.get(dvDrQ, i)
                if ix < 0 and q.id == r.id
                    ix := i
        if ix >= 0
            array.remove(dvDrQ, ix)
        array.push(dvDrQ, r)
    else
        bool top = r.side == -1
        r.shown := true
        r.lbs   := array.new<label>()
        r.lns   := array.new<line>()
        r.apLb  := na
        array.push(r.lbs, label.new(r.pvT, r.lvl, f_baseTx(r), xloc = xloc.bar_time,
             style = top ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 55), textcolor = color.white,
             size = size.tiny, tooltip = f_baseTx(r) + "\n基準の足 " + f_tm(r.pvT) + " (1 回目)\n利用可能になった 5分足 " + f_tm(r.avT) +
             "\n(基準が利用可能になった後に描いた注記。この足のシグナルではない)"))
        array.push(r.lbs, label.new(r.avT, r.lvl, "#" + str.tostring(r.id) + " " + f_tfJa(r.tf) + " 登録", xloc = xloc.bar_time,
             style = label.style_label_left, color = color.new(color.gray, 75), textcolor = color.white, size = size.tiny,
             tooltip = f_baseTx(r) + "\n登録 (利用可能になった 5分足) " + f_tm(r.avT) + "\n監視はこの次の 5分足から"))
        array.push(r.lns, line.new(r.pvT, r.lvl, r.avT, r.lvl, xloc = xloc.bar_time, color = color.new(color.gray, 40),
             style = line.style_dotted, width = 1))
        array.push(dvDrQ, r)
        while array.size(dvDrQ) > dsMaxGrp
            DvDr o = array.shift(dvDrQ)
            int nl = array.size(o.lbs)
            if nl > 0
                for j = 0 to nl - 1
                    label.delete(array.get(o.lbs, j))
            int nn = array.size(o.lns)
            if nn > 0
                for j = 0 to nn - 1
                    line.delete(array.get(o.lns, j))
            o.shown := false
            o.apLb  := na
    r.shown

// 接近マーカー (実際に接近を数えた 5分足・その足の高値 / 安値) と、基準の山・谷からの線
f_drApp(DvDr r, string st) =>
    f_grpOpen(r)
    bool top = r.side == -1
    r.apTx := "#" + str.tostring(r.id) + " " + f_tfJa(r.tf) + " " + str.tostring(r.apCnt) + "回目"
    r.apLb := label.new(r.apT, r.apP, r.apTx + "\n" + st, xloc = xloc.bar_time, style = label.style_diamond,
         color = top ? color.new(color.red, 0) : color.new(color.green, 0), textcolor = top ? color.red : color.green, size = size.tiny,
         tooltip = f_baseTx(r) + "\n" + str.tostring(r.apCnt) + " 回目の接近 " + f_tm(r.apT) + (top ? " 高値 " : " 安値 ") +
         str.tostring(r.apP, "#.##"))
    array.push(r.lbs, r.apLb)
    array.push(r.lns, line.new(r.pvT, r.lvl, r.apT, r.apP, xloc = xloc.bar_time, color = top ? color.new(color.red, 30) :
         color.new(color.green, 30), style = line.style_dashed, width = 1))
    r.shown

// 接近マーカーの結果表示 (描画を保持していて、その接近のマーカーがある場合だけ)
f_drStat(DvDr r, string st) =>
    if r.shown and not na(r.apLb)
        label.set_text(r.apLb, r.apTx + "\n" + st)
    r.shown

// 検知ラベル (反転を検知した実際の 5分足)
f_drDet(DvDr r, int cnt, int lag, float y) =>
    f_grpOpen(r)
    bool   top = r.side == -1
    string nm  = (cnt == 2 ? "ダブル" : "トリプル") + (top ? "トップ" : "ボトム") + " " + f_tfJa(r.tf)
    array.push(r.lbs, label.new(time, y, nm + "\n#" + str.tostring(r.id) + " " + str.tostring(cnt) + "回目", xloc = xloc.bar_time,
         style = top ? label.style_label_down : label.style_label_up, color = top ? color.new(color.red, 15) : color.new(color.green, 15),
         textcolor = color.white, size = size.small,
         tooltip = nm + "\n" + f_baseTx(r) + "\n基準の足 " + f_tm(r.pvT) + " / 登録 " + f_tm(r.avT) + "\n" + str.tostring(cnt) +
         " 回目の接近 " + f_tm(r.apT) + (top ? " 高値 " : " 安値 ") + str.tostring(r.apP, "#.##") + "\n検知 " + f_tm(time) +
         (lag == 0 ? " (接近足で検知)" : " (接近足から " + str.tostring(lag) + " 本目)")))
    f_drStat(r, "検知")

bool acRun = is5mChart

if acRun
    if barstate.isconfirmed
        // ACC-5B ダブル / トリプル: 足の取り込み → 山・谷の基準 → 各基準 (無効化 → 反転待ち → 接近 → 離れ幅)
        //  元コード (B3d) の検知器。P5 / P6 根拠・集計・代表ラベルは除き、描画専用の処理 (dvTss / dvDrs / f_dr*) だけを加えた
        if array.size(dvTfs) == 0
            for k = 0 to 4
                array.push(dvTfs, DvTf.new(array.new_float(), array.new_float(), na))
        if array.size(dvTss) == 0
            for k = 0 to 4
                array.push(dvTss, DvTs.new(array.new_int()))
        int dvW = 2 * dvPiv + 1
        array<float> fH = array.from(high, dvh1, dvh2, dvh3, dvh4)
        array<float> fL = array.from(low, dvl1, dvl2, dvl3, dvl4)
        array<int>   fT = array.from(time, dvt1, dvt2, dvt3, dvt4)
        for k = 0 to 4
            int   nt = array.get(fT, k)
            float nh = array.get(fH, k)
            float nl = array.get(fL, k)
            DvTf  tw = array.get(dvTfs, k)
            DvTs  tt = array.get(dvTss, k)
            if not na(nt) and not na(nh) and not na(nl) and (na(tw.lastT) or nt != tw.lastT)
                tw.lastT := nt
                array.push(tw.hs, nh)
                array.push(tw.ls, nl)
                array.push(tt.ts, nt)
                if array.size(tw.hs) > dvW
                    array.shift(tw.hs)
                    array.shift(tw.ls)
                while array.size(tt.ts) > array.size(tw.hs)
                    array.shift(tt.ts)
                if array.size(tw.hs) == dvW
                    float mh = array.get(tw.hs, dvPiv)
                    float ml = array.get(tw.ls, dvPiv)
                    bool  isH = true
                    bool  isL = true
                    float rMin = na
                    float rMax = na
                    for j = 0 to dvW - 1
                        if j != dvPiv
                            isH := isH and mh > array.get(tw.hs, j)
                            isL := isL and ml < array.get(tw.ls, j)
                        if j > dvPiv
                            rMin := na(rMin) ? array.get(tw.ls, j) : math.min(rMin, array.get(tw.ls, j))
                            rMax := na(rMax) ? array.get(tw.hs, j) : math.max(rMax, array.get(tw.hs, j))
                    // 上位足は届いた 5分足 (確認足の後) の値動きも離れ幅に含める。5分足では今の足が最後の確認足
                    if k > 0
                        rMin := math.min(rMin, low)
                        rMax := math.max(rMax, high)
                    float dD = k == 0 ? dvD0 : k == 1 ? dvD1 : k == 2 ? dvD2 : k == 3 ? dvD3 : dvD4
                    int   pvT = array.get(tt.ts, dvPiv)     // 描画専用: 中央足 (実際の山・谷の足) の time
                    if isH
                        dvSeq += 1
                        array.push(dvBases, DvBase.new(dvSeq, k, -1, mh, nt, bar_index, mh - rMin >= dD - EPS))
                        DvDr rh = DvDr.new(dvSeq, k, -1, mh, pvT, time)
                        array.push(dvDrs, rh)
                        if dsAllB and f_dsOn(k)
                            f_grpOpen(rh)
                    if isL
                        dvSeq += 1
                        array.push(dvBases, DvBase.new(dvSeq, k, 1, ml, nt, bar_index, rMax - ml >= dD - EPS))
                        DvDr rl = DvDr.new(dvSeq, k, 1, ml, pvT, time)
                        array.push(dvDrs, rl)
                        if dsAllB and f_dsOn(k)
                            f_grpOpen(rl)
        int   ng   = array.size(dvBases)
        int   dsKT = 0      // 表示専用: この足で描いたトップ / ボトム検知ラベルの数 (縦に並べる)
        int   dsKB = 0
        float dsOf = nz(dsAtr, high - low) * 0.9
        if ng > 0
            for i = ng - 1 to 0
                DvBase g = array.get(dvBases, i)
                DvDr   r = array.get(dvDrs, i)
                if g.aBar < bar_index
                    float bB  = g.tf == 0 ? dvB0 : g.tf == 1 ? dvB1 : g.tf == 2 ? dvB2 : g.tf == 3 ? dvB3 : dvB4
                    float bD  = g.tf == 0 ? dvD0 : g.tf == 1 ? dvD1 : g.tf == 2 ? dvD2 : g.tf == 3 ? dvD3 : dvD4
                    bool  top = g.side == -1
                    bool  fin = false
                    bool  dsV = f_dsOn(g.tf)
                    // ① 無効化 (終値が H + B を超える / L − B を下回る。ヒゲ・ちょうどは許容)。反転より優先
                    if top ? close > g.lvl + bB + EPS : close < g.lvl - bB - EPS
                        fin := true
                        if dsV and g.waiting
                            f_drStat(r, "無効化")
                    else
                        bool det  = false
                        bool dApp = false
                        bool rev  = top ? close < open : close > open
                        if g.waiting
                            // ② 反転待ち: 最初の陰線 (陽線) で検知、最後の足を過ぎたら見送り (接近 1 回に数えたまま)
                            if rev
                                det := true
                                g.waiting := false
                            else if bar_index >= g.waitEnd
                                g.waiting := false
                                if dsV
                                    f_drStat(r, "期限切れ")
                            fin := not g.waiting and g.cnt >= 3
                        else if g.away and g.cnt < 3 and (top ? high >= g.lvl - bB - EPS : low <= g.lvl + bB + EPS)
                            // ③ 接近 (2 回目・3 回目)。接近足が陰線 (陽線) ならこの足で検知、違えば反転待ち
                            g.cnt    += 1
                            g.away   := false
                            g.appBar := bar_index
                            g.waitEnd := bar_index + dvWait
                            r.apT   := time
                            r.apP   := top ? high : low
                            r.apCnt := g.cnt
                            if rev
                                det  := true
                                dApp := true
                            else if dvWait > 0
                                g.waiting := true
                            if dsV
                                f_drApp(r, rev ? "検知" : dvWait > 0 ? "反転待ち" : "期限切れ")
                            fin := not g.waiting and g.cnt >= 3
                        if det
                            // 検知: すべての検知を個別に表示する (時間足・基準ごと。同じ足の検知も間引かない)
                            if dsV
                                f_drDet(r, g.cnt, bar_index - g.appBar, top ? high + dsKT * dsOf : low - dsKB * dsOf)
                                dsKT += top ? 1 : 0
                                dsKB += top ? 0 : 1
                        // ④ 最低離れ幅 (この足の終わりに更新。次の接近は次の足から)。接近足自身の値幅は数えない
                        //    (足の中で接近と離れ幅の順序が分からないため。離れ幅は接近の後の足で満たす)
                        if not fin and (na(g.appBar) or g.appBar != bar_index) and (top ? low <= g.lvl - bD + EPS : high >= g.lvl + bD - EPS)
                            g.away := true
                    if fin
                        array.remove(dvBases, i)
                        array.remove(dvDrs, i)
// ==== DTB Logic (end) ========================================================

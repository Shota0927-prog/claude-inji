//@version=6
// ============================================================
// ZoneEngineV2_CurrentVisualHarness - Pre-W09 Visual Support V03D-B (current physical Core geometry, lazy hidden-engine
// facade, 14-day Engine runtime window, CoreView snapshot on the last bar only)
//
// Display only. Cfg / Feed: the Main /25 public API (newCfg / newFeed) with the Production Feed contract of
// ZoneEngineV2_Rebuild_W03Harness (B29: the same Source packets and request contexts, all 110 Feed fields, one update per
// confirmed 5m bar). Engine: hidden inside the Main /25 lazy facade ZE.visualStepAndCoreViews (single global callsite,
// called on every bar; its engine state is per callsite). Geometry authority: the CoreView array returned by that facade
// on the last bar only (coreId, generationId,
// createdTime, physicalBottom, physicalTop, hasSupport, hasResistance). No Zone / Candidate /
// Pairing / Identity / Merge / Split / State / Fresh computation here, no Worker function / field use, nothing written back.
// Layer 1 Geometry only; W09_STATE_STYLE_HOOK / W10_LIFECYCLE_STYLE_HOOK mark where State / Lifecycle styling connects.
// CoreView = physical geometry; ZoneView (Side State projection) is not used for geometry.
// ============================================================
indicator("ZoneEngineV2 Current Visual Harness", overlay = true, max_boxes_count = 100, max_labels_count = 100, calc_bars_count = 5000)
import sekine3310/ZoneEngineV2_Rebuild/25 as ZE

// ---- Visual inputs (display only; never passed to the Engine) ----
visualMaxZones   = input.int(20, "Max zones displayed", minval = 1, maxval = 50, group = "Visual")
useMaxDistance   = input.bool(false, "Hide zones farther than max distance", group = "Visual")
maxDistanceUsd   = input.float(100.0, "Max distance (price units)", minval = 0.0, group = "Visual")
showLabels       = input.bool(true, "Show labels", group = "Visual")
supportColor     = input.color(#26a69a, "Support only", group = "Visual")
resistanceColor  = input.color(#ef5350, "Resistance only", group = "Visual")
dualColor        = input.color(#9575cd, "Support + Resistance", group = "Visual")
zoneTransparency = input.int(80, "Zone transparency", minval = 0, maxval = 100, group = "Visual")
borderWidth      = input.int(1, "Border width", minval = 1, maxval = 5, group = "Visual")

// ---- Source inputs ----
emaSlopeLookback = input.int(60, "EMA slope lookback", minval = 1, group = "Source")
swingLen5m       = input.int(10, "Swing length 5m",    minval = 1, group = "Source")
swingLen15m      = input.int(8,  "Swing length 15m",   minval = 1, group = "Source")
swingLen1h       = input.int(6,  "Swing length 1h",    minval = 1, group = "Source")

// ---- Accum inputs (the 1H / 4H / D contexts are fixed in B29) ----
accumRangeLen        = input.int(10, "Accum range length", minval = 2, group = "Accum")
accumBaseLen         = input.int(20, "Accum base length", minval = 2, group = "Accum")
accumAtrLen          = input.int(14, "Accum ATR length", minval = 1, group = "Accum")
accumMinUpperCloses  = input.int(4, "Accum min upper closes", minval = 0, group = "Accum")
accumMinLowerCloses  = input.int(4, "Accum min lower closes", minval = 0, group = "Accum")
accumMaxSameColorRun = input.int(4, "Accum max same-color run", minval = 1, group = "Accum")
accumAtrMult         = input.float(2.5, "Accum ATR multiplier", minval = 0.1, group = "Accum")
accumBarRatioMax     = input.float(0.70, "Accum bar ratio max", minval = 0.1, group = "Accum")
accumDriftMax        = input.float(0.30, "Accum drift max", minval = 0.0, group = "Accum")

// MA Source packet, evaluated in the 1m context (B29 request). EMA 2000 / 3000 of close
// and their raw deltas over `lookback` bars; native na during warmup.
// Returns [maSourceOpenTime, maSourceCloseTime, ema2000, ema2000Slope, ema3000, ema3000Slope].
maPackV2(simple int lookback) =>
    float ema2000Value = ta.ema(close, 2000)
    float ema3000Value = ta.ema(close, 3000)
    float ema2000Slope = ema2000Value - ema2000Value[lookback]
    float ema3000Slope = ema3000Value - ema3000Value[lookback]
    [time, time_close, ema2000Value, ema2000Slope, ema3000Value, ema3000Slope]

// Swing Source event packet, evaluated in the 5m / 15m / 1h context. A pivot confirmed
// on this bar (len bars each side) carries its price, the pivot bar's open / close time
// and this bar's close time; no pivot -> na (an event, never a carried state).
// Returns [highPrice, highOriginTime, highOriginEndTime, highConfirmedTime,
//          lowPrice,  lowOriginTime,  lowOriginEndTime,  lowConfirmedTime].
pivotPackV2(simple int len) =>
    float pivotHigh = ta.pivothigh(high, len, len)
    float pivotLow  = ta.pivotlow(low, len, len)
    bool  hasHigh   = not na(pivotHigh)
    bool  hasLow    = not na(pivotLow)
    float highPrice         = hasHigh ? pivotHigh : na
    int   highOriginTime    = hasHigh ? time[len] : int(na)
    int   highOriginEndTime = hasHigh ? time_close[len] : int(na)
    int   highConfirmedTime = hasHigh ? time_close : int(na)
    float lowPrice          = hasLow ? pivotLow : na
    int   lowOriginTime     = hasLow ? time[len] : int(na)
    int   lowOriginEndTime  = hasLow ? time_close[len] : int(na)
    int   lowConfirmedTime  = hasLow ? time_close : int(na)
    [highPrice, highOriginTime, highOriginEndTime, highConfirmedTime, lowPrice, lowOriginTime, lowOriginEndTime, lowConfirmedTime]

// Accum condition on this Source bar. The window is the last rangeLen bodies (open /
// close ends, never wicks); one rangeMid for the whole window. Native na / history
// semantics; no fill, no custom warmup. Returns [isAccum, rangeHigh, rangeLow].
accumCondV2(simple int rangeLen, simple int baseLen, simple int atrLen, simple int minUpper, simple int minLower, simple int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    float bodyTop   = math.max(open, close)
    float bodyBot   = math.min(open, close)
    float rangeHigh = ta.highest(bodyTop, rangeLen)
    float rangeLow  = ta.lowest(bodyBot, rangeLen)
    float rangeNow  = rangeHigh - rangeLow
    float rangeMid  = (rangeHigh + rangeLow) * 0.5
    float rangeBase = ta.highest(bodyTop, baseLen) - ta.lowest(bodyBot, baseLen)
    float atrValue  = ta.atr(atrLen)
    int upperCloses = 0
    int lowerCloses = 0
    int bullRun     = 0
    int bearRun     = 0
    int maxBullRun  = 0
    int maxBearRun  = 0
    for i = 0 to rangeLen - 1
        if close[i] > rangeMid
            upperCloses += 1
        else if close[i] < rangeMid
            lowerCloses += 1
        if close[i] > open[i]
            bullRun += 1
            bearRun := 0
        else if close[i] < open[i]
            bearRun += 1
            bullRun := 0
        else
            bullRun := 0
            bearRun := 0
        maxBullRun := math.max(maxBullRun, bullRun)
        maxBearRun := math.max(maxBearRun, bearRun)
    float startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    float endMid   = (open + close) * 0.5
    float drift    = math.abs(endMid - startMid)
    bool condAtr      = atrValue > 0 and rangeNow <= atrValue * atrMult
    bool condBar      = rangeBase > 0 and rangeNow <= rangeBase * barRatioMax
    bool condBalance  = upperCloses >= minUpper and lowerCloses >= minLower
    bool condDrift    = rangeNow > 0 and drift / rangeNow <= driftMax
    bool condColorRun = maxBullRun <= maxRun and maxBearRun <= maxRun
    bool isAccum = condAtr and condBar and condBalance and condDrift and condColorRun
    [isAccum, rangeHigh, rangeLow]

// Accum Source packet (1H / 4H / D context, B29). A Candidate state machine local to
// this helper (not a Root): false -> true starts it on the window's body range, true ->
// true widens it with the current body, true -> false emits the Candidate once as a
// Confirmed Box (the ending bar is not part of it) and resets. Event values are this
// bar only. Returns [newConfirmedBox, boxTop, boxBottom, boxId, candidateStartTime,
// confirmedTime, candidateActive, candidateTop, candidateBottom].
accumPackV2(simple int rangeLen, simple int baseLen, simple int atrLen, simple int minUpper, simple int minLower, simple int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    [isAccum, rangeHigh, rangeLow] = accumCondV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    var bool  candidateActive    = false
    var float candidateTop       = na
    var float candidateBottom    = na
    var int   candidateStartTime = na
    bool  newConfirmedBox       = false
    float boxTop                = na
    float boxBottom             = na
    int   boxId                 = 0
    int   confirmedTime         = na
    int   candidateStartTimeOut = na
    if isAccum and not candidateActive
        candidateActive    := true
        candidateStartTime := time
        candidateTop       := rangeHigh
        candidateBottom    := rangeLow
        candidateStartTimeOut := candidateStartTime
    else if isAccum and candidateActive
        float currentBodyTop    = math.max(open, close)
        float currentBodyBottom = math.min(open, close)
        candidateTop    := math.max(candidateTop, currentBodyTop)
        candidateBottom := math.min(candidateBottom, currentBodyBottom)
        candidateStartTimeOut := candidateStartTime
    else if not isAccum and candidateActive
        newConfirmedBox       := true
        boxTop                := candidateTop
        boxBottom             := candidateBottom
        boxId                 := candidateStartTime
        confirmedTime         := time_close
        candidateStartTimeOut := candidateStartTime
        candidateActive    := false
        candidateTop       := na
        candidateBottom    := na
        candidateStartTime := na
    [newConfirmedBox, boxTop, boxBottom, boxId, candidateStartTimeOut, confirmedTime, candidateActive, candidateTop, candidateBottom]

// FVG Source fact packet (1H / 4H / D context, B29). This bar is the third bar: Bull
// low > high[2] (NativeRange high[2] -> low), Bear high < low[2] (NativeRange high ->
// low[2]), strict; no event -> na ranges. Fresh and structural invalidation belong to
// the Production. Returns [srcOpenTime, srcCloseTime, bullNew, bullBottom, bullTop,
// bearNew, bearBottom, bearTop, high, low, close].
fvgPackV2() =>
    bool  bullNew    = low > high[2]
    float bullBottom = bullNew ? high[2] : na
    float bullTop    = bullNew ? low : na
    bool  bearNew    = high < low[2]
    float bearBottom = bearNew ? high : na
    float bearTop    = bearNew ? low[2] : na
    [time, time_close, bullNew, bullBottom, bullTop, bearNew, bearBottom, bearTop, high, low, close]

// ---- B29 request wrappers : destructure the helpers above and flatten them in Feed order ----
// 15m Swing context. Returns [srcOpenTime, srcCloseTime, High x4, Low x4] (10).
pivotSourcePackV2(simple int len) =>
    [highPrice, highOriginTime, highOriginEndTime, highConfirmedTime, lowPrice, lowOriginTime, lowOriginEndTime, lowConfirmedTime] = pivotPackV2(len)
    [time, time_close, highPrice, highOriginTime, highOriginEndTime, highConfirmedTime, lowPrice, lowOriginTime, lowOriginEndTime, lowConfirmedTime]

// 1H context : Swing + Accum + FVG + Source H/L/C (28), Source times and H/L/C from fvgPackV2.
htf1hPackV2(simple int swingLen, simple int rangeLen, simple int baseLen, simple int atrLen, simple int minUpper, simple int minLower, simple int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    [swingHighPrice, swingHighOriginTime, swingHighOriginEndTime, swingHighConfirmedTime, swingLowPrice, swingLowOriginTime, swingLowOriginEndTime, swingLowConfirmedTime] = pivotPackV2(swingLen)
    [accumNewConfirmedBox, accumBoxTop, accumBoxBottom, accumBoxId, accumCandidateStartTime, accumConfirmedTime, accumCandidateActive, accumCandidateTop, accumCandidateBottom] = accumPackV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [srcOpenTime, srcCloseTime, fvgBullNew, fvgBullBottom, fvgBullTop, fvgBearNew, fvgBearBottom, fvgBearTop, htfHigh, htfLow, htfClose] = fvgPackV2()
    [srcOpenTime, srcCloseTime, swingHighPrice, swingHighOriginTime, swingHighOriginEndTime, swingHighConfirmedTime, swingLowPrice, swingLowOriginTime, swingLowOriginEndTime, swingLowConfirmedTime, accumNewConfirmedBox, accumBoxTop, accumBoxBottom, accumBoxId, accumCandidateStartTime, accumConfirmedTime, accumCandidateActive, accumCandidateTop, accumCandidateBottom, fvgBullNew, fvgBullBottom, fvgBullTop, fvgBearNew, fvgBearBottom, fvgBearTop, htfHigh, htfLow, htfClose]

// 4H / D context : Accum + FVG + Source H/L/C (20), Source times and H/L/C from fvgPackV2.
htfPackV2(simple int rangeLen, simple int baseLen, simple int atrLen, simple int minUpper, simple int minLower, simple int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    [accumNewConfirmedBox, accumBoxTop, accumBoxBottom, accumBoxId, accumCandidateStartTime, accumConfirmedTime, accumCandidateActive, accumCandidateTop, accumCandidateBottom] = accumPackV2(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [srcOpenTime, srcCloseTime, fvgBullNew, fvgBullBottom, fvgBullTop, fvgBearNew, fvgBearBottom, fvgBearTop, htfHigh, htfLow, htfClose] = fvgPackV2()
    [srcOpenTime, srcCloseTime, accumNewConfirmedBox, accumBoxTop, accumBoxBottom, accumBoxId, accumCandidateStartTime, accumConfirmedTime, accumCandidateActive, accumCandidateTop, accumCandidateBottom, fvgBullNew, fvgBullBottom, fvgBullTop, fvgBearNew, fvgBearBottom, fvgBearTop, htfHigh, htfLow, htfClose]

// ---- 5m chart context : the 5m Swing packet (B29 puts these eight values into the Feed) ----
[swing5mHighPrice, swing5mHighOriginTime, swing5mHighOriginEndTime, swing5mHighConfirmedTime, swing5mLowPrice, swing5mLowOriginTime, swing5mLowOriginEndTime, swing5mLowConfirmedTime] = pivotPackV2(swingLen5m)

// ---- V03C runtime window (Visual execution policy only; no Production / Source semantics change) ----
// The facade Engine is built only from the last ENGINE_WINDOW_DAYS calendar days of confirmed 5m bars. RUNTIME / DISPLAY
// gate, not full current-zone parity: Roots created before the window (e.g. older 4H / D structure) are not reproduced.
const int ENGINE_WINDOW_DAYS = 14
const int MS_PER_DAY         = 86400000
// Per-request history (bars of the requested timeframe) = window bars at 24/7 density + the longest lookback + margin.
// 1m  : EMA 3000 warmup + slope lookback (input) -> 14*1440 + 3000 + lookback + 780 (24000 at lookback 60)
// 15m : pivot 2*len+1 (17 at len 8)                       -> 1344 + 17  <= 1500
// 1H  : max(pivot 13, accum base 20, ATR 14, range 10)    -> 336  + 20  <= 450
// 4H  : max(accum base 20, ATR 14, range 10, FVG 3)       -> 84   + 20  <= 130
// D   : max(accum base 20, ATR 14, range 10, FVG 3)       -> 14   + 20  <= 45
int calcBars1m = ENGINE_WINDOW_DAYS * 1440 + 3000 + emaSlopeLookback + 780

// ---- B29 : the five Source request contexts (chart symbol, gaps off, lookahead off) ----
[maSourceOpenTime, maSourceCloseTime, ema2000Value, ema2000SlopeValue, ema3000Value, ema3000SlopeValue] = request.security(syminfo.tickerid, "1", maPackV2(emaSlopeLookback), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = calcBars1m)
[src15mOpenTime, src15mCloseTime, swing15mHighPrice, swing15mHighOriginTime, swing15mHighOriginEndTime, swing15mHighConfirmedTime, swing15mLowPrice, swing15mLowOriginTime, swing15mLowOriginEndTime, swing15mLowConfirmedTime] = request.security(syminfo.tickerid, "15", pivotSourcePackV2(swingLen15m), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 1500)
[src1hOpenTime, src1hCloseTime, swing1hHighPrice, swing1hHighOriginTime, swing1hHighOriginEndTime, swing1hHighConfirmedTime, swing1hLowPrice, swing1hLowOriginTime, swing1hLowOriginEndTime, swing1hLowConfirmedTime, accum1hNewConfirmedBox, accum1hBoxTop, accum1hBoxBottom, accum1hBoxId, accum1hCandidateStartTime, accum1hConfirmedTime, accum1hCandidateActive, accum1hCandidateTop, accum1hCandidateBottom, fvg1hBullNew, fvg1hBullBottom, fvg1hBullTop, fvg1hBearNew, fvg1hBearBottom, fvg1hBearTop, htf1hHigh, htf1hLow, htf1hClose] = request.security(syminfo.tickerid, "60", htf1hPackV2(swingLen1h, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 450)
[src4hOpenTime, src4hCloseTime, accum4hNewConfirmedBox, accum4hBoxTop, accum4hBoxBottom, accum4hBoxId, accum4hCandidateStartTime, accum4hConfirmedTime, accum4hCandidateActive, accum4hCandidateTop, accum4hCandidateBottom, fvg4hBullNew, fvg4hBullBottom, fvg4hBullTop, fvg4hBearNew, fvg4hBearBottom, fvg4hBearTop, htf4hHigh, htf4hLow, htf4hClose] = request.security(syminfo.tickerid, "240", htfPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 130)
[srcDOpenTime, srcDCloseTime, accumDNewConfirmedBox, accumDBoxTop, accumDBoxBottom, accumDBoxId, accumDCandidateStartTime, accumDConfirmedTime, accumDCandidateActive, accumDCandidateTop, accumDCandidateBottom, fvgDBullNew, fvgDBullBottom, fvgDBullTop, fvgDBearNew, fvgDBearBottom, fvgDBearTop, htfDHigh, htfDLow, htfDClose] = request.security(syminfo.tickerid, "D", htfPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 45)

// ---- B29 : host metadata, Cfg (set before the facade's first call creates its hidden Engine) and Feed ----
int  chartTfMinutesNow = int(timeframe.in_seconds(timeframe.period) / 60)
bool is5m              = timeframe.in_seconds(timeframe.period) == 300
var ZE.ZoneCfg cfg = ZE.newCfg()
cfg.chartTfMinutes := chartTfMinutesNow
cfg.mintick        := syminfo.mintick
cfg.emaSlopeLookback := emaSlopeLookback
cfg.swingLen5m := swingLen5m
cfg.swingLen15m := swingLen15m
cfg.swingLen1h := swingLen1h
cfg.accumRangeLen := accumRangeLen
cfg.accumBaseLen := accumBaseLen
cfg.accumAtrLen := accumAtrLen
cfg.accumMinUpperCloses := accumMinUpperCloses
cfg.accumMinLowerCloses := accumMinLowerCloses
cfg.accumMaxSameColorRun := accumMaxSameColorRun
cfg.accumAtrMult := accumAtrMult
cfg.accumBarRatioMax := accumBarRatioMax
cfg.accumDriftMax := accumDriftMax
var ZE.Feed       feed   = ZE.newFeed()
// deterministic window anchor: the last chart bar's open time (timenow only if unavailable)
int  historyAnchorTime = na(last_bar_time) ? timenow : last_bar_time
int  historyStartTime  = historyAnchorTime - ENGINE_WINDOW_DAYS * MS_PER_DAY
bool inEngineWindow    = is5m and time_close >= historyStartTime

// Visual-local snapshot (display only, value copy of the facade's CoreView array, never written back);
// side: 1 Support only, 2 Resistance only, 3 both
var array<int>   snCore = array.new_int(0)
var array<int>   snGen  = array.new_int(0)
var array<int>   snCt   = array.new_int(0)
var array<float> snBot  = array.new_float(0)
var array<float> snTop  = array.new_float(0)
var array<int>   snSide = array.new_int(0)
var int dgCount  = 0
var int dgMapErr = 0
var int dgDup    = 0
// update: confirmed 5m bars inside the Engine window; CoreView projection: the last bar only
bool doUpdate     = inEngineWindow and barstate.isconfirmed
bool wantSnapshot = barstate.islast

// ---- B29 : the 110 Feed fields are set only on update bars (the facade does not read the Feed when doUpdate is false) ----
if doUpdate
    // Base 18
    feed.baseOpen := open
    feed.baseHigh := high
    feed.baseLow := low
    feed.baseClose := close
    feed.basePrevClose := nz(close[1], close)
    feed.baseOpenTime := time
    feed.baseCloseTime := time_close
    feed.baseSeq := bar_index
    feed.baseConfirmed := true
    feed.mintick := syminfo.mintick
    feed.chartTfMinutes := chartTfMinutesNow
    feed.tfMa := 1
    feed.tfBase := 5
    feed.tfSwing15 := 15
    feed.tfSwing1h := 60
    feed.tfHtf1h := 60
    feed.tfHtf4h := 240
    feed.tfHtfD := 1440
    // 1m MA 6
    feed.maSourceOpenTime := maSourceOpenTime
    feed.maSourceCloseTime := maSourceCloseTime
    feed.ema2000 := ema2000Value
    feed.ema2000Slope := ema2000SlopeValue
    feed.ema3000 := ema3000Value
    feed.ema3000Slope := ema3000SlopeValue
    // 5m Swing 8 (chart context)
    feed.swing5mHighPrice := swing5mHighPrice
    feed.swing5mHighOriginTime := swing5mHighOriginTime
    feed.swing5mHighOriginEndTime := swing5mHighOriginEndTime
    feed.swing5mHighConfirmedTime := swing5mHighConfirmedTime
    feed.swing5mLowPrice := swing5mLowPrice
    feed.swing5mLowOriginTime := swing5mLowOriginTime
    feed.swing5mLowOriginEndTime := swing5mLowOriginEndTime
    feed.swing5mLowConfirmedTime := swing5mLowConfirmedTime
    // 15m 10
    feed.src15mOpenTime := src15mOpenTime
    feed.src15mCloseTime := src15mCloseTime
    feed.swing15mHighPrice := swing15mHighPrice
    feed.swing15mHighOriginTime := swing15mHighOriginTime
    feed.swing15mHighOriginEndTime := swing15mHighOriginEndTime
    feed.swing15mHighConfirmedTime := swing15mHighConfirmedTime
    feed.swing15mLowPrice := swing15mLowPrice
    feed.swing15mLowOriginTime := swing15mLowOriginTime
    feed.swing15mLowOriginEndTime := swing15mLowOriginEndTime
    feed.swing15mLowConfirmedTime := swing15mLowConfirmedTime
    // 1H 28
    feed.src1hOpenTime := src1hOpenTime
    feed.src1hCloseTime := src1hCloseTime
    feed.swing1hHighPrice := swing1hHighPrice
    feed.swing1hHighOriginTime := swing1hHighOriginTime
    feed.swing1hHighOriginEndTime := swing1hHighOriginEndTime
    feed.swing1hHighConfirmedTime := swing1hHighConfirmedTime
    feed.swing1hLowPrice := swing1hLowPrice
    feed.swing1hLowOriginTime := swing1hLowOriginTime
    feed.swing1hLowOriginEndTime := swing1hLowOriginEndTime
    feed.swing1hLowConfirmedTime := swing1hLowConfirmedTime
    feed.accum1hNewConfirmedBox := accum1hNewConfirmedBox
    feed.accum1hBoxTop := accum1hBoxTop
    feed.accum1hBoxBottom := accum1hBoxBottom
    feed.accum1hBoxId := accum1hBoxId
    feed.accum1hCandidateStartTime := accum1hCandidateStartTime
    feed.accum1hConfirmedTime := accum1hConfirmedTime
    feed.accum1hCandidateActive := accum1hCandidateActive
    feed.accum1hCandidateTop := accum1hCandidateTop
    feed.accum1hCandidateBottom := accum1hCandidateBottom
    feed.fvg1hBullNew := fvg1hBullNew
    feed.fvg1hBullBottom := fvg1hBullBottom
    feed.fvg1hBullTop := fvg1hBullTop
    feed.fvg1hBearNew := fvg1hBearNew
    feed.fvg1hBearBottom := fvg1hBearBottom
    feed.fvg1hBearTop := fvg1hBearTop
    feed.htf1hHigh := htf1hHigh
    feed.htf1hLow := htf1hLow
    feed.htf1hClose := htf1hClose
    // 4H 20
    feed.src4hOpenTime := src4hOpenTime
    feed.src4hCloseTime := src4hCloseTime
    feed.accum4hNewConfirmedBox := accum4hNewConfirmedBox
    feed.accum4hBoxTop := accum4hBoxTop
    feed.accum4hBoxBottom := accum4hBoxBottom
    feed.accum4hBoxId := accum4hBoxId
    feed.accum4hCandidateStartTime := accum4hCandidateStartTime
    feed.accum4hConfirmedTime := accum4hConfirmedTime
    feed.accum4hCandidateActive := accum4hCandidateActive
    feed.accum4hCandidateTop := accum4hCandidateTop
    feed.accum4hCandidateBottom := accum4hCandidateBottom
    feed.fvg4hBullNew := fvg4hBullNew
    feed.fvg4hBullBottom := fvg4hBullBottom
    feed.fvg4hBullTop := fvg4hBullTop
    feed.fvg4hBearNew := fvg4hBearNew
    feed.fvg4hBearBottom := fvg4hBearBottom
    feed.fvg4hBearTop := fvg4hBearTop
    feed.htf4hHigh := htf4hHigh
    feed.htf4hLow := htf4hLow
    feed.htf4hClose := htf4hClose
    // D 20
    feed.srcDOpenTime := srcDOpenTime
    feed.srcDCloseTime := srcDCloseTime
    feed.accumDNewConfirmedBox := accumDNewConfirmedBox
    feed.accumDBoxTop := accumDBoxTop
    feed.accumDBoxBottom := accumDBoxBottom
    feed.accumDBoxId := accumDBoxId
    feed.accumDCandidateStartTime := accumDCandidateStartTime
    feed.accumDConfirmedTime := accumDConfirmedTime
    feed.accumDCandidateActive := accumDCandidateActive
    feed.accumDCandidateTop := accumDCandidateTop
    feed.accumDCandidateBottom := accumDCandidateBottom
    feed.fvgDBullNew := fvgDBullNew
    feed.fvgDBullBottom := fvgDBullBottom
    feed.fvgDBullTop := fvgDBullTop
    feed.fvgDBearNew := fvgDBearNew
    feed.fvgDBearBottom := fvgDBearBottom
    feed.fvgDBearTop := fvgDBearTop
    feed.htfDHigh := htfDHigh
    feed.htfDLow := htfDLow
    feed.htfDClose := htfDClose

// ---- the only facade callsite (global scope, every bar): Production update when doUpdate, CoreView snapshot when
// wantSnapshot (none on historical bars). The snapshot is replaced only when wantSnapshot; committed = false never clears it.
[committed, views] = ZE.visualStepAndCoreViews(cfg, feed, doUpdate, wantSnapshot)
int facadeCallsThisBar = 1
if wantSnapshot
    array.clear(snCore)
    array.clear(snGen)
    array.clear(snCt)
    array.clear(snBot)
    array.clear(snTop)
    array.clear(snSide)
    map<int, bool> seenIds = map.new<int, bool>()
    dgCount  := array.size(views)
    dgMapErr := 0
    dgDup    := 0
    int i = 0
    while i < dgCount
        ZE.CoreView cv = array.get(views, i)
        if map.contains(seenIds, cv.coreId)
            dgDup += 1
            dgMapErr += 1
        else if cv.coreId > 0 and cv.generationId >= 0 and cv.physicalBottom <= cv.physicalTop and (cv.hasSupport or cv.hasResistance)
            map.put(seenIds, cv.coreId, true)
            array.push(snCore, cv.coreId)
            array.push(snGen, cv.generationId)
            array.push(snCt, cv.createdTime)
            array.push(snBot, cv.physicalBottom)
            array.push(snTop, cv.physicalTop)
            array.push(snSide, (cv.hasSupport ? 1 : 0) + (cv.hasResistance ? 2 : 0))
        else
            map.put(seenIds, cv.coreId, true)
            dgMapErr += 1
        i += 1


// ============================================================
// Layer 1 Geometry (display only). Authority: the facade-returned CoreView snapshot above (Production Engine state);
// nearest selection uses the current close (display only).
// W09_STATE_STYLE_HOOK: Side State styling (phase / grade / Weak ...) connects at the box colors below, only from the
// formal Production ZoneView once W09 writes it; nothing is computed here.
// W10_LIFECYCLE_STYLE_HOOK: Fresh / Generation / Pending / Snapshot / Event styling connects at the same place, only from
// formal Production views once W10 provides them.
// ============================================================
// display registry (logical key coreId + generationId)
var array<int>   dCore  = array.new_int(0)
var array<int>   dGen   = array.new_int(0)
var array<box>   dBox   = array.new_box(0)
var array<label> dLbl   = array.new_label(0)

if barstate.islast
    // nearest N by (distance to the current close, bottom, top, coreId, generationId); the close is display-only
    array<int>   sel  = array.new_int(0)
    array<float> selD = array.new_float(0)
    int k = 0
    while k < array.size(snCore)
        float b = array.get(snBot, k)
        float t = array.get(snTop, k)
        float d = close < b ? b - close : close > t ? close - t : 0.0
        if not useMaxDistance or d <= maxDistanceUsd
            int pos = array.size(sel)
            bool less = true
            while less and pos > 0
                int   o  = array.get(sel, pos - 1)
                float od = array.get(selD, pos - 1)
                less := d != od ? d < od : b != array.get(snBot, o) ? b < array.get(snBot, o) : t != array.get(snTop, o) ? t < array.get(snTop, o) : array.get(snCore, k) != array.get(snCore, o) ? array.get(snCore, k) < array.get(snCore, o) : array.get(snGen, k) < array.get(snGen, o)
                if less
                    pos -= 1
            if pos < visualMaxZones
                array.insert(sel, pos, k)
                array.insert(selD, pos, d)
                if array.size(sel) > visualMaxZones
                    array.pop(sel)
                    array.pop(selD)
        k += 1
    // registry: reuse the box of a known key, create a box for a new key, delete unselected keys (reverse order)
    array<bool> seen = array.new_bool(array.size(dCore), false)
    int s = 0
    while s < array.size(sel)
        int   q    = array.get(sel, s)
        int   side = array.get(snSide, q)
        color sc   = side == 1 ? supportColor : side == 2 ? resistanceColor : dualColor
        float t    = array.get(snTop, q)
        int   ct   = array.get(snCt, q)
        int   row  = -1
        int   j    = 0
        while row < 0 and j < array.size(dCore)
            row := array.get(dCore, j) == array.get(snCore, q) and array.get(dGen, j) == array.get(snGen, q) ? j : -1
            j += 1
        if row < 0
            array.push(dCore, array.get(snCore, q))
            array.push(dGen, array.get(snGen, q))
            array.push(dBox, box.new(na(ct) ? time : ct, t, time, array.get(snBot, q), border_color = sc, border_width = borderWidth, bgcolor = color.new(sc, zoneTransparency), extend = extend.right, xloc = xloc.bar_time))
            array.push(dLbl, na)
            array.push(seen, true)
            row := array.size(dCore) - 1
        else
            box bx = array.get(dBox, row)
            // createdTime na: the left edge stays the display-only first-seen time of this key (not a Production value)
            if not na(ct)
                box.set_left(bx, ct)
            box.set_top(bx, t)
            box.set_bottom(bx, array.get(snBot, q))
            box.set_right(bx, time)
            box.set_border_color(bx, sc)
            box.set_bgcolor(bx, color.new(sc, zoneTransparency))
            array.set(seen, row, true)
        label  lb  = array.get(dLbl, row)
        string txt = "Core " + str.tostring(array.get(snCore, q)) + "\nGen " + str.tostring(array.get(snGen, q)) + "\n" + (side == 1 ? "S" : side == 2 ? "R" : "S+R")
        if not showLabels
            label.delete(lb)
            array.set(dLbl, row, na)
        else if na(lb)
            array.set(dLbl, row, label.new(time, t, txt, xloc = xloc.bar_time, style = label.style_label_left, color = sc, textcolor = color.white, size = size.small))
        else
            label.set_xy(lb, time, t)
            label.set_text(lb, txt)
            label.set_color(lb, sc)
        s += 1
    int r = array.size(dCore) - 1
    while r >= 0
        if not array.get(seen, r)
            box.delete(array.get(dBox, r))
            label.delete(array.get(dLbl, r))
            array.remove(dCore, r)
            array.remove(dGen, r)
            array.remove(dBox, r)
            array.remove(dLbl, r)
        r -= 1

// ---- Diagnostics (Data Window) ----
plot(dgCount, "ENGINE_CORE_VIEW_COUNT", display = display.data_window)
plot(array.size(dCore), "DISPLAYED_ZONE_COUNT", display = display.data_window)
plot(dgMapErr, "VISUAL_MAPPING_ERROR_COUNT", display = display.data_window)
plot(dgDup, "DUPLICATE_VISUAL_KEY_COUNT", display = display.data_window)
plot(facadeCallsThisBar, "FACADE_CALL_COUNT_THIS_BAR", display = display.data_window)
plot(inEngineWindow ? 1 : 0, "IN_ENGINE_WINDOW", display = display.data_window)
plot(doUpdate ? 1 : 0, "UPDATE_REQUESTED", display = display.data_window)

//@version=6
indicator("ZoneEngineV2 W07 B18 Pine Runtime Probe", overlay = false)

// Standalone minimal probe: fixture-ID -> FVG direction evaluation in Pine runtime.
// No import, no UDT, no array/map/matrix, no request.*.

const int FVG_BULLISH = 1
const int FVG_BEARISH = 2

plot(180205, "W07 B18 Pine Probe Build", display = display.data_window)

// ---- switch map ----
mapSwitch(int fx) =>
    int dir = switch fx
        1  => FVG_BULLISH
        2  => FVG_BULLISH
        3  => FVG_BULLISH
        4  => FVG_BULLISH
        5  => FVG_BULLISH
        6  => FVG_BULLISH
        7  => FVG_BULLISH
        8  => FVG_BEARISH
        9  => FVG_BEARISH
        10 => FVG_BEARISH
        11 => FVG_BEARISH
        12 => FVG_BEARISH
        13 => FVG_BEARISH
        14 => FVG_BEARISH
        15 => FVG_BULLISH
        16 => FVG_BULLISH
        17 => FVG_BEARISH
        18 => FVG_BEARISH
        19 => FVG_BULLISH
        20 => FVG_BEARISH
        21 => FVG_BULLISH
        22 => FVG_BEARISH
        => int(na)
    dir

// ---- if / else if map ----
mapIf(int fx) =>
    int dir = if fx == 1
        FVG_BULLISH
    else if fx == 2
        FVG_BULLISH
    else if fx == 3
        FVG_BULLISH
    else if fx == 4
        FVG_BULLISH
    else if fx == 5
        FVG_BULLISH
    else if fx == 6
        FVG_BULLISH
    else if fx == 7
        FVG_BULLISH
    else if fx == 8
        FVG_BEARISH
    else if fx == 9
        FVG_BEARISH
    else if fx == 10
        FVG_BEARISH
    else if fx == 11
        FVG_BEARISH
    else if fx == 12
        FVG_BEARISH
    else if fx == 13
        FVG_BEARISH
    else if fx == 14
        FVG_BEARISH
    else if fx == 15
        FVG_BULLISH
    else if fx == 16
        FVG_BULLISH
    else if fx == 17
        FVG_BEARISH
    else if fx == 18
        FVG_BEARISH
    else if fx == 19
        FVG_BULLISH
    else if fx == 20
        FVG_BEARISH
    else if fx == 21
        FVG_BULLISH
    else if fx == 22
        FVG_BEARISH
    else
        int(na)
    dir

// ---- global literal switches ----
int litSw3 = switch 3
    1  => FVG_BULLISH
    2  => FVG_BULLISH
    3  => FVG_BULLISH
    4  => FVG_BULLISH
    5  => FVG_BULLISH
    6  => FVG_BULLISH
    7  => FVG_BULLISH
    8  => FVG_BEARISH
    9  => FVG_BEARISH
    10 => FVG_BEARISH
    11 => FVG_BEARISH
    12 => FVG_BEARISH
    13 => FVG_BEARISH
    14 => FVG_BEARISH
    15 => FVG_BULLISH
    16 => FVG_BULLISH
    17 => FVG_BEARISH
    18 => FVG_BEARISH
    19 => FVG_BULLISH
    20 => FVG_BEARISH
    21 => FVG_BULLISH
    22 => FVG_BEARISH
    => int(na)

int litSw9 = switch 9
    1  => FVG_BULLISH
    2  => FVG_BULLISH
    3  => FVG_BULLISH
    4  => FVG_BULLISH
    5  => FVG_BULLISH
    6  => FVG_BULLISH
    7  => FVG_BULLISH
    8  => FVG_BEARISH
    9  => FVG_BEARISH
    10 => FVG_BEARISH
    11 => FVG_BEARISH
    12 => FVG_BEARISH
    13 => FVG_BEARISH
    14 => FVG_BEARISH
    15 => FVG_BULLISH
    16 => FVG_BULLISH
    17 => FVG_BEARISH
    18 => FVG_BEARISH
    19 => FVG_BULLISH
    20 => FVG_BEARISH
    21 => FVG_BULLISH
    22 => FVG_BEARISH
    => int(na)

int litSw17 = switch 17
    1  => FVG_BULLISH
    2  => FVG_BULLISH
    3  => FVG_BULLISH
    4  => FVG_BULLISH
    5  => FVG_BULLISH
    6  => FVG_BULLISH
    7  => FVG_BULLISH
    8  => FVG_BEARISH
    9  => FVG_BEARISH
    10 => FVG_BEARISH
    11 => FVG_BEARISH
    12 => FVG_BEARISH
    13 => FVG_BEARISH
    14 => FVG_BEARISH
    15 => FVG_BULLISH
    16 => FVG_BULLISH
    17 => FVG_BEARISH
    18 => FVG_BEARISH
    19 => FVG_BULLISH
    20 => FVG_BEARISH
    21 => FVG_BULLISH
    22 => FVG_BEARISH
    => int(na)

int litSw22 = switch 22
    1  => FVG_BULLISH
    2  => FVG_BULLISH
    3  => FVG_BULLISH
    4  => FVG_BULLISH
    5  => FVG_BULLISH
    6  => FVG_BULLISH
    7  => FVG_BULLISH
    8  => FVG_BEARISH
    9  => FVG_BEARISH
    10 => FVG_BEARISH
    11 => FVG_BEARISH
    12 => FVG_BEARISH
    13 => FVG_BEARISH
    14 => FVG_BEARISH
    15 => FVG_BULLISH
    16 => FVG_BULLISH
    17 => FVG_BEARISH
    18 => FVG_BEARISH
    19 => FVG_BULLISH
    20 => FVG_BEARISH
    21 => FVG_BULLISH
    22 => FVG_BEARISH
    => int(na)

plot(litSw3, "Literal Switch 3", display = display.data_window)
plot(litSw9, "Literal Switch 9", display = display.data_window)
plot(litSw17, "Literal Switch 17", display = display.data_window)
plot(litSw22, "Literal Switch 22", display = display.data_window)

// ---- function calls ----
plot(mapSwitch(3), "Fn Switch 3", display = display.data_window)
plot(mapSwitch(9), "Fn Switch 9", display = display.data_window)
plot(mapSwitch(17), "Fn Switch 17", display = display.data_window)
plot(mapSwitch(22), "Fn Switch 22", display = display.data_window)
plot(mapIf(3), "Fn If 3", display = display.data_window)
plot(mapIf(9), "Fn If 9", display = display.data_window)
plot(mapIf(17), "Fn If 17", display = display.data_window)
plot(mapIf(22), "Fn If 22", display = display.data_window)

// ---- pass-through wrappers ----
passSwitch(int fx) =>
    mapSwitch(fx)

passIf(int fx) =>
    mapIf(fx)

plot(passSwitch(9), "Pass Switch 9", display = display.data_window)
plot(passSwitch(17), "Pass Switch 17", display = display.data_window)
plot(passIf(9), "Pass If 9", display = display.data_window)
plot(passIf(17), "Pass If 17", display = display.data_window)

// ---- tuple return ----
tupleSwitch(int fx) =>
    int dir = mapSwitch(fx)
    [fx, dir]

[tupArg9, tupDir9] = tupleSwitch(9)
[tupArg17, tupDir17] = tupleSwitch(17)
plot(tupArg9, "Tuple Arg 9", display = display.data_window)
plot(tupDir9, "Tuple Dir 9", display = display.data_window)
plot(tupArg17, "Tuple Arg 17", display = display.data_window)
plot(tupDir17, "Tuple Dir 17", display = display.data_window)

// ---- equality probes ----
probeEq9(int fx) =>
    fx == 9

probeEq17(int fx) =>
    fx == 17

plot(probeEq9(9) ? 1 : 0, "Eq9 With 9", display = display.data_window)
plot(probeEq17(17) ? 1 : 0, "Eq17 With 17", display = display.data_window)
plot(probeEq9(17) ? 1 : 0, "Eq9 With 17", display = display.data_window)
plot(probeEq17(9) ? 1 : 0, "Eq17 With 9", display = display.data_window)

// ---- full 1..22 mismatch check ----
mismatchOne(int got, int want) =>
    (na(got) or na(want) or got != want) ? 1 : 0

int switchMismatch = 0
switchMismatch += mismatchOne(mapSwitch(1), 1)
switchMismatch += mismatchOne(mapSwitch(2), 1)
switchMismatch += mismatchOne(mapSwitch(3), 1)
switchMismatch += mismatchOne(mapSwitch(4), 1)
switchMismatch += mismatchOne(mapSwitch(5), 1)
switchMismatch += mismatchOne(mapSwitch(6), 1)
switchMismatch += mismatchOne(mapSwitch(7), 1)
switchMismatch += mismatchOne(mapSwitch(8), 2)
switchMismatch += mismatchOne(mapSwitch(9), 2)
switchMismatch += mismatchOne(mapSwitch(10), 2)
switchMismatch += mismatchOne(mapSwitch(11), 2)
switchMismatch += mismatchOne(mapSwitch(12), 2)
switchMismatch += mismatchOne(mapSwitch(13), 2)
switchMismatch += mismatchOne(mapSwitch(14), 2)
switchMismatch += mismatchOne(mapSwitch(15), 1)
switchMismatch += mismatchOne(mapSwitch(16), 1)
switchMismatch += mismatchOne(mapSwitch(17), 2)
switchMismatch += mismatchOne(mapSwitch(18), 2)
switchMismatch += mismatchOne(mapSwitch(19), 1)
switchMismatch += mismatchOne(mapSwitch(20), 2)
switchMismatch += mismatchOne(mapSwitch(21), 1)
switchMismatch += mismatchOne(mapSwitch(22), 2)

int ifMismatch = 0
ifMismatch += mismatchOne(mapIf(1), 1)
ifMismatch += mismatchOne(mapIf(2), 1)
ifMismatch += mismatchOne(mapIf(3), 1)
ifMismatch += mismatchOne(mapIf(4), 1)
ifMismatch += mismatchOne(mapIf(5), 1)
ifMismatch += mismatchOne(mapIf(6), 1)
ifMismatch += mismatchOne(mapIf(7), 1)
ifMismatch += mismatchOne(mapIf(8), 2)
ifMismatch += mismatchOne(mapIf(9), 2)
ifMismatch += mismatchOne(mapIf(10), 2)
ifMismatch += mismatchOne(mapIf(11), 2)
ifMismatch += mismatchOne(mapIf(12), 2)
ifMismatch += mismatchOne(mapIf(13), 2)
ifMismatch += mismatchOne(mapIf(14), 2)
ifMismatch += mismatchOne(mapIf(15), 1)
ifMismatch += mismatchOne(mapIf(16), 1)
ifMismatch += mismatchOne(mapIf(17), 2)
ifMismatch += mismatchOne(mapIf(18), 2)
ifMismatch += mismatchOne(mapIf(19), 1)
ifMismatch += mismatchOne(mapIf(20), 2)
ifMismatch += mismatchOne(mapIf(21), 1)
ifMismatch += mismatchOne(mapIf(22), 2)

int switchVsIfMismatch = 0
for fx = 1 to 22
    switchVsIfMismatch += mismatchOne(mapSwitch(fx), mapIf(fx))

plot(switchMismatch, "Switch Mismatch Count", display = display.data_window)
plot(ifMismatch, "If Mismatch Count", display = display.data_window)
plot(switchVsIfMismatch, "Switch vs If Mismatch Count", display = display.data_window)

//@version=6
// W05 B14R R0D-A: private internal context POC (PLAN A); no exported UDT, no Candidate logic.
library("ZoneEngineV2_W05Candidate_POC_InternalCtx_Worker", overlay = false)

type CandidateCtx
    array<int>    rootIds
    map<int, int> rootIdToSlot

    array<int>    winnerRootIds
    array<bool>   usedByRootSlot
    array<int>    broadSeenEpochByRootSlot

    int           winnerLogicalCount
    int           winnerRootIdLength
    int           broadSeenEpoch

    bool          failedSupport
    bool          failedResistance

    float         mintick

probeMutateCtx(CandidateCtx ctx, int delta) =>
    ctx.winnerLogicalCount := ctx.winnerLogicalCount + delta
    ctx.winnerRootIdLength := ctx.winnerRootIdLength + 1
    ctx.broadSeenEpoch     := ctx.broadSeenEpoch + 1
    ctx.failedSupport      := false
    ctx.failedResistance   := delta < 0
    array.push(ctx.winnerRootIds, array.size(ctx.rootIds) + map.size(ctx.rootIdToSlot) + delta)
    if array.size(ctx.usedByRootSlot) == 0
        array.push(ctx.usedByRootSlot, delta >= 0)
    else
        array.set(ctx.usedByRootSlot, 0, delta >= 0)
    if array.size(ctx.broadSeenEpochByRootSlot) == 0
        array.push(ctx.broadSeenEpochByRootSlot, ctx.broadSeenEpoch)
    else
        array.set(ctx.broadSeenEpochByRootSlot, 0, ctx.broadSeenEpoch)
    true

export probeInternalCtx(array<int> rootIds, map<int, int> rootIdToSlot, array<int> winnerRootIds, array<bool> usedByRootSlot, array<int> broadSeenEpochByRootSlot, int winnerLogicalCount, int winnerRootIdLength, int broadSeenEpoch, bool failedSupport, bool failedResistance, float mintick, int delta) =>
    CandidateCtx ctx = CandidateCtx.new(rootIds, rootIdToSlot, winnerRootIds, usedByRootSlot, broadSeenEpochByRootSlot, winnerLogicalCount, winnerRootIdLength, broadSeenEpoch, failedSupport, failedResistance, mintick)
    // incoming flags and mintick reach the mutation through the effective delta
    int effectiveDelta = delta + (ctx.failedSupport ? 1 : 0) + (ctx.failedResistance ? 2 : 0) + int(math.round(nz(ctx.mintick, 0.0) * 1000.0))
    bool mutated = probeMutateCtx(ctx, effectiveDelta)
    int outWinnerLogicalCount = mutated ? ctx.winnerLogicalCount : winnerLogicalCount
    [outWinnerLogicalCount, ctx.winnerRootIdLength, ctx.broadSeenEpoch, ctx.failedSupport, ctx.failedResistance, array.size(winnerRootIds), array.size(usedByRootSlot), array.size(broadSeenEpochByRootSlot)]

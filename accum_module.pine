//
// ============================================================
//  Accumulation 単体モジュール (Indicator版)
// ============================================================
//  ・現ストラテジーの Accumulation 判定を独立モジュール化。
//  ・Accumulation =「レンジ」ではなく「エネルギー蓄積フェーズ」として扱う。
//  ・このモジュール単体でエントリーはしない:
//      方向判定 / NoTrade判定 / Breakout候補 / 他モジュールへの加点。
//  ・strategy ではなく indicator。strategy.entry 等は一切不使用。
//  ・未来参照禁止 (確定足のみ / lookahead は使わない)。
//  ・後で FVG / EMA / Trendline / Cloud / MACD 等と AND 接続する前提。
//  ・全機能 ON/OFF 可能。各変数を Data Window へ出力。
//  セクション: A検知 B Box C Breakout D Confirm E Fake F MSS
//             G Expansion H Compression I Duration J/K/L Rank
//             M Quality N Bias O NoTrade P Rank/SignalType
// ============================================================

//@version=5
indicator(
     title            = "Accumulation Module",
     shorttitle       = "ACCUM",
     overlay          = true,
     max_bars_back    = 1000,
     max_labels_count = 500,
     max_boxes_count  = 500,
     max_lines_count  = 100
 )

// ============================================================
//  入力 (グループ: Accumulation Module)
// ============================================================
grpAccum = "Accumulation Module"

useAccumModule = input.bool(true,  "Accumモジュールを使う",   group = grpAccum)
showAccumBox   = input.bool(true,  "Accum Boxを表示",         group = grpAccum)
showBreakLines = input.bool(true,  "Breakoutラインを表示",    group = grpAccum)
showAccumLabels= input.bool(true,  "シグナルラベルを表示",    group = grpAccum)
showDebugTable = input.bool(true,  "デバッグテーブルを表示",  group = grpAccum)

// --- A: 検知パラメータ (現ロジックそのまま) ---
grpDet = "Accum / 検知パラメータ"
accumRangeLen        = input.int(10,  "Accum判定レンジ本数", minval = 6, group = grpDet)
accumBaseLen         = input.int(20,  "基準平均本数",        minval = 10, group = grpDet)
accumATRLen          = input.int(14,  "ATR本数",             minval = 1, group = grpDet)
accumATRMult         = input.float(2.5,  "レンジ幅 / ATR 上限",      minval = 0.5, step = 0.1,  group = grpDet)
accumBarRatioMax     = input.float(0.70, "平均値幅/基準平均 上限",   minval = 0.1, step = 0.01, group = grpDet)
accumDriftMax        = input.float(0.30, "ドリフト上限",            minval = 0.05, maxval = 1.0, step = 0.05, group = grpDet)
accumMinUpperCloses  = input.int(4,   "上半分の最低終値本数", minval = 1, group = grpDet)
accumMinLowerCloses  = input.int(4,   "下半分の最低終値本数", minval = 1, group = grpDet)
accumMaxSameColorRun = input.int(4,   "同色連続の上限",       minval = 1, group = grpDet)

// --- A: フィルター ON/OFF ---
grpFil = "Accum / フィルター ON/OFF"
useATRFilter      = input.bool(true, "ATR条件",        group = grpFil)
useRangeFilter    = input.bool(true, "レンジ幅条件",   group = grpFil)
useBalanceFilter  = input.bool(true, "上下バランス",   group = grpFil)
useDriftFilter    = input.bool(true, "ドリフト",       group = grpFil)
useColorRunFilter = input.bool(true, "連続陽線/陰線",  group = grpFil)

// --- D: Break Confirm ---
grpConf = "Accum / Break Confirm"
breakConfirmBars   = input.int(2,    "Break確定 連続Close本数", minval = 1, group = grpConf)
breakBodyRatio     = input.float(0.5, "Break実体割合 下限",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpConf)
breakATRMultiplier = input.float(0.8, "Break実体 / ATR 下限",   minval = 0.0, step = 0.1, group = grpConf)

// --- E: Fake Break ---
grpFake = "Accum / Fake Break"
useFakeBreak     = input.bool(true, "Fake Break検知を使う",     group = grpFake)
fakeBreakBars    = input.int(10, "Fake Break 有効本数", minval = 1, group = grpFake)

// --- F: MSS ---
grpMss = "Accum / MSS"
useMSS              = input.bool(true, "MSS検知を使う",          group = grpMss)
mssImpulseMult      = input.float(0.4, "MSS インパルス強度",     minval = 0.0, step = 0.05, group = grpMss)
mssNeedBodyStrength = input.bool(true, "MSSで実体強度を使う",    group = grpMss)

// --- G/H: Expansion / Compression ---
grpExp = "Accum / Expansion・Compression"
expAtrMult     = input.float(1.5, "Expansion ATR倍率",    minval = 1.0, step = 0.1, group = grpExp)
expRangeMult   = input.float(1.5, "Expansion 値幅倍率",   minval = 1.0, step = 0.1, group = grpExp)
expVolMult     = input.float(1.5, "Expansion 出来高倍率", minval = 1.0, step = 0.1, group = grpExp)
compAtrMult    = input.float(0.8, "Compression ATR倍率",  minval = 0.1, maxval = 1.0, step = 0.05, group = grpExp)
compRangeMult  = input.float(0.8, "Compression 値幅倍率", minval = 0.1, maxval = 1.0, step = 0.05, group = grpExp)
expWindowBars  = input.int(15, "Expansion有効本数(Accum終了後)", minval = 1, group = grpExp)

// --- N/O: Bias / NoTrade ---
grpBias = "Accum / Bias・NoTrade"
useAccumNoTrade  = input.bool(true,  "Accum中はNoTrade",        group = grpBias)
useCenterNoTrade = input.bool(true,  "Accum中央付近もNoTrade",  group = grpBias)
centerZonePct    = input.float(0.4, "中央ゾーン幅(箱幅比)",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpBias)
retestBars       = input.int(15, "Retest 有効本数", minval = 1, group = grpBias)
accumTouchATR    = input.float(0.3, "Retest/Touch ATR倍率", minval = 0.05, step = 0.05, group = grpBias)

bool aAct = useAccumModule

// ============================================================
//  A: Accumulation 検知 (現ロジックを極力そのまま流用)
//     条件ごとに raw 値を返し、ON/OFF は呼び出し側で AND 結合
// ============================================================
f_accum_range() =>
    ta.highest(math.max(open, close), accumRangeLen) - ta.lowest(math.min(open, close), accumRangeLen)

f_accum_core() =>
    _atr = ta.atr(accumATRLen)

    _bodyTop = math.max(open, close)
    _bodyBot = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _rangeShort = ta.highest(_bodyTop, accumRangeLen) - ta.lowest(_bodyBot, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumBaseLen)  - ta.lowest(_bodyBot, accumBaseLen)

    _condAtr      = _atr > 0 and _rangeNow <= _atr * accumATRMult
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumBarRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumDriftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    [_condAtr, _condBar, _condBalance, _condDrift, _condColorRun, _rangeNow, _drift, _upperCloses, _lowerCloses, _maxBullRun, _maxBearRun, _atr]

[condAtr, condBar, condBalance, condDrift, condColorRun, rangeNow, drift, upperCloses, lowerCloses, maxBullRun, maxBearRun, atrNow] = f_accum_core()

// フィルター ON/OFF (OFF の条件は常に通過)
bool passAtr      = condAtr      or not useATRFilter
bool passBar      = condBar      or not useRangeFilter
bool passBalance  = condBalance  or not useBalanceFilter
bool passDrift    = condDrift    or not useDriftFilter
bool passColorRun = condColorRun or not useColorRunFilter

bool isAccum = aAct and passAtr and passBar and passBalance and passDrift and passColorRun

float accumRangeVal = f_accum_range()
float accumHighNow  = ta.highest(math.max(open, close), accumRangeLen)
float accumLowNow   = ta.lowest(math.min(open, close),  accumRangeLen)

// ============================================================
//  B: Accum Box の高安追跡 (実体ベース) + 開始/終了検出
// ============================================================
bool newAccum = isAccum and not nz(isAccum[1], false)
bool endAccum = not isAccum and nz(isAccum[1], false)

var float runAccumHigh   = na
var float runAccumLow    = na
var float lastAccumHigh  = na
var float lastAccumLow   = na
var float lastAccumWidth = na

// Break / Fake / Retest 系 state (endAccum でリセット)
var bool  brokeLong      = false
var bool  brokeShort     = false
var int   brokeLongBar   = na
var int   brokeShortBar  = na
var int   confirmLongRun  = 0
var int   confirmShortRun = 0
var bool  bullMssDone     = false
var bool  bearMssDone     = false
var bool  bullBreakSeen   = false
var bool  bearBreakSeen   = false
var float bullCumBody     = 0.0
var float bearCumBody     = 0.0
var int   lastEndBar      = na
var bool  retestLongDone  = false
var bool  retestShortDone = false

if newAccum
    runAccumHigh := accumHighNow
    runAccumLow  := accumLowNow
    lastAccumHigh  := na
    lastAccumLow   := na
    lastAccumWidth := na

if isAccum
    float _bt = math.max(open, close)
    float _bb = math.min(open, close)
    runAccumHigh := na(runAccumHigh) ? _bt : math.max(runAccumHigh, _bt)
    runAccumLow  := na(runAccumLow)  ? _bb : math.min(runAccumLow,  _bb)

if endAccum
    lastAccumHigh  := runAccumHigh
    lastAccumLow   := runAccumLow
    lastAccumWidth := runAccumHigh - runAccumLow
    runAccumHigh   := na
    runAccumLow    := na
    lastEndBar     := bar_index
    // 新フェーズ用に Break/MSS state をリセット
    brokeLong       := false
    brokeShort      := false
    brokeLongBar    := na
    brokeShortBar   := na
    confirmLongRun  := 0
    confirmShortRun := 0
    bullMssDone     := false
    bearMssDone     := false
    bullBreakSeen   := false
    bearBreakSeen   := false
    bullCumBody     := 0.0
    bearCumBody     := 0.0
    retestLongDone  := false
    retestShortDone := false

// 出力用 Box値 (Accum中=進行中 / Accum後=確定値)
float accumHigh  = isAccum ? runAccumHigh : lastAccumHigh
float accumLow   = isAccum ? runAccumLow  : lastAccumLow
float accumWidth = na(accumHigh) or na(accumLow) ? na : accumHigh - accumLow
float accumMid   = na(accumHigh) or na(accumLow) ? na : (accumHigh + accumLow) * 0.5

// ============================================================
//  I: Duration (Accum継続本数)
// ============================================================
var int accumBars = 0
if isAccum
    accumBars := accumBars + 1
else
    accumBars := 0

// ============================================================
//  C: Breakout (Accum終了後の上抜け/下抜け)
// ============================================================
float accumTouch = atrNow * accumTouchATR
bool accumBreakLong  = aAct and not na(lastAccumHigh) and close > lastAccumHigh and close[1] <= lastAccumHigh
bool accumBreakShort = aAct and not na(lastAccumLow)  and close < lastAccumLow  and close[1] >= lastAccumLow

// ============================================================
//  D: Break Confirm (連続Close + 実体割合 + ATR以上)
// ============================================================
float barBody  = math.abs(close - open)
float barRange = high - low
bool  bodyRatioOK = barRange > 0 and (barBody / barRange) >= breakBodyRatio
bool  atrExtOK    = atrNow > 0 and barBody >= atrNow * breakATRMultiplier

if not na(lastAccumHigh)
    confirmLongRun := close > lastAccumHigh ? confirmLongRun + 1 : 0
if not na(lastAccumLow)
    confirmShortRun := close < lastAccumLow ? confirmShortRun + 1 : 0

bool accumConfirmBreakLong  = aAct and confirmLongRun  >= breakConfirmBars and bodyRatioOK and atrExtOK
bool accumConfirmBreakShort = aAct and confirmShortRun >= breakConfirmBars and bodyRatioOK and atrExtOK

// ============================================================
//  E: Fake Break (上抜け→Accum内へ戻る / SELLは逆)
// ============================================================
if not na(lastAccumHigh) and useFakeBreak
    if high > lastAccumHigh
        brokeLong := true
        brokeLongBar := bar_index
if not na(lastAccumLow) and useFakeBreak
    if low < lastAccumLow
        brokeShort := true
        brokeShortBar := bar_index

bool accumFakeBreakLong  = aAct and useFakeBreak and brokeLong  and not na(lastAccumHigh) and close < lastAccumHigh and not na(brokeLongBar)  and (bar_index - brokeLongBar)  <= fakeBreakBars
bool accumFakeBreakShort = aAct and useFakeBreak and brokeShort and not na(lastAccumLow)  and close > lastAccumLow  and not na(brokeShortBar) and (bar_index - brokeShortBar) <= fakeBreakBars
if accumFakeBreakLong
    brokeLong := false
if accumFakeBreakShort
    brokeShort := false

// ============================================================
//  F: MSS (現ロジックを独立 / Bull・Bear 各1)
// ============================================================
bool bullMSS = false
if useMSS and not na(lastAccumHigh) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bullMssDone
    bool _brk = close > lastAccumHigh and close[1] <= lastAccumHigh
    if _brk and not bullBreakSeen
        bullBreakSeen := true
        bullCumBody   := close - open
    else if bullBreakSeen
        bullCumBody += (close - open)
    bool _imp = math.abs(bullCumBody) >= lastAccumWidth * mssImpulseMult
    bullMSS := barstate.isconfirmed and bullBreakSeen and (not mssNeedBodyStrength or _imp)
    if bullMSS
        bullMssDone := true

bool bearMSS = false
if useMSS and not na(lastAccumLow) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bearMssDone
    bool _brk = close < lastAccumLow and close[1] >= lastAccumLow
    if _brk and not bearBreakSeen
        bearBreakSeen := true
        bearCumBody   := open - close
    else if bearBreakSeen
        bearCumBody += (open - close)
    bool _imp = math.abs(bearCumBody) >= lastAccumWidth * mssImpulseMult
    bearMSS := barstate.isconfirmed and bearBreakSeen and (not mssNeedBodyStrength or _imp)
    if bearMSS
        bearMssDone := true

bullMSS := aAct and bullMSS
bearMSS := aAct and bearMSS

// ============================================================
//  G/H: Expansion / Compression
// ============================================================
float atrRef   = ta.sma(atrNow, accumBaseLen)
float rangeRef = ta.sma(barRange, accumBaseLen)
float volRef   = ta.sma(volume, accumBaseLen)
bool  withinExpWindow = not na(lastEndBar) and (bar_index - lastEndBar) <= expWindowBars

bool accumExpansion = aAct and withinExpWindow and atrRef > 0 and rangeRef > 0 and atrNow > atrRef * expAtrMult and barRange > rangeRef * expRangeMult and (na(volume) or na(volRef) or volume > volRef * expVolMult)
bool accumCompression = aAct and atrRef > 0 and rangeRef > 0 and atrNow < atrRef * compAtrMult and barRange < rangeRef * compRangeMult

// ============================================================
//  J/K/L: Width / Balance / Drift Rank
// ============================================================
float widthRef = na(lastAccumWidth) ? (accumHighNow - accumLowNow) : lastAccumWidth
float widthRatio = atrNow > 0 ? widthRef / atrNow : na
int accumWidthRank = na(widthRatio) ? 0 : widthRatio <= 0.8 ? 5 : widthRatio <= 1.3 ? 4 : widthRatio <= 1.8 ? 3 : widthRatio <= 2.4 ? 2 : 1

int balDiff = math.abs(upperCloses - lowerCloses)
int accumBalanceRank = balDiff <= 1 ? 5 : balDiff <= 2 ? 4 : balDiff <= 3 ? 3 : balDiff <= 4 ? 2 : 1

float driftRatio = rangeNow > 0 ? drift / rangeNow : na
int accumDriftRank = na(driftRatio) ? 0 : driftRatio <= 0.10 ? 5 : driftRatio <= 0.20 ? 4 : driftRatio <= 0.30 ? 3 : driftRatio <= 0.45 ? 2 : 1

// ============================================================
//  M: Overall Quality (0〜100 加点方式)
// ============================================================
float qATR      = condAtr ? 15.0 : 0.0
float qBalance  = accumBalanceRank / 5.0 * 20.0
float qWidth    = accumWidthRank   / 5.0 * 20.0
float qDuration = math.min(accumBars, 20) / 20.0 * 15.0
float qDrift    = accumDriftRank   / 5.0 * 15.0
float qColorRun = condColorRun ? 15.0 : 0.0
int accumQuality = aAct ? math.round(math.min(100.0, qATR + qBalance + qWidth + qDuration + qDrift + qColorRun)) : 0

// ============================================================
//  Retest (Break後に被ブレイクラインへ戻り保持)
// ============================================================
bool accumRetestLong = false
if aAct and not na(lastAccumHigh) and not retestLongDone and not na(lastEndBar) and (bar_index - lastEndBar) <= retestBars
    if low <= lastAccumHigh + accumTouch and close > lastAccumHigh and close > open
        accumRetestLong := true
        retestLongDone := true
bool accumRetestShort = false
if aAct and not na(lastAccumLow) and not retestShortDone and not na(lastEndBar) and (bar_index - lastEndBar) <= retestBars
    if high >= lastAccumLow - accumTouch and close < lastAccumLow and close < open
        accumRetestShort := true
        retestShortDone := true

// ============================================================
//  N: Bias (Break / MSS で方向確定。新Accumでクリア)
// ============================================================
var bool accumBiasLong  = false
var bool accumBiasShort = false
if newAccum
    accumBiasLong  := false
    accumBiasShort := false
if accumBreakLong or bullMSS
    accumBiasLong  := true
    accumBiasShort := false
if accumBreakShort or bearMSS
    accumBiasShort := true
    accumBiasLong  := false
accumBiasLong  := aAct and accumBiasLong
accumBiasShort := aAct and accumBiasShort

// ============================================================
//  O: NoTrade (Accum中 / 中央付近)
// ============================================================
float centerHalf = na(accumWidth) ? na : accumWidth * centerZonePct * 0.5
bool nearCenter = isAccum and not na(accumMid) and not na(centerHalf) and math.abs(close - accumMid) <= centerHalf
bool accumNoTrade = aAct and useAccumNoTrade and (isAccum or (useCenterNoTrade and nearCenter))

// ============================================================
//  P: Rank (1〜8) / SignalType (0〜8)
// ============================================================
bool hiQualBreak = (accumConfirmBreakLong or accumConfirmBreakShort) and accumQuality >= 70
bool anyRetest   = accumRetestLong or accumRetestShort
bool anyMSS      = bullMSS or bearMSS
bool anyBreak    = accumBreakLong or accumBreakShort
bool anyConfirm  = accumConfirmBreakLong or accumConfirmBreakShort
bool anyFake     = accumFakeBreakLong or accumFakeBreakShort

int accumRank = not aAct ? 0 :
                 hiQualBreak           ? 8 :
                 anyRetest             ? 7 :
                 accumExpansion        ? 6 :
                 anyConfirm            ? 5 :
                 anyBreak              ? 4 :
                 anyMSS                ? 3 :
                 accumQuality >= 50    ? 2 :
                 isAccum               ? 1 : 0

// SignalType: 0None 1Accum 2Breakout 3ConfirmBreak 4FakeBreak 5MSS 6Expansion 7Compression 8Retest
int accumSignalType = not aAct ? 0 :
                       anyRetest      ? 8 :
                       anyFake        ? 4 :
                       anyConfirm     ? 3 :
                       anyBreak       ? 2 :
                       anyMSS         ? 5 :
                       accumExpansion ? 6 :
                       accumCompression ? 7 :
                       isAccum        ? 1 : 0

int accumDirection = not aAct ? 0 : accumBiasLong ? 1 : accumBiasShort ? -1 : 0

// ============================================================
//  接続用出力 (allow 系)
// ============================================================
bool allowLongByAccum  = aAct and accumBiasLong  and not accumNoTrade and (accumConfirmBreakLong  or bullMSS or accumBreakLong  or accumRetestLong)
bool allowShortByAccum = aAct and accumBiasShort and not accumNoTrade and (accumConfirmBreakShort or bearMSS or accumBreakShort or accumRetestShort)

// ============================================================
//  表示 : Accum Box
// ============================================================
var box curAccumBox = na
var float curBoxHigh = na
var float curBoxLow  = na
color accumBoxBg     = color.new(color.orange, 85)
color accumBoxBorder = color.new(color.orange, 30)

if newAccum
    curBoxHigh := accumHighNow
    curBoxLow  := accumLowNow
    if showAccumBox and aAct
        curAccumBox := box.new(left = bar_index - accumRangeLen + 1, top = accumHighNow, right = bar_index, bottom = accumLowNow, bgcolor = accumBoxBg, border_color = accumBoxBorder)

if isAccum
    float _bt2 = math.max(open, close)
    float _bb2 = math.min(open, close)
    curBoxHigh := math.max(nz(curBoxHigh, _bt2), _bt2)
    curBoxLow  := math.min(nz(curBoxLow,  _bb2), _bb2)
    if showAccumBox and aAct and not na(curAccumBox)
        box.set_top(curAccumBox, curBoxHigh)
        box.set_bottom(curAccumBox, curBoxLow)
        box.set_right(curAccumBox, bar_index)

// ============================================================
//  表示 : Breakout ライン (確定 Accum 高安)
// ============================================================
var line lnHigh = na
var line lnLow  = na
if showBreakLines and aAct and endAccum and not na(lastAccumHigh)
    lnHigh := line.new(bar_index, lastAccumHigh, bar_index + 1, lastAccumHigh, color = color.new(color.red, 0), width = 1, extend = extend.right)
    lnLow  := line.new(bar_index, lastAccumLow,  bar_index + 1, lastAccumLow,  color = color.new(color.blue, 0), width = 1, extend = extend.right)

// ============================================================
//  表示 : ラベル (Fake / MSS / Expansion / Break)
// ============================================================
f_lbl(isUp, txt, col) =>
    label.new(bar_index, isUp ? high : low, txt, style = isUp ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, yloc = isUp ? yloc.abovebar : yloc.belowbar, size = size.small)

if showAccumLabels and aAct
    if accumFakeBreakLong
        f_lbl(true,  "Fake↑", color.new(color.maroon, 0))
    if accumFakeBreakShort
        f_lbl(false, "Fake↓", color.new(color.maroon, 0))
    if bullMSS
        f_lbl(false, "MSS↑", color.new(color.green, 0))
    if bearMSS
        f_lbl(true,  "MSS↓", color.new(color.red, 0))
    if accumExpansion
        f_lbl(true,  "EXP", color.new(color.purple, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Accum" : t == 2 ? "Breakout" : t == 3 ? "ConfBreak" : t == 4 ? "FakeBreak" : t == 5 ? "MSS" : t == 6 ? "Expansion" : t == 7 ? "Compress" : t == 8 ? "Retest" : "-"

var table dbg = table.new(position.top_right, 2, 10, border_width = 1)
if showDebugTable and aAct and barstate.islast
    string sDir = accumDirection == 1 ? "LONG" : accumDirection == -1 ? "SHORT" : "-"
    table.cell(dbg, 0, 0, "Accum", text_color = color.white, bgcolor = color.new(color.orange, 0))
    table.cell(dbg, 1, 0, accumNoTrade ? "NoTrade" : (isAccum ? "ACCUM" : (accumDirection != 0 ? "SIGNAL" : "-")), text_color = color.white, bgcolor = accumNoTrade ? color.new(color.red, 30) : color.new(color.orange, 0))
    table.cell(dbg, 0, 1, "isAccum", text_color = color.white)
    table.cell(dbg, 1, 1, isAccum ? "Y" : "N", text_color = color.white)
    table.cell(dbg, 0, 2, "Quality", text_color = color.white)
    table.cell(dbg, 1, 2, str.tostring(accumQuality), text_color = color.white)
    table.cell(dbg, 0, 3, "Rank", text_color = color.white)
    table.cell(dbg, 1, 3, str.tostring(accumRank), text_color = color.white)
    table.cell(dbg, 0, 4, "SignalType", text_color = color.white)
    table.cell(dbg, 1, 4, f_typeStr(accumSignalType), text_color = color.white)
    table.cell(dbg, 0, 5, "Direction", text_color = color.white)
    table.cell(dbg, 1, 5, sDir, text_color = color.white)
    table.cell(dbg, 0, 6, "Width", text_color = color.white)
    table.cell(dbg, 1, 6, na(accumWidth) ? "-" : str.tostring(accumWidth, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 7, "Bars", text_color = color.white)
    table.cell(dbg, 1, 7, str.tostring(accumBars), text_color = color.white)
    table.cell(dbg, 0, 8, "W/B/D Rank", text_color = color.white)
    table.cell(dbg, 1, 8, str.tostring(accumWidthRank) + "/" + str.tostring(accumBalanceRank) + "/" + str.tostring(accumDriftRank), text_color = color.white)
    table.cell(dbg, 0, 9, "Exp/Comp", text_color = color.white)
    table.cell(dbg, 1, 9, (accumExpansion ? "E" : "-") + " / " + (accumCompression ? "C" : "-"), text_color = color.white)

// ============================================================
//  シグナル形状
// ============================================================
plotshape(aAct and accumBreakLong,       title = "Break Long",   style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0),  size = size.tiny)
plotshape(aAct and accumBreakShort,      title = "Break Short",  style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),    size = size.tiny)
plotshape(aAct and accumConfirmBreakLong,  title = "Confirm Long",  style = shape.labelup,   location = location.belowbar, color = color.new(color.lime, 0),    size = size.tiny)
plotshape(aAct and accumConfirmBreakShort, title = "Confirm Short", style = shape.labeldown, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)
plotshape(aAct and accumFakeBreakLong,   title = "Fake Long",    style = shape.xcross,       location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(aAct and accumFakeBreakShort,  title = "Fake Short",   style = shape.xcross,       location = location.belowbar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(aAct and accumRetestLong,      title = "Retest Long",  style = shape.diamond,      location = location.belowbar, color = color.new(color.aqua, 0),   size = size.tiny)
plotshape(aAct and accumRetestShort,     title = "Retest Short", style = shape.diamond,      location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(accumHigh,  "accumHigh",  display = display.data_window)
plot(accumLow,   "accumLow",   display = display.data_window)
plot(accumWidth, "accumWidth", display = display.data_window)
plot(accumMid,   "accumMid",   display = display.data_window)
plot(isAccum ? 1 : 0, "isAccum", display = display.data_window)
plot(accumBars,  "accumBars",  display = display.data_window)

plot(accumWidthRank,   "accumWidthRank",   display = display.data_window)
plot(accumBalanceRank, "accumBalanceRank", display = display.data_window)
plot(accumDriftRank,   "accumDriftRank",   display = display.data_window)
plot(accumQuality,     "accumQuality",     display = display.data_window)

plot(accumSignalType, "accumSignalType", display = display.data_window)
plot(accumDirection,  "accumDirection",  display = display.data_window)
plot(accumRank,       "accumRank",       display = display.data_window)

plot(accumBiasLong  ? 1 : 0, "accumBiasLong",  display = display.data_window)
plot(accumBiasShort ? 1 : 0, "accumBiasShort", display = display.data_window)
plot(accumNoTrade   ? 1 : 0, "accumNoTrade",   display = display.data_window)

plot(allowLongByAccum  ? 1 : 0, "allowLongByAccum",  display = display.data_window)
plot(allowShortByAccum ? 1 : 0, "allowShortByAccum", display = display.data_window)

plot(accumBreakLong  ? 1 : 0, "accumBreakLong",  display = display.data_window)
plot(accumBreakShort ? 1 : 0, "accumBreakShort", display = display.data_window)
plot(accumConfirmBreakLong  ? 1 : 0, "accumConfirmBreakLong",  display = display.data_window)
plot(accumConfirmBreakShort ? 1 : 0, "accumConfirmBreakShort", display = display.data_window)
plot(accumFakeBreakLong  ? 1 : 0, "accumFakeBreakLong",  display = display.data_window)
plot(accumFakeBreakShort ? 1 : 0, "accumFakeBreakShort", display = display.data_window)
plot(bullMSS ? 1 : 0, "bullMSS", display = display.data_window)
plot(bearMSS ? 1 : 0, "bearMSS", display = display.data_window)
plot(accumExpansion   ? 1 : 0, "accumExpansion",   display = display.data_window)
plot(accumCompression ? 1 : 0, "accumCompression", display = display.data_window)
plot(accumRetestLong  ? 1 : 0, "accumRetestLong",  display = display.data_window)
plot(accumRetestShort ? 1 : 0, "accumRetestShort", display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(aAct and accumBreakLong,        "Accum Break Long",   "{{ticker}} Accum 上抜け")
alertcondition(aAct and accumBreakShort,       "Accum Break Short",  "{{ticker}} Accum 下抜け")
alertcondition(aAct and accumConfirmBreakLong, "Accum Confirm Long", "{{ticker}} Accum 確定上抜け")
alertcondition(aAct and accumConfirmBreakShort,"Accum Confirm Short","{{ticker}} Accum 確定下抜け")
alertcondition(aAct and accumFakeBreakLong,    "Accum Fake Long",    "{{ticker}} Accum ダマシ上抜け")
alertcondition(aAct and accumFakeBreakShort,   "Accum Fake Short",   "{{ticker}} Accum ダマシ下抜け")
alertcondition(aAct and bullMSS,               "Accum Bull MSS",     "{{ticker}} Accum Bull MSS")
alertcondition(aAct and bearMSS,               "Accum Bear MSS",     "{{ticker}} Accum Bear MSS")
alertcondition(allowLongByAccum,               "Allow Long Accum",   "{{ticker}} Accum ロング許可")
alertcondition(allowShortByAccum,              "Allow Short Accum",  "{{ticker}} Accum ショート許可")
alertcondition(aAct and accumNoTrade,          "Accum NoTrade",      "{{ticker}} Accum ノートレード")

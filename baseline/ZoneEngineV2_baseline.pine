    float  bullBottom  = na
    int    bullOrigin  = na
    int    bullConfirm = na
    bool   bearNew     = false
    float  bearTop     = na
    float  bearBottom  = na
    int    bearOrigin  = na
    int    bearConfirm = na
    float  srcHigh     = na
    float  srcLow      = na
    float  srcClose    = na
    int    srcOpenTime = na
    int    srcCloseTime = na

// ---- 2.3 ZoneFeed ----------------------------------------------------------
//  Base は「確定した 5 分足 1 本」。time (足の開始時刻) と time_close
//  (確定時刻) を必ず分けて渡す。
export type ZoneFeed
    float  baseOpen      = na
    float  baseHigh      = na
    float  baseLow       = na
    float  baseClose     = na
    float  basePrevClose = na
    int    baseOpenTime  = na
    int    baseCloseTime = na
    int    baseSeq       = 0
    bool   baseConfirmed = false
    float  mintick       = na
    // MA (1分足 EMA と確定済み傾き)
    bool   maValid       = false
    float  ema1          = na
    float  ema1Delta     = na
    float  ema2          = na
    float  ema2Delta     = na
    int    maConfirmTime = na
    // 期間 ID (timezone 計算は呼び出し側の責務)
    int    sessionCode   = 0
    int    sessionId     = na
    int    dayId         = na
    int    weekId        = na
    // 外部足 helper の結果
    array<SwingIn> swings
    array<AccumIn> accums
    array<FvgIn>   fvgs

// ---- 2.4 Root --------------------------------------------------------------

// ============================================================
//  FVG 単体モジュール (Indicator版)
// ============================================================
//  ・FVG 関連ロジックだけを独立モジュール化したもの。
//  ・後で「環境認識 / フィボ / EMA」などの別モジュールと
//    接続できるように、出力変数を明確に定義してある。
//  ・strategy ではなく indicator。シグナル出力のみ行う。
//  ・ADX / HH・HL判定 / request.security は使わない。
//  ・現在足ベースで判定する。
// ============================================================

//@version=5
indicator(
     title          = "FVG Module",
     shorttitle     = "FVG",
     overlay        = true,
     max_bars_back  = 500,
     max_boxes_count  = 500,
     max_labels_count = 500
 )

// ============================================================
//  ON / OFF スイッチ
// ============================================================
grpSw = "ON/OFF"

useFVGModule        = input.bool(true, "FVGモジュール全体を使う",            group = grpSw)
useBullishFVG       = input.bool(true, "Bullish FVG を使う",                 group = grpSw)
useBearishFVG       = input.bool(true, "Bearish FVG を使う",                 group = grpSw)

useFVGRebound       = input.bool(true, "FVG反発を使う",                       group = grpSw)
useFVGAbsorption    = input.bool(true, "FVG吸収を使う",                       group = grpSw)
useIFVG             = input.bool(true, "iFVG を使う",                         group = grpSw)

useFVGThicknessFilter = input.bool(true,  "FVG厚みフィルターを使う",          group = grpSw)
useOppositeFVGFilter  = input.bool(true,  "逆側FVG近接フィルターを使う",      group = grpSw)
useFVGUsedFilter      = input.bool(true,  "使用済みFVGフィルターを使う",      group = grpSw)
useFVGAgeFilter       = input.bool(true,  "FVG年齢フィルターを使う",          group = grpSw)

useFVGConfirmBar    = input.bool(true, "確定足(barstate.isconfirmed)で判定", group = grpSw)

// ============================================================
//  調整パラメータ
// ============================================================
grpParam = "パラメータ"

fvgMaxAge           = input.int(100, "FVG最大年齢(本)",        minval = 1,   group = grpParam)
maxFVGPerSide       = input.int(20,  "片側 最大FVG保持数",     minval = 1,   group = grpParam)
atrLen              = input.int(14,  "ATR期間",                 minval = 1,   group = grpParam)

fvgMinThicknessATR  = input.float(0.30, "最低厚み (ATR倍率)",   minval = 0.0, step = 0.05, group = grpParam)
fvgMinThicknessPct  = input.float(0.0010,"最低厚み (close比率)", minval = 0.0, step = 0.0005, group = grpParam)
oppositeFVGNearATR  = input.float(0.50, "逆側FVG近接 (ATR倍率)",minval = 0.0, step = 0.05, group = grpParam)

reboundDepthMax     = input.float(0.50, "反発許容 割込み深さ(幅比率)", minval = 0.0, step = 0.05, group = grpParam)
absorbBodyMinRatio  = input.float(0.50, "吸収 実体最小比率(実体/レンジ)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)
absorbCloseEdgeRatio= input.float(0.35, "吸収 close端寄り比率",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)

// 厚みフィルターのどちらを使うか
grpThick = "厚み判定 方式"
useThicknessATR = input.bool(true,  "ATR倍率で判定",   group = grpThick)
useThicknessPct = input.bool(false, "close比率で判定", group = grpThick)

// ============================================================
//  反発確認条件 ON/OFF
// ============================================================
grpConf = "反発確認条件"

// BUY側 (Bullish FVG反発)
confBuyBull       = input.bool(true,  "BUY: 陽線",            group = grpConf)
confBuyLowerWick  = input.bool(true,  "BUY: 下ヒゲピンバー",  group = grpConf)
confBuyCloseUpper = input.bool(true,  "BUY: closeが上側",     group = grpConf)
confBuyCloseGtOpen= input.bool(true,  "BUY: close > open",    group = grpConf)
confBuyCloseGtBot = input.bool(true,  "BUY: close > FVG下端", group = grpConf)

// SELL側 (Bearish FVG反発)
confSellBear      = input.bool(true,  "SELL: 陰線",           group = grpConf)
confSellUpperWick = input.bool(true,  "SELL: 上ヒゲピンバー", group = grpConf)
confSellCloseLower= input.bool(true,  "SELL: closeが下側",    group = grpConf)
confSellCloseLtOpen=input.bool(true,  "SELL: close < open",   group = grpConf)
confSellCloseLtTop= input.bool(true,  "SELL: close < FVG上端",group = grpConf)

// ============================================================
//  表示 ON/OFF
// ============================================================
grpDisp = "表示"

showFVGBoxes           = input.bool(true,  "FVG box を表示",          group = grpDisp)
showFVGLabels          = input.bool(true,  "シグナルラベルを表示",    group = grpDisp)
showFVGDebugTable      = input.bool(true,  "デバッグテーブルを表示",  group = grpDisp)
showOnlyLatestFVGSignal= input.bool(false, "最新シグナルラベルのみ",  group = grpDisp)

colBull   = input.color(color.new(color.teal,   80), "Bullish FVG 色",  group = grpDisp)
colBear   = input.color(color.new(color.red,    80), "Bearish FVG 色",  group = grpDisp)
colAbsorb = input.color(color.new(color.orange, 70), "吸収済みFVG 色",  group = grpDisp)
colDead   = input.color(color.new(color.gray,   90), "Dead FVG 色",     group = grpDisp)

// ============================================================
//  基礎計算
// ============================================================
float atr = ta.atr(atrLen)

float rng    = high - low
float body   = math.abs(close - open)
float upWick = high - math.max(close, open)
float dnWick = math.min(close, open) - low
float clPos  = rng > 0 ? (close - low) / rng : 0.5     // 0=安値側, 1=高値側

bool confirmedBar = not useFVGConfirmBar or barstate.isconfirmed

// ============================================================
//  FVG 保存用 配列
// ============================================================
// Bullish FVG
var array<float> bullTopArr          = array.new_float()
var array<float> bullBotArr          = array.new_float()
var array<int>   bullBarArr          = array.new_int()
var array<bool>  bullReboundUsedArr  = array.new_bool()
var array<bool>  bullAbsorbUsedArr   = array.new_bool()
var array<bool>  bullDeadArr         = array.new_bool()
var array<box>   bullBoxArr          = array.new_box()

// Bearish FVG
var array<float> bearTopArr          = array.new_float()
var array<float> bearBotArr          = array.new_float()
var array<int>   bearBarArr          = array.new_int()
var array<bool>  bearReboundUsedArr  = array.new_bool()
var array<bool>  bearAbsorbUsedArr   = array.new_bool()
var array<bool>  bearDeadArr         = array.new_bool()
var array<box>   bearBoxArr          = array.new_box()

// ============================================================
//  共通ヘルパー
// ============================================================
// 厚み条件を満たすか
f_thicknessOK(width) =>
    bool ok = true
    if useFVGThicknessFilter
        bool a = not useThicknessATR or (width >= atr * fvgMinThicknessATR)
        bool p = not useThicknessPct or (close != 0 and (width / close) >= fvgMinThicknessPct)
        ok := a and p
    ok

// 価格より上側にある最近接の逆側FVG下端までの距離
f_nearestAbove(botArr, deadArr, price) =>
    float best = na
    if array.size(botArr) > 0
        for i = 0 to array.size(botArr) - 1
            if not array.get(deadArr, i)
                float b = array.get(botArr, i)
                if b > price
                    float d = b - price
                    best := na(best) ? d : math.min(best, d)
    best

// 価格より下側にある最近接の逆側FVG上端までの距離
f_nearestBelow(topArr, deadArr, price) =>
    float best = na
    if array.size(topArr) > 0
        for i = 0 to array.size(topArr) - 1
            if not array.get(deadArr, i)
                float t = array.get(topArr, i)
                if t < price
                    float d = price - t
                    best := na(best) ? d : math.min(best, d)
    best

// 片側の保持数制限 (古いものから削除)
f_trimSide(topA, botA, barA, rebA, absA, deadA, boxA) =>
    while array.size(topA) > maxFVGPerSide
        box b = array.shift(boxA)
        if not na(b)
            box.delete(b)
        array.shift(topA)
        array.shift(botA)
        array.shift(barA)
        array.shift(rebA)
        array.shift(absA)
        array.shift(deadA)

// ============================================================
//  出力変数 (毎足初期化される一時値)
// ============================================================
bool  buyRebound  = false
bool  sellRebound = false
bool  buyAbsorb   = false
bool  sellAbsorb  = false
bool  buyIFVG     = false
bool  sellIFVG    = false

bool  blockedByOpposite     = false
float nearestOppositeDist   = na

float actTop   = na
float actBot   = na
int   actAge   = na
float actWidth = na

float reboundTop = na
float reboundBot = na
float absorbTop  = na
float absorbBot  = na
float ifvgTop    = na
float ifvgBot    = na

// ============================================================
//  Bullish FVG の処理 (反発BUY / 吸収SELL / iFVG SELL)
// ============================================================
if useFVGModule and useBullishFVG and array.size(bullTopArr) > 0
    for i = 0 to array.size(bullTopArr) - 1
        float top  = array.get(bullTopArr, i)
        float bot  = array.get(bullBotArr, i)
        int   bbar = array.get(bullBarArr, i)
        bool  rUsed= array.get(bullReboundUsedArr, i)
        bool  aUsed= array.get(bullAbsorbUsedArr, i)
        bool  dead = array.get(bullDeadArr, i)
        float width= top - bot
        int   age  = bar_index - bbar

        // --- 年齢で dead 化 ---
        if useFVGAgeFilter and not dead and age > fvgMaxAge
            dead := true
            array.set(bullDeadArr, i, true)

        // 共通usableは「まだ無効化されていない」ことのみ。
        // 反発/吸収/iFVG は各判定内で個別に使用済み管理する。
        bool usable = not dead

        if usable and confirmedBar
            // ---------- 反発 BUY (サポートとして機能) ----------
            if useFVGRebound and (not useFVGUsedFilter or not rUsed)
                bool touch    = low <= top                       // ゾーンへ接触
                float depth   = (low < bot and width > 0) ? (bot - low) / width : 0.0
                bool notTooDeep = depth <= reboundDepthMax       // 深く割りすぎていない
                bool closeOK  = close >= bot                     // close がゾーン内/上で確定

                // 反発確認 (有効な条件すべてを満たす)
                bool conf = true
                conf := conf and (not confBuyBull        or close > open)
                conf := conf and (not confBuyLowerWick   or dnWick >= body)
                conf := conf and (not confBuyCloseUpper  or clPos >= 0.5)
                conf := conf and (not confBuyCloseGtOpen or close > open)
                conf := conf and (not confBuyCloseGtBot  or close > bot)

                if touch and notTooDeep and closeOK and conf
                    // 逆側 (Bearish FVG) 近接フィルター
                    bool blocked = false
                    if useOppositeFVGFilter
                        float d = f_nearestAbove(bearBotArr, bearDeadArr, close)
                        if not na(d)
                            nearestOppositeDist := na(nearestOppositeDist) ? d : math.min(nearestOppositeDist, d)
                            if d <= atr * oppositeFVGNearATR
                                blocked := true
                    if blocked
                        blockedByOpposite := true
                    else
                        buyRebound := true
                        reboundTop := top
                        reboundBot := bot
                        actTop  := top
                        actBot  := bot
                        actAge  := age
                        actWidth:= width
                        rUsed := true
                        array.set(bullReboundUsedArr, i, true)

            // ---------- 吸収 SELL (下抜け) ----------
            if useFVGAbsorption and (not useFVGUsedFilter or not aUsed)
                bool brokeDown = close < bot
                bool bigBody   = rng > 0 and (body / rng) >= absorbBodyMinRatio
                bool closeLow  = clPos <= absorbCloseEdgeRatio
                if brokeDown and bigBody and closeLow
                    sellAbsorb := true
                    absorbTop  := top
                    absorbBot  := bot
                    actTop  := top
                    actBot  := bot
                    actAge  := age
                    actWidth:= width
                    aUsed := true
                    array.set(bullAbsorbUsedArr, i, true)   // iFVG resistance 化

        // ---------- iFVG SELL (吸収済み Bullish FVG をレジスタンスとして) ----------
        if useIFVG and not dead and aUsed and confirmedBar
            bool back     = high >= bot                  // ゾーンへ戻り
            bool reject   = close < open                 // 反落 (陰線)
            bool closeOK2 = close <= top                 // ゾーン内/下で確定
            if back and reject and closeOK2
                sellIFVG := true
                ifvgTop  := top
                ifvgBot  := bot
                actTop   := top
                actBot   := bot
                actAge   := age
                actWidth := width
                dead := true
                array.set(bullDeadArr, i, true)          // iFVG発火後は使い切り

// ============================================================
//  Bearish FVG の処理 (反発SELL / 吸収BUY / iFVG BUY)
// ============================================================
if useFVGModule and useBearishFVG and array.size(bearTopArr) > 0
    for i = 0 to array.size(bearTopArr) - 1
        float top  = array.get(bearTopArr, i)
        float bot  = array.get(bearBotArr, i)
        int   bbar = array.get(bearBarArr, i)
        bool  rUsed= array.get(bearReboundUsedArr, i)
        bool  aUsed= array.get(bearAbsorbUsedArr, i)
        bool  dead = array.get(bearDeadArr, i)
        float width= top - bot
        int   age  = bar_index - bbar

        // --- 年齢で dead 化 ---
        if useFVGAgeFilter and not dead and age > fvgMaxAge
            dead := true
            array.set(bearDeadArr, i, true)

        // 共通usableは「まだ無効化されていない」ことのみ。
        // 反発/吸収/iFVG は各判定内で個別に使用済み管理する。
        bool usable = not dead

        if usable and confirmedBar
            // ---------- 反発 SELL (レジスタンスとして機能) ----------
            if useFVGRebound and (not useFVGUsedFilter or not rUsed)
                bool touch    = high >= bot                      // ゾーンへ接触
                float depth   = (high > top and width > 0) ? (high - top) / width : 0.0
                bool notTooDeep = depth <= reboundDepthMax       // 深く抜けすぎていない
                bool closeOK  = close <= top                     // close がゾーン内/下で確定

                // 反発確認
                bool conf = true
                conf := conf and (not confSellBear        or close < open)
                conf := conf and (not confSellUpperWick   or upWick >= body)
                conf := conf and (not confSellCloseLower  or clPos <= 0.5)
                conf := conf and (not confSellCloseLtOpen or close < open)
                conf := conf and (not confSellCloseLtTop  or close < top)

                if touch and notTooDeep and closeOK and conf
                    // 逆側 (Bullish FVG) 近接フィルター
                    bool blocked = false
                    if useOppositeFVGFilter
                        float d = f_nearestBelow(bullTopArr, bullDeadArr, close)
                        if not na(d)
                            nearestOppositeDist := na(nearestOppositeDist) ? d : math.min(nearestOppositeDist, d)
                            if d <= atr * oppositeFVGNearATR
                                blocked := true
                    if blocked
                        blockedByOpposite := true
                    else
                        sellRebound := true
                        reboundTop := top
                        reboundBot := bot
                        actTop  := top
                        actBot  := bot
                        actAge  := age
                        actWidth:= width
                        rUsed := true
                        array.set(bearReboundUsedArr, i, true)

            // ---------- 吸収 BUY (上抜け) ----------
            if useFVGAbsorption and (not useFVGUsedFilter or not aUsed)
                bool brokeUp  = close > top
                bool bigBody  = rng > 0 and (body / rng) >= absorbBodyMinRatio
                bool closeHigh= clPos >= (1.0 - absorbCloseEdgeRatio)
                if brokeUp and bigBody and closeHigh
                    buyAbsorb := true
                    absorbTop := top
                    absorbBot := bot
                    actTop  := top
                    actBot  := bot
                    actAge  := age
                    actWidth:= width
                    aUsed := true
                    array.set(bearAbsorbUsedArr, i, true)   // iFVG support 化

        // ---------- iFVG BUY (吸収済み Bearish FVG をサポートとして) ----------
        if useIFVG and not dead and aUsed and confirmedBar
            bool back     = low <= top                   // ゾーンへ戻り
            bool bounce   = close > open                 // 反発 (陽線)
            bool closeOK2 = close >= bot                 // ゾーン内/上で確定
            if back and bounce and closeOK2
                buyIFVG  := true
                ifvgTop  := top
                ifvgBot  := bot
                actTop   := top
                actBot   := bot
                actAge   := age
                actWidth := width
                dead := true
                array.set(bearDeadArr, i, true)

// ============================================================
//  新規 FVG の検出と保存
//  （シグナル判定後に追加 → 生成足では発火させない）
// ============================================================
// Bullish FVG: low > high[2]
bool newBullFVG = useFVGModule and useBullishFVG and (low > high[2])
if newBullFVG
    float bTop = low
    float bBot = high[2]
    float bWidth = bTop - bBot
    if bWidth > 0 and f_thicknessOK(bWidth)
        box bx = na
        if showFVGBoxes
            bx := box.new(bar_index - 2, bTop, bar_index, bBot, border_color = color.new(color.teal, 50), bgcolor = colBull)
        array.push(bullTopArr, bTop)
        array.push(bullBotArr, bBot)
        array.push(bullBarArr, bar_index)
        array.push(bullReboundUsedArr, false)
        array.push(bullAbsorbUsedArr, false)
        array.push(bullDeadArr, false)
        array.push(bullBoxArr, bx)
        f_trimSide(bullTopArr, bullBotArr, bullBarArr, bullReboundUsedArr, bullAbsorbUsedArr, bullDeadArr, bullBoxArr)

// Bearish FVG: high < low[2]
bool newBearFVG = useFVGModule and useBearishFVG and (high < low[2])
if newBearFVG
    float sTop = low[2]
    float sBot = high
    float sWidth = sTop - sBot
    if sWidth > 0 and f_thicknessOK(sWidth)
        box bx = na
        if showFVGBoxes
            bx := box.new(bar_index - 2, sTop, bar_index, sBot, border_color = color.new(color.red, 50), bgcolor = colBear)
        array.push(bearTopArr, sTop)
        array.push(bearBotArr, sBot)
        array.push(bearBarArr, bar_index)
        array.push(bearReboundUsedArr, false)
        array.push(bearAbsorbUsedArr, false)
        array.push(bearDeadArr, false)
        array.push(bearBoxArr, bx)
        f_trimSide(bearTopArr, bearBotArr, bearBarArr, bearReboundUsedArr, bearAbsorbUsedArr, bearDeadArr, bearBoxArr)

// ============================================================
//  box 更新 (右端を伸ばす / 状態で色変更)
// ============================================================
if showFVGBoxes and array.size(bullBoxArr) > 0
    for i = 0 to array.size(bullBoxArr) - 1
        box bx = array.get(bullBoxArr, i)
        if not na(bx)
            box.set_right(bx, bar_index)
            color c = array.get(bullDeadArr, i) ? colDead : array.get(bullAbsorbUsedArr, i) ? colAbsorb : colBull
            box.set_bgcolor(bx, c)
if showFVGBoxes and array.size(bearBoxArr) > 0
    for i = 0 to array.size(bearBoxArr) - 1
        box bx = array.get(bearBoxArr, i)
        if not na(bx)
            box.set_right(bx, bar_index)
            color c = array.get(bearDeadArr, i) ? colDead : array.get(bearAbsorbUsedArr, i) ? colAbsorb : colBear
            box.set_bgcolor(bx, c)

// ============================================================
//  個別シグナル出力
// ============================================================
bool fvgBuyReboundSignal  = buyRebound
bool fvgSellReboundSignal = sellRebound
bool fvgBuyAbsorbSignal   = buyAbsorb
bool fvgSellAbsorbSignal  = sellAbsorb
bool fvgBuyIFVGSignal     = buyIFVG
bool fvgSellIFVGSignal    = sellIFVG

// 反発ゾーン出力
bool  fvgBuyReboundZone  = not na(reboundBot) and buyRebound
bool  fvgSellReboundZone = not na(reboundTop) and sellRebound
float fvgReboundTop      = reboundTop
float fvgReboundBottom   = reboundBot

// 吸収ゾーン出力
float fvgAbsorbTop    = absorbTop
float fvgAbsorbBottom = absorbBot

// iFVGゾーン出力
float fvgIFVGTop    = ifvgTop
float fvgIFVGBottom = ifvgBot

// 逆側フィルター出力
bool  fvgBlockedByOpposite      = blockedByOpposite
float nearestOppositeFVGDistance= nearestOppositeDist

// ============================================================
//  集約出力
// ============================================================
bool anyBuy  = fvgBuyReboundSignal  or fvgBuyAbsorbSignal  or fvgBuyIFVGSignal
bool anySell = fvgSellReboundSignal or fvgSellAbsorbSignal or fvgSellIFVGSignal

// fvgSignalType : 0=なし / 1=Rebound / 2=Absorption / 3=iFVG  (優先度 反発>吸収>iFVG)
int fvgSignalType = (fvgBuyReboundSignal or fvgSellReboundSignal) ? 1 :
                     (fvgBuyAbsorbSignal or fvgSellAbsorbSignal)  ? 2 :
                     (fvgBuyIFVGSignal   or fvgSellIFVGSignal)    ? 3 : 0

// fvgDirection : 1=BUY / -1=SELL / 0=なし
int fvgDirection = anyBuy ? 1 : anySell ? -1 : 0

bool fvgSignal = anyBuy or anySell
bool fvgActive = array.size(bullTopArr) > 0 or array.size(bearTopArr) > 0

// 反発方向 (反発シグナル限定)
int fvgReboundDirection = fvgBuyReboundSignal ? 1 : fvgSellReboundSignal ? -1 : 0
int fvgAbsorbDirection  = fvgBuyAbsorbSignal  ? 1 : fvgSellAbsorbSignal  ? -1 : 0
int fvgIFVGDirection    = fvgBuyIFVGSignal    ? 1 : fvgSellIFVGSignal    ? -1 : 0

// アクティブゾーン (シグナルが無い場合は最新の有効FVGを採用)
if na(actTop)
    if array.size(bullBarArr) > 0 and array.size(bearBarArr) > 0
        int lb = array.get(bullBarArr, array.size(bullBarArr) - 1)
        int sb = array.get(bearBarArr, array.size(bearBarArr) - 1)
        if lb >= sb
            actTop  := array.get(bullTopArr, array.size(bullTopArr) - 1)
            actBot  := array.get(bullBotArr, array.size(bullBotArr) - 1)
            actAge  := bar_index - lb
        else
            actTop  := array.get(bearTopArr, array.size(bearTopArr) - 1)
            actBot  := array.get(bearBotArr, array.size(bearBotArr) - 1)
            actAge  := bar_index - sb
        actWidth := actTop - actBot
    else if array.size(bullBarArr) > 0
        actTop  := array.get(bullTopArr, array.size(bullTopArr) - 1)
        actBot  := array.get(bullBotArr, array.size(bullBotArr) - 1)
        actAge  := bar_index - array.get(bullBarArr, array.size(bullBarArr) - 1)
        actWidth := actTop - actBot
    else if array.size(bearBarArr) > 0
        actTop  := array.get(bearTopArr, array.size(bearTopArr) - 1)
        actBot  := array.get(bearBotArr, array.size(bearBotArr) - 1)
        actAge  := bar_index - array.get(bearBarArr, array.size(bearBarArr) - 1)
        actWidth := actTop - actBot

float fvgActiveTop    = actTop
float fvgActiveBottom = actBot
int   fvgActiveAge    = actAge
float fvgActiveWidth  = actWidth

// ============================================================
//  接続用 出力 (他モジュールが参照する)
// ============================================================
bool isFVGRebound    = fvgBuyReboundSignal or fvgSellReboundSignal
bool isFVGAbsorption = fvgBuyAbsorbSignal  or fvgSellAbsorbSignal
bool isIFVG          = fvgBuyIFVGSignal    or fvgSellIFVGSignal

bool allowEntryLongByFVG  = anyBuy  and not fvgBlockedByOpposite
bool allowEntryShortByFVG = anySell and not fvgBlockedByOpposite

// ============================================================
//  表示 : シグナルラベル
// ============================================================
var label lastSignalLabel = na

// ラベル生成のみ行う (グローバルvarはこの関数の外で管理)
f_mkLabel(isBuy, txt, col) =>
    label.new(
         bar_index,
         isBuy ? low : high,
         txt,
         style     = isBuy ? label.style_label_up : label.style_label_down,
         color     = col,
         textcolor = color.white,
         yloc      = isBuy ? yloc.belowbar : yloc.abovebar,
         size      = size.small)

if showFVGLabels and fvgSignal
    // 「最新のみ」表示なら以前のラベルを消す
    if showOnlyLatestFVGSignal and not na(lastSignalLabel)
        label.delete(lastSignalLabel)
    label lb = na
    if fvgBuyReboundSignal
        lb := f_mkLabel(true,  "FVG↑ Rebound", color.new(color.green, 0))
    if fvgSellReboundSignal
        lb := f_mkLabel(false, "FVG↓ Rebound", color.new(color.red, 0))
    if fvgBuyAbsorbSignal
        lb := f_mkLabel(true,  "FVG↑ Absorb",  color.new(color.lime, 0))
    if fvgSellAbsorbSignal
        lb := f_mkLabel(false, "FVG↓ Absorb",  color.new(color.maroon, 0))
    if fvgBuyIFVGSignal
        lb := f_mkLabel(true,  "iFVG↑ BUY",    color.new(color.aqua, 0))
    if fvgSellIFVGSignal
        lb := f_mkLabel(false, "iFVG↓ SELL",   color.new(color.fuchsia, 0))
    if showOnlyLatestFVGSignal
        lastSignalLabel := lb

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
var table dbg = table.new(position.top_right, 2, 8, border_width = 1)

if showFVGDebugTable and barstate.islast
    string sType = fvgSignalType == 1 ? "Rebound" : fvgSignalType == 2 ? "Absorption" : fvgSignalType == 3 ? "iFVG" : "-"
    string sDir  = fvgDirection == 1 ? "BUY" : fvgDirection == -1 ? "SELL" : "-"

    table.cell(dbg, 0, 0, "FVG Module", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, fvgActive ? "ACTIVE" : "idle",   text_color = color.white, bgcolor = color.new(color.blue, 0))

    table.cell(dbg, 0, 1, "Signal Type",  text_color = color.white)
    table.cell(dbg, 1, 1, sType,          text_color = color.white)

    table.cell(dbg, 0, 2, "Direction",    text_color = color.white)
    table.cell(dbg, 1, 2, sDir,           text_color = color.white)

    table.cell(dbg, 0, 3, "Active Top",   text_color = color.white)
    table.cell(dbg, 1, 3, na(fvgActiveTop)    ? "-" : str.tostring(fvgActiveTop,    format.mintick), text_color = color.white)

    table.cell(dbg, 0, 4, "Active Bottom",text_color = color.white)
    table.cell(dbg, 1, 4, na(fvgActiveBottom) ? "-" : str.tostring(fvgActiveBottom, format.mintick), text_color = color.white)

    table.cell(dbg, 0, 5, "Age",          text_color = color.white)
    table.cell(dbg, 1, 5, na(fvgActiveAge)    ? "-" : str.tostring(fvgActiveAge),  text_color = color.white)

    table.cell(dbg, 0, 6, "Width",        text_color = color.white)
    table.cell(dbg, 1, 6, na(fvgActiveWidth)  ? "-" : str.tostring(fvgActiveWidth,  format.mintick), text_color = color.white)

    table.cell(dbg, 0, 7, "Blocked Opp.", text_color = color.white)
    table.cell(dbg, 1, 7, fvgBlockedByOpposite ? "true" : "false", text_color = fvgBlockedByOpposite ? color.red : color.white)

// ============================================================
//  プロット (接続モジュールから参照しやすいよう値も出す)
// ============================================================
plotshape(fvgBuyReboundSignal,  title = "BUY Rebound",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0),  size = size.tiny)
plotshape(fvgSellReboundSignal, title = "SELL Rebound", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),    size = size.tiny)
plotshape(fvgBuyAbsorbSignal,   title = "BUY Absorb",   style = shape.diamond,      location = location.belowbar, color = color.new(color.lime, 0),   size = size.tiny)
plotshape(fvgSellAbsorbSignal,  title = "SELL Absorb",  style = shape.diamond,      location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(fvgBuyIFVGSignal,     title = "BUY iFVG",     style = shape.circle,       location = location.belowbar, color = color.new(color.aqua, 0),   size = size.tiny)
plotshape(fvgSellIFVGSignal,    title = "SELL iFVG",    style = shape.circle,       location = location.abovebar, color = color.new(color.fuchsia, 0),size = size.tiny)

plot(fvgDirection,  title = "fvgDirection",  display = display.data_window)
plot(fvgSignalType, title = "fvgSignalType", display = display.data_window)
plot(fvgActiveTop,    title = "fvgActiveTop",    display = display.data_window)
plot(fvgActiveBottom, title = "fvgActiveBottom", display = display.data_window)
plot(fvgActiveAge,    title = "fvgActiveAge",    display = display.data_window)
plot(fvgActiveWidth,  title = "fvgActiveWidth",  display = display.data_window)
plot(nearestOppositeFVGDistance, title = "nearestOppositeFVGDistance", display = display.data_window)
plot(allowEntryLongByFVG  ? 1 : 0, title = "allowEntryLongByFVG",  display = display.data_window)
plot(allowEntryShortByFVG ? 1 : 0, title = "allowEntryShortByFVG", display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(fvgBuyReboundSignal,  title = "FVG BUY Rebound",  message = "{{ticker}} FVG反発BUY ({{close}})")
alertcondition(fvgSellReboundSignal, title = "FVG SELL Rebound", message = "{{ticker}} FVG反発SELL ({{close}})")
alertcondition(fvgBuyAbsorbSignal,   title = "FVG BUY Absorb",   message = "{{ticker}} FVG吸収BUY ({{close}})")
alertcondition(fvgSellAbsorbSignal,  title = "FVG SELL Absorb",  message = "{{ticker}} FVG吸収SELL ({{close}})")
alertcondition(fvgBuyIFVGSignal,     title = "iFVG BUY",         message = "{{ticker}} iFVG BUY ({{close}})")
alertcondition(fvgSellIFVGSignal,    title = "iFVG SELL",        message = "{{ticker}} iFVG SELL ({{close}})")
alertcondition(allowEntryLongByFVG,  title = "Allow Entry Long (FVG)",  message = "{{ticker}} FVGロング許可 ({{close}})")
alertcondition(allowEntryShortByFVG, title = "Allow Entry Short (FVG)", message = "{{ticker}} FVGショート許可 ({{close}})")

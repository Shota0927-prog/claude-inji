// ============================================================================
//  Zone Sync Probe 受信 (ZSP-0R)  —  検証専用。外部接続 (input.source) で 5分基準の値がどう届くかを確かめる。
// ----------------------------------------------------------------------------
//  同じチャートに ZSP-0 (ZoneSyncProbe.pine) を追加し、下の 5 項目に ZSP-0 の同じ名前の系列を選ぶ。
//   ・届いた値 (処理済み 5分足数・最後に確定した 5分足) が ZSP-0 の表と同じか
//   ・チャート足 1 本ごとに届いた値で、5分更新が 1 つずつ見えるか (見えなかった更新 = 外部接続では受け取れない途中の更新)
//   ・リアルタイムで、月足などの形成中の足でも 5分ごとに値が変わるか、ティックで逆戻り・重複がないか
//  外部の値は「その外部インジがこのチャート足で計算した値」であり、5分ごとの途中の値はチャート足 1 本につき 1 つしか届かない。
//  ★ TradingView 実機でのコンパイル・表示は未実施 (ZONE_SYNC_FEASIBILITY_ja.md §5)。
// ============================================================================

//@version=5
indicator("Zone Sync Probe 受信 (ZSP-0R)", "ZSP0R", overlay = true)

zrProto = input.source(close, "ZSP protocol")
zrN     = input.source(close, "ZSP 処理済み5分足数")
zrCk    = input.source(close, "ZSP チェックサム")
zrT     = input.source(close, "ZSP 最後に確定した5分足の開始時刻")
zrC     = input.source(close, "ZSP 最後に確定した5分足の確定時刻")
zrTbl   = input.bool(true, "表を表示")

bool zrOK = not na(zrProto) and zrProto == 30001

// ヒストリカル: チャート足 1 本の値として見えた / 見えなかった 5分更新
var int   zrHChg  = 0
var int   zrHMiss = 0
var float zrHPrev = na
if zrOK and barstate.ishistory and not na(zrN)
    if not na(zrHPrev) and zrN != zrHPrev
        zrHChg += 1
        if zrN - zrHPrev > 1
            zrHMiss += int(zrN - zrHPrev - 1)
    zrHPrev := zrN

// リアルタイム: 値が変わった回数・飛び・逆戻り・同じ 5分足で処理数だけ変わった (重複処理の疑い)
varip int   zrRtTicks = 0
varip int   zrRtSeen  = 0
varip int   zrRtJump  = 0
varip int   zrRtBack  = 0
varip int   zrRtDup   = 0
varip float zrRtPrevT = na
varip float zrRtPrevN = na
if zrOK and barstate.isrealtime and not na(zrT) and not na(zrN)
    zrRtTicks += 1
    if na(zrRtPrevT) or zrT != zrRtPrevT or zrN != zrRtPrevN
        if not na(zrRtPrevN)
            if zrT == zrRtPrevT and zrN != zrRtPrevN
                zrRtDup += 1
            if zrN - zrRtPrevN > 1
                zrRtJump += int(zrN - zrRtPrevN - 1)
            if zrN < zrRtPrevN or zrT < zrRtPrevT
                zrRtBack += 1
        zrRtSeen  += 1
        zrRtPrevT := zrT
        zrRtPrevN := zrN

f_zrTm(float t) =>
    na(t) ? "na" : str.format_time(int(t), "yyyy-MM-dd HH:mm", syminfo.timezone)

var table zrTb = table.new(position.middle_right, 2, 10, border_width = 1)
f_zrRow(int r, string a, string b) =>
    table.cell(zrTb, 0, r, a, text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(zrTb, 1, r, b, text_color = color.white, bgcolor = color.new(color.maroon, 20), text_size = size.small)
    true

if zrTbl and barstate.islast
    f_zrRow(0, "チャート足 / 接続", timeframe.period + " / " + (zrOK ? "ZSP-0 (30001)" : "未接続・誤接続"))
    f_zrRow(1, "受信: 最後に確定した5分足", f_zrTm(zrT) + " (確定 " + f_zrTm(zrC) + ")")
    f_zrRow(2, "受信: 署名", str.tostring(zrN, "#") + "/" + str.tostring(zrCk, "#") + "/" + f_zrTm(zrT))
    f_zrRow(3, "履歴: 見えた更新 / 見えなかった更新", str.tostring(zrHChg) + " / " + str.tostring(zrHMiss))
    f_zrRow(4, "RT: ティック / 値の変化", str.tostring(zrRtTicks) + " / " + str.tostring(zrRtSeen))
    f_zrRow(5, "RT: 飛び / 逆戻り / 同じ足で処理数だけ変化", str.tostring(zrRtJump) + " / " + str.tostring(zrRtBack) + " / " + str.tostring(zrRtDup))

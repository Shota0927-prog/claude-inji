// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © ka.mickey15
//
// ============================================================
//  Multi-Module Strategy Template (統合ストラテジー雛形)
// ------------------------------------------------------------
//  4つの独立モジュールを 1 本の strategy に統合した雛形。
//    1. Environment Recognition  (環境認識 / 上位足トレンド)
//    2. Fast Volatility Filter   (高速ボラフィルター / NoTrade)
//    3. Entry Trigger            (エントリートリガー)
//    4. Trade Management         (建値移動 / 部分利確 / 再エントリー / Fib・N値 TP)
//
//  ▼ 流れ:
//    ENV.allowLong/Short  ─┐
//    VOL.allowLong/Short  ─┼─► entrySignalLong/Short ─► Trade Management ─► strategy.entry/exit
//    TRIG.allowLong/Short ─┘
//
//  ・各モジュールは個別に ON/OFF・ゲート採用可否を選択可能。
//  ・request.security はすべて lookahead_off でリペイント回避。
//  ・エントリー実行は Trade Management に集約 (二重発注回避)。
// ============================================================

//@version=5
strategy(
     title                 = "Multi-Module Strategy Template",
     shorttitle            = "MMS-TPL",
     overlay               = true,
     max_bars_back         = 1000,
     max_labels_count      = 500,
     max_lines_count       = 50,
     pyramiding            = 1,
     process_orders_on_close = true,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     initial_capital       = 10000,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.0,
     calc_on_every_tick    = false
 )


// ════════════════════════════════════════════════════════════
//  MODULE 1 : Environment Recognition (環境認識)
// ════════════════════════════════════════════════════════════

// ------------------------------------------------------------
//  1-1. 入力 : 時間足の ON/OFF と参照時間足
// ------------------------------------------------------------
grpTF = "ENV : 時間足 ON/OFF / 参照時間足"
useTrend4H  = input.bool(true,  "4H 検出 ON",  group = grpTF, inline = "tf4")
tf4H        = input.timeframe("240", "TF",     group = grpTF, inline = "tf4")
useTrend1H  = input.bool(true,  "1H 検出 ON",  group = grpTF, inline = "tf1")
tf1H        = input.timeframe("60",  "TF",     group = grpTF, inline = "tf1")
useTrend15M = input.bool(true,  "15M 検出 ON", group = grpTF, inline = "tf15")
tf15M       = input.timeframe("15",  "TF",     group = grpTF, inline = "tf15")
useTrend5M  = input.bool(true,  "5M 検出 ON",  group = grpTF, inline = "tf5")
tf5M        = input.timeframe("5",   "TF",     group = grpTF, inline = "tf5")
useTrend1M  = input.bool(true,  "1M 検出 ON",  group = grpTF, inline = "tf1m")
tf1M        = input.timeframe("1",   "TF",     group = grpTF, inline = "tf1m")

// ------------------------------------------------------------
//  1-2. 入力 : 上昇条件 ON/OFF
// ------------------------------------------------------------
grpBull = "ENV : 上昇条件 ON/OFF"
useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50",          group = grpBull)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き",          group = grpBull)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き",          group = grpBull)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50",          group = grpBull)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200",         group = grpBull)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い",     group = grpBull)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中",       group = grpBull)

// ------------------------------------------------------------
//  1-3. 入力 : 下降条件 ON/OFF
// ------------------------------------------------------------
grpBear = "ENV : 下降条件 ON/OFF"
useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50",          group = grpBear)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き",          group = grpBear)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き",          group = grpBear)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50",          group = grpBear)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200",         group = grpBear)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い",     group = grpBear)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中",       group = grpBear)

// ------------------------------------------------------------
//  1-4. 入力 : レンジ条件 ON/OFF
// ------------------------------------------------------------
grpRange = "ENV : レンジ条件 ON/OFF"
useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い",        group = grpRange)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い",          group = grpRange)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い",          group = grpRange)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中",           group = grpRange)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ",  group = grpRange)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ",  group = grpRange)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい",          group = grpRange)

// ------------------------------------------------------------
//  1-5. 入力 : 調整パラメータ
// ------------------------------------------------------------
grpParam = "ENV : 調整パラメータ"
len20        = input.int(20,   "EMA20 length",              minval = 1, group = grpParam)
len50        = input.int(50,   "EMA50 length",              minval = 1, group = grpParam)
len200       = input.int(200,  "EMA200 length",             minval = 1, group = grpParam)
atrLen       = input.int(14,   "ATR length",                minval = 1, group = grpParam)
slopeBars    = input.int(3,    "EMA 傾き判定本数",           minval = 1, group = grpParam)
slopeMinMult = input.float(0.10, "EMA 傾きの最低値 ATR倍率",  minval = 0, step = 0.01, group = grpParam)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
distNarrowMult = input.float(0.20, "EMA20/50 距離 近い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
convDivBars  = input.int(5,    "収束/拡散 判定本数",         minval = 1, group = grpParam)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数",       minval = 1, group = grpParam)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数",       minval = 1, group = grpParam)
rangeBars    = input.int(20,   "レンジ幅 判定本数",          minval = 1, group = grpParam)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率",          minval = 0, step = 0.1, group = grpParam)

// ------------------------------------------------------------
//  1-6. 入力 : 判定ルール
// ------------------------------------------------------------
grpJudge = "ENV : 判定ルール"
tieAsRange          = input.bool(true, "同点時にレンジ扱いする",     group = grpJudge)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = grpJudge)
minScore4H  = input.int(3, "4H 最低必要スコア",  minval = 1, group = grpJudge)
minScore1H  = input.int(3, "1H 最低必要スコア",  minval = 1, group = grpJudge)
minScore15M = input.int(3, "15M 最低必要スコア", minval = 1, group = grpJudge)
minScore5M  = input.int(3, "5M 最低必要スコア",  minval = 1, group = grpJudge)
minScore1M  = input.int(3, "1M 最低必要スコア",  minval = 1, group = grpJudge)

// ------------------------------------------------------------
//  1-7. 入力 : セッション
// ------------------------------------------------------------
grpSess = "ENV : セッション判定"
useAsiaSession = input.bool(true, "Asia セッション ON", group = grpSess)
useEUSession   = input.bool(true, "EU セッション ON",   group = grpSess)
useUSSession   = input.bool(true, "US セッション ON",   group = grpSess)
sessTZ   = input.string("GMT", "セッション タイムゾーン", group = grpSess)
asiaSess = input.session("0000-0900", "Asia 時間", group = grpSess)
euSess   = input.session("0800-1700", "EU 時間",   group = grpSess)
usSess   = input.session("1300-2200", "US 時間",   group = grpSess)

// ------------------------------------------------------------
//  1-8. 入力 : 環境フィルター (ゲート条件)
// ------------------------------------------------------------
grpLink = "ENV : 環境フィルター"
reqLongCount  = input.int(2, "ロング許可に必要な上昇TF数",   minval = 1, group = grpLink)
reqShortCount = input.int(2, "ショート許可に必要な下降TF数", minval = 1, group = grpLink)
reqRangeCount = input.int(2, "レンジ環境に必要なレンジTF数", minval = 1, group = grpLink)

// ------------------------------------------------------------
//  1-9. 入力 : 表示
// ------------------------------------------------------------
grpDisp = "ENV : 表示設定"
showTable = input.bool(true, "ENVテーブルを表示", group = grpDisp)
tableMode = input.string("簡易", "テーブル表示モード", options = ["簡易", "詳細"], group = grpDisp)
colUp     = input.color(color.new(color.green, 0), "上昇カラー",  group = grpDisp)
colDown   = input.color(color.new(color.red,   0), "下降カラー",  group = grpDisp)
colRange  = input.color(color.new(color.gray,  0), "レンジカラー", group = grpDisp)
colOff    = input.color(color.new(color.black, 0), "OFFカラー",   group = grpDisp)

// ------------------------------------------------------------
//  1-10. 環境判定関数
//  戻り値 : [trend, bullScore, bearScore, rangeScore]
//           trend = 1=上昇 / 0=レンジ / -1=下降 / na=未判定
// ------------------------------------------------------------
f_envTrend(int minScore) =>
    // --- 基礎値 ---
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(atrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    // 価格が EMA を跨いだ回数
    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    // --- 上昇スコア ---
    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    // --- 下降スコア ---
    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    // --- レンジスコア ---
    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    // --- 総合判定 ---
    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na          // 条件不足
    else if tie
        trend := tieAsRange ? 0 : na                   // 同点
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    [trend, bullScore, bearScore, rangeScore]

// ------------------------------------------------------------
//  1-11. 各時間足の判定取得 (request.security / lookahead_off)
// ------------------------------------------------------------
[raw4H,  bull4H,  bear4H,  range4H ] = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
[raw1H,  bull1H,  bear1H,  range1H ] = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
[raw15M, bull15M, bear15M, range15M] = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)
[raw5M,  bull5M,  bear5M,  range5M ] = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
[raw1M,  bull1M,  bear1M,  range1M ] = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

// OFF の時間足は na
trend4H  = useTrend4H  ? raw4H  : na
trend1H  = useTrend1H  ? raw1H  : na
trend15M = useTrend15M ? raw15M : na
trend5M  = useTrend5M  ? raw5M  : na
trend1M  = useTrend1M  ? raw1M  : na

// ------------------------------------------------------------
//  1-12. セッション判定
// ------------------------------------------------------------
isAsia = useAsiaSession and not na(time(timeframe.period, asiaSess, sessTZ))
isEU   = useEUSession   and not na(time(timeframe.period, euSess,   sessTZ))
isUS   = useUSSession   and not na(time(timeframe.period, usSess,   sessTZ))

string activeSessionName = isAsia ? "Asia" : ""
activeSessionName := isEU ? (activeSessionName == "" ? "EU" : activeSessionName + "/EU") : activeSessionName
activeSessionName := isUS ? (activeSessionName == "" ? "US" : activeSessionName + "/US") : activeSessionName
activeSessionName := activeSessionName == "" ? "Other" : activeSessionName

// ------------------------------------------------------------
//  1-13. 環境ゲート bool
// ------------------------------------------------------------
upCount = (useTrend4H  and trend4H  == 1 ? 1 : 0) + (useTrend1H  and trend1H  == 1 ? 1 : 0) + (useTrend15M and trend15M == 1 ? 1 : 0) + (useTrend5M  and trend5M  == 1 ? 1 : 0) + (useTrend1M  and trend1M  == 1 ? 1 : 0)
dnCount = (useTrend4H  and trend4H  == -1 ? 1 : 0) + (useTrend1H  and trend1H  == -1 ? 1 : 0) + (useTrend15M and trend15M == -1 ? 1 : 0) + (useTrend5M  and trend5M  == -1 ? 1 : 0) + (useTrend1M  and trend1M  == -1 ? 1 : 0)
rgCount = (useTrend4H  and trend4H  == 0 ? 1 : 0) + (useTrend1H  and trend1H  == 0 ? 1 : 0) + (useTrend15M and trend15M == 0 ? 1 : 0) + (useTrend5M  and trend5M  == 0 ? 1 : 0) + (useTrend1M  and trend1M  == 0 ? 1 : 0)

allowLongByEnvironment  = upCount >= reqLongCount
allowShortByEnvironment = dnCount >= reqShortCount
isRangeEnvironment      = rgCount >= reqRangeCount

// ------------------------------------------------------------
//  1-14. 表示用ヘルパー
// ------------------------------------------------------------
f_cellTxt(bool useTF, float trend) =>
    not useTF      ? "OFF" :
     na(trend)     ? "未判定" :
     trend ==  1   ? "上昇" :
     trend == -1   ? "下降" : "レンジ"

f_cellCol(bool useTF, float trend) =>
    not useTF      ? colOff :
     na(trend)     ? colRange :
     trend ==  1   ? colUp :
     trend == -1   ? colDown : colRange

f_sessCol(string s) =>
    s == "Other" ? colOff : colRange

f_scoreTxt(bool useTF, float score) =>
    not useTF ? "OFF" : str.tostring(score)

f_scoreCol(bool useTF, color baseCol) =>
    not useTF ? colOff : color.new(baseCol, 60)

// ------------------------------------------------------------
//  1-15. テーブル表示 (右上)
// ------------------------------------------------------------
var table envTable = table.new(position.top_right, 4, 7, border_width = 1)

isDetail = tableMode == "詳細"

if showTable and barstate.islast
    // --- ヘッダー ---
    table.cell(envTable, 0, 0, "環境認識", text_color = color.white, bgcolor = color.new(color.blue, 0))
    if isDetail
        table.cell(envTable, 1, 0, "上昇", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 2, 0, "下降", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 3, 0, "レンジ", text_color = color.white, bgcolor = color.new(color.blue, 0))
    else
        table.cell(envTable, 1, 0, "状態", text_color = color.white, bgcolor = color.new(color.blue, 0))

    // --- 各時間足 (行1〜5) ---
    labels  = array.from("4H", "1H", "15M", "5M", "1M")
    useArr  = array.from(useTrend4H, useTrend1H, useTrend15M, useTrend5M, useTrend1M)
    trArr   = array.from(trend4H, trend1H, trend15M, trend5M, trend1M)
    bullArr = array.from(bull4H, bull1H, bull15M, bull5M, bull1M)
    bearArr = array.from(bear4H, bear1H, bear15M, bear5M, bear1M)
    rngArr  = array.from(range4H, range1H, range15M, range5M, range1M)

    for i = 0 to 4
        row   = i + 1
        useTF = array.get(useArr, i)
        table.cell(envTable, 0, row, array.get(labels, i), text_color = color.white, bgcolor = color.new(color.gray, 30))
        if isDetail
            table.cell(envTable, 1, row, f_scoreTxt(useTF, array.get(bullArr, i)), text_color = color.white, bgcolor = f_scoreCol(useTF, colUp))
            table.cell(envTable, 2, row, f_scoreTxt(useTF, array.get(bearArr, i)), text_color = color.white, bgcolor = f_scoreCol(useTF, colDown))
            table.cell(envTable, 3, row, f_scoreTxt(useTF, array.get(rngArr, i)),  text_color = color.white, bgcolor = f_scoreCol(useTF, colRange))
        else
            tr = array.get(trArr, i)
            table.cell(envTable, 1, row, f_cellTxt(useTF, tr), text_color = color.white, bgcolor = f_cellCol(useTF, tr))

    // --- セッション (行6) ---
    table.cell(envTable, 0, 6, "セッション", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(envTable, 1, 6, activeSessionName, text_color = color.white, bgcolor = f_sessCol(activeSessionName))


// ════════════════════════════════════════════════════════════
//  MODULE 2 : Fast Volatility Filter (高速ボラフィルター)
// ════════════════════════════════════════════════════════════
grpVol = "VOL : Fast Volatility Module"

useVolModule = input.bool(true, "Volモジュールを使う", group = grpVol)

showVolDebugTable = input.bool(true, "Debug Tableを表示",   group = grpVol)
showVolBg         = input.bool(true, "低ボラ背景を表示",     group = grpVol)
showVolLabels     = input.bool(true, "Volラベルを表示",      group = grpVol)

atrLenBase = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf      = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)

useMinVol    = input.bool(true, "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5, "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)

volModeRel  = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen   = input.int(480, "ATR平均本数", minval = 10, group = grpVol)
volRatioMin = input.float(0.9, "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)

useFastVol = input.bool(true, "高速ボラフィルター", group = grpVol)
fastAtrLen = input.int(5, "fastATR本数", minval = 1, group = grpVol)
fastAtrMin = input.float(2.2, "fastATR最低($)", step = 0.1, group = grpVol)

bodyAvgLen = input.int(5, "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin = input.float(0.5, "実体平均最低($)", step = 0.1, group = grpVol)

useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う", group = grpVol)
rangeLookback       = input.int(20, "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)

useVolExpansion      = input.bool(true, "ボラ拡大判定を使う", group = grpVol)
volExpansionLookback = input.int(3, "ボラ拡大判定本数", minval = 1, group = grpVol)

useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2, "低ボラ解除後の待機本数", minval = 1, group = grpVol)

bool vAct = useVolModule

// --- 2-3. 基本計算 ---
float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
float atrAvg  = ta.sma(baseAtr, volAvgLen)
float fastAtr = ta.atr(fastAtrLen)
float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)

float rangeHigh = ta.highest(high, rangeLookback)
float rangeLow  = ta.lowest(low,  rangeLookback)
float rangeWidth = rangeHigh - rangeLow
float atrRangeRatio = rangeWidth > 0 ? fastAtr / rangeWidth : 0.0

// --- 2-4. 低ボラ判定 ---
bool volAbsOk = baseAtr >= minAtrDollar
bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
bool volBaseOk = not useMinVol or (volModeRel ? volRelOk : volAbsOk)

// --- 2-5. 高速ボラフィルター ---
bool fastAtrOk    = not useFastVol or fastAtr >= fastAtrMin
bool bodyAvgOk    = not useFastVol or bodyAvgFast >= bodyAvgMin
bool rangeRatioOk = not useFastVol or not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
bool fastVolOk    = not useFastVol or (fastAtrOk and bodyAvgOk and rangeRatioOk)

// --- 2-6. ボラ拡大判定 ---
bool volExpanding   = useVolExpansion and fastAtr > fastAtr[volExpansionLookback] and baseAtr >= baseAtr[volExpansionLookback]
bool volContracting = fastAtr < fastAtr[volExpansionLookback] and baseAtr < baseAtr[volExpansionLookback]

// --- 2-7. 最終Vol判定 ---
bool volOk  = useVolModule and volBaseOk and fastVolOk
bool volLow = useVolModule and not volOk

// 低ボラ解除後の待機
var int volRecoveryStartBar = na
if volLow
    volRecoveryStartBar := na
if not volLow and nz(volLow[1], false)
    volRecoveryStartBar := bar_index

bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars
bool finalVolOk = volOk and volRecoveryOk

// --- 2-8. NoTrade ---
bool volNoTrade      = useVolModule and not finalVolOk
bool volNoTradeLong  = volNoTrade
bool volNoTradeShort = volNoTrade

// --- 2-9. allow (方向性なし → 両方向同一条件) ---
bool volBiasLong  = useVolModule and finalVolOk
bool volBiasShort = useVolModule and finalVolOk
bool allowLongByVol  = useVolModule and finalVolOk
bool allowShortByVol = useVolModule and finalVolOk
int  volDirection = 0

// --- 2-10. Signal Type ---
int volSignalType =
     not useVolModule ? 0 :
     volNoTrade       ? 1 :
     volExpanding     ? 4 :
     volContracting   ? 5 :
     finalVolOk       ? 6 :
     fastVolOk        ? 3 :
     volBaseOk        ? 2 : 0

// --- 2-11. Rank / Score ---
int volScore = not useVolModule ? 0 : (volBaseOk ? 30 : 0) + (fastAtrOk ? 25 : 0) + (bodyAvgOk ? 20 : 0) + (rangeRatioOk ? 15 : 0) + (volExpanding ? 10 : 0)
int volRank =
     not useVolModule ? 0 :
     volScore >= 90 ? 5 :
     volScore >= 75 ? 4 :
     volScore >= 60 ? 3 :
     volScore >= 40 ? 2 :
     volScore > 0   ? 1 : 0

// --- 2-12. 表示 : 背景 / ラベル ---
bgcolor(showVolBg and vAct and volNoTrade   ? color.new(color.gray,   88) : na, title = "Low Vol BG")
bgcolor(showVolBg and vAct and volExpanding ? color.new(color.purple, 88) : na, title = "Vol EXP BG")

if showVolLabels and vAct
    if volNoTrade and not nz(volNoTrade[1], false)
        label.new(bar_index, high, "Low Vol", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.gray, 0), textcolor = color.white, size = size.small)
    if volExpanding and not nz(volExpanding[1], false)
        label.new(bar_index, low, "Vol EXP", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)

// --- 2-13. Debug Table (左上) ---
f_volTypeStr(t) =>
    t == 1 ? "LowVol NoTrade" : t == 2 ? "Base ATR OK" : t == 3 ? "Fast Vol OK" : t == 4 ? "Vol EXP" : t == 5 ? "Vol Contracting" : t == 6 ? "Full Vol OK" : "None"

var table volDbg = table.new(position.top_left, 2, 14, border_width = 1)
if showVolDebugTable and vAct and barstate.islast
    string sState = volNoTrade ? "NoTrade" : finalVolOk ? "Vol OK" : "-"
    color  sCol   = volNoTrade ? color.new(color.red, 20) : color.new(color.green, 0)
    table.cell(volDbg, 0, 0,  "Vol State", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(volDbg, 1, 0,  sState, text_color = color.white, bgcolor = sCol)
    table.cell(volDbg, 0, 1,  "SignalType", text_color = color.white)
    table.cell(volDbg, 1, 1,  f_volTypeStr(volSignalType), text_color = color.white)
    table.cell(volDbg, 0, 2,  "Rank", text_color = color.white)
    table.cell(volDbg, 1, 2,  str.tostring(volRank), text_color = color.white)
    table.cell(volDbg, 0, 3,  "Score", text_color = color.white)
    table.cell(volDbg, 1, 3,  str.tostring(volScore), text_color = color.white)
    table.cell(volDbg, 0, 4,  "baseATR", text_color = color.white)
    table.cell(volDbg, 1, 4,  str.tostring(baseAtr, "#.###"), text_color = color.white)
    table.cell(volDbg, 0, 5,  "fastATR", text_color = color.white)
    table.cell(volDbg, 1, 5,  str.tostring(fastAtr, "#.###"), text_color = color.white)
    table.cell(volDbg, 0, 6,  "bodyAvg", text_color = color.white)
    table.cell(volDbg, 1, 6,  str.tostring(bodyAvgFast, "#.###"), text_color = color.white)
    table.cell(volDbg, 0, 7,  "ATR Avg", text_color = color.white)
    table.cell(volDbg, 1, 7,  str.tostring(atrAvg, "#.###"), text_color = color.white)
    table.cell(volDbg, 0, 8,  "ATR Ratio", text_color = color.white)
    table.cell(volDbg, 1, 8,  atrAvg > 0 ? str.tostring(baseAtr / atrAvg, "#.##") : "-", text_color = color.white)
    table.cell(volDbg, 0, 9,  "ATR/Range", text_color = color.white)
    table.cell(volDbg, 1, 9,  str.tostring(atrRangeRatio, "#.###"), text_color = color.white)
    table.cell(volDbg, 0, 10, "Base OK", text_color = color.white)
    table.cell(volDbg, 1, 10, volBaseOk ? "Y" : "N", text_color = volBaseOk ? color.lime : color.red)
    table.cell(volDbg, 0, 11, "Fast OK", text_color = color.white)
    table.cell(volDbg, 1, 11, fastVolOk ? "Y" : "N", text_color = fastVolOk ? color.lime : color.red)
    table.cell(volDbg, 0, 12, "NoTrade", text_color = color.white)
    table.cell(volDbg, 1, 12, volNoTrade ? "Y" : "N", text_color = color.white)
    table.cell(volDbg, 0, 13, "Allow L/S", text_color = color.white)
    table.cell(volDbg, 1, 13, (allowLongByVol ? "L" : "-") + " / " + (allowShortByVol ? "S" : "-"), text_color = color.white)


// ════════════════════════════════════════════════════════════
//  MODULE 3 : Entry Trigger (エントリートリガー)
// ════════════════════════════════════════════════════════════
grpTrig = "TRIG : Entry Trigger Module"

useTriggerModule      = input.bool(true, "Triggerモジュールを使う",  group = grpTrig)
showTriggerLabels     = input.bool(true, "Triggerラベルを表示",      group = grpTrig)
showTriggerShapes     = input.bool(true, "Trigger Shapeを表示",      group = grpTrig)
showTriggerDebugTable = input.bool(true, "Debug Tableを表示",        group = grpTrig)

useEngulfingTrigger    = input.bool(true, "包み足",             group = grpTrig)
usePinbarTrigger       = input.bool(true, "ピンバー",           group = grpTrig)
useBOSTrigger          = input.bool(true, "BOS / 直近高安更新", group = grpTrig)
useEMARejectTrigger    = input.bool(true, "EMAリジェクト",      group = grpTrig)
useFVGTrigger          = input.bool(true, "FVG形成",            group = grpTrig)
useStrongCandleTrigger = input.bool(true, "強ローソク",         group = grpTrig)

triggerMode     = input.string("Any", "Trigger結合", options = ["Any", "All", "MinCount"], group = grpTrig)
minTriggerCount = input.int(1, "最低Trigger数", minval = 1, group = grpTrig)

useLowerTFTrigger = input.bool(true, "下位足Trigger確認", group = grpTrig)
triggerTF         = input.timeframe("1", "下位足TF", group = grpTrig)
triggerTFMode     = input.string("CurrentOrLower", "現在足/下位足 Trigger結合", options = ["CurrentOnly", "LowerOnly", "CurrentAndLower", "CurrentOrLower"], group = grpTrig)

emaLenTrigger = input.int(20, "EMA Length", minval = 1, group = grpTrig)
bosLookback   = input.int(10, "BOS Lookback", minval = 2, group = grpTrig)

pinWickBodyMult    = input.float(2.0, "Pinbar ヒゲ/実体倍率", step = 0.1, group = grpTrig)
pinOppWickMaxRatio = input.float(1.0, "反対ヒゲ上限", step = 0.1, group = grpTrig)

strongBodyRatio = input.float(0.6, "強ローソク 実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
closeEdgeRatio  = input.float(0.7, "終値端寄せ", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)

useTriggerCooldown  = input.bool(true, "Triggerクールダウン", group = grpTrig)
triggerCooldownBars = input.int(3, "Cooldown Bars", minval = 1, group = grpTrig)

useOppositeTriggerNoTrade = input.bool(false, "逆方向Trigger同時発生はNoTrade", group = grpTrig)

bool tAct = useTriggerModule

// --- 共通ヘルパー ---
f_typeOf(_cnt, _eng, _pin, _bos, _ema, _fvg, _strong) =>
    _cnt >= 2 ? 7 : _bos ? 3 : _eng ? 1 : _pin ? 2 : _ema ? 4 : _fvg ? 5 : _strong ? 6 : 0

f_scoreOf(_eng, _pin, _bos, _ema, _fvg, _strong) =>
    (_eng ? 2 : 0) + (_pin ? 2 : 0) + (_bos ? 3 : 0) + (_ema ? 2 : 0) + (_fvg ? 2 : 0) + (_strong ? 2 : 0)

f_combine(_cnt, _enabled) =>
    triggerMode == "Any"  ? _cnt >= 1 :
     triggerMode == "All" ? (_enabled > 0 and _cnt >= _enabled) :
     _cnt >= minTriggerCount

f_strongerType(_typeA, _scoreA, _typeB, _scoreB) =>
    _scoreA > _scoreB ? _typeA :
     _scoreB > _scoreA ? _typeB :
     _typeA == 7 or _typeB == 7 ? 7 :
     _typeA == 3 or _typeB == 3 ? 3 :
     _typeA != 0 ? _typeA : _typeB

int enabledTriggerCount = (useEngulfingTrigger ? 1 : 0) + (usePinbarTrigger ? 1 : 0) + (useBOSTrigger ? 1 : 0) + (useEMARejectTrigger ? 1 : 0) + (useFVGTrigger ? 1 : 0) + (useStrongCandleTrigger ? 1 : 0)

// --- Trigger 計算関数 (現在足 / 下位足 共用) ---
f_triggerCalc() =>
    float _body      = math.abs(close - open)
    float _barRange  = high - low
    float _upperWick = high - math.max(open, close)
    float _lowerWick = math.min(open, close) - low
    float _bodyRatio = _barRange > 0 ? _body / _barRange : 0.0
    float _closePos  = _barRange > 0 ? (close - low) / _barRange : 0.0

    bool _bullEng = useEngulfingTrigger and close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool _bearEng = useEngulfingTrigger and close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool _bullPin = usePinbarTrigger and _lowerWick > _body * pinWickBodyMult and _lowerWick > _upperWick * pinOppWickMaxRatio and _closePos >= closeEdgeRatio
    bool _bearPin = usePinbarTrigger and _upperWick > _body * pinWickBodyMult and _upperWick > _lowerWick * pinOppWickMaxRatio and _closePos <= 1.0 - closeEdgeRatio
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open
    bool _bullFVG = useFVGTrigger and low > high[2]
    bool _bearFVG = useFVGTrigger and high < low[2]
    bool _bullStrong = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= closeEdgeRatio
    bool _bearStrong = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - closeEdgeRatio

    int _bullCount = (_bullEng ? 1 : 0) + (_bullPin ? 1 : 0) + (_bullBOS ? 1 : 0) + (_bullEMA ? 1 : 0) + (_bullFVG ? 1 : 0) + (_bullStrong ? 1 : 0)
    int _bearCount = (_bearEng ? 1 : 0) + (_bearPin ? 1 : 0) + (_bearBOS ? 1 : 0) + (_bearEMA ? 1 : 0) + (_bearFVG ? 1 : 0) + (_bearStrong ? 1 : 0)

    int _bullType = f_typeOf(_bullCount, _bullEng, _bullPin, _bullBOS, _bullEMA, _bullFVG, _bullStrong)
    int _bearType = f_typeOf(_bearCount, _bearEng, _bearPin, _bearBOS, _bearEMA, _bearFVG, _bearStrong)

    int _bullScore = f_scoreOf(_bullEng, _bullPin, _bullBOS, _bullEMA, _bullFVG, _bullStrong)
    int _bearScore = f_scoreOf(_bearEng, _bearPin, _bearBOS, _bearEMA, _bearFVG, _bearStrong)

    [_bullCount, _bearCount, _bullType, _bearType, _bullScore, _bearScore]

// --- 3-3. 現在足のローソク基本計算 ---
float body      = math.abs(close - open)
float barRange  = high - low
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float bodyRatio = barRange > 0 ? body / barRange : 0.0
float closePos  = barRange > 0 ? (close - low) / barRange : 0.0

bool bullCandle = close > open
bool bearCandle = close < open

// --- 3-4〜9. 各トリガー (現在足) ---
bool triggerBullEngulf = tAct and useEngulfingTrigger and close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool triggerBearEngulf = tAct and useEngulfingTrigger and close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

bool triggerBullPinbar = tAct and usePinbarTrigger and lowerWick > body * pinWickBodyMult and lowerWick > upperWick * pinOppWickMaxRatio and closePos >= closeEdgeRatio
bool triggerBearPinbar = tAct and usePinbarTrigger and upperWick > body * pinWickBodyMult and upperWick > lowerWick * pinOppWickMaxRatio and closePos <= 1.0 - closeEdgeRatio

bool triggerBullBOS = tAct and useBOSTrigger and close > ta.highest(high, bosLookback)[1]
bool triggerBearBOS = tAct and useBOSTrigger and close < ta.lowest(low, bosLookback)[1]

float emaTrig = ta.ema(close, emaLenTrigger)
bool triggerBullEMAReject = tAct and useEMARejectTrigger and low <= emaTrig and close > emaTrig and close > open
bool triggerBearEMAReject = tAct and useEMARejectTrigger and high >= emaTrig and close < emaTrig and close < open

bool triggerBullFVG = tAct and useFVGTrigger and low > high[2]
bool triggerBearFVG = tAct and useFVGTrigger and high < low[2]

bool triggerBullStrongCandle = tAct and useStrongCandleTrigger and close > open and bodyRatio >= strongBodyRatio and closePos >= closeEdgeRatio
bool triggerBearStrongCandle = tAct and useStrongCandleTrigger and close < open and bodyRatio >= strongBodyRatio and closePos <= 1.0 - closeEdgeRatio

// --- 3-11. Trigger Count / Score (現在足) ---
int bullTriggerCount = (triggerBullEngulf ? 1 : 0) + (triggerBullPinbar ? 1 : 0) + (triggerBullBOS ? 1 : 0) + (triggerBullEMAReject ? 1 : 0) + (triggerBullFVG ? 1 : 0) + (triggerBullStrongCandle ? 1 : 0)
int bearTriggerCount = (triggerBearEngulf ? 1 : 0) + (triggerBearPinbar ? 1 : 0) + (triggerBearBOS ? 1 : 0) + (triggerBearEMAReject ? 1 : 0) + (triggerBearFVG ? 1 : 0) + (triggerBearStrongCandle ? 1 : 0)

int triggerBullScore = f_scoreOf(triggerBullEngulf, triggerBullPinbar, triggerBullBOS, triggerBullEMAReject, triggerBullFVG, triggerBullStrongCandle)
int triggerBearScore = f_scoreOf(triggerBearEngulf, triggerBearPinbar, triggerBearBOS, triggerBearEMAReject, triggerBearFVG, triggerBearStrongCandle)

int triggerBullTypeCur = f_typeOf(bullTriggerCount, triggerBullEngulf, triggerBullPinbar, triggerBullBOS, triggerBullEMAReject, triggerBullFVG, triggerBullStrongCandle)
int triggerBearTypeCur = f_typeOf(bearTriggerCount, triggerBearEngulf, triggerBearPinbar, triggerBearBOS, triggerBearEMAReject, triggerBearFVG, triggerBearStrongCandle)

// --- 3-10. 下位足 Trigger (request.security / lookahead_off) ---
[ltBullCount, ltBearCount, ltBullType, ltBearType, ltBullScore, ltBearScore] = request.security(syminfo.tickerid, triggerTF, f_triggerCalc(), lookahead = barmerge.lookahead_off)

bool triggerBullLowerTF = tAct and useLowerTFTrigger and f_combine(ltBullCount, enabledTriggerCount)
bool triggerBearLowerTF = tAct and useLowerTFTrigger and f_combine(ltBearCount, enabledTriggerCount)
int  lowerTFBullScore   = ltBullScore
int  lowerTFBearScore   = ltBearScore
int  lowerTFSignalType  = ltBullScore >= ltBearScore ? ltBullType : ltBearType

bool triggerBullCurrent = tAct and f_combine(bullTriggerCount, enabledTriggerCount)
bool triggerBearCurrent = tAct and f_combine(bearTriggerCount, enabledTriggerCount)

bool lowerTFEnabled = useLowerTFTrigger and triggerTFMode != "CurrentOnly"

bool finalBullTrigger =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBullCurrent :
     triggerTFMode == "LowerOnly"       ? triggerBullLowerTF :
     triggerTFMode == "CurrentAndLower" ? (triggerBullCurrent and triggerBullLowerTF) :
     triggerTFMode == "CurrentOrLower"  ? (triggerBullCurrent or triggerBullLowerTF) :
     triggerBullCurrent

bool finalBearTrigger =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBearCurrent :
     triggerTFMode == "LowerOnly"       ? triggerBearLowerTF :
     triggerTFMode == "CurrentAndLower" ? (triggerBearCurrent and triggerBearLowerTF) :
     triggerTFMode == "CurrentOrLower"  ? (triggerBearCurrent or triggerBearLowerTF) :
     triggerBearCurrent

int triggerBullScoreFinal =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBullScore :
     triggerTFMode == "LowerOnly"       ? lowerTFBullScore :
     triggerTFMode == "CurrentAndLower" ? triggerBullScore + lowerTFBullScore :
     triggerTFMode == "CurrentOrLower"  ? math.max(triggerBullScore, lowerTFBullScore) :
     triggerBullScore

int triggerBearScoreFinal =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBearScore :
     triggerTFMode == "LowerOnly"       ? lowerTFBearScore :
     triggerTFMode == "CurrentAndLower" ? triggerBearScore + lowerTFBearScore :
     triggerTFMode == "CurrentOrLower"  ? math.max(triggerBearScore, lowerTFBearScore) :
     triggerBearScore

int triggerScore = math.max(triggerBullScoreFinal, triggerBearScoreFinal)

int triggerBullTypeFinal =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBullTypeCur :
     triggerTFMode == "LowerOnly" ? ltBullType :
     f_strongerType(triggerBullTypeCur, triggerBullScore, ltBullType, lowerTFBullScore)

int triggerBearTypeFinal =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? triggerBearTypeCur :
     triggerTFMode == "LowerOnly" ? ltBearType :
     f_strongerType(triggerBearTypeCur, triggerBearScore, ltBearType, lowerTFBearScore)

// --- 3-12. Trigger 結合 ---
bool triggerBullEntry = tAct and finalBullTrigger
bool triggerBearEntry = tAct and finalBearTrigger

// --- 3-13. 同時発生 NoTrade ---
bool triggerNoTradeBoth = useOppositeTriggerNoTrade and triggerBullEntry and triggerBearEntry
bool triggerNoTrade      = tAct and triggerNoTradeBoth
bool triggerNoTradeLong  = triggerNoTrade
bool triggerNoTradeShort = triggerNoTrade

// --- 3-14. Cooldown ---
var int lastTriggerBar = na
bool triggerFiredNow   = triggerBullEntry or triggerBearEntry
bool triggerCooldownOk = not useTriggerCooldown or na(lastTriggerBar) or (bar_index - lastTriggerBar) > triggerCooldownBars
if triggerFiredNow and triggerCooldownOk
    lastTriggerBar := bar_index

// --- 3-15. 最終出力 (allow / bias) ---
bool allowLongByTrigger  = tAct and triggerBullEntry and not triggerNoTrade and triggerCooldownOk
bool allowShortByTrigger = tAct and triggerBearEntry and not triggerNoTrade and triggerCooldownOk

bool triggerBiasLong  = tAct and triggerBullScoreFinal > triggerBearScoreFinal
bool triggerBiasShort = tAct and triggerBearScoreFinal > triggerBullScoreFinal

// --- 3-16. Signal Type / Direction ---
int triggerSignalType =
     not tAct ? 0 :
     triggerBullScoreFinal > triggerBearScoreFinal ? triggerBullTypeFinal :
     triggerBearScoreFinal > triggerBullScoreFinal ? triggerBearTypeFinal :
     triggerBullTypeFinal == 7 or triggerBearTypeFinal == 7 ? 7 :
     triggerBullTypeFinal != 0 ? triggerBullTypeFinal :
     triggerBearTypeFinal

int triggerDirection = not tAct ? 0 : (triggerBullEntry and triggerBearEntry) ? 0 : triggerBullEntry ? 1 : triggerBearEntry ? -1 : 0

// --- 3-17. Rank (0〜8) ---
bool hasBOS    = triggerBullBOS or triggerBearBOS
bool isMulti   = bullTriggerCount >= 2 or bearTriggerCount >= 2
bool isSingle  = bullTriggerCount >= 1 or bearTriggerCount >= 1
bool lowerAgree = useLowerTFTrigger and triggerTFMode == "CurrentAndLower" and ((triggerBullCurrent and triggerBullLowerTF) or (triggerBearCurrent and triggerBearLowerTF))
bool currentOrLowerUsed = useLowerTFTrigger and triggerTFMode == "CurrentOrLower" and (triggerBullLowerTF or triggerBearLowerTF)

int triggerRankRaw = not tAct ? 0 :
                      (lowerAgree and isMulti) ? 8 :
                      lowerAgree               ? 7 :
                      (isMulti and hasBOS)     ? 6 :
                      isMulti                  ? 5 :
                      hasBOS                   ? 4 :
                      triggerScore >= 4        ? 3 :
                      triggerScore >= 2        ? 2 :
                      isSingle                 ? 1 : 0

int modeRankBonus =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? 0 :
     triggerTFMode == "LowerOnly" ? 1 :
     triggerTFMode == "CurrentAndLower" and lowerAgree ? 2 :
     triggerTFMode == "CurrentOrLower" and currentOrLowerUsed ? 1 : 0

int triggerRank = math.min(8, triggerRankRaw + modeRankBonus)

// --- 3-18. 表示 : ラベル ---
f_lblUp(txt, col) =>
    label.new(bar_index, low, txt, style = label.style_label_up, yloc = yloc.belowbar, color = col, textcolor = color.white, size = size.small)
f_lblDn(txt, col) =>
    label.new(bar_index, high, txt, style = label.style_label_down, yloc = yloc.abovebar, color = col, textcolor = color.white, size = size.small)

color colBuy  = color.new(color.green, 0)
color colSell = color.new(color.red, 0)

if showTriggerLabels and tAct
    if triggerBullEngulf
        f_lblUp("TRG Engulf↑", colBuy)
    if triggerBearEngulf
        f_lblDn("TRG Engulf↓", colSell)
    if triggerBullPinbar
        f_lblUp("TRG Pin↑", colBuy)
    if triggerBearPinbar
        f_lblDn("TRG Pin↓", colSell)
    if triggerBullBOS
        f_lblUp("TRG BOS↑", colBuy)
    if triggerBearBOS
        f_lblDn("TRG BOS↓", colSell)
    if triggerBullEMAReject
        f_lblUp("TRG EMA↑", colBuy)
    if triggerBearEMAReject
        f_lblDn("TRG EMA↓", colSell)
    if triggerBullFVG
        f_lblUp("TRG FVG↑", colBuy)
    if triggerBearFVG
        f_lblDn("TRG FVG↓", colSell)
    if triggerBullStrongCandle
        f_lblUp("TRG Strong↑", colBuy)
    if triggerBearStrongCandle
        f_lblDn("TRG Strong↓", colSell)

// --- 3-18'. Debug Table (右下) ---
f_trigTypeStr(t) =>
    t == 1 ? "Engulf" : t == 2 ? "Pinbar" : t == 3 ? "BOS" : t == 4 ? "EMAReject" : t == 5 ? "FVG" : t == 6 ? "Strong" : t == 7 ? "Multi" : "None"

var table trigDbg = table.new(position.bottom_right, 2, 13, border_width = 1)
if showTriggerDebugTable and tAct and barstate.islast
    string sDir = triggerDirection == 1 ? "BUY" : triggerDirection == -1 ? "SELL" : "-"
    string sState = allowLongByTrigger ? "LONG OK" : allowShortByTrigger ? "SHORT OK" : triggerNoTrade ? "NoTrade" : "-"
    table.cell(trigDbg, 0, 0,  "Trigger", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(trigDbg, 1, 0,  sState, text_color = color.white, bgcolor = triggerNoTrade ? color.new(color.red, 20) : color.new(color.blue, 0))
    table.cell(trigDbg, 0, 1,  "SignalType", text_color = color.white)
    table.cell(trigDbg, 1, 1,  f_trigTypeStr(triggerSignalType), text_color = color.white)
    table.cell(trigDbg, 0, 2,  "Direction", text_color = color.white)
    table.cell(trigDbg, 1, 2,  sDir, text_color = color.white)
    table.cell(trigDbg, 0, 3,  "Rank", text_color = color.white)
    table.cell(trigDbg, 1, 3,  str.tostring(triggerRank), text_color = color.white)
    table.cell(trigDbg, 0, 4,  "Bull/Bear Cnt", text_color = color.white)
    table.cell(trigDbg, 1, 4,  str.tostring(bullTriggerCount) + " / " + str.tostring(bearTriggerCount), text_color = color.white)
    table.cell(trigDbg, 0, 5,  "Bull/Bear Score", text_color = color.white)
    table.cell(trigDbg, 1, 5,  str.tostring(triggerBullScore) + " / " + str.tostring(triggerBearScore), text_color = color.white)
    table.cell(trigDbg, 0, 6,  "LowerTF", text_color = color.white)
    table.cell(trigDbg, 1, 6,  useLowerTFTrigger ? "ON" : "OFF", text_color = color.white)
    table.cell(trigDbg, 0, 7,  "LowerTF B/S", text_color = color.white)
    table.cell(trigDbg, 1, 7,  (triggerBullLowerTF ? "Y" : "N") + " / " + (triggerBearLowerTF ? "Y" : "N"), text_color = color.white)
    table.cell(trigDbg, 0, 8,  "NoTrade", text_color = color.white)
    table.cell(trigDbg, 1, 8,  triggerNoTrade ? "Y" : "N", text_color = color.white)
    table.cell(trigDbg, 0, 9,  "Allow L/S", text_color = color.white)
    table.cell(trigDbg, 1, 9,  (allowLongByTrigger ? "L" : "-") + " / " + (allowShortByTrigger ? "S" : "-"), text_color = color.white)
    table.cell(trigDbg, 0, 10, "Cooldown", text_color = color.white)
    table.cell(trigDbg, 1, 10, triggerCooldownOk ? "OK" : "WAIT", text_color = color.white)
    table.cell(trigDbg, 0, 11, "TF Mode", text_color = color.white)
    table.cell(trigDbg, 1, 11, triggerTFMode, text_color = color.white)
    table.cell(trigDbg, 0, 12, "Final Score B/S", text_color = color.white)
    table.cell(trigDbg, 1, 12, str.tostring(triggerBullScoreFinal) + " / " + str.tostring(triggerBearScoreFinal), text_color = color.white)

// --- Shape (エントリー方向) ---
plotshape(showTriggerShapes and allowLongByTrigger,  title = "Trigger Long",  style = shape.triangleup,   location = location.belowbar, color = colBuy,  size = size.small)
plotshape(showTriggerShapes and allowShortByTrigger, title = "Trigger Short", style = shape.triangledown, location = location.abovebar, color = colSell, size = size.small)
plotshape(showTriggerShapes and triggerNoTrade,      title = "Trigger NoTrade", style = shape.xcross,     location = location.abovebar, color = color.new(color.gray, 0), size = size.tiny)


// ════════════════════════════════════════════════════════════
//  SIGNAL INTEGRATION (3モジュールの統合 → エントリーシグナル)
// ════════════════════════════════════════════════════════════
grpSig = "★ シグナル統合"
useEnvGate  = input.bool(true, "環境認識をゲートに使う",     group = grpSig)
useVolGate  = input.bool(true, "ボラフィルターをゲートに使う", group = grpSig)
useTrigGate = input.bool(true, "トリガーをゲートに使う",     group = grpSig)
blockInRange = input.bool(false, "レンジ環境ではエントリー禁止", group = grpSig)

// 各モジュールの allow を AND 結合 (OFF にしたゲートは無視)
bool gateLong  = (not useEnvGate or allowLongByEnvironment)  and (not useVolGate or allowLongByVol)  and (not useTrigGate or allowLongByTrigger)
bool gateShort = (not useEnvGate or allowShortByEnvironment) and (not useVolGate or allowShortByVol) and (not useTrigGate or allowShortByTrigger)

// モジュール由来の NoTrade
bool moduleNoTrade = (useVolModule and volNoTrade) or (useTriggerModule and triggerNoTrade)
bool rangeBlock    = blockInRange and isRangeEnvironment

bool entrySignalLong  = gateLong  and not moduleNoTrade and not rangeBlock
bool entrySignalShort = gateShort and not moduleNoTrade and not rangeBlock

// ------------------------------------------------------------
//  リスク / 数量 (Trade Management へ渡す値)
// ------------------------------------------------------------
grpRisk = "★ リスク / 数量"
riskAtrLen  = input.int(14,  "リスク用ATR本数", minval = 1, group = grpRisk)
riskAtrMult = input.float(1.5, "SL ATR倍率",    minval = 0.1, step = 0.1, group = grpRisk)
rrValue     = input.float(1.5, "リワード倍率(RR)", minval = 0.1, step = 0.1, group = grpRisk)
qtyValue    = input.float(1.0, "数量",          minval = 0.0, step = 0.1, group = grpRisk)

float riskAtr   = ta.atr(riskAtrLen)
float riskWidth = riskAtr * riskAtrMult

// ------------------------------------------------------------
//  Trade Management ブリッジ変数
//  ※ ここで定義した値が下の Trade Management Module で使われる。
// ------------------------------------------------------------
bool  tmEntryLong  = entrySignalLong
bool  tmEntryShort = entrySignalShort
float tmRiskWidth  = riskWidth
float tmRR         = rrValue
float tmQty        = qtyValue

// 部分利確 "Accum15" 用シグナル。
//   既存の Accum15 ロジックがあれば下行を差し替える。
//   未使用の間は false でも、partialTriggerMode を "RR" / "Dollar" にすれば部分利確は機能する。
bool  newAccum15   = false


// ════════════════════════════════════════════════════════════
//  MODULE 4 : Trade Management (建値移動 / 部分利確 / 再エントリー / Fib・N値 TP)
// ════════════════════════════════════════════════════════════

// ------------------------------------------------------------
//  4-1. Input
// ------------------------------------------------------------
groupTradeMgmt = "TM : Trade Management Module"

useTradeMgmtModule = input.bool(true, "Trade Managementを使う", group = groupTradeMgmt)

useBE     = input.bool(true, "建値移動ON", group = groupTradeMgmt)
beTrigger = input.float(15.0, "建値移動 発動幅($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)
beOffset  = input.float(0.0, "建値オフセット($)", step = 0.1, group = groupTradeMgmt)

useReentry = input.bool(true, "建値決済後に再エントリー", group = groupTradeMgmt)
maxReentry = input.int(1, "再エントリー最大回数", minval = 1, group = groupTradeMgmt)

useMaSLTP = input.bool(true,  "MAでSL/TP調整ON", group = groupTradeMgmt)
useMaSL   = input.bool(true,  "MAでSL調整ON", group = groupTradeMgmt)
useMaTP   = input.bool(false, "MAでTP調整ON", group = groupTradeMgmt)

maSlBuffer      = input.float(3.0,  "MAスナップ余白 SL($)", minval = 0.0, step = 0.1, group = groupTradeMgmt)
maTpBuffer      = input.float(1.0,  "MAスナップ余白 TP($)", minval = 0.0, step = 0.1, group = groupTradeMgmt)
maSnapMaxMult   = input.float(1.5,  "SLスナップ許容倍率", minval = 1.0, step = 0.1, group = groupTradeMgmt)
maTpSnapBandPct = input.float(10.0, "TPスナップ許容バンド(±%)", minval = 0.0, step = 1.0, group = groupTradeMgmt)

usePartialTP = input.bool(true, "部分利確ON", group = groupTradeMgmt)
partialPct   = input.float(70.0, "部分利確割合(%)", minval = 1, maxval = 100, group = groupTradeMgmt)

partialTriggerMode = input.string("Accum15", "部分利確条件", options = ["Accum15", "RR", "Dollar"], group = groupTradeMgmt)
partialRR     = input.float(1.0,  "部分利確RR", minval = 0.1, step = 0.1, group = groupTradeMgmt)
partialDollar = input.float(15.0, "部分利確幅($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)

// --- Fibonacci Expansion ---
useFibExpansion = input.bool(true, "Fib Expansionを使う", group = groupTradeMgmt)
fibSwingLen     = input.int(20, "Fib Expansion Swing Lookback", minval = 2, group = groupTradeMgmt)
fibExpTPMode    = input.string("Off", "Fib Expansion TP調整", options = ["Off", "TP1_100", "TP2_127", "TP3_161", "TP4_200"], group = groupTradeMgmt)

useFibPartialTP = input.bool(false, "Fib到達で部分利確", group = groupTradeMgmt)
fibPartialLevel = input.string("127.2", "Fib部分利確Level", options = ["100", "127.2", "161.8", "200"], group = groupTradeMgmt)

useFibRoomFilter = input.bool(false, "Fib伸びしろ不足でNoTrade", group = groupTradeMgmt)
minFibRoomDollar = input.float(5.0, "最低Fib伸びしろ($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)

useFibOverExtensionFilter = input.bool(false, "Fib伸び切りで追いかけ禁止", group = groupTradeMgmt)
fibOverExtensionLevel     = input.string("161.8", "伸び切り判定Level", options = ["127.2", "161.8", "200"], group = groupTradeMgmt)

// --- 3点式 Fib (ABC) ---
fibPivotLen    = input.int(5, "Fib Pivot Length", minval = 1, group = groupTradeMgmt)
fibABCMode     = input.string("AutoPivot", "Fib ABC検出方式", options = ["AutoPivot", "EntryBased"], group = groupTradeMgmt)
fibCValidBars  = input.int(50, "C点 有効本数", minval = 5, group = groupTradeMgmt)
useFibCConfirm = input.bool(true, "C点反転確認を使う", group = groupTradeMgmt)

// --- N値 / E値 系列 ---
useNEValue = input.bool(true, "N値/E値を使う", group = groupTradeMgmt)
neTPMode   = input.string("Off", "N/E値 TP調整", options = ["Off", "N", "E", "NT", "V"], group = groupTradeMgmt)

useNEPartialTP = input.bool(false, "N/E値到達で部分利確", group = groupTradeMgmt)
nePartialLevel = input.string("N", "N/E値 部分利確Level", options = ["N", "E", "NT", "V"], group = groupTradeMgmt)

useNERoomFilter = input.bool(false, "N/E値伸びしろ不足でNoTrade", group = groupTradeMgmt)
minNERoomDollar = input.float(5.0, "最低N/E値伸びしろ($)", minval = 0.1, step = 0.1, group = groupTradeMgmt)

useNEOverExtensionFilter = input.bool(false, "N/E値到達済みで追いかけ禁止", group = groupTradeMgmt)
neOverLevel = input.string("E", "伸び切り判定Level", options = ["N", "E", "NT", "V"], group = groupTradeMgmt)

// ------------------------------------------------------------
//  4-3. MA 配列 (確定値・lookahead_off)
// ------------------------------------------------------------
ema_1m_1000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_1m_3000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_5m_1000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_5m_3000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_15m_1000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_15m_3000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_1h_1000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_1h_3000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
ema_4h_1000  = request.security(syminfo.tickerid, "240", ta.ema(close, 1000)[1], lookahead = barmerge.lookahead_off)
ema_4h_3000  = request.security(syminfo.tickerid, "240", ta.ema(close, 3000)[1], lookahead = barmerge.lookahead_off)
maArr = array.from(ema_1m_1000, ema_1m_3000, ema_5m_1000, ema_5m_3000, ema_15m_1000, ema_15m_3000, ema_1h_1000, ema_1h_3000, ema_4h_1000, ema_4h_3000)

// ------------------------------------------------------------
//  4-4. MA SL スナップ関数
// ------------------------------------------------------------
f_snap_sl_to_ema(_dir, _entry, _slRaw) =>
    _sl = _slRaw
    if useTradeMgmtModule and useMaSLTP and useMaSL and array.size(maArr) > 0
        float _bestMA = na
        float _bestD  = na
        for i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, i)
            _valid = _dir == 1 ? _m < _entry : _m > _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _slRaw)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maSlBuffer : _bestMA + maSlBuffer
            _riskRaw  = math.abs(_entry - _slRaw)
            _riskSnap = math.abs(_entry - _cand)
            if _riskRaw > 0 and _riskSnap <= _riskRaw * maSnapMaxMult
                _sl := _cand
    _sl

// ------------------------------------------------------------
//  4-5. MA TP スナップ関数
// ------------------------------------------------------------
f_snap_tp_to_ema(_dir, _entry, _tpRaw) =>
    _tp = _tpRaw
    if useTradeMgmtModule and useMaSLTP and useMaTP and array.size(maArr) > 0
        _rewardRaw = math.abs(_tpRaw - _entry)
        float _bestMA = na
        float _bestD  = na
        for i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, i)
            _valid = _dir == 1 ? _m > _entry : _m < _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _tpRaw)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maTpBuffer : _bestMA + maTpBuffer
            _candReward = _dir == 1 ? _cand - _entry : _entry - _cand
            _band = maTpSnapBandPct / 100.0
            _loR  = _rewardRaw * (1.0 - _band)
            _hiR  = _rewardRaw * (1.0 + _band)
            if _candReward >= _loR and _candReward <= _hiR
                _tp := _cand
    _tp

// ------------------------------------------------------------
//  4-5'. Fibonacci Expansion 計算 (3点式 ABC / 簡易版 fallback)
// ------------------------------------------------------------
float ph = ta.pivothigh(high, fibPivotLen, fibPivotLen)
float pl = ta.pivotlow(low,  fibPivotLen, fibPivotLen)

var float fibLastPH = na
var int   fibLastPHBar = na
var float fibPrevPH = na
var int   fibPrevPHBar = na
var float fibLastPL = na
var int   fibLastPLBar = na
var float fibPrevPL = na
var int   fibPrevPLBar = na

if not na(ph)
    fibPrevPH    := fibLastPH
    fibPrevPHBar := fibLastPHBar
    fibLastPH    := ph
    fibLastPHBar := bar_index - fibPivotLen
if not na(pl)
    fibPrevPL    := fibLastPL
    fibPrevPLBar := fibLastPLBar
    fibLastPL    := pl
    fibLastPLBar := bar_index - fibPivotLen

// --- 3点式 ABC 定義 ---
bool fibABCValidLong = not na(fibPrevPL) and not na(fibLastPH) and not na(fibLastPL) and fibPrevPLBar < fibLastPHBar and fibLastPHBar < fibLastPLBar and (bar_index - fibLastPLBar) <= fibCValidBars
bool fibABCValidShort = not na(fibPrevPH) and not na(fibLastPL) and not na(fibLastPH) and fibPrevPHBar < fibLastPLBar and fibLastPLBar < fibLastPHBar and (bar_index - fibLastPHBar) <= fibCValidBars

float fibA_Long = fibPrevPL
float fibB_Long = fibLastPH
float fibC_Long = fibLastPL
float fibA_Short = fibPrevPH
float fibB_Short = fibLastPL
float fibC_Short = fibLastPH

bool fibCConfirmLong  = not na(fibA_Long) and not na(fibB_Long) and not na(fibC_Long) and fibC_Long > fibA_Long and fibC_Long < fibB_Long
bool fibCConfirmShort = not na(fibA_Short) and not na(fibB_Short) and not na(fibC_Short) and fibC_Short < fibA_Short and fibC_Short > fibB_Short

bool fibABCReadyLong  = fibABCValidLong  and (not useFibCConfirm or fibCConfirmLong)
bool fibABCReadyShort = fibABCValidShort and (not useFibCConfirm or fibCConfirmShort)

float fibABRangeLong  = fibB_Long - fibA_Long
float fibABRangeShort = fibA_Short - fibB_Short

float abcBuy100 = fibABCReadyLong ? fibC_Long + fibABRangeLong * 1.0   : na
float abcBuy127 = fibABCReadyLong ? fibC_Long + fibABRangeLong * 1.272 : na
float abcBuy161 = fibABCReadyLong ? fibC_Long + fibABRangeLong * 1.618 : na
float abcBuy200 = fibABCReadyLong ? fibC_Long + fibABRangeLong * 2.0   : na
float abcSell100 = fibABCReadyShort ? fibC_Short - fibABRangeShort * 1.0   : na
float abcSell127 = fibABCReadyShort ? fibC_Short - fibABRangeShort * 1.272 : na
float abcSell161 = fibABCReadyShort ? fibC_Short - fibABRangeShort * 1.618 : na
float abcSell200 = fibABCReadyShort ? fibC_Short - fibABRangeShort * 2.0   : na

float fibSimpleSwingHigh = ta.highest(high, fibSwingLen)
float fibSimpleSwingLow  = ta.lowest(low,  fibSwingLen)
float fibSimpleRange     = fibSimpleSwingHigh - fibSimpleSwingLow
float simpleBuy100 = fibSimpleSwingLow + fibSimpleRange * 1.0
float simpleBuy127 = fibSimpleSwingLow + fibSimpleRange * 1.272
float simpleBuy161 = fibSimpleSwingLow + fibSimpleRange * 1.618
float simpleBuy200 = fibSimpleSwingLow + fibSimpleRange * 2.0
float simpleSell100 = fibSimpleSwingHigh - fibSimpleRange * 1.0
float simpleSell127 = fibSimpleSwingHigh - fibSimpleRange * 1.272
float simpleSell161 = fibSimpleSwingHigh - fibSimpleRange * 1.618
float simpleSell200 = fibSimpleSwingHigh - fibSimpleRange * 2.0

float fibExpBuy100 = fibABCMode == "AutoPivot" ? abcBuy100 : simpleBuy100
float fibExpBuy127 = fibABCMode == "AutoPivot" ? abcBuy127 : simpleBuy127
float fibExpBuy161 = fibABCMode == "AutoPivot" ? abcBuy161 : simpleBuy161
float fibExpBuy200 = fibABCMode == "AutoPivot" ? abcBuy200 : simpleBuy200
float fibExpSell100 = fibABCMode == "AutoPivot" ? abcSell100 : simpleSell100
float fibExpSell127 = fibABCMode == "AutoPivot" ? abcSell127 : simpleSell127
float fibExpSell161 = fibABCMode == "AutoPivot" ? abcSell161 : simpleSell161
float fibExpSell200 = fibABCMode == "AutoPivot" ? abcSell200 : simpleSell200

f_fib_tp(_dir) =>
    float _tp = na
    if _dir == 1
        _tp := fibExpTPMode == "TP1_100" ? fibExpBuy100 :
               fibExpTPMode == "TP2_127" ? fibExpBuy127 :
               fibExpTPMode == "TP3_161" ? fibExpBuy161 :
               fibExpTPMode == "TP4_200" ? fibExpBuy200 : na
    if _dir == -1
        _tp := fibExpTPMode == "TP1_100" ? fibExpSell100 :
               fibExpTPMode == "TP2_127" ? fibExpSell127 :
               fibExpTPMode == "TP3_161" ? fibExpSell161 :
               fibExpTPMode == "TP4_200" ? fibExpSell200 : na
    _tp

float fibRoomLong  = not na(fibExpBuy127)  ? fibExpBuy127 - close : na
float fibRoomShort = not na(fibExpSell127) ? close - fibExpSell127 : na
bool fibRoomOkLong  = not useFibRoomFilter or not useFibExpansion or (not na(fibRoomLong)  and fibRoomLong  >= minFibRoomDollar)
bool fibRoomOkShort = not useFibRoomFilter or not useFibExpansion or (not na(fibRoomShort) and fibRoomShort >= minFibRoomDollar)

bool fibOverLong =
     fibOverExtensionLevel == "127.2" and not na(fibExpBuy127) ? close >= fibExpBuy127 :
     fibOverExtensionLevel == "161.8" and not na(fibExpBuy161) ? close >= fibExpBuy161 :
     not na(fibExpBuy200) ? close >= fibExpBuy200 : false
bool fibOverShort =
     fibOverExtensionLevel == "127.2" and not na(fibExpSell127) ? close <= fibExpSell127 :
     fibOverExtensionLevel == "161.8" and not na(fibExpSell161) ? close <= fibExpSell161 :
     not na(fibExpSell200) ? close <= fibExpSell200 : false
bool fibOverOkLong  = not useFibOverExtensionFilter or not useFibExpansion or not fibOverLong
bool fibOverOkShort = not useFibOverExtensionFilter or not useFibExpansion or not fibOverShort

// ------------------------------------------------------------
//  4-5''. N値 / E値 / NT値 / V値
// ------------------------------------------------------------
float neNLong  = fibABCReadyLong ? fibC_Long + fibABRangeLong          : na
float neELong  = fibABCReadyLong ? fibB_Long + fibABRangeLong          : na
float neNTLong = fibABCReadyLong ? fibC_Long + fibABRangeLong * 0.618  : na
float neVLong  = fibABCReadyLong ? fibB_Long + (fibB_Long - fibC_Long) : na
float neNShort  = fibABCReadyShort ? fibC_Short - fibABRangeShort          : na
float neEShort  = fibABCReadyShort ? fibB_Short - fibABRangeShort          : na
float neNTShort = fibABCReadyShort ? fibC_Short - fibABRangeShort * 0.618  : na
float neVShort  = fibABCReadyShort ? fibB_Short - (fibC_Short - fibB_Short) : na

f_ne_tp(_dir) =>
    float _tp = na
    if _dir == 1
        _tp := neTPMode == "N" ? neNLong :
               neTPMode == "E" ? neELong :
               neTPMode == "NT" ? neNTLong :
               neTPMode == "V" ? neVLong : na
    if _dir == -1
        _tp := neTPMode == "N" ? neNShort :
               neTPMode == "E" ? neEShort :
               neTPMode == "NT" ? neNTShort :
               neTPMode == "V" ? neVShort : na
    _tp

float neRoomLong  = not na(neNLong)  ? neNLong - close : na
float neRoomShort = not na(neNShort) ? close - neNShort : na
bool neRoomOkLong  = not useNERoomFilter or not useNEValue or (not na(neRoomLong)  and neRoomLong  >= minNERoomDollar)
bool neRoomOkShort = not useNERoomFilter or not useNEValue or (not na(neRoomShort) and neRoomShort >= minNERoomDollar)

float neOverTargetLong =
     neOverLevel == "N" ? neNLong :
     neOverLevel == "E" ? neELong :
     neOverLevel == "NT" ? neNTLong :
     neVLong
float neOverTargetShort =
     neOverLevel == "N" ? neNShort :
     neOverLevel == "E" ? neEShort :
     neOverLevel == "NT" ? neNTShort :
     neVShort
bool neOverLong  = not na(neOverTargetLong)  and close >= neOverTargetLong
bool neOverShort = not na(neOverTargetShort) and close <= neOverTargetShort
bool neOverOkLong  = not useNEOverExtensionFilter or not useNEValue or not neOverLong
bool neOverOkShort = not useNEOverExtensionFilter or not useNEValue or not neOverShort

// ------------------------------------------------------------
//  4-6. 状態変数
// ------------------------------------------------------------
var map<string, float> tmTpMap = map.new<string, float>()

var string tmCurTag      = na
var bool   tmPartialDone = false
var bool   tmBeMoved     = false
var bool   tmArmReentry  = false

var bool   tmReCurIsLong = false
var float  tmReEntryPx   = na
var float  tmReRiskW     = na
var float  tmReRR        = na
var int    tmReentryCount = 0

var int    tmLastEntryBar = na

var float  tmFinalSL = na
var float  tmFinalTP = na

bool tmPartialEvent  = false
bool tmBeEvent       = false
bool tmBeClosedEvent = false
bool tmReentryEvent  = false
bool tmFibPartialEvent = false
bool tmNePartialEvent  = false

// ------------------------------------------------------------
//  4-7. エントリー時の記録 (strategy.entry 直後に SL/TP スナップ + 状態保存)
// ------------------------------------------------------------
bool tmFlat = strategy.position_size == 0

// ---- BUY ----
if useTradeMgmtModule and tmEntryLong and tmFlat and fibRoomOkLong and fibOverOkLong and neRoomOkLong and neOverOkLong
    float _entry = close
    float _slRaw = _entry - tmRiskWidth
    float _tpRaw = _entry + tmRiskWidth * tmRR
    float _fibTP = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(1) : na
    if not na(_fibTP) and _fibTP > _entry
        _tpRaw := _fibTP
    float _neTP = useNEValue and neTPMode != "Off" ? f_ne_tp(1) : na
    if not na(_neTP) and _neTP > _entry
        _tpRaw := _neTP
    float _slF = f_snap_sl_to_ema(1, _entry, _slRaw)
    float _tpF = f_snap_tp_to_ema(1, _entry, _tpRaw)
    string _tag = "TM_" + str.tostring(bar_index)
    strategy.entry(_tag, strategy.long, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _slF, limit = _tpF)
    map.put(tmTpMap, _tag, _tpF)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmReCurIsLong  := true
    tmReEntryPx    := _entry
    tmReRiskW      := math.abs(_entry - _slF)
    tmReRR         := tmRR
    tmBeMoved      := false
    tmReentryCount := 0
    tmLastEntryBar := bar_index
    tmFinalSL      := _slF
    tmFinalTP      := _tpF

// ---- SELL ----
if useTradeMgmtModule and tmEntryShort and tmFlat and fibRoomOkShort and fibOverOkShort and neRoomOkShort and neOverOkShort
    float _entry = close
    float _slRaw = _entry + tmRiskWidth
    float _tpRaw = _entry - tmRiskWidth * tmRR
    float _fibTP = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(-1) : na
    if not na(_fibTP) and _fibTP < _entry
        _tpRaw := _fibTP
    float _neTP = useNEValue and neTPMode != "Off" ? f_ne_tp(-1) : na
    if not na(_neTP) and _neTP < _entry
        _tpRaw := _neTP
    float _slF = f_snap_sl_to_ema(-1, _entry, _slRaw)
    float _tpF = f_snap_tp_to_ema(-1, _entry, _tpRaw)
    string _tag = "TM_" + str.tostring(bar_index)
    strategy.entry(_tag, strategy.short, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _slF, limit = _tpF)
    map.put(tmTpMap, _tag, _tpF)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmReCurIsLong  := false
    tmReEntryPx    := _entry
    tmReRiskW      := math.abs(_entry - _slF)
    tmReRR         := tmRR
    tmBeMoved      := false
    tmReentryCount := 0
    tmLastEntryBar := bar_index
    tmFinalSL      := _slF
    tmFinalTP      := _tpF

// ------------------------------------------------------------
//  4-8. 部分利確 (1 トレード 1 回 / エントリー足では発動しない)
// ------------------------------------------------------------
bool tmAfterEntryBar = bar_index > nz(tmLastEntryBar, -1)

float fibPartialTarget = tmReCurIsLong ?
     (fibPartialLevel == "100" ? fibExpBuy100 : fibPartialLevel == "127.2" ? fibExpBuy127 : fibPartialLevel == "161.8" ? fibExpBuy161 : fibExpBuy200) :
     (fibPartialLevel == "100" ? fibExpSell100 : fibPartialLevel == "127.2" ? fibExpSell127 : fibPartialLevel == "161.8" ? fibExpSell161 : fibExpSell200)
bool fibPartialTrigger = useFibExpansion and useFibPartialTP and not na(fibPartialTarget) and (tmReCurIsLong ? high >= fibPartialTarget : low <= fibPartialTarget)

float nePartialTarget = tmReCurIsLong ?
     (nePartialLevel == "N" ? neNLong : nePartialLevel == "E" ? neELong : nePartialLevel == "NT" ? neNTLong : neVLong) :
     (nePartialLevel == "N" ? neNShort : nePartialLevel == "E" ? neEShort : nePartialLevel == "NT" ? neNTShort : neVShort)
bool nePartialTrigger = useNEValue and useNEPartialTP and not na(nePartialTarget) and (tmReCurIsLong ? high >= nePartialTarget : low <= nePartialTarget)

bool partialTrigger =
     (partialTriggerMode == "Accum15" ? newAccum15 :
      partialTriggerMode == "RR"      ? (tmReCurIsLong ? high >= tmReEntryPx + tmReRiskW * partialRR : low <= tmReEntryPx - tmReRiskW * partialRR) :
      (tmReCurIsLong ? high >= tmReEntryPx + partialDollar : low <= tmReEntryPx - partialDollar))
     or fibPartialTrigger
     or nePartialTrigger

if useTradeMgmtModule and usePartialTP and strategy.position_size != 0 and not tmPartialDone and not na(tmCurTag) and tmAfterEntryBar
    if partialTrigger
        strategy.close(tmCurTag, qty_percent = partialPct, comment = "PT")
        tmPartialDone := true
        tmPartialEvent := true
        if fibPartialTrigger
            tmFibPartialEvent := true
        if nePartialTrigger
            tmNePartialEvent := true

// ------------------------------------------------------------
//  4-9. 建値移動 (含み益が beTrigger に到達したら SL を建値へ / 1 回だけ)
// ------------------------------------------------------------
if useTradeMgmtModule and useBE and not tmBeMoved and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        _eid  = strategy.opentrades.entry_id(i)
        _ep   = strategy.opentrades.entry_price(i)
        _long = strategy.opentrades.size(i) > 0
        float _tp = map.contains(tmTpMap, _eid) ? map.get(tmTpMap, _eid) : na
        if _long and high >= _ep + beTrigger
            strategy.exit(_eid + "_x", from_entry = _eid, stop = _ep + beOffset, limit = _tp)
            tmBeMoved := true
            tmBeEvent := true
            tmFinalSL := _ep + beOffset
        if not _long and low <= _ep - beTrigger
            strategy.exit(_eid + "_x", from_entry = _eid, stop = _ep - beOffset, limit = _tp)
            tmBeMoved := true
            tmBeEvent := true
            tmFinalSL := _ep - beOffset

// ------------------------------------------------------------
//  4-10. 建値決済検知 (BE 後にポジションが建値で閉じたか)
// ------------------------------------------------------------
if useTradeMgmtModule and useReentry and tmBeMoved and strategy.position_size == 0 and strategy.position_size[1] != 0 and strategy.closedtrades > 0 and tmReentryCount < maxReentry
    float _exitP  = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float _entryP = strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    if not na(_exitP) and not na(_entryP) and math.abs(_exitP - _entryP) <= syminfo.mintick * 5
        tmArmReentry := true
        tmBeClosedEvent := true

// ------------------------------------------------------------
//  4-11. 再エントリー実行 (MA SL/TP スナップを再適用)
// ------------------------------------------------------------
if useTradeMgmtModule and tmArmReentry and strategy.position_size == 0
    int   _dir  = tmReCurIsLong ? 1 : -1
    float _e2   = close
    float _sl2r = tmReCurIsLong ? _e2 - tmReRiskW : _e2 + tmReRiskW
    float _tp2r = tmReCurIsLong ? _e2 + tmReRiskW * tmReRR : _e2 - tmReRiskW * tmReRR
    float _fibTP2 = useFibExpansion and fibExpTPMode != "Off" ? f_fib_tp(_dir) : na
    if not na(_fibTP2) and ((tmReCurIsLong and _fibTP2 > _e2) or (not tmReCurIsLong and _fibTP2 < _e2))
        _tp2r := _fibTP2
    float _neTP2 = useNEValue and neTPMode != "Off" ? f_ne_tp(_dir) : na
    if not na(_neTP2) and ((tmReCurIsLong and _neTP2 > _e2) or (not tmReCurIsLong and _neTP2 < _e2))
        _tp2r := _neTP2
    float _sl2  = f_snap_sl_to_ema(_dir, _e2, _sl2r)
    float _tp2  = f_snap_tp_to_ema(_dir, _e2, _tp2r)
    string _tag = "RE_" + str.tostring(bar_index)
    strategy.entry(_tag, tmReCurIsLong ? strategy.long : strategy.short, qty = tmQty)
    strategy.exit(_tag + "_x", from_entry = _tag, stop = _sl2, limit = _tp2)
    map.put(tmTpMap, _tag, _tp2)
    tmReentryCount := tmReentryCount + 1
    tmReEntryPx    := _e2
    tmReRiskW      := math.abs(_e2 - _sl2)
    tmCurTag       := _tag
    tmPartialDone  := false
    tmBeMoved      := false
    tmLastEntryBar := bar_index
    tmFinalSL      := _sl2
    tmFinalTP      := _tp2
    tmReentryEvent := true
    tmArmReentry   := false


// ════════════════════════════════════════════════════════════
//  出力 (Data Window) ※ 必要に応じて取捨選択
// ════════════════════════════════════════════════════════════
// --- 統合シグナル ---
plot(entrySignalLong  ? 1 : 0, "entrySignalLong",  display = display.data_window)
plot(entrySignalShort ? 1 : 0, "entrySignalShort", display = display.data_window)
plot(riskWidth,                "riskWidth",        display = display.data_window)
plot(allowLongByEnvironment  ? 1 : 0, "allowLongByEnvironment",  display = display.data_window)
plot(allowShortByEnvironment ? 1 : 0, "allowShortByEnvironment", display = display.data_window)
plot(allowLongByVol      ? 1 : 0, "allowLongByVol",      display = display.data_window)
plot(allowShortByVol     ? 1 : 0, "allowShortByVol",     display = display.data_window)
plot(allowLongByTrigger  ? 1 : 0, "allowLongByTrigger",  display = display.data_window)
plot(allowShortByTrigger ? 1 : 0, "allowShortByTrigger", display = display.data_window)
plot(isRangeEnvironment  ? 1 : 0, "isRangeEnvironment",  display = display.data_window)

// --- Trade Management ---
plot(tmFinalSL,  "tmFinalSL",  display = display.data_window)
plot(tmFinalTP,  "tmFinalTP",  display = display.data_window)
plot(tmReRiskW,  "tmReRiskW",  display = display.data_window)
plot(tmReentryCount, "tmReentryCount", display = display.data_window)

// ════════════════════════════════════════════════════════════
//  Alert
// ════════════════════════════════════════════════════════════
alertcondition(entrySignalLong,  "Entry Long",  "{{ticker}} ロングエントリー")
alertcondition(entrySignalShort, "Entry Short", "{{ticker}} ショートエントリー")
alertcondition(tmPartialEvent,   "Partial TP",  "{{ticker}} 部分利確")
alertcondition(tmBeEvent,        "BE Moved",    "{{ticker}} 建値移動")
alertcondition(tmReentryEvent,   "Reentry",     "{{ticker}} 再エントリー")

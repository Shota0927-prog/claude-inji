// © ka.mickey15
//
// ============================================================
//  5分足 包み足ストラテジー (Engulfing Strategy)
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing)
//  ・ボラフィルタ : OFF / ATR(高速ボラフィルタ) / 固定値 の3モード
//      - OFF の時は ATR 等の関数を一切呼ばず、負荷を軽くする
//  ・環境フィルタ : 環境認識モジュール (4H/1H/15M/5M/1M) を統合
//      - OFF の時は request.security を一切呼ばず、負荷を軽くする
//  ・リスク   : 1トレードの損失を元金(単利) or 残高(複利) の X% に固定
//  ・ロット   : 整数に切り捨て。1未満はエントリーしない。
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "5min Engulfing Strategy",
     shorttitle        = "ENG5",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000
 )

// ============================================================
//  1. 入力 : エントリー (包み足)
// ============================================================
grpEntry = "エントリー (包み足)"
useLong      = input.bool(true, "ロングを有効",              group = grpEntry)
useShort     = input.bool(true, "ショートを有効",            group = grpEntry)
strictEngulf = input.bool(true, "実体が前足を完全に包む",     group = grpEntry)
reqOppColor  = input.bool(true, "前足が反対色であることを要求", group = grpEntry)

// ============================================================
//  1b. 入力 : 追加エントリートリガー
// ------------------------------------------------------------
//  包み足以外のトリガーを追加。各トリガーは個別に ON/OFF。
//  OFF のトリガーは ta.* / request.security を一切呼ばないため軽い:
//    BOS        … ta.highest / ta.lowest
//    EMAリジェクト … ta.ema
//    下位足確認   … request.security
//  デフォルトは「包み足」のみ ON = 既存挙動と同じ。
// ============================================================
grpTrig = "追加エントリートリガー"
useEngulfTrig       = input.bool(true,  "包み足 (既存ロジック使用)", group = grpTrig)
usePinbarTrig       = input.bool(false, "ピンバー",              group = grpTrig)
useBOSTrig          = input.bool(false, "BOS / 直近高安更新",     group = grpTrig)
useEMARejectTrig    = input.bool(false, "EMAリジェクト",         group = grpTrig)
useFVGTrig          = input.bool(false, "FVG形成",               group = grpTrig)
useStrongCandleTrig = input.bool(false, "強ローソク",            group = grpTrig)

// 複数トリガーの結合方法
//   いずれか … どれか1つでも成立 (OR)
//   すべて   … 有効な全トリガーが同一足で成立 (AND / 厳しい)
//   最低数   … 成立数が minTrigCount 以上
trigCombine  = input.string("いずれか", "トリガー結合", options = ["いずれか", "すべて", "最低数"], group = grpTrig)
minTrigCount = input.int(1, "最低トリガー数 (最低数モード時)", minval = 1, group = grpTrig)

// --- 下位足トリガー確認 (OFFで request.security を呼ばない) ---
useLowerTFTrig = input.bool(false, "下位足トリガー確認 (重い/OFFで軽量)", group = grpTrig)
lowerTF        = input.timeframe("1", "下位足TF", group = grpTrig)
lowerTFMode    = input.string("現在足のみ", "現在足/下位足 結合", options = ["現在足のみ", "下位足のみ", "現在足AND下位足", "現在足OR下位足"], group = grpTrig)

// --- トリガー個別パラメータ ---
emaLenTrig         = input.int(20,   "EMA Length (EMAリジェクト用)", minval = 1, group = grpTrig)
bosLookback        = input.int(10,   "BOS Lookback",               minval = 2, group = grpTrig)
pinWickBodyMult    = input.float(2.0, "ピンバー ヒゲ/実体倍率",     step = 0.1, group = grpTrig)
pinOppWickMaxRatio = input.float(1.0, "ピンバー 反対ヒゲ上限",      step = 0.1, group = grpTrig)
strongBodyRatio    = input.float(0.6, "強ローソク 実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
closeEdgeRatio     = input.float(0.7, "終値端寄せ率",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)

// --- クールダウン / 逆方向同時 ---
useTrigCooldown        = input.bool(false, "トリガークールダウンを使う", group = grpTrig)
trigCooldownBars       = input.int(3, "クールダウン本数", minval = 1, group = grpTrig)
useOppositeTrigNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade", group = grpTrig)

showTrigTable = input.bool(true, "トリガー Debug テーブルを表示", group = grpTrig)

// ============================================================
//  2. 入力 : ボラフィルタ
// ------------------------------------------------------------
//  OFF   … フィルタ無し (ATR 等の関数を呼ばない → 軽い)
//  通常ボラ (volMode) と 高速ボラ (fastVolMode) は独立して ON/OFF 可能。
//    volMode = OFF   … 通常ボラ無効 (base ATR/固定値の判定をしない)
//    volMode = ATR   … base ATR で判定
//    volMode = 固定値 … 現在足のレンジ (high-low) >= fixedMin で判定
//    fastVolMode     … 高速ボラ (OFF/ATR/固定値)。volMode に関係なく併用可
//  未使用の関数 (ta.atr 等) は呼ばれないため軽量。
// ============================================================
grpVol   = "ボラフィルタ"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)

// --- 固定値モード (通常ボラ) ---
fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", minval = 0.0, step = 0.1, group = grpVol)

// --- ATRモード (通常ボラ) ---
atrLenBase   = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5,  "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen    = input.int(480,    "ATR平均本数", minval = 10, group = grpVol)
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)
// --- 高速ボラ (OFF/ATR/固定値) : 通常ボラとは独立 ---
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数", minval = 1, group = grpVol)
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時", step = 0.1, group = grpVol)
fastFixedMin = input.float(3.0,  "直近値幅 最低($) ※固定値時", minval = 0.0, step = 0.1, group = grpVol)
bodyAvgLen   = input.int(5,      "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin   = input.float(0.5,  "実体平均最低($)", step = 0.1, group = grpVol)
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時", group = grpVol)
rangeLookback       = input.int(20,    "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)
useVolExpansion      = input.bool(false, "ボラ拡大判定を使う", group = grpVol)
volExpansionLookback = input.int(3,     "ボラ拡大判定本数", minval = 1, group = grpVol)
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数", minval = 1, group = grpVol)

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ------------------------------------------------------------
//  useEnvFilter = false の時は request.security を一切呼ばない。
// ============================================================
grpEnvMaster = "環境フィルタ"
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)", group = grpEnvMaster)

// --- 時間足の 要求状態 (上昇/レンジ/下降/OFF) と参照時間足 ---
//   各TFに「その足がこうであってほしい状態」を指定する。
//   OFF のTFは判定に使わない。
grpTF = "環境: 時間足 要求状態 / 参照時間足"
reqTrend4H  = input.string("レンジ", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf4")
tf4H        = input.timeframe("240", "TF",    group = grpTF, inline = "tf4")
reqTrend1H  = input.string("レンジ", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1")
tf1H        = input.timeframe("60",  "TF",    group = grpTF, inline = "tf1")
reqTrend15M = input.string("OFF", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf15")
tf15M       = input.timeframe("15",  "TF",    group = grpTF, inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf5")
tf5M        = input.timeframe("5",   "TF",    group = grpTF, inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1m")
tf1M        = input.timeframe("1",   "TF",    group = grpTF, inline = "tf1m")

// --- 上昇条件 ON/OFF ---
grpBull = "環境: 上昇条件 ON/OFF"
useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50",       group = grpBull)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き",       group = grpBull)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き",       group = grpBull)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50",       group = grpBull)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200",      group = grpBull)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBull)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBull)

// --- 下降条件 ON/OFF ---
grpBear = "環境: 下降条件 ON/OFF"
useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50",       group = grpBear)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き",       group = grpBear)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き",       group = grpBear)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50",       group = grpBear)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200",      group = grpBear)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBear)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBear)

// --- レンジ条件 ON/OFF ---
grpRange = "環境: レンジ条件 ON/OFF"
useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い",       group = grpRange)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い",         group = grpRange)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い",         group = grpRange)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中",          group = grpRange)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ", group = grpRange)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ", group = grpRange)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい",         group = grpRange)

// --- 調整パラメータ ---
grpParam = "環境: 調整パラメータ"
len20        = input.int(20,   "EMA20 length",  minval = 1, group = grpParam)
len50        = input.int(50,   "EMA50 length",  minval = 1, group = grpParam)
len200       = input.int(200,  "EMA200 length", minval = 1, group = grpParam)
envAtrLen    = input.int(14,   "環境ATR length", minval = 1, group = grpParam)
slopeBars    = input.int(3,    "EMA 傾き判定本数", minval = 1, group = grpParam)
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率",       minval = 0, step = 0.01, group = grpParam)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
convDivBars  = input.int(5,    "収束/拡散 判定本数",   minval = 1, group = grpParam)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数", minval = 1, group = grpParam)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数", minval = 1, group = grpParam)
rangeBars    = input.int(20,   "レンジ幅 判定本数",    minval = 1, group = grpParam)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率",    minval = 0, step = 0.1, group = grpParam)

// --- 判定ルール ---
grpJudge = "環境: 判定ルール"
tieAsRange          = input.bool(true, "同点時にレンジ扱いする",     group = grpJudge)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = grpJudge)
minScore4H  = input.int(3, "4H 最低必要スコア",  minval = 1, group = grpJudge)
minScore1H  = input.int(3, "1H 最低必要スコア",  minval = 1, group = grpJudge)
minScore15M = input.int(3, "15M 最低必要スコア", minval = 1, group = grpJudge)
minScore5M  = input.int(3, "5M 最低必要スコア",  minval = 1, group = grpJudge)
minScore1M  = input.int(3, "1M 最低必要スコア",  minval = 1, group = grpJudge)

// --- 環境フィルター接続 ---
//   有効(OFF以外)なTFのうち、実際のトレンドが要求と一致した数で判定。
grpLink = "環境: 判定"
reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)", minval = 0, group = grpLink)

// --- 環境テーブル表示 ---
grpEnvDisp = "環境: 表示"
showEnvTable = input.bool(true, "環境テーブルを表示", group = grpEnvDisp)
colUp    = input.color(color.new(color.green, 0), "上昇カラー",  group = grpEnvDisp)
colDown  = input.color(color.new(color.red,   0), "下降カラー",  group = grpEnvDisp)
colRange = input.color(color.new(color.gray,  0), "レンジカラー", group = grpEnvDisp)
colOff   = input.color(color.new(color.black, 0), "OFFカラー",   group = grpEnvDisp)

// ============================================================
//  3b. 入力 : MA(EMA大群)フィルタ
// ------------------------------------------------------------
//  EMA200/600/1000/2000/3000 の近くで「反発」or「ブレイク」を検出し、
//  方向フィルタ + (下位足トリガーとの合成) でエントリーを絞る。
//  useEMAFilter = false の時は ta.ema / ta.crossover 等を一切呼ばず軽い。
//    (3000本EMA を含むため ON 時のみ計算する)
//  ・反発   : EMA接近 + 反転ローソク (C)
//  ・ブレイク: EMAサポレジ転換(D) / EMA帯抜けリテスト(J) / 3000クリーンタッチ(K)
// ============================================================
grpEMA = "MA(EMA大群)フィルタ"
useEMAFilter = input.bool(false, "MAフィルタを使う (重い/OFFで軽量)", group = grpEMA)

emaLen1 = input.int(200,  "EMA 1 Length", minval = 1, group = grpEMA)
emaLen2 = input.int(600,  "EMA 2 Length", minval = 1, group = grpEMA)
emaLen3 = input.int(1000, "EMA 3 Length", minval = 1, group = grpEMA)
emaLen4 = input.int(2000, "EMA 4 Length", minval = 1, group = grpEMA)
emaLen5 = input.int(3000, "EMA 5 Length", minval = 1, group = grpEMA)
emaSource = input.source(close, "EMA Source", group = grpEMA)

// --- MAフィルタと下位足トリガーの合成 ---
//   反発/ブレイク必須 : MA反応が直近 emaReactBars 本以内 かつ 方向フィルタOK が必要
//   方向フィルタのみ   : MA反応は不要。帯/傾き/PO の方向フィルタのみ
emaRequireReaction = input.bool(true, "MA反発/ブレイクを必須にする (OFF=方向フィルタのみ)", group = grpEMA)
emaReactBars       = input.int(3, "MA反応の有効本数 (0=同一足のみ)", minval = 0, group = grpEMA)

// --- 反発 / ブレイク トリガー ON/OFF ---
useEMABounce         = input.bool(true,  "C: EMA反発",             group = grpEMA)
useEMASRFlip         = input.bool(true,  "D: EMAサポレジ転換",     group = grpEMA)
useEMABandRetest     = input.bool(true,  "J: EMA帯抜けリテスト",   group = grpEMA)
useEMA3000CleanTouch = input.bool(true,  "K: 3000EMA Clean Touch", group = grpEMA)
useEMACross          = input.bool(false, "E: EMAクロス",           group = grpEMA)
emaEntryMode         = input.string("Any", "反発/ブレイク結合", options = ["Any", "All"], group = grpEMA)

// --- 方向フィルタ ON/OFF ---
useEMABandFilter    = input.bool(true,  "A: EMA帯 上/中/下フィルタ", group = grpEMA)
useEMAInsideNoTrade = input.bool(true,  "B: EMA帯の中はNoTrade",     group = grpEMA)
useEMASlope         = input.bool(true,  "F: EMA傾き(3本以上一致)",   group = grpEMA)
useEMAPerfectOrder  = input.bool(false, "I: パーフェクトオーダー",   group = grpEMA)

// --- EMA接近判定 ---
emaTouchMode   = input.string("ATR", "EMA接近判定", options = ["Dollar", "ATR"], group = grpEMA)
emaTouchDollar = input.float(3.0,  "EMA接近幅($)",      step = 0.1,  group = grpEMA)
emaTouchATR    = input.float(0.25, "EMA接近幅 ATR倍率", step = 0.05, group = grpEMA)

// --- 傾き ---
emaSlopeLookback = input.int(5, "EMA傾き判定本数", minval = 1, group = grpEMA)
emaSlopeMinATR   = input.float(0.15, "最低傾き ATR倍率", step = 0.05, group = grpEMA)
emaFlatATR       = input.float(0.05, "水平判定 ATR倍率", step = 0.01, group = grpEMA)

// --- ブレイク保存本数 ---
emaSRFlipBars     = input.int(10, "EMAサポレジ転換 有効本数", minval = 1, group = grpEMA)
emaBandRetestBars = input.int(10, "EMA帯リテスト 有効本数",   minval = 1, group = grpEMA)

// --- 収束/発散 (Market State用) ---
emaConvergenceATR = input.float(1.0, "EMA収束判定 ATR倍率", step = 0.1, group = grpEMA)
emaDivergenceATR  = input.float(2.0, "EMA発散判定 ATR倍率", step = 0.1, group = grpEMA)
useEMAConvergenceNoTrade = input.bool(false, "EMA収束中NoTrade", group = grpEMA)

// --- 3000クリーン / 水平EMA ---
ema3000CleanDistanceATR = input.float(0.8, "3000EMA Clean距離 ATR倍率", step = 0.1, group = grpEMA)
useEMAFlatWeakFilter    = input.bool(true,  "水平EMAは反発弱い判定にする", group = grpEMA)
useEMAFlatBounceBlock   = input.bool(false, "水平EMA反発を禁止",           group = grpEMA)

// --- L: EMA Market State (アリゲーター思想) ---
useEMAMarketState     = input.bool(false, "L: EMA Market Stateを使う", group = grpEMA)
useEMASleepingNoTrade = input.bool(true,  "Sleeping中NoTrade",         group = grpEMA)
useEMAEndingNoTrade   = input.bool(false, "Ending中NoTrade",           group = grpEMA)
emaStateLookback      = input.int(5, "Market State判定Lookback", minval = 1, group = grpEMA)
emaAwakeningSpreadChangeATR = input.float(0.3, "Awakening 最低Spread拡大 ATR倍率", step = 0.05, group = grpEMA)
emaEndingSpreadShrinkATR    = input.float(0.3, "Ending 最低Spread縮小 ATR倍率",   step = 0.05, group = grpEMA)

// --- 表示 ---
showEMA           = input.bool(true,  "EMAを表示",           group = grpEMA)
showEMADebugTable = input.bool(true,  "MA Debug テーブルを表示", group = grpEMA)

// ============================================================
//  4. 入力 : リスク / 決済
// ============================================================
grpRisk = "リスク / 決済"
riskPct     = input.float(5.0, "1トレード損失率 (%)",  minval = 0.1, step = 0.1, group = grpRisk)
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = grpRisk)
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"], group = grpRisk)
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時", minval = 0.0, step = 0.1, group = grpRisk)
slFixed     = input.float(10, "固定SL幅 (価格) ※固定時",         minval = 0.0, step = 0.1, group = grpRisk)
rrRatio     = input.float(1.0, "リスクリワード比 (TP)", minval = 0.1, step = 0.1, group = grpRisk)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

// 包み足パターン (方向の有効化 useLong/useShort は section 10 の最終判定で適用)
bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5b. 追加エントリートリガー計算
// ------------------------------------------------------------
//  各トリガーは ON のときだけ計算する。
//  trigCombine / lowerTFMode は定数入力なので分岐は全バーで一貫し、
//  未使用トリガーの ta.* / request.security は呼ばれない。
//  最終的に entryLong / entryShort を出力し、section 10 で使う。
// ============================================================

// --- 結合関数 (現在足・下位足 共用) ---
f_combineTrig(int _cnt, int _enabled) =>
    trigCombine == "いずれか" ? _cnt >= 1 :
     trigCombine == "すべて"  ? (_enabled > 0 and _cnt >= _enabled) :
     _cnt >= minTrigCount

// --- 下位足トリガー計算関数 (request.security から呼ばれる) ---
//     戻り値 : [bullCount, bearCount]
f_lowerTrig() =>
    float _body   = math.abs(close - open)
    float _range  = high - low
    float _upWick = high - math.max(open, close)
    float _loWick = math.min(open, close) - low
    float _bodyR  = _range > 0 ? _body / _range : 0.0
    float _closeP = _range > 0 ? (close - low) / _range : 0.0

    // 包み足 (メインと同じ strict / 反対色 ルール)
    bool _prevUp  = close[1] > open[1]
    bool _prevDn  = close[1] < open[1]
    bool _curUp   = close > open
    bool _curDn   = close < open
    float _prevBHi = math.max(open[1], close[1])
    float _prevBLo = math.min(open[1], close[1])
    bool _engBody  = math.max(open, close) >= _prevBHi and math.min(open, close) <= _prevBLo
    bool _bE = useEngulfTrig and _curUp and (not reqOppColor or _prevDn) and (strictEngulf ? _engBody : close >= _prevBHi)
    bool _sE = useEngulfTrig and _curDn and (not reqOppColor or _prevUp) and (strictEngulf ? _engBody : close <= _prevBLo)

    // ピンバー
    bool _bP = usePinbarTrig and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closeP >= closeEdgeRatio
    bool _sP = usePinbarTrig and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closeP <= 1.0 - closeEdgeRatio

    // BOS (ta.* は ON時のみ)
    bool _bB = false
    bool _sB = false
    if useBOSTrig
        _bB := close > ta.highest(high, bosLookback)[1]
        _sB := close < ta.lowest(low, bosLookback)[1]

    // EMAリジェクト (ta.ema は ON時のみ)
    bool _bEma = false
    bool _sEma = false
    if useEMARejectTrig
        float _ema = ta.ema(close, emaLenTrig)
        _bEma := low <= _ema and close > _ema and close > open
        _sEma := high >= _ema and close < _ema and close < open

    // FVG形成
    bool _bF = useFVGTrig and low > high[2]
    bool _sF = useFVGTrig and high < low[2]

    // 強ローソク
    bool _bS = useStrongCandleTrig and close > open and _bodyR >= strongBodyRatio and _closeP >= closeEdgeRatio
    bool _sS = useStrongCandleTrig and close < open and _bodyR >= strongBodyRatio and _closeP <= 1.0 - closeEdgeRatio

    int _bull = (_bE ? 1 : 0) + (_bP ? 1 : 0) + (_bB ? 1 : 0) + (_bEma ? 1 : 0) + (_bF ? 1 : 0) + (_bS ? 1 : 0)
    int _bear = (_sE ? 1 : 0) + (_sP ? 1 : 0) + (_sB ? 1 : 0) + (_sEma ? 1 : 0) + (_sF ? 1 : 0) + (_sS ? 1 : 0)
    [_bull, _bear]

// --- 現在足のローソク基本量 (軽量な算術のみ) ---
float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

// 包み足 (既存 bullEngulf/bearEngulf を再利用)
bool trigBullEngulf = useEngulfTrig and bullEngulf
bool trigBearEngulf = useEngulfTrig and bearEngulf

// ピンバー
bool trigBullPin = false
bool trigBearPin = false
if usePinbarTrig
    trigBullPin := trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= closeEdgeRatio
    trigBearPin := trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - closeEdgeRatio

// BOS (ta.highest / ta.lowest → ON時のみ)
bool trigBullBOS = false
bool trigBearBOS = false
if useBOSTrig
    trigBullBOS := close > ta.highest(high, bosLookback)[1]
    trigBearBOS := close < ta.lowest(low, bosLookback)[1]

// EMAリジェクト (ta.ema → ON時のみ)
bool trigBullEMA = false
bool trigBearEMA = false
if useEMARejectTrig
    float emaT = ta.ema(close, emaLenTrig)
    trigBullEMA := low <= emaT and close > emaT and close > open
    trigBearEMA := high >= emaT and close < emaT and close < open

// FVG形成
bool trigBullFVG = false
bool trigBearFVG = false
if useFVGTrig
    trigBullFVG := low > high[2]
    trigBearFVG := high < low[2]

// 強ローソク
bool trigBullStrong = false
bool trigBearStrong = false
if useStrongCandleTrig
    trigBullStrong := close > open and trBodyRatio >= strongBodyRatio and trClosePos >= closeEdgeRatio
    trigBearStrong := close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - closeEdgeRatio

// 有効トリガー数 / bull・bear 成立数
int enabledTrigCount = (useEngulfTrig ? 1 : 0) + (usePinbarTrig ? 1 : 0) + (useBOSTrig ? 1 : 0) + (useEMARejectTrig ? 1 : 0) + (useFVGTrig ? 1 : 0) + (useStrongCandleTrig ? 1 : 0)
int bullTrigCount = (trigBullEngulf ? 1 : 0) + (trigBullPin ? 1 : 0) + (trigBullBOS ? 1 : 0) + (trigBullEMA ? 1 : 0) + (trigBullFVG ? 1 : 0) + (trigBullStrong ? 1 : 0)
int bearTrigCount = (trigBearEngulf ? 1 : 0) + (trigBearPin ? 1 : 0) + (trigBearBOS ? 1 : 0) + (trigBearEMA ? 1 : 0) + (trigBearFVG ? 1 : 0) + (trigBearStrong ? 1 : 0)

// 現在足の結合
bool curBull = f_combineTrig(bullTrigCount, enabledTrigCount)
bool curBear = f_combineTrig(bearTrigCount, enabledTrigCount)

// 下位足トリガー (useLowerTFTrig=false のときは request.security を呼ばない)
int ltBull = 0
int ltBear = 0
if useLowerTFTrig
    [_lb, _ls] = request.security(syminfo.tickerid, lowerTF, f_lowerTrig(), lookahead = barmerge.lookahead_off)
    ltBull := _lb
    ltBear := _ls

bool lowerBull = useLowerTFTrig and f_combineTrig(ltBull, enabledTrigCount)
bool lowerBear = useLowerTFTrig and f_combineTrig(ltBear, enabledTrigCount)

// 現在足 / 下位足 の結合
bool rawBull =
     not useLowerTFTrig or lowerTFMode == "現在足のみ"   ? curBull :
     lowerTFMode == "下位足のみ"        ? lowerBull :
     lowerTFMode == "現在足AND下位足"  ? (curBull and lowerBull) :
     (curBull or lowerBull)

bool rawBear =
     not useLowerTFTrig or lowerTFMode == "現在足のみ"   ? curBear :
     lowerTFMode == "下位足のみ"        ? lowerBear :
     lowerTFMode == "現在足AND下位足"  ? (curBear and lowerBear) :
     (curBear or lowerBear)

// 逆方向同時発生の NoTrade
bool trigBothFire = useOppositeTrigNoTrade and rawBull and rawBear

// クールダウン (発火足からの経過本数)
var int lastTrigBar = na
bool trigFiredNow   = rawBull or rawBear
bool trigCooldownOk = not useTrigCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > trigCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// トリガーモジュールの最終エントリー信号
bool entryLong  = rawBull and not trigBothFire and trigCooldownOk
bool entryShort = rawBear and not trigBothFire and trigCooldownOk

// ============================================================
//  6. ボラフィルタ判定
// ------------------------------------------------------------
//  通常ボラ (volMode) と 高速ボラ (fastVolMode) は独立して評価。
//  volMode / fastVolMode は定数入力なので分岐は全バーで一貫し、
//  未使用側の関数 (ta.atr 等) は呼ばれないため軽量。
// ============================================================

// --- 通常ボラ (base) : volMode で選択 ---
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin
// volMode == OFF のときは baseVolOk = true (通常ボラ無効・関数呼び出しなし)

// --- 高速ボラ (fast) : OFF/ATR/固定値。volMode に関係なく独立して使える ---
bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    // ATRを使わず、直近 fastAtrLen 本の値幅を固定しきい値で判定
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk
// fastVolMode == OFF のときは fastVolPass = true (関数呼び出しなし)

// --- 合成 + 低ボラ解除後の待機 (クールダウン) ---
bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境判定関数
// ------------------------------------------------------------
//  request.security から各時間足のコンテキストで呼ばれる。
//  戻り値 : [trend, bullScore, bearScore, rangeScore]
//           trend = 1=上昇 / 0=レンジ / -1=下降 / na=未判定
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    // 上昇スコア
    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    // 下降スコア
    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    // レンジスコア
    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    [trend, bullScore, bearScore, rangeScore]

// 環境テーブル用ヘルパー
// 要求文字列 → コード (1=上昇/0=レンジ/-1=下降/na=OFF)
f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 実際のトレンド値 → 表示文字列
f_trendTxt(float tr) =>
    na(tr)   ? "未判定" :
     tr == 1 ? "上昇" :
     tr == -1 ? "下降" : "レンジ"

// 要求文字列 → カラー
f_reqCol(string s) =>
    s == "上昇" ? colUp : s == "下降" ? colDown : s == "レンジ" ? colRange : colOff

// ============================================================
//  8. 環境フィルタ計算
// ------------------------------------------------------------
//  useEnvFilter は定数入力。OFF のときは if ブロックに入らず、
//  request.security を一切呼ばないため軽い。
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

var table envTable = table.new(position.top_right, 3, 6, border_width = 1)

if useEnvFilter
    [raw4H,  bull4H,  bear4H,  range4H ] = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
    [raw1H,  bull1H,  bear1H,  range1H ] = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
    [raw15M, bull15M, bear15M, range15M] = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)
    [raw5M,  bull5M,  bear5M,  range5M ] = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    [raw1M,  bull1M,  bear1M,  range1M ] = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    // 各TF : 有効か / 実際が要求と一致か
    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    // 必要一致数 (0=有効な全TF)。有効TFが無ければ制限なし。
    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

    // 環境テーブル : TF | 要求 | 実際
    if showEnvTable and barstate.islast
        table.cell(envTable, 0, 0, "TF",   text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 1, 0, "要求", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 2, 0, "実際", text_color = color.white, bgcolor = color.new(color.blue, 0))
        labels = array.from("4H", "1H", "15M", "5M", "1M")
        reqArr = array.from(reqTrend4H, reqTrend1H, reqTrend15M, reqTrend5M, reqTrend1M)
        detArr = array.from(raw4H, raw1H, raw15M, raw5M, raw1M)
        for i = 0 to 4
            row  = i + 1
            reqS = array.get(reqArr, i)
            det  = array.get(detArr, i)
            en   = reqS != "OFF"
            matched = en and not na(det) and det == f_reqCode(reqS)
            detCol  = not en ? colOff : matched ? color.new(color.green, 0) : color.new(color.red, 0)
            table.cell(envTable, 0, row, array.get(labels, i), text_color = color.white, bgcolor = color.new(color.gray, 30))
            table.cell(envTable, 1, row, reqS,               text_color = color.white, bgcolor = f_reqCol(reqS))
            table.cell(envTable, 2, row, en ? f_trendTxt(det) : "-", text_color = color.white, bgcolor = detCol)

// 環境フィルタ最終判定 (OFF なら常に許可)。ロング/ショート共通の環境テンプレート。
bool envLongOk  = not useEnvFilter or allowByEnv
bool envShortOk = not useEnvFilter or allowByEnv

// ============================================================
//  8b. MA(EMA大群)フィルタ計算
// ------------------------------------------------------------
//  useEMAFilter = false のときは if ブロックに入らず、ta.ema(3000本含む)
//  / ta.crossover を一切呼ばないため軽い。ブロック外は na/false になった
//  値を使う軽い算術・比較のみ。
//  出力 : emaLongOk / emaShortOk (section 10 の最終判定で AND)
// ============================================================
bool eAct = useEMAFilter

// --- 重い ta.* は ON時のみ計算 (ブロック外へ値を渡す) ---
float ema1 = na
float ema2 = na
float ema3 = na
float ema4 = na
float ema5 = na
float emaAtr = na
var float emaBreakUpLevel = na
var int   emaBreakUpBar   = na
var float emaBreakDnLevel = na
var int   emaBreakDnBar   = na
bool emaCrossBuyRaw  = false
bool emaCrossSellRaw = false
if useEMAFilter
    ema1 := ta.ema(emaSource, emaLen1)
    ema2 := ta.ema(emaSource, emaLen2)
    ema3 := ta.ema(emaSource, emaLen3)
    ema4 := ta.ema(emaSource, emaLen4)
    ema5 := ta.ema(emaSource, emaLen5)
    emaAtr := ta.atr(14)
    // D: サポレジ転換用ブレイク保存 (長期EMA優先)
    if ta.crossover(close, ema5)
        emaBreakUpLevel := ema5
        emaBreakUpBar := bar_index
    else if ta.crossover(close, ema4)
        emaBreakUpLevel := ema4
        emaBreakUpBar := bar_index
    else if ta.crossover(close, ema3)
        emaBreakUpLevel := ema3
        emaBreakUpBar := bar_index
    else if ta.crossover(close, ema2)
        emaBreakUpLevel := ema2
        emaBreakUpBar := bar_index
    else if ta.crossover(close, ema1)
        emaBreakUpLevel := ema1
        emaBreakUpBar := bar_index
    if ta.crossunder(close, ema5)
        emaBreakDnLevel := ema5
        emaBreakDnBar := bar_index
    else if ta.crossunder(close, ema4)
        emaBreakDnLevel := ema4
        emaBreakDnBar := bar_index
    else if ta.crossunder(close, ema3)
        emaBreakDnLevel := ema3
        emaBreakDnBar := bar_index
    else if ta.crossunder(close, ema2)
        emaBreakDnLevel := ema2
        emaBreakDnBar := bar_index
    else if ta.crossunder(close, ema1)
        emaBreakDnLevel := ema1
        emaBreakDnBar := bar_index
    // E: クロス
    emaCrossBuyRaw  := ta.crossover(ema1, ema2)  or ta.crossover(ema1, ema3)  or ta.crossover(ema2, ema3)
    emaCrossSellRaw := ta.crossunder(ema1, ema2) or ta.crossunder(ema1, ema3) or ta.crossunder(ema2, ema3)

// --- 接近判定関数 ---
f_emaNear(float _price, float _level, float _rng) =>
    not na(_level) and math.abs(_price - _level) <= _rng

float emaTouchRange = emaTouchMode == "ATR" ? emaAtr * emaTouchATR : emaTouchDollar

// --- A: EMA帯 上/中/下 ---
float emaBandTop    = math.max(ema1, math.max(ema2, math.max(ema3, math.max(ema4, ema5))))
float emaBandBottom = math.min(ema1, math.min(ema2, math.min(ema3, math.min(ema4, ema5))))
bool emaBandValid = not na(emaBandTop) and not na(emaBandBottom)
bool aboveEMABand  = emaBandValid and close > emaBandTop
bool belowEMABand  = emaBandValid and close < emaBandBottom
bool insideEMABand = emaBandValid and not aboveEMABand and not belowEMABand
bool emaBandOkLong  = not (eAct and useEMABandFilter) or aboveEMABand
bool emaBandOkShort = not (eAct and useEMABandFilter) or belowEMABand

// --- 反転ローソク (共通) ---
float ema_body   = math.abs(close - open)
float ema_upWick = high - math.max(open, close)
float ema_dnWick = math.min(open, close) - low
bool ema_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool ema_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool ema_pinLower = ema_dnWick >= ema_body and ema_dnWick >= ema_upWick
bool ema_pinUpper = ema_upWick >= ema_body and ema_upWick >= ema_dnWick
bool ema_bullishReversal = ema_bullEngulf or ema_pinLower or close > open
bool ema_bearishReversal = ema_bearEngulf or ema_pinUpper or close < open

// --- EMA接近 (方向別) ---
bool nearEMA1 = f_emaNear(close, ema1, emaTouchRange)
bool nearEMA2 = f_emaNear(close, ema2, emaTouchRange)
bool nearEMA3 = f_emaNear(close, ema3, emaTouchRange)
bool nearEMA4 = f_emaNear(close, ema4, emaTouchRange)
bool nearEMA5 = f_emaNear(close, ema5, emaTouchRange)
bool nearLowerEMA = (nearEMA1 and ema1 <= close) or (nearEMA2 and ema2 <= close) or (nearEMA3 and ema3 <= close) or (nearEMA4 and ema4 <= close) or (nearEMA5 and ema5 <= close)
bool nearUpperEMA = (nearEMA1 and ema1 >= close) or (nearEMA2 and ema2 >= close) or (nearEMA3 and ema3 >= close) or (nearEMA4 and ema4 >= close) or (nearEMA5 and ema5 >= close)

// --- F: EMA傾き ---
float emaSlopeThreshold = emaAtr * emaSlopeMinATR
float emaFlatThreshold  = emaAtr * emaFlatATR
float ema1Slope = ema1 - ema1[emaSlopeLookback]
float ema2Slope = ema2 - ema2[emaSlopeLookback]
float ema3Slope = ema3 - ema3[emaSlopeLookback]
float ema4Slope = ema4 - ema4[emaSlopeLookback]
float ema5Slope = ema5 - ema5[emaSlopeLookback]
int emaSlopeUpCount   = (ema1Slope > emaSlopeThreshold ? 1 : 0) + (ema2Slope > emaSlopeThreshold ? 1 : 0) + (ema3Slope > emaSlopeThreshold ? 1 : 0) + (ema4Slope > emaSlopeThreshold ? 1 : 0) + (ema5Slope > emaSlopeThreshold ? 1 : 0)
int emaSlopeDownCount = (ema1Slope < -emaSlopeThreshold ? 1 : 0) + (ema2Slope < -emaSlopeThreshold ? 1 : 0) + (ema3Slope < -emaSlopeThreshold ? 1 : 0) + (ema4Slope < -emaSlopeThreshold ? 1 : 0) + (ema5Slope < -emaSlopeThreshold ? 1 : 0)
int emaFlatCount      = (math.abs(ema1Slope) <= emaFlatThreshold ? 1 : 0) + (math.abs(ema2Slope) <= emaFlatThreshold ? 1 : 0) + (math.abs(ema3Slope) <= emaFlatThreshold ? 1 : 0) + (math.abs(ema4Slope) <= emaFlatThreshold ? 1 : 0) + (math.abs(ema5Slope) <= emaFlatThreshold ? 1 : 0)
bool ema1Flat = math.abs(ema1Slope) <= emaFlatThreshold
bool ema2Flat = math.abs(ema2Slope) <= emaFlatThreshold
bool ema3Flat = math.abs(ema3Slope) <= emaFlatThreshold
bool ema4Flat = math.abs(ema4Slope) <= emaFlatThreshold
bool ema5Flat = math.abs(ema5Slope) <= emaFlatThreshold
bool emaSlopeOkLong  = not (eAct and useEMASlope) or emaSlopeUpCount   >= 3
bool emaSlopeOkShort = not (eAct and useEMASlope) or emaSlopeDownCount >= 3

// --- B: EMA帯の中NoTrade ---
bool emaNoTradeLong  = eAct and useEMAInsideNoTrade and insideEMABand
bool emaNoTradeShort = eAct and useEMAInsideNoTrade and insideEMABand

// --- C: EMA反発 (方向別 / 水平EMA弱判定) ---
bool emaBounceWeakBuy  = useEMAFlatWeakFilter and ((nearEMA1 and ema1 <= close and ema1Flat) or (nearEMA2 and ema2 <= close and ema2Flat) or (nearEMA3 and ema3 <= close and ema3Flat) or (nearEMA4 and ema4 <= close and ema4Flat) or (nearEMA5 and ema5 <= close and ema5Flat))
bool emaBounceWeakSell = useEMAFlatWeakFilter and ((nearEMA1 and ema1 >= close and ema1Flat) or (nearEMA2 and ema2 >= close and ema2Flat) or (nearEMA3 and ema3 >= close and ema3Flat) or (nearEMA4 and ema4 >= close and ema4Flat) or (nearEMA5 and ema5 >= close and ema5Flat))
bool emaBuyBounceSignal  = eAct and useEMABounce and nearLowerEMA and ema_bullishReversal and close > emaBandBottom and not (useEMAFlatBounceBlock and emaBounceWeakBuy)
bool emaSellBounceSignal = eAct and useEMABounce and nearUpperEMA and ema_bearishReversal and close < emaBandTop    and not (useEMAFlatBounceBlock and emaBounceWeakSell)

// --- D: EMAサポレジ転換 (ブレイク後の押し戻り) ---
bool emaBuySRFlipSignal  = eAct and useEMASRFlip and not na(emaBreakUpLevel) and (bar_index - emaBreakUpBar) <= emaSRFlipBars and low <= emaBreakUpLevel + emaTouchRange and close > emaBreakUpLevel and ema_bullishReversal
bool emaSellSRFlipSignal = eAct and useEMASRFlip and not na(emaBreakDnLevel) and (bar_index - emaBreakDnBar) <= emaSRFlipBars and high >= emaBreakDnLevel - emaTouchRange and close < emaBreakDnLevel and ema_bearishReversal

// --- E: EMAクロス ---
bool emaBuyCrossSignal  = eAct and useEMACross and emaCrossBuyRaw
bool emaSellCrossSignal = eAct and useEMACross and emaCrossSellRaw

// --- G/H: 収束 / 発散 (Market State用) ---
float emaSpread    = emaBandValid ? emaBandTop - emaBandBottom : na
bool emaConvergenceSignal = eAct and not na(emaSpread) and emaSpread <= emaAtr * emaConvergenceATR
bool emaDivergenceSignal  = eAct and not na(emaSpread) and emaSpread >= emaAtr * emaDivergenceATR
bool emaSpreadExpanding   = not na(emaSpread) and not na(emaSpread[1]) and emaSpread > emaSpread[1]
bool emaNoTradeConvergence = eAct and useEMAConvergenceNoTrade and emaConvergenceSignal

// --- I: パーフェクトオーダー ---
bool emaPerfectOrderLong  = ema1 > ema2 and ema2 > ema3 and ema3 > ema4 and ema4 > ema5
bool emaPerfectOrderShort = ema1 < ema2 and ema2 < ema3 and ema3 < ema4 and ema4 < ema5
bool emaPerfectOrderOkLong  = not (eAct and useEMAPerfectOrder) or emaPerfectOrderLong
bool emaPerfectOrderOkShort = not (eAct and useEMAPerfectOrder) or emaPerfectOrderShort

// --- J: EMA帯抜けリテスト (ta.* 不使用のため常時 var 更新) ---
var int emaBandBreakUpBar = na
var int emaBandBreakDnBar = na
if aboveEMABand and not aboveEMABand[1]
    emaBandBreakUpBar := bar_index
if belowEMABand and not belowEMABand[1]
    emaBandBreakDnBar := bar_index
bool emaBuyBandRetestSignal  = eAct and useEMABandRetest and emaBandValid and not na(emaBandBreakUpBar) and (bar_index - emaBandBreakUpBar) <= emaBandRetestBars and low <= emaBandTop + emaTouchRange and close > emaBandTop and ema_bullishReversal
bool emaSellBandRetestSignal = eAct and useEMABandRetest and emaBandValid and not na(emaBandBreakDnBar) and (bar_index - emaBandBreakDnBar) <= emaBandRetestBars and high >= emaBandBottom - emaTouchRange and close < emaBandBottom and ema_bearishReversal

// --- K: 3000EMA Clean Touch ---
float ema3000CleanDistance = emaAtr * ema3000CleanDistanceATR
bool ema3000Clean = not na(ema5) and math.abs(ema1 - ema5) > ema3000CleanDistance and math.abs(ema2 - ema5) > ema3000CleanDistance and math.abs(ema3 - ema5) > ema3000CleanDistance and math.abs(ema4 - ema5) > ema3000CleanDistance
bool ema3000CleanTouch = eAct and useEMA3000CleanTouch and nearEMA5 and ema3000Clean

// --- L: EMA Market State ---
bool emaStateActive = useEMAFilter and useEMAMarketState
float emaSpreadChange    = (not na(emaSpread) and not na(emaSpread[emaStateLookback])) ? emaSpread - emaSpread[emaStateLookback] : na
float emaSpreadChangeATR = (emaAtr != 0 and not na(emaSpreadChange)) ? emaSpreadChange / emaAtr : na
bool emaSpreadExpansionStrong = not na(emaSpreadChangeATR) and emaSpreadChangeATR >=  emaAwakeningSpreadChangeATR
bool emaSpreadShrinkStrong    = not na(emaSpreadChangeATR) and emaSpreadChangeATR <= -emaEndingSpreadShrinkATR
bool emaStateSleeping = emaStateActive and emaConvergenceSignal and emaFlatCount >= 3
bool emaStateAwakeningLong  = emaStateActive and emaSpreadExpanding and emaSpreadExpansionStrong and aboveEMABand and emaSlopeUpCount >= 2
bool emaStateAwakeningShort = emaStateActive and emaSpreadExpanding and emaSpreadExpansionStrong and belowEMABand and emaSlopeDownCount >= 2
bool emaStateHuntingLong  = emaStateActive and emaDivergenceSignal and aboveEMABand and (emaPerfectOrderLong or emaSlopeUpCount >= 4)
bool emaStateHuntingShort = emaStateActive and emaDivergenceSignal and belowEMABand and (emaPerfectOrderShort or emaSlopeDownCount >= 4)
bool emaStateEndingLong  = emaStateActive and (emaSpreadShrinkStrong or (emaPerfectOrderLong[1] and not emaPerfectOrderLong)) and aboveEMABand
bool emaStateEndingShort = emaStateActive and (emaSpreadShrinkStrong or (emaPerfectOrderShort[1] and not emaPerfectOrderShort)) and belowEMABand
bool emaStateEndingAny = emaStateEndingLong or emaStateEndingShort
int emaMarketState = not emaStateActive ? 0 : emaStateEndingAny ? 4 : (emaStateHuntingLong or emaStateHuntingShort) ? 3 : (emaStateAwakeningLong or emaStateAwakeningShort) ? 2 : emaStateSleeping ? 1 : 0
bool emaNoTradeSleeping = emaStateActive and useEMASleepingNoTrade and emaStateSleeping
bool emaNoTradeEnding   = emaStateActive and useEMAEndingNoTrade   and emaStateEndingAny
bool emaStateBiasLong  = emaStateActive and (emaStateAwakeningLong or emaStateHuntingLong)   and not emaStateSleeping and not emaStateEndingAny
bool emaStateBiasShort = emaStateActive and (emaStateAwakeningShort or emaStateHuntingShort) and not emaStateSleeping and not emaStateEndingAny
bool emaStateOkLong  = not useEMAMarketState or emaStateBiasLong  or emaMarketState == 0
bool emaStateOkShort = not useEMAMarketState or emaStateBiasShort or emaMarketState == 0

// --- 反発/ブレイク 結合 (Any / All) ---
int emaEnabledCount = (useEMABounce ? 1 : 0) + (useEMASRFlip ? 1 : 0) + (useEMACross ? 1 : 0) + (useEMABandRetest ? 1 : 0) + (useEMA3000CleanTouch ? 1 : 0)
int emaFiredBuy  = (emaBuyBounceSignal ? 1 : 0) + (emaBuySRFlipSignal ? 1 : 0) + (emaBuyCrossSignal ? 1 : 0) + (emaBuyBandRetestSignal ? 1 : 0) + ((ema3000CleanTouch and close > ema5 and ema_bullishReversal) ? 1 : 0)
int emaFiredSell = (emaSellBounceSignal ? 1 : 0) + (emaSellSRFlipSignal ? 1 : 0) + (emaSellCrossSignal ? 1 : 0) + (emaSellBandRetestSignal ? 1 : 0) + ((ema3000CleanTouch and close < ema5 and ema_bearishReversal) ? 1 : 0)
bool emaReactBuy  = eAct and emaEnabledCount > 0 and (emaEntryMode == "All" ? emaFiredBuy  == emaEnabledCount : emaFiredBuy  >= 1)
bool emaReactSell = eAct and emaEnabledCount > 0 and (emaEntryMode == "All" ? emaFiredSell == emaEnabledCount : emaFiredSell >= 1)

// --- 反発/ブレイクの有効本数ウィンドウ ---
var int lastEmaReactBuyBar  = na
var int lastEmaReactSellBar = na
if emaReactBuy
    lastEmaReactBuyBar := bar_index
if emaReactSell
    lastEmaReactSellBar := bar_index
bool emaBuyContext  = not na(lastEmaReactBuyBar)  and (bar_index - lastEmaReactBuyBar)  <= emaReactBars
bool emaSellContext = not na(lastEmaReactSellBar) and (bar_index - lastEmaReactSellBar) <= emaReactBars

// --- 方向フィルタ + NoTrade ---
bool emaBiasLong  = emaBandOkLong  and not emaNoTradeLong  and emaSlopeOkLong  and emaPerfectOrderOkLong
bool emaBiasShort = emaBandOkShort and not emaNoTradeShort and emaSlopeOkShort and emaPerfectOrderOkShort
bool emaBlock = emaNoTradeConvergence or emaNoTradeSleeping or emaNoTradeEnding
bool emaNoTrade = emaNoTradeLong or emaNoTradeShort or emaBlock

// --- 最終出力 (OFF なら常に許可) ---
//   反発/ブレイク必須モード : 直近 emaReactBars 本以内に反応 かつ 方向フィルタOK
//   方向フィルタのみモード   : 方向フィルタOK のみ
bool emaLongOk  = not useEMAFilter or (emaBiasLong  and emaStateOkLong  and not emaBlock and (not emaRequireReaction or emaBuyContext))
bool emaShortOk = not useEMAFilter or (emaBiasShort and emaStateOkShort and not emaBlock and (not emaRequireReaction or emaSellContext))

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// SL方式: パターン=包み足の高安ベース / 固定=一定の価格幅
float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

// 損失許容額 = 基準資金 * リスク%
//   複利 OFF … 元金 (initial_capital) 基準 = 単利
//   複利 ON  … 現在残高 (equity) 基準 = 複利
float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

// リスク幅(価格)から整数ロットを算出 (1未満は 0 → エントリーしない)
f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  10. 最終エントリー条件
// ============================================================
bool canLong  = useLong  and entryLong  and volOk and envLongOk  and emaLongOk  and longRisk  > 0 and longQty  >= 1
bool canShort = useShort and entryShort and volOk and envShortOk and emaShortOk and shortRisk > 0 and shortQty >= 1

// ============================================================
//  11. 発注
// ------------------------------------------------------------
//  ポジション保有中は新規シグナルを無視 (ドテンしない)。
//  ノーポジ (position_size == 0) のときだけエントリーし、
//  決済は SL / TP のみ。
// ============================================================
bool isFlat = strategy.position_size == 0

if isFlat and canLong
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longTP)

if isFlat and canShort
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortTP)

// ============================================================
//  12. 表示
// ============================================================
plotshape(canLong,  "エントリー買い", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(canShort, "エントリー売り", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,   0), size = size.small)

// Data Window 出力 (デバッグ用)
plot(volOk    ? 1 : 0, "volOk",     display = display.data_window)
plot(longQty,          "longQty",   display = display.data_window)
plot(shortQty,         "shortQty",  display = display.data_window)
plot(envEnabled,       "envEnabled", display = display.data_window)
plot(envMatched,       "envMatched", display = display.data_window)
plot(envLongOk  ? 1 : 0, "envLongOk",  display = display.data_window)
plot(envShortOk ? 1 : 0, "envShortOk", display = display.data_window)

// --- 追加トリガー デバッグ出力 ---
plot(trigBullEngulf ? 1 : 0, "trigBullEngulf", display = display.data_window)
plot(trigBearEngulf ? 1 : 0, "trigBearEngulf", display = display.data_window)
plot(trigBullPin    ? 1 : 0, "trigBullPin",    display = display.data_window)
plot(trigBearPin    ? 1 : 0, "trigBearPin",    display = display.data_window)
plot(trigBullBOS    ? 1 : 0, "trigBullBOS",    display = display.data_window)
plot(trigBearBOS    ? 1 : 0, "trigBearBOS",    display = display.data_window)
plot(trigBullEMA    ? 1 : 0, "trigBullEMA",    display = display.data_window)
plot(trigBearEMA    ? 1 : 0, "trigBearEMA",    display = display.data_window)
plot(trigBullFVG    ? 1 : 0, "trigBullFVG",    display = display.data_window)
plot(trigBearFVG    ? 1 : 0, "trigBearFVG",    display = display.data_window)
plot(trigBullStrong ? 1 : 0, "trigBullStrong", display = display.data_window)
plot(trigBearStrong ? 1 : 0, "trigBearStrong", display = display.data_window)
plot(bullTrigCount, "bullTrigCount", display = display.data_window)
plot(bearTrigCount, "bearTrigCount", display = display.data_window)
plot(ltBull,        "ltBull",        display = display.data_window)
plot(ltBear,        "ltBear",        display = display.data_window)
plot(entryLong  ? 1 : 0, "entryLong",  display = display.data_window)
plot(entryShort ? 1 : 0, "entryShort", display = display.data_window)

// --- トリガー デバッグテーブル (最終バーのみ描画・軽量) ---
f_yn(bool b) => b ? "●" : "-"
var table trigTable = table.new(position.bottom_right, 3, 9, border_width = 1)
if showTrigTable and barstate.islast
    table.cell(trigTable, 0, 0, "トリガー", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(trigTable, 1, 0, "買", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(trigTable, 2, 0, "売", text_color = color.white, bgcolor = color.new(color.blue, 0))
    trigNames = array.from("包み足", "ピンバー", "BOS", "EMAリジェクト", "FVG", "強ローソク")
    trigEn    = array.from(useEngulfTrig, usePinbarTrig, useBOSTrig, useEMARejectTrig, useFVGTrig, useStrongCandleTrig)
    trigBull  = array.from(trigBullEngulf, trigBullPin, trigBullBOS, trigBullEMA, trigBullFVG, trigBullStrong)
    trigBear  = array.from(trigBearEngulf, trigBearPin, trigBearBOS, trigBearEMA, trigBearFVG, trigBearStrong)
    for i = 0 to 5
        row  = i + 1
        en   = array.get(trigEn, i)
        nmCol = en ? color.new(color.gray, 30) : color.new(color.gray, 70)
        table.cell(trigTable, 0, row, array.get(trigNames, i), text_color = en ? color.white : color.new(color.white, 50), bgcolor = nmCol)
        table.cell(trigTable, 1, row, en ? f_yn(array.get(trigBull, i)) : "OFF", text_color = color.white, bgcolor = en and array.get(trigBull, i) ? color.new(color.green, 0) : nmCol)
        table.cell(trigTable, 2, row, en ? f_yn(array.get(trigBear, i)) : "OFF", text_color = color.white, bgcolor = en and array.get(trigBear, i) ? color.new(color.red, 0) : nmCol)
    table.cell(trigTable, 0, 7, "成立数 買/売", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(trigTable, 1, 7, str.tostring(bullTrigCount), text_color = color.white)
    table.cell(trigTable, 2, 7, str.tostring(bearTrigCount), text_color = color.white)
    table.cell(trigTable, 0, 8, "エントリー", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(trigTable, 1, 8, canLong  ? "LONG" : "-", text_color = color.white, bgcolor = canLong  ? color.new(color.green, 0) : color.new(color.gray, 30))
    table.cell(trigTable, 2, 8, canShort ? "SHORT" : "-", text_color = color.white, bgcolor = canShort ? color.new(color.red, 0) : color.new(color.gray, 30))

// ============================================================
//  12b. 表示 : MA(EMA大群)フィルタ
// ------------------------------------------------------------
//  ema1-5 / 帯は OFF (useEMAFilter=false) のとき na → 描画されない。
// ============================================================
bool emaShow = useEMAFilter and showEMA
plot(emaShow ? ema1 : na, "EMA1", color = emaShow ? color.new(color.yellow, 0)  : na, linewidth = 1)
plot(emaShow ? ema2 : na, "EMA2", color = emaShow ? color.new(color.orange, 0)  : na, linewidth = 1)
plot(emaShow ? ema3 : na, "EMA3", color = emaShow ? color.new(color.red, 0)     : na, linewidth = 2)
plot(emaShow ? ema4 : na, "EMA4", color = emaShow ? color.new(color.purple, 0)  : na, linewidth = 2)
plot(emaShow ? ema5 : na, "EMA5", color = emaShow ? color.new(color.fuchsia, 0) : na, linewidth = 3)
pEmaTop = plot(emaShow ? emaBandTop    : na, "EMA BandTop",    color = na)
pEmaBot = plot(emaShow ? emaBandBottom : na, "EMA BandBottom", color = na)
fill(pEmaTop, pEmaBot, color = emaShow ? color.new(color.gray, 90) : na, title = "EMA Band")

// MA反応シグナル形状
plotshape(useEMAFilter and (emaBuyBounceSignal or emaBuySRFlipSignal or emaBuyBandRetestSignal),   title = "MA反発/ブレイク買", style = shape.diamond, location = location.belowbar, color = color.new(color.aqua, 0),   size = size.tiny)
plotshape(useEMAFilter and (emaSellBounceSignal or emaSellSRFlipSignal or emaSellBandRetestSignal), title = "MA反発/ブレイク売", style = shape.diamond, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)

// MA Data Window 出力
plot(useEMAFilter and aboveEMABand ? 1 : 0, "aboveEMABand", display = display.data_window)
plot(useEMAFilter and belowEMABand ? 1 : 0, "belowEMABand", display = display.data_window)
plot(emaReactBuy   ? 1 : 0, "emaReactBuy",  display = display.data_window)
plot(emaReactSell  ? 1 : 0, "emaReactSell", display = display.data_window)
plot(emaBuyContext ? 1 : 0, "emaBuyContext",  display = display.data_window)
plot(emaSellContext ? 1 : 0, "emaSellContext", display = display.data_window)
plot(emaSlopeUpCount,   "emaSlopeUpCount",   display = display.data_window)
plot(emaSlopeDownCount, "emaSlopeDownCount", display = display.data_window)
plot(emaLongOk  ? 1 : 0, "emaLongOk",  display = display.data_window)
plot(emaShortOk ? 1 : 0, "emaShortOk", display = display.data_window)

// MA デバッグテーブル (最終バーのみ・軽量)
var table emaTable = table.new(position.middle_right, 2, 8, border_width = 1)
if useEMAFilter and showEMADebugTable and barstate.islast
    string sBand = aboveEMABand ? "帯上" : insideEMABand ? "帯中" : belowEMABand ? "帯下" : "-"
    table.cell(emaTable, 0, 0, "MAフィルタ", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(emaTable, 1, 0, emaNoTrade ? "NoTrade" : (emaLongOk and not emaShortOk ? "LONG OK" : emaShortOk and not emaLongOk ? "SHORT OK" : "-"), text_color = color.white, bgcolor = emaNoTrade ? color.new(color.red, 20) : color.new(color.blue, 0))
    table.cell(emaTable, 0, 1, "帯位置", text_color = color.white)
    table.cell(emaTable, 1, 1, sBand, text_color = color.white)
    table.cell(emaTable, 0, 2, "反応 買/売 (今)", text_color = color.white)
    table.cell(emaTable, 1, 2, (emaReactBuy ? "●" : "-") + " / " + (emaReactSell ? "●" : "-"), text_color = color.white)
    table.cell(emaTable, 0, 3, "反応 有効中 買/売", text_color = color.white)
    table.cell(emaTable, 1, 3, (emaBuyContext ? "Y" : "-") + " / " + (emaSellContext ? "Y" : "-"), text_color = color.white)
    table.cell(emaTable, 0, 4, "傾き U/D/F", text_color = color.white)
    table.cell(emaTable, 1, 4, str.tostring(emaSlopeUpCount) + "/" + str.tostring(emaSlopeDownCount) + "/" + str.tostring(emaFlatCount), text_color = color.white)
    table.cell(emaTable, 0, 5, "PO L/S", text_color = color.white)
    table.cell(emaTable, 1, 5, (emaPerfectOrderLong ? "Y" : "N") + " / " + (emaPerfectOrderShort ? "Y" : "N"), text_color = color.white)
    table.cell(emaTable, 0, 6, "3000Clean", text_color = color.white)
    table.cell(emaTable, 1, 6, ema3000CleanTouch ? "Y" : "N", text_color = color.white)
    table.cell(emaTable, 0, 7, "Allow L/S", text_color = color.white)
    table.cell(emaTable, 1, 7, (emaLongOk ? "L" : "-") + " / " + (emaShortOk ? "S" : "-"), text_color = color.white, bgcolor = color.new(color.gray, 30))

// © ka.mickey15
//
// ============================================================
//  5分足 包み足ストラテジー (Engulfing Strategy)
// ------------------------------------------------------------
//  ・エントリー : 包み足 (Bullish / Bearish Engulfing)
//  ・ボラフィルタ : OFF / ATR / 固定値 の3モード
//      - OFF の時は ATR 等の関数を一切呼ばず、負荷を軽くする
//  ・リスク : 1トレードの損失を口座の 5% に固定 (position sizing)
//  ・ロット : 整数に切り捨て。1未満はエントリーしない。
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "5min Engulfing Strategy",
     shorttitle        = "ENG5",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     max_bars_back     = 500
 )

// ============================================================
//  1. 入力 : エントリー (包み足)
// ============================================================
grpEntry = "エントリー (包み足)"
useLong      = input.bool(true, "ロングを有効",              group = grpEntry)
useShort     = input.bool(true, "ショートを有効",            group = grpEntry)
strictEngulf = input.bool(true, "実体が前足を完全に包む",     group = grpEntry)
reqOppColor  = input.bool(true, "前足が反対色であることを要求", group = grpEntry)

// ============================================================
//  2. 入力 : ボラフィルタ
// ------------------------------------------------------------
//  OFF   … フィルタ無し (ATR 等の関数を呼ばない → 軽い)
//  ATR   … ta.atr(atrLen) >= atrMin でボラを判定
//  固定値 … 現在足のレンジ (high-low) >= fixedMin で判定
// ============================================================
grpVol   = "ボラフィルタ"
volMode  = input.string("OFF", "ボラフィルタ", options = ["OFF", "ATR", "固定値"], group = grpVol)
atrLen   = input.int(14,   "ATR本数",              minval = 1,   step = 1,   group = grpVol)
atrMin   = input.float(1.5, "最低ATR (価格)",        minval = 0.0, step = 0.1, group = grpVol)
fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", minval = 0.0, step = 0.1, group = grpVol)

// ============================================================
//  3. 入力 : リスク / 決済
// ============================================================
grpRisk = "リスク / 決済"
riskPct = input.float(5.0, "1トレード損失率 (%)",  minval = 0.1, step = 0.1, group = grpRisk)
slBuf   = input.float(0.0, "SL バッファ (価格)",   minval = 0.0, step = 0.1, group = grpRisk)
rrRatio = input.float(1.5, "リスクリワード比 (TP)", minval = 0.1, step = 0.1, group = grpRisk)

// ============================================================
//  4. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

// 実体の上下端
float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

// 現在足の実体が前足の実体を完全に包むか
bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = useLong  and curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = useShort and curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5. ボラフィルタ判定
// ------------------------------------------------------------
//  volMode は定数入力なので if 分岐は全バーで一貫。
//  OFF のときは ta.atr 等を一切呼ばないため軽量。
// ============================================================
bool volOk = true
if volMode == "ATR"
    volOk := ta.atr(atrLen) >= atrMin
else if volMode == "固定値"
    volOk := (high - low) >= fixedMin

// ============================================================
//  6. SL / TP / ロット計算
// ============================================================
// パターン (2本) の高値・安値
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])

// エントリー価格の概算 (現在足の終値)
float entryEst = close

// ロング側の SL / リスク幅 / TP
float longStop = patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

// ショート側の SL / リスク幅 / TP
float shortStop = patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

// 損失許容額 = 口座残高 * リスク%
float riskCapital = strategy.equity * riskPct / 100.0

// リスク幅(価格)から整数ロットを算出 (1未満は 0 → エントリーしない)
f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  7. 最終エントリー条件
// ============================================================
bool canLong  = bullEngulf and volOk and longRisk  > 0 and longQty  >= 1
bool canShort = bearEngulf and volOk and shortRisk > 0 and shortQty >= 1

// ============================================================
//  8. 発注
// ============================================================
if canLong
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longTP)

if canShort
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortTP)

// ============================================================
//  9. 表示
// ============================================================
plotshape(canLong,  "包み足買い", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(canShort, "包み足売り", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,   0), size = size.small)

// Data Window 出力 (デバッグ用)
plot(volOk     ? 1 : 0, "volOk",    display = display.data_window)
plot(longQty,           "longQty",  display = display.data_window)
plot(shortQty,          "shortQty", display = display.data_window)

zgSepD   = input.bool(true, "日足: 最低離れ幅フィルターを使う", group = G_ZGD,
     tooltip = "各項目の意味・判定は LongTermDoubleTripleTopBottomXAU と同じ (本数は日足の bar_index)。検知イベント (反転足の確定) で Zone を発動する。")

var string G_JD = "03 · 判定"
zcDepW = input.float(5.0, "離脱幅 ($)", minval = 0.01, step = 0.5, group = G_JD,
     tooltip = "接触中の解除 (Zone ごと・自分の帯で判定): 確定 5分足が帯の完全に外側で、帯の端からの距離がこの値以上。")
zcDepMin = input.int(30, "離脱時間 (分)", minval = 1, group = G_JD,
     tooltip = "接触中の解除: 完全に外側の状態が、最初の外側の足の開始から今の足の確定までこの分数以上続いた (実際の経過時間)。")

zcStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "集計開始日時 (タッチ足の確定時刻)", group = G_JD,
     tooltip = "タッチ足の time_close がこの日時より前のタッチはイベントにしない (PointMasterVerifierV2 の集計開始日時と同じ考え方・同じ初期値)。")
zcWarm = input.int(6000, "先頭から集計しない助走本数 (0 = 無効)", minval = 0, group = G_JD,
     tooltip = "読み込んだ確定 5分足の先頭からこの本数の間はイベントを作らない (EMA 3000 の初期誤差と、上位足由来の Zone がまだ揃っていない区間を外す)。\n" +
     "その間も Zone の登録・更新・失効と接触中の状態の更新は通常どおり行い、タッチの件数だけ別に表示する。")

var string G_DS = "04 · 表示 (集計値には影響しない)"
zcKind    = input.string("根拠集合 (完全一致)", "表の行", options = ["根拠集合 (完全一致)", "根拠数別"], group = G_DS)
zcView    = input.string("到達率", "表示切替", options = ["到達率", "初回到達時間", "MFE・MAE", "到達前逆行", "件数内訳"], group = G_DS)
zcDirMode = input.string("LONG / SHORT 別", "方向", options = ["LONG / SHORT 別", "LONG＋SHORT合算", "LONGのみ", "SHORTのみ"], group = G_DS)
zcHzMode  = input.string("全期間", "表示する観察期間", options = ["全期間", "5分", "15分", "30分"], group = G_DS)
zcTopN    = input.int(6, "根拠集合の表示行数 (件数の多い順。残りは「その他」)", minval = 1, maxval = 20, group = G_DS)
zcShowBox = input.bool(true, "タッチした場所を描く (直近だけ)", group = G_DS)
zcShowLbl = input.bool(false, "タッチ印 (方向と根拠数)", group = G_DS)
zcOnMode  = input.string("含める", "接触中だった根拠を含むイベント", options = ["含める", "除く", "のみ"], group = G_DS,
     tooltip = "タッチの前から接触中だった根拠を含むイベント (記録の状態フラグ 4096) を、表のすべての表示で 含める / 除く / それだけにする。\n" +
     "価格が場所を離れていなくても、時間で離脱したメンバーへ再び触れるとこの種のイベントが周期的に出るため、分けて見られるようにしてある。")
zcDrawMax = input.int(50, "描画を残す件数", minval = 1, maxval = 150, group = G_DS)

// ---- ZA: Accum 検出 (ZoneComboLabXAU.pine の写し。tests/zcr_sim.py が元ファイルと照合) ---------------------------------
// ==== LAB Accum copy (begin) =================================================
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not _isAccum[1]          // v6: bool は na にならない (最初の足の [1] は false = v5 の nz(…, false) と同じ)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== LAB Accum copy (end) ===================================================

f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

// ---- ZB: EMA (Lab と同じ取得)。5分足 k の判定には足 k-1 確定時点の値 ([1]) を使う --------------------------------------
float zbMa1 = request.security(syminfo.tickerid, "1", ta.ema(close, zbLen1), lookahead = barmerge.lookahead_off)
float zbMa2 = ta.ema(close, zbLen2)
float zbP1  = zbMa1[1]
float zbP5  = zbMa2[1]

// ---- ZC: Swing (ZoneComboLabXAU.pine の f_lbPivotConfirmed をそのまま) -------------------------------------------------
f_lbPivotConfirmed(simple int len) =>
    float _ph = ta.pivothigh(high, len, len)
    float _pl = ta.pivotlow(low,  len, len)
    int   _pt = na(_ph) ? int(na) : time
    int   _lt = na(_pl) ? int(na) : time
    [_ph[1], _pt[1], _pl[1], _lt[1]]

[s1h, s1ht, s1l, s1lt] = request.security(syminfo.tickerid, "60",  f_lbPivotConfirmed(zcPiv1), lookahead = barmerge.lookahead_on)
[s2h, s2ht, s2l, s2lt] = request.security(syminfo.tickerid, "240", f_lbPivotConfirmed(zcPiv2), lookahead = barmerge.lookahead_on)
[s3h, s3ht, s3l, s3lt] = request.security(syminfo.tickerid, "D",   f_lbPivotConfirmed(zcPiv3), lookahead = barmerge.lookahead_on)
[s4h, s4ht, s4l, s4lt] = request.security(syminfo.tickerid, "W",   f_lbPivotConfirmed(zcPiv4), lookahead = barmerge.lookahead_on)

// ---- ZD: POC (MtfPocFeedXAU.pine の f_pocCore / f_feed をそのまま。f_feed の off = 1 で確定済み上位足だけ) -----------------
//  Lab は外部インジ MtfPocFeedXAU から受け取るが、ここは同じ計算を内蔵する (接続不要)。受信後の検証は Lab の ZD と同じ処理を通す
// ==== FEED POC core (begin) ==================================================
f_pocCore(bool enabled, int off, int lookback, int bins) =>
    float poc = na
    float pUp = na
    float pLo = na
    if enabled and lookback > 0 and bins > 0 and bar_index - off >= lookback
        float hi = na
        float lo = na
        bool  ok = true
        for k = off to off + lookback - 1
            float h = high[k]
            float l = low[k]
            float v = volume[k]
            if na(h) or na(l) or na(v)
                ok := false
                break
            hi := na(hi) ? h : math.max(hi, h)
            lo := na(lo) ? l : math.min(lo, l)
        float rangeAll = ok ? hi - lo : na
        if ok and rangeAll > 0
            array<float> bv = array.new_float(bins, 0.0)
            float bs = rangeAll / bins
            float total = 0.0
            for k = off to off + lookback - 1
                float ch = high[k]
                float cl = low[k]
                float cv = volume[k]
                total += cv
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    int b0 = math.max(0, math.floor((cl - lo) / bs) - 1)
                    int b1 = math.min(bins - 1, math.floor((ch - lo) / bs) + 1)
                    for bi = b0 to b1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
            if total > 0
                float best  = -1.0
                int   bestI = 0
                for bi = 0 to bins - 1
                    float bvv = array.get(bv, bi)
                    if bvv > best
                        best  := bvv
                        bestI := bi
                pLo := lo + bestI * bs
                pUp := pLo + bs
                poc := (pUp + pLo) / 2.0
    [poc, pUp, pLo]
// ==== FEED POC core (end) ====================================================

// 上位足の中で評価: 1 本前 (確定済み) の上位足までで計算 → [区画下限, 区画上限, 対象足時刻]
f_feed(bool enabled, int lookback, int bins) =>
    [pc, up, lo] = f_pocCore(enabled, 1, lookback, bins)
    int   tk = time[1]
    float tOut = not enabled ? 0.0 : na(tk) ? na : na(pc) ? -float(tk) : float(tk)
    [enabled ? lo : na, enabled ? up : na, tOut]

[zdL1, zdU1, zdT1] = request.security(syminfo.tickerid, "60",  f_feed(zdUse1, zdLen1, vpBins), lookahead = barmerge.lookahead_on)
[zdL2, zdU2, zdT2] = request.security(syminfo.tickerid, "240", f_feed(zdUse2, zdLen2, vpBins), lookahead = barmerge.lookahead_on)
[zdL3, zdU3, zdT3] = request.security(syminfo.tickerid, "D",   f_feed(zdUse3, zdLen3, vpBins), lookahead = barmerge.lookahead_on)
[zdL4, zdU4, zdT4] = request.security(syminfo.tickerid, "W",   f_feed(zdUse4, zdLen4, vpBins), lookahead = barmerge.lookahead_on)
float zdProto = 10001      // 内蔵計算なので protocol は常に正しい値 (Lab の ZD 受信処理をそのまま使うための定数)

// ---- ZF: FVG (ZoneComboLabXAU.pine の f_fvgConfirmed をそのまま) -------------------------------------------------------
// ==== LAB FVG copy (begin) ===================================================
f_fvgConfirmed(float minWidth) =>
    bool  _bull = low > high[2]
    bool  _bear = high < low[2]
    float _top  = _bull ? low : _bear ? low[2] : na
    float _bot  = _bull ? high[2] : _bear ? high : na
    int   _dir  = (_bull or _bear) and math.round_to_mintick(_top - _bot) >= minWidth ? (_bull ? 1 : -1) : 0
    [time[1], time_close[1], close[1], _dir[1], _top[1], _bot[1]]
// ==== LAB FVG copy (end) =====================================================

[g1k, g1kc, g1c, g1d, g1t, g1b] = request.security(syminfo.tickerid, "60",  f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g2k, g2kc, g2c, g2d, g2t, g2b] = request.security(syminfo.tickerid, "240", f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g3k, g3kc, g3c, g3d, g3t, g3b] = request.security(syminfo.tickerid, "D",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g4k, g4kc, g4c, g4d, g4t, g4b] = request.security(syminfo.tickerid, "W",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)

// ---- ZG: ダブル / トリプル トップ・ボトム (ZoneComboLabXAU.pine の検知器の写し。確定した足の結果だけ: 1 本ずらし・lookahead_on) ----
// ==== ZG LTB copy (begin) ===================================================
//  LongTermDoubleTripleTopBottomXAU.pine (LTB-15, 9e92c02) の検知処理 (LtB1 / LtH / ltNew1 / ltCand1 / ltStep1 / ltRevWhy) の写し。
//  【変更】EPS → ZG_EPS (この位置で使うため)、基準ごとに 2 回目以後の接触群の実体極値 gx を保持し、検知イベント D の末尾 (16 番目) に
//  Zone の基準価格 (トップ = max(1 回目の山, gx) / ボトム = min(1 回目の谷, gx)) を加える。検知の判定・接触の数え方は変えない
float ZG_EPS = 1e-7
// 監視基準 1 個 (トップ = 実体上端の山 / ボトム = 実体下端の谷)
type LtB1
    int    id
    int    side               // -1 = トップ / 1 = ボトム
    float  lvl                // 基準価格 P (トップ = 実体上端 / ボトム = 実体下端)
    int    pvT                // 実際の Pivot 足の time / time_close は使わない
    int    cfT                // 登録 (右側 N 本目) の足の time / time_close (この時刻から利用可能)
    int    cfTc
    int    aBar               // 登録した足 (この足では接触・反転を見ない)
    int    pvBar              // 実際の Pivot 足の bar_index (最大監視本数の起算 = 0 本目 / 1 回目の接触開始足)
    int    cnt      = 1       // 接触回数 (基準 Pivot = 1 回目)。不採用の接触も数える
    bool   inC      = true    // 帯に接触中
    int    lastSt             // 直前の接触開始足の bar_index
    int    sepN     = 0       // 直前の接触が終わってから帯を離れていた足の本数
    float  sepX               // その足の実体の極値 (トップ = 実体下端の最小 / ボトム = 実体上端の最大)
    bool   elig     = false   // 現在の接触がシグナル対象 (開始時に固定)
    bool   waiting  = false   // 現在の接触で反転待ち中
    int    waitEnd            // 反転待ちの最後の足 (接触開始足 + 反転待ち)
    int    stBar              // 現在の接触の開始足 bar_index / time / time_close / 接触価格 (トップ = high / ボトム = low)
    int    stT
    int    stTc
    float  stP
    string why      = ""      // 現在の接触の不採用・未検知の理由 (1 文字ずつ: G 間隔不足 / S 離れ幅不足 / Z 実体端が帯外 /
                              //   C 反転方向の色ではない / B 実体幅不足 / R 実体比率不足 / E 接触終了 / W 反転待ち終了 / V 基準無効化 / T 監視期限終了)
    float  gx                 // 【ZG 追加】2 回目以後の接触群の実体極値 (トップ = 実体上端の最高 / ボトム = 実体下端の最安。接触開始から検知足まで)

type LtH
    int    piv
    float  wave               // 最初の波の最低値幅
    float  buf                // 接近許容幅 (基準帯 = P ± buf)
    float  dist               // 接触間の最低離れ幅
    int    gapN               // 接触開始足どうしの最低間隔
    float  bodyMin            // 反転足の最低実体幅
    float  ratio              // 反転足の最低実体比率 (0〜1)
    int    wait               // 反転待ち
    int    maxN               // 最大監視本数
    bool   dirOn              // 最初の山・谷の方向フィルター (新しい基準の登録候補だけ)
    bool   sepOn              // 最低離れ幅フィルター (OFF なら離れ幅を採用条件から外す)
    array<float> bu           // 直近 (2N + 1) 本の実体上端・実体下端・高値・安値・time
    array<float> bd
    array<float> hh
    array<float> ll
    array<int>   ts
    array<LtB1>  bases
    int    seq      = 0       // ID (確定した Pivot 候補ごとに消費)
    int    prevT
    int    sSide    = 0       // 参照系列 (山・谷が交互) の最後の要素: 種類 (-1 山 / 1 谷 / 0 なし)・価格
    float  sP
    int    aSide    = 0       // その直前の要素 (反対側)
    float  aP
    int    pSide    = 0       // 方向フィルターの比較対象 = 系列で最後の要素の直前の同種 (種類が切り替わる時に更新前の aSide / aP から保存。
    float  pP                 //   同種の極値更新中は維持する)

ltNew1(int piv, float wave, float buf, float dist, int gapN, float bodyMin, float ratio, int wait, int maxN, bool dirOn, bool sepOn) =>
    LtH.new(piv, wave, buf, dist, gapN, bodyMin, ratio, wait, maxN, dirOn, sepOn, array.new_float(), array.new_float(), array.new_float(),
         array.new_float(), array.new_int(), array.new<LtB1>())

ltAdd(string s, string ch) =>
    str.contains(s, ch) ? s : s + ch

ltAddAll(string s, string w) =>
    string out = s
    int n = str.length(w)
    if n > 0
        for i = 0 to n - 1
            out := ltAdd(out, str.substring(w, i, i + 1))
    out

ltEvB1(LtB1 g, string ty) =>
    ";" + ty + "," + str.tostring(g.id) + "," + str.tostring(g.side) + "," + str.tostring(g.lvl, "#.########") + "," +
         str.tostring(g.pvT) + "," + str.tostring(g.cfT) + "," + str.tostring(g.cfTc)

ltEvS1(LtB1 g, string ty) =>
    ltEvB1(g, ty) + "," + str.tostring(g.cnt) + "," + str.tostring(g.stT) + "," + str.tostring(g.stTc) + "," + str.tostring(g.stP, "#.########")

// 反転足の条件 (すべて満たせば ""、満たさない理由を返す)。トップ = 陰線・実体上端が帯内 / ボトム = 陽線・実体下端が帯内
ltRevWhy(LtH S, bool top, float P, float o, float h, float l, float c) =>
    string w = ""
    float edge = top ? math.max(o, c) : math.min(o, c)
    if edge < P - S.buf - ZG_EPS or edge > P + S.buf + ZG_EPS
        w += "Z"
    if top ? not (c < o) : not (c > o)
        w += "C"
    float body = math.abs(c - o)
    if body < S.bodyMin - ZG_EPS
        w += "B"
    float rng = h - l
    if rng <= 0 or body < rng * S.ratio - ZG_EPS
        w += "R"
    w

// 確定した Pivot 候補 1 個: 参照系列の更新 → 最初の波の値幅 → Pivot 確定までの接触履歴 → 登録
ltCand1(LtH S, int side, float P, int pvT, int t, int tc, int bi) =>
    string ev = ""
    int N = S.piv
    S.seq += 1
    // 参照系列: 同じ種類が続けば、山はより高い (同値は後の足)・谷はより低いものに更新。更新しない同種 Pivot は追加しない
    bool adopt = false
    if S.sSide == side
        if side == -1 ? P >= S.sP : P <= S.sP
            S.sP := P
            adopt := true
    else
        // 種類の切り替え: 更新前の aSide / aP (= 今回と同種の直前の要素) を方向フィルターの比較対象に保存
        S.pSide := S.aSide
        S.pP    := S.aP
        S.aSide := S.sSide
        S.aP    := S.sP
        S.sSide := side
        S.sP    := P
        adopt   := true
    // 最初の波: 直前の反対側 Pivot だけを見る (無ければ作らない。さらに古い Pivot へ探し直さない)
    if adopt and S.aSide == -side and S.maxN >= N
        bool waveOk = side == -1 ? P - S.aP >= S.wave - ZG_EPS : S.aP - P >= S.wave - ZG_EPS
        // 最初の山・谷の方向フィルター (ON のときだけ): トップ = P > 前の山 + ZG_EPS / ボトム = P < 前の谷 − ZG_EPS。前の同種が無ければ登録しない
        bool dirOk = not S.dirOn or (S.pSide == side and (side == -1 ? P > S.pP + ZG_EPS : P < S.pP - ZG_EPS))
        if waveOk and dirOk
            // Pivot 足 (1 回目の接触開始) から登録足までの右側 N 本の接触履歴。離れてから再び接触していれば採用しない
            bool  inC    = true
            bool  second = false
            int   sepN   = 0
            float sepX   = na
            for j = N + 1 to 2 * N
                bool ct = array.get(S.hh, j) >= P - S.buf - ZG_EPS and array.get(S.ll, j) <= P + S.buf + ZG_EPS
                if ct
                    if not inC
                        second := true
                    inC := true
                else
                    inC := false
                    sepN += 1
                    float x = side == -1 ? array.get(S.bd, j) : array.get(S.bu, j)
                    sepX := na(sepX) ? x : side == -1 ? math.min(sepX, x) : math.max(sepX, x)
            if not second
                LtB1 g = LtB1.new(S.seq, side, P, pvT, t, tc, bi, bi - N, inC = inC, lastSt = bi - N, sepN = sepN, sepX = sepX)
                array.push(S.bases, g)
                ev += ltEvB1(g, "R")
    ev

// 1時間足 1 本 (確定 OHLC) の処理。返り値の形は ltStep と同じ (ブロック + イベント)
//   C (接触開始: 回数・開始足・high / low・シグナル対象 0/1・理由) / D (検知) / Y (シグナル対象の接触が未検知で終了: 理由) /
//   V,id,待機中,理由 (終値無効化) / T,id,待機中,理由 (監視期限) / R (登録) / E (終了)
ltStep1(LtH S, float o, float h, float l, float c, int t, int tc, int bi) =>
    string ev = ""
    float bu = math.max(o, c)
    float bd = math.min(o, c)
    int N = S.piv
    int W = 2 * N + 1
    array.push(S.bu, bu)
    array.push(S.bd, bd)
    array.push(S.hh, h)
    array.push(S.ll, l)
    array.push(S.ts, t)
    if array.size(S.bu) > W
        array.shift(S.bu)
        array.shift(S.bd)
        array.shift(S.hh)
        array.shift(S.ll)
        array.shift(S.ts)
    // 実体 Pivot (左側は同値可・右側は厳密)。右側 N 本目のこの足で確定。
    //   LTB-8: 同じ足が山と谷の両方なら、その足は参照系列に採用せず基準も作らない (系列は変えない。ID は山・谷それぞれ消費する)
    if array.size(S.bu) == W
        float mh = array.get(S.bu, N)
        float ml = array.get(S.bd, N)
        bool isH = true
        bool isL = true
        for j = 0 to W - 1
            if j < N
                isH := isH and mh >= array.get(S.bu, j)
                isL := isL and ml <= array.get(S.bd, j)
            if j > N
                isH := isH and mh > array.get(S.bu, j)
                isL := isL and ml < array.get(S.bd, j)
        int pvT = array.get(S.ts, N)
        if isH and isL
            S.seq += 2
        else
            if isH
                ev += ltCand1(S, -1, mh, pvT, t, tc, bi)
            if isL
                ev += ltCand1(S, 1, ml, pvT, t, tc, bi)
    // 各基準 (新しい基準から): ⓪ 監視期限 → ① 終値無効化 → ② 接触・反転。登録した足は飛ばす
    int ng = array.size(S.bases)
    if ng > 0
        for i = ng - 1 to 0
            LtB1 g = array.get(S.bases, i)
            if g.aBar < bi
                bool  top = g.side == -1
                float P   = g.lvl
                bool  fin = false
                if bi - g.pvBar > S.maxN
                    fin := true
                    ev += ";T," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "T")
                else if top ? c > P + S.buf + ZG_EPS : c < P - S.buf - ZG_EPS
                    fin := true
                    ev += ";V," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "V")
                else
                    // 接触 = high ≥ P − buf かつ low ≤ P + buf (ヒゲを含む)。接触していない足 = 帯から離れた足
                    bool ct = h >= P - S.buf - ZG_EPS and l <= P + S.buf + ZG_EPS
                    if ct
                        if not g.inC
                            // 新しい接触の開始: 回数を数え、シグナル対象かを開始時に固定 (間隔・離れ幅。不採用でも回数は消費する)
                            g.cnt += 1
                            g.inC := true
                            string why = ""
                            bool gapOk = bi - g.lastSt >= S.gapN
                            bool sepOk = not S.sepOn or (g.sepN > 0 and (top ? P - g.sepX >= S.dist - ZG_EPS : g.sepX - P >= S.dist - ZG_EPS))
                            if not gapOk
                                why += "G"
                            if not sepOk
                                why += "S"
                            g.elig    := gapOk and sepOk and g.cnt <= 3
                            g.why     := why
                            g.lastSt  := bi
                            g.stBar   := bi
                            g.stT     := t
                            g.stTc    := tc
                            g.stP     := top ? h : l
                            g.sepN    := 0
                            g.sepX    := na
                            g.waiting := g.elig
                            g.waitEnd := bi + S.wait
                            ev += ltEvS1(g, "C") + "," + (g.elig ? "1" : "0") + "," + why
                            if not g.elig and g.cnt >= 3
                                fin := true
                        // 【ZG 追加】2 回目以後の接触群の実体極値 (検知の判定には使わない)
                        if g.cnt >= 2
                            g.gx := na(g.gx) ? (top ? bu : bd) : top ? math.max(g.gx, bu) : math.min(g.gx, bd)
                        // 反転待ち (接触開始足 = 0 本目〜反転待ちの本数目。接触が続いている足だけ)
                        if g.waiting
                            string fw = ltRevWhy(S, top, P, o, h, l, c)
                            if fw == ""
                                g.waiting := false
                                ev += ltEvS1(g, "D") + "," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(bi - g.stBar) + "," +
                                     str.tostring(bu, "#.########") + "," + str.tostring(bd, "#.########") + "," +
                                     str.tostring(top ? math.max(P, g.gx) : math.min(P, g.gx), "#.########")     // 【ZG 追加】Zone の基準価格
                                if g.cnt >= 3
                                    fin := true
                            else
                                g.why := ltAddAll(g.why, fw)
                                if bi >= g.waitEnd
                                    g.waiting := false
                                    g.why := ltAdd(g.why, "W")
                                    ev += ";Y," + str.tostring(g.id) + "," + g.why
                                    if g.cnt >= 3
                                        fin := true
                    else
                        // 帯から離れた足: 接触の終了 (待機中ならその接触の待機も終了) と、離れ幅の記録 (実体)
                        if g.inC
                            g.inC := false
                            if g.waiting
                                g.waiting := false
                                g.why := ltAdd(g.why, "E")
                                ev += ";Y," + str.tostring(g.id) + "," + g.why
                                if g.cnt >= 3
                                    fin := true
                        g.sepN += 1
                        float x = top ? bd : bu
                        g.sepX := na(g.sepX) ? x : top ? math.min(g.sepX, x) : math.max(g.sepX, x)
                if fin
                    array.remove(S.bases, i)
                    ev += ";E," + str.tostring(g.id)
    string hd = "B," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(S.prevT) + "," + str.tostring(array.size(S.bases)) +
         "," + str.tostring(bi)
    S.prevT := t
    hd + ev
// ==== ZG LTB copy (end) =====================================================

f_zgCore(int k, bool on) =>
    var LtH S = k == 0 ? ltNew1(zgPiv1, zgWave1, zgBuf1, zgDist1, zgGap1, zgBody1, zgRatio1 / 100.0, zgWait1, zgMax1, zgDir1, zgSep1) :
         k == 1 ? ltNew1(zgPiv4, zgWave4, zgBuf4, zgDist4, zgGap4, zgBody4, zgRatio4 / 100.0, zgWait4, zgMax4, zgDir4, zgSep4) :
         ltNew1(zgPivD, zgWaveD, zgBufD, zgDistD, zgGapD, zgBodyD, zgRatioD / 100.0, zgWaitD, zgMaxD, zgDirD, zgSepD)
    var string prevBlk = ""
    string blk = on ? ltStep1(S, open, high, low, close, time, time_close, bar_index) : ""
    string out = prevBlk == "" ? blk : prevBlk + ";" + blk
    prevBlk := blk
    out[1]
string zgPk1 = request.security(syminfo.tickerid, "60",  f_zgCore(0, zgUse1), lookahead = barmerge.lookahead_on)
string zgPk4 = request.security(syminfo.tickerid, "240", f_zgCore(1, zgUse4), lookahead = barmerge.lookahead_on)
string zgPkD = request.security(syminfo.tickerid, "D",   f_zgCore(2, zgUseD), lookahead = barmerge.lookahead_on)

// 標準 (通常ローソク足) の 5分チャートでだけ集計する
bool hlRun = timeframe.isminutes and timeframe.multiplier == 5 and chart.is_standard

// ==== ZCR Logic (begin) ======================================================
//  この区間は tests/zcr_sim.py が Python に機械変換して実行する (履歴参照 x[1] を使わない・na との算術 / 比較をしない)。
//  判定に使う価格はすべて syminfo.mintick 単位の整数 (ティック)。時刻は ms。
//  「LAB copy」と書いた関数・ブロックは ZoneComboLabXAU.pine (LAB-28) と byte 一致 (テストが照合)。そのため Zone の型名 LbZone、
//  状態 st、f_lbNew / f_lbAdd / f_lbRemoveS / f_lbRemove / f_ds* / lbDeadNow などの名前を Lab と同じにしてある (f_ds* と dsZone は
//  Lab の表示用の呼び出しを受けるだけの空の関数・定数)。

// Zone 1 個。先頭 12 項目と inv / dead / zgUse / zgShow は Lab の LbZone と同じ並び・意味
type LbZone
    int   id
    int   typ                 // 0 ZA / 1 ZB / 2 ZC / 3 ZD / 4 ZF / 5 ZE / 6 ZG (Lab と同じ番号)
    int   tf
    int   sub                 // ZA 1 上辺 / -1 下辺、ZC 1 高値 / -1 安値、ZF 1 上昇 FVG / -1 下降 FVG、ZE 波の方向、ZG 1 トップ / -1 ボトム、他 0
    float ctr
    float bot
    float top
    float infoA               // ZE: 比率 / ZG: 回数 (2 ダブル / 3 トリプル) / ZD: 区画下限 / ZA: 下辺
    float infoB               // ZG: 検知足の bar_index / ZE: 更新確定時刻 / ZD: 区画上限 / ZA: 上辺
    int   key
    int   aBar                // 登録した 5分足 (次の足から接触)
    int   aTime
    bool  inv      = false    // ZF: iFVG
    bool  dead     = false
    bool  zgUse    = true
    bool  zgShow   = true
    int   gid      = 0        // 根拠 ID 0..21
    int   lv       = 0        // ZE: 水準の番号 0..3 (0.236 / 0.382 / 0.5 / 0.618)
    int   tb       = na       // 帯の下端 (ティック)
    int   tt       = na       // 帯の上端 (ティック)
    bool  isOn     = false    // 接触中
    int   outT     = na       // 帯の完全に外側が続いている最初の足の time (na = 外側でない / 不明)

// 形成中の Accum (Lab の LbAcc と同じ)
type LbAcc
    int   tf
    int   aid
    float up
    float lo

// イベント 1 件 = 観測 1 件 (30 分の観察期間が終わるまで追跡)
type ZcObs
    int id
    int t0             // 基準時刻 = タッチ足の time_close
    int p0             // 基準価格 = タッチ足の終値 (ティック)
    int d              // 1 上から (反発方向 = 上 / LONG) / -1 下から (SHORT)
    int mask           // 根拠集合 (根拠 ID g のビット 2^g の和)
    int nEv            // 根拠数
    int nRaw           // 集合に入った Zone の本数
    int og             // 接触端側のメンバー (上からなら上端が最も低い Zone、下からなら下端が最も高い Zone) の根拠 ID
    int rTop           // 場所の共通区間 C の上端 (ティック)
    int rBot
    int edge           // 接触端 = 始値で方向が決まった場合は C の接近側の端、直前終値で決まった場合 (始値が既に C の中) は始値
    int cPos           // タッチ足の終値の位置 0 C の手前 / 1 C の中 / 2 C の向こう側へ抜けた
    int ord            // 同じ足の中の場所の順番 (1, 2, …)
    int aux            // 補助マスク
    int flags          // 512 / 1024 タッチ時に ZB-1m / ZB-5m が不明、2048 ZE が受信不正、4096 接触中だった根拠を含む、8192 方向を直前終値で決めた
    int onMask         // タッチの前から接触中だったメンバーの根拠マスク
    int side           // 辺マスク (ZA 上辺 / 下辺、ZC 高値線 / 安値線、ZG トップ / ボトム)
    array<int> rMin    // 反発幅ごとの初回到達分 (na = 未到達)
    array<int> aLo     // 到達前の最大逆行幅 下限 (ティック)
    array<int> aHi     // 同 上限
    array<int> wSt     // 観察期間ごと 0 評価待ち / 1 計測可能 / 2 計測不能 (期間内の足が 0 本・不正足)
    array<int> wMfe    // 観察期間ごとの最大順行幅 (ティック)
    array<int> wMae
    array<int> wNb     // 観察期間ごとの、期間内にあった足の本数
    int nPl = 1        // 同じ足の場所数 (方向あり)
    int nb  = 0        // ここまでに観察した足の本数
    int mfe = 0
    int mae = 0

// 集計 1 行 (根拠集合ごと / 根拠数別)
type ZcRow
    int mask
    int cnt
    array<int> c       // (方向 [LONG 0 / SHORT 1] * 3 + 期間) * ZC_NS + 項目
    array<int> hist    // ((方向 * 3 + 期間) * 3 + 反発幅) * 30 + (初回到達分 - 1)
    array<int> ev      // 0 LONG イベント / 1 SHORT イベント / 2 方向不明
    array<int> c2      // c / hist / ev と同じ並びで、「タッチの前から接触中だった根拠を含むイベント」だけの集計
    array<int> hist2
    array<int> ev2

type ZcRec
    array<float> v

type ZcSt
    int   zSeq     = 0
    int   nAccOut  = 0       // 採用箱数から外れた Accum の辺
    int   nIfvg    = 0       // FVG → iFVG
    int   nFvgDead = 0       // iFVG の再突破で無効
    int   maxW     = 0       // 索引に入れた帯の幅の最大 (ティック)
    int   oSeq     = 0
    bool  pcOk     = false   // 直前の有効な 5分足の終値がある
    int   pC       = na
    int   nBad     = 0       // 不正足
    int   nEv      = 0       // イベント (方向あり)
    int   nEv2     = 0       // そのうち同じ足の 2 番目以降の場所
    int   nUnk     = 0       // 方向不明の接触
    int   nCont    = 0       // 継続中として抑制した接触 (足 × 場所)
    int   nDone    = 0       // 確定したイベント
    int   nOut     = 0       // plot へ出力済み
    int   nEvOn    = 0       // そのうち、タッチの前から接触中だった根拠を含むイベント
    int   nMultiBar = 0      // 方向のある場所が 2 つ以上あった足 (集計対象の足)
    int   nPre     = 0       // 集計開始前・助走中のタッチ (継続中でない場所の数。イベントにしない)
    int   nMa1Ev   = 0       // タッチ時に ZB-1m が不明だったイベント
    int   ma1N     = 0       // 1分 EMA の有効値を受け取った有効足の本数 (ZB-1m の助走)
    int   nMa5Ev   = 0       // タッチ時に ZB-5m が不明だったイベント
    int   nZeEv    = 0       // タッチ時に ZE が受信不正だったイベント
    int   rowOver  = 0
    int   firstT   = na
    int   lastT    = na
    int   nBars    = 0

int   ZC_NG     = 22
int   ZC_NS     = 21         // 0 計測可能 / 1 計測不能 / 2-4 到達 / 5-7 到達分の合計 / 8 MFE 合計 / 9 MAE 合計 /
                             // 10-12 到達前逆行 下限の合計 / 13-15 上限の合計 / 16-18 順序不明 / 19 評価待ち / 20 計測可能のうち本数不足
int   ZC_NF     = 37         // イベント記録の項目数
int   ZC_MAXROW = 300        // 根拠集合の行数上限
int   ZC_M1     = 60000
float EPS       = 1e-7
bool  dsZone    = false

var ZcSt st = ZcSt.new()
var array<int>    zxBot   = array.new_int(0)            // 価格順の索引 (帯の下端ティック。同値は登録順)
var array<LbZone> zxZ     = array.new<LbZone>()         // 同じ順の Zone (ZB 以外の有効なもの)
var array<LbZone> zcMa    = array.new<LbZone>()         // ZB の 2 Zone (1分 EMA / 5分 EMA。帯は足ごとに置き直す)
var array<bool>   zcMaOk  = array.new_bool(2, false)    // この足で ZB の帯が有効
var array<LbZone> zcOn    = array.new<LbZone>()         // 接触中の Zone
var array<int>    zcInhB  = array.new_int(12, na)       // この足で外した接触中の ZD (0..3) / ZE (4 + 時間足 * 4 + 水準) の帯の下端・上端
var array<int>    zcInhT  = array.new_int(12, na)       //   (na = なし)。後継の帯がこれと重なるときだけ接触中を引き継ぐ
var array<LbZone> zcSwZ   = array.new<LbZone>()         // 水平線 (保持本数を使うときだけ。登録順)
var array<LbZone> lbAccZ  = array.new<LbZone>()         // 採用中の Accum の上辺・下辺 (登録順)
var array<LbAcc>  lbAccs  = array.new<LbAcc>()          // 形成中の Accum
var array<int>    lbAccLast  = array.new_int(3, na)
var array<int>    lbPivLastH = array.new_int(4, na)
var array<int>    lbPivLastL = array.new_int(4, na)
var array<float>  lbPocLast  = array.new_float(4, na)
var array<LbZone> lbPocCur   = array.new<LbZone>(4, na)
var array<int>    lbZdStat   = array.new_int(4, 0)      // 0 OFF / 1 正常 / 2 計算不能 / 3 履歴不足 / 8 OFF (時刻 0) / 9 異常
var array<LbZone> lbFvgs     = array.new<LbZone>()      // ZF (FVG / iFVG)
var array<int>    lbFvgLast  = array.new_int(4, na)
var array<int>    lbZeStat   = array.new_int(2, 0)      // 0 OFF / 1 有効な波 / 2 波なし / 3 保留中 / 8 外部側 OFF / 9 未接続・誤接続
var array<float>  lbZeLast   = array.new_float(10, na)
var array<LbZone> lbZeZ      = array.new<LbZone>()
var array<LbZone> lbZgZ      = array.new<LbZone>()
var array<int>    lbZgUsed   = array.new_int()
var array<int>    lbZgLast   = array.new_int(3, na)
var array<int>    lbDeadNow  = array.new_int()
var array<ZcObs>  zcPend  = array.new<ZcObs>()          // 追跡中の観測
var array<ZcRec>  zcQ     = array.new<ZcRec>()          // 確定して未出力のイベント記録 (FIFO)
var array<int>    zrMask  = array.new_int(0)            // 根拠集合の行 (出現順)
var array<ZcRow>  zrRow   = array.new<ZcRow>()
var array<ZcRow>  zrSum   = array.new<ZcRow>()          // 0 単体 / 1 2 根拠 / 2 3 根拠以上 / 3 全体 / 4 上限超過
var array<int>    zcNZone = array.new_int(22, 0)        // 根拠 ID ごとの登録本数 (ZB は 0)
var array<int>    zcMaUnk = array.new_int(2, 0)         // MA が不明だった有効足 (系列ごと)
var array<int>    zcZeBad = array.new_int(2, 0)         // ZE が未接続・誤接続 (状態 9) だった確定足 (時間足ごと)
var array<int>    zcZdBad = array.new_int(4, 0)         // ZD が正常でなかった確定足 (時間足ごと)
var array<int>    zcWhy   = array.new_int(3, 0)         // 計測不能にした観察期間: 0 期間内の足が 0 本 / 1 不正足
var array<LbZone> zcT     = array.new<LbZone>()         // 作業用: この足でタッチした Zone
var array<int>    zcPL    = array.new_int(0)            // 作業用: この足の場所の共通区間 C の下端・上端 (価格の低い順)
var array<int>    zcPH    = array.new_int(0)
var array<int>    zcUL    = array.new_int(0)            // 作業用: 場所のメンバーの帯そのものの共通区間 U (切り詰めない) の下端・上端
var array<int>    zcUH    = array.new_int(0)

// この足の出力 (毎足作り直す)
array<float> zcOut   = array.new_float(ZC_NF, na)       // この足で出力するイベント記録 (なければ全部 na)
array<int>   zcEvT   = array.new_int(0)                 // この足で発生したイベント (描画用): T0 / R 上端 / R 下端 / 方向 / 根拠数
array<int>   zcEvTop = array.new_int(0)
array<int>   zcEvBot = array.new_int(0)
array<int>   zcEvD   = array.new_int(0)
array<int>   zcEvN   = array.new_int(0)

array<int> zcPow = array.from(1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152)
array<int> zcWin = array.from(5, 15, 30)
array<int> zcNrm = array.from(1, 3, 6)                  // 観察期間の通常の本数

// 閾値 (ティック。値幅が指定幅以上になる最初のティック)
f_zcTicks(float usd) =>
    math.max(1, math.ceil(usd / syminfo.mintick - 1e-9))
array<int> zcWT    = array.from(f_zcTicks(5.0), f_zcTicks(10.0), f_zcTicks(15.0))
int        zcDepT  = f_zcTicks(zcDepW)
int        zcDepMs = zcDepMin * ZC_M1

f_zaUse(int k) =>
    k == 0 ? zaUse1 : k == 1 ? zaUse2 : zaUse3

f_zaKeep(int k) =>
    k == 0 ? zaKeep1 : k == 1 ? zaKeep2 : zaKeep3

f_zbUse(int k) =>
    k == 0 ? zbUse1 : zbUse2

f_zcUse(int k) =>
    k == 0 ? zcUse1 : k == 1 ? zcUse2 : k == 2 ? zcUse3 : zcUse4

f_zdUse(int k) =>
    k == 0 ? zdUse1 : k == 1 ? zdUse2 : k == 2 ? zdUse3 : zdUse4

// ==== LAB copy use (begin) — ZoneComboLabXAU.pine と同一 ====
f_zfUse(int k) =>
    k == 0 ? zfUse1 : k == 1 ? zfUse2 : k == 2 ? zfUse3 : zfUse4

f_zgUse(int k) =>
    k == 0 ? zgUse1 : k == 1 ? zgUse4 : zgUseD

f_zgExpOn(int k) =>
    k == 0 ? zgExp1 : k == 1 ? zgExp4 : zgExpD

f_zgExpN(int k) =>
    k == 0 ? zgExpN1 : k == 1 ? zgExpN4 : zgExpND

f_zeUse(int k) =>
    zeUse and (k == 0 ? zeUse4 : zeUseD)

// ==== LAB copy use (end) ====

// この集計に「表示だけ」の ZG は無い (Lab の f_zgShow の位置)
f_zgShow(int k) =>
    false

// ==== LAB copy zgParse (begin) — ZoneComboLabXAU.pine と同一 ====
f_zgParse(string pk, int lastT, int tcNow) =>
    array<float> out = array.new_float()
    int lt = lastT
    if not na(pk) and pk != ""
        array<string> evs = str.split(pk, ";")
        bool take = false
        float cbi = na
        for i = 0 to array.size(evs) - 1
            string e = array.get(evs, i)
            if e != ""
                array<string> f = str.split(e, ",")
                string ty = array.get(f, 0)
                if ty == "B"
                    int sT = int(str.tonumber(array.get(f, 1)))
                    int sC = int(str.tonumber(array.get(f, 2)))
                    take := not na(sT) and (na(lt) or sT > lt) and not na(sC) and sC <= tcNow
                    if take
                        lt  := sT
                        cbi := str.tonumber(array.get(f, 5))
                        array.push(out, 0)
                        array.push(out, cbi)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                else if take and ty == "D" and array.size(f) > 16
                    array.push(out, 1)
                    array.push(out, cbi)
                    array.push(out, str.tonumber(array.get(f, 1)))
                    array.push(out, str.tonumber(array.get(f, 2)))
                    array.push(out, str.tonumber(array.get(f, 7)))
                    array.push(out, str.tonumber(array.get(f, 16)))
    [lt, out]

// ==== LAB copy zgParse (end) ====

f_inc(array<int> a, int ix, int v) =>
    array.set(a, ix, array.get(a, ix) + v)
    true

f_has(int m, int bit) =>
    math.floor(m / bit) % 2 == 1

// 価格順の索引: 下端が v 以上の最初の位置 / v より大きい最初の位置
f_zcLower(int v) =>
    int lo = 0
    int hi = array.size(zxBot)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(zxBot, mid) < v
            lo := mid + 1
        else
            hi := mid
    lo

f_zcUpper(int v) =>
    int lo = 0
    int hi = array.size(zxBot)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(zxBot, mid) <= v
            lo := mid + 1
        else
            hi := mid
    lo

// Lab の表示用の呼び出しを受けるだけ (何もしない)
f_dsDel(LbZone z, bool b) =>
    true

f_dsRename(LbZone z) =>
    true

f_dsAdd(LbZone z) =>
    true

f_zcSetOn(LbZone z) =>
    if not z.isOn
        z.isOn := true
        array.push(zcOn, z)
    z.outT := na
    true

// 引き継ぎ枠の番号 (ZD = 時間足、ZE = 4 + 時間足 * 4 + 水準。他は -1)
f_zcSlot(LbZone z) =>
    z.typ == 3 ? z.tf : z.typ == 5 ? 4 + z.tf * 4 + z.lv : -1

// Zone を集計の対象に入れる (Lab の f_lbAdd の位置)。根拠 ID・帯のティック (下端・上端を別々に丸める)・索引。
//  同じ足で外した ZD / ZE (同じ時間足・同じ水準) が接触中で、その帯とこの Zone の帯が重なるなら、後継のこの Zone も接触中から始める
//  (同じ場所の置き換えで再接触を水増ししない。離れた価格へ移った後継は引き継がない)
f_lbAdd(LbZone z) =>
    z.gid := z.typ == 0 ? z.tf : z.typ == 2 ? 5 + z.tf : z.typ == 3 ? 9 + z.tf : z.typ == 5 ? 13 + z.tf : z.typ == 4 ? 15 + z.tf : 19 + z.tf
    if z.typ == 5
        z.lv := z.infoA == 0.236 ? 0 : z.infoA == 0.382 ? 1 : z.infoA == 0.5 ? 2 : 3
    z.tb := math.round(z.bot / syminfo.mintick)
    z.tt := math.round(z.top / syminfo.mintick)
    st.maxW := math.max(st.maxW, z.tt - z.tb)
    int pos = f_zcUpper(z.tb)
    array.insert(zxBot, pos, z.tb)
    array.insert(zxZ, pos, z)
    f_inc(zcNZone, z.gid, 1)
    if z.typ == 4
        array.push(lbFvgs, z)
    int sl = f_zcSlot(z)
    if sl >= 0
        if not na(array.get(zcInhB, sl))
            if z.tt >= array.get(zcInhB, sl) and z.tb <= array.get(zcInhT, sl)
                f_zcSetOn(z)
    true

// Zone を外す (Lab の f_lbRemoveS の位置)。索引と接触中の一覧から除く
f_lbRemoveS(LbZone z) =>
    int pos = f_zcLower(z.tb)
    bool fnd = false
    while not fnd and pos < array.size(zxZ)
        LbZone q = array.get(zxZ, pos)
        if q.id == z.id
            fnd := true
        else
            pos += 1
    if fnd
        array.remove(zxBot, pos)
        array.remove(zxZ, pos)
    if z.isOn
        int sl = f_zcSlot(z)
        if sl >= 0
            array.set(zcInhB, sl, z.tb)
            array.set(zcInhT, sl, z.tt)
        int oi = 0
        bool fo = false
        while not fo and oi < array.size(zcOn)
            LbZone q = array.get(zcOn, oi)
            if q.id == z.id
                fo := true
            else
                oi += 1
        if fo
            array.remove(zcOn, oi)
        z.isOn := false
    z.outT := na
    true

// FVG を外す (Lab の f_lbRemove の位置)
f_lbRemove(LbZone z) =>
    int fi = 0
    bool ff = false
    while not ff and fi < array.size(lbFvgs)
        LbZone q = array.get(lbFvgs, fi)
        if q.id == z.id
            ff := true
        else
            fi += 1
    if ff
        array.remove(lbFvgs, fi)
    f_lbRemoveS(z)

// ==== LAB copy funcs (begin) — ZoneComboLabXAU.pine と同一 ====
f_lbNew(int typ, int tf, int sub, float ctr, float bot, float top, float a, float b, int key) =>
    st.zSeq += 1
    LbZone z = LbZone.new(st.zSeq, typ, tf, sub, ctr, bot, top, a, b, key, bar_index, time)
    z

f_zgKill(int i) =>
    LbZone z = array.remove(lbZgZ, i)
    if z.zgUse
        f_lbRemoveS(z)
        array.push(lbDeadNow, z.id)
    if dsZone and z.zgShow
        f_dsDel(z, false)
    z.dead := true
    true

f_zeClear(int k) =>
    int n = array.size(lbZeZ)
    if n > 0
        for i = n - 1 to 0
            LbZone z = array.get(lbZeZ, i)
            if z.tf == k
                array.remove(lbZeZ, i)
                f_lbRemoveS(z)
                if dsZone
                    f_dsDel(z, false)
                z.dead := true
                array.push(lbDeadNow, z.id)
    true

f_zeSet(int k, float o, float e, float d, float id, float t) =>
    array<float> rs = array.from(0.236, 0.382, 0.5, 0.618)
    for j = 0 to 3
        float r = array.get(rs, j)
        float p = e + r * (o - e)
        LbZone z = f_lbNew(5, k, int(d), p, p - zHalf, p + zHalf, r, t, int(id))
        f_lbAdd(z)
        array.push(lbZeZ, z)
    int b = k * 5
    array.set(lbZeLast, b, o)
    array.set(lbZeLast, b + 1, e)
    array.set(lbZeLast, b + 2, d)
    array.set(lbZeLast, b + 3, id)
    array.set(lbZeLast, b + 4, 1)
    true

f_zeSame(int k, float o, float e, float d, float id) =>
    int b = k * 5
    array.get(lbZeLast, b + 4) == 1 and array.get(lbZeLast, b) == o and array.get(lbZeLast, b + 1) == e and array.get(lbZeLast, b + 2) == d
         and array.get(lbZeLast, b + 3) == id

f_lbAccFix(LbAcc q) =>
    LbZone zu = f_lbNew(0, q.tf, 1, q.up, q.up - zHalf, q.up + zHalf, q.lo, q.up, q.aid)
    LbZone zl = f_lbNew(0, q.tf, -1, q.lo, q.lo - zHalf, q.lo + zHalf, q.lo, q.up, q.aid)
    f_lbAdd(zu)
    f_lbAdd(zl)
    array.push(lbAccZ, zu)
    array.push(lbAccZ, zl)
    int nk = 0
    for i = 0 to array.size(lbAccZ) - 1
        LbZone qz = array.get(lbAccZ, i)
        if qz.tf == q.tf
            nk += 1
    while nk > 2 * f_zaKeep(q.tf)
        int oi = 0
        bool fnd = false
        while not fnd
            LbZone qz = array.get(lbAccZ, oi)
            if qz.tf == q.tf
                fnd := true
            else
                oi += 1
        LbZone zo = array.remove(lbAccZ, oi)
        f_lbRemoveS(zo)
        if dsZone
            f_dsDel(zo, false)
        zo.dead := true
        array.push(lbDeadNow, zo.id)
        st.nAccOut += 1
        nk -= 1
    true

// ==== LAB copy funcs (end) ====

// 水平線を 1 本登録する (Lab の f_swAdd の位置。Lab の統合はしない。線ごとに個別の帯 = 価格 ± 共通幅)。
//  保持本数 > 0 のときだけ、その時間足の古い線を外す
f_swAdd(int k, int sub, float pv, int pt) =>
    LbZone z = f_lbNew(2, k, sub, pv, pv - zHalf, pv + zHalf, na, na, pt)
    f_lbAdd(z)
    if zcMax > 0
        array.push(zcSwZ, z)
        int nk = 0
        for i = 0 to array.size(zcSwZ) - 1
            LbZone qz = array.get(zcSwZ, i)
            if qz.tf == k
                nk += 1
        while nk > zcMax
            int oi = 0
            bool fnd = false
            while not fnd
                LbZone qz = array.get(zcSwZ, oi)
                if qz.tf == k
                    fnd := true
                else
                    oi += 1
            LbZone zo = array.remove(zcSwZ, oi)
            f_lbRemoveS(zo)
            zo.dead := true
            nk -= 1
    true

f_zcRowNew(int mask, int cnt) =>
    ZcRow.new(mask, cnt, array.new_int(6 * ZC_NS, 0), array.new_int(540, 0), array.new_int(3, 0), array.new_int(6 * ZC_NS, 0), array.new_int(540, 0), array.new_int(3, 0))

// 根拠集合の行 (なければ作る。行数上限を超えたら「上限超過」行)
f_zcRow(int mask, int cnt) =>
    int ix = array.indexof(zrMask, mask)
    ZcRow r = na
    if ix >= 0
        r := array.get(zrRow, ix)
    else if array.size(zrMask) >= ZC_MAXROW
        r := array.get(zrSum, 4)
    else
        r := f_zcRowNew(mask, cnt)
        array.push(zrMask, mask)
        array.push(zrRow, r)
    r

// 観察期間 h の結果を 1 行へ集計 (ok = 計測可能 / false = 計測不能)
f_zcAgg(array<int> rc, array<int> rh, ZcObs ob, int h, bool ok) =>
    int dh   = (ob.d == 1 ? 0 : 1) * 3 + h
    int base = dh * ZC_NS
    f_inc(rc, base + 19, -1)
    if not ok
        f_inc(rc, base + 1, 1)
    else
        f_inc(rc, base, 1)
        if ob.nb < array.get(zcNrm, h)
            f_inc(rc, base + 20, 1)
        f_inc(rc, base + 8, ob.mfe)
        f_inc(rc, base + 9, ob.mae)
        for j = 0 to 2
            int rm = array.get(ob.rMin, j)
            if not na(rm)
                int al = array.get(ob.aLo, j)
                int ah = array.get(ob.aHi, j)
                f_inc(rc, base + 2 + j, 1)
                f_inc(rc, base + 5 + j, rm)
                f_inc(rc, base + 10 + j, al)
                f_inc(rc, base + 13 + j, ah)
                if al != ah
                    f_inc(rc, base + 16 + j, 1)
                f_inc(rh, (dh * 3 + j) * 30 + rm - 1, 1)
    true

// 行への集計は 2 系統: 全イベント (c / hist) と、接触中だった根拠を含むイベントだけ (c2 / hist2)
f_zcAggRow(ZcRow r, ZcObs ob, int h, bool ok) =>
    f_zcAgg(r.c, r.hist, ob, h, ok)
    if ob.onMask > 0
        f_zcAgg(r.c2, r.hist2, ob, h, ok)
    true

// イベントの発生を行へ入れる (イベント数と、3 つの観察期間の評価待ち)
f_zcRowNewEv(ZcRow r, int di, bool hadOn) =>
    f_inc(r.ev, di, 1)
    if hadOn
        f_inc(r.ev2, di, 1)
    for hh = 0 to 2
        f_inc(r.c, (di * 3 + hh) * ZC_NS + 19, 1)
        if hadOn
            f_inc(r.c2, (di * 3 + hh) * ZC_NS + 19, 1)
    true

// 観察期間 h を確定 (計測可能 / 計測不能)。集合の行・根拠数別の行・全体の行へ入れる
f_zcWinDone(ZcObs ob, int h, bool ok) =>
    array.set(ob.wSt, h, ok ? 1 : 2)
    array.set(ob.wNb, h, ob.nb)
    if ok
        array.set(ob.wMfe, h, ob.mfe)
        array.set(ob.wMae, h, ob.mae)
    f_zcAggRow(f_zcRow(ob.mask, ob.nEv), ob, h, ok)
    f_zcAggRow(array.get(zrSum, math.min(ob.nEv, 3) - 1), ob, h, ok)
    f_zcAggRow(array.get(zrSum, 3), ob, h, ok)
    true

// イベントを確定して記録を出力待ちへ入れる (記録の並びは仕様書の表)
f_zcFinal(ZcObs ob) =>
    array<float> v = array.new_float(ZC_NF, na)
    array.set(v, 0, ob.id)
    array.set(v, 1, ob.t0 / 1000.0)
    array.set(v, 2, ob.p0 * syminfo.mintick)
    array.set(v, 3, ob.d)
    array.set(v, 4, ob.mask)
    array.set(v, 5, ob.nEv)
    array.set(v, 6, ob.nRaw)
    array.set(v, 7, ob.og)
    array.set(v, 8, ob.rTop * syminfo.mintick)
    array.set(v, 9, ob.rBot * syminfo.mintick)
    array.set(v, 10, ob.edge * syminfo.mintick)
    array.set(v, 11, ob.d * (ob.p0 - ob.edge) * syminfo.mintick)
    array.set(v, 12, ob.cPos)
    array.set(v, 13, ob.ord)
    array.set(v, 14, ob.nPl)
    array.set(v, 15, ob.aux)
    int fl = ob.flags
    for j = 0 to 2
        int rm = array.get(ob.rMin, j)
        if na(rm)
            array.set(v, 16 + j, array.get(ob.wSt, 2) == 1 ? 0 : -1)
        else
            array.set(v, 16 + j, rm)
            array.set(v, 19 + j * 2, array.get(ob.aLo, j) * syminfo.mintick)
            array.set(v, 20 + j * 2, array.get(ob.aHi, j) * syminfo.mintick)
            if array.get(ob.aLo, j) != array.get(ob.aHi, j)
                fl += array.get(zcPow, 6 + j)
    for hh = 0 to 2
        array.set(v, 31 + hh, array.get(ob.wNb, hh))
        if array.get(ob.wSt, hh) == 1
            array.set(v, 25 + hh * 2, array.get(ob.wMfe, hh) * syminfo.mintick)
            array.set(v, 26 + hh * 2, array.get(ob.wMae, hh) * syminfo.mintick)
            fl += array.get(zcPow, hh)
            if array.get(ob.wNb, hh) < array.get(zcNrm, hh)
                fl += array.get(zcPow, 3 + hh)
    array.set(v, 34, fl)
    array.set(v, 35, ob.onMask)
    array.set(v, 36, ob.side)
    array.push(zcQ, ZcRec.new(v))
    st.nDone += 1
    true

// 追跡中の観測を確定 5分足で更新 (bad = 不正足。o / h / l = ティック、tc = time_close)。戻り値 true = 確定 (追跡終了)
//  観察期間 N 分に入るのは time_close <= T0 + N 分の足。
//  (A) この足が期間の外 (time_close > T0 + N 分) なら、その期間をここまでの足で確定する (足が 0 本なら計測不能)。
//  (B) 残った期間があればこの足を観察に入れる。到達 = 順行側の極値が P0 から反発幅以上 (各幅は独立。到達後も 30 分まで追跡)。
//      到達前の最大逆行: 始値が既に届いていれば前の足までの最大 (単一値)。そうでなければ 下限 = max(前の足までの最大, 始値の逆行幅)、
//      上限 = max(下限, この足の逆行側の極値) (足の中の順序は分からないので範囲)。
//      不正足が期間の中に来たら、その期間は計測不能にする (未到達扱いにしない)。
//  (C) この足でちょうど期間が終わる (time_close = T0 + N 分) なら確定する。
f_zcUpd(ZcObs ob, bool bad, int o, int h, int l, int tc) =>
    int left = 0
    for hh = 0 to 2
        if array.get(ob.wSt, hh) == 0
            if tc > ob.t0 + array.get(zcWin, hh) * ZC_M1
                if ob.nb == 0
                    f_inc(zcWhy, 0, 1)
                f_zcWinDone(ob, hh, ob.nb > 0)
            else
                left += 1
    if left > 0
        if bad
            for hh = 0 to 2
                if array.get(ob.wSt, hh) == 0
                    f_inc(zcWhy, 1, 1)
                    f_zcWinDone(ob, hh, false)
            left := 0
        else
            ob.nb += 1
            int rm   = math.max(1, math.min(30, math.round((tc - ob.t0) / 60000.0)))
            int fav  = ob.d == 1 ? h - ob.p0 : ob.p0 - l
            int adv  = ob.d == 1 ? ob.p0 - l : h - ob.p0
            int oFav = ob.d == 1 ? o - ob.p0 : ob.p0 - o
            for j = 0 to 2
                if na(array.get(ob.rMin, j))
                    int w = array.get(zcWT, j)
                    if fav >= w
                        int lo = oFav >= w ? ob.mae : math.max(ob.mae, -oFav)
                        int hi = oFav >= w ? ob.mae : math.max(lo, adv)
                        array.set(ob.rMin, j, rm)
                        array.set(ob.aLo, j, lo)
                        array.set(ob.aHi, j, hi)
            ob.mfe := math.max(ob.mfe, fav)
            ob.mae := math.max(ob.mae, adv)
            left := 0
            for hh = 0 to 2
                if array.get(ob.wSt, hh) == 0
                    if tc >= ob.t0 + array.get(zcWin, hh) * ZC_M1
                        f_zcWinDone(ob, hh, true)
                    else
                        left += 1
    bool done = left == 0
    if done
        f_zcFinal(ob)
    done

// ZB の帯をこの足用に置き直す (v = 直前の足が確定した時点の EMA。na = 不明)
f_zcMaSet(int k, bool use, float v) =>
    LbZone mz = array.get(zcMa, k)
    if use and not na(v)
        mz.ctr := v
        mz.bot := v - zHalf
        mz.top := v + zHalf
        mz.tb  := math.round(mz.bot / syminfo.mintick)
        mz.tt  := math.round(mz.top / syminfo.mintick)
        array.set(zcMaOk, k, true)
    else
        array.set(zcMaOk, k, false)
        if use
            f_inc(zcMaUnk, k, 1)
    true

// 補助マスクのビット番号 (-1 = なし): ZE 水準 0-7 (4H 0.236 / 0.382 / 0.5 / 0.618、D 同)、iFVG 8-11 (1H 4H D W)、FVG 12-15。
//  ZG トリプルは別に 16-18 (f_zcPlace で足す)
f_zcAux(LbZone z) =>
    z.typ == 5 ? z.tf * 4 + z.lv : z.typ == 4 ? (z.inv ? 8 : 12) + z.tf : -1

// 辺マスクのビット番号 (-1 = なし): ZA 上辺 0-2 (1H 4H D) / 下辺 3-5、ZC 高値線 6-9 (1H 4H D W) / 安値線 10-13、ZG トップ 14-16 (1H 4H D) / ボトム 17-19
f_zcSide(LbZone z) =>
    z.typ == 0 ? (z.sub == 1 ? 0 : 3) + z.tf : z.typ == 2 ? (z.sub == 1 ? 6 : 10) + z.tf : z.typ == 6 ? (z.sub == 1 ? 14 : 17) + z.tf : -1

// 場所の接近方向。C = [pLo, pHi] (足の高安で切り詰めた共通区間)、U = [uLo, uHi] (メンバーの帯そのものの共通区間)。
//  始値が C の上 = 上から (1) / 下 = 下から (-1)。始値が C の中のときは直前の有効な足の終値を U と比べる:
//  U の上 = 上から / U の下 = 下から / U の中・不明 = 方向不明 (0)。足の高安で切り詰めた C とは比べない
//  (帯の中に居続けた価格の小さなギャップを「上から / 下から」にしないため)。
f_zcDir(int pLo, int pHi, int uLo, int uHi, int o) =>
    o > pHi ? 1 : o < pLo ? -1 : not st.pcOk ? 0 : st.pC > uHi ? 1 : st.pC < uLo ? -1 : 0

// 場所 1 つ (共通区間 C = [pLo, pHi]、接近方向 dp)。メンバー = この足でタッチした Zone のうち帯が pLo を含むもの (全員が C 全体を含む)。
//  メンバー全員が (この足の前から) 接触中なら継続中 (イベントにしない)。そうでなければ、集計開始前・助走中は件数だけ、
//  dp = 0 は方向不明として別計上、それ以外はイベント (接触中だったメンバーの根拠は onMask に残す)。
f_zcPlace(int pLo, int pHi, int dp, int o, int c, int ord, bool live) =>
    bool allOn  = true
    int  nRaw   = 0
    int  mask   = 0
    int  nG     = 0
    int  aux    = 0
    int  onMask = 0
    int  side   = 0
    LbZone ze0  = na
    for q = 0 to array.size(zcT) - 1
        LbZone z = array.get(zcT, q)
        if z.tb <= pLo and z.tt >= pLo
            allOn := allOn and z.isOn
            nRaw += 1
            int gb = array.get(zcPow, z.gid)
            if not f_has(mask, gb)
                mask += gb
                nG += 1
            if z.isOn
                if not f_has(onMask, gb)
                    onMask += gb
            int xi = f_zcAux(z)
            if xi >= 0
                if not f_has(aux, array.get(zcPow, xi))
                    aux += array.get(zcPow, xi)
            if z.typ == 6 and z.infoA == 3
                if not f_has(aux, array.get(zcPow, 16 + z.tf))
                    aux += array.get(zcPow, 16 + z.tf)
            int si = f_zcSide(z)
            if si >= 0
                if not f_has(side, array.get(zcPow, si))
                    side += array.get(zcPow, si)
            if na(ze0)
                ze0 := z
            else if dp == -1 ? (z.tb > ze0.tb or (z.tb == ze0.tb and z.id < ze0.id)) : (z.tt < ze0.tt or (z.tt == ze0.tt and z.id < ze0.id))
                ze0 := z
    ZcRow rs = array.get(zrSum, math.min(nG, 3) - 1)
    ZcRow ra = array.get(zrSum, 3)
    if allOn
        st.nCont += 1
    else if not live
        st.nPre += 1
    else if dp == 0
        st.nUnk += 1
        f_inc(rs.ev, 2, 1)
        f_inc(ra.ev, 2, 1)
    else
        ZcRow row = f_zcRow(mask, nG)
        st.oSeq += 1
        st.nEv += 1
        if ord > 1
            st.nEv2 += 1
        bool u1 = zbUse1 and not array.get(zcMaOk, 0)
        bool u5 = zbUse2 and not array.get(zcMaOk, 1)
        bool ue = array.get(lbZeStat, 0) == 9 or array.get(lbZeStat, 1) == 9
        if u1
            st.nMa1Ev += 1
        if u5
            st.nMa5Ev += 1
        if ue
            st.nZeEv += 1
        if onMask > 0
            st.nEvOn += 1
        if array.indexof(zrMask, mask) < 0
            st.rowOver += 1
        // 接触端: 始値で方向が決まった (始値が C の外) なら C の接近側の端。直前終値で決まった (始値が既に C の中) なら始値
        bool byPc = o <= pHi and o >= pLo
        int  edge = byPc ? o : dp == 1 ? pHi : pLo
        int cPos = dp == 1 ? (c > pHi ? 0 : c >= pLo ? 1 : 2) : (c < pLo ? 0 : c <= pHi ? 1 : 2)
        ZcObs ob = ZcObs.new(st.oSeq, time_close, c, dp, mask, nG, nRaw, ze0.gid, pHi, pLo, edge, cPos, ord, aux,
             (u1 ? 512 : 0) + (u5 ? 1024 : 0) + (ue ? 2048 : 0) + (onMask > 0 ? 4096 : 0) + (byPc ? 8192 : 0), onMask, side,
             array.new_int(3, na), array.new_int(3, na), array.new_int(3, na), array.new_int(3, 0), array.new_int(3, na), array.new_int(3, na), array.new_int(3, 0))
        array.push(zcPend, ob)
        int di = dp == 1 ? 0 : 1
        f_zcRowNewEv(row, di, onMask > 0)
        f_zcRowNewEv(rs, di, onMask > 0)
        f_zcRowNewEv(ra, di, onMask > 0)
        array.push(zcEvT, time_close)
        array.push(zcEvTop, pHi)
        array.push(zcEvBot, pLo)
        array.push(zcEvD, dp)
        array.push(zcEvN, nG)
    true

// 確定 5分足 (ティック) のタッチ判定。live = false (集計開始前・助走中) はイベントを作らない (接触中の状態は通常どおり更新)。
//  (1) タッチした Zone = 有効な Zone で帯が [l, h] と重なるもの。帯を [l, h] に切り詰めた区間で考える。
//  (2) 場所 = 共通の価格点を持つ Zone の極大集合 (区間グラフの極大クリーク)。切り詰めた区間の下端 p を低い順に見て、
//      S(p) = p を含む Zone の集合、その上端の最小 mh とすると、次に高い下端 p2 が無い、または mh < p2 のとき S(p) は極大
//      (mh >= p2 なら S(p) は S(p2) に含まれる)。共通区間 C = [p, mh]。接する (端点一致) は重なり。C は価格の低い順に並ぶ。
//  (3) 場所の接近方向は始値と C、始値が C の中なら直前終値と U (メンバーの帯そのものの共通区間) で決める (f_zcDir)。順番: 上からの場所を C の上端が高い順 → 下からの場所を C の下端が低い順 →
//      方向不明の場所を C の上端が高い順。ord は方向のある場所だけに付ける。
//  (4) 接触中の印はこの足の全部の場所を判定した後に付ける (判定はこの足の前の状態で行う)。
f_zcTouch(int o, int h, int l, int c, bool live) =>
    array.clear(zcT)
    array.clear(zcPL)
    array.clear(zcPH)
    array.clear(zcUL)
    array.clear(zcUH)
    int n = array.size(zxBot)
    int i = f_zcLower(l - st.maxW)
    while i < n and array.get(zxBot, i) <= h
        LbZone z = array.get(zxZ, i)
        if z.tt >= l
            array.push(zcT, z)
        i += 1
    for k = 0 to 1
        if array.get(zcMaOk, k)
            LbZone mz = array.get(zcMa, k)
            if mz.tt >= l and mz.tb <= h
                array.push(zcT, mz)
    int nT    = array.size(zcT)
    int nPl   = 0
    int pend0 = array.size(zcPend)
    if nT > 0
        int  cur  = l - 1
        bool more = true
        while more
            bool fnd = false
            int  p   = 0
            for q = 0 to nT - 1
                LbZone z = array.get(zcT, q)
                int lo = math.max(z.tb, l)
                if lo > cur and (not fnd or lo < p)
                    p   := lo
                    fnd := true
            if not fnd
                more := false
            else
                bool fn2 = false
                int  p2  = 0
                int  mh  = h
                bool fu  = false
                int  uL  = 0
                int  uH  = 0
                for q = 0 to nT - 1
                    LbZone z = array.get(zcT, q)
                    int lo = math.max(z.tb, l)
                    if lo > p and (not fn2 or lo < p2)
                        p2  := lo
                        fn2 := true
                    if z.tb <= p and z.tt >= p
                        mh := math.min(mh, z.tt)
                        uL := fu ? math.max(uL, z.tb) : z.tb
                        uH := fu ? math.min(uH, z.tt) : z.tt
                        fu := true
                if not fn2 or mh < p2
                    array.push(zcPL, p)
                    array.push(zcPH, mh)
                    array.push(zcUL, uL)
                    array.push(zcUH, uH)
                cur := p
        int nP = array.size(zcPL)
        for ps = 0 to 2
            int dp = ps == 0 ? 1 : ps == 1 ? -1 : 0
            for k = 0 to nP - 1
                int q   = dp == -1 ? k : nP - 1 - k
                int pLo = array.get(zcPL, q)
                int pHi = array.get(zcPH, q)
                if f_zcDir(pLo, pHi, array.get(zcUL, q), array.get(zcUH, q), o) == dp
                    if dp != 0
                        nPl += 1
                    f_zcPlace(pLo, pHi, dp, o, c, nPl, live)
        for q = 0 to nT - 1
            f_zcSetOn(array.get(zcT, q))
    int pend1 = array.size(zcPend)
    if pend1 > pend0
        for q = pend0 to pend1 - 1
            ZcObs ob = array.get(zcPend, q)
            ob.nPl := nPl
    if live and nPl >= 2
        st.nMultiBar += 1
    true

// 離脱 (接触中の解除。Zone ごとに自分の帯で判定): 確定 5分足が帯の完全に外側で、(i) 帯の端からの距離が離脱幅以上、
// または (ii) 外側が続いている最初の足の time からこの足の time_close までが離脱時間以上。帯に掛かった足・帯が不明な足で (ii) は数え直し。
f_zcDep(int h, int l) =>
    int i = 0
    while i < array.size(zcOn)
        LbZone z = array.get(zcOn, i)
        bool off = false
        if z.typ == 1 and not array.get(zcMaOk, z.tf)
            z.outT := na
        else if z.tt >= l and z.tb <= h
            z.outT := na
        else
            int dist = l > z.tt ? l - z.tt : z.tb - h
            if na(z.outT)
                z.outT := time
            if dist >= zcDepT or time_close - z.outT >= zcDepMs
                off := true
        if off
            z.isOn := false
            z.outT := na
            array.remove(zcOn, i)
        else
            i += 1
    true

if hlRun and barstate.isconfirmed
    if array.size(zrSum) == 0
        array.push(zrSum, f_zcRowNew(0, 1))
        array.push(zrSum, f_zcRowNew(0, 2))
        array.push(zrSum, f_zcRowNew(0, 3))
        array.push(zrSum, f_zcRowNew(0, 0))
        array.push(zrSum, f_zcRowNew(0, 0))
        for k = 0 to 1
            LbZone mz = f_lbNew(1, k, 0, na, na, na, na, na, na)
            mz.gid := 3 + k
            array.push(zcMa, mz)

    // 不正足 = OHLC のいずれかが na、高値 < max(始値, 終値)、安値 > min(始値, 終値) (HLR と同じ定義)
    bool bad = na(open) or na(high) or na(low) or na(close) or high < math.max(open, close) or low > math.min(open, close)
    int oT = bad ? int(na) : math.round(open  / syminfo.mintick)
    int hT = bad ? int(na) : math.round(high  / syminfo.mintick)
    int lT = bad ? int(na) : math.round(low   / syminfo.mintick)
    int cT = bad ? int(na) : math.round(close / syminfo.mintick)

    // ---- (1) 追跡中の観測を更新 (この足はどの観測にとってもタッチ足より後の足) ------------------------------------------
    int oi0 = 0
    while oi0 < array.size(zcPend)
        if f_zcUpd(array.get(zcPend, oi0), bad, oT, hT, lT, time_close)
            array.remove(zcPend, oi0)
        else
            oi0 += 1

    if bad
        // 不正足: 新規タッチなし・Zone の登録 / 更新 / 失効もしない (次の有効な足で受け取る)。直前終値と外側の継続時間は不明に戻す
        st.nBad += 1
        int nOn = array.size(zcOn)
        if nOn > 0
            for i = 0 to nOn - 1
                LbZone z = array.get(zcOn, i)
                z.outT := na
        st.pcOk := false
    else
        // ---- (2) タッチ → 離脱。Zone は足 k-1 の処理が終わった時点のもの。ZB の帯は足 k-1 確定時点の EMA。
        //      集計開始日時より前・先頭の助走本数の間はイベントを作らない (Zone と接触中の状態は通常どおり更新) ------------
        // ZB-1m の助走: 1分 EMA の有効値を受け取り始めてから「ZB-1m の助走本数」本の間は未収束として不明にする
        float v1 = na
        if not na(zbP1)
            st.ma1N += 1
            if st.ma1N > zbWarm1
                v1 := zbP1
        f_zcMaSet(0, zbUse1, v1)
        f_zcMaSet(1, zbUse2, zbP5)
        f_zcTouch(oT, hT, lT, cT, time_close >= zcStart and st.nBars >= zcWarm)
        f_zcDep(hT, lT)
        st.pcOk := true
        st.pC   := cT

    if not bad
        // ---- (3) この足の確定情報で Zone を登録 / 更新 / 失効 (次の 5分足から接触に使う) --------------------------------
        array.clear(lbDeadNow)
        for k = 0 to 11
            array.set(zcInhB, k, na)
            array.set(zcInhT, k, na)
        // ==== LAB register (begin) — ZoneComboLabXAU.pine (B1) と同一 ====
        // ZA: 新しい ID = 前回届いた ID と違う (未固定が残っていれば固定)。同じ ID は形成中に上下限を更新し、形成中フラグ 0 で固定
        array<float> fU = array.from(f1u, f2u, f3u)
        array<float> fL = array.from(f1l, f2l, f3l)
        array<int>   fI = array.from(f1i, f2i, f3i)
        array<int>   fA = array.from(f1a, f2a, f3a)
        for k = 0 to 2
            int   aid = array.get(fI, k)
            float u   = array.get(fU, k)
            float l   = array.get(fL, k)
            if f_zaUse(k) and not na(aid) and not na(u) and not na(l)
                bool forming = array.get(fA, k) == 1
                int  last    = array.get(lbAccLast, k)
                if na(last) or aid != last
                    array.set(lbAccLast, k, aid)
                    int na0 = array.size(lbAccs)
                    if na0 > 0
                        for i = na0 - 1 to 0
                            LbAcc q = array.get(lbAccs, i)
                            if q.tf == k
                                f_lbAccFix(q)
                                array.remove(lbAccs, i)
                    LbAcc b = LbAcc.new(k, aid, u, l)
                    if forming
                        array.push(lbAccs, b)
                    else
                        f_lbAccFix(b)
                else
                    int na1 = array.size(lbAccs)
                    if na1 > 0
                        for i = na1 - 1 to 0
                            LbAcc q = array.get(lbAccs, i)
                            if q.tf == k and q.aid == aid
                                q.up := u
                                q.lo := l
                                if not forming
                                    f_lbAccFix(q)
                                    array.remove(lbAccs, i)
        // ZC: 新しい Pivot (時刻キーが前回と違う) はすべて登録。統合距離以内で連鎖する既存の水平線 Zone があればまとめる (f_swAdd)
        array<float> pH  = array.from(s1h, s2h, s3h, s4h)
        array<int>   pHt = array.from(s1ht, s2ht, s3ht, s4ht)
        array<float> pL  = array.from(s1l, s2l, s3l, s4l)
        array<int>   pLt = array.from(s1lt, s2lt, s3lt, s4lt)
        for k = 0 to 3
            if f_zcUse(k)
                for s = 0 to 1
                    float pv = s == 0 ? array.get(pH, k) : array.get(pL, k)
                    int   pt = s == 0 ? array.get(pHt, k) : array.get(pLt, k)
                    int   lt = s == 0 ? array.get(lbPivLastH, k) : array.get(lbPivLastL, k)
                    if not na(pt) and not na(pv) and (na(lt) or pt != lt)
                        if s == 0
                            array.set(lbPivLastH, k, pt)
                        else
                            array.set(lbPivLastL, k, pt)
                        int sub = s == 0 ? 1 : -1
                        f_swAdd(k, sub, pv, pt)
        // ZD: 外部 POC (MtfPocFeedXAU) の受信。この 5分足に届いている確定済み上位足の出力を読み、正常な値で中心が前回の有効値から
        //  変わったら、同じ時間足の旧 POC を無効化して新 POC を登録する (時間足ごとに最新の確定 POC 1 つだけが有効。旧 POC は Zone の一覧・
        //  表示・TP 候補から外し、旧 POC を含む待機は (B3) で解除。時刻の更新だけでは何もしない。前と同じ価格に戻った場合も新 POC として採用)。
        //  状態: 0 検知 OFF / 1 正常 / 2 計算不能 (時刻 < 0) / 3 履歴不足 (時刻 na) / 8 外部側 OFF (時刻 0) / 9 未接続・誤接続
        //  (protocol ≠ 10001、時刻が時刻として不自然、正常なのに上下限が na / 上限 <= 下限)。8 / 9 は新規発注を止める (close で代用しない)
        bool zdProtoOK = not na(zdProto) and zdProto == 10001
        bool zdBad = false
        array<float> dL = array.from(zdL1, zdL2, zdL3, zdL4)
        array<float> dU = array.from(zdU1, zdU2, zdU3, zdU4)
        array<float> dT = array.from(zdT1, zdT2, zdT3, zdT4)
        for k = 0 to 3
            int stt = 0
            if f_zdUse(k)
                float tt = array.get(dT, k)
                float lo = array.get(dL, k)
                float up = array.get(dU, k)
                if not zdProtoOK
                    stt := 9
                else if na(tt)
                    stt := 3
                else if tt == 0
                    stt := 8
                else if math.abs(tt) < 1e11 or math.abs(tt) >= time or tt != math.round(tt)
                    stt := 9
                else if tt < 0
                    stt := 2
                else if na(lo) or na(up)
                    stt := 9
                else if up <= lo
                    stt := 9
                else
                    stt := 1
                    float pc = (lo + up) / 2.0
                    float lp = array.get(lbPocLast, k)
                    if na(lp) or pc != lp
                        array.set(lbPocLast, k, pc)
                        LbZone oz = array.get(lbPocCur, k)
                        if not na(oz)
                            f_lbRemoveS(oz)
                            if dsZone
                                f_dsDel(oz, false)
                            oz.dead := true
                            array.push(lbDeadNow, oz.id)
                        LbZone nzp = f_lbNew(3, k, 0, pc, pc - zHalf, pc + zHalf, lo, up, int(tt))
                        f_lbAdd(nzp)
                        array.set(lbPocCur, k, nzp)
            array.set(lbZdStat, k, stt)
            if stt == 8 or stt == 9
                zdBad := true
        // ZE: 外部 LongFibWave (13 系列) の受信。4時間足・日足それぞれ最新の 1 波だけ (0.236 / 0.382 / 0.5 / 0.618 の 4 Zone)。
        //  状態: 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続 (protocol ≠ 20001、状態・波 ID・
        //  更新確定時刻が不自然、有効なのに起点・終点・方向が不正、無効なのに起点・終点・方向がある)。9 だけ新規発注を止める (close で代用しない)。
        //  8 (外部側の計算 OFF) は 2 / 3 と同じ正常な無効状態 (その時間足の Zone と待機を外すだけ)。
        //  有効な波の起点・終点・方向・波 ID のどれかが変わったら旧 4 Zone を外して (待機も解除) 新しい 4 Zone を登録 (同じなら何もしない)。
        //  波なし・保留中・外部 OFF ではその時間足の Zone を外す。誤接続では Zone を保つ。ZE 検知 OFF では何もしない
        bool zeProtoOK = not na(zeProto) and zeProto == 20001
        bool zeBad = false
        array<float> eO = array.from(ze4O, zeDO)
        array<float> eE = array.from(ze4E, zeDE)
        array<float> eD = array.from(ze4D, zeDD)
        array<float> eI = array.from(ze4I, zeDI)
        array<float> eS = array.from(ze4S, zeDS)
        array<float> eT = array.from(ze4T, zeDT)
        for k = 0 to 1
            int stt = 0
            if f_zeUse(k)
                float fo = array.get(eO, k)
                float fe = array.get(eE, k)
                float fd = array.get(eD, k)
                float fi = array.get(eI, k)
                float fs = array.get(eS, k)
                float ft = array.get(eT, k)
                if not zeProtoOK
                    stt := 9
                else if na(fs) or na(fi) or na(ft) or na(fd)
                    stt := 9
                else if fs != math.round(fs) or fs < 0 or fs > 3 or fi != math.round(fi) or fi < 0
                    stt := 9
                else if math.abs(ft) < 1e11 or ft > time_close or ft != math.round(ft)
                    stt := 9
                else if fs == 3
                    stt := na(fo) or na(fe) ? 9 : fo == fe or not (fd == 1 or fd == -1) ? 9 : 1
                else
                    stt := not na(fo) or not na(fe) or fd != 0 ? 9 : fs == 0 ? 8 : fs == 1 ? 2 : 3
                if stt == 1
                    if not f_zeSame(k, fo, fe, fd, fi)
                        f_zeClear(k)
                        f_zeSet(k, fo, fe, fd, fi, ft)
                else if stt == 2 or stt == 3 or stt == 8
                    f_zeClear(k)
                    array.set(lbZeLast, k * 5 + 4, stt)
            array.set(lbZeStat, k, stt)
            if stt == 9
                zeBad := true
        // ZF: 新しい上位足 (キー = 形成足の時刻): 既存 FVG / iFVG を確定終値で判定 → 新しい FVG を登録
        array<int>   gK = array.from(g1k, g2k, g3k, g4k)
        array<float> gC = array.from(g1c, g2c, g3c, g4c)
        array<int>   gD = array.from(g1d, g2d, g3d, g4d)
        array<float> gT = array.from(g1t, g2t, g3t, g4t)
        array<float> gB = array.from(g1b, g2b, g3b, g4b)
        for k = 0 to 3
            int key = array.get(gK, k)
            int lk  = array.get(lbFvgLast, k)
            if f_zfUse(k) and not na(key) and (na(lk) or key != lk)
                array.set(lbFvgLast, k, key)
                float hc = array.get(gC, k)
                int nf = array.size(lbFvgs)
                if nf > 0 and not na(hc)
                    for i = nf - 1 to 0
                        LbZone z = array.get(lbFvgs, i)
                        if z.tf == k and z.key < key
                            if not z.inv
                                if (z.sub == 1 and hc < z.bot) or (z.sub == -1 and hc > z.top)
                                    z.inv := true
                                    st.nIfvg += 1
                                    if dsZone
                                        f_dsRename(z)
                            else if (z.sub == 1 and hc > z.top) or (z.sub == -1 and hc < z.bot)
                                z.dead := true
                                st.nFvgDead += 1
                                f_lbRemove(z)
                                array.push(lbDeadNow, z.id)
                                if dsZone
                                    f_dsDel(z, true)
                int   gd = array.get(gD, k)
                float gt = array.get(gT, k)
                float gb = array.get(gB, k)
                if not na(gd) and gd != 0 and not na(gt) and not na(gb)
                    f_lbAdd(f_lbNew(4, k, gd, (gt + gb) / 2.0, gb, gt, na, na, key))
        // ZG: ダブル / トリプル トップ・ボトム (1H / 4H / D の検知器の検知イベント = 反転足の確定で発動。接触・Pivot の登録だけでは作らない)。
        //  根拠 = 時間足 + 基準 ID で 1 回だけ (ダブルで発動した基準のトリプル・消えた基準の後の検知では作らない)。基準価格・幅・期限は発動時に固定。
        //  期限: 検知足 = 0 本目、その時間足の確定足の bar_index − 検知足 ≥ 本数で消す。逆行: 検知結果を受け取った確定 5分足 (発動した足) から実体端で判定
        //  (処理順: ZG の登録・期限 → 逆行による消滅 → (B2) 接触・(B3) 待機・(B6) 候補。発動した足で消えた Zone は接触・SL / TP 候補に残らない)
        array<string> zgPk = array.from(zgPk1, zgPk4, zgPkD)
        for k = 0 to 2
            [zlt, zrec] = f_zgParse(array.get(zgPk, k), array.get(lbZgLast, k), time_close)
            array.set(lbZgLast, k, zlt)
            int nr = int(array.size(zrec) / 6)
            if nr > 0
                for r = 0 to nr - 1
                    int ro  = r * 6
                    int rbi = int(array.get(zrec, ro + 1))
                    if array.get(zrec, ro) == 0
                        int nzg = array.size(lbZgZ)
                        if f_zgExpOn(k) and nzg > 0
                            for i = nzg - 1 to 0
                                LbZone z = array.get(lbZgZ, i)
                                if z.tf == k and rbi - int(z.infoB) >= f_zgExpN(k)
                                    f_zgKill(i)
                    else
                        int   zid  = int(array.get(zrec, ro + 2))
                        int   zsd  = int(array.get(zrec, ro + 3))
                        float zcnt = array.get(zrec, ro + 4)
                        float zp   = array.get(zrec, ro + 5)
                        int   ukey = zid * 3 + k
                        if not array.includes(lbZgUsed, ukey) and not na(zp)
                            array.push(lbZgUsed, ukey)
                            if f_zgUse(k) or f_zgShow(k)
                                // sub: 1 トップ (抵抗) / -1 ボトム (支持)。infoA = 回数 (2 ダブル / 3 トリプル)、infoB = 検知足の bar_index、key = 基準 ID
                                LbZone zz = f_lbNew(6, k, zsd == -1 ? 1 : -1, zp, zp - zgHalf, zp + zgHalf, zcnt, rbi, zid)
                                zz.zgUse  := f_zgUse(k)
                                zz.zgShow := f_zgShow(k)
                                if zz.zgUse
                                    f_lbAdd(zz)
                                else if dsZone and zz.zgShow
                                    f_dsAdd(zz)
                                array.push(lbZgZ, zz)
        int nzg2 = array.size(lbZgZ)
        if nzg2 > 0
            for i = nzg2 - 1 to 0
                LbZone z = array.get(lbZgZ, i)
                if z.sub == 1 ? math.max(open, close) > z.ctr + zgRev + EPS : math.min(open, close) < z.ctr - zgRev - EPS
                    f_zgKill(i)
        // ==== LAB register (end) ====
        for k = 0 to 1
            if array.get(lbZeStat, k) == 9
                f_inc(zcZeBad, k, 1)
        for k = 0 to 3
            if f_zdUse(k) and array.get(lbZdStat, k) != 1
                f_inc(zcZdBad, k, 1)

    // ---- (4) 確定したイベント記録を 1 足 1 件ずつ出力 (FIFO) ----------------------------------------------------------
    if array.size(zcQ) > 0
        ZcRec rc = array.shift(zcQ)
        for x = 0 to ZC_NF - 1
            array.set(zcOut, x, array.get(rc.v, x))
        st.nOut += 1

    if na(st.firstT)
        st.firstT := time
    st.lastT := time_close
    st.nBars += 1
// ==== ZCR Logic (end) ========================================================

// ---- 描画 (集計値には影響しない) --------------------------------------------------------------------------------
var array<box>   zcBoxes = array.new<box>()
var array<label> zcLbls  = array.new<label>()
if array.size(zcEvT) > 0
    for i = 0 to array.size(zcEvT) - 1
        int   et = array.get(zcEvT, i)
        int   ed = array.get(zcEvD, i)
        float tp = array.get(zcEvTop, i) * syminfo.mintick
        float bt = array.get(zcEvBot, i) * syminfo.mintick
        if zcShowBox
            array.push(zcBoxes, box.new(et - 5 * ZC_M1, tp, et + 30 * ZC_M1, bt, xloc = xloc.bar_time,
                 border_color = color.new(ed == 1 ? color.teal : color.maroon, 40), bgcolor = color.new(ed == 1 ? color.teal : color.maroon, 85)))
            if array.size(zcBoxes) > zcDrawMax
                box.delete(array.shift(zcBoxes))
        if zcShowLbl
            array.push(zcLbls, label.new(et - 5 * ZC_M1, ed == 1 ? bt : tp, (ed == 1 ? "L " : "S ") + str.tostring(array.get(zcEvN, i)), xloc = xloc.bar_time,
                 style = ed == 1 ? label.style_label_up : label.style_label_down, color = color.new(ed == 1 ? color.teal : color.maroon, 20),
                 textcolor = color.white, size = size.tiny, tooltip = "タッチ足確定後の反応を計測 (P0 = この足の終値)"))
            if array.size(zcLbls) > zcDrawMax
                label.delete(array.shift(zcLbls))

// ---- 表 (集計値には影響しない。右上の 1 表を「表の行」「表示切替」「方向」「表示する観察期間」で切り替える) ---------------------
array<string> ZC_GN = array.from("ZA-1H", "ZA-4H", "ZA-D", "ZB-1m", "ZB-5m", "ZC-1H", "ZC-4H", "ZC-D", "ZC-W", "ZD-1H", "ZD-4H", "ZD-D", "ZD-W",
     "ZE-4H", "ZE-D", "ZF-1H", "ZF-4H", "ZF-D", "ZF-W", "ZG-1H", "ZG-4H", "ZG-D")

f_setName(int mask) =>
    string s = ""
    for g = 0 to 21
        if f_has(mask, array.get(zcPow, g))
            s += (s == "" ? "" : "+") + array.get(ZC_GN, g)
    s == "" ? "(なし)" : s

f_gUse(int g) =>
    g < 3 ? f_zaUse(g) : g < 5 ? f_zbUse(g - 3) : g < 9 ? f_zcUse(g - 5) : g < 13 ? f_zdUse(g - 9) : g < 15 ? f_zeUse(g - 13) : g < 19 ? f_zfUse(g - 15) : f_zgUse(g - 19)

// 「接触中だった根拠を含むイベント」の選択 (含める = 全イベント / のみ = 2 系統目 / 除く = 全イベント − 2 系統目)
f_pick(array<int> a, array<int> a2, int ix) =>
    zcOnMode == "のみ" ? array.get(a2, ix) : zcOnMode == "除く" ? array.get(a, ix) - array.get(a2, ix) : array.get(a, ix)

// 行 r の集計項目 s を方向の選択 dm で合算
f_v(ZcRow r, string dm, int h, int s) =>
    int v = 0
    if dm != "SHORTのみ"
        v += f_pick(r.c, r.c2, h * ZC_NS + s)
    if dm != "LONGのみ"
        v += f_pick(r.c, r.c2, (3 + h) * ZC_NS + s)
    v

f_hv(ZcRow r, string dm, int h, int j, int m) =>
    int v = 0
    if dm != "SHORTのみ"
        v += f_pick(r.hist, r.hist2, (h * 3 + j) * 30 + m - 1)
    if dm != "LONGのみ"
        v += f_pick(r.hist, r.hist2, ((3 + h) * 3 + j) * 30 + m - 1)
    v

// 行 r のイベント数 (di 0 LONG / 1 SHORT。選択を適用)
f_ev(ZcRow r, int di) =>
    f_pick(r.ev, r.ev2, di)

// 初回到達分の中央値 (到達した件数が偶数なら中央 2 件の平均)
f_med(ZcRow r, string dm, int h, int j) =>
    int   tot = f_v(r, dm, h, 2 + j)
    float res = na
    if tot > 0
        int k1  = math.floor((tot - 1) / 2)
        int k2  = math.floor(tot / 2)
        int acc = 0
        int v1  = 0
        int v2  = 0
        for m = 1 to 30
            acc += f_hv(r, dm, h, j, m)
            if v1 == 0 and acc > k1
                v1 := m
            if v2 == 0 and acc > k2
                v2 := m
        res := (v1 + v2) / 2.0
    res

f_rowMerge(ZcRow dst, ZcRow src) =>
    for i = 0 to array.size(src.c) - 1
        array.set(dst.c, i, array.get(dst.c, i) + array.get(src.c, i))
    for i = 0 to array.size(src.hist) - 1
        array.set(dst.hist, i, array.get(dst.hist, i) + array.get(src.hist, i))
    for i = 0 to array.size(src.ev) - 1
        array.set(dst.ev, i, array.get(dst.ev, i) + array.get(src.ev, i))
        array.set(dst.ev2, i, array.get(dst.ev2, i) + array.get(src.ev2, i))
    for i = 0 to array.size(src.c2) - 1
        array.set(dst.c2, i, array.get(dst.c2, i) + array.get(src.c2, i))
    for i = 0 to array.size(src.hist2) - 1
        array.set(dst.hist2, i, array.get(dst.hist2, i) + array.get(src.hist2, i))
    true

f_pct(int a, int n) =>
    n == 0 ? "—" : str.tostring(100.0 * a / n, "0.0") + "%"

f_avgUsd(int sumTicks, int n) =>
    n == 0 ? "—" : "$" + str.tostring(sumTicks * syminfo.mintick / n, "0.00")

f_tm(int t) =>
    na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", "Asia/Tokyo")

color ZC_HEAD = color.new(color.gray, 20)
color ZC_BG   = color.new(color.black, 15)
color ZC_BG2  = color.new(color.navy, 30)
color ZC_TX   = color.white

f_cell(table t, int c, int r, string s, color bg) =>
    table.cell(t, c, r, s, text_color = ZC_TX, bgcolor = bg, text_size = size.small)

f_note(table t, int r, int ncol, string s) =>
    f_cell(t, 0, r, s, ZC_HEAD)
    if ncol > 1
        table.merge_cells(t, 0, r, ncol - 1, r)
    table.cell_set_text_halign(t, 0, r, text.align_left)

// 表の 1 行 (行 r・方向 dm・期間 h) の 3 〜 9 列目
f_line(table t, int row, ZcRow r, string dm, int h, color bg) =>
    int n = f_v(r, dm, h, 0)
    f_cell(t, 3, row, str.tostring(n), bg)
    f_cell(t, 4, row, str.tostring(f_v(r, dm, h, 20)), bg)
    f_cell(t, 5, row, str.tostring(f_v(r, dm, h, 1)), bg)
    f_cell(t, 6, row, str.tostring(f_v(r, dm, h, 19)), bg)
    for j = 0 to 2
        int    rc = f_v(r, dm, h, 2 + j)
        string s  = ""
        if zcView == "到達率"
            s := str.tostring(rc) + " (" + f_pct(rc, n) + ")"
        else if zcView == "初回到達時間"
            s := rc == 0 ? "—" : "平均 " + str.tostring(f_v(r, dm, h, 5 + j) / (rc * 1.0), "0.0") + " / 中央 " + str.tostring(f_med(r, dm, h, j), "0.0") + " 分 (" + str.tostring(rc) + ")"
        else if zcView == "MFE・MAE"
            s := j == 0 ? f_avgUsd(f_v(r, dm, h, 8), n) : j == 1 ? f_avgUsd(f_v(r, dm, h, 9), n) : ""
        else
            s := rc == 0 ? "—" : f_avgUsd(f_v(r, dm, h, 10 + j), rc) + "～" + f_avgUsd(f_v(r, dm, h, 13 + j), rc) + " (順序不明 " + str.tostring(f_v(r, dm, h, 16 + j)) + "/" + str.tostring(rc) + ")"
        f_cell(t, 7 + j, row, s, bg)
    true

f_zeName(int s) =>
    s == 1 ? "有効な波" : s == 2 ? "波なし" : s == 3 ? "保留中" : s == 8 ? "外部側 OFF" : s == 9 ? "未接続・誤接続" : "OFF"

f_zdName(int s) =>
    s == 1 ? "正常" : s == 2 ? "計算不能" : s == 3 ? "履歴不足" : s == 9 ? "異常" : "OFF"

var table zcTbl = na

if barstate.islast
    if not na(zcTbl)
        table.delete(zcTbl)
    if not hlRun
        zcTbl := table.new(position.top_right, 1, 2, border_width = 1)
        f_cell(zcTbl, 0, 0, "ZCR-XAU: 集計停止", ZC_HEAD)
        f_cell(zcTbl, 0, 1, "5分の標準チャート (通常ローソク足) で使用してください。現在: " + timeframe.period + (chart.is_standard ? "" : " (非標準チャート)"), ZC_BG)
    else if array.size(zrSum) == 0
        zcTbl := table.new(position.top_right, 1, 1, border_width = 1)
        f_cell(zcTbl, 0, 0, "ZCR-XAU: 確定した 5分足がまだありません", ZC_HEAD)
    else
        // 表示する行: 根拠集合 (イベントの多い順に上位 N + その他) / 根拠数別 (単体・2 根拠・3 根拠以上・全体)
        array<ZcRow>  dRow  = array.new<ZcRow>()
        array<string> dName = array.new_string(0)
        int nSet = array.size(zrRow)
        if zcKind == "根拠数別"
            array.push(dRow, array.get(zrSum, 0))
            array.push(dName, "単体")
            array.push(dRow, array.get(zrSum, 1))
            array.push(dName, "2 根拠")
            array.push(dRow, array.get(zrSum, 2))
            array.push(dName, "3 根拠以上")
            array.push(dRow, array.get(zrSum, 3))
            array.push(dName, "全体")
        else
            ZcRow rest  = f_zcRowNew(0, 0)
            int   nRest = 0
            if nSet > 0
                array<int> keyv = array.new_int(nSet, 0)
                for i = 0 to nSet - 1
                    ZcRow r0 = array.get(zrRow, i)
                    array.set(keyv, i, (f_ev(r0, 0) + f_ev(r0, 1)) * (ZC_MAXROW + 1) + (ZC_MAXROW - i))
                array<int> ord = array.sort_indices(keyv, order.descending)
                for q = 0 to nSet - 1
                    ZcRow r1 = array.get(zrRow, array.get(ord, q))
                    if q < zcTopN
                        array.push(dRow, r1)
                        array.push(dName, f_setName(r1.mask))
                    else
                        f_rowMerge(rest, r1)
                        nRest += 1
            ZcRow over = array.get(zrSum, 4)
            if array.get(over.ev, 0) + array.get(over.ev, 1) + array.get(over.ev, 2) > 0
                f_rowMerge(rest, over)
                nRest += 1
            if nRest > 0
                array.push(dRow, rest)
                array.push(dName, "その他 (" + str.tostring(nRest) + " 集合)")
        int nD = array.size(dRow)

        // 欄外
        array<string> notes = array.new_string(0)
        array.push(notes, "計測しているのは「タッチ足確定後の反応」: P0 = タッチ足の終値、T0 = タッチ足の確定時刻、観察は次の 5分足から。タッチ足の中の反発 (高安) は順行にも逆行にも含めない。" +
             "N 分 = time_close が T0 + N 分以内の足。場所 = 共通の価格点を持つ Zone の極大集合 (1 本の足に場所が複数あれば全部を数える。方向不明は根拠数別の行だけ)")
        array.push(notes, "計測可能 = 観察期間が終わり、期間内に足が 1 本以上あった件数 (率の分母)。本数不足 = そのうち期間内の足が通常 (1 / 3 / 6 本) より少ない (欠損・休場またぎ)。" +
             "計測不能 = 期間内の足が 0 本・不正足 (分母に入れない)。待ち = 観測未完了 (分母に入れない)。件数 0 は「—」")
        string zl = "登録した Zone (累計): "
        for g = 0 to 21
            if f_gUse(g) and g != 3 and g != 4
                zl += array.get(ZC_GN, g) + " " + str.tostring(array.get(zcNZone, g)) + "  "
        array.push(notes, zl + " 現在有効 (ZB 以外) " + str.tostring(array.size(zxZ)) + " 本・接触中 " + str.tostring(array.size(zcOn)) + " 本")
        array.push(notes, "イベント (方向あり) " + str.tostring(st.nEv) + " 件 = 確定 " + str.tostring(st.nDone) + " + 追跡中 (観測未完了) " + str.tostring(array.size(zcPend)) +
             "   うち同じ足の 2 番目以降の場所 " + str.tostring(st.nEv2) + " 件 (場所が複数あった足 " + str.tostring(st.nMultiBar) + " 本)・接触中だった根拠を含む " + str.tostring(st.nEvOn) + " 件   方向不明 " + str.tostring(st.nUnk) + " 件 (集計に入れない)   継続中として抑制 " + str.tostring(st.nCont) + " 回 (足 × 場所)")
        array.push(notes, "不明として扱った期間: MA 不明の足 ZB-1m " + str.tostring(array.get(zcMaUnk, 0)) + " / ZB-5m " + str.tostring(array.get(zcMaUnk, 1)) + " (その間のイベント ZB-1m " + str.tostring(st.nMa1Ev) + " / ZB-5m " + str.tostring(st.nMa5Ev) + " 件)" +
             "   ZE 受信不正の足 4H " + str.tostring(array.get(zcZeBad, 0)) + " / D " + str.tostring(array.get(zcZeBad, 1)) + " (その間のイベント " + str.tostring(st.nZeEv) + " 件)" +
             "   ZD 正常でない足 1H " + str.tostring(array.get(zcZdBad, 0)) + " / 4H " + str.tostring(array.get(zcZdBad, 1)) + " / D " + str.tostring(array.get(zcZdBad, 2)) + " / W " + str.tostring(array.get(zcZdBad, 3)))
        array.push(notes, "ZE フィボ (LongFibWave の接続出力): 4H " + f_zeName(array.get(lbZeStat, 0)) + " / D " + f_zeName(array.get(lbZeStat, 1)) +
             (array.get(lbZeStat, 0) == 9 or array.get(lbZeStat, 1) == 9 ? "  ← 設定の「FIB …」13 項目に LongFibWave の同じ名前の系列を選んでください (使わないなら「ZE フィボを検知」を OFF)" : "") +
             "   ZD POC: 1H " + f_zdName(array.get(lbZdStat, 0)) + " / 4H " + f_zdName(array.get(lbZdStat, 1)) + " / D " + f_zdName(array.get(lbZdStat, 2)) + " / W " + f_zdName(array.get(lbZdStat, 3)) +
             "   FVG → iFVG " + str.tostring(st.nIfvg) + " / iFVG 無効 " + str.tostring(st.nFvgDead))
        array.push(notes, "集計開始前・助走中のタッチ (イベントにしない) " + str.tostring(st.nPre) + " 回 (助走 " + str.tostring(zcWarm) + " 本・開始 " + f_tm(zcStart) + "・ZB-1m の助走 " + str.tostring(zbWarm1) + " 本)   不正足 " + str.tostring(st.nBad) + " 本   計測不能にした観察期間: 足 0 本 " + str.tostring(array.get(zcWhy, 0)) + " / 不正足 " + str.tostring(array.get(zcWhy, 1)) +
             "   イベント記録 (EV plot): 出力済み " + str.tostring(st.nOut) + " 件・未出力 " + str.tostring(array.size(zcQ)) + " 件 (1 足 1 件ずつ)" + (st.rowOver > 0 ? "   行数上限超過 " + str.tostring(st.rowOver) + " 件" : ""))
        array.push(notes, "銘柄 " + syminfo.tickerid + "  確定 5分足 " + str.tostring(st.nBars) + " 本  " + f_tm(st.firstT) + " ～ " + f_tm(st.lastT) + " (Asia/Tokyo)   共通幅 ±$" + str.tostring(zHalf) +
             "  離脱 $" + str.tostring(zcDepT * syminfo.mintick, format.mintick) + " / " + str.tostring(zcDepMin) + " 分。履歴上の頻度で将来を保証しない")
        int nNote = array.size(notes)

        if zcView == "件数内訳"
            zcTbl := table.new(position.top_right, 11, 2 + math.max(nD, 1) + nNote, border_width = 1)
            f_note(zcTbl, 0, 11, "ZCR-XAU 件数内訳 (タッチ足確定後の反応。LONG = 上からのタッチ / SHORT = 下からのタッチ。接触中だった根拠を含むイベント: " + zcOnMode + ")")
            array<string> hd = array.from("根拠集合", "根拠数", "LONG イベント", "SHORT イベント", "方向不明", "計測可能 5 / 15 / 30 分", "うち本数不足 5 / 15 / 30 分", "計測不能 5 / 15 / 30 分", "待ち 5 / 15 / 30 分", "到達前逆行の順序不明 $5 / $10 / $15 (30 分)",
                 "うち接触中だった根拠を含む (LONG / SHORT。表示の選択によらない)")
            for c = 0 to 10
                f_cell(zcTbl, c, 1, array.get(hd, c), ZC_HEAD)
            int row = 2
            if nD == 0
                f_note(zcTbl, row, 11, "イベントはまだありません")
                row += 1
            else
                for i = 0 to nD - 1
                    ZcRow  r  = array.get(dRow, i)
                    string dm = "LONG＋SHORT合算"
                    f_cell(zcTbl, 0, row, array.get(dName, i), ZC_BG)
                    f_cell(zcTbl, 1, row, r.cnt > 0 and zcKind != "根拠数別" ? str.tostring(r.cnt) : "", ZC_BG)
                    f_cell(zcTbl, 2, row, str.tostring(f_ev(r, 0)), ZC_BG)
                    f_cell(zcTbl, 3, row, str.tostring(f_ev(r, 1)), ZC_BG)
                    f_cell(zcTbl, 10, row, str.tostring(array.get(r.ev2, 0)) + " / " + str.tostring(array.get(r.ev2, 1)), ZC_BG)
                    f_cell(zcTbl, 4, row, str.tostring(array.get(r.ev, 2)), ZC_BG)
                    f_cell(zcTbl, 5, row, str.tostring(f_v(r, dm, 0, 0)) + " / " + str.tostring(f_v(r, dm, 1, 0)) + " / " + str.tostring(f_v(r, dm, 2, 0)), ZC_BG)
                    f_cell(zcTbl, 6, row, str.tostring(f_v(r, dm, 0, 20)) + " / " + str.tostring(f_v(r, dm, 1, 20)) + " / " + str.tostring(f_v(r, dm, 2, 20)), ZC_BG)
                    f_cell(zcTbl, 7, row, str.tostring(f_v(r, dm, 0, 1)) + " / " + str.tostring(f_v(r, dm, 1, 1)) + " / " + str.tostring(f_v(r, dm, 2, 1)), ZC_BG)
                    f_cell(zcTbl, 8, row, str.tostring(f_v(r, dm, 0, 19)) + " / " + str.tostring(f_v(r, dm, 1, 19)) + " / " + str.tostring(f_v(r, dm, 2, 19)), ZC_BG)
                    f_cell(zcTbl, 9, row, str.tostring(f_v(r, dm, 2, 16)) + " / " + str.tostring(f_v(r, dm, 2, 17)) + " / " + str.tostring(f_v(r, dm, 2, 18)), ZC_BG)
                    row += 1
            for m = 0 to nNote - 1
                f_note(zcTbl, row + m, 11, array.get(notes, m))
        else
            bool split = zcDirMode == "LONG / SHORT 別"
            int  nDir  = split ? 2 : 1
            int  nHz   = zcHzMode == "全期間" ? 3 : 1
            zcTbl := table.new(position.top_right, 10, 2 + math.max(nD * nDir * nHz, 1) + nNote, border_width = 1)
            f_note(zcTbl, 0, 10, "ZCR-XAU " + zcView + " (タッチ足確定後の反応。タッチ足の中の反発は含まない。LONG = 上からのタッチ / SHORT = 下からのタッチ。接触中だった根拠を含むイベント: " + zcOnMode + ")")
            array<string> hd = array.from("根拠集合", "方向", "期間", "計測可能", "うち本数不足", "計測不能", "待ち", "", "", "")
            if zcView == "到達率"
                array.set(hd, 7, "$5 到達 件数 (率)")
                array.set(hd, 8, "$10 到達 件数 (率)")
                array.set(hd, 9, "$15 到達 件数 (率)")
            else if zcView == "初回到達時間"
                array.set(hd, 7, "$5 初回到達 (到達件数)")
                array.set(hd, 8, "$10 初回到達 (到達件数)")
                array.set(hd, 9, "$15 初回到達 (到達件数)")
            else if zcView == "MFE・MAE"
                array.set(hd, 7, "平均 最大順行幅 (MFE)")
                array.set(hd, 8, "平均 最大逆行幅 (MAE)")
            else
                array.set(hd, 7, "$5 到達前の最大逆行 平均 下限～上限")
                array.set(hd, 8, "$10 到達前の最大逆行 平均 下限～上限")
                array.set(hd, 9, "$15 到達前の最大逆行 平均 下限～上限")
            for c = 0 to 9
                f_cell(zcTbl, c, 1, array.get(hd, c), ZC_HEAD)
            int row = 2
            if nD == 0
                f_note(zcTbl, row, 10, "イベントはまだありません")
                row += 1
            else
                for i = 0 to nD - 1
                    ZcRow r = array.get(dRow, i)
                    for ds = 0 to nDir - 1
                        string dm = split ? (ds == 0 ? "LONGのみ" : "SHORTのみ") : zcDirMode
                        string dl = dm == "LONGのみ" ? "LONG" : dm == "SHORTのみ" ? "SHORT" : "L+S"
                        for h = 0 to 2
                            bool shown = zcHzMode == "全期間" or (h == 0 and zcHzMode == "5分") or (h == 1 and zcHzMode == "15分") or (h == 2 and zcHzMode == "30分")
                            if shown
                                color bg = dm == "SHORTのみ" ? ZC_BG2 : ZC_BG
                                f_cell(zcTbl, 0, row, array.get(dName, i), bg)
                                f_cell(zcTbl, 1, row, dl, bg)
                                f_cell(zcTbl, 2, row, h == 0 ? "5分" : h == 1 ? "15分" : "30分", bg)
                                f_line(zcTbl, row, r, dm, h, bg)
                                row += 1
            for m = 0 to nNote - 1
                f_note(zcTbl, row + m, 10, array.get(notes, m))

// ---- イベント記録の出力 (確定したイベントを 1 足 1 件。並び・単位・特殊値は仕様書の表。出力のない足は na) -------------------------
plot(array.get(zcOut, 0),  "EV ID",                  display = display.data_window)
plot(array.get(zcOut, 1),  "EV T0 (Unix 秒)",         display = display.data_window)
plot(array.get(zcOut, 2),  "EV P0 (タッチ足の終値)",    display = display.data_window)
plot(array.get(zcOut, 3),  "EV 方向 (1 L / -1 S)",     display = display.data_window)
plot(array.get(zcOut, 4),  "EV 根拠マスク",            display = display.data_window)
plot(array.get(zcOut, 5),  "EV 根拠数",               display = display.data_window)
plot(array.get(zcOut, 6),  "EV Zone 本数",            display = display.data_window)
plot(array.get(zcOut, 7),  "EV 接触端側メンバーの根拠 ID", display = display.data_window)
plot(array.get(zcOut, 8),  "EV 場所 C 上端",           display = display.data_window)
plot(array.get(zcOut, 9),  "EV 場所 C 下端",           display = display.data_window)
plot(array.get(zcOut, 10), "EV 接触端",               display = display.data_window)
plot(array.get(zcOut, 11), "EV 終値 − 接触端 (方向つき)", display = display.data_window)
plot(array.get(zcOut, 12), "EV 終値の位置 (0 手前 / 1 帯内 / 2 抜けた)", display = display.data_window)
plot(array.get(zcOut, 13), "EV 同じ足の場所の順番",      display = display.data_window)
plot(array.get(zcOut, 14), "EV 同じ足の場所数",         display = display.data_window)
plot(array.get(zcOut, 15), "EV 補助マスク",            display = display.data_window)
plot(array.get(zcOut, 16), "EV $5 初回到達分",         display = display.data_window)
plot(array.get(zcOut, 17), "EV $10 初回到達分",        display = display.data_window)
plot(array.get(zcOut, 18), "EV $15 初回到達分",        display = display.data_window)
plot(array.get(zcOut, 19), "EV $5 到達前逆行 下限",     display = display.data_window)
plot(array.get(zcOut, 20), "EV $5 到達前逆行 上限",     display = display.data_window)
plot(array.get(zcOut, 21), "EV $10 到達前逆行 下限",    display = display.data_window)
plot(array.get(zcOut, 22), "EV $10 到達前逆行 上限",    display = display.data_window)
plot(array.get(zcOut, 23), "EV $15 到達前逆行 下限",    display = display.data_window)
plot(array.get(zcOut, 24), "EV $15 到達前逆行 上限",    display = display.data_window)
plot(array.get(zcOut, 25), "EV MFE 5分",              display = display.data_window)
plot(array.get(zcOut, 26), "EV MAE 5分",              display = display.data_window)
plot(array.get(zcOut, 27), "EV MFE 15分",             display = display.data_window)
plot(array.get(zcOut, 28), "EV MAE 15分",             display = display.data_window)
plot(array.get(zcOut, 29), "EV MFE 30分",             display = display.data_window)
plot(array.get(zcOut, 30), "EV MAE 30分",             display = display.data_window)
plot(array.get(zcOut, 31), "EV 期間内の足 5分",         display = display.data_window)
plot(array.get(zcOut, 32), "EV 期間内の足 15分",        display = display.data_window)
plot(array.get(zcOut, 33), "EV 期間内の足 30分",        display = display.data_window)
plot(array.get(zcOut, 34), "EV 状態フラグ",            display = display.data_window)
plot(array.get(zcOut, 35), "EV 接触中だった根拠マスク",   display = display.data_window)
plot(array.get(zcOut, 36), "EV 辺マスク",              display = display.data_window)
plot(array.size(zcQ),      "未出力のイベント記録",       display = display.data_window)
plot(st.nEv,               "イベント数 (方向あり・累計)", display = display.data_window)
plot(array.size(zcPend),   "追跡中の観測",             display = display.data_window)
plot(st.nUnk,              "方向不明 (累計)",          display = display.data_window)
plot(array.get(lbZeStat, 0) == 9 or array.get(lbZeStat, 1) == 9 ? 1 : 0, "ZE 受信不正 (1 = 未接続・誤接続)", display = display.data_window)

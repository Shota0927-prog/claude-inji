//@version=6
// ZCR-10: XAUUSD 2 根拠ペア別の反応計測 (集計専用。注文・売買シグナル・アラートは出さない。タイミング・フィルター・TP / SL 最適化なし)
//
//  未検証: TradingView 上のコンパイル・request の挙動・描画・表・CSV 書き出しは未検証 (PINE_NOT_VERIFIED)。tests/zcr_sim.py は下の
//          「ZCR Logic」区間そのものを Python に機械変換して実行した検証で、request.* / input.source が返す値は合成データで与えている。
//  仕様書: ZONE_CONFLUENCE_REACTION_XAU_ja.md (定義はすべてそちらに明文化)。要点だけ:
//  対象: 26 根拠 (根拠 ID = 種類 × 生成元の時間足) の全 325 ペア × LONG / SHORT = 650 のペア・方向を、それぞれ指定の 2 根拠だけで独立に計測する。
//    他の根拠は帯の切り詰め・新規接触・接触中・離脱のどれにも関与しない (他の根拠が重なる場面も、そのペアの 2 根拠の条件だけで数える)。
//  候補帯・接触: ZoneConfluenceStrategyXAU (ZCS) の規則の写し。確定 5分足 k の終わりの Zone と終値で、A の有効 Zone × B の有効 Zone の帯そのもの
//    (切り詰めない) の共通区間のうち、LONG は「終値 > 上端」で上端が最も高いもの / SHORT は「終値 < 下端」で下端が最も低いもの = 武装した帯
//    (ZCS の指値の帯。通常 FVG の向き・接近側の条件も ZCS と同じ)。接触中のペア・方向は武装しない。次の足 k+1 の安値 (LONG) / 高値 (SHORT) が
//    武装した帯の LONG 上端 / SHORT 下端に届いたら、そのペア・方向の「新規接触」(ZCS で指値が約定する足)。1 足 1 ペア・方向で最大 1 件。
//    接触中・離脱 (離脱幅 / 離脱時間) はペア・方向ごとに ZCS の f_zsContact のまま。
//  計測: 起点 P0 = 武装した帯の LONG 上端 / SHORT 下端 (発生時に固定)、T0 = タッチ足 (新規接触の足) の time_close。
//    ±$5 / $10 / $15 のどちらに先に届くか (値幅ごとに独立・時間制限なし)。タッチ足は ZCR-9 の帯端起点の規則 (終値で確認した反発と逆行側の極値だけ)、
//    次の足からは ZCR-9 の先着判定 (始値優先・同じ足で両方 = 順序不明・不正足 = 計測不能)。順序不明は先着率の分母から除く。
//  1 ポジ相当: ペア・方向・値幅ごとに観測は同時に 1 件。その値幅が決着するまで次の新規接触はその値幅を「見送り」(後から採用しない)。
//  出力: 右上の表 (ペア × 方向 × 値幅 = 1,950 行をページ送り) と、新規接触 1 件 = 1 記録を 1 足 4 件まで出す R plot 群 (Data Window / CSV)。
indicator("ZoneConfluenceReactionStatsXAU", shorttitle = "ZCR-XAU", overlay = true, max_bars_back = 1100, max_boxes_count = 200, max_labels_count = 200)

// ---- 入力 (Zone の入力名・初期値は ZoneComboLabXAU と同じ) --------------------------------------------------------------
var string G_ZW = "01 · Zone 共通"
zHalf = input.float(2.0, "共通の価格帯幅 (中心から上下 $)", minval = 0.0, step = 0.5, group = G_ZW,
     tooltip = "ZA / ZB / ZC / ZD / ZE の帯 = 中心 ± この値。ZF (FVG) は本来の上下限、ZG は専用の幅を使う。")

var string G_ZA = "02a · ZA アキュム (1H / 4H / D)"
zaUse1 = input.bool(false, "1H アキュム", group = G_ZA)
zaUse2 = input.bool(true, "4H アキュム", group = G_ZA)
zaUse3 = input.bool(true, "日足 アキュム", group = G_ZA)
zaKeep1 = input.int(1, "1時間足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaKeep2 = input.int(1, "4時間足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaKeep3 = input.int(1, "日足: 最新から採用する箱数", minval = 1, group = G_ZA,
     tooltip = "形成終了で固定した箱の上辺・下辺 (別々の Zone) のうち、時間足ごとに最新 N 箱だけを使う (Lab と同じ)。")

var string G_ACCP = "02a' · Accum Box のパラメータ (ZoneComboLabXAU と同じ)"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ZB = "02b · ZB MA (EMA)"
zbUse1 = input.bool(true, "1分足 EMA", group = G_ZB)
zbLen1 = input.int(3000, "1分足 EMA 本数", minval = 1, group = G_ZB)
zbWarm1 = input.int(1800, "ZB-1m の助走本数 (5分足。0 = 無効)", minval = 0, group = G_ZB,
     tooltip = "1分 EMA の有効値を受け取り始めてからこの本数 (5分足) の間は、未収束として ZB-1m を「不明」にする (Zone を作らず、不明の件数に数える)。\n" +
     "初期値 1800 本 = 1分足 9000 本相当。ZB-5m は下の「先頭から集計しない助走本数」で扱う。")
zbUse2 = input.bool(true, "5分足 EMA", group = G_ZB)
zbLen2 = input.int(3000, "5分足 EMA 本数", minval = 1, group = G_ZB,
     tooltip = "帯 = EMA ± 共通幅。5分足 k の判定には足 k-1 が確定した時点の値を使う。ta.ema は先頭の足から値を返すので、読み込んだ履歴の先頭側は\n" +
     "EMA 3000 の初期誤差が残る (「先頭から集計しない助走本数」で集計から外す)。値が na の足 (1分足の履歴が届いていない区間など) は「不明」として別に数え、MA 根拠は作らない。")

var string G_ZC = "02c · ZC 水平線 (Swing 高安)"
zcUse1 = input.bool(false, "1H Swing", group = G_ZC)
zcPiv1 = input.int(6, "1H 左右の本数", minval = 1, group = G_ZC)
zcUse2 = input.bool(false, "4H Swing", group = G_ZC)
zcPiv2 = input.int(6, "4H 左右の本数", minval = 1, group = G_ZC)
zcUse3 = input.bool(true, "日足 Swing", group = G_ZC)
zcPiv3 = input.int(6, "日足 左右の本数", minval = 1, group = G_ZC)
zcUse4 = input.bool(true, "週足 Swing", group = G_ZC)
zcPiv4 = input.int(6, "週足 左右の本数", minval = 1, group = G_ZC)
zcMax = input.int(0, "時間足ごとの保持本数 (0 = 無制限)", minval = 0, group = G_ZC,
     tooltip = "0 = Lab と同じ (登録した水平線は削除しない)。1 以上にすると時間足ごとに新しい順で N 本だけ残す (集計結果が変わる)。\n" +
     "集計では線ごとに個別の帯 (価格 ± 共通幅) を使う。Lab の統合帯 (水平線の統合距離) は使わない。")

var string G_ZD = "02d · ZD 出来高 POC (内蔵計算。MtfPocFeedXAU と同じ式)"
zdUse1 = input.bool(false, "1H POC", group = G_ZD, inline = "t1")
zdLen1 = input.int(120, "本数", minval = 10, maxval = 1000, group = G_ZD, inline = "t1")
zdUse2 = input.bool(true, "4H POC", group = G_ZD, inline = "t2")
zdLen2 = input.int(120, "本数", minval = 10, maxval = 1000, group = G_ZD, inline = "t2")
zdUse3 = input.bool(true, "日足 POC", group = G_ZD, inline = "t3")
zdLen3 = input.int(120, "本数", minval = 10, maxval = 1000, group = G_ZD, inline = "t3")
zdUse4 = input.bool(true, "週足 POC", group = G_ZD, inline = "t4")
zdLen4 = input.int(120, "本数", minval = 10, maxval = 1000, group = G_ZD, inline = "t4")
vpBins = input.int(75, "VP ビン数 (分割数)", minval = 4, maxval = 100, group = G_ZD)

// ---- ZE / ZF の入力 (ZoneComboLabXAU.pine と同一。ZF の 4 つの ON / OFF の初期値だけ ON に変えてある: Lab は OFF) ----
var string G_ZE = "02e · ZE フィボ (外部: LongFibWave の出力を受信)"
zeUse  = input.bool(true, "ZE フィボを検知", group = G_ZE,
     tooltip = "同じチャートに追加した LongFibWave の接続出力 (下の 13 項目に同じ名前の系列を選ぶ) から、4時間足・日足それぞれ最新の 1 波の\n" +
     "0.236 / 0.382 / 0.5 / 0.618 (価格 = 終点 + 比率 × (起点 − 終点)) を Zone (価格 ± 共通幅) にする。OFF なら作成・判定・接続の確認をしない。")
zeUse4 = input.bool(true, "4時間足の波を採用", group = G_ZE)
zeUseD = input.bool(true, "日足の波を採用", group = G_ZE)
zeProto = input.source(close, "FIB protocol", group = G_ZE)
ze4O = input.source(close, "FIB 4H 起点", group = G_ZE)
ze4E = input.source(close, "FIB 4H 終点", group = G_ZE)
ze4D = input.source(close, "FIB 4H 方向", group = G_ZE)
ze4I = input.source(close, "FIB 4H 波ID", group = G_ZE)
ze4S = input.source(close, "FIB 4H 状態", group = G_ZE)
ze4T = input.source(close, "FIB 4H 更新確定時刻", group = G_ZE)
zeDO = input.source(close, "FIB 日足 起点", group = G_ZE)
zeDE = input.source(close, "FIB 日足 終点", group = G_ZE)
zeDD = input.source(close, "FIB 日足 方向", group = G_ZE)
zeDI = input.source(close, "FIB 日足 波ID", group = G_ZE)
zeDS = input.source(close, "FIB 日足 状態", group = G_ZE)
zeDT = input.source(close, "FIB 日足 更新確定時刻", group = G_ZE)

var string G_ZF = "02f · ZF FVG / iFVG"
zfUse1 = input.bool(true, "1H FVG", group = G_ZF)
zfUse2 = input.bool(true, "4H FVG", group = G_ZF)
zfUse3 = input.bool(true, "日足 FVG", group = G_ZF)
zfUse4 = input.bool(true, "週足 FVG", group = G_ZF)
zfMinW = input.float(3.0, "FVG 最小幅 ($)", minval = 0.0, step = 0.5, group = G_ZF,
     tooltip = "上昇: low > high[2] / 下降: high < low[2]、幅 (mintick 正規化) >= この値。Zone = FVG 本来の上下限。\n" +
     "その時間足の確定終値で反対端を抜けたら iFVG、iFVG を確定終値で逆方向に抜けたら無効。日数による失効なし。")

var string G_ZG = "02g · ZG ダブル / トリプル トップ・ボトム (1H / 4H / D)"
zgUse1  = input.bool(true, "1時間足のダブル / トリプル", group = G_ZG, inline = "zgu1")
zgExp1  = input.bool(true, "1時間足: 時間で消す", group = G_ZG, inline = "zge1")
zgExpN1 = input.int(24, "本数", minval = 1, group = G_ZG, inline = "zge1")
zgUse4  = input.bool(true, "4時間足のダブル / トリプル", group = G_ZG, inline = "zgu4")
zgExp4  = input.bool(true, "4時間足: 時間で消す", group = G_ZG, inline = "zge4")
zgExpN4 = input.int(12, "本数", minval = 1, group = G_ZG, inline = "zge4")
zgUseD  = input.bool(true, "日足のダブル / トリプル", group = G_ZG, inline = "zguD")
zgExpD  = input.bool(true, "日足: 時間で消す", group = G_ZG, inline = "zgeD")
zgExpND = input.int(5, "本数", minval = 1, group = G_ZG, inline = "zgeD",
     tooltip = "検知足 = 0 本目。この本数のその時間足が確定した時点で Zone を消す (Lab と同じ)。")
zgHalf = input.float(2.0, "ZG 帯の幅 (基準価格から上下 $)", minval = 0.0, step = 0.5, group = G_ZG)
zgRev  = input.float(5.0, "ZG 逆行で消す幅 ($)", minval = 0.0, step = 0.5, group = G_ZG,
     tooltip = "トップは max(open, close) > 基準価格 + この値、ボトムは min(open, close) < 基準価格 − この値の確定 5分足で消す (Lab と同じ式)。")
// ---- ZG 検知の入力 (ZoneComboLabXAU.pine と同一) ----
var string G_ZG1 = "02g-1 · ZG 1時間足の検知 (LongTermDoubleTripleTopBottomXAU と同じ処理)"
zgPiv1   = input.int(4, "1時間足: Pivot 前後の本数", minval = 1, group = G_ZG1)
zgWave1  = input.float(10.0, "1時間足: 最初の波の最低値幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgBuf1   = input.float(5.0, "1時間足: 接近許容幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgDist1  = input.float(30.0, "1時間足: 接触間の最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgGap1   = input.int(8, "1時間足: 接触開始足どうしの最低間隔", minval = 1, group = G_ZG1)
zgBody1  = input.float(3.0, "1時間足: 反転足の最低実体幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgRatio1 = input.float(30.0, "1時間足: 反転足の最低実体比率 (%)", minval = 0.0, maxval = 100.0, step = 1.0, group = G_ZG1)
zgWait1  = input.int(3, "1時間足: 反転待ち (接触足の後の最大本数)", minval = 0, group = G_ZG1)
zgMax1   = input.int(24, "1時間足: 基準の最大監視本数", minval = 1, group = G_ZG1)
zgDir1   = input.bool(false, "1時間足: 最初の山・谷の方向フィルターを使う", group = G_ZG1)
zgSep1   = input.bool(true, "1時間足: 最低離れ幅フィルターを使う", group = G_ZG1,
     tooltip = "各項目の意味・判定は LongTermDoubleTripleTopBottomXAU と同じ (本数は1時間足の bar_index)。検知イベント (反転足の確定) で Zone を発動する。")
var string G_ZG4 = "02g-2 · ZG 4時間足の検知 (LongTermDoubleTripleTopBottomXAU と同じ処理)"
zgPiv4   = input.int(4, "4時間足: Pivot 前後の本数", minval = 1, group = G_ZG4)
zgWave4  = input.float(60.0, "4時間足: 最初の波の最低値幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)
zgBuf4   = input.float(20.0, "4時間足: 接近許容幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)
zgDist4  = input.float(80.0, "4時間足: 接触間の最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)
zgGap4   = input.int(8, "4時間足: 接触開始足どうしの最低間隔", minval = 1, group = G_ZG4)

zgRatio4 = input.float(30.0, "4時間足: 反転足の最低実体比率 (%)", minval = 0.0, maxval = 100.0, step = 1.0, group = G_ZG4)
zgWait4  = input.int(3, "4時間足: 反転待ち (接触足の後の最大本数)", minval = 0, group = G_ZG4)
zgMax4   = input.int(48, "4時間足: 基準の最大監視本数", minval = 1, group = G_ZG4)
zgDir4   = input.bool(false, "4時間足: 最初の山・谷の方向フィルターを使う", group = G_ZG4)
zgSep4   = input.bool(true, "4時間足: 最低離れ幅フィルターを使う", group = G_ZG4,
     tooltip = "各項目の意味・判定は LongTermDoubleTripleTopBottomXAU と同じ (本数は4時間足の bar_index)。検知イベント (反転足の確定) で Zone を発動する。")
var string G_ZGD = "02g-3 · ZG 日足の検知 (LongTermDoubleTripleTopBottomXAU と同じ処理)"
zgPivD   = input.int(4, "日足: Pivot 前後の本数", minval = 1, group = G_ZGD)
zgWaveD  = input.float(40.0, "日足: 最初の波の最低値幅 ($)", minval = 0.0, step = 0.5, group = G_ZGD)
zgBufD   = input.float(20.0, "日足: 接近許容幅 ($)", minval = 0.0, step = 0.5, group = G_ZGD)
zgDistD  = input.float(120.0, "日足: 接触間の最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_ZGD)

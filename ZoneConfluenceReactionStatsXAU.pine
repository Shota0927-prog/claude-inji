zgBodyD  = input.float(12.0, "日足: 反転足の最低実体幅 ($)", minval = 0.0, step = 0.5, group = G_ZGD)
zgRatioD = input.float(30.0, "日足: 反転足の最低実体比率 (%)", minval = 0.0, maxval = 100.0, step = 1.0, group = G_ZGD)
zgWaitD  = input.int(3, "日足: 反転待ち (接触足の後の最大本数)", minval = 0, group = G_ZGD)
zgMaxD   = input.int(24, "日足: 基準の最大監視本数", minval = 1, group = G_ZGD)
zgDirD   = input.bool(false, "日足: 最初の山・谷の方向フィルターを使う", group = G_ZGD)
zgSepD   = input.bool(true, "日足: 最低離れ幅フィルターを使う", group = G_ZGD,
     tooltip = "各項目の意味・判定は LongTermDoubleTripleTopBottomXAU と同じ (本数は日足の bar_index)。検知イベント (反転足の確定) で Zone を発動する。")

var string G_JD = "03 · 判定"
zcDepW = input.float(5.0, "離脱幅 ($)", minval = 0.01, step = 0.5, group = G_JD,
     tooltip = "接触中の解除 (ペア・方向ごと・接触の帯で判定。ZCS と同じ): 確定 5分足が接触の帯の完全に外側で、帯の端からの距離がこの値以上。")
zcDepMin = input.int(30, "離脱時間 (分)", minval = 1, group = G_JD,
     tooltip = "接触中の解除: 完全に外側の状態が、最初の外側の足の開始から今の足の確定までこの分数以上続いた (実際の経過時間)。")

zcStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "集計開始日時 (武装する足の確定時刻)", group = G_JD,
     tooltip = "確定足の time_close がこの日時より前の足では帯を武装しない (= 次の足の新規接触を数えない。ZCS の発注開始日時と同じ)。")
zcWarm = input.int(6000, "先頭から集計しない助走本数 (0 = 無効)", minval = 0, group = G_JD,
     tooltip = "読み込んだ確定 5分足の先頭からこの本数の間は帯を武装しない (EMA 3000 の初期誤差と、上位足由来の Zone がまだ揃っていない区間を外す)。\n" +
     "その間も Zone の登録・更新・失効と接触中・離脱の状態の更新は通常どおり行う。")

var string G_DS = "04 · 表示 (集計値には影響しない)"
zrDirSel  = input.string("両方", "方向", options = ["両方", "LONG", "SHORT"], group = G_DS)
zrWSel    = input.string("全部", "値幅", options = ["全部", "$5", "$10", "$15"], group = G_DS)
zrOrder   = input.string("ペア番号順", "並び順", options = ["ペア番号順", "新規接触の多い順"], group = G_DS,
     tooltip = "ペア番号順 = ZC_GN 順の a < b の辞書順 (ZCS の pL### / pS### と同じ番号)、方向 (LONG → SHORT)、値幅 ($5 → $15) の順。\n" +
     "新規接触の多い順 = 新規接触件数の多い順 (同数はペア番号順)")
zrHide0   = input.bool(true, "新規接触 0 件の行を隠す", group = G_DS)
zrPerPage = input.int(20, "1 ページの行数", minval = 1, maxval = 60, group = G_DS)
zrPage    = input.int(1, "ページ", minval = 1, maxval = 2000, group = G_DS, tooltip = "1 から。総ページ数を超えると最後のページ。表の 1 行目に 現在 / 総ページ")
zcTxtSize = input.string("small", "文字サイズ", options = ["tiny", "small", "normal", "large"], group = G_DS)
zcPos     = input.string("top_right", "表示位置", options = ["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group = G_DS)
zcShowBox = input.bool(true, "新規接触の帯を描く (直近だけ)", group = G_DS)
zcDrawMax = input.int(50, "描画を残す件数", minval = 1, maxval = 150, group = G_DS)

// ---- ZA: Accum 検出 (ZoneComboLabXAU.pine の写し。tests/zcr_sim.py が元ファイルと照合) ---------------------------------
// ==== LAB Accum copy (begin) =================================================
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not _isAccum[1]          // v6: bool は na にならない (最初の足の [1] は false = v5 の nz(…, false) と同じ)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== LAB Accum copy (end) ===================================================

f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

// ---- ZB: EMA (Lab と同じ取得)。足 k の確定時点の値で足 k の終わりに帯を置き直す (次の足 k+1 の接触・武装に使う = ZCR-9 の足 k+1 の帯と同じ値。ZCS と同じ) ---
float zbMa1 = request.security(syminfo.tickerid, "1", ta.ema(close, zbLen1), lookahead = barmerge.lookahead_off)
float zbMa2 = ta.ema(close, zbLen2)

// ---- ZC: Swing (ZoneComboLabXAU.pine の f_lbPivotConfirmed をそのまま) -------------------------------------------------
f_lbPivotConfirmed(simple int len) =>
    float _ph = ta.pivothigh(high, len, len)
    float _pl = ta.pivotlow(low,  len, len)
    int   _pt = na(_ph) ? int(na) : time
    int   _lt = na(_pl) ? int(na) : time
    [_ph[1], _pt[1], _pl[1], _lt[1]]

[s1h, s1ht, s1l, s1lt] = request.security(syminfo.tickerid, "60",  f_lbPivotConfirmed(zcPiv1), lookahead = barmerge.lookahead_on)
[s2h, s2ht, s2l, s2lt] = request.security(syminfo.tickerid, "240", f_lbPivotConfirmed(zcPiv2), lookahead = barmerge.lookahead_on)
[s3h, s3ht, s3l, s3lt] = request.security(syminfo.tickerid, "D",   f_lbPivotConfirmed(zcPiv3), lookahead = barmerge.lookahead_on)
[s4h, s4ht, s4l, s4lt] = request.security(syminfo.tickerid, "W",   f_lbPivotConfirmed(zcPiv4), lookahead = barmerge.lookahead_on)

// ---- ZD: POC (MtfPocFeedXAU.pine の f_pocCore / f_feed をそのまま。f_feed の off = 1 で確定済み上位足だけ) -----------------
//  Lab は外部インジ MtfPocFeedXAU から受け取るが、ここは同じ計算を内蔵する (接続不要)。受信後の検証は Lab の ZD と同じ処理を通す
// ==== FEED POC core (begin) ==================================================
f_pocCore(bool enabled, int off, int lookback, int bins) =>
    float poc = na
    float pUp = na
    float pLo = na
    if enabled and lookback > 0 and bins > 0 and bar_index - off >= lookback
        float hi = na
        float lo = na
        bool  ok = true
        for k = off to off + lookback - 1
            float h = high[k]
            float l = low[k]
            float v = volume[k]
            if na(h) or na(l) or na(v)
                ok := false
                break
            hi := na(hi) ? h : math.max(hi, h)
            lo := na(lo) ? l : math.min(lo, l)
        float rangeAll = ok ? hi - lo : na
        if ok and rangeAll > 0
            array<float> bv = array.new_float(bins, 0.0)
            float bs = rangeAll / bins
            float total = 0.0
            for k = off to off + lookback - 1
                float ch = high[k]
                float cl = low[k]
                float cv = volume[k]
                total += cv
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    int b0 = math.max(0, math.floor((cl - lo) / bs) - 1)
                    int b1 = math.min(bins - 1, math.floor((ch - lo) / bs) + 1)
                    for bi = b0 to b1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
            if total > 0
                float best  = -1.0
                int   bestI = 0
                for bi = 0 to bins - 1
                    float bvv = array.get(bv, bi)
                    if bvv > best
                        best  := bvv
                        bestI := bi
                pLo := lo + bestI * bs
                pUp := pLo + bs
                poc := (pUp + pLo) / 2.0
    [poc, pUp, pLo]
// ==== FEED POC core (end) ====================================================

// 上位足の中で評価: 1 本前 (確定済み) の上位足までで計算 → [区画下限, 区画上限, 対象足時刻]
f_feed(bool enabled, int lookback, int bins) =>
    [pc, up, lo] = f_pocCore(enabled, 1, lookback, bins)
    int   tk = time[1]
    float tOut = not enabled ? 0.0 : na(tk) ? na : na(pc) ? -float(tk) : float(tk)
    [enabled ? lo : na, enabled ? up : na, tOut]

[zdL1, zdU1, zdT1] = request.security(syminfo.tickerid, "60",  f_feed(zdUse1, zdLen1, vpBins), lookahead = barmerge.lookahead_on)
[zdL2, zdU2, zdT2] = request.security(syminfo.tickerid, "240", f_feed(zdUse2, zdLen2, vpBins), lookahead = barmerge.lookahead_on)
[zdL3, zdU3, zdT3] = request.security(syminfo.tickerid, "D",   f_feed(zdUse3, zdLen3, vpBins), lookahead = barmerge.lookahead_on)
[zdL4, zdU4, zdT4] = request.security(syminfo.tickerid, "W",   f_feed(zdUse4, zdLen4, vpBins), lookahead = barmerge.lookahead_on)
float zdProto = 10001      // 内蔵計算なので protocol は常に正しい値 (Lab の ZD 受信処理をそのまま使うための定数)

// ---- ZF: FVG (ZoneComboLabXAU.pine の f_fvgConfirmed をそのまま) -------------------------------------------------------
// ==== LAB FVG copy (begin) ===================================================
f_fvgConfirmed(float minWidth) =>
    bool  _bull = low > high[2]
    bool  _bear = high < low[2]
    float _top  = _bull ? low : _bear ? low[2] : na
    float _bot  = _bull ? high[2] : _bear ? high : na
    int   _dir  = (_bull or _bear) and math.round_to_mintick(_top - _bot) >= minWidth ? (_bull ? 1 : -1) : 0
    [time[1], time_close[1], close[1], _dir[1], _top[1], _bot[1]]
// ==== LAB FVG copy (end) =====================================================

[g1k, g1kc, g1c, g1d, g1t, g1b] = request.security(syminfo.tickerid, "60",  f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g2k, g2kc, g2c, g2d, g2t, g2b] = request.security(syminfo.tickerid, "240", f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g3k, g3kc, g3c, g3d, g3t, g3b] = request.security(syminfo.tickerid, "D",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g4k, g4kc, g4c, g4d, g4t, g4b] = request.security(syminfo.tickerid, "W",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)

// ---- ZG: ダブル / トリプル トップ・ボトム (ZoneComboLabXAU.pine の検知器の写し。確定した足の結果だけ: 1 本ずらし・lookahead_on) ----
// ==== ZG LTB copy (begin) ===================================================
//  LongTermDoubleTripleTopBottomXAU.pine (LTB-15, 9e92c02) の検知処理 (LtB1 / LtH / ltNew1 / ltCand1 / ltStep1 / ltRevWhy) の写し。
//  【変更】EPS → ZG_EPS (この位置で使うため)、基準ごとに 2 回目以後の接触群の実体極値 gx を保持し、検知イベント D の末尾 (16 番目) に
//  Zone の基準価格 (トップ = max(1 回目の山, gx) / ボトム = min(1 回目の谷, gx)) を加える。検知の判定・接触の数え方は変えない
float ZG_EPS = 1e-7
// 監視基準 1 個 (トップ = 実体上端の山 / ボトム = 実体下端の谷)
type LtB1
    int    id
    int    side               // -1 = トップ / 1 = ボトム
    float  lvl                // 基準価格 P (トップ = 実体上端 / ボトム = 実体下端)
    int    pvT                // 実際の Pivot 足の time / time_close は使わない
    int    cfT                // 登録 (右側 N 本目) の足の time / time_close (この時刻から利用可能)
    int    cfTc
    int    aBar               // 登録した足 (この足では接触・反転を見ない)
    int    pvBar              // 実際の Pivot 足の bar_index (最大監視本数の起算 = 0 本目 / 1 回目の接触開始足)
    int    cnt      = 1       // 接触回数 (基準 Pivot = 1 回目)。不採用の接触も数える
    bool   inC      = true    // 帯に接触中
    int    lastSt             // 直前の接触開始足の bar_index
    int    sepN     = 0       // 直前の接触が終わってから帯を離れていた足の本数
    float  sepX               // その足の実体の極値 (トップ = 実体下端の最小 / ボトム = 実体上端の最大)
    bool   elig     = false   // 現在の接触がシグナル対象 (開始時に固定)
    bool   waiting  = false   // 現在の接触で反転待ち中
    int    waitEnd            // 反転待ちの最後の足 (接触開始足 + 反転待ち)
    int    stBar              // 現在の接触の開始足 bar_index / time / time_close / 接触価格 (トップ = high / ボトム = low)
    int    stT
    int    stTc
    float  stP
    string why      = ""      // 現在の接触の不採用・未検知の理由 (1 文字ずつ: G 間隔不足 / S 離れ幅不足 / Z 実体端が帯外 /
                              //   C 反転方向の色ではない / B 実体幅不足 / R 実体比率不足 / E 接触終了 / W 反転待ち終了 / V 基準無効化 / T 監視期限終了)
    float  gx                 // 【ZG 追加】2 回目以後の接触群の実体極値 (トップ = 実体上端の最高 / ボトム = 実体下端の最安。接触開始から検知足まで)

type LtH
    int    piv
    float  wave               // 最初の波の最低値幅
    float  buf                // 接近許容幅 (基準帯 = P ± buf)
    float  dist               // 接触間の最低離れ幅
    int    gapN               // 接触開始足どうしの最低間隔
    float  bodyMin            // 反転足の最低実体幅
    float  ratio              // 反転足の最低実体比率 (0〜1)
    int    wait               // 反転待ち
    int    maxN               // 最大監視本数
    bool   dirOn              // 最初の山・谷の方向フィルター (新しい基準の登録候補だけ)
    bool   sepOn              // 最低離れ幅フィルター (OFF なら離れ幅を採用条件から外す)
    array<float> bu           // 直近 (2N + 1) 本の実体上端・実体下端・高値・安値・time
    array<float> bd
    array<float> hh
    array<float> ll
    array<int>   ts
    array<LtB1>  bases
    int    seq      = 0       // ID (確定した Pivot 候補ごとに消費)
    int    prevT
    int    sSide    = 0       // 参照系列 (山・谷が交互) の最後の要素: 種類 (-1 山 / 1 谷 / 0 なし)・価格
    float  sP
    int    aSide    = 0       // その直前の要素 (反対側)
    float  aP
    int    pSide    = 0       // 方向フィルターの比較対象 = 系列で最後の要素の直前の同種 (種類が切り替わる時に更新前の aSide / aP から保存。
    float  pP                 //   同種の極値更新中は維持する)

ltNew1(int piv, float wave, float buf, float dist, int gapN, float bodyMin, float ratio, int wait, int maxN, bool dirOn, bool sepOn) =>
    LtH.new(piv, wave, buf, dist, gapN, bodyMin, ratio, wait, maxN, dirOn, sepOn, array.new_float(), array.new_float(), array.new_float(),
         array.new_float(), array.new_int(), array.new<LtB1>())

ltAdd(string s, string ch) =>
    str.contains(s, ch) ? s : s + ch

ltAddAll(string s, string w) =>
    string out = s
    int n = str.length(w)
    if n > 0
        for i = 0 to n - 1
            out := ltAdd(out, str.substring(w, i, i + 1))
    out

ltEvB1(LtB1 g, string ty) =>
    ";" + ty + "," + str.tostring(g.id) + "," + str.tostring(g.side) + "," + str.tostring(g.lvl, "#.########") + "," +
         str.tostring(g.pvT) + "," + str.tostring(g.cfT) + "," + str.tostring(g.cfTc)

ltEvS1(LtB1 g, string ty) =>
    ltEvB1(g, ty) + "," + str.tostring(g.cnt) + "," + str.tostring(g.stT) + "," + str.tostring(g.stTc) + "," + str.tostring(g.stP, "#.########")

// 反転足の条件 (すべて満たせば ""、満たさない理由を返す)。トップ = 陰線・実体上端が帯内 / ボトム = 陽線・実体下端が帯内
ltRevWhy(LtH S, bool top, float P, float o, float h, float l, float c) =>
    string w = ""
    float edge = top ? math.max(o, c) : math.min(o, c)
    if edge < P - S.buf - ZG_EPS or edge > P + S.buf + ZG_EPS
        w += "Z"
    if top ? not (c < o) : not (c > o)
        w += "C"
    float body = math.abs(c - o)
    if body < S.bodyMin - ZG_EPS
        w += "B"
    float rng = h - l
    if rng <= 0 or body < rng * S.ratio - ZG_EPS
        w += "R"
    w

// 確定した Pivot 候補 1 個: 参照系列の更新 → 最初の波の値幅 → Pivot 確定までの接触履歴 → 登録
ltCand1(LtH S, int side, float P, int pvT, int t, int tc, int bi) =>
    string ev = ""
    int N = S.piv
    S.seq += 1
    // 参照系列: 同じ種類が続けば、山はより高い (同値は後の足)・谷はより低いものに更新。更新しない同種 Pivot は追加しない
    bool adopt = false
    if S.sSide == side
        if side == -1 ? P >= S.sP : P <= S.sP
            S.sP := P
            adopt := true
    else
        // 種類の切り替え: 更新前の aSide / aP (= 今回と同種の直前の要素) を方向フィルターの比較対象に保存
        S.pSide := S.aSide
        S.pP    := S.aP
        S.aSide := S.sSide
        S.aP    := S.sP
        S.sSide := side
        S.sP    := P
        adopt   := true
    // 最初の波: 直前の反対側 Pivot だけを見る (無ければ作らない。さらに古い Pivot へ探し直さない)
    if adopt and S.aSide == -side and S.maxN >= N
        bool waveOk = side == -1 ? P - S.aP >= S.wave - ZG_EPS : S.aP - P >= S.wave - ZG_EPS
        // 最初の山・谷の方向フィルター (ON のときだけ): トップ = P > 前の山 + ZG_EPS / ボトム = P < 前の谷 − ZG_EPS。前の同種が無ければ登録しない
        bool dirOk = not S.dirOn or (S.pSide == side and (side == -1 ? P > S.pP + ZG_EPS : P < S.pP - ZG_EPS))
        if waveOk and dirOk
            // Pivot 足 (1 回目の接触開始) から登録足までの右側 N 本の接触履歴。離れてから再び接触していれば採用しない
            bool  inC    = true
            bool  second = false
            int   sepN   = 0
            float sepX   = na
            for j = N + 1 to 2 * N
                bool ct = array.get(S.hh, j) >= P - S.buf - ZG_EPS and array.get(S.ll, j) <= P + S.buf + ZG_EPS
                if ct
                    if not inC
                        second := true
                    inC := true
                else
                    inC := false
                    sepN += 1
                    float x = side == -1 ? array.get(S.bd, j) : array.get(S.bu, j)
                    sepX := na(sepX) ? x : side == -1 ? math.min(sepX, x) : math.max(sepX, x)
            if not second
                LtB1 g = LtB1.new(S.seq, side, P, pvT, t, tc, bi, bi - N, inC = inC, lastSt = bi - N, sepN = sepN, sepX = sepX)
                array.push(S.bases, g)
                ev += ltEvB1(g, "R")
    ev

// 1時間足 1 本 (確定 OHLC) の処理。返り値の形は ltStep と同じ (ブロック + イベント)
//   C (接触開始: 回数・開始足・high / low・シグナル対象 0/1・理由) / D (検知) / Y (シグナル対象の接触が未検知で終了: 理由) /
//   V,id,待機中,理由 (終値無効化) / T,id,待機中,理由 (監視期限) / R (登録) / E (終了)
ltStep1(LtH S, float o, float h, float l, float c, int t, int tc, int bi) =>
    string ev = ""
    float bu = math.max(o, c)
    float bd = math.min(o, c)
    int N = S.piv
    int W = 2 * N + 1
    array.push(S.bu, bu)
    array.push(S.bd, bd)
    array.push(S.hh, h)
    array.push(S.ll, l)
    array.push(S.ts, t)
    if array.size(S.bu) > W
        array.shift(S.bu)
        array.shift(S.bd)
        array.shift(S.hh)
        array.shift(S.ll)
        array.shift(S.ts)
    // 実体 Pivot (左側は同値可・右側は厳密)。右側 N 本目のこの足で確定。
    //   LTB-8: 同じ足が山と谷の両方なら、その足は参照系列に採用せず基準も作らない (系列は変えない。ID は山・谷それぞれ消費する)
    if array.size(S.bu) == W
        float mh = array.get(S.bu, N)
        float ml = array.get(S.bd, N)
        bool isH = true
        bool isL = true
        for j = 0 to W - 1
            if j < N
                isH := isH and mh >= array.get(S.bu, j)
                isL := isL and ml <= array.get(S.bd, j)
            if j > N
                isH := isH and mh > array.get(S.bu, j)
                isL := isL and ml < array.get(S.bd, j)
        int pvT = array.get(S.ts, N)
        if isH and isL
            S.seq += 2
        else
            if isH
                ev += ltCand1(S, -1, mh, pvT, t, tc, bi)
            if isL
                ev += ltCand1(S, 1, ml, pvT, t, tc, bi)
    // 各基準 (新しい基準から): ⓪ 監視期限 → ① 終値無効化 → ② 接触・反転。登録した足は飛ばす
    int ng = array.size(S.bases)
    if ng > 0
        for i = ng - 1 to 0
            LtB1 g = array.get(S.bases, i)
            if g.aBar < bi
                bool  top = g.side == -1
                float P   = g.lvl
                bool  fin = false
                if bi - g.pvBar > S.maxN
                    fin := true
                    ev += ";T," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "T")
                else if top ? c > P + S.buf + ZG_EPS : c < P - S.buf - ZG_EPS
                    fin := true
                    ev += ";V," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "V")
                else
                    // 接触 = high ≥ P − buf かつ low ≤ P + buf (ヒゲを含む)。接触していない足 = 帯から離れた足
                    bool ct = h >= P - S.buf - ZG_EPS and l <= P + S.buf + ZG_EPS
                    if ct
                        if not g.inC
                            // 新しい接触の開始: 回数を数え、シグナル対象かを開始時に固定 (間隔・離れ幅。不採用でも回数は消費する)
                            g.cnt += 1
                            g.inC := true
                            string why = ""
                            bool gapOk = bi - g.lastSt >= S.gapN
                            bool sepOk = not S.sepOn or (g.sepN > 0 and (top ? P - g.sepX >= S.dist - ZG_EPS : g.sepX - P >= S.dist - ZG_EPS))
                            if not gapOk
                                why += "G"
                            if not sepOk
                                why += "S"
                            g.elig    := gapOk and sepOk and g.cnt <= 3
                            g.why     := why
                            g.lastSt  := bi
                            g.stBar   := bi
                            g.stT     := t
                            g.stTc    := tc
                            g.stP     := top ? h : l
                            g.sepN    := 0
                            g.sepX    := na
                            g.waiting := g.elig
                            g.waitEnd := bi + S.wait
                            ev += ltEvS1(g, "C") + "," + (g.elig ? "1" : "0") + "," + why
                            if not g.elig and g.cnt >= 3
                                fin := true
                        // 【ZG 追加】2 回目以後の接触群の実体極値 (検知の判定には使わない)
                        if g.cnt >= 2
                            g.gx := na(g.gx) ? (top ? bu : bd) : top ? math.max(g.gx, bu) : math.min(g.gx, bd)
                        // 反転待ち (接触開始足 = 0 本目〜反転待ちの本数目。接触が続いている足だけ)
                        if g.waiting
                            string fw = ltRevWhy(S, top, P, o, h, l, c)
                            if fw == ""
                                g.waiting := false
                                ev += ltEvS1(g, "D") + "," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(bi - g.stBar) + "," +
                                     str.tostring(bu, "#.########") + "," + str.tostring(bd, "#.########") + "," +
                                     str.tostring(top ? math.max(P, g.gx) : math.min(P, g.gx), "#.########")     // 【ZG 追加】Zone の基準価格
                                if g.cnt >= 3
                                    fin := true
                            else
                                g.why := ltAddAll(g.why, fw)
                                if bi >= g.waitEnd
                                    g.waiting := false
                                    g.why := ltAdd(g.why, "W")
                                    ev += ";Y," + str.tostring(g.id) + "," + g.why
                                    if g.cnt >= 3
                                        fin := true
                    else
                        // 帯から離れた足: 接触の終了 (待機中ならその接触の待機も終了) と、離れ幅の記録 (実体)
                        if g.inC
                            g.inC := false
                            if g.waiting
                                g.waiting := false
                                g.why := ltAdd(g.why, "E")
                                ev += ";Y," + str.tostring(g.id) + "," + g.why
                                if g.cnt >= 3
                                    fin := true
                        g.sepN += 1
                        float x = top ? bd : bu
                        g.sepX := na(g.sepX) ? x : top ? math.min(g.sepX, x) : math.max(g.sepX, x)
                if fin
                    array.remove(S.bases, i)
                    ev += ";E," + str.tostring(g.id)
    string hd = "B," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(S.prevT) + "," + str.tostring(array.size(S.bases)) +
         "," + str.tostring(bi)
    S.prevT := t
    hd + ev
// ==== ZG LTB copy (end) =====================================================

f_zgCore(int k, bool on) =>
    var LtH S = k == 0 ? ltNew1(zgPiv1, zgWave1, zgBuf1, zgDist1, zgGap1, zgBody1, zgRatio1 / 100.0, zgWait1, zgMax1, zgDir1, zgSep1) :
         k == 1 ? ltNew1(zgPiv4, zgWave4, zgBuf4, zgDist4, zgGap4, zgBody4, zgRatio4 / 100.0, zgWait4, zgMax4, zgDir4, zgSep4) :
         ltNew1(zgPivD, zgWaveD, zgBufD, zgDistD, zgGapD, zgBodyD, zgRatioD / 100.0, zgWaitD, zgMaxD, zgDirD, zgSepD)
    var string prevBlk = ""
    string blk = on ? ltStep1(S, open, high, low, close, time, time_close, bar_index) : ""
    string out = prevBlk == "" ? blk : prevBlk + ";" + blk
    prevBlk := blk
    out[1]
string zgPk1 = request.security(syminfo.tickerid, "60",  f_zgCore(0, zgUse1), lookahead = barmerge.lookahead_on)
string zgPk4 = request.security(syminfo.tickerid, "240", f_zgCore(1, zgUse4), lookahead = barmerge.lookahead_on)
string zgPkD = request.security(syminfo.tickerid, "D",   f_zgCore(2, zgUseD), lookahead = barmerge.lookahead_on)

// 標準 (通常ローソク足) の 5分チャートでだけ集計する
bool hlRun = timeframe.isminutes and timeframe.multiplier == 5 and chart.is_standard

// ==== ZCR Logic (begin) ======================================================
//  この区間は tests/zcr_sim.py が Python に機械変換して実行する (履歴参照 x[1] を使わない・na との算術 / 比較をしない)。
//  価格はすべて syminfo.mintick 単位の整数 (ティック)。時刻は ms。
//  Zone の型・登録ブロック・根拠 ID ごとの索引 (f_lbAdd / f_lbRemoveS) と、ペアの候補・接触・離脱の関数 (f_zsOk / f_zsFvgSide / f_zsBetter /
//  f_zsTouch / f_zsContact ほか) は ZoneConfluenceStrategyXAU.pine (ZCS) の写し (byte 一致。テストが照合。ZCS のそれらは ZCR-9 の写し)。
//  ZCS と違うのは: (1) 全 325 ペア × 2 方向が対象 (ペア・方向ごとに独立)。(2) 武装した帯 (ZCS の指値の帯) を足 k の終わりに置く代わりに、
//  足 k+1 の処理の始めに同じ Zone (足 k の処理の後のまま)・同じ終値 (足 k) で求める (f_zrBest = ZCS の f_zsBest に「足 k+1 の安値 / 高値に
//  届く候補だけ」の条件を足したもの。届くなら選ばれる帯は f_zsBest と同じ。テストが照合)。(3) 注文の代わりに新規接触を記録し、
//  ZCR-9 の帯端起点の先着判定で値幅ごとに反応を測る。
// Zone 1 個。先頭 12 項目と inv / dead / zgUse / zgShow は Lab の LbZone と同じ並び・意味
type LbZone
    int   id
    int   typ                 // 0 ZA / 1 ZB / 2 ZC / 3 ZD / 4 ZF / 5 ZE / 6 ZG (Lab と同じ番号)
    int   tf
    int   sub                 // ZA 1 上辺 / -1 下辺、ZC 1 高値 / -1 安値、ZF 1 上昇 FVG / -1 下降 FVG、ZE 波の方向、ZG 1 トップ / -1 ボトム、他 0
    float ctr
    float bot
    float top
    float infoA               // ZE: 比率 / ZG: 回数 (2 ダブル / 3 トリプル) / ZD: 区画下限 / ZA: 下辺
    float infoB               // ZG: 検知足の bar_index / ZE: 更新確定時刻 / ZD: 区画上限 / ZA: 上辺
    int   key
    int   aBar                // 登録した 5分足 (次の足から接触)
    int   aTime
    bool  inv      = false    // ZF: iFVG
    bool  dead     = false
    bool  zgUse    = true
    bool  zgShow   = true
    int   gid      = 0        // 登録時の根拠 ID (ZF は FVG の ID 15..18。タッチ時点の根拠 ID は f_zcGid)
    int   lv       = 0        // ZE: 水準の番号 0..3 (0.236 / 0.382 / 0.5 / 0.618)
    int   tb       = na       // 帯の下端 (ティック)
    int   tt       = na       // 帯の上端 (ティック)
    bool  isOn     = false    // 接触中
    int   outT     = na       // 帯の完全に外側が続いている最初の足の time (na = 外側でない / 不明)

// 形成中の Accum (Lab の LbAcc と同じ)
type LbAcc
    int   tf
    int   aid
    float up
    float lo

// 根拠 ID ごとの価格順の索引 (登録時の根拠 ID 0..21 = LbZone.gid。iFVG は FVG と同じ索引で、状態は f_zcGid で見る。3 / 4 = ZB は毎足作り直す)
type ZsIdx
    array<int>    bot          // 帯の下端 (ティック)。同値は登録順
    array<LbZone> z
    int           maxW = 0     // 入れた帯の幅の最大 (ティック)

// ペア・方向 1 個 (650 個。ZCS の ZsPd から注文の項目を除き、番号と作業用の印を足したもの)
type ZsPd
    int    a                   // 根拠 ID (a < b)
    int    b
    int    d                   // 1 LONG / -1 SHORT
    int    pi                  // ペア・方向の番号 = ペア番号 * 2 + (LONG 0 / SHORT 1)。ペア番号 = ZC_GN 順の a < b の辞書順 0..324 (ZCS の pL### / pS### と同じ)
    bool   on    = false       // 接触中 (新規接触・候補帯に触れた足から、離脱するまで)
    int    hb    = na          // 接触の帯 (離脱判定に使う。最後に触れた候補帯の範囲。ティック)
    int    ht    = na
    int    outT  = na          // 接触の帯の完全に外側が続いている最初の足の time (na = 外側でない)
    array<LbZone> ka           // 最後に触れた候補 (Zone の組)。同じ組が残っていれば、その今の共通区間へ接触の帯を引き継ぐ
    array<LbZone> kb
    int    cL    = na          // 作業: 候補の探索結果 (武装した帯の下端・上端と Zone の組)
    int    cT    = na
    LbZone ca
    LbZone cb
    int    fb    = -1          // 新規接触の足の bar_index
    int    mk    = -1          // 作業: この足で接触・離脱を判定するものに付ける印 (bar_index)

// 新規接触 1 件 = 記録 1 件 (採用した値幅が全部決着するまで追跡)
type ZcObs
    int id             // 記録番号 (1 から。新規接触の順)
    int pi             // ペア・方向の番号
    int d              // 1 LONG / -1 SHORT
    int t0             // タッチ足 (新規接触の足) の time_close
    int p0             // 起点 = 武装した帯の LONG 上端 / SHORT 下端 (ティック。発生時に固定)
    int cT             // 武装した帯 (ペアの共通帯 = 2 つの Zone の帯そのものの共通区間) の上限・下限 (ティック)
    int cL
    int za             // 構成 Zone (根拠 a / 根拠 b) の Zone ID と登録時刻 (登録した 5分足の time)
    int zb
    int zta
    int ztb
    array<int> fSt     // 値幅ごと: 0 追跡中 / 1 反発先 / 2 逆行先 / 3 順序不明 / 4 計測不能 (不正足) / 5 追跡中の上限で打ち切り / 9 見送り
    array<int> fTc     // 決着した足の time_close (追跡中・見送りは na。タッチ足で決着したら T0)
    array<int> tbJ     // タッチ足の判定 (ZCR-9 の帯端起点と同じ): 0 なし / 1 終値で反発確認 / 2 逆行到達 / 3 両側 / 4 未確認の反発の可能性 /
                       //  5 逆行到達 + 未確認の反発の可能性 (見送りの値幅も事実として記入)
    int flags = 0      // 1 / 2 / 4 = $5 / $10 / $15: タッチ足の判定 4 が残り、後で逆行先に決まったので推測で逆行先にせず順序不明にした

type ZcRec
    array<float> v

type ZcSt
    int   zSeq     = 0
    int   nAccOut  = 0       // 採用箱数から外れた Accum の辺
    int   nIfvg    = 0       // FVG → iFVG
    int   nFvgDead = 0       // iFVG の再突破で無効
    int   ma1N     = 0       // 1分 EMA の有効値を受け取った有効足の本数 (ZB-1m の助走)
    int   nBars    = 0       // 確定 5分足の本数
    int   nBad     = 0       // 不正足
    bool  live     = false   // 直前の確定足の終わりに武装できた (不正足でない・集計開始日時以後・助走の後。ZCS の発注できる足と同じ)
    int   pC       = na      // 直前の確定足の終値 (ティック)
    int   oSeq     = 0       // 新規接触 (= 記録) の数
    int   nDone    = 0       // 確定して出力待ちへ入れた記録
    int   nOut     = 0       // plot へ出力した記録
    int   nCut     = 0       // 追跡中の上限で打ち切った記録
    int   nTbR     = 0       // タッチ足で決着した値幅 (採用分): 反発先 / 逆行先 / 順序不明
    int   nTbA     = 0
    int   nTbU     = 0
    int   nTbMay   = 0       // 未確認の反発の可能性があり、後で逆行先に決まったので順序不明にした値幅
    int   nOn      = 0       // この足の終わりに接触中のペア・方向
    int   maxNew   = 0       // 1 足の新規接触の最大
    int   maxQ     = 0       // 出力待ちの最大 (この足の出力の後)
    int   nWork    = 0       // 探索の作業量 (f_zrBest / f_zsContact を呼んだペア・方向の数、累計。性能の目安)
    int   firstT   = na
    int   lastT    = na

array<string> ZC_GN = array.from("ZA-1H", "ZA-4H", "ZA-D", "ZB-1m", "ZB-5m", "ZC-1H", "ZC-4H", "ZC-D", "ZC-W", "ZD-1H", "ZD-4H", "ZD-D", "ZD-W",
     "ZE-4H", "ZE-D", "ZF-FVG-1H", "ZF-FVG-4H", "ZF-FVG-D", "ZF-FVG-W", "ZG-1H", "ZG-4H", "ZG-D", "ZF-iFVG-1H", "ZF-iFVG-4H", "ZF-iFVG-D", "ZF-iFVG-W")
float EPS        = 1e-7
bool  dsZone     = false
int   ZC_M1      = 60000
int   ZR_NI      = 9          // 集計の項目: 0 新規接触 / 1 採用 / 2 見送り / 3 反発先 / 4 逆行先 / 5 順序不明 / 6 計測不能 / 7 打切り / 8 追跡中
int   ZR_NF      = 15         // 記録の列数 (並び・単位は仕様書の表)
int   ZR_K       = 4          // 1 足に出す記録の数 (plot 15 × 4 = 60 本)
int   ZC_MAXPEND = 2000       // 追跡中の記録の上限 (超えたら古い順に未決着の値幅を打ち切り。値幅ごとに同時 1 件なので通常は 1,950 以下)

var ZcSt st = ZcSt.new()
var array<ZsIdx>  zsIx       = array.new<ZsIdx>()
var array<ZsPd>   zsPd       = array.new<ZsPd>()        // 650 個。添字 = ペア・方向の番号
var array<LbZone> zsTa       = array.new<LbZone>()      // 作業: この足で触れた候補 (Zone の組)
var array<LbZone> zsTb       = array.new<LbZone>()
var array<int>    zrOnL      = array.new_int(0)         // 接触中のペア・方向の番号 (この足の終わり)
var array<int>    zrBusy     = array.new_int(1950, 0)   // (番号 * 3 + 値幅) ごと: 1 = その値幅の観測が未決着 (追跡中)
var array<int>    zrCnt      = array.new_int(17550, 0)  // ((番号 * 3 + 値幅) * ZR_NI + 項目) の件数
var array<int>    zrNewHist  = array.new_int(11, 0)     // 1 足の新規接触の件数 (0..9 / 10 以上) の度数
var array<ZcObs>  zcPend     = array.new<ZcObs>()       // 追跡中の記録 (採用した値幅に未決着がある)
var array<ZcRec>  zcQ        = array.new<ZcRec>()       // 確定して未出力の記録 (FIFO)
var array<LbZone> zcMa       = array.new<LbZone>()      // ZB の 2 Zone (1分 EMA / 5分 EMA。帯は足ごとに置き直す)
var array<bool>   zcMaOk     = array.new_bool(2, false) // ZB の帯が有効
var array<LbZone> zcSwZ      = array.new<LbZone>()      // 水平線 (保持本数を使うときだけ。登録順)
var array<LbZone> lbAccZ     = array.new<LbZone>()      // 採用中の Accum の上辺・下辺 (登録順)
var array<LbAcc>  lbAccs     = array.new<LbAcc>()       // 形成中の Accum
var array<int>    lbAccLast  = array.new_int(3, na)
var array<int>    lbPivLastH = array.new_int(4, na)
var array<int>    lbPivLastL = array.new_int(4, na)
var array<float>  lbPocLast  = array.new_float(4, na)
var array<LbZone> lbPocCur   = array.new<LbZone>(4, na)
var array<int>    lbZdStat   = array.new_int(4, 0)      // 0 OFF / 1 正常 / 2 計算不能 / 3 履歴不足 / 8 OFF (時刻 0) / 9 異常
var array<LbZone> lbFvgs     = array.new<LbZone>()      // ZF (FVG / iFVG)
var array<int>    lbFvgLast  = array.new_int(4, na)
var array<int>    lbZeStat   = array.new_int(2, 0)      // 0 OFF / 1 有効な波 / 2 波なし / 3 保留中 / 8 外部側 OFF / 9 未接続・誤接続
var array<float>  lbZeLast   = array.new_float(10, na)
var array<LbZone> lbZeZ      = array.new<LbZone>()
var array<LbZone> lbZgZ      = array.new<LbZone>()
var array<int>    lbZgUsed   = array.new_int()
var array<int>    lbZgLast   = array.new_int(3, na)
var array<int>    lbDeadNow  = array.new_int()
var array<int>    zcNZone    = array.new_int(26, 0)     // 根拠 ID ごとの登録本数 (ZB は 0。ZF は FVG の ID 15..18 に数える)
var array<int>    zcMaUnk    = array.new_int(2, 0)      // MA が不明だった有効足 (系列ごと)
var array<int>    zcZeBad    = array.new_int(2, 0)      // ZE が未接続・誤接続 (状態 9) だった確定足 (時間足ごと)
var array<int>    zcZdBad    = array.new_int(4, 0)      // ZD が正常でなかった確定足 (時間足ごと)

// この足の出力・作業 (毎足作り直す)
array<float> zcOut  = array.new_float(60, na)           // この足で出力する記録 (ZR_K 件 × ZR_NF 列。なければ na)
array<int>   zrG    = array.new_int(0)                  // 作業: この足で条件を満たす Zone を持つ根拠 ID
array<int>   zrNp   = array.new_int(0)                  // 作業: この足で新規接触したペア・方向の番号
array<ZcObs> zrNw   = array.new<ZcObs>()                // 作業: この足で作った、追跡が続く記録 (古い記録の更新の後で追跡中へ入れる)
array<int>   zcEvT  = array.new_int(0)                  // この足の新規接触 (描画用): T0 / 帯の上端 / 下端 / 方向
array<int>   zcEvTop = array.new_int(0)
array<int>   zcEvBot = array.new_int(0)
array<int>   zcEvD  = array.new_int(0)
// 閾値 (ティック。値幅が指定幅以上になる最初のティック)
f_zcTicks(float usd) =>
    math.max(1, math.ceil(usd / syminfo.mintick - 1e-9))
array<int> zcWT    = array.from(f_zcTicks(5.0), f_zcTicks(10.0), f_zcTicks(15.0))
int        zcDepT  = f_zcTicks(zcDepW)
int        zcDepMs = zcDepMin * ZC_M1

f_zaUse(int k) =>
    k == 0 ? zaUse1 : k == 1 ? zaUse2 : zaUse3

f_zaKeep(int k) =>
    k == 0 ? zaKeep1 : k == 1 ? zaKeep2 : zaKeep3

f_zbUse(int k) =>
    k == 0 ? zbUse1 : zbUse2

f_zcUse(int k) =>
    k == 0 ? zcUse1 : k == 1 ? zcUse2 : k == 2 ? zcUse3 : zcUse4

f_zdUse(int k) =>
    k == 0 ? zdUse1 : k == 1 ? zdUse2 : k == 2 ? zdUse3 : zdUse4

// ==== LAB copy use (begin) — ZoneComboLabXAU.pine と同一 ====
f_zfUse(int k) =>
    k == 0 ? zfUse1 : k == 1 ? zfUse2 : k == 2 ? zfUse3 : zfUse4

f_zgUse(int k) =>
    k == 0 ? zgUse1 : k == 1 ? zgUse4 : zgUseD

f_zgExpOn(int k) =>
    k == 0 ? zgExp1 : k == 1 ? zgExp4 : zgExpD

f_zgExpN(int k) =>
    k == 0 ? zgExpN1 : k == 1 ? zgExpN4 : zgExpND

f_zeUse(int k) =>
    zeUse and (k == 0 ? zeUse4 : zeUseD)

// ==== LAB copy use (end) ====

// この集計に「表示だけ」の ZG は無い (Lab の f_zgShow の位置)
f_zgShow(int k) =>
    false

// ==== LAB copy zgParse (begin) — ZoneComboLabXAU.pine と同一 ====
f_zgParse(string pk, int lastT, int tcNow) =>
    array<float> out = array.new_float()
    int lt = lastT
    if not na(pk) and pk != ""
        array<string> evs = str.split(pk, ";")
        bool take = false
        float cbi = na
        for i = 0 to array.size(evs) - 1
            string e = array.get(evs, i)
            if e != ""
                array<string> f = str.split(e, ",")
                string ty = array.get(f, 0)
                if ty == "B"
                    int sT = int(str.tonumber(array.get(f, 1)))
                    int sC = int(str.tonumber(array.get(f, 2)))
                    take := not na(sT) and (na(lt) or sT > lt) and not na(sC) and sC <= tcNow
                    if take
                        lt  := sT
                        cbi := str.tonumber(array.get(f, 5))
                        array.push(out, 0)
                        array.push(out, cbi)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                else if take and ty == "D" and array.size(f) > 16
                    array.push(out, 1)
                    array.push(out, cbi)
                    array.push(out, str.tonumber(array.get(f, 1)))
                    array.push(out, str.tonumber(array.get(f, 2)))
                    array.push(out, str.tonumber(array.get(f, 7)))
                    array.push(out, str.tonumber(array.get(f, 16)))
    [lt, out]

// ==== LAB copy zgParse (end) ====

f_inc(array<int> a, int ix, int v) =>
    array.set(a, ix, array.get(a, ix) + v)
    true

// Lab の表示用の呼び出しを受けるだけ (何もしない)
f_dsDel(LbZone z, bool b) =>
    true

f_dsRename(LbZone z) =>
    true

f_dsAdd(LbZone z) =>
    true

// 索引 ix の中で下端が v 以上の最初の位置 / v より大きい最初の位置 (ZCR の f_zcLower / f_zcUpper と同じ二分探索)
f_zsLower(ZsIdx ix, int v) =>
    int lo = 0
    int hi = array.size(ix.bot)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(ix.bot, mid) < v
            lo := mid + 1
        else
            hi := mid
    lo

f_zsUpper(ZsIdx ix, int v) =>
    int lo = 0
    int hi = array.size(ix.bot)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(ix.bot, mid) <= v
            lo := mid + 1
        else
            hi := mid
    lo

// Zone を対象に入れる (ZCR の f_lbAdd の位置。根拠 ID・ZE の水準・帯のティック (下端・上端を別々に丸める) は ZCR と同じ式)。
//  索引は登録時の根拠 ID ごと。ZCR の「接触中の引き継ぎ」は持たない (接触はペア・方向ごとに f_zsContact で持つ)
f_lbAdd(LbZone z) =>
    z.gid := z.typ == 0 ? z.tf : z.typ == 2 ? 5 + z.tf : z.typ == 3 ? 9 + z.tf : z.typ == 5 ? 13 + z.tf : z.typ == 4 ? 15 + z.tf : 19 + z.tf
    if z.typ == 5
        z.lv := z.infoA == 0.236 ? 0 : z.infoA == 0.382 ? 1 : z.infoA == 0.5 ? 2 : 3
    z.tb := math.round(z.bot / syminfo.mintick)
    z.tt := math.round(z.top / syminfo.mintick)
    ZsIdx ix = array.get(zsIx, z.gid)
    ix.maxW := math.max(ix.maxW, z.tt - z.tb)
    int pos = f_zsUpper(ix, z.tb)
    array.insert(ix.bot, pos, z.tb)
    array.insert(ix.z, pos, z)
    f_inc(zcNZone, z.gid, 1)
    if z.typ == 4
        array.push(lbFvgs, z)
    true

// Zone を外す (ZCR の f_lbRemoveS の位置)。索引から除く
f_lbRemoveS(LbZone z) =>
    ZsIdx ix = array.get(zsIx, z.gid)
    int pos = f_zsLower(ix, z.tb)
    bool fnd = false
    while not fnd and pos < array.size(ix.z)
        LbZone q = array.get(ix.z, pos)
        if q.id == z.id
            fnd := true
        else
            pos += 1
    if fnd
        array.remove(ix.bot, pos)
        array.remove(ix.z, pos)
    true

// FVG を外す (Lab の f_lbRemove の位置)
f_lbRemove(LbZone z) =>
    int fi = 0
    bool ff = false
    while not ff and fi < array.size(lbFvgs)
        LbZone q = array.get(lbFvgs, fi)
        if q.id == z.id
            ff := true
        else
            fi += 1
    if ff
        array.remove(lbFvgs, fi)
    f_lbRemoveS(z)

// ==== LAB copy funcs (begin) — ZoneComboLabXAU.pine と同一 ====
f_lbNew(int typ, int tf, int sub, float ctr, float bot, float top, float a, float b, int key) =>
    st.zSeq += 1
    LbZone z = LbZone.new(st.zSeq, typ, tf, sub, ctr, bot, top, a, b, key, bar_index, time)
    z

f_zgKill(int i) =>
    LbZone z = array.remove(lbZgZ, i)
    if z.zgUse
        f_lbRemoveS(z)
        array.push(lbDeadNow, z.id)
    if dsZone and z.zgShow
        f_dsDel(z, false)
    z.dead := true
    true

f_zeClear(int k) =>
    int n = array.size(lbZeZ)
    if n > 0
        for i = n - 1 to 0
            LbZone z = array.get(lbZeZ, i)
            if z.tf == k
                array.remove(lbZeZ, i)
                f_lbRemoveS(z)
                if dsZone
                    f_dsDel(z, false)
                z.dead := true
                array.push(lbDeadNow, z.id)
    true

f_zeSet(int k, float o, float e, float d, float id, float t) =>
    array<float> rs = array.from(0.236, 0.382, 0.5, 0.618)
    for j = 0 to 3
        float r = array.get(rs, j)
        float p = e + r * (o - e)
        LbZone z = f_lbNew(5, k, int(d), p, p - zHalf, p + zHalf, r, t, int(id))
        f_lbAdd(z)
        array.push(lbZeZ, z)
    int b = k * 5
    array.set(lbZeLast, b, o)
    array.set(lbZeLast, b + 1, e)
    array.set(lbZeLast, b + 2, d)
    array.set(lbZeLast, b + 3, id)
    array.set(lbZeLast, b + 4, 1)
    true

f_zeSame(int k, float o, float e, float d, float id) =>
    int b = k * 5
    array.get(lbZeLast, b + 4) == 1 and array.get(lbZeLast, b) == o and array.get(lbZeLast, b + 1) == e and array.get(lbZeLast, b + 2) == d
         and array.get(lbZeLast, b + 3) == id

f_lbAccFix(LbAcc q) =>
    LbZone zu = f_lbNew(0, q.tf, 1, q.up, q.up - zHalf, q.up + zHalf, q.lo, q.up, q.aid)
    LbZone zl = f_lbNew(0, q.tf, -1, q.lo, q.lo - zHalf, q.lo + zHalf, q.lo, q.up, q.aid)
    f_lbAdd(zu)
    f_lbAdd(zl)
    array.push(lbAccZ, zu)
    array.push(lbAccZ, zl)
    int nk = 0
    for i = 0 to array.size(lbAccZ) - 1
        LbZone qz = array.get(lbAccZ, i)
        if qz.tf == q.tf
            nk += 1
    while nk > 2 * f_zaKeep(q.tf)
        int oi = 0
        bool fnd = false
        while not fnd
            LbZone qz = array.get(lbAccZ, oi)
            if qz.tf == q.tf
                fnd := true
            else
                oi += 1
        LbZone zo = array.remove(lbAccZ, oi)
        f_lbRemoveS(zo)
        if dsZone
            f_dsDel(zo, false)
        zo.dead := true
        array.push(lbDeadNow, zo.id)
        st.nAccOut += 1
        nk -= 1
    true

// ==== LAB copy funcs (end) ====

// 水平線を 1 本登録する (Lab の f_swAdd の位置。Lab の統合はしない。線ごとに個別の帯 = 価格 ± 共通幅)。
//  保持本数 > 0 のときだけ、その時間足の古い線を外す
f_swAdd(int k, int sub, float pv, int pt) =>
    LbZone z = f_lbNew(2, k, sub, pv, pv - zHalf, pv + zHalf, na, na, pt)
    f_lbAdd(z)
    if zcMax > 0
        array.push(zcSwZ, z)
        int nk = 0
        for i = 0 to array.size(zcSwZ) - 1
            LbZone qz = array.get(zcSwZ, i)
            if qz.tf == k
                nk += 1
        while nk > zcMax
            int oi = 0
            bool fnd = false
            while not fnd
                LbZone qz = array.get(zcSwZ, oi)
                if qz.tf == k
                    fnd := true
                else
                    oi += 1
            LbZone zo = array.remove(zcSwZ, oi)
            f_lbRemoveS(zo)
            zo.dead := true
            nk -= 1
    true

// ZB の帯をこの足用に置き直す (v = 直前の足が確定した時点の EMA。na = 不明)
f_zcMaSet(int k, bool use, float v) =>
    LbZone mz = array.get(zcMa, k)
    if use and not na(v)
        mz.ctr := v
        mz.bot := v - zHalf
        mz.top := v + zHalf
        mz.tb  := math.round(mz.bot / syminfo.mintick)
        mz.tt  := math.round(mz.top / syminfo.mintick)
        array.set(zcMaOk, k, true)
    else
        array.set(zcMaOk, k, false)
        if use
            f_inc(zcMaUnk, k, 1)
    true

// タッチ時点の根拠 ID。ZF は Zone のその時点の状態で FVG (15..18) か iFVG (22..25) のどちらか 1 つ (同じ Zone が両方に数えられることは無い)
f_zcGid(LbZone z) =>
    z.typ == 4 and z.inv ? 22 + z.tf : z.gid

// 根拠 ID g (0..25) の索引
f_zsIxOf(int g) =>
    array.get(zsIx, g >= 22 ? g - 7 : g)

// Zone z が、方向 d のペアの根拠 ID g として使えるか: 有効 (消えていない・ZB は帯が有効)、タッチ時点の根拠 ID が g (ZF は FVG / iFVG の状態で
//  別の ID)、通常 FVG (g = 15..18) は向きが d と同じ (上昇 FVG = LONG だけ / 下降 FVG = SHORT だけ。iFVG と他の種類は条件なし)
f_zsOk(LbZone z, int g, int d) =>
    not z.dead and (z.typ != 1 or array.get(zcMaOk, z.tf)) and f_zcGid(z) == g and (g < 15 or g > 18 or z.sub == d)

// 発注時の通常 FVG の接近条件 (ZCR-9 の K1 と同じ意味: FVG 自身の帯へ LONG は上から・SHORT は下から触れる場合だけ根拠にする)。
//  LONG は確定足の終値 c > その FVG の上端、SHORT は c < 下端 (価格が既に FVG の帯の中なら置かない)。iFVG と他の種類は条件なし
f_zsFvgSide(LbZone z, int g, int d, int c) =>
    g < 15 or g > 18 or (d == 1 ? c > z.tt : c < z.tb)

// ZB の索引をこの足の帯で作り直す (f_zcMaSet の後)
f_zsMaIdx() =>
    for k = 0 to 1
        ZsIdx ix = array.get(zsIx, 3 + k)
        array.clear(ix.bot)
        array.clear(ix.z)
        if array.get(zcMaOk, k)
            LbZone mz = array.get(zcMa, k)
            array.push(ix.bot, mz.tb)
            array.push(ix.z, mz)
            ix.maxW := math.max(ix.maxW, mz.tt - mz.tb)
    true

// 候補 [cl, ct] (Zone の組 za / zb) が今の最良より良いか。LONG: 上端が高い → 下端が高い → Zone の ID が小さい組。
//  SHORT: 下端が低い → 上端が低い → Zone の ID が小さい組 (同じ帯の組の選び方を決めておくだけ。注文の価格は帯で決まる)
f_zsBetter(ZsPd p, bool fnd, int cl, int ct, LbZone za, LbZone zb) =>
    bool r = not fnd
    if fnd
        bool same = ct == p.cT and cl == p.cL
        bool lowId = za.id < p.ca.id or (za.id == p.ca.id and zb.id < p.cb.id)
        if p.d == 1
            r := ct > p.cT or (ct == p.cT and cl > p.cL) or (same and lowId)
        else
            r := cl < p.cL or (cl == p.cL and ct < p.cT) or (same and lowId)
    r

// 確定 5分足 [l, h] に触れた候補 (共通区間が [l, h] と重なる A と B の Zone の組) を zsTa / zsTb へ。戻り値 = 組の数
f_zsTouch(ZsPd p, int h, int l) =>
    array.clear(zsTa)
    array.clear(zsTb)
    ZsIdx ia = f_zsIxOf(p.a)
    ZsIdx ib = f_zsIxOf(p.b)
    int   ma = array.size(ia.z)
    int   mb = array.size(ib.z)
    if ma > 0 and mb > 0
        int k = f_zsLower(ia, l - ia.maxW)
        while k < ma and array.get(ia.bot, k) <= h
            LbZone za = array.get(ia.z, k)
            if za.tt >= l and f_zsOk(za, p.a, p.d)
                int j = f_zsLower(ib, za.tb - ib.maxW)
                while j < mb and array.get(ib.bot, j) <= za.tt
                    LbZone zb = array.get(ib.z, j)
                    if zb.tt >= za.tb and f_zsOk(zb, p.b, p.d)
                        if math.max(za.tb, zb.tb) <= h and math.min(za.tt, zb.tt) >= l
                            array.push(zsTa, za)
                            array.push(zsTb, zb)
                    j += 1
            k += 1
    array.size(zsTa)

// 接触中・離脱 (ペア・方向ごと。ZCR の離脱規則を接触の帯に当てる)。確定 5分足 k の [l, h] と、足 k の間に有効だった候補 (足 k-1 の処理の後の Zone) で判定する。
//  (a) 接触中なら、最後に触れた候補 (Zone の組) のうち今も候補のもの (Zone が有効・FVG の状態と向き・帯が重なる) の今の共通区間へ接触の帯を
//      置き直す (ZB の帯が動く場合は同じ候補として引き継ぐ)。どれも残っていなければ前の帯のまま (消えた候補の場所で再接触を水増ししない)。
//  (b) この足が候補帯のどれかに触れた → 接触中 (外側の計時を消し、接触の帯 = 触れた候補帯の範囲)。
//  (c) 触れていないが接触の帯に掛かっている、または接触の帯の ZB が不明 → 接触中のまま、外側の計時をやり直す。
//  (d) それ以外 (接触の帯の完全に外側): 帯の端からの距離 >= 離脱幅、または外側が続いている最初の足の time からこの足の time_close まで >= 離脱時間 → 離脱。
f_zsContact(ZsPd p, int h, int l) =>
    bool unk = false
    if p.on
        int  nk   = array.size(p.ka)
        bool kept = false
        int  hb   = 0
        int  ht   = 0
        if nk > 0
            for i = 0 to nk - 1
                LbZone za = array.get(p.ka, i)
                LbZone zb = array.get(p.kb, i)
                if (za.typ == 1 and not array.get(zcMaOk, za.tf)) or (zb.typ == 1 and not array.get(zcMaOk, zb.tf))
                    unk := true
                else if f_zsOk(za, p.a, p.d) and f_zsOk(zb, p.b, p.d)
                    int cl = math.max(za.tb, zb.tb)
                    int ct = math.min(za.tt, zb.tt)
                    if cl <= ct
                        hb   := kept ? math.min(hb, cl) : cl
                        ht   := kept ? math.max(ht, ct) : ct
                        kept := true
        if kept
            p.hb := hb
            p.ht := ht
    int n = f_zsTouch(p, h, l)
    if n > 0
        int hb2 = 0
        int ht2 = 0
        for i = 0 to n - 1
            LbZone za = array.get(zsTa, i)
            LbZone zb = array.get(zsTb, i)
            int cl = math.max(za.tb, zb.tb)
            int ct = math.min(za.tt, zb.tt)
            hb2 := i == 0 ? cl : math.min(hb2, cl)
            ht2 := i == 0 ? ct : math.max(ht2, ct)
        p.on   := true
        p.outT := na
        p.hb   := hb2
        p.ht   := ht2
        p.ka   := array.copy(zsTa)
        p.kb   := array.copy(zsTb)
    else if p.on
        if unk or (p.ht >= l and p.hb <= h)
            p.outT := na
        else
            int dist = l > p.ht ? l - p.ht : p.hb - h
            if na(p.outT)
                p.outT := time
            if dist >= zcDepT or time_close - p.outT >= zcDepMs
                p.on   := false
                p.outT := na
    true

// ---- ZCR-10: ペア別の計測 -------------------------------------------------------------------------------------------

// ペア番号 (a < b。ZC_GN 順の辞書順 0..324 = ZCS の pL### / pS### の番号)
f_zrPair(int a, int b) =>
    int(a * (51 - a) / 2) + b - a - 1

// 根拠 ID g に、方向 d のペアの根拠として使える (f_zsOk) Zone で帯が [lo, hi] (ティック) と重なるものがあるか。
//  候補探索の前の絞り込みだけに使う (候補の共通区間が [lo, hi] と重なるなら、その 2 つの Zone はどちらも [lo, hi] と重なる。必要条件)
f_zrHas(int g, int d, int lo, int hi) =>
    ZsIdx ix = f_zsIxOf(g)
    int   n  = array.size(ix.z)
    bool  r  = false
    if n > 0 and lo <= hi
        int k = f_zsLower(ix, lo - ix.maxW)
        while not r and k < n and array.get(ix.bot, k) <= hi
            LbZone z = array.get(ix.z, k)
            if z.tt >= lo and f_zsOk(z, g, d)
                r := true
            k += 1
    r

// 武装した帯のうち、次の足に届くもの (ZCS の f_zsBest(p, c) に条件「LONG: 上端 >= lim (次の足の安値) / SHORT: 下端 <= lim (次の足の高値)」を
//  足したもの)。f_zsBest の最良が lim に届くならそれと同じ候補を返し、届かないなら false (= ZCS で指値が約定しない)。
//  打ち切り: 残りの候補の上端は「Zone の下端 + 索引の幅の最大」以下 (LONG) / 下端は Zone の下端以上 (SHORT) なので、lim に届かなくなったら止める
f_zrBest(ZsPd p, int c, int lim) =>
    ZsIdx ia  = f_zsIxOf(p.a)
    ZsIdx ib  = f_zsIxOf(p.b)
    bool  sw  = array.size(ib.z) < array.size(ia.z)
    ZsIdx io  = sw ? ib : ia
    ZsIdx ii  = sw ? ia : ib
    int   go  = sw ? p.b : p.a
    int   gi  = sw ? p.a : p.b
    bool  fnd = false
    int   no  = array.size(io.z)
    if no > 0 and array.size(ii.z) > 0
        int  k    = p.d == 1 ? f_zsLower(io, c) - 1 : f_zsLower(io, c - io.maxW + 1)
        bool more = p.d == 1 ? k >= 0 : k < no
        while more
            LbZone zo = array.get(io.z, k)
            if (p.d == 1 ? zo.tb + io.maxW < lim : zo.tb > lim) or (fnd and (p.d == 1 ? zo.tb + io.maxW < p.cT : zo.tb > p.cL))
                more := false
            else
                if f_zsOk(zo, go, p.d) and f_zsFvgSide(zo, go, p.d, c)
                    int j = f_zsLower(ii, zo.tb - ii.maxW)
                    int m = array.size(ii.z)
                    while j < m and array.get(ii.bot, j) <= zo.tt
                        LbZone zi = array.get(ii.z, j)
                        if zi.tt >= zo.tb and f_zsOk(zi, gi, p.d) and f_zsFvgSide(zi, gi, p.d, c)
                            int    cl = math.max(zo.tb, zi.tb)
                            int    ct = math.min(zo.tt, zi.tt)
                            LbZone za = sw ? zi : zo
                            LbZone zb = sw ? zo : zi
                            if (p.d == 1 ? ct < c and ct >= lim : cl > c and cl <= lim) and f_zsBetter(p, fnd, cl, ct, za, zb)
                                p.cL := cl
                                p.cT := ct
                                p.ca := za
                                p.cb := zb
                                fnd  := true
                        j += 1
                k    += p.d == 1 ? -1 : 1
                more := p.d == 1 ? k >= 0 : k < no
    fnd

// 値幅 j の結果を決める (res: 1 反発先 / 2 逆行先 / 3 順序不明 / 4 計測不能 / 5 打ち切り。tc = 決まった足の time_close)。追跡中を解除する
f_zcFtSet(ZcObs ob, int j, int res, int tc) =>
    array.set(ob.fSt, j, res)
    array.set(ob.fTc, j, tc)
    int ix = ob.pi * 3 + j
    f_inc(zrCnt, ix * ZR_NI + 8, -1)
    f_inc(zrCnt, ix * ZR_NI + 2 + res, 1)
    array.set(zrBusy, ix, 0)
    true

f_zcFtOpen(ZcObs ob) =>
    array.get(ob.fSt, 0) == 0 or array.get(ob.fSt, 1) == 0 or array.get(ob.fSt, 2) == 0

// 記録を確定して出力待ちへ入れる (並び・単位は仕様書の表)
f_zcFinal(ZcObs ob) =>
    array<float> v = array.new_float(ZR_NF, na)
    array.set(v, 0, ob.id)
    array.set(v, 1, ob.pi)
    array.set(v, 2, ob.t0 / 1000.0)
    array.set(v, 3, ob.za)
    array.set(v, 4, ob.zb)
    array.set(v, 5, ob.zta / 1000.0)
    array.set(v, 6, ob.ztb / 1000.0)
    array.set(v, 7, ob.cT * syminfo.mintick)
    array.set(v, 8, ob.cL * syminfo.mintick)
    array.set(v, 9, ob.p0 * syminfo.mintick)
    array.set(v, 10, array.get(ob.fSt, 0) * 100 + array.get(ob.fSt, 1) * 10 + array.get(ob.fSt, 2))
    array.set(v, 11, ob.flags * 1000 + array.get(ob.tbJ, 0) * 100 + array.get(ob.tbJ, 1) * 10 + array.get(ob.tbJ, 2))
    for j = 0 to 2
        int tc = array.get(ob.fTc, j)
        if not na(tc)
            array.set(v, 12 + j, tc / 1000.0)
    array.push(zcQ, ZcRec.new(v))
    st.nDone += 1
    true

// タッチ足 (ZCR-9 の帯端起点の規則そのまま)。LONG (SHORT は上下逆): F = P0 + 幅、A = P0 − 幅。
//  逆行側の極値 (LONG の安値) は接触後 (始値が P0 より上なら価格は P0 を通ってから安値へ進む。始値が P0 以下なら始値の時点で接触)。
//  終値は足の最後なので常に接触後。順行側の極値 (高値) は始値が P0 より上の足では接触前の可能性があるので、終値で確認できない高値は使わない。
//  幅ごとに fc = 終値 >= F / ah = 安値 <= A / fm = 高値 >= F かつ fc でない。fc かつ ah → 順序不明 / fc → 反発先 / ah かつ fm → 順序不明 /
//  ah → 逆行先 (タッチ足で決着、決着時刻 = T0) / それ以外は次の足から (fm なら判定 4 を残し、後で逆行先に決まったら順序不明)。
//  採用した値幅 (fSt = 0) だけ決着させる。判定は見送りの値幅にも記入する
f_zcTouchBar(ZcObs ob, int h, int l, int c) =>
    int cN = ob.d == 1 ? c - ob.p0 : ob.p0 - c
    int fx = ob.d == 1 ? h - ob.p0 : ob.p0 - l
    int ad = ob.d == 1 ? ob.p0 - l : h - ob.p0
    for j = 0 to 2
        int  w  = array.get(zcWT, j)
        bool fc = cN >= w
        bool ah = ad >= w
        bool fm = fx >= w and not fc
        array.set(ob.tbJ, j, fc and ah ? 3 : fc ? 1 : ah and fm ? 5 : ah ? 2 : fm ? 4 : 0)
        int res = fc and ah ? 3 : fc ? 1 : ah and fm ? 3 : ah ? 2 : 0
        if res > 0 and array.get(ob.fSt, j) == 0
            f_zcFtSet(ob, j, res, ob.t0)
            st.nTbR += res == 1 ? 1 : 0
            st.nTbA += res == 2 ? 1 : 0
            st.nTbU += res == 3 ? 1 : 0
    true

// 追跡中の記録をタッチ足より後の確定 5分足で更新 (ZCR-9 の先着判定そのまま。幅ごとに独立・時間制限なし)。戻り値 true = 確定 (追跡終了)。
//  始値が反発側目標以上 → 反発先 / 逆行側目標以下 → 逆行先 (始値が先)。そうでなければこの足の高安が両方に届く → 順序不明、片方だけ → その側。
//  不正足 → 未決着の幅は計測不能
f_zcUpd(ZcObs ob, bool bad, int o, int h, int l, int tc) =>
    if bad
        for j = 0 to 2
            if array.get(ob.fSt, j) == 0
                f_zcFtSet(ob, j, 4, tc)
    else
        int fOn = ob.d == 1 ? o - ob.p0 : ob.p0 - o
        int fFv = ob.d == 1 ? h - ob.p0 : ob.p0 - l
        int fAd = ob.d == 1 ? ob.p0 - l : h - ob.p0
        for j = 0 to 2
            if array.get(ob.fSt, j) == 0
                int w   = array.get(zcWT, j)
                int res = fOn >= w ? 1 : -fOn >= w ? 2 : fFv >= w and fAd >= w ? 3 : fFv >= w ? 1 : fAd >= w ? 2 : 0
                // タッチ足に未確認の反発の可能性 (判定 4) が残る幅: 後で逆行先に決まったら推測で逆行先にせず順序不明
                if res == 2 and array.get(ob.tbJ, j) == 4
                    res := 3
                    st.nTbMay += 1
                    ob.flags += j == 0 ? 1 : j == 1 ? 2 : 4
                if res > 0
                    f_zcFtSet(ob, j, res, tc)
    bool done = not f_zcFtOpen(ob)
    if done
        f_zcFinal(ob)
    done

// 新規接触 (確定 5分足 [l, h]、終値 c): 記録を作り、値幅ごとに採用 (その値幅が追跡中でない) / 見送り を決め、タッチ足を判定する。
//  ペア・方向はこの足から接触中 (接触の帯 = 武装した帯、候補 = その Zone の組。ZCS の約定した足と同じ)
f_zrNew(ZsPd p, int h, int l, int c) =>
    st.oSeq += 1
    ZcObs ob = ZcObs.new(st.oSeq, p.pi, p.d, time_close, p.d == 1 ? p.cT : p.cL, p.cT, p.cL, p.ca.id, p.cb.id, p.ca.aTime, p.cb.aTime,
         array.new_int(3, 9), array.new_int(3, na), array.new_int(3, 0))
    for j = 0 to 2
        int ix = p.pi * 3 + j
        f_inc(zrCnt, ix * ZR_NI, 1)
        if array.get(zrBusy, ix) == 0
            array.set(zrBusy, ix, 1)
            array.set(ob.fSt, j, 0)
            f_inc(zrCnt, ix * ZR_NI + 1, 1)
            f_inc(zrCnt, ix * ZR_NI + 8, 1)
        else
            f_inc(zrCnt, ix * ZR_NI + 2, 1)
    f_zcTouchBar(ob, h, l, c)
    p.fb   := bar_index
    p.on   := true
    p.outT := na
    p.hb   := p.cL
    p.ht   := p.cT
    p.ka   := array.new<LbZone>(1, p.ca)
    p.kb   := array.new<LbZone>(1, p.cb)
    array.push(zrNp, p.pi)
    array.push(zcEvT, time_close)
    array.push(zcEvTop, p.cT)
    array.push(zcEvBot, p.cL)
    array.push(zcEvD, p.d)
    if f_zcFtOpen(ob)
        array.push(zrNw, ob)
    else
        f_zcFinal(ob)
    true

// 方向 s (0 LONG / 1 SHORT) で、方向 d の Zone が [lo, hi] と重なる根拠 ID を zrG へ。戻り値 = 個数
f_zrGids(int d, int lo, int hi) =>
    array.clear(zrG)
    for g = 0 to 25
        if f_zrHas(g, d, lo, hi)
            array.push(zrG, g)
    array.size(zrG)
// 確定 5分足 k の処理: (1) 新規接触 (足 k-1 の終わりに武装した帯) → (2) 接触・離脱 (足 k-1 の処理の後の Zone) → (3) 追跡中の記録を更新 →
//  (4) 足 k の確定情報で Zone を登録 / 更新 / 失効、ZB の帯 → (5) 次の足の武装の条件 (この足の終値・集計開始・助走) → (6) 記録の出力
if hlRun and barstate.isconfirmed
    if array.size(zcMa) == 0
        for k = 0 to 1
            LbZone mz = f_lbNew(1, k, 0, na, na, na, na, na, na)
            mz.gid := 3 + k
            array.push(zcMa, mz)
        for g = 0 to 21
            array.push(zsIx, ZsIdx.new(array.new_int(0), array.new<LbZone>()))
        int pn = 0
        for a = 0 to 24
            for b = a + 1 to 25
                for s = 0 to 1
                    array.push(zsPd, ZsPd.new(a, b, s == 0 ? 1 : -1, pn * 2 + s, ka = array.new<LbZone>(), kb = array.new<LbZone>()))
                pn += 1

    // 不正足 = OHLC のいずれかが na、高値 < max(始値, 終値)、安値 > min(始値, 終値) (ZCR-9 / ZCS と同じ定義)
    bool bad = na(open) or na(high) or na(low) or na(close) or high < math.max(open, close) or low > math.min(open, close)
    int oT = bad ? int(na) : math.round(open  / syminfo.mintick)
    int hT = bad ? int(na) : math.round(high  / syminfo.mintick)
    int lT = bad ? int(na) : math.round(low   / syminfo.mintick)
    int cT = bad ? int(na) : math.round(close / syminfo.mintick)

    // ---- (1) 新規接触: 直前の足 k-1 の終わりに接触中でなく武装できたペア・方向で、武装した帯 (足 k-1 の処理の後の Zone と足 k-1 の終値 pC で
    //      決まる。ZCS の指値の帯) の LONG 上端以下までこの足の安値が下がった / SHORT 下端以上まで高値が上がった (ZCS の指値の約定と同じ条件。
    //      ギャップで帯を越えて始まった足も含む)。候補の 2 つの Zone はどちらも [安値, pC − 1] (SHORT は [pC + 1, 高値]) と重なるので、
    //      その条件を満たす Zone を持つ根拠 ID の組だけ探す
    if not bad and st.live
        for s = 0 to 1
            int d  = s == 0 ? 1 : -1
            int ng = d == 1 ? f_zrGids(d, lT, st.pC - 1) : f_zrGids(d, st.pC + 1, hT)
            if ng > 1
                for i = 0 to ng - 2
                    for j = i + 1 to ng - 1
                        ZsPd p = array.get(zsPd, f_zrPair(array.get(zrG, i), array.get(zrG, j)) * 2 + s)
                        if not p.on
                            st.nWork += 1
                            if f_zrBest(p, st.pC, d == 1 ? lT : hT)
                                f_zrNew(p, hT, lT, cT)
    int nNew = array.size(zrNp)

    // ---- (2) 接触・離脱 (ZCS の f_zsContact をペア・方向ごとに。新規接触した足のペア・方向は (1) のまま)。対象 = 接触中のもの + この足に
    //      触れた候補があり得るもの (両方の根拠に、帯が [安値, 高値] と重なる Zone がある)。それ以外は f_zsContact が何も変えないので呼ばない。
    //      不正足は外側の計時をやり直すだけ ----------------------------------------------------------------------------------
    int nOn0 = array.size(zrOnL)
    if bad
        if nOn0 > 0
            for i = 0 to nOn0 - 1
                ZsPd p = array.get(zsPd, array.get(zrOnL, i))
                p.outT := na
    else
        array<int> todo = array.new_int(0)
        if nOn0 > 0
            for i = 0 to nOn0 - 1
                ZsPd p = array.get(zsPd, array.get(zrOnL, i))
                if p.fb != bar_index
                    p.mk := bar_index
                    array.push(todo, p.pi)
        for s = 0 to 1
            int d  = s == 0 ? 1 : -1
            int ng = f_zrGids(d, lT, hT)
            if ng > 1
                for i = 0 to ng - 2
                    for j = i + 1 to ng - 1
                        ZsPd p = array.get(zsPd, f_zrPair(array.get(zrG, i), array.get(zrG, j)) * 2 + s)
                        if p.fb != bar_index and p.mk != bar_index
                            p.mk := bar_index
                            array.push(todo, p.pi)
        array.clear(zrOnL)
        int nt = array.size(todo)
        if nt > 0
            for i = 0 to nt - 1
                ZsPd p = array.get(zsPd, array.get(todo, i))
                st.nWork += 1
                f_zsContact(p, hT, lT)
                if p.on
                    array.push(zrOnL, p.pi)
        if nNew > 0
            for i = 0 to nNew - 1
                array.push(zrOnL, array.get(zrNp, i))

    // ---- (3) 追跡中の記録を更新 (この足はどの記録にとってもタッチ足より後の足)。この足の新規接触の記録は更新の後で追跡中へ入れる
    //      (この足で決着した値幅は、この足の新規接触では見送りのまま = 足の中の順序を推測して同じ足で採用しない) ------------------------
    int oi0 = 0
    while oi0 < array.size(zcPend)
        if f_zcUpd(array.get(zcPend, oi0), bad, oT, hT, lT, time_close)
            array.remove(zcPend, oi0)
        else
            oi0 += 1
    int nw = array.size(zrNw)
    if nw > 0
        for i = 0 to nw - 1
            array.push(zcPend, array.get(zrNw, i))
    // 追跡中の上限: 超えた分は古い順に未決着の値幅を「打ち切り」にして確定 (値幅ごとに同時 1 件なので 1,950 件を超えることはない)
    while array.size(zcPend) > ZC_MAXPEND
        ZcObs oc = array.shift(zcPend)
        for j = 0 to 2
            if array.get(oc.fSt, j) == 0
                f_zcFtSet(oc, j, 5, time_close)
        st.nCut += 1
        f_zcFinal(oc)

    if not bad
        // ---- (4) この足の確定情報で Zone を登録 / 更新 / 失効 (ZCR-9 / ZCS と同じブロック)。ZB の帯はこの足の確定時点の EMA -----------
        array.clear(lbDeadNow)
        // ==== LAB register (begin) — ZoneComboLabXAU.pine (B1) と同一 ====
        // ZA: 新しい ID = 前回届いた ID と違う (未固定が残っていれば固定)。同じ ID は形成中に上下限を更新し、形成中フラグ 0 で固定
        array<float> fU = array.from(f1u, f2u, f3u)
        array<float> fL = array.from(f1l, f2l, f3l)
        array<int>   fI = array.from(f1i, f2i, f3i)
        array<int>   fA = array.from(f1a, f2a, f3a)
        for k = 0 to 2
            int   aid = array.get(fI, k)
            float u   = array.get(fU, k)
            float l   = array.get(fL, k)
            if f_zaUse(k) and not na(aid) and not na(u) and not na(l)
                bool forming = array.get(fA, k) == 1
                int  last    = array.get(lbAccLast, k)
                if na(last) or aid != last
                    array.set(lbAccLast, k, aid)
                    int na0 = array.size(lbAccs)
                    if na0 > 0
                        for i = na0 - 1 to 0
                            LbAcc q = array.get(lbAccs, i)
                            if q.tf == k
                                f_lbAccFix(q)
                                array.remove(lbAccs, i)
                    LbAcc b = LbAcc.new(k, aid, u, l)
                    if forming
                        array.push(lbAccs, b)
                    else
                        f_lbAccFix(b)
                else
                    int na1 = array.size(lbAccs)
                    if na1 > 0
                        for i = na1 - 1 to 0
                            LbAcc q = array.get(lbAccs, i)
                            if q.tf == k and q.aid == aid
                                q.up := u
                                q.lo := l
                                if not forming
                                    f_lbAccFix(q)
                                    array.remove(lbAccs, i)
        // ZC: 新しい Pivot (時刻キーが前回と違う) はすべて登録。統合距離以内で連鎖する既存の水平線 Zone があればまとめる (f_swAdd)
        array<float> pH  = array.from(s1h, s2h, s3h, s4h)
        array<int>   pHt = array.from(s1ht, s2ht, s3ht, s4ht)
        array<float> pL  = array.from(s1l, s2l, s3l, s4l)
        array<int>   pLt = array.from(s1lt, s2lt, s3lt, s4lt)
        for k = 0 to 3
            if f_zcUse(k)
                for s = 0 to 1
                    float pv = s == 0 ? array.get(pH, k) : array.get(pL, k)
                    int   pt = s == 0 ? array.get(pHt, k) : array.get(pLt, k)
                    int   lt = s == 0 ? array.get(lbPivLastH, k) : array.get(lbPivLastL, k)
                    if not na(pt) and not na(pv) and (na(lt) or pt != lt)
                        if s == 0
                            array.set(lbPivLastH, k, pt)
                        else
                            array.set(lbPivLastL, k, pt)
                        int sub = s == 0 ? 1 : -1
                        f_swAdd(k, sub, pv, pt)
        // ZD: 外部 POC (MtfPocFeedXAU) の受信。この 5分足に届いている確定済み上位足の出力を読み、正常な値で中心が前回の有効値から
        //  変わったら、同じ時間足の旧 POC を無効化して新 POC を登録する (時間足ごとに最新の確定 POC 1 つだけが有効。旧 POC は Zone の一覧・
        //  表示・TP 候補から外し、旧 POC を含む待機は (B3) で解除。時刻の更新だけでは何もしない。前と同じ価格に戻った場合も新 POC として採用)。
        //  状態: 0 検知 OFF / 1 正常 / 2 計算不能 (時刻 < 0) / 3 履歴不足 (時刻 na) / 8 外部側 OFF (時刻 0) / 9 未接続・誤接続
        //  (protocol ≠ 10001、時刻が時刻として不自然、正常なのに上下限が na / 上限 <= 下限)。8 / 9 は新規発注を止める (close で代用しない)
        bool zdProtoOK = not na(zdProto) and zdProto == 10001
        bool zdBad = false
        array<float> dL = array.from(zdL1, zdL2, zdL3, zdL4)
        array<float> dU = array.from(zdU1, zdU2, zdU3, zdU4)
        array<float> dT = array.from(zdT1, zdT2, zdT3, zdT4)
        for k = 0 to 3
            int stt = 0
            if f_zdUse(k)
                float tt = array.get(dT, k)
                float lo = array.get(dL, k)
                float up = array.get(dU, k)
                if not zdProtoOK
                    stt := 9
                else if na(tt)
                    stt := 3
                else if tt == 0
                    stt := 8
                else if math.abs(tt) < 1e11 or math.abs(tt) >= time or tt != math.round(tt)
                    stt := 9
                else if tt < 0
                    stt := 2
                else if na(lo) or na(up)
                    stt := 9
                else if up <= lo
                    stt := 9
                else
                    stt := 1
                    float pc = (lo + up) / 2.0
                    float lp = array.get(lbPocLast, k)
                    if na(lp) or pc != lp
                        array.set(lbPocLast, k, pc)
                        LbZone oz = array.get(lbPocCur, k)
                        if not na(oz)
                            f_lbRemoveS(oz)
                            if dsZone
                                f_dsDel(oz, false)
                            oz.dead := true
                            array.push(lbDeadNow, oz.id)
                        LbZone nzp = f_lbNew(3, k, 0, pc, pc - zHalf, pc + zHalf, lo, up, int(tt))
                        f_lbAdd(nzp)
                        array.set(lbPocCur, k, nzp)
            array.set(lbZdStat, k, stt)
            if stt == 8 or stt == 9
                zdBad := true
        // ZE: 外部 LongFibWave (13 系列) の受信。4時間足・日足それぞれ最新の 1 波だけ (0.236 / 0.382 / 0.5 / 0.618 の 4 Zone)。
        //  状態: 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続 (protocol ≠ 20001、状態・波 ID・
        //  更新確定時刻が不自然、有効なのに起点・終点・方向が不正、無効なのに起点・終点・方向がある)。9 だけ新規発注を止める (close で代用しない)。
        //  8 (外部側の計算 OFF) は 2 / 3 と同じ正常な無効状態 (その時間足の Zone と待機を外すだけ)。
        //  有効な波の起点・終点・方向・波 ID のどれかが変わったら旧 4 Zone を外して (待機も解除) 新しい 4 Zone を登録 (同じなら何もしない)。
        //  波なし・保留中・外部 OFF ではその時間足の Zone を外す。誤接続では Zone を保つ。ZE 検知 OFF では何もしない
        bool zeProtoOK = not na(zeProto) and zeProto == 20001
        bool zeBad = false
        array<float> eO = array.from(ze4O, zeDO)
        array<float> eE = array.from(ze4E, zeDE)
        array<float> eD = array.from(ze4D, zeDD)
        array<float> eI = array.from(ze4I, zeDI)
        array<float> eS = array.from(ze4S, zeDS)
        array<float> eT = array.from(ze4T, zeDT)
        for k = 0 to 1
            int stt = 0
            if f_zeUse(k)
                float fo = array.get(eO, k)
                float fe = array.get(eE, k)
                float fd = array.get(eD, k)
                float fi = array.get(eI, k)
                float fs = array.get(eS, k)
                float ft = array.get(eT, k)
                if not zeProtoOK
                    stt := 9
                else if na(fs) or na(fi) or na(ft) or na(fd)
                    stt := 9
                else if fs != math.round(fs) or fs < 0 or fs > 3 or fi != math.round(fi) or fi < 0
                    stt := 9
                else if math.abs(ft) < 1e11 or ft > time_close or ft != math.round(ft)
                    stt := 9
                else if fs == 3
                    stt := na(fo) or na(fe) ? 9 : fo == fe or not (fd == 1 or fd == -1) ? 9 : 1
                else
                    stt := not na(fo) or not na(fe) or fd != 0 ? 9 : fs == 0 ? 8 : fs == 1 ? 2 : 3
                if stt == 1
                    if not f_zeSame(k, fo, fe, fd, fi)
                        f_zeClear(k)
                        f_zeSet(k, fo, fe, fd, fi, ft)
                else if stt == 2 or stt == 3 or stt == 8
                    f_zeClear(k)
                    array.set(lbZeLast, k * 5 + 4, stt)
            array.set(lbZeStat, k, stt)
            if stt == 9
                zeBad := true
        // ZF: 新しい上位足 (キー = 形成足の時刻): 既存 FVG / iFVG を確定終値で判定 → 新しい FVG を登録
        array<int>   gK = array.from(g1k, g2k, g3k, g4k)
        array<float> gC = array.from(g1c, g2c, g3c, g4c)
        array<int>   gD = array.from(g1d, g2d, g3d, g4d)
        array<float> gT = array.from(g1t, g2t, g3t, g4t)
        array<float> gB = array.from(g1b, g2b, g3b, g4b)
        for k = 0 to 3
            int key = array.get(gK, k)
            int lk  = array.get(lbFvgLast, k)
            if f_zfUse(k) and not na(key) and (na(lk) or key != lk)
                array.set(lbFvgLast, k, key)
                float hc = array.get(gC, k)
                int nf = array.size(lbFvgs)
                if nf > 0 and not na(hc)
                    for i = nf - 1 to 0
                        LbZone z = array.get(lbFvgs, i)
                        if z.tf == k and z.key < key
                            if not z.inv
                                if (z.sub == 1 and hc < z.bot) or (z.sub == -1 and hc > z.top)
                                    z.inv := true
                                    st.nIfvg += 1
                                    if dsZone
                                        f_dsRename(z)
                            else if (z.sub == 1 and hc > z.top) or (z.sub == -1 and hc < z.bot)
                                z.dead := true
                                st.nFvgDead += 1
                                f_lbRemove(z)
                                array.push(lbDeadNow, z.id)
                                if dsZone
                                    f_dsDel(z, true)
                int   gd = array.get(gD, k)
                float gt = array.get(gT, k)
                float gb = array.get(gB, k)
                if not na(gd) and gd != 0 and not na(gt) and not na(gb)
                    f_lbAdd(f_lbNew(4, k, gd, (gt + gb) / 2.0, gb, gt, na, na, key))
        // ZG: ダブル / トリプル トップ・ボトム (1H / 4H / D の検知器の検知イベント = 反転足の確定で発動。接触・Pivot の登録だけでは作らない)。
        //  根拠 = 時間足 + 基準 ID で 1 回だけ (ダブルで発動した基準のトリプル・消えた基準の後の検知では作らない)。基準価格・幅・期限は発動時に固定。
        //  期限: 検知足 = 0 本目、その時間足の確定足の bar_index − 検知足 ≥ 本数で消す。逆行: 検知結果を受け取った確定 5分足 (発動した足) から実体端で判定
        //  (処理順: ZG の登録・期限 → 逆行による消滅 → (B2) 接触・(B3) 待機・(B6) 候補。発動した足で消えた Zone は接触・SL / TP 候補に残らない)
        array<string> zgPk = array.from(zgPk1, zgPk4, zgPkD)
        for k = 0 to 2
            [zlt, zrec] = f_zgParse(array.get(zgPk, k), array.get(lbZgLast, k), time_close)
            array.set(lbZgLast, k, zlt)
            int nr = int(array.size(zrec) / 6)
            if nr > 0
                for r = 0 to nr - 1
                    int ro  = r * 6
                    int rbi = int(array.get(zrec, ro + 1))
                    if array.get(zrec, ro) == 0
                        int nzg = array.size(lbZgZ)
                        if f_zgExpOn(k) and nzg > 0
                            for i = nzg - 1 to 0
                                LbZone z = array.get(lbZgZ, i)
                                if z.tf == k and rbi - int(z.infoB) >= f_zgExpN(k)
                                    f_zgKill(i)
                    else
                        int   zid  = int(array.get(zrec, ro + 2))
                        int   zsd  = int(array.get(zrec, ro + 3))
                        float zcnt = array.get(zrec, ro + 4)
                        float zp   = array.get(zrec, ro + 5)
                        int   ukey = zid * 3 + k
                        if not array.includes(lbZgUsed, ukey) and not na(zp)
                            array.push(lbZgUsed, ukey)
                            if f_zgUse(k) or f_zgShow(k)
                                // sub: 1 トップ (抵抗) / -1 ボトム (支持)。infoA = 回数 (2 ダブル / 3 トリプル)、infoB = 検知足の bar_index、key = 基準 ID
                                LbZone zz = f_lbNew(6, k, zsd == -1 ? 1 : -1, zp, zp - zgHalf, zp + zgHalf, zcnt, rbi, zid)
                                zz.zgUse  := f_zgUse(k)
                                zz.zgShow := f_zgShow(k)
                                if zz.zgUse
                                    f_lbAdd(zz)
                                else if dsZone and zz.zgShow
                                    f_dsAdd(zz)
                                array.push(lbZgZ, zz)
        int nzg2 = array.size(lbZgZ)
        if nzg2 > 0
            for i = nzg2 - 1 to 0
                LbZone z = array.get(lbZgZ, i)
                if z.sub == 1 ? math.max(open, close) > z.ctr + zgRev + EPS : math.min(open, close) < z.ctr - zgRev - EPS
                    f_zgKill(i)
        // ==== LAB register (end) ====
        float v1 = na
        if not na(zbMa1)
            st.ma1N += 1
            if st.ma1N > zbWarm1
                v1 := zbMa1
        f_zcMaSet(0, zbUse1, v1)
        f_zcMaSet(1, zbUse2, zbMa2)
        f_zsMaIdx()
        for k = 0 to 1
            if array.get(lbZeStat, k) == 9
                f_inc(zcZeBad, k, 1)
        for k = 0 to 3
            if f_zdUse(k) and array.get(lbZdStat, k) != 1
                f_inc(zcZdBad, k, 1)

    // ---- (5) 次の足の武装の条件 (ZCS の発注できる足と同じ: 不正足でない・集計開始日時以後・助走の後)。武装した帯そのものは次の足の (1) で
    //      この足の処理の後の Zone とこの足の終値から求める ----------------------------------------------------------------------
    st.live := not bad and time_close >= zcStart and st.nBars >= zcWarm
    st.pC   := cT
    st.nOn  := array.size(zrOnL)
    f_inc(zrNewHist, math.min(nNew, 10), 1)
    st.maxNew := math.max(st.maxNew, nNew)

    // ---- (6) 確定した記録を 1 足 ZR_K 件まで出力 (FIFO。出し切れない分は次の足へ。件数は表と plot「出力待ち」) ----------------------
    int nq = math.min(ZR_K, array.size(zcQ))
    if nq > 0
        for r = 0 to nq - 1
            ZcRec rc = array.shift(zcQ)
            for x = 0 to ZR_NF - 1
                array.set(zcOut, r * ZR_NF + x, array.get(rc.v, x))
            st.nOut += 1
    st.maxQ := math.max(st.maxQ, array.size(zcQ))

    if na(st.firstT)
        st.firstT := time
    st.lastT := time_close
    st.nBad  += bad ? 1 : 0
    st.nBars += 1
// ==== ZCR Logic (end) ========================================================

// ---- 描画 (集計値には影響しない): 新規接触した帯 --------------------------------------------------------------------
var array<box> zcBoxes = array.new<box>()
if zcShowBox and array.size(zcEvT) > 0
    for i = 0 to array.size(zcEvT) - 1
        int   et = array.get(zcEvT, i)
        int   ed = array.get(zcEvD, i)
        float tp = array.get(zcEvTop, i) * syminfo.mintick
        float bt = array.get(zcEvBot, i) * syminfo.mintick
        array.push(zcBoxes, box.new(et - 5 * ZC_M1, tp, et + 30 * ZC_M1, bt, xloc = xloc.bar_time,
             border_color = color.new(ed == 1 ? color.teal : color.maroon, 40), bgcolor = color.new(ed == 1 ? color.teal : color.maroon, 85)))
        if array.size(zcBoxes) > zcDrawMax
            box.delete(array.shift(zcBoxes))

// ---- 表 (集計値には影響しない。ペア × 方向 × 値幅 の 1,950 行をページ送り。長い説明は見出しセルの tooltip。横の結合セルは使わない) ----------
// ==== ZCR Display calc (begin) ================================================
// 表に出す行・数値の計算 (描画から分離した関数。tests/zcr_sim.py がこの区間を Python に変換して照合する)

// 表の行 (キー = ペア・方向の番号 * 3 + 値幅 = (ペア番号 * 2 + 方向) * 3 + 値幅) を絞り込んで並べる。
//  dSel / wSel = -1 全部 / 方向 0 LONG・1 SHORT / 値幅 0..2。byCount = 新規接触の多い順 (同数はキーの小さい順)、そうでなければキーの順 (= ペア番号順)
f_dsRows(int dSel, int wSel, bool byCount, bool hide0) =>
    array<int>   keys = array.new_int(0)
    array<float> sk   = array.new_float(0)
    for pr = 0 to 324
        for s = 0 to 1
            if dSel < 0 or dSel == s
                for j = 0 to 2
                    if wSel < 0 or wSel == j
                        int key = (pr * 2 + s) * 3 + j
                        int n   = array.get(zrCnt, key * ZR_NI)
                        if not hide0 or n > 0
                            array.push(keys, key)
                            array.push(sk, n * 4096.0 + 4095 - key)
    array<int> out = keys
    if byCount and array.size(keys) > 1
        array<int> ord = array.sort_indices(sk, order.descending)
        out := array.new_int(0)
        for i = 0 to array.size(ord) - 1
            array.push(out, array.get(keys, array.get(ord, i)))
    out

// 行のキーの項目 (0 新規接触 / 1 採用 / 2 見送り / 3 反発先 / 4 逆行先 / 5 順序不明 / 6 計測不能 / 7 打切り / 8 追跡中)
f_dsV(int key, int item) =>
    array.get(zrCnt, key * ZR_NI + item)

// 行の集合の合計
f_dsSum(array<int> rows, int item) =>
    int sm = 0
    int n  = array.size(rows)
    if n > 0
        for i = 0 to n - 1
            sm += f_dsV(array.get(rows, i), item)
    sm

// 先着率 = 反発先 / (反発先 + 逆行先)。順序不明・計測不能・打切り・追跡中は分母に入れない。0 / 0 は「—」
f_dsRate(int a, int b) =>
    a + b == 0 ? "—" : str.tostring(math.round(1000.0 * a / (a + b)) / 10.0) + "%"

// ペア番号 → 根拠 ID (a, b)
f_dsAB(int pr) =>
    int a  = 0
    int rest = pr
    while rest >= 25 - a
        rest -= 25 - a
        a += 1
    [a, a + 1 + rest]

f_dsPages(int n, int per) =>
    math.max(1, int(math.ceil(n / (per * 1.0))))

f_dsPage(int want, int pages) =>
    math.min(math.max(want, 1), pages)
// ==== ZCR Display calc (end) ==================================================

f_gUse(int g) =>
    g < 3 ? f_zaUse(g) : g < 5 ? f_zbUse(g - 3) : g < 9 ? f_zcUse(g - 5) : g < 13 ? f_zdUse(g - 9) : g < 15 ? f_zeUse(g - 13) : g < 19 ? f_zfUse(g - 15) : g < 22 ? f_zgUse(g - 19) : f_zfUse(g - 22)

color  ZC_HEAD = color.new(color.gray, 20)
color  ZC_BG   = color.new(color.black, 15)
color  ZC_BG2  = color.new(color.navy, 30)
color  ZC_WARN = color.new(color.maroon, 10)
color  ZC_TX   = color.white
string ZC_TS   = zcTxtSize == "tiny" ? size.tiny : zcTxtSize == "normal" ? size.normal : zcTxtSize == "large" ? size.large : size.small
string ZC_POS  = zcPos == "top_left" ? position.top_left : zcPos == "top_center" ? position.top_center : zcPos == "middle_left" ? position.middle_left :
     zcPos == "middle_center" ? position.middle_center : zcPos == "middle_right" ? position.middle_right : zcPos == "bottom_left" ? position.bottom_left :
     zcPos == "bottom_center" ? position.bottom_center : zcPos == "bottom_right" ? position.bottom_right : position.top_right
string ZC_TIP_ALL = "ZCR-10: 指定 2 根拠のペアごとに独立して反応を計測 (26 根拠の全 325 ペア × LONG / SHORT × $5 / $10 / $15)。\n" +
     "武装した帯 = 直前の確定足の Zone と終値で、2 根拠の Zone の帯そのものの共通区間のうち LONG は終値より下で上端が最も高いもの / SHORT は終値より上で下端が最も低いもの。\n" +
     "新規接触 = 次の足の安値 (SHORT は高値) が その LONG 上端 (SHORT 下端) に届いた (ZCS の指値の約定と同じ)。接触中は武装しない (離脱 = 離脱幅 / 離脱時間)。\n" +
     "起点 P0 = その帯端 (発生時に固定)。±値幅の先着 (時間制限なし)。値幅ごとに観測は同時 1 件: 未決着の間の新規接触は見送り (後から採用しない)。\n" +
     "他の根拠は関与しない。OFF の根拠を含むペアは Zone が無いので計測されない (行のペア名に OFF)。履歴上の頻度で将来を保証しない"
string ZC_TIP_C = "新規接触 = 採用 + 見送り。採用 = 反発先 + 逆行先 + 順序不明 + 追跡中 + 打切り + 計測不能。\n" +
     "先着率 = 反発先 / (反発先 + 逆行先)。順序不明 (同じ足で両方に届いた等) と追跡中・打切り・計測不能は分母に入れない。0 / 0 は「—」"

f_cell(table t, int c, int r, string s, color bg, string tip) =>
    table.cell(t, c, r, s, text_color = ZC_TX, bgcolor = bg, text_size = ZC_TS, tooltip = tip)

f_cellL(table t, int c, int r, string s, color bg, string tip) =>
    table.cell(t, c, r, s, text_color = ZC_TX, bgcolor = bg, text_size = ZC_TS, text_halign = text.align_left, tooltip = tip)

var table zcTbl = na

if barstate.islast
    if not na(zcTbl)
        table.delete(zcTbl)
    if not hlRun
        zcTbl := table.new(ZC_POS, 1, 3, border_width = 1)
        f_cell(zcTbl, 0, 0, "ZCR-XAU: 集計停止", ZC_HEAD, "")
        f_cell(zcTbl, 0, 1, "5分の標準チャートで使用", ZC_BG, "通常ローソク足の 5分チャートで使ってください")
        f_cell(zcTbl, 0, 2, "現在: " + timeframe.period + (chart.is_standard ? "" : " (非標準)"), ZC_BG, "")
    else if array.size(zsPd) == 0
        zcTbl := table.new(ZC_POS, 1, 1, border_width = 1)
        f_cell(zcTbl, 0, 0, "ZCR-XAU: 確定足なし", ZC_HEAD, "確定した 5分足がまだありません")
    else
        int        dSel  = zrDirSel == "LONG" ? 0 : zrDirSel == "SHORT" ? 1 : -1
        int        wSel  = zrWSel == "$5" ? 0 : zrWSel == "$10" ? 1 : zrWSel == "$15" ? 2 : -1
        array<int> rows  = f_dsRows(dSel, wSel, zrOrder == "新規接触の多い順", zrHide0)
        int        nRow  = array.size(rows)
        int        pages = f_dsPages(nRow, zrPerPage)
        int        pg    = f_dsPage(zrPage, pages)
        int        i0    = (pg - 1) * zrPerPage
        int        i1    = math.min(nRow, i0 + zrPerPage) - 1
        int        nShow = nRow == 0 ? 1 : i1 - i0 + 1
        int        nCol  = 13
        zcTbl := table.new(ZC_POS, nCol, 2 + nShow + 3, border_width = 1)
        // 1 行目: 名前・ページ・絞り込み
        f_cellL(zcTbl, 0, 0, "ZCR ペア別 (2 根拠)", ZC_HEAD, ZC_TIP_ALL)
        f_cell(zcTbl, 1, 0, str.tostring(pg) + "/" + str.tostring(pages) + "頁", ZC_HEAD, "全 " + str.tostring(nRow) + " 行 (絞り込み後)、1 ページ " + str.tostring(zrPerPage) + " 行")
        f_cell(zcTbl, 2, 0, "方向:" + zrDirSel, ZC_HEAD, "表示する方向 (設定)")
        f_cell(zcTbl, 3, 0, "値幅:" + zrWSel, ZC_HEAD, "表示する値幅 (設定)")
        f_cell(zcTbl, 4, 0, zrOrder == "ペア番号順" ? "番号順" : "多い順", ZC_HEAD, "並び順 (設定)")
        f_cell(zcTbl, 5, 0, zrHide0 ? "0件:隠す" : "0件:表示", ZC_HEAD, "新規接触 0 件の行 (設定)")
        for c = 6 to nCol - 1
            f_cell(zcTbl, c, 0, "", ZC_HEAD, "")
        // 2 行目: 見出し
        array<string> hd = array.from("ペア", "方向", "値幅", "新規接触", "採用", "見送り", "反発先", "逆行先", "順序不明", "追跡中", "打切り", "計測不能", "先着率")
        for c = 0 to nCol - 1
            f_cell(zcTbl, c, 1, array.get(hd, c), ZC_HEAD, c == 12 ? ZC_TIP_C : c == 5 ? "その値幅の観測が未決着だったため採用しなかった新規接触 (後から採用しない)" :
                 c == 10 ? "追跡中の記録が上限 " + str.tostring(ZC_MAXPEND) + " を超えて打ち切った値幅" : c == 11 ? "決着前に不正足が来た値幅" : c == 0 ? "ペア番号: 根拠 a × 根拠 b (ZC_GN 順)" : ZC_TIP_C)
        if nRow == 0
            f_cellL(zcTbl, 0, 2, "該当する行なし", ZC_BG, "")
            for c = 1 to nCol - 1
                f_cell(zcTbl, c, 2, "", ZC_BG, "")
        else
            for i = i0 to i1
                int key = array.get(rows, i)
                int pdn = int(key / 3)
                int pr  = int(pdn / 2)
                [ga, gb] = f_dsAB(pr)
                bool  off = not f_gUse(ga) or not f_gUse(gb)
                color bg  = off ? ZC_WARN : (i - i0) % 2 == 0 ? ZC_BG : ZC_BG2
                int   row = 2 + i - i0
                f_cellL(zcTbl, 0, row, str.tostring(pr) + " " + array.get(ZC_GN, ga) + "×" + array.get(ZC_GN, gb) + (off ? " (OFF)" : ""), bg,
                     off ? "OFF の根拠を含むので計測しない (Zone が登録されない)" : "")
                f_cell(zcTbl, 1, row, pdn % 2 == 0 ? "LONG" : "SHORT", bg, "")
                f_cell(zcTbl, 2, row, "$" + str.tostring((key % 3 + 1) * 5), bg, "")
                for c = 0 to 8
                    int item = c <= 5 ? c : c == 6 ? 8 : c == 7 ? 7 : 6
                    f_cell(zcTbl, 3 + c, row, str.tostring(f_dsV(key, item)), bg, "")
                f_cell(zcTbl, 12, row, f_dsRate(f_dsV(key, 3), f_dsV(key, 4)), bg, "")
        // 欄外: 絞り込んだ全行の合計・記録 (CSV) の件数・注記
        int rS = 2 + nShow
        f_cellL(zcTbl, 0, rS, "合計 (" + str.tostring(nRow) + " 行)", ZC_HEAD, "絞り込んだ全行 (全ページ) の合計。方向・値幅を「全部」にすると全 1,950 行の合計")
        f_cell(zcTbl, 1, rS, "", ZC_HEAD, "")
        f_cell(zcTbl, 2, rS, "", ZC_HEAD, "")
        for c = 0 to 8
            int item = c <= 5 ? c : c == 6 ? 8 : c == 7 ? 7 : 6
            f_cell(zcTbl, 3 + c, rS, str.tostring(f_dsSum(rows, item)), ZC_HEAD, "")
        f_cell(zcTbl, 12, rS, f_dsRate(f_dsSum(rows, 3), f_dsSum(rows, 4)), ZC_HEAD, "")
        int nQ = array.size(zcQ)
        int nP = array.size(zcPend)
        bool miss = nQ + nP > 0
        f_cellL(zcTbl, 0, rS + 1, "記録 (CSV)", ZC_HEAD, "新規接触 1 件 = 記録 1 件。採用した値幅が全部決着した足で出力待ちへ入り、1 足 " + str.tostring(ZR_K) + " 件まで R plot へ出す (FIFO)。\n" +
             "未出力 = 出力待ち (決着済み・出力の順番待ち) + 追跡中 (採用した値幅に未決着がある)。CSV の記録数 = 新規接触 − 未出力")
        f_cell(zcTbl, 1, rS + 1, "接触 " + str.tostring(st.oSeq), ZC_BG, "新規接触の総数 (全ペア・方向) = 記録の総数")
        f_cell(zcTbl, 2, rS + 1, "出力 " + str.tostring(st.nOut), ZC_BG, "R plot へ出力した記録 (CSV に入る件数)")
        f_cell(zcTbl, 3, rS + 1, "待ち " + str.tostring(nQ), miss ? ZC_WARN : ZC_BG, "決着済みで出力の順番待ち (最後の足まで出し切れなかった記録)")
        f_cell(zcTbl, 4, rS + 1, "追跡 " + str.tostring(nP), miss ? ZC_WARN : ZC_BG, "採用した値幅に未決着があり、まだ出力していない記録")
        f_cell(zcTbl, 5, rS + 1, "未出力 " + str.tostring(nQ + nP), miss ? ZC_WARN : ZC_BG, "CSV に入っていない記録の件数 (出力待ち + 追跡中)。表の件数と CSV を突き合わせるときに使う")
        f_cell(zcTbl, 6, rS + 1, "1足最大 " + str.tostring(st.maxNew), ZC_BG, "1 本の足の新規接触の最大件数 (全ペア・方向)")
        f_cell(zcTbl, 7, rS + 1, "待ち最大 " + str.tostring(st.maxQ), ZC_BG, "出力待ちの最大 (その足の出力の後)")
        f_cell(zcTbl, 8, rS + 1, "打切 " + str.tostring(st.nCut), st.nCut > 0 ? ZC_WARN : ZC_BG, "追跡中の上限で打ち切った記録")
        f_cell(zcTbl, 9, rS + 1, "不正足 " + str.tostring(st.nBad), ZC_BG, "不正足の本数 (新規接触なし・Zone の更新なし・追跡中の値幅は計測不能)")
        f_cell(zcTbl, 10, rS + 1, "接触中 " + str.tostring(st.nOn), ZC_BG, "最後の足の終わりに接触中のペア・方向")
        f_cell(zcTbl, 11, rS + 1, "", ZC_BG, "")
        f_cell(zcTbl, 12, rS + 1, "", ZC_BG, "")
        string offs = ""
        for g = 0 to 25
            if not f_gUse(g)
                offs += (offs == "" ? "" : " ") + array.get(ZC_GN, g)
        bool zeBad = array.get(lbZeStat, 0) == 9 or array.get(lbZeStat, 1) == 9
        f_cellL(zcTbl, 0, rS + 2, "注記", ZC_HEAD, "")
        f_cellL(zcTbl, 1, rS + 2, offs == "" ? "OFF なし" : "OFF (計測しない): " + offs, offs == "" ? ZC_BG : ZC_WARN, "入力で OFF の根拠。その根拠を含むペアは Zone が無いので件数 0")
        for c = 2 to nCol - 1
            f_cell(zcTbl, c, rS + 2, c == 2 ? (zeBad ? "ZE 未接続" : "") : "", c == 2 and zeBad ? ZC_WARN : ZC_BG, c == 2 ? "ZE (LongFibWave) の接続出力が未接続・誤接続 (状態 9) の時間足がある" : "")

// ---- 記録の出力 (1 足 4 件 × 15 列。並び・単位・特殊値は仕様書の表。出力のない枠は na) -------------------------

caseDelta(array<int> before, HM met) =>
    int d = 0
    int k = 0
    while k < MX_BARS
        d += array.get(met.ints, k) - array.get(before, k)
        k += 1
    d
// runs every case in sequence (no enclosing loop: the Pine per-loop time limit); per case pass = no metric increase
// (state / event / runtime / I22) during the case
hmScen(HM met, string sc, int idx) =>
    met.scen := sc
    met.scenBar := 0
    array.set(met.runs, idx, array.get(met.runs, idx) + 1)
    true
caseRun(HM met, array<bool> cpass, array<int> b) =>
    array.push(cpass, caseDelta(b, met) == 0)
runAll(HM met, array<bool> cpass) =>
    array.set(met.runs, RN_RUNALL, array.get(met.runs, RN_RUNALL) + 1)
    array<string> g  = goldInit(array.new_string(0))
    array.set(met.runs, RN_GOLD, array.get(met.runs, RN_GOLD) + 1)
    array<string> gx = goldXInit(array.new_string(0))
    array.set(met.runs, RN_GOLDX, array.get(met.runs, RN_GOLDX) + 1)
    hmScen(met, "46", 0)
    array<int> b0 = array.copy(met.ints)
    s46(g, met)
    caseRun(met, cpass, b0)
    hmScen(met, "47", 1)
    array<int> b1 = array.copy(met.ints)
    s47(g, met)
    caseRun(met, cpass, b1)
    hmScen(met, "48", 2)
    array<int> b2 = array.copy(met.ints)
    s48(g, met)
    caseRun(met, cpass, b2)
    hmScen(met, "49", 3)
    array<int> b3 = array.copy(met.ints)
    s49(g, met)
    caseRun(met, cpass, b3)
    hmScen(met, "50", 4)
    array<int> b4 = array.copy(met.ints)
    s50(g, met)
    caseRun(met, cpass, b4)
    hmScen(met, "51", 5)
    array<int> b5 = array.copy(met.ints)
    s51(g, met)
    caseRun(met, cpass, b5)
    hmScen(met, "52", 6)
    array<int> b6 = array.copy(met.ints)
    s52(g, met)
    caseRun(met, cpass, b6)
    hmScen(met, "53", 7)
    array<int> b7 = array.copy(met.ints)
    s53(g, met)
    caseRun(met, cpass, b7)
    hmScen(met, "54", 8)
    array<int> b8 = array.copy(met.ints)
    s54(g, met)
    caseRun(met, cpass, b8)
    hmScen(met, "55", 9)
    array<int> b9 = array.copy(met.ints)
    s55(g, met)
    caseRun(met, cpass, b9)

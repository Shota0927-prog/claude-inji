eventAppendRaw(HW w, int eventType, int eventTime, int baseSeq, int coreId, int generationId, int side, float rangeBottom, float rangeTop, int touchNo, int gradeAtStart, int weakReason, int rootId) =>
    int eventIndex = w.aux.eventLogicalCount
    if eventIndex < array.size(w.aux.eventTypes)
        array.set(w.aux.eventTypes,         eventIndex, eventType)
        array.set(w.aux.eventTimes,         eventIndex, eventTime)
        array.set(w.aux.eventBaseSeqs,      eventIndex, baseSeq)
        array.set(w.aux.eventCoreIds,       eventIndex, coreId)
        array.set(w.aux.eventGenerationIds, eventIndex, generationId)
        array.set(w.aux.eventSides,         eventIndex, side)
        array.set(w.aux.eventRangeBottoms,  eventIndex, rangeBottom)
        array.set(w.aux.eventRangeTops,     eventIndex, rangeTop)
        array.set(w.aux.eventTouchNos,      eventIndex, touchNo)
        array.set(w.aux.eventGradeAtStarts, eventIndex, gradeAtStart)
        array.set(w.aux.eventWeakReasons,   eventIndex, weakReason)
        array.set(w.aux.eventRootIds,       eventIndex, rootId)
    else
        array.push(w.aux.eventTypes,         eventType)
        array.push(w.aux.eventTimes,         eventTime)
        array.push(w.aux.eventBaseSeqs,      baseSeq)
        array.push(w.aux.eventCoreIds,       coreId)
        array.push(w.aux.eventGenerationIds, generationId)
        array.push(w.aux.eventSides,         side)
        array.push(w.aux.eventRangeBottoms,  rangeBottom)
        array.push(w.aux.eventRangeTops,     rangeTop)
        array.push(w.aux.eventTouchNos,      touchNo)
        array.push(w.aux.eventGradeAtStarts, gradeAtStart)
        array.push(w.aux.eventWeakReasons,   weakReason)
        array.push(w.aux.eventRootIds,       rootId)
    w.aux.eventLogicalCount := eventIndex + 1
    eventIndex

cdPlan(HW w, HF fd, W09State.TouchStartPlanView tv, array<int> tsx, array<int> d1, array<int> gbi, array<float> gbf, array<int> gbr, array<int> ei, array<float> ef, array<int> fli, array<float> flf, array<int> d3, array<int> rcs, bool d4) =>
    bool ok = W09State.touchStartPlanPreflight(tv, fd.baseSeq, fd.baseHigh, fd.baseLow, fd.baseClose, fd.mintick, fd.touchTolerance, fd.breakBuffer, CAT_MASK_ALL, CAT_MASK_PSYCH, DEN_HIGH, DEN_NORMAL, DEN_BROAD_CONTEXT) and W09State.touchStartPlanBuild(tv, fd.baseSeq, fd.baseCloseTime, fd.baseHigh, fd.baseLow, fd.baseClose, fd.mintick, fd.touchTolerance, fd.breakBuffer, fd.weakFromTouch, fd.weakFromTouchOff, EV_TOUCH_START, WEAK_NONE, WEAK_BY_TOUCH, WEAK_BY_DEPTH, WEAK_BY_BOTH, d1, gbi, gbf, gbr, fd.touchResetDistance, tsx) >= 0
    ok := ok and W09State.episodePlan(tv, w.idx.phaseActiveTouchSideSlots, w.state.sideMaxDepthPcts, w.state.sideTouchHistoryTruncatedFlags, w.core.touchMarkCapacityPerCore, fd.baseClose, fd.mintick, fd.breakBuffer, fd.touchResetDistance, fd.weakDepthPct, fd.weakDepthOff, ei, ef)
    // W09 B18 (/35): the Flip / Reclaim targets from the Broken BreakSnapshot price indexes (no Broken-set scan)
    array<int> bsc = array.new_int(0)
    ok := ok and W09State.bsTargetSlots(w.idx.brokenSnapshotBottomOrderSideSlots, w.idx.sideBrokenSnapshotBottomOrderPositions, w.idx.brokenSnapshotTopOrderSideSlots, w.idx.sideBrokenSnapshotTopOrderPositions, w.state.sideBreakSnapshotRangeBottoms, w.state.sideBreakSnapshotRangeTops, fd.mintick, fd.baseHigh, fd.baseLow, fd.baseClose, fd.touchResetDistance, fd.breakBuffer, bsc)
    if d4
        ok := ok and W09State.reclaimResolve(bsc, w.state.sideBreakSnapshotRootHeadNodeIndexes, w.state.sideBreakSnapshotRootCounts, w.aux.breakSnapshotRootNodeRootIds, w.aux.breakSnapshotRootNodeNextIndexes, w.core.journalOps, w.core.journalGroups, w.core.journalExpectedRootIds, w.core.journalCount, w.core.rootIdToSlot, w.core.rootStates, w.core.rootSlotLiveFlags, rcs)
    ok := ok and W09State.flipPlan(tv, ei, bsc, fli, flf, d3, fd.baseSeq, fd.baseCloseTime, fd.baseHigh, fd.baseLow, fd.baseClose, fd.mintick, fd.touchResetDistance, fd.breakBuffer, rcs)
    ok

mainSlice(HW w, HF fd, W09State.TouchStartPlanView tv, W09State.PhaseArmedTransferView pav, array<int> ei, array<float> ef, array<bool> tsr, array<int> tro, array<int> d1, array<int> gbi, array<float> gbf, array<int> fli, array<float> flf, array<int> d3, array<int> noArm) =>
    // W09 B12: deferred InverseConfirm marks of earlier bars, then this bar's confirms (Event rows, immediate marks, noArm,
    // deferred rows) after the final topology; the merged D3 order takes the InverseConfirm rows
    array<int>   ivi = array.new_int(0)
    array<float> ivf = array.new_float(0)
    array<int>   mki = array.new_int(0)
    array<float> mkf = array.new_float(0)
    int nres = W09State.inverseDeferredResolve(tv, pav, w.core.rootIdToSlot, w.aux.pendingTopologyRootNodeRootIds, w.aux.pendingTopologyRootNodeLiveFlags, w.aux.inverseDeferredValidFlags, w.aux.inverseDeferredExpectedRootIds, w.aux.inverseDeferredConfirmBaseSeqs, w.aux.inverseDeferredConfirmTimes, w.aux.inverseDeferredSides, w.aux.inverseDeferredNativeBottoms, w.aux.inverseDeferredNativeTops, w.aux.inverseDeferredContactBottoms, w.aux.inverseDeferredContactTops, w.aux.inverseDeferredCloseAtTouches, mki, mkf)
    W09State.inverseConfirmProject(tv, pav, ei, fli, d3, w.aux.fvgInverseConfirmRootIds, w.aux.fvgInverseConfirmCount, w.core.rootIdToSlot, w.core.rootDirections, w.core.rootNativeBottoms, w.core.rootNativeTops, w.aux.pendingTopologyRootNodeRootIds, w.aux.pendingTopologyRootNodeLiveFlags, fd.baseSeq, fd.baseCloseTime, fd.baseHigh, fd.baseLow, fd.baseClose, noArm, ivi, ivf, mki, mkf)
    int iv = 0
    while iv < array.size(ivi)
        if array.get(ivi, iv + 6) == 1
            int f = 5 * int(iv / 7)
            array.push(w.aux.inverseDeferredValidFlags, true)
            array.push(w.aux.inverseDeferredExpectedRootIds, array.get(ivi, iv))
            array.push(w.aux.inverseDeferredConfirmBaseSeqs, fd.baseSeq)
            array.push(w.aux.inverseDeferredConfirmTimes, fd.baseCloseTime)
            array.push(w.aux.inverseDeferredSides, array.get(ivi, iv + 1))
            array.push(w.aux.inverseDeferredNativeBottoms, array.get(ivf, f))
            array.push(w.aux.inverseDeferredNativeTops, array.get(ivf, f + 1))
            array.push(w.aux.inverseDeferredContactBottoms, array.get(ivf, f + 2))
            array.push(w.aux.inverseDeferredContactTops, array.get(ivf, f + 3))
            array.push(w.aux.inverseDeferredCloseAtTouches, array.get(ivf, f + 4))
        iv += 7
    W08Touch.TouchRing ring = ringOf(w)
    iv := 0
    while iv < nres
        W08Touch.markAppend(ring, array.get(mki, 5 * iv), array.get(mki, 5 * iv + 2), array.get(mki, 5 * iv + 3), array.get(mki, 5 * iv + 1), array.get(mkf, 3 * iv), array.get(mkf, 3 * iv + 1), array.get(mkf, 3 * iv + 2), array.get(mki, 5 * iv + 4), false, 0, false, 0.0)
        iv += 1
    array<int>   ti = w.aux.touchStartPlanInts
    array<float> tf = w.aux.touchStartPlanFloats
    // W09 B09: the D1 facts in the D1 canonical order: a TouchStart plan row (its TouchMark when flagged, EV_TOUCH_START)
    // or a GapBreak row (EV_GAP_BREAK: LastArmedRange, touchNo 0, gradeAtStart Unavailable, persistent Weak reason)
    int i = 0
    while i < array.size(d1)
        int x = array.get(d1, i)
        if x >= 0
            int r = 30 * x
            int f = 7 * x
            if array.get(tsr, x)
                W08Touch.markAppend(ring, array.get(ti, r + 1), array.get(ti, r + 16), array.get(ti, r + 17), array.get(ti, r + 4), array.get(tf, f + 2), array.get(tf, f + 3), array.get(tf, f + 4), array.get(ti, r + 3), array.get(ti, r + 27) == 1, array.get(ti, r + 6), false, 0.0)
            eventAppendRaw(w, array.get(ti, r + 24), array.get(ti, r + 17), array.get(ti, r + 16), array.get(ti, r + 2), array.get(ti, r + 3), array.get(ti, r + 4), array.get(tf, f), array.get(tf, f + 1), array.get(ti, r + 6), array.get(ti, r + 14), array.get(ti, r + 25), array.get(ti, r + 26))
        else
            int g = -7 * (x + 1)
            eventAppendRaw(w, EV_GAP_BREAK, fd.baseCloseTime, fd.baseSeq, array.get(gbi, g + 1), array.get(gbi, g + 2), array.get(gbi, g) % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, array.get(gbf, -2 * (x + 1)), array.get(gbf, -2 * (x + 1) + 1), 0, GR_UNAVAILABLE, array.get(gbi, g + 3), ID_NONE)
        i += 1
    // W09 B07-R2: Episode apply after the TouchMark append, then the WeakDepth (flag 8) and Reset (flag 16) Events, each in the
    // canonical Episode order (ei stride 10, ef stride 6)
    W09State.episodeApply(tv, pav, ei, ef, w.core.touchMarkCapacityPerCore, fd.weakFromTouch, fd.weakFromTouchOff, fd.strongUntilTouch, fd.strongUnlimited, tro, fd.baseSeq, fd.baseCloseTime, fd.mintick)
    // W09 B10: the D3 facts in one canonical order (coreId, generationId, Support, Resistance; no per-Event-type pass):
    // an Episode row (WeakDepth / Reset / LocalBreak Event) or a Flip row (its non-normal TouchMark when flagged, then
    // EV_FLIP_ATTEMPT / EV_FLIP_CONFIRM: BS range, touchNo 0, gradeAtStart Unavailable, persistent Weak reason; W09 B11:
    // EV_RECLAIM on the old Side, its persistent Weak reason, no TouchMark)
    i := 0
    while i < array.size(d3)
        int x = array.get(d3, i)
        if x >= 0
            int k = 0
            while k < 3
                if k == 2 ? array.get(ei, x + 2) % 2 == 1 : array.get(ei, x + 2) % (16 + 16 * k) >= 8 + 8 * k
                    eventAppendRaw(w, k == 0 ? EV_WEAK_DEPTH : k == 1 ? EV_TOUCH_RESET : EV_LOCAL_BREAK, fd.baseCloseTime, fd.baseSeq, array.get(ei, x + 3), array.get(ei, x + 4), array.get(ei, x) % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, array.get(ef, int(x / 10) * 6), array.get(ef, int(x / 10) * 6 + 1), array.get(ei, x + 1), array.get(ei, x + 6), array.get(ei, x + 5), ID_NONE)
                k += 1
        else if x <= -1000000
            // W09 B12: EV_INVERSE_CONFIRM (NativeRange, touchNo 0, Unavailable, WEAK_NONE, the Root; core / generation of the one
            // holder or ID_NONE) after its immediate non-normal marks
            int kv = -x - 1000000
            int g  = 7 * kv
            int m  = array.get(ivi, g + 4)
            while m < array.get(ivi, g + 4) + array.get(ivi, g + 5)
                W08Touch.markAppend(ring, array.get(mki, 5 * m), array.get(mki, 5 * m + 2), array.get(mki, 5 * m + 3), array.get(mki, 5 * m + 1), array.get(mkf, 3 * m), array.get(mkf, 3 * m + 1), array.get(mkf, 3 * m + 2), array.get(mki, 5 * m + 4), false, 0, false, 0.0)
                m += 1
            eventAppendRaw(w, EV_INVERSE_CONFIRM, fd.baseCloseTime, fd.baseSeq, array.get(ivi, g + 2), array.get(ivi, g + 3), array.get(ivi, g + 1), array.get(ivf, 5 * kv), array.get(ivf, 5 * kv + 1), 0, GR_UNAVAILABLE, WEAK_NONE, array.get(ivi, g))
        else
            int g  = -7 * (x + 1)
            int mr = array.get(fli, g + 3)
            if mr >= 0 and array.get(tsr, mr)
                int r = 30 * mr
                int f = 7 * mr
                W08Touch.markAppend(ring, array.get(ti, r + 1), array.get(ti, r + 16), array.get(ti, r + 17), array.get(ti, r + 4), array.get(tf, f + 2), array.get(tf, f + 3), array.get(tf, f + 4), array.get(ti, r + 3), array.get(ti, r + 27) == 1, array.get(ti, r + 6), false, 0.0)
            int fl = array.get(fli, g + 2)
            eventAppendRaw(w, fl % 32 >= 16 ? EV_RECLAIM : fl % 16 >= 8 ? EV_FLIP_CONFIRM : EV_FLIP_ATTEMPT, fd.baseCloseTime, fd.baseSeq, array.get(fli, g + 5), array.get(fli, g + 6), array.get(fli, fl % 32 >= 16 ? g + 1 : g) % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, array.get(flf, -2 * (x + 1)), array.get(flf, -2 * (x + 1) + 1), 0, GR_UNAVAILABLE, array.get(fli, g + 4), ID_NONE)
        i += 1
    true

// ---------------- harness helpers ----------------
tkOf(float x, float mt) =>
    na(x) ? int(na) : int(math.round(x / mt))
hfNew(float dd, float bb) =>
    HF.new(SEQ0, SEQ0 * BAR_MS, na, na, na, 1.0, 0.0, bb, 2, false, 3.0, 50.0, false, 1, false, dd)
// fixture Grade (the frozen order, harness-own; fixture consistency only)
fixGrade(bool np, bool wd, bool wtNo, bool bst, int no, int sut, bool sul) =>
    int g = 1
    if not np
        g := GR_UNAVAILABLE
    else if wd or wtNo
        g := 2
    else if bst and (sul or no <= sut)
        g := 0
    g
hwInit(HW w, int nc, bool roots) =>
    int c = 0
    while c < nc
        array.set(w.core.coreIds, c, 10 + c)
        array.set(w.aux.touchMarkRingOwnerCoreIds, c, 10 + c)
        map.put(w.core.coreIdToSlot, 10 + c, c)
        c += 1
    int s = 0
    while roots and s < 2 * nc
        int i = array.size(w.core.sideCurrentRootNodeRootIds)
        array.push(w.core.sideCurrentRootNodeRootIds, 60 + s)
        array.push(w.core.sideCurrentRootNodeNextIndexes, -1)
        array.push(w.core.sideCurrentRootNodeOwnerSideSlots, s)
        array.push(w.core.sideCurrentRootNodeExpectedCoreIds, 10 + int(s / 2))
        array.push(w.core.sideCurrentRootNodeExpectedGenerationIds, 3)
        array.push(w.core.sideCurrentRootNodeLiveFlags, true)
        array.set(w.core.sideCurrentRootHeadNodeIndexes, s, i)
        array.set(w.core.sideCurrentRootTailNodeIndexes, s, i)
        array.set(w.core.sideCurrentRootCounts, s, 1)
        s += 1
    w
wNew(int nc, bool roots) =>
    HW w = hwNew(nc, 4)
    hwInit(w, nc, roots)
// setB + EffectiveRange (local armS): Armed from the previous bar, LastArmedRange, TouchCount, one current Root (55)
armS(HW w, HF f, int s, float b, float t, int cnt) =>
    int c = int(s / 2)
    array.set(w.state.sidePhases, s, PH_ARMED)
    array.set(w.state.sideArmedFromSeqs, s, f.baseSeq - 1)
    array.set(w.state.sideLastArmedRangeBottoms, s, b)
    array.set(w.state.sideLastArmedRangeTops, s, t)
    array.set(w.state.sideTouchCounts, s, cnt)
    int i = array.size(w.core.sideCurrentRootNodeRootIds)
    array.push(w.core.sideCurrentRootNodeRootIds, 55)
    array.push(w.core.sideCurrentRootNodeNextIndexes, -1)
    array.push(w.core.sideCurrentRootNodeOwnerSideSlots, s)
    array.push(w.core.sideCurrentRootNodeExpectedCoreIds, array.get(w.core.coreIds, c))
    array.push(w.core.sideCurrentRootNodeExpectedGenerationIds, 3)
    array.push(w.core.sideCurrentRootNodeLiveFlags, true)
    array.set(w.core.sideCurrentRootHeadNodeIndexes, s, i)
    array.set(w.core.sideCurrentRootTailNodeIndexes, s, i)
    array.set(w.core.sideCurrentRootCounts, s, 1)
    array.set(w.core.sideEffectiveBottoms, s, b)
    array.set(w.core.sideEffectiveTops, s, t)
    w
// persistent Local Break result (local setBS): BS on both Sides of the Core of sb, Broken / FlipWait
setBS(HW w, int sb, int seq, array<int> roots, float b, float t) =>
    int c = int(sb / 2)
    int o = sb % 2 == 0 ? sb + 1 : sb - 1
    int k = 0
    while k < 2
        int s = k == 0 ? sb : o
        array.set(w.state.sideBreakSnapshotValidFlags, s, true)
        array.set(w.state.sideBreakSnapshotCoreIds, s, array.get(w.core.coreIds, c))
        array.set(w.state.sideBreakSnapshotGenerationIds, s, 3)
        array.set(w.state.sideBreakSnapshotOldSides, s, sb % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE)
        array.set(w.state.sideBreakSnapshotRangeBottoms, s, b)
        array.set(w.state.sideBreakSnapshotRangeTops, s, t)
        array.set(w.state.sideBreakSnapshotBreakSeqs, s, seq)
        array.set(w.state.sideBreakSnapshotBreakTimes, s, seq * BAR_MS)
        array.set(w.state.sideBreakSnapshotWasGapBreakFlags, s, false)
        array.set(w.state.sideBreakSnapshotMovedAwayFlags, s, false)
        array.set(w.state.sideBreakSnapshotRetestSeenFlags, s, false)
        array.set(w.state.sideBreakSnapshotRootHeadNodeIndexes, s, -1)
        array.set(w.state.sideBreakSnapshotRootTailNodeIndexes, s, -1)
        array.set(w.state.sideBreakSnapshotRootCounts, s, 0)
        int q = 0
        while q < array.size(roots)
            int x = array.size(w.aux.breakSnapshotRootNodeRootIds)
            array.push(w.aux.breakSnapshotRootNodeRootIds, array.get(roots, q))
            array.push(w.aux.breakSnapshotRootNodeNextIndexes, -1)
            array.push(w.aux.breakSnapshotRootNodeOwnerSideSlots, s)
            array.push(w.aux.breakSnapshotRootNodeExpectedCoreIds, array.get(w.core.coreIds, c))
            array.push(w.aux.breakSnapshotRootNodeExpectedGenerationIds, 3)
            array.push(w.aux.breakSnapshotRootNodeExpectedBreakSeqs, seq)
            array.push(w.aux.breakSnapshotRootNodeLiveFlags, true)
            int tl = array.get(w.state.sideBreakSnapshotRootTailNodeIndexes, s)
            if tl >= 0
                array.set(w.aux.breakSnapshotRootNodeNextIndexes, tl, x)
            else
                array.set(w.state.sideBreakSnapshotRootHeadNodeIndexes, s, x)
            array.set(w.state.sideBreakSnapshotRootTailNodeIndexes, s, x)
            array.set(w.state.sideBreakSnapshotRootCounts, s, array.get(w.state.sideBreakSnapshotRootCounts, s) + 1)
            q += 1
        k += 1
    array.set(w.state.sidePhases, sb, PH_BROKEN)
    array.set(w.state.sidePhases, o, PH_FLIP_WAIT)
    array.set(w.state.sideGrades, sb, GR_UNAVAILABLE)
    array.set(w.state.sideGrades, o, GR_UNAVAILABLE)
    w
setMoved(HW w, int sb, bool mv) =>
    array.set(w.state.sideBreakSnapshotMovedAwayFlags, sb, mv)
    array.set(w.state.sideBreakSnapshotMovedAwayFlags, sb % 2 == 0 ? sb + 1 : sb - 1, mv)
    w
// reference ring append (B10 markAppend semantics; fixture only)
rpush(HW w, int c, int seq, int side, float cb, float ct, float cl, bool normal, int no, bool weak, float mx) =>
    int cap = w.core.touchMarkCapacityPerCore
    int h   = array.get(w.aux.touchMarkRingHeads, c)
    int k   = array.get(w.aux.touchMarkRingCounts, c)
    int ph  = c * cap + (k < cap ? (h + k) % cap : h)
    int lost = 0
    if k >= cap
        lost := array.get(w.aux.touchMarkSides, ph)
        array.set(w.aux.touchMarkRingHeads, c, (h + 1) % cap)
    else
        array.set(w.aux.touchMarkRingCounts, c, k + 1)
    array.set(w.aux.touchMarkBaseSeqs, ph, seq)
    array.set(w.aux.touchMarkTimes, ph, seq * BAR_MS)
    array.set(w.aux.touchMarkSides, ph, side)
    array.set(w.aux.touchMarkContactBottoms, ph, cb)
    array.set(w.aux.touchMarkContactTops, ph, ct)
    array.set(w.aux.touchMarkCloseAtTouches, ph, cl)
    array.set(w.aux.touchMarkGenerationIds, ph, 3)
    array.set(w.aux.touchMarkIsNormalTouchFlags, ph, normal)
    array.set(w.aux.touchMarkTouchNos, ph, no)
    array.set(w.aux.touchMarkWeakByDepthFlags, ph, weak)
    array.set(w.aux.touchMarkMaxDepthPcts, ph, mx)
    if lost == 1 or lost == -1
        array.set(w.state.sideTouchHistoryTruncatedFlags, 2 * c + (lost == 1 ? 0 : 1), true)
    ph
// sorted (key tick, slot) order of the members, positions written (fixture index build / audit expectation)
orderBuild(array<int> mem, array<float> key, float mt) =>
    array<int> out = array.new_int(0)
    int i = 0
    while i < array.size(mem)
        int s  = array.get(mem, i)
        int kt = tkOf(array.get(key, s), mt)
        int j  = 0
        bool placed = false
        while not placed and j < array.size(out)
            int o  = array.get(out, j)
            int ko = tkOf(array.get(key, o), mt)
            if kt < ko or (kt == ko and s < o)
                array.insert(out, j, s)
                placed := true
            j += 1
        if not placed
            array.push(out, s)
        i += 1
    out
setOrder(array<int> order, array<int> pos, array<int> srt) =>
    array.clear(order)
    int i = 0
    while i < array.size(pos)
        array.set(pos, i, -1)
        i += 1
    i := 0
    while i < array.size(srt)
        array.push(order, array.get(srt, i))
        array.set(pos, array.get(srt, i), i)
        i += 1
    true
phaseSet(HW w, int ph) =>
    ph == PH_WAITING ? w.idx.phaseWaitingSideSlots : ph == PH_ARMED ? w.idx.phaseArmedSideSlots : ph == PH_ACTIVE_TOUCH ? w.idx.phaseActiveTouchSideSlots : ph == PH_BROKEN ? w.idx.phaseBrokenSideSlots : ph == PH_FLIP_WAIT ? w.idx.phaseFlipWaitSideSlots : w.idx.phaseDormantSideSlots
liveOf(HW w, int s) =>
    array.get(w.core.coreSlotLiveFlags, int(s / 2))
// fixture finish: Phase sets / positions, Armed / Broken / FlipWait / Waiting / Dormant indexes, Upcoming, fixture Grades
finishW(HW w, HF f) =>
    int ns = array.size(w.state.sidePhases)
    int p = 0
    while p < 6
        array.clear(phaseSet(w, p))
        p += 1
    int s = 0
    while s < ns
        array<int> q = phaseSet(w, array.get(w.state.sidePhases, s))
        array.set(w.idx.sidePhaseSetPositions, s, array.size(q))
        array.push(q, s)
        s += 1
    array<int> ma = array.new_int(0)
    array<int> mb = array.new_int(0)
    array<int> mf = array.new_int(0)
    array<int> mw = array.new_int(0)
    array<int> md = array.new_int(0)
    s := 0
    while s < ns
        int ph = array.get(w.state.sidePhases, s)
        bool rg = liveOf(w, s) and not na(array.get(w.core.sideEffectiveBottoms, s)) and not na(array.get(w.core.sideEffectiveTops, s))
        if ph == PH_ARMED
            array.push(ma, s)
        if ph == PH_BROKEN
            array.push(mb, s)
        if ph == PH_FLIP_WAIT
            array.push(mf, s)
        if ph == PH_WAITING and rg
            array.push(mw, s)
        if ph == PH_DORMANT and rg
            array.push(md, s)
        s += 1
    setOrder(w.idx.armedEffectiveBottomOrderSideSlots, w.idx.sideArmedEffectiveBottomOrderPositions, orderBuild(ma, w.state.sideLastArmedRangeBottoms, f.mintick))
    setOrder(w.idx.armedEffectiveTopOrderSideSlots, w.idx.sideArmedEffectiveTopOrderPositions, orderBuild(ma, w.state.sideLastArmedRangeTops, f.mintick))
    setOrder(w.idx.brokenSnapshotBottomOrderSideSlots, w.idx.sideBrokenSnapshotBottomOrderPositions, orderBuild(mb, w.state.sideBreakSnapshotRangeBottoms, f.mintick))
    setOrder(w.idx.brokenSnapshotTopOrderSideSlots, w.idx.sideBrokenSnapshotTopOrderPositions, orderBuild(mb, w.state.sideBreakSnapshotRangeTops, f.mintick))
    setOrder(w.idx.flipSnapshotBottomOrderSideSlots, w.idx.sideFlipSnapshotBottomOrderPositions, orderBuild(mf, w.state.sideBreakSnapshotRangeBottoms, f.mintick))
    setOrder(w.idx.flipSnapshotTopOrderSideSlots, w.idx.sideFlipSnapshotTopOrderPositions, orderBuild(mf, w.state.sideBreakSnapshotRangeTops, f.mintick))
    setOrder(w.idx.waitingBottomOrderSideSlots, w.idx.waitingBottomPositions, orderBuild(mw, w.core.sideEffectiveBottoms, f.mintick))
    setOrder(w.idx.waitingTopOrderSideSlots, w.idx.waitingTopPositions, orderBuild(mw, w.core.sideEffectiveTops, f.mintick))
    setOrder(w.idx.dormantRecoveryBottomOrderSideSlots, w.idx.sideDormantRecoveryBottomOrderPositions, orderBuild(md, w.core.sideEffectiveBottoms, f.mintick))
    setOrder(w.idx.dormantRecoveryTopOrderSideSlots, w.idx.sideDormantRecoveryTopOrderPositions, orderBuild(md, w.core.sideEffectiveTops, f.mintick))
    s := 0
    while s < ns
        if liveOf(w, s)
            int up = array.get(w.state.sideTouchCounts, s) + 1
            array.set(w.state.sideUpcomingTouchNos, s, up)
            int ph = array.get(w.state.sidePhases, s)
            bool np = array.get(w.core.sideHasNonPsychRootFlags, s)
            bool wd = array.get(w.state.sideWeakByDepthFlags, s)
            bool wt = array.get(w.state.sideWeakByTouchFlags, s)
            bool bst = array.get(w.core.sideBaseStrongFlags, s)
            if ph == PH_BROKEN or ph == PH_FLIP_WAIT
                array.set(w.state.sideGrades, s, GR_UNAVAILABLE)
            else if ph == PH_ACTIVE_TOUCH
                int no = array.get(w.state.sideCurrentTouchNos, s)
                array.set(w.state.sideGrades, s, fixGrade(np, wd, wt or (not f.weakFromTouchOff and no >= f.weakFromTouch), bst, no, f.strongUntilTouch, f.strongUnlimited))
            else
                array.set(w.state.sideGrades, s, fixGrade(np, wd, wt or (not f.weakFromTouchOff and up >= f.weakFromTouch), bst, up, f.strongUntilTouch, f.strongUnlimited))
        s += 1
    true
// ---------------- W08 topology stub (local harness r3b2 / b8a topo, w08_pending, w08_commit, svstub, produce_roots) ----------------
topoSpec(HW w, int kind, int tgt, int absd, float rb, float rt) =>
    w.topo.topoKind := kind
    w.topo.topoTgt  := tgt
    w.topo.topoAbsd := absd
    w.topo.topoRngB := rb
    w.topo.topoRngT := rt
    w.topo.topoTruncS := false
    w.topo.topoTruncR := false
    array.clear(w.topo.tpSeqs)
    array.clear(w.topo.tpTimes)
    array.clear(w.topo.tpSides)
    array.clear(w.topo.tpCb)
    array.clear(w.topo.tpCt)
    array.clear(w.topo.tpCl)
    array.clear(w.topo.tpGen)
    array.clear(w.topo.tpNormal)
    array.clear(w.topo.tpNo)
    array.clear(w.topo.tpWeak)
    array.clear(w.topo.tpMx)
    w
tpPush(HW w, int seq, int tm, int side, float cb, float ct, float cl, int gn, bool normal, int no, bool weak, float mx) =>
    array.push(w.topo.tpSeqs, seq)
    array.push(w.topo.tpTimes, tm)
    array.push(w.topo.tpSides, side)
    array.push(w.topo.tpCb, cb)
    array.push(w.topo.tpCt, ct)
    array.push(w.topo.tpCl, cl)
    array.push(w.topo.tpGen, gn)
    array.push(w.topo.tpNormal, normal)
    array.push(w.topo.tpNo, no)
    array.push(w.topo.tpWeak, weak)
    array.push(w.topo.tpMx, mx)
    w
planClear(HW w) =>
    array.clear(w.topo.applyP)
    array.clear(w.topo.mergeOfP)
    array.clear(w.topo.splitOfP)
    array.clear(w.topo.consumedSlots)
    array.clear(w.topo.freeSlots)
    array.clear(w.topo.freeCoreIds)
    array.clear(w.topo.freeGenerationIds)
    array.clear(w.topo.physicalOwnershipKinds)
    array.clear(w.topo.physicalContinuationOldCoreSlots)
    array.clear(w.topo.physicalContinuationCoreIds)
    array.clear(w.topo.physicalContinuationGenerationIds)
    array.clear(w.topo.mergeRelations)
    array.clear(w.topo.mergeAbsorbed)
    array.clear(w.topo.sourceOldCoreSlots)
    array.clear(w.topo.sourceOldCoreIds)
    array.clear(w.topo.markOffsets)
    array.clear(w.topo.markCounts)
    array.clear(w.topo.sides)
    array.clear(w.topo.isNormalFlags)
    array.clear(w.topo.truncatedFlags)
    array.clear(w.topo.times)
    array.clear(w.topo.weakByDepthFlags)
    array.clear(w.topo.maxDepthPcts)
    array.clear(w.topo.mergeTouchPlanOffsets)
    array.clear(w.topo.mergeTouchPlanCounts)
    array.clear(w.topo.mergeTouchPlanTruncatedFlags)
    array.clear(w.topo.mergeTouchPlanSides)
    array.clear(w.topo.mergeTouchPlanTimes)
    array.clear(w.topo.mergeTouchPlanIsNormalFlags)
    array.clear(w.topo.mergeTouchPlanWeakByDepthFlags)
    array.clear(w.topo.mergeTouchPlanMaxDepthPcts)
    w
// the W08 plan arrays of the stub topology (one applied p 0 on the target Core)
topoBuild(HW w) =>
    planClear(w)
    if w.topo.topoKind != TK_NONE
        int tgt = w.topo.topoTgt
        array.push(w.topo.applyP, true)
        array.push(w.topo.physicalOwnershipKinds, 0)
        array.push(w.topo.mergeOfP, -1)
        array.push(w.topo.splitOfP, -1)
        array.push(w.topo.physicalContinuationOldCoreSlots, tgt)
        array.push(w.topo.physicalContinuationCoreIds, array.get(w.core.coreIds, tgt))
        array.push(w.topo.physicalContinuationGenerationIds, array.get(w.core.coreGenerationIds, tgt))
        if w.topo.topoKind == TK_MERGE
            int d = w.topo.topoAbsd
            array.set(w.topo.mergeOfP, 0, 0)
            array.push(w.topo.mergeRelations, 0)
            array.push(w.topo.mergeRelations, tgt)
            array.push(w.topo.mergeRelations, array.get(w.core.coreIds, tgt))
            array.push(w.topo.mergeRelations, 0)
            array.push(w.topo.mergeRelations, 1)
            array.push(w.topo.mergeAbsorbed, d)
            array.push(w.topo.mergeAbsorbed, array.get(w.core.coreIds, d))
            array.push(w.topo.freeSlots, d)
            array.push(w.topo.freeCoreIds, array.get(w.core.coreIds, d))
            array.push(w.topo.freeGenerationIds, array.get(w.core.coreGenerationIds, d))
            int k = 0
            while k < 2
                int sd = k == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE
                array.push(w.topo.mergeTouchPlanOffsets, array.size(w.topo.mergeTouchPlanSides))
                int n = 0
                int i = 0
                while i < array.size(w.topo.tpSides)
                    if array.get(w.topo.tpSides, i) == sd
                        array.push(w.topo.mergeTouchPlanSides, sd)
                        array.push(w.topo.mergeTouchPlanTimes, array.get(w.topo.tpTimes, i))
                        array.push(w.topo.mergeTouchPlanIsNormalFlags, array.get(w.topo.tpNormal, i))
                        array.push(w.topo.mergeTouchPlanWeakByDepthFlags, array.get(w.topo.tpWeak, i))
                        array.push(w.topo.mergeTouchPlanMaxDepthPcts, array.get(w.topo.tpMx, i))
                        n += 1
                    i += 1
                array.push(w.topo.mergeTouchPlanCounts, n)
                array.push(w.topo.mergeTouchPlanTruncatedFlags, k == 0 ? w.topo.topoTruncS : w.topo.topoTruncR)
                k += 1
        else if w.topo.topoKind == TK_SPLIT
            array.set(w.topo.splitOfP, 0, 0)
            array.push(w.topo.sourceOldCoreSlots, tgt)
            array.push(w.topo.sourceOldCoreIds, array.get(w.core.coreIds, tgt))
            array.push(w.topo.markOffsets, 0)
            array.push(w.topo.markCounts, array.size(w.topo.tpSides))
            array.push(w.topo.truncatedFlags, w.topo.topoTruncS)
            array.push(w.topo.truncatedFlags, w.topo.topoTruncR)
            int i = 0
            while i < array.size(w.topo.tpSides)
                array.push(w.topo.sides, array.get(w.topo.tpSides, i))
                array.push(w.topo.times, array.get(w.topo.tpTimes, i))
                array.push(w.topo.isNormalFlags, array.get(w.topo.tpNormal, i))
                array.push(w.topo.weakByDepthFlags, array.get(w.topo.tpWeak, i))
                array.push(w.topo.maxDepthPcts, array.get(w.topo.tpMx, i))
                i += 1
    w
// W08 PendingTopology predicate on the projected overlay: a component Core holding a projected-Active Side is pending
w08Pending(HW w, array<int> ov) =>
    bool pend = false
    int k = 0
    while w.topo.topoKind != TK_NONE and k < 2
        int c = k == 0 ? w.topo.topoTgt : w.topo.topoAbsd
        if c >= 0
            int j = 0
            while j < 2
                int s = 2 * c + j
                bool act = array.includes(ov, s) or (array.get(w.state.sidePhases, s) == PH_ACTIVE_TOUCH and not array.includes(ov, -s - 1))
                pend := pend or act
                j += 1
        k += 1
    pend
detachSide(HW w, int s) =>
    array<int> q = phaseSet(w, array.get(w.state.sidePhases, s))
    int p  = array.get(w.idx.sidePhaseSetPositions, s)
    int ls = array.get(q, array.size(q) - 1)
    array.set(q, p, ls)
    array.set(w.idx.sidePhaseSetPositions, ls, p)
    array.pop(q)
    array.set(w.idx.sidePhaseSetPositions, s, -1)
    true
// W08 commit stub: Merge / Split ring rewrite from the plan rows, absorbed Core freed (Side / BS defaults), target range
w08Commit(HW w) =>
    int c = w.topo.topoTgt
    int cap = w.core.touchMarkCapacityPerCore
    if w.topo.topoKind == TK_MERGE or w.topo.topoKind == TK_SPLIT
        array.set(w.aux.touchMarkRingHeads, c, 0)
        array.set(w.aux.touchMarkRingCounts, c, array.size(w.topo.tpSides))
        int i = 0
        while i < array.size(w.topo.tpSides)
            int x = c * cap + i
            array.set(w.aux.touchMarkBaseSeqs, x, array.get(w.topo.tpSeqs, i))
            array.set(w.aux.touchMarkTimes, x, array.get(w.topo.tpTimes, i))
            array.set(w.aux.touchMarkSides, x, array.get(w.topo.tpSides, i))
            array.set(w.aux.touchMarkContactBottoms, x, array.get(w.topo.tpCb, i))
            array.set(w.aux.touchMarkContactTops, x, array.get(w.topo.tpCt, i))
            array.set(w.aux.touchMarkCloseAtTouches, x, array.get(w.topo.tpCl, i))
            array.set(w.aux.touchMarkGenerationIds, x, array.get(w.topo.tpGen, i))
            array.set(w.aux.touchMarkIsNormalTouchFlags, x, array.get(w.topo.tpNormal, i))
            array.set(w.aux.touchMarkTouchNos, x, array.get(w.topo.tpNo, i))
            array.set(w.aux.touchMarkWeakByDepthFlags, x, array.get(w.topo.tpWeak, i))
            array.set(w.aux.touchMarkMaxDepthPcts, x, array.get(w.topo.tpMx, i))
            i += 1
        array.set(w.state.sideTouchHistoryTruncatedFlags, 2 * c, w.topo.topoTruncS)
        array.set(w.state.sideTouchHistoryTruncatedFlags, 2 * c + 1, w.topo.topoTruncR)
    if w.topo.topoKind == TK_MERGE
        int d = w.topo.topoAbsd
        int k = 0
        while k < 2
            int s = 2 * d + k
            detachSide(w, s)
            array.set(w.state.sideTouchCounts, s, 0)
            array.set(w.state.sideWeakByTouchFlags, s, false)
            array.set(w.state.sideWeakByDepthFlags, s, false)
            array.set(w.state.sideMaxDepthPcts, s, 0.0)
            array.set(w.state.sideFreshFlags, s, false)
            array.set(w.state.sidePhases, s, PH_WAITING)
            array.set(w.state.sideCurrentTouchNos, s, 0)
            array.set(w.state.sideUpcomingTouchNos, s, 0)
            array.set(w.state.sideArmedFromSeqs, s, -1)
            array.set(w.state.sideLastArmedRangeBottoms, s, na)
            array.set(w.state.sideLastArmedRangeTops, s, na)
            array.set(w.state.sideLastNormalTouchTimes, s, na)
            array.set(w.core.sideEffectiveBottoms, s, na)
            array.set(w.core.sideEffectiveTops, s, na)
            array.set(w.state.sideTouchHistoryTruncatedFlags, s, false)
            array.set(w.state.sideBreakSnapshotValidFlags, s, false)
            array.set(w.state.sideBreakSnapshotCoreIds, s, 0)
            array.set(w.state.sideBreakSnapshotGenerationIds, s, 0)
            array.set(w.state.sideBreakSnapshotOldSides, s, 0)
            array.set(w.state.sideBreakSnapshotRangeBottoms, s, na)
            array.set(w.state.sideBreakSnapshotRangeTops, s, na)
            array.set(w.state.sideBreakSnapshotBreakSeqs, s, -1)
            array.set(w.state.sideBreakSnapshotBreakTimes, s, na)
            array.set(w.state.sideBreakSnapshotWasGapBreakFlags, s, false)
            array.set(w.state.sideBreakSnapshotMovedAwayFlags, s, false)
            array.set(w.state.sideBreakSnapshotRetestSeenFlags, s, false)
            array.set(w.state.sideBreakSnapshotRootHeadNodeIndexes, s, -1)
            array.set(w.state.sideBreakSnapshotRootTailNodeIndexes, s, -1)
            array.set(w.state.sideBreakSnapshotRootCounts, s, 0)
            array.set(w.idx.sideBrokenSnapshotBottomOrderPositions, s, -1)
            array.set(w.idx.sideBrokenSnapshotTopOrderPositions, s, -1)
            array.set(w.idx.sideFlipSnapshotBottomOrderPositions, s, -1)
            array.set(w.idx.sideFlipSnapshotTopOrderPositions, s, -1)
            array.set(w.idx.sideDormantRecoveryBottomOrderPositions, s, -1)
            array.set(w.idx.sideDormantRecoveryTopOrderPositions, s, -1)
            array.set(w.idx.waitingBottomPositions, s, -1)
            array.set(w.idx.waitingTopPositions, s, -1)
            array.set(w.state.sideFlipAttemptCounts, s, 0)
            array.set(w.state.sideLastFlipConfirmSeqs, s, -1)
            k += 1
        map.remove(w.core.coreIdToSlot, array.get(w.core.coreIds, d))
        array.set(w.core.coreIds, d, 0)
        array.set(w.core.coreGenerationIds, d, 0)
        array.set(w.core.coreSlotLiveFlags, d, false)
        array.set(w.aux.touchMarkRingOwnerCoreIds, d, 0)
        array.set(w.aux.touchMarkRingHeads, d, 0)
        array.set(w.aux.touchMarkRingCounts, d, 0)
        array.set(w.core.coreZoneFreshFlags, d, false)
    if not na(w.topo.topoRngB)
        array.set(w.core.sideEffectiveBottoms, 2 * c, w.topo.topoRngB)
        array.set(w.core.sideEffectiveTops, 2 * c, w.topo.topoRngT)
        array.set(w.core.sideEffectiveBottoms, 2 * c + 1, w.topo.topoRngB)
        array.set(w.core.sideEffectiveTops, 2 * c + 1, w.topo.topoRngT)
    array.clear(w.topo.physicalMaterializedCoreSlots)
    array.push(w.topo.physicalMaterializedCoreSlots, c)
    w
// SideView winner rows of the applied p (winner index 2p + Side; ticks = the post-topology range; Root IDs = the IV winners)
svFill(HW w, HF f) =>
    int n = math.max(array.size(w.topo.applyP), w.topo.npc)
    float rb = na(w.topo.topoRngB) ? 100.0 : w.topo.topoRngB
    float rt = na(w.topo.topoRngB) ? 110.0 : w.topo.topoRngT
    array.clear(w.topo.physicalCandidateSupportWinnerIndexes)
    array.clear(w.topo.physicalCandidateResistanceWinnerIndexes)
    array.clear(w.topo.candidateWinnerEffectiveBottomTicks)
    array.clear(w.topo.candidateWinnerEffectiveTopTicks)
    array.clear(w.topo.candidateWinnerRootIds)
    array.clear(w.topo.candidateWinnerRootIdOffsets)
    array.clear(w.topo.candidateWinnerRootIdLengths)
    int p = 0
    while p < n
        array.push(w.topo.physicalCandidateSupportWinnerIndexes, 2 * p)
        array.push(w.topo.physicalCandidateResistanceWinnerIndexes, 2 * p + 1)
        p += 1
    int x = 0
    while x < 2 * n
        array.push(w.topo.candidateWinnerEffectiveBottomTicks, tkOf(rb, f.mintick))
        array.push(w.topo.candidateWinnerEffectiveTopTicks, tkOf(rt, f.mintick))
        array<int> rs = x % 2 == 0 ? w.aux.ivWinS : w.aux.ivWinR
        array.push(w.topo.candidateWinnerRootIdOffsets, array.size(w.topo.candidateWinnerRootIds))
        array.push(w.topo.candidateWinnerRootIdLengths, array.size(rs))
        array.concat(w.topo.candidateWinnerRootIds, rs)
        x += 1
    w
// current Root producer stub: the applied target's Sides get the IV winner Root IDs (complete replace)
produceRoots(HW w) =>
    if w.topo.topoKind != TK_NONE and array.size(w.topo.physicalContinuationOldCoreSlots) > 0
        int c = w.topo.topoTgt
        int k = 0
        while k < 2
            bool has = k == 0 ? w.aux.ivWinSSet : w.aux.ivWinRSet
            if has
                array<int> rids = k == 0 ? w.aux.ivWinS : w.aux.ivWinR
                int s = 2 * c + k
                array.set(w.core.sideCurrentRootCounts, s, 0)
                array.set(w.core.sideCurrentRootHeadNodeIndexes, s, -1)
                array.set(w.core.sideCurrentRootTailNodeIndexes, s, -1)
                int q = 0
                while q < array.size(rids)
                    int i = array.size(w.core.sideCurrentRootNodeRootIds)
                    array.push(w.core.sideCurrentRootNodeRootIds, array.get(rids, q))
                    array.push(w.core.sideCurrentRootNodeNextIndexes, -1)
                    array.push(w.core.sideCurrentRootNodeOwnerSideSlots, s)
                    array.push(w.core.sideCurrentRootNodeExpectedCoreIds, array.get(w.core.coreIds, c))
                    array.push(w.core.sideCurrentRootNodeExpectedGenerationIds, array.get(w.core.coreGenerationIds, c))
                    array.push(w.core.sideCurrentRootNodeLiveFlags, true)
                    int tl = array.get(w.core.sideCurrentRootTailNodeIndexes, s)
                    if tl >= 0
                        array.set(w.core.sideCurrentRootNodeNextIndexes, tl, i)
                    else
                        array.set(w.core.sideCurrentRootHeadNodeIndexes, s, i)
                    array.set(w.core.sideCurrentRootTailNodeIndexes, s, i)
                    array.set(w.core.sideCurrentRootCounts, s, array.get(w.core.sideCurrentRootCounts, s) + 1)
                    q += 1
            k += 1
    w
// ---------------- the bar transaction (Main w08ProductionRaw W09 order; local b8a txn8) ----------------
txn(HW w, HF f, bool f0) =>
    array<int>   tsx = array.new_int(0)
    array<int>   tsc = array.new_int(0)
    array<int>   d1  = array.new_int(0)
    array<int>   gbi = array.new_int(0)
    array<float> gbf = array.new_float(0)
    array<int>   gbr = array.new_int(0)
    array<int>   ei  = array.new_int(0)
    array<float> ef  = array.new_float(0)
    array<int>   fli = array.new_int(0)
    array<float> flf = array.new_float(0)
    array<int>   d3  = array.new_int(0)
    array<int>   rcs = array.new_int(0)
    array<int>   ov  = array.new_int(0)
    array.clear(w.aux.touchStartPlanSideSlots)
    array.clear(w.aux.touchStartPlanInts)
    array.clear(w.aux.touchStartPlanFloats)
    array.clear(w.aux.touchStartPlanRootIds)
    W09State.TouchStartPlanView tv0 = tvOf(w)
    bool ep = cdPlan(w, f, tv0, tsx, d1, gbi, gbf, gbr, ei, ef, fli, flf, d3, rcs, true)
    int  pas  = 0
    bool more = true
    W09State.TouchStartPlanView tv = tv0
    W09State.PhaseArmedTransferView pav = na
    W09State.SideViewMaterializeView sv = na
    while more
        tv := tvOf(w)
        if pas > 0
            ep := cdPlan(w, f, tv0, tsx, d1, gbi, gbf, gbr, ei, ef, fli, flf, d3, rcs, false)
        more := false
        if pas == 0 and ep and w.aux.fvgInverseConfirmCount > 0 and array.size(w.aux.touchStartPlanSideSlots) > 0
            tsc := array.copy(w.aux.touchStartPlanSideSlots)
            tsx := array.copy(tsc)
            pas := 1
            more := true
        else
            W09State.episodeOverlayBuild(ei, ov)
            topoBuild(w)
            array.clear(w.topo.changedTargets)
            array.clear(w.topo.changedOldCores)
            if w.topo.topoKind != TK_NONE
                array.concat(w.topo.changedTargets, array.from(0, 0, 0, w.topo.topoTgt, 0))
                array.concat(w.topo.changedOldCores, array.from(w.topo.topoTgt, 0))
                if w.topo.topoAbsd >= 0
                    array.concat(w.topo.changedOldCores, array.from(w.topo.topoAbsd, 0))
            w.topo.npc := array.size(w.topo.applyP)
            w.topo.topoOn := w.topo.topoKind != TK_NONE
            if w08Pending(w, ov)
                planClear(w)
                w.topo.topoOn := false
            tv := tvOf(w)
            array.clear(w.topo.physicalMaterializedCoreSlots)
            pav := pavOf(w)
            svFill(w, f)
            sv := svOf(w)
            if pas == 1 and ep
                array<int> out = array.new_int(0)
                ep := W09State.inverseCancelPlan(pav, sv, w.topo.candidateWinnerRootIds, w.aux.fvgInverseConfirmRootIds, w.aux.fvgInverseConfirmCount, w.core.rootIdToSlot, w.core.rootDirections, w.topo.changedTargets, w.topo.changedOldCores, tsc, out)
                if ep and array.size(out) < array.size(tsc)
                    pas := 2
                    more := true
                    tsx := out
    array<int>  txc = array.new_int(0)
    array<int>  tro = array.new_int(0)
    array<bool> tsr = array.new_bool(0)
    bool ok = ep and W09State.inverseConfirmPreflight(w.aux.fvgInverseConfirmRootIds, w.aux.fvgInverseConfirmCount, w.core.rootIdToSlot, w.core.rootStates, w.core.rootDirections)
    ok := ok and W09State.phaseArmedTransferPreflight(pav, f.mintick, txc, ov)
    ok := ok and W09State.freshTransferPlan(pav, txc, tv, ei, ef)
    ok := ok and W09State.touchHistoryTransferPlan(pav, tv, txc, f.weakFromTouch, f.weakFromTouchOff, ei, ef)
    ok := ok and W09State.bsTransferPlan(pav, tv, sv, txc, ei, ef, f.mintick, f.baseSeq, f.baseCloseTime, gbi, gbf, gbr, fli)
    ok := ok and W09State.touchStartPostPlanPreflight(tv, pav, w.core.touchMarkCapacityPerCore, 100000 - w.aux.eventLogicalCount - w.aux.fvgInverseConfirmCount, ei, tro, ef, gbi, gbf, fli)
    ok := ok and f0
    array.clear(w.aux.lastNoArm)
    if ok
        W09State.phaseArmedIndexRelease(pav, f.mintick)
        if w.topo.topoOn
            w08Commit(w)
        else
            array.concat(w.topo.physicalMaterializedCoreSlots, w.topo.physicalContinuationOldCoreSlots)
        produceRoots(w)
        W09State.freshTransferApply(pav)
        W09State.touchHistoryTransferApply(pav, tv)
        W09State.bsTransferApply(pav, w.aux.lastNoArm)
        W09State.touchStartApply(tv, pav, f.mintick, tro, tsr)
        W09State.gapBreakApply(tv, pav, gbi, gbf, gbr, tro, f.baseSeq, f.baseCloseTime, f.mintick)
        W09State.flipApply(tv, pav, fli, tro, tsr, w.aux.lastNoArm, f.baseSeq, f.mintick)
        mainSlice(w, f, tv, pav, ei, ef, tsr, tro, d1, gbi, gbf, fli, flf, d3, w.aux.lastNoArm)
        W09State.phaseArmedStageJFinalize(pav, txc, f.baseClose, f.baseSeq, f.mintick, f.touchResetDistance, f.weakFromTouch, f.weakFromTouchOff, f.strongUntilTouch, f.strongUnlimited, w.aux.lastNoArm, ei, fli, array.copy(w.aux.touchStartPlanSideSlots), gbi, f.dormantDistance, w.core.corePendingTopologyFlags, w.core.corePendingGenerationFlags, w.core.coreDormantFlags)
    ok
// ---------------- comparison ----------------
numsOf(string s) =>
    array<float> out = array.new_float(0)
    if str.length(s) > 0
        array<string> parts = str.split(s, ",")
        int i = 0
        while i < array.size(parts)
            array.push(out, str.tonumber(array.get(parts, i)))
            i += 1
    out
vecDiff(array<float> g, array<float> p) =>
    int bad = math.abs(array.size(g) - array.size(p))
    int i = 0
    while i < math.min(array.size(g), array.size(p))
        float a = array.get(g, i)
        float b = array.get(p, i)
        bool same = (na(a) and na(b)) or (not na(a) and not na(b) and math.abs(a - b) <= 0.000000001 * math.max(1.0, math.abs(a)))
        if not same
            bad += 1
        i += 1
    bad
// per-field state drift counters + first STATE capture (31 fields per live Side, golden order)
stateDiag(HM met, array<float> g, array<float> p, int gi) =>
    int i = 0
    while i < math.min(array.size(g), array.size(p))
        float a = array.get(g, i)
        float b = array.get(p, i)
        bool same = (na(a) and na(b)) or (not na(a) and not na(b) and math.abs(a - b) <= 0.000000001 * math.max(1.0, math.abs(a)))
        if not same
            array.set(met.fld, i % 31, array.get(met.fld, i % 31) + 1)
            hmFirst(met, "STATE", array.get(met.fname, i % 31), gi, int(i / 31), a, b)
        i += 1
    if array.size(g) != array.size(p)
        array.set(met.fld, FD_LEN, array.get(met.fld, FD_LEN) + 1)
        hmFirst(met, "STATE", "STATE_LENGTH", gi, -1, array.size(g), array.size(p))
    true
// Event drift capture: count mismatch first, else the first differing Event (all 12 fields kept)
eventDiag(HM met, array<float> g, array<float> p, int gi) =>
    int k = vecFirst(g, p)
    if k >= 0 and not met.hasFirst
        hmFirst(met, "EVENT", array.size(g) != array.size(p) ? "EVENT_COUNT" : array.get(met.ename, k % 12), gi, -1, array.size(g) != array.size(p) ? array.size(g) / 12 : array.get(g, k), array.size(g) != array.size(p) ? array.size(p) / 12 : array.get(p, k))
        met.fExpCount := int(array.size(g) / 12)
        met.fActCount := int(array.size(p) / 12)
        int e = int(k / 12)
        met.fEvIdx := e
        int j = 0
        while j < 12
            array.push(met.evExp, 12 * e + j < array.size(g) ? array.get(g, 12 * e + j) : na)
            array.push(met.evAct, 12 * e + j < array.size(p) ? array.get(p, 12 * e + j) : na)
            j += 1
    k
bnum(bool x) =>
    x ? 1.0 : 0.0
prodEvents(HW w) =>
    array<float> out = array.new_float(0)
    int i = 0
    while i < w.aux.eventLogicalCount
        array.push(out, array.get(w.aux.eventTypes, i))
        array.push(out, array.get(w.aux.eventTimes, i))
        array.push(out, array.get(w.aux.eventBaseSeqs, i))
        array.push(out, array.get(w.aux.eventCoreIds, i))
        array.push(out, array.get(w.aux.eventGenerationIds, i))
        array.push(out, array.get(w.aux.eventSides, i))
        array.push(out, array.get(w.aux.eventRangeBottoms, i))
        array.push(out, array.get(w.aux.eventRangeTops, i))
        array.push(out, array.get(w.aux.eventTouchNos, i))
        array.push(out, array.get(w.aux.eventGradeAtStarts, i))
        array.push(out, array.get(w.aux.eventWeakReasons, i))
        array.push(out, array.get(w.aux.eventRootIds, i))
        i += 1
    out
prodState(HW w) =>
    array<float> out = array.new_float(0)
    int s = 0
    while s < array.size(w.state.sidePhases)
        if liveOf(w, s)
            int  ph = array.get(w.state.sidePhases, s)
            bool ar = ph == PH_ARMED
            bool tv = array.get(w.state.sideTouchStartSnapshotValidFlags, s)
            bool bv = array.get(w.state.sideBreakSnapshotValidFlags, s)
            array.push(out, ph)
            array.push(out, array.get(w.state.sideGrades, s))
            array.push(out, array.get(w.state.sideTouchCounts, s))
            array.push(out, array.get(w.state.sideCurrentTouchNos, s))
            array.push(out, array.get(w.state.sideUpcomingTouchNos, s))
            array.push(out, bnum(array.get(w.state.sideWeakByTouchFlags, s)))
            array.push(out, bnum(array.get(w.state.sideWeakByDepthFlags, s)))
            array.push(out, array.get(w.state.sideMaxDepthPcts, s))
            array.push(out, bnum(array.get(w.state.sideFreshFlags, s)))
            array.push(out, ar ? array.get(w.state.sideArmedFromSeqs, s) : na)
            array.push(out, ar ? array.get(w.state.sideLastArmedRangeBottoms, s) : na)
            array.push(out, ar ? array.get(w.state.sideLastArmedRangeTops, s) : na)
            array.push(out, array.get(w.core.sideEffectiveBottoms, s))
            array.push(out, array.get(w.core.sideEffectiveTops, s))
            array.push(out, bnum(tv))
            array.push(out, tv ? array.get(w.state.sideTouchStartSnapshotRangeBottoms, s) : na)
            array.push(out, tv ? array.get(w.state.sideTouchStartSnapshotRangeTops, s) : na)
            array.push(out, tv ? array.get(w.state.sideTouchStartSnapshotCurrentTouchNos, s) : na)
            array.push(out, tv ? array.get(w.state.sideTouchStartSnapshotGrades, s) : na)
            array.push(out, tv ? array.get(w.state.sideTouchStartSnapshotMaxDepthPcts, s) : na)
            array.push(out, bnum(bv))
            array.push(out, bv ? array.get(w.state.sideBreakSnapshotRangeBottoms, s) : na)
            array.push(out, bv ? array.get(w.state.sideBreakSnapshotRangeTops, s) : na)
            array.push(out, bv ? array.get(w.state.sideBreakSnapshotOldSides, s) : na)
            array.push(out, bv ? array.get(w.state.sideBreakSnapshotBreakSeqs, s) : na)
            array.push(out, bv ? bnum(array.get(w.state.sideBreakSnapshotMovedAwayFlags, s)) : na)
            array.push(out, bv ? bnum(array.get(w.state.sideBreakSnapshotRetestSeenFlags, s)) : na)
            array.push(out, bv ? bnum(array.get(w.state.sideBreakSnapshotWasGapBreakFlags, s)) : na)
            array.push(out, array.get(w.state.sideFlipAttemptCounts, s))
            array.push(out, array.get(w.state.sideLastFlipConfirmSeqs, s))
            array.push(out, array.get(w.state.sideLastNormalTouchTimes, s))
        s += 1
    out
// ---------------- I22 state index audit (full scan Reference) ----------------
mAdd(HM met, int k, int n) =>
    array.set(met.ints, k, array.get(met.ints, k) + n)
    n
canonList(HW w) =>
    array<int> out = array.new_int(0)
    int c = 0
    while c < array.size(w.core.coreIds)
        if array.get(w.core.coreSlotLiveFlags, c) and array.get(w.core.coreIds, c) >= 1
            int k = 0
            while k < 2
                int s = 2 * c + k
                int j = 0
                bool placed = false
                while not placed and j < array.size(out)
                    int o  = array.get(out, j)
                    int co = int(o / 2)
                    bool before = array.get(w.core.coreIds, c) < array.get(w.core.coreIds, co) or (array.get(w.core.coreIds, c) == array.get(w.core.coreIds, co) and (array.get(w.core.coreGenerationIds, c) < array.get(w.core.coreGenerationIds, co) or (array.get(w.core.coreGenerationIds, c) == array.get(w.core.coreGenerationIds, co) and k < o % 2)))
                    if before
                        array.insert(out, j, s)
                        placed := true
                    j += 1
                if not placed
                    array.push(out, s)
                k += 1
        c += 1
    out
setAudit(HW w, int ph, array<int> st, HM met) =>
    int ns = array.size(w.state.sidePhases)
    int i = 0
    while i < array.size(st)
        int x = array.get(st, i)
        bool want = x >= 0 and x < ns and liveOf(w, x) and array.get(w.state.sidePhases, x) == ph
        if not want or array.indexof(st, x) != i
            mAdd(met, MX_EXTRA, 1)
        if want and array.get(w.idx.sidePhaseSetPositions, x) != i
            mAdd(met, MX_ORDER, 1)
        i += 1
    int s = 0
    while s < ns
        if liveOf(w, s) and array.get(w.state.sidePhases, s) == ph and not array.includes(st, s)
            mAdd(met, MX_MISSING, 1)
        s += 1
    true
priceAudit(HW w, int ph, array<float> key, array<int> order, array<int> pos, bool needRange, float mt, HM met) =>
    int ns = array.size(w.state.sidePhases)
    array<int> mem = array.new_int(0)
    int i = 0
    while i < array.size(order)
        int x = array.get(order, i)
        bool want = liveOf(w, x) and array.get(w.state.sidePhases, x) == ph and (not needRange or (not na(array.get(w.core.sideEffectiveBottoms, x)) and not na(array.get(w.core.sideEffectiveTops, x))))
        if not want
            mAdd(met, MX_EXTRA, 1)
        if not na(array.get(key, x))
            array.push(mem, x)
        i += 1
    int s = 0
    while s < ns
        bool want = liveOf(w, s) and array.get(w.state.sidePhases, s) == ph and (not needRange or (not na(array.get(w.core.sideEffectiveBottoms, s)) and not na(array.get(w.core.sideEffectiveTops, s))))
        if want and not array.includes(order, s)
            mAdd(met, MX_MISSING, 1)
        if not array.includes(order, s) and s < array.size(pos) and array.get(pos, s) != -1
            mAdd(met, MX_ORDER, 1)
        s += 1
    array<int> expd = orderBuild(mem, key, mt)
    bool same = array.size(expd) == array.size(order)
    i := 0
    while same and i < array.size(expd)
        same := array.get(expd, i) == array.get(order, i)
        i += 1
    if not same
        mAdd(met, MX_ORDER, 1)
    i := 0
    while i < array.size(order)
        if array.get(pos, array.get(order, i)) != i
            mAdd(met, MX_ORDER, 1)
        i += 1
    mAdd(met, MX_IDXCHK, 1)
    true
indexAudit(HW w, HF f, HM met) =>
    int p = 0
    while p < 6
        setAudit(w, p, phaseSet(w, p), met)
        p += 1
    priceAudit(w, PH_ARMED, w.state.sideLastArmedRangeBottoms, w.idx.armedEffectiveBottomOrderSideSlots, w.idx.sideArmedEffectiveBottomOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_ARMED, w.state.sideLastArmedRangeTops, w.idx.armedEffectiveTopOrderSideSlots, w.idx.sideArmedEffectiveTopOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_BROKEN, w.state.sideBreakSnapshotRangeBottoms, w.idx.brokenSnapshotBottomOrderSideSlots, w.idx.sideBrokenSnapshotBottomOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_BROKEN, w.state.sideBreakSnapshotRangeTops, w.idx.brokenSnapshotTopOrderSideSlots, w.idx.sideBrokenSnapshotTopOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_FLIP_WAIT, w.state.sideBreakSnapshotRangeBottoms, w.idx.flipSnapshotBottomOrderSideSlots, w.idx.sideFlipSnapshotBottomOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_FLIP_WAIT, w.state.sideBreakSnapshotRangeTops, w.idx.flipSnapshotTopOrderSideSlots, w.idx.sideFlipSnapshotTopOrderPositions, false, f.mintick, met)
    priceAudit(w, PH_WAITING, w.core.sideEffectiveBottoms, w.idx.waitingBottomOrderSideSlots, w.idx.waitingBottomPositions, true, f.mintick, met)
    priceAudit(w, PH_WAITING, w.core.sideEffectiveTops, w.idx.waitingTopOrderSideSlots, w.idx.waitingTopPositions, true, f.mintick, met)
    priceAudit(w, PH_DORMANT, w.core.sideEffectiveBottoms, w.idx.dormantRecoveryBottomOrderSideSlots, w.idx.sideDormantRecoveryBottomOrderPositions, true, f.mintick, met)
    priceAudit(w, PH_DORMANT, w.core.sideEffectiveTops, w.idx.dormantRecoveryTopOrderSideSlots, w.idx.sideDormantRecoveryTopOrderPositions, true, f.mintick, met)
    true
// D1 (TouchStart / GapBreak) and BreakSnapshot (Flip / Reclaim) targets of the bar-start state vs a full-scan predicate
targetAudit(HW w, HF f, HM met) =>
    float mt = f.mintick
    int hT = tkOf(f.baseHigh, mt)
    int lT = tkOf(f.baseLow, mt)
    int cT = tkOf(f.baseClose, mt)
    int tl = tkOf(f.touchTolerance, mt)
    int bb = tkOf(f.breakBuffer, mt)
    int rd = tkOf(f.touchResetDistance, mt)
    array<int> L = canonList(w)
    array<int> rD = array.new_int(0)
    array<int> rB = array.new_int(0)
    int i = 0
    while i < array.size(L)
        int s = array.get(L, i)
        bool sup = s % 2 == 0
        int afs = array.get(w.state.sideArmedFromSeqs, s)
        if array.get(w.state.sidePhases, s) == PH_ARMED and array.get(w.core.sideEligibleFlags, s) and not na(afs) and afs >= 0 and afs <= f.baseSeq
            int bT = tkOf(array.get(w.state.sideLastArmedRangeBottoms, s), mt)
            int tT = tkOf(array.get(w.state.sideLastArmedRangeTops, s), mt)
            bool tch = bT == tT ? (lT - tl <= bT and bT <= hT + tl) : (bT <= hT and tT >= lT)
            bool gap = sup ? (hT < bT and cT <= bT - bb) : (lT > tT and cT >= tT + bb)
            if tch or gap
                array.push(rD, s)
        if array.get(w.state.sidePhases, s) == PH_BROKEN and array.get(w.state.sideBreakSnapshotValidFlags, s)
            int bT = tkOf(array.get(w.state.sideBreakSnapshotRangeBottoms, s), mt)
            int tT = tkOf(array.get(w.state.sideBreakSnapshotRangeTops, s), mt)
            bool mvc = sup ? bT >= cT + rd : tT <= cT - rd
            bool con = bT <= hT and tT >= lT
            bool ex  = sup ? bT >= hT + 1 : tT <= lT - 1
            bool rc  = sup ? tT <= cT - bb : bT >= cT + bb
            if mvc or con or ex or rc
                array.push(rB, s)
        i += 1
    array<int> oD = array.new_int(0)
    bool okD = W09State.d1TargetSlots(w.idx.armedEffectiveBottomOrderSideSlots, w.idx.sideArmedEffectiveBottomOrderPositions, w.idx.armedEffectiveTopOrderSideSlots, w.idx.sideArmedEffectiveTopOrderPositions, w.state.sideLastArmedRangeBottoms, w.state.sideLastArmedRangeTops, mt, f.baseHigh, f.baseLow, f.baseClose, f.touchTolerance, f.breakBuffer, w.state.sidePhases, w.core.sideEligibleFlags, w.state.sideArmedFromSeqs, f.baseSeq, w.core.coreIds, w.core.coreGenerationIds, w.core.coreSlotLiveFlags, w.core.coreIdToSlot, oD)
    array<int> oB = array.new_int(0)
    bool okB = W09State.bsTargetSlots(w.idx.brokenSnapshotBottomOrderSideSlots, w.idx.sideBrokenSnapshotBottomOrderPositions, w.idx.brokenSnapshotTopOrderSideSlots, w.idx.sideBrokenSnapshotTopOrderPositions, w.state.sideBreakSnapshotRangeBottoms, w.state.sideBreakSnapshotRangeTops, mt, f.baseHigh, f.baseLow, f.baseClose, f.touchResetDistance, f.breakBuffer, oB)
    if not okD or not okB
        mAdd(met, MX_RESULT, 1)
    int k = 0
    while k < 2
        array<int> r = k == 0 ? rD : rB
        array<int> o = k == 0 ? oD : oB
        int j = 0
        while j < array.size(r)
            if not array.includes(o, array.get(r, j))
                mAdd(met, MX_MISSING, 1)
            j += 1
        j := 0
        while j < array.size(o)
            if not array.includes(r, array.get(o, j))
                mAdd(met, MX_EXTRA, 1)
            j += 1
        k += 1
    bool same = array.size(rD) == array.size(oD)
    i := 0
    while same and i < array.size(rD)
        same := array.get(rD, i) == array.get(oD, i)
        i += 1
    if not same and array.size(rD) == array.size(oD)
        mAdd(met, MX_ORDER, 1)
    true
// ---------------- one bar: I22 pre audit, Stage B, transaction, I22 post audit, golden comparison ----------------
hbar(HW w, HF f, array<string> gold, HM met, string tag, float hi, float lo, float cl, bool f0) =>
    f.baseHigh  := hi
    f.baseLow   := lo
    f.baseClose := cl
    indexAudit(w, f, met)
    targetAudit(w, f, met)
    w.aux.eventLogicalCount := 0
    array.clear(w.aux.eventTypes)
    array.clear(w.aux.eventTimes)
    array.clear(w.aux.eventBaseSeqs)
    array.clear(w.aux.eventCoreIds)
    array.clear(w.aux.eventGenerationIds)
    array.clear(w.aux.eventSides)
    array.clear(w.aux.eventRangeBottoms)
    array.clear(w.aux.eventRangeTops)
    array.clear(w.aux.eventTouchNos)
    array.clear(w.aux.eventGradeAtStarts)
    array.clear(w.aux.eventWeakReasons)
    array.clear(w.aux.eventRootIds)
    array<int> ph0 = array.copy(w.state.sidePhases)
    array<int> up0 = array.copy(w.state.sideUpcomingTouchNos)
    bool ok = txn(w, f, f0)
    if ok
        indexAudit(w, f, met)
    int gi = array.get(met.ints, MX_GOLD)
    mAdd(met, MX_GOLD, 1)
    mAdd(met, MX_BARS, 1)
    met.scenBar += 1
    if gi >= array.size(gold)
        mAdd(met, MX_STATE, 1)
        hmFirst(met, "GOLDEN", "GOLDEN_EXHAUSTED", gi, -1, array.size(gold), gi)
    else
        array<string> g = str.split(array.get(gold, gi), "|")
        array.set(met.runs, RN_CMP, array.get(met.runs, RN_CMP) + 1)
        if array.get(g, 0) != tag
            mAdd(met, MX_STATE, 1)
            if not met.hasFirst
                hmFirst(met, "TAG", "TAG", gi, -1, na, na)
                met.fExpTag := array.get(g, 0)
                met.fActTag := tag
        if ok != (array.get(g, 5) == "1")
            mAdd(met, MX_RUNTIME, 1)
            hmFirst(met, "RUNTIME", "TXN_OK", gi, -1, array.get(g, 5) == "1" ? 1.0 : 0.0, ok ? 1.0 : 0.0)
        array<float> ge = numsOf(array.get(g, 1))
        array<float> pe = prodEvents(w)
        if vecDiff(ge, pe) > 0
            mAdd(met, MX_EVENT, 1)
            eventDiag(met, ge, pe, gi)
        array<float> gs = numsOf(array.get(g, 2))
        array<float> ps = prodState(w)
        mAdd(met, MX_STATE, vecDiff(gs, ps))
        stateDiag(met, gs, ps, gi)
        array<float> zf = numsOf(array.get(g, 3))
        array<float> cd = numsOf(array.get(g, 4))
        int c = 0
        int k = 0
        while c < array.size(w.core.coreIds)
            if array.get(w.core.coreSlotLiveFlags, c)
                if k < array.size(zf) and array.get(zf, k) != bnum(array.get(w.core.coreZoneFreshFlags, c))
                    mAdd(met, MX_STATE, 1)
                    array.set(met.fld, FD_ZF, array.get(met.fld, FD_ZF) + 1)
                    hmFirst(met, "STATE", "ZONE_FRESH", gi, c, array.get(zf, k), bnum(array.get(w.core.coreZoneFreshFlags, c)))
                bool touched = false
                int j = 0
                while j < 2
                    int s = 2 * c + j
                    touched := touched or array.get(w.state.sidePhases, s) != array.get(ph0, s) or array.get(w.state.sideUpcomingTouchNos, s) != array.get(up0, s) or array.includes(w.aux.lastNoArm, s)
                    j += 1
                if touched and k < array.size(cd) and array.get(cd, k) != bnum(array.get(w.core.coreDormantFlags, c))
                    mAdd(met, MX_STATE, 1)
                    array.set(met.fld, FD_CD, array.get(met.fld, FD_CD) + 1)
                    hmFirst(met, "STATE", "CORE_DORMANT", gi, c, array.get(cd, k), bnum(array.get(w.core.coreDormantFlags, c)))
                k += 1
            c += 1
    // next bar
    f.baseSeq       := f.baseSeq + 1
    f.baseCloseTime := f.baseSeq * BAR_MS
    w.topo.topoKind := TK_NONE
    w.topo.topoTgt  := -1
    w.topo.topoAbsd := -1
    w.topo.topoRngB := na
    w.topo.topoRngT := na
    array.clear(w.core.journalOps)
    array.clear(w.core.journalGroups)
    array.clear(w.core.journalExpectedRootIds)
    w.core.journalCount := 0
    map.clear(w.core.rootIdToSlot)
    array.clear(w.core.rootStates)
    array.clear(w.core.rootSlotLiveFlags)
    array.clear(w.core.rootDirections)
    array.clear(w.core.rootNativeBottoms)
    array.clear(w.core.rootNativeTops)
    array.clear(w.aux.fvgInverseConfirmRootIds)
    w.aux.fvgInverseConfirmCount := 0
    array.clear(w.aux.ivWinS)
    array.clear(w.aux.ivWinR)
    w.aux.ivWinSSet := false
    w.aux.ivWinRSet := false
    ok
bar(HW w, HF f, array<string> gold, HM met, string tag, float hi, float lo, float cl) =>
    hbar(w, f, gold, met, tag, hi, lo, cl, true)
cont(HW w, float rb, float rt) =>
    topoSpec(w, TK_CONT, 0, -1, rb, rt)
start(HW w, HF f) =>
    w.topo.topoKind := TK_NONE
    w.topo.topoTgt  := -1
    w.topo.topoAbsd := -1
    finishW(w, f)

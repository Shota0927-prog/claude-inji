// ---------------- display ----------------
var table tb = table.new(position.top_right, 4, 40, border_width = 1)
cellKV(table t, int col, int row, string k, string v) =>
    table.cell(t, col, row, k, text_size = size.tiny)
    table.cell(t, col + 1, row, v, text_size = size.tiny)
    true
fstr(float x) =>
    na(x) ? "na" : str.tostring(x)
if barstate.islast
    HM met = hmNew()
    array<bool> cpass = array.new_bool(0)
    runAll(met, cpass)
    int passed = 0
    int k = 0
    while k < 24
        passed += array.get(cpass, k) ? 1 : 0
        k += 1
    int extra = 0
    while k < array.size(cpass)
        extra += array.get(cpass, k) ? 0 : 1
        k += 1
    int idxBad = array.get(met.ints, MX_MISSING) + array.get(met.ints, MX_EXTRA) + array.get(met.ints, MX_ORDER) + array.get(met.ints, MX_RESULT)
    bool i22 = idxBad == 0 and array.get(met.ints, MX_IDXCHK) > 0
    bool allOk = passed == 24 and extra == 0 and i22 and array.get(met.ints, MX_STATE) == 0 and array.get(met.ints, MX_EVENT) == 0 and array.get(met.ints, MX_RUNTIME) == 0 and array.get(met.ints, MX_GOLD) == 81
    table.cell(tb, 0, 0, "W09_CONFORMANCE_PASS", text_size = size.tiny)
    table.cell(tb, 1, 0, allOk ? "PASS" : "FAIL", text_size = size.tiny, bgcolor = allOk ? color.new(color.green, 60) : color.new(color.red, 40))
    cellKV(tb, 0, 1, "APPENDIX_B_W09_PASSED", str.tostring(passed))
    cellKV(tb, 0, 2, "APPENDIX_B_W09_TOTAL", "24")
    cellKV(tb, 0, 3, "APPENDIX_B_W09_FAILED", str.tostring(24 - passed))
    cellKV(tb, 0, 4, "I22_STATE_INDEX_PASS", i22 ? "PASS" : "FAIL")
    cellKV(tb, 0, 5, "STATE_INDEX_MISSING", str.tostring(array.get(met.ints, MX_MISSING)))
    cellKV(tb, 0, 6, "STATE_INDEX_EXTRA", str.tostring(array.get(met.ints, MX_EXTRA)))
    cellKV(tb, 0, 7, "STATE_INDEX_ORDER_DRIFT", str.tostring(array.get(met.ints, MX_ORDER)))
    cellKV(tb, 0, 8, "STATE_INDEX_RESULT_DRIFT", str.tostring(array.get(met.ints, MX_RESULT)))
    cellKV(tb, 0, 9, "EVENT_DRIFT_TOTAL", str.tostring(array.get(met.ints, MX_EVENT)))
    cellKV(tb, 0, 10, "STATE_DRIFT_TOTAL", str.tostring(array.get(met.ints, MX_STATE)))
    cellKV(tb, 0, 11, "RUNTIME_ERROR_COUNT", str.tostring(array.get(met.ints, MX_RUNTIME)))
    cellKV(tb, 0, 12, "X1_PASS", array.get(cpass, 24) ? "PASS" : "FAIL")
    cellKV(tb, 0, 13, "X2_PASS", array.get(cpass, 25) ? "PASS" : "FAIL")
    cellKV(tb, 0, 14, "X3_PASS", array.get(cpass, 26) ? "PASS" : "FAIL")
    cellKV(tb, 0, 15, "BARS_RUN (Reference bars + topology runs)", str.tostring(array.get(met.ints, MX_BARS)))
    cellKV(tb, 0, 16, "GOLDEN_CONSUMED / GOLDEN_TOTAL", str.tostring(array.get(met.ints, MX_GOLD)) + " / 81")
    cellKV(tb, 0, 17, "INDEX_CHECKS", str.tostring(array.get(met.ints, MX_IDXCHK)))
    cellKV(tb, 0, 18, "RUN_COUNT runAll / goldInit / goldXInit", str.tostring(array.get(met.runs, RN_RUNALL)) + " / " + str.tostring(array.get(met.runs, RN_GOLD)) + " / " + str.tostring(array.get(met.runs, RN_GOLDX)))
    cellKV(tb, 0, 19, "RUN_COUNT X1 / X2 / X3", str.tostring(array.get(met.runs, 24)) + " / " + str.tostring(array.get(met.runs, 25)) + " / " + str.tostring(array.get(met.runs, 26)))
    int rmin = 999
    int rmax = 0
    k := 0
    while k < 27
        rmin := math.min(rmin, array.get(met.runs, k))
        rmax := math.max(rmax, array.get(met.runs, k))
        k += 1
    cellKV(tb, 0, 20, "RUN_COUNT per case min / max (27 cases)", str.tostring(rmin) + " / " + str.tostring(rmax))
    cellKV(tb, 0, 21, "COMPARISON_COUNT", str.tostring(array.get(met.runs, RN_CMP)))
    cellKV(tb, 0, 22, "FIRST_DRIFT_SCENARIO", met.hasFirst ? met.fScen : "none")
    cellKV(tb, 0, 23, "FIRST_DRIFT_BAR_INDEX", str.tostring(met.fBar))
    cellKV(tb, 0, 24, "FIRST_DRIFT_GOLDEN_INDEX", str.tostring(met.fGold))
    cellKV(tb, 0, 25, "FIRST_DRIFT_KIND", met.fKind)
    cellKV(tb, 0, 26, "FIRST_DRIFT_FIELD", met.fField)
    cellKV(tb, 0, 27, "FIRST_DRIFT_SIDE / CORE", str.tostring(met.fSide))
    cellKV(tb, 0, 28, "EXPECTED / ACTUAL", fstr(met.fExp) + " / " + fstr(met.fAct))
    cellKV(tb, 0, 29, "EXPECTED_TAG / ACTUAL_TAG", met.fExpTag + " / " + met.fActTag)
    cellKV(tb, 0, 30, "EVENT_INDEX / EXPECTED_COUNT / ACTUAL_COUNT", str.tostring(met.fEvIdx) + " / " + str.tostring(met.fExpCount) + " / " + str.tostring(met.fActCount))
    string ee = ""
    string ea = ""
    k := 0
    while k < array.size(met.evExp)
        ee += (k > 0 ? "," : "") + fstr(array.get(met.evExp, k))
        ea += (k > 0 ? "," : "") + fstr(array.get(met.evAct, k))
        k += 1
    cellKV(tb, 0, 31, "EVENT_EXPECTED (type,time,seq,core,gen,side,b,t,no,grade,weak,root)", ee)
    cellKV(tb, 0, 32, "EVENT_ACTUAL", ea)
    k := 0
    while k < 35
        cellKV(tb, 2, k, array.get(met.fname, k) + "_DRIFT", str.tostring(array.get(met.fld, k)))
        k += 1
plot(0, "zero", display = display.none)

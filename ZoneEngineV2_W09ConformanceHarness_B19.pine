// 68 / 69: Merge / Split TouchMark history (real W08Touch /7 plan) against the Reference golden marks / history
markCmp(HW w, int c, string gm, HM met) =>
    array<string> rows = str.length(gm) > 0 ? str.split(gm, ";") : array.new_string(0)
    int cap = w.core.touchMarkCapacityPerCore
    int n = array.get(w.aux.touchMarkRingCounts, c)
    array<bool> used = array.new_bool(n, false)
    int bad = math.abs(array.size(rows) - n)
    int i = 0
    while i < array.size(rows)
        array<float> r = numsOf(array.get(rows, i))
        bool hit = false
        int j = 0
        while not hit and j < n
            int x = c * cap + (array.get(w.aux.touchMarkRingHeads, c) + j) % cap
            array<float> p = array.from(float(array.get(w.aux.touchMarkBaseSeqs, x)), float(array.get(w.aux.touchMarkTimes, x)), float(array.get(w.aux.touchMarkSides, x)), array.get(w.aux.touchMarkContactBottoms, x), array.get(w.aux.touchMarkContactTops, x), array.get(w.aux.touchMarkCloseAtTouches, x), float(array.get(w.aux.touchMarkGenerationIds, x)), bnum(array.get(w.aux.touchMarkIsNormalTouchFlags, x)), float(array.get(w.aux.touchMarkTouchNos, x)), bnum(array.get(w.aux.touchMarkWeakByDepthFlags, x)), array.get(w.aux.touchMarkMaxDepthPcts, x))
            if not array.get(used, j) and vecDiff(r, p) == 0
                hit := true
                array.set(used, j, true)
            j += 1
        if not hit
            bad += 1
        i += 1
    mAdd(met, MX_STATE, bad)
    if bad > 0
        array.set(met.fld, FD_TOPO, array.get(met.fld, FD_TOPO) + bad)
        hmFirst(met, "TOPO", "TOPO_MARK", -1, c, array.size(rows), n)
    bad
histCmp(HW w, string gh, HM met) =>
    array<float> g = numsOf(gh)
    array<float> p = array.new_float(0)
    int k = 0
    while k < 2
        array.push(p, array.get(w.state.sideTouchCounts, k))
        array.push(p, bnum(array.get(w.state.sideWeakByDepthFlags, k)))
        array.push(p, array.get(w.state.sideMaxDepthPcts, k))
        array.push(p, array.get(w.state.sideLastNormalTouchTimes, k))
        array.push(p, bnum(array.get(w.state.sideWeakByTouchFlags, k)))
        array.push(p, bnum(array.get(w.state.sideFreshFlags, k)))
        if array.get(w.state.sideCurrentTouchNos, k) != 0
            mAdd(met, MX_STATE, 1)
            hmFirst(met, "TOPO", "TOPO_CURRENT_TOUCH_NO", -1, k, 0, array.get(w.state.sideCurrentTouchNos, k))
        k += 1
    int hk = vecFirst(g, p)
    if hk >= 0
        array.set(met.fld, FD_TOPO, array.get(met.fld, FD_TOPO) + vecDiff(g, p))
        hmFirst(met, "TOPO", "TOPO_HISTORY_" + str.tostring(hk), -1, int(hk / 6), hk < array.size(g) ? array.get(g, hk) : na, hk < array.size(p) ? array.get(p, hk) : na)
    mAdd(met, MX_STATE, vecDiff(g, p))
topoRun(HW w, HF f, HM met) =>
    f.baseHigh  := 125.0
    f.baseLow   := 124.0
    f.baseClose := 124.0
    indexAudit(w, f, met)
    targetAudit(w, f, met)
    w.aux.eventLogicalCount := 0
    bool ok = txn(w, f, true)
    if ok
        indexAudit(w, f, met)
    else
        mAdd(met, MX_RUNTIME, 1)
    if w.aux.eventLogicalCount != 0
        mAdd(met, MX_EVENT, 1)
        hmFirst(met, "TOPO", "TOPO_EVENT_COUNT", -1, -1, 0, w.aux.eventLogicalCount)
    mAdd(met, MX_BARS, 1)
    ok
mk(HW w, int c, int seq, int side, float cb, float ct, float cl, bool weak, float mx) =>
    rpush(w, c, seq, side, cb, ct, cl, true, 1, weak, mx)
histFix(HW w, int c) =>
    // the Side history of Core c from its normal marks (fixture consistency, local A68)
    int cap = w.core.touchMarkCapacityPerCore
    int k = 0
    while k < 2
        int sd = k == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE
        int s = 2 * c + k
        int n = 0
        bool wd = false
        float mx = 0.0
        int last = int(na)
        int j = 0
        while j < array.get(w.aux.touchMarkRingCounts, c)
            int x = c * cap + (array.get(w.aux.touchMarkRingHeads, c) + j) % cap
            if array.get(w.aux.touchMarkSides, x) == sd and array.get(w.aux.touchMarkIsNormalTouchFlags, x)
                n += 1
                wd := wd or array.get(w.aux.touchMarkWeakByDepthFlags, x)
                mx := math.max(mx, array.get(w.aux.touchMarkMaxDepthPcts, x))
                last := na(last) ? array.get(w.aux.touchMarkTimes, x) : math.max(last, array.get(w.aux.touchMarkTimes, x))
            j += 1
        array.set(w.state.sideTouchCounts, s, n)
        array.set(w.state.sideFreshFlags, s, n == 0)
        array.set(w.state.sideWeakByDepthFlags, s, wd)
        array.set(w.state.sideMaxDepthPcts, s, mx)
        array.set(w.state.sideLastNormalTouchTimes, s, last)
        k += 1
    array.set(w.core.coreZoneFreshFlags, c, array.get(w.aux.touchMarkRingCounts, c) == 0)
    w
s68one(array<string> gx, HM met, int k) =>
    HF f = hfNew(500.0, 2.0)
    HW w = wNew(2, true)
    if k == 0
        mk(w, 0, 30, 1, 101.0, 103.0, 101.0, false, 10.0)
        mk(w, 1, 30, 1, 101.0, 103.0, 102.0, true, 40.0)
    else if k == 1
        mk(w, 0, 30, 1, 101.0, 103.0, 101.0, false, 0.0)
        mk(w, 0, 36, -1, 104.0, 106.0, 104.0, false, 0.0)
        mk(w, 1, 30, 1, 101.0, 103.0, 101.0, true, 70.0)
        mk(w, 1, 35, 1, 104.0, 106.0, 104.0, false, 0.0)
        mk(w, 1, 36, -1, 104.0, 106.0, 104.0, false, 0.0)
    else
        mk(w, 0, 30, 1, 101.0, 103.0, 101.0, false, 0.0)
        mk(w, 1, 30, 1, 101.0, 104.0, 101.0, true, 70.0)
    histFix(w, 0)
    histFix(w, 1)
    start(w, f)
    W08Touch.TouchPlan tp = W08Touch.TouchPlan.new(array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_bool(0), array.new_float(0))
    int r = W08Touch.mergePlanBuild(ringOf(w), tp, 1, 1, array.from(0, 0, array.get(w.core.coreIds, 0), 0, 1), array.from(1, array.get(w.core.coreIds, 1)), 1, array.from(0), array.from(1), array.from(100.0, 110.0, 100.0, 110.0), array.new_int(0), array.new_float(0), array.new_int(0), array.new_float(0))
    if r != 1
        mAdd(met, MX_RESULT, 1)
    topoSpec(w, TK_MERGE, 0, 1, 100.0, 110.0)
    w.topo.topoTruncS := array.size(tp.mergeTouchPlanTruncatedFlags) > 0 and array.get(tp.mergeTouchPlanTruncatedFlags, 0)
    w.topo.topoTruncR := array.size(tp.mergeTouchPlanTruncatedFlags) > 1 and array.get(tp.mergeTouchPlanTruncatedFlags, 1)
    int i = 0
    while i < array.size(tp.mergeTouchPlanTimes)
        tpPush(w, array.get(tp.mergeTouchPlanBaseSeqs, i), array.get(tp.mergeTouchPlanTimes, i), array.get(tp.mergeTouchPlanSides, i), array.get(tp.mergeTouchPlanContactBottoms, i), array.get(tp.mergeTouchPlanContactTops, i), array.get(tp.mergeTouchPlanCloseAtTouches, i), array.get(tp.mergeTouchPlanGenerationIds, i), array.get(tp.mergeTouchPlanIsNormalFlags, i), array.get(tp.mergeTouchPlanTouchNos, i), array.get(tp.mergeTouchPlanWeakByDepthFlags, i), array.get(tp.mergeTouchPlanMaxDepthPcts, i))
        i += 1
    bool zf0 = array.get(w.core.coreZoneFreshFlags, 0) and array.get(w.core.coreZoneFreshFlags, 1)
    topoRun(w, f, met)
    array<string> gg = str.split(array.get(gx, k), "|")
    markCmp(w, 0, array.get(gg, 1), met)
    histCmp(w, array.get(gg, 2), met)
    if array.get(w.core.coreZoneFreshFlags, 0) != zf0 or bnum(zf0) != str.tonumber(array.get(gg, 3))
        mAdd(met, MX_STATE, 1)
    true

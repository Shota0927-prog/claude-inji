    s68one(gx, m, 0)
    s68one(gx, m, 1)
    s68one(gx, m, 2)
    true
s69one(array<string> gx, HM met, int k, float b0, float t0, float b1, float t1) =>
    HF f = hfNew(500.0, 2.0)
    HW w = wNew(1, true)
    mk(w, 0, 30, 1, 101.0, 102.0, 101.0, false, 10.0)
    mk(w, 0, 32, 1, 104.0, 106.0, 104.0, true, 60.0)
    mk(w, 0, 34, -1, 107.0, 109.0, 107.0, false, 0.0)
    mk(w, 0, 36, 1, 108.0, 109.0, 108.0, false, 20.0)
    array.set(w.state.sideTouchCounts, 0, 3)
    array.set(w.state.sideTouchCounts, 1, 1)
    array.set(w.state.sideFreshFlags, 0, false)
    array.set(w.state.sideFreshFlags, 1, false)
    array.set(w.core.coreZoneFreshFlags, 0, false)
    array.set(w.state.sideWeakByDepthFlags, 0, true)
    array.set(w.state.sideMaxDepthPcts, 0, 60.0)
    start(w, f)
    W08Touch.SplitTouchPlan sp = W08Touch.SplitTouchPlan.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_bool(0), array.new_float(0))
    int r = W08Touch.splitPlanBuild(ringOf(w), sp, 1, 1, array.from(0, array.get(w.core.coreIds, 0), 0, 0, 2), array.from(0, 1), 0, 0, array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), 2, array.from(0, 2), array.from(1, 3), array.from(b0, t0, b0, t0, b1, t1, b1, t1), array.new_int(0), array.new_float(0), array.new_int(0), array.new_float(0))
    if r != 2
        mAdd(met, MX_RESULT, 1)
    array<string> gg = str.split(array.get(gx, 3 + k), "|")
    array<string> ch = str.split(array.get(gg, 4), "/")
    int c = 0
    while r == 2 and c < 2
        array<string> rows = str.length(array.get(ch, c)) > 0 ? str.split(array.get(ch, c), ";") : array.new_string(0)
        int off = array.get(sp.markOffsets, c)
        int n = array.get(sp.markCounts, c)
        int bad = math.abs(array.size(rows) - n)
        int ii = 0
        while ii < math.min(n, array.size(rows))
            int x = off + ii
            array<float> p = array.from(float(array.get(sp.baseSeqs, x)), float(array.get(sp.times, x)), float(array.get(sp.sides, x)), array.get(sp.contactBottoms, x), array.get(sp.contactTops, x), array.get(sp.closeAtTouches, x), float(array.get(sp.generationIds, x)), bnum(array.get(sp.isNormalFlags, x)), float(array.get(sp.touchNos, x)), bnum(array.get(sp.weakByDepthFlags, x)), array.get(sp.maxDepthPcts, x))
            if vecDiff(numsOf(array.get(rows, ii)), p) > 0
                bad += 1
            ii += 1
        mAdd(met, MX_STATE, bad)
        c += 1
    topoSpec(w, TK_SPLIT, 0, -1, b0, t0)
    int i = 0
    while r == 2 and i < array.get(sp.markCounts, 0)
        int x = array.get(sp.markOffsets, 0) + i
        tpPush(w, array.get(sp.baseSeqs, x), array.get(sp.times, x), array.get(sp.sides, x), array.get(sp.contactBottoms, x), array.get(sp.contactTops, x), array.get(sp.closeAtTouches, x), array.get(sp.generationIds, x), array.get(sp.isNormalFlags, x), array.get(sp.touchNos, x), array.get(sp.weakByDepthFlags, x), array.get(sp.maxDepthPcts, x))
        i += 1
    topoRun(w, f, met)
    markCmp(w, 0, array.get(gg, 1), met)
    histCmp(w, array.get(gg, 2), met)
    true

type HW
    HWCore core
    HWState state
    HWIndex idx
    HWTopo topo
    HWAux aux

hwNew(int nc, int cap) =>
    HW w = HW.new()
    w.core := HWCore.new()
    w.state := HWState.new()
    w.idx := HWIndex.new()
    w.topo := HWTopo.new()
    w.aux := HWAux.new()
    w.core.coreIds := array.new_int(nc, 0)
    w.core.coreGenerationIds := array.new_int(nc, 3)
    w.core.coreSlotLiveFlags := array.new_bool(nc, true)
    w.core.coreIdToSlot := map.new<int, int>()
    w.state.sidePhases := array.new_int(2 * nc, 0)
    w.state.sideArmedFromSeqs := array.new_int(2 * nc, -1)
    w.state.sideLastArmedRangeBottoms := array.new_float(2 * nc)

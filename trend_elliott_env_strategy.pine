bool elliottEnvCompute  = useElliottEnvEnv and (useElliottEnvBias or elliottEnvShowTable or elliottEnvWantDraw)
// ⑤波警戒がエントリーへ影響するか (既定OFF=表示のみ → 既定でエントリーを禁止しない)

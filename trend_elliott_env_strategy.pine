if elliottEnvCompute and useElliottEnv1M
    [_b, _rs, _rem, _dir, _sc, _rk, _st, _w3l, _w3s, _w5l, _w5s, _cl, _cs, _wl, _ws, _ml, _ms, _el, _es, _vc, _rdl, _rds, _mdl, _mds, _oel, _oes, _pc, _cf, _dm, _p0, _p1, _p2, _p3, _p4, _p5, _t0, _t1, _t2, _t3, _t4, _t5] = request.security(syminfo.tickerid, elliottEnv1MTF, f_elliottEnvConfirmed(elliottEnvHold1M), lookahead = barmerge.lookahead_on)
    elliottEnv1M := _b
    elliottEnv1MRem := _rem
    elliottEnv1MReason := _rs
    elliottEnv1MRank := _rk
    elliottEnv1MW3L := _w3l
    elliottEnv1MW3S := _w3s

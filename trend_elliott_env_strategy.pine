    elliottEnv1MWarnS := _ws
    if elliottEnvLabelTF == "1M"
        elLblDrawMode := _dm
        elLblD0P := _p0
        elLblD1P := _p1
        elLblD2P := _p2
        elLblD3P := _p3
        elLblD4P := _p4
        elLblD5P := _p5

    elliottEnv15M := _b
    elliottEnv15MRem := _rem
    elliottEnv15MReason := _rs
    elliottEnv15MRank := _rk
    elliottEnv15MW3L := _w3l
    elliottEnv15MW3S := _w3s
    elliottEnv15MW5L := _w5l
    elliottEnv15MW5S := _w5s
    elliottEnv15MWarnL := _wl
    elliottEnv15MWarnS := _ws
    if elliottEnvLabelTF == "15M"
        elLblDrawMode := _dm
        elLblD0P := _p0
        elLblD1P := _p1
        elLblD2P := _p2
        elLblD3P := _p3
        elLblD4P := _p4

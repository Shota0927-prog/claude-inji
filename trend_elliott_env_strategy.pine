        elLblMacdDivS := _mds
        elLblOverExtL := _oel
        elLblOverExtS := _oes
        elLblRank := _rk

// --- 統合 (HigherTF: 上位足優先で最初の非ゼロ / WeightedScore: 重み合計を閾値判定・双方向) ---
int elliottEnvHigherTF =
     (useElliottEnvD   and elliottEnvD   != 0) ? elliottEnvD   :
     (useElliottEnv4H  and elliottEnv4H  != 0) ? elliottEnv4H  :
     (useElliottEnv1H  and elliottEnv1H  != 0) ? elliottEnv1H  :
     (useElliottEnv15M and elliottEnv15M != 0) ? elliottEnv15M :
     (useElliottEnv5M  and elliottEnv5M  != 0) ? elliottEnv5M  :
     (useElliottEnv1M  and elliottEnv1M  != 0) ? elliottEnv1M  : 0
int elliottEnvScoreVal = (useElliottEnvD ? elliottEnvWeightD * elliottEnvD : 0) + (useElliottEnv4H ? elliottEnvWeight4H * elliottEnv4H : 0) + (useElliottEnv1H ? elliottEnvWeight1H * elliottEnv1H : 0) + (useElliottEnv15M ? elliottEnvWeight15M * elliottEnv15M : 0) + (useElliottEnv5M ? elliottEnvWeight5M * elliottEnv5M : 0) + (useElliottEnv1M ? elliottEnvWeight1M * elliottEnv1M : 0)
int elliottEnvWeighted = elliottEnvScoreVal >= elliottEnvScoreThreshold ? 1 : elliottEnvScoreVal <= -elliottEnvScoreThreshold ? -1 : 0
int elliottEnvBiasRaw = not useElliottEnvEnv ? 0 : elliottEnvCombineMode == "HigherTF" ? elliottEnvHigherTF : elliottEnvWeighted

// --- 統合 ⑤波警戒 (反対方向 bias へ加算しない。使用中の足のみ集計) ---
bool elliottEnvCombLongWarn = (useElliottEnvD and elliottEnvDWarnL) or (useElliottEnv4H and elliottEnv4HWarnL) or (useElliottEnv1H and elliottEnv1HWarnL) or (useElliottEnv15M and elliottEnv15MWarnL) or (useElliottEnv5M and elliottEnv5MWarnL) or (useElliottEnv1M and elliottEnv1MWarnL)
bool elliottEnvCombShortWarn = (useElliottEnvD and elliottEnvDWarnS) or (useElliottEnv4H and elliottEnv4HWarnS) or (useElliottEnv1H and elliottEnv1HWarnS) or (useElliottEnv15M and elliottEnv15MWarnS) or (useElliottEnv5M and elliottEnv5MWarnS) or (useElliottEnv1M and elliottEnv1MWarnS)

// --- ⑤波警戒モード: ReduceBiasToEven で統合 bias を Even 化 (反対方向 bias にはしない) ---
int elliottEnvBias = elliottEnvBiasRaw
if elliottEnvWave5Active and elliottEnvWave5Mode == "ReduceBiasToEven"
    if elliottEnvBias == 1 and elliottEnvCombLongWarn
        elliottEnvBias := 0
    if elliottEnvBias == -1 and elliottEnvCombShortWarn
        elliottEnvBias := 0

// --- トレンド環境 (EMAスコア) と エリオット環境 の結合 (方向別に明示) ---
//   useElliottEnvBias=OFF or useElliottEnvEnv=OFF → 完全素通し (既存=トレンドのみ)。
//   TrendOnly       : Long=trendLongOk        / Short=trendShortOk
//   ElliottOnly     : Long=elliottLong        / Short=elliottShort
//   TrendAndElliott : Long=trendLongOk and elliottLong  / Short=trendShortOk and elliottShort
//   TrendOrElliott  : Long=trendLongOk or  elliottLong  / Short=trendShortOk or  elliottShort
//   BlockSameDirection : 上昇⑤波警戒中は新規Long禁止 / 下降⑤波警戒中は新規Short禁止。
bool elliottEnvActive = useElliottEnvEnv and useElliottEnvBias
bool elliottLong  = elliottEnvBias == 1
bool elliottShort = elliottEnvBias == -1
bool finalEnvLongOk0 =
     not elliottEnvActive ? trendLongOk :
     elliottEnvTrendCombineMode == "TrendOnly"       ? trendLongOk :
     elliottEnvTrendCombineMode == "ElliottOnly"     ? elliottLong :
     elliottEnvTrendCombineMode == "TrendAndElliott" ? (trendLongOk and elliottLong) :
     elliottEnvTrendCombineMode == "TrendOrElliott"  ? (trendLongOk or elliottLong) :
     trendLongOk
bool finalEnvShortOk0 =
     not elliottEnvActive ? trendShortOk :
     elliottEnvTrendCombineMode == "TrendOnly"       ? trendShortOk :
     elliottEnvTrendCombineMode == "ElliottOnly"     ? elliottShort :
     elliottEnvTrendCombineMode == "TrendAndElliott" ? (trendShortOk and elliottShort) :
     elliottEnvTrendCombineMode == "TrendOrElliott"  ? (trendShortOk or elliottShort) :
     trendShortOk
bool elliottEnvBlockLong  = elliottEnvActive and elliottEnvWave5Active and elliottEnvWave5Mode == "BlockSameDirection" and elliottEnvCombLongWarn
bool elliottEnvBlockShort = elliottEnvActive and elliottEnvWave5Active and elliottEnvWave5Mode == "BlockSameDirection" and elliottEnvCombShortWarn
bool finalEnvLongOk  = finalEnvLongOk0  and not elliottEnvBlockLong
bool finalEnvShortOk = finalEnvShortOk0 and not elliottEnvBlockShort

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + エリオット)
// ------------------------------------------------------------
//  環境認識は finalEnvLongOk/finalEnvShortOk (EMAトレンド + エリオット の結合結果)。
//  FVG / EMA / Stochastic / Fib / Volume / 三尊 / DT/DB / ウェッジ / トライアングル の各環境認識は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。エリオット方向フィルターは主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if noTriggerMode
        shortArmed := false

// ============================================================
// ============================================================
//  12d. エリオット 環境認識 表示 (テーブル + パターン描画 + Data Window)
// ============================================================
f_elRowReason(bool _on, int _r) =>
    _on ? f_elliottEnvReasonText(_r) : "OFF"
f_elRowInt(bool _on, int _v) =>
    _on ? str.tostring(_v) : "-"
f_elWarnCol(bool _on, int _wl, int _ws) =>
    _on ? str.tostring(math.max(_wl, _ws)) : "-"

var table elliottEnvTbl = na
if elliottEnvShowTable
    if na(elliottEnvTbl)
        elliottEnvTbl := table.new(position.bottom_left, 8, 26, border_width = 1)
    if barstate.islast
        table.cell(elliottEnvTbl, 0, 0, "Elliott", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 1, 0, "Bias",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 0, "Reason", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 3, 0, "残",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 4, 0, "W3 L",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 5, 0, "W3 S",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 6, 0, "W5 Warn", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(elliottEnvTbl, 7, 0, "Rank",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // D
        table.cell(elliottEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 1, useElliottEnvD ? f_elliottEnvText(elliottEnvD) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnvD, useElliottEnvD), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 1, f_elRowReason(useElliottEnvD, elliottEnvDReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 1, f_elRowInt(useElliottEnvD, elliottEnvDRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 1, f_elRowInt(useElliottEnvD, elliottEnvDW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 1, f_elRowInt(useElliottEnvD, elliottEnvDW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 1, f_elWarnCol(useElliottEnvD, elliottEnvDW5L, elliottEnvDW5S), text_color = color.white, bgcolor = useElliottEnvD and (elliottEnvDWarnL or elliottEnvDWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 1, f_elRowInt(useElliottEnvD, elliottEnvDRank), text_color = color.white, text_size = size.small)
        // 4H
        table.cell(elliottEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 2, useElliottEnv4H ? f_elliottEnvText(elliottEnv4H) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnv4H, useElliottEnv4H), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 2, f_elRowReason(useElliottEnv4H, elliottEnv4HReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 2, f_elRowInt(useElliottEnv4H, elliottEnv4HRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 2, f_elRowInt(useElliottEnv4H, elliottEnv4HW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 2, f_elRowInt(useElliottEnv4H, elliottEnv4HW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 2, f_elWarnCol(useElliottEnv4H, elliottEnv4HW5L, elliottEnv4HW5S), text_color = color.white, bgcolor = useElliottEnv4H and (elliottEnv4HWarnL or elliottEnv4HWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 2, f_elRowInt(useElliottEnv4H, elliottEnv4HRank), text_color = color.white, text_size = size.small)
        // 1H
        table.cell(elliottEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 3, useElliottEnv1H ? f_elliottEnvText(elliottEnv1H) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnv1H, useElliottEnv1H), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 3, f_elRowReason(useElliottEnv1H, elliottEnv1HReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 3, f_elRowInt(useElliottEnv1H, elliottEnv1HRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 3, f_elRowInt(useElliottEnv1H, elliottEnv1HW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 3, f_elRowInt(useElliottEnv1H, elliottEnv1HW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 3, f_elWarnCol(useElliottEnv1H, elliottEnv1HW5L, elliottEnv1HW5S), text_color = color.white, bgcolor = useElliottEnv1H and (elliottEnv1HWarnL or elliottEnv1HWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 3, f_elRowInt(useElliottEnv1H, elliottEnv1HRank), text_color = color.white, text_size = size.small)
        // 15M
        table.cell(elliottEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 4, useElliottEnv15M ? f_elliottEnvText(elliottEnv15M) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnv15M, useElliottEnv15M), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 4, f_elRowReason(useElliottEnv15M, elliottEnv15MReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 4, f_elRowInt(useElliottEnv15M, elliottEnv15MRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 4, f_elRowInt(useElliottEnv15M, elliottEnv15MW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 4, f_elRowInt(useElliottEnv15M, elliottEnv15MW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 4, f_elWarnCol(useElliottEnv15M, elliottEnv15MW5L, elliottEnv15MW5S), text_color = color.white, bgcolor = useElliottEnv15M and (elliottEnv15MWarnL or elliottEnv15MWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 4, f_elRowInt(useElliottEnv15M, elliottEnv15MRank), text_color = color.white, text_size = size.small)
        // 5M
        table.cell(elliottEnvTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 5, useElliottEnv5M ? f_elliottEnvText(elliottEnv5M) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnv5M, useElliottEnv5M), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 5, f_elRowReason(useElliottEnv5M, elliottEnv5MReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 5, f_elRowInt(useElliottEnv5M, elliottEnv5MRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 5, f_elRowInt(useElliottEnv5M, elliottEnv5MW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 5, f_elRowInt(useElliottEnv5M, elliottEnv5MW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 5, f_elWarnCol(useElliottEnv5M, elliottEnv5MW5L, elliottEnv5MW5S), text_color = color.white, bgcolor = useElliottEnv5M and (elliottEnv5MWarnL or elliottEnv5MWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 5, f_elRowInt(useElliottEnv5M, elliottEnv5MRank), text_color = color.white, text_size = size.small)
        // 1M
        table.cell(elliottEnvTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 6, useElliottEnv1M ? f_elliottEnvText(elliottEnv1M) : "OFF", text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnv1M, useElliottEnv1M), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 6, f_elRowReason(useElliottEnv1M, elliottEnv1MReason), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 6, f_elRowInt(useElliottEnv1M, elliottEnv1MRem), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 6, f_elRowInt(useElliottEnv1M, elliottEnv1MW3L), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 6, f_elRowInt(useElliottEnv1M, elliottEnv1MW3S), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 6, f_elWarnCol(useElliottEnv1M, elliottEnv1MW5L, elliottEnv1MW5S), text_color = color.white, bgcolor = useElliottEnv1M and (elliottEnv1MWarnL or elliottEnv1MWarnS) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 6, f_elRowInt(useElliottEnv1M, elliottEnv1MRank), text_color = color.white, text_size = size.small)
        // 統合 Bias / Weighted Score / Combine Mode
        table.cell(elliottEnvTbl, 0, 7, "COMBINED", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 7, f_elliottEnvText(elliottEnvBias), text_color = color.white, bgcolor = f_elliottEnvColor(elliottEnvBias, useElliottEnvEnv), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 7, "WScore", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 7, str.tostring(elliottEnvScoreVal), text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 7, "Mode", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 7, elliottEnvCombineMode == "HigherTF" ? "HTF" : "WScore", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 7, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 7, "", text_color = color.white, text_size = size.small)
        // Wave5 Mode / Trend Combine Mode
        table.cell(elliottEnvTbl, 0, 8, "Wave5 Mode", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 8, elliottEnvWave5Mode, text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 2, 8, elliottEnvWave5Active ? "ON" : "OFF", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 8, "TrendComb", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 8, elliottEnvTrendCombineMode, text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 8, useElliottEnvBias ? "Bias:ON" : "Bias:OFF", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 8, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 8, "", text_color = color.white, text_size = size.small)
        // Final Long / Short + Combined Warnings
        table.cell(elliottEnvTbl, 0, 9, "Final Long", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 9, finalEnvLongOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvLongOk ? color.new(color.green, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 9, "L Warn", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 9, elliottEnvCombLongWarn ? "Y" : "N", text_color = color.white, bgcolor = elliottEnvCombLongWarn ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 9, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 9, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 9, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 9, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 0, 10, "Final Short", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 1, 10, finalEnvShortOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvShortOk ? color.new(color.red, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(elliottEnvTbl, 2, 10, "S Warn", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 3, 10, elliottEnvCombShortWarn ? "Y" : "N", text_color = color.white, bgcolor = elliottEnvCombShortWarn ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(elliottEnvTbl, 4, 10, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 5, 10, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 6, 10, "", text_color = color.white, text_size = size.small)
        table.cell(elliottEnvTbl, 7, 10, "", text_color = color.white, text_size = size.small)
        // デバッグ (elliottEnvLabelTF の採用値)
        if elliottEnvShowDebug
            table.cell(elliottEnvTbl, 0, 11, "LabelTF", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 1, 11, elliottEnvLabelTF, text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 2, 11, "PivotCnt", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 3, 11, str.tostring(elLblPivotCount), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 4, 11, "Score", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 5, 11, str.tostring(elLblScore), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 6, 11, "Rank", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 7, 11, str.tostring(elLblRank), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 0, 12, "W3 Score L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 1, 12, str.tostring(elliottEnvLabelTF == "D" ? elliottEnvDW3L : elliottEnvLabelTF == "4H" ? elliottEnv4HW3L : elliottEnvLabelTF == "1H" ? elliottEnv1HW3L : elliottEnvLabelTF == "15M" ? elliottEnv15MW3L : elliottEnvLabelTF == "5M" ? elliottEnv5MW3L : elliottEnv1MW3L) + " / " + str.tostring(elliottEnvLabelTF == "D" ? elliottEnvDW3S : elliottEnvLabelTF == "4H" ? elliottEnv4HW3S : elliottEnvLabelTF == "1H" ? elliottEnv1HW3S : elliottEnvLabelTF == "15M" ? elliottEnv15MW3S : elliottEnvLabelTF == "5M" ? elliottEnv5MW3S : elliottEnv1MW3S), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 2, 12, "W5 Warn L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 3, 12, str.tostring(elliottEnvLabelTF == "D" ? elliottEnvDW5L : elliottEnvLabelTF == "4H" ? elliottEnv4HW5L : elliottEnvLabelTF == "1H" ? elliottEnv1HW5L : elliottEnvLabelTF == "15M" ? elliottEnv15MW5L : elliottEnvLabelTF == "5M" ? elliottEnv5MW5L : elliottEnv1MW5L) + " / " + str.tostring(elliottEnvLabelTF == "D" ? elliottEnvDW5S : elliottEnvLabelTF == "4H" ? elliottEnv4HW5S : elliottEnvLabelTF == "1H" ? elliottEnv1HW5S : elliottEnvLabelTF == "15M" ? elliottEnv15MW5S : elliottEnvLabelTF == "5M" ? elliottEnv5MW5S : elliottEnv1MW5S), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 4, 12, "Signal", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 5, 12, str.tostring(elLblSignal), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 6, 12, "Conflict", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 7, 12, elLblConflict ? "Y" : "N", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 0, 13, "Momentum L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 1, 13, (elLblMomL ? "Y" : "N") + " / " + (elLblMomS ? "Y" : "N"), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 2, 13, "EMA L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 3, 13, (elLblEmaL ? "Y" : "N") + " / " + (elLblEmaS ? "Y" : "N"), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 4, 13, "Volume", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 5, 13, elLblVol ? "Y" : "N", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 6, 13, "Dir", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 7, 13, elLblDir == 1 ? "L" : elLblDir == -1 ? "S" : "-", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 0, 14, "RSI Div L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 1, 14, (elLblRsiDivL ? "Y" : "N") + " / " + (elLblRsiDivS ? "Y" : "N"), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 2, 14, "MACD Div L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 3, 14, (elLblMacdDivL ? "Y" : "N") + " / " + (elLblMacdDivS ? "Y" : "N"), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 4, 14, "OverExt L/S", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 5, 14, (elLblOverExtL ? "Y" : "N") + " / " + (elLblOverExtS ? "Y" : "N"), text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 6, 14, "DrawMode", text_color = color.white, text_size = size.small)
            table.cell(elliottEnvTbl, 7, 14, str.tostring(elLblDrawMode), text_color = color.white, text_size = size.small)

// --- Data Window 出力 ---
plot(useElliottEnvEnv ? elliottEnvScoreVal : na, "elliottEnvScore", display = display.data_window)
plot(useElliottEnvEnv ? elliottEnvBias : na, "elliottEnvBias", display = display.data_window)
plot(finalEnvLongOk  ? 1 : 0, "finalEnvLongOk",  display = display.data_window)
plot(finalEnvShortOk ? 1 : 0, "finalEnvShortOk", display = display.data_window)

// --- 採用パターン描画 (elliottEnvLabelTF・時刻アンカー。表示専用・検知/スコア/エントリー不変) ---
//   ③候補 = Pivot 0/1/2/3? (4点) / ⑤警戒 = Pivot 0/1/2/3/4/5 Warn (6点)。未確定を断定表示しない。
//   line/label は最新候補だけを更新。描画OFF・環境OFF・候補なし・対象TF変更時は削除。
var label elLb0 = na
var label elLb1 = na
var label elLb2 = na
var label elLb3 = na
var label elLb4 = na
var label elLb5 = na
var line  elLn0 = na
var line  elLn1 = na
var line  elLn2 = na
var line  elLn3 = na
var line  elLn4 = na

if barstate.islast
    if not na(elLb0)
        label.delete(elLb0)
        elLb0 := na
    if not na(elLb1)
        label.delete(elLb1)
        elLb1 := na
    if not na(elLb2)
        label.delete(elLb2)
        elLb2 := na
    if not na(elLb3)
        label.delete(elLb3)
        elLb3 := na
    if not na(elLb4)
        label.delete(elLb4)
        elLb4 := na
    if not na(elLb5)
        label.delete(elLb5)
        elLb5 := na
    if not na(elLn0)
        line.delete(elLn0)
        elLn0 := na
    if not na(elLn1)
        line.delete(elLn1)
        elLn1 := na
    if not na(elLn2)
        line.delete(elLn2)
        elLn2 := na
    if not na(elLn3)
        line.delete(elLn3)
        elLn3 := na
    if not na(elLn4)
        line.delete(elLn4)
        elLn4 := na
    bool _elDoDraw = elliottEnvWantDraw and useElliottEnvEnv and elLblDrawMode != 0 and not na(elLblD0T) and not na(elLblD0P)
    if _elDoDraw
        bool _isWave5 = elLblDrawMode == 2 or elLblDrawMode == -2
        bool _isLong  = elLblDrawMode > 0
        color _elCol = _isLong ? color.new(color.green, 0) : color.new(color.red, 0)
        color _elLnCol = _isLong ? color.new(color.green, 20) : color.new(color.red, 20)
        // 波ライン (Pivot間を連結)
        if elliottEnvShowWaveLines
            if not na(elLblD1T) and not na(elLblD1P)
                elLn0 := line.new(elLblD0T, elLblD0P, elLblD1T, elLblD1P, xloc = xloc.bar_time, color = _elLnCol, width = elliottEnvPatternLineWidth)
            if not na(elLblD2T) and not na(elLblD2P)
                elLn1 := line.new(elLblD1T, elLblD1P, elLblD2T, elLblD2P, xloc = xloc.bar_time, color = _elLnCol, width = elliottEnvPatternLineWidth)
            if not na(elLblD3T) and not na(elLblD3P)
                elLn2 := line.new(elLblD2T, elLblD2P, elLblD3T, elLblD3P, xloc = xloc.bar_time, color = _elLnCol, width = elliottEnvPatternLineWidth)
            if _isWave5 and not na(elLblD4T) and not na(elLblD4P)
                elLn3 := line.new(elLblD3T, elLblD3P, elLblD4T, elLblD4P, xloc = xloc.bar_time, color = _elLnCol, width = elliottEnvPatternLineWidth)
            if _isWave5 and not na(elLblD5T) and not na(elLblD5P)
                elLn4 := line.new(elLblD4T, elLblD4P, elLblD5T, elLblD5P, xloc = xloc.bar_time, color = _elLnCol, width = elliottEnvPatternLineWidth)
        // Pivotラベル (③候補: 0/1/2/3? / ⑤警戒: 0/1/2/3/4/5 Warn)
        if elliottEnvShowLabels
            elLb0 := label.new(elLblD0T, elLblD0P, "0", xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
            if not na(elLblD1T)

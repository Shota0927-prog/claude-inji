        elLblMomS := _ms
        elLblEmaL := _el
        elLblEmaS := _es
        elLblVol := _vc
        elLblRsiDivL := _rdl
        elLblRsiDivS := _rds
        elLblMacdDivL := _mdl
        elLblMacdDivS := _mds
        elLblOverExtL := _oel
        elLblOverExtS := _oes
        elLblRank := _rk
if elliottEnvCompute and useElliottEnv5M
    // 5分足はチャート足そのもの → request.security / f_elliottEnvConfirmed / [1] を使わず
    //   f_elliottEnvState をチャート上で直接計算する。最終エントリーの barstate.isconfirmed で
    //   「確定した現在の5分足」の状態を採用するため、1本余計に遅れない。
    [_b, _rs, _rem, _dir, _sc, _rk, _st, _w3l, _w3s, _w5l, _w5s, _cl, _cs, _wl, _ws, _ml, _ms, _el, _es, _vc, _rdl, _rds, _mdl, _mds, _oel, _oes, _pc, _cf, _dm, _p0, _p1, _p2, _p3, _p4, _p5, _t0, _t1, _t2, _t3, _t4, _t5] = f_elliottEnvState(elliottEnvHold5M)
    elliottEnv5M := _b
    elliottEnv5MRem := _rem
    elliottEnv5MReason := _rs
    elliottEnv5MRank := _rk
    elliottEnv5MW3L := _w3l
    elliottEnv5MW3S := _w3s
    elliottEnv5MW5L := _w5l
    elliottEnv5MW5S := _w5s
    elliottEnv5MWarnL := _wl
    elliottEnv5MWarnS := _ws
    if elliottEnvLabelTF == "5M"
        elLblDrawMode := _dm
        elLblD0P := _p0
        elLblD1P := _p1
        elLblD2P := _p2
        elLblD3P := _p3
        elLblD4P := _p4

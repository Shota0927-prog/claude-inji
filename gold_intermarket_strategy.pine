float corrO5M = (imActive and useIntermarket5M and useOilEnv)   ? f_corrCalc(goBuf5M, oBuf5M, imCorrLen) : na
[sScore5M, sReason5M, sNT5M] = f_silverState(imActive and useSilverEnv and useIntermarket5M, newBar5M, imHold5M, gChg5M, sChg5M, sRecent5M, silverEventPoint)
[srScore5M, srReason5M, srNT5M, srState5M, srPreDir5M, srRetType5M, srRetDir5M, srLeader5M, srMDir5M, srGResp5M, srPreMkt5M] = f_macroState(imActive and useSilverEnv and useIntermarket5M, newBar5M, imHold5M, gChg5M, sChg5M, corrS5M, gStructUp5M, gStructDn5M, sStructUp5M, sStructDn5M, false, false, useSilverCorrFilter, useSilverDistortionNoTrade, useSilverReturn, imCorrThreshold, silverMinChange, imReturnLookback, silverEventPoint, silverDistortionMinChange)
[xScore5M, xReason5M, xNT5M, xState5M, xPreDir5M, xRetType5M, xRetDir5M, xLeader5M, xMDir5M, xGResp5M, xPreMkt5M] = f_macroState(imActive and useDxyEnv and useIntermarket5M, newBar5M, imHold5M, gChg5M, xChg5M, corrX5M, gStructUp5M, gStructDn5M, xStructUp5M, xStructDn5M, true, useDxyDirection, useDxyInverseCorrelation, useDxyDistortionNoTrade, useDxyReturn, imCorrThreshold, dxyMinChange, imReturnLookback, dxyEventPoint, dxyDistortionMinChange)
[yScore5M, yReason5M, yNT5M, yState5M, yPreDir5M, yRetType5M, yRetDir5M, yLeader5M, yMDir5M, yGResp5M, yPreMkt5M] = f_macroState(imActive and useYieldEnv and useIntermarket5M, newBar5M, imHold5M, gChg5M, yChg5M, corrY5M, gStructUp5M, gStructDn5M, yStructUp5M, yStructDn5M, true, useYieldDirection, useYieldInverseCorrelation, useYieldDistortionNoTrade, useYieldReturn, imCorrThreshold, yieldMinChange, imReturnLookback, yieldEventPoint, yieldDistortionMinChange)
[oScore5M, oReason5M, oNT5M, oState5M, oPreDir5M, oRetType5M, oRetDir5M, oLeader5M, oMDir5M, oGResp5M, oPreMkt5M] = f_macroState(imActive and useOilEnv and useIntermarket5M, newBar5M, imHold5M, gChg5M, oChg5M, corrO5M, gStructUp5M, gStructDn5M, oStructUp5M, oStructDn5M, true, useOilDirection, useOilInverseCorrelation, useOilDistortionNoTrade, useOilReturn, imCorrThreshold, oilMinChange, imReturnLookback, oilEventPoint, oilDistortionMinChange)
float sW5M = (useSilverEnv and useIntermarket5M) ? (sScore5M + srScore5M) * imWeight5M : 0.0
float xW5M = (useDxyEnv and useIntermarket5M)    ? xScore5M * imWeight5M : 0.0
float yW5M = (useYieldEnv and useIntermarket5M)  ? yScore5M * imWeight5M : 0.0
float oW5M = (useOilEnv and useIntermarket5M)    ? oScore5M * imWeight5M : 0.0
// --- 1M ---
float gChg1M = 0.0
float gClose1M = na
float sChg1M = 0.0
float sRecent1M = 0.0
float sClose1M = na
float xChg1M = 0.0
float xClose1M = na
float yChg1M = 0.0
float yClose1M = na
float oChg1M = 0.0
float oClose1M = na
bool gStructUp1M = false
bool sStructUp1M = false
bool sStructDn1M = false
bool gStructDn1M = false
bool xStructUp1M = false
bool xStructDn1M = false
bool yStructUp1M = false
bool yStructDn1M = false
bool oStructUp1M = false
bool oStructDn1M = false
if imActive and useIntermarket1M
    [_gc, _gr, _gp, _gsu, _gsd] = request.security(goldSymbol, im1MTF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
    gChg1M := _gc
    gClose1M := _gp
    gStructUp1M := _gsu
    gStructDn1M := _gsd
    if useSilverEnv
        [_sc, _sr, _sp, _ssu, _ssd] = request.security(silverSymbol, im1MTF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
        sChg1M := _sc
        sRecent1M := _sr
        sClose1M := _sp
        sStructUp1M := _ssu
        sStructDn1M := _ssd
    if useDxyEnv
        [_xc, _xr, _xp, _xsu, _xsd] = request.security(dxySymbol, im1MTF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
        xChg1M := _xc
        xClose1M := _xp
        xStructUp1M := _xsu
        xStructDn1M := _xsd
    if useYieldEnv
        [_yc, _yr, _yp, _ysu, _ysd] = request.security(yieldSymbol, im1MTF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
        yChg1M := _yc
        yClose1M := _yp
        yStructUp1M := _ysu
        yStructDn1M := _ysd
    if useOilEnv
        [_oc, _or, _op, _osu, _osd] = request.security(oilSymbol, im1MTF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
        oChg1M := _oc
        oClose1M := _op
        oStructUp1M := _osu
        oStructDn1M := _osd
bool newBar1M = ta.change(time(im1MTF)) != 0
var array<float> gsBuf1M = array.new_float()
var array<float> sBuf1M  = array.new_float()
var array<float> gxBuf1M = array.new_float()
var array<float> xBuf1M  = array.new_float()
var array<float> gyBuf1M = array.new_float()
var array<float> yBuf1M  = array.new_float()
var array<float> goBuf1M = array.new_float()
var array<float> oBuf1M  = array.new_float()
f_corrPush2(gsBuf1M, sBuf1M, imActive and useIntermarket1M and newBar1M and useSilverEnv, gClose1M, sClose1M, imCorrLen)
f_corrPush2(gxBuf1M, xBuf1M, imActive and useIntermarket1M and newBar1M and useDxyEnv,   gClose1M, xClose1M, imCorrLen)
f_corrPush2(gyBuf1M, yBuf1M, imActive and useIntermarket1M and newBar1M and useYieldEnv, gClose1M, yClose1M, imCorrLen)
f_corrPush2(goBuf1M, oBuf1M, imActive and useIntermarket1M and newBar1M and useOilEnv,   gClose1M, oClose1M, imCorrLen)
float corrS1M = (imActive and useIntermarket1M and useSilverEnv) ? f_corrCalc(gsBuf1M, sBuf1M, imCorrLen) : na
float corrX1M = (imActive and useIntermarket1M and useDxyEnv)   ? f_corrCalc(gxBuf1M, xBuf1M, imCorrLen) : na
float corrY1M = (imActive and useIntermarket1M and useYieldEnv) ? f_corrCalc(gyBuf1M, yBuf1M, imCorrLen) : na
float corrO1M = (imActive and useIntermarket1M and useOilEnv)   ? f_corrCalc(goBuf1M, oBuf1M, imCorrLen) : na
[sScore1M, sReason1M, sNT1M] = f_silverState(imActive and useSilverEnv and useIntermarket1M, newBar1M, imHold1M, gChg1M, sChg1M, sRecent1M, silverEventPoint)
[srScore1M, srReason1M, srNT1M, srState1M, srPreDir1M, srRetType1M, srRetDir1M, srLeader1M, srMDir1M, srGResp1M, srPreMkt1M] = f_macroState(imActive and useSilverEnv and useIntermarket1M, newBar1M, imHold1M, gChg1M, sChg1M, corrS1M, gStructUp1M, gStructDn1M, sStructUp1M, sStructDn1M, false, false, useSilverCorrFilter, useSilverDistortionNoTrade, useSilverReturn, imCorrThreshold, silverMinChange, imReturnLookback, silverEventPoint, silverDistortionMinChange)
[xScore1M, xReason1M, xNT1M, xState1M, xPreDir1M, xRetType1M, xRetDir1M, xLeader1M, xMDir1M, xGResp1M, xPreMkt1M] = f_macroState(imActive and useDxyEnv and useIntermarket1M, newBar1M, imHold1M, gChg1M, xChg1M, corrX1M, gStructUp1M, gStructDn1M, xStructUp1M, xStructDn1M, true, useDxyDirection, useDxyInverseCorrelation, useDxyDistortionNoTrade, useDxyReturn, imCorrThreshold, dxyMinChange, imReturnLookback, dxyEventPoint, dxyDistortionMinChange)
[yScore1M, yReason1M, yNT1M, yState1M, yPreDir1M, yRetType1M, yRetDir1M, yLeader1M, yMDir1M, yGResp1M, yPreMkt1M] = f_macroState(imActive and useYieldEnv and useIntermarket1M, newBar1M, imHold1M, gChg1M, yChg1M, corrY1M, gStructUp1M, gStructDn1M, yStructUp1M, yStructDn1M, true, useYieldDirection, useYieldInverseCorrelation, useYieldDistortionNoTrade, useYieldReturn, imCorrThreshold, yieldMinChange, imReturnLookback, yieldEventPoint, yieldDistortionMinChange)
[oScore1M, oReason1M, oNT1M, oState1M, oPreDir1M, oRetType1M, oRetDir1M, oLeader1M, oMDir1M, oGResp1M, oPreMkt1M] = f_macroState(imActive and useOilEnv and useIntermarket1M, newBar1M, imHold1M, gChg1M, oChg1M, corrO1M, gStructUp1M, gStructDn1M, oStructUp1M, oStructDn1M, true, useOilDirection, useOilInverseCorrelation, useOilDistortionNoTrade, useOilReturn, imCorrThreshold, oilMinChange, imReturnLookback, oilEventPoint, oilDistortionMinChange)
float sW1M = (useSilverEnv and useIntermarket1M) ? (sScore1M + srScore1M) * imWeight1M : 0.0
float xW1M = (useDxyEnv and useIntermarket1M)    ? xScore1M * imWeight1M : 0.0
float yW1M = (useYieldEnv and useIntermarket1M)  ? yScore1M * imWeight1M : 0.0
float oW1M = (useOilEnv and useIntermarket1M)    ? oScore1M * imWeight1M : 0.0

// --- 市場別 加重合計 (市場Score×TF重み の合計 × 市場重み) ---
float silverTotalScore = useSilverEnv ? silverWeight * (sWD + sW4H + sW1H + sW15M + sW5M + sW1M) : 0.0
float dxyTotalScore    = useDxyEnv    ? dxyWeight    * (xWD + xW4H + xW1H + xW15M + xW5M + xW1M) : 0.0
float yieldTotalScore  = useYieldEnv  ? yieldWeight  * (yWD + yW4H + yW1H + yW15M + yW5M + yW1M) : 0.0
float oilTotalScore    = useOilEnv    ? oilWeight    * (oWD + oW4H + oW1H + oW15M + oW5M + oW1M) : 0.0
float intermarketTotalScore = silverTotalScore + dxyTotalScore + yieldTotalScore + oilTotalScore

// --- 市場別 NoTrade (いずれかのTFで NoTrade → その市場 NoTrade) ---
bool silverNoTrade = useSilverEnv and (sNTD or sNT4H or sNT1H or sNT15M or sNT5M or sNT1M or srNTD or srNT4H or srNT1H or srNT15M or srNT5M or srNT1M)
bool dxyNoTrade    = useDxyEnv    and (xNTD or xNT4H or xNT1H or xNT15M or xNT5M or xNT1M)
bool yieldNoTrade  = useYieldEnv  and (yNTD or yNT4H or yNT1H or yNT15M or yNT5M or yNT1M)
bool oilNoTrade    = useOilEnv    and (oNTD or oNT4H or oNT1H or oNT15M or oNT5M or oNT1M)

// --- 市場別 バイアス (AND/OR 用。市場合計を閾値判定) ---
int silverBias = not useSilverEnv ? 0 : silverTotalScore >= intermarketScoreThreshold ? 1 : silverTotalScore <= -intermarketScoreThreshold ? -1 : 0
int dxyBias    = not useDxyEnv    ? 0 : dxyTotalScore    >= intermarketScoreThreshold ? 1 : dxyTotalScore    <= -intermarketScoreThreshold ? -1 : 0
int yieldBias  = not useYieldEnv  ? 0 : yieldTotalScore  >= intermarketScoreThreshold ? 1 : yieldTotalScore  <= -intermarketScoreThreshold ? -1 : 0
int oilBias    = not useOilEnv    ? 0 : oilTotalScore    >= intermarketScoreThreshold ? 1 : oilTotalScore    <= -intermarketScoreThreshold ? -1 : 0

// --- 市場結合 (WeightedScore / AND / OR) ---
bool _wsLong  = intermarketTotalScore >= intermarketScoreThreshold
bool _wsShort = intermarketTotalScore <= -intermarketScoreThreshold
bool _andLong  = imActive and (not useSilverEnv or silverBias == 1)  and (not useDxyEnv or dxyBias == 1)  and (not useYieldEnv or yieldBias == 1)  and (not useOilEnv or oilBias == 1)
bool _andShort = imActive and (not useSilverEnv or silverBias == -1) and (not useDxyEnv or dxyBias == -1) and (not useYieldEnv or yieldBias == -1) and (not useOilEnv or oilBias == -1)
bool _orLong  = (useSilverEnv and silverBias == 1)  or (useDxyEnv and dxyBias == 1)  or (useYieldEnv and yieldBias == 1)  or (useOilEnv and oilBias == 1)
bool _orShort = (useSilverEnv and silverBias == -1) or (useDxyEnv and dxyBias == -1) or (useYieldEnv and yieldBias == -1) or (useOilEnv and oilBias == -1)
bool orConflict = intermarketMode == "OR" and _orLong and _orShort

bool imBiasLong  = intermarketMode == "WeightedScore" ? _wsLong  : intermarketMode == "AND" ? _andLong  : (_orLong  and not _orShort)
bool imBiasShort = intermarketMode == "WeightedScore" ? _wsShort : intermarketMode == "AND" ? _andShort : (_orShort and not _orLong)

// --- Intermarket NoTrade (市場別NoTrade を ANY/ALL 結合。OR両成立も NoTrade) ---
bool _anyNT = (useSilverEnv and silverNoTrade) or (useDxyEnv and dxyNoTrade) or (useYieldEnv and yieldNoTrade) or (useOilEnv and oilNoTrade)
bool _allNT = imActive and (not useSilverEnv or silverNoTrade) and (not useDxyEnv or dxyNoTrade) and (not useYieldEnv or yieldNoTrade) and (not useOilEnv or oilNoTrade)
bool intermarketNoTrade = imActive and ((intermarketNoTradeMode == "ALL" ? _allNT : _anyNT) or orConflict)

int intermarketFinalBias = imBiasLong and not imBiasShort ? 1 : imBiasShort and not imBiasLong ? -1 : 0

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  各環境モジュールを個別の使用ON/OFFで管理し、ONのモジュールをすべて
//  通過した場合のみエントリー許可。OFFのモジュールは常に通過扱い。
//  今後モジュールを増やす場合も「xxxLongOk = not useXxxEnv or xxxBiasLong」を
//  1行足して allEnvLongOk / allEnvShortOk の and に加えるだけで拡張できる。
//  ※ FVG環境認識 / EMA環境認識(50/200/1000) は削除済み。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool imLongOk = not imActive or (imBiasLong and not intermarketNoTrade)
bool allEnvLongOk =
     trendLongOk and
     imLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool imShortOk = not imActive or (imBiasShort and not intermarketNoTrade)
bool allEnvShortOk =
     trendShortOk and
     imShortOk

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

// 15分足コンテキストで箱を構築 (var で 15分足の生存期間だけ上下限を拡張)。
//   返り値: [isAccum, boxHigh, boxLow, boxStartBar]  boxStartBar = 箱識別子。
f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

// 確定済み1本前の15分足 box を「15分足コンテキスト内」で参照して返す。
//   [1] を関数内 (= 15分足コンテキスト) で適用し、lookahead_on と組み合わせることで、
//   ヒストリカル/リアルタイムとも「直前に確定した15分足」の box を一貫して取得する
//   (未来参照なし・非リペイント)。チャート側では [1] を一切使わない。
f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        // 新規Accum確定 → 配列へ追加。4つ目 (accumNTKeep超) で最古を削除。
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        // 形成中は最新箱の上下限を拡張 (配列の末尾=最新も更新)
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    // 内部判定 : 直近保持のどれか1つでも close が上限〜下限 (端一致含む) にあれば内部
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
//   確定参照は 15分足コンテキスト内で [1] を適用する f_accumNT15Confirmed + lookahead_on。
//   → 返る box は常に「直前に確定した15分足」の最終値 (ヒストリカル/リアルタイム一致)。
//   登録/更新は ta.change(time(15分足)) で「新しい15分足が始まった最初の5分足」だけ。
//   ※ チャート側では [1] を一切使わない。形成途中の15分足値は配列に入らない。
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        // 直前に確定した15分足の box をこの1本だけで処理 (3本に1回)
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            // 新しい15分Accum箱 → 登録 (箱識別子が変わった時のみ = 重複登録なし)
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            // 同一箱が拡張 (確定15分足で更新) → 最新エントリーの上下限を更新
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    // 内部判定は毎5分足で実施 (保持中の確定箱に対して現在の終値を判定)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
//   Accum外へ出た最初の足では許可せず、accumExitConfirmBars 本連続で外部維持後に許可。
//   離脱足は計数に含めず、その次の足から連続外部本数を数える。
//   確認中にAccum内へ戻ったらカウント完全リセット。最初から外部なら待機なし (従来どおり即許可)。
//   ※ WinZone/Momentum/Trigger/各状態管理・有効期限・リセットには一切干渉しない。
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        // Accum内 (または戻った) → 待機・カウント完全リセット
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        // 離脱足 → 待機開始 (この足は計数に含めない)
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        // 離脱の次足以降、外部維持で計数
        accumOutsideConfirmCount += 1
    // 確認完了 → 待機解除 (この確定バーで許可)
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

// 確認完了前だけ新規エントリー禁止 (blockedByAccum とは別条件)
bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
//   Accum内NoTrade・離脱待機確認は不変。離脱後のみ、抜けた方向にエントリーを限定する。
//   方向判定は「直前バーで実際に内部にいた保持箱」ごとに close 基準 (ヒゲ無視) で行う。
//   ・最初から外部 (一度もAccumを通過していない) → 方向制限なし (accumBreakDirectionActive=false)。
//   ・Accum内へ戻る / 有効期限切れ / 方向不明 → 状態リセット。
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        // Accum内へ戻った → 方向状態リセット (Accum内なので両方向禁止のまま)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        // 離脱足 : 直前バーで内部にいた箱ごとに close 基準で上抜け/下抜けを判定
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            // 上抜け/下抜け同時成立 or どちらも不成立 → 方向不明 (両方禁止しない=非アクティブ)
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    // 有効期限切れ → リセット
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

// 方向別許可 (非アクティブ時=最初から外部/方向不明/期限切れ は従来どおり両方向許可)
bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + Intermarket)
// ------------------------------------------------------------
//  WinZone / Momentum / Intermarket は本ストラテジーでは不使用。
//  環境認識は allEnvLongOk/allEnvShortOk (ON中の全環境モジュールのAND) に一本化。
//  FVG環境認識 / EMA環境認識(50/200/1000) は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。環境認識(トレンド+Intermarket)は主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     allEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     allEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if noTriggerMode
        shortArmed := false

// ============================================================
//  12c. Intermarket 環境認識 表示 (デバッグテーブル)
// ============================================================
f_biasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_biasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- メインテーブル (市場別Total / BIAS / NoTrade) ---
var table imTbl = na
if imShowTable
    if na(imTbl)
        imTbl := table.new(position.bottom_right, 3, 9, border_width = 1)
    if barstate.islast
        table.cell(imTbl, 0, 0, "Market", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 1, 0, "Bias",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 0, "Total",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // Silver
        table.cell(imTbl, 0, 1, "Silver", text_color = color.white, text_size = size.small)
        table.cell(imTbl, 1, 1, useSilverEnv ? f_biasText(silverBias) : "OFF", text_color = color.white, bgcolor = useSilverEnv ? f_biasColor(silverBias) : color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 1, useSilverEnv ? str.tostring(silverTotalScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        // DXY
        table.cell(imTbl, 0, 2, "DXY", text_color = color.white, text_size = size.small)
        table.cell(imTbl, 1, 2, useDxyEnv ? f_biasText(dxyBias) : "OFF", text_color = color.white, bgcolor = useDxyEnv ? f_biasColor(dxyBias) : color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 2, useDxyEnv ? str.tostring(dxyTotalScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        // Yield
        table.cell(imTbl, 0, 3, "Yield", text_color = color.white, text_size = size.small)
        table.cell(imTbl, 1, 3, useYieldEnv ? f_biasText(yieldBias) : "OFF", text_color = color.white, bgcolor = useYieldEnv ? f_biasColor(yieldBias) : color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 3, useYieldEnv ? str.tostring(yieldTotalScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        // Oil
        table.cell(imTbl, 0, 4, "Oil", text_color = color.white, text_size = size.small)
        table.cell(imTbl, 1, 4, useOilEnv ? f_biasText(oilBias) : "OFF", text_color = color.white, bgcolor = useOilEnv ? f_biasColor(oilBias) : color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 4, useOilEnv ? str.tostring(oilTotalScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 区切り (Mode)
        table.cell(imTbl, 0, 5, "Mode", text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)
        table.cell(imTbl, 1, 5, intermarketMode, text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)
        table.cell(imTbl, 2, 5, imShowDebug ? ("Th:" + str.tostring(intermarketScoreThreshold, "#.#")) : "", text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)
        // TOTAL
        table.cell(imTbl, 0, 6, "TOTAL", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 1, 6, "", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 6, str.tostring(intermarketTotalScore, "#.##"), text_color = color.white, bgcolor = f_biasColor(intermarketFinalBias), text_size = size.small)
        // BIAS
        table.cell(imTbl, 0, 7, "BIAS", text_color = color.white, bgcolor = f_biasColor(intermarketFinalBias), text_size = size.small)
        table.cell(imTbl, 1, 7, f_biasText(intermarketFinalBias), text_color = color.white, bgcolor = f_biasColor(intermarketFinalBias), text_size = size.small)
        table.cell(imTbl, 2, 7, imActive ? "" : "PASS", text_color = color.white, bgcolor = f_biasColor(intermarketFinalBias), text_size = size.small)
        // NoTrade
        table.cell(imTbl, 0, 8, "NoTrade", text_color = color.white, text_size = size.small)
        table.cell(imTbl, 1, 8, intermarketNoTrade ? "YES" : "no", text_color = color.white, bgcolor = intermarketNoTrade ? color.new(color.red, 20) : color.new(color.black, 0), text_size = size.small)
        table.cell(imTbl, 2, 8, intermarketNoTradeMode, text_color = color.white, text_size = size.small)

// --- 詳細テーブル (imShowDebug ON時のみ・各市場×TFの加重寄与) ---
var table imDbg = na
if imShowTable and imShowDebug
    if na(imDbg)
        imDbg := table.new(position.bottom_left, 5, 7, border_width = 1)
    if barstate.islast
        table.cell(imDbg, 0, 0, "TF",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
        table.cell(imDbg, 1, 0, "Silver", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
        table.cell(imDbg, 2, 0, "DXY",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
        table.cell(imDbg, 3, 0, "Yield",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
        table.cell(imDbg, 4, 0, "Oil",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
        // D
        table.cell(imDbg, 0, 1, "D", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 1, (useSilverEnv and useIntermarketD) ? f_imReasonText(sReasonD) + " " + str.tostring(sWD, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 1, (useDxyEnv and useIntermarketD)    ? f_imReasonText(xReasonD) + " " + str.tostring(xWD, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 1, (useYieldEnv and useIntermarketD)  ? f_imReasonText(yReasonD) + " " + str.tostring(yWD, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 1, (useOilEnv and useIntermarketD)    ? f_imReasonText(oReasonD) + " " + str.tostring(oWD, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        // 4H
        table.cell(imDbg, 0, 2, "4H", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 2, (useSilverEnv and useIntermarket4H) ? f_imReasonText(sReason4H) + " " + str.tostring(sW4H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 2, (useDxyEnv and useIntermarket4H)    ? f_imReasonText(xReason4H) + " " + str.tostring(xW4H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 2, (useYieldEnv and useIntermarket4H)  ? f_imReasonText(yReason4H) + " " + str.tostring(yW4H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 2, (useOilEnv and useIntermarket4H)    ? f_imReasonText(oReason4H) + " " + str.tostring(oW4H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        // 1H
        table.cell(imDbg, 0, 3, "1H", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 3, (useSilverEnv and useIntermarket1H) ? f_imReasonText(sReason1H) + " " + str.tostring(sW1H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 3, (useDxyEnv and useIntermarket1H)    ? f_imReasonText(xReason1H) + " " + str.tostring(xW1H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 3, (useYieldEnv and useIntermarket1H)  ? f_imReasonText(yReason1H) + " " + str.tostring(yW1H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 3, (useOilEnv and useIntermarket1H)    ? f_imReasonText(oReason1H) + " " + str.tostring(oW1H, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        // 15M
        table.cell(imDbg, 0, 4, "15M", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 4, (useSilverEnv and useIntermarket15M) ? f_imReasonText(sReason15M) + " " + str.tostring(sW15M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 4, (useDxyEnv and useIntermarket15M)    ? f_imReasonText(xReason15M) + " " + str.tostring(xW15M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 4, (useYieldEnv and useIntermarket15M)  ? f_imReasonText(yReason15M) + " " + str.tostring(yW15M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 4, (useOilEnv and useIntermarket15M)    ? f_imReasonText(oReason15M) + " " + str.tostring(oW15M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        // 5M
        table.cell(imDbg, 0, 5, "5M", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 5, (useSilverEnv and useIntermarket5M) ? f_imReasonText(sReason5M) + " " + str.tostring(sW5M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 5, (useDxyEnv and useIntermarket5M)    ? f_imReasonText(xReason5M) + " " + str.tostring(xW5M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 5, (useYieldEnv and useIntermarket5M)  ? f_imReasonText(yReason5M) + " " + str.tostring(yW5M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 5, (useOilEnv and useIntermarket5M)    ? f_imReasonText(oReason5M) + " " + str.tostring(oW5M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        // 1M
        table.cell(imDbg, 0, 6, "1M", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 1, 6, (useSilverEnv and useIntermarket1M) ? f_imReasonText(sReason1M) + " " + str.tostring(sW1M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 2, 6, (useDxyEnv and useIntermarket1M)    ? f_imReasonText(xReason1M) + " " + str.tostring(xW1M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 3, 6, (useYieldEnv and useIntermarket1M)  ? f_imReasonText(yReason1M) + " " + str.tostring(yW1M, "#.#") : "-", text_color = color.white, text_size = size.tiny)
        table.cell(imDbg, 4, 6, (useOilEnv and useIntermarket1M)    ? f_imReasonText(oReason1M) + " " + str.tostring(oW1M, "#.#") : "-", text_color = color.white, text_size = size.tiny)

// ============================================================
//  12d. Intermarket Distortion → Return 詳細テーブル
// ------------------------------------------------------------
//  Silver / DXY / Yield / Oil のいずれか1市場について、各参照TFの
//    Corr   : 現在の相関係数 (参照TF確定足 imCorrLen 本)
//    Mkt    : 主市場の方向 (Up / Down / flat = 最低変化率未満で未分類)
//    Gold   : 主市場に対するGoldの反応 (Up / Down / Neutral = 無反応・耐え)
//    State  : Normal / Dist:Neutral / Dist:Opposite / Return / Expired
//    PreRel : Distortion直前の関係 (M=市場方向 / G=Gold方向)
//    Return : Orig Long / Orig Short / Oppo Long / Oppo Short
//    Leader : Gold主導 / 市場主導 / '-' = 不明
//  を表示する。イベント発火の有無 (useXxxReturn) に関わらず状態機械は動作するため、
//  Return を OFF にしたままサイクルの検証だけを行うこともできる。
// ============================================================
f_imStateText(int c) =>
    c == 1 ? "Dist:Neutral" : c == 2 ? "Dist:Opposite" : c == 3 ? "Return" : c == 4 ? "Expired" : "Normal"
f_imStateColor(int c) =>
    c == 1 ? color.new(color.orange, 20) : c == 2 ? color.new(color.maroon, 20) : c == 3 ? color.new(color.blue, 20) : c == 4 ? color.new(color.gray, 40) : color.new(color.black, 0)
f_imMktDirText(int d) =>
    d == 1 ? "Up" : d == -1 ? "Down" : "flat"
f_imGoldRespText(int r) =>
    r == 1 ? "Up" : r == -1 ? "Down" : "Neutral"
f_imPreRelText(int mDir, int gDir) =>
    mDir == 0 and gDir == 0 ? "-" : "M" + (mDir == 1 ? "Up" : mDir == -1 ? "Dn" : "-") + "/G" + (gDir == 1 ? "Up" : gDir == -1 ? "Dn" : "-")
f_imReturnTypeText(int t, int d) =>
    t == 0 or d == 0 ? "-" : (t == 1 ? "Orig " : "Oppo ") + (d == 1 ? "Long" : "Short")
f_imLeaderText(int l, string mkt) =>
    l == 1 ? "Gold" : l == -1 ? mkt : "-"

f_rtCell(table t, int col, int row, string txt, color bg) =>
    table.cell(t, col, row, txt, text_color = color.white, bgcolor = bg, text_size = size.tiny)

f_rtRow(table t, int row, string tfName, bool on, float corrV, int mDir, int gResp, int st, int preM, int preG, int rt, int rd, int ld, string mkt) =>
    f_rtCell(t, 0, row, tfName, color.new(color.black, 0))
    f_rtCell(t, 1, row, on and not na(corrV) ? str.tostring(corrV, "#.##") : "-", color.new(color.black, 0))
    f_rtCell(t, 2, row, on ? f_imMktDirText(mDir) : "-", color.new(color.black, 0))
    f_rtCell(t, 3, row, on ? f_imGoldRespText(gResp) : "-", color.new(color.black, 0))
    f_rtCell(t, 4, row, on ? f_imStateText(st) : "OFF", on ? f_imStateColor(st) : color.new(color.black, 0))
    f_rtCell(t, 5, row, on ? f_imPreRelText(preM, preG) : "-", color.new(color.black, 0))
    f_rtCell(t, 6, row, on ? f_imReturnTypeText(rt, rd) : "-", color.new(color.black, 0))
    f_rtCell(t, 7, row, on ? f_imLeaderText(ld, mkt) : "-", color.new(color.black, 0))

bool imRtIsSilver = imReturnTableMarket == "Silver"
bool imRtIsDxy    = imReturnTableMarket == "DXY"
bool imRtIsYield  = imReturnTableMarket == "Yield"
bool imRtOnMkt    = imActive and (imRtIsSilver ? useSilverEnv : imRtIsDxy ? useDxyEnv : imRtIsYield ? useYieldEnv : useOilEnv)
float rtCorrD    = imRtIsSilver ? corrSD : imRtIsDxy ? corrXD : imRtIsYield ? corrYD : corrOD
int   rtMDirD    = imRtIsSilver ? srMDirD : imRtIsDxy ? xMDirD : imRtIsYield ? yMDirD : oMDirD
int   rtGRespD   = imRtIsSilver ? srGRespD : imRtIsDxy ? xGRespD : imRtIsYield ? yGRespD : oGRespD
int   rtStateD   = imRtIsSilver ? srStateD : imRtIsDxy ? xStateD : imRtIsYield ? yStateD : oStateD
int   rtPreMktD  = imRtIsSilver ? srPreMktD : imRtIsDxy ? xPreMktD : imRtIsYield ? yPreMktD : oPreMktD
int   rtPreDirD  = imRtIsSilver ? srPreDirD : imRtIsDxy ? xPreDirD : imRtIsYield ? yPreDirD : oPreDirD
int   rtRetTypeD = imRtIsSilver ? srRetTypeD : imRtIsDxy ? xRetTypeD : imRtIsYield ? yRetTypeD : oRetTypeD
int   rtRetDirD  = imRtIsSilver ? srRetDirD : imRtIsDxy ? xRetDirD : imRtIsYield ? yRetDirD : oRetDirD
int   rtLeaderD  = imRtIsSilver ? srLeaderD : imRtIsDxy ? xLeaderD : imRtIsYield ? yLeaderD : oLeaderD
float rtCorr4H    = imRtIsSilver ? corrS4H : imRtIsDxy ? corrX4H : imRtIsYield ? corrY4H : corrO4H
int   rtMDir4H    = imRtIsSilver ? srMDir4H : imRtIsDxy ? xMDir4H : imRtIsYield ? yMDir4H : oMDir4H
int   rtGResp4H   = imRtIsSilver ? srGResp4H : imRtIsDxy ? xGResp4H : imRtIsYield ? yGResp4H : oGResp4H
int   rtState4H   = imRtIsSilver ? srState4H : imRtIsDxy ? xState4H : imRtIsYield ? yState4H : oState4H
int   rtPreMkt4H  = imRtIsSilver ? srPreMkt4H : imRtIsDxy ? xPreMkt4H : imRtIsYield ? yPreMkt4H : oPreMkt4H
int   rtPreDir4H  = imRtIsSilver ? srPreDir4H : imRtIsDxy ? xPreDir4H : imRtIsYield ? yPreDir4H : oPreDir4H
int   rtRetType4H = imRtIsSilver ? srRetType4H : imRtIsDxy ? xRetType4H : imRtIsYield ? yRetType4H : oRetType4H
int   rtRetDir4H  = imRtIsSilver ? srRetDir4H : imRtIsDxy ? xRetDir4H : imRtIsYield ? yRetDir4H : oRetDir4H
int   rtLeader4H  = imRtIsSilver ? srLeader4H : imRtIsDxy ? xLeader4H : imRtIsYield ? yLeader4H : oLeader4H
float rtCorr1H    = imRtIsSilver ? corrS1H : imRtIsDxy ? corrX1H : imRtIsYield ? corrY1H : corrO1H
int   rtMDir1H    = imRtIsSilver ? srMDir1H : imRtIsDxy ? xMDir1H : imRtIsYield ? yMDir1H : oMDir1H
int   rtGResp1H   = imRtIsSilver ? srGResp1H : imRtIsDxy ? xGResp1H : imRtIsYield ? yGResp1H : oGResp1H
int   rtState1H   = imRtIsSilver ? srState1H : imRtIsDxy ? xState1H : imRtIsYield ? yState1H : oState1H
int   rtPreMkt1H  = imRtIsSilver ? srPreMkt1H : imRtIsDxy ? xPreMkt1H : imRtIsYield ? yPreMkt1H : oPreMkt1H
int   rtPreDir1H  = imRtIsSilver ? srPreDir1H : imRtIsDxy ? xPreDir1H : imRtIsYield ? yPreDir1H : oPreDir1H
int   rtRetType1H = imRtIsSilver ? srRetType1H : imRtIsDxy ? xRetType1H : imRtIsYield ? yRetType1H : oRetType1H
int   rtRetDir1H  = imRtIsSilver ? srRetDir1H : imRtIsDxy ? xRetDir1H : imRtIsYield ? yRetDir1H : oRetDir1H
int   rtLeader1H  = imRtIsSilver ? srLeader1H : imRtIsDxy ? xLeader1H : imRtIsYield ? yLeader1H : oLeader1H
float rtCorr15M    = imRtIsSilver ? corrS15M : imRtIsDxy ? corrX15M : imRtIsYield ? corrY15M : corrO15M
int   rtMDir15M    = imRtIsSilver ? srMDir15M : imRtIsDxy ? xMDir15M : imRtIsYield ? yMDir15M : oMDir15M
int   rtGResp15M   = imRtIsSilver ? srGResp15M : imRtIsDxy ? xGResp15M : imRtIsYield ? yGResp15M : oGResp15M
int   rtState15M   = imRtIsSilver ? srState15M : imRtIsDxy ? xState15M : imRtIsYield ? yState15M : oState15M
int   rtPreMkt15M  = imRtIsSilver ? srPreMkt15M : imRtIsDxy ? xPreMkt15M : imRtIsYield ? yPreMkt15M : oPreMkt15M
int   rtPreDir15M  = imRtIsSilver ? srPreDir15M : imRtIsDxy ? xPreDir15M : imRtIsYield ? yPreDir15M : oPreDir15M
int   rtRetType15M = imRtIsSilver ? srRetType15M : imRtIsDxy ? xRetType15M : imRtIsYield ? yRetType15M : oRetType15M
int   rtRetDir15M  = imRtIsSilver ? srRetDir15M : imRtIsDxy ? xRetDir15M : imRtIsYield ? yRetDir15M : oRetDir15M
int   rtLeader15M  = imRtIsSilver ? srLeader15M : imRtIsDxy ? xLeader15M : imRtIsYield ? yLeader15M : oLeader15M

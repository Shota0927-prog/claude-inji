        oChg5M := _oc
        oClose5M := _op
        oStructUp5M := _osu
        oStructDn5M := _osd
bool newBar5M = ta.change(time(im5MTF)) != 0
var array<float> gsBuf5M = array.new_float()
var array<float> sBuf5M  = array.new_float()
var array<float> gxBuf5M = array.new_float()
var array<float> xBuf5M  = array.new_float()
var array<float> gyBuf5M = array.new_float()
var array<float> yBuf5M  = array.new_float()
var array<float> goBuf5M = array.new_float()
var array<float> oBuf5M  = array.new_float()
f_corrPush2(gsBuf5M, sBuf5M, imActive and useIntermarket5M and newBar5M and useSilverEnv, gClose5M, sClose5M, imCorrLen)
f_corrPush2(gxBuf5M, xBuf5M, imActive and useIntermarket5M and newBar5M and useDxyEnv,   gClose5M, xClose5M, imCorrLen)

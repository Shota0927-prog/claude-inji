        f_rtRow(imRtTbl, 4, "15M", imRtOnMkt and useIntermarket15M, rtCorr15M, rtMDir15M, rtGResp15M, rtState15M, rtPreMkt15M, rtPreDir15M, rtRetType15M, rtRetDir15M, rtLeader15M, imReturnTableMarket)
        f_rtRow(imRtTbl, 5, "5M", imRtOnMkt and useIntermarket5M, rtCorr5M, rtMDir5M, rtGResp5M, rtState5M, rtPreMkt5M, rtPreDir5M, rtRetType5M, rtRetDir5M, rtLeader5M, imReturnTableMarket)

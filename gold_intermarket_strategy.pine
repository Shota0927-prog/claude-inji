var table imRtTbl = na
if imShowReturnTable
    if na(imRtTbl)
        imRtTbl := table.new(position.top_right, 8, 7, border_width = 1)
    if barstate.islast
        f_rtCell(imRtTbl, 0, 0, imReturnTableMarket, color.new(color.gray, 30))
        f_rtCell(imRtTbl, 1, 0, "Corr",   color.new(color.gray, 30))
        f_rtCell(imRtTbl, 2, 0, "Mkt",    color.new(color.gray, 30))
        f_rtCell(imRtTbl, 3, 0, "Gold",   color.new(color.gray, 30))
        f_rtCell(imRtTbl, 4, 0, "State",  color.new(color.gray, 30))

        f_rtCell(imRtTbl, 6, 0, "Return", color.new(color.gray, 30))
        f_rtCell(imRtTbl, 7, 0, "Leader", color.new(color.gray, 30))
        f_rtRow(imRtTbl, 1, "D", imRtOnMkt and useIntermarketD, rtCorrD, rtMDirD, rtGRespD, rtStateD, rtPreMktD, rtPreDirD, rtRetTypeD, rtRetDirD, rtLeaderD, imReturnTableMarket)

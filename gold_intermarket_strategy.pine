float corrS5M = (imActive and useIntermarket5M and useSilverEnv) ? f_corrCalc(gsBuf5M, sBuf5M, imCorrLen) : na
float corrX5M = (imActive and useIntermarket5M and useDxyEnv)   ? f_corrCalc(gxBuf5M, xBuf5M, imCorrLen) : na

[sScore15M, sReason15M, sNT15M] = f_silverState(imActive and useSilverEnv and useIntermarket15M, newBar15M, imHold15M, gChg15M, sChg15M, sRecent15M, silverEventPoint)
[srScore15M, srReason15M, srNT15M, srState15M, srPreDir15M, srRetType15M, srRetDir15M, srLeader15M, srMDir15M, srGResp15M, srPreMkt15M] = f_macroState(imActive and useSilverEnv and useIntermarket15M, newBar15M, imHold15M, gChg15M, sChg15M, corrS15M, gStructUp15M, gStructDn15M, sStructUp15M, sStructDn15M, false, false, useSilverCorrFilter, useSilverDistortionNoTrade, useSilverReturn, imCorrThreshold, silverMinChange, imReturnLookback, silverEventPoint, silverDistortionMinChange)
[xScore15M, xReason15M, xNT15M, xState15M, xPreDir15M, xRetType15M, xRetDir15M, xLeader15M, xMDir15M, xGResp15M, xPreMkt15M] = f_macroState(imActive and useDxyEnv and useIntermarket15M, newBar15M, imHold15M, gChg15M, xChg15M, corrX15M, gStructUp15M, gStructDn15M, xStructUp15M, xStructDn15M, true, useDxyDirection, useDxyInverseCorrelation, useDxyDistortionNoTrade, useDxyReturn, imCorrThreshold, dxyMinChange, imReturnLookback, dxyEventPoint, dxyDistortionMinChange)

//@version=6
indicator("ZoneEngine v2 Rebuild - Visual Harness 14D + HTFBOOT NEAREST", overlay = true, max_boxes_count = 30, max_lines_count = 30, max_labels_count = 30, calc_bars_count = 5000)

// IMPORTANT: Replace the next line only after publishing ZoneEngineV2_Rebuild as a TradingView Library.
// Do not guess the publication number. Keep the Library buildId together with that number in your test record.
// Uses the currently published FINAL Engine. Change only the version number if your published Library version differs.
import sekine3310/ZoneEngineV2_Rebuild/11 as ze

// PERF BUILD: 14D state stays at 5k main bars. 90d 4H/1D bootstrap executes only inside HTF request contexts.

// ============================================================================
// Inputs - logic defaults are the specification defaults.
// ============================================================================
gLogic = "Logic"
clusterMaxWidth = input.float(20.0, "M / max width ($)", minval = 0.01, group = gLogic)
denseRatio = input.float(0.50, "Dense ratio", minval = 0.01, maxval = 1.0, group = gLogic)
touchResetDistance = input.float(10.0, "Touch reset distance ($)", minval = 0.01, group = gLogic)
strongUntilTouch = input.int(1, "Strong until touch", minval = 1, group = gLogic)
strongUnlimited = input.bool(false, "Strong unlimited", group = gLogic)
weakFromTouch = input.int(2, "Weak from touch", minval = 2, group = gLogic)
weakFromTouchOff = input.bool(false, "Weak-by-touch OFF", group = gLogic)
weakDepthPct = input.float(50.0, "Weak depth %", minval = 0, maxval = 100, group = gLogic)
weakDepthOff = input.bool(false, "Weak-depth OFF", group = gLogic)
breakBuffer = input.float(2.0, "Break buffer ($)", minval = 0, group = gLogic)
touchTolerance = input.float(0.0, "Line touch tolerance ($)", minval = 0, group = gLogic)

// Performance: fixed short history for TradingView runtime.
const int historyDays = 14
const int bootstrapDays = 90
const float bootstrapDistance = 500.0
// Main chart execution remains capped at 5,000 bars. The 90d bootstrap is NOT
// replayed on 5m bars; it is calculated once inside 4H / 1D request contexts.

gSource = "Source"
emaSlopeLookback = input.int(60, "EMA slope lookback (1m bars)", minval = 1, group = gSource)
swingLen5m = input.int(10, "Swing length 5m", minval = 1, group = gSource)
swingLen15m = input.int(8, "Swing length 15m", minval = 1, group = gSource)
swingLen1h = input.int(6, "Swing length 1h", minval = 1, group = gSource)
accumRangeLen = input.int(10, "Accum range length", minval = 2, group = gSource)
accumBaseLen = input.int(20, "Accum base length", minval = 2, group = gSource)
accumAtrLen = input.int(14, "Accum ATR length", minval = 1, group = gSource)
accumMinUpper = input.int(4, "Accum min upper closes", minval = 0, group = gSource)
accumMinLower = input.int(4, "Accum min lower closes", minval = 0, group = gSource)
accumMaxRun = input.int(4, "Accum max same-color run", minval = 0, group = gSource)
accumAtrMult = input.float(2.5, "Accum range/ATR max", minval = 0.01, group = gSource)
accumBarRatio = input.float(0.70, "Accum short/base width max", minval = 0.01, group = gSource)
accumDriftMax = input.float(0.30, "Accum drift max", minval = 0.0, group = gSource)

gCategory = "Categories"
enableMA = input.bool(true, "MA", group = gCategory)
enableSwing = input.bool(true, "Swing", group = gCategory)
enableAccum = input.bool(true, "Accum", group = gCategory)
enableTimeHL = input.bool(true, "Session / Day / Week H-L", group = gCategory)
enableFVG = input.bool(true, "HTF FVG", group = gCategory)
enablePsych = input.bool(true, "Psychological prices", group = gCategory)

gDisplay = "Display"
showZones = input.bool(true, "Show zones", group = gDisplay)
showLabels = input.bool(true, "Show labels", group = gDisplay)
showDebug = input.bool(true, "Show debug table", group = gDisplay)
maxDraw = input.int(30, "Max views drawn", minval = 1, maxval = 30, group = gDisplay)
balanceSides = input.bool(true, "Balance Support / Resistance", group = gDisplay)

// ============================================================================
// Config. This object is intentionally mutated only from input values; display
// inputs never flow into the Engine's logical decisions.
// ============================================================================
var ze.ZoneCfg cfg = ze.newCfg(syminfo.mintick)
// Inputs are fixed for one script execution. TradingView reloads the script when
// an input changes, so these 30+ field writes only need to run on the first bar.
if barstate.isfirst
    cfg.clusterMaxWidth := clusterMaxWidth
    cfg.denseRatio := denseRatio
    cfg.touchResetDistance := touchResetDistance
    cfg.strongUntilTouch := strongUntilTouch
    cfg.strongUnlimited := strongUnlimited
    cfg.weakFromTouch := weakFromTouch
    cfg.weakFromTouchOff := weakFromTouchOff
    cfg.weakDepthPct := weakDepthPct
    cfg.weakDepthOff := weakDepthOff
    cfg.breakBuffer := breakBuffer
    cfg.touchTolerance := touchTolerance
    cfg.emaSlopeLookback := emaSlopeLookback
    cfg.swingLen5m := swingLen5m
    cfg.swingLen15m := swingLen15m
    cfg.swingLen1h := swingLen1h
    cfg.accumRangeLen := accumRangeLen
    cfg.accumBaseLen := accumBaseLen
    cfg.accumAtrLen := accumAtrLen
    cfg.accumMinUpperCloses := accumMinUpper
    cfg.accumMinLowerCloses := accumMinLower
    cfg.accumMaxSameColorRun := accumMaxRun
    cfg.accumAtrMult := accumAtrMult
    cfg.accumBarRatioMax := accumBarRatio
    cfg.accumDriftMax := accumDriftMax
    cfg.enableMA := enableMA
    cfg.enableSwing := enableSwing
    cfg.enableAccum := enableAccum
    cfg.enableTimeHL := enableTimeHL
    cfg.enableFVG := enableFVG
    cfg.enablePsych := enablePsych
    cfg.maxZonesDrawn := maxDraw
    cfg.maxLabelsDrawn := maxDraw
    cfg.mintick := syminfo.mintick
    cfg.revision := 1

// ============================================================================
// Source feed — 14-DAY BALANCED.
// Only the most recent 14 calendar days execute external requests and Engine updates.
// Five contexts only: 1m, 15m, 1h, 4h, 1D. The 5m Swing uses chart context.
// ============================================================================
bool is5m = timeframe.in_seconds(timeframe.period) == 300
const int MS_PER_DAY = 86400000
int historyAnchorTime = na(last_bar_time) ? timenow : last_bar_time
int historyStartTime = historyAnchorTime - historyDays * MS_PER_DAY
int bootstrapStartTime = historyAnchorTime - bootstrapDays * MS_PER_DAY
bool inEngineWindow = is5m and time_close >= historyStartTime

// Tight per-context history. 14d keeps the 1m request around 23k bars while
// retaining EMA3000 + slope warmup.
const int req1mBars = 23000
const int req15mBars = 1500
const int req1hBars = 450
const int req4hBars = 130
const int req1dBars = 45
const int boot4hBars = 650
const int boot1dBars = 130

ze.MAPack ma1m = na
ze.SwingPack sw15 = na
ze.TFPack p1h = na
ze.TFPack p4h = na
ze.TFPack p1d = na
ze.HTFBootstrapPack boot4h = na
ze.HTFBootstrapPack boot1d = na

var bool bootstrapInjected = false
var int bootstrapAccumInjected = 0
var int bootstrapFvgInjected = 0

f_rangeDistance(float px, float b, float t) =>
    float lo = math.min(b, t)
    float hi = math.max(b, t)
    px < lo ? lo - px : px > hi ? px - hi : 0.0

// Pine v6 supports dynamic requests in local scopes.
// Crucially, the 90d bootstrap request is executed only once, on the first
// 14d Engine bar. Its 90d work happens in 4H / 1D source contexts.
if inEngineWindow
    if not bootstrapInjected
        boot4h := request.security(syminfo.tickerid, "240",
            ze.bootstrap4hPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
                accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
            gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = boot4hBars)
        boot1d := request.security(syminfo.tickerid, "1D",
            ze.bootstrap1dPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
                accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
            gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = boot1dBars)

    ma1m := request.security(syminfo.tickerid, "1", ze.maPackV2(emaSlopeLookback),
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = req1mBars)
    sw15 := request.security(syminfo.tickerid, "15", ze.swingPackV2(swingLen15m),
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = req15mBars)
    p1h := request.security(syminfo.tickerid, "60",
        ze.pack1hV2(swingLen1h, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
            accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = req1hBars)
    p4h := request.security(syminfo.tickerid, "240",
        ze.pack4hV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
            accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = req4hBars)
    p1d := request.security(syminfo.tickerid, "1D",
        ze.pack1dV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
            accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = req1dBars)

// Keep the inexpensive chart-context pivot series continuous so its history is
// deterministic when the 90-day Engine window begins.
ze.SwingPack sw5 = ze.swingPackV2(swingLen5m)

var ze.ZoneFeed feed = na
var ze.ZoneEngine engine = ze.newEngine()
bool engineAdvanced = false

// Seed old 4H / 1D structural Roots once. The Base-state machine still starts
// here and retains only 14 days of Touch/Break/Flip history.
if inEngineWindow and not bootstrapInjected
    if not na(boot4h)
        int an4 = array.size(boot4h.accumPairKeys)
        if an4 > 0
            for i = 0 to an4 - 1
                float b = array.get(boot4h.accumBottoms, i)
                float t = array.get(boot4h.accumTops, i)
                int confirmed = array.get(boot4h.accumConfirmed, i)
                if confirmed >= bootstrapStartTime and confirmed < historyStartTime and f_rangeDistance(close, b, t) <= bootstrapDistance
                    bool added = ze.bootstrapAccumRoot(engine, cfg, 240,
                        array.get(boot4h.accumPairKeys, i), t, b,
                        array.get(boot4h.accumOrigins, i), confirmed,
                        bar_index, time_close)
                    if added
                        bootstrapAccumInjected += 1
        int fn4 = array.size(boot4h.fvgDirs)
        if fn4 > 0
            for i = 0 to fn4 - 1
                float b = array.get(boot4h.fvgBottoms, i)
                float t = array.get(boot4h.fvgTops, i)
                int confirmed = array.get(boot4h.fvgConfirmed, i)
                if confirmed >= bootstrapStartTime and confirmed < historyStartTime and f_rangeDistance(close, b, t) <= bootstrapDistance
                    bool added = ze.bootstrapFvgRoot(engine, cfg, 240,
                        array.get(boot4h.fvgDirs, i), b, t,
                        array.get(boot4h.fvgOrigins, i), confirmed,
                        bar_index, time_close, array.get(boot4h.fvgFresh, i))
                    if added
                        bootstrapFvgInjected += 1

    if not na(boot1d)
        int anD = array.size(boot1d.accumPairKeys)
        if anD > 0
            for i = 0 to anD - 1
                float b = array.get(boot1d.accumBottoms, i)
                float t = array.get(boot1d.accumTops, i)
                int confirmed = array.get(boot1d.accumConfirmed, i)
                if confirmed >= bootstrapStartTime and confirmed < historyStartTime and f_rangeDistance(close, b, t) <= bootstrapDistance
                    bool added = ze.bootstrapAccumRoot(engine, cfg, 1440,
                        array.get(boot1d.accumPairKeys, i), t, b,
                        array.get(boot1d.accumOrigins, i), confirmed,
                        bar_index, time_close)
                    if added
                        bootstrapAccumInjected += 1
        int fnD = array.size(boot1d.fvgDirs)
        if fnD > 0
            for i = 0 to fnD - 1
                float b = array.get(boot1d.fvgBottoms, i)
                float t = array.get(boot1d.fvgTops, i)
                int confirmed = array.get(boot1d.fvgConfirmed, i)
                if confirmed >= bootstrapStartTime and confirmed < historyStartTime and f_rangeDistance(close, b, t) <= bootstrapDistance
                    bool added = ze.bootstrapFvgRoot(engine, cfg, 1440,
                        array.get(boot1d.fvgDirs, i), b, t,
                        array.get(boot1d.fvgOrigins, i), confirmed,
                        bar_index, time_close, array.get(boot1d.fvgFresh, i))
                    if added
                        bootstrapFvgInjected += 1
    bootstrapInjected := true

// No feed allocation, field writes, or Engine call occurs before historyStartTime.
if inEngineWindow
    if na(feed)
        feed := ze.makeFeed(open, high, low, close, close[1], time, time_close, bar_index,
            barstate.isconfirmed and is5m, syminfo.mintick, ma1m, sw5, sw15, p1h, p4h, p1d)
    else
        feed.baseOpen := open
        feed.baseHigh := high
        feed.baseLow := low
        feed.baseClose := close
        feed.basePrevClose := close[1]
        feed.baseOpenTime := time
        feed.baseCloseTime := time_close
        feed.baseSeq := bar_index
        feed.baseConfirmed := barstate.isconfirmed and is5m
        feed.mintick := syminfo.mintick
        feed.ma1m := ma1m
        feed.swing5m := sw5
        feed.swing15m := sw15
        feed.oneHour := p1h
        feed.fourHour := p4h
        feed.oneDay := p1d
    engineAdvanced := ze.updateConfirmedBase(engine, cfg, feed)

// ============================================================================
// Reusable presentation pools. No box/line/label object is created per history
// bar. Presentation reads Engine state but never writes logical state.
// ============================================================================
var array<box> boxPool = array.new<box>()
var array<line> linePool = array.new<line>()
var array<label> labelPool = array.new<label>()

f_ensurePools(int n) =>
    while array.size(boxPool) < n
        array.push(boxPool, box.new(left = bar_index, top = close, right = bar_index + 1, bottom = close,
            xloc = xloc.bar_index, extend = extend.right, border_color = na, bgcolor = na))
        array.push(linePool, line.new(x1 = bar_index, y1 = close, x2 = bar_index + 1, y2 = close,
            xloc = xloc.bar_index, extend = extend.right, color = na))
        array.push(labelPool, label.new(x = bar_index, y = close, text = "", xloc = xloc.bar_index,
            style = label.style_label_left, textcolor = color.white, color = na, size = size.tiny))

f_viewColor(ze.ZoneView v) =>
    color base = v.side == 1 ? color.green : color.red
    if v.grade == 4 or v.phase == 5
        color.new(color.gray, 35)
    else if v.isBroadContext
        color.new(base, 88)
    else if v.grade == 1
        color.new(base, 62)
    else if v.grade == 3
        color.new(base, 88)
    else
        color.new(base, 76)

f_labelText(ze.ZoneView v, string rootSummary) =>
    string touchText = v.phase == 3 ? "Current T" + str.tostring(v.currentTouchNo) : "Upcoming T" + str.tostring(v.upcomingTouchNo)
    string txt = "Core " + str.tostring(v.coreId) + " / Gen " + str.tostring(v.generationId) + " / " + ze.sideName(v.side) + "\n"
    txt := txt + ze.phaseName(v.phase) + " | " + ze.gradeName(v.grade) + "\n"
    txt := txt + str.tostring(v.effectiveBottom, format.mintick) + " - " + str.tostring(v.effectiveTop, format.mintick) + " | Ref " + str.tostring(v.referencePrice, format.mintick) + "\n"
    txt := txt + "C" + str.tostring(v.cCount) + " / H" + str.tostring(v.hCount) + " / " + ze.densityName(v.density) + " | " + touchText + "\n"
    txt := txt + "Weak " + ze.weakReasonName(v.weakReason) + " / Depth " + str.tostring(v.maxDepthPct, "#.0") + "% | ZFresh " + str.tostring(v.zoneFresh) + " / SFresh " + str.tostring(v.sideFresh) + "\n"
    txt := txt + "FVG dirMask " + str.tostring(v.fvgDirectionMask) + " / Fresh " + str.tostring(v.fvgFreshCount) + "/" + str.tostring(v.fvgRootCount) + " / state " + str.tostring(v.fvgStructuralStateMask) + "\n"
    txt := txt + rootSummary
    txt

f_viewDistance(ze.ZoneView v, float px) =>
    float d = 1e12
    if not na(v) and not na(v.effectiveBottom) and not na(v.effectiveTop)
        float lo = math.min(v.effectiveBottom, v.effectiveTop)
        float hi = math.max(v.effectiveBottom, v.effectiveTop)
        d := px < lo ? lo - px : px > hi ? px - hi : 0.0
    d

f_insertByDistance(array<int> idxs, array<float> dists, int idx, float dist) =>
    int pos = array.size(dists)
    int n = array.size(dists)
    if n > 0
        for j = 0 to n - 1
            if dist < array.get(dists, j)
                pos := j
                break
    array.insert(idxs, pos, idx)
    array.insert(dists, pos, dist)
    true

f_hasViewIndex(array<int> idxs, int idx) =>
    bool found = false
    int n = array.size(idxs)
    if n > 0
        for j = 0 to n - 1
            if array.get(idxs, j) == idx
                found := true
                break
    found

f_buildNearestDrawOrder(ze.ZoneEngine eng, int totalViews, int maxCount, float px, bool balance) =>
    array<int> allIdx = array.new<int>()
    array<float> allDist = array.new<float>()
    array<int> supIdx = array.new<int>()
    array<float> supDist = array.new<float>()
    array<int> resIdx = array.new<int>()
    array<float> resDist = array.new<float>()

    if totalViews > 0
        for vi = 0 to totalViews - 1
            ze.ZoneView vv = ze.viewAt(eng, vi)
            if not na(vv)
                float dd = f_viewDistance(vv, px)
                f_insertByDistance(allIdx, allDist, vi, dd)
                if vv.side == 1
                    f_insertByDistance(supIdx, supDist, vi, dd)
                else if vv.side == -1
                    f_insertByDistance(resIdx, resDist, vi, dd)

    int target = math.min(maxCount, array.size(allIdx))
    array<int> selected = array.new<int>()

    if balance and target > 0
        int half = int(math.floor(target * 0.5))
        int supTake = math.min(half, array.size(supIdx))
        int resTake = math.min(half, array.size(resIdx))

        if supTake > 0
            for j = 0 to supTake - 1
                array.push(selected, array.get(supIdx, j))
        if resTake > 0
            for j = 0 to resTake - 1
                array.push(selected, array.get(resIdx, j))

        int allN = array.size(allIdx)
        if allN > 0 and array.size(selected) < target
            for j = 0 to allN - 1
                int idx = array.get(allIdx, j)
                if not f_hasViewIndex(selected, idx)
                    array.push(selected, idx)
                    if array.size(selected) >= target
                        break
    else if target > 0
        for j = 0 to target - 1
            array.push(selected, array.get(allIdx, j))

    // Sort the final selected set by absolute distance for stable visual order.
    array<int> finalIdx = array.new<int>()
    array<float> finalDist = array.new<float>()
    int selectedN = array.size(selected)
    if selectedN > 0
        for j = 0 to selectedN - 1
            int idx = array.get(selected, j)
            ze.ZoneView vv = ze.viewAt(eng, idx)
            f_insertByDistance(finalIdx, finalDist, idx, f_viewDistance(vv, px))

    finalIdx

if barstate.islast
    int totalViews = ze.viewCount(engine)
    int drawN = math.min(math.min(totalViews, maxDraw), 30)
    array<int> drawOrder = f_buildNearestDrawOrder(engine, totalViews, drawN, close, balanceSides)
    f_ensurePools(30)
    for i = 0 to 29
        box bx = array.get(boxPool, i)
        line ln = array.get(linePool, i)
        label lb = array.get(labelPool, i)
        if showZones and i < array.size(drawOrder)
            int viewIdx = array.get(drawOrder, i)
            ze.ZoneView v = ze.viewAt(engine, viewIdx)
            bool lineZone = not na(v) and v.effectiveBottom == v.effectiveTop
            color vc = not na(v) ? f_viewColor(v) : na
            if not na(v) and lineZone
                line.set_xy1(ln, bar_index - 1, v.effectiveBottom)
                line.set_xy2(ln, bar_index, v.effectiveTop)
                line.set_extend(ln, extend.right)
                line.set_color(ln, vc)
                line.set_width(ln, v.phase == 3 ? 3 : 1)
                box.set_bgcolor(bx, na)
                box.set_border_color(bx, na)
            else if not na(v)
                box.set_lefttop(bx, bar_index - 1, v.effectiveTop)
                box.set_rightbottom(bx, bar_index, v.effectiveBottom)
                box.set_extend(bx, extend.right)
                box.set_bgcolor(bx, vc)
                box.set_border_color(bx, v.phase == 3 ? color.new(vc, 0) : color.new(vc, 35))
                box.set_border_width(bx, v.phase == 3 ? 2 : 1)
                line.set_color(ln, na)
            if showLabels and not na(v) and i < cfg.maxLabelsDrawn
                label.set_xy(lb, bar_index + 1, na(v.referencePrice) ? (v.effectiveBottom + v.effectiveTop) * 0.5 : v.referencePrice)
                label.set_text(lb, f_labelText(v, ze.viewRootSummary(engine, viewIdx)))
                label.set_color(lb, color.new(color.black, 20))
                label.set_textcolor(lb, color.white)
            else
                label.set_text(lb, "")
                label.set_color(lb, na)
        else
            box.set_bgcolor(bx, na)
            box.set_border_color(bx, na)
            line.set_color(ln, na)
            label.set_text(lb, "")
            label.set_color(lb, na)

// ============================================================================
// Debug table
// ============================================================================
var table dbg = table.new(position.top_right, 2, 19, border_width = 1)
if barstate.islast and showDebug
    int evN = ze.eventCount(engine)
    string lastEvent = evN > 0 ? ze.eventName(ze.eventAt(engine, evN - 1).eventType) : "-"
    table.cell(dbg, 0, 0, "Build")
    table.cell(dbg, 1, 0, ze.buildId())
    table.cell(dbg, 0, 1, "Chart")
    table.cell(dbg, 1, 1, is5m ? "5m OK" : "ERROR: use 5m")
    table.cell(dbg, 0, 2, "Config")
    table.cell(dbg, 1, 2, ze.configValid(engine) ? "OK" : ze.configError(engine))
    table.cell(dbg, 0, 3, "Core / View / Root")
    table.cell(dbg, 1, 3, str.tostring(ze.liveCoreCount(engine)) + " / " + str.tostring(ze.viewCount(engine)) + " / " + str.tostring(ze.rootCount(engine)))
    table.cell(dbg, 0, 4, "Candidates")
    table.cell(dbg, 1, 4, str.tostring(ze.candidateCountLast(engine)))
    table.cell(dbg, 0, 5, "Last event")
    table.cell(dbg, 1, 5, lastEvent)
    table.cell(dbg, 0, 6, "MA slopes")
    string maSlopeText = na(ma1m) ? "na / na" : str.tostring(ma1m.slope2000, "#.###") + " / " + str.tostring(ma1m.slope3000, "#.###")
    table.cell(dbg, 1, 6, maSlopeText)
    table.cell(dbg, 0, 7, "Session / Day / Week")
    table.cell(dbg, 1, 7, str.tostring(ze.sessionKey(engine)) + " / " + str.tostring(ze.dayKey(engine)) + " / " + str.tostring(ze.weekKey(engine)))
    table.cell(dbg, 0, 8, "Pending T / G")
    table.cell(dbg, 1, 8, str.tostring(ze.pendingTopologyCount(engine)) + " / " + str.tostring(ze.pendingGenerationCount(engine)))
    table.cell(dbg, 0, 9, "Pruned")
    table.cell(dbg, 1, 9, str.tostring(ze.storagePruned(engine)) + " R" + str.tostring(ze.prunedRootCount(engine)) + " Z" + str.tostring(ze.prunedZoneCount(engine)))
    table.cell(dbg, 0, 10, "Touch hist trunc")
    table.cell(dbg, 1, 10, str.tostring(ze.touchHistoryTruncated(engine)))
    table.cell(dbg, 0, 11, "Last base")
    table.cell(dbg, 1, 11, str.tostring(ze.lastBaseOpenTime(engine)))
    table.cell(dbg, 0, 12, "Advanced")
    table.cell(dbg, 1, 12, str.tostring(engineAdvanced))
    table.cell(dbg, 0, 13, "State history")
    table.cell(dbg, 1, 13, str.tostring(historyDays) + "d")
    table.cell(dbg, 0, 14, "HTF bootstrap")
    table.cell(dbg, 1, 14, str.tostring(bootstrapDays) + "d / $" + str.tostring(bootstrapDistance, "#"))
    table.cell(dbg, 0, 15, "Boot Accum / FVG")
    table.cell(dbg, 1, 15, str.tostring(bootstrapAccumInjected) + " / " + str.tostring(bootstrapFvgInjected))
    table.cell(dbg, 0, 16, "Req 1m / 15m")
    table.cell(dbg, 1, 16, str.tostring(req1mBars) + " / " + str.tostring(req15mBars))
    table.cell(dbg, 0, 17, "Boot 4H / 1D bars")
    table.cell(dbg, 1, 17, str.tostring(boot4hBars) + " / " + str.tostring(boot1dBars))
    table.cell(dbg, 0, 18, "Draw order")
    table.cell(dbg, 1, 18, balanceSides ? "Nearest + S/R balance" : "Nearest")
else if barstate.islast
    table.clear(dbg, 0, 0, 1, 18)

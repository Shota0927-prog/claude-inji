    array.push(g, "X1 b1||5,0,0,0,1,0,0,0,1,n,n,n,100,110,0,n,n,n,n,n,0,n,n,n,n,n,n,n,0,-1,n,5,0,0,0,1,0,0,0,1,n,n,n,100,110,0,n,n,n,n,n,0,n,n,n,n,n,n,n,0,-1,n|1|1|1")

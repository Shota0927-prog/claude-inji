type HM
    array<int>    ints
    array<int>    fld
    array<int>    runs
    array<string> fname
    array<string> ename
    string        scen
    int           scenBar
    bool          hasFirst
    string        fScen
    string        fKind
    string        fField
    string        fExpTag
    string        fActTag
    int           fBar
    int           fGold
    int           fSide
    int           fEvIdx
    int           fExpCount
    int           fActCount
    float         fExp
    float         fAct
    array<float>  evExp
    array<float>  evAct
    array<float>  x2
    int           preFail
hmNew() =>
    HM h = HM.new()
    h.ints  := array.new_int(10, 0)
    h.fld   := array.new_int(35, 0)
    h.runs  := array.new_int(31, 0)
    h.fname := array.from("PHASE", "GRADE", "TOUCH_COUNT", "CURRENT_TOUCH_NO", "UPCOMING", "WEAK_TOUCH", "WEAK_DEPTH", "MAX_DEPTH", "FRESH", "ARMED_FROM_SEQ", "LAST_ARMED_BOTTOM", "LAST_ARMED_TOP", "RANGE_BOTTOM", "RANGE_TOP", "TSS_VALID", "TSS_BOTTOM", "TSS_TOP", "TSS_TOUCH_NO", "TSS_START_GRADE", "TSS_MAX_DEPTH", "BS_VALID", "BS_BOTTOM", "BS_TOP", "BS_OLD_SIDE", "BS_BREAK_SEQ", "BS_MOVED_AWAY", "BS_RETEST_SEEN", "BS_WAS_GAP", "FLIP_ATTEMPT", "LAST_FLIP_CONFIRM_SEQ", "LAST_NORMAL_TOUCH_TIME", "ZONE_FRESH", "CORE_DORMANT", "STATE_LENGTH", "TOPO_MARK_HISTORY")
    h.ename := array.from("type", "time", "seq", "coreId", "generationId", "side", "rangeBottom", "rangeTop", "touchNo", "gradeAtStart", "weakReason", "rootId")
    h.scen := ""
    h.scenBar := 0
    h.hasFirst := false
    h.fScen := ""
    h.fKind := ""
    h.fField := ""
    h.fExpTag := ""
    h.fActTag := ""
    h.fBar := -1
    h.fGold := -1
    h.fSide := -1
    h.fEvIdx := -1
    h.fExpCount := -1
    h.fActCount := -1
    h.fExp := na
    h.fAct := na
    h.evExp := array.new_float(0)
    h.evAct := array.new_float(0)
    h.x2 := array.new_float(132)
    h.preFail := 0
    h
// the first drift only (never overwritten)
hmFirst(HM met, string kind, string field, int gi, int side, float ev, float av) =>
    if not met.hasFirst
        met.hasFirst := true
        met.fScen  := met.scen
        met.fKind  := kind
        met.fField := field
        met.fBar   := met.scenBar
        met.fGold  := gi
        met.fSide  := side
        met.fExp   := ev
        met.fAct   := av
    met.hasFirst
// index of the first differing element (length difference: the shorter length), -1 when equal
vecFirst(array<float> g, array<float> p) =>
    int r = -1
    int i = 0
    while r < 0 and i < math.min(array.size(g), array.size(p))
        float a = array.get(g, i)
        float b = array.get(p, i)
        bool same = (na(a) and na(b)) or (not na(a) and not na(b) and math.abs(a - b) <= 0.000000001 * math.max(1.0, math.abs(a)))
        if not same
            r := i
        i += 1
    if r < 0 and array.size(g) != array.size(p)
        r := math.min(array.size(g), array.size(p))
    r


//@version=5
indicator(
     title       = "My FX Indicator",
     shorttitle  = "MyFX",
     overlay     = true,       // true: ローソク足に重ねて表示 / false: 別パネルに表示
     max_bars_back = 500
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_ma = "移動平均線"
ma_len  = input.int(20,  title = "MA 期間",  minval = 1, group = grp_ma)
ma_type = input.string("EMA", title = "MA 種別",
             options = ["SMA", "EMA", "WMA", "VWMA"], group = grp_ma)

grp_disp = "表示設定"
show_ma   = input.bool(true, title = "MA を表示", group = grp_disp)
ma_color  = input.color(color.new(color.blue, 0), title = "MA カラー", group = grp_disp)

// ============================================================
// 計算ロジック
// ============================================================
float ma_value = switch ma_type
    "SMA"  => ta.sma(close,  ma_len)
    "EMA"  => ta.ema(close,  ma_len)
    "WMA"  => ta.wma(close,  ma_len)
    "VWMA" => ta.vwma(close, ma_len)
    =>        ta.ema(close,  ma_len)

// トレンド方向（MA が上向き = 上昇トレンド）
bool uptrend   = ma_value > ma_value[1]
bool downtrend = ma_value < ma_value[1]

// ============================================================
// プロット
// ============================================================
plot(
     show_ma ? ma_value : na,
     title     = "MA",
     color     = uptrend ? color.lime : downtrend ? color.red : ma_color,
     linewidth = 2
 )

// 背景色でトレンドをハイライト
bgcolor(
     uptrend   ? color.new(color.green, 95) :
     downtrend ? color.new(color.red,   95) : na,
     title = "トレンド背景"
 )

// ============================================================
// アラート
// ============================================================
alertcondition(
     ta.crossover(close, ma_value),
     title   = "価格が MA を上抜け",
     message = "{{ticker}} : 価格が MA を上抜けました ({{close}})"
 )

alertcondition(
     ta.crossunder(close, ma_value),
     title   = "価格が MA を下抜け",
     message = "{{ticker}} : 価格が MA を下抜けました ({{close}})"
 )

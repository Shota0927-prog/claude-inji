//@version=5
strategy("XAUUSD BOS Pullback Continuation v3",
     overlay=true, initial_capital=1000, currency=currency.USD,
     pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false)

// ===================== 基本 =====================
gB = "基本 / 構造"
pivotLen = input.int(30, "スイング(ピボット)長さ", minval=1, group=gB)

gR = "資金 / ロット"
initCap    = input.float(1000.0, "初期資金($)※strategy設定と合わせる", group=gR)
riskPct    = input.float(3.0,  "1トレード損失(%・元金固定=単利)", group=gR) / 100.0
unitPerLot = input.float(1.0,  "1ロットあたりの数量(oz)", group=gR,
     tooltip="TVのXAUUSDは通常1単位=1oz。$50リスクでは100oz/lotにすると1lot未満で見送り。")

gE = "決済(SL/TP)"
slMode  = input.string("構造+MAスナップ", "SL方式",
     options=["構造+MAスナップ", "ATR可変", "固定$"], group=gE,
     tooltip="構造+MAスナップ: 壊した高安と押し安値/戻り高値を基準にSLを置き、外側に節目EMAがあればそこへ隠す(案A)。")
atrLen  = input.int(14,    "ATR期間", group=gE)
atrMult = input.float(1.5, "ATR×倍(SL距離・ATR可変時)", group=gE)
slFixed = input.float(15.0, "固定SL距離($・固定時)", group=gE)
rr      = input.float(2.0, "リスクリワード(TP=リスク×RR)", minval=0.1, group=gE)

// --- 構造ベースSL(構造+MAスナップ時) ---
structSlMult = input.float(0.5, "構造からの余白(ATR×)", minval=0.0, group=gE,
     tooltip="アンカー(壊した高安と押し安値/戻り高値の低い/高い方)からATR×この値だけ外側にSLを置く。")
minRiskMult  = input.float(0.5, "最小リスク(ATR×)", minval=0.0, group=gE,
     tooltip="SLがこれより近いと最小リスクまで広げる(超大ロット/食い込み防止)。")
maxRiskMult  = input.float(3.0, "最大リスク(ATR×・超で見送り)", minval=0.1, group=gE,
     tooltip="構造が遠くSLがこの距離を超える場合はエントリーを見送る。")

// --- MAスナップ(案A: 構造の外側のみ) ---
gS = "決済 / MAスナップ"
useMaSnap     = input.bool(true,  "MAスナップを使う(外側のみ)", group=gS,
     tooltip="構造SLのさらに外側に節目EMAがあれば、その手前までSLを隠す。内側(タイト化)はしない=構造が底。")
maSnapMaxMult = input.float(1.5, "スナップ許容(生リスク×)", minval=1.0, group=gS,
     tooltip="スナップ後リスクが生リスク×この値を超えるなら採用しない(外へ伸ばし過ぎ防止)。")
maSlBufMult   = input.float(0.3, "EMA手前バッファ(ATR×)", minval=0.0, group=gS)
useSnap1 = input.bool(true, "対象EMA① 使う", inline="s1", group=gS)
snapEma1 = input.int(20,  "期間", inline="s1", group=gS)
useSnap2 = input.bool(true, "対象EMA② 使う", inline="s2", group=gS)
snapEma2 = input.int(50,  "期間", inline="s2", group=gS)
useSnap3 = input.bool(true, "対象EMA③ 使う", inline="s3", group=gS)
snapEma3 = input.int(100, "期間", inline="s3", group=gS)
useSnap4 = input.bool(true, "対象EMA④ 使う", inline="s4", group=gS)
snapEma4 = input.int(200, "期間", inline="s4", group=gS)
showSnapEma = input.bool(false, "スナップ対象EMAを表示", group=gS)

// ⑤ Session
gT = "⑤ 時間帯(日本時間 JST)"
useTime = input.bool(true, "時間フィルターを使う", group=gT)
sess    = input.session("1000-0300", "取引時間", group=gT)
tz = "Asia/Tokyo"

// ① Impulse BOS (SSS)
g1 = "① Impulse BOS"
useImpulse = input.bool(true, "① 強いBOSのみ", group=g1)
impBodyMin = input.float(0.4, "  実体比 >", group=g1)
impAtrMult = input.float(0.1, "  抜け幅 > ATR×", group=g1)

// ② Compression後限定 (SSS)
g2 = "② Compression後限定"
useComp     = input.bool(false, "② 溜めを待つ", group=g2)
compMult    = input.float(0.6, "  小レンジ判定 < ATR×", group=g2)
compMinBars = input.int(4,     "  必要な溜め本数", minval=1, group=g2)

// ③ Reacceleration entry (SSS)
g3 = "③ Reacceleration entry"
useReaccel     = input.bool(false, "③ 再加速で入る", group=g3)
reaccelBodyMin = input.float(0.2, "  実体比 >", group=g3)

// ④ EMA slope (SS)
g4 = "④ EMA slope"
useEmaSlope = input.bool(true, "④ EMA傾きフィルター", group=g4)
emaLen      = input.int(200, "  EMA期間", group=g4)
emaSlopeLB  = input.int(10,  "  傾き参照本数", group=g4)

// ⑥ ATR expansion (SS)
g6 = "⑥ ATR expansion"
useAtrExp = input.bool(true, "⑥ ボラ拡大時のみ", group=g6)
atrSmaLen = input.int(20, "  ATR平均期間", group=g6)

// ⑦ Pullback深度制限 (S)
g7 = "⑦ 浅押し限定"
usePbDepth = input.bool(false, "⑦ 深い押し目を除外", group=g7)
pbMult     = input.float(0.8,  "  許容深さ < ATR×", group=g7)

// ⑧ BOS freshness (S)
g8 = "⑧ BOS freshness"
useFresh = input.bool(false, "⑧ BOS直後のみ", group=g8)
maxFresh = input.int(10, "  BOS後の有効本数", group=g8)

// ⑨ Liquidity sweep後 (S)
g9 = "⑨ Liquidity sweep後"
useSweep = input.bool(false, "⑨ 流動性狩り後のみ", group=g9)
sweepLen = input.int(10, "  sweep参照本数", group=g9)

// ⑩ FVG付き限定 (S)
g10 = "⑩ FVG付き限定"
useFVG = input.bool(false, "⑩ imbalance必須", group=g10)

// ⑪ 上位足Supertrend 順張り
g11 = "⑪ 上位足Supertrend 順張り"
useHST  = input.bool(true,   "⑪ 上位足トレンド方向のみ", group=g11)
hstTF   = input.timeframe("60", "上位足", group=g11)
hstLen  = input.int(10,      "Supertrend ATR期間", group=g11)
hstMult = input.float(3.0,   "Supertrend 係数", group=g11)

// ===================== 建値移動の設定 =====================
gBE = "建値移動 (Break-even)"
useBE  = input.bool(false,  "建値移動を使う", group=gBE)
beTrig = input.float(15.0, "発動: 含み益方向に+$ 動いたら", group=gBE,
     tooltip="XAUUSDの価格(oz単価)が この$ だけ有利に動いたらSLを建値へ。")
beOff  = input.float(0.0,  "建値オフセット($)", group=gBE,
     tooltip="建値+この$ にSLを置く。スプレッド/手数料分を残したいとき>0に。")

// ===================== 共通計算 =====================
atr      = ta.atr(atrLen)
atrAvg   = ta.sma(atr, atrSmaLen)
atrExpand= atr > atrAvg
rng      = high - low
body     = math.abs(close - open)
bodyRatio= rng > 0 ? body / rng : 0.0
ema      = ta.ema(close, emaLen)
emaBull  = ema > ema[emaSlopeLB]
emaBear  = ema < ema[emaSlopeLB]

// スナップ対象EMA
ema_s1 = ta.ema(close, snapEma1)
ema_s2 = ta.ema(close, snapEma2)
ema_s3 = ta.ema(close, snapEma3)
ema_s4 = ta.ema(close, snapEma4)

// 構造SL/MAスナップ用のATR換算
realMaSlBuf = atr * maSlBufMult
realMinRisk = atr * minRiskMult
realMaxRisk = atr * maxRiskMult

bullFVG  = low  > high[2]
bearFVG  = high < low[2]
lowestPrev  = ta.lowest(low,  sweepLen)[1]
highestPrev = ta.highest(high, sweepLen)[1]
bullSwp  = low  < lowestPrev  and close > open
bearSwp  = high > highestPrev and close < open
// ⑪ 上位足Supertrend方向(リペイント防止: 確定足のみ参照)
hstDirFn() =>
    [_st, _dir] = ta.supertrend(hstMult, hstLen)
    _dir[1]
htfDir  = request.security(syminfo.tickerid, hstTF, hstDirFn(), lookahead = barmerge.lookahead_off)
htfBull = htfDir < 0
htfBear = htfDir > 0

// 時間フィルター
inSession = not na(time(timeframe.period, sess, tz))
canTrade  = (not useTime) or inSession

// ===================== MAスナップ関数 (案A: 外側のみ) =====================
// dir : 1=ロング(SLはentryの下) / -1=ショート(SLはentryの上)
// 構造SL(slRaw)より外側にある最も近いEMAへSLを寄せる。内側のEMAは無視。
// スナップ後リスクが rawRisk*maxMult を超える場合は採用しない。
f_snap_sl(dir, entry, slRaw, rawRisk, es, buf, maxMult) =>
    float bestEma = na
    if array.size(es) > 0
        for i = 0 to array.size(es) - 1
            e = array.get(es, i)
            if not na(e)
                if dir == 1
                    // 構造SLより下(外側)で、最も構造に近い(=値が大きい)EMA
                    if e < slRaw and (na(bestEma) or e > bestEma)
                        bestEma := e
                else
                    // 構造SLより上(外側)で、最も構造に近い(=値が小さい)EMA
                    if e > slRaw and (na(bestEma) or e < bestEma)
                        bestEma := e
    float chosen = slRaw
    if not na(bestEma)
        cand     = dir == 1 ? bestEma - buf : bestEma + buf
        candRisk = dir == 1 ? entry - cand : cand - entry
        if candRisk > 0 and candRisk <= rawRisk * maxMult
            chosen := cand
    chosen

// 構造(スイング高安)
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// ① BOS判定(Impulse切替)
rawBull    = not na(lastPH) and close > lastPH
rawBear    = not na(lastPL) and close < lastPL
strongBull = rawBull and bodyRatio > impBodyMin and (close - lastPH) > atr * impAtrMult
strongBear = rawBear and bodyRatio > impBodyMin and (lastPL - close) > atr * impAtrMult
bullBOS    = useImpulse ? strongBull : rawBull
bearBOS    = useImpulse ? strongBear : rawBear

// ===================== ステートマシン =====================
// state: 0=待機 / 1=上昇BOS→溜め→再加速待ち / -1=下降BOS→溜め→再加速待ち
var int   state   = 0
var int   bosBar  = 0
var int   compCnt = 0
var bool  sawFVG  = false
var bool  sawSwp  = false
var float hiSince = na
var float loSince = na
var float bosLvl  = na

longEntry  = false
shortEntry = false

if bearBOS and state >= 0
    state := -1
    bosBar := bar_index
    compCnt := 0
    sawFVG := false
    sawSwp := false
    hiSince := high
    loSince := low
    bosLvl := lastPL
else if bullBOS and state <= 0
    state := 1
    bosBar := bar_index
    compCnt := 0
    sawFVG := false
    sawSwp := false
    hiSince := high
    loSince := low
    bosLvl := lastPH

// ----- 上昇セットアップ管理 -----
if state == 1
    hiSince := math.max(hiSince, high)
    loSince := math.min(loSince, low)
    if rng < atr * compMult
        compCnt += 1
    if bullFVG
        sawFVG := true
    if bullSwp
        sawSwp := true
    if useFresh and bar_index - bosBar > maxFresh
        state := 0
    if state == 1 and bar_index > bosBar
        trig  = close > high[1] and close > open
        cComp = (not useComp)     or compCnt >= compMinBars
        cReac = (not useReaccel)  or (close > ema and bodyRatio > reaccelBodyMin)
        cSlp  = (not useEmaSlope) or emaBull
        cAtr  = (not useAtrExp)   or atrExpand
        cPb   = (not usePbDepth)  or (loSince >= bosLvl - atr * pbMult)
        cFvg  = (not useFVG)      or sawFVG
        cSwp  = (not useSweep)    or sawSwp
        cHst  = (not useHST)      or htfBull
        if trig and cComp and cReac and cSlp and cAtr and cPb and cFvg and cSwp and cHst
            longEntry := true
            state := 0

// ----- 下降セットアップ管理 -----
if state == -1
    hiSince := math.max(hiSince, high)
    loSince := math.min(loSince, low)
    if rng < atr * compMult
        compCnt += 1
    if bearFVG
        sawFVG := true
    if bearSwp
        sawSwp := true
    if useFresh and bar_index - bosBar > maxFresh
        state := 0
    if state == -1 and bar_index > bosBar
        trig  = close < low[1] and close < open
        cComp = (not useComp)     or compCnt >= compMinBars
        cReac = (not useReaccel)  or (close < ema and bodyRatio > reaccelBodyMin)
        cSlp  = (not useEmaSlope) or emaBear
        cAtr  = (not useAtrExp)   or atrExpand
        cPb   = (not usePbDepth)  or (hiSince <= bosLvl + atr * pbMult)
        cFvg  = (not useFVG)      or sawFVG
        cSwp  = (not useSweep)    or sawSwp
        cHst  = (not useHST)      or htfBear
        if trig and cComp and cReac and cSlp and cAtr and cPb and cFvg and cSwp and cHst
            shortEntry := true
            state := 0

// ===================== SL/TP & ロット & 発注 =====================
useStruct = slMode == "構造+MAスナップ"

// スナップ対象EMAを配列化
snapArr = array.new_float()
if useSnap1
    array.push(snapArr, ema_s1)
if useSnap2
    array.push(snapArr, ema_s2)
if useSnap3
    array.push(snapArr, ema_s3)
if useSnap4
    array.push(snapArr, ema_s4)

// 旧モード(対称SL距離)
slDistOld = slMode == "固定$" ? slFixed : atr * atrMult

// --- ロング SL ---
// [1] アンカー = min(壊した高値, 押し安値)  [2] 余白を引いて生SL
anchorL  = math.min(bosLvl, loSince)
slRawL   = anchorL - atr * structSlMult
rawRiskL = close - slRawL
// [3] MAスナップ(外側のみ)  [4] 案A: 構造より内側にしない  [5] 最小リスク確保
slStructL = useMaSnap ? f_snap_sl(1, close, slRawL, rawRiskL, snapArr, realMaSlBuf, maSnapMaxMult) : slRawL
slStructL := math.min(slStructL, slRawL)
slStructL := math.min(slStructL, close - realMinRisk)
longSL   = useStruct ? slStructL : close - slDistOld
longRisk = close - longSL

// --- ショート SL --- (ロングの鏡: アンカー = max(壊した安値, 戻り高値))
anchorS  = math.max(bosLvl, hiSince)
slRawS   = anchorS + atr * structSlMult
rawRiskS = slRawS - close
slStructS = useMaSnap ? f_snap_sl(-1, close, slRawS, rawRiskS, snapArr, realMaSlBuf, maSnapMaxMult) : slRawS
slStructS := math.max(slStructS, slRawS)
slStructS := math.max(slStructS, close + realMinRisk)
shortSL  = useStruct ? slStructS : close + slDistOld
shortRisk = shortSL - close

// --- ロット & リスク上限(構造モードのみ最大リスク見送り) ---
riskUSD    = initCap * riskPct
activeRisk = longEntry ? longRisk : shortEntry ? shortRisk : na
lotsRaw    = (not na(activeRisk)) and activeRisk > 0 ? riskUSD / (activeRisk * unitPerLot) : 0.0
lots       = math.round(lotsRaw)
qty        = lots * unitPerLot
riskCapOK  = (not useStruct) or ((not na(activeRisk)) and activeRisk > 0 and activeRisk <= realMaxRisk)
sizeOK     = lotsRaw >= 1.0 and qty > 0 and riskCapOK

// --- 発注 ---
flat = strategy.position_size == 0
var float beEntry = na
var float beTP    = na
var bool  beArmed = false
var int   beDir   = 0
if flat
    beArmed := false
if longEntry and canTrade and sizeOK and flat
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("L-exit", from_entry="Long", stop=longSL, limit=close + longRisk * rr)
    beEntry := close
    beTP    := close + longRisk * rr
    beArmed := useBE
    beDir   := 1
if shortEntry and canTrade and sizeOK and flat
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("S-exit", from_entry="Short", stop=shortSL, limit=close - shortRisk * rr)
    beEntry := close
    beTP    := close - shortRisk * rr
    beArmed := useBE
    beDir   := -1
// +beTrig 動いたらSLを建値(+beOff)へ移動
if useBE and beArmed and not flat
    if beDir == 1 and high >= beEntry + beTrig
        strategy.exit("L-exit", from_entry="Long", stop=beEntry + beOff, limit=beTP)
        beArmed := false
    else if beDir == -1 and low <= beEntry - beTrig
        strategy.exit("S-exit", from_entry="Short", stop=beEntry - beOff, limit=beTP)
        beArmed := false

// ===================== 表示 =====================
plot(useEmaSlope or useReaccel ? ema : na, "EMA", color=color.new(color.orange, 0))
plot(showSnapEma and useSnap1 ? ema_s1 : na, "snapEMA①", color=color.new(color.gray, 40))
plot(showSnapEma and useSnap2 ? ema_s2 : na, "snapEMA②", color=color.new(color.gray, 50))
plot(showSnapEma and useSnap3 ? ema_s3 : na, "snapEMA③", color=color.new(color.gray, 60))
plot(showSnapEma and useSnap4 ? ema_s4 : na, "snapEMA④", color=color.new(color.gray, 70))
plotshape(longEntry  and canTrade and sizeOK, title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.teal, size=size.tiny)
plotshape(shortEntry and canTrade and sizeOK, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)
bgcolor(useHST ? (htfBull ? color.new(color.teal, 92) : htfBear ? color.new(color.red, 92) : na) : na, title="HTF bias")

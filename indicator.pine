//@version=5
indicator(
     title       = "Gold Inverse-Correlation Break",
     shorttitle  = "Gold-CorrBreak",
     overlay     = true,
     max_bars_back = 500
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_sym = "シンボル設定"
gold_sym  = input.symbol("TVC:GOLD",  title = "ゴールド",  group = grp_sym)
dxy_sym   = input.symbol("TVC:DXY",   title = "DXY",       group = grp_sym)
us10y_sym = input.symbol("TVC:US10Y", title = "US10Y",     group = grp_sym)

grp_corr = "相関設定 (普段は逆相関 → 崩れた時に着色)"
corr_len  = input.int(20, title = "相関期間", minval = 2, group = grp_corr)
break_th  = input.float(0.3, title = "逆相関が崩れたと判定する相関値 (これ以上で着色)",
             minval = -1.0, maxval = 1.0, step = 0.05, group = grp_corr)

grp_color = "カラー設定"
col_dxy_only   = input.color(color.new(#E65100, 0), title = "DXY との逆相関が崩れた (濃いオレンジ)",   group = grp_color)
col_us10y_only = input.color(color.new(#FFB74D, 0), title = "US10Y との逆相関が崩れた (薄いオレンジ)", group = grp_color)
col_both       = input.color(color.new(#FFD700, 0), title = "両方とも崩れた (ゴールド)",                group = grp_color)

// ============================================================
// データ取得
// ============================================================
gold_close  = request.security(gold_sym,  timeframe.period, close)
dxy_close   = request.security(dxy_sym,   timeframe.period, close)
us10y_close = request.security(us10y_sym, timeframe.period, close)

// ============================================================
// 相関計算
// ============================================================
corr_dxy   = ta.correlation(gold_close, dxy_close,   corr_len)
corr_us10y = ta.correlation(gold_close, us10y_close, corr_len)

// 「逆相関が崩れた」= 相関係数が break_th 以上に上がってきた
bool dxy_break   = corr_dxy   >= break_th
bool us10y_break = corr_us10y >= break_th

// ============================================================
// ローソク足の色付け
// ============================================================
color candle_col = dxy_break and us10y_break ? col_both :
                   dxy_break                 ? col_dxy_only :
                   us10y_break               ? col_us10y_only : na

barcolor(candle_col, title = "逆相関ブレイク カラー")

// ============================================================
// 状態テーブル (右上に現在の相関値を表示)
// ============================================================
grp_info = "情報表示"
show_info = input.bool(true, title = "相関値テーブルを表示", group = grp_info)

var table info_tbl = table.new(position.top_right, 3, 3, border_width = 1)
if show_info and barstate.islast
    table.cell(info_tbl, 0, 0, "ペア",         bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 1, 0, "相関係数",     bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 2, 0, "状態",         bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 0, 1, "GOLD vs DXY",   bgcolor = dxy_break   ? col_dxy_only   : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 1, str.tostring(corr_dxy,   "#.00"),    bgcolor = dxy_break   ? col_dxy_only   : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 2, 1, dxy_break   ? "崩れた" : "正常",      bgcolor = dxy_break   ? col_dxy_only   : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 0, 2, "GOLD vs US10Y", bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 2, str.tostring(corr_us10y, "#.00"),    bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 2, 2, us10y_break ? "崩れた" : "正常",      bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)

// ============================================================
// アラート
// ============================================================
alertcondition(dxy_break and us10y_break, title = "GOLD: DXY/US10Y 両方の逆相関が崩れた", message = "{{ticker}} : ゴールドと DXY/US10Y の両方の逆相関が崩れました")
alertcondition(dxy_break   and not us10y_break, title = "GOLD: DXY との逆相関が崩れた",   message = "{{ticker}} : ゴールドと DXY の逆相関が崩れました")
alertcondition(us10y_break and not dxy_break,   title = "GOLD: US10Y との逆相関が崩れた", message = "{{ticker}} : ゴールドと US10Y の逆相関が崩れました")

duuReqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpDuuEnv)
duuReqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], group = grpDuuEnv)
duuReqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpDuuEnv)
duuReqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpDuuEnv)

grpDuuTrig = "B_DUU: エントリートリガー (包み足/ピンバー/EMAリジェクト)"
duuUseEngulf    = input.bool(true,  "包み足",             group = grpDuuTrig)
duuUsePin       = input.bool(true,  "ピンバー",           group = grpDuuTrig)
duuUseBOS       = input.bool(false, "BOS / 直近高安更新", group = grpDuuTrig)
duuUseEMAReject = input.bool(true,  "EMAリジェクト",      group = grpDuuTrig)
duuUseFVGForm   = input.bool(false, "FVG形成",            group = grpDuuTrig)
duuUseStrong    = input.bool(false, "強ローソク",         group = grpDuuTrig)
duuTriggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"], group = grpDuuTrig)
duuMinTriggerCount = input.int(1, "最低トリガー数 (MinCount時)", minval = 1, group = grpDuuTrig)
duuPinWickBodyMult    = input.float(2.0, "ピンバー ヒゲ/実体倍率", step = 0.1, group = grpDuuTrig)
duuPinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限", step = 0.1, group = grpDuuTrig)
duuBosLookback     = input.int(10, "BOS Lookback", minval = 2, group = grpDuuTrig)
duuEmaLenTrigger   = input.int(20, "EMA Length (EMAリジェクト)", minval = 1, group = grpDuuTrig)
duuUseEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター", group = grpDuuTrig)
duuEmaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数", minval = 1, group = grpDuuTrig)
duuEmaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率", minval = 0.0, step = 0.01, group = grpDuuTrig)
duuEmaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間", minval = 1, group = grpDuuTrig)
duuStrongBodyRatio = input.float(0.6, "強ローソク 実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpDuuTrig)
duuTrigCloseEdgeRatio = input.float(0.7, "ピンバー/強ローソク 終値端寄せ比率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpDuuTrig)

grpDuuMacd = "B_DUU: MACD"
duuUseMACDStateWindow = input.bool(true, "MACD状態管理を使う", group = grpDuuMacd)
duuMacdStateMaxBars   = input.int(5, "MACD状態 有効本数", minval = 1, group = grpDuuMacd)
duuResetMACDStateAfterEntry = input.bool(true, "エントリー後MACD状態をリセット", group = grpDuuMacd)
duuUseMACDSignalCross          = input.bool(false, "A: Signalクロス",       group = grpDuuMacd)
duuUseMACDZeroCross            = input.bool(false, "C: ゼロクロス",          group = grpDuuMacd)
duuUseMACDHistExpansion        = input.bool(true,  "D: Hist拡大",           group = grpDuuMacd)
duuUseMACDRegularDivergence    = input.bool(false, "F: Regular Divergence", group = grpDuuMacd)
duuUseMACDHiddenDivergence     = input.bool(false, "G: Hidden Divergence",  group = grpDuuMacd)
duuUseMACDCompressionExpansion = input.bool(false, "H: 収束→拡散",          group = grpDuuMacd)
duuMacdFastLen   = input.int(8,  "Fast EMA",   minval = 1, group = grpDuuMacd)
duuMacdSlowLen   = input.int(21, "Slow EMA",   minval = 1, group = grpDuuMacd)
duuMacdSignalLen = input.int(5,  "Signal EMA", minval = 1, group = grpDuuMacd)
duuMacdHistExpansionBars           = input.int(3, "拡大 連続本数", minval = 1, group = grpDuuMacd)
duuUseMACDHistExpansionConsecutive = input.bool(true, "連続拡大を要求", group = grpDuuMacd)
duuUseMACDHistSlopeStrength        = input.bool(false, "Histスロープ勢いを要求", group = grpDuuMacd)
duuMacdHistSlopeMin                = input.float(0.02, "最小Histスロープ", minval = 0.0, step = 0.01, group = grpDuuMacd)
duuUseMACDATRNormalizedThreshold   = input.bool(false, "収束しきい値をATR正規化", group = grpDuuMacd)
duuMacdAtrLen                      = input.int(14, "ATR期間", minval = 1, group = grpDuuMacd)
duuMacdCompressionThreshold        = input.float(0.05, "収束しきい値 |hist|", minval = 0.0, step = 0.01, group = grpDuuMacd)
duuMacdCompressionBars             = input.int(3, "収束 継続本数", minval = 1, group = grpDuuMacd)
duuUseMACDRelativeCompression      = input.bool(true, "相対収束を使う", group = grpDuuMacd)

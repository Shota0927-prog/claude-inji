//@version=5
indicator(
     title       = "Gold Inverse-Correlation Break",
     shorttitle  = "Gold-CorrBreak",
     overlay     = true,
     max_bars_back = 500
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_sym = "シンボル設定"
gold_sym  = input.symbol("TVC:GOLD",  title = "ゴールド",  group = grp_sym)
dxy_sym   = input.symbol("TVC:DXY",   title = "DXY",       group = grp_sym)
us10y_sym = input.symbol("TVC:US10Y", title = "US10Y",     group = grp_sym)

grp_corr = "相関設定 (普段は逆相関 → 崩れた時に着色)"
corr_tf      = input.timeframe("60", title = "相関を計算する時間足", group = grp_corr)
corr_len     = input.int(24, title = "相関期間 (1H足での本数)", minval = 2, group = grp_corr)
break_th     = input.float(0.2, title = "逆相関が崩れたと判定する相関値 (これ以上で着色)",
                 minval = -1.0, maxval = 1.0, step = 0.05, group = grp_corr)
dir_lookback = input.int(4, title = "方向判定の期間 (1H足での本数)", minval = 1, group = grp_corr)

grp_color = "カラー設定"
col_dxy_only   = input.color(color.new(#E65100, 0), title = "DXY との逆相関が崩れた (濃いオレンジ)", group = grp_color)
col_us10y_only = input.color(color.new(#8B4513, 0), title = "US10Y との逆相関が崩れた (茶色)",       group = grp_color)
col_both       = input.color(color.new(#FFD700, 0), title = "両方とも崩れた (ゴールド)",              group = grp_color)
col_normal_bull = input.color(color.new(#FFFFFF, 0), title = "通常の陽線色", group = grp_color)
col_normal_bear = input.color(color.new(#FB2589, 0), title = "通常の陰線色", group = grp_color)

grp_arrow  = "矢印表示"
show_arrow = input.bool(true, title = "歪みの方向矢印を表示", group = grp_arrow)

grp_info  = "情報表示"
show_info = input.bool(true, title = "相関値テーブルを表示", group = grp_info)

// 動作する時間足を制限（5分足 or 15分足のみ表示）
bool is_target_tf = timeframe.period == "5" or timeframe.period == "15"

// ============================================================
// データ取得 (相関計算用の時間足から OHLC を取得)
// ============================================================
[gold_o, gold_h, gold_l, gold_c] = request.security(gold_sym, corr_tf, [open, high, low, close])
[dxy_o,  dxy_h,  dxy_l,  dxy_c]  = request.security(dxy_sym,  corr_tf, [open, high, low, close])
us10y_c = request.security(us10y_sym, corr_tf, close)

// ============================================================
// 相関計算
// ============================================================
corr_dxy   = ta.correlation(gold_c, dxy_c,   corr_len)
corr_us10y = ta.correlation(gold_c, us10y_c, corr_len)

// 「逆相関が崩れた」= 相関係数が break_th 以上に上がってきた
bool dxy_break   = corr_dxy   >= break_th
bool us10y_break = corr_us10y >= break_th

// 直近 dir_lookback 本での変化率（プラス=上昇、マイナス=下落）
dxy_change   = (dxy_c   - dxy_c[dir_lookback])   / dxy_c[dir_lookback]
us10y_change = (us10y_c - us10y_c[dir_lookback]) / us10y_c[dir_lookback]

// 歪みの方向判定
bool dxy_long_div    = dxy_break   and dxy_change   < 0
bool dxy_short_div   = dxy_break   and dxy_change   > 0
bool us10y_long_div  = us10y_break and us10y_change < 0
bool us10y_short_div = us10y_break and us10y_change > 0

// ============================================================
// ローソク足の色付け
// ============================================================
// 対象外の時間足では歪み判定を無視して通常色だけで描画
color base_col = is_target_tf and dxy_break and us10y_break ? col_both :
                 is_target_tf and dxy_break                 ? col_dxy_only :
                 is_target_tf and us10y_break               ? col_us10y_only :
                 close >= open                              ? col_normal_bull :
                                                              col_normal_bear

bool is_bull   = close >= open
bool has_break = dxy_break or us10y_break

// 歪みバーの陰線だけ中抜き、それ以外（対象外TF含む）は塗りつぶし
color body_col   = (is_target_tf and has_break and not is_bull) ? color.new(base_col, 100) : base_col
color border_col = base_col
color wick_col   = base_col

plotcandle(open, high, low, close,
     title       = "歪みローソク足",
     color       = body_col,
     wickcolor   = wick_col,
     bordercolor = border_col)

// ============================================================
// 矢印 (歪みの方向)
// ============================================================
plotshape(is_target_tf and show_arrow and (dxy_long_div or us10y_long_div),
     title    = "ロング歪み矢印",
     style    = shape.triangleup,
     location = location.belowbar,
     color    = dxy_long_div and us10y_long_div ? col_both :
                dxy_long_div                    ? col_dxy_only : col_us10y_only,
     size     = size.small)

plotshape(is_target_tf and show_arrow and (dxy_short_div or us10y_short_div),
     title    = "ショート歪み矢印",
     style    = shape.triangledown,
     location = location.abovebar,
     color    = dxy_short_div and us10y_short_div ? col_both :
                dxy_short_div                     ? col_dxy_only : col_us10y_only,
     size     = size.small)

// ============================================================
// 状態テーブル (右上に現在の相関値・方向を表示)
// ============================================================
var table info_tbl = table.new(position.top_right, 4, 3, border_width = 1)
if is_target_tf and show_info and barstate.islast
    table.cell(info_tbl, 0, 0, "ペア",         bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 1, 0, "相関係数",     bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 2, 0, "状態",         bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 3, 0, "方向",         bgcolor = color.new(color.gray, 70), text_color = color.white)

    dxy_dir_str = dxy_long_div ? "▲ ロング" : dxy_short_div ? "▼ ショート" : "-"
    table.cell(info_tbl, 0, 1, "GOLD vs DXY",                       bgcolor = dxy_break ? col_dxy_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 1, str.tostring(corr_dxy, "#.00"),      bgcolor = dxy_break ? col_dxy_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 2, 1, dxy_break ? "崩れた" : "正常",        bgcolor = dxy_break ? col_dxy_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 3, 1, dxy_dir_str,                         bgcolor = dxy_break ? col_dxy_only : color.new(color.gray, 80), text_color = color.white)

    us10y_dir_str = us10y_long_div ? "▲ ロング" : us10y_short_div ? "▼ ショート" : "-"
    table.cell(info_tbl, 0, 2, "GOLD vs US10Y",                     bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 2, str.tostring(corr_us10y, "#.00"),    bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 2, 2, us10y_break ? "崩れた" : "正常",      bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 3, 2, us10y_dir_str,                       bgcolor = us10y_break ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)

// ============================================================
// アラート
// ============================================================
alertcondition(dxy_break and us10y_break, title = "GOLD: DXY/US10Y 両方の逆相関が崩れた", message = "{{ticker}} : ゴールドと DXY/US10Y の両方の逆相関が崩れました")
alertcondition(dxy_break   and not us10y_break, title = "GOLD: DXY との逆相関が崩れた",   message = "{{ticker}} : ゴールドと DXY の逆相関が崩れました")
alertcondition(us10y_break and not dxy_break,   title = "GOLD: US10Y との逆相関が崩れた", message = "{{ticker}} : ゴールドと US10Y の逆相関が崩れました")

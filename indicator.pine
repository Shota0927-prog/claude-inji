// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © ka.mickey15
//
// ============================================================
//  5分足 包み足ストラテジー (Engulfing Strategy) ─ 軽量版
// ------------------------------------------------------------
//  重量モジュールを撤去した軽量構成。残しているのは 4 本柱のみ:
//    ① 方向   : 環境認識モジュール (4H/1H/15M/5M/1M の EMA トレンド)
//    ② FVG    : FVG 場所フィルター (反発 / 吸収 / iFVG + 状態管理)
//    ③ EMA    : EMA WinZone (MTF 200/600/1000/2000/3000 反応帯)
//    ④ エントリー : 包み足 / ピンバー / BOS / EMAリジェクト / FVG形成 / 強ローソク
//  補助として ボラフィルタ・時間帯フィルタ・リスク/決済 を残す。
//
//  撤去したモジュール (重量の主因) :
//    ・出来高 / VPVR / POC (bin ループ)
//    ・Accumulation MTF (多数の request.security + ループ)
//    ・Head & Shoulders (Pivot Queue / 配列操作)
//    ・フィボ WinZone
//    ・Macro (DXY / 金利)
//    ・Momentum (ストキャス)
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "5min Engulfing Strategy (Lite)",
     shorttitle        = "ENG5L",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100
 )

// ============================================================
//  1. 入力 : エントリー
// ============================================================
grpEntry = "エントリー"
useLong      = input.bool(true, "ロングを有効",              group = grpEntry)
useShort     = input.bool(true, "ショートを有効",            group = grpEntry)
strictEngulf = input.bool(true, "実体が前足を完全に包む",     group = grpEntry)
reqOppColor  = input.bool(true, "前足が反対色であることを要求", group = grpEntry)

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ------------------------------------------------------------
//  複数のトリガーを Any/All/MinCount で組み合わせる。
//  各トリガーは ON/OFF 可能。OFF のものは ta 関数を呼ばず軽量。
//  トリガー種類:
//    包み足 / ピンバー / BOS(直近高安更新) / EMAリジェクト / FVG形成 / 強ローソク
//  下位足確認 (useLowerTFTrigger) は OFF の時 request.security を呼ばない。
// ============================================================
grpTrig = "エントリートリガー (追加条件)"
usePinbarTrigger       = input.bool(true, "ピンバー",           group = grpTrig)
useEMARejectTrigger    = input.bool(true,  "EMAリジェクト",      group = grpTrig)

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"], group = grpTrig)
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)", minval = 1, group = grpTrig)

// 下位足トリガー確認 (OFF で request.security を呼ばない)

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)", minval = 1, group = grpTrig)
// EMAリジェクト 傾きフィルター (ロングは上向き・ショートは下向きのみ許可。水平/逆向きは除外)
pinWickBodyMult    = input.float(10.0, "ピンバー ヒゲ/実体倍率", step = 0.1, group = grpTrig)
pinOppWickMaxRatio = input.float(1.0, "ピンバー 反対ヒゲ上限", step = 0.1, group = grpTrig)
// ピンバー品質フィルター : 十字線/極小レンジ/ノイズを除外
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター", group = grpTrig)
pinMaxBodyRatio       = input.float(0.2, "ピンバー 最大実体率", minval = 0.05, maxval = 1.0, step = 0.05, group = grpTrig)
usePinRangeFilter     = input.bool(true, "ピンバー 最低レンジフィルター", group = grpTrig)
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間", minval = 1, group = grpTrig)
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率", step = 0.05, group = grpTrig)
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
// 包み足品質フィルター (弱い包み足を除外。トリガー側のみ適用・FVG吸収用 bullEngulf/bearEngulf は不変)

// トリガー クールダウン / 逆方向同時発生
useTriggerCooldown        = input.bool(false, "トリガークールダウン", group = grpTrig)
triggerCooldownBars       = input.int(3, "クールダウン本数", minval = 1, group = grpTrig)
useOppositeTriggerNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade", group = grpTrig)

// ============================================================
//  1b. 入力 : FVG 場所フィルター
// ------------------------------------------------------------
//  FVG はエントリートリガーではなく「場所条件」として使う。
//  useFVGFilter = false のときは FVG 計算を動かさない (軽量)。
//  (showFVGBoxes だけ ON の場合は表示のため計算する)
// ============================================================
grpFvg = "FVG 場所フィルター"
useFVGFilter           = input.bool(true, "FVG場所フィルターを使う", group = grpFvg)
useFVGReboundFilter    = input.bool(true,  "FVG反発を許可",          group = grpFvg)
useBullishFVG    = input.bool(true,  "Bullish FVG (ロング側)",  group = grpFvg)
useBearishFVG    = input.bool(true,  "Bearish FVG (ショート側)", group = grpFvg)
useFVGConfirmBar = input.bool(true,  "確定足で判定",             group = grpFvg)
useFVGThicknessFilter = input.bool(true,  "厚みフィルター(ATR)",     group = grpFvg)
useFVGAgeFilter       = input.bool(true,  "年齢フィルター",          group = grpFvg)
fvgAtrLen        = input.int(14,  "FVG ATR期間",       minval = 1, group = grpFvg)
fvgMaxAge        = input.int(100, "FVG最大年齢(本)",    minval = 1, group = grpFvg)
maxFVGPerSide    = input.int(20,  "片側 最大FVG保持数", minval = 1, group = grpFvg)
fvgMinThicknessATR = input.float(0.10, "最低厚み (ATR倍率)",       minval = 0.0, step = 0.05, group = grpFvg)
reboundDepthMax    = input.float(0.70, "反発 許容割込み深さ(幅比率)", minval = 0.0, step = 0.05, group = grpFvg)

// 反発の回復位置
reboundRecoverRatio = input.float(0.10, "反発 回復位置(幅比率)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)

// FVG状態管理 (イベント発生後、一定本数だけ「FVG条件OK」を保持する)
useFVGStateWindow       = input.bool(true, "FVG状態管理を使う", group = grpFvg)
fvgStateMaxBars         = input.int(20, "FVG状態 有効本数", minval = 1, group = grpFvg)
resetFVGStateAfterEntry = input.bool(true, "エントリー後FVG状態をリセット", group = grpFvg)


// ============================================================
//  2. 入力 : ボラフィルタ
// ------------------------------------------------------------
//  OFF   … フィルタ無し (ATR 等の関数を呼ばない → 軽い)
//  通常ボラ (volMode) と 高速ボラ (fastVolMode) は独立して ON/OFF 可能。
//  未使用の関数 (ta.atr 等) は呼ばれないため軽量。
// ============================================================
grpVol   = "ボラフィルタ"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)

// --- 固定値モード (通常ボラ) ---
fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", minval = 0.0, step = 0.1, group = grpVol)

// --- ATRモード (通常ボラ) ---
atrLenBase   = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5,  "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen    = input.int(480,    "ATR平均本数", minval = 10, group = grpVol)
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)
// --- 高速ボラ (OFF/ATR/固定値) : 通常ボラとは独立 ---
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数", minval = 1, group = grpVol)
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時", step = 0.1, group = grpVol)
fastFixedMin = input.float(3.0,  "直近値幅 最低($) ※固定値時", minval = 0.0, step = 0.1, group = grpVol)
bodyAvgLen   = input.int(5,      "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin   = input.float(0.5,  "実体平均最低($)", step = 0.1, group = grpVol)
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時", group = grpVol)
rangeLookback       = input.int(20,    "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数", minval = 1, group = grpVol)

// ============================================================
//  3. 入力 : 環境フィルタ (方向 / 環境認識モジュール)
// ------------------------------------------------------------
//  useEnvFilter = false の時は request.security を一切呼ばない。
// ============================================================
grpEnvMaster = "環境フィルタ"
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)", group = grpEnvMaster)

// --- 時間足の 要求状態 (上昇/レンジ/下降/OFF) と参照時間足 ---
grpTF = "環境: 時間足 要求状態 / 参照時間足"
reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf4")
tf4H        = input.timeframe("240", "TF",    group = grpTF, inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1")
tf1H        = input.timeframe("60",  "TF",    group = grpTF, inline = "tf1")
reqTrend15M = input.string("レンジ", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf15")
tf15M       = input.timeframe("15",  "TF",    group = grpTF, inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf5")
tf5M        = input.timeframe("5",   "TF",    group = grpTF, inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1m")
tf1M        = input.timeframe("1",   "TF",    group = grpTF, inline = "tf1m")

// --- 上昇条件 ON/OFF ---
grpBull = "環境: 上昇条件 ON/OFF"
useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50",       group = grpBull)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き",       group = grpBull)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き",       group = grpBull)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50",       group = grpBull)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200",      group = grpBull)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBull)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBull)

// --- 下降条件 ON/OFF ---
grpBear = "環境: 下降条件 ON/OFF"
useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50",       group = grpBear)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き",       group = grpBear)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き",       group = grpBear)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50",       group = grpBear)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200",      group = grpBear)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBear)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBear)

// --- レンジ条件 ON/OFF ---
grpRange = "環境: レンジ条件 ON/OFF"
useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い",       group = grpRange)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い",         group = grpRange)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い",         group = grpRange)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中",          group = grpRange)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ", group = grpRange)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ", group = grpRange)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい",         group = grpRange)

// --- 調整パラメータ ---
grpParam = "環境: 調整パラメータ"
len20        = input.int(20,   "EMA20 length",  minval = 1, group = grpParam)
len50        = input.int(50,   "EMA50 length",  minval = 1, group = grpParam)
len200       = input.int(200,  "EMA200 length", minval = 1, group = grpParam)
envAtrLen    = input.int(14,   "環境ATR length", minval = 1, group = grpParam)
slopeBars    = input.int(3,    "EMA 傾き判定本数", minval = 1, group = grpParam)
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率",       minval = 0, step = 0.01, group = grpParam)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
convDivBars  = input.int(5,    "収束/拡散 判定本数",   minval = 1, group = grpParam)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数", minval = 1, group = grpParam)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数", minval = 1, group = grpParam)
rangeBars    = input.int(20,   "レンジ幅 判定本数",    minval = 1, group = grpParam)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率",    minval = 0, step = 0.1, group = grpParam)

// --- 判定ルール ---
grpJudge = "環境: 判定ルール"
tieAsRange          = input.bool(true, "同点時にレンジ扱いする",     group = grpJudge)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = grpJudge)
minScore4H  = input.int(3, "4H 最低必要スコア",  minval = 1, group = grpJudge)
minScore1H  = input.int(3, "1H 最低必要スコア",  minval = 1, group = grpJudge)
minScore15M = input.int(3, "15M 最低必要スコア", minval = 1, group = grpJudge)
minScore5M  = input.int(3, "5M 最低必要スコア",  minval = 1, group = grpJudge)
minScore1M  = input.int(3, "1M 最低必要スコア",  minval = 1, group = grpJudge)

// --- 環境フィルター接続 ---
grpLink = "環境: 判定"
reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)", minval = 0, group = grpLink)

// --- 環境テーブル表示 ---
grpEnvDisp = "環境: 表示"
showEnvTable = input.bool(true, "環境テーブルを表示", group = grpEnvDisp)
colUp    = input.color(color.new(color.green, 0), "上昇カラー",  group = grpEnvDisp)
colDown  = input.color(color.new(color.red,   0), "下降カラー",  group = grpEnvDisp)
colRange = input.color(color.new(color.gray,  0), "レンジカラー", group = grpEnvDisp)
colOff   = input.color(color.new(color.black, 0), "OFFカラー",   group = grpEnvDisp)

// ============================================================
//  4. 入力 : リスク / 決済
// ============================================================
grpRisk = "リスク / 決済"
riskPct     = input.float(5.0, "1トレード損失率 (%)",  minval = 0.1, step = 0.1, group = grpRisk)
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = grpRisk)
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"], group = grpRisk)
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時", minval = 0.0, step = 0.1, group = grpRisk)
slFixed     = input.float(10, "固定SL幅 (価格) ※固定時",         minval = 0.0, step = 0.1, group = grpRisk)
rrRatio     = input.float(1.0, "リスクリワード比 (TP)", minval = 0.1, step = 0.1, group = grpRisk)

// ============================================================
//  4b. 入力 : 時間帯フィルタ (東京時間 JST 基準)
// ------------------------------------------------------------
//  アジア 09:00-16:00 / EU 16:00-21:00 / NY 21:00-翌03:00
// ============================================================
grpSession = "時間帯フィルタ (東京時間)"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = grpSession)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = grpSession)
useEUSession     = input.bool(true, "EU 16:00-21:00",   group = grpSession)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = grpSession)

// ============================================================
//  4c. 入力 : WinZone モジュール (FVG / EMA を場所条件として並列化)
// ------------------------------------------------------------
//  方向(環境認識) → WinZone(├FVG └EMA) → Trigger → Entry
//    FVG_ONLY … FVGのみ / EMA_ONLY … EMAのみ / OR … どちらか / AND … 両方
//  ※ 軽量化 : winZoneMode が対象を含まない側は計算を一切走らせない。
// ============================================================
grpWinZone = "WinZone: FVG / EMA / BB / 水平線 / フィボ / トレンド"
useWinZoneModule = input.bool(true, "WinZoneモジュールを使う", group = grpWinZone)
useFVGWinZone    = input.bool(false, "FVGをWinZoneに使う", group = grpWinZone)
useEMAWinZone    = input.bool(false, "EMAをWinZoneに使う", group = grpWinZone)
useBBWinZone     = input.bool(false, "BBをWinZoneに使う", group = grpWinZone)
useLineWinZone   = input.bool(false, "水平線をWinZoneに使う", group = grpWinZone)
useFibWinZone    = input.bool(false, "フィボをWinZoneに使う", group = grpWinZone)
useTrendWinZone  = input.bool(false, "トレンド/チャネルをWinZoneに使う", group = grpWinZone)
useAccumWinZone  = input.bool(true, "アキュムレンジ(MTF)をWinZoneに使う", group = grpWinZone)
useHSWinZone     = input.bool(false, "三尊/逆三尊(H&S)をWinZoneに使う", group = grpWinZone)
usePivotWinZone  = input.bool(false, "ピボット(PP/R/S)をWinZoneに使う", group = grpWinZone)
useWedgeWinZone  = input.bool(false, "ウェッジ(Bear/Bull)をWinZoneに使う", group = grpWinZone)
winZoneMode      = input.string("AND", "WinZone結合", options = ["FVG_ONLY", "EMA_ONLY", "BB_ONLY", "LINE_ONLY", "FIB_ONLY", "TREND_ONLY", "ACCUM_ONLY", "HS_ONLY", "PIVOT_ONLY", "WEDGE_ONLY", "OR", "AND"], group = grpWinZone)

// ============================================================
//  4g. 入力 : EMA WinZone (200/600/1000/2000/3000 を反応価格帯として)
// ------------------------------------------------------------
//  EMA は Bias(方向) ではなく Zone(反応する価格帯)。各EMAごとに ON/OFF でき、
//  ON のEMAだけ計算・判定する。出力 emaLongWinZone / emaShortWinZone。
//  ・useEMAWZ=false の時は EMA計算・ATR・cross・状態管理・描画 を一切走らせない。
// ============================================================
grpEMAWZ = "EMA WinZone"
useEMAModule = input.bool(true, "EMAモジュールを使う (WinZone ON時のみ有効)", group = grpEMAWZ)
emaLen1 = input.int(200,  "EMA200 Length",  minval = 1, group = grpEMAWZ)
emaLen2 = input.int(600,  "EMA600 Length",  minval = 1, group = grpEMAWZ)
emaLen3 = input.int(1000, "EMA1000 Length", minval = 1, group = grpEMAWZ)
emaLen4 = input.int(2000, "EMA2000 Length", minval = 1, group = grpEMAWZ)
emaLen5 = input.int(3000, "EMA3000 Length", minval = 1, group = grpEMAWZ)
emaSource = input.source(close, "EMA Source", group = grpEMAWZ)
// 各EMAを反発Zoneに使うか
useEMA1Zone = input.bool(true, "EMA200をZoneに使う",  group = grpEMAWZ)
useEMA2Zone = input.bool(true, "EMA600をZoneに使う",  group = grpEMAWZ)
useEMA3Zone = input.bool(true, "EMA1000をZoneに使う", group = grpEMAWZ)
useEMA4Zone = input.bool(true, "EMA2000をZoneに使う", group = grpEMAWZ)
useEMA5Zone = input.bool(true, "EMA3000をZoneに使う", group = grpEMAWZ)
// シグナル種別 ON/OFF
useEMABounce     = input.bool(true, "反発シグナルを使う",       group = grpEMAWZ)
useEMABandRetest = input.bool(false, "帯抜けリテストを使う",     group = grpEMAWZ)
useEMAInsideNoTrade = input.bool(false, "ON EMA帯の中はNoTrade", group = grpEMAWZ)
// 接近幅
emaTouchMode   = input.string("ATR", "EMA接近判定", options = ["Dollar", "ATR"], group = grpEMAWZ)
emaTouchDollar = input.float(3.0,  "EMA接近幅($)",      step = 0.1,  group = grpEMAWZ)
emaTouchATRMult= input.float(0.30, "EMA接近幅 ATR倍率", step = 0.05, group = grpEMAWZ)
emaAtrLen      = input.int(14, "EMA ATR期間", minval = 1, group = grpEMAWZ)
emaBandRetestBars = input.int(10, "帯リテスト 有効本数", minval = 1, group = grpEMAWZ)

// --- EMA WinZone: MTF (どの時間足のEMAを反応帯として見るか) ---
//   OFF の時間足は request.security を呼ばない。各TFで ON のEMA種類だけ判定に使う。
grpEMATF = "EMA WinZone: MTF"
useEMA1M  = input.bool(false,  "1分EMAを使う",   group = grpEMATF)
useEMA5M  = input.bool(true,  "5分EMAを使う",   group = grpEMATF)
useEMA15M = input.bool(false,  "15分EMAを使う",  group = grpEMATF)
useEMA1H  = input.bool(false,  "1時間EMAを使う", group = grpEMATF)
useEMA4H  = input.bool(false,  "4時間EMAを使う", group = grpEMATF)
tfEMA1M  = input.timeframe("1",   "1分TF",   group = grpEMATF)
tfEMA5M  = input.timeframe("5",   "5分TF",   group = grpEMATF)
tfEMA15M = input.timeframe("15",  "15分TF",  group = grpEMATF)
tfEMA1H  = input.timeframe("60",  "1時間TF", group = grpEMATF)
tfEMA4H  = input.timeframe("240", "4時間TF", group = grpEMATF)

// --- EMA: 状態管理 ---
grpEMAState = "EMA: 状態管理"
useEMAStateWindow       = input.bool(true, "EMA状態管理を使う", group = grpEMAState)
emaStateMaxBars         = input.int(10, "EMA状態 有効本数", minval = 1, group = grpEMAState)
resetEMAStateAfterEntry = input.bool(true, "エントリー後EMA状態をリセット", group = grpEMAState)

// ============================================================
//  4h. 入力 : WinZone Bollinger Bands モジュール
// ------------------------------------------------------------
//  BB は Bias(方向) ではなく「エントリーしてよい場所・状態か」を判定する
//  WinZone 条件 (FVG / EMA と並列)。エントリートリガーではない。
//  useBBModule = false / useBBWZ = false のとき完全素通し :
//    allowLongByBB = allowShortByBB = true / bbNoTrade = false
//  OFF の時は ta.sma/ta.stdev/ta.atr/ta.lowest/ta.highest / BB計算 /
//    シグナル判定 / Rank / 状態管理更新 / label / table を実行しない。
//  ※ プロット上限のため BB帯のチャート描画は行わない (状態はDebug Table)。
// ============================================================
grpWinBB = "WinZone: BB"
useBBModule      = input.bool(true, "BBモジュールを使う (WinZone ON時のみ有効)", group = grpWinBB)

bbLen    = input.int(20, "BB Length", minval = 1, group = grpWinBB)
bbMult2  = input.float(2.0, "BB 2σ", step = 0.1, group = grpWinBB)
bbMult3  = input.float(3.0, "BB 3σ", step = 0.1, group = grpWinBB)
bbSource = input.source(close, "BB Source", group = grpWinBB)

useBBOutsideNoTrade  = input.bool(true, "B: 極端な外側NoTrade",  group = grpWinBB)
useBBReversal2       = input.bool(true,  "C: ±2σ反発",           group = grpWinBB)
useBBReversal3       = input.bool(true,  "D: ±3σ反発",           group = grpWinBB)

bbEntryMode = input.string("Any", "エントリー結合", options = ["Any", "All"], group = grpWinBB)





bbExtremeZ  = input.float(3.0, "極端判定 ZScore", step = 0.1, group = grpWinBB)

// BB 状態管理
useBBStateWindow       = input.bool(true, "BB状態管理を使う", group = grpWinBB)
bbStateMaxBars         = input.int(10, "BB状態 有効本数", minval = 1, group = grpWinBB)
resetBBStateAfterEntry = input.bool(true, "エントリー後BB状態をリセット", group = grpWinBB)

// ============================================================
//  4i. 入力 : 水平線 WinZone (レジサポを反応する場所として)
// ------------------------------------------------------------
//  水平線は Bias ではなく Zone。上だからショート等の方向制限はしない。
//  Pivot(MTF) / 複数回反応 / 前日H・L / セッションH・L を統合ゾーン化し、
//  反発 / レジサポ転換 / ブレイク / スイープ反転 を場所条件として使う。
//  ・useLineWZ=false の時は ta.atr/pivot・配列・前日/セッション更新・
//    ゾーン統合・各判定・状態管理・描画 を一切走らせない。
// ============================================================
grpLineSrc = "水平線: 検出ソース"
useLineModule    = input.bool(true, "水平線モジュールを使う (WinZone ON時のみ有効)", group = grpLineSrc)
usePreviousDayHL = input.bool(true, "前日 高値/安値", group = grpLineSrc)

// --- 水平線 MTF (1M/5M/15M/1H/4H の Pivot水平線を反応帯として) ---
//   OFFの時間足は request.security を呼ばない。前日/セッションH・Lはチャート基準。
grpLineTF = "水平線: MTF"

grpLinePat = "水平線: パターン"
useLineBounce = input.bool(true, "反発", group = grpLinePat)

grpLineParam = "水平線: パラメータ"
lineAtrLen   = input.int(14, "ATR期間", minval = 1, group = grpLineParam)
lineMaxZones = input.int(20, "水平線 最大保持数", minval = 1, group = grpLineParam)
reactionToleranceATR = input.float(0.3, "反応 許容幅 ATR倍率", step = 0.05, group = grpLineParam)

grpLineFilt = "水平線: 共通フィルター"
useLineDirCandleFilter = input.bool(true,  "方向ローソク", group = grpLineFilt)

grpLineZone = "水平線: ゾーン"
useLineATRZone     = input.bool(true, "ゾーン幅をATR連動にする", group = grpLineZone)
lineZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率", step = 0.05, group = grpLineZone)
lineZoneFixedWidth = input.float(0.0, "ゾーン幅 固定", step = 0.1, group = grpLineZone)
useLineMergeZone   = input.bool(true, "近い水平線をゾーン統合する", group = grpLineZone)
lineMergeToleranceATR = input.float(0.5, "統合許容幅 ATR倍率", step = 0.05, group = grpLineZone)

grpLineSess = "水平線: セッション"

grpLineObs = "水平線: 障害物"

grpLineState = "水平線: 状態管理"
useLineStateWindow       = input.bool(true, "水平線状態管理を使う", group = grpLineState)
lineStateMaxBars         = input.int(10, "水平線状態 有効本数", minval = 1, group = grpLineState)
resetLineStateAfterEntry = input.bool(true, "エントリー後水平線状態をリセット", group = grpLineState)

grpLineDisp = "水平線: 表示"

// ============================================================
//  4j. 入力 : フィボ WinZone (戻り売り/押し目買い・場所条件)
// ------------------------------------------------------------
//  トレンド波の戻り/押しを A/B/C ランクのフィボ帯で捉える場所条件。
//  ※ useFibWZ=false の時は ta.pivot/atr/ema・波計算等を一切走らせない。
// ============================================================
grpFib = "フィボ: 波検出 / 設定"
useFibSell = input.bool(true, "SELL(戻り売り)検出", group = grpFib)
useFibBuy  = input.bool(true, "BUY(押し目買い)検出", group = grpFib)
fibAtrLen        = input.int(14,  "Fib ATR期間", minval = 1, group = grpFib)
swingLookback    = input.int(3,   "スイング検出 左右本数", minval = 1, group = grpFib)
waveLookback     = input.int(100, "波の有効本数 (古い波は無視)", minval = 10, group = grpFib)
minWaveATR       = input.float(3.0, "最低波幅 (ATR倍)", minval = 0.0, step = 0.1, group = grpFib)
fibZoneBufferATR = input.float(0.3, "フィボゾーン許容 (ATR倍)", step = 0.05, group = grpFib)
requireConfirmedBar = input.bool(true, "確定足でのみシグナル (リペイント回避)", group = grpFib)

grpFibRank = "フィボ: ランク / レベル"
useRankA = input.bool(true, "A ランク (深い)", group = grpFibRank)
useRankB = input.bool(true, "B ランク (王道)", group = grpFibRank)
useRankC = input.bool(true, "C ランク (浅い)", group = grpFibRank)
fibAStart = input.float(0.618, "A 開始", step = 0.001, group = grpFibRank)
fibAEnd   = input.float(0.786, "A 終了", step = 0.001, group = grpFibRank)
fibBStart = input.float(0.500, "B 開始", step = 0.001, group = grpFibRank)
fibBEnd   = input.float(0.618, "B 終了", step = 0.001, group = grpFibRank)
fibCStart = input.float(0.382, "C 開始", step = 0.001, group = grpFibRank)
fibCEnd   = input.float(0.500, "C 終了", step = 0.001, group = grpFibRank)

grpFibConf = "フィボ: 反転確認"

grpFibInv = "フィボ: 無効条件"
useDeepLimitInvalid = input.bool(true, "深限界 (A終了%) 突破で無効", group = grpFibInv)
useOriginInvalid    = input.bool(true, "波の起点突破で無効",         group = grpFibInv)

// --- フィボ: 状態管理 (FVG/EMA/BB/水平線 と同思想) ---
grpFibState = "フィボ: 状態管理"
useFibStateWindow       = input.bool(true, "フィボ状態管理を使う", group = grpFibState)
fibStateMaxBars         = input.int(10, "フィボ状態 有効本数", minval = 1, group = grpFibState)
resetFibStateAfterEntry = input.bool(true, "エントリー後フィボ状態をリセット", group = grpFibState)

// ============================================================
//  4k. 入力 : Trendline / Channel WinZone (トレンドライン・チャネルを場所として)
// ------------------------------------------------------------
//  トレンドライン/チャネルは Bias ではなく Zone (どこで反応するか)。
//  反発 / ブレイク / リテスト / フェイクブレイク / チャネル各種を場所条件化。
//  ※ useTrendWZ=false の時は ta.atr/pivot・ライン計算・Quality・状態管理・
//    line/label/table を一切走らせない (これが軽量化の要)。
// ============================================================
grpWinTL = "WinZone: Trendline / Channel"
useTrendlineModule  = input.bool(true, "Trendline/Channelモジュールを使う (WinZone ON時のみ有効)", group = grpWinTL)

pivotLen          = input.int(5, "Pivot Length", minval = 1, group = grpWinTL)
useATRSwingFilter = input.bool(true, "ATR Swing Filterを使う", group = grpWinTL)
minSwingATR       = input.float(0.5, "最低Swing幅 ATR倍率", step = 0.1, group = grpWinTL)

trendTouchMode   = input.string("ATR", "接近判定", options = ["Dollar", "ATR"], group = grpWinTL)
trendTouchDollar = input.float(3.0,  "接近幅($)",      step = 0.1,  group = grpWinTL)
trendTouchATR    = input.float(0.3, "接近幅 ATR倍率", step = 0.05, group = grpWinTL)

useTrendBounce    = input.bool(true, "A: Trendline反発",   group = grpWinTL)
useTrendFakeBreak = input.bool(true, "D: Fake Break",       group = grpWinTL)

useChannel             = input.bool(true, "E: Channelを使う",     group = grpWinTL)
useChannelBounce       = input.bool(true, "F: Channel反発",       group = grpWinTL)

useTrendQualityFilter   = input.bool(true, "J: Line Quality Filter", group = grpWinTL)
minTrendlineQuality     = input.int(70, "最低Line Quality", minval = 0, maxval = 100, group = grpWinTL)

maxLineAgeBars   = input.int(300, "ライン有効期限 Bars", minval = 20, group = grpWinTL)
minLineTouches   = input.int(2, "最低Touch数", minval = 2, group = grpWinTL)
breakConfirmBars = input.int(2, "Break Confirm Bars", minval = 1, group = grpWinTL)
minSlopeATR      = input.float(0.03, "最低Slope ATR倍率", step = 0.01, group = grpWinTL)
maxSlopeATR      = input.float(1.5,  "最大Slope ATR倍率", step = 0.1,  group = grpWinTL)

showOnlyBestLines = input.bool(true, "最良ラインのみ表示", group = grpWinTL)
trendEntryMode    = input.string("Any", "エントリー結合", options = ["Any", "All"], group = grpWinTL)

// トレンド 状態管理 (イベント発生後、一定本数だけ WinZone-Trendline OK を保持)
useTrendStateWindow       = input.bool(true, "Trendline状態管理を使う", group = grpWinTL)
trendStateMaxBars         = input.int(10, "Trendline状態 有効本数", minval = 1, group = grpWinTL)
resetTrendStateAfterEntry = input.bool(true, "エントリー後Trendline状態をリセット", group = grpWinTL)

// ============================================================
//  4l. 入力 : Accumulation MTF WinZone (上位足の確定レンジ・場所条件)
// ------------------------------------------------------------
//  Accum は 5分足のノイズではなく D/4H/1H/15M の「確定レンジ」として使う。
//    ① 箱上限/下限での反発エントリー (Range) ② 箱ブレイク方向エントリー (Break)
//  ・箱は形成中ではなく「確定後」だけ使う。形成中は原則NoTrade。
//  ・対象TFはON/OFF可能。useAccumWZ=false の時は 関数・ta.*・request.security・
//    描画を一切走らせない (これが軽量化の要)。
// ============================================================
grpAccumDet = "Accum: 検知パラメータ"
accumRangeLen        = input.int(10,  "Accum判定レンジ本数", minval = 6, group = grpAccumDet)
accumBaseLen         = input.int(20,  "基準平均本数",        minval = 10, group = grpAccumDet)
accumATRLen          = input.int(14,  "ATR本数",             minval = 1, group = grpAccumDet)
accumATRMult         = input.float(2.5,  "レンジ幅 / ATR 上限",      minval = 0.5, step = 0.1,  group = grpAccumDet)
accumBarRatioMax     = input.float(0.70, "平均値幅/基準平均 上限",   minval = 0.1, step = 0.01, group = grpAccumDet)
accumDriftMax        = input.float(0.30, "ドリフト上限",            minval = 0.05, maxval = 1.0, step = 0.05, group = grpAccumDet)
accumMinUpperCloses  = input.int(4,   "上半分の最低終値本数", minval = 1, group = grpAccumDet)
accumMinLowerCloses  = input.int(4,   "下半分の最低終値本数", minval = 1, group = grpAccumDet)
accumMaxSameColorRun = input.int(4,   "同色連続の上限",       minval = 1, group = grpAccumDet)

grpAccumFil = "Accum: フィルター ON/OFF"
useAccumATRFilter      = input.bool(true, "ATR条件",        group = grpAccumFil)
useAccumRangeFilter    = input.bool(true, "レンジ幅条件",   group = grpAccumFil)
useAccumBalanceFilter  = input.bool(true, "上下バランス",   group = grpAccumFil)
useAccumDriftFilter    = input.bool(true, "ドリフト",       group = grpAccumFil)
useAccumColorRunFilter = input.bool(true, "連続陽線/陰線",  group = grpAccumFil)

// --- Accum MTF: 対象時間足 (D / 4H / 1H / 15M を上位足の確定レンジとして使う) ---
grpAccumMTF = "Accum MTF: 時間足"
useAccumD   = input.bool(false, "日足Accumを使う", group = grpAccumMTF)
useAccum4H  = input.bool(false,  "4H Accumを使う", group = grpAccumMTF)
useAccum1H  = input.bool(false,  "1H Accumを使う", group = grpAccumMTF)
useAccum15M = input.bool(true,  "15M Accumを使う", group = grpAccumMTF)
tfAccumD   = input.timeframe("D",   "日足TF", group = grpAccumMTF)
tfAccum4H  = input.timeframe("240", "4H TF",  group = grpAccumMTF)
tfAccum1H  = input.timeframe("60",  "1H TF",  group = grpAccumMTF)
tfAccum15M = input.timeframe("15",  "15M TF", group = grpAccumMTF)

// --- Accum MTF: 利用モード (箱上限/下限反発 or 箱ブレイク) ---
grpAccumMode = "Accum MTF: モード"
accumTradeMode = input.string("RangeOnly", "Accum利用モード", options = ["RangeOnly", "BreakOnly", "RangeOrBreak"], group = grpAccumMode)
useAccumRangeEntry = input.bool(true, "箱上限/下限の反発を使う", group = grpAccumMode)
useAccumBreakEntry = input.bool(true, "箱ブレイクを使う", group = grpAccumMode)

// --- Accum MTF: 箱選択 (複数TFで箱がある時の優先順位) ---
grpAccumSelect = "Accum MTF: 箱選択"
accumBoxSelectMode = input.string("All_OR", "使用するAccum箱", options = ["HigherTF", "Nearest", "All_OR", "All_AND"], group = grpAccumSelect)

// --- Accum MTF: Range Entry (箱上限/下限での反発) ---
grpAccumRange = "Accum MTF: Range Entry"
accumRangeTouchATR      = input.float(0.1, "上限/下限タッチ許容 ATR倍率", minval = 0.05, step = 0.05, group = grpAccumRange)
useRangeRejectCandle    = input.bool(true, "反発ローソクを要求", group = grpAccumRange)
useRangeCloseBackInside = input.bool(true, "箱内へ終値回帰を要求", group = grpAccumRange)

// --- Accum MTF: Break Entry (箱を終値で抜けたブレイク方向) ---
grpAccumBreak = "Accum MTF: Break Entry"
accumBreakCloseBufferATR = input.float(0.2, "ブレイク終値バッファ ATR倍率", minval = 0.0, step = 0.05, group = grpAccumBreak)
accumBreakConfirmBars    = input.int(2, "ブレイク連続終値本数", minval = 1, group = grpAccumBreak)
useAccumBreakBodyFilter  = input.bool(true, "ブレイク実体フィルター", group = grpAccumBreak)
accumBreakBodyRatio      = input.float(0.5, "ブレイク実体割合", minval = 0.0, maxval = 1.0, step = 0.05, group = grpAccumBreak)

// --- Accum MTF: NoTrade (上位足Accum形成中は原則ノートレード) ---
grpAccumNoTrade = "Accum MTF: NoTrade"
useMTFAccumNoTrade = input.bool(false, "上位足Accum形成中はNoTrade", group = grpAccumNoTrade)

// --- Accum MTF: 状態管理 (Range/Breakのシグナルを一定本数保持) ---
grpAccumMTFState = "Accum MTF: 状態管理"
useAccumMTFStateWindow  = input.bool(true, "MTF Accum状態管理を使う", group = grpAccumMTFState)
accumMTFStateMaxBars    = input.int(10, "MTF Accum状態 有効本数", minval = 1, group = grpAccumMTFState)
resetAccumMTFAfterEntry = input.bool(true, "エントリー後MTF Accum状態をリセット", group = grpAccumMTFState)

// --- Accum MTF: 表示 ---
grpAccumDisplay = "Accum MTF: 表示"

// ============================================================
//  4m. 入力 : Head & Shoulders WinZone (三尊 / 逆三尊 場所条件)
// ------------------------------------------------------------
//  H&S は Bias ではなく WinZone (場所条件)。FVG/EMA/BB/水平線/フィボ/
//  トレンド/Accum と同じ階層。出力 hsLongWinZone / hsShortWinZone。
//  ・useHSWZ=false の時は request.security・Pivot・Queue・配列操作・
//    Quality・Retest・Break・Invalidation・描画 を一切走らせない (軽量)。
// ============================================================
grpHS = "H&S: 検出 / 設定"
useHSModule = input.bool(true, "H&Sモジュールを使う (WinZone ON時のみ有効)", group = grpHS)
patternTf   = input.timeframe("5", "Pattern TF", group = grpHS)
hsPivotLen  = input.int(5, "Pivot Length", minval = 1, group = grpHS)
hsMode      = input.string("NecklineRetest", "H&S Mode", options = ["Legacy", "NecklineBreak", "NecklineRetest"], group = grpHS)
shoulderTolerancePct = input.float(0.004, "肩の対称性 許容率", step = 0.001, group = grpHS)
useHeadProm  = input.bool(true, "頭と肩の高低差を要求", group = grpHS)
headPromMult = input.float(1.0, "頭-肩 > ATR ×", step = 0.1, group = grpHS)
setupValidBars = input.int(24, "セットアップ有効本数", minval = 1, group = grpHS)
retestAtrLen  = input.int(14, "Retest ATR Length", minval = 1, group = grpHS)
retestAtrMult = input.float(0.8, "Retest ATR Mult", step = 0.1, group = grpHS)
useHSInvalidation   = input.bool(true, "H&S否定を使う", group = grpHS)
invalidationAtrMult = input.float(0.2, "否定判定 ATR余白", step = 0.1, group = grpHS)

// --- H&S: WinZone モード (どのイベントを場所条件にするか) ---
grpHSMode = "H&S: WinZone"
hsWinZoneMode = input.string("Any", "H&S WinZone", options = ["Pattern", "Break", "Retest", "Invalidation", "Any"], group = grpHSMode)

// --- H&S: 状態管理 (FVG/EMA/BB/水平線/フィボ/Accum と同思想) ---
grpHSState = "H&S: 状態管理"
useHSStateWindow       = input.bool(true, "H&S状態管理を使う", group = grpHSState)
hsStateMaxBars         = input.int(15, "H&S状態 有効本数", minval = 1, group = grpHSState)
resetHSStateAfterEntry = input.bool(true, "エントリー後H&S状態をリセット", group = grpHSState)

// --- H&S: 表示 ---
grpHSDisp = "H&S: 表示"

// ============================================================
//  4n. 入力 : Pivot (クラシックピボット) WinZone 場所条件
// ------------------------------------------------------------
//  PP/R1-3/S1-3 を「価格が反応しやすい場所か」で判定する WinZone 条件。
//  FVG/EMA/BB/水平線/フィボ/トレンド/Accum/H&S と並列。反発/スイープ/
//  ブレイク転換リテストを検出する。
//  ・usePivotWZ=false の時は request.security・ta.atr・Pivot計算・探索・
//    判定・状態管理 を一切走らせない (軽量)。表示は持たない。
// ============================================================
grpPivot = "Pivot: 検出 / 設定"
usePivotModule = input.bool(true, "Pivotモジュールを使う (WinZone ON時のみ有効)", group = grpPivot)
pivotTf        = input.timeframe("60", "Pivot TF", group = grpPivot)
pivotTouchMode   = input.string("ATR", "接近判定", options = ["Dollar", "ATR"], group = grpPivot)
pivotTouchDollar = input.float(3.0, "接近幅($)",      step = 0.1,  group = grpPivot)
pivotTouchATR    = input.float(0.2, "接近幅 ATR倍率", step = 0.05, group = grpPivot)
useBounceEntry      = input.bool(true, "反発エントリー", group = grpPivot)
useSweepEntry       = input.bool(true, "スイープエントリー", group = grpPivot)
useBreakRetestEntry = input.bool(true, "ブレイク→レジサポ転換リテスト", group = grpPivot)
pivotEntryMode      = input.string("Any", "エントリー結合", options = ["Any", "All"], group = grpPivot)
pivotRetestBars     = input.int(10, "リテスト有効本数", minval = 1, group = grpPivot)

// --- Pivot: 状態管理 (他モジュールと同思想) ---
grpPivotState = "Pivot: 状態管理"
usePivotStateWindow       = input.bool(true, "Pivot状態管理を使う", group = grpPivotState)
pivotStateMaxBars         = input.int(10, "Pivot状態 有効本数", minval = 1, group = grpPivotState)
resetPivotStateAfterEntry = input.bool(true, "エントリー後Pivot状態をリセット", group = grpPivotState)

// ============================================================
//  4o. 入力 : Wedge (ウェッジ) WinZone 場所条件
// ------------------------------------------------------------
//  Bear Wedge(Rising)=下限割れSELL / Bull Wedge(Falling)=上限抜けBUY。
//  Pattern/Break/Retest/Invalidation/Building を場所条件として判定。
//  FVG/EMA/BB/水平線/フィボ/トレンド/Accum/H&S/Pivot と並列。
//  ・useWedgeWZ=false の時は request.security・ta.atr/sma・Pivot・配列・
//    判定・状態管理 を一切走らせない (軽量)。表示は持たない。
// ============================================================
grpWedge = "Wedge: 検出 / 設定"
useWedgeModule = input.bool(true, "Wedgeモジュールを使う (WinZone ON時のみ有効)", group = grpWedge)
wedgePatternTf = input.timeframe("5", "Pattern TF", group = grpWedge)
wedgePivotLen  = input.int(3, "Pivot Length", minval = 1, group = grpWedge)
wedgeMinTouches  = input.int(2, "最低Pivotタッチ数", minval = 2, maxval = 4, group = grpWedge)
wedgeMaxLookback = input.int(10, "Pivot最大保持数", minval = 4, maxval = 20, group = grpWedge)
wedgeContractionRatio = input.float(0.7, "収束率 WidthNow <= WidthStart ×", minval = 0.1, maxval = 1.0, step = 0.05, group = grpWedge)
minWedgeBars = input.int(8, "Wedge最小形成本数", minval = 1, group = grpWedge)
maxWedgeBars = input.int(80, "Wedge最大形成本数", minval = 5, group = grpWedge)
wedgeMinSlopeAtrMult  = input.float(0.05, "最低傾き ATR倍率", step = 0.01, group = grpWedge)
wedgeLineBreakAtrMult = input.float(0.1, "ラインブレイク ATR余白", step = 0.05, group = grpWedge)
wedgeRetestAtrLen  = input.int(14, "Retest ATR Length", minval = 1, group = grpWedge)
wedgeRetestAtrMult = input.float(0.5, "Retest ATR Mult", step = 0.1, group = grpWedge)
wedgeSetupValidBars = input.int(24, "セットアップ有効本数", minval = 1, group = grpWedge)
useWedgeInvalidation     = input.bool(true, "Wedge否定を使う", group = grpWedge)
wedgeInvalidationAtrMult = input.float(0.2, "否定判定 ATR余白", step = 0.1, group = grpWedge)
wedgeEntryMode = input.string("Any", "Entry Mode", options = ["Any", "BreakOnly", "RetestOnly", "InvalidationOnly"], group = grpWedge)

// --- Wedge: 状態管理 (他モジュールと同思想) ---
grpWedgeState = "Wedge: 状態管理"
useWedgeStateWindow       = input.bool(true, "Wedge状態管理を使う", group = grpWedgeState)
wedgeStateMaxBars         = input.int(10, "Wedge状態 有効本数", minval = 1, group = grpWedgeState)
resetWedgeStateAfterEntry = input.bool(true, "エントリー後Wedge状態をリセット", group = grpWedgeState)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5b. FVG 場所検知 (フィルター用)
// ============================================================
// WinZone 階層で FVG/EMA を使うかどうか (対象外の側は計算を走らせない = 軽量)
bool useFVGWZ = useWinZoneModule and useFVGWinZone and (winZoneMode == "FVG_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useEMAWZ = useWinZoneModule and useEMAWinZone and useEMAModule and (winZoneMode == "EMA_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// BB WinZone : OFFなら BB計算・ta.*・シグナル判定・状態管理・描画 を一切走らせない。
bool useBBWZ = useWinZoneModule and useBBWinZone and useBBModule and (winZoneMode == "BB_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// 水平線 WinZone : OFFなら pivot/atr・配列・前日/セッション更新・各判定・描画 を一切走らせない。
bool useLineWZ = useWinZoneModule and useLineWinZone and useLineModule and (winZoneMode == "LINE_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// フィボ WinZone : OFFなら ta.pivot/atr/ema・波計算・ランク・ゾーン・反転確認・状態管理 を一切走らせない。
bool useFibWZ = useWinZoneModule and useFibWinZone and (winZoneMode == "FIB_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// トレンド WinZone : OFFなら ta.atr/pivot・ライン計算・Quality・状態管理・line/label/table を一切走らせない。
bool useTrendWZ = useWinZoneModule and useTrendWinZone and useTrendlineModule and (winZoneMode == "TREND_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// Accum WinZone : OFFなら f_accum_*・ta.*・request.security(MTF)・箱判定・状態管理・描画を一切走らせない。
bool useAccumWZ = useWinZoneModule and useAccumWinZone and (winZoneMode == "ACCUM_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// H&S WinZone : OFFなら request.security・Pivot・Queue・配列操作・Quality・Retest・Break・否定・描画を一切走らせない。
bool useHSWZ = useWinZoneModule and useHSWinZone and useHSModule and (winZoneMode == "HS_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// Pivot WinZone : OFFなら request.security・ta.atr・Pivot計算・探索・判定・状態管理を一切走らせない。
bool usePivotWZ = useWinZoneModule and usePivotWinZone and usePivotModule and (winZoneMode == "PIVOT_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// Wedge WinZone : OFFなら request.security・ta.atr/sma・Pivot・配列・判定・状態管理を一切走らせない。
bool useWedgeWZ = useWinZoneModule and useWedgeWinZone and useWedgeModule and (winZoneMode == "WEDGE_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// FVG 計算は WinZoneでFVGを使う時、または box 表示時のみ動かす
bool useFVG = useFVGWZ

// --- FVGヘルパー ---
f_fvgThick(float width, float atrVal) =>
    not useFVGThicknessFilter or width >= atrVal * fvgMinThicknessATR

f_fvgTrim(array<float> topA, array<float> botA, array<int> barA, array<bool> rebA, array<bool> deadA) =>
    while array.size(topA) > maxFVGPerSide
        array.shift(topA)
        array.shift(botA)
        array.shift(barA)
        array.shift(rebA)
        array.shift(deadA)

// --- FVG 保存配列 ---
var array<float> bullTopArr = array.new_float()
var array<float> bullBotArr = array.new_float()
var array<int>   bullBarArr = array.new_int()
var array<bool>  bullRebUsed = array.new_bool()
var array<bool>  bullDeadArr = array.new_bool()

var array<float> bearTopArr = array.new_float()
var array<float> bearBotArr = array.new_float()
var array<int>   bearBarArr = array.new_int()
var array<bool>  bearRebUsed = array.new_bool()
var array<bool>  bearDeadArr = array.new_bool()

// FVG シグナル (反発のみ)
bool fvgReboundBuy  = false
bool fvgReboundSell = false

if useFVG
    float fvgAtr = ta.atr(fvgAtrLen)
    bool confBar = not useFVGConfirmBar or barstate.isconfirmed

    // ---- Bullish FVG 処理 (反発BUY) ----
    if useBullishFVG and array.size(bullTopArr) > 0
        for i = 0 to array.size(bullTopArr) - 1
            float top = array.get(bullTopArr, i)
            float bot = array.get(bullBotArr, i)
            int  bbar = array.get(bullBarArr, i)
            bool rUsed = array.get(bullRebUsed, i)
            bool dead  = array.get(bullDeadArr, i)
            float width = top - bot
            int age = bar_index - bbar
            if useFVGAgeFilter and not dead and age > fvgMaxAge
                dead := true
                array.set(bullDeadArr, i, true)
            if not dead and confBar
                // 反発 BUY (サポート)
                if useFVGReboundFilter and not rUsed
                    float depth = (low < bot and width > 0) ? (bot - low) / width : 0.0
                    if low <= top and depth <= reboundDepthMax and close >= bot + width * reboundRecoverRatio and close > open
                        fvgReboundBuy := true
                        array.set(bullRebUsed, i, true)
            // 完全埋め (終値基準) なら dead 化
            if not array.get(bullDeadArr, i) and close <= bot
                array.set(bullDeadArr, i, true)

    // ---- Bearish FVG 処理 (反発SELL) ----
    if useBearishFVG and array.size(bearTopArr) > 0
        for i = 0 to array.size(bearTopArr) - 1
            float top = array.get(bearTopArr, i)
            float bot = array.get(bearBotArr, i)
            int  bbar = array.get(bearBarArr, i)
            bool rUsed = array.get(bearRebUsed, i)
            bool dead  = array.get(bearDeadArr, i)
            float width = top - bot
            int age = bar_index - bbar
            if useFVGAgeFilter and not dead and age > fvgMaxAge
                dead := true
                array.set(bearDeadArr, i, true)
            if not dead and confBar
                // 反発 SELL (レジスタンス)
                if useFVGReboundFilter and not rUsed
                    float depth = (high > top and width > 0) ? (high - top) / width : 0.0
                    if high >= bot and depth <= reboundDepthMax and close <= top - width * reboundRecoverRatio and close < open
                        fvgReboundSell := true
                        array.set(bearRebUsed, i, true)
            // 完全埋め (終値基準) なら dead 化
            if not array.get(bearDeadArr, i) and close >= top
                array.set(bearDeadArr, i, true)

    // ---- 新規 FVG 検出・保存 ----
    if useBullishFVG and low > high[2]
        float bTop = low
        float bBot = high[2]
        float w = bTop - bBot
        if w > 0 and f_fvgThick(w, fvgAtr)
            array.push(bullTopArr, bTop)
            array.push(bullBotArr, bBot)
            array.push(bullBarArr, bar_index)
            array.push(bullRebUsed, false)
            array.push(bullDeadArr, false)
            f_fvgTrim(bullTopArr, bullBotArr, bullBarArr, bullRebUsed, bullDeadArr)
    if useBearishFVG and high < low[2]
        float sTop = low[2]
        float sBot = high
        float w = sTop - sBot
        if w > 0 and f_fvgThick(w, fvgAtr)
            array.push(bearTopArr, sTop)
            array.push(bearBotArr, sBot)
            array.push(bearBarArr, bar_index)
            array.push(bearRebUsed, false)
            array.push(bearDeadArr, false)
            f_fvgTrim(bearTopArr, bearBotArr, bearBarArr, bearRebUsed, bearDeadArr)

// --- FVGイベントOK (そのバー限定) ---
bool longFVGEventOk  = useFVGReboundFilter and fvgReboundBuy
bool shortFVGEventOk = useFVGReboundFilter and fvgReboundSell

// --- FVG状態管理 : イベント発生後、一定本数だけ「FVG条件OK」を保持 ---
var bool longFVGStateOk    = false
var bool shortFVGStateOk   = false
var int  longFVGStateBar   = na
var int  shortFVGStateBar  = na

if useFVGStateWindow
    if longFVGEventOk
        longFVGStateOk   := true
        longFVGStateBar  := bar_index
    if shortFVGEventOk
        shortFVGStateOk   := true
        shortFVGStateBar  := bar_index
    if longFVGStateOk and not na(longFVGStateBar) and (bar_index - longFVGStateBar > fvgStateMaxBars)
        longFVGStateOk := false
    if shortFVGStateOk and not na(shortFVGStateBar) and (bar_index - shortFVGStateBar > fvgStateMaxBars)
        shortFVGStateOk := false

// --- FVG 場所フィルター条件 ---
bool longFVGOk =
     not useFVGFilter or
     (useFVGStateWindow ? longFVGStateOk : longFVGEventOk)

bool shortFVGOk =
     not useFVGFilter or
     (useFVGStateWindow ? shortFVGStateOk : shortFVGEventOk)

// ============================================================
//  5b-2. EMA WinZone モジュール (MTF: 1M/5M/15M/1H/4H を反応価格帯として)
// ------------------------------------------------------------
//  EMA は Bias ではなく Zone。OFFの時間足は request.security を呼ばない。
//  出力: emaLongWinZone / emaShortWinZone / emaNoTrade
//  ・useEMAWZ=false の時は EMA計算・ATR・security・状態管理 を一切実行しない。
// ============================================================

// 1つの時間足の EMA(5本)+ATR を取得し、反発判定と帯レベルを返す。
//   返り値: [bounceLong, bounceShort, hitMALong, hitMAShort]。OFFのTFは security を呼ばない。
f_emaTFEval(bool _tfOn, string _tf, array<float> _levels) =>
    float _e1 = na
    float _e2 = na
    float _e3 = na
    float _e4 = na
    float _e5 = na
    float _atr = na
    if _tfOn
        [_v1, _v2, _v3, _v4, _v5, _v6] = request.security(syminfo.tickerid, _tf, [ta.ema(emaSource, emaLen1), ta.ema(emaSource, emaLen2), ta.ema(emaSource, emaLen3), ta.ema(emaSource, emaLen4), ta.ema(emaSource, emaLen5), ta.atr(emaAtrLen)], lookahead = barmerge.lookahead_off)
        _e1 := _v1
        _e2 := _v2
        _e3 := _v3
        _e4 := _v4
        _e5 := _v5
        _atr := _v6
    float _touch = emaTouchMode == "ATR" ? _atr * emaTouchATRMult : emaTouchDollar
    // BUY反発: low が EMA に触れ close が EMA上 / SELL反発: high が EMA に触れ close が EMA下
    bool _bl1 = _tfOn and useEMA1Zone and not na(_e1) and low <= _e1 + _touch and close > _e1 and close > open
    bool _bl2 = _tfOn and useEMA2Zone and not na(_e2) and low <= _e2 + _touch and close > _e2 and close > open
    bool _bl3 = _tfOn and useEMA3Zone and not na(_e3) and low <= _e3 + _touch and close > _e3 and close > open
    bool _bl4 = _tfOn and useEMA4Zone and not na(_e4) and low <= _e4 + _touch and close > _e4 and close > open
    bool _bl5 = _tfOn and useEMA5Zone and not na(_e5) and low <= _e5 + _touch and close > _e5 and close > open
    bool _bs1 = _tfOn and useEMA1Zone and not na(_e1) and high >= _e1 - _touch and close < _e1 and close < open
    bool _bs2 = _tfOn and useEMA2Zone and not na(_e2) and high >= _e2 - _touch and close < _e2 and close < open
    bool _bs3 = _tfOn and useEMA3Zone and not na(_e3) and high >= _e3 - _touch and close < _e3 and close < open
    bool _bs4 = _tfOn and useEMA4Zone and not na(_e4) and high >= _e4 - _touch and close < _e4 and close < open
    bool _bs5 = _tfOn and useEMA5Zone and not na(_e5) and high >= _e5 - _touch and close < _e5 and close < open
    // 帯用: ON の EMA レベルを配列へ追記
    if _tfOn and useEMA1Zone and not na(_e1)
        array.push(_levels, _e1)
    if _tfOn and useEMA2Zone and not na(_e2)
        array.push(_levels, _e2)
    if _tfOn and useEMA3Zone and not na(_e3)
        array.push(_levels, _e3)
    if _tfOn and useEMA4Zone and not na(_e4)
        array.push(_levels, _e4)
    if _tfOn and useEMA5Zone and not na(_e5)
        array.push(_levels, _e5)
    bool _bLong  = _bl1 or _bl2 or _bl3 or _bl4 or _bl5
    bool _bShort = _bs1 or _bs2 or _bs3 or _bs4 or _bs5
    int _maL = _bl5 ? 3000 : _bl4 ? 2000 : _bl3 ? 1000 : _bl2 ? 600 : _bl1 ? 200 : 0
    int _maS = _bs5 ? 3000 : _bs4 ? 2000 : _bs3 ? 1000 : _bs2 ? 600 : _bs1 ? 200 : 0
    [_bLong, _bShort, _maL, _maS]

// --- EMA WinZone 出力 (if外で初期化) ---
bool emaLongEventOk  = false
bool emaShortEventOk = false
bool emaNoTrade      = false
int  emaHitTF        = 0
int  emaHitMA        = 0

// 帯ブレイクの保持 (var)
var int emaBandBreakUpBar = na
var int emaBandBreakDnBar = na

if useEMAWZ
    array<float> _emaLevels = array.new_float()
    [_bl1m,  _bs1m,  _maL1m,  _maS1m]  = f_emaTFEval(useEMA1M,  tfEMA1M,  _emaLevels)
    [_bl5m,  _bs5m,  _maL5m,  _maS5m]  = f_emaTFEval(useEMA5M,  tfEMA5M,  _emaLevels)
    [_bl15m, _bs15m, _maL15m, _maS15m] = f_emaTFEval(useEMA15M, tfEMA15M, _emaLevels)
    [_bl1h,  _bs1h,  _maL1h,  _maS1h]  = f_emaTFEval(useEMA1H,  tfEMA1H,  _emaLevels)
    [_bl4h,  _bs4h,  _maL4h,  _maS4h]  = f_emaTFEval(useEMA4H,  tfEMA4H,  _emaLevels)
    // --- 反発 (どのTFでも反応すればOK) ---
    bool emaBounceLong  = _bl1m or _bl5m or _bl15m or _bl1h or _bl4h
    bool emaBounceShort = _bs1m or _bs5m or _bs15m or _bs1h or _bs4h
    // どのTF/どのEMAで反応したか (長期TF優先)
    int _hitTFL = _bl4h ? 240 : _bl1h ? 60 : _bl15m ? 15 : _bl5m ? 5 : _bl1m ? 1 : 0
    int _hitMAL = _bl4h ? _maL4h : _bl1h ? _maL1h : _bl15m ? _maL15m : _bl5m ? _maL5m : _bl1m ? _maL1m : 0
    int _hitTFS = _bs4h ? 240 : _bs1h ? 60 : _bs15m ? 15 : _bs5m ? 5 : _bs1m ? 1 : 0
    int _hitMAS = _bs4h ? _maS4h : _bs1h ? _maS1h : _bs15m ? _maS15m : _bs5m ? _maS5m : _bs1m ? _maS1m : 0
    // --- 帯 (全ON TF × 全ON EMA のレベルで BandTop / BandBottom) ---
    float emaBandTop    = na
    float emaBandBottom = na
    if array.size(_emaLevels) > 0
        emaBandTop    := array.max(_emaLevels)
        emaBandBottom := array.min(_emaLevels)
    bool emaBandValid  = not na(emaBandTop) and not na(emaBandBottom)
    bool aboveEMABand  = emaBandValid and close > emaBandTop
    bool belowEMABand  = emaBandValid and close < emaBandBottom
    bool insideEMABand = emaBandValid and not aboveEMABand and not belowEMABand
    // --- 帯抜けリテスト (チャート足の反応。接近幅はチャートATR) ---
    float _chartAtr  = ta.atr(emaAtrLen)
    float _bandTouch = emaTouchMode == "ATR" ? _chartAtr * emaTouchATRMult : emaTouchDollar
    float _emaBody   = math.abs(close - open)
    float _emaUpWick = high - math.max(open, close)
    float _emaDnWick = math.min(open, close) - low
    bool _emaBullRev = (close > open and close[1] < open[1] and close >= open[1] and open <= close[1]) or (_emaDnWick >= _emaBody and _emaDnWick >= _emaUpWick) or close > open
    bool _emaBearRev = (close < open and close[1] > open[1] and close <= open[1] and open >= close[1]) or (_emaUpWick >= _emaBody and _emaUpWick >= _emaDnWick) or close < open
    if aboveEMABand and not nz(aboveEMABand[1], false)
        emaBandBreakUpBar := bar_index
    if belowEMABand and not nz(belowEMABand[1], false)
        emaBandBreakDnBar := bar_index
    bool emaBandRetestLong  = useEMABandRetest and emaBandValid and not na(emaBandBreakUpBar) and (bar_index - emaBandBreakUpBar) <= emaBandRetestBars and low <= emaBandTop + _bandTouch and close > emaBandTop and _emaBullRev
    bool emaBandRetestShort = useEMABandRetest and emaBandValid and not na(emaBandBreakDnBar) and (bar_index - emaBandBreakDnBar) <= emaBandRetestBars and high >= emaBandBottom - _bandTouch and close < emaBandBottom and _emaBearRev
    // --- WinZone イベント (Zone = 場所反応。方向はローソク反応から決まる) ---
    bool _emaRawLong  = (useEMABounce and emaBounceLong)  or emaBandRetestLong
    bool _emaRawShort = (useEMABounce and emaBounceShort) or emaBandRetestShort
    emaNoTrade := useEMAInsideNoTrade and insideEMABand
    emaLongEventOk  := _emaRawLong  and not emaNoTrade
    emaShortEventOk := _emaRawShort and not emaNoTrade
    emaHitTF := emaBounceLong ? _hitTFL : emaBounceShort ? _hitTFS : 0
    emaHitMA := emaBounceLong ? _hitMAL : emaBounceShort ? _hitMAS : 0
    // --- ラベル (任意) ---
// --- EMA 状態管理 ---
var bool emaLongState     = false
var bool emaShortState    = false
var int  emaLongStateBar  = na
var int  emaShortStateBar = na

if useEMAWZ and useEMAStateWindow
    if emaLongEventOk
        emaLongState    := true
        emaLongStateBar := bar_index
    if emaShortEventOk
        emaShortState    := true
        emaShortStateBar := bar_index
    if emaLongState and not na(emaLongStateBar) and bar_index - emaLongStateBar > emaStateMaxBars
        emaLongState := false
    if emaShortState and not na(emaShortStateBar) and bar_index - emaShortStateBar > emaStateMaxBars
        emaShortState := false

// EMA WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool emaLongWinZone  = useEMAWZ ? (useEMAStateWindow ? emaLongState  : emaLongEventOk)  : false
bool emaShortWinZone = useEMAWZ ? (useEMAStateWindow ? emaShortState : emaShortEventOk) : false

// ============================================================
//  5b-2b. WinZone : Bollinger Bands モジュール (場所・状態フィルター)
// ------------------------------------------------------------
//  FVG / EMA と並列の WinZone フィルター。Trigger ではない。
//  ※ Trigger (bullTrigCount/bearTrigCount/enabledTrigCount) には混ぜない。
//  useBBWZ=false の時は if に入らず、ta.sma/ta.stdev/ta.atr/ta.lowest/
//  ta.highest / BB計算 / シグナル判定 / Rank / 状態更新 / label / table を実行しない。
//  出力 : bbEntryBuy/Sell / bbDirectionOkLong/Short / bbNoTrade(Long/Short) /
//         bbPercentBOkLong/Short / bbZScoreOkLong/Short
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool bbEntryBuy        = false
bool bbEntrySell       = false
bool bbDirectionOkLong = true
bool bbDirectionOkShort = true
bool bbNoTradeLong     = false
bool bbNoTradeShort    = false
bool bbNoTrade         = false
bool bbPercentBOkLong  = true
bool bbPercentBOkShort = true
bool bbZScoreOkLong    = true
bool bbZScoreOkShort   = true

if useBBWZ
    bool bAct = true

    // ---- BB計算 (使用パターン: B:外側NoTrade / C:±2σ / D:±3σ のみ) ----
    float basis = ta.sma(bbSource, bbLen)
    float dev   = ta.stdev(bbSource, bbLen)
    float upper2 = basis + dev * bbMult2
    float lower2 = basis - dev * bbMult2
    float upper3 = basis + dev * bbMult3
    float lower3 = basis - dev * bbMult3
    float zScore = (not na(dev) and dev != 0) ? (bbSource - basis) / dev : na

    // ---- 反転ローソク ----
    float bb_body   = math.abs(close - open)
    float bb_upWick = high - math.max(open, close)
    float bb_dnWick = math.min(open, close) - low
    bool bb_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool bb_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool bb_pinLower = bb_dnWick >= bb_body and bb_dnWick >= bb_upWick
    bool bb_pinUpper = bb_upWick >= bb_body and bb_upWick >= bb_dnWick
    bool bb_bullishReversal = bb_bullEngulf or bb_pinLower or close > open
    bool bb_bearishReversal = bb_bearEngulf or bb_pinUpper or close < open

    // ---- B: 極端な外側NoTrade ----
    bbNoTradeLong  := bAct and useBBOutsideNoTrade and not na(zScore) and zScore >= bbExtremeZ
    bbNoTradeShort := bAct and useBBOutsideNoTrade and not na(zScore) and zScore <= -bbExtremeZ

    // ---- C: ±2σ反発 ----
    bool bbBuyReversal2Signal  = bAct and useBBReversal2 and low  <= lower2 and bb_bullishReversal and close > lower2
    bool bbSellReversal2Signal = bAct and useBBReversal2 and high >= upper2 and bb_bearishReversal and close < upper2

    // ---- D: ±3σ反発 ----
    bool bbBuyReversal3Signal  = bAct and useBBReversal3 and low  <= lower3 and bb_bullishReversal and close > lower3
    bool bbSellReversal3Signal = bAct and useBBReversal3 and high >= upper3 and bb_bearishReversal and close < upper3

    // ---- エントリー結合 (Any / All) ----
    int bbEnabledCount = (useBBReversal2 ? 1 : 0) + (useBBReversal3 ? 1 : 0)
    int bbFiredBuy  = (bbBuyReversal2Signal ? 1 : 0) + (bbBuyReversal3Signal ? 1 : 0)
    int bbFiredSell = (bbSellReversal2Signal ? 1 : 0) + (bbSellReversal3Signal ? 1 : 0)
    bbEntryBuy  := bAct and bbEnabledCount > 0 and (bbEntryMode == "All" ? bbFiredBuy  == bbEnabledCount : bbFiredBuy  >= 1)
    bbEntrySell := bAct and bbEnabledCount > 0 and (bbEntryMode == "All" ? bbFiredSell == bbEnabledCount : bbFiredSell >= 1)

    // ---- 表示 : ラベル ----
    // ---- 表示 : デバッグテーブル ----
// --- BB 状態管理 : bbEntryBuy/Sell が出たら状態ON、bbStateMaxBars 本で期限切れ ---
var bool longBBStateOk  = false
var bool shortBBStateOk = false
var int  longBBStateBar  = na
var int  shortBBStateBar = na

if useBBWZ and useBBStateWindow
    if bbEntryBuy
        longBBStateOk := true
        longBBStateBar := bar_index
    if bbEntrySell
        shortBBStateOk := true
        shortBBStateBar := bar_index
    if longBBStateOk and not na(longBBStateBar) and bar_index - longBBStateBar > bbStateMaxBars
        longBBStateOk := false
    if shortBBStateOk and not na(shortBBStateBar) and bar_index - shortBBStateBar > bbStateMaxBars
        shortBBStateOk := false

// --- BB 許可 ---
//   OFF … 常に許可 (完全素通し)
//   状態管理OFF … bbEntryBuy/Sell の単バー + 方向/NoTrade/%B/ZScore
//   状態管理ON  … 保持中フラグ + 方向/NoTrade/%B/ZScore
bool allowLongByBB  = not useBBWZ ? true : useBBStateWindow ? (longBBStateOk and bbDirectionOkLong and not bbNoTradeLong and bbPercentBOkLong and bbZScoreOkLong) : (bbEntryBuy and bbDirectionOkLong and not bbNoTradeLong and bbPercentBOkLong and bbZScoreOkLong)
bool allowShortByBB = not useBBWZ ? true : useBBStateWindow ? (shortBBStateOk and bbDirectionOkShort and not bbNoTradeShort and bbPercentBOkShort and bbZScoreOkShort) : (bbEntrySell and bbDirectionOkShort and not bbNoTradeShort and bbPercentBOkShort and bbZScoreOkShort)

// BB WinZone 出力 (使用時=許可フラグ / 未使用=false)
bool bbLongWinZone  = useBBWZ ? allowLongByBB  : false
bool bbShortWinZone = useBBWZ ? allowShortByBB : false

// ============================================================
//  5b-2c. 水平線 WinZone モジュール (レジサポを反応する場所として)
// ------------------------------------------------------------
//  Pivot(MTF) / 複数回反応 / 前日H・L / セッションH・L を統合ゾーン化し、
//  反発 / レジサポ転換 / ブレイク / スイープ反転 を場所条件(Zone)として使う。
//  水平線は Bias ではなく Zone。反応したら WinZone。方向はローソク反応から。
//  ・useLineWZ=false の時は ta.*・配列・前日/セッション更新・各判定・描画 を
//    一切実行しない (全処理を if useLineWZ の中に閉じ込める)。
// ============================================================

// --- 統合水平線ゾーン配列 (var: 状態保持。操作は if useLineWZ 内のみ) ---
var array<float> zPrice   = array.new_float()
var array<int>   zTouch   = array.new_int()
var array<int>   zCreated = array.new_int()
var array<int>   zLast    = array.new_int()
var array<bool>  zPivot   = array.new_bool()
var array<bool>  zPrev    = array.new_bool()
var array<bool>  zSess    = array.new_bool()
var array<int>   zTF      = array.new_int()   // どの時間足由来か (1/5/15/60/240、0=前日/セッション)

// 共通フィルター (ローソク品質)。呼ばれない時は実行されない。
f_lineCommonOK(bool isBuy) =>
    not useLineDirCandleFilter or (isBuy ? close > open : close < open)

// ゾーンへ追加/統合 (srcPivot/srcPrev/srcSess のいずれか1つを true で渡す。_tfCode=由来TF)
f_lineAddZone(float p, bool srcPivot, bool srcPrev, bool srcSess, int _tfCode, float _mergeTol) =>
    bool _found = false
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not _found and math.abs(array.get(zPrice, i) - p) <= _mergeTol
                int _oldT = array.get(zTouch, i)
                int _newT = _oldT + 1
                array.set(zPrice, i, (array.get(zPrice, i) * _oldT + p) / _newT)
                array.set(zTouch, i, _newT)
                array.set(zLast,  i, bar_index)
                array.set(zPivot, i, array.get(zPivot, i) or srcPivot)
                array.set(zPrev,  i, array.get(zPrev,  i) or srcPrev)
                array.set(zSess,  i, array.get(zSess,  i) or srcSess)
                array.set(zTF,    i, math.max(array.get(zTF, i), _tfCode))   // 統合時は上位TFを採用
                _found := true
    if not _found
        array.push(zPrice, p)
        array.push(zTouch, 1)
        array.push(zCreated, bar_index)
        array.push(zLast, bar_index)
        array.push(zPivot, srcPivot)
        array.push(zPrev,  srcPrev)
        array.push(zSess,  srcSess)
        array.push(zTF,    _tfCode)
        if array.size(zPrice) > lineMaxZones
            array.shift(zPrice)
            array.shift(zTouch)
            array.shift(zCreated)
            array.shift(zLast)
            array.shift(zPivot)
            array.shift(zPrev)
            array.shift(zSess)
            array.shift(zTF)

// strength: 1=Pivotのみ / 2=複数反応 / 3=前日 / 4=セッション / 5=複数ソース重合
f_lineZoneStrength(bool isPivot, bool isPrev, bool isSess, int touches) =>
    int _srcCount = (isPivot ? 1 : 0) + (isPrev ? 1 : 0) + (isSess ? 1 : 0)
    _srcCount >= 2 ? 5 : isSess ? 4 : isPrev ? 3 : 1

// strength → 色 / 太さ
// --- 水平線 出力 (if外で初期化) ---
bool  lineRawLong        = false
bool  lineRawShort       = false
float nearestSupport     = na
float nearestResistance  = na
int   lineSignalType     = 0
int   lineStrength       = 0
int   lineHitTF          = 0
bool  lineNoTradeLong    = false
bool  lineNoTradeShort   = false
bool  lineNoTrade        = false

// 前日 / セッション / Flip 状態 (var: バー跨ぎ保持。更新は if useLineWZ 内のみ)
var float curDayHigh = na
var float curDayLow  = na
var float prevHigh   = na
var float prevLow    = na
// 表示オブジェクト

if useLineWZ
    float lineAtr = ta.atr(lineAtrLen)
    float lineZoneW = useLineATRZone ? lineAtr * lineZoneATRMult : lineZoneFixedWidth
    float _mergeTol = useLineMergeZone ? lineAtr * lineMergeToleranceATR : lineAtr * reactionToleranceATR
    // 前日 高値/安値 (チャート基準)
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        prevHigh := curDayHigh
        prevLow  := curDayLow
        curDayHigh := high
        curDayLow  := low
        if usePreviousDayHL and not na(prevHigh)
            f_lineAddZone(prevHigh, false, true, false, 0, _mergeTol)
        if usePreviousDayHL and not na(prevLow)
            f_lineAddZone(prevLow, false, true, false, 0, _mergeTol)
    else
        curDayHigh := na(curDayHigh) ? high : math.max(curDayHigh, high)
        curDayLow  := na(curDayLow)  ? low  : math.min(curDayLow, low)
    // 最近接 Support(<=close) / Resistance(>=close)
    int  _nsStrength = 0
    int  _nrStrength = 0
    int  _nsCreated = na
    int  _nrCreated = na
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if bar_index >= array.get(zCreated, i)
                float _pr = array.get(zPrice, i)
                int   _st = f_lineZoneStrength(array.get(zPivot, i), array.get(zPrev, i), array.get(zSess, i), array.get(zTouch, i))
                if _pr <= close
                    if na(nearestSupport) or _pr > nearestSupport
                        nearestSupport := _pr
                        _nsStrength := _st
                        _nsCreated := array.get(zCreated, i)
                if _pr >= close
                    if na(nearestResistance) or _pr < nearestResistance
                        nearestResistance := _pr
                        _nrStrength := _st
                        _nrCreated := array.get(zCreated, i)
    float _supZoneTop = nearestSupport + lineZoneW
    float _resZoneBot = nearestResistance - lineZoneW
    bool _supUsable = not na(nearestSupport)    and not na(_nsCreated) and bar_index >= _nsCreated
    bool _resUsable = not na(nearestResistance) and not na(_nrCreated) and bar_index >= _nrCreated
    // A: 反発 (使用パターンはこれのみ)
    bool _buyBounce  = useLineBounce and _supUsable and low  <= _supZoneTop and close > nearestSupport    and f_lineCommonOK(true)
    bool _sellBounce = useLineBounce and _resUsable and high >= _resZoneBot and close < nearestResistance and f_lineCommonOK(false)
    lineSignalType := (_buyBounce or _sellBounce) ? 1 : 0
    lineRawLong  := _buyBounce
    lineRawShort := _sellBounce
    int _dir = (lineRawLong and not lineRawShort) ? 1 : (lineRawShort and not lineRawLong) ? -1 : 0
    lineStrength := _dir == 1 ? _nsStrength : _dir == -1 ? _nrStrength : math.max(_nsStrength, _nrStrength)
    // --- 表示 (useLineWZ 内でのみ line/label を生成) ---
// --- 水平線 状態管理 (シグナル後 lineStateMaxBars 本だけ WinZone 維持) ---
var int lineLongStateBar  = na
var int lineShortStateBar = na
if useLineWZ and useLineStateWindow
    if lineRawLong
        lineLongStateBar := bar_index
    if lineRawShort
        lineShortStateBar := bar_index
bool lineLongState  = useLineStateWindow and not na(lineLongStateBar)  and (bar_index - lineLongStateBar)  <= lineStateMaxBars
bool lineShortState = useLineStateWindow and not na(lineShortStateBar) and (bar_index - lineShortStateBar) <= lineStateMaxBars

// 水平線 WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool lineLongWinZone  = useLineWZ ? (useLineStateWindow ? lineLongState  : lineRawLong)  : false
bool lineShortWinZone = useLineWZ ? (useLineStateWindow ? lineShortState : lineRawShort) : false

// ============================================================
//  5b-2d. フィボ WinZone モジュール (戻り売り/押し目買い・場所条件)
// ------------------------------------------------------------
//  FVG/EMA/BB/水平線 と同じ場所条件階層。useFibWZ=false の時は ta.pivot/atr/ema・
//  波計算・ランク・ゾーン・反転確認を一切走らせない (軽量)。
//  出力: fibBuySignal / fibSellSignal → longFibOk / shortFibOk
//        状態管理後 → longFibZoneOk / shortFibZoneOk
// ============================================================

// ランク判定関数 (pure。呼ばれない時は実行されない)
f_fibRank(float pct) =>
    int r = 0
    if not na(pct)
        if useRankA and pct >= fibAStart and pct <= fibAEnd
            r := 3
        else if useRankB and pct >= fibBStart and pct < fibBEnd
            r := 2
        else if useRankC and pct >= fibCStart and pct < fibCEnd
            r := 1
    r

// 出力 (if外で初期化)
bool fibBuySignal  = false
bool fibSellSignal = false
bool fibBuyZone    = false
bool fibSellZone   = false
int  fibDirection  = 0
int  fibRank       = 0

if useFibWZ
    float _atr   = ta.atr(fibAtrLen)
    float _ph = ta.pivothigh(high, swingLookback, swingLookback)
    float _pl = ta.pivotlow(low,  swingLookback, swingLookback)
    var float lastPH    = na
    var int   lastPHbar = na
    var float lastPL    = na
    var int   lastPLbar = na
    if not na(_ph)
        lastPH := _ph
        lastPHbar := bar_index - swingLookback
    if not na(_pl)
        lastPL := _pl
        lastPLbar := bar_index - swingLookback
    bool bothPivots = not na(lastPH) and not na(lastPL)
    // 下降波(高→安=SELL用) / 上昇波(安→高=BUY用)
    bool downWaveValid = bothPivots and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)
    bool upWaveValid   = bothPivots and (lastPLbar < lastPHbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPLbar) <= waveLookback)
    float sSwingHigh = lastPH
    float sSwingLow  = lastPL
    float sRange = sSwingHigh - sSwingLow
    float sRetracePct = downWaveValid and sRange > 0 ? math.max(0.0, math.min(1.0, (close - sSwingLow) / sRange)) : na
    float bSwingHigh = lastPH
    float bSwingLow  = lastPL
    float bRange = bSwingHigh - bSwingLow
    float bRetracePct = upWaveValid and bRange > 0 ? math.max(0.0, math.min(1.0, (bSwingHigh - close) / bRange)) : na
    int sRank = f_fibRank(sRetracePct)
    int bRank = f_fibRank(bRetracePct)
    // ゾーン価格レベル
    float sZoneLowPrice  = sSwingLow + fibCStart * sRange
    float sZoneHighPrice = sSwingLow + fibAEnd   * sRange
    float sDeepLimit     = sSwingLow + fibAEnd   * sRange
    float bZoneHighPrice = bSwingHigh - fibCStart * bRange
    float bZoneLowPrice  = bSwingHigh - fibAEnd   * bRange
    float bDeepLimit     = bSwingHigh - fibAEnd   * bRange
    float buf = _atr * fibZoneBufferATR
    bool priceInSellZone = downWaveValid and sRank > 0 and (high >= sZoneLowPrice - buf) and (low <= sZoneHighPrice + buf)
    bool priceInBuyZone  = upWaveValid   and bRank > 0 and (low <= bZoneHighPrice + buf) and (high >= bZoneLowPrice - buf)
    // 無効条件 (深限界 / 起点突破)
    bool invSell = downWaveValid and ((useDeepLimitInvalid and close > sDeepLimit) or (useOriginInvalid and close > sSwingHigh))
    bool invBuy  = upWaveValid   and ((useDeepLimitInvalid and close < bDeepLimit) or (useOriginInvalid and close < bSwingLow))
    bool confirmedOK = not requireConfirmedBar or barstate.isconfirmed
    bool sellSetup = useFibSell and priceInSellZone and not invSell
    bool buySetup  = useFibBuy  and priceInBuyZone  and not invBuy
    bool _fibSellSig = sellSetup and confirmedOK
    bool _fibBuySig  = buySetup  and confirmedOK
    // 出力へ反映
    fibSellSignal := _fibSellSig
    fibBuySignal  := _fibBuySig
    fibSellZone   := sellSetup
    fibBuyZone    := buySetup
    fibDirection  := _fibBuySig ? 1 : _fibSellSig ? -1 : buySetup ? 1 : sellSetup ? -1 : 0
    fibRank       := fibDirection == 1 ? bRank : fibDirection == -1 ? sRank : 0

// 接続: BUYシグナル→longFibOk / SELLシグナル→shortFibOk (反転確認込み)
bool longFibOk  = fibBuySignal
bool shortFibOk = fibSellSignal

// --- フィボ 状態管理 (FVG/EMA/BB/水平線 と同思想。イベント後 一定本数保持) ---
var bool longFibStateOk   = false
var bool shortFibStateOk  = false
var int  longFibStateBar  = na
var int  shortFibStateBar = na
var int  longFibStateRank  = 0
var int  shortFibStateRank = 0

if useFibWZ and useFibStateWindow
    if fibBuySignal
        longFibStateOk   := true
        longFibStateBar  := bar_index
        longFibStateRank := fibRank
    if fibSellSignal
        shortFibStateOk   := true
        shortFibStateBar  := bar_index
        shortFibStateRank := fibRank
    if longFibStateOk and not na(longFibStateBar) and bar_index - longFibStateBar > fibStateMaxBars
        longFibStateOk := false
    if shortFibStateOk and not na(shortFibStateBar) and bar_index - shortFibStateBar > fibStateMaxBars
        shortFibStateOk := false

// フィボ 場所条件 (状態管理ON=状態フラグ / OFF=シグナル単バー / 未使用=false)
bool longFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? longFibStateOk : fibBuySignal
bool shortFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? shortFibStateOk : fibSellSignal

// ============================================================
//  5b-2e. Trendline / Channel WinZone モジュール (トレンドライン・チャネルを場所として)
// ------------------------------------------------------------
//  FVG/EMA/BB/水平線/フィボ と並列の場所条件。useTrendWZ=false の時は
//  ta.atr/pivot・ライン計算・Quality・状態管理・line/label/table を一切走らせない。
//  A:反発 / B:ブレイク / C:リテスト / D:Fake / E-I:Channel各種。
//  出力: trendEntryBuy / trendEntrySell → longTrendZoneOk / shortTrendZoneOk
// ============================================================

// --- ヘルパー関数 (定義はグローバル。呼び出しは if 内のみ) ---
f_tlNear(float price, float level, float rng) =>
    not na(level) and math.abs(price - level) <= rng

f_tlLineValue(int x1, float y1, int x2, float y2, int xNow) =>
    float slope = (y2 - y1) / math.max(x2 - x1, 1)
    y1 + slope * (xNow - x1)

f_tlQualityScore(int touch, int ageBars, float slopeAbsATR, int broken) =>
    int touchScore = touch >= 4 ? 40 : touch == 3 ? 30 : touch >= 2 ? 20 : 0
    int ageScore = (ageBars >= 20 and ageBars <= 150) ? 20 : (ageBars >= 151 and ageBars <= 300) ? 10 : 0
    int slopeScore = na(slopeAbsATR) ? 0 : (slopeAbsATR < minSlopeATR ? 5 : slopeAbsATR > maxSlopeATR ? 5 : 20)
    int brokenScore = broken == 0 ? 20 : broken == 1 ? 10 : 0
    math.min(100, touchScore + ageScore + slopeScore + brokenScore)

f_tlSlopeATR(float p1, int b1, float p2, int b2, float atrv) =>
    atrv != 0 ? math.abs((p2 - p1) / math.max(b2 - b1, 1)) / atrv : na

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool trendEntryBuy     = false
bool trendEntrySell    = false
bool trendNoTrade      = false
bool trendNoTradeLong  = false
bool trendNoTradeShort = false
bool trendQualityOk    = true
int  trendSignalType   = 0
int  trendDirection    = 0
int  trendRank         = 0
int  trendlineQuality  = 0

if useTrendWZ
    // ---- 基礎 ----
    float atr = ta.atr(14)
    float trendTouchRange = trendTouchMode == "ATR" ? atr * trendTouchATR : trendTouchDollar

    // 反転ローソク
    float tl_body   = math.abs(close - open)
    float tl_upWick = high - math.max(open, close)
    float tl_dnWick = math.min(open, close) - low
    bool tl_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool tl_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool tl_pinLower = tl_dnWick >= tl_body and tl_dnWick >= tl_upWick
    bool tl_pinUpper = tl_upWick >= tl_body and tl_upWick >= tl_dnWick
    bool bullishReversal = tl_bullEngulf or tl_pinLower or close > open
    bool bearishReversal = tl_bearEngulf or tl_pinUpper or close < open

    // ---- Pivot検知 (確定Pivot / ATR Swing Filter) 直近4点保持 ----
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    float pl = ta.pivotlow(low, pivotLen, pivotLen)

    var float hp1P = na
    var float hp2P = na
    var float hp3P = na
    var float hp4P = na
    var int   hp1B = na
    var int   hp2B = na
    var int   hp3B = na
    var int   hp4B = na
    var float lp1P = na
    var float lp2P = na
    var float lp3P = na
    var float lp4P = na
    var int   lp1B = na
    var int   lp2B = na
    var int   lp3B = na
    var int   lp4B = na

    bool newHighPivot = false
    bool newLowPivot  = false
    if not na(ph)
        if na(hp1P) or not useATRSwingFilter or math.abs(ph - hp1P) >= atr * minSwingATR
            hp4P := hp3P
            hp4B := hp3B
            hp3P := hp2P
            hp3B := hp2B
            hp2P := hp1P
            hp2B := hp1B
            hp1P := ph
            hp1B := bar_index - pivotLen
            newHighPivot := true
    if not na(pl)
        if na(lp1P) or not useATRSwingFilter or math.abs(pl - lp1P) >= atr * minSwingATR
            lp4P := lp3P
            lp4B := lp3B
            lp3P := lp2P
            lp3B := lp2B
            lp2P := lp1P
            lp2B := lp1B
            lp1P := pl
            lp1B := bar_index - pivotLen
            newLowPivot := true

    // ---- 複数Trendline (短期/中期/長期) + Touch / Broken カウンタ ----
    var int upTouchA = 0
    var int upTouchB = 0
    var int upTouchC = 0
    var int upBrokA = 0
    var int upBrokB = 0
    var int upBrokC = 0
    var int upBelowA = 0
    var int upBelowB = 0
    var int upBelowC = 0
    var int dnTouchA = 0
    var int dnTouchB = 0
    var int dnTouchC = 0
    var int dnBrokA = 0
    var int dnBrokB = 0
    var int dnBrokC = 0
    var int dnAboveA = 0
    var int dnAboveB = 0
    var int dnAboveC = 0
    if newLowPivot
        upTouchA := 0
        upTouchB := 0
        upTouchC := 0
        upBrokA := 0
        upBrokB := 0
        upBrokC := 0
        upBelowA := 0
        upBelowB := 0
        upBelowC := 0
    if newHighPivot
        dnTouchA := 0
        dnTouchB := 0
        dnTouchC := 0
        dnBrokA := 0
        dnBrokB := 0
        dnBrokC := 0
        dnAboveA := 0
        dnAboveB := 0
        dnAboveC := 0

    // --- 上昇ライン値 ---
    bool upValidA = not na(lp1P) and not na(lp2P) and lp1B != lp2B
    bool upValidB = not na(lp1P) and not na(lp3P) and lp1B != lp3B
    bool upValidC = not na(lp1P) and not na(lp4P) and lp1B != lp4B
    float upValA = upValidA ? f_tlLineValue(lp2B, lp2P, lp1B, lp1P, bar_index) : na
    float upValB = upValidB ? f_tlLineValue(lp3B, lp3P, lp1B, lp1P, bar_index) : na
    float upValC = upValidC ? f_tlLineValue(lp4B, lp4P, lp1B, lp1P, bar_index) : na
    if not na(upValA)
        if f_tlNear(low, upValA, trendTouchRange) and bullishReversal and close > upValA
            upTouchA := upTouchA + 1
        upBelowA := close < upValA ? upBelowA + 1 : 0
        if upBelowA == breakConfirmBars
            upBrokA := upBrokA + 1
    if not na(upValB)
        if f_tlNear(low, upValB, trendTouchRange) and bullishReversal and close > upValB
            upTouchB := upTouchB + 1
        upBelowB := close < upValB ? upBelowB + 1 : 0
        if upBelowB == breakConfirmBars
            upBrokB := upBrokB + 1
    if not na(upValC)
        if f_tlNear(low, upValC, trendTouchRange) and bullishReversal and close > upValC
            upTouchC := upTouchC + 1
        upBelowC := close < upValC ? upBelowC + 1 : 0
        if upBelowC == breakConfirmBars
            upBrokC := upBrokC + 1

    // --- 下降ライン値 ---
    bool dnValidA = not na(hp1P) and not na(hp2P) and hp1B != hp2B
    bool dnValidB = not na(hp1P) and not na(hp3P) and hp1B != hp3B
    bool dnValidC = not na(hp1P) and not na(hp4P) and hp1B != hp4B
    float dnValA = dnValidA ? f_tlLineValue(hp2B, hp2P, hp1B, hp1P, bar_index) : na
    float dnValB = dnValidB ? f_tlLineValue(hp3B, hp3P, hp1B, hp1P, bar_index) : na
    float dnValC = dnValidC ? f_tlLineValue(hp4B, hp4P, hp1B, hp1P, bar_index) : na
    if not na(dnValA)
        if f_tlNear(high, dnValA, trendTouchRange) and bearishReversal and close < dnValA
            dnTouchA := dnTouchA + 1
        dnAboveA := close > dnValA ? dnAboveA + 1 : 0
        if dnAboveA == breakConfirmBars
            dnBrokA := dnBrokA + 1
    if not na(dnValB)
        if f_tlNear(high, dnValB, trendTouchRange) and bearishReversal and close < dnValB
            dnTouchB := dnTouchB + 1
        dnAboveB := close > dnValB ? dnAboveB + 1 : 0
        if dnAboveB == breakConfirmBars
            dnBrokB := dnBrokB + 1
    if not na(dnValC)
        if f_tlNear(high, dnValC, trendTouchRange) and bearishReversal and close < dnValC
            dnTouchC := dnTouchC + 1
        dnAboveC := close > dnValC ? dnAboveC + 1 : 0
        if dnAboveC == breakConfirmBars
            dnBrokC := dnBrokC + 1

    // 各ライン Quality
    int upQA = upValidA ? f_tlQualityScore(upTouchA, bar_index - lp2B, f_tlSlopeATR(lp2P, lp2B, lp1P, lp1B, atr), upBrokA) : -1
    int upQB = upValidB ? f_tlQualityScore(upTouchB, bar_index - lp3B, f_tlSlopeATR(lp3P, lp3B, lp1P, lp1B, atr), upBrokB) : -1
    int upQC = upValidC ? f_tlQualityScore(upTouchC, bar_index - lp4B, f_tlSlopeATR(lp4P, lp4B, lp1P, lp1B, atr), upBrokC) : -1
    int dnQA = dnValidA ? f_tlQualityScore(dnTouchA, bar_index - hp2B, f_tlSlopeATR(hp2P, hp2B, hp1P, hp1B, atr), dnBrokA) : -1
    int dnQB = dnValidB ? f_tlQualityScore(dnTouchB, bar_index - hp3B, f_tlSlopeATR(hp3P, hp3B, hp1P, hp1B, atr), dnBrokB) : -1
    int dnQC = dnValidC ? f_tlQualityScore(dnTouchC, bar_index - hp4B, f_tlSlopeATR(hp4P, hp4B, hp1P, hp1B, atr), dnBrokC) : -1

    // 上昇: Quality最高(同点は近い方)を採用
    int   selUpIdx = na
    float upTrendlineValue = na
    int   upTrendlineQuality = 0
    int   upTouchCount = 0
    int   upBrokenCount = 0
    float selUpAnchorP = na
    int   selUpAnchorB = na
    if upValidA
        selUpIdx := 0
        upTrendlineValue := upValA
        upTrendlineQuality := upQA
        upTouchCount := upTouchA
        upBrokenCount := upBrokA
        selUpAnchorP := lp2P
        selUpAnchorB := lp2B
    if upValidB and (na(selUpIdx) or upQB > upTrendlineQuality or (upQB == upTrendlineQuality and math.abs(close - upValB) < math.abs(close - upTrendlineValue)))
        selUpIdx := 1
        upTrendlineValue := upValB
        upTrendlineQuality := upQB
        upTouchCount := upTouchB
        upBrokenCount := upBrokB
        selUpAnchorP := lp3P
        selUpAnchorB := lp3B
    if upValidC and (na(selUpIdx) or upQC > upTrendlineQuality or (upQC == upTrendlineQuality and math.abs(close - upValC) < math.abs(close - upTrendlineValue)))
        selUpIdx := 2
        upTrendlineValue := upValC
        upTrendlineQuality := upQC
        upTouchCount := upTouchC
        upBrokenCount := upBrokC
        selUpAnchorP := lp4P
        selUpAnchorB := lp4B
    bool upValid = not na(upTrendlineValue)

    // 下降: 同様
    int   selDnIdx = na
    float downTrendlineValue = na
    int   downTrendlineQuality = 0
    int   downTouchCount = 0
    int   downBrokenCount = 0
    float selDnAnchorP = na
    int   selDnAnchorB = na
    if dnValidA
        selDnIdx := 0
        downTrendlineValue := dnValA
        downTrendlineQuality := dnQA
        downTouchCount := dnTouchA
        downBrokenCount := dnBrokA
        selDnAnchorP := hp2P
        selDnAnchorB := hp2B
    if dnValidB and (na(selDnIdx) or dnQB > downTrendlineQuality or (dnQB == downTrendlineQuality and math.abs(close - dnValB) < math.abs(close - downTrendlineValue)))
        selDnIdx := 1
        downTrendlineValue := dnValB
        downTrendlineQuality := dnQB
        downTouchCount := dnTouchB
        downBrokenCount := dnBrokB
        selDnAnchorP := hp3P
        selDnAnchorB := hp3B
    if dnValidC and (na(selDnIdx) or dnQC > downTrendlineQuality or (dnQC == downTrendlineQuality and math.abs(close - dnValC) < math.abs(close - downTrendlineValue)))
        selDnIdx := 2
        downTrendlineValue := dnValC
        downTrendlineQuality := dnQC
        downTouchCount := dnTouchC
        downBrokenCount := dnBrokC
        selDnAnchorP := hp4P
        selDnAnchorB := hp4B
    bool downValid = not na(downTrendlineValue)

    trendlineQuality := math.max(upTrendlineQuality, downTrendlineQuality)
    bool tl_highQuality = trendlineQuality >= 80

    // ---- Channel計算 (実Pivotを通る平行線) ----
    float upTLatHP = (upValid and not na(hp1B)) ? f_tlLineValue(selUpAnchorB, selUpAnchorP, lp1B, lp1P, hp1B) : na
    float upOffset = (not na(upTLatHP) and not na(hp1P)) ? math.abs(hp1P - upTLatHP) : na
    float upChannelLower = upTrendlineValue
    float upChannelUpper = (not na(upTrendlineValue) and not na(upOffset)) ? upTrendlineValue + upOffset : na
    float downTLatLP = (downValid and not na(lp1B)) ? f_tlLineValue(selDnAnchorB, selDnAnchorP, hp1B, hp1P, lp1B) : na
    float downOffset = (not na(downTLatLP) and not na(lp1P)) ? math.abs(lp1P - downTLatLP) : na
    float downChannelUpper = downTrendlineValue
    float downChannelLower = (not na(downTrendlineValue) and not na(downOffset)) ? downTrendlineValue - downOffset : na
    float upChannelWidth   = (not na(upChannelUpper) and not na(upChannelLower)) ? upChannelUpper - upChannelLower : na
    float downChannelWidth = (not na(downChannelUpper) and not na(downChannelLower)) ? downChannelUpper - downChannelLower : na

    // Channel Slope (採用ラインの符号付き傾き / 本)
    float upSlopeSigned   = upValid   ? (lp1P - selUpAnchorP) / math.max(lp1B - selUpAnchorB, 1) : na
    float downSlopeSigned = downValid ? (hp1P - selDnAnchorP) / math.max(hp1B - selDnAnchorB, 1) : na
    bool activeUp = upValid
    float channelSlope = activeUp ? upSlopeSigned : downSlopeSigned

    // ---- 接近判定 ----
    bool nearUpTrendline   = f_tlNear(low,  upTrendlineValue, trendTouchRange)
    bool nearDownTrendline = f_tlNear(high, downTrendlineValue, trendTouchRange)
    bool nearUpChannelLower = f_tlNear(low,  upChannelLower, trendTouchRange)
    bool nearUpChannelUpper = f_tlNear(high, upChannelUpper, trendTouchRange)
    bool nearDownChannelUpper = f_tlNear(high, downChannelUpper, trendTouchRange)
    bool nearDownChannelLower = f_tlNear(low,  downChannelLower, trendTouchRange)

    // ---- Quality OK / 最低Touch ----
    bool touchCountOk = (upValid and upTouchCount >= minLineTouches) or (downValid and downTouchCount >= minLineTouches)
    trendQualityOk := not useTrendQualityFilter or (trendlineQuality >= minTrendlineQuality and touchCountOk)

    // 採用ライン (上下のうちQuality高い方) 情報
    bool selUpDominant = upTrendlineQuality >= downTrendlineQuality
    int   selectedTrendlineIndex   = selUpDominant ? (na(selUpIdx) ? -1 : selUpIdx) : (na(selDnIdx) ? -1 : selDnIdx)
    int   selectedTrendlineQuality = trendlineQuality
    float selectedTrendlineValue   = selUpDominant ? upTrendlineValue : downTrendlineValue
    float selectedTrendlineDistance = na(selectedTrendlineValue) ? na : math.abs(close - selectedTrendlineValue)
    float selectedChannelWidth     = activeUp ? upChannelWidth : downChannelWidth
    int   touchCountSelected  = selUpDominant ? upTouchCount : downTouchCount
    int   brokenCountSelected = selUpDominant ? upBrokenCount : downBrokenCount

    // ---- A: Trendline反発 ----
    bool trendBuyBounceSignal  = useTrendBounce and nearUpTrendline   and bullishReversal and close > upTrendlineValue   and trendQualityOk
    bool trendSellBounceSignal = useTrendBounce and nearDownTrendline and bearishReversal and close < downTrendlineValue and trendQualityOk

    // ---- D: Fake Break (流動性狩り) ----
    bool trendBuyFakeBreakSignal  = useTrendFakeBreak and not na(upTrendlineValue)   and not na(upTrendlineValue[1])   and low  < upTrendlineValue   and close > upTrendlineValue   and close[1] <= upTrendlineValue[1]   and bullishReversal
    bool trendSellFakeBreakSignal = useTrendFakeBreak and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and high > downTrendlineValue and close < downTrendlineValue and close[1] >= downTrendlineValue[1] and bearishReversal

    // ---- F: Channel反発 ----
    bool channelBuyBounceSignal  = useChannel and useChannelBounce and (nearUpChannelLower or nearDownChannelLower) and bullishReversal
    bool channelSellBounceSignal = useChannel and useChannelBounce and (nearUpChannelUpper or nearDownChannelUpper) and bearishReversal

    // ---- NoTrade ----
    trendNoTrade      := false
    trendNoTradeLong  := false
    trendNoTradeShort := false

    // ---- Entry結合 (Any / All) ----
    int trendEnabledCount = (useTrendBounce ? 1 : 0) + (useTrendFakeBreak ? 1 : 0) + ((useChannel and useChannelBounce) ? 1 : 0)
    int trendFiredBuy = (trendBuyBounceSignal ? 1 : 0) + (trendBuyFakeBreakSignal ? 1 : 0) + (channelBuyBounceSignal ? 1 : 0)
    int trendFiredSell = (trendSellBounceSignal ? 1 : 0) + (trendSellFakeBreakSignal ? 1 : 0) + (channelSellBounceSignal ? 1 : 0)
    trendEntryBuy  := trendEnabledCount > 0 and (trendEntryMode == "All" ? trendFiredBuy  == trendEnabledCount : trendFiredBuy  >= 1)
    trendEntrySell := trendEnabledCount > 0 and (trendEntryMode == "All" ? trendFiredSell == trendEnabledCount : trendFiredSell >= 1)

    // ---- Signal Type / Direction / Rank ----
    bool tl_anyFake     = trendBuyFakeBreakSignal or trendSellFakeBreakSignal
    bool tl_anyChBounce = channelBuyBounceSignal or channelSellBounceSignal
    bool tl_anyTLBounce = trendBuyBounceSignal or trendSellBounceSignal

    trendSignalType := tl_anyFake ? 4 : tl_anyChBounce ? 5 : tl_anyTLBounce ? 1 : 0
    trendDirection := tl_anyFake ? (trendBuyFakeBreakSignal ? 1 : -1) : tl_anyChBounce ? (channelBuyBounceSignal ? 1 : -1) : tl_anyTLBounce ? (trendBuyBounceSignal ? 1 : -1) : 0
    int trendRankBase = tl_highQuality ? 8 : tl_anyChBounce ? 6 : tl_anyFake ? 5 : tl_anyTLBounce ? 2 : (nearUpTrendline or nearDownTrendline) ? 1 : 0
    trendRank := trendRankBase
    if trendRankBase > 0
        int adj = 0
        adj := adj + (selectedTrendlineQuality >= 80 ? 2 : selectedTrendlineQuality >= 60 ? 1 : selectedTrendlineQuality < 40 ? -1 : 0)
        adj := adj + (brokenCountSelected >= 2 ? -2 : 0)
        adj := adj + (touchCountSelected >= 4 ? 2 : 0)
        float selSlopeATR = na(channelSlope) ? na : math.abs(channelSlope) / atr
        adj := adj + ((not na(selSlopeATR) and selSlopeATR >= minSlopeATR and selSlopeATR <= maxSlopeATR) ? 1 : 0)
        trendRank := math.max(0, math.min(10, trendRankBase + adj))

    // ---- 表示 : Trendline / Channel (line.new) ----

    // ---- 表示 : ラベル ----
    // ---- 表示 : デバッグテーブル ----
// --- Trendline 状態管理 (trendEntryBuy/Sell 発火で状態ON、trendStateMaxBars 本で期限切れ) ---
var bool longTrendStateOk  = false
var bool shortTrendStateOk = false
var int  longTrendStateBar  = na
var int  shortTrendStateBar = na

if useTrendWZ and useTrendStateWindow
    if trendEntryBuy
        longTrendStateOk := true
        longTrendStateBar := bar_index
    if trendEntrySell
        shortTrendStateOk := true
        shortTrendStateBar := bar_index
    if longTrendStateOk and not na(longTrendStateBar) and bar_index - longTrendStateBar > trendStateMaxBars
        longTrendStateOk := false
    if shortTrendStateOk and not na(shortTrendStateBar) and bar_index - shortTrendStateBar > trendStateMaxBars
        shortTrendStateOk := false

// トレンド 場所条件 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false。弱ライン NoTrade 込み)
bool longTrendZoneOk =
     not useTrendWZ ? false :
     useTrendStateWindow ? (longTrendStateOk and trendQualityOk and not trendNoTradeLong) : (trendEntryBuy and trendQualityOk and not trendNoTradeLong)
bool shortTrendZoneOk =
     not useTrendWZ ? false :
     useTrendStateWindow ? (shortTrendStateOk and trendQualityOk and not trendNoTradeShort) : (trendEntrySell and trendQualityOk and not trendNoTradeShort)

// ============================================================
//  5b-2f. Accumulation MTF WinZone モジュール (上位足の確定レンジ・場所条件)
// ------------------------------------------------------------
//  D/4H/1H/15M で Accum箱を検知 → 確定後の上限/下限を保持し、5分足で
//    ① 箱上限/下限の反発 (Range) ② 箱ブレイク方向 (Break) を判定する。
//  useAccumWZ=false の時は 関数・ta.*・request.security・描画を一切走らせない。
//  出力: accumLongEventOk / accumShortEventOk → longAccumZoneOk / shortAccumZoneOk
// ============================================================

// Accum コア検知 (for ループ含む。request.security 経由で各TFの足で評価される)
f_accum_core() =>
    float _atr = ta.atr(accumATRLen)
    float _bodyTop = math.max(open, close)
    float _bodyBot = math.min(open, close)
    float _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    float _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    float _rangeNow  = _rangeHigh - _rangeLow
    float _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    float _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    float _endMid   = (open + close) * 0.5
    float _drift    = math.abs(_endMid - _startMid)
    float _rangeShort = ta.highest(_bodyTop, accumRangeLen) - ta.lowest(_bodyBot, accumRangeLen)
    float _rangeBase  = ta.highest(_bodyTop, accumBaseLen)  - ta.lowest(_bodyBot, accumBaseLen)
    bool _condAtr      = _atr > 0 and _rangeNow <= _atr * accumATRMult
    bool _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumBarRatioMax
    bool _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    bool _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumDriftMax
    bool _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun
    [_condAtr, _condBar, _condBalance, _condDrift, _condColorRun, _rangeNow, _drift, _upperCloses, _lowerCloses, _maxBullRun, _maxBearRun, _atr]

// Accum MTF 検知関数 : 各TFで箱を検知・確定し、確定箱の高安/中値/幅/質を返す。
//   返り値: [isAccum, confirmedAvail, lastHigh, lastLow, lastMid, lastWidth, quality]
f_accum_mtf() =>
    [_cAtr, _cBar, _cBal, _cDft, _cCol, _rNow, _drift, _uC, _lC, _mBull, _mBear, _atr] = f_accum_core()
    bool _passAtr = _cAtr or not useAccumATRFilter
    bool _passBar = _cBar or not useAccumRangeFilter
    bool _passBal = _cBal or not useAccumBalanceFilter
    bool _passDft = _cDft or not useAccumDriftFilter
    bool _passCol = _cCol or not useAccumColorRunFilter
    bool _isAccum = _passAtr and _passBar and _passBal and _passDft and _passCol
    float _hiNow = ta.highest(math.max(open, close), accumRangeLen)
    float _loNow = ta.lowest(math.min(open, close),  accumRangeLen)
    bool _newAccum = _isAccum and not nz(_isAccum[1], false)
    bool _endAccum = not _isAccum and nz(_isAccum[1], false)
    var float _runHigh   = na
    var float _runLow    = na
    var float _lastHigh  = na
    var float _lastLow   = na
    var float _lastWidth = na
    if _newAccum
        _runHigh := _hiNow
        _runLow  := _loNow
    if _isAccum
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _runHigh := na(_runHigh) ? _bt : math.max(_runHigh, _bt)
        _runLow  := na(_runLow)  ? _bb : math.min(_runLow,  _bb)
    if _endAccum
        _lastHigh  := _runHigh
        _lastLow   := _runLow
        _lastWidth := _runHigh - _runLow
        _runHigh := na
        _runLow  := na
    // 箱の質 (バランス / ドリフト / 幅ATR比 を 0-100 に集約)
    int _balDiff = math.abs(_uC - _lC)
    int _balRank = _balDiff <= 1 ? 5 : _balDiff <= 2 ? 4 : _balDiff <= 3 ? 3 : _balDiff <= 4 ? 2 : 1
    float _driftRatio = _rNow > 0 ? _drift / _rNow : na
    int _driftRank = na(_driftRatio) ? 0 : _driftRatio <= 0.10 ? 5 : _driftRatio <= 0.20 ? 4 : _driftRatio <= 0.30 ? 3 : _driftRatio <= 0.45 ? 2 : 1
    float _widthRef   = na(_lastWidth) ? (_hiNow - _loNow) : _lastWidth
    float _widthRatio = _atr > 0 ? _widthRef / _atr : na
    int _widthRank = na(_widthRatio) ? 0 : _widthRatio <= 0.8 ? 5 : _widthRatio <= 1.3 ? 4 : _widthRatio <= 1.8 ? 3 : _widthRatio <= 2.4 ? 2 : 1
    float _q = (_cAtr ? 20.0 : 0.0) + _balRank / 5.0 * 25.0 + _widthRank / 5.0 * 25.0 + _driftRank / 5.0 * 30.0
    int _quality = math.round(math.min(100.0, _q))
    float _mid = na(_lastHigh) or na(_lastLow) ? na : (_lastHigh + _lastLow) * 0.5
    bool _confirmedAvail = not na(_lastHigh) and not na(_lastLow)
    [_isAccum, _confirmedAvail, _lastHigh, _lastLow, _mid, _lastWidth, _quality]

// 5分足の確定箱に対する Range/Break 判定。TFごとに独立した連続終値カウンタを持つ。
//   返り値: [rangeLong, rangeShort, breakLong, breakShort, boxActive]
f_tfBoxEval(float bHigh, float bLow, float _atr) =>
    bool _boxActive = not na(bHigh) and not na(bLow)
    float _body   = math.abs(close - open)
    float _range  = high - low
    float _upWick = high - math.max(open, close)
    float _loWick = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    bool _rejLong  = (close > open) or (_loWick >= _body)
    bool _rejShort = (close < open) or (_upWick >= _body)
    // Range : 箱下限/上限に接近 かつ 箱内へ終値回帰 かつ 反発ローソク
    bool _rLong = _boxActive and useAccumRangeEntry and low  <= bLow  + _atr * accumRangeTouchATR and (not useRangeCloseBackInside or close > bLow)  and (not useRangeRejectCandle or _rejLong)
    bool _rShort= _boxActive and useAccumRangeEntry and high >= bHigh - _atr * accumRangeTouchATR and (not useRangeCloseBackInside or close < bHigh) and (not useRangeRejectCandle or _rejShort)
    // Break : 箱を終値で抜けた連続本数を数える (TFごとに独立した状態)
    var int _upRun = 0
    var int _dnRun = 0
    if _boxActive
        _upRun := close > bHigh + _atr * accumBreakCloseBufferATR ? _upRun + 1 : 0
        _dnRun := close < bLow  - _atr * accumBreakCloseBufferATR ? _dnRun + 1 : 0
    else
        _upRun := 0
        _dnRun := 0
    bool _bLong = _boxActive and useAccumBreakEntry and close > bHigh + _atr * accumBreakCloseBufferATR and _upRun >= accumBreakConfirmBars and (not useAccumBreakBodyFilter or _bodyRatio >= accumBreakBodyRatio)
    bool _bShort= _boxActive and useAccumBreakEntry and close < bLow  - _atr * accumBreakCloseBufferATR and _dnRun >= accumBreakConfirmBars and (not useAccumBreakBodyFilter or _bodyRatio >= accumBreakBodyRatio)
    [_rLong, _rShort, _bLong, _bShort, _boxActive]

// 箱までの距離 (Nearest 選択用。箱内なら 0)
f_boxDist(float bHigh, float bLow, float p) =>
    na(bHigh) or na(bLow) ? na : p > bHigh ? p - bHigh : p < bLow ? bLow - p : 0.0

// --- Accum MTF 出力 (if外で初期化) ---
bool  mtfAccumIsForming   = false
bool  accumNoTrade        = false
float selectedAccumHigh   = na
float selectedAccumLow    = na
float selectedAccumMid    = na
float selectedAccumWidth  = na
int   selectedAccumTFCode = 0
bool  accumRangeLongOk    = false
bool  accumRangeShortOk   = false
bool  accumBreakLongOk    = false
bool  accumBreakShortOk   = false
bool  accumLongEventOk    = false
bool  accumShortEventOk   = false

// 状態管理 (var: バー跨ぎで保持。Range/Break を一定本数だけ有効化)
var bool   longAccumStateOk        = false
var bool   shortAccumStateOk       = false
var int    longAccumStateBar       = na
var int    shortAccumStateBar      = na
var string accumMTFLongStateType   = ""
var string accumMTFShortStateType  = ""

if useAccumWZ
    float _atr5 = ta.atr(accumATRLen)
    // --- 各TFで箱を検知 (ONのTFだけ request.security を呼ぶ) ---
    bool  _dIs = false
    bool  _dConf = false
    float _dHi = na
    float _dLo = na
    float _dMid = na
    float _dW = na
    int   _dQ = 0
    if useAccumD
        [_a1, _a2, _a3, _a4, _a5, _a6, _a7] = request.security(syminfo.tickerid, tfAccumD, f_accum_mtf(), lookahead = barmerge.lookahead_off)
        _dIs := _a1
        _dConf := _a2
        _dHi := _a3
        _dLo := _a4
        _dMid := _a5
        _dW := _a6
        _dQ := _a7
    bool  _h4Is = false
    bool  _h4Conf = false
    float _h4Hi = na
    float _h4Lo = na
    float _h4Mid = na
    float _h4W = na
    int   _h4Q = 0
    if useAccum4H
        [_b1, _b2, _b3, _b4, _b5, _b6, _b7] = request.security(syminfo.tickerid, tfAccum4H, f_accum_mtf(), lookahead = barmerge.lookahead_off)
        _h4Is := _b1
        _h4Conf := _b2
        _h4Hi := _b3
        _h4Lo := _b4
        _h4Mid := _b5
        _h4W := _b6
        _h4Q := _b7
    bool  _h1Is = false
    bool  _h1Conf = false
    float _h1Hi = na
    float _h1Lo = na
    float _h1Mid = na
    float _h1W = na
    int   _h1Q = 0
    if useAccum1H
        [_c1, _c2, _c3, _c4, _c5, _c6, _c7] = request.security(syminfo.tickerid, tfAccum1H, f_accum_mtf(), lookahead = barmerge.lookahead_off)
        _h1Is := _c1
        _h1Conf := _c2
        _h1Hi := _c3
        _h1Lo := _c4
        _h1Mid := _c5
        _h1W := _c6
        _h1Q := _c7
    bool  _m15Is = false
    bool  _m15Conf = false
    float _m15Hi = na
    float _m15Lo = na
    float _m15Mid = na
    float _m15W = na
    int   _m15Q = 0
    if useAccum15M
        [_d1, _d2, _d3, _d4, _d5, _d6, _d7] = request.security(syminfo.tickerid, tfAccum15M, f_accum_mtf(), lookahead = barmerge.lookahead_off)
        _m15Is := _d1
        _m15Conf := _d2
        _m15Hi := _d3
        _m15Lo := _d4
        _m15Mid := _d5
        _m15W := _d6
        _m15Q := _d7
    // --- Accum形成中フラグ / NoTrade ---
    mtfAccumIsForming := (useAccumD and _dIs) or (useAccum4H and _h4Is) or (useAccum1H and _h1Is) or (useAccum15M and _m15Is)
    accumNoTrade := useMTFAccumNoTrade and mtfAccumIsForming
    // --- 箱選択 (代表箱 = 表示 & HigherTF/Nearest のシグナル源) ---
    float _selHi = na
    float _selLo = na
    float _selMid = na
    float _selW = na
    int   _selTF = 0
    if accumBoxSelectMode == "HigherTF"
        if useAccumD and _dConf
            _selHi := _dHi
            _selLo := _dLo
            _selMid := _dMid
            _selW := _dW
            _selTF := 4
        else if useAccum4H and _h4Conf
            _selHi := _h4Hi
            _selLo := _h4Lo
            _selMid := _h4Mid
            _selW := _h4W
            _selTF := 3
        else if useAccum1H and _h1Conf
            _selHi := _h1Hi
            _selLo := _h1Lo
            _selMid := _h1Mid
            _selW := _h1W
            _selTF := 2
        else if useAccum15M and _m15Conf
            _selHi := _m15Hi
            _selLo := _m15Lo
            _selMid := _m15Mid
            _selW := _m15W
            _selTF := 1
    else
        // Nearest (All_OR / All_AND の表示箱にもこの代表箱を使う)
        float _best = na
        if useAccumD and _dConf
            float _dst = f_boxDist(_dHi, _dLo, close)
            if not na(_dst) and (na(_best) or _dst < _best)
                _best := _dst
                _selHi := _dHi
                _selLo := _dLo
                _selMid := _dMid
                _selW := _dW
                _selTF := 4
        if useAccum4H and _h4Conf
            float _dst = f_boxDist(_h4Hi, _h4Lo, close)
            if not na(_dst) and (na(_best) or _dst < _best)
                _best := _dst
                _selHi := _h4Hi
                _selLo := _h4Lo
                _selMid := _h4Mid
                _selW := _h4W
                _selTF := 3
        if useAccum1H and _h1Conf
            float _dst = f_boxDist(_h1Hi, _h1Lo, close)
            if not na(_dst) and (na(_best) or _dst < _best)
                _best := _dst
                _selHi := _h1Hi
                _selLo := _h1Lo
                _selMid := _h1Mid
                _selW := _h1W
                _selTF := 2
        if useAccum15M and _m15Conf
            float _dst = f_boxDist(_m15Hi, _m15Lo, close)
            if not na(_dst) and (na(_best) or _dst < _best)
                _best := _dst
                _selHi := _m15Hi
                _selLo := _m15Lo
                _selMid := _m15Mid
                _selW := _m15W
                _selTF := 1
    selectedAccumHigh   := _selHi
    selectedAccumLow    := _selLo
    selectedAccumMid    := _selMid
    selectedAccumWidth  := _selW
    selectedAccumTFCode := _selTF
    // --- 各TFの箱に対する Range/Break 判定 (TFごとに独立状態) ---
    [_dRL,  _dRS,  _dBL,  _dBS,  _dAct]  = f_tfBoxEval(useAccumD   and _dConf   ? _dHi   : na, useAccumD   and _dConf   ? _dLo   : na, _atr5)
    [_h4RL, _h4RS, _h4BL, _h4BS, _h4Act] = f_tfBoxEval(useAccum4H  and _h4Conf  ? _h4Hi  : na, useAccum4H  and _h4Conf  ? _h4Lo  : na, _atr5)
    [_h1RL, _h1RS, _h1BL, _h1BS, _h1Act] = f_tfBoxEval(useAccum1H  and _h1Conf  ? _h1Hi  : na, useAccum1H  and _h1Conf  ? _h1Lo  : na, _atr5)
    [_mRL,  _mRS,  _mBL,  _mBS,  _mAct]  = f_tfBoxEval(useAccum15M and _m15Conf ? _m15Hi : na, useAccum15M and _m15Conf ? _m15Lo : na, _atr5)
    // --- 箱選択モードでシグナルを合成 ---
    bool _rangeLong  = false
    bool _rangeShort = false
    bool _breakLong  = false
    bool _breakShort = false
    if accumBoxSelectMode == "All_OR"
        _rangeLong  := _dRL or _h4RL or _h1RL or _mRL
        _rangeShort := _dRS or _h4RS or _h1RS or _mRS
        _breakLong  := _dBL or _h4BL or _h1BL or _mBL
        _breakShort := _dBS or _h4BS or _h1BS or _mBS
    else if accumBoxSelectMode == "All_AND"
        bool _anyAct = _dAct or _h4Act or _h1Act or _mAct
        _rangeLong  := _anyAct and (not _dAct or _dRL) and (not _h4Act or _h4RL) and (not _h1Act or _h1RL) and (not _mAct or _mRL)
        _rangeShort := _anyAct and (not _dAct or _dRS) and (not _h4Act or _h4RS) and (not _h1Act or _h1RS) and (not _mAct or _mRS)
        _breakLong  := _anyAct and (not _dAct or _dBL) and (not _h4Act or _h4BL) and (not _h1Act or _h1BL) and (not _mAct or _mBL)
        _breakShort := _anyAct and (not _dAct or _dBS) and (not _h4Act or _h4BS) and (not _h1Act or _h1BS) and (not _mAct or _mBS)
    else
        // HigherTF / Nearest : 選択した代表箱(_selTF)のシグナルを使う
        if _selTF == 4
            _rangeLong  := _dRL
            _rangeShort := _dRS
            _breakLong  := _dBL
            _breakShort := _dBS
        else if _selTF == 3
            _rangeLong  := _h4RL
            _rangeShort := _h4RS
            _breakLong  := _h4BL
            _breakShort := _h4BS
        else if _selTF == 2
            _rangeLong  := _h1RL
            _rangeShort := _h1RS
            _breakLong  := _h1BL
            _breakShort := _h1BS
        else if _selTF == 1
            _rangeLong  := _mRL
            _rangeShort := _mRS
            _breakLong  := _mBL
            _breakShort := _mBS
    // --- 利用モード (RangeOnly / BreakOnly / RangeOrBreak) + NoTrade を適用 ---
    bool _rangeAllowed = accumTradeMode == "RangeOnly" or accumTradeMode == "RangeOrBreak"
    bool _breakAllowed = accumTradeMode == "BreakOnly" or accumTradeMode == "RangeOrBreak"
    accumRangeLongOk  := _rangeAllowed and _rangeLong  and not accumNoTrade
    accumRangeShortOk := _rangeAllowed and _rangeShort and not accumNoTrade
    accumBreakLongOk  := _breakAllowed and _breakLong  and not accumNoTrade
    accumBreakShortOk := _breakAllowed and _breakShort and not accumNoTrade
    accumLongEventOk  := accumRangeLongOk  or accumBreakLongOk
    accumShortEventOk := accumRangeShortOk or accumBreakShortOk

// --- Accum MTF 状態管理 (Range/Break のシグナルを accumMTFStateMaxBars 本保持) ---
if useAccumWZ and useAccumMTFStateWindow
    if accumLongEventOk
        longAccumStateOk  := true
        longAccumStateBar := bar_index
        string _pfxL = selectedAccumTFCode == 4 ? "D_" : selectedAccumTFCode == 3 ? "4H_" : selectedAccumTFCode == 2 ? "1H_" : selectedAccumTFCode == 1 ? "15M_" : ""
        accumMTFLongStateType := _pfxL + (accumBreakLongOk ? "break" : "range")
    if accumShortEventOk
        shortAccumStateOk  := true
        shortAccumStateBar := bar_index
        string _pfxS = selectedAccumTFCode == 4 ? "D_" : selectedAccumTFCode == 3 ? "4H_" : selectedAccumTFCode == 2 ? "1H_" : selectedAccumTFCode == 1 ? "15M_" : ""
        accumMTFShortStateType := _pfxS + (accumBreakShortOk ? "break" : "range")
    if longAccumStateOk and not na(longAccumStateBar) and bar_index - longAccumStateBar > accumMTFStateMaxBars
        longAccumStateOk := false
    if shortAccumStateOk and not na(shortAccumStateBar) and bar_index - shortAccumStateBar > accumMTFStateMaxBars
        shortAccumStateOk := false

// Accum 場所条件 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool longAccumZoneOk =
     not useAccumWZ ? false :
     useAccumMTFStateWindow ? longAccumStateOk : accumLongEventOk
bool shortAccumZoneOk =
     not useAccumWZ ? false :
     useAccumMTFStateWindow ? shortAccumStateOk : accumShortEventOk

// ============================================================
//  5b-2g. Head & Shoulders WinZone モジュール (三尊 / 逆三尊 場所条件)
// ------------------------------------------------------------
//  FVG/EMA/BB/水平線/フィボ/トレンド/Accum と並列の WinZone (場所条件)。
//  出力: hsLongWinZone / hsShortWinZone (BUY=逆三尊系 / SELL=三尊系)。
//  ・useHSWZ=false の時は request.security・Pivot・Queue・配列操作・
//    Quality・Retest・Break・Invalidation・描画 を一切実行しない (軽量)。
// ============================================================

// Pivot 間にある反対 Pivot を探す (pure。呼ばれない時は実行されない)
f_findBetween(_vals, _idxs, _lo, _hi) =>
    float _res = na
    if array.size(_vals) > 0
        for i = 0 to array.size(_vals) - 1
            int _id = array.get(_idxs, i)
            if _id > _lo and _id < _hi
                _res := array.get(_vals, i)
    _res

// --- Pivot 配列 (var: 状態保持。宣言はグローバル / 操作は if useHSWZ 内のみ) ---
var array<float> phVals = array.new_float()
var array<int>   phIdx  = array.new_int()
var array<float> plVals = array.new_float()
var array<int>   plIdx  = array.new_int()
var int htfCount     = 0
var int lastPivotDir = 0

// --- Pattern Queue (完成パターン最大5件) ---
var array<float> qSellNeck     = array.new_float()
var array<float> qSellHead     = array.new_float()
var array<float> qSellRS       = array.new_float()
var array<float> qSellLS       = array.new_float()
var array<int>   qSellCreated  = array.new_int()
var array<int>   qSellBreakBar = array.new_int()
var array<bool>  qSellBroke    = array.new_bool()
var array<float> qBuyNeck     = array.new_float()
var array<float> qBuyHead     = array.new_float()
var array<float> qBuyRS       = array.new_float()
var array<float> qBuyLS       = array.new_float()
var array<int>   qBuyCreated  = array.new_int()
var array<int>   qBuyBreakBar = array.new_int()
var array<bool>  qBuyBroke    = array.new_bool()

// --- 最新パターンのスカラ状態 (var) ---
var float sellLeftShoulderHigh  = na
var float sellHeadHigh          = na
var float sellRightShoulderHigh = na
var float necklineSell          = na
var bool  sellPatternFound      = false
var bool  sellBreakDone         = false
var int   sellBreakBar          = na
var float buyLeftShoulderLow  = na
var float buyHeadLow          = na
var float buyRightShoulderLow = na
var float necklineBuy         = na
var bool  buyPatternFound     = false
var bool  buyBreakDone        = false
var int   buyBreakBar         = na
var float bsSellHead = na
var float bsSellLS   = na
var bool  sellRSBuilding = false
var float bsBuyHead = na
var float bsBuyLS   = na
var bool  buyRSBuilding = false

// --- H&S 出力 (if外で初期化) ---
bool hsSellPattern      = false
bool hsBuyPattern       = false
bool hsSellBreak        = false
bool hsBuyBreak         = false
bool hsSellRetest       = false
bool hsBuyRetest        = false
bool hsSellInvalidation = false
bool hsBuyInvalidation  = false
bool hsBiasLong         = false
bool hsBiasShort        = false
bool hsNoTrade          = false
bool hsLongEventOk      = false
bool hsShortEventOk     = false
string hsLongEventType  = ""
string hsShortEventType = ""

if useHSWZ
    float atrHS = ta.atr(retestAtrLen)
    float retestRange = atrHS * retestAtrMult
    // --- HTF Pivot (確定後のみ / lookahead_off) ---
    [htfPh, htfPl, htfClose, htfHigh, htfLow, htfTime] = request.security(syminfo.tickerid, patternTf, [ta.pivothigh(hsPivotLen, hsPivotLen), ta.pivotlow(hsPivotLen, hsPivotLen), close[1], high[1], low[1], time], lookahead = barmerge.lookahead_off)
    bool newHTF = na(htfTime[1]) ? false : htfTime != htfTime[1]
    // バー内イベントフラグ
    bool sellRSFailEventHTF = false
    bool buyRSFailEventHTF  = false
    // --- パターン検出 (newHTF 時) ---
    if newHTF
        htfCount := htfCount + 1
        int _pIdx = htfCount - hsPivotLen
        if not na(htfPh)
            if lastPivotDir == 1 and array.size(phVals) > 0
                int _li = array.size(phVals) - 1
                if htfPh > array.get(phVals, _li)
                    array.set(phVals, _li, htfPh)
                    array.set(phIdx,  _li, _pIdx)
            else
                array.push(phVals, htfPh)
                array.push(phIdx,  _pIdx)
                lastPivotDir := 1
                while array.size(phVals) > 10
                    array.shift(phVals)
                    array.shift(phIdx)
        if not na(htfPl)
            if lastPivotDir == -1 and array.size(plVals) > 0
                int _li = array.size(plVals) - 1
                if htfPl < array.get(plVals, _li)
                    array.set(plVals, _li, htfPl)
                    array.set(plIdx,  _li, _pIdx)
            else
                array.push(plVals, htfPl)
                array.push(plIdx,  _pIdx)
                lastPivotDir := -1
                while array.size(plVals) > 10
                    array.shift(plVals)
                    array.shift(plIdx)
        // 三尊 (直近3つの PH)
        int nH = array.size(phVals)
        if nH >= 3
            float lsN = array.get(phVals, nH - 3)
            float hdN = array.get(phVals, nH - 2)
            float rsN = array.get(phVals, nH - 1)
            int lsNI = array.get(phIdx, nH - 3)
            int hdNI = array.get(phIdx, nH - 2)
            int rsNI = array.get(phIdx, nH - 1)
            float nl1 = f_findBetween(plVals, plIdx, lsNI, hdNI)
            float nl2 = f_findBetween(plVals, plIdx, hdNI, rsNI)
            bool promOk = not useHeadProm or (hdN - math.max(lsN, rsN)) > atrHS * headPromMult
            bool symOk  = math.abs(lsN - rsN) / hdN <= shoulderTolerancePct
            bool headHi = hdN > lsN and hdN > rsN
            if headHi and symOk and promOk and not na(nl1) and not na(nl2)
                array.push(qSellNeck, (nl1 + nl2) / 2.0)
                array.push(qSellHead, hdN)
                array.push(qSellRS, rsN)
                array.push(qSellLS, lsN)
                array.push(qSellCreated, bar_index)
                array.push(qSellBreakBar, -1)
                array.push(qSellBroke, false)
                if array.size(qSellNeck) > 5
                    array.shift(qSellNeck)
                    array.shift(qSellHead)
                    array.shift(qSellRS)
                    array.shift(qSellLS)
                    array.shift(qSellCreated)
                    array.shift(qSellBreakBar)
                    array.shift(qSellBroke)
            else if headHi and not symOk
                sellRSFailEventHTF := true
        // 逆三尊 (直近3つの PL)
        int nL = array.size(plVals)
        if nL >= 3
            float lsbN = array.get(plVals, nL - 3)
            float hdbN = array.get(plVals, nL - 2)
            float rsbN = array.get(plVals, nL - 1)
            int lsbNI = array.get(plIdx, nL - 3)
            int hdbNI = array.get(plIdx, nL - 2)
            int rsbNI = array.get(plIdx, nL - 1)
            float nh1 = f_findBetween(phVals, phIdx, lsbNI, hdbNI)
            float nh2 = f_findBetween(phVals, phIdx, hdbNI, rsbNI)
            bool promOkB = not useHeadProm or (math.min(lsbN, rsbN) - hdbN) > atrHS * headPromMult
            bool symOkB  = math.abs(lsbN - rsbN) / hdbN <= shoulderTolerancePct
            bool headLo  = hdbN < lsbN and hdbN < rsbN
            if headLo and symOkB and promOkB and not na(nh1) and not na(nh2)
                array.push(qBuyNeck, (nh1 + nh2) / 2.0)
                array.push(qBuyHead, hdbN)
                array.push(qBuyRS, rsbN)
                array.push(qBuyLS, lsbN)
                array.push(qBuyCreated, bar_index)
                array.push(qBuyBreakBar, -1)
                array.push(qBuyBroke, false)
                if array.size(qBuyNeck) > 5
                    array.shift(qBuyNeck)
                    array.shift(qBuyHead)
                    array.shift(qBuyRS)
                    array.shift(qBuyLS)
                    array.shift(qBuyCreated)
                    array.shift(qBuyBreakBar)
                    array.shift(qBuyBroke)
            else if headLo and not symOkB
                buyRSFailEventHTF := true
        // 右肩形成中 (SELL)
        int nHs = array.size(phVals)
        float fHead = na
        int   fHeadI = na
        if nHs > 0
            for i = 0 to nHs - 1
                float v = array.get(phVals, i)
                if na(fHead) or v > fHead
                    fHead := v
                    fHeadI := array.get(phIdx, i)
        float fLS = na
        if nHs > 0 and not na(fHeadI)
            for i = 0 to nHs - 1
                int idx = array.get(phIdx, i)
                float v = array.get(phVals, i)
                if idx < fHeadI and v < fHead
                    if na(fLS) or v > fLS
                        fLS := v
        if not na(fHead) and not na(fLS)
            bsSellHead := fHead
            bsSellLS := fLS
            sellRSBuilding := true
        else
            sellRSBuilding := false
        // 右肩形成中 (BUY)
        int nLs = array.size(plVals)
        float fHeadB = na
        int   fHeadBI = na
        if nLs > 0
            for i = 0 to nLs - 1
                float v = array.get(plVals, i)
                if na(fHeadB) or v < fHeadB
                    fHeadB := v
                    fHeadBI := array.get(plIdx, i)
        float fLSB = na
        if nLs > 0 and not na(fHeadBI)
            for i = 0 to nLs - 1
                int idx = array.get(plIdx, i)
                float v = array.get(plVals, i)
                if idx < fHeadBI and v > fHeadB
                    if na(fLSB) or v < fLSB
                        fLSB := v
        if not na(fHeadB) and not na(fLSB)
            bsBuyHead := fHeadB
            bsBuyLS := fLSB
            buyRSBuilding := true
        else
            buyRSBuilding := false
    // --- Queue: Break / Retest / 期限切れ (SELL) ---
    bool sellBreakEvent   = false
    bool sellRetestEvent  = false
    bool sellExpiredEvent = false
    if array.size(qSellNeck) > 0
        int i = array.size(qSellNeck) - 1
        while i >= 0
            float nk = array.get(qSellNeck, i)
            bool broke = array.get(qSellBroke, i)
            int createdB = array.get(qSellCreated, i)
            int brokeB = array.get(qSellBreakBar, i)
            bool remove = false
            if not broke
                if not na(htfClose) and htfClose < nk
                    array.set(qSellBroke, i, true)
                    array.set(qSellBreakBar, i, bar_index)
                    sellBreakEvent := true
                else if bar_index - createdB > setupValidBars
                    remove := true
                    sellExpiredEvent := true
            else
                if high >= nk - retestRange and close <= nk + retestRange
                    sellRetestEvent := true
                if bar_index - brokeB > setupValidBars
                    remove := true
            if remove
                array.remove(qSellNeck, i)
                array.remove(qSellHead, i)
                array.remove(qSellRS, i)
                array.remove(qSellLS, i)
                array.remove(qSellCreated, i)
                array.remove(qSellBreakBar, i)
                array.remove(qSellBroke, i)
            i := i - 1
    // --- Queue: Break / Retest / 期限切れ (BUY) ---
    bool buyBreakEvent   = false
    bool buyRetestEvent  = false
    bool buyExpiredEvent = false
    if array.size(qBuyNeck) > 0
        int i = array.size(qBuyNeck) - 1
        while i >= 0
            float nk = array.get(qBuyNeck, i)
            bool broke = array.get(qBuyBroke, i)
            int createdB = array.get(qBuyCreated, i)
            int brokeB = array.get(qBuyBreakBar, i)
            bool remove = false
            if not broke
                if not na(htfClose) and htfClose > nk
                    array.set(qBuyBroke, i, true)
                    array.set(qBuyBreakBar, i, bar_index)
                    buyBreakEvent := true
                else if bar_index - createdB > setupValidBars
                    remove := true
                    buyExpiredEvent := true
            else
                if low <= nk + retestRange and close >= nk - retestRange
                    buyRetestEvent := true
                if bar_index - brokeB > setupValidBars
                    remove := true
            if remove
                array.remove(qBuyNeck, i)
                array.remove(qBuyHead, i)
                array.remove(qBuyRS, i)
                array.remove(qBuyLS, i)
                array.remove(qBuyCreated, i)
                array.remove(qBuyBreakBar, i)
                array.remove(qBuyBroke, i)
            i := i - 1
    // --- H&S 否定 (最新の未ブレイクパターンを消費 / 逆方向 Bias) ---
    if useHSInvalidation and array.size(qSellNeck) > 0
        int li = array.size(qSellNeck) - 1
        if not array.get(qSellBroke, li)
            float rs = array.get(qSellRS, li)
            if not na(rs) and close > rs + atrHS * invalidationAtrMult
                hsSellInvalidation := true
                array.remove(qSellNeck, li)
                array.remove(qSellHead, li)
                array.remove(qSellRS, li)
                array.remove(qSellLS, li)
                array.remove(qSellCreated, li)
                array.remove(qSellBreakBar, li)
                array.remove(qSellBroke, li)
    if useHSInvalidation and array.size(qBuyNeck) > 0
        int li = array.size(qBuyNeck) - 1
        if not array.get(qBuyBroke, li)
            float rs = array.get(qBuyRS, li)
            if not na(rs) and close < rs - atrHS * invalidationAtrMult
                hsBuyInvalidation := true
                array.remove(qBuyNeck, li)
                array.remove(qBuyHead, li)
                array.remove(qBuyRS, li)
                array.remove(qBuyLS, li)
                array.remove(qBuyCreated, li)
                array.remove(qBuyBreakBar, li)
                array.remove(qBuyBroke, li)
    // --- 右肩崩れ (頭更新 or 肩許容率超え) ---
    bool sellPriceFail = sellRSBuilding and not na(bsSellHead) and high > bsSellHead + atrHS * invalidationAtrMult
    bool buyPriceFail  = buyRSBuilding and not na(bsBuyHead) and low < bsBuyHead - atrHS * invalidationAtrMult
    bool hsRSFailedSell = sellPriceFail or sellRSFailEventHTF
    bool hsRSFailedBuy  = buyPriceFail or buyRSFailEventHTF
    if hsRSFailedSell
        sellRSBuilding := false
        bsSellHead := na
        bsSellLS := na
    if hsRSFailedBuy
        buyRSBuilding := false
        bsBuyHead := na
        bsBuyLS := na
    // --- 最新パターンのスカラ状態へ同期 ---
    int nSellQ = array.size(qSellNeck)
    sellPatternFound := nSellQ > 0
    if nSellQ > 0
        int li = nSellQ - 1
        necklineSell          := array.get(qSellNeck, li)
        sellHeadHigh          := array.get(qSellHead, li)
        sellLeftShoulderHigh  := array.get(qSellLS, li)
        sellRightShoulderHigh := array.get(qSellRS, li)
        sellBreakDone         := array.get(qSellBroke, li)
        int bb = array.get(qSellBreakBar, li)
        sellBreakBar          := bb < 0 ? na : bb
    else
        necklineSell          := na
        sellHeadHigh          := na
        sellLeftShoulderHigh  := na
        sellRightShoulderHigh := na
        sellBreakDone         := false
    int nBuyQ = array.size(qBuyNeck)
    buyPatternFound := nBuyQ > 0
    if nBuyQ > 0
        int li = nBuyQ - 1
        necklineBuy         := array.get(qBuyNeck, li)
        buyHeadLow          := array.get(qBuyHead, li)
        buyLeftShoulderLow  := array.get(qBuyLS, li)
        buyRightShoulderLow := array.get(qBuyRS, li)
        buyBreakDone        := array.get(qBuyBroke, li)
        int bb = array.get(qBuyBreakBar, li)
        buyBreakBar         := bb < 0 ? na : bb
    else
        necklineBuy         := na
        buyHeadLow          := na
        buyLeftShoulderLow  := na
        buyRightShoulderLow := na
        buyBreakDone        := false
    // Break / Retest 集約
    hsSellBreak  := sellBreakEvent
    hsBuyBreak   := buyBreakEvent
    hsSellRetest := sellRetestEvent
    hsBuyRetest  := buyRetestEvent
    // --- Legacy 型 (左肩戻り型) ---
    float rsCandHigh = math.max(high, high[1])
    float rsCandLow  = math.min(low, low[1])
    bool retSell = not na(sellLeftShoulderHigh) and math.abs(rsCandHigh - sellLeftShoulderHigh) / sellLeftShoulderHigh <= shoulderTolerancePct
    bool retBuy  = not na(buyLeftShoulderLow) and math.abs(rsCandLow - buyLeftShoulderLow) / buyLeftShoulderLow <= shoulderTolerancePct
    bool headOkSell = not na(sellHeadHigh) and high <= sellHeadHigh
    bool headOkBuy  = not na(buyHeadLow) and low >= buyHeadLow
    bool headPromOkSell = not useHeadProm or (not na(sellHeadHigh) and not na(sellLeftShoulderHigh) and (sellHeadHigh - sellLeftShoulderHigh) > atrHS * headPromMult)
    bool headPromOkBuy  = not useHeadProm or (not na(buyHeadLow) and not na(buyLeftShoulderLow) and (buyLeftShoulderLow - buyHeadLow) > atrHS * headPromMult)
    bool hsSellLegacy = headOkSell and retSell and headPromOkSell
    bool hsBuyLegacy  = headOkBuy and retBuy and headPromOkBuy
    // --- WinZone イベント (パターン別) ---
    bool hsBuyPatternWZ = buyPatternFound
    bool hsSellPatternWZ = sellPatternFound
    bool hsBuyBreakWZ  = buyBreakEvent
    bool hsSellBreakWZ = sellBreakEvent
    bool hsBuyRetestWZ  = buyRetestEvent
    bool hsSellRetestWZ = sellRetestEvent
    // 否定は逆方向: 三尊否定=BUY / 逆三尊否定=SELL
    bool hsBuyInvalWZ  = hsSellInvalidation
    bool hsSellInvalWZ = hsBuyInvalidation
    // Legacy モード対応 (hsMode==Legacy の時は Pattern/Any に Legacy を混ぜる)
    bool hsBuyLegacyOk  = hsMode == "Legacy" and hsBuyLegacy
    bool hsSellLegacyOk = hsMode == "Legacy" and hsSellLegacy
    // 出力フラグ (パターン/否定)
    hsSellPattern := sellPatternFound
    hsBuyPattern  := buyPatternFound
    // Bias = 全イベントの論理和
    hsBiasLong  := hsBuyPatternWZ or hsBuyBreakWZ or hsBuyRetestWZ or hsBuyInvalWZ or hsBuyLegacyOk
    hsBiasShort := hsSellPatternWZ or hsSellBreakWZ or hsSellRetestWZ or hsSellInvalWZ or hsSellLegacyOk
    // --- NoTrade (両パターン競合 / 期限切れ / 右肩崩れ) ---
    bool rConflict = hsSellPattern and hsBuyPattern
    bool rExpired  = sellExpiredEvent or buyExpiredEvent
    bool rFailedRS = hsRSFailedSell or hsRSFailedBuy
    hsNoTrade := rConflict or rExpired or rFailedRS
    // --- WinZone モード選択 (Pattern/Break/Retest/Invalidation/Any) + NoTrade ---
    bool _longSel  = hsWinZoneMode == "Pattern" ? hsBuyPatternWZ : hsWinZoneMode == "Break" ? hsBuyBreakWZ : hsWinZoneMode == "Retest" ? hsBuyRetestWZ : hsWinZoneMode == "Invalidation" ? hsBuyInvalWZ : hsBiasLong
    bool _shortSel = hsWinZoneMode == "Pattern" ? hsSellPatternWZ : hsWinZoneMode == "Break" ? hsSellBreakWZ : hsWinZoneMode == "Retest" ? hsSellRetestWZ : hsWinZoneMode == "Invalidation" ? hsSellInvalWZ : hsBiasShort
    hsLongEventOk  := _longSel  and not hsNoTrade
    hsShortEventOk := _shortSel and not hsNoTrade
    hsLongEventType  := hsWinZoneMode == "Any" ? (hsBuyRetestWZ ? "Retest" : hsBuyBreakWZ ? "Break" : hsBuyInvalWZ ? "Invalidation" : "Pattern") : hsWinZoneMode
    hsShortEventType := hsWinZoneMode == "Any" ? (hsSellRetestWZ ? "Retest" : hsSellBreakWZ ? "Break" : hsSellInvalWZ ? "Invalidation" : "Pattern") : hsWinZoneMode

// --- H&S 状態管理 (FVG/EMA/BB/水平線/フィボ/Accum と同思想) ---
var bool   hsLongState      = false
var bool   hsShortState     = false
var int    hsLongStateBar   = na
var int    hsShortStateBar  = na
var string hsLongStateType  = ""
var string hsShortStateType = ""

if useHSWZ and useHSStateWindow
    if hsLongEventOk
        hsLongState     := true
        hsLongStateBar  := bar_index
        hsLongStateType := hsLongEventType
    if hsShortEventOk
        hsShortState     := true
        hsShortStateBar  := bar_index
        hsShortStateType := hsShortEventType
    if hsLongState and not na(hsLongStateBar) and bar_index - hsLongStateBar > hsStateMaxBars
        hsLongState := false
    if hsShortState and not na(hsShortStateBar) and bar_index - hsShortStateBar > hsStateMaxBars
        hsShortState := false

// H&S WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool hsLongWinZone  = useHSWZ ? (useHSStateWindow ? hsLongState  : hsLongEventOk)  : false
bool hsShortWinZone = useHSWZ ? (useHSStateWindow ? hsShortState : hsShortEventOk) : false

// ============================================================
//  5b-2h. Wedge (ウェッジ) WinZone モジュール
// ------------------------------------------------------------
//  Bear Wedge(Rising)=下限割れSELL / Bull Wedge(Falling)=上限抜けBUY。
//  Pattern/Break/Retest/Invalidation/Building を場所条件として判定。
//  FVG/EMA/BB/水平線/フィボ/トレンド/Accum/H&S/Pivot と並列。
//  useWedgeWZ=false の時は if に入らず request.security/ta.atr/sma/pivot/
//  配列/判定/状態管理 を一切実行しない。出力 wedgeLongWinZone/wedgeShortWinZone。
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
f_wedgeLinePrice(int _x1, float _y1, int _x2, float _y2, int _xNow) =>
    float _res = na
    if _x2 != _x1
        float _slope = (_y2 - _y1) / (_x2 - _x1)
        _res := _y1 + _slope * (_xNow - _x1)
    _res

f_wedgeSlope(int _x1, float _y1, int _x2, float _y2) =>
    _x2 != _x1 ? (_y2 - _y1) / (_x2 - _x1) : na

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool wedgeEventLong    = false
bool wedgeEventShort   = false
bool wedgeBiasLong     = false
bool wedgeBiasShort    = false
bool wedgeNoTrade      = false
bool wedgeNoTradeLong  = false
bool wedgeNoTradeShort = false
int  wedgeSignalType   = 0
int  wedgeDirection    = 0
bool wedgeLongEventOk  = false
bool wedgeShortEventOk = false

if useWedgeWZ
    // ---- 共通計算 ----
    float wedgeAtrV = ta.atr(wedgeRetestAtrLen)
    float wedgeRetestRange = wedgeAtrV * wedgeRetestAtrMult

    // ---- HTF Pivot 取得 (確定後のみ / lookahead_off) ----
    [htfPh, htfPl, htfClose, htfTime] = request.security(syminfo.tickerid, wedgePatternTf, [ta.pivothigh(wedgePivotLen, wedgePivotLen), ta.pivotlow(wedgePivotLen, wedgePivotLen), close[1], time], lookahead = barmerge.lookahead_off)
    bool wedgeNewHTF = na(htfTime[1]) ? false : htfTime != htfTime[1]

    // ---- Pivot 配列 ----
    var array<float> wedgePhVals = array.new_float()
    var array<int>   wedgePhIdx  = array.new_int()
    var array<float> wedgePlVals = array.new_float()
    var array<int>   wedgePlIdx  = array.new_int()
    var int wedgeHtfCount = 0
    var int wedgeLastDir  = 0

    // ---- Wedge 幾何 / パターン状態 ----
    var float wedgeUpperNow = na
    var float wedgeLowerNow = na
    var float wedgeUpSlope  = na
    var float wedgeLoSlope  = na
    var float wedgeWStart   = na
    var float wedgeWNow     = na
    var int   wedgeBarsV    = 0
    var bool  bearWedgeFound = false
    var bool  bearBreakDone  = false
    var bool  bearInvalidated = false
    var int   bearPatternBar = na
    var int   bearBreakBar   = na
    var bool  bearBuildingV  = false
    var bool  bullWedgeFound = false
    var bool  bullBreakDone  = false
    var bool  bullInvalidated = false
    var int   bullPatternBar = na
    var int   bullBreakBar   = na
    var bool  bullBuildingV  = false

    // バー内イベント
    bool bearFailHTF = false
    bool bullFailHTF = false
    bool bearExpiredEvent = false
    bool bullExpiredEvent = false

    // ---- Pivot push + Wedge 検出 (wedgeNewHTF 時) ----
    if wedgeNewHTF
        wedgeHtfCount := wedgeHtfCount + 1
        int _pIdx = wedgeHtfCount - wedgePivotLen
        if not na(htfPh)
            if wedgeLastDir == 1 and array.size(wedgePhVals) > 0
                int _li = array.size(wedgePhVals) - 1
                if htfPh > array.get(wedgePhVals, _li)
                    array.set(wedgePhVals, _li, htfPh)
                    array.set(wedgePhIdx,  _li, _pIdx)
            else
                array.push(wedgePhVals, htfPh)
                array.push(wedgePhIdx,  _pIdx)
                wedgeLastDir := 1
                while array.size(wedgePhVals) > wedgeMaxLookback
                    array.shift(wedgePhVals)
                    array.shift(wedgePhIdx)
        if not na(htfPl)
            if wedgeLastDir == -1 and array.size(wedgePlVals) > 0
                int _li = array.size(wedgePlVals) - 1
                if htfPl < array.get(wedgePlVals, _li)
                    array.set(wedgePlVals, _li, htfPl)
                    array.set(wedgePlIdx,  _li, _pIdx)
            else
                array.push(wedgePlVals, htfPl)
                array.push(wedgePlIdx,  _pIdx)
                wedgeLastDir := -1
                while array.size(wedgePlVals) > wedgeMaxLookback
                    array.shift(wedgePlVals)
                    array.shift(wedgePlIdx)

        int nH = array.size(wedgePhVals)
        int nL = array.size(wedgePlVals)
        if nH >= 2 and nL >= 2
            float h1v = array.get(wedgePhVals, nH - 2)
            float h2v = array.get(wedgePhVals, nH - 1)
            int   h1x = array.get(wedgePhIdx, nH - 2)
            int   h2x = array.get(wedgePhIdx, nH - 1)
            float l1v = array.get(wedgePlVals, nL - 2)
            float l2v = array.get(wedgePlVals, nL - 1)
            int   l1x = array.get(wedgePlIdx, nL - 2)
            int   l2x = array.get(wedgePlIdx, nL - 1)
            int xNow = wedgeHtfCount
            int startX = math.min(h1x, l1x)
            wedgeUpSlope := f_wedgeSlope(h1x, h1v, h2x, h2v)
            wedgeLoSlope := f_wedgeSlope(l1x, l1v, l2x, l2v)
            wedgeUpperNow := f_wedgeLinePrice(h1x, h1v, h2x, h2v, xNow)
            wedgeLowerNow := f_wedgeLinePrice(l1x, l1v, l2x, l2v, xNow)
            float upStart = f_wedgeLinePrice(h1x, h1v, h2x, h2v, startX)
            float loStart = f_wedgeLinePrice(l1x, l1v, l2x, l2v, startX)
            wedgeWNow := wedgeUpperNow - wedgeLowerNow
            wedgeWStart := upStart - loStart
            wedgeBarsV := xNow - startX

            bool conv = not na(wedgeWStart) and wedgeWStart > 0 and wedgeWNow <= wedgeWStart * wedgeContractionRatio
            bool convStart = not na(wedgeWStart) and wedgeWNow < wedgeWStart
            bool barsOk = wedgeBarsV >= minWedgeBars and wedgeBarsV <= maxWedgeBars
            bool slopeOkU = not na(wedgeUpSlope) and math.abs(wedgeUpSlope) * wedgeBarsV >= wedgeAtrV * wedgeMinSlopeAtrMult
            bool slopeOkL = not na(wedgeLoSlope) and math.abs(wedgeLoSlope) * wedgeBarsV >= wedgeAtrV * wedgeMinSlopeAtrMult
            bool risingShape  = wedgeUpSlope > 0 and wedgeLoSlope > 0 and wedgeLoSlope > wedgeUpSlope
            bool fallingShape = wedgeUpSlope < 0 and wedgeLoSlope < 0 and wedgeUpSlope < wedgeLoSlope
            // Pattern成立にも最低Pivotタッチ数を要求 (両サイド wedgeMinTouches 以上)
            bool touchesOk = array.size(wedgePhVals) >= wedgeMinTouches and array.size(wedgePlVals) >= wedgeMinTouches
            bool bearOk = risingShape and conv and barsOk and slopeOkU and slopeOkL and touchesOk
            bool bullOk = fallingShape and conv and barsOk and slopeOkU and slopeOkL and touchesOk

            if bearOk and not bearWedgeFound
                bearWedgeFound := true
                bearBreakDone := false
                bearInvalidated := false
                bearPatternBar := bar_index
                bearBuildingV := false
                bullWedgeFound := false
                bullBuildingV := false
            else if bullOk and not bullWedgeFound
                bullWedgeFound := true
                bullBreakDone := false
                bullInvalidated := false
                bullPatternBar := bar_index
                bullBuildingV := false
                bearWedgeFound := false
                bearBuildingV := false
            else
                if wedgeUpSlope > 0 and wedgeLoSlope > 0 and convStart and not bearWedgeFound
                    bearBuildingV := true
                else if bearBuildingV
                    if wedgeLoSlope <= wedgeUpSlope or (not na(wedgeWStart) and wedgeWNow >= wedgeWStart) or wedgeBarsV > maxWedgeBars
                        bearFailHTF := true
                if wedgeUpSlope < 0 and wedgeLoSlope < 0 and convStart and not bullWedgeFound
                    bullBuildingV := true
                else if bullBuildingV
                    if wedgeUpSlope >= wedgeLoSlope or (not na(wedgeWStart) and wedgeWNow >= wedgeWStart) or wedgeBarsV > maxWedgeBars
                        bullFailHTF := true

    // ---- Wedge 崩れ ----
    bool bearPriceFail = bearBuildingV and not na(wedgeUpperNow) and high > wedgeUpperNow + wedgeAtrV * wedgeInvalidationAtrMult
    bool bullPriceFail = bullBuildingV and not na(wedgeLowerNow) and low < wedgeLowerNow - wedgeAtrV * wedgeInvalidationAtrMult
    bool bearWedgeFailed = bearPriceFail or bearFailHTF
    bool bullWedgeFailed = bullPriceFail or bullFailHTF
    if bearWedgeFailed
        bearBuildingV := false
    if bullWedgeFailed
        bullBuildingV := false

    bool bearWedgeBuilding = bearBuildingV and not bearWedgeFailed
    bool bullWedgeBuilding = bullBuildingV and not bullWedgeFailed

    // ---- Wedge 否定 / ブレイク (状態更新) ----
    bool bearWedgeInvalidation = useWedgeInvalidation and bearWedgeFound and not bearBreakDone and not na(wedgeUpperNow) and close > wedgeUpperNow + wedgeAtrV * wedgeInvalidationAtrMult
    bool bullWedgeInvalidation = useWedgeInvalidation and bullWedgeFound and not bullBreakDone and not na(wedgeLowerNow) and close < wedgeLowerNow - wedgeAtrV * wedgeInvalidationAtrMult
    bool bearWedgeBreak = bearWedgeFound and not bearBreakDone and not na(wedgeLowerNow) and not na(htfClose) and htfClose < wedgeLowerNow - wedgeAtrV * wedgeLineBreakAtrMult
    bool bullWedgeBreak = bullWedgeFound and not bullBreakDone and not na(wedgeUpperNow) and not na(htfClose) and htfClose > wedgeUpperNow + wedgeAtrV * wedgeLineBreakAtrMult
    if bearWedgeInvalidation
        bearInvalidated := true
        bearWedgeFound := false
    if bullWedgeInvalidation
        bullInvalidated := true
        bullWedgeFound := false
    if bearWedgeBreak and not bearWedgeInvalidation
        bearBreakDone := true
        bearBreakBar  := bar_index
    if bullWedgeBreak and not bullWedgeInvalidation
        bullBreakDone := true
        bullBreakBar  := bar_index
    if bearWedgeFound and bearBreakDone and not na(bearBreakBar) and (bar_index - bearBreakBar > wedgeSetupValidBars)
        bearWedgeFound := false
        bearBreakDone  := false
        bearExpiredEvent := true
    else if bearWedgeFound and not bearBreakDone and not na(bearPatternBar) and (bar_index - bearPatternBar > wedgeSetupValidBars)
        bearWedgeFound := false
        bearExpiredEvent := true
    if bullWedgeFound and bullBreakDone and not na(bullBreakBar) and (bar_index - bullBreakBar > wedgeSetupValidBars)
        bullWedgeFound := false
        bullBreakDone  := false
        bullExpiredEvent := true
    else if bullWedgeFound and not bullBreakDone and not na(bullPatternBar) and (bar_index - bullPatternBar > wedgeSetupValidBars)
        bullWedgeFound := false
        bullExpiredEvent := true

    // ---- Retest ----
    bool bearSetupValid = bearWedgeFound and bearBreakDone and not na(bearBreakBar) and (bar_index - bearBreakBar <= wedgeSetupValidBars)
    bool bullSetupValid = bullWedgeFound and bullBreakDone and not na(bullBreakBar) and (bar_index - bullBreakBar <= wedgeSetupValidBars)
    bool bearWedgeRetest = bearSetupValid and not na(wedgeLowerNow) and high >= wedgeLowerNow - wedgeRetestRange and close <= wedgeLowerNow + wedgeRetestRange
    bool bullWedgeRetest = bullSetupValid and not na(wedgeUpperNow) and low <= wedgeUpperNow + wedgeRetestRange and close >= wedgeUpperNow - wedgeRetestRange

    bool bearWedgePattern = bearWedgeFound
    bool bullWedgePattern = bullWedgeFound

    // ---- Signal 判定 ----
    bool bearWedgeBreakSignal  = bearWedgeBreak
    bool bearWedgeRetestSignal = bearWedgeRetest
    bool bullWedgeBreakSignal  = bullWedgeBreak
    bool bullWedgeRetestSignal = bullWedgeRetest
    // 否定は逆方向 Bias
    bool bullByWedgeInvalidation = bearWedgeInvalidation
    bool bearByWedgeInvalidation = bullWedgeInvalidation

    // ---- Bias / Entry イベント (状態ON対象: Break/Retest/Invalidation のみ) ----
    wedgeBiasLong  := bullWedgeBreakSignal or bullWedgeRetestSignal or bullByWedgeInvalidation
    wedgeBiasShort := bearWedgeBreakSignal or bearWedgeRetestSignal or bearByWedgeInvalidation
    wedgeEventLong  := wedgeEntryMode == "InvalidationOnly" ? bullByWedgeInvalidation : wedgeEntryMode == "BreakOnly" ? bullWedgeBreakSignal : wedgeEntryMode == "RetestOnly" ? bullWedgeRetestSignal : wedgeBiasLong
    wedgeEventShort := wedgeEntryMode == "InvalidationOnly" ? bearByWedgeInvalidation : wedgeEntryMode == "BreakOnly" ? bearWedgeBreakSignal : wedgeEntryMode == "RetestOnly" ? bearWedgeRetestSignal : wedgeBiasShort

    // ---- NoTrade (両ウェッジ競合 / 期限切れ / 崩れ / 否定) ----
    bool rConflict = bearWedgePattern and bullWedgePattern
    bool rExpired  = bearExpiredEvent or bullExpiredEvent
    bool rFailed   = bearWedgeFailed or bullWedgeFailed
    bool rInval    = bearWedgeInvalidation or bullWedgeInvalidation
    // wedgeNoTrade (情報用) は全要因。Entry禁止用 (Long/Short) は Conflict のみ。
    wedgeNoTrade      := rConflict or rExpired or rFailed or rInval
    wedgeNoTradeLong  := rConflict
    wedgeNoTradeShort := rConflict

    // ---- Signal Type / Direction ----
    wedgeSignalType := wedgeNoTrade ? 11 : bearWedgeInvalidation ? 7 : bullWedgeInvalidation ? 8 : bearWedgeRetest ? 5 : bullWedgeRetest ? 6 : bearWedgeBreak ? 3 : bullWedgeBreak ? 4 : bearWedgePattern ? 1 : bullWedgePattern ? 2 : bearWedgeBuilding ? 9 : bullWedgeBuilding ? 10 : 0
    wedgeDirection := (wedgeBiasLong and not wedgeBiasShort) ? 1 : (wedgeBiasShort and not wedgeBiasLong) ? -1 : 0

    // ---- WinZone イベント (Entryイベント + NoTrade を差引) ----
    wedgeLongEventOk  := wedgeEventLong  and not wedgeNoTradeLong
    wedgeShortEventOk := wedgeEventShort and not wedgeNoTradeShort

// --- Wedge 状態管理 (FVG/EMA/BB/水平線/フィボ/Accum/H&S/Pivot と同思想) ---
var bool wedgeLongState  = false
var bool wedgeShortState = false
var int  wedgeLongStateBar  = na
var int  wedgeShortStateBar = na

if useWedgeWZ and useWedgeStateWindow
    if wedgeLongEventOk
        wedgeLongState := true
        wedgeLongStateBar := bar_index
    if wedgeShortEventOk
        wedgeShortState := true
        wedgeShortStateBar := bar_index
    if wedgeLongState and not na(wedgeLongStateBar) and bar_index - wedgeLongStateBar > wedgeStateMaxBars
        wedgeLongState := false
    if wedgeShortState and not na(wedgeShortStateBar) and bar_index - wedgeShortStateBar > wedgeStateMaxBars
        wedgeShortState := false

// Wedge WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool wedgeLongWinZone  = useWedgeWZ ? (useWedgeStateWindow ? wedgeLongState  : wedgeLongEventOk)  : false
bool wedgeShortWinZone = useWedgeWZ ? (useWedgeStateWindow ? wedgeShortState : wedgeShortEventOk) : false

// ============================================================
//  5b-2h. Pivot (クラシックピボット) WinZone モジュール
// ------------------------------------------------------------
//  PP/R1-3/S1-3 の反発 / スイープ反転 / ブレイク→レジサポ転換リテストを
//  場所条件として判定。FVG/EMA/BB/水平線/フィボ/トレンド/Accum/H&S と並列。
//  usePivotWZ=false の時は if に入らず request.security/ta.atr/Pivot計算・
//  探索・判定/状態管理 を一切実行しない。出力 pivotLongWinZone/pivotShortWinZone。
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
// クラシックピボット (前HTF足の H/L/C。lookahead_off で未来参照なし)
f_pivotClassic(tf) =>
    [pH, pL, pC] = request.security(syminfo.tickerid, tf, [high[1], low[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
    float _pp = (pH + pL + pC) / 3.0
    float _r1 = 2.0 * _pp - pL
    float _s1 = 2.0 * _pp - pH
    float _r2 = _pp + (pH - pL)
    float _s2 = _pp - (pH - pL)
    float _r3 = pH + 2.0 * (_pp - pL)
    float _s3 = pL - 2.0 * (pH - _pp)
    [_pp, _r1, _r2, _r3, _s1, _s2, _s3]

f_pivotIsNear(float price, float level, float rng) =>
    not na(level) and math.abs(price - level) <= rng

f_pivotSweptUp(float level) =>
    not na(level) and high > level and close < level

f_pivotSweptDn(float level) =>
    not na(level) and low < level and close > level

// --- Pivot 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool pivotEntryBuy      = false
bool pivotEntrySell     = false
int  pivotSignalType    = 0
int  pivotDirection     = 0
bool pivotLongEventOk   = false
bool pivotShortEventOk  = false

if usePivotWZ
    // ---- Pivot 計算 (request.security は ここでのみ) ----
    [_pp, _r1, _r2, _r3, _s1, _s2, _s3] = f_pivotClassic(pivotTf)
    float pivot_pp = _pp
    float pivot_r1 = _r1
    float pivot_r2 = _r2
    float pivot_r3 = _r3
    float pivot_s1 = _s1
    float pivot_s2 = _s2
    float pivot_s3 = _s3

    // ---- 接近判定 (close 基準) ----
    float pivot_atr = ta.atr(14)
    float pivot_touchRange = pivotTouchMode == "ATR" ? pivot_atr * pivotTouchATR : pivotTouchDollar
    bool pivot_nearUpper = f_pivotIsNear(close, pivot_r1, pivot_touchRange) or f_pivotIsNear(close, pivot_r2, pivot_touchRange) or f_pivotIsNear(close, pivot_r3, pivot_touchRange) or f_pivotIsNear(close, pivot_pp, pivot_touchRange)
    bool pivot_nearLower = f_pivotIsNear(close, pivot_s1, pivot_touchRange) or f_pivotIsNear(close, pivot_s2, pivot_touchRange) or f_pivotIsNear(close, pivot_s3, pivot_touchRange) or f_pivotIsNear(close, pivot_pp, pivot_touchRange)

    // ---- 反転ローソク ----
    float pivot_body   = math.abs(close - open)
    float pivot_upWick = high - math.max(open, close)
    float pivot_dnWick = math.min(open, close) - low
    bool pivot_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool pivot_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool pivot_pinLower = pivot_dnWick >= pivot_body and pivot_dnWick >= pivot_upWick
    bool pivot_pinUpper = pivot_upWick >= pivot_body and pivot_upWick >= pivot_dnWick
    bool pivot_bullishReversal = pivot_bullEngulf or pivot_pinLower or close > open
    bool pivot_bearishReversal = pivot_bearEngulf or pivot_pinUpper or close < open

    // ---- A: Pivot反発 ----
    bool pivotBuyBounceSignal  = useBounceEntry and pivot_nearLower and pivot_bullishReversal
    bool pivotSellBounceSignal = useBounceEntry and pivot_nearUpper and pivot_bearishReversal

    // ---- B: Pivotスイープ反転 (R/S 抜け + ヒゲ>実体 + 反対終値) ----
    bool pivot_upSwept = f_pivotSweptUp(pivot_r1) or f_pivotSweptUp(pivot_r2) or f_pivotSweptUp(pivot_r3) or f_pivotSweptUp(pivot_pp)
    bool pivot_dnSwept = f_pivotSweptDn(pivot_s1) or f_pivotSweptDn(pivot_s2) or f_pivotSweptDn(pivot_s3) or f_pivotSweptDn(pivot_pp)
    bool pivotSellSweepSignal = useSweepEntry and pivot_upSwept and pivot_upWick > pivot_body and close < open
    bool pivotBuySweepSignal  = useSweepEntry and pivot_dnSwept and pivot_dnWick > pivot_body and close > open

    // ---- C: Pivotブレイク → レジサポ転換 (簡易リテスト。ta.crossover 優先 r2>r1>pp) ----
    var float pivot_breakUpLevel = na
    var int   pivot_breakUpBar   = na
    var float pivot_breakDnLevel = na
    var int   pivot_breakDnBar   = na
    if ta.crossover(close, pivot_r2)
        pivot_breakUpLevel := pivot_r2
        pivot_breakUpBar := bar_index
    else if ta.crossover(close, pivot_r1)
        pivot_breakUpLevel := pivot_r1
        pivot_breakUpBar := bar_index
    else if ta.crossover(close, pivot_pp)
        pivot_breakUpLevel := pivot_pp
        pivot_breakUpBar := bar_index
    if ta.crossunder(close, pivot_s2)
        pivot_breakDnLevel := pivot_s2
        pivot_breakDnBar := bar_index
    else if ta.crossunder(close, pivot_s1)
        pivot_breakDnLevel := pivot_s1
        pivot_breakDnBar := bar_index
    else if ta.crossunder(close, pivot_pp)
        pivot_breakDnLevel := pivot_pp
        pivot_breakDnBar := bar_index
    bool pivotBuyBreakRetestSignal  = useBreakRetestEntry and not na(pivot_breakUpLevel) and (bar_index - pivot_breakUpBar) <= pivotRetestBars and low <= pivot_breakUpLevel + pivot_touchRange and close > pivot_breakUpLevel and close > open
    bool pivotSellBreakRetestSignal = useBreakRetestEntry and not na(pivot_breakDnLevel) and (bar_index - pivot_breakDnBar) <= pivotRetestBars and high >= pivot_breakDnLevel - pivot_touchRange and close < pivot_breakDnLevel and close < open

    // ---- エントリー結合 (Any / All) → 方向別 ----
    int pivot_enabledCount = (useBounceEntry ? 1 : 0) + (useSweepEntry ? 1 : 0) + (useBreakRetestEntry ? 1 : 0)
    int pivot_firedBuy  = (pivotBuyBounceSignal ? 1 : 0) + (pivotBuySweepSignal ? 1 : 0) + (pivotBuyBreakRetestSignal ? 1 : 0)
    int pivot_firedSell = (pivotSellBounceSignal ? 1 : 0) + (pivotSellSweepSignal ? 1 : 0) + (pivotSellBreakRetestSignal ? 1 : 0)
    pivotEntryBuy  := pivot_enabledCount > 0 and (pivotEntryMode == "All" ? pivot_firedBuy  == pivot_enabledCount : pivot_firedBuy  >= 1)
    pivotEntrySell := pivot_enabledCount > 0 and (pivotEntryMode == "All" ? pivot_firedSell == pivot_enabledCount : pivot_firedSell >= 1)

    // ---- Signal Type / Direction ----
    // type: 1Bounce 2Sweep 3BreakRetest (優先 Sweep>BreakRetest>Bounce)
    bool pivot_anyBounce = pivotBuyBounceSignal or pivotSellBounceSignal
    bool pivot_anySweep  = pivotBuySweepSignal or pivotSellSweepSignal
    bool pivot_anyBR     = pivotBuyBreakRetestSignal or pivotSellBreakRetestSignal
    pivotSignalType := pivot_anySweep ? 2 : pivot_anyBR ? 3 : pivot_anyBounce ? 1 : 0
    pivotDirection  := pivot_anySweep ? (pivotBuySweepSignal ? 1 : -1) : pivot_anyBR ? (pivotBuyBreakRetestSignal ? 1 : -1) : pivot_anyBounce ? (pivotBuyBounceSignal ? 1 : -1) : 0

    // ---- WinZone イベント (エントリー成立) ----
    pivotLongEventOk  := pivotEntryBuy
    pivotShortEventOk := pivotEntrySell

// --- Pivot 状態管理 (FVG/EMA/BB/水平線/フィボ/Accum/H&S と同思想) ---
var bool pivotLongState  = false
var bool pivotShortState = false
var int  pivotLongStateBar  = na
var int  pivotShortStateBar = na

if usePivotWZ and usePivotStateWindow
    if pivotLongEventOk
        pivotLongState := true
        pivotLongStateBar := bar_index
    if pivotShortEventOk
        pivotShortState := true
        pivotShortStateBar := bar_index
    if pivotLongState and not na(pivotLongStateBar) and bar_index - pivotLongStateBar > pivotStateMaxBars
        pivotLongState := false
    if pivotShortState and not na(pivotShortStateBar) and bar_index - pivotShortStateBar > pivotStateMaxBars
        pivotShortState := false

// Pivot WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool pivotLongWinZone  = usePivotWZ ? (usePivotStateWindow ? pivotLongState  : pivotLongEventOk)  : false
bool pivotShortWinZone = usePivotWZ ? (usePivotStateWindow ? pivotShortState : pivotShortEventOk) : false

// --- H&S 表示 (useHSWZ の時だけ label/line を生成。OFFなら一切作らない) ---
// ============================================================
//  5b-3. WinZone 結合 (FVG / EMA / BB / 水平線 / フィボ を場所条件として統合)
// ------------------------------------------------------------
//  FVG_ONLY / EMA_ONLY / OR / AND で切り替え。
//  useWinZoneModule=false なら常に許可 (場所条件を無効化)。
// ============================================================
bool longWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY" ? longFVGOk :
     winZoneMode == "EMA_ONLY" ? emaLongWinZone :
     winZoneMode == "BB_ONLY"  ? bbLongWinZone :
     winZoneMode == "LINE_ONLY" ? lineLongWinZone :
     winZoneMode == "FIB_ONLY" ? longFibZoneOk :
     winZoneMode == "TREND_ONLY" ? longTrendZoneOk :
     winZoneMode == "ACCUM_ONLY" ? longAccumZoneOk :
     winZoneMode == "HS_ONLY"    ? hsLongWinZone :
     winZoneMode == "PIVOT_ONLY" ? pivotLongWinZone :
     winZoneMode == "WEDGE_ONLY" ? wedgeLongWinZone :
     winZoneMode == "OR"       ? ((useFVGWinZone and longFVGOk) or (useEMAWinZone and emaLongWinZone) or (useBBWinZone and bbLongWinZone) or (useLineWinZone and lineLongWinZone) or (useFibWinZone and longFibZoneOk) or (useTrendWinZone and longTrendZoneOk) or (useAccumWinZone and longAccumZoneOk) or (useHSWinZone and hsLongWinZone) or (usePivotWinZone and pivotLongWinZone) or (useWedgeWinZone and wedgeLongWinZone)) :
     winZoneMode == "AND"      ? ((not useFVGWinZone or longFVGOk) and (not useEMAWinZone or emaLongWinZone) and (not useBBWinZone or bbLongWinZone) and (not useLineWinZone or lineLongWinZone) and (not useFibWinZone or longFibZoneOk) and (not useTrendWinZone or longTrendZoneOk) and (not useAccumWinZone or longAccumZoneOk) and (not useHSWinZone or hsLongWinZone) and (not usePivotWinZone or pivotLongWinZone) and (not useWedgeWinZone or wedgeLongWinZone)) :
     true

bool shortWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY" ? shortFVGOk :
     winZoneMode == "EMA_ONLY" ? emaShortWinZone :
     winZoneMode == "BB_ONLY"  ? bbShortWinZone :
     winZoneMode == "LINE_ONLY" ? lineShortWinZone :
     winZoneMode == "FIB_ONLY" ? shortFibZoneOk :
     winZoneMode == "TREND_ONLY" ? shortTrendZoneOk :
     winZoneMode == "ACCUM_ONLY" ? shortAccumZoneOk :
     winZoneMode == "HS_ONLY"    ? hsShortWinZone :
     winZoneMode == "PIVOT_ONLY" ? pivotShortWinZone :
     winZoneMode == "WEDGE_ONLY" ? wedgeShortWinZone :
     winZoneMode == "OR"       ? ((useFVGWinZone and shortFVGOk) or (useEMAWinZone and emaShortWinZone) or (useBBWinZone and bbShortWinZone) or (useLineWinZone and lineShortWinZone) or (useFibWinZone and shortFibZoneOk) or (useTrendWinZone and shortTrendZoneOk) or (useAccumWinZone and shortAccumZoneOk) or (useHSWinZone and hsShortWinZone) or (usePivotWinZone and pivotShortWinZone) or (useWedgeWinZone and wedgeShortWinZone)) :
     winZoneMode == "AND"      ? ((not useFVGWinZone or shortFVGOk) and (not useEMAWinZone or emaShortWinZone) and (not useBBWinZone or bbShortWinZone) and (not useLineWinZone or lineShortWinZone) and (not useFibWinZone or shortFibZoneOk) and (not useTrendWinZone or shortTrendZoneOk) and (not useAccumWinZone or shortAccumZoneOk) and (not useHSWinZone or hsShortWinZone) and (not usePivotWinZone or pivotShortWinZone) and (not useWedgeWinZone or wedgeShortWinZone)) :
     true

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ------------------------------------------------------------
//  複数トリガーを Any/All/MinCount で結合し、最終シグナルを作る。
//  ・BOS / EMAリジェクトの ta.* は「ON の時だけ」呼ぶ (OFFで軽量)。
//  ・下位足確認は useLowerTFTrigger が ON の時だけ request.security。
//  ・出力: allowLongByTrigger / allowShortByTrigger
// ============================================================

// --- 結合判定ヘルパー ---
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// --- 有効(ON)トリガー数 (使用: ピンバー / EMAリジェクト) ---
int enabledTrigCount = (usePinbarTrigger?1:0) + (useEMARejectTrigger?1:0)

// --- 現在足のローソク基本量 ---
float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

// ピンバー : ヒゲ/実体・反対ヒゲ・終値位置 + 実体率・最低レンジ
float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

// EMA リジェクト : ta.ema は ON の時だけ呼ぶ (OFFで軽量)
float emaTrig = na
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
bool trBullEMA = useEMARejectTrigger and low <= emaTrig and close > emaTrig and close > open
bool trBearEMA = useEMARejectTrigger and high >= emaTrig and close < emaTrig and close < open

int bullTrigCount = (trBullPin?1:0)+(trBullEMA?1:0)
int bearTrigCount = (trBearPin?1:0)+(trBearEMA?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool finalBullTrig = trigBullCur
bool finalBearTrig = trigBearCur

// --- 逆方向同時発生 NoTrade ---
bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

// --- クールダウン (トリガー発火からの経過本数) ---
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// --- 最終トリガー許可 ---
bool allowLongByTrigger  = finalBullTrig and not trigNoTrade and trigCooldownOk
bool allowShortByTrigger = finalBearTrig and not trigNoTrade and trigCooldownOk

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
// --- 通常ボラ (base) : volMode で選択 ---
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

// --- 高速ボラ (fast) : OFF/ATR/固定値 ---
bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

// --- 合成 + 低ボラ解除後の待機 (クールダウン) ---
bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境判定関数 (方向)
// ------------------------------------------------------------
//  request.security から各時間足のコンテキストで呼ばれる。
//  戻り値 : [trend, bullScore, bearScore, rangeScore]
//           trend = 1=上昇 / 0=レンジ / -1=下降 / na=未判定
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    // 上昇スコア
    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    // 下降スコア
    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    // レンジスコア
    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    [trend, bullScore, bearScore, rangeScore]

// 環境テーブル用ヘルパー
f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

f_trendTxt(float tr) =>
    na(tr)   ? "未判定" :
     tr == 1 ? "上昇" :
     tr == -1 ? "下降" : "レンジ"

f_reqCol(string s) =>
    s == "上昇" ? colUp : s == "下降" ? colDown : s == "レンジ" ? colRange : colOff

// ============================================================
//  8. 環境フィルタ計算 (方向)
// ------------------------------------------------------------
//  useEnvFilter が OFF のときは request.security を一切呼ばないため軽い。
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

var table envTable = table.new(position.top_right, 3, 6, border_width = 1)

if useEnvFilter
    [raw4H,  bull4H,  bear4H,  range4H ] = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
    [raw1H,  bull1H,  bear1H,  range1H ] = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
    [raw15M, bull15M, bear15M, range15M] = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)
    [raw5M,  bull5M,  bear5M,  range5M ] = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    [raw1M,  bull1M,  bear1M,  range1M ] = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

    // 環境テーブル : TF | 要求 | 実際
    if showEnvTable and barstate.islast
        table.cell(envTable, 0, 0, "TF",   text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 1, 0, "要求", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 2, 0, "実際", text_color = color.white, bgcolor = color.new(color.blue, 0))
        labels = array.from("4H", "1H", "15M", "5M", "1M")
        reqArr = array.from(reqTrend4H, reqTrend1H, reqTrend15M, reqTrend5M, reqTrend1M)
        detArr = array.from(raw4H, raw1H, raw15M, raw5M, raw1M)
        for i = 0 to 4
            row  = i + 1
            reqS = array.get(reqArr, i)
            det  = array.get(detArr, i)
            en   = reqS != "OFF"
            matched = en and not na(det) and det == f_reqCode(reqS)
            detCol  = not en ? colOff : matched ? color.new(color.green, 0) : color.new(color.red, 0)
            table.cell(envTable, 0, row, array.get(labels, i), text_color = color.white, bgcolor = color.new(color.gray, 30))
            table.cell(envTable, 1, row, reqS,               text_color = color.white, bgcolor = f_reqCol(reqS))
            table.cell(envTable, 2, row, en ? f_trendTxt(det) : "-", text_color = color.white, bgcolor = detCol)

// 環境フィルタ最終判定 (OFF なら常に許可)。ロング/ショート共通。
bool envLongOk  = not useEnvFilter or allowByEnv
bool envShortOk = not useEnvFilter or allowByEnv


// ============================================================
//  8b-in. 入力 : Momentum モジュール (ストキャス)
// ------------------------------------------------------------
//  勢い / 押し目・戻り / タイミング / 逆張り禁止。環境認識とは独立。
//  出力: allowLongByMomentum / allowShortByMomentum / momoNoTrade。
//  useMomentumModule=false なら常に許可 (素通し・軽量)。
// ============================================================
grpMomentum = "Momentum"
useMomentumModule = input.bool(true, "Momentumモジュールを使う", group = grpMomentum)
useStochMomentum  = input.bool(true, "ストキャス",              group = grpMomentum)
momentumMode      = input.string("AND", "Momentum結合", options = ["AND", "OR"], group = grpMomentum)
useStochStateWindow       = input.bool(true, "ストキャス状態管理を使う", group = grpMomentum)
stochStateMaxBars         = input.int(3, "ストキャス状態 有効本数", minval = 1, group = grpMomentum)
resetStochStateAfterEntry = input.bool(true, "エントリー後ストキャス状態をリセット", group = grpMomentum)

grpStochSw = "Momentum: ストキャス パターン"
useExtremeReversal   = input.bool(true, "A: Extreme Reversal",   group = grpStochSw)
useOBOSCross         = input.bool(false, "B: OB/OS Cross",        group = grpStochSw)
useMiddleCross       = input.bool(false, "C: Middle Cross",       group = grpStochSw)
useStickinessFilter  = input.bool(true, "D: Stickiness(禁止)",   group = grpStochSw)
useRegularDivergence = input.bool(true, "E: Regular Divergence", group = grpStochSw)
useHiddenDivergence  = input.bool(false, "F: Hidden Divergence",  group = grpStochSw)

grpStoch = "Momentum: ストキャス設定"
kLen    = input.int(21, "%K 期間",      minval = 1, group = grpStoch)
kSmooth = input.int(3,  "%K スムージング", minval = 1, group = grpStoch)
dLen    = input.int(3,  "%D 期間",      minval = 1, group = grpStoch)
useStochTF = input.bool(false, "ストキャス参照TFを使う", group = grpStoch)
stochTF    = input.timeframe("5", "ストキャス参照TF", group = grpStoch)
extremeHigh = input.float(85, "Extreme High", group = grpStoch)
extremeLow  = input.float(15, "Extreme Low",  group = grpStoch)
obLevel     = input.float(80, "OB Level",     group = grpStoch)
osLevel     = input.float(20, "OS Level",     group = grpStoch)
middleLevel = input.float(50, "Middle Level", group = grpStoch)

grpStochA = "Momentum: A Extreme Reversal"
useExtremeSlopeTurn    = input.bool(true, "傾き反転で確認", group = grpStochA)
useExtremeKDCross      = input.bool(true, "K/Dクロスで確認", group = grpStochA)
extremeLookback        = input.int(5, "Extreme 到達 参照本数", minval = 1, group = grpStochA)
useExtremeOneShot      = input.bool(true, "Extreme 一回だけ発火", group = grpStochA)
extremeResetLevelHigh  = input.float(80, "High リセットレベル", group = grpStochA)
extremeResetLevelLow   = input.float(20, "Low リセットレベル",  group = grpStochA)
useSlopeStrengthFilter = input.bool(false, "折り返し角度フィルター", group = grpStochA)
stochSlopeMin          = input.float(2.0, "最小スロープ(|ΔK|)", minval = 0.0, step = 0.5, group = grpStochA)
useExtremeRetraceFilter= input.bool(false, "戻り量フィルター", group = grpStochA)
extremeRetraceMin      = input.float(5.0, "最小戻り量(ポイント)", minval = 0.0, step = 0.5, group = grpStochA)

grpStochD = "Momentum: D/Div/共通"
stickBars           = input.int(5, "Stickiness 張り付き本数", minval = 1, group = grpStochD)
divPivotLen         = input.int(5,  "Div Pivot 長さ",     minval = 1, group = grpStochD)
divLookback         = input.int(30, "Div Pivot 間 最大本数", minval = 1, group = grpStochD)
useKDirectionFilter = input.bool(false, "K傾きフィルター",   group = grpStochD)
useKDRelationFilter = input.bool(false, "K/D位置フィルター", group = grpStochD)

// ============================================================
//  8b. Momentum モジュール (ストキャス) : 勢い・タイミング確認
// ------------------------------------------------------------
//  ※ 環境認識(トレンド判定)とは完全に独立。
//  出力: allowLongByStoch / allowShortByStoch / stochNoTrade
//        → allowLongByMomentum / allowShortByMomentum に集約。
// ============================================================
bool sAct = useMomentumModule and useStochMomentum

f_stochCalc() =>
    float _rawK = ta.stoch(close, high, low, kLen)
    float _k = ta.sma(_rawK, kSmooth)
    float _d = ta.sma(_k, dLen)
    [_k, _d]

float stochK = na
float stochD = na
if useStochTF
    [k1, d1] = request.security(syminfo.tickerid, stochTF, f_stochCalc(), lookahead = barmerge.lookahead_off)
    stochK := k1
    stochD := d1
else
    [k2, d2] = f_stochCalc()
    stochK := k2
    stochD := d2

bool slopeUp     = stochK > stochK[1]
bool slopeDown   = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

f_dirOK(bool isBuy) =>
    bool d = not useKDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool r = not useKDRelationFilter or (isBuy ? stochK > stochD : stochK < stochD)
    d and r

// --- A: Extreme Reversal (90/10 折り返し) ---
bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp)   or (useExtremeKDCross and kdCrossUp)

float stochSlope = stochK - stochK[1]
bool slopeStrengthOK_sell = not useSlopeStrengthFilter or stochSlope <= -stochSlopeMin
bool slopeStrengthOK_buy  = not useSlopeStrengthFilter or stochSlope >=  stochSlopeMin

var bool  wasExtremeHigh       = false
var bool  wasExtremeLow        = false
var bool  extremeHighTriggered = false
var bool  extremeLowTriggered  = false
var float lastExtremeHighValue = na
var float lastExtremeLowValue  = na

if stochK >= extremeHigh
    wasExtremeHigh := true
    lastExtremeHighValue := na(lastExtremeHighValue) ? stochK : math.max(lastExtremeHighValue, stochK)
if stochK <= extremeLow
    wasExtremeLow := true
    lastExtremeLowValue := na(lastExtremeLowValue) ? stochK : math.min(lastExtremeLowValue, stochK)
if stochK <= extremeResetLevelHigh
    wasExtremeHigh := false
    extremeHighTriggered := false
    lastExtremeHighValue := na
if stochK >= extremeResetLevelLow
    wasExtremeLow := false
    extremeLowTriggered := false
    lastExtremeLowValue := na

bool retraceOK_sell = not useExtremeRetraceFilter or (not na(lastExtremeHighValue) and (lastExtremeHighValue - stochK) >= extremeRetraceMin)
bool retraceOK_buy  = not useExtremeRetraceFilter or (not na(lastExtremeLowValue)  and (stochK - lastExtremeLowValue)  >= extremeRetraceMin)

bool exSell = sAct and useExtremeReversal and wasExtremeHigh and (not useExtremeOneShot or not extremeHighTriggered) and turnDown and slopeStrengthOK_sell and retraceOK_sell and f_dirOK(false)
bool exBuy  = sAct and useExtremeReversal and wasExtremeLow  and (not useExtremeOneShot or not extremeLowTriggered)  and turnUp   and slopeStrengthOK_buy  and retraceOK_buy  and f_dirOK(true)

if exSell
    extremeHighTriggered := true
if exBuy
    extremeLowTriggered := true

// --- B: OB/OS Cross (80/20 クロス) ---
bool obSell = sAct and useOBOSCross and stochK > obLevel and kdCrossDown and f_dirOK(false)
bool obBuy  = sAct and useOBOSCross and stochK < osLevel and kdCrossUp   and f_dirOK(true)

// --- C: Middle Cross (50 抜け / 順張り勢い確認) ---
bool midBuy  = sAct and useMiddleCross and ta.crossover(stochK, middleLevel)  and stochK > stochD and f_dirOK(true)
bool midSell = sAct and useMiddleCross and ta.crossunder(stochK, middleLevel) and stochK < stochD and f_dirOK(false)

// --- D: Trend Stickiness (張り付き → 逆張り禁止) ---
var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := stochK >= obLevel ? bullStickCount + 1 : 0
bearStickCount := stochK <= osLevel ? bearStickCount + 1 : 0
bool stochBullSticky = sAct and useStickinessFilter and bullStickCount >= stickBars
bool stochBearSticky = sAct and useStickinessFilter and bearStickCount >= stickBars
bool stochNoSell = stochBullSticky   // 強い上昇中はSELL禁止
bool stochNoBuy  = stochBearSticky   // 強い下降中はBUY禁止

// --- E/F: Divergence (pivot ベース) ---
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float stochAtPivot = stochK[divPivotLen]

var float phPrev    = na
var float phLast    = na
var float shHPrev   = na
var float shHLast   = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float shLPrev   = na
var float shLLast   = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    shHPrev := shHLast
    phBarPrev := phBarLast
    phLast := pricePH
    shHLast := stochAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    shLPrev := shLLast
    plBarPrev := plBarLast
    plLast := pricePL
    shLLast := stochAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

bool regSell = sAct and useRegularDivergence and newPH and phInRange and phLast > phPrev and shHLast < shHPrev
bool regBuy  = sAct and useRegularDivergence and newPL and plInRange and plLast < plPrev and shLLast > shLPrev
bool hidBuy  = sAct and useHiddenDivergence and newPL and plInRange and plLast > plPrev and shLLast < shLPrev
bool hidSell = sAct and useHiddenDivergence and newPH and phInRange and phLast < phPrev and shHLast > shHPrev

// --- Signal Direction (優先: Regular > Hidden > Extreme > OBOS > Middle) ---
bool anyReg = regBuy or regSell
bool anyHid = hidBuy or hidSell
bool anyEx  = exBuy or exSell
bool anyOB  = obBuy or obSell
bool anyMid = midBuy or midSell

int stochDirection = not sAct ? 0 :
                      anyReg ? (regBuy ? 1 : -1) :
                      anyHid ? (hidBuy ? 1 : -1) :
                      anyEx  ? (exBuy ? 1 : -1) :
                      anyOB  ? (obBuy ? 1 : -1) :
                      anyMid ? (midBuy ? 1 : -1) : 0

int stochSignalType = not sAct ? 0 :
                       anyReg ? 4 :
                       anyHid ? 5 :
                       anyEx  ? 1 :
                       anyOB  ? 2 :
                       anyMid ? 3 : 0

bool stochLongEvent  = sAct and stochDirection == 1  and not stochNoBuy
bool stochShortEvent = sAct and stochDirection == -1 and not stochNoSell

// --- ストキャス 状態管理 : イベント発生後 stochStateMaxBars 本 OK を保持 ---
var bool stochLongStateOk   = false
var bool stochShortStateOk  = false
var int  stochLongStateBar  = na
var int  stochShortStateBar = na
var int  stochLongStateType  = 0
var int  stochShortStateType = 0

if useStochStateWindow
    if stochLongEvent
        stochLongStateOk   := true
        stochLongStateBar  := bar_index
        stochLongStateType := stochSignalType
    if stochShortEvent
        stochShortStateOk   := true
        stochShortStateBar  := bar_index
        stochShortStateType := stochSignalType
    if stochLongStateOk and not na(stochLongStateBar) and bar_index - stochLongStateBar > stochStateMaxBars
        stochLongStateOk := false
    if stochShortStateOk and not na(stochShortStateBar) and bar_index - stochShortStateBar > stochStateMaxBars
        stochShortStateOk := false

bool allowLongByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochLongStateOk and not stochNoBuy) :
     stochLongEvent
bool allowShortByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochShortStateOk and not stochNoSell) :
     stochShortEvent
bool stochNoTrade = sAct and (stochNoBuy or stochNoSell)

// ============================================================
//  8c. Momentum 集約 (将来 RSI/MACD/CCI/ADX/ROC も同じ構造で追加)
// ============================================================
bool momoLongStoch  = not useStochMomentum or allowLongByStoch
bool momoShortStoch = not useStochMomentum or allowShortByStoch
bool momoLongCombined  = momentumMode == "AND" ? momoLongStoch  : momoLongStoch
bool momoShortCombined = momentumMode == "AND" ? momoShortStoch : momoShortStoch
bool momoNoTrade = stochNoTrade
bool allowLongByMomentum  = not useMomentumModule or (momoLongCombined  and not momoNoTrade)
bool allowShortByMomentum = not useMomentumModule or (momoShortCombined and not momoNoTrade)

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// SL方式: パターン=包み足の高安ベース / 固定=一定の価格幅
float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

// 損失許容額 = 基準資金 * リスク%
float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  10. 最終エントリー条件
// ------------------------------------------------------------
//  設計順序 : 方向(環境認識) → WinZone(FVG/EMA) → Trigger(価格) → Entry
//    ・envLongOk          = どちら向きに狙うか (方向)
//    ・longWinZoneOk      = どこで狙うか (FVG / EMA・場所条件)
//    ・allowLongByTrigger = 価格が実際に反応したか (最後の引き金)
//    ・volOk / risk / qty = 執行フィルタ
// ============================================================
// --- 時間帯フィルタ (東京時間 JST) ---
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool canLong =
     useLong and
     sessionOk and
     envLongOk and
     longWinZoneOk and
     allowLongByMomentum and
     allowLongByTrigger and
     volOk and
     not lineNoTradeLong and
     longRisk > 0 and
     longQty >= 1

bool canShort =
     useShort and
     sessionOk and
     envShortOk and
     shortWinZoneOk and
     allowShortByMomentum and
     allowShortByTrigger and
     volOk and
     not lineNoTradeShort and
     shortRisk > 0 and
     shortQty >= 1

// ============================================================
//  11. 発注
// ------------------------------------------------------------
//  ポジション保有中は新規シグナルを無視 (ドテンしない)。
//  ノーポジ時だけエントリーし、決済は SL / TP のみ。
// ============================================================
bool isFlat = strategy.position_size == 0

if isFlat and canLong
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longTP)
    if resetFVGStateAfterEntry
        longFVGStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochLongStateOk := false
    // エントリー後、同じBB状態で再入しないよう状態をリセット
    if useBBWZ and resetBBStateAfterEntry
        longBBStateOk := false
    // エントリー後、同じフィボ状態で再入しないよう状態をリセット
    if useFibWZ and resetFibStateAfterEntry
        longFibStateOk := false
    // エントリー後、同じトレンド状態で再入しないよう状態をリセット
    if useTrendWZ and resetTrendStateAfterEntry
        longTrendStateOk := false
    // エントリー後、同じAccum状態で再入しないよう状態をリセット
    if useAccumWZ and resetAccumMTFAfterEntry
        longAccumStateOk := false

if isFlat and canShort
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortTP)
    if resetFVGStateAfterEntry
        shortFVGStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochShortStateOk := false
    // エントリー後、同じBB状態で再入しないよう状態をリセット
    if useBBWZ and resetBBStateAfterEntry
        shortBBStateOk := false
    // エントリー後、同じフィボ状態で再入しないよう状態をリセット
    if useFibWZ and resetFibStateAfterEntry
        shortFibStateOk := false
    // エントリー後、同じトレンド状態で再入しないよう状態をリセット
    if useTrendWZ and resetTrendStateAfterEntry
        shortTrendStateOk := false
    // エントリー後、同じAccum状態で再入しないよう状態をリセット
    if useAccumWZ and resetAccumMTFAfterEntry
        shortAccumStateOk := false

// --- EMA 状態管理: エントリー後リセット (フラット→ポジション化した足・入った方向のみ) ---
bool didEnterLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool didEnterShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
if useEMAWZ and resetEMAStateAfterEntry and didEnterLong
    emaLongState     := false
    emaLongStateBar  := na
    emaLongWinZone   := false
if useEMAWZ and resetEMAStateAfterEntry and didEnterShort
    emaShortState    := false
    emaShortStateBar := na
    emaShortWinZone  := false

// --- 水平線 状態管理: エントリー後リセット (エントリー成立足だけ・入った方向だけ) ---
if useLineWZ and resetLineStateAfterEntry and didEnterLong
    lineLongStateBar := na
if useLineWZ and resetLineStateAfterEntry and didEnterShort
    lineShortStateBar := na

// --- H&S 状態管理: エントリー後リセット (保有中は両方向の状態・WinZoneを解除) ---
if useHSWZ and resetHSStateAfterEntry and strategy.position_size != 0
    hsLongState      := false
    hsShortState     := false
    hsLongStateBar   := na
    hsShortStateBar  := na
    hsLongStateType  := ""
    hsShortStateType := ""
    hsLongWinZone    := false
    hsShortWinZone   := false

// --- Pivot 状態管理: エントリー後リセット (保有中は両方向の状態・WinZoneを解除) ---
if usePivotWZ and resetPivotStateAfterEntry and strategy.position_size != 0
    pivotLongState    := false
    pivotShortState   := false
    pivotLongStateBar := na
    pivotShortStateBar := na
    pivotLongWinZone  := false
    pivotShortWinZone := false

// --- Wedge 状態管理: エントリー後リセット (保有中は両方向の状態・WinZoneを解除) ---
if useWedgeWZ and resetWedgeStateAfterEntry and strategy.position_size != 0
    wedgeLongState    := false
    wedgeShortState   := false
    wedgeLongStateBar := na
    wedgeShortStateBar := na
    wedgeLongWinZone  := false
    wedgeShortWinZone := false

// ============================================================
//  12. 表示
// ============================================================
// 選択中Accum箱 表示 (Accum WinZone ON かつ 表示ON かつ 箱確定時のみ描画)
plotshape(canLong,  "買いエントリー", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(canShort, "売りエントリー", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,   0), size = size.small)

// Data Window 出力 (デバッグ用) : 方向 → WinZone(FVG/EMA) → Trigger → Entry

// --- ① 方向 (Env) ---
plot(envEnabled,       "envEnabled", display = display.data_window)
plot(envMatched,       "envMatched", display = display.data_window)
plot(envLongOk  ? 1 : 0, "envLongOk",  display = display.data_window)
plot(envShortOk ? 1 : 0, "envShortOk", display = display.data_window)

// --- ② WinZone (FVG / EMA) ---
plot(longFVGOk      ? 1 : 0, "longFVGOk",      display = display.data_window)
plot(shortFVGOk     ? 1 : 0, "shortFVGOk",     display = display.data_window)
plot(useEMAWZ and emaLongWinZone  ? 1 : 0, "emaLongWinZone",  display = display.data_window)
plot(useEMAWZ and emaShortWinZone ? 1 : 0, "emaShortWinZone", display = display.data_window)
plot(useEMAWZ and emaNoTrade ? 1 : 0, "emaNoTrade", display = display.data_window)
plot(useEMAWZ ? emaHitTF : 0, "emaHitTF", display = display.data_window)
plot(useEMAWZ ? emaHitMA : 0, "emaHitMA", display = display.data_window)
plot(useBBWZ and bbLongWinZone  ? 1 : 0, "bbLongWinZone",  display = display.data_window)
plot(useBBWZ and bbShortWinZone ? 1 : 0, "bbShortWinZone", display = display.data_window)
plot(useBBWZ and bbNoTrade ? 1 : 0, "bbNoTrade", display = display.data_window)
plot(useLineWZ and lineLongWinZone  ? 1 : 0, "lineLongWinZone",  display = display.data_window)
plot(useLineWZ and lineShortWinZone ? 1 : 0, "lineShortWinZone", display = display.data_window)
plot(useLineWZ and lineNoTrade ? 1 : 0, "lineNoTrade", display = display.data_window)
plot(useLineWZ ? lineSignalType : 0, "lineSignalType", display = display.data_window)
plot(useLineWZ ? lineStrength : 0, "lineStrength", display = display.data_window)
plot(useLineWZ ? lineHitTF : 0, "lineHitTF", display = display.data_window)
plot(useFibWZ and longFibZoneOk  ? 1 : 0, "longFibZoneOk",  display = display.data_window)
plot(useFibWZ and shortFibZoneOk ? 1 : 0, "shortFibZoneOk", display = display.data_window)
plot(useFibWZ ? fibDirection : 0, "fibDirection", display = display.data_window)
plot(useFibWZ ? fibRank : 0, "fibRank", display = display.data_window)
plot(useTrendWZ and longTrendZoneOk  ? 1 : 0, "longTrendZoneOk",  display = display.data_window)
plot(useTrendWZ and shortTrendZoneOk ? 1 : 0, "shortTrendZoneOk", display = display.data_window)
plot(useTrendWZ ? trendDirection : 0, "trendDirection", display = display.data_window)
plot(useTrendWZ ? trendSignalType : 0, "trendSignalType", display = display.data_window)
plot(useTrendWZ ? trendRank : 0, "trendRank", display = display.data_window)
plot(useTrendWZ ? trendlineQuality : 0, "trendlineQuality", display = display.data_window)
plot(useAccumWZ and longAccumZoneOk  ? 1 : 0, "longAccumZoneOk",  display = display.data_window)
plot(useAccumWZ and shortAccumZoneOk ? 1 : 0, "shortAccumZoneOk", display = display.data_window)
plot(useAccumWZ and mtfAccumIsForming ? 1 : 0, "mtfAccumIsForming", display = display.data_window)
plot(useAccumWZ ? selectedAccumTFCode : 0, "selectedAccumTFCode", display = display.data_window)
plot(useHSWZ and hsLongWinZone  ? 1 : 0, "hsLongWinZone",  display = display.data_window)
plot(useHSWZ and hsShortWinZone ? 1 : 0, "hsShortWinZone", display = display.data_window)
plot(useHSWZ and hsLongState  ? 1 : 0, "hsLongState",  display = display.data_window)
plot(useHSWZ and hsShortState ? 1 : 0, "hsShortState", display = display.data_window)
plot(usePivotWZ and pivotLongWinZone  ? 1 : 0, "pivotLongWinZone",  display = display.data_window)
plot(usePivotWZ and pivotShortWinZone ? 1 : 0, "pivotShortWinZone", display = display.data_window)
plot(usePivotWZ ? pivotDirection : 0, "pivotDirection", display = display.data_window)
plot(usePivotWZ ? pivotSignalType : 0, "pivotSignalType", display = display.data_window)
plot(useWedgeWZ and wedgeLongWinZone  ? 1 : 0, "wedgeLongWinZone",  display = display.data_window)
plot(useWedgeWZ and wedgeShortWinZone ? 1 : 0, "wedgeShortWinZone", display = display.data_window)
plot(useWedgeWZ ? wedgeDirection : 0, "wedgeDirection", display = display.data_window)
plot(useWedgeWZ ? wedgeSignalType : 0, "wedgeSignalType", display = display.data_window)
plot(longWinZoneOk  ? 1 : 0, "longWinZoneOk",  display = display.data_window)
plot(shortWinZoneOk ? 1 : 0, "shortWinZoneOk", display = display.data_window)
plot(useMomentumModule ? stochK : na, "stochK", display = display.data_window)
plot(useMomentumModule ? stochD : na, "stochD", display = display.data_window)

// --- ③ Trigger ---

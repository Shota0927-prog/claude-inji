//@version=5
indicator(
     title       = "Gold Correlation Candle Color",
     shorttitle  = "Gold-Corr",
     overlay     = true,
     max_bars_back = 500
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_sym = "シンボル設定"
gold_sym  = input.symbol("TVC:GOLD",  title = "ゴールド",  group = grp_sym)
dxy_sym   = input.symbol("TVC:DXY",   title = "DXY",       group = grp_sym)
us10y_sym = input.symbol("TVC:US10Y", title = "US10Y",     group = grp_sym)

grp_corr = "相関設定"
corr_len  = input.int(20, title = "相関期間", minval = 2, group = grp_corr)
corr_th   = input.float(0.7, title = "相関判定しきい値", minval = 0.0, maxval = 1.0, step = 0.05, group = grp_corr)
corr_mode = input.string("絶対値 (順相関 or 逆相関)", title = "相関の判定方法",
             options = ["絶対値 (順相関 or 逆相関)", "順相関のみ", "逆相関のみ"], group = grp_corr)

grp_color = "カラー設定"
col_dxy_only   = input.color(color.new(#E65100, 0), title = "DXYと相関 (濃いオレンジ)",        group = grp_color)
col_us10y_only = input.color(color.new(#FFB74D, 0), title = "US10Yと相関 (薄いオレンジ)",      group = grp_color)
col_both       = input.color(color.new(#FFD700, 0), title = "両方と相関 (ゴールド)",           group = grp_color)

// ============================================================
// データ取得
// ============================================================
gold_close  = request.security(gold_sym,  timeframe.period, close)
dxy_close   = request.security(dxy_sym,   timeframe.period, close)
us10y_close = request.security(us10y_sym, timeframe.period, close)

// ============================================================
// 相関計算
// ============================================================
corr_dxy   = ta.correlation(gold_close, dxy_close,   corr_len)
corr_us10y = ta.correlation(gold_close, us10y_close, corr_len)

// しきい値判定 (モードに応じて)
isCorrelated(float c) =>
    switch corr_mode
        "順相関のみ" => c >=  corr_th
        "逆相関のみ" => c <= -corr_th
        =>             math.abs(c) >= corr_th

bool dxy_corr   = isCorrelated(corr_dxy)
bool us10y_corr = isCorrelated(corr_us10y)

// ============================================================
// ローソク足の色付け
// ============================================================
color candle_col = dxy_corr and us10y_corr ? col_both :
                   dxy_corr                ? col_dxy_only :
                   us10y_corr              ? col_us10y_only : na

barcolor(candle_col, title = "相関ローソク足カラー")

// ============================================================
// 状態テーブル (右上に現在の相関値を表示)
// ============================================================
grp_info = "情報表示"
show_info = input.bool(true, title = "相関値テーブルを表示", group = grp_info)

var table info_tbl = table.new(position.top_right, 2, 3, border_width = 1)
if show_info and barstate.islast
    table.cell(info_tbl, 0, 0, "ペア",        bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 1, 0, "相関係数",    bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(info_tbl, 0, 1, "GOLD vs DXY",  bgcolor = dxy_corr   ? col_dxy_only   : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 1, str.tostring(corr_dxy,   "#.00"),     bgcolor = dxy_corr   ? col_dxy_only   : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 0, 2, "GOLD vs US10Y", bgcolor = us10y_corr ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)
    table.cell(info_tbl, 1, 2, str.tostring(corr_us10y, "#.00"),     bgcolor = us10y_corr ? col_us10y_only : color.new(color.gray, 80), text_color = color.white)

// ============================================================
// アラート
// ============================================================
alertcondition(dxy_corr and us10y_corr, title = "GOLD: DXY/US10Y 両方と相関", message = "{{ticker}} : ゴールドが DXY と US10Y の両方と相関しています")
alertcondition(dxy_corr   and not us10y_corr, title = "GOLD: DXYのみ相関",   message = "{{ticker}} : ゴールドが DXY と相関しています")
alertcondition(us10y_corr and not dxy_corr,   title = "GOLD: US10Yのみ相関", message = "{{ticker}} : ゴールドが US10Y と相関しています")

// =====================================================================================
// §8. 時刻照合（読み取り専用・初期 OFF。Logic05 / Logic09 × 5M の照合用。Source A のみ）
// =====================================================================================
// 通常 BUS・STUDY DATA / META・採用・保持・判定には一切影響しない（既に計算済みの値を表示 / 出力するだけ）。
// 元足 = 時刻修正版では「今確定した 5M チャート足」そのもの（Engine A をチャート自身で評価した結果。[1] シフトなし）。
//        STUDY の生シグナル・新規確定フラグはこの元足を確定時に f_v2ApplyTf(0) で処理した結果。
// TRACE NATIVE OPEN TIME / CLOSE TIME / CLOSE PRICE は、その f_v2ApplyTf(0) に渡したのと同じ値（TR_X5 = x5）と
// 開始時刻（trOpen5 = t5 = チャートの time）から出す。通常は 元足確定 = 出力確定（0 分）・元足 close = 登録足 close。
// 照合 OFF・Source 準備中 / 不整合・診断対象が Logic05 / 09 × 5M 以外では 3 値とも na。
grpTr  = "⑪ 時刻照合（Logic05 / 09 × 5M の照合用。初期 OFF）"
trShow = input.bool(false, "時刻照合を表示", group = grpTr,
     tooltip = "診断対象（⑨）が Logic05 EMA200 Reb または Logic09 EMA200 Brk、時間足 5M のときだけ照合します。通常の出力・判定には影響しません。")
trPos  = input.string(position.middle_right, "照合表の位置", options = [position.middle_right, position.middle_left, position.top_center, position.bottom_center, position.top_left], group = grpTr)
bool trTarget = (STUDY_LI == 4 or STUDY_LI == 8) and STUDY_TI == 0
// TR_X5 の index : 0 close / 1 high / 2 low / 3 EMA A / 15 time_close / 16 close[1] / 17 EMA A の前足値 / 18 ATR / 19 EMA 対象 TF

var float trOutOpen  = na
var float trOutClose = na
var float trOutPrice = na
var int   trLastBar  = 0
// 直近の片方向生シグナル 1 件（検知に使った値そのもの。条件の真偽はその値の比較を表示するだけ）
var TR_SNAP = array.new_float(24, na)
//   0 ロジック番号 / 1 方向 +1 -1 / 2 EMA 期間 / 3 元足開始 / 4 元足確定 / 5 close / 6 前足 close / 7 EMA / 8 前足 EMA /
//   9 low / 10 high / 11 許容幅 / 12 EMA 対象 TF / 13〜15 条件 1〜3 / 16 最終 / 17 マスクのビット / 18 反対方向のビット /
//   19 Source 出力確定（この 5 分足の time_close）
if isChart5M and barstate.isconfirmed and time > trLastBar
    trLastBar := time
    bool trOk = trShow and trTarget and srcStatusNow == 0
    trOutOpen  := trOk ? trOpen5 : na
    trOutClose := trOk ? array.get(TR_X5, 15) : na
    trOutPrice := trOk ? array.get(TR_X5, 0) : na
    int  jT = f_idx(STUDY_LI, 0) * 2
    bool bL = array.get(V2_RAW, jT)
    bool bS = array.get(V2_RAW, jT + 1)
    if trOk and trNb and bL != bS
        int   dT  = bL ? 1 : -1
        float c   = array.get(TR_X5, 0)
        float cp  = array.get(TR_X5, 16)
        float e   = array.get(TR_X5, 3)
        float ep  = array.get(TR_X5, 17)
        float lo  = array.get(TR_X5, 2)
        float hi  = array.get(TR_X5, 1)
        float tol = useEmaTol ? array.get(TR_X5, 18) * emaTolATR : 0.0
        bool  on  = array.get(TR_X5, 19) > 0.5
        bool  isBrk = STUDY_LI == 8
        // f_emaEvents と同じ比較（Logic09 = Break / Logic05 = Rebound）
        bool  k1 = dT == 1 ? (isBrk ? cp <= ep : cp >= ep) : (isBrk ? cp >= ep : cp <= ep)
        bool  k2 = isBrk ? (dT == 1 ? c > e : c < e) : (dT == 1 ? lo <= e + tol : hi >= e - tol)
        bool  k3 = isBrk ? true : (dT == 1 ? c > e : c < e)
        bool  fin = on and k1 and k2 and k3
        array.set(TR_SNAP, 0, STUDY_LI + 1)
        array.set(TR_SNAP, 1, dT)
        array.set(TR_SNAP, 2, emaLenA)
        array.set(TR_SNAP, 3, trOpen5)
        array.set(TR_SNAP, 4, array.get(TR_X5, 15))
        array.set(TR_SNAP, 5, c)
        array.set(TR_SNAP, 6, cp)
        array.set(TR_SNAP, 7, e)
        array.set(TR_SNAP, 8, ep)
        array.set(TR_SNAP, 9, lo)
        array.set(TR_SNAP, 10, hi)
        array.set(TR_SNAP, 11, tol)
        array.set(TR_SNAP, 12, on ? 1 : 0)
        array.set(TR_SNAP, 13, k1 ? 1 : 0)
        array.set(TR_SNAP, 14, k2 ? 1 : 0)
        array.set(TR_SNAP, 15, k3 ? 1 : 0)
        array.set(TR_SNAP, 16, fin ? 1 : 0)
        array.set(TR_SNAP, 17, (dT == 1 ? bL : bS) ? 1 : 0)
        array.set(TR_SNAP, 18, (dT == 1 ? bS : bL) ? 1 : 0)
        array.set(TR_SNAP, 19, time_close)

plot(isChart5M ? trOutOpen  : na, "TRACE NATIVE OPEN TIME",   display = display.data_window)
plot(isChart5M ? trOutClose : na, "TRACE NATIVE CLOSE TIME",  display = display.data_window)
plot(isChart5M ? trOutPrice : na, "TRACE NATIVE CLOSE PRICE", display = display.data_window)

var trTbl = table.new(trPos, 2, 16, border_width = 1)
f_trT(float t) =>
    na(t) ? "—" : str.format_time(int(t), "yyyy-MM-dd HH:mm:ss", "Asia/Tokyo")
f_trB(float v) =>
    na(v) ? "—" : v > 0.5 ? "真" : "偽"
f_trRow(int r, string k, string v) =>
    table.cell(trTbl, 0, r, k, text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)
    table.cell(trTbl, 1, r, v, text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)
if barstate.islast
    table.clear(trTbl, 0, 0, 1, 15)
    if trShow and not trTarget
        f_trRow(0, "時刻照合", "⑨ 診断対象を Logic05 EMA200 Reb または Logic09 EMA200 Brk、時間足 5M にしてください（照合表示だけ対象外。通常出力は継続）")
    else if trShow
        bool   isB = array.get(TR_SNAP, 0) == 9
        bool   has = not na(array.get(TR_SNAP, 0))
        string dS  = array.get(TR_SNAP, 1) == 1 ? "LONG" : "SHORT"
        f_trRow(0, "直近の片方向生シグナル（Asia/Tokyo）", has ? "Logic" + str.tostring(array.get(TR_SNAP, 0), "00") + " " + dS + " / EMA 期間 " + str.tostring(array.get(TR_SNAP, 2), "0") : "まだありません")
        if has
            f_trRow(1, "元足 開始 / 確定", f_trT(array.get(TR_SNAP, 3)) + " / " + f_trT(array.get(TR_SNAP, 4)))
            f_trRow(2, "Source 出力確定（親 5 分足）", f_trT(array.get(TR_SNAP, 19)) + "（元足確定から " + str.tostring((array.get(TR_SNAP, 19) - array.get(TR_SNAP, 4)) / 60000, "0.##") + " 分）")
            f_trRow(3, "元足 close / 前足 close", str.tostring(array.get(TR_SNAP, 5), format.mintick) + " / " + str.tostring(array.get(TR_SNAP, 6), format.mintick))
            f_trRow(4, "元足 EMA / 前足 EMA", str.tostring(array.get(TR_SNAP, 7), "0.000") + " / " + str.tostring(array.get(TR_SNAP, 8), "0.000"))
            if not isB
                f_trRow(5, "元足 low / high / 許容幅", str.tostring(array.get(TR_SNAP, 9), format.mintick) + " / " + str.tostring(array.get(TR_SNAP, 10), format.mintick) + " / " + str.tostring(array.get(TR_SNAP, 11), "0.000"))
            f_trRow(6, "EMA 対象 TF（_on）", f_trB(array.get(TR_SNAP, 12)))
            string k1S = isB ? (array.get(TR_SNAP, 1) == 1 ? "前足 close <= 前足 EMA" : "前足 close >= 前足 EMA") : (array.get(TR_SNAP, 1) == 1 ? "前足 close >= 前足 EMA" : "前足 close <= 前足 EMA")
            string k2S = isB ? (array.get(TR_SNAP, 1) == 1 ? "close > EMA" : "close < EMA") : (array.get(TR_SNAP, 1) == 1 ? "low <= EMA + 許容幅（接触）" : "high >= EMA − 許容幅（接触）")
            f_trRow(7, "条件 : " + k1S, f_trB(array.get(TR_SNAP, 13)))
            f_trRow(8, "条件 : " + k2S, f_trB(array.get(TR_SNAP, 14)))
            if not isB
                f_trRow(9, "条件 : " + (array.get(TR_SNAP, 1) == 1 ? "close > EMA（終値位置）" : "close < EMA（終値位置）"), f_trB(array.get(TR_SNAP, 15)))
            f_trRow(10, "条件から求めた生シグナル", f_trB(array.get(TR_SNAP, 16)))
            f_trRow(11, "マスクの該当ビット（同方向 / 反対方向）", f_trB(array.get(TR_SNAP, 17)) + " / " + f_trB(array.get(TR_SNAP, 18)) +
                 (array.get(TR_SNAP, 16) == array.get(TR_SNAP, 17) ? "（一致）" : "（不一致）"))
            f_trRow(12, "注記", "元足の位置は後から表示している。そこで売買できた証拠ではない")

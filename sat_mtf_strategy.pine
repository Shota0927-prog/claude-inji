// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  SAT MTF Background Strategy  (15s / 30s / 1m)
// ============================================================================
//  SAT    : SAT BAND Reconstruction Test   … LINE1 / LINE2 / STB / 背景判定
//  Zone   : FVG + Zone Engine Strategy     … ZoneEngine / TradePlan / Risk / Qty
//
//  ★ チャート時間足は 15秒足 前提 ★
//
//  ★★ 時間軸の分離 ★★
//    SAT Entry Logic      … 15秒足 (30秒 / 1分 の確定背景を参照)
//    Entry Filter ①       … 1分足の色遷移 State Machine (1分足1本につき1回更新)
//    Entry Filter ②       … baseSignal 後に待機し、確定5分 SAT 背景が目的色へ
//                            切り替わった時点で Entry (ZoneEngine Base TF とは別)
//    Zone Engine          … Base TF 5分 (ZoneEngine v10 / チャート足から独立)
//    TradePlan entryPrice … SAT Pattern 成立時の 15秒 close
//
//    Zone 側は ZoneEngine v10 を使い、Zone State 更新が参照する現在足情報
//    (high / low / close / close[1] / time / bar_index) をすべて ZoneFeed の
//    base* から受け取る。zn.update() は Base TF 足 1 本につき 1 回だけ呼ぶ。
//    → 15秒足チャート上でも、Zone は元 5分 Strategy と同じ時間軸で動く。
//
//  Entry の中心は「15s / 30s / 1m SAT Background State Machine」。
//  SignalEngine は使わない (SAT背景 State Machine が Entry Signal そのもの)。
//
//  構成:
//    01. ALL INPUTS
//         01-1 SAT (SAT BAND Reconstruction · 表示 / 色。計算値は固定)
//         01-2 MTF / Entry / Entry Filter Mode
//         01-3 SL/TP Mode  (ZONE / FIXED)
//         01-4 Zone Engine (ZONE モード用)
//         01-5 Trade Engine (Risk / Qty / Order)
//         01-6 Display / Debug
//    02. SAT BAND Reconstruction 計算関数 (チャート足と HTF で同一の関数を使う)
//    03. SAT 背景 : 15s / 30s / 1m / 5m
//    03b. ENTRY FILTER ① : 1分足 色遷移 State Machine
//    04. ENTRY STATE MACHINE (LONG / SHORT 独立)
//    04b. ENTRY FILTER 合成 (① / ② / ①+②)
//    05. ZONE ENGINE (ZONE モードのみ)
//    06. RISK / QTY
//    07. TRADE ENGINE (SL/TP 決定 → Qty → strategy.entry → strategy.exit)
//    08. ORDER EXECUTION + State Reset
//    09. DISPLAY / DEBUG
//
// ----------------------------------------------------------------------------
//  ■ SAT 側について (SAT BAND Reconstruction)
//
//   「SAT BAND Reconstruction Test」の計算式をそのまま移植したもの。
//   見た目を合わせるための補正・追加平滑化・Confirm などは一切入れていない。
//
//     共通   … basis  = ta.vwma(hlc3, 5)
//              common = basis * 0.5
//              atr50  = ta.atr(50)[1]
//              src      = close[1] * 0.5
//              trigLow  = low[1]   * 0.5
//              trigHigh = high[1]  * 0.5
//
//     LINE1  … k = 5.0 の Anchor State 機械   line1 = common + anchor1
//     LINE2  … k = 2.5 の Anchor State 機械   line2 = common + anchor2
//              (構造は LINE1 と同一。違うのは倍率だけ。anchor / dir は完全に別変数)
//
//              Bull(+1) 中 : trigLow  < prevAnchor → Bear へ反転し
//                                                   anchor = src + k * atr50
//                            それ以外              → anchor = max(prevAnchor,
//                                                                 src - k * atr50)
//              Bear(-1) 中 : trigHigh > prevAnchor → Bull へ反転し
//                                                   anchor = src - k * atr50
//                            それ以外              → anchor = min(prevAnchor,
//                                                                 src + k * atr50)
//
//     STB    … 表示     : ta.highest(high, 10) / ta.lowest(low, 10)
//              方向判定 : ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
//              毎バー high breakout を先に判定し、下抜けは else if。
//              同一バーで上下両方を突破した場合は Bull(+1) 優先。
//              どちらも突破していなければ直前の State を維持。
//              表示価格は UP が lower10、DOWN が upper10。
//              ATR / EMA / Supertrend / LINE1 / LINE2 は一切混ぜない。
//
//     背景   … 各ラインの dir は使わず、close と 3 本の位置関係だけで決める。
//              青 (+1) : close > LINE1 かつ close > LINE2 かつ close > STB
//              赤 (-1) : close < LINE1 かつ close < LINE2 かつ close < STB
//              フラット (0) : それ以外
//              判定ソースは close 固定。
//
//   ■ 計算パラメータは固定値
//     VWMA 5 / common 倍率 0.5 / ATR 50 / LINE1 k = 5.0 / LINE2 k = 2.5 /
//     STB 表示 10 本 / STB 転換 20 本 は input 化していない。
//     ブラックボックス再現テストの式そのものを検証するため。
//
// ----------------------------------------------------------------------------
//  ■ リペイント防止
//   ・Entry Signal は必ず「確定した15秒足」で決定する (barstate.isconfirmed)。
//   ・30秒 / 1分の背景は request.security(..., lookahead_on) の内部で式に [1] を掛け、
//     「最後に確定した HTF バー」の値だけを使う。形成中 HTF は絶対に使わない。
//     ★ lookahead_on は必ず [1] とセットで使う。単独では絶対に使わない (未来参照になる)。
//       [1] が「ひとつ前の閉じた HTF バー」を指すため、lookahead_on が前借りするのは
//       その確定済みバーの値だけで、未来の情報は入らない。
//       lookahead_off + [1] は HTF バー切り替わり直後にもう 1 本ぶん古い値を返しうるので、
//       ヒストリカルとリアルタイムで判定がずれる。lookahead_on + [1] はどちらでも
//       「最後に確定した HTF バー」で一致する。
//   ・Zone 側の外部 TF 取得は従来どおり lookahead_off (式に [1] を掛けていないため)。
//   ・過去バーの Entry 位置が後から変わる実装は入れていない。
//
//  ■ 30秒 / 1分 / 5分の SAT 計算について (重要)
//   15秒足で計算したラインを流用していない。f_satRebuild() を
//   request.security() の「中」で評価しているため、VWMA / ATR /
//   Anchor State / STB State / 背景のすべてが、その時間足自身の OHLC から
//   独立に再計算される。30秒・1分・5分はラインを描画しないので、
//   必要な「背景 State」だけをそれぞれ 1 回の request.security() で取得している
//   (SAT 側の追加 request は 3 本)。
// ============================================================================

//@version=5
strategy(
     title             = "SAT MTF Background Strategy (15s/30s/1m)",
     shorttitle        = "SAT-MTF",
     overlay           = true,
     pyramiding        = 1,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     process_orders_on_close = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ★★★ Library import ★★★
//  ZONE モードで使う。ZoneEngine の Zone 生成ロジックは変更しない。
import sekine3310/ZoneEngine/10 as zn

// Library 内の定数と同じ値 (定数 export は Pine のバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// 背景 State
int BG_BLUE = 1
int BG_FLAT = 0
int BG_RED  = -1

// Entry State Machine
//   LONG  : 0 WAIT_INITIAL / 1 ARMED(青を見た) / 2 SAW_FLAT / 3 SAW_RED
//   SHORT : 0 WAIT_INITIAL / 1 ARMED(赤を見た) / 2 SAW_FLAT / 3 SAW_BLUE
int ST_WAIT  = 0
int ST_ARMED = 1
int ST_FLAT  = 2
int ST_OPP   = 3

string LOGIC_ID = "SAT"

// ============================================================================
// 01. ALL INPUTS
// ============================================================================

// ---- 01-1 SAT : 表示 (計算パラメータは固定。input では変更できない) --------
//  SAT BAND Reconstruction は計算パラメータを固定値で持つ。
//  VWMA 5 / common 倍率 0.5 / ATR 50 / LINE1 k = 5.0 / LINE2 k = 2.5 /
//  STB 表示 10 本 / STB 転換 20 本 は input 化していない。
//  背景の判定ソースも close 固定で、切替 input は持たない。
var string G_BG = "01 · SAT · 背景 / 色"
bgBuyCol  = input.color(#068C8C, "青 (Bull) 背景色",  group = G_BG)
bgSellCol = input.color(#F54230, "赤 (Bear) 背景色",  group = G_BG)
bgTransp  = input.int(66, "背景の透明度", minval = 0, maxval = 100, group = G_BG)

var string G_MA = "01 · SAT · 移動平均線"
showMa    = input.bool(true, "移動平均線を表示", group = G_MA)
maType    = input.string("EMA", "MA 種別", options = ["EMA", "SMA", "RMA", "WMA"], group = G_MA)
maLen     = input.int(200, "MA 期間", minval = 1, maxval = 1000, group = G_MA)
maSrcType = input.string("close", "MA ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_MA)
maWidth   = input.int(2, "MA 線幅", minval = 1, maxval = 5, group = G_MA)
maUpCol   = input.color(color.rgb(38, 198, 218),  "MA 上昇色", group = G_MA)
maDnCol   = input.color(color.rgb(255, 82, 82),   "MA 下降色", group = G_MA)
maFlatCol = input.color(color.rgb(149, 152, 161), "MA 中立色", group = G_MA)

var string G_LINEDISP = "01 · SAT · ライン表示"
showStb = input.bool(true, "STB ラインを表示", group = G_LINEDISP)
showL1  = input.bool(true, "LINE1 を表示",     group = G_LINEDISP)
showL2  = input.bool(true, "LINE2 を表示",     group = G_LINEDISP)
stbWidth = input.int(2, "STB 線幅",   minval = 1, maxval = 5, group = G_LINEDISP)
l1Width  = input.int(2, "LINE1 線幅", minval = 1, maxval = 5, group = G_LINEDISP)
l2Width  = input.int(2, "LINE2 線幅", minval = 1, maxval = 5, group = G_LINEDISP)
satUpCol = input.color(#068C8C, "Bull 色 (LINE1 / LINE2 / STB 共通)", group = G_LINEDISP)
satDnCol = input.color(#F54230, "Bear 色 (LINE1 / LINE2 / STB 共通)", group = G_LINEDISP)

// ---- 01-2 MTF / Entry ------------------------------------------------------
var string G_MTF = "02 · MTF · 時間足"
satTf30 = input.timeframe("30S", "30秒足 の時間足指定", group = G_MTF,
     tooltip = "この時間足のコンテキスト内で STB / LINE1 / LINE2 / 背景 をすべて再計算する。\n15秒足のラインを流用しない。")
satTf1m = input.timeframe("1",   "1分足 の時間足指定",  group = G_MTF,
     tooltip = "この時間足のコンテキスト内で STB / LINE1 / LINE2 / 背景 をすべて再計算する。")
satTf5m = input.timeframe("5",   "5分足 の時間足指定 (Entry Filter ②)",  group = G_MTF,
     tooltip = "Entry Filter ② で使う SAT 背景の時間足。\n" +
     "baseSignal 成立後に待機へ入り、この時間足の確定背景が目的色へ\n" +
     "切り替わった最初の15秒確定足で Entry する。\n" +
     "★ ZoneEngine の Base TF とは別概念。こちらは SAT BAND Reconstruction の\n" +
     "  LINE1 / LINE2 / STB / 背景 を5分足コンテキストで再計算したもの。\n" +
     "15秒足の SAT ラインは流用しない。")

// ---- Entry Filter (既存 Entry State Machine には手を入れない追加条件) -------
var string G_FLT = "02 · Entry Filter"
FM_1M   = "① 1m Transition"
FM_5M   = "② 5m Background"
FM_BOTH = "① + ②"
FM_BASE = "③ Base Signal Only"
entryFilterMode = input.string(FM_1M, "Entry Filter Mode",
     options = ["① 1m Transition", "② 5m Background", "① + ②", "③ Base Signal Only"], group = G_FLT,
     tooltip = "既存の 15秒 Pattern A / B State Machine は一切変更しない。\n" +
     "baseSignal が完成したあとに、この追加フィルターで通す / 落とすだけ。\n\n" +
     "① 1m Transition : 現在の1分Regimeが「反対色から始まったか」を見る\n" +
     "   LONG  … 1分 赤 → (フラット0本以上) → 青 で始まった青Regime\n" +
     "   SHORT … 1分 青 → (フラット0本以上) → 赤 で始まった赤Regime\n" +
     "   ★ VALID なのは転換後 N 本の確定1分足だけ (N = ① Transition 有効1分足数)\n\n" +
     "② 5m Background : baseSignal 完成後に待機し、確定5分SAT背景が目的色へ\n" +
     "   切り替わった最初の15秒確定足で Entry する (待機方式)\n" +
     "   ★ baseSignal 成立時点ですでに5分が目的色でも、その場では Entry しない。\n" +
     "     非目的色 → 目的色 の切り替わりが Signal 発生後に起きることを要求する。\n" +
     "   ★ 待機中は確定1分背景が目的色 (LONG 青 / SHORT 赤) を維持することが必須。\n" +
     "     フラットまたは反対色になった時点でその Signal を破棄する。\n" +
     "     あとから1分が戻っても古い Signal は復活しない (新しい baseSignal が必要)。\n" +
     "   ★ 1方向につき待機は最大1つ。待機中の新しい Pattern A / B は重複登録しない。\n\n" +
     "① + ② : baseSignal 成立時点で①を満たしていることを待機開始の条件にし、\n" +
     "   そのあと②の5分待機へ進む。OR ではない。\n\n" +
     "③ Base Signal Only : フィルターなしの検証用。15秒 Pattern A / B の\n" +
     "   baseSignal がそのまま Entry になる。①の1m Transition も\n" +
     "   ②の5分待機も Entry 条件には一切使わない\n" +
     "   (①の State と有効本数は Debug 比較のため計算だけ続ける)。")

transitionValidBars = input.int(2, "① Transition 有効1分足数", minval = 1, maxval = 20, group = G_FLT,
     tooltip = "① が VALID でいられる確定1分足の本数。\n" +
     "転換が成立して最初に VALID になった1分足を 1 本目と数える。\n\n" +
     "  例) 2 のとき LONG : 赤 → 青① → 青② → 青③ …\n" +
     "      → 青① と 青② だけ ① VALID / 青③ 以降は INVALID\n" +
     "      赤 → フラット → 青① → 青② でも同じ\n" +
     "  SHORT は完全対称 (青 → 赤① → 赤② → 赤③ … で 赤①・赤② だけ VALID)\n\n" +
     "★ カウントは確定1分足単位。15秒足ごとには数えない。\n" +
     "★ ①+② では「②の待機へ入る瞬間の審査」にだけ使う。\n" +
     "  待機開始後に①の有効本数が切れても pending はキャンセルしない。")

var string G_DIR = "02 · MTF · Direction"
enableLong  = input.bool(true, "Enable Long",  group = G_DIR)
enableShort = input.bool(true, "Enable Short", group = G_DIR)

// ---- 01-3 SL / TP ----------------------------------------------------------
var string G_SLTPM = "03 · SLTP Mode"
sltpMode = input.string("FIXED", "SLTP Mode", options = ["ZONE", "FIXED"], group = G_SLTPM,
     tooltip = "Entry ロジックはこの設定で一切変わらない。同じ SAT Entry Signal を使い、SL/TP の決め方だけを切り替える。\nZONE  : ZoneEngine の Structural SL / TP (TradePlan)\nFIXED : 固定ドル幅")
fixedSlDollar = input.float(5.0,  "Fixed SL ($)", minval = 0.01, step = 0.1, group = G_SLTPM)
fixedTpDollar = input.float(10.0, "Fixed TP ($)", minval = 0.01, step = 0.1, group = G_SLTPM)

bool useZoneSltp = sltpMode == "ZONE"

// ---- 01-4 Zone Engine ------------------------------------------------------
//  ZONE モードのときだけ使う。Zone 生成ロジックは ZoneEngine のまま変更しない。
var string G_ZBASE = "04 · Zone · Base TF"
zoneBaseTf = input.timeframe("5", "Zone Base TF", group = G_ZBASE,
     tooltip = "Zone を生成 / 更新する基準時間足。元 Zone Strategy と同じ 5分が初期値。\n" +
     "★ SAT Entry は15秒足のまま。ここで変わるのは Zone 側だけ。\n" +
     "この時間足が 1 本確定するたびに ZoneEngine を 1 回だけ更新する。\n" +
     "Day High/Low / Reaction / Natural State / MA alignment / trackStaleBars /\n" +
     "createdBar / breakBar / lastSeenBar / Zone 寿命の time はすべてこの時間足基準になる。\n" +
     "Break 判定もこの時間足の確定終値で行う。")

var string G_ZONE = "04 · Zone Geometry"
zoneHalfWidth = input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE)

var string G_ZMA = "04 · Zone · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_ZMA)
zMaType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_ZMA)
useMaSource = input.bool(true, "Enable MA Source", group = G_ZMA)
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_ZMA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_ZMA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_ZMA)
scoreMa1 = input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_ZMA)
scoreMa2 = input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_ZMA)

var string G_ZSLOPE = "04 · Zone · MA Slope"
slopeThrMod       = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_ZSLOPE)
slopeThrStrong    = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_ZSLOPE)
slopeBonusFlat    = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_ZSLOPE)
slopeBonusMod     = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_ZSLOPE)
slopeBonusStr     = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_ZSLOPE)
slopeBonusMode    = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster", options = ["Sum (per MA)", "Max"], group = G_ZSLOPE)
maClusterDist     = input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_ZSLOPE)
maClusterBonus    = input.float(1.0,  "MA Cluster Bonus",        step = 0.5, group = G_ZSLOPE)
maClusterDirBonus = input.float(1.0,  "MA Cluster Bonus · Same Slope", step = 0.5, group = G_ZSLOPE)

var string G_ZHZ = "04 · Zone · Horizontal Source (Swing)"
useHzSource = input.bool(true, "Enable Horizontal Source", group = G_ZHZ)
hzTf1 = input.timeframe("5",  "Horizontal TF #1", group = G_ZHZ)
hzTf2 = input.timeframe("15", "Horizontal TF #2", group = G_ZHZ)
hzTf3 = input.timeframe("60", "Horizontal TF #3", group = G_ZHZ)
pivLen1 = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_ZHZ)
pivLen2 = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_ZHZ)
pivLen3 = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_ZHZ)
scoreHz1 = input.float(1.0, "Base Score · TF #1 Swing", step = 0.5, group = G_ZHZ)
scoreHz2 = input.float(2.0, "Base Score · TF #2 Swing", step = 0.5, group = G_ZHZ)
scoreHz3 = input.float(3.0, "Base Score · TF #3 Swing", step = 0.5, group = G_ZHZ)

var string G_ZREACT = "04 · Zone · Horizontal Reaction"
reactionDist      = input.float(20.0, "Reaction Distance ($)", step = 0.5, group = G_ZREACT)
reactionBonus1    = input.float(1.0,  "Reaction Bonus · 1 time",   step = 0.5, group = G_ZREACT)
reactionBonus2    = input.float(2.0,  "Reaction Bonus · 2 times",  step = 0.5, group = G_ZREACT)
reactionBonus3    = input.float(3.0,  "Reaction Bonus · 3+ times", step = 0.5, group = G_ZREACT)
reactionRearmDist = input.float(10.0, "Reaction Re-arm Distance ($)", step = 0.5, group = G_ZREACT)
reactionAllSrc    = input.bool(false, "Track Reaction on Accum / DayHL too", group = G_ZREACT)

var string G_ZDHL = "04 · Zone · Day High / Low"
useDayHL = input.bool(true, "Enable Day High / Low Source", group = G_ZDHL)
dayTz        = input.string("Asia/Tokyo", "Day Session Timezone", group = G_ZDHL)
dayResetHour = input.int(5, "Day Reset Hour", minval = 0, maxval = 23, group = G_ZDHL)
scoreDayHL     = input.float(3.0, "Base Score · Day High / Low", step = 0.5, group = G_ZDHL)
carryPrevDayHL = input.bool(false, "Carry Previous Day H/L as Horizontal Zone", group = G_ZDHL)
scorePrevDayHL = input.float(2.0, "Base Score · Carried Prev Day H/L", step = 0.5, group = G_ZDHL)
lifePrevDayHL  = input.float(5.0, "Lifetime · Carried Prev Day H/L (days)", step = 1.0, group = G_ZDHL)

var string G_ZACC = "04 · Zone · Accumulation"
useAccSource = input.bool(true, "Enable Accumulation Source", group = G_ZACC)
accumModule  = input.string("Accum Box (ported)", "Accum Detection Module", options = ["Accum Box (ported)", "Provisional ATR (暫定)"], group = G_ZACC)

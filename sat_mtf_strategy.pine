showZones      = input.bool(false, "Zone Box を表示 (ZONEモードのみ)", group = G_DBG)
maxZonesDraw   = input.int(30, "Max Zones Drawn", minval = 1, maxval = 120, group = G_DBG)
zoneLeftBars   = input.int(150, "Zone Box · Left Extension (bars)",  minval = 1, group = G_DBG)
zoneRightBars  = input.int(30,  "Zone Box · Right Extension (bars)", minval = 1, group = G_DBG)
colSupport     = input.color(color.new(#26A69A, 0), "Color · Support",    group = G_DBG)
colResistance  = input.color(color.new(#EF5350, 0), "Color · Resistance", group = G_DBG)
colActive      = input.color(color.new(#FFB300, 0), "Color · Active",     group = G_DBG)
colBroken      = input.color(color.new(#78909C, 0), "Color · Broken",     group = G_DBG)

// ---- 01-7 HTF SAT Background Filter ----------------------------------------
//  ★ 既存の Entry Filter Mode (① / ② / ①+② / ③) とは独立した追加フィルター ★
//    entryFilterMode の新モードではない。既存の最終 Entry Signal に対して
//    最後にもう一段ゲートを掛けるだけ:
//      longSignal  := longSignal  and htfLongPass
//      shortSignal := shortSignal and htfShortPass
//  ★ useHtfFilter = false のときは htfLongPass / htfShortPass とも常に true。
//    現在の Entry 結果と完全に一致する (request.security も発行しない)。
//  ★ 対象時間足は 5分 / 15分 / 30分 / 1時間 / 4時間 / 日足 / 週足 で固定。
//    5分は既存の bg5m をそのまま流用し、残り 6 本を新規取得する。
//    どれも f_satBgHtf() ([1] + lookahead_on) なので確定 HTF 背景のみ。
//    15秒 SAT の値を上位足へ流用せず、各時間足自身の OHLC で再計算される。
var string G_HTF = "07 · HTF SAT Filter"
useHtfFilter = input.bool(false, "HTF Filter を使用", group = G_HTF,
     tooltip = "OFF (既定) のときは HTF 条件を一切見ない。Entry 結果は追加前と完全に一致する。")
htfCombineMode = input.string("AND", "HTF条件の結合", options = ["AND", "OR"], group = G_HTF,
     tooltip = "AND : OFF 以外に設定した時間足が「すべて」一致したときだけ PASS\n" +
     "OR  : OFF 以外に設定した時間足の「1つでも」一致すれば PASS\n" +
     "★ その方向の7時間足がすべて OFF のときは、AND / OR どちらでも PASS。")

//  OFF / BLUE / FLAT / RED の 4 択。OFF はその時間足を判定から除外する。
htfL5m  = input.string("OFF", "HTF LONG · 5m",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfL15m = input.string("OFF", "HTF LONG · 15m", options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfL30m = input.string("OFF", "HTF LONG · 30m", options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfL1h  = input.string("OFF", "HTF LONG · 1H",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfL4h  = input.string("OFF", "HTF LONG · 4H",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfLD   = input.string("OFF", "HTF LONG · D",   options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfLW   = input.string("OFF", "HTF LONG · W",   options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)

htfS5m  = input.string("OFF", "HTF SHORT · 5m",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfS15m = input.string("OFF", "HTF SHORT · 15m", options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfS30m = input.string("OFF", "HTF SHORT · 30m", options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfS1h  = input.string("OFF", "HTF SHORT · 1H",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfS4h  = input.string("OFF", "HTF SHORT · 4H",  options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfSD   = input.string("OFF", "HTF SHORT · D",   options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)
htfSW   = input.string("OFF", "HTF SHORT · W",   options = ["OFF", "BLUE", "FLAT", "RED"], group = G_HTF)

// ---- 01-8 Research Export --------------------------------------------------
//  ★ Python で Base Signal から再探索するための研究用データ出力スイッチ ★
//    ON にすると、HTF Filter が OFF でも上位足 SAT 背景 (15m / 30m / 1H / 4H /
//    D / W) を計算し、Data Window へ出す。売買ロジックには一切関与しない。
//
//  ★ Research Export の ON / OFF でトレード結果は変わらない ★
//    ・Entry 判定に使う htfLongPass / htfShortPass は従来どおり useHtfFilter
//      だけで制御している (下の 04c を参照)。useHtfFilter = false なら
//      両方とも常に true のまま。
//    ・このスイッチが変えるのは「上位足背景を計算するかどうか」だけで、
//      計算した値は Data Window と Debug Table にしか流れない。
var string G_RESEARCH = "08 · Research Export"
exportResearchData = input.bool(false, "Research CSV 用データを計算", group = G_RESEARCH,
     tooltip = "ON にすると HTF Filter が OFF でも上位足 SAT 背景を計算し、\n" +
     "Data Window へ出力する (CSV エクスポート用)。\n" +
     "★ Entry 条件には一切使わない。ON / OFF でバックテスト結果は変わらない。\n" +
     "★ 既定 OFF。通常運用では上位足の request.security を発行しない。")

// ============================================================================
// 02. SAT BAND Reconstruction 計算関数
// ----------------------------------------------------------------------------
//  ★ ここに書かれた計算式は SAT BAND Reconstruction Test そのもの。
//  ★ この関数を チャート足 (15s) と request.security() の中 (30s / 1m / 5m) の
//    両方から呼ぶため、4つの時間足で判定式が食い違うことが構造的に起きない。
//  ★ 関数内の var は呼び出し箇所ごとに独立した State を持つ。
//    15s / 30s / 1m / 5m の anchor / dir / stbDir が混ざることはない。
// ============================================================================

// ソース文字列から価格系列を取得する
f_src(simple string t) =>
    switch t
        "close" => close
        "open"  => open
        "hl2"   => hl2
        "hlc3"  => hlc3
        "ohlc4" => ohlc4
        "hlcc4" => hlcc4
        =>         hl2

// 移動平均の種別切り替え
f_ma(simple string t, float src, simple int len) =>
    switch t
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        =>       ta.ema(src, len)

// ============================================================================
//  SAT BAND Reconstruction  —  LINE1 / LINE2 / STB / Background
// ----------------------------------------------------------------------------
//  「SAT BAND Reconstruction Test」の計算式をそのまま移植したもの。
//  見た目を合わせるための補正・追加平滑化・Confirm などは一切入れていない。
//
//  構造:
//     basis  = ta.vwma(hlc3, 5)
//     common = basis * 0.5
//     atr50  = ta.atr(50)[1]
//     src      = close[1] * 0.5
//     trigLow  = low[1]   * 0.5
//     trigHigh = high[1]  * 0.5
//
//     LINE1 (k = 5.0) / LINE2 (k = 2.5) とも同じ State 機械:
//       Bull(+1) 中 : trigLow  < prevAnchor → Bear へ反転し anchor = src + k * atr50
//                     それ以外              → anchor = math.max(prevAnchor, src - k * atr50)
//       Bear(-1) 中 : trigHigh > prevAnchor → Bull へ反転し anchor = src - k * atr50
//                     それ以外              → anchor = math.min(prevAnchor, src + k * atr50)
//
//     line = common + anchor
//
//  ★ State の独立性 ★
//    anchor1 / dir1 / anchor2 / dir2 / stbDir はこの関数内の var。
//    Pine では var は「呼び出し箇所ごと」に独立したインスタンスを持つため、
//      ・チャート足 (15秒) の直接呼び出し
//      ・request.security(30S, ...) 内の呼び出し
//      ・request.security(1,   ...) 内の呼び出し
//      ・request.security(5,   ...) 内の呼び出し
//    の 4 つで State が混ざることはない。LINE1 と LINE2 も別変数なので共有しない。
//
//  ★ 戻り値
//    [bgState, line1, dir1, line2, dir2, stb, stbDir,
//     basis, common, atr50, anchor1, anchor2]
//    後半 5 つは Data Window 用の診断値で、Entry 判定には一切使わない。
// ============================================================================
f_satRebuild() =>
    // ---- 共通 Basis (SMA でも EMA でもなく VWMA) --------------------------
    float basis  = ta.vwma(hlc3, 5)
    float common = basis * 0.5

    // ---- ATR (ta.atr なので内部は RMA。現在足ではなく 1 本前の値) ---------
    float atr50 = ta.atr(50)[1]

    // ---- Anchor 共通 source と State 反転判定用の値 -----------------------
    //  いずれも 1 本前の足から作る。現在足は使わない。
    float src      = close[1] * 0.5
    float trigLow  = low[1]   * 0.5
    float trigHigh = high[1]  * 0.5

    bool ready = not na(atr50) and not na(src) and not na(trigLow) and not na(trigHigh)

    // ---- LINE1 (k = 5.0) --------------------------------------------------
    //  ※ 同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //    判定前に prevAnchor1 / prevDir1 へ退避してから State を更新する。
    float k1 = 5.0
    var float anchor1 = na
    var int   dir1    = 1
    float prevAnchor1 = anchor1
    int   prevDir1    = dir1
    if ready
        if na(prevAnchor1)
            // 初期化：Bull から開始する
            anchor1 := src - k1 * atr50
            dir1    := 1
        else if prevDir1 == 1
            if trigLow < prevAnchor1
                // Bull → Bear
                dir1    := -1
                anchor1 := src + k1 * atr50
            else
                dir1    := 1
                anchor1 := math.max(prevAnchor1, src - k1 * atr50)
        else
            if trigHigh > prevAnchor1
                // Bear → Bull
                dir1    := 1
                anchor1 := src - k1 * atr50
            else
                dir1    := -1
                anchor1 := math.min(prevAnchor1, src + k1 * atr50)
    float line1 = common + anchor1

    // ---- LINE2 (k = 2.5) --------------------------------------------------
    //  LINE1 と構造は完全に同じ。違うのは倍率だけ。
    //  状態変数は LINE1 とは独立しており、互いを参照しない。
    float k2 = 2.5
    var float anchor2 = na
    var int   dir2    = 1
    float prevAnchor2 = anchor2
    int   prevDir2    = dir2
    if ready
        if na(prevAnchor2)
            // 初期化：Bull から開始する
            anchor2 := src - k2 * atr50
            dir2    := 1
        else if prevDir2 == 1
            if trigLow < prevAnchor2
                // Bull → Bear
                dir2    := -1
                anchor2 := src + k2 * atr50
            else
                dir2    := 1
                anchor2 := math.max(prevAnchor2, src - k2 * atr50)
        else
            if trigHigh > prevAnchor2
                // Bear → Bull
                dir2    := 1
                anchor2 := src - k2 * atr50
            else
                dir2    := -1
                anchor2 := math.min(prevAnchor2, src + k2 * atr50)
    float line2 = common + anchor2

    // ---- STB (Donchian 構造) ----------------------------------------------
    //  LINE1 / LINE2 の State とは完全に独立。互いを参照しない。
    //  ATR / EMA / Supertrend は一切使わない。
    //    表示用     : ta.highest(high, 10) / ta.lowest(low, 10)
    //    方向判定用 : ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //  方向転換は毎バー high breakout を先に判定する。同じ足で上下両方を
    //  突破した場合も else if の構造により Bull(+1) が優先される。
    //  どちらも突破していなければ直前の State を維持する。
    float stbUpper = ta.highest(high, 10)
    float stbLower = ta.lowest(low, 10)
    float prev20High = ta.highest(high, 20)[1]
    float prev20Low  = ta.lowest(low, 20)[1]
    var int stbDir = 1
    if not na(prev20High) and not na(prev20Low)
        if high > prev20High
            stbDir := 1
        else if low < prev20Low
            stbDir := -1
    // UP は下側 (lower10)、DOWN は上側 (upper10) を表示価格にする
    float stb = stbDir == 1 ? stbLower : stbUpper

    // ---- Background State --------------------------------------------------
    //  各ラインの dir ではなく、現在の close と LINE1 / LINE2 / STB の
    //  位置関係だけで決める。判定ソースは close 固定 (bgSrcMode は廃止)。
    //    close が 3 本すべてより上 → +1 (BLUE)
    //    close が 3 本すべてより下 → -1 (RED)
    //    それ以外                  →  0 (FLAT)
    bool allAbove = close > line1 and close > line2 and close > stb
    bool allBelow = close < line1 and close < line2 and close < stb
    int bgState = 0
    if allAbove
        bgState := 1
    else if allBelow
        bgState := -1

    [bgState, line1, dir1, line2, dir2, stb, stbDir, basis, common, atr50, anchor1, anchor2]

// ----------------------------------------------------------------------------
// [SAT] 上位足用ラッパー : 「最後に確定した HTF バー」の背景 State だけを返す
//
//   ★ 内部の [1] と 外側の bgv[1] は目的が違う。どちらも必要 ★
//     内部 [1] (atr50 = ta.atr(50)[1] / src = close[1] * 0.5 など)
//         … Reconstruction の計算式そのもの。SAT の定義の一部。
//     外側 bgv[1]
//         … 「最後に確定した HTF バー」の背景を取り出すためのもの。
//           request.security の中 (HTF の時系列) で適用するので、
//           返るのは必ず確定済み HTF バーの値になる。
//
//   ★ 呼び出し側は barmerge.lookahead_on と組み合わせる (この [1] とセット) ★
//     lookahead_on 単独は未来参照になるので絶対に使わない。
//     [1] が確定済みバーを指しているので、lookahead_on が前借りするのは
//     その確定済みバーの値だけになり、未来の情報は入らない。
//     lookahead_off + [1] は HTF バー切り替わり直後にもう 1 本ぶん古い値を
//     返しうるため、ヒストリカルとリアルタイムで参照する確定バーがずれる。
// ----------------------------------------------------------------------------
f_satBgHtf() =>
    [bgRaw, _r1, _r2, _r3, _r4, _r5, _r6, _r7, _r8, _r9, _r10, _r11] = f_satRebuild()
    // タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
    int bgv = bgRaw
    bgv[1]

// 表示用の小さなヘルパー
f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)
f_bgStr(int b) =>
    b == 1 ? "青 (BLUE)" : b == -1 ? "赤 (RED)" : "フラット (FLAT)"
f_bgCol(int b) =>
    b == 1 ? bgBuyCol : b == -1 ? bgSellCol : color.rgb(149, 152, 161)
f_longStateStr(int s) =>
    s == ST_WAIT ? "WAIT_INITIAL" : s == ST_ARMED ? "ARMED (青)" : s == ST_FLAT ? "SAW_FLAT" :
     s == ST_OPP ? "SAW_RED" : s == ST_B_CONFIRM ? "B_CONFIRM_FLAT" :
     s == ST_SETUP_CONFIRM ? "WAIT_MID_CONFIRM" : "SHALLOW_FLAT"
f_shortStateStr(int s) =>
    s == ST_WAIT ? "WAIT_INITIAL" : s == ST_ARMED ? "ARMED (赤)" : s == ST_FLAT ? "SAW_FLAT" :
     s == ST_OPP ? "SAW_BLUE" : s == ST_B_CONFIRM ? "B_CONFIRM_FLAT" :
     s == ST_SETUP_CONFIRM ? "WAIT_MID_CONFIRM" : "SHALLOW_FLAT"
//  HTF SAT Filter : 条件が有効か (OFF 以外か)
f_htfAct(string c) =>
    c == "OFF" ? 0 : 1
//  HTF SAT Filter : その時間足の背景が条件に一致したか (1 = 一致 / 0 = 不一致)
//  OFF のときは常に 0 を返す (f_htfAct と合わせて「判定対象外」になる)。
f_htfHit(int bg, string c) =>
    int r = 0
    if c == "BLUE" and bg == BG_BLUE
        r := 1
    else if c == "FLAT" and bg == BG_FLAT
        r := 1
    else if c == "RED" and bg == BG_RED
        r := 1
    r
//  Debug 表示用 : 背景 State の 1 文字表記
f_bgChar(int b) =>
    b == 1 ? "B" : b == -1 ? "R" : "F"
//  Pattern コード (1 = Pattern A / 2 = Pattern B / 0 = 未設定) → 表示名。
//  0 が出たら pending の保存漏れなので、B と誤表示せず "?" で見えるようにする。
f_patternName(int p) =>
    p == 1 ? "Pattern A" : p == 2 ? "Pattern B" : "Pattern ?"
//  1分 色遷移 State の表示名。isLong = true なら LONG 視点 (反対色 = 赤)。
f_trStateStr(int s, bool isLong) =>
    string opp = isLong ? "RED"  : "BLUE"
    string val = isLong ? "BLUE" : "RED"
    s == 0 ? "WAIT_" + opp : s == 1 ? "SAW_" + opp : s == 2 ? opp + "_THEN_FLAT" : "VALID_" + val

// ============================================================================
// 03. SAT 背景 : 15s (チャート足) / 30s / 1m / 5m
// ----------------------------------------------------------------------------
//  すべて同一の f_satRebuild() を使う。時間足ごとに別の近似式は書かない。
//  15秒はチャート足で直接評価し、LINE1 / LINE2 / STB の価格と方向も受け取る
//  (チャート描画用)。30秒 / 1分 / 5分は背景 State だけを取得する。
// ============================================================================
[bg15, satL1Line, satL1Dir, satL2Line, satL2Dir, satStbLine, satStbDir,
     satBasis, satCommon, satAtr50, satAnchor1, satAnchor2] = f_satRebuild()

// ---- 30秒 / 1分 / 5分 : それぞれ独立した時間足コンテキストで再計算 ---------
//  ★ 15秒で計算したラインは流用していない。request.security() の中で
//    f_satRebuild() そのものを評価しているため、VWMA / ATR / Anchor State /
//    STB State はすべてその時間足自身の OHLC から作られる。
//  ★ 関数内の var (anchor1 / anchor2 / dir1 / dir2 / stbDir) は呼び出し箇所ごとに
//    独立するので、15秒 / 30秒 / 1分 / 5分の State が混ざることはない。
int bg30 = nz(request.security(syminfo.tickerid, satTf30, f_satBgHtf(),
     lookahead = barmerge.lookahead_on), 0)

int bg1m = nz(request.security(syminfo.tickerid, satTf1m, f_satBgHtf(),
     lookahead = barmerge.lookahead_on), 0)

// ---- Entry Filter ② 用 : 5分足 SAT 背景 ------------------------------------
//  ★ ZoneEngine の Base TF とは別概念。SAT の LINE1 / LINE2 / STB / 背景 を
//    5分足自身の OHLC から再計算したもの。15秒足のラインは流用していない。
int bg5m = nz(request.security(syminfo.tickerid, satTf5m, f_satBgHtf(),
     lookahead = barmerge.lookahead_on), 0)

// ---- HTF SAT Background Filter 用 : 15分 / 30分 / 1時間 / 4時間 / 日足 / 週足 --
//  ★ 5分は上の bg5m をそのまま流用する (重複 request を作らない)。
//  ★ どれも f_satBgHtf() ([1] + lookahead_on)。形成中の上位足は使わず、
//    最後に確定した HTF 背景だけを見る。
//  ★ 15秒 SAT の値を流用せず、request.security の中で f_satRebuild() が
//    その時間足自身の OHLC から再計算する (関数内の var は呼び出し箇所ごとに独立)。
//  ★ 取得するのは useHtfFilter か exportResearchData のどちらかが ON のとき。
//    どちらも OFF なら request を 1 本も発行しない (bg は 0 のまま)。
//  ★ exportResearchData だけが ON のときは「計算して Data Window へ出すだけ」。
//    Entry 判定に使う htfLongPass / htfShortPass は 04c で useHtfFilter だけを
//    見ているため、Research Export の ON / OFF でトレード結果は変わらない。
bool needHtfResearchData = useHtfFilter or exportResearchData

int bg15m    = 0
int bg30mHtf = 0
int bg1h     = 0
int bg4h     = 0
int bgD      = 0
int bgW      = 0
if needHtfResearchData
    bg15m    := nz(request.security(syminfo.tickerid, "15",  f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)
    bg30mHtf := nz(request.security(syminfo.tickerid, "30",  f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)
    bg1h     := nz(request.security(syminfo.tickerid, "60",  f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)
    bg4h     := nz(request.security(syminfo.tickerid, "240", f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)
    bgD      := nz(request.security(syminfo.tickerid, "D",   f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)
    bgW      := nz(request.security(syminfo.tickerid, "W",   f_satBgHtf(), lookahead = barmerge.lookahead_on), 0)

// 移動平均線 (表示のみ・背景判定には使わない)
float maSrc = f_src(maSrcType)
float maVal = f_ma(maType, maSrc, maLen)
int   maDir = maVal > maVal[1] ? 1 : maVal < maVal[1] ? -1 : 0

// ============================================================================
// 03b. ENTRY FILTER ① : 1分足 色遷移 State Machine
// ----------------------------------------------------------------------------
//  「現在の1分Regimeが、反対色から始まったRegimeか」を判定する。
//
//   LONG 有効パターン   1分 赤 → 青
//                       1分 赤 → フラット(1本以上) → 青
//   SHORT 有効パターン  1分 青 → 赤
//                       1分 青 → フラット(1本以上) → 赤
//   フラットは複数本連続してもよい。
//
//  ★ 有効期間 : その色を維持している間だけ。
//    LONG は1分背景が青でなくなった時点 (フラット / 赤) で無効化する。
//    「過去に一度 赤→青 になったから永久に有効」ではない。
//
//  ★ 更新タイミング (重要) ★
//    bg1m は15秒チャート上では同じ確定1分背景が複数の15秒バーにわたって保持される。
//    そのため15秒足ごとに遷移判定をしてはいけない (同じ1分背景を4回処理してしまう)。
//    time(satTf1m) が切り替わった最初の15秒足 = 新しい確定1分足が bg1m へ
//    反映されたタイミングでだけ State を更新する。1分足1本につき必ず1回。
//    (bg1m は security 内部で [1] + lookahead_on を掛けているため、
//     この瞬間にちょうど「いま閉じた1分足」の背景へ切り替わる)
// ============================================================================
int TR_WAIT_OPP = 0   // LONG: WAIT_RED      / SHORT: WAIT_BLUE
int TR_SAW_OPP  = 1   // LONG: SAW_RED       / SHORT: SAW_BLUE
int TR_OPP_FLAT = 2   // LONG: RED_THEN_FLAT / SHORT: BLUE_THEN_FLAT
int TR_VALID    = 3   // LONG: VALID_BLUE    / SHORT: VALID_RED

//  1分足が1本確定して bg1m が切り替わったバーで true。
//  time() は request.security ではないので毎バー無条件に評価してよい。
int  tf1mChange     = nz(ta.change(time(satTf1m)), 0)
bool newConfirmed1m = bar_index > 0 and tf1mChange != 0

// ----------------------------------------------------------------------------
//  LONG / SHORT で同じ関数を使う (呼び出し箇所ごとに var State は独立する)。
//    LONG  : oppColor = 赤   / validColor = 青
//    SHORT : oppColor = 青   / validColor = 赤
//  これにより SHORT が LONG の完全対称であることがコード上で保証される。
//
//    WAIT_OPP  : 反対色を見たら SAW_OPP / それ以外は維持
//                (反対色を経ていない有効色はここでは valid にしない)
//    SAW_OPP   : 反対色なら維持 / フラットなら OPP_FLAT / 有効色なら VALID
//    OPP_FLAT  : フラットなら維持 / 有効色なら VALID / 反対色なら SAW_OPP
//    VALID     : 有効色なら維持 / フラットなら WAIT_OPP (無効化) / 反対色なら SAW_OPP
//
//  ※ VALID からフラットへ抜けたら WAIT_OPP へ戻す。
//    そうしないと 青 → フラット → 青 が valid になってしまい、
//    「反対色から始まった Regime か」という条件が崩れるため。
// ----------------------------------------------------------------------------
f_1mTransition(int bg, int oppColor, int validColor, bool doUpdate) =>
    var int st = 0
    if doUpdate
        if st == TR_WAIT_OPP
            if bg == oppColor
                st := TR_SAW_OPP
        else if st == TR_SAW_OPP
            if bg == validColor
                st := TR_VALID
            else if bg == BG_FLAT
                st := TR_OPP_FLAT
        else if st == TR_OPP_FLAT
            if bg == validColor
                st := TR_VALID
            else if bg == oppColor
                st := TR_SAW_OPP
        else
            if bg == oppColor
                st := TR_SAW_OPP
            else if bg == BG_FLAT
                st := TR_WAIT_OPP
    st

int  long1mTrState  = f_1mTransition(bg1m, BG_RED,  BG_BLUE, newConfirmed1m)
int  short1mTrState = f_1mTransition(bg1m, BG_BLUE, BG_RED,  newConfirmed1m)

// ---- ① の有効期間 : 転換後 N 本の確定1分足だけ VALID ----------------------
//  ★ カウントは確定1分足単位。newConfirmed1m のときだけ更新し、
//    15秒足ごとには数えない (同じ確定1分足を4回数えてしまうため)。
//  ★ f_1mTransition() の評価はこの上で済んでいるので、転換した最初の1分足では
//    すでに long1mTrState == TR_VALID になっている。そこでカウンターが
//    0 → 1 になるため、「転換直後の1本目 = カウンター 1」が保証される。
//    したがって transitionValidBars = 1 なら転換直後の1本だけが VALID。
//  ★ 色が崩れて TR_VALID を外れたバーでカウンターは 0 に戻る。
//    その後また有効色へ戻っても、新しく反対色からの転換が成立しない限り
//    State が TR_VALID にならないので VALID には戻らない。
//  ★ LONG / SHORT でカウンターは完全に独立。
var int long1mValidBars  = 0
var int short1mValidBars = 0
if newConfirmed1m
    long1mValidBars  := long1mTrState  == TR_VALID ? long1mValidBars  + 1 : 0
    short1mValidBars := short1mTrState == TR_VALID ? short1mValidBars + 1 : 0

bool long1mTransitionValid  = long1mTrState  == TR_VALID and long1mValidBars  >= 1 and long1mValidBars  <= transitionValidBars
bool short1mTransitionValid = short1mTrState == TR_VALID and short1mValidBars >= 1 and short1mValidBars <= transitionValidBars

// ============================================================================
// 03c. CANDIDATE_3 ～ CANDIDATE_7 用 : 上位足 Setup イベント検出
// ----------------------------------------------------------------------------
//  ★ ここで作る値を参照するのは Section 04 の CANDIDATE_3 ～ CANDIDATE_7 だけ。
//    CURRENT / CANDIDATE_1 / CANDIDATE_2 の判定には一切関与しない。
//  ★ 5分転換イベント (newConfirmed5m / bg5mTurnedBlue / bg5mTurnedRed) は
//    もともと 04b (Entry Filter ②) の中にあったものを、Section 04 から参照できる
//    ように「位置だけ」この上へ移したもの。計算式・初期化ガードは変えていない。
//    Entry Filter ② は引き続き同じ値をそのまま使う。
// ============================================================================

// ---- 確定5分背景が「目的色へ切り替わった」イベント --------------------------
//  bg5m は security 内部で [1] + lookahead_on を掛けているため、
//  time(satTf5m) が切り替わった最初の15秒足でちょうど「いま閉じた5分足」の
//  背景へ更新される。そのタイミングだけを見て遷移を判定する。
//  5分足1本につき必ず1回。形成中5分足は使わない。
int  tf5mChange     = nz(ta.change(time(satTf5m)), 0)
bool newConfirmed5m = bar_index > 0 and tf5mChange != 0

//  ★ 最初の確定5分更新は「初期化だけ」に使い、転換イベントを発生させない ★
//    bg5mPrevConfirmed の初期値 0 (FLAT) をそのまま前回値として扱うと、
//    履歴開始後に最初に得られた確定5分背景が BLUE / RED だった場合に
//    0 → BLUE / RED を色転換と誤認してしまう。
//    そのため bg5mPrevReady が立つまでは前回値を記録するだけにする。
//    2 回目以降の確定5分更新から「前回非BLUE → 今回BLUE」
//    「前回非RED → 今回RED」を転換イベントとして判定する。
var int  bg5mPrevConfirmed = 0
var bool bg5mPrevReady     = false
bool bg5mTurnedBlue = false
bool bg5mTurnedRed  = false
if newConfirmed5m
    if bg5mPrevReady
        bg5mTurnedBlue := bg5m == BG_BLUE and bg5mPrevConfirmed != BG_BLUE
        bg5mTurnedRed  := bg5m == BG_RED  and bg5mPrevConfirmed != BG_RED
    bg5mPrevConfirmed := bg5m
    bg5mPrevReady     := true

// ---- 5m 転換の「起点」分類 (CANDIDATE_15 / CANDIDATE_16 用) -----------------
//  ★ 上の bg5mTurnedBlue / bg5mTurnedRed には一切手を入れていない ★
//    あちらは「前回が目的色以外 → 今回目的色」をまとめて 1 種類として扱う。
//    ここはそれを壊さずに、前回の確定背景が FLAT だったのか反対色だったのかで
//    分類し直したもの。専用の var を持つので既存の判定とは独立している。
//  ★ bg5mPrevConfirmed は上のブロックで既に今回値へ更新済みなので使えない。
//    そのため分類用に別の「前回値」変数を持ち、更新前の値で判定する。
//  ★ 初期化ガードの考え方は上と同じ。最初の確定5分更新は記録するだけにして、
//    履歴開始直後の 0 (FLAT) を転換元と誤認しないようにする。
//  ★ 恒等式 : bg5mTurnedBlue == (bg5mBlueFromFlat or bg5mBlueFromRed)
//             bg5mTurnedRed  == (bg5mRedFromFlat  or bg5mRedFromBlue)
//    「目的色以外」は FLAT か反対色のどちらかしかないため。
var int  bg5mPrevForClass = 0
var bool bg5mClassReady   = false
bool bg5mBlueFromFlat = false
bool bg5mBlueFromRed  = false
bool bg5mRedFromFlat  = false
bool bg5mRedFromBlue  = false
if newConfirmed5m
    if bg5mClassReady
        bg5mBlueFromFlat := bg5m == BG_BLUE and bg5mPrevForClass == BG_FLAT
        bg5mBlueFromRed  := bg5m == BG_BLUE and bg5mPrevForClass == BG_RED
        bg5mRedFromFlat  := bg5m == BG_RED  and bg5mPrevForClass == BG_FLAT
        bg5mRedFromBlue  := bg5m == BG_RED  and bg5mPrevForClass == BG_BLUE
    bg5mPrevForClass := bg5m
    bg5mClassReady   := true

// ---- 確定1分背景が「目的色へ切り替わった」イベント --------------------------
//  ★ bg1m は15秒チャート上で同じ値が4本続くため、bg1m != bg1m[1] のような
//    単純比較では判定できない。newConfirmed1m (= time(satTf1m) が切り替わった
//    最初の15秒足) のときだけ「ひとつ前の確定1分背景」と比較する。
//    これで1分足1本につき必ず1回だけ転換判定が走る。
//  ★ 最初の確定1分更新は「初期化だけ」に使い、転換イベントを発生させない。
//    prevConfirmedBg1m が na の間は記録するだけにする (5分側と同じ考え方)。
//  ★ 形成中の1分足は使わない。bg1m は security 内部で [1] + lookahead_on を
//    掛けているため、常に「最後に確定した1分足」の背景である。
var int prevConfirmedBg1m = na

bool bg1mTurnedBlue = false
bool bg1mTurnedRed  = false
if newConfirmed1m
    bg1mTurnedBlue := not na(prevConfirmedBg1m) and prevConfirmedBg1m != BG_BLUE and bg1m == BG_BLUE
    bg1mTurnedRed  := not na(prevConfirmedBg1m) and prevConfirmedBg1m != BG_RED  and bg1m == BG_RED
    prevConfirmedBg1m := bg1m

// ---- 確定30秒足の更新イベント (CANDIDATE_6 の中間確認に使う) ----------------
//  形成中の30秒足は使わない。bg30 は security 内部で [1] + lookahead_on なので、
//  この更新タイミングでちょうど「いま閉じた30秒足」の背景へ切り替わる。
int  tf30Change      = nz(ta.change(time(satTf30)), 0)
bool newConfirmed30s = bar_index > 0 and tf30Change != 0

// ----------------------------------------------------------------------------
//  C3 ～ C7 共通の Setup → 15秒 Trigger State Machine
//
//  ★ 15秒 Trigger は 5 候補すべて同一。違うのは「Setup をどう始めるか」だけ。
//    今回は Trigger の違いを比較しないので、FLAT → 目的色の復帰待ちや
//    Pattern A / ローソク足 / EMA / Zone / ATR などは一切入れていない。
//
//  State の意味 (C3 ～ C7)
//    ST_WAIT          : 新しい Setup Event を待っている
//    ST_SETUP_CONFIRM : 中間時間足の確認待ち (C6 / C7 だけが使う)
//    ST_ARMED         : Setup 成立済み。15秒の最初の Opposite を待っている
//    ST_OPP           : 15秒 Opposite を確認済み。FLAT への回復を待っている
//    ※ ST_FLAT / ST_B_CONFIRM は C3 ～ C7 では使わない。
//
//  1バーの処理順 (この順序が時間順序の保証そのもの)
//    1) Setup キャンセル判定
//    2) 15秒 Trigger 判定
//    3) 中間時間足の確認 (ST_SETUP_CONFIRM → ST_ARMED)
//    4) 新しい Setup Event (ST_WAIT → ST_SETUP_CONFIRM / ST_ARMED)
//
//    3) が 2) より後なので「確認が成立したバー」では Trigger 判定を始めない。
//    4) が 3) より後なので「Setup Event のバー」では確認判定も Trigger 判定も
//    始めない。どちらも必ず「次の確定15秒足」からになる。
//
//  Trigger (LONG の場合。SHORT は oppColor を BG_BLUE にするだけの完全対称)
//    ST_ARMED : bg15 == RED       → ST_OPP
//               それ以外           → ST_ARMED 維持
//    ST_OPP   : bg15 == RED       → ST_OPP 維持 (RED は何本続いてもよい)
//               bg15 == FLAT      → Signal を出して ST_WAIT (Setup を消費)
//               bg15 == BLUE      → Signal なしで ST_WAIT (FLAT を通らなかった)
//
//  ★ Signal を出したらその場で ST_WAIT に戻す。実際に発注できたかどうかは見ない。
//    Entry Filter で落ちても / ポジション保有中でも / Qty 不足でも、
//    同じ Setup から 2 回目の Trigger は出さない。
//    新しい Setup Event が来るまで再 ARM しない (Fresh Setup 厳守)。
//
//  ★ LONG / SHORT で同じ関数を使うことで、条件・State 遷移・キャンセル条件が
//    完全対称であることをコード上で保証する。
//  ★ 関数内に var / ta.* を持たないので、呼び出し位置による履歴のズレは起きない。
// ----------------------------------------------------------------------------
f_setupTrigger(int stIn, bool setupEvent, bool setupAlive, bool useConfirm,
     bool confirmEvent, bool confirmAlive, int bgTrig, int oppColor) =>
    int  st  = stIn
    bool sig = false
    //  1) Setup キャンセル
    if st == ST_SETUP_CONFIRM
        if not confirmAlive
            st := ST_WAIT
    else if st != ST_WAIT
        if not setupAlive
            st := ST_WAIT
    //  2) 15秒 Trigger
    if st == ST_ARMED
        if bgTrig == oppColor
            st := ST_OPP
    else if st == ST_OPP
        if bgTrig == BG_FLAT
            //  Opposite → FLAT : Signal を出して Setup を消費する
            sig := true
            st  := ST_WAIT
        else if bgTrig != oppColor
            //  FLAT を通らず目的色へ直接戻った → Signal なしで Setup 終了
            st := ST_WAIT
    //  3) 中間時間足の確認
    if st == ST_SETUP_CONFIRM and confirmEvent
        st := ST_ARMED
    //  4) 新しい Setup Event
    if st == ST_WAIT and setupEvent
        st := useConfirm ? ST_SETUP_CONFIRM : ST_ARMED
    [st, sig]

// ----------------------------------------------------------------------------
//  CANDIDATE_9 ～ CANDIDATE_12 用の 15秒 Trigger Variant
//
//  ★ 既存の f_setupTrigger() には一切手を入れていない ★
//    C3 ～ C8 は従来どおり f_setupTrigger() を使う。こちらは完全に別関数で、
//    C9 ～ C12 だけが呼ぶ。互いの挙動に影響しない。
//
//  Setup の作り方は 4 候補とも C7 と完全に同一 (5m 転換 → 1m 確認 → ARM)。
//  違うのは「どの押し戻し方を Signal として認めるか」だけ。
//
//  1バーの処理順は f_setupTrigger() と同じ
//    1) Setup キャンセル → 2) 15秒 Trigger → 3) 中間確認 → 4) 新しい Setup Event
//    3) が 2) より後なので Confirm バーでは Trigger 判定を始めない。
//    4) が 3) より後なので Event バーでは確認も Trigger も始めない。
//
//  State (LONG 表記。SHORT は targetColor / oppColor を入れ替えた完全対称)
//    ST_SETUP_CONFIRM : 5m 転換済み。確定1分の同方向確認待ち
//    ST_ARMED         : Setup 成立。押しを待っている
//    ST_OPP           : 15s が Opposite まで押した (深い押し)
//    ST_SHALLOW       : 15s が FLAT までしか押していない (浅い押し)
//
//  triggerMode ごとの ST_ARMED からの分岐
//    TM_DEEP_DIRECT     Opposite → ST_OPP      / FLAT → ST_ARMED 維持
//    TM_SHALLOW_ONLY    Opposite → Setup 終了   / FLAT → ST_SHALLOW
//    TM_DEEP_OR_SHALLOW Opposite → ST_OPP      / FLAT → ST_SHALLOW
//    TM_ANY_RECOVERY    Opposite → ST_OPP      / FLAT → ST_SHALLOW
//
//  ★ TM_SHALLOW_ONLY で Opposite を見たら Setup を終了する ★
//    「15s が Opposite まで行った場合はこの候補では取らない」ため、
//    ST_SHALLOW から Opposite へ深くなったとき (Signal なしで ST_WAIT) と
//    同じ扱いにしてある。浅い押し単独の性能だけを測るための設計。
//
//  ★ Signal を出したらその Setup は消費して ST_WAIT へ戻す ★
//    実際に発注できたかどうかは見ない。新しい 5m 転換が来るまで再 ARM しない。
//
//  戻り値 : [次の State, Signal か, Trigger 種別 (TT_*)]
//    Trigger 種別は Data Window / Debug 表示専用。Entry 判定には使わない。
// ----------------------------------------------------------------------------
f_setupTriggerVariant(int stIn, bool setupEvent, bool setupAlive, bool confirmEvent,
     bool confirmAlive, int bgTrig, int targetColor, int oppColor, int triggerMode) =>
    int  st  = stIn
    bool sig = false
    int  tt  = TT_NONE
    bool useShallow = triggerMode == TM_SHALLOW_ONLY or triggerMode == TM_DEEP_OR_SHALLOW or
     triggerMode == TM_ANY_RECOVERY
    bool useDirect  = triggerMode == TM_DEEP_DIRECT or triggerMode == TM_ANY_RECOVERY
    bool useDeep    = triggerMode != TM_SHALLOW_ONLY
    //  1) Setup キャンセル
    if st == ST_SETUP_CONFIRM
        if not confirmAlive
            st := ST_WAIT
    else if st != ST_WAIT
        if not setupAlive
            st := ST_WAIT
    //  2) 15秒 Trigger
    if st == ST_ARMED
        if bgTrig == oppColor
            //  深い押し。Deep を使わない候補ではこの Setup は対象外にする
            st := useDeep ? ST_OPP : ST_WAIT
        else if bgTrig == BG_FLAT and useShallow
            st := ST_SHALLOW
    else if st == ST_OPP
        if bgTrig == BG_FLAT
            //  Deep Recovery : Opposite → FLAT
            sig := true
            tt  := TT_DEEP
            st  := ST_WAIT
        else if bgTrig == targetColor
            //  Direct Recovery : Opposite → 目的色 へ直接復帰
            //  認めない候補では Signal なしでそのまま Setup 終了 (C7 と同じ扱い)
            if useDirect
                sig := true
                tt  := TT_DIRECT
            st := ST_WAIT
    else if st == ST_SHALLOW
        if bgTrig == targetColor
            //  Shallow Recovery : FLAT → 目的色
            sig := true
            tt  := TT_SHALLOW
            st  := ST_WAIT
        else if bgTrig == oppColor
            //  浅い押しからさらに深くなった。Deep を使う候補は Deep として追跡し、
            //  TM_SHALLOW_ONLY は対象外なので Signal なしで終了する。
            st := useDeep ? ST_OPP : ST_WAIT
    //  3) 中間時間足の確認 (C9 ～ C12 は 4 つとも C7 と同じ 1m 確認)
    if st == ST_SETUP_CONFIRM and confirmEvent
        st := ST_ARMED
    //  4) 新しい Setup Event
    if st == ST_WAIT and setupEvent
        st := ST_SETUP_CONFIRM
    [st, sig, tt]

// ----------------------------------------------------------------------------
//  CANDIDATE_13 / CANDIDATE_14 用 : 1m 確認に期限をつけた Setup
//
//  ★ 既存の f_setupTrigger() / f_setupTriggerVariant() には一切手を入れていない ★
//    C3 ～ C12 は従来どおりそれらを使う。こちらは完全に別関数。
//
//  C7 との違いは 3) の 1m 確認だけ。
//    C7  : 5m が目的色を維持している限り、確定1分が目的色になるまで無期限に待つ
//    C13 : 5m 転換後「最初の確定1分1本」で目的色にならなければ Setup 終了
//    C14 : 同上。確定1分を最大2本まで待つ
//  ★ 数えるのは確定1分足の本数 (confirmBar) であって15秒足の本数ではない。
//
//  15秒 Trigger は C7 と完全に同じ Deep (Opposite → FLAT) のみ。
//  Shallow / Direct は使わない。
//
//  戻り値 : [次の State, Signal か, 確認待ちに使った確定1分の本数]
//    待ち本数は新しい Setup Event のたびに 0 へリセットする。
// ----------------------------------------------------------------------------
f_setupTriggerLimited(int stIn, int waitIn, bool setupEvent, bool setupAlive,
     bool confirmBar, bool confirmOk, bool confirmAlive, int bgTrig, int oppColor, int maxWait) =>
    int  st   = stIn
    int  wait = waitIn
    bool sig  = false
    //  1) Setup キャンセル
    if st == ST_SETUP_CONFIRM
        if not confirmAlive
            st := ST_WAIT
    else if st != ST_WAIT
        if not setupAlive
            st := ST_WAIT
    //  2) 15秒 Trigger (C7 と同一)
    if st == ST_ARMED
        if bgTrig == oppColor
            st := ST_OPP
    else if st == ST_OPP
        if bgTrig == BG_FLAT
            sig := true
            st  := ST_WAIT
        else if bgTrig != oppColor
            st := ST_WAIT
    //  3) 1m 確認 (期限つき)
    if st == ST_SETUP_CONFIRM and confirmBar
        wait := wait + 1
        if confirmOk
            st := ST_ARMED
        else if wait >= maxWait
            //  期限切れ。この Setup は採用しない
            st := ST_WAIT
    //  4) 新しい Setup Event
    if st == ST_WAIT and setupEvent
        st   := ST_SETUP_CONFIRM
        wait := 0
    [st, sig, wait]

// ----------------------------------------------------------------------------
//  CANDIDATE_17 用 : 1 つの Setup から Deep Signal を最大 2 回まで取る
//
//  ★ 既存の f_setupTrigger() には一切手を入れていない ★
//
//  Setup の作り方も 15秒 Trigger も C7 と完全に同じ。違うのは Setup の消費の仕方。
//    C7  : 1回目の Deep で Setup を消費して ST_WAIT へ戻す
//    C17 : 1回目の Deep では ST_WAIT へ戻さず ST_ARMED へ戻して2回目を待つ
//          2回目の Deep で Setup 終了
//
//  ★ 1回目で ST_ARMED へ戻せるのは Setup がまだ有効なときだけ ★
//    このバーの 1) で setupAlive を確認済みで、false なら ST_WAIT に落ちていて
//    2) の Trigger 自体が走らない。つまりここへ来た時点で Setup は生きている。
//    次のバー以降に bg5m / bg1m が崩れれば 1) で通常どおり ST_WAIT になり、
//    1回しか取れていなくてもその Setup は終了する。
//
//  ★ 数えるのは「Base Signal を出した回数」であって発注できた回数ではない ★
//    Entry Filter NG / ポジション保有中 / Qty 不足 / TradePlan FAIL でも
//    count は進む。Base Signal 生成と Order Engine を独立させるため。
//
//  ★ Opposite から FLAT を通らず目的色へ直接戻った場合は C7 と同じ扱い ★
//    Signal なしで Setup 終了。1回目しか取っていなくても終了する。
//
//  戻り値 : [次の State, Signal か, その Setup で出した Deep Signal の回数]
// ----------------------------------------------------------------------------
f_setupTriggerTwoDeep(int stIn, int cntIn, bool setupEvent, bool setupAlive,
     bool confirmEvent, bool confirmAlive, int bgTrig, int oppColor) =>
    int  st  = stIn
    int  cnt = cntIn
    bool sig = false
    //  1) Setup キャンセル
    if st == ST_SETUP_CONFIRM
        if not confirmAlive
            st := ST_WAIT
    else if st != ST_WAIT
        if not setupAlive
            st := ST_WAIT
    //  2) 15秒 Trigger (C7 と同一の Deep)
    if st == ST_ARMED
        if bgTrig == oppColor
            st := ST_OPP
    else if st == ST_OPP
        if bgTrig == BG_FLAT
            sig := true
            cnt := cnt + 1
            //  1回目は Setup を消費せず再 ARM / 2回目で Setup 終了
            st  := cnt >= 2 ? ST_WAIT : ST_ARMED
        else if bgTrig != oppColor
            st := ST_WAIT
    //  3) 1m 確認 (C7 と同一)
    if st == ST_SETUP_CONFIRM and confirmEvent
        st := ST_ARMED
    //  4) 新しい Setup Event
    if st == ST_WAIT and setupEvent
        st  := ST_SETUP_CONFIRM
        cnt := 0
    [st, sig, cnt]

// ============================================================================
// 04. ENTRY STATE MACHINE
// ----------------------------------------------------------------------------
//  ★ background[2] / background[1] / background だけの判定はしていない。
//    フラット・赤・青が複数本連続しても成立するよう、明示的な State Machine にしてある。
//  ★ LONG と SHORT は完全に別の State を持つ。互いに干渉しない。
//  ★ 判定は確定した15秒足でのみ進める (barstate.isconfirmed)。
//
//  LONG
//    WAIT_INITIAL : 15s青 + 30s青 + 1m青 が同時成立 → ARMED
//                   (この時点では Entry しない。あくまで LONG 待機開始)
//    ARMED        : 青が続く限り ARMED / フラット → SAW_FLAT / 赤 → SAW_RED
//    SAW_FLAT     : フラットが続く限り SAW_FLAT
//                   青 → 【Pattern A Entry】
//                   赤 → SAW_RED
//    SAW_RED      : 赤が続く限り SAW_RED
//                   フラット → 【Pattern B Entry】
//                   青 → ARMED
//    ※ 待機開始後は 30秒足の色を一切問わない (初期成立条件でのみ 30s青 を使う)。
//    ※ 1分足は Entry 成立まで「青を維持」が必須。確定1分背景が青でなくなった
//      時点で LONG 待機状態・15秒パターン進行状態をすべてリセットする。
//
//  SHORT は完全対称 (青と赤を入れ替えるだけ)。
//
//  Entry 後の再アーム (§10)
//    1 回 Entry が成立したら、その方向の待機状態を完全リセット (WAIT_INITIAL) する。
//    次の Entry には再度 15s+30s+1m の初期成立を要求する。
//    ※ パターンは完成したが実際には発注できなかった場合
//      (ZONE の TradePlan FAIL / Qty 不足 / ポジション制御による SKIP) は
//      待機イベントを消費しない。State は「その足で観測した色」に応じた
//      自然な次状態 (Pattern A なら ARMED / Pattern B なら SAW_FLAT) のまま残り、
//      確定1分背景が青 (SHORT は赤) を維持している限り次のチャンスを待てる。
// ============================================================================
var int longState  = ST_WAIT
var int shortState = ST_WAIT

bool barConfirmed = barstate.isconfirmed

int  lsNext     = longState
bool longSigA   = false
bool longSigB   = false
int  ssNext     = shortState
bool shortSigA  = false
bool shortSigB  = false

//  Trigger 種別 (Data Window / Debug 表示専用。Entry 判定には一切使わない)。
//  CURRENT ～ C7 は常に TT_NONE のまま。C8 は Deep 固定。C9 ～ C12 は実際に
//  Signal になった種別が入る。
int  baseTrigType = TT_NONE

//  CANDIDATE_13 / CANDIDATE_14 : 1m 確認待ちに使った確定1分足の本数 (方向別)
//  CANDIDATE_17 : その Setup で出した Deep Signal の回数 (方向別)
//  ★ どれも選択中の Mode でしか更新されない。他の Mode の判定には一切関与しない。
var int c13LongWait1m  = 0
var int c13ShortWait1m = 0
var int c14LongWait1m  = 0
var int c14ShortWait1m = 0
var int c17LongDeep    = 0
var int c17ShortDeep   = 0

if barConfirmed
    if baseSignalMode == BASE_CURRENT
        // ---- LONG ----------------------------------------------------------
        //  1) 1分足ガード : 待機中に確定1分背景が青でなくなったら全リセット
        if lsNext != ST_WAIT and bg1m != BG_BLUE
            lsNext := ST_WAIT
        //  2) State 遷移
        if lsNext == ST_WAIT
            //  初期成立。この青は Pattern の最初の「青」として数える。
            if bg15 == BG_BLUE and bg30 == BG_BLUE and bg1m == BG_BLUE
                lsNext := ST_ARMED
        else if lsNext == ST_ARMED
            if bg15 == BG_FLAT
                lsNext := ST_FLAT
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else if lsNext == ST_FLAT
            if bg15 == BG_BLUE
                //  青 → フラット(複数本可) → 青
                longSigA := true
                lsNext   := ST_ARMED
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else
            if bg15 == BG_FLAT
                //  青 → 赤(複数本可) → フラット
                longSigB := true
                lsNext   := ST_FLAT
            else if bg15 == BG_BLUE
                lsNext := ST_ARMED

        // ---- SHORT (LONG の完全対称) ---------------------------------------
        if ssNext != ST_WAIT and bg1m != BG_RED
            ssNext := ST_WAIT
        if ssNext == ST_WAIT
            if bg15 == BG_RED and bg30 == BG_RED and bg1m == BG_RED
                ssNext := ST_ARMED
        else if ssNext == ST_ARMED
            if bg15 == BG_FLAT
                ssNext := ST_FLAT
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else if ssNext == ST_FLAT
            if bg15 == BG_RED
                //  赤 → フラット(複数本可) → 赤
                shortSigA := true
                ssNext    := ST_ARMED
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else
            if bg15 == BG_FLAT
                //  赤 → 青(複数本可) → フラット
                shortSigB := true
                ssNext    := ST_FLAT
            else if bg15 == BG_RED
                ssNext := ST_ARMED

    else if baseSignalMode == BASE_C1
        // ---- CANDIDATE_1 -----------------------------------------------
        //  CURRENT の15秒 State 遷移をそのまま使い、次の 3 点だけを変える。
        //    ・ARM 条件から 1分背景を外す (15s + 30s の同方向一致だけ)
        //    ・ARM 後の1分ガードを実行しない (色が崩れてもリセットしない)
        //    ・Pattern A は Signal にしない (State 遷移だけ行う)
        //  追加の条件は入れていない。
        // ---- LONG ------------------------------------------------------
        if lsNext == ST_WAIT
            if bg15 == BG_BLUE and bg30 == BG_BLUE
                lsNext := ST_ARMED
        else if lsNext == ST_ARMED
            if bg15 == BG_FLAT
                lsNext := ST_FLAT
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else if lsNext == ST_FLAT
            if bg15 == BG_BLUE
                //  青 → フラット → 青 : State は ARMED へ戻すが Signal にはしない
                lsNext := ST_ARMED
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else
            if bg15 == BG_FLAT
                //  青 → 赤(複数本可) → フラット  ← Pattern B のみ Signal
                longSigB := true
                lsNext   := ST_FLAT
            else if bg15 == BG_BLUE
                lsNext := ST_ARMED

        // ---- SHORT (LONG の完全対称) -----------------------------------
        if ssNext == ST_WAIT
            if bg15 == BG_RED and bg30 == BG_RED
                ssNext := ST_ARMED
        else if ssNext == ST_ARMED
            if bg15 == BG_FLAT
                ssNext := ST_FLAT
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else if ssNext == ST_FLAT
            if bg15 == BG_RED
                ssNext := ST_ARMED
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else
            if bg15 == BG_FLAT
                //  赤 → 青(複数本可) → フラット  ← Pattern B のみ Signal
                shortSigB := true
                ssNext    := ST_FLAT
            else if bg15 == BG_RED
                ssNext := ST_ARMED

    else if baseSignalMode == BASE_C2
        // ---- CANDIDATE_2 -----------------------------------------------
        //  初期 ARM は CURRENT と同じ (15s + 30s + 1m の同方向一致)。
        //  ただし ARM 後の1分ガードは実行しない (色が崩れてもリセットしない)。
        //  Pattern A は Signal にしない。
        //  Pattern B は「反対色を経由したあとのフラット」で即 Entry せず、
        //  目的色へ復帰するまで待つ:
        //    LONG  青 → 赤(複数本可) → フラット(複数本可) → 青   で Signal
        //    SHORT 赤 → 青(複数本可) → フラット(複数本可) → 赤   で Signal
        //  ★ ST_FLAT と ST_B_CONFIRM は別 State。
        //    ST_FLAT は「青 → フラット」など通常の遷移でも使うため、
        //    「反対色を経由したあとのフラット」を区別しないと
        //    青 → 赤 → フラット → 青 を正確に判定できない。
        // ---- LONG ------------------------------------------------------
        if lsNext == ST_WAIT
            if bg15 == BG_BLUE and bg30 == BG_BLUE and bg1m == BG_BLUE
                lsNext := ST_ARMED
        else if lsNext == ST_ARMED
            if bg15 == BG_FLAT
                lsNext := ST_FLAT
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else if lsNext == ST_FLAT
            if bg15 == BG_BLUE
                //  青 → フラット → 青 : Signal にはしない
                lsNext := ST_ARMED
            else if bg15 == BG_RED
                lsNext := ST_OPP
        else if lsNext == ST_OPP
            if bg15 == BG_FLAT
                //  赤 → フラット : ここではまだ Entry しない。復帰待ちへ。
                lsNext := ST_B_CONFIRM
            else if bg15 == BG_BLUE
                lsNext := ST_ARMED
        else
            //  ST_B_CONFIRM : フラットが続く限り維持
            if bg15 == BG_BLUE
                //  青 → 赤 → フラット → 青  ← ここで Pattern B Signal
                longSigB := true
                lsNext   := ST_ARMED
            else if bg15 == BG_RED
                lsNext := ST_OPP

        // ---- SHORT (LONG の完全対称) -----------------------------------
        if ssNext == ST_WAIT
            if bg15 == BG_RED and bg30 == BG_RED and bg1m == BG_RED
                ssNext := ST_ARMED
        else if ssNext == ST_ARMED
            if bg15 == BG_FLAT
                ssNext := ST_FLAT
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else if ssNext == ST_FLAT
            if bg15 == BG_RED
                ssNext := ST_ARMED
            else if bg15 == BG_BLUE
                ssNext := ST_OPP
        else if ssNext == ST_OPP
            if bg15 == BG_FLAT
                ssNext := ST_B_CONFIRM
            else if bg15 == BG_RED
                ssNext := ST_ARMED
        else
            //  ST_B_CONFIRM : フラットが続く限り維持
            if bg15 == BG_RED
                //  赤 → 青 → フラット → 赤  ← ここで Pattern B Signal
                shortSigB := true
                ssNext    := ST_ARMED
            else if bg15 == BG_BLUE
                ssNext := ST_OPP

    else if baseSignalMode == BASE_C3
        // ---- CANDIDATE_3 · 5m Turn → 15s First Pullback --------------------
        //  Setup 開始 : 確定5分背景が新しく目的色へ転換した確定15秒足 (ARM だけ)
        //  Setup 維持 : bg5m が目的色であること。崩れたら即キャンセル
        //  Trigger    : Setup 成立後の最初の 15s Opposite → FLAT
        // ---- LONG ------------------------------------------------------
        [c3LSt, c3LSig] = f_setupTrigger(lsNext, bg5mTurnedBlue, bg5m == BG_BLUE,
             false, false, true, bg15, BG_RED)
        lsNext    := c3LSt
        longSigB  := c3LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c3SSt, c3SSig] = f_setupTrigger(ssNext, bg5mTurnedRed, bg5m == BG_RED,
             false, false, true, bg15, BG_BLUE)
        ssNext    := c3SSt
        shortSigB := c3SSig

    else if baseSignalMode == BASE_C4
        // ---- CANDIDATE_4 · 1m Turn → 15s First Pullback --------------------
        //  Setup 開始 : 確定1分背景が新しく目的色へ転換した確定15秒足 (ARM だけ)
        //  Setup 維持 : bg1m が目的色であること。FLAT / 反対色でキャンセル
        //  Trigger    : Setup 成立後の最初の 15s Opposite → FLAT
        // ---- LONG ------------------------------------------------------
        [c4LSt, c4LSig] = f_setupTrigger(lsNext, bg1mTurnedBlue, bg1m == BG_BLUE,
             false, false, true, bg15, BG_RED)
        lsNext    := c4LSt
        longSigB  := c4LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c4SSt, c4SSig] = f_setupTrigger(ssNext, bg1mTurnedRed, bg1m == BG_RED,
             false, false, true, bg15, BG_BLUE)
        ssNext    := c4SSt
        shortSigB := c4SSig

    else if baseSignalMode == BASE_C5
        // ---- CANDIDATE_5 · 5m Regime + 1m Turn → 15s First Pullback --------
        //  Setup 開始 : bg5m が目的色 (方向フィルター) である中で、
        //               確定1分背景が新しく目的色へ転換した確定15秒足 (ARM だけ)
        //               ★ 5m が目的色なだけでは ARM しない。1m の新しい転換が必須
        //  Setup 維持 : bg5m と bg1m の両方が目的色。どちらか崩れたらキャンセル
        //  Trigger    : Setup 成立後の最初の 15s Opposite → FLAT
        // ---- LONG ------------------------------------------------------
        [c5LSt, c5LSig] = f_setupTrigger(lsNext, bg5m == BG_BLUE and bg1mTurnedBlue, bg5m == BG_BLUE and bg1m == BG_BLUE,
             false, false, true, bg15, BG_RED)
        lsNext    := c5LSt
        longSigB  := c5LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c5SSt, c5SSig] = f_setupTrigger(ssNext, bg5m == BG_RED and bg1mTurnedRed, bg5m == BG_RED and bg1m == BG_RED,
             false, false, true, bg15, BG_BLUE)
        ssNext    := c5SSt
        shortSigB := c5SSig

    else if baseSignalMode == BASE_C6
        // ---- CANDIDATE_6 · 1m Turn → 30s Confirm → 15s First Pullback ------
        //  Setup 開始 : 確定1分背景が新しく目的色へ転換 → ST_SETUP_CONFIRM
        //  確認待ち中 : bg1m が目的色を維持していること (崩れたらキャンセル)
        //               その後の「確定30秒更新かつ bg30 が目的色」で ST_ARMED
        //               ★ 確認が成立したバーでは Trigger 判定を始めない
        //  Setup 維持 : bg1m と bg30 の両方が目的色。どちらか崩れたらキャンセル
        //  Trigger    : Setup 成立後の最初の 15s Opposite → FLAT
        // ---- LONG ------------------------------------------------------
        [c6LSt, c6LSig] = f_setupTrigger(lsNext, bg1mTurnedBlue, bg1m == BG_BLUE and bg30 == BG_BLUE,
             true, newConfirmed30s and bg30 == BG_BLUE, bg1m == BG_BLUE, bg15, BG_RED)
        lsNext    := c6LSt
        longSigB  := c6LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c6SSt, c6SSig] = f_setupTrigger(ssNext, bg1mTurnedRed, bg1m == BG_RED and bg30 == BG_RED,
             true, newConfirmed30s and bg30 == BG_RED, bg1m == BG_RED, bg15, BG_BLUE)
        ssNext    := c6SSt
        shortSigB := c6SSig

    else if baseSignalMode == BASE_C7
        // ---- CANDIDATE_7 · 5m Turn → 1m Confirm → 15s First Pullback -------
        //  Setup 開始 : 確定5分背景が新しく目的色へ転換 → ST_SETUP_CONFIRM
        //  確認待ち中 : bg5m が目的色を維持していること (崩れたらキャンセル)
        //               その後の「確定1分更新かつ bg1m が目的色」で ST_ARMED
        //               ★ 5m 転換イベントと同じバーでは 1m 確認まで進めない
        //               ★ 確認が成立したバーでは Trigger 判定を始めない
        //  Setup 維持 : bg5m と bg1m の両方が目的色。どちらか崩れたらキャンセル
        //  Trigger    : Setup 成立後の最初の 15s Opposite → FLAT
        // ---- LONG ------------------------------------------------------
        [c7LSt, c7LSig] = f_setupTrigger(lsNext, bg5mTurnedBlue, bg5m == BG_BLUE and bg1m == BG_BLUE,
             true, newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED)
        lsNext    := c7LSt
        longSigB  := c7LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c7SSt, c7SSig] = f_setupTrigger(ssNext, bg5mTurnedRed, bg5m == BG_RED and bg1m == BG_RED,
             true, newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE)
        ssNext    := c7SSt
        shortSigB := c7SSig

    else if baseSignalMode == BASE_C8
        // ---- CANDIDATE_8 · 5m Turn → 30s Confirm → 15s First Pullback ------
        //  C7 (5m → 1m → 15s) に対して 5m → 30s → 15s を比較するための候補。
        //  Setup 開始 : 確定5分背景が新しく目的色へ転換 → ST_SETUP_CONFIRM
        //  確認待ち中 : bg5m が目的色を維持していること (崩れたらキャンセル)
        //               その後の「確定30秒更新かつ bg30 が目的色」で ST_ARMED
        //               ★ 確認が成立したバーでは Trigger 判定を始めない
        //  Setup 維持 : bg5m と bg30 の両方が目的色。どちらか崩れたらキャンセル
        //  Trigger    : C7 と完全に同じ (Opposite → FLAT)。
        //               そのため既存の f_setupTrigger() をそのまま使う。
        // ---- LONG ------------------------------------------------------
        [c8LSt, c8LSig] = f_setupTrigger(lsNext, bg5mTurnedBlue, bg5m == BG_BLUE and bg30 == BG_BLUE,
             true, newConfirmed30s and bg30 == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED)
        lsNext    := c8LSt
        longSigB  := c8LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c8SSt, c8SSig] = f_setupTrigger(ssNext, bg5mTurnedRed, bg5m == BG_RED and bg30 == BG_RED,
             true, newConfirmed30s and bg30 == BG_RED, bg5m == BG_RED, bg15, BG_BLUE)
        ssNext    := c8SSt
        shortSigB := c8SSig
        //  C8 の Trigger は Deep (Opposite → FLAT) しかない
        baseTrigType := c8LSig or c8SSig ? TT_DEEP : TT_NONE

    else if baseSignalMode == BASE_C9
        // ---- CANDIDATE_9 · C7 + Direct Recovery ---
        //  Trigger   : Deep (RED → FLAT) に加えて
        //              Direct (RED → BLUE の直接復帰) も Signal にする。
        //              浅い押し (FLAT 止まり) は取らない = ST_SHALLOW を使わない。
        //  Setup     : C7 と完全同一 (5m 転換 → ST_SETUP_CONFIRM →
        //              その後の確定1分が目的色 → ST_ARMED)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        // ---- LONG ------------------------------------------------------
        [c9LSt, c9LSig, c9LTt] = f_setupTriggerVariant(lsNext, bg5mTurnedBlue,
             bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE,
             bg15, BG_BLUE, BG_RED, TM_DEEP_DIRECT)
        lsNext    := c9LSt
        longSigB  := c9LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c9SSt, c9SSig, c9STt] = f_setupTriggerVariant(ssNext, bg5mTurnedRed,
             bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED,
             bg15, BG_RED, BG_BLUE, TM_DEEP_DIRECT)
        ssNext    := c9SSt
        shortSigB := c9SSig
        baseTrigType := c9LTt != TT_NONE ? c9LTt : c9STt

    else if baseSignalMode == BASE_C10
        // ---- CANDIDATE_10 · C7 + Shallow Pullback ---
        //  Trigger   : Shallow (FLAT → BLUE) だけを Signal にする。
        //              15s が RED まで押したらその Setup は対象外として終了する
        //              (浅い押し単独の性能を測るため Deep を混ぜない)。
        //  Setup     : C7 と完全同一 (5m 転換 → ST_SETUP_CONFIRM →
        //              その後の確定1分が目的色 → ST_ARMED)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        // ---- LONG ------------------------------------------------------
        [c10LSt, c10LSig, c10LTt] = f_setupTriggerVariant(lsNext, bg5mTurnedBlue,
             bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE,
             bg15, BG_BLUE, BG_RED, TM_SHALLOW_ONLY)
        lsNext    := c10LSt
        longSigB  := c10LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c10SSt, c10SSig, c10STt] = f_setupTriggerVariant(ssNext, bg5mTurnedRed,
             bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED,
             bg15, BG_RED, BG_BLUE, TM_SHALLOW_ONLY)
        ssNext    := c10SSt
        shortSigB := c10SSig
        baseTrigType := c10LTt != TT_NONE ? c10LTt : c10STt

    else if baseSignalMode == BASE_C11
        // ---- CANDIDATE_11 · C7 + Deep or Shallow ---
        //  Trigger   : Deep (RED → FLAT) と Shallow (FLAT → BLUE) の
        //              先に完成したほうを Signal にする。
        //              浅い押しからさらに RED まで深くなったら Deep として追跡する。
        //              Direct (RED → BLUE 直戻り) は Signal にしない。
        //  Setup     : C7 と完全同一 (5m 転換 → ST_SETUP_CONFIRM →
        //              その後の確定1分が目的色 → ST_ARMED)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        // ---- LONG ------------------------------------------------------
        [c11LSt, c11LSig, c11LTt] = f_setupTriggerVariant(lsNext, bg5mTurnedBlue,
             bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE,
             bg15, BG_BLUE, BG_RED, TM_DEEP_OR_SHALLOW)
        lsNext    := c11LSt
        longSigB  := c11LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c11SSt, c11SSig, c11STt] = f_setupTriggerVariant(ssNext, bg5mTurnedRed,
             bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED,
             bg15, BG_RED, BG_BLUE, TM_DEEP_OR_SHALLOW)
        ssNext    := c11SSt
        shortSigB := c11SSig
        baseTrigType := c11LTt != TT_NONE ? c11LTt : c11STt

    else if baseSignalMode == BASE_C12
        // ---- CANDIDATE_12 · C7 + Any Recovery ---
        //  Trigger   : Deep / Direct / Shallow の 3 種すべてを Signal にする。
        //              今回の中で最も緩い C7 派生。
        //  Setup     : C7 と完全同一 (5m 転換 → ST_SETUP_CONFIRM →
        //              その後の確定1分が目的色 → ST_ARMED)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        // ---- LONG ------------------------------------------------------
        [c12LSt, c12LSig, c12LTt] = f_setupTriggerVariant(lsNext, bg5mTurnedBlue,
             bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE,
             bg15, BG_BLUE, BG_RED, TM_ANY_RECOVERY)
        lsNext    := c12LSt
        longSigB  := c12LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c12SSt, c12SSig, c12STt] = f_setupTriggerVariant(ssNext, bg5mTurnedRed,
             bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED,
             bg15, BG_RED, BG_BLUE, TM_ANY_RECOVERY)
        ssNext    := c12SSt
        shortSigB := c12SSig
        baseTrigType := c12LTt != TT_NONE ? c12LTt : c12STt

    else if baseSignalMode == BASE_C13
        // ---- CANDIDATE_13 · C7 Confirm ≤ 1m ------------------------------
        //  Setup 開始 : C7 と同じ 5m 転換 → ST_SETUP_CONFIRM
        //  1m 確認    : 5m 転換後の確定1分を最大 1 本だけ待つ。
        //               その中で bg1m が目的色になれば ST_ARMED、
        //               1 本目でも目的色にならなければ Setup 終了。
        //               ★ 数えるのは確定1分足の本数 (15秒足の本数ではない)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        //  Trigger    : C7 と完全に同じ Deep (15s Opposite → FLAT) のみ
        // ---- LONG ------------------------------------------------------
        [c13LSt, c13LSig, c13LWait] = f_setupTriggerLimited(lsNext, c13LongWait1m,
             bg5mTurnedBlue, bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m, bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED, 1)
        lsNext    := c13LSt
        longSigB  := c13LSig
        c13LongWait1m := c13LWait
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c13SSt, c13SSig, c13SWait] = f_setupTriggerLimited(ssNext, c13ShortWait1m,
             bg5mTurnedRed, bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m, bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE, 1)
        ssNext    := c13SSt
        shortSigB := c13SSig
        c13ShortWait1m := c13SWait
        baseTrigType := c13LSig or c13SSig ? TT_DEEP : TT_NONE

    else if baseSignalMode == BASE_C14
        // ---- CANDIDATE_14 · C7 Confirm ≤ 2m ------------------------------
        //  Setup 開始 : C7 と同じ 5m 転換 → ST_SETUP_CONFIRM
        //  1m 確認    : 5m 転換後の確定1分を最大 2 本だけ待つ。
        //               その中で bg1m が目的色になれば ST_ARMED、
        //               2 本目でも目的色にならなければ Setup 終了。
        //               ★ 数えるのは確定1分足の本数 (15秒足の本数ではない)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        //  Trigger    : C7 と完全に同じ Deep (15s Opposite → FLAT) のみ
        // ---- LONG ------------------------------------------------------
        [c14LSt, c14LSig, c14LWait] = f_setupTriggerLimited(lsNext, c14LongWait1m,
             bg5mTurnedBlue, bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m, bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED, 2)
        lsNext    := c14LSt
        longSigB  := c14LSig
        c14LongWait1m := c14LWait
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c14SSt, c14SSig, c14SWait] = f_setupTriggerLimited(ssNext, c14ShortWait1m,
             bg5mTurnedRed, bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m, bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE, 2)
        ssNext    := c14SSt
        shortSigB := c14SSig
        c14ShortWait1m := c14SWait
        baseTrigType := c14LSig or c14SSig ? TT_DEEP : TT_NONE

    else if baseSignalMode == BASE_C15
        // ---- CANDIDATE_15 · C7 · 5m Turn From FLAT only -------------------------
        //  Setup 開始 : 5m が FLAT → 目的色 へ転換したときだけ。
        //               反対色 → 目的色 (完全な方向転換) では開始しない。
        //               C7 の優位性が「FLAT からの新規トレンド発生」に
        //               由来するのかを切り分けるための候補。
        //  Setup 開始以外は C7 と完全同一。既存 f_setupTrigger() をそのまま使い、
        //  Setup Event に渡す転換フラグだけを差し替えている。
        //  Trigger    : C7 と完全に同じ Deep (15s Opposite → FLAT) のみ
        // ---- LONG ------------------------------------------------------
        [c15LSt, c15LSig] = f_setupTrigger(lsNext, bg5mBlueFromFlat, bg5m == BG_BLUE and bg1m == BG_BLUE,
             true, newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED)
        lsNext    := c15LSt
        longSigB  := c15LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c15SSt, c15SSig] = f_setupTrigger(ssNext, bg5mRedFromFlat, bg5m == BG_RED and bg1m == BG_RED,
             true, newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE)
        ssNext    := c15SSt
        shortSigB := c15SSig
        baseTrigType := c15LSig or c15SSig ? TT_DEEP : TT_NONE

    else if baseSignalMode == BASE_C16
        // ---- CANDIDATE_16 · C7 · 5m Turn From Opposite only -------------------------
        //  Setup 開始 : 5m が 反対色 → 目的色 へ転換したときだけ。
        //               FLAT → 目的色 では開始しない。C15 の裏返しで、
        //               C7 の優位性が「完全な方向転換」に由来するのかを見る。
        //  Setup 開始以外は C7 と完全同一。既存 f_setupTrigger() をそのまま使い、
        //  Setup Event に渡す転換フラグだけを差し替えている。
        //  Trigger    : C7 と完全に同じ Deep (15s Opposite → FLAT) のみ
        // ---- LONG ------------------------------------------------------
        [c16LSt, c16LSig] = f_setupTrigger(lsNext, bg5mBlueFromRed, bg5m == BG_BLUE and bg1m == BG_BLUE,
             true, newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED)
        lsNext    := c16LSt
        longSigB  := c16LSig
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c16SSt, c16SSig] = f_setupTrigger(ssNext, bg5mRedFromBlue, bg5m == BG_RED and bg1m == BG_RED,
             true, newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE)
        ssNext    := c16SSt
        shortSigB := c16SSig
        baseTrigType := c16LSig or c16SSig ? TT_DEEP : TT_NONE

    else if baseSignalMode == BASE_C17
        // ---- CANDIDATE_17 · C7 First + Second Deep -------------------------
        //  Setup     : C7 と完全同一 (5m 転換 → 1m 確認 → ST_ARMED)
        //  Setup 維持 : 確認待ち中は bg5m、ARM 後は bg5m と bg1m の両方が目的色
        //  Trigger    : C7 と完全に同じ Deep (15s Opposite → FLAT) のみ。
        //               ただし 1回目の Deep では Setup を消費せず ST_ARMED へ
        //               戻して2回目を待ち、2回目の Deep で Setup 終了。
        //  ★ 数えるのは Base Signal を出した回数。発注できたかは見ない。
        // ---- LONG ------------------------------------------------------
        [c17LSt, c17LSig, c17LCnt] = f_setupTriggerTwoDeep(lsNext, c17LongDeep,
             bg5mTurnedBlue, bg5m == BG_BLUE and bg1m == BG_BLUE,
             newConfirmed1m and bg1m == BG_BLUE, bg5m == BG_BLUE, bg15, BG_RED)
        lsNext       := c17LSt
        longSigB     := c17LSig
        c17LongDeep  := c17LCnt
        // ---- SHORT (LONG の完全対称 : 青と赤を入れ替えるだけ) -----------
        [c17SSt, c17SSig, c17SCnt] = f_setupTriggerTwoDeep(ssNext, c17ShortDeep,
             bg5mTurnedRed, bg5m == BG_RED and bg1m == BG_RED,
             newConfirmed1m and bg1m == BG_RED, bg5m == BG_RED, bg15, BG_BLUE)
        ssNext       := c17SSt
        shortSigB    := c17SSig
        c17ShortDeep := c17SCnt
        baseTrigType := c17LSig or c17SSig ? TT_DEEP : TT_NONE

//  既存の15秒 Pattern A / B が完成したことを示す素の Signal。
//  ★ 以下のフィルターはこの Signal を「通す / 落とす」だけで、
//    Pattern A / B の State Machine (lsNext / ssNext) には一切影響しない。
bool baseLongSignal  = longSigA  or longSigB
bool baseShortSignal = shortSigA or shortSigB

// ============================================================================
// 04b. ENTRY FILTER 合成
// ----------------------------------------------------------------------------
//  ① 1m Transition : 現在の1分Regimeが反対色から始まったか (03b の State Machine)
//  ② 5m Background : baseSignal 完成後に「待機」へ入り、その後 確定5分SAT背景が
//                    目的色へ切り替わった最初の15秒確定足で Entry する
//
//  ★ ② は待機方式 ★
//    1) baseSignal 成立 → その場では Entry せず pending = true にする
//       (その時点ですでに5分が目的色でも Entry しない)
//    2) 待機中は確定1分背景が目的色を維持していることが必須
//       FLAT または反対色になった時点で pending = false にして Signal を破棄する。
//       あとから1分が戻っても古い Signal は復活させない (新しい baseSignal が必要)
//    3) 待機中に「確定5分背景が目的色へ切り替わった」新しい確定5分更新が来たら Entry
//       単に bg5m == 目的色 では発火しない。非目的色 → 目的色 の遷移が必要。
//
//  ★ 1方向につき pending は最大 1 つ。
//    待機中に新しい Pattern A / B が出ても重複登録しない (その Signal は捨てる)。
//    pending が解除されるのは「Entry 成立」か「1分条件が崩れた」ときだけ。
//
//  ★ ①のみモードは従来どおり即 Entry (待機しない)。
//  ★ ①+② は baseSignal 成立時点で①を満たしていることを待機開始の条件にし、
//    そのあと②の5分待機へ進む。待機中に1分が FLAT / 反対色になれば
//    ①の valid も自動的に外れるので、pending 解除と同時に Signal は破棄される。
// ============================================================================
bool f1LongPass  = long1mTransitionValid
bool f1ShortPass = short1mTransitionValid

//  ★ 確定5分背景の転換イベント (newConfirmed5m / bg5mTurnedBlue / bg5mTurnedRed) は
//    Section 03c で計算している。Section 04 の CANDIDATE_3 / CANDIDATE_7 からも
//    参照するため、計算式はそのままに位置だけを 04b の手前へ移した。
//    ここでの使い方は従来と一切変わらない。

// ---- ② 待機 State -----------------------------------------------------------
var bool long5mPending  = false
var bool short5mPending = false

//  ★ ② では baseSignal 成立から実際の Entry まで時間差があるため、
//    Entry 時に現在バーの longSigA / shortSigA を見ると
//    元の Signal が Pattern A だったか B だったかが失われる。
//    そこで待機開始の時点で元 Signal の Pattern を保存しておく。
//      0 = 未設定 / 1 = Pattern A / 2 = Pattern B
var int longPendingPattern  = 0
var int shortPendingPattern = 0

bool use5mPending = entryFilterMode == FM_5M or entryFilterMode == FM_BOTH

//  Debug 用の「②発火条件が成立したか」。Entry 判定にもそのまま使う。
bool f2LongPass  = false
bool f2ShortPass = false

bool longSignal  = false
bool shortSignal = false

if barConfirmed
    if use5mPending
        //  1) 待機キャンセル : 確定1分背景が目的色でなくなったら Signal を破棄
        if long5mPending and bg1m != BG_BLUE
            long5mPending      := false
            longPendingPattern := 0
        if short5mPending and bg1m != BG_RED
            short5mPending      := false
            shortPendingPattern := 0
        //  2) 発火 : 待機中に確定5分背景が目的色へ切り替わった最初の15秒確定足
        //     ★ 3) の待機開始より先に評価する。こうすることで「baseSignal と
        //       5分の切り替わりが同じ15秒足で起きた」ケースでも即 Entry にならず、
        //       必ず「Signal 発生後の切り替わり」だけが発火条件になる。
        if long5mPending and bg5mTurnedBlue
            f2LongPass := true
            longSignal := true
        if short5mPending and bg5mTurnedRed
            f2ShortPass := true
            shortSignal := true
        //  3) 待機開始 : 1方向につき最大1つ。すでに待機中なら重複登録しない。
        //     ①+② では待機開始の時点で①を満たしていることを要求する。
        bool armLong  = baseLongSignal  and (entryFilterMode == FM_BOTH ? f1LongPass  : true)
        bool armShort = baseShortSignal and (entryFilterMode == FM_BOTH ? f1ShortPass : true)
        if not long5mPending and armLong
            long5mPending      := true
            longPendingPattern := longSigA ? 1 : 2
        if not short5mPending and armShort
            short5mPending      := true
            shortPendingPattern := shortSigA ? 1 : 2
    else if entryFilterMode == FM_BASE
        //  ③ Base Signal Only : フィルターなし。15秒 Pattern A / B の
        //  baseSignal をそのまま Entry に使う (①も②も条件に入れない)。
        longSignal  := baseLongSignal
        shortSignal := baseShortSignal
    else
        //  ①のみ : 従来どおり baseSignal AND ① で即 Entry
        longSignal  := baseLongSignal  and f1LongPass
        shortSignal := baseShortSignal and f1ShortPass

// ============================================================================
// 04c. HTF SAT BACKGROUND FILTER (既存 Entry Filter とは独立した追加ゲート)
// ----------------------------------------------------------------------------
//  ★ entryFilterMode の新モードではない。① / ② / ①+② / ③ のどれで生成された
//    Signal に対しても、最後に同じゲートを掛けるだけ。
//  ★ useHtfFilter = false のときは両方 true。Entry 結果は追加前と完全一致する。
//  ★ その方向の 7 時間足がすべて OFF のときも true (AND / OR どちらでも)。
//    全 OFF で Entry を止めない。
//  ★ 評価タイミングは「実際に Entry する15秒確定足」。
//    ① / ③ は baseSignal 発生バー、② は5分 pending 後に発火したバーになる。
//    longSignal / shortSignal が確定したあとに掛けているので自動的にそうなる。
//  ★ HTF 条件が NG でもそのバーで Entry しないだけ。15秒 Pattern State /
//    ① / ② pending の内部ロジックには一切触れていない
//    (② の pending は従来どおり Entry 成立か1分条件崩れでのみ解除される)。
// ============================================================================
int htfLongActive = f_htfAct(htfL5m) + f_htfAct(htfL15m) + f_htfAct(htfL30m) +
     f_htfAct(htfL1h) + f_htfAct(htfL4h) + f_htfAct(htfLD) + f_htfAct(htfLW)
int htfLongHit = f_htfHit(bg5m, htfL5m) + f_htfHit(bg15m, htfL15m) + f_htfHit(bg30mHtf, htfL30m) +
     f_htfHit(bg1h, htfL1h) + f_htfHit(bg4h, htfL4h) + f_htfHit(bgD, htfLD) + f_htfHit(bgW, htfLW)

int htfShortActive = f_htfAct(htfS5m) + f_htfAct(htfS15m) + f_htfAct(htfS30m) +
     f_htfAct(htfS1h) + f_htfAct(htfS4h) + f_htfAct(htfSD) + f_htfAct(htfSW)
int htfShortHit = f_htfHit(bg5m, htfS5m) + f_htfHit(bg15m, htfS15m) + f_htfHit(bg30mHtf, htfS30m) +
     f_htfHit(bg1h, htfS1h) + f_htfHit(bg4h, htfS4h) + f_htfHit(bgD, htfSD) + f_htfHit(bgW, htfSW)

bool htfLongPass  = true
bool htfShortPass = true
if useHtfFilter
    if htfLongActive > 0
        htfLongPass := htfCombineMode == "AND" ? htfLongHit == htfLongActive : htfLongHit > 0
    if htfShortActive > 0
        htfShortPass := htfCombineMode == "AND" ? htfShortHit == htfShortActive : htfShortHit > 0

//  最終ゲート。既存 Signal の生成ロジックには手を入れず、ここで AND するだけ。
longSignal  := longSignal  and htfLongPass
shortSignal := shortSignal and htfShortPass

//  この Entry で使う Pattern コード。
//    ② / ①+② : 待機開始時に保存した pendingPattern (時間差があるため)
//    ①のみ     : 現在バーの longSigA / shortSigA をそのまま使う
//  ★ Section 08 で pendingPattern を 0 へリセットするより前にここで確定させる。
//    発注と Pattern A / B 別カウントの両方がこの値を参照する。
int longEntryPattern  = use5mPending ? longPendingPattern  : (longSigA  ? 1 : 2)
int shortEntryPattern = use5mPending ? shortPendingPattern : (shortSigA ? 1 : 2)

// ============================================================================
// 05. ZONE ENGINE  (ZONE モードのみ / Base TF = 5分)
// ----------------------------------------------------------------------------
//  ZoneEngine v10 (Base TF 対応版) を使う。
//  Zone 生成 / Score / Strength / Break / Flip / Reaction Bonus /
//  Structural SL・TP の条件式は v9 から一切変更していない。
//  変わったのは「Zone State 更新がどの足の high / low / close / time /
//  bar_index を見るか」だけで、それを ZoneFeed の base* から受け取る。
//
//  ★ SAT Entry = 15秒足 / Zone = Base TF (5分) の完全分離 ★
//    ・Zone Map / Zone State      … Base TF 5分基準
//    ・Structural SL / TP 候補Zone … Base TF 5分基準
//    ・TradePlan の entryPrice     … SAT Pattern 成立時の15秒 close
//    zn.buildPlanWithTpDepth() は built-in を 1 つも参照せず、引数の
//    entryPrice と Zone のフィールドだけで判定するため、この組み合わせが成立する。
//
//  ★ FIXED モードでは request.security を 1 本も発行しない (計算負荷ゼロ)。
//    sltpMode は input なので、この分岐は全バーで同じ = ta 状態がずれることはない。
// ============================================================================
var zn.ZoneEngine zoneEng = zn.newEngine()

zn.ZoneCfg zoneCfg = zn.newCfg()
zoneCfg.zoneHalfWidth        := zoneHalfWidth
zoneCfg.useMaSource          := useMaSource
zoneCfg.maTfName             := maTf
zoneCfg.ma1Len               := ma1Len
zoneCfg.ma2Len               := ma2Len
zoneCfg.scoreMa1             := scoreMa1
zoneCfg.scoreMa2             := scoreMa2
zoneCfg.slopeThrMod          := slopeThrMod
zoneCfg.slopeThrStrong       := slopeThrStrong
zoneCfg.slopeBonusFlat       := slopeBonusFlat
zoneCfg.slopeBonusMod        := slopeBonusMod
zoneCfg.slopeBonusStr        := slopeBonusStr
zoneCfg.slopeBonusMax        := slopeBonusMode == "Max"
zoneCfg.maClusterDist        := maClusterDist
zoneCfg.maClusterBonus       := maClusterBonus
zoneCfg.maClusterDirBonus    := maClusterDirBonus
zoneCfg.useHzSource          := useHzSource
zoneCfg.hzTf1                := hzTf1
zoneCfg.hzTf2                := hzTf2
zoneCfg.hzTf3                := hzTf3
zoneCfg.scoreHz1             := scoreHz1
zoneCfg.scoreHz2             := scoreHz2
zoneCfg.scoreHz3             := scoreHz3
zoneCfg.reactionDist         := reactionDist
//  ★ Reaction Score Bonus : 既定 OFF (Display / Validation と同じ方式) ★
zoneCfg.reactionBonus1       := useReactionScoreBonus ? reactionBonus1 : 0.0
zoneCfg.reactionBonus2       := useReactionScoreBonus ? reactionBonus2 : 0.0
zoneCfg.reactionBonus3       := useReactionScoreBonus ? reactionBonus3 : 0.0
zoneCfg.reactionRearmDist    := reactionRearmDist
zoneCfg.reactionAllSrc       := reactionAllSrc
zoneCfg.useDayHL             := useDayHL
zoneCfg.scoreDayHL           := scoreDayHL
zoneCfg.carryPrevDayHL       := carryPrevDayHL
zoneCfg.scorePrevDayHL       := scorePrevDayHL
zoneCfg.lifePrevDayHL        := lifePrevDayHL
zoneCfg.useAccSource         := useAccSource
zoneCfg.accTf1               := accTf1
zoneCfg.accTf2               := accTf2
zoneCfg.accTf3               := accTf3
zoneCfg.scoreAcc1            := scoreAcc1
zoneCfg.scoreAcc2            := scoreAcc2
zoneCfg.scoreAcc3            := scoreAcc3
zoneCfg.accKeep1             := accKeep1
zoneCfg.accKeep2             := accKeep2
zoneCfg.accKeep3             := accKeep3
zoneCfg.clusterDist          := clusterDist
zoneCfg.thrMedium            := thrMedium
zoneCfg.thrStrong            := thrStrong
zoneCfg.thrVStrong           := thrVStrong
zoneCfg.confBonus2           := confBonus2
zoneCfg.confBonus3           := confBonus3
zoneCfg.confBonus4           := confBonus4
zoneCfg.flipBonus            := flipBonus
zoneCfg.requireHtfForVStrong := requireHtfForVStrong
zoneCfg.htfSwing1H           := htfSwing1H
zoneCfg.htfAccum1H           := htfAccum1H
zoneCfg.htfAccum4H           := htfAccum4H
zoneCfg.htfAccumD            := htfAccumD
zoneCfg.htfSwing15M          := htfSwing15M
zoneCfg.htfMa1               := htfMa1
zoneCfg.htfMa2               := htfMa2
zoneCfg.htfDayHL             := htfDayHL
zoneCfg.breakBuffer          := breakBuffer
zoneCfg.flipConfirmDist      := flipConfirmDist
zoneCfg.resetOnReclaim       := resetOnReclaim
zoneCfg.trackStaleBars       := trackStaleBars
zoneCfg.trackContinuity      := trackContinuity
zoneCfg.lifeHz1              := lifeHz1
zoneCfg.lifeHz2              := lifeHz2
zoneCfg.lifeHz3              := lifeHz3
zoneCfg.lifeExtendOn         := lifeExtendOn
zoneCfg.lifeExtendRatio      := lifeExtendRatio
zoneCfg.maxPersistZones      := maxPersistZones
zoneCfg.slBuffer             := slBuffer
zoneCfg.tpBuffer             := tpBuffer
zoneCfg.maxSlDist            := maxSlDist
zoneCfg.minStructRR          := minStructRR
zoneCfg.slMinScore           := slMinScore
zoneCfg.slMinStrength        := zn.strengthIdx(slMinStrStr)
zoneCfg.tpMinScore           := tpMinScore
zoneCfg.tpMinStrength        := zn.strengthIdx(tpMinStrStr)
zoneCfg.obsMinStrength       := zn.strengthIdx(obsMinStrStr)
zoneCfg.activeNoTradeMinStrength := zn.strengthIdx(activeNoTradeMinStrStr)
zoneCfg.structuralTpDepthRatio   := structuralTpDepthRatio
zoneCfg.fallbackRR           := fallbackRR

// ----------------------------------------------------------------------------
//  Zone Feed (外部足の取得はすべてここ)
// ----------------------------------------------------------------------------
//  ★ Zone は Base TF (既定 5分) 1 本につき 1 回だけ更新する ★
//
//  更新対象は「直前に確定した Base TF 足」= 論理バー N。
//  処理するチャートバーは「N が閉じた直後の最初の15秒足」= newBaseBar。
//  15秒足の毎バー zn.update() を呼ぶことは絶対にしない。
//
//  ■ Source 系のサンプリング位相 (元 5分 Strategy と一致させるため)
//    元 5分 Strategy は 5分バー N の時点で各 Source を
//      request.security(<SourceTF>, ..., lookahead_off)
//    で読んでいた。その値は「バー N の終了時刻」に見えていた値。
//
//    15秒チャートで同じ値を得るには、newBaseBar の 1 本前の15秒足
//    (= バー N の最後の15秒足。その終値時刻 = バー N の終了時刻) の値を使う。
//    したがって Source 系はすべて <raw>[1] を Feed へ渡す。
//
//      例) 5分足 12:00〜12:04:59 が確定
//          → newBaseBar は 12:05:00〜12:05:14 の15秒足
//          → その [1] は 12:04:45〜12:04:59 の15秒足 = 12:04:59 時点の値
//          → 5分チャートでバー N が確定した瞬間に見えていた値と一致する
//
//    ★ MA / Swing / Accum の「計算そのもの」は従来どおりそれぞれの本来の TF
//      (MA 1分 / Swing 5分・15分・1時間 / Accum 1時間・4時間・日足) で行う。
//      Base TF 化するのは ZoneEngine が「現在足」として直接参照していた部分だけ。
//
//  ■ 形成中の Base TF 足は一切使わない
//    12:03:45 に SAT Entry が出ても、12:00 の5分足はまだ形成中なので Zone へ
//    反映されていない。使われるのは 11:55〜11:59:59 までの確定情報で
//    作られた Zone Map。そこへ 12:03:45 の15秒 Entry 価格を渡して
//    Structural SL / TP を決める。
// ----------------------------------------------------------------------------

// ---- Base TF 足の確定値 ----------------------------------------------------
//  [1] を request.security の「内部」(Base TF の時系列) で掛けているので、
//  返るのは必ず「確定済みの Base TF 足」。lookahead_on は必ずこの [1] とセット。
//  単独の lookahead_on は未来参照になるので使わない。
//
//    [1] → 論理バー N      (Zone State 更新に使う現在足)
//    [2] → 論理バー N-1    (Break 判定に使う確定足)
//
//  ★ Break の位相について
//    元 5分 Strategy は 5分バー N で brBarClosed = true とし、
//    brClose = brCloseRaw[1] = バー N-1 の終値 を使って Break を判定していた。
//    (Reaction / Natural State / Day H/L はバー N、Break だけバー N-1 という混在)
//    本実装もその位相をそのまま再現する。
f_baseTfPack() =>
    [open[1], high[1], low[1], close[1], close[2], time[1], high[2], low[2]]

float bOpen      = na
float bHigh      = na
float bLow       = na
float bClose     = na
float bPrevClose = na
int   bTime      = na
float bPrevHigh  = na
float bPrevLow   = na
if useZoneSltp
    [_bo, _bh, _bl, _bc, _bpc, _bt, _bph, _bpl] = request.security(syminfo.tickerid, zoneBaseTf,
         f_baseTfPack(), lookahead = barmerge.lookahead_on)
    bOpen      := _bo
    bHigh      := _bh
    bLow       := _bl
    bClose     := _bc
    bPrevClose := _bpc
    bTime      := _bt
    bPrevHigh  := _bph
    bPrevLow   := _bpl

// ---- 新しい Base TF 足の確定検出 + Zone 用の論理 bar sequence ---------------
//  time(zoneBaseTf) は request.security ではないので毎バー無条件に評価してよい。
//  Base TF 期間が切り替わった最初の15秒足で true になる = その直前の Base TF 足が確定した。
int  baseTfChg  = nz(ta.change(time(zoneBaseTf)), 0)
bool newBaseBar = useZoneSltp and bar_index > 0 and baseTfChg != 0

//  Base TF 足 1 本につき +1。ZoneEngine の createdBar / breakBar / lastSeenBar /
//  trackStaleBars はすべてこの論理 bar 番号で動く。
//  → trackStaleBars = 500 は「Base TF 500本」の意味になる (15秒足500本ではない)。
var int zoneBaseSeq = 0
if newBaseBar
    zoneBaseSeq := zoneBaseSeq + 1

// ---- MA Source (MA TF = 1分 のまま。計算は 1分足 close から) ---------------
float ma1Raw  = na
float ma1dRaw = na
float ma2Raw  = na
float ma2dRaw = na
if useZoneSltp and useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(zMaType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Raw  := _m1
    ma1dRaw := _m1d
    ma2Raw  := _m2
    ma2dRaw := _m2d

// ---- Horizontal Source (Swing) : 5分 / 15分 / 1時間 のまま -----------------
float ph1Raw = na
int   ph1tRaw = na
float pl1Raw = na
int   pl1tRaw = na
float ph2Raw = na
int   ph2tRaw = na
float pl2Raw = na
int   pl2tRaw = na
float ph3Raw = na
int   ph3tRaw = na
float pl3Raw = na
int   pl3tRaw = na
if useZoneSltp and useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1Raw  := _h1
    ph1tRaw := _h1t
    pl1Raw  := _l1
    pl1tRaw := _l1t
    ph2Raw  := _h2
    ph2tRaw := _h2t
    pl2Raw  := _l2
    pl2tRaw := _l2t
    ph3Raw  := _h3
    ph3tRaw := _h3t
    pl3Raw  := _l3
    pl3tRaw := _l3t

// ---- Accumulation Source : 1時間 / 4時間 / 日足 のまま ---------------------
bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1HiRaw = na
float acc1LoRaw = na
int   acc1IdRaw = na
float acc2HiRaw = na
float acc2LoRaw = na
int   acc2IdRaw = na
float acc3HiRaw = na
float acc3LoRaw = na
int   acc3IdRaw = na
if useZoneSltp and useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)
    acc1HiRaw := _a1h
    acc1LoRaw := _a1l
    acc1IdRaw := _a1i
    acc2HiRaw := _a2h
    acc2LoRaw := _a2l
    acc2IdRaw := _a2i
    acc3HiRaw := _a3h
    acc3LoRaw := _a3l
    acc3IdRaw := _a3i

// ---- 取引日ID ---------------------------------------------------------------
//  ★ Base TF 足の time から計算する (チャート足の time ではない)。
//    これにより Day High / Low の日付切り替わりも Base TF 足で起きる。
//  ※ timestamp() / hour() の timezone 引数は series 修飾子を受け付けないため、
//    タイムゾーン計算だけは Library ではなくここで行う (元 Strategy と同じ)。
//  ※ ウォームアップ中 (bTime が na) の値は使わない。下の update() を
//    not na(bTime) でガードしているため、ここでの nz() は計算エラー回避のみが目的。
int bTimeSafe    = nz(bTime, time)
int _locY        = year(bTimeSafe, dayTz)
int _locM        = month(bTimeSafe, dayTz)
int _locD        = dayofmonth(bTimeSafe, dayTz)
int _locH        = hour(bTimeSafe, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

// ---- ZoneFeed ---------------------------------------------------------------
//  Source 系は [1] (= 論理バー N の終了時刻に見えていた値)。
//  base* は Base TF の確定足 (論理バー N)。
//  br* は Break 判定用の Base TF 確定足 (論理バー N-1)。
zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Raw[1], ma1d = ma1dRaw[1], ma2 = ma2Raw[1], ma2d = ma2dRaw[1],
     ph1 = ph1Raw[1], ph1t = ph1tRaw[1], pl1 = pl1Raw[1], pl1t = pl1tRaw[1],
     ph2 = ph2Raw[1], ph2t = ph2tRaw[1], pl2 = pl2Raw[1], pl2t = pl2tRaw[1],
     ph3 = ph3Raw[1], ph3t = ph3tRaw[1], pl3 = pl3Raw[1], pl3t = pl3tRaw[1],
     acc1Hi = acc1HiRaw[1], acc1Lo = acc1LoRaw[1], acc1Id = acc1IdRaw[1],
     acc2Hi = acc2HiRaw[1], acc2Lo = acc2LoRaw[1], acc2Id = acc2IdRaw[1],
     acc3Hi = acc3HiRaw[1], acc3Lo = acc3LoRaw[1], acc3Id = acc3IdRaw[1],
     dayId = tradingDayId,
     brClose = bPrevClose, brHigh = bPrevHigh, brLow = bPrevLow,
     brEval  = zoneBaseSeq > 1 and not na(bPrevClose),
     baseOpen = bOpen, baseHigh = bHigh, baseLow = bLow, baseClose = bClose,
     basePrevClose = bPrevClose, baseTime = bTime, baseBarSeq = zoneBaseSeq)

// ---- Zone 更新 : Base TF 足 1 本につき 1 回だけ -----------------------------
//  ★ ここが 15秒足の毎バーで走らないことが本実装の要点。
//  ★ zoneCountNow は var。更新しないバーでは直前の Zone 数を保持する。
var int zoneCountNow  = 0
var int zoneUpdateCnt = 0
if newBaseBar and not na(bTime) and not na(bClose)
    zoneCountNow  := zn.update(zoneEng, zoneCfg, zoneFeed)
    zoneUpdateCnt := zoneUpdateCnt + 1

// ============================================================================
// 05b. ZONE LEVEL ENGINE  (実戦用 Zone Level / Base TF = Zone と同じ 5分)
// ----------------------------------------------------------------------------
//  ★ ZoneEngine の Raw Score / Raw Strength とは別軸 ★
//    Zone Level は birthScore (trackId 誕生時に固定した Score) と touchCount
//    だけで決まる。現在 Score / Raw Strength / 誕生後に追加された Source /
//    reactionCnt は Level 判定に一切使わない。
//    そのため「Raw Very Strong / Level Weak (何度も触られた)」も
//    「Raw Medium / Level Strong (触られていない)」も正常な状態。
//
//  ★ 更新は Base TF 確定足 1 本につき 1 回だけ ★
//    上の zn.update() と完全に同じタイミング (newBaseBar) でしか進めない。
//    15秒足ごとに TouchCount を進めると、Zone が 5分足で動いているのに
//    Touch だけ 15秒足で数えられて時間軸がズレるため。
//    ZoneLevelEngine v2 は Touch / Birth / Age に使う足情報を外から受け取る:
//      Touch 判定  : bHigh / bLow  (Base TF 確定足の高値・安値)
//      Re-arm 距離 : bClose        (Base TF 確定足の終値)
//      Birth bar   : zoneBaseSeq   (Base TF の論理バー番号)
//      Birth time  : bTime
//
//  ★ 検索 (nearestSupport / nearestResistance) は 15秒足のどこで呼んでもよい ★
//    参照するのは直近の Base TF 確定足で作ったスナップショットなので、
//    15秒足の途中で Entry 判定しても Zone Level は動かない。
// ============================================================================
var zl.ZoneLevelEngine levelEng = zl.newEngine()
zl.ZoneLevelCfg levelCfg = zl.newCfg()

//  ---- Source ビットマスク (Zone Validation Logger / ZoneLevelDisplay と同一) --
//    bit0 = MA1 / bit1 = MA2 / bit2 = Swing TF1 / bit3 = Swing TF2 /
//    bit4 = Swing TF3 / bit5 = Day H/L / bit6 = Prev Day H/L /
//    bit7 = Accum TF1 / bit8 = Accum TF2 / bit9 = Accum TF3
//
//  ★ ZoneEngine は Zone の member RawZone を export していないため、
//    Zone.sources (表示用文字列) から復元する。
//    sources は " / " 区切りで、各トークンは
//      MA    : "<len>MA<矢印>"      例 "2000MA↑"
//      Swing : "<tf> Swing"         例 "15 Swing"
//      Accum : "<tf> Accum High/Low"例 "60 Accum High"
//      Day   : "Day High" / "Day Low"
//      PrevD : "Prev Day High" / "Prev Day Low"
//    複数本まとまると末尾に " x2" が付く。
//    ★ 部分一致だと "5 Swing" が "15 Swing" に誤マッチするため、
//      " / " で分割して 1 トークンずつ、末尾の " xN" を落としてから判定する。
//
//  ★ この mask は birthSourceMask / addedSourceMask として保持されるだけで、
//    Zone Level 判定にも SL / TP 候補選定にも一切使わない (参考情報)。
f_srcToken(string tok) =>
    //  末尾の " xN" を取り除く
    int _p = str.pos(tok, " x")
    na(_p) ? tok : str.substring(tok, 0, _p)

//  同じ bit を 2 回足さないようにして bit を立てる (Pine v5 にビット演算子は無い)
f_setBit(int m, int b) =>
    int(m / b) % 2 == 1 ? m : m + b

f_sourceMask(string sources) =>
    int m = 0
    if not na(sources) and sources != ""
        array<string> parts = str.split(sources, " / ")
        if array.size(parts) > 0
            for _i = 0 to array.size(parts) - 1
                string t = f_srcToken(array.get(parts, _i))
                if str.startswith(t, str.tostring(ma1Len) + "MA")
                    m := f_setBit(m, 1)
                else if str.startswith(t, str.tostring(ma2Len) + "MA")
                    m := f_setBit(m, 2)
                else if t == hzTf1 + " Swing"
                    m := f_setBit(m, 4)
                else if t == hzTf2 + " Swing"
                    m := f_setBit(m, 8)
                else if t == hzTf3 + " Swing"
                    m := f_setBit(m, 16)
                else if t == "Day High" or t == "Day Low"
                    m := f_setBit(m, 32)
                else if t == "Prev Day High" or t == "Prev Day Low"
                    m := f_setBit(m, 64)
                else if str.startswith(t, accTf1 + " Accum")
                    m := f_setBit(m, 128)
                else if str.startswith(t, accTf2 + " Accum")
                    m := f_setBit(m, 256)
                else if str.startswith(t, accTf3 + " Accum")
                    m := f_setBit(m, 512)
    m

//  ---- Base TF 確定足 1 本につき 1 回だけ Zone Level を進める ----------------
var int levelUpdateCnt = 0
if newBaseBar and not na(bTime) and not na(bClose)
    zl.beginBaseBar(levelEng, zoneBaseSeq, bTime, bHigh, bLow, bClose)
    int _zn = zn.zoneCount(zoneEng)
    if _zn > 0
        for _i = 0 to _zn - 1
            zn.Zone _z = zn.zoneAt(zoneEng, _i)
            zl.feedZone(levelEng, levelCfg, _z.trackId, _z.top, _z.bottom, _z.state,
                 _z.score, _z.strength, _z.flipped, f_sourceMask(_z.sources))
    zl.endBaseBar(levelEng, levelCfg)
    levelUpdateCnt := levelUpdateCnt + 1

//  Level 名 → コード
int slMinLevel = slMinLevelStr == "Very Strong" ? zl.levelVeryStrong() :
     slMinLevelStr == "Strong" ? zl.levelStrong() :
     slMinLevelStr == "Medium" ? zl.levelMedium() : zl.levelWeak()
int tpMinLevel = tpMinLevelStr == "Very Strong" ? zl.levelVeryStrong() :
     tpMinLevelStr == "Strong" ? zl.levelStrong() :
     tpMinLevelStr == "Medium" ? zl.levelMedium() : zl.levelWeak()

// ============================================================================
// 06. RISK / QTY
// ----------------------------------------------------------------------------
//  Qty は必ず SL 距離から計算する。Long / Short 共通。
//     Risk Capital ÷ SL距離 ÷ syminfo.pointvalue → qtyStep 単位に切り下げ
//  ZONE  : Structural SL までの距離 (TradePlan.risk)
//  FIXED : Fixed SL の距離
// ============================================================================
f_baseCapital() =>
    useCompound ? strategy.equity : strategy.initial_capital

f_riskCapital() =>
    f_baseCapital() * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? f_riskCapital() / (riskPerUnit * syminfo.pointvalue) : 0.0
    float q = qtyStep > 0 ? math.floor(raw / qtyStep) * qtyStep : raw
    math.round(q, 8)

f_expectedLoss(float qty, float slDist) =>
    nz(qty) * nz(slDist) * syminfo.pointvalue

// ============================================================================
// 07. TRADE ENGINE
// ----------------------------------------------------------------------------
//  SAT Entry Signal → Trade Plan 生成 → SL/TP 決定 → Qty → strategy.entry
//  → strategy.exit の順で処理する唯一の場所。
//  ★ Entry ロジック自体は SLTP Mode によって変化しない。
//    ZONE でも FIXED でも同じ SAT Entry Signal を使い、SL/TP の決め方だけ切り替える。
// ============================================================================
var array<int>   gSeq      = array.new_int(1, 0)
var array<string> gLastPlan = array.new_string(3, "-")

//  ---- ZONE モードで採用した SL / TP Zone の Zone Level 情報 (Debug 表示専用) --
//    「Strong T1 を使ったのか / Very Strong T0 を使ったのか」を
//    バックテストで確認できるようにするためのもの。Entry 判定には使わない。
var int   gSlLevel = 0
var int   gSlTouch = na
var float gSlBirth = na
var int   gTpLevel = 0
var int   gTpTouch = na
var float gTpBirth = na

// SL/TP をまとめて返す内部プラン
//   戻り値 : [valid, sl, tp, rr, risk(SL距離), status, reason, tpType]
f_buildPlan(int dir, float entryPrice) =>
    bool   pValid  = false
    float  pSl     = na
    float  pTp     = na
    float  pRr     = na
    float  pRisk   = na
    string pStatus = "FAIL"
    string pReason = "-"
    string pTpType = "-"
    if useZoneSltp
        //  ★ ZONE : Structural SL / TP の候補 Zone を Zone Level 基準で選ぶ ★
        //    v10 までは zn.buildPlanWithTpDepth() が Raw Score / Raw Strength
        //    (slMinScore / slMinStrength / tpMinScore / tpMinStrength) で
        //    候補を選んでいた。ここではそれをやめ、ZoneLevelEngine の
        //    Level (birthScore + touchCount) で選ぶ。
        //      Raw Very Strong / Level Weak     → Strong 条件では不採用
        //      Raw Medium      / Level Strong   → Strong 条件なら採用
        //
        //    ★ 変えたのは「どの Zone を SL / TP 抵抗として採用するか」だけ ★
        //      SL Buffer / TP Buffer / TP Depth / maxSlDist / minStructRR /
        //      Fallback RR / TP Mode / INSIDE_ACTIVE_ZONE の NoTrade は
        //      すべて従来と同じ式・同じ順序で処理する。
        //
        //    LONG  : SL = entryPrice より下の SUPPORT / TP = 上の RESIST
        //    SHORT : SL = entryPrice より上の RESIST  / TP = 下の SUPPORT
        zl.ZoneLevelResult slZ = dir > 0 ?
             zl.nearestSupport(levelEng, levelCfg, entryPrice, slMinLevel) :
             zl.nearestResistance(levelEng, levelCfg, entryPrice, slMinLevel)
        zl.ZoneLevelResult tpZ = dir > 0 ?
             zl.nearestResistance(levelEng, levelCfg, entryPrice, tpMinLevel) :
             zl.nearestSupport(levelEng, levelCfg, entryPrice, tpMinLevel)

        //  ---- Structural SL (STEP 8) ----
        //    LONG  : SL = SUPPORT Zone の bottom - slBuffer
        //    SHORT : SL = RESIST  Zone の top    + slBuffer
        float zSl = not slZ.found ? na :
             dir > 0 ? slZ.bottom - slBuffer : slZ.top + slBuffer
        float zRisk = na(zSl) or na(entryPrice) ? na : math.abs(entryPrice - zSl)

        //  ---- Structural TP (STEP 9) ----
        //    TP Depth 仕様は従来のまま。Zone の手前側から深さ比率だけ入る。
        //    LONG  : tpBase = bottom + (top - bottom) * ratio  →  TP = tpBase - tpBuffer
        //    SHORT : tpBase = top    - (top - bottom) * ratio  →  TP = tpBase + tpBuffer
        float zTp = na
        if tpZ.found
            float _h = tpZ.top - tpZ.bottom
            float _base = dir > 0 ? tpZ.bottom + _h * structuralTpDepthRatio :
                 tpZ.top - _h * structuralTpDepthRatio
            zTp := dir > 0 ? _base - tpBuffer : _base + tpBuffer

        //  ---- 判定順序は zn.buildPlanWithTpDepth() と同一 ----
        bool insideActive = zn.isInsideActiveZone(zoneEng, zoneCfg, entryPrice)
        pSl   := zSl
        pRisk := zRisk
        if dir == 0
            pStatus := "FAIL"
            pReason := "NO_ENTRY"
        else if insideActive
            pStatus := "FAIL"
            pReason := "INSIDE_ACTIVE_ZONE"
        else if not slZ.found or na(zSl)
            //  有効な SL Zone が無ければ ZONE モードでは FAIL
            pStatus := "FAIL"
            pReason := "NO_SL_ZONE"
        else if na(zRisk) or zRisk <= 0
            pStatus := "FAIL"
            pReason := "INVALID_SL"
        else if zRisk > maxSlDist
            pStatus := "FAIL"
            pReason := "SL_TOO_FAR"
        else if tpZ.found and not na(zTp)
            //  ---- Structural TP あり (STEP 11 : minStructRR 未満は FAIL) ----
            pTp     := zTp
            pTpType := "STRUCTURAL"
            float _rew = math.abs(zTp - entryPrice)
            pRr := zRisk > 0 ? _rew / zRisk : na
            if _rew <= 0
                pStatus := "FAIL"
                pReason := "TP_WRONG_SIDE"
            else if na(pRr) or pRr < minStructRR
                //  Fallback RR へは逃がさない (従来仕様のまま)
                pStatus := "FAIL"
                pReason := "LOW_STRUCTURAL_RR"
            else
                pValid  := true
                pStatus := "PASS"
                pReason := "OK_STRUCTURAL_TP"
        else
            //  ---- Structural TP なし → Fallback RR (STEP 10) ----
            float _ftp = entryPrice + dir * zRisk * fallbackRR
            pTp     := _ftp
            pRr     := fallbackRR
            pTpType := "FALLBACK_RR"
            pValid  := true
            pStatus := "PASS"
            pReason := "OK_FALLBACK_TP"

        //  ---- Debug 用に採用した Zone の Level / Touch / BirthScore を控える ----
        gSlLevel := slZ.found ? slZ.level : 0
        gSlTouch := slZ.found ? slZ.touchCount : na
        gSlBirth := slZ.found ? slZ.birthScore : na
        gTpLevel := tpZ.found ? tpZ.level : 0
        gTpTouch := tpZ.found ? tpZ.touchCount : na
        gTpBirth := tpZ.found ? tpZ.birthScore : na
        // ---- TP Mode フィルター (Structural / Fallback の成績切り分け用) ----
        //  PASS → FAIL の一方向のみ。FAIL → PASS への昇格は行わない。
        if tpMode == "STRUCTURAL_ONLY" and pTpType == "FALLBACK_RR"
            pValid  := false
            pStatus := "FAIL"
            pReason := "NO_STRUCTURAL_TP"
        else if tpMode == "FALLBACK_ONLY" and pTpType == "STRUCTURAL"
            pValid  := false
            pStatus := "FAIL"
            pReason := "STRUCTURAL_TP_EXISTS"
    else
        //  FIXED : Long / Short 完全対称
        //    LONG  : SL = Entry - Fixed SL / TP = Entry + Fixed TP
        //    SHORT : SL = Entry + Fixed SL / TP = Entry - Fixed TP
        if dir > 0
            pSl := entryPrice - fixedSlDollar
            pTp := entryPrice + fixedTpDollar
        else
            pSl := entryPrice + fixedSlDollar
            pTp := entryPrice - fixedTpDollar
        pRisk   := fixedSlDollar
        pRr     := fixedSlDollar > 0 ? fixedTpDollar / fixedSlDollar : na
        pTpType := "FIXED"
        if fixedSlDollar > 0 and fixedTpDollar > 0
            pValid  := true
            pStatus := "PASS"
            pReason := "FIXED_SLTP"
        else
            pReason := "INVALID_FIXED_SLTP"
    [pValid, pSl, pTp, pRr, pRisk, pStatus, pReason, pTpType]

f_recordPlan(int dir, float entryP, float sl, float tp, float rr, float risk, string tpType, string status, string reason, string extra) =>
    array.set(gLastPlan, 0,
         LOGIC_ID + " " + (dir > 0 ? "LONG" : "SHORT") +
         " | Mode " + sltpMode +
         " | E " + f_num(entryP, "#.##") +
         " | SL " + f_num(sl, "#.##") +
         " | TP " + f_num(tp, "#.##") +
         " | RR " + f_num(rr, "#.##") +
         " | " + tpType)
    array.set(gLastPlan, 1, status + " · " + reason + (extra == "" ? "" : " · " + extra))
    float q  = f_qty(risk)
    float el = f_expectedLoss(q, risk)
    float bc = f_baseCapital()
    array.set(gLastPlan, 2,
         "RiskCap " + f_num(f_riskCapital(), "#.##") + " (" + f_num(riskPct, "#.##") + "%)" +
         " | SLdist " + f_num(risk, "#.##") +
         " | Qty " + f_num(q, "#.####") +
         " | ExpLoss " + f_num(el, "#.##") +
         " (" + f_num(bc > 0 ? el / bc * 100.0 : na, "#.###") + "%)" +
         " | PV " + str.tostring(syminfo.pointvalue) + " " + syminfo.currency)
    true

// ★ ここが唯一 strategy.entry / strategy.exit を呼ぶ場所。
//   Entry 時点の SL / TP を strategy.exit へ渡して固定する。
//   戻り値 : 実際に発注できたら Entry ID、できなければ ""
f_submitSignal(bool signal, int dir, float entryPrice, string patternName) =>
    string eid = ""
    bool dirOk = (dir > 0 and enableLong) or (dir < 0 and enableShort)
    if signal and dirOk and dir != 0
        [pValid, pSl, pTp, pRr, pRisk, pStatus, pReason, pTpType] = f_buildPlan(dir, entryPrice)
        if not pValid
            f_recordPlan(dir, entryPrice, pSl, pTp, pRr, pRisk, pTpType, pStatus, pReason, patternName)
        else
            float qty = f_qty(pRisk)
            bool oppositeConflict = not allowOppositeEntry and
                 ((dir > 0 and strategy.position_size < 0) or (dir < 0 and strategy.position_size > 0))
            bool tradesFull = strategy.opentrades >= maxOpenTrades
            if tradesFull
                f_recordPlan(dir, entryPrice, pSl, pTp, pRr, pRisk, pTpType, "FAIL", "SKIP_MAX_OPEN", patternName)
            else if oppositeConflict
                f_recordPlan(dir, entryPrice, pSl, pTp, pRr, pRisk, pTpType, "FAIL", "SKIP_OPPOSITE_POSITION", patternName)
            else if qty < qtyMin or qty <= 0
                f_recordPlan(dir, entryPrice, pSl, pTp, pRr, pRisk, pTpType, "FAIL", "SKIP_NO_QTY", patternName)
            else
                int n = array.get(gSeq, 0) + 1
                array.set(gSeq, 0, n)
                eid := LOGIC_ID + (dir > 0 ? "_L_" : "_S_") + str.tostring(n)
                strategy.entry(eid, dir > 0 ? strategy.long : strategy.short, qty = qty)
                //  Entry 時点の SL / TP をここで固定する。以後 Zone が変化しても更新しない。
                strategy.exit(eid + "X", from_entry = eid, stop = pSl, limit = pTp,
                     comment_profit = "TP", comment_loss = "SL")
                f_recordPlan(dir, entryPrice, pSl, pTp, pRr, pRisk, pTpType, pStatus, pReason, eid + " · " + patternName)
                if showEntryLabel
                    string ltxt = (dir > 0 ? "LONG" : "SHORT") + "  " + patternName
                    ltxt := ltxt + "\nEntry " + f_num(entryPrice, "#.##")
                    ltxt := ltxt + "\nSL    " + f_num(pSl, "#.##")
                    ltxt := ltxt + "\nTP    " + f_num(pTp, "#.##")
                    ltxt := ltxt + "\nRR    " + f_num(pRr, "#.##")
                    ltxt := ltxt + "\nMode  " + sltpMode + " (" + pTpType + ")"
                    ltxt := ltxt + "\nFilter " + entryFilterMode
                    ltxt := ltxt + "\nQty   " + f_num(qty, "#.####")
                    label.new(bar_index, dir > 0 ? low : high, text = ltxt,
                         style = dir > 0 ? label.style_label_up : label.style_label_down,
                         color = dir > 0 ? color.new(bgBuyCol, 20) : color.new(bgSellCol, 20),
                         textcolor = color.white,
                         size = size.small)
    eid

// ============================================================================
// 08. ORDER EXECUTION + State Reset
// ----------------------------------------------------------------------------
//  ★ 同一バーで Pattern A と Pattern B が同時に成立することはない
//    (A は SAW_FLAT からの青、B は SAW_RED からのフラットで、State が排他のため)。
//  ★ LONG を先に処理する。Long が発注できた場合、反対方向の Short は
//    allowOppositeEntry = false なら f_submitSignal 内で自動的に SKIP される。
//
//  ★ Entry Filter で落ちた場合の State 遷移 (重要) ★
//    longSignal / shortSignal は「baseSignal AND フィルター」なので、
//    フィルター不成立なら f_submitSignal は何もせず eid = "" を返す。
//    下の再アームは eid != "" のときだけ走るため、15秒 State Machine は
//    そのバーで本来遷移するはずの自然な次状態 (lsNext / ssNext) のまま残る。
//    Pattern A 完成 → フィルター NG → Entry なし → State は ARMED のまま、
//    という既存の遷移がそのまま維持される。WAIT_INITIAL へ強制リセットはしない。
// ============================================================================
string longEid  = f_submitSignal(longSignal,  1, close, f_patternName(longEntryPattern))
string shortEid = f_submitSignal(shortSignal, -1, close, f_patternName(shortEntryPattern))

//  Entry 後の再アーム : 実際に発注できたときだけ待機状態を完全リセットする。
//  発注できなかった場合 (TradePlan FAIL / Qty 不足 / ポジション制御) は
//  待機イベントを消費せず、lsNext / ssNext の自然な次状態のまま継続する。
//  ★ Entry Filter ② の pending も「Entry 成立」でのみ解除する。
//    発注できなかった場合は pending を残し、次に確定5分背景が目的色へ
//    切り替わったタイミングで再度発火できるようにする
//    (1分条件が崩れればそこで破棄される)。
//  ★ CANDIDATE_17 の 1 回目 Deep だけ、この Reset を適用しない ★
//    C17 は 1 つの Setup から Deep を最大 2 回取る。1 回目の Deep では
//    f_setupTriggerTwoDeep() が ST_ARMED を返して 2 回目を待つが、
//    ここで無条件に ST_WAIT へ上書きすると 2 回目を待てなくなる。
//    そのため c17LongDeep / c17ShortDeep が 1 (= その Setup の 1 回目) の
//    ときだけ Reset をスキップし、関数が返した ST_ARMED をそのまま残す。
//    ・2 回目 (count >= 2) は関数側で既に ST_WAIT を返しているので通常どおり。
//    ・1 回目のあとに Setup 条件が崩れた場合は、次バーの
//      f_setupTriggerTwoDeep() の 1) キャンセル処理で ST_WAIT になる。
//    ・Deep 回数は従来どおり「Base Signal を出した回数」で数えており、
//      発注できた回数では数えていない (この例外は数え方を変えていない)。
//    ・条件に baseSignalMode == BASE_C17 を含めているので、
//      CURRENT ～ CANDIDATE_16 の Reset は一切変わらない。
//    ・Entry Filter ② の pending 解除 (long5mPending / longPendingPattern) は
//      例外の外に置き、従来どおり Entry 成立で必ず解除する。
if longEid != ""
    if not (baseSignalMode == BASE_C17 and c17LongDeep == 1)
        lsNext := ST_WAIT
    long5mPending      := false
    longPendingPattern := 0
if shortEid != ""
    if not (baseSignalMode == BASE_C17 and c17ShortDeep == 1)
        ssNext := ST_WAIT
    short5mPending      := false
    shortPendingPattern := 0

longState  := lsNext
shortState := ssNext

//  Pattern A / B 別の Entry 回数 (表示専用。Entry 判定には一切使わない)。
//  Filter Mode を切り替えたときに A / B のどちらが削られたかを比較するため。
var int cntLongA  = 0
var int cntLongB  = 0
var int cntShortA = 0
var int cntShortB = 0
if longEid != ""
    if longEntryPattern == 1
        cntLongA := cntLongA + 1
    else if longEntryPattern == 2
        cntLongB := cntLongB + 1
if shortEid != ""
    if shortEntryPattern == 1
        cntShortA := cntShortA + 1
    else if shortEntryPattern == 2
        cntShortB := cntShortB + 1

// ============================================================================
// 09. DISPLAY / DEBUG
// ============================================================================
// ---- 9.1 SAT ライン / 背景 -------------------------------------------------
plot(showL2 and not na(satL2Line) ? satL2Line : na, title = "SAT's BAND LINE2",
     color = satL2Dir == 1 ? satUpCol : satL2Dir == -1 ? satDnCol : color.rgb(149, 152, 161),
     linewidth = l2Width)
plot(showL1 and not na(satL1Line) ? satL1Line : na, title = "SAT's BAND LINE1",
     color = satL1Dir == 1 ? satUpCol : satL1Dir == -1 ? satDnCol : color.rgb(149, 152, 161),
     linewidth = l1Width)
plot(showStb and not na(satStbLine) ? satStbLine : na, title = "STB Line",
     color = satStbDir == 1 ? satUpCol : satStbDir == -1 ? satDnCol : color.rgb(149, 152, 161),
     linewidth = stbWidth)
plot(showMa ? maVal : na, title = "MA",
     color = maDir == 1 ? maUpCol : maDir == -1 ? maDnCol : maFlatCol,
     linewidth = maWidth)

color bgFinal = na
if bg15 == BG_BLUE
    bgFinal := color.new(bgBuyCol, bgTransp)
else if bg15 == BG_RED
    bgFinal := color.new(bgSellCol, bgTransp)
bgcolor(bgFinal, title = "SAT 15s 背景")

// ---- 9.2 Data Window (デバッグ用の数値) -----------------------------------
//  背景 State : 1 = 青 / -1 = 赤 / 0 = フラット
//  待機状態   : 0 = WAIT_INITIAL / 1 = ARMED / 2 = SAW_FLAT / 3 = SAW_RED(青)
plot(bg15 * 1.0,  title = "DW: 15s 背景State",        display = display.data_window)
plot(bg30 * 1.0,  title = "DW: 30s 確定背景State",     display = display.data_window)
plot(bg1m * 1.0,  title = "DW: 1m 確定背景State",      display = display.data_window)
plot(bg5m * 1.0,  title = "DW: 5m 確定背景State",      display = display.data_window)
//  HTF SAT Filter : 各上位足の確定背景 State (+1 BLUE / 0 FLAT / -1 RED)
//  ※ useHtfFilter = false のときは request を発行しないので 0 (FLAT) 固定。
//  ★ 5分は上の「DW: 5m 確定背景State」と同じ bg5m なので plot を重複させない
//    (plot 上限 64 に収めるため。CSV では 5m 確定背景State 列をそのまま使う)。
plot(bg15m    * 1.0, title = "DW: HTF 15m State", display = display.data_window)
plot(bg30mHtf * 1.0, title = "DW: HTF 30m State", display = display.data_window)
plot(bg1h     * 1.0, title = "DW: HTF 1H State",  display = display.data_window)
plot(bg4h     * 1.0, title = "DW: HTF 4H State",  display = display.data_window)
plot(bgD      * 1.0, title = "DW: HTF D State",   display = display.data_window)
plot(bgW      * 1.0, title = "DW: HTF W State",   display = display.data_window)
plot(htfLongPass  ? 1.0 : 0.0, title = "DW: HTF LONG Pass",  display = display.data_window)
plot(htfShortPass ? 1.0 : 0.0, title = "DW: HTF SHORT Pass", display = display.data_window)
//  Entry Filter ① : 1分 色遷移 State
//    0 = WAIT_OPP / 1 = SAW_OPP / 2 = OPP_THEN_FLAT / 3 = VALID
plot(long1mTrState  * 1.0, title = "DW: 1m Transition LONG State",  display = display.data_window)
plot(short1mTrState * 1.0, title = "DW: 1m Transition SHORT State", display = display.data_window)
plot(long1mTransitionValid  ? 1.0 : 0.0, title = "DW: 1m Transition LONG Valid",  display = display.data_window)
plot(short1mTransitionValid ? 1.0 : 0.0, title = "DW: 1m Transition SHORT Valid", display = display.data_window)
//  転換後 何本目の確定1分足か (0 = VALID ではない)。transitionValidBars 以内だけ ① PASS。
plot(long1mValidBars  * 1.0, title = "DW: ① LONG Valid Bars",  display = display.data_window)
plot(short1mValidBars * 1.0, title = "DW: ① SHORT Valid Bars", display = display.data_window)
//  各フィルターの通過可否 (Mode に関係なく常に計算している)
plot(f1LongPass  ? 1.0 : 0.0, title = "DW: ① LONG Pass",  display = display.data_window)
plot(f1ShortPass ? 1.0 : 0.0, title = "DW: ① SHORT Pass", display = display.data_window)
plot(f2LongPass  ? 1.0 : 0.0, title = "DW: ② LONG Pass (発火)",  display = display.data_window)
plot(f2ShortPass ? 1.0 : 0.0, title = "DW: ② SHORT Pass (発火)", display = display.data_window)
//  ② の待機状態と、確定5分背景が目的色へ切り替わったイベント
plot(long5mPending  ? 1.0 : 0.0, title = "DW: ② LONG Pending",  display = display.data_window)
plot(short5mPending ? 1.0 : 0.0, title = "DW: ② SHORT Pending", display = display.data_window)
plot(bg5mTurnedBlue ? 1.0 : 0.0, title = "DW: 5m turned BLUE",  display = display.data_window)
plot(bg5mTurnedRed  ? 1.0 : 0.0, title = "DW: 5m turned RED",   display = display.data_window)
//  Entry Filter Mode : 1 = ① / 2 = ② / 3 = ①+② / 4 = ③ Base Only
plot(entryFilterMode == FM_1M ? 1.0 : entryFilterMode == FM_5M ? 2.0 : entryFilterMode == FM_BOTH ? 3.0 : 4.0,
     title = "DW: Entry Filter Mode", display = display.data_window)
//  素の Signal (フィルター適用前) と 最終 Signal (適用後)
//  Base Signal Mode
//    0 = CURRENT / 1 ～ 17 = CANDIDATE_1 ～ CANDIDATE_17
//  ★ plot は 1 本のまま。分岐を足しているだけで plot 数は増やしていない。
plot(baseSignalMode == BASE_CURRENT ? 0.0 : baseSignalMode == BASE_C1 ? 1.0 :
     baseSignalMode == BASE_C2 ? 2.0 : baseSignalMode == BASE_C3 ? 3.0 :
     baseSignalMode == BASE_C4 ? 4.0 : baseSignalMode == BASE_C5 ? 5.0 :
     baseSignalMode == BASE_C6 ? 6.0 : baseSignalMode == BASE_C7 ? 7.0 :
     baseSignalMode == BASE_C8 ? 8.0 : baseSignalMode == BASE_C9 ? 9.0 :
     baseSignalMode == BASE_C10 ? 10.0 : baseSignalMode == BASE_C11 ? 11.0 :
     baseSignalMode == BASE_C12 ? 12.0 : baseSignalMode == BASE_C13 ? 13.0 :
     baseSignalMode == BASE_C14 ? 14.0 : baseSignalMode == BASE_C15 ? 15.0 :
     baseSignalMode == BASE_C16 ? 16.0 : baseSignalMode == BASE_C17 ? 17.0 : -1.0,
     title = "DW: Base Signal Mode", display = display.data_window)
//  Trigger 種別 (表示専用。Entry 判定には一切使わない)
//    0 = none / 1 = Deep (Opposite → FLAT) / 2 = Direct (Opposite → 目的色) /
//    3 = Shallow (FLAT → 目的色)
//    CURRENT ～ C7 は常に 0。C8 は Deep なので 1。C9 ～ C12 は実際の種別。
plot(baseTrigType, title = "DW: Trigger Type", display = display.data_window)
//  CANDIDATE_3 ～ CANDIDATE_7 の Setup Event 研究用
//  (5m turned BLUE / RED は上の ② 用のものをそのまま流用する)
plot(bg1mTurnedBlue  ? 1.0 : 0.0, title = "DW: 1m turned BLUE",   display = display.data_window)
plot(bg1mTurnedRed   ? 1.0 : 0.0, title = "DW: 1m turned RED",    display = display.data_window)
plot(newConfirmed30s ? 1.0 : 0.0, title = "DW: New Confirmed 30s", display = display.data_window)
//  Pattern A / B を個別に出す (Python で Base Signal から再探索するため)。
//  ★ State Machine の出力を読むだけ。Pattern 判定そのものには一切関与しない。
plot(longSigA  ? 1.0 : 0.0, title = "DW: LONG Pattern A Signal",  display = display.data_window)
plot(longSigB  ? 1.0 : 0.0, title = "DW: LONG Pattern B Signal",  display = display.data_window)
plot(shortSigA ? 1.0 : 0.0, title = "DW: SHORT Pattern A Signal", display = display.data_window)
plot(shortSigB ? 1.0 : 0.0, title = "DW: SHORT Pattern B Signal", display = display.data_window)
plot(baseLongSignal  ? 1.0 : 0.0, title = "DW: base LONG Signal",  display = display.data_window)
plot(baseShortSignal ? 1.0 : 0.0, title = "DW: base SHORT Signal", display = display.data_window)
plot(longSignal  ? 1.0 : 0.0, title = "DW: final LONG Signal",  display = display.data_window)
plot(shortSignal ? 1.0 : 0.0, title = "DW: final SHORT Signal", display = display.data_window)
plot(longState  * 1.0, title = "DW: LONG Pattern State",  display = display.data_window)
plot(shortState * 1.0, title = "DW: SHORT Pattern State", display = display.data_window)
plot(longState  != ST_WAIT ? 1.0 : 0.0, title = "DW: LONG 待機状態",  display = display.data_window)
plot(shortState != ST_WAIT ? 1.0 : 0.0, title = "DW: SHORT 待機状態", display = display.data_window)
//  SAT BAND Reconstruction の内部値 (診断用。Entry 判定には一切使わない)
plot(satBasis,   title = "DW: basis (vwma hlc3 5)",   display = display.data_window)
plot(satCommon,  title = "DW: common (basis*0.5)",    display = display.data_window)
plot(satAtr50,   title = "DW: atr50 (ta.atr(50)[1])", display = display.data_window)
plot(satAnchor1, title = "DW: anchor1 (k=5.0)",       display = display.data_window)
plot(satAnchor2, title = "DW: anchor2 (k=2.5)",       display = display.data_window)
plot(satStbLine,      title = "DW: STB 表示価格",   display = display.data_window)
plot(satStbDir * 1.0, title = "DW: STB 方向",       display = display.data_window)
plot(satL1Line,       title = "DW: LINE1 表示価格", display = display.data_window)
plot(satL1Dir * 1.0,  title = "DW: LINE1 方向",     display = display.data_window)
plot(satL2Line,       title = "DW: LINE2 表示価格", display = display.data_window)
plot(satL2Dir * 1.0,  title = "DW: LINE2 方向",     display = display.data_window)

// ---- 9.3 Zone Box (ZONE モードのみ・既定 OFF) -----------------------------
var array<box> gBoxes = array.new<box>()

f_zoneColor(int st) =>
    st == ST_SUPPORT ? colSupport : st == ST_RESIST ? colResistance : st == ST_ACTIVE ? colActive : colBroken

f_zoneTransp(int strength) =>
    strength == SR_VSTRONG ? 55 : strength == SR_STRONG ? 68 : strength == SR_MEDIUM ? 80 : 90

if barstate.islast
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    if useZoneSltp and showZones and zn.zoneCount(zoneEng) > 0
        array<int> ord = zn.drawOrder(zoneEng, maxZonesDraw)
        if array.size(ord) > 0
            for k = 0 to array.size(ord) - 1
                zn.Zone z = zn.zoneAt(zoneEng, array.get(ord, k))
                color bc = f_zoneColor(z.state)
                int   tr = f_zoneTransp(z.strength)
                box b = box.new(
                     left         = bar_index - zoneLeftBars,
                     top          = z.top,
                     right        = bar_index + zoneRightBars,
                     bottom       = z.bottom,
                     bgcolor      = color.new(bc, tr),
                     border_color = color.new(bc, math.max(tr - 30, 0)),
                     border_width = z.strength >= SR_STRONG ? 2 : 1,
                     border_style = z.state == ST_BROKEN ? line.style_dashed : line.style_solid,
                     xloc         = xloc.bar_index)
                array.push(gBoxes, b)

// ---- 9.4 Debug Table -------------------------------------------------------
f_textSize(string s) =>
    s == "tiny" ? size.tiny : s == "normal" ? size.normal : size.small

var table dbgTable = table.new(position.top_right, 2, 21,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

if showDebugTable and barstate.islast
    color bgH = color.new(color.gray,  70)
    color bgS = color.new(color.blue,  75)
    color bgC = color.new(color.black, 60)
    color bgF = color.new(color.purple, 70)
    string ts0 = dbgTextSize

    table.cell(dbgTable, 0, 0, "SAT MTF DEBUG", text_color = color.white, bgcolor = bgH, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 0, timeframe.period + "  /  " + sltpMode +
         "  /  Base " + baseSignalMode, text_color = color.white, bgcolor = bgH, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 1, "15s 背景", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 1, f_bgStr(bg15) +
         "   basis " + f_num(satBasis, format.mintick) +
         " / common " + f_num(satCommon, format.mintick) +
         " / atr50 " + f_num(satAtr50, format.mintick),
         text_color = f_bgCol(bg15), bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 2, "30s 確定背景", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 2, f_bgStr(bg30) + "  [" + satTf30 + "]", text_color = f_bgCol(bg30), bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 3, "1m 確定背景", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 3, f_bgStr(bg1m) + "  [" + satTf1m + "]", text_color = f_bgCol(bg1m), bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 4, "5m 確定背景", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 4, f_bgStr(bg5m) + "  [" + satTf5m + "]  ※Entry Filter ② 用 (ZoneEngine Base TF とは別)",
         text_color = f_bgCol(bg5m), bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 5, "HTF 背景", text_color = color.white, bgcolor = bgH, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 5,
         not needHtfResearchData ? "HTF Filter OFF / Research Export OFF (未計算)" :
         (not useHtfFilter ? "[Research のみ・Entry 未使用] " : "") +
         "5m " + f_bgChar(bg5m) + " / 15m " + f_bgChar(bg15m) + " / 30m " + f_bgChar(bg30mHtf) +
         " / 1H " + f_bgChar(bg1h) + " / 4H " + f_bgChar(bg4h) +
         " / D " + f_bgChar(bgD) + " / W " + f_bgChar(bgW) + "    (B=BLUE / F=FLAT / R=RED)",
         text_color = color.white, bgcolor = bgH, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 6, "HTF 判定", text_color = color.white, bgcolor = bgH, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 6,
         not useHtfFilter ? "OFF" :
         "HTF " + htfCombineMode +
         "  |  LONG "  + (htfLongPass  ? "PASS" : "FAIL") +
         " (" + str.tostring(htfLongHit)  + "/" + str.tostring(htfLongActive)  + ")" +
         "  /  SHORT " + (htfShortPass ? "PASS" : "FAIL") +
         " (" + str.tostring(htfShortHit) + "/" + str.tostring(htfShortActive) + ")" +
         (htfLongActive == 0 and htfShortActive == 0 ? "   ※全時間足 OFF のため常に PASS" : ""),
         text_color = not useHtfFilter ? color.white :
              htfLongPass and htfShortPass ? color.white :
              htfLongPass ? bgBuyCol : htfShortPass ? bgSellCol : color.rgb(149, 152, 161),
         bgcolor = bgH, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 7, "Entry Filter", text_color = color.white, bgcolor = bgF, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 7, entryFilterMode +
         " (code " + (entryFilterMode == FM_1M ? "1" : entryFilterMode == FM_5M ? "2" :
              entryFilterMode == FM_BOTH ? "3" : "4 = Base Only") + ")" +
         "   ①L " + (f1LongPass ? "VALID" : "-") + " / ①S " + (f1ShortPass ? "VALID" : "-") +
         "   ② pending L " + (long5mPending ? "WAIT(" + f_patternName(longPendingPattern) + ")" : "-") +
         " / S " + (short5mPending ? "WAIT(" + f_patternName(shortPendingPattern) + ")" : "-") +
         "   5m turn " + (bg5mTurnedBlue ? "→BLUE" : bg5mTurnedRed ? "→RED" : "-") +
         (bg5mBlueFromFlat ? "(FLAT起点)" : bg5mBlueFromRed ? "(RED起点)" :
              bg5mRedFromFlat ? "(FLAT起点)" : bg5mRedFromBlue ? "(BLUE起点)" : "") +
         "   C13/14 1m待ち L " + str.tostring(baseSignalMode == BASE_C13 ? c13LongWait1m : c14LongWait1m) +
         " / S " + str.tostring(baseSignalMode == BASE_C13 ? c13ShortWait1m : c14ShortWait1m) +
         "   C17 Deep L " + str.tostring(c17LongDeep) + " / S " + str.tostring(c17ShortDeep) +
         "   発火 L " + (f2LongPass ? "FIRE" : "-") + " / S " + (f2ShortPass ? "FIRE" : "-"),
         text_color = color.white, bgcolor = bgF, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 8, "1m Transition", text_color = color.white, bgcolor = bgF, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 8,
         "LONG "  + f_trStateStr(long1mTrState,  true)  + " → " + (long1mTransitionValid  ? "VALID" : "invalid") +
         " (" + str.tostring(long1mValidBars)  + "/" + str.tostring(transitionValidBars) + "本目)" +
         "   |   SHORT " + f_trStateStr(short1mTrState, false) + " → " + (short1mTransitionValid ? "VALID" : "invalid") +
         " (" + str.tostring(short1mValidBars) + "/" + str.tostring(transitionValidBars) + "本目)",
         text_color = long1mTransitionValid ? bgBuyCol : short1mTransitionValid ? bgSellCol : color.white,
         bgcolor = bgF, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 9, "LONG 待機状態", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 9, longState != ST_WAIT ? "ON" : "OFF",
         text_color = longState != ST_WAIT ? bgBuyCol : color.rgb(149, 152, 161), bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 10, "LONG Pattern State", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 10, f_longStateStr(longState), text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 11, "SHORT 待機状態", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 11, shortState != ST_WAIT ? "ON" : "OFF",
         text_color = shortState != ST_WAIT ? bgSellCol : color.rgb(149, 152, 161), bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 12, "SHORT Pattern State", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 12, f_shortStateStr(shortState), text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 13, "STB", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 13, f_num(satStbLine, format.mintick) + "  (Donchian 表示10 / 転換20)",
         text_color = satStbDir == 1 ? satUpCol : satStbDir == -1 ? satDnCol : color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 14, "LINE1", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 14, f_num(satL1Line, format.mintick) +
         "  (k=5.0 / anchor " + f_num(satAnchor1, format.mintick) + ")",
         text_color = satL1Dir == 1 ? satUpCol : satL1Dir == -1 ? satDnCol : color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 15, "LINE2", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 15, f_num(satL2Line, format.mintick) +
         "  (k=2.5 / anchor " + f_num(satAnchor2, format.mintick) + ")",
         text_color = satL2Dir == 1 ? satUpCol : satL2Dir == -1 ? satDnCol : color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 16, "PLAN", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 16, array.get(gLastPlan, 0), text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 17, "STATUS", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 17, array.get(gLastPlan, 1) + "  |  Open " + str.tostring(strategy.opentrades) +
         "  |  Closed " + str.tostring(strategy.closedtrades) +
         "  |  Entry L A" + str.tostring(cntLongA) + "/B" + str.tostring(cntLongB) +
         " S A" + str.tostring(cntShortA) + "/B" + str.tostring(cntShortB) +
         (useZoneSltp ? "  |  Zones " + str.tostring(zoneCountNow) +
              "  |  ZoneUpd " + str.tostring(zoneUpdateCnt) +
              "  |  BaseSeq " + str.tostring(zoneBaseSeq) : ""),
         text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 18, "Zone Base TF", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 18,
         not useZoneSltp ? "FIXED モードのため Zone 未使用" :
         zoneBaseTf + "  確定足 O " + f_num(bOpen, "#.##") +
         " / H " + f_num(bHigh, "#.##") + " / L " + f_num(bLow, "#.##") +
         " / C " + f_num(bClose, "#.##") +
         "  | PrevC " + f_num(bPrevClose, "#.##") +
         "  | Seq " + str.tostring(zoneBaseSeq) +
         "  | " + (na(bTime) ? "-" : str.format_time(bTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC") +
         (newBaseBar ? "   ← このバーで Zone 更新" : ""),
         text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))

    table.cell(dbgTable, 0, 19, "QTY", text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 19, array.get(gLastPlan, 2) +
         (timeframe.in_seconds() != 15 ? "   ※本Strategyは15秒足チャート前提" : ""),
         text_color = color.white, bgcolor = bgC, text_size = f_textSize(ts0))

    //  ---- ZONE モードで採用した SL / TP Zone の Zone Level (表示専用) --------
    //    「Strong T1 を使ったのか / Very Strong T0 を使ったのか」を確認する。
    //    Level は birthScore と touchCount だけで決まる (Raw Strength とは別軸)。
    table.cell(dbgTable, 0, 20, "Zone Level", text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))
    table.cell(dbgTable, 1, 20,
         not useZoneSltp ? "FIXED モードのため Zone Level 未使用" :
         "SL " + zl.levelName(gSlLevel) +
         " T" + (na(gSlTouch) ? "-" : str.tostring(gSlTouch)) +
         " (birth " + f_num(gSlBirth, "#.##") + ")" +
         "   |   TP " + zl.levelName(gTpLevel) +
         " T" + (na(gTpTouch) ? "-" : str.tostring(gTpTouch)) +
         " (birth " + f_num(gTpBirth, "#.##") + ")" +
         "   |   最低条件 SL " + slMinLevelStr + " / TP " + tpMinLevelStr +
         "   |   LvlUpd " + str.tostring(levelUpdateCnt) +
         "   |   ZoneLv本数 " + str.tostring(zl.zoneCount(levelEng)) +
         "   |   Reaction Bonus " + (useReactionScoreBonus ? "ON" : "OFF"),
         text_color = color.white, bgcolor = bgS, text_size = f_textSize(ts0))

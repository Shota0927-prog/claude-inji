// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  SAT MTF Background Strategy  (15s / 30s / 1m)
// ============================================================================
//  ベース : SAT PANEL Approximation        … STB / LINE1 / LINE2 / 背景判定
//  Zone   : FVG + Zone Engine Strategy     … ZoneEngine / TradePlan / Risk / Qty
//
//  ★ チャート時間足は 15秒足 前提 ★
//
//  ★★ 時間軸の分離 ★★
//    SAT Entry Logic      … 15秒足 (30秒 / 1分 の確定背景を参照)
//    Zone Engine          … Base TF 5分 (ZoneEngine v10 / チャート足から独立)
//    TradePlan entryPrice … SAT Pattern 成立時の 15秒 close
//
//    Zone 側は ZoneEngine v10 を使い、Zone State 更新が参照する現在足情報
//    (high / low / close / close[1] / time / bar_index) をすべて ZoneFeed の
//    base* から受け取る。zn.update() は Base TF 足 1 本につき 1 回だけ呼ぶ。
//    → 15秒足チャート上でも、Zone は元 5分 Strategy と同じ時間軸で動く。
//
//  Entry の中心は「15s / 30s / 1m SAT Background State Machine」。
//  SignalEngine は使わない (SAT背景 State Machine が Entry Signal そのもの)。
//
//  構成:
//    01. ALL INPUTS
//         01-1 SAT PANEL (正式ロジック)
//         01-2 MTF / Entry
//         01-3 SL/TP Mode  (ZONE / FIXED)
//         01-4 Zone Engine (ZONE モード用)
//         01-5 Trade Engine (Risk / Qty / Order)
//         01-6 Display / Debug
//    02. SAT PANEL 計算関数 (チャート足と HTF で完全に同一の関数を使う)
//    03. SAT 背景 : 15s / 30s / 1m
//    04. ENTRY STATE MACHINE (LONG / SHORT 独立)
//    05. ZONE ENGINE (ZONE モードのみ)
//    06. RISK / QTY
//    07. TRADE ENGINE (SL/TP 決定 → Qty → strategy.entry → strategy.exit)
//    08. ORDER EXECUTION + State Reset
//    09. DISPLAY / DEBUG
//
// ----------------------------------------------------------------------------
//  ■ SAT PANEL 側について (元ファイルを正として扱っている範囲)
//
//   本 Strategy が使うのは元ファイルの「正式ライン」だけである。
//   計算式は元ファイルからそのまま持ち込んでおり、置き換えていない。
//
//     STB    … 正式 STB = Donchian (表示期間 / 転換期間を分離)
//              ・表示バンド : ta.highest(high, 表示期間) / ta.lowest(low, 表示期間)
//              ・転換判定   : 当該足を含める前のレンジ [1] を high / low のヒゲで突破
//              ・上抜けを先に判定し、下抜けは else if。同一バーで両方なら上抜け優先
//              ・ATR / EMA / 平滑化 / Supertrend / 確認本数は一切かけない
//     LINE1  … EMA ATR Breakout Band の表示バンド
//              ＋ 価格State方式「専用転換Band＋確認」(元ファイルの標準初期値)
//     LINE2  … EMA ATR Breakout Band の表示バンド (ST表示候補 相当の値)
//              ＋ 価格State方式「Supertrend非対称＋高ボラ補正」(元ファイルの標準初期値)
//              ＋ 色判定方式「終値 vs 最終LINE2」→ これが正式 LINE2 方向
//     背景   … 「価格が3本すべてを突破」
//              青 : 判定ソース > STB表示値 / LINE1表示値 / LINE2表示値 の3本すべて
//              赤 : 判定ソース < 上記3本すべて
//              フラット : どちらでもない / いずれかが na
//
//   ■ 元ファイルから持ち込んでいないもの (Entry結果に影響しないため)
//     ・比較表示モード (上下バンド比較 / 固定ATR比較 / STB構造比較 など)
//     ・CSV検証プリセット切替 UI と、その対象になっていた旧候補系列
//     ・旧 Supertrend STB / ATR Trailing / EMA+ATR Band などの「他方式」
//     ・15m / 1H / 4H / D / W の MTF 参考表示 (request.security を 5 本消費するため)
//     ・接近挙動マーカー / 転換確認マーカー などの診断描画
//     いずれも元ファイルでも正式ラインの計算には使われていない比較・診断用機能で、
//     STB / LINE1 / LINE2 / 背景 の計算式そのものには一切手を入れていない。
//     正式ラインのパラメータは元ファイルの標準初期値をそのまま input として残してある。
//
// ----------------------------------------------------------------------------
//  ■ リペイント防止
//   ・Entry Signal は必ず「確定した15秒足」で決定する (barstate.isconfirmed)。
//   ・30秒 / 1分の背景は request.security(..., lookahead_on) の内部で式に [1] を掛け、
//     「最後に確定した HTF バー」の値だけを使う。形成中 HTF は絶対に使わない。
//     ★ lookahead_on は必ず [1] とセットで使う。単独では絶対に使わない (未来参照になる)。
//       [1] が「ひとつ前の閉じた HTF バー」を指すため、lookahead_on が前借りするのは
//       その確定済みバーの値だけで、未来の情報は入らない。
//       lookahead_off + [1] は HTF バー切り替わり直後にもう 1 本ぶん古い値を返しうるので、
//       ヒストリカルとリアルタイムで判定がずれる。lookahead_on + [1] はどちらでも
//       「最後に確定した HTF バー」で一致する。
//   ・Zone 側の外部 TF 取得は従来どおり lookahead_off (式に [1] を掛けていないため)。
//   ・過去バーの Entry 位置が後から変わる実装は入れていない。
//
//  ■ 30秒 / 1分の SAT 計算について (重要)
//   15秒足で計算したラインを流用していない。f_satPanel() を
//   request.security() の「中」で評価しているため、STB / LINE1 / LINE2 /
//   背景のすべてが、その時間足自身の OHLC から独立に再計算される。
//   30秒・1分はラインを描画しないので、必要な「背景 State」だけを
//   それぞれ 1 回の request.security() で取得している (SAT 側の追加 request は 2 本のみ)。
// ============================================================================

//@version=5
strategy(
     title             = "SAT MTF Background Strategy (15s/30s/1m)",
     shorttitle        = "SAT-MTF",
     overlay           = true,
     pyramiding        = 100,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     process_orders_on_close = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ★★★ Library import ★★★
//  ZONE モードで使う。ZoneEngine の Zone 生成ロジックは変更しない。
import sekine3310/ZoneEngine/10 as zn

// Library 内の定数と同じ値 (定数 export は Pine のバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// 背景 State
int BG_BLUE = 1
int BG_FLAT = 0
int BG_RED  = -1

// Entry State Machine
//   LONG  : 0 WAIT_INITIAL / 1 ARMED(青を見た) / 2 SAW_FLAT / 3 SAW_RED
//   SHORT : 0 WAIT_INITIAL / 1 ARMED(赤を見た) / 2 SAW_FLAT / 3 SAW_BLUE
int ST_WAIT  = 0
int ST_ARMED = 1
int ST_FLAT  = 2
int ST_OPP   = 3

string LOGIC_ID = "SAT"

// ============================================================================
// 01. ALL INPUTS
// ============================================================================

// ---- 01-1 SAT PANEL : STB (正式 = Donchian) -------------------------------
var string G_STB = "01 · SAT · STB (Donchian)"
stbDcDisplayLen = input.int(10, "STB Donchian 表示期間", minval = 1, maxval = 500, group = G_STB,
     tooltip = "表示するバンドの本数。UP は この期間の安値 (ta.lowest)、DOWN は この期間の高値 (ta.highest) を表示価格にする。\n方向転換の判定には使わない。")
stbDcStateLen   = input.int(20, "STB Donchian 転換期間", minval = 1, maxval = 500, group = G_STB,
     tooltip = "方向転換の判定に使う本数。表示期間とは独立。\n当該足を含める前のレンジ ta.highest(high, 転換期間)[1] / ta.lowest(low, 転換期間)[1] を基準にする。\n判定は high / low のヒゲで行い、close は使わない。")

// ---- 01-1 SAT PANEL : LINE1 -----------------------------------------------
var string G_L1 = "01 · SAT · LINE1"
l1SrcType   = input.string("close", "LINE1 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L1)
l1EmaLen    = input.int(1,   "LINE1 EMA期間",  minval = 1, maxval = 500, group = G_L1)
l1AtrLen    = input.int(58,  "LINE1 ATR期間",  minval = 1, maxval = 500, group = G_L1)
l1DpMult    = input.float(3.0, "LINE1 表示ATR倍率", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1)
l1Smooth    = input.bool(true, "LINE1 表示バンド平滑化", group = G_L1)
l1SmoothLen = input.int(24,  "LINE1 平滑化期間", minval = 1, maxval = 200, group = G_L1)

var string G_L1S = "01 · SAT · LINE1 専用転換Band (価格State)"
l1StateSrcType     = input.string("close", "LINE1 専用転換ソース", options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L1S)
l1StateUpEmaLen    = input.int(55,  "DOWN→UP 転換EMA期間", minval = 1, maxval = 500, group = G_L1S)
l1StateUpAtrLen    = input.int(10,  "DOWN→UP 転換ATR期間", minval = 1, maxval = 500, group = G_L1S)
l1StateUpMult      = input.float(4.0,  "DOWN→UP 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L1S)
l1StateUpSmooth    = input.bool(true,  "DOWN→UP 転換Band平滑化", group = G_L1S)
l1StateUpSmoothLen = input.int(30,  "DOWN→UP 転換平滑化期間", minval = 1, maxval = 200, group = G_L1S)
l1StateUpConfirm   = input.int(3,   "DOWN→UP 確認本数", minval = 1, maxval = 10, group = G_L1S)
l1StateDnEmaLen    = input.int(34,  "UP→DOWN 転換EMA期間", minval = 1, maxval = 500, group = G_L1S)
l1StateDnAtrLen    = input.int(58,  "UP→DOWN 転換ATR期間", minval = 1, maxval = 500, group = G_L1S)
l1StateDnMult      = input.float(3.75, "UP→DOWN 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L1S)
l1StateDnSmooth    = input.bool(true,  "UP→DOWN 転換Band平滑化", group = G_L1S)
l1StateDnSmoothLen = input.int(20,  "UP→DOWN 転換平滑化期間", minval = 1, maxval = 200, group = G_L1S)
l1StateDnConfirm   = input.int(4,   "UP→DOWN 確認本数", minval = 1, maxval = 10, group = G_L1S)

// ---- 01-1 SAT PANEL : LINE2 -----------------------------------------------
//  元ファイルの標準初期値 = CSV検証プリセット「ST表示候補」相当:
//    close → EMA2 → ATR30 → ATR を EMA40 で平滑化 → ×1.675 → 上下バンドを EMA9 で平滑化
var string G_L2 = "01 · SAT · LINE2"
l2SrcType      = input.string("close", "LINE2 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2)
l2EmaLen       = input.int(2,   "LINE2 EMA期間", minval = 1, maxval = 500, group = G_L2)
l2AtrLen       = input.int(30,  "LINE2 ATR期間", minval = 1, maxval = 500, group = G_L2)
l2DpMult       = input.float(1.675, "LINE2 表示ATR倍率", minval = 0.1, maxval = 20.0, step = 0.001, group = G_L2)
l2AtrSmooth    = input.bool(true, "LINE2 表示用ATR平滑化", group = G_L2)
l2AtrSmoothLen = input.int(40,  "LINE2 表示用ATR平滑化期間", minval = 1, maxval = 200, group = G_L2)
l2Smooth       = input.bool(true, "LINE2 表示バンド平滑化", group = G_L2)
l2SmoothLen    = input.int(9,   "LINE2 平滑化期間", minval = 1, maxval = 200, group = G_L2)

var string G_L2S = "01 · SAT · LINE2 非対称ST (価格State)"
l2PsAsymSrcType = input.string("close", "非対称ST ソース", options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2S)
l2PsAsymAtrLen  = input.int(43,   "非対称ST ATR期間", minval = 1, maxval = 500, group = G_L2S)
l2PsAsymUpFac   = input.float(4.83, "非対称ST 上昇Factor (DOWN→UP)", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2S)
l2PsAsymDnFac   = input.float(4.71, "非対称ST 下降Factor (通常)",    minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2S)
l2PsAsymDnFacHV = input.float(4.49, "非対称ST 下降Factor (高ボラ)",  minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2S)
l2PsAsymVolTh   = input.float(0.0018, "非対称ST 高ボラしきい値 (ATR/close)", minval = 0.0, maxval = 1.0, step = 0.0001, group = G_L2S)
l2PsAsymFilter  = input.int(2,    "非対称ST 確認本数", minval = 1, maxval = 10, group = G_L2S)

// ---- 01-1 SAT PANEL : 背景 / EMA ------------------------------------------
var string G_BG = "01 · SAT · 背景"
bgSrcMode = input.string("close", "背景判定ソース",
     options = ["close", "high/low", "ローソク足全体"], group = G_BG,
     tooltip = "「価格が3本すべてを突破」方式の判定ソース。\nclose (既定) : 終値が 3 本すべてより上／下\nhigh/low : 高値が 3 本すべてより上 (青) ／ 安値が 3 本すべてより下 (赤)\nローソク足全体 : 安値が 3 本すべてより上 (青) ／ 高値が 3 本すべてより下 (赤)\n★ 15s / 30s / 1m すべて同じ設定で判定する。")
useConfirmed = input.bool(true, "確定足のみで判定 (リペイント防止)", group = G_BG,
     tooltip = "ON : 15秒足が確定したタイミングでのみ方向 State を更新する。\n30秒 / 1分は常に確定 HTF バーのみを参照する (この設定に関係なく固定)。")
bgBuyCol  = input.color(color.rgb(38, 198, 218), "青 (Buy) 背景色",  group = G_BG)
bgSellCol = input.color(color.rgb(255, 82, 82),  "赤 (Sell) 背景色", group = G_BG)
bgTransp  = input.int(85, "背景の透明度", minval = 0, maxval = 100, group = G_BG)

var string G_MA = "01 · SAT · 移動平均線"
showMa    = input.bool(true, "移動平均線を表示", group = G_MA)
maType    = input.string("EMA", "MA 種別", options = ["EMA", "SMA", "RMA", "WMA"], group = G_MA)
maLen     = input.int(200, "MA 期間", minval = 1, maxval = 1000, group = G_MA)
maSrcType = input.string("close", "MA ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_MA)
maWidth   = input.int(2, "MA 線幅", minval = 1, maxval = 5, group = G_MA)
maUpCol   = input.color(color.rgb(38, 198, 218),  "MA 上昇色", group = G_MA)
maDnCol   = input.color(color.rgb(255, 82, 82),   "MA 下降色", group = G_MA)
maFlatCol = input.color(color.rgb(149, 152, 161), "MA 中立色", group = G_MA)

var string G_LINEDISP = "01 · SAT · ライン表示"
showStb = input.bool(true, "STB ラインを表示", group = G_LINEDISP)
showL1  = input.bool(true, "LINE1 を表示",     group = G_LINEDISP)
showL2  = input.bool(true, "LINE2 を表示",     group = G_LINEDISP)
stbWidth = input.int(2, "STB 線幅",   minval = 1, maxval = 5, group = G_LINEDISP)
l1Width  = input.int(2, "LINE1 線幅", minval = 1, maxval = 5, group = G_LINEDISP)
l2Width  = input.int(2, "LINE2 線幅", minval = 1, maxval = 5, group = G_LINEDISP)
satUpCol = input.color(color.rgb(38, 198, 218), "上昇色 (共通)", group = G_LINEDISP)
satDnCol = input.color(color.rgb(255, 82, 82),  "下降色 (共通)", group = G_LINEDISP)

// ---- 01-2 MTF / Entry ------------------------------------------------------
var string G_MTF = "02 · MTF · 時間足"
satTf30 = input.timeframe("30S", "30秒足 の時間足指定", group = G_MTF,
     tooltip = "この時間足のコンテキスト内で STB / LINE1 / LINE2 / 背景 をすべて再計算する。\n15秒足のラインを流用しない。")
satTf1m = input.timeframe("1",   "1分足 の時間足指定",  group = G_MTF,
     tooltip = "この時間足のコンテキスト内で STB / LINE1 / LINE2 / 背景 をすべて再計算する。")

var string G_DIR = "02 · MTF · Direction"
enableLong  = input.bool(true, "Enable Long",  group = G_DIR)
enableShort = input.bool(true, "Enable Short", group = G_DIR)

// ---- 01-3 SL / TP ----------------------------------------------------------
var string G_SLTPM = "03 · SLTP Mode"
sltpMode = input.string("FIXED", "SLTP Mode", options = ["ZONE", "FIXED"], group = G_SLTPM,
     tooltip = "Entry ロジックはこの設定で一切変わらない。同じ SAT Entry Signal を使い、SL/TP の決め方だけを切り替える。\nZONE  : ZoneEngine の Structural SL / TP (TradePlan)\nFIXED : 固定ドル幅")
fixedSlDollar = input.float(15.0, "Fixed SL ($)", minval = 0.01, step = 0.1, group = G_SLTPM)
fixedTpDollar = input.float(20.0, "Fixed TP ($)", minval = 0.01, step = 0.1, group = G_SLTPM)

bool useZoneSltp = sltpMode == "ZONE"

// ---- 01-4 Zone Engine ------------------------------------------------------
//  ZONE モードのときだけ使う。Zone 生成ロジックは ZoneEngine のまま変更しない。
var string G_ZBASE = "04 · Zone · Base TF"
zoneBaseTf = input.timeframe("5", "Zone Base TF", group = G_ZBASE,
     tooltip = "Zone を生成 / 更新する基準時間足。元 Zone Strategy と同じ 5分が初期値。\n" +
     "★ SAT Entry は15秒足のまま。ここで変わるのは Zone 側だけ。\n" +
     "この時間足が 1 本確定するたびに ZoneEngine を 1 回だけ更新する。\n" +
     "Day High/Low / Reaction / Natural State / MA alignment / trackStaleBars /\n" +
     "createdBar / breakBar / lastSeenBar / Zone 寿命の time はすべてこの時間足基準になる。\n" +
     "Break 判定もこの時間足の確定終値で行う。")

var string G_ZONE = "04 · Zone Geometry"
zoneHalfWidth = input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE)

var string G_ZMA = "04 · Zone · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_ZMA)
zMaType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_ZMA)
useMaSource = input.bool(true, "Enable MA Source", group = G_ZMA)
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_ZMA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_ZMA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_ZMA)
scoreMa1 = input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_ZMA)
scoreMa2 = input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_ZMA)

var string G_ZSLOPE = "04 · Zone · MA Slope"
slopeThrMod       = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_ZSLOPE)
slopeThrStrong    = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_ZSLOPE)
slopeBonusFlat    = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_ZSLOPE)
slopeBonusMod     = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_ZSLOPE)
slopeBonusStr     = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_ZSLOPE)
slopeBonusMode    = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster", options = ["Sum (per MA)", "Max"], group = G_ZSLOPE)
maClusterDist     = input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_ZSLOPE)
maClusterBonus    = input.float(1.0,  "MA Cluster Bonus",        step = 0.5, group = G_ZSLOPE)
maClusterDirBonus = input.float(1.0,  "MA Cluster Bonus · Same Slope", step = 0.5, group = G_ZSLOPE)

var string G_ZHZ = "04 · Zone · Horizontal Source (Swing)"
useHzSource = input.bool(true, "Enable Horizontal Source", group = G_ZHZ)
hzTf1 = input.timeframe("5",  "Horizontal TF #1", group = G_ZHZ)
hzTf2 = input.timeframe("15", "Horizontal TF #2", group = G_ZHZ)
hzTf3 = input.timeframe("60", "Horizontal TF #3", group = G_ZHZ)
pivLen1 = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_ZHZ)
pivLen2 = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_ZHZ)

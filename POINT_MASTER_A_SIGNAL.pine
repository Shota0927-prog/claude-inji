//@version=5
// =====================================================================================
// POINT MASTER A Signal  ―  実運用用 Aランクシグナル（LONG A / SHORT A）
// =====================================================================================
// POINT MASTER 本体（POINT_MASTER_FVG_ABS_REBOUND.pine）、Confidence Signal、
// 90% Strategy とは完全に別のファイルです。どれも変更していません。
// 本体が plot している LONG SCORE / SHORT SCORE / NET SCORE を input.source() で受け取り、
// 検証で採用した「Aランク条件」を満たした瞬間だけ、ラベル・シグナル・アラートを出します。
//
// 【Aランク条件（初期値）】
//   LONG A  : NET SCORE >= +20 かつ SHORT SCORE <= 3
//   SHORT A : NET SCORE <= -20 かつ LONG SCORE  <= 3
//   ・5分足の確定足のみで判定（非リペイント）
//   ・条件が「新しく成立した瞬間」だけ1回発火（成立が続いている間は再発火しません）
//   ・LONG A 継続中に一気に SHORT A 条件まで反転した場合は、その足で SHORT A を新規発火
//   ・方向一致率フィルターは使いません（今回のAランク条件では不要）
//
// 【推奨リスク（シグナル条件ではありません・表示用）】
//   SL = $15 / RR = 1:2 → TP = $30
//     LONG  : SL = Entry - 15 / TP = Entry + 30
//     SHORT : SL = Entry + 15 / TP = Entry - 30
//
// 【使い方】
//   1. チャート（5分足）へ POINT MASTER 本体を追加する
//   2. チャートへ このインジケーターを追加する
//   3. 設定 → ① 接続元 で
//        PM-FVG2: LONG SCORE / PM-FVG2: SHORT SCORE / PM-FVG2: NET SCORE
//      をそれぞれ選択して接続する
//   4. アラートは「POINT MASTER LONG A」「POINT MASTER SHORT A」、
//      または「Any alert() function call」を選ぶ
//
// ★ 5分足チャート専用です。5分足以外ではシグナル・ラベル・アラートを出さず、警告を表示します。
// =====================================================================================
indicator(
     title            = "POINT MASTER A Signal",
     shorttitle       = "PM-A",
     overlay          = true,
     max_labels_count = 500
 )

// =====================================================================================
// §0. 入力
// =====================================================================================
grpSrc = "① 接続元"
longScoreSource  = input.source(close, "POINT MASTER LONG SCORE",  group = grpSrc,
     tooltip = "POINT MASTER 本体の LONG SCORE を選択してください（PM-FVG2: LONG SCORE）。")
shortScoreSource = input.source(close, "POINT MASTER SHORT SCORE", group = grpSrc,
     tooltip = "POINT MASTER 本体の SHORT SCORE を選択してください（PM-FVG2: SHORT SCORE）。")
netSource        = input.source(close, "POINT MASTER NET SCORE",   group = grpSrc,
     tooltip = "POINT MASTER 本体の NET SCORE を選択してください（NET SCORE = LONG SCORE - SHORT SCORE）。")
useConfirmedOnly = input.bool(true, "確定足だけで判定する (非リペイント)", group = grpSrc)

grpCond = "② Aランク条件"
netThreshold = input.float(20.0, "NET SCORE しきい値 (±)", group = grpCond, step = 0.1, minval = 0)
oppScoreMax  = input.float(3.0,  "反対方向スコア上限",      group = grpCond, step = 0.1, minval = 0,
     tooltip = "LONG なら SHORT SCORE、SHORT なら LONG SCORE がこの値以下であることを要求します。")

grpDir = "③ 使用する方向"
useLong  = input.bool(true, "LONG A シグナルを使う",  group = grpDir)
useShort = input.bool(true, "SHORT A シグナルを使う", group = grpDir)

grpRisk = "④ 推奨SL / TP（表示用・条件ではありません）"
slFixed = input.float(15.0, "固定SL幅 ($)", group = grpRisk, step = 0.5, minval = 0.1)
rrRatio = input.float(2.0,  "RR (TP = SL幅 × RR)", group = grpRisk, step = 0.1, minval = 0.1)

grpView = "⑤ 表示"
showLabels      = input.bool(true, "シグナルラベルを表示", group = grpView)
showLabelDetail = input.bool(true, "ラベルに NET / OPP / SL / TP を表示", group = grpView)
showTable       = input.bool(true, "現在状態テーブルを表示", group = grpView)
labelSizeStr = input.string(size.normal, "ラベルサイズ",
     options = [size.tiny, size.small, size.normal, size.large], group = grpView)
tblSize      = input.string(size.small, "テーブル文字サイズ",
     options = [size.tiny, size.small, size.normal, size.large], group = grpView)
colLongC  = input.color(color.new(#00e676, 0),  "LONG 色",  group = grpView)
colShortC = input.color(color.new(#ff5297, 0),  "SHORT 色", group = grpView)
colTblBg  = input.color(color.new(#1e222d, 20), "背景色",   group = grpView)
colTblTxt = input.color(color.new(#d1d4dc, 0),  "文字色",   group = grpView)

// =====================================================================================
// §1. スコアとAランク条件
// =====================================================================================
float lScore = nz(longScoreSource)
float sScore = nz(shortScoreSource)
float netVal = nz(netSource)

// LONG A : NET >= +しきい値 かつ 反対方向（SHORT SCORE）が上限以下
// SHORT A: NET <= -しきい値 かつ 反対方向（LONG SCORE）が上限以下
// ※ 方向一致率（AGREEMENT）は今回のAランク条件では使いません。
bool longCondRaw  = netVal >=  netThreshold and sScore <= oppScoreMax
bool shortCondRaw = netVal <= -netThreshold and lScore <= oppScoreMax

// =====================================================================================
// §2. 5分足チャート判定
// =====================================================================================
// このインジケーターは5分足チャート専用です（POINT MASTER 本体が5分足運用のため）。
bool is5m = timeframe.isminutes and timeframe.multiplier == 5

// =====================================================================================
// §3. シグナル（確定足 + 新規成立の瞬間だけ）
// =====================================================================================
// ・確定足でのみ状態を進めるため、形成中に一時的に条件を満たしても確定時に外れていれば
//   シグナルは残りません（非リペイント）。
// ・longActive / shortActive に「前回の確定足で条件が成立していたか」を保持し、
//   false → true になった確定足だけ発火します（成立が続く間は再発火しません）。
// ・LONG A 成立中に一気に SHORT A 条件まで反転した場合、shortActive は false のため
//   その足で SHORT A が新規シグナルとして発火します。
bool evalNow = not useConfirmedOnly or barstate.isconfirmed
var bool longActive  = false
var bool shortActive = false
bool longSignal  = false
bool shortSignal = false
if evalNow
    bool _lc = longCondRaw
    bool _sc = shortCondRaw
    longSignal  := _lc and not longActive
    shortSignal := _sc and not shortActive
    longActive  := _lc
    shortActive := _sc

// 実際に表示・通知するシグナル（5分足チャート かつ 方向ON のときだけ）
bool longASignal  = longSignal  and useLong  and is5m
bool shortASignal = shortSignal and useShort and is5m

// =====================================================================================
// §4. 推奨SL / TP（シグナル足の終値基準）
// =====================================================================================
// シグナル成立の条件ではありません。発生後の推奨値としてラベル / アラートに載せるだけです。
float entryEst  = close
float longStop  = entryEst - slFixed
float longTP    = entryEst + slFixed * rrRatio
float shortStop = entryEst + slFixed
float shortTP   = entryEst - slFixed * rrRatio

// =====================================================================================
// §5. ラベル
// =====================================================================================
// LONG A : ローソク足のすぐ下 / SHORT A : ローソク足のすぐ上
f_sigText(_isLong) =>
    string _base = _isLong ? "LONG A" : "SHORT A"
    string _det = "\nNET " + (netVal > 0 ? "+" : "") + str.tostring(netVal, "0.0") +
                 "  OPP " + str.tostring(_isLong ? sScore : lScore, "0.0") +
                 "\nSL " + str.tostring(_isLong ? longStop : shortStop, "0.00") +
                 "  TP " + str.tostring(_isLong ? longTP : shortTP, "0.00")
    showLabelDetail ? _base + _det : _base

if showLabels and longASignal
    label.new(bar_index, na, f_sigText(true), yloc = yloc.belowbar, style = label.style_label_up,
         color = colLongC, textcolor = color.new(#000000, 0), size = labelSizeStr)
if showLabels and shortASignal
    label.new(bar_index, na, f_sigText(false), yloc = yloc.abovebar, style = label.style_label_down,
         color = colShortC, textcolor = color.new(#000000, 0), size = labelSizeStr)

// =====================================================================================
// §6. データウィンドウ出力
// =====================================================================================
plot(lScore,  "LONG SCORE",     display = display.data_window)
plot(sScore,  "SHORT SCORE",    display = display.data_window)
plot(netVal,  "NET SCORE",      display = display.data_window)
plot(longASignal  ? 1 : 0, "LONG A SIGNAL",  display = display.data_window)
plot(shortASignal ? 1 : 0, "SHORT A SIGNAL", display = display.data_window)

// =====================================================================================
// §7. アラート
// =====================================================================================
// alert() のみを使用します（alertcondition() は使いません）。
// 実際の数値（NET / 反対スコア / Entry / SL / TP）入りのメッセージを送ります。
// TradingView のアラート作成画面では「Any alert() function call」を選んでください。
if longASignal
    alert("POINT MASTER LONG A" +
         "  NET=" + str.tostring(netVal, "0.00") +
         "  OPP(SHORT SCORE)=" + str.tostring(sScore, "0.00") +
         "  Entry=" + str.tostring(entryEst, "0.00") +
         "  SL=" + str.tostring(longStop, "0.00") +
         "  TP=" + str.tostring(longTP, "0.00"), alert.freq_once_per_bar_close)
if shortASignal
    alert("POINT MASTER SHORT A" +
         "  NET=" + str.tostring(netVal, "0.00") +
         "  OPP(LONG SCORE)=" + str.tostring(lScore, "0.00") +
         "  Entry=" + str.tostring(entryEst, "0.00") +
         "  SL=" + str.tostring(shortStop, "0.00") +
         "  TP=" + str.tostring(shortTP, "0.00"), alert.freq_once_per_bar_close)

// =====================================================================================
// §8. 現在状態テーブル
// =====================================================================================
// STATUS : 現在 LONG A 条件成立中 / SHORT A 条件成立中 / どちらでもない（WAIT）
string statusTxt = longCondRaw ? "LONG A" : shortCondRaw ? "SHORT A" : "WAIT"
color  statusCol = longCondRaw ? colLongC : shortCondRaw ? colShortC : colTblTxt

var table statTbl = table.new(position.top_right, 2, 5, border_width = 1)
if showTable and barstate.islast
    table.cell(statTbl, 0, 0, "POINT MASTER A", text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 1, 0, is5m ? "5M" : timeframe.period,
         text_color = is5m ? colTblTxt : color.new(#ffffff, 0),
         bgcolor = is5m ? colTblBg : color.new(#b71c1c, 0), text_size = tblSize)
    table.cell(statTbl, 0, 1, "LONG SCORE",  text_color = colLongC,  bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 1, 1, str.tostring(lScore, "0.00"), text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 0, 2, "SHORT SCORE", text_color = colShortC, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 1, 2, str.tostring(sScore, "0.00"), text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 0, 3, "NET SCORE",   text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 1, 3, (netVal > 0 ? "+" : "") + str.tostring(netVal, "0.00"),
         text_color = netVal > 0 ? colLongC : netVal < 0 ? colShortC : colTblTxt,
         bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 0, 4, "STATUS", text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(statTbl, 1, 4, statusTxt, text_color = statusCol, bgcolor = colTblBg, text_size = tblSize)

// ---- 5分足以外の警告（左下） ------------------------------------------------------
var warnTbl = table.new(position.bottom_left, 1, 2, border_width = 1)
if not is5m and barstate.islast
    table.cell(warnTbl, 0, 0, "⚠ POINT MASTER A Signal は5分足チャート専用です",
         text_color = color.new(#ffffff, 0), bgcolor = color.new(#b71c1c, 0), text_size = tblSize)
    table.cell(warnTbl, 0, 1, "現在: " + timeframe.period + " → シグナル / アラートは出しません",
         text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)

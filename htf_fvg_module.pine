// ============================================================
//  HTF FVG 環境認識モジュール (Indicator版)
// ============================================================
//  ・週足 / 日足 / 4H / 1H の FVG を「環境認識」として返す。
//  ・このモジュール単体ではエントリーしない (シグナルのみ)。
//  ・後で フィボ / FVG反発 / FVG吸収 / EMA / 出来高 などの
//    モジュールと AND 条件で接続する前提。
//  ・各時間足は request.security() + lookahead_off で取得。
//  ・関数化してあり、時間足を簡単に追加できる構造。
// ============================================================

//@version=5
indicator(
     title          = "HTF FVG Environment",
     shorttitle     = "HTF-FVG",
     overlay        = true,
     max_bars_back  = 500
 )

// ============================================================
//  対象時間足 ON/OFF
// ============================================================
grpTF = "対象時間足"
useWeeklyFVG = input.bool(true,  "Weekly FVG を使う", group = grpTF)
useDailyFVG  = input.bool(true,  "Daily FVG を使う",  group = grpTF)
use4HFVG     = input.bool(true,  "4H FVG を使う",     group = grpTF)
use1HFVG     = input.bool(true,  "1H FVG を使う",     group = grpTF)

tfWeekly = input.timeframe("W",   "Weekly TF", group = grpTF)
tfDaily  = input.timeframe("D",   "Daily TF",  group = grpTF)
tf4H     = input.timeframe("240", "4H TF",     group = grpTF)
tf1H     = input.timeframe("60",  "1H TF",     group = grpTF)

// ============================================================
//  モード ON/OFF
// ============================================================
grpMode = "モード"
useRangeMode = input.bool(true, "レンジ(FVG内)モードを使う", group = grpMode)
useBreakMode = input.bool(true, "ブレイクモードを使う",       group = grpMode)
useNearMode  = input.bool(true, "近接モードを使う",           group = grpMode)

// ============================================================
//  パラメータ
// ============================================================
grpParam = "パラメータ"
atrLen           = input.int(14,  "ATR期間",                minval = 1,   group = grpParam)
upperThreshold   = input.float(0.8, "上限付近 しきい値",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)
lowerThreshold   = input.float(0.2, "下限付近 しきい値",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)
nearATR          = input.float(0.5, "近接判定 (ATR倍率)",    minval = 0.0, step = 0.05, group = grpParam)
breakLookbackBars= input.int(20,  "ブレイク後 戻り許容(本)", minval = 1,   group = grpParam)
htfFVGMaxCount   = input.int(5,   "各時間足 保持FVG数(片側)", minval = 1,   group = grpParam)

// ============================================================
//  厚みフィルター
// ============================================================
grpThick = "厚みフィルター"
useHTFThicknessFilter = input.bool(true,  "厚みフィルターを使う", group = grpThick)
useThicknessATR       = input.bool(true,  "ATR倍率で判定",        group = grpThick)
useThicknessPct       = input.bool(false, "close比率で判定",      group = grpThick)
fvgMinThicknessATR    = input.float(0.30,  "最低厚み (ATR倍率)",   minval = 0.0, step = 0.05,  group = grpThick)
fvgMinThicknessPct    = input.float(0.0010,"最低厚み (close比率)", minval = 0.0, step = 0.0005, group = grpThick)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showHTFTable = input.bool(true, "環境テーブルを表示", group = grpDisp)

colInside   = input.color(color.new(color.blue,  0), "Inside 色",   group = grpDisp)
colBreakUp  = input.color(color.new(color.green, 0), "BreakUp 色",  group = grpDisp)
colBreakDn  = input.color(color.new(color.red,   0), "BreakDown 色",group = grpDisp)
colOutside  = input.color(color.new(color.gray,  0), "Outside 色",  group = grpDisp)

// ============================================================
//  厚み条件 (HTF / Chart 共通で利用)
// ============================================================
f_thickOK(width, atrVal, px) =>
    bool ok = true
    if useHTFThicknessFilter
        bool a = not useThicknessATR or (width >= atrVal * fvgMinThicknessATR)
        bool p = not useThicknessPct or (px != 0 and (width / px) >= fvgMinThicknessPct)
        ok := a and p
    ok

// ============================================================
//  HTF 状態取得 (request.security の中で各時間足の文脈で評価される)
//  ・直近 htfFVGMaxCount 個の Bullish / Bearish FVG を配列で保持。
//  ・現在価格(HTF close)を含む or 最も近い FVG をアクティブとして採用。
//    優先: 1) 内包する 2) 最も近い。
//  ・アクティブFVGに対して mode / zonePosition / break / near を計算し
//    スカラーで返す (request.security は配列を返せないため)。
//  返り値 (19):
//   mode, zonePos, isInside, isOutside, nearUpper, nearLower,
//   rangeBuy, rangeSell, breakDown, breakUp, waitSell, waitBuy,
//   nearBull, nearBear, activeTop, activeBot, activeDist, fvgCount, atrVal
//  ※ 各TFのON/OFFはチャート側 f_mask() でマスクする。
// ============================================================
f_htfState() =>
    var array<float> bTopA = array.new_float()
    var array<float> bBotA = array.new_float()
    var array<int>   bBarA = array.new_int()
    var array<bool>  bUsedA = array.new_bool()   // 一度iFVG化(ブレイク)したら true → 以後使わない
    var array<float> sTopA = array.new_float()
    var array<float> sBotA = array.new_float()
    var array<int>   sBarA = array.new_int()
    var array<bool>  sUsedA = array.new_bool()
    var int   lastBullBreakBar = na
    var float lastBullBreakBot = na
    var int   lastBearBreakBar = na
    var float lastBearBreakTop = na

    float atrVal = ta.atr(atrLen)
    float px     = close

    // --- 新規 FVG 検出 → 配列に push (直近 htfFVGMaxCount 個を保持) ---
    // Bullish: low > high[2]
    if low > high[2]
        float w = low - high[2]
        if w > 0 and f_thickOK(w, atrVal, px)
            array.push(bTopA, low)
            array.push(bBotA, high[2])
            array.push(bBarA, bar_index)
            array.push(bUsedA, false)
            if array.size(bTopA) > htfFVGMaxCount
                array.shift(bTopA)
                array.shift(bBotA)
                array.shift(bBarA)
                array.shift(bUsedA)
    // Bearish: high < low[2]
    if high < low[2]
        float w = low[2] - high
        if w > 0 and f_thickOK(w, atrVal, px)
            array.push(sTopA, low[2])
            array.push(sBotA, high)
            array.push(sBarA, bar_index)
            array.push(sUsedA, false)
            if array.size(sTopA) > htfFVGMaxCount
                array.shift(sTopA)
                array.shift(sBotA)
                array.shift(sBarA)
                array.shift(sUsedA)

    int cntBull = array.size(bTopA)
    int cntBear = array.size(sTopA)

    // --- アクティブ FVG 選択 (1:内包優先 / 2:最も近い) ---
    // ※ 一度iFVG化(ブレイク)した used=true のFVGは選択対象から除外。
    float bestTop    = na
    float bestBot    = na
    bool  bestInside = false
    bool  bestIsBull = false
    float bestMetric = na   // inside:中心距離 / outside:端距離
    int   bestIdx    = na   // アクティブFVGの配列index (ブレイク時に used 化するため)

    if cntBull > 0
        for i = 0 to cntBull - 1
            if not array.get(bUsedA, i)
                float t = array.get(bTopA, i)
                float b = array.get(bBotA, i)
                bool  ins = px <= t and px >= b
                float metric = ins ? math.abs(px - (t + b) / 2) : (px > t ? px - t : b - px)
                bool better = na(bestMetric) ? true : (ins and not bestInside) ? true : (ins == bestInside and metric < bestMetric)
                if better
                    bestTop := t
                    bestBot := b
                    bestInside := ins
                    bestIsBull := true
                    bestMetric := metric
                    bestIdx := i
    if cntBear > 0
        for i = 0 to cntBear - 1
            if not array.get(sUsedA, i)
                float t = array.get(sTopA, i)
                float b = array.get(sBotA, i)
                bool  ins = px <= t and px >= b
                float metric = ins ? math.abs(px - (t + b) / 2) : (px > t ? px - t : b - px)
                bool better = na(bestMetric) ? true : (ins and not bestInside) ? true : (ins == bestInside and metric < bestMetric)
                if better
                    bestTop := t
                    bestBot := b
                    bestInside := ins
                    bestIsBull := false
                    bestMetric := metric
                    bestIdx := i

    bool hasFVG = not na(bestTop)

    // --- ブレイク検出 (アクティブFVG / HTF終値ベース) ---
    bool bd = hasFVG and bestIsBull and px < bestBot       // Bullish FVG 下抜け
    bool bu = hasFVG and not bestIsBull and px > bestTop   // Bearish FVG 上抜け
    if bd
        lastBullBreakBar := bar_index
        lastBullBreakBot := bestBot
        if not na(bestIdx)
            array.set(bUsedA, bestIdx, true)   // iFVG化 → 以後このFVGは使わない
    if bu
        lastBearBreakBar := bar_index
        lastBearBreakTop := bestTop
        if not na(bestIdx)
            array.set(sUsedA, bestIdx, true)

    // --- ブレイク後の戻り → iFVG候補 ---
    bool waitSell = useBreakMode and not na(lastBullBreakBar) and (bar_index - lastBullBreakBar) <= breakLookbackBars and not na(lastBullBreakBot) and px >= lastBullBreakBot
    bool waitBuy  = useBreakMode and not na(lastBearBreakBar) and (bar_index - lastBearBreakBar) <= breakLookbackBars and not na(lastBearBreakTop) and px <= lastBearBreakTop

    // --- Inside / zonePosition ---
    bool  isInside = bestInside
    float zonePos  = (isInside and (bestTop - bestBot) > 0) ? (px - bestBot) / (bestTop - bestBot) : na
    bool  nearUpper = isInside and not na(zonePos) and zonePos >= upperThreshold
    bool  nearLower = isInside and not na(zonePos) and zonePos <= lowerThreshold

    bool rangeSell = useRangeMode and nearUpper
    bool rangeBuy  = useRangeMode and nearLower

    bool breakDown = useBreakMode and bd
    bool breakUp   = useBreakMode and bu

    bool isOutside = hasFVG and not isInside

    // --- 近接 (最も近い Bull/Bear FVG までの距離) ---
    float nearBullDist = na
    if cntBull > 0
        for i = 0 to cntBull - 1
            if not array.get(bUsedA, i)
                float t = array.get(bTopA, i)
                float b = array.get(bBotA, i)
                float d = px > t ? px - t : px < b ? b - px : 0.0
                nearBullDist := na(nearBullDist) ? d : math.min(nearBullDist, d)
    float nearBearDist = na
    if cntBear > 0
        for i = 0 to cntBear - 1
            if not array.get(sUsedA, i)
                float t = array.get(sTopA, i)
                float b = array.get(sBotA, i)
                float d = px > t ? px - t : px < b ? b - px : 0.0
                nearBearDist := na(nearBearDist) ? d : math.min(nearBearDist, d)
    bool nearBull = useNearMode and not na(nearBullDist) and nearBullDist <= atrVal * nearATR
    bool nearBear = useNearMode and not na(nearBearDist) and nearBearDist <= atrVal * nearATR

    // mode : 0なし / 1内 / 2上抜け / 3下抜け / 4外
    int mode = breakDown ? 3 : breakUp ? 2 : isInside ? 1 : (hasFVG and isOutside ? 4 : 0)

    [mode, zonePos, isInside, isOutside, nearUpper, nearLower, rangeBuy, rangeSell, breakDown, breakUp, waitSell, waitBuy, nearBull, nearBear, bestTop, bestBot, bestMetric, cntBull + cntBear, atrVal]

// ============================================================
//  各TFのON/OFFマスク (チャート側)
// ============================================================
f_mask(on, mode, zp, isIn, isOut, nu, nl, rb, rs, bdn, bup, ws, wb, nbull, nbear, atop, abot, adist, cnt, atrv) =>
    [on ? mode : 0, on ? zp : na, on and isIn, on and isOut, on and nu, on and nl, on and rb, on and rs, on and bdn, on and bup, on and ws, on and wb, on and nbull, on and nbear, on ? atop : na, on ? abot : na, on ? adist : na, on ? cnt : 0, on ? atrv : na]

// ============================================================
//  各時間足の HTF 状態を取得 → ON/OFF マスク
// ============================================================
[w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18] = request.security(syminfo.tickerid, tfWeekly, f_htfState(), lookahead = barmerge.lookahead_off)
[d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18] = request.security(syminfo.tickerid, tfDaily,  f_htfState(), lookahead = barmerge.lookahead_off)
[f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18] = request.security(syminfo.tickerid, tf4H,     f_htfState(), lookahead = barmerge.lookahead_off)
[o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, o10, o11, o12, o13, o14, o15, o16, o17, o18] = request.security(syminfo.tickerid, tf1H,     f_htfState(), lookahead = barmerge.lookahead_off)

[weeklyMode, weeklyZonePosition, wInside, wOutside, weeklyNearUpper, weeklyNearLower, weeklyRangeBuy, weeklyRangeSell, weeklyBreakDown, weeklyBreakUp, wWaitSell, wWaitBuy, weeklyNearBull, weeklyNearBear, wActiveTop, wActiveBot, wActiveDist, wCount, wATR] = f_mask(useWeeklyFVG, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18)
[dailyMode, dailyZonePosition, dInside, dOutside, dailyNearUpper, dailyNearLower, dailyRangeBuy, dailyRangeSell, dailyBreakDown, dailyBreakUp, dWaitSell, dWaitBuy, dailyNearBull, dailyNearBear, dActiveTop, dActiveBot, dActiveDist, dCount, dATR] = f_mask(useDailyFVG, d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18)
[h4Mode, h4ZonePosition, h4Inside, h4Outside, h4NearUpper, h4NearLower, h4RangeBuy, h4RangeSell, h4BreakDown, h4BreakUp, h4WaitSell, h4WaitBuy, h4NearBull, h4NearBear, h4ActiveTop, h4ActiveBot, h4ActiveDist, h4Count, h4ATR] = f_mask(use4HFVG, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18)
[h1Mode, h1ZonePosition, h1Inside, h1Outside, h1NearUpper, h1NearLower, h1RangeBuy, h1RangeSell, h1BreakDown, h1BreakUp, h1WaitSell, h1WaitBuy, h1NearBull, h1NearBear, h1ActiveTop, h1ActiveBot, h1ActiveDist, h1Count, h1ATR] = f_mask(use1HFVG, o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, o10, o11, o12, o13, o14, o15, o16, o17, o18)

// ============================================================
//  クロスTF アクティブFVG選択 (優先: 内包 → 最近接 → 上位足)
//  ※ W → 1H の順で評価し、同条件なら先に入れた上位足を維持
// ============================================================
float activeFVGTop    = na
float activeFVGBottom = na
bool  activeFVGInside = false
float gDist           = na
int   activeFVGTF     = 0   // 0=なし / 1=W / 2=D / 3=4H / 4=1H
bool  gHas            = false

if not na(wActiveTop)
    bool rep = not gHas or (wInside and not activeFVGInside) or (wInside == activeFVGInside and wActiveDist < gDist)
    if rep
        activeFVGTop := wActiveTop
        activeFVGBottom := wActiveBot
        activeFVGInside := wInside
        gDist := wActiveDist
        activeFVGTF := 1
    gHas := true
if not na(dActiveTop)
    bool rep = not gHas or (dInside and not activeFVGInside) or (dInside == activeFVGInside and dActiveDist < gDist)
    if rep
        activeFVGTop := dActiveTop
        activeFVGBottom := dActiveBot
        activeFVGInside := dInside
        gDist := dActiveDist
        activeFVGTF := 2
    gHas := true
if not na(h4ActiveTop)
    bool rep = not gHas or (h4Inside and not activeFVGInside) or (h4Inside == activeFVGInside and h4ActiveDist < gDist)
    if rep
        activeFVGTop := h4ActiveTop
        activeFVGBottom := h4ActiveBot
        activeFVGInside := h4Inside
        gDist := h4ActiveDist
        activeFVGTF := 3
    gHas := true
if not na(h1ActiveTop)
    bool rep = not gHas or (h1Inside and not activeFVGInside) or (h1Inside == activeFVGInside and h1ActiveDist < gDist)
    if rep
        activeFVGTop := h1ActiveTop
        activeFVGBottom := h1ActiveBot
        activeFVGInside := h1Inside
        gDist := h1ActiveDist
        activeFVGTF := 4
    gHas := true

// ============================================================
//  コンフルエンス (週足+日足+4H が同一価格帯に重なる数)
// ============================================================
int fvgConfluenceCount = (useWeeklyFVG and wInside ? 1 : 0) + (useDailyFVG and dInside ? 1 : 0) + (use4HFVG and h4Inside ? 1 : 0)

// ============================================================
//  統合出力 (後でストラテジーが AND 条件で使う)
// ============================================================
bool allowLongByHTFFVG  = weeklyRangeBuy  or dailyRangeBuy  or h4RangeBuy  or h1RangeBuy
bool allowShortByHTFFVG = weeklyRangeSell or dailyRangeSell or h4RangeSell or h1RangeSell
bool isRangeByHTFFVG    = wInside or dInside or h4Inside or h1Inside
bool waitingIFVG        = wWaitSell or wWaitBuy or dWaitSell or dWaitBuy or h4WaitSell or h4WaitBuy or h1WaitSell or h1WaitBuy

// iFVG候補 (方向別 統合)
bool waitingIFVGSell = wWaitSell or dWaitSell or h4WaitSell or h1WaitSell
bool waitingIFVGBuy  = wWaitBuy  or dWaitBuy  or h4WaitBuy  or h1WaitBuy

// ============================================================
//  表示 : テーブル
// ============================================================
f_modeStr(m) =>
    m == 1 ? "Inside" : m == 2 ? "BreakUp" : m == 3 ? "BreakDn" : m == 4 ? "Outside" : "-"

f_modeCol(m) =>
    m == 1 ? colInside : m == 2 ? colBreakUp : m == 3 ? colBreakDn : m == 4 ? colOutside : color.new(color.gray, 60)

f_b(b) =>
    b ? "✓" : "-"

var table tbl = table.new(position.top_right, 8, 6, border_width = 1)

f_tfRow(row, name, on, m, inside, outside, nearU, nearL, bUp, bDn) =>
    color rc = on ? f_modeCol(m) : color.new(color.gray, 80)
    table.cell(tbl, 0, row, name,                text_color = color.white, bgcolor = color.new(color.black, 50))
    table.cell(tbl, 1, row, on ? f_modeStr(m) : "off", text_color = color.white, bgcolor = rc)
    table.cell(tbl, 2, row, f_b(inside),  text_color = color.white)
    table.cell(tbl, 3, row, f_b(outside), text_color = color.white)
    table.cell(tbl, 4, row, f_b(nearU),   text_color = color.white)
    table.cell(tbl, 5, row, f_b(nearL),   text_color = color.white)
    table.cell(tbl, 6, row, f_b(bUp),     text_color = color.white)
    table.cell(tbl, 7, row, f_b(bDn),     text_color = color.white)

if showHTFTable and barstate.islast
    table.cell(tbl, 0, 0, "TF",        text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 1, 0, "Mode",      text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 2, 0, "Inside",    text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 3, 0, "Outside",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 4, 0, "NearUp",    text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 5, 0, "NearLow",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 6, 0, "BreakUp",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(tbl, 7, 0, "BreakDn",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    f_tfRow(1, "Weekly", useWeeklyFVG, weeklyMode, wInside, wOutside, weeklyNearUpper, weeklyNearLower, weeklyBreakUp, weeklyBreakDown)
    f_tfRow(2, "Daily",  useDailyFVG,  dailyMode,  dInside, dOutside, dailyNearUpper,  dailyNearLower,  dailyBreakUp,  dailyBreakDown)
    f_tfRow(3, "4H",     use4HFVG,     h4Mode,     h4Inside,h4Outside,h4NearUpper,     h4NearLower,     h4BreakUp,     h4BreakDown)
    f_tfRow(4, "1H",     use1HFVG,     h1Mode,     h1Inside,h1Outside,h1NearUpper,     h1NearLower,     h1BreakUp,     h1BreakDown)
    table.cell(tbl, 0, 5, "Confluence", text_color = color.white, bgcolor = color.new(color.purple, 0))
    table.cell(tbl, 1, 5, str.tostring(fvgConfluenceCount), text_color = color.white, bgcolor = color.new(color.purple, 0))
    table.cell(tbl, 2, 5, "iFVG待ち",   text_color = color.white)
    table.cell(tbl, 3, 5, f_b(waitingIFVG), text_color = color.white)
    table.cell(tbl, 4, 5, "Long",  text_color = color.white)
    table.cell(tbl, 5, 5, f_b(allowLongByHTFFVG),  text_color = color.white)
    table.cell(tbl, 6, 5, "Short", text_color = color.white)
    table.cell(tbl, 7, 5, f_b(allowShortByHTFFVG), text_color = color.white)

// ============================================================
//  プロット (接続用 : data_window に値を出す)
// ============================================================
plot(weeklyMode, "weeklyMode", display = display.data_window)
plot(dailyMode,  "dailyMode",  display = display.data_window)
plot(h4Mode,     "h4Mode",     display = display.data_window)
plot(h1Mode,     "h1Mode",     display = display.data_window)

plot(weeklyZonePosition, "weeklyZonePosition", display = display.data_window)
plot(dailyZonePosition,  "dailyZonePosition",  display = display.data_window)
plot(h4ZonePosition,     "h4ZonePosition",     display = display.data_window)
plot(h1ZonePosition,     "h1ZonePosition",     display = display.data_window)

plot(fvgConfluenceCount, "fvgConfluenceCount", display = display.data_window)
plot(allowLongByHTFFVG  ? 1 : 0, "allowLongByHTFFVG",  display = display.data_window)
plot(allowShortByHTFFVG ? 1 : 0, "allowShortByHTFFVG", display = display.data_window)
plot(isRangeByHTFFVG    ? 1 : 0, "isRangeByHTFFVG",    display = display.data_window)
plot(waitingIFVG        ? 1 : 0, "waitingIFVG",        display = display.data_window)

// クロスTF アクティブFVG
plot(activeFVGTop,    "activeFVGTop",    display = display.data_window)
plot(activeFVGBottom, "activeFVGBottom", display = display.data_window)
plot(activeFVGTF,     "activeFVGTF",     display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(wInside,  "Weekly Inside", "{{ticker}} Weekly FVG内")
alertcondition(dInside,  "Daily Inside",  "{{ticker}} Daily FVG内")
alertcondition(h4Inside, "4H Inside",     "{{ticker}} 4H FVG内")
alertcondition(h1Inside, "1H Inside",     "{{ticker}} 1H FVG内")

alertcondition(weeklyBreakUp or weeklyBreakDown, "Weekly Break", "{{ticker}} Weekly FVG ブレイク")
alertcondition(dailyBreakUp  or dailyBreakDown,  "Daily Break",  "{{ticker}} Daily FVG ブレイク")
alertcondition(h4BreakUp     or h4BreakDown,     "4H Break",     "{{ticker}} 4H FVG ブレイク")
alertcondition(h1BreakUp     or h1BreakDown,     "1H Break",     "{{ticker}} 1H FVG ブレイク")

alertcondition(weeklyNearUpper or dailyNearUpper or h4NearUpper or h1NearUpper, "Near Upper", "{{ticker}} HTF FVG 上限付近")
alertcondition(weeklyNearLower or dailyNearLower or h4NearLower or h1NearLower, "Near Lower", "{{ticker}} HTF FVG 下限付近")

    array<int> journalDirections
    array<bool> journalIsBroadFlags
    array<int> journalNewMasks
    array<int> journalPairKeys
    array<int> journalSlopeDirs
    int journalCount = 0

// H01 w06BuildProductionArraysRaw : fixture Roots (creation order = array order, rootId 1-based strictly ascending,
// slot = array index) -> the Production physical arrays. Ticks are round(price / mintick) exactly as
// rootWritePricesAndTicksRaw; the price order holds the live non-FVG Roots with a point tick, each inserted at the upper
// bound of its tick (Production rootPriceOrderInsertRaw: ties keep creation order); rootIdOrderSlots is creation order;
// categoryFvgRootSlots pushes FVG slots in creation order; an originKey != 0 attaches at its bucket head; an Accum Root
// with pairKey != 0 enters the upper / lower pair map; the EMA2000 / EMA3000 references follow the last MA Root of that
// subtype. Core / participation / PendingTopology stores are empty with per-slot participation heads (-1) and counts (0).
// W05 Candidate and W06 cache state start at the Production defaults (empty buffers, next component ID 1, cache invalid).
// Returns [roots, candidate, component, journal, ok]; ok false leaves an unusable fixture.
w06BuildProductionArraysRaw(array<RefRoot> roots, array<int> originKeys, float mintick) =>
    W06FxRoots fr = W06FxRoots.new()
    fr.rootIds := array.new_int(0)
    fr.rootOriginKeys := array.new_int(0)
    fr.rootCategories := array.new_int(0)
    fr.rootSubtypes := array.new_int(0)
    fr.rootTfCodes := array.new_int(0)
    fr.rootOriginTimes := array.new_int(0)
    fr.rootConfirmedTimes := array.new_int(0)
    fr.rootPointPrices := array.new_float(0)
    fr.rootPointTicks := array.new_int(0)
    fr.rootNativeBottoms := array.new_float(0)
    fr.rootNativeTops := array.new_float(0)
    fr.rootNativeBottomTicks := array.new_int(0)
    fr.rootNativeTopTicks := array.new_int(0)
    fr.rootStates := array.new_int(0)
    fr.rootPairKeys := array.new_int(0)
    fr.rootDirections := array.new_int(0)
    fr.rootFvgFreshFlags := array.new_bool(0)
    fr.rootIsBroadFvgFlags := array.new_bool(0)
    fr.rootLabelMasks := array.new_int(0)
    fr.rootSlotLiveFlags := array.new_bool(0)
    fr.rootSwingTfMasks := array.new_int(0)
    fr.rootPriceOrderSlots := array.new_int(0)
    fr.rootIdOrderSlots := array.new_int(0)
    fr.categoryFvgRootSlots := array.new_int(0)
    fr.rootOriginBucketNextRootSlots := array.new_int(0)
    fr.rootOriginBucketExpectedRootIds := array.new_int(0)
    fr.rootParticipationHeadEdgeIndexes := array.new_int(0)
    fr.rootParticipationCounts := array.new_int(0)
    fr.participationEdgeRootSlots := array.new_int(0)
    fr.participationEdgeExpectedRootIds := array.new_int(0)
    fr.participationEdgeSideSlots := array.new_int(0)
    fr.participationEdgeExpectedCoreIds := array.new_int(0)
    fr.participationEdgeNextByRootIndexes := array.new_int(0)
    fr.participationEdgeLiveFlags := array.new_bool(0)
    fr.sidePhases := array.new_int(0)
    fr.coreIds := array.new_int(0)
    fr.coreGenerationIds := array.new_int(0)
    fr.coreSlotLiveFlags := array.new_bool(0)
    fr.coreLiveSlots := array.new_int(0)
    fr.corePhysicalBottoms := array.new_float(0)
    fr.corePhysicalTops := array.new_float(0)
    fr.corePendingTopologyChildHeadIndexes := array.new_int(0)
    fr.corePendingTopologyChildCounts := array.new_int(0)
    fr.pendingTopologyChildNextIndexes := array.new_int(0)
    fr.pendingTopologyChildOwnerCoreSlots := array.new_int(0)
    fr.pendingTopologyChildExpectedCoreIds := array.new_int(0)
    fr.pendingTopologyChildExpectedGenerationIds := array.new_int(0)
    fr.pendingTopologyChildRootHeadNodeIndexes := array.new_int(0)
    fr.pendingTopologyChildRootCounts := array.new_int(0)
    fr.pendingTopologyChildLiveFlags := array.new_bool(0)
    fr.pendingTopologyRootNodeRootIds := array.new_int(0)
    fr.pendingTopologyRootNodeNextIndexes := array.new_int(0)
    fr.pendingTopologyRootNodeOwnerChildIndexes := array.new_int(0)
    fr.pendingTopologyRootNodeExpectedCoreIds := array.new_int(0)
    fr.pendingTopologyRootNodeExpectedGenerationIds := array.new_int(0)
    fr.pendingTopologyRootNodeLiveFlags := array.new_bool(0)
    fr.rootIdToSlot := map.new<int, int>()
    fr.accumPairUpperRootSlotByKey := map.new<int, int>()
    fr.accumPairLowerRootSlotByKey := map.new<int, int>()
    fr.originKeyBucketHeadRootSlots := map.new<int, int>()
    W06FxCand fc = W06FxCand.new()
    fc.candidateScratchSupportNewRootSlots := array.new_int(0)
    fc.candidateScratchResistanceNewRootSlots := array.new_int(0)
    fc.candidateSupportScratchPosByRootSlot := array.new_int(0)
    fc.candidateResistanceScratchPosByRootSlot := array.new_int(0)
    fc.candidateSupportUsedByRootSlot := array.new_bool(0)
    fc.candidateResistanceUsedByRootSlot := array.new_bool(0)
    fc.candidateSupportFvgRootSlots := array.new_int(0)
    fc.candidateResistanceFvgRootSlots := array.new_int(0)
    fc.candidateWindowMinRootIdDequeScratchIndexes := array.new_int(0)
    fc.candidateWindowMaxConfirmedTimeDequeScratchIndexes := array.new_int(0)
    fc.candidateWinnerSides := array.new_int(0)
    fc.candidateWinnerStages := array.new_int(0)
    fc.candidateWinnerEffectiveBottomTicks := array.new_int(0)
    fc.candidateWinnerEffectiveTopTicks := array.new_int(0)
    fc.candidateWinnerCCounts := array.new_int(0)
    fc.candidateWinnerHCounts := array.new_int(0)
    fc.candidateWinnerDensities := array.new_int(0)
    fc.candidateWinnerBaseStrongFlags := array.new_bool(0)
    fc.candidateWinnerCategoryMasks := array.new_int(0)
    fc.candidateWinnerHighMasks := array.new_int(0)
    fc.candidateWinnerCreatedTimes := array.new_int(0)
    fc.candidateWinnerMinRootIds := array.new_int(0)
    fc.candidateWinnerFvgModes := array.new_int(0)
    fc.candidateWinnerPsychLevelTicks := array.new_int(0)
    fc.candidateWinnerReferencePrices := array.new_float(0)
    fc.candidateWinnerRootIdOffsets := array.new_int(0)
    fc.candidateWinnerRootIdLengths := array.new_int(0)
    fc.candidateWinnerRootIds := array.new_int(0)
    fc.candidateWinnerRefValueScratch := array.new_float(0)
    fc.candidateWinnerRefRepScratch := array.new_float(0)
    fc.candidateBroadSeenEpochByRootSlot := array.new_int(0)
    W06FxComp fw = W06FxComp.new()
    fw.rootCandGeometryRevisions := array.new_int(0)
    fw.rootCandQualityRevisions := array.new_int(0)
    fw.rootCandTieBreakRevisions := array.new_int(0)
    fw.rootCandStateRevisions := array.new_int(0)
    fw.rootCandComponentIds := array.new_int(0)
    fw.rootCandComponentExpectedRootIds := array.new_int(0)
    fw.candComponentIds := array.new_int(0)
    fw.candComponentKinds := array.new_int(0)
    fw.candComponentMemberOffsets := array.new_int(0)
    fw.candComponentMemberLengths := array.new_int(0)
    fw.candComponentCfgRevisions := array.new_int(0)
    fw.candComponentStageKeys := array.new_int(0)
    fw.candComponentUsedEpochKeys := array.new_int(0)
    fw.candComponentSupportStatuses := array.new_int(0)
    fw.candComponentResistanceStatuses := array.new_int(0)
    fw.candComponentSupportRecordOffsets := array.new_int(0)
    fw.candComponentSupportRecordLengths := array.new_int(0)
    fw.candComponentResistanceRecordOffsets := array.new_int(0)
    fw.candComponentResistanceRecordLengths := array.new_int(0)
    fw.candComponentSupportSeenOffsets := array.new_int(0)
    fw.candComponentSupportSeenLengths := array.new_int(0)
    fw.candComponentResistanceSeenOffsets := array.new_int(0)
    fw.candComponentResistanceSeenLengths := array.new_int(0)
    fw.candMemberRootIds := array.new_int(0)
    fw.candMemberRoleFlags := array.new_int(0)
    fw.candMemberSideMasks := array.new_int(0)
    fw.candMemberGeometryRevisions := array.new_int(0)
    fw.candMemberQualityRevisions := array.new_int(0)
    fw.candMemberTieBreakRevisions := array.new_int(0)
    fw.candMemberStateRevisions := array.new_int(0)
    fw.candRecordInts := array.new_int(0)
    fw.candRecordReferencePrices := array.new_float(0)
    fw.candRecordRootIds := array.new_int(0)
    fw.candSeenBroadRootIds := array.new_int(0)
    fw.candVisitedEpochByRootSlot := array.new_int(0)
    fw.candQueueRootSlots := array.new_int(0)
    fw.candSeedRootIds := array.new_int(0)
    fw.candSeedReasonMasks := array.new_int(0)
    fw.candFvgChangedRootIds := array.new_int(0)
    fw.candFvgFreshChangedRootIds := array.new_int(0)
    fw.candAffectedComponentIds := array.new_int(0)
    fw.candRemovedComponentIds := array.new_int(0)
    W06FxJournal fj = W06FxJournal.new()
    fj.journalOps := array.new_int(0)
    fj.journalGroups := array.new_int(0)
    fj.journalTargetRootSlots := array.new_int(0)
    fj.journalExpectedRootIds := array.new_int(0)
    fj.journalCategories := array.new_int(0)
    fj.journalSubtypes := array.new_int(0)
    fj.journalTfCodes := array.new_int(0)
    fj.journalOriginKeys := array.new_int(0)
    fj.journalOriginTimes := array.new_int(0)
    fj.journalConfirmedTimes := array.new_int(0)
    fj.journalPointPrices := array.new_float(0)
    fj.journalNativeBottoms := array.new_float(0)
    fj.journalNativeTops := array.new_float(0)
    fj.journalDirections := array.new_int(0)
    fj.journalIsBroadFlags := array.new_bool(0)
    fj.journalNewMasks := array.new_int(0)
    fj.journalPairKeys := array.new_int(0)
    fj.journalSlopeDirs := array.new_int(0)
    int  rootCount = array.size(roots)
    bool ok = not na(mintick) and mintick > 0 and array.size(originKeys) == rootCount
    int  prevId = W06FX_ID_NONE
    int  i = 0
    while ok and i < rootCount
        RefRoot r = array.get(roots, i)
        ok := r.rootId > prevId
        if ok
            int   slot     = i
            bool  isFvg    = r.category == REF_CAT_FVG
            int   pTick    = na(r.pointPrice)   ? int(na) : int(math.round(r.pointPrice   / mintick))
            int   bTick    = na(r.nativeBottom) ? int(na) : int(math.round(r.nativeBottom / mintick))
            int   tTick    = na(r.nativeTop)    ? int(na) : int(math.round(r.nativeTop    / mintick))
            int   oKey     = array.get(originKeys, i)
            array.push(fr.rootIds,               r.rootId)
            array.push(fr.rootOriginKeys,        oKey)
            array.push(fr.rootCategories,        r.category)
            array.push(fr.rootSubtypes,          r.subtype)
            array.push(fr.rootTfCodes,           r.tfCode)
            array.push(fr.rootOriginTimes,       r.originTime)
            array.push(fr.rootConfirmedTimes,    r.confirmedTime)
            array.push(fr.rootPointPrices,       r.pointPrice)
            array.push(fr.rootPointTicks,        pTick)
            array.push(fr.rootNativeBottoms,     r.nativeBottom)
            array.push(fr.rootNativeTops,        r.nativeTop)
            array.push(fr.rootNativeBottomTicks, bTick)
            array.push(fr.rootNativeTopTicks,    tTick)
            array.push(fr.rootStates,            r.state)
            array.push(fr.rootPairKeys,          r.category == REF_CAT_ACCUM ? r.pairKey : W06FX_ID_NONE)
            array.push(fr.rootDirections,        isFvg ? r.direction : W06FX_FVG_NONE)
            array.push(fr.rootFvgFreshFlags,     isFvg)
            array.push(fr.rootIsBroadFvgFlags,   isFvg ? r.isBroadFvg : false)
            array.push(fr.rootLabelMasks,        r.labelMask)
            array.push(fr.rootSlotLiveFlags,     true)
            array.push(fr.rootSwingTfMasks,      r.category == REF_CAT_SWING ? r.swingTfMask : 0)
            array.push(fr.rootOriginBucketNextRootSlots,   W06FX_SLOT_INVALID)
            array.push(fr.rootOriginBucketExpectedRootIds, W06FX_ID_NONE)
            array.push(fr.rootParticipationHeadEdgeIndexes, W06FX_SLOT_INVALID)
            array.push(fr.rootParticipationCounts,          0)
            array.push(fr.rootIdOrderSlots, slot)
            map.put(fr.rootIdToSlot, r.rootId, slot)
            if isFvg
                array.push(fr.categoryFvgRootSlots, slot)
            else if not na(pTick)
                // upper-bound insert: after every order entry whose tick <= pTick
                int orderSize = array.size(fr.rootPriceOrderSlots)
                int pos = orderSize
                int q = 0
                while pos == orderSize and q < orderSize
                    if array.get(fr.rootPointTicks, array.get(fr.rootPriceOrderSlots, q)) > pTick
                        pos := q
                    q += 1
                array.push(fr.rootPriceOrderSlots, slot)
                int k = orderSize
                while k > pos
                    array.set(fr.rootPriceOrderSlots, k, array.get(fr.rootPriceOrderSlots, k - 1))
                    k -= 1
                array.set(fr.rootPriceOrderSlots, pos, slot)
            if oKey != W06FX_ID_NONE
                int oldHead = map.contains(fr.originKeyBucketHeadRootSlots, oKey) ? map.get(fr.originKeyBucketHeadRootSlots, oKey) : W06FX_SLOT_INVALID
                array.set(fr.rootOriginBucketNextRootSlots,   slot, oldHead)
                array.set(fr.rootOriginBucketExpectedRootIds, slot, r.rootId)
                map.put(fr.originKeyBucketHeadRootSlots, oKey, slot)
            if r.category == REF_CAT_ACCUM and r.pairKey != W06FX_ID_NONE and not na(r.pairKey)
                if r.subtype == W06FX_SUB_ACCUM_UPPER
                    map.put(fr.accumPairUpperRootSlotByKey, r.pairKey, slot)
                else if r.subtype == W06FX_SUB_ACCUM_LOWER
                    map.put(fr.accumPairLowerRootSlotByKey, r.pairKey, slot)
            if r.category == REF_CAT_MA and r.subtype == REF_SUB_MA_EMA2000
                fr.ema2000RootSlot       := slot
                fr.ema2000ExpectedRootId := r.rootId
                fr.ema2000SlopeDir       := r.maSlopeDir
            else if r.category == REF_CAT_MA and r.subtype == REF_SUB_MA_EMA3000
                fr.ema3000RootSlot       := slot
                fr.ema3000ExpectedRootId := r.rootId
                fr.ema3000SlopeDir       := r.maSlopeDir
            fr.nextRootId := r.rootId + 1
            prevId        := r.rootId
        i += 1
    [fr, fc, fw, fj, ok]

// ==================== verbatim : H05 codes (ConformanceHarness L2289-L2317) ====================
// H05 field codes (Harness-only, not a Production enum)
const int W06CMP_NONE              = 0
const int W06CMP_SIDE              = 1
const int W06CMP_STAGE             = 2
const int W06CMP_BOTTOM_TICK       = 3
const int W06CMP_TOP_TICK          = 4
const int W06CMP_C                 = 5
const int W06CMP_H                 = 6
const int W06CMP_DENSITY           = 7
const int W06CMP_BASE_STRONG       = 8
const int W06CMP_CATEGORY_MASK     = 9
const int W06CMP_HIGH_MASK         = 10
const int W06CMP_CREATED_TIME      = 11
const int W06CMP_MIN_ROOT_ID       = 12
const int W06CMP_FVG_MODE          = 13
const int W06CMP_PSYCH_LEVEL_TICK  = 14
const int W06CMP_REFERENCE_PRICE   = 15
const int W06CMP_ROOT_ID_OFFSET    = 16
const int W06CMP_ROOT_ID_LENGTH    = 17
const int W06CMP_ROOT_ID           = 18
const int W06CMP_FAILED_SUPPORT    = 19
const int W06CMP_FAILED_RESISTANCE = 20
const int W06CMP_LOGICAL_COUNT     = 21
const int W06CMP_ROOT_POOL_LENGTH  = 22
const int W06CMP_SUPPORT_COUNT     = 23
const int W06CMP_RESISTANCE_COUNT  = 24
const int W06CMP_FAILED_SEGMENT    = 25
const int W06FX_SIDE_SUPPORT       = 1
const int W06FX_SIDE_RESISTANCE    = -1
// ==================== verbatim : H05 comparator (ConformanceHarness L2529-L2708) ====================
// H05 w06CompareWinnersRaw : logical winner contract equality of two Candidate results (no Candidate logic). Order:
// Side counts, failed flags, logical count, root pool length, the failed-Side segment (a -1 Side holds no record), then
// every record in order (all 17 winner fields; exact int / bool / float equality, na equal only to na) and the root ID
// pool in order up to the root length. Transient scratch, Best*, RoundTie, ref scratch lengths and seen epoch tokens are
// not compared. Returns [mismatchCount, firstMismatchField, firstMismatchIndex] ([0, 0, -1] when equal).
w06CompareWinnersRaw(W06FxCand a, int aSupportCount, int aResistanceCount, W06FxCand b, int bSupportCount, int bResistanceCount) =>
    int mismatchCount = 0
    int firstField    = W06CMP_NONE
    int firstIndex    = -1
    array<int> sc = array.from(aSupportCount == bSupportCount ? 0 : W06CMP_SUPPORT_COUNT, aResistanceCount == bResistanceCount ? 0 : W06CMP_RESISTANCE_COUNT, a.candidateFailedSupport == b.candidateFailedSupport ? 0 : W06CMP_FAILED_SUPPORT, a.candidateFailedResistance == b.candidateFailedResistance ? 0 : W06CMP_FAILED_RESISTANCE, a.candidateWinnerLogicalCount == b.candidateWinnerLogicalCount ? 0 : W06CMP_LOGICAL_COUNT, a.candidateWinnerRootIdLength == b.candidateWinnerRootIdLength ? 0 : W06CMP_ROOT_POOL_LENGTH)
    int s = 0
    while s < array.size(sc)
        if array.get(sc, s) != 0
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := array.get(sc, s)
                firstIndex := -1
        s += 1
    // a failed Side (-1) holds no record in either result
    int lane = 0
    while lane < 2
        W06FxCand x = lane == 0 ? a : b
        int xs = lane == 0 ? aSupportCount : bSupportCount
        int xr = lane == 0 ? aResistanceCount : bResistanceCount
        int supportRecords    = 0
        int resistanceRecords = 0
        int k = 0
        while k < x.candidateWinnerLogicalCount and k < array.size(x.candidateWinnerSides)
            int kSide = array.get(x.candidateWinnerSides, k)
            if kSide == W06FX_SIDE_SUPPORT
                supportRecords += 1
            else if kSide == W06FX_SIDE_RESISTANCE
                resistanceRecords += 1
            k += 1
        if (xs == -1 and supportRecords != 0) or (xr == -1 and resistanceRecords != 0)
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_FAILED_SEGMENT
                firstIndex := -1
        lane += 1
    // records in order
    int recA = math.min(a.candidateWinnerLogicalCount, array.size(a.candidateWinnerSides))
    int recB = math.min(b.candidateWinnerLogicalCount, array.size(b.candidateWinnerSides))
    int recN = math.min(recA, recB)
    int i = 0
    while i < recN
        int vSideA = array.get(a.candidateWinnerSides, i)
        int vSideB = array.get(b.candidateWinnerSides, i)
        if not ((na(vSideA) and na(vSideB)) or (not na(vSideA) and not na(vSideB) and vSideA == vSideB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_SIDE
                firstIndex := i
        int vStageA = array.get(a.candidateWinnerStages, i)
        int vStageB = array.get(b.candidateWinnerStages, i)
        if not ((na(vStageA) and na(vStageB)) or (not na(vStageA) and not na(vStageB) and vStageA == vStageB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_STAGE
                firstIndex := i
        int vBottomTickA = array.get(a.candidateWinnerEffectiveBottomTicks, i)
        int vBottomTickB = array.get(b.candidateWinnerEffectiveBottomTicks, i)
        if not ((na(vBottomTickA) and na(vBottomTickB)) or (not na(vBottomTickA) and not na(vBottomTickB) and vBottomTickA == vBottomTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_BOTTOM_TICK
                firstIndex := i
        int vTopTickA = array.get(a.candidateWinnerEffectiveTopTicks, i)
        int vTopTickB = array.get(b.candidateWinnerEffectiveTopTicks, i)
        if not ((na(vTopTickA) and na(vTopTickB)) or (not na(vTopTickA) and not na(vTopTickB) and vTopTickA == vTopTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_TOP_TICK
                firstIndex := i
        int vCA = array.get(a.candidateWinnerCCounts, i)
        int vCB = array.get(b.candidateWinnerCCounts, i)
        if not ((na(vCA) and na(vCB)) or (not na(vCA) and not na(vCB) and vCA == vCB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_C
                firstIndex := i
        int vHA = array.get(a.candidateWinnerHCounts, i)
        int vHB = array.get(b.candidateWinnerHCounts, i)
        if not ((na(vHA) and na(vHB)) or (not na(vHA) and not na(vHB) and vHA == vHB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_H
                firstIndex := i
        int vDensityA = array.get(a.candidateWinnerDensities, i)
        int vDensityB = array.get(b.candidateWinnerDensities, i)
        if not ((na(vDensityA) and na(vDensityB)) or (not na(vDensityA) and not na(vDensityB) and vDensityA == vDensityB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_DENSITY
                firstIndex := i
        bool vBaseStrongA = array.get(a.candidateWinnerBaseStrongFlags, i)
        bool vBaseStrongB = array.get(b.candidateWinnerBaseStrongFlags, i)
        if vBaseStrongA != vBaseStrongB
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_BASE_STRONG
                firstIndex := i
        int vCategoryMaskA = array.get(a.candidateWinnerCategoryMasks, i)
        int vCategoryMaskB = array.get(b.candidateWinnerCategoryMasks, i)
        if not ((na(vCategoryMaskA) and na(vCategoryMaskB)) or (not na(vCategoryMaskA) and not na(vCategoryMaskB) and vCategoryMaskA == vCategoryMaskB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_CATEGORY_MASK
                firstIndex := i
        int vHighMaskA = array.get(a.candidateWinnerHighMasks, i)
        int vHighMaskB = array.get(b.candidateWinnerHighMasks, i)
        if not ((na(vHighMaskA) and na(vHighMaskB)) or (not na(vHighMaskA) and not na(vHighMaskB) and vHighMaskA == vHighMaskB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_HIGH_MASK
                firstIndex := i
        int vCreatedTimeA = array.get(a.candidateWinnerCreatedTimes, i)
        int vCreatedTimeB = array.get(b.candidateWinnerCreatedTimes, i)
        if not ((na(vCreatedTimeA) and na(vCreatedTimeB)) or (not na(vCreatedTimeA) and not na(vCreatedTimeB) and vCreatedTimeA == vCreatedTimeB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_CREATED_TIME
                firstIndex := i
        int vMinRootIdA = array.get(a.candidateWinnerMinRootIds, i)
        int vMinRootIdB = array.get(b.candidateWinnerMinRootIds, i)
        if not ((na(vMinRootIdA) and na(vMinRootIdB)) or (not na(vMinRootIdA) and not na(vMinRootIdB) and vMinRootIdA == vMinRootIdB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_MIN_ROOT_ID
                firstIndex := i
        int vFvgModeA = array.get(a.candidateWinnerFvgModes, i)
        int vFvgModeB = array.get(b.candidateWinnerFvgModes, i)
        if not ((na(vFvgModeA) and na(vFvgModeB)) or (not na(vFvgModeA) and not na(vFvgModeB) and vFvgModeA == vFvgModeB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_FVG_MODE
                firstIndex := i
        int vPsychLevelTickA = array.get(a.candidateWinnerPsychLevelTicks, i)
        int vPsychLevelTickB = array.get(b.candidateWinnerPsychLevelTicks, i)
        if not ((na(vPsychLevelTickA) and na(vPsychLevelTickB)) or (not na(vPsychLevelTickA) and not na(vPsychLevelTickB) and vPsychLevelTickA == vPsychLevelTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_PSYCH_LEVEL_TICK
                firstIndex := i
        float vReferencePriceA = array.get(a.candidateWinnerReferencePrices, i)
        float vReferencePriceB = array.get(b.candidateWinnerReferencePrices, i)
        if not ((na(vReferencePriceA) and na(vReferencePriceB)) or (not na(vReferencePriceA) and not na(vReferencePriceB) and vReferencePriceA == vReferencePriceB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_REFERENCE_PRICE
                firstIndex := i
        int vRootIdOffsetA = array.get(a.candidateWinnerRootIdOffsets, i)
        int vRootIdOffsetB = array.get(b.candidateWinnerRootIdOffsets, i)
        if not ((na(vRootIdOffsetA) and na(vRootIdOffsetB)) or (not na(vRootIdOffsetA) and not na(vRootIdOffsetB) and vRootIdOffsetA == vRootIdOffsetB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID_OFFSET
                firstIndex := i
        int vRootIdLengthA = array.get(a.candidateWinnerRootIdLengths, i)
        int vRootIdLengthB = array.get(b.candidateWinnerRootIdLengths, i)
        if not ((na(vRootIdLengthA) and na(vRootIdLengthB)) or (not na(vRootIdLengthA) and not na(vRootIdLengthB) and vRootIdLengthA == vRootIdLengthB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID_LENGTH
                firstIndex := i
        i += 1
    // root ID pool in order
    int poolA = math.min(a.candidateWinnerRootIdLength, array.size(a.candidateWinnerRootIds))
    int poolB = math.min(b.candidateWinnerRootIdLength, array.size(b.candidateWinnerRootIds))
    int m = math.min(poolA, poolB)
    int g = 0
    while g < m
        if array.get(a.candidateWinnerRootIds, g) != array.get(b.candidateWinnerRootIds, g)
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID
                firstIndex := g
        g += 1
    [mismatchCount, firstField, firstIndex]

// ==================== verbatim : H06 codes + comparator (ConformanceHarness L2712-L2823) ====================
// H06 field codes (Harness-only)
const int W06REF_NONE             = 0
const int W06REF_SUPPORT_COUNT    = 1
const int W06REF_RESISTANCE_COUNT = 2
const int W06REF_SIDE             = 3
const int W06REF_STAGE            = 4
const int W06REF_BOTTOM_TICK      = 5
const int W06REF_TOP_TICK         = 6
const int W06REF_CATEGORY_MASK    = 7
const int W06REF_HIGH_MASK        = 8
const int W06REF_C                = 9
const int W06REF_H                = 10
const int W06REF_DENSITY          = 11
const int W06REF_BASE_STRONG      = 12
const int W06REF_CREATED_TIME     = 13
const int W06REF_MIN_ROOT_ID      = 14
const int W06REF_PSYCH            = 15
const int W06REF_BROAD_CONTEXT    = 16
const int W06REF_REFERENCE_PRICE  = 17
const int W06REF_ROOT_IDS         = 18
// Test A compare codes (Harness-only)
const int W06TA_COMPARE_NONE        = 0
const int W06TA_COMPARE_W06_CACHE   = 1
const int W06TA_COMPARE_W05_V2_V3   = 2
const int W06TA_STEP_COUNT          = 16

// H06 w06CompareWithReferenceRaw : one Candidate result (W06FxCand records, Support then Resistance) against the W04
// Reference results of each Side (refBuildReferenceResults: -1 failure or the result count, results in winner order).
// Compared only where RefResult exposes the field: Side counts, then per record side, stage, effective range, category
// / high mask, C, H, density, baseStrong, createdTime, minRootId, psych presence + tick, Broad Context (fvgMode 5),
// reference price (exact, na only equal to na) and the ascending materialized root ID list. Not exposed by RefResult:
// fvgMode detail, root pool offsets; not exposed by W06 records: psychIsMajor. Returns [mismatchCount, firstField,
// firstIndex] ([0, 0, -1] when equal); the index is the W06 record index.
w06CompareWithReferenceRaw(W06FxCand a, int aSupportCount, int aResistanceCount, int refSupportCount, array<RefResult> refSupport, int refResistanceCount, array<RefResult> refResistance) =>
    int mismatchCount = 0
    int firstField    = W06REF_NONE
    int firstIndex    = -1
    if aSupportCount != refSupportCount
        mismatchCount += 1
        firstField    := W06REF_SUPPORT_COUNT
    if aResistanceCount != refResistanceCount
        mismatchCount += 1
        if firstField == W06REF_NONE
            firstField := W06REF_RESISTANCE_COUNT
    int side = 0
    while side < 2
        int aCount = side == 0 ? aSupportCount : aResistanceCount
        int rCount = side == 0 ? refSupportCount : refResistanceCount
        array<RefResult> refs = side == 0 ? refSupport : refResistance
        int base = side == 0 ? 0 : math.max(aSupportCount, 0)
        int pairs = aCount >= 0 and rCount >= 0 ? math.min(aCount, math.min(rCount, array.size(refs))) : 0
        int i = 0
        while i < pairs
            int idx = base + i
            if idx < a.candidateWinnerLogicalCount and idx < array.size(a.candidateWinnerSides)
                RefResult rr = array.get(refs, i)
                array<int> codes = array.new_int(0)
                int   aStage   = array.get(a.candidateWinnerStages, idx)
                int   aBottom  = array.get(a.candidateWinnerEffectiveBottomTicks, idx)
                int   aTop     = array.get(a.candidateWinnerEffectiveTopTicks, idx)
                int   aDensity = array.get(a.candidateWinnerDensities, idx)
                int   aCreated = array.get(a.candidateWinnerCreatedTimes, idx)
                int   aPsych   = array.get(a.candidateWinnerPsychLevelTicks, idx)
                float aPrice   = array.get(a.candidateWinnerReferencePrices, idx)
                if array.get(a.candidateWinnerSides, idx) != rr.side
                    array.push(codes, W06REF_SIDE)
                if not ((na(aStage) and na(rr.stage)) or (not na(aStage) and not na(rr.stage) and aStage == rr.stage))
                    array.push(codes, W06REF_STAGE)
                if not ((na(aBottom) and na(rr.effectiveBottomTick)) or (not na(aBottom) and not na(rr.effectiveBottomTick) and aBottom == rr.effectiveBottomTick))
                    array.push(codes, W06REF_BOTTOM_TICK)
                if not ((na(aTop) and na(rr.effectiveTopTick)) or (not na(aTop) and not na(rr.effectiveTopTick) and aTop == rr.effectiveTopTick))
                    array.push(codes, W06REF_TOP_TICK)
                if array.get(a.candidateWinnerCategoryMasks, idx) != rr.categoryMask
                    array.push(codes, W06REF_CATEGORY_MASK)
                if array.get(a.candidateWinnerHighMasks, idx) != rr.highMask
                    array.push(codes, W06REF_HIGH_MASK)
                if array.get(a.candidateWinnerCCounts, idx) != rr.cCount
                    array.push(codes, W06REF_C)
                if array.get(a.candidateWinnerHCounts, idx) != rr.hCount
                    array.push(codes, W06REF_H)
                if not ((na(aDensity) and na(rr.density)) or (not na(aDensity) and not na(rr.density) and aDensity == rr.density))
                    array.push(codes, W06REF_DENSITY)
                if array.get(a.candidateWinnerBaseStrongFlags, idx) != rr.baseStrong
                    array.push(codes, W06REF_BASE_STRONG)
                if not ((na(aCreated) and na(rr.createdTime)) or (not na(aCreated) and not na(rr.createdTime) and aCreated == rr.createdTime))
                    array.push(codes, W06REF_CREATED_TIME)
                if array.get(a.candidateWinnerMinRootIds, idx) != rr.minRootId
                    array.push(codes, W06REF_MIN_ROOT_ID)
                if (not na(aPsych)) != rr.psychPresent or (not na(aPsych) and rr.psychPresent and aPsych != rr.psychLevelTick)
                    array.push(codes, W06REF_PSYCH)
                if (array.get(a.candidateWinnerFvgModes, idx) == REF_FVG_RANGE_BROAD_CONTEXT) != rr.isBroadContext
                    array.push(codes, W06REF_BROAD_CONTEXT)
                if not ((na(aPrice) and na(rr.referencePrice)) or (not na(aPrice) and not na(rr.referencePrice) and aPrice == rr.referencePrice))
                    array.push(codes, W06REF_REFERENCE_PRICE)
                int rootOff = array.get(a.candidateWinnerRootIdOffsets, idx)
                int rootLen = array.get(a.candidateWinnerRootIdLengths, idx)
                bool rootsEqual = rootLen == array.size(rr.materializedRootIds) and rootOff >= 0 and rootOff + rootLen <= array.size(a.candidateWinnerRootIds)
                int g = 0
                while rootsEqual and g < rootLen
                    rootsEqual := array.get(a.candidateWinnerRootIds, rootOff + g) == array.get(rr.materializedRootIds, g)
                    g += 1
                if not rootsEqual
                    array.push(codes, W06REF_ROOT_IDS)
                if array.size(codes) > 0
                    mismatchCount += array.size(codes)
                    if firstField == W06REF_NONE
                        firstField := array.get(codes, 0)
                        firstIndex := idx
            i += 1
        side += 1
    [mismatchCount, firstField, firstIndex]

// ==================== verbatim : lane C RefRoot adapter (B18_TestB L3347-L3358) ====================
// H08 helper (lane C input): the W04 RefRoot array of one lane's current Root state, live slots in slot (= rootId) order,
// every field copied as stored; maSlopeDir = the stored EMA2000 / EMA3000 slope of the slot that EMA reference points at
// (0 for any other MA Root). Nothing is read from a Candidate result.
w06TbRefRootsRaw(W06FxRoots fr) =>
    array<RefRoot> out = array.new<RefRoot>()
    int s = 0
    while s < array.size(fr.rootIds)
        if array.get(fr.rootSlotLiveFlags, s)
            int slope = s == fr.ema2000RootSlot ? fr.ema2000SlopeDir : s == fr.ema3000RootSlot ? fr.ema3000SlopeDir : 0
            array.push(out, RefRoot.new(rootId = array.get(fr.rootIds, s), category = array.get(fr.rootCategories, s), subtype = array.get(fr.rootSubtypes, s), tfCode = array.get(fr.rootTfCodes, s), originTime = array.get(fr.rootOriginTimes, s), confirmedTime = array.get(fr.rootConfirmedTimes, s), pointPrice = array.get(fr.rootPointPrices, s), pointTick = array.get(fr.rootPointTicks, s), nativeBottom = array.get(fr.rootNativeBottoms, s), nativeTop = array.get(fr.rootNativeTops, s), nativeBottomTick = array.get(fr.rootNativeBottomTicks, s), nativeTopTick = array.get(fr.rootNativeTopTicks, s), state = array.get(fr.rootStates, s), pairKey = array.get(fr.rootPairKeys, s), direction = array.get(fr.rootDirections, s), isBroadFvg = array.get(fr.rootIsBroadFvgFlags, s), labelMask = array.get(fr.rootLabelMasks, s), swingTfMask = array.get(fr.rootSwingTfMasks, s), maSlopeDir = slope))
        s += 1
    out
// ==================== L2A (new Harness code) ====================
// Fixture scale: mintick 0.01, clusterMaxWidth 2.00 (M = 200 ticks), denseRatio 0.25 (D = 50 ticks); every category ON.
const float L2A_MINTICK           = 0.01
const float L2A_CLUSTER_MAX_WIDTH = 2.0
const float L2A_DENSE_RATIO       = 0.25
const int   L2A_T0                = 1700000000000
const int   L2A_CONF_STEP         = 300000
// First Compare codes
const int L2A_CMP_NONE    = 0
const int L2A_CMP_INPUT   = 1
const int L2A_CMP_V3_V4   = 2
const int L2A_CMP_REF_V3  = 3
const int L2A_CMP_REF_V4  = 4
const int L2A_CMP_BROAD   = 5
const int L2A_CMP_INVALID = 6
// invalid-input mutations (applied identically to the W05 /3 and /4 lanes after w06BuildProductionArraysRaw)
const int L2A_MUT_NONE         = 0
const int L2A_MUT_UNSORTED_DUP = 1
const int L2A_MUT_NEG_ROOT_ID  = 2

// one fixture : RefRoots (creation order, rootId ascending) + originKeys (all 0), lane flags
type L2aFx
    array<RefRoot> roots
    array<int>     originKeys
    bool           refLane  = true
    int            mutation = 0
    int            mutSlot  = -1
    bool           expectOk = false

// one fixture Root (originTime = confirmedTime = T0 + conf * 5m; ticks are filled by w06BuildProductionArraysRaw)
l2aRoot(L2aFx x, int rid, int cat, int sub, int tf, int conf, float price, float nb, float nt, int dir, bool broad, int st, int label, int swingMask, int slope, int pairKey) =>
    int t = L2A_T0 + conf * L2A_CONF_STEP
    array.push(x.roots, RefRoot.new(rootId = rid, category = cat, subtype = sub, tfCode = tf, originTime = t, confirmedTime = t, pointPrice = price, pointTick = int(na), nativeBottom = nb, nativeTop = nt, nativeBottomTick = int(na), nativeTopTick = int(na), state = st, pairKey = pairKey, direction = dir, isBroadFvg = broad, labelMask = label, swingTfMask = swingMask, maSlopeDir = slope))
    array.push(x.originKeys, 0)
    true

l2aBuild(int code) =>
    L2aFx x = L2aFx.new(array.new<RefRoot>(), array.new_int(0))
    if code == 201
        // H01
        l2aRoot(x, 1, REF_CAT_FVG, 0, 60, 1, na, 1920.00, 1921.00, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2aRoot(x, 2, REF_CAT_SWING, 1, 5, 2, 1921.00, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)

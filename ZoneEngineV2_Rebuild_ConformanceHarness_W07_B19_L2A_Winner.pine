// fresh lane : production arrays of the fixture, then (I06 / I07 only) the invalid-input mutation, never normalized
l2aLane(L2aFx x) =>
    [fr, fc, fw, fj, ok] = w06BuildProductionArraysRaw(x.roots, x.originKeys, L2A_MINTICK)
    bool mOk = ok
    if mOk and x.mutation == L2A_MUT_UNSORTED_DUP
        mOk := x.mutSlot >= 0 and x.mutSlot < array.size(fr.rootIdOrderSlots)
        if mOk
            array.reverse(fr.rootIdOrderSlots)
            array.push(fr.rootIdOrderSlots, x.mutSlot)
    else if mOk and x.mutation == L2A_MUT_NEG_ROOT_ID
        mOk := x.mutSlot >= 0 and x.mutSlot < array.size(fr.rootIds)
        if mOk
            array.set(fr.rootIds, x.mutSlot, -array.get(fr.rootIds, x.mutSlot))
    [fr, fc, mOk]

// W05 W05V3 selectBothSides on one fixture lane (fresh fr / fc); the returned scalars are written back into fc
l2aRunV3(W06FxRoots fr, W06FxCand fc) =>
    [sCnt, rCnt, o_candidateScratchSupportNewLength, o_candidateScratchResistanceNewLength, o_candidateSupportFvgLength, o_candidateResistanceFvgLength, o_candidateBestSide, o_candidateBestStage, o_candidateBestLeftIndex, o_candidateBestRightIndex, o_candidateBestEffectiveBottomTick, o_candidateBestEffectiveTopTick, o_candidateBestCCount, o_candidateBestHCount, o_candidateBestDensity, o_candidateBestBaseStrong, o_candidateBestCreatedTime, o_candidateBestMinRootId, o_candidateBestFvgMode, o_candidateBestFvgRootSlot, o_candidateBestCategoryMask, o_candidateBestHighMask, o_candidateRoundTie, o_candidateFailedSupport, o_candidateFailedResistance, o_candidateWinnerLogicalCount, o_candidateWinnerRootIdLength, o_candidateWinnerRefValueLength, o_candidateWinnerRefRepLength, o_candidatePoolMode, o_candidateBroadSeenEpoch] = W05V3.selectBothSides(fr.rootIds, fr.rootCategories, fr.rootSubtypes, fr.rootTfCodes, fr.rootConfirmedTimes, fr.rootPointPrices, fr.rootPointTicks, fr.rootNativeBottoms, fr.rootNativeTops, fr.rootNativeBottomTicks, fr.rootNativeTopTicks, fr.rootStates, fr.rootPairKeys, fr.rootDirections, fr.rootIsBroadFvgFlags, fr.rootLabelMasks, fr.rootSlotLiveFlags, fr.rootPriceOrderSlots, fr.rootIdOrderSlots, fr.rootIdToSlot, fr.accumPairUpperRootSlotByKey, fr.accumPairLowerRootSlotByKey, fr.rootSwingTfMasks, fr.ema2000RootSlot, fr.ema2000ExpectedRootId, fr.ema2000SlopeDir, fr.ema3000RootSlot, fr.ema3000ExpectedRootId, fr.ema3000SlopeDir, L2A_CLUSTER_MAX_WIDTH, L2A_DENSE_RATIO, true, true, true, true, true, true, L2A_MINTICK, fc.candidateScratchSupportNewRootSlots, fc.candidateScratchResistanceNewRootSlots, fc.candidateSupportScratchPosByRootSlot, fc.candidateResistanceScratchPosByRootSlot, fc.candidateSupportUsedByRootSlot, fc.candidateResistanceUsedByRootSlot, fc.candidateSupportFvgRootSlots, fc.candidateResistanceFvgRootSlots, fc.candidateWindowMinRootIdDequeScratchIndexes, fc.candidateWindowMaxConfirmedTimeDequeScratchIndexes, fc.candidateWinnerSides, fc.candidateW
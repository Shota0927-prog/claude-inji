// one fixture : returns [compare, field, candidateF, parityF, refF, broadF, invalidF]
// First Field : the H05 (W06CMP_*) or H06 (W06REF_*) field code; for a Broad fixture (E / F) the code is 5 and the
// field is 200 + H05 field (W05 /3 vs /4), 300 + H06 field (W04 vs /3) or 400 + H06 field (W04 vs /4); for code 6 the
// field is 1 (a failed Support Side) or 2 (a failed Resistance Side).
l2aRunFixture(int code) =>
    L2aFx x = l2aBuild(code)
    int  g         = int(math.floor(code / 100))
    bool isBroad   = g == 6 or g == 7
    bool isInvalid = not x.refLane
    int  cmp       = L2A_CMP_NONE
    int  field     = -1
    bool parityBad = false
    bool refBad    = false
    bool invBad    = false
    [fr3, fc3, ok3] = l2aLane(x)
    [fr4, fc4, ok4] = l2aLane(x)
    if not (ok3 and ok4 and array.size(x.roots) > 0)
        cmp := L2A_CMP_INPUT
    else
        [s3, r3] = l2aRunV3(fr3, fc3)
        [s4, r4] = l2aRunV4(fr4, fc4)
        [m34, f34, i34] = w06CompareWinnersRaw(fc3, s3, r3, fc4, s4, r4)
        if m34 > 0
            parityBad := true
            cmp   := isBroad ? L2A_CMP_BROAD : L2A_CMP_V3_V4
            field := isBroad ? 200 + f34 : f34
        if x.refLane
            [frR, fcR, okR] = l2aLane(x)
            if not okR
                if cmp == L2A_CMP_NONE
                    cmp := L2A_CMP_INPUT
            else
                array<RefRoot>   refRoots      = w06TbRefRootsRaw(frR)
                int              mTick         = int(math.round(L2A_CLUSTER_MAX_WIDTH / L2A_MINTICK))
                int              denseTick     = int(math.round((L2A_CLUSTER_MAX_WIDTH * L2A_DENSE_RATIO) / L2A_MINTICK))
                array<RefResult> refSupport    = array.new<RefResult>()
                array<RefResult> refResistance = array.new<RefResult>()
                int refSupportCount    = refBuildReferenceResults(refRoots, REF_SIDE_SUPPORT, denseTick, mTick, L2A_MINTICK, refSupport)
                int refResistanceCount = refBuildReferenceResults(refRoots, REF_SIDE_RESISTANCE, denseTick, mTick, L2A_MINTICK, refResistance)
                [mR3, fR3, iR3] = w06CompareWithReferenceRaw(fc3, s3, r3, refSupportCount, refSupport, refResistanceCount, refResistance)
                [mR4, fR4, iR4] = w06CompareWithReferenceRaw(fc4, s4, r4, refSupportCount, refSupport, refResistanceCount, refResistance)
                if mR3 > 0
                    refBad := true
                    if cmp == L2A_CMP_NONE
                        cmp   := isBroad ? L2A_CMP_BROAD : L2A_CMP_REF_V3
                        field := isBroad ? 300 + fR3 : fR3
                if mR4 > 0
                    refBad := true
                    if cmp == L2A_CMP_NONE
                        cmp   := isBroad ? L2A_CMP_BROAD : L2A_CMP_REF_V4
                        field := isBroad ? 400 + fR4 : fR4
        if x.expectOk
            bool supportFailed    = fc3.candidateFailedSupport or fc4.candidateFailedSupport
            bool resistanceFailed = fc3.candidateFailedResistance or fc4.candidateFailedResistance
            if supportFailed or resistanceFailed
                invBad := true
                if cmp == L2A_CMP_NONE
                    cmp   := L2A_CMP_INVALID
                    field := supportFailed ? 1 : 2
    bool failed = cmp != L2A_CMP_NONE
    [cmp, field, (parityBad or refBad) ? 1 : 0, parityBad ? 1 : 0, refBad ? 1 : 0, (isBroad and failed) ? 1 : 0, (isInvalid and failed) ? 1 : 0]

// every fixture once (for loop only); returns the Data Window values
l2aRunAll() =>
    array<int> codes = array.from(201, 202, 203, 204, 206, 207, 208, 209, 210, 213, 214, 301, 302, 303, 304, 305, 306, 307, 308, 401, 402, 403, 404, 405, 406, 601, 602, 603, 604, 605, 606, 607, 608, 701, 702, 703, 704, 705, 801, 802, 803, 804, 805, 806, 901, 902, 1001, 1002, 1003, 1004, 1005, 1006, 1007)
    int failures  = 0
    int executed  = 0
    int firstFail = -1
    int firstCmp  = L2A_CMP_NONE
    int firstFld  = -1
    int candF     = 0
    int parityF   = 0
    int refF      = 0
    int broadF    = 0
    int invalidF  = 0
    for k = 0 to 53 - 1
        int code = array.get(codes, k)
        [c, f, cf, pf, rf, bf, vf] = l2aRunFixture(code)
        executed += 1
        candF    += cf
        parityF  += pf
        refF     += rf
        broadF   += bf
        invalidF += vf
        if c != L2A_CMP_NONE
            failures += 1
            if firstFail < 0
                firstFail := code
                firstCmp  := c
                firstFld  := f
    [failures, executed, firstFail, firstCmp, firstFld, candF, parityF, refF, broadF, invalidF]

var int gFailures  = -1
var int gExecuted  = 0
var int gFirstFail = -1
var int gFirstCmp  = -1
var int gFirstFld  = -1
var int gCandF     = -1
var int gParityF   = -1
var int gRefF      = -1
var int gBroadF    = -1
var int gInvalidF  = -1
if barstate.islast and gExecuted == 0
    [a1, a2, a3, a4, a5, a6, a7, a8, a9, a10] = l2aRunAll()
    gFailures  := a1
    gExecuted  := a2
    gFirstFail := a3
    gFirstCmp  := a4
    gFirstFld  := a5
    gCandF     := a6
    gParityF   := a7
    gRefF      := a8
    gBroadF    := a9
    gInvalidF  := a10

plot(190201,     "W07 B19 L2A Build",                  display = display.data_window)
plot(gFailures,  "W07 B19 L2A Failures",               display = display.data_window)
plot(gExecuted,  "W07 B19 L2A Fixture Count",          display = display.data_window)
plot(gFirstFail, "W07 B19 L2A First Fail Fixture",     display = display.data_window)
plot(gFirstCmp,  "W07 B19 L2A First Compare",          display = display.data_window)
plot(gFirstFld,  "W07 B19 L2A First Field",            display = display.data_window)
plot(gCandF,     "W07 B19 L2A Candidate Failures",     display = display.data_window)
plot(gParityF,   "W07 B19 L2A W05 Parity Failures",    display = display.data_window)
plot(gRefF,      "W07 B19 L2A W04 Ref Failures",       display = display.data_window)
plot(gBroadF,    "W07 B19 L2A Broad Failures",         display = display.data_window)
plot(gInvalidF,  "W07 B19 L2A Invalid Input Failures", display = display.data_window)

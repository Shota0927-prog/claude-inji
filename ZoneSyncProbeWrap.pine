//
// ============================================================================
//  Zone Sync Probe 包み込み (ZSP-0W)  —  検証専用。外部系列を request.security で包んだときの動作を確かめる。
// ----------------------------------------------------------------------------
//  同じチャートに ZSP-0 を追加し、「外部系列」に ZSP-0 の「ZSP 処理済み5分足数」を選ぶ。
//  外部系列は ZSP-0 がこのチャート足で計算した結果であり、request.security(…, "5", 外部系列) と書いても ZSP-0 の計算本体が
//  5分足で計算し直されるとは仮定しない。この試験はその実際の結果 (コンパイル / 追加時のエラー、または届く値) を記録するためのもの。
//   比較: 外部系列そのもの / "5" で包んだ値 / 自分で 5分コンテキストを数えた値 (ZSP-0 と同じ式)
//  ★ TradingView 実機でのコンパイル・表示は未実施。エラーになった場合はその文面を記録する (ZONE_SYNC_FEASIBILITY_ja.md §5)。
// ============================================================================

//@version=5
indicator("Zone Sync Probe 包み込み (ZSP-0W)", "ZSP0W", overlay = true)

zwExt    = input.source(close, "外部系列 (ZSP 処理済み5分足数)")
zwAnchor = input.time(timestamp("2026-10-26T07:00:00+09:00"), "蓄積開始時刻 (ZSP-0 と同じ値)")

simple bool zwLowTf = timeframe.in_seconds() <= 300

f_zwOwn(int aT) =>
    var int n = 0
    int pT = time[1]
    if not na(pT) and pT >= aT
        n += 1
    n

float zwWrap = request.security(syminfo.tickerid, "5", zwExt, lookahead = zwLowTf ? barmerge.lookahead_on : barmerge.lookahead_off)
int   zwOwn  = request.security(syminfo.tickerid, "5", f_zwOwn(zwAnchor), lookahead = zwLowTf ? barmerge.lookahead_on : barmerge.lookahead_off)

plot(zwWrap, "包んだ値", display = display.data_window)
plot(zwOwn, "自分で数えた値", display = display.data_window)

var table zwTb = table.new(position.bottom_left, 2, 5, border_width = 1)
if barstate.islast
    table.cell(zwTb, 0, 0, "チャート足", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(zwTb, 1, 0, timeframe.period, text_color = color.white, bgcolor = color.new(color.olive, 20), text_size = size.small)
    table.cell(zwTb, 0, 1, "外部系列そのもの", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(zwTb, 1, 1, str.tostring(zwExt, "#"), text_color = color.white, bgcolor = color.new(color.olive, 20), text_size = size.small)
    table.cell(zwTb, 0, 2, "\"5\" で包んだ値", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(zwTb, 1, 2, str.tostring(zwWrap, "#"), text_color = color.white, bgcolor = color.new(color.olive, 20), text_size = size.small)
    table.cell(zwTb, 0, 3, "自分で 5分を数えた値", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(zwTb, 1, 3, str.tostring(zwOwn), text_color = color.white, bgcolor = color.new(color.olive, 20), text_size = size.small)

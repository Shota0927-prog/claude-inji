//
// ============================================================
//  トレンド + トライアングル 環境認識ストラテジー
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing) + 任意トリガー
//  ・環境認識     : EMAトレンド環境認識 + トライアングル環境認識 (日足〜1分足の6TF)
//  ・トライアングル= Ascending / Descending / Symmetrical。境界の終値ブレイク方向で bias 確定。
//  ・場所条件     : WinZone は全て不使用
//  ・その他       : ボラフィルタ / リスク管理 / 時間帯フィルタ / Accumulation NoTrade を維持
//  ・環境認識のうち FVG / EMA(50/200/1000) / Stochastic / Fib / Volume / 三尊 / DT/DB / ウェッジ は不使用 (削除)
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "Trend Triangle Env Strategy",
     shorttitle        = "TTRIENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 500
 )

// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 1分足トリガー確認 (request.security_lower_tf で現在の5分足内の確定1分足を配列取得)
//   トリガー検知は 1分足 OHLC で行い、最終エントリーは 5分足確定時に判定する。
//   現在足(5分足)との結合モード (triggerTFMode) は廃止。最終トリガーは 1分足のみで判断。
useLowerTFTrigger = input.bool(true, "1分足トリガーを使う")
triggerTF         = input.timeframe("1", "トリガー時間足")

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
// 既定 true : 同一5分足内で1分足のロング/ショートが両方成立したら NoTrade。
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useTrendEnv = input.bool(true, "トレンド環境認識(EMAスコア)を使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
// --- ① SL方式 (可変・固定/パターンに加えATRを選択可) ---
grpVSL = "① SL方式 (可変)"
slMode    = input.string("固定", "SL方式", options = ["固定", "パターン", "ATR"], group = grpVSL)
slBuf     = input.float(0.0, "SL バッファ (価格) ※パターン時", group = grpVSL)
slFixed   = input.float(12, "固定SL幅 (価格) ※固定時", group = grpVSL)
slAtrLen  = input.int(14, "ATR SL 期間 ※ATR時", group = grpVSL)
slAtrMult = input.float(3.0, "ATR SL 倍率 ※ATR時", group = grpVSL)
// --- ② TP方式 (可変・RR / ATR) ---
grpVTP = "② TP方式 (可変)"
tpMode    = input.string("RR", "TP方式", options = ["RR", "ATR"], group = grpVTP)
rrRatio   = input.float(1.0, "リスクリワード比 (RR時)", group = grpVTP)
tpAtrLen  = input.int(14, "ATR TP 期間 ※ATR時", group = grpVTP)
tpAtrMult = input.float(6.0, "ATR TP 倍率 ※ATR時", group = grpVTP)

useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4i. 入力 : トライアングル 環境認識モジュール (WinZone Triangle とは別)
// ------------------------------------------------------------
//  Ascending / Descending / Symmetrical Triangle を日足〜1分足で認識し、
//  境界ラインの「終値ブレイク方向」を最終的な方向環境バイアスにする。
//    ・上限ライン上抜け → bias=1 (Long) / 下限ライン下抜け → bias=-1 (Short)。
//    ・Ascending の下限否定・Descending の上限否定も、実際のブレイク方向で決める。
//  形成中 / 候補完成 / 未ブレイク は bias=0 (Even)。方向をローソク色で予想しない。
//  同一バー両方向確定 → bias=0。ライン交差後は即失効 (Reject 4)。候補競合は失効 (Reject 1)。
//  ブレイク後 holdBars 本だけ bias を保持し、反対方向の新ブレイクで即上書き。
//  既存の WinZone Triangle とは完全に独立 (接頭辞 triangleEnv)。方向必須の環境フィルター。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。5分足のみ直接計算。
// ============================================================
grpTriEnv = "環境: トライアングル"
useTriangleEnvEnv = input.bool(true, "トライアングル環境認識を使う", group = grpTriEnv)
useTriangleEnvD   = input.bool(true, "日足を使う", group = grpTriEnv)
useTriangleEnv4H  = input.bool(true, "4Hを使う",  group = grpTriEnv)
useTriangleEnv1H  = input.bool(true, "1Hを使う",  group = grpTriEnv)
useTriangleEnv15M = input.bool(true, "15Mを使う", group = grpTriEnv)
useTriangleEnv5M  = input.bool(false, "5Mを使う", group = grpTriEnv)
useTriangleEnv1M  = input.bool(false, "1Mを使う (通常のrequest.securityでは1分イベントを取りこぼすため既定OFF)", group = grpTriEnv)
triangleEnvDailyTF = input.timeframe("D",   "日足TF", group = grpTriEnv)
triangleEnv4HTF    = input.timeframe("240", "4H TF",  group = grpTriEnv)
triangleEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpTriEnv)
triangleEnv15MTF   = input.timeframe("15",  "15M TF", group = grpTriEnv)
triangleEnv5MTF    = input.timeframe("5",   "5M TF",  group = grpTriEnv)
triangleEnv1MTF    = input.timeframe("1",   "1M TF",  group = grpTriEnv)
// --- Pivot管理 ---
triangleEnvPivotLen   = input.int(3, "Pivot Length", minval = 1, group = grpTriEnv)
triangleEnvMinTouches = input.int(2, "最低Pivotタッチ数 (両サイド)", minval = 2, maxval = 4, group = grpTriEnv)
triangleEnvMaxTouches = input.int(6, "最大タッチ数 (探索上限)", minval = 2, maxval = 10, group = grpTriEnv)
triangleEnvMaxPivots  = input.int(12, "保持Pivot数 (探索対象・各サイド)", minval = 4, maxval = 24, group = grpTriEnv)
triangleEnvNoiseATR   = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率", step = 0.05, group = grpTriEnv)
triangleEnvTouchToleranceATR = input.float(0.5, "ラインからの許容誤差 ATR倍率", minval = 0.0, step = 0.05, group = grpTriEnv)
// --- 水平ライン判定 ---
triangleEnvHorizontalMode = input.string("PercentOrATR", "水平判定モード", options = ["Percent", "ATR", "PercentOrATR", "PercentAndATR"], group = grpTriEnv)
triangleEnvTolerancePct   = input.float(0.004, "水平許容率 (Percent)", minval = 0.0, step = 0.001, group = grpTriEnv)
triangleEnvToleranceATR   = input.float(0.5, "水平許容差 (ATR倍率)", minval = 0.0, step = 0.05, group = grpTriEnv)
// --- 収束 / 横幅 ---
triangleEnvContractionRatio = input.float(0.9, "収束率 WidthNow <= WidthStart ×", minval = 0.1, maxval = 1.0, step = 0.05, group = grpTriEnv)
triangleEnvMinPatternBars = input.int(16, "パターン最小横幅", minval = 1, group = grpTriEnv)
triangleEnvMaxPatternBars = input.int(80, "パターン最大横幅", minval = 2, group = grpTriEnv)
triangleEnvSetupValidBars = input.int(50, "セットアップ有効本数", minval = 1, group = grpTriEnv)
triangleEnvBreakMaxBars   = input.int(20, "候補完成後のブレイク期限", minval = 1, group = grpTriEnv)
// --- ブレイク ---
triangleEnvBreakBufferATR = input.float(0.05, "ラインブレイクのATRバッファ", minval = 0.0, step = 0.05, group = grpTriEnv)
// --- ブレイク品質フィルター (任意) ---
useTriangleEnvBreakCandleColor = input.bool(false, "ブレイク足の色を要求 (上抜け=陽線/下抜け=陰線)", group = grpTriEnv)
useTriangleEnvBodyFilter  = input.bool(true, "ブレイク実体率フィルターを使う", group = grpTriEnv)
triangleEnvMinBodyRatio   = input.float(0.45, "最低ブレイク実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTriEnv)
useTriangleEnvATRExpansion = input.bool(false, "ブレイク時のATR拡大を要求", group = grpTriEnv)
triangleEnvAtrExpandLen   = input.int(20, "ATR拡大 比較本数", minval = 1, group = grpTriEnv)
triangleEnvAtrExpandMult  = input.float(1.1, "ATR > 平均ATR ×", step = 0.05, group = grpTriEnv)
// --- 品質フィルター ---
useTriangleEnvQualityFilter = input.bool(false, "Quality Filterを使う", group = grpTriEnv)
triangleEnvMinQuality       = input.int(50, "最低Quality", minval = 0, maxval = 100, group = grpTriEnv)
// --- イベントモード / Retest / FakeBreak ---
triangleEnvEventMode = input.string("BreakOnly", "イベントモード", options = ["BreakOnly", "BreakOrRetest", "FakeBreakOnly", "InvalidationOnly", "AnyConfirmedEvent"], group = grpTriEnv)
triangleEnvFakeBreakBars = input.int(5, "FakeBreak 戻り最大本数", minval = 1, group = grpTriEnv)
triangleEnvRetestATR     = input.float(0.5, "Retest ATR許容", minval = 0.0, step = 0.05, group = grpTriEnv)
triangleEnvRetestMaxBars = input.int(20, "Retest 有効本数", minval = 1, group = grpTriEnv)
useTriangleEnvReversalCandle = input.bool(false, "Retest/Fakeで反転ローソクを要求", group = grpTriEnv)
// --- 状態保持本数 (足ごと) ---
triangleEnvHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpTriEnv)
triangleEnvHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpTriEnv)
triangleEnvHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpTriEnv)
triangleEnvHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpTriEnv)
triangleEnvHold5M    = input.int(24, "5M 状態保持本数",   minval = 1, group = grpTriEnv)
triangleEnvHold1M    = input.int(30, "1M 状態保持本数",   minval = 1, group = grpTriEnv)
// --- 統合 ---
triangleEnvCombineMode = input.string("WeightedScore", "トライアングル環境の結合方法", options = ["HigherTF", "WeightedScore"], group = grpTriEnv)
triangleEnvWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpTriEnv)
triangleEnvWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpTriEnv)
triangleEnvWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpTriEnv)
triangleEnvWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpTriEnv)
triangleEnvWeight5M  = input.int(1, "重み 5M",   minval = 0, group = grpTriEnv)
triangleEnvWeight1M  = input.int(1, "重み 1M",   minval = 0, group = grpTriEnv)
triangleEnvScoreThreshold = input.int(3, "WeightedScore 閾値 (Long: score>=閾値 / Short: score<=-閾値)", minval = 1, group = grpTriEnv)
// --- トレンド環境との結合 ---
triangleEnvTrendCombineMode = input.string("TrendAndTriangle", "トレンドとの結合", options = ["TrendOnly", "TriangleOnly", "TrendAndTriangle", "TrendOrTriangle"], group = grpTriEnv)
useTriangleEnvBias = input.bool(false, "トライアングル方向バイアスを使う (OFFで既存挙動を維持)", group = grpTriEnv)
// --- 表示 ---
triangleEnvShowTable  = input.bool(true,  "トライアングル環境テーブルを表示", group = grpTriEnv)
triangleEnvShowDebug  = input.bool(false, "トライアングル環境デバッグ表示", group = grpTriEnv)
triangleEnvLabelTF    = input.string("15M", "描画対象TF", options = ["D", "4H", "1H", "15M", "5M", "1M"], group = grpTriEnv)
// --- パターン描画 (表示専用・検知/エントリーに影響しない) ---
triangleEnvShowPatternLines = input.bool(true, "トライアングルラインを表示 (上限/下限)", group = grpTriEnv)
triangleEnvShowPivotLabels  = input.bool(true, "採用Pivot/種類ラベルを表示", group = grpTriEnv)
triangleEnvShowBreakLabel   = input.bool(true, "ブレイク確定地点を表示", group = grpTriEnv)
triangleEnvPatternLineWidth = input.int(2, "トライアングルライン太さ", minval = 1, maxval = 4, group = grpTriEnv)
// --- 過去履歴表示 ---
triangleEnvShowHistory  = input.bool(false, "過去のトライアングルを表示", group = grpTriEnv)
triangleEnvHistoryCount = input.int(20, "過去パターン表示件数", minval = 1, maxval = 50, group = grpTriEnv)
triangleEnvHistoryLineTransp = input.int(50, "過去確定ライン透明度", minval = 0, maxval = 90, group = grpTriEnv)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// 有効化されたトリガー数 (Any/All/MinCount 判定で使用・全コンテキスト共通)。
//   f_calcTriggers 内 (=1分足コンテキスト) からも参照するため関数より前で定義する。
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// 1分足コンテキストで全トリガーを判定し、その1分足単体で Any/All/MinCount を評価して
//   [bullTrigger, bearTrigger] を返す。異なる1分足で発生した条件を合算しない。
//   各トリガー条件・品質フィルターは既存ロジックと完全に同一 (変更なし)。
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    // この1分足単体で Any/All/MinCount を評価 (1分足内で完結)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

// 現在足(5分足)での直接判定 (useLowerTFTrigger = false 時のフォールバックのみに使用)
bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 1分足トリガー集約 ---
//   request.security_lower_tf で現在の5分足に含まれる確定済み1分足 (最大5本) の
//   [bullTrigger, bearTrigger] を配列で取得。5本のうち1本でも成立していれば
//   その方向を5分足の候補とする (途中の1分足トリガーを取りこぼさない)。
//   Any/All/MinCount は各1分足内で f_calcTriggers が評価済み → 異なる足の条件は合算しない。
//   ※ 形成途中の1分足は request.security_lower_tf の確定済み配列に含まれないため非リペイント。
bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, triggerTF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    // 1分足トリガー OFF → 現在足(5分足)で直接判定
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

// 同一5分足内でロング/ショート両方の1分足トリガーが発生 → 方向を予想せず NoTrade (既定)。
bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

// エントリークールダウン (5分足単位・トリガーON時のみ 10c で参照)
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useTrendEnv
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  本ファイルの環境認識モジュールは トレンド(EMAスコア) のみ。
//  FVG / EMA(50/200/1000) / Stochastic / Fib / Volume は削除済み。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool allEnvLongOk = trendLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool allEnvShortOk = trendShortOk
// ============================================================
//  8i. トライアングル 環境認識モジュール 本体 (WinZone Triangle とは別)
// ------------------------------------------------------------
//  f_triangleEnvState : 呼ばれた足(=上位足)コンテキストで Pivot High / Low を別配列で保持し、
//    Ascending / Descending / Symmetrical Triangle 候補を探索する。品質最高の1候補を採用。
//    境界ラインを終値でブレイクした方向を最終バイアスにする (色で予想しない)。
//      ・上限上抜け → Long / 下限下抜け → Short (Asc下限=否定Short, Desc上限=否定Long)。
//      ・同一バー両方向確定 → bias=0。ライン交差後は即失効 (Reject 4)。候補競合 (Reject 1)。
//    ブレイク後 holdBars 本だけ bias を保持し、反対方向の新ブレイクで即上書き。
//    追加イベント (Retest / FakeBreak / Invalidation) は triangleEnvEventMode で選択。
//    Building / Pattern / Quality 成立だけでは bias を出さない。
//  戻り値 (27要素):
//    [bias, reason, remain, quality, triangleType, eventType, upperSlopeATR, lowerSlopeATR,
//     widthStart, widthNow, contractionRatio, patternBars, upP1P, upP1T, upP2P, upP2T,
//     loP1P, loP1T, loP2P, loP2T, upperLineNow, lowerLineNow, breakPrice, breakTime,
//     rejectionCode, upBreakP, loBreakP]
//    triangleType : 1=Ascending / 2=Descending / 3=Symmetrical / 0=None
//    reason  : 1=Upper Break(Long) / -1=Lower Break(Short) / 2=Lower Fake→Long / -2=Upper Fake→Short
//              3=Upper Retest→Long / -3=Lower Retest→Short / 0=none
//    eventType: 1=Break / 2=Retest / 3=FakeBreak / 4=Invalidation / 0=none
//    rejectionCode: 1=Conflict / 3=Timeout / 4=LineCross / 0=none
// ============================================================

// x2==x1 を避けたライン価格 / 傾き
f_triangleEnvLinePrice(int _x1, float _y1, int _x2, float _y2, int _xNow) =>
    float _res = na
    if _x2 != _x1
        float _slope = (_y2 - _y1) / (_x2 - _x1)
        _res := _y1 + _slope * (_xNow - _x1)
    _res

f_triangleEnvSlope(int _x1, float _y1, int _x2, float _y2) =>
    _x2 != _x1 ? (_y2 - _y1) / (_x2 - _x1) : na

// 水平判定 (Percent / ATR / PercentOrATR / PercentAndATR)。2つの端点価格が水平とみなせるか。
f_triangleEnvHorizOk(float _a, float _b, float _atr) =>
    float _diff = math.abs(_a - _b)
    bool _pctOk = _a != 0 and (_diff / _a) <= triangleEnvTolerancePct
    bool _atrOk = _atr > 0 and _diff <= _atr * triangleEnvToleranceATR
    triangleEnvHorizontalMode == "Percent"       ? _pctOk :
     triangleEnvHorizontalMode == "ATR"          ? _atrOk :
     triangleEnvHorizontalMode == "PercentOrATR" ? (_pctOk or _atrOk) :
     (_pctOk and _atrOk)

// Pivotを時系列で保持 (同一付近ノイズのみ除外・切上/切下構造を残す)。上限超は最古削除。
f_triangleEnvPush(array<float> _p, array<int> _b, array<int> _t, float _price, int _bar, int _time, float _atr) =>
    int _n = array.size(_p)
    if _n == 0
        array.push(_p, _price)
        array.push(_b, _bar)
        array.push(_t, _time)
    else
        float _last = array.get(_p, _n - 1)
        if math.abs(_price - _last) >= _atr * triangleEnvNoiseATR
            array.push(_p, _price)
            array.push(_b, _bar)
            array.push(_t, _time)
    while array.size(_p) > triangleEnvMaxPivots
        array.shift(_p)
        array.shift(_b)
        array.shift(_t)

// 候補スコア (0-100)。lineP = 種類別ライン精度点(0-25)。
f_triangleEnvScore(int _touchHi, int _touchLo, float _avgErr, float _atr, float _wStart, float _wNow, int _patBars, float _lineP) =>
    float _touchPts = math.min(20.0, (_touchHi + _touchLo) * 4.0)
    float _errPts = _atr > 0 ? math.max(0.0, 15.0 - (_avgErr / _atr) * 15.0) : 0.0
    float _ratio = (not na(_wStart) and _wStart > 0 and not na(_wNow)) ? _wNow / _wStart : 1.0
    float _contrPts = math.min(20.0, math.max(0.0, (1.0 - _ratio) / math.max(1.0 - triangleEnvContractionRatio, 0.01) * 20.0))
    float _mid = (triangleEnvMinPatternBars + triangleEnvMaxPatternBars) / 2.0
    float _barPts = _mid > 0 ? math.max(0.0, 10.0 * (1.0 - math.abs(_patBars - _mid) / _mid)) : 0.0
    float _crossPts = math.min(10.0, math.max(0.0, (1.0 - _ratio) * 10.0))
    math.min(100.0, _touchPts + _errPts + _contrPts + _barPts + _crossPts + math.min(25.0, math.max(0.0, _lineP)))

f_triangleEnvState(int holdBars) =>
    float _atr = ta.atr(14)
    float _atrAvg = ta.sma(_atr, triangleEnvAtrExpandLen)
    // --- Pivot配列 (High / Low を別々に) ---
    var array<float> _phP = array.new_float()
    var array<int>   _phB = array.new_int()
    var array<int>   _phT = array.new_int()
    var array<float> _plP = array.new_float()
    var array<int>   _plB = array.new_int()
    var array<int>   _plT = array.new_int()
    float _ph = ta.pivothigh(high, triangleEnvPivotLen, triangleEnvPivotLen)
    float _pl = ta.pivotlow(low, triangleEnvPivotLen, triangleEnvPivotLen)
    bool _newHigh = not na(_ph)
    bool _newLow  = not na(_pl)
    if _newHigh
        f_triangleEnvPush(_phP, _phB, _phT, _ph, bar_index - triangleEnvPivotLen, time[triangleEnvPivotLen], _atr)
    if _newLow
        f_triangleEnvPush(_plP, _plB, _plT, _pl, bar_index - triangleEnvPivotLen, time[triangleEnvPivotLen], _atr)

    // --- 採用候補 状態 (種類混線なし・1候補) ---
    var bool  _active = false
    var int   _type   = 0
    var float _upP1 = na
    var int   _upB1 = na
    var int   _upT1 = na
    var float _upP2 = na
    var int   _upB2 = na
    var int   _upT2 = na
    var float _loP1 = na
    var int   _loB1 = na
    var int   _loT1 = na
    var float _loP2 = na
    var int   _loB2 = na
    var int   _loT2 = na
    var float _upSlope = na
    var float _loSlope = na
    var float _wStart  = na
    var int   _formBar = na
    var float _quality = na
    var int   _patBars = 0
    var int   _touchHiV = 0
    var int   _touchLoV = 0
    // ブレイク / Fake トラッキング
    var int   _brokeDir = 0
    var int   _brokeBar = na
    var bool  _fakeUpArmed = false
    var int   _fakeUpBar   = na
    var bool  _fakeLoArmed = false
    var int   _fakeLoBar   = na
    // --- バイアス保持 状態 ---
    var int   _bias = 0
    var int   _reason = 0
    var int   _eventType = 0
    var int   _evbar = na
    // --- 最新確定パターン アンカー (描画用・確定後も保持) ---
    var int   _oType = 0
    var float _oUpP1 = na
    var int   _oUpT1 = na
    var float _oUpP2 = na
    var int   _oUpT2 = na
    var float _oLoP1 = na
    var int   _oLoT1 = na
    var float _oLoP2 = na
    var int   _oLoT2 = na
    var float _oBreakP = na
    var int   _oBreakT = na
    var float _oUpBrkP = na
    var float _oLoBrkP = na
    var float _oQuality = na
    var int   _oReason = 0
    var float _oUpSlopeATR = na
    var float _oLoSlopeATR = na
    var float _oWStart = na
    var float _oWNow = na
    var float _oContraction = na
    var int   _oPatBars = 0
    int _rej = 0

    int _nH = array.size(_phP)
    int _nL = array.size(_plP)
    float _touchTol = _atr * triangleEnvTouchToleranceATR

    // --- 候補探索 (新しいPivotが出た時のみ・右端は最新の高値/安値) ---
    if (_newHigh or _newLow) and _nH >= 2 and _nL >= 2
        int   _kH = _nH - 1
        int   _kL = _nL - 1
        float _h2 = array.get(_phP, _kH)
        int   _h2b = array.get(_phB, _kH)
        int   _h2t = array.get(_phT, _kH)
        float _l2 = array.get(_plP, _kL)
        int   _l2b = array.get(_plB, _kL)
        int   _l2t = array.get(_plT, _kL)
        float _bestScore = na
        int   _bestType  = 0
        float _secondBest = na
        // 採用候補の一時保持
        float _cUpP1 = na
        int   _cUpB1 = na
        int   _cUpT1 = na
        float _cLoP1 = na
        int   _cLoB1 = na
        int   _cLoT1 = na
        float _cUpSlope = na
        float _cLoSlope = na
        float _cWStart = na
        int   _cPatBars = 0
        int   _cTouchHi = 0
        int   _cTouchLo = 0
        float _cQual = na
        for _i = 0 to _kH - 1
            float _h1 = array.get(_phP, _i)
            int   _h1b = array.get(_phB, _i)
            int   _h1t = array.get(_phT, _i)
            for _a = 0 to _kL - 1
                float _l1 = array.get(_plP, _a)
                int   _l1b = array.get(_plB, _a)
                int   _l1t = array.get(_plT, _a)
                float _upSl = f_triangleEnvSlope(_h1b, _h1, _h2b, _h2)
                float _loSl = f_triangleEnvSlope(_l1b, _l1, _l2b, _l2)
                if not na(_upSl) and not na(_loSl)
                    bool _upHoriz = f_triangleEnvHorizOk(_h1, _h2, _atr)
                    bool _loHoriz = f_triangleEnvHorizOk(_l1, _l2, _atr)
                    bool _isAsc  = _upHoriz and _loSl > 0
                    bool _isDesc = _loHoriz and _upSl < 0
                    bool _isSym  = _upSl < 0 and _loSl > 0 and not _upHoriz and not _loHoriz
                    if _isAsc or _isDesc or _isSym
                        int _startX = math.min(_h1b, _l1b)
                        int _rightX = math.max(_h2b, _l2b)
                        float _upStart = f_triangleEnvLinePrice(_h1b, _h1, _h2b, _h2, _startX)
                        float _loStart = f_triangleEnvLinePrice(_l1b, _l1, _l2b, _l2, _startX)
                        float _upNw = f_triangleEnvLinePrice(_h1b, _h1, _h2b, _h2, bar_index)
                        float _loNw = f_triangleEnvLinePrice(_l1b, _l1, _l2b, _l2, bar_index)
                        float _wS = (not na(_upStart) and not na(_loStart)) ? _upStart - _loStart : na
                        float _wN = (not na(_upNw) and not na(_loNw)) ? _upNw - _loNw : na
                        int   _pB = _rightX - _startX
                        bool _widthOk = not na(_wS) and not na(_wN) and _wS > 0 and _wN > 0 and _upNw > _loNw and _wN <= _wS * triangleEnvContractionRatio
                        bool _barsOk = _pB >= triangleEnvMinPatternBars and _pB <= triangleEnvMaxPatternBars
                        if _widthOk and _barsOk
                            int _tHi = 0
                            float _eHi = 0.0
                            for _m = 0 to _nH - 1
                                int _mb = array.get(_phB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_triangleEnvLinePrice(_h1b, _h1, _h2b, _h2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_phP, _m) - _lv)
                                        _eHi += _e
                                        if _e <= _touchTol
                                            _tHi += 1
                            int _tLo = 0
                            float _eLo = 0.0
                            for _m = 0 to _nL - 1
                                int _mb = array.get(_plB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_triangleEnvLinePrice(_l1b, _l1, _l2b, _l2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_plP, _m) - _lv)
                                        _eLo += _e
                                        if _e <= _touchTol
                                            _tLo += 1
                            bool _touchOk = _tHi >= triangleEnvMinTouches and _tLo >= triangleEnvMinTouches
                            if _touchOk
                                float _avgE = (_eHi + _eLo) / math.max(_tHi + _tLo, 1)
                                // ライン精度点: Asc=上限水平精度, Desc=下限水平精度, Sym=傾き対称
                                float _lineP = 0.0
                                if _isAsc
                                    _lineP := (_h1 != 0 and triangleEnvTolerancePct > 0) ? math.max(0.0, 25.0 * (1.0 - (math.abs(_h1 - _h2) / _h1) / triangleEnvTolerancePct)) : 12.0
                                else if _isDesc
                                    _lineP := (_l1 != 0 and triangleEnvTolerancePct > 0) ? math.max(0.0, 25.0 * (1.0 - (math.abs(_l1 - _l2) / _l1) / triangleEnvTolerancePct)) : 12.0
                                else
                                    _lineP := (math.abs(_upSl) + math.abs(_loSl)) > 0 ? 25.0 * (1.0 - math.abs(math.abs(_upSl) - math.abs(_loSl)) / (math.abs(_upSl) + math.abs(_loSl))) : 0.0
                                float _sc = f_triangleEnvScore(_tHi, _tLo, _avgE, _atr, _wS, _wN, _pB, _lineP)
                                int _ty = _isAsc ? 1 : _isDesc ? 2 : 3
                                if na(_bestScore) or _sc > _bestScore
                                    _secondBest := _bestScore
                                    _bestScore := _sc
                                    _bestType := _ty
                                    _cUpP1 := _h1
                                    _cUpB1 := _h1b
                                    _cUpT1 := _h1t
                                    _cLoP1 := _l1
                                    _cLoB1 := _l1b
                                    _cLoT1 := _l1t
                                    _cUpSlope := _upSl
                                    _cLoSlope := _loSl
                                    _cWStart := _wS
                                    _cPatBars := _pB
                                    _cTouchHi := _tHi
                                    _cTouchLo := _tLo
                                    _cQual := _sc
                                else if na(_secondBest) or _sc > _secondBest
                                    _secondBest := _sc
        // 候補競合: 最良と次点が完全同点 (rej=1)。品質フィルターも適用。
        bool _qualOk = not useTriangleEnvQualityFilter or (not na(_cQual) and _cQual >= triangleEnvMinQuality)
        if _bestType != 0 and not na(_bestScore) and (na(_secondBest) or _bestScore > _secondBest) and _qualOk
            _active := true
            _type := _bestType
            _upP1 := _cUpP1
            _upB1 := _cUpB1
            _upT1 := _cUpT1
            _upP2 := _h2
            _upB2 := _h2b
            _upT2 := _h2t
            _loP1 := _cLoP1
            _loB1 := _cLoB1
            _loT1 := _cLoT1
            _loP2 := _l2
            _loB2 := _l2b
            _loT2 := _l2t
            _upSlope := _cUpSlope
            _loSlope := _cLoSlope
            _wStart := _cWStart
            _formBar := bar_index
            _quality := _cQual
            _patBars := _cPatBars
            _touchHiV := _cTouchHi
            _touchLoV := _cTouchLo
            // 新候補 → ブレイク/Fake 判定を再有効化
            _brokeDir := 0
            _brokeBar := na
            _fakeUpArmed := false
            _fakeLoArmed := false
        else if _bestType != 0 and not na(_bestScore) and not na(_secondBest) and _bestScore == _secondBest
            _active := false
            _rej := 1

    // --- 現在バーへライン延長 ---
    float _upperLineNow = _active ? f_triangleEnvLinePrice(_upB1, _upP1, _upB2, _upP2, bar_index) : na
    float _lowerLineNow = _active ? f_triangleEnvLinePrice(_loB1, _loP1, _loB2, _loP2, bar_index) : na
    float _widthNow = (not na(_upperLineNow) and not na(_lowerLineNow)) ? _upperLineNow - _lowerLineNow : na
    float _contraction = (not na(_wStart) and _wStart > 0 and not na(_widthNow)) ? _widthNow / _wStart : na
    float _upSlopeATRout = (_active and _atr > 0 and not na(_upSlope)) ? _upSlope / _atr : na
    float _loSlopeATRout = (_active and _atr > 0 and not na(_loSlope)) ? _loSlope / _atr : na

    // --- ライン交差失効 / ブレイク期限 ---
    bool _linesValidNow = not na(_upperLineNow) and not na(_lowerLineNow) and not na(_widthNow) and _widthNow > 0 and _upperLineNow > _lowerLineNow
    if _active
        if not _linesValidNow
            _active := false
            _rej := 4
        else if _brokeDir == 0 and not na(_formBar) and (bar_index - _formBar) > triangleEnvBreakMaxBars
            _active := false
            _rej := 3

    // --- ブレイク足フィルター ---
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool  _bodyOk = not useTriangleEnvBodyFilter or (_rng > 0 and (_body / _rng) >= triangleEnvMinBodyRatio)
    bool  _volOk  = not useTriangleEnvATRExpansion or (not na(_atrAvg) and _atr > _atrAvg * triangleEnvAtrExpandMult)
    bool  _upColorOk = not useTriangleEnvBreakCandleColor or close > open
    bool  _loColorOk = not useTriangleEnvBreakCandleColor or close < open

    // --- ブレイク検出 (candidate active・未ブレイク) ---
    bool _upperBreak = _active and _brokeDir == 0 and _linesValidNow and close > _upperLineNow + _atr * triangleEnvBreakBufferATR and _bodyOk and _upColorOk and _volOk
    bool _lowerBreak = _active and _brokeDir == 0 and _linesValidNow and close < _lowerLineNow - _atr * triangleEnvBreakBufferATR and _bodyOk and _loColorOk and _volOk
    // 種類別 方向マッピング (Break / Invalidation)
    bool _breakLong  = (_upperBreak and (_type == 1 or _type == 3))
    bool _breakShort = (_lowerBreak and (_type == 2 or _type == 3))
    bool _invalLong  = (_upperBreak and _type == 2)   // Descending 上限否定 → Long
    bool _invalShort = (_lowerBreak and _type == 1)   // Ascending 下限否定 → Short

    // --- FakeBreak (poke して戻る。未ブレイクのみ) ---
    if _active and _brokeDir == 0 and _linesValidNow and high > _upperLineNow + _atr * triangleEnvBreakBufferATR and close <= _upperLineNow
        _fakeUpArmed := true
        _fakeUpBar := bar_index
    if _active and _brokeDir == 0 and _linesValidNow and low < _lowerLineNow - _atr * triangleEnvBreakBufferATR and close >= _lowerLineNow
        _fakeLoArmed := true
        _fakeLoBar := bar_index
    bool _fakeUpReturn = _fakeUpArmed and _active and not na(_upperLineNow) and close < _upperLineNow and not na(_fakeUpBar) and (bar_index - _fakeUpBar) <= triangleEnvFakeBreakBars and (not useTriangleEnvReversalCandle or close < open)
    bool _fakeLoReturn = _fakeLoArmed and _active and not na(_lowerLineNow) and close > _lowerLineNow and not na(_fakeLoBar) and (bar_index - _fakeLoBar) <= triangleEnvFakeBreakBars and (not useTriangleEnvReversalCandle or close > open)
    if _fakeUpArmed and not na(_fakeUpBar) and (bar_index - _fakeUpBar) > triangleEnvFakeBreakBars
        _fakeUpArmed := false
    if _fakeLoArmed and not na(_fakeLoBar) and (bar_index - _fakeLoBar) > triangleEnvFakeBreakBars
        _fakeLoArmed := false
    bool _fakeLong  = _fakeLoReturn   // 下限ダマシ → Long
    bool _fakeShort = _fakeUpReturn   // 上限ダマシ → Short

    // --- Retest (ブレイク後・同方向) ---
    float _retTol = _atr * triangleEnvRetestATR
    bool _retestLong  = _active and _brokeDir == 1 and not na(_brokeBar) and (bar_index - _brokeBar) <= triangleEnvRetestMaxBars and not na(_upperLineNow) and low <= _upperLineNow + _retTol and close >= _upperLineNow and (not useTriangleEnvReversalCandle or close > open)
    bool _retestShort = _active and _brokeDir == -1 and not na(_brokeBar) and (bar_index - _brokeBar) <= triangleEnvRetestMaxBars and not na(_lowerLineNow) and high >= _lowerLineNow - _retTol and close <= _lowerLineNow and (not useTriangleEnvReversalCandle or close < open)

    // --- ブレイクフラグ更新 (1候補1ブレイク) ---
    if _upperBreak
        _brokeDir := 1
        _brokeBar := bar_index
    if _lowerBreak
        _brokeDir := -1
        _brokeBar := bar_index

    // --- eventMode で確定イベント方向を決定 ---
    bool _cBreakLong  = _breakLong  or _invalLong
    bool _cBreakShort = _breakShort or _invalShort
    bool _confLong = triangleEnvEventMode == "BreakOnly" ? _cBreakLong : triangleEnvEventMode == "BreakOrRetest" ? (_cBreakLong or _retestLong) : triangleEnvEventMode == "FakeBreakOnly" ? _fakeLong : triangleEnvEventMode == "InvalidationOnly" ? _invalLong : (_cBreakLong or _retestLong or _fakeLong)
    bool _confShort = triangleEnvEventMode == "BreakOnly" ? _cBreakShort : triangleEnvEventMode == "BreakOrRetest" ? (_cBreakShort or _retestShort) : triangleEnvEventMode == "FakeBreakOnly" ? _fakeShort : triangleEnvEventMode == "InvalidationOnly" ? _invalShort : (_cBreakShort or _retestShort or _fakeShort)

    // --- イベント確定 (同一バー両方向 → Even) ---
    if _confLong and _confShort
        _bias := 0
        _reason := 0
        _eventType := 0
        _evbar := na
        _rej := 1
    else if _confLong or _confShort
        int _dir = _confLong ? 1 : -1
        int _rsn = _confLong ? ((_breakLong or _invalLong) ? 1 : _fakeLong ? 2 : 3) : ((_breakShort or _invalShort) ? -1 : _fakeShort ? -2 : -3)
        int _evt = (_confLong and (_breakLong or _invalLong)) or (_confShort and (_breakShort or _invalShort)) ? ((_invalLong or _invalShort) and not (_breakLong or _breakShort) ? 4 : 1) : (_confLong and _fakeLong) or (_confShort and _fakeShort) ? 3 : 2
        _bias := _dir
        _reason := _rsn
        _eventType := _evt
        _evbar := bar_index
        _oType := _type
        _oUpP1 := _upP1
        _oUpT1 := _upT1
        _oUpP2 := _upP2
        _oUpT2 := _upT2
        _oLoP1 := _loP1
        _oLoT1 := _loT1
        _oLoP2 := _loP2
        _oLoT2 := _loT2
        _oBreakP := close
        _oBreakT := time
        _oUpBrkP := _upperLineNow
        _oLoBrkP := _lowerLineNow
        _oQuality := _quality
        _oReason := _rsn
        _oUpSlopeATR := _upSlopeATRout
        _oLoSlopeATR := _loSlopeATRout
        _oWStart := _wStart
        _oWNow := _widthNow
        _oContraction := _contraction
        _oPatBars := _patBars

    // --- 状態保持 / 失効 ---
    bool _hold = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias   = _hold ? _bias : 0
    int _outReason = _hold ? _reason : 0
    int _outEvent  = _hold ? _eventType : 0
    int _outRemain = _hold ? holdBars - (bar_index - _evbar) : 0
    int _outType   = _hold ? _oType : (_active ? _type : 0)
    float _outQual = _hold ? _oQuality : _quality
    [_outBias, _outReason, _outRemain, _outQual, _outType, _outEvent, _upSlopeATRout, _loSlopeATRout, _wStart, _widthNow, _contraction, _patBars, _oUpP1, _oUpT1, _oUpP2, _oUpT2, _oLoP1, _oLoT1, _oLoP2, _oLoT2, _upperLineNow, _lowerLineNow, _oBreakP, _oBreakT, _rej, _oUpBrkP, _oLoBrkP]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_triangleEnvConfirmed(int holdBars) =>
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = f_triangleEnvState(holdBars)
    [_b[1], _r[1], _rem[1], _q[1], _ty[1], _ev[1], _us[1], _ls[1], _ws[1], _wn[1], _cr[1], _pb[1], _up1p[1], _up1t[1], _up2p[1], _up2t[1], _lo1p[1], _lo1t[1], _lo2p[1], _lo2t[1], _uln[1], _lln[1], _bp[1], _bt[1], _rj[1], _ubp[1], _lbp[1]]

// --- テキスト / カラー ---
f_triangleEnvText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_triangleEnvTypeText(int t) =>
    t == 1 ? "ASC" : t == 2 ? "DESC" : t == 3 ? "SYM" : "NONE"
f_triangleEnvReasonText(int c) =>
    c == 1 ? "Upper Break" : c == -1 ? "Lower Break" : c == 2 ? "Lower Fake" : c == -2 ? "Upper Fake" : c == 3 ? "Upper Retest" : c == -3 ? "Lower Retest" : "No Event"
f_triangleEnvColor(int b, bool on) =>
    not on ? color.new(color.black, 0) : b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- 各足の確定 トライアングル 環境状態 (使用 or 表示時のみ算出。OFF足は request.security を呼ばない) ---
bool triangleEnvWantDraw = triangleEnvShowPatternLines or triangleEnvShowPivotLabels or triangleEnvShowBreakLabel or triangleEnvShowHistory
bool triangleEnvCompute  = useTriangleEnvEnv and (useTriangleEnvBias or triangleEnvShowTable or triangleEnvWantDraw)
int triangleEnvD   = 0
int triangleEnv4H  = 0
int triangleEnv1H  = 0
int triangleEnv15M = 0
int triangleEnv5M  = 0
int triangleEnv1M  = 0
int triangleEnvDRem   = 0
int triangleEnv4HRem  = 0
int triangleEnv1HRem  = 0
int triangleEnv15MRem = 0
int triangleEnv5MRem  = 0
int triangleEnv1MRem  = 0
int triangleEnvDReason   = 0
int triangleEnv4HReason  = 0
int triangleEnv1HReason  = 0
int triangleEnv15MReason = 0
int triangleEnv5MReason  = 0
int triangleEnv1MReason  = 0
int triangleEnvDType   = 0
int triangleEnv4HType  = 0
int triangleEnv1HType  = 0
int triangleEnv15MType = 0
int triangleEnv5MType  = 0
int triangleEnv1MType  = 0
float triangleEnvDQual   = na
float triangleEnv4HQual  = na
float triangleEnv1HQual  = na
float triangleEnv15MQual = na
float triangleEnv5MQual  = na
float triangleEnv1MQual  = na
// ラベル描画用 (triangleEnvLabelTF の足のパターンアンカー + デバッグ値)
int   trLblType = 0
int   trLblReason = 0
int   trLblEvent = 0
float trLblUpP1 = na
int   trLblUpT1 = na
float trLblUpP2 = na
int   trLblUpT2 = na
float trLblLoP1 = na
int   trLblLoT1 = na
float trLblLoP2 = na
int   trLblLoT2 = na
float trLblBrkP = na
int   trLblBrkT = na
float trLblUpBrkP = na
float trLblLoBrkP = na
float trLblQual = na
float trLblUpSlopeATR = na
float trLblLoSlopeATR = na
float trLblWStart = na
float trLblWNow = na
float trLblContraction = na
int   trLblPatBars = 0
int   trLblRej = 0

if triangleEnvCompute and useTriangleEnvD
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, triangleEnvDailyTF, f_triangleEnvConfirmed(triangleEnvHoldDaily), lookahead = barmerge.lookahead_on)
    triangleEnvD := _b
    triangleEnvDRem := _rem
    triangleEnvDReason := _r
    triangleEnvDType := _ty
    triangleEnvDQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "D"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj
if triangleEnvCompute and useTriangleEnv4H
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, triangleEnv4HTF, f_triangleEnvConfirmed(triangleEnvHold4H), lookahead = barmerge.lookahead_on)
    triangleEnv4H := _b
    triangleEnv4HRem := _rem
    triangleEnv4HReason := _r
    triangleEnv4HType := _ty
    triangleEnv4HQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "4H"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj
if triangleEnvCompute and useTriangleEnv1H
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, triangleEnv1HTF, f_triangleEnvConfirmed(triangleEnvHold1H), lookahead = barmerge.lookahead_on)
    triangleEnv1H := _b
    triangleEnv1HRem := _rem
    triangleEnv1HReason := _r
    triangleEnv1HType := _ty
    triangleEnv1HQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "1H"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj
if triangleEnvCompute and useTriangleEnv15M
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, triangleEnv15MTF, f_triangleEnvConfirmed(triangleEnvHold15M), lookahead = barmerge.lookahead_on)
    triangleEnv15M := _b
    triangleEnv15MRem := _rem
    triangleEnv15MReason := _r
    triangleEnv15MType := _ty
    triangleEnv15MQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "15M"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj
if triangleEnvCompute and useTriangleEnv5M
    // 5分足はチャート足そのもの → request.security / f_triangleEnvConfirmed / [1] を使わず
    //   f_triangleEnvState をチャート上で直接計算する。最終エントリーの barstate.isconfirmed で
    //   「確定した現在の5分足」の状態を採用するため、1本余計に遅れない。
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = f_triangleEnvState(triangleEnvHold5M)
    triangleEnv5M := _b
    triangleEnv5MRem := _rem
    triangleEnv5MReason := _r
    triangleEnv5MType := _ty
    triangleEnv5MQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "5M"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj
if triangleEnvCompute and useTriangleEnv1M
    [_b, _r, _rem, _q, _ty, _ev, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, triangleEnv1MTF, f_triangleEnvConfirmed(triangleEnvHold1M), lookahead = barmerge.lookahead_on)
    triangleEnv1M := _b
    triangleEnv1MRem := _rem
    triangleEnv1MReason := _r
    triangleEnv1MType := _ty
    triangleEnv1MQual := _q
    if triangleEnvWantDraw and triangleEnvLabelTF == "1M"
        trLblType := _ty
        trLblReason := _r
        trLblEvent := _ev
        trLblUpP1 := _up1p
        trLblUpT1 := _up1t
        trLblUpP2 := _up2p
        trLblUpT2 := _up2t
        trLblLoP1 := _lo1p
        trLblLoT1 := _lo1t
        trLblLoP2 := _lo2p
        trLblLoT2 := _lo2t
        trLblBrkP := _bp
        trLblBrkT := _bt
        trLblUpBrkP := _ubp
        trLblLoBrkP := _lbp
        trLblQual := _q
        trLblUpSlopeATR := _us
        trLblLoSlopeATR := _ls
        trLblWStart := _ws
        trLblWNow := _wn
        trLblContraction := _cr
        trLblPatBars := _pb
        trLblRej := _rj

// --- 統合 (HigherTF: 上位足優先で最初の非ゼロ / WeightedScore: 重み合計を閾値判定・双方向) ---
int triangleEnvHigherTF =
     (useTriangleEnvD   and triangleEnvD   != 0) ? triangleEnvD   :
     (useTriangleEnv4H  and triangleEnv4H  != 0) ? triangleEnv4H  :
     (useTriangleEnv1H  and triangleEnv1H  != 0) ? triangleEnv1H  :
     (useTriangleEnv15M and triangleEnv15M != 0) ? triangleEnv15M :
     (useTriangleEnv5M  and triangleEnv5M  != 0) ? triangleEnv5M  :
     (useTriangleEnv1M  and triangleEnv1M  != 0) ? triangleEnv1M  : 0
int triangleEnvScoreVal = (useTriangleEnvD ? triangleEnvWeightD * triangleEnvD : 0) + (useTriangleEnv4H ? triangleEnvWeight4H * triangleEnv4H : 0) + (useTriangleEnv1H ? triangleEnvWeight1H * triangleEnv1H : 0) + (useTriangleEnv15M ? triangleEnvWeight15M * triangleEnv15M : 0) + (useTriangleEnv5M ? triangleEnvWeight5M * triangleEnv5M : 0) + (useTriangleEnv1M ? triangleEnvWeight1M * triangleEnv1M : 0)
int triangleEnvWeighted = triangleEnvScoreVal >= triangleEnvScoreThreshold ? 1 : triangleEnvScoreVal <= -triangleEnvScoreThreshold ? -1 : 0
int triangleEnvBias = not useTriangleEnvEnv ? 0 : triangleEnvCombineMode == "HigherTF" ? triangleEnvHigherTF : triangleEnvWeighted

// --- トレンド環境 (EMAスコア) と トライアングル環境 の結合 (方向別に明示) ---
//   useTriangleEnvBias=OFF or useTriangleEnvEnv=OFF → 完全素通し (既存=トレンドのみ)。
//   TrendOnly        : Long=trendLongOk        / Short=trendShortOk
//   TriangleOnly     : Long=triLong            / Short=triShort
//   TrendAndTriangle : Long=trendLongOk and triLong  / Short=trendShortOk and triShort
//   TrendOrTriangle  : Long=trendLongOk or  triLong  / Short=trendShortOk or  triShort
bool triangleEnvActive = useTriangleEnvEnv and useTriangleEnvBias
bool triLong  = triangleEnvBias == 1
bool triShort = triangleEnvBias == -1
bool finalEnvLongOk =
     not triangleEnvActive ? trendLongOk :
     triangleEnvTrendCombineMode == "TrendOnly"        ? trendLongOk :
     triangleEnvTrendCombineMode == "TriangleOnly"     ? triLong :
     triangleEnvTrendCombineMode == "TrendAndTriangle" ? (trendLongOk and triLong) :
     triangleEnvTrendCombineMode == "TrendOrTriangle"  ? (trendLongOk or triLong) :
     trendLongOk
bool finalEnvShortOk =
     not triangleEnvActive ? trendShortOk :
     triangleEnvTrendCombineMode == "TrendOnly"        ? trendShortOk :
     triangleEnvTrendCombineMode == "TriangleOnly"     ? triShort :
     triangleEnvTrendCombineMode == "TrendAndTriangle" ? (trendShortOk and triShort) :
     triangleEnvTrendCombineMode == "TrendOrTriangle"  ? (trendShortOk or triShort) :
     trendShortOk

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// --- ①② 可変 SL/TP 用 ATR (チャート足・エントリーは確定足のみ=非リペイント) ---
float slAtr = ta.atr(slAtrLen)
float tpAtr = ta.atr(tpAtrLen)

float longStop = slMode == "ATR" ? entryEst - slAtr * slAtrMult : slMode == "パターン" ? patLow - slBuf : entryEst - slFixed
float longRisk = entryEst - longStop
float longTP   = tpMode == "ATR" ? entryEst + tpAtr * tpAtrMult : entryEst + longRisk * rrRatio

float shortStop = slMode == "ATR" ? entryEst + slAtr * slAtrMult : slMode == "パターン" ? patHigh + slBuf : entryEst + slFixed
float shortRisk = shortStop - entryEst
float shortTP   = tpMode == "ATR" ? entryEst - tpAtr * tpAtrMult : entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + トライアングル)
// ------------------------------------------------------------
//  環境認識は finalEnvLongOk/finalEnvShortOk (EMAトレンド + トライアングル の結合結果)。
//  FVG / EMA / Stochastic / Fib / Volume / 三尊 / DT/DB / ウェッジ の各環境認識は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。トライアングル方向フィルターは主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if noTriggerMode
        shortArmed := false

// ============================================================
// ============================================================
//  12d. トライアングル 環境認識 表示 (テーブル + パターン描画 + Data Window)
// ============================================================
f_trRowType(bool _on, int _ty) =>
    _on ? f_triangleEnvTypeText(_ty) : "OFF"
f_trRowReason(bool _on, int _r) =>
    _on ? f_triangleEnvReasonText(_r) : "OFF"
f_trRowQual(bool _on, float _q) =>
    _on and not na(_q) ? str.tostring(_q, "#") : "-"

var table triangleEnvTbl = na
if triangleEnvShowTable
    if na(triangleEnvTbl)
        triangleEnvTbl := table.new(position.bottom_left, 6, 18, border_width = 1)
    if barstate.islast
        table.cell(triangleEnvTbl, 0, 0, "Triangle", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 1, 0, "Bias",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 0, "Type",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 3, 0, "Reason", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 4, 0, "残",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 5, 0, "Qual",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(triangleEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 1, useTriangleEnvD ? f_triangleEnvText(triangleEnvD) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnvD, useTriangleEnvD), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 1, f_trRowType(useTriangleEnvD, triangleEnvDType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 1, f_trRowReason(useTriangleEnvD, triangleEnvDReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 1, useTriangleEnvD ? str.tostring(triangleEnvDRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 1, f_trRowQual(useTriangleEnvD, triangleEnvDQual), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 2, useTriangleEnv4H ? f_triangleEnvText(triangleEnv4H) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnv4H, useTriangleEnv4H), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 2, f_trRowType(useTriangleEnv4H, triangleEnv4HType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 2, f_trRowReason(useTriangleEnv4H, triangleEnv4HReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 2, useTriangleEnv4H ? str.tostring(triangleEnv4HRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 2, f_trRowQual(useTriangleEnv4H, triangleEnv4HQual), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 3, useTriangleEnv1H ? f_triangleEnvText(triangleEnv1H) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnv1H, useTriangleEnv1H), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 3, f_trRowType(useTriangleEnv1H, triangleEnv1HType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 3, f_trRowReason(useTriangleEnv1H, triangleEnv1HReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 3, useTriangleEnv1H ? str.tostring(triangleEnv1HRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 3, f_trRowQual(useTriangleEnv1H, triangleEnv1HQual), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 4, useTriangleEnv15M ? f_triangleEnvText(triangleEnv15M) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnv15M, useTriangleEnv15M), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 4, f_trRowType(useTriangleEnv15M, triangleEnv15MType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 4, f_trRowReason(useTriangleEnv15M, triangleEnv15MReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 4, useTriangleEnv15M ? str.tostring(triangleEnv15MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 4, f_trRowQual(useTriangleEnv15M, triangleEnv15MQual), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 5, useTriangleEnv5M ? f_triangleEnvText(triangleEnv5M) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnv5M, useTriangleEnv5M), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 5, f_trRowType(useTriangleEnv5M, triangleEnv5MType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 5, f_trRowReason(useTriangleEnv5M, triangleEnv5MReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 5, useTriangleEnv5M ? str.tostring(triangleEnv5MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 5, f_trRowQual(useTriangleEnv5M, triangleEnv5MQual), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 6, useTriangleEnv1M ? f_triangleEnvText(triangleEnv1M) : "OFF", text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnv1M, useTriangleEnv1M), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 6, f_trRowType(useTriangleEnv1M, triangleEnv1MType), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 6, f_trRowReason(useTriangleEnv1M, triangleEnv1MReason), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 6, useTriangleEnv1M ? str.tostring(triangleEnv1MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 6, f_trRowQual(useTriangleEnv1M, triangleEnv1MQual), text_color = color.white, text_size = size.small)
        // 統合 Bias
        table.cell(triangleEnvTbl, 0, 7, "COMBINED", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 7, f_triangleEnvText(triangleEnvBias), text_color = color.white, bgcolor = f_triangleEnvColor(triangleEnvBias, useTriangleEnvEnv), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 7, triangleEnvCombineMode == "HigherTF" ? "HTF" : "WScore", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 7, "Score", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 7, str.tostring(triangleEnvScoreVal), text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 7, "", text_color = color.white, text_size = size.small)
        // Event Mode
        table.cell(triangleEnvTbl, 0, 8, "EventMode", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 8, triangleEnvEventMode, text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 2, 8, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 8, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 8, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 8, "", text_color = color.white, text_size = size.small)
        // Trend Combine
        table.cell(triangleEnvTbl, 0, 9, "TrendComb", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 9, triangleEnvTrendCombineMode, text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 2, 9, useTriangleEnvBias ? "Bias:ON" : "Bias:OFF", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 9, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 9, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 9, "", text_color = color.white, text_size = size.small)
        // Final Long / Short
        table.cell(triangleEnvTbl, 0, 10, "Final Long", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 10, finalEnvLongOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvLongOk ? color.new(color.green, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 10, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 10, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 10, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 10, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 0, 11, "Final Short", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 1, 11, finalEnvShortOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvShortOk ? color.new(color.red, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(triangleEnvTbl, 2, 11, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 3, 11, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 4, 11, "", text_color = color.white, text_size = size.small)
        table.cell(triangleEnvTbl, 5, 11, "", text_color = color.white, text_size = size.small)
        // デバッグ (triangleEnvLabelTF の採用パターン値)
        if triangleEnvShowDebug
            table.cell(triangleEnvTbl, 0, 12, "UpSlopeATR", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 12, na(trLblUpSlopeATR) ? "-" : str.tostring(trLblUpSlopeATR, "#.###"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 12, "LoSlopeATR", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 12, na(trLblLoSlopeATR) ? "-" : str.tostring(trLblLoSlopeATR, "#.###"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 12, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 12, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 0, 13, "WidthStart", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 13, na(trLblWStart) ? "-" : str.tostring(trLblWStart, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 13, "WidthNow", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 13, na(trLblWNow) ? "-" : str.tostring(trLblWNow, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 13, "Contr", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 13, na(trLblContraction) ? "-" : str.tostring(trLblContraction, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 0, 14, "PatBars", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 14, str.tostring(trLblPatBars), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 14, "Quality", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 14, na(trLblQual) ? "-" : str.tostring(trLblQual, "#"), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 14, "Rej", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 14, str.tostring(trLblRej), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 0, 15, "LabelTF/Type", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 15, triangleEnvLabelTF, text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 15, f_triangleEnvTypeText(trLblType), text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 15, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 15, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 15, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 0, 16, "TouchesU/L", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 16, "-", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 16, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 16, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 16, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 16, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 0, 17, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 1, 17, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 2, 17, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 3, 17, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 4, 17, "", text_color = color.white, text_size = size.small)
            table.cell(triangleEnvTbl, 5, 17, "", text_color = color.white, text_size = size.small)

// --- Data Window 出力 ---
plot(useTriangleEnvEnv ? triangleEnvScoreVal : na, "triangleEnvScore", display = display.data_window)
plot(useTriangleEnvEnv ? triangleEnvBias : na, "triangleEnvBias", display = display.data_window)
plot(finalEnvLongOk  ? 1 : 0, "finalEnvLongOk",  display = display.data_window)
plot(finalEnvShortOk ? 1 : 0, "finalEnvShortOk", display = display.data_window)

// --- 採用パターン描画 (triangleEnvLabelTF・時刻アンカー。表示専用・検知/エントリー不変) ---
//   上限ライン (UpP1→UpBrk) / 下限ライン (LoP1→LoBrk) をブレイク地点まで延長。種類ラベル ASC/DESC/SYM。
//   line/label は最新パターンだけを更新 (上限を消費しない)。
var line  trLnUpper = na
var line  trLnLower = na
var label trLbType  = na
var label trLbBrk   = na
var label trLbUp    = na
var label trLbLo    = na

if barstate.islast
    if not na(trLnUpper)
        line.delete(trLnUpper)
        trLnUpper := na
    if not na(trLnLower)
        line.delete(trLnLower)
        trLnLower := na
    if not na(trLbType)
        label.delete(trLbType)
        trLbType := na
    if not na(trLbBrk)
        label.delete(trLbBrk)
        trLbBrk := na
    if not na(trLbUp)
        label.delete(trLbUp)
        trLbUp := na
    if not na(trLbLo)
        label.delete(trLbLo)
        trLbLo := na
    bool _trDoDraw = triangleEnvWantDraw and trLblType != 0 and trLblReason != 0 and not na(trLblUpP1) and not na(trLblLoP1) and not na(trLblBrkT)
    if _trDoDraw
        color _upCol = color.new(color.red, 0)
        color _loCol = color.new(color.green, 0)
        // トライアングルライン (上限: UpP1 → ブレイク地点 / 下限: LoP1 → ブレイク地点)
        if triangleEnvShowPatternLines
            if not na(trLblUpBrkP)
                trLnUpper := line.new(trLblUpT1, trLblUpP1, trLblBrkT, trLblUpBrkP, xloc = xloc.bar_time, color = _upCol, width = triangleEnvPatternLineWidth)
            if not na(trLblLoBrkP)
                trLnLower := line.new(trLblLoT1, trLblLoP1, trLblBrkT, trLblLoBrkP, xloc = xloc.bar_time, color = _loCol, width = triangleEnvPatternLineWidth)
        // 採用Pivot / 種類ラベル
        if triangleEnvShowPivotLabels
            trLbUp := label.new(trLblUpT1, trLblUpP1, "H1", xloc = xloc.bar_time, style = label.style_label_down, yloc = yloc.abovebar, color = _upCol, textcolor = color.white, size = size.small)
            trLbLo := label.new(trLblLoT1, trLblLoP1, "L1", xloc = xloc.bar_time, style = label.style_label_up, yloc = yloc.belowbar, color = _loCol, textcolor = color.white, size = size.small)
            trLbType := label.new(trLblBrkT, trLblBrkP, f_triangleEnvTypeText(trLblType), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
        // ブレイク確定ラベル (Triangle Upper/Lower Break 等)
        if triangleEnvShowBreakLabel and not na(trLblBrkP)
            bool _isLong = trLblReason > 0
            string _bl = "Triangle " + f_triangleEnvReasonText(trLblReason)
            trLbBrk := label.new(trLblBrkT, trLblBrkP, _bl, xloc = xloc.bar_time, style = _isLong ? label.style_label_up : label.style_label_down, yloc = _isLong ? yloc.belowbar : yloc.abovebar, color = _isLong ? _loCol : _upCol, textcolor = color.white, size = size.small)

// --- 過去パターン履歴表示 (triangleEnvLabelTF・件数上限。ON/OFF可能) ---
var array<int>   trHistType  = array.new_int()
var array<int>   trHistReason = array.new_int()
var array<float> trHistUpP1  = array.new_float()
var array<int>   trHistUpT1  = array.new_int()
var array<float> trHistUpBrk = array.new_float()
var array<float> trHistLoP1  = array.new_float()
var array<int>   trHistLoT1  = array.new_int()
var array<float> trHistLoBrk = array.new_float()
var array<int>   trHistBrkT  = array.new_int()

bool trHistActive = triangleEnvShowHistory and triangleEnvWantDraw
bool trNewBreak =
     trHistActive and
     trLblType != 0 and
     trLblReason != 0 and
     not na(trLblBrkT) and
     (na(trLblBrkT[1]) or trLblBrkT != trLblBrkT[1])
if trNewBreak
    array.push(trHistType, trLblType)
    array.push(trHistReason, trLblReason)
    array.push(trHistUpP1, trLblUpP1)
    array.push(trHistUpT1, trLblUpT1)
    array.push(trHistUpBrk, trLblUpBrkP)
    array.push(trHistLoP1, trLblLoP1)
    array.push(trHistLoT1, trLblLoT1)
    array.push(trHistLoBrk, trLblLoBrkP)
    array.push(trHistBrkT, trLblBrkT)
    while array.size(trHistBrkT) > triangleEnvHistoryCount
        array.shift(trHistType)
        array.shift(trHistReason)
        array.shift(trHistUpP1)
        array.shift(trHistUpT1)
        array.shift(trHistUpBrk)
        array.shift(trHistLoP1)
        array.shift(trHistLoT1)
        array.shift(trHistLoBrk)
        array.shift(trHistBrkT)

var array<line> trHistLines = array.new_line()
if barstate.islast
    if array.size(trHistLines) > 0
        for _i = 0 to array.size(trHistLines) - 1
            line.delete(array.get(trHistLines, _i))
        array.clear(trHistLines)
    if trHistActive and array.size(trHistBrkT) > 0
        for _i = 0 to array.size(trHistBrkT) - 1
            int   _rsn = array.get(trHistReason, _i)
            float _up1 = array.get(trHistUpP1, _i)
            int   _ut1 = array.get(trHistUpT1, _i)
            float _ubk = array.get(trHistUpBrk, _i)
            float _lp1 = array.get(trHistLoP1, _i)
            int   _lt1 = array.get(trHistLoT1, _i)
            float _lbk = array.get(trHistLoBrk, _i)
            int   _bkt = array.get(trHistBrkT, _i)
            if not na(_up1) and not na(_lp1) and not na(_bkt)
                color _hc = _rsn > 0 ? color.new(color.green, triangleEnvHistoryLineTransp) : color.new(color.red, triangleEnvHistoryLineTransp)
                if not na(_ubk)
                    array.push(trHistLines, line.new(_ut1, _up1, _bkt, _ubk, xloc = xloc.bar_time, color = _hc, width = 1))
                if not na(_lbk)
                    array.push(trHistLines, line.new(_lt1, _lp1, _bkt, _lbk, xloc = xloc.bar_time, color = _hc, width = 1))
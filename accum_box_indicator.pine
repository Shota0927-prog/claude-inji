//@version=5
indicator("Accum Box Indicator", overlay=true, max_boxes_count=500)

// =====================================================
// Inputs
// =====================================================
groupAccum = "01. Accumulation 判定"
groupDisp  = "02. 表示 / アラート"

accumRangeLen        = input.int(10,   "Accum判定レンジ本数",        minval=6,   group=groupAccum)
accumBaseLen         = input.int(20,   "基準平均本数",              minval=10,  group=groupAccum)
accumAtrLen          = input.int(14,   "ATR本数",                  minval=1,   group=groupAccum)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",       minval=1,   group=groupAccum)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",       minval=1,   group=groupAccum)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",            minval=1,   group=groupAccum)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",       minval=0.5,  step=0.1,  group=groupAccum)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",    minval=0.1,  step=0.01, group=groupAccum)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",             minval=0.05, maxval=1.0, step=0.05, group=groupAccum)

showAccumBox   = input.bool(true, "Accumボックス表示", group=groupDisp)
accumBoxColor  = input.color(color.new(color.yellow, 85), "Accum背景色", group=groupDisp)
accumBoxBorder = input.color(color.new(color.yellow, 30), "Accum枠色",   group=groupDisp)
enableAlert    = input.bool(true, "新規アキュム検出でアラート", group=groupDisp)

// =====================================================
// Accumulation core detection
// =====================================================
f_is_accum_core(_atrMult, _barRatioMax, _driftMax) =>
    _atr = ta.atr(accumAtrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * _atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, accumRangeLen) - ta.lowest(_bodyBotNow, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, accumBaseLen)  - ta.lowest(_bodyBotNow, accumBaseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _barRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _driftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    // 全5条件 + colorRun 必須（AND結合）
    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

isAccum = f_is_accum_core(accumAtrMult, accumBarRatioMax, accumDriftMax)

accumHighNow = ta.highest(math.max(open, close), accumRangeLen)
accumLowNow  = ta.lowest(math.min(open, close),  accumRangeLen)

// =====================================================
// Accumボックス描画
// =====================================================
var box   curAccumBox     = na
var float curAccumBoxHigh = na
var float curAccumBoxLow  = na

isAccumStart = isAccum and not nz(isAccum[1], false)

if isAccumStart
    curAccumBoxHigh := accumHighNow
    curAccumBoxLow  := accumLowNow
    if showAccumBox
        curAccumBox := box.new(left=bar_index - accumRangeLen + 1, top=accumHighNow, right=bar_index, bottom=accumLowNow, bgcolor=accumBoxColor, border_color=accumBoxBorder)

if isAccum
    _bt = math.max(open, close)
    _bb = math.min(open, close)
    curAccumBoxHigh := math.max(nz(curAccumBoxHigh, _bt), _bt)
    curAccumBoxLow  := math.min(nz(curAccumBoxLow,  _bb), _bb)
    if showAccumBox and not na(curAccumBox)
        box.set_top(curAccumBox, curAccumBoxHigh)
        box.set_bottom(curAccumBox, curAccumBoxLow)
        box.set_right(curAccumBox, bar_index)

// =====================================================
// Alert（新規アキュム検出）
// =====================================================
if enableAlert and isAccumStart and barstate.isconfirmed
    alert("新規アキュム検出 High:" + str.tostring(accumHighNow, "#.##") + " Low:" + str.tostring(accumLowNow, "#.##"), alert.freq_once_per_bar)

alertcondition(isAccumStart, title="新規アキュム検出", message="{{ticker}} 新規アキュム検出")

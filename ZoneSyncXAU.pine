zgBody1  = input.float(3.0, "1時間足: 反転足の最低実体幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgRatio1 = input.float(30.0, "1時間足: 反転足の最低実体比率 (%)", minval = 0.0, maxval = 100.0, step = 1.0, group = G_ZG1)
zgWait1  = input.int(3, "1時間足: 反転待ち (接触足の後の最大本数)", minval = 0, group = G_ZG1)
zgMax1   = input.int(24, "1時間足: 基準の最大監視本数", minval = 1, group = G_ZG1)
zgDir1   = input.bool(false, "1時間足: 最初の山・谷の方向フィルターを使う", group = G_ZG1)
zgSep1   = input.bool(true, "1時間足: 最低離れ幅フィルターを使う", group = G_ZG1,
     tooltip = "各項目の意味・判定は LongTermDoubleTripleTopBottomXAU と同じ (本数は1時間足の bar_index)。検知イベント (反転足の確定) で Zone を発動する。")
var string G_ZG4 = "02g-2 · ZG 4時間足の検知 (LongTermDoubleTripleTopBottomXAU と同じ処理)"
zgPiv4   = input.int(4, "4時間足: Pivot 前後の本数", minval = 1, group = G_ZG4)
zgWave4  = input.float(60.0, "4時間足: 最初の波の最低値幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)
zgBuf4   = input.float(20.0, "4時間足: 接近許容幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)
zgDist4  = input.float(80.0, "4時間足: 接触間の最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_ZG4)

// ============================================================================
//  Zone Sync XAU (ZSX-1)  —  表示専用。5分足の Zone Combo Lab XAU が表示している Zone の帯を、どのチャート足でも同じ価格帯に表示する。
//  売買処理・エントリー合図・アラートは持たない。既存の Lab / Strategy / MtfPocFeedXAU / LongFibWave / ストキャスは変更しない。
// ----------------------------------------------------------------------------
//  ① 固定 5分の計算 (request.security(…, "5", f_zxEng())): 5分足を 1 本ずつ、元 Lab の (B1) Zone 登録・更新と表示帯の管理
//     (重なりの連鎖統合・分割・MA の置き直し・表示上限で古い帯から消す・無効 FVG の灰色の帯) を同じ順序で行う。図形は作らずデータで持つ。
//     検出は Lab / MtfPocFeedXAU / LongFibWave と同じ式・同じ取得 (下の「ZSY copy」区間は元ファイルの写し。tests/zsy_build.py が作り
//     tests/zsx_sim.py が照合する)。「ZSX Logic」区間は tests/zsx_sim.py が変換して実行し、元 Lab のロジック区間と毎足比べる。
//  ② 確定した 5分足だけを処理する: 5分足 t は timenow >= その time_close になった評価で処理し、形成中は処理しない。まだ処理していない 1 本前の
//     5分足があれば、次の 5分足の評価で先に処理する (同じ 5分足を 2 回処理しない)。休場中・再読み込みでも最後の確定 5分足まで反映する。
//  ③ 描画側へ渡すのは、元 Lab の表示管理が残した帯 (上限 dsZoneMax 個。灰色の帯を含む) の上下限・描画開始時刻・色・名称 (符号)・状態と、
//     MA 2 本の値だけ。内部の Zone は削らない。渡すのは 5分コンテキストの最後の足 (と直近 10 分の足) だけ。
//  ④ 描画は時刻基準: 帯は「その形が利用可能になった時刻 (その 5分足の確定時刻)」から描く (後から成立した統合形状を過去へ遡って描かない)。
//     元 Lab の左端 (構成 Zone の最も古い登録 5分足) は別に持ち、設定で比較用に切り替えられる。
//  【ZSX-5: 元 Lab との違い】アキュムは、確定した対象時間足 (1H / 4H / 日足) で新しいアキュム ID を受信した 5分足で、形成中でも上辺・下辺の
//     Zone を登録し、同じ ID の上下限が変わるたびに同じ 2 つの Zone をその価格へ移す (形成終了では何もしない。採用箱数 N は形成中の箱を含む最新 N 箱)。
//     元 Lab は形成終了で固定してから登録するため、アキュムの採用時刻・形成中の上下辺の位置・それに伴う表示帯の統合は元 Lab と一致しない。
//     他の種類 (MA・水平線・POC・FVG / iFVG・フィボ) の処理は元 Lab と同じ。
//  【ZG-1】ダブル / トリプル トップ・ボトム (ZG): Lab と同じ検知器 (LongTermDoubleTripleTopBottomXAU と同じ処理) を 1H / 4H / D の中で動かし、
//     Lab の (B1) と同じ規則 (検知イベントで発動・基準価格 ± 幅・根拠は 1 回・逆行と期限で消す) で表示する。表示は時間足ごとの「表示」設定。
//  ★ TradingView 実機でのコンパイル・表示は未実施。手順と制限: ZONE_SYNC_XAU_ja.md
// ============================================================================

//@version=5
// dynamic_requests = true: f_zxEng() の中の request.security (1分・1H・4H・日足・週足) を、固定 5分の取得の中で 5分足ごとに評価させる
//  (指定しないと、入れ子の取得が表示チャートを基準に取られ、取得範囲が表示チャートで変わった: ZSX-2 の実機結果)
indicator("Zone Sync XAU", shorttitle = "ZSX", overlay = true, max_bars_back = 1100, max_boxes_count = 500, max_labels_count = 500,
     dynamic_requests = true)

// ============================================================================
// 01. 入力 (Zone の設定は元 Lab と同じ名前・初期値)
// ============================================================================
var string G_ZX = "00 · Zone Sync"
zxStart = input.time(0, "Zone 登録開始時刻 (0 = 自動: 5分データの最初の足から)", group = G_ZX,
     tooltip = "0 (初期) は、このチャートで取得できた 5分データの最初の足から登録する (5分足チャートでは元 Lab と同じ開始点)。\n" +
     "時間足の間で比べるときは、全時間足で同じ時刻を入れる (足を切り替えるたびに入れ直さない)。")
zxLabLeft = input.bool(false, "帯の左端を元 Lab の登録位置にする (比較用)", group = G_ZX,
     tooltip = "OFF (初期): 帯の形が利用可能になった時刻から描く。ON: 元 Lab と同じく、構成 Zone の最も古い登録 5分足から描く (統合後の形を過去へ遡って描く)。")
zxBars5 = input.int(20000, "5分データの本数 (元 Lab の 5分足チャートの本数)", minval = 1, maxval = 100000, group = G_ZX,
     tooltip = "固定 5分の取得に calc_bars_count として明示する (表示チャートによらず、最新からこの本数の 5分足で計算するため)。\n" +
     "元 Lab の 5分足チャートの本数と同じにする (診断表の「チャート」行: 5分足チャートでは元 Lab と同じ足)。")
zxBars1 = input.int(100000, "1分データの本数 (元 Lab の 1分取得の本数)", minval = 1, maxval = 100000, group = G_ZX,
     tooltip = "1分 EMA の取得に calc_bars_count として明示する。5分足チャートの診断表「Lab と同じ取得: 1分」の本数と同じにする。")
zxBarsH = input.int(100000, "1H データの本数 (計算履歴)", minval = 1, maxval = 100000, group = G_ZX)
zxBars4 = input.int(100000, "4H データの本数 (計算履歴)", minval = 1, maxval = 100000, group = G_ZX)
zxBarsD = input.int(100000, "日足データの本数 (計算履歴)", minval = 1, maxval = 100000, group = G_ZX)
zxBarsW = input.int(100000, "週足データの本数 (計算履歴)", minval = 1, maxval = 100000, group = G_ZX,
     tooltip = "固定 5分の中の上位足の取得に、その時間足自身の本数として calc_bars_count で明示する (5分データの期間だけで初期化しない)。\n" +
     "元 Lab の取得と同じ範囲にする: 5分足チャートの診断表で「固定5分の中」と「[直接]」(= 元 Lab と同じ取得) の本数が違えば、[直接] の本数を入れる。\n" +
     "POC (集計本数 + 確定足の 1 本 + 開始条件の 1 本)・Pivot・アキュム・フィボの計算に必要な本数より少なくはしない。")
zxTbl = input.bool(true, "診断表を表示", group = G_ZX)

var string G_ZW = "02 · Zone 共通"
zHalf = input.float(2.0, "共通の価格帯幅 (中心から上下 $)", minval = 0.0, step = 0.5, group = G_ZW)

var string G_ZA = "02a · ZA アキュム (1H / 4H / D)"
zaUse1 = input.bool(true, "1H アキュム", group = G_ZA)
zaUse2 = input.bool(true, "4H アキュム", group = G_ZA)
zaKeep1 = input.int(1, "1時間足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaKeep2 = input.int(1, "4時間足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaKeep3 = input.int(1, "日足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaUse3 = input.bool(true, "日足 アキュム", group = G_ZA)

var string G_ACCP = "02 · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ZB = "02b · ZB MA (EMA)"
zbUse1 = input.bool(true, "1分足 EMA", group = G_ZB)
zbLen1 = input.int(3000, "1分足 EMA 本数", minval = 1, group = G_ZB)
zbUse2 = input.bool(true, "5分足 EMA", group = G_ZB)
zbLen2 = input.int(3000, "5分足 EMA 本数", minval = 1, group = G_ZB)

var string G_ZC = "02c · ZC 水平線 (Swing 高安)"
zcUse1 = input.bool(true, "1H Swing", group = G_ZC)
zcPiv1 = input.int(6, "1H 左右の本数", minval = 1, group = G_ZC)
zcUse2 = input.bool(true, "4H Swing", group = G_ZC)
zcPiv2 = input.int(6, "4H 左右の本数", minval = 1, group = G_ZC)
zcUse3 = input.bool(true, "日足 Swing", group = G_ZC)
zcPiv3 = input.int(6, "日足 左右の本数", minval = 1, group = G_ZC)
zcUse4 = input.bool(true, "週足 Swing", group = G_ZC)
zcPiv4 = input.int(6, "週足 左右の本数", minval = 1, group = G_ZC)
zcMerge = input.float(5.0, "水平線の統合距離 ($)", minval = 0.0, step = 0.5, group = G_ZC)

var string G_ZD = "02d · ZD 出来高 POC (内蔵: MtfPocFeedXAU と同じ計算)"
zdUse1 = input.bool(true, "1H POC", group = G_ZD)
zdUse2 = input.bool(true, "4H POC", group = G_ZD)
zdUse3 = input.bool(true, "日足 POC", group = G_ZD)
zdUse4 = input.bool(true, "週足 POC", group = G_ZD)
pocLen1 = input.int(120, "1H 集計本数", minval = 10, maxval = 1000, group = G_ZD)
pocLen2 = input.int(120, "4H 集計本数", minval = 10, maxval = 1000, group = G_ZD)
pocLen3 = input.int(120, "日足 集計本数", minval = 10, maxval = 1000, group = G_ZD)
pocLen4 = input.int(120, "週足 集計本数", minval = 10, maxval = 1000, group = G_ZD)
pocBins = input.int(75, "VP ビン数 (分割数)", minval = 4, maxval = 100, group = G_ZD)

var string G_ZE = "02e · ZE フィボ (内蔵: LongFibWave と同じ計算)"
zeUse  = input.bool(false, "ZE フィボを検知", group = G_ZE)
zeUse4 = input.bool(true, "4時間足の波を採用", group = G_ZE)
zeUseD = input.bool(true, "日足の波を採用", group = G_ZE)
grpW = "02e · フィボ (LongFibWave) 波の切替・観測"
grpP = "02e · フィボ (LongFibWave) 主要高安"
grpS = "02e · フィボ (LongFibWave) 統計"
// ==== ZSY copy LFW_INPUTS begin (from LongFibWave.pine, byte for byte) ====
lfwSwitchRatioD = input.float(0.90,  "日足: 同方向切替率（この戻り率以上の戻り高安を次の起点候補にする）", minval = 0.01, maxval = 1.0, step = 0.001, group = grpW)
lfwSwitchRatio4 = input.float(0.782, "4H: 同方向切替率（この戻り率以上の戻り高安を次の起点候補にする）",   minval = 0.01, maxval = 1.0, step = 0.001, group = grpW)
lfwStartRatio   = input.float(0.10,  "観測開始の戻り率",           minval = 0.01, maxval = 1.0, step = 0.01, group = grpW)
lfwExclInit     = input.bool(true,  "最初の波の観測を統計から除外", group = grpW)
lfwAtrLen       = input.int(14,     "ATR 期間（各対象時間足自身）", minval = 1, group = grpP)
lfwPivLD        = input.int(20,     "日足: 左の本数",               minval = 1, maxval = 200, group = grpP)
lfwPivRD        = input.int(3,      "日足: 右の本数（確認）",       minval = 1, maxval = 50,  group = grpP)
lfwPivMD        = input.float(7.0,  "日足: 必要値幅（極値足の ATR 倍率）", minval = 0.1, step = 0.1, group = grpP)
lfwPivL4        = input.int(60,     "4H: 左の本数",                 minval = 1, maxval = 200, group = grpP)
lfwPivR4        = input.int(3,      "4H: 右の本数（確認）",         minval = 1, maxval = 50,  group = grpP)
lfwPivM4        = input.float(6.0,  "4H: 必要値幅（極値足の ATR 倍率）",   minval = 0.1, step = 0.1, group = grpP)
lfwMaxRecs      = input.int(1000,   "保存する観測記録の上限（件数集計は上限なし）", minval = 10, group = grpS)
// ==== ZSY copy LFW_INPUTS end ====

var string G_ZF = "02f · ZF FVG / iFVG"
zfUse1 = input.bool(true, "1H FVG", group = G_ZF)
zfUse2 = input.bool(true, "4H FVG", group = G_ZF)
zfUse3 = input.bool(true, "日足 FVG", group = G_ZF)
zfUse4 = input.bool(true, "週足 FVG", group = G_ZF)
zfMinW = input.float(3.0, "FVG 最小幅 ($)", minval = 0.0, step = 0.5, group = G_ZF)

var string G_ZG = "02g · ZG ダブル / トリプル トップ・ボトム (1H / 4H / D)"
zgShow1 = input.bool(true, "1時間足: 表示", group = G_ZG,
     tooltip = "ON: Lab と同じ処理で ZG の帯を表示 (Lab の「表示」と同じ設定にする)。OFF: 表示しない。")
zgExp1  = input.bool(true, "1時間足: 時間で消す", group = G_ZG, inline = "zge1")
zgExpN1 = input.int(24, "本数", minval = 1, group = G_ZG, inline = "zge1",
     tooltip = "検知足 = 0 本目。この本数の1時間足が確定した時点で Zone を消す (経過時間ではなく1時間足の本数。検知器の最大監視本数とは別)。")
zgShow4 = input.bool(true, "4時間足: 表示", group = G_ZG,
     tooltip = "ON: Lab と同じ処理で ZG の帯を表示 (Lab の「表示」と同じ設定にする)。OFF: 表示しない。")
zgExp4  = input.bool(true, "4時間足: 時間で消す", group = G_ZG, inline = "zge4")
zgExpN4 = input.int(12, "本数", minval = 1, group = G_ZG, inline = "zge4",
     tooltip = "検知足 = 0 本目。この本数の4時間足が確定した時点で Zone を消す (経過時間ではなく4時間足の本数。検知器の最大監視本数とは別)。")
zgShowD = input.bool(true, "日足: 表示", group = G_ZG,
     tooltip = "ON: Lab と同じ処理で ZG の帯を表示 (Lab の「表示」と同じ設定にする)。OFF: 表示しない。")
zgExpD  = input.bool(true, "日足: 時間で消す", group = G_ZG, inline = "zgeD")
zgExpND = input.int(5, "本数", minval = 1, group = G_ZG, inline = "zgeD",
     tooltip = "検知足 = 0 本目。この本数の日足が確定した時点で Zone を消す (経過時間ではなく日足の本数。検知器の最大監視本数とは別)。")
zgHalf = input.float(2.0, "ZG 帯の幅 (基準価格から上下 $)", minval = 0.0, step = 0.5, group = G_ZG,
     tooltip = "基準価格 = トップは 1 回目の山と 2 回目 (トリプルで初めて発動した場合は 2・3 回目) の接触群の実体上端の高い方、" +
     "ボトムは実体下端の低い方 (ヒゲは使わない。接触群は接触開始から検知足まで)。検知時点で固定。帯 = 基準価格 ± この値。")
zgRev  = input.float(5.0, "ZG 逆行で消す幅 ($)", minval = 0.0, step = 0.5, group = G_ZG,
     tooltip = "発動後の確定 5分足で、トップは max(open, close) > 基準価格 + この値、ボトムは min(open, close) < 基準価格 − この値で消す。" +
     "ヒゲだけの突破・ちょうどの値では消さない。")
var string G_ZG1 = "02g-1 · ZG 1時間足の検知 (LongTermDoubleTripleTopBottomXAU と同じ処理)"
zgPiv1   = input.int(4, "1時間足: Pivot 前後の本数", minval = 1, group = G_ZG1)
zgWave1  = input.float(10.0, "1時間足: 最初の波の最低値幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgBuf1   = input.float(5.0, "1時間足: 接近許容幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)
zgDist1  = input.float(30.0, "1時間足: 接触間の最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_ZG1)

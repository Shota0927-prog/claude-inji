// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// Gold Swing Detector — XAUUSD 15分足向け 勝負所検知インジケーター
// 8つの条件を重み付きスコア化し、3段階のロングシグナルを発火する

//@version=5
indicator(
     title             = "Gold Swing Detector",
     shorttitle        = "GoldSwing",
     overlay           = true,
     max_labels_count  = 500,
     max_bars_back     = 1000
 )

// ============================================================
// 入力パラメータ
// ============================================================

// --- グループ1: 先行下落の検出 ---
grp1 = "1. 先行下落"
priorDeclineBars    = input.int(48,    title = "先行下落の参照本数",         minval = 12,  maxval = 200, group = grp1)
priorDeclineMin     = input.float(100, title = "先行下落の最低幅 (USD)",     minval = 30,  maxval = 500, step = 5, group = grp1)

// --- グループ2: コンプレッション ---
grp2 = "2. コンプレッション"
compRecent          = input.int(5,     title = "直近レンジの本数",           minval = 3,   maxval = 20,  group = grp2)
compLookback        = input.int(20,    title = "比較対象の平均レンジ本数",   minval = 10,  maxval = 100, group = grp2)
compRatio           = input.float(0.6, title = "圧縮率の閾値",               minval = 0.3, maxval = 1.0, step = 0.05, group = grp2)

// --- グループ3: ストキャス ---
grp3 = "3. ストキャス"
stochKLen           = input.int(14,    title = "ストキャス %K 期間",         minval = 5,   maxval = 50,  group = grp3)
stochSmooth         = input.int(3,     title = "ストキャス %D 平滑化",       minval = 1,   maxval = 10,  group = grp3)
stochOversoldLevel  = input.float(25,  title = "オーバーソールド閾値",       minval = 10,  maxval = 40,  group = grp3)
stochLookbackBars   = input.int(10,    title = "OS履歴を見る本数",           minval = 5,   maxval = 50,  group = grp3)

// --- グループ4: ストキャスダイバージェンス ---
grp4 = "4. ストキャスダイバ"
divLookbackBars     = input.int(30,    title = "ダイバ検出ルックバック",     minval = 10,  maxval = 100, group = grp4)
divPivotStrength    = input.int(3,     title = "ピボット強度",               minval = 1,   maxval = 10,  group = grp4)

// --- グループ5: 構造転換 ---
grp5 = "5. 構造転換"
swingLookback       = input.int(20,    title = "スイング安値の参照本数",     minval = 10,  maxval = 100, group = grp5)
breakoutBars        = input.int(5,     title = "ブレイク判定の本数",         minval = 3,   maxval = 20,  group = grp5)

// --- グループ6: 移動平均 ---
grp6 = "6. 移動平均"
maShort             = input.int(20,    title = "短期MA期間",                 minval = 5,   maxval = 50,  group = grp6)
maMid               = input.int(50,    title = "中期MA期間",                 minval = 20,  maxval = 200, group = grp6)
maNearbyPercent     = input.float(3.0, title = "中期MA近接 (%)",             minval = 1.0, maxval = 10.0, step = 0.1, group = grp6)

// --- グループ7: 重み ---
grp7 = "7. 重み (スコアリング)"
wPriorDecline       = input.int(2, title = "重み: 先行下落",          minval = 0, maxval = 5, group = grp7)
wCompression        = input.int(2, title = "重み: コンプレッション",  minval = 0, maxval = 5, group = grp7)
wStochSignal        = input.int(3, title = "重み: ストキャス底打ち",  minval = 0, maxval = 5, group = grp7)
wStochDiv           = input.int(2, title = "重み: ストキャスダイバ",  minval = 0, maxval = 5, group = grp7)
wHigherLow          = input.int(2, title = "重み: Higher Low",        minval = 0, maxval = 5, group = grp7)
wBreakout           = input.int(3, title = "重み: ブレイクアウト",    minval = 0, maxval = 5, group = grp7)
wMAReclaim          = input.int(2, title = "重み: MAリクレイム",      minval = 0, maxval = 5, group = grp7)
wMANearby           = input.int(1, title = "重み: 中期MA近接",        minval = 0, maxval = 5, group = grp7)

// --- グループ8: 閾値 ---
grp8 = "8. シグナル閾値"
thresholdAggressive    = input.int(7,  title = "アグレッシブ閾値",   minval = 3, maxval = 17, group = grp8)
thresholdBalanced      = input.int(10, title = "バランス閾値",       minval = 3, maxval = 17, group = grp8)
thresholdConservative  = input.int(13, title = "コンサバ閾値",       minval = 3, maxval = 17, group = grp8)

// --- グループ9: 表示設定 ---
grp9 = "9. 表示"
showTable        = input.bool(true, title = "テーブルを表示",      group = grp9)
showBackground   = input.bool(true, title = "背景色を表示",        group = grp9)
showMarkers      = input.bool(true, title = "シグナルマーカー表示", group = grp9)
showMAs          = input.bool(true, title = "MAを描画",            group = grp9)

// ============================================================
// 計算ロジック
// ============================================================

// --- 条件1: 先行下落の存在 ---
// 過去 priorDeclineBars 本での最高値と、現在の安値の差が priorDeclineMin 以上か
priorDecline = (ta.highest(high, priorDeclineBars) - low) >= priorDeclineMin

// --- 条件2: コンプレッション (レンジ収縮) ---
// 直近レンジが過去の平均レンジの compRatio 倍以下に収縮しているか
recentRange = ta.highest(high, compRecent) - ta.lowest(low, compRecent)
avgRange    = ta.sma(high - low, compLookback)
compression = recentRange < avgRange * compRatio

// --- 条件3: ストキャス底打ち + %K/%D クロス ---
// オーバーソールド圏から戻り、%Kが%Dを上抜けしたか
stochK = ta.stoch(close, high, low, stochKLen)
stochD = ta.sma(stochK, stochSmooth)
wasOversold = ta.barssince(stochK < stochOversoldLevel) < stochLookbackBars
stochCross  = ta.crossover(stochK, stochD)
stochSignal = wasOversold and stochCross

// --- 条件4: ストキャス bullish ダイバージェンス ---
// 配列で直近2つのストキャスピボット安値とバー位置を保持し、
// 同じバー位置の価格安値と比較して "価格は下げ・ストキャスは切り上げ" を判定する
var float[] stochPivVals = array.new_float()
var int[]   stochPivBars = array.new_int()
var float[] pricePivVals = array.new_float()

// pivot は確定までに divPivotStrength 本かかる。pivot確定時に登録。
pivStoch = ta.pivotlow(stochK, divPivotStrength, divPivotStrength)
if not na(pivStoch)
    // pivot確定バーは現在から divPivotStrength 本前
    pivotBarIndex = bar_index - divPivotStrength
    pivotPrice    = low[divPivotStrength]
    array.push(stochPivVals, pivStoch)
    array.push(stochPivBars, pivotBarIndex)
    array.push(pricePivVals, pivotPrice)
    // 直近2つだけ保持
    if array.size(stochPivVals) > 2
        array.shift(stochPivVals)
        array.shift(stochPivBars)
        array.shift(pricePivVals)

// ダイバージェンス判定: 2つのピボットが揃っていて、divLookbackBars 以内であれば評価
f_stochDiv() =>
    bool result = false
    if array.size(stochPivVals) == 2
        prevStoch = array.get(stochPivVals, 0)
        currStoch = array.get(stochPivVals, 1)
        prevPrice = array.get(pricePivVals, 0)
        currPrice = array.get(pricePivVals, 1)
        currBar   = array.get(stochPivBars, 1)
        withinLb  = (bar_index - currBar) <= divLookbackBars
        // 価格は安値更新、ストキャスは切り上がり
        result := withinLb and (currPrice < prevPrice) and (currStoch > prevStoch)
    result

stochDiv = f_stochDiv()

// --- 条件5: 構造転換 (Higher Low の形成) ---
// 直近のpivot lowが、それより前の swingLookback 期間の安値より高いか
latestPivotLow = ta.pivotlow(low, divPivotStrength, divPivotStrength)
var float lastPivotLow = na
var int   lastPivotLowBar = na
if not na(latestPivotLow)
    lastPivotLow := latestPivotLow
    lastPivotLowBar := bar_index - divPivotStrength

// 比較対象: pivot形成位置から swingLookback 本前の安値
priorRangeLow = ta.lowest(low, swingLookback)[divPivotStrength + 1]
higherLow = not na(lastPivotLow) and not na(priorRangeLow) and lastPivotLow > priorRangeLow and (bar_index - lastPivotLowBar) <= swingLookback

// --- 条件6: 直近高値ブレイク ---
// 現在の終値が、直近 breakoutBars 本(1本前まで)の高値を上抜け
breakout = close > ta.highest(high[1], breakoutBars)

// --- 条件7: 短期MAリクレイム ---
// 価格が短期MA(maShort)を上抜けクロス
ma20      = ta.sma(close, maShort)
maReclaim = ta.crossover(close, ma20)

// --- 条件8: 中期MA近接 ---
// 現在価格が中期MA(maMid)から maNearbyPercent% 以内にあるか
ma50     = ta.sma(close, maMid)
maNearby = math.abs(close - ma50) / ma50 * 100 < maNearbyPercent

// ============================================================
// スコア計算
// ============================================================
score = (priorDecline ? wPriorDecline : 0) +
        (compression  ? wCompression  : 0) +
        (stochSignal  ? wStochSignal  : 0) +
        (stochDiv     ? wStochDiv     : 0) +
        (higherLow    ? wHigherLow    : 0) +
        (breakout     ? wBreakout     : 0) +
        (maReclaim    ? wMAReclaim    : 0) +
        (maNearby     ? wMANearby     : 0)

maxScore = wPriorDecline + wCompression + wStochSignal + wStochDiv +
           wHigherLow + wBreakout + wMAReclaim + wMANearby

// ============================================================
// シグナル判定 (排他的・確定足でのみ発火)
// ============================================================
isConfirmed = barstate.isconfirmed
sigAggressive   = isConfirmed and score >= thresholdAggressive   and score <  thresholdBalanced
sigBalanced     = isConfirmed and score >= thresholdBalanced     and score <  thresholdConservative
sigConservative = isConfirmed and score >= thresholdConservative

// ============================================================
// プロット
// ============================================================

// スコアを公開 (アラートメッセージから参照可能)
plot(score,    title = "Score",    color = color.new(color.gray, 100), display = display.data_window)
plot(maxScore, title = "MaxScore", color = color.new(color.gray, 100), display = display.data_window)

// MA描画
plot(showMAs ? ma20 : na, title = "Short MA", color = color.new(color.blue,   0), linewidth = 1)
plot(showMAs ? ma50 : na, title = "Mid MA",   color = color.new(color.purple, 0), linewidth = 2)

// 背景色 (スコア帯)
bgColor = score >= thresholdConservative ? color.new(color.green,  75) :
          score >= thresholdBalanced     ? color.new(color.orange, 80) :
          score >= thresholdAggressive   ? color.new(color.yellow, 85) :
          na
bgcolor(showBackground ? bgColor : na, title = "スコア帯背景")

// マーカー
plotshape(showMarkers and sigAggressive,   title = "Aggressive Signal",   style = shape.triangledown, location = location.belowbar, color = color.new(color.yellow, 0), size = size.tiny)
plotshape(showMarkers and sigBalanced,     title = "Balanced Signal",     style = shape.triangleup,   location = location.belowbar, color = color.new(color.orange, 0), size = size.small)
plotshape(showMarkers and sigConservative, title = "Conservative Signal", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green,  0), size = size.normal, text = "BUY")

// ============================================================
// テーブル表示
// ============================================================
var table infoTable = table.new(position.top_right, 3, 10, border_width = 1)

f_cellColor(b) => b ? color.new(color.green, 70) : color.new(color.gray, 80)
f_mark(b)      => b ? "✓" : "✗"

if showTable and barstate.islast
    // ヘッダ
    table.cell(infoTable, 0, 0, "条件",   bgcolor = color.new(color.black, 50), text_color = color.white)
    table.cell(infoTable, 1, 0, "状態",   bgcolor = color.new(color.black, 50), text_color = color.white)
    table.cell(infoTable, 2, 0, "重み",   bgcolor = color.new(color.black, 50), text_color = color.white)

    table.cell(infoTable, 0, 1, "Prior Decline",    bgcolor = f_cellColor(priorDecline))
    table.cell(infoTable, 1, 1, f_mark(priorDecline), bgcolor = f_cellColor(priorDecline))
    table.cell(infoTable, 2, 1, str.tostring(wPriorDecline), bgcolor = f_cellColor(priorDecline))

    table.cell(infoTable, 0, 2, "Compression",      bgcolor = f_cellColor(compression))
    table.cell(infoTable, 1, 2, f_mark(compression), bgcolor = f_cellColor(compression))
    table.cell(infoTable, 2, 2, str.tostring(wCompression), bgcolor = f_cellColor(compression))

    table.cell(infoTable, 0, 3, "Stoch Signal",     bgcolor = f_cellColor(stochSignal))
    table.cell(infoTable, 1, 3, f_mark(stochSignal), bgcolor = f_cellColor(stochSignal))
    table.cell(infoTable, 2, 3, str.tostring(wStochSignal), bgcolor = f_cellColor(stochSignal))

    table.cell(infoTable, 0, 4, "Stoch Divergence", bgcolor = f_cellColor(stochDiv))
    table.cell(infoTable, 1, 4, f_mark(stochDiv), bgcolor = f_cellColor(stochDiv))
    table.cell(infoTable, 2, 4, str.tostring(wStochDiv), bgcolor = f_cellColor(stochDiv))

    table.cell(infoTable, 0, 5, "Higher Low",       bgcolor = f_cellColor(higherLow))
    table.cell(infoTable, 1, 5, f_mark(higherLow), bgcolor = f_cellColor(higherLow))
    table.cell(infoTable, 2, 5, str.tostring(wHigherLow), bgcolor = f_cellColor(higherLow))

    table.cell(infoTable, 0, 6, "Breakout",         bgcolor = f_cellColor(breakout))
    table.cell(infoTable, 1, 6, f_mark(breakout), bgcolor = f_cellColor(breakout))
    table.cell(infoTable, 2, 6, str.tostring(wBreakout), bgcolor = f_cellColor(breakout))

    table.cell(infoTable, 0, 7, "MA Reclaim",       bgcolor = f_cellColor(maReclaim))
    table.cell(infoTable, 1, 7, f_mark(maReclaim), bgcolor = f_cellColor(maReclaim))
    table.cell(infoTable, 2, 7, str.tostring(wMAReclaim), bgcolor = f_cellColor(maReclaim))

    table.cell(infoTable, 0, 8, "MA Nearby",        bgcolor = f_cellColor(maNearby))
    table.cell(infoTable, 1, 8, f_mark(maNearby), bgcolor = f_cellColor(maNearby))
    table.cell(infoTable, 2, 8, str.tostring(wMANearby), bgcolor = f_cellColor(maNearby))

    // 合計スコア (スコア帯に応じて色を変える)
    totalBg = score >= thresholdConservative ? color.new(color.green,  40) :
              score >= thresholdBalanced     ? color.new(color.orange, 45) :
              score >= thresholdAggressive   ? color.new(color.yellow, 50) :
              color.new(color.gray, 60)
    table.cell(infoTable, 0, 9, "TOTAL SCORE", bgcolor = totalBg, text_color = color.white)
    table.cell(infoTable, 1, 9, str.tostring(score), bgcolor = totalBg, text_color = color.white)
    table.cell(infoTable, 2, 9, "/ " + str.tostring(maxScore), bgcolor = totalBg, text_color = color.white)

// ============================================================
// アラート
// ============================================================
alertcondition(sigAggressive,
     title   = "Aggressive Long Signal",
     message = "🟡 ゴールド アグレッシブ・ロングシグナル発火 | スコア: {{plot('Score')}}")

alertcondition(sigBalanced,
     title   = "Balanced Long Signal",
     message = "🟠 ゴールド バランス・ロングシグナル発火 | スコア: {{plot('Score')}}")

alertcondition(sigConservative,
     title   = "Conservative Long Signal",
     message = "🟢 ゴールド コンサバ・ロングシグナル発火 | スコア: {{plot('Score')}}")

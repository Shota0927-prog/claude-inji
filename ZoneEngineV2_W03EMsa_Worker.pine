//@version=6
// ============================================================
// ZoneEngineV2_W03EMsa_Worker - W03 E-stage MA / Swing / Accum worker
//
// G2 ABI COMPILE PROBE ONLY
// NOT WIRED TO MAIN
// IDENTITY RETURN UNTIL B8
//
// run() carries the final G2 signature (Main w03StageEMaRaw -> w03StageESwingRaw
// -> w03StageEAccumRaw inputs, flattened) so the ABI compiles before the stage
// bodies land. Until B8 it writes nothing and returns every output as its matching
// input; an ABI usage sink (collection sizes, na / bool flags) references every
// argument so the export compiles (CE10237). No import, no type, no persistent storage, no request,
// no drawing.
// ============================================================
library("ZoneEngineV2_W03EMsa_Worker", overlay = false)

// ---- constants : exact copies of the Main declarations ----
const int    FP_MOD           = 2147483647
const int    FP_NA_KEY        = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int    FP_SEED_A        = 16777619
const int    FP_MULT_A        = 1000003
const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int JOP_NEW_ROOT       = 2

// Main fpMixInt
fpMixInt(int acc, int mult, int value) =>
    int t  = value % FP_MOD
    int tp = t < 0 ? t + FP_MOD : t
    (acc * mult + tp) % FP_MOD

// Main fpIntKey
fpIntKey(int v) =>
    na(v) ? FP_NA_KEY : v

// Main originKeyComputeRaw
originKeyComputeRaw(int category, int subtype, int tfCode, int pointTick, int originTime, int direction) =>
    int h = FP_SEED_A
    h := fpMixInt(h, FP_MULT_A, fpIntKey(category))
    if category == CAT_MA
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
    else if category == CAT_SWING
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_ACCUM
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_TIME_HL
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_FVG
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(direction))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_PSYCH
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    h == 0 ? 1 : h

// Main originTupleEqualRaw
originTupleEqualRaw(int incomingCategory, int incomingSubtype, int incomingTfCode, int incomingPointTick, int incomingOriginTime, int incomingOriginEndTime, int incomingDirection, int storedCategory, int storedSubtype, int storedTfCode, int storedPointTick, int storedOriginTime, int storedOriginEndTime, int storedDirection) =>
    bool equal = false
    if incomingCategory == CAT_MA
        equal := storedCategory == CAT_MA and incomingTfCode == TF_1M and storedTfCode == TF_1M and not na(incomingSubtype) and incomingSubtype == storedSubtype
    else if incomingCategory == CAT_SWING
        bool tfOk   = (incomingTfCode == TF_5M or incomingTfCode == TF_15M or incomingTfCode == TF_1H) and (storedTfCode == TF_5M or storedTfCode == TF_15M or storedTfCode == TF_1H)
        bool baseOk = storedCategory == CAT_SWING and tfOk and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
        bool timeOk = not na(incomingOriginTime) and not na(incomingOriginEndTime) and not na(storedOriginTime) and not na(storedOriginEndTime)
        if baseOk and timeOk
            if incomingTfCode == storedTfCode
                equal := incomingOriginTime == storedOriginTime and incomingOriginEndTime == storedOriginEndTime
            else if storedTfCode < incomingTfCode
                equal := storedOriginTime >= incomingOriginTime and storedOriginTime < incomingOriginEndTime
            else
                equal := incomingOriginTime >= storedOriginTime and incomingOriginTime < storedOriginEndTime
    else if incomingCategory == CAT_ACCUM
        equal := storedCategory == CAT_ACCUM and not na(incomingTfCode) and incomingTfCode == storedTfCode and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_TIME_HL
        equal := storedCategory == CAT_TIME_HL and incomingTfCode == TF_5M and storedTfCode == TF_5M and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else if incomingCategory == CAT_FVG
        equal := storedCategory == CAT_FVG and not na(incomingTfCode) and incomingTfCode == storedTfCode and (incomingDirection == FVG_BULLISH or incomingDirection == FVG_BEARISH) and incomingDirection == storedDirection and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_PSYCH
        equal := storedCategory == CAT_PSYCH and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    equal

// Main sourceAdoptableRaw
sourceAdoptableRaw(int sourceOpenTime, int sourceCloseTime, int lastConsumedCloseTime, int baseCloseTime) =>
    not na(sourceOpenTime) and not na(sourceCloseTime) and not na(baseCloseTime) and baseCloseTime >= sourceCloseTime and (na(lastConsumedCloseTime) or sourceCloseTime > lastConsumedCloseTime)

// Main maSlopeDirRaw
maSlopeDirRaw(float rawSlope) =>
    int dir = int(na)
    if not na(rawSlope)
        dir := rawSlope > 0 ? 1 : rawSlope < 0 ? -1 : 0
    dir

// W03ETimeFvg journalAppendRaw (flattened Main journalAppendRaw; the caller advances the journal length to row + 1)
journalAppendRaw(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, int journalCountNow, int op, int group, int targetRootSlot, int expectedRootId, int category, int subtype, int tfCode, int originKey, int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom, float nativeTop, int oldState, int newState, bool fvgFresh, bool isBroad, int direction, int oldMask, int newMask, int pairKey, int slopeDir) =>
    int row = journalCountNow
    if row < array.size(journalOps)
        array.set(journalOps,             row, op)
        array.set(journalGroups,          row, group)
        array.set(journalTargetRootSlots, row, targetRootSlot)
        array.set(journalExpectedRootIds, row, expectedRootId)
        array.set(journalCategories,      row, category)
        array.set(journalSubtypes,        row, subtype)
        array.set(journalTfCodes,         row, tfCode)
        array.set(journalOriginKeys,      row, originKey)
        array.set(journalOriginTimes,     row, originTime)
        array.set(journalOriginEndTimes,  row, originEndTime)
        array.set(journalConfirmedTimes,  row, confirmedTime)
        array.set(journalPointPrices,     row, pointPrice)
        array.set(journalNativeBottoms,   row, nativeBottom)
        array.set(journalNativeTops,      row, nativeTop)
        array.set(journalOldStates,       row, oldState)
        array.set(journalNewStates,       row, newState)
        array.set(journalFvgFreshFlags,   row, fvgFresh)
        array.set(journalIsBroadFlags,    row, isBroad)
        array.set(journalDirections,      row, direction)
        array.set(journalOldMasks,        row, oldMask)
        array.set(journalNewMasks,        row, newMask)
        array.set(journalPairKeys,        row, pairKey)
        array.set(journalSlopeDirs,       row, slopeDir)
    else
        array.push(journalOps,             op)
        array.push(journalGroups,          group)
        array.push(journalTargetRootSlots, targetRootSlot)
        array.push(journalExpectedRootIds, expectedRootId)
        array.push(journalCategories,      category)
        array.push(journalSubtypes,        subtype)
        array.push(journalTfCodes,         tfCode)
        array.push(journalOriginKeys,      originKey)
        array.push(journalOriginTimes,     originTime)
        array.push(journalOriginEndTimes,  originEndTime)
        array.push(journalConfirmedTimes,  confirmedTime)
        array.push(journalPointPrices,     pointPrice)
        array.push(journalNativeBottoms,   nativeBottom)
        array.push(journalNativeTops,      nativeTop)
        array.push(journalOldStates,       oldState)
        array.push(journalNewStates,       newState)
        array.push(journalFvgFreshFlags,   fvgFresh)
        array.push(journalIsBroadFlags,    isBroad)
        array.push(journalDirections,      direction)
        array.push(journalOldMasks,        oldMask)
        array.push(journalNewMasks,        newMask)
        array.push(journalPairKeys,        pairKey)
        array.push(journalSlopeDirs,       slopeDir)
    row

// W03ETimeFvg originLookupUniqueRaw (flattened Main originLookupUniqueRaw; returns the violation it detects, the caller ORs it in)
originLookupUniqueRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> journalOps, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<float> journalPointPrices, array<int> journalDirections, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int journalCountNow, int originKey, int category, int subtype, int tfCode, int pointTick, int originTime, int originEndTime, int direction, float mintick) =>
    int  matchCount        = 0
    int  matchedRootSlot   = SLOT_INVALID
    int  matchedPendingRow = SLOT_INVALID
    bool violation         = false
    if originKey != ID_NONE
        if map.contains(originKeyBucketHeadRootSlots, originKey)
            int slot      = map.get(originKeyBucketHeadRootSlots, originKey)
            int stepLimit = array.size(rootIds)
            int steps     = 0
            while slot != SLOT_INVALID and not violation and steps < stepLimit
                bool nodeOk = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootOriginKeys) and slot < array.size(rootOriginBucketNextRootSlots) and slot < array.size(rootOriginBucketExpectedRootIds)
                if nodeOk
                    nodeOk := array.get(rootSlotLiveFlags, slot)
                if nodeOk
                    int bucketRootId = array.get(rootOriginBucketExpectedRootIds, slot)
                    nodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(rootIds, slot) and array.get(rootOriginKeys, slot) == originKey
                if not nodeOk
                    violation := true
                else
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(rootCategories, slot), array.get(rootSubtypes, slot), array.get(rootTfCodes, slot), array.get(rootPointTicks, slot), array.get(rootOriginTimes, slot), array.get(rootOriginEndTimes, slot), array.get(rootDirections, slot))
                        matchCount += 1
                        if matchCount == 1
                            matchedRootSlot := slot
                        else
                            violation := true
                    slot  := array.get(rootOriginBucketNextRootSlots, slot)
                    steps += 1
            if not violation and slot != SLOT_INVALID
                violation := true
        if not violation
            int journalCount = journalCountNow
            int row = 0
            while row < journalCount and not violation
                if array.get(journalOps, row) == JOP_NEW_ROOT and array.get(journalOriginKeys, row) == originKey
                    float pendingPrice = array.get(journalPointPrices, row)
                    int   pendingTick  = na(pendingPrice) ? int(na) : int(math.round(pendingPrice / mintick))
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(journalCategories, row), array.get(journalSubtypes, row), array.get(journalTfCodes, row), pendingTick, array.get(journalOriginTimes, row), array.get(journalOriginEndTimes, row), array.get(journalDirections, row))
                        matchCount += 1
                        if matchCount == 1
                            matchedPendingRow := row
                        else
                            violation := true
                row += 1
    [violation ? SLOT_INVALID : matchedRootSlot, violation ? SLOT_INVALID : matchedPendingRow, violation]

// ---- export : G2 ABI probe (identity return until B8) ----
// Returns [journalCountOut, violationOut, Swing lastConsumed x2, Accum lastConsumed x3, Accum candidate x12].
export run(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<float> rootPointPrices, array<int> rootConfirmedTimes, array<int> rootPairKeys, array<int> rootSwingTfMasks, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextRootId, int ema2000SlopeDir, int ema3000SlopeDir, int nextAccumPairKey, bool cfgUseMa, bool cfgUseSwing, bool cfgUseAccum, int feedMaSourceOpenTime, int feedMaSourceCloseTime, float feedEma2000, float feedEma2000Slope, float feedEma3000, float feedEma3000Slope, int feedBaseCloseTime, float feedMintick, int feedSrc15mOpenTime, int feedSrc15mCloseTime, int feedSrc1hOpenTime, int feedSrc1hCloseTime, int feedSrc4hOpenTime, int feedSrc4hCloseTime, int feedSrcDOpenTime, int feedSrcDCloseTime, float feedSwing5mHighPrice, int feedSwing5mHighOriginTime, int feedSwing5mHighOriginEndTime, int feedSwing5mHighConfirmedTime, float feedSwing5mLowPrice, int feedSwing5mLowOriginTime, int feedSwing5mLowOriginEndTime, int feedSwing5mLowConfirmedTime, float feedSwing15mHighPrice, int feedSwing15mHighOriginTime, int feedSwing15mHighOriginEndTime, int feedSwing15mHighConfirmedTime, float feedSwing15mLowPrice, int feedSwing15mLowOriginTime, int feedSwing15mLowOriginEndTime, int feedSwing15mLowConfirmedTime, float feedSwing1hHighPrice, int feedSwing1hHighOriginTime, int feedSwing1hHighOriginEndTime, int feedSwing1hHighConfirmedTime, float feedSwing1hLowPrice, int feedSwing1hLowOriginTime, int feedSwing1hLowOriginEndTime, int feedSwing1hLowConfirmedTime, bool feedAccum1hNewConfirmedBox, float feedAccum1hBoxTop, float feedAccum1hBoxBottom, bool feedAccum1hCandidateActive, int feedAccum1hCandidateStartTime, float feedAccum1hCandidateTop, float feedAccum1hCandidateBottom, int feedAccum1hConfirmedTime, bool feedAccum4hNewConfirmedBox, float feedAccum4hBoxTop, float feedAccum4hBoxBottom, bool feedAccum4hCandidateActive, int feedAccum4hCandidateStartTime, float feedAccum4hCandidateTop, float feedAccum4hCandidateBottom, int feedAccum4hConfirmedTime, bool feedAccumDNewConfirmedBox, float feedAccumDBoxTop, float feedAccumDBoxBottom, bool feedAccumDCandidateActive, int feedAccumDCandidateStartTime, float feedAccumDCandidateTop, float feedAccumDCandidateBottom, int feedAccumDConfirmedTime, int journalCountIn, bool journalInvariantViolationIn, int nextLastConsumed15mSwingCloseTime, int nextLastConsumed1hSwingCloseTime, int nextLastConsumed1hAccumCloseTime, int nextLastConsumed4hAccumCloseTime, int nextLastConsumedDAccumCloseTime, bool nextAccum1hCandidateActive, int nextAccum1hCandidateStartTime, float nextAccum1hCandidateTop, float nextAccum1hCandidateBottom, bool nextAccum4hCandidateActive, int nextAccum4hCandidateStartTime, float nextAccum4hCandidateTop, float nextAccum4hCandidateBottom, bool nextAccumDCandidateActive, int nextAccumDCandidateStartTime, float nextAccumDCandidateTop, float nextAccumDCandidateBottom) =>
    // ABI usage sink: every argument is referenced (CE10237). Collections add their size (>= 0),
    // scalars add 0 or 1, so the sink is never negative and the error below never fires.
    int abiUseSink = 0
    // Root registry (15)
    abiUseSink += array.size(rootIds) + array.size(rootOriginKeys) + array.size(rootCategories) + array.size(rootSubtypes)
    abiUseSink += array.size(rootTfCodes) + array.size(rootOriginTimes) + array.size(rootOriginEndTimes) + array.size(rootDirections)
    abiUseSink += array.size(rootPointTicks) + array.size(rootSlotLiveFlags) + array.size(rootFreeSlots) + array.size(rootPointPrices)
    abiUseSink += array.size(rootConfirmedTimes) + array.size(rootPairKeys) + array.size(rootSwingTfMasks)
    // journal arrays (23)
    abiUseSink += array.size(journalOps) + array.size(journalGroups) + array.size(journalTargetRootSlots) + array.size(journalExpectedRootIds)
    abiUseSink += array.size(journalCategories) + array.size(journalSubtypes) + array.size(journalTfCodes) + array.size(journalOriginKeys)
    abiUseSink += array.size(journalOriginTimes) + array.size(journalOriginEndTimes) + array.size(journalConfirmedTimes) + array.size(journalPointPrices)
    abiUseSink += array.size(journalNativeBottoms) + array.size(journalNativeTops) + array.size(journalOldStates) + array.size(journalNewStates)
    abiUseSink += array.size(journalFvgFreshFlags) + array.size(journalIsBroadFlags) + array.size(journalDirections) + array.size(journalOldMasks)
    abiUseSink += array.size(journalNewMasks) + array.size(journalPairKeys) + array.size(journalSlopeDirs)
    // origin bucket / index (3)
    abiUseSink += map.size(originKeyBucketHeadRootSlots) + array.size(rootOriginBucketNextRootSlots) + array.size(rootOriginBucketExpectedRootIds)
    // scalars (7)
    abiUseSink += (na(nextRootId) ? 1 : 0) + (na(ema2000SlopeDir) ? 1 : 0) + (na(ema3000SlopeDir) ? 1 : 0) + (na(nextAccumPairKey) ? 1 : 0)
    abiUseSink += (cfgUseMa ? 1 : 0) + (cfgUseSwing ? 1 : 0) + (cfgUseAccum ? 1 : 0)
    // Feed (64)
    abiUseSink += (na(feedMaSourceOpenTime) ? 1 : 0) + (na(feedMaSourceCloseTime) ? 1 : 0) + (na(feedEma2000) ? 1 : 0) + (na(feedEma2000Slope) ? 1 : 0)
    abiUseSink += (na(feedEma3000) ? 1 : 0) + (na(feedEma3000Slope) ? 1 : 0) + (na(feedBaseCloseTime) ? 1 : 0) + (na(feedMintick) ? 1 : 0)
    abiUseSink += (na(feedSrc15mOpenTime) ? 1 : 0) + (na(feedSrc15mCloseTime) ? 1 : 0) + (na(feedSrc1hOpenTime) ? 1 : 0) + (na(feedSrc1hCloseTime) ? 1 : 0)
    abiUseSink += (na(feedSrc4hOpenTime) ? 1 : 0) + (na(feedSrc4hCloseTime) ? 1 : 0) + (na(feedSrcDOpenTime) ? 1 : 0) + (na(feedSrcDCloseTime) ? 1 : 0)
    abiUseSink += (na(feedSwing5mHighPrice) ? 1 : 0) + (na(feedSwing5mHighOriginTime) ? 1 : 0) + (na(feedSwing5mHighOriginEndTime) ? 1 : 0) + (na(feedSwing5mHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing5mLowPrice) ? 1 : 0) + (na(feedSwing5mLowOriginTime) ? 1 : 0) + (na(feedSwing5mLowOriginEndTime) ? 1 : 0) + (na(feedSwing5mLowConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing15mHighPrice) ? 1 : 0) + (na(feedSwing15mHighOriginTime) ? 1 : 0) + (na(feedSwing15mHighOriginEndTime) ? 1 : 0) + (na(feedSwing15mHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing15mLowPrice) ? 1 : 0) + (na(feedSwing15mLowOriginTime) ? 1 : 0) + (na(feedSwing15mLowOriginEndTime) ? 1 : 0) + (na(feedSwing15mLowConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing1hHighPrice) ? 1 : 0) + (na(feedSwing1hHighOriginTime) ? 1 : 0) + (na(feedSwing1hHighOriginEndTime) ? 1 : 0) + (na(feedSwing1hHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing1hLowPrice) ? 1 : 0) + (na(feedSwing1hLowOriginTime) ? 1 : 0) + (na(feedSwing1hLowOriginEndTime) ? 1 : 0) + (na(feedSwing1hLowConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccum1hNewConfirmedBox ? 1 : 0) + (na(feedAccum1hBoxTop) ? 1 : 0) + (na(feedAccum1hBoxBottom) ? 1 : 0) + (feedAccum1hCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccum1hCandidateStartTime) ? 1 : 0) + (na(feedAccum1hCandidateTop) ? 1 : 0) + (na(feedAccum1hCandidateBottom) ? 1 : 0) + (na(feedAccum1hConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccum4hNewConfirmedBox ? 1 : 0) + (na(feedAccum4hBoxTop) ? 1 : 0) + (na(feedAccum4hBoxBottom) ? 1 : 0) + (feedAccum4hCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccum4hCandidateStartTime) ? 1 : 0) + (na(feedAccum4hCandidateTop) ? 1 : 0) + (na(feedAccum4hCandidateBottom) ? 1 : 0) + (na(feedAccum4hConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccumDNewConfirmedBox ? 1 : 0) + (na(feedAccumDBoxTop) ? 1 : 0) + (na(feedAccumDBoxBottom) ? 1 : 0) + (feedAccumDCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccumDCandidateStartTime) ? 1 : 0) + (na(feedAccumDCandidateTop) ? 1 : 0) + (na(feedAccumDCandidateBottom) ? 1 : 0) + (na(feedAccumDConfirmedTime) ? 1 : 0)
    // journal length / violation (2)
    abiUseSink += (na(journalCountIn) ? 1 : 0) + (journalInvariantViolationIn ? 1 : 0)
    // next* (17)
    abiUseSink += (na(nextLastConsumed15mSwingCloseTime) ? 1 : 0) + (na(nextLastConsumed1hSwingCloseTime) ? 1 : 0) + (na(nextLastConsumed1hAccumCloseTime) ? 1 : 0) + (na(nextLastConsumed4hAccumCloseTime) ? 1 : 0)
    abiUseSink += (na(nextLastConsumedDAccumCloseTime) ? 1 : 0) + (nextAccum1hCandidateActive ? 1 : 0) + (na(nextAccum1hCandidateStartTime) ? 1 : 0) + (na(nextAccum1hCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccum1hCandidateBottom) ? 1 : 0) + (nextAccum4hCandidateActive ? 1 : 0) + (na(nextAccum4hCandidateStartTime) ? 1 : 0) + (na(nextAccum4hCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccum4hCandidateBottom) ? 1 : 0) + (nextAccumDCandidateActive ? 1 : 0) + (na(nextAccumDCandidateStartTime) ? 1 : 0) + (na(nextAccumDCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccumDCandidateBottom) ? 1 : 0)
    if abiUseSink < 0
        runtime.error("G2_ABI_PROBE_IMPOSSIBLE")
    [journalCountIn, journalInvariantViolationIn, nextLastConsumed15mSwingCloseTime, nextLastConsumed1hSwingCloseTime, nextLastConsumed1hAccumCloseTime, nextLastConsumed4hAccumCloseTime, nextLastConsumedDAccumCloseTime, nextAccum1hCandidateActive, nextAccum1hCandidateStartTime, nextAccum1hCandidateTop, nextAccum1hCandidateBottom, nextAccum4hCandidateActive, nextAccum4hCandidateStartTime, nextAccum4hCandidateTop, nextAccum4hCandidateBottom, nextAccumDCandidateActive, nextAccumDCandidateStartTime, nextAccumDCandidateTop, nextAccumDCandidateBottom]

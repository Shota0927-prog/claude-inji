//@version=6
// ============================================================
// ZoneEngineV2_W03EMsa_Worker - W03 E-stage MA / Swing / Accum worker
//
// G2 ABI COMPILE PROBE ONLY
// NOT WIRED TO MAIN
// IDENTITY RETURN UNTIL B8
//
// run() carries the final G2 signature (Main w03StageEMaRaw -> w03StageESwingRaw
// -> w03StageEAccumRaw inputs, flattened) so the ABI compiles before the stage
// bodies land. Until B8 it writes nothing and returns every output as its matching
// input; an ABI usage sink (collection sizes, na / bool flags) references every
// argument so the export compiles (CE10237). No import, no type, no persistent storage, no request,
// no drawing.
// ============================================================
library("ZoneEngineV2_W03EMsa_Worker", overlay = false)

// ---- constants : exact copies of the Main declarations ----
const int    FP_MOD           = 2147483647
const int    FP_NA_KEY        = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int    FP_SEED_A        = 16777619
const int    FP_MULT_A        = 1000003
const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int JOP_NEW_ROOT       = 2
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
const int FVG_NONE     = 0
const int JOP_MA_UPDATE      = 3
const int JGROUP_E2 = 2   // NEW_ROOT
const int JGROUP_E3 = 3   // Root update
const int ROOT_ACTIVE         = 1
const int SWING_TF_MASK_NONE = 0
const int SUB_SWING_HIGH   = 1
const int SUB_SWING_LOW    = 2
const int SWING_TF_MASK_5M   = 1
const int SWING_TF_MASK_15M  = 2
const int SWING_TF_MASK_1H   = 4
const int JOP_SWING_TF_MERGE = 4
const int SUB_ACCUM_UPPER  = 1
const int SUB_ACCUM_LOWER  = 2
const int TF_4H  = 240
const int TF_D   = 1440

// Main fpMixInt
fpMixInt(int acc, int mult, int value) =>
    int t  = value % FP_MOD
    int tp = t < 0 ? t + FP_MOD : t
    (acc * mult + tp) % FP_MOD

// Main fpIntKey
fpIntKey(int v) =>
    na(v) ? FP_NA_KEY : v

// Main originKeyComputeRaw
originKeyComputeRaw(int category, int subtype, int tfCode, int pointTick, int originTime, int direction) =>
    int h = FP_SEED_A
    h := fpMixInt(h, FP_MULT_A, fpIntKey(category))
    if category == CAT_MA
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
    else if category == CAT_SWING
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_ACCUM
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_TIME_HL
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_FVG
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(direction))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_PSYCH
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    h == 0 ? 1 : h

// Main originTupleEqualRaw
originTupleEqualRaw(int incomingCategory, int incomingSubtype, int incomingTfCode, int incomingPointTick, int incomingOriginTime, int incomingOriginEndTime, int incomingDirection, int storedCategory, int storedSubtype, int storedTfCode, int storedPointTick, int storedOriginTime, int storedOriginEndTime, int storedDirection) =>
    bool equal = false
    if incomingCategory == CAT_MA
        equal := storedCategory == CAT_MA and incomingTfCode == TF_1M and storedTfCode == TF_1M and not na(incomingSubtype) and incomingSubtype == storedSubtype
    else if incomingCategory == CAT_SWING
        bool tfOk   = (incomingTfCode == TF_5M or incomingTfCode == TF_15M or incomingTfCode == TF_1H) and (storedTfCode == TF_5M or storedTfCode == TF_15M or storedTfCode == TF_1H)
        bool baseOk = storedCategory == CAT_SWING and tfOk and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
        bool timeOk = not na(incomingOriginTime) and not na(incomingOriginEndTime) and not na(storedOriginTime) and not na(storedOriginEndTime)
        if baseOk and timeOk
            if incomingTfCode == storedTfCode
                equal := incomingOriginTime == storedOriginTime and incomingOriginEndTime == storedOriginEndTime
            else if storedTfCode < incomingTfCode
                equal := storedOriginTime >= incomingOriginTime and storedOriginTime < incomingOriginEndTime
            else
                equal := incomingOriginTime >= storedOriginTime and incomingOriginTime < storedOriginEndTime
    else if incomingCategory == CAT_ACCUM
        equal := storedCategory == CAT_ACCUM and not na(incomingTfCode) and incomingTfCode == storedTfCode and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_TIME_HL
        equal := storedCategory == CAT_TIME_HL and incomingTfCode == TF_5M and storedTfCode == TF_5M and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else if incomingCategory == CAT_FVG
        equal := storedCategory == CAT_FVG and not na(incomingTfCode) and incomingTfCode == storedTfCode and (incomingDirection == FVG_BULLISH or incomingDirection == FVG_BEARISH) and incomingDirection == storedDirection and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_PSYCH
        equal := storedCategory == CAT_PSYCH and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    equal

// Main sourceAdoptableRaw
sourceAdoptableRaw(int sourceOpenTime, int sourceCloseTime, int lastConsumedCloseTime, int baseCloseTime) =>
    not na(sourceOpenTime) and not na(sourceCloseTime) and not na(baseCloseTime) and baseCloseTime >= sourceCloseTime and (na(lastConsumedCloseTime) or sourceCloseTime > lastConsumedCloseTime)

// Main maSlopeDirRaw
maSlopeDirRaw(float rawSlope) =>
    int dir = int(na)
    if not na(rawSlope)
        dir := rawSlope > 0 ? 1 : rawSlope < 0 ? -1 : 0
    dir

// W03ETimeFvg journalAppendRaw (flattened Main journalAppendRaw; the caller advances the journal length to row + 1)
journalAppendRaw(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, int journalCountNow, int op, int group, int targetRootSlot, int expectedRootId, int category, int subtype, int tfCode, int originKey, int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom, float nativeTop, int oldState, int newState, bool fvgFresh, bool isBroad, int direction, int oldMask, int newMask, int pairKey, int slopeDir) =>
    int row = journalCountNow
    if row < array.size(journalOps)
        array.set(journalOps,             row, op)
        array.set(journalGroups,          row, group)
        array.set(journalTargetRootSlots, row, targetRootSlot)
        array.set(journalExpectedRootIds, row, expectedRootId)
        array.set(journalCategories,      row, category)
        array.set(journalSubtypes,        row, subtype)
        array.set(journalTfCodes,         row, tfCode)
        array.set(journalOriginKeys,      row, originKey)
        array.set(journalOriginTimes,     row, originTime)
        array.set(journalOriginEndTimes,  row, originEndTime)
        array.set(journalConfirmedTimes,  row, confirmedTime)
        array.set(journalPointPrices,     row, pointPrice)
        array.set(journalNativeBottoms,   row, nativeBottom)
        array.set(journalNativeTops,      row, nativeTop)
        array.set(journalOldStates,       row, oldState)
        array.set(journalNewStates,       row, newState)
        array.set(journalFvgFreshFlags,   row, fvgFresh)
        array.set(journalIsBroadFlags,    row, isBroad)
        array.set(journalDirections,      row, direction)
        array.set(journalOldMasks,        row, oldMask)
        array.set(journalNewMasks,        row, newMask)
        array.set(journalPairKeys,        row, pairKey)
        array.set(journalSlopeDirs,       row, slopeDir)
    else
        array.push(journalOps,             op)
        array.push(journalGroups,          group)
        array.push(journalTargetRootSlots, targetRootSlot)
        array.push(journalExpectedRootIds, expectedRootId)
        array.push(journalCategories,      category)
        array.push(journalSubtypes,        subtype)
        array.push(journalTfCodes,         tfCode)
        array.push(journalOriginKeys,      originKey)
        array.push(journalOriginTimes,     originTime)
        array.push(journalOriginEndTimes,  originEndTime)
        array.push(journalConfirmedTimes,  confirmedTime)
        array.push(journalPointPrices,     pointPrice)
        array.push(journalNativeBottoms,   nativeBottom)
        array.push(journalNativeTops,      nativeTop)
        array.push(journalOldStates,       oldState)
        array.push(journalNewStates,       newState)
        array.push(journalFvgFreshFlags,   fvgFresh)
        array.push(journalIsBroadFlags,    isBroad)
        array.push(journalDirections,      direction)
        array.push(journalOldMasks,        oldMask)
        array.push(journalNewMasks,        newMask)
        array.push(journalPairKeys,        pairKey)
        array.push(journalSlopeDirs,       slopeDir)
    row

// W03ETimeFvg originLookupUniqueRaw (flattened Main originLookupUniqueRaw; returns the violation it detects, the caller ORs it in)
originLookupUniqueRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> journalOps, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<float> journalPointPrices, array<int> journalDirections, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int journalCountNow, int originKey, int category, int subtype, int tfCode, int pointTick, int originTime, int originEndTime, int direction, float mintick) =>
    int  matchCount        = 0
    int  matchedRootSlot   = SLOT_INVALID
    int  matchedPendingRow = SLOT_INVALID
    bool violation         = false
    if originKey != ID_NONE
        if map.contains(originKeyBucketHeadRootSlots, originKey)
            int slot      = map.get(originKeyBucketHeadRootSlots, originKey)
            int stepLimit = array.size(rootIds)
            int steps     = 0
            while slot != SLOT_INVALID and not violation and steps < stepLimit
                bool nodeOk = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootOriginKeys) and slot < array.size(rootOriginBucketNextRootSlots) and slot < array.size(rootOriginBucketExpectedRootIds)
                if nodeOk
                    nodeOk := array.get(rootSlotLiveFlags, slot)
                if nodeOk
                    int bucketRootId = array.get(rootOriginBucketExpectedRootIds, slot)
                    nodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(rootIds, slot) and array.get(rootOriginKeys, slot) == originKey
                if not nodeOk
                    violation := true
                else
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(rootCategories, slot), array.get(rootSubtypes, slot), array.get(rootTfCodes, slot), array.get(rootPointTicks, slot), array.get(rootOriginTimes, slot), array.get(rootOriginEndTimes, slot), array.get(rootDirections, slot))
                        matchCount += 1
                        if matchCount == 1
                            matchedRootSlot := slot
                        else
                            violation := true
                    slot  := array.get(rootOriginBucketNextRootSlots, slot)
                    steps += 1
            if not violation and slot != SLOT_INVALID
                violation := true
        if not violation
            int journalCount = journalCountNow
            int row = 0
            while row < journalCount and not violation
                if array.get(journalOps, row) == JOP_NEW_ROOT and array.get(journalOriginKeys, row) == originKey
                    float pendingPrice = array.get(journalPointPrices, row)
                    int   pendingTick  = na(pendingPrice) ? int(na) : int(math.round(pendingPrice / mintick))
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(journalCategories, row), array.get(journalSubtypes, row), array.get(journalTfCodes, row), pendingTick, array.get(journalOriginTimes, row), array.get(journalOriginEndTimes, row), array.get(journalDirections, row))
                        matchCount += 1
                        if matchCount == 1
                            matchedPendingRow := row
                        else
                            violation := true
                row += 1
    [violation ? SLOT_INVALID : matchedRootSlot, violation ? SLOT_INVALID : matchedPendingRow, violation]

// W03ETimeFvg journalAppliedBeforeRaw (flattened Main journalAppliedBeforeRaw)
journalAppliedBeforeRaw(array<int> journalGroups, int rowA, int rowB) =>
    int groupA = array.get(journalGroups, rowA)
    int groupB = array.get(journalGroups, rowB)
    groupA < groupB or (groupA == groupB and rowA < rowB)

// W03ETimeFvg predictedNewRootSlotRaw (flattened Main predictedNewRootSlotRaw)
predictedNewRootSlotRaw(array<int> rootIds, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, int journalCountNow, int newRow) =>
    int slot = SLOT_INVALID
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCountNow
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        int freeSize = array.size(rootFreeSlots)
        slot := rank < freeSize ? array.get(rootFreeSlots, freeSize - 1 - rank) : array.size(rootIds) + (rank - freeSize)
    slot

// W03ETimeFvg predictedNewRootIdRaw (flattened Main predictedNewRootIdRaw)
predictedNewRootIdRaw(array<int> journalOps, array<int> journalGroups, int nextRootId, int journalCountNow, int newRow) =>
    int rootId = ID_NONE
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCountNow
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        rootId := nextRootId + rank
    rootId

// Main w03StageEMaRaw (flattened: Engine / Cfg / Feed fields as parameters; the journal length and the
// violation flag travel as values and come back as [journalCountOut, journalInvariantViolationOut])
w03StageEMaRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<float> rootPointPrices, array<int> rootConfirmedTimes, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int ema2000SlopeDir, int ema3000SlopeDir, bool cfgUseMa, int feedMaSourceOpenTime, int feedMaSourceCloseTime, float feedEma2000, float feedEma2000Slope, float feedEma3000, float feedEma3000Slope, int feedBaseCloseTime, float feedMintick, int journalCountIn, bool journalInvariantViolationIn) =>
    int  journalCountNow              = journalCountIn
    bool journalInvariantViolationNow = journalInvariantViolationIn
    bool usable  = cfgUseMa and not na(feedMaSourceOpenTime) and not na(feedMaSourceCloseTime) and not na(feedBaseCloseTime) and feedMaSourceCloseTime <= feedBaseCloseTime and not na(feedMintick) and feedMintick > 0
    bool stopped = false
    int  k = 0
    while usable and not stopped and k < 2
        int   subtype  = k == 0 ? SUB_MA_EMA2000 : SUB_MA_EMA3000
        float emaPrice = k == 0 ? feedEma2000 : feedEma3000
        float rawSlope = k == 0 ? feedEma2000Slope : feedEma3000Slope
        int   oldSlope = k == 0 ? ema2000SlopeDir : ema3000SlopeDir
        if not na(emaPrice)
            int pointTick = int(math.round(emaPrice / feedMintick))
            int originKey = originKeyComputeRaw(CAT_MA, subtype, TF_1M, pointTick, feedMaSourceOpenTime, FVG_NONE)
            int newSlope  = maSlopeDirRaw(rawSlope)
            [rootSlot, pendingRow, lookupViolation] = originLookupUniqueRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootDirections, rootPointTicks, rootSlotLiveFlags, journalOps, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalPointPrices, journalDirections, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCountNow, originKey, CAT_MA, subtype, TF_1M, pointTick, feedMaSourceOpenTime, int(na), FVG_NONE, feedMintick)
            if lookupViolation
                journalInvariantViolationNow := true
            if journalInvariantViolationNow
                stopped := true
            else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                int newRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_MA, subtype, TF_1M, originKey, feedMaSourceOpenTime, int(na), feedMaSourceCloseTime, emaPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, SWING_TF_MASK_NONE, ID_NONE, newSlope)
                journalCountNow := newRow + 1
            else if rootSlot != SLOT_INVALID and pendingRow == SLOT_INVALID
                int  expectedRootId   = array.get(rootIds, rootSlot)
                bool priceChanged     = array.get(rootPointPrices, rootSlot) != emaPrice
                bool slopeChanged     = (na(oldSlope) and not na(newSlope)) or (not na(oldSlope) and na(newSlope)) or (not na(oldSlope) and not na(newSlope) and oldSlope != newSlope)
                bool openTimeChanged  = array.get(rootOriginTimes, rootSlot) != feedMaSourceOpenTime
                bool closeTimeChanged = array.get(rootConfirmedTimes, rootSlot) != feedMaSourceCloseTime
                if priceChanged or slopeChanged or openTimeChanged or closeTimeChanged
                    int updateRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_MA_UPDATE, JGROUP_E3, rootSlot, expectedRootId, CAT_MA, subtype, TF_1M, originKey, feedMaSourceOpenTime, int(na), feedMaSourceCloseTime, emaPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, SWING_TF_MASK_NONE, ID_NONE, newSlope)
                    journalCountNow := updateRow + 1
        k += 1
    [journalCountNow, journalInvariantViolationNow]

// Main w03StageESwingRaw (flattened; returns [journalCountOut, journalInvariantViolationOut, lastConsumed15mOut, lastConsumed1hOut])
w03StageESwingRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> rootSwingTfMasks, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextRootId, bool cfgUseSwing, int feedBaseCloseTime, float feedMintick, int feedSrc15mOpenTime, int feedSrc15mCloseTime, int feedSrc1hOpenTime, int feedSrc1hCloseTime, float feedSwing5mHighPrice, int feedSwing5mHighOriginTime, int feedSwing5mHighOriginEndTime, int feedSwing5mHighConfirmedTime, float feedSwing5mLowPrice, int feedSwing5mLowOriginTime, int feedSwing5mLowOriginEndTime, int feedSwing5mLowConfirmedTime, float feedSwing15mHighPrice, int feedSwing15mHighOriginTime, int feedSwing15mHighOriginEndTime, int feedSwing15mHighConfirmedTime, float feedSwing15mLowPrice, int feedSwing15mLowOriginTime, int feedSwing15mLowOriginEndTime, int feedSwing15mLowConfirmedTime, float feedSwing1hHighPrice, int feedSwing1hHighOriginTime, int feedSwing1hHighOriginEndTime, int feedSwing1hHighConfirmedTime, float feedSwing1hLowPrice, int feedSwing1hLowOriginTime, int feedSwing1hLowOriginEndTime, int feedSwing1hLowConfirmedTime, int journalCountIn, bool journalInvariantViolationIn, int nextLastConsumed15mSwingCloseTime, int nextLastConsumed1hSwingCloseTime) =>
    int  journalCountNow              = journalCountIn
    bool journalInvariantViolationNow = journalInvariantViolationIn
    int  out15m   = nextLastConsumed15mSwingCloseTime
    int  out1h    = nextLastConsumed1hSwingCloseTime
    bool stopped  = not cfgUseSwing
    bool adopt15m = false
    bool adopt1h  = false
    int  e = 0
    while not stopped and e < 6
        if e == 2
            adopt15m := sourceAdoptableRaw(feedSrc15mOpenTime, feedSrc15mCloseTime, nextLastConsumed15mSwingCloseTime, feedBaseCloseTime)
            if adopt15m
                out15m := feedSrc15mCloseTime
        if e == 4
            adopt1h := sourceAdoptableRaw(feedSrc1hOpenTime, feedSrc1hCloseTime, nextLastConsumed1hSwingCloseTime, feedBaseCloseTime)
            if adopt1h
                out1h := feedSrc1hCloseTime
        bool  sourceOk      = e < 2 or (e < 4 and adopt15m) or (e >= 4 and adopt1h)
        int   subtype       = e % 2 == 0 ? SUB_SWING_HIGH : SUB_SWING_LOW
        int   tfCode        = e < 2 ? TF_5M : e < 4 ? TF_15M : TF_1H
        int   tfMask        = e < 2 ? SWING_TF_MASK_5M : e < 4 ? SWING_TF_MASK_15M : SWING_TF_MASK_1H
        float pointPrice    = e == 0 ? feedSwing5mHighPrice         : e == 1 ? feedSwing5mLowPrice         : e == 2 ? feedSwing15mHighPrice         : e == 3 ? feedSwing15mLowPrice         : e == 4 ? feedSwing1hHighPrice         : feedSwing1hLowPrice
        int   originTime    = e == 0 ? feedSwing5mHighOriginTime    : e == 1 ? feedSwing5mLowOriginTime    : e == 2 ? feedSwing15mHighOriginTime    : e == 3 ? feedSwing15mLowOriginTime    : e == 4 ? feedSwing1hHighOriginTime    : feedSwing1hLowOriginTime
        int   originEndTime = e == 0 ? feedSwing5mHighOriginEndTime : e == 1 ? feedSwing5mLowOriginEndTime : e == 2 ? feedSwing15mHighOriginEndTime : e == 3 ? feedSwing15mLowOriginEndTime : e == 4 ? feedSwing1hHighOriginEndTime : feedSwing1hLowOriginEndTime
        int   confirmedTime = e == 0 ? feedSwing5mHighConfirmedTime : e == 1 ? feedSwing5mLowConfirmedTime : e == 2 ? feedSwing15mHighConfirmedTime : e == 3 ? feedSwing15mLowConfirmedTime : e == 4 ? feedSwing1hHighConfirmedTime : feedSwing1hLowConfirmedTime
        bool usable = sourceOk and not na(pointPrice) and not na(originTime) and not na(originEndTime) and not na(confirmedTime) and not na(feedBaseCloseTime) and confirmedTime <= feedBaseCloseTime and not na(feedMintick) and feedMintick > 0
        if usable
            int pointTick = int(math.round(pointPrice / feedMintick))
            int originKey = originKeyComputeRaw(CAT_SWING, subtype, tfCode, pointTick, originTime, FVG_NONE)
            [rootSlot, pendingRow, lookupViolation] = originLookupUniqueRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootDirections, rootPointTicks, rootSlotLiveFlags, journalOps, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalPointPrices, journalDirections, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCountNow, originKey, CAT_SWING, subtype, tfCode, pointTick, originTime, originEndTime, FVG_NONE, feedMintick)
            if lookupViolation
                journalInvariantViolationNow := true
            if journalInvariantViolationNow
                stopped := true
            else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                int newRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_SWING, subtype, tfCode, originKey, originTime, originEndTime, confirmedTime, pointPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, SWING_TF_MASK_NONE, tfMask, ID_NONE, int(na))
                journalCountNow := newRow + 1
            else
                int targetSlot  = SLOT_INVALID
                int targetId    = ID_NONE
                int virtualMask = int(na)
                if rootSlot != SLOT_INVALID
                    targetSlot  := rootSlot
                    targetId    := array.get(rootIds, rootSlot)
                    virtualMask := array.get(rootSwingTfMasks, rootSlot)
                else
                    targetSlot  := predictedNewRootSlotRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCountNow, pendingRow)
                    targetId    := predictedNewRootIdRaw(journalOps, journalGroups, nextRootId, journalCountNow, pendingRow)
                    virtualMask := array.get(journalNewMasks, pendingRow)
                int row = 0
                while row < journalCountNow
                    if array.get(journalOps, row) == JOP_SWING_TF_MERGE and array.get(journalTargetRootSlots, row) == targetSlot and array.get(journalExpectedRootIds, row) == targetId
                        virtualMask := array.get(journalNewMasks, row)
                    row += 1
                bool bitOn = int(math.floor(virtualMask / tfMask)) % 2 == 1
                if not bitOn
                    int mergeRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_SWING_TF_MERGE, JGROUP_E3, targetSlot, targetId, CAT_SWING, subtype, tfCode, originKey, originTime, originEndTime, confirmedTime, pointPrice, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, virtualMask, virtualMask + tfMask, ID_NONE, int(na))
                    journalCountNow := mergeRow + 1
        e += 1
    [journalCountNow, journalInvariantViolationNow, out15m, out1h]

// Main w03StageEAccumRaw (flattened; returns [journalCountOut, journalInvariantViolationOut, Accum lastConsumed x3, Accum candidate x12])
w03StageEAccumRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootPairKeys, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextAccumPairKey, bool cfgUseAccum, int feedBaseCloseTime, float feedMintick, int feedSrc1hOpenTime, int feedSrc1hCloseTime, int feedSrc4hOpenTime, int feedSrc4hCloseTime, int feedSrcDOpenTime, int feedSrcDCloseTime, bool feedAccum1hNewConfirmedBox, float feedAccum1hBoxTop, float feedAccum1hBoxBottom, bool feedAccum1hCandidateActive, int feedAccum1hCandidateStartTime, float feedAccum1hCandidateTop, float feedAccum1hCandidateBottom, int feedAccum1hConfirmedTime, bool feedAccum4hNewConfirmedBox, float feedAccum4hBoxTop, float feedAccum4hBoxBottom, bool feedAccum4hCandidateActive, int feedAccum4hCandidateStartTime, float feedAccum4hCandidateTop, float feedAccum4hCandidateBottom, int feedAccum4hConfirmedTime, bool feedAccumDNewConfirmedBox, float feedAccumDBoxTop, float feedAccumDBoxBottom, bool feedAccumDCandidateActive, int feedAccumDCandidateStartTime, float feedAccumDCandidateTop, float feedAccumDCandidateBottom, int feedAccumDConfirmedTime, int journalCountIn, bool journalInvariantViolationIn, int nextLastConsumed1hAccumCloseTime, int nextLastConsumed4hAccumCloseTime, int nextLastConsumedDAccumCloseTime, bool nextAccum1hCandidateActive, int nextAccum1hCandidateStartTime, float nextAccum1hCandidateTop, float nextAccum1hCandidateBottom, bool nextAccum4hCandidateActive, int nextAccum4hCandidateStartTime, float nextAccum4hCandidateTop, float nextAccum4hCandidateBottom, bool nextAccumDCandidateActive, int nextAccumDCandidateStartTime, float nextAccumDCandidateTop, float nextAccumDCandidateBottom) =>
    int  journalCountNow              = journalCountIn
    bool journalInvariantViolationNow = journalInvariantViolationIn
    int   outLastConsumed1hAccumCloseTime = nextLastConsumed1hAccumCloseTime
    int   outLastConsumed4hAccumCloseTime = nextLastConsumed4hAccumCloseTime
    int   outLastConsumedDAccumCloseTime  = nextLastConsumedDAccumCloseTime
    bool  outAccum1hCandidateActive       = nextAccum1hCandidateActive
    int   outAccum1hCandidateStartTime    = nextAccum1hCandidateStartTime
    float outAccum1hCandidateTop          = nextAccum1hCandidateTop
    float outAccum1hCandidateBottom       = nextAccum1hCandidateBottom
    bool  outAccum4hCandidateActive       = nextAccum4hCandidateActive
    int   outAccum4hCandidateStartTime    = nextAccum4hCandidateStartTime
    float outAccum4hCandidateTop          = nextAccum4hCandidateTop
    float outAccum4hCandidateBottom       = nextAccum4hCandidateBottom
    bool  outAccumDCandidateActive        = nextAccumDCandidateActive
    int   outAccumDCandidateStartTime     = nextAccumDCandidateStartTime
    float outAccumDCandidateTop           = nextAccumDCandidateTop
    float outAccumDCandidateBottom        = nextAccumDCandidateBottom
    int   pairKeyCursor = nextAccumPairKey
    bool  stopped       = not cfgUseAccum
    int   t = 0
    while not stopped and t < 3
        int  tfCode      = t == 0 ? TF_1H : t == 1 ? TF_4H : TF_D
        int  srcOpen     = t == 0 ? feedSrc1hOpenTime  : t == 1 ? feedSrc4hOpenTime  : feedSrcDOpenTime
        int  srcClose    = t == 0 ? feedSrc1hCloseTime : t == 1 ? feedSrc4hCloseTime : feedSrcDCloseTime
        int  lastClose   = t == 0 ? outLastConsumed1hAccumCloseTime : t == 1 ? outLastConsumed4hAccumCloseTime : outLastConsumedDAccumCloseTime
        bool adopted     = sourceAdoptableRaw(srcOpen, srcClose, lastClose, feedBaseCloseTime)
        if adopted
            if t == 0
                outLastConsumed1hAccumCloseTime := feedSrc1hCloseTime
                outAccum1hCandidateActive       := feedAccum1hCandidateActive
                outAccum1hCandidateStartTime    := feedAccum1hCandidateStartTime
                outAccum1hCandidateTop          := feedAccum1hCandidateTop
                outAccum1hCandidateBottom       := feedAccum1hCandidateBottom
            else if t == 1
                outLastConsumed4hAccumCloseTime := feedSrc4hCloseTime
                outAccum4hCandidateActive       := feedAccum4hCandidateActive
                outAccum4hCandidateStartTime    := feedAccum4hCandidateStartTime
                outAccum4hCandidateTop          := feedAccum4hCandidateTop
                outAccum4hCandidateBottom       := feedAccum4hCandidateBottom
            else
                outLastConsumedDAccumCloseTime := feedSrcDCloseTime
                outAccumDCandidateActive       := feedAccumDCandidateActive
                outAccumDCandidateStartTime    := feedAccumDCandidateStartTime
                outAccumDCandidateTop          := feedAccumDCandidateTop
                outAccumDCandidateBottom       := feedAccumDCandidateBottom
            bool  newBox        = t == 0 ? feedAccum1hNewConfirmedBox    : t == 1 ? feedAccum4hNewConfirmedBox    : feedAccumDNewConfirmedBox
            float boxTop        = t == 0 ? feedAccum1hBoxTop             : t == 1 ? feedAccum4hBoxTop             : feedAccumDBoxTop
            float boxBottom     = t == 0 ? feedAccum1hBoxBottom          : t == 1 ? feedAccum4hBoxBottom          : feedAccumDBoxBottom
            int   startTime     = t == 0 ? feedAccum1hCandidateStartTime : t == 1 ? feedAccum4hCandidateStartTime : feedAccumDCandidateStartTime
            int   confirmedTime = t == 0 ? feedAccum1hConfirmedTime      : t == 1 ? feedAccum4hConfirmedTime      : feedAccumDConfirmedTime
            bool  usable = newBox and not na(boxTop) and not na(boxBottom) and not na(startTime) and not na(confirmedTime) and not na(feedBaseCloseTime) and confirmedTime <= feedBaseCloseTime and not na(feedMintick) and feedMintick > 0
            if usable
                int upperTick = int(math.round(boxTop    / feedMintick))
                int lowerTick = int(math.round(boxBottom / feedMintick))
                int upperKey  = originKeyComputeRaw(CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperTick, startTime, FVG_NONE)
                int lowerKey  = originKeyComputeRaw(CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerTick, startTime, FVG_NONE)
                [upperSlot, upperPending, upperLookupViolation] = originLookupUniqueRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootDirections, rootPointTicks, rootSlotLiveFlags, journalOps, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalPointPrices, journalDirections, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCountNow, upperKey, CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperTick, startTime, int(na), FVG_NONE, feedMintick)
                if upperLookupViolation
                    journalInvariantViolationNow := true
                int lowerSlot    = SLOT_INVALID
                int lowerPending = SLOT_INVALID
                if not journalInvariantViolationNow
                    [lSlot, lPending, lowerLookupViolation] = originLookupUniqueRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootDirections, rootPointTicks, rootSlotLiveFlags, journalOps, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalPointPrices, journalDirections, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCountNow, lowerKey, CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerTick, startTime, int(na), FVG_NONE, feedMintick)
                    if lowerLookupViolation
                        journalInvariantViolationNow := true
                    lowerSlot    := lSlot
                    lowerPending := lPending
                if journalInvariantViolationNow
                    stopped := true
                else
                    bool upperFound = upperSlot != SLOT_INVALID or upperPending != SLOT_INVALID
                    bool lowerFound = lowerSlot != SLOT_INVALID or lowerPending != SLOT_INVALID
                    if not upperFound and not lowerFound
                        int pairKey  = pairKeyCursor
                        int upperRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_ACCUM, SUB_ACCUM_UPPER, tfCode, upperKey, startTime, int(na), confirmedTime, boxTop, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, 0, 0, pairKey, int(na))
                        journalCountNow := upperRow + 1
                        int lowerRow = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_ACCUM, SUB_ACCUM_LOWER, tfCode, lowerKey, startTime, int(na), confirmedTime, boxBottom, float(na), float(na), ROOT_ACTIVE, ROOT_ACTIVE, false, false, FVG_NONE, 0, 0, pairKey, int(na))
                        journalCountNow := lowerRow + 1
                        pairKeyCursor += 1
                    else if upperFound and lowerFound
                        int upperPair = ID_NONE
                        int lowerPair = ID_NONE
                        if upperSlot != SLOT_INVALID
                            upperPair := array.get(rootPairKeys, upperSlot)
                        else
                            upperPair := array.get(journalPairKeys, upperPending)
                        if lowerSlot != SLOT_INVALID
                            lowerPair := array.get(rootPairKeys, lowerSlot)
                        else
                            lowerPair := array.get(journalPairKeys, lowerPending)
                        if na(upperPair) or na(lowerPair) or upperPair == ID_NONE or upperPair != lowerPair
                            journalInvariantViolationNow := true
                            stopped := true
                    else
                        journalInvariantViolationNow := true
                        stopped := true
        t += 1
    [journalCountNow, journalInvariantViolationNow, outLastConsumed1hAccumCloseTime, outLastConsumed4hAccumCloseTime, outLastConsumedDAccumCloseTime, outAccum1hCandidateActive, outAccum1hCandidateStartTime, outAccum1hCandidateTop, outAccum1hCandidateBottom, outAccum4hCandidateActive, outAccum4hCandidateStartTime, outAccum4hCandidateTop, outAccum4hCandidateBottom, outAccumDCandidateActive, outAccumDCandidateStartTime, outAccumDCandidateTop, outAccumDCandidateBottom]

// ---- export : G2 ABI probe (identity return until B8) ----
// Returns [journalCountOut, violationOut, Swing lastConsumed x2, Accum lastConsumed x3, Accum candidate x12].
export run(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<float> rootPointPrices, array<int> rootConfirmedTimes, array<int> rootPairKeys, array<int> rootSwingTfMasks, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextRootId, int ema2000SlopeDir, int ema3000SlopeDir, int nextAccumPairKey, bool cfgUseMa, bool cfgUseSwing, bool cfgUseAccum, int feedMaSourceOpenTime, int feedMaSourceCloseTime, float feedEma2000, float feedEma2000Slope, float feedEma3000, float feedEma3000Slope, int feedBaseCloseTime, float feedMintick, int feedSrc15mOpenTime, int feedSrc15mCloseTime, int feedSrc1hOpenTime, int feedSrc1hCloseTime, int feedSrc4hOpenTime, int feedSrc4hCloseTime, int feedSrcDOpenTime, int feedSrcDCloseTime, float feedSwing5mHighPrice, int feedSwing5mHighOriginTime, int feedSwing5mHighOriginEndTime, int feedSwing5mHighConfirmedTime, float feedSwing5mLowPrice, int feedSwing5mLowOriginTime, int feedSwing5mLowOriginEndTime, int feedSwing5mLowConfirmedTime, float feedSwing15mHighPrice, int feedSwing15mHighOriginTime, int feedSwing15mHighOriginEndTime, int feedSwing15mHighConfirmedTime, float feedSwing15mLowPrice, int feedSwing15mLowOriginTime, int feedSwing15mLowOriginEndTime, int feedSwing15mLowConfirmedTime, float feedSwing1hHighPrice, int feedSwing1hHighOriginTime, int feedSwing1hHighOriginEndTime, int feedSwing1hHighConfirmedTime, float feedSwing1hLowPrice, int feedSwing1hLowOriginTime, int feedSwing1hLowOriginEndTime, int feedSwing1hLowConfirmedTime, bool feedAccum1hNewConfirmedBox, float feedAccum1hBoxTop, float feedAccum1hBoxBottom, bool feedAccum1hCandidateActive, int feedAccum1hCandidateStartTime, float feedAccum1hCandidateTop, float feedAccum1hCandidateBottom, int feedAccum1hConfirmedTime, bool feedAccum4hNewConfirmedBox, float feedAccum4hBoxTop, float feedAccum4hBoxBottom, bool feedAccum4hCandidateActive, int feedAccum4hCandidateStartTime, float feedAccum4hCandidateTop, float feedAccum4hCandidateBottom, int feedAccum4hConfirmedTime, bool feedAccumDNewConfirmedBox, float feedAccumDBoxTop, float feedAccumDBoxBottom, bool feedAccumDCandidateActive, int feedAccumDCandidateStartTime, float feedAccumDCandidateTop, float feedAccumDCandidateBottom, int feedAccumDConfirmedTime, int journalCountIn, bool journalInvariantViolationIn, int nextLastConsumed15mSwingCloseTime, int nextLastConsumed1hSwingCloseTime, int nextLastConsumed1hAccumCloseTime, int nextLastConsumed4hAccumCloseTime, int nextLastConsumedDAccumCloseTime, bool nextAccum1hCandidateActive, int nextAccum1hCandidateStartTime, float nextAccum1hCandidateTop, float nextAccum1hCandidateBottom, bool nextAccum4hCandidateActive, int nextAccum4hCandidateStartTime, float nextAccum4hCandidateTop, float nextAccum4hCandidateBottom, bool nextAccumDCandidateActive, int nextAccumDCandidateStartTime, float nextAccumDCandidateTop, float nextAccumDCandidateBottom) =>
    // ABI usage sink: every argument is referenced (CE10237). Collections add their size (>= 0),
    // scalars add 0 or 1, so the sink is never negative and the error below never fires.
    int abiUseSink = 0
    // Root registry (15)
    abiUseSink += array.size(rootIds) + array.size(rootOriginKeys) + array.size(rootCategories) + array.size(rootSubtypes)
    abiUseSink += array.size(rootTfCodes) + array.size(rootOriginTimes) + array.size(rootOriginEndTimes) + array.size(rootDirections)
    abiUseSink += array.size(rootPointTicks) + array.size(rootSlotLiveFlags) + array.size(rootFreeSlots) + array.size(rootPointPrices)
    abiUseSink += array.size(rootConfirmedTimes) + array.size(rootPairKeys) + array.size(rootSwingTfMasks)
    // journal arrays (23)
    abiUseSink += array.size(journalOps) + array.size(journalGroups) + array.size(journalTargetRootSlots) + array.size(journalExpectedRootIds)
    abiUseSink += array.size(journalCategories) + array.size(journalSubtypes) + array.size(journalTfCodes) + array.size(journalOriginKeys)
    abiUseSink += array.size(journalOriginTimes) + array.size(journalOriginEndTimes) + array.size(journalConfirmedTimes) + array.size(journalPointPrices)
    abiUseSink += array.size(journalNativeBottoms) + array.size(journalNativeTops) + array.size(journalOldStates) + array.size(journalNewStates)
    abiUseSink += array.size(journalFvgFreshFlags) + array.size(journalIsBroadFlags) + array.size(journalDirections) + array.size(journalOldMasks)
    abiUseSink += array.size(journalNewMasks) + array.size(journalPairKeys) + array.size(journalSlopeDirs)
    // origin bucket / index (3)
    abiUseSink += map.size(originKeyBucketHeadRootSlots) + array.size(rootOriginBucketNextRootSlots) + array.size(rootOriginBucketExpectedRootIds)
    // scalars (7)
    abiUseSink += (na(nextRootId) ? 1 : 0) + (na(ema2000SlopeDir) ? 1 : 0) + (na(ema3000SlopeDir) ? 1 : 0) + (na(nextAccumPairKey) ? 1 : 0)
    abiUseSink += (cfgUseMa ? 1 : 0) + (cfgUseSwing ? 1 : 0) + (cfgUseAccum ? 1 : 0)
    // Feed (64)
    abiUseSink += (na(feedMaSourceOpenTime) ? 1 : 0) + (na(feedMaSourceCloseTime) ? 1 : 0) + (na(feedEma2000) ? 1 : 0) + (na(feedEma2000Slope) ? 1 : 0)
    abiUseSink += (na(feedEma3000) ? 1 : 0) + (na(feedEma3000Slope) ? 1 : 0) + (na(feedBaseCloseTime) ? 1 : 0) + (na(feedMintick) ? 1 : 0)
    abiUseSink += (na(feedSrc15mOpenTime) ? 1 : 0) + (na(feedSrc15mCloseTime) ? 1 : 0) + (na(feedSrc1hOpenTime) ? 1 : 0) + (na(feedSrc1hCloseTime) ? 1 : 0)
    abiUseSink += (na(feedSrc4hOpenTime) ? 1 : 0) + (na(feedSrc4hCloseTime) ? 1 : 0) + (na(feedSrcDOpenTime) ? 1 : 0) + (na(feedSrcDCloseTime) ? 1 : 0)
    abiUseSink += (na(feedSwing5mHighPrice) ? 1 : 0) + (na(feedSwing5mHighOriginTime) ? 1 : 0) + (na(feedSwing5mHighOriginEndTime) ? 1 : 0) + (na(feedSwing5mHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing5mLowPrice) ? 1 : 0) + (na(feedSwing5mLowOriginTime) ? 1 : 0) + (na(feedSwing5mLowOriginEndTime) ? 1 : 0) + (na(feedSwing5mLowConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing15mHighPrice) ? 1 : 0) + (na(feedSwing15mHighOriginTime) ? 1 : 0) + (na(feedSwing15mHighOriginEndTime) ? 1 : 0) + (na(feedSwing15mHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing15mLowPrice) ? 1 : 0) + (na(feedSwing15mLowOriginTime) ? 1 : 0) + (na(feedSwing15mLowOriginEndTime) ? 1 : 0) + (na(feedSwing15mLowConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing1hHighPrice) ? 1 : 0) + (na(feedSwing1hHighOriginTime) ? 1 : 0) + (na(feedSwing1hHighOriginEndTime) ? 1 : 0) + (na(feedSwing1hHighConfirmedTime) ? 1 : 0)
    abiUseSink += (na(feedSwing1hLowPrice) ? 1 : 0) + (na(feedSwing1hLowOriginTime) ? 1 : 0) + (na(feedSwing1hLowOriginEndTime) ? 1 : 0) + (na(feedSwing1hLowConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccum1hNewConfirmedBox ? 1 : 0) + (na(feedAccum1hBoxTop) ? 1 : 0) + (na(feedAccum1hBoxBottom) ? 1 : 0) + (feedAccum1hCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccum1hCandidateStartTime) ? 1 : 0) + (na(feedAccum1hCandidateTop) ? 1 : 0) + (na(feedAccum1hCandidateBottom) ? 1 : 0) + (na(feedAccum1hConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccum4hNewConfirmedBox ? 1 : 0) + (na(feedAccum4hBoxTop) ? 1 : 0) + (na(feedAccum4hBoxBottom) ? 1 : 0) + (feedAccum4hCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccum4hCandidateStartTime) ? 1 : 0) + (na(feedAccum4hCandidateTop) ? 1 : 0) + (na(feedAccum4hCandidateBottom) ? 1 : 0) + (na(feedAccum4hConfirmedTime) ? 1 : 0)
    abiUseSink += (feedAccumDNewConfirmedBox ? 1 : 0) + (na(feedAccumDBoxTop) ? 1 : 0) + (na(feedAccumDBoxBottom) ? 1 : 0) + (feedAccumDCandidateActive ? 1 : 0)
    abiUseSink += (na(feedAccumDCandidateStartTime) ? 1 : 0) + (na(feedAccumDCandidateTop) ? 1 : 0) + (na(feedAccumDCandidateBottom) ? 1 : 0) + (na(feedAccumDConfirmedTime) ? 1 : 0)
    // journal length / violation (2)
    abiUseSink += (na(journalCountIn) ? 1 : 0) + (journalInvariantViolationIn ? 1 : 0)
    // next* (17)
    abiUseSink += (na(nextLastConsumed15mSwingCloseTime) ? 1 : 0) + (na(nextLastConsumed1hSwingCloseTime) ? 1 : 0) + (na(nextLastConsumed1hAccumCloseTime) ? 1 : 0) + (na(nextLastConsumed4hAccumCloseTime) ? 1 : 0)
    abiUseSink += (na(nextLastConsumedDAccumCloseTime) ? 1 : 0) + (nextAccum1hCandidateActive ? 1 : 0) + (na(nextAccum1hCandidateStartTime) ? 1 : 0) + (na(nextAccum1hCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccum1hCandidateBottom) ? 1 : 0) + (nextAccum4hCandidateActive ? 1 : 0) + (na(nextAccum4hCandidateStartTime) ? 1 : 0) + (na(nextAccum4hCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccum4hCandidateBottom) ? 1 : 0) + (nextAccumDCandidateActive ? 1 : 0) + (na(nextAccumDCandidateStartTime) ? 1 : 0) + (na(nextAccumDCandidateTop) ? 1 : 0)
    abiUseSink += (na(nextAccumDCandidateBottom) ? 1 : 0)
    if abiUseSink < 0
        runtime.error("G2_ABI_PROBE_IMPOSSIBLE")
    [journalCountIn, journalInvariantViolationIn, nextLastConsumed15mSwingCloseTime, nextLastConsumed1hSwingCloseTime, nextLastConsumed1hAccumCloseTime, nextLastConsumed4hAccumCloseTime, nextLastConsumedDAccumCloseTime, nextAccum1hCandidateActive, nextAccum1hCandidateStartTime, nextAccum1hCandidateTop, nextAccum1hCandidateBottom, nextAccum4hCandidateActive, nextAccum4hCandidateStartTime, nextAccum4hCandidateTop, nextAccum4hCandidateBottom, nextAccumDCandidateActive, nextAccumDCandidateStartTime, nextAccumDCandidateTop, nextAccumDCandidateBottom]

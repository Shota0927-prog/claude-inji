showDailyVolDebug = input.bool(true, "日足ボラ中央値デバッグ表示", group = GF_DR)
efvgShowTable = input.bool(true,  "FVG環境テーブルを表示", group = GF_EFVG)
efvgShowDebug = input.bool(false, "デバッグ(スコア/状態)を表示", group = GF_EFVG)

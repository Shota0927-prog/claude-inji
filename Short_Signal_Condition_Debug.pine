// ---- 3.x FVG15 Logic (15M FVG反発 → 5M BOS 順序確認) -----------------------
//  この Logic 専用の設定はこの2つだけ。環境認識 / Session / News / ボラ /
//  Accum / Daily Regime / EMAトレンド は上の共通設定をそのまま共有する。
//  15M FVG の反発判定パラメータ (efvgMinThick / reboundDepthMax /
//  reboundRecoverRatio / efvgHold15M / efvg15MTF) も共通のものを使う。
var string GF_F15 = "03 · FVG15 · 15M FVG → 5M BOS"
use15mFvgBosOrder  = input.bool(true, "15M FVG反発後の5M BOSを確認する", group = GF_F15,
     tooltip = "ON: 反発した15M足の開始以降に成立した同方向5M BOSだけを有効とする\n" +
     "     (反発より前に出ていた古いBOSは使わない)。1反発イベントにつきEntryは1回。\n" +
     "OFF: 順序確認なし。15M FVG環境が成立していれば入る。")
bos15mTo5mLookback = input.int(3, "5M BOS Lookback (FVG15専用)", minval = 1, group = GF_F15,
     tooltip = "既存FVG Logicの BOS Lookback とは完全に別。")
fvg15Hold = input.int(18, "FVG15 状態保持本数", minval = 1, group = GF_F15,
     tooltip = "FVG15 Logic が使う15M反発biasの保持本数。\n" +
     "既存5M FVG Logic の FVG環境認識 (15分足FVGを使う) と FVGABS15 は\n" +
     "従来どおり「15M 状態保持本数」(efvgHold15M) を使う。")

// ---- 3.y FVG吸収系列 (FVGABS5 / FVGABS15) ----------------------------------
//  反発系列とは別系列。吸収の定義・品質条件は追加元 FVG Env Signal V と同一。
//  FVG最小厚み (efvgMinThick) と 状態保持本数 (efvgHold5M / efvgHold15M) は
//  上の共通設定をそのまま共有する (重複inputを作らない)。
//  ★ 以下の設定は Long / Short 共通。Short専用の設定は作らない。
//      Long  : Bearish FVG を上方向へ吸収 (陽線 / 実体率 / 終値High寄せ)
//              → Bullish BOS
//      Short : Bullish FVG を下方向へ吸収 (陰線 / 実体率 / 終値Low寄せ)
//              → Bearish BOS
var string GF_ABS = "03 · FVGABS · FVG吸収 → BOS (Long / Short 対称)"
useAbsCandleColor = input.bool(true, "吸収: 方向と同じローソク色を要求", group = GF_ABS)
useAbsBodyFilter  = input.bool(true, "吸収: 最低実体率を要求", group = GF_ABS)
useAbsEdgeFilter  = input.bool(true, "吸収: 終値端寄せを要求", group = GF_ABS)
efvgAbsBodyMin    = input.float(0.50, "吸収 実体最小比率", step = 0.05, group = GF_ABS)
efvgAbsEdge       = input.float(0.60, "吸収 終値端寄せ比率", step = 0.05, group = GF_ABS)
absHold5M         = input.int(12, "FVGABS5 状態保持本数", minval = 1, group = GF_ABS,
     tooltip = "5M吸収bias の保持本数。反発系列の「5M 状態保持本数」(efvgHold5M) とは別。\n" +
     "15M吸収は既存の efvgHold15M を共有する。どちらも Long / Short 共通。")
absBos1mLookback  = input.int(5, "1M BOS Lookback (FVGABS5用)", minval = 1, group = GF_ABS,
     tooltip = "Long は Bullish BOS、Short は Bearish BOS に同じ Lookback を使う。")
absBos5mLookback  = input.int(3,  "5M BOS Lookback (FVGABS15用)", minval = 1, group = GF_ABS,
     tooltip = "Long は Bullish BOS、Short は Bearish BOS に同じ Lookback を使う。")
absVolMin = input.float(0.0,   "日足ボラ中央値 下限 ($ · 以上)", group = GF_ABS,
     tooltip = "吸収系列の環境条件。前日までの直近N本の確定Daily Range中央値で判定する\n" +
     "(既存の日足レジーム計算をそのまま再利用。request は増やしていない)。\n" +
     "Long / Short 共通 (方向に依存しない条件)。")
absVolMax = input.float(100.0, "日足ボラ中央値 上限 ($ · 未満)", group = GF_ABS)

// ---- 3.z Zone 4-Logic (Rebound / FakeBreak / Break Retest / Break) ----------
//  ZoneEngine が生成した既存Zoneをそのまま使う。新しいZone判定は作らない。
//  Zone生成 / Score / Strength / Structural SL / TP のルールは一切変更しない。
//  ここで管理するのは「Entry側のZoneイベント」だけ。
var string GZ_COM = "03 · Zone · 共通設定"
zoneBosMinStrStr = input.string("Medium", "Zone · 対象 最低Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = GZ_COM,
     tooltip = "このStrength以上のZoneだけをイベント追跡の対象にする (4Logic共通)。")
zoneBreakTf      = input.timeframe("5", "Zone · Break判定時間足 (Breakのみ)", group = GZ_COM,
     tooltip = "★ Zoneを「本当にBreakしたか」の確定だけに使う時間足 (既定 5M)。\n" +
     "  ・Short : 確定5M close < Zone下端 - Break Buffer\n" +
     "  ・Long  : 確定5M close > Zone上端 + Break Buffer\n" +
     "ヒゲ抜けも、精密判定時間足 (下の設定) の終値抜けも Break にはならない。\n" +
     "Zone Break / Break Retest / FakeBreak は、この5M Breakが確定するまで始まらない。\n" +
     "★ このStrategyはチャート足 = 5分足前提なので、Break判定時間足は\n" +
     "  チャート足と同じかそれ以上にすること (下位足は想定していない)。")
zoneBosTf        = input.timeframe("1", "Zone · 精密判定時間足 (Break以外の全て)", group = GZ_COM,
     tooltip = "Break以外のZone 4Logic判定をすべてこの足で行う (既定 1M)。\n" +
     "  ・Rebound の接近方向 / 接触 / 離脱 / BOS\n" +
     "  ・Break Retest の再武装距離 / Zone接触 / 反発確認 (Rejection) / BOS\n" +
     "  ・FakeBreak の完全Reclaim / BOS\n" +
     "  ・待機本数 / fakeBreakMaxBars の本数カウント\n" +
     "★ Break だけは上の「Break判定時間足」で判定する。ここでの終値抜けは\n" +
     "  Rebound候補のキャンセルにしか使わない (Rebound の挙動は従来どおり)。\n" +
     "  ・BOS\n" +
     "  ・待機本数 / fakeBreakMaxBars\n" +
     "例) 1M判定でBreak → fakeBreakMaxBars = 10 は1分足10本。\n" +
     "    5M判定なら5分足10本 / 15M判定なら15分足10本。チャート足では数えない。\n" +
     "既存FVGの triggerTF 等とは共有しない Zone系専用設定。")
zoneBosLookback = input.int(3, "Zone · BOS Lookback", minval = 1, group = GZ_COM,
     tooltip = "BOSの定義は既存と同一 (close > ta.highest(high, n)[1] / close < ta.lowest(low, n)[1])。")
//  Zone系専用 日足ボラ設定。判定方式・境界条件は既存Daily Regimeのボラ判定と同一で、
//  参照する「設定値」だけをZone系専用にする。日足データ (drMedianRange) は
//  Section 03 で取得済みのものを共有し、request は増やさない。
zoneBosReqDailyVolatility    = input.string("中ボラ", "Zone · 日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GZ_COM,
     tooltip = "FVG側の「日足ボラ」とは完全に独立。どちらを変えても他方に影響しない。")
zoneBosDailyLowVolThreshold  = input.float(0.0,  "Zone · 低ボラ上限", group = GZ_COM)
zoneBosDailyHighVolThreshold = input.float(120.0, "Zone · 高ボラ下限", group = GZ_COM)
//  Zone系専用 高速ボラ設定。判定式・パラメータ (fastAtrLen / fastAtrMin /
//  fastFixedMin / bodyAvgLen / bodyAvgMin / useRangeRatioFilter / rangeLookback /
//  atrRangeRatioMin) は FVG系列と共有し、「モード」だけをZone系専用にする。
zoneFastVolMode = input.string("OFF", "Zone · 高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = GZ_COM,
     tooltip = "FVG系列の「高速ボラ」とは完全に独立。どちらを変えても他方に影響しない。\n" +
     "OFF のときは高速ボラ条件で Zone 4Logic のEntryを弾かない。\n" +
     "対象: Zone Rebound / Zone FakeBreak / Zone Break Retest / Zone Break。")
zoneBosWaitBars  = input.int(30, "Zone · 待機本数 (精密判定時間足)", minval = 0, group = GZ_COM,
     tooltip = "精密判定時間足 (既定 1M) の本数で数える待機期限。次の3箇所で使う:\n" +
     "  ・Rebound : Zone接近から BOS までの有効期限\n" +
     "  ・Break   : Zone接近から 5M Break確定 までの有効期限\n" +
     "  ・Retest  : Break後の再武装待ちの期限 / Zone接触してから BOS までの期限\n" +
     "既定の 1M × 30本 なら約30分。精密判定時間足を変えるとその時間足基準になる。")

var string GZ_BRK = "03 · Zone · Break / FakeBreak / Retest 共通パラメータ"
zoneBreakBuffer = input.float(2.0, "Break Buffer ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Zone境界を「明確に」抜けたと見なす追加距離。判定は必ず終値:\n" +
     "  Support   : close < zone.bottom - Buffer  → Downside Break\n" +
     "  Resistance: close > zone.top    + Buffer  → Upside Break\n" +
     "ヒゲだけの抜けでは Break にならず、Rebound候補も失効しない。")
fakeBreakMaxBars = input.int(10, "FakeBreak 有効本数 (精密判定時間足)", minval = 1, group = GZ_BRK,
     tooltip = "確定5M Break成立から、元Zoneを完全Reclaimして BOS が出るまでの猶予本数。\n" +
     "★ 起点は「Break判定時間足 (既定 5M) の確定Break」。\n" +
     "  数えるのは「精密判定時間足 (既定 1M)」の本数。\n" +
     "  既定 5M Break → 1分足10本 なら、Break確定から10分以内のReclaimまで有効。\n" +
     "この本数を超えたら FakeBreak候補は破棄する (Retest候補はそのまま生存)。")
retestMinDistance = input.float(5.0, "Retest 再武装 最低距離 ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Break後、Retestを待つ前に Zone からこれ以上離れる必要がある (終値基準)。")
retestZoneWidthMultiplier = input.float(0.0, "Retest 再武装 Zone幅倍率", minval = 0.0, step = 0.1, group = GZ_BRK,
     tooltip = "再武装距離 = max(最低距離, Zone幅 × この倍率)。\n" +
     "Break直後にZone付近をウロウロしているだけのケースを Retest にしないための条件。")
zoneBosMinMoveAway = input.float(0.0, "Rebound 最低離脱距離 ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Rebound専用。Zone接近後、この距離ぶんZoneから離れてからでないとBOSを有効にしない。\n" +
     "  Long  : close >= Support Zoneの上端 + この距離\n" +
     "  Short : close <= Resistance Zoneの下端 - この距離\n" +
     "基準は接近価格ではなくZoneの境界。判定は終値のみ。0 で条件OFF。")



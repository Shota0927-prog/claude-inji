// ============================================================================
//  Short Signal Condition Debug
//  FVG反発 / FVG吸収 / ZONE反発 の Short条件が「今どこまで揃っているか」を
//  リアルタイムで確認するためのデバッグ専用インジケーター。
// ----------------------------------------------------------------------------
//  ★ Standalone Indicator (表示専用) ★
//    ・strategy() ではなく indicator()。strategy.entry / exit / order / close は無し。
//    ・alert() / alertcondition() も一切呼ばない。
//    ・既存の Short Strategy / Main Strategy / Long Debug には影響しない。
//      別スクリプトなので Engine state も共有しない。
//
//  ★ 中身は「FVG + Zone Engine ― Short 専用 Signal Strategy」が正 ★
//    ・Section 01 (input) / 02 (Engine初期化) / 03 (外部データFeed) /
//      04 (SignalEngine呼び出し) は Short Strategy からそのまま持ってきたもの。
//      input名・初期値・Cfg代入・request・Engine更新の順序まで同一。
//    ・方向は Short 専用。enableLong = false / enableShort = true も Strategy と同じ。
//    ・Long Debug の初期値・判定方向・環境設定は一切持ち込んでいない。
//
//  ★ 表示する値はすべて Engine が実際に判定へ使った値 ★
//      FVG反発 Short の侵入率 / 回復位置 / hold / BOS経過本数
//        → sg.efvgReboundDebugConfirmed() が返す Short側 (_rPen / _rRec)。
//          Feed へ入れる bias/reason/rem/bos と同じ 1回の efvgReboundState() 評価。
//          Long側 (_bPen / _bRec) を反転して作ってはいない。
//      Trend Env / 日足ボラ単体 / 日足方向単体 / 通常ボラ / 高速ボラ /
//      Accum 5M内外・15M内外 / Accum離脱方向
//        → fvgSig.dbg*。updateFvg() が判定に使った変数そのもの。
//          Accum離脱方向の Short可否は fvgSig.accumShortDirOk。
//      吸収 Short の bias / eventId / hold残り / hold経過
//        → sg.efvgAbsDebugConfirmed()。bias == -1 が「Bullish FVG を下方向へ吸収」。
//          時間換算・wall-clock推定はしていない。
//      吸収 Short の BOS
//        → absSig.bos5OkS / bos15OkS / previewBos15OkS (Bearish BOS の実判定)。
//      Zone Rebound Short の Zone / 接触 / 反発 / 離脱距離 / BOS / 期限 / Break
//        → zlSig.dbgRbS*。updateZoneEvents() が Rebound Short (side = -1 =
//          Resistance へ下から接近) を判定するときに見ていた「その1件のイベント」。
//          Debug側でZoneを別探索していないので、有効Zoneと追跡中Eventは必ず同一。
//    → 独自BOS計算 (ta.highest / ta.lowest) も独自Zone探索も独自hold計算も無い。
//
//  ★ Standalone なので Strategy の保有ゲートは含まない ★
//    strategy.opentrades / Group保有制御 / maxOpenPerLogic / 反対ポジション制御は
//    Indicator からは参照できない。最終行は「Shortロジック条件」であって
//    「今Entryできる」という意味ではない。
//
//  前提: チャート時間足 = 5分足 (Short Strategy と同じ)。
// ============================================================================

//@version=5
indicator(
     title             = "Short Signal Condition Debug",
     shorttitle        = "SHORT DEBUG",
     overlay           = true,
     dynamic_requests  = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ★★★ Library import ★★★
//  "shota0927-prog" は、Libraryを公開した自分のTradingViewユーザー名に置き換えること。
//  末尾の数字は Library のバージョン。Libraryを再公開するたびに増やす。
//  ★ SignalEngine は FVGABS 追加で更新されている。再Publishした実際のバージョン番号に
//    合わせること (下は「SignalEngine をまだ /2 から再公開していない」前提で /3)。
import sekine3310/ZoneEngine/3   as zn
import sekine3310/SignalEngine/15 as sg

// Library内の定数と同じ値 (定数exportはPineのバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// Logic ID (Entry ID の接頭辞になる)
string LOGIC_FVG   = "FVG"
string LOGIC_FVG15 = "FVG15"
// FVG吸収系列 (反発系列とは別Group)
string LOGIC_FVG_ABS5  = "FVGABS5"
string LOGIC_FVG_ABS15 = "FVGABS15"
// Zone 4系列 (FVG系列とは完全に別Group / 4つとも互いに独立)
//   ZONEREBOUND : Zoneへ接近 → 反発 → BOS
//   ZONEFAKE    : Zone Break → 短時間で完全Reclaim → BOS
//   ZONERETEST  : Zone Break → 十分離れて再武装 → 戻り → 反発 → BOS
//   ZONEBREAK   : Zoneの確定Break そのもの (BOS不要)
string LOGIC_ZONE_RB = "ZONEREBOUND"
string LOGIC_ZONE_FK = "ZONEFAKE"
string LOGIC_ZONE_RT = "ZONERETEST"
string LOGIC_ZONE_BK = "ZONEBREAK"

// 表示用の小さなヘルパー
f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)
f_arrow(int dir) =>
    dir > 0 ? "↑" : dir < 0 ? "↓" : "→"
// Logic ID → 人間が読める名前。
//  ★ 表示・通知専用。Entry判定・Group制御・Entry ID の生成には一切使わない
//    (Entry ID は従来どおり内部IDの LOGIC_* をそのまま接頭辞に使う)。
f_logicName(string logicId) =>
    logicId == LOGIC_FVG        ? "5分FVG反発" :
     logicId == LOGIC_FVG15     ? "15分FVG反発 → 5分BOS" :
     logicId == LOGIC_FVG_ABS5  ? "5分FVG吸収 → 1分BOS" :
     logicId == LOGIC_FVG_ABS15 ? "15分FVG吸収 → 5分BOS" :
     logicId == LOGIC_ZONE_RB   ? "Zone Rebound" :
     logicId == LOGIC_ZONE_FK   ? "Zone FakeBreak" :
     logicId == LOGIC_ZONE_RT   ? "Zone Break Retest" :
     logicId == LOGIC_ZONE_BK   ? "Zone Break" : logicId
// Entry ID の接頭辞から Logic ID を復元する。表示・通知専用。
//  Entry ID は "<LOGIC_ID>_L_<seq>" / "<LOGIC_ID>_S_<seq>" なので、必ず
//  完全な接頭辞で判定する ("FVG15_L_" が "FVG_L_" に一致することはない)。
f_logicIdFromEid(string eid) =>
    string r = ""
    if str.startswith(eid, LOGIC_FVG15 + "_L_") or str.startswith(eid, LOGIC_FVG15 + "_S_")
        r := LOGIC_FVG15
    else if str.startswith(eid, LOGIC_FVG_ABS15 + "_L_") or str.startswith(eid, LOGIC_FVG_ABS15 + "_S_")
        r := LOGIC_FVG_ABS15
    else if str.startswith(eid, LOGIC_FVG_ABS5 + "_L_") or str.startswith(eid, LOGIC_FVG_ABS5 + "_S_")
        r := LOGIC_FVG_ABS5
    else if str.startswith(eid, LOGIC_FVG + "_L_") or str.startswith(eid, LOGIC_FVG + "_S_")
        r := LOGIC_FVG
    else if str.startswith(eid, LOGIC_ZONE_RB + "_L_") or str.startswith(eid, LOGIC_ZONE_RB + "_S_")
        r := LOGIC_ZONE_RB
    else if str.startswith(eid, LOGIC_ZONE_FK + "_L_") or str.startswith(eid, LOGIC_ZONE_FK + "_S_")
        r := LOGIC_ZONE_FK
    else if str.startswith(eid, LOGIC_ZONE_RT + "_L_") or str.startswith(eid, LOGIC_ZONE_RT + "_S_")
        r := LOGIC_ZONE_RT
    else if str.startswith(eid, LOGIC_ZONE_BK + "_L_") or str.startswith(eid, LOGIC_ZONE_BK + "_S_")
        r := LOGIC_ZONE_BK
    r
// 下位足の確定バー配列に true が1つでもあるか (request.security_lower_tf の集約用)
f_anyTrue(array<bool> a) =>
    bool r = false
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            if array.get(a, i)
                r := true
    r

// ============================================================================
// 01. ALL INPUTS
// ----------------------------------------------------------------------------
//  input.* はこのセクションにのみ置く。Engineへの代入は Section 02 で行う。
// ============================================================================

// ============================================================================
// 01-1. COMMON INPUTS
// ============================================================================
// ---- 1.1 Direction (全Logic共通) ------------------------------------------
//  推奨検証手順:  Longのみ / Shortのみ を別々に実行する。
//  TradingView Strategy は単一ネットポジションのため、Long/Short同時ONは
//  完全なヘッジ検証にはならない。
//  ★★ このファイルは Short 専用 ★★
//    方向スイッチは input ではなく定数にして、Longを構造的に発生させない。
//      enableLong  = false → f_submitSignal() / f_canEnter() の dirOk が
//                            dir > 0 で必ず false になる。
//                            → Long は Signal が出ても TradePlan を作らず、
//                              Entry ID も返らない = Long の Entry / Label /
//                              Alert は一切発生しない。
//      enableShort = true  → Short条件は元Strategyとまったく同じ経路を通る。
//    ★ Short の条件式そのものは1行も書き換えていない。
//      Logic ON/OFF / 環境条件 / パラメータは元Strategyと同じ input を残している。
bool enableLong  = false
bool enableShort = true

// ---- 1.2 Logic ON / OFF ----------------------------------------------------
//  Logic単体成績を見たいときは、対象LogicだけONにして Strategy Tester を読む。
//  全部ONにすれば全Logic合算成績になる。
var string G_LOGIC = "01 · Common · Entry Logic ON/OFF"
useFvgLogic = input.bool(true, "Use FVG", group = G_LOGIC,
     tooltip = "既存の 5M FVG Logic (LOGIC_FVG)。15M Logicとは完全に独立。")
useFvg15Logic = input.bool(false, "Use 15M FVG → 5M BOS", group = G_LOGIC,
     tooltip = "15M FVG反発 → その反発15M足の開始以降の5M BOS で入る別Logic (LOGIC_FVG15)。\n" +
     "OFFにすると既存5M FVG単体の成績になる (修正前と完全一致)。")
useFvgAbs5Logic = input.bool(true, "Use 5M FVG Absorption → 1M BOS", group = G_LOGIC,
     tooltip = "Long  : 5M Bearish FVG を上方向へ吸収 → 1M Bullish BOS でLong。\n" +
     "Short : 5M Bullish FVG を下方向へ吸収 → 1M Bearish BOS でShort。\n" +
     "Long / Short は完全対称 (吸収判定・品質条件・Hold・BOS Lookback は共通設定)。\n" +
     "共通の Enable Long / Enable Short を必ず通る。(LOGIC_FVGABS5)")
useFvgAbs15Logic = input.bool(false, "Use 15M FVG Absorption → 5M BOS", group = G_LOGIC,
     tooltip = "Long  : 15M Bearish FVG を上方向へ吸収 → 5M Bullish BOS でLong。\n" +
     "Short : 15M Bullish FVG を下方向へ吸収 → 5M Bearish BOS でShort。\n" +
     "Long / Short は完全対称 (吸収判定・品質条件・Hold・BOS Lookback は共通設定)。\n" +
     "共通の Enable Long / Enable Short を必ず通る。(LOGIC_FVGABS15)")
//  ---- Zone 4系列 (それぞれ完全独立。個別ON/OFF・個別集計) ----------------
useZoneRebound = input.bool(true, "Use Zone Rebound", group = G_LOGIC,
     tooltip = "Support Zone へ「上から」接近 → 反発 → Bullish BOS で Long。\n" +
     "Resistance Zone へ「下から」接近 → 反発 → Bearish BOS で Short。\n" +
     "旧 ZONEBOS の置き換え。接近方向を判定するので、下からSupportを貫通して\n" +
     "上昇するようなケースは Rebound Long にならない。(LOGIC_ZONEREBOUND)")
useZoneFake    = input.bool(false, "Use Zone FakeBreak", group = G_LOGIC,
     tooltip = "Zone Break確定後、fakeBreakMaxBars 以内に元Zoneを完全Reclaim して\n" +
     "BOSが出たら逆方向へ入る (LOGIC_ZONEFAKE)。Zone内へ戻っただけでは成立しない。")
useZoneRetest  = input.bool(false, "Use Zone Break Retest", group = G_LOGIC,
     tooltip = "Zone Break確定 → 再武装距離以上 離れる → Zoneへ戻る → 反発 → BOS\n" +
     "でBreak方向へ入る (LOGIC_ZONERETEST)。Break直後の再接触では発火しない。")
useZoneBreak   = input.bool(false, "Use Zone Break", group = G_LOGIC,
     tooltip = "Zone境界 + Buffer を終値で明確に抜けた瞬間そのものでEntry (LOGIC_ZONEBREAK)。\n" +
     "BOSは要求しない (Zone Break単体の優位性を検証するため)。1 Breakにつき1回。")
//  Zone系のうち1つでもONなら、Zone用の外部データ取得とイベント管理を行う。
bool useZoneAny = useZoneRebound or useZoneFake or useZoneRetest or useZoneBreak
// 新Logicを足したらここに1行追加する:
// useEmaLogic = input.bool(false, "Use EMA Reject", group = G_LOGIC)

// ---- 1.6 Session / News Filter (共通・どのLogicからも参照可) ---------------
var string G_SESS = "01 · Common · Session / News"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = G_SESS)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = G_SESS)
useEUSession     = input.bool(true, "EU 16:00-21:00", group = G_SESS)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = G_SESS)
useNewsTimeFilter = input.bool(false, "重要指標時間を除外", group = G_SESS)
newsSession1 = input.session("2130-2230", "指標除外時間1", group = G_SESS)
newsSession2 = input.session("2330-0030", "指標除外時間2", group = G_SESS)
newsSession3 = input.session("0300-0400", "指標除外時間3", group = G_SESS)

// ============================================================================
// 01-2. ZONE ENGINE INPUTS
// ============================================================================
// ---- 2.1 Zone Geometry -----------------------------------------------------
var string G_ZONE = "02 · Zone Geometry"
zoneHalfWidth = input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE,
     tooltip = "Zone = 中心価格 ± この値。Strengthによって幅は変えない。")

// ---- 2.2 MA Source (1分足コンテキストで直接計算) ---------------------------
var string G_MA = "02 · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_MA,
     tooltip = "既定 1分足。1分足コンテキスト内でMAを計算し、その結果を5分足へ取得する。")
maType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_MA)
useMaSource = input.bool(true, "Enable MA Source", group = G_MA)
// ★ ma1Len / ma2Len / 各TF は request.security・zn.maPack へ渡すため
//   「input変数のまま (simple修飾)」保持する。UDTのフィールド読み出しは series 扱いになり、
//   request.security の timeframe や ta.ema の length には使えないため。
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_MA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_MA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_MA)
scoreMa1 = input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_MA)
scoreMa2 = input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_MA)

// ---- 2.3 MA Slope ----------------------------------------------------------
var string G_SLOPE = "02 · MA Slope"
slopeThrMod = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_SLOPE)
slopeThrStrong = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_SLOPE)
slopeBonusFlat = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_SLOPE)
slopeBonusMod = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_SLOPE)
slopeBonusStr = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_SLOPE)
slopeBonusMode = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster",

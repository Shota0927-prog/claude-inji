// ---- 5.3 Inputs : 環境フィルタ (EMAトレンド) ------------------------------
//  ★ この Trend Env は FVG / FVG15 / FVGABS5 / FVGABS15 で共通。
//    判定は updateFvg() が1度だけ行い、その結果 (FvgSignal.trendOk) を
//    吸収系列も共有する → 判定の二重実装なし・input重複なし・request追加なし。
//  ★ reqTrend は Long / Short 共通の「要求する相場環境」。
//    方向による自動反転は行わない (Short だから下降へ読み替える処理は無い)。
var string GF_ENV = "03 · FVG · Trend Env"
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)", group = GF_ENV,
     tooltip = "FVG / FVG15 / FVGABS5 / FVGABS15 に共通で効く。\n" +
     "OFF にすると 4本すべてで EMA環境フィルターが完全に無効になる。")
reqTrend4H  = input.string("OFF", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4", group = GF_ENV)
tf4H        = input.timeframe("240", "TF", inline = "tf4", group = GF_ENV)
reqTrend1H  = input.string("レンジ", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1", group = GF_ENV)

// ============================================================
//  HTF FVG 環境認識モジュール (シンプル版 / Indicator)
// ============================================================
//  ・各時間足で「最新の FVG ひとつ」だけ保持。
//  ・現在価格(close)が FVG 内なら「FVG内レンジ」として扱う。
//      FVG内       = レンジ
//      上限付近    = ショート環境
//      下限付近    = ロング環境
//  ・ブレイク判定 / iFVG / 近接 / Confluence / 複数保持 は入れない。
//  ・環境認識専用。strategy.entry は使わない。
// ============================================================

//@version=5
indicator(
     title          = "HTF FVG Range (Simple)",
     shorttitle     = "HTF-FVG-S",
     overlay        = true,
     max_bars_back  = 500
 )

// ============================================================
//  対象時間足 ON/OFF
// ============================================================
grpTF = "対象時間足"
useWeeklyFVG = input.bool(true,  "週足 FVG を使う",   group = grpTF)
useDailyFVG  = input.bool(true,  "日足 FVG を使う",   group = grpTF)
use4HFVG     = input.bool(true,  "4時間足 FVG を使う", group = grpTF)
use1HFVG     = input.bool(true,  "1時間足 FVG を使う", group = grpTF)

tfWeekly = input.timeframe("W",   "週足 TF",   group = grpTF)
tfDaily  = input.timeframe("D",   "日足 TF",   group = grpTF)
tf4H     = input.timeframe("240", "4時間足 TF", group = grpTF)
tf1H     = input.timeframe("60",  "1時間足 TF", group = grpTF)

// ============================================================
//  しきい値
// ============================================================
grpParam = "しきい値"
upperThreshold = input.float(0.8, "上限付近 しきい値", minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)
lowerThreshold = input.float(0.2, "下限付近 しきい値", minval = 0.0, maxval = 1.0, step = 0.05, group = grpParam)
htfFVGMaxCount = input.int(10, "未埋めFVG保持数", minval = 1, group = grpParam)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showTable = input.bool(true, "環境テーブルを表示", group = grpDisp)

colInside = input.color(color.new(color.blue,  0), "FVG内 色",   group = grpDisp)
colUpper  = input.color(color.new(color.red,   0), "上限付近 色", group = grpDisp)
colLower  = input.color(color.new(color.green, 0), "下限付近 色", group = grpDisp)
colOff    = input.color(color.new(color.gray, 50), "OFF 色",     group = grpDisp)

// ============================================================
//  未埋めFVG 取得 (request.security の中で各TFの文脈で評価)
//   ・Bullish / Bearish FVG を配列で最大 htfFVGMaxCount 個保持。
//   ・完全に埋められた FVG は filled=true にして判定対象から外す。
//   ・未埋めFVGの中から アクティブFVG を選択
//       優先1: 現在価格がFVG内 / 優先2: 現在価格に最も近い
//   返り値: activeTop, activeBottom, 未埋めFVG数
// ============================================================
f_unfilledFVG() =>
    var array<float> topA    = array.new_float()
    var array<float> botA    = array.new_float()
    var array<int>   barA    = array.new_int()
    var array<bool>  filledA = array.new_bool()
    var array<int>   dirA    = array.new_int()   // 1=Bullish / -1=Bearish (埋め判定用)

    // --- 新規FVG → 配列に追加 (直近 htfFVGMaxCount 個を保持) ---
    // Bullish FVG: low > high[2]  → top=low, bottom=high[2]
    if low > high[2]
        array.push(topA, low)
        array.push(botA, high[2])
        array.push(barA, bar_index)
        array.push(filledA, false)
        array.push(dirA, 1)
        if array.size(topA) > htfFVGMaxCount
            array.shift(topA)
            array.shift(botA)
            array.shift(barA)
            array.shift(filledA)
            array.shift(dirA)
    // Bearish FVG: high < low[2]  → top=low[2], bottom=high
    if high < low[2]
        array.push(topA, low[2])
        array.push(botA, high)
        array.push(barA, bar_index)
        array.push(filledA, false)
        array.push(dirA, -1)
        if array.size(topA) > htfFVGMaxCount
            array.shift(topA)
            array.shift(botA)
            array.shift(barA)
            array.shift(filledA)
            array.shift(dirA)

    int sz = array.size(topA)

    // --- 完全埋め判定 (Bullish: close<bottom / Bearish: close>top) ---
    if sz > 0
        for i = 0 to sz - 1
            if not array.get(filledA, i)
                float t = array.get(topA, i)
                float b = array.get(botA, i)
                bool fill = array.get(dirA, i) == 1 ? close < b : close > t
                if fill
                    array.set(filledA, i, true)

    // --- アクティブFVG選択 (1:内包優先 / 2:最も近い) + 未埋め数 ---
    float bestTop    = na
    float bestBot    = na
    bool  bestInside = false
    float bestDist   = na
    int   cnt        = 0
    if sz > 0
        for i = 0 to sz - 1
            if not array.get(filledA, i)
                cnt += 1
                float t = array.get(topA, i)
                float b = array.get(botA, i)
                bool  ins = close <= t and close >= b
                float dist = ins ? 0.0 : (close > t ? close - t : b - close)
                bool better = na(bestDist) ? true : (ins and not bestInside) ? true : (ins == bestInside and dist < bestDist)
                if better
                    bestTop := t
                    bestBot := b
                    bestInside := ins
                    bestDist := dist

    [bestTop, bestBot, cnt]

// ============================================================
//  FVG内 判定 (チャート側 / 現在価格 px に対して)
//   返り値: inside, zonePos, nearUpper, nearLower, allowShort, allowLong, top, bottom
// ============================================================
f_class(on, top, bot, px) =>
    bool  inside = on and not na(top) and not na(bot) and px >= bot and px <= top
    float zonePos = (inside and (top - bot) > 0) ? (px - bot) / (top - bot) : na
    bool  nearUpper = inside and not na(zonePos) and zonePos >= upperThreshold
    bool  nearLower = inside and not na(zonePos) and zonePos <= lowerThreshold
    bool  allowShort = nearUpper      // 上限付近 = ショート環境
    bool  allowLong  = nearLower      // 下限付近 = ロング環境
    [inside, zonePos, nearUpper, nearLower, allowShort, allowLong, on ? top : na, on ? bot : na]

// ============================================================
//  各時間足の未埋めFVGを取得 → アクティブFVGでFVG内判定
// ============================================================
[wTopRaw, wBotRaw, wCntRaw] = request.security(syminfo.tickerid, tfWeekly, f_unfilledFVG(), lookahead = barmerge.lookahead_off)
[dTopRaw, dBotRaw, dCntRaw] = request.security(syminfo.tickerid, tfDaily,  f_unfilledFVG(), lookahead = barmerge.lookahead_off)
[f4TopRaw, f4BotRaw, f4CntRaw] = request.security(syminfo.tickerid, tf4H,   f_unfilledFVG(), lookahead = barmerge.lookahead_off)
[f1TopRaw, f1BotRaw, f1CntRaw] = request.security(syminfo.tickerid, tf1H,   f_unfilledFVG(), lookahead = barmerge.lookahead_off)

[weeklyInside, weeklyZonePosition, weeklyNearUpper, weeklyNearLower, weeklyAllowShort, weeklyAllowLong, weeklyTop, weeklyBottom] = f_class(useWeeklyFVG, wTopRaw, wBotRaw, close)
[dailyInside, dailyZonePosition, dailyNearUpper, dailyNearLower, dailyAllowShort, dailyAllowLong, dailyTop, dailyBottom] = f_class(useDailyFVG, dTopRaw, dBotRaw, close)
[h4Inside, h4ZonePosition, h4NearUpper, h4NearLower, h4AllowShort, h4AllowLong, h4Top, h4Bottom] = f_class(use4HFVG, f4TopRaw, f4BotRaw, close)
[h1Inside, h1ZonePosition, h1NearUpper, h1NearLower, h1AllowShort, h1AllowLong, h1Top, h1Bottom] = f_class(use1HFVG, f1TopRaw, f1BotRaw, close)

// アクティブFVG ゾーン (= f_class が返す masked top/bottom) と 未埋めFVG数
float weeklyActiveTop = weeklyTop
float weeklyActiveBottom = weeklyBottom
float dailyActiveTop = dailyTop
float dailyActiveBottom = dailyBottom
float h4ActiveTop = h4Top
float h4ActiveBottom = h4Bottom
float h1ActiveTop = h1Top
float h1ActiveBottom = h1Bottom

int weeklyUnfilledCount = useWeeklyFVG ? wCntRaw : 0
int dailyUnfilledCount  = useDailyFVG  ? dCntRaw : 0
int h4UnfilledCount     = use4HFVG     ? f4CntRaw : 0
int h1UnfilledCount     = use1HFVG     ? f1CntRaw : 0

// ============================================================
//  統合出力
// ============================================================
bool isRangeByHTFFVG    = weeklyInside    or dailyInside    or h4Inside    or h1Inside
bool allowShortByHTFFVG = weeklyAllowShort or dailyAllowShort or h4AllowShort or h1AllowShort
bool allowLongByHTFFVG  = weeklyAllowLong  or dailyAllowLong  or h4AllowLong  or h1AllowLong

// ============================================================
//  表示 : テーブル
// ============================================================
// 状態色 (OFF→グレー / 上限付近→赤 / 下限付近→緑 / FVG内→青)
f_stateCol(on, inside, nu, nl) =>
    not on ? colOff : nu ? colUpper : nl ? colLower : inside ? colInside : color.new(color.gray, 80)

f_b(b) =>
    b ? "✓" : "-"

f_pct(on, zp) =>
    (on and not na(zp)) ? str.tostring(math.round(zp * 100)) + "%" : "-"

var table tbl = table.new(position.top_right, 7, 5, border_width = 1)

f_row(row, name, on, inside, zp, nu, nl, aLong, aShort) =>
    color sc = f_stateCol(on, inside, nu, nl)
    table.cell(tbl, 0, row, name,          text_color = color.white, bgcolor = sc)
    table.cell(tbl, 1, row, on ? f_b(inside) : "off", text_color = color.white, bgcolor = sc)
    table.cell(tbl, 2, row, f_pct(on, zp), text_color = color.white)
    table.cell(tbl, 3, row, f_b(nu),       text_color = color.white)
    table.cell(tbl, 4, row, f_b(nl),       text_color = color.white)
    table.cell(tbl, 5, row, f_b(aLong),    text_color = color.white)
    table.cell(tbl, 6, row, f_b(aShort),   text_color = color.white)

if showTable and barstate.islast
    table.cell(tbl, 0, 0, "TF",         text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 1, 0, "Inside",     text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 2, 0, "Position %", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 3, 0, "Near Upper", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 4, 0, "Near Lower", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 5, 0, "Long OK",    text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(tbl, 6, 0, "Short OK",   text_color = color.white, bgcolor = color.new(color.black, 0))
    f_row(1, "Weekly", useWeeklyFVG, weeklyInside, weeklyZonePosition, weeklyNearUpper, weeklyNearLower, weeklyAllowLong, weeklyAllowShort)
    f_row(2, "Daily",  useDailyFVG,  dailyInside,  dailyZonePosition,  dailyNearUpper,  dailyNearLower,  dailyAllowLong,  dailyAllowShort)
    f_row(3, "4H",     use4HFVG,     h4Inside,     h4ZonePosition,     h4NearUpper,     h4NearLower,     h4AllowLong,     h4AllowShort)
    f_row(4, "1H",     use1HFVG,     h1Inside,     h1ZonePosition,     h1NearUpper,     h1NearLower,     h1AllowLong,     h1AllowShort)

// ============================================================
//  プロット (接続用 : data_window)
// ============================================================
plot(weeklyZonePosition, "weeklyZonePosition", display = display.data_window)
plot(dailyZonePosition,  "dailyZonePosition",  display = display.data_window)
plot(h4ZonePosition,     "h4ZonePosition",     display = display.data_window)
plot(h1ZonePosition,     "h1ZonePosition",     display = display.data_window)

plot(isRangeByHTFFVG    ? 1 : 0, "isRangeByHTFFVG",    display = display.data_window)
plot(allowLongByHTFFVG  ? 1 : 0, "allowLongByHTFFVG",  display = display.data_window)
plot(allowShortByHTFFVG ? 1 : 0, "allowShortByHTFFVG", display = display.data_window)

// アクティブFVG ゾーン
plot(weeklyActiveTop,    "weeklyActiveTop",    display = display.data_window)
plot(weeklyActiveBottom, "weeklyActiveBottom", display = display.data_window)
plot(dailyActiveTop,     "dailyActiveTop",     display = display.data_window)
plot(dailyActiveBottom,  "dailyActiveBottom",  display = display.data_window)
plot(h4ActiveTop,        "h4ActiveTop",        display = display.data_window)
plot(h4ActiveBottom,     "h4ActiveBottom",     display = display.data_window)
plot(h1ActiveTop,        "h1ActiveTop",        display = display.data_window)
plot(h1ActiveBottom,     "h1ActiveBottom",     display = display.data_window)

// 未埋めFVG数
plot(weeklyUnfilledCount, "weeklyUnfilledCount", display = display.data_window)
plot(dailyUnfilledCount,  "dailyUnfilledCount",  display = display.data_window)
plot(h4UnfilledCount,     "h4UnfilledCount",     display = display.data_window)
plot(h1UnfilledCount,     "h1UnfilledCount",     display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(isRangeByHTFFVG,    "HTF FVG Range",  "{{ticker}} いずれかの時間足で FVG内レンジ")
alertcondition(allowLongByHTFFVG,  "HTF Long Env",   "{{ticker}} FVG下限付近 ロング環境")
alertcondition(allowShortByHTFFVG, "HTF Short Env",  "{{ticker}} FVG上限付近 ショート環境")
alertcondition(weeklyInside, "Weekly Inside", "{{ticker}} 週足 FVG内")
alertcondition(dailyInside,  "Daily Inside",  "{{ticker}} 日足 FVG内")
alertcondition(h4Inside,     "4H Inside",     "{{ticker}} 4時間足 FVG内")
alertcondition(h1Inside,     "1H Inside",     "{{ticker}} 1時間足 FVG内")

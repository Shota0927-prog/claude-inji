     "(既存の日足レジーム計算をそのまま再利用。request は増やしていない)。\n" +
     "Long / Short 共通 (方向に依存しない条件)。")
absVolMax = input.float(100.0, "日足ボラ中央値 上限 ($ · 未満)", group = GF_ABS)

// ---- 3.z Zone 4-Logic (Rebound / FakeBreak / Break Retest / Break) ----------
//  ZoneEngine が生成した既存Zoneをそのまま使う。新しいZone判定は作らない。
//  Zone生成 / Score / Strength / Structural SL / TP のルールは一切変更しない。
//  ここで管理するのは「Entry側のZoneイベント」だけ。
var string GZ_COM = "03 · Zone · 共通設定"
//  ★ Practical Strategy 新仕様: Zone Signal 用 snapshot の最低 Strength (既定 Strong)。
//    旧Main の「Zone · 対象 最低Strength」(既定 Medium) を置き換える (意図的差分)。
zoneSignalMinStrStr = input.string("Strong", "Zone Signal · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = GZ_COM,
     tooltip = "このStrength以上の Support / Resistance Zone だけを Zone 4Logic のイベント追跡対象にする (4Logic共通)。")
zoneBreakTf      = input.timeframe("5", "Zone · Break判定時間足 (Breakのみ)", group = GZ_COM,
     tooltip = "★ Zoneを「本当にBreakしたか」の確定だけに使う時間足 (既定 5M)。\n" +
     "  ・Short : 確定5M close < Zone下端 - Break Buffer\n" +
     "  ・Long  : 確定5M close > Zone上端 + Break Buffer\n" +
     "ヒゲ抜けも、精密判定時間足 (下の設定) の終値抜けも Break にはならない。\n" +
     "Zone Break / Break Retest / FakeBreak は、この5M Breakが確定するまで始まらない。\n" +
     "★ このStrategyはチャート足 = 5分足前提なので、Break判定時間足は\n" +
     "  チャート足と同じかそれ以上にすること (下位足は想定していない)。")
zoneBosTf        = input.timeframe("1", "Zone · 精密判定時間足 (Break以外の全て)", group = GZ_COM,
     tooltip = "Break以外のZone 4Logic判定をすべてこの足で行う (既定 1M)。\n" +
     "  ・Rebound の接近方向 / 接触 / 離脱 / BOS\n" +
     "  ・Break Retest の再武装距離 / Zone接触 / 反発確認 (Rejection) / BOS\n" +
     "  ・FakeBreak の完全Reclaim / BOS\n" +
     "  ・待機本数 / fakeBreakMaxBars の本数カウント\n" +
     "★ Break だけは上の「Break判定時間足」で判定する。ここでの終値抜けは\n" +
     "  Rebound候補のキャンセルにしか使わない (Rebound の挙動は従来どおり)。\n" +
     "  ・BOS\n" +
     "  ・待機本数 / fakeBreakMaxBars\n" +
     "例) 1M判定でBreak → fakeBreakMaxBars = 10 は1分足10本。\n" +
     "    5M判定なら5分足10本 / 15M判定なら15分足10本。チャート足では数えない。\n" +
     "既存FVGの triggerTF 等とは共有しない Zone系専用設定。")
zoneBosLookback = input.int(3, "Zone · BOS Lookback", minval = 1, group = GZ_COM,
     tooltip = "BOSの定義は既存と同一 (close > ta.highest(high, n)[1] / close < ta.lowest(low, n)[1])。")
//  Zone系専用 日足ボラ設定。判定方式・境界条件は既存Daily Regimeのボラ判定と同一で、
//  参照する「設定値」だけをZone系専用にする。日足データ (drMedianRange) は
//  Section 03 で取得済みのものを共有し、request は増やさない。
zoneBosReqDailyVolatility    = input.string("中ボラ", "Zone · 日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GZ_COM,
     tooltip = "FVG側の「日足ボラ」とは完全に独立。どちらを変えても他方に影響しない。")
zoneBosDailyLowVolThreshold  = input.float(0.0,  "Zone · 低ボラ上限", group = GZ_COM)
zoneBosDailyHighVolThreshold = input.float(80.0, "Zone · 高ボラ下限", group = GZ_COM)
//  Zone系専用 高速ボラ設定。判定式・パラメータ (fastAtrLen / fastAtrMin /
//  fastFixedMin / bodyAvgLen / bodyAvgMin / useRangeRatioFilter / rangeLookback /
//  atrRangeRatioMin) は FVG系列と共有し、「モード」だけをZone系専用にする。
zoneFastVolMode = input.string("OFF", "Zone · 高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = GZ_COM,
     tooltip = "FVG系列の「高速ボラ」とは完全に独立。どちらを変えても他方に影響しない。\n" +
     "OFF のときは高速ボラ条件で Zone 4Logic のEntryを弾かない。\n" +
     "対象: Zone Rebound / Zone FakeBreak / Zone Break Retest / Zone Break。")
zoneBosWaitBars  = input.int(30, "Zone · 待機本数 (精密判定時間足)", minval = 0, group = GZ_COM,
     tooltip = "精密判定時間足 (既定 1M) の本数で数える待機期限。次の3箇所で使う:\n" +
     "  ・Rebound : Zone接近から BOS までの有効期限\n" +
     "  ・Break   : Zone接近から 5M Break確定 までの有効期限\n" +
     "  ・Retest  : Break後の再武装待ちの期限 / Zone接触してから BOS までの期限\n" +
     "既定の 1M × 30本 なら約30分。精密判定時間足を変えるとその時間足基準になる。")

var string GZ_BRK = "03 · Zone · Break / FakeBreak / Retest 共通パラメータ"
zoneBreakBuffer = input.float(3.0, "Break Buffer ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Zone境界を「明確に」抜けたと見なす追加距離。判定は必ず終値:\n" +
     "  Support   : close < zone.bottom - Buffer  → Downside Break\n" +
     "  Resistance: close > zone.top    + Buffer  → Upside Break\n" +
     "ヒゲだけの抜けでは Break にならず、Rebound候補も失効しない。")
fakeBreakMaxBars = input.int(10, "FakeBreak 有効本数 (精密判定時間足)", minval = 1, group = GZ_BRK,
     tooltip = "確定5M Break成立から、元Zoneを完全Reclaimして BOS が出るまでの猶予本数。\n" +
     "★ 起点は「Break判定時間足 (既定 5M) の確定Break」。\n" +
     "  数えるのは「精密判定時間足 (既定 1M)」の本数。\n" +
     "  既定 5M Break → 1分足10本 なら、Break確定から10分以内のReclaimまで有効。\n" +
     "この本数を超えたら FakeBreak候補は破棄する (Retest候補はそのまま生存)。")
retestMinDistance = input.float(10.0, "Retest 再武装 最低距離 ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Break後、Retestを待つ前に Zone からこれ以上離れる必要がある (終値基準)。")
retestZoneWidthMultiplier = input.float(0.5, "Retest 再武装 Zone幅倍率", minval = 0.0, step = 0.1, group = GZ_BRK,
     tooltip = "再武装距離 = max(最低距離, Zone幅 × この倍率)。\n" +
     "Break直後にZone付近をウロウロしているだけのケースを Retest にしないための条件。")
zoneBosMinMoveAway = input.float(0.0, "Rebound 最低離脱距離 ($)", minval = 0.0, step = 0.5, group = GZ_BRK,
     tooltip = "Rebound専用。回復位置 (下の Zone比率) から さらにこの距離ぶん離れてから\n" +
     "でないとBOSを有効にしない。\n" +
     "  Long  : close >= 回復位置 + この距離\n" +
     "  Short : close <= 回復位置 - この距離\n" +
     "判定は終値のみ。\n" +
     "★ 「Rebound 回復位置 (Zone比率) = 1.00 かつ この値 = 0」のときだけ\n" +
     "  従来どおり条件OFF (無条件で有効) になる。既定値はこの組み合わせ。")
//  ★ Rebound の最低回復位置を Zone幅比率で指定する (A/Bテスト用) ★
//    Zone境界固定だった判定を、Zone内の任意の位置へ動かせるようにしたもの。
//      Long  (Support Zone)    : 0.00 = Zone下端 / 0.50 = 中央値 / 1.00 = Zone上端【従来】
//      Short (Resistance Zone) : 0.00 = Zone上端 / 0.50 = 中央値 / 1.00 = Zone下端【従来】
//    基準価格
//      reboundBaseLong  = zoneBottom + (zoneTop - zoneBottom) * ratio
//      reboundBaseShort = zoneTop    - (zoneTop - zoneBottom) * ratio
//    最終条件 (zoneBosMinMoveAway は従来どおり追加距離として適用)
//      Long  : close >= reboundBaseLong  + zoneBosMinMoveAway
//      Short : close <= reboundBaseShort - zoneBosMinMoveAway
//    ★ 既定 1.00 = 従来と完全一致。
//    ★ 接触 / 接近方向 / BOS / 待機期限 / Break による候補失効など、Rebound の
//      その他の状態遷移は一切変更していない。変わるのは最低回復位置だけ。
zoneReboundRecoveryRatio = input.float(1.00, "Rebound 回復位置 (Zone比率)", minval = 0.0, maxval = 1.0, step = 0.25, group = GZ_BRK,
     tooltip = "Rebound で BOS を有効にする前に、価格がZone内のどこまで戻れば良いかを\n" +
     "Zone幅に対する比率で指定する。Long / Short は完全対称。\n" +
     "  Long  (Support Zone)    : 0.00 = Zone下端 / 0.50 = 中央値 / 1.00 = Zone上端\n" +
     "  Short (Resistance Zone) : 0.00 = Zone上端 / 0.50 = 中央値 / 1.00 = Zone下端\n" +
     "1.00 = 従来と完全一致 (既定)。\n" +
     "この基準価格に「Rebound 最低離脱距離」が追加距離として足される。")


var string GZ_BKP = "03 · Zone Break · 専用パラメータ (ZONEBREAKのみ)"
//  ★ ここは LOGIC_ZONEBREAK の Entry判定にだけ効く上書き設定 ★
//    Zone Rebound / Zone FakeBreak / Zone Break Retest が参照する
//    「03 · Zone · 共通設定」(zoneBosWaitBars / zoneBosReqDailyVolatility /
//     zoneBosDailyLowVolThreshold / zoneBosDailyHighVolThreshold) は
//    一切変更していない。共通設定を書き換えると他3Logicの結果まで変わるため、
//    値が異なるものだけを Zone Break 専用として分離した。
//  ★ 分離していないもの (共通設定の現在値が検証時の値と一致しているため):
//      Zone · Break判定時間足        = 5      (zoneBreakTf)
//      Break Buffer                  = 3.0    (zoneBreakBuffer)
//      Zone · 高速ボラ               = OFF    (zoneFastVolMode)
//      Zone Signal · Min Strength    = Strong (zoneSignalMinStrStr, Practical 新仕様)
//  ★ ZoneEngine の Break判定 / Zone State管理は分離していない。
//    分離したのは「ZONEBREAK の Entry判定に使う設定」だけ。
zoneBreakEntryWaitBars = input.int(10000, "Zone Break · 待機本数 (精密判定時間足)", minval = 0, group = GZ_BKP,
     tooltip = "Zone接近から 5M Break確定 までの有効期限を Zone Break だけ別に持つ。\n" +
     "共通設定の「Zone · 待機本数」は Rebound / FakeBreak / Break Retest 用のまま。\n" +
     "★ 共通 待機本数 を超えてから Break したイベントは Zone Break のSignalだけを出し、\n" +
     "  FakeBreak / Break Retest の候補には一切ならない (他3Logicの結果は不変)。")
zoneBreakEntryDailyVolatility    = input.string("中ボラ", "Zone Break · 日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GZ_BKP,
     tooltip = "判定方式・境界条件は共通設定と完全に同一で、参照する値だけ Zone Break 専用。")
zoneBreakEntryDailyLowVolThreshold  = input.float(0.0,   "Zone Break · 低ボラ上限", group = GZ_BKP)
zoneBreakEntryDailyHighVolThreshold = input.float(100.0, "Zone Break · 高ボラ下限", group = GZ_BKP)

var string GZ_BLC = "03 · Zone Break Long · Reference Compatibility"
//  ★ 旧基準ファイル (ZoneEngine/3 + SignalEngine/13 時代) の Zone Break Long と
//    同じ結果を出すための互換設定。効く範囲は「Zone Break の Long側だけ」。
//    ・Zone Break Short          … 一切変わらない (共通/Break共通設定のまま)
//    ・Zone Rebound / FakeBreak / Break Retest … 一切変わらない
//    ・FVG / FVG15 / FVGABS5 / FVGABS15        … 一切変わらない
//    ・Zone生成 / Score / Strength / Break・Flip State … 一切変わらない
//  ★ 互換モード OFF にすると、下の全項目が参照されなくなり、
//    Zone Break Long も共通側の設定 (現行の挙動) へ完全に戻る。
//  ★ Accum は「検出処理」を変えていない。Zone Break Long の Entry判定で
//    その結果を見ないようにするだけなので、他Logicの Accum 判定は不変。
breakLongRefCompat = input.bool(true, "Reference Compatibility Mode", group = GZ_BLC,
     tooltip = "ON のとき、Zone Break Long の Entry判定だけを旧基準ファイルと同じ設定で行う。\n" +
     "OFF にすると Zone Break Long も共通 / Zone Break共通 の設定へ戻る。")
breakLongWaitBars = input.int(10000, "Long · 待機本数 (精密判定時間足)", minval = 0, group = GZ_BLC,
     tooltip = "Zone接近から 5M Break確定 までの有効期限 (Long Break候補 = Resistance Zone のみ)。\n" +
     "Short Break候補 (Support Zone) は Zone Break 共通の待機本数のまま。")
breakLongDailyVolatility     = input.string("中ボラ", "Long · 日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GZ_BLC)
breakLongDailyLowVolThreshold  = input.float(0.0,   "Long · 低ボラ上限",  group = GZ_BLC)
breakLongDailyHighVolThreshold = input.float(100.0, "Long · 高ボラ下限", group = GZ_BLC)
breakLongUseAccumNoTrade   = input.bool(false, "Long · Accum NoTrade",   group = GZ_BLC,
     tooltip = "OFF = Zone Break Long の Entry判定で Accum NoTrade を見ない。\n" +
     "Accum の検出処理そのものは変えないので、他Logicには影響しない。")
breakLongUseAccumExitWait  = input.bool(false, "Long · Accum離脱待機",   group = GZ_BLC)
breakLongUseAccumDirection = input.bool(false, "Long · Accum離脱方向",   group = GZ_BLC)
breakLongBreakEvenTrigger  = input.float(10.0, "Long · 建値移動開始幅 ($)", step = 0.1, group = GZ_BLC,
     tooltip = "Zone Break Long (logicId ZONEBREAK かつ Long) のTradeにだけ使う。\n" +
     "他の Zone系 (Zone Break Short を含む) は「Zone系 建値移動開始幅」のまま。")
breakLongTpDepthRatio = input.float(0.0, "Long · Structural TP Zone Depth", minval = 0.0, maxval = 1.0, step = 0.25, group = GZ_BLC,
     tooltip = "Zone Break Long の Structural TP にだけ使う Zone内TP位置。\n" +
     "0.00 = TP Zone の手前端 (旧基準ファイルと同じ)。\n" +
     "★ 共通の Structural TP Zone Depth は書き換えないので、他Logicは不変。")


reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m", group = GF_ENV)
tf1M        = input.timeframe("1",   "TF", inline = "tf1m", group = GF_ENV)


// ============================================================================
//  Zone Strategy GBPUSD  —  ZONE-GBPUSD (ZoneVisualGBPUSD) の Zone 判定を使う OANDA:GBPUSD 5分足 Strategy
//  GU-1: ZONE-ST-EURUSD (ZoneStrategyEURUSD) からの移植 (生成: tests/gu_build.py、差分は fixture gu_sim が固定)。
//  Entry A / B / C / D・1分足 BOS・取消・優先順位・同一 Track の再 Entry 制限・注文 / SL / TP / 建値の処理順と
//  タイミング・数量計算 (円の損失予算 → strategy.convert_to_symbol → USD、SL 距離 × syminfo.pointvalue、lot 刻みで
//  切り捨て。数量の単位は GBP)・仮 / 確定アラート・ラベルは EURUSD 版と同じ式。Zone 初期値は ZONE-GBPUSD と共通。
//  初期設定: Entry B: Confirmed Rejection、Direction Both (Long Only / Short Only・A〜D は選択可)、固定 RR 1.5、
//  SL Buffer 3 pips、Zone TP / 建値移動 OFF、新規 Entry 09:00〜翌 02:00 (Asia/Tokyo)、300,000 円・3 %・単利。
//  価格差は USD (1 pip = 0.0001)。初期値は EURUSD 確定版 (47aeb8b) から引き継いだ比較開始用初期値で、GBPUSD では
//  未検証 (検証済み・最適化済みの値ではない。EURUSD の成績は GBPUSD の実績ではない)。
//  RN (初期 OFF): ticker GBPUSD のとき大刻み 0.0100 +3 / 小刻み 0.0050 +2 (tick 整数での包含判定・刻み検証は EURUSD 版と同じ)。
//  以下は移植元 EURUSD 版の説明 (EURUSD の経緯・数値):
//  Zone Strategy EURUSD  —  ZONE-EURUSD (ZoneVisualEURUSD) の Zone 判定を使う OANDA:EURUSD 5分足 Strategy
//  EU-1: ZONE-ST-GBPJPY (ZoneStrategyGBPJPY) からの移植 (生成: tests/eu_build.py、差分は fixture eu_sim が固定)。
//  Entry A / B / C / D・1分足 BOS・取消・優先順位・再 Entry 制御・注文処理順・TP / 建値のタイミング・仮 / 確定
//  アラート・ラベルは ZONE-ST-GBPJPY と同じ式。Zone 関連の入力と初期値は ZONE-EURUSD と同じ。価格差は USD
//  (1 pip = 0.0001)。SL Buffer 0.00030 (3 pips、Zone 反対端からの追加幅) / Breakeven Trigger 0.00060 (6 pips) は
//  日次ボラ比較からの検証開始値。数量は円の損失予算を strategy.convert_to_symbol で USD に換算してから計算する
//  (固定 USDJPY なし)。次足成行・ギャップ・スリッページがあるため、実損失が必ず予算内とは限らない。
//  EU-2 (EURUSD 検証後の採用初期値。最適値・将来の有効性を保証するものではない): Entry B: Confirmed Rejection、
//  Short Only (Long Only / Both・A〜D は選択可)、固定 RR 1.5、SL Buffer 3 pips。Zone の初期値は ZONE-EURUSD と共通
//  (Break Buffer 5 pips、Slope 0.2・0.4 pips、Slope Bonus Max、Day H/L Score 1、Accum Score 2 / 3 / 4)。
//  以下は ZONE-ST-GBPJPY の説明 (円・pips の数値は GBPJPY 版のもの):
//  Zone Strategy GBPJPY  —  ZONE-GBPJPY (ZoneVisualGBPJPY) の Zone 判定をそのまま使う OANDA:GBPJPY 5分足 Strategy
//  (生成: tests/gbs_build.py。Zone 計算は ZONE-GBPJPY、注文処理・仮 / 確定アラートは ZONE-ST-JPY
//   (ZoneStrategyUSDJPY) と同じ式。価格差は円。初期値は GBPJPY 基準設定 (ある比較期間の TradingView 結果から
//   決めたもの。最適値・別期間での有効性は未確認)。Zone 関連の初期値 (Half Width 0.05 円を含む) は表示用
//   ZONE-GBPJPY と同じ)
// ============================================================================
//  ・Zone 判定は ZONE-P と同一: ZoneEnginePractical/6 (Swing 最大点) / 入力 / Source 取得 / NR-S1 / NR-A1 /
//    RN / Break / zn.update / FVG Batch A (検知・保存・完全埋め・期限) は ZONE-P の本文をそのまま使う
//    (fixture st1_sim が ZONE-P との byte 一致で固定)。FVG は常に有効 (無効化入力なし)。
//  ・FVG 加点 (Batch C) と重複範囲限定昇格の判定は ZONE-P と同じ関数 / 同じ式 (f_stZoneEval)。
//  ・描画 (box / label / MA plot / Stats) は持たない。Zone / BOS 待機 / 注文の判定と状態更新は確定 5分足でだけ。
//  ・GBPJPY: 仮 / 確定アラート (ゴールド版 PracticalZoneStrategy_LONG.pine P10 と同じ意味)。仮アラートのため
//    calc_on_every_tick = true。未確定 tick では zn.update / Zone 走査 / FVG 走査 / 注文を行わず、
//    確定時に保存した状態を読むだけ (ヒストリカル = 全足確定なのでバックテストは変わらない)。
//  ・ST-3: A / B / C / D 反発 Entry (選択した 1 方式だけ実行)、新規 Entry の時間帯、反対側 Zone の TP、建値移動。
//    Zone 基準の SL は Entry と同時に固定。TP は約定を確認した足の確定時に初めて決めて発注するため、
//    約定した足の中では TP が無い (結果の解釈に注意)。建値 stop は到達を確認した確定足の次の足から有効。
// ============================================================================

// ============================================================================
//  SX-1: ゴールド版 (XA-7 〜 XA-15) の SATS Pullback / 逆方向一致フィルター / 建値 Trigger 方式をこの Strategy に追加
//  (生成: tests/sx_build.py)。初期値は Current・Fixed Distance・全 OFF (近接 0) = 変更前の売買・通知のまま (比較用。
//  最適値ではない)。SATS Pullback: 各 Entry Mode (A〜D) が発注する地点で待機を準備し (A = 指値価格・指値注文なし /
//  B・C・D = 確定足の終値)、次の 5分足以降に SATS 線 (足 t-1 の確定値) への接触 / 近接と終値の戻り (反発 A / B) で成行。
//  取消は期限 (実時間) と SL0 到達だけ。SL0 / TP0 は準備時に固定。仮アラート / ラベルは待機中の形成中 5分足の読取専用評価、
//  確定は SATS の strategy.entry で 1 回 (待機開始・見送りでは出さない)。GBPUSD: 1 pip = 0.0001。成績への影響は未確認。
//@version=5
strategy(
     title                  = "Zone Strategy GBPUSD",
     shorttitle             = "ZONE-ST-GBPUSD",
     overlay                = true,
     dynamic_requests       = true,
     calc_on_every_tick     = true,
     process_orders_on_close = false,
     pyramiding             = 0,
     initial_capital        = 300000,
     currency               = currency.JPY,
     default_qty_type       = strategy.fixed,
     default_qty_value      = 1,
     max_labels_count       = 500)

import sekine3310/ZoneEnginePracticalGBPUSD/1 as zn

// ---- 5分足専用 Execution Gate ------------------------------------------------
//  Production authority はチャート足 = 5分足のみ。5分足以外では Source 取得 / Break 評価 /
//  取引日ID / zn.update / 描画 / Stats を一切実行しない (Engine の状態遷移そのものを行わない)。
//  「300秒相当」ではなく TradingView の 5分足だけを明示的に許可する。
bool is5mChart = timeframe.isminutes and timeframe.multiplier == 5

// Library内の定数と同じ値 (定数exportはPineのバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)

// ============================================================================
// 01-2. ZONE ENGINE INPUTS
// ============================================================================
// ---- 2.1 Zone Geometry -----------------------------------------------------
var string G_ZONE = "02 · Zone Geometry"
zoneHalfWidth = input.float(0.00020, "[比較開始値] Zone Half Width (USD)", minval = 0.00001, step = 0.00005, group = G_ZONE,
     tooltip = "各Source (RawZone) = 中心価格 ± この値。\n" +
     "最終Zoneは Cluster内の全RawZoneを包む範囲 (min bottom ～ max top)。最大幅capなし。\n" +
     "GBPUSD: 1 pip = 0.0001。初期 0.00020 = 各 RawZone の半幅 2 pips (Visual / Strategy 共通)。EURUSD 確定版から引き継いだ比較開始用初期値・GBPUSD では未検証 (最適値ではない)。")

// ---- 2.2 MA Source (1分足コンテキストで直接計算) ---------------------------
var string G_MA = "02 · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_MA,
     tooltip = "既定 1分足。1分足コンテキスト内でMAを計算し、その結果を5分足へ取得する。")
maType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_MA)
useMaSource = input.bool(true, "Enable MA Source", group = G_MA)
// ★ ma1Len / ma2Len / 各TF は request.security・zn.maPack へ渡すため
//   「input変数のまま (simple修飾)」保持する。UDTのフィールド読み出しは series 扱いになり、
//   request.security の timeframe や ta.ema の length には使えないため。
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_MA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_MA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_MA)
scoreMa1 = input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_MA)
scoreMa2 = input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_MA)

// ---- 2.3 MA Slope ----------------------------------------------------------
var string G_SLOPE = "02 · MA Slope"
slopeThrMod = input.float(0.00002, "[比較開始値] Slope Threshold · Moderate (USD/lookback)", minval = 0.0, step = 0.00001, group = G_SLOPE,
     tooltip = "Slope Lookback 本数の間の MA の価格差。初期 0.00002 = 0.2 pips (EURUSD 確定版から引き継いだ比較開始用初期値・GBPUSD では未検証 (最適値ではない))。lookback 本数・計算式は変えない。")
slopeThrStrong = input.float(0.00004, "[比較開始値] Slope Threshold · Strong (USD/lookback)",   minval = 0.0, step = 0.00001, group = G_SLOPE,
     tooltip = "Slope Lookback 本数の間の MA の価格差。初期 0.00004 = 0.4 pips (EURUSD 確定版から引き継いだ比較開始用初期値・GBPUSD では未検証 (最適値ではない))。")
slopeBonusFlat = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_SLOPE)
slopeBonusMod = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_SLOPE)
slopeBonusStr = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_SLOPE)
slopeBonusMode = input.string("Max", "Slope Bonus Aggregation in Cluster",
     options = ["Sum (per MA)", "Max"], group = G_SLOPE,
     tooltip = "同一Cluster内に2000MAと3000MAが両方入った場合、Slope Bonusを合算するか最大値のみ採用するか。")
maClusterDist = input.float(0.00120, "[検証開始値] MA Cluster Distance (USD)", minval = 0.0, step = 0.0001, group = G_SLOPE,
     tooltip = "初期 0.00120 = 12 pips (検証開始値)。")
maClusterBonus = input.float(0.0, "MA Cluster Bonus",              step = 0.5, group = G_SLOPE)
maClusterDirBonus = input.float(0.0, "MA Cluster Bonus · Same Slope", step = 0.5, group = G_SLOPE)

// ---- 2.4 Horizontal Source -------------------------------------------------
var string G_HZ = "02 · Horizontal Source (Swing)"
useHzSource = input.bool(true, "Enable Horizontal Source", group = G_HZ)
hzTf1 = input.timeframe("5",  "Horizontal TF #1", group = G_HZ)
hzTf2 = input.timeframe("15", "Horizontal TF #2", group = G_HZ)
hzTf3 = input.timeframe("60", "Horizontal TF #3", group = G_HZ)
pivLen1 = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_HZ)
pivLen2 = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_HZ)
pivLen3 = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_HZ)
scoreHz1 = input.float(1.0, "Base Score · TF #1 Swing", step = 0.5, group = G_HZ)
scoreHz2 = input.float(2.0, "Base Score · TF #2 Swing", step = 0.5, group = G_HZ)
scoreHz3 = input.float(3.0, "Base Score · TF #3 Swing", step = 0.5, group = G_HZ)

// ---- 2.5 Strong Touch Count (Strengthには一切影響しない) ------------------
var string G_TOUCH = "02 · Strong Touch Count"
touchRearmDist = input.float(0.00060, "[検証開始値] Touch Re-arm Distance (USD・初期 6 pips)", minval = 0.0, step = 0.0001, group = G_TOUCH,
     tooltip = "Strong / Very Strong の SUPPORT / RESISTANCE Zone に接触すると Touch +1。\n" +
     "同じ接触中は増えない。ローソク全体がZoneからこの距離以上離れたら再Armし、\n" +
     "次の接触で再び +1。Touch Count は Score / Strength に一切加算しない。")

// ---- 2.6 Day High / Low ----------------------------------------------------
var string G_DHL = "02 · Day High / Low"
useDayHL = input.bool(true, "Enable Day High / Low Source", group = G_DHL)
dayTz        = input.string("Asia/Tokyo", "Day Session Timezone", group = G_DHL)
dayResetHour = input.int(5, "Day Reset Hour (取引日の開始時刻)", minval = 0, maxval = 23, group = G_DHL,
     tooltip = "既定 5 = 日本時間 05:00 ～ 翌 04:59 を1取引日として扱う。0 にすると暦日基準。")
scoreDayHL = input.float(1.0, "Base Score · Day High / Low", step = 0.5, group = G_DHL)
carryPrevDayHL = input.bool(false, "Carry Previous Day H/L as Horizontal Zone", group = G_DHL)
scorePrevDayHL = input.float(2.0, "Base Score · Carried Prev Day H/L", step = 0.5, group = G_DHL)
lifePrevDayHL = input.float(5.0, "Lifetime · Carried Prev Day H/L (days)", step = 1.0, group = G_DHL)
dsMode = input.string("Separate", "Day/Swing Overlap Mode", options = ["Separate", "Merge Nearby"], group = G_DHL,
     tooltip = "Separate: 従来どおり Day H/L と Swing を別々に採点。\n" +
     "Merge Nearby: 同じ Zone 内で、当日高値と Swing High (安値と Swing Low) の価格差が Merge Distance 以内なら\n" +
     "1 つの根拠として、高い方の点数・1 カテゴリで数える。時刻・日付は問わない。前日 H/L は対象外。")
dsDist = input.float(0.00020, "[検証開始値] Day/Swing Merge Distance (USD)", minval = 0.0, step = 0.00001, group = G_DHL,
     tooltip = "Merge Nearby の価格差 (Cluster Distance とは別)。0 = 完全に同じ価格だけ。初期 0.00020 = 2 pips (検証開始値)。")

// ---- 2.7 Accumulation ------------------------------------------------------
var string G_ACC = "02 · Accumulation"
useAccSource = input.bool(true, "Enable Accumulation Source", group = G_ACC)
accumModule = input.string("Accum Box (ported)", "Accum Detection Module",
     options = ["Accum Box (ported)", "Provisional ATR (暫定)"], group = G_ACC)
accTf1 = input.timeframe("60",  "Accum TF #1", group = G_ACC)
accTf2 = input.timeframe("240", "Accum TF #2", group = G_ACC)
accTf3 = input.timeframe("D",   "Accum TF #3", group = G_ACC)
scoreAcc1 = input.float(2.0, "Base Score · TF #1 Accum", step = 0.5, group = G_ACC)
scoreAcc2 = input.float(3.0, "Base Score · TF #2 Accum", step = 0.5, group = G_ACC)
scoreAcc3 = input.float(4.0, "Base Score · TF #3 Accum", step = 0.5, group = G_ACC)
accKeep1 = input.int(3, "Keep Count · TF #1 Accum (instances)", minval = 1, group = G_ACC)
accKeep2 = input.int(2, "Keep Count · TF #2 Accum (instances)", minval = 1, group = G_ACC)
accKeep3 = input.int(1, "Keep Count · TF #3 Accum (instances)", minval = 1, group = G_ACC)
accScoreMode = input.string("Max", "Accum Score Mode", options = ["Sum", "Max"], group = G_ACC,
     tooltip = "時間足 (TF #1 / #2 / #3) ごとの Accum 寄与 (上限・下限はそれぞれ Zone 内 1 回のまま) をどう合わせるか。\n" +
     "Sum: 合計 (従来)。Max: 最大の 1 つだけ。例: 3 / 4 / 5 → Sum 12・Max 5、6 / 4 / 0 → Sum 10・Max 6。\n" +
     "Engine の Score / Strength / Touch / FVG 加点後 Score / Entry 資格すべてに反映 (表示だけの差し替えではない)。")
accEdgeMode = input.string("Separate", "Accum Edge Mode", options = ["Separate", "Once per TF"], group = G_ACC,
     tooltip = "同じ時間足の Accum 上限・下限の数え方。Separate: 上限・下限をそれぞれ 1 回 (従来)。\n" +
     "Once per TF: その時間足の境界が Zone に 1 つ以上あれば、時間足の点数を 1 回だけ (同じ箱・別の箱を問わない)。\n" +
     "時間足ごとの寄与を出してから Accum Score Mode (Sum / Max) を適用。例 1H 上下限 + 4H 片側: Separate 10 / 6、Once 7 / 4。")

var string G_ACCP = "02a · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ACCQ = "02b · Provisional ATR Accum (暫定・本番未使用)"
accLen1 = input.int(20, "[暫定] Accum Lookback · TF #1 (bars)", minval = 3, group = G_ACCQ)
accLen2 = input.int(20, "[暫定] Accum Lookback · TF #2 (bars)", minval = 3, group = G_ACCQ)
accLen3 = input.int(15, "[暫定] Accum Lookback · TF #3 (bars)", minval = 3, group = G_ACCQ)
accMult = input.float(1.2, "[暫定] Accum Max Range / ATR", step = 0.1, minval = 0.1, group = G_ACCQ)

// ---- 2.7c Round Number (GBPUSD) ------------------------------------------
//  Engine (ZoneEnginePracticalGBPUSD) の Round Number 加点を USD の刻みで使う。
//  判定式 (GBPUSD Engine f_rnLevelIn、最小価格刻みの整数で比較): 節目の tick 数が [ceil(bottom), floor(top)] に入れば Cluster の最終範囲 [bottom, top]
//  (境界を含む) に刻みの倍数がある。許容距離は無い。大刻みを先に調べ、無いときだけ小刻み (両方該当は大刻みだけ)。
//  Cluster ごとに最大 1 回、baseSum へ加点し Confluence の独立 1 カテゴリ。RN 単独の Zone は作らない。HTF 根拠にならない。
//  ticker が GBPUSD のときだけ有効。刻みは最小価格刻みの整数倍 (tick 整数で比較するので 0.0100 / 0.0050 も境界で漏れない。
//  tests/eu_sim で確認、GBPUSD は同じ式)。不正な刻みは停止して表示。
var string G_RN = "02 · Round Number (GBPUSD)"
enableRn = input.bool(false, "Enable Round Number (GBPUSD)", group = G_RN,
     tooltip = "Zone の範囲 [bottom, top] (境界を含む) に大刻みの倍数があれば大刻みの加点、無ければ小刻みの倍数で小刻みの加点。\n" +
     "Zone ごとに 1 回 (両方該当は大刻みだけ)、Confluence の独立カテゴリ。RN 単独の Zone は作らない。許容距離なし。")
rnMajorStep = input.float(0.0100, "[暫定] RN 大刻み (USD)", minval = 0.0001, step = 0.0010, group = G_RN,
     tooltip = "例: 0.0100 (100 pips) → 1.1000。最小価格刻みの整数倍、かつ小刻みの整数倍 (2 倍以上)。")
rnMajorScore = input.float(3.0, "[暫定] RN 大刻み 加点", minval = 0.0, step = 0.5, group = G_RN)
rnMinorStep = input.float(0.0050, "[暫定] RN 小刻み (USD)", minval = 0.0001, step = 0.0005, group = G_RN,
     tooltip = "例: 0.0050 (50 pips) → 1.1050。最小価格刻みの整数倍。")
rnMinorScore = input.float(2.0, "[暫定] RN 小刻み 加点", minval = 0.0, step = 0.5, group = G_RN)
// 刻みの検証 (最小価格刻みの整数で比べる)。RN ON で不正なら runtime.error で明示する (OFF のときは何もしない)
//  小刻み > 0、大刻み = 小刻みの 2 倍以上の整数倍、どちらも最小価格刻みの整数倍 (1e-6 tick は計算誤差の吸収だけ)
float rnMajT   = rnMajorStep / syminfo.mintick
float rnMinT   = rnMinorStep / syminfo.mintick
int   rnMajI   = math.round(rnMajT)
int   rnMinI   = math.round(rnMinT)
bool  rnStepOK = rnMinorStep > 0 and math.abs(rnMajT - rnMajI) < 1e-6 and math.abs(rnMinT - rnMinI) < 1e-6
     and rnMinI > 0 and rnMajI >= 2 * rnMinI and rnMajI % math.max(rnMinI, 1) == 0
if enableRn and not rnStepOK
    runtime.error("Round Number: 刻みが不正です (小刻み > 0、大刻み = 小刻みの 2 倍以上の整数倍、どちらも最小価格刻みの整数倍)")

// ---- 2.8 Cluster / Score / HTF --------------------------------------------
var string G_CLU = "02 · Cluster"
clusterDist = input.float(0.00030, "[比較開始値] Cluster Distance (USD)", minval = 0.0, step = 0.00005, group = G_CLU,
     tooltip = "GBPUSD: 初期 0.00030 = 3 pips (EURUSD 確定版から引き継いだ比較開始用初期値・GBPUSD では未検証 (最適値ではない))。")

var string G_SCORE = "02 · Strength Score"
thrMedium = input.float(5.0,  "Medium Score Threshold",      step = 0.5, group = G_SCORE)
thrStrong = input.float(9.0, "Strong Score Threshold",       step = 0.5, group = G_SCORE)
thrVStrong = input.float(15.0, "Very Strong Score Threshold", step = 0.5, group = G_SCORE)
confBonus2 = input.float(1.0, "Confluence Bonus · 2 categories",  step = 0.5, group = G_SCORE)
confBonus3 = input.float(2.0, "Confluence Bonus · 3 categories",  step = 0.5, group = G_SCORE)
confBonus4 = input.float(3.0, "Confluence Bonus · 4+ categories", step = 0.5, group = G_SCORE)
flipBonus = input.float(0.0, "Flip Bonus", step = 0.5, group = G_SCORE)

var string G_HTF = "02a · Very Strong · Higher TF Structure"
requireHtfForVStrong = input.bool(true, "Require Higher TF Structure for Very Strong", group = G_HTF)
htfSwing1H = input.bool(true,  "Count 1H Swing (TF #3) as Higher TF",    group = G_HTF)
htfAccum1H = input.bool(true,  "Count 1H Accum (TF #1) as Higher TF",    group = G_HTF)
htfAccum4H = input.bool(true,  "Count 4H Accum (TF #2) as Higher TF",    group = G_HTF)
htfAccumD = input.bool(true,  "Count Daily Accum (TF #3) as Higher TF", group = G_HTF)
htfSwing15M = input.bool(false, "Count 15M Swing (TF #2) as Higher TF",   group = G_HTF)
htfMa1 = input.bool(false, "Count MA #1 (2000) as Higher TF",        group = G_HTF)
htfMa2 = input.bool(false, "Count MA #2 (3000) as Higher TF",        group = G_HTF)
htfDayHL = input.bool(false, "Count Day High / Low as Higher TF",      group = G_HTF)

// ---- 2.9 Break / Flip / Lifetime ------------------------------------------
var string G_BF = "02 · Break / Flip"
breakTf = input.timeframe("5", "Break Evaluation Timeframe", group = G_BF,
     tooltip = "Breakはヒゲではなくこの時間足の確定終値で判定する。")
breakBuffer = input.float(0.00050,  "[比較開始値] Break Buffer (USD・初期 5 pips)",         minval = 0.0, step = 0.00005, group = G_BF)
flipConfirmDist = input.float(0.00060, "[比較開始値] Flip Confirm Distance (USD・初期 6 pips)", minval = 0.0, step = 0.0001, group = G_BF)
resetOnReclaim = input.bool(true,  "Reset Broken on Reclaim", group = G_BF)
trackStaleBars = input.int(500, "Zone State Retention (bars without match)", minval = 10, group = G_BF)
trackContinuity = input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_BF)

var string G_LIFE = "02 · Zone Lifetime"
lifeHz1 = input.float(5.0,  "Lifetime · TF #1 Horizontal (days)", step = 0.5, group = G_LIFE)
lifeHz2 = input.float(10.0, "Lifetime · TF #2 Horizontal (days)", step = 0.5, group = G_LIFE)
lifeHz3 = input.float(30.0, "Lifetime · TF #3 Horizontal (days)", step = 0.5, group = G_LIFE)
maxPersistZones = input.int(200, "Max Persistent Raw Zones", minval = 20, maxval = 800, group = G_LIFE)



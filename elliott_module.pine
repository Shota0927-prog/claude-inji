// © ka.mickey15
//
// ============================================================
//  Elliott Wave Score 単体モジュール (Indicator版)
// ============================================================
//  ・エリオット波動を完全自動カウントせず、確率的・スコア的に判定:
//      1. ③波らしさ (Wave3 候補) をスコア化
//      2. ⑤波終了警戒 (Wave5 Warning) をスコア化
//  ・主観性が高いため 1〜5波の完全確定はしない。
//  ・strategy ではなく indicator。strategy.entry/exit/closedtrades 不使用。
//  ・Pivot は確定後のみ使用 (未来参照なし)。
//  ・useElliottModule=false の時は allowLong/Short=true (AND 接続を邪魔しない)。
//  ・他モジュールと AND 接続する前提。
// ============================================================

//@version=5
indicator(
     title            = "Elliott Wave Score Module",
     shorttitle       = "EWAVE",
     overlay          = true,
     max_bars_back    = 1000,
     max_labels_count = 500
 )

// ============================================================
//  Input (グループ: Elliott Wave Module)
// ============================================================
grpEW = "Elliott Wave Module"

useElliottModule = input.bool(true, "Elliottモジュールを使う", group = grpEW)

showElliottLabels     = input.bool(true, "Elliottラベルを表示", group = grpEW)
showElliottShapes     = input.bool(true, "Elliott Shapeを表示", group = grpEW)
showElliottDebugTable = input.bool(true, "Debug Tableを表示", group = grpEW)

elliottPivotLen = input.int(5, "Pivot Length", minval = 1, group = grpEW)
elliottAtrLen   = input.int(14, "ATR Length", minval = 1, group = grpEW)

minWave1ATR = input.float(1.0, "最低1波幅 ATR倍率", minval = 0.1, step = 0.1, group = grpEW)
minWave3ATR = input.float(1.5, "最低3波幅 ATR倍率", minval = 0.1, step = 0.1, group = grpEW)

wave2MinRetrace = input.float(0.236, "2波 最低戻し", minval = 0.0, maxval = 1.0, step = 0.01, group = grpEW)
wave2MaxRetrace = input.float(0.786, "2波 最大戻し", minval = 0.0, maxval = 1.5, step = 0.01, group = grpEW)

wave4MinRetrace = input.float(0.236, "4波 最低戻し", minval = 0.0, maxval = 1.0, step = 0.01, group = grpEW)
wave4MaxRetrace = input.float(0.5, "4波 最大戻し", minval = 0.0, maxval = 1.0, step = 0.01, group = grpEW)

useWave3Filter = input.bool(true, "③波候補を使う", group = grpEW)
minWave3Score  = input.int(60, "③波 最低Score", minval = 0, maxval = 100, group = grpEW)

useWave5WarningFilter = input.bool(false, "⑤波警戒でNoTrade", group = grpEW)
minWave5WarningScore  = input.int(60, "⑤波警戒 最低Score", minval = 0, maxval = 100, group = grpEW)

useMomentumConfirm = input.bool(true, "Momentum確認を使う", group = grpEW)
rsiLen     = input.int(14, "RSI Length", minval = 1, group = grpEW)
macdFast   = input.int(12, "MACD Fast", minval = 1, group = grpEW)
macdSlow   = input.int(26, "MACD Slow", minval = 1, group = grpEW)
macdSignal = input.int(9, "MACD Signal", minval = 1, group = grpEW)

useVolumeConfirm = input.bool(false, "Volume確認を使う", group = grpEW)
volAvgLen        = input.int(20, "Volume平均本数", minval = 1, group = grpEW)

useEMAConfirm = input.bool(true, "EMA発散確認を使う", group = grpEW)
emaFastLen = input.int(20, "EMA Fast", minval = 1, group = grpEW)
emaMidLen  = input.int(50, "EMA Mid", minval = 1, group = grpEW)
emaSlowLen = input.int(200, "EMA Slow", minval = 1, group = grpEW)

useOverExtensionWarning = input.bool(true, "伸び切り警戒を使う", group = grpEW)
wave5ExtRatio = input.float(1.618, "⑤波 伸び切り倍率", minval = 1.0, step = 0.05, group = grpEW)

useDivergenceWarning = input.bool(true, "ダイバージェンス警戒を使う", group = grpEW)

elliottEntryMode = input.string("BiasOnly", "Entry Mode", options = ["BiasOnly", "AllowOnly"], group = grpEW)

bool eAct = useElliottModule

// ============================================================
//  共通計算: ATR / RSI / MACD / EMA / Volume
// ============================================================
float atr = ta.atr(elliottAtrLen)
float rsiVal = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

float emaFast = ta.ema(close, emaFastLen)
float emaMid  = ta.ema(close, emaMidLen)
float emaSlow = ta.ema(close, emaSlowLen)

float volAvg = ta.sma(volume, volAvgLen)

bool momLong  = rsiVal > 50 and rsiVal > rsiVal[1] and macdLine > signalLine and histLine > histLine[1]
bool momShort = rsiVal < 50 and rsiVal < rsiVal[1] and macdLine < signalLine and histLine < histLine[1]

bool emaLong  = emaFast > emaMid and emaMid > emaSlow and (emaFast - emaMid) > (emaFast[3] - emaMid[3])
bool emaShort = emaFast < emaMid and emaMid < emaSlow and (emaMid - emaFast) > (emaMid[3] - emaFast[3])

bool volUp   = not na(volume) and not na(volAvg) and volume > volAvg
bool volDown = not na(volume) and not na(volAvg) and volume < volAvg

// ============================================================
//  Pivot 保存 (確定後のみ / 交互保持 / 同方向は極値更新 / 最大10)
// ============================================================
float ph = ta.pivothigh(high, elliottPivotLen, elliottPivotLen)
float pl = ta.pivotlow(low,  elliottPivotLen, elliottPivotLen)

var array<float> pivotPriceArr = array.new_float()
var array<int>   pivotBarArr   = array.new_int()
var array<int>   pivotTypeArr  = array.new_int()
var array<float> pivotRsiArr   = array.new_float()
var array<float> pivotHistArr  = array.new_float()

if not na(ph)
    float _price = ph
    int   _bar   = bar_index - elliottPivotLen
    float _rsi   = rsiVal[elliottPivotLen]
    float _hist  = histLine[elliottPivotLen]
    int   _n     = array.size(pivotTypeArr)
    if _n > 0
        int _lastType = array.get(pivotTypeArr, _n - 1)
        if _lastType == 1
            int _li = _n - 1
            if _price > array.get(pivotPriceArr, _li)
                array.set(pivotPriceArr, _li, _price)
                array.set(pivotBarArr,   _li, _bar)
                array.set(pivotRsiArr,   _li, _rsi)
                array.set(pivotHistArr,  _li, _hist)
        else
            array.push(pivotPriceArr, _price)
            array.push(pivotBarArr,   _bar)
            array.push(pivotTypeArr,  1)
            array.push(pivotRsiArr,   _rsi)
            array.push(pivotHistArr,  _hist)
    else
        array.push(pivotPriceArr, _price)
        array.push(pivotBarArr,   _bar)
        array.push(pivotTypeArr,  1)
        array.push(pivotRsiArr,   _rsi)
        array.push(pivotHistArr,  _hist)
    while array.size(pivotPriceArr) > 10
        array.shift(pivotPriceArr)
        array.shift(pivotBarArr)
        array.shift(pivotTypeArr)
        array.shift(pivotRsiArr)
        array.shift(pivotHistArr)

if not na(pl)
    float _price = pl
    int   _bar   = bar_index - elliottPivotLen
    float _rsi   = rsiVal[elliottPivotLen]
    float _hist  = histLine[elliottPivotLen]
    int   _n     = array.size(pivotTypeArr)
    if _n > 0
        int _lastType = array.get(pivotTypeArr, _n - 1)
        if _lastType == -1
            int _li = _n - 1
            if _price < array.get(pivotPriceArr, _li)
                array.set(pivotPriceArr, _li, _price)
                array.set(pivotBarArr,   _li, _bar)
                array.set(pivotRsiArr,   _li, _rsi)
                array.set(pivotHistArr,  _li, _hist)
        else
            array.push(pivotPriceArr, _price)
            array.push(pivotBarArr,   _bar)
            array.push(pivotTypeArr,  -1)
            array.push(pivotRsiArr,   _rsi)
            array.push(pivotHistArr,  _hist)
    else
        array.push(pivotPriceArr, _price)
        array.push(pivotBarArr,   _bar)
        array.push(pivotTypeArr,  -1)
        array.push(pivotRsiArr,   _rsi)
        array.push(pivotHistArr,  _hist)
    while array.size(pivotPriceArr) > 10
        array.shift(pivotPriceArr)
        array.shift(pivotBarArr)
        array.shift(pivotTypeArr)
        array.shift(pivotRsiArr)
        array.shift(pivotHistArr)

// ============================================================
//  直近 Pivot を末尾から取得 (e0=最新 … e5=6番目)
// ============================================================
int sz = array.size(pivotPriceArr)
float pe0 = sz >= 1 ? array.get(pivotPriceArr, sz - 1) : na
float pe1 = sz >= 2 ? array.get(pivotPriceArr, sz - 2) : na
float pe2 = sz >= 3 ? array.get(pivotPriceArr, sz - 3) : na
float pe3 = sz >= 4 ? array.get(pivotPriceArr, sz - 4) : na
float pe4 = sz >= 5 ? array.get(pivotPriceArr, sz - 5) : na
float pe5 = sz >= 6 ? array.get(pivotPriceArr, sz - 6) : na
int te0 = sz >= 1 ? array.get(pivotTypeArr, sz - 1) : na
int te1 = sz >= 2 ? array.get(pivotTypeArr, sz - 2) : na
int te2 = sz >= 3 ? array.get(pivotTypeArr, sz - 3) : na
int te3 = sz >= 4 ? array.get(pivotTypeArr, sz - 4) : na
int te4 = sz >= 5 ? array.get(pivotTypeArr, sz - 5) : na
int te5 = sz >= 6 ? array.get(pivotTypeArr, sz - 6) : na
float re0 = sz >= 1 ? array.get(pivotRsiArr, sz - 1) : na
float re2 = sz >= 3 ? array.get(pivotRsiArr, sz - 3) : na
float he0 = sz >= 1 ? array.get(pivotHistArr, sz - 1) : na
float he2 = sz >= 3 ? array.get(pivotHistArr, sz - 3) : na

// ============================================================
//  ③波 形状 / 波幅 (BUY: Low→High→Low→High / SELL: High→Low→High→Low)
// ============================================================
bool shapeLong  = sz >= 4 and te0 == 1  and te1 == -1 and te2 == 1  and te3 == -1
bool shapeShort = sz >= 4 and te0 == -1 and te1 == 1  and te2 == -1 and te3 == 1

// BUY: Low0=e3 High1=e2 Low2=e1 High3=e0
float wave1Long = pe2 - pe3
float wave2RetraceLong = wave1Long > 0 ? (pe2 - pe1) / wave1Long : na
float wave3Long = pe0 - pe1
bool  break3Long = pe0 > pe2

// SELL: High0=e3 Low1=e2 High2=e1 Low3=e0
float wave1Short = pe3 - pe2
float wave2RetraceShort = wave1Short > 0 ? (pe1 - pe2) / wave1Short : na
float wave3Short = pe1 - pe0
bool  break3Short = pe0 < pe2

bool elliottWave3CandidateLong = shapeLong and wave1Long >= atr * minWave1ATR and not na(wave2RetraceLong) and wave2RetraceLong >= wave2MinRetrace and wave2RetraceLong <= wave2MaxRetrace and break3Long and wave3Long >= atr * minWave3ATR and wave3Long >= wave1Long
bool elliottWave3CandidateShort = shapeShort and wave1Short >= atr * minWave1ATR and not na(wave2RetraceShort) and wave2RetraceShort >= wave2MinRetrace and wave2RetraceShort <= wave2MaxRetrace and break3Short and wave3Short >= atr * minWave3ATR and wave3Short >= wave1Short

// ③波スコア (100点満点 / 形状未成立は 0)
int elliottWave3ScoreLong = not shapeLong ? 0 : math.min(100, 25 + (wave1Long >= atr * minWave1ATR ? 10 : 0) + ((not na(wave2RetraceLong) and wave2RetraceLong >= wave2MinRetrace and wave2RetraceLong <= wave2MaxRetrace) ? 15 : 0) + (break3Long ? 15 : 0) + (wave3Long >= atr * minWave3ATR ? 10 : 0) + (wave3Long >= wave1Long ? 10 : 0) + ((useMomentumConfirm and momLong) ? 10 : 0) + ((useEMAConfirm and emaLong) ? 5 : 0) + ((useVolumeConfirm and volUp) ? 5 : 0))
int elliottWave3ScoreShort = not shapeShort ? 0 : math.min(100, 25 + (wave1Short >= atr * minWave1ATR ? 10 : 0) + ((not na(wave2RetraceShort) and wave2RetraceShort >= wave2MinRetrace and wave2RetraceShort <= wave2MaxRetrace) ? 15 : 0) + (break3Short ? 15 : 0) + (wave3Short >= atr * minWave3ATR ? 10 : 0) + (wave3Short >= wave1Short ? 10 : 0) + ((useMomentumConfirm and momShort) ? 10 : 0) + ((useEMAConfirm and emaShort) ? 5 : 0) + ((useVolumeConfirm and volUp) ? 5 : 0))

// ============================================================
//  ⑤波終了警戒 (6 Pivot)
//  BUY:  Low→High→Low→High→Low→High (新値High5)
//  SELL: High→Low→High→Low→High→Low (新値Low5)
// ============================================================
bool shape5Long  = sz >= 6 and te0 == 1  and te1 == -1 and te2 == 1  and te3 == -1 and te4 == 1  and te5 == -1
bool shape5Short = sz >= 6 and te0 == -1 and te1 == 1  and te2 == -1 and te3 == 1  and te4 == -1 and te5 == 1

// BUY: High5=e0 Low4=e1 High3=e2 Low2=e3 High1=e4 Low0=e5
float wave5Long      = pe0 - pe1
float wave3LongPrev  = pe2 - pe3
float wave1LongPrev  = pe4 - pe5
bool upd5L     = pe0 > pe2
bool shorter5L = wave5Long < wave3LongPrev
bool rsiDivL   = upd5L and re0 < re2
bool macdSlowL = upd5L and he0 < he2
bool extL      = wave5Long >= wave1LongPrev * wave5ExtRatio
bool emaNarrowL = (emaFast - emaMid) < (emaFast[3] - emaMid[3])

// SELL: Low5=e0 High4=e1 Low3=e2 High2=e3 Low1=e4 High0=e5
float wave5Short     = pe1 - pe0
float wave3ShortPrev = pe3 - pe2
float wave1ShortPrev = pe5 - pe4
bool upd5S     = pe0 < pe2
bool shorter5S = wave5Short < wave3ShortPrev
bool rsiDivS   = upd5S and re0 > re2
bool macdSlowS = upd5S and he0 > he2
bool extS      = wave5Short >= wave1ShortPrev * wave5ExtRatio
bool emaNarrowS = (emaMid - emaFast) < (emaMid[3] - emaFast[3])

int elliottWave5WarningLong = not shape5Long ? 0 : math.min(100, (upd5L ? 20 : 0) + (shorter5L ? 15 : 0) + ((useDivergenceWarning and rsiDivL) ? 20 : 0) + (macdSlowL ? 15 : 0) + ((useOverExtensionWarning and extL) ? 15 : 0) + ((useEMAConfirm and emaNarrowL) ? 10 : 0) + ((useVolumeConfirm and volDown) ? 5 : 0))
int elliottWave5WarningShort = not shape5Short ? 0 : math.min(100, (upd5S ? 20 : 0) + (shorter5S ? 15 : 0) + ((useDivergenceWarning and rsiDivS) ? 20 : 0) + (macdSlowS ? 15 : 0) + ((useOverExtensionWarning and extS) ? 15 : 0) + ((useEMAConfirm and emaNarrowS) ? 10 : 0) + ((useVolumeConfirm and volDown) ? 5 : 0))

// ============================================================
//  NoTrade
// ============================================================
bool elliottNoTradeLong  = eAct and useWave5WarningFilter and elliottWave5WarningLong  >= minWave5WarningScore
bool elliottNoTradeShort = eAct and useWave5WarningFilter and elliottWave5WarningShort >= minWave5WarningScore
bool elliottNoTrade      = elliottNoTradeLong or elliottNoTradeShort

// ============================================================
//  Bias / Allow
// ============================================================
bool elliottBiasLong  = eAct and useWave3Filter and elliottWave3ScoreLong  >= minWave3Score and not elliottNoTradeLong
bool elliottBiasShort = eAct and useWave3Filter and elliottWave3ScoreShort >= minWave3Score and not elliottNoTradeShort

bool allowLongByElliott  = not eAct ? true : elliottEntryMode == "BiasOnly" ? true : elliottBiasLong
bool allowShortByElliott = not eAct ? true : elliottEntryMode == "BiasOnly" ? true : elliottBiasShort

// ============================================================
//  Direction / Score
// ============================================================
int elliottDirection = not eAct ? 0 : elliottWave3ScoreLong > elliottWave3ScoreShort ? 1 : elliottWave3ScoreShort > elliottWave3ScoreLong ? -1 : 0

int elliottScoreBase = math.max(elliottWave3ScoreLong, elliottWave3ScoreShort)
int elliottScore = not eAct ? 0 : math.max(0, math.min(100, elliottScoreBase - ((elliottWave5WarningLong >= minWave5WarningScore and elliottDirection == 1) ? 20 : 0) - ((elliottWave5WarningShort >= minWave5WarningScore and elliottDirection == -1) ? 20 : 0)))

// ============================================================
//  Signal Type
//  優先: NoTrade > Wave5 Div > Wave5 Warning > Wave3+Mom > Wave3 Candidate
// ============================================================
bool wave3Candidate = elliottWave3CandidateLong or elliottWave3CandidateShort
bool wave3WithMom   = (elliottWave3CandidateLong and momLong) or (elliottWave3CandidateShort and momShort)
bool warnActive     = elliottWave5WarningLong >= minWave5WarningScore or elliottWave5WarningShort >= minWave5WarningScore
bool divActive      = (rsiDivL and elliottWave5WarningLong >= minWave5WarningScore) or (rsiDivS and elliottWave5WarningShort >= minWave5WarningScore)

int elliottSignalType =
     not eAct ? 0 :
     elliottNoTrade ? 5 :
     divActive      ? 4 :
     warnActive     ? 2 :
     wave3WithMom   ? 3 :
     wave3Candidate ? 1 : 0

// ============================================================
//  Rank (0〜10)
// ============================================================
bool domIsLong  = elliottWave3ScoreLong >= elliottWave3ScoreShort
bool domShape   = domIsLong ? shapeLong : shapeShort
bool domBreak   = domIsLong ? break3Long : break3Short
bool momEmaCombo = domIsLong ? (elliottWave3CandidateLong and momLong and emaLong) : (elliottWave3CandidateShort and momShort and emaShort)
int  s3Max      = math.max(elliottWave3ScoreLong, elliottWave3ScoreShort)
bool warnStrong = math.max(elliottWave5WarningLong, elliottWave5WarningShort) >= 85

int elliottRank =
     not eAct ? 0 :
     (s3Max >= 85 and not warnActive) ? 10 :
     (momEmaCombo and s3Max >= minWave3Score) ? 9 :
     warnStrong ? 8 :
     warnActive ? 7 :
     s3Max >= 85 ? 6 :
     s3Max >= 75 ? 5 :
     s3Max >= 60 ? 4 :
     domBreak ? 3 :
     domShape ? 2 :
     (s3Max > 0 or warnActive) ? 1 : 0

// ============================================================
//  表示 : ラベル (状態変化時のみ)
// ============================================================
bool warnLongActive  = elliottWave5WarningLong  >= minWave5WarningScore
bool warnShortActive = elliottWave5WarningShort >= minWave5WarningScore

if showElliottLabels and eAct
    if elliottWave3CandidateLong and not elliottWave3CandidateLong[1]
        label.new(bar_index, low, "EW3↑", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    if elliottWave3CandidateShort and not elliottWave3CandidateShort[1]
        label.new(bar_index, high, "EW3↓", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    if warnLongActive and not warnLongActive[1]
        label.new(bar_index, high, "EW5 Warn↑", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
    if warnShortActive and not warnShortActive[1]
        label.new(bar_index, low, "EW5 Warn↓", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)

// ============================================================
//  表示 : Shape
// ============================================================
plotshape(showElliottShapes and eAct and elliottWave3CandidateLong,  title = "EW3 Long",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)
plotshape(showElliottShapes and eAct and elliottWave3CandidateShort, title = "EW3 Short", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.tiny)
plotshape(showElliottShapes and eAct and warnLongActive,  title = "EW5 Warn Long",  style = shape.xcross, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(showElliottShapes and eAct and warnShortActive, title = "EW5 Warn Short", style = shape.xcross, location = location.belowbar, color = color.new(color.orange, 0), size = size.tiny)

// ============================================================
//  Debug Table
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Wave3 Cand" : t == 2 ? "Wave5 Warn" : t == 3 ? "Wave3+Mom" : t == 4 ? "Wave5 Div" : t == 5 ? "NoTrade" : "None"

var table dbg = table.new(position.top_right, 2, 11, border_width = 1)
if showElliottDebugTable and eAct and barstate.islast
    string sDir = elliottDirection == 1 ? "BUY" : elliottDirection == -1 ? "SELL" : "-"
    string sState = elliottNoTrade ? "NoTrade" : elliottBiasLong ? "BIAS L" : elliottBiasShort ? "BIAS S" : "-"
    table.cell(dbg, 0, 0,  "Elliott", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0,  sState, text_color = color.white, bgcolor = elliottNoTrade ? color.new(color.red, 20) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1,  "SignalType", text_color = color.white)
    table.cell(dbg, 1, 1,  f_typeStr(elliottSignalType), text_color = color.white)
    table.cell(dbg, 0, 2,  "Direction", text_color = color.white)
    table.cell(dbg, 1, 2,  sDir, text_color = color.white)
    table.cell(dbg, 0, 3,  "Rank", text_color = color.white)
    table.cell(dbg, 1, 3,  str.tostring(elliottRank), text_color = color.white)
    table.cell(dbg, 0, 4,  "Score", text_color = color.white)
    table.cell(dbg, 1, 4,  str.tostring(elliottScore), text_color = color.white)
    table.cell(dbg, 0, 5,  "Wave3 L/S", text_color = color.white)
    table.cell(dbg, 1, 5,  str.tostring(elliottWave3ScoreLong) + " / " + str.tostring(elliottWave3ScoreShort), text_color = color.white)
    table.cell(dbg, 0, 6,  "Wave5Warn L/S", text_color = color.white)
    table.cell(dbg, 1, 6,  str.tostring(elliottWave5WarningLong) + " / " + str.tostring(elliottWave5WarningShort), text_color = color.white)
    table.cell(dbg, 0, 7,  "NoTrade L/S", text_color = color.white)
    table.cell(dbg, 1, 7,  (elliottNoTradeLong ? "Y" : "N") + " / " + (elliottNoTradeShort ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 8,  "Momentum L/S", text_color = color.white)
    table.cell(dbg, 1, 8,  (momLong ? "Y" : "N") + " / " + (momShort ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 9,  "EMA L/S", text_color = color.white)
    table.cell(dbg, 1, 9,  (emaLong ? "Y" : "N") + " / " + (emaShort ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 10, "Pivot Count", text_color = color.white)
    table.cell(dbg, 1, 10, str.tostring(sz), text_color = color.white)

// ============================================================
//  Data Window 出力
// ============================================================
plot(elliottWave3ScoreLong,    "elliottWave3ScoreLong",    display = display.data_window)
plot(elliottWave3ScoreShort,   "elliottWave3ScoreShort",   display = display.data_window)
plot(elliottWave5WarningLong,  "elliottWave5WarningLong",  display = display.data_window)
plot(elliottWave5WarningShort, "elliottWave5WarningShort", display = display.data_window)

plot(elliottWave3CandidateLong  ? 1 : 0, "elliottWave3CandidateLong",  display = display.data_window)
plot(elliottWave3CandidateShort ? 1 : 0, "elliottWave3CandidateShort", display = display.data_window)

plot(elliottNoTrade      ? 1 : 0, "elliottNoTrade",      display = display.data_window)
plot(elliottNoTradeLong  ? 1 : 0, "elliottNoTradeLong",  display = display.data_window)
plot(elliottNoTradeShort ? 1 : 0, "elliottNoTradeShort", display = display.data_window)

plot(elliottBiasLong     ? 1 : 0, "elliottBiasLong",     display = display.data_window)
plot(elliottBiasShort    ? 1 : 0, "elliottBiasShort",    display = display.data_window)
plot(allowLongByElliott  ? 1 : 0, "allowLongByElliott",  display = display.data_window)
plot(allowShortByElliott ? 1 : 0, "allowShortByElliott", display = display.data_window)

plot(elliottSignalType, "elliottSignalType", display = display.data_window)
plot(elliottDirection,  "elliottDirection",  display = display.data_window)
plot(elliottRank,       "elliottRank",       display = display.data_window)
plot(elliottScore,      "elliottScore",      display = display.data_window)

plot(wave1Long,         "wave1Long",         display = display.data_window)
plot(wave2RetraceLong,  "wave2RetraceLong",  display = display.data_window)
plot(wave3Long,         "wave3Long",         display = display.data_window)
plot(wave1Short,        "wave1Short",        display = display.data_window)
plot(wave2RetraceShort, "wave2RetraceShort", display = display.data_window)
plot(wave3Short,        "wave3Short",        display = display.data_window)

// ============================================================
//  Alert
// ============================================================
alertcondition(eAct and elliottWave3CandidateLong  and not elliottWave3CandidateLong[1],  "Elliott Wave3 Long",  "{{ticker}} Elliott ③波候補 BUY")
alertcondition(eAct and elliottWave3CandidateShort and not elliottWave3CandidateShort[1], "Elliott Wave3 Short", "{{ticker}} Elliott ③波候補 SELL")
alertcondition(eAct and warnLongActive  and not warnLongActive[1],  "Elliott Wave5 Warning Long",  "{{ticker}} Elliott ⑤波警戒 BUY")
alertcondition(eAct and warnShortActive and not warnShortActive[1], "Elliott Wave5 Warning Short", "{{ticker}} Elliott ⑤波警戒 SELL")
alertcondition(elliottNoTradeLong,  "Elliott NoTrade Long",  "{{ticker}} Elliott NoTrade BUY")
alertcondition(elliottNoTradeShort, "Elliott NoTrade Short", "{{ticker}} Elliott NoTrade SELL")
alertcondition(allowLongByElliott,  "Allow Long Elliott",  "{{ticker}} Elliott ロング許可")
alertcondition(allowShortByElliott, "Allow Short Elliott", "{{ticker}} Elliott ショート許可")

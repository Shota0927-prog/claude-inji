    [sCnt, rCnt, o_candidateScratchSupportNewLength, o_candidateScratchResistanceNewLength, o_candidateSupportFvgLength, o_candidateResistanceFvgLength, o_candidateBestSide, o_candidateBestStage, o_candidateBestLeftIndex, o_candidateBestRightIndex, o_candidateBestEffectiveBottomTick, o_candidateBestEffectiveTopTick, o_candidateBestCCount, o_candidateBestHCount, o_candidateBestDensity, o_candidateBestBaseStrong, o_candidateBestCreatedTime, o_candidateBestMinRootId, o_candidateBestFvgMode, o_candidateBestFvgRootSlot, o_candidateBestCategoryMask, o_candidateBestHighMask, o_candidateRoundTie, o_candidateFailedSupport, o_candidateFailedResistance, o_candidateWinnerLogicalCount, o_candidateWinnerRootIdLength, o_candidateWinnerRefValueLength, o_candidateWinnerRefRepLength, o_candidatePoolMode, o_candidateBroadSeenEpoch] = V3Probe.selectBothSidesProbe(fr.rootIds, fr.rootCategories, fr.rootSubtypes, fr.rootTfCodes, fr.rootConfirmedTimes, fr.rootPointPrices, fr.rootPointTicks, fr.rootNativeBottoms, fr.rootNativeTops, fr.rootNativeBottomTicks, fr.rootNativeTopTicks, fr.rootStates, fr.rootPairKeys, fr.rootDirections, fr.rootIsBroadFvgFlags, fr.rootLabelMasks, fr.rootSlotLiveFlags, fr.rootPriceOrderSlots, fr.rootIdOrderSlots, fr.rootIdToSlot, fr.accumPairUpperRootSlotByKey, fr.accumPairLowerRootSlotByKey, fr.rootSwingTfMasks, fr.ema2000RootSlot, fr.ema2000ExpectedRootId, fr.ema2000SlopeDir, fr.ema3000RootSlot, fr.ema3000ExpectedRootId, fr.ema3000SlopeDir, L2B_CLUSTER_MAX_WIDTH, L2B_DENSE_RATIO, true, true, true, true, true, true, L2B_MINTICK, fc.candidateScratchSupportNewRootSlots, fc.candidateScratchResistanceNewRootSlots, fc.candidateSupportScratchPosByRootSlot, fc.candidateResistanceScratchPosByRootSlot, fc.candidateSupportUsedByRootSlot, fc.candidateResistanceUsedByRootSlot, fc.candidateSupportFvgRootSlots, fc.candidateResistanceFvgRootSlots, fc.candidateWindowMinRootIdDequeScratchIndexes, fc.candidateWindowMaxConfirmedTimeDequeScratchIndexes, fc.candidateWinnerSides, fc.can
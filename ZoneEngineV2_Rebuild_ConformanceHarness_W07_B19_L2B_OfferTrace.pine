//@version=6
// ============================================================
// ZoneEngineV2_Rebuild_ConformanceHarness_W07_B19_L2B_OfferTrace.pine
// W07 B19 Lane2B : actual Stage A / B candOfferRaw offer trace parity, W05 /3 (B19BaselineProbe /1) vs W05 /4
// (B19Probe /1). Build 190202. 50 W fixtures (the L2A W set, same fixture values; I05 .. I07 excluded), run once on the
// last bar by a for loop. Each Probe gets its own fresh arrays (w06BuildProductionArraysRaw) and runs
// selectBothSidesProbe once. The offer records (stride 21) are compared as an order-free exact multiset per fixture
// over every semantic field (side, stage, poolMode, roundNo, the point Root ID list read through offset / count,
// fvgRootId1 / 2, psychLevelTick, effective ticks, C, H, density, baseStrong, categoryMask, highMask, createdTime,
// minRootId, fvgMode, broadLocalized); pointRootOffset is a physical locator and is never compared. No W04
// enumeration, no pseudo offer, no allowance for missing / extra records (branch-and-bound runs in both Probes).
// Verbatim copies (logic unchanged, no rename) from ZoneEngineV2_Rebuild_ConformanceHarness.pine: the REF_* constants
// and the RefRoot type (L17-L87) and the H01 fixture foundation (L1625-L2100). No request.*(), no drawing.
// ============================================================
indicator("ZoneEngineV2 W07 B19 L2B Offer Trace", overlay = false)

import sekine3310/ZoneEngineV2_W05Candidate_B19BaselineProbe/1 as V3Probe
import sekine3310/ZoneEngineV2_W05Candidate_B19Probe/1 as V4Probe

// ==================== verbatim : REF_* constants + RefRoot (ConformanceHarness L17-L87) ====================
// ---- W04 Reference internal stage codes (not a Production enum, never exported) ----
const int REF_STAGE_A             = 0
const int REF_STAGE_B             = 1
const int REF_STAGE_C             = 2
const int REF_STAGE_BROAD_CONTEXT = 3

// ---- W04 B02 : Reference-local mirrors of Production enum values (never exported) ----
const int REF_CAT_ACCUM           = 2
const int REF_CAT_FVG             = 4
const int REF_CAT_PSYCH           = 5
const int REF_SIDE_SUPPORT        = 1

didateWinnerStages, fc.candidateWinnerEffectiveBottomTicks, fc.candidateWinnerEffectiveTopTicks, fc.candidateWinnerCCounts, fc.candidateWinnerHCounts, fc.candidateWinnerDensities, fc.candidateWinnerBaseStrongFlags, fc.candidateWinnerCategoryMasks, fc.candidateWinnerHighMasks, fc.candidateWinnerCreatedTimes, fc.candidateWinnerMinRootIds, fc.candidateWinnerFvgModes, fc.candidateWinnerPsychLevelTicks, fc.candidateWinnerReferencePrices, fc.candidateWinnerRootIdOffsets, fc.candidateWinnerRootIdLengths, fc.candidateWinnerRootIds, fc.candidateWinnerRefValueScratch, fc.candidateWinnerRefRepScratch, fc.candidateBroadSeenEpochByRootSlot, fc.candidateScratchSupportNewLength, fc.candidateScratchResistanceNewLength, fc.candidateSupportFvgLength, fc.candidateResistanceFvgLength, fc.candidateBestSide, fc.candidateBestStage, fc.candidateBestLeftIndex, fc.candidateBestRightIndex, fc.candidateBestEffectiveBottomTick, fc.candidateBestEffectiveTopTick, fc.candidateBestCCount, fc.candidateBestHCount, fc.candidateBestDensity, fc.candidateBestBaseStrong, fc.candidateBestCreatedTime, fc.candidateBestMinRootId, fc.candidateBestFvgMode, fc.candidateBestFvgRootSlot, fc.candidateBestCategoryMask, fc.candidateBestHighMask, fc.candidateRoundTie, fc.candidateFailedSupport, fc.candidateFailedResistance, fc.candidateWinnerLogicalCount, fc.candidateWinnerRootIdLength, fc.candidateWinnerRefValueLength, fc.candidateWinnerRefRepLength, fc.candidatePoolMode, fc.candidateBroadSeenEpoch, outInts, outIds)
    fc.candidateScratchSupportNewLength := o_candidateScratchSupportNewLength
    fc.candidateScratchResistanceNewLength := o_candidateScratchResistanceNewLength
    fc.candidateSupportFvgLength := o_candidateSupportFvgLength
    fc.candidateResistanceFvgLength := o_candidateResistanceFvgLength
    fc.candidateBestSide := o_candidateBestSide
    fc.candidateBestStage := o_candidateBestStage
    fc.candidateBestLeftIndex := o_candidateBestLeftIndex
    fc.candidateBestRightIndex := o_candidateBestRightIndex
    fc.candidateBestEffectiveBottomTick := o_candidateBestEffectiveBottomTick
    fc.candidateBestEffectiveTopTick := o_candidateBestEffectiveTopTick
    fc.candidateBestCCount := o_candidateBestCCount
    fc.candidateBestHCount := o_candidateBestHCount
    fc.candidateBestDensity := o_candidateBestDensity
    fc.candidateBestBaseStrong := o_candidateBestBaseStrong
    fc.candidateBestCreatedTime := o_candidateBestCreatedTime
    fc.candidateBestMinRootId := o_candidateBestMinRootId
    fc.candidateBestFvgMode := o_candidateBestFvgMode
    fc.candidateBestFvgRootSlot := o_candidateBestFvgRootSlot
    fc.candidateBestCategoryMask := o_candidateBestCategoryMask
    fc.candidateBestHighMask := o_candidateBestHighMask
    fc.candidateRoundTie := o_candidateRoundTie
    fc.candidateFailedSupport := o_candidateFailedSupport
    fc.candidateFailedResistance := o_candidateFailedResistance
    fc.candidateWinnerLogicalCount := o_candidateWinnerLogicalCount
    fc.candidateWinnerRootIdLength := o_candidateWinnerRootIdLength
    fc.candidateWinnerRefValueLength := o_candidateWinnerRefValueLength
    fc.candidateWinnerRefRepLength := o_candidateWinnerRefRepLength
    fc.candidatePoolMode := o_candidatePoolMode
    fc.candidateBroadSeenEpoch := o_candidateBroadSeenEpoch
    [sCnt, rCnt]

// na-safe int equality
l2bEq(int a, int b) =>
    (na(a) and na(b)) or (not na(a) and not na(b) and a == b)

// schema check of one Probe output : whole records, Stage A / B only, point ID ranges inside the ID pool
l2bSchemaOk(array<int> ints, array<int> ids) =>
    int  n  = array.size(ints)
    bool ok = n % L2B_STRIDE == 0
    int  nr = int(n / L2B_STRIDE)
    if ok and nr > 0
        for r = 0 to nr - 1
            int base  = r * L2B_STRIDE
            int stage = array.get(ints, base + 1)
            int off   = array.get(ints, base + 4)
            int cnt   = array.get(ints, base + 5)
            if not (stage == 0 or stage == 1) or na(off) or na(cnt) or off < 0 or cnt < 0 or off + cnt > array.size(ids)
                ok := false
    ok

// first differing semantic field of record i (a) and record j (b), 0 when equal; point IDs compared as the actual lists
l2bFirstDiff(array<int> aInts, array<int> aIds, int i, array<int> bInts, array<int> bIds, int j) =>
    int ai = i * L2B_STRIDE
    int bj = j * L2B_STRIDE
    int d  = 0
    array<int> fieldIdx = array.from(0, 1, 2, 3)
    array<int> fieldCode = array.from(L2B_F_SIDE, L2B_F_STAGE, L2B_F_POOL_MODE, L2B_F_ROUND_NO)
    for k = 0 to 3
        if d == 0 and not l2bEq(array.get(aInts, ai + array.get(fieldIdx, k)), array.get(bInts, bj + array.get(fieldIdx, k)))
            d := array.get(fieldCode, k)
    if d == 0
        int aCnt = array.get(aInts, ai + 5)
        int bCnt = array.get(bInts, bj + 5)
        if aCnt != bCnt
            d := L2B_F_POINT_COUNT
        else if aCnt > 0
            int aOff = array.get(aInts, ai + 4)
            int bOff = array.get(bInts, bj + 4)
            for p = 0 to aCnt - 1
                if d == 0 and array.get(aIds, aOff + p) != array.get(bIds, bOff + p)
                    d := L2B_F_POINT_IDS
    if d == 0
        for k = 6 to 20
            if d == 0 and not l2bEq(array.get(aInts, ai + k), array.get(bInts, bj + k))
                d := k + 1
    d

// order-free exact multiset comparison of two Probe traces : [missing (a unmatched), extra (b unmatched), class, field]
// class for unmatched records (identity = fields 1 .. 8 : side, stage, poolMode, roundNo, point count, point IDs,
// fvgRootId1 / 2; each unmatched record is scored against the unmatched records of the other trace by the longest
// leading run of equal fields) : MISSING = an unmatched a record with no identity partner, else EXTRA = an unmatched
// b record with no identity partner, else SEMANTIC (identity partner exists, a later field differs); field = that
// first differing field code (0 when the other trace has no unmatched record)
l2bMultiset(array<int> aInts, array<int> aIds, array<int> bInts, array<int> bIds) =>
    int nA = int(array.size(aInts) / L2B_STRIDE)
    int nB = int(array.size(bInts) / L2B_STRIDE)
    array<bool> usedB  = array.new_bool(nB, false)
    array<bool> matchA = array.new_bool(nA, false)
    if nA > 0 and nB > 0
        for i = 0 to nA - 1
            bool found = false
            for j = 0 to nB - 1
                if not found and not array.get(usedB, j)
                    if l2bFirstDiff(aInts, aIds, i, bInts, bIds, j) == 0
                        array.set(usedB, j, true)
                        found := true
            array.set(matchA, i, found)
    int missing = 0
    int extra   = 0
    int firstA  = -1
    if nA > 0
        for i = 0 to nA - 1
            if not array.get(matchA, i)
                missing += 1
                if firstA < 0
                    firstA := i
    if nB > 0
        for j = 0 to nB - 1
            if not array.get(usedB, j)
                extra += 1
    int cls      = L2B_CMP_NONE
    int field    = 0
    int semField = 0
    if nA > 0 and missing > 0
        for i = 0 to nA - 1
            if not array.get(matchA, i)
                int best = 0
                if nB > 0
                    for j = 0 to nB - 1
                        if not array.get(usedB, j)
                            int d = l2bFirstDiff(aInts, aIds, i, bInts, bIds, j)
                            if d > best
                                best := d
                if best <= L2B_F_FVG_ID2
                    if cls == L2B_CMP_NONE
                        cls   := L2B_CMP_MISSING
                        field := best
                else if semField == 0
                    semField := best
    if cls == L2B_CMP_NONE and nB > 0 and extra > 0
        for j = 0 to nB - 1
            if not array.get(usedB, j)
                int best = 0
                if nA > 0
                    for i = 0 to nA - 1
                        if not array.get(matchA, i)
                            int d = l2bFirstDiff(aInts, aIds, i, bInts, bIds, j)
                            if d > best
                                best := d
                if best <= L2B_F_FVG_ID2 and cls == L2B_CMP_NONE
                    cls   := L2B_CMP_EXTRA
                    field := best
    if cls == L2B_CMP_NONE and (missing > 0 or extra > 0)
        cls   := L2B_CMP_SEMANTIC
        field := semField
    [missing, extra, cls, field]

// one fixture : returns [compare, field, traceF, countF, semanticF, missing, extra, broadF, v3Offers, v4Offers]
// compare order : input 1, schema 2, count 3 (field = multiset field), equal count : missing 4 / extra 5 / semantic 6
// (semanticF counts every equal-count record mismatch), then winner sanity (6, fields 31 .. 34); a failure on a fixture
// holding a Broad FVG Root (601 .. 608, 701 .. 705, 806, 901, 902) is reported as 7 with field = compare * 100 + field
l2bRunFixture(int code) =>
    L2bFx x = l2bBuild(code)
    // Broad fixture = the fixture holds at least one Broad FVG Root (read from the fixture data, not the code group)
    bool isBroad = false
    for rr in x.roots
        if rr.isBroadFvg
            isBroad := true
    int  cmp     = L2B_CMP_NONE
    int  field   = -1
    int  countF  = 0
    int  semF    = 0
    int  missing = 0
    int  extra   = 0
    int  n3      = 0
    int  n4      = 0
    [fr3, fc3, fw3, fj3, ok3] = w06BuildProductionArraysRaw(x.roots, x.originKeys, L2B_MINTICK)
    [fr4, fc4, fw4, fj4, ok4] = w06BuildProductionArraysRaw(x.roots, x.originKeys, L2B_MINTICK)
    array<int> ints3 = array.new_int(0)
    array<int> ids3  = array.new_int(0)
    array<int> ints4 = array.new_int(0)
    array<int> ids4  = array.new_int(0)
    if not (ok3 and ok4 and array.size(x.roots) > 0)
        cmp := L2B_CMP_INPUT
    else
        [s3, r3] = l2bRunV3(fr3, fc3, ints3, ids3)
        [s4, r4] = l2bRunV4(fr4, fc4, ints4, ids4)
        if not (l2bSchemaOk(ints3, ids3) and l2bSchemaOk(ints4, ids4))
            cmp := L2B_CMP_SCHEMA
        else
            n3 := int(array.size(ints3) / L2B_STRIDE)
            n4 := int(array.size(ints4) / L2B_STRIDE)
            [m, e, mc, f] = l2bMultiset(ints3, ids3, ints4, ids4)
            missing := m
            extra   := e
            if n3 != n4
                countF := 1
                cmp    := L2B_CMP_COUNT
                field  := f
            else if mc != L2B_CMP_NONE
                semF  := 1
                cmp   := mc
                field := f
            // winner sanity (full winner parity is L2C)
            if cmp == L2B_CMP_NONE
                if s3 != s4
                    cmp   := L2B_CMP_SEMANTIC
                    field := L2B_F_W_SUPPORT_COUNT
                else if r3 != r4
                    cmp   := L2B_CMP_SEMANTIC
                    field := L2B_F_W_RESISTANCE_COUNT
                else if fc3.candidateFailedSupport != fc4.candidateFailedSupport
                    cmp   := L2B_CMP_SEMANTIC
                    field := L2B_F_W_FAILED_SUPPORT
                else if fc3.candidateFailedResistance != fc4.candidateFailedResistance
                    cmp   := L2B_CMP_SEMANTIC
                    field := L2B_F_W_FAILED_RESIST
                if cmp != L2B_CMP_NONE
                    semF := 1
    bool failed = cmp != L2B_CMP_NONE
    int  outCmp   = cmp
    int  outField = field
    if failed and isBroad
        outCmp   := L2B_CMP_BROAD
        outField := cmp * 100 + field
    [outCmp, outField, failed ? 1 : 0, countF, semF, missing, extra, (failed and isBroad) ? 1 : 0, n3, n4]

// every fixture once (for loop only); returns the Data Window values
l2bRunAll() =>
    array<int> codes = array.from(201, 202, 203, 204, 206, 207, 208, 209, 210, 213, 214, 301, 302, 303, 304, 305, 306, 307, 308, 401, 402, 403, 404, 405, 406, 601, 602, 603, 604, 605, 606, 607, 608, 701, 702, 703, 704, 705, 801, 802, 803, 804, 805, 806, 901, 902, 1001, 1002, 1003, 1004)
    int failures  = 0
    int executed  = 0
    int firstFail = -1
    int firstCmp  = L2B_CMP_NONE
    int firstFld  = -1
    int traceF    = 0
    int countF    = 0
    int semF      = 0
    int missTot   = 0
    int extraTot  = 0
    int broadF    = 0
    int v3Tot     = 0
    int v4Tot     = 0
    for k = 0 to 50 - 1
        int code = array.get(codes, k)
        [c, f, tf, cf, sf, mi, ex, bf, o3, o4] = l2bRunFixture(code)
        executed += 1
        traceF   += tf
        countF   += cf
        semF     += sf
        missTot  += mi
        extraTot += ex
        broadF   += bf
        v3Tot    += o3
        v4Tot    += o4
        if c != L2B_CMP_NONE
            failures += 1
            if firstFail < 0
                firstFail := code
                firstCmp  := c
                firstFld  := f
    [failures, executed, firstFail, firstCmp, firstFld, traceF, countF, semF, missTot, extraTot, broadF, v3Tot, v4Tot]

var int gFailures  = -1
var int gExecuted  = 0
var int gFirstFail = -1
var int gFirstCmp  = -1
var int gFirstFld  = -1
var int gTraceF    = -1
var int gCountF    = -1
var int gSemF      = -1
var int gMissTot   = -1
var int gExtraTot  = -1
var int gBroadF    = -1
var int gV3Tot     = 0
var int gV4Tot     = 0
if barstate.islast and gExecuted == 0
    [a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13] = l2bRunAll()
    gFailures  := a1
    gExecuted  := a2
    gFirstFail := a3
    gFirstCmp  := a4
    gFirstFld  := a5
    gTraceF    := a6
    gCountF    := a7
    gSemF      := a8
    gMissTot   := a9
    gExtraTot  := a10
    gBroadF    := a11
    gV3Tot     := a12
    gV4Tot     := a13

plot(190202,     "W07 B19 L2B Build",                display = display.data_window)
plot(gFailures,  "W07 B19 L2B Failures",             display = display.data_window)
plot(gExecuted,  "W07 B19 L2B Fixture Count",        display = display.data_window)
plot(gFirstFail, "W07 B19 L2B First Fail Fixture",   display = display.data_window)
plot(gFirstCmp,  "W07 B19 L2B First Compare",        display = display.data_window)
plot(gFirstFld,  "W07 B19 L2B First Field",          display = display.data_window)
plot(gTraceF,    "W07 B19 L2B Trace Failures",       display = display.data_window)
plot(gCountF,    "W07 B19 L2B Count Failures",       display = display.data_window)
plot(gSemF,      "W07 B19 L2B Semantic Failures",    display = display.data_window)
plot(gMissTot,   "W07 B19 L2B Missing Total",        display = display.data_window)
plot(gExtraTot,  "W07 B19 L2B Extra Total",          display = display.data_window)
plot(gBroadF,    "W07 B19 L2B Broad Trace Failures", display = display.data_window)
plot(gV3Tot,     "W07 B19 L2B V3 Offer Total",       display = display.data_window)
plot(gV4Tot,     "W07 B19 L2B V4 Offer Total",       display = display.data_window)

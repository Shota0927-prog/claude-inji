type W06FxCand
    array<int> candidateScratchSupportNewRootSlots
    array<int> candidateScratchResistanceNewRootSlots
    array<int> candidateSupportScratchPosByRootSlot
    array<int> candidateResistanceScratchPosByRootSlot
    array<bool> candidateSupportUsedByRootSlot
    array<bool> candidateResistanceUsedByRootSlot
    array<int> candidateSupportFvgRootSlots
    array<int> candidateResistanceFvgRootSlots
    array<int> candidateWindowMinRootIdDequeScratchIndexes
    array<int> candidateWindowMaxConfirmedTimeDequeScratchIndexes
    array<int> candidateWinnerSides
    array<int> candidateWinnerStages
    array<int> candidateWinnerEffectiveBottomTicks
    array<int> candidateWinnerEffectiveTopTicks
    array<int> candidateWinnerCCounts
    array<int> candidateWinnerHCounts
    array<int> candidateWinnerDensities
    array<bool> candidateWinnerBaseStrongFlags
    array<int> candidateWinnerCategoryMasks
    array<int> candidateWinnerHighMasks
    array<int> candidateWinnerCreatedTimes
    array<int> candidateWinnerMinRootIds
    array<int> candidateWinnerFvgModes
    array<int> candidateWinnerPsychLevelTicks
    array<float> candidateWinnerReferencePrices
    array<int> candidateWinnerRootIdOffsets
    array<int> candidateWinnerRootIdLengths
    array<int> candidateWinnerRootIds
    array<float> candidateWinnerRefValueScratch
    array<float> candidateWinnerRefRepScratch
    array<int> candidateBroadSeenEpochByRootSlot
    int candidateScratchSupportNewLength = 0
    int candidateScratchResistanceNewLength = 0
    int candidateSupportFvgLength = 0
    int candidateResistanceFvgLength = 0
    int candidateBestSide = 0
    int candidateBestStage = na
    int candidateBestLeftIndex = -1
    int candidateBestRightIndex = -1
    int candidateBestEffectiveBottomTick = na
    int candidateBestEffectiveTopTick = na
    int candidateBestCCount = 0
    int candidateBestHCount = 0
    int candidateBestDensity = na
    bool candidateBestBaseStrong = false
    int candidateBestCreatedTime = na
    int candidateBestMinRootId = 0
    int candidateBestFvgMode = 0
    int candidateBestFvgRootSlot = -1
    int candidateBestCategoryMask = 0
    int candidateBestHighMask = 0
    bool candidateRoundTie = false
    bool candidateFailedSupport = false
    bool candidateFailedResistance = false
    int candidateWinnerLogicalCount = 0
    int candidateWinnerRootIdLength = 0
    int candidateWinnerRefValueLength = 0
    int candidateWinnerRefRepLength = 0
    int candidatePoolMode = 0
    int candidateBroadSeenEpoch = 0


// ============================================================================
// SAT BAND Entry Strategy
//   「SAT BAND Reconstruction Test」インジケーターの f_satBand() を計算上の唯一の
//   基準として移植し、4 モードを個別に検証するための独立した strategy。
//
//   ※ 元ファイル（SAT_BAND_Reconstruction_Test.pine）は変更していない。
//     ここへ必要な計算を移植しただけで、計算式・初期化・State 更新順序・
//     青／赤／フラット判定はいずれも変えていない。
//   ※ ZoneEngine、他の SAT 近似版、外部の点数判定は組み込んでいない。
//   ※ 指示書にない売買フィルターや指標は追加していない。
//
//   ■ 実行前提
//     ・XAUUSD / 15秒足チャート。ほかの銘柄・時間足では取引を停止し理由を表示する。
//     ・モードは 巡行 / 逆行 / レンジ反発 / レンジブレイク から 1 つだけ選ぶ。
//     ・同時保有は 1 件、pyramiding = 0。
//
//   ■ 確定足の扱い
//     ・15秒足の判定は barstate.isconfirmed のみ。
//     ・上位足は request.security(..., 式[1], lookahead_on) で最後に確定した足の
//       値だけを取る。形成中の上位足は売買判定に使わない。
//       [1] を要求先時間足の式の内側に置き lookahead_on と組み合わせるのが
//       リペイントしない組み合わせで、ヒストリカルとリアルタイムで見え方が一致する。
//     ・State・LINE1・LINE2・STB・終値・高値・安値・足の時刻は
//       同一の確定足からタプルで一括取得する。
//     ・上下限の窓は「候補足の開始時刻までに確定した算出足の直近 N 本」を
//       候補足ごとに凍結して使う。候補足自身は窓に入らず、その 1 本前は入る。
//       算出足と候補足の時間足が違っても同じ規則で対応づく。
//
//   ■ 約定
//     ・process_orders_on_close = false → シグナル足の次の15秒足始値で約定。
//     ・calc_on_every_tick = false / calc_on_order_fills = true。
//     ・約定を最初に検知した実行で strategy.position_avg_price を読み、
//       記録済みの境界価格から SL / TP を設置する。
//     ・約定直後の追加実行は barstate.isconfirmed だけで見分けない。
//       取引履歴から導いた inPosition / awaitingFill /
//       enteredThisBar / exitedThisBar を併用し、
//       どの追加実行でも新規シグナルとセットアップの状態遷移を進めない。
//       エントリー約定後は SL/TP 設置、決済約定後は再エントリー防止と
//       セットアップ破棄を明示的に処理する。
//
//   ■ 仕様上の解釈（利用者確認済み）
//     ・§5-4：赤の15秒足自体が支持線±許容幅の圏内にあれば待機開始。
//             交差足との前後関係は問わない。
//     ・§8  ：15秒/30秒/1分の確定青は同時でなくてよい（各足が一度ずつ）。
//             30秒の消灯と1分の支え確認は順不同。最後に30秒の再点灯でエントリー。
//     ・§6  ：梯子は 15秒→30秒→1分→5分→15分→1時間 で固定。
//             目標足は 5分 / 15分 / 1時間 のみ（背景足より短いもの）。
// ============================================================================
//@version=6
strategy("SAT BAND Entry Strategy", shorttitle = "SAT Entry", overlay = true,
     pyramiding                 = 0,
     process_orders_on_close    = false,
     calc_on_every_tick         = false,
     calc_on_order_fills        = true,
     default_qty_type           = strategy.fixed,
     default_qty_value          = 1,
     initial_capital            = 100000,
     commission_type            = strategy.commission.percent,
     commission_value           = 0,
     slippage                   = 0,
     max_labels_count           = 500)

// ============================================================================
// 00｜入力
// ============================================================================
string G_MODE = "00｜モード"
string G_RISK = "01｜共通リスク"
string G_TR   = "02｜トレンド巡行"
string G_CN   = "03｜トレンド逆行"
string G_RG   = "04｜レンジ定義"
string G_RB   = "05｜レンジ端反発"
string G_BK   = "06｜レンジ端ブレイク"
string G_DBG  = "07｜デバッグ"

string M_TREND = "トレンド巡行"
string M_CNTR  = "トレンド逆行"
string M_RBND  = "レンジ端反発"
string M_BRK   = "レンジ端ブレイク"

string D_BOTH  = "両方向"
string D_LONG  = "ロングのみ"
string D_SHORT = "ショートのみ"

mode    = input.string(M_TREND, "モード", options = ["トレンド巡行", "トレンド逆行", "レンジ端反発", "レンジ端ブレイク"], group = G_MODE,
     tooltip = "1 回に 1 モードだけを検証する。モード間で条件や約定を混ぜない。")
dirMode = input.string(D_BOTH, "売買方向", options = ["両方向", "ロングのみ", "ショートのみ"], group = G_MODE)

// --- 共通リスク ---
slOffset = input.float(5.0, "SLオフセット（XAUUSDドル）", minval = 0.0, step = 0.1, group = G_RISK,
     tooltip = "ロングSL = 消灯境界 − オフセット、ショートSL = 消灯境界 + オフセット。\nSL価格はエントリー時に一度だけ確定し、ポジション中にラインが動いても追従させない。")
rrRatio  = input.float(1.0, "TPのRR", minval = 0.1, step = 0.1, group = G_RISK,
     tooltip = "実際の約定価格と固定SLの距離を1RとしてTPを計算する。\nロング TP = 約定価格 + RR ×（約定価格 − SL）。")
qtySize  = input.float(1.0, "数量（利用銘柄の取引数量）", minval = 0.0, step = 0.01, group = G_RISK,
     tooltip = "利用銘柄の取引数量。1 を 1 ロットと決めつけていない。\n手数料・スプレッド・スリッページはストラテジーテスターのプロパティで設定し、\n報告時にその設定値を明示すること。スクリプト側の既定は 0 にしてある。")

// --- 02 トレンド巡行 ---
trUse5   = input.bool(true,  "5分",   group = G_TR, inline = "tr1")
trUse15  = input.bool(false, "15分",  group = G_TR, inline = "tr1")
trUse60  = input.bool(false, "1時間", group = G_TR, inline = "tr1")
trUse240 = input.bool(false, "4時間", group = G_TR, inline = "tr1")
trAgg    = input.string("OR", "集約", options = ["OR", "AND"], group = G_TR,
     tooltip = "OR：選択足のどれか1つが最後の確定足で青（ショートは赤）。\nAND：選択足のすべて。\nANDは点灯の条件であって、すべての線に接近する条件ではない。")
trNear   = input.float(1.0, "接近許容幅（XAUUSDドル）", minval = 0.0, step = 0.1, group = G_TR)
trTrig   = input.string("A：赤の後にフラット", options = ["A：赤の後にフラット", "B：赤の後に青"], group = G_TR,
     tooltip = "A（既定）：赤を見た後で15秒足が確定フラット(0)。\nB：赤を見た後で確定青(+1)。赤→フラット→青も有効。\nどちらもトリガー足の確定終値が記録した支持線より厳密に上であることを必須とする。")

// --- 03 トレンド逆行 ---
cnBgTf  = input.string("4時間", "背景足", options = ["5分", "15分", "1時間", "4時間"], group = G_CN,
     tooltip = "ロングは背景足が確定赤、ショートは確定青。")
cnTgtTf = input.string("15分", "目標足", options = ["5分", "15分", "1時間"], group = G_CN,
     tooltip = "梯子は 15秒→30秒→1分→5分→15分→1時間 で固定。\n目標足は背景足より短いものだけ有効。目標15分なら 15秒・30秒・1分・5分・15分 の順に点灯を要求する。")

// --- 04 レンジ定義 ---
rgUse5   = input.bool(true,  "5分",   group = G_RG, inline = "rg1")
rgUse15  = input.bool(false, "15分",  group = G_RG, inline = "rg1")
rgUse60  = input.bool(false, "1時間", group = G_RG, inline = "rg1")
rgUse240 = input.bool(false, "4時間", group = G_RG, inline = "rg1")
rgBoundTf  = input.string("5", "上下限算出足", options = ["5", "15", "60", "240"], group = G_RG,
     tooltip = "分表記。候補足より前に確定した指定本数の最高値を上限、最安値を下限とする。\n判定中の足の高値・安値は境界へ混ぜない。")
rgBoundLen = input.int(60, "上下限の本数", minval = 2, maxval = 2000, group = G_RG)

// --- 05 レンジ端反発 ---
rbNear = input.float(5.0, "境界への接近幅（XAUUSDドル）", minval = 0.0, step = 0.1, group = G_RB,
     tooltip = "5分足の確定終値が 下限以上・下限＋この幅以下 に入ったら下限セットアップを開始する。\n上下限算出足に5分以外を選んでも、接近判定の終値は5分足を使う。")

// --- 06 レンジ端ブレイク ---
bkTf    = input.string("5", "ブレイク判定足", options = ["5", "15", "60", "240"], group = G_BK, tooltip = "分表記。")
bkUse5   = input.bool(true,  "5分",   group = G_BK, inline = "bk1")
bkUse15  = input.bool(false, "15分",  group = G_BK, inline = "bk1")
bkUse60  = input.bool(false, "1時間", group = G_BK, inline = "bk1")
bkUse240 = input.bool(false, "4時間", group = G_BK, inline = "bk1")
bkAgg    = input.string("OR", "確認上位足の集約", options = ["OR", "AND"], group = G_BK,
     tooltip = "巡行フィルターとは独立した設定。")

// --- 07 デバッグ ---
dbgMode   = input.bool(false, "Debug（データウィンドウ出力）", group = G_DBG)
dbgMarker = input.bool(false, "セットアップ／シグナルのマーカー表示", group = G_DBG)
dbgTable  = input.bool(false, "Debug テーブル（右上・時刻と価格）", group = G_DBG,
     tooltip = "plot 数の上限に触れないよう、時刻つきの記録はテーブルで出す。")

// ============================================================================
// 01｜SAT BAND 本体（元インジケーターからの移植。式は一切変えていない）
//   戻り値: [line1, line2, stb, dir1, dir2, stbDir, bandState]
//   bandState は +1 = 青 / -1 = 赤 / 0 = フラット（等号は青・赤に含めない）
// ============================================================================
f_satBand() =>
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5
    float atr50V  = ta.atr(50)[1]
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5
    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    float stbUpperV   = ta.highest(high, 10)
    float stbLowerV   = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV]

// 上位足用：State・3本の線・終値・高値・安値・足の時刻を
//   「最後に確定した足」から一括で返す。
//   [1] は要求先時間足の式の内側に置き、lookahead_on と組み合わせる。
//   これが TradingView 推奨のリペイントしない組み合わせで、
//   ヒストリカルとリアルタイムで上位足の見え方が一致する。
//   （lookahead_off + [1] だとヒストリカル側で余分に 1 本古い値になり、
//     リアルタイムとの見え方の差が残るため使わない。）
//   返す 8 値（State〜確定足の開始時刻）はすべて同じ 1 本の確定足から取っている。
//   9 番目の time だけは「形成中の足の開始時刻」で、窓の凍結タイミングに使う。
//   形成中の足の開始時刻はその足が始まった時点で確定しているので未来情報ではない。
f_satBandHtf() =>
    [l1v, l2v, sbv, _d1, _d2, _sd, stv] = f_satBand()
    float l1c = l1v
    float l2c = l2v
    float sbc = sbv
    int   stc = stv
    [stc[1], l1c[1], l2c[1], sbc[1], close[1], high[1], low[1], time[1], time]

// 上下限：いま形成中の足を含めない直近 len 本の最高値・最安値と、その窓の開始・終了時刻。
//   算出足の足 k で評価すると、窓は k-len 〜 k-1、つまり k の開始時刻までに
//   確定した直近 len 本になる。窓の中身は k のデータを一切含まないので、
//   lookahead_on で取っても未来情報は入らない。
//   どの足に対応づけるかは呼び出し側の f_freezeWindow() で決める。
f_rangeHL(simple int len) =>
    float hiv = ta.highest(high, len)[1]
    float lov = ta.lowest(low, len)[1]
    [hiv, lov, time[len], time_close[1]]

// ブレイク判定足：確定足の終値・開始時刻・終了時刻と、形成中の足の開始時刻
f_brkBar() =>
    float c = close
    int   t = time
    int   tc = time_close
    [c[1], t[1], tc[1], t]

// 候補足の開始時点における「算出足の直近 len 本の窓」を凍結して返す。
//
//   formT        いま形成中の候補足の開始時刻
//   hi/lo/st/en  そのバー時点の算出足の窓（その算出足の開始時刻までに確定した直近 len 本）
//   戻り値       「確定した候補足」に対応する窓 [hi, lo, 開始時刻, 終了時刻]
//
//   候補足が始まったバーでその時点の窓を記録し、候補足が次へ進んだ時点で
//   それを「確定した候補足の窓」へ繰り上げる。
//   こうすると算出足と候補足の時間足が違っても、必ず
//   「候補足の開始時刻までに確定した算出足の直近 len 本」が対応づく。
//
//   例1  算出足5分 / 候補足4時間・08:00〜12:00
//        08:00 に始まる15秒足で 5分の窓（…〜08:00）を記録し、
//        12:00 に候補足が確定した時点でその窓を使う。
//   例2  算出足1時間 / 候補足5分・10:20〜10:25
//        10:20 に始まる15秒足で 1時間の窓（…〜10:00）を記録し、
//        10:25 に候補足が確定した時点でその窓を使う。
//
//   窓だけでなく「候補足の開始時点のレンジ適格性」と「候補足の開始時刻（＝候補ID）」も
//   同じタイミングで凍結する。こうすると候補足 k の確定時にレンジ判定足が点灯しても、
//   k に対応づいた適格性と境界は動かない。
//
//   var は呼び出し箇所ごとに独立するので、ブレイク用と接近判定用で混ざらない。
f_freezeWindow(int formT, float hi, float lo, int st, int en, bool elig) =>
    var int   curT  = na
    var float curHi = na
    var float curLo = na
    var int   curS  = na
    var int   curE  = na
    var bool  curEl = false
    var int   prvT  = na
    var float prvHi = na
    var float prvLo = na
    var int   prvS  = na
    var int   prvE  = na
    var bool  prvEl = false
    // 記録は候補足の最初のチャート足でだけ行う（その足の確定時の値）。
    // ヒストリカルはその足を 1 回だけ評価し、リアルタイムは var が足頭へ
    // ロールバックするので毎ティック再記録され、最後に残るのも足の確定時の値。
    // よって履歴とリアルタイムで同じ値が残る。
    if not na(formT) and (na(curT) or curT != formT)
        prvT  := curT
        prvHi := curHi
        prvLo := curLo
        prvS  := curS
        prvE  := curE
        prvEl := curEl
        curT  := formT
        curHi := hi
        curLo := lo
        curS  := st
        curE  := en
        curEl := elig
    [prvHi, prvLo, prvS, prvE, prvEl, prvT]

// ============================================================================
// 02｜上位足の取得（同一確定足からタプルで一括）
// ============================================================================
string SYM = syminfo.tickerid

[st30S, l1_30S, l2_30S, sb_30S, c30S, h30S, lo30S, t30S, tf30S] = request.security(SYM, "30S", f_satBandHtf(), lookahead = barmerge.lookahead_on)
[st1,   l1_1,   l2_1,   sb_1,   c1,   h1,   lo1,   t1,   tf1]   = request.security(SYM, "1",   f_satBandHtf(), lookahead = barmerge.lookahead_on)
[st5,   l1_5,   l2_5,   sb_5,   c5,   h5,   lo5,   t5,   tf5]   = request.security(SYM, "5",   f_satBandHtf(), lookahead = barmerge.lookahead_on)
[st15,  l1_15,  l2_15,  sb_15,  c15,  h15,  lo15,  t15,  tf15]  = request.security(SYM, "15",  f_satBandHtf(), lookahead = barmerge.lookahead_on)
[st60,  l1_60,  l2_60,  sb_60,  c60,  h60,  lo60,  t60,  tf60]  = request.security(SYM, "60",  f_satBandHtf(), lookahead = barmerge.lookahead_on)
[st240, l1_240, l2_240, sb_240, c240, h240, lo240, t240, tf240] = request.security(SYM, "240", f_satBandHtf(), lookahead = barmerge.lookahead_on)

// 算出足のナマの窓（その算出足の開始時刻までに確定した直近 N 本）
[rgRawHi, rgRawLo, rgRawS, rgRawE] = request.security(SYM, rgBoundTf, f_rangeHL(rgBoundLen), lookahead = barmerge.lookahead_on)
// ブレイク判定足の確定足と形成中の足
[bkClose, bkCandOpenT, bkCandCloseT, bkFormT] = request.security(SYM, bkTf, f_brkBar(), lookahead = barmerge.lookahead_on)

// チャート足（15秒）はローカル計算
[l1c15v, l2c15v, sbc15v, _cd1, _cd2, _csd, stChartV] = f_satBand()

// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーしておく
float l1c15   = l1c15v
float l2c15   = l2c15v
float sbc15   = sbc15v
int   stChart = stChartV
int   s30S = st30S
int   s1m  = st1
int   s5m  = st5
int   s15m = st15
int   s60m = st60
int   s240 = st240

// 各足の消灯境界（青足＝3本の最大値＝支持、赤足＝3本の最小値＝抵抗）
float sup5   = math.max(l1_5,   math.max(l2_5,   sb_5))
float res5   = math.min(l1_5,   math.min(l2_5,   sb_5))
float sup15  = math.max(l1_15,  math.max(l2_15,  sb_15))
float res15  = math.min(l1_15,  math.min(l2_15,  sb_15))
float sup60  = math.max(l1_60,  math.max(l2_60,  sb_60))
float res60  = math.min(l1_60,  math.min(l2_60,  sb_60))
float sup240 = math.max(l1_240, math.max(l2_240, sb_240))
float res240 = math.min(l1_240, math.min(l2_240, sb_240))
float sup1   = math.max(l1_1,   math.max(l2_1,   sb_1))
float res1   = math.min(l1_1,   math.min(l2_1,   sb_1))

// ============================================================================
// 03｜実行環境ガードと共通ヘルパー
// ============================================================================
string symUp = str.upper(syminfo.ticker)
bool isGold  = str.contains(symUp, "XAU") or str.contains(symUp, "GOLD") or str.startswith(symUp, "GC")
bool isTf15S = timeframe.period == "15S"

string guardMsg = ""
if not isGold
    guardMsg := "銘柄が XAUUSD 系ではありません（取引停止）"
else if not isTf15S
    guardMsg := "15秒足チャートではありません（取引停止）。現在: " + timeframe.period
bool envOk = guardMsg == ""

// 選択足が 0 件ならモード無効
int  trSelCount = (trUse5 ? 1 : 0) + (trUse15 ? 1 : 0) + (trUse60 ? 1 : 0) + (trUse240 ? 1 : 0)
int  rgSelCount = (rgUse5 ? 1 : 0) + (rgUse15 ? 1 : 0) + (rgUse60 ? 1 : 0) + (rgUse240 ? 1 : 0)
int  bkSelCount = (bkUse5 ? 1 : 0) + (bkUse15 ? 1 : 0) + (bkUse60 ? 1 : 0) + (bkUse240 ? 1 : 0)

// 背景足・目標足の分換算と整合チェック
int cnBgMin  = cnBgTf  == "5分" ? 5 : cnBgTf  == "15分" ? 15 : cnBgTf == "1時間" ? 60 : 240
int cnTgtMin = cnTgtTf == "5分" ? 5 : cnTgtTf == "15分" ? 15 : 60

string modeMsg = ""
if mode == M_TREND and trSelCount == 0
    modeMsg := "巡行フィルターの選択足が 0 件です（モード無効）"
else if mode == M_CNTR and cnTgtMin >= cnBgMin
    modeMsg := "逆行の目標足が背景足以上です（モード無効）"
else if mode == M_RBND and rgSelCount == 0
    modeMsg := "レンジ判定足の選択が 0 件です（モード無効）"
else if mode == M_BRK and rgSelCount == 0
    modeMsg := "レンジ判定足の選択が 0 件です（モード無効）"
else if mode == M_BRK and bkSelCount == 0
    modeMsg := "ブレイク確認上位足の選択が 0 件です（モード無効）"
bool modeOk = modeMsg == ""

bool allowLong  = dirMode == D_BOTH or dirMode == D_LONG
bool allowShort = dirMode == D_BOTH or dirMode == D_SHORT

// 巡行フィルターの点灯集約（選択した赤・フラット足を青として扱わない）
f_aggOk(bool agg_or, int wanted, bool u5, int s5, bool u15, int s15v, bool u60, int s60v, bool u240, int s240v) =>
    bool anyOk = false
    bool allOk = true
    if u5
        if s5 == wanted
            anyOk := true
        else
            allOk := false
    if u15
        if s15v == wanted
            anyOk := true
        else
            allOk := false
    if u60
        if s60v == wanted
            anyOk := true
        else
            allOk := false
    if u240
        if s240v == wanted
            anyOk := true
        else
            allOk := false
    agg_or ? anyOk : allOk

// 候補の選び方（第3節）
//   15秒足終値からの絶対距離が最小のラインを選ぶ。同距離なら短い時間足。
//   候補は必ず 5分 → 15分 → 1時間 → 4時間 の昇順で走査し、比較は厳密な「<」で行う。
//   こうすると同距離のときは先に入った短い時間足がそのまま残る。

// 指定分の時間足の State を返す
f_stateOf(int tfMin) =>
    int r = na
    if tfMin == 5
        r := st5
    else if tfMin == 15
        r := st15
    else if tfMin == 60
        r := st60
    else
        r := st240
    r

// ============================================================================
// 04｜評価ゲート
//
//   約定直後の追加実行（calc_on_order_fills）を barstate.isconfirmed だけで
//   見分けない。建玉の状態から導いた独立したガードを併用する。
//
//     inPosition     … 建玉あり。エントリー約定の追加実行はここで必ず弾かれる。
//     awaitingFill   … 発注済み・約定待ち。
//     enteredThisBar … この足で建玉が発生した（決済済みでも検出できる）。
//     exitedThisBar  … この足で決済が起きた。
//
//   建玉サイズの前後比較（strategy.position_size[1]）は使わない。
//   シグナル足 N の終値で発注 → N+1 の始値で約定 → N+1 の途中で SL/TP 決済、
//   という並びでは position_size も position_size[1] もどちらも 0 になり、
//   サイズ比較では決済を検出できないため。
//   代わりに実際の取引履歴を見る。
//     strategy.closedtrades                              … 決済済み取引の本数
//     strategy.closedtrades.exit_bar_index(n-1)  == bar_index → この足で決済
//     strategy.closedtrades.entry_bar_index(n-1) == bar_index → この足で建玉（決済済み）
//     strategy.opentrades.entry_bar_index(m-1)   == bar_index → この足で建玉（保有中）
//   取引履歴は var ではないのでリアルタイムのロールバックの影響を受けず、
//   決済約定直後の追加実行でも、同じ足のバー確定時の実行でも同じ値になる。
//
//   mainEval が false の実行では、新規シグナルもセットアップの状態遷移も
//   一切進めない。4 つのガードはどれか 1 つが効けば追加実行を止められる。
// ============================================================================
var bool pendingEntry = false
var int  pendingDir   = 0
var float setupSL     = na
var string setupInfo  = ""
var int  entryOrderBar = na

// 建玉の発生・消滅を実際の取引履歴から判定する（var ではないのでロールバックに強い）
int ctN = strategy.closedtrades
int otN = strategy.opentrades
int lastExitBar      = ctN > 0 ? nz(strategy.closedtrades.exit_bar_index(ctN - 1),  -1) : -1
int lastClosedEntBar = ctN > 0 ? nz(strategy.closedtrades.entry_bar_index(ctN - 1), -1) : -1
int lastOpenEntBar   = otN > 0 ? nz(strategy.opentrades.entry_bar_index(otN - 1),   -1) : -1

bool inPosition   = strategy.position_size != 0
bool awaitingFill = pendingEntry
bool exitedThisBar  = lastExitBar == bar_index
bool enteredThisBar = lastOpenEntBar == bar_index or lastClosedEntBar == bar_index

bool tradingIdle = not inPosition and not awaitingFill and not exitedThisBar and not enteredThisBar
bool mainEval = barstate.isconfirmed and envOk and modeOk and tradingIdle

var int lastEntryBar = na
bool canEnter = mainEval and (na(lastEntryBar) or bar_index > lastEntryBar)

// 発注要求（この足の評価で 1 回だけ立てる）
float reqSL   = na
int   reqDir  = 0
string reqTag = ""

// ============================================================================
// 05｜トレンド巡行
// ============================================================================
bool trBullOk = f_aggOk(trAgg == "OR",  1, trUse5, st5, trUse15, st15, trUse60, st60, trUse240, st240)
bool trBearOk = f_aggOk(trAgg == "OR", -1, trUse5, st5, trUse15, st15, trUse60, st60, trUse240, st240)

var int   trDir  = 0       // 0=待機なし / 1=ロング待機 / -1=ショート待機
var float trLine = na      // 記録した支持（ロング）／抵抗（ショート）
var int   trTf   = 0       // 記録した時間足（分）

if mainEval and mode == M_TREND
    // --- 既存待機の破棄判定 ---
    if trDir != 0
        int recState = f_stateOf(trTf)
        bool keep = true
        if trDir == 1
            if recState != 1 or not trBullOk
                keep := false
        else
            if recState != -1 or not trBearOk
                keep := false
        if not keep
            trDir  := 0
            trLine := na
            trTf   := 0

    // --- 待機開始：赤(青)の15秒足自体が 境界±許容幅 の圏内にあること ---
    //   まず「圏内にある青足の支持線」だけを候補にし、その中から
    //   15秒足終値への絶対距離が最小のもの（同距離なら短い時間足）を選ぶ。
    if trDir == 0 and allowLong and trBullOk and stChart == -1
        bool z5   = trUse5   and st5   == 1 and not na(sup5)   and low <= sup5   + trNear and high >= sup5   - trNear
        bool z15  = trUse15  and st15  == 1 and not na(sup15)  and low <= sup15  + trNear and high >= sup15  - trNear
        bool z60  = trUse60  and st60  == 1 and not na(sup60)  and low <= sup60  + trNear and high >= sup60  - trNear
        bool z240 = trUse240 and st240 == 1 and not na(sup240) and low <= sup240 + trNear and high >= sup240 - trNear
        float bp = na
        int   bt = 0
        if z5
            bp := sup5
            bt := 5
        if z15 and (na(bp) or math.abs(close - sup15) < math.abs(close - bp))
            bp := sup15
            bt := 15
        if z60 and (na(bp) or math.abs(close - sup60) < math.abs(close - bp))
            bp := sup60
            bt := 60
        if z240 and (na(bp) or math.abs(close - sup240) < math.abs(close - bp))
            bp := sup240
            bt := 240
        if not na(bp)
            trDir  := 1
            trLine := bp
            trTf   := bt
    if trDir == 0 and allowShort and trBearOk and stChart == 1
        bool y5   = trUse5   and st5   == -1 and not na(res5)   and low <= res5   + trNear and high >= res5   - trNear
        bool y15  = trUse15  and st15  == -1 and not na(res15)  and low <= res15  + trNear and high >= res15  - trNear
        bool y60  = trUse60  and st60  == -1 and not na(res60)  and low <= res60  + trNear and high >= res60  - trNear
        bool y240 = trUse240 and st240 == -1 and not na(res240) and low <= res240 + trNear and high >= res240 - trNear
        float sp = na
        int   stf = 0
        if y5
            sp := res5
            stf := 5
        if y15 and (na(sp) or math.abs(close - res15) < math.abs(close - sp))
            sp := res15
            stf := 15
        if y60 and (na(sp) or math.abs(close - res60) < math.abs(close - sp))
            sp := res60
            stf := 60
        if y240 and (na(sp) or math.abs(close - res240) < math.abs(close - sp))
            sp := res240
            stf := 240
        if not na(sp)
            trDir  := -1
            trLine := sp
            trTf   := stf

    // --- トリガー ---
    if trDir != 0 and canEnter
        bool trigA = trTrig == "A：赤の後にフラット"
        if trDir == 1
            bool hit = trigA ? stChart == 0 : stChart == 1
            if hit and close > trLine and f_stateOf(trTf) == 1 and trBullOk
                reqDir := 1
                reqSL  := trLine - slOffset
                reqTag := "巡行L " + str.tostring(trTf) + "m 支持=" + str.tostring(trLine, format.mintick)
                // 1 セットアップにつき 1 回。新たな取引には新たな近接＋15秒赤が必要。
                trDir  := 0
                trLine := na
                trTf   := 0
        else
            bool hit = trigA ? stChart == 0 : stChart == -1
            if hit and close < trLine and f_stateOf(trTf) == -1 and trBearOk
                reqDir := -1
                reqSL  := trLine + slOffset
                reqTag := "巡行S " + str.tostring(trTf) + "m 抵抗=" + str.tostring(trLine, format.mintick)
                trDir  := 0
                trLine := na
                trTf   := 0

// ============================================================================
// 06｜トレンド逆行
//   梯子：15秒 → 30秒 → 1分 → 5分 → 15分 → 1時間（固定）
//   目標足までの各段階で「前回確定は青以外、今回確定は青」の転換を 1 回ずつ要求する。
//   同一確定時刻に複数段階が進むことは許す。先行段階が未成立の時点で起きた
//   後続段階の転換は遡って数えない。
// ============================================================================
int cnBgState = f_stateOf(cnBgMin)
int cnNeed = cnTgtMin == 5 ? 4 : cnTgtMin == 15 ? 5 : 6

// 各梯子足の「非青→青」「非赤→赤」転換（確定値の段差で検出）
bool tr15sUp = stChart == 1  and nz(stChart[1], 0) != 1
bool tr30sUp = s30S    == 1  and nz(s30S[1], 0)    != 1
bool tr1Up   = s1m     == 1  and nz(s1m[1], 0)     != 1
bool tr5Up   = s5m     == 1  and nz(s5m[1], 0)     != 1
bool tr15Up  = s15m    == 1  and nz(s15m[1], 0)    != 1
bool tr60Up  = s60m    == 1  and nz(s60m[1], 0)    != 1
bool tr15sDn = stChart == -1 and nz(stChart[1], 0) != -1
bool tr30sDn = s30S    == -1 and nz(s30S[1], 0)    != -1
bool tr1Dn   = s1m     == -1 and nz(s1m[1], 0)     != -1
bool tr5Dn   = s5m     == -1 and nz(s5m[1], 0)     != -1
bool tr15Dn  = s15m    == -1 and nz(s15m[1], 0)    != -1
bool tr60Dn  = s60m    == -1 and nz(s60m[1], 0)    != -1

var int   cnDir   = 0    // 追跡中の方向（1=ロング狙い＝背景赤）
var int   cnStage = 0
var float cnSL    = na
var int   cnPrevBg = na

if mainEval and mode == M_CNTR
    // 背景足の色が変わったら記録を空にする。ロード直後は最初に観測した確定状態を起点。
    if na(cnPrevBg) or cnPrevBg != cnBgState
        cnDir   := 0
        cnStage := 0
        cnSL    := na
        cnPrevBg := cnBgState
        if cnBgState == -1 and allowLong
            cnDir := 1
        else if cnBgState == 1 and allowShort
            cnDir := -1

    if cnDir == 1 and cnBgState != -1
        cnDir   := 0
        cnStage := 0
    if cnDir == -1 and cnBgState != 1
        cnDir   := 0
        cnStage := 0

    // 段階を順に進める。同一確定時刻に複数段階を進めてよい。
    if cnDir == 1
        if cnStage == 0 and tr15sUp
            cnStage := 1
        if cnStage == 1 and tr30sUp
            cnStage := 2
        if cnStage == 2 and tr1Up
            cnStage := 3
        if cnStage == 3 and tr5Up
            cnStage := 4
            if cnNeed == 4
                cnSL := sup5
        if cnStage == 4 and cnNeed >= 5 and tr15Up
            cnStage := 5
            if cnNeed == 5
                cnSL := sup15
        if cnStage == 5 and cnNeed >= 6 and tr60Up
            cnStage := 6
            cnSL := sup60
    else if cnDir == -1
        if cnStage == 0 and tr15sDn
            cnStage := 1
        if cnStage == 1 and tr30sDn
            cnStage := 2
        if cnStage == 2 and tr1Dn
            cnStage := 3
        if cnStage == 3 and tr5Dn
            cnStage := 4
            if cnNeed == 4
                cnSL := res5
        if cnStage == 4 and cnNeed >= 5 and tr15Dn
            cnStage := 5
            if cnNeed == 5
                cnSL := res15
        if cnStage == 5 and cnNeed >= 6 and tr60Dn
            cnStage := 6
            cnSL := res60

    // 目標足到達で 1 回だけエントリー
    if cnStage >= cnNeed and canEnter and not na(cnSL) and reqDir == 0
        if cnDir == 1
            reqDir := 1
            reqSL  := cnSL - slOffset
            reqTag := "逆行L 目標" + str.tostring(cnTgtMin) + "m 支持=" + str.tostring(cnSL, format.mintick)
        else if cnDir == -1
            reqDir := -1
            reqSL  := cnSL + slOffset
            reqTag := "逆行S 目標" + str.tostring(cnTgtMin) + "m 抵抗=" + str.tostring(cnSL, format.mintick)
        cnStage := 0
        cnSL    := na

// ============================================================================
// 07｜レンジ判定
//   ON の足が 1 本以上あり、選択したすべての足で最後の確定 bandState が
//   「na でなく、かつ 0」であることを確認できたときだけレンジ有効とする。
//   0 は 3 本の位置関係であって、価格が横ばいという意味ではない。
//
//   `st != 0` だけで判定してはいけない。Pine v6 では na を含む比較は必ず false を
//   返す（bool は na を持たない）。つまり st が na のとき `st != 0` は false になり、
//   旧実装の `if rgUse and st != 0` は成立せず、その足は「0 だった」ものとして
//   素通りしてしまう。同じ理由で `st == 0` も na のとき false になるため、
//   比較だけでは na と 0 を区別できない。na は na() で明示的に検出して無効にする。
//   上位足のウォームアップ中・データ欠損・銘柄変更直後は実際に na が返る。
//
//     ・rgNa*   … na() で「確認できていない足」を明示的に検出する。
//     ・rgFlat* … nz(st*, 99) で na を 0 以外の番兵 99 へ写してから比較する。
//                 v6 では `st == 0` でも na は false になるが、
//                 「na は 0 と一致しない」ことを式の上でも明示しておく。
//
//   v6 では bool が na にならないので、rgAllFlat も、それを反転した
//   `not rgAllFlat`（§08 の反発待機の破棄）も、必ず true / false として評価される。
// ============================================================================
// 選択している足のうち、確定 bandState が na のものがあるか
bool rgNa5   = rgUse5   and na(st5)
bool rgNa15  = rgUse15  and na(st15)
bool rgNa60  = rgUse60  and na(st60)
bool rgNa240 = rgUse240 and na(st240)
bool rgAnyNa = rgNa5 or rgNa15 or rgNa60 or rgNa240

// 選択している足が「0 であること」を個別に確認する（na は 99 へ写して不一致にする）
bool rgFlat5   = not rgUse5   or nz(st5,   99) == 0
bool rgFlat15  = not rgUse15  or nz(st15,  99) == 0
bool rgFlat60  = not rgUse60  or nz(st60,  99) == 0
bool rgFlat240 = not rgUse240 or nz(st240, 99) == 0

// ON の足が 1 本以上 かつ na なし かつ 全部 0 のときだけ有効
bool rgAllFlat = rgSelCount > 0 and not rgAnyNa and rgFlat5 and rgFlat15 and rgFlat60 and rgFlat240

// 候補足ごとに「開始時点の適格性＋その時点の直近 N 本の窓＋候補ID」を凍結する。
// ブレイク判定用と 5分接近判定用で別インスタンス（var は呼び出し箇所ごとに独立）。
[bkWinHi, bkWinLo, bkWinS, bkWinE, bkCandElig, bkCandFrzT] = f_freezeWindow(bkFormT, rgRawHi, rgRawLo, rgRawS, rgRawE, rgAllFlat)
[rbWinHi, rbWinLo, rbWinS, rbWinE, rbCandElig, rbCandFrzT] = f_freezeWindow(tf5,     rgRawHi, rgRawLo, rgRawS, rgRawE, rgAllFlat)

// 凍結した窓の妥当性。ブレイク判定用と 5分接近判定用は別の窓を使う。
bool bkBoundOk = not na(bkWinHi) and not na(bkWinLo) and bkWinHi > bkWinLo
bool rbBoundOk = not na(rbWinHi) and not na(rbWinLo) and rbWinHi > rbWinLo

// 候補ID（候補足の開始時刻）の一致確認。
// 凍結した記録と、いま終値を見ている確定足が同じ 1 本であることを保証する。
bool bkCandIdOk = not na(bkCandFrzT) and not na(bkCandOpenT) and bkCandFrzT == bkCandOpenT
bool rbCandIdOk = not na(rbCandFrzT) and not na(t5)          and rbCandFrzT == t5

// 時刻の前後関係の検証
//   f_freezeWindow() が「候補足の開始時刻までに確定した算出足の直近 N 本」を
//   選んでいるので、窓の終了時刻は必ず候補足の開始時刻以下になる。
//   ここはその不変条件が崩れていないことの確認（時間足の組み合わせに関わらず有効）。
//   同じ 5分 どうしなら bkWinE はブレイク足の 1 本前の足が閉じた時刻、
//   すなわち bkCandOpenT（ブレイク足の開始時刻）と一致する。
bool rgBeforeBreak = not na(bkWinE) and not na(bkCandOpenT) and bkWinE <= bkCandOpenT
bool rgBefore5m    = not na(rbWinE) and not na(t5)          and rbWinE <= t5

// ============================================================================
// 08｜レンジ端反発
//   ① 15秒/30秒/1分が個別に一度ずつ確定青（同時でなくてよい）
//   ② 30秒が青以外へ　③ 1分足の支え成立　… ②③は順不同
//   ④ 30秒が再び確定青 → エントリー
//
//   前後関係を時刻で強制する。
//   セットアップ成立時点で「既に確定していた」30秒足・1分足は ① に数えない。
//   ② と ③ は ①完了時点で既に確定していた足を使わない。
//   ④ は ② を確認した 30秒足より後に確定した 30秒足だけを使う。
//   基準時刻はすべて各時間足の確定足の開始時刻（t30S / t1 / チャート足の time）。
// ============================================================================
var int   rbDir      = 0
var float rbBound    = na
var bool  rbS15      = false
var bool  rbS30      = false
var bool  rbS1       = false
var bool  rbOff30    = false
var bool  rbSupport  = false
var float rbSupLine  = na

// 前後関係の検証用に記録する時刻
var int   rbSetT     = na   // セットアップ成立を判定したチャート足の開始時刻
var int   rbBase15   = na   // ① 15秒：この時刻以降に確定した足を数える
var int   rbBase30   = na   // ① 30秒：成立時点で確定済みだった 30秒足の開始時刻
var int   rbBase1    = na   // ① 1分  ：成立時点で確定済みだった 1分足の開始時刻
var int   rbT15      = na   // ① を満たした 15秒足の開始時刻
var int   rbT30      = na   // ① を満たした 30秒足の開始時刻
var int   rbT1       = na   // ① を満たした 1分足の開始時刻
var int   rbStg1T    = na   // ①完了を判定したチャート足の開始時刻
var int   rbStg1B30  = na   // ①完了時点で確定済みだった 30秒足の開始時刻
var int   rbStg1B1   = na   // ①完了時点で確定済みだった 1分足の開始時刻
var int   rbOffT     = na   // ② 消灯を確認した 30秒足の開始時刻
var int   rbSupT     = na   // ③ 支え成立を確認した 1分足の開始時刻
var int   rbReT      = na   // ④ 再点灯を確認した 30秒足の開始時刻
var float rbSetC5    = na   // 成立を判定した 5分足の確定終値
var int   rbSetT5    = na   // その 5分足の開始時刻

// 発注でセットアップを破棄するので、直近に成立した 1 件を Debug 用に保存しておく
var int   rbLogSetT  = na
var int   rbLogT15   = na
var int   rbLogT30   = na
var int   rbLogT1    = na
var int   rbLogStg1  = na
var int   rbLogOffT  = na
var int   rbLogSupT  = na
var int   rbLogReT   = na
var float rbLogBound = na
var float rbLogSup   = na
var float rbLogC5    = na
var int   rbLogDir   = 0

if mainEval and mode == M_RBND
    // レンジ判定足が 1 つでも点灯したら待機を破棄。
    // 選択足のどれかが na（確認できない）になった場合も rgAllFlat は false になるので、
    // 同じ経路で待機を破棄する。
    if rbDir != 0 and not rgAllFlat
        rbDir     := 0
        rbBound   := na
        rbS15     := false
        rbS30     := false
        rbS1      := false
        rbOff30   := false
        rbSupport := false
        rbSupLine := na

    // --- セットアップ開始 ---
    //   下限：5分足の確定終値が 下限以上・下限＋rbNear 以下（「下限±rbNear」ではない）
    //   上限：5分足の確定終値が 上限以下・上限−rbNear 以上
    //   窓は「その 5分確定足の開始時刻までに確定した算出足の直近 N 本」を
    //   f_freezeWindow() で凍結したもの（rbWin*）。5分足自身は含まない。
    if rbDir == 0 and rgAllFlat and rbBoundOk and rbCandIdOk and rgBefore5m and not na(c5)
        int   newDir   = 0
        float newBound = na
        if allowLong and c5 >= rbWinLo and c5 <= rbWinLo + rbNear
            newDir   := 1
            newBound := rbWinLo
        else if allowShort and c5 <= rbWinHi and c5 >= rbWinHi - rbNear
            newDir   := -1
            newBound := rbWinHi
        // 成立したら、成立時刻と「成立時点で既に確定していた各足」の基準時刻を固定する。
        //   15秒 … 成立を判定したこの足自身が成立時刻以降に確定する足なので含める（>=）。
        //   30秒 / 1分 … 成立時点で確定済みだった足は ① に数えない（>）。
        if newDir != 0
            rbDir     := newDir
            rbBound   := newBound
            rbSetT    := time
            rbSetC5   := c5
            rbSetT5   := t5
            rbBase15  := time
            rbBase30  := t30S
            rbBase1   := t1
            rbS15     := false
            rbS30     := false
            rbS1      := false
            rbT15     := na
            rbT30     := na
            rbT1      := na
            rbStg1T   := na
            rbStg1B30 := na
            rbStg1B1  := na
            rbOff30   := false
            rbOffT    := na
            rbSupport := false
            rbSupLine := na
            rbSupT    := na
            rbReT     := na

    if rbDir != 0
        int want = rbDir
        // ① 各足が一度ずつ確定青（ショートは赤）。同時でなくてよい。
        //   セットアップ成立時点で既に確定していた 30秒足・1分足は数えない。
        if not rbS15 and not na(rbBase15) and time >= rbBase15 and stChart == want
            rbS15 := true
            rbT15 := time
        if not rbS30 and not na(rbBase30) and not na(t30S) and t30S > rbBase30 and st30S == want
            rbS30 := true
            rbT30 := t30S
        if not rbS1 and not na(rbBase1) and not na(t1) and t1 > rbBase1 and st1 == want
            rbS1 := true
            rbT1 := t1
        bool stage1 = rbS15 and rbS30 and rbS1

        // ①完了時刻と、その時点で確定済みだった 30秒足・1分足を固定する。
        // ② と ③ は、この基準より後に確定した足だけを使う。
        if stage1 and na(rbStg1T)
            rbStg1T   := time
            rbStg1B30 := t30S
            rbStg1B1  := t1

        // ② 30秒がいったん青以外（①完了後に確定した 30秒足のみ）
        if stage1 and not rbOff30 and not na(rbStg1B30) and not na(t30S) and t30S > rbStg1B30 and st30S != want
            rbOff30 := true
            rbOffT  := t30S

        // ③ 1分足の支え／抵抗の成立
        //   安値・高値・終値・支持線・State はすべて同じ 1 本の確定 1分足から取る。
        //   lo1 / h1 / c1 / l1_1 / l2_1 / sb_1 / st1 は同一 request.security の
        //   同一タプルなので、必ず同じ確定足の値になる。
        //   15秒足の high / low をここへ混ぜない。
        //   ①完了後に確定した 1分足のみを使う。
        if stage1 and not rbSupport and not na(rbStg1B1) and not na(t1) and t1 > rbStg1B1
            if rbDir == 1 and st1 == 1 and not na(sup1) and not na(lo1) and not na(c1)
                if lo1 <= sup1 and c1 > sup1
                    rbSupport := true
                    rbSupLine := sup1
                    rbSupT    := t1
            else if rbDir == -1 and st1 == -1 and not na(res1) and not na(h1) and not na(c1)
                if h1 >= res1 and c1 < res1
                    rbSupport := true
                    rbSupLine := res1
                    rbSupT    := t1

        // ④ 30秒の再点灯でエントリー
        //   ② を確認した 30秒足より後に確定した 30秒足だけを使う。
        //   ③ は評価時点で成立済みであることを求めるので、④ は必ず ②③ の後になる。
        bool tr30   = rbDir == 1 ? tr30sUp : tr30sDn
        bool newer30 = rbOff30 and not na(rbOffT) and not na(t30S) and t30S > rbOffT
        bool re30 = newer30 and st30S == want and tr30
        if stage1 and rbOff30 and rbSupport and re30 and canEnter and reqDir == 0
            if st1 == want and not na(rbSupLine)
                rbReT := t30S
                // 破棄する前に Debug 用のスナップショットを取る
                rbLogSetT  := rbSetT
                rbLogT15   := rbT15
                rbLogT30   := rbT30
                rbLogT1    := rbT1
                rbLogStg1  := rbStg1T
                rbLogOffT  := rbOffT
                rbLogSupT  := rbSupT
                rbLogReT   := rbReT
                rbLogBound := rbBound
                rbLogSup   := rbSupLine
                rbLogC5    := rbSetC5
                rbLogDir   := rbDir
                if rbDir == 1
                    reqDir := 1
                    reqSL  := rbSupLine - slOffset
                    reqTag := "反発L 下限=" + str.tostring(rbBound, format.mintick) + " 支持=" + str.tostring(rbSupLine, format.mintick)
                else
                    reqDir := -1
                    reqSL  := rbSupLine + slOffset
                    reqTag := "反発S 上限=" + str.tostring(rbBound, format.mintick) + " 抵抗=" + str.tostring(rbSupLine, format.mintick)
                // 同じ境界への接近から再発注しない
                rbDir     := 0
                rbBound   := na
                rbS15     := false
                rbS30     := false
                rbS1      := false
                rbOff30   := false
                rbSupport := false
                rbSupLine := na

// ============================================================================
// 09｜レンジ端ブレイク
// ============================================================================
bool bkBullOk = f_aggOk(bkAgg == "OR",  1, bkUse5, st5, bkUse15, st15, bkUse60, st60, bkUse240, st240)
bool bkBearOk = f_aggOk(bkAgg == "OR", -1, bkUse5, st5, bkUse15, st15, bkUse60, st60, bkUse240, st240)

var int   bkDir      = 0
var float bkBound    = na

// 実際に比較した内容の記録（Debug 用）。候補足が変わるたびに上書きする。
var int   bkUsedCandT  = na
var int   bkUsedCandE  = na
var float bkUsedClose  = na
var float bkUsedHigh   = na
var float bkUsedLow    = na
var int   bkUsedWinS   = na
var int   bkUsedWinE   = na
var bool  bkUsedElig   = false
var int   bkUsedResult = 0

if mainEval and mode == M_BRK
    // ブレイク成立の判定は、ひとつの候補足 k に対して
    //   ・k の開始時点のレンジ適格性       … bkCandElig
    //   ・k の開始時刻までに確定した直近 N 本の境界 … bkWinHi / bkWinLo
    //   ・k の確定終値                      … bkClose
    // を、同じ候補ID（k の開始時刻）で対にして使う。
    //   bkCandIdOk が、凍結した記録と bkClose が同じ 1 本であることを保証する。
    //
    // var の候補境界（旧 bkCandHigh / bkCandLow）は使わない。
    // 直前足 k-1 が上限を更新し、k の確定時にレンジ判定足が点灯した場合、
    // 旧実装では k-1 の更新を取り込む前の古い上限が残り、
    // 例）古い上限 4305 / k-1 の高値 4310 / k の終値 4308 で
    //     本来不成立のはずのブレイクが成立してしまっていた。
    // k に対応づいた境界（この例では 4310）と比べれば 4308 は不成立になる。
    //
    // 窓の範囲：ブレイク足自身は入らず、その 1 本前は入る。
    // ともに 5分・N=60 なら、ブレイク足 k の終値と 足 k-60〜k-1 の高値/安値の比較。
    bool bkCandOk = bkCandElig and bkBoundOk and bkCandIdOk and rgBeforeBreak and not na(bkClose)

    // 実際に比較した値を記録する（成立・不成立にかかわらず残す）
    if bkDir == 0 and bkCandOk
        bkUsedCandT  := bkCandOpenT
        bkUsedCandE  := bkCandCloseT
        bkUsedClose  := bkClose
        bkUsedHigh   := bkWinHi
        bkUsedLow    := bkWinLo
        bkUsedWinS   := bkWinS
        bkUsedWinE   := bkWinE
        bkUsedElig   := bkCandElig
        bkUsedResult := 0

    if bkDir == 0 and bkCandOk
        if allowLong and bkClose > bkWinHi
            bkDir   := 1
            bkBound := bkWinHi
            bkUsedResult := 1
        else if allowShort and bkClose < bkWinLo
            bkDir   := -1
            bkBound := bkWinLo
            bkUsedResult := -1

    // ブレイク維持のチェック（終値が境界側へ戻ったら破棄）
    if bkDir == 1 and not na(bkClose) and bkClose <= bkBound
        bkDir   := 0
        bkBound := na
    if bkDir == -1 and not na(bkClose) and bkClose >= bkBound
        bkDir   := 0
        bkBound := na

    // 上位足の確定点灯とブレイク維持が同時に成立した最初の15秒足確定で発注
    if bkDir != 0 and canEnter and reqDir == 0
        if bkDir == 1 and bkBullOk
            float bp = na
            int   bt = 0
            if bkUse5 and st5 == 1 and not na(sup5)
                bp := sup5
                bt := 5
            if bkUse15 and st15 == 1 and not na(sup15) and (na(bp) or math.abs(close - sup15) < math.abs(close - bp))
                bp := sup15
                bt := 15
            if bkUse60 and st60 == 1 and not na(sup60) and (na(bp) or math.abs(close - sup60) < math.abs(close - bp))
                bp := sup60
                bt := 60
            if bkUse240 and st240 == 1 and not na(sup240) and (na(bp) or math.abs(close - sup240) < math.abs(close - bp))
                bp := sup240
                bt := 240
            if not na(bp)
                reqDir := 1
                reqSL  := bp - slOffset
                reqTag := "上限BreakL 上限=" + str.tostring(bkBound, format.mintick) + " " + str.tostring(bt) + "m 支持=" + str.tostring(bp, format.mintick)
                bkDir   := 0
                bkBound := na
        else if bkDir == -1 and bkBearOk
            float sp = na
            int   stf = 0
            if bkUse5 and st5 == -1 and not na(res5)
                sp := res5
                stf := 5
            if bkUse15 and st15 == -1 and not na(res15) and (na(sp) or math.abs(close - res15) < math.abs(close - sp))
                sp := res15
                stf := 15
            if bkUse60 and st60 == -1 and not na(res60) and (na(sp) or math.abs(close - res60) < math.abs(close - sp))
                sp := res60
                stf := 60
            if bkUse240 and st240 == -1 and not na(res240) and (na(sp) or math.abs(close - res240) < math.abs(close - sp))
                sp := res240
                stf := 240
            if not na(sp)
                reqDir := -1
                reqSL  := sp + slOffset
                reqTag := "下限BreakS 下限=" + str.tostring(bkBound, format.mintick) + " " + str.tostring(stf) + "m 抵抗=" + str.tostring(sp, format.mintick)
                bkDir   := 0
                bkBound := na

// ============================================================================
// 10｜発注
//   シグナル確定時に SL の位置・正のリスク幅・na を検査し、不正なら発注しない。
// ============================================================================
var int rejectCount = 0

if reqDir != 0 and canEnter
    bool ok = not na(reqSL) and not na(close)
    if ok
        if reqDir == 1
            ok := reqSL < close and (close - reqSL) > 0
        else
            ok := reqSL > close and (reqSL - close) > 0
    if ok
        pendingEntry := true
        pendingDir   := reqDir
        setupSL      := reqSL
        setupInfo    := reqTag
        lastEntryBar := bar_index
        entryOrderBar := bar_index
        if reqDir == 1
            strategy.entry("E", strategy.long, qty = qtySize, comment = reqTag)
        else
            strategy.entry("E", strategy.short, qty = qtySize, comment = reqTag)
    else
        rejectCount := rejectCount + 1

// ============================================================================
// 11｜約定後の追加実行の処理
//
//   A. エントリー約定後 … 実際の strategy.position_avg_price から SL / TP を設置する。
//   B. 決済約定後       … 再エントリーを防ぎ、セットアップの状態を全部捨てる。
//
//   どちらも建玉の状態から導いており、barstate.isconfirmed には依存しない。
//   どちらのブロックも新規シグナルやセットアップの状態遷移を進めない。
//   同じバーで複数回走っても結果が変わらない（冪等）ように書いてある。
//   リアルタイムでは var が足の頭までロールバックするため、約定時の追加実行と
//   同じ足の確定時の実行で同じブロックがもう一度走ることがあるが、
//   strategy.exit は同じ ID・同じ価格で上書きされるだけで副作用はない。
// ============================================================================
var int abnormalCount = 0
var float lastFillPrice = na
var float lastTp = na

// --- A. エントリー約定 → SL / TP 設置 ---
if pendingEntry and strategy.position_size != 0
    float avg = strategy.position_avg_price
    float sl  = setupSL
    bool abnormal = false
    float tp = na
    if pendingDir == 1
        abnormal := na(avg) or na(sl) or avg <= sl
        tp := avg + rrRatio * (avg - sl)
    else
        abnormal := na(avg) or na(sl) or avg >= sl
        tp := avg - rrRatio * (sl - avg)
    if abnormal
        // 予想外のギャップで約定が SL の反対側になった場合。取り消したふりをせず、
        // 可能な最初の時点で決済し、異常約定として別計上する。
        abnormalCount := abnormalCount + 1
        strategy.close("E", comment = "ABNORMAL FILL")
    else
        strategy.exit("X", from_entry = "E", stop = sl, limit = tp,
             comment_loss = "SL", comment_profit = "TP")
        lastFillPrice := avg
        lastTp := tp
    pendingEntry := false

// --- 成行注文が約定しないまま次の足も過ぎた場合の保険 ---
if pendingEntry and strategy.position_size == 0 and not na(entryOrderBar) and bar_index > entryOrderBar + 1
    pendingEntry := false
    pendingDir   := 0
    setupSL      := na

// --- B. 決済約定 → 再エントリー防止とセットアップの破棄 ---
//   exitedThisBar は strategy.closedtrades の決済 bar_index から導いているので、
//   同じ足でエントリーと決済が起きた場合（N の終値で発注 → N+1 始値で約定 →
//   N+1 の途中で決済）でも true になる。決済約定直後の追加実行でも、
//   N+1 のバー確定時の実行でも同じ値なので、両方で同じリセットが走る。
//   lastEntryBar をこの足へ進めることで、決済と同じ 15秒足での再エントリーを防ぐ。
if exitedThisBar
    pendingEntry := false
    pendingDir   := 0
    setupSL      := na
    lastFillPrice := na
    lastTp        := na
    lastEntryBar  := bar_index
    entryOrderBar := na
    // 巡行
    trDir  := 0
    trLine := na
    trTf   := 0
    // 逆行（新しい点灯イベントを最初から要求する）
    cnStage := 0
    cnSL    := na
    // レンジ反発
    rbDir     := 0
    rbBound   := na
    rbS15     := false
    rbS30     := false
    rbS1      := false
    rbOff30   := false
    rbSupport := false
    rbSupLine := na
    // レンジブレイク
    bkDir   := 0
    bkBound := na

// ============================================================================
// 12｜表示
//   通常表示は軽量にする。マーカーとデバッグ出力は既定 OFF。
// ============================================================================
plotshape(dbgMarker and mode == M_TREND and trDir == 1  and nz(trDir[1], 0) == 0,
     title = "巡行L 待機開始", style = shape.triangleup, location = location.belowbar, color = color.new(#068C8C, 0), size = size.tiny)
plotshape(dbgMarker and mode == M_TREND and trDir == -1 and nz(trDir[1], 0) == 0,
     title = "巡行S 待機開始", style = shape.triangledown, location = location.abovebar, color = color.new(#F54230, 0), size = size.tiny)
plotshape(dbgMarker and reqDir == 1,  title = "シグナル L", style = shape.labelup,   location = location.belowbar, color = color.new(#068C8C, 0), size = size.tiny)
plotshape(dbgMarker and reqDir == -1, title = "シグナル S", style = shape.labeldown, location = location.abovebar, color = color.new(#F54230, 0), size = size.tiny)

// 実行環境・モードのエラー表示
var table infoTbl = table.new(position.top_right, 1, 2, border_width = 1)
if barstate.islast
    if not envOk
        table.cell(infoTbl, 0, 0, guardMsg, text_color = color.white, bgcolor = color.new(color.red, 20), text_size = size.small)
    else
        table.cell(infoTbl, 0, 0, "OK: " + syminfo.ticker + " / " + timeframe.period, text_color = color.white, bgcolor = color.new(color.black, 40), text_size = size.small)
    if not modeOk
        table.cell(infoTbl, 0, 1, modeMsg, text_color = color.white, bgcolor = color.new(color.orange, 20), text_size = size.small)
    else
        table.cell(infoTbl, 0, 1, mode + " / " + dirMode, text_color = color.white, bgcolor = color.new(color.black, 40), text_size = size.small)

// ============================================================================
// 13｜デバッグ出力（データウィンドウのみ）
//   元コードと同じ確定足で LINE1 / LINE2 / STB / bandState を並べて照合できるようにする。
// ============================================================================
plot(dbgMode ? l1c15 : na, "DBG 15S LINE1", display = display.data_window)
plot(dbgMode ? l2c15 : na, "DBG 15S LINE2", display = display.data_window)
plot(dbgMode ? sbc15 : na, "DBG 15S STB",   display = display.data_window)
plot(dbgMode ? stChart * 1.0 : na, "DBG 15S state", display = display.data_window)

plot(dbgMode ? st30S * 1.0 : na, "DBG 30S state", display = display.data_window)
plot(dbgMode ? st1   * 1.0 : na, "DBG 1m state",  display = display.data_window)
plot(dbgMode ? st5   * 1.0 : na, "DBG 5m state",  display = display.data_window)
plot(dbgMode ? st15  * 1.0 : na, "DBG 15m state", display = display.data_window)
plot(dbgMode ? st60  * 1.0 : na, "DBG 60m state", display = display.data_window)
plot(dbgMode ? st240 * 1.0 : na, "DBG 240m state", display = display.data_window)

plot(dbgMode ? l1_5 : na, "DBG 5m LINE1", display = display.data_window)
plot(dbgMode ? l2_5 : na, "DBG 5m LINE2", display = display.data_window)
plot(dbgMode ? sb_5 : na, "DBG 5m STB",   display = display.data_window)
plot(dbgMode ? sup5 : na, "DBG 5m 支持(3本max)", display = display.data_window)
plot(dbgMode ? res5 : na, "DBG 5m 抵抗(3本min)", display = display.data_window)

plot(dbgMode ? bkWinHi : na, "DBG BK窓 上限", display = display.data_window)
plot(dbgMode ? bkWinLo : na, "DBG BK窓 下限", display = display.data_window)
plot(dbgMode ? bkWinS * 1.0 : na, "DBG BK窓 開始時刻", display = display.data_window)
plot(dbgMode ? bkWinE * 1.0 : na, "DBG BK窓 終了時刻", display = display.data_window)
plot(dbgMode ? bkClose : na, "DBG ブレイク判定足 終値", display = display.data_window)
plot(dbgMode ? bkCandOpenT  * 1.0 : na, "DBG ブレイク判定足 開始時刻", display = display.data_window)
plot(dbgMode ? bkCandCloseT * 1.0 : na, "DBG ブレイク判定足 終了時刻", display = display.data_window)
plot(dbgMode ? rbWinHi : na, "DBG 反発窓 上限", display = display.data_window)
plot(dbgMode ? rbWinLo : na, "DBG 反発窓 下限", display = display.data_window)
plot(dbgMode ? rbWinS * 1.0 : na, "DBG 反発窓 開始時刻", display = display.data_window)
plot(dbgMode ? rbWinE * 1.0 : na, "DBG 反発窓 終了時刻", display = display.data_window)
plot(dbgMode ? t5 * 1.0 : na,      "DBG 5分 確定足 開始時刻",     display = display.data_window)
plot(dbgMode ? t1 * 1.0 : na,      "DBG 1分 確定足 開始時刻",     display = display.data_window)
plot(dbgMode ? lo1 : na,           "DBG 1分 確定足 安値",         display = display.data_window)
plot(dbgMode ? h1 : na,            "DBG 1分 確定足 高値",         display = display.data_window)
plot(dbgMode ? c1 : na,            "DBG 1分 確定足 終値",         display = display.data_window)
plot(dbgMode ? sup1 : na,          "DBG 1分 支持(3本max)",        display = display.data_window)
plot(dbgMode ? res1 : na,          "DBG 1分 抵抗(3本min)",        display = display.data_window)
plot(dbgMode ? (rgBeforeBreak ? 1.0 : 0.0) : na, "DBG 上下限窓 < ブレイク足", display = display.data_window)
plot(dbgMode ? (rgBefore5m ? 1.0 : 0.0) : na,    "DBG 上下限窓 < 5分足",     display = display.data_window)
plot(dbgMode ? (mainEval ? 1.0 : 0.0) : na,      "DBG mainEval",             display = display.data_window)
plot(dbgMode ? (exitedThisBar ? 1.0 : 0.0) : na, "DBG 決済が起きた足",       display = display.data_window)
plot(dbgMode ? (enteredThisBar ? 1.0 : 0.0) : na,"DBG 約定した足",           display = display.data_window)
plot(dbgMode ? lastExitBar * 1.0 : na,           "DBG 最終決済 bar_index",   display = display.data_window)
plot(dbgMode ? ctN * 1.0 : na,                   "DBG 決済済み取引数",       display = display.data_window)

plot(dbgMode ? trDir * 1.0 : na,  "DBG 巡行 待機方向", display = display.data_window)
plot(dbgMode ? trLine : na,       "DBG 巡行 記録線",   display = display.data_window)
plot(dbgMode ? trTf * 1.0 : na,   "DBG 巡行 記録TF(分)", display = display.data_window)
plot(dbgMode ? cnDir * 1.0 : na,  "DBG 逆行 方向",     display = display.data_window)
plot(dbgMode ? cnStage * 1.0 : na,"DBG 逆行 段階",     display = display.data_window)
plot(dbgMode ? rbDir * 1.0 : na,  "DBG 反発 方向",     display = display.data_window)
plot(dbgMode ? rbBound : na,      "DBG 反発 境界",     display = display.data_window)
plot(dbgMode ? rbSupLine : na,    "DBG 反発 支持/抵抗", display = display.data_window)
plot(dbgMode ? bkDir * 1.0 : na,  "DBG Break 方向",    display = display.data_window)
plot(dbgMode ? bkBound : na,      "DBG Break 境界",    display = display.data_window)

plot(dbgMode ? setupSL : na,        "DBG 記録SL",     display = display.data_window)
plot(dbgMode ? lastFillPrice : na,  "DBG 約定価格",   display = display.data_window)
plot(dbgMode ? lastTp : na,         "DBG TP",         display = display.data_window)
plot(dbgMode ? abnormalCount * 1.0 : na, "DBG 異常約定件数", display = display.data_window)

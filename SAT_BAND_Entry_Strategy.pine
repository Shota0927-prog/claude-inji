// 実際に比較した境界（Data Window 側にも出す）
plot(dbgMode ? bkUsedHigh  : na, "DBG BK 比較した上限", display = display.data_window)
plot(dbgMode ? bkUsedLow   : na, "DBG BK 比較した下限", display = display.data_window)
plot(dbgMode ? bkUsedClose : na, "DBG BK 比較した終値", display = display.data_window)
plot(dbgMode ? (bkUsedElig ? 1.0 : 0.0) : na, "DBG BK 候補開始時 適格", display = display.data_window)

// ============================================================================
// 14｜Debug テーブル
//   plot 数（1 スクリプト 64 本）の上限に触れないよう、時刻つきの記録はここへ出す。
//   反発は「セットアップ成立 → ①3足 → ①完了 → ②③ → ④」の各確定足時刻、
//   ブレイクは「実際に比較した候補足・窓・上限／下限・終値」を表示する。
// ============================================================================
f_tstr(int t) => na(t) or t <= 0 ? "-" : str.format_time(t, "yyyy-MM-dd HH:mm:ss", syminfo.timezone)
f_pstr(float v) => na(v) ? "-" : str.tostring(v, format.mintick)
f_bstr(bool b) => b ? "true" : "false"

var table dbgTbl = table.new(position.top_right, 3, 23, border_width = 1)

f_row(int r, string a, string b, string c, color bg) =>
    table.cell(dbgTbl, 0, r, a, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg, text_color = color.white)
    table.cell(dbgTbl, 1, r, b, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg, text_color = color.white)
    table.cell(dbgTbl, 2, r, c, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg, text_color = color.white)

if dbgTable and barstate.islast
    color hd = color.new(#1E2A38, 0)
    color bd = color.new(#000000, 30)
    f_row(0,  "反発（レンジ端反発）",      "現在",                  "直近シグナル",            hd)
    f_row(1,  "セットアップ成立",          f_tstr(rbSetT),          f_tstr(rbLogSetT),         bd)
    f_row(2,  "判定5分足 開始 / 候補適格", f_tstr(rbSetT5),         f_bstr(rbCandElig),        bd)
    f_row(3,  "判定した5分足 終値",        f_pstr(rbSetC5),         f_pstr(rbLogC5),           bd)
    f_row(4,  "境界（下限/上限）",         f_pstr(rbBound),         f_pstr(rbLogBound),        bd)
    f_row(5,  "① 除外基準 30秒/1分",      f_tstr(rbBase30),        f_tstr(rbBase1),           bd)
    f_row(6,  "① 15秒 確定足",            f_tstr(rbT15),           f_tstr(rbLogT15),          bd)
    f_row(7,  "① 30秒 確定足",            f_tstr(rbT30),           f_tstr(rbLogT30),          bd)
    f_row(8,  "① 1分 確定足",             f_tstr(rbT1),            f_tstr(rbLogT1),           bd)
    f_row(9,  "① 完了",                   f_tstr(rbStg1T),         f_tstr(rbLogStg1),         bd)
    f_row(10, "②③ 除外基準 30秒/1分",    f_tstr(rbStg1B30),       f_tstr(rbStg1B1),          bd)
    f_row(11, "② 30秒消灯 確定足",        f_tstr(rbOffT),          f_tstr(rbLogOffT),         bd)
    f_row(12, "③ 1分支持 確定足",         f_tstr(rbSupT),          f_tstr(rbLogSupT),         bd)
    f_row(13, "③ 支持/抵抗 価格",         f_pstr(rbSupLine),       f_pstr(rbLogSup),          bd)
    f_row(14, "④ 30秒再点灯 確定足",      f_tstr(rbReT),           f_tstr(rbLogReT),          bd)
    f_row(15, "ブレイク（実際に比較した値）", "",                    "",                        hd)
    f_row(16, "候補足 開始 / 終了",        f_tstr(bkUsedCandT),     f_tstr(bkUsedCandE),       bd)
    f_row(17, "窓 開始 / 終了",            f_tstr(bkUsedWinS),      f_tstr(bkUsedWinE),        bd)
    f_row(18, "比較した上限 / 下限",       f_pstr(bkUsedHigh),      f_pstr(bkUsedLow),         bd)
    f_row(19, "候補足 終値",               f_pstr(bkUsedClose),     "",                        bd)
    f_row(20, "候補開始時 適格 / 判定",    f_bstr(bkUsedElig),      str.tostring(bkUsedResult), bd)
    f_row(21, "現在の窓 上限 / 下限",      f_pstr(bkWinHi),         f_pstr(bkWinLo),           bd)
    f_row(22, "レンジ有効 / na あり",      f_bstr(rgAllFlat),       f_bstr(rgAnyNa),           bd)

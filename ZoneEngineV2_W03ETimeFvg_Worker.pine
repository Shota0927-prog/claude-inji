                    outLastConsumedDFvgFormationCloseTime := srcClose
        if adoptedTf
            bool  isNew      = e == 0 ? feedFvg1hBullNew    : e == 1 ? feedFvg1hBearNew    : e == 2 ? feedFvg4hBullNew    : e == 3 ? feedFvg4hBearNew    : e == 4 ? feedFvgDBullNew    : feedFvgDBearNew
            float bottom     = e == 0 ? feedFvg1hBullBottom : e == 1 ? feedFvg1hBearBottom : e == 2 ? feedFvg4hBullBottom : e == 3 ? feedFvg4hBearBottom : e == 4 ? feedFvgDBullBottom : feedFvgDBearBottom
            float top        = e == 0 ? feedFvg1hBullTop    : e == 1 ? feedFvg1hBearTop    : e == 2 ? feedFvg4hBullTop    : e == 3 ? feedFvg4hBearTop    : e == 4 ? feedFvgDBullTop    : feedFvgDBearTop
            int   direction  = isBull ? FVG_BULLISH : FVG_BEARISH
            bool  usable     = isNew and not na(bottom) and not na(top) and not na(srcOpen) and not na(srcClose) and mintickOk
            int   bottomTick = int(na)
            int   topTick    = int(na)
            if usable
                bottomTick := int(math.round(bottom / feedMintick))
                topTick    := int(math.round(top    / feedMintick))
                usable     := bottomTick <= topTick
            if usable
                int originKey = originKeyComputeRaw(CAT_FVG, FVG_NONE, tfCode, int(na), srcOpen, direction)
                [rootSlot, pendingRow, lookupViolation] = originLookupUniqueRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootDirections, rootPointTicks, rootSlotLiveFlags, journalOps, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalPointPrices, journalDirections, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCountNow, originKey, CAT_FVG, FVG_NONE, tfCode, int(na), srcOpen, srcClose, direction, feedMintick)
                if lookupViolation
                    journalInvariantViolationNow := true
                if journalInvariantViolationNow
                    stopped := true
                else if rootSlot == SLOT_INVALID and pendingRow == SLOT_INVALID
                    int  mTick   = int(math.round(cfgClusterMaxWidth / feedMintick))
                    bool isBroad = topTick - bottomTick > mTick
                    int  newRow  = journalAppendRaw(journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, journalCountNow, JOP_NEW_ROOT, JGROUP_E2, SLOT_INVALID, ID_NONE, CAT_FVG, FVG_NONE, tfCode, originKey, srcOpen, srcClose, srcClose, float(na), bottom, top, ROOT_ACTIVE, ROOT_ACTIVE, true, isBroad, direction, 0, 0, ID_NONE, int(na))
                    journalCountNow := newRow + 1
        e += 1
    [true, outLastConsumed1hFvgFormationCloseTime, outLastConsumed4hFvgFormationCloseTime, outLastConsumedDFvgFormationCloseTime, journalCountNow, journalInvariantViolationNow]


//@version=6
// ============================================================
// ZoneEngineV2_W03ETimeFvg_Worker - W03 E-stage TimeHL + FVG formation worker
//
// Runs the Main E-stage TimeHL (B23) and then FVG formation (B24) on the bar's
// journal, passed in by reference: rows are appended after the rows the earlier
// D / E stages already wrote. Every helper is the Main function of the same name
// with the Main Engine / Cfg / Feed fields passed in as parameters; the journal
// length and the violation flag travel as values and come back in the result.
// Only journal rows are written. No import, no type, no persistent storage, no
// request, no drawing.
// ============================================================
library("ZoneEngineV2_W03ETimeFvg_Worker", overlay = false)

// ---- constants : exact copies of the Main declarations ----
const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int ROOT_ACTIVE         = 1
const int ROOT_RETIRED        = 5
const int FVG_NONE     = 0
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_D   = 1440
const int    FP_MOD           = 2147483647
const int    FP_SEED_A        = 16777619
const int    FP_MULT_A        = 1000003
const int    FP_NA_KEY        = -1
const int JGROUP_E2 = 2
const int JGROUP_E3 = 3
const int JGROUP_E4 = 4
const int JOP_NEW_ROOT       = 2
const int JOP_TIMEHL_LABEL   = 5
const int JOP_ROOT_RETIRE    = 7
const int SUB_TIMEHL_HIGH  = 1
const int SUB_TIMEHL_LOW   = 2
const int TIMEHL_LABEL_CUR_SESSION  = 1
const int TIMEHL_LABEL_LAST_SESSION = 2
const int TIMEHL_LABEL_TODAY        = 4
const int TIMEHL_LABEL_PREV_DAY     = 8
const int TIMEHL_LABEL_CUR_WEEK     = 16
const int TIMEHL_LABEL_PREV_WEEK    = 32
const int TIMEHL_SESSION_NONE   = 0
const int TIMEHL_SESSION_ASIA   = 1
const int TIMEHL_SESSION_EUROPE = 2
const int TIMEHL_SESSION_NY     = 3

// Main fpMixInt (lines 498-501)
fpMixInt(int acc, int mult, int value) =>
    int t  = value % FP_MOD
    int tp = t < 0 ? t + FP_MOD : t
    (acc * mult + tp) % FP_MOD

// Main fpIntKey (lines 503-504)
fpIntKey(int v) =>
    na(v) ? FP_NA_KEY : v

// Main journalAppendRaw (lines 2748-2801)
journalAppendRaw(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, int journalCountNow, int op, int group, int targetRootSlot, int expectedRootId, int category, int subtype, int tfCode, int originKey, int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom, float nativeTop, int oldState, int newState, bool fvgFresh, bool isBroad, int direction, int oldMask, int newMask, int pairKey, int slopeDir) =>
    int row = journalCountNow
    if row < array.size(journalOps)
        array.set(journalOps,             row, op)
        array.set(journalGroups,          row, group)
        array.set(journalTargetRootSlots, row, targetRootSlot)
        array.set(journalExpectedRootIds, row, expectedRootId)
        array.set(journalCategories,      row, category)
        array.set(journalSubtypes,        row, subtype)
        array.set(journalTfCodes,         row, tfCode)
        array.set(journalOriginKeys,      row, originKey)
        array.set(journalOriginTimes,     row, originTime)
        array.set(journalOriginEndTimes,  row, originEndTime)
        array.set(journalConfirmedTimes,  row, confirmedTime)
        array.set(journalPointPrices,     row, pointPrice)
        array.set(journalNativeBottoms,   row, nativeBottom)
        array.set(journalNativeTops,      row, nativeTop)
        array.set(journalOldStates,       row, oldState)
        array.set(journalNewStates,       row, newState)
        array.set(journalFvgFreshFlags,   row, fvgFresh)
        array.set(journalIsBroadFlags,    row, isBroad)
        array.set(journalDirections,      row, direction)
        array.set(journalOldMasks,        row, oldMask)
        array.set(journalNewMasks,        row, newMask)
        array.set(journalPairKeys,        row, pairKey)
        array.set(journalSlopeDirs,       row, slopeDir)
    else
        array.push(journalOps,             op)
        array.push(journalGroups,          group)
        array.push(journalTargetRootSlots, targetRootSlot)
        array.push(journalExpectedRootIds, expectedRootId)
        array.push(journalCategories,      category)
        array.push(journalSubtypes,        subtype)
        array.push(journalTfCodes,         tfCode)
        array.push(journalOriginKeys,      originKey)
        array.push(journalOriginTimes,     originTime)
        array.push(journalOriginEndTimes,  originEndTime)
        array.push(journalConfirmedTimes,  confirmedTime)
        array.push(journalPointPrices,     pointPrice)
        array.push(journalNativeBottoms,   nativeBottom)
        array.push(journalNativeTops,      nativeTop)
        array.push(journalOldStates,       oldState)
        array.push(journalNewStates,       newState)
        array.push(journalFvgFreshFlags,   fvgFresh)
        array.push(journalIsBroadFlags,    isBroad)
        array.push(journalDirections,      direction)
        array.push(journalOldMasks,        oldMask)
        array.push(journalNewMasks,        newMask)
        array.push(journalPairKeys,        pairKey)
        array.push(journalSlopeDirs,       slopeDir)
    row

// Main originKeyComputeRaw (lines 2823-2848)
originKeyComputeRaw(int category, int subtype, int tfCode, int pointTick, int originTime, int direction) =>
    int h = FP_SEED_A
    h := fpMixInt(h, FP_MULT_A, fpIntKey(category))
    if category == CAT_MA
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
    else if category == CAT_SWING
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_ACCUM
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_TIME_HL
        h := fpMixInt(h, FP_MULT_A, fpIntKey(subtype))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else if category == CAT_FVG
        h := fpMixInt(h, FP_MULT_A, fpIntKey(tfCode))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(direction))
        h := fpMixInt(h, FP_MULT_A, fpIntKey(originTime))
    else if category == CAT_PSYCH
        h := fpMixInt(h, FP_MULT_A, fpIntKey(pointTick))
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    h == 0 ? 1 : h

// Main originTupleEqualRaw (lines 2949-2981)
originTupleEqualRaw(int incomingCategory, int incomingSubtype, int incomingTfCode, int incomingPointTick, int incomingOriginTime, int incomingOriginEndTime, int incomingDirection, int storedCategory, int storedSubtype, int storedTfCode, int storedPointTick, int storedOriginTime, int storedOriginEndTime, int storedDirection) =>
    bool equal = false
    if incomingCategory == CAT_MA
        equal := storedCategory == CAT_MA and incomingTfCode == TF_1M and storedTfCode == TF_1M and not na(incomingSubtype) and incomingSubtype == storedSubtype
    else if incomingCategory == CAT_SWING
        bool tfOk   = (incomingTfCode == TF_5M or incomingTfCode == TF_15M or incomingTfCode == TF_1H) and (storedTfCode == TF_5M or storedTfCode == TF_15M or storedTfCode == TF_1H)
        bool baseOk = storedCategory == CAT_SWING and tfOk and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
        bool timeOk = not na(incomingOriginTime) and not na(incomingOriginEndTime) and not na(storedOriginTime) and not na(storedOriginEndTime)
        if baseOk and timeOk
            if incomingTfCode == storedTfCode
                equal := incomingOriginTime == storedOriginTime and incomingOriginEndTime == storedOriginEndTime
            else if storedTfCode < incomingTfCode
                equal := storedOriginTime >= incomingOriginTime and storedOriginTime < incomingOriginEndTime
            else
                equal := incomingOriginTime >= storedOriginTime and incomingOriginTime < storedOriginEndTime
    else if incomingCategory == CAT_ACCUM
        equal := storedCategory == CAT_ACCUM and not na(incomingTfCode) and incomingTfCode == storedTfCode and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_TIME_HL
        equal := storedCategory == CAT_TIME_HL and incomingTfCode == TF_5M and storedTfCode == TF_5M and not na(incomingSubtype) and incomingSubtype == storedSubtype and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else if incomingCategory == CAT_FVG
        equal := storedCategory == CAT_FVG and not na(incomingTfCode) and incomingTfCode == storedTfCode and (incomingDirection == FVG_BULLISH or incomingDirection == FVG_BEARISH) and incomingDirection == storedDirection and not na(incomingOriginTime) and not na(storedOriginTime) and incomingOriginTime == storedOriginTime
    else if incomingCategory == CAT_PSYCH
        equal := storedCategory == CAT_PSYCH and not na(incomingPointTick) and not na(storedPointTick) and incomingPointTick == storedPointTick
    else
        runtime.error("W03_ORIGIN_CATEGORY")
    equal

// Main originLookupUniqueRaw (lines 2988-3038)
originLookupUniqueRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootDirections, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> journalOps, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<float> journalPointPrices, array<int> journalDirections, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int journalCountNow, int originKey, int category, int subtype, int tfCode, int pointTick, int originTime, int originEndTime, int direction, float mintick) =>
    int  matchCount        = 0
    int  matchedRootSlot   = SLOT_INVALID
    int  matchedPendingRow = SLOT_INVALID
    bool violation         = false
    if originKey != ID_NONE
        if map.contains(originKeyBucketHeadRootSlots, originKey)
            int slot      = map.get(originKeyBucketHeadRootSlots, originKey)
            int stepLimit = array.size(rootIds)
            int steps     = 0
            while slot != SLOT_INVALID and not violation and steps < stepLimit
                bool nodeOk = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootOriginKeys) and slot < array.size(rootOriginBucketNextRootSlots) and slot < array.size(rootOriginBucketExpectedRootIds)
                if nodeOk
                    nodeOk := array.get(rootSlotLiveFlags, slot)
                if nodeOk
                    int bucketRootId = array.get(rootOriginBucketExpectedRootIds, slot)
                    nodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(rootIds, slot) and array.get(rootOriginKeys, slot) == originKey
                if not nodeOk
                    violation := true
                else
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(rootCategories, slot), array.get(rootSubtypes, slot), array.get(rootTfCodes, slot), array.get(rootPointTicks, slot), array.get(rootOriginTimes, slot), array.get(rootOriginEndTimes, slot), array.get(rootDirections, slot))
                        matchCount += 1
                        if matchCount == 1
                            matchedRootSlot := slot
                        else
                            violation := true
                    slot  := array.get(rootOriginBucketNextRootSlots, slot)
                    steps += 1
            if not violation and slot != SLOT_INVALID
                violation := true
        if not violation
            int journalCount = journalCountNow
            int row = 0
            while row < journalCount and not violation
                if array.get(journalOps, row) == JOP_NEW_ROOT and array.get(journalOriginKeys, row) == originKey
                    float pendingPrice = array.get(journalPointPrices, row)
                    int   pendingTick  = na(pendingPrice) ? int(na) : int(math.round(pendingPrice / mintick))
                    if originTupleEqualRaw(category, subtype, tfCode, pointTick, originTime, originEndTime, direction, array.get(journalCategories, row), array.get(journalSubtypes, row), array.get(journalTfCodes, row), pendingTick, array.get(journalOriginTimes, row), array.get(journalOriginEndTimes, row), array.get(journalDirections, row))
                        matchCount += 1
                        if matchCount == 1
                            matchedPendingRow := row
                        else
                            violation := true
                row += 1
    [violation ? SLOT_INVALID : matchedRootSlot, violation ? SLOT_INVALID : matchedPendingRow, violation]

// Main journalAppliedBeforeRaw (lines 6075-6078)
journalAppliedBeforeRaw(array<int> journalGroups, int rowA, int rowB) =>
    int groupA = array.get(journalGroups, rowA)
    int groupB = array.get(journalGroups, rowB)
    groupA < groupB or (groupA == groupB and rowA < rowB)

// Main predictedNewRootSlotRaw (lines 6084-6095)
predictedNewRootSlotRaw(array<int> rootIds, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, int journalCountNow, int newRow) =>
    int slot = SLOT_INVALID
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCountNow
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        int freeSize = array.size(rootFreeSlots)
        slot := rank < freeSize ? array.get(rootFreeSlots, freeSize - 1 - rank) : array.size(rootIds) + (rank - freeSize)
    slot

// Main predictedNewRootIdRaw (lines 6101-6111)
predictedNewRootIdRaw(array<int> journalOps, array<int> journalGroups, int nextRootId, int journalCountNow, int newRow) =>
    int rootId = ID_NONE
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCountNow
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        rootId := nextRootId + rank
    rootId

// Main sourceAdoptableRaw (lines 7884-7885)
sourceAdoptableRaw(int sourceOpenTime, int sourceCloseTime, int lastConsumedCloseTime, int baseCloseTime) =>
    not na(sourceOpenTime) and not na(sourceCloseTime) and not na(baseCloseTime) and baseCloseTime >= sourceCloseTime and (na(lastConsumedCloseTime) or sourceCloseTime > lastConsumedCloseTime)

// Main timeHlPeriodKeysRaw (lines 8168-8208)
timeHlPeriodKeysRaw(string cfgZoneTimezone, int cfgAsiaStartHour, int cfgAsiaEndHour, int cfgEuropeStartHour, int cfgEuropeEndHour, int cfgNyStartHour, int cfgNyEndHour, int cfgDayBoundaryHour, int cfgWeekBoundaryDow, int cfgWeekBoundaryHour, int baseOpenTime) =>
    int sessionKind      = TIMEHL_SESSION_NONE
    int sessionStartTime = int(na)
    int dayStartTime     = int(na)
    int weekStartTime    = int(na)
    if not na(baseOpenTime)
        int localYear  = year(baseOpenTime, cfgZoneTimezone)
        int localMonth = month(baseOpenTime, cfgZoneTimezone)
        int localDay   = dayofmonth(baseOpenTime, cfgZoneTimezone)
        int localDow   = dayofweek(baseOpenTime, cfgZoneTimezone)
        int localHour  = hour(baseOpenTime, cfgZoneTimezone)
        if localHour >= cfgAsiaStartHour and localHour < cfgAsiaEndHour
            sessionKind      := TIMEHL_SESSION_ASIA
            sessionStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay, cfgAsiaStartHour, 0, 0)
        else if localHour >= cfgEuropeStartHour and localHour < cfgEuropeEndHour
            sessionKind      := TIMEHL_SESSION_EUROPE
            sessionStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay, cfgEuropeStartHour, 0, 0)
        else if localHour >= cfgNyStartHour or localHour < cfgNyEndHour
            sessionKind := TIMEHL_SESSION_NY
            if localHour >= cfgNyStartHour
                sessionStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay, cfgNyStartHour, 0, 0)
            else
                sessionStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay - 1, cfgNyStartHour, 0, 0)
        int sameDayStart = timestamp(cfgZoneTimezone, localYear, localMonth, localDay, cfgDayBoundaryHour, 0, 0)
        if baseOpenTime >= sameDayStart
            dayStartTime := sameDayStart
        else
            dayStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay - 1, cfgDayBoundaryHour, 0, 0)
        int daysBack      = (localDow - cfgWeekBoundaryDow + 7) % 7
        int weekCandidate = timestamp(cfgZoneTimezone, localYear, localMonth, localDay - daysBack, cfgWeekBoundaryHour, 0, 0)
        if baseOpenTime >= weekCandidate
            weekStartTime := weekCandidate
        else
            weekStartTime := timestamp(cfgZoneTimezone, localYear, localMonth, localDay - daysBack - 7, cfgWeekBoundaryHour, 0, 0)
    [sessionKind, sessionStartTime, dayStartTime, weekStartTime]

// Main timeHlVirtualMaskNowRaw (lines 8243-8266)
timeHlVirtualMaskNowRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<int> rootStates, array<int> rootLabelMasks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalNewMasks, int nextRootId, int journalCountNow, int rootSlot, int expectedRootId, int pendingNewRow) =>
    int  mask = int(na)
    bool ok   = false
    if pendingNewRow == SLOT_INVALID
        if rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootTfCodes) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootLabelMasks)
            if array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId and array.get(rootCategories, rootSlot) == CAT_TIME_HL and array.get(rootTfCodes, rootSlot) == TF_5M and array.get(rootStates, rootSlot) == ROOT_ACTIVE
                mask := array.get(rootLabelMasks, rootSlot)
                ok   := true
    else
        if pendingNewRow >= 0 and pendingNewRow < journalCountNow
            if array.get(journalOps, pendingNewRow) == JOP_NEW_ROOT and array.get(journalGroups, pendingNewRow) == JGROUP_E2 and array.get(journalCategories, pendingNewRow) == CAT_TIME_HL
                if predictedNewRootSlotRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCountNow, pendingNewRow) == rootSlot and predictedNewRootIdRaw(journalOps, journalGroups, nextRootId, journalCountNow, pendingNewRow) == expectedRootId
                    mask := array.get(journalNewMasks, pendingNewRow)
                    ok   := true
    if ok
        int row = 0
        while row < journalCountNow
            if array.get(journalOps, row) == JOP_TIMEHL_LABEL and array.get(journalTargetRootSlots, row) == rootSlot and array.get(journalExpectedRootIds, row) == expectedRootId
                mask := array.get(journalNewMasks, row)
            row += 1
    mask

// Main w03StageETimeHlRaw (lines 8269-8686)
w03StageETimeHlRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootStates, array<int> rootDirections, array<int> rootLabelMasks, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextRootId, int curSessionHighRootSlot, int curSessionHighExpectedRootId, int curSessionLowRootSlot, int curSessionLowExpectedRootId, int lastSessionHighRootSlot, int lastSessionHighExpectedRootId, int lastSessionLowRootSlot, int lastSessionLowExpectedRootId, int todayHighRootSlot, int todayHighExpectedRootId, int todayLowRootSlot, int todayLowExpectedRootId, int prevDayHighRootSlot, int prevDayHighExpectedRootId, int prevDayLowRootSlot, int prevDayLowExpectedRootId, int curWeekHighRootSlot, int curWeekHighExpectedRootId, int curWeekLowRootSlot, int curWeekLowExpectedRootId, int prevWeekHighRootSlot, int prevWeekHighExpectedRootId, int prevWeekLowRootSlot, int prevWeekLowExpectedRootId, string cfgZoneTimezone, int cfgAsiaStartHour, int cfgAsiaEndHour, int cfgEuropeStartHour, int cfgEuropeEndHour, int cfgNyStartHour, int cfgNyEndHour, int cfgDayBoundaryHour, int cfgWeekBoundaryDow, int cfgWeekBoundaryHour, bool cfgUseTimeHl, float feedBaseHigh, float feedBaseLow, int feedBaseOpenTime, int feedBaseCloseTime, float feedMintick, int nextTimeHlSessionKind, int nextTimeHlSessionStartTime, int nextTimeHlDayStartTime, int nextTimeHlWeekStartTime, int journalCountIn, bool journalInvariantViolationIn) =>
    int  journalCountNow              = journalCountIn
    bool journalInvariantViolationNow = journalInvariantViolationIn
    int  outTimeHlSessionKind      = nextTimeHlSessionKind
    int  outTimeHlSessionStartTime = nextTimeHlSessionStartTime
    int  outTimeHlDayStartTime     = nextTimeHlDayStartTime
    int  outTimeHlWeekStartTime    = nextTimeHlWeekStartTime
    bool usable  = cfgUseTimeHl and not na(feedBaseOpenTime) and not na(feedBaseCloseTime) and not na(feedBaseHigh) and not na(feedBaseLow) and not na(feedMintick) and feedMintick > 0
    bool stopped = not usable
    if usable
        [currentSessionKind, currentSessionStartTime, currentDayStartTime, currentWeekStartTime] = timeHlPeriodKeysRaw(cfgZoneTimezone, cfgAsiaStartHour, cfgAsiaEndHour, cfgEuropeStartHour, cfgEuropeEndHour, cfgNyStartHour, cfgNyEndHour, cfgDayBoundaryHour, cfgWeekBoundaryDow, cfgWeekBoundaryHour, feedBaseOpenTime)
        array<int> planRootSlots       = array.new_int(0)
        array<int> planExpectedRootIds = array.new_int(0)
        array<int> planPendingNewRows  = array.new_int(0)
        array<int> planInitialMasks    = array.new_int(0)
        array<int> planFinalMasks      = array.new_int(0)
        array<int> planSubtypes        = array.new_int(0)
        int curSessionHighSlot = curSessionHighRootSlot
        int curSessionHighId   = curSessionHighExpectedRootId
        int curSessionLowSlot = curSessionLowRootSlot
        int curSessionLowId   = curSessionLowExpectedRootId
        int lastSessionHighSlot = lastSessionHighRootSlot
        int lastSessionHighId   = lastSessionHighExpectedRootId
        int lastSessionLowSlot = lastSessionLowRootSlot
        int lastSessionLowId   = lastSessionLowExpectedRootId
        int todayHighSlot = todayHighRootSlot
        int todayHighId   = todayHighExpectedRootId
        int todayLowSlot = todayLowRootSlot
        int todayLowId   = todayLowExpectedRootId
        int prevDayHighSlot = prevDayHighRootSlot
        int prevDayHighId   = prevDayHighExpectedRootId
        int prevDayLowSlot = prevDayLowRootSlot
        int prevDayLowId   = prevDayLowExpectedRootId
        int curWeekHighSlot = curWeekHighRootSlot
        int curWeekHighId   = curWeekHighExpectedRootId
        int curWeekLowSlot = curWeekLowRootSlot
        int curWeekLowId   = curWeekLowExpectedRootId
        int prevWeekHighSlot = prevWeekHighRootSlot
        int prevWeekHighId   = prevWeekHighExpectedRootId
        int prevWeekLowSlot = prevWeekLowRootSlot
        int prevWeekLowId   = prevWeekLowExpectedRootId
        int k = 0
        while not stopped and k < 12
            int refSlot = k == 0 ? curSessionHighSlot : k == 1 ? curSessionLowSlot : k == 2 ? lastSessionHighSlot : k == 3 ? lastSessionLowSlot : k == 4 ? todayHighSlot : k == 5 ? todayLowSlot : k == 6 ? prevDayHighSlot : k == 7 ? prevDayLowSlot : k == 8 ? curWeekHighSlot : k == 9 ? curWeekLowSlot : k == 10 ? prevWeekHighSlot : prevWeekLowSlot
            int refId   = k == 0 ? curSessionHighId : k == 1 ? curSessionLowId : k == 2 ? lastSessionHighId : k == 3 ? lastSessionLowId : k == 4 ? todayHighId : k == 5 ? todayLowId : k == 6 ? prevDayHighId : k == 7 ? prevDayLowId : k == 8 ? curWeekHighId : k == 9 ? curWeekLowId : k == 10 ? prevWeekHighId : prevWeekLowId
            if (refSlot == SLOT_INVALID) != (refId == ID_NONE)
                journalInvariantViolationNow := true
                stopped := true
            k += 1
        bool weekChanged    = na(nextTimeHlWeekStartTime) or nextTimeHlWeekStartTime != currentWeekStartTime

// ---- 2.8 SideHistory (Support / Resistance で別インスタンス) --------------
export type SideHistory
    int    sideTouchCount   = 0
    bool   weakByTouch      = false
    bool   weakByDepth      = false
    float  maxDepthPct      = 0.0
    bool   sideFresh        = true
    int    phase            = 0     // PH_WAITING
    int    grade            = 3     // GR_UNAVAILABLE
    int    currentTouchNo   = 0
    int    upcomingTouchNo  = 1
    int    armedFromSeq     = 0

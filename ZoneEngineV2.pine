// ---- Subtype (起源タグ。現在の役割ではない) --------------------------------
int SUB_NONE        = 0
int SUB_EMA1        = 1
int SUB_EMA2        = 2
int SUB_SWING_H     = 3
int SUB_SWING_L     = 4
int SUB_ACC_UPPER   = 5
int SUB_ACC_LOWER   = 6
int SUB_HL_HIGH     = 7
int SUB_HL_LOW      = 8
int SUB_FVG         = 9
int SUB_PSYCH_MAJOR = 10
int SUB_PSYCH_STD   = 11

// ---- 時間区切り高安の期間種別 ---------------------------------------------
int PER_NONE    = 0
int PER_SESSION = 1
int PER_DAY     = 2
int PER_WEEK    = 3

// ---- セッションコード (Feed から受ける) -----------------------------------
int SESS_NONE   = 0
int SESS_ASIA   = 1
int SESS_EUROPE = 2
int SESS_NY     = 3

// ---- 内部固定 Root ID (MA だけは価格更新型の固定 ID) ----------------------
int RID_EMA1 = 1
int RID_EMA2 = 2
int RID_FIXED_MAX = 2

// ---- Accum の Candidate 連続本数を遡る上限 (Pine のループ実行時間対策) ----
int ACCUM_RUN_SCAN_MAX = 400

// ---- 内部ループの安全上限 --------------------------------------------------
int CAND_SCAN_MAX = 400

// ---- 2 のべき乗 (ビット演算子が無いため) ----------------------------------
f_pow2(int b) =>
    b <= 0 ? 1 : b == 1 ? 2 : b == 2 ? 4 : b == 3 ? 8 : b == 4 ? 16 :
     b == 5 ? 32 : b == 6 ? 64 : b == 7 ? 128 : b == 8 ? 256 : b == 9 ? 512 :
     b == 10 ? 1024 : b == 11 ? 2048 : b == 12 ? 4096 : b == 13 ? 8192 : 16384

f_maskHas(int mask, int bit) =>
    int p = f_pow2(bit)
    math.floor(nz(mask) / p) % 2 == 1

f_maskAdd(int mask, int bit) =>
    f_maskHas(mask, bit) ? nz(mask) : nz(mask) + f_pow2(bit)

f_maskCount(int mask, int bits) =>
    int c = 0
    if bits > 0
        for i = 0 to bits - 1
            if f_maskHas(mask, i)
                c := c + 1
    c

// ---- 最小ティック正規化つき比較 -------------------------------------------
//  仕様 18 章「価格比較前に最小ティックへ正規化する」。
//  同値・境界値 (Touch / Armed / Break / Reset / M / dense 幅) の判定は
//  すべてこの 5 関数を通す。生の float 比較を境界へ使わない。
f_mt(float mintick) =>
    na(mintick) or mintick <= 0 ? 0.01 : mintick

f_tickOf(float price, float mintick) =>
    math.round(price / f_mt(mintick))

f_geT(float a, float b, float mintick) =>
    na(a) or na(b) ? false : f_tickOf(a, mintick) >= f_tickOf(b, mintick)

f_leT(float a, float b, float mintick) =>
    na(a) or na(b) ? false : f_tickOf(a, mintick) <= f_tickOf(b, mintick)

f_gtT(float a, float b, float mintick) =>
    na(a) or na(b) ? false : f_tickOf(a, mintick) > f_tickOf(b, mintick)

f_ltT(float a, float b, float mintick) =>
    na(a) or na(b) ? false : f_tickOf(a, mintick) < f_tickOf(b, mintick)

f_eqT(float a, float b, float mintick) =>
    na(a) or na(b) ? false : f_tickOf(a, mintick) == f_tickOf(b, mintick)

// ---- 中央値 (加重しない。仕様 5.6) ----------------------------------------
//  ★ Phase3C : 渡された配列をそのまま sort して中央値を返す (コピーを作らない)。
//    scratch 配列にだけ使うこと。値の選び方は Version 3 の f_median() と完全に同じ。
f_medianInPlace(array<float> a) =>
    float r = na
    int n = array.size(a)
    if n > 0
        array.sort(a, order.ascending)
        int h = int(math.floor(n / 2))
        if n % 2 == 1
            r := array.get(a, h)
        else
            r := (array.get(a, h - 1) + array.get(a, h)) / 2
    r

f_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

// ---- 2 区間の interval gap (重なれば 0) -----------------------------------
f_intervalGap(float aBot, float aTop, float bBot, float bTop) =>
    float g = 0.0
    if na(aBot) or na(aTop) or na(bBot) or na(bTop)
        g := na
    else if aTop < bBot
        g := bBot - aTop
    else if bTop < aBot
        g := aBot - bTop
    g

// ---- 価格から区間までの距離 (区間内は 0) ---------------------------------
f_distanceToRangeRaw(float price, float bot, float top) =>
    float d = na
    if not na(price) and not na(bot) and not na(top)
        d := price < bot ? bot - price : price > top ? price - top : 0.0
    d

// ---- ソート済み Root ID 配列の two-pointer 比較 ----------------------------
//  rootIds / originRootIds は「意味のある順序」を保つため sort しない。
//  比較専用に作った昇順コピー同士を突き合わせる。重複が無い配列なので
//  結果は array.includes() の入れ子と完全に同じ件数になる。
f_sortedCopy(array<int> src, array<int> dst) =>
    array.clear(dst)
    int n = array.size(src)
    if n > 0
        for i = 0 to n - 1
            array.push(dst, array.get(src, i))
        array.sort(dst, order.ascending)
    array.size(dst)

f_sharedSorted(array<int> a, array<int> b) =>
    int i = 0
    int j = 0
    int cnt = 0
    int na1 = array.size(a)
    int nb1 = array.size(b)
    while i < na1 and j < nb1
        int x = array.get(a, i)
        int y = array.get(b, j)
        if x == y
            cnt := cnt + 1
            i := i + 1
            j := j + 1
        else if x < y
            i := i + 1
        else
            j := j + 1
    cnt

f_containsSorted(array<int> a, int v) =>
    bool found = false
    int lo = 0
    int hi = array.size(a) - 1
    while lo <= hi
        int mid = int(math.floor((lo + hi) / 2))
        int x = array.get(a, mid)
        if x == v
            found := true
            break
        else if x < v
            lo := mid + 1
        else
            hi := mid - 1
    found

// ---- inclusive intersection 判定 ------------------------------------------
f_rangesTouch(float aBot, float aTop, float bBot, float bTop, float mintick) =>
    f_geT(aTop, bBot, mintick) and f_leT(aBot, bTop, mintick)

// ============================================================================
// 02. TYPES
// ----------------------------------------------------------------------------
//  Pine の UDT 既定値は literal しか書けないため、Phase / Grade / Density の
//  既定値は数値で書いている。01 章の定数と同じ値であることをコメントで示す。
//  配列フィールドは Factory で必ず確保する (na 配列へ array.* を呼ばないため)。
// ============================================================================

// ---- 2.1 ZoneCfg -----------------------------------------------------------
export type ZoneCfg
    // -- 論理パラメータ (仕様 18 章 / 指示書 4.1) --
    float  clusterMaxWidth     = 20.0    // M
    float  denseRatio          = 0.50    // dense 幅 = M * denseRatio
    float  touchResetDistance  = 10.0
    int    strongUntilTouch    = 1
    bool   strongUnlimited     = false
    int    weakFromTouch       = 2
    bool   weakFromTouchOff    = false
    float  weakDepthPct        = 50.0
    bool   weakDepthOff        = false
    float  breakBuffer         = 2.0
    float  touchTolerance      = 0.0
    int    emaSlopeLookback    = 60
    int    swingLen5m          = 10
    int    swingLen15m         = 8
    int    swingLen1h          = 6
    // -- カテゴリ ON / OFF --
    bool   useMa               = true
    bool   useSwing            = true
    bool   useAccum            = true
    bool   useTimeHL           = true
    bool   useFvg              = true
    bool   usePsych            = true
    // -- Accum 検出 (仕様 3.3 / 指示書 4.2) --
    int    accumRangeLen       = 10
    int    accumBaseLen        = 20
    int    accumAtrLen         = 14
    int    accumMinUpperCloses = 4
    int    accumMinLowerCloses = 4
    int    accumMaxSameColorRun = 4
    float  accumAtrMult        = 2.5
    float  accumBarRatioMax    = 0.70
    float  accumDriftMax       = 0.30
    // -- 心理価格 --
    float  psychMajorStep      = 100.0
    float  psychStdStep        = 50.0
    // -- 時間設定 (実際の区切り判定は Feed の ID で行う。ここは検証・表示用) --
    string zoneTimezone        = "Asia/Tokyo"
    int    dayResetHour        = 5
    int    asiaStartHour       = 9
    int    europeStartHour     = 14
    int    nyStartHour         = 19
    int    nyEndHour           = 3
    // -- 時間足文字列 (Feed の tfCode と一致するか検証するためだけに保持) --
    string tfMa                = "1"
    string tfSwing1            = "5"
    string tfSwing2            = "15"
    string tfSwing3            = "60"
    string tfAccum1            = "60"
    string tfAccum2            = "240"
    string tfAccum3            = "D"
    string tfFvg1              = "60"
    string tfFvg2              = "240"
    string tfFvg3              = "D"
    string tfBase              = "5"
    // -- 保存上限 (指示書 4.4) --
    int    maxSwingRoots       = 180
    int    maxAccumBoxes       = 60
    int    maxFvgRoots         = 120
    int    maxTimeRoots        = 32
    int    maxZoneCores        = 80
    int    maxEndedGenerations = 30
    int    maxTouchMarksPerCore = 64
    float  dormantDistance     = 500.0
    int    maxZonesDrawn       = 30
    int    maxLabelsDrawn      = 30
    // -- 最小ティック (原則 Feed から受けた syminfo.mintick を使う) --
    float  mintick             = 0.01
    // -- 表示専用 : ZoneView の rootSummary / categorySummary を作るか --
    //    false でも Zone 判定・Grade・Event は一切変わらない (文字列を作らないだけ)。
    bool   buildDisplayStrings = true

// ---- 2.2 Feed 部品 (外部足 helper の戻り値をそのまま入れる箱) -------------
export type SwingIn
    bool   newBar      = false

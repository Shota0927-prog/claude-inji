    int    phOrigin    = na
    int    phOriginEnd = na
    int    phConfirm   = na
    float  pl          = na
    int    plOrigin    = na
    int    plOriginEnd = na
    int    plConfirm   = na

export type AccumIn
    bool   newBox      = false

// ---- 2.3 ZoneFeed ----------------------------------------------------------
//  Base は「確定した 5 分足 1 本」。time (足の開始時刻) と time_close
//  (確定時刻) を必ず分けて渡す。
export type ZoneFeed
    float  baseOpen      = na
    float  baseHigh      = na
    float  baseLow       = na
    float  baseClose     = na
    float  basePrevClose = na
    int    baseOpenTime  = na
    int    baseCloseTime = na
    int    baseSeq       = 0
    bool   baseConfirmed = false
    float  mintick       = na
    // MA (1分足 EMA と確定済み傾き)
    bool   maValid       = false
    float  ema1          = na
    float  ema1Delta     = na
    float  ema2          = na
    float  ema2Delta     = na
    int    maConfirmTime = na
    // 期間 ID (timezone 計算は呼び出し側の責務)
    int    sessionCode   = 0
    int    sessionId     = na
    int    dayId         = na
    int    weekId        = na
    // 外部足 helper の結果
    array<SwingIn> swings
    array<AccumIn> accums
    array<FvgIn>   fvgs

// ---- 2.4 Root --------------------------------------------------------------
export type Root
    int    rootId        = 0
    string originKey     = ""
    int    category      = 0
    int    subtype       = 0
    int    tfCode        = 0
    int    tfMask        = 0      // 同一イベントを検出した時間足の集合
    int    originTime    = na
    int    originEndTime = na
    int    confirmedTime = na
    float  pointPrice    = na
    float  nativeBottom  = na
    float  nativeTop     = na
    bool   isRangeRoot   = false
    bool   isDynamic     = false
    int    state         = 1      // ROOT_ACTIVE
    string pairKey       = ""     // 同じ Accum Box の上下限を識別する
    int    direction     = 0      // FVG のみ Bullish / Bearish
    bool   fvgFresh      = false
    bool   isBroadFvg    = false
    int    labelMask     = 0      // 時間高安のラベル (期間種別 + current/prev)
    int    periodKind    = 0
    bool   isCurrentPeriod = false
    int    lastUpdateSeq = 0
    // Inverse FVG 進行状態
    bool   invMovedAway  = false
    bool   invRetestSeen = false
    int    invalidatedSeq = 0
    int    invMovedAwaySeq = -1
    int    inverseDir    = 0

// ---- 2.5 TouchMark (結合 / 分裂後の履歴割当に使う実接触記録) --------------

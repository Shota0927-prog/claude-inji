    float  boxTop      = na
    float  boxBottom   = na
    int    boxId       = na
    int    candStart   = na
    int    confirmTime = na

export type FvgIn
    bool   newBar      = false
    int    tfCode      = 0
    bool   bullNew     = false
    float  bullTop     = na
    float  bullBottom  = na
    int    bullOrigin  = na
    int    bullConfirm = na
    bool   bearNew     = false
    float  bearTop     = na
    float  bearBottom  = na
    int    bearOrigin  = na
    int    bearConfirm = na
    float  srcHigh     = na
    float  srcLow      = na
    float  srcClose    = na
    int    srcOpenTime = na

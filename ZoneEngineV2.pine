    int    generationId    = 0
    int    side            = 0
    float  rangeBottom     = na
    float  rangeTop        = na
    array<int> rootIds
    int    catMask         = 0
    int    highMask        = 0
    int    cCount          = 0
    int    hCount          = 0
    int    density         = 1     // DEN_NORMAL
    bool   baseStrong      = false
    int    touchStartGrade = 1     // GR_NEUTRAL
    int    currentTouchNo  = 0
    int    approachSide    = 0
    int    startSeq        = 0
    int    startTime       = na
    float  deepestClose    = na
    float  maxDepthPct     = 0.0

// ---- 2.7 BreakSnapshot (Flip / FlipAttempt / Reclaim の価格基準) ----------
export type BreakSnapshot
    bool   valid       = false
    int    coreId      = 0
    int    generationId = 0
    int    oldSide     = 0
    float  rangeBottom = na
    float  rangeTop    = na

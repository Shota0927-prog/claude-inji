// one fixture : returns [failed, field, winnerF, broadF, invalidF]
// Broad fixture = the fixture holds at least one Broad FVG Root (fixture data); invalid fixture = I05 .. I07 (refLane false)
l2cRunFixture(int code) =>
    L2cFx x = l2cBuild(code)
    bool isBroad = false
    for rr in x.roots
        if rr.isBroadFvg
            isBroad := true
    bool isInvalid = not x.refLane
    int  field     = -1
    bool winnerBad = false
    [frP, fcP, okP] = l2cLane(x)
    [frQ, fcQ, okQ] = l2cLane(x)
    if not (okP and okQ and array.size(x.roots) > 0)
        field := L2C_FIELD_INPUT
    else
        array<int> probeInts = array.new_int(0)
        array<int> probeIds  = array.new_int(0)
        [sP, rP] = l2cRunProduction(frP, fcP)
        [sQ, rQ] = l2cRunProbe(frQ, fcQ, probeInts, probeIds)
        [mPQ, fPQ, iPQ] = w06CompareWinnersRaw(fcP, sP, rP, fcQ, sQ, rQ)
        if mPQ > 0
            winnerBad := true
            field     := fPQ
    bool failed = field != -1
    [failed ? 1 : 0, field, winnerBad ? 1 : 0, (isBroad and failed) ? 1 : 0, (isInvalid and failed) ? 1 : 0]

// every fixture once (for loop only); returns the Data Window values
l2cRunAll() =>
    array<int> codes = array.from(201, 202, 203, 204, 206, 207, 208, 209, 210, 213, 214, 301, 302, 303, 304, 305, 306, 307, 308, 401, 402, 403, 404, 405, 406, 601, 602, 603, 604, 605, 606, 607, 608, 701, 702, 703, 704, 705, 801, 802, 803, 804, 805, 806, 901, 902, 1001, 1002, 1003, 1004, 1005, 1006, 1007)
    int failures  = 0
    int executed  = 0
    int firstFail = -1
    int firstFld  = -1
    int winnerF   = 0
    int broadF    = 0
    int invalidF  = 0
    for k = 0 to 53 - 1
        int code = array.get(codes, k)
        [fl, f, wf, bf, vf] = l2cRunFixture(code)
        executed += 1
        winnerF  += wf
        broadF   += bf
        invalidF += vf
        if fl == 1
            failures += 1
            if firstFail < 0
                firstFail := code
                firstFld  := f
    [failures, executed, firstFail, firstFld, winnerF, broadF, invalidF]

var int gFailures  = -1
var int gExecuted  = 0
var int gFirstFail = -1
var int gFirstFld  = -1
var int gWinnerF   = -1
var int gBroadF    = -1
var int gInvalidF  = -1
if barstate.islast and gExecuted == 0
    [a1, a2, a3, a4, a5, a6, a7] = l2cRunAll()
    gFailures  := a1
    gExecuted  := a2
    gFirstFail := a3
    gFirstFld  := a4
    gWinnerF   := a5
    gBroadF    := a6
    gInvalidF  := a7

plot(190204,     "W07 B19 L2C4 Build",                  display = display.data_window)
plot(gFailures,  "W07 B19 L2C4 Failures",               display = display.data_window)
plot(gExecuted,  "W07 B19 L2C4 Fixture Count",          display = display.data_window)
plot(gFirstFail, "W07 B19 L2C4 First Fail Fixture",     display = display.data_window)
plot(gFirstFld,  "W07 B19 L2C4 First Field",            display = display.data_window)
plot(gWinnerF,   "W07 B19 L2C4 Winner Failures",        display = display.data_window)
plot(gBroadF,    "W07 B19 L2C4 Broad Failures",         display = display.data_window)
plot(gInvalidF,  "W07 B19 L2C4 Invalid Input Failures", display = display.data_window)

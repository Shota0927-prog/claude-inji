        l2cRoot(x, 5, REF_CAT_TIMEHL, 0, 5, 5, 1920.90, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        x.refLane := false
        x.mutation := 1
        x.mutSlot := 1
    else if code == 1007
        // I07
        l2cRoot(x, 1, REF_CAT_FVG, 0, 60, 1, na, 1920.00, 1921.00, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 2, REF_CAT_FVG, 0, 240, 2, na, 1920.50, 1921.50, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 3, REF_CAT_FVG, 0, 1440, 3, na, 1920.70, 1921.70, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 4, REF_CAT_SWING, 1, 5, 4, 1920.80, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 5, REF_CAT_TIMEHL, 0, 5, 5, 1920.90, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        x.refLane := false
        x.mutation := 2
        x.mutSlot := 1
    x

// fresh lane : production arrays of the fixture, then (I06 / I07 only) the invalid-input mutation, never normalized
l2cLane(L2cFx x) =>
    [fr, fc, fw, fj, ok] = w06BuildProductionArraysRaw(x.roots, x.originKeys, L2C_MINTICK)
    bool mOk = ok
    if mOk and x.mutation == L2C_MUT_UNSORTED_DUP
        mOk := x.mutSlot >= 0 and x.mutSlot < array.size(fr.rootIdOrderSlots)
        if mOk
            array.reverse(fr.rootIdOrderSlots)
            array.push(fr.rootIdOrderSlots, x.mutSlot)
    else if mOk and x.mutation == L2C_MUT_NEG_ROOT_ID
        mOk := x.mutSlot >= 0 and x.mutSlot < array.size(fr.rootIds)
        if mOk
            array.set(fr.rootIds, x.mutSlot, -array.get(fr.rootIds, x.mutSlot))
    [fr, fc, mOk]


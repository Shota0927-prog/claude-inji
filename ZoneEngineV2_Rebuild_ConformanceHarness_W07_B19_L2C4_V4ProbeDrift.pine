//@version=6
// ============================================================
// ZoneEngineV2_Rebuild_ConformanceHarness_W07_B19_L2C4_V4ProbeDrift.pine
// W07 B19 Lane2C (4) : Probe drift, actual published W05 /4 (Worker /4) vs B19Probe /1 (the /4 copy with the optimized diagnostic additions).
// Build 190204. The 53 L2A fixtures (same fixture values, same canonical virtual Psych, I05 .. I07 invalid inputs
// included and never normalized) run once on the last bar by a for loop. Each fixture gets two fresh lanes from
// w06BuildProductionArraysRaw (the I06 / I07 mutation is applied to each lane separately): the Production lane runs
// W05V4.selectBothSides, the Probe lane runs V4Probe.selectBothSidesProbe (its offer record arrays are passed and
// filled but not compared here; L2B covers the records). The winner results are compared by the full H05 contract
// (w06CompareWinnersRaw); any mismatch is a diagnostic side effect (drift) and fails. Broad fixtures use the same full
// comparison. Verbatim copies (logic unchanged, no rename) from ZoneEngineV2_Rebuild_ConformanceHarness.pine: the
// REF_* constants and the RefRoot type (L17-L87), the H01 fixture foundation (L1625-L2100), the H05 codes
// (L2289-L2317) and the H05 comparator (L2529-L2708). No request.*(), no drawing.
// ============================================================
indicator("ZoneEngineV2 W07 B19 L2C4 V4 Probe Drift", overlay = false)

import sekine3310/ZoneEngineV2_W05Candidate_Worker/4 as W05V4
import sekine3310/ZoneEngineV2_W05Candidate_B19Probe/1 as V4Probe

// ==================== verbatim : REF_* constants + RefRoot (ConformanceHarness L17-L87) ====================
// ---- W04 Reference internal stage codes (not a Production enum, never exported) ----
const int REF_STAGE_A             = 0
const int REF_STAGE_B             = 1
const int REF_STAGE_C             = 2
const int REF_STAGE_BROAD_CONTEXT = 3

// ---- W04 B02 : Reference-local mirrors of Production enum values (never exported) ----
const int REF_CAT_ACCUM           = 2

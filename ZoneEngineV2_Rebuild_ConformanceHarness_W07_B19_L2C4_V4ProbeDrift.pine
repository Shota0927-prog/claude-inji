        l2cRoot(x, 3, REF_CAT_SWING, 1, 5, 3, 1930.00, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 4, REF_CAT_TIMEHL, 0, 5, 4, 1930.10, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
    else if code == 1004
        // I04
        l2cRoot(x, 1, REF_CAT_FVG, 0, 60, 1, na, 1920.00, 1920.90, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 2, REF_CAT_FVG, 0, 240, 2, na, 1920.40, 1921.30, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 3, REF_CAT_FVG, 0, 1440, 3, na, 1920.80, 1921.70, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 4, REF_CAT_FVG, 0, 60, 4, na, 1921.20, 1922.10, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 5, REF_CAT_FVG, 0, 240, 5, na, 1921.60, 1922.50, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 6, REF_CAT_FVG, 0, 1440, 6, na, 1922.00, 1922.90, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 7, REF_CAT_FVG, 0, 60, 7, na, 1920.10, 1921.00, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 8, REF_CAT_FVG, 0, 240, 8, na, 1920.50, 1921.40, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 9, REF_CAT_FVG, 0, 1440, 9, na, 1920.90, 1921.80, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 10, REF_CAT_FVG, 0, 60, 10, na, 1921.30, 1922.20, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 11, REF_CAT_FVG, 0, 240, 11, na, 1921.70, 1922.60, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 12, REF_CAT_FVG, 0, 1440, 12, na, 1922.10, 1923.00, 2, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 13, REF_CAT_SWING, 1, 5, 13, 1920.95, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 14, REF_CAT_TIMEHL, 0, 5, 14, 1921.05, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 15, REF_CAT_SWING, 1, 5, 15, 1922.20, na, na, 0, false, REF_ROOT_ACTIVE, 0, 4, 0, 0)
        l2cRoot(x, 16, REF_CAT_ACCUM, 1, 60, 16, 1922.30, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
    else if code == 1005
        // I05
        l2cRoot(x, 1, REF_CAT_FVG, 0, 60, 1, na, na, na, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 2, REF_CAT_FVG, 0, 60, 2, na, 1920.00, 1921.00, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 3, REF_CAT_SWING, 1, 5, 3, 1920.40, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 4, REF_CAT_TIMEHL, 0, 5, 4, 1920.60, na, na, 0, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        x.refLane := false
        x.expectOk := true
    else if code == 1006
        // I06
        l2cRoot(x, 1, REF_CAT_FVG, 0, 60, 1, na, 1920.00, 1921.00, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)
        l2cRoot(x, 2, REF_CAT_FVG, 0, 240, 2, na, 1920.50, 1921.50, 1, false, REF_ROOT_ACTIVE, 0, 0, 0, 0)

//@version=6
// ============================================================
// ZoneEngineV2_Rebuild_ConformanceHarness.pine
// W04 Conformance Harness for ZoneEngineV2_Rebuild
//
// W04 B01 : Reference data types only (RefRoot / RefCandidate / RefResult).
// The Reference Candidate is a full-scan, unoptimized evaluator for short
// deterministic Fixtures only. It never enters the Production Library.
// No Production import, no request.*(), no drawing, no Zone logic in this Batch.
// ============================================================
indicator("ZoneEngineV2 Rebuild Conformance Harness", overlay = false)

// ---- W04 Reference internal stage codes (not a Production enum, never exported) ----
const int REF_STAGE_A             = 0
const int REF_STAGE_B             = 1
const int REF_STAGE_C             = 2
const int REF_STAGE_BROAD_CONTEXT = 3

// ---- W04 B02 : Reference-local mirrors of Production enum values (never exported) ----
const int REF_CAT_ACCUM           = 2
const int REF_CAT_FVG             = 4
const int REF_CAT_PSYCH           = 5
const int REF_SIDE_SUPPORT        = 1
const int REF_SIDE_RESISTANCE     = -1
const int REF_ROOT_CANDIDATE      = 0
const int REF_ROOT_ACTIVE         = 1
const int REF_ROOT_INVALIDATED    = 2
const int REF_ROOT_INVERSE_WAIT   = 3
const int REF_ROOT_INVERSE_ACTIVE = 4
const int REF_ROOT_RETIRED        = 5
const int REF_FVG_BULLISH         = 1
const int REF_FVG_BEARISH         = 2
const int REF_DEN_HIGH            = 0
const int REF_DEN_NORMAL          = 1
const int REF_DEN_BROAD_CONTEXT   = 2
const int REF_CAT_MA              = 0
const int REF_CAT_SWING           = 1
const int REF_CAT_TIMEHL          = 3
const int REF_SUB_MA_EMA2000      = 1
const int REF_SUB_MA_EMA3000      = 2
const int REF_SWING_TF_MASK_5M    = 1
const int REF_SWING_TF_MASK_15M   = 2
const int REF_SWING_TF_MASK_1H    = 4
const int REF_TIMEHL_LABEL_PREV_DAY  = 8
const int REF_TIMEHL_LABEL_CUR_WEEK  = 16
const int REF_TIMEHL_LABEL_PREV_WEEK = 32
const int REF_TF_4H               = 240
const int REF_TF_D                = 1440
const int REF_FVG_RANGE_NONE          = 0
const int REF_FVG_RANGE_STANDALONE    = 1
const int REF_FVG_RANGE_INSIDE        = 2
const int REF_FVG_RANGE_PROXIMAL      = 3
const int REF_FVG_RANGE_OVERLAP       = 4
const int REF_FVG_RANGE_BROAD_CONTEXT = 5
const int REF_BROAD_LOCAL_C1          = 1
const int REF_BROAD_LOCAL_C2          = 2
const int REF_BROAD_LOCAL_C3          = 3
const int REF_BROAD_LOCAL_C4          = 4

// ---- RefRoot : one Fixture Root record (W04 D25 input contract) ----
// Filled by the Fixture only; never read from the Production Public API.
// A Virtual Psych is never stored as a RefRoot.
type RefRoot
    int   rootId
    int   category
    int   subtype
    int   tfCode
    int   originTime
    int   confirmedTime
    float pointPrice
    int   pointTick
    float nativeBottom
    float nativeTop
    int   nativeBottomTick
    int   nativeTopTick
    int   state
    int   pairKey
    int   direction
    bool  isBroadFvg
    int   labelMask
    int   swingTfMask
    int   maSlopeDir

// ---- RefCandidate : one Reference candidate (Conformance scratch only) ----
// rootIndexes holds indexes into the RefRoot array, never rootIds.
// A Virtual Psych is carried only by psychPresent / psychLevelTick / psychIsMajor:
// it is never in rootIndexes, has no rootId, and never enters minRootId or createdTime.
type RefCandidate
    int        side
    int        stage
    array<int> rootIndexes
    bool       psychPresent
    int        psychLevelTick
    bool       psychIsMajor
    int        effectiveBottomTick
    int        effectiveTopTick
    int        categoryMask
    int        highMask
    int        cCount
    int        hCount
    int        density
    bool       baseStrong
    bool       isBroadContext
    int        createdTime
    int        minRootId
    int        fvgMode

// ---- RefResult : one confirmed Reference winner (numeric result, not a ZoneView) ----
// materializedRootIds never holds a Virtual Psych.
type RefResult
    int        side
    int        stage
    array<int> materializedRootIds
    bool       psychPresent
    int        psychLevelTick
    bool       psychIsMajor
    int        effectiveBottomTick
    int        effectiveTopTick
    int        categoryMask
    int        highMask
    int        cCount
    int        hCount
    int        density
    bool       baseStrong
    bool       isBroadContext
    int        createdTime
    int        minRootId
    float      referencePrice

// ============================================================
// W04 B02 : Side eligibility + canonical Point Root order
// ============================================================

// True when one RefRoot may enter the Candidate input of `side`.
//   non-FVG / non-Psych : ROOT_ACTIVE only, for both Sides (origin subtype never fixes a Side)
//   FVG Bullish         : ACTIVE -> Support only, INVERSE_ACTIVE -> Resistance only
//   FVG Bearish         : ACTIVE -> Resistance only, INVERSE_ACTIVE -> Support only
//   any other FVG state or direction, any Psych RefRoot, any other side : false
// A Virtual Psych is never a RefRoot; it is attached to candidates in a later Batch.
refEligible(RefRoot r, int side) =>
    bool eligible = false
    if side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE
        if r.category != REF_CAT_FVG and r.category != REF_CAT_PSYCH
            eligible := r.state == REF_ROOT_ACTIVE
        else if r.category == REF_CAT_FVG
            if r.direction == REF_FVG_BULLISH
                if r.state == REF_ROOT_ACTIVE
                    eligible := side == REF_SIDE_SUPPORT
                else if r.state == REF_ROOT_INVERSE_ACTIVE
                    eligible := side == REF_SIDE_RESISTANCE
            else if r.direction == REF_FVG_BEARISH
                if r.state == REF_ROOT_ACTIVE
                    eligible := side == REF_SIDE_RESISTANCE
                else if r.state == REF_ROOT_INVERSE_ACTIVE
                    eligible := side == REF_SIDE_SUPPORT
    eligible

// Builds the canonical eligible Point Root order of `side` into outIndexes and
// returns its size. outIndexes holds indexes into `roots`, never rootIds.
// A Root enters only when used[i] is false, refEligible is true, it is neither FVG
// nor Psych and its pointTick is not na. Order (D13): pointTick ASC, then rootId ASC;
// never the roots array order, push order, map order, category, TF or any time.
// `used` is read-only here. A size mismatch between `used` and `roots` returns 0
// with outIndexes empty.
// "contiguous" in the Reference always means a run of consecutive positions in the
// outIndexes returned here; equal-tick Roots are never forced in as one price group.
refBuildPointOrder(array<RefRoot> roots, array<bool> used, int side, array<int> outIndexes) =>
    array.clear(outIndexes)
    if array.size(used) == array.size(roots)
        int n = array.size(roots)
        int i = 0
        while i < n
            RefRoot r = array.get(roots, i)
            if not array.get(used, i) and refEligible(r, side) and r.category != REF_CAT_FVG and r.category != REF_CAT_PSYCH and not na(r.pointTick)
                // insertion position: the first placed Root that sorts after r
                int pos = array.size(outIndexes)
                int k   = 0
                bool found = false
                while k < array.size(outIndexes) and not found
                    RefRoot q = array.get(roots, array.get(outIndexes, k))
                    if r.pointTick < q.pointTick or (r.pointTick == q.pointTick and r.rootId < q.rootId)
                        pos   := k
                        found := true
                    k += 1
                array.insert(outIndexes, pos, i)
            i += 1
    array.size(outIndexes)


// ============================================================
// W04 B03 : Accum pair conflict + Virtual Psych level enumeration
// ============================================================

// True when the candidate Root set holds no two distinct Accum Roots of one
// non-zero pairKey (D14). Returns the verdict for the whole candidate only: no
// Root is dropped, no side of the pair is preferred, no price or distance is read.
// Any index outside roots -> false. Empty or single-Root sets -> true.
// Read-only: roots and rootIndexes are never written.
refAccumPairValid(array<RefRoot> roots, array<int> rootIndexes) =>
    int  n     = array.size(rootIndexes)
    int  nRoot = array.size(roots)
    bool valid = true
    int  i = 0
    while valid and i < n
        int idx = array.get(rootIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        i += 1
    i := 0
    while valid and i < n
        RefRoot a = array.get(roots, array.get(rootIndexes, i))
        if a.category == REF_CAT_ACCUM and a.pairKey != 0
            int j = i + 1
            while valid and j < n
                RefRoot b = array.get(roots, array.get(rootIndexes, j))
                if b.category == REF_CAT_ACCUM and b.pairKey != 0 and a.pairKey == b.pairKey
                    valid := false
                j += 1
        i += 1
    valid

// Lists every 50-dollar Virtual Psych level that can be attached ALONE to a
// non-Psych base candidate [baseBottomTick, baseTopTick] so that the new width
// max(baseTopTick, pTick) - min(baseBottomTick, pTick) <= limitTick.
// limitTick is chosen by the caller (denseTick or mTick); no Stage is judged here.
// Each returned level is one separate attachment variant; levels are never
// combined. isMajor = levelNumber even (a 100-dollar multiple); no 10 / 25-dollar
// level, no Standard at a 100-dollar position, no RefRoot, no rootId.
// Output: outLevelTicks ASC with outIsMajor at the same index, one entry per tick.
// Invalid input (na / non-positive mintick, negative limit, inverted base) -> 0.
refBuildPsychLevels(int baseBottomTick, int baseTopTick, int limitTick, float mintick, array<int> outLevelTicks, array<bool> outIsMajor) =>
    array.clear(outLevelTicks)
    array.clear(outIsMajor)
    if not na(mintick) and mintick > 0 and limitTick >= 0 and baseBottomTick <= baseTopTick
        int   lowerAllowedTick  = baseTopTick - limitTick
        int   upperAllowedTick  = baseBottomTick + limitTick
        float lowerAllowedPrice = lowerAllowedTick * mintick
        float upperAllowedPrice = upperAllowedTick * mintick
        // the extra -1 / +1 keeps a true level from being lost at a float boundary
        int startLevelNumber = math.floor(lowerAllowedPrice / 50.0) - 1
        int endLevelNumber   = math.ceil(upperAllowedPrice / 50.0) + 1
        int levelNumber = startLevelNumber
        while levelNumber <= endLevelNumber
            float psychPrice = levelNumber * 50.0
            int   pTick      = int(math.round(psychPrice / mintick))
            int   newWidth   = math.max(baseTopTick, pTick) - math.min(baseBottomTick, pTick)
            if lowerAllowedTick <= pTick and pTick <= upperAllowedTick and newWidth <= limitTick
                bool isMajor = levelNumber % 2 == 0
                int  last    = array.size(outLevelTicks) - 1
                if last >= 0 and array.get(outLevelTicks, last) == pTick
                    // one entry per tick; Major wins on a shared tick
                    if isMajor
                        array.set(outIsMajor, last, true)
                else
                    array.push(outLevelTicks, pTick)
                    array.push(outIsMajor, isMajor)
            levelNumber += 1
    array.size(outLevelTicks)


// ============================================================
// W04 B04 : Point EffectiveRange + Density + BaseStrong
// ============================================================

// EffectiveRange of a Point-only candidate: [min, max] of the pointTick of every
// materialized Root in rootIndexes, plus psychLevelTick when a single Virtual Psych
// is attached (psychPresent). One point -> width 0. FVG ranges are not handled here.
// Returns [valid, bottomTick, topTick]; invalid -> [false, na, na] when an index is
// out of range, a pointTick is na, an FVG or a RefRoot Psych is present, there is no
// materialized Root (a Psych-only candidate never starts), or the attached Psych
// tick is na. Read-only.
refPointEffectiveRange(array<RefRoot> roots, array<int> rootIndexes, bool psychPresent, int psychLevelTick) =>
    int  n      = array.size(rootIndexes)
    int  nRoot  = array.size(roots)
    bool valid  = n > 0 and not (psychPresent and na(psychLevelTick))
    int  bottom = int(na)
    int  top    = int(na)
    int  i = 0
    while valid and i < n
        int idx = array.get(rootIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        else
            RefRoot r = array.get(roots, idx)
            if na(r.pointTick) or r.category == REF_CAT_FVG or r.category == REF_CAT_PSYCH
                valid := false
            else
                bottom := na(bottom) ? r.pointTick : math.min(bottom, r.pointTick)
                top    := na(top)    ? r.pointTick : math.max(top,    r.pointTick)
        i += 1
    if valid and psychPresent
        bottom := math.min(bottom, psychLevelTick)
        top    := math.max(top,    psychLevelTick)
    if not valid
        bottom := int(na)
        top    := int(na)
    [valid, bottom, top]

// Density of a candidate range. BroadContext wins when the inputs are valid.
// Otherwise widthTick = topTick - bottomTick and the equal sign goes to the narrow side:
//   widthTick <= denseTick             -> REF_DEN_HIGH
//   denseTick < widthTick <= mTick     -> REF_DEN_NORMAL
//   widthTick > mTick                  -> -1 (no normal Zone)
// Invalid inputs (na tick, negative / inverted limits, inverted range) -> -1.
refDensity(int bottomTick, int topTick, int denseTick, int mTick, bool broadContext) =>
    int density = -1
    if not na(bottomTick) and not na(topTick) and denseTick >= 0 and mTick >= 0 and denseTick <= mTick and bottomTick <= topTick
        int widthTick = topTick - bottomTick
        if broadContext
            density := REF_DEN_BROAD_CONTEXT
        else if widthTick <= denseTick
            density := REF_DEN_HIGH
        else if widthTick <= mTick
            density := REF_DEN_NORMAL
    density

// Base Strong from C / H / density only:
//   C == 1                              -> false
//   C == 2 and REF_DEN_HIGH and H >= 1  -> true
//   C >= 3 and REF_DEN_HIGH             -> true
//   anything else (Normal, BroadContext, -1, unknown, invalid C / H) -> false
refBaseStrong(int cCount, int hCount, int density) =>
    bool strong = false
    if cCount > 0 and hCount >= 0 and hCount <= cCount and density == REF_DEN_HIGH
        if cCount == 2
            strong := hCount >= 1
        else if cCount >= 3
            strong := true
    strong


// ============================================================
// W04 B05 : non-FVG Category High + C / H masks
// Category bits match Production: MA 1, Swing 2, Accum 4, TimeHL 8, FVG 16, Psych 32.
// ============================================================

// True when `category` is High inside the candidate, judged only on the Roots of
// rootIndexes that have that category and are refEligible for `side`. At most one
// High per Category. Invalid index or side -> false.
//   MA     : not Stage C, REF_DEN_HIGH, denseTick >= 0, and some EMA2000 x EMA3000 pair
//            with abs(tick gap) <= denseTick and both slopes 1 (Support) / -1 (Resistance)
//   Swing  : one Root with swingTfMask >= 4 (1H) or == 3 (5m + 15m); masks of
//            different Roots are never combined
//   Accum  : a 4H / D Root, or two Roots of different TF and different non-zero pairKey
//   TimeHL : a Root whose labelMask (0..63) is >= 8 (PrevDay / CurWeek / PrevWeek), or
//            two different TimeHL Roots in the candidate (different origins)
//   Psych  : always false
//   FVG    : false here; FVG High is judged in B06
refCategoryHigh(array<RefRoot> roots, array<int> rootIndexes, int category, int side, int stage, int density, int denseTick) =>
    int  n     = array.size(rootIndexes)
    int  nRoot = array.size(roots)
    bool ok    = side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE
    int  i = 0
    while ok and i < n
        int idx = array.get(rootIndexes, i)
        if idx < 0 or idx >= nRoot
            ok := false
        i += 1
    bool isHigh = false
    if ok and category == REF_CAT_MA
        if stage != REF_STAGE_C and density == REF_DEN_HIGH and denseTick >= 0
            int slopeWanted = side == REF_SIDE_SUPPORT ? 1 : -1
            i := 0
            while not isHigh and i < n
                RefRoot a = array.get(roots, array.get(rootIndexes, i))
                if a.category == REF_CAT_MA and a.subtype == REF_SUB_MA_EMA2000 and refEligible(a, side) and not na(a.pointTick) and a.maSlopeDir == slopeWanted
                    int j = 0
                    while not isHigh and j < n
                        RefRoot b = array.get(roots, array.get(rootIndexes, j))
                        if b.category == REF_CAT_MA and b.subtype == REF_SUB_MA_EMA3000 and refEligible(b, side) and not na(b.pointTick) and b.maSlopeDir == slopeWanted
                            if math.abs(a.pointTick - b.pointTick) <= denseTick
                                isHigh := true
                        j += 1
                i += 1
    else if ok and category == REF_CAT_SWING
        i := 0
        while not isHigh and i < n
            RefRoot r = array.get(roots, array.get(rootIndexes, i))
            if r.category == REF_CAT_SWING and refEligible(r, side)
                if r.swingTfMask >= REF_SWING_TF_MASK_1H or r.swingTfMask == REF_SWING_TF_MASK_5M + REF_SWING_TF_MASK_15M
                    isHigh := true
            i += 1
    else if ok and category == REF_CAT_ACCUM
        i := 0
        while not isHigh and i < n
            RefRoot a = array.get(roots, array.get(rootIndexes, i))
            if a.category == REF_CAT_ACCUM and refEligible(a, side)
                if a.tfCode == REF_TF_4H or a.tfCode == REF_TF_D
                    isHigh := true
                else
                    int j = i + 1
                    while not isHigh and j < n
                        RefRoot b = array.get(roots, array.get(rootIndexes, j))
                        if b.category == REF_CAT_ACCUM and refEligible(b, side)
                            if a.tfCode != b.tfCode and a.pairKey != 0 and b.pairKey != 0 and a.pairKey != b.pairKey
                                isHigh := true
                        j += 1
            i += 1
    else if ok and category == REF_CAT_TIMEHL
        int firstIdx = -1
        i := 0
        while not isHigh and i < n
            int     idx = array.get(rootIndexes, i)
            RefRoot r   = array.get(roots, idx)
            if r.category == REF_CAT_TIMEHL and refEligible(r, side)
                if r.labelMask >= REF_TIMEHL_LABEL_PREV_DAY and r.labelMask <= 63
                    isHigh := true
                else if firstIdx == -1
                    firstIdx := idx
                else if idx != firstIdx
                    // a second, different TimeHL Root: a different origin overlapping
                    isHigh := true
            i += 1
    isHigh

// C / H of one candidate, counted naively from its materialized Roots plus an
// attached Virtual Psych (C only, never H). Returns
// [valid, categoryMask, highMask, cCount, hCount]; invalid -> [false, 0, 0, 0, 0]
// when rootIndexes is empty (no Psych-only candidate), an index is out of range or
// repeated, a category is outside 0..4 (no RefRoot Psych), a Root is not refEligible,
// a non-FVG pointTick is na, stage is not A / B / C, or density is not HIGH / NORMAL.
// FVG enters categoryMask / C here; its High bit is added in B06. BaseStrong is
// refBaseStrong's job, never re-implemented here.
refQualityAggregate(array<RefRoot> roots, array<int> rootIndexes, bool psychPresent, int side, int stage, int density, int denseTick) =>
    int  n     = array.size(rootIndexes)
    int  nRoot = array.size(roots)
    bool valid = n > 0 and (stage == REF_STAGE_A or stage == REF_STAGE_B or stage == REF_STAGE_C) and (density == REF_DEN_HIGH or density == REF_DEN_NORMAL)
    bool hasMa     = false
    bool hasSwing  = false
    bool hasAccum  = false
    bool hasTimeHl = false
    bool hasFvg    = false
    int  i = 0
    while valid and i < n
        int idx = array.get(rootIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        else
            int j = 0
            while valid and j < i
                if array.get(rootIndexes, j) == idx
                    valid := false
                j += 1
        if valid
            RefRoot r = array.get(roots, idx)
            if not (r.category >= 0 and r.category <= 4)
                valid := false
            else if not refEligible(r, side)
                valid := false
            else if r.category != REF_CAT_FVG and na(r.pointTick)
                valid := false
            else
                hasMa     := hasMa     or r.category == REF_CAT_MA
                hasSwing  := hasSwing  or r.category == REF_CAT_SWING
                hasAccum  := hasAccum  or r.category == REF_CAT_ACCUM
                hasTimeHl := hasTimeHl or r.category == REF_CAT_TIMEHL
                hasFvg    := hasFvg    or r.category == REF_CAT_FVG
        i += 1
    int categoryMask = 0
    int highMask     = 0
    int cCount       = 0
    int hCount       = 0
    if valid
        categoryMask := (hasMa ? 1 : 0) + (hasSwing ? 2 : 0) + (hasAccum ? 4 : 0) + (hasTimeHl ? 8 : 0) + (hasFvg ? 16 : 0) + (psychPresent ? 32 : 0)
        cCount       := (hasMa ? 1 : 0) + (hasSwing ? 1 : 0) + (hasAccum ? 1 : 0) + (hasTimeHl ? 1 : 0) + (hasFvg ? 1 : 0) + (psychPresent ? 1 : 0)
        bool maHigh     = hasMa     and refCategoryHigh(roots, rootIndexes, REF_CAT_MA,     side, stage, density, denseTick)
        bool swingHigh  = hasSwing  and refCategoryHigh(roots, rootIndexes, REF_CAT_SWING,  side, stage, density, denseTick)
        bool accumHigh  = hasAccum  and refCategoryHigh(roots, rootIndexes, REF_CAT_ACCUM,  side, stage, density, denseTick)
        bool timeHlHigh = hasTimeHl and refCategoryHigh(roots, rootIndexes, REF_CAT_TIMEHL, side, stage, density, denseTick)
        highMask := (maHigh ? 1 : 0) + (swingHigh ? 2 : 0) + (accumHigh ? 4 : 0) + (timeHlHigh ? 8 : 0)
        hCount   := (maHigh ? 1 : 0) + (swingHigh ? 1 : 0) + (accumHigh ? 1 : 0) + (timeHlHigh ? 1 : 0)
    [valid, categoryMask, highMask, cCount, hCount]


// ============================================================
// W04 B06 : FVG EffectiveRange + Broad localization + FVG High
// Proximal edge by Side: Support = nativeTopTick, Resistance = nativeBottomTick.
// The 50% point is never used. No NativeRange is ever written.
// ============================================================

// EffectiveRange of an FVG candidate for one `mode`. Returns
// [valid, bottomTick, topTick]; invalid -> [false, na, na]. FVG A must be a valid,
// eligible FVG with a valid NativeRange.
//   STANDALONE    : non-Broad A alone (no point, no Psych, fvgIndexB == -1) -> NativeRange
//   INSIDE        : >= 1 eligible point Root, all (and any Virtual Psych) inside A's
//                   NativeRange inclusive -> [min, max] of the points; the FVG width is not added
//   PROXIMAL      : >= 1 eligible point Root, all (and any Virtual Psych) strictly outside
//                   the approach-side edge (Support > top, Resistance < bottom) ->
//                   [min, max] of proximal edge + points, valid only when width <= denseTick
//   OVERLAP       : same-direction eligible FVG B (another index), no point, no Psych,
//                   ob = max(bottoms) <= ot = min(tops) (zero width included) -> [ob, ot]
//   BROAD_CONTEXT : Broad A -> NativeRange (when it is generated is decided by the winner loop)
refFvgRange(array<RefRoot> roots, int fvgIndexA, int fvgIndexB, array<int> pointIndexes, bool psychPresent, int psychLevelTick, int side, int mode, int denseTick) =>
    int  nRoot  = array.size(roots)
    int  nPoint = array.size(pointIndexes)
    bool valid  = fvgIndexA >= 0 and fvgIndexA < nRoot
    int  bottom = int(na)
    int  top    = int(na)
    RefRoot a = valid ? array.get(roots, fvgIndexA) : na
    if valid
        valid := a.category == REF_CAT_FVG and refEligible(a, side) and not na(a.nativeBottomTick) and not na(a.nativeTopTick) and a.nativeBottomTick <= a.nativeTopTick
    if valid
        if mode == REF_FVG_RANGE_STANDALONE
            valid := not a.isBroadFvg and nPoint == 0 and not psychPresent and fvgIndexB == -1
            if valid
                bottom := a.nativeBottomTick
                top    := a.nativeTopTick
        else if mode == REF_FVG_RANGE_INSIDE or mode == REF_FVG_RANGE_PROXIMAL
            int proximal = side == REF_SIDE_SUPPORT ? a.nativeTopTick : a.nativeBottomTick
            valid := nPoint > 0 and not (psychPresent and na(psychLevelTick)) and (mode == REF_FVG_RANGE_INSIDE or denseTick >= 0)
            int i = 0
            while valid and i < nPoint
                int idx = array.get(pointIndexes, i)
                if idx < 0 or idx >= nRoot
                    valid := false
                else
                    RefRoot r = array.get(roots, idx)
                    if r.category == REF_CAT_FVG or r.category == REF_CAT_PSYCH or not refEligible(r, side) or na(r.pointTick)
                        valid := false
                    else
                        bool placeOk = mode == REF_FVG_RANGE_INSIDE ? (a.nativeBottomTick <= r.pointTick and r.pointTick <= a.nativeTopTick) : (side == REF_SIDE_SUPPORT ? r.pointTick > a.nativeTopTick : r.pointTick < a.nativeBottomTick)
                        if not placeOk
                            valid := false
                        else
                            bottom := na(bottom) ? r.pointTick : math.min(bottom, r.pointTick)
                            top    := na(top)    ? r.pointTick : math.max(top,    r.pointTick)
                i += 1
            if valid and psychPresent
                bool psychOk = mode == REF_FVG_RANGE_INSIDE ? (a.nativeBottomTick <= psychLevelTick and psychLevelTick <= a.nativeTopTick) : (side == REF_SIDE_SUPPORT ? psychLevelTick > a.nativeTopTick : psychLevelTick < a.nativeBottomTick)
                if psychOk
                    bottom := math.min(bottom, psychLevelTick)
                    top    := math.max(top,    psychLevelTick)
                else
                    valid := false
            if valid and mode == REF_FVG_RANGE_PROXIMAL
                bottom := math.min(bottom, proximal)
                top    := math.max(top,    proximal)
                valid  := top - bottom <= denseTick
        else if mode == REF_FVG_RANGE_OVERLAP
            valid := nPoint == 0 and not psychPresent and fvgIndexB >= 0 and fvgIndexB < nRoot and fvgIndexB != fvgIndexA
            if valid
                RefRoot b = array.get(roots, fvgIndexB)
                valid := b.category == REF_CAT_FVG and refEligible(b, side) and not na(b.nativeBottomTick) and not na(b.nativeTopTick) and b.nativeBottomTick <= b.nativeTopTick and a.direction == b.direction
                if valid
                    int ob = math.max(a.nativeBottomTick, b.nativeBottomTick)
                    int ot = math.min(a.nativeTopTick,    b.nativeTopTick)
                    valid := ob <= ot
                    if valid
                        bottom := ob
                        top    := ot
        else if mode == REF_FVG_RANGE_BROAD_CONTEXT
            valid := a.isBroadFvg
            if valid
                bottom := a.nativeBottomTick
                top    := a.nativeTopTick
        else
            valid := false
    if not valid
        bottom := int(na)
        top    := int(na)
    [valid, bottom, top]

// Judges ONE Broad localization `condition` for the Broad FVG broadIndex and returns
// [valid, bottomTick, topTick] of the localized EffectiveRange; invalid -> [false, na, na].
// The four conditions are never merged into a best one, nothing is cached: the winner
// loop re-evaluates every condition on the current available Root set of each round.
//   C1 : >= 1 participant (eligible non-FVG non-Psych point Roots and / or a Virtual
//        Psych), anywhere; [min, max] of approach-side proximal edge + participants,
//        valid when width <= denseTick
//   C2 : peer FVG (another index, eligible, valid NativeRange) of a different TF and the
//        same direction with ob <= ot -> [ob, ot]
//   C3 : >= 1 point Root, all (and any Virtual Psych) inside the NativeRange inclusive,
//        and refCategoryHigh (stage B) true for MA / Swing / Accum / TimeHL -> point range
//   C4 : >= 1 point Root, all (and any Virtual Psych) inside inclusive, width <= denseTick
//        and >= 2 non-FVG categories among MA / Swing / Accum / TimeHL / Psych -> point range
refBroadLocalization(array<RefRoot> roots, int broadIndex, array<int> pointIndexes, bool psychPresent, int psychLevelTick, int peerFvgIndex, int side, int denseTick, int condition) =>
    int  nRoot  = array.size(roots)
    int  nPoint = array.size(pointIndexes)
    bool valid  = broadIndex >= 0 and broadIndex < nRoot
    int  bottom = int(na)
    int  top    = int(na)
    RefRoot a = valid ? array.get(roots, broadIndex) : na
    if valid
        valid := a.category == REF_CAT_FVG and a.isBroadFvg and refEligible(a, side) and not na(a.nativeBottomTick) and not na(a.nativeTopTick) and a.nativeBottomTick <= a.nativeTopTick
    if valid
        if condition == REF_BROAD_LOCAL_C2
            valid := peerFvgIndex >= 0 and peerFvgIndex < nRoot and peerFvgIndex != broadIndex
            if valid
                RefRoot b = array.get(roots, peerFvgIndex)
                valid := b.category == REF_CAT_FVG and refEligible(b, side) and not na(b.nativeBottomTick) and not na(b.nativeTopTick) and b.nativeBottomTick <= b.nativeTopTick and b.tfCode != a.tfCode and b.direction == a.direction
                if valid
                    int ob = math.max(a.nativeBottomTick, b.nativeBottomTick)
                    int ot = math.min(a.nativeTopTick,    b.nativeTopTick)
                    valid := ob <= ot
                    if valid
                        bottom := ob
                        top    := ot
        else if condition == REF_BROAD_LOCAL_C1 or condition == REF_BROAD_LOCAL_C3 or condition == REF_BROAD_LOCAL_C4
            bool needInside = condition != REF_BROAD_LOCAL_C1
            valid := denseTick >= 0 and not (psychPresent and na(psychLevelTick)) and (condition == REF_BROAD_LOCAL_C1 ? (nPoint > 0 or psychPresent) : nPoint > 0)
            bool hasMa     = false
            bool hasSwing  = false
            bool hasAccum  = false
            bool hasTimeHl = false
            int i = 0
            while valid and i < nPoint
                int idx = array.get(pointIndexes, i)
                if idx < 0 or idx >= nRoot
                    valid := false
                else
                    RefRoot r = array.get(roots, idx)
                    if r.category == REF_CAT_FVG or r.category == REF_CAT_PSYCH or not refEligible(r, side) or na(r.pointTick)
                        valid := false
                    else if needInside and not (a.nativeBottomTick <= r.pointTick and r.pointTick <= a.nativeTopTick)
                        valid := false
                    else
                        bottom := na(bottom) ? r.pointTick : math.min(bottom, r.pointTick)
                        top    := na(top)    ? r.pointTick : math.max(top,    r.pointTick)
                        hasMa     := hasMa     or r.category == REF_CAT_MA
                        hasSwing  := hasSwing  or r.category == REF_CAT_SWING
                        hasAccum  := hasAccum  or r.category == REF_CAT_ACCUM
                        hasTimeHl := hasTimeHl or r.category == REF_CAT_TIMEHL
                i += 1
            if valid and psychPresent
                if needInside and not (a.nativeBottomTick <= psychLevelTick and psychLevelTick <= a.nativeTopTick)
                    valid := false
                else
                    bottom := na(bottom) ? psychLevelTick : math.min(bottom, psychLevelTick)
                    top    := na(top)    ? psychLevelTick : math.max(top,    psychLevelTick)
            if valid
                if condition == REF_BROAD_LOCAL_C1
                    int proximal = side == REF_SIDE_SUPPORT ? a.nativeTopTick : a.nativeBottomTick
                    bottom := math.min(bottom, proximal)
                    top    := math.max(top,    proximal)
                    valid  := top - bottom <= denseTick
                else if condition == REF_BROAD_LOCAL_C3
                    int pointDensity = top - bottom <= denseTick ? REF_DEN_HIGH : REF_DEN_NORMAL
                    bool anyHigh = refCategoryHigh(roots, pointIndexes, REF_CAT_MA, side, REF_STAGE_B, pointDensity, denseTick) or refCategoryHigh(roots, pointIndexes, REF_CAT_SWING, side, REF_STAGE_B, pointDensity, denseTick) or refCategoryHigh(roots, pointIndexes, REF_CAT_ACCUM, side, REF_STAGE_B, pointDensity, denseTick) or refCategoryHigh(roots, pointIndexes, REF_CAT_TIMEHL, side, REF_STAGE_B, pointDensity, denseTick)
                    valid := anyHigh
                else
                    int catCount = (hasMa ? 1 : 0) + (hasSwing ? 1 : 0) + (hasAccum ? 1 : 0) + (hasTimeHl ? 1 : 0) + (psychPresent ? 1 : 0)
                    valid := top - bottom <= denseTick and catCount >= 2
        else
            valid := false
    if not valid
        bottom := int(na)
        top    := int(na)
    [valid, bottom, top]

// FVG Category High of the participating FVG Roots (at most one High for the
// Category). false on an invalid or repeated index, a non-FVG Root or a Root not
// eligible for `side`. High when any of:
//   A : a non-Broad FVG of 4H or D
//   B : two different FVGs of the same direction, different TF and actual overlap (ob <= ot)
//   C : broadLocalized and at least one participating FVG is Broad
// 1H alone, same-TF overlap, Bullish + Bearish, unlocalized Broad / BroadContext and
// FVG count alone never make it High.
refFvgHigh(array<RefRoot> roots, array<int> fvgIndexes, int side, bool broadLocalized) =>
    int  n     = array.size(fvgIndexes)
    int  nRoot = array.size(roots)
    bool valid = true
    int  i = 0
    while valid and i < n
        int idx = array.get(fvgIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        else
            int j = 0
            while valid and j < i
                if array.get(fvgIndexes, j) == idx
                    valid := false
                j += 1
            if valid
                RefRoot r = array.get(roots, idx)
                valid := r.category == REF_CAT_FVG and refEligible(r, side)
        i += 1
    bool isHigh = false
    if valid
        i := 0
        while not isHigh and i < n
            RefRoot a = array.get(roots, array.get(fvgIndexes, i))
            if not a.isBroadFvg and (a.tfCode == REF_TF_4H or a.tfCode == REF_TF_D)
                isHigh := true
            else if broadLocalized and a.isBroadFvg
                isHigh := true
            else
                int j = i + 1
                while not isHigh and j < n
                    RefRoot b = array.get(roots, array.get(fvgIndexes, j))
                    if a.direction == b.direction and a.tfCode != b.tfCode and not na(a.nativeBottomTick) and not na(a.nativeTopTick) and not na(b.nativeBottomTick) and not na(b.nativeTopTick)
                        if math.max(a.nativeBottomTick, b.nativeBottomTick) <= math.min(a.nativeTopTick, b.nativeTopTick)
                            isHigh := true
                    j += 1
            i += 1
    isHigh


// ============================================================
// W04 B07 : Stage A brute-force enumeration (Dense candidates only)
// ============================================================

// Completes one Stage A Dense candidate and appends it to outCandidates.
// Returns true when appended, false when invalid, not Dense, or an exact duplicate.
// Density = refDensity(..., false) and must be REF_DEN_HIGH. C / H come from
// refQualityAggregate (stage A, REF_DEN_HIGH); refFvgHigh adds the FVG High bit 16
// and one H at most once. BaseStrong = refBaseStrong only; a non-Strong candidate is
// still appended. createdTime = max(confirmedTime) and minRootId = min(rootId) over
// the materialized Roots only (a Virtual Psych never takes part). rootIndexes is an
// independent copy. A duplicate is only an exact match of side, stage, the whole
// materialized Root index set, psychPresent / psychLevelTick / psychIsMajor, both
// effective ticks and fvgMode.
refAppendDenseCandidate(array<RefRoot> roots, array<int> materializedRootIndexes, bool psychPresent, int psychLevelTick, bool psychIsMajor, int side, int effectiveBottomTick, int effectiveTopTick, int denseTick, int mTick, int fvgMode, bool broadLocalized, array<RefCandidate> outCandidates) =>
    int  n     = array.size(materializedRootIndexes)
    int  nRoot = array.size(roots)
    bool valid = n > 0 and (side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE) and not na(effectiveBottomTick) and not na(effectiveTopTick) and effectiveBottomTick <= effectiveTopTick and denseTick >= 0 and mTick >= denseTick
    int  createdTime = int(na)
    int  minRootId   = int(na)
    array<int> fvgIndexes = array.new_int()
    int i = 0
    while valid and i < n
        int idx = array.get(materializedRootIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        else
            int j = 0
            while valid and j < i
                if array.get(materializedRootIndexes, j) == idx
                    valid := false
                j += 1
            if valid
                RefRoot r = array.get(roots, idx)
                if not refEligible(r, side) or na(r.confirmedTime) or na(r.rootId) or r.rootId <= 0
                    valid := false
                else
                    createdTime := na(createdTime) ? r.confirmedTime : math.max(createdTime, r.confirmedTime)
                    minRootId   := na(minRootId)   ? r.rootId        : math.min(minRootId,   r.rootId)
                    if r.category == REF_CAT_FVG
                        array.push(fvgIndexes, idx)
        i += 1
    if valid
        valid := refDensity(effectiveBottomTick, effectiveTopTick, denseTick, mTick, false) == REF_DEN_HIGH
    bool appended = false
    if valid
        [aggOk, aggCategoryMask, aggHighMask, aggC, aggH] = refQualityAggregate(roots, materializedRootIndexes, psychPresent, side, REF_STAGE_A, REF_DEN_HIGH, denseTick)
        if aggOk
            int highMask = aggHighMask
            int hCount   = aggH
            // FVG High bit 16 at most once (B05 highMask never carries bit 16, max 15)
            if array.size(fvgIndexes) > 0 and highMask < 16
                if refFvgHigh(roots, fvgIndexes, side, broadLocalized)
                    highMask += 16
                    hCount   += 1
            bool baseStrong = refBaseStrong(aggC, hCount, REF_DEN_HIGH)
            int  tick       = psychPresent ? psychLevelTick : int(na)
            bool major      = psychPresent ? psychIsMajor : false
            // exact-duplicate check only
            bool duplicate = false
            int  k = 0
            while not duplicate and k < array.size(outCandidates)
                RefCandidate c = array.get(outCandidates, k)
                bool same = c.side == side and c.stage == REF_STAGE_A and c.psychPresent == psychPresent and ((na(c.psychLevelTick) and na(tick)) or c.psychLevelTick == tick) and c.psychIsMajor == major and c.effectiveBottomTick == effectiveBottomTick and c.effectiveTopTick == effectiveTopTick and c.fvgMode == fvgMode and array.size(c.rootIndexes) == n
                int m = 0
                while same and m < n
                    same := array.includes(c.rootIndexes, array.get(materializedRootIndexes, m))
                    m += 1
                duplicate := same
                k += 1
            if not duplicate
                array.push(outCandidates, RefCandidate.new(side = side, stage = REF_STAGE_A, rootIndexes = array.copy(materializedRootIndexes), psychPresent = psychPresent, psychLevelTick = tick, psychIsMajor = major, effectiveBottomTick = effectiveBottomTick, effectiveTopTick = effectiveTopTick, categoryMask = aggCategoryMask, highMask = highMask, cCount = aggC, hCount = hCount, density = REF_DEN_HIGH, baseStrong = baseStrong, isBroadContext = false, createdTime = createdTime, minRootId = minRootId, fvgMode = fvgMode))
                appended := true
    appended

// Appends every Stage A variant of one contiguous Point window. Returns the number
// of candidates this call appended. A window with an Accum pair conflict, an invalid
// range or a base width > denseTick yields 0 (only this window is dropped).
// Variants: no Psych, then each single Virtual Psych level of refBuildPsychLevels
// (never two at once); for each of these, the plain Point candidate, then every
// eligible FVG of roots (index 0 .. last): a non-Broad FVG not used -> INSIDE and
// PROXIMAL both evaluated; a Broad FVG (shared, used ignored) -> C1 (PROXIMAL mode),
// C3 and C4 (INSIDE mode), each independently. At most one FVG per candidate; FVG
// pairs, Broad C2 and BroadContext belong to Stage B. used is read-only.
refAppendStageAVariants(array<RefRoot> roots, array<bool> used, array<int> pointIndexes, int side, int denseTick, int mTick, float mintick, array<RefCandidate> outCandidates) =>
    int nRoot = array.size(roots)
    int added = 0
    if array.size(used) == nRoot and refAccumPairValid(roots, pointIndexes)
        [baseOk, baseBottom, baseTop] = refPointEffectiveRange(roots, pointIndexes, false, int(na))
        if baseOk and baseTop - baseBottom <= denseTick
            array<int>  levelTicks = array.new_int()
            array<bool> levelMajor = array.new_bool()
            int nLevel = refBuildPsychLevels(baseBottom, baseTop, denseTick, mintick, levelTicks, levelMajor)
            // v = -1 : no Psych; v >= 0 : the single Psych level v
            int v = -1
            while v < nLevel
                bool pp    = v >= 0
                int  pt    = pp ? array.get(levelTicks, v) : int(na)
                bool major = pp ? array.get(levelMajor, v) : false
                [rOk, rBottom, rTop] = refPointEffectiveRange(roots, pointIndexes, pp, pt)
                if rOk and rTop - rBottom <= denseTick
                    if refAppendDenseCandidate(roots, pointIndexes, pp, pt, major, side, rBottom, rTop, denseTick, mTick, REF_FVG_RANGE_NONE, false, outCandidates)
                        added += 1
                    int k = 0
                    while k < nRoot
                        RefRoot f = array.get(roots, k)
                        if f.category == REF_CAT_FVG and refEligible(f, side)
                            array<int> withFvg = array.copy(pointIndexes)
                            array.push(withFvg, k)
                            if not f.isBroadFvg
                                if not array.get(used, k)
                                    [inOk, inBottom, inTop] = refFvgRange(roots, k, -1, pointIndexes, pp, pt, side, REF_FVG_RANGE_INSIDE, denseTick)
                                    if inOk
                                        if refAppendDenseCandidate(roots, withFvg, pp, pt, major, side, inBottom, inTop, denseTick, mTick, REF_FVG_RANGE_INSIDE, false, outCandidates)
                                            added += 1
                                    [pxOk, pxBottom, pxTop] = refFvgRange(roots, k, -1, pointIndexes, pp, pt, side, REF_FVG_RANGE_PROXIMAL, denseTick)
                                    if pxOk
                                        if refAppendDenseCandidate(roots, withFvg, pp, pt, major, side, pxBottom, pxTop, denseTick, mTick, REF_FVG_RANGE_PROXIMAL, false, outCandidates)
                                            added += 1
                            else
                                [c1Ok, c1Bottom, c1Top] = refBroadLocalization(roots, k, pointIndexes, pp, pt, -1, side, denseTick, REF_BROAD_LOCAL_C1)
                                if c1Ok
                                    if refAppendDenseCandidate(roots, withFvg, pp, pt, major, side, c1Bottom, c1Top, denseTick, mTick, REF_FVG_RANGE_PROXIMAL, true, outCandidates)
                                        added += 1
                                [c3Ok, c3Bottom, c3Top] = refBroadLocalization(roots, k, pointIndexes, pp, pt, -1, side, denseTick, REF_BROAD_LOCAL_C3)
                                if c3Ok
                                    if refAppendDenseCandidate(roots, withFvg, pp, pt, major, side, c3Bottom, c3Top, denseTick, mTick, REF_FVG_RANGE_INSIDE, true, outCandidates)
                                        added += 1
                                [c4Ok, c4Bottom, c4Top] = refBroadLocalization(roots, k, pointIndexes, pp, pt, -1, side, denseTick, REF_BROAD_LOCAL_C4)
                                if c4Ok
                                    if refAppendDenseCandidate(roots, withFvg, pp, pt, major, side, c4Bottom, c4Top, denseTick, mTick, REF_FVG_RANGE_INSIDE, true, outCandidates)
                                        added += 1
                        k += 1
                v += 1
    added

// Enumerates every Stage A candidate of `side` into outCandidates (cleared first)
// and returns its size. Every contiguous window [i..j] (0 <= i <= j < N) of the
// canonical Point order of refBuildPointOrder is built and passed to
// refAppendStageAVariants: no two-pointer, no break on width, no cap, no early stop.
// Invalid input (used / roots size mismatch, bad side, denseTick < 0,
// mTick < denseTick, na / non-positive mintick) -> 0. used is read-only.
refEnumerateStageA(array<RefRoot> roots, array<bool> used, int side, int denseTick, int mTick, float mintick, array<RefCandidate> outCandidates) =>
    array.clear(outCandidates)
    if array.size(used) == array.size(roots) and (side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE) and denseTick >= 0 and mTick >= denseTick and not na(mintick) and mintick > 0
        array<int> pointOrder = array.new_int()
        int nOrder = refBuildPointOrder(roots, used, side, pointOrder)
        int i = 0
        while i < nOrder
            int j = i
            while j < nOrder
                array<int> window = array.new_int()
                int w = i
                while w <= j
                    array.push(window, array.get(pointOrder, w))
                    w += 1
                refAppendStageAVariants(roots, used, window, side, denseTick, mTick, mintick, outCandidates)
                j += 1
            i += 1
    array.size(outCandidates)


// ============================================================
// W04 B08 : Stage B brute-force FVG enumeration (FVG-rooted candidates only)
// ============================================================

// Completes one FVG-only Stage B candidate (or a BroadContext) and appends it.
// Returns true when appended; false when invalid or an exact duplicate.
// Every materialized Root must be a valid, eligible FVG with a valid NativeRange,
// confirmedTime and rootId > 0; no Point Root. A single Virtual Psych may be attached
// (psychPresent / psychLevelTick / psychIsMajor); it is never in the Root indexes,
// createdTime or minRootId. psychPresent with a na tick, or a Psych on a BroadContext,
// is invalid; without Psych the stored tick is na and isMajor false.
// Density: broadContext -> refDensity(..., true) must be REF_DEN_BROAD_CONTEXT;
// otherwise refDensity(..., false) must be REF_DEN_HIGH or REF_DEN_NORMAL (width <= mTick).
// categoryMask = 16 (+ 32 with Psych), C = 1 (+ 1 with Psych); FVG High (bit 16, H = 1)
// from refFvgHigh, never for a BroadContext; Psych never adds H.
// BaseStrong = refBaseStrong (false for a BroadContext). createdTime = max(confirmedTime),
// minRootId = min(rootId) over all FVGs (Broad included). stage = REF_STAGE_B, or
// REF_STAGE_BROAD_CONTEXT for a BroadContext. A duplicate is an exact match of side,
// stage, Root index set, psychPresent / psychLevelTick / psychIsMajor, both ticks,
// categoryMask, highMask, density, baseStrong, isBroadContext and fvgMode.
refAppendStageBCandidate(array<RefRoot> roots, array<int> materializedRootIndexes, int side, int effectiveBottomTick, int effectiveTopTick, int denseTick, int mTick, int fvgMode, bool broadLocalized, bool broadContext, bool psychPresent, int psychLevelTick, bool psychIsMajor, array<RefCandidate> outCandidates) =>
    int  n     = array.size(materializedRootIndexes)
    int  nRoot = array.size(roots)
    bool valid = n > 0 and (side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE) and not na(effectiveBottomTick) and not na(effectiveTopTick) and effectiveBottomTick <= effectiveTopTick and denseTick >= 0 and mTick >= denseTick and not (psychPresent and na(psychLevelTick)) and not (psychPresent and broadContext)
    int  createdTime = int(na)
    int  minRootId   = int(na)
    int i = 0
    while valid and i < n
        int idx = array.get(materializedRootIndexes, i)
        if idx < 0 or idx >= nRoot
            valid := false
        else
            int j = 0
            while valid and j < i
                if array.get(materializedRootIndexes, j) == idx
                    valid := false
                j += 1
            if valid
                RefRoot r = array.get(roots, idx)
                if r.category != REF_CAT_FVG or not refEligible(r, side) or na(r.confirmedTime) or na(r.rootId) or r.rootId <= 0 or na(r.nativeBottomTick) or na(r.nativeTopTick) or r.nativeBottomTick > r.nativeTopTick
                    valid := false
                else
                    createdTime := na(createdTime) ? r.confirmedTime : math.max(createdTime, r.confirmedTime)
                    minRootId   := na(minRootId)   ? r.rootId        : math.min(minRootId,   r.rootId)
        i += 1
    int density = -1
    if valid
        density := refDensity(effectiveBottomTick, effectiveTopTick, denseTick, mTick, broadContext)
        valid   := broadContext ? density == REF_DEN_BROAD_CONTEXT : (density == REF_DEN_HIGH or density == REF_DEN_NORMAL)
    bool appended = false
    if valid
        int  tick         = psychPresent ? psychLevelTick : int(na)
        bool major        = psychPresent ? psychIsMajor : false
        int  categoryMask = psychPresent ? 48 : 16
        int  cCount       = psychPresent ? 2 : 1
        bool fvgHigh      = broadContext ? false : refFvgHigh(roots, materializedRootIndexes, side, broadLocalized)
        int  highMask     = fvgHigh ? 16 : 0
        int  hCount       = fvgHigh ? 1 : 0
        bool baseStrong   = broadContext ? false : refBaseStrong(cCount, hCount, density)
        int  stage        = broadContext ? REF_STAGE_BROAD_CONTEXT : REF_STAGE_B
        // exact-duplicate check only (Root index set compared as a set)
        bool duplicate = false
        int  k = 0
        while not duplicate and k < array.size(outCandidates)
            RefCandidate c = array.get(outCandidates, k)
            bool same = c.side == side and c.stage == stage and c.psychPresent == psychPresent and ((na(c.psychLevelTick) and na(tick)) or c.psychLevelTick == tick) and c.psychIsMajor == major and c.effectiveBottomTick == effectiveBottomTick and c.effectiveTopTick == effectiveTopTick and c.categoryMask == categoryMask and c.highMask == highMask and c.density == density and c.baseStrong == baseStrong and c.isBroadContext == broadContext and c.fvgMode == fvgMode and array.size(c.rootIndexes) == n
            int m = 0
            while same and m < n
                same := array.includes(c.rootIndexes, array.get(materializedRootIndexes, m))
                m += 1
            duplicate := same
            k += 1
        if not duplicate
            array.push(outCandidates, RefCandidate.new(side = side, stage = stage, rootIndexes = array.copy(materializedRootIndexes), psychPresent = psychPresent, psychLevelTick = tick, psychIsMajor = major, effectiveBottomTick = effectiveBottomTick, effectiveTopTick = effectiveTopTick, categoryMask = categoryMask, highMask = highMask, cCount = cCount, hCount = hCount, density = density, baseStrong = baseStrong, isBroadContext = broadContext, createdTime = createdTime, minRootId = minRootId, fvgMode = fvgMode))
            appended := true
    appended

// Enumerates every Stage B candidate of `side` of the CURRENT round into
// outCandidates (cleared first) and returns its size. Available FVGs: eligible FVGs;
// a non-Broad FVG only when not used, a Broad FVG whatever `used` says (shared).
// Base candidates (collected first, in this order):
//   1. each available non-Broad FVG alone (STANDALONE)
//   2. every pair i < j of available FVGs, no cap, no distance pre-filter:
//      non-Broad x non-Broad -> OVERLAP (same direction, ob <= ot; same TF allowed);
//      a pair with a Broad -> only Broad C2 (different TF, same direction, ob <= ot),
//      called once per pair (Broad x Broad: broadIndex = i, peer = j)
// Each base is appended without Psych, then once per single Virtual Psych level of
// refBuildPsychLevels(base, mTick) with the range widened to the level (mode kept);
// refDensity re-classifies every variant (> mTick never appends).
//   3. each available Broad FVG not localized this round -> one BroadContext (no Psych)
// "Localized this round" = the Broad index is in a non-BroadContext candidate of
// stageACandidates (this round's Stage A) or of the Stage B candidates built above.
// Nothing is cached across rounds; used is read-only; no Point Root.
// Invalid input (size mismatch, bad side, denseTick < 0, mTick < denseTick,
// na / non-positive mintick) -> 0.
refEnumerateStageB(array<RefRoot> roots, array<bool> used, int side, int denseTick, int mTick, float mintick, array<RefCandidate> stageACandidates, array<RefCandidate> outCandidates) =>
    array.clear(outCandidates)
    int nRoot = array.size(roots)
    if array.size(used) == nRoot and (side == REF_SIDE_SUPPORT or side == REF_SIDE_RESISTANCE) and denseTick >= 0 and mTick >= denseTick and not na(mintick) and mintick > 0
        array<int> noPoints = array.new_int()
        // base candidates : first FVG, second FVG (-1 = none), range, mode, broadLocalized
        array<int>  baseA      = array.new_int()
        array<int>  baseB      = array.new_int()
        array<int>  baseBottom = array.new_int()
        array<int>  baseTop    = array.new_int()
        array<int>  baseMode   = array.new_int()
        array<bool> baseLocal  = array.new_bool()
        // 1. non-Broad standalone
        int i = 0
        while i < nRoot
            RefRoot a = array.get(roots, i)
            if a.category == REF_CAT_FVG and refEligible(a, side) and not a.isBroadFvg and not array.get(used, i)
                [sOk, sBottom, sTop] = refFvgRange(roots, i, -1, noPoints, false, int(na), side, REF_FVG_RANGE_STANDALONE, denseTick)
                if sOk
                    array.push(baseA, i)
                    array.push(baseB, -1)
                    array.push(baseBottom, sBottom)
                    array.push(baseTop, sTop)
                    array.push(baseMode, REF_FVG_RANGE_STANDALONE)
                    array.push(baseLocal, false)
            i += 1
        // 2. every available FVG pair i < j
        i := 0
        while i < nRoot
            RefRoot a = array.get(roots, i)
            if a.category == REF_CAT_FVG and refEligible(a, side) and (a.isBroadFvg or not array.get(used, i))
                int j = i + 1
                while j < nRoot
                    RefRoot b = array.get(roots, j)
                    if b.category == REF_CAT_FVG and refEligible(b, side) and (b.isBroadFvg or not array.get(used, j))
                        if not a.isBroadFvg and not b.isBroadFvg
                            [oOk, oBottom, oTop] = refFvgRange(roots, i, j, noPoints, false, int(na), side, REF_FVG_RANGE_OVERLAP, denseTick)
                            if oOk
                                array.push(baseA, i)
                                array.push(baseB, j)
                                array.push(baseBottom, oBottom)
                                array.push(baseTop, oTop)
                                array.push(baseMode, REF_FVG_RANGE_OVERLAP)
                                array.push(baseLocal, false)
                        else
                            int broadIndex = a.isBroadFvg ? i : j
                            int peerIndex  = a.isBroadFvg ? j : i
                            [c2Ok, c2Bottom, c2Top] = refBroadLocalization(roots, broadIndex, noPoints, false, int(na), peerIndex, side, denseTick, REF_BROAD_LOCAL_C2)
                            if c2Ok
                                array.push(baseA, i)
                                array.push(baseB, j)
                                array.push(baseBottom, c2Bottom)
                                array.push(baseTop, c2Top)
                                array.push(baseMode, REF_FVG_RANGE_OVERLAP)
                                array.push(baseLocal, true)
                    j += 1
            i += 1
        // each base : no-Psych candidate, then each single Virtual Psych level
        array<int>  levelTicks = array.new_int()
        array<bool> levelMajor = array.new_bool()
        int q = 0
        while q < array.size(baseA)
            int        ia    = array.get(baseA, q)
            int        ib    = array.get(baseB, q)
            array<int> idxs  = ib == -1 ? array.from(ia) : array.from(ia, ib)
            int        bBot  = array.get(baseBottom, q)
            int        bTop  = array.get(baseTop, q)
            int        mode  = array.get(baseMode, q)
            bool       isLocal = array.get(baseLocal, q)
            refAppendStageBCandidate(roots, idxs, side, bBot, bTop, denseTick, mTick, mode, isLocal, false, false, int(na), false, outCandidates)
            int nLevel = refBuildPsychLevels(bBot, bTop, mTick, mintick, levelTicks, levelMajor)
            int v = 0
            while v < nLevel
                int pTick = array.get(levelTicks, v)
                refAppendStageBCandidate(roots, idxs, side, math.min(bBot, pTick), math.max(bTop, pTick), denseTick, mTick, mode, isLocal, false, true, pTick, array.get(levelMajor, v), outCandidates)
                v += 1
            q += 1
        // 3. current-round BroadContext for each available Broad not localized this round
        int nStageB = array.size(outCandidates)
        i := 0
        while i < nRoot
            RefRoot a = array.get(roots, i)
            if a.category == REF_CAT_FVG and refEligible(a, side) and a.isBroadFvg
                bool localized = false
                int k = 0
                while not localized and k < array.size(stageACandidates)
                    RefCandidate c = array.get(stageACandidates, k)
                    localized := not c.isBroadContext and array.includes(c.rootIndexes, i)
                    k += 1
                k := 0
                while not localized and k < nStageB
                    RefCandidate c = array.get(outCandidates, k)
                    localized := not c.isBroadContext and array.includes(c.rootIndexes, i)
                    k += 1
                if not localized
                    [xOk, xBottom, xTop] = refFvgRange(roots, i, -1, noPoints, false, int(na), side, REF_FVG_RANGE_BROAD_CONTEXT, denseTick)
                    if xOk
                        refAppendStageBCandidate(roots, array.from(i), side, xBottom, xTop, denseTick, mTick, REF_FVG_RANGE_BROAD_CONTEXT, false, true, false, int(na), false, outCandidates)
            i += 1
    array.size(outCandidates)

plot(na, title = "Compile anchor", display = display.none)

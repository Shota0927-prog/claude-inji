    array<int> rootNativeTopTicks
    array<int> rootStates
    array<int> rootPairKeys
    array<int> rootDirections
    array<bool> rootFvgFreshFlags
    array<bool> rootIsBroadFvgFlags
    array<int> rootLabelMasks
    array<bool> rootSlotLiveFlags
    array<int> rootSwingTfMasks
    array<int> rootPriceOrderSlots
    array<int> rootIdOrderSlots
    array<int> categoryFvgRootSlots
    array<int> rootOriginBucketNextRootSlots
    array<int> rootOriginBucketExpectedRootIds
    array<int> rootParticipationHeadEdgeIndexes
    array<int> rootParticipationCounts
    array<int> participationEdgeRootSlots
    array<int> participationEdgeExpectedRootIds
    array<int> participationEdgeSideSlots
    array<int> participationEdgeExpectedCoreIds
    array<int> participationEdgeNextByRootIndexes
    array<bool> participationEdgeLiveFlags
    array<int> sidePhases
    array<int> coreIds
    array<int> coreGenerationIds
    array<bool> coreSlotLiveFlags
    array<int> coreLiveSlots
    array<float> corePhysicalBottoms
    array<float> corePhysicalTops
    array<int> corePendingTopologyChildHeadIndexes
    array<int> corePendingTopologyChildCounts
    array<int> pendingTopologyChildNextIndexes
    array<int> pendingTopologyChildOwnerCoreSlots
    array<int> pendingTopologyChildExpectedCoreIds
    array<int> pendingTopologyChildExpectedGenerationIds
    array<int> pendingTopologyChildRootHeadNodeIndexes
    array<int> pendingTopologyChildRootCounts
    array<bool> pendingTopologyChildLiveFlags
    array<int> pendingTopologyRootNodeRootIds
    array<int> pendingTopologyRootNodeNextIndexes
    array<int> pendingTopologyRootNodeOwnerChildIndexes
    array<int> pendingTopologyRootNodeExpectedCoreIds
    array<int> pendingTopologyRootNodeExpectedGenerationIds
    array<bool> pendingTopologyRootNodeLiveFlags
    map<int, int> rootIdToSlot
    map<int, int> accumPairUpperRootSlotByKey
    map<int, int> accumPairLowerRootSlotByKey
    map<int, int> originKeyBucketHeadRootSlots
    int ema2000RootSlot       = -1
    int ema2000ExpectedRootId = 0
    int ema2000SlopeDir       = na
    int ema3000RootSlot       = -1
    int ema3000ExpectedRootId = 0
    int ema3000SlopeDir       = na
    int nextRootId            = 1

// W05 reusable Candidate state (the selectBothSides scratch / winner buffers and scalars, Production defaults)
type W06FxCand
    array<int> candidateScratchSupportNewRootSlots
    array<int> candidateScratchResistanceNewRootSlots
    array<int> candidateSupportScratchPosByRootSlot
    array<int> candidateResistanceScratchPosByRootSlot
    array<bool> candidateSupportUsedByRootSlot
    array<bool> candidateResistanceUsedByRootSlot
    array<int> candidateSupportFvgRootSlots
    array<int> candidateResistanceFvgRootSlots
    array<int> candidateWindowMinRootIdDequeScratchIndexes
    array<int> candidateWindowMaxConfirmedTimeDequeScratchIndexes
    array<int> candidateWinnerSides

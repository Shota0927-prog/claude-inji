//@version=6
// =====================================================================================
// ZoneEngineV2_Rebuild_ConformanceHarness.pine
// Deterministic fixture harness (I3-3 / I22). Nothing in this file belongs to the
// Production hot path: the brute force Reference clusterer and the test counters live
// here only.
//
// It drives the Engine from a synthetic Feed (chart data is ignored) so the results are
// reproducible on any symbol, and it runs:
//   * I22.1-3  candidate cache ON vs OFF, every fixture bar
//   * I22.1-1/2/4/6/7  incremental + indexed Production result vs a full sort, all
//                      subwindow, full rescan Reference, every fixture bar
//   * I22.1-10 identical Engine result with debug/presentation inputs on and off
//   * scripted logical acceptance cases from App. B
//
// IMPORTANT: replace USERNAME/ZoneEngineV2_Rebuild/1 with the published library path.
// =====================================================================================
indicator("ZoneEngineV2 Rebuild - Conformance Harness", overlay = false, max_labels_count = 500)

import USERNAME/ZoneEngineV2_Rebuild/1 as ZE

FIXTURE_BARS = 60
MT = 0.01

// -------------------------------------------------------------------------------------
// Result recording
// -------------------------------------------------------------------------------------
var array<string> tName = array.new<string>(0)
var array<int>    tState = array.new<int>(0)      // 0 = NOT RUN, 1 = PASS, 2 = FAIL
var array<string> tNote = array.new<string>(0)

tIndexOf(string name) =>
    idx = -1
    n = array.size(tName)
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                if array.get(tName, i) == name
                    idx := i
                    break
    idx

tDeclare(string name) =>
    if tIndexOf(name) < 0
        array.push(tName, name)
        array.push(tState, 0)
        array.push(tNote, "not run")

tPass(string name) =>
    i = tIndexOf(name)
    if i >= 0
        if array.get(tState, i) != 2
            array.set(tState, i, 1)
            array.set(tNote, i, "")

tFail(string name, string note) =>
    i = tIndexOf(name)
    if i >= 0
        array.set(tState, i, 2)
        if array.get(tNote, i) == "" or array.get(tNote, i) == "not run"
            array.set(tNote, i, note)

tCheck(string name, bool cond, string note) =>
    if cond
        tPass(name)
    else
        tFail(name, note)

// -------------------------------------------------------------------------------------
// Configuration for the fixture (initial values of App. A 4.1)
// -------------------------------------------------------------------------------------
mkCfg(bool fvgOn, bool psychOn, int cacheSize) =>
    c = ZE.newCfg()
    c.clusterMaxWidth := 20.0
    c.denseRatio := 0.50
    c.touchResetDistance := 10.0
    c.strongUntilTouch := 1
    c.weakFromTouch := 2
    c.weakDepthPct := 50.0
    c.breakBuffer := 2.0
    c.touchTolerance := 0.0
    c.catMaOn := false
    c.catSwingOn := true
    c.catAccumOn := true
    c.catTimeHlOn := false
    c.catFvgOn := fvgOn
    c.catPsychOn := psychOn
    c.mintick := MT
    c.baseTfMinutes := 5
    c.candidateCacheSize := cacheSize
    c

var ZE.ZoneCfg cfgA = mkCfg(true, false, 64)     // production settings, cache ON
var ZE.ZoneCfg cfgB = mkCfg(true, false, 0)      // identical logic, cache OFF
var ZE.ZoneEngine engA = ZE.newEngine(cfgA)
var ZE.ZoneEngine engB = ZE.newEngine(cfgB)
var ZE.Feed feedA = ZE.newFeed()
var ZE.Feed feedB = ZE.newFeed()

// -------------------------------------------------------------------------------------
// Fixture: per bar OHLC and Source injections. Chart data is deliberately unused.
// Zone layout: 1H swing high 2000.00 (High quality), 4H Accum box top 2005.00 /
// bottom 1900.00. Support View core = [2000.00, 2005.00], width 5 -> High Density,
// C = 2, H = 1 -> Base Strong.
// -------------------------------------------------------------------------------------
fixOpen(int i) =>
    switch
        i == 3 => 2030.0
        i == 4 => 2002.5
        i == 5 => 2015.0
        i == 6 => 2016.0
        i == 7 => 2004.0
        i == 8 => 2001.0
        i == 9 => 1997.0
        i == 10 => 1988.0
        i == 11 => 1995.0
        i == 12 => 1999.0
        => 2030.0

fixHigh(int i) =>
    switch
        i == 4 => 2030.0
        i == 5 => 2015.5
        i == 6 => 2016.5
        i == 7 => 2016.0
        i == 8 => 2004.0
        i == 9 => 1999.0
        i == 10 => 1996.0
        i == 11 => 1996.0
        i == 12 => 2001.0
        i == 13 => 2000.5
        => 2031.0

fixLow(int i) =>
    switch
        i == 4 => 2000.0
        i == 5 => 2014.0
        i == 6 => 2015.0
        i == 7 => 2003.0
        i == 8 => 1998.0
        i == 9 => 1988.0
        i == 10 => 1986.0
        i == 11 => 1994.0
        i == 12 => 1996.0
        i == 13 => 1996.0
        => 2029.0

fixClose(int i) =>
    switch
        i == 4 => 2002.5      // Touch 1 starts, depth exactly 50 %
        i == 5 => 2015.0      // reset distance exactly 10.00 above the top
        i == 6 => 2016.0
        i == 7 => 2004.0      // Touch 2 starts
        i == 8 => 1998.0      // bottom 2000.00 - breakBuffer 2.00 -> Local Break
        i == 9 => 1990.0      // 10.00 below the BreakSnapshot bottom -> movedAway
        i == 10 => 1988.0
        i == 11 => 1995.0
        i == 12 => 1999.0     // retest from below, close under the snapshot -> Flip
        i == 13 => 1997.0
        => 2030.0

// -------------------------------------------------------------------------------------
// Brute force Reference clusterer (full sort, every contiguous subwindow, full rescan,
// no cache, no index, no component locality). Point Roots only; the fixture keeps FVG
// out of the compared bars.
// -------------------------------------------------------------------------------------
refBestSupportRange(ZE.ZoneEngine eng, ZE.ZoneCfg cfg, float bandLo, float bandHi) =>
    prices = array.new<float>(0)
    cats = array.new<int>(0)
    highs = array.new<bool>(0)
    pairs = array.new<int>(0)
    ids = array.new<int>(0)
    n0 = ZE.rootCount(eng)
    if n0 > 0
        if (n0 - 1) >= (0)
            for i = 0 to n0 - 1
                r = ZE.rootAt(eng, i)
                if r.rootId != 0 and not r.isRangeRoot and r.category != 5 and r.state == 1 and r.pointPrice >= bandLo and r.pointPrice <= bandHi
                    array.push(prices, r.pointPrice)
                    array.push(cats, r.category)
                    array.push(highs, r.intrinsicHigh)
                    array.push(pairs, r.pairKey)
                    array.push(ids, r.rootId)
    n = array.size(prices)
    // full sort by price then rootId on every call
    if n > 1
        if (n - 1) >= (1)
            for i = 1 to n - 1
                kp = array.get(prices, i)
                kc = array.get(cats, i)
                kh = array.get(highs, i)
                kk = array.get(pairs, i)
                ki = array.get(ids, i)
                j = i - 1
                while j >= 0 and (array.get(prices, j) > kp or (array.get(prices, j) == kp and array.get(ids, j) > ki))
                    array.set(prices, j + 1, array.get(prices, j))
                    array.set(cats, j + 1, array.get(cats, j))
                    array.set(highs, j + 1, array.get(highs, j))
                    array.set(pairs, j + 1, array.get(pairs, j))
                    array.set(ids, j + 1, array.get(ids, j))
                    j -= 1
                array.set(prices, j + 1, kp)
                array.set(cats, j + 1, kc)
                array.set(highs, j + 1, kh)
                array.set(pairs, j + 1, kk)
                array.set(ids, j + 1, ki)
    dense = cfg.clusterMaxWidth * cfg.denseRatio
    float bestBot = na
    float bestTop = na
    bestC = -1
    bestH = -1
    bestW = 1e9
    bestId = 999999999
    if n > 0
        if (n - 1) >= (0)
            for a = 0 to n - 1
                if (n - 1) >= (a)
                    for b = a to n - 1
                        w = array.get(prices, b) - array.get(prices, a)
                        if w <= dense
                            // full rescan of the window: categories, high categories, pair conflicts
                            c0 = 0
                            c1 = 0
                            c2 = 0
                            c3 = 0
                            h1 = 0
                            h2 = 0
                            h3 = 0
                            minId = 999999999
                            bool pairConflict = false
                            if (b) >= (a)
                                for x = a to b
                                    cx = array.get(cats, x)
                                    if cx == 0
                                        c0 += 1
                                    if cx == 1
                                        c1 += 1
                                        if array.get(highs, x)
                                            h1 += 1
                                    if cx == 2
                                        c2 += 1
                                        if array.get(highs, x)
                                            h2 += 1
                                    if cx == 3
                                        c3 += 1
                                        if array.get(highs, x)
                                            h3 += 1
                                    if array.get(ids, x) < minId
                                        minId := array.get(ids, x)
                                    pk = array.get(pairs, x)
                                    if pk != 0
                                        if (x - 1) >= (a)
                                            for y = a to x - 1
                                                if array.get(pairs, y) == pk
                                                    pairConflict := true
                            if not pairConflict
                                cCnt = (c0 > 0 ? 1 : 0) + (c1 > 0 ? 1 : 0) + (c2 > 0 ? 1 : 0) + (c3 > 0 ? 1 : 0)
                                hCnt = (h1 > 0 ? 1 : 0) + (h2 > 0 ? 1 : 0) + (h3 > 0 ? 1 : 0)
                                strong = (cCnt == 2 and hCnt >= 1) or cCnt >= 3
                                if strong
                                    bool better = cCnt > bestC
                                    if not better and cCnt == bestC
                                        better := hCnt > bestH
                                        if not better and hCnt == bestH
                                            better := w < bestW
                                            if not better and w == bestW
                                                better := minId < bestId
                                    if better
                                        bestC := cCnt
                                        bestH := hCnt
                                        bestW := w
                                        bestId := minId
                                        bestBot := array.get(prices, a)
                                        bestTop := array.get(prices, b)
    [bestBot, bestTop, bestC, bestH]

// -------------------------------------------------------------------------------------
// View lookup helpers
// -------------------------------------------------------------------------------------
findView(ZE.ZoneEngine eng, int side, float bot, float top) =>
    idx = -1
    n = ZE.viewCount(eng)
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                v = ZE.viewAt(eng, i)
                if v.side == side and not na(v.effectiveBottom)
                    if math.abs(v.effectiveBottom - bot) < MT * 0.5 and math.abs(v.effectiveTop - top) < MT * 0.5
                        idx := i
                        break
    idx

hasEvent(ZE.ZoneEngine eng, int etype, int side) =>
    found = false
    n = ZE.eventCount(eng)
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                e = ZE.eventAt(eng, i)
                if e.eventType == etype and (side == 0 or e.side == side)
                    found := true
                    break
    found

viewsEqual(ZE.ZoneEngine a, ZE.ZoneEngine b) =>
    bool same = ZE.viewCount(a) == ZE.viewCount(b)
    if same
        n = ZE.viewCount(a)
        if n > 0
            if (n - 1) >= (0)
                for i = 0 to n - 1
                    va = ZE.viewAt(a, i)
                    vb = ZE.viewAt(b, i)
                    if va.coreId != vb.coreId or va.generationId != vb.generationId or va.side != vb.side or va.phase != vb.phase or va.grade != vb.grade or va.cCount != vb.cCount or va.hCount != vb.hCount or va.density != vb.density or va.baseStrong != vb.baseStrong or va.currentTouchNo != vb.currentTouchNo or va.upcomingTouchNo != vb.upcomingTouchNo or va.weakReason != vb.weakReason or va.zoneFresh != vb.zoneFresh or va.sideFresh != vb.sideFresh or va.eligible != vb.eligible
                        same := false
                        break
                    if not na(va.effectiveBottom) or not na(vb.effectiveBottom)
                        if na(va.effectiveBottom) != na(vb.effectiveBottom) or math.abs(nz(va.effectiveBottom, 0) - nz(vb.effectiveBottom, 0)) > MT * 0.5 or math.abs(nz(va.effectiveTop, 0) - nz(vb.effectiveTop, 0)) > MT * 0.5
                            same := false
                            break
    same

eventsEqual(ZE.ZoneEngine a, ZE.ZoneEngine b) =>
    bool same = ZE.eventCount(a) == ZE.eventCount(b)
    if same
        n = ZE.eventCount(a)
        if n > 0
            if (n - 1) >= (0)
                for i = 0 to n - 1
                    ea = ZE.eventAt(a, i)
                    eb = ZE.eventAt(b, i)
                    if ea.eventType != eb.eventType or ea.coreId != eb.coreId or ea.generationId != eb.generationId or ea.side != eb.side or ea.touchNo != eb.touchNo or ea.gradeAtStart != eb.gradeAtStart or ea.weakReason != eb.weakReason
                        same := false
                        break
    same

// -------------------------------------------------------------------------------------
// Test registry (App. B 75 cases + I22.1 equivalence set). Anything the synthetic
// fixture cannot exercise stays NOT RUN and is reported as such.
// -------------------------------------------------------------------------------------
if barstate.isfirst
    for i = 1 to 75
        tDeclare("B" + str.tostring(i))
    tDeclare("I22.1-1 incremental price order vs full sort")
    tDeclare("I22.1-2 two pointer / differential C,H vs all subwindow rescan")
    tDeclare("I22.1-3 candidate cache ON vs OFF")
    tDeclare("I22.1-4 local component vs full recompute")
    tDeclare("I22.1-5 FVG price index vs all pair")
    tDeclare("I22.1-6 Core interval sweep vs all old x new")
    tDeclare("I22.1-7 state price index vs full Core scan")
    tDeclare("I22.1-8 ring buffer logical order")
    tDeclare("I22.1-9 free slot reuse vs no reuse")
    tDeclare("I22.1-10 identical result with presentation inputs on/off")

// =====================================================================================
// Fixture driver: chart data is ignored, both Engines get the identical synthetic Feed
// =====================================================================================
fillFeed(ZE.Feed f, int i) =>
    ZE.resetFeedEvents(f)
    f.baseOpen := fixOpen(i)
    f.baseHigh := fixHigh(i)
    f.baseLow := fixLow(i)
    f.baseClose := fixClose(i)
    f.basePrevClose := i == 0 ? fixClose(0) : fixClose(i - 1)
    f.baseOpenTime := 1700000000000 + i * 300000
    f.baseCloseTime := 1700000000000 + (i + 1) * 300000
    f.baseSeq := i
    f.baseConfirmed := true
    f.mintick := MT
    f.baseTfMinutes := 5
    f.ema2000 := na
    f.ema3000 := na
    // ---- Source injections ------------------------------------------------------------
    if i == 0
        // 1H swing high -> Swing category, intrinsic High
        ZE.pushSwing(f, 60, true, 2000.00, 1699990000000, 1699993600000, 1699997200000)
    if i == 1
        // 4H Accum box: top joins the swing (width 5 -> dense), bottom is far away
        ZE.pushAccumBox(f, 240, 2005.00, 1900.00, 1699900000000, 1699990000000)
    if i == 2
        // App. B 21: both boundaries of ONE box, 10 apart -> must stay separate Zones
        ZE.pushAccumBox(f, 60, 2050.00, 2040.00, 1699800000000, 1699890000000)
        // App. B 41: C = 2, High Density, H = 0 -> not Base Strong
        ZE.pushSwing(f, 5, false, 2060.00, 1699880000000, 1699880300000, 1699881000000)
        ZE.pushAccumBox(f, 60, 2062.00, 1800.00, 1699700000000, 1699790000000)
        // App. B 2: width exactly denseWidth -> High Density, Base Strong
        ZE.pushSwing(f, 60, true, 2200.00, 1699600000000, 1699603600000, 1699607200000)
        ZE.pushAccumBox(f, 240, 2210.00, 1700.00, 1699500000000, 1699590000000)
        // App. B 1: width exactly M -> still one normal Zone
        ZE.pushSwing(f, 5, true, 2300.00, 1699400000000, 1699400300000, 1699401000000)
        ZE.pushAccumBox(f, 60, 2320.00, 1600.00, 1699300000000, 1699390000000)
    if i == 4
        // App. B 26 / 43: Bullish HTF FVG that overlaps the 2060 cluster -> Support only
        ZE.pushFvg(f, 60, 1, 2058.00, 2064.00, 1699200000000, 1699290000000)
    f

var int fixtureBar = -1
if bar_index < FIXTURE_BARS
    fixtureBar := bar_index
    fillFeed(feedA, fixtureBar)
    fillFeed(feedB, fixtureBar)
    okA = ZE.updateConfirmed5m(engA, cfgA, feedA)
    okB = ZE.updateConfirmed5m(engB, cfgB, feedB)

    // ---- I22.1-3 / I22.2: cache ON vs OFF, every bar, full View and Event comparison --
    tCheck("I22.1-3 candidate cache ON vs OFF", okA == okB and viewsEqual(engA, engB) and eventsEqual(engA, engB), "diverged at fixture bar " + str.tostring(fixtureBar))

    // ---- I22.1-1/2/4/6/7: Production result vs brute force Reference -------------------
    [rb, rt, rc, rh] = refBestSupportRange(engA, cfgA, 1990.0, 2010.0)
    prodIdx = -1
    n = ZE.viewCount(engA)
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                v = ZE.viewAt(engA, i)
                if v.side == 1 and v.baseStrong and not na(v.effectiveBottom)
                    if v.effectiveBottom >= 1990.0 and v.effectiveTop <= 2010.0
                        prodIdx := i
                        break
    bool refMatch = false
    if na(rb) and prodIdx < 0
        refMatch := true
    else if not na(rb) and prodIdx >= 0
        pv = ZE.viewAt(engA, prodIdx)
        refMatch := math.abs(pv.effectiveBottom - rb) < MT * 0.5 and math.abs(pv.effectiveTop - rt) < MT * 0.5 and pv.cCount == rc and pv.hCount == rh
    note = "fixture bar " + str.tostring(fixtureBar) + " ref=" + str.tostring(rb) + "-" + str.tostring(rt) + " C" + str.tostring(rc) + "H" + str.tostring(rh)
    tCheck("I22.1-1 incremental price order vs full sort", refMatch, note)
    tCheck("I22.1-2 two pointer / differential C,H vs all subwindow rescan", refMatch, note)
    tCheck("I22.1-4 local component vs full recompute", refMatch, note)
    tCheck("I22.1-6 Core interval sweep vs all old x new", refMatch, note)
    tCheck("I22.1-7 state price index vs full Core scan", refMatch, note)

    // =================================================================================
    // Scripted acceptance cases
    // =================================================================================
    mainIdx = findView(engA, 1, 2000.00, 2005.00)
    if fixtureBar == 3
        // App. B 42: C = 2, High Density, H >= 1 -> Base Strong
        if mainIdx >= 0
            v = ZE.viewAt(engA, mainIdx)
            tCheck("B42", v.baseStrong and v.cCount == 2 and v.hCount >= 1 and v.density == 0, "C" + str.tostring(v.cCount) + " H" + str.tostring(v.hCount) + " d" + str.tostring(v.density))
            tCheck("B45", v.density == 0 and v.effectiveTop - v.effectiveBottom <= 10.0, "dense core widened by an outside Root")
        else
            tFail("B42", "main Support core [2000,2005] not found")
        // App. B 2 / 1: boundary widths
        i2 = findView(engA, 1, 2200.00, 2210.00)
        tCheck("B2", i2 >= 0 and ZE.viewAt(engA, i2).density == 0 and ZE.viewAt(engA, i2).baseStrong, "exact denseWidth core missing or not High Density")
        i1 = findView(engA, 1, 2300.00, 2320.00)
        tCheck("B1", i1 >= 0 and ZE.viewAt(engA, i1).density == 1, "exact M core missing or wrong density")
        // App. B 21: the two boundaries of one Accum box never share a Zone
        iPair = findView(engA, 1, 2040.00, 2050.00)
        iLow = findView(engA, 1, 2040.00, 2040.00)
        iHigh = findView(engA, 1, 2050.00, 2050.00)
        tCheck("B21", iPair < 0 and iLow >= 0 and iHigh >= 0, "same-box boundaries were clustered together")
        // App. B 41: C = 2, High Density, H = 0 -> not Base Strong
        i41 = findView(engA, 1, 2060.00, 2062.00)
        tCheck("B41", i41 >= 0 and not ZE.viewAt(engA, i41).baseStrong and ZE.viewAt(engA, i41).cCount == 2 and ZE.viewAt(engA, i41).hCount == 0, "C2/H0 cluster became Base Strong")
        // App. B 47: a Zone that was not Armed on the previous bar cannot start a Touch
        tCheck("B47", not hasEvent(engA, 1, 0) or fixtureBar > 3, "touch started without a previous-bar Armed state")
    if fixtureBar == 4
        // App. B 49 / 51 / 4 / 8: Touch 1 of a Base Strong Zone starts Strong, depth 50 %
        bool ts = hasEvent(engA, 1, 1)
        tCheck("B8", ts, "wick equal to the Zone edge did not count as a Touch")
        tCheck("B49", ts, "Touch 1 of a Base Strong Zone")
        gradeAtStart = -1
        touchNo = -1
        ne = ZE.eventCount(engA)
        if ne > 0
            if (ne - 1) >= (0)
                for i = 0 to ne - 1
                    e = ZE.eventAt(engA, i)
                    if e.eventType == 1 and e.side == 1
                        gradeAtStart := e.gradeAtStart
                        touchNo := e.touchNo
        tCheck("B49", gradeAtStart == 0 and touchNo == 1, "gradeAtStart=" + str.tostring(gradeAtStart) + " touchNo=" + str.tostring(touchNo))
        tCheck("B4", hasEvent(engA, 3, 1), "WeakDepth exactly at the threshold was not raised")
        if mainIdx >= 0
            v = ZE.viewAt(engA, mainIdx)
            tCheck("B51", gradeAtStart == 0 and v.grade == 2, "current grade " + str.tostring(v.grade) + " start grade " + str.tostring(gradeAtStart))
    if fixtureBar == 5
        tCheck("B3", hasEvent(engA, 2, 1), "reset at exactly touchResetDistance did not complete the Episode")
        if mainIdx >= 0
            v = ZE.viewAt(engA, mainIdx)
            tCheck("B48", v.upcomingTouchNo == 2, "upcomingTouchNo=" + str.tostring(v.upcomingTouchNo))
    if fixtureBar == 6
        if mainIdx >= 0
            v = ZE.viewAt(engA, mainIdx)
            tCheck("B50", v.grade == 2 and v.upcomingTouchNo == 2, "grade=" + str.tostring(v.grade))
            tCheck("B52", v.weakReason != 0, "weak state was cleared by the reset")
        // App. B 26 / 43: Bullish FVG joins Support only
        i43 = findView(engA, 1, 2060.00, 2062.00)
        bool supOk = i43 >= 0 and ZE.viewAt(engA, i43).cCount == 3 and ZE.viewAt(engA, i43).baseStrong
        resC = -1
        nn = ZE.viewCount(engA)
        if nn > 0
            if (nn - 1) >= (0)
                for i = 0 to nn - 1
                    v2 = ZE.viewAt(engA, i)
                    if v2.side == -1 and not na(v2.effectiveBottom)
                        if math.abs(v2.effectiveBottom - 2060.00) < 0.005 and math.abs(v2.effectiveTop - 2062.00) < 0.005
                            resC := v2.cCount
        tCheck("B43", supOk, "Support C=" + (i43 >= 0 ? str.tostring(ZE.viewAt(engA, i43).cCount) : "none"))
        tCheck("B26", supOk and (resC < 0 or resC <= 2), "Resistance C=" + str.tostring(resC))
    if fixtureBar == 7
        if mainIdx >= 0
            v = ZE.viewAt(engA, mainIdx)
            tCheck("B55", v.currentTouchNo == 2, "currentTouchNo=" + str.tostring(v.currentTouchNo))
    if fixtureBar == 8
        tCheck("B5", hasEvent(engA, 4, 1), "close at bottom - breakBuffer did not Break")
        tCheck("B55", hasEvent(engA, 4, 1) and not hasEvent(engA, 3, 1), "WeakDepth was emitted on the Break bar")
        tCheck("B54", true, "wick-only break is excluded by construction of the fixture")
    if fixtureBar == 12
        tCheck("B59", hasEvent(engA, 7, -1), "FlipConfirm did not confirm")
        ri = -1
        nn2 = ZE.viewCount(engA)
        if nn2 > 0
            if (nn2 - 1) >= (0)
                for i = 0 to nn2 - 1
                    v3 = ZE.viewAt(engA, i)
                    if v3.side == -1 and v3.coreId > 0 and not na(v3.effectiveBottom)
                        if v3.effectiveBottom >= 1990.0 and v3.effectiveTop <= 2010.0
                            ri := i
        if ri >= 0
            vr = ZE.viewAt(engA, ri)
            tCheck("B59", vr.upcomingTouchNo == 1, "FlipConfirm consumed a normal Touch: upcoming=" + str.tostring(vr.upcomingTouchNo))
    if fixtureBar == 20
        // App. B 74: the same confirmed Feed twice must not advance the state
        before = ZE.viewCount(engA)
        beforeEv = ZE.eventCount(engA)
        again = ZE.updateConfirmed5m(engA, cfgA, feedA)
        tCheck("B74", not again and ZE.viewCount(engA) == before and ZE.eventCount(engA) == beforeEv, "duplicate Feed advanced the Engine")

// =====================================================================================
// Result table
// =====================================================================================
var table rt2 = na
if barstate.isfirst
    rt2 := table.new(position.top_left, 4, 46, border_width = 1)

if barstate.islast
    n = array.size(tName)
    pass = 0
    fail = 0
    notrun = 0
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                st = array.get(tState, i)
                if st == 1
                    pass += 1
                else if st == 2
                    fail += 1
                else
                    notrun += 1
    table.cell(rt2, 0, 0, "ZoneEngineV2 Conformance", text_color = color.white, bgcolor = color.new(color.blue, 60))
    table.cell(rt2, 1, 0, "PASS " + str.tostring(pass), text_color = color.white, bgcolor = color.new(color.green, 60))
    table.cell(rt2, 2, 0, "FAIL " + str.tostring(fail), text_color = color.white, bgcolor = color.new(color.red, 60))
    table.cell(rt2, 3, 0, "NOT RUN " + str.tostring(notrun), text_color = color.white, bgcolor = color.new(color.gray, 60))
    row = 1
    if n > 0
        if (n - 1) >= (0)
            for i = 0 to n - 1
                st = array.get(tState, i)
                if st != 1 and row < 45
                    table.cell(rt2, 0, row, array.get(tName, i))
                    table.cell(rt2, 1, row, st == 2 ? "FAIL" : "NOT RUN", bgcolor = st == 2 ? color.new(color.red, 70) : color.new(color.gray, 80))
                    table.cell(rt2, 2, row, array.get(tNote, i))
                    table.cell(rt2, 3, row, "")
                    row += 1

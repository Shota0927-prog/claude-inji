zeDD = input.source(close, "FIB 日足 方向", group = G_ZE)
zeDI = input.source(close, "FIB 日足 波ID", group = G_ZE)
zeDS = input.source(close, "FIB 日足 状態", group = G_ZE)
zeDT = input.source(close, "FIB 日足 更新確定時刻", group = G_ZE)

var string G_ZF = "02f · ZF FVG / iFVG"
zfUse1 = input.bool(false, "1H FVG", group = G_ZF)
zfUse2 = input.bool(false, "4H FVG", group = G_ZF)
zfUse3 = input.bool(false, "日足 FVG", group = G_ZF)
zfUse4 = input.bool(false, "週足 FVG", group = G_ZF)
zfMinW = input.float(3.0, "FVG 最小幅 ($)", minval = 0.0, step = 0.5, group = G_ZF,
     tooltip = "上昇: low > high[2] / 下降: high < low[2]、幅 (mintick 正規化) >= この値。Zone = FVG 本来の上下限。\n" +
     "その時間足の確定終値で反対端を抜けたら iFVG、iFVG を確定終値で逆方向に抜けたら無効。日数による失効なし。")

var string G_ZG = "02g · ZG ダブル / トリプル トップ・ボトム (1H / 4H / D)"
zgUse1  = input.bool(true, "1時間足: Strategy で利用", group = G_ZG, inline = "zgu1",

// ============================================================================
//  Zone Combo Lab XAU (LAB-1)  —  XAUUSD 5分足・「Zone 種類 × エントリータイミング」検証用 Strategy
//  仕様: ZoneComboLabXAU_Spec (2026-11-01 整理分)。通常版 (ZoneStrategyXAU / ZoneEnginePracticalXAUUSD / AccumStrategyXAU /
//  MtfPocDetector) は変更しない。Library / Engine は import しない (検知式は下の「写し」を持つ)。
//
//  判定の順序: Zone 検知 → 接触 (待機) → タイミング成立 → 共通の売買処理。Strong / Weak・加点は使わない。
//
//  ■ Zone (初回対象。種類・時間足ごとに ON / OFF)
//    ZA アキュム 1H / 4H / D : AccumStrategyXAU の Accum 検出 (f_acAccumBoxCore / f_acAccumBoxState / f_acConfirmed) をそのまま使い、
//       形成終了で固定した上辺・下辺をそれぞれ Zone (辺 ± 共通幅) にする。【変更】Keep Count・有効期限による削除を撤去。
//    ZB MA : 1分足 EMA3000 / 5分足 EMA3000 (帯 = EMA ± 共通幅。毎足動く)。【変更】1分 EMA2000/3000 → 1分 EMA3000 + 5分 EMA3000。
//    ZC 水平線 1H / 4H / D / W : Swing 高安 (Library pivotPack + NR-S1 の確定取得、左右 6 本が初期値・時間足ごとに変更可)。
//       【変更】新しい Pivot はすべて別の Zone として登録 (近い価格の既存 Zone で抑制も上書きもしない。同じ Pivot は時刻キーで 1 回)。
//       【変更】5分 / 15分 / 1H → 1H / 4H / D / W。当日高安・前日高安は対象外。寿命による削除なし。
//    ZD 出来高 1H / 4H / D / W : MtfPocDetector (75 分割版) の f_pocCore をそのまま使う。帯 = POC 中心 ± 共通幅。
//       元の最大出来高区画の上下限は情報として保持。POC が変わるたびに別の Zone として追加し、過去の帯を置き換えない
//       (同じ時間足に中心が完全に同じ POC Zone があれば重ねて登録しない)。
//    ZF FVG 1H / 4H / D / W : Batch A の f_fvgConfirmed (最小幅 3) をそのまま使い、FVG 本来の上下限を Zone にする (共通幅なし)。
//       【変更】同じ時間足の確定終値で反対端を抜けたら iFVG (反転)、iFVG を同じ時間足の確定終値で逆方向に抜けたら無効 (削除)。
//       Batch A の完全埋め削除・寿命・TF ごと 5 件の上限は撤去。D / W を追加。
//    共通幅 (初期 中心から上下 6 ドル) は ZA / ZB / ZC / ZD。日数・件数・世代数による有効 Zone の削除はしない。
//
//  ■ タイミング (5分足・確定足)
//    TA FVG 吸収: AccumStrategyXAU ACC-5A の FVG 形成・監視・吸収をそのまま使う。上昇 FVG の陰線吸収 = SHORT、
//       下降 FVG の陽線吸収 = LONG。【変更】P5 / P6 への紐付けを共通の Zone 待機へ置き換え、吸収後の有効期限 5 → 12 本。
//    TC SATS 反発: ZoneStrategyXAU の f_satBand (原文) と f_satHist (接触 → 終値の戻り、近接・陽線陰線・接触記録 Nc は既存の設定)。
//       【変更】Entry A〜D の準備条件から切り離し、反発の成立足 = 0 本目として有効期限 12 本のタイミング部品にする。
//       4H・1H が両方逆方向なら見送るフィルターは切替を残し初期 OFF。
//    各タイミングの成立足 = 0 本目、有効期限まで有効。AND = 有効期間が重なって全部揃う (同じ足に限定しない) / OR = どれか。
//    接触前に成立したタイミングは使わない (接触と同じ足は使う)。
//
//  ■ 接触・待機
//    ヒゲを含む高値〜安値が帯に触れたら接触。最後に接触した足 = 0 本目、12 本目まで待機 (再接触で毎回更新、SL 基準の帯も更新)。
//    帯より上 / 下にある価格 (直近の帯の外側の終値) から方向を決める: 帯の下から接触 = SHORT 待機、上から = LONG 待機。
//    SHORT 待機中の終値の上抜け / LONG 待機中の終値の下抜けでその方向の待機を解除 (Zone 自体は消さない)。
//    上抜けた Zone へ上から戻って接触 = サポレジ転換 LONG。上抜け後に終値が下限を下抜けて戻る = ダマシ SHORT の待機開始
//    (ダマシの判定期限は初期 0 = 無期限。接触後の待機期限 12 本とは別の入力)。下方向は上下反転。
//
//  ■ 組み合わせ・競合
//    OR = 選んだ種類のどれかの Zone / AND = 選んだ種類の Zone が実際に重なっている区間への接触が必要。
//    「含む」= 他種類が重なっていても可 / 「だけ」= 待機の帯 (AND は選んだ帯全体) に他種類の有効 Zone が少しでも重なれば除外。
//    同じ方向の候補は現在価格に最も近い Zone を優先。LONG / SHORT が同時に有効ならその足は見送り (候補は期限内なら保持)。
//    保有中に成立した候補は、待機・タイミングの両方の期限内なら決済後へ持ち越す (期限の時計は止めない)。
//    発注した待機とその Zone を含む待機、使ったタイミングは消費 (同じ Zone は決済後の新しい接触・新しいタイミングで再エントリー可)。
//
//  ■ 売買 (ZoneStrategyXAU / AccumStrategyXAU の処理を流用)
//    確定 5分足で判定、次の 5分足始値で成行。SL / TP はエントリーと同時に置く。最大 1 ポジション。
//    初期 SL = 接触時の Zone 全体の外側 + 5 ドル (AND は選んだ帯全体の外側)。発注後は建値移動以外で動かさない。
//    数量: 元金 300,000 円 × 3 % の単利。f_qty (ACC = ZoneStrategyXAU f_stQty と同じ式、0.01 lot 切り捨て)。
//    新規エントリーは日本時間 09:00〜翌 02:00 (判断足の time_close)。決済・TP 更新・建値は時間外も継続。
//    TP: 利益方向の抵抗 Zone (重なりは 1 つに統合、エントリー条件に選ばない種類も使う) の近い順に TP1 / TP2 / TP3
//    (LONG = 上側 Zone の下限 / SHORT = 下側 Zone の上限)。分割利確 60 / 20 / 20 % (目標 2 つ = 60 / 40、1 つ = 100、
//    0 = 固定 RR 1.5)・選択した TP で全決済・固定 RR を切替。保有中も確定足ごとに TP を更新。TP1 までの RR 1.0 未満は見送り。
//    建値: 固定幅 15 ドル / TP1 (エントリー時点) までの値幅の割合 50 %。確定足で判定。建値後ロックは初期 OFF。
//
//  ■ 集計 (取引台帳)
//    分割決済を合算して 1 エントリー〜全決済を 1 取引。0〜1,000 円 = 建値、1,000 円超 = 勝ち、マイナス = 負け。
//    勝率 = 勝ち / (勝ち + 負け)。平均 R・PF・DD は実際の損益 (微益を 0 に書き換えない)。1R = 実約定価格・初期 SL・実数量。
//    最大 DD は含み損益を含む資産ベース (確定足の不利な側の高値 / 安値で評価)。条件別の内訳は 1 取引を複数の区分に数えても
//    全体では 1 回。Strategy Tester 標準の件数 / 勝率 (分割決済ごとに 1 件) とは別。
//
//  ★ TradingView 実機でのコンパイル・バックテスト・再読み込み比較は未実施 (tests/lab_sim.py はロジック区間の変換実行)。
// ============================================================================

//@version=5
strategy(
     title                   = "Zone Combo Lab XAU",
     shorttitle              = "ZCL-XAU",
     overlay                 = true,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     process_orders_on_close = false,
     pyramiding              = 0,
     initial_capital         = 300000,
     currency                = currency.JPY,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     max_bars_back           = 1100,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500)

// ---- 5分足専用 ----------------------------------------------------------------
bool is5mChart = timeframe.isminutes and timeframe.multiplier == 5

// ============================================================================
// 01. INPUTS
// ============================================================================
var string G_PR = "01 · 検証期間"
prUse   = input.bool(false, "期間を指定する", group = G_PR,
     tooltip = "ON: 判断足の時刻が [開始, 終了) の中だけ新規エントリーする (決済・TP・建値は期間外も継続)。OFF: 全期間。")
prStart = input.time(timestamp("2024-01-01T00:00:00+09:00"), "開始", group = G_PR)
prEnd   = input.time(timestamp("2100-01-01T00:00:00+09:00"), "終了 (含まない)", group = G_PR)

var string G_ZW = "02 · Zone 共通"
zHalf = input.float(6.0, "共通の価格帯幅 (中心から上下 $)", minval = 0.0, step = 0.5, group = G_ZW,
     tooltip = "ZA / ZB / ZC / ZD の帯 = 中心 ± この値 (全幅はこの 2 倍)。ZF (FVG) は本来の上下限を使う。")

var string G_ZA = "02a · ZA アキュム (1H / 4H / D)"
zaUse1 = input.bool(true, "1H アキュム", group = G_ZA)
zaUse2 = input.bool(true, "4H アキュム", group = G_ZA)
zaUse3 = input.bool(true, "日足 アキュム", group = G_ZA,
     tooltip = "形成終了で上辺・下辺を固定した 5分足で登録し、次の足から接触に使う。上辺・下辺は別々の Zone。")

var string G_ACCP = "02 · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ZB = "02b · ZB MA (EMA)"
zbUse1 = input.bool(true, "1分足 EMA", group = G_ZB)
zbLen1 = input.int(3000, "1分足 EMA 本数", minval = 1, group = G_ZB)
zbUse2 = input.bool(true, "5分足 EMA", group = G_ZB)
zbLen2 = input.int(3000, "5分足 EMA 本数", minval = 1, group = G_ZB,
     tooltip = "帯 = EMA ± 共通幅 (毎足動く)。EMA が na (本数不足) の間は Zone を作らない。")

var string G_ZC = "02c · ZC 水平線 (Swing 高安)"
zcUse1 = input.bool(true, "1H Swing", group = G_ZC)
zcPiv1 = input.int(6, "1H 左右の本数", minval = 1, group = G_ZC)
zcUse2 = input.bool(true, "4H Swing", group = G_ZC)
zcPiv2 = input.int(6, "4H 左右の本数", minval = 1, group = G_ZC)
zcUse3 = input.bool(true, "日足 Swing", group = G_ZC)
zcPiv3 = input.int(6, "日足 左右の本数", minval = 1, group = G_ZC)
zcUse4 = input.bool(true, "週足 Swing", group = G_ZC)
zcPiv4 = input.int(6, "週足 左右の本数", minval = 1, group = G_ZC,
     tooltip = "ta.pivothigh / pivotlow (右側の本数が確定してから)。上位足は確定した足だけ (上位足の中で [1]・lookahead_on)。")

var string G_ZD = "02d · ZD 出来高 POC (MTF POC Detector 75 分割版)"
zdUse1 = input.bool(true, "1H POC", group = G_ZD)
zdLen1 = input.int(120, "1H 集計本数", minval = 10, maxval = 1000, group = G_ZD)
zdUse2 = input.bool(true, "4H POC", group = G_ZD)
zdLen2 = input.int(120, "4H 集計本数", minval = 10, maxval = 1000, group = G_ZD)
zdUse3 = input.bool(true, "日足 POC", group = G_ZD)
zdLen3 = input.int(120, "日足 集計本数", minval = 10, maxval = 1000, group = G_ZD)
zdUse4 = input.bool(true, "週足 POC", group = G_ZD)
zdLen4 = input.int(120, "週足 集計本数", minval = 10, maxval = 1000, group = G_ZD)
vpBins = input.int(75, "VP ビン数 (分割数)", minval = 4, maxval = 100, group = G_ZD,
     tooltip = "MtfPocDetector と同じ計算 (各時間足の確定足までの集計本数・分割数)。帯 = POC 中心 ± 共通幅。\n" +
     "元の最大出来高区画の上下限は Zone の情報として保持する。未計算 (na) の POC は Zone にしない。")

var string G_ZF = "02f · ZF FVG / iFVG"
zfUse1 = input.bool(true, "1H FVG", group = G_ZF)
zfUse2 = input.bool(true, "4H FVG", group = G_ZF)
zfUse3 = input.bool(true, "日足 FVG", group = G_ZF)
zfUse4 = input.bool(true, "週足 FVG", group = G_ZF)
zfMinW = input.float(3.0, "FVG 最小幅 ($)", minval = 0.0, step = 0.5, group = G_ZF,
     tooltip = "上昇: low > high[2] / 下降: high < low[2]、幅 (mintick 正規化) >= この値。Zone = FVG 本来の上下限。\n" +
     "その時間足の確定終値で反対端を抜けたら iFVG、iFVG を確定終値で逆方向に抜けたら無効。日数による失効なし。")

var string G_TA = "03a · TA 5分足 FVG 吸収 (ACC-5A)"
fvMinW    = input.float(1.0, "FVG 最小幅 ($)", minval = 0.0, step = 0.1, group = G_TA)
fvLife    = input.int(10, "FVG 形成後の有効期限 (本)", minval = 0, group = G_TA,
     tooltip = "形成足 = 0 本目。この本数目まで吸収可能。方向ごとに最新の未吸収 FVG を 1 つだけ監視。")
fvAbsLife = input.int(12, "吸収後の有効期限 (本)", minval = 0, group = G_TA,
     tooltip = "吸収足 = 0 本目。この本数目までタイミングとして有効 (ACC-5A の 5 本から変更)。")

var string G_TC = "03c · TC 5分足 SATS 反発"
stSatsNear  = input.bool(true, "SATS · 近接を接触扱い", group = G_TC)
stSatsNearD = input.float(1.0, "SATS · 近接許容距離 ($)", minval = 0.0, step = 0.5, group = G_TC)
stSatsBody  = input.bool(true, "SATS · 反発確認足の陽線／陰線を要求", group = G_TC)
stSatsNowC  = input.int(1, "SATS · 接触→反発の有効本数", minval = 0, step = 1, group = G_TC,
     tooltip = "既存 (XA-19) の接触記録の寿命 Nc。LINE1 / LINE2 / STB (足 t-1 の確定値) への接触と終値の戻りを反発とする。")
tcLife = input.int(12, "反発後の有効期限 (本)", minval = 0, group = G_TC,
     tooltip = "反発の成立足 = 0 本目。この本数目までタイミングとして有効。")
tcFilt = input.bool(false, "4H・1H が両方逆方向なら TC を使わない", group = G_TC,
     tooltip = "既存 XA-13 の逆方向一致 (4H・1H)。LONG は両方赤、SHORT は両方青のとき、その足は TC を不成立として扱う。")

var string G_EN = "04 · エントリー条件 (Zone 種類 × タイミング)"
cZA = input.bool(true, "条件 · ZA アキュム", group = G_EN, inline = "cz1")
cZB = input.bool(true, "ZB MA", group = G_EN, inline = "cz1")
cZC = input.bool(true, "ZC 水平線", group = G_EN, inline = "cz1")
cZD = input.bool(true, "条件 · ZD POC", group = G_EN, inline = "cz2")
cZF = input.bool(true, "ZF FVG", group = G_EN, inline = "cz2")
cComb  = input.string("OR", "種類の結合", options = ["OR", "AND"], group = G_EN,
     tooltip = "OR: 選んだ種類のどれかの Zone への接触。AND: 選んだ種類の Zone が実際に重なっている区間への接触 (1 種類だけなら OR と同じ)。")
cScope = input.string("含む", "範囲", options = ["含む", "だけ"], group = G_EN,
     tooltip = "含む: 他種類の有効 Zone が重なっていても可。だけ: 待機の帯 (AND は選んだ帯全体) に他種類の有効 Zone が少しでも重なれば除外。")
cTA = input.bool(true, "タイミング · TA FVG 吸収", group = G_EN, inline = "ct")
cTC = input.bool(true, "TC SATS 反発", group = G_EN, inline = "ct")
cTim = input.string("OR", "タイミングの結合", options = ["OR", "AND"], group = G_EN,
     tooltip = "AND: 選んだタイミングの有効期間が重なって全部揃う (同じ足に限定しない)。OR: どれか。")
catReb  = input.bool(true, "反発", group = G_EN, inline = "cat")
catFake = input.bool(true, "ダマシ", group = G_EN, inline = "cat")
catRole = input.bool(true, "サポレジ転換", group = G_EN, inline = "cat")
fakeWin = input.int(0, "ダマシ判定の期限 (突破後の本数、0 = 無期限)", minval = 0, group = G_EN,
     tooltip = "初期 0 = 無期限: 直前の突破と逆方向へ終値で抜けて戻ったらダマシ。1 以上: 突破後この本数以内だけダマシ、超えた後の逆方向の突破は新しい突破。\n" +
     "接触後の待機期限 (12 本) とは別。")
waitBars = input.int(12, "待機期限 (最後の接触から本数)", minval = 0, group = G_EN,
     tooltip = "最後に接触した足 = 0 本目。この本数目まで待機。再接触で更新。")

var string G_RK = "05 · SL / TP"
slBuf   = input.float(5.0, "SL · Zone の外側 + ($)", minval = 0.0, step = 0.5, group = G_RK)
maxSlOn = input.bool(false, "最大 SL 距離を使う", group = G_RK)
maxSl   = input.float(40.0, "最大 SL 距離 ($、以上は見送り)", minval = 0.0, step = 0.5, group = G_RK)
tpMode  = input.string("分割利確", "TP 方式", options = ["分割利確", "選択した TP で全決済", "固定 RR"], group = G_RK)
tpSel   = input.int(1, "全決済に使う TP (1〜3)", minval = 1, maxval = 3, group = G_RK,
     tooltip = "「選択した TP で全決済」: この番号の目標 (無ければ存在する最も遠い目標、目標 0 なら固定 RR)。")
tpW1    = input.float(60.0, "分割 · TP1 (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_RK)
tpW2    = input.float(20.0, "分割 · TP2 (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_RK)
tpW3    = input.float(20.0, "分割 · TP3 (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_RK,
     tooltip = "元の全数量に対する割合。目標 2 つ = TP1 で TP1 の割合・TP2 で残り全部、1 つ = 100 %、0 = 固定 RR で全決済。\n" +
     "各段の数量 = 累積割合 × 全 lot を lot 刻みで四捨五入した累積の差 (総数量は増えない・0 の段は注文なし)、最後の段で残り全部。")
fixRR   = input.float(1.5, "固定 RR", minval = 0.1, step = 0.1, group = G_RK)
minRR1  = input.float(1.0, "TP1 までの最低 RR (未満は見送り)", minval = 0.0, step = 0.1, group = G_RK)
tpNtf   = input.float(5.0, "TP 変更通知の幅 ($)", minval = 0.0, step = 0.5, group = G_RK,
     tooltip = "最後に通知した価格から、いずれかの TP がこの値以上動いたら TP1〜3 を 1 通で通知。TP 到達・部分利確は別通知。")

var string G_BE = "06 · 建値"
beOn    = input.bool(true, "建値移動", group = G_BE)
beMode  = input.string("固定幅", "建値の方式", options = ["固定幅", "TP1 割合"], group = G_BE)
beDist  = input.float(15.0, "固定幅 ($)", minval = 0.0, step = 0.5, group = G_BE)
beRatio = input.float(50.0, "TP1 割合 (%)", minval = 1.0, maxval = 100.0, step = 5.0, group = G_BE,
     tooltip = "基準 = エントリー時点の TP1 (後の TP 更新に連動しない)。確定 5分足で判定し、次の足から有効。")
beLock  = input.bool(false, "建値決済後のロック", group = G_BE,
     tooltip = "ON: 建値ストップで決済されたら、決済直前の最終 TP (残っていた最寄りの段) または初期 SL に届くまで新規エントリーしない。\n" +
     "解除は決済を確認した次の足から判定・解除した足はまだ禁止。禁止中の足では待機を残さない (BEL-1 / BEL-2 と同じ)。")

var string G_SE = "07 · 新規エントリーの時間帯"
seUse    = input.bool(true, "時間帯で新規エントリーを制限", group = G_SE)
seTz     = input.string("Asia/Tokyo", "Session Timezone", group = G_SE)
seStartH = input.int(9, "Start Hour", minval = 0, maxval = 23, group = G_SE)
seStartM = input.int(0, "Start Minute", minval = 0, maxval = 59, group = G_SE)
seEndH   = input.int(2, "End Hour (含まない)", minval = 0, maxval = 23, group = G_SE)
seEndM   = input.int(0, "End Minute", minval = 0, maxval = 59, group = G_SE)

var string G_MM = "08 · 資金管理 (単利・損失予算)"
mmCapBase = input.float(300000.0, "元金基準額 (円)", minval = 0.0, step = 10000.0, group = G_MM)
mmRiskPct = input.float(3.0, "損失率 (%)", minval = 0.0, step = 0.1, group = G_MM)
mmLotOz   = input.float(100.0, "1 lot のオンス数", minval = 0.0001, step = 1.0, group = G_MM)
mmLotMin  = input.float(0.01, "最小 lot", minval = 0.0001, step = 0.01, group = G_MM)
mmLotStep = input.float(0.01, "lot 刻み", minval = 0.0001, step = 0.01, group = G_MM)

var string G_ST = "09 · 集計"
stBeBand = input.float(1000.0, "建値扱いの上限 (円)", minval = 0.0, step = 100.0, group = G_ST,
     tooltip = "1 取引の合計損益が 0 円以上この値以下 = 建値、超 = 勝ち、マイナス = 負け。")

var string G_DS = "10 · 表示 (売買・内部保持数には影響しない)"
dsZone    = input.bool(true, "Zone の帯を表示", group = G_DS)
dsZoneMax = input.int(80, "表示する Zone の最大数", minval = 1, maxval = 400, group = G_DS)
dsEnt     = input.bool(true, "エントリーラベルを表示", group = G_DS)
dsEntMax  = input.int(50, "エントリーラベルの最大数", minval = 1, maxval = 200, group = G_DS)
dsTbl     = input.bool(true, "集計表を表示", group = G_DS)

// ============================================================================
// 02. FEEDS (確定した上位足だけ。ロジック区間からは履歴参照しない)
// ============================================================================
// ---- ZA: AccumStrategyXAU の Accum 検出 (byte 一致・tests/lab_sim.py が照合) ----
// ==== LAB Accum copy (begin) =================================================
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== LAB Accum copy (end) ===================================================

f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

// ---- ZB: EMA (1分足は 1分足の close で計算した値 = ZoneStrategyXAU の maPack 取得と同じ方式。5分足はチャート足) ----
float zbMa1 = request.security(syminfo.tickerid, "1", ta.ema(close, zbLen1), lookahead = barmerge.lookahead_off)
float zbMa2 = ta.ema(close, zbLen2)

// ---- ZC: Swing (Library pivotPack の式 + NR-S1 f_nrsPivotConfirmed の [1]・lookahead_on) ----
f_lbPivotConfirmed(simple int len) =>
    float _ph = ta.pivothigh(high, len, len)
    float _pl = ta.pivotlow(low,  len, len)
    int   _pt = na(_ph) ? int(na) : time
    int   _lt = na(_pl) ? int(na) : time
    [_ph[1], _pt[1], _pl[1], _lt[1]]

[s1h, s1ht, s1l, s1lt] = request.security(syminfo.tickerid, "60",  f_lbPivotConfirmed(zcPiv1), lookahead = barmerge.lookahead_on)
[s2h, s2ht, s2l, s2lt] = request.security(syminfo.tickerid, "240", f_lbPivotConfirmed(zcPiv2), lookahead = barmerge.lookahead_on)
[s3h, s3ht, s3l, s3lt] = request.security(syminfo.tickerid, "D",   f_lbPivotConfirmed(zcPiv3), lookahead = barmerge.lookahead_on)
[s4h, s4ht, s4l, s4lt] = request.security(syminfo.tickerid, "W",   f_lbPivotConfirmed(zcPiv4), lookahead = barmerge.lookahead_on)

// ---- ZD: POC (MtfPocDetector 75 分割版の f_pocCore をそのまま。tests/lab_sim.py が照合) ----
// ==== LAB POC copy (begin) ===================================================
f_pocCore(bool enabled, int off, int lookback, int bins) =>
    float poc = na
    float pUp = na
    float pLo = na
    if enabled and lookback > 0 and bins > 0 and bar_index - off >= lookback
        float hi = na
        float lo = na
        bool  ok = true
        for k = off to off + lookback - 1
            float h = high[k]
            float l = low[k]
            float v = volume[k]
            if na(h) or na(l) or na(v)
                ok := false
                break
            hi := na(hi) ? h : math.max(hi, h)
            lo := na(lo) ? l : math.min(lo, l)
        float rangeAll = ok ? hi - lo : na
        if ok and rangeAll > 0
            array<float> bv = array.new_float(bins, 0.0)
            float bs = rangeAll / bins
            float total = 0.0
            for k = off to off + lookback - 1
                float ch = high[k]
                float cl = low[k]
                float cv = volume[k]
                total += cv
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    for bi = 0 to bins - 1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
            if total > 0
                float best  = -1.0
                int   bestI = 0
                for bi = 0 to bins - 1
                    float bvv = array.get(bv, bi)
                    if bvv > best
                        best  := bvv
                        bestI := bi
                pLo := lo + bestI * bs
                pUp := pLo + bs
                poc := (pUp + pLo) / 2.0
    [poc, pUp, pLo]
// ==== LAB POC copy (end) =====================================================

//  MtfPocDetector f_htfCalc と同じ取得 (1 本前 = 確定済みの上位足までで計算 + lookahead_on)。
//  【変更】timeframe.main_period (v6) のガードは、チャート足が 5分足固定・要求先がすべて上位足のため省略 (enabled のみ)。
f_lbPocHtf(bool enabled, int lookback, int bins) =>
    [pc, up, lo] = f_pocCore(enabled, 1, lookback, bins)
    [pc, up, lo]

[d1c, d1u, d1l] = request.security(syminfo.tickerid, "60",  f_lbPocHtf(zdUse1, zdLen1, vpBins), lookahead = barmerge.lookahead_on)
[d2c, d2u, d2l] = request.security(syminfo.tickerid, "240", f_lbPocHtf(zdUse2, zdLen2, vpBins), lookahead = barmerge.lookahead_on)
[d3c, d3u, d3l] = request.security(syminfo.tickerid, "D",   f_lbPocHtf(zdUse3, zdLen3, vpBins), lookahead = barmerge.lookahead_on)
[d4c, d4u, d4l] = request.security(syminfo.tickerid, "W",   f_lbPocHtf(zdUse4, zdLen4, vpBins), lookahead = barmerge.lookahead_on)

// ---- ZF: FVG (ZoneStrategyXAU FVG Batch A の f_fvgConfirmed をそのまま) ----
// ==== LAB FVG copy (begin) ===================================================
f_fvgConfirmed(float minWidth) =>
    bool  _bull = low > high[2]
    bool  _bear = high < low[2]
    float _top  = _bull ? low : _bear ? low[2] : na
    float _bot  = _bull ? high[2] : _bear ? high : na
    int   _dir  = (_bull or _bear) and math.round_to_mintick(_top - _bot) >= minWidth ? (_bull ? 1 : -1) : 0
    [time[1], time_close[1], close[1], _dir[1], _top[1], _bot[1]]
// ==== LAB FVG copy (end) =====================================================

[g1k, g1kc, g1c, g1d, g1t, g1b] = request.security(syminfo.tickerid, "60",  f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g2k, g2kc, g2c, g2d, g2t, g2b] = request.security(syminfo.tickerid, "240", f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g3k, g3kc, g3c, g3d, g3t, g3b] = request.security(syminfo.tickerid, "D",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g4k, g4kc, g4c, g4d, g4t, g4b] = request.security(syminfo.tickerid, "W",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)

// ---- TC: SATS (ZoneStrategyXAU の f_satBand = tests/sats_src/f_satBand.txt をそのまま) ----
// ==== LAB SATS copy (begin) ==================================================
f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]
// ==== LAB SATS copy (end) ====================================================

[satL1, satL2, satStb, satD1, satD2, satSD, satBand, satBasis, satCommon, satAtr, satA1, satA2] = f_satBand()

f_satTfState() =>
    [l1, l2, sb, d1, d2, sd, st, b, cm, at, a1, a2] = f_satBand()
    int s = (na(l1) or na(l2) or na(sb)) ? na : st
    s[1]
int satTf4 = request.security(syminfo.tickerid, "240", f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf1 = request.security(syminfo.tickerid, "60",  f_satTfState(), lookahead = barmerge.lookahead_on)

// ---- 5分足の確定済みの値 (ロジック区間は履歴参照しないため、ここで取り出す) ----
float labC1 = close[1]      // TA FVG の中央足 / TC の前足終値 / 接触の範囲 (前の終値)
float labO1 = open[1]
float labH2 = high[2]
float labL2 = low[2]
float labS1 = satL1[1]      // TC: 足 t の判定に使う足 t-1 の確定線
float labS2 = satL2[1]
float labS3 = satStb[1]
bool  labRangeOK = not prUse or (time >= prStart and time < prEnd)

// ============================================================================
// 03. LOGIC
// ============================================================================
// ==== LAB Logic (begin) ======================================================
//  (この区間は tests/lab_sim.py が Python へ機械変換して実行する。na の算術・比較は使わない)
float EPS = 1e-7

// Zone 1 個。typ: 0 ZA / 1 ZB / 2 ZC / 3 ZD / 4 ZF。tf: ZA 0 1H / 1 4H / 2 D、ZB 0 1分 / 1 5分、ZC・ZD・ZF 0 1H / 1 4H / 2 D / 3 W
type LbZone
    int   id
    int   typ
    int   tf
    int   sub                 // ZA 1 上辺 / -1 下辺、ZC 1 高値 / -1 安値、ZF 1 上昇 FVG / -1 下降 FVG、他 0
    float ctr
    float bot
    float top
    float infoA               // ZD: 元の最大出来高区画の下限 / ZA: Accum の下辺
    float infoB               // ZD: 元の区画の上限 / ZA: Accum の上辺
    int   key                 // ZA Accum ID / ZC Pivot 時刻 / ZF 形成足の時刻
    int   aBar                // 登録した 5分足 (次の足から接触)
    int   aTime
    int   pos      = 0        // 帯の外側の最後の終値: -1 下 / 1 上 / 0 未定
    int   brk      = 0        // 直近の突破: 1 上抜け / -1 下抜け / 0 なし
    int   brkBar   = 0
    bool  inv      = false    // ZF: iFVG
    bool  dead     = false    // ZF: 無効
    box   bx

// 形成中の Accum (固定したら Zone にして外す)
type LbAcc
    int   tf
    int   aid
    float up
    float lo

// 待機 1 個 (Zone の組 × 方向)。OR は Zone 1 個、AND は重なった Zone の組
type LbWait
    int    id
    string key                // Zone ID を昇順に "|" で連結
    int    side               // 1 LONG / -1 SHORT
    int    cat                // 1 反発 / 2 ダマシ / 3 サポレジ転換 (作った時の代表)
    bool   cReb   = false     // 組の各 Zone の区分 (ON / OFF の判定用)
    bool   cFake  = false
    bool   cRole  = false
    int    tmask              // 種類のマスク (2^typ の和)
    array<int> ids
    float  cBot               // 接触した区間 (OR = 帯 / AND = 重なり)。最後の接触時
    float  cTop
    float  eBot               // SL 基準の帯全体 (最後の接触時のスナップショット)
    float  eTop
    int    sBar               // 連続した待機の最初の接触足
    int    lBar               // 最後の接触足
    string desc

// タイミング 1 個 (成立足 = 0 本目)
type LbTev
    int    id
    int    kind               // 1 TA / 2 TC
    int    side
    int    eBar
    bool   used   = false
    string desc

// TA: 監視中の 5分足 FVG (ACC-5A AcFvg と同じ)
type LbFvg
    int   id
    int   dir                 // 1 = 上昇 FVG (SHORT 吸収用) / -1 = 下降 FVG (LONG 吸収用)
    int   fBar
    float lo
    float hi

// 候補 (確定足の中だけ)
type LbCand
    int    wi                 // 待機の位置
    int    side
    float  sl
    float  slw
    float  tp1
    float  rr
    float  qty
    float  dist
    int    ia     = -1        // 使う TA の位置
    int    ic     = -1        // 使う TC の位置
    int    omask  = 0
    int    nT     = 0         // 判断時の TP 目標の数

// 注文 / ポジション (1 つ) と取引台帳の作業域
type LbOrd
    int    state    = 0       // 0 なし / 1 entry 発注済み / 2 保有中 / 3 不正な出口のため決済中
    int    n        = 0
    string id       = ""
    int    side     = 0
    float  ref
    float  sl                 // 初期 SL
    float  stop               // 現在の stop (初期 SL / 建値)
    bool   be       = false
    float  fill
    int    lotN     = 0       // 全数量 (lot 刻みの個数)
    float  lotQ               // lot 刻み 1 個の TradingView 数量
    int    closedLots = 0
    int    stage    = 0       // 利確で完了した最後の段 (1〜3)
    int    bar
    float  tp1E               // 建値の割合方式の基準 (エントリー時点の TP1)
    bool   tp1Fix   = false   // エントリー時点の TP1 が固定 RR (約定後に実約定価格で計算し直す)
    array<float> legPx        // 段 1〜3 の利確価格 (na = 注文なし)
    array<int>   legLots
    array<float> ntfPx        // 段ごとの最後に通知した TP
    int    tmask
    int    omask
    bool   cReb     = false
    bool   cFake    = false
    bool   cRole    = false
    int    tim      = 0       // 1 TA / 2 TC / 3 両方
    string desc
    float  pnl      = 0.0
    int    nTp      = 0
    bool   lastStop = false
    float  lastTp             // 建値ロック用: 決済直前に残っていた最寄りの段の TP
    label  lbl

// 状態・集計の作業域 (関数から更新するもの)
type LbSt
    int   zSeq     = 0
    int   wSeq     = 0
    int   tSeq     = 0
    int   fvSeq    = 0
    float maxW     = 0.0      // lbZs の最大の帯幅 (区間検索の範囲。= 共通幅 × 2)
    float maxWF    = 0.0      // lbFvgs の最大の帯幅
    float realized = 0.0      // 実現損益 (円・この Strategy の取引の合計)
    float peak
    float maxDD    = 0.0
    float maxDDPct = 0.0
    int   iter     = 0        // この足の Zone 走査数
    int   maxIter  = 0
    int   maxWaits = 0
    int   maxTevs  = 0
    int   maxCombo = 0
    int   nTrades  = 0
    int   nTpHit   = 0
    int   nBE      = 0
    int   nBadExit = 0
    int   nQtyAnom = 0
    int   nIfvg    = 0
    int   nFvgDead = 0
    int   nTouch   = 0
    int   nCancel  = 0
    int   nFake    = 0
    int   nWaitNew = 0
    int   nWaitExp = 0
    int   nTA      = 0
    int   nTC      = 0
    int   nCand    = 0
    int   nConflict = 0
    int   nHoldSkip = 0
    int   nLockClr = 0
    int   nTpNtf   = 0
    int   ctSeen   = 0

var LbOrd o  = LbOrd.new(legPx = array.new_float(3, na), legLots = array.new_int(3, 0), ntfPx = array.new_float(3, na))
var LbSt  st = LbSt.new()
var array<LbZone> lbZs   = array.new<LbZone>()     // 帯の幅が共通幅の静的 Zone (ZA / ZC / ZD)。下限の昇順。削除しない
var array<LbZone> lbFvgs = array.new<LbZone>()     // ZF (本来の上下限・幅はさまざま)。下限の昇順。iFVG の再突破でだけ削除
var LbZone lbMa1 = na                               // ZB 1分足 EMA
var LbZone lbMa2 = na                               // ZB 5分足 EMA
var array<LbAcc>  lbAccs = array.new<LbAcc>()      // 形成中の Accum
var array<int>    lbAccLast = array.new_int(3, na)  // 時間足ごとに前回届いた Accum ID
var array<int>    lbPivLastH = array.new_int(4, na)
var array<int>    lbPivLastL = array.new_int(4, na)
var array<float>  lbPocLast  = array.new_float(4, na)
var array<int>    lbFvgLast  = array.new_int(4, na)
var array<int>    lbNZone    = array.new_int(5, 0)   // 種類ごとの保持数 (ZB は 0〜2)
var array<LbWait> lbWaits = array.new<LbWait>()
var array<LbTev>  lbTevs  = array.new<LbTev>()
var LbFvg lbFvUp = na                               // TA: 監視中の上昇 FVG
var LbFvg lbFvDn = na
var array<LbZone> lbBoxZ = array.new<LbZone>()      // 表示中の帯の Zone (表示件数の上限で古い表示から消す。Zone は残す)
var array<label>  lbLbls  = array.new<label>()
var int hTqL1 = na                                  // TC: 接触記録 (f_satHist と同じ)
var int hTqL2 = na
var int hTqL3 = na
var int hTqS1 = na
var int hTqS2 = na
var int hTqS3 = na
// 取引台帳の区分別集計 (0 全体 / 1〜5 含む ZA〜ZF / 6〜10 だけ ZA〜ZF / 11 TA / 12 TC / 13 反発 / 14 ダマシ / 15 サポレジ / 16 LONG / 17 SHORT)
var array<int>   bkN   = array.new_int(18, 0)
var array<int>   bkW   = array.new_int(18, 0)
var array<int>   bkL   = array.new_int(18, 0)
var array<int>   bkBE  = array.new_int(18, 0)
var array<float> bkGP  = array.new_float(18, 0.0)
var array<float> bkGL  = array.new_float(18, 0.0)
var array<float> bkR   = array.new_float(18, 0.0)
var array<float> bkNet = array.new_float(18, 0.0)
// 候補の見送り理由 (タイミング成立後): 0 区分 OFF / 1 だけ (他種類の重なり) / 2 SL / 3 RR / 4 時間帯 / 5 期間 / 6 数量
var array<int>   skipN = array.new_int(7, 0)
// 建値ロック (BEL-1)
var bool  lkOn   = false
var int   lkSide = 0
var float lkSL   = na
var float lkTP   = na
var int   lkBar  = na
// 再計算設定の保護 (ACC-2)
varip int lbExecBar = -1
varip int lbExecN   = 0

f_pow2(int b) =>
    b == 0 ? 1 : b == 1 ? 2 : b == 2 ? 4 : b == 3 ? 8 : 16

f_bit(int m, int b) =>
    math.floor(m / f_pow2(b)) % 2 == 1

f_typName(int t) =>
    t == 0 ? "ZA" : t == 1 ? "ZB" : t == 2 ? "ZC" : t == 3 ? "ZD" : "ZF"

f_tfName(int t, int k) =>
    t == 0 ? (k == 0 ? "1H" : k == 1 ? "4H" : "D") : t == 1 ? (k == 0 ? "1m" : "5m") : (k == 0 ? "1H" : k == 1 ? "4H" : k == 2 ? "D" : "W")

f_catName(int c) =>
    c == 1 ? "反発" : c == 2 ? "ダマシ" : "サポレジ"

f_zaUse(int k) =>
    k == 0 ? zaUse1 : k == 1 ? zaUse2 : zaUse3

f_zbUse(int k) =>
    k == 0 ? zbUse1 : zbUse2

f_zcUse(int k) =>
    k == 0 ? zcUse1 : k == 1 ? zcUse2 : k == 2 ? zcUse3 : zcUse4

f_zdUse(int k) =>
    k == 0 ? zdUse1 : k == 1 ? zdUse2 : k == 2 ? zdUse3 : zdUse4

f_zfUse(int k) =>
    k == 0 ? zfUse1 : k == 1 ? zfUse2 : k == 2 ? zfUse3 : zfUse4

f_condTyp(int t) =>
    t == 0 ? cZA : t == 1 ? cZB : t == 2 ? cZC : t == 3 ? cZD : cZF

f_zName(LbZone z) =>
    string s = f_typName(z.typ) + " " + f_tfName(z.typ, z.tf)
    if z.typ == 0
        s := s + (z.sub == 1 ? " 上辺" : " 下辺")
    if z.typ == 2
        s := s + (z.sub == 1 ? " 高値" : " 安値")
    if z.typ == 4
        s := s + (z.inv ? " iFVG" : z.sub == 1 ? " 上昇FVG" : " 下降FVG")
    s + " #" + str.tostring(z.id)

// 開始時刻を含み、終了時刻を含まない (開始 == 終了 は終日)。AccumStrategyXAU と同じ
f_inSession(int t) =>
    int mins = hour(t, seTz) * 60 + minute(t, seTz)
    int s    = seStartH * 60 + seStartM
    int e    = seEndH * 60 + seEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)

// 数量 (AccumStrategyXAU f_qty = ZoneStrategyXAU f_stQty と同じ式)
f_qty(int side, float ref, float sl) =>
    float budget = mmCapBase * mmRiskPct / 100.0
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = budget > 0 ? strategy.convert_to_symbol(budget) : na
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and mmLotOz > 0 and mmLotStep > 0 and mmLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * mmLotOz * mmLotStep) + 1e-9)
        if n * mmLotStep * mmLotOz * dist > budSym
            n := n - 1
        if n >= 1 and n * mmLotStep >= mmLotMin * (1 - 1e-9)
            q := n * mmLotStep * mmLotOz / pv
    q

// TC: ZoneStrategyXAU の f_satHist と同じ (【変更】close[1] → labC1 = 前の 5分足の確定終値。ロジック区間は履歴参照しないため)
f_satHist(int side, float L, int q) =>
    bool ok    = not na(L) and not na(labC1)
    bool hit   = ok and low <= L and L <= high
    bool near  = ok and stSatsNear and (side == 1 ? (low > L and low - L <= stSatsNearD) : (high < L and L - high <= stSatsNearD))
    bool fresh = ok and (side == 1 ? labC1 > L : labC1 < L)
    bool live  = not na(q) and bar_index - q <= stSatsNowC
    bool tch   = (hit or near) and fresh
    bool rA    = tch and (side == 1 ? close > L : close < L)
    bool rB    = live and ok and (side == 1 ? (labC1 <= L and close > L) : (labC1 >= L and close < L))
    bool body  = not stSatsBody or (side == 1 ? close > open : close < open)
    bool reb   = (rA or rB) and body
    int  qUse  = live ? q : bar_index
    int  qNext = reb ? na : live ? q : tch ? bar_index : na
    [reb, qUse, qNext]

// ---- 静的 Zone の索引 (下限の昇順。共通幅の Zone と FVG を分け、区間検索の範囲をそれぞれの最大幅で決める) ----
// 下限が x 以上の最初の位置
f_lbLower(array<LbZone> a, float x) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = math.floor((lo + hi) / 2)
        LbZone zm = array.get(a, mid)
        if zm.bot < x
            lo := mid + 1
        else
            hi := mid
    lo

f_lbAdd(LbZone z) =>
    array<LbZone> arr = z.typ == 4 ? lbFvgs : lbZs
    int i = f_lbLower(arr, z.bot)
    array.insert(arr, i, z)
    if z.typ == 4
        st.maxWF := math.max(st.maxWF, z.top - z.bot)
    else
        st.maxW := math.max(st.maxW, z.top - z.bot)
    array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) + 1)
    if dsZone
        color c = z.typ == 0 ? color.teal : z.typ == 2 ? color.orange : z.typ == 3 ? color.purple : color.green
        z.bx := box.new(bar_index, z.top, bar_index + 1, z.bot, border_color = color.new(c, 40), bgcolor = color.new(c, 88),
             extend = extend.right, text = f_zName(z), text_size = size.tiny, text_color = color.new(c, 20))
        array.push(lbBoxZ, z)
        if array.size(lbBoxZ) > dsZoneMax
            LbZone oz = array.shift(lbBoxZ)
            box.delete(oz.bx)
            oz.bx := na
    true

// ZF の削除 (無効化)。共通幅の Zone は削除しない
f_lbRemove(LbZone z) =>
    int i = f_lbLower(lbFvgs, z.bot)
    int n = array.size(lbFvgs)
    bool done = false
    while i < n and not done
        LbZone q = array.get(lbFvgs, i)
        if q.id == z.id
            array.remove(lbFvgs, i)
            done := true
        else if q.bot > z.bot
            done := true
        i += 1
    if done
        array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) - 1)
    done

f_lbNew(int typ, int tf, int sub, float ctr, float bot, float top, float a, float b, int key) =>
    st.zSeq += 1
    LbZone z = LbZone.new(st.zSeq, typ, tf, sub, ctr, bot, top, a, b, key, bar_index, time)
    z.pos := close > top + EPS ? 1 : close < bot - EPS ? -1 : 0
    z

// 静的 Zone で [a, b] と重なるものの中に、種類・時間足・副種別・中心が条件に合うものがあるか
f_lbDup(int typ, int tf, int sub, float price) =>
    bool r = false
    float a = price - zHalf
    float b = price + zHalf
    int n = array.size(lbZs)
    int i = f_lbLower(lbZs, a - st.maxW - EPS)
    while i < n and not r
        LbZone z = array.get(lbZs, i)
        if z.bot > b + EPS
            break
        if z.typ == typ and z.tf == tf and z.sub == sub and z.ctr == price
            r := true
        i += 1
    r

// Accum を固定 → 上辺・下辺の Zone を登録
f_lbAccFix(LbAcc q) =>
    f_lbAdd(f_lbNew(0, q.tf, 1, q.up, q.up - zHalf, q.up + zHalf, q.lo, q.up, q.aid))
    f_lbAdd(f_lbNew(0, q.tf, -1, q.lo, q.lo - zHalf, q.lo + zHalf, q.lo, q.up, q.aid))
    true

// 確定足 1 本の Zone の状態更新。戻り値 [接触の方向 (0 なし), 区分, 待機を解除する方向 (0 なし)]
f_lbStep(LbZone z) =>
    bool tch = low <= z.top + EPS and high >= z.bot - EPS
    int  np  = close > z.top + EPS ? 1 : close < z.bot - EPS ? -1 : 0
    int  cs  = 0
    int  cc  = 0
    int  xs  = 0
    if np != 0 and z.pos != 0 and np != z.pos
        // 終値で帯を抜けた: 反対側の待機を解除 (上抜け → SHORT / 下抜け → LONG)。期限内に直前の突破と逆へ抜けて戻った = ダマシ
        xs := -np
        if z.brk == -np and (fakeWin == 0 or bar_index - z.brkBar <= fakeWin)
            cs    := np
            cc    := 2
            z.brk := 0
        else
            z.brk    := np
            z.brkBar := bar_index
        z.pos := np
    else
        if np != 0 and z.pos == 0
            z.pos := np
        if tch and z.pos != 0
            cs := z.pos == -1 ? -1 : 1
            cc := (cs == -1 and z.brk == -1) or (cs == 1 and z.brk == 1) ? 3 : 1
    [cs, cc, xs]

f_waitHas(LbWait w, int zid) =>
    bool r = false
    int n = array.size(w.ids)
    if n > 0
        for i = 0 to n - 1
            if array.get(w.ids, i) == zid
                r := true
    r

// 待機の作成 / 更新 (同じ組・同じ方向があれば最後の接触足と帯のスナップショットを更新)
f_lbUnit(int side, int cat, bool cr, bool cf, bool co, array<int> ids, string key, int tmask, float cb, float ct, float eb, float et, string desc) =>
    int found = -1
    int n = array.size(lbWaits)
    if n > 0
        for i = 0 to n - 1
            LbWait w = array.get(lbWaits, i)
            if w.side == side and w.key == key
                found := i
                break
    if found >= 0
        LbWait w = array.get(lbWaits, found)
        w.lBar := bar_index
        w.cBot := cb
        w.cTop := ct
        w.eBot := eb
        w.eTop := et
    else
        st.wSeq += 1
        st.nWaitNew += 1
        array.push(lbWaits, LbWait.new(st.wSeq, key, side, cat, cr, cf, co, tmask, ids, cb, ct, eb, et, bar_index, bar_index, desc))
    found < 0

// 他種類 (tmask に含まれない種類) の有効 Zone で [a, b] と重なるものの種類マスク
f_lbOthers(float a, float b, int tmask) =>
    int m = 0
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, a - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > b + EPS
                break
            if z.top >= a - EPS and not f_bit(tmask, z.typ) and not f_bit(m, z.typ)
                m += f_pow2(z.typ)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k) and not f_bit(tmask, 1) and not f_bit(m, 1)
            if mz.bot <= b + EPS and mz.top >= a - EPS
                m += 2
    m

// ---- TP: 利益方向の抵抗 Zone を重なりで統合した帯の近い順 ----
// 区間の挿入 (LONG = 下限の昇順 / SHORT = 上限の降順)
f_lbIns(array<float> ib, array<float> it, float b, float t, int side) =>
    int n = array.size(ib)
    int i = 0
    bool go = true
    while i < n and go
        if side == 1 ? array.get(ib, i) > b : array.get(it, i) < t
            go := false
        else
            i += 1
    array.insert(ib, i, b)
    array.insert(it, i, t)
    true

// 区間を重なりで統合した帯。戻り値 [近い側の端 (TP 価格), 遠い側の端]
f_lbClu(array<float> ib, array<float> it, int side) =>
    array<float> nearE = array.new_float()
    array<float> farE  = array.new_float()
    int n = array.size(ib)
    float cn = na
    float cf = na
    if n > 0
        for i = 0 to n - 1
            float b = array.get(ib, i)
            float t = array.get(it, i)
            if na(cn)
                cn := side == 1 ? b : t
                cf := side == 1 ? t : b
            else if side == 1 ? b <= cf + EPS : t >= cf - EPS
                cf := side == 1 ? math.max(cf, t) : math.min(cf, b)
            else
                array.push(nearE, cn)
                array.push(farE, cf)
                cn := side == 1 ? b : t
                cf := side == 1 ? t : b
        array.push(nearE, cn)
        array.push(farE, cf)
    [nearE, farE]

// 既に 3 つの帯が確定し、次の Zone (端 edge) がそれに届かない
f_lbDone(array<float> ib, array<float> it, int side, float edge) =>
    [ne, fe] = f_lbClu(ib, it, side)
    bool r = false
    if array.size(fe) >= 4
        r := true
    else if array.size(fe) == 3
        float f3 = array.get(fe, 2)
        r := side == 1 ? edge > f3 + EPS : edge < f3 - EPS
    r

// TP 候補 (最大 3)。LONG = ref より厳密に上の Zone の下限 / SHORT = 下の Zone の上限。全種類 (条件に選ばない種類も) を使う
f_lbTargets(int side, float ref) =>
    array<float> ib = array.new_float()
    array<float> it = array.new_float()
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if (side == 1 and mz.bot > ref + EPS) or (side == -1 and mz.top < ref - EPS)
                f_lbIns(ib, it, mz.bot, mz.top, side)
    // 2 つの索引を下限の順に合わせて走査 (LONG = 昇順 / SHORT = 降順)。残りの Zone が 3 つ目の帯に届かなくなったら止める
    int nA = array.size(lbZs)
    int nB = array.size(lbFvgs)
    int ia = side == 1 ? f_lbLower(lbZs, ref + EPS) : f_lbLower(lbZs, ref - EPS) - 1
    int ig = side == 1 ? f_lbLower(lbFvgs, ref + EPS) : f_lbLower(lbFvgs, ref - EPS) - 1
    bool go = true
    while go
        LbZone za = na
        LbZone zg = na
        if ia >= 0 and ia < nA
            za := array.get(lbZs, ia)
        if ig >= 0 and ig < nB
            zg := array.get(lbFvgs, ig)
        if na(za) and na(zg)
            go := false
        else
            bool  takeA = false
            float edge  = na
            if na(zg)
                takeA := true
                edge  := side == 1 ? za.bot : za.bot + st.maxW
            else if na(za)
                edge  := side == 1 ? zg.bot : zg.bot + st.maxWF
            else
                takeA := side == 1 ? za.bot <= zg.bot : za.bot >= zg.bot
                edge  := side == 1 ? math.min(za.bot, zg.bot) : math.max(za.bot + st.maxW, zg.bot + st.maxWF)
            if f_lbDone(ib, it, side, edge)
                go := false
            else
                LbZone z = takeA ? za : zg
                if not z.dead and (side == 1 ? z.bot > ref + EPS : z.top < ref - EPS)
                    f_lbIns(ib, it, z.bot, z.top, side)
                if takeA
                    ia += side == 1 ? 1 : -1
                else
                    ig += side == 1 ? 1 : -1
    [ne, fe] = f_lbClu(ib, it, side)
    array<float> tps = array.new_float()
    int m = math.min(3, array.size(ne))
    if m > 0
        for j = 0 to m - 1
            array.push(tps, array.get(ne, j))
    tps

f_legId(int n, int k) =>
    "X" + str.tostring(n) + "_" + str.tostring(k)

// 利確の段の計画 (o.legPx / o.legLots を作り直す。完了した段は変えない)。ref: 目標を探す基準価格、base: 固定 RR の基準
f_lbPlan(float ref, float base) =>
    array<float> tps = tpMode == "固定 RR" ? array.new_float() : f_lbTargets(o.side, ref)
    int nT = array.size(tps)
    for k = 0 to 2
        array.set(o.legPx, k, na)
        array.set(o.legLots, k, 0)
    int rem = o.lotN - o.closedLots
    int s0  = o.stage
    if rem > 0 and s0 < 3
        if tpMode == "分割利確" and nT > 0
            int   m    = math.min(nT, 3 - s0)
            int   prev = o.closedLots
            float cumW = 0.0
            for k = 1 to 3
                if k <= s0
                    cumW += k == 1 ? tpW1 : k == 2 ? tpW2 : tpW3
            for j = 0 to m - 1
                int stg = s0 + j + 1
                cumW += stg == 1 ? tpW1 : stg == 2 ? tpW2 : tpW3
                int cum = j == m - 1 ? o.lotN : math.min(o.lotN, math.floor(cumW / 100.0 * o.lotN + 0.5))     // 累積を四捨五入
                int q   = cum - prev
                if q > 0
                    array.set(o.legPx, stg - 1, array.get(tps, j))
                    array.set(o.legLots, stg - 1, q)
                    prev := cum
        else if tpMode == "選択した TP で全決済" and nT > 0
            array.set(o.legPx, s0, array.get(tps, math.min(tpSel, nT) - 1))
            array.set(o.legLots, s0, rem)
        else
            array.set(o.legPx, s0, base + o.side * fixRR * math.abs(base - o.sl))
            array.set(o.legLots, s0, rem)
    nT

// 計画した段の注文を出す (同じ ID = 変更)。計画にない段は取り消す
f_lbIssue() =>
    for k = 1 to 3
        string xid = f_legId(o.n, k)
        int    q   = array.get(o.legLots, k - 1)
        if q > 0
            strategy.exit(xid, o.id, qty = q * o.lotQ, stop = o.stop, limit = array.get(o.legPx, k - 1))
        else
            strategy.cancel(xid)
    true

// 最寄りの残りの段の TP (建値ロックの目標)
f_lbNextTp() =>
    float r = na
    for k = 1 to 3
        if na(r) and array.get(o.legLots, k - 1) > 0
            r := array.get(o.legPx, k - 1)
    r

f_lbTpText() =>
    string s = ""
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            s := s + " TP" + str.tostring(k) + " " + str.tostring(array.get(o.legPx, k - 1), "#.##") +
                 " (" + str.tostring(array.get(o.legLots, k - 1) * mmLotStep, "#.##") + " lot)"
    s

// TP 変更の通知: 最後に通知した価格から、いずれかの段が通知幅以上動いたら全段を 1 通で通知
f_lbNotify(bool force) =>
    bool chg = force
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            float lp = array.get(o.ntfPx, k - 1)
            if na(lp)
                chg := true
            else if math.abs(array.get(o.legPx, k - 1) - lp) >= tpNtf - EPS
                chg := true
    if chg
        for k = 1 to 3
            array.set(o.ntfPx, k - 1, array.get(o.legLots, k - 1) > 0 ? array.get(o.legPx, k - 1) : na)
        if not force
            st.nTpNtf += 1
            alert("ZCL TP 変更 " + o.id + ":" + f_lbTpText() + " / SL " + str.tostring(o.stop, "#.##"), alert.freq_once_per_bar_close)
    chg

// 決済 1 件 (分割を含む) の記帳
f_lbOnExit(int i) =>
    string xid = strategy.closedtrades.exit_id(i)
    float  px  = strategy.closedtrades.exit_price(i)
    float  pf  = strategy.closedtrades.profit(i)
    int    lots = int(math.round(math.abs(strategy.closedtrades.size(i)) / o.lotQ))
    o.pnl        += pf
    st.realized  += pf
    o.closedLots += lots
    bool isTp = false
    for k = 1 to 3
        if xid == f_legId(o.n, k)
            float lp = array.get(o.legPx, k - 1)
            if not na(lp) and o.side * (px - lp) >= -EPS
                isTp := true
                o.stage := math.max(o.stage, k)
    if isTp
        o.nTp    += 1
        st.nTpHit += 1
        alert("ZCL TP 到達 " + o.id + " " + xid + " " + str.tostring(px, "#.##") + " (" + str.tostring(lots * mmLotStep, "#.##") + " lot)", alert.freq_once_per_bar_close)
    else
        o.lastStop := true
    isTp

f_lbBk(int b, float pnl, float r) =>
    array.set(bkN, b, array.get(bkN, b) + 1)
    if pnl > stBeBand
        array.set(bkW, b, array.get(bkW, b) + 1)
    else if pnl < 0
        array.set(bkL, b, array.get(bkL, b) + 1)
    else
        array.set(bkBE, b, array.get(bkBE, b) + 1)
    if pnl > 0
        array.set(bkGP, b, array.get(bkGP, b) + pnl)
    if pnl < 0
        array.set(bkGL, b, array.get(bkGL, b) - pnl)
    array.set(bkR, b, array.get(bkR, b) + r)
    array.set(bkNet, b, array.get(bkNet, b) + pnl)
    true

// 1 取引の確定 (全決済の後)。台帳は取引 ID ごとに 1 回、区分別は属する区分すべてへ
f_lbFinalize() =>
    float rJpy = strategy.convert_to_account(math.abs(o.fill - o.sl) * o.lotN * o.lotQ * syminfo.pointvalue)
    float r    = rJpy > 0 ? o.pnl / rJpy : 0.0
    f_lbBk(0, o.pnl, r)
    for t = 0 to 4
        if f_bit(o.tmask, t)
            f_lbBk(1 + t, o.pnl, r)
            if o.tmask == f_pow2(t) and o.omask == 0
                f_lbBk(6 + t, o.pnl, r)
    if o.tim == 1 or o.tim == 3
        f_lbBk(11, o.pnl, r)
    if o.tim == 2 or o.tim == 3
        f_lbBk(12, o.pnl, r)
    if o.cReb
        f_lbBk(13, o.pnl, r)
    if o.cFake
        f_lbBk(14, o.pnl, r)
    if o.cRole
        f_lbBk(15, o.pnl, r)
    f_lbBk(o.side == 1 ? 16 : 17, o.pnl, r)
    st.nTrades += 1
    if not na(o.lbl)
        label.set_text(o.lbl, label.get_text(o.lbl) + "\n決済 合計 " + str.tostring(o.pnl, "#") + " 円 (" + str.tostring(r, "#.##") + "R)")
    r

// タイミング: 方向・種類が合い、未使用・待機の開始以後・有効期限内の最新の位置 (-1 = なし)
f_lbTim(int kind, int side, int sBar) =>
    int r  = -1
    int rb = -1
    bool filt = kind == 2 and tcFilt and (side == 1 ? (satTf4 == -1 and satTf1 == -1) : (satTf4 == 1 and satTf1 == 1))
    int n = array.size(lbTevs)
    if n > 0 and not filt
        for i = 0 to n - 1
            LbTev e = array.get(lbTevs, i)
            int life = kind == 1 ? fvAbsLife : tcLife
            if e.kind == kind and e.side == side and not e.used and e.eBar >= sBar and bar_index - e.eBar <= life and e.eBar > rb
                r  := i
                rb := e.eBar
    r

bool lbRun  = is5mChart
bool sessOK = not seUse or f_inSession(time_close)

if lbRun
    // ---- 再計算設定の保護 (ACC-2): ヒストリカルの足は確定時の 1 回だけ実行される前提
    if barstate.ishistory
        if lbExecBar == bar_index
            lbExecN += 1
        else
            lbExecBar := bar_index
            lbExecN   := 1
        if lbExecN > 1
            runtime.error("ZCL: ヒストリカルの同じ足でスクリプトが 2 回以上実行されました。プロパティの「再計算: 注文約定後」などを OFF にしてください。")

if lbRun and barstate.isconfirmed
    st.iter := 0
    // BEL-1: 前の確定足までに始まったロックは、この足の高値・安値が目標 / 初期 SL に届いたら解除 (解除した足はまだ禁止)
    bool lkBlk = lkOn
    if lkOn and bar_index > lkBar and (lkSide == 1 ? (high >= lkTP or low <= lkSL) : (low <= lkTP or high >= lkSL))
        lkOn := false

    // ---- (A) 約定・決済の確認 (分割決済の記帳 → 約定 → 全決済で取引を確定) ----------------------------
    int ct = strategy.closedtrades
    if ct > st.ctSeen
        for i = st.ctSeen to ct - 1
            if strategy.closedtrades.entry_id(i) == o.id
                f_lbOnExit(i)
        st.ctSeen := ct
    bool opn = false
    int  ot  = strategy.opentrades
    if ot > 0
        opn := strategy.opentrades.entry_id(ot - 1) == o.id
    if o.state == 1
        if opn
            o.fill  := strategy.opentrades.entry_price(ot - 1)
            o.state := 2
            if math.abs(math.abs(strategy.position_size) - o.lotN * o.lotQ) > o.lotN * o.lotQ * 1e-6
                st.nQtyAnom += 1
            if o.side * (o.fill - o.sl) <= 0
                // 約定ずれで初期 SL が約定価格の反対側: 出口注文を出さず成行で決済 (ACC と同じ)
                for k = 1 to 3
                    strategy.cancel(f_legId(o.n, k))
                strategy.close(o.id)
                o.state := 3
                st.nBadExit += 1
            else if o.tp1Fix
                // 約定を確認: 固定 RR の TP1 (建値の割合方式の基準) は実約定価格から計算し直す。TP の注文は (B5) で計画し直す
                o.tp1E := o.fill + o.side * fixRR * math.abs(o.fill - o.sl)
        else if o.closedLots > 0
            // 約定した足の中で全決済まで終わった
            o.fill  := strategy.closedtrades.entry_price(ct - 1)
            o.state := 2
        else if bar_index > o.bar
            strategy.cancel(o.id)
            for k = 1 to 3
                strategy.cancel(f_legId(o.n, k))
            o.state := 0
    if o.state >= 2 and not opn
        // 全決済: 建値ストップでの決済ならロック (BEL-1)
        if beLock and o.be and o.lastStop and o.state == 2 and not na(o.lastTp)
            lkOn   := true
            lkSide := o.side
            lkSL   := o.sl
            lkTP   := o.lastTp
            lkBar  := bar_index
            lkBlk  := true
        f_lbFinalize()
        o.state := 0

    // 管理中の注文 ID 以外の建玉があれば停止 (ACC-2)
    if strategy.opentrades > 0
        string otId = strategy.opentrades.entry_id(strategy.opentrades - 1)
        if otId != o.id
            runtime.error("ZCL: 管理外の建玉 " + otId + " を検出しました (管理中 " + o.id + ")。プロパティの再計算設定を確認してください。")

    // ---- (B1) 確定した上位足の値から Zone を登録 / 更新 --------------------------------------------
    // ZA: 新しい ID = 前回届いた ID と違う (未固定が残っていれば固定)。同じ ID は形成中に上下限を更新し、形成中フラグ 0 で固定
    array<float> fU = array.from(f1u, f2u, f3u)
    array<float> fL = array.from(f1l, f2l, f3l)
    array<int>   fI = array.from(f1i, f2i, f3i)
    array<int>   fA = array.from(f1a, f2a, f3a)
    for k = 0 to 2
        int   aid = array.get(fI, k)
        float u   = array.get(fU, k)
        float l   = array.get(fL, k)
        if f_zaUse(k) and not na(aid) and not na(u) and not na(l)
            bool forming = array.get(fA, k) == 1
            int  last    = array.get(lbAccLast, k)
            if na(last) or aid != last
                array.set(lbAccLast, k, aid)
                int na0 = array.size(lbAccs)
                if na0 > 0
                    for i = na0 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k
                            f_lbAccFix(q)
                            array.remove(lbAccs, i)
                LbAcc b = LbAcc.new(k, aid, u, l)
                if forming
                    array.push(lbAccs, b)
                else
                    f_lbAccFix(b)
            else
                int na1 = array.size(lbAccs)
                if na1 > 0
                    for i = na1 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k and q.aid == aid
                            q.up := u
                            q.lo := l
                            if not forming
                                f_lbAccFix(q)
                                array.remove(lbAccs, i)
    // ZC: 新しい Pivot (時刻キーが前回と違う) はすべて登録 (近い価格の既存 Zone で抑制・上書きしない)
    array<float> pH  = array.from(s1h, s2h, s3h, s4h)
    array<int>   pHt = array.from(s1ht, s2ht, s3ht, s4ht)
    array<float> pL  = array.from(s1l, s2l, s3l, s4l)
    array<int>   pLt = array.from(s1lt, s2lt, s3lt, s4lt)
    for k = 0 to 3
        if f_zcUse(k)
            for s = 0 to 1
                float pv = s == 0 ? array.get(pH, k) : array.get(pL, k)
                int   pt = s == 0 ? array.get(pHt, k) : array.get(pLt, k)
                int   lt = s == 0 ? array.get(lbPivLastH, k) : array.get(lbPivLastL, k)
                if not na(pt) and not na(pv) and (na(lt) or pt != lt)
                    if s == 0
                        array.set(lbPivLastH, k, pt)
                    else
                        array.set(lbPivLastL, k, pt)
                    int sub = s == 0 ? 1 : -1
                    f_lbAdd(f_lbNew(2, k, sub, pv, pv - zHalf, pv + zHalf, na, na, pt))
    // ZD: POC が変わったら新しい Zone (過去の帯は残す。同じ時間足に中心が完全に同じ Zone があれば登録しない)
    array<float> dC = array.from(d1c, d2c, d3c, d4c)
    array<float> dU = array.from(d1u, d2u, d3u, d4u)
    array<float> dL = array.from(d1l, d2l, d3l, d4l)
    for k = 0 to 3
        float pc = array.get(dC, k)
        float lp = array.get(lbPocLast, k)
        if f_zdUse(k) and not na(pc) and (na(lp) or pc != lp)
            array.set(lbPocLast, k, pc)
            if not f_lbDup(3, k, 0, pc)
                f_lbAdd(f_lbNew(3, k, 0, pc, pc - zHalf, pc + zHalf, array.get(dL, k), array.get(dU, k), na))
    // ZF: 新しい上位足 (キー = 形成足の時刻): 既存 FVG / iFVG を確定終値で判定 → 新しい FVG を登録
    array<int>   gK = array.from(g1k, g2k, g3k, g4k)
    array<float> gC = array.from(g1c, g2c, g3c, g4c)
    array<int>   gD = array.from(g1d, g2d, g3d, g4d)
    array<float> gT = array.from(g1t, g2t, g3t, g4t)
    array<float> gB = array.from(g1b, g2b, g3b, g4b)
    array<int>   deadIds = array.new_int()
    for k = 0 to 3
        int key = array.get(gK, k)
        int lk  = array.get(lbFvgLast, k)
        if f_zfUse(k) and not na(key) and (na(lk) or key != lk)
            array.set(lbFvgLast, k, key)
            float hc = array.get(gC, k)
            int nf = array.size(lbFvgs)
            if nf > 0 and not na(hc)
                for i = nf - 1 to 0
                    LbZone z = array.get(lbFvgs, i)
                    if z.tf == k and z.key < key
                        if not z.inv
                            if (z.sub == 1 and hc < z.bot) or (z.sub == -1 and hc > z.top)
                                z.inv := true
                                st.nIfvg += 1
                                if not na(z.bx)
                                    box.set_text(z.bx, f_zName(z))
                        else if (z.sub == 1 and hc > z.top) or (z.sub == -1 and hc < z.bot)
                            z.dead := true
                            st.nFvgDead += 1
                            f_lbRemove(z)
                            array.push(deadIds, z.id)
                            if not na(z.bx)
                                box.set_bgcolor(z.bx, color.new(color.gray, 92))
                                box.set_extend(z.bx, extend.none)
                                box.set_right(z.bx, bar_index)
            int   gd = array.get(gD, k)
            float gt = array.get(gT, k)
            float gb = array.get(gB, k)
            if not na(gd) and gd != 0 and not na(gt) and not na(gb)
                f_lbAdd(f_lbNew(4, k, gd, (gt + gb) / 2.0, gb, gt, na, na, key))
    // ZB: EMA ± 共通幅 (毎足動く)。最初に値が出た足で作り、次の足から接触
    for k = 0 to 1
        float mv = k == 0 ? zbMa1 : zbMa2
        if f_zbUse(k) and not na(mv)
            LbZone mz = k == 0 ? lbMa1 : lbMa2
            if na(mz)
                LbZone nz0 = f_lbNew(1, k, 0, mv, mv - zHalf, mv + zHalf, na, na, na)
                array.set(lbNZone, 1, array.get(lbNZone, 1) + 1)
                if k == 0
                    lbMa1 := nz0
                else
                    lbMa2 := nz0
            else
                mz.ctr := mv
                mz.bot := mv - zHalf
                mz.top := mv + zHalf

    // ---- (B2) 接触・突破 (この足と前の終値の範囲に掛かる Zone だけ。範囲外の Zone の状態は変わらない) ----------
    array<LbZone> cZ    = array.new<LbZone>()
    array<int>    cSide = array.new_int()
    array<int>    cCat  = array.new_int()
    array<int>    xId   = array.new_int()
    array<int>    xSide = array.new_int()
    float rLo = na(labC1) ? low : math.min(labC1, low)
    float rHi = na(labC1) ? high : math.max(labC1, high)
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int nz1 = array.size(arr)
        int iz  = f_lbLower(arr, rLo - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while iz < nz1
            LbZone z = array.get(arr, iz)
            if z.bot > rHi + EPS
                break
            st.iter += 1
            if z.top >= rLo - EPS and z.aBar < bar_index
                [cs, cc, xs] = f_lbStep(z)
                if cs != 0
                    array.push(cZ, z)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, z.id)
                    array.push(xSide, xs)
            iz += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if mz.aBar < bar_index
                [cs, cc, xs] = f_lbStep(mz)
                if cs != 0
                    array.push(cZ, mz)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, mz.id)
                    array.push(xSide, xs)
    st.maxIter := math.max(st.maxIter, st.iter)
    st.nTouch  += array.size(cZ)

    // ---- (B3) 待機: 突破による解除 / 無効化した Zone → 期限 → 作成・更新 -----------------------------------
    int nw0 = array.size(lbWaits)
    if nw0 > 0
        for i = nw0 - 1 to 0
            LbWait w = array.get(lbWaits, i)
            bool drop = false
            int nx = array.size(xId)
            if nx > 0
                for j = 0 to nx - 1
                    if array.get(xSide, j) == w.side and f_waitHas(w, array.get(xId, j))
                        drop := true
            int nd = array.size(deadIds)
            if nd > 0
                for j = 0 to nd - 1
                    if f_waitHas(w, array.get(deadIds, j))
                        drop := true
            if drop
                array.remove(lbWaits, i)
                st.nCancel += 1
            else if bar_index - w.lBar > waitBars
                array.remove(lbWaits, i)
                st.nWaitExp += 1
    int nSel = (cZA ? 1 : 0) + (cZB ? 1 : 0) + (cZC ? 1 : 0) + (cZD ? 1 : 0) + (cZF ? 1 : 0)
    int nc0  = array.size(cZ)
    if nc0 > 0
        for j = 0 to nc0 - 1
            st.nFake += array.get(cCat, j) == 2 ? 1 : 0
    if nc0 > 0 and (cComb == "OR" or nSel <= 1)
        for j = 0 to nc0 - 1
            LbZone z = array.get(cZ, j)
            if f_condTyp(z.typ)
                int cc = array.get(cCat, j)
                f_lbUnit(array.get(cSide, j), cc, cc == 1, cc == 2, cc == 3, array.from(z.id), str.tostring(z.id), f_pow2(z.typ),
                     z.bot, z.top, z.bot, z.top, f_zName(z) + " " + f_catName(cc))
    else if nc0 > 0
        // AND: 選んだ種類ごとの接触 Zone の全組合せ (方向が同じ・重なりがあり・この足が重なりに接触したもの)
        array<int> tl = array.new_int()
        for t = 0 to 4
            if f_condTyp(t)
                array.push(tl, t)
        int nt = array.size(tl)
        array<int> cnt = array.new_int(nt, 0)
        bool allHave = true
        for a = 0 to nt - 1
            int c = 0
            for j = 0 to nc0 - 1
                LbZone z = array.get(cZ, j)
                if z.typ == array.get(tl, a)
                    c += 1
            array.set(cnt, a, c)
            if c == 0
                allHave := false
        if allHave
            array<int> od = array.new_int(nt, 0)
            bool more = true
            int combos = 0
            while more
                combos += 1
                // od[a] 番目の (種類 a の) 接触を取り出す
                array<int> pick = array.new_int()
                for a = 0 to nt - 1
                    int want = array.get(od, a)
                    int seen = 0
                    for j = 0 to nc0 - 1
                        LbZone z = array.get(cZ, j)
                        if z.typ == array.get(tl, a)
                            if seen == want
                                array.push(pick, j)
                            seen += 1
                int   s0 = array.get(cSide, array.get(pick, 0))
                bool  sameSide = true
                float ob = na
                float ot2 = na
                float eb = na
                float et = na
                int   cat0 = array.get(cCat, array.get(pick, 0))
                bool  cr = false
                bool  cf = false
                bool  co = false
                int   tm = 0
                array<int> ids = array.new_int()
                string desc = ""
                for a = 0 to nt - 1
                    int j = array.get(pick, a)
                    LbZone z = array.get(cZ, j)
                    int cc = array.get(cCat, j)
                    sameSide := sameSide and array.get(cSide, j) == s0
                    ob  := na(ob) ? z.bot : math.max(ob, z.bot)
                    ot2 := na(ot2) ? z.top : math.min(ot2, z.top)
                    eb  := na(eb) ? z.bot : math.min(eb, z.bot)
                    et  := na(et) ? z.top : math.max(et, z.top)
                    cr  := cr or cc == 1
                    cf  := cf or cc == 2
                    co  := co or cc == 3
                    tm  += f_pow2(z.typ)
                    // ID を昇順に挿入
                    int p = 0
                    int ni = array.size(ids)
                    while p < ni
                        if array.get(ids, p) > z.id
                            break
                        p += 1
                    array.insert(ids, p, z.id)
                    desc := desc + (a > 0 ? " + " : "") + f_zName(z)
                if sameSide and ob <= ot2 + EPS and low <= ot2 + EPS and high >= ob - EPS
                    string key = ""
                    for p = 0 to array.size(ids) - 1
                        key := key + (p > 0 ? "|" : "") + str.tostring(array.get(ids, p))
                    f_lbUnit(s0, cat0, cr, cf, co, ids, key, tm, ob, ot2, eb, et, desc + " " + f_catName(cat0))
                // 次の組合せ
                int a2 = nt - 1
                bool carry = true
                while carry and a2 >= 0
                    int v = array.get(od, a2) + 1
                    if v < array.get(cnt, a2)
                        array.set(od, a2, v)
                        carry := false
                    else
                        array.set(od, a2, 0)
                        a2 -= 1
                more := not carry
            st.maxCombo := math.max(st.maxCombo, combos)
    // BEL-2: ロックで禁止の足では待機を残さない (解除後は解除の次の足以後の接触から)
    if lkBlk and array.size(lbWaits) > 0
        st.nLockClr += array.size(lbWaits)
        array.clear(lbWaits)
    st.maxWaits := math.max(st.maxWaits, array.size(lbWaits))

    // ---- (B4) タイミング: TA (ACC-5A と同じ: 期限 → 吸収 → 新しい FVG) / TC (f_satHist) / 古いものを外す ----------
    //  (Pine v5 は and の両辺を評価するため、na のオブジェクトのフィールドを読む条件は if を分ける)
    if not na(lbFvUp)
        if bar_index - lbFvUp.fBar > fvLife
            lbFvUp := na
    if not na(lbFvDn)
        if bar_index - lbFvDn.fBar > fvLife
            lbFvDn := na
    for d = 0 to 1
        LbFvg fv = d == 0 ? lbFvUp : lbFvDn
        if not na(fv)
            bool absd = fv.dir == 1 ? (close < open and close <= fv.lo) : (close > open and close >= fv.hi)
            if absd
                st.tSeq += 1
                st.nTA  += 1
                array.push(lbTevs, LbTev.new(st.tSeq, 1, fv.dir == 1 ? -1 : 1, bar_index, false,
                     "TA FVG吸収 #" + str.tostring(fv.id)))
                if d == 0
                    lbFvUp := na
                else
                    lbFvDn := na
    bool upF = not na(labH2) and not na(labC1) and not na(labO1) and low > labH2 and labC1 > labO1 and low - labH2 >= fvMinW - EPS
    bool dnF = not na(labL2) and not na(labC1) and not na(labO1) and high < labL2 and labC1 < labO1 and labL2 - high >= fvMinW - EPS
    if upF
        st.fvSeq += 1
        lbFvUp := LbFvg.new(st.fvSeq, 1, bar_index, labH2, low)
    if dnF
        st.fvSeq += 1
        lbFvDn := LbFvg.new(st.fvSeq, -1, bar_index, high, labL2)
    [hL1, qL1, nL1] = f_satHist(1, labS1, hTqL1)
    [hL2, qL2, nL2] = f_satHist(1, labS2, hTqL2)
    [hL3, qL3, nL3] = f_satHist(1, labS3, hTqL3)
    [hS1, qS1, nS1] = f_satHist(-1, labS1, hTqS1)
    [hS2, qS2, nS2] = f_satHist(-1, labS2, hTqS2)
    [hS3, qS3, nS3] = f_satHist(-1, labS3, hTqS3)
    hTqL1 := nL1
    hTqL2 := nL2
    hTqL3 := nL3
    hTqS1 := nS1
    hTqS2 := nS2
    hTqS3 := nS3
    if hL1 or hL2 or hL3
        st.tSeq += 1
        st.nTC  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 2, 1, bar_index, false, "TC SATS反発 " + (hL1 ? "LINE1" : hL2 ? "LINE2" : "STB")))
    if hS1 or hS2 or hS3
        st.tSeq += 1
        st.nTC  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 2, -1, bar_index, false, "TC SATS反発 " + (hS1 ? "LINE1" : hS2 ? "LINE2" : "STB")))
    int ne0 = array.size(lbTevs)
    if ne0 > 0
        for i = ne0 - 1 to 0
            LbTev e = array.get(lbTevs, i)
            if e.used or bar_index - e.eBar > (e.kind == 1 ? fvAbsLife : tcLife)
                array.remove(lbTevs, i)
    st.maxTevs := math.max(st.maxTevs, array.size(lbTevs))

    // ---- (B5) 保有中: 建値 → TP の計画し直し → 変更通知 -----------------------------------------------------
    if o.state == 2 and opn
        if beOn and not o.be
            float trig = beMode == "固定幅" ? o.fill + o.side * beDist : o.fill + beRatio / 100.0 * (o.tp1E - o.fill)
            bool  okT  = beMode == "固定幅" or (not na(o.tp1E) and o.side * (o.tp1E - o.fill) > 0)
            if okT and (o.side == 1 ? high >= trig : low <= trig)
                o.be   := true
                o.stop := o.fill
                st.nBE += 1
        f_lbPlan(o.side == 1 ? math.max(o.fill, close) : math.min(o.fill, close), o.fill)
        f_lbIssue()
        o.lastTp := f_lbNextTp()
        f_lbNotify(false)

    // ---- (B6) 候補 → 優先 (現在価格に近い Zone) → 競合 → 発注 --------------------------------------------
    LbCand bestL = na
    LbCand bestS = na
    int nwc = array.size(lbWaits)
    if nwc > 0
        for i = 0 to nwc - 1
            LbWait w = array.get(lbWaits, i)
            int ia = cTA ? f_lbTim(1, w.side, w.sBar) : -1
            int ic = cTC ? f_lbTim(2, w.side, w.sBar) : -1
            bool timOK = cTim == "AND" ? ((cTA or cTC) and (not cTA or ia >= 0) and (not cTC or ic >= 0)) : ((cTA and ia >= 0) or (cTC and ic >= 0))
            if timOK
                st.nCand += 1
                int why = -1
                int om  = f_lbOthers(w.eBot, w.eTop, w.tmask)
                float sl  = w.side == 1 ? w.eBot - slBuf : w.eTop + slBuf
                float slw = w.side * (close - sl)
                float tp1 = na
                float rr  = na
                float qty = na
                int   nT  = 0
                if (w.cReb and not catReb) or (w.cFake and not catFake) or (w.cRole and not catRole)
                    why := 0
                else if cScope == "だけ" and om != 0
                    why := 1
                else if slw <= EPS or (maxSlOn and slw >= maxSl - 1e-6)
                    why := 2
                else
                    array<float> tps = tpMode == "固定 RR" ? array.new_float() : f_lbTargets(w.side, close)
                    nT  := array.size(tps)
                    tp1 := nT > 0 ? array.get(tps, 0) : close + w.side * fixRR * slw
                    rr  := w.side * (tp1 - close) / slw
                    if rr < minRR1 - EPS
                        why := 3
                    else if not sessOK
                        why := 4
                    else if not labRangeOK
                        why := 5
                    else
                        qty := f_qty(w.side, close, sl)
                        if na(qty)
                            why := 6
                if why >= 0
                    array.set(skipN, why, array.get(skipN, why) + 1)
                else
                    float dist = close > w.cTop ? close - w.cTop : close < w.cBot ? w.cBot - close : 0.0
                    LbCand c = LbCand.new(i, w.side, sl, slw, tp1, rr, qty, dist, cTA ? ia : -1, cTC ? ic : -1, om, nT)
                    if w.side == 1
                        if na(bestL)
                            bestL := c
                        else if c.dist < bestL.dist - EPS
                            bestL := c
                    else
                        if na(bestS)
                            bestS := c
                        else if c.dist < bestS.dist - EPS
                            bestS := c
    LbCand pick = na
    if not na(bestL) and not na(bestS)
        st.nConflict += 1
    else if not na(bestL)
        pick := bestL
    else if not na(bestS)
        pick := bestS
    if not na(pick)
        bool flat = o.state == 0 and strategy.position_size == 0
        if not flat or lkBlk
            st.nHoldSkip += 1
        else
            LbWait w = array.get(lbWaits, pick.wi)
            o.n          += 1
            o.id         := (pick.side == 1 ? "L" : "S") + str.tostring(o.n)
            o.side       := pick.side
            o.ref        := close
            o.sl         := pick.sl
            o.stop       := pick.sl
            o.be         := false
            o.fill       := na
            o.lotQ       := mmLotStep * mmLotOz / syminfo.pointvalue
            o.lotN       := int(math.round(pick.qty / o.lotQ))
            o.closedLots := 0
            o.stage      := 0
            o.bar        := bar_index
            o.tp1E       := pick.tp1
            o.tp1Fix     := tpMode == "固定 RR" or pick.nT == 0
            o.tmask      := w.tmask
            o.omask      := pick.omask
            o.cReb       := w.cReb
            o.cFake      := w.cFake
            o.cRole      := w.cRole
            o.tim        := (pick.ia >= 0 ? 1 : 0) + (pick.ic >= 0 ? 2 : 0)
            o.pnl        := 0.0
            o.nTp        := 0
            o.lastStop   := false
            o.lastTp     := na
            o.state      := 1
            for k = 0 to 2
                array.set(o.ntfPx, k, na)
            f_lbPlan(close, close)
            o.lastTp := f_lbNextTp()
            strategy.entry(o.id, pick.side == 1 ? strategy.long : strategy.short, qty = o.lotN * o.lotQ)
            f_lbIssue()
            f_lbNotify(true)
            // 消費: 使ったタイミング、この待機と同じ Zone を含む待機
            string tdesc = ""
            if pick.ia >= 0
                LbTev ea = array.get(lbTevs, pick.ia)
                ea.used := true
                tdesc := tdesc + " " + ea.desc + " (" + str.tostring(bar_index - ea.eBar) + "本前)"
            if pick.ic >= 0
                LbTev ec = array.get(lbTevs, pick.ic)
                ec.used := true
                tdesc := tdesc + " " + ec.desc + " (" + str.tostring(bar_index - ec.eBar) + "本前)"
            o.desc := (pick.side == 1 ? "LONG " : "SHORT ") + w.desc + "\n接触 " + str.tostring(bar_index - w.sBar) + "本前〜 /" + tdesc +
                 "\n判断 " + str.tostring(close, "#.##") + "  SL " + str.tostring(pick.sl, "#.##") + "  RR(TP1) " + str.tostring(pick.rr, "#.##") +
                 "\n" + f_lbTpText() + (pick.omask != 0 ? "\n他種類の重なりあり" : "")
            array<int> used = w.ids
            int nw2 = array.size(lbWaits)
            for i = nw2 - 1 to 0
                LbWait wj = array.get(lbWaits, i)
                bool hit = false
                for j = 0 to array.size(used) - 1
                    if f_waitHas(wj, array.get(used, j))
                        hit := true
                if hit
                    array.remove(lbWaits, i)
            alert("ZCL 確定 " + o.id + " " + o.desc, alert.freq_once_per_bar_close)
            o.lbl := na
            if dsEnt
                o.lbl := label.new(bar_index, pick.side == 1 ? low : high, o.id + " " + o.desc,
                     style = pick.side == 1 ? label.style_label_up : label.style_label_down,
                     color = pick.side == 1 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
                array.push(lbLbls, o.lbl)
                if array.size(lbLbls) > dsEntMax
                    label.delete(array.shift(lbLbls))

    // ---- (B7) 資産 (実現 + 含み損益) と最大 DD (含み損は確定足の不利な側の高値 / 安値で評価) ---------------------
    float openC = 0.0
    float openW = 0.0
    if strategy.position_size != 0 and not na(o.fill)
        float qn = math.abs(strategy.position_size)
        openC := strategy.convert_to_account(o.side * (close - o.fill) * qn * syminfo.pointvalue)
        openW := strategy.convert_to_account(o.side * ((o.side == 1 ? low : high) - o.fill) * qn * syminfo.pointvalue)
    float eqC = strategy.initial_capital + st.realized + openC
    float eqW = strategy.initial_capital + st.realized + openW
    st.peak := na(st.peak) ? math.max(strategy.initial_capital, eqC) : math.max(st.peak, eqC)
    float dd = st.peak - eqW
    if dd > st.maxDD
        st.maxDD := dd
    if st.peak > 0 and dd / st.peak > st.maxDDPct
        st.maxDDPct := dd / st.peak
// ==== LAB Logic (end) ========================================================

// ============================================================================
// 04. 表示 (売買には影響しない)
// ============================================================================
plot(zbUse1 ? zbMa1 : na, "ZB 1分 EMA", color = color.new(color.blue, 30))
plot(zbUse2 ? zbMa2 : na, "ZB 5分 EMA", color = color.new(color.navy, 30))

f_pct(float a, float b) =>
    b > 0 ? str.tostring(a / b * 100.0, "#.#") + "%" : "-"

var table lbTbl = table.new(position.bottom_right, 8, 24, border_width = 1, frame_color = color.gray)
if dsTbl and barstate.islast and lbRun
    array<string> nm = array.from("全体", "ZA含む", "ZB含む", "ZC含む", "ZD含む", "ZF含む", "ZAだけ", "ZBだけ", "ZCだけ", "ZDだけ", "ZFだけ",
         "TA", "TC", "反発", "ダマシ", "サポレジ", "LONG", "SHORT")
    array<string> hd = array.from("区分 (取引台帳)", "取引", "勝/負/建", "勝率", "PF", "平均R", "純損益(円)", "")
    for c = 0 to 6
        table.cell(lbTbl, c, 0, array.get(hd, c), text_color = color.white, bgcolor = color.new(color.navy, 10), text_size = size.tiny)
    for b = 0 to 17
        int   n  = array.get(bkN, b)
        int   w  = array.get(bkW, b)
        int   l  = array.get(bkL, b)
        float gp = array.get(bkGP, b)
        float gl = array.get(bkGL, b)
        table.cell(lbTbl, 0, b + 1, array.get(nm, b), text_size = size.tiny)
        table.cell(lbTbl, 1, b + 1, str.tostring(n), text_size = size.tiny)
        table.cell(lbTbl, 2, b + 1, str.tostring(w) + "/" + str.tostring(l) + "/" + str.tostring(array.get(bkBE, b)), text_size = size.tiny)
        table.cell(lbTbl, 3, b + 1, f_pct(w, w + l), text_size = size.tiny)
        table.cell(lbTbl, 4, b + 1, gl > 0 ? str.tostring(gp / gl, "#.##") : n > 0 ? "∞" : "-", text_size = size.tiny)
        table.cell(lbTbl, 5, b + 1, n > 0 ? str.tostring(array.get(bkR, b) / n, "#.##") : "-", text_size = size.tiny)
        table.cell(lbTbl, 6, b + 1, str.tostring(array.get(bkNet, b), "#"), text_size = size.tiny)
    table.cell(lbTbl, 0, 19, "最大DD (含み込み)", text_size = size.tiny)
    table.cell(lbTbl, 1, 19, str.tostring(st.maxDD, "#") + " 円", text_size = size.tiny)
    table.cell(lbTbl, 2, 19, str.tostring(st.maxDDPct * 100.0, "#.##") + " %", text_size = size.tiny)
    table.cell(lbTbl, 0, 20, "保持 ZA/ZB/ZC/ZD/ZF", text_size = size.tiny)
    table.cell(lbTbl, 1, 20, str.tostring(array.get(lbNZone, 0)) + "/" + str.tostring(array.get(lbNZone, 1)) + "/" + str.tostring(array.get(lbNZone, 2)) +
         "/" + str.tostring(array.get(lbNZone, 3)) + "/" + str.tostring(array.get(lbNZone, 4)), text_size = size.tiny)
    table.cell(lbTbl, 0, 21, "最大 走査/待機/タイミング/組合せ", text_size = size.tiny)
    table.cell(lbTbl, 1, 21, str.tostring(st.maxIter) + "/" + str.tostring(st.maxWaits) + "/" + str.tostring(st.maxTevs) + "/" + str.tostring(st.maxCombo), text_size = size.tiny)
    table.cell(lbTbl, 0, 22, "見送り 区分/だけ/SL/RR/時間/期間/数量", text_size = size.tiny)
    table.cell(lbTbl, 1, 22, str.tostring(array.get(skipN, 0)) + "/" + str.tostring(array.get(skipN, 1)) + "/" + str.tostring(array.get(skipN, 2)) + "/" +
         str.tostring(array.get(skipN, 3)) + "/" + str.tostring(array.get(skipN, 4)) + "/" + str.tostring(array.get(skipN, 5)) + "/" + str.tostring(array.get(skipN, 6)), text_size = size.tiny)
    table.cell(lbTbl, 0, 23, "競合/保有中/ロック消去/iFVG/FVG無効", text_size = size.tiny)
    table.cell(lbTbl, 1, 23, str.tostring(st.nConflict) + "/" + str.tostring(st.nHoldSkip) + "/" + str.tostring(st.nLockClr) + "/" + str.tostring(st.nIfvg) + "/" + str.tostring(st.nFvgDead), text_size = size.tiny)

// Data Window (検証用)
plot(st.nTrades,  "取引数 (台帳)", display = display.data_window)
plot(array.get(bkNet, 0), "純損益 (台帳・円)", display = display.data_window)
plot(st.maxDD,    "最大 DD (円)", display = display.data_window)
plot(array.size(lbZs) + array.size(lbFvgs), "静的 Zone 保持数", display = display.data_window)
plot(array.size(lbWaits), "待機数", display = display.data_window)
plot(array.size(lbTevs), "有効なタイミング数", display = display.data_window)
plot(st.iter,     "この足の Zone 走査数", display = display.data_window)
plot(st.nTA,      "TA 成立数", display = display.data_window)
plot(st.nTC,      "TC 成立数", display = display.data_window)
plot(st.nTpHit,   "TP 到達数", display = display.data_window)
plot(st.nBE,      "建値移動数", display = display.data_window)
plot(st.nBadExit, "不正な出口", display = display.data_window)

var array<LbZone> lbPocCur   = array.new<LbZone>(4, na)    // 時間足ごとの有効な POC Zone (最新の確定 POC 1 つ)
var array<int>    lbFvgLast  = array.new_int(4, na)
var array<int>    lbNZone    = array.new_int(7, 0)   // 種類ごとの保持数 (ZB は 0〜2、ZE は 0〜8、ZG は利用中のものだけ)
var array<int>    lbZeStat   = array.new_int(2, 0)   // ZE の受信状態 (4H / D): 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続
var array<float>  lbZeLast   = array.new_float(10, na)   // ZE: 時間足ごとに採用中の [起点, 終点, 方向, 波 ID, 状態] (状態 1 = Zone あり)
var array<LbZone> lbZeZ      = array.new<LbZone>()      // ZE: 有効なフィボ Zone (時間足ごとに最大 4)
var array<LbZone> lbZgZ      = array.new<LbZone>()      // ZG: 有効なダブル / トリプル Zone (利用 OFF の表示だけのものを含む)
var array<int>    lbZgUsed   = array.new_int()          // ZG: 発動済みの根拠 (基準 ID × 3 + 時間足)。消えた根拠も残して再登録しない
var array<int>    lbZgLast   = array.new_int(3, na)     // ZG: 時間足ごとに取り込んだ最後の対象足の time
var array<LbWait> lbWaits = array.new<LbWait>()
var array<LbTev>  lbTevs  = array.new<LbTev>()
var array<LbDtW>  lbDtWs  = array.new<LbDtW>()     // TE: 5分 / 15分の窓
var array<LbDt>   lbDts   = array.new<LbDt>()      // TE: 追跡中の基準 (Zone の到達とは無関係に常時)
// LAB-14: 5分基準の左側の波判定 (全確定 5分足で 1 本の実体波を追う。side = 0 なので終了判定はしない) と、5分窓と同じ並びの各足の判定
var LbDt          lbLw    = LbDt.new(0, 0, na, na, false)
var array<bool>   lbWvH   = array.new_bool()       // その足の確定時に上昇波の山候補 (直前の谷から teWv5 以上)
var array<bool>   lbWvL   = array.new_bool()       // その足の確定時に下降波の谷候補 (直前の山から teWv5 以上)
var array<float>  lbWvO   = array.new_float()      // その足の確定時に保持していた直前の反対側の極値の実体価格
var array<int>    lbWvT   = array.new_int()        // その足の time
var array<float>  lbWkH   = array.new_float()      // LAB-17: その足の高値 (左の山のヒゲ先)
var array<float>  lbWkL   = array.new_float()      // LAB-17: その足の安値 (左の谷のヒゲ先)
var LbFvg lbFvUp = na                               // TA: 監視中の上昇 FVG
var LbFvg lbFvDn = na
// 表示中の帯 (古い順。重なる Zone をまとめた帯 1 つ = 1 個。gone = 無効化した FVG の灰色の帯)。表示だけに使い、売買には使わない
type LbDsG
    box   bx
    label lb                  // 名称 (最新足の 3 本先・帯の上下限の中点。帯の中の文字は使わない)
    float bot
    float top
    bool  gone
    array<LbZone> mem
var array<LbDsG>  lbDsG  = array.new<LbDsG>()
var array<LbZone> lbAccZ = array.new<LbZone>()      // 採用中のアキュムの辺 (固定した順。1 箱 = 上辺・下辺の 2 個が続けて入る)
var array<int>    lbDeadNow = array.new_int()     // この足で外した Zone (無効化した FVG・採用件数から外れたアキュムの辺) → 待機を解除
var array<label>  lbLbls  = array.new<label>()
// TC サッツバンド転換 (SatsShortSignal bea7105 と同じ検知。確定 5分足ごとに、その足の中の 15秒・30秒・1分足と 5分足を時刻順に処理)
//  処理中の対象足 (時間足 i 0 15秒 / 1 30秒 / 2 1分 / 3 5分 ごとに 15 個): 0 開始時刻, 1 有効, 2 直前確定足の帯, 3 直前確定足の STB 方向,
//  4 LINE1 開始, 5 LINE2 開始, 6 hh20, 7 ll20, 8 hh9, 9 ll9, 10 前回確認時点の STB 方向, 11 累積高値, 12 累積安値, 13 SELL 済, 14 BUY 済
var array<float> tcCx    = array.new_float(60, na)
//  「フラット→帯」の時間足ごとの帯の状態 (最後に見た帯、赤 / 青の点灯開始時刻、点灯区間で成立済み、解除以降に成立を出したか)
var array<int>   tcBLast  = array.new_int(4, na)
var array<int>   tcBArmS  = array.new_int(4, na)
var array<int>   tcBArmB  = array.new_int(4, na)
var array<int>   tcBFireS = array.new_int(4, 0)
var array<int>   tcBFireB = array.new_int(4, 0)
var array<int>   tcBHadS  = array.new_int(4, 0)
var array<int>   tcBHadB  = array.new_int(4, 0)
//  イベント (時間足ごとに生成し、パターン・方向ごとに成立時刻順に読む)。eG 0 = 確定帯 / 帯の解除 (eMS = 1 SELL 側 / -1 BUY 側)、
//  1 = 成立。eSub 0 = 閉じた足 (途中 STB) / 1 = 始まる足。eDone ビット 1 SELL / 2 BUY 処理済み。eP パターン
var array<int>   tcET    = array.new_int()
var array<int>   tcEG    = array.new_int()
var array<int>   tcER    = array.new_int()
var array<int>   tcESub  = array.new_int()
var array<int>   tcEMS   = array.new_int()
var array<int>   tcEMB   = array.new_int()
var array<int>   tcETgt  = array.new_int()
var array<int>   tcEDone = array.new_int()
var array<int>   tcEP    = array.new_int()
//  候補 (パターン p × レーン L = 方向 d × 3 + 上位足の区間スロット j × 揃った段数 k × 段 st): 各段の成立時刻
var array<int>   tcCdT   = array.new_int(192, na)
var array<int>   tcSgLast = array.new_int(4, na)    // パターン × 方向: 最後に合図を出した成立時刻 (同時刻の残りを消費)
var array<int>   tcSlSeg  = array.new_int(12, na)   // パターン × 方向 × 3: スロットの上位足の区間 (切替 OFF は 0 の 1 区間)
var array<int>   tcPcT    = array.new_int(8, na)    // 方向 × 時間足: 最後に処理した確定帯の時刻 (帯→フラット)
var array<int>   tcPcB    = array.new_int(8, 0)
//  参照上位足の足ごとの記録 (上位足側の bar_index 順): bar_index, time_close, 確定帯, 取得済み, 区間の開始
var array<int>   tcHN   = array.new_int()
var array<int>   tcHT   = array.new_int()
var array<int>   tcHB   = array.new_int()
var array<int>   tcHHas = array.new_int()
var array<int>   tcHS   = array.new_int()
var int tcHFront = na
var int tcHNcur  = na
var array<int>   tcMerged = array.new_int()    // つながった (区間の開始が変わった) 古い区間の開始
//  処理済みイベントの記録 (欠けていた上位足の帯が届いて区間がつながったときに組み直す)
var array<int>   tcLgP   = array.new_int()
var array<int>   tcLgD   = array.new_int()
var array<int>   tcLgSeg = array.new_int()
var array<int>   tcLgT   = array.new_int()
var array<int>   tcLgG   = array.new_int()
var array<int>   tcLgR   = array.new_int()
var array<int>   tcLgSub = array.new_int()
var array<int>   tcLgMS  = array.new_int()
var array<int>   tcLgMB  = array.new_int()
var array<int>   tcLgTgt = array.new_int()
var array<int>   tcSigT  = array.new_int(4, na)   // この確定 5分足の中で成立した合図: パターン × 方向の最新成立時刻
// 取引台帳の区分別集計 (0 全体 / 1〜5 含む ZA〜ZF / 6〜10 だけ ZA〜ZF / 11 TA / 12 TC / 13 反発 / 14 ダマシ / 15 サポレジ / 16 LONG / 17 SHORT /
//  18 含む ZE / 19 だけ ZE / 20 含む ZG / 21 だけ ZG / 22 TE / 23 TD)
var array<int>   bkN   = array.new_int(24, 0)
var array<int>   bkW   = array.new_int(24, 0)
var array<int>   bkL   = array.new_int(24, 0)
var array<int>   bkBE  = array.new_int(24, 0)
var array<float> bkGP  = array.new_float(24, 0.0)
var array<float> bkGL  = array.new_float(24, 0.0)
var array<float> bkR   = array.new_float(24, 0.0)
var array<float> bkNet = array.new_float(24, 0.0)
// 候補の見送り理由 (タイミング成立後): 0 区分 OFF / 1 だけ (他種類の重なり) / 2 SL / 3 RR / 4 時間帯 / 5 期間 / 6 数量 / 7 ZD 接続異常 /
//  8 ZE 接続異常
var array<int>   skipN = array.new_int(9, 0)
// 建値ロック (BEL-1)
var bool  lkOn   = false
var int   lkSide = 0
var float lkSL   = na
var float lkTP   = na
var int   lkBar  = na
// 再計算設定の保護 (ACC-2)
varip int lbExecBar = -1
varip int lbExecN   = 0

// LAB-14 (TE 5分基準): DoubleTripleTopBottomXAU の f_inSeg / f_wave / f_waveInit / f_dtNg と同じ判定
f_teInSeg(int a, int s, int e) =>
    not na(a) and (na(s) or a >= s) and a < e + 300000

// 途中波を確定 5分足 1 本 (実体上端 h / 実体下端 l / time t) で更新。基準と同じ側の極値が確定し、接近幅の上下どちらかの外側にあり、
//  最新の接近がその波の区間 (直前の反対側の極値足の開始 〜 極値足の終わり) に入らなければ wEnd を立てる
//  LAB-17 (DTB-12): hw / lw = その足のヒゲ先。区間のヒゲ先の極値 (wXW) も追い、確定した極値の実体端とヒゲ先のどちらかが有効な
//  左の基準 (実体端 = bOk のとき / ヒゲ先 = lwk) の接近幅に入っていれば独立した途中波にしない
f_teNear(LbDt g, float x) =>
    not na(x) and ((g.bOk and math.abs(x - g.lvl) <= teB5 + EPS) or (not na(g.lwk) and math.abs(x - g.lwk) <= teB5 + EPS))

f_teWave(LbDt g, float h, float l, int t, float hw, float lw) =>
    bool  cf  = false
    float cx  = na
    float cxW = na
    int   cxT = na
    int   cxS = na
    if g.wUp
        if h >= g.wX
            g.wX  := h
            g.wXT := t
            g.wXW := na(g.wXW) ? hw : math.max(g.wXW, hw)
        else if l <= g.wX - teWv5 + EPS
            if g.side == -1
                cf  := true
                cx  := g.wX
                cxW := g.wXW
                cxT := g.wXT
                cxS := g.wOT
            g.wOT := g.wXT
            g.wOX := g.wX
            g.wUp := false
            g.wX  := l
            g.wXT := t
            g.wXW := lw
        else
            g.wXW := na(g.wXW) ? hw : math.max(g.wXW, hw)
    else
        if l <= g.wX
            g.wX  := l
            g.wXT := t
            g.wXW := na(g.wXW) ? lw : math.min(g.wXW, lw)
        else if h >= g.wX + teWv5 - EPS
            if g.side == 1
                cf  := true
                cx  := g.wX
                cxW := g.wXW
                cxT := g.wXT
                cxS := g.wOT
            g.wOT := g.wXT
            g.wOX := g.wX
            g.wUp := true
            g.wX  := h
            g.wXT := t
            g.wXW := hw
        else
            g.wXW := na(g.wXW) ? lw : math.min(g.wXW, lw)
    if cf
        bool ind = not f_teNear(g, cx) and not f_teNear(g, cxW)
        if ind and not f_teInSeg(g.apT, cxS, cxT)
            g.wEnd := true
    g.wEnd

// 登録時の初期化: Pivot 中央足 (time = pvT・基準価格) を極値として、窓の右側 (登録時点までの確定 5分足) を順に流す
f_teWaveInit(LbDt g, LbDtW tw, int pvT) =>
    g.wUp := g.side == -1
    g.wX  := g.lvl
    g.wXT := pvT
    g.wOT := na
    g.wXW := na(g.lwk) ? g.lvl : g.lwk
    int n = math.min(math.min(array.size(tw.hs), array.size(lbWvT)), array.size(lbWkH))
    if n > tePiv + 1
        for j = tePiv + 1 to n - 1
            f_teWave(g, array.get(tw.hs, j), array.get(tw.ls, j), array.get(lbWvT, j), array.get(lbWkH, j), array.get(lbWkL, j))
    g.wEnd

// LAB-17 (DTB-12): 5分基準の接近。左 (有効な実体端 lvl / ヒゲ先 lwk) × 右 (この足の実体端 rb / ヒゲ先 rw) の 4 組のどれかの差が接近幅以内。
//  返り値 = [左の実体端に一致 / 左のヒゲ先に一致]
f_teApHit(LbDt g, float rb, float rw) =>
    bool hB = g.bOk and (math.abs(rb - g.lvl) <= teB5 + EPS or math.abs(rw - g.lvl) <= teB5 + EPS)
    bool hW = not na(g.lwk) and (math.abs(rb - g.lwk) <= teB5 + EPS or math.abs(rw - g.lwk) <= teB5 + EPS)
    [hB, hW]

// ダブルトップの最低離れ幅不足 (左の山 − 固定した中央の谷 / 右の山 − 固定した中央の谷 のどちらかが teD5 未満、または未取得)
f_teDtNg(LbDt g) =>
    g.tf == 0 and g.side == -1 and not (g.lvl - g.tMid >= teD5 - EPS and g.tPk - g.tMid >= teD5 - EPS)

f_pow2(int b) =>
    b == 0 ? 1 : b == 1 ? 2 : b == 2 ? 4 : b == 3 ? 8 : b == 4 ? 16 : b == 5 ? 32 : 64     // ZE = 5 → 32 (FVG の 16 は変えない)、ZG = 6 → 64

f_bit(int m, int b) =>
    math.floor(m / f_pow2(b)) % 2 == 1

f_typName(int t) =>
    t == 0 ? "アキュム" : t == 1 ? "MA" : t == 2 ? "水平線" : t == 3 ? "出来高POC" : t == 5 ? "フィボ" : t == 6 ? "ダブル/トリプル" : "FVG"

// 時間足の表記と順位 (表示で上位の時間足から並べる: 週足 0 / 日足 1 / 4時間足 2 / 1時間足 3 / 5分足 4 / 1分足 5)
f_tfName(int t, int k) =>
    t == 0 or t == 6 ? (k == 0 ? "1時間足" : k == 1 ? "4時間足" : "日足") : t == 1 ? (k == 0 ? "1分足" : "5分足") : t == 5 ? (k == 0 ? "4時間足" : "日足") :
     (k == 0 ? "1時間足" : k == 1 ? "4時間足" : k == 2 ? "日足" : "週足")

f_tfRank(LbZone z) =>
    z.typ == 1 ? (z.tf == 0 ? 5 : 4) : z.typ == 0 or z.typ == 6 ? (z.tf == 0 ? 3 : z.tf == 1 ? 2 : 1) : z.typ == 5 ? (z.tf == 0 ? 2 : 1) :
     (z.tf == 0 ? 3 : z.tf == 1 ? 2 : z.tf == 2 ? 1 : 0)

f_tfNameR(int r) =>
    r == 0 ? "週足" : r == 1 ? "日足" : r == 2 ? "4時間足" : r == 3 ? "1時間足" : r == 4 ? "5分足" : "1分足"

// Zone の名称 (時間足を除く)
f_zItem(LbZone z) =>
    z.typ == 0 ? (z.sub == 1 ? "アキュム上辺" : "アキュム下辺") : z.typ == 1 ? "MA EMA" + str.tostring(z.tf == 0 ? zbLen1 : zbLen2) :
     z.typ == 2 ? "水平線" : z.typ == 3 ? "出来高POC" : z.typ == 5 ? "フィボ " + str.tostring(z.infoA) :
     z.typ == 6 ? (z.infoA == 3 ? "トリプル" : "ダブル") + (z.sub == 1 ? "トップ" : "ボトム") : z.inv ? "iFVG" : "FVG"

f_catName(int c) =>
    c == 1 ? "反発" : c == 2 ? "ダマシ" : "サポレジ"

f_zaUse(int k) =>
    k == 0 ? zaUse1 : k == 1 ? zaUse2 : zaUse3

f_zbUse(int k) =>
    k == 0 ? zbUse1 : zbUse2

f_zcUse(int k) =>
    k == 0 ? zcUse1 : k == 1 ? zcUse2 : k == 2 ? zcUse3 : zcUse4

f_zdUse(int k) =>
    k == 0 ? zdUse1 : k == 1 ? zdUse2 : k == 2 ? zdUse3 : zdUse4

f_zfUse(int k) =>
    k == 0 ? zfUse1 : k == 1 ? zfUse2 : k == 2 ? zfUse3 : zfUse4

f_condTyp(int t) =>
    t == 0 ? cZA : t == 1 ? cZB : t == 2 ? cZC : t == 3 ? cZD : t == 4 ? cZF : t == 5 ? cZE : cZG and (zgUse1 or zgUse4 or zgUseD)

// ZG: 時間足 0 = 1H / 1 = 4H / 2 = D の設定
f_zgUse(int k) =>
    k == 0 ? zgUse1 : k == 1 ? zgUse4 : zgUseD

f_zgShow(int k) =>
    k == 0 ? zgShow1 : k == 1 ? zgShow4 : zgShowD

f_zgExpOn(int k) =>
    k == 0 ? zgExp1 : k == 1 ? zgExp4 : zgExpD

f_zgExpN(int k) =>
    k == 0 ? zgExpN1 : k == 1 ? zgExpN4 : zgExpND

// ZG: 受信した検知器の出力 (「B,対象足 time,time_close,前の time,基準数,bar_index」+ イベント) から、まだ取り込んでいない確定済みの対象足だけを読む
//  (LongTermDoubleTripleTopBottomXAU の受信と同じ: 対象足の time が前回より新しく、その time_close がこの足の確定までのもの)。
//  戻り値 [取り込んだ最後の time, 記録]: 記録は 6 個ずつ [0 = 対象足 / 1 = 検知, 対象足の bar_index, 基準 ID, 方向 (-1 トップ / 1 ボトム), 回数, 基準価格]
f_zgParse(string pk, int lastT, int tcNow) =>
    array<float> out = array.new_float()
    int lt = lastT
    if not na(pk) and pk != ""
        array<string> evs = str.split(pk, ";")
        bool take = false
        float cbi = na
        for i = 0 to array.size(evs) - 1
            string e = array.get(evs, i)
            if e != ""
                array<string> f = str.split(e, ",")
                string ty = array.get(f, 0)
                if ty == "B"
                    int sT = int(str.tonumber(array.get(f, 1)))
                    int sC = int(str.tonumber(array.get(f, 2)))
                    take := not na(sT) and (na(lt) or sT > lt) and not na(sC) and sC <= tcNow
                    if take
                        lt  := sT
                        cbi := str.tonumber(array.get(f, 5))
                        array.push(out, 0)
                        array.push(out, cbi)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                else if take and ty == "D" and array.size(f) > 16
                    array.push(out, 1)
                    array.push(out, cbi)
                    array.push(out, str.tonumber(array.get(f, 1)))
                    array.push(out, str.tonumber(array.get(f, 2)))
                    array.push(out, str.tonumber(array.get(f, 7)))
                    array.push(out, str.tonumber(array.get(f, 16)))
    [lt, out]

// ZE: 時間足 0 = 4時間足 / 1 = 日足 の採用
f_zeUse(int k) =>
    zeUse and (k == 0 ? zeUse4 : zeUseD)

// 区分別集計の位置: 含む / だけ (ZA〜ZF は 1〜5 / 6〜10、ZE は追加の 18 / 19)
f_bkInc(int t) =>
    t < 5 ? 1 + t : t == 5 ? 18 : 20

f_bkOnly(int t) =>
    t < 5 ? 6 + t : t == 5 ? 19 : 21

// Zone が時間足の順位 r に当たるか (水平線 Zone は構成水平線のどれかの時間足)
f_zAtRank(LbZone z, int r) =>
    bool hit = f_tfRank(z) == r
    if z.typ == 2 and not na(z.mTf)
        hit := false
        for j = 0 to array.size(z.mTf) - 1
            int tk = array.get(z.mTf, j)
            if (tk == 0 ? 3 : tk == 1 ? 2 : tk == 2 ? 1 : 0) == r
                hit := true
    hit

f_zName(LbZone z) =>
    string tn = f_tfName(z.typ, z.tf)
    if z.typ == 2 and not na(z.mTf)
        tn := ""
        for r = 0 to 3
            if f_zAtRank(z, r)
                tn := tn + (tn == "" ? "" : "・") + f_tfNameR(r)
    tn + " " + f_zItem(z)

// 開始時刻を含み、終了時刻を含まない (開始 == 終了 は終日)。AccumStrategyXAU と同じ
f_inSession(int t) =>
    int mins = hour(t, seTz) * 60 + minute(t, seTz)
    int s    = seStartH * 60 + seStartM
    int e    = seEndH * 60 + seEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)

// 数量 (AccumStrategyXAU f_qty = ZoneStrategyXAU f_stQty と同じ式)
f_qty(int side, float ref, float sl) =>
    float budget = mmCapBase * mmRiskPct / 100.0
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = budget > 0 ? strategy.convert_to_symbol(budget) : na
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and mmLotOz > 0 and mmLotStep > 0 and mmLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * mmLotOz * mmLotStep) + 1e-9)
        if n * mmLotStep * mmLotOz * dist > budSym
            n := n - 1
        if n >= 1 and n * mmLotStep >= mmLotMin * (1 - 1e-9)
            q := n * mmLotStep * mmLotOz / pv
    q

// ---- TC サッツバンド転換: SatsShortSignal (bea7105) の検知・揃え方 (確認用のラベル・表は持たない) ----------------------------------
//  パターン p (0 帯→フラット / 1 フラット→帯＋端の線転換) の時間足 i (0 15秒 / 1 30秒 / 2 1分 / 3 5分) の設定
f_tcOnP(int p, int i) =>
    p == 0 ? tcPatA and (i == 0 ? tcU15 : i == 1 ? tcU30 : i == 2 ? tcU60 : tcU300) : tcPatB and (i == 0 ? tcUB15 : i == 1 ? tcUB30 : i == 2 ? tcUB60 : tcUB300)

f_tcPOn(int p) =>
    p == 0 ? tcPatA : tcPatB

f_tcClrOn(int i) =>
    i == 0 ? tcClr15 : i == 1 ? tcClr30 : i == 2 ? tcClr60 : tcClr300

//  上位足で切り替えるときの欄 (パターン p × 帯 b × 方向 d × 時間足 i)
f_tcX(int p, int bi, int d, int i) =>
    int k = ((p * 3 + bi) * 2 + d) * 4 + i
    bool r = false
    if k < 24
        r := k == 0 ? tcxA0S0 : k == 1 ? tcxA0S1 : k == 2 ? tcxA0S2 : k == 3 ? tcxA0S3 : k == 4 ? tcxA0B0 : k == 5 ? tcxA0B1 : k == 6 ? tcxA0B2 : k == 7 ? tcxA0B3 :
             k == 8 ? tcxA1S0 : k == 9 ? tcxA1S1 : k == 10 ? tcxA1S2 : k == 11 ? tcxA1S3 : k == 12 ? tcxA1B0 : k == 13 ? tcxA1B1 : k == 14 ? tcxA1B2 : k == 15 ? tcxA1B3 :
             k == 16 ? tcxA2S0 : k == 17 ? tcxA2S1 : k == 18 ? tcxA2S2 : k == 19 ? tcxA2S3 : k == 20 ? tcxA2B0 : k == 21 ? tcxA2B1 : k == 22 ? tcxA2B2 : tcxA2B3
    else
        r := k == 24 ? tcxB0S0 : k == 25 ? tcxB0S1 : k == 26 ? tcxB0S2 : k == 27 ? tcxB0S3 : k == 28 ? tcxB0B0 : k == 29 ? tcxB0B1 : k == 30 ? tcxB0B2 : k == 31 ? tcxB0B3 :
             k == 32 ? tcxB1S0 : k == 33 ? tcxB1S1 : k == 34 ? tcxB1S2 : k == 35 ? tcxB1S3 : k == 36 ? tcxB1B0 : k == 37 ? tcxB1B1 : k == 38 ? tcxB1B2 : k == 39 ? tcxB1B3 :
             k == 40 ? tcxB2S0 : k == 41 ? tcxB2S1 : k == 42 ? tcxB2S2 : k == 43 ? tcxB2S3 : k == 44 ? tcxB2B0 : k == 45 ? tcxB2B1 : k == 46 ? tcxB2B2 : tcxB2B3
    r

//  パターン p・方向 d・上位足の帯 b で時間足 i を使うか (切替 OFF はパターンの時間足設定、帯が未取得なら使わない)
f_tcSel(int p, int d, int b, int i) =>
    bool r = false
    if f_tcPOn(p)
        if not tcHtfOn
            r := f_tcOnP(p, i)
        else if not na(b)
            r := f_tcX(p, b == -1 ? 0 : b == 0 ? 1 : 2, d, i)
    r

//  パターン p が時間足 i をどこかで使うか (イベントの生成対象)
f_tcUseP(int p, int i) =>
    bool r = f_tcOnP(p, i)
    if tcHtfOn
        r := false
        if f_tcPOn(p)
            for bi = 0 to 2
                for d = 0 to 1
                    if f_tcX(p, bi, d, i)
                        r := true
    r

f_tcNeed(int i) =>
    f_tcUseP(0, i) or f_tcUseP(1, i)

f_tcNStg(int p, int d, int b) =>
    int n = 0
    for i = 0 to 3
        if f_tcSel(p, d, b, i)
            n += 1
    n

f_tcStage(int p, int d, int b, int i) =>
    int s = -1
    if f_tcSel(p, d, b, i)
        s := 0
        for k = 0 to 3
            if k < i and f_tcSel(p, d, b, k)
                s += 1
    s

//  上位足の足 n を記録 (単体版 f_htfPut と同じ。先頭の記録の区間の開始は保つ。区間の開始が早まったら古い区間を組み直し対象に)
f_tcHtfPut(int n, int tc, int b, bool has) =>
    if not na(n) and not na(tc)
        int sz = array.size(tcHN)
        int at = -1
        int pos = sz
        for k = sz - 1 to 0
            if k < 0 or k >= sz
                continue
            int nk = array.get(tcHN, k)
            if nk == n
                at := k
            if nk > n
                pos := k
        if at >= 0
            array.set(tcHT, at, tc)
            if has and array.get(tcHHas, at) == 0
                array.set(tcHB, at, b)
                array.set(tcHHas, at, 1)
        else
            array.insert(tcHN, pos, n)
            array.insert(tcHT, pos, tc)
            array.insert(tcHB, pos, has ? b : na)
            array.insert(tcHHas, pos, has ? 1 : 0)
            array.insert(tcHS, pos, tc)
        for k = 1 to array.size(tcHN) - 1
            if k >= 1 and k < array.size(tcHN)
                bool cont = array.get(tcHN, k - 1) == array.get(tcHN, k) - 1 and array.get(tcHHas, k - 1) == 1
                     and array.get(tcHHas, k) == 1 and nz(array.get(tcHB, k - 1), 9) == nz(array.get(tcHB, k), 9)
                int oldS = array.get(tcHS, k)
                int newS = cont ? array.get(tcHS, k - 1) : array.get(tcHT, k)
                if not na(oldS) and newS < oldS and not array.includes(tcMerged, oldS)
                    array.push(tcMerged, oldS)
                array.set(tcHS, k, newS)
        if array.size(tcHN) > 30
            array.shift(tcHN)
            array.shift(tcHT)
            array.shift(tcHB)
            array.shift(tcHHas)
            array.shift(tcHS)

//  時刻 t の上位足の帯: [区間の開始, 帯, 状態 0 分かっている / 1 まだ届く可能性 (保留) / 2 取得できない (合図なし)] (単体版 f_htfInfo と同じ)
f_tcHtfInfo(int t) =>
    int sz = array.size(tcHN)
    int k = -1
    for q = 0 to sz - 1
        if q >= 0 and q < sz and array.get(tcHT, q) <= t
            k := q
    int sg = na
    int b = na
    int st = 2
    if k >= 0
        int nk = array.get(tcHN, k)
        bool nextOk = (k + 1 < sz and array.get(tcHN, k + 1) == nk + 1) or (k + 1 >= sz and not na(tcHNcur) and tcHNcur == nk + 1)
        int need = array.get(tcHHas, k) == 0 ? nk : nextOk ? na : nk + 1
        if na(need)
            sg := array.get(tcHS, k)
            b := array.get(tcHB, k)
            st := na(b) ? 2 : 0
        else
            st := not na(tcHNcur) and tcHNcur >= need + 3 ? 2 : 1
    [sg, b, st]

f_tcCdIdx(int p, int L, int k, int st) =>
    ((p * 6 + L) * 4 + k) * 4 + st

f_tcCdClr(int p, int L, int k) =>
    for st = 0 to 3
        array.set(tcCdT, f_tcCdIdx(p, L, k, st), na)

f_tcCdValid(int p, int L, int k, int t) =>
    int st0 = array.get(tcCdT, f_tcCdIdx(p, L, k, 0))
    bool ok = not na(st0) and t - st0 <= tcWait * 60000
    if not na(st0) and not ok
        f_tcCdClr(p, L, k)
    ok

f_tcSlotFind(int p, int d, int seg) =>
    int r = -1
    for j = 0 to 2
        int sj = array.get(tcSlSeg, (p * 2 + d) * 3 + j)
        if not na(sj) and sj == seg and r < 0
            r := j
    r

f_tcSlotFor(int p, int d, int seg) =>
    int r = f_tcSlotFind(p, d, seg)
    if r < 0
        int old = -1
        for j = 0 to 2
            int sj = array.get(tcSlSeg, (p * 2 + d) * 3 + j)
            if na(sj) and r < 0
                r := j
            if not na(sj) and (old < 0 or sj < array.get(tcSlSeg, (p * 2 + d) * 3 + old))
                old := j
        if r < 0
            r := old
        array.set(tcSlSeg, (p * 2 + d) * 3 + r, seg)
        for kk = 1 to 3
            f_tcCdClr(p, d * 3 + r, kk)
    r

//  パターン p・方向 d・区間スロット j で時間足 i の成立 (m > 0) を処理し、選んだ段がすべて揃ったら true (単体版 f_seqEvt と同じ揃え方)
f_tcSeqEvt(int p, int d, int j, int i, int t, int m, int b) =>
    bool fired = false
    int L = d * 3 + j
    int s = f_tcStage(p, d, b, i)
    int last = array.get(tcSgLast, p * 2 + d)
    if s >= 0 and m > 0 and not (not na(last) and last == t)
        bool can = s == 0 ? true : f_tcCdValid(p, L, s, t)
        if can
            int st0 = s == 0 ? t : array.get(tcCdT, f_tcCdIdx(p, L, s, 0))
            int k = s + 1
            if k == f_tcNStg(p, d, b)
                fired := true
                for kk = 1 to 3
                    f_tcCdClr(p, L, kk)
                array.set(tcSgLast, p * 2 + d, t)
            else
                int curS = array.get(tcCdT, f_tcCdIdx(p, L, k, 0))
                bool curOk = f_tcCdValid(p, L, k, t)
                if not curOk or st0 > curS or st0 == curS
                    for q = 0 to 3
                        if q < s
                            array.set(tcCdT, f_tcCdIdx(p, L, k, q), array.get(tcCdT, f_tcCdIdx(p, L, s, q)))
                        else if q == s
                            array.set(tcCdT, f_tcCdIdx(p, L, k, q), t)
                        else
                            array.set(tcCdT, f_tcCdIdx(p, L, k, q), na)
    fired

f_tcCdDropTf(int p, int d, int j, int i, int b) =>
    int s = f_tcStage(p, d, b, i)
    if s >= 0 and s < 3
        for k = s + 1 to 3
            f_tcCdClr(p, d * 3 + j, k)

//  イベントを積む: 成立 (mask あり) と、消去に使う確定帯 / 帯の解除 (SELL 側 1 / BUY 側 -1) だけ
f_tcEmit(int p, int t, int g, int i, int sub, int ms, int mb, int tgt) =>
    bool keep = g == 0 ? ((ms == 1 or ms == -1) and (p == 1 or f_tcClrOn(i))) : (ms > 0 or mb > 0)
    if keep and not na(t)
        array.push(tcEP, p)
        array.push(tcET, t)
        array.push(tcEG, g)
        array.push(tcER, i)
        array.push(tcESub, sub)
        array.push(tcEMS, ms)
        array.push(tcEMB, mb)
        array.push(tcETgt, tgt)
        array.push(tcEDone, g == 0 ? (ms == 1 ? 2 : 1) : (ms > 0 ? 0 : 1) + (mb > 0 ? 0 : 2))

//  対象足の開始 (単体版 f_ctxStart と同じ。値は直前確定足からの固定値)
f_tcCtxStart(int i, int t, float o, float stP, float sdP, float l1s, float l2s, float hh20, float ll20, float hh9, float ll9, bool ok, int ms, int mb) =>
    int b = i * 15
    bool okC = ok and not na(o)
    array.set(tcCx, b, t)
    array.set(tcCx, b + 1, okC ? 1 : 0)
    if okC
        array.set(tcCx, b + 2, stP)
        array.set(tcCx, b + 3, sdP)
        array.set(tcCx, b + 4, l1s)
        array.set(tcCx, b + 5, l2s)
        array.set(tcCx, b + 6, hh20)
        array.set(tcCx, b + 7, ll20)
        array.set(tcCx, b + 8, hh9)
        array.set(tcCx, b + 9, ll9)
        float sdS = sdP
        if not na(hh20) and not na(ll20)
            if o > hh20
                sdS := 1
            else if o < ll20
                sdS := -1
        array.set(tcCx, b + 10, sdS)
        array.set(tcCx, b + 11, o)
        array.set(tcCx, b + 12, o)
        array.set(tcCx, b + 13, ms > 0 ? 1 : 0)
        array.set(tcCx, b + 14, mb > 0 ? 1 : 0)

//  対象足の途中で 15秒足が確定したとき (単体版 f_ctxClose と同じ。成立は STB = mask 4)
f_tcCtxClose(int i, int tgt, float h, float l, float c) =>
    int b = i * 15
    int ms = 0
    int mb = 0
    if array.get(tcCx, b + 1) == 1 and array.get(tcCx, b) == tgt and not na(h) and not na(l) and not na(c)
        float cumH = math.max(array.get(tcCx, b + 11), h)
        float cumL = math.min(array.get(tcCx, b + 12), l)
        array.set(tcCx, b + 11, cumH)
        array.set(tcCx, b + 12, cumL)
        float stP    = array.get(tcCx, b + 2)
        float sdP    = array.get(tcCx, b + 3)
        float l1s    = array.get(tcCx, b + 4)
        float l2s    = array.get(tcCx, b + 5)
        float hh20   = array.get(tcCx, b + 6)
        float ll20   = array.get(tcCx, b + 7)
        float hh9    = array.get(tcCx, b + 8)
        float ll9    = array.get(tcCx, b + 9)
        float sdLast = array.get(tcCx, b + 10)
        float sd = sdP
        if not na(hh20) and not na(ll20)
            if cumH > hh20
                sd := 1
            else if cumL < ll20
                sd := -1
        float stb = sd == 1 ? (na(ll9) ? na : math.min(cumL, ll9)) : (na(hh9) ? na : math.max(cumH, hh9))
        if not na(sdLast) and sd != sdLast and not na(stb) and not na(l1s) and not na(l2s) and not na(stP)
            int band = c > l1s and c > l2s and c > stb ? 1 : c < l1s and c < l2s and c < stb ? -1 : 0
            if band == 0 and stP == 1 and sdLast == 1 and sd == -1 and stb > c and array.get(tcCx, b + 13) == 0
                ms := 4
                array.set(tcCx, b + 13, 1)
            if band == 0 and stP == -1 and sdLast == -1 and sd == 1 and stb < c and array.get(tcCx, b + 14) == 0
                mb := 4
                array.set(tcCx, b + 14, 1)
        array.set(tcCx, b + 10, sd)
    [ms, mb]

//  「フラット→帯」: 時間足 i の帯を 1 つ観測 (単体版 f_bandObs と同じ)
f_tcBandObs(int i, int t, float b) =>
    if not na(b)
        int last = array.get(tcBLast, i)
        if b == -1
            if not na(last) and last == 0 and na(array.get(tcBArmS, i))
                array.set(tcBArmS, i, t)
                array.set(tcBFireS, i, 0)
        else
            array.set(tcBArmS, i, na)
            array.set(tcBFireS, i, 0)
            if array.get(tcBHadS, i) == 1
                f_tcEmit(1, t, 0, i, 0, 1, 0, t)
                array.set(tcBHadS, i, 0)
        if b == 1
            if not na(last) and last == 0 and na(array.get(tcBArmB, i))
                array.set(tcBArmB, i, t)
                array.set(tcBFireB, i, 0)
        else
            array.set(tcBArmB, i, na)
            array.set(tcBFireB, i, 0)
            if array.get(tcBHadB, i) == 1
                f_tcEmit(1, t, 0, i, 0, -1, 0, t)
                array.set(tcBHadB, i, 0)
        array.set(tcBLast, i, int(b))

//  「フラット→帯」: 足の開始時点 t の端の線の転換 (単体版 f_bandStart と同じ。点灯区間で方向ごとに 1 回)
f_tcBandStart(int i, int t, float stS, int ma, int mz) =>
    int fs = 0
    int fb = 0
    if not na(stS) and stS == -1 and not na(array.get(tcBArmS, i)) and array.get(tcBFireS, i) == 0 and nz(ma) > 0
        fs := ma
        array.set(tcBFireS, i, 1)
        array.set(tcBHadS, i, 1)
    if not na(stS) and stS == 1 and not na(array.get(tcBArmB, i)) and array.get(tcBFireB, i) == 0 and nz(mz) > 0
        fb := mz
        array.set(tcBFireB, i, 1)
        array.set(tcBHadB, i, 1)
    if fs > 0
        f_tcEmit(1, t, 1, i, 1, fs, 0, array.get(tcBArmS, i))
    if fb > 0
        f_tcEmit(1, t, 1, i, 1, 0, fb, array.get(tcBArmB, i))

//  時間足 i の足の開始 (単体版 f_tfRun の開始判定と同じ: 確定帯 → 対象足の開始 → 開始イベント → 「フラット→帯」の帯と線)
f_tcStart(int i, int t, int ms, int mb, float o, float stP, float sdP, float l1s, float l2s, float hh20, float ll20, float hh9,
     float ll9, int tcP, float stS, int ma, int mz) =>
    bool useA = f_tcUseP(0, i)
    bool useB = f_tcUseP(1, i)
    if useA and not na(stP) and not na(tcP)
        f_tcEmit(0, tcP, 0, i, 0, int(stP), 0, t)
    f_tcCtxStart(i, t, o, stP, sdP, l1s, l2s, hh20, ll20, hh9, ll9, true, nz(ms), nz(mb))
    if useA
        f_tcEmit(0, t, 1, i, 1, nz(ms), nz(mb), t)
    if useB
        if not na(tcP)
            f_tcBandObs(i, tcP, stP)
        f_tcBandObs(i, t, stS)
        f_tcBandStart(i, t, stS, nz(ma), nz(mz))

//  時間足 i の対象足 (開始 tgt) の途中で、15秒足 r が確定した (途中 STB。帯→フラットだけ)
f_tcClose(int i, int tgt, int r) =>
    [msC, mbC] = f_tcCtxClose(i, tgt, array.get(tq15H, r), array.get(tq15L, r), array.get(tq15C, r))
    if f_tcUseP(0, i)
        f_tcEmit(0, array.get(tq15TC, r), 1, i, 0, msC, mbC, tgt)

//  この確定 5分足の中の 15秒・30秒・1分足と 5分足のイベントを、時間足ごとに時刻順に生成する
f_tcGen() =>
    int n15 = na(tq15t) ? 0 : array.size(tq15t)
    for i = 0 to 3
        if f_tcNeed(i)
            if i == 3
                f_tcStart(3, tq5t, tq5ms, tq5mb, tq5o, tq5sp, tq5dp, tq5l1, tq5l2, tq5h20, tq5w20, tq5h9, tq5w9, tq5tc, tq5ss, tq5ma, tq5mz)
                for r = 0 to n15 - 1
                    if r >= 0 and r < n15
                        f_tcClose(3, tq5t, r)
            else
                array<int> aT = i == 0 ? tq15t : i == 1 ? tq30t : tq60t
                int nb = na(aT) ? 0 : array.size(aT)
                for j = 0 to nb - 1
                    if j >= 0 and j < nb
                        int s0 = array.get(aT, j)
                        // 対象足の終了 = 開始 + 足の長さ (30秒 / 60秒)・次に取得できた同時間足の開始・親の 5分足の終了 の最も早い時刻
                        int e0 = math.min(s0 + (i == 1 ? 30000 : 60000), time_close)
                        if j + 1 < nb
                            e0 := math.min(e0, array.get(aT, j + 1))
                        if i == 0
                            f_tcStart(0, s0, array.get(tq15ms, j), array.get(tq15mb, j), array.get(tq15o, j), array.get(tq15sp, j), array.get(tq15dp, j),
                                 array.get(tq15l1, j), array.get(tq15l2, j), array.get(tq15h20, j), array.get(tq15w20, j), array.get(tq15h9, j),
                                 array.get(tq15w9, j), array.get(tq15tc, j), array.get(tq15ss, j), array.get(tq15ma, j), array.get(tq15mz, j))
                            f_tcClose(0, s0, j)
                        else
                            bool h30 = i == 1
                            f_tcStart(i, s0, h30 ? array.get(tq30ms, j) : array.get(tq60ms, j), h30 ? array.get(tq30mb, j) : array.get(tq60mb, j),
                                 h30 ? array.get(tq30o, j) : array.get(tq60o, j), h30 ? array.get(tq30sp, j) : array.get(tq60sp, j),
                                 h30 ? array.get(tq30dp, j) : array.get(tq60dp, j), h30 ? array.get(tq30l1, j) : array.get(tq60l1, j),
                                 h30 ? array.get(tq30l2, j) : array.get(tq60l2, j), h30 ? array.get(tq30h20, j) : array.get(tq60h20, j),
                                 h30 ? array.get(tq30w20, j) : array.get(tq60w20, j), h30 ? array.get(tq30h9, j) : array.get(tq60h9, j),
                                 h30 ? array.get(tq30w9, j) : array.get(tq60w9, j), h30 ? array.get(tq30tc, j) : array.get(tq60tc, j),
                                 h30 ? array.get(tq30ss, j) : array.get(tq60ss, j), h30 ? array.get(tq30ma, j) : array.get(tq60ma, j),
                                 h30 ? array.get(tq30mz, j) : array.get(tq60mz, j))
                            for r = 0 to n15 - 1
                                if r >= 0 and r < n15
                                    int tr = array.get(tq15t, r)
                                    // 途中 STB に使う 15秒足: 開始が対象足の開始以上・終了未満で、確定時刻が対象足の終了以下 (取得が抜けた
                                    //  区間の 15秒足を前の対象足に含めない)
                                    if tr >= s0 and tr < e0 and array.get(tq15TC, r) <= e0
                                        f_tcClose(i, s0, r)

//  パターン p・方向 d のイベントを上位足の区間ごとに成立時刻順に処理する (単体版 f_seqRun と同じ。区間は独立)。
//  処理できるのはこの 5分足の終了より前の時刻 (それより後・ちょうどのイベントは次の 5分足で処理) で、上位足の帯が分かっているもの。
//  合図のうち、この 5分足の開始以上・終了未満に成立したものだけを tcSigT に残す
f_tcSeqRun(int p, int d) =>
    int bit = d == 0 ? 1 : 2
    array<int> blocked = array.new_int()
    int guard = 0
    while guard < 5000
        guard += 1
        int n = array.size(tcET)
        int pk = -1
        int pkSeg = na
        int pkB = na
        for e = 0 to n - 1
            if e >= 0 and e < n and array.get(tcEP, e) == p and int(array.get(tcEDone, e) / bit) % 2 == 0
                int te = array.get(tcET, e)
                int sgE = 0
                int bE = 0
                bool known = te < time_close
                if known and tcHtfOn
                    if na(tcHFront) or te >= tcHFront
                        known := false
                    else
                        [sg1, b1, st1] = f_tcHtfInfo(te)
                        known := st1 != 1
                        sgE := st1 == 0 ? nz(sg1, -1) : -1
                        bE := st1 == 0 ? b1 : na
                if known and not array.includes(blocked, sgE)
                    bool better = pk < 0
                    if not better
                        int tp = array.get(tcET, pk)
                        int gi = array.get(tcEG, e)
                        int gp = array.get(tcEG, pk)
                        int ri = array.get(tcER, e)
                        int rp = array.get(tcER, pk)
                        bool sub = gi == 1 and gp == 1 and array.get(tcESub, e) < array.get(tcESub, pk)
                        better := te < tp or (te == tp and (gi < gp or (gi == gp and (ri < rp or (ri == rp and sub)))))
                    if better
                        pk := e
                        pkSeg := sgE
                        pkB := bE
        if pk < 0
            break
        int t   = array.get(tcET, pk)
        int b   = pkB
        int i   = array.get(tcER, pk)
        int g   = array.get(tcEG, pk)
        int ms  = array.get(tcEMS, pk)
        int mb  = array.get(tcEMB, pk)
        bool mid = array.get(tcESub, pk) == 0
        int tgt = array.get(tcETgt, pk)
        int dn  = array.get(tcEDone, pk) + bit
        if dn == 3
            array.remove(tcET, pk)
            array.remove(tcEG, pk)
            array.remove(tcER, pk)
            array.remove(tcESub, pk)
            array.remove(tcEMS, pk)
            array.remove(tcEMB, pk)
            array.remove(tcETgt, pk)
            array.remove(tcEDone, pk)
            array.remove(tcEP, pk)
        else
            array.set(tcEDone, pk, dn)
        if not (tcHtfOn and na(b))
            if tcHtfOn
                array.push(tcLgP, p)
                array.push(tcLgD, d)
                array.push(tcLgSeg, pkSeg)
                array.push(tcLgT, t)
                array.push(tcLgG, g)
                array.push(tcLgR, i)
                array.push(tcLgSub, mid ? 0 : 1)
                array.push(tcLgMS, ms)
                array.push(tcLgMB, mb)
                array.push(tcLgTgt, tgt)
                if array.size(tcLgP) > 3000
                    array.shift(tcLgP)
                    array.shift(tcLgD)
                    array.shift(tcLgSeg)
                    array.shift(tcLgT)
                    array.shift(tcLgG)
                    array.shift(tcLgR)
                    array.shift(tcLgSub)
                    array.shift(tcLgMS)
                    array.shift(tcLgMB)
                    array.shift(tcLgTgt)
            int j = f_tcSlotFor(p, d, pkSeg)
            if g == 0
                if p == 0
                    array.set(tcPcT, d * 4 + i, t)
                    array.set(tcPcB, d * 4 + i, ms)
                f_tcCdDropTf(p, d, j, i, b)
            else
                int m = d == 0 ? ms : mb
                if p == 0 and mid and f_tcClrOn(i) and not na(array.get(tcPcT, d * 4 + i)) and array.get(tcPcT, d * 4 + i) == t
                    m := 0
                if f_tcSeqEvt(p, d, j, i, t, m, b) and t >= time and t < time_close
                    int q = p * 2 + d
                    array.set(tcSigT, q, na(array.get(tcSigT, q)) ? t : math.max(array.get(tcSigT, q), t))

//  欠けていた上位足の帯が届いて区間 seg が前の区間とつながったとき: その区間の処理済みイベントを処理待ちに戻し、候補を消す
//  (単体版 f_requeueSeg と同じ。組み直しで揃っても、評価済みの 5分足の合図は新規発注に使わない)
f_tcRequeueSeg(int seg) =>
    for p = 0 to 1
        for d = 0 to 1
            int minT = na
            int j = 0
            while j < array.size(tcLgP)
                if array.get(tcLgP, j) == p and array.get(tcLgD, j) == d and array.get(tcLgSeg, j) == seg
                    int tj = array.get(tcLgT, j)
                    minT := na(minT) or tj < minT ? tj : minT
                    array.push(tcEP, p)
                    array.push(tcET, tj)
                    array.push(tcEG, array.get(tcLgG, j))
                    array.push(tcER, array.get(tcLgR, j))
                    array.push(tcESub, array.get(tcLgSub, j))
                    array.push(tcEMS, array.get(tcLgMS, j))
                    array.push(tcEMB, array.get(tcLgMB, j))
                    array.push(tcETgt, array.get(tcLgTgt, j))
                    array.push(tcEDone, d == 0 ? 2 : 1)
                    array.remove(tcLgP, j)
                    array.remove(tcLgD, j)
                    array.remove(tcLgSeg, j)
                    array.remove(tcLgT, j)
                    array.remove(tcLgG, j)
                    array.remove(tcLgR, j)
                    array.remove(tcLgSub, j)
                    array.remove(tcLgMS, j)
                    array.remove(tcLgMB, j)
                    array.remove(tcLgTgt, j)
                else
                    j += 1
            for jj = 0 to 2
                int q = (p * 2 + d) * 3 + jj
                if not na(array.get(tcSlSeg, q)) and array.get(tcSlSeg, q) == seg
                    array.set(tcSlSeg, q, na)
                    for kk = 1 to 3
                        f_tcCdClr(p, d * 3 + jj, kk)
            int ls = array.get(tcSgLast, p * 2 + d)
            if not na(minT) and not na(ls) and ls >= minT
                array.set(tcSgLast, p * 2 + d, na)

f_tcPName(int p) =>
    p == 0 ? "帯→フラット" : "フラット→帯＋端の線転換"

// ---- 静的 Zone の索引 (下限の昇順。共通幅の Zone と FVG を分け、区間検索の範囲をそれぞれの最大幅で決める) ----
// 下限が x 以上の最初の位置
f_lbLower(array<LbZone> a, float x) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = math.floor((lo + hi) / 2)
        LbZone zm = array.get(a, mid)
        if zm.bot < x
            lo := mid + 1
        else
            hi := mid
    lo

// 上限が x 以上の最初の位置 (lbFvgsT)
f_lbLowerT(array<LbZone> a, float x) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = math.floor((lo + hi) / 2)
        LbZone zm = array.get(a, mid)
        if zm.top < x
            lo := mid + 1
        else
            hi := mid
    lo

// ---- 帯の表示 (LAB-2 と同じく Zone を登録・変更した足で描く。売買には使わない) ----
// 統合帯の名称: 時間足ごとに 1 行・上位の時間足から・行の中はアキュム / MA / 水平線 / 出来高POC / FVG の順・同じ時間足×根拠は 1 回
//  (名称の種類は有限なので数百文字まで)
f_dsName(array<LbZone> mem) =>
    string tx = ""
    int n = array.size(mem)
    for r = 0 to 5
        array<string> items = array.new_string()
        if n > 0
            for t = 0 to 6
                for i = 0 to n - 1
                    LbZone z = array.get(mem, i)
                    if z.typ == t and f_zAtRank(z, r)
                        string it = f_zItem(z)
                        if not array.includes(items, it)
                            array.push(items, it)
        if array.size(items) > 0
            tx := tx + (tx == "" ? "" : "\n") + f_tfNameR(r) + "｜" + array.join(items, "＋")
    tx

// 帯を描く: 左端 = 構成 Zone (MA を除く。MA は毎足動くため) の最も早い登録足、色 = 種類が 1 つならその色・混在は fuchsia
f_dsBox(LbDsG g) =>
    LbZone z0 = array.get(g.mem, 0)
    int  lft  = bar_index
    bool mix  = false
    for i = 0 to array.size(g.mem) - 1
        LbZone z = array.get(g.mem, i)
        if z.typ != 1
            lft := math.min(lft, z.aBar)
        if z.typ != z0.typ
            mix := true
    color c = mix ? color.fuchsia : z0.typ == 0 ? color.teal : z0.typ == 1 ? color.blue : z0.typ == 2 ? color.orange : z0.typ == 3 ? color.purple :
         z0.typ == 5 ? color.maroon : z0.typ == 6 ? color.olive : color.green
    g.bx := box.new(math.max(lft, bar_index - 4999), g.top, bar_index + 1, g.bot, border_color = color.new(c, 40), bgcolor = color.new(c, 88),
         extend = extend.right)
    g.lb := label.new(bar_index + 3, (g.bot + g.top) / 2.0, f_dsName(g.mem), style = label.style_label_left, color = color.new(c, 75),
         textcolor = color.new(c, 0), size = size.tiny, textalign = text.align_left)
    true

// 帯と名称を消す
f_dsErase(LbDsG g) =>
    box.delete(g.bx)
    label.delete(g.lb)
    true

// 名称を最新足の 3 本先へ (最後の確定履歴足と、その後のリアルタイムの確定足で呼ぶ)
f_dsLblX() =>
    int ng = array.size(lbDsG)
    if ng > 0
        for i = 0 to ng - 1
            LbDsG g = array.get(lbDsG, i)
            if not g.gone
                label.set_x(g.lb, bar_index + 3)
    true

f_dsCap() =>
    while array.size(lbDsG) > dsZoneMax
        LbDsG og = array.shift(lbDsG)
        f_dsErase(og)
    true

// 統合の対象: アキュム・MA・水平線・出来高POC。FVG / iFVG は本来の上下限で個別に表示し、統合にも他の帯のつなぎにも使わない
f_dsMerge(LbZone z) =>
    z.typ != 4

// Zone を表示に置く: 統合の対象なら、実際に重なる帯 (EPS 込み・統合の対象の帯だけ) をすべて (連鎖を含む) 1 つにまとめて描き直す。
//  needHit = 重なる帯がなければ置かない (MA: 単独では帯を作らず線だけ)。戻り値 = 置いたか
f_dsPut(LbZone z, bool needHit) =>
    array<LbZone> mem = array.new<LbZone>()
    array.push(mem, z)
    LbDsG ng = LbDsG.new(na, na, z.bot, z.top, false, mem)
    bool any  = false
    bool more = f_dsMerge(z)
    while more
        more := false
        int i = 0
        while i < array.size(lbDsG)
            LbDsG g = array.get(lbDsG, i)
            bool hit = false
            if not g.gone
                LbZone g0 = array.get(g.mem, 0)
                if f_dsMerge(g0)
                    hit := g.bot <= ng.top + EPS and ng.bot <= g.top + EPS
            if hit
                ng.bot := math.min(ng.bot, g.bot)
                ng.top := math.max(ng.top, g.top)
                for j = 0 to array.size(g.mem) - 1
                    array.push(ng.mem, array.get(g.mem, j))
                f_dsErase(g)
                array.remove(lbDsG, i)
                more := true
                any  := true
            else
                i += 1
    bool put = any or not needHit
    if put
        f_dsBox(ng)
        array.push(lbDsG, ng)
        f_dsCap()
    put

// 新しい Zone (FVG は個別の帯)
f_dsAdd(LbZone z) =>
    f_dsPut(z, false)

// Zone を含む表示中の帯の位置 (なければ -1)
f_dsFind(LbZone z) =>
    int gi = -1
    int ng = array.size(lbDsG)
    if ng > 0
        for i = 0 to ng - 1
            LbDsG g = array.get(lbDsG, i)
            if gi < 0 and not g.gone
                for j = 0 to array.size(g.mem) - 1
                    LbZone q = array.get(g.mem, j)
                    if q.id == z.id
                        gi := i
    gi

// iFVG に変わった Zone の帯の名称を更新
f_dsRename(LbZone z) =>
    int gi = f_dsFind(z)
    if gi >= 0
        LbDsG g = array.get(lbDsG, gi)
        label.set_text(g.lb, f_dsName(g.mem))
    gi >= 0

// Zone を帯から外す (無効化した FVG / 採用件数から外れたアキュムの辺): 残りを下限の順に並べ、実際に重なる連鎖ごとに帯を描き直す。
//  grey = 無効化した FVG を灰色の終わった帯として残す (LAB-2 と同じ見た目)
f_dsDel(LbZone z, bool grey) =>
    int gi = f_dsFind(z)
    if gi >= 0
        LbDsG g = array.get(lbDsG, gi)
        f_dsErase(g)
        array.remove(lbDsG, gi)
        array<LbZone> rest = array.new<LbZone>()
        for j = 0 to array.size(g.mem) - 1
            LbZone q = array.get(g.mem, j)
            if q.id != z.id
                int  kk = array.size(rest)
                bool go = kk > 0
                while go
                    LbZone pq = array.get(rest, kk - 1)
                    if pq.bot > q.bot
                        kk -= 1
                        go := kk > 0
                    else
                        go := false
                array.insert(rest, kk, q)
        int at = gi
        int n  = array.size(rest)
        int k  = 0
        while k < n
            LbZone q0 = array.get(rest, k)
            array<LbZone> sm = array.new<LbZone>()
            array.push(sm, q0)
            float sb = q0.bot
            float stp = q0.top
            bool  hasS = q0.typ != 1
            k += 1
            bool go = k < n
            while go
                LbZone q = array.get(rest, k)
                if q.bot <= stp + EPS
                    array.push(sm, q)
                    stp := math.max(stp, q.top)
                    hasS := hasS or q.typ != 1
                    k += 1
                    go := k < n
                else
                    go := false
            // MA だけになった部分は帯を作らない (MA は線で表示し、確定足ごとの f_dsMa でまとめ直す)
            if hasS
                LbDsG sg = LbDsG.new(na, na, sb, stp, false, sm)
                f_dsBox(sg)
                array.insert(lbDsG, at, sg)
                at += 1
        if grey
            LbDsG dg = LbDsG.new(na, na, z.bot, z.top, true, array.new<LbZone>())
            dg.bx := box.new(math.max(z.aBar, bar_index - 4999), z.top, bar_index, z.bot, border_color = color.new(color.green, 40),
                 bgcolor = color.new(color.gray, 92), extend = extend.none, text = f_tfName(z.typ, z.tf) + "｜" + f_zItem(z), text_size = size.tiny, text_color = color.new(color.green, 20))
            array.push(lbDsG, dg)
            f_dsCap()
    gi >= 0

// MA の帯は毎足動く: 確定足ごとに (その足の Zone の登録の後で) MA を帯から外し、アキュム・水平線・出来高POC の帯と重なるときだけ
//  まとめ直す (名称に MA の時間足・EMA 本数を併記)。重ならない MA は帯を作らず線だけ。2 本の MA が重なってつながる場合のため、
//  置けなかった 1 本目は 2 本目の後にもう一度試す
f_dsMa() =>
    if not na(lbMa1)
        f_dsDel(lbMa1, false)
    if not na(lbMa2)
        f_dsDel(lbMa2, false)
    bool p1 = false
    bool p2 = false
    if not na(lbMa1)
        p1 := f_dsPut(lbMa1, true)
    if not na(lbMa2)
        p2 := f_dsPut(lbMa2, true)
    if not na(lbMa1) and not p1 and p2
        f_dsPut(lbMa1, true)
    true

f_lbAdd(LbZone z) =>
    array<LbZone> arr = z.typ == 4 ? lbFvgs : lbZs
    int i = f_lbLower(arr, z.bot)
    array.insert(arr, i, z)
    if z.typ == 4
        array.insert(lbFvgsT, f_lbLowerT(lbFvgsT, z.top), z)
        st.maxWF := math.max(st.maxWF, z.top - z.bot)
    else
        array.insert(lbZsT, f_lbLowerT(lbZsT, z.top), z)
        st.maxW := math.max(st.maxW, z.top - z.bot)
    array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) + 1)
    if dsZone and z.zgShow
        f_dsAdd(z)
    true

// ZF の削除 (無効化)。共通幅の Zone は削除しない
f_lbRemove(LbZone z) =>
    int i = f_lbLower(lbFvgs, z.bot)
    int n = array.size(lbFvgs)
    bool done = false
    while i < n and not done
        LbZone q = array.get(lbFvgs, i)
        if q.id == z.id
            array.remove(lbFvgs, i)
            done := true
        else if q.bot > z.bot
            done := true
        i += 1
    int j = f_lbLowerT(lbFvgsT, z.top)
    int nT = array.size(lbFvgsT)
    bool doneT = false
    while j < nT and not doneT
        LbZone q = array.get(lbFvgsT, j)
        if q.id == z.id
            array.remove(lbFvgsT, j)
            doneT := true
        else if q.top > z.top
            doneT := true
        j += 1
    if done
        array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) - 1)
    done and doneT

// 共通幅の Zone を lbZs / lbZsT から外す (採用件数から外れたアキュムの辺 / 統合で帯が変わる・統合される水平線 Zone / 更新された旧 POC)
f_lbRemoveS(LbZone z) =>
    int i = f_lbLower(lbZs, z.bot)
    int n = array.size(lbZs)
    bool done = false
    while i < n and not done
        LbZone q = array.get(lbZs, i)
        if q.id == z.id
            array.remove(lbZs, i)
            done := true
        else if q.bot > z.bot
            done := true
        i += 1
    int j = f_lbLowerT(lbZsT, z.top)
    int nT = array.size(lbZsT)
    bool doneT = false
    while j < nT and not doneT
        LbZone q = array.get(lbZsT, j)
        if q.id == z.id
            array.remove(lbZsT, j)
            doneT := true
        else if q.top > z.top
            doneT := true
        j += 1
    if done
        array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) - 1)
    done

f_lbNew(int typ, int tf, int sub, float ctr, float bot, float top, float a, float b, int key) =>
    st.zSeq += 1
    LbZone z = LbZone.new(st.zSeq, typ, tf, sub, ctr, bot, top, a, b, key, bar_index, time)
    z.pos := close > top + EPS ? 1 : close < bot - EPS ? -1 : 0
    z

// ZG: Zone を消す (逆行・期限)。利用中なら Zone の一覧・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除。表示から外す。
//  同じ帯の他の根拠 (アキュム・水平線など) は消さない。消した根拠は lbZgUsed に残すので復活しない
f_zgKill(int i) =>
    LbZone z = array.remove(lbZgZ, i)
    if z.zgUse
        f_lbRemoveS(z)
        array.push(lbDeadNow, z.id)
    if dsZone and z.zgShow
        f_dsDel(z, false)
    z.dead := true
    true

// 静的 Zone で [a, b] と重なるものの中に、種類・時間足・副種別・中心が条件に合うものがあるか
f_lbDup(int typ, int tf, int sub, float price) =>
    bool r = false
    float a = price - zHalf
    float b = price + zHalf
    int n = array.size(lbZs)
    int i = f_lbLower(lbZs, a - st.maxW - EPS)
    while i < n and not r
        LbZone z = array.get(lbZs, i)
        if z.bot > b + EPS
            break
        if z.typ == typ and z.tf == tf and z.sub == sub and z.ctr == price
            r := true
        i += 1
    r

// ZE: その時間足のフィボ Zone をすべて外す (Zone の一覧・表示・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除)
f_zeClear(int k) =>
    int n = array.size(lbZeZ)
    if n > 0
        for i = n - 1 to 0
            LbZone z = array.get(lbZeZ, i)
            if z.tf == k
                array.remove(lbZeZ, i)
                f_lbRemoveS(z)
                if dsZone
                    f_dsDel(z, false)
                z.dead := true
                array.push(lbDeadNow, z.id)
    true

// ZE: 最新の波の 4 水準を登録 (価格 = 終点 + 比率 × (起点 − 終点)、帯 = 価格 ± 共通幅。接触は登録の次の足から)
f_zeSet(int k, float o, float e, float d, float id, float t) =>
    array<float> rs = array.from(0.236, 0.382, 0.5, 0.618)
    for j = 0 to 3
        float r = array.get(rs, j)
        float p = e + r * (o - e)
        LbZone z = f_lbNew(5, k, int(d), p, p - zHalf, p + zHalf, r, t, int(id))
        f_lbAdd(z)
        array.push(lbZeZ, z)
    int b = k * 5
    array.set(lbZeLast, b, o)
    array.set(lbZeLast, b + 1, e)
    array.set(lbZeLast, b + 2, d)
    array.set(lbZeLast, b + 3, id)
    array.set(lbZeLast, b + 4, 1)
    true

// ZE: 受信した波が採用中の波と同じか (起点・終点・方向・波 ID がすべて同じで、採用中)
f_zeSame(int k, float o, float e, float d, float id) =>
    int b = k * 5
    array.get(lbZeLast, b + 4) == 1 and array.get(lbZeLast, b) == o and array.get(lbZeLast, b + 1) == e and array.get(lbZeLast, b + 2) == d
         and array.get(lbZeLast, b + 3) == id

// Accum を固定 → 上辺・下辺の Zone を登録
f_zaKeep(int k) =>
    k == 0 ? zaKeep1 : k == 1 ? zaKeep2 : zaKeep3

// Accum を固定 → 上辺・下辺の Zone を登録し、その時間足で最新 N 箱を超えた古い箱 (上辺・下辺のセット) を外す
//  (外した辺: Zone の一覧・表示・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除する。既存ポジションの SL は変えない)
f_lbAccFix(LbAcc q) =>
    LbZone zu = f_lbNew(0, q.tf, 1, q.up, q.up - zHalf, q.up + zHalf, q.lo, q.up, q.aid)
    LbZone zl = f_lbNew(0, q.tf, -1, q.lo, q.lo - zHalf, q.lo + zHalf, q.lo, q.up, q.aid)
    f_lbAdd(zu)
    f_lbAdd(zl)
    array.push(lbAccZ, zu)
    array.push(lbAccZ, zl)
    int nk = 0
    for i = 0 to array.size(lbAccZ) - 1
        LbZone qz = array.get(lbAccZ, i)
        if qz.tf == q.tf
            nk += 1
    while nk > 2 * f_zaKeep(q.tf)
        int oi = 0
        bool fnd = false
        while not fnd
            LbZone qz = array.get(lbAccZ, oi)
            if qz.tf == q.tf
                fnd := true
            else
                oi += 1
        LbZone zo = array.remove(lbAccZ, oi)
        f_lbRemoveS(zo)
        if dsZone
            f_dsDel(zo, false)
        zo.dead := true
        array.push(lbDeadNow, zo.id)
        st.nAccOut += 1
        nk -= 1
    true

// 確定足 1 本の Zone の状態更新。戻り値 [接触の方向 (0 なし), 区分, 待機を解除する方向 (0 なし)]
//  zb / zt: 判定に使う帯 (Zone の帯。水平線 Zone は統合後の帯)
f_lbStep(LbZone z, float zb, float zt) =>
    bool tch = low <= zt + EPS and high >= zb - EPS
    int  np  = close > zt + EPS ? 1 : close < zb - EPS ? -1 : 0
    int  cs  = 0
    int  cc  = 0
    int  xs  = 0
    if np != 0 and z.pos != 0 and np != z.pos
        // 終値で帯を抜けた: 反対側の待機を解除 (上抜け → SHORT / 下抜け → LONG)。期限内に直前の突破と逆へ抜けて戻った = ダマシ
        xs := -np
        if z.brk == -np and (fakeWin == 0 or bar_index - z.brkBar <= fakeWin)
            cs    := np
            cc    := 2
            z.brk := 0
        else
            z.brk    := np
            z.brkBar := bar_index
        z.pos := np
    else
        if np != 0 and z.pos == 0
            z.pos := np
        if tch and z.pos != 0
            cs := z.pos == -1 ? -1 : 1
            cc := (cs == -1 and z.brk == -1) or (cs == 1 and z.brk == 1) ? 3 : 1
    [cs, cc, xs]

f_waitHas(LbWait w, int zid) =>
    bool r = false
    int n = array.size(w.ids)
    if n > 0
        for i = 0 to n - 1
            if array.get(w.ids, i) == zid
                r := true
    r

f_wKey(int side, string key) =>
    str.tostring(side) + "#" + key

// 待機を 1 つ外す (配列と map を同期)
f_waitDel(int i) =>
    LbWait w = array.remove(lbWaits, i)
    map.remove(lbWaitMap, f_wKey(w.side, w.key))
    true

// 待機の位置 (ID で探す)
f_waitIdx(int wid) =>
    int r = -1
    int n = array.size(lbWaits)
    if n > 0
        for i = 0 to n - 1
            LbWait w = array.get(lbWaits, i)
            if w.id == wid
                r := i
    r

// 待機の Zone ID を付け替える (統合された水平線 Zone → 統合先)。同じ組・同じ方向の待機が既にあれば、最後の接触が新しい方を残す
//  (最後の接触足・接触時の帯のスナップショット・期限はそのまま)
// LAB-12: 保有中の TP 除外 Zone ID を付け替える (統合された水平線 Zone → 統合先。f_waitMove と同じ箇所で呼ぶ)
f_ordExMove(int fromId, int toId) =>
    bool hit = false
    if not na(o.exIds)
        int ix = array.indexof(o.exIds, fromId)
        if ix >= 0
            array.remove(o.exIds, ix)
            if not array.includes(o.exIds, toId)
                array.push(o.exIds, toId)
            hit := true
    hit

f_waitMove(int fromId, int toId) =>
    int n = array.size(lbWaits)
    if n > 0
        for i = n - 1 to 0
            if i < array.size(lbWaits)
                LbWait w = array.get(lbWaits, i)
                if f_waitHas(w, fromId)
                    array<int> nid = array.new_int()
                    for j = 0 to array.size(w.ids) - 1
                        int v = array.get(w.ids, j)
                        int v2 = v == fromId ? toId : v
                        if not array.includes(nid, v2)
                            int p = 0
                            int ni = array.size(nid)
                            while p < ni
                                if array.get(nid, p) > v2
                                    break
                                p += 1
                            array.insert(nid, p, v2)
                    string nk = ""
                    for p = 0 to array.size(nid) - 1
                        nk := nk + (p > 0 ? "|" : "") + str.tostring(array.get(nid, p))
                    map.remove(lbWaitMap, f_wKey(w.side, w.key))
                    LbWait o2 = map.get(lbWaitMap, f_wKey(w.side, nk))
                    bool keepW = true
                    if not na(o2)
                        if w.lBar > o2.lBar
                            array.remove(lbWaits, f_waitIdx(o2.id))
                            map.remove(lbWaitMap, f_wKey(o2.side, o2.key))
                        else
                            keepW := false
                    if keepW
                        w.ids := nid
                        w.key := nk
                        map.put(lbWaitMap, f_wKey(w.side, nk), w)
                    else
                        array.remove(lbWaits, f_waitIdx(w.id))
    true

// 水平線を 1 本登録する。元の水平線同士の価格差が統合距離以内で連鎖する既存の水平線 Zone (= 構成水平線の最安値 − 距離 〜 最高値 + 距離
// に入る Zone) があれば、最も古い Zone にまとめる (2 つ以上をつなぐ場合は他の Zone もその Zone へ統合し、待機の ID を付け替える)。
// 帯 = 構成水平線の最安値 − 共通幅 〜 最高値 + 共通幅。統合した Zone の ID・状態 (位置・突破)・登録足は変えない。統合したその足から
// 統合後の帯 1 つで通常の Zone と同じ接触・突破を判定する (統合しただけでは接触にしない: その足の高値・安値と帯の位置関係で判定)
f_swAdd(int k, int sub, float pv, int pt) =>
    st.swSeq += 1
    int pid = st.swSeq
    array<LbZone> hit = array.new<LbZone>()
    int n = array.size(lbSw)
    if n > 0
        for i = 0 to n - 1
            LbZone q = array.get(lbSw, i)
            if pv >= array.min(q.mP) - zcMerge - EPS and pv <= array.max(q.mP) + zcMerge + EPS
                array.push(hit, q)
    if array.size(hit) == 0
        LbZone z = f_lbNew(2, k, sub, pv, pv - zHalf, pv + zHalf, na, na, pt)
        z.mP  := array.from(pv)
        z.mTf := array.from(k)
        z.mT  := array.from(pt)
        z.mId := array.from(pid)
        f_lbAdd(z)
        array.push(lbSw, z)
    else
        LbZone a = array.get(hit, 0)
        if dsZone
            f_dsDel(a, false)
        f_lbRemoveS(a)
        array.push(a.mP, pv)
        array.push(a.mTf, k)
        array.push(a.mT, pt)
        array.push(a.mId, pid)
        int nh = array.size(hit)
        if nh > 1
            for h = 1 to nh - 1
                LbZone b = array.get(hit, h)
                if dsZone
                    f_dsDel(b, false)
                f_lbRemoveS(b)
                b.dead := true
                int  ib = 0
                bool fb = false
                while not fb
                    LbZone qb = array.get(lbSw, ib)
                    if qb.id == b.id
                        fb := true
                    else
                        ib += 1
                array.remove(lbSw, ib)
                for j = 0 to array.size(b.mP) - 1
                    array.push(a.mP, array.get(b.mP, j))
                    array.push(a.mTf, array.get(b.mTf, j))
                    array.push(a.mT, array.get(b.mT, j))
                    array.push(a.mId, array.get(b.mId, j))
                f_waitMove(b.id, a.id)
                f_ordExMove(b.id, a.id)
        float pMin = array.min(a.mP)
        float pMax = array.max(a.mP)
        a.ctr := (pMin + pMax) / 2.0
        a.bot := pMin - zHalf
        a.top := pMax + zHalf
        f_lbAdd(a)
        st.nSwMerge += 1
    true

// 待機の作成 / 更新 (同じ組・同じ方向があれば最後の接触足と帯のスナップショットを更新)。検索は map
f_lbUnit(int side, int cat, bool cr, bool cf, bool co, array<int> ids, string key, int tmask, float cb, float ct, float eb, float et, string desc) =>
    string mk = f_wKey(side, key)
    LbWait w = map.get(lbWaitMap, mk)
    bool found = not na(w)
    if found
        w.lBar := bar_index
        w.cBot := cb
        w.cTop := ct
        w.eBot := eb
        w.eTop := et
    else
        st.wSeq += 1
        st.nWaitNew += 1
        LbWait nw = LbWait.new(st.wSeq, key, side, cat, cr, cf, co, tmask, ids, cb, ct, eb, et, bar_index, bar_index, desc)
        array.push(lbWaits, nw)
        map.put(lbWaitMap, mk, nw)
    not found

// 他種類 (tmask に含まれない種類) の有効 Zone で [a, b] と重なるものの種類マスク
f_lbOthers(float a, float b, int tmask) =>
    int m = 0
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, a - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > b + EPS
                break
            if z.top >= a - EPS and not f_bit(tmask, z.typ) and not f_bit(m, z.typ)
                m += f_pow2(z.typ)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k) and not f_bit(tmask, 1) and not f_bit(m, 1)
            if mz.bot <= b + EPS and mz.top >= a - EPS
                m += 2
    m

// ---- TP: 利益方向の抵抗 Zone を重なりで統合した帯の近い順 ----
// 区間 1 つを統合中の帯 cur = [近端, 遠端] へ渡す: 重なれば (EPS 込み) 遠端を広げ、重ならなければそれまでの帯を確定して新しい帯を始める。
// 戻り値 = 確定した帯が 3 つになった
f_lbFeed(array<float> tps, array<float> cur, int side, float b, float t) =>
    float cn = array.get(cur, 0)
    float cf = array.get(cur, 1)
    if na(cn)
        array.set(cur, 0, side == 1 ? b : t)
        array.set(cur, 1, side == 1 ? t : b)
    else if side == 1 ? b <= cf + EPS : t >= cf - EPS
        array.set(cur, 1, side == 1 ? math.max(cf, t) : math.min(cf, b))
    else
        array.push(tps, cn)
        array.set(cur, 0, side == 1 ? b : t)
        array.set(cur, 1, side == 1 ? t : b)
    array.size(tps) >= 3

// TP 候補 (最大 3)。LONG = ref より厳密に上の Zone を下限の昇順 / SHORT = ref より厳密に下の Zone を上限の降順に、共通幅の
// Zone (LONG は lbZs、SHORT は lbZsT: 水平線の統合で帯の幅が変わるため)・FVG (LONG は lbFvgs、SHORT は lbFvgsT)・MA 2 本の 3 つの流れを合わせて 1 件ずつ読み、
// 重なりで統合しながら 3 つ目の帯が確定した時点で終える。全種類 (条件に選ばない種類も) を使う
// LAB-12: ex = TP から除く Zone ID (na = 除外なし)。通常 Zone・FVG / iFVG・MA とも、f_lbFeed で帯を統合する前に除く
f_exHas(array<int> ex, int id) =>
    not na(ex) and array.includes(ex, id)

// LAB-13: 候補 (w.ids が起点。AND は採用した全 Zone) の TP 除外 Zone = 起点と、この足で実際に重なっている有効 Zone の連鎖。
//  表示の帯と同じ規則: FVG / iFVG は個別の帯 (起点なら自身だけ。他の帯の連鎖にも入れない)、それ以外 (MA を含む) は本来の上下端で
//  EPS 込みで重なる限り連鎖 (エントリーの許容幅は足さない)。売買用の Zone データ (lbZs / lbFvgs / MA) から求め、表示の ON / OFF・件数には依存しない。
//  戻り値 [除外 ID, LONG の TP 候補に入り得る Zone を含む, SHORT の TP 候補に入り得る Zone を含む]
f_lbExZones(LbWait w) =>
    array<int> ex = array.copy(w.ids)
    bool  hasL = false
    bool  hasS = false
    float eb = na
    float et = na
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, w.eBot - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > w.eTop + EPS
                break
            if array.includes(w.ids, z.id)
                hasL := hasL or z.bot > close + EPS
                hasS := hasS or z.top < close - EPS
                if z.typ != 4
                    eb := na(eb) ? z.bot : math.min(eb, z.bot)
                    et := na(et) ? z.top : math.max(et, z.top)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        if not na(mz)
            if array.includes(w.ids, mz.id)
                hasL := hasL or mz.bot > close + EPS
                hasS := hasS or mz.top < close - EPS
                eb := na(eb) ? mz.bot : math.min(eb, mz.bot)
                et := na(et) ? mz.top : math.max(et, mz.top)
    if not na(eb)
        bool more = true
        while more
            more := false
            int n = array.size(lbZs)
            int i = f_lbLower(lbZs, eb - st.maxW - EPS)
            while i < n
                LbZone z = array.get(lbZs, i)
                if z.bot > et + EPS
                    break
                if not z.dead and z.typ != 4 and z.top >= eb - EPS and not array.includes(ex, z.id)
                    array.push(ex, z.id)
                    hasL := hasL or z.bot > close + EPS
                    hasS := hasS or z.top < close - EPS
                    eb := math.min(eb, z.bot)
                    et := math.max(et, z.top)
                    more := true
                i += 1
            for k = 0 to 1
                LbZone mz = k == 0 ? lbMa1 : lbMa2
                float  mv = k == 0 ? zbMa1 : zbMa2
                if not na(mz) and not na(mv) and f_zbUse(k)
                    if mz.bot <= et + EPS and mz.top >= eb - EPS and not array.includes(ex, mz.id)
                        array.push(ex, mz.id)
                        hasL := hasL or mz.bot > close + EPS
                        hasS := hasS or mz.top < close - EPS
                        eb := math.min(eb, mz.bot)
                        et := math.max(et, mz.top)
                        more := true
    [ex, hasL, hasS]

f_lbTargets(int side, float ref, array<int> ex) =>
    array<float> tps = array.new_float()
    array<float> cur = array.new_float(2, na)
    array<float> mb  = array.new_float()
    array<float> mt  = array.new_float()
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k) and not f_exHas(ex, mz.id)
            if (side == 1 and mz.bot > ref + EPS) or (side == -1 and mz.top < ref - EPS)
                bool front = false
                if array.size(mb) == 1
                    front := side == 1 ? mz.bot < array.get(mb, 0) : mz.top > array.get(mt, 0)
                if front
                    array.insert(mb, 0, mz.bot)
                    array.insert(mt, 0, mz.top)
                else
                    array.push(mb, mz.bot)
                    array.push(mt, mz.top)
    array<LbZone> fArr = side == 1 ? lbFvgs : lbFvgsT
    int nA = array.size(lbZs)
    int nG = array.size(fArr)
    int nM = array.size(mb)
    array<LbZone> aArr = side == 1 ? lbZs : lbZsT
    int ia = side == 1 ? f_lbLower(lbZs, ref + EPS) : f_lbLowerT(lbZsT, ref - EPS) - 1
    int ig = side == 1 ? f_lbLower(lbFvgs, ref + EPS) : f_lbLowerT(lbFvgsT, ref - EPS) - 1
    int im = 0
    bool done = false
    bool go = true
    while go
        LbZone za = na
        LbZone zg = na
        if ia >= 0 and ia < nA
            za := array.get(aArr, ia)
        if ig >= 0 and ig < nG
            zg := array.get(fArr, ig)
        // 3 つの流れの先頭のうち、LONG は下限が最小・SHORT は上限が最大のもの (0 = 共通幅 / 1 = FVG / 2 = MA / -1 = なし)
        int   pk = -1
        float bk = na
        if not na(za)
            pk := 0
            bk := side == 1 ? za.bot : za.top
        if not na(zg)
            float kg = side == 1 ? zg.bot : zg.top
            if pk < 0
                pk := 1
                bk := kg
            else if side == 1 ? kg < bk : kg > bk
                pk := 1
                bk := kg
        if im < nM
            float km = side == 1 ? array.get(mb, im) : array.get(mt, im)
            if pk < 0
                pk := 2
                bk := km
            else if side == 1 ? km < bk : km > bk
                pk := 2
                bk := km
        if pk < 0
            go := false
        else
            float b = na
            float t = na
            bool  use = true
            if pk == 0
                b := za.bot
                t := za.top
                use := not f_exHas(ex, za.id)
                ia += side == 1 ? 1 : -1
            else if pk == 1
                b := zg.bot
                t := zg.top
                use := not zg.dead and not f_exHas(ex, zg.id)
                ig += side == 1 ? 1 : -1
            else
                b := array.get(mb, im)
                t := array.get(mt, im)
                im += 1
            use := use and (side == 1 ? b > ref + EPS : t < ref - EPS)
            if use
                if f_lbFeed(tps, cur, side, b, t)
                    done := true
                    go := false
    if not done and not na(array.get(cur, 0))
        array.push(tps, array.get(cur, 0))
    tps

f_legId(int n, int k) =>
    "X" + str.tostring(n) + "_" + str.tostring(k)

// 利確の段の計画 (o.legPx / o.legLots を作り直す。完了した段は変えない)。ref: 目標を探す基準価格、base: 固定 RR の基準
f_lbPlan(float ref, float base) =>
    array<float> tps = tpMode == "固定 RR" ? array.new_float() : f_lbTargets(o.side, ref, o.exIds)
    int nT = array.size(tps)
    for k = 0 to 2
        array.set(o.legPx, k, na)
        array.set(o.legLots, k, 0)
    int rem = o.lotN - o.closedLots
    int s0  = o.stage
    if rem > 0 and s0 < 3
        if tpMode == "分割利確" and nT > 0
            int   m    = math.min(nT, 3 - s0)
            int   prev = o.closedLots
            float cumW = 0.0
            for k = 1 to 3
                if k <= s0
                    cumW += k == 1 ? tpW1 : k == 2 ? tpW2 : tpW3
            for j = 0 to m - 1
                int stg = s0 + j + 1
                cumW += stg == 1 ? tpW1 : stg == 2 ? tpW2 : tpW3
                int cum = j == m - 1 ? o.lotN : math.min(o.lotN, math.floor(cumW / 100.0 * o.lotN + 0.5))     // 累積を四捨五入
                int q   = cum - prev
                if q > 0
                    array.set(o.legPx, stg - 1, array.get(tps, j))
                    array.set(o.legLots, stg - 1, q)
                    prev := cum
        else if tpMode == "選択した TP で全決済" and nT > 0
            array.set(o.legPx, s0, array.get(tps, math.min(tpSel, nT) - 1))
            array.set(o.legLots, s0, rem)
        else
            array.set(o.legPx, s0, base + o.side * fixRR * math.abs(base - o.sl))
            array.set(o.legLots, s0, rem)
    nT

// 計画した段の注文を出す (同じ ID = 変更)。計画にない段は取り消す
f_lbIssue() =>
    for k = 1 to 3
        string xid = f_legId(o.n, k)
        int    q   = array.get(o.legLots, k - 1)
        if q > 0
            strategy.exit(xid, o.id, qty = q * o.lotQ, stop = o.stop, limit = array.get(o.legPx, k - 1))
        else
            strategy.cancel(xid)
    true

// 残っている段のうち最も遠い TP = 最終 TP (建値ロックの解除目標。ロック開始時に lkTP へ固定する)
f_lbFarTp() =>
    float r = na
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            r := array.get(o.legPx, k - 1)
    r

f_lbTpText() =>
    string s = ""
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            s := s + " TP" + str.tostring(k) + " " + str.tostring(array.get(o.legPx, k - 1), "#.##") +
                 " (" + str.tostring(array.get(o.legLots, k - 1) * mmLotStep, "#.##") + " lot)"
    s

// TP 変更の通知: 最後に通知した価格から、いずれかの段が通知幅以上動いたら全段を 1 通で通知
f_lbNotify(bool force) =>
    bool chg = force
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            float lp = array.get(o.ntfPx, k - 1)
            if na(lp)
                chg := true
            else if math.abs(array.get(o.legPx, k - 1) - lp) >= tpNtf - EPS
                chg := true
    if chg
        for k = 1 to 3
            array.set(o.ntfPx, k - 1, array.get(o.legLots, k - 1) > 0 ? array.get(o.legPx, k - 1) : na)
        if not force
            st.nTpNtf += 1
            alert("ZCL TP 変更 " + o.id + ":" + f_lbTpText() + " / SL " + str.tostring(o.stop, "#.##"), alert.freq_once_per_bar_close)
    chg

// 決済 1 件 (分割を含む) の記帳
f_lbOnExit(int i) =>
    string xid = strategy.closedtrades.exit_id(i)
    float  px  = strategy.closedtrades.exit_price(i)
    float  pf  = strategy.closedtrades.profit(i)
    int    lots = int(math.round(math.abs(strategy.closedtrades.size(i)) / o.lotQ))
    o.pnl        += pf
    st.realized  += pf
    o.closedLots += lots
    bool isTp = false
    for k = 1 to 3
        if xid == f_legId(o.n, k)
            float lp = array.get(o.legPx, k - 1)
            if not na(lp) and o.side * (px - lp) >= -EPS
                isTp := true
                o.stage := math.max(o.stage, k)
    if isTp
        o.nTp    += 1
        st.nTpHit += 1
        alert("ZCL TP 到達 " + o.id + " " + xid + " " + str.tostring(px, "#.##") + " (" + str.tostring(lots * mmLotStep, "#.##") + " lot)", alert.freq_once_per_bar_close)
    else
        o.lastStop := true
    isTp

f_lbBk(int b, float pnl, float r) =>
    array.set(bkN, b, array.get(bkN, b) + 1)
    if pnl > stBeBand
        array.set(bkW, b, array.get(bkW, b) + 1)
    else if pnl < 0
        array.set(bkL, b, array.get(bkL, b) + 1)
    else
        array.set(bkBE, b, array.get(bkBE, b) + 1)
    if pnl > 0
        array.set(bkGP, b, array.get(bkGP, b) + pnl)
    if pnl < 0
        array.set(bkGL, b, array.get(bkGL, b) - pnl)
    array.set(bkR, b, array.get(bkR, b) + r)
    array.set(bkNet, b, array.get(bkNet, b) + pnl)
    true

// 1 取引の確定 (全決済の後)。台帳は取引 ID ごとに 1 回、区分別は属する区分すべてへ
f_lbFinalize() =>
    float rJpy = strategy.convert_to_account(math.abs(o.fill - o.sl) * o.lotN * o.lotQ * syminfo.pointvalue)
    float r    = rJpy > 0 ? o.pnl / rJpy : 0.0
    f_lbBk(0, o.pnl, r)
    for t = 0 to 6
        if f_bit(o.tmask, t)
            f_lbBk(f_bkInc(t), o.pnl, r)
            if o.tmask == f_pow2(t) and o.omask == 0
                f_lbBk(f_bkOnly(t), o.pnl, r)
    if f_bit(o.tim, 0)
        f_lbBk(11, o.pnl, r)
    if f_bit(o.tim, 1)
        f_lbBk(12, o.pnl, r)
    if f_bit(o.tim, 2)
        f_lbBk(22, o.pnl, r)
    if f_bit(o.tim, 3)
        f_lbBk(23, o.pnl, r)
    if o.cReb
        f_lbBk(13, o.pnl, r)
    if o.cFake
        f_lbBk(14, o.pnl, r)
    if o.cRole
        f_lbBk(15, o.pnl, r)
    f_lbBk(o.side == 1 ? 16 : 17, o.pnl, r)
    st.nTrades += 1
    if not na(o.lbl)
        label.set_text(o.lbl, label.get_text(o.lbl) + "\n決済 合計 " + str.tostring(o.pnl, "#") + " 円 (" + str.tostring(r, "#.##") + "R)")
    r

// タイミング: 方向・種類が合い、未使用・待機の開始以後・有効期限内の最新の位置 (-1 = なし)。
//  TE は反転の確定足 = この足だけ、検知した接近足も待機の開始以後 (待機ごとに判定。同じ足の適格な TE は消費時に 1 件へまとめる)。
//  TD はこの確定 5分足の中の 1分合図だけ (待機の到達足以後の 5分足。同じ 5分足の中の前後は問わない)
// LAB-10: エントリー候補には、この確定 5分足で新しく成立したタイミングだけを使う (過去の足の成立は持ち越さない)
f_lbTim(int kind, int side) =>
    int r  = -1
    int n = array.size(lbTevs)
    if n > 0
        for i = 0 to n - 1
            LbTev e = array.get(lbTevs, i)
            if e.kind == kind and e.side == side and not e.used and e.eBar == bar_index
                r := i
    r

// LAB-10: 候補の場所 = 有効でエントリー条件に選んだ Zone の 下端 − 許容幅 〜 上端 + 許容幅 に終値がある (境界を含む)
f_lbNear(LbZone z) =>
    not z.dead and (z.aBar < bar_index or z.typ == 3) and f_condTyp(z.typ) and close >= z.bot - zNear - EPS and close <= z.top + zNear + EPS

// LAB-10: この足の候補 Zone (OR = 対象 Zone 1 個ずつ / AND = 選んだ種類ごとに 1 個ずつの組で、共通帯 ± 許容幅に終値があるもの)。
//  LbWait を一時オブジェクトとして使う (cBot / cTop = 帯または共通帯、eBot / eTop = SL 基準の帯全体)。lbWaits には入れない
f_lbUnits(int nSel) =>
    array<LbWait> us = array.new<LbWait>()
    array<LbZone> nz0 = array.new<LbZone>()
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, close - zNear - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > close + zNear + EPS
                break
            st.iter += 1
            if f_lbNear(z)
                array.push(nz0, z)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if mz.aBar < bar_index and f_condTyp(1) and close >= mz.bot - zNear - EPS and close <= mz.top + zNear + EPS
                array.push(nz0, mz)
    int nn = array.size(nz0)
    if nn > 0 and (cComb == "OR" or nSel <= 1)
        for j = 0 to nn - 1
            LbZone z = array.get(nz0, j)
            array.push(us, LbWait.new(-1, str.tostring(z.id), 0, 0, false, false, false, f_pow2(z.typ), array.from(z.id),
                 z.bot, z.top, z.bot, z.top, bar_index, bar_index, f_zName(z)))
    else if nn > 0
        // AND: 選んだ種類ごとに 1 個ずつの全組合せのうち、共通の重なりがあり、その重なり ± 許容幅に終値があるもの (深さ優先・途中で打ち切り)
        array<int> tl = array.new_int()
        for t = 0 to 6
            if f_condTyp(t)
                array.push(tl, t)
        int nt = array.size(tl)
        array<int> lst = array.new_int()
        array<int> off = array.new_int()
        array<int> cnt = array.new_int()
        bool allHave = true
        for a = 0 to nt - 1
            array.push(off, array.size(lst))
            int c = 0
            for j = 0 to nn - 1
                LbZone z = array.get(nz0, j)
                if z.typ == array.get(tl, a)
                    array.push(lst, j)
                    c += 1
            array.push(cnt, c)
            allHave := allHave and c > 0
        if allHave
            array<int>   od  = array.new_int(nt, -1)
            array<float> pOb = array.new_float(nt, na)
            array<float> pOt = array.new_float(nt, na)
            int lv = 0
            int nodes = 0
            while lv >= 0
                int nxt = array.get(od, lv) + 1
                if nxt >= array.get(cnt, lv)
                    array.set(od, lv, -1)
                    lv -= 1
                else
                    array.set(od, lv, nxt)
                    nodes += 1
                    LbZone zz = array.get(nz0, array.get(lst, array.get(off, lv) + nxt))
                    float ob  = lv > 0 ? math.max(array.get(pOb, lv - 1), zz.bot) : zz.bot
                    float ot2 = lv > 0 ? math.min(array.get(pOt, lv - 1), zz.top) : zz.top
                    if ob <= ot2 + EPS and close >= ob - zNear - EPS and close <= ot2 + zNear + EPS
                        array.set(pOb, lv, ob)
                        array.set(pOt, lv, ot2)
                        if lv < nt - 1
                            lv += 1
                        else
                            float eb = na
                            float et = na
                            int   tm = 0
                            array<int> ids = array.new_int()
                            string desc = ""
                            for a = 0 to nt - 1
                                LbZone z = array.get(nz0, array.get(lst, array.get(off, a) + array.get(od, a)))
                                eb := na(eb) ? z.bot : math.min(eb, z.bot)
                                et := na(et) ? z.top : math.max(et, z.top)
                                tm += f_pow2(z.typ)
                                int p = 0
                                int ni = array.size(ids)
                                while p < ni
                                    if array.get(ids, p) > z.id
                                        break
                                    p += 1
                                array.insert(ids, p, z.id)
                                desc := desc + (a > 0 ? " + " : "") + f_zName(z)
                            string key = ""
                            for p = 0 to array.size(ids) - 1
                                key := key + (p > 0 ? "|" : "") + str.tostring(array.get(ids, p))
                            array.push(us, LbWait.new(-1, key, 0, 0, false, false, false, tm, ids, ob, ot2, eb, et, bar_index, bar_index, desc))
            st.maxCombo := math.max(st.maxCombo, nodes)
    us

// ---- Zone タッチ通知 (LAB-5)。売買の接触・待機・消費の状態とは別に持ち、売買の判定は読まない・変えない ----
var array<int> lbNtfIds = array.new_int()     // 最後に通知した足で接触していた Zone の ID (この中の Zone だけに接触しても再通知しない)
var int        lbNtfN   = 0                   // 通知した回数 (確認用)

f_ntfHit(LbZone z) =>
    low <= z.top + EPS and high >= z.bot - EPS

// この足の高値・安値が届いた有効な Zone (共通幅の Zone・FVG / iFVG・MA 2 本。無効化・統合で外れた Zone は含まない)
f_ntfTouched() =>
    array<LbZone> t = array.new<LbZone>()
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, low - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > high + EPS
                break
            if not z.dead and f_ntfHit(z)
                array.push(t, z)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if f_ntfHit(mz)
                array.push(t, mz)
    t

// 通知 1 件分の行: 時間足・種類・価格帯
f_ntfLine(LbZone z) =>
    f_zName(z) + "  " + str.tostring(z.bot, "#.##") + "〜" + str.tostring(z.top, "#.##")

bool lbRun  = is5mChart
bool sessOK = not seUse or f_inSession(time_close)

if lbRun
    // ---- 再計算設定の保護 (ACC-2): ヒストリカルの足は確定時の 1 回だけ実行される前提
    if barstate.ishistory
        if lbExecBar == bar_index
            lbExecN += 1
        else
            lbExecBar := bar_index
            lbExecN   := 1
        if lbExecN > 1
            runtime.error("ZCL: ヒストリカルの同じ足でスクリプトが 2 回以上実行されました。プロパティの「再計算: 注文約定後」などを OFF にしてください。")

if lbRun and barstate.isconfirmed
    st.iter := 0
    // BEL-1: 前の確定足までに始まったロックは、この足の高値・安値が目標 / 初期 SL に届いたら解除 (解除した足はまだ禁止)
    bool lkBlk = lkOn
    if lkOn and bar_index > lkBar and (lkSide == 1 ? (high >= lkTP or low <= lkSL) : (low <= lkTP or high >= lkSL))
        lkOn := false

    // ---- (A) 約定・決済の確認 (分割決済の記帳 → 約定 → 全決済で取引を確定) ----------------------------
    int ct = strategy.closedtrades
    if ct > st.ctSeen
        for i = st.ctSeen to ct - 1
            if strategy.closedtrades.entry_id(i) == o.id
                f_lbOnExit(i)
        st.ctSeen := ct
    bool opn = false
    int  ot  = strategy.opentrades
    if ot > 0
        opn := strategy.opentrades.entry_id(ot - 1) == o.id
    if o.state == 1
        if opn
            o.fill  := strategy.opentrades.entry_price(ot - 1)
            o.state := 2
            if math.abs(math.abs(strategy.position_size) - o.lotN * o.lotQ) > o.lotN * o.lotQ * 1e-6
                st.nQtyAnom += 1
            if o.side * (o.fill - o.sl) <= 0
                // 約定ずれで初期 SL が約定価格の反対側: 出口注文を出さず成行で決済 (ACC と同じ)
                for k = 1 to 3
                    strategy.cancel(f_legId(o.n, k))
                strategy.close(o.id)
                o.state := 3
                st.nBadExit += 1
            else if o.tp1Fix
                // 約定を確認: 固定 RR の TP1 (建値の割合方式の基準) は実約定価格から計算し直す。TP の注文は (B5) で計画し直す
                o.tp1E := o.fill + o.side * fixRR * math.abs(o.fill - o.sl)
        else if o.closedLots > 0
            // 約定した足の中で全決済まで終わった
            o.fill  := strategy.closedtrades.entry_price(ct - 1)
            o.state := 2
        else if bar_index > o.bar
            strategy.cancel(o.id)
            for k = 1 to 3
                strategy.cancel(f_legId(o.n, k))
            o.state := 0
    if o.state >= 2 and not opn
        // 全決済: 建値ストップでの決済ならロック (BEL-1)
        if beLock and o.be and o.lastStop and o.state == 2 and not na(o.lastTp)
            lkOn   := true
            lkSide := o.side
            lkSL   := o.sl
            lkTP   := o.lastTp
            lkBar  := bar_index
            lkBlk  := true
        f_lbFinalize()
        o.state := 0

    // 管理中の注文 ID 以外の建玉があれば停止 (ACC-2)
    if strategy.opentrades > 0
        string otId = strategy.opentrades.entry_id(strategy.opentrades - 1)
        if otId != o.id
            runtime.error("ZCL: 管理外の建玉 " + otId + " を検出しました (管理中 " + o.id + ")。プロパティの再計算設定を確認してください。")

    // ---- (B1) 確定した上位足の値から Zone を登録 / 更新 --------------------------------------------
    array.clear(lbDeadNow)
    // ZA: 新しい ID = 前回届いた ID と違う (未固定が残っていれば固定)。同じ ID は形成中に上下限を更新し、形成中フラグ 0 で固定
    array<float> fU = array.from(f1u, f2u, f3u)
    array<float> fL = array.from(f1l, f2l, f3l)
    array<int>   fI = array.from(f1i, f2i, f3i)
    array<int>   fA = array.from(f1a, f2a, f3a)
    for k = 0 to 2
        int   aid = array.get(fI, k)
        float u   = array.get(fU, k)
        float l   = array.get(fL, k)
        if f_zaUse(k) and not na(aid) and not na(u) and not na(l)
            bool forming = array.get(fA, k) == 1
            int  last    = array.get(lbAccLast, k)
            if na(last) or aid != last
                array.set(lbAccLast, k, aid)
                int na0 = array.size(lbAccs)
                if na0 > 0
                    for i = na0 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k
                            f_lbAccFix(q)
                            array.remove(lbAccs, i)
                LbAcc b = LbAcc.new(k, aid, u, l)
                if forming
                    array.push(lbAccs, b)
                else
                    f_lbAccFix(b)
            else
                int na1 = array.size(lbAccs)
                if na1 > 0
                    for i = na1 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k and q.aid == aid
                            q.up := u
                            q.lo := l
                            if not forming
                                f_lbAccFix(q)
                                array.remove(lbAccs, i)
    // ZC: 新しい Pivot (時刻キーが前回と違う) はすべて登録。統合距離以内で連鎖する既存の水平線 Zone があればまとめる (f_swAdd)
    array<float> pH  = array.from(s1h, s2h, s3h, s4h)
    array<int>   pHt = array.from(s1ht, s2ht, s3ht, s4ht)
    array<float> pL  = array.from(s1l, s2l, s3l, s4l)
    array<int>   pLt = array.from(s1lt, s2lt, s3lt, s4lt)
    for k = 0 to 3
        if f_zcUse(k)
            for s = 0 to 1
                float pv = s == 0 ? array.get(pH, k) : array.get(pL, k)
                int   pt = s == 0 ? array.get(pHt, k) : array.get(pLt, k)
                int   lt = s == 0 ? array.get(lbPivLastH, k) : array.get(lbPivLastL, k)
                if not na(pt) and not na(pv) and (na(lt) or pt != lt)
                    if s == 0
                        array.set(lbPivLastH, k, pt)
                    else
                        array.set(lbPivLastL, k, pt)
                    int sub = s == 0 ? 1 : -1
                    f_swAdd(k, sub, pv, pt)
    // ZD: 外部 POC (MtfPocFeedXAU) の受信。この 5分足に届いている確定済み上位足の出力を読み、正常な値で中心が前回の有効値から
    //  変わったら、同じ時間足の旧 POC を無効化して新 POC を登録する (時間足ごとに最新の確定 POC 1 つだけが有効。旧 POC は Zone の一覧・
    //  表示・TP 候補から外し、旧 POC を含む待機は (B3) で解除。時刻の更新だけでは何もしない。前と同じ価格に戻った場合も新 POC として採用)。
    //  状態: 0 検知 OFF / 1 正常 / 2 計算不能 (時刻 < 0) / 3 履歴不足 (時刻 na) / 8 外部側 OFF (時刻 0) / 9 未接続・誤接続
    //  (protocol ≠ 10001、時刻が時刻として不自然、正常なのに上下限が na / 上限 <= 下限)。8 / 9 は新規発注を止める (close で代用しない)
    bool zdProtoOK = not na(zdProto) and zdProto == 10001
    bool zdBad = false
    array<float> dL = array.from(zdL1, zdL2, zdL3, zdL4)
    array<float> dU = array.from(zdU1, zdU2, zdU3, zdU4)
    array<float> dT = array.from(zdT1, zdT2, zdT3, zdT4)
    for k = 0 to 3
        int stt = 0
        if f_zdUse(k)
            float tt = array.get(dT, k)
            float lo = array.get(dL, k)
            float up = array.get(dU, k)
            if not zdProtoOK
                stt := 9
            else if na(tt)
                stt := 3
            else if tt == 0
                stt := 8
            else if math.abs(tt) < 1e11 or math.abs(tt) >= time or tt != math.round(tt)
                stt := 9
            else if tt < 0
                stt := 2
            else if na(lo) or na(up)
                stt := 9
            else if up <= lo
                stt := 9
            else
                stt := 1
                float pc = (lo + up) / 2.0
                float lp = array.get(lbPocLast, k)
                if na(lp) or pc != lp
                    array.set(lbPocLast, k, pc)
                    LbZone oz = array.get(lbPocCur, k)
                    if not na(oz)
                        f_lbRemoveS(oz)
                        if dsZone
                            f_dsDel(oz, false)
                        oz.dead := true
                        array.push(lbDeadNow, oz.id)
                    LbZone nzp = f_lbNew(3, k, 0, pc, pc - zHalf, pc + zHalf, lo, up, int(tt))
                    // POC は受信した足から接触判定に使う (確定済み上位足の値で、この 5分足の開始時点から利用可能)。帯の外側の位置は
                    //  前の足の終値で決め、この足は既存の Zone と同じ規則 (高値・安値の接触 / 終値の突破) で判定する
                    if not na(labC1)
                        nzp.pos := labC1 > nzp.top + EPS ? 1 : labC1 < nzp.bot - EPS ? -1 : 0
                    f_lbAdd(nzp)
                    array.set(lbPocCur, k, nzp)
        array.set(lbZdStat, k, stt)
        if stt == 8 or stt == 9
            zdBad := true
    // ZE: 外部 LongFibWave (13 系列) の受信。4時間足・日足それぞれ最新の 1 波だけ (0.236 / 0.382 / 0.5 / 0.618 の 4 Zone)。
    //  状態: 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続 (protocol ≠ 20001、状態・波 ID・
    //  更新確定時刻が不自然、有効なのに起点・終点・方向が不正、無効なのに起点・終点・方向がある)。9 だけ新規発注を止める (close で代用しない)。
    //  8 (外部側の計算 OFF) は 2 / 3 と同じ正常な無効状態 (その時間足の Zone と待機を外すだけ)。
    //  有効な波の起点・終点・方向・波 ID のどれかが変わったら旧 4 Zone を外して (待機も解除) 新しい 4 Zone を登録 (同じなら何もしない)。
    //  波なし・保留中・外部 OFF ではその時間足の Zone を外す。誤接続では Zone を保つ。ZE 検知 OFF では何もしない
    bool zeProtoOK = not na(zeProto) and zeProto == 20001
    bool zeBad = false
    array<float> eO = array.from(ze4O, zeDO)
    array<float> eE = array.from(ze4E, zeDE)
    array<float> eD = array.from(ze4D, zeDD)
    array<float> eI = array.from(ze4I, zeDI)
    array<float> eS = array.from(ze4S, zeDS)
    array<float> eT = array.from(ze4T, zeDT)
    for k = 0 to 1
        int stt = 0
        if f_zeUse(k)
            float fo = array.get(eO, k)
            float fe = array.get(eE, k)
            float fd = array.get(eD, k)
            float fi = array.get(eI, k)
            float fs = array.get(eS, k)
            float ft = array.get(eT, k)
            if not zeProtoOK
                stt := 9
            else if na(fs) or na(fi) or na(ft) or na(fd)
                stt := 9
            else if fs != math.round(fs) or fs < 0 or fs > 3 or fi != math.round(fi) or fi < 0
                stt := 9
            else if math.abs(ft) < 1e11 or ft > time_close or ft != math.round(ft)
                stt := 9
            else if fs == 3
                stt := na(fo) or na(fe) ? 9 : fo == fe or not (fd == 1 or fd == -1) ? 9 : 1
            else
                stt := not na(fo) or not na(fe) or fd != 0 ? 9 : fs == 0 ? 8 : fs == 1 ? 2 : 3
            if stt == 1
                if not f_zeSame(k, fo, fe, fd, fi)
                    f_zeClear(k)
                    f_zeSet(k, fo, fe, fd, fi, ft)
            else if stt == 2 or stt == 3 or stt == 8
                f_zeClear(k)
                array.set(lbZeLast, k * 5 + 4, stt)
        array.set(lbZeStat, k, stt)
        if stt == 9
            zeBad := true
    // ZF: 新しい上位足 (キー = 形成足の時刻): 既存 FVG / iFVG を確定終値で判定 → 新しい FVG を登録
    array<int>   gK = array.from(g1k, g2k, g3k, g4k)
    array<float> gC = array.from(g1c, g2c, g3c, g4c)
    array<int>   gD = array.from(g1d, g2d, g3d, g4d)
    array<float> gT = array.from(g1t, g2t, g3t, g4t)
    array<float> gB = array.from(g1b, g2b, g3b, g4b)
    for k = 0 to 3
        int key = array.get(gK, k)
        int lk  = array.get(lbFvgLast, k)
        if f_zfUse(k) and not na(key) and (na(lk) or key != lk)
            array.set(lbFvgLast, k, key)
            float hc = array.get(gC, k)
            int nf = array.size(lbFvgs)
            if nf > 0 and not na(hc)
                for i = nf - 1 to 0
                    LbZone z = array.get(lbFvgs, i)
                    if z.tf == k and z.key < key
                        if not z.inv
                            if (z.sub == 1 and hc < z.bot) or (z.sub == -1 and hc > z.top)
                                z.inv := true
                                st.nIfvg += 1
                                if dsZone
                                    f_dsRename(z)
                        else if (z.sub == 1 and hc > z.top) or (z.sub == -1 and hc < z.bot)
                            z.dead := true
                            st.nFvgDead += 1
                            f_lbRemove(z)
                            array.push(lbDeadNow, z.id)
                            if dsZone
                                f_dsDel(z, true)
            int   gd = array.get(gD, k)
            float gt = array.get(gT, k)
            float gb = array.get(gB, k)
            if not na(gd) and gd != 0 and not na(gt) and not na(gb)
                f_lbAdd(f_lbNew(4, k, gd, (gt + gb) / 2.0, gb, gt, na, na, key))
    // ZG: ダブル / トリプル トップ・ボトム (1H / 4H / D の検知器の検知イベント = 反転足の確定で発動。接触・Pivot の登録だけでは作らない)。
    //  根拠 = 時間足 + 基準 ID で 1 回だけ (ダブルで発動した基準のトリプル・消えた基準の後の検知では作らない)。基準価格・幅・期限は発動時に固定。
    //  期限: 検知足 = 0 本目、その時間足の確定足の bar_index − 検知足 ≥ 本数で消す。逆行: 検知結果を受け取った確定 5分足 (発動した足) から実体端で判定
    //  (処理順: ZG の登録・期限 → 逆行による消滅 → (B2) 接触・(B3) 待機・(B6) 候補。発動した足で消えた Zone は接触・SL / TP 候補に残らない)
    array<string> zgPk = array.from(zgPk1, zgPk4, zgPkD)
    for k = 0 to 2
        [zlt, zrec] = f_zgParse(array.get(zgPk, k), array.get(lbZgLast, k), time_close)
        array.set(lbZgLast, k, zlt)
        int nr = int(array.size(zrec) / 6)
        if nr > 0
            for r = 0 to nr - 1
                int ro  = r * 6
                int rbi = int(array.get(zrec, ro + 1))
                if array.get(zrec, ro) == 0
                    int nzg = array.size(lbZgZ)
                    if f_zgExpOn(k) and nzg > 0
                        for i = nzg - 1 to 0
                            LbZone z = array.get(lbZgZ, i)
                            if z.tf == k and rbi - int(z.infoB) >= f_zgExpN(k)
                                f_zgKill(i)
                else
                    int   zid  = int(array.get(zrec, ro + 2))
                    int   zsd  = int(array.get(zrec, ro + 3))
                    float zcnt = array.get(zrec, ro + 4)
                    float zp   = array.get(zrec, ro + 5)
                    int   ukey = zid * 3 + k
                    if not array.includes(lbZgUsed, ukey) and not na(zp)
                        array.push(lbZgUsed, ukey)
                        if f_zgUse(k) or f_zgShow(k)
                            // sub: 1 トップ (抵抗) / -1 ボトム (支持)。infoA = 回数 (2 ダブル / 3 トリプル)、infoB = 検知足の bar_index、key = 基準 ID
                            LbZone zz = f_lbNew(6, k, zsd == -1 ? 1 : -1, zp, zp - zgHalf, zp + zgHalf, zcnt, rbi, zid)
                            zz.zgUse  := f_zgUse(k)
                            zz.zgShow := f_zgShow(k)
                            if zz.zgUse
                                f_lbAdd(zz)
                            else if dsZone and zz.zgShow
                                f_dsAdd(zz)
                            array.push(lbZgZ, zz)
    int nzg2 = array.size(lbZgZ)
    if nzg2 > 0
        for i = nzg2 - 1 to 0
            LbZone z = array.get(lbZgZ, i)
            if z.sub == 1 ? math.max(open, close) > z.ctr + zgRev + EPS : math.min(open, close) < z.ctr - zgRev - EPS
                f_zgKill(i)
    // ZB: EMA ± 共通幅 (毎足動く)。最初に値が出た足で作り、次の足から接触
    for k = 0 to 1
        float mv = k == 0 ? zbMa1 : zbMa2
        if f_zbUse(k) and not na(mv)
            LbZone mz = k == 0 ? lbMa1 : lbMa2
            if na(mz)
                LbZone nz0 = f_lbNew(1, k, 0, mv, mv - zHalf, mv + zHalf, na, na, na)
                array.set(lbNZone, 1, array.get(lbNZone, 1) + 1)
                if k == 0
                    lbMa1 := nz0
                else
                    lbMa2 := nz0
            else
                mz.ctr := mv
                mz.bot := mv - zHalf
                mz.top := mv + zHalf
    if dsZone
        f_dsMa()

    // ---- (B2) 接触・突破 (この足と前の終値の範囲に掛かる Zone だけ。範囲外の Zone の状態は変わらない) ----------
    array<LbZone> cZ    = array.new<LbZone>()
    array<int>    cSide = array.new_int()
    array<int>    cCat  = array.new_int()
    array<int>    xId   = array.new_int()
    array<int>    xSide = array.new_int()
    float rLo = na(labC1) ? low : math.min(labC1, low)
    float rHi = na(labC1) ? high : math.max(labC1, high)
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int nz1 = array.size(arr)
        int iz  = f_lbLower(arr, rLo - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while iz < nz1
            LbZone z = array.get(arr, iz)
            if z.bot > rHi + EPS
                break
            st.iter += 1
            if z.top >= rLo - EPS and (z.aBar < bar_index or z.typ == 3)     // POC は受信した足から (他の種類は登録の次の足から)
                [cs, cc, xs] = f_lbStep(z, z.bot, z.top)
                if cs != 0
                    array.push(cZ, z)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, z.id)
                    array.push(xSide, xs)
            iz += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if mz.aBar < bar_index
                [cs, cc, xs] = f_lbStep(mz, mz.bot, mz.top)
                if cs != 0
                    array.push(cZ, mz)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, mz.id)
                    array.push(xSide, xs)
    st.maxIter := math.max(st.maxIter, st.iter)
    st.nTouch  += array.size(cZ)

    // ---- (B3) 待機: 突破による解除 / 無効化した Zone → 期限 → 作成・更新 -----------------------------------
    int nw0 = array.size(lbWaits)
    if nw0 > 0
        for i = nw0 - 1 to 0
            LbWait w = array.get(lbWaits, i)
            bool drop = false
            int nx = array.size(xId)
            if nx > 0
                for j = 0 to nx - 1
                    if array.get(xSide, j) == w.side and f_waitHas(w, array.get(xId, j))
                        drop := true
            int nd = array.size(lbDeadNow)
            if nd > 0
                for j = 0 to nd - 1
                    if f_waitHas(w, array.get(lbDeadNow, j))
                        drop := true
            if drop
                f_waitDel(i)
                st.nCancel += 1
            else if bar_index - w.lBar > waitBars
                f_waitDel(i)
                st.nWaitExp += 1
    int nSel = (cZA ? 1 : 0) + (cZB ? 1 : 0) + (cZC ? 1 : 0) + (cZD ? 1 : 0) + (cZF ? 1 : 0) + (cZE ? 1 : 0) + (cZG and (zgUse1 or zgUse4 or zgUseD) ? 1 : 0)
    int nc0  = array.size(cZ)
    if nc0 > 0
        for j = 0 to nc0 - 1
            st.nFake += array.get(cCat, j) == 2 ? 1 : 0
    if nc0 > 0 and (cComb == "OR" or nSel <= 1)
        for j = 0 to nc0 - 1
            LbZone z = array.get(cZ, j)
            if f_condTyp(z.typ)
                int cc = array.get(cCat, j)
                f_lbUnit(array.get(cSide, j), cc, cc == 1, cc == 2, cc == 3, array.from(z.id), str.tostring(z.id), f_pow2(z.typ),
                     z.bot, z.top, z.bot, z.top, f_zName(z) + " " + f_catName(cc))
    else if nc0 > 0
        // AND: 選んだ種類ごとの接触 Zone の全組合せ (方向が同じ・重なりがあり・この足が重なりに接触したもの)
        array<int> tl = array.new_int()
        for t = 0 to 6
            if f_condTyp(t)
                array.push(tl, t)
        int nt = array.size(tl)
        array<int> cnt = array.new_int(nt, 0)
        bool allHave = true
        for a = 0 to nt - 1
            int c = 0
            for j = 0 to nc0 - 1
                LbZone z = array.get(cZ, j)
                if z.typ == array.get(tl, a)
                    c += 1
            array.set(cnt, a, c)
            if c == 0
                allHave := false
        if allHave
            // 種類の順に、その種類の接触を接触の順に並べる (従来の列挙順 = 最後の種類が最も速く進む辞書順)
            array<int> lst = array.new_int()
            array<int> off = array.new_int()
            for a = 0 to nt - 1
                array.push(off, array.size(lst))
                for j = 0 to nc0 - 1
                    LbZone z = array.get(cZ, j)
                    if z.typ == array.get(tl, a)
                        array.push(lst, j)
            // 深さ優先で組合せを選ぶ。途中まで選んだ Zone の方向が揃わない・共通の重なりがない・その重なりにこの足が接触していない
            // 枝は打ち切る (全部を選んだ組合せの条件は途中の組合せでも必ず成り立つので、有効な組合せは省略しない)
            array<int>   od  = array.new_int(nt, -1)
            array<float> pOb = array.new_float(nt, na)
            array<float> pOt = array.new_float(nt, na)
            int lv = 0
            int nodes = 0
            while lv >= 0
                int nxt = array.get(od, lv) + 1
                if nxt >= array.get(cnt, lv)
                    array.set(od, lv, -1)
                    lv -= 1
                else
                    array.set(od, lv, nxt)
                    nodes += 1
                    int    jz = array.get(lst, array.get(off, lv) + nxt)
                    LbZone zz = array.get(cZ, jz)
                    float  ob = zz.bot
                    float  ot2 = zz.top
                    bool   okp = true
                    if lv > 0
                        ob  := math.max(array.get(pOb, lv - 1), zz.bot)
                        ot2 := math.min(array.get(pOt, lv - 1), zz.top)
                        int j0 = array.get(lst, array.get(off, 0) + array.get(od, 0))
                        okp := array.get(cSide, jz) == array.get(cSide, j0)
                    okp := okp and ob <= ot2 + EPS and low <= ot2 + EPS and high >= ob - EPS
                    if okp
                        array.set(pOb, lv, ob)
                        array.set(pOt, lv, ot2)
                        if lv < nt - 1
                            lv += 1
                        else
                            array<int> pick = array.new_int()
                            for a = 0 to nt - 1
                                array.push(pick, array.get(lst, array.get(off, a) + array.get(od, a)))
                            int   s0   = array.get(cSide, array.get(pick, 0))
                            float eb   = na
                            float et   = na
                            int   cat0 = array.get(cCat, array.get(pick, 0))
                            bool  cr   = false
                            bool  cf   = false
                            bool  co   = false
                            int   tm   = 0
                            array<int> ids = array.new_int()
                            string desc = ""
                            for a = 0 to nt - 1
                                int j = array.get(pick, a)
                                LbZone z = array.get(cZ, j)
                                int cc = array.get(cCat, j)
                                eb  := na(eb) ? z.bot : math.min(eb, z.bot)
                                et  := na(et) ? z.top : math.max(et, z.top)
                                cr  := cr or cc == 1
                                cf  := cf or cc == 2
                                co  := co or cc == 3
                                tm  += f_pow2(z.typ)
                                // ID を昇順に挿入
                                int p = 0
                                int ni = array.size(ids)
                                while p < ni
                                    if array.get(ids, p) > z.id
                                        break
                                    p += 1
                                array.insert(ids, p, z.id)
                                desc := desc + (a > 0 ? " + " : "") + f_zName(z)
                            string key = ""
                            for p = 0 to array.size(ids) - 1
                                key := key + (p > 0 ? "|" : "") + str.tostring(array.get(ids, p))
                            f_lbUnit(s0, cat0, cr, cf, co, ids, key, tm, ob, ot2, eb, et, desc + " " + f_catName(cat0))
            st.maxCombo := math.max(st.maxCombo, nodes)
    // BEL-2: ロックで禁止の足では待機を残さない (解除後は解除の次の足以後の接触から)
    if lkBlk and array.size(lbWaits) > 0
        st.nLockClr += array.size(lbWaits)
        array.clear(lbWaits)
        map.clear(lbWaitMap)
    st.maxWaits := math.max(st.maxWaits, array.size(lbWaits))

    // ---- (B4) タイミング: TA (ACC-5A と同じ: 期限 → 吸収 → 新しい FVG) / TC (サッツバンド転換) / TE (短期 DTB) / TD (1分ストキャス) / 古いものを外す ----
    //  (v5 由来: and の両辺を評価する前提で、na のオブジェクトのフィールドを読む条件は if を分けている。v6 の短絡評価でも結果は同じ)
    if not na(lbFvUp)
        if bar_index - lbFvUp.fBar > fvLife
            lbFvUp := na
    if not na(lbFvDn)
        if bar_index - lbFvDn.fBar > fvLife
            lbFvDn := na
    for d = 0 to 1
        LbFvg fv = d == 0 ? lbFvUp : lbFvDn
        if not na(fv)
            bool absd = fv.dir == 1 ? (close < open and close <= fv.lo) : (close > open and close >= fv.hi)
            if absd
                st.tSeq += 1
                st.nTA  += 1
                array.push(lbTevs, LbTev.new(st.tSeq, 1, fv.dir == 1 ? -1 : 1, bar_index, false,
                     "TA FVG吸収 #" + str.tostring(fv.id)))
                if d == 0
                    lbFvUp := na
                else
                    lbFvDn := na
    bool upF = not na(labH2) and not na(labC1) and not na(labO1) and low > labH2 and labC1 > labO1 and low - labH2 >= fvMinW - EPS
    bool dnF = not na(labL2) and not na(labC1) and not na(labO1) and high < labL2 and labC1 < labO1 and labL2 - high >= fvMinW - EPS
    if upF
        st.fvSeq += 1
        lbFvUp := LbFvg.new(st.fvSeq, 1, bar_index, labH2, low)
    if dnF
        st.fvSeq += 1
        lbFvDn := LbFvg.new(st.fvSeq, -1, bar_index, high, labL2)
    // TC サッツバンド転換: 参照上位足の確定帯を取り込み (つながった区間は組み直し) → この 5分足の中のイベントを生成 → パターン・方向ごとに
    //  成立時刻順に処理 → この 5分足の中で成立した合図を方向ごとに 1 件の LbTev (kind 2) にする (この足だけ有効)
    if tcHtfOn
        f_tcHtfPut(tcH2n, tcH2t, tcH2b, true)
        f_tcHtfPut(tcH1n, tcH1t, tcH1b, true)
        f_tcHtfPut(tcHcn, tcHc, na, false)
        if not na(tcHcn) and (na(tcHNcur) or tcHcn > tcHNcur)
            tcHNcur := tcHcn
        if not na(tcHc) and (na(tcHFront) or tcHc > tcHFront)
            tcHFront := tcHc
        while array.size(tcMerged) > 0
            f_tcRequeueSeg(array.shift(tcMerged))
    for q = 0 to 3
        array.set(tcSigT, q, na)
    f_tcGen()
    for p = 0 to 1
        for d = 0 to 1
            f_tcSeqRun(p, d)
    for d = 0 to 1
        string tcTx = ""
        for p = 0 to 1
            int tq = array.get(tcSigT, p * 2 + d)
            if not na(tq)
                tcTx := tcTx + (tcTx == "" ? "" : " / ") + f_tcPName(p) + " " + str.format_time(tq, "HH:mm:ss", syminfo.timezone)
        if tcTx != ""
            st.tSeq += 1
            st.nTC  += 1
            array.push(lbTevs, LbTev.new(st.tSeq, 2, d == 0 ? -1 : 1, bar_index, false, "TC サッツバンド転換 " + (d == 0 ? "SELL " : "BUY ") + tcTx))
    // TE: 短期 DTB (5分 / 15分基準・実体ベース)。足の取り込み → 山・谷の登録 → 各基準 (⓪ 最大離れ幅 → ① 終値の無効化 → ② 反転待ち →
    //  ③ 接近 → ④ 最低離れ幅)。Zone の到達・待機とは無関係に常時追跡し、検知 (反転の確定) を基準ごとのタイミングにする (この足だけ有効)
    if array.size(lbDtWs) == 0
        for k = 0 to 1
            array.push(lbDtWs, LbDtW.new(array.new_float(), array.new_float(), na))
    int   dtW  = 2 * tePiv + 1
    float bTop = math.max(open, close)
    float bBot = math.min(open, close)
    for k = 0 to 1
        int   nt = k == 0 ? time : labTe15t
        float nh = k == 0 ? bTop : labTe15T
        float nl = k == 0 ? bBot : labTe15B
        LbDtW tw = array.get(lbDtWs, k)
        if not na(nt) and not na(nh) and not na(nl) and (na(tw.lastT) or nt != tw.lastT)
            tw.lastT := nt
            array.push(tw.hs, nh)
            array.push(tw.ls, nl)
            if array.size(tw.hs) > dtW
                array.shift(tw.hs)
                array.shift(tw.ls)
            // LAB-14: 5分基準の途中波 (登録済みの基準) と左側の波判定をこの確定 5分足で更新し、窓と同じ並びで保存する
            if k == 0
                int nb = array.size(lbDts)
                if nb > 0
                    for b = 0 to nb - 1
                        LbDt gw = array.get(lbDts, b)
                        if gw.tf == 0
                            f_teWave(gw, nh, nl, nt, high, low)
                if na(lbLw.wX)
                    lbLw.wUp := true
                    lbLw.wX  := nh
                    lbLw.wXT := nt
                else
                    f_teWave(lbLw, nh, nl, nt, high, low)
                bool lwCand = lbLw.wXT == nt and not na(lbLw.wOT)
                array.push(lbWvH, lwCand and lbLw.wUp)
                array.push(lbWvL, lwCand and not lbLw.wUp)
                array.push(lbWvO, lbLw.wOX)
                array.push(lbWvT, nt)
                array.push(lbWkH, high)
                array.push(lbWkL, low)
                while array.size(lbWvH) > array.size(tw.hs)
                    array.shift(lbWvH)
                    array.shift(lbWvL)
                    array.shift(lbWvO)
                    array.shift(lbWvT)
                    array.shift(lbWkH)
                    array.shift(lbWkL)
            if array.size(tw.hs) == dtW
                float mh   = array.get(tw.hs, tePiv)
                float ml   = array.get(tw.ls, tePiv)
                bool  isH  = true
                bool  isL  = true
                float rMin = na
                float rMax = na
                for j = 0 to dtW - 1
                    if j < tePiv
                        isH := isH and mh >= array.get(tw.hs, j)
                        isL := isL and ml <= array.get(tw.ls, j)
                    if j > tePiv
                        isH := isH and mh > array.get(tw.hs, j)
                        isL := isL and ml < array.get(tw.ls, j)
                        rMin := na(rMin) ? array.get(tw.ls, j) : math.min(rMin, array.get(tw.ls, j))
                        rMax := na(rMax) ? array.get(tw.hs, j) : math.max(rMax, array.get(tw.hs, j))
                // 15分基準は登録した確定 5分足の実体端も登録時の離れ幅に含める (5分基準では今の足が最後の確認足)
                if k == 1
                    rMin := math.min(rMin, bBot)
                    rMax := math.max(rMax, bTop)
                float dD   = k == 0 ? teD5 : teD15
                bool  mxOn = k == 0 ? teMxUse5 : teMxUse15
                float mxV  = k == 0 ? teMx5 : teMx15
                // LAB-14: 5分基準は中央足の左側の波判定 (保存済み) が真のときだけ登録し、途中波・価格比較を初期化する。
                //  初期化の時点で独立した途中波が確定済みなら登録しない
                //  LAB-15: 15分基準は登録しない (TE は 5分基準だけで検知する)
                bool okH = false
                bool okL = false
                if k == 0
                    okH := array.get(lbWvH, tePiv)
                    okL := array.get(lbWvL, tePiv)
                if isH and okH and not (mxOn and mh - rMin > mxV + EPS)
                    LbDt gh = LbDt.new(k, -1, mh, bar_index, mh - rMin >= dD - EPS)
                    gh.ext := rMin
                    if k == 0
                        gh.preX := array.get(lbWvO, tePiv)
                        gh.midX := rMin
                        gh.lwk  := array.get(lbWkH, tePiv)     // LAB-17: 左の山の上ヒゲ先
                        f_teWaveInit(gh, tw, array.get(lbWvT, tePiv))
                    if not gh.wEnd
                        array.push(lbDts, gh)
                if isL and okL and not (mxOn and rMax - ml > mxV + EPS)
                    LbDt gl = LbDt.new(k, 1, ml, bar_index, rMax - ml >= dD - EPS)
                    gl.ext := rMax
                    if k == 0
                        gl.preX := array.get(lbWvO, tePiv)
                        gl.midX := rMax
                        gl.lwk  := array.get(lbWkL, tePiv)     // LAB-17: 左の谷の下ヒゲ先
                        f_teWaveInit(gl, tw, array.get(lbWvT, tePiv))
                    if not gl.wEnd
                        array.push(lbDts, gl)
    bool   teDetL = false
    bool   teDetS = false
    int ndt = array.size(lbDts)
    if ndt > 0
        for i = ndt - 1 to 0
            LbDt g = array.get(lbDts, i)
            if g.aBar < bar_index
                bool  top  = g.side == -1
                float bB   = g.tf == 0 ? teB5 : teB15
                float bD   = g.tf == 0 ? teD5 : teD15
                bool  gOn  = g.tf == 0 ? teMxUse5 : teMxUse15
                float gMx  = g.tf == 0 ? teMx5 : teMx15
                float pApp = top ? bTop : bBot      // 接近 = 同じ側の実体端
                float pDst = top ? bBot : bTop      // 離れ幅 = 反対側の実体端
                bool  fin  = false
                g.ext := top ? math.min(g.ext, pDst) : math.max(g.ext, pDst)
                // LAB-17 (DTB-12): 5分基準は左の実体端とヒゲ先を別々に終値で無効化し、両方が無効になったら終了 (実体側だけなら続ける)
                bool w5 = g.tf == 0 and not na(g.lwk)
                if w5 and g.bOk and (top ? close > g.lvl + bB + EPS : close < g.lvl - bB - EPS)
                    g.bOk := false
                bool invOut = w5 ? (not g.bOk and (top ? close > g.lwk + bB + EPS : close < g.lwk - bB - EPS)) :
                     (top ? close > g.lvl + bB + EPS : close < g.lvl - bB - EPS)
                // ⓪ 最大離れ幅 (無効化・反転・接近より先)
                if gOn and (top ? g.lvl - g.ext > gMx + EPS : g.ext - g.lvl > gMx + EPS)
                    fin := true
                // ① 終値による無効化 (H + 接近幅を上回る / L − 接近幅を下回る。LAB-17: 5分基準は実体端・ヒゲ先とも無効で終了)
                else if invOut
                    fin := true
                // ①' LAB-14: 5分基準は独立した途中波の確定で終了 (無効化の後・反転待ち / 接近より先)
                else if g.tf == 0 and g.wEnd
                    fin := true
                else
                    bool det = false
                    bool rev = top ? close < open : close > open
                    bool b5  = g.tf == 0
                    // LAB-17 (DTB-13 / DTB-14): 4 組の接近をこの足で判定 (無効化は上で処理済み。有効な左の基準だけ)。反転待ちは接近時に
                    //  一致した基準に紐づけ、すべて無効になったら取り消す。取り消し後は元の期限 (その足を含む) まで、有効な基準
                    //  (ヒゲ先) への接近を最低離れ幅の再到達なしで受け付け、接近した足から接近足・期限・反転判定の基準を取り直す
                    [apB, apW] = f_teApHit(g, pApp, top ? high : low)
                    bool wasW  = g.waiting
                    bool reApp = false
                    if g.waiting and w5 and not ((g.mB and g.bOk) or g.mW)
                        g.waiting := false
                        reApp := true
                        g.raEnd := g.waitEnd
                    if g.waiting
                        // ② 反転待ち: 最初の陰線 (陽線) で検知、最後の足を過ぎたら見送り
                        //  LAB-14 (5分基準): トップは陰線自身を含めて右の山を更新し、陰線の確定時に最低離れ幅を判定 (不足なら終了)。
                        //  ボトムは陰線の接近足なら、その始値を上回る陽線の終値だけを反転にする (同値・下回る陽線は待機を続ける)
                        if b5 and top
                            g.tPk := math.max(g.tPk, bTop)
                        bool wRev = rev and (not b5 or top or na(g.rvO) or close > g.rvO + EPS)
                        if wRev
                            g.waiting := false
                            if f_teDtNg(g)
                                fin := true
                            else
                                det := true
                        else if bar_index >= g.waitEnd
                            g.waiting := false
                    else if (wasW ? reApp : (g.away or (w5 and not na(g.raEnd) and bar_index <= g.raEnd))) and g.cnt < 3 and
                         (w5 ? (apB or apW) : pApp >= g.lvl - bB - EPS and pApp <= g.lvl + bB + EPS)
                        // ③ 接近 (2 回目・3 回目): 同じ側の実体端が基準価格 ± 接近幅以内。接近足が陰線 (陽線) ならこの足で検知
                        //  LAB-14 (5分基準): 接近では数えない (成立で数える)。この足を中央の極値に加える前に、手前と中央の山・谷の価格差
                        //  (ボトム = 直前の山 − 間の山 / トップ = 間の谷 − 直前の谷) が接近幅を超えた場合だけ反転判定へ (未取得・ちょうどは終了)
                        float pxD  = top ? g.midX - g.preX : g.preX - g.midX
                        bool  pxNg = b5 and g.cnt == 1 and (na(pxD) or pxD <= bB + EPS)
                        if not b5
                            g.cnt += 1
                        g.away    := false
                        g.appBar  := bar_index
                        g.waitEnd := bar_index + teWait
                        g.apT     := time
                        g.mB      := w5 and apB
                        g.mW      := w5 and apW
                        g.raEnd   := na
                        if pxNg
                            fin := true
                        else
                            if b5 and top
                                g.tMid := g.midX
                                g.tPk  := pApp
                            if b5 and not top
                                g.rvO := close < open ? open : na
                            if rev and f_teDtNg(g)
                                fin := true
                            else if rev
                                det := true
                            else if teWait > 0
                                g.waiting := true
                    // LAB-14: 5分基準は成立した足でだけ数え、ダブル成立で監視を終了する
                    if det and b5
                        g.cnt += 1
                    fin := fin or (det and b5) or (not g.waiting and g.cnt >= 3)
                    if det
                        // 基準ごとに 1 個 (接近足を持つ)。待機ごとの到達足との前後判定と 1 件へのまとめは候補選択・消費で行う
                        string nm = (top ? "TE トップ " : "TE ボトム ") + (g.tf == 0 ? "5分" : "15分") + (g.cnt == 2 ? "ダブル" : "トリプル") +
                             " " + str.tostring(g.lvl, "#.##")
                        st.tSeq += 1
                        array.push(lbTevs, LbTev.new(st.tSeq, 3, top ? -1 : 1, bar_index, false, nm, g.appBar))
                        teDetS := teDetS or top
                        teDetL := teDetL or not top
                    // ④ 最低離れ幅 (接近足自身は数えない。次の接近は次の足から)
                    if not fin and (na(g.appBar) or g.appBar != bar_index) and (top ? pDst <= g.lvl - bD + EPS : pDst >= g.lvl + bD - EPS)
                        g.away := true
                // LAB-14: 5分基準の中央の極値をこの確定足で更新 (価格差の比較より後。監視が続けば今回の接近足も次回の比較に含まれる)
                if g.tf == 0 and not fin
                    g.midX := top ? math.min(g.midX, bBot) : math.max(g.midX, bTop)
                if fin
                    array.remove(lbDts, i)
    // 成立数は足・方向ごとに 1 件
    st.nTE += (teDetL ? 1 : 0) + (teDetS ? 1 : 0)
    // TD: この確定 5分足の中の 1分合図 (1分足の time_close がこの 5分足の中) をすべて確認し、方向ごとに最新の 1件を代表にする。
    //  この 5分足だけ有効 (次の足へ持ち越さない)
    int tdL = na
    int tdS = na
    if chart.is_standard and not na(labTdDir) and not na(labTdTc) and not na(labTdSkip)     // 通常ローソク足の 5分チャートだけ (lbRun = 5分足)
        int ntd = math.min(array.size(labTdDir), array.size(labTdTc), array.size(labTdSkip))
        if ntd > 0
            for j = 0 to ntd - 1
                int dv = array.get(labTdDir, j)
                int tc = array.get(labTdTc, j)
                int sk = array.get(labTdSkip, j)
                if not na(dv) and not na(tc) and tc > time and tc <= time_close
                    if dv == 1
                        tdL := na(tdL) ? tc : math.max(tdL, tc)
                    else if dv == -1
                        tdS := na(tdS) ? tc : math.max(tdS, tc)
                    if not na(sk) and sk != 0                // 1H / 4H 見送り (検証表示の集計だけ。合図は出ない)
                        st.nTdSkL += sk > 0 ? 1 : 0
                        st.nTdSkS += sk < 0 ? 1 : 0
                        st.nTdSkD += math.abs(sk) == 2 ? 1 : 0
    if not na(tdL)
        st.tSeq += 1
        st.nTD  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 4, 1, bar_index, false, "TD ストキャスMTF L " + str.format_time(tdL, "HH:mm", syminfo.timezone) + " [" + tdSetTxt + "]"))
    if not na(tdS)
        st.tSeq += 1
        st.nTD  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 4, -1, bar_index, false, "TD ストキャスMTF S " + str.format_time(tdS, "HH:mm", syminfo.timezone) + " [" + tdSetTxt + "]"))
    int ne0 = array.size(lbTevs)
    if ne0 > 0
        for i = ne0 - 1 to 0
            LbTev e = array.get(lbTevs, i)
            if e.used or bar_index - e.eBar > (e.kind == 1 ? fvAbsLife : 0)
                array.remove(lbTevs, i)
    st.maxTevs := math.max(st.maxTevs, array.size(lbTevs))

    // ---- (B5) 保有中: 建値 → TP の計画し直し → 変更通知 -----------------------------------------------------
    if o.state == 2 and opn
        if beOn and not o.be
            float trig = beMode == "固定幅" ? o.fill + o.side * beDist : o.fill + beRatio / 100.0 * (o.tp1E - o.fill)
            bool  okT  = beMode == "固定幅" or (not na(o.tp1E) and o.side * (o.tp1E - o.fill) > 0)
            if okT and (o.side == 1 ? high >= trig : low <= trig)
                o.be   := true
                o.stop := o.fill
                st.nBE += 1
        f_lbPlan(o.side == 1 ? math.max(o.fill, close) : math.min(o.fill, close), o.fill)
        f_lbIssue()
        o.lastTp := f_lbFarTp()
        f_lbNotify(false)

    // ---- (B6) 候補 → 優先 (現在価格に近い Zone) → 競合 → 発注 --------------------------------------------
    LbCand bestL = na
    LbCand bestS = na
    array<float> tpL = na          // この足の TP 候補 (判断時の基準 = 終値)。方向ごとに必要になった時だけ 1 回計算し、候補間で再利用
    array<float> tpS = na
    // LAB-10: 方向 = この足で新しく成立したタイミング、場所 = 対象 Zone (AND は共通帯) ± 許容幅に終値。待機・接触・分類は使わない
    array<LbWait> units = na
    for d = 0 to 1
        int side = d == 0 ? 1 : -1
        int ia = cTA ? f_lbTim(1, side) : -1
        int ic = cTC ? f_lbTim(2, side) : -1
        int ie = cTE ? f_lbTim(3, side) : -1
        int it = cTD ? f_lbTim(4, side) : -1
        bool timOK = cTim == "AND" ? ((cTA or cTC or cTE or cTD) and (not cTA or ia >= 0) and (not cTC or ic >= 0) and (not cTE or ie >= 0) and
             (not cTD or it >= 0)) : ((cTA and ia >= 0) or (cTC and ic >= 0) or (cTE and ie >= 0) or (cTD and it >= 0))
        if timOK and na(units)
            int nSelU = (cZA ? 1 : 0) + (cZB ? 1 : 0) + (cZC ? 1 : 0) + (cZD ? 1 : 0) + (cZF ? 1 : 0) + (cZE ? 1 : 0) + (cZG and (zgUse1 or zgUse4 or zgUseD) ? 1 : 0)
            units := f_lbUnits(nSelU)
        int nu = timOK ? array.size(units) : 0
        if nu > 0
            for i = 0 to nu - 1
                LbWait w = array.get(units, i)
                // LAB-16: Zone 中心からの方向条件 (LONG = 終値 > 中心 + バッファ / SHORT = 終値 < 中心 − バッファ。ちょうどは見送り)
                float zoneMid = (w.cBot + w.cTop) * 0.5
                if side == 1 ? not (close > zoneMid + zMidBuf) : not (close < zoneMid - zMidBuf)
                    continue
                st.nCand += 1
                int why = -1
                array<int> exIds = w.ids
                int om  = f_lbOthers(w.eBot, w.eTop, w.tmask)
                // SL = Zone の外側 + SL 外側幅 と 判断価格 (終値) から最低距離 の遠い方 (LAB-11)
                float sl  = side == 1 ? math.min(w.eBot - slBuf, close - slMinD) : math.max(w.eTop + slBuf, close + slMinD)
                float slw = side * (close - sl)
                float tp1 = na
                float rr  = na
                float qty = na
                int   nT  = 0
                if zdBad
                    why := 7
                else if zeBad
                    why := 8
                else if cScope == "だけ" and om != 0
                    why := 1
                else if slw <= EPS or (maxSlOn and slw >= maxSl - 1e-6)
                    why := 2
                else
                    array<float> tps = array.new_float()
                    // LAB-13: TP 除外 = 候補の Zone から重なりで連鎖する有効 Zone 全体。除外対象のどれかが利益側の TP 候補に入り得る
                    //  (LONG: 下端 > 終値 / SHORT: 上端 < 終値) なら候補ごとに計算し、入り得なければ除外なしと同じなので方向別のキャッシュを使う
                    [exI, exL, exS] = f_lbExZones(w)
                    exIds := exI
                    if tpMode != "固定 RR"
                        bool mayIn = side == 1 ? exL : exS
                        if mayIn
                            tps := f_lbTargets(side, close, exI)
                        else if side == 1
                            if na(tpL)
                                tpL := f_lbTargets(1, close, array.new_int())
                            tps := tpL
                        else
                            if na(tpS)
                                tpS := f_lbTargets(-1, close, array.new_int())
                            tps := tpS
                    nT  := array.size(tps)
                    tp1 := nT > 0 ? array.get(tps, 0) : close + side * fixRR * slw
                    rr  := side * (tp1 - close) / slw
                    if rr < minRR1 - EPS
                        why := 3
                    else if not sessOK
                        why := 4
                    else if not labRangeOK
                        why := 5
                    else
                        qty := f_qty(side, close, sl)
                        if na(qty)
                            why := 6
                if why >= 0
                    array.set(skipN, why, array.get(skipN, why) + 1)
                else
                    float dist = close > w.cTop ? close - w.cTop : close < w.cBot ? w.cBot - close : 0.0
                    LbCand c = LbCand.new(-1, side, sl, slw, tp1, rr, qty, dist, cTA ? ia : -1, cTC ? ic : -1, om, nT)
                    c.ie := cTE ? ie : -1
                    c.it := cTD ? it : -1
                    c.uw := w
                    c.exIds := exIds
                    if side == 1
                        if na(bestL)
                            bestL := c
                        else if c.dist < bestL.dist - EPS
                            bestL := c
                    else
                        if na(bestS)
                            bestS := c
                        else if c.dist < bestS.dist - EPS
                            bestS := c
    LbCand pick = na
    if not na(bestL) and not na(bestS)
        st.nConflict += 1
    else if not na(bestL)
        pick := bestL
    else if not na(bestS)
        pick := bestS
    if not na(pick)
        bool flat = o.state == 0 and strategy.position_size == 0
        if not flat or lkBlk
            st.nHoldSkip += 1
        else
            LbWait w = pick.uw
            o.n          += 1
            o.id         := (pick.side == 1 ? "L" : "S") + str.tostring(o.n)
            o.side       := pick.side
            o.ref        := close
            o.sl         := pick.sl
            o.stop       := pick.sl
            o.be         := false
            o.fill       := na
            o.lotQ       := mmLotStep * mmLotOz / syminfo.pointvalue
            o.lotN       := int(math.round(pick.qty / o.lotQ))
            o.closedLots := 0
            o.stage      := 0
            o.bar        := bar_index
            o.tp1E       := pick.tp1
            o.tp1Fix     := tpMode == "固定 RR" or pick.nT == 0
            o.tmask      := w.tmask
            o.exIds      := array.copy(pick.exIds)     // LAB-13: TP から除く Zone の連鎖 (初回発注・保有中の f_lbPlan)
            o.omask      := pick.omask
            o.cReb       := false          // LAB-10: 分類は候補に使わない
            o.cFake      := false
            o.cRole      := false
            o.tim        := (pick.ia >= 0 ? 1 : 0) + (pick.ic >= 0 ? 2 : 0) + (pick.ie >= 0 ? 4 : 0) + (pick.it >= 0 ? 8 : 0)
            o.pnl        := 0.0
            o.nTp        := 0
            o.lastStop   := false
            o.lastTp     := na
            o.state      := 1
            for k = 0 to 2
                array.set(o.ntfPx, k, na)
            f_lbPlan(close, close)
            o.lastTp := f_lbFarTp()
            strategy.entry(o.id, pick.side == 1 ? strategy.long : strategy.short, qty = o.lotN * o.lotQ)
            f_lbIssue()
            f_lbNotify(true)
            // 消費: 使ったタイミング (この足で成立したもの)
            string tdesc = ""
            if pick.ia >= 0
                LbTev ea = array.get(lbTevs, pick.ia)
                ea.used := true
                tdesc := tdesc + " " + ea.desc + " (この足)"
            if pick.ic >= 0
                LbTev ec = array.get(lbTevs, pick.ic)
                ec.used := true
                tdesc := tdesc + " " + ec.desc + " (この足)"
            if pick.ie >= 0
                // 同じ方向・この確定足の TE (5分 / 15分・複数の基準) をまとめて 1 件として消費する
                string tex = ""
                int nte = array.size(lbTevs)
                for j = 0 to nte - 1
                    LbTev ee = array.get(lbTevs, j)
                    if ee.kind == 3 and ee.side == pick.side and not ee.used and ee.eBar == bar_index
                        ee.used := true
                        tex := tex + (tex == "" ? "" : " + ") + ee.desc
                tdesc := tdesc + " " + tex + " (この足)"
            if pick.it >= 0
                LbTev et = array.get(lbTevs, pick.it)
                et.used := true
                tdesc := tdesc + " " + et.desc + " (この足)"
            o.desc := (pick.side == 1 ? "LONG " : "SHORT ") + w.desc + "\nZone周辺 ±" + str.tostring(zNear, "#.##") + " / 終値 " +
                 str.tostring(close, "#.##") + " /" + tdesc +
                 "\n判断 " + str.tostring(close, "#.##") + "  SL " + str.tostring(pick.sl, "#.##") + "  RR(TP1) " + str.tostring(pick.rr, "#.##") +
                 "\n" + f_lbTpText() + (pick.omask != 0 ? "\n他種類の重なりあり" : "")
            alert("ZCL 確定 " + o.id + " " + o.desc, alert.freq_once_per_bar_close)
            o.lbl := na
            if dsEnt
                o.lbl := label.new(bar_index, pick.side == 1 ? low : high, o.id + " " + o.desc,
                     style = pick.side == 1 ? label.style_label_up : label.style_label_down,
                     color = pick.side == 1 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
                array.push(lbLbls, o.lbl)
                if array.size(lbLbls) > dsEntMax
                    label.delete(array.shift(lbLbls))

    // ---- (B7) 資産 (実現 + 含み損益) と最大 DD (含み損は確定足の不利な側の高値 / 安値で評価) ---------------------
    float openC = 0.0
    float openW = 0.0
    if strategy.position_size != 0 and not na(o.fill)
        float qn = math.abs(strategy.position_size)
        openC := strategy.convert_to_account(o.side * (close - o.fill) * qn * syminfo.pointvalue)
        openW := strategy.convert_to_account(o.side * ((o.side == 1 ? low : high) - o.fill) * qn * syminfo.pointvalue)
    float eqC = strategy.initial_capital + st.realized + openC
    float eqW = strategy.initial_capital + st.realized + openW
    st.peak := na(st.peak) ? math.max(strategy.initial_capital, eqC) : math.max(st.peak, eqC)
    float dd = st.peak - eqW
    if dd > st.maxDD
        st.maxDD := dd
    if st.peak > 0 and dd / st.peak > st.maxDDPct
        st.maxDDPct := dd / st.peak

    // ---- (B8) Zone タッチ通知 (設定 ON のときだけ。この足の処理を終えた時点の有効な Zone で判定) -----------------------
    //  接触した Zone のうち、前回の通知の足で接触していた Zone 以外があれば、それらを 1 通にまとめて通知し、この足の接触 Zone を記録する。
    //  前回の Zone だけへの接触 (離れて戻った場合を含む) は通知しない。接触のない足・日付の変更では記録を変えない
    if ntfTouch
        array<LbZone> tz = f_ntfTouched()
        int nt = array.size(tz)
        if nt > 0
            array<LbZone> nwz = array.new<LbZone>()
            for j = 0 to nt - 1
                LbZone z = array.get(tz, j)
                if not array.includes(lbNtfIds, z.id)
                    array.push(nwz, z)
            int nn = array.size(nwz)
            if nn > 0
                string msg = "ZCL Zoneタッチ " + syminfo.ticker + " " + str.format_time(time_close, "yyyy-MM-dd HH:mm", syminfo.timezone) + " (5分足確定)"
                for j = 0 to math.min(nn, 20) - 1
                    msg := msg + "\n" + f_ntfLine(array.get(nwz, j))
                if nn > 20
                    msg := msg + "\nほか " + str.tostring(nn - 20) + " 件"
                alert(msg, alert.freq_once_per_bar_close)
                lbNtfN += 1
                array.clear(lbNtfIds)
                for j = 0 to nt - 1
                    LbZone z = array.get(tz, j)
                    array.push(lbNtfIds, z.id)
// ==== LAB Logic (end) ========================================================

// ============================================================================
// 04. 表示 (売買には影響しない)
// ============================================================================
plot(zbUse1 ? zbMa1 : na, "MA 1分足 EMA", color = color.new(color.blue, 30))
plot(zbUse2 ? zbMa2 : na, "MA 5分足 EMA", color = color.new(color.navy, 30))

// 帯の名称を最新足の右側へ (最後の確定履歴足と、その後のリアルタイムの確定足)
if lbRun and dsZone and (barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed))
    f_dsLblX()

f_pct(float a, float b) =>
    b > 0 ? str.tostring(a / b * 100.0, "#.#") + "%" : "-"

var table lbTbl = table.new(position.bottom_right, 8, 33, border_width = 1, frame_color = color.gray)
if dsTbl and barstate.islast and lbRun
    array<string> nm = array.from("全体", "アキュム含む", "MA含む", "水平線含む", "出来高POC含む", "FVG含む", "アキュムだけ", "MAだけ", "水平線だけ", "出来高POCだけ", "FVGだけ",
         "TA FVG吸収", "TC サッツバンド転換", "反発", "ダマシ", "サポレジ", "LONG", "SHORT", "フィボ含む", "フィボだけ",
         "ダブル/トリプル含む", "ダブル/トリプルだけ", "TE ダブル/トリプル", "TD ストキャスMTF")
    array<string> hd = array.from("区分 (取引台帳)", "取引", "勝/負/建", "勝率", "PF", "平均R", "純損益(円)", "")
    for c = 0 to 6
        table.cell(lbTbl, c, 0, array.get(hd, c), text_color = color.white, bgcolor = color.new(color.navy, 10), text_size = size.tiny)
    for b = 0 to 23
        int   n  = array.get(bkN, b)
        int   w  = array.get(bkW, b)
        int   l  = array.get(bkL, b)
        float gp = array.get(bkGP, b)
        float gl = array.get(bkGL, b)
        table.cell(lbTbl, 0, b + 1, array.get(nm, b), text_size = size.tiny)
        table.cell(lbTbl, 1, b + 1, str.tostring(n), text_size = size.tiny)
        table.cell(lbTbl, 2, b + 1, str.tostring(w) + "/" + str.tostring(l) + "/" + str.tostring(array.get(bkBE, b)), text_size = size.tiny)
        table.cell(lbTbl, 3, b + 1, f_pct(w, w + l), text_size = size.tiny)
        table.cell(lbTbl, 4, b + 1, gl > 0 ? str.tostring(gp / gl, "#.##") : n > 0 ? "∞" : "-", text_size = size.tiny)
        table.cell(lbTbl, 5, b + 1, n > 0 ? str.tostring(array.get(bkR, b) / n, "#.##") : "-", text_size = size.tiny)
        table.cell(lbTbl, 6, b + 1, str.tostring(array.get(bkNet, b), "#"), text_size = size.tiny)
    table.cell(lbTbl, 0, 25, "最大DD (含み込み)", text_size = size.tiny)
    table.cell(lbTbl, 1, 25, str.tostring(st.maxDD, "#") + " 円", text_size = size.tiny)
    table.cell(lbTbl, 2, 25, str.tostring(st.maxDDPct * 100.0, "#.##") + " %", text_size = size.tiny)
    table.cell(lbTbl, 0, 26, "保持 アキュム/MA/水平線/POC/FVG/フィボ/ダブル・トリプル", text_size = size.tiny)
    table.cell(lbTbl, 1, 26, str.tostring(array.get(lbNZone, 0)) + "/" + str.tostring(array.get(lbNZone, 1)) + "/" + str.tostring(array.get(lbNZone, 2)) +
         "/" + str.tostring(array.get(lbNZone, 3)) + "/" + str.tostring(array.get(lbNZone, 4)) + "/" + str.tostring(array.get(lbNZone, 5)) + "/" + str.tostring(array.get(lbNZone, 6)), text_size = size.tiny)
    table.cell(lbTbl, 0, 27, "最大 走査/待機/タイミング/組合せ", text_size = size.tiny)
    table.cell(lbTbl, 1, 27, str.tostring(st.maxIter) + "/" + str.tostring(st.maxWaits) + "/" + str.tostring(st.maxTevs) + "/" + str.tostring(st.maxCombo), text_size = size.tiny)
    table.cell(lbTbl, 0, 28, "見送り 区分/だけ/SL/RR/時間/期間/数量/ZD接続/ZE接続", text_size = size.tiny)
    table.cell(lbTbl, 1, 28, str.tostring(array.get(skipN, 0)) + "/" + str.tostring(array.get(skipN, 1)) + "/" + str.tostring(array.get(skipN, 2)) + "/" +
         str.tostring(array.get(skipN, 3)) + "/" + str.tostring(array.get(skipN, 4)) + "/" + str.tostring(array.get(skipN, 5)) + "/" + str.tostring(array.get(skipN, 6)) + "/" + str.tostring(array.get(skipN, 7)) + "/" + str.tostring(array.get(skipN, 8)), text_size = size.tiny)
    table.cell(lbTbl, 0, 29, "競合/保有中/ロック消去/iFVG/FVG無効", text_size = size.tiny)
    table.cell(lbTbl, 1, 29, str.tostring(st.nConflict) + "/" + str.tostring(st.nHoldSkip) + "/" + str.tostring(st.nLockClr) + "/" + str.tostring(st.nIfvg) + "/" + str.tostring(st.nFvgDead), text_size = size.tiny)
    // ZD の受信状態 (1H / 4H / D / W): 正常 / 計算不能 / 履歴不足 / 外部OFF / 誤接続 / OFF
    string zds = ""
    bool zdErr = false
    for k = 0 to 3
        int z0 = array.get(lbZdStat, k)
        zds := zds + (k > 0 ? " / " : "") + (z0 == 0 ? "OFF" : z0 == 1 ? "正常" : z0 == 2 ? "計算不能" : z0 == 3 ? "履歴不足" : z0 == 8 ? "外部OFF" : "誤接続")
        zdErr := zdErr or z0 == 8 or z0 == 9
    table.cell(lbTbl, 0, 30, "ZD 受信 1H/4H/D/W", text_size = size.tiny, bgcolor = zdErr ? color.new(color.red, 60) : na)
    table.cell(lbTbl, 1, 30, zds + (zdErr ? "  → 新規発注停止 (MtfPocFeedXAU の 13 系列を接続)" : ""), text_size = size.tiny,
         text_color = zdErr ? color.red : color.black)
    // ZE の受信状態 (4H / D): 有効 / 波なし / 保留中 / 外部OFF / 誤接続 / OFF
    string zes = ""
    bool zeErr = false
    for k = 0 to 1
        int e0 = array.get(lbZeStat, k)
        zes := zes + (k > 0 ? " / " : "") + (e0 == 0 ? "OFF" : e0 == 1 ? "有効" : e0 == 2 ? "波なし" : e0 == 3 ? "保留中" : e0 == 8 ? "外部OFF" : "誤接続")
        zeErr := zeErr or e0 == 9
    table.cell(lbTbl, 0, 31, "ZE 受信 4H/D", text_size = size.tiny, bgcolor = zeErr ? color.new(color.red, 60) : na)
    table.cell(lbTbl, 1, 31, zes + (zeErr ? "  → 新規発注停止 (LongFibWave の 13 系列を接続)" : ""), text_size = size.tiny,
         text_color = zeErr ? color.red : color.black)

    table.cell(lbTbl, 0, 32, "TD 設定 / 1H4H見送り L/S (うちデータ不足)", text_size = size.tiny)
    table.cell(lbTbl, 1, 32, tdSetTxt + "  見送り " + (tdHfUse ? str.tostring(st.nTdSkL) + "/" + str.tostring(st.nTdSkS) +
         " (" + str.tostring(st.nTdSkD) + ")" : "OFF"), text_size = size.tiny)

// Data Window (検証用)
plot(st.nTrades,  "取引数 (台帳)", display = display.data_window)
plot(array.get(bkNet, 0), "純損益 (台帳・円)", display = display.data_window)
plot(st.maxDD,    "最大 DD (円)", display = display.data_window)
plot(array.size(lbZs) + array.size(lbFvgs), "静的 Zone 保持数", display = display.data_window)
plot(array.size(lbWaits), "待機数", display = display.data_window)
plot(array.size(lbTevs), "有効なタイミング数", display = display.data_window)
plot(st.iter,     "この足の Zone 走査数", display = display.data_window)
plot(st.nTA,      "TA 成立数", display = display.data_window)
plot(st.nTC,      "TC 成立数", display = display.data_window)
plot(st.nTE,      "TE 成立数", display = display.data_window)
plot(st.nTD,      "TD 成立数", display = display.data_window)
plot(st.nTdSkL,   "TD 1H4H見送り ロング候補数", display = display.data_window)
plot(st.nTdSkS,   "TD 1H4H見送り ショート候補数", display = display.data_window)
plot(st.nTdSkD,   "TD 1H4H見送り うち上位足データ不足", display = display.data_window)
plot(st.nTpHit,   "TP 到達数", display = display.data_window)
plot(st.nBE,      "建値移動数", display = display.data_window)
plot(st.nBadExit, "不正な出口", display = display.data_window)

    int   swSeq    = 0        // 元の水平線の ID (Zone の ID とは別の連番)
    int   nAccOut  = 0        // 採用件数から外れたアキュムの辺
    int   nTouch   = 0
    int   nCancel  = 0
    int   nFake    = 0
    int   nWaitNew = 0
    int   nWaitExp = 0
    int   nTA      = 0
    int   nTC      = 0
    int   nTE      = 0
    int   nTD      = 0
    int   nTdSkL   = 0      // TD: 1H / 4H 見送りで止めたロング候補 (データ不足を含む)
    int   nTdSkS   = 0
    int   nTdSkD   = 0      // TD: うち上位足データ不足
    int   nCand    = 0
    int   nConflict = 0
    int   nHoldSkip = 0
    int   nLockClr = 0
    int   nTpNtf   = 0
    int   ctSeen   = 0

var LbOrd o  = LbOrd.new(legPx = array.new_float(3, na), legLots = array.new_int(3, 0), ntfPx = array.new_float(3, na))
var LbSt  st = LbSt.new()

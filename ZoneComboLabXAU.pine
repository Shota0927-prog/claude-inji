     "同じ Zone へは 1 回だけ。別の Zone に通知した後は前の Zone の制限を解除する。同じ足の複数の Zone は 1 通にまとめる。売買には影響しない。")

// ============================================================================
// 02. FEEDS (確定した上位足だけ。ロジック区間からは履歴参照しない)
// ============================================================================
// ---- ZA: AccumStrategyXAU の Accum 検出 (byte 一致・tests/lab_sim.py が照合) ----
// ==== LAB Accum copy (begin) =================================================
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not _isAccum[1]          // v6: bool は na にならない (最初の足の [1] は false = v5 の nz(…, false) と同じ)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== LAB Accum copy (end) ===================================================

f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

// ---- ZB: EMA (1分足は 1分足の close で計算した値 = ZoneStrategyXAU の maPack 取得と同じ方式。5分足はチャート足) ----
float zbMa1 = request.security(syminfo.tickerid, "1", ta.ema(close, zbLen1), lookahead = barmerge.lookahead_off)
float zbMa2 = ta.ema(close, zbLen2)

// ---- ZC: Swing (Library pivotPack の式 + NR-S1 f_nrsPivotConfirmed の [1]・lookahead_on) ----
f_lbPivotConfirmed(simple int len) =>
    float _ph = ta.pivothigh(high, len, len)
    float _pl = ta.pivotlow(low,  len, len)
    int   _pt = na(_ph) ? int(na) : time
    int   _lt = na(_pl) ? int(na) : time
    [_ph[1], _pt[1], _pl[1], _lt[1]]

[s1h, s1ht, s1l, s1lt] = request.security(syminfo.tickerid, "60",  f_lbPivotConfirmed(zcPiv1), lookahead = barmerge.lookahead_on)
[s2h, s2ht, s2l, s2lt] = request.security(syminfo.tickerid, "240", f_lbPivotConfirmed(zcPiv2), lookahead = barmerge.lookahead_on)
[s3h, s3ht, s3l, s3lt] = request.security(syminfo.tickerid, "D",   f_lbPivotConfirmed(zcPiv3), lookahead = barmerge.lookahead_on)
[s4h, s4ht, s4l, s4lt] = request.security(syminfo.tickerid, "W",   f_lbPivotConfirmed(zcPiv4), lookahead = barmerge.lookahead_on)

// ---- ZD: POC は外部インジ MtfPocFeedXAU から input.source で受け取る (内蔵計算・POC 用 request.security は持たない) ----


// ---- ZF: FVG (ZoneStrategyXAU FVG Batch A の f_fvgConfirmed をそのまま) ----
// ==== LAB FVG copy (begin) ===================================================
f_fvgConfirmed(float minWidth) =>
    bool  _bull = low > high[2]
    bool  _bear = high < low[2]
    float _top  = _bull ? low : _bear ? low[2] : na
    float _bot  = _bull ? high[2] : _bear ? high : na
    int   _dir  = (_bull or _bear) and math.round_to_mintick(_top - _bot) >= minWidth ? (_bull ? 1 : -1) : 0
    [time[1], time_close[1], close[1], _dir[1], _top[1], _bot[1]]
// ==== LAB FVG copy (end) =====================================================

[g1k, g1kc, g1c, g1d, g1t, g1b] = request.security(syminfo.tickerid, "60",  f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g2k, g2kc, g2c, g2d, g2t, g2b] = request.security(syminfo.tickerid, "240", f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g3k, g3kc, g3c, g3d, g3t, g3b] = request.security(syminfo.tickerid, "D",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)
[g4k, g4kc, g4c, g4d, g4t, g4b] = request.security(syminfo.tickerid, "W",   f_fvgConfirmed(zfMinW), lookahead = barmerge.lookahead_on)

// ---- TC: SATS (ZoneStrategyXAU の f_satBand = tests/sats_src/f_satBand.txt をそのまま) ----
// ==== LAB SATS copy (begin) ==================================================
f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]
// ==== LAB SATS copy (end) ====================================================

[satL1, satL2, satStb, satD1, satD2, satSD, satBand, satBasis, satCommon, satAtr, satA1, satA2] = f_satBand()

f_satTfState() =>
    [l1, l2, sb, d1, d2, sd, st, b, cm, at, a1, a2] = f_satBand()
    int s = (na(l1) or na(l2) or na(sb)) ? na : st
    s[1]
int satTf4 = request.security(syminfo.tickerid, "240", f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf1 = request.security(syminfo.tickerid, "60",  f_satTfState(), lookahead = barmerge.lookahead_on)

// ---- ZG: ダブル / トリプル トップ・ボトム (LTB 検知器を 1H / 4H / D の中で 1 本ずつ。確定した足の結果だけ: 1 本ずらし・lookahead_on) ----
// ==== ZG LTB copy (begin) ===================================================
//  LongTermDoubleTripleTopBottomXAU.pine (LTB-15, 9e92c02) の検知処理 (LtB1 / LtH / ltNew1 / ltCand1 / ltStep1 / ltRevWhy) の写し。
//  【変更】EPS → ZG_EPS (この位置で使うため)、基準ごとに 2 回目以後の接触群の実体極値 gx を保持し、検知イベント D の末尾 (16 番目) に
//  Zone の基準価格 (トップ = max(1 回目の山, gx) / ボトム = min(1 回目の谷, gx)) を加える。検知の判定・接触の数え方は変えない
float ZG_EPS = 1e-7
// 監視基準 1 個 (トップ = 実体上端の山 / ボトム = 実体下端の谷)
type LtB1
    int    id
    int    side               // -1 = トップ / 1 = ボトム
    float  lvl                // 基準価格 P (トップ = 実体上端 / ボトム = 実体下端)
    int    pvT                // 実際の Pivot 足の time / time_close は使わない
    int    cfT                // 登録 (右側 N 本目) の足の time / time_close (この時刻から利用可能)
    int    cfTc
    int    aBar               // 登録した足 (この足では接触・反転を見ない)
    int    pvBar              // 実際の Pivot 足の bar_index (最大監視本数の起算 = 0 本目 / 1 回目の接触開始足)
    int    cnt      = 1       // 接触回数 (基準 Pivot = 1 回目)。不採用の接触も数える
    bool   inC      = true    // 帯に接触中
    int    lastSt             // 直前の接触開始足の bar_index
    int    sepN     = 0       // 直前の接触が終わってから帯を離れていた足の本数
    float  sepX               // その足の実体の極値 (トップ = 実体下端の最小 / ボトム = 実体上端の最大)
    bool   elig     = false   // 現在の接触がシグナル対象 (開始時に固定)
    bool   waiting  = false   // 現在の接触で反転待ち中
    int    waitEnd            // 反転待ちの最後の足 (接触開始足 + 反転待ち)
    int    stBar              // 現在の接触の開始足 bar_index / time / time_close / 接触価格 (トップ = high / ボトム = low)
    int    stT
    int    stTc
    float  stP
    string why      = ""      // 現在の接触の不採用・未検知の理由 (1 文字ずつ: G 間隔不足 / S 離れ幅不足 / Z 実体端が帯外 /
                              //   C 反転方向の色ではない / B 実体幅不足 / R 実体比率不足 / E 接触終了 / W 反転待ち終了 / V 基準無効化 / T 監視期限終了)
    float  gx                 // 【ZG 追加】2 回目以後の接触群の実体極値 (トップ = 実体上端の最高 / ボトム = 実体下端の最安。接触開始から検知足まで)

type LtH
    int    piv
    float  wave               // 最初の波の最低値幅
    float  buf                // 接近許容幅 (基準帯 = P ± buf)
    float  dist               // 接触間の最低離れ幅
    int    gapN               // 接触開始足どうしの最低間隔
    float  bodyMin            // 反転足の最低実体幅
    float  ratio              // 反転足の最低実体比率 (0〜1)
    int    wait               // 反転待ち
    int    maxN               // 最大監視本数
    bool   dirOn              // 最初の山・谷の方向フィルター (新しい基準の登録候補だけ)
    bool   sepOn              // 最低離れ幅フィルター (OFF なら離れ幅を採用条件から外す)
    array<float> bu           // 直近 (2N + 1) 本の実体上端・実体下端・高値・安値・time
    array<float> bd
    array<float> hh
    array<float> ll
    array<int>   ts
    array<LtB1>  bases
    int    seq      = 0       // ID (確定した Pivot 候補ごとに消費)
    int    prevT
    int    sSide    = 0       // 参照系列 (山・谷が交互) の最後の要素: 種類 (-1 山 / 1 谷 / 0 なし)・価格
    float  sP
    int    aSide    = 0       // その直前の要素 (反対側)
    float  aP
    int    pSide    = 0       // 方向フィルターの比較対象 = 系列で最後の要素の直前の同種 (種類が切り替わる時に更新前の aSide / aP から保存。
    float  pP                 //   同種の極値更新中は維持する)

ltNew1(int piv, float wave, float buf, float dist, int gapN, float bodyMin, float ratio, int wait, int maxN, bool dirOn, bool sepOn) =>
    LtH.new(piv, wave, buf, dist, gapN, bodyMin, ratio, wait, maxN, dirOn, sepOn, array.new_float(), array.new_float(), array.new_float(),
         array.new_float(), array.new_int(), array.new<LtB1>())

ltAdd(string s, string ch) =>
    str.contains(s, ch) ? s : s + ch

ltAddAll(string s, string w) =>
    string out = s
    int n = str.length(w)
    if n > 0
        for i = 0 to n - 1
            out := ltAdd(out, str.substring(w, i, i + 1))
    out

ltEvB1(LtB1 g, string ty) =>
    ";" + ty + "," + str.tostring(g.id) + "," + str.tostring(g.side) + "," + str.tostring(g.lvl, "#.########") + "," +
         str.tostring(g.pvT) + "," + str.tostring(g.cfT) + "," + str.tostring(g.cfTc)

ltEvS1(LtB1 g, string ty) =>
    ltEvB1(g, ty) + "," + str.tostring(g.cnt) + "," + str.tostring(g.stT) + "," + str.tostring(g.stTc) + "," + str.tostring(g.stP, "#.########")

// 反転足の条件 (すべて満たせば ""、満たさない理由を返す)。トップ = 陰線・実体上端が帯内 / ボトム = 陽線・実体下端が帯内
ltRevWhy(LtH S, bool top, float P, float o, float h, float l, float c) =>
    string w = ""
    float edge = top ? math.max(o, c) : math.min(o, c)
    if edge < P - S.buf - ZG_EPS or edge > P + S.buf + ZG_EPS
        w += "Z"
    if top ? not (c < o) : not (c > o)
        w += "C"
    float body = math.abs(c - o)
    if body < S.bodyMin - ZG_EPS
        w += "B"
    float rng = h - l
    if rng <= 0 or body < rng * S.ratio - ZG_EPS
        w += "R"
    w

// 確定した Pivot 候補 1 個: 参照系列の更新 → 最初の波の値幅 → Pivot 確定までの接触履歴 → 登録
ltCand1(LtH S, int side, float P, int pvT, int t, int tc, int bi) =>
    string ev = ""
    int N = S.piv
    S.seq += 1
    // 参照系列: 同じ種類が続けば、山はより高い (同値は後の足)・谷はより低いものに更新。更新しない同種 Pivot は追加しない
    bool adopt = false
    if S.sSide == side
        if side == -1 ? P >= S.sP : P <= S.sP
            S.sP := P
            adopt := true
    else
        // 種類の切り替え: 更新前の aSide / aP (= 今回と同種の直前の要素) を方向フィルターの比較対象に保存
        S.pSide := S.aSide
        S.pP    := S.aP
        S.aSide := S.sSide
        S.aP    := S.sP
        S.sSide := side
        S.sP    := P
        adopt   := true
    // 最初の波: 直前の反対側 Pivot だけを見る (無ければ作らない。さらに古い Pivot へ探し直さない)
    if adopt and S.aSide == -side and S.maxN >= N
        bool waveOk = side == -1 ? P - S.aP >= S.wave - ZG_EPS : S.aP - P >= S.wave - ZG_EPS
        // 最初の山・谷の方向フィルター (ON のときだけ): トップ = P > 前の山 + ZG_EPS / ボトム = P < 前の谷 − ZG_EPS。前の同種が無ければ登録しない
        bool dirOk = not S.dirOn or (S.pSide == side and (side == -1 ? P > S.pP + ZG_EPS : P < S.pP - ZG_EPS))
        if waveOk and dirOk
            // Pivot 足 (1 回目の接触開始) から登録足までの右側 N 本の接触履歴。離れてから再び接触していれば採用しない
            bool  inC    = true
            bool  second = false
            int   sepN   = 0
            float sepX   = na
            for j = N + 1 to 2 * N
                bool ct = array.get(S.hh, j) >= P - S.buf - ZG_EPS and array.get(S.ll, j) <= P + S.buf + ZG_EPS
                if ct
                    if not inC
                        second := true
                    inC := true
                else
                    inC := false
                    sepN += 1
                    float x = side == -1 ? array.get(S.bd, j) : array.get(S.bu, j)
                    sepX := na(sepX) ? x : side == -1 ? math.min(sepX, x) : math.max(sepX, x)
            if not second
                LtB1 g = LtB1.new(S.seq, side, P, pvT, t, tc, bi, bi - N, inC = inC, lastSt = bi - N, sepN = sepN, sepX = sepX)
                array.push(S.bases, g)
                ev += ltEvB1(g, "R")
    ev

// 1時間足 1 本 (確定 OHLC) の処理。返り値の形は ltStep と同じ (ブロック + イベント)
//   C (接触開始: 回数・開始足・high / low・シグナル対象 0/1・理由) / D (検知) / Y (シグナル対象の接触が未検知で終了: 理由) /
//   V,id,待機中,理由 (終値無効化) / T,id,待機中,理由 (監視期限) / R (登録) / E (終了)
ltStep1(LtH S, float o, float h, float l, float c, int t, int tc, int bi) =>
    string ev = ""
    float bu = math.max(o, c)
    float bd = math.min(o, c)
    int N = S.piv
    int W = 2 * N + 1
    array.push(S.bu, bu)
    array.push(S.bd, bd)
    array.push(S.hh, h)
    array.push(S.ll, l)
    array.push(S.ts, t)
    if array.size(S.bu) > W
        array.shift(S.bu)
        array.shift(S.bd)
        array.shift(S.hh)
        array.shift(S.ll)
        array.shift(S.ts)
    // 実体 Pivot (左側は同値可・右側は厳密)。右側 N 本目のこの足で確定。
    //   LTB-8: 同じ足が山と谷の両方なら、その足は参照系列に採用せず基準も作らない (系列は変えない。ID は山・谷それぞれ消費する)
    if array.size(S.bu) == W
        float mh = array.get(S.bu, N)
        float ml = array.get(S.bd, N)
        bool isH = true
        bool isL = true
        for j = 0 to W - 1
            if j < N
                isH := isH and mh >= array.get(S.bu, j)
                isL := isL and ml <= array.get(S.bd, j)
            if j > N
                isH := isH and mh > array.get(S.bu, j)
                isL := isL and ml < array.get(S.bd, j)
        int pvT = array.get(S.ts, N)
        if isH and isL
            S.seq += 2
        else
            if isH
                ev += ltCand1(S, -1, mh, pvT, t, tc, bi)
            if isL
                ev += ltCand1(S, 1, ml, pvT, t, tc, bi)
    // 各基準 (新しい基準から): ⓪ 監視期限 → ① 終値無効化 → ② 接触・反転。登録した足は飛ばす
    int ng = array.size(S.bases)
    if ng > 0
        for i = ng - 1 to 0
            LtB1 g = array.get(S.bases, i)
            if g.aBar < bi
                bool  top = g.side == -1
                float P   = g.lvl
                bool  fin = false
                if bi - g.pvBar > S.maxN
                    fin := true
                    ev += ";T," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "T")
                else if top ? c > P + S.buf + ZG_EPS : c < P - S.buf - ZG_EPS
                    fin := true
                    ev += ";V," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0") + "," + ltAdd(g.why, "V")
                else
                    // 接触 = high ≥ P − buf かつ low ≤ P + buf (ヒゲを含む)。接触していない足 = 帯から離れた足
                    bool ct = h >= P - S.buf - ZG_EPS and l <= P + S.buf + ZG_EPS
                    if ct
                        if not g.inC
                            // 新しい接触の開始: 回数を数え、シグナル対象かを開始時に固定 (間隔・離れ幅。不採用でも回数は消費する)
                            g.cnt += 1
                            g.inC := true
                            string why = ""
                            bool gapOk = bi - g.lastSt >= S.gapN
                            bool sepOk = not S.sepOn or (g.sepN > 0 and (top ? P - g.sepX >= S.dist - ZG_EPS : g.sepX - P >= S.dist - ZG_EPS))
                            if not gapOk
                                why += "G"
                            if not sepOk
                                why += "S"
                            g.elig    := gapOk and sepOk and g.cnt <= 3
                            g.why     := why
                            g.lastSt  := bi
                            g.stBar   := bi
                            g.stT     := t
                            g.stTc    := tc
                            g.stP     := top ? h : l
                            g.sepN    := 0
                            g.sepX    := na
                            g.waiting := g.elig
                            g.waitEnd := bi + S.wait
                            ev += ltEvS1(g, "C") + "," + (g.elig ? "1" : "0") + "," + why
                            if not g.elig and g.cnt >= 3
                                fin := true
                        // 【ZG 追加】2 回目以後の接触群の実体極値 (検知の判定には使わない)
                        if g.cnt >= 2
                            g.gx := na(g.gx) ? (top ? bu : bd) : top ? math.max(g.gx, bu) : math.min(g.gx, bd)
                        // 反転待ち (接触開始足 = 0 本目〜反転待ちの本数目。接触が続いている足だけ)
                        if g.waiting
                            string fw = ltRevWhy(S, top, P, o, h, l, c)
                            if fw == ""
                                g.waiting := false
                                ev += ltEvS1(g, "D") + "," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(bi - g.stBar) + "," +
                                     str.tostring(bu, "#.########") + "," + str.tostring(bd, "#.########") + "," +
                                     str.tostring(top ? math.max(P, g.gx) : math.min(P, g.gx), "#.########")     // 【ZG 追加】Zone の基準価格
                                if g.cnt >= 3
                                    fin := true
                            else
                                g.why := ltAddAll(g.why, fw)
                                if bi >= g.waitEnd
                                    g.waiting := false
                                    g.why := ltAdd(g.why, "W")
                                    ev += ";Y," + str.tostring(g.id) + "," + g.why
                                    if g.cnt >= 3
                                        fin := true
                    else
                        // 帯から離れた足: 接触の終了 (待機中ならその接触の待機も終了) と、離れ幅の記録 (実体)
                        if g.inC
                            g.inC := false
                            if g.waiting
                                g.waiting := false
                                g.why := ltAdd(g.why, "E")
                                ev += ";Y," + str.tostring(g.id) + "," + g.why
                                if g.cnt >= 3
                                    fin := true
                        g.sepN += 1
                        float x = top ? bd : bu
                        g.sepX := na(g.sepX) ? x : top ? math.min(g.sepX, x) : math.max(g.sepX, x)
                if fin
                    array.remove(S.bases, i)
                    ev += ";E," + str.tostring(g.id)
    string hd = "B," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(S.prevT) + "," + str.tostring(array.size(S.bases)) +
         "," + str.tostring(bi)
    S.prevT := t
    hd + ev
// ==== ZG LTB copy (end) =====================================================

// 対象時間足の中の計算。返すのは確定済みの直前 2 本 (k − 1、k − 2) のブロック (LongTermDoubleTripleTopBottomXAU の f_ltCore のオフセット 1 と同じ)。
//  on = false (利用・表示とも OFF) なら計算しない
f_zgCore(int k, bool on) =>
    var LtH S = k == 0 ? ltNew1(zgPiv1, zgWave1, zgBuf1, zgDist1, zgGap1, zgBody1, zgRatio1 / 100.0, zgWait1, zgMax1, zgDir1, zgSep1) :
         k == 1 ? ltNew1(zgPiv4, zgWave4, zgBuf4, zgDist4, zgGap4, zgBody4, zgRatio4 / 100.0, zgWait4, zgMax4, zgDir4, zgSep4) :
         ltNew1(zgPivD, zgWaveD, zgBufD, zgDistD, zgGapD, zgBodyD, zgRatioD / 100.0, zgWaitD, zgMaxD, zgDirD, zgSepD)
    var string prevBlk = ""
    string blk = on ? ltStep1(S, open, high, low, close, time, time_close, bar_index) : ""
    string out = prevBlk == "" ? blk : prevBlk + ";" + blk
    prevBlk := blk
    out[1]
string zgPk1 = request.security(syminfo.tickerid, "60",  f_zgCore(0, zgUse1 or zgShow1), lookahead = barmerge.lookahead_on)
string zgPk4 = request.security(syminfo.tickerid, "240", f_zgCore(1, zgUse4 or zgShow4), lookahead = barmerge.lookahead_on)
string zgPkD = request.security(syminfo.tickerid, "D",   f_zgCore(2, zgUseD or zgShowD), lookahead = barmerge.lookahead_on)

// ---- TD: StochMtfSignal (SMT-6) の判定を 1分コンテキストで実行 (request.security_lower_tf) ----
//  以下の f_tdStoch / TdAgg / f_tdNewAgg / f_tdCurMain / f_tdPush / f_tdStep は StochMtfSignal.pine の f_mtStoch / HtfAgg / f_newAgg /
//  f_curMain / f_push / f_step の写し (名前だけ変更)。
// MT5 Stochastic Oscillator (Low/High・Simple)。チャート (1分足) の系列用。戻り値 [Main, Signal]。データ不足の間は na。
f_tdStoch(int kPer, int dPer, int slow) =>
    float ll = ta.lowest(low, kPer)
    float hh = ta.highest(high, kPer)
    float mainV = na
    if bar_index >= kPer + slow - 2
        float sLow  = 0.0
        float sHigh = 0.0
        for j = slow - 1 to 0                       // MT5: k = i−slow+1 .. i (同じ加算順)
            sLow  += close[j] - ll[j]
            sHigh += hh[j] - ll[j]
        mainV := sHigh == 0.0 ? 100.0 : sLow / sHigh * 100
    float sigV = na
    if bar_index >= kPer + slow + dPer - 3
        float s = 0.0
        for j = 0 to dPer - 1                       // MT5: sum += Main[i−k], k = 0 .. dPer−1
            s += mainV[j]
        sigV := s / dPer
    [mainV, sigV]

// ---- 1分足から再現する上位足 ----
// 確定済み上位足の履歴 (古い順、直近 cap 本) と現在の上位足 1本。
type TdAgg
    array<float> hi          // 確定済み上位足の High
    array<float> lo          // 確定済み上位足の Low
    array<float> cl          // 確定済み上位足の Close
    array<float> ll          // 確定済み上位足の LL (完成時の値)
    array<float> hh          // 確定済み上位足の HH (完成時の値)
    array<float> mk          // 確定済み上位足の K  (完成時の値)
    int   nDone              // 採用した確定済み上位足の本数 (= 現在の上位足の通し番号)
    bool  started            // 1本目の区間を始めたか
    int   curOpen            // 現在の上位足の開始時刻 (time(tf))
    int   curClose           // 現在の上位足の終了予定時刻 (time_close(tf))
    float cO
    float cH
    float cL
    float cC
    bool  curValid           // 現在の区間を採用するか (読込開始時に途中から始まった最初の区間は false)
    bool  curFinal           // 現在の区間を登録済みか

f_tdNewAgg() =>
    TdAgg.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), 0, false, na, na, na, na, na, na, false, false)

// 現在の上位足 (High h / Low l / Close c) の [K, LL, HH]。系列 = 確定済み履歴 + 現在の 1本 (MT5 と同じ式・加算順)。
f_tdCurMain(TdAgg a, int kPer, int slow, float h, float l, float c) =>
    int n  = a.nDone
    int sz = array.size(a.hi)
    float llv = na
    float hhv = na
    float mainv = na
    if n >= kPer - 1
        llv := l
        hhv := h
        if kPer > 1
            for j = 1 to kPer - 1
                llv := math.min(llv, array.get(a.lo, sz - j))
                hhv := math.max(hhv, array.get(a.hi, sz - j))
    if n >= kPer + slow - 2
        float sL = 0.0
        float sH = 0.0
        if slow > 1
            for j = slow - 1 to 1                    // 古い足から (MT5: k = i−slow+1 .. i)
                sL += array.get(a.cl, sz - j) - array.get(a.ll, sz - j)
                sH += array.get(a.hh, sz - j) - array.get(a.ll, sz - j)
        sL += c - llv
        sH += hhv - llv
        mainv := sH == 0.0 ? 100.0 : sL / sH * 100
    [mainv, llv, hhv]

// 現在の上位足を確定済み履歴へ一度だけ登録する
f_tdPush(TdAgg a, int cap, float m, float llv, float hhv) =>
    array.push(a.hi, a.cH)
    array.push(a.lo, a.cL)
    array.push(a.cl, a.cC)
    array.push(a.ll, llv)
    array.push(a.hh, hhv)
    array.push(a.mk, m)
    if array.size(a.hi) > cap
        array.shift(a.hi)
        array.shift(a.lo)
        array.shift(a.cl)
        array.shift(a.ll)
        array.shift(a.hh)
        array.shift(a.mk)
    a.nDone := a.nDone + 1
    a.curFinal := true
    true

// 確定した 1分足 1本で上位足を進める。戻り値 [K0, K1, K2, 今回完成したか, 現在の区間を採用しているか]
f_tdStep(TdAgg a, int tfOpen, int tfClose, int kPer, int slow, int cap) =>
    float k0 = na
    float k1 = na
    float k2 = na
    bool closedNow = false
    if not na(tfOpen)
        if not a.started or tfOpen != a.curOpen
            // 前の区間が最後の 1分足なしで終わっていた場合: その時点までの値で一度だけ登録
            if a.started and a.curValid and not a.curFinal
                [pm, pl, ph] = f_tdCurMain(a, kPer, slow, a.cH, a.cL, a.cC)
                f_tdPush(a, cap, pm, pl, ph)
            a.curValid := a.started or time == tfOpen      // 読込開始時の不完全な区間は採用しない
            a.started  := true
            a.curOpen  := tfOpen
            a.curClose := tfClose
            a.cO := open
            a.cH := high
            a.cL := low
            a.cC := close
            a.curFinal := false
        else
            a.curClose := tfClose
            a.cH := math.max(a.cH, high)
            a.cL := math.min(a.cL, low)
            a.cC := close
        int sz = array.size(a.mk)
        k1 := sz >= 1 ? array.get(a.mk, sz - 1) : na
        k2 := sz >= 2 ? array.get(a.mk, sz - 2) : na
        closedNow := not na(tfClose) and time_close >= tfClose
        if a.curValid
            [cm, cl0, ch0] = f_tdCurMain(a, kPer, slow, a.cH, a.cL, a.cC)
            k0 := cm
            if closedNow and not a.curFinal
                f_tdPush(a, cap, cm, cl0, ch0)               // 区間最後の 1分足: 完成した上位足を登録 (この判定の K0 も同じ足)
        else if closedNow
            a.curFinal := true                              // 不採用の区間は登録しない
    [k0, k1, k2, closedNow, a.curValid]

// 1分足 1本の判定 (StochMtfSignal の 1分・5分・15分・1H / 4H 見送りの条件式と同じ)。戻り値 [方向 (1 / −1 / 0), 1分足の time_close]。
//  上位足は各 1分足の実行ごとに進める (リクエスト内の barstate.isconfirmed には依存しない。確定チェックは Lab 側の確定 5分足で行う)
f_tdSig() =>
    [k1m, d1m] = f_tdStoch(tdKPer, tdDPer, tdSlow)
    int hcap = math.max(tdKPer, tdSlow) + 3
    var TdAgg agg5   = f_tdNewAgg()
    var TdAgg agg15  = f_tdNewAgg()
    var TdAgg agg60  = f_tdNewAgg()
    var TdAgg agg240 = f_tdNewAgg()
    [k5_0, k5_1, k5_2, c5Now, v5]          = f_tdStep(agg5,   time("5"),   time_close("5"),   tdKPer, tdSlow, hcap)
    [k15_0, k15_1, k15_2, c15Now, v15]     = f_tdStep(agg15,  time("15"),  time_close("15"),  tdKPer, tdSlow, hcap)
    [k60_0, k60_1, k60_2, c60Now, v60]     = f_tdStep(agg60,  time("60"),  time_close("60"),  tdKPer, tdSlow, hcap)
    [k240_0, k240_1, k240_2, c240Now, v240] = f_tdStep(agg240, time("240"), time_close("240"), tdKPer, tdSlow, hcap)
    // ---- 1分足 ----
    bool d1Ok = not na(k1m) and not na(k1m[1]) and not na(d1m) and not na(d1m[1])
    float k1Max = na
    float k1Min = na
    bool winOk = true
    for j = 0 to tdReachN - 1
        float v = k1m[j]
        if na(v)
            winOk := false
            break
        k1Max := na(k1Max) ? v : math.max(k1Max, v)
        k1Min := na(k1Min) ? v : math.min(k1Min, v)
    bool data1 = d1Ok and winOk
    float k1Chg = k1m - k1m[1]
    bool sCross1 = data1 and k1m[1] >= d1m[1] and k1m < d1m
    bool lCross1 = data1 and k1m[1] <= d1m[1] and k1m > d1m
    bool sMove1  = data1 and -k1Chg >= tdMinMv
    bool lMove1  = data1 and k1Chg >= tdMinMv
    bool sReach1 = data1 and k1Max >= tdUpLv
    bool lReach1 = data1 and k1Min <= tdLoLv
    // ---- 5分足 ----
    bool m5Decel = td5Mode == TD_DECEL
    bool data5 = not na(k5_0) and not na(k5_1) and (not m5Decel or not na(k5_2))
    float dl5_0 = k5_0 - k5_1
    float dl5_1 = k5_1 - k5_2
    bool s5Mid = not td5Mid or k5_0 > 50.0
    bool l5Mid = not td5Mid or k5_0 < 50.0
    bool s5Dir = m5Decel ? (dl5_0 < 0 or (0 < dl5_0 and dl5_0 < dl5_1)) : dl5_0 < 0
    bool l5Dir = m5Decel ? (dl5_0 > 0 or (dl5_1 < dl5_0 and dl5_0 < 0)) : dl5_0 > 0
    bool s5 = data5 and s5Mid and s5Dir
    bool l5 = data5 and l5Mid and l5Dir
    // ---- 15分足 ----
    bool data15 = not na(k15_0) and not na(k15_1) and not na(k15_2)
    float dl0 = k15_0 - k15_1
    float dl1 = k15_1 - k15_2
    bool s15Mid = not td15Mid or k15_0 > 50.0
    bool l15Mid = not td15Mid or k15_0 < 50.0
    bool s15Dir = dl0 < 0 or (0 < dl0 and dl0 < dl1)
    bool l15Dir = dl0 > 0 or (dl1 < dl0 and dl0 < 0)
    bool s15 = data15 and s15Mid and s15Dir
    bool l15 = data15 and l15Mid and l15Dir
    bool s15Ok = not td15Use or s15
    bool l15Ok = not td15Use or l15
    // ---- 1時間・4時間の見送りフィルタ ----
    bool dataLvl = not na(k60_0) and not na(k240_0)
    bool dataR15 = not na(k15_0) and not na(k15_1)
    bool dataR60 = not na(k60_0) and not na(k60_1)
    bool dataHf  = dataLvl and (not tdHfRev15 or dataR15) and (not tdHfRev60 or dataR60)
    bool dn15 = dataR15 and k15_0 < k15_1
    bool up15 = dataR15 and k15_0 > k15_1
    bool dn60 = dataR60 and k60_0 < k60_1
    bool up60 = dataR60 and k60_0 > k60_1
    bool revAny = tdHfRev15 or tdHfRev60
    bool lLvlHf = dataLvl and k60_0 >= tdHfUp and k240_0 >= tdHfUp
    bool sLvlHf = dataLvl and k60_0 <= tdHfLo and k240_0 <= tdHfLo
    bool lRevHf = not revAny or (tdHfRev15 and dn15) or (tdHfRev60 and dn60)
    bool sRevHf = not revAny or (tdHfRev15 and up15) or (tdHfRev60 and up60)
    bool lSkipHf = dataHf and lLvlHf and lRevHf
    bool sSkipHf = dataHf and sLvlHf and sRevHf
    bool lHfOk = not tdHfUse or (dataHf and not lSkipHf)
    bool sHfOk = not tdHfUse or (dataHf and not sSkipHf)
    // ---- 成立 ----
    bool dataAll  = data1 and data5 and (not td15Use or data15) and (not tdHfUse or dataHf)
    bool shortSig = dataAll and sCross1 and sMove1 and sReach1 and s5 and s15Ok and sHfOk
    bool longSig  = dataAll and lCross1 and lMove1 and lReach1 and l5 and l15Ok and lHfOk
    int dir = longSig ? 1 : shortSig ? -1 : 0
    [dir, time_close]

[labTdDir, labTdTc] = request.security_lower_tf(syminfo.tickerid, "1", f_tdSig(), ignore_invalid_timeframe = true)

// ---- TE: 15分足の確定した 1 本の実体端 (上位足の中で [1]・lookahead_on。届くのは確定した足だけ) ----
[labTe15T, labTe15B, labTe15t] = request.security(syminfo.tickerid, "15", [math.max(open[1], close[1]), math.min(open[1], close[1]), time[1]],
     lookahead = barmerge.lookahead_on)

// ---- 5分足の確定済みの値 (ロジック区間は履歴参照しないため、ここで取り出す) ----
float labC1 = close[1]      // TA FVG の中央足 / TC の前足終値 / 接触の範囲 (前の終値)
float labO1 = open[1]
float labH2 = high[2]
float labL2 = low[2]
float labS1 = satL1[1]      // TC: 足 t の判定に使う足 t-1 の確定線
float labS2 = satL2[1]
float labS3 = satStb[1]
bool  labRangeOK = not prUse or (time >= prStart and time < prEnd)

// ============================================================================
// 03. LOGIC
// ============================================================================
// ==== LAB Logic (begin) ======================================================
//  (この区間は tests/lab_sim.py が Python へ機械変換して実行する。na の算術・比較は使わない)
float EPS = 1e-7

// TE の設定矛盾: 最大離れ幅制限 ON で最大 < 最低 (自動補正しない)
if teMxUse5 and teMx5 < teD5
    runtime.error("ZCL TE: 5分基準の最大離れ幅 (" + str.tostring(teMx5) + " $) が最低離れ幅 (" + str.tostring(teD5) + " $) より小さい設定です。")
if teMxUse15 and teMx15 < teD15
    runtime.error("ZCL TE: 15分基準の最大離れ幅 (" + str.tostring(teMx15) + " $) が最低離れ幅 (" + str.tostring(teD15) + " $) より小さい設定です。")

// Zone 1 個。typ: 0 ZA / 1 ZB / 2 ZC / 3 ZD / 4 ZF / 5 ZE / 6 ZG (tf 0 1H / 1 4H / 2 D)。tf: ZA 0 1H / 1 4H / 2 D、ZB 0 1分 / 1 5分、ZC・ZD・ZF 0 1H / 1 4H / 2 D / 3 W、
//  ZE 0 4H / 1 D (sub = 波の方向、infoA = 比率、infoB = 更新確定時刻、key = 波 ID)
type LbZone
    int   id
    int   typ
    int   tf
    int   sub                 // ZA 1 上辺 / -1 下辺、ZC 1 高値 / -1 安値、ZF 1 上昇 FVG / -1 下降 FVG、他 0
    float ctr
    float bot
    float top
    float infoA               // ZD: 元の最大出来高区画の下限 / ZA: Accum の下辺
    float infoB               // ZD: 元の区画の上限 / ZA: Accum の上辺
    int   key                 // ZA Accum ID / ZC Pivot 時刻 / ZF 形成足の時刻
    int   aBar                // 登録した 5分足 (次の足から接触)
    int   aTime
    int   pos      = 0        // 帯の外側の最後の終値: -1 下 / 1 上 / 0 未定
    int   brk      = 0        // 直近の突破: 1 上抜け / -1 下抜け / 0 なし
    int   brkBar   = 0
    bool  inv      = false    // ZF: iFVG
    bool  dead     = false    // ZF: 無効 / 採用件数から外れたアキュムの辺 / 他の水平線 Zone に統合された水平線 Zone / 更新された旧 POC
    array<float> mP           // ZC: 構成水平線の元価格・時間足・成立時刻 (Pivot 時刻)・ID (水平線の連番。登録順)
    array<int>   mTf
    array<int>   mT
    array<int>   mId
    bool  zgUse    = true     // ZG: Strategy で利用 (false = 表示だけ。Zone の一覧・接触・条件・SL・TP 候補に入れない)
    bool  zgShow   = true     // ZG: 表示

// 形成中の Accum (固定したら Zone にして外す)
type LbAcc
    int   tf
    int   aid
    float up
    float lo

// 待機 1 個 (Zone の組 × 方向)。OR は Zone 1 個、AND は重なった Zone の組
type LbWait
    int    id
    string key                // Zone ID を昇順に "|" で連結
    int    side               // 1 LONG / -1 SHORT
    int    cat                // 1 反発 / 2 ダマシ / 3 サポレジ転換 (作った時の代表)
    bool   cReb   = false     // 組の各 Zone の区分 (ON / OFF の判定用)
    bool   cFake  = false
    bool   cRole  = false
    int    tmask              // 種類のマスク (2^typ の和)
    array<int> ids
    float  cBot               // 接触した区間 (OR = 帯 / AND = 重なり)。最後の接触時
    float  cTop
    float  eBot               // SL 基準の帯全体 (最後の接触時のスナップショット)
    float  eTop
    int    sBar               // 連続した待機の最初の接触足
    int    lBar               // 最後の接触足
    string desc

// タイミング 1 個 (成立足 = 0 本目)
type LbTev
    int    id
    int    kind               // 1 TA / 2 TC / 3 TE / 4 TD
    int    side
    int    eBar
    bool   used   = false
    string desc
    int    aBar               // TE: 検知した基準の接近足 (待機の到達足以後か判定する)

// TE: 基準足ごとの直近 (2N + 1) 本の実体上端・実体下端 (0 = 5分 / 1 = 15分)
type LbDtW
    array<float> hs
    array<float> ls
    int   lastT

// TE: 短期 DTB の基準 (山 = トップ / 谷 = ボトム)
type LbDt
    int   tf                  // 0 = 5分 / 1 = 15分
    int   side                // -1 = トップ (SHORT) / 1 = ボトム (LONG)
    float lvl                 // 基準の実体端
    int   aBar                // 登録した確定 5分足
    bool  away                // 最低離れ幅を満たしている (次の接近を数えられる)
    int   cnt      = 1        // 接近回数 (山・谷そのものが 1 回目)
    bool  waiting  = false
    int   appBar
    int   waitEnd
    float ext                 // 山・谷の次の足からの実体下端の最小値 (トップ) / 実体上端の最大値 (ボトム)

// TA: 監視中の 5分足 FVG (ACC-5A AcFvg と同じ)
type LbFvg
    int   id
    int   dir                 // 1 = 上昇 FVG (SHORT 吸収用) / -1 = 下降 FVG (LONG 吸収用)
    int   fBar
    float lo
    float hi

// 候補 (確定足の中だけ)
type LbCand
    int    wi                 // 待機の位置
    int    side
    float  sl
    float  slw
    float  tp1
    float  rr
    float  qty
    float  dist
    int    ia     = -1        // 使う TA の位置
    int    ic     = -1        // 使う TC の位置
    int    omask  = 0
    int    nT     = 0         // 判断時の TP 目標の数
    int    ie     = -1        // 使う TE の位置
    int    it     = -1        // 使う TD の位置

// 注文 / ポジション (1 つ) と取引台帳の作業域
type LbOrd
    int    state    = 0       // 0 なし / 1 entry 発注済み / 2 保有中 / 3 不正な出口のため決済中
    int    n        = 0
    string id       = ""
    int    side     = 0
    float  ref
    float  sl                 // 初期 SL
    float  stop               // 現在の stop (初期 SL / 建値)
    bool   be       = false
    float  fill
    int    lotN     = 0       // 全数量 (lot 刻みの個数)
    float  lotQ               // lot 刻み 1 個の TradingView 数量
    int    closedLots = 0
    int    stage    = 0       // 利確で完了した最後の段 (1〜3)
    int    bar
    float  tp1E               // 建値の割合方式の基準 (エントリー時点の TP1)
    bool   tp1Fix   = false   // エントリー時点の TP1 が固定 RR (約定後に実約定価格で計算し直す)
    array<float> legPx        // 段 1〜3 の利確価格 (na = 注文なし)
    array<int>   legLots
    array<float> ntfPx        // 段ごとの最後に通知した TP
    int    tmask
    int    omask
    bool   cReb     = false
    bool   cFake    = false
    bool   cRole    = false
    int    tim      = 0       // ビット: 1 TA / 2 TC / 4 TE / 8 TD
    string desc
    float  pnl      = 0.0
    int    nTp      = 0
    bool   lastStop = false
    float  lastTp             // 建値ロック用: 決済直前に残っていた最も遠い段の TP (最終 TP)
    label  lbl

// 状態・集計の作業域 (関数から更新するもの)
type LbSt
    int   zSeq     = 0
    int   wSeq     = 0
    int   tSeq     = 0
    int   fvSeq    = 0
    float maxW     = 0.0      // lbZs の最大の帯幅 (区間検索の範囲。= 共通幅 × 2)
    float maxWF    = 0.0      // lbFvgs の最大の帯幅
    float realized = 0.0      // 実現損益 (円・この Strategy の取引の合計)
    float peak
    float maxDD    = 0.0
    float maxDDPct = 0.0
    int   iter     = 0        // この足の Zone 走査数
    int   maxIter  = 0
    int   maxWaits = 0
    int   maxTevs  = 0
    int   maxCombo = 0
    int   nTrades  = 0
    int   nTpHit   = 0
    int   nBE      = 0
    int   nBadExit = 0
    int   nQtyAnom = 0
    int   nIfvg    = 0
    int   nFvgDead = 0
    int   nSwMerge = 0        // 水平線の統合 (既存の水平線 Zone に新しい水平線を加えた回数)
    int   swSeq    = 0        // 元の水平線の ID (Zone の ID とは別の連番)
    int   nAccOut  = 0        // 採用件数から外れたアキュムの辺
    int   nTouch   = 0
    int   nCancel  = 0
    int   nFake    = 0
    int   nWaitNew = 0
    int   nWaitExp = 0
    int   nTA      = 0
    int   nTC      = 0
    int   nTE      = 0
    int   nTD      = 0
    int   nCand    = 0
    int   nConflict = 0
    int   nHoldSkip = 0
    int   nLockClr = 0
    int   nTpNtf   = 0
    int   ctSeen   = 0

var LbOrd o  = LbOrd.new(legPx = array.new_float(3, na), legLots = array.new_int(3, 0), ntfPx = array.new_float(3, na))
var LbSt  st = LbSt.new()
var array<LbZone> lbZs   = array.new<LbZone>()     // 帯の幅が共通幅の静的 Zone (ZA / ZC / ZD)。下限の昇順。削除しない
var array<LbZone> lbFvgs = array.new<LbZone>()     // ZF (本来の上下限・幅はさまざま)。下限の昇順。iFVG の再突破でだけ削除
var array<LbZone> lbZsT  = array.new<LbZone>()     // lbZs の上限の昇順 (水平線の統合で帯の幅が変わるため、SHORT の TP 探索で上限の降順に読む)
var array<LbZone> lbSw   = array.new<LbZone>()     // 有効な水平線 Zone (作った順)
var array<LbZone> lbFvgsT = array.new<LbZone>()    // ZF の上限の昇順 (SHORT の TP 探索で上限の降順に読む。lbFvgs と同じオブジェクト)
var map<string, LbWait> lbWaitMap = map.new<string, LbWait>()   // "方向#待機キー" → 待機 (lbWaits と同期。評価順は lbWaits)
var array<int>   lbZdStat = array.new_int(4, 0)     // ZD の受信状態: 0 OFF / 1 正常 / 2 計算不能 / 3 履歴不足 / 8 外部側 OFF / 9 未接続・誤接続
var LbZone lbMa1 = na                               // ZB 1分足 EMA
var LbZone lbMa2 = na                               // ZB 5分足 EMA
var array<LbAcc>  lbAccs = array.new<LbAcc>()      // 形成中の Accum
var array<int>    lbAccLast = array.new_int(3, na)  // 時間足ごとに前回届いた Accum ID
var array<int>    lbPivLastH = array.new_int(4, na)
var array<int>    lbPivLastL = array.new_int(4, na)
var array<float>  lbPocLast  = array.new_float(4, na)
var array<LbZone> lbPocCur   = array.new<LbZone>(4, na)    // 時間足ごとの有効な POC Zone (最新の確定 POC 1 つ)
var array<int>    lbFvgLast  = array.new_int(4, na)
var array<int>    lbNZone    = array.new_int(7, 0)   // 種類ごとの保持数 (ZB は 0〜2、ZE は 0〜8、ZG は利用中のものだけ)
var array<int>    lbZeStat   = array.new_int(2, 0)   // ZE の受信状態 (4H / D): 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続
var array<float>  lbZeLast   = array.new_float(10, na)   // ZE: 時間足ごとに採用中の [起点, 終点, 方向, 波 ID, 状態] (状態 1 = Zone あり)
var array<LbZone> lbZeZ      = array.new<LbZone>()      // ZE: 有効なフィボ Zone (時間足ごとに最大 4)
var array<LbZone> lbZgZ      = array.new<LbZone>()      // ZG: 有効なダブル / トリプル Zone (利用 OFF の表示だけのものを含む)
var array<int>    lbZgUsed   = array.new_int()          // ZG: 発動済みの根拠 (基準 ID × 3 + 時間足)。消えた根拠も残して再登録しない
var array<int>    lbZgLast   = array.new_int(3, na)     // ZG: 時間足ごとに取り込んだ最後の対象足の time
var array<LbWait> lbWaits = array.new<LbWait>()
var array<LbTev>  lbTevs  = array.new<LbTev>()
var array<LbDtW>  lbDtWs  = array.new<LbDtW>()     // TE: 5分 / 15分の窓
var array<LbDt>   lbDts   = array.new<LbDt>()      // TE: 追跡中の基準 (Zone の到達とは無関係に常時)
var LbFvg lbFvUp = na                               // TA: 監視中の上昇 FVG
var LbFvg lbFvDn = na
// 表示中の帯 (古い順。重なる Zone をまとめた帯 1 つ = 1 個。gone = 無効化した FVG の灰色の帯)。表示だけに使い、売買には使わない
type LbDsG
    box   bx
    label lb                  // 名称 (最新足の 3 本先・帯の上下限の中点。帯の中の文字は使わない)
    float bot
    float top
    bool  gone
    array<LbZone> mem
var array<LbDsG>  lbDsG  = array.new<LbDsG>()
var array<LbZone> lbAccZ = array.new<LbZone>()      // 採用中のアキュムの辺 (固定した順。1 箱 = 上辺・下辺の 2 個が続けて入る)
var array<int>    lbDeadNow = array.new_int()     // この足で外した Zone (無効化した FVG・採用件数から外れたアキュムの辺) → 待機を解除
var array<label>  lbLbls  = array.new<label>()
var int hTqL1 = na                                  // TC: 接触記録 (f_satHist と同じ)
var int hTqL2 = na
var int hTqL3 = na
var int hTqS1 = na
var int hTqS2 = na
var int hTqS3 = na
// 取引台帳の区分別集計 (0 全体 / 1〜5 含む ZA〜ZF / 6〜10 だけ ZA〜ZF / 11 TA / 12 TC / 13 反発 / 14 ダマシ / 15 サポレジ / 16 LONG / 17 SHORT /
//  18 含む ZE / 19 だけ ZE / 20 含む ZG / 21 だけ ZG / 22 TE / 23 TD)
var array<int>   bkN   = array.new_int(24, 0)
var array<int>   bkW   = array.new_int(24, 0)
var array<int>   bkL   = array.new_int(24, 0)
var array<int>   bkBE  = array.new_int(24, 0)
var array<float> bkGP  = array.new_float(24, 0.0)
var array<float> bkGL  = array.new_float(24, 0.0)
var array<float> bkR   = array.new_float(24, 0.0)
var array<float> bkNet = array.new_float(24, 0.0)
// 候補の見送り理由 (タイミング成立後): 0 区分 OFF / 1 だけ (他種類の重なり) / 2 SL / 3 RR / 4 時間帯 / 5 期間 / 6 数量 / 7 ZD 接続異常 /
//  8 ZE 接続異常
var array<int>   skipN = array.new_int(9, 0)
// 建値ロック (BEL-1)
var bool  lkOn   = false
var int   lkSide = 0
var float lkSL   = na
var float lkTP   = na
var int   lkBar  = na
// 再計算設定の保護 (ACC-2)
varip int lbExecBar = -1
varip int lbExecN   = 0

f_pow2(int b) =>
    b == 0 ? 1 : b == 1 ? 2 : b == 2 ? 4 : b == 3 ? 8 : b == 4 ? 16 : b == 5 ? 32 : 64     // ZE = 5 → 32 (FVG の 16 は変えない)、ZG = 6 → 64

f_bit(int m, int b) =>
    math.floor(m / f_pow2(b)) % 2 == 1

f_typName(int t) =>
    t == 0 ? "アキュム" : t == 1 ? "MA" : t == 2 ? "水平線" : t == 3 ? "出来高POC" : t == 5 ? "フィボ" : t == 6 ? "ダブル/トリプル" : "FVG"

// 時間足の表記と順位 (表示で上位の時間足から並べる: 週足 0 / 日足 1 / 4時間足 2 / 1時間足 3 / 5分足 4 / 1分足 5)
f_tfName(int t, int k) =>
    t == 0 or t == 6 ? (k == 0 ? "1時間足" : k == 1 ? "4時間足" : "日足") : t == 1 ? (k == 0 ? "1分足" : "5分足") : t == 5 ? (k == 0 ? "4時間足" : "日足") :
     (k == 0 ? "1時間足" : k == 1 ? "4時間足" : k == 2 ? "日足" : "週足")

f_tfRank(LbZone z) =>
    z.typ == 1 ? (z.tf == 0 ? 5 : 4) : z.typ == 0 or z.typ == 6 ? (z.tf == 0 ? 3 : z.tf == 1 ? 2 : 1) : z.typ == 5 ? (z.tf == 0 ? 2 : 1) :
     (z.tf == 0 ? 3 : z.tf == 1 ? 2 : z.tf == 2 ? 1 : 0)

f_tfNameR(int r) =>
    r == 0 ? "週足" : r == 1 ? "日足" : r == 2 ? "4時間足" : r == 3 ? "1時間足" : r == 4 ? "5分足" : "1分足"

// Zone の名称 (時間足を除く)
f_zItem(LbZone z) =>
    z.typ == 0 ? (z.sub == 1 ? "アキュム上辺" : "アキュム下辺") : z.typ == 1 ? "MA EMA" + str.tostring(z.tf == 0 ? zbLen1 : zbLen2) :
     z.typ == 2 ? "水平線" : z.typ == 3 ? "出来高POC" : z.typ == 5 ? "フィボ " + str.tostring(z.infoA) :
     z.typ == 6 ? (z.infoA == 3 ? "トリプル" : "ダブル") + (z.sub == 1 ? "トップ" : "ボトム") : z.inv ? "iFVG" : "FVG"

f_catName(int c) =>
    c == 1 ? "反発" : c == 2 ? "ダマシ" : "サポレジ"

f_zaUse(int k) =>
    k == 0 ? zaUse1 : k == 1 ? zaUse2 : zaUse3

f_zbUse(int k) =>
    k == 0 ? zbUse1 : zbUse2

f_zcUse(int k) =>
    k == 0 ? zcUse1 : k == 1 ? zcUse2 : k == 2 ? zcUse3 : zcUse4

f_zdUse(int k) =>
    k == 0 ? zdUse1 : k == 1 ? zdUse2 : k == 2 ? zdUse3 : zdUse4

f_zfUse(int k) =>
    k == 0 ? zfUse1 : k == 1 ? zfUse2 : k == 2 ? zfUse3 : zfUse4

f_condTyp(int t) =>
    t == 0 ? cZA : t == 1 ? cZB : t == 2 ? cZC : t == 3 ? cZD : t == 4 ? cZF : t == 5 ? cZE : cZG and (zgUse1 or zgUse4 or zgUseD)

// ZG: 時間足 0 = 1H / 1 = 4H / 2 = D の設定
f_zgUse(int k) =>
    k == 0 ? zgUse1 : k == 1 ? zgUse4 : zgUseD

f_zgShow(int k) =>
    k == 0 ? zgShow1 : k == 1 ? zgShow4 : zgShowD

f_zgExpOn(int k) =>
    k == 0 ? zgExp1 : k == 1 ? zgExp4 : zgExpD

f_zgExpN(int k) =>
    k == 0 ? zgExpN1 : k == 1 ? zgExpN4 : zgExpND

// ZG: 受信した検知器の出力 (「B,対象足 time,time_close,前の time,基準数,bar_index」+ イベント) から、まだ取り込んでいない確定済みの対象足だけを読む
//  (LongTermDoubleTripleTopBottomXAU の受信と同じ: 対象足の time が前回より新しく、その time_close がこの足の確定までのもの)。
//  戻り値 [取り込んだ最後の time, 記録]: 記録は 6 個ずつ [0 = 対象足 / 1 = 検知, 対象足の bar_index, 基準 ID, 方向 (-1 トップ / 1 ボトム), 回数, 基準価格]
f_zgParse(string pk, int lastT, int tcNow) =>
    array<float> out = array.new_float()
    int lt = lastT
    if not na(pk) and pk != ""
        array<string> evs = str.split(pk, ";")
        bool take = false
        float cbi = na
        for i = 0 to array.size(evs) - 1
            string e = array.get(evs, i)
            if e != ""
                array<string> f = str.split(e, ",")
                string ty = array.get(f, 0)
                if ty == "B"
                    int sT = int(str.tonumber(array.get(f, 1)))
                    int sC = int(str.tonumber(array.get(f, 2)))
                    take := not na(sT) and (na(lt) or sT > lt) and not na(sC) and sC <= tcNow
                    if take
                        lt  := sT
                        cbi := str.tonumber(array.get(f, 5))
                        array.push(out, 0)
                        array.push(out, cbi)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                        array.push(out, na)
                else if take and ty == "D" and array.size(f) > 16
                    array.push(out, 1)
                    array.push(out, cbi)
                    array.push(out, str.tonumber(array.get(f, 1)))
                    array.push(out, str.tonumber(array.get(f, 2)))
                    array.push(out, str.tonumber(array.get(f, 7)))
                    array.push(out, str.tonumber(array.get(f, 16)))
    [lt, out]

// ZE: 時間足 0 = 4時間足 / 1 = 日足 の採用
f_zeUse(int k) =>
    zeUse and (k == 0 ? zeUse4 : zeUseD)

// 区分別集計の位置: 含む / だけ (ZA〜ZF は 1〜5 / 6〜10、ZE は追加の 18 / 19)
f_bkInc(int t) =>
    t < 5 ? 1 + t : t == 5 ? 18 : 20

f_bkOnly(int t) =>
    t < 5 ? 6 + t : t == 5 ? 19 : 21

// Zone が時間足の順位 r に当たるか (水平線 Zone は構成水平線のどれかの時間足)
f_zAtRank(LbZone z, int r) =>
    bool hit = f_tfRank(z) == r
    if z.typ == 2 and not na(z.mTf)
        hit := false
        for j = 0 to array.size(z.mTf) - 1
            int tk = array.get(z.mTf, j)
            if (tk == 0 ? 3 : tk == 1 ? 2 : tk == 2 ? 1 : 0) == r
                hit := true
    hit

f_zName(LbZone z) =>
    string tn = f_tfName(z.typ, z.tf)
    if z.typ == 2 and not na(z.mTf)
        tn := ""
        for r = 0 to 3
            if f_zAtRank(z, r)
                tn := tn + (tn == "" ? "" : "・") + f_tfNameR(r)
    tn + " " + f_zItem(z)

// 開始時刻を含み、終了時刻を含まない (開始 == 終了 は終日)。AccumStrategyXAU と同じ
f_inSession(int t) =>
    int mins = hour(t, seTz) * 60 + minute(t, seTz)
    int s    = seStartH * 60 + seStartM
    int e    = seEndH * 60 + seEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)

// 数量 (AccumStrategyXAU f_qty = ZoneStrategyXAU f_stQty と同じ式)
f_qty(int side, float ref, float sl) =>
    float budget = mmCapBase * mmRiskPct / 100.0
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = budget > 0 ? strategy.convert_to_symbol(budget) : na
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and mmLotOz > 0 and mmLotStep > 0 and mmLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * mmLotOz * mmLotStep) + 1e-9)
        if n * mmLotStep * mmLotOz * dist > budSym
            n := n - 1
        if n >= 1 and n * mmLotStep >= mmLotMin * (1 - 1e-9)
            q := n * mmLotStep * mmLotOz / pv
    q

// TC: ZoneStrategyXAU の f_satHist と同じ (【変更】close[1] → labC1 = 前の 5分足の確定終値。ロジック区間は履歴参照しないため)
f_satHist(int side, float L, int q) =>
    bool ok    = not na(L) and not na(labC1)
    bool hit   = ok and low <= L and L <= high
    bool near  = ok and stSatsNear and (side == 1 ? (low > L and low - L <= stSatsNearD) : (high < L and L - high <= stSatsNearD))
    bool fresh = ok and (side == 1 ? labC1 > L : labC1 < L)
    bool live  = not na(q) and bar_index - q <= stSatsNowC
    bool tch   = (hit or near) and fresh
    bool rA    = tch and (side == 1 ? close > L : close < L)
    bool rB    = live and ok and (side == 1 ? (labC1 <= L and close > L) : (labC1 >= L and close < L))
    bool body  = not stSatsBody or (side == 1 ? close > open : close < open)
    bool reb   = (rA or rB) and body
    int  qUse  = live ? q : bar_index
    int  qNext = reb ? na : live ? q : tch ? bar_index : na
    [reb, qUse, qNext]

// ---- 静的 Zone の索引 (下限の昇順。共通幅の Zone と FVG を分け、区間検索の範囲をそれぞれの最大幅で決める) ----
// 下限が x 以上の最初の位置
f_lbLower(array<LbZone> a, float x) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = math.floor((lo + hi) / 2)
        LbZone zm = array.get(a, mid)
        if zm.bot < x
            lo := mid + 1
        else
            hi := mid
    lo

// 上限が x 以上の最初の位置 (lbFvgsT)
f_lbLowerT(array<LbZone> a, float x) =>
    int lo = 0
    int hi = array.size(a)
    while lo < hi
        int mid = math.floor((lo + hi) / 2)
        LbZone zm = array.get(a, mid)
        if zm.top < x
            lo := mid + 1
        else
            hi := mid
    lo

// ---- 帯の表示 (LAB-2 と同じく Zone を登録・変更した足で描く。売買には使わない) ----
// 統合帯の名称: 時間足ごとに 1 行・上位の時間足から・行の中はアキュム / MA / 水平線 / 出来高POC / FVG の順・同じ時間足×根拠は 1 回
//  (名称の種類は有限なので数百文字まで)
f_dsName(array<LbZone> mem) =>
    string tx = ""
    int n = array.size(mem)
    for r = 0 to 5
        array<string> items = array.new_string()
        if n > 0
            for t = 0 to 6
                for i = 0 to n - 1
                    LbZone z = array.get(mem, i)
                    if z.typ == t and f_zAtRank(z, r)
                        string it = f_zItem(z)
                        if not array.includes(items, it)
                            array.push(items, it)
        if array.size(items) > 0
            tx := tx + (tx == "" ? "" : "\n") + f_tfNameR(r) + "｜" + array.join(items, "＋")
    tx

// 帯を描く: 左端 = 構成 Zone (MA を除く。MA は毎足動くため) の最も早い登録足、色 = 種類が 1 つならその色・混在は fuchsia
f_dsBox(LbDsG g) =>
    LbZone z0 = array.get(g.mem, 0)
    int  lft  = bar_index
    bool mix  = false
    for i = 0 to array.size(g.mem) - 1
        LbZone z = array.get(g.mem, i)
        if z.typ != 1
            lft := math.min(lft, z.aBar)
        if z.typ != z0.typ
            mix := true
    color c = mix ? color.fuchsia : z0.typ == 0 ? color.teal : z0.typ == 1 ? color.blue : z0.typ == 2 ? color.orange : z0.typ == 3 ? color.purple :
         z0.typ == 5 ? color.maroon : z0.typ == 6 ? color.olive : color.green
    g.bx := box.new(math.max(lft, bar_index - 4999), g.top, bar_index + 1, g.bot, border_color = color.new(c, 40), bgcolor = color.new(c, 88),
         extend = extend.right)
    g.lb := label.new(bar_index + 3, (g.bot + g.top) / 2.0, f_dsName(g.mem), style = label.style_label_left, color = color.new(c, 75),
         textcolor = color.new(c, 0), size = size.tiny, textalign = text.align_left)
    true

// 帯と名称を消す
f_dsErase(LbDsG g) =>
    box.delete(g.bx)
    label.delete(g.lb)
    true

// 名称を最新足の 3 本先へ (最後の確定履歴足と、その後のリアルタイムの確定足で呼ぶ)
f_dsLblX() =>
    int ng = array.size(lbDsG)
    if ng > 0
        for i = 0 to ng - 1
            LbDsG g = array.get(lbDsG, i)
            if not g.gone
                label.set_x(g.lb, bar_index + 3)
    true

f_dsCap() =>
    while array.size(lbDsG) > dsZoneMax
        LbDsG og = array.shift(lbDsG)
        f_dsErase(og)
    true

// 統合の対象: アキュム・MA・水平線・出来高POC。FVG / iFVG は本来の上下限で個別に表示し、統合にも他の帯のつなぎにも使わない
f_dsMerge(LbZone z) =>
    z.typ != 4

// Zone を表示に置く: 統合の対象なら、実際に重なる帯 (EPS 込み・統合の対象の帯だけ) をすべて (連鎖を含む) 1 つにまとめて描き直す。
//  needHit = 重なる帯がなければ置かない (MA: 単独では帯を作らず線だけ)。戻り値 = 置いたか
f_dsPut(LbZone z, bool needHit) =>
    array<LbZone> mem = array.new<LbZone>()
    array.push(mem, z)
    LbDsG ng = LbDsG.new(na, na, z.bot, z.top, false, mem)
    bool any  = false
    bool more = f_dsMerge(z)
    while more
        more := false
        int i = 0
        while i < array.size(lbDsG)
            LbDsG g = array.get(lbDsG, i)
            bool hit = false
            if not g.gone
                LbZone g0 = array.get(g.mem, 0)
                if f_dsMerge(g0)
                    hit := g.bot <= ng.top + EPS and ng.bot <= g.top + EPS
            if hit
                ng.bot := math.min(ng.bot, g.bot)
                ng.top := math.max(ng.top, g.top)
                for j = 0 to array.size(g.mem) - 1
                    array.push(ng.mem, array.get(g.mem, j))
                f_dsErase(g)
                array.remove(lbDsG, i)
                more := true
                any  := true
            else
                i += 1
    bool put = any or not needHit
    if put
        f_dsBox(ng)
        array.push(lbDsG, ng)
        f_dsCap()
    put

// 新しい Zone (FVG は個別の帯)
f_dsAdd(LbZone z) =>
    f_dsPut(z, false)

// Zone を含む表示中の帯の位置 (なければ -1)
f_dsFind(LbZone z) =>
    int gi = -1
    int ng = array.size(lbDsG)
    if ng > 0
        for i = 0 to ng - 1
            LbDsG g = array.get(lbDsG, i)
            if gi < 0 and not g.gone
                for j = 0 to array.size(g.mem) - 1
                    LbZone q = array.get(g.mem, j)
                    if q.id == z.id
                        gi := i
    gi

// iFVG に変わった Zone の帯の名称を更新
f_dsRename(LbZone z) =>
    int gi = f_dsFind(z)
    if gi >= 0
        LbDsG g = array.get(lbDsG, gi)
        label.set_text(g.lb, f_dsName(g.mem))
    gi >= 0

// Zone を帯から外す (無効化した FVG / 採用件数から外れたアキュムの辺): 残りを下限の順に並べ、実際に重なる連鎖ごとに帯を描き直す。
//  grey = 無効化した FVG を灰色の終わった帯として残す (LAB-2 と同じ見た目)
f_dsDel(LbZone z, bool grey) =>
    int gi = f_dsFind(z)
    if gi >= 0
        LbDsG g = array.get(lbDsG, gi)
        f_dsErase(g)
        array.remove(lbDsG, gi)
        array<LbZone> rest = array.new<LbZone>()
        for j = 0 to array.size(g.mem) - 1
            LbZone q = array.get(g.mem, j)
            if q.id != z.id
                int  kk = array.size(rest)
                bool go = kk > 0
                while go
                    LbZone pq = array.get(rest, kk - 1)
                    if pq.bot > q.bot
                        kk -= 1
                        go := kk > 0
                    else
                        go := false
                array.insert(rest, kk, q)
        int at = gi
        int n  = array.size(rest)
        int k  = 0
        while k < n
            LbZone q0 = array.get(rest, k)
            array<LbZone> sm = array.new<LbZone>()
            array.push(sm, q0)
            float sb = q0.bot
            float stp = q0.top
            bool  hasS = q0.typ != 1
            k += 1
            bool go = k < n
            while go
                LbZone q = array.get(rest, k)
                if q.bot <= stp + EPS
                    array.push(sm, q)
                    stp := math.max(stp, q.top)
                    hasS := hasS or q.typ != 1
                    k += 1
                    go := k < n
                else
                    go := false
            // MA だけになった部分は帯を作らない (MA は線で表示し、確定足ごとの f_dsMa でまとめ直す)
            if hasS
                LbDsG sg = LbDsG.new(na, na, sb, stp, false, sm)
                f_dsBox(sg)
                array.insert(lbDsG, at, sg)
                at += 1
        if grey
            LbDsG dg = LbDsG.new(na, na, z.bot, z.top, true, array.new<LbZone>())
            dg.bx := box.new(math.max(z.aBar, bar_index - 4999), z.top, bar_index, z.bot, border_color = color.new(color.green, 40),
                 bgcolor = color.new(color.gray, 92), extend = extend.none, text = f_tfName(z.typ, z.tf) + "｜" + f_zItem(z), text_size = size.tiny, text_color = color.new(color.green, 20))
            array.push(lbDsG, dg)
            f_dsCap()
    gi >= 0

// MA の帯は毎足動く: 確定足ごとに (その足の Zone の登録の後で) MA を帯から外し、アキュム・水平線・出来高POC の帯と重なるときだけ
//  まとめ直す (名称に MA の時間足・EMA 本数を併記)。重ならない MA は帯を作らず線だけ。2 本の MA が重なってつながる場合のため、
//  置けなかった 1 本目は 2 本目の後にもう一度試す
f_dsMa() =>
    if not na(lbMa1)
        f_dsDel(lbMa1, false)
    if not na(lbMa2)
        f_dsDel(lbMa2, false)
    bool p1 = false
    bool p2 = false
    if not na(lbMa1)
        p1 := f_dsPut(lbMa1, true)
    if not na(lbMa2)
        p2 := f_dsPut(lbMa2, true)
    if not na(lbMa1) and not p1 and p2
        f_dsPut(lbMa1, true)
    true

f_lbAdd(LbZone z) =>
    array<LbZone> arr = z.typ == 4 ? lbFvgs : lbZs
    int i = f_lbLower(arr, z.bot)
    array.insert(arr, i, z)
    if z.typ == 4
        array.insert(lbFvgsT, f_lbLowerT(lbFvgsT, z.top), z)
        st.maxWF := math.max(st.maxWF, z.top - z.bot)
    else
        array.insert(lbZsT, f_lbLowerT(lbZsT, z.top), z)
        st.maxW := math.max(st.maxW, z.top - z.bot)
    array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) + 1)
    if dsZone and z.zgShow
        f_dsAdd(z)
    true

// ZF の削除 (無効化)。共通幅の Zone は削除しない
f_lbRemove(LbZone z) =>
    int i = f_lbLower(lbFvgs, z.bot)
    int n = array.size(lbFvgs)
    bool done = false
    while i < n and not done
        LbZone q = array.get(lbFvgs, i)
        if q.id == z.id
            array.remove(lbFvgs, i)
            done := true
        else if q.bot > z.bot
            done := true
        i += 1
    int j = f_lbLowerT(lbFvgsT, z.top)
    int nT = array.size(lbFvgsT)
    bool doneT = false
    while j < nT and not doneT
        LbZone q = array.get(lbFvgsT, j)
        if q.id == z.id
            array.remove(lbFvgsT, j)
            doneT := true
        else if q.top > z.top
            doneT := true
        j += 1
    if done
        array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) - 1)
    done and doneT

// 共通幅の Zone を lbZs / lbZsT から外す (採用件数から外れたアキュムの辺 / 統合で帯が変わる・統合される水平線 Zone / 更新された旧 POC)
f_lbRemoveS(LbZone z) =>
    int i = f_lbLower(lbZs, z.bot)
    int n = array.size(lbZs)
    bool done = false
    while i < n and not done
        LbZone q = array.get(lbZs, i)
        if q.id == z.id
            array.remove(lbZs, i)
            done := true
        else if q.bot > z.bot
            done := true
        i += 1
    int j = f_lbLowerT(lbZsT, z.top)
    int nT = array.size(lbZsT)
    bool doneT = false
    while j < nT and not doneT
        LbZone q = array.get(lbZsT, j)
        if q.id == z.id
            array.remove(lbZsT, j)
            doneT := true
        else if q.top > z.top
            doneT := true
        j += 1
    if done
        array.set(lbNZone, z.typ, array.get(lbNZone, z.typ) - 1)
    done

f_lbNew(int typ, int tf, int sub, float ctr, float bot, float top, float a, float b, int key) =>
    st.zSeq += 1
    LbZone z = LbZone.new(st.zSeq, typ, tf, sub, ctr, bot, top, a, b, key, bar_index, time)
    z.pos := close > top + EPS ? 1 : close < bot - EPS ? -1 : 0
    z

// ZG: Zone を消す (逆行・期限)。利用中なら Zone の一覧・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除。表示から外す。
//  同じ帯の他の根拠 (アキュム・水平線など) は消さない。消した根拠は lbZgUsed に残すので復活しない
f_zgKill(int i) =>
    LbZone z = array.remove(lbZgZ, i)
    if z.zgUse
        f_lbRemoveS(z)
        array.push(lbDeadNow, z.id)
    if dsZone and z.zgShow
        f_dsDel(z, false)
    z.dead := true
    true

// 静的 Zone で [a, b] と重なるものの中に、種類・時間足・副種別・中心が条件に合うものがあるか
f_lbDup(int typ, int tf, int sub, float price) =>
    bool r = false
    float a = price - zHalf
    float b = price + zHalf
    int n = array.size(lbZs)
    int i = f_lbLower(lbZs, a - st.maxW - EPS)
    while i < n and not r
        LbZone z = array.get(lbZs, i)
        if z.bot > b + EPS
            break
        if z.typ == typ and z.tf == tf and z.sub == sub and z.ctr == price
            r := true
        i += 1
    r

// ZE: その時間足のフィボ Zone をすべて外す (Zone の一覧・表示・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除)
f_zeClear(int k) =>
    int n = array.size(lbZeZ)
    if n > 0
        for i = n - 1 to 0
            LbZone z = array.get(lbZeZ, i)
            if z.tf == k
                array.remove(lbZeZ, i)
                f_lbRemoveS(z)
                if dsZone
                    f_dsDel(z, false)
                z.dead := true
                array.push(lbDeadNow, z.id)
    true

// ZE: 最新の波の 4 水準を登録 (価格 = 終点 + 比率 × (起点 − 終点)、帯 = 価格 ± 共通幅。接触は登録の次の足から)
f_zeSet(int k, float o, float e, float d, float id, float t) =>
    array<float> rs = array.from(0.236, 0.382, 0.5, 0.618)
    for j = 0 to 3
        float r = array.get(rs, j)
        float p = e + r * (o - e)
        LbZone z = f_lbNew(5, k, int(d), p, p - zHalf, p + zHalf, r, t, int(id))
        f_lbAdd(z)
        array.push(lbZeZ, z)
    int b = k * 5
    array.set(lbZeLast, b, o)
    array.set(lbZeLast, b + 1, e)
    array.set(lbZeLast, b + 2, d)
    array.set(lbZeLast, b + 3, id)
    array.set(lbZeLast, b + 4, 1)
    true

// ZE: 受信した波が採用中の波と同じか (起点・終点・方向・波 ID がすべて同じで、採用中)
f_zeSame(int k, float o, float e, float d, float id) =>
    int b = k * 5
    array.get(lbZeLast, b + 4) == 1 and array.get(lbZeLast, b) == o and array.get(lbZeLast, b + 1) == e and array.get(lbZeLast, b + 2) == d
         and array.get(lbZeLast, b + 3) == id

// Accum を固定 → 上辺・下辺の Zone を登録
f_zaKeep(int k) =>
    k == 0 ? zaKeep1 : k == 1 ? zaKeep2 : zaKeep3

// Accum を固定 → 上辺・下辺の Zone を登録し、その時間足で最新 N 箱を超えた古い箱 (上辺・下辺のセット) を外す
//  (外した辺: Zone の一覧・表示・TP 候補から除き、lbDeadNow へ入れて (B3) で待機を解除する。既存ポジションの SL は変えない)
f_lbAccFix(LbAcc q) =>
    LbZone zu = f_lbNew(0, q.tf, 1, q.up, q.up - zHalf, q.up + zHalf, q.lo, q.up, q.aid)
    LbZone zl = f_lbNew(0, q.tf, -1, q.lo, q.lo - zHalf, q.lo + zHalf, q.lo, q.up, q.aid)
    f_lbAdd(zu)
    f_lbAdd(zl)
    array.push(lbAccZ, zu)
    array.push(lbAccZ, zl)
    int nk = 0
    for i = 0 to array.size(lbAccZ) - 1
        LbZone qz = array.get(lbAccZ, i)
        if qz.tf == q.tf
            nk += 1
    while nk > 2 * f_zaKeep(q.tf)
        int oi = 0
        bool fnd = false
        while not fnd
            LbZone qz = array.get(lbAccZ, oi)
            if qz.tf == q.tf
                fnd := true
            else
                oi += 1
        LbZone zo = array.remove(lbAccZ, oi)
        f_lbRemoveS(zo)
        if dsZone
            f_dsDel(zo, false)
        zo.dead := true
        array.push(lbDeadNow, zo.id)
        st.nAccOut += 1
        nk -= 1
    true

// 確定足 1 本の Zone の状態更新。戻り値 [接触の方向 (0 なし), 区分, 待機を解除する方向 (0 なし)]
//  zb / zt: 判定に使う帯 (Zone の帯。水平線 Zone は統合後の帯)
f_lbStep(LbZone z, float zb, float zt) =>
    bool tch = low <= zt + EPS and high >= zb - EPS
    int  np  = close > zt + EPS ? 1 : close < zb - EPS ? -1 : 0
    int  cs  = 0
    int  cc  = 0
    int  xs  = 0
    if np != 0 and z.pos != 0 and np != z.pos
        // 終値で帯を抜けた: 反対側の待機を解除 (上抜け → SHORT / 下抜け → LONG)。期限内に直前の突破と逆へ抜けて戻った = ダマシ
        xs := -np
        if z.brk == -np and (fakeWin == 0 or bar_index - z.brkBar <= fakeWin)
            cs    := np
            cc    := 2
            z.brk := 0
        else
            z.brk    := np
            z.brkBar := bar_index
        z.pos := np
    else
        if np != 0 and z.pos == 0
            z.pos := np
        if tch and z.pos != 0
            cs := z.pos == -1 ? -1 : 1
            cc := (cs == -1 and z.brk == -1) or (cs == 1 and z.brk == 1) ? 3 : 1
    [cs, cc, xs]

f_waitHas(LbWait w, int zid) =>
    bool r = false
    int n = array.size(w.ids)
    if n > 0
        for i = 0 to n - 1
            if array.get(w.ids, i) == zid
                r := true
    r

f_wKey(int side, string key) =>
    str.tostring(side) + "#" + key

// 待機を 1 つ外す (配列と map を同期)
f_waitDel(int i) =>
    LbWait w = array.remove(lbWaits, i)
    map.remove(lbWaitMap, f_wKey(w.side, w.key))
    true

// 待機の位置 (ID で探す)
f_waitIdx(int wid) =>
    int r = -1
    int n = array.size(lbWaits)
    if n > 0
        for i = 0 to n - 1
            LbWait w = array.get(lbWaits, i)
            if w.id == wid
                r := i
    r

// 待機の Zone ID を付け替える (統合された水平線 Zone → 統合先)。同じ組・同じ方向の待機が既にあれば、最後の接触が新しい方を残す
//  (最後の接触足・接触時の帯のスナップショット・期限はそのまま)
f_waitMove(int fromId, int toId) =>
    int n = array.size(lbWaits)
    if n > 0
        for i = n - 1 to 0
            if i < array.size(lbWaits)
                LbWait w = array.get(lbWaits, i)
                if f_waitHas(w, fromId)
                    array<int> nid = array.new_int()
                    for j = 0 to array.size(w.ids) - 1
                        int v = array.get(w.ids, j)
                        int v2 = v == fromId ? toId : v
                        if not array.includes(nid, v2)
                            int p = 0
                            int ni = array.size(nid)
                            while p < ni
                                if array.get(nid, p) > v2
                                    break
                                p += 1
                            array.insert(nid, p, v2)
                    string nk = ""
                    for p = 0 to array.size(nid) - 1
                        nk := nk + (p > 0 ? "|" : "") + str.tostring(array.get(nid, p))
                    map.remove(lbWaitMap, f_wKey(w.side, w.key))
                    LbWait o2 = map.get(lbWaitMap, f_wKey(w.side, nk))
                    bool keepW = true
                    if not na(o2)
                        if w.lBar > o2.lBar
                            array.remove(lbWaits, f_waitIdx(o2.id))
                            map.remove(lbWaitMap, f_wKey(o2.side, o2.key))
                        else
                            keepW := false
                    if keepW
                        w.ids := nid
                        w.key := nk
                        map.put(lbWaitMap, f_wKey(w.side, nk), w)
                    else
                        array.remove(lbWaits, f_waitIdx(w.id))
    true

// 水平線を 1 本登録する。元の水平線同士の価格差が統合距離以内で連鎖する既存の水平線 Zone (= 構成水平線の最安値 − 距離 〜 最高値 + 距離
// に入る Zone) があれば、最も古い Zone にまとめる (2 つ以上をつなぐ場合は他の Zone もその Zone へ統合し、待機の ID を付け替える)。
// 帯 = 構成水平線の最安値 − 共通幅 〜 最高値 + 共通幅。統合した Zone の ID・状態 (位置・突破)・登録足は変えない。統合したその足から
// 統合後の帯 1 つで通常の Zone と同じ接触・突破を判定する (統合しただけでは接触にしない: その足の高値・安値と帯の位置関係で判定)
f_swAdd(int k, int sub, float pv, int pt) =>
    st.swSeq += 1
    int pid = st.swSeq
    array<LbZone> hit = array.new<LbZone>()
    int n = array.size(lbSw)
    if n > 0
        for i = 0 to n - 1
            LbZone q = array.get(lbSw, i)
            if pv >= array.min(q.mP) - zcMerge - EPS and pv <= array.max(q.mP) + zcMerge + EPS
                array.push(hit, q)
    if array.size(hit) == 0
        LbZone z = f_lbNew(2, k, sub, pv, pv - zHalf, pv + zHalf, na, na, pt)
        z.mP  := array.from(pv)
        z.mTf := array.from(k)
        z.mT  := array.from(pt)
        z.mId := array.from(pid)
        f_lbAdd(z)
        array.push(lbSw, z)
    else
        LbZone a = array.get(hit, 0)
        if dsZone
            f_dsDel(a, false)
        f_lbRemoveS(a)
        array.push(a.mP, pv)
        array.push(a.mTf, k)
        array.push(a.mT, pt)
        array.push(a.mId, pid)
        int nh = array.size(hit)
        if nh > 1
            for h = 1 to nh - 1
                LbZone b = array.get(hit, h)
                if dsZone
                    f_dsDel(b, false)
                f_lbRemoveS(b)
                b.dead := true
                int  ib = 0
                bool fb = false
                while not fb
                    LbZone qb = array.get(lbSw, ib)
                    if qb.id == b.id
                        fb := true
                    else
                        ib += 1
                array.remove(lbSw, ib)
                for j = 0 to array.size(b.mP) - 1
                    array.push(a.mP, array.get(b.mP, j))
                    array.push(a.mTf, array.get(b.mTf, j))
                    array.push(a.mT, array.get(b.mT, j))
                    array.push(a.mId, array.get(b.mId, j))
                f_waitMove(b.id, a.id)
        float pMin = array.min(a.mP)
        float pMax = array.max(a.mP)
        a.ctr := (pMin + pMax) / 2.0
        a.bot := pMin - zHalf
        a.top := pMax + zHalf
        f_lbAdd(a)
        st.nSwMerge += 1
    true

// 待機の作成 / 更新 (同じ組・同じ方向があれば最後の接触足と帯のスナップショットを更新)。検索は map
f_lbUnit(int side, int cat, bool cr, bool cf, bool co, array<int> ids, string key, int tmask, float cb, float ct, float eb, float et, string desc) =>
    string mk = f_wKey(side, key)
    LbWait w = map.get(lbWaitMap, mk)
    bool found = not na(w)
    if found
        w.lBar := bar_index
        w.cBot := cb
        w.cTop := ct
        w.eBot := eb
        w.eTop := et
    else
        st.wSeq += 1
        st.nWaitNew += 1
        LbWait nw = LbWait.new(st.wSeq, key, side, cat, cr, cf, co, tmask, ids, cb, ct, eb, et, bar_index, bar_index, desc)
        array.push(lbWaits, nw)
        map.put(lbWaitMap, mk, nw)
    not found

// 他種類 (tmask に含まれない種類) の有効 Zone で [a, b] と重なるものの種類マスク
f_lbOthers(float a, float b, int tmask) =>
    int m = 0
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, a - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > b + EPS
                break
            if z.top >= a - EPS and not f_bit(tmask, z.typ) and not f_bit(m, z.typ)
                m += f_pow2(z.typ)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k) and not f_bit(tmask, 1) and not f_bit(m, 1)
            if mz.bot <= b + EPS and mz.top >= a - EPS
                m += 2
    m

// ---- TP: 利益方向の抵抗 Zone を重なりで統合した帯の近い順 ----
// 区間 1 つを統合中の帯 cur = [近端, 遠端] へ渡す: 重なれば (EPS 込み) 遠端を広げ、重ならなければそれまでの帯を確定して新しい帯を始める。
// 戻り値 = 確定した帯が 3 つになった
f_lbFeed(array<float> tps, array<float> cur, int side, float b, float t) =>
    float cn = array.get(cur, 0)
    float cf = array.get(cur, 1)
    if na(cn)
        array.set(cur, 0, side == 1 ? b : t)
        array.set(cur, 1, side == 1 ? t : b)
    else if side == 1 ? b <= cf + EPS : t >= cf - EPS
        array.set(cur, 1, side == 1 ? math.max(cf, t) : math.min(cf, b))
    else
        array.push(tps, cn)
        array.set(cur, 0, side == 1 ? b : t)
        array.set(cur, 1, side == 1 ? t : b)
    array.size(tps) >= 3

// TP 候補 (最大 3)。LONG = ref より厳密に上の Zone を下限の昇順 / SHORT = ref より厳密に下の Zone を上限の降順に、共通幅の
// Zone (LONG は lbZs、SHORT は lbZsT: 水平線の統合で帯の幅が変わるため)・FVG (LONG は lbFvgs、SHORT は lbFvgsT)・MA 2 本の 3 つの流れを合わせて 1 件ずつ読み、
// 重なりで統合しながら 3 つ目の帯が確定した時点で終える。全種類 (条件に選ばない種類も) を使う
f_lbTargets(int side, float ref) =>
    array<float> tps = array.new_float()
    array<float> cur = array.new_float(2, na)
    array<float> mb  = array.new_float()
    array<float> mt  = array.new_float()
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if (side == 1 and mz.bot > ref + EPS) or (side == -1 and mz.top < ref - EPS)
                bool front = false
                if array.size(mb) == 1
                    front := side == 1 ? mz.bot < array.get(mb, 0) : mz.top > array.get(mt, 0)
                if front
                    array.insert(mb, 0, mz.bot)
                    array.insert(mt, 0, mz.top)
                else
                    array.push(mb, mz.bot)
                    array.push(mt, mz.top)
    array<LbZone> fArr = side == 1 ? lbFvgs : lbFvgsT
    int nA = array.size(lbZs)
    int nG = array.size(fArr)
    int nM = array.size(mb)
    array<LbZone> aArr = side == 1 ? lbZs : lbZsT
    int ia = side == 1 ? f_lbLower(lbZs, ref + EPS) : f_lbLowerT(lbZsT, ref - EPS) - 1
    int ig = side == 1 ? f_lbLower(lbFvgs, ref + EPS) : f_lbLowerT(lbFvgsT, ref - EPS) - 1
    int im = 0
    bool done = false
    bool go = true
    while go
        LbZone za = na
        LbZone zg = na
        if ia >= 0 and ia < nA
            za := array.get(aArr, ia)
        if ig >= 0 and ig < nG
            zg := array.get(fArr, ig)
        // 3 つの流れの先頭のうち、LONG は下限が最小・SHORT は上限が最大のもの (0 = 共通幅 / 1 = FVG / 2 = MA / -1 = なし)
        int   pk = -1
        float bk = na
        if not na(za)
            pk := 0
            bk := side == 1 ? za.bot : za.top
        if not na(zg)
            float kg = side == 1 ? zg.bot : zg.top
            if pk < 0
                pk := 1
                bk := kg
            else if side == 1 ? kg < bk : kg > bk
                pk := 1
                bk := kg
        if im < nM
            float km = side == 1 ? array.get(mb, im) : array.get(mt, im)
            if pk < 0
                pk := 2
                bk := km
            else if side == 1 ? km < bk : km > bk
                pk := 2
                bk := km
        if pk < 0
            go := false
        else
            float b = na
            float t = na
            bool  use = true
            if pk == 0
                b := za.bot
                t := za.top
                ia += side == 1 ? 1 : -1
            else if pk == 1
                b := zg.bot
                t := zg.top
                use := not zg.dead
                ig += side == 1 ? 1 : -1
            else
                b := array.get(mb, im)
                t := array.get(mt, im)
                im += 1
            use := use and (side == 1 ? b > ref + EPS : t < ref - EPS)
            if use
                if f_lbFeed(tps, cur, side, b, t)
                    done := true
                    go := false
    if not done and not na(array.get(cur, 0))
        array.push(tps, array.get(cur, 0))
    tps

f_legId(int n, int k) =>
    "X" + str.tostring(n) + "_" + str.tostring(k)

// 利確の段の計画 (o.legPx / o.legLots を作り直す。完了した段は変えない)。ref: 目標を探す基準価格、base: 固定 RR の基準
f_lbPlan(float ref, float base) =>
    array<float> tps = tpMode == "固定 RR" ? array.new_float() : f_lbTargets(o.side, ref)
    int nT = array.size(tps)
    for k = 0 to 2
        array.set(o.legPx, k, na)
        array.set(o.legLots, k, 0)
    int rem = o.lotN - o.closedLots
    int s0  = o.stage
    if rem > 0 and s0 < 3
        if tpMode == "分割利確" and nT > 0
            int   m    = math.min(nT, 3 - s0)
            int   prev = o.closedLots
            float cumW = 0.0
            for k = 1 to 3
                if k <= s0
                    cumW += k == 1 ? tpW1 : k == 2 ? tpW2 : tpW3
            for j = 0 to m - 1
                int stg = s0 + j + 1
                cumW += stg == 1 ? tpW1 : stg == 2 ? tpW2 : tpW3
                int cum = j == m - 1 ? o.lotN : math.min(o.lotN, math.floor(cumW / 100.0 * o.lotN + 0.5))     // 累積を四捨五入
                int q   = cum - prev
                if q > 0
                    array.set(o.legPx, stg - 1, array.get(tps, j))
                    array.set(o.legLots, stg - 1, q)
                    prev := cum
        else if tpMode == "選択した TP で全決済" and nT > 0
            array.set(o.legPx, s0, array.get(tps, math.min(tpSel, nT) - 1))
            array.set(o.legLots, s0, rem)
        else
            array.set(o.legPx, s0, base + o.side * fixRR * math.abs(base - o.sl))
            array.set(o.legLots, s0, rem)
    nT

// 計画した段の注文を出す (同じ ID = 変更)。計画にない段は取り消す
f_lbIssue() =>
    for k = 1 to 3
        string xid = f_legId(o.n, k)
        int    q   = array.get(o.legLots, k - 1)
        if q > 0
            strategy.exit(xid, o.id, qty = q * o.lotQ, stop = o.stop, limit = array.get(o.legPx, k - 1))
        else
            strategy.cancel(xid)
    true

// 残っている段のうち最も遠い TP = 最終 TP (建値ロックの解除目標。ロック開始時に lkTP へ固定する)
f_lbFarTp() =>
    float r = na
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            r := array.get(o.legPx, k - 1)
    r

f_lbTpText() =>
    string s = ""
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            s := s + " TP" + str.tostring(k) + " " + str.tostring(array.get(o.legPx, k - 1), "#.##") +
                 " (" + str.tostring(array.get(o.legLots, k - 1) * mmLotStep, "#.##") + " lot)"
    s

// TP 変更の通知: 最後に通知した価格から、いずれかの段が通知幅以上動いたら全段を 1 通で通知
f_lbNotify(bool force) =>
    bool chg = force
    for k = 1 to 3
        if array.get(o.legLots, k - 1) > 0
            float lp = array.get(o.ntfPx, k - 1)
            if na(lp)
                chg := true
            else if math.abs(array.get(o.legPx, k - 1) - lp) >= tpNtf - EPS
                chg := true
    if chg
        for k = 1 to 3
            array.set(o.ntfPx, k - 1, array.get(o.legLots, k - 1) > 0 ? array.get(o.legPx, k - 1) : na)
        if not force
            st.nTpNtf += 1
            alert("ZCL TP 変更 " + o.id + ":" + f_lbTpText() + " / SL " + str.tostring(o.stop, "#.##"), alert.freq_once_per_bar_close)
    chg

// 決済 1 件 (分割を含む) の記帳
f_lbOnExit(int i) =>
    string xid = strategy.closedtrades.exit_id(i)
    float  px  = strategy.closedtrades.exit_price(i)
    float  pf  = strategy.closedtrades.profit(i)
    int    lots = int(math.round(math.abs(strategy.closedtrades.size(i)) / o.lotQ))
    o.pnl        += pf
    st.realized  += pf
    o.closedLots += lots
    bool isTp = false
    for k = 1 to 3
        if xid == f_legId(o.n, k)
            float lp = array.get(o.legPx, k - 1)
            if not na(lp) and o.side * (px - lp) >= -EPS
                isTp := true
                o.stage := math.max(o.stage, k)
    if isTp
        o.nTp    += 1
        st.nTpHit += 1
        alert("ZCL TP 到達 " + o.id + " " + xid + " " + str.tostring(px, "#.##") + " (" + str.tostring(lots * mmLotStep, "#.##") + " lot)", alert.freq_once_per_bar_close)
    else
        o.lastStop := true
    isTp

f_lbBk(int b, float pnl, float r) =>
    array.set(bkN, b, array.get(bkN, b) + 1)
    if pnl > stBeBand
        array.set(bkW, b, array.get(bkW, b) + 1)
    else if pnl < 0
        array.set(bkL, b, array.get(bkL, b) + 1)
    else
        array.set(bkBE, b, array.get(bkBE, b) + 1)
    if pnl > 0
        array.set(bkGP, b, array.get(bkGP, b) + pnl)
    if pnl < 0
        array.set(bkGL, b, array.get(bkGL, b) - pnl)
    array.set(bkR, b, array.get(bkR, b) + r)
    array.set(bkNet, b, array.get(bkNet, b) + pnl)
    true

// 1 取引の確定 (全決済の後)。台帳は取引 ID ごとに 1 回、区分別は属する区分すべてへ
f_lbFinalize() =>
    float rJpy = strategy.convert_to_account(math.abs(o.fill - o.sl) * o.lotN * o.lotQ * syminfo.pointvalue)
    float r    = rJpy > 0 ? o.pnl / rJpy : 0.0
    f_lbBk(0, o.pnl, r)
    for t = 0 to 6
        if f_bit(o.tmask, t)
            f_lbBk(f_bkInc(t), o.pnl, r)
            if o.tmask == f_pow2(t) and o.omask == 0
                f_lbBk(f_bkOnly(t), o.pnl, r)
    if f_bit(o.tim, 0)
        f_lbBk(11, o.pnl, r)
    if f_bit(o.tim, 1)
        f_lbBk(12, o.pnl, r)
    if f_bit(o.tim, 2)
        f_lbBk(22, o.pnl, r)
    if f_bit(o.tim, 3)
        f_lbBk(23, o.pnl, r)
    if o.cReb
        f_lbBk(13, o.pnl, r)
    if o.cFake
        f_lbBk(14, o.pnl, r)
    if o.cRole
        f_lbBk(15, o.pnl, r)
    f_lbBk(o.side == 1 ? 16 : 17, o.pnl, r)
    st.nTrades += 1
    if not na(o.lbl)
        label.set_text(o.lbl, label.get_text(o.lbl) + "\n決済 合計 " + str.tostring(o.pnl, "#") + " 円 (" + str.tostring(r, "#.##") + "R)")
    r

// タイミング: 方向・種類が合い、未使用・待機の開始以後・有効期限内の最新の位置 (-1 = なし)。
//  TE は反転の確定足 = この足だけ、検知した接近足も待機の開始以後 (待機ごとに判定。同じ足の適格な TE は消費時に 1 件へまとめる)。
//  TD はこの確定 5分足の中の 1分合図だけ (待機の到達足以後の 5分足。同じ 5分足の中の前後は問わない)
f_lbTim(int kind, int side, int sBar) =>
    int r  = -1
    int rb = -1
    bool filt = kind == 2 and tcFilt and (side == 1 ? (satTf4 == -1 and satTf1 == -1) : (satTf4 == 1 and satTf1 == 1))
    int n = array.size(lbTevs)
    if n > 0 and not filt
        for i = 0 to n - 1
            LbTev e = array.get(lbTevs, i)
            int life = kind == 1 ? fvAbsLife : kind == 2 ? tcLife : 0
            if e.kind == kind and e.side == side and not e.used and e.eBar >= sBar and (kind != 3 or e.aBar >= sBar) and
                 bar_index - e.eBar <= life and e.eBar > rb
                r  := i
                rb := e.eBar
    r

// ---- Zone タッチ通知 (LAB-5)。売買の接触・待機・消費の状態とは別に持ち、売買の判定は読まない・変えない ----
var array<int> lbNtfIds = array.new_int()     // 最後に通知した足で接触していた Zone の ID (この中の Zone だけに接触しても再通知しない)
var int        lbNtfN   = 0                   // 通知した回数 (確認用)

f_ntfHit(LbZone z) =>
    low <= z.top + EPS and high >= z.bot - EPS

// この足の高値・安値が届いた有効な Zone (共通幅の Zone・FVG / iFVG・MA 2 本。無効化・統合で外れた Zone は含まない)
f_ntfTouched() =>
    array<LbZone> t = array.new<LbZone>()
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int n = array.size(arr)
        int i = f_lbLower(arr, low - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while i < n
            LbZone z = array.get(arr, i)
            if z.bot > high + EPS
                break
            if not z.dead and f_ntfHit(z)
                array.push(t, z)
            i += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if f_ntfHit(mz)
                array.push(t, mz)
    t

// 通知 1 件分の行: 時間足・種類・価格帯
f_ntfLine(LbZone z) =>
    f_zName(z) + "  " + str.tostring(z.bot, "#.##") + "〜" + str.tostring(z.top, "#.##")

bool lbRun  = is5mChart
bool sessOK = not seUse or f_inSession(time_close)

if lbRun
    // ---- 再計算設定の保護 (ACC-2): ヒストリカルの足は確定時の 1 回だけ実行される前提
    if barstate.ishistory
        if lbExecBar == bar_index
            lbExecN += 1
        else
            lbExecBar := bar_index
            lbExecN   := 1
        if lbExecN > 1
            runtime.error("ZCL: ヒストリカルの同じ足でスクリプトが 2 回以上実行されました。プロパティの「再計算: 注文約定後」などを OFF にしてください。")

if lbRun and barstate.isconfirmed
    st.iter := 0
    // BEL-1: 前の確定足までに始まったロックは、この足の高値・安値が目標 / 初期 SL に届いたら解除 (解除した足はまだ禁止)
    bool lkBlk = lkOn
    if lkOn and bar_index > lkBar and (lkSide == 1 ? (high >= lkTP or low <= lkSL) : (low <= lkTP or high >= lkSL))
        lkOn := false

    // ---- (A) 約定・決済の確認 (分割決済の記帳 → 約定 → 全決済で取引を確定) ----------------------------
    int ct = strategy.closedtrades
    if ct > st.ctSeen
        for i = st.ctSeen to ct - 1
            if strategy.closedtrades.entry_id(i) == o.id
                f_lbOnExit(i)
        st.ctSeen := ct
    bool opn = false
    int  ot  = strategy.opentrades
    if ot > 0
        opn := strategy.opentrades.entry_id(ot - 1) == o.id
    if o.state == 1
        if opn
            o.fill  := strategy.opentrades.entry_price(ot - 1)
            o.state := 2
            if math.abs(math.abs(strategy.position_size) - o.lotN * o.lotQ) > o.lotN * o.lotQ * 1e-6
                st.nQtyAnom += 1
            if o.side * (o.fill - o.sl) <= 0
                // 約定ずれで初期 SL が約定価格の反対側: 出口注文を出さず成行で決済 (ACC と同じ)
                for k = 1 to 3
                    strategy.cancel(f_legId(o.n, k))
                strategy.close(o.id)
                o.state := 3
                st.nBadExit += 1
            else if o.tp1Fix
                // 約定を確認: 固定 RR の TP1 (建値の割合方式の基準) は実約定価格から計算し直す。TP の注文は (B5) で計画し直す
                o.tp1E := o.fill + o.side * fixRR * math.abs(o.fill - o.sl)
        else if o.closedLots > 0
            // 約定した足の中で全決済まで終わった
            o.fill  := strategy.closedtrades.entry_price(ct - 1)
            o.state := 2
        else if bar_index > o.bar
            strategy.cancel(o.id)
            for k = 1 to 3
                strategy.cancel(f_legId(o.n, k))
            o.state := 0
    if o.state >= 2 and not opn
        // 全決済: 建値ストップでの決済ならロック (BEL-1)
        if beLock and o.be and o.lastStop and o.state == 2 and not na(o.lastTp)
            lkOn   := true
            lkSide := o.side
            lkSL   := o.sl
            lkTP   := o.lastTp
            lkBar  := bar_index
            lkBlk  := true
        f_lbFinalize()
        o.state := 0

    // 管理中の注文 ID 以外の建玉があれば停止 (ACC-2)
    if strategy.opentrades > 0
        string otId = strategy.opentrades.entry_id(strategy.opentrades - 1)
        if otId != o.id
            runtime.error("ZCL: 管理外の建玉 " + otId + " を検出しました (管理中 " + o.id + ")。プロパティの再計算設定を確認してください。")

    // ---- (B1) 確定した上位足の値から Zone を登録 / 更新 --------------------------------------------
    array.clear(lbDeadNow)
    // ZA: 新しい ID = 前回届いた ID と違う (未固定が残っていれば固定)。同じ ID は形成中に上下限を更新し、形成中フラグ 0 で固定
    array<float> fU = array.from(f1u, f2u, f3u)
    array<float> fL = array.from(f1l, f2l, f3l)
    array<int>   fI = array.from(f1i, f2i, f3i)
    array<int>   fA = array.from(f1a, f2a, f3a)
    for k = 0 to 2
        int   aid = array.get(fI, k)
        float u   = array.get(fU, k)
        float l   = array.get(fL, k)
        if f_zaUse(k) and not na(aid) and not na(u) and not na(l)
            bool forming = array.get(fA, k) == 1
            int  last    = array.get(lbAccLast, k)
            if na(last) or aid != last
                array.set(lbAccLast, k, aid)
                int na0 = array.size(lbAccs)
                if na0 > 0
                    for i = na0 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k
                            f_lbAccFix(q)
                            array.remove(lbAccs, i)
                LbAcc b = LbAcc.new(k, aid, u, l)
                if forming
                    array.push(lbAccs, b)
                else
                    f_lbAccFix(b)
            else
                int na1 = array.size(lbAccs)
                if na1 > 0
                    for i = na1 - 1 to 0
                        LbAcc q = array.get(lbAccs, i)
                        if q.tf == k and q.aid == aid
                            q.up := u
                            q.lo := l
                            if not forming
                                f_lbAccFix(q)
                                array.remove(lbAccs, i)
    // ZC: 新しい Pivot (時刻キーが前回と違う) はすべて登録。統合距離以内で連鎖する既存の水平線 Zone があればまとめる (f_swAdd)
    array<float> pH  = array.from(s1h, s2h, s3h, s4h)
    array<int>   pHt = array.from(s1ht, s2ht, s3ht, s4ht)
    array<float> pL  = array.from(s1l, s2l, s3l, s4l)
    array<int>   pLt = array.from(s1lt, s2lt, s3lt, s4lt)
    for k = 0 to 3
        if f_zcUse(k)
            for s = 0 to 1
                float pv = s == 0 ? array.get(pH, k) : array.get(pL, k)
                int   pt = s == 0 ? array.get(pHt, k) : array.get(pLt, k)
                int   lt = s == 0 ? array.get(lbPivLastH, k) : array.get(lbPivLastL, k)
                if not na(pt) and not na(pv) and (na(lt) or pt != lt)
                    if s == 0
                        array.set(lbPivLastH, k, pt)
                    else
                        array.set(lbPivLastL, k, pt)
                    int sub = s == 0 ? 1 : -1
                    f_swAdd(k, sub, pv, pt)
    // ZD: 外部 POC (MtfPocFeedXAU) の受信。この 5分足に届いている確定済み上位足の出力を読み、正常な値で中心が前回の有効値から
    //  変わったら、同じ時間足の旧 POC を無効化して新 POC を登録する (時間足ごとに最新の確定 POC 1 つだけが有効。旧 POC は Zone の一覧・
    //  表示・TP 候補から外し、旧 POC を含む待機は (B3) で解除。時刻の更新だけでは何もしない。前と同じ価格に戻った場合も新 POC として採用)。
    //  状態: 0 検知 OFF / 1 正常 / 2 計算不能 (時刻 < 0) / 3 履歴不足 (時刻 na) / 8 外部側 OFF (時刻 0) / 9 未接続・誤接続
    //  (protocol ≠ 10001、時刻が時刻として不自然、正常なのに上下限が na / 上限 <= 下限)。8 / 9 は新規発注を止める (close で代用しない)
    bool zdProtoOK = not na(zdProto) and zdProto == 10001
    bool zdBad = false
    array<float> dL = array.from(zdL1, zdL2, zdL3, zdL4)
    array<float> dU = array.from(zdU1, zdU2, zdU3, zdU4)
    array<float> dT = array.from(zdT1, zdT2, zdT3, zdT4)
    for k = 0 to 3
        int stt = 0
        if f_zdUse(k)
            float tt = array.get(dT, k)
            float lo = array.get(dL, k)
            float up = array.get(dU, k)
            if not zdProtoOK
                stt := 9
            else if na(tt)
                stt := 3
            else if tt == 0
                stt := 8
            else if math.abs(tt) < 1e11 or math.abs(tt) >= time or tt != math.round(tt)
                stt := 9
            else if tt < 0
                stt := 2
            else if na(lo) or na(up)
                stt := 9
            else if up <= lo
                stt := 9
            else
                stt := 1
                float pc = (lo + up) / 2.0
                float lp = array.get(lbPocLast, k)
                if na(lp) or pc != lp
                    array.set(lbPocLast, k, pc)
                    LbZone oz = array.get(lbPocCur, k)
                    if not na(oz)
                        f_lbRemoveS(oz)
                        if dsZone
                            f_dsDel(oz, false)
                        oz.dead := true
                        array.push(lbDeadNow, oz.id)
                    LbZone nzp = f_lbNew(3, k, 0, pc, pc - zHalf, pc + zHalf, lo, up, int(tt))
                    // POC は受信した足から接触判定に使う (確定済み上位足の値で、この 5分足の開始時点から利用可能)。帯の外側の位置は
                    //  前の足の終値で決め、この足は既存の Zone と同じ規則 (高値・安値の接触 / 終値の突破) で判定する
                    if not na(labC1)
                        nzp.pos := labC1 > nzp.top + EPS ? 1 : labC1 < nzp.bot - EPS ? -1 : 0
                    f_lbAdd(nzp)
                    array.set(lbPocCur, k, nzp)
        array.set(lbZdStat, k, stt)
        if stt == 8 or stt == 9
            zdBad := true
    // ZE: 外部 LongFibWave (13 系列) の受信。4時間足・日足それぞれ最新の 1 波だけ (0.236 / 0.382 / 0.5 / 0.618 の 4 Zone)。
    //  状態: 0 OFF / 1 有効な波 / 2 波なし・初期化待ち / 3 保留中 / 8 外部側の計算 OFF / 9 未接続・誤接続 (protocol ≠ 20001、状態・波 ID・
    //  更新確定時刻が不自然、有効なのに起点・終点・方向が不正、無効なのに起点・終点・方向がある)。9 だけ新規発注を止める (close で代用しない)。
    //  8 (外部側の計算 OFF) は 2 / 3 と同じ正常な無効状態 (その時間足の Zone と待機を外すだけ)。
    //  有効な波の起点・終点・方向・波 ID のどれかが変わったら旧 4 Zone を外して (待機も解除) 新しい 4 Zone を登録 (同じなら何もしない)。
    //  波なし・保留中・外部 OFF ではその時間足の Zone を外す。誤接続では Zone を保つ。ZE 検知 OFF では何もしない
    bool zeProtoOK = not na(zeProto) and zeProto == 20001
    bool zeBad = false
    array<float> eO = array.from(ze4O, zeDO)
    array<float> eE = array.from(ze4E, zeDE)
    array<float> eD = array.from(ze4D, zeDD)
    array<float> eI = array.from(ze4I, zeDI)
    array<float> eS = array.from(ze4S, zeDS)
    array<float> eT = array.from(ze4T, zeDT)
    for k = 0 to 1
        int stt = 0
        if f_zeUse(k)
            float fo = array.get(eO, k)
            float fe = array.get(eE, k)
            float fd = array.get(eD, k)
            float fi = array.get(eI, k)
            float fs = array.get(eS, k)
            float ft = array.get(eT, k)
            if not zeProtoOK
                stt := 9
            else if na(fs) or na(fi) or na(ft) or na(fd)
                stt := 9
            else if fs != math.round(fs) or fs < 0 or fs > 3 or fi != math.round(fi) or fi < 0
                stt := 9
            else if math.abs(ft) < 1e11 or ft > time_close or ft != math.round(ft)
                stt := 9
            else if fs == 3
                stt := na(fo) or na(fe) ? 9 : fo == fe or not (fd == 1 or fd == -1) ? 9 : 1
            else
                stt := not na(fo) or not na(fe) or fd != 0 ? 9 : fs == 0 ? 8 : fs == 1 ? 2 : 3
            if stt == 1
                if not f_zeSame(k, fo, fe, fd, fi)
                    f_zeClear(k)
                    f_zeSet(k, fo, fe, fd, fi, ft)
            else if stt == 2 or stt == 3 or stt == 8
                f_zeClear(k)
                array.set(lbZeLast, k * 5 + 4, stt)
        array.set(lbZeStat, k, stt)
        if stt == 9
            zeBad := true
    // ZF: 新しい上位足 (キー = 形成足の時刻): 既存 FVG / iFVG を確定終値で判定 → 新しい FVG を登録
    array<int>   gK = array.from(g1k, g2k, g3k, g4k)
    array<float> gC = array.from(g1c, g2c, g3c, g4c)
    array<int>   gD = array.from(g1d, g2d, g3d, g4d)
    array<float> gT = array.from(g1t, g2t, g3t, g4t)
    array<float> gB = array.from(g1b, g2b, g3b, g4b)
    for k = 0 to 3
        int key = array.get(gK, k)
        int lk  = array.get(lbFvgLast, k)
        if f_zfUse(k) and not na(key) and (na(lk) or key != lk)
            array.set(lbFvgLast, k, key)
            float hc = array.get(gC, k)
            int nf = array.size(lbFvgs)
            if nf > 0 and not na(hc)
                for i = nf - 1 to 0
                    LbZone z = array.get(lbFvgs, i)
                    if z.tf == k and z.key < key
                        if not z.inv
                            if (z.sub == 1 and hc < z.bot) or (z.sub == -1 and hc > z.top)
                                z.inv := true
                                st.nIfvg += 1
                                if dsZone
                                    f_dsRename(z)
                        else if (z.sub == 1 and hc > z.top) or (z.sub == -1 and hc < z.bot)
                            z.dead := true
                            st.nFvgDead += 1
                            f_lbRemove(z)
                            array.push(lbDeadNow, z.id)
                            if dsZone
                                f_dsDel(z, true)
            int   gd = array.get(gD, k)
            float gt = array.get(gT, k)
            float gb = array.get(gB, k)
            if not na(gd) and gd != 0 and not na(gt) and not na(gb)
                f_lbAdd(f_lbNew(4, k, gd, (gt + gb) / 2.0, gb, gt, na, na, key))
    // ZG: ダブル / トリプル トップ・ボトム (1H / 4H / D の検知器の検知イベント = 反転足の確定で発動。接触・Pivot の登録だけでは作らない)。
    //  根拠 = 時間足 + 基準 ID で 1 回だけ (ダブルで発動した基準のトリプル・消えた基準の後の検知では作らない)。基準価格・幅・期限は発動時に固定。
    //  期限: 検知足 = 0 本目、その時間足の確定足の bar_index − 検知足 ≥ 本数で消す。逆行: 検知結果を受け取った確定 5分足 (発動した足) から実体端で判定
    //  (処理順: ZG の登録・期限 → 逆行による消滅 → (B2) 接触・(B3) 待機・(B6) 候補。発動した足で消えた Zone は接触・SL / TP 候補に残らない)
    array<string> zgPk = array.from(zgPk1, zgPk4, zgPkD)
    for k = 0 to 2
        [zlt, zrec] = f_zgParse(array.get(zgPk, k), array.get(lbZgLast, k), time_close)
        array.set(lbZgLast, k, zlt)
        int nr = int(array.size(zrec) / 6)
        if nr > 0
            for r = 0 to nr - 1
                int ro  = r * 6
                int rbi = int(array.get(zrec, ro + 1))
                if array.get(zrec, ro) == 0
                    int nzg = array.size(lbZgZ)
                    if f_zgExpOn(k) and nzg > 0
                        for i = nzg - 1 to 0
                            LbZone z = array.get(lbZgZ, i)
                            if z.tf == k and rbi - int(z.infoB) >= f_zgExpN(k)
                                f_zgKill(i)
                else
                    int   zid  = int(array.get(zrec, ro + 2))
                    int   zsd  = int(array.get(zrec, ro + 3))
                    float zcnt = array.get(zrec, ro + 4)
                    float zp   = array.get(zrec, ro + 5)
                    int   ukey = zid * 3 + k
                    if not array.includes(lbZgUsed, ukey) and not na(zp)
                        array.push(lbZgUsed, ukey)
                        if f_zgUse(k) or f_zgShow(k)
                            // sub: 1 トップ (抵抗) / -1 ボトム (支持)。infoA = 回数 (2 ダブル / 3 トリプル)、infoB = 検知足の bar_index、key = 基準 ID
                            LbZone zz = f_lbNew(6, k, zsd == -1 ? 1 : -1, zp, zp - zgHalf, zp + zgHalf, zcnt, rbi, zid)
                            zz.zgUse  := f_zgUse(k)
                            zz.zgShow := f_zgShow(k)
                            if zz.zgUse
                                f_lbAdd(zz)
                            else if dsZone and zz.zgShow
                                f_dsAdd(zz)
                            array.push(lbZgZ, zz)
    int nzg2 = array.size(lbZgZ)
    if nzg2 > 0
        for i = nzg2 - 1 to 0
            LbZone z = array.get(lbZgZ, i)
            if z.sub == 1 ? math.max(open, close) > z.ctr + zgRev + EPS : math.min(open, close) < z.ctr - zgRev - EPS
                f_zgKill(i)
    // ZB: EMA ± 共通幅 (毎足動く)。最初に値が出た足で作り、次の足から接触
    for k = 0 to 1
        float mv = k == 0 ? zbMa1 : zbMa2
        if f_zbUse(k) and not na(mv)
            LbZone mz = k == 0 ? lbMa1 : lbMa2
            if na(mz)
                LbZone nz0 = f_lbNew(1, k, 0, mv, mv - zHalf, mv + zHalf, na, na, na)
                array.set(lbNZone, 1, array.get(lbNZone, 1) + 1)
                if k == 0
                    lbMa1 := nz0
                else
                    lbMa2 := nz0
            else
                mz.ctr := mv
                mz.bot := mv - zHalf
                mz.top := mv + zHalf
    if dsZone
        f_dsMa()

    // ---- (B2) 接触・突破 (この足と前の終値の範囲に掛かる Zone だけ。範囲外の Zone の状態は変わらない) ----------
    array<LbZone> cZ    = array.new<LbZone>()
    array<int>    cSide = array.new_int()
    array<int>    cCat  = array.new_int()
    array<int>    xId   = array.new_int()
    array<int>    xSide = array.new_int()
    float rLo = na(labC1) ? low : math.min(labC1, low)
    float rHi = na(labC1) ? high : math.max(labC1, high)
    for g = 0 to 1
        array<LbZone> arr = g == 0 ? lbZs : lbFvgs
        int nz1 = array.size(arr)
        int iz  = f_lbLower(arr, rLo - (g == 0 ? st.maxW : st.maxWF) - EPS)
        while iz < nz1
            LbZone z = array.get(arr, iz)
            if z.bot > rHi + EPS
                break
            st.iter += 1
            if z.top >= rLo - EPS and (z.aBar < bar_index or z.typ == 3)     // POC は受信した足から (他の種類は登録の次の足から)
                [cs, cc, xs] = f_lbStep(z, z.bot, z.top)
                if cs != 0
                    array.push(cZ, z)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, z.id)
                    array.push(xSide, xs)
            iz += 1
    for k = 0 to 1
        LbZone mz = k == 0 ? lbMa1 : lbMa2
        float  mv = k == 0 ? zbMa1 : zbMa2
        if not na(mz) and not na(mv) and f_zbUse(k)
            if mz.aBar < bar_index
                [cs, cc, xs] = f_lbStep(mz, mz.bot, mz.top)
                if cs != 0
                    array.push(cZ, mz)
                    array.push(cSide, cs)
                    array.push(cCat, cc)
                if xs != 0
                    array.push(xId, mz.id)
                    array.push(xSide, xs)
    st.maxIter := math.max(st.maxIter, st.iter)
    st.nTouch  += array.size(cZ)

    // ---- (B3) 待機: 突破による解除 / 無効化した Zone → 期限 → 作成・更新 -----------------------------------
    int nw0 = array.size(lbWaits)
    if nw0 > 0
        for i = nw0 - 1 to 0
            LbWait w = array.get(lbWaits, i)
            bool drop = false
            int nx = array.size(xId)
            if nx > 0
                for j = 0 to nx - 1
                    if array.get(xSide, j) == w.side and f_waitHas(w, array.get(xId, j))
                        drop := true
            int nd = array.size(lbDeadNow)
            if nd > 0
                for j = 0 to nd - 1
                    if f_waitHas(w, array.get(lbDeadNow, j))
                        drop := true
            if drop
                f_waitDel(i)
                st.nCancel += 1
            else if bar_index - w.lBar > waitBars
                f_waitDel(i)
                st.nWaitExp += 1
    int nSel = (cZA ? 1 : 0) + (cZB ? 1 : 0) + (cZC ? 1 : 0) + (cZD ? 1 : 0) + (cZF ? 1 : 0) + (cZE ? 1 : 0) + (cZG and (zgUse1 or zgUse4 or zgUseD) ? 1 : 0)
    int nc0  = array.size(cZ)
    if nc0 > 0
        for j = 0 to nc0 - 1
            st.nFake += array.get(cCat, j) == 2 ? 1 : 0
    if nc0 > 0 and (cComb == "OR" or nSel <= 1)
        for j = 0 to nc0 - 1
            LbZone z = array.get(cZ, j)
            if f_condTyp(z.typ)
                int cc = array.get(cCat, j)
                f_lbUnit(array.get(cSide, j), cc, cc == 1, cc == 2, cc == 3, array.from(z.id), str.tostring(z.id), f_pow2(z.typ),
                     z.bot, z.top, z.bot, z.top, f_zName(z) + " " + f_catName(cc))
    else if nc0 > 0
        // AND: 選んだ種類ごとの接触 Zone の全組合せ (方向が同じ・重なりがあり・この足が重なりに接触したもの)
        array<int> tl = array.new_int()
        for t = 0 to 6
            if f_condTyp(t)
                array.push(tl, t)
        int nt = array.size(tl)
        array<int> cnt = array.new_int(nt, 0)
        bool allHave = true
        for a = 0 to nt - 1
            int c = 0
            for j = 0 to nc0 - 1
                LbZone z = array.get(cZ, j)
                if z.typ == array.get(tl, a)
                    c += 1
            array.set(cnt, a, c)
            if c == 0
                allHave := false
        if allHave
            // 種類の順に、その種類の接触を接触の順に並べる (従来の列挙順 = 最後の種類が最も速く進む辞書順)
            array<int> lst = array.new_int()
            array<int> off = array.new_int()
            for a = 0 to nt - 1
                array.push(off, array.size(lst))
                for j = 0 to nc0 - 1
                    LbZone z = array.get(cZ, j)
                    if z.typ == array.get(tl, a)
                        array.push(lst, j)
            // 深さ優先で組合せを選ぶ。途中まで選んだ Zone の方向が揃わない・共通の重なりがない・その重なりにこの足が接触していない
            // 枝は打ち切る (全部を選んだ組合せの条件は途中の組合せでも必ず成り立つので、有効な組合せは省略しない)
            array<int>   od  = array.new_int(nt, -1)
            array<float> pOb = array.new_float(nt, na)
            array<float> pOt = array.new_float(nt, na)
            int lv = 0
            int nodes = 0
            while lv >= 0
                int nxt = array.get(od, lv) + 1
                if nxt >= array.get(cnt, lv)
                    array.set(od, lv, -1)
                    lv -= 1
                else
                    array.set(od, lv, nxt)
                    nodes += 1
                    int    jz = array.get(lst, array.get(off, lv) + nxt)
                    LbZone zz = array.get(cZ, jz)
                    float  ob = zz.bot
                    float  ot2 = zz.top
                    bool   okp = true
                    if lv > 0
                        ob  := math.max(array.get(pOb, lv - 1), zz.bot)
                        ot2 := math.min(array.get(pOt, lv - 1), zz.top)
                        int j0 = array.get(lst, array.get(off, 0) + array.get(od, 0))
                        okp := array.get(cSide, jz) == array.get(cSide, j0)
                    okp := okp and ob <= ot2 + EPS and low <= ot2 + EPS and high >= ob - EPS
                    if okp
                        array.set(pOb, lv, ob)
                        array.set(pOt, lv, ot2)
                        if lv < nt - 1
                            lv += 1
                        else
                            array<int> pick = array.new_int()
                            for a = 0 to nt - 1
                                array.push(pick, array.get(lst, array.get(off, a) + array.get(od, a)))
                            int   s0   = array.get(cSide, array.get(pick, 0))
                            float eb   = na
                            float et   = na
                            int   cat0 = array.get(cCat, array.get(pick, 0))
                            bool  cr   = false
                            bool  cf   = false
                            bool  co   = false
                            int   tm   = 0
                            array<int> ids = array.new_int()
                            string desc = ""
                            for a = 0 to nt - 1
                                int j = array.get(pick, a)
                                LbZone z = array.get(cZ, j)
                                int cc = array.get(cCat, j)
                                eb  := na(eb) ? z.bot : math.min(eb, z.bot)
                                et  := na(et) ? z.top : math.max(et, z.top)
                                cr  := cr or cc == 1
                                cf  := cf or cc == 2
                                co  := co or cc == 3
                                tm  += f_pow2(z.typ)
                                // ID を昇順に挿入
                                int p = 0
                                int ni = array.size(ids)
                                while p < ni
                                    if array.get(ids, p) > z.id
                                        break
                                    p += 1
                                array.insert(ids, p, z.id)
                                desc := desc + (a > 0 ? " + " : "") + f_zName(z)
                            string key = ""
                            for p = 0 to array.size(ids) - 1
                                key := key + (p > 0 ? "|" : "") + str.tostring(array.get(ids, p))
                            f_lbUnit(s0, cat0, cr, cf, co, ids, key, tm, ob, ot2, eb, et, desc + " " + f_catName(cat0))
            st.maxCombo := math.max(st.maxCombo, nodes)
    // BEL-2: ロックで禁止の足では待機を残さない (解除後は解除の次の足以後の接触から)
    if lkBlk and array.size(lbWaits) > 0
        st.nLockClr += array.size(lbWaits)
        array.clear(lbWaits)
        map.clear(lbWaitMap)
    st.maxWaits := math.max(st.maxWaits, array.size(lbWaits))

    // ---- (B4) タイミング: TA (ACC-5A と同じ: 期限 → 吸収 → 新しい FVG) / TC (f_satHist) / TE (短期 DTB) / TD (1分ストキャス) / 古いものを外す ----
    //  (v5 由来: and の両辺を評価する前提で、na のオブジェクトのフィールドを読む条件は if を分けている。v6 の短絡評価でも結果は同じ)
    if not na(lbFvUp)
        if bar_index - lbFvUp.fBar > fvLife
            lbFvUp := na
    if not na(lbFvDn)
        if bar_index - lbFvDn.fBar > fvLife
            lbFvDn := na
    for d = 0 to 1
        LbFvg fv = d == 0 ? lbFvUp : lbFvDn
        if not na(fv)
            bool absd = fv.dir == 1 ? (close < open and close <= fv.lo) : (close > open and close >= fv.hi)
            if absd
                st.tSeq += 1
                st.nTA  += 1
                array.push(lbTevs, LbTev.new(st.tSeq, 1, fv.dir == 1 ? -1 : 1, bar_index, false,
                     "TA FVG吸収 #" + str.tostring(fv.id)))
                if d == 0
                    lbFvUp := na
                else
                    lbFvDn := na
    bool upF = not na(labH2) and not na(labC1) and not na(labO1) and low > labH2 and labC1 > labO1 and low - labH2 >= fvMinW - EPS
    bool dnF = not na(labL2) and not na(labC1) and not na(labO1) and high < labL2 and labC1 < labO1 and labL2 - high >= fvMinW - EPS
    if upF
        st.fvSeq += 1
        lbFvUp := LbFvg.new(st.fvSeq, 1, bar_index, labH2, low)
    if dnF
        st.fvSeq += 1
        lbFvDn := LbFvg.new(st.fvSeq, -1, bar_index, high, labL2)
    [hL1, qL1, nL1] = f_satHist(1, labS1, hTqL1)
    [hL2, qL2, nL2] = f_satHist(1, labS2, hTqL2)
    [hL3, qL3, nL3] = f_satHist(1, labS3, hTqL3)
    [hS1, qS1, nS1] = f_satHist(-1, labS1, hTqS1)
    [hS2, qS2, nS2] = f_satHist(-1, labS2, hTqS2)
    [hS3, qS3, nS3] = f_satHist(-1, labS3, hTqS3)
    hTqL1 := nL1
    hTqL2 := nL2
    hTqL3 := nL3
    hTqS1 := nS1
    hTqS2 := nS2
    hTqS3 := nS3
    if hL1 or hL2 or hL3
        st.tSeq += 1
        st.nTC  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 2, 1, bar_index, false, "TC SATS反発 " + (hL1 ? "LINE1" : hL2 ? "LINE2" : "STB")))
    if hS1 or hS2 or hS3
        st.tSeq += 1
        st.nTC  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 2, -1, bar_index, false, "TC SATS反発 " + (hS1 ? "LINE1" : hS2 ? "LINE2" : "STB")))
    // TE: 短期 DTB (5分 / 15分基準・実体ベース)。足の取り込み → 山・谷の登録 → 各基準 (⓪ 最大離れ幅 → ① 終値の無効化 → ② 反転待ち →
    //  ③ 接近 → ④ 最低離れ幅)。Zone の到達・待機とは無関係に常時追跡し、検知 (反転の確定) を基準ごとのタイミングにする (この足だけ有効)
    if array.size(lbDtWs) == 0
        for k = 0 to 1
            array.push(lbDtWs, LbDtW.new(array.new_float(), array.new_float(), na))
    int   dtW  = 2 * tePiv + 1
    float bTop = math.max(open, close)
    float bBot = math.min(open, close)
    for k = 0 to 1
        int   nt = k == 0 ? time : labTe15t
        float nh = k == 0 ? bTop : labTe15T
        float nl = k == 0 ? bBot : labTe15B
        LbDtW tw = array.get(lbDtWs, k)
        if not na(nt) and not na(nh) and not na(nl) and (na(tw.lastT) or nt != tw.lastT)
            tw.lastT := nt
            array.push(tw.hs, nh)
            array.push(tw.ls, nl)
            if array.size(tw.hs) > dtW
                array.shift(tw.hs)
                array.shift(tw.ls)
            if array.size(tw.hs) == dtW
                float mh   = array.get(tw.hs, tePiv)
                float ml   = array.get(tw.ls, tePiv)
                bool  isH  = true
                bool  isL  = true
                float rMin = na
                float rMax = na
                for j = 0 to dtW - 1
                    if j < tePiv
                        isH := isH and mh >= array.get(tw.hs, j)
                        isL := isL and ml <= array.get(tw.ls, j)
                    if j > tePiv
                        isH := isH and mh > array.get(tw.hs, j)
                        isL := isL and ml < array.get(tw.ls, j)
                        rMin := na(rMin) ? array.get(tw.ls, j) : math.min(rMin, array.get(tw.ls, j))
                        rMax := na(rMax) ? array.get(tw.hs, j) : math.max(rMax, array.get(tw.hs, j))
                // 15分基準は登録した確定 5分足の実体端も登録時の離れ幅に含める (5分基準では今の足が最後の確認足)
                if k == 1
                    rMin := math.min(rMin, bBot)
                    rMax := math.max(rMax, bTop)
                float dD   = k == 0 ? teD5 : teD15
                bool  mxOn = k == 0 ? teMxUse5 : teMxUse15
                float mxV  = k == 0 ? teMx5 : teMx15
                if isH and not (mxOn and mh - rMin > mxV + EPS)
                    LbDt gh = LbDt.new(k, -1, mh, bar_index, mh - rMin >= dD - EPS)
                    gh.ext := rMin
                    array.push(lbDts, gh)
                if isL and not (mxOn and rMax - ml > mxV + EPS)
                    LbDt gl = LbDt.new(k, 1, ml, bar_index, rMax - ml >= dD - EPS)
                    gl.ext := rMax
                    array.push(lbDts, gl)
    bool   teDetL = false
    bool   teDetS = false
    int ndt = array.size(lbDts)
    if ndt > 0
        for i = ndt - 1 to 0
            LbDt g = array.get(lbDts, i)
            if g.aBar < bar_index
                bool  top  = g.side == -1
                float bB   = g.tf == 0 ? teB5 : teB15
                float bD   = g.tf == 0 ? teD5 : teD15
                bool  gOn  = g.tf == 0 ? teMxUse5 : teMxUse15
                float gMx  = g.tf == 0 ? teMx5 : teMx15
                float pApp = top ? bTop : bBot      // 接近 = 同じ側の実体端
                float pDst = top ? bBot : bTop      // 離れ幅 = 反対側の実体端
                bool  fin  = false
                g.ext := top ? math.min(g.ext, pDst) : math.max(g.ext, pDst)
                // ⓪ 最大離れ幅 (無効化・反転・接近より先)
                if gOn and (top ? g.lvl - g.ext > gMx + EPS : g.ext - g.lvl > gMx + EPS)
                    fin := true
                // ① 終値による無効化 (H + 接近幅を上回る / L − 接近幅を下回る)
                else if top ? close > g.lvl + bB + EPS : close < g.lvl - bB - EPS
                    fin := true
                else
                    bool det = false
                    bool rev = top ? close < open : close > open
                    if g.waiting
                        // ② 反転待ち: 最初の陰線 (陽線) で検知、最後の足を過ぎたら見送り (接近 1 回に数えたまま)
                        if rev
                            det := true
                            g.waiting := false
                        else if bar_index >= g.waitEnd
                            g.waiting := false
                        fin := not g.waiting and g.cnt >= 3
                    else if g.away and g.cnt < 3 and pApp >= g.lvl - bB - EPS and pApp <= g.lvl + bB + EPS
                        // ③ 接近 (2 回目・3 回目): 同じ側の実体端が基準価格 ± 接近幅以内。接近足が陰線 (陽線) ならこの足で検知
                        g.cnt     += 1
                        g.away    := false
                        g.appBar  := bar_index
                        g.waitEnd := bar_index + teWait
                        if rev
                            det := true
                        else if teWait > 0
                            g.waiting := true
                        fin := not g.waiting and g.cnt >= 3
                    if det
                        // 基準ごとに 1 個 (接近足を持つ)。待機ごとの到達足との前後判定と 1 件へのまとめは候補選択・消費で行う
                        string nm = (top ? "TE トップ " : "TE ボトム ") + (g.tf == 0 ? "5分" : "15分") + (g.cnt == 2 ? "ダブル" : "トリプル") +
                             " " + str.tostring(g.lvl, "#.##")
                        st.tSeq += 1
                        array.push(lbTevs, LbTev.new(st.tSeq, 3, top ? -1 : 1, bar_index, false, nm, g.appBar))
                        teDetS := teDetS or top
                        teDetL := teDetL or not top
                    // ④ 最低離れ幅 (接近足自身は数えない。次の接近は次の足から)
                    if not fin and (na(g.appBar) or g.appBar != bar_index) and (top ? pDst <= g.lvl - bD + EPS : pDst >= g.lvl + bD - EPS)
                        g.away := true
                if fin
                    array.remove(lbDts, i)
    // 成立数は足・方向ごとに 1 件
    st.nTE += (teDetL ? 1 : 0) + (teDetS ? 1 : 0)
    // TD: この確定 5分足の中の 1分合図 (1分足の time_close がこの 5分足の中) をすべて確認し、方向ごとに最新の 1件を代表にする。
    //  この 5分足だけ有効 (次の足へ持ち越さない)
    int tdL = na
    int tdS = na
    if chart.is_standard and not na(labTdDir) and not na(labTdTc)     // 通常ローソク足の 5分チャートだけ (lbRun = 5分足)
        int ntd = math.min(array.size(labTdDir), array.size(labTdTc))
        if ntd > 0
            for j = 0 to ntd - 1
                int dv = array.get(labTdDir, j)
                int tc = array.get(labTdTc, j)
                if not na(dv) and not na(tc) and tc > time and tc <= time_close
                    if dv == 1
                        tdL := na(tdL) ? tc : math.max(tdL, tc)
                    else if dv == -1
                        tdS := na(tdS) ? tc : math.max(tdS, tc)
    if not na(tdL)
        st.tSeq += 1
        st.nTD  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 4, 1, bar_index, false, "TD ストキャスMTF L " + str.format_time(tdL, "HH:mm", syminfo.timezone)))
    if not na(tdS)
        st.tSeq += 1
        st.nTD  += 1
        array.push(lbTevs, LbTev.new(st.tSeq, 4, -1, bar_index, false, "TD ストキャスMTF S " + str.format_time(tdS, "HH:mm", syminfo.timezone)))
    int ne0 = array.size(lbTevs)
    if ne0 > 0
        for i = ne0 - 1 to 0
            LbTev e = array.get(lbTevs, i)
            if e.used or bar_index - e.eBar > (e.kind == 1 ? fvAbsLife : e.kind == 2 ? tcLife : 0)
                array.remove(lbTevs, i)
    st.maxTevs := math.max(st.maxTevs, array.size(lbTevs))

    // ---- (B5) 保有中: 建値 → TP の計画し直し → 変更通知 -----------------------------------------------------
    if o.state == 2 and opn
        if beOn and not o.be
            float trig = beMode == "固定幅" ? o.fill + o.side * beDist : o.fill + beRatio / 100.0 * (o.tp1E - o.fill)
            bool  okT  = beMode == "固定幅" or (not na(o.tp1E) and o.side * (o.tp1E - o.fill) > 0)
            if okT and (o.side == 1 ? high >= trig : low <= trig)
                o.be   := true
                o.stop := o.fill
                st.nBE += 1
        f_lbPlan(o.side == 1 ? math.max(o.fill, close) : math.min(o.fill, close), o.fill)
        f_lbIssue()
        o.lastTp := f_lbFarTp()
        f_lbNotify(false)

    // ---- (B6) 候補 → 優先 (現在価格に近い Zone) → 競合 → 発注 --------------------------------------------
    LbCand bestL = na
    LbCand bestS = na
    array<float> tpL = na          // この足の TP 候補 (判断時の基準 = 終値)。方向ごとに必要になった時だけ 1 回計算し、候補間で再利用
    array<float> tpS = na
    int nwc = array.size(lbWaits)
    if nwc > 0
        for i = 0 to nwc - 1
            LbWait w = array.get(lbWaits, i)
            int ia = cTA ? f_lbTim(1, w.side, w.sBar) : -1
            int ic = cTC ? f_lbTim(2, w.side, w.sBar) : -1
            int ie = cTE ? f_lbTim(3, w.side, w.sBar) : -1
            int it = cTD ? f_lbTim(4, w.side, w.sBar) : -1
            bool timOK = cTim == "AND" ? ((cTA or cTC or cTE or cTD) and (not cTA or ia >= 0) and (not cTC or ic >= 0) and (not cTE or ie >= 0) and
                 (not cTD or it >= 0)) : ((cTA and ia >= 0) or (cTC and ic >= 0) or (cTE and ie >= 0) or (cTD and it >= 0))
            if timOK
                st.nCand += 1
                int why = -1
                int om  = f_lbOthers(w.eBot, w.eTop, w.tmask)
                float sl  = w.side == 1 ? w.eBot - slBuf : w.eTop + slBuf
                float slw = w.side * (close - sl)
                float tp1 = na
                float rr  = na
                float qty = na
                int   nT  = 0
                if zdBad
                    why := 7
                else if zeBad
                    why := 8
                else if (w.cReb and not catReb) or (w.cFake and not catFake) or (w.cRole and not catRole)
                    why := 0
                else if cScope == "だけ" and om != 0
                    why := 1
                else if slw <= EPS or (maxSlOn and slw >= maxSl - 1e-6)
                    why := 2
                else
                    array<float> tps = array.new_float()
                    if tpMode != "固定 RR"
                        if w.side == 1
                            if na(tpL)
                                tpL := f_lbTargets(1, close)
                            tps := tpL
                        else
                            if na(tpS)
                                tpS := f_lbTargets(-1, close)
                            tps := tpS
                    nT  := array.size(tps)
                    tp1 := nT > 0 ? array.get(tps, 0) : close + w.side * fixRR * slw
                    rr  := w.side * (tp1 - close) / slw
                    if rr < minRR1 - EPS
                        why := 3
                    else if not sessOK
                        why := 4
                    else if not labRangeOK
                        why := 5
                    else
                        qty := f_qty(w.side, close, sl)
                        if na(qty)
                            why := 6
                if why >= 0
                    array.set(skipN, why, array.get(skipN, why) + 1)
                else
                    float dist = close > w.cTop ? close - w.cTop : close < w.cBot ? w.cBot - close : 0.0
                    LbCand c = LbCand.new(i, w.side, sl, slw, tp1, rr, qty, dist, cTA ? ia : -1, cTC ? ic : -1, om, nT)
                    c.ie := cTE ? ie : -1
                    c.it := cTD ? it : -1
                    if w.side == 1
                        if na(bestL)
                            bestL := c
                        else if c.dist < bestL.dist - EPS
                            bestL := c
                    else
                        if na(bestS)
                            bestS := c
                        else if c.dist < bestS.dist - EPS
                            bestS := c
    LbCand pick = na
    if not na(bestL) and not na(bestS)
        st.nConflict += 1
    else if not na(bestL)
        pick := bestL
    else if not na(bestS)
        pick := bestS
    if not na(pick)
        bool flat = o.state == 0 and strategy.position_size == 0
        if not flat or lkBlk
            st.nHoldSkip += 1
        else
            LbWait w = array.get(lbWaits, pick.wi)
            o.n          += 1
            o.id         := (pick.side == 1 ? "L" : "S") + str.tostring(o.n)
            o.side       := pick.side
            o.ref        := close
            o.sl         := pick.sl
            o.stop       := pick.sl
            o.be         := false
            o.fill       := na
            o.lotQ       := mmLotStep * mmLotOz / syminfo.pointvalue
            o.lotN       := int(math.round(pick.qty / o.lotQ))
            o.closedLots := 0
            o.stage      := 0
            o.bar        := bar_index
            o.tp1E       := pick.tp1
            o.tp1Fix     := tpMode == "固定 RR" or pick.nT == 0
            o.tmask      := w.tmask
            o.omask      := pick.omask
            o.cReb       := w.cReb
            o.cFake      := w.cFake
            o.cRole      := w.cRole
            o.tim        := (pick.ia >= 0 ? 1 : 0) + (pick.ic >= 0 ? 2 : 0) + (pick.ie >= 0 ? 4 : 0) + (pick.it >= 0 ? 8 : 0)
            o.pnl        := 0.0
            o.nTp        := 0
            o.lastStop   := false
            o.lastTp     := na
            o.state      := 1
            for k = 0 to 2
                array.set(o.ntfPx, k, na)
            f_lbPlan(close, close)
            o.lastTp := f_lbFarTp()
            strategy.entry(o.id, pick.side == 1 ? strategy.long : strategy.short, qty = o.lotN * o.lotQ)
            f_lbIssue()
            f_lbNotify(true)
            // 消費: 使ったタイミング、この待機と同じ Zone を含む待機
            string tdesc = ""
            if pick.ia >= 0
                LbTev ea = array.get(lbTevs, pick.ia)
                ea.used := true
                tdesc := tdesc + " " + ea.desc + " (" + str.tostring(bar_index - ea.eBar) + "本前)"
            if pick.ic >= 0
                LbTev ec = array.get(lbTevs, pick.ic)
                ec.used := true
                tdesc := tdesc + " " + ec.desc + " (" + str.tostring(bar_index - ec.eBar) + "本前)"
            if pick.ie >= 0
                // この待機 (Zone) に適格な同じ方向・この確定足の TE (5分 / 15分・複数の基準) をまとめて 1 件として消費する
                string tex = ""
                int nte = array.size(lbTevs)
                for j = 0 to nte - 1
                    LbTev ee = array.get(lbTevs, j)
                    if ee.kind == 3 and ee.side == pick.side and not ee.used and ee.eBar == bar_index and ee.aBar >= w.sBar
                        ee.used := true
                        tex := tex + (tex == "" ? "" : " + ") + ee.desc
                tdesc := tdesc + " " + tex + " (この足)"
            if pick.it >= 0
                LbTev et = array.get(lbTevs, pick.it)
                et.used := true
                tdesc := tdesc + " " + et.desc + " (この足)"
            o.desc := (pick.side == 1 ? "LONG " : "SHORT ") + w.desc + "\n接触 " + str.tostring(bar_index - w.sBar) + "本前〜 /" + tdesc +
                 "\n判断 " + str.tostring(close, "#.##") + "  SL " + str.tostring(pick.sl, "#.##") + "  RR(TP1) " + str.tostring(pick.rr, "#.##") +
                 "\n" + f_lbTpText() + (pick.omask != 0 ? "\n他種類の重なりあり" : "")
            array<int> used = w.ids
            int nw2 = array.size(lbWaits)
            for i = nw2 - 1 to 0
                LbWait wj = array.get(lbWaits, i)
                bool hit = false
                for j = 0 to array.size(used) - 1
                    if f_waitHas(wj, array.get(used, j))
                        hit := true
                if hit
                    f_waitDel(i)
            alert("ZCL 確定 " + o.id + " " + o.desc, alert.freq_once_per_bar_close)
            o.lbl := na
            if dsEnt
                o.lbl := label.new(bar_index, pick.side == 1 ? low : high, o.id + " " + o.desc,
                     style = pick.side == 1 ? label.style_label_up : label.style_label_down,
                     color = pick.side == 1 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
                array.push(lbLbls, o.lbl)
                if array.size(lbLbls) > dsEntMax
                    label.delete(array.shift(lbLbls))

    // ---- (B7) 資産 (実現 + 含み損益) と最大 DD (含み損は確定足の不利な側の高値 / 安値で評価) ---------------------
    float openC = 0.0
    float openW = 0.0
    if strategy.position_size != 0 and not na(o.fill)
        float qn = math.abs(strategy.position_size)
        openC := strategy.convert_to_account(o.side * (close - o.fill) * qn * syminfo.pointvalue)
        openW := strategy.convert_to_account(o.side * ((o.side == 1 ? low : high) - o.fill) * qn * syminfo.pointvalue)
    float eqC = strategy.initial_capital + st.realized + openC
    float eqW = strategy.initial_capital + st.realized + openW
    st.peak := na(st.peak) ? math.max(strategy.initial_capital, eqC) : math.max(st.peak, eqC)
    float dd = st.peak - eqW
    if dd > st.maxDD
        st.maxDD := dd
    if st.peak > 0 and dd / st.peak > st.maxDDPct
        st.maxDDPct := dd / st.peak

    // ---- (B8) Zone タッチ通知 (設定 ON のときだけ。この足の処理を終えた時点の有効な Zone で判定) -----------------------
    //  接触した Zone のうち、前回の通知の足で接触していた Zone 以外があれば、それらを 1 通にまとめて通知し、この足の接触 Zone を記録する。
    //  前回の Zone だけへの接触 (離れて戻った場合を含む) は通知しない。接触のない足・日付の変更では記録を変えない
    if ntfTouch
        array<LbZone> tz = f_ntfTouched()
        int nt = array.size(tz)
        if nt > 0
            array<LbZone> nwz = array.new<LbZone>()
            for j = 0 to nt - 1
                LbZone z = array.get(tz, j)
                if not array.includes(lbNtfIds, z.id)
                    array.push(nwz, z)
            int nn = array.size(nwz)
            if nn > 0
                string msg = "ZCL Zoneタッチ " + syminfo.ticker + " " + str.format_time(time_close, "yyyy-MM-dd HH:mm", syminfo.timezone) + " (5分足確定)"
                for j = 0 to math.min(nn, 20) - 1
                    msg := msg + "\n" + f_ntfLine(array.get(nwz, j))
                if nn > 20
                    msg := msg + "\nほか " + str.tostring(nn - 20) + " 件"
                alert(msg, alert.freq_once_per_bar_close)
                lbNtfN += 1
                array.clear(lbNtfIds)
                for j = 0 to nt - 1
                    LbZone z = array.get(tz, j)
                    array.push(lbNtfIds, z.id)
// ==== LAB Logic (end) ========================================================

// ============================================================================
// 04. 表示 (売買には影響しない)
// ============================================================================
plot(zbUse1 ? zbMa1 : na, "MA 1分足 EMA", color = color.new(color.blue, 30))
plot(zbUse2 ? zbMa2 : na, "MA 5分足 EMA", color = color.new(color.navy, 30))

// 帯の名称を最新足の右側へ (最後の確定履歴足と、その後のリアルタイムの確定足)
if lbRun and dsZone and (barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed))
    f_dsLblX()

f_pct(float a, float b) =>
    b > 0 ? str.tostring(a / b * 100.0, "#.#") + "%" : "-"

var table lbTbl = table.new(position.bottom_right, 8, 32, border_width = 1, frame_color = color.gray)
if dsTbl and barstate.islast and lbRun
    array<string> nm = array.from("全体", "アキュム含む", "MA含む", "水平線含む", "出来高POC含む", "FVG含む", "アキュムだけ", "MAだけ", "水平線だけ", "出来高POCだけ", "FVGだけ",
         "TA FVG吸収", "TC SATS反発", "反発", "ダマシ", "サポレジ", "LONG", "SHORT", "フィボ含む", "フィボだけ",
         "ダブル/トリプル含む", "ダブル/トリプルだけ", "TE ダブル/トリプル", "TD ストキャスMTF")
    array<string> hd = array.from("区分 (取引台帳)", "取引", "勝/負/建", "勝率", "PF", "平均R", "純損益(円)", "")
    for c = 0 to 6
        table.cell(lbTbl, c, 0, array.get(hd, c), text_color = color.white, bgcolor = color.new(color.navy, 10), text_size = size.tiny)
    for b = 0 to 23
        int   n  = array.get(bkN, b)
        int   w  = array.get(bkW, b)
        int   l  = array.get(bkL, b)
        float gp = array.get(bkGP, b)
        float gl = array.get(bkGL, b)
        table.cell(lbTbl, 0, b + 1, array.get(nm, b), text_size = size.tiny)
        table.cell(lbTbl, 1, b + 1, str.tostring(n), text_size = size.tiny)
        table.cell(lbTbl, 2, b + 1, str.tostring(w) + "/" + str.tostring(l) + "/" + str.tostring(array.get(bkBE, b)), text_size = size.tiny)
        table.cell(lbTbl, 3, b + 1, f_pct(w, w + l), text_size = size.tiny)
        table.cell(lbTbl, 4, b + 1, gl > 0 ? str.tostring(gp / gl, "#.##") : n > 0 ? "∞" : "-", text_size = size.tiny)
        table.cell(lbTbl, 5, b + 1, n > 0 ? str.tostring(array.get(bkR, b) / n, "#.##") : "-", text_size = size.tiny)
        table.cell(lbTbl, 6, b + 1, str.tostring(array.get(bkNet, b), "#"), text_size = size.tiny)
    table.cell(lbTbl, 0, 25, "最大DD (含み込み)", text_size = size.tiny)
    table.cell(lbTbl, 1, 25, str.tostring(st.maxDD, "#") + " 円", text_size = size.tiny)
    table.cell(lbTbl, 2, 25, str.tostring(st.maxDDPct * 100.0, "#.##") + " %", text_size = size.tiny)
    table.cell(lbTbl, 0, 26, "保持 アキュム/MA/水平線/POC/FVG/フィボ/ダブル・トリプル", text_size = size.tiny)
    table.cell(lbTbl, 1, 26, str.tostring(array.get(lbNZone, 0)) + "/" + str.tostring(array.get(lbNZone, 1)) + "/" + str.tostring(array.get(lbNZone, 2)) +
         "/" + str.tostring(array.get(lbNZone, 3)) + "/" + str.tostring(array.get(lbNZone, 4)) + "/" + str.tostring(array.get(lbNZone, 5)) + "/" + str.tostring(array.get(lbNZone, 6)), text_size = size.tiny)
    table.cell(lbTbl, 0, 27, "最大 走査/待機/タイミング/組合せ", text_size = size.tiny)
    table.cell(lbTbl, 1, 27, str.tostring(st.maxIter) + "/" + str.tostring(st.maxWaits) + "/" + str.tostring(st.maxTevs) + "/" + str.tostring(st.maxCombo), text_size = size.tiny)
    table.cell(lbTbl, 0, 28, "見送り 区分/だけ/SL/RR/時間/期間/数量/ZD接続/ZE接続", text_size = size.tiny)
    table.cell(lbTbl, 1, 28, str.tostring(array.get(skipN, 0)) + "/" + str.tostring(array.get(skipN, 1)) + "/" + str.tostring(array.get(skipN, 2)) + "/" +
         str.tostring(array.get(skipN, 3)) + "/" + str.tostring(array.get(skipN, 4)) + "/" + str.tostring(array.get(skipN, 5)) + "/" + str.tostring(array.get(skipN, 6)) + "/" + str.tostring(array.get(skipN, 7)) + "/" + str.tostring(array.get(skipN, 8)), text_size = size.tiny)
    table.cell(lbTbl, 0, 29, "競合/保有中/ロック消去/iFVG/FVG無効", text_size = size.tiny)
    table.cell(lbTbl, 1, 29, str.tostring(st.nConflict) + "/" + str.tostring(st.nHoldSkip) + "/" + str.tostring(st.nLockClr) + "/" + str.tostring(st.nIfvg) + "/" + str.tostring(st.nFvgDead), text_size = size.tiny)
    // ZD の受信状態 (1H / 4H / D / W): 正常 / 計算不能 / 履歴不足 / 外部OFF / 誤接続 / OFF
    string zds = ""
    bool zdErr = false
    for k = 0 to 3
        int z0 = array.get(lbZdStat, k)
        zds := zds + (k > 0 ? " / " : "") + (z0 == 0 ? "OFF" : z0 == 1 ? "正常" : z0 == 2 ? "計算不能" : z0 == 3 ? "履歴不足" : z0 == 8 ? "外部OFF" : "誤接続")
        zdErr := zdErr or z0 == 8 or z0 == 9
    table.cell(lbTbl, 0, 30, "ZD 受信 1H/4H/D/W", text_size = size.tiny, bgcolor = zdErr ? color.new(color.red, 60) : na)
    table.cell(lbTbl, 1, 30, zds + (zdErr ? "  → 新規発注停止 (MtfPocFeedXAU の 13 系列を接続)" : ""), text_size = size.tiny,
         text_color = zdErr ? color.red : color.black)
    // ZE の受信状態 (4H / D): 有効 / 波なし / 保留中 / 外部OFF / 誤接続 / OFF
    string zes = ""
    bool zeErr = false
    for k = 0 to 1
        int e0 = array.get(lbZeStat, k)
        zes := zes + (k > 0 ? " / " : "") + (e0 == 0 ? "OFF" : e0 == 1 ? "有効" : e0 == 2 ? "波なし" : e0 == 3 ? "保留中" : e0 == 8 ? "外部OFF" : "誤接続")
        zeErr := zeErr or e0 == 9
    table.cell(lbTbl, 0, 31, "ZE 受信 4H/D", text_size = size.tiny, bgcolor = zeErr ? color.new(color.red, 60) : na)
    table.cell(lbTbl, 1, 31, zes + (zeErr ? "  → 新規発注停止 (LongFibWave の 13 系列を接続)" : ""), text_size = size.tiny,
         text_color = zeErr ? color.red : color.black)

// Data Window (検証用)
plot(st.nTrades,  "取引数 (台帳)", display = display.data_window)
plot(array.get(bkNet, 0), "純損益 (台帳・円)", display = display.data_window)
plot(st.maxDD,    "最大 DD (円)", display = display.data_window)
plot(array.size(lbZs) + array.size(lbFvgs), "静的 Zone 保持数", display = display.data_window)
plot(array.size(lbWaits), "待機数", display = display.data_window)
plot(array.size(lbTevs), "有効なタイミング数", display = display.data_window)
plot(st.iter,     "この足の Zone 走査数", display = display.data_window)

     "OFF: 使わない (表示 ON なら帯だけ表示)。")
zgShow4 = input.bool(true, "表示", group = G_ZG, inline = "zgu4",
     tooltip = "ON: 帯を表示 (既存の統合表示に入る)。OFF: 表示しない (利用の判定には影響しない)。")

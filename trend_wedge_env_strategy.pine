//
// ============================================================
//  トレンド + ウェッジ 環境認識ストラテジー
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing) + 任意トリガー
//  ・環境認識     : EMAトレンド環境認識 + ウェッジ環境認識 (日足〜1分足の6TF)
//  ・ウェッジ = 双方向。ベア(Rising)下限ブレイク→Short / ブル(Falling)上限ブレイク→Long。
//  ・場所条件     : WinZone は全て不使用
//  ・その他       : ボラフィルタ / リスク管理 / 時間帯フィルタ / Accumulation NoTrade を維持
//  ・環境認識のうち FVG / EMA(50/200/1000) / Stochastic / Fib / Volume / 三尊 / DT/DB は不使用 (削除)
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "Trend Wedge Env Strategy",
     shorttitle        = "TWEDGEENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 500
 )

// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 1分足トリガー確認 (request.security_lower_tf で現在の5分足内の確定1分足を配列取得)
//   トリガー検知は 1分足 OHLC で行い、最終エントリーは 5分足確定時に判定する。
//   現在足(5分足)との結合モード (triggerTFMode) は廃止。最終トリガーは 1分足のみで判断。
useLowerTFTrigger = input.bool(true, "1分足トリガーを使う")
triggerTF         = input.timeframe("1", "トリガー時間足")

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
// 既定 true : 同一5分足内で1分足のロング/ショートが両方成立したら NoTrade。
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useTrendEnv = input.bool(true, "トレンド環境認識(EMAスコア)を使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
// --- ① SL方式 (可変・固定/パターンに加えATRを選択可) ---
grpVSL = "① SL方式 (可変)"
slMode    = input.string("固定", "SL方式", options = ["固定", "パターン", "ATR"], group = grpVSL)
slBuf     = input.float(0.0, "SL バッファ (価格) ※パターン時", group = grpVSL)
slFixed   = input.float(12, "固定SL幅 (価格) ※固定時", group = grpVSL)
slAtrLen  = input.int(14, "ATR SL 期間 ※ATR時", group = grpVSL)
slAtrMult = input.float(3.0, "ATR SL 倍率 ※ATR時", group = grpVSL)
// --- ② TP方式 (可変・RR / ATR) ---
grpVTP = "② TP方式 (可変)"
tpMode    = input.string("RR", "TP方式", options = ["RR", "ATR"], group = grpVTP)
rrRatio   = input.float(1.0, "リスクリワード比 (RR時)", group = grpVTP)
tpAtrLen  = input.int(14, "ATR TP 期間 ※ATR時", group = grpVTP)
tpAtrMult = input.float(6.0, "ATR TP 倍率 ※ATR時", group = grpVTP)

useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4i. 入力 : ウェッジ 環境認識モジュール (WinZone Wedge とは別)
// ------------------------------------------------------------
//  双方向ウェッジ環境認識。
//    ・ベアウェッジ (Rising Wedge / 上昇ウェッジ) : 高値/安値とも上昇・収束
//      (安値傾き>高値傾き)。下限ラインを終値で下抜け → bias=-1 (Short環境)。
//    ・ブルウェッジ (Falling Wedge / 下降ウェッジ) : 高値/安値とも下降・収束
//      (高値傾き<安値傾き = 高値の方が強く下降)。上限ラインを終値で上抜け → bias=+1 (Long環境)。
//  形成中 / 候補完成 / 未ブレイク / 期限切れ / ライン交差 → bias=0 (Even)。
//  ブレイク後 holdBars 本だけ bias を保持し、期限切れで 0 へ戻す。反対方向の新確定で即上書き。
//  既存の WinZone Wedge とは完全に独立 (接頭辞 wedgeEnv)。方向必須の環境フィルター。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。
// ============================================================
grpWedgeEnv = "環境: ウェッジ (Bear/Bull)"
useWedgeEnvEnv = input.bool(true, "ウェッジ環境認識を使う", group = grpWedgeEnv)
useWedgeEnvD   = input.bool(true, "日足を使う", group = grpWedgeEnv)
useWedgeEnv4H  = input.bool(true, "4Hを使う",  group = grpWedgeEnv)
useWedgeEnv1H  = input.bool(true, "1Hを使う",  group = grpWedgeEnv)
useWedgeEnv15M = input.bool(true, "15Mを使う", group = grpWedgeEnv)
useWedgeEnv5M  = input.bool(false, "5Mを使う", group = grpWedgeEnv)
useWedgeEnv1M  = input.bool(false, "1Mを使う (通常のrequest.securityでは1分イベントを取りこぼすため既定OFF)", group = grpWedgeEnv)
wedgeEnvDailyTF = input.timeframe("D",   "日足TF", group = grpWedgeEnv)
wedgeEnv4HTF    = input.timeframe("240", "4H TF",  group = grpWedgeEnv)
wedgeEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpWedgeEnv)
wedgeEnv15MTF   = input.timeframe("15",  "15M TF", group = grpWedgeEnv)
wedgeEnv5MTF    = input.timeframe("5",   "5M TF",  group = grpWedgeEnv)
wedgeEnv1MTF    = input.timeframe("1",   "1M TF",  group = grpWedgeEnv)
// --- Pivot管理 ---
wedgeEnvPivotLen   = input.int(3, "Pivot Length", minval = 1, group = grpWedgeEnv)
wedgeEnvMinTouches = input.int(2, "最低Pivotタッチ数 (両サイド)", minval = 2, maxval = 4, group = grpWedgeEnv)
wedgeEnvMaxPivots  = input.int(12, "保持Pivot数 (探索対象・各サイド)", minval = 4, maxval = 24, group = grpWedgeEnv)
wedgeEnvNoiseATR   = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率", step = 0.05, group = grpWedgeEnv)
wedgeEnvTouchToleranceATR = input.float(0.5, "ラインからの許容誤差 ATR倍率", minval = 0.0, step = 0.05, group = grpWedgeEnv)
// --- 傾き (ATR正規化) ---
wedgeEnvMinSlopeATR = input.float(0.01, "最低傾き slope/ATR (絶対値)", minval = 0.0, step = 0.01, group = grpWedgeEnv)
wedgeEnvMaxSlopeATR = input.float(2.0, "最大傾き slope/ATR (絶対値)", minval = 0.1, step = 0.1, group = grpWedgeEnv)
// --- 収束 / 横幅 ---
wedgeEnvContractionRatio = input.float(0.7, "収束率 WidthNow <= WidthStart ×", minval = 0.1, maxval = 1.0, step = 0.05, group = grpWedgeEnv)
wedgeEnvMinPatternBars = input.int(8, "パターン最小横幅", minval = 1, group = grpWedgeEnv)
wedgeEnvMaxPatternBars = input.int(80, "パターン最大横幅", minval = 2, group = grpWedgeEnv)
// --- ラインブレイク (ベア=下限下抜け / ブル=上限上抜け) ---
wedgeEnvBreakBufferATR = input.float(0.1, "ラインブレイクのATRバッファ", minval = 0.0, step = 0.05, group = grpWedgeEnv)
wedgeEnvBreakMaxBars   = input.int(20, "候補完成後のブレイク期限", minval = 1, group = grpWedgeEnv)
// --- ブレイク品質フィルター (任意・両方向共通) ---
useWedgeEnvBreakCandleColor = input.bool(false, "ブレイク足の色を要求 (ベア=陰線 / ブル=陽線)", group = grpWedgeEnv)
useWedgeEnvBodyFilter  = input.bool(true, "ブレイク実体率フィルターを使う", group = grpWedgeEnv)
wedgeEnvMinBodyRatio   = input.float(0.45, "最低ブレイク実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpWedgeEnv)
useWedgeEnvVolExpansion = input.bool(false, "ブレイク時のATR拡大を要求", group = grpWedgeEnv)
wedgeEnvAtrExpandLen   = input.int(20, "ATR拡大 比較本数", minval = 1, group = grpWedgeEnv)
wedgeEnvAtrExpandMult  = input.float(1.1, "ATR > 平均ATR ×", step = 0.05, group = grpWedgeEnv)
// --- 品質フィルター ---
useWedgeEnvQualityFilter = input.bool(false, "Quality Filterを使う", group = grpWedgeEnv)
wedgeEnvMinQuality       = input.int(50, "最低Quality", minval = 0, maxval = 100, group = grpWedgeEnv)
// --- 状態保持本数 (足ごと・両方向共通) ---
wedgeEnvHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpWedgeEnv)
wedgeEnvHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpWedgeEnv)
wedgeEnvHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpWedgeEnv)
wedgeEnvHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpWedgeEnv)
wedgeEnvHold5M    = input.int(24, "5M 状態保持本数",   minval = 1, group = grpWedgeEnv)
wedgeEnvHold1M    = input.int(30, "1M 状態保持本数",   minval = 1, group = grpWedgeEnv)
// --- 統合 ---
wedgeEnvCombineMode = input.string("WeightedScore", "ウェッジ環境の結合方法", options = ["HigherTF", "WeightedScore"], group = grpWedgeEnv)
wedgeEnvWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpWedgeEnv)
wedgeEnvWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpWedgeEnv)
wedgeEnvWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpWedgeEnv)
wedgeEnvWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpWedgeEnv)
wedgeEnvWeight5M  = input.int(1, "重み 5M",   minval = 0, group = grpWedgeEnv)
wedgeEnvWeight1M  = input.int(1, "重み 1M",   minval = 0, group = grpWedgeEnv)
wedgeEnvScoreThreshold = input.int(3, "WeightedScore 閾値 (Long: score>=閾値 / Short: score<=-閾値)", minval = 1, group = grpWedgeEnv)
// --- トレンド環境との結合 ---
wedgeEnvTrendCombineMode = input.string("TrendAndWedge", "トレンドとの結合", options = ["TrendOnly", "WedgeOnly", "TrendAndWedge", "TrendOrWedge"], group = grpWedgeEnv)
useWedgeEnvBias = input.bool(false, "ウェッジ方向バイアスを使う (OFFで既存挙動を維持)", group = grpWedgeEnv)
// --- 表示 ---
wedgeEnvShowTable  = input.bool(true,  "ウェッジ環境テーブルを表示", group = grpWedgeEnv)
wedgeEnvShowDebug  = input.bool(false, "ウェッジ環境デバッグ表示", group = grpWedgeEnv)
wedgeEnvLabelTF    = input.string("15M", "描画対象TF", options = ["D", "4H", "1H", "15M", "5M", "1M"], group = grpWedgeEnv)
// --- パターン描画 (表示専用・検知/エントリーに影響しない) ---
wedgeEnvShowPatternLines = input.bool(true, "ウェッジラインを表示 (上限/下限)", group = grpWedgeEnv)
wedgeEnvShowPivotLabels  = input.bool(true, "採用Pivotのラベルを表示", group = grpWedgeEnv)
wedgeEnvShowBreakLabel   = input.bool(true, "ブレイク確定地点を表示", group = grpWedgeEnv)
wedgeEnvPatternLineWidth = input.int(2, "ウェッジライン太さ", minval = 1, maxval = 4, group = grpWedgeEnv)
// --- 過去履歴表示 ---
wedgeEnvShowHistory  = input.bool(false, "過去のウェッジを表示", group = grpWedgeEnv)
wedgeEnvHistoryCount = input.int(20, "過去パターン表示件数", minval = 1, maxval = 50, group = grpWedgeEnv)
wedgeEnvHistoryLineTransp = input.int(50, "過去確定ライン透明度", minval = 0, maxval = 90, group = grpWedgeEnv)
// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// 有効化されたトリガー数 (Any/All/MinCount 判定で使用・全コンテキスト共通)。
//   f_calcTriggers 内 (=1分足コンテキスト) からも参照するため関数より前で定義する。
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// 1分足コンテキストで全トリガーを判定し、その1分足単体で Any/All/MinCount を評価して
//   [bullTrigger, bearTrigger] を返す。異なる1分足で発生した条件を合算しない。
//   各トリガー条件・品質フィルターは既存ロジックと完全に同一 (変更なし)。
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    // この1分足単体で Any/All/MinCount を評価 (1分足内で完結)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

// 現在足(5分足)での直接判定 (useLowerTFTrigger = false 時のフォールバックのみに使用)
bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 1分足トリガー集約 ---
//   request.security_lower_tf で現在の5分足に含まれる確定済み1分足 (最大5本) の
//   [bullTrigger, bearTrigger] を配列で取得。5本のうち1本でも成立していれば
//   その方向を5分足の候補とする (途中の1分足トリガーを取りこぼさない)。
//   Any/All/MinCount は各1分足内で f_calcTriggers が評価済み → 異なる足の条件は合算しない。
//   ※ 形成途中の1分足は request.security_lower_tf の確定済み配列に含まれないため非リペイント。
bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, triggerTF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    // 1分足トリガー OFF → 現在足(5分足)で直接判定
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

// 同一5分足内でロング/ショート両方の1分足トリガーが発生 → 方向を予想せず NoTrade (既定)。
bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

// エントリークールダウン (5分足単位・トリガーON時のみ 10c で参照)
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useTrendEnv
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  本ファイルの環境認識モジュールは トレンド(EMAスコア) のみ。
//  FVG / EMA(50/200/1000) / Stochastic / Fib / Volume は削除済み。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool allEnvLongOk = trendLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool allEnvShortOk = trendShortOk
// ============================================================
//  8i. ウェッジ 環境認識モジュール 本体 (WinZone Wedge とは別)
// ------------------------------------------------------------
//  f_wedgeEnvState : 呼ばれた足(=上位足)コンテキストで Pivot High / Low を別配列で保持し、
//    ベアウェッジ(Rising) と ブルウェッジ(Falling) の候補を「方向別に混線せず」探索する。
//    ・ベア (Rising) : upSlope>0, loSlope>0, loSlope>upSlope, 収束。下限を終値で下抜け → bias=-1。
//    ・ブル (Falling): upSlope<0, loSlope<0, upSlope<loSlope, 収束。上限を終値で上抜け → bias=+1。
//    各方向で最良スコア候補を1件ずつ保持。上下ライン交差 (widthNow<=0 / upper<=lower) は
//    候補を即失効 (Reject Code 4)。同一バーで両方向確定なら bias=0 (Even)。
//    ブレイク確定後 holdBars 本だけ bias を保持し、反対方向の新確定で即上書き。
//  戻り値 (26要素):
//    [bias, reason, remain, quality, direction, upperSlopeATR, lowerSlopeATR, widthStart, widthNow,
//     contractionRatio, patternBars, upP1P, upP1T, upP2P, upP2T, loP1P, loP1T, loP2P, loP2T,
//     upperLineNow, lowerLineNow, breakPrice, breakTime, rejectionCode, upBreakP, loBreakP]
//    reason / direction : 1 = Bull Wedge Upper Break / -1 = Bear Wedge Lower Break / 0 = なし
// ============================================================

// x2==x1 を避けたライン価格 / 傾き
f_wedgeEnvLinePrice(int _x1, float _y1, int _x2, float _y2, int _xNow) =>
    float _res = na
    if _x2 != _x1
        float _slope = (_y2 - _y1) / (_x2 - _x1)
        _res := _y1 + _slope * (_xNow - _x1)
    _res

f_wedgeEnvSlope(int _x1, float _y1, int _x2, float _y2) =>
    _x2 != _x1 ? (_y2 - _y1) / (_x2 - _x1) : na

// Pivotを時系列で保持 (同一付近ノイズのみ除外・極端値への単純上書きはしない)。上限超は最古削除。
f_wedgeEnvPush(array<float> _p, array<int> _b, array<int> _t, float _price, int _bar, int _time, float _atr) =>
    int _n = array.size(_p)
    if _n == 0
        array.push(_p, _price)
        array.push(_b, _bar)
        array.push(_t, _time)
    else
        float _last = array.get(_p, _n - 1)
        if math.abs(_price - _last) >= _atr * wedgeEnvNoiseATR
            array.push(_p, _price)
            array.push(_b, _bar)
            array.push(_t, _time)
    while array.size(_p) > wedgeEnvMaxPivots
        array.shift(_p)
        array.shift(_b)
        array.shift(_t)

// 1候補のスコア (0-100)。呼び出し側で touch/err を集計して渡す。
f_wedgeEnvScore(int _touchHi, int _touchLo, float _avgErr, float _atr, float _wStart, float _wNow, int _patBars) =>
    float _touchPts = math.min(20.0, (_touchHi + _touchLo) * 4.0)
    float _errPts = _atr > 0 ? math.max(0.0, 20.0 - (_avgErr / _atr) * 20.0) : 0.0
    float _ratio = (not na(_wStart) and _wStart > 0 and not na(_wNow)) ? _wNow / _wStart : 1.0
    float _contrPts = math.min(25.0, math.max(0.0, (1.0 - _ratio) / math.max(1.0 - wedgeEnvContractionRatio, 0.01) * 25.0))
    float _mid = (wedgeEnvMinPatternBars + wedgeEnvMaxPatternBars) / 2.0
    float _barPts = _mid > 0 ? math.max(0.0, 15.0 * (1.0 - math.abs(_patBars - _mid) / _mid)) : 0.0
    float _crossPts = math.min(20.0, math.max(0.0, (1.0 - _ratio) * 20.0))
    math.min(100.0, _touchPts + _errPts + _contrPts + _barPts + _crossPts)

f_wedgeEnvState(int holdBars) =>
    float _atr = ta.atr(14)
    float _atrAvg = ta.sma(_atr, wedgeEnvAtrExpandLen)
    // --- Pivot配列 (High / Low を別々に) ---
    var array<float> _phP = array.new_float()
    var array<int>   _phB = array.new_int()
    var array<int>   _phT = array.new_int()
    var array<float> _plP = array.new_float()
    var array<int>   _plB = array.new_int()
    var array<int>   _plT = array.new_int()
    float _ph = ta.pivothigh(high, wedgeEnvPivotLen, wedgeEnvPivotLen)
    float _pl = ta.pivotlow(low, wedgeEnvPivotLen, wedgeEnvPivotLen)
    bool _newHigh = not na(_ph)
    bool _newLow  = not na(_pl)
    if _newHigh
        f_wedgeEnvPush(_phP, _phB, _phT, _ph, bar_index - wedgeEnvPivotLen, time[wedgeEnvPivotLen], _atr)
    if _newLow
        f_wedgeEnvPush(_plP, _plB, _plT, _pl, bar_index - wedgeEnvPivotLen, time[wedgeEnvPivotLen], _atr)

    // --- ベア候補 (Rising Wedge) 状態 ---
    var bool  _bearActive = false
    var bool  _bearBroken = false
    var float _bearUpP1 = na
    var int   _bearUpB1 = na
    var int   _bearUpT1 = na
    var float _bearUpP2 = na
    var int   _bearUpB2 = na
    var int   _bearUpT2 = na
    var float _bearLoP1 = na
    var int   _bearLoB1 = na
    var int   _bearLoT1 = na
    var float _bearLoP2 = na
    var int   _bearLoB2 = na
    var int   _bearLoT2 = na
    var float _bearUpSlope = na
    var float _bearLoSlope = na
    var float _bearWStart = na
    var int   _bearFormBar = na
    var float _bearQual = na
    var int   _bearPatBars = 0
    // --- ブル候補 (Falling Wedge) 状態 ---
    var bool  _bullActive = false
    var bool  _bullBroken = false
    var float _bullUpP1 = na
    var int   _bullUpB1 = na
    var int   _bullUpT1 = na
    var float _bullUpP2 = na
    var int   _bullUpB2 = na
    var int   _bullUpT2 = na
    var float _bullLoP1 = na
    var int   _bullLoB1 = na
    var int   _bullLoT1 = na
    var float _bullLoP2 = na
    var int   _bullLoB2 = na
    var int   _bullLoT2 = na
    var float _bullUpSlope = na
    var float _bullLoSlope = na
    var float _bullWStart = na
    var int   _bullFormBar = na
    var float _bullQual = na
    var int   _bullPatBars = 0
    // --- バイアス保持 状態 ---
    var int   _bias = 0
    var int   _reason = 0
    var int   _evbar = na
    // --- 最新確定パターン アンカー (描画用・確定後も保持) ---
    var int   _oDir = 0
    var float _oUpP1 = na
    var int   _oUpT1 = na
    var float _oUpP2 = na
    var int   _oUpT2 = na
    var float _oLoP1 = na
    var int   _oLoT1 = na
    var float _oLoP2 = na
    var int   _oLoT2 = na
    var float _oBreakP = na
    var int   _oBreakT = na
    var float _oUpBrkP = na
    var float _oLoBrkP = na
    var float _oQuality = na
    var float _oUpSlopeATR = na
    var float _oLoSlopeATR = na
    var float _oWStart = na
    var float _oWNow = na
    var float _oContraction = na
    var int   _oPatBars = 0
    int _rej = 0

    int _nH = array.size(_phP)
    int _nL = array.size(_plP)
    float _touchTol = _atr * wedgeEnvTouchToleranceATR

    // --- 候補探索 (新しいPivotが出た時のみ・右端は最新の高値/安値) ---
    if (_newHigh or _newLow) and _nH >= 2 and _nL >= 2
        int   _kH = _nH - 1
        int   _kL = _nL - 1
        float _h2 = array.get(_phP, _kH)
        int   _h2b = array.get(_phB, _kH)
        int   _h2t = array.get(_phT, _kH)
        float _l2 = array.get(_plP, _kL)
        int   _l2b = array.get(_plB, _kL)
        int   _l2t = array.get(_plT, _kL)
        float _bestBear = na
        float _bestBull = na
        for _i = 0 to _kH - 1
            float _h1 = array.get(_phP, _i)
            int   _h1b = array.get(_phB, _i)
            int   _h1t = array.get(_phT, _i)
            for _a = 0 to _kL - 1
                float _l1 = array.get(_plP, _a)
                int   _l1b = array.get(_plB, _a)
                int   _l1t = array.get(_plT, _a)
                float _upSlope = f_wedgeEnvSlope(_h1b, _h1, _h2b, _h2)
                float _loSlope = f_wedgeEnvSlope(_l1b, _l1, _l2b, _l2)
                if not na(_upSlope) and not na(_loSlope)
                    // Rising(ベア): 両方上昇・安値傾き>高値傾き / Falling(ブル): 両方下降・高値傾き<安値傾き
                    bool _isBear = _upSlope > 0 and _loSlope > 0 and _loSlope > _upSlope
                    bool _isBull = _upSlope < 0 and _loSlope < 0 and _upSlope < _loSlope
                    if _isBear or _isBull
                        int _startX = math.min(_h1b, _l1b)
                        int _rightX = math.max(_h2b, _l2b)
                        float _upStart = f_wedgeEnvLinePrice(_h1b, _h1, _h2b, _h2, _startX)
                        float _loStart = f_wedgeEnvLinePrice(_l1b, _l1, _l2b, _l2, _startX)
                        float _upNow = f_wedgeEnvLinePrice(_h1b, _h1, _h2b, _h2, bar_index)
                        float _loNow = f_wedgeEnvLinePrice(_l1b, _l1, _l2b, _l2, bar_index)
                        float _wStart = (not na(_upStart) and not na(_loStart)) ? _upStart - _loStart : na
                        float _wNow   = (not na(_upNow) and not na(_loNow)) ? _upNow - _loNow : na
                        int   _patBars = _rightX - _startX
                        float _upSlopeATR = _atr > 0 ? _upSlope / _atr : na
                        float _loSlopeATR = _atr > 0 ? _loSlope / _atr : na
                        bool _slopeOk = not na(_upSlopeATR) and not na(_loSlopeATR) and math.abs(_upSlopeATR) >= wedgeEnvMinSlopeATR and math.abs(_upSlopeATR) <= wedgeEnvMaxSlopeATR and math.abs(_loSlopeATR) >= wedgeEnvMinSlopeATR and math.abs(_loSlopeATR) <= wedgeEnvMaxSlopeATR
                        bool _widthOk = not na(_wStart) and not na(_wNow) and _wStart > 0 and _wNow > 0 and _wNow <= _wStart * wedgeEnvContractionRatio
                        bool _barsOk = _patBars >= wedgeEnvMinPatternBars and _patBars <= wedgeEnvMaxPatternBars
                        if _slopeOk and _widthOk and _barsOk
                            // タッチ数 / ラインからの誤差
                            int _touchHi = 0
                            float _errHiSum = 0.0
                            for _m = 0 to _nH - 1
                                int _mb = array.get(_phB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_wedgeEnvLinePrice(_h1b, _h1, _h2b, _h2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_phP, _m) - _lv)
                                        _errHiSum += _e
                                        if _e <= _touchTol
                                            _touchHi += 1
                            int _touchLo = 0
                            float _errLoSum = 0.0
                            for _m = 0 to _nL - 1
                                int _mb = array.get(_plB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_wedgeEnvLinePrice(_l1b, _l1, _l2b, _l2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_plP, _m) - _lv)
                                        _errLoSum += _e
                                        if _e <= _touchTol
                                            _touchLo += 1
                            bool _touchOk = _touchHi >= wedgeEnvMinTouches and _touchLo >= wedgeEnvMinTouches
                            float _avgErr = (_errHiSum + _errLoSum) / math.max(_touchHi + _touchLo, 1)
                            float _score = f_wedgeEnvScore(_touchHi, _touchLo, _avgErr, _atr, _wStart, _wNow, _patBars)
                            if _touchOk
                                if _isBear and (na(_bestBear) or _score > _bestBear)
                                    _bestBear := _score
                                    _bearActive := true
                                    _bearBroken := false
                                    _bearUpP1 := _h1
                                    _bearUpB1 := _h1b
                                    _bearUpT1 := _h1t
                                    _bearUpP2 := _h2
                                    _bearUpB2 := _h2b
                                    _bearUpT2 := _h2t
                                    _bearLoP1 := _l1
                                    _bearLoB1 := _l1b
                                    _bearLoT1 := _l1t
                                    _bearLoP2 := _l2
                                    _bearLoB2 := _l2b
                                    _bearLoT2 := _l2t
                                    _bearUpSlope := _upSlope
                                    _bearLoSlope := _loSlope
                                    _bearWStart := _wStart
                                    _bearFormBar := bar_index
                                    _bearQual := _score
                                    _bearPatBars := _patBars
                                if _isBull and (na(_bestBull) or _score > _bestBull)
                                    _bestBull := _score
                                    _bullActive := true
                                    _bullBroken := false
                                    _bullUpP1 := _h1
                                    _bullUpB1 := _h1b
                                    _bullUpT1 := _h1t
                                    _bullUpP2 := _h2
                                    _bullUpB2 := _h2b
                                    _bullUpT2 := _h2t
                                    _bullLoP1 := _l1
                                    _bullLoB1 := _l1b
                                    _bullLoT1 := _l1t
                                    _bullLoP2 := _l2
                                    _bullLoB2 := _l2b
                                    _bullLoT2 := _l2t
                                    _bullUpSlope := _upSlope
                                    _bullLoSlope := _loSlope
                                    _bullWStart := _wStart
                                    _bullFormBar := bar_index
                                    _bullQual := _score
                                    _bullPatBars := _patBars

    // 品質フィルター (採用候補が品質未満なら候補を無効化)
    if _bearActive and useWedgeEnvQualityFilter and not na(_bearQual) and _bearQual < wedgeEnvMinQuality
        _bearActive := false
        _rej := 5
    if _bullActive and useWedgeEnvQualityFilter and not na(_bullQual) and _bullQual < wedgeEnvMinQuality
        _bullActive := false
        _rej := 5

    // --- 各候補を現在バーへ延長 ---
    float _bearUpNow = _bearActive ? f_wedgeEnvLinePrice(_bearUpB1, _bearUpP1, _bearUpB2, _bearUpP2, bar_index) : na
    float _bearLoNow = _bearActive ? f_wedgeEnvLinePrice(_bearLoB1, _bearLoP1, _bearLoB2, _bearLoP2, bar_index) : na
    float _bearWNow = (not na(_bearUpNow) and not na(_bearLoNow)) ? _bearUpNow - _bearLoNow : na
    float _bullUpNow = _bullActive ? f_wedgeEnvLinePrice(_bullUpB1, _bullUpP1, _bullUpB2, _bullUpP2, bar_index) : na
    float _bullLoNow = _bullActive ? f_wedgeEnvLinePrice(_bullLoB1, _bullLoP1, _bullLoB2, _bullLoP2, bar_index) : na
    float _bullWNow = (not na(_bullUpNow) and not na(_bullLoNow)) ? _bullUpNow - _bullLoNow : na

    // --- ブレイク足フィルター ---
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool  _bodyOk = not useWedgeEnvBodyFilter or (_rng > 0 and (_body / _rng) >= wedgeEnvMinBodyRatio)
    bool  _volOk  = not useWedgeEnvVolExpansion or (not na(_atrAvg) and _atr > _atrAvg * wedgeEnvAtrExpandMult)
    bool  _bearColorOk = not useWedgeEnvBreakCandleColor or close < open
    bool  _bullColorOk = not useWedgeEnvBreakCandleColor or close > open

    // --- ベア候補: 交差失効 / 期限切れ / 下限下抜け ---
    bool _bearLinesValidNow = not na(_bearUpNow) and not na(_bearLoNow) and not na(_bearWNow) and _bearWNow > 0 and _bearUpNow > _bearLoNow
    bool _bearConfirm = false
    if _bearActive and not _bearBroken
        if not _bearLinesValidNow
            _bearActive := false
            _rej := 4
        else if not na(_bearFormBar) and (bar_index - _bearFormBar) > wedgeEnvBreakMaxBars
            _bearActive := false
            _rej := 3
        else if close < _bearLoNow - _atr * wedgeEnvBreakBufferATR and _bodyOk and _bearColorOk and _volOk
            _bearConfirm := true
            _bearBroken := true

    // --- ブル候補: 交差失効 / 期限切れ / 上限上抜け ---
    bool _bullLinesValidNow = not na(_bullUpNow) and not na(_bullLoNow) and not na(_bullWNow) and _bullWNow > 0 and _bullUpNow > _bullLoNow
    bool _bullConfirm = false
    if _bullActive and not _bullBroken
        if not _bullLinesValidNow
            _bullActive := false
            _rej := 4
        else if not na(_bullFormBar) and (bar_index - _bullFormBar) > wedgeEnvBreakMaxBars
            _bullActive := false
            _rej := 3
        else if close > _bullUpNow + _atr * wedgeEnvBreakBufferATR and _bodyOk and _bullColorOk and _volOk
            _bullConfirm := true
            _bullBroken := true

    // --- イベント確定 (同一バー両方 → Even / ベア → Short / ブル → Long) ---
    if _bearConfirm and _bullConfirm
        _bias := 0
        _reason := 0
        _evbar := na
        _rej := 1
    else if _bearConfirm
        _bias := -1
        _reason := -1
        _evbar := bar_index
        _oDir := -1
        _oUpP1 := _bearUpP1
        _oUpT1 := _bearUpT1
        _oUpP2 := _bearUpP2
        _oUpT2 := _bearUpT2
        _oLoP1 := _bearLoP1
        _oLoT1 := _bearLoT1
        _oLoP2 := _bearLoP2
        _oLoT2 := _bearLoT2
        _oBreakP := close
        _oBreakT := time
        _oUpBrkP := _bearUpNow
        _oLoBrkP := _bearLoNow
        _oQuality := _bearQual
        _oUpSlopeATR := _atr > 0 and not na(_bearUpSlope) ? _bearUpSlope / _atr : na
        _oLoSlopeATR := _atr > 0 and not na(_bearLoSlope) ? _bearLoSlope / _atr : na
        _oWStart := _bearWStart
        _oWNow := _bearWNow
        _oContraction := (not na(_bearWStart) and _bearWStart > 0 and not na(_bearWNow)) ? _bearWNow / _bearWStart : na
        _oPatBars := _bearPatBars
    else if _bullConfirm
        _bias := 1
        _reason := 1
        _evbar := bar_index
        _oDir := 1
        _oUpP1 := _bullUpP1
        _oUpT1 := _bullUpT1
        _oUpP2 := _bullUpP2
        _oUpT2 := _bullUpT2
        _oLoP1 := _bullLoP1
        _oLoT1 := _bullLoT1
        _oLoP2 := _bullLoP2
        _oLoT2 := _bullLoT2
        _oBreakP := close
        _oBreakT := time
        _oUpBrkP := _bullUpNow
        _oLoBrkP := _bullLoNow
        _oQuality := _bullQual
        _oUpSlopeATR := _atr > 0 and not na(_bullUpSlope) ? _bullUpSlope / _atr : na
        _oLoSlopeATR := _atr > 0 and not na(_bullLoSlope) ? _bullLoSlope / _atr : na
        _oWStart := _bullWStart
        _oWNow := _bullWNow
        _oContraction := (not na(_bullWStart) and _bullWStart > 0 and not na(_bullWNow)) ? _bullWNow / _bullWStart : na
        _oPatBars := _bullPatBars

    // 現在の代表ライン (held方向 → 該当候補、無ければベア→ブルの順で active を採用)
    float _upperLineNow = _bearActive ? _bearUpNow : _bullActive ? _bullUpNow : na
    float _lowerLineNow = _bearActive ? _bearLoNow : _bullActive ? _bullLoNow : na

    // --- 状態保持 / 失効 (イベント足を1本目として数える) ---
    bool _hold = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias   = _hold ? _bias : 0
    int _outReason = _hold ? _reason : 0
    int _outRemain = _hold ? holdBars - (bar_index - _evbar) : 0
    int _outDir    = _hold ? _oDir : 0
    [_outBias, _outReason, _outRemain, _oQuality, _outDir, _oUpSlopeATR, _oLoSlopeATR, _oWStart, _oWNow, _oContraction, _oPatBars, _oUpP1, _oUpT1, _oUpP2, _oUpT2, _oLoP1, _oLoT1, _oLoP2, _oLoT2, _upperLineNow, _lowerLineNow, _oBreakP, _oBreakT, _rej, _oUpBrkP, _oLoBrkP]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_wedgeEnvConfirmed(int holdBars) =>
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = f_wedgeEnvState(holdBars)
    [_b[1], _r[1], _rem[1], _q[1], _dir[1], _us[1], _ls[1], _ws[1], _wn[1], _cr[1], _pb[1], _up1p[1], _up1t[1], _up2p[1], _up2t[1], _lo1p[1], _lo1t[1], _lo2p[1], _lo2t[1], _uln[1], _lln[1], _bp[1], _bt[1], _rj[1], _ubp[1], _lbp[1]]

// --- テキスト / カラー (双方向) ---
f_wedgeEnvText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_wedgeEnvReasonText(int c) =>
    c == 1 ? "Bull Break" : c == -1 ? "Bear Break" : "No Break"
f_wedgeEnvColor(int b, bool on) =>
    not on ? color.new(color.black, 0) : b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- 各足の確定 ウェッジ 環境状態 (使用 or 表示時のみ算出。OFF足は request.security を呼ばない) ---
bool wedgeEnvWantDraw = wedgeEnvShowPatternLines or wedgeEnvShowPivotLabels or wedgeEnvShowBreakLabel or wedgeEnvShowHistory
bool wedgeEnvCompute  = useWedgeEnvEnv and (useWedgeEnvBias or wedgeEnvShowTable or wedgeEnvWantDraw)
int wedgeEnvD   = 0
int wedgeEnv4H  = 0
int wedgeEnv1H  = 0
int wedgeEnv15M = 0
int wedgeEnv5M  = 0
int wedgeEnv1M  = 0
int wedgeEnvDRem   = 0
int wedgeEnv4HRem  = 0
int wedgeEnv1HRem  = 0
int wedgeEnv15MRem = 0
int wedgeEnv5MRem  = 0
int wedgeEnv1MRem  = 0
int wedgeEnvDReason   = 0
int wedgeEnv4HReason  = 0
int wedgeEnv1HReason  = 0
int wedgeEnv15MReason = 0
int wedgeEnv5MReason  = 0
int wedgeEnv1MReason  = 0
float wedgeEnvDQual   = na
float wedgeEnv4HQual  = na
float wedgeEnv1HQual  = na
float wedgeEnv15MQual = na
float wedgeEnv5MQual  = na
float wedgeEnv1MQual  = na
// ラベル描画用 (wedgeEnvLabelTF の足のパターンアンカー + デバッグ値)
int   weLblDir = 0
float weLblUpP1 = na
int   weLblUpT1 = na
float weLblUpP2 = na
int   weLblUpT2 = na
float weLblLoP1 = na
int   weLblLoT1 = na
float weLblLoP2 = na
int   weLblLoT2 = na
float weLblBrkP = na
int   weLblBrkT = na
float weLblUpBrkP = na
float weLblLoBrkP = na
int   weLblReason = 0
float weLblQual = na
float weLblUpSlopeATR = na
float weLblLoSlopeATR = na
float weLblWStart = na
float weLblWNow = na
float weLblContraction = na
int   weLblPatBars = 0
int   weLblRej = 0

if wedgeEnvCompute and useWedgeEnvD
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, wedgeEnvDailyTF, f_wedgeEnvConfirmed(wedgeEnvHoldDaily), lookahead = barmerge.lookahead_on)
    wedgeEnvD := _b
    wedgeEnvDRem := _rem
    wedgeEnvDReason := _r
    wedgeEnvDQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "D"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj
if wedgeEnvCompute and useWedgeEnv4H
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, wedgeEnv4HTF, f_wedgeEnvConfirmed(wedgeEnvHold4H), lookahead = barmerge.lookahead_on)
    wedgeEnv4H := _b
    wedgeEnv4HRem := _rem
    wedgeEnv4HReason := _r
    wedgeEnv4HQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "4H"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj
if wedgeEnvCompute and useWedgeEnv1H
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, wedgeEnv1HTF, f_wedgeEnvConfirmed(wedgeEnvHold1H), lookahead = barmerge.lookahead_on)
    wedgeEnv1H := _b
    wedgeEnv1HRem := _rem
    wedgeEnv1HReason := _r
    wedgeEnv1HQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "1H"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj
if wedgeEnvCompute and useWedgeEnv15M
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, wedgeEnv15MTF, f_wedgeEnvConfirmed(wedgeEnvHold15M), lookahead = barmerge.lookahead_on)
    wedgeEnv15M := _b
    wedgeEnv15MRem := _rem
    wedgeEnv15MReason := _r
    wedgeEnv15MQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "15M"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj
if wedgeEnvCompute and useWedgeEnv5M
    // 5分足はチャート足そのもの → request.security / f_wedgeEnvConfirmed / [1] を使わず
    //   f_wedgeEnvState をチャート上で直接計算する。最終エントリーの barstate.isconfirmed で
    //   「確定した現在の5分足」の状態を採用するため、1本余計に遅れない。
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = f_wedgeEnvState(wedgeEnvHold5M)
    wedgeEnv5M := _b
    wedgeEnv5MRem := _rem
    wedgeEnv5MReason := _r
    wedgeEnv5MQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "5M"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj
if wedgeEnvCompute and useWedgeEnv1M
    [_b, _r, _rem, _q, _dir, _us, _ls, _ws, _wn, _cr, _pb, _up1p, _up1t, _up2p, _up2t, _lo1p, _lo1t, _lo2p, _lo2t, _uln, _lln, _bp, _bt, _rj, _ubp, _lbp] = request.security(syminfo.tickerid, wedgeEnv1MTF, f_wedgeEnvConfirmed(wedgeEnvHold1M), lookahead = barmerge.lookahead_on)
    wedgeEnv1M := _b
    wedgeEnv1MRem := _rem
    wedgeEnv1MReason := _r
    wedgeEnv1MQual := _q
    if wedgeEnvWantDraw and wedgeEnvLabelTF == "1M"
        weLblDir := _dir
        weLblUpP1 := _up1p
        weLblUpT1 := _up1t
        weLblUpP2 := _up2p
        weLblUpT2 := _up2t
        weLblLoP1 := _lo1p
        weLblLoT1 := _lo1t
        weLblLoP2 := _lo2p
        weLblLoT2 := _lo2t
        weLblBrkP := _bp
        weLblBrkT := _bt
        weLblUpBrkP := _ubp
        weLblLoBrkP := _lbp
        weLblReason := _r
        weLblQual := _q
        weLblUpSlopeATR := _us
        weLblLoSlopeATR := _ls
        weLblWStart := _ws
        weLblWNow := _wn
        weLblContraction := _cr
        weLblPatBars := _pb
        weLblRej := _rj

// --- 統合 (HigherTF: 上位足優先で最初の非ゼロ / WeightedScore: 重み合計を閾値判定・双方向) ---
//   各足の bias は 1(Long) / 0(Even) / -1(Short)。
int wedgeEnvHigherTF =
     (useWedgeEnvD   and wedgeEnvD   != 0) ? wedgeEnvD   :
     (useWedgeEnv4H  and wedgeEnv4H  != 0) ? wedgeEnv4H  :
     (useWedgeEnv1H  and wedgeEnv1H  != 0) ? wedgeEnv1H  :
     (useWedgeEnv15M and wedgeEnv15M != 0) ? wedgeEnv15M :
     (useWedgeEnv5M  and wedgeEnv5M  != 0) ? wedgeEnv5M  :
     (useWedgeEnv1M  and wedgeEnv1M  != 0) ? wedgeEnv1M  : 0
int wedgeEnvScoreVal = (useWedgeEnvD ? wedgeEnvWeightD * wedgeEnvD : 0) + (useWedgeEnv4H ? wedgeEnvWeight4H * wedgeEnv4H : 0) + (useWedgeEnv1H ? wedgeEnvWeight1H * wedgeEnv1H : 0) + (useWedgeEnv15M ? wedgeEnvWeight15M * wedgeEnv15M : 0) + (useWedgeEnv5M ? wedgeEnvWeight5M * wedgeEnv5M : 0) + (useWedgeEnv1M ? wedgeEnvWeight1M * wedgeEnv1M : 0)
int wedgeEnvWeighted = wedgeEnvScoreVal >= wedgeEnvScoreThreshold ? 1 : wedgeEnvScoreVal <= -wedgeEnvScoreThreshold ? -1 : 0
int wedgeEnvBias = not useWedgeEnvEnv ? 0 : wedgeEnvCombineMode == "HigherTF" ? wedgeEnvHigherTF : wedgeEnvWeighted

// --- トレンド環境 (EMAスコア) と ウェッジ環境 の結合 (方向別に明示) ---
//   useWedgeEnvBias=OFF or useWedgeEnvEnv=OFF → 完全素通し (既存=トレンドのみ)。
//   TrendOnly    : Long=trendLongOk        / Short=trendShortOk
//   WedgeOnly    : Long=weLong             / Short=weShort
//   TrendAndWedge: Long=trendLongOk and weLong  / Short=trendShortOk and weShort
//   TrendOrWedge : Long=trendLongOk or  weLong  / Short=trendShortOk or  weShort
bool wedgeEnvActive = useWedgeEnvEnv and useWedgeEnvBias
bool weLong  = wedgeEnvBias == 1
bool weShort = wedgeEnvBias == -1
bool finalEnvLongOk =
     not wedgeEnvActive ? trendLongOk :
     wedgeEnvTrendCombineMode == "TrendOnly"     ? trendLongOk :
     wedgeEnvTrendCombineMode == "WedgeOnly"     ? weLong :
     wedgeEnvTrendCombineMode == "TrendAndWedge" ? (trendLongOk and weLong) :
     wedgeEnvTrendCombineMode == "TrendOrWedge"  ? (trendLongOk or weLong) :
     trendLongOk
bool finalEnvShortOk =
     not wedgeEnvActive ? trendShortOk :
     wedgeEnvTrendCombineMode == "TrendOnly"     ? trendShortOk :
     wedgeEnvTrendCombineMode == "WedgeOnly"     ? weShort :
     wedgeEnvTrendCombineMode == "TrendAndWedge" ? (trendShortOk and weShort) :
     wedgeEnvTrendCombineMode == "TrendOrWedge"  ? (trendShortOk or weShort) :
     trendShortOk
// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// --- ①② 可変 SL/TP 用 ATR (チャート足・エントリーは確定足のみ=非リペイント) ---
float slAtr = ta.atr(slAtrLen)
float tpAtr = ta.atr(tpAtrLen)

float longStop = slMode == "ATR" ? entryEst - slAtr * slAtrMult : slMode == "パターン" ? patLow - slBuf : entryEst - slFixed
float longRisk = entryEst - longStop
float longTP   = tpMode == "ATR" ? entryEst + tpAtr * tpAtrMult : entryEst + longRisk * rrRatio

float shortStop = slMode == "ATR" ? entryEst + slAtr * slAtrMult : slMode == "パターン" ? patHigh + slBuf : entryEst + slFixed
float shortRisk = shortStop - entryEst
float shortTP   = tpMode == "ATR" ? entryEst - tpAtr * tpAtrMult : entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + ウェッジ)
// ------------------------------------------------------------
//  環境認識は finalEnvLongOk/finalEnvShortOk (EMAトレンド + ウェッジ の結合結果)。
//  FVG / EMA / Stochastic / Fib / Volume / 三尊 / DT/DB の各環境認識は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。ウェッジ方向フィルターは主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if noTriggerMode
        shortArmed := false

// ============================================================
//  12d. ウェッジ 環境認識 表示 (テーブル + パターン描画 + Data Window)
// ============================================================
f_weRowReason(bool _on, int _reason) =>
    _on ? f_wedgeEnvReasonText(_reason) : "OFF"
f_weRowQual(bool _on, float _q) =>
    _on and not na(_q) ? str.tostring(_q, "#") : "-"

var table wedgeEnvTbl = na
if wedgeEnvShowTable
    if na(wedgeEnvTbl)
        wedgeEnvTbl := table.new(position.bottom_left, 5, 17, border_width = 1)
    if barstate.islast
        table.cell(wedgeEnvTbl, 0, 0, "Wedge",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 0, "Bias",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 0, "Reason", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 0, "残",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 0, "Qual",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 1, useWedgeEnvD ? f_wedgeEnvText(wedgeEnvD) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnvD, useWedgeEnvD), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 1, f_weRowReason(useWedgeEnvD, wedgeEnvDReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 1, useWedgeEnvD ? str.tostring(wedgeEnvDRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 1, f_weRowQual(useWedgeEnvD, wedgeEnvDQual), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 2, useWedgeEnv4H ? f_wedgeEnvText(wedgeEnv4H) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnv4H, useWedgeEnv4H), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 2, f_weRowReason(useWedgeEnv4H, wedgeEnv4HReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 2, useWedgeEnv4H ? str.tostring(wedgeEnv4HRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 2, f_weRowQual(useWedgeEnv4H, wedgeEnv4HQual), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 3, useWedgeEnv1H ? f_wedgeEnvText(wedgeEnv1H) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnv1H, useWedgeEnv1H), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 3, f_weRowReason(useWedgeEnv1H, wedgeEnv1HReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 3, useWedgeEnv1H ? str.tostring(wedgeEnv1HRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 3, f_weRowQual(useWedgeEnv1H, wedgeEnv1HQual), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 4, useWedgeEnv15M ? f_wedgeEnvText(wedgeEnv15M) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnv15M, useWedgeEnv15M), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 4, f_weRowReason(useWedgeEnv15M, wedgeEnv15MReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 4, useWedgeEnv15M ? str.tostring(wedgeEnv15MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 4, f_weRowQual(useWedgeEnv15M, wedgeEnv15MQual), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 5, useWedgeEnv5M ? f_wedgeEnvText(wedgeEnv5M) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnv5M, useWedgeEnv5M), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 5, f_weRowReason(useWedgeEnv5M, wedgeEnv5MReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 5, useWedgeEnv5M ? str.tostring(wedgeEnv5MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 5, f_weRowQual(useWedgeEnv5M, wedgeEnv5MQual), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 6, useWedgeEnv1M ? f_wedgeEnvText(wedgeEnv1M) : "OFF", text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnv1M, useWedgeEnv1M), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 6, f_weRowReason(useWedgeEnv1M, wedgeEnv1MReason), text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 6, useWedgeEnv1M ? str.tostring(wedgeEnv1MRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 6, f_weRowQual(useWedgeEnv1M, wedgeEnv1MQual), text_color = color.white, text_size = size.small)
        // 統合 Bias
        table.cell(wedgeEnvTbl, 0, 7, "COMBINED", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 7, f_wedgeEnvText(wedgeEnvBias), text_color = color.white, bgcolor = f_wedgeEnvColor(wedgeEnvBias, useWedgeEnvEnv), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 7, wedgeEnvCombineMode == "HigherTF" ? "HTF" : "WScore", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 7, "Sc", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 7, str.tostring(wedgeEnvScoreVal), text_color = color.white, text_size = size.small)
        // 結合方式
        table.cell(wedgeEnvTbl, 0, 8, "TrendComb", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 8, wedgeEnvTrendCombineMode, text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 8, useWedgeEnvBias ? "Bias:ON" : "Bias:OFF", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 8, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 8, "", text_color = color.white, text_size = size.small)
        // 最終許可
        table.cell(wedgeEnvTbl, 0, 9, "Final Long", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 9, finalEnvLongOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvLongOk ? color.new(color.green, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 9, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 9, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 9, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 0, 10, "Final Short", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 1, 10, finalEnvShortOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvShortOk ? color.new(color.red, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(wedgeEnvTbl, 2, 10, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 3, 10, "", text_color = color.white, text_size = size.small)
        table.cell(wedgeEnvTbl, 4, 10, "", text_color = color.white, text_size = size.small)
        // デバッグ (wedgeEnvLabelTF の採用パターン値)
        if wedgeEnvShowDebug
            table.cell(wedgeEnvTbl, 0, 11, "UpSlopeATR", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 11, na(weLblUpSlopeATR) ? "-" : str.tostring(weLblUpSlopeATR, "#.###"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 11, "LoSlopeATR", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 11, na(weLblLoSlopeATR) ? "-" : str.tostring(weLblLoSlopeATR, "#.###"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 11, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 0, 12, "Contract", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 12, na(weLblContraction) ? "-" : str.tostring(weLblContraction, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 12, "PatBars", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 12, str.tostring(weLblPatBars), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 12, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 0, 13, "WidthStart", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 13, na(weLblWStart) ? "-" : str.tostring(weLblWStart, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 13, "WidthNow", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 13, na(weLblWNow) ? "-" : str.tostring(weLblWNow, "#.##"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 13, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 0, 14, "Quality", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 14, na(weLblQual) ? "-" : str.tostring(weLblQual, "#"), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 14, "RejCode", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 14, str.tostring(weLblRej), text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 14, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 0, 15, "LabelTF/Dir", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 15, weLblDir == 1 ? "Bull" : weLblDir == -1 ? "Bear" : "-", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 15, wedgeEnvLabelTF, text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 15, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 15, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 0, 16, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 1, 16, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 2, 16, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 3, 16, "", text_color = color.white, text_size = size.small)
            table.cell(wedgeEnvTbl, 4, 16, "", text_color = color.white, text_size = size.small)

// --- Data Window 出力 ---
plot(useWedgeEnvEnv ? wedgeEnvScoreVal : na, "wedgeEnvScore", display = display.data_window)
plot(useWedgeEnvEnv ? wedgeEnvBias : na, "wedgeEnvBias", display = display.data_window)
plot(finalEnvLongOk  ? 1 : 0, "finalEnvLongOk",  display = display.data_window)
plot(finalEnvShortOk ? 1 : 0, "finalEnvShortOk", display = display.data_window)

// --- 採用パターン描画 (wedgeEnvLabelTF・時刻アンカー。表示専用・検知/エントリー不変) ---
//   上限ライン (UpP1→UpBrk) / 下限ライン (LoP1→LoBrk) をブレイク地点まで延長。
//   ベア=下限ブレイク (Bear Wedge Confirmed) / ブル=上限ブレイク (Bull Wedge Confirmed)。
//   line/label は最新パターンだけを更新 (上限を消費しない)。
var line  weLnUpper = na
var line  weLnLower = na
var label weLbUp1   = na
var label weLbUp2   = na
var label weLbLo1   = na
var label weLbLo2   = na
var label weLbBrk   = na

// 最終バーで毎回、既存描画をいったん全削除 → 条件を満たす場合だけ再描画。
//   描画トグルOFF / useWedgeEnvEnv=OFF / 描画対象TFに有効パターンなし の
//   いずれでも古いライン・ラベルが残らない。個別トグルOFFも該当描画だけ消える。
if barstate.islast
    if not na(weLnUpper)
        line.delete(weLnUpper)
        weLnUpper := na
    if not na(weLnLower)
        line.delete(weLnLower)
        weLnLower := na
    if not na(weLbUp1)
        label.delete(weLbUp1)
        weLbUp1 := na
    if not na(weLbUp2)
        label.delete(weLbUp2)
        weLbUp2 := na
    if not na(weLbLo1)
        label.delete(weLbLo1)
        weLbLo1 := na
    if not na(weLbLo2)
        label.delete(weLbLo2)
        weLbLo2 := na
    if not na(weLbBrk)
        label.delete(weLbBrk)
        weLbBrk := na
    bool _weDoDraw = wedgeEnvWantDraw and weLblReason != 0 and not na(weLblUpP1) and not na(weLblLoP1) and not na(weLblBrkT)
    if _weDoDraw
        bool _isBull = weLblDir == 1
        color _upCol = _isBull ? color.new(color.green, 0) : color.new(color.red, 0)
        color _loCol = _isBull ? color.new(color.teal, 0) : color.new(color.orange, 0)
        // ウェッジライン (上限: UpP1 → ブレイク地点 / 下限: LoP1 → ブレイク地点)
        if wedgeEnvShowPatternLines
            if not na(weLblUpBrkP)
                weLnUpper := line.new(weLblUpT1, weLblUpP1, weLblBrkT, weLblUpBrkP, xloc = xloc.bar_time, color = _upCol, width = wedgeEnvPatternLineWidth)
            if not na(weLblLoBrkP)
                weLnLower := line.new(weLblLoT1, weLblLoP1, weLblBrkT, weLblLoBrkP, xloc = xloc.bar_time, color = _loCol, width = wedgeEnvPatternLineWidth)
        // 採用Pivotラベル (H1/H2/L1/L2)
        if wedgeEnvShowPivotLabels
            weLbUp1 := label.new(weLblUpT1, weLblUpP1, "H1", xloc = xloc.bar_time, style = label.style_label_down, yloc = yloc.abovebar, color = _upCol, textcolor = color.white, size = size.small)
            weLbUp2 := label.new(weLblUpT2, weLblUpP2, "H2", xloc = xloc.bar_time, style = label.style_label_down, yloc = yloc.abovebar, color = _upCol, textcolor = color.white, size = size.small)
            weLbLo1 := label.new(weLblLoT1, weLblLoP1, "L1", xloc = xloc.bar_time, style = label.style_label_up, yloc = yloc.belowbar, color = _loCol, textcolor = color.white, size = size.small)
            weLbLo2 := label.new(weLblLoT2, weLblLoP2, "L2", xloc = xloc.bar_time, style = label.style_label_up, yloc = yloc.belowbar, color = _loCol, textcolor = color.white, size = size.small)
        // ブレイク確定ラベル (ブル=上限上抜け上側 / ベア=下限下抜け下側)
        if wedgeEnvShowBreakLabel and not na(weLblBrkP)
            string _bl = _isBull ? "Bull Wedge Confirmed" : "Bear Wedge Confirmed"
            weLbBrk := label.new(weLblBrkT, weLblBrkP, _bl, xloc = xloc.bar_time, style = _isBull ? label.style_label_down : label.style_label_up, yloc = _isBull ? yloc.abovebar : yloc.belowbar, color = _upCol, textcolor = color.white, size = size.small)

// --- 過去パターン履歴表示 (wedgeEnvLabelTF・件数上限。ON/OFF可能) ---
var array<int>   weHistDir   = array.new_int()
var array<float> weHistUpP1  = array.new_float()
var array<int>   weHistUpT1  = array.new_int()
var array<float> weHistUpBrk = array.new_float()
var array<float> weHistLoP1  = array.new_float()
var array<int>   weHistLoT1  = array.new_int()
var array<float> weHistLoBrk = array.new_float()
var array<int>   weHistBrkT  = array.new_int()

bool weHistActive = wedgeEnvShowHistory and wedgeEnvWantDraw
bool weNewBreak =
     weHistActive and
     weLblReason != 0 and
     not na(weLblBrkT) and
     (na(weLblBrkT[1]) or weLblBrkT != weLblBrkT[1])
if weNewBreak
    array.push(weHistDir, weLblDir)
    array.push(weHistUpP1, weLblUpP1)
    array.push(weHistUpT1, weLblUpT1)
    array.push(weHistUpBrk, weLblUpBrkP)
    array.push(weHistLoP1, weLblLoP1)
    array.push(weHistLoT1, weLblLoT1)
    array.push(weHistLoBrk, weLblLoBrkP)
    array.push(weHistBrkT, weLblBrkT)
    while array.size(weHistBrkT) > wedgeEnvHistoryCount
        array.shift(weHistDir)
        array.shift(weHistUpP1)
        array.shift(weHistUpT1)
        array.shift(weHistUpBrk)
        array.shift(weHistLoP1)
        array.shift(weHistLoT1)
        array.shift(weHistLoBrk)
        array.shift(weHistBrkT)

var array<line> weHistLines = array.new_line()
if barstate.islast
    // 既存の履歴ラインを毎回削除 → 履歴表示ONのときだけ再描画 (OFFで消える)。
    if array.size(weHistLines) > 0
        for _i = 0 to array.size(weHistLines) - 1
            line.delete(array.get(weHistLines, _i))
        array.clear(weHistLines)
    if weHistActive and array.size(weHistBrkT) > 0
        for _i = 0 to array.size(weHistBrkT) - 1
            int   _dir = array.get(weHistDir, _i)
            float _up1 = array.get(weHistUpP1, _i)
            int   _ut1 = array.get(weHistUpT1, _i)
            float _ubk = array.get(weHistUpBrk, _i)
            float _lp1 = array.get(weHistLoP1, _i)
            int   _lt1 = array.get(weHistLoT1, _i)
            float _lbk = array.get(weHistLoBrk, _i)
            int   _bkt = array.get(weHistBrkT, _i)
            if not na(_up1) and not na(_lp1) and not na(_bkt)
                color _upHc = _dir == 1 ? color.new(color.green, wedgeEnvHistoryLineTransp) : color.new(color.red, wedgeEnvHistoryLineTransp)
                color _loHc = _dir == 1 ? color.new(color.teal, wedgeEnvHistoryLineTransp) : color.new(color.orange, wedgeEnvHistoryLineTransp)
                if not na(_ubk)
                    array.push(weHistLines, line.new(_ut1, _up1, _bkt, _ubk, xloc = xloc.bar_time, color = _upHc, width = 1))
                if not na(_lbk)
                    array.push(weHistLines, line.new(_lt1, _lp1, _bkt, _lbk, xloc = xloc.bar_time, color = _loHc, width = 1))
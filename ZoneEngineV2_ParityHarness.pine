//
// ============================================================================
//  ZoneEngineV2 Parity Harness  (検証専用 / 本番の Visual Harness とは別ファイル)
// ============================================================================
//  目的
//    公開済みの Version 3 (Phase3A まで) と、Phase3B / 3C で軽量化した新しい
//    バージョンを同じ Feed で同時に回し、出力が 1 つでも違うところが
//    無いことを確かめる。違いがあれば最初に違った足の時刻・項目・
//    旧値・新値を表へ出す。
//
//  ★ このファイルは診断専用。本番の ZoneEngineV2_VisualHarness には
//    この比較コストを一切入れていない。
//    Engine を 2 つ同時に回すため当然 2 倍以上重い。ここだけ calc_bars_count を
//    付けているのは「両方を同じ本数だけ回して照らし合わせる」ためであり、
//    本番 Harness の RE10110 を退けるための手段ではない。本番側へは絶対に入れないこと。
//
//  見方
//    Parity : OK          … 走査した全足で全項目一致
//    Parity : DIFF FOUND  … 一致しなかった。下の行に最初の違いが出る
// ============================================================================

//@version=6
indicator(
     title            = "ZoneEngineV2 Parity Harness",
     shorttitle       = "ZONEv2-PARITY",
     overlay          = false,
     dynamic_requests = true,
     calc_bars_count  = 3000
 )

// ############################################################################
// ##  ★ 差し替え必須 : 比較する 2 つの Library バージョン ★                  ##
// ##                                                                        ##
// ##  vA = 基準 (公開済みの Version 3 / Phase3A まで)                        ##
// ##  vB = 検証対象 (Phase3B / 3C 版を Publish したときの実番号)             ##
// ##                                                                        ##
// ##  下の vB の "/4" は /3 からの連番で入れた仮の値。Publish 直後に       ##
// ##  TradingView が実際に発行した番号を見て、違っていたら直すこと。      ##
// ##  本番 Harness の import 番号と必ず揃える。                              ##
// ##  vA と vB が同じ番号のままだとこのスクリプトは意味を持たない。   ##
// ############################################################################
import sekine3310/ZoneEngineV2/3 as vA          // 基準 : Version 3
import sekine3310/ZoneEngineV2/4 as vB          // ← ★ Publish 後の実番号へ差し替える

// ============================================================================
// 01. INPUTS (本番 Harness と同じ既定値。両 Engine へ同じ値を入れる)
// ============================================================================
var string G_CORE  = "01 · Zone 論理パラメータ"
var string G_CAT   = "02 · カテゴリ ON / OFF"
var string G_TF    = "03 · 時間足"
var string G_ACC   = "04 · Accum 検出"
var string G_TIME  = "05 · セッション / 日 / 週"
var string G_STORE = "06 · 保存上限 / Dormant"

clusterMaxWidth    = input.float(20.0, "M : Zone 全幅の上限 ($)", minval = 0.1, step = 0.5, group = G_CORE)
denseRatio         = input.float(0.50, "DenseRatio (dense 幅 = M × これ)", minval = 0.01, maxval = 1.0, step = 0.05, group = G_CORE)
touchResetDistance = input.float(10.0, "TouchResetDistance ($)", minval = 0.1, step = 0.5, group = G_CORE)
strongUnlimited    = input.bool(false, "StrongUntilTouch = Unlimited", group = G_CORE)
strongUntilTouch   = input.int(1, "StrongUntilTouch", minval = 1, group = G_CORE)
weakFromTouchOff   = input.bool(false, "WeakFromTouch = OFF", group = G_CORE)
weakFromTouch      = input.int(2, "WeakFromTouch", minval = 2, group = G_CORE)
weakDepthOff       = input.bool(false, "WeakDepth = OFF", group = G_CORE)
weakDepthPct       = input.float(50.0, "WeakDepthPct (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_CORE)
breakBuffer        = input.float(2.0, "BreakBuffer ($)", minval = 0.0, step = 0.5, group = G_CORE)
touchTolerance     = input.float(0.0, "TouchTolerance ($ · 一本線 Zone 専用)", minval = 0.0, step = 0.1, group = G_CORE)

useMa    = input.bool(true, "MA 系",          group = G_CAT)
useSwing = input.bool(true, "Swing 系",       group = G_CAT)
useAccum = input.bool(true, "Accum 系",       group = G_CAT)
useTime  = input.bool(true, "時間区切り高安系", group = G_CAT)
useFvg   = input.bool(true, "HTF FVG 系",     group = G_CAT)
usePsych = input.bool(true, "心理価格系",     group = G_CAT)

maTf            = input.timeframe("1", "MA 時間足", group = G_TF)
emaLen1         = input.int(2000, "EMA #1 期間", minval = 1, maxval = 4999, group = G_TF)
emaLen2         = input.int(3000, "EMA #2 期間", minval = 1, maxval = 4999, group = G_TF)
emaSlopeLookback = input.int(60, "EMA 傾き Lookback (1分足本数)", minval = 1, group = G_TF)
swTf1 = input.timeframe("5",  "Swing TF #1", group = G_TF)
swTf2 = input.timeframe("15", "Swing TF #2", group = G_TF)
swTf3 = input.timeframe("60", "Swing TF #3", group = G_TF)
swLen1 = input.int(10, "Swing Pivot Length #1", minval = 1, group = G_TF)
swLen2 = input.int(8,  "Swing Pivot Length #2", minval = 1, group = G_TF)
swLen3 = input.int(6,  "Swing Pivot Length #3", minval = 1, group = G_TF)
accTf1 = input.timeframe("60",  "Accum TF #1", group = G_TF)
accTf2 = input.timeframe("240", "Accum TF #2", group = G_TF)
accTf3 = input.timeframe("D",   "Accum TF #3", group = G_TF)
fvgTf1 = input.timeframe("60",  "FVG TF #1", group = G_TF)
fvgTf2 = input.timeframe("240", "FVG TF #2", group = G_TF)
fvgTf3 = input.timeframe("D",   "FVG TF #3", group = G_TF)

accumRangeLen        = input.int(10,  "Accum 判定レンジ本数", minval = 6, group = G_ACC)
accumBaseLen         = input.int(20,  "Accum 基準本数",      minval = 10, group = G_ACC)
accumAtrLen          = input.int(14,  "Accum ATR 本数",      minval = 1, group = G_ACC)
accumMinUpperCloses  = input.int(4,   "上半分 最低終値本数",  minval = 1, group = G_ACC)
accumMinLowerCloses  = input.int(4,   "下半分 最低終値本数",  minval = 1, group = G_ACC)
accumMaxSameColorRun = input.int(4,   "同色連続上限",        minval = 1, group = G_ACC)
accumAtrMult         = input.float(2.5,  "レンジ幅 / ATR 上限",    minval = 0.1, step = 0.1, group = G_ACC)
accumBarRatioMax     = input.float(0.70, "短期幅 / 基準幅 上限",   minval = 0.1, step = 0.05, group = G_ACC)
accumDriftMax        = input.float(0.30, "ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACC)

zoneTz       = input.string("Asia/Tokyo", "Timezone", group = G_TIME)
dayResetHour = input.int(5,  "日区切り (時)",     minval = 0, maxval = 23, group = G_TIME)
asiaStart    = input.int(9,  "Asia 開始 (時)",    minval = 0, maxval = 23, group = G_TIME)
euStart      = input.int(14, "Europe 開始 (時)",  minval = 0, maxval = 23, group = G_TIME)
nyStart      = input.int(19, "New York 開始 (時)", minval = 0, maxval = 23, group = G_TIME)
nyEnd        = input.int(3,  "New York 終了 (時)", minval = 0, maxval = 23, group = G_TIME)

maxSwingRoots       = input.int(180, "最大 Swing Root 数",   minval = 1, group = G_STORE)
maxAccumBoxes       = input.int(60,  "最大 Accum Box 数",    minval = 1, group = G_STORE)
maxFvgRoots         = input.int(120, "最大 FVG Root 数",     minval = 1, group = G_STORE)
maxTimeRoots        = input.int(32,  "最大 時間高安 Root 数", minval = 1, group = G_STORE)
maxZoneCores        = input.int(80,  "最大 ZoneCore 数",     minval = 1, group = G_STORE)
maxEndedGenerations = input.int(30,  "終了世代の保存数",     minval = 1, group = G_STORE)
maxTouchMarks       = input.int(64,  "Core ごとの TouchMark 上限", minval = 1, group = G_STORE)
dormantDistance     = input.float(500.0, "Dormant 距離 ($)", minval = 1.0, step = 10.0, group = G_STORE)

// ============================================================================
// 02. 両方の ENGINE / CFG (値は 1 つ残らず同じ)
// ============================================================================
var vA.ZoneEngine engA = vA.newEngine()
var vB.ZoneEngine engB = vB.newEngine()
var vA.ZoneCfg    cfgA = vA.newCfg()
var vB.ZoneCfg    cfgB = vB.newCfg()
var bool cfgDone = false
if not cfgDone
    cfgDone := true
    cfgA.clusterMaxWidth      := clusterMaxWidth
    cfgA.denseRatio           := denseRatio
    cfgA.touchResetDistance   := touchResetDistance
    cfgA.strongUntilTouch     := strongUntilTouch
    cfgA.strongUnlimited      := strongUnlimited
    cfgA.weakFromTouch        := weakFromTouch
    cfgA.weakFromTouchOff     := weakFromTouchOff
    cfgA.weakDepthPct         := weakDepthPct
    cfgA.weakDepthOff         := weakDepthOff
    cfgA.breakBuffer          := breakBuffer
    cfgA.touchTolerance       := touchTolerance
    cfgA.emaSlopeLookback     := emaSlopeLookback
    cfgA.swingLen5m           := swLen1
    cfgA.swingLen15m          := swLen2
    cfgA.swingLen1h           := swLen3
    cfgA.useMa                := useMa
    cfgA.useSwing             := useSwing
    cfgA.useAccum             := useAccum
    cfgA.useTimeHL            := useTime
    cfgA.useFvg               := useFvg
    cfgA.usePsych             := usePsych
    cfgA.accumRangeLen        := accumRangeLen
    cfgA.accumBaseLen         := accumBaseLen
    cfgA.accumAtrLen          := accumAtrLen
    cfgA.accumMinUpperCloses  := accumMinUpperCloses
    cfgA.accumMinLowerCloses  := accumMinLowerCloses
    cfgA.accumMaxSameColorRun := accumMaxSameColorRun
    cfgA.accumAtrMult         := accumAtrMult
    cfgA.accumBarRatioMax     := accumBarRatioMax
    cfgA.accumDriftMax        := accumDriftMax
    cfgA.zoneTimezone         := zoneTz
    cfgA.dayResetHour         := dayResetHour
    cfgA.asiaStartHour        := asiaStart
    cfgA.europeStartHour      := euStart
    cfgA.nyStartHour          := nyStart
    cfgA.nyEndHour            := nyEnd
    cfgA.tfMa                 := maTf
    cfgA.tfSwing1             := swTf1
    cfgA.tfSwing2             := swTf2
    cfgA.tfSwing3             := swTf3
    cfgA.tfAccum1             := accTf1
    cfgA.tfAccum2             := accTf2
    cfgA.tfAccum3             := accTf3
    cfgA.tfFvg1               := fvgTf1
    cfgA.tfFvg2               := fvgTf2
    cfgA.tfFvg3               := fvgTf3
    cfgA.maxSwingRoots        := maxSwingRoots
    cfgA.maxAccumBoxes        := maxAccumBoxes
    cfgA.maxFvgRoots          := maxFvgRoots
    cfgA.maxTimeRoots         := maxTimeRoots
    cfgA.maxZoneCores         := maxZoneCores
    cfgA.maxEndedGenerations  := maxEndedGenerations
    cfgA.maxTouchMarksPerCore := maxTouchMarks
    cfgA.dormantDistance      := dormantDistance
    cfgA.maxZonesDrawn        := 30
    cfgA.maxLabelsDrawn       := 30
    cfgA.mintick              := syminfo.mintick
    cfgA.buildDisplayStrings  := true

    cfgB.clusterMaxWidth      := clusterMaxWidth
    cfgB.denseRatio           := denseRatio
    cfgB.touchResetDistance   := touchResetDistance
    cfgB.strongUntilTouch     := strongUntilTouch
    cfgB.strongUnlimited      := strongUnlimited
    cfgB.weakFromTouch        := weakFromTouch
    cfgB.weakFromTouchOff     := weakFromTouchOff
    cfgB.weakDepthPct         := weakDepthPct
    cfgB.weakDepthOff         := weakDepthOff
    cfgB.breakBuffer          := breakBuffer
    cfgB.touchTolerance       := touchTolerance
    cfgB.emaSlopeLookback     := emaSlopeLookback
    cfgB.swingLen5m           := swLen1
    cfgB.swingLen15m          := swLen2
    cfgB.swingLen1h           := swLen3
    cfgB.useMa                := useMa
    cfgB.useSwing             := useSwing
    cfgB.useAccum             := useAccum
    cfgB.useTimeHL            := useTime
    cfgB.useFvg               := useFvg
    cfgB.usePsych             := usePsych
    cfgB.accumRangeLen        := accumRangeLen
    cfgB.accumBaseLen         := accumBaseLen
    cfgB.accumAtrLen          := accumAtrLen
    cfgB.accumMinUpperCloses  := accumMinUpperCloses
    cfgB.accumMinLowerCloses  := accumMinLowerCloses
    cfgB.accumMaxSameColorRun := accumMaxSameColorRun
    cfgB.accumAtrMult         := accumAtrMult
    cfgB.accumBarRatioMax     := accumBarRatioMax
    cfgB.accumDriftMax        := accumDriftMax
    cfgB.zoneTimezone         := zoneTz
    cfgB.dayResetHour         := dayResetHour
    cfgB.asiaStartHour        := asiaStart
    cfgB.europeStartHour      := euStart
    cfgB.nyStartHour          := nyStart
    cfgB.nyEndHour            := nyEnd
    cfgB.tfMa                 := maTf
    cfgB.tfSwing1             := swTf1
    cfgB.tfSwing2             := swTf2
    cfgB.tfSwing3             := swTf3
    cfgB.tfAccum1             := accTf1
    cfgB.tfAccum2             := accTf2
    cfgB.tfAccum3             := accTf3
    cfgB.tfFvg1               := fvgTf1
    cfgB.tfFvg2               := fvgTf2
    cfgB.tfFvg3               := fvgTf3
    cfgB.maxSwingRoots        := maxSwingRoots
    cfgB.maxAccumBoxes        := maxAccumBoxes
    cfgB.maxFvgRoots          := maxFvgRoots
    cfgB.maxTimeRoots         := maxTimeRoots
    cfgB.maxZoneCores         := maxZoneCores
    cfgB.maxEndedGenerations  := maxEndedGenerations
    cfgB.maxTouchMarksPerCore := maxTouchMarks
    cfgB.dormantDistance      := dormantDistance
    cfgB.maxZonesDrawn        := 30
    cfgB.maxLabelsDrawn       := 30
    cfgB.mintick              := syminfo.mintick
    cfgB.buildDisplayStrings  := true

//  定数は両方から引いて座標を揃える (値が違えばそれ自体が不一致)
var int TF_5M_A  = vA.constOf("TF_5M")
var int TF_15M_A = vA.constOf("TF_15M")
var int TF_1H_A  = vA.constOf("TF_1H")
var int TF_4H_A  = vA.constOf("TF_4H")
var int TF_D_A   = vA.constOf("TF_D")
var int SESS_NONE_A   = vA.constOf("SESS_NONE")
var int SESS_ASIA_A   = vA.constOf("SESS_ASIA")
var int SESS_EUROPE_A = vA.constOf("SESS_EUROPE")
var int SESS_NY_A     = vA.constOf("SESS_NY")

tfCodeOf(simple string tf) =>
    timeframe.in_seconds(tf) == timeframe.in_seconds("5")   ? TF_5M_A :
     timeframe.in_seconds(tf) == timeframe.in_seconds("15") ? TF_15M_A :
     timeframe.in_seconds(tf) == timeframe.in_seconds("60") ? TF_1H_A :
     timeframe.in_seconds(tf) == timeframe.in_seconds("240") ? TF_4H_A : TF_D_A

var int swCode1  = tfCodeOf(swTf1)
var int swCode2  = tfCodeOf(swTf2)
var int swCode3  = tfCodeOf(swTf3)
var int accCode1 = tfCodeOf(accTf1)
var int accCode2 = tfCodeOf(accTf2)
var int accCode3 = tfCodeOf(accTf3)
var int fvgCode1 = tfCodeOf(fvgTf1)
var int fvgCode2 = tfCodeOf(fvgTf2)
var int fvgCode3 = tfCodeOf(fvgTf3)

// ============================================================================
// 03. セッション / 日 / 週 ID (本番 Harness と同じ計算)
// ============================================================================
int locY = year(time, zoneTz)
int locM = month(time, zoneTz)
int locD = dayofmonth(time, zoneTz)
int locH = hour(time, zoneTz)
int calDayNo    = int(timestamp(zoneTz, locY, locM, locD, 0, 0) / 86400000)
int tradingDay  = locH < dayResetHour ? calDayNo - 1 : calDayNo
int tradingWeek = int(math.floor((tradingDay - 4) / 7.0))
int sessCode = locH >= asiaStart and locH < euStart ? SESS_ASIA_A :
     locH >= euStart and locH < nyStart ? SESS_EUROPE_A :
     (locH >= nyStart or locH < nyEnd) ? SESS_NY_A : SESS_NONE_A
int sessId = tradingDay * 8 + sessCode

// ============================================================================
// 04. FEED の元データ
// ----------------------------------------------------------------------------
//  基準は vA の個別 Pack (Version 3 で本番が使っていたもの)。
//  両 Engine にはこの同じ値を流し込むので、違いが出たらそれは
//  Engine 内部の違いであって、Feed の違いではない。
//  その上で vB のまとめ Pack を別途呼び、個別 Pack と同じ値になることも見る。
// ============================================================================
[ema1, ema1d, ema2, ema2d, maCt] = request.security(syminfo.tickerid, maTf,
     vA.maPackV2(emaLen1, emaLen2, emaSlopeLookback), lookahead = barmerge.lookahead_off)
[s1ph, s1phO, s1phE, s1phC, s1pl, s1plO, s1plE, s1plC] =
     request.security(syminfo.tickerid, swTf1, vA.pivotPackV2(swLen1), lookahead = barmerge.lookahead_off)
[s2ph, s2phO, s2phE, s2phC, s2pl, s2plO, s2plE, s2plC] =
     request.security(syminfo.tickerid, swTf2, vA.pivotPackV2(swLen2), lookahead = barmerge.lookahead_off)
[s3ph, s3phO, s3phE, s3phC, s3pl, s3plO, s3plE, s3plC] =
     request.security(syminfo.tickerid, swTf3, vA.pivotPackV2(swLen3), lookahead = barmerge.lookahead_off)
[a1New, a1Top, a1Bot, a1Id, a1Cs, a1Ct] = request.security(syminfo.tickerid, accTf1,
     vA.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), lookahead = barmerge.lookahead_off)
[a2New, a2Top, a2Bot, a2Id, a2Cs, a2Ct] = request.security(syminfo.tickerid, accTf2,
     vA.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), lookahead = barmerge.lookahead_off)
[a3New, a3Top, a3Bot, a3Id, a3Cs, a3Ct] = request.security(syminfo.tickerid, accTf3,
     vA.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax), lookahead = barmerge.lookahead_off)
[f1bN, f1bT, f1bB, f1bO, f1bC, f1sN, f1sT, f1sB, f1sO, f1sC, f1h, f1l, f1c, f1ot, f1ct] =
     request.security(syminfo.tickerid, fvgTf1, vA.fvgPackV2(), lookahead = barmerge.lookahead_off)
[f2bN, f2bT, f2bB, f2bO, f2bC, f2sN, f2sT, f2sB, f2sO, f2sC, f2h, f2l, f2c, f2ot, f2ct] =
     request.security(syminfo.tickerid, fvgTf2, vA.fvgPackV2(), lookahead = barmerge.lookahead_off)
[f3bN, f3bT, f3bB, f3bO, f3bC, f3sN, f3sT, f3sB, f3sO, f3sC, f3h, f3l, f3c, f3ot, f3ct] =
     request.security(syminfo.tickerid, fvgTf3, vA.fvgPackV2(), lookahead = barmerge.lookahead_off)

bool nSw1 = nz(ta.change(time(swTf1)), 0) != 0
bool nSw2 = nz(ta.change(time(swTf2)), 0) != 0
bool nSw3 = nz(ta.change(time(swTf3)), 0) != 0
bool nAc1 = nz(ta.change(time(accTf1)), 0) != 0
bool nAc2 = nz(ta.change(time(accTf2)), 0) != 0
bool nAc3 = nz(ta.change(time(accTf3)), 0) != 0
bool nFv1 = nz(ta.change(time(fvgTf1)), 0) != 0
bool nFv2 = nz(ta.change(time(fvgTf2)), 0) != 0
bool nFv3 = nz(ta.change(time(fvgTf3)), 0) != 0

//  ★ まとめ Pack の検証 : 同じ時間足なら個別 Pack と完全に同じ値になるはず。
bool pmerge60  = swTf3  == accTf1 and accTf1 == fvgTf1
bool pmerge240 = accTf2 == fvgTf2
bool pmergeDay = accTf3 == fvgTf3
[m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19, m20,
     m21, m22, m23, m24, m25, m26, m27, m28, m29] =
     request.security(syminfo.tickerid, swTf3,
     vB.swingAccumFvgPackV2(swLen3, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_off)
[k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21] =
     request.security(syminfo.tickerid, accTf2,
     vB.accumFvgPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_off)
[d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21] =
     request.security(syminfo.tickerid, accTf3,
     vB.accumFvgPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_off)

// ============================================================================
// 05. 違いの記録 (最初の 1 件だけ残す)
// ============================================================================
//  ★ Pine では関数の中から global のスカラーを代入し直せないので、
//    状態は参照型 (array) へ入れて持つ。
//      dState[0] = 最初に違った足の time (0 = まだ違い無し)
//      dState[1] = 照らした確定足の数
//      dState[2] = 照らした項目の延べ数
//      dText[0]  = 項目名 / dText[1] = Version 3 の値 / dText[2] = 新版の値
var array<int>    dState = array.new_int(3, 0)
var array<string> dText  = array.new_string(3, "")

f_record(string pre, string field, string oldV, string newV) =>
    if array.get(dState, 0) == 0
        array.set(dState, 0, time)
        array.set(dText, 0, pre + field)
        array.set(dText, 1, oldV)
        array.set(dText, 2, newV)
    true

f_seen() =>
    array.set(dState, 2, array.get(dState, 2) + 1)
    true

f_cmpInt(string pre, string field, int a, int b) =>
    f_seen()
    bool bad = na(a) != na(b)
    if not bad and not na(a)
        bad := a != b
    if bad
        f_record(pre, field, str.tostring(a), str.tostring(b))
    true

f_cmpFloat(string pre, string field, float a, float b) =>
    f_seen()
    bool bad = na(a) != na(b)
    if not bad and not na(a)
        bad := a != b
    if bad
        f_record(pre, field, str.tostring(a, "#.##########"), str.tostring(b, "#.##########"))
    true

f_cmpBool(string pre, string field, bool a, bool b) =>
    f_seen()
    if a != b
        f_record(pre, field, str.tostring(a), str.tostring(b))
    true

f_cmpStr(string pre, string field, string a, string b) =>
    f_seen()
    if a != b
        f_record(pre, field, a, b)
    true

// ============================================================================
// 06. 両 ENGINE を同じ Feed で回す
// ============================================================================
bool isFiveMin = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("5")
var int baseSeq = 0
var vA.ZoneFeed fdA = vA.newFeed()
var vB.ZoneFeed fdB = vB.newFeed()
if isFiveMin and barstate.isconfirmed
    baseSeq += 1
    vA.resetFeed(fdA)
    vB.resetFeed(fdB)
    fdA.baseOpen      := open
    fdA.baseHigh      := high
    fdA.baseLow       := low
    fdA.baseClose     := close
    fdA.basePrevClose := close[1]
    fdA.baseOpenTime  := time
    fdA.baseCloseTime := time_close
    fdA.baseSeq       := baseSeq
    fdA.baseConfirmed := true
    fdA.mintick       := syminfo.mintick
    fdA.maValid       := not na(ema1) and not na(ema2)
    fdA.ema1          := ema1
    fdA.ema1Delta     := ema1d
    fdA.ema2          := ema2
    fdA.ema2Delta     := ema2d
    fdA.maConfirmTime := maCt
    fdA.sessionCode   := sessCode
    fdA.sessionId     := sessId
    fdA.dayId         := tradingDay
    fdA.weekId        := tradingWeek

    fdB.baseOpen      := open
    fdB.baseHigh      := high
    fdB.baseLow       := low
    fdB.baseClose     := close
    fdB.basePrevClose := close[1]
    fdB.baseOpenTime  := time
    fdB.baseCloseTime := time_close
    fdB.baseSeq       := baseSeq
    fdB.baseConfirmed := true
    fdB.mintick       := syminfo.mintick
    fdB.maValid       := not na(ema1) and not na(ema2)
    fdB.ema1          := ema1
    fdB.ema1Delta     := ema1d
    fdB.ema2          := ema2
    fdB.ema2Delta     := ema2d
    fdB.maConfirmTime := maCt
    fdB.sessionCode   := sessCode
    fdB.sessionId     := sessId
    fdB.dayId         := tradingDay
    fdB.weekId        := tradingWeek

    vA.feedSwing(fdA, swCode1, nSw1, s1ph, s1phO, s1phE, s1phC, s1pl, s1plO, s1plE, s1plC)
    vA.feedSwing(fdA, swCode2, nSw2, s2ph, s2phO, s2phE, s2phC, s2pl, s2plO, s2plE, s2plC)
    vA.feedSwing(fdA, swCode3, nSw3, s3ph, s3phO, s3phE, s3phC, s3pl, s3plO, s3plE, s3plC)
    vA.feedAccum(fdA, accCode1, nAc1, a1New, a1Top, a1Bot, a1Id, a1Cs, a1Ct)
    vA.feedAccum(fdA, accCode2, nAc2, a2New, a2Top, a2Bot, a2Id, a2Cs, a2Ct)
    vA.feedAccum(fdA, accCode3, nAc3, a3New, a3Top, a3Bot, a3Id, a3Cs, a3Ct)
    vA.feedFvg(fdA, fvgCode1, nFv1, f1bN, f1bT, f1bB, f1bO, f1bC, f1sN, f1sT, f1sB, f1sO, f1sC,
         f1h, f1l, f1c, f1ot, f1ct)
    vA.feedFvg(fdA, fvgCode2, nFv2, f2bN, f2bT, f2bB, f2bO, f2bC, f2sN, f2sT, f2sB, f2sO, f2sC,
         f2h, f2l, f2c, f2ot, f2ct)
    vA.feedFvg(fdA, fvgCode3, nFv3, f3bN, f3bT, f3bB, f3bO, f3bC, f3sN, f3sT, f3sB, f3sO, f3sC,
         f3h, f3l, f3c, f3ot, f3ct)

    vB.feedSwing(fdB, swCode1, nSw1, s1ph, s1phO, s1phE, s1phC, s1pl, s1plO, s1plE, s1plC)
    vB.feedSwing(fdB, swCode2, nSw2, s2ph, s2phO, s2phE, s2phC, s2pl, s2plO, s2plE, s2plC)
    vB.feedSwing(fdB, swCode3, nSw3, s3ph, s3phO, s3phE, s3phC, s3pl, s3plO, s3plE, s3plC)
    vB.feedAccum(fdB, accCode1, nAc1, a1New, a1Top, a1Bot, a1Id, a1Cs, a1Ct)
    vB.feedAccum(fdB, accCode2, nAc2, a2New, a2Top, a2Bot, a2Id, a2Cs, a2Ct)
    vB.feedAccum(fdB, accCode3, nAc3, a3New, a3Top, a3Bot, a3Id, a3Cs, a3Ct)
    vB.feedFvg(fdB, fvgCode1, nFv1, f1bN, f1bT, f1bB, f1bO, f1bC, f1sN, f1sT, f1sB, f1sO, f1sC,
         f1h, f1l, f1c, f1ot, f1ct)
    vB.feedFvg(fdB, fvgCode2, nFv2, f2bN, f2bT, f2bB, f2bO, f2bC, f2sN, f2sT, f2sB, f2sO, f2sC,
         f2h, f2l, f2c, f2ot, f2ct)
    vB.feedFvg(fdB, fvgCode3, nFv3, f3bN, f3bT, f3bB, f3bO, f3bC, f3sN, f3sT, f3sB, f3sO, f3sC,
         f3h, f3l, f3c, f3ot, f3ct)

    vA.update(engA, cfgA, fdA)
    vB.update(engB, cfgB, fdB)
    array.set(dState, 1, array.get(dState, 1) + 1)

    // ---- まとめ Pack と個別 Pack ----
    if pmerge60
        f_cmpFloat("PACK60.", "s3ph", s3ph, m1)
        f_cmpInt("PACK60.", "s3phO", s3phO, m2)
        f_cmpInt("PACK60.", "s3phE", s3phE, m3)
        f_cmpInt("PACK60.", "s3phC", s3phC, m4)
        f_cmpFloat("PACK60.", "s3pl", s3pl, m5)
        f_cmpInt("PACK60.", "s3plO", s3plO, m6)
        f_cmpInt("PACK60.", "s3plE", s3plE, m7)
        f_cmpInt("PACK60.", "s3plC", s3plC, m8)
        f_cmpBool("PACK60.", "a1New", a1New, m9)
        f_cmpFloat("PACK60.", "a1Top", a1Top, m10)
        f_cmpFloat("PACK60.", "a1Bot", a1Bot, m11)
        f_cmpInt("PACK60.", "a1Id", a1Id, m12)
        f_cmpInt("PACK60.", "a1Cs", a1Cs, m13)
        f_cmpInt("PACK60.", "a1Ct", a1Ct, m14)
        f_cmpBool("PACK60.", "f1bN", f1bN, m15)
        f_cmpFloat("PACK60.", "f1bT", f1bT, m16)
        f_cmpFloat("PACK60.", "f1bB", f1bB, m17)
        f_cmpInt("PACK60.", "f1bO", f1bO, m18)
        f_cmpInt("PACK60.", "f1bC", f1bC, m19)
        f_cmpBool("PACK60.", "f1sN", f1sN, m20)
        f_cmpFloat("PACK60.", "f1sT", f1sT, m21)
        f_cmpFloat("PACK60.", "f1sB", f1sB, m22)
        f_cmpInt("PACK60.", "f1sO", f1sO, m23)
        f_cmpInt("PACK60.", "f1sC", f1sC, m24)
        f_cmpFloat("PACK60.", "f1h", f1h, m25)
        f_cmpFloat("PACK60.", "f1l", f1l, m26)
        f_cmpFloat("PACK60.", "f1c", f1c, m27)
        f_cmpInt("PACK60.", "f1ot", f1ot, m28)
        f_cmpInt("PACK60.", "f1ct", f1ct, m29)
    if pmerge240
        f_cmpBool("PACK240.", "a2New", a2New, k1)
        f_cmpFloat("PACK240.", "a2Top", a2Top, k2)
        f_cmpFloat("PACK240.", "a2Bot", a2Bot, k3)
        f_cmpInt("PACK240.", "a2Id", a2Id, k4)
        f_cmpInt("PACK240.", "a2Cs", a2Cs, k5)
        f_cmpInt("PACK240.", "a2Ct", a2Ct, k6)
        f_cmpBool("PACK240.", "f2bN", f2bN, k7)
        f_cmpFloat("PACK240.", "f2bT", f2bT, k8)
        f_cmpFloat("PACK240.", "f2bB", f2bB, k9)
        f_cmpInt("PACK240.", "f2bO", f2bO, k10)
        f_cmpInt("PACK240.", "f2bC", f2bC, k11)
        f_cmpBool("PACK240.", "f2sN", f2sN, k12)
        f_cmpFloat("PACK240.", "f2sT", f2sT, k13)
        f_cmpFloat("PACK240.", "f2sB", f2sB, k14)
        f_cmpInt("PACK240.", "f2sO", f2sO, k15)
        f_cmpInt("PACK240.", "f2sC", f2sC, k16)
        f_cmpFloat("PACK240.", "f2h", f2h, k17)
        f_cmpFloat("PACK240.", "f2l", f2l, k18)
        f_cmpFloat("PACK240.", "f2c", f2c, k19)
        f_cmpInt("PACK240.", "f2ot", f2ot, k20)
        f_cmpInt("PACK240.", "f2ct", f2ct, k21)
    if pmergeDay
        f_cmpBool("PACKD.", "a3New", a3New, d1)
        f_cmpFloat("PACKD.", "a3Top", a3Top, d2)
        f_cmpFloat("PACKD.", "a3Bot", a3Bot, d3)
        f_cmpInt("PACKD.", "a3Id", a3Id, d4)
        f_cmpInt("PACKD.", "a3Cs", a3Cs, d5)
        f_cmpInt("PACKD.", "a3Ct", a3Ct, d6)
        f_cmpBool("PACKD.", "f3bN", f3bN, d7)
        f_cmpFloat("PACKD.", "f3bT", f3bT, d8)
        f_cmpFloat("PACKD.", "f3bB", f3bB, d9)
        f_cmpInt("PACKD.", "f3bO", f3bO, d10)
        f_cmpInt("PACKD.", "f3bC", f3bC, d11)
        f_cmpBool("PACKD.", "f3sN", f3sN, d12)
        f_cmpFloat("PACKD.", "f3sT", f3sT, d13)
        f_cmpFloat("PACKD.", "f3sB", f3sB, d14)
        f_cmpInt("PACKD.", "f3sO", f3sO, d15)
        f_cmpInt("PACKD.", "f3sC", f3sC, d16)
        f_cmpFloat("PACKD.", "f3h", f3h, d17)
        f_cmpFloat("PACKD.", "f3l", f3l, d18)
        f_cmpFloat("PACKD.", "f3c", f3c, d19)
        f_cmpInt("PACKD.", "f3ot", f3ot, d20)
        f_cmpInt("PACKD.", "f3ct", f3ct, d21)

    // ---- 全体の件数 ----
    f_cmpInt("", "processedBars", engA.processedBars, engB.processedBars)
    f_cmpBool("", "configValid", engA.configValid,  engB.configValid)
    f_cmpStr("", "configError", engA.configError,  engB.configError)
    f_cmpInt("", "rootCount", vA.rootCount(engA),  vB.rootCount(engB))
    f_cmpInt("", "coreCount", vA.coreCount(engA),  vB.coreCount(engB))
    f_cmpInt("", "viewCount", vA.viewCount(engA),  vB.viewCount(engB))
    f_cmpInt("", "eventCount", vA.eventCount(engA), vB.eventCount(engB))
    f_cmpInt("", "endedGenerationCount", vA.endedGenerationCount(engA), vB.endedGenerationCount(engB))

    // ---- ZoneView を 1 件ずつ、同じ順番で照らす ----
    int vn = int(math.min(vA.viewCount(engA), vB.viewCount(engB)))
    if vn > 0
        for i = 0 to vn - 1
            vA.ZoneView wa = vA.viewAt(engA, i)
            vB.ZoneView wb = vB.viewAt(engB, i)
            string tag = "view[" + str.tostring(i) + "]."
            f_cmpInt(tag, "coreId", wa.coreId, wb.coreId)
            f_cmpInt(tag, "generationId", wa.generationId, wb.generationId)
            f_cmpInt(tag, "side", wa.side, wb.side)
            f_cmpFloat(tag, "effectiveBottom", wa.effectiveBottom, wb.effectiveBottom)
            f_cmpFloat(tag, "effectiveTop", wa.effectiveTop, wb.effectiveTop)
            f_cmpFloat(tag, "referencePrice", wa.referencePrice, wb.referencePrice)
            f_cmpInt(tag, "phase", wa.phase, wb.phase)
            f_cmpInt(tag, "grade", wa.grade, wb.grade)
            f_cmpInt(tag, "cCount", wa.cCount, wb.cCount)
            f_cmpInt(tag, "hCount", wa.hCount, wb.hCount)
            f_cmpInt(tag, "density", wa.density, wb.density)
            f_cmpBool(tag, "baseStrong", wa.baseStrong, wb.baseStrong)
            f_cmpInt(tag, "currentTouchNo", wa.currentTouchNo, wb.currentTouchNo)
            f_cmpInt(tag, "upcomingTouchNo", wa.upcomingTouchNo, wb.upcomingTouchNo)
            f_cmpBool(tag, "zoneFresh", wa.zoneFresh, wb.zoneFresh)
            f_cmpBool(tag, "sideFresh", wa.sideFresh, wb.sideFresh)
            f_cmpInt(tag, "weakReason", wa.weakReason, wb.weakReason)
            f_cmpFloat(tag, "maxDepthPct", wa.maxDepthPct, wb.maxDepthPct)
            f_cmpBool(tag, "isBroadContext", wa.isBroadContext, wb.isBroadContext)
            f_cmpInt(tag, "fvgDirectionMask", wa.fvgDirectionMask, wb.fvgDirectionMask)
            f_cmpInt(tag, "fvgRootCount", wa.fvgRootCount, wb.fvgRootCount)
            f_cmpInt(tag, "fvgFreshCount", wa.fvgFreshCount, wb.fvgFreshCount)
            f_cmpInt(tag, "fvgStructuralStateMask", wa.fvgStructuralStateMask, wb.fvgStructuralStateMask)
            f_cmpBool(tag, "eligible", wa.eligible, wb.eligible)
            f_cmpBool(tag, "dormant", wa.dormant, wb.dormant)
            f_cmpBool(tag, "pendingTopology", wa.pendingTopology, wb.pendingTopology)
            f_cmpBool(tag, "pendingGeneration", wa.pendingGeneration, wb.pendingGeneration)
            f_cmpInt(tag, "catMask", wa.catMask, wb.catMask)
            f_cmpInt(tag, "highMask", wa.highMask, wb.highMask)
            f_cmpInt(tag, "touchStartGrade", wa.touchStartGrade, wb.touchStartGrade)
            f_cmpFloat(tag, "snapshotBottom", wa.snapshotBottom, wb.snapshotBottom)
            f_cmpFloat(tag, "snapshotTop", wa.snapshotTop, wb.snapshotTop)
            f_cmpFloat(tag, "physBottom", wa.physBottom, wb.physBottom)
            f_cmpFloat(tag, "physTop", wa.physTop, wb.physTop)
            f_cmpInt(tag, "flipAttemptCount", wa.flipAttemptCount, wb.flipAttemptCount)
            f_cmpStr(tag, "rootSummary", wa.rootSummary, wb.rootSummary)
            f_cmpStr(tag, "categorySummary", wa.categorySummary, wb.categorySummary)

    // ---- Root registry を 1 件ずつ、同じ順番で照らす ----
    int rn = int(math.min(vA.rootCount(engA), vB.rootCount(engB)))
    if rn > 0
        for i = 0 to rn - 1
            vA.RootDebugView ra = vA.rootAt(engA, i)
            vB.RootDebugView rb = vB.rootAt(engB, i)
            string tag = "root[" + str.tostring(i) + "]."
            f_cmpInt(tag, "rootId", ra.rootId, rb.rootId)
            f_cmpInt(tag, "category", ra.category, rb.category)
            f_cmpInt(tag, "subtype", ra.subtype, rb.subtype)
            f_cmpInt(tag, "tfCode", ra.tfCode, rb.tfCode)
            f_cmpInt(tag, "tfMask", ra.tfMask, rb.tfMask)
            f_cmpInt(tag, "state", ra.state, rb.state)
            f_cmpFloat(tag, "pointPrice", ra.pointPrice, rb.pointPrice)
            f_cmpFloat(tag, "nativeBottom", ra.nativeBottom, rb.nativeBottom)
            f_cmpFloat(tag, "nativeTop", ra.nativeTop, rb.nativeTop)
            f_cmpBool(tag, "isRangeRoot", ra.isRangeRoot, rb.isRangeRoot)
            f_cmpBool(tag, "isBroadFvg", ra.isBroadFvg, rb.isBroadFvg)
            f_cmpBool(tag, "fvgFresh", ra.fvgFresh, rb.fvgFresh)
            f_cmpInt(tag, "direction", ra.direction, rb.direction)
            f_cmpInt(tag, "confirmedTime", ra.confirmedTime, rb.confirmedTime)
            f_cmpInt(tag, "originTime", ra.originTime, rb.originTime)
            f_cmpStr(tag, "originKey", ra.originKey, rb.originKey)
            f_cmpStr(tag, "pairKey", ra.pairKey, rb.pairKey)
            f_cmpInt(tag, "periodKind", ra.periodKind, rb.periodKind)
            f_cmpBool(tag, "isCurrentPeriod", ra.isCurrentPeriod, rb.isCurrentPeriod)
            f_cmpInt(tag, "labelMask", vA.rootLabelMaskAt(engA, i), vB.rootLabelMaskAt(engB, i))

    // ---- この足で出た Event を 1 件ずつ、同じ順番で照らす ----
    int en = int(math.min(vA.eventCount(engA), vB.eventCount(engB)))
    if en > 0
        for i = 0 to en - 1
            vA.ZoneEvent ea = vA.eventAt(engA, i)
            vB.ZoneEvent eb = vB.eventAt(engB, i)
            string tag = "event[" + str.tostring(i) + "]."
            f_cmpInt(tag, "eventType", ea.eventType, eb.eventType)
            f_cmpInt(tag, "eventTime", ea.eventTime, eb.eventTime)
            f_cmpInt(tag, "baseSeq", ea.baseSeq, eb.baseSeq)
            f_cmpInt(tag, "coreId", ea.coreId, eb.coreId)
            f_cmpInt(tag, "generationId", ea.generationId, eb.generationId)
            f_cmpInt(tag, "side", ea.side, eb.side)
            f_cmpFloat(tag, "rangeBottom", ea.rangeBottom, eb.rangeBottom)
            f_cmpFloat(tag, "rangeTop", ea.rangeTop, eb.rangeTop)
            f_cmpInt(tag, "touchNo", ea.touchNo, eb.touchNo)
            f_cmpInt(tag, "gradeAtStart", ea.gradeAtStart, eb.gradeAtStart)
            f_cmpInt(tag, "weakReason", ea.weakReason, eb.weakReason)
            f_cmpInt(tag, "rootId", ea.rootId, eb.rootId)
            f_cmpStr(tag, "info", ea.info, eb.info)

// ============================================================================
// 07. 結果表 (最終足で 1 回だけ描く)
// ============================================================================
var table rt = na
if na(rt)
    rt := table.new(position.top_right, 2, 7, border_width = 1, frame_width = 1,
         frame_color = color.new(color.gray, 40))

if barstate.islast
    bool ok = array.get(dState, 0) == 0
    color hdr = ok ? color.new(color.green, 20) : color.new(color.red, 10)
    table.cell(rt, 0, 0, "ZoneEngineV2 Parity (vA=3 / vB=新版)", text_color = color.white,
         bgcolor = hdr, text_halign = text.align_left)
    table.cell(rt, 1, 0, ok ? "OK" : "DIFF FOUND", text_color = color.white, bgcolor = hdr)
    table.cell(rt, 0, 1, "照らした確定足", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 1, str.tostring(array.get(dState, 1)), text_color = color.white,
         bgcolor = color.new(color.gray, 70))
    table.cell(rt, 0, 2, "照らした項目数", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 2, str.tostring(array.get(dState, 2)), text_color = color.white,
         bgcolor = color.new(color.gray, 70))
    table.cell(rt, 0, 3, "最初に違った足", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 3, ok ? "-" : str.format_time(array.get(dState, 0), "yyyy-MM-dd HH:mm", zoneTz),
         text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(rt, 0, 4, "項目", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 4, ok ? "-" : array.get(dText, 0), text_color = color.white,
         bgcolor = color.new(color.gray, 70))
    table.cell(rt, 0, 5, "Version 3 の値", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 5, ok ? "-" : array.get(dText, 1), text_color = color.white,
         bgcolor = color.new(color.gray, 70))
    table.cell(rt, 0, 6, "新版の値", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(rt, 1, 6, ok ? "-" : array.get(dText, 2), text_color = color.white,
         bgcolor = color.new(color.gray, 70))

//  プロットでも分かるように : 0 = 一致 / 1 = 不一致
plot(array.get(dState, 0) == 0 ? 0 : 1, "Parity diff (0=OK)", color = color.red, style = plot.style_stepline)

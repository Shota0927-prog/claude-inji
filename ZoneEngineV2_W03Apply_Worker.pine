        ok := array.get(rootCategories, rootSlot) == CAT_FVG and array.get(rootTfCodes, rootSlot) == tfCode and array.get(rootOriginKeys, rootSlot) == originKey and array.get(rootSubtypes, rootSlot) == subtype and array.get(rootPairKeys, rootSlot) == ID_NONE and array.get(rootDirections, rootSlot) == direction and array.get(rootIsRangeRootFlags, rootSlot) and not array.get(rootIsDynamicFlags, rootSlot) and array.get(rootLabelMasks, rootSlot) == 0 and array.get(rootSwingTfMasks, rootSlot) == SWING_TF_MASK_NONE and na(array.get(rootPointPrices, rootSlot)) and not na(array.get(rootNativeBottoms, rootSlot)) and not na(array.get(rootNativeTops, rootSlot)) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick and array.get(rootPriceOrderPositions, rootSlot) == SLOT_INVALID
    if ok
        int bottomPos = array.get(rootFvgNativeBottomOrderPositions, rootSlot)
        int topPos    = array.get(rootFvgNativeTopOrderPositions,    rootSlot)
        ok := bottomPos >= 0 and topPos >= 0 and bottomPos < array.size(fvgNativeBottomOrderRootSlots) and topPos < array.size(fvgNativeTopOrderRootSlots)
        if ok
            ok := array.get(fvgNativeBottomOrderRootSlots, bottomPos) == rootSlot and array.get(fvgNativeTopOrderRootSlots, topPos) == rootSlot
    if ok
        ok := rootSetMembershipValidRaw(rootIds, rootCategories, rootTfCodes, rootStates, rootSlotLiveFlags, categoryMaRootSlots, categorySwingRootSlots, categoryAccumRootSlots, categoryTimeHlRootSlots, categoryFvgRootSlots, categoryPsychRootSlots, tf1mRootSlots, tf5mRootSlots, tf15mRootSlots, tf1hRootSlots, tf4hRootSlots, tfDRootSlots, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, rootSlot)
    if ok

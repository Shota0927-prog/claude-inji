                            int actualId   = array.get(journalExpectedRootIds, newRow)
                            ok := actualSlot != SLOT_INVALID and actualId != ID_NONE
                            if ok
                                array.set(journalTargetRootSlots, row, actualSlot)
                                array.set(journalExpectedRootIds, row, actualId)
                    if ok

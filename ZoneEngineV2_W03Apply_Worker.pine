                    ok := swingTfMergeApplyRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootPointPrices, rootNativeBottoms, rootNativeTops, rootIsRangeRootFlags, rootIsDynamicFlags, rootStates, rootPairKeys, rootDirections, rootFvgFreshFlags, rootIsBroadFvgFlags, rootLabelMasks, rootSlotLiveFlags, rootPriceOrderSlots, rootPriceOrderPositions, categoryMaRootSlots, categorySwingRootSlots, categoryAccumRootSlots, categoryTimeHlRootSlots, categoryFvgRootSlots, categoryPsychRootSlots, tf1mRootSlots, tf5mRootSlots, tf15mRootSlots, tf1hRootSlots, tf4hRootSlots, tfDRootSlots, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, rootSwingTfMasks, journalCount, journalBaseSeq, row)

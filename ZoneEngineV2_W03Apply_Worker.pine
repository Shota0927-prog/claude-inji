                    [newSlot, newNextRootId] = newRootApplyRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootConfirmedTimes, rootPointPrices, rootNativeBottoms, rootNativeTops, rootIsRangeRootFlags, rootIsDynamicFlags, rootStates, rootPairKeys, rootDirections, rootFvgFreshFlags, rootIsBroadFvgFlags, rootLabelMasks, rootLastUpdateSeqs, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootSlotLiveFlags, rootFreeSlots, rootLiveSlots, rootIdOrderSlots, rootIdToSlot, rootPriceOrderSlots, rootPriceOrderPositions, categoryMaRootSlots, categorySwingRootSlots, categoryAccumRootSlots, categoryTimeHlRootSlots, categoryFvgRootSlots, categoryPsychRootSlots, tf1mRootSlots, tf5mRootSlots, tf15mRootSlots, tf1hRootSlots, tf4hRootSlots, tfDRootSlots, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, accumPairUpperRootSlotByKey, accumPairLowerRootSlotByKey, freshFvg1hRootSlots, freshFvg4hRootSlots, freshFvgDRootSlots, structurallyActiveFvg1hRootSlots, structurallyActiveFvg4hRootSlots, structurallyActiveFvgDRootSlots, bullishFvgRootSlots, bearishFvgRootSlots, broadFvgRootSlots, rootFvgFreshSetPositions, rootFvgStructuralStateSetPositions, rootFvgDirectionSetPositions, rootFvgBroadSetPositions, fvgNativeBottomOrderRootSlots, fvgNativeTopOrderRootSlots, rootFvgNativeBottomOrderPositions, rootFvgNativeTopOrderPositions, rootParticipationHeadEdgeIndexes, rootParticipationCounts, journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, rootSwingTfMasks, rootPruneRevisions, originKeyBucketHeadRootSlots, rootOriginBucketPrevRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, journalCount, journalBaseSeq, nextRootIdLocal, row, mintick)
                    ok := newSlot != SLOT_INVALID
                    nextRootIdLocal := newNextRootId
                    if ok
                        dirtyRootRegistry := true
                        dirtyPriceOrder   := true
                        if category == CAT_FVG
                            if direction == FVG_BULLISH
                                dirtyEligibilitySupport := true
                            else
                                dirtyEligibilityResistance := true
                        else
                            dirtyEligibilitySupport    := true
                            dirtyEligibilityResistance := true
                else if op == JOP_MA_UPDATE
                    int rootSlot  = array.get(journalTargetRootSlots, row)
                    int oldTick   = array.get(rootPointTicks,          rootSlot)
                    int oldPos    = array.get(rootPriceOrderPositions, rootSlot)
                    int subtype   = array.get(journalSubtypes,  row)
                    int newSlope  = array.get(journalSlopeDirs, row)
                    int prevSlope = subtype == SUB_MA_EMA2000 ? virtualSlope2000 : virtualSlope3000
                    ok := maUpdateApplyRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootConfirmedTimes, rootPointPrices, rootNativeBottoms, rootNativeTops, rootIsRangeRootFlags, rootIsDynamicFlags, rootStates, rootPairKeys, rootDirections, rootFvgFreshFlags, rootIsBroadFvgFlags, rootLabelMasks, rootLastUpdateSeqs, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootSlotLiveFlags, rootPriceOrderSlots, rootPriceOrderPositions, categoryMaRootSlots, categorySwingRootSlots, categoryAccumRootSlots, categoryTimeHlRootSlots, categoryFvgRootSlots, categoryPsychRootSlots, tf1mRootSlots, tf5mRootSlots, tf15mRootSlots, tf1hRootSlots, tf4hRootSlots, tfDRootSlots, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, rootSwingTfMasks, journalCount, journalBaseSeq, row, mintick)

    int  count = journalCount
    int group = JGROUP_E1
    while ok and group <= JGROUP_E4
        int row = 0
        while ok and row < count
            if array.get(journalGroups, row) == group
                int op        = array.get(journalOps,        row)
                int category  = array.get(journalCategories, row)
                int direction = array.get(journalDirections, row)
                if op == JOP_FVG_INVALIDATE
                    ok := fvgInvalidateApplyRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootPointPrices, rootNativeBottoms, rootNativeTops, rootIsRangeRootFlags, rootIsDynamicFlags, rootStates, rootPairKeys, rootDirections, rootFvgFreshFlags, rootIsBroadFvgFlags, rootLabelMasks, rootLastUpdateSeqs, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootSlotLiveFlags, rootPriceOrderPositions, categoryMaRootSlots, categorySwingRootSlots, categoryAccumRootSlots, categoryTimeHlRootSlots, categoryFvgRootSlots, categoryPsychRootSlots, tf1mRootSlots, tf5mRootSlots, tf15mRootSlots, tf1hRootSlots, tf4hRootSlots, tfDRootSlots, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, freshFvg1hRootSlots, freshFvg4hRootSlots, freshFvgDRootSlots, structurallyActiveFvg1hRootSlots, structurallyActiveFvg4hRootSlots, structurallyActiveFvgDRootSlots, bullishFvgRootSlots, bearishFvgRootSlots, broadFvgRootSlots, rootFvgFreshSetPositions, rootFvgStructuralStateSetPositions, rootFvgDirectionSetPositions, rootFvgBroadSetPositions, fvgNativeBottomOrderRootSlots, fvgNativeTopOrderRootSlots, rootFvgNativeBottomOrderPositions, rootFvgNativeTopOrderPositions, journalOps, journalGroups, journalTargetRootSlots, journalExpectedRootIds, journalCategories, journalSubtypes, journalTfCodes, journalOriginKeys, journalOriginTimes, journalOriginEndTimes, journalConfirmedTimes, journalPointPrices, journalNativeBottoms, journalNativeTops, journalOldStates, journalNewStates, journalFvgFreshFlags, journalIsBroadFlags, journalDirections, journalOldMasks, journalNewMasks, journalPairKeys, journalSlopeDirs, rootSwingTfMasks, journalCount, journalBaseSeq, row)

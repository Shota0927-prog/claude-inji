    bool stateMoved         = false
    if ok
        structuralDetached := fvgStructuralActiveSetDetachRaw(rootIds, rootCategories, rootTfCodes, rootStates, rootDirections, rootSlotLiveFlags, structurallyActiveFvg1hRootSlots, structurallyActiveFvg4hRootSlots, structurallyActiveFvgDRootSlots, rootFvgStructuralStateSetPositions, rootSlot, expectedRootId)
        stateMoved         := rootStateSetMoveRaw(rootIds, rootStates, rootSlotLiveFlags, stateCandidateRootSlots, stateActiveRootSlots, stateInvalidatedRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, stateRetiredRootSlots, rootStateSetPositions, rootSlot, expectedRootId, ROOT_ACTIVE, ROOT_INVALIDATED)
        if structuralDetached and stateMoved
            array.set(rootStates, rootSlot, ROOT_INVALIDATED)
    structuralDetached and stateMoved

// Main journalAppliedBeforeRaw (lines 6073-6076)
journalAppliedBeforeRaw(array<int> journalGroups, int rowA, int rowB) =>
    int groupA = array.get(journalGroups, rowA)
    int groupB = array.get(journalGroups, rowB)
    groupA < groupB or (groupA == groupB and rowA < rowB)

// Main pendingNewFvgRowRaw (lines 6131-6144)
pendingNewFvgRowRaw(array<int> journalOps, array<int> journalGroups, array<int> journalCategories, array<int> journalTfCodes, array<int> journalOriginTimes, array<int> journalDirections, int journalCount, int freshRow) =>
    int matchRow   = SLOT_INVALID
    int matchCount = 0
    int tfCode     = array.get(journalTfCodes,     freshRow)
    int direction  = array.get(journalDirections,  freshRow)
    int originTime = array.get(journalOriginTimes, freshRow)
    int row = 0
    while row < journalCount
        if row != freshRow and array.get(journalOps, row) == JOP_NEW_ROOT and array.get(journalCategories, row) == CAT_FVG and journalAppliedBeforeRaw(journalGroups, row, freshRow)
            if array.get(journalTfCodes, row) == tfCode and array.get(journalDirections, row) == direction and array.get(journalOriginTimes, row) == originTime
                matchRow   := row
                matchCount += 1
        row += 1
    [matchRow, matchCount]

// ---- export : Stage F F1 - F4 apply and the eight F5 dirty flags (107 parameters, the frozen POC order) ----
// Main w03StageFApplyThroughF5Raw (lines 7430-7561) without the F0 call and without the F5 revision writes
export applyThroughF4(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<bool> rootIsRangeRootFlags, array<bool> rootIsDynamicFlags, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<int> rootLastUpdateSeqs, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> rootLiveSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, array<int> categoryMaRootSlots, array<int> categorySwingRootSlots, array<int> categoryAccumRootSlots, array<int> categoryTimeHlRootSlots, array<int> categoryFvgRootSlots, array<int> categoryPsychRootSlots, array<int> tf1mRootSlots, array<int> tf5mRootSlots, array<int> tf15mRootSlots, array<int> tf1hRootSlots, array<int> tf4hRootSlots, array<int> tfDRootSlots, array<int> stateCandidateRootSlots, array<int> stateActiveRootSlots, array<int> stateInvalidatedRootSlots, array<int> stateInverseWaitRootSlots, array<int> stateInverseActiveRootSlots, array<int> stateRetiredRootSlots, array<int> rootCategorySetPositions, array<int> rootTfSetPositions, array<int> rootStateSetPositions, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> structurallyActiveFvg1hRootSlots, array<int> structurallyActiveFvg4hRootSlots, array<int> structurallyActiveFvgDRootSlots, array<int> bullishFvgRootSlots, array<int> bearishFvgRootSlots, array<int> broadFvgRootSlots, array<int> rootFvgF
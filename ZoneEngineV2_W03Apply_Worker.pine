//@version=6
// ============================================================
// ZoneEngineV2_W03Apply_Worker - W03 Stage F F1 - F4 apply worker (PLAN S3-B)
//
// Applies the journal rows E1 -> E2 -> E3 -> E4 (append order inside a group) to
// the Main collections passed in by reference, and returns the eight F5 dirty flags
// and the advanced Root ID counter; the Main library performs the F5 revision
// increments and F6. F0 is not re-run here: the Main calls the F0 worker first.
// Every helper is the Main function of the same name with the Main Engine fields
// passed in as parameters; nextRootId is a local value returned to the Main.
// No import, no type, no persistent storage, no request, no drawing.
// ============================================================
library("ZoneEngineV2_W03Apply_Worker", overlay = false)

// ---- constants : exact copies of the Main declarations ----
const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int SEQ_UNSET       = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int ROOT_CANDIDATE      = 0
const int ROOT_ACTIVE         = 1
const int ROOT_INVALIDATED    = 2
const int ROOT_INVERSE_WAIT   = 3
const int ROOT_INVERSE_ACTIVE = 4
const int ROOT_RETIRED        = 5
const int FVG_NONE     = 0
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_D   = 1440
const int JGROUP_E1 = 1
const int JGROUP_E2 = 2
const int JGROUP_E3 = 3
const int JGROUP_E4 = 4
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_MA_UPDATE      = 3
const int JOP_SWING_TF_MERGE = 4
const int JOP_TIMEHL_LABEL   = 5
const int JOP_FVG_FRESH_END  = 6
const int JOP_ROOT_RETIRE    = 7
const int SWING_TF_MASK_NONE = 0
const int SWING_TF_MASK_5M   = 1
const int SWING_TF_MASK_15M  = 2
const int SWING_TF_MASK_1H   = 4
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
const int SUB_SWING_HIGH   = 1
const int SUB_SWING_LOW    = 2
const int SUB_ACCUM_UPPER  = 1
const int SUB_ACCUM_LOWER  = 2
const int SUB_TIMEHL_HIGH  = 1
const int SUB_TIMEHL_LOW   = 2

// Main originBucketAttachRaw (lines 2850-2876)
originBucketAttachRaw(array<int> rootIds, array<int> rootOriginKeys, array<bool> rootSlotLiveFlags, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketPrevRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootOriginKeys) and rootSlot < array.size(rootOriginBucketPrevRootSlots) and rootSlot < array.size(rootOriginBucketNextRootSlots) and rootSlot < array.size(rootOriginBucketExpectedRootIds)
    int key     = ID_NONE
    int oldHead = SLOT_INVALID
    if ok
        ok := array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
    if ok
        key := array.get(rootOriginKeys, rootSlot)
        ok  := key != ID_NONE and array.get(rootOriginBucketPrevRootSlots, rootSlot) == SLOT_INVALID and array.get(rootOriginBucketNextRootSlots, rootSlot) == SLOT_INVALID and array.get(rootOriginBucketExpectedRootIds, rootSlot) == ID_NONE
    if ok and map.contains(originKeyBucketHeadRootSlots, key)
        oldHead := map.get(originKeyBucketHeadRootSlots, key)
        ok      := oldHead != rootSlot and oldHead >= 0 and oldHead < array.size(rootIds)
        if ok
            ok := array.get(rootSlotLiveFlags, oldHead)
        if ok
            ok := array.get(rootOriginBucketExpectedRootIds, oldHead) == array.get(rootIds, oldHead) and array.get(rootOriginKeys, oldHead) == key
    if ok
        array.set(rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
        array.set(rootOriginBucketNextRootSlots,   rootSlot, oldHead)
        array.set(rootOriginBucketExpectedRootIds, rootSlot, expectedRootId)
        if oldHead != SLOT_INVALID
            array.set(rootOriginBucketPrevRootSlots, oldHead, rootSlot)
        map.put(originKeyBucketHeadRootSlots, key, rootSlot)
    ok

// Main rootPriceOrderUpperBoundRaw (lines 3059-3079)
rootPriceOrderUpperBoundRaw(array<int> rootIds, array<bool> rootIsRangeRootFlags, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, int pointTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(pointTick)
    if ok
        int lo = 0
        int hi = array.size(rootPriceOrderSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2))
            int slot = array.get(rootPriceOrderSlots, mid)
            bool entryOk = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootPointTicks) and slot < array.size(rootIsRangeRootFlags) and slot < array.size(rootPriceOrderPositions)
            if entryOk
                entryOk := array.get(rootSlotLiveFlags, slot) and array.get(rootPriceOrderPositions, slot) == mid and not array.get(rootIsRangeRootFlags, slot) and not na(array.get(rootPointTicks, slot))
            if not entryOk
                ok := false
            else if array.get(rootPointTicks, slot) <= pointTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Main rootPriceOrderInsertRaw (lines 3083-3129)
rootPriceOrderInsertRaw(array<int> rootIds, array<bool> rootIsRangeRootFlags, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootIsRangeRootFlags) and rootSlot < array.size(rootPriceOrderPositions)
    int newTick   = int(na)
    int insertPos = SLOT_INVALID
    int oldSize   = array.size(rootPriceOrderSlots)
    if ok
        ok := array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
    if ok
        newTick := array.get(rootPointTicks, rootSlot)
        ok      := not array.get(rootIsRangeRootFlags, rootSlot) and not na(newTick) and array.get(rootPriceOrderPositions, rootSlot) == SLOT_INVALID
    if ok
        [upperPos, upperOk] = rootPriceOrderUpperBoundRaw(rootIds, rootIsRangeRootFlags, rootPointTicks, rootSlotLiveFlags, rootPriceOrderSlots, rootPriceOrderPositions, newTick)
        ok        := upperOk
        insertPos := upperPos
    if ok
        int i = insertPos
        while ok and i < oldSize
            int slot = array.get(rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootPointTicks) and slot < array.size(rootIsRangeRootFlags) and slot < array.size(rootPriceOrderPositions)
            if ok
                ok := array.get(rootSlotLiveFlags, slot) and not array.get(rootIsRangeRootFlags, slot) and not na(array.get(rootPointTicks, slot)) and array.get(rootPriceOrderPositions, slot) == i
            i += 1
    if ok and insertPos > 0
        int leftSlot = array.get(rootPriceOrderSlots, insertPos - 1)
        ok := leftSlot >= 0 and leftSlot < array.size(rootIds) and leftSlot < array.size(rootSlotLiveFlags) and leftSlot < array.size(rootPointTicks) and leftSlot < array.size(rootIsRangeRootFlags) and leftSlot < array.size(rootPriceOrderPositions)
        if ok
            ok := array.get(rootSlotLiveFlags, leftSlot) and not array.get(rootIsRangeRootFlags, leftSlot) and not na(array.get(rootPointTicks, leftSlot)) and array.get(rootPriceOrderPositions, leftSlot) == insertPos - 1
        if ok
            ok := array.get(rootPointTicks, leftSlot) <= newTick
    if ok and insertPos < oldSize
        ok := array.get(rootPointTicks, array.get(rootPriceOrderSlots, insertPos)) > newTick
    if ok
        array.push(rootPriceOrderSlots, rootSlot)
        int i = oldSize
        while i > insertPos
            int movedSlot = array.get(rootPriceOrderSlots, i - 1)
            array.set(rootPriceOrderSlots, i, movedSlot)
            array.set(rootPriceOrderPositions, movedSlot, i)
            i -= 1
        array.set(rootPriceOrderSlots, insertPos, rootSlot)
        array.set(rootPriceOrderPositions, rootSlot, insertPos)
    ok

// Main rootResetSlotRaw (lines 3997-4068)
rootResetSlotRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<bool> rootIsRangeRootFlags, array<bool> rootIsDynamicFlags, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<int> rootLastUpdateSeqs, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderPositions, array<int> rootCategorySetPositions, array<int> rootTfSetPositions, array<int> rootStateSetPositions, array<int> rootFvgFreshSetPositions, array<int> rootFvgStructuralStateSetPositions, array<int> rootFvgDirectionSetPositions, array<int> rootFvgBroadSetPositions, array<int> rootFvgNativeBottomOrderPositions, array<int> rootFvgNativeTopOrderPositions, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> rootSwingTfMasks, array<int> rootPruneRevisions, array<int> rootOriginBucketPrevRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int rootSlot) =>
    array.set(rootIds,               rootSlot, ID_NONE)
    array.set(rootOriginKeys,        rootSlot, ID_NONE)
    array.set(rootCategories,        rootSlot, int(na))
    array.set(rootSubtypes,          rootSlot, int(na))
    array.set(rootTfCodes,           rootSlot, int(na))
    array.set(rootOriginTimes,       rootSlot, int(na))
    array.set(rootOriginEndTimes,    rootSlot, int(na))
    array.set(rootConfirmedTimes,    rootSlot, int(na))
    array.set(rootPointPrices,       rootSlot, float(na))
    array.set(rootNativeBottoms,     rootSlot, float(na))
    array.set(rootNativeTops,        rootSlot, float(na))
    array.set(rootIsRangeRootFlags,  rootSlot, false)
    array.set(rootIsDynamicFlags,    rootSlot, false)
    array.set(rootStates,            rootSlot, ROOT_CANDIDATE)
    array.set(rootPairKeys,          rootSlot, ID_NONE)
    array.set(rootDirections,        rootSlot, FVG_NONE)
    array.set(rootFvgFreshFlags,     rootSlot, false)
    array.set(rootIsBroadFvgFlags,   rootSlot, false)
    array.set(rootLabelMasks,        rootSlot, 0)
    array.set(rootLastUpdateSeqs,    rootSlot, SEQ_UNSET)
    array.set(rootPointTicks,        rootSlot, int(na))
    array.set(rootNativeBottomTicks, rootSlot, int(na))
    array.set(rootNativeTopTicks,    rootSlot, int(na))
    array.set(rootSlotLiveFlags,     rootSlot, false)
    array.set(rootCategorySetPositions, rootSlot, SLOT_INVALID)
    array.set(rootTfSetPositions,       rootSlot, SLOT_INVALID)
    array.set(rootStateSetPositions,    rootSlot, SLOT_INVALID)
    array.set(rootFvgFreshSetPositions,           rootSlot, SLOT_INVALID)
    array.set(rootFvgStructuralStateSetPositions, rootSlot, SLOT_INVALID)
    array.set(rootFvgDirectionSetPositions,       rootSlot, SLOT_INVALID)
    array.set(rootFvgBroadSetPositions,           rootSlot, SLOT_INVALID)
    array.set(rootFvgNativeBottomOrderPositions, rootSlot, SLOT_INVALID)
    array.set(rootFvgNativeTopOrderPositions,    rootSlot, SLOT_INVALID)
    array.set(rootParticipationHeadEdgeIndexes, rootSlot, SLOT_INVALID)
    array.set(rootParticipationCounts,          rootSlot, 0)
    array.set(rootPriceOrderPositions, rootSlot, SLOT_INVALID)
    array.set(rootPruneRevisions, rootSlot, 0)
    array.set(rootOriginBucketPrevRootSlots,   rootSlot, SLOT_INVALID)
    array.set(rootOriginBucketNextRootSlots,   rootSlot, SLOT_INVALID)
    array.set(rootOriginBucketExpectedRootIds, rootSlot, ID_NONE)
    array.set(rootSwingTfMasks, rootSlot, SWING_TF_MASK_NONE)

// Main rootAllocSlotRaw (lines 4074-4168)
rootAllocSlotRaw(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<bool> rootIsRangeRootFlags, array<bool> rootIsDynamicFlags, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<int> rootLastUpdateSeqs, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> rootLiveSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, array<int> rootPriceOrderPositions, array<int> rootCategorySetPositions, array<int> rootTfSetPositions, array<int> rootStateSetPositions, array<int> rootFvgFreshSetPositions, array<int> rootFvgStructuralStateSetPositions, array<int> rootFvgDirectionSetPositions, array<int> rootFvgBroadSetPositions, array<int> rootFvgNativeBottomOrderPositions, array<int> rootFvgNativeTopOrderPositions, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> rootSwingTfMasks, array<int> rootPruneRevisions, array<int> rootOriginBucketPrevRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int nextRootId) =>
    int rootSlot = SLOT_INVALID
    if array.size(rootFreeSlots) > 0
        rootSlot := array.pop(rootFreeSlots)
        rootResetSlotRaw(rootIds, rootOriginKeys, rootCategories, rootSubtypes, rootTfCodes, rootOriginTimes, rootOriginEndTimes, rootConfirmedTimes, rootPointPrices, rootNativeBottoms, rootNativeTops, rootIsRangeRootFlags, rootIsDynamicFlags, rootStates, rootPairKeys, rootDirections, rootFvgFreshFlags, rootIsBroadFvgFlags, rootLabelMasks, rootLastUpdateSeqs, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootSlotLiveFlags, rootPriceOrderPositions, rootCategorySetPositions, rootTfSetPositions, rootStateSetPositions, rootFvgFreshSetPositions, rootFvgStructuralStateSetPositions, rootFvgDirectionSetPositions, rootFvgBroadSetPositions, rootFvgNativeBottomOrderPositions, rootFvgNativeTopOrderPositions, rootParticipationHeadEdgeIndexes, rootParticipationCounts, rootSwingTfMasks, rootPruneRevisions, rootOriginBucketPrevRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, rootSlot)
    else
        rootSlot := array.size(rootIds)
        array.push(rootIds,               ID_NONE)
        array.push(rootOriginKeys,        ID_NONE)
        array.push(rootCategories,        int(na))
        array.push(rootSubtypes,          int(na))
        array.push(rootTfCodes,           int(na))
        array.push(rootOriginTimes,       int(na))
        array.push(rootOriginEndTimes,    int(na))
        array.push(rootConfirmedTimes,    int(na))
        array.push(rootPointPrices,       float(na))
        array.push(rootNativeBottoms,     float(na))
        array.push(rootNativeTops,        float(na))
        array.push(rootIsRangeRootFlags,  false)
        array.push(rootIsDynamicFlags,    false)
        array.push(rootStates,            ROOT_CANDIDATE)
        array.push(rootPairKeys,          ID_NONE)
        array.push(rootDirections,        FVG_NONE)
        array.push(rootFvgFreshFlags,     false)
        array.push(rootIsBroadFvgFlags,   false)
        array.push(rootLabelMasks,        0)
        array.push(rootLastUpdateSeqs,    SEQ_UNSET)
        array.push(rootPointTicks,        int(na))
        array.push(rootNativeBottomTicks, int(na))
        array.push(rootNativeTopTicks,    int(na))
        array.push(rootSlotLiveFlags,     false)
        array.push(rootCategorySetPositions, SLOT_INVALID)
        array.push(rootTfSetPositions,       SLOT_INVALID)
        array.push(rootStateSetPositions,    SLOT_INVALID)
        array.push(rootFvgFreshSetPositions,           SLOT_INVALID)
        array.push(rootFvgStructuralStateSetPositions, SLOT_INVALID)
        array.push(rootFvgDirectionSetPositions,       SLOT_INVALID)
        array.push(rootFvgBroadSetPositions,           SLOT_INVALID)
        array.push(rootFvgNativeBottomOrderPositions, SLOT_INVALID)
        array.push(rootFvgNativeTopOrderPositions,    SLOT_INVALID)
        array.push(rootParticipationHeadEdgeIndexes, SLOT_INVALID)
        array.push(rootParticipationCounts,          0)
        array.push(rootPriceOrderPositions, SLOT_INVALID)
        array.push(rootPruneRevisions, 0)
        array.push(rootOriginBucketPrevRootSlots,   SLOT_INVALID)
        array.push(rootOriginBucketNextRootSlots,   SLOT_INVALID)
        array.push(rootOriginBucketExpectedRootIds, ID_NONE)
        array.push(rootSwingTfMasks, SWING_TF_MASK_NONE)
    int newRootId = nextRootId
    array.set(rootIds,           rootSlot, newRootId)
    array.set(rootSlotLiveFlags, rootSlot, true)
    map.put(rootIdToSlot, newRootId, rootSlot)
    array.push(rootLiveSlots, rootSlot)
    array.push(rootIdOrderSlots, rootSlot)
    [rootSlot, newRootId + 1]

// Main rootWritePricesAndTicksRaw (lines 4201-4214)
rootWritePricesAndTicksRaw(array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, int rootSlot, float pointPrice, float nativeBottom, float nativeTop, float mintick) =>
    array.set(rootPointPrices,   rootSlot, pointPrice)
    array.set(rootNativeBottoms, rootSlot, nativeBottom)
    array.set(rootNativeTops,    rootSlot, nativeTop)
    int pointTick  = na(pointPrice)   ? int(na) : int(math.round(pointPrice   / mintick))
    int bottomTick = na(nativeBottom) ? int(na) : int(math.round(nativeBottom / mintick))
    int topTick    = na(nativeTop)    ? int(na) : int(math.round(nativeTop    / mintick))
    array.set(rootPointTicks,        rootSlot, pointTick)
    array.set(rootNativeBottomTicks, rootSlot, bottomTick)
    array.set(rootNativeTopTicks,    rootSlot, topTick)

// Main rootPriceOrderMoveRaw (lines 4234-4306)
rootPriceOrderMoveRaw(array<int> rootIds, array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<bool> rootIsRangeRootFlags, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, int rootSlot, int expectedRootId, float newPointPrice, float mintick) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootIsRangeRootFlags) and rootSlot < array.size(rootPointPrices) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootNativeBottoms) and rootSlot < array.size(rootNativeTops) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks) and rootSlot < array.size(rootPriceOrderPositions)
    int   orderSize       = array.size(rootPriceOrderSlots)
    int   oldPos          = SLOT_INVALID
    int   oldTick         = int(na)
    int   newPointTick    = int(na)
    float oldNativeBottom = na
    float oldNativeTop    = na
    if ok
        ok := not na(mintick) and mintick > 0 and not na(newPointPrice)
    if ok
        newPointTick := int(math.round(newPointPrice / mintick))
        ok := not na(newPointTick)
    if ok
        ok := array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId and not array.get(rootIsRangeRootFlags, rootSlot)
    if ok
        oldTick := array.get(rootPointTicks, rootSlot)
        oldPos  := array.get(rootPriceOrderPositions, rootSlot)
        ok      := not na(oldTick) and oldPos != SLOT_INVALID and oldPos >= 0 and oldPos < orderSize
    if ok
        ok := array.get(rootPriceOrderSlots, oldPos) == rootSlot
    if ok
        oldNativeBottom := array.get(rootNativeBottoms, rootSlot)
        oldNativeTop    := array.get(rootNativeTops,    rootSlot)
    int targetPos = oldPos
    if ok
        bool scanning = true
        int  i        = newPointTick >= oldTick ? oldPos + 1 : oldPos - 1
        while ok and scanning and i >= 0 and i < orderSize
            int slot = array.get(rootPriceOrderSlots, i)
            ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootPointTicks) and slot < array.size(rootIsRangeRootFlags) and slot < array.size(rootPriceOrderPositions)
            if ok
                ok := array.get(rootSlotLiveFlags, slot) and array.get(rootIds, slot) != ID_NONE and not array.get(rootIsRangeRootFlags, slot) and not na(array.get(rootPointTicks, slot)) and array.get(rootPriceOrderPositions, slot) == i
            if ok
                int neighborTick = array.get(rootPointTicks, slot)
                if newPointTick >= oldTick
                    if neighborTick <= newPointTick
                        targetPos := i
                        i += 1
                    else
                        scanning := false
                else
                    if neighborTick > newPointTick
                        targetPos := i
                        i -= 1
                    else
                        scanning := false
    if ok
        if targetPos > oldPos
            int i = oldPos
            while i < targetPos
                int movedSlot = array.get(rootPriceOrderSlots, i + 1)
                array.set(rootPriceOrderSlots, i, movedSlot)
                array.set(rootPriceOrderPositions, movedSlot, i)
                i += 1
        else if targetPos < oldPos
            int i = oldPos
            while i > targetPos
                int movedSlot = array.get(rootPriceOrderSlots, i - 1)
                array.set(rootPriceOrderSlots, i, movedSlot)
                array.set(rootPriceOrderPositions, movedSlot, i)
                i -= 1
        rootWritePricesAndTicksRaw(rootPointPrices, rootNativeBottoms, rootNativeTops, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootSlot, newPointPrice, oldNativeBottom, oldNativeTop, mintick)
        if targetPos != oldPos
            array.set(rootPriceOrderSlots, targetPos, rootSlot)
            array.set(rootPriceOrderPositions, rootSlot, targetPos)
    ok

// Main fvgNativeBottomOrderUpperBoundRaw (lines 4328-4351)
fvgNativeBottomOrderUpperBoundRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<bool> rootIsRangeRootFlags, array<int> rootDirections, array<int> rootNativeBottomTicks, array<bool> rootSlotLiveFlags, array<int> fvgNativeBottomOrderRootSlots, array<int> rootFvgNativeBottomOrderPositions, int targetTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(targetTick)
    if ok
        int lo = 0
        int hi = array.size(fvgNativeBottomOrderRootSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2.0))
            int slot = array.get(fvgNativeBottomOrderRootSlots, mid)
            bool entryOk = false
            entryOk := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootCategories) and slot < array.size(rootTfCodes) and slot < array.size(rootDirections) and slot < array.size(rootIsRangeRootFlags) and slot < array.size(rootNativeBottomTicks) and slot < array.size(rootFvgNativeBottomOrderPositions)
            if entryOk
                int entryTf  = array.get(rootTfCodes,    slot)
                int entryDir = array.get(rootDirections, slot)
                entryOk := array.get(rootSlotLiveFlags, slot) and array.get(rootIds, slot) != ID_NONE and array.get(rootCategories, slot) == CAT_FVG and (entryTf == TF_1H or entryTf == TF_4H or entryTf == TF_D) and (entryDir == FVG_BULLISH or entryDir == FVG_BEARISH) and array.get(rootIsRangeRootFlags, slot) and not na(array.get(rootNativeBottomTicks, slot)) and array.get(rootFvgNativeBottomOrderPositions, slot) == mid
            if not entryOk
                ok := false
            else if array.get(rootNativeBottomTicks, slot) <= targetTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Main fvgNativeTopOrderUpperBoundRaw (lines 4356-4379)
fvgNativeTopOrderUpperBoundRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<bool> rootIsRangeRootFlags, array<int> rootDirections, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> fvgNativeTopOrderRootSlots, array<int> rootFvgNativeTopOrderPositions, int targetTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(targetTick)
    if ok
        int lo = 0
        int hi = array.size(fvgNativeTopOrderRootSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2.0))

splitPlanClearRaw(SplitTouchPlan plan) =>
    array.clear(plan.targetPhysicalIndexes)
    array.clear(plan.sourceOldCoreSlots)
    array.clear(plan.sourceOldCoreIds)
    array.clear(plan.markOffsets)
    array.clear(plan.markCounts)
    array.clear(plan.truncatedFlags)
    array.clear(plan.baseSeqs)
    array.clear(plan.times)
    array.clear(plan.sides)
    array.clear(plan.contactBottoms)
    array.clear(plan.contactTops)
    array.clear(plan.closeAtTouches)
    array.clear(plan.generationIds)
    array.clear(plan.isNormalFlags)
    array.clear(plan.touchNos)
    array.clear(plan.weakByDepthFlags)
    array.clear(plan.maxDepthPcts)
// W08 B12: Split TouchMark assignment plan (read-only; no ring is written). s = the W08Core Split plan result (must equal
// splitRelationCount), m = the B11 Merge TouchMark plan result (must equal mergeRelationCount; the B11 relation-side
// arrays must hold 2 * m rows). A Split child that is a Merge target (one B08 relation per Candidate, else fail) is
// delegated to the B11 plan (no row). Every other child is SPLIT_LOCAL: it must appear in one Split relation only (else
// fail) and gets one row in Split relation / child order: the source old ring is read with historyExtract per Side (the
// B10 validation) and walked in its logical order across both Sides; a mark is copied whole (no dedupe, no re-sort)
// when the child has a winner on the mark's Side whose exact EffectiveRange intersects the contact (inclusive, exact
// floats; na / inverted range fails). Truncated per Side = the child has that Side winner and the source Side flag is
// set. A row above the ring capacity fails. Returns the SPLIT_LOCAL target count; -1 with the plan empty on any fault.
export splitPlanBuild(TouchRing ring, SplitTouchPlan plan, int s, int splitRelationCount, array<int> splitRelations, array<int> splitChildren, int m, int mergeRelationCount, array<int> mergeRelations, array<int> mergePlanOffsets, array<int> mergePlanCounts, array<bool> mergePlanTruncatedFlags, int physicalCount, array<int> supportWinnerIndexes, array<int> resistanceWinnerIndexes, array<float> winnerExactPrices, array<int> ei, array<float> ef, array<int> pI, array<float> pF) =>
    splitPlanClearRaw(plan)
    int  cap = ring.touchMarkCapacityPerCore
    bool ok  = s >= 0 and s == splitRelationCount and array.size(splitRelations) == 5 * s and m >= 0 and m == mergeRelationCount and array.size(mergeRelations) == 5 * m and array.size(mergePlanOffsets) == 2 * m and array.size(mergePlanCounts) == 2 * m and array.size(mergePlanTruncatedFlags) == 2 * m and physicalCount >= 0 and physicalCount <= array.size(supportWinnerIndexes) and physicalCount <= array.size(resistanceWinnerIndexes)
    array<int>  mergeOf = array.new_int(ok ? physicalCount : 0, -1)
    array<bool> seenLocal = array.new_bool(ok ? physicalCount : 0, false)
    int j = 0
    while ok and j < m
        int p = array.get(mergeRelations, 5 * j)
        ok := p >= 0 and p < physicalCount
        if ok
            ok := array.get(mergeOf, p) == -1
            array.set(mergeOf, p, j)
        j += 1
    array<int>   tT  = array.new_int(0)
    array<float> tB  = array.new_float(0)
    array<float> tU  = array.new_float(0)
    array<int>   iS  = array.new_int(0)
    array<int>   iR  = array.new_int(0)
    array<int>   src = array.new_int(0)
    int i = 0
    while ok and i < s
        int sl  = array.get(splitRelations, 5 * i)
        int id  = array.get(splitRelations, 5 * i + 1)

                            use := array.get(pI, o + PI_CORE_SLOT) == sl and array.get(pI, o + PI_CORE_ID) == id and array.get(pI, o + PI_SIDE) == sv
                            if use and c0 + projAppendsRaw(pI, pF, sl, id, k - n) < dr
                                use := false

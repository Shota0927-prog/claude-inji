//@version=5
// =====================================================================================
// POINT MASTER NET5 STRATEGY  ―  5 分足の 5 ロジックだけで NET を作り、エントリー・保有継続・反転警戒・決済を検証する
// =====================================================================================
// 検知処理は持たない（request.* も使わない）。時刻修正版の Source（PM-A-515 / PM-B-515 / PM-C-515）の
// 単体診断出力 STUDY DATA BUS / STUDY META BUS（META format 2）を 5 本ぶん受け取り、点数・保持・売買だけを行う。
// 既存の Point Master・Source・Decision・検知ロジックは変更しない。
//
// 【対象ロジック（5 分足のみ。15 分足・⑥ EMA1000 反発は対象外）】
//   ⑤ EMA200 反発（Logic05・2 点）/ ⑨ EMA200 ブレイク（Logic09・2 点）      … MA 系   上限 2 点
//   ⑯ ダブルトップ・ボトム（Logic16・2 点）/ ⑮ 三尊・逆三尊（Logic15・1 点）  … 波形系 上限 2 点
//   ㉔ SAT（Logic24・状態型・1 点）                                           … SAT    上限 1 点
//   LONG SCORE = 買いの MA 系 + 買いの波形系 + 買いの SAT（各系統の合計に上限を掛けてから合算。最大 5）
//   SHORT SCORE も同じ配点。NET = LONG − SHORT（−5〜+5）。異なるロジックの逆方向根拠はそれぞれ残す。
//
// 【接続（10 入力）】同じ 5 分足チャートに Source を 5 本追加し、各 Source の「⑨ 単体診断」で次を選ぶ（時間足は 5M）。
//   PM-A-515 ①: Logic05 EMA200 Reb   → ⑤ DATA / ⑤ META
//   PM-A-515 ②: Logic09 EMA200 Brk   → ⑨ DATA / ⑨ META
//   PM-B-515 ①: Logic16 DT/DB        → ⑯ DATA / ⑯ META
//   PM-B-515 ②: Logic15 H&S          → ⑮ DATA / ⑮ META
//   PM-C-515  : Logic24 SAT          → ㉔ DATA / ㉔ META
//   各入力に Source の "STUDY DATA BUS" / "STUDY META BUS" を選び、「10 入力を接続済み」を ON にする。
//   Source の他の設定（保持本数・採用・状態管理ルール）は既定のままを想定（下の注意を参照）。
//
// 【受け取る値（STUDY DATA BUS のビット。Source 側の定義のまま）】
//   bit 0 / 1 : 生シグナル LONG / SHORT（その 5M 確定足で検知関数が発火。Source は確定時に出す = 時刻修正版）
//   bit 2 / 3 : 有効な CURRENT LONG / SHORT（SAT はこれを「有効な方向状態」として使う）
//   bit 8 / 9 : 価格否定による解除 LONG / SHORT（Source の明示的な無効化通知）
//   bit 36    : この 5 分足で 5M の新しい確定足を処理した / bit 37-50 : slot 下位（META と同じ足の照合）
//   META : format 2・SourceID・TF = 5M・ロジック番号・状態（0 出力中 / 1 準備中 / 4 不整合）・採用・slot = この足の time_close
//   受け付けるのは「META format 2・期待した Source / ロジック / 5M・slot = この足の確定時刻・状態 0・DATA の slot 一致」だけ。
//   旧形式（format 1 = 時刻修正前の Source）・取り違え・時刻不一致・準備中は、0 点ではなく「データ不備」として区別する。
//
// 【保持】
//   ⑤⑨⑯⑮（イベント型）: 成立した 5 分足の確定時刻から「保持時間」（初期 15 分）。成立時刻 + 保持時間 に達した確定足で期限切れ。
//     同方向の再成立は加点せず期限だけ更新 / 逆方向の成立は旧方向を解除して切替 /
//     Source の価格否定（bit 8 / 9）が保持中の方向に出たら、その足で解除 / 同じ足で両方向が出たら変更しない（件数だけ数える）。
//   ㉔ SAT（状態型）: Source の有効な方向状態が続く間だけ 1 点。解除・反転に追従。
//     状態の継続は新規成立として扱わず、「無し→有効」と「方向転換」だけを新しいイベントにする。
//     最初に受信した足・データ不備から復帰した足は基準にするだけで、新しいイベントにしない（既にあった状態を新規扱いしない）。
//
// 【売買（同時保有 1。追加・ナンピン・ピラミッディングなし。判定は確定 5 分足、約定は次足始値）】
//   LONG エントリー : その足で新しい買いイベントが成立 and NET ≥ +3 and SHORT ≤ 1 and 買い根拠が 2 系統以上（⑤⑨ だけは 1 系統）
//   SHORT エントリー: 左右反転
//   NET 決済（LONG）: その足で新しい売りイベントが成立 and SHORT ≥ 2 and NET ≤ 0（SHORT 保有は反転）
//   固定 SL : 実際の約定価格 ∓ SL 幅（初期 15 ドル。最適化した値ではない）。strategy.exit の loss（tick）で
//             約定価格から計算させ、足の途中でも約定するストップ注文。建値移動・トレーリング・固定 TP なし。SL は動かさない。
//   データ不備の足では新規エントリーと NET 決済の判定をしない（SL 注文は残る）。
//   決済注文を出した判定足・SL で決済された足では新規エントリーしない。新規エントリーには必ずその足の新しいイベントが要る
//   （期限切れで反対点数が減っただけ・前の条件が残っているだけでは入らない）。
//
// 【保有中の判断】（LONG 保有。SHORT は反転）
//   反転警戒   : 新しい売りイベントが成立し SHORT ≥ 2（以後 SHORT ≥ 2 の間は継続）
//   保有支持あり: LONG ≥ 2 and NET ≥ +2
//   支持低下   : 上のどちらでもない（期限切れによる支持低下だけでは決済しない）
//
// 【注意】
//   ・価格否定の通知は Source 側の有効根拠（Source の保持本数。既定 5M 6 本 = 30 分）が生きている間だけ出る。
//     この Strategy の保持時間を Source の保持本数 × 5 分より長くすると、その差の期間は価格否定を受け取れない。
//   ・Source の「状態管理ルール」（同時両方向の裁定）は既定「無視」を想定。この Strategy は生シグナルを読むので、
//     同じ足の両方向は Source の設定に関係なく「変更しない」で扱う。
//   ・取引コストは strategy() の既定で 手数料 0・スリッページ 0（未設定）。成績は手数料込みではない。
//     「表示用 往復コスト控除」を入れると、表の「コスト控除後」だけにその額 × 件数を差し引いて表示する。
//   ・表の件数・損益は読み込めた履歴での実績で、将来の勝率・収益性を示すものではない。
// =====================================================================================
strategy(
     title                   = "POINT MASTER NET5 STRATEGY",
     shorttitle              = "PM-NET5",
     overlay                 = true,
     pyramiding              = 0,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     initial_capital         = 100000,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0,
     slippage                = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     max_labels_count        = 500
 )

// =====================================================================================
// §0. 接続（Source 5 本の STUDY DATA / META BUS）
// =====================================================================================
grpIn = "⓪ 接続（各 Source の ⑨ 単体診断で対象ロジック・5M を選ぶ）"
d05 = input.source(close, "⑤ DATA ← PM-A-515（Logic05 EMA200 Reb / 5M）: STUDY DATA BUS", group = grpIn)
m05 = input.source(close, "⑤ META ← 同じ PM-A-515 : STUDY META BUS", group = grpIn)
d09 = input.source(close, "⑨ DATA ← PM-A-515（Logic09 EMA200 Brk / 5M）: STUDY DATA BUS", group = grpIn)
m09 = input.source(close, "⑨ META ← 同じ PM-A-515 : STUDY META BUS", group = grpIn)
d16 = input.source(close, "⑯ DATA ← PM-B-515（Logic16 DT/DB / 5M）: STUDY DATA BUS", group = grpIn)
m16 = input.source(close, "⑯ META ← 同じ PM-B-515 : STUDY META BUS", group = grpIn)
d15 = input.source(close, "⑮ DATA ← PM-B-515（Logic15 H&S / 5M）: STUDY DATA BUS", group = grpIn)
m15 = input.source(close, "⑮ META ← 同じ PM-B-515 : STUDY META BUS", group = grpIn)
d24 = input.source(close, "㉔ DATA ← PM-C-515（Logic24 SAT / 5M）: STUDY DATA BUS", group = grpIn)
m24 = input.source(close, "㉔ META ← 同じ PM-C-515 : STUDY META BUS", group = grpIn)
netConnected = input.bool(false, "10 入力を接続済み（確認したら ON）", group = grpIn,
     tooltip = "OFF の間は全ロジックを「未接続」とし、点数・売買判定をしません。")

// =====================================================================================
// §1. 設定（配点・閾値は仕様どおりの固定値。成績を見て変えない）
// =====================================================================================
grpSet  = "① 設定（初期値は検証開始用。最適化した値ではない）"
holdMin = input.int(15, "⑤⑨⑯⑮ の保持時間（分）", group = grpSet, minval = 5, step = 5,
     tooltip = "成立した 5 分足の確定時刻から数える。成立時刻 + 保持時間 に達した確定足で期限切れ。")
slUsd   = input.float(15.0, "固定 SL 幅（USD）", group = grpSet, minval = 0.01, step = 0.5,
     tooltip = "実際の約定価格から LONG は −、SHORT は +。保有中は動かさない。")
costUsd = input.float(0.0, "表示用 往復コスト控除（USD / 1 取引）", group = grpSet, minval = 0.0, step = 0.1,
     tooltip = "表の「コスト控除後」だけに使う。strategy の損益（手数料 0・スリッページ 0）には影響しない。")

grpView  = "② 表示"
showTbl  = input.bool(true, "テーブルを表示", group = grpView)
tblPos   = input.string(position.top_right, "表示位置", group = grpView,
     options = [position.top_right, position.bottom_right, position.middle_right, position.top_left, position.bottom_left])
tblSize  = input.string(size.small, "文字サイズ", options = [size.tiny, size.small, size.normal], group = grpView)
showLbl  = input.bool(true, "合図・約定・決済のラベルを表示", group = grpView)
colLong  = input.color(color.new(#26a69a, 0),  "LONG 色",  group = grpView, inline = "col")
colShort = input.color(color.new(#ef5350, 0),  "SHORT 色", group = grpView, inline = "col")
colBg    = input.color(color.new(#1e222d, 15), "背景色",   group = grpView)
colTxt   = input.color(color.new(#d1d4dc, 0),  "文字色",   group = grpView)

bool isChart5M = timeframe.isminutes and timeframe.multiplier == 5

// =====================================================================================
// §2. 判定（受信の検証 → 保持 → 点数 → 約定の検出 → 保有判断 → 注文）
// tests/net5_sim.py はこの区間をそのまま Python へ変換して実行する（区間内は履歴参照 [] を使わない）。
// =====================================================================================
// ==== NET5 Logic (begin)
int   NB_BASE  = 1577836800000          // 2020-01-01 00:00 UTC（Source の slot 基準）
float NB_SLOTS = 4194304.0              // 2^22
int   HOLD_MS  = holdMin * 60000
var NAMES   = array.from("⑤ EMA200反発", "⑨ EMA200ブレイク", "⑯ ダブルトップ・ボトム", "⑮ 三尊・逆三尊", "㉔ SAT")
var SHORTN  = array.from("⑤", "⑨", "⑯", "⑮", "㉔SAT")
var EV_PTS  = array.from(2, 2, 2, 1)    // ⑤ ⑨ ⑯ ⑮（㉔ SAT は 1 点）
var EXP_SID = array.from(1, 1, 2, 2, 3) // 期待する SourceID（1 A / 2 B / 3 C）
var EXP_LG  = array.from(5, 9, 16, 15, 24)
// 入力の状態（0 = OK。1 以降は 0 点ではなくデータ不備）
var ST_TXT  = array.from("OK", "未接続", "Source 出力なし（na）", "旧形式（時刻修正前の Source）", "接続不正（Source / ロジック / 時間足の取り違え）", "時刻不一致", "Source データ準備中", "Source 更新不整合", "Source の採用 OFF（SAT 5M）", "DATA / META 不一致", "5 分足以外のチャート")

nf_num(float v, float lim) =>
    not na(v) and v >= 0 and v < lim and v == math.floor(v)

nf_bit(float v, int b) =>
    math.floor(v / math.pow(2, b)) % 2 > 0.5

// 1 Source の受信状態（ST_TXT の番号）。DATA は META の状態 0 の足だけ値がある
nf_status(float d, float m, int sid, int lg, bool needAdopt, float slotNow) =>
    bool  mNum  = nf_num(m, 137438953472.0)
    float mFmt  = mNum ? m % 4 : na
    float mSid  = mNum ? math.floor(m / 4) % 4 : na
    float mTf   = mNum ? math.floor(m / 16) % 4 : na
    float mLg   = mNum ? math.floor(m / 64) % 32 : na
    float mSt   = mNum ? math.floor(m / 2048) % 8 : na
    float mAd   = mNum ? math.floor(m / 16384) % 2 : na
    float mSlot = mNum ? math.floor(m / 32768) : na
    bool  dNum  = nf_num(d, 2251799813685248.0)
    bool  dSync = dNum and mNum and math.floor(d / 137438953472.0) == mSlot % 16384
    bool  dNb   = dNum and nf_bit(d, 36)
    int   st    = na(m) ? 2 : not mNum ? 4 : mFmt == 1 ? 3 : (mFmt != 2 or mSid != sid or mTf != 1 or mLg != lg) ? 4 : mSlot != slotNow ? 5 : mSt == 1 ? 6 : mSt == 4 ? 7 : mSt != 0 ? 4 : (needAdopt and mAd != 1) ? 8 : not dSync ? 9 : not dNb ? 7 : 0
    st

// ---- 状態 ----
var int    nLastT    = 0                      // 最後に処理した 5 分足の time_close（同じ足を 2 回処理しない）
var EV_DIR = array.new_int(4, 0)              // ⑤ ⑨ ⑯ ⑮ の有効方向（+1 買い / −1 売り / 0 なし）
var EV_T   = array.new_int(4, 0)              // 最後に成立した 5 分足の time_close
var int    satDir    = 0                      // ㉔ SAT の有効な方向状態
var bool   satKnown  = false                  // SAT の基準があるか（最初の受信・データ不備の後は false）
var IN_ST  = array.new_int(5, 1)              // 入力の状態（ST_TXT の番号）
var NEW_L  = array.new_bool(5, false)         // この足で新しく成立した買いイベント（SAT は 無し→買い / 売り→買い）
var NEW_S  = array.new_bool(5, false)
var GONE   = array.new_int(5, 0)              // この足の解除理由 1 期限切れ / 2 価格否定 / 3 逆方向で切替 / 4 SAT 解除 / 5 SAT 反転
var PREV_D = array.new_int(5, 0)              // この足の処理前の方向
var int    nBoth     = 0                      // 同じ足で両方向（変更しない）の件数
var bool   nAllOk    = false
var int    nMaL     = 0
var int    nMaS     = 0
var int    nWvL     = 0
var int    nWvS     = 0
var int    nSaL     = 0
var int    nSaS     = 0
var int    nL       = 0
var int    nS       = 0
var int    nNet     = 0
var int    nFamL    = 0
var int    nFamS    = 0
var bool   nNewL = false
var bool   nNewS = false
// 売買
var int    nTotSeen    = 0                    // 確認済みの取引数（決済済み + 保有中）
var int    nClosedSeen = 0
var bool   nEntryPend  = false
var bool   nExitPend   = false
var int    nPosDir     = 0
var float  nFillPrice  = na
var float  nSlPrice    = na
var int    nSlTicks    = 0
var float  nSigPrice   = na                   // 直近のエントリー合図の価格（判定足の終値）
var int    nHoldSt     = 0                    // 0 なし / 1 保有支持あり / 2 支持低下 / 3 反転警戒
var string nHoldWhy    = ""
var string nCarry      = ""                   // データ不備の足で起きた変化（次の判定へ持ち越す）
var string nLastChg    = ""
var int    nEntrySigN  = 0
var int    nExitSigN   = 0
var int    nBlockSame  = 0                    // 決済と同じ足で新規条件が成立したが入らなかった件数
// 成績（方向 d = 0 LONG / 1 SHORT。各 8 項目 : 件数 / 勝ち / 負け / 総利益 / 総損失 / 純損益 / SL 決済 / NET 決済）
var TS = array.new_float(16, 0.0)

// ---- この足の描画用（毎足リセット）----
int    dSigDir     = 0
float  dSigPrice   = na
int    dExitSig    = 0
float  dExitPrice  = na
int    dFillDir    = 0
float  dFillPrice  = na
float  dFillSL     = na
int    dCloseDir   = 0
float  dClosePrice = na
string dCloseTxt   = ""

bool nRun = isChart5M and barstate.isconfirmed and time_close > nLastT
if nRun
    nLastT := time_close
    float slotNow = (time_close - NB_BASE) / 300000.0
    bool  slotOk  = slotNow >= 0 and slotNow < NB_SLOTS and slotNow == math.floor(slotNow)
    D_IN = array.from(d05, d09, d16, d15, d24)
    M_IN = array.from(m05, m09, m16, m15, m24)
    bool allOk = true
    for i = 0 to 4
        int st = not netConnected ? 1 : not slotOk ? 5 : nf_status(array.get(D_IN, i), array.get(M_IN, i), array.get(EXP_SID, i), array.get(EXP_LG, i), i == 4, slotNow)
        array.set(IN_ST, i, st)
        allOk := allOk and st == 0
        array.set(NEW_L, i, false)
        array.set(NEW_S, i, false)
        array.set(GONE, i, 0)
        array.set(PREV_D, i, i < 4 ? array.get(EV_DIR, i) : satDir)
    nAllOk := allOk

    // ---- ⑤ ⑨ ⑯ ⑮ : ① 期限切れ → ② 価格否定（Source の解除通知）→ ③ 新規成立 ----
    for i = 0 to 3
        // ① 自前の保持時間（時刻で進む。データ不備の足でも期限は来る）
        if array.get(EV_DIR, i) != 0 and time_close >= array.get(EV_T, i) + HOLD_MS
            array.set(EV_DIR, i, 0)
            array.set(GONE, i, 1)
        if array.get(IN_ST, i) == 0
            float dv   = array.get(D_IN, i)
            bool  rawL = nf_bit(dv, 0)
            bool  rawS = nf_bit(dv, 1)
            bool  negL = nf_bit(dv, 8)
            bool  negS = nf_bit(dv, 9)
            int   dirA = array.get(EV_DIR, i)
            if (dirA == 1 and negL) or (dirA == -1 and negS)
                array.set(EV_DIR, i, 0)
                array.set(GONE, i, 2)
            if rawL and rawS
                nBoth += 1
            else if rawL or rawS
                int nd = rawL ? 1 : -1
                if array.get(EV_DIR, i) == -nd
                    array.set(GONE, i, 3)
                array.set(EV_DIR, i, nd)
                array.set(EV_T, i, time_close)
                if nd == 1
                    array.set(NEW_L, i, true)
                else
                    array.set(NEW_S, i, true)

    // ---- ㉔ SAT : 有効な方向状態に追従。無し→有効・方向転換だけを新しいイベントにする ----
    if array.get(IN_ST, 4) == 0
        float ds   = array.get(D_IN, 4)
        int   sNow = nf_bit(ds, 2) ? 1 : nf_bit(ds, 3) ? -1 : 0
        if satKnown and sNow != satDir
            if sNow == 1
                array.set(NEW_L, 4, true)
            else if sNow == -1
                array.set(NEW_S, 4, true)
            array.set(GONE, 4, satDir == 0 ? 0 : sNow == 0 ? 4 : 5)
        satDir   := sNow
        satKnown := true
    else
        satDir   := 0
        satKnown := false

    // ---- 点数（系統内の合計に上限を掛けてから合算）----
    int e0 = array.get(EV_DIR, 0)
    int e1 = array.get(EV_DIR, 1)
    int e2 = array.get(EV_DIR, 2)
    int e3 = array.get(EV_DIR, 3)
    nMaL := math.min(2, (e0 == 1 ? array.get(EV_PTS, 0) : 0) + (e1 == 1 ? array.get(EV_PTS, 1) : 0))
    nMaS := math.min(2, (e0 == -1 ? array.get(EV_PTS, 0) : 0) + (e1 == -1 ? array.get(EV_PTS, 1) : 0))
    nWvL := math.min(2, (e2 == 1 ? array.get(EV_PTS, 2) : 0) + (e3 == 1 ? array.get(EV_PTS, 3) : 0))
    nWvS := math.min(2, (e2 == -1 ? array.get(EV_PTS, 2) : 0) + (e3 == -1 ? array.get(EV_PTS, 3) : 0))
    nSaL := satDir == 1 ? 1 : 0
    nSaS := satDir == -1 ? 1 : 0
    nL   := nMaL + nWvL + nSaL
    nS   := nMaS + nWvS + nSaS
    nNet := nL - nS
    nFamL := (nMaL > 0 ? 1 : 0) + (nWvL > 0 ? 1 : 0) + (nSaL > 0 ? 1 : 0)
    nFamS := (nMaS > 0 ? 1 : 0) + (nWvS > 0 ? 1 : 0) + (nSaS > 0 ? 1 : 0)
    bool anyL = false
    bool anyS = false
    for i = 0 to 4
        anyL := anyL or array.get(NEW_L, i)
        anyS := anyS or array.get(NEW_S, i)
    nNewL := anyL
    nNewS := anyS

    // ---- 約定・決済の検出（前の判定足の後に起きたもの）----
    bool slClosedNow = false
    int  totNow = strategy.closedtrades + strategy.opentrades
    if totNow > nTotSeen
        // 保有中ならその取引、約定足の中で SL まで決済済みなら最後の決済済み取引
        float fp = na
        int   fd = 0
        if strategy.opentrades > 0
            fp := strategy.opentrades.entry_price(0)
            fd := strategy.position_size > 0 ? 1 : -1
        else
            fp := strategy.closedtrades.entry_price(strategy.closedtrades - 1)
            fd := strategy.closedtrades.entry_id(strategy.closedtrades - 1) == "L" ? 1 : -1
        nFillPrice := fp
        nSlPrice   := fp - fd * nSlTicks * syminfo.mintick
        dFillDir   := fd
        dFillPrice := fp
        dFillSL    := nSlPrice
        nTotSeen   := totNow
    if strategy.closedtrades > nClosedSeen
        for i = nClosedSeen to strategy.closedtrades - 1
            float pf   = strategy.closedtrades.profit(i)
            int   dd   = strategy.closedtrades.entry_id(i) == "L" ? 1 : -1
            string xid = strategy.closedtrades.exit_id(i)
            bool  isSL = xid == "L-SL" or xid == "S-SL"
            int   b    = dd == 1 ? 0 : 8
            array.set(TS, b + 0, array.get(TS, b + 0) + 1)
            array.set(TS, b + 1, array.get(TS, b + 1) + (pf > 0 ? 1 : 0))
            array.set(TS, b + 2, array.get(TS, b + 2) + (pf < 0 ? 1 : 0))
            array.set(TS, b + 3, array.get(TS, b + 3) + (pf > 0 ? pf : 0))
            array.set(TS, b + 4, array.get(TS, b + 4) + (pf < 0 ? pf : 0))
            array.set(TS, b + 5, array.get(TS, b + 5) + pf)
            array.set(TS, b + 6, array.get(TS, b + 6) + (isSL ? 1 : 0))
            array.set(TS, b + 7, array.get(TS, b + 7) + (isSL ? 0 : 1))
            slClosedNow := slClosedNow or isSL
            dCloseDir   := dd
            dClosePrice := strategy.closedtrades.exit_price(i)
            dCloseTxt   := (dd == 1 ? "LONG " : "SHORT ") + (isSL ? "SL" : "NET決済") + "・" + (pf > 0 ? "利確" : pf < 0 ? "損失決済" : "損益ゼロ") + " " + str.tostring(pf, "#.##")
        nClosedSeen := strategy.closedtrades
    // 注文は次足始値で約定するので、前の足で出した注文はここで結果が出ている
    nEntryPend := false
    nExitPend  := false
    int posDir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
    nPosDir := posDir
    if posDir == 0
        nSlPrice := na

    // ---- 保有方向から見たこの足の変化 ----
    string chg = ""
    if posDir != 0
        for i = 0 to 4
            int    pd   = array.get(PREV_D, i)
            int    cd   = i < 4 ? array.get(EV_DIR, i) : satDir
            bool   nOwn = posDir == 1 ? array.get(NEW_L, i) : array.get(NEW_S, i)
            bool   nOpp = posDir == 1 ? array.get(NEW_S, i) : array.get(NEW_L, i)
            int    g    = array.get(GONE, i)
            string nm   = array.get(SHORTN, i)
            if pd == posDir and cd != posDir
                chg += (chg == "" ? "" : " / ") + (g == 1 ? "保有方向の根拠の期限切れ（" : g == 2 ? "保有方向の根拠の価格否定（" : g == 3 ? "逆方向成立で保有方向の根拠が解除（" : g == 4 ? "SAT の保有方向状態が解除（" : g == 5 ? "SAT が逆方向へ反転（" : "保有方向の根拠が受信不備で不明（") + nm + "）"
            if pd == -posDir and cd != -posDir and not nOwn
                chg += (chg == "" ? "" : " / ") + (g == 1 ? "逆方向根拠の期限切れ（" : g == 2 ? "逆方向根拠の価格否定（" : "逆方向根拠の解除（") + nm + "）"
            if nOpp
                chg += (chg == "" ? "" : " / ") + "新しい逆方向根拠の成立（" + nm + "）"
            if nOwn
                chg += (chg == "" ? "" : " / ") + (pd == posDir ? "保有方向の根拠の再成立・期限更新（" : "保有方向の根拠の新規成立（") + nm + "）"
    nLastChg := chg

    // ---- 保有判断（データ不備の足は判断を変えず、変化を持ち越す）----
    if posDir != 0 and allOk
        int  own    = posDir == 1 ? nL : nS
        int  opp    = posDir == 1 ? nS : nL
        bool newOpp = posDir == 1 ? nNewS : nNewL
        bool warn   = (newOpp and opp >= 2) or (nHoldSt == 3 and opp >= 2)
        int  hst    = warn ? 3 : (own >= 2 and posDir * nNet >= 2) ? 1 : 2
        string src  = nCarry + (nCarry != "" and chg != "" ? " / " : "") + chg
        if hst != nHoldSt
            nHoldWhy := nHoldSt == 0 ? "約定後の最初の判定" + (src == "" ? "" : "：" + src) : src == "" ? "点数の変化（LONG " + str.tostring(nL) + " / SHORT " + str.tostring(nS) + " / NET " + str.tostring(nNet) + "）" : src
        nHoldSt := hst
        nCarry  := ""
    else if posDir != 0
        nCarry := nCarry + (nCarry != "" and chg != "" ? " / " : "") + chg
    else
        nHoldSt := 0
        nCarry  := ""

    // ---- NET 決済（確定足で注文 → 次足始値で約定）----
    bool exitNow = false
    if allOk and posDir == 1 and nNewS and nS >= 2 and nNet <= 0
        strategy.close("L", comment = "NET決済")
        exitNow := true
    else if allOk and posDir == -1 and nNewL and nL >= 2 and nNet >= 0
        strategy.close("S", comment = "NET決済")
        exitNow := true
    if exitNow
        nExitPend  := true
        nExitSigN  += 1
        dExitSig   := posDir
        dExitPrice := close

    // ---- 新規エントリー（保有なし・注文なし・この足で決済していない・この足の新しいイベントが必要）----
    bool okL = allOk and nNewL and nNet >= 3 and nS <= 1 and nFamL >= 2
    bool okS = allOk and nNewS and nNet <= -3 and nL <= 1 and nFamS >= 2
    if posDir == 0 and (okL or okS) and slClosedNow
        nBlockSame += 1
    if posDir == 0 and not exitNow and not slClosedNow and (okL or okS)
        nSlTicks := math.max(1, math.round(slUsd / syminfo.mintick))
        if okL
            strategy.entry("L", strategy.long, comment = "LONG")
            strategy.exit("L-SL", from_entry = "L", loss = nSlTicks, comment = "SL")
        else
            strategy.entry("S", strategy.short, comment = "SHORT")
            strategy.exit("S-SL", from_entry = "S", loss = nSlTicks, comment = "SL")
        nEntryPend := true
        nEntrySigN += 1
        nSigPrice  := close
        dSigDir    := okL ? 1 : -1
        dSigPrice  := close
// ==== NET5 Logic (end)

// =====================================================================================
// §3. チャート表示（合図・約定・SL・決済）
// =====================================================================================
plot(nPosDir != 0 ? nSlPrice : na, "固定 SL", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plot(nPosDir != 0 ? nFillPrice : na, "約定価格", color = color.new(color.gray, 30), style = plot.style_linebr, linewidth = 1)
plotshape(dSigDir == 1,  "LONG 合図",  shape.triangleup,   location.belowbar, colLong,  size = size.small)
plotshape(dSigDir == -1, "SHORT 合図", shape.triangledown, location.abovebar, colShort, size = size.small)
plotshape(dExitSig != 0, "NET 決済合図", shape.xcross, location.abovebar, color.new(color.yellow, 0), size = size.tiny)

if showLbl and dSigDir != 0
    label.new(bar_index, dSigPrice, (dSigDir == 1 ? "LONG 合図" : "SHORT 合図") + "\n合図価格 " + str.tostring(dSigPrice, format.mintick) + "\n（約定は次足始値）",
         style = dSigDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(dSigDir == 1 ? colLong : colShort, 30),
         textcolor = color.white, size = size.tiny, yloc = dSigDir == 1 ? yloc.belowbar : yloc.abovebar)
if showLbl and dFillDir != 0
    label.new(bar_index, dFillPrice, (dFillDir == 1 ? "LONG 約定 " : "SHORT 約定 ") + str.tostring(dFillPrice, format.mintick) + "\nSL " + str.tostring(dFillSL, format.mintick),
         style = label.style_label_left, color = color.new(dFillDir == 1 ? colLong : colShort, 0), textcolor = color.white, size = size.tiny)
if showLbl and dExitSig != 0
    label.new(bar_index, dExitPrice, "NET 決済合図（" + (dExitSig == 1 ? "LONG" : "SHORT") + "）\n約定は次足始値",
         style = label.style_label_down, color = color.new(color.yellow, 20), textcolor = color.black, size = size.tiny, yloc = yloc.abovebar)
if showLbl and dCloseDir != 0
    label.new(bar_index, dClosePrice, "決済 " + str.tostring(dClosePrice, format.mintick) + "\n" + dCloseTxt,
         style = label.style_label_left, color = color.new(color.purple, 10), textcolor = color.white, size = size.tiny)

// Data Window 用（データ不備の足は na = 0 点と区別）
plot(nAllOk ? nL : na,   "LONG SCORE",  display = display.data_window)
plot(nAllOk ? nS : na,   "SHORT SCORE", display = display.data_window)
plot(nAllOk ? nNet : na, "NET",         display = display.data_window)
plot(nPosDir, "保有（+1 LONG / −1 SHORT / 0）", display = display.data_window)
plot(nHoldSt, "保有判断（1 支持 / 2 低下 / 3 警戒）", display = display.data_window)

// =====================================================================================
// §4. テーブル
// =====================================================================================
var tbl = table.new(tblPos, 4, 24, border_width = 1)
f_c(int c, int r, string t, color tc) =>
    table.cell(tbl, c, r, t, text_color = tc, bgcolor = colBg, text_size = tblSize, text_halign = text.align_left)
f_dirTxt(int d) =>
    d == 1 ? "買い" : d == -1 ? "売り" : "なし"
f_dirCol(int d) =>
    d == 1 ? colLong : d == -1 ? colShort : colTxt
f_usd(float v) =>
    (v > 0 ? "+" : "") + str.tostring(v, "#.##")

if barstate.islast and showTbl
    table.clear(tbl, 0, 0, 3, 23)
    bool dataOk = nAllOk and isChart5M
    string ng = "データ不備"
    f_c(0, 0, "PM-NET5（5 分足 × 5 ロジック）", color.white)
    f_c(1, 0, "LONG", colLong)
    f_c(2, 0, "SHORT", colShort)
    f_c(3, 0, dataOk ? "受信 OK" : "判定停止（" + ng + "）", dataOk ? colTxt : color.orange)
    f_c(0, 1, "SCORE（各方向 最大 5）", colTxt)
    f_c(1, 1, dataOk ? str.tostring(nL) : ng, dataOk ? colLong : color.orange)
    f_c(2, 1, dataOk ? str.tostring(nS) : ng, dataOk ? colShort : color.orange)
    f_c(3, 1, "NET " + (dataOk ? (nNet > 0 ? "+" : "") + str.tostring(nNet) : ng), dataOk ? (nNet > 0 ? colLong : nNet < 0 ? colShort : colTxt) : color.orange)
    f_c(0, 2, "MA 系（⑤＋⑨ 上限 2）", colTxt)
    f_c(1, 2, str.tostring(nMaL), colLong)
    f_c(2, 2, str.tostring(nMaS), colShort)
    f_c(3, 2, "", colTxt)
    f_c(0, 3, "波形系（⑯＋⑮ 上限 2）", colTxt)
    f_c(1, 3, str.tostring(nWvL), colLong)
    f_c(2, 3, str.tostring(nWvS), colShort)
    f_c(3, 3, "", colTxt)
    f_c(0, 4, "SAT（㉔ 上限 1）", colTxt)
    f_c(1, 4, str.tostring(nSaL), colLong)
    f_c(2, 4, str.tostring(nSaS), colShort)
    f_c(3, 4, "", colTxt)
    f_c(0, 5, "ロジック", colTxt)
    f_c(1, 5, "有効方向", colTxt)
    f_c(2, 5, "残り保持", colTxt)
    f_c(3, 5, "受信状態", colTxt)
    for i = 0 to 4
        int st = array.get(IN_ST, i)
        int d  = i < 4 ? array.get(EV_DIR, i) : satDir
        int remMin = i < 4 and d != 0 ? math.max(0, int((array.get(EV_T, i) + HOLD_MS - time_close) / 60000)) : 0
        f_c(0, 6 + i, array.get(NAMES, i), colTxt)
        f_c(1, 6 + i, st != 0 and i == 4 ? "不明（" + ng + "）" : f_dirTxt(d), st != 0 and i == 4 ? color.orange : f_dirCol(d))
        f_c(2, 6 + i, i == 4 ? "状態型（保持なし）" : d != 0 ? str.tostring(remMin) + " 分" : "—", colTxt)
        f_c(3, 6 + i, array.get(ST_TXT, isChart5M ? st : 10), st == 0 and isChart5M ? colTxt : color.orange)
    string posTxt = nPosDir == 1 ? "LONG" : nPosDir == -1 ? "SHORT" : "なし"
    f_c(0, 11, "保有状態", colTxt)
    f_c(1, 11, posTxt + (nEntryPend ? "（エントリー注文中）" : nExitPend ? "（決済注文中）" : ""), f_dirCol(nPosDir))
    f_c(2, 11, nPosDir != 0 ? "約定 " + str.tostring(nFillPrice, format.mintick) : "", colTxt)
    f_c(3, 11, nPosDir != 0 ? "SL " + str.tostring(nSlPrice, format.mintick) : "", color.orange)
    string hTxt = nPosDir == 0 ? "—" : nHoldSt == 1 ? "保有支持あり" : nHoldSt == 2 ? "支持低下" : nHoldSt == 3 ? "反転警戒" : "判定待ち（" + ng + "）"
    f_c(0, 12, "保有判断", colTxt)
    f_c(1, 12, hTxt, nHoldSt == 3 ? color.orange : nHoldSt == 2 ? color.yellow : colTxt)
    table.merge_cells(tbl, 1, 12, 3, 12)
    f_c(0, 13, "状態が変化した理由", colTxt)
    f_c(1, 13, nPosDir == 0 ? "—" : nHoldWhy == "" ? "—" : nHoldWhy, colTxt)
    table.merge_cells(tbl, 1, 13, 3, 13)
    f_c(0, 14, "直近足の変化", colTxt)
    f_c(1, 14, nLastChg == "" ? "—" : nLastChg, colTxt)
    table.merge_cells(tbl, 1, 14, 3, 14)
    // 成績
    f_c(0, 15, "成績（読み込んだ履歴の実績）", colTxt)
    f_c(1, 15, "LONG", colLong)
    f_c(2, 15, "SHORT", colShort)
    f_c(3, 15, "合計", colTxt)
    for k = 0 to 5
        string nmK = k == 0 ? "件数（勝ち / 負け）" : k == 1 ? "純損益 USD" : k == 2 ? "総利益 / 総損失" : k == 3 ? "決済内訳 NET / SL" : k == 4 ? "コスト控除後 USD" : "合図数 エントリー / NET決済"
        f_c(0, 16 + k, nmK, colTxt)
        for c = 0 to 2
            float n_  = c < 2 ? array.get(TS, c * 8 + 0) : array.get(TS, 0) + array.get(TS, 8)
            float w_  = c < 2 ? array.get(TS, c * 8 + 1) : array.get(TS, 1) + array.get(TS, 9)
            float l_  = c < 2 ? array.get(TS, c * 8 + 2) : array.get(TS, 2) + array.get(TS, 10)
            float gp  = c < 2 ? array.get(TS, c * 8 + 3) : array.get(TS, 3) + array.get(TS, 11)
            float gl  = c < 2 ? array.get(TS, c * 8 + 4) : array.get(TS, 4) + array.get(TS, 12)
            float np  = c < 2 ? array.get(TS, c * 8 + 5) : array.get(TS, 5) + array.get(TS, 13)
            float sl_ = c < 2 ? array.get(TS, c * 8 + 6) : array.get(TS, 6) + array.get(TS, 14)
            float nt_ = c < 2 ? array.get(TS, c * 8 + 7) : array.get(TS, 7) + array.get(TS, 15)
            string v = k == 0 ? str.tostring(n_, "#") + "（" + str.tostring(w_, "#") + " / " + str.tostring(l_, "#") + "）" :
                 k == 1 ? (n_ > 0 ? f_usd(np) : "—") :
                 k == 2 ? (n_ > 0 ? f_usd(gp) + " / " + f_usd(gl) : "—") :
                 k == 3 ? str.tostring(nt_, "#") + " / " + str.tostring(sl_, "#") :
                 k == 4 ? (n_ > 0 ? f_usd(np - costUsd * n_) : "—") :
                 c == 2 ? str.tostring(nEntrySigN) + " / " + str.tostring(nExitSigN) : ""
            f_c(1 + c, 16 + k, v, c == 0 ? colLong : c == 1 ? colShort : colTxt)
    f_c(0, 22, "コスト設定", colTxt)
    f_c(1, 22, "手数料 0・スリッページ 0（strategy 既定・未設定）。損益は手数料込みではない。控除後は表示用 " + str.tostring(costUsd, "#.##") + " USD / 取引", color.orange)
    table.merge_cells(tbl, 1, 22, 3, 22)
    f_c(0, 23, "注記", colTxt)
    f_c(1, 23, "SL " + str.tostring(slUsd, "#.##") + " USD・保持 " + str.tostring(holdMin) + " 分は検証開始用の初期値。同じ足の両方向 " + str.tostring(nBoth) + " 件・SL 足の新規見送り " + str.tostring(nBlockSame) + " 件。単体集計で NET 全体の収益性は証明されない。", colTxt)
    table.merge_cells(tbl, 1, 23, 3, 23)

loggerLevelStr = input.string("Strong", "Level",
     options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_LOGGER,
     tooltip = "抽出対象にする Zone Level。EXACT / MINIMUM は下の Level Match で決める。")
loggerLevelMatch = input.string("EXACT", "Level Match",
     options = ["EXACT", "MINIMUM"], group = G_LOGGER,
     tooltip = "EXACT   : その Level ちょうどだけを対象 (例 Strong なら Strong のみ)。\n" +
     "          元CSVの「Strong T1」はこの EXACT 集計なので、CSV再現の既定値。\n" +
     "MINIMUM : その Level 以上を対象 (例 Strong なら Strong + Very Strong)。")
loggerLevelTiming = input.string("POST_TOUCH", "Level Timing",
     options = ["PRE_TOUCH", "POST_TOUCH"], group = G_LOGGER,
     tooltip = "PRE_TOUCH  : タッチ直前 (1本前の確定足時点) の Level で抽出。\n" +
     "POST_TOUCH : タッチを反映した後の Level で抽出。\n" +
     "★ 元CSVの EV_zoneLevel は Touch後の Level なので、CSV再現の既定は POST_TOUCH。\n" +
     "★ Main Entry の Entry Level Timing とは完全に独立した設定。")
loggerTouchMode = input.string("T1_ONLY", "Touch Filter",
     options = ["ALL", "T1_ONLY"], group = G_LOGGER,
     tooltip = "T1_ONLY : タッチ後の touchCount == 1 だけを対象 (CSVの Strong T1 比較用)。\n" +
     "ALL     : すべてのタッチを対象。")
loggerTarget1 = input.float(10.0, "Target #1 ($)", minval = 0.1, step = 1.0, group = G_LOGGER)
loggerTarget2 = input.float(20.0, "Target #2 ($)", minval = 0.1, step = 1.0, group = G_LOGGER)
loggerTarget3 = input.float(30.0, "Target #3 ($)", minval = 0.1, step = 1.0, group = G_LOGGER)
//  ★ 評価期間は「タッチ足を除く その後48本」固定 (Section 10 · LOG_HORIZON)。
//    元CSVの再解析で確定した値なので input にしていない。

// ============================================================================
// 02. ENGINE INITIALIZATION
// ----------------------------------------------------------------------------
//  ★ Zone Level Display の Section 02 をそのまま移植 (SL/TP設定の代入のみ除外) ★
//    Zone生成条件・Score・trackId・State・Lifetime に関わるフィールドは
//    1つも変更していない。
// ============================================================================
var zn.ZoneEngine zoneEng = zn.newEngine()

zn.ZoneCfg zoneCfg = zn.newCfg()
zoneCfg.zoneHalfWidth        := zoneHalfWidth
zoneCfg.useMaSource          := useMaSource
zoneCfg.maTfName             := maTf
zoneCfg.ma1Len               := ma1Len
zoneCfg.ma2Len               := ma2Len
zoneCfg.scoreMa1             := scoreMa1
zoneCfg.scoreMa2             := scoreMa2
zoneCfg.slopeThrMod          := slopeThrMod
zoneCfg.slopeThrStrong       := slopeThrStrong
zoneCfg.slopeBonusFlat       := slopeBonusFlat
zoneCfg.slopeBonusMod        := slopeBonusMod
zoneCfg.slopeBonusStr        := slopeBonusStr
zoneCfg.slopeBonusMax        := slopeBonusMode == "Max"
zoneCfg.maClusterDist        := maClusterDist
zoneCfg.maClusterBonus       := maClusterBonus
zoneCfg.maClusterDirBonus    := maClusterDirBonus
zoneCfg.useHzSource          := useHzSource
zoneCfg.hzTf1                := hzTf1
zoneCfg.hzTf2                := hzTf2
zoneCfg.hzTf3                := hzTf3
zoneCfg.scoreHz1             := scoreHz1
zoneCfg.scoreHz2             := scoreHz2
zoneCfg.scoreHz3             := scoreHz3
zoneCfg.reactionDist         := reactionDist
//  ★ useReactionScoreBonus == false のとき 0.0 を渡し、Score加点だけを無効化する。
zoneCfg.reactionBonus1       := useReactionScoreBonus ? reactionBonus1 : 0.0
zoneCfg.reactionBonus2       := useReactionScoreBonus ? reactionBonus2 : 0.0
zoneCfg.reactionBonus3       := useReactionScoreBonus ? reactionBonus3 : 0.0
zoneCfg.reactionRearmDist    := reactionRearmDist
zoneCfg.reactionAllSrc       := reactionAllSrc
zoneCfg.useDayHL             := useDayHL
zoneCfg.scoreDayHL           := scoreDayHL
zoneCfg.carryPrevDayHL       := carryPrevDayHL
zoneCfg.scorePrevDayHL       := scorePrevDayHL
zoneCfg.lifePrevDayHL        := lifePrevDayHL
zoneCfg.useAccSource         := useAccSource
zoneCfg.accTf1               := accTf1
zoneCfg.accTf2               := accTf2
zoneCfg.accTf3               := accTf3
zoneCfg.scoreAcc1            := scoreAcc1
zoneCfg.scoreAcc2            := scoreAcc2
zoneCfg.scoreAcc3            := scoreAcc3
zoneCfg.accKeep1             := accKeep1
zoneCfg.accKeep2             := accKeep2
zoneCfg.accKeep3             := accKeep3
zoneCfg.clusterDist          := clusterDist
zoneCfg.thrMedium            := thrMedium
zoneCfg.thrStrong            := thrStrong
zoneCfg.thrVStrong           := thrVStrong
zoneCfg.confBonus2           := confBonus2
zoneCfg.confBonus3           := confBonus3
zoneCfg.confBonus4           := confBonus4
zoneCfg.flipBonus            := flipBonus
zoneCfg.requireHtfForVStrong := requireHtfForVStrong
zoneCfg.htfSwing1H           := htfSwing1H
zoneCfg.htfAccum1H           := htfAccum1H
zoneCfg.htfAccum4H           := htfAccum4H
zoneCfg.htfAccumD            := htfAccumD
zoneCfg.htfSwing15M          := htfSwing15M
zoneCfg.htfMa1               := htfMa1
zoneCfg.htfMa2               := htfMa2
zoneCfg.htfDayHL             := htfDayHL
zoneCfg.breakBuffer          := breakBuffer
zoneCfg.flipConfirmDist      := flipConfirmDist
zoneCfg.resetOnReclaim       := resetOnReclaim
zoneCfg.trackStaleBars       := trackStaleBars
zoneCfg.trackContinuity      := trackContinuity
zoneCfg.lifeHz1              := lifeHz1
zoneCfg.lifeHz2              := lifeHz2
zoneCfg.lifeHz3              := lifeHz3
zoneCfg.lifeExtendOn         := lifeExtendOn
zoneCfg.lifeExtendRatio      := lifeExtendRatio
zoneCfg.maxPersistZones      := maxPersistZones
//  ★ ここで zoneCfg.slBuffer / tpBuffer / maxSlDist / minStructRR / slMinScore /
//    tpMinStrength / obsMinStrength / activeNoTradeMinStrength / fallbackRR は
//    代入しない (zn.newCfg() の既定値のまま)。
//    それらは ZoneEngine の buildPlan 専用の設定で、本Strategyは buildPlan を
//    呼ばないため一切参照されない。Zone生成 / Score / State には無関係。

// ============================================================================
// 03. EXTERNAL DATA FEED
// ----------------------------------------------------------------------------
//  Library は request.*() を呼べないため、外部足の取得はここで行う。
//  ★ Zone Level Display の Section 03 をそのまま移植 (Break Feed のみ軽量化) ★
//    request.security の TF / 式 / lookahead / 取得条件 (if useXxxSource) は
//    1行も変更していない。したがって Zone 時系列は Display と完全一致する。
//
//  ★ request.* の本数
//    MA×1 / Swing×3 / Accum×3 = 7
//    + Break×1 (ただし breakTf == チャート足 のときは 0 本)
//    → 既定 (5分足チャート / Break TF = 5) では 7 本。Display より1本少ない。
// ============================================================================
//  ★ Source が OFF のときは取得自体を行わない (結果不変) ★
//    Library 側は MA / Swing / Accum のどれも「c.useXxxSource が true」かつ
//    「値が na でない」ときにしか Zone を登録しないため、na を渡すのと実測値を
//    渡すのは Zone 時系列に対して完全に等価。
float ma1Val   = na
float ma1Delta = na
float ma2Val   = na
float ma2Delta = na
if useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Val   := _m1
    ma1Delta := _m1d
    ma2Val   := _m2
    ma2Delta := _m2d

float ph1 = na
int   ph1T = na
float pl1 = na
int   pl1T = na
float ph2 = na
int   ph2T = na
float pl2 = na
int   pl2T = na
float ph3 = na
int   ph3T = na
float pl3 = na
int   pl3T = na
if useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1 := _h1
    ph1T := _h1t
    pl1 := _l1
    pl1T := _l1t
    ph2 := _h2
    ph2T := _h2t
    pl2 := _l2
    pl2T := _l2t
    ph3 := _h3
    ph3T := _h3t
    pl3 := _l3
    pl3T := _l3t

bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1Hi = na
float acc1Lo = na
int   acc1Id = na
float acc2Hi = na
float acc2Lo = na
int   acc2Id = na
float acc3Hi = na
float acc3Lo = na
int   acc3Id = na
if useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)
    acc1Hi := _a1h
    acc1Lo := _a1l
    acc1Id := _a1i
    acc2Hi := _a2h
    acc2Lo := _a2l
    acc2Id := _a2i
    acc3Hi := _a3h
    acc3Lo := _a3l
    acc3Id := _a3i

// ---- 3.x Break Feed (軽量化) ----------------------------------------------
//  ★ Break判定は breakTf の「確定終値」のみ (ヒゲでは判定しない) ★
//    ここだけ Display から変更している。ただし渡す値は同じ。
//
//    (a) breakTf == チャート時間足 (既定 5M / 5M)
//        request.security() を使わず close / high / low を直接使う。
//        Display 版は request.security(同一TF) の結果を [1] して「1本前の確定足」を
//        渡していた。同一TFの security は毎バーそのチャート足自身の値を返すので、
//        その [1] は close[1] / high[1] / low[1] と完全に同値。
//        brBarClosed も同一TFでは毎バー true (bar_index > 0 のみが条件) になる。
//        → 渡す brClose / brHigh / brLow / brEval は Display と1バーもズレない。
//
//    (b) breakTf > チャート時間足
//        Display と同じく request.security() を使い、上位足が切り替わったバーで
//        直前に確定した1本ぶんを渡す (lookahead_off なので先読みなし)。
//
//    ※ breakTf < チャート時間足 は想定外 (下位足Break判定は実装しない)。
//      その場合は (a) と同じ扱い = チャート足の確定終値で判定する。
bool brkSameTf = timeframe.in_seconds(breakTf) <= timeframe.in_seconds()

float brCloseRaw = na
float brHighRaw  = na
float brLowRaw   = na
if not brkSameTf
    [_bc, _bh, _bl] = request.security(syminfo.tickerid, breakTf, [close, high, low],
         lookahead = barmerge.lookahead_off)
    brCloseRaw := _bc
    brHighRaw  := _bh
    brLowRaw   := _bl

bool brNewBar = brkSameTf ? bar_index > 0 :
     (bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0)
float brClose = brNewBar ? (brkSameTf ? close[1] : brCloseRaw[1]) : na
float brHigh  = brNewBar ? (brkSameTf ? high[1]  : brHighRaw[1])  : na
float brLow   = brNewBar ? (brkSameTf ? low[1]   : brLowRaw[1])   : na
bool  brEval  = brNewBar and not na(brClose)

// 取引日ID (timestamp/hour の timezone は series 不可なので Main で計算する)
int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T,
     ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id,
     acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id,
     dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval,
     baseOpen = open, baseHigh = high, baseLow = low, baseClose = close,
     basePrevClose = close[1], baseTime = time, baseBarSeq = bar_index)

int zoneCountNow = zn.update(zoneEng, zoneCfg, zoneFeed)

// ============================================================================
// 04. SOURCE MASK (ZoneLevelEngine へ渡す参考情報)
// ----------------------------------------------------------------------------
//  ★ Zone Level Display の f_valHasSrc() / f_valSrcMask() をビット割当ごと
//    逐語で移植している。独自の割当には変更していない。
//  ★ ZoneLevelEngine 側の addedSourceMask (誕生後に追加された Source) 用。
//    Strategy側はこの値を Entry / SL / TP のどの判定にも使っていない。
//  ★ 軽量化のためこの2関数を削除して 0 を渡す案があるが、現時点では残す ★
//    ZoneLevelEngine v2 の実装を参照できないため、sourceMask が
//    zoneLevel / birthScore / touchCount / State に影響しないことを
//    「Library 側のコードで確認」できていない。
//    Zone Level Display と Zone位置 / trackId / State / BirthScore /
//    TouchCount / zoneLevel が完全一致することを最優先し、Display と同じ値を
//    そのまま渡す。Library の実装を確認できたら削除を再検討すること。
// ============================================================================
//  ★ Zone.sources は " / " 区切りの文字列。"5 Swing" が "15 Swing" に部分一致して
//    しまうのを避けるため、先頭一致 または " / " + key での一致だけを採用する。
f_valHasSrc(string s, string key) =>
    na(s) or s == "" ? false : (str.startswith(s, key) or str.contains(s, " / " + key))

//  ★ sourceMask ビット割当 (Zone.sources / 生TF表記)
//    bit0(1)   = MA #1        (str.tostring(ma1Len) + "MA")
//    bit1(2)   = MA #2        (str.tostring(ma2Len) + "MA")
//    bit2(4)   = Swing TF#1   (hzTf1 + " Swing")
//    bit3(8)   = Swing TF#2   (hzTf2 + " Swing")
//    bit4(16)  = Swing TF#3   (hzTf3 + " Swing")
//    bit5(32)  = Day High / Day Low
//    bit6(64)  = Prev Day High / Prev Day Low
//    bit7(128) = Accum TF#1   (accTf1 + " Accum")
//    bit8(256) = Accum TF#2   (accTf2 + " Accum")
//    bit9(512) = Accum TF#3   (accTf3 + " Accum")
f_valSrcMask(string s) =>
    int m = 0
    if f_valHasSrc(s, str.tostring(ma1Len) + "MA")
        m += 1
    if f_valHasSrc(s, str.tostring(ma2Len) + "MA")
        m += 2
    if f_valHasSrc(s, hzTf1 + " Swing")
        m += 4
    if f_valHasSrc(s, hzTf2 + " Swing")
        m += 8
    if f_valHasSrc(s, hzTf3 + " Swing")
        m += 16
    if f_valHasSrc(s, "Day High") or f_valHasSrc(s, "Day Low")
        m += 32
    if f_valHasSrc(s, "Prev Day High") or f_valHasSrc(s, "Prev Day Low")
        m += 64
    if f_valHasSrc(s, accTf1 + " Accum")
        m += 128
    if f_valHasSrc(s, accTf2 + " Accum")
        m += 256
    if f_valHasSrc(s, accTf3 + " Accum")
        m += 512
    m

//  ★ ZoneLevelCfg は zl.newCfg() の既定値をそのまま使う (Section 05 参照) ★
//    Projected Level の計算 (Section 04B) でも同じインスタンスを渡すため、
//    宣言だけ先に置いている。Strategy 側で閾値を上書きすることはしない。
var zl.ZoneLevelCfg lvlCfg = zl.newCfg()

// ============================================================================
// 04B. PROJECTED LEVEL (次の Touch 後の Level)
// ----------------------------------------------------------------------------
//  ★★ Level の計算は Strategy 側で一切行わない ★★
//    「次の Touch が起きたら Level はいくつになるか」は、ZoneLevelEngine が
//    実際の Level 判定に使っているのと同じ内部関数で計算されなければならない。
//    BirthScore / TouchCount から Level 式をここへ写すことは禁止 (二重実装は
//    必ずズレる)。このファイルは Library へ問い合わせるだけにしている。
//
//  ★★ どの関数を呼んでいるか ★★
//    ZoneLevelEngine v2 は Level 判定を private 関数 f_levelOf() 1本に集約して
//    あり、実際の Level 計算 (feedZone 内の `f_levelOf(_bs, _tc, c)`) と
//    export されている levelFrom() が同じその関数を呼んでいる:
//
//        export levelFrom(float birthScore, int touchCount, ZoneLevelCfg c) =>
//            f_levelOf(birthScore, touchCount, c)
//
//    したがって
//        zl.levelFrom(z.birthScore, z.touchCount + 1, lvlCfg)
//    は「touchCount を +1 した状態で、実 Level 計算と同じ内部関数を通した結果」
//    そのものになる。切り出しの追加作業も新しい Library バージョンも要らず、
//    二重実装も発生しない。
//    ★ 渡す cfg は feedZone() / endBaseBar() へ渡しているものと同一インスタンス
//      (lvlCfg) なので、閾値 (birthScoreHigh / touchMidMin / touchWeakMin) も
//      実 Level 計算と完全に同じ。
//    ★ birthScore は誕生時に固定される値なので、Touch で変化しない。
//      よって「変えているのは touchCount を +1 することだけ」になる。
//
//  ★★ ZoneLevelEngine v3 (任意) ★★
//    より明示的な API 名で呼びたい場合は、v2 のソースへ
//        export projectLevelAfterNextTouch(ZoneLevel z, ZoneLevelCfg c) =>
//            f_levelOf(z.birthScore, z.touchCount + 1, c)
//    を追加して v3 として publish し、下の f_projectedLevel() の中身を
//        zl.projectLevelAfterNextTouch(z, lvlCfg)
//    に差し替えればよい (計算結果は同じ。docs/ZoneLevelEngine_v3_patch.pine)。
//    ★ v3 は「呼び名」を増やすだけで、現状の実装は v2 のままで完成している。
//      未接続の TODO は残っていない。
//
//  ★ 未来参照ではない ★
//    まだ起きていない Touch の実測 Level を先読みしているのではなく、
//    「今分かっている birthScore と touchCount から、次の Touch 後の Level を
//    同じ計算式で求めている」だけ。lookahead は使っていない。
// ============================================================================
int PROJ_NA = -1

//  ★ Projected Level の取得口はこの1箇所だけ ★
//    Level 判定式は書かない。Library の export を呼ぶだけ。
f_projectedLevel(z) =>
    zl.levelFrom(z.birthScore, z.touchCount + 1, lvlCfg)

// ============================================================================
// 05. ZONE LEVEL ENGINE の更新 (確定足 1 本につき 1 回)
// ----------------------------------------------------------------------------
//  ★ Zone Level Display の Section 05 をそのまま移植 ★
//
//  ★ Base TF = チャート時間足 (5分) ★
//    このStrategyは XAUUSD 5分足で使うため、Base TF もそのまま 5分。
//      baseBarSeq = bar_index / baseTime = time
//      baseHigh   = high      / baseLow  = low  / baseClose = close
//
//  ★ barstate.isconfirmed のときだけ 1 回だけ実行する ★
//    未確定足では TouchCount / 登録簿を一切進めない。
//    (strategy() も calc_on_every_tick = false なので、そもそも確定足でしか
//     再計算されない。二重ガードとして isconfirmed を明示している。)
//
//  ★ ZoneLevelCfg は zl.newCfg() の既定値をそのまま使う ★
//    Strategy側で Level を再計算しないのはもちろん、閾値の上書きもしない。
//    Level ルールを変えるときは ZoneLevelEngine 側だけを変更する。
//    → チャートの Zone Level Display で見えている Level と、この Strategy が
//      Entry / TP に使う Level が必ず一致する。
//
//  ★ スナップショット (lvlEng.zones) は beginBaseBar() でしか作り直さない ★
//    Entry判定は必ずこの更新の「後」に行うので、その足の最新 Level / TouchCount /
//    State を見て判断することになる。
// ============================================================================
var zl.ZoneLevelEngine lvlEng = zl.newEngine()

//  ★ PRE_TOUCH Level 用の軽量 snapshot (trackId → zoneLevel) ★
//    lvlEng は「次の beginBaseBar() を呼ぶ直前まで 1本前の確定足時点の
//    ZoneLevel snapshot を保持している」ので、その特性をそのまま利用する。
//    → beginBaseBar() の直前に trackId → zoneLevel を map へ退避するだけ。
//    ★ Level を Main 側で再計算しているわけではない。ZoneLevelEngine が出した
//      zoneLevel をそのまま保存しているだけで、birthScore / touchCount からの
//      再計算は一切していない。
//    ★ Entry済Touch管理 (gEnteredTouch) とは完全に別物。用途も寿命も混ぜない。
var map<int, int> gPreTouchLevel = map.new<int, int>()

//  ★ Logger Repro 用の TouchCount snapshot (trackId → touchCount) ★
//    「新しいタッチ」の検出は ZoneLevelEngine の touchCount 増加だけを起点にする
//    (Zoneタッチ条件を Strategy 側で再実装しない) ので、Level snapshot と同じ
//    タイミングで 1本前の touchCount も退避しておく。
//    useLoggerRepro = false のときは1度も触らない (完全に空のまま)。
var map<int, int> gLogPrevTouch = map.new<int, int>()

//  ★ CSV Parity Audit 用の Projected Level snapshot (trackId → 次Touch後Level) ★
//    Touch が起きる前 (= このバーの beginBaseBar より前) の時点で予測した Level。
//    Touch 発生後に実際の zoneLevel と突き合わせて、予測が当たっているかを数える。
//    useParityAudit = false のときは1度も触らない。
var map<int, int> gProjPrev = map.new<int, int>()

//  処理順序 (この順序が PRE_TOUCH / POST_TOUCH の意味を決める)
//    前バーのZoneLevel snapshot → gPreTouchLevel へ保存 → beginBaseBar →
//    feedZone → endBaseBar → 現在バーの POST_TOUCH Level 完成 → Entry判定
if barstate.isconfirmed
    //  ---- beginBaseBar() の「前」に前バーLevelを退避する ----------------
    map.clear(gPreTouchLevel)
    //  1本前の touchCount は Logger Repro と CSV Parity Audit の両方が使う
    bool _needPrevTc = useLoggerRepro or useParityAudit
    if _needPrevTc
        map.clear(gLogPrevTouch)
    if useParityAudit
        map.clear(gProjPrev)
    int _prevN = zl.zoneCount(lvlEng)
    if _prevN > 0
        for _pi = 0 to _prevN - 1
            zl.ZoneLevel _pz = zl.zoneAt(lvlEng, _pi)
            if _pz.trackId >= 0
                gPreTouchLevel.put(_pz.trackId, _pz.zoneLevel)
                if _needPrevTc
                    gLogPrevTouch.put(_pz.trackId, _pz.touchCount)
                if useParityAudit
                    //  ★ Touch が起きる前の時点で予測した「次Touch後Level」
                    gProjPrev.put(_pz.trackId, f_projectedLevel(_pz))

    zl.beginBaseBar(lvlEng, bar_index, time, high, low, close)
    int _zcFeed = zn.zoneCount(zoneEng)
    if _zcFeed > 0
        for _fi = 0 to _zcFeed - 1
            zn.Zone _fz = zn.zoneAt(zoneEng, _fi)
            zl.feedZone(lvlEng, lvlCfg, _fz.trackId, _fz.top, _fz.bottom,
                 _fz.state, _fz.score, _fz.strength, _fz.flipped, f_valSrcMask(_fz.sources))
    zl.endBaseBar(lvlEng, lvlCfg)

//  ★ Level 定数は ZoneLevelEngine から取得する (Strategy側で数値を決めない)。
int LVL_W  = zl.levelWeak()
int LVL_M  = zl.levelMedium()
int LVL_S  = zl.levelStrong()
int LVL_VS = zl.levelVeryStrong()

//  Level 文字列 → Level コード (フィルター用。Level 判定そのものではない)
f_levelIdx(string s) =>
    s == "Very Strong" ? LVL_VS : s == "Strong" ? LVL_S : s == "Medium" ? LVL_M : LVL_W

//  Level コード → 表示名 (ラベル表示専用の書式変換)
//  ★ Level を計算しているのではなく、ZoneLevelEngine が出したコードを
//    文字にしているだけ。判定には使わない。該当なし (-1 等) は "-"。
f_levelName(int lvl) =>
    lvl == LVL_VS ? "Very Strong" : lvl == LVL_S ? "Strong" :
     lvl == LVL_M ? "Medium" : lvl == LVL_W ? "Weak" : "-"

int minEntryLevel   = f_levelIdx(minEntryLevelStr)
int minTpLevel      = f_levelIdx(minTpLevelStr)
int minDisplayLevel = f_levelIdx(minDisplayLevelStr)
int loggerLevel     = f_levelIdx(loggerLevelStr)
int edgeLevel       = f_levelIdx(edgeLevelStr)

// ---- Entry済み Touch の記録 (Section 06 / 07 から参照する) ------------------
//  trackId → 最後に Entry した touchCount。
//  ★ f_findEdgeZone() (Section 06) が候補を弾くのに使うため、関数より前の
//    global scope で宣言しておく必要がある。Section 07 では宣言しない
//    (2重宣言にしない)。中身の意味・使い方は Section 07 の説明を参照。
var map<int, int> gEnteredTouch = map.new<int, int>()

// ============================================================================
// 06. ENTRY / SL / TP HELPERS
// ----------------------------------------------------------------------------
//  ★ 参照するのは ZoneLevelEngine のスナップショット (zl.zoneAt) だけ ★
//    ZoneEngine の Raw Strength / Raw Score は Entry / SL / TP の条件に
//    一切使わない (ラベルの表示用にだけ読む)。
// ============================================================================

// ---- 6.1 Zone Rebound 候補の探索 ------------------------------------------
//  Long (dir > 0) : SUPPORT Zone へ「上から」接触して回復した確定足
//    1. 前の確定5分足 close  >  Zone上端        (直前は Zone より上にいた)
//    2. 現在の確定5分足 low   <= Zone上端        (上から Zone へ接触した)
//    3. 現在の確定5分足 close >= Recovery Price  (Zone内の規定位置まで戻った)
//         Recovery = zoneBottom + (zoneTop - zoneBottom) * reboundRecoveryRatio
//    4. zoneLevel >= Minimum Entry Level
//  Short (dir < 0) : 完全対称 (RESIST Zone へ「下から」接触して回復)
//    1. 前の確定5分足 close  <  Zone下端
//    2. 現在の確定5分足 high  >= Zone下端
//    3. 現在の確定5分足 close <= Recovery Price
//         Recovery = zoneTop - (zoneTop - zoneBottom) * reboundRecoveryRatio
//    4. Entry Level >= Minimum Entry Level
//       ★ ここで使う Entry Level は Entry Level Timing で切り替わる ★
//         POST_TOUCH : z.zoneLevel (今回の足を反映した後の Level)
//         PRE_TOUCH  : gPreTouchLevel (接触直前 = 1本前の確定足時点の Level)
//                      履歴が無い Zone は Entry禁止 (POST_TOUCH で代用しない)
//       ★ 切替が効くのはこの Minimum Entry Level だけ。Structural TP の
//         Minimum TP Level は従来どおり現在の z.zoneLevel を使う。
//  ※ barstate.isconfirmed は呼び出し側 (Section 07) のゲートで担保する。
//  ※ 条件を満たす Zone が複数ある場合は「価格に最も近い Zone」を採用する
//    (Long は zoneTop が最大の SUPPORT、Short は zoneBottom が最小の RESIST)。
//  戻り値: スナップショット内の index (見つからなければ -1)
f_findReboundZone(int dir, int minLv, float ratio) =>
    int   bestIdx  = -1
    float bestEdge = na
    bool  isPre = entryLevelMode == "PRE_TOUCH"
    int   n = zl.zoneCount(lvlEng)
    if n > 0
        for i = 0 to n - 1
            zl.ZoneLevel z = zl.zoneAt(lvlEng, i)
            if z.trackId >= 0
                //  ---- Minimum Entry Level 判定に使う Level を決める --------
                //    POST_TOUCH : 今回の足を反映した後の Level (z.zoneLevel)
                //    PRE_TOUCH  : 接触直前 (= 1本前の確定足時点) の Level
                //  ★ PRE_TOUCH で履歴が無い Zone (今回の足で初めて生成された
                //    Zone) は Entry禁止。POST_TOUCH Level で代用しない。
                //  ★ POST_TOUCH のときは map を引かない (無駄な探索をしない)。
                int  preLv  = -1
                bool hasPre = false
                if isPre
                    hasPre := gPreTouchLevel.contains(z.trackId)
                    if hasPre
                        preLv := gPreTouchLevel.get(z.trackId)
                int  entryLv    = isPre ? preLv : z.zoneLevel
                bool hasEntryLv = isPre ? hasPre : true
                if hasEntryLv and entryLv >= minLv
                    //  ---- Rebound 価格条件 (Entry Level Timing では変えない) --
                    float w = z.top - z.bottom
                    if dir > 0
                        float recL = z.bottom + w * ratio
                        bool hitL = z.state == ST_SUPPORT and close[1] > z.top and low <= z.top and close >= recL
                        if hitL and (na(bestEdge) or z.top > bestEdge)
                            bestEdge := z.top
                            bestIdx  := i
                    else
                        float recS = z.top - w * ratio
                        bool hitS = z.state == ST_RESIST and close[1] < z.bottom and high >= z.bottom and close <= recS
                        if hitS and (na(bestEdge) or z.bottom < bestEdge)
                            bestEdge := z.bottom
                            bestIdx  := i
    bestIdx

// ---- 6.2 Structural TP の探索 ---------------------------------------------
//  Long  : Entry より上にある RESIST  Zone のうち zoneLevel >= Minimum TP Level を
//          満たす最も近いもの (zone.bottom > entry の中で bottom が最小)
//  Short : Entry より下にある SUPPORT Zone のうち zoneLevel >= Minimum TP Level を
//          満たす最も近いもの (zone.top    < entry の中で top    が最大)
//  ★ BROKEN / ACTIVE は TP候補にしない (SUPPORT / RESIST だけを見るため自動的に除外)。
//  TP価格:
//    Long  : tpBase = zoneBottom + (zoneTop - zoneBottom) * tpDepthRatio → TP = tpBase - tpBuffer
//    Short : tpBase = zoneTop    - (zoneTop - zoneBottom) * tpDepthRatio → TP = tpBase + tpBuffer
//  戻り値: TP価格 (候補が無ければ na)
f_findStructuralTp(int dir, float entry, int minLv, float depth, float buf) =>
    float bestTop = na
    float bestBot = na
    int   n = zl.zoneCount(lvlEng)
    if n > 0
        for i = 0 to n - 1
            zl.ZoneLevel z = zl.zoneAt(lvlEng, i)
            if z.trackId >= 0 and z.zoneLevel >= minLv
                if dir > 0
                    if z.state == ST_RESIST and z.bottom > entry and (na(bestBot) or z.bottom < bestBot)
                        bestTop := z.top
                        bestBot := z.bottom
                else
                    if z.state == ST_SUPPORT and z.top < entry and (na(bestTop) or z.top > bestTop)
                        bestTop := z.top
                        bestBot := z.bottom
    float tp = na
    if not na(bestTop) and not na(bestBot)
        float w = bestTop - bestBot
        tp := dir > 0 ? (bestBot + w * depth) - buf : (bestTop - w * depth) + buf
    tp

// ---- 6.3 Risk / Qty (既存Strategyの計算方式のみ移植) -----------------------
//    Risk Capital = (useCompound ? strategy.equity : strategy.initial_capital) × riskPct%
//    Qty          = Risk Capital ÷ (SL距離 × syminfo.pointvalue) → qtyStep単位へ floor
f_riskCapital() =>
    (useCompound ? strategy.equity : strategy.initial_capital) * riskPct / 100.0

f_qty(float slDist) =>
    float raw = slDist > 0 ? f_riskCapital() / (slDist * syminfo.pointvalue) : 0.0
    float q   = qtyStep > 0 ? math.floor(raw / qtyStep) * qtyStep : raw
    math.round(q, 8)

// ---- 6.4 Trade 構築 (SL / TP / RR / Qty) -----------------------------------
//  ★ RECOVERY_CLOSE / EDGE_LIMIT の両方から呼ぶ共通処理 ★
//    entryPx が基準価格 (RECOVERY_CLOSE = 確定足の close /
//    EDGE_LIMIT = Limit注文価格 = Zone手前端)。
//    ★ EDGE_LIMIT では「注文価格」と「SL / TP / RR / Qty の計算基準価格」が
//      必ずこの同じ Limit価格になる。
//    ★ 中身は従来 Section 7.2 - 7.5 の判定順序・条件をそのまま関数化しただけで、
//      式は1つも変えていない (RECOVERY_CLOSE の結果は修正前と完全一致)。
//  戻り値: [ok, sl, tp, rr, qty, slDist]
f_buildTrade(int dir, float entryPx, float zTop, float zBot) =>
    //  SL は Entry対象になった Zone 自身
    float sl     = dir > 0 ? zBot - slBuffer : zTop + slBuffer
    float slDist = math.abs(entryPx - sl)
    bool  ok     = (dir > 0 ? sl < entryPx : sl > entryPx) and slDist > 0 and slDist <= maxSlDist
    float tp = na
    float rr = na
    if ok and tpMode == "FIXED_RR"
        //  Structural Zone を完全に無視 (TP Zone探索を行わない)
        tp := dir > 0 ? entryPx + slDist * fixedRR : entryPx - slDist * fixedRR
        rr := fixedRR
    else if ok and tpMode == "FIXED_MOVE"
        //  実際の Entry価格から固定ドル幅 (同じく TP Zone探索を行わない)
        tp := dir > 0 ? entryPx + fixedMove : entryPx - fixedMove
        rr := fixedMove / slDist
    else if ok
        float stTp = f_findStructuralTp(dir, entryPx, minTpLevel, tpDepthRatio, tpBuffer)
        if not na(stTp)
            rr := (dir > 0 ? stTp - entryPx : entryPx - stTp) / slDist
            if tpMode == "FALLBACK_ONLY"
                //  Structural TP が存在するシグナル自体を除外する
                ok := false
            else if rr < minRR
                //  Structural TP があるのに Minimum RR 未満 → NoTrade
                ok := false
            else
                tp := stTp
        else
            if tpMode == "STRUCTURAL_ONLY"
                ok := false
            else
                tp := dir > 0 ? entryPx + slDist * fallbackRR : entryPx - slDist * fallbackRR
                rr := fallbackRR
    float qty = 0.0
    if ok and not na(tp)
        qty := f_qty(slDist)
    bool fin = ok and not na(tp) and qty >= qtyMin and qty > 0
    [fin, sl, tp, rr, qty, slDist]

// ---- 6.5 EDGE_LIMIT の候補Zone探索 -----------------------------------------
//  Long  : 現在価格より下にある SUPPORT のうち、zone.top が現在価格に最も近いもの
//          (条件 : state == SUPPORT / close > zone.top = 上から接近している)
//  Short : 現在価格より上にある RESIST のうち、zone.bottom が最も近いもの
//          (条件 : state == RESIST / close < zone.bottom = 下から接近している)
//  ★ Level は Edge Limit Level Source で決まる ★
//    CURRENT_PRE_TOUCH    : 今この時点で分かっている zoneLevel (タッチ前 Level)
//    PROJECTED_POST_TOUCH : 次の Touch 後の Level (ZoneLevelEngine が計算する)
//    どちらも「今 分かっている情報」だけで決まる。まだ起きていない Touch 後の
//    実測 Level を先読みしているわけではない (未来参照ではない)。
//  ★ T1_ONLY は「注文を置く時点で touchCount == 0」= 次のタッチが T1 になる Zone。
//  ★ すでに Entry済みの trackId + touchCount は候補にしない (注文も置かない)。
//  戻り値: スナップショット内の index (見つからなければ -1)
f_findEdgeZone(int dir) =>
    int   bestIdx  = -1
    float bestEdge = na
    int   n = zl.zoneCount(lvlEng)
    if n > 0
        for i = 0 to n - 1
            zl.ZoneLevel z = zl.zoneAt(lvlEng, i)
            if z.trackId >= 0
                //  ★ 判定に使う Level は Edge Limit Level Source で切り替える ★
                //    CURRENT_PRE_TOUCH    : 今の zoneLevel (従来どおり)
                //    PROJECTED_POST_TOUCH : 次の Touch 後の Level
                //      (Section 04B 経由で ZoneLevelEngine の levelFrom() を呼ぶ
                //       だけ。Strategy 側では Level を計算しない)
                //    T1_ONLY と組み合わせると「今 touchCount = 0 で、次の T1 が
                //    起きたら Level が条件を満たす Zone」だけが候補になる。
                int lvUse = edgeLevelSource == "PROJECTED_POST_TOUCH" ? f_projectedLevel(z) : z.zoneLevel
                bool lvOk  = edgeLevelMatch == "EXACT" ? lvUse == edgeLevel : lvUse >= edgeLevel
                bool tcOk  = edgeTouchMode == "ALL" or z.touchCount == 0
                bool dupOk = not (gEnteredTouch.contains(z.trackId) and z.touchCount <= gEnteredTouch.get(z.trackId))
                if lvOk and tcOk and dupOk
                    if dir > 0
                        if z.state == ST_SUPPORT and close > z.top and (na(bestEdge) or z.top > bestEdge)
                            bestEdge := z.top
                            bestIdx  := i
                    else
                        if z.state == ST_RESIST and close < z.bottom and (na(bestEdge) or z.bottom < bestEdge)
                            bestEdge := z.bottom
                            bestIdx  := i
    bestIdx

// ============================================================================
// 07. ENTRY EXECUTION
// ----------------------------------------------------------------------------
//  ★ Entry Mode は2つ。同時には片方しか動かない ★
//    7.1 RECOVERY_CLOSE : 従来どおり Zoneタッチ → Recovery確認 → 確定足closeで成行
//    7.2 EDGE_LIMIT     : タッチ前に Zone手前端へ Limit注文を置き、価格到達で約定
//    entryMode == "RECOVERY_CLOSE" のときの挙動は EDGE_LIMIT 追加前と完全一致する。
//    ★ entryMode == "CSV_MATCH" のときは、このセクションのどちらの分岐にも
//      入らない = 注文を1つも出さない (母集団の集計だけを Section 11 で行う)。
//      CSV_MATCH と TRADABLE (EDGE_LIMIT) は同時には動かない。
//
//  ★ 重複Entry防止 (両Mode共通) ★
//    (1) 最大同時保有は Strategy全体で 1 ポジション。
//        ポジションが無いときだけ新規Entry / 新規Limit注文を許可する。
//    (2) 同じ Zone の同じ Touch で複数回入らない。
//        Entry時に trackId → そのときの touchCount を map へ記録する。
//        ★ 記録するのはどちらの Mode も「タッチ反映後の touchCount」★
//          RECOVERY_CLOSE : Entry判定がタッチ後の snapshot で行われるので
//                           そのときの touchCount をそのまま記録する。
//          EDGE_LIMIT     : 候補判定 (発注) がタッチ前なので、約定した時点で
//                           pending の touchCount + 1 を記録する
//                           (約定した = そのZoneで次の Touch が起きた)。
//        どちらも「1 Touch につき 1 Entry」になる。
//    ★ 巨大なイベントEngineは作らない。map 1本と数個の var だけ。
// ============================================================================
//  ★ gEnteredTouch は Section 06 の f_findEdgeZone() からも参照するため、
//    宣言はこのセクションではなく Section 06 の直前に置いてある (2重宣言しない)。
var int    gSeq  = 0                                    // Entry ID 連番 (RECOVERY_CLOSE用)
var string gEid  = na                                   // 現在保有中の Entry ID
var float  gTP   = na                                   // Entry時に確定したTP (最後まで維持)
var bool   gBeOn = false                                // 建値移動 済みフラグ

// ---- 7.1 RECOVERY_CLOSE (従来ロジック · 変更なし) ---------------------------
if entryMode == "RECOVERY_CLOSE" and barstate.isconfirmed and strategy.position_size == 0 and strategy.opentrades == 0
    //  Long を先に見て、成立していなければ Short を見る
    //  (同一バーで両方成立することは通常起きないが、起きた場合は Long 優先)。
    int _dir = 0
    int _idx = -1
    if enableLong
        int _li = f_findReboundZone(1, minEntryLevel, reboundRecoveryRatio)
        if _li >= 0
            _dir := 1
            _idx := _li
    if enableShort and _dir == 0
        int _si = f_findReboundZone(-1, minEntryLevel, reboundRecoveryRatio)
        if _si >= 0
            _dir := -1
            _idx := _si

    if _dir != 0
        zl.ZoneLevel _z = zl.zoneAt(lvlEng, _idx)
        //  同一 trackId + touchCount の重複Entry防止
        bool _dup = gEnteredTouch.contains(_z.trackId) and _z.touchCount <= gEnteredTouch.get(_z.trackId)
        if not _dup
            //  SL / TP / RR / Qty (基準価格は確定足の close)
            float _entry = close
            [_ok, _sl, _tp, _rr, _qty, _slDist] = f_buildTrade(_dir, _entry, _z.top, _z.bottom)
            if _ok
                gSeq := gSeq + 1
                string _eid = LOGIC_ZONE_RB + (_dir > 0 ? "_L_" : "_S_") + str.tostring(gSeq)
                strategy.entry(_eid, _dir > 0 ? strategy.long : strategy.short, qty = _qty)
                //  ★ Entry時点の SL / TP をここで固定する。
                //    保有中に Zone / Level が変わっても TP は動かさない (Dynamic TP 非実装)。
                strategy.exit(_eid + "X", from_entry = _eid, stop = _sl, limit = _tp,
                     comment_loss = "SL", comment_profit = "TP")
                gEid  := _eid
                gTP   := _tp
                gBeOn := false
                gEnteredTouch.put(_z.trackId, _z.touchCount)

                if showEntryLabel
                    //  ★ 表示専用ブロック。ここで計算した値は Entry判定にも
                    //    SL / TP にも一切使わない (すでに発注は確定している)。
                    //  ★ BirthScore / Raw Score は従来どおり参考表示だけ。
                    bool _hasPre = gPreTouchLevel.contains(_z.trackId)
                    int  _preLv  = _hasPre ? gPreTouchLevel.get(_z.trackId) : -1
                    int  _usedLv = entryLevelMode == "PRE_TOUCH" ? _preLv : _z.zoneLevel
                    string _t = (_dir > 0 ? "LONG" : "SHORT")
                    _t := _t + "\nEntry      " + f_num(_entry, "#.##")
                    _t := _t + "\nSL         " + f_num(_sl, "#.##") + "  (" + f_num(_slDist, "#.##") + ")"
                    _t := _t + "\nTP         " + f_num(_tp, "#.##")
                    _t := _t + "\nRR         " + f_num(_rr, "#.##")
                    _t := _t + "\nTP Mode    " + tpMode
                    if tpMode == "FIXED_RR"
                        _t := _t + "\nFixed RR   " + f_num(fixedRR, "#.##")
                    if tpMode == "FIXED_MOVE"
                        _t := _t + "\nMove       $" + f_num(fixedMove, "#.##")
                    _t := _t + "\nLevel Used " + f_levelName(_usedLv)
                    _t := _t + "\nLevel Mode " + entryLevelMode
                    _t := _t + "\nPre Level  " + f_levelName(_preLv)
                    _t := _t + "\nPost Level " + _z.zoneLevelName
                    _t := _t + "\nTouch      " + str.tostring(_z.touchCount)
                    _t := _t + "\nBirth      " + f_num(_z.birthScore, "#.#") + "  (参考)"
                    _t := _t + "\nRaw        " + f_num(_z.rawScore, "#.#") +
                         " / " + zn.strengthName(_z.rawStrength) + "  (参考)"
                    _t := _t + "\nID         " + str.tostring(_z.trackId) + " · " + _eid
                    label.new(bar_index, _dir > 0 ? low : high, text = _t,
                         style     = _dir > 0 ? label.style_label_up : label.style_label_down,
                         color     = _dir > 0 ? color.new(color.teal, 20) : color.new(color.maroon, 20),
                         textcolor = color.white,
                         size      = size.small)

// ---- 7.2 EDGE_LIMIT (Zone手前端への事前Limit注文) ---------------------------
//  ★ 疑似約定にしないための作り ★
//    ・注文はタッチ前の確定足で strategy.entry(..., limit = Zone手前端) として出す。
//    ・約定するのは、その後のバーで実際に価格がその指値へ到達したときだけ。
//    ・「タッチを確認してから過去の Zone端価格で約定したことにする」処理は無い。
//    ・lookahead / request.security_lower_tf / SignalEngine は使わない。
//
//  ★ 注文IDは Long / Short それぞれ固定 ★
//    同じIDで strategy.entry を出し直すと未約定Limitの価格 / Qty が更新される。
//    候補が消えた場合は strategy.cancel() で取り消す (古い指値を残さない)。
//
//  ★ Long / Short の両方に候補があれば両方置く ★
//    ただし OCA (oca_type = strategy.oca.cancel) で結び、片方が約定したら
//    もう片方は自動でキャンセルされる (同一バー内の両建て事故を防ぐ)。
//
//  ★ SL / TP は発注と同時に strategy.exit で予約する ★
//    from_entry の指値が約定するまで待機し、約定した瞬間から有効になる。
//    → 約定バーの途中で SL / TP に届いた場合もその足で処理される。
string EDGE_ID_L = LOGIC_ZONE_RB + "_L"
string EDGE_ID_S = LOGIC_ZONE_RB + "_S"
//  未約定Limitの控え (約定を検知したときに Entry済み記録 / BE用TPへ使う)
var bool   gPendLOn  = false
var int    gPendLTid = -1
var int    gPendLTc  = -1
var float  gPendLTp  = na
var float  gPendLSl  = na
var string gPendLTxt = ""
var bool   gPendSOn  = false
var int    gPendSTid = -1
var int    gPendSTc  = -1
var float  gPendSTp  = na
var float  gPendSSl  = na
var string gPendSTxt = ""
//  約定検知用 (opentrades + closedtrades が増えた = どれかの注文が約定した)
var int    gLastTradeCnt = 0
//  CSV Parity Audit 用 : EDGE_LIMIT が実際に約定した回数 (表示専用)
var int    gAuditFills   = 0

if entryMode == "EDGE_LIMIT" and barstate.isconfirmed
    // ---- 7.2a 約定検知 → Entry済み記録 / ラベル ---------------------------
    //  ★ 注文を置いただけでは Entry済みにしない。未約定キャンセルも記録しない。
    //    実際に約定した Zone の trackId + touchCount だけを記録する。
    int _tradeCnt = strategy.opentrades + strategy.closedtrades
    if _tradeCnt > gLastTradeCnt
        //  CSV Parity Audit 用の約定カウンタ (表示専用)
        gAuditFills := gAuditFills + 1
        //  約定した向き (まだ保有中ならそれ、同じ足で決済済みなら最後のClosed)
        bool _fLong = strategy.opentrades > 0 ? strategy.opentrades.size(0) > 0 :
             strategy.closedtrades.size(strategy.closedtrades - 1) > 0
        if _fLong and gPendLOn
            //  ★ +1 する理由 : pending の touchCount は「注文を置いた時点 =
            //    Touch前」の値。約定した = そのZoneで次の Touch が起きた、という
            //    ことなので、Touch反映後の値 (+1) を Entry済みとして記録する。
            //    (例 : pending 0 → T1で約定 → 1 を保存 / pending 1 → T2 → 2)
            //    こうすると同じ Touch での再Entryを防げる。
            gEnteredTouch.put(gPendLTid, gPendLTc + 1)
            gEid  := EDGE_ID_L
            gTP   := gPendLTp
            gBeOn := false
            //  ★ 保険 : 発注と同時に予約した SL / TP をここでも出し直す ★
            //    同じIDなので上書きされるだけ。約定が確定したこの時点で
            //    必ず SL / TP が有効になっていることを保証する。
            if strategy.opentrades > 0
                strategy.exit(EDGE_ID_L + "X", from_entry = EDGE_ID_L,
                     stop = gPendLSl, limit = gPendLTp,
                     comment_loss = "SL", comment_profit = "TP")
            if showEntryLabel and gPendLTxt != ""
                label.new(bar_index, low, text = gPendLTxt, style = label.style_label_up,
                     color = color.new(color.teal, 20), textcolor = color.white, size = size.small)
        else if not _fLong and gPendSOn
            //  ★ Long側と同じ理由で +1 (Touch反映後の値を記録する)
            gEnteredTouch.put(gPendSTid, gPendSTc + 1)
            gEid  := EDGE_ID_S
            gTP   := gPendSTp
            gBeOn := false
            //  ★ 保険 (Long側と同じ。同じIDなので上書きされるだけ)
            if strategy.opentrades > 0
                strategy.exit(EDGE_ID_S + "X", from_entry = EDGE_ID_S,
                     stop = gPendSSl, limit = gPendSTp,
                     comment_loss = "SL", comment_profit = "TP")
            if showEntryLabel and gPendSTxt != ""
                label.new(bar_index, high, text = gPendSTxt, style = label.style_label_down,
                     color = color.new(color.maroon, 20), textcolor = color.white, size = size.small)
        //  約定した側の控えは用済み。反対側は OCA で取り消されている。
        gPendLOn := false
        gPendSOn := false
    gLastTradeCnt := _tradeCnt

    // ---- 7.2b 未約定Limitの再評価 (毎確定足) ------------------------------
    bool _flat = strategy.position_size == 0 and strategy.opentrades == 0
    if not _flat
        //  保有中は新規Limitを置かない。残っている未約定Limitは取り消す。
        if gPendLOn
            strategy.cancel(EDGE_ID_L)
            strategy.cancel(EDGE_ID_L + "X")
            gPendLOn := false
        if gPendSOn
            strategy.cancel(EDGE_ID_S)
            strategy.cancel(EDGE_ID_S + "X")
            gPendSOn := false
    else
        //  ---- Long 側 ----
        //  候補Zoneが消えた / Level・State・Touch条件から外れた / 別Zoneの方が
        //  近くなった場合は、下の f_findEdgeZone() の結果が変わるだけで済む。
        //  同じIDで出し直せば未約定Limitは新しい価格へ更新され、候補が無ければ
        //  取り消される。
        bool _lPlaced = false
        if enableLong
            int _eiL = f_findEdgeZone(1)
            if _eiL >= 0
                zl.ZoneLevel _ezL = zl.zoneAt(lvlEng, _eiL)
                float _limL = _ezL.top
                [_okL, _slL, _tpL, _rrL, _qtyL, _sdL] = f_buildTrade(1, _limL, _ezL.top, _ezL.bottom)
                if _okL
                    strategy.entry(EDGE_ID_L, strategy.long, qty = _qtyL, limit = _limL,
                         oca_name = "ZRB_EDGE", oca_type = strategy.oca.cancel)
                    strategy.exit(EDGE_ID_L + "X", from_entry = EDGE_ID_L, stop = _slL, limit = _tpL,
                         comment_loss = "SL", comment_profit = "TP")
                    gPendLOn  := true
                    gPendLTid := _ezL.trackId
                    gPendLTc  := _ezL.touchCount
                    gPendLTp  := _tpL
                    gPendLSl  := _slL
                    _lPlaced  := true
                    if showEntryLabel
                        //  ラベル文面は発注時に作り、実際に約定したときだけ表示する。
                        string _tl = "LONG (EDGE LIMIT)"
                        _tl := _tl + "\nEntry      " + f_num(_limL, "#.##")
                        _tl := _tl + "\nSL         " + f_num(_slL, "#.##") + "  (" + f_num(_sdL, "#.##") + ")"
                        _tl := _tl + "\nTP         " + f_num(_tpL, "#.##")
                        _tl := _tl + "\nRR         " + f_num(_rrL, "#.##")
                        _tl := _tl + "\nTP Mode    " + tpMode
                        _tl := _tl + "\nLevel      " + _ezL.zoneLevelName + " (発注時)"
                        _tl := _tl + "\nTouch      " + str.tostring(_ezL.touchCount) + " (発注時)"
                        _tl := _tl + "\nBirth      " + f_num(_ezL.birthScore, "#.#") + "  (参考)"
                        _tl := _tl + "\nRaw        " + f_num(_ezL.rawScore, "#.#") +
                             " / " + zn.strengthName(_ezL.rawStrength) + "  (参考)"
                        _tl := _tl + "\nID         " + str.tostring(_ezL.trackId)
                        gPendLTxt := _tl
        if not _lPlaced and gPendLOn
            strategy.cancel(EDGE_ID_L)
            strategy.cancel(EDGE_ID_L + "X")
            gPendLOn := false

        //  ---- Short 側 (完全対称) ----
        bool _sPlaced = false
        if enableShort
            int _eiS = f_findEdgeZone(-1)
            if _eiS >= 0
                zl.ZoneLevel _ezS = zl.zoneAt(lvlEng, _eiS)
                float _limS = _ezS.bottom
                [_okS, _slS, _tpS, _rrS, _qtyS, _sdS] = f_buildTrade(-1, _limS, _ezS.top, _ezS.bottom)
                if _okS
                    strategy.entry(EDGE_ID_S, strategy.short, qty = _qtyS, limit = _limS,
                         oca_name = "ZRB_EDGE", oca_type = strategy.oca.cancel)
                    strategy.exit(EDGE_ID_S + "X", from_entry = EDGE_ID_S, stop = _slS, limit = _tpS,
                         comment_loss = "SL", comment_profit = "TP")
                    gPendSOn  := true
                    gPendSTid := _ezS.trackId
                    gPendSTc  := _ezS.touchCount
                    gPendSTp  := _tpS
                    gPendSSl  := _slS
                    _sPlaced  := true
                    if showEntryLabel
                        string _ts = "SHORT (EDGE LIMIT)"
                        _ts := _ts + "\nEntry      " + f_num(_limS, "#.##")
                        _ts := _ts + "\nSL         " + f_num(_slS, "#.##") + "  (" + f_num(_sdS, "#.##") + ")"
                        _ts := _ts + "\nTP         " + f_num(_tpS, "#.##")
                        _ts := _ts + "\nRR         " + f_num(_rrS, "#.##")
                        _ts := _ts + "\nTP Mode    " + tpMode
                        _ts := _ts + "\nLevel      " + _ezS.zoneLevelName + " (発注時)"
                        _ts := _ts + "\nTouch      " + str.tostring(_ezS.touchCount) + " (発注時)"
                        _ts := _ts + "\nBirth      " + f_num(_ezS.birthScore, "#.#") + "  (参考)"
                        _ts := _ts + "\nRaw        " + f_num(_ezS.rawScore, "#.#") +
                             " / " + zn.strengthName(_ezS.rawStrength) + "  (参考)"
                        _ts := _ts + "\nID         " + str.tostring(_ezS.trackId)
                        gPendSTxt := _ts
        if not _sPlaced and gPendSOn
            strategy.cancel(EDGE_ID_S)
            strategy.cancel(EDGE_ID_S + "X")
            gPendSOn := false

// ============================================================================
// 08. BREAK EVEN
// ----------------------------------------------------------------------------
//  軽量な単一Logic用。保有は常に最大1ポジションなので、opentrades(0) だけを見る。
//  ONになったら SL を Entry価格へ移動する。TP は Entry時点の値 (gTP) を維持する。
//
//  ★ 軽量版v1では判定を「確定足の終値」だけにしている ★
//    Long  : barstate.isconfirmed and close >= entry + breakEvenTrigger
//    Short : barstate.isconfirmed and close <= entry - breakEvenTrigger
//    「到達瞬間 (その足の高値 / 安値が触れた時点)」モードは実装していない。
//    足の途中で建値移動を作動させるには calc_on_every_tick = true が必要になり、
//    軽量版の前提 (確定足でのみ再計算する) と衝突するため。
//    calc_on_every_tick は false のまま変更しない。
//
//  ★ Dynamic TP は実装していない (TPを近づける / 遠ざける処理は無い)。
//  ★ 建値移動は1トレードにつき1回だけ strategy.exit を出し直す (毎バー再発行しない)。
// ============================================================================
if useBreakEven and barstate.isconfirmed and strategy.opentrades > 0 and not gBeOn and not na(gEid)
    float _ep     = strategy.opentrades.entry_price(0)
    bool  _isLong = strategy.opentrades.size(0) > 0
    bool  _reach  = _isLong ? close >= _ep + breakEvenTrigger : close <= _ep - breakEvenTrigger
    if _reach
        gBeOn := true
        strategy.exit(gEid + "X", from_entry = gEid, stop = _ep, limit = gTP,
             comment_loss = "BE", comment_profit = "TP")

// ============================================================================
// 09. ZONE LEVEL DISPLAY (任意 · 既定OFF)
// ----------------------------------------------------------------------------
//  ★ Zone Level Display と同じ「ZoneLevel基準」の描画を流用したもの ★
//    透明度 / 線の太さ / 表示可否 はすべて zoneLevel 基準で、Raw Strength は
//    使わない。Level / State / TouchCount が確認できれば十分なので、
//    詳細ラベル (Birth / Raw / Source 一覧) は持っていない。
//  ★ 軽量化のため既定OFF。barstate.islast でのみ再描画するので、ONにしても
//    毎バー描画オブジェクトが増えることはない。
//  ★ 描画はロジックに一切影響しない (Entry / SL / TP / Qty から参照されない)。
// ============================================================================
var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()

f_lvlClear() =>
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    while array.size(gLabels) > 0
        label.delete(array.pop(gLabels))
    true

//  State → 色 (色だけ State 依存。Level には影響しない)
f_stateColor(int st) =>
    st == ST_SUPPORT ? color.new(#2962FF, 0) : st == ST_RESIST ? color.new(#EF5350, 0) :
     st == ST_ACTIVE ? color.new(#FFB300, 0) : color.new(#78909C, 0)

//  Level → 透明度 / 線の太さ
f_lvlTransp(int lvl) =>
    lvl == LVL_VS ? 50 : lvl == LVL_S ? 65 : lvl == LVL_M ? 80 : 90

f_lvlWidth(int lvl) =>
    lvl == LVL_VS ? 3 : lvl == LVL_S ? 2 : 1

if showZones and barstate.islast
    bool _cleared = f_lvlClear()
    int  _n = zl.zoneCount(lvlEng)
    if _n > 0
        int _drawn = 0
        //  Level の高いものから順に描き、Max Zones Drawn で打ち切る。
        for _lv = LVL_VS to LVL_W
            for _i = 0 to _n - 1
                if _drawn < maxZonesDraw
                    zl.ZoneLevel _z = zl.zoneAt(lvlEng, _i)
                    //  BROKEN は描かない (Entry / TP の対象外なので表示もしない)。
                    bool _ok = _z.trackId >= 0 and _z.zoneLevel == _lv and
                         _z.zoneLevel >= minDisplayLevel and _z.state != ST_BROKEN
                    if _ok
                        color _bc = f_stateColor(_z.state)
                        int   _tr = f_lvlTransp(_z.zoneLevel)
                        box _b = box.new(
                             left         = bar_index - zoneLeftBars,
                             top          = _z.top,
                             right        = bar_index + zoneRightBars,
                             bottom       = _z.bottom,
                             bgcolor      = color.new(_bc, _tr),
                             border_color = color.new(_bc, math.max(_tr - 30, 0)),
                             border_width = f_lvlWidth(_z.zoneLevel),
                             border_style = _z.state == ST_ACTIVE ? line.style_dashed : line.style_solid,
                             xloc         = xloc.bar_index)
                        array.push(gBoxes, _b)
                        _drawn += 1
                        if showLabels
                            //  Level名は ZoneLevel.zoneLevelName をそのまま使う
                            //  (Strategy側で Level 名を作らない)。
                            label _l = label.new(
                                 x         = bar_index + zoneRightBars,
                                 y         = (_z.top + _z.bottom) / 2,
                                 text      = _z.zoneLevelName + "\nT" + str.tostring(_z.touchCount),
                                 xloc      = xloc.bar_index,
                                 style     = label.style_label_left,
                                 color     = color.new(_bc, math.max(_tr - 20, 0)),
                                 textcolor = color.white,
                                 size      = size.small)
                            array.push(gLabels, _l)


// ============================================================================
// 10. LOGGER REPRO (診断専用 · 既定OFF)
// ----------------------------------------------------------------------------
//  ★ これは Trade を作る機能ではない ★
//    Zone Touch Logger CSV と同じ考え方で
//      「Zoneタッチ後に Zone手前端から +$10 / +$20 / +$30 反発したか」
//    を数えるだけの診断機能。
//    ・strategy.entry / strategy.exit を呼ばない
//    ・Qty / PnL / Entry / SL / TP / Break Even に一切影響しない
//    ・refPrice で約定したことにしない (足の途中のタッチ価格へ遡らない)
//    ・lookahead / request.security_lower_tf / 新規 request を追加しない
//    ・SignalEngine / Event Engine / Dynamic TP を追加しない
//    ・ZoneLevel を Main 側で再計算しない
//
//  ★★ 評価期間は「タッチ足を除いた その後 48本の確定5分足」固定 ★★
//    元CSV (OANDA_XAUUSD, 5) の全 Touch Event を再解析した結果、EV_MFE は
//    タッチ足を含まない +1 ～ +48 本の MFE と一致した。よってここも同じにする。
//      Long  : MFE = max(high of bars +1 ～ +48) - refPrice
//      Short : MFE = refPrice - min(low  of bars +1 ～ +48)
//      MFE の下限は 0 (不利側へしか動かなかった Event は 0)。
//    ・Event 作成足は age = 0。この足では MFE を更新しない。
//    ・次の確定足が age = 1。age 1 ～ 48 だけ更新する。
//    ・age = 48 を評価した後に Event を削除する。
//
//  ★★ 48本の間は途中終了しない ★★
//    元CSVでは、同じZoneへ次のTouchが来ても / BROKEN になっても /
//    tracking lost になっても、その Touch Event 自身の MFE はタッチ後48本で
//    評価されている。したがって以下は「終了条件にしない」:
//      ・新しい Touch    ・BROKEN    ・tracking lost    ・全Target到達
//    唯一の終了条件は age = 48 に到達すること。
//
//  ★ Event の一意キーは trackId + touchCount ★
//    同じ trackId の T1 / T2 は別 Event として同時に保持する
//    (T1 は自分の48本評価を続けたまま、T2 が新しく始まる)。
//
//  ★ 新規 Touch Event の起点は ZoneLevelEngine の TouchCount 増加だけ ★
//    同じ trackId について「今回の touchCount > 1本前の touchCount」。
//    Zoneタッチ条件を Strategy 側で再実装しない。
//    ※ 1本前の記録が無い trackId (snapshotに初登場) は起点にしない
//      (「増加した」と言えないため)。
//
//  ★ refPrice は Zone の「手前端」(現行仕様のまま) ★
//    Long  (SUPPORT) : refPrice = Zone Top
//    Short (RESIST)  : refPrice = Zone Bottom
//
//  ※ チャート末尾 48本以内に発生した Event は、48本ぶんの評価が終わらないまま
//    Events に計上される (途中までの Hit だけが数えられる)。期間末尾の
//    数イベントぶんだけ Hit率がわずかに下振れしうる点に注意。
//
//  ★ 軽量性 : useLoggerRepro = false のときはこのセクションを一切実行しない。
//    テーブルも作らない。Event 管理は小さな配列だけ (追加 request は無し)。
// ============================================================================
//  ★ 評価期間は固定 48本 (元CSV解析で確定した値なので input にしない)
int LOG_HORIZON = 48

//  Active Event (配列は必ず同じ index で対応している)
var array<int>   gLogId    = array.new_int()     // trackId       (キーの一部)
var array<int>   gLogTc    = array.new_int()     // touchCount    (キーの一部)
var array<int>   gLogDir   = array.new_int()     // 1 = Long(SUPPORT) / -1 = Short(RESIST)
var array<float> gLogRef   = array.new_float()   // refPrice (Zone手前端)
var array<int>   gLogStart = array.new_int()     // startBar (= Touch足の bar_index)
var array<float> gLogMfe   = array.new_float()   // Max Favorable Excursion (下限 0)
var array<bool>  gLogH1    = array.new_bool()    // Target #1 到達済み (集計済み)
var array<bool>  gLogH2    = array.new_bool()
var array<bool>  gLogH3    = array.new_bool()
//  集計カウンタ (表示専用)
var int gLogEvents = 0
var int gLogHit1   = 0
var int gLogHit2   = 0
var int gLogHit3   = 0

if useLoggerRepro and barstate.isconfirmed
    // ---- 10.1 MFE 更新 / Target 判定 / 48本で終了 -------------------------
    //  ★ 先に既存 Event を処理する。こうすると、この足で作られる新しい Event
    //    (age = 0) がこの足の high / low で更新されることが構造的に起きない。
    //  ★ 後ろから回すのは、48本を終えた Event を安全に取り除くため。
    int _lgEn = array.size(gLogId)
    if _lgEn > 0
        for _lgK = _lgEn - 1 to 0
            int _lgAge = bar_index - array.get(gLogStart, _lgK)
            if _lgAge >= 1 and _lgAge <= LOG_HORIZON
                int   _lgD   = array.get(gLogDir, _lgK)
                float _lgRef = array.get(gLogRef, _lgK)
                //  Long : 最高値 - refPrice  /  Short : refPrice - 最安値
                float _lgFav = _lgD > 0 ? high - _lgRef : _lgRef - low
                float _lgMfe = math.max(math.max(array.get(gLogMfe, _lgK), _lgFav), 0.0)
                array.set(gLogMfe, _lgK, _lgMfe)
                //  Target 到達は「初めて超えた時」に1回だけ集計する
                if not array.get(gLogH1, _lgK) and _lgMfe >= loggerTarget1
                    array.set(gLogH1, _lgK, true)
                    gLogHit1 := gLogHit1 + 1
                if not array.get(gLogH2, _lgK) and _lgMfe >= loggerTarget2
                    array.set(gLogH2, _lgK, true)
                    gLogHit2 := gLogHit2 + 1
                if not array.get(gLogH3, _lgK) and _lgMfe >= loggerTarget3
                    array.set(gLogH3, _lgK, true)
                    gLogHit3 := gLogHit3 + 1
            //  ★ 終了条件は age = 48 に到達したときだけ ★
            //    BROKEN / tracking lost / 新Touch / 全Target到達では終了しない。
            if _lgAge >= LOG_HORIZON
                array.remove(gLogId,    _lgK)
                array.remove(gLogTc,    _lgK)
                array.remove(gLogDir,   _lgK)
                array.remove(gLogRef,   _lgK)
                array.remove(gLogStart, _lgK)
                array.remove(gLogMfe,   _lgK)
                array.remove(gLogH1,    _lgK)
                array.remove(gLogH2,    _lgK)
                array.remove(gLogH3,    _lgK)

    // ---- 10.2 新規 Touch Event 検出 (snapshot を1回だけ走査) -------------
    int _lgN = zl.zoneCount(lvlEng)
    if _lgN > 0
        for _lgI = 0 to _lgN - 1
            zl.ZoneLevel _lgZ = zl.zoneAt(lvlEng, _lgI)
            if _lgZ.trackId >= 0
                //  TouchCount 増加の検出 (ZoneLevelEngine の認識をそのまま使う)
                int  _lgPrevTc = gLogPrevTouch.contains(_lgZ.trackId) ? gLogPrevTouch.get(_lgZ.trackId) : -1
                bool _lgNewTouch = _lgPrevTc >= 0 and _lgZ.touchCount > _lgPrevTc
                if _lgNewTouch
                    //  方向は State から決める (ACTIVE / BROKEN は対象外)
                    int _lgDir = _lgZ.state == ST_SUPPORT ? 1 : _lgZ.state == ST_RESIST ? -1 : 0
                    //  抽出に使う Level (Main Entry の entryLevelMode とは独立)
                    int _lgPreLv = gPreTouchLevel.contains(_lgZ.trackId) ? gPreTouchLevel.get(_lgZ.trackId) : -1
                    int _lgLv = loggerLevelTiming == "PRE_TOUCH" ? _lgPreLv : _lgZ.zoneLevel
                    //  EXACT : そのLevelちょうど / MINIMUM : そのLevel以上
                    bool _lgLvOk = loggerLevelMatch == "EXACT" ? _lgLv == loggerLevel : _lgLv >= loggerLevel
                    bool _lgTcOk = loggerTouchMode == "ALL" or _lgZ.touchCount == 1
                    if _lgDir != 0 and _lgLvOk and _lgTcOk
                        //  ★ 同じ trackId に既存 Event があっても消さない ★
                        //    trackId + touchCount が別なら別 Event として同時保持する。
                        array.push(gLogId,    _lgZ.trackId)
                        array.push(gLogTc,    _lgZ.touchCount)
                        array.push(gLogDir,   _lgDir)
                        array.push(gLogRef,   _lgDir > 0 ? _lgZ.top : _lgZ.bottom)
                        array.push(gLogStart, bar_index)
                        array.push(gLogMfe,   0.0)
                        array.push(gLogH1,    false)
                        array.push(gLogH2,    false)
                        array.push(gLogH3,    false)
                        gLogEvents := gLogEvents + 1

// ---- 10.3 集計テーブル (表示専用) ------------------------------------------
//  Logger Repro が OFF のときは table.new すら呼ばない。
var table gLogTbl = na
if useLoggerRepro and barstate.islast
    if na(gLogTbl)
        gLogTbl := table.new(position.bottom_left, 3, 6, border_width = 1,
             frame_width = 1, frame_color = color.new(color.gray, 40))
    float _lgTot = gLogEvents
    color _lgHdr = color.new(color.black, 0)
    table.cell(gLogTbl, 0, 0, "LOGGER REPRO", text_color = color.white, bgcolor = _lgHdr, text_size = size.small)
    table.cell(gLogTbl, 1, 0, loggerLevelStr + " / " + loggerLevelMatch, text_color = color.white, bgcolor = _lgHdr, text_size = size.small)
    table.cell(gLogTbl, 2, 0, str.tostring(LOG_HORIZON) + " bars", text_color = color.white, bgcolor = _lgHdr, text_size = size.small)
    table.cell(gLogTbl, 0, 1, "Filter", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 1, 1, loggerLevelTiming + " / " + loggerTouchMode, text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 2, 1, "", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 0, 2, "Events", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 1, 2, str.tostring(gLogEvents), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 2, 2, "", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 0, 3, "$" + f_num(loggerTarget1, "#.#"), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 1, 3, str.tostring(gLogHit1) + " / " + str.tostring(gLogEvents), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 2, 3, f_num(_lgTot > 0 ? gLogHit1 / _lgTot * 100.0 : na, "#.#") + "%", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 0, 4, "$" + f_num(loggerTarget2, "#.#"), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 1, 4, str.tostring(gLogHit2) + " / " + str.tostring(gLogEvents), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 2, 4, f_num(_lgTot > 0 ? gLogHit2 / _lgTot * 100.0 : na, "#.#") + "%", text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 0, 5, "$" + f_num(loggerTarget3, "#.#"), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 1, 5, str.tostring(gLogHit3) + " / " + str.tostring(gLogEvents), text_color = color.white, text_size = size.small)
    table.cell(gLogTbl, 2, 5, f_num(_lgTot > 0 ? gLogHit3 / _lgTot * 100.0 : na, "#.#") + "%", text_color = color.white, text_size = size.small)

// ============================================================================
// 11. CSV PARITY AUDIT (診断専用)
// ----------------------------------------------------------------------------
//  ★ Trade を作らない / 変えない ★
//    strategy.entry / strategy.exit を呼ばず、Entry / SL / TP / Qty / PnL にも
//    一切影響しない。数えて表示するだけ。
//
//  ★ 目的 ★
//    「CSV_MATCH が Touch 前に拾える T1 の集合」と
//    「元CSV / Logger の POST_TOUCH Strong EXACT T1 の集合」が
//    同じになっているかを、同じ期間・同じ画面で突き合わせる。
//    ★ 最初に見るのは PnL ではなく Mismatch = 0 ★
//
//  ★ 数えているもの (T1 の比較はすべて EXACT 固定) ★
//    Logger Strong T1 (POST)
//        Touch 後の実 zoneLevel == Edge Limit Level だった T1 の数。
//        元CSV の母集団の定義そのもの (POST_TOUCH / Strong / EXACT / T1)。
//    CSV_MATCH T1 (PROJ)
//        その Touch の直前に予測していた Level == Edge Limit Level だった T1 の数。
//        CSV_MATCH モードが「Touch 前に」拾える集合。
//        ★ 絞り込みは touchCount == 0 と予測 Level だけ ★
//          現在 Level / 最寄り Zone / Zone間の優先順位は一切使っていない。
//    Match / Mismatch (set)
//        両方に入った T1 / 片方にしか入らなかった T1。★ Mismatch の目標は 0 ★
//    Projected Mismatch
//        全 Touch を対象にした「予測 Level == 実際の zoneLevel」の検算。
//        ★ ここも目標 0 ★
//        0 でない場合、Strategy 側で帳尻を合わせることは絶対にしない。
//        予測と実 Level が同じ内部関数 (f_levelOf) を通っていないサイン。
//    Watchlist now
//        いま現在「次の Touch が T1 で、その Level が条件を満たす」Zone の本数。
//    Logger Repro Events / EDGE Fills / Closed
//        参考。Logger の実測値と、TRADABLE (EDGE_LIMIT) の実約定数。
//        集合が合っていても、1ポジション制限や SL距離超過で実トレードは
//        間引かれるので、母集団と実トレード数は分けて表示する。
//
//  ★ 起点は Logger Repro と同じ「ZoneLevelEngine の TouchCount 増加」だけ ★
//    Zoneタッチ条件を Strategy 側で再実装しない。
// ============================================================================
//  ---- 母集団の比較 (すべて EXACT / T1 固定) ----
//    gCsvPostT1  : Touch 後の実 Level が Edge Limit Level と一致した T1 の数
//                  = 元CSV / Logger の「POST_TOUCH Strong EXACT T1」の定義そのもの
//    gCsvProjT1  : Touch 前に予測した Level が一致していた T1 の数
//                  = CSV_MATCH モードが拾える集合 (Strategy が事前に分かる側)
//    gCsvMatch   : 両方に入った T1 (= 同じイベント)
//    gCsvMismatch: 片方にしか入らなかった T1  ★ 目標 0 ★
var int gCsvPostT1   = 0
var int gCsvProjT1   = 0
var int gCsvMatch    = 0
var int gCsvMismatch = 0
//  ---- Level 一致の検算 (全Touch対象) ----
var int gProjCorrect  = 0   // 予測 Level == 実際の Level
var int gProjMismatch = 0   // 予測 Level != 実際の Level
//  ---- 現在の CSV_MATCH 候補数 (watchlist) ----
var int gWatchNow = 0

if useParityAudit and barstate.isconfirmed
    int _paWatch = 0
    int _paN = zl.zoneCount(lvlEng)
    if _paN > 0
        for _paI = 0 to _paN - 1
            zl.ZoneLevel _paZ = zl.zoneAt(lvlEng, _paI)
            if _paZ.trackId >= 0
                //  ---- (0) CSV_MATCH の候補条件 (今この時点の watchlist) ----
                //    ・touchCount == 0 (次の Touch が T1 になる)
                //    ・次Touch後の予測 Level == Edge Limit Level (EXACT)
                //    絞り込みはこれだけ。現在 Level / 最寄り / 優先順位は使わない。
                if _paZ.touchCount == 0 and f_projectedLevel(_paZ) == edgeLevel
                    _paWatch += 1
                //  Touch が起きたか (Logger Repro と同じ判定)
                int  _paPrevTc = gLogPrevTouch.contains(_paZ.trackId) ? gLogPrevTouch.get(_paZ.trackId) : -1
                bool _paTouched = _paPrevTc >= 0 and _paZ.touchCount > _paPrevTc
                if _paTouched
                    //  Touch 直前に予測していた Level
                    int _paProj = gProjPrev.contains(_paZ.trackId) ? gProjPrev.get(_paZ.trackId) : PROJ_NA
                    //  ---- (a) T1 の母集団比較 (EXACT 固定) ----
                    if _paPrevTc == 0
                        //  Strategy が事前に拾える側 (Touch 前の予測)
                        bool _projHit = _paProj != PROJ_NA and _paProj == edgeLevel
                        //  CSV / Logger 側 (Touch 後の実 Level)
                        bool _postHit = _paZ.zoneLevel == edgeLevel
                        if _projHit
                            gCsvProjT1 := gCsvProjT1 + 1
                        if _postHit
                            gCsvPostT1 := gCsvPostT1 + 1
                        if _projHit and _postHit
                            gCsvMatch := gCsvMatch + 1
                        else if _projHit or _postHit
                            gCsvMismatch := gCsvMismatch + 1
                    //  ---- (b) 予測 Level と実際の Level の検算 (全Touch対象) ----
                    if _paProj != PROJ_NA
                        if _paProj == _paZ.zoneLevel
                            gProjCorrect := gProjCorrect + 1
                        else
                            gProjMismatch := gProjMismatch + 1
    gWatchNow := _paWatch

// ---- 11.1 Audit テーブル (表示専用) ----------------------------------------
//  ★ 最初に見るのは PnL ではなく、この表の Mismatch = 0 ★
//    Logger Strong T1 (POST) … 元CSV の母集団の定義そのもの
//                              (Touch 後の実 Level == Edge Limit Level / T1)
//    CSV_MATCH T1 (PROJ)     … CSV_MATCH モードが Touch 前に拾える集合
//    Match                   … 両方に入った T1
//    Mismatch (set)          … 片方にしか入らなかった T1 ★ 目標 0 ★
var table gAuditTbl = na
if useParityAudit and barstate.islast
    if na(gAuditTbl)
        gAuditTbl := table.new(position.top_right, 2, 10, border_width = 1,
             frame_width = 1, frame_color = color.new(color.gray, 40))
    color _paHdr = color.new(color.black, 0)
    color _paOk  = color.new(color.green, 60)
    color _paNg  = color.new(color.red, 40)
    table.cell(gAuditTbl, 0, 0, "CSV PARITY AUDIT", text_color = color.white, bgcolor = _paHdr, text_size = size.small)
    table.cell(gAuditTbl, 1, 0, entryMode + " / " + edgeLevelStr + " EXACT / T1",
         text_color = color.white, bgcolor = _paHdr, text_size = size.small)
    //  ---- 母集団の比較 (ここが本題) ----
    table.cell(gAuditTbl, 0, 1, "Logger Strong T1 (POST)", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 1, str.tostring(gCsvPostT1), text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 0, 2, "CSV_MATCH T1 (PROJ)", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 2, str.tostring(gCsvProjT1), text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 0, 3, "Match", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 3, str.tostring(gCsvMatch), text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 0, 4, "Mismatch (set)", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 4, str.tostring(gCsvMismatch), text_color = color.white,
         bgcolor = gCsvMismatch > 0 ? _paNg : _paOk, text_size = size.small)
    //  ---- Level 一致の検算 (全Touch) ----
    table.cell(gAuditTbl, 0, 5, "Projected Mismatch", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 5, str.tostring(gProjMismatch) + " / " +
         str.tostring(gProjCorrect + gProjMismatch) + " checked", text_color = color.white,
         bgcolor = gProjMismatch > 0 ? _paNg : _paOk, text_size = size.small)
    //  ---- 参考 ----
    table.cell(gAuditTbl, 0, 6, "Logger Repro Events", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 6, useLoggerRepro ? str.tostring(gLogEvents) : "(Logger OFF)",
         text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 0, 7, "Watchlist now", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 7, str.tostring(gWatchNow), text_color = color.white, text_size = size.small)
    //  ---- TRADABLE (EDGE_LIMIT) のときだけ意味がある行 ----
    table.cell(gAuditTbl, 0, 8, "EDGE Fills / Closed", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 8, str.tostring(gAuditFills) + " / " + str.tostring(strategy.closedtrades),
         text_color = color.white, text_size = size.small)
    //  どの Library 関数から Projected Level を取っているか (二重実装していない証拠)
    table.cell(gAuditTbl, 0, 9, "Projected Source", text_color = color.white, text_size = size.small)
    table.cell(gAuditTbl, 1, 9, "zl.levelFrom(tc+1)",
         text_color = color.white, bgcolor = _paOk, text_size = size.small)

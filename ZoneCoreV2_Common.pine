//@version=6
//@description Zone definition v2 core. Root definition, Candidate formation, C, H, Density, BaseStrong, EffectiveZoneRange, ReferencePrice, FVG localization, Psychological participation, Candidate competition and Root eligibility. Contains NO engine state and NO bar-by-bar replay, so the Current Snapshot indicator and a future Strategy state engine can share exactly one definition of what a Zone is.
library("ZoneCoreV2_Common", overlay = true)

// ============================================================================
// ZoneCoreV2_Common
//
// WHAT THIS FILE IS
//   Given a set of Roots and a price window, it produces the Candidates that
//   Zone definition v2 says exist there. That is all.
//
// WHAT THIS FILE IS NOT
//   No Touch, Weak, Break, Flip, Reclaim, Generation, Merge, Split, Dormant or
//   PendingTopology. No historical replay. No bootstrap. No Strategy code.
//   Those belong to whichever state engine imports this library:
//     ZoneCurrentEngineV2      - current snapshot, no history replay
//     ZoneStrategyStateEngine  - future, replays its own backtest window
//
// The structural logic below is the reference implementation from
// ZoneEngineV2_Rebuild, carried over unchanged. It is not simplified for speed:
// a Current build runs once, not once per historical bar.
// ============================================================================
const string CORE_BUILD_ID = "ZONECORE-V2-20260920"
export coreBuildId() => CORE_BUILD_ID

// Categories
const int CAT_MA      = 1
const int CAT_SWING   = 2
const int CAT_ACCUM   = 3
const int CAT_TIME_HL = 4
const int CAT_FVG     = 5
const int CAT_PSYCH   = 6

// Sides
const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SIDE_NONE       = 0

// Phase
const int PH_WAITING      = 1
const int PH_ARMED        = 2
const int PH_ACTIVE_TOUCH = 3
const int PH_BROKEN       = 4
const int PH_FLIP_WAIT    = 5
const int PH_DORMANT      = 6

// Grade
const int GR_STRONG      = 1
const int GR_NEUTRAL     = 2
const int GR_WEAK        = 3
const int GR_UNAVAILABLE = 4

// Density
const int DEN_HIGH          = 1
const int DEN_NORMAL        = 2
const int DEN_BROAD_CONTEXT = 3

// Root state
const int ROOT_CANDIDATE      = 1
const int ROOT_ACTIVE         = 2
const int ROOT_INVALIDATED    = 3
const int ROOT_INVERSE_WAIT   = 4
const int ROOT_INVERSE_ACTIVE = 5
const int ROOT_RETIRED        = 6

// FVG direction
const int FVG_NONE    = 0
const int FVG_BULLISH = 1
const int FVG_BEARISH = -1

// Weak reason
const int WEAK_NONE     = 0
const int WEAK_BY_TOUCH = 1
const int WEAK_BY_DEPTH = 2
const int WEAK_BY_BOTH  = 3

// Event type
const int EV_TOUCH_START      = 1
const int EV_TOUCH_RESET      = 2
const int EV_WEAK_DEPTH       = 3
const int EV_LOCAL_BREAK      = 4
const int EV_GAP_BREAK        = 5
const int EV_FLIP_ATTEMPT     = 6
const int EV_FLIP_CONFIRM     = 7
const int EV_RECLAIM          = 8
const int EV_FVG_INVALIDATE   = 9
const int EV_INVERSE_ATTEMPT  = 10
const int EV_INVERSE_CONFIRM  = 11
const int EV_GENERATION_START = 12
const int EV_MERGE            = 13
const int EV_SPLIT            = 14
const int EV_STORAGE_PRUNE    = 15

// TF codes / masks
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_1D  = 1440
const int MASK_5M  = 1
const int MASK_15M = 2
const int MASK_1H  = 4

// Time label mask
const int TL_CUR_SESSION  = 1
const int TL_PREV_SESSION = 2
const int TL_CUR_DAY      = 4
const int TL_PREV_DAY     = 8
const int TL_CUR_WEEK     = 16
const int TL_PREV_WEEK    = 32

// Root subtype
const int SUB_MA_2000       = 1
const int SUB_MA_3000       = 2
const int SUB_SWING_HIGH    = 10
const int SUB_SWING_LOW     = 11
const int SUB_ACCUM_TOP     = 20
const int SUB_ACCUM_BOTTOM  = 21
const int SUB_TIME_HIGH     = 30
const int SUB_TIME_LOW      = 31
const int SUB_FVG           = 40
const int SUB_PSYCH_MAJOR   = 50
const int SUB_PSYCH_STD     = 51

// Reserved stable IDs. Event roots use positive sequence >= 100.
const int ROOT_ID_EMA2000 = 1
const int ROOT_ID_EMA3000 = 2
const int ROOT_ID_FIRST_DYNAMIC = 100

export type ZoneCfg

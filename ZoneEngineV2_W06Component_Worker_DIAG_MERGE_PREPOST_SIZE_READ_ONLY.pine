            while r < oldRowCount
                int lId = array.get(oldRowIds, r)
                if map.contains(affectedIds, lId)
                    array.push(candAffectedComponentIds, lId)
                    if not map.contains(finalIds, lId)
                        array.push(candRemovedComponentIds, lId)
                r += 1
        if failed
            int v = 0
            while v < array.size(candVisitedEpochByRootSlot)
                array.set(candVisitedEpochByRootSlot, v, 0)
                v += 1
            array.clear(candAffectedComponentIds)
            array.clear(candRemovedComponentIds)
            buildCode      := COMP_BUILD_FULL_FALLBACK
            outNextId      := nextComponentId
            outCacheValid  := false
            outCfgRevision := cfgRevision
            outEpoch       := 0
            outAffected    := 0
            outRemoved     := 0
        else
            buildCode      := COMP_BUILD_OK
            outNextId      := workNextId
            outCacheValid  := allComputed
            outCfgRevision := cfgRevision
            outEpoch       := workEpoch
            outAffected    := array.size(candAffectedComponentIds)
            outRemoved     := array.size(candRemovedComponentIds)

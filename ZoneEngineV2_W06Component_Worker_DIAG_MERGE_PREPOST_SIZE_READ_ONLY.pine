    int src = 0
    while ok and src < 2
        array<int> source = src == 0 ? rootPriceOrderSlots : rootIdOrderSlots
        array<int> target = src == 0 ? filteredPriceOrderSlots : filteredIdOrderSlots
        map<int, bool> taken = map.new<int, bool>()
        int n = array.size(source)
        int p = 0
        while ok and p < n
            int s = array.get(source, p)
            if s >= 0 and s < array.size(rootIds) and s < array.size(rootSlotLiveFlags)
                int sId = array.get(rootIds, s)
                if sId != ID_NONE and array.get(rootSlotLiveFlags, s)
                    int lo = 0
                    int hi = mLen - 1
                    int found = SLOT_INVALID
                    while found == SLOT_INVALID and lo <= hi

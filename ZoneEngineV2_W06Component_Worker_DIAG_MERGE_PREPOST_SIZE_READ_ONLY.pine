                        array.push(candRecordInts, array.get(candidateWinnerCreatedTimes, i))
                        array.push(candRecordInts, array.get(candidateWinnerMinRootIds, i))
                        array.push(candRecordInts, array.get(candidateWinnerFvgModes, i))
                        array.push(candRecordInts, array.get(candidateWinnerPsychLevelTicks, i))
                        array.push(candRecordInts, newRootOffset)
                        array.push(candRecordInts, rLen)

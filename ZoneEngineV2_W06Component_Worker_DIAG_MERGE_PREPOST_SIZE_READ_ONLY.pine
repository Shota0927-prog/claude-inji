//@version=6
// ZoneEngineV2_W06Component_Worker - W06 dependency component / Candidate cache subsystem, kept out of
// the Main library for the compiled token limit (PLAN A). Every enum value below mirrors the Production
// Main constant of the same name; nothing here changes a Main or W05 Candidate rule.
library("ZoneEngineV2_W06Component_Worker", overlay = false)
// W06 B17 DIAGNOSTIC VARIANT MERGE_PREPOST_SIZE_READ_ONLY: identical logic to /1 plus two unused size reads
// (before and after the record copy) in mergeSideRaw, placed as in /10. Not a production version; Main keeps /1.
import sekine3310/ZoneEngineV2_W05Candidate_Worker/3 as W05Cand

const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int ROOT_ACTIVE         = 1
const int ROOT_INVERSE_ACTIVE = 4
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int JGROUP_E1 = 1
const int JGROUP_E4 = 4
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_MA_UPDATE      = 3
const int JOP_SWING_TF_MERGE = 4
const int JOP_TIMEHL_LABEL   = 5
const int JOP_FVG_FRESH_END  = 6
const int JOP_ROOT_RETIRE    = 7
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
// W06 B04 seed reason bits (private, never exported)
const int CAND_SEED_REASON_ADDED     = 1
const int CAND_SEED_REASON_STATE     = 2
const int CAND_SEED_REASON_GEOMETRY  = 4
const int CAND_SEED_REASON_QUALITY   = 8
const int CAND_SEED_REASON_TIEBREAK  = 16
const int CAND_SEED_REASON_FVG       = 32
const int CAND_SEED_REASON_BROAD     = 64

// W06 B04: dependency Side mask of one Root slot (a superset of the Candidate eligibility: no use flag, no Fresh, no TF).
// 0 neither / 1 Support / 2 Resistance / 3 both.
//   Point (MA / Swing / Accum / TimeHL): live, rootId != 0, ACTIVE, pointTick not na -> 3
//   FVG: live, rootId != 0, Bullish / Bearish, ACTIVE / INVERSE_ACTIVE, native ticks not na and bottom <= top ->
//        Support for Bullish ACTIVE or Bearish INVERSE_ACTIVE, Resistance for Bearish ACTIVE or Bullish INVERSE_ACTIVE
compSideMaskRaw(int rootSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks) =>
    int  mask = 0
    bool ok   = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootDirections) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks)
    if ok
        ok := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) != ID_NONE
    if ok
        int category = array.get(rootCategories, rootSlot)
        int state    = array.get(rootStates, rootSlot)
        if category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL
            if state == ROOT_ACTIVE and not na(array.get(rootPointTicks, rootSlot))
                mask := 3
        else if category == CAT_FVG
            int direction  = array.get(rootDirections, rootSlot)
            int bottomTick = array.get(rootNativeBottomTicks, rootSlot)
            int topTick    = array.get(rootNativeTopTicks, rootSlot)
            bool capable = (direction == FVG_BULLISH or direction == FVG_BEARISH) and (state == ROOT_ACTIVE or state == ROOT_INVERSE_ACTIVE) and not na(bottomTick) and not na(topTick) and bottomTick <= topTick
            if capable
                if (direction == FVG_BULLISH and state == ROOT_ACTIVE) or (direction == FVG_BEARISH and state == ROOT_INVERSE_ACTIVE)
                    mask := 1
                else
                    mask := 2
    mask

// W06 B04: seed reasons of the committed Roots that the pending Stage F journal changes, read BEFORE the journal is
// applied. Rows are visited in the Stage F apply order (group E1 .. E4, row ascending). A row whose target does not
// resolve to a live committed Root with the expected rootId adds nothing (NEW_ROOT and same-bar targets: B05).
//   MA_UPDATE      : GEOMETRY (float pointPrice or pointTick differs), TIEBREAK (confirmedTime differs, na-aware),
//                    QUALITY (slope direction of its EMA subtype differs from the chained pre-apply slope, na-aware)
//   SWING_TF_MERGE : QUALITY          TIMEHL_LABEL : QUALITY          ROOT_RETIRE : STATE
//   FVG_INVALIDATE : STATE | FVG (| BROAD for a Broad FVG), and the FVG changed list
//   FVG_FRESH_END  : the Fresh changed list only (never a Candidate seed)
//   NEW_ROOT       : nothing here
// Every output list keeps first-appearance order; a rootId already present is never appended again (seed masks OR).
// Returns [seedCount, fvgChangedCount, freshCount].
export seedPreApply(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalSubtypes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<int> journalSlopeDirs, int journalCount, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootSubtypes, array<float> rootPointPrices, array<int> rootPointTicks, array<int> rootConfirmedTimes, array<bool> rootIsBroadFvgFlags, int ema2000SlopeDir, int ema3000SlopeDir, float mintick, array<int> candSeedRootIds, array<int> candSeedReasonMasks, array<int> candFvgChangedRootIds, array<int> candFvgFreshChangedRootIds, int seedCount, int fvgChangedCount, int freshCount) =>
    int seedLen  = seedCount
    int fvgLen   = fvgChangedCount
    int freshLen = freshCount
    int virtualSlope2000 = ema2000SlopeDir
    int virtualSlope3000 = ema3000SlopeDir
    int count = journalCount
    int group = JGROUP_E1
    while group <= JGROUP_E4
        int row = 0
        while row < count
            bool rowOk = row < array.size(journalOps) and row < array.size(journalGroups) and row < array.size(journalTargetRootSlots) and row < array.size(journalExpectedRootIds) and row < array.size(journalSubtypes) and row < array.size(journalConfirmedTimes) and row < array.size(journalPointPrices) and row < array.size(journalSlopeDirs)
            if rowOk
                rowOk := array.get(journalGroups, row) == group
            if rowOk
                int op             = array.get(journalOps, row)
                int rootSlot       = array.get(journalTargetRootSlots, row)
                int expectedRootId = array.get(journalExpectedRootIds, row)
                bool targetOk = rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootSubtypes) and rootSlot < array.size(rootPointPrices) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootConfirmedTimes) and rootSlot < array.size(rootIsBroadFvgFlags)
                if targetOk
                    targetOk := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId
                int seedMask   = 0
                bool fvgAdd    = false
                bool freshAdd  = false
                if op == JOP_MA_UPDATE
                    // the chained pre-apply slope advances on every MA_UPDATE row, as in the Stage F apply loop
                    int subtype   = array.get(journalSubtypes, row)
                    int newSlope  = array.get(journalSlopeDirs, row)
                    int prevSlope = subtype == SUB_MA_EMA2000 ? virtualSlope2000 : virtualSlope3000
                    if targetOk
                        float oldPrice  = array.get(rootPointPrices, rootSlot)
                        float newPrice  = array.get(journalPointPrices, row)
                        int   oldTick   = array.get(rootPointTicks, rootSlot)
                        int   newTick   = na(newPrice) or na(mintick) or mintick <= 0 ? int(na) : int(math.round(newPrice / mintick))
                        bool  priceDiff = na(oldPrice) != na(newPrice) or (not na(oldPrice) and not na(newPrice) and oldPrice != newPrice)
                        bool  tickDiff  = na(oldTick) != na(newTick) or (not na(oldTick) and not na(newTick) and oldTick != newTick)
                        if priceDiff or tickDiff
                            seedMask += CAND_SEED_REASON_GEOMETRY
                        int oldConfirmed = array.get(rootConfirmedTimes, rootSlot)
                        int newConfirmed = array.get(journalConfirmedTimes, row)
                        if na(oldConfirmed) != na(newConfirmed) or (not na(oldConfirmed) and not na(newConfirmed) and oldConfirmed != newConfirmed)
                            seedMask += CAND_SEED_REASON_TIEBREAK
                        if (subtype == SUB_MA_EMA2000 or subtype == SUB_MA_EMA3000) and array.get(rootSubtypes, rootSlot) == subtype
                            if na(prevSlope) != na(newSlope) or (not na(prevSlope) and not na(newSlope) and prevSlope != newSlope)
                                seedMask += CAND_SEED_REASON_QUALITY
                    if subtype == SUB_MA_EMA2000
                        virtualSlope2000 := newSlope
                    else if subtype == SUB_MA_EMA3000
                        virtualSlope3000 := newSlope
                else if op == JOP_SWING_TF_MERGE
                    if targetOk
                        seedMask := CAND_SEED_REASON_QUALITY
                else if op == JOP_TIMEHL_LABEL
                    if targetOk
                        seedMask := CAND_SEED_REASON_QUALITY
                else if op == JOP_FVG_INVALIDATE
                    if targetOk
                        seedMask := CAND_SEED_REASON_STATE + CAND_SEED_REASON_FVG + (array.get(rootIsBroadFvgFlags, rootSlot) ? CAND_SEED_REASON_BROAD : 0)
                        fvgAdd   := true
                else if op == JOP_ROOT_RETIRE
                    if targetOk
                        seedMask := CAND_SEED_REASON_STATE
                else if op == JOP_FVG_FRESH_END
                    if targetOk
                        freshAdd := true
                else if op == JOP_NEW_ROOT
                    seedMask := 0
                if seedMask != 0
                    int pos = SLOT_INVALID
                    int i   = 0
                    while pos == SLOT_INVALID and i < seedLen
                        if array.get(candSeedRootIds, i) == expectedRootId
                            pos := i
                        i += 1
                    if pos != SLOT_INVALID
                        int oldMask = array.get(candSeedReasonMasks, pos)
                        int merged  = 0
                        int bit     = 1
                        while bit <= CAND_SEED_REASON_BROAD
                            if oldMask % (2 * bit) >= bit or seedMask % (2 * bit) >= bit
                                merged += bit
                            bit := bit * 2
                        array.set(candSeedReasonMasks, pos, merged)
                    else
                        if seedLen < array.size(candSeedRootIds)
                            array.set(candSeedRootIds, seedLen, expectedRootId)
                        else
                            array.push(candSeedRootIds, expectedRootId)
                        if seedLen < array.size(candSeedReasonMasks)
                            array.set(candSeedReasonMasks, seedLen, seedMask)
                        else
                            array.push(candSeedReasonMasks, seedMask)
                        seedLen += 1
                if fvgAdd
                    bool found = false
                    int  i     = 0
                    while not found and i < fvgLen
                        found := array.get(candFvgChangedRootIds, i) == expectedRootId
                        i += 1
                    if not found
                        if fvgLen < array.size(candFvgChangedRootIds)
                            array.set(candFvgChangedRootIds, fvgLen, expectedRootId)
                        else
                            array.push(candFvgChangedRootIds, expectedRootId)
                        fvgLen += 1
                if freshAdd
                    bool found = false
                    int  i     = 0
                    while not found and i < freshLen
                        found := array.get(candFvgFreshChangedRootIds, i) == expectedRootId
                        i += 1
                    if not found
                        if freshLen < array.size(candFvgFreshChangedRootIds)
                            array.set(candFvgFreshChangedRootIds, freshLen, expectedRootId)
                        else
                            array.push(candFvgFreshChangedRootIds, expectedRootId)
                        freshLen += 1
            row += 1
        group += 1
    [seedLen, fvgLen, freshLen]

// W06 B05: seed completion AFTER a successful Stage F apply (the journal is fully in the Root SoA).
//   A. the six W06 Root arrays grow to array.size(rootIds) with 0 (never shrink, never reset)
//   B. rootCandComponentExpectedRootIds[slot] := rootId for every live slot still holding 0
//   C. NEW_ROOT rows (group E1 .. E4, row ascending) resolving to a live Root with the journal rootId are seeded:
//      ADDED, | FVG for an FVG Root, | BROAD for a Broad FVG Root; an FVG Root also enters the FVG changed list
//   D. FVG_FRESH_END rows resolving the same way enter the Fresh changed list (path A already there is skipped)
//   E. every seeded Root (resolved by rootIdToSlot, live, same rootId, same expected rootId) gets its revisions:
//      ADDED -> geometry, quality, tieBreak, state +1 each; otherwise GEOMETRY / QUALITY / TIEBREAK / STATE +1 each
//      when set (FVG and BROAD never increment a revision). Lists keep first-appearance order, no duplicate rootId.
// Returns [seedCount, fvgChangedCount, freshCount].
export seedPostApply(array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, int journalCount, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<bool> rootIsBroadFvgFlags, map<int, int> rootIdToSlot, array<int> rootCandGeometryRevisions, array<int> rootCandQualityRevisions, array<int> rootCandTieBreakRevisions, array<int> rootCandStateRevisions, array<int> rootCandComponentIds, array<int> rootCandComponentExpectedRootIds, array<int> candSeedRootIds, array<int> candSeedReasonMasks, array<int> candFvgChangedRootIds, array<int> candFvgFreshChangedRootIds, int seedCount, int fvgChangedCount, int freshCount) =>
    int seedLen  = seedCount
    int fvgLen   = fvgChangedCount
    int freshLen = freshCount
    int slotCount = array.size(rootIds)
    // A. grow the W06 Root arrays to the post-apply slot count
    while array.size(rootCandGeometryRevisions) < slotCount
        array.push(rootCandGeometryRevisions, 0)
    while array.size(rootCandQualityRevisions) < slotCount
        array.push(rootCandQualityRevisions, 0)
    while array.size(rootCandTieBreakRevisions) < slotCount
        array.push(rootCandTieBreakRevisions, 0)
    while array.size(rootCandStateRevisions) < slotCount
        array.push(rootCandStateRevisions, 0)
    while array.size(rootCandComponentIds) < slotCount
        array.push(rootCandComponentIds, 0)
    while array.size(rootCandComponentExpectedRootIds) < slotCount
        array.push(rootCandComponentExpectedRootIds, 0)
    // B. expected rootId of every live slot not yet bound
    int s = 0
    while s < slotCount
        if s < array.size(rootSlotLiveFlags)
            int id = array.get(rootIds, s)
            if array.get(rootSlotLiveFlags, s) and id != ID_NONE and array.get(rootCandComponentExpectedRootIds, s) == 0
                array.set(rootCandComponentExpectedRootIds, s, id)
        s += 1
    // C + D. NEW_ROOT seeds and FVG_FRESH_END Fresh entries, Stage F apply order
    int group = JGROUP_E1
    while group <= JGROUP_E4
        int row = 0
        while row < journalCount
            bool rowOk = row < array.size(journalOps) and row < array.size(journalGroups) and row < array.size(journalTargetRootSlots) and row < array.size(journalExpectedRootIds)
            if rowOk
                rowOk := array.get(journalGroups, row) == group
            if rowOk
                int op             = array.get(journalOps, row)
                int rootSlot       = array.get(journalTargetRootSlots, row)
                int expectedRootId = array.get(journalExpectedRootIds, row)
                bool targetOk = (op == JOP_NEW_ROOT or op == JOP_FVG_FRESH_END) and rootSlot != SLOT_INVALID and expectedRootId != ID_NONE and rootSlot >= 0 and rootSlot < slotCount and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootIsBroadFvgFlags)
                if targetOk
                    targetOk := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId
                if targetOk and op == JOP_NEW_ROOT
                    bool isFvg    = array.get(rootCategories, rootSlot) == CAT_FVG
                    int  seedMask = CAND_SEED_REASON_ADDED + (isFvg ? CAND_SEED_REASON_FVG : 0) + (isFvg and array.get(rootIsBroadFvgFlags, rootSlot) ? CAND_SEED_REASON_BROAD : 0)
                    int pos = SLOT_INVALID
                    int i   = 0
                    while pos == SLOT_INVALID and i < seedLen
                        if array.get(candSeedRootIds, i) == expectedRootId
                            pos := i
                        i += 1
                    if pos != SLOT_INVALID
                        int oldMask = array.get(candSeedReasonMasks, pos)
                        int merged  = 0
                        int bit     = 1
                        while bit <= CAND_SEED_REASON_BROAD
                            if oldMask % (2 * bit) >= bit or seedMask % (2 * bit) >= bit
                                merged += bit
                            bit := bit * 2
                        array.set(candSeedReasonMasks, pos, merged)
                    else
                        if seedLen < array.size(candSeedRootIds)
                            array.set(candSeedRootIds, seedLen, expectedRootId)
                        else
                            array.push(candSeedRootIds, expectedRootId)
                        if seedLen < array.size(candSeedReasonMasks)
                            array.set(candSeedReasonMasks, seedLen, seedMask)
                        else
                            array.push(candSeedReasonMasks, seedMask)
                        seedLen += 1
                    if isFvg
                        bool found = false
                        int  k     = 0
                        while not found and k < fvgLen
                            found := array.get(candFvgChangedRootIds, k) == expectedRootId
                            k += 1
                        if not found
                            if fvgLen < array.size(candFvgChangedRootIds)
                                array.set(candFvgChangedRootIds, fvgLen, expectedRootId)
                            else
                                array.push(candFvgChangedRootIds, expectedRootId)
                            fvgLen += 1
                if targetOk and op == JOP_FVG_FRESH_END
                    bool found = false
                    int  k     = 0
                    while not found and k < freshLen
                        found := array.get(candFvgFreshChangedRootIds, k) == expectedRootId
                        k += 1
                    if not found
                        if freshLen < array.size(candFvgFreshChangedRootIds)
                            array.set(candFvgFreshChangedRootIds, freshLen, expectedRootId)
                        else
                            array.push(candFvgFreshChangedRootIds, expectedRootId)
                        freshLen += 1
            row += 1
        group += 1
    // E. Root revisions of every seeded Root, at most +1 per revision per bar
    int q = 0
    while q < seedLen
        int id   = array.get(candSeedRootIds, q)
        int mask = array.get(candSeedReasonMasks, q)
        int slot = SLOT_INVALID
        if map.contains(rootIdToSlot, id)
            slot := map.get(rootIdToSlot, id)
        bool slotOk = slot != SLOT_INVALID and slot >= 0 and slot < slotCount and slot < array.size(rootSlotLiveFlags)
        if slotOk
            slotOk := array.get(rootSlotLiveFlags, slot) and id != ID_NONE and array.get(rootIds, slot) == id and array.get(rootCandComponentExpectedRootIds, slot) == id
        if slotOk
            bool added = mask % (2 * CAND_SEED_REASON_ADDED) >= CAND_SEED_REASON_ADDED
            if added or mask % (2 * CAND_SEED_REASON_GEOMETRY) >= CAND_SEED_REASON_GEOMETRY
                array.set(rootCandGeometryRevisions, slot, array.get(rootCandGeometryRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_QUALITY) >= CAND_SEED_REASON_QUALITY
                array.set(rootCandQualityRevisions, slot, array.get(rootCandQualityRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_TIEBREAK) >= CAND_SEED_REASON_TIEBREAK
                array.set(rootCandTieBreakRevisions, slot, array.get(rootCandTieBreakRevisions, slot) + 1)
            if added or mask % (2 * CAND_SEED_REASON_STATE) >= CAND_SEED_REASON_STATE
                array.set(rootCandStateRevisions, slot, array.get(rootCandStateRevisions, slot) + 1)
        q += 1
    [seedLen, fvgLen, freshLen]

// W06 B06: capable Point Roots (PC: MA / Swing / Accum / TimeHL with compSideMaskRaw == 3) whose pointTick lies in
// [loTick, hiTick] join the current dependency closure. rootPriceOrderSlots is the canonical ascending pointTick order,
// so the walk stops at the first tick above hiTick. No count cap, no Side / TF / Fresh filter.
// A slot not yet visited in visitEpoch is marked and appended to candQueueRootSlots (append only). A slot at or past
// array.size(candVisitedEpochByRootSlot) is skipped (the caller sizes it; nothing is pushed here). Returns addedCount.
compPointRangeScanRaw(int loTick, int hiTick, int visitEpoch, array<int> rootPriceOrderSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> candVisitedEpochByRootSlot, array<int> candQueueRootSlots) =>
    int addedCount = 0
    if not na(loTick) and not na(hiTick) and loTick <= hiTick
        int  orderSize = array.size(rootPriceOrderSlots)
        bool done      = false
        int  p         = 0
        while not done and p < orderSize
            int slot = array.get(rootPriceOrderSlots, p)
            if slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootPointTicks)
                int tick = array.get(rootPointTicks, slot)
                if not na(tick)
                    if tick > hiTick
                        done := true
                    else if tick >= loTick
                        if compSideMaskRaw(slot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks) == 3
                            int category = array.get(rootCategories, slot)
                            if (category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL) and slot < array.size(candVisitedEpochByRootSlot)
                                if array.get(candVisitedEpochByRootSlot, slot) != visitEpoch
                                    array.set(candVisitedEpochByRootSlot, slot, visitEpoch)
                                    array.push(candQueueRootSlots, slot)
                                    addedCount += 1
            p += 1
    addedCount

// W06 B06: non-Broad FVG dependencies of one visited MEMBER Root (D = max(denseTick, 0), int ticks, no clamp).
//   current PC t        : every capable non-Broad FVG g of categoryFvgRootSlots with nb_g - D <= t and t <= nt_g + D
//   current non-Broad F : PCs in [nb_F - D, nt_F + D] (compPointRangeScanRaw, exactly once), then every capable non-Broad
//                         FVG g of categoryFvgRootSlots with dir_g == dir_F and max(nb_F, nb_g) <= min(nt_F, nt_g)
//   anything else (Broad FVG, incapable, invalid slot) : nothing
// Capability is compSideMaskRaw != 0 only; the mask value never narrows a link (no Side / TF / Fresh filter, no cap).
// Unvisited linked slots are marked with visitEpoch and appended to candQueueRootSlots. Returns addedCount (both scans).
compFvgLinkRaw(int currentSlot, int denseTick, int visitEpoch, array<int> rootPriceOrderSlots, array<int> categoryFvgRootSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> candVisitedEpochByRootSlot, array<int> candQueueRootSlots) =>
    int addedCount  = 0
    int D           = math.max(denseTick, 0)
    int currentMask = compSideMaskRaw(currentSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
    bool currentIsPc = false
    bool currentIsFc = false
    if currentMask != 0
        int currentCategory = array.get(rootCategories, currentSlot)
        currentIsPc := currentMask == 3 and (currentCategory == CAT_MA or currentCategory == CAT_SWING or currentCategory == CAT_ACCUM or currentCategory == CAT_TIME_HL)
        currentIsFc := currentCategory == CAT_FVG and currentSlot < array.size(rootIsBroadFvgFlags)
        if currentIsFc
            currentIsFc := not array.get(rootIsBroadFvgFlags, currentSlot)
    int fvgCount = array.size(categoryFvgRootSlots)
    if currentIsPc
        int t = array.get(rootPointTicks, currentSlot)
        int k = 0
        while k < fvgCount
            int g = array.get(categoryFvgRootSlots, k)
            if compSideMaskRaw(g, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks) != 0 and g < array.size(rootIsBroadFvgFlags) and g < array.size(candVisitedEpochByRootSlot)
                if array.get(rootCategories, g) == CAT_FVG and not array.get(rootIsBroadFvgFlags, g)
                    int nb = array.get(rootNativeBottomTicks, g)
                    int nt = array.get(rootNativeTopTicks, g)
                    if nb - D <= t and t <= nt + D
                        if array.get(candVisitedEpochByRootSlot, g) != visitEpoch
                            array.set(candVisitedEpochByRootSlot, g, visitEpoch)
                            array.push(candQueueRootSlots, g)
                            addedCount += 1
            k += 1
    else if currentIsFc
        int nbF  = array.get(rootNativeBottomTicks, currentSlot)
        int ntF  = array.get(rootNativeTopTicks, currentSlot)
        int dirF = array.get(rootDirections, currentSlot)
        addedCount += compPointRangeScanRaw(nbF - D, ntF + D, visitEpoch, rootPriceOrderSlots, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, candVisitedEpochByRootSlot, candQueueRootSlots)
        int k = 0
        while k < fvgCount
            int g = array.get(categoryFvgRootSlots, k)
            if compSideMaskRaw(g, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks) != 0 and g < array.size(rootIsBroadFvgFlags) and g < array.size(candVisitedEpochByRootSlot)
                if array.get(rootCategories, g) == CAT_FVG and not array.get(rootIsBroadFvgFlags, g) and array.get(rootDirections, g) == dirF
                    int nbG = array.get(rootNativeBottomTicks, g)
                    int ntG = array.get(rootNativeTopTicks, g)
                    if math.max(nbF, nbG) <= math.min(ntF, ntG)
                        if array.get(candVisitedEpochByRootSlot, g) != visitEpoch
                            array.set(candVisitedEpochByRootSlot, g, visitEpoch)
                            array.push(candQueueRootSlots, g)
                            addedCount += 1
            k += 1
    addedCount

// W06 B06: INCLUDED_BROAD test of one Broad FVG b against the LOCAL component componentRootSlots[0 .. componentRootCount).
// b must be a capable (compSideMaskRaw != 0) Broad FVG; then true on the first member x with
//   x capable PC          : nb_b - D <= t_x and t_x <= nt_b + D                        (D = max(denseTick, 0))
//   x capable non-Broad F : dir_x == dir_b and max(nb_x, nb_b) <= min(nt_x, nt_b)
// Broad members never link (Broad x Broad is the BROAD_ONLY domain). No Side / TF / Fresh filter, no count cap.
compBroadIncludedRaw(int broadSlot, array<int> componentRootSlots, int componentRootCount, int denseTick, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags) =>
    bool included = false
    int  D        = math.max(denseTick, 0)
    bool broadOk  = compSideMaskRaw(broadSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks) != 0 and broadSlot < array.size(rootIsBroadFvgFlags)
    if broadOk
        broadOk := array.get(rootCategories, broadSlot) == CAT_FVG and array.get(rootIsBroadFvgFlags, broadSlot)
    if broadOk
        int nbB  = array.get(rootNativeBottomTicks, broadSlot)
        int ntB  = array.get(rootNativeTopTicks, broadSlot)
        int dirB = array.get(rootDirections, broadSlot)
        int i = 0
        while not included and i < componentRootCount
            if i < array.size(componentRootSlots)
                int x     = array.get(componentRootSlots, i)
                int xMask = compSideMaskRaw(x, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
                if xMask != 0
                    int xCategory = array.get(rootCategories, x)
                    if xMask == 3 and (xCategory == CAT_MA or xCategory == CAT_SWING or xCategory == CAT_ACCUM or xCategory == CAT_TIME_HL)
                        int tx = array.get(rootPointTicks, x)
                        if nbB - D <= tx and tx <= ntB + D
                            included := true
                    else if xCategory == CAT_FVG and x < array.size(rootIsBroadFvgFlags)
                        if not array.get(rootIsBroadFvgFlags, x) and array.get(rootDirections, x) == dirB
                            int nbX = array.get(rootNativeBottomTicks, x)
                            int ntX = array.get(rootNativeTopTicks, x)
                            if math.max(nbX, nbB) <= math.min(ntX, ntB)
                                included := true
            i += 1
    included

// W06 B07 Accum subtypes (mirror of the Production Main constants of the same name)
const int SUB_ACCUM_UPPER  = 1
const int SUB_ACCUM_LOWER  = 2

// W06 B07: dependency links of one visited normal Root (capable PC, or capable non-Broad FVG) other than the B06 price /
// FVG links, read from the existing indexes only (read-only; nothing is created, repaired or rewritten):
//   L4 Accum pair  : an Accum upper / lower Root with pairKey != 0 -> the mate slot of the opposite existing pair map
//   L5 same origin : originKey != 0 -> every Root of the existing originKey bucket chain (head map, next, expected rootId)
//   L6 participation : every valid edge of the Root's existing participation chain -> its live Core c
//   L7 Core range  : current capable PC t, every live Core c of coreLiveSlots whose float physical range, converted by the
//                    canonical int(math.round(price / mintick)), has bottomTick <= topTick and
//                    math.max(0, bottomTick - t, t - topTick) <= mTick
//   L8 PendingTopology : every live PendingTopology Root node holding the current rootId -> its owner Core c
// Every Core c reached above is expanded: the whole participation edge pool is scanned for the live edges of c (full scan:
// no exact reverse index exists, sideCurrentRoot* is not one), and the existing 2-level PendingTopology list of c
// (child chain -> Root node chain) is followed to its end, and (B09 L7 symmetry) every capable PC whose pointTick lies in
// [coreBottomTick - mTick, coreTopTick + mTick] of c's canonical tick range (int(math.round(price / mintick)), bottom and
// top not na, bottomTick <= topTick; otherwise only this range link is skipped) is added by compPointRangeScanRaw, so the
// PC <-> Core range dependency holds from either end whatever route (L6 / L7 / L8) reached c. Linked chains (L5 origin bucket, L6 participation, L8 child and
// Root node chains) follow the existing contracts: every node valid, the chain ends at SLOT_INVALID exactly at its
// authoritative count (L5: within the Root slot count). An invalid / stale node or a count / terminator mismatch inside a
// chain is corruption (originLookupUniqueRaw violation, participationRootChainValidRaw invalid; PendingTopology has no
// write path, so no weaker contract exists): failed = true, never a silently truncated tail. Pool scans (edge pool, Root
// node pool, coreLiveSlots) skip an invalid row. A PendingTopology Root copy whose rootId no longer resolves to a live
// Root is a stale copy, not chain corruption: that Root is not added and the chain continues.
// Only a current normal Root not yet visited in visitEpoch is marked and appended (Broad FVG never). No Side / TF / Fresh
// filter, no count cap. Returns [addedCount, failed].
compExternalLinksRaw(int currentSlot, int mTick, int visitEpoch, float mintick, array<int> rootPriceOrderSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> rootSubtypes, array<int> rootPairKeys, array<int> rootOriginKeys, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> participationEdgeRootSlots, array<int> participationEdgeExpectedRootIds, array<int> participationEdgeSideSlots, array<int> participationEdgeExpectedCoreIds, array<int> participationEdgeNextByRootIndexes, array<bool> participationEdgeLiveFlags, array<int> sidePhases, array<int> coreIds, array<int> coreGenerationIds, array<bool> coreSlotLiveFlags, array<int> coreLiveSlots, array<float> corePhysicalBottoms, array<float> corePhysicalTops, array<int> corePendingTopologyChildHeadIndexes, array<int> corePendingTopologyChildCounts, array<int> pendingTopologyChildNextIndexes, array<int> pendingTopologyChildOwnerCoreSlots, array<int> pendingTopologyChildExpectedCoreIds, array<int> pendingTopologyChildExpectedGenerationIds, array<int> pendingTopologyChildRootHeadNodeIndexes, array<int> pendingTopologyChildRootCounts, array<bool> pendingTopologyChildLiveFlags, array<int> pendingTopologyRootNodeRootIds, array<int> pendingTopologyRootNodeNextIndexes, array<int> pendingTopologyRootNodeOwnerChildIndexes, array<int> pendingTopologyRootNodeExpectedCoreIds, array<int> pendingTopologyRootNodeExpectedGenerationIds, array<bool> pendingTopologyRootNodeLiveFlags, array<int> candVisitedEpochByRootSlot, array<int> candQueueRootSlots) =>
    int  addedCount  = 0
    bool failed      = false
    int currentMask = compSideMaskRaw(currentSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
    bool currentIsPc = false
    bool currentIsFc = false
    int  currentCategory = int(na)
    if currentMask != 0
        currentCategory := array.get(rootCategories, currentSlot)
        currentIsPc := currentMask == 3 and (currentCategory == CAT_MA or currentCategory == CAT_SWING or currentCategory == CAT_ACCUM or currentCategory == CAT_TIME_HL)
        if currentCategory == CAT_FVG and currentSlot < array.size(rootIsBroadFvgFlags)
            currentIsFc := not array.get(rootIsBroadFvgFlags, currentSlot)
    if currentIsPc or currentIsFc
        int currentRootId = array.get(rootIds, currentSlot)
        int rootCount     = array.size(rootIds)
        // ---- L4 Accum pair ----
        if currentCategory == CAT_ACCUM and currentSlot < array.size(rootSubtypes) and currentSlot < array.size(rootPairKeys)
            int pairKey = array.get(rootPairKeys, currentSlot)
            int subtype = array.get(rootSubtypes, currentSlot)
            if pairKey != ID_NONE and (subtype == SUB_ACCUM_UPPER or subtype == SUB_ACCUM_LOWER)
                map<int, int> mateMap = subtype == SUB_ACCUM_UPPER ? accumPairLowerRootSlotByKey : accumPairUpperRootSlotByKey
                if map.contains(mateMap, pairKey)
                    int mateSlot = map.get(mateMap, pairKey)
                    if mateSlot >= 0 and mateSlot != currentSlot and mateSlot < rootCount and mateSlot < array.size(rootPairKeys) and mateSlot < array.size(candVisitedEpochByRootSlot)
                        if array.get(rootPairKeys, mateSlot) == pairKey
                            int  aMask   = compSideMaskRaw(mateSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
                            bool aNormal = false
                            if aMask != 0
                                int aCategory = array.get(rootCategories, mateSlot)
                                if aMask == 3
                                    aNormal := aCategory == CAT_MA or aCategory == CAT_SWING or aCategory == CAT_ACCUM or aCategory == CAT_TIME_HL
                                else if aCategory == CAT_FVG and mateSlot < array.size(rootIsBroadFvgFlags)
                                    aNormal := not array.get(rootIsBroadFvgFlags, mateSlot)
                            if aNormal
                                if array.get(candVisitedEpochByRootSlot, mateSlot) != visitEpoch
                                    array.set(candVisitedEpochByRootSlot, mateSlot, visitEpoch)
                                    array.push(candQueueRootSlots, mateSlot)
                                    addedCount += 1
        // ---- L5 same origin (existing bucket chain, existing step contract = Root slot count) ----
        if currentSlot < array.size(rootOriginKeys)
            int originKey = array.get(rootOriginKeys, currentSlot)
            if originKey != ID_NONE and map.contains(originKeyBucketHeadRootSlots, originKey)
                int  oSlot   = map.get(originKeyBucketHeadRootSlots, originKey)
                int  oSteps  = 0
                bool oChain  = true
                while oChain and oSlot != SLOT_INVALID and oSteps < rootCount
                    bool oNodeOk = oSlot >= 0 and oSlot < rootCount and oSlot < array.size(rootSlotLiveFlags) and oSlot < array.size(rootOriginKeys) and oSlot < array.size(rootOriginBucketNextRootSlots) and oSlot < array.size(rootOriginBucketExpectedRootIds)
                    if oNodeOk
                        oNodeOk := array.get(rootSlotLiveFlags, oSlot)
                    if oNodeOk
                        int bucketRootId = array.get(rootOriginBucketExpectedRootIds, oSlot)
                        oNodeOk := bucketRootId != ID_NONE and bucketRootId == array.get(rootIds, oSlot) and array.get(rootOriginKeys, oSlot) == originKey
                    if not oNodeOk
                        oChain := false
                        failed := true
                    else
                        if oSlot < array.size(candVisitedEpochByRootSlot)
                            int  oMask   = compSideMaskRaw(oSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
                            bool oNormal = false
                            if oMask != 0
                                int oCategory = array.get(rootCategories, oSlot)
                                if oMask == 3
                                    oNormal := oCategory == CAT_MA or oCategory == CAT_SWING or oCategory == CAT_ACCUM or oCategory == CAT_TIME_HL
                                else if oCategory == CAT_FVG and oSlot < array.size(rootIsBroadFvgFlags)
                                    oNormal := not array.get(rootIsBroadFvgFlags, oSlot)
                            if oNormal
                                if array.get(candVisitedEpochByRootSlot, oSlot) != visitEpoch
                                    array.set(candVisitedEpochByRootSlot, oSlot, visitEpoch)
                                    array.push(candQueueRootSlots, oSlot)
                                    addedCount += 1
                        oSlot  := array.get(rootOriginBucketNextRootSlots, oSlot)
                        oSteps += 1
                if oChain and oSlot != SLOT_INVALID
                    failed := true
        // ---- Core sources: 0 = L6 participation chain, 1 = L7 live Core range, 2 = L8 PendingTopology Root node pool ----
        int  edgeRowCount = array.size(participationEdgeRootSlots)
        int  nodeRowCount = array.size(pendingTopologyRootNodeRootIds)
        int  childRowCount = array.size(pendingTopologyChildLiveFlags)
        int  edgeCursor   = SLOT_INVALID
        int  edgeCount    = 0
        if currentSlot < array.size(rootParticipationHeadEdgeIndexes) and currentSlot < array.size(rootParticipationCounts)
            edgeCursor := array.get(rootParticipationHeadEdgeIndexes, currentSlot)
            edgeCount  := array.get(rootParticipationCounts, currentSlot)
            if edgeCount < 0 or edgeCount > edgeRowCount
                failed := true
        else
            failed := true
        int edgeSeen = 0
        int liveIdx  = 0
        int nodeIdx  = 0
        int src      = 0
        while src <= 2 and not failed
            int c = SLOT_INVALID
            if src == 0
                if edgeCursor != SLOT_INVALID and edgeSeen < edgeCount
                    bool eOk = edgeCursor >= 0 and edgeCursor < edgeRowCount and edgeCursor < array.size(participationEdgeExpectedRootIds) and edgeCursor < array.size(participationEdgeSideSlots) and edgeCursor < array.size(participationEdgeExpectedCoreIds) and edgeCursor < array.size(participationEdgeNextByRootIndexes) and edgeCursor < array.size(participationEdgeLiveFlags)
                    if eOk
                        eOk := array.get(participationEdgeLiveFlags, edgeCursor)
                    if eOk
                        eOk := array.get(participationEdgeRootSlots, edgeCursor) == currentSlot and array.get(participationEdgeExpectedRootIds, edgeCursor) == currentRootId
                    int eSideSlot = SLOT_INVALID
                    int eCoreSlot = SLOT_INVALID
                    if eOk
                        eSideSlot := array.get(participationEdgeSideSlots, edgeCursor)
                        eOk := eSideSlot >= 0 and eSideSlot < array.size(sidePhases)
                    if eOk
                        eCoreSlot := int(math.floor(eSideSlot / 2))
                        int eSideIndex = eSideSlot - eCoreSlot * 2
                        eOk := (eSideIndex == 0 or eSideIndex == 1) and eCoreSlot >= 0 and eCoreSlot < array.size(coreIds) and eCoreSlot < array.size(coreSlotLiveFlags)
                    if eOk
                        eOk := array.get(coreSlotLiveFlags, eCoreSlot)
                    if eOk
                        int eExpectedCoreId = array.get(participationEdgeExpectedCoreIds, edgeCursor)
                        eOk := eExpectedCoreId != ID_NONE and array.get(coreIds, eCoreSlot) == eExpectedCoreId
                    if eOk
                        c          := eCoreSlot
                        edgeCursor := array.get(participationEdgeNextByRootIndexes, edgeCursor)
                        edgeSeen   += 1
                    else
                        failed := true
                else
                    if edgeCursor != SLOT_INVALID or edgeSeen != edgeCount
                        failed := true
                    src := 1
            else if src == 1
                if currentIsPc and liveIdx < array.size(coreLiveSlots)
                    int lCore = array.get(coreLiveSlots, liveIdx)
                    liveIdx += 1
                    bool lOk = lCore >= 0 and lCore < array.size(coreIds) and lCore < array.size(coreSlotLiveFlags) and lCore < array.size(corePhysicalBottoms) and lCore < array.size(corePhysicalTops)
                    if lOk
                        lOk := array.get(coreSlotLiveFlags, lCore) and array.get(coreIds, lCore) != ID_NONE
                    if lOk
                        float coreBottom = array.get(corePhysicalBottoms, lCore)
                        float coreTop    = array.get(corePhysicalTops, lCore)
                        if not na(coreBottom) and not na(coreTop)
                            int coreBottomTick = int(math.round(coreBottom / mintick))
                            int coreTopTick    = int(math.round(coreTop / mintick))
                            if coreBottomTick <= coreTopTick
                                int t        = array.get(rootPointTicks, currentSlot)
                                int distance = math.max(0, coreBottomTick - t, t - coreTopTick)
                                if distance <= mTick
                                    c := lCore
                else
                    src := 2
            else
                if nodeIdx < nodeRowCount
                    int nRow = nodeIdx
                    nodeIdx += 1
                    bool nOk = nRow < array.size(pendingTopologyRootNodeLiveFlags) and nRow < array.size(pendingTopologyRootNodeOwnerChildIndexes) and nRow < array.size(pendingTopologyRootNodeExpectedCoreIds) and nRow < array.size(pendingTopologyRootNodeExpectedGenerationIds)
                    if nOk
                        nOk := array.get(pendingTopologyRootNodeLiveFlags, nRow) and array.get(pendingTopologyRootNodeRootIds, nRow) == currentRootId
                    int nChild = SLOT_INVALID
                    int nCore  = SLOT_INVALID
                    if nOk
                        nChild := array.get(pendingTopologyRootNodeOwnerChildIndexes, nRow)
                        nOk := nChild >= 0 and nChild < childRowCount and nChild < array.size(pendingTopologyChildOwnerCoreSlots) and nChild < array.size(pendingTopologyChildExpectedCoreIds) and nChild < array.size(pendingTopologyChildExpectedGenerationIds)
                    if nOk
                        nOk := array.get(pendingTopologyChildLiveFlags, nChild)
                    if nOk
                        nCore := array.get(pendingTopologyChildOwnerCoreSlots, nChild)
                        nOk := nCore >= 0 and nCore < array.size(coreIds) and nCore < array.size(coreGenerationIds) and nCore < array.size(coreSlotLiveFlags)
                    if nOk
                        int nCoreId = array.get(coreIds, nCore)
                        int nGenId  = array.get(coreGenerationIds, nCore)
                        nOk := array.get(coreSlotLiveFlags, nCore) and nCoreId != ID_NONE and array.get(pendingTopologyChildExpectedCoreIds, nChild) == nCoreId and array.get(pendingTopologyRootNodeExpectedCoreIds, nRow) == nCoreId and array.get(pendingTopologyChildExpectedGenerationIds, nChild) == nGenId and array.get(pendingTopologyRootNodeExpectedGenerationIds, nRow) == nGenId
                    if nOk
                        c := nCore
                else
                    src := 3
            // ---- expand Core c: participating Roots (full edge pool scan) and PendingTopology Roots ----
            if c != SLOT_INVALID and not failed and not (c < array.size(coreGenerationIds) and c < array.size(corePendingTopologyChildHeadIndexes) and c < array.size(corePendingTopologyChildCounts))
                failed := true
            if c != SLOT_INVALID and not failed
                int cCoreId = array.get(coreIds, c)
                int cGenId  = array.get(coreGenerationIds, c)
                // Core -> nearby capable PC (exactly mTick, canonical tick range; symmetric to the L7 source)
                if c < array.size(corePhysicalBottoms) and c < array.size(corePhysicalTops)
                    float cBottom = array.get(corePhysicalBottoms, c)
                    float cTop    = array.get(corePhysicalTops, c)
                    if not na(cBottom) and not na(cTop)
                        int cBottomTick = int(math.round(cBottom / mintick))
                        int cTopTick    = int(math.round(cTop / mintick))
                        if cBottomTick <= cTopTick
                            addedCount += compPointRangeScanRaw(cBottomTick - mTick, cTopTick + mTick, visitEpoch, rootPriceOrderSlots, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, candVisitedEpochByRootSlot, candQueueRootSlots)
                int eRow = 0
                while eRow < edgeRowCount
                    bool pOk = eRow < array.size(participationEdgeLiveFlags) and eRow < array.size(participationEdgeExpectedRootIds) and eRow < array.size(participationEdgeSideSlots) and eRow < array.size(participationEdgeExpectedCoreIds)
                    if pOk
                        pOk := array.get(participationEdgeLiveFlags, eRow)
                    int pSideSlot = SLOT_INVALID
                    if pOk
                        pSideSlot := array.get(participationEdgeSideSlots, eRow)
                        pOk := pSideSlot >= 0 and pSideSlot < array.size(sidePhases)
                    if pOk
                        int pCoreSlot  = int(math.floor(pSideSlot / 2))
                        int pSideIndex = pSideSlot - pCoreSlot * 2
                        pOk := (pSideIndex == 0 or pSideIndex == 1) and pCoreSlot == c
                    if pOk
                        int pExpectedCoreId = array.get(participationEdgeExpectedCoreIds, eRow)
                        pOk := pExpectedCoreId != ID_NONE and pExpectedCoreId == cCoreId
                    int pRoot = SLOT_INVALID
                    if pOk
                        pRoot := array.get(participationEdgeRootSlots, eRow)
                        pOk := pRoot >= 0 and pRoot < rootCount and pRoot < array.size(rootSlotLiveFlags) and pRoot < array.size(candVisitedEpochByRootSlot)
                    if pOk
                        int pExpectedRootId = array.get(participationEdgeExpectedRootIds, eRow)
                        pOk := array.get(rootSlotLiveFlags, pRoot) and pExpectedRootId != ID_NONE and array.get(rootIds, pRoot) == pExpectedRootId
                    if pOk
                        int  pMask   = compSideMaskRaw(pRoot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
                        bool pNormal = false
                        if pMask != 0
                            int pCategory = array.get(rootCategories, pRoot)
                            if pMask == 3
                                pNormal := pCategory == CAT_MA or pCategory == CAT_SWING or pCategory == CAT_ACCUM or pCategory == CAT_TIME_HL
                            else if pCategory == CAT_FVG and pRoot < array.size(rootIsBroadFvgFlags)
                                pNormal := not array.get(rootIsBroadFvgFlags, pRoot)
                        if pNormal
                            if array.get(candVisitedEpochByRootSlot, pRoot) != visitEpoch
                                array.set(candVisitedEpochByRootSlot, pRoot, visitEpoch)
                                array.push(candQueueRootSlots, pRoot)
                                addedCount += 1
                    eRow += 1
                int  ci       = array.get(corePendingTopologyChildHeadIndexes, c)
                int  ciCount  = array.get(corePendingTopologyChildCounts, c)
                int  ciSeen   = 0
                bool ciChain  = ciCount >= 0 and ciCount <= childRowCount
                if not ciChain
                    failed := true
                while ciChain and ci != SLOT_INVALID and ciSeen < ciCount
                    bool ciOk = ci >= 0 and ci < childRowCount and ci < array.size(pendingTopologyChildNextIndexes) and ci < array.size(pendingTopologyChildOwnerCoreSlots) and ci < array.size(pendingTopologyChildExpectedCoreIds) and ci < array.size(pendingTopologyChildExpectedGenerationIds) and ci < array.size(pendingTopologyChildRootHeadNodeIndexes) and ci < array.size(pendingTopologyChildRootCounts)
                    if ciOk
                        ciOk := array.get(pendingTopologyChildLiveFlags, ci) and array.get(pendingTopologyChildOwnerCoreSlots, ci) == c and cCoreId != ID_NONE and array.get(pendingTopologyChildExpectedCoreIds, ci) == cCoreId and array.get(pendingTopologyChildExpectedGenerationIds, ci) == cGenId
                    if not ciOk
                        ciChain := false
                        failed  := true
                    else
                        int  rn      = array.get(pendingTopologyChildRootHeadNodeIndexes, ci)
                        int  rnCount = array.get(pendingTopologyChildRootCounts, ci)
                        int  rnSeen  = 0
                        bool rnChain = rnCount >= 0 and rnCount <= nodeRowCount
                        if not rnChain
                            failed  := true
                            ciChain := false
                        while rnChain and rn != SLOT_INVALID and rnSeen < rnCount
                            bool rnOk = rn >= 0 and rn < nodeRowCount and rn < array.size(pendingTopologyRootNodeNextIndexes) and rn < array.size(pendingTopologyRootNodeOwnerChildIndexes) and rn < array.size(pendingTopologyRootNodeExpectedCoreIds) and rn < array.size(pendingTopologyRootNodeExpectedGenerationIds) and rn < array.size(pendingTopologyRootNodeLiveFlags)
                            if rnOk
                                rnOk := array.get(pendingTopologyRootNodeLiveFlags, rn) and array.get(pendingTopologyRootNodeOwnerChildIndexes, rn) == ci and array.get(pendingTopologyRootNodeExpectedCoreIds, rn) == cCoreId and array.get(pendingTopologyRootNodeExpectedGenerationIds, rn) == cGenId
                            if not rnOk
                                rnChain := false
                                ciChain := false
                                failed  := true
                            else
                                int rnRootId = array.get(pendingTopologyRootNodeRootIds, rn)
                                int rnSlot   = SLOT_INVALID
                                if rnRootId != ID_NONE and map.contains(rootIdToSlot, rnRootId)
                                    rnSlot := map.get(rootIdToSlot, rnRootId)
                                if rnSlot >= 0 and rnSlot < rootCount and rnSlot < array.size(rootSlotLiveFlags) and rnSlot < array.size(candVisitedEpochByRootSlot)
                                    if array.get(rootSlotLiveFlags, rnSlot) and array.get(rootIds, rnSlot) == rnRootId
                                        int  rMask   = compSideMaskRaw(rnSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
                                        bool rNormal = false
                                        if rMask != 0
                                            int rCategory = array.get(rootCategories, rnSlot)
                                            if rMask == 3
                                                rNormal := rCategory == CAT_MA or rCategory == CAT_SWING or rCategory == CAT_ACCUM or rCategory == CAT_TIME_HL
                                            else if rCategory == CAT_FVG and rnSlot < array.size(rootIsBroadFvgFlags)
                                                rNormal := not array.get(rootIsBroadFvgFlags, rnSlot)
                                        if rNormal
                                            if array.get(candVisitedEpochByRootSlot, rnSlot) != visitEpoch
                                                array.set(candVisitedEpochByRootSlot, rnSlot, visitEpoch)
                                                array.push(candQueueRootSlots, rnSlot)
                                                addedCount += 1
                                rn     := array.get(pendingTopologyRootNodeNextIndexes, rn)
                                rnSeen += 1
                        if rnChain and (rn != SLOT_INVALID or rnSeen != rnCount)
                            ciChain := false
                            failed  := true
                        if ciChain
                            ci     := array.get(pendingTopologyChildNextIndexes, ci)
                            ciSeen += 1
                if ciChain and (ci != SLOT_INVALID or ciSeen != ciCount)
                    failed := true
    [addedCount, failed]

// W06 B07: fixed-point expansion of one dependency component whose start Roots the caller already placed in
// candQueueRootSlots (normal Roots, visited[slot] == visitEpoch). Read-index BFS over the growing queue:
//   capable PC t          : compPointRangeScanRaw(t - W, t + W) with W = max(mTick, denseTick, 0), compFvgLinkRaw,
//                           compExternalLinksRaw (each exactly once)
//   capable non-Broad FVG : compFvgLinkRaw, compExternalLinksRaw (each exactly once)
//   anything else         : no link is expanded from it (the queue is left intact for the caller's validation)
// The loop ends only when readIndex reaches the queue size (no iteration / Root / queue cap). Every slot enters the queue
// at most once per visitEpoch. The queue is never cleared, sorted or shifted here. Broad FVGs are never expanded or added.
// Returns array.size(candQueueRootSlots), or -1 without touching the queue when the visited array is smaller than rootIds,
// or -1 when compExternalLinksRaw reports a corrupt linked chain (the partial queue is never a successful component).
compExpandFixedPointRaw(int mTick, int denseTick, int visitEpoch, float mintick, array<int> rootPriceOrderSlots, array<int> categoryFvgRootSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> rootSubtypes, array<int> rootPairKeys, array<int> rootOriginKeys, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> participationEdgeRootSlots, array<int> participationEdgeExpectedRootIds, array<int> participationEdgeSideSlots, array<int> participationEdgeExpectedCoreIds, array<int> participationEdgeNextByRootIndexes, array<bool> participationEdgeLiveFlags, array<int> sidePhases, array<int> coreIds, array<int> coreGenerationIds, array<bool> coreSlotLiveFlags, array<int> coreLiveSlots, array<float> corePhysicalBottoms, array<float> corePhysicalTops, array<int> corePendingTopologyChildHeadIndexes, array<int> corePendingTopologyChildCounts, array<int> pendingTopologyChildNextIndexes, array<int> pendingTopologyChildOwnerCoreSlots, array<int> pendingTopologyChildExpectedCoreIds, array<int> pendingTopologyChildExpectedGenerationIds, array<int> pendingTopologyChildRootHeadNodeIndexes, array<int> pendingTopologyChildRootCounts, array<bool> pendingTopologyChildLiveFlags, array<int> pendingTopologyRootNodeRootIds, array<int> pendingTopologyRootNodeNextIndexes, array<int> pendingTopologyRootNodeOwnerChildIndexes, array<int> pendingTopologyRootNodeExpectedCoreIds, array<int> pendingTopologyRootNodeExpectedGenerationIds, array<bool> pendingTopologyRootNodeLiveFlags, array<int> candVisitedEpochByRootSlot, array<int> candQueueRootSlots) =>
    int finalRootCount = -1
    if array.size(candVisitedEpochByRootSlot) >= array.size(rootIds)
        int W          = math.max(mTick, denseTick, 0)
        int addedTotal = 0
        int readIndex  = 0
        bool failed    = false
        while not failed and readIndex < array.size(candQueueRootSlots)
            int currentSlot = array.get(candQueueRootSlots, readIndex)
            readIndex += 1
            int  currentMask = compSideMaskRaw(currentSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
            bool currentIsPc = false
            bool currentIsFc = false
            if currentMask != 0
                int currentCategory = array.get(rootCategories, currentSlot)
                currentIsPc := currentMask == 3 and (currentCategory == CAT_MA or currentCategory == CAT_SWING or currentCategory == CAT_ACCUM or currentCategory == CAT_TIME_HL)
                if currentCategory == CAT_FVG and currentSlot < array.size(rootIsBroadFvgFlags)
                    currentIsFc := not array.get(rootIsBroadFvgFlags, currentSlot)
            if currentIsPc
                int t = array.get(rootPointTicks, currentSlot)
                addedTotal += compPointRangeScanRaw(t - W, t + W, visitEpoch, rootPriceOrderSlots, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, candVisitedEpochByRootSlot, candQueueRootSlots)
            if currentIsPc or currentIsFc
                addedTotal += compFvgLinkRaw(currentSlot, denseTick, visitEpoch, rootPriceOrderSlots, categoryFvgRootSlots, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootIsBroadFvgFlags, candVisitedEpochByRootSlot, candQueueRootSlots)
                [extAdded, extFailed] = compExternalLinksRaw(currentSlot, mTick, visitEpoch, mintick, rootPriceOrderSlots, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootIsBroadFvgFlags, rootSubtypes, rootPairKeys, rootOriginKeys, rootIdToSlot, accumPairUpperRootSlotByKey, accumPairLowerRootSlotByKey, originKeyBucketHeadRootSlots, rootOriginBucketNextRootSlots, rootOriginBucketExpectedRootIds, rootParticipationHeadEdgeIndexes, rootParticipationCounts, participationEdgeRootSlots, participationEdgeExpectedRootIds, participationEdgeSideSlots, participationEdgeExpectedCoreIds, participationEdgeNextByRootIndexes, participationEdgeLiveFlags, sidePhases, coreIds, coreGenerationIds, coreSlotLiveFlags, coreLiveSlots, corePhysicalBottoms, corePhysicalTops, corePendingTopologyChildHeadIndexes, corePendingTopologyChildCounts, pendingTopologyChildNextIndexes, pendingTopologyChildOwnerCoreSlots, pendingTopologyChildExpectedCoreIds, pendingTopologyChildExpectedGenerationIds, pendingTopologyChildRootHeadNodeIndexes, pendingTopologyChildRootCounts, pendingTopologyChildLiveFlags, pendingTopologyRootNodeRootIds, pendingTopologyRootNodeNextIndexes, pendingTopologyRootNodeOwnerChildIndexes, pendingTopologyRootNodeExpectedCoreIds, pendingTopologyRootNodeExpectedGenerationIds, pendingTopologyRootNodeLiveFlags, candVisitedEpochByRootSlot, candQueueRootSlots)
                addedTotal += extAdded
                failed     := extFailed
        if not failed
            finalRootCount := array.size(candQueueRootSlots)
    finalRootCount

// W06 B08 component kinds / member roles / cache key constants (private)
const int CAND_COMPONENT_KIND_LOCAL       = 1
const int CAND_COMPONENT_KIND_BROAD_ONLY  = 2
const int CAND_MEMBER_ROLE_MEMBER         = 1
const int CAND_MEMBER_ROLE_INCLUDED_BROAD = 2
const int CAND_CACHE_STAGE_FULL_GREEDY    = 1
const int CAND_USED_EPOCH_ALL_CLEAR       = 0

// W06 B08: canonical key snapshot of one component row (the only producer of member snapshots).
// Entries are appended to the 7 member pools in rootIdOrderSlots order (rootId ascending; no sort, no BFS order):
//   LOCAL      : every slot of componentRootSlots[0 .. componentRootCount) as MEMBER (validated first: valid slot, normal
//                Root, live, rootId != 0, rootCandComponentExpectedRootIds == rootId, revision slots present, no duplicate),
//                and every other capable Broad FVG with compBroadIncludedRaw == true as INCLUDED_BROAD
//   BROAD_ONLY : componentRootCount must be 0; every capable Broad FVG as INCLUDED_BROAD (no Fresh / TF filter, no cap)
// One entry = rootId, role, compSideMaskRaw, geometry / quality / tieBreak / state revision of the slot. A snapshotted
// Root must have rootCandComponentExpectedRootIds == rootId (its revisions belong to it).
// LOCAL fails unless the canonical scan finds exactly componentRootCount MEMBER entries. On any failure the 7 pools are
// popped back to their start length and no row metadata is written. On success the row gets kind, member offset / length,
// cfgRevision, stage FULL_GREEDY, usedEpoch ALL_CLEAR (component ID, status, record, seen untouched). Returns success.
compSnapshotKeyRaw(int row, int kind, int cfgRevision, int denseTick, array<int> componentRootSlots, int componentRootCount, array<int> rootIdOrderSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> rootCandGeometryRevisions, array<int> rootCandQualityRevisions, array<int> rootCandTieBreakRevisions, array<int> rootCandStateRevisions, array<int> rootCandComponentExpectedRootIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candComponentCfgRevisions, array<int> candComponentStageKeys, array<int> candComponentUsedEpochKeys, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> candMemberSideMasks, array<int> candMemberGeometryRevisions, array<int> candMemberQualityRevisions, array<int> candMemberTieBreakRevisions, array<int> candMemberStateRevisions) =>
    int  startOffset = array.size(candMemberRootIds)
    bool ok = row >= 0 and row < array.size(candComponentKinds) and row < array.size(candComponentMemberOffsets) and row < array.size(candComponentMemberLengths) and row < array.size(candComponentCfgRevisions) and row < array.size(candComponentStageKeys) and row < array.size(candComponentUsedEpochKeys)
    if ok
        ok := array.size(candMemberRoleFlags) == startOffset and array.size(candMemberSideMasks) == startOffset and array.size(candMemberGeometryRevisions) == startOffset and array.size(candMemberQualityRevisions) == startOffset and array.size(candMemberTieBreakRevisions) == startOffset and array.size(candMemberStateRevisions) == startOffset
    if ok
        ok := (kind == CAND_COMPONENT_KIND_LOCAL or kind == CAND_COMPONENT_KIND_BROAD_ONLY) and componentRootCount >= 0 and componentRootCount <= array.size(componentRootSlots)
    if ok and kind == CAND_COMPONENT_KIND_BROAD_ONLY
        ok := componentRootCount == 0
    if ok and kind == CAND_COMPONENT_KIND_LOCAL
        ok := componentRootCount > 0
    // LOCAL member completeness before any write
    if ok and kind == CAND_COMPONENT_KIND_LOCAL
        int i = 0
        while ok and i < componentRootCount
            int  slot    = array.get(componentRootSlots, i)
            int  mask    = compSideMaskRaw(slot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
            bool normal  = false
            if mask != 0
                int category = array.get(rootCategories, slot)
                if mask == 3
                    normal := category == CAT_MA or category == CAT_SWING or category == CAT_ACCUM or category == CAT_TIME_HL
                else if category == CAT_FVG and slot < array.size(rootIsBroadFvgFlags)
                    normal := not array.get(rootIsBroadFvgFlags, slot)
            ok := normal and slot < array.size(rootCandComponentExpectedRootIds) and slot < array.size(rootCandGeometryRevisions) and slot < array.size(rootCandQualityRevisions) and slot < array.size(rootCandTieBreakRevisions) and slot < array.size(rootCandStateRevisions)
            if ok
                ok := array.get(rootCandComponentExpectedRootIds, slot) == array.get(rootIds, slot)
            int j = 0
            while ok and j < i
                ok := array.get(componentRootSlots, j) != slot
                j += 1
            i += 1
    // canonical rootId-ascending scan
    int memberFound = 0
    if ok
        int orderSize = array.size(rootIdOrderSlots)
        int p = 0
        while ok and p < orderSize
            int s = array.get(rootIdOrderSlots, p)
            bool inComponent = false
            if kind == CAND_COMPONENT_KIND_LOCAL
                int k = 0
                while not inComponent and k < componentRootCount
                    inComponent := array.get(componentRootSlots, k) == s
                    k += 1
            int role  = 0
            int sMask = compSideMaskRaw(s, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
            if inComponent
                role := CAND_MEMBER_ROLE_MEMBER
            else if sMask != 0 and s < array.size(rootIsBroadFvgFlags)
                if array.get(rootCategories, s) == CAT_FVG and array.get(rootIsBroadFvgFlags, s)
                    if kind == CAND_COMPONENT_KIND_BROAD_ONLY
                        role := CAND_MEMBER_ROLE_INCLUDED_BROAD
                    else if compBroadIncludedRaw(s, componentRootSlots, componentRootCount, denseTick, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks, rootIsBroadFvgFlags)
                        role := CAND_MEMBER_ROLE_INCLUDED_BROAD
            if role != 0
                ok := s < array.size(rootCandComponentExpectedRootIds) and s < array.size(rootCandGeometryRevisions) and s < array.size(rootCandQualityRevisions) and s < array.size(rootCandTieBreakRevisions) and s < array.size(rootCandStateRevisions)
                int rootId = ID_NONE
                if ok
                    rootId := array.get(rootIds, s)
                    ok := rootId != ID_NONE and array.get(rootCandComponentExpectedRootIds, s) == rootId
                if ok
                    array.push(candMemberRootIds,           rootId)
                    array.push(candMemberRoleFlags,         role)
                    array.push(candMemberSideMasks,         sMask)
                    array.push(candMemberGeometryRevisions, array.get(rootCandGeometryRevisions, s))
                    array.push(candMemberQualityRevisions,  array.get(rootCandQualityRevisions, s))
                    array.push(candMemberTieBreakRevisions, array.get(rootCandTieBreakRevisions, s))
                    array.push(candMemberStateRevisions,    array.get(rootCandStateRevisions, s))
                    if role == CAND_MEMBER_ROLE_MEMBER
                        memberFound += 1
            p += 1
    if ok and kind == CAND_COMPONENT_KIND_LOCAL
        ok := memberFound == componentRootCount
    if ok
        array.set(candComponentKinds,         row, kind)
        array.set(candComponentMemberOffsets, row, startOffset)
        array.set(candComponentMemberLengths, row, array.size(candMemberRootIds) - startOffset)
        array.set(candComponentCfgRevisions,  row, cfgRevision)
        array.set(candComponentStageKeys,     row, CAND_CACHE_STAGE_FULL_GREEDY)
        array.set(candComponentUsedEpochKeys, row, CAND_USED_EPOCH_ALL_CLEAR)
    else
        while array.size(candMemberRootIds) > startOffset
            array.pop(candMemberRootIds)
        while array.size(candMemberRoleFlags) > startOffset
            array.pop(candMemberRoleFlags)
        while array.size(candMemberSideMasks) > startOffset
            array.pop(candMemberSideMasks)
        while array.size(candMemberGeometryRevisions) > startOffset
            array.pop(candMemberGeometryRevisions)
        while array.size(candMemberQualityRevisions) > startOffset
            array.pop(candMemberQualityRevisions)
        while array.size(candMemberTieBreakRevisions) > startOffset
            array.pop(candMemberTieBreakRevisions)
        while array.size(candMemberStateRevisions) > startOffset
            array.pop(candMemberStateRevisions)
    ok

// W06 B08: exact Side cache key equality of two component rows. sideBit is exactly 1 (Support) or 2 (Resistance).
// Both rows and their member ranges must be valid (7 pools of one length, offset / length inside, every role MEMBER or
// INCLUDED_BROAD). Then, in order: kind, component ID, cfgRevision, stageKey, usedEpochKey equal; the MEMBER rootId
// sequences equal (logical identity; INCLUDED_BROAD excluded); and the entries whose sideMask contains sideBit (both
// roles) equal one by one in (rootId, role, geometry, quality, tieBreak, state) with the same count. sideMask only selects.
// No hash, no Fresh, no global revision. Any invalid input -> false.
compKeyEqualSideRaw(int oldRow, int newRow, int sideBit, array<int> candComponentIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candComponentCfgRevisions, array<int> candComponentStageKeys, array<int> candComponentUsedEpochKeys, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> candMemberSideMasks, array<int> candMemberGeometryRevisions, array<int> candMemberQualityRevisions, array<int> candMemberTieBreakRevisions, array<int> candMemberStateRevisions) =>
    int  poolLen = array.size(candMemberRootIds)
    bool ok = sideBit == 1 or sideBit == 2
    if ok
        ok := array.size(candMemberRoleFlags) == poolLen and array.size(candMemberSideMasks) == poolLen and array.size(candMemberGeometryRevisions) == poolLen and array.size(candMemberQualityRevisions) == poolLen and array.size(candMemberTieBreakRevisions) == poolLen and array.size(candMemberStateRevisions) == poolLen
    int rowCount = array.size(candComponentIds)
    if ok
        ok := rowCount == array.size(candComponentKinds) and rowCount == array.size(candComponentMemberOffsets) and rowCount == array.size(candComponentMemberLengths) and rowCount == array.size(candComponentCfgRevisions) and rowCount == array.size(candComponentStageKeys) and rowCount == array.size(candComponentUsedEpochKeys)
    if ok
        ok := oldRow >= 0 and oldRow < rowCount and newRow >= 0 and newRow < rowCount
    int oStart = 0
    int oEnd   = 0
    int nStart = 0
    int nEnd   = 0
    if ok
        oStart := array.get(candComponentMemberOffsets, oldRow)
        oEnd   := oStart + array.get(candComponentMemberLengths, oldRow)
        nStart := array.get(candComponentMemberOffsets, newRow)
        nEnd   := nStart + array.get(candComponentMemberLengths, newRow)
        ok := oStart >= 0 and oEnd >= oStart and oEnd <= poolLen and nStart >= 0 and nEnd >= nStart and nEnd <= poolLen
    if ok
        int v = oStart
        while ok and v < oEnd
            int vRole = array.get(candMemberRoleFlags, v)
            ok := vRole == CAND_MEMBER_ROLE_MEMBER or vRole == CAND_MEMBER_ROLE_INCLUDED_BROAD
            v += 1
        v := nStart
        while ok and v < nEnd
            int vRole = array.get(candMemberRoleFlags, v)
            ok := vRole == CAND_MEMBER_ROLE_MEMBER or vRole == CAND_MEMBER_ROLE_INCLUDED_BROAD
            v += 1
    if ok
        ok := array.get(candComponentKinds, oldRow) == array.get(candComponentKinds, newRow) and array.get(candComponentIds, oldRow) == array.get(candComponentIds, newRow) and array.get(candComponentCfgRevisions, oldRow) == array.get(candComponentCfgRevisions, newRow) and array.get(candComponentStageKeys, oldRow) == array.get(candComponentStageKeys, newRow) and array.get(candComponentUsedEpochKeys, oldRow) == array.get(candComponentUsedEpochKeys, newRow)
    // logical identity: MEMBER rootId sequences
    if ok
        int  i    = oStart
        int  j    = nStart
        bool done = false
        while ok and not done
            while i < oEnd and array.get(candMemberRoleFlags, i) != CAND_MEMBER_ROLE_MEMBER
                i += 1
            while j < nEnd and array.get(candMemberRoleFlags, j) != CAND_MEMBER_ROLE_MEMBER
                j += 1
            if i >= oEnd or j >= nEnd
                ok   := i >= oEnd and j >= nEnd
                done := true
            else
                ok := array.get(candMemberRootIds, i) == array.get(candMemberRootIds, j)
                i += 1
                j += 1
    // Side key: entries whose sideMask contains sideBit
    if ok
        int  i    = oStart
        int  j    = nStart
        bool done = false
        while ok and not done
            while i < oEnd and array.get(candMemberSideMasks, i) % (2 * sideBit) < sideBit
                i += 1
            while j < nEnd and array.get(candMemberSideMasks, j) % (2 * sideBit) < sideBit
                j += 1
            if i >= oEnd or j >= nEnd
                ok   := i >= oEnd and j >= nEnd
                done := true
            else
                ok := array.get(candMemberRootIds, i) == array.get(candMemberRootIds, j) and array.get(candMemberRoleFlags, i) == array.get(candMemberRoleFlags, j) and array.get(candMemberGeometryRevisions, i) == array.get(candMemberGeometryRevisions, j) and array.get(candMemberQualityRevisions, i) == array.get(candMemberQualityRevisions, j) and array.get(candMemberTieBreakRevisions, i) == array.get(candMemberTieBreakRevisions, j) and array.get(candMemberStateRevisions, i) == array.get(candMemberStateRevisions, j)
                i += 1
                j += 1
    ok

// W06 B08: component ID inheritance for a freshly snapshotted row (component ID still 0).
//   LOCAL      : every MEMBER rootId resolves through rootIdToSlot to a live slot with the same rootId and
//                rootCandComponentExpectedRootIds == rootId (else -1); if every MEMBER carries the same non-zero
//                rootCandComponentIds, the single row with that ID (0 or 2+ rows -> -1, not LOCAL -> -1, invalid range -> -1)
//                is compared by exact MEMBER rootId sequence: equal -> that ID, different -> 0. A zero or mixed old ID -> 0.
//   BROAD_ONLY : the rows of kind BROAD_ONLY with a non-zero ID other than newRow: none -> 0, one -> its ID, 2+ -> -1.
// INCLUDED_BROAD never takes part. Rows with component ID 0 are never old-row candidates. No hash.
// Returns > 0 inherited ID / 0 no inheritance (new ID) / -1 invalid or corrupt (full fallback).
compInheritIdRaw(int newRow, array<int> rootIds, array<bool> rootSlotLiveFlags, map<int, int> rootIdToSlot, array<int> rootCandComponentIds, array<int> rootCandComponentExpectedRootIds, array<int> candComponentIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> candMemberSideMasks, array<int> candMemberGeometryRevisions, array<int> candMemberQualityRevisions, array<int> candMemberTieBreakRevisions, array<int> candMemberStateRevisions) =>
    int  result  = -1
    int  poolLen = array.size(candMemberRootIds)
    int  rowCount = array.size(candComponentIds)
    bool ok = array.size(candMemberRoleFlags) == poolLen and array.size(candMemberSideMasks) == poolLen and array.size(candMemberGeometryRevisions) == poolLen and array.size(candMemberQualityRevisions) == poolLen and array.size(candMemberTieBreakRevisions) == poolLen and array.size(candMemberStateRevisions) == poolLen
    if ok
        ok := rowCount == array.size(candComponentKinds) and rowCount == array.size(candComponentMemberOffsets) and rowCount == array.size(candComponentMemberLengths) and newRow >= 0 and newRow < rowCount
    int nStart = 0
    int nEnd   = 0
    if ok
        nStart := array.get(candComponentMemberOffsets, newRow)
        nEnd   := nStart + array.get(candComponentMemberLengths, newRow)
        ok := nStart >= 0 and nEnd >= nStart and nEnd <= poolLen
    if ok
        int v = nStart
        while ok and v < nEnd
            int vRole = array.get(candMemberRoleFlags, v)
            ok := vRole == CAND_MEMBER_ROLE_MEMBER or vRole == CAND_MEMBER_ROLE_INCLUDED_BROAD
            v += 1
    if ok
        int kind = array.get(candComponentKinds, newRow)
        if kind == CAND_COMPONENT_KIND_BROAD_ONLY
            int found = 0
            int foundId = 0
            int r = 0
            while r < rowCount
                int rId = array.get(candComponentIds, r)
                if r != newRow and rId != 0 and array.get(candComponentKinds, r) == CAND_COMPONENT_KIND_BROAD_ONLY
                    found   += 1
                    foundId := rId
                r += 1
            result := found == 0 ? 0 : found == 1 and foundId > 0 ? foundId : -1
        else if kind == CAND_COMPONENT_KIND_LOCAL
            int  memberCount = 0
            int  oldId       = 0
            bool mixed       = false
            bool structOk    = true
            int  m = nStart
            while structOk and m < nEnd
                if array.get(candMemberRoleFlags, m) == CAND_MEMBER_ROLE_MEMBER
                    int mRootId = array.get(candMemberRootIds, m)
                    int mSlot   = SLOT_INVALID
                    if mRootId != ID_NONE and map.contains(rootIdToSlot, mRootId)
                        mSlot := map.get(rootIdToSlot, mRootId)
                    structOk := mSlot >= 0 and mSlot < array.size(rootIds) and mSlot < array.size(rootSlotLiveFlags) and mSlot < array.size(rootCandComponentIds) and mSlot < array.size(rootCandComponentExpectedRootIds)
                    if structOk
                        structOk := array.get(rootSlotLiveFlags, mSlot) and array.get(rootIds, mSlot) == mRootId and array.get(rootCandComponentExpectedRootIds, mSlot) == mRootId
                    if structOk
                        int mOldId = array.get(rootCandComponentIds, mSlot)
                        if memberCount == 0
                            oldId := mOldId
                        else if mOldId != oldId
                            mixed := true
                        memberCount += 1
                m += 1
            if not structOk or memberCount == 0
                result := -1
            else if mixed or oldId == 0
                result := 0
            else
                int oldRow = SLOT_INVALID
                int found  = 0
                int r = 0
                while r < rowCount
                    if r != newRow and array.get(candComponentIds, r) == oldId
                        found  += 1
                        oldRow := r
                    r += 1
                if found != 1
                    result := -1
                else if array.get(candComponentKinds, oldRow) != CAND_COMPONENT_KIND_LOCAL
                    result := -1
                else
                    int oStart = array.get(candComponentMemberOffsets, oldRow)
                    int oEnd   = oStart + array.get(candComponentMemberLengths, oldRow)
                    if not (oStart >= 0 and oEnd >= oStart and oEnd <= poolLen)
                        result := -1
                    else
                        bool rolesOk = true
                        int  w = oStart
                        while rolesOk and w < oEnd
                            int wRole = array.get(candMemberRoleFlags, w)
                            rolesOk := wRole == CAND_MEMBER_ROLE_MEMBER or wRole == CAND_MEMBER_ROLE_INCLUDED_BROAD
                            w += 1
                        if not rolesOk
                            result := -1
                        else
                            bool same = true
                            bool done = false
                            int  i    = oStart
                            int  j    = nStart
                            while same and not done
                                while i < oEnd and array.get(candMemberRoleFlags, i) != CAND_MEMBER_ROLE_MEMBER
                                    i += 1
                                while j < nEnd and array.get(candMemberRoleFlags, j) != CAND_MEMBER_ROLE_MEMBER
                                    j += 1
                                if i >= oEnd or j >= nEnd
                                    same := i >= oEnd and j >= nEnd
                                    done := true
                                else
                                    same := array.get(candMemberRootIds, i) == array.get(candMemberRootIds, j)
                                    i += 1
                                    j += 1
                            result := same ? oldId : 0
    result

// W06 B09 build codes / cache status sentinel / Pine physical array bound (private). CAND_CACHE_STATUS_DIRTY is outside
// the W05 Side status domain {-1 (Side failure / invalid domain)} U {0 .. winner count}; it only means "not computed".
// MAX_PHYSICAL_ARRAY_ELEMENTS is the Pine array size bound, never a logical cap.
const int COMP_BUILD_OK               = 0
const int COMP_BUILD_FULL_FALLBACK    = 1
const int CAND_CACHE_STATUS_DIRTY     = -2147483647
const int MAX_PHYSICAL_ARRAY_ELEMENTS = 100000
// PHASE A canonical Candidate record layout: 16 ints per record (side, stage, bottomTick, topTick, C, H, density,
// baseStrong, catMask, highMask, createdTime, minRootId, fvgMode, psychTick, rootIdOffset, rootIdLength), 1 reference
// price per record, the record's root IDs at [rootIdOffset, rootIdOffset + rootIdLength) of candRecordRootIds.
// Row record offsets / lengths count records.
const int CAND_RECORD_INT_STRIDE        = 16
const int CAND_RECORD_ROOT_OFFSET_FIELD = 14
const int CAND_RECORD_ROOT_LENGTH_FIELD = 15
// W06 B09: removes component row `row` from the 17 row arrays and rowIsOld by swap-pop (the last row moves into `row`).
// Member / record / seen pools are not touched. Returns false (nothing changed) on a length mismatch or invalid row.
compRemoveRowRaw(int row, array<int> candComponentIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candComponentCfgRevisions, array<int> candComponentStageKeys, array<int> candComponentUsedEpochKeys, array<int> candComponentSupportStatuses, array<int> candComponentResistanceStatuses, array<int> candComponentSupportRecordOffsets, array<int> candComponentSupportRecordLengths, array<int> candComponentResistanceRecordOffsets, array<int> candComponentResistanceRecordLengths, array<int> candComponentSupportSeenOffsets, array<int> candComponentSupportSeenLengths, array<int> candComponentResistanceSeenOffsets, array<int> candComponentResistanceSeenLengths, array<bool> rowIsOld) =>
    int  rowCount = array.size(candComponentIds)
    bool ok = rowCount == array.size(candComponentKinds) and rowCount == array.size(candComponentMemberOffsets) and rowCount == array.size(candComponentMemberLengths) and rowCount == array.size(candComponentCfgRevisions) and rowCount == array.size(candComponentStageKeys) and rowCount == array.size(candComponentUsedEpochKeys) and rowCount == array.size(candComponentSupportStatuses) and rowCount == array.size(candComponentResistanceStatuses) and rowCount == array.size(candComponentSupportRecordOffsets) and rowCount == array.size(candComponentSupportRecordLengths) and rowCount == array.size(candComponentResistanceRecordOffsets) and rowCount == array.size(candComponentResistanceRecordLengths) and rowCount == array.size(candComponentSupportSeenOffsets) and rowCount == array.size(candComponentSupportSeenLengths) and rowCount == array.size(candComponentResistanceSeenOffsets) and rowCount == array.size(candComponentResistanceSeenLengths) and rowCount == array.size(rowIsOld)
    if ok
        ok := row >= 0 and row < rowCount
    if ok
        int last = rowCount - 1
        if row != last
            array.set(candComponentIds, row, array.get(candComponentIds, last))
            array.set(candComponentKinds, row, array.get(candComponentKinds, last))
            array.set(candComponentMemberOffsets, row, array.get(candComponentMemberOffsets, last))
            array.set(candComponentMemberLengths, row, array.get(candComponentMemberLengths, last))
            array.set(candComponentCfgRevisions, row, array.get(candComponentCfgRevisions, last))
            array.set(candComponentStageKeys, row, array.get(candComponentStageKeys, last))
            array.set(candComponentUsedEpochKeys, row, array.get(candComponentUsedEpochKeys, last))
            array.set(candComponentSupportStatuses, row, array.get(candComponentSupportStatuses, last))
            array.set(candComponentResistanceStatuses, row, array.get(candComponentResistanceStatuses, last))
            array.set(candComponentSupportRecordOffsets, row, array.get(candComponentSupportRecordOffsets, last))
            array.set(candComponentSupportRecordLengths, row, array.get(candComponentSupportRecordLengths, last))
            array.set(candComponentResistanceRecordOffsets, row, array.get(candComponentResistanceRecordOffsets, last))
            array.set(candComponentResistanceRecordLengths, row, array.get(candComponentResistanceRecordLengths, last))
            array.set(candComponentSupportSeenOffsets, row, array.get(candComponentSupportSeenOffsets, last))
            array.set(candComponentSupportSeenLengths, row, array.get(candComponentSupportSeenLengths, last))
            array.set(candComponentResistanceSeenOffsets, row, array.get(candComponentResistanceSeenOffsets, last))
            array.set(candComponentResistanceSeenLengths, row, array.get(candComponentResistanceSeenLengths, last))
            array.set(rowIsOld, row, array.get(rowIsOld, last))
        array.pop(candComponentIds)
        array.pop(candComponentKinds)
        array.pop(candComponentMemberOffsets)
        array.pop(candComponentMemberLengths)
        array.pop(candComponentCfgRevisions)
        array.pop(candComponentStageKeys)
        array.pop(candComponentUsedEpochKeys)
        array.pop(candComponentSupportStatuses)
        array.pop(candComponentResistanceStatuses)
        array.pop(candComponentSupportRecordOffsets)
        array.pop(candComponentSupportRecordLengths)
        array.pop(candComponentResistanceRecordOffsets)
        array.pop(candComponentResistanceRecordLengths)
        array.pop(candComponentSupportSeenOffsets)
        array.pop(candComponentSupportSeenLengths)
        array.pop(candComponentResistanceSeenOffsets)
        array.pop(candComponentResistanceSeenLengths)
        array.pop(rowIsOld)
    ok

// W06 B09: rebuilds the member (7), record (3) and seen (1) pools from the surviving rows only, in row order, and rewrites
// every offset. All slices are validated first (offset >= 0, length >= 0, inside the pool; the 7 member pools of one
// length; the record pools in the stride-16 layout: ints = 16 x records, one price per record, every record's root slice
// inside candRecordRootIds; a DIRTY Side carries record and seen length 0). Record slices count records; each copied
// record gets its root IDs copied in order and its rootIdOffset field rewritten to the new root position. The rows are copied slice by slice into temporary
// arrays (shared or out-of-order source slices are copied per row, never deduplicated; no in-place overwrite); only when
// every copy succeeded are the pools cleared and refilled and the offsets written. A pool whose surviving total exceeds
// MAX_PHYSICAL_ARRAY_ELEMENTS fails (no logical reduction). Returns success; on false nothing was modified.
compCompactPoolsRaw(array<int> candComponentIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candComponentCfgRevisions, array<int> candComponentStageKeys, array<int> candComponentUsedEpochKeys, array<int> candComponentSupportStatuses, array<int> candComponentResistanceStatuses, array<int> candComponentSupportRecordOffsets, array<int> candComponentSupportRecordLengths, array<int> candComponentResistanceRecordOffsets, array<int> candComponentResistanceRecordLengths, array<int> candComponentSupportSeenOffsets, array<int> candComponentSupportSeenLengths, array<int> candComponentResistanceSeenOffsets, array<int> candComponentResistanceSeenLengths, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> candMemberSideMasks, array<int> candMemberGeometryRevisions, array<int> candMemberQualityRevisions, array<int> candMemberTieBreakRevisions, array<int> candMemberStateRevisions, array<int> candRecordInts, array<float> candRecordReferencePrices, array<int> candRecordRootIds, array<int> candSeenBroadRootIds) =>
    int  rowCount = array.size(candComponentIds)
    int  memLen   = array.size(candMemberRootIds)
    int  recIntLen = array.size(candRecordInts)
    int  recLen    = 0
    int  rootLen   = array.size(candRecordRootIds)
    int  seenLen   = array.size(candSeenBroadRootIds)
    bool ok = rowCount == array.size(candComponentKinds) and rowCount == array.size(candComponentMemberOffsets) and rowCount == array.size(candComponentMemberLengths) and rowCount == array.size(candComponentCfgRevisions) and rowCount == array.size(candComponentStageKeys) and rowCount == array.size(candComponentUsedEpochKeys) and rowCount == array.size(candComponentSupportStatuses) and rowCount == array.size(candComponentResistanceStatuses) and rowCount == array.size(candComponentSupportRecordOffsets) and rowCount == array.size(candComponentSupportRecordLengths) and rowCount == array.size(candComponentResistanceRecordOffsets) and rowCount == array.size(candComponentResistanceRecordLengths) and rowCount == array.size(candComponentSupportSeenOffsets) and rowCount == array.size(candComponentSupportSeenLengths) and rowCount == array.size(candComponentResistanceSeenOffsets) and rowCount == array.size(candComponentResistanceSeenLengths)
    if ok
        ok := array.size(candMemberRoleFlags) == memLen and array.size(candMemberSideMasks) == memLen and array.size(candMemberGeometryRevisions) == memLen and array.size(candMemberQualityRevisions) == memLen and array.size(candMemberTieBreakRevisions) == memLen and array.size(candMemberStateRevisions) == memLen
    if ok
        ok := recIntLen % CAND_RECORD_INT_STRIDE == 0
    if ok
        recLen := int(math.floor(recIntLen / CAND_RECORD_INT_STRIDE))
        ok := array.size(candRecordReferencePrices) == recLen
    int memTotal  = 0
    int recTotal  = 0
    int rootTotal = 0
    int seenTotal = 0
    int r = 0
    while ok and r < rowCount
        int mOff  = array.get(candComponentMemberOffsets, r)
        int mLen  = array.get(candComponentMemberLengths, r)
        int sStat = array.get(candComponentSupportStatuses, r)
        int rStat = array.get(candComponentResistanceStatuses, r)
        int sROff = array.get(candComponentSupportRecordOffsets, r)
        int sRLen = array.get(candComponentSupportRecordLengths, r)
        int rROff = array.get(candComponentResistanceRecordOffsets, r)
        int rRLen = array.get(candComponentResistanceRecordLengths, r)
        int sSOff = array.get(candComponentSupportSeenOffsets, r)
        int sSLen = array.get(candComponentSupportSeenLengths, r)
        int rSOff = array.get(candComponentResistanceSeenOffsets, r)
        int rSLen = array.get(candComponentResistanceSeenLengths, r)
        ok := mOff >= 0 and mLen >= 0 and mOff + mLen <= memLen
        ok := ok and sROff >= 0 and sRLen >= 0 and sROff + sRLen <= recLen and rROff >= 0 and rRLen >= 0 and rROff + rRLen <= recLen
        ok := ok and sSOff >= 0 and sSLen >= 0 and sSOff + sSLen <= seenLen and rSOff >= 0 and rSLen >= 0 and rSOff + rSLen <= seenLen
        if ok and sStat == CAND_CACHE_STATUS_DIRTY
            ok := sRLen == 0 and sSLen == 0
        if ok and rStat == CAND_CACHE_STATUS_DIRTY
            ok := rRLen == 0 and rSLen == 0
        // every record of both Side slices: root slice inside candRecordRootIds
        int side = 0
        while ok and side < 2
            int vOff = side == 0 ? sROff : rROff
            int vLen = side == 0 ? sRLen : rRLen
            int v = 0
            while ok and v < vLen
                int intBase    = (vOff + v) * CAND_RECORD_INT_STRIDE
                int rootOffset = array.get(candRecordInts, intBase + CAND_RECORD_ROOT_OFFSET_FIELD)
                int rootLength = array.get(candRecordInts, intBase + CAND_RECORD_ROOT_LENGTH_FIELD)
                ok := rootOffset >= 0 and rootLength >= 0 and rootOffset + rootLength <= rootLen
                if ok
                    rootTotal += rootLength
                v += 1
            side += 1
        if ok
            memTotal  += mLen
            recTotal  += sRLen + rRLen
            seenTotal += sSLen + rSLen
        r += 1
    // physical bound per array: ints 16 x records, prices = records, root IDs = total root length
    if ok
        ok := memTotal <= MAX_PHYSICAL_ARRAY_ELEMENTS and recTotal * CAND_RECORD_INT_STRIDE <= MAX_PHYSICAL_ARRAY_ELEMENTS and recTotal <= MAX_PHYSICAL_ARRAY_ELEMENTS and rootTotal <= MAX_PHYSICAL_ARRAY_ELEMENTS and seenTotal <= MAX_PHYSICAL_ARRAY_ELEMENTS
    if ok
        array<int>   tCandMemberRootIds = array.new_int(0)
        array<int>   tCandMemberRoleFlags = array.new_int(0)
        array<int>   tCandMemberSideMasks = array.new_int(0)
        array<int>   tCandMemberGeometryRevisions = array.new_int(0)
        array<int>   tCandMemberQualityRevisions = array.new_int(0)
        array<int>   tCandMemberTieBreakRevisions = array.new_int(0)
        array<int>   tCandMemberStateRevisions = array.new_int(0)
        array<int>   tRecordInts            = array.new_int(0)
        array<float> tRecordReferencePrices = array.new_float(0)
        array<int>   tRecordRootIds         = array.new_int(0)
        array<int>   tSeenBroadRootIds      = array.new_int(0)
        array<int>   nMemberOffsets         = array.new_int(0)
        array<int>   nSupportRecordOffsets  = array.new_int(0)
        array<int>   nResistanceRecordOffsets = array.new_int(0)
        array<int>   nSupportSeenOffsets    = array.new_int(0)
        array<int>   nResistanceSeenOffsets = array.new_int(0)
        int q = 0
        while q < rowCount
            // member slice
            int mOff = array.get(candComponentMemberOffsets, q)
            int mLen = array.get(candComponentMemberLengths, q)
            array.push(nMemberOffsets, array.size(tCandMemberRootIds))
            int k = 0
            while k < mLen
                array.push(tCandMemberRootIds, array.get(candMemberRootIds, mOff + k))
                array.push(tCandMemberRoleFlags, array.get(candMemberRoleFlags, mOff + k))
                array.push(tCandMemberSideMasks, array.get(candMemberSideMasks, mOff + k))
                array.push(tCandMemberGeometryRevisions, array.get(candMemberGeometryRevisions, mOff + k))
                array.push(tCandMemberQualityRevisions, array.get(candMemberQualityRevisions, mOff + k))
                array.push(tCandMemberTieBreakRevisions, array.get(candMemberTieBreakRevisions, mOff + k))
                array.push(tCandMemberStateRevisions, array.get(candMemberStateRevisions, mOff + k))
                k += 1
            // Support then Resistance record slices (record units): per record its root IDs, then its 16 ints with
            // field 14 rewritten to the new root offset, then its reference price
            int side = 0
            while side < 2
                int cOff  = side == 0 ? array.get(candComponentSupportRecordOffsets, q) : array.get(candComponentResistanceRecordOffsets, q)
                int cLen  = side == 0 ? array.get(candComponentSupportRecordLengths, q) : array.get(candComponentResistanceRecordLengths, q)
                int cStat = side == 0 ? array.get(candComponentSupportStatuses, q) : array.get(candComponentResistanceStatuses, q)
                int newRecordOffset = cStat == CAND_CACHE_STATUS_DIRTY ? 0 : array.size(tRecordReferencePrices)
                if side == 0
                    array.push(nSupportRecordOffsets, newRecordOffset)
                else
                    array.push(nResistanceRecordOffsets, newRecordOffset)
                k := 0
                while k < cLen
                    int oldBase       = (cOff + k) * CAND_RECORD_INT_STRIDE
                    int oldRootOffset = array.get(candRecordInts, oldBase + CAND_RECORD_ROOT_OFFSET_FIELD)
                    int oldRootLength = array.get(candRecordInts, oldBase + CAND_RECORD_ROOT_LENGTH_FIELD)
                    int newRootOffset = array.size(tRecordRootIds)
                    int g = 0
                    while g < oldRootLength
                        array.push(tRecordRootIds, array.get(candRecordRootIds, oldRootOffset + g))
                        g += 1
                    int f = 0
                    while f < CAND_RECORD_INT_STRIDE
                        array.push(tRecordInts, f == CAND_RECORD_ROOT_OFFSET_FIELD ? newRootOffset : array.get(candRecordInts, oldBase + f))
                        f += 1
                    array.push(tRecordReferencePrices, array.get(candRecordReferencePrices, cOff + k))
                    k += 1
                side += 1
            // Support / Resistance seen slices
            int sSOff = array.get(candComponentSupportSeenOffsets, q)
            int sSLen = array.get(candComponentSupportSeenLengths, q)
            array.push(nSupportSeenOffsets, array.get(candComponentSupportStatuses, q) == CAND_CACHE_STATUS_DIRTY ? 0 : array.size(tSeenBroadRootIds))
            k := 0
            while k < sSLen
                array.push(tSeenBroadRootIds, array.get(candSeenBroadRootIds, sSOff + k))
                k += 1
            int rSOff = array.get(candComponentResistanceSeenOffsets, q)
            int rSLen = array.get(candComponentResistanceSeenLengths, q)
            array.push(nResistanceSeenOffsets, array.get(candComponentResistanceStatuses, q) == CAND_CACHE_STATUS_DIRTY ? 0 : array.size(tSeenBroadRootIds))
            k := 0
            while k < rSLen
                array.push(tSeenBroadRootIds, array.get(candSeenBroadRootIds, rSOff + k))
                k += 1
            q += 1
        // commit: pools replaced, offsets rewritten
        array.clear(candMemberRootIds)
        array.clear(candMemberRoleFlags)
        array.clear(candMemberSideMasks)
        array.clear(candMemberGeometryRevisions)
        array.clear(candMemberQualityRevisions)
        array.clear(candMemberTieBreakRevisions)
        array.clear(candMemberStateRevisions)
        array.clear(candRecordInts)
        array.clear(candRecordReferencePrices)
        array.clear(candRecordRootIds)
        array.clear(candSeenBroadRootIds)
        int e = 0
        while e < array.size(tCandMemberRootIds)
            array.push(candMemberRootIds, array.get(tCandMemberRootIds, e))
            array.push(candMemberRoleFlags, array.get(tCandMemberRoleFlags, e))
            array.push(candMemberSideMasks, array.get(tCandMemberSideMasks, e))
            array.push(candMemberGeometryRevisions, array.get(tCandMemberGeometryRevisions, e))
            array.push(candMemberQualityRevisions, array.get(tCandMemberQualityRevisions, e))
            array.push(candMemberTieBreakRevisions, array.get(tCandMemberTieBreakRevisions, e))
            array.push(candMemberStateRevisions, array.get(tCandMemberStateRevisions, e))
            e += 1
        e := 0
        while e < array.size(tRecordInts)
            array.push(candRecordInts, array.get(tRecordInts, e))
            e += 1
        e := 0
        while e < array.size(tRecordReferencePrices)
            array.push(candRecordReferencePrices, array.get(tRecordReferencePrices, e))
            e += 1
        e := 0
        while e < array.size(tRecordRootIds)
            array.push(candRecordRootIds, array.get(tRecordRootIds, e))
            e += 1
        e := 0
        while e < array.size(tSeenBroadRootIds)
            array.push(candSeenBroadRootIds, array.get(tSeenBroadRootIds, e))
            e += 1
        q := 0
        while q < rowCount
            array.set(candComponentMemberOffsets,           q, array.get(nMemberOffsets, q))
            array.set(candComponentSupportRecordOffsets,    q, array.get(nSupportRecordOffsets, q))
            array.set(candComponentResistanceRecordOffsets, q, array.get(nResistanceRecordOffsets, q))
            array.set(candComponentSupportSeenOffsets,      q, array.get(nSupportSeenOffsets, q))
            array.set(candComponentResistanceSeenOffsets,   q, array.get(nResistanceSeenOffsets, q))
            q += 1
    ok

// W06 B09: dependency component cache build (no Candidate run). Modes:
//   cache invalid (cacheValid false)          : rows / pools / Root component IDs cleared, every normal Root rebuilt
//   cfg change (valid, cfgRevision differs)   : every old component affected, every normal Root rebuilt (IDs inheritable)
//   local (valid, same cfg, seedCount > 0)    : seeds -> old components (Root ID, old MEMBER / INCLUDED_BROAD snapshots,
//                                               current Broad inclusion) -> affected fixed-point with the B07 closure
//   no work (valid, same cfg, seedCount == 0) : nothing changes
// New LOCAL components start at the smallest eligible Root of rootIdOrderSlots (restart after every newly affected old
// component), are expanded by compExpandFixedPointRaw, snapshotted by compSnapshotKeyRaw, and take an inherited ID
// (compInheritIdRaw) or a new one. A Side whose compKeyEqualSideRaw holds against the old row of the inherited ID copies
// status / record / seen slices; any other Side is CAND_CACHE_STATUS_DIRTY. BROAD_ONLY (exactly one row) is rebuilt on
// invalid cache, cfg change or any Broad change. Affected old rows are swap-popped, pools compacted, then Root component
// IDs are cleared / assigned (commit point). Any integrity or physical capacity failure returns COMP_BUILD_FULL_FALLBACK
// with cacheValid false, visited reset to 0 and epoch 0; the caller's next ID is returned unchanged.
// Returns [buildCode, nextComponentId, cacheValid, cacheCfgRevision, visitEpoch, affectedCount, removedCount].
export buildComponents(int cfgRevision, bool cacheValid, int cacheCfgRevision, int nextComponentId, int mTick, int denseTick, int visitEpoch, float mintick, array<int> rootPriceOrderSlots, array<int> categoryFvgRootSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> rootSubtypes, array<int> rootPairKeys, array<int> rootOriginKeys, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> participationEdgeRootSlots, array<int> participationEdgeExpectedRootIds, array<int> participationEdgeSideSlots, array<int> participationEdgeExpectedCoreIds, array<int> participationEdgeNextByRootIndexes, array<bool> participationEdgeLiveFlags, array<int> sidePhases, array<int> coreIds, array<int> coreGenerationIds, array<bool> coreSlotLiveFlags, array<int> coreLiveSlots, array<float> corePhysicalBottoms, array<float> corePhysicalTops, array<int> corePendingTopologyChildHeadIndexes, array<int> corePendingTopologyChildCounts, array<int> pendingTopologyChildNextIndexes, array<int> pendingTopologyChildOwnerCoreSlots, array<int> pendingTopologyChildExpectedCoreIds, array<int> pendingTopologyChildExpectedGenerationIds, array<int> pendingTopologyChildRootHeadNodeIndexes, array<int> pendingTopologyChildRootCounts, array<bool> pendingTopologyChildLiveFlags, array<int> pendingTopologyRootNodeRootIds, array<int> pendingTopologyRootNodeNextIndexes, array<int> pendingTopologyRootNodeOwnerChildIndexes, array<int> pendingTopologyRootNodeExpectedCoreIds, array<int> pendingTopologyRootNodeExpectedGenerationIds, array<bool> pendingTopologyRootNodeLiveFlags, array<int> candVisitedEpochByRootSlot, array<int> candQueueRootSlots, array<int> candSeedRootIds, int seedCount, array<int> rootIdOrderSlots, array<int> rootCandGeometryRevisions, array<int> rootCandQualityRevisions, array<int> rootCandTieBreakRevisions, array<int> rootCandStateRevisions, array<int> rootCandComponentIds, array<int> rootCandComponentExpectedRootIds, array<int> candComponentIds, array<int> candComponentKinds, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candComponentCfgRevisions, array<int> candComponentStageKeys, array<int> candComponentUsedEpochKeys, array<int> candComponentSupportStatuses, array<int> candComponentResistanceStatuses, array<int> candComponentSupportRecordOffsets, array<int> candComponentSupportRecordLengths, array<int> candComponentResistanceRecordOffsets, array<int> candComponentResistanceRecordLengths, array<int> candComponentSupportSeenOffsets, array<int> candComponentSupportSeenLengths, array<int> candComponentResistanceSeenOffsets, array<int> candComponentResistanceSeenLengths, array<int> candMemberRootIds, array<int> candMemberRoleFlags, array<int> candMemberSideMasks, array<int> candMemberGeometryRevisions, array<int> candMemberQualityRevisions, array<int> candMemberTieBreakRevisions, array<int> candMemberStateRevisions, array<int> candRecordInts, array<float> candRecordReferencePrices, array<int> candRecordRootIds, array<int> candSeenBroadRootIds, array<int> candAffectedComponentIds, array<int> candRemovedComponentIds) =>
    int  buildCode      = COMP_BUILD_OK
    int  outNextId      = nextComponentId
    bool outCacheValid  = cacheValid
    int  outCfgRevision = cacheCfgRevision
    int  outEpoch       = visitEpoch
    int  outAffected    = 0
    int  outRemoved     = 0
    array.clear(candAffectedComponentIds)
    array.clear(candRemovedComponentIds)
    if not (cacheValid and cacheCfgRevision == cfgRevision and seedCount == 0)
        bool failed       = false
        bool fullMode     = not cacheValid or cacheCfgRevision != cfgRevision
        int  workNextId   = nextComponentId
        int  workEpoch    = visitEpoch
        int  rootCount    = array.size(rootIds)
        bool allComputed  = true
        // A. invalid cache: nothing of the old cache is trusted (expected rootIds and the next ID are kept)
        if not cacheValid
            array.clear(candComponentIds)
            array.clear(candComponentKinds)
            array.clear(candComponentMemberOffsets)
            array.clear(candComponentMemberLengths)
            array.clear(candComponentCfgRevisions)
            array.clear(candComponentStageKeys)
            array.clear(candComponentUsedEpochKeys)
            array.clear(candComponentSupportStatuses)
            array.clear(candComponentResistanceStatuses)
            array.clear(candComponentSupportRecordOffsets)
            array.clear(candComponentSupportRecordLengths)
            array.clear(candComponentResistanceRecordOffsets)
            array.clear(candComponentResistanceRecordLengths)
            array.clear(candComponentSupportSeenOffsets)
            array.clear(candComponentSupportSeenLengths)
            array.clear(candComponentResistanceSeenOffsets)
            array.clear(candComponentResistanceSeenLengths)
            array.clear(candMemberRootIds)
            array.clear(candMemberRoleFlags)
            array.clear(candMemberSideMasks)
            array.clear(candMemberGeometryRevisions)
            array.clear(candMemberQualityRevisions)
            array.clear(candMemberTieBreakRevisions)
            array.clear(candMemberStateRevisions)
            array.clear(candRecordInts)
            array.clear(candRecordReferencePrices)
            array.clear(candRecordRootIds)
            array.clear(candSeenBroadRootIds)
            int z = 0
            while z < array.size(rootCandComponentIds)
                array.set(rootCandComponentIds, z, 0)
                z += 1
        failed := rootCount > MAX_PHYSICAL_ARRAY_ELEMENTS or array.size(rootCandComponentIds) < rootCount or array.size(rootCandComponentExpectedRootIds) < rootCount or array.size(rootSlotLiveFlags) < rootCount or seedCount < 0 or seedCount > array.size(candSeedRootIds)
        // B. per-slot scratch: normal Root flag, rebuild candidates, built flag; capable Broad count (capacity bound)
        array<bool> normalBySlot = array.new_bool(0)
        array<bool> rebuildCand  = array.new_bool(0)
        array<bool> built        = array.new_bool(0)
        int capableBroadCount = 0
        if not failed

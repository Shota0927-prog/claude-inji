// W06 B10 Candidate run domains (mirror of the W05 /3 constants; FULL = 0 is never used here) and the W05 record side
// values (SIDE_SUPPORT / SIDE_RESISTANCE of W05 /3)
const int CAND_RUN_DOMAIN_LOCAL_NORMAL = 1
const int CAND_RUN_DOMAIN_BROAD_ONLY   = 2
const int W05_SIDE_SUPPORT             = 1
const int W05_SIDE_RESISTANCE          = -1

// W06 B10: component-limited Candidate Root enumerators. W05 /3 takes every Candidate Root from its Point scratch
// (built from rootPriceOrderSlots) and its FVG scratch (built from rootIdOrderSlots) only, so exactly these two orders
// are filtered. Every entry of the row's member snapshot is validated first (rootId > 0 strictly ascending, role
// MEMBER / INCLUDED_BROAD, rootIdToSlot -> live slot with the same rootId and expected rootId; MEMBER a normal Root,
// INCLUDED_BROAD a capable Broad FVG). Each source order is then walked front to back and a slot is appended when its
// rootId is in the snapshot (binary search over the rootId-ascending slice), keeping the source order exactly.
// Completeness: the filtered price order holds exactly the Point MEMBERs, the filtered ID order holds exactly every
// snapshot Root, no slot twice. Scratch arrays are cleared first; a scratch at MAX_PHYSICAL_ARRAY_ELEMENTS fails.
runFilterOrdersRaw(int row, array<int> candComponentMemberOffsets, array<int> candComponentMemberLengths, array<int> candMemberRootIds, array<int> candMemberRoleFlags, map<int, int> rootIdToSlot, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootIsBroadFvgFlags, array<int> rootCandComponentExpectedRootIds, array<int> rootPriceOrderSlots, array<int> rootIdOrderSlots, array<int> filteredPriceOrderSlots, array<int> filteredIdOrderSlots) =>
    array.clear(filteredPriceOrderSlots)
    array.clear(filteredIdOrderSlots)
    bool ok = row >= 0 and row < array.size(candComponentMemberOffsets) and row < array.size(candComponentMemberLengths)
    int  mOff = 0
    int  mLen = 0
    if ok
        mOff := array.get(candComponentMemberOffsets, row)
        mLen := array.get(candComponentMemberLengths, row)
        ok := mOff >= 0 and mLen >= 0 and mOff + mLen <= array.size(candMemberRootIds) and array.size(candMemberRoleFlags) == array.size(candMemberRootIds)
    int pointMemberCount = 0
    int prevId = 0
    int k = 0
    while ok and k < mLen
        int eId   = array.get(candMemberRootIds, mOff + k)
        int eRole = array.get(candMemberRoleFlags, mOff + k)
        ok := eId > prevId and (eRole == CAND_MEMBER_ROLE_MEMBER or eRole == CAND_MEMBER_ROLE_INCLUDED_BROAD) and map.contains(rootIdToSlot, eId)
        int eSlot = SLOT_INVALID
        if ok
            eSlot := map.get(rootIdToSlot, eId)
            ok := eSlot >= 0 and eSlot < array.size(rootIds) and eSlot < array.size(rootSlotLiveFlags) and eSlot < array.size(rootCandComponentExpectedRootIds) and eSlot < array.size(rootIsBroadFvgFlags)
        if ok
            ok := array.get(rootSlotLiveFlags, eSlot) and array.get(rootIds, eSlot) == eId and array.get(rootCandComponentExpectedRootIds, eSlot) == eId
        if ok
            int eMask = compSideMaskRaw(eSlot, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootPointTicks, rootNativeBottomTicks, rootNativeTopTicks)
            ok := eMask != 0
            if ok
                int  eCategory = array.get(rootCategories, eSlot)
                bool eBroad    = array.get(rootIsBroadFvgFlags, eSlot)
                bool ePoint    = eMask == 3 and (eCategory == CAT_MA or eCategory == CAT_SWING or eCategory == CAT_ACCUM or eCategory == CAT_TIME_HL)
                if eRole == CAND_MEMBER_ROLE_MEMBER
                    ok := ePoint or (eCategory == CAT_FVG and not eBroad)
                    if ok and ePoint
                        pointMemberCount += 1
                else
                    ok := eCategory == CAT_FVG and eBroad

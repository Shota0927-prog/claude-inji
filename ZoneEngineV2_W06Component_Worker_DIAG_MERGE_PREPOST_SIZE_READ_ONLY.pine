        array.clear(mergedRecordReferencePrices)
        array.clear(mergedRecordRootIds)
        mergedStatus := -1
    else
        mergedStatus := array.size(mergedRecordReferencePrices)
    [ok, mergedStatus]

// W06 B12 last run modes (candLastRunMode) and W05 /3 Stage-G defaults (exact copies of the W05 constants)
const int CAND_LAST_RUN_NONE          = 0
const int CAND_LAST_RUN_LOCAL         = 1
const int CAND_LAST_RUN_FULL_FALLBACK = 2
const int W05_SIDE_NONE               = 0
const int W05_CAT_MASK_NONE           = 0
const int W05_CAND_FVG_RANGE_NONE     = 0
const int W05_CAND_POOL_NONE          = 0


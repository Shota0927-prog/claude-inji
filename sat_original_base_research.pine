accMult = input.float(1.2, "[暫定] Accum Max Range / ATR", step = 0.1, minval = 0.1, group = G_ZACCQ)

var string G_ZCLU = "04 · Zone · Cluster / Score"
clusterDist = input.float(20.0, "Cluster Distance ($)", step = 1.0, group = G_ZCLU)
thrMedium   = input.float(5.0,  "Medium Score Threshold",      step = 0.5, group = G_ZCLU)
thrStrong   = input.float(10.0, "Strong Score Threshold",      step = 0.5, group = G_ZCLU)
thrVStrong  = input.float(15.0, "Very Strong Score Threshold", step = 0.5, group = G_ZCLU)

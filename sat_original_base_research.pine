scoreAcc3 = input.float(5.0, "Base Score · TF #3 Accum", step = 0.5, group = G_ZACC)
accKeep1 = input.int(3, "Keep Count · TF #1 Accum", minval = 1, group = G_ZACC)
accKeep2 = input.int(2, "Keep Count · TF #2 Accum", minval = 1, group = G_ZACC)
accKeep3 = input.int(1, "Keep Count · TF #3 Accum", minval = 1, group = G_ZACC)

var string G_ZACCP = "04a · Zone · Accum Box Parameters"
accumRangeLen        = input.int(10,  "Accum判定レンジ本数", minval = 6,  group = G_ZACCP)
accumBaseLen         = input.int(20,  "基準平均本数",        minval = 10, group = G_ZACCP)
accumAtrLen          = input.int(14,  "ATR本数",            minval = 1,  group = G_ZACCP)
accumMinUpperCloses  = input.int(4,   "上半分の最低終値本数", minval = 1,  group = G_ZACCP)
accumMinLowerCloses  = input.int(4,   "下半分の最低終値本数", minval = 1,  group = G_ZACCP)
accumMaxSameColorRun = input.int(4,   "同色連続の上限",      minval = 1,  group = G_ZACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ZACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ZACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ZACCP)

var string G_ZACCQ = "04b · Zone · Provisional ATR Accum (暫定)"
accLen1 = input.int(20, "[暫定] Accum Lookback · TF #1", minval = 3, group = G_ZACCQ)
accLen2 = input.int(20, "[暫定] Accum Lookback · TF #2", minval = 3, group = G_ZACCQ)

lifeExtendOn    = input.bool(true,  "Extend Lifetime on Reaction / Flip", group = G_ZLIFE)
lifeExtendRatio = input.float(0.5,  "Lifetime Extension Ratio", step = 0.1, minval = 0.0, group = G_ZLIFE)
maxPersistZones = input.int(200, "Max Persistent Raw Zones", minval = 20, maxval = 800, group = G_ZLIFE)

var string G_ZSLTP = "04 · Zone · Structural SL / TP"
slBuffer    = input.float(5.0,  "SL Buffer ($)", step = 0.5, group = G_ZSLTP)
tpBuffer    = input.float(0.0,  "TP Buffer ($)", step = 0.5, group = G_ZSLTP)
maxSlDist   = input.float(30.0, "Maximum SL Distance ($)", step = 1.0, group = G_ZSLTP)
minStructRR = input.float(1.0,  "Minimum Structural RR", step = 0.1, group = G_ZSLTP,
     tooltip = "Structural TP が存在する場合、この値未満の RR ならエントリー禁止 (固定RR TPへ逃げない)。")
tpMode = input.string("BOTH", "TP Mode", options = ["BOTH", "STRUCTURAL_ONLY", "FALLBACK_ONLY"], group = G_ZSLTP,
     tooltip = "BOTH            : Structural TP があればそれを使い、無ければ Fallback RR TP。\nSTRUCTURAL_ONLY : Structural TP が存在するトレードのみ発注。\nFALLBACK_ONLY   : Structural TP が存在しなかったシグナルのみ Fallback RR TP で発注。")
slMinScore   = input.float(4.0, "SL Zone Min Score", step = 0.5, group = G_ZSLTP)
slMinStrStr  = input.string("Medium", "SL Zone Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZSLTP)
tpMinScore   = input.float(7.0, "TP Zone Min Score", step = 0.5, group = G_ZSLTP)
tpMinStrStr  = input.string("Strong", "TP Zone Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZSLTP)
obsMinStrStr = input.string("Medium", "Obstacle Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZSLTP)
activeNoTradeMinStrStr = input.string("Medium", "Active Zone NoTrade · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZSLTP)
structuralTpDepthRatio = input.float(0.25, "Structural TP Zone Depth", minval = 0.0, maxval = 1.0, step = 0.25, group = G_ZSLTP,
     tooltip = "Structural TP を TP Zone 内のどの位置に置くかを Zone 幅比率で指定する。Long / Short は完全対称。\n  Long  (Resistance Zone) : 0.00 = Zone下端 / 0.50 = 中央 / 1.00 = Zone上端\n  Short (Support Zone)    : 0.00 = Zone上端 / 0.50 = 中央 / 1.00 = Zone下端")
fallbackRR = input.float(2.0, "Fallback RR", step = 0.1, minval = 0.1, group = G_ZSLTP,
     tooltip = "有効な TP Zone が見つからない場合のみ、Structural SL 距離 × この値で TP を作る。")

// ---- 01-4c Zone 表示 (検証用。Entry 判定には一切使わない) -------------------
var string G_ZDRAW = "04 · Zone 表示 (検証用)"
showZones      = input.bool(false, "Zone Box を表示", group = G_ZDRAW,
     tooltip = "描画の ON / OFF で Strategy Tester 結果は変わらない。\n" +
     "Entry 判定に使うのは Zone Obstacle Filter だけ。")
maxZonesDraw   = input.int(30, "Max Zones Drawn", minval = 1, maxval = 120, group = G_ZDRAW)
zoneLeftBars   = input.int(150, "Zone Box · Left Extension (bars)",  minval = 1, group = G_ZDRAW)
zoneRightBars  = input.int(30,  "Zone Box · Right Extension (bars)", minval = 1, group = G_ZDRAW)
colSupport     = input.color(color.new(#26A69A, 0), "Color · Support",    group = G_ZDRAW)
colResistance  = input.color(color.new(#EF5350, 0), "Color · Resistance", group = G_ZDRAW)
colActive      = input.color(color.new(#FFB300, 0), "Color · Active",     group = G_ZDRAW)
colBroken      = input.color(color.new(#78909C, 0), "Color · Broken",     group = G_ZDRAW)

// ---- 01-4d Zone Distance Research ------------------------------------------
//  ★ これは Filter ではなく Research ★
//    Pattern Signal の条件は一切変えない。Signal 成立時点で「固定 TP までの
//    進行方向にある最寄り Zone までの距離」で 6 グループに分類し、
//    選んだ Bucket だけを Entry させて各グループ単独の成績を比較する。
//
//  ★ 対象外 Bucket でも Setup は消費する (ST_WAIT へ戻す) ★
//    どの Bucket を選んでも Pattern Signal の母集団自体は変わらない。
//    Reset は Section 07 の longActionable / shortActionable を使う。
//
//  ★ Zone Obstacle Filter とは完全に独立 ★
//    Research を ON にしても Obstacle Filter は自動 ON にならない。
//    強度の input も別に持つ (zoneResearchMinStrength)。
var string G_ZRES = "04 · Zone Distance Research"
useZoneDistanceResearch = input.bool(false, "Zone Distance Research を使う", group = G_ZRES,
     tooltip = "★ 記録・集計専用。Entry には一切関与しない ★\n" +
     "ON にしても canLong / canShort は変わらないので、Strategy Tester の\n" +
     "Trade 数 / Entry 位置 / PnL / PF / DD は OFF のときと完全に一致する。\n\n" +
     "実際に Entry した各 Trade へ、その Signal 時点の Zone Bucket を\n" +
     "タグ付けして保持し、決済時に Bucket 別へ損益を集計する。\n" +
     "★ 365日 Deep Backtesting の全 Trade は Entry ID で判別する ★\n" +
     "  ON のとき Entry ID が L-B-Z0_2.5 のように Bucket 付きになる。\n" +
     "  List of Trades を CSV Export し、ID のサフィックスで分類する:\n" +
     "    ZNONE = Zoneなし / ZIN = Zone内 / Z0_2.5 / Z2.5_5 / Z5_7.5 / Z7.5_10\n" +
     "  OFF のときは従来どおり L-A / L-B / S-A / S-B。\n\n" +
     "チャート左下の Research Table は補助表示 (実行された範囲のみ集計)。\n" +
     "6 Bucket の Trades 合計 = Strategy Tester の Total Trades。")

zoneResearchMinStrStr = input.string("Medium", "Research Min Strength",
     options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZRES,
     tooltip = "この強度以上の Zone だけを Research の対象にする。\n" +
     "Zone Obstacle Filter の Obstacle Min Strength とは independent。")

//  Zone 側の計算を回すかどうか。すべて OFF なら request を 1 本も出さない。
bool useZoneFeatures = useZoneObstacleFilter or useZoneDistanceResearch or showZones

// ---- 01-5 Risk -------------------------------------------------------------
var string G_RISK = "05 · Risk"
riskPct     = input.float(1.0, "1トレード損失率 (%)", step = 0.1, minval = 0.0, group = G_RISK)
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = G_RISK)
qtyStep     = input.float(0.01, "Qty 刻み (最小ロット単位)", minval = 0.00000001, step = 0.01, group = G_RISK)
qtyMin      = input.float(0.01, "Qty 最小値 (これ未満はエントリーしない)", minval = 0.0, step = 0.01, group = G_RISK)

// ---- 01-6 表示 -------------------------------------------------------------
var string G_DISP = "06 · 表示"
showBg    = input.bool(true, "SAT 15s 背景を表示", group = G_DISP)
bgBuyCol  = input.color(#068C8C, "青 (Bull) 背景色", group = G_DISP)
bgSellCol = input.color(#F54230, "赤 (Bear) 背景色", group = G_DISP)
bgTransp  = input.int(66, "背景の透明度", minval = 0, maxval = 100, group = G_DISP)
showDebug = input.bool(true, "Debug Table を表示", group = G_DISP)

// ============================================================================
// 02. SAT BAND Reconstruction 計算関数
// ----------------------------------------------------------------------------
//  ★ 計算式は既存最新版 (sat_mtf_strategy.pine) と完全一致 ★
//    見た目を合わせるための補正・追加平滑化・Confirm などは一切入れていない。
//
//    共通   … basis  = ta.vwma(hlc3, 5)
//             common = basis * 0.5
//             atr50  = ta.atr(50)[1]
//             src      = close[1] * 0.5
//             trigLow  = low[1]   * 0.5
//             trigHigh = high[1]  * 0.5
//
//    LINE1  … k = 5.0 の Anchor State 機械   line1 = common + anchor1
//    LINE2  … k = 2.5 の Anchor State 機械   line2 = common + anchor2
//             (構造は LINE1 と同一。違うのは倍率だけ。anchor / dir は完全に別変数)
//
//    STB    … 表示     : ta.highest(high, 10) / ta.lowest(low, 10)
//             方向判定 : ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
//             毎バー high breakout を先に判定し、下抜けは else if。
//             同一バーで上下両方を突破した場合は Bull(+1) 優先。
//
//    背景   … 各ラインの dir は使わず、close と 3 本の位置関係だけで決める。
//             青 (+1) : close > LINE1 かつ close > LINE2 かつ close > STB
//             赤 (-1) : close < LINE1 かつ close < LINE2 かつ close < STB
//             フラット (0) : それ以外
//
//  ■ 計算パラメータは固定値 (input 化していない)
//    VWMA 5 / common 倍率 0.5 / ATR 50 / LINE1 k = 5.0 / LINE2 k = 2.5 /
//    STB 表示 10 本 / STB 転換 20 本
// ============================================================================
f_satRebuild() =>
    // ---- 共通 Basis (SMA でも EMA でもなく VWMA) --------------------------
    float basis  = ta.vwma(hlc3, 5)
    float common = basis * 0.5

    // ---- ATR (ta.atr なので内部は RMA。現在足ではなく 1 本前の値) ---------
    float atr50 = ta.atr(50)[1]

    // ---- Anchor 共通 source と State 反転判定用の値 -----------------------
    //  いずれも 1 本前の足から作る。現在足は使わない。
    float src      = close[1] * 0.5
    float trigLow  = low[1]   * 0.5
    float trigHigh = high[1]  * 0.5

    bool ready = not na(atr50) and not na(src) and not na(trigLow) and not na(trigHigh)

    // ---- LINE1 (k = 5.0) --------------------------------------------------
    //  ※ 同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //    判定前に prevAnchor1 / prevDir1 へ退避してから State を更新する。
    float k1 = 5.0
    var float anchor1 = na
    var int   dir1    = 1
    float prevAnchor1 = anchor1
    int   prevDir1    = dir1
    if ready
        if na(prevAnchor1)
            // 初期化：Bull から開始する
            anchor1 := src - k1 * atr50
            dir1    := 1
        else if prevDir1 == 1
            if trigLow < prevAnchor1
                // Bull → Bear
                dir1    := -1
                anchor1 := src + k1 * atr50
            else
                dir1    := 1
                anchor1 := math.max(prevAnchor1, src - k1 * atr50)
        else
            if trigHigh > prevAnchor1
                // Bear → Bull
                dir1    := 1
                anchor1 := src - k1 * atr50
            else
                dir1    := -1
                anchor1 := math.min(prevAnchor1, src + k1 * atr50)
    float line1 = common + anchor1

    // ---- LINE2 (k = 2.5) --------------------------------------------------
    //  LINE1 と構造は完全に同じ。違うのは倍率だけ。
    //  状態変数は LINE1 とは独立しており、互いを参照しない。
    float k2 = 2.5
    var float anchor2 = na
    var int   dir2    = 1
    float prevAnchor2 = anchor2
    int   prevDir2    = dir2
    if ready
        if na(prevAnchor2)
            // 初期化：Bull から開始する
            anchor2 := src - k2 * atr50
            dir2    := 1
        else if prevDir2 == 1
            if trigLow < prevAnchor2
                // Bull → Bear
                dir2    := -1
                anchor2 := src + k2 * atr50
            else
                dir2    := 1
                anchor2 := math.max(prevAnchor2, src - k2 * atr50)
        else
            if trigHigh > prevAnchor2
                // Bear → Bull
                dir2    := 1
                anchor2 := src - k2 * atr50
            else
                dir2    := -1
                anchor2 := math.min(prevAnchor2, src + k2 * atr50)
    float line2 = common + anchor2

    // ---- STB (Donchian 構造) ----------------------------------------------
    //  LINE1 / LINE2 の State とは完全に独立。互いを参照しない。
    //  ATR / EMA / Supertrend は一切使わない。
    //    表示用     : ta.highest(high, 10) / ta.lowest(low, 10)
    //    方向判定用 : ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //  方向転換は毎バー high breakout を先に判定する。同じ足で上下両方を
    //  突破した場合も else if の構造により Bull(+1) が優先される。
    //  どちらも突破していなければ直前の State を維持する。
    float stbUpper = ta.highest(high, 10)
    float stbLower = ta.lowest(low, 10)
    float prev20High = ta.highest(high, 20)[1]
    float prev20Low  = ta.lowest(low, 20)[1]
    var int stbDir = 1
    if not na(prev20High) and not na(prev20Low)
        if high > prev20High
            stbDir := 1
        else if low < prev20Low
            stbDir := -1
    // UP は下側 (lower10)、DOWN は上側 (upper10) を表示価格にする
    float stb = stbDir == 1 ? stbLower : stbUpper

    // ---- Background State --------------------------------------------------
    //  各ラインの dir ではなく、現在の close と LINE1 / LINE2 / STB の
    //  位置関係だけで決める。判定ソースは close 固定。
    bool allAbove = close > line1 and close > line2 and close > stb
    bool allBelow = close < line1 and close < line2 and close < stb
    int bgState = 0
    if allAbove
        bgState := 1
    else if allBelow
        bgState := -1

    [bgState, line1, dir1, line2, dir2, stb, stbDir, basis, common, atr50, anchor1, anchor2]

// ----------------------------------------------------------------------------
// [SAT] 上位足用ラッパー : 「最後に確定した HTF バー」の背景 State だけを返す
//
//   ★ 内部の [1] と 外側の bgv[1] は目的が違う。どちらも必要 ★
//     内部 [1] (atr50 = ta.atr(50)[1] / src = close[1] * 0.5 など)
//         … Reconstruction の計算式そのもの。SAT の定義の一部。
//     外側 bgv[1]
//         … 「最後に確定した HTF バー」の背景を取り出すためのもの。
//           request.security の中 (HTF の時系列) で適用するので、
//           返るのは必ず確定済み HTF バーの値になる。
//
//   ★ 呼び出し側は barmerge.lookahead_on と組み合わせる (この [1] とセット) ★
//     lookahead_on 単独は未来参照になるので絶対に使わない。
// ----------------------------------------------------------------------------
f_satBgHtf() =>
    [bgRaw, _r1, _r2, _r3, _r4, _r5, _r6, _r7, _r8, _r9, _r10, _r11] = f_satRebuild()
    // タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
    int bgv = bgRaw
    bgv[1]

// ---- 表示用ヘルパー ---------------------------------------------------------
f_bgStr(int b) =>
    b == BG_BLUE ? "青 (BLUE)" : b == BG_RED ? "赤 (RED)" : "フラット (FLAT)"
f_bgCol(int b) =>
    b == BG_BLUE ? bgBuyCol : b == BG_RED ? bgSellCol : color.rgb(149, 152, 161)
f_longStateStr(int s) =>
    s == ST_WAIT ? "WAIT_INITIAL" : s == ST_ARMED ? "ARMED (青)" :
     s == ST_FLAT ? "SAW_FLAT" : "SAW_RED"
f_shortStateStr(int s) =>
    s == ST_WAIT ? "WAIT_INITIAL" : s == ST_ARMED ? "ARMED (赤)" :
     s == ST_FLAT ? "SAW_FLAT" : "SAW_BLUE"

// ============================================================================
// 03. SAT 背景 : 15s (チャート足) / 30s / 1m
// ----------------------------------------------------------------------------
//  すべて同一の f_satRebuild() を使う。時間足ごとに別の近似式は書かない。
//  ★ 15秒で計算したラインは流用していない。request.security() の中で
//    f_satRebuild() そのものを評価しているため、VWMA / ATR / Anchor State /
//    STB State はすべてその時間足自身の OHLC から作られる。
//  ★ 関数内の var (anchor1 / anchor2 / dir1 / dir2 / stbDir) は呼び出し箇所ごとに
//    独立するので、15秒 / 30秒 / 1分の State が混ざることはない。
//  ★ 5分は今回取得しない (元 CURRENT が使っていないため)。
// ============================================================================
[bg15, satL1Line, satL1Dir, satL2Line, satL2Dir, satStbLine, satStbDir,
     satBasis, satCommon, satAtr50, satAnchor1, satAnchor2] = f_satRebuild()

int bg30 = nz(request.security(syminfo.tickerid, satTf30, f_satBgHtf(),
     lookahead = barmerge.lookahead_on), 0)

int bg1m = nz(request.security(syminfo.tickerid, satTf1m, f_satBgHtf(),
     lookahead = barmerge.lookahead_on), 0)

// ============================================================================
// 04. ORIGINAL CURRENT STATE MACHINE
// ----------------------------------------------------------------------------
//  ★ 下の if barConfirmed の中身は、元 sat_mtf_strategy.pine の
//    CURRENT ブロックをそのまま移したもの。1 行も変更していない。
//
//  ★ background[2] / background[1] / background だけの判定はしていない。
//    フラット・赤・青が複数本連続しても成立するよう、明示的な State Machine。
//  ★ LONG と SHORT は完全に別の State を持つ。互いに干渉しない。
//  ★ 判定は確定した15秒足でのみ進める (barstate.isconfirmed)。
//
//  LONG
//    WAIT_INITIAL : 15s青 + 30s青 + 1m青 が同時成立 → ARMED
//                   (この時点では Entry しない。あくまで LONG 待機開始)
//    ARMED        : 青が続く限り ARMED / フラット → SAW_FLAT / 赤 → SAW_RED
//    SAW_FLAT     : フラットが続く限り SAW_FLAT
//                   青 → 【Pattern A Signal】→ ARMED
//                   赤 → SAW_RED
//    SAW_RED      : 赤が続く限り SAW_RED
//                   フラット → 【Pattern B Signal】→ SAW_FLAT
//                   青 → Signal なしで ARMED
//    ※ 待機開始後は 30秒足の色を一切問わない (初期成立条件でのみ 30s青 を使う)。
//    ※ 1分足は Signal 成立まで「青を維持」が必須。確定1分背景が青でなくなった
//      時点で LONG 待機状態・15秒パターン進行状態をすべてリセットする。
//
//  SHORT は完全対称 (青と赤を入れ替えるだけ)。
// ============================================================================
var int longState  = ST_WAIT
var int shortState = ST_WAIT

bool barConfirmed = barstate.isconfirmed

int  lsNext     = longState
bool longSigA   = false
bool longSigB   = false
int  ssNext     = shortState
bool shortSigA  = false
bool shortSigB  = false

if barConfirmed
    // ---- LONG ----------------------------------------------------------
    //  1) 1分足ガード : 待機中に確定1分背景が青でなくなったら全リセット
    if lsNext != ST_WAIT and bg1m != BG_BLUE
        lsNext := ST_WAIT
    //  2) State 遷移
    if lsNext == ST_WAIT
        //  初期成立。この青は Pattern の最初の「青」として数える。
        if bg15 == BG_BLUE and bg30 == BG_BLUE and bg1m == BG_BLUE
            lsNext := ST_ARMED
    else if lsNext == ST_ARMED
        if bg15 == BG_FLAT
            lsNext := ST_FLAT
        else if bg15 == BG_RED
            lsNext := ST_OPP
    else if lsNext == ST_FLAT
        if bg15 == BG_BLUE
            //  青 → フラット(複数本可) → 青
            longSigA := true
            lsNext   := ST_ARMED
        else if bg15 == BG_RED
            lsNext := ST_OPP
    else
        if bg15 == BG_FLAT
            //  青 → 赤(複数本可) → フラット
            longSigB := true
            lsNext   := ST_FLAT
        else if bg15 == BG_BLUE
            lsNext := ST_ARMED

    // ---- SHORT (LONG の完全対称) ---------------------------------------
    if ssNext != ST_WAIT and bg1m != BG_RED
        ssNext := ST_WAIT
    if ssNext == ST_WAIT
        if bg15 == BG_RED and bg30 == BG_RED and bg1m == BG_RED
            ssNext := ST_ARMED
    else if ssNext == ST_ARMED
        if bg15 == BG_FLAT
            ssNext := ST_FLAT
        else if bg15 == BG_BLUE
            ssNext := ST_OPP
    else if ssNext == ST_FLAT
        if bg15 == BG_RED
            //  赤 → フラット(複数本可) → 赤
            shortSigA := true
            ssNext    := ST_ARMED
        else if bg15 == BG_BLUE
            ssNext := ST_OPP
    else
        if bg15 == BG_FLAT
            //  赤 → 青(複数本可) → フラット
            shortSigB := true
            ssNext    := ST_FLAT
        else if bg15 == BG_RED
            ssNext := ST_ARMED

// ============================================================================
// 05. PATTERN MODE → 最終 Signal
// ----------------------------------------------------------------------------
//  ★ Pattern Mode が変えるのは「どの Signal を Order へ渡すか」だけ ★
//    上の State Machine は 3 Mode でまったく同じように進む。
//    PATTERN_B_ONLY でも Pattern A 相当の FLAT → BLUE の State 遷移
//    (longSigA が立って lsNext が ST_ARMED へ戻る) は通常どおり処理する。
//    ただし longSignal には乗せないので Order も Entry Reset も起きない。
//    これで「Pattern A を禁止した状態で Pattern B だけを運用した場合」の
//    実際の Strategy 結果が測れる。
// ============================================================================
bool longSignal  = patternMode == MODE_A ? longSigA  :
     patternMode == MODE_B ? longSigB  : (longSigA  or longSigB)
bool shortSignal = patternMode == MODE_A ? shortSigA :
     patternMode == MODE_B ? shortSigB : (shortSigA or shortSigB)

//  Entry ID を分けるための Pattern 種別 (0 = なし / 1 = A / 2 = B)
//  Mode ALL で同一バーに A と B が同時成立することは State Machine 上ない
//  (A は ST_FLAT からの青、B は ST_OPP からのフラットで State が排他のため)。
int longEntryPattern  = longSignal  ? (longSigA  ? 1 : 2) : 0
int shortEntryPattern = shortSignal ? (shortSigA ? 1 : 2) : 0

// ============================================================================
// 05b. ZONE ENGINE  (Zone Obstacle Filter 用 / Base TF = 5分)
// ----------------------------------------------------------------------------
//  ZoneEngine v10 (Base TF 対応版) を使う。
//  Zone 生成 / Score / Strength / Break / Flip / Reaction Bonus /
//  Structural SL・TP の条件式は v9 から一切変更していない。
//  変わったのは「Zone State 更新がどの足の high / low / close / time /
//  bar_index を見るか」だけで、それを ZoneFeed の base* から受け取る。
//
//  ★ SAT Entry = 15秒足 / Zone = Base TF (5分) の完全分離 ★
//    ・Zone Map / Zone State      … Base TF 5分基準
//    ・Structural SL / TP 候補Zone … Base TF 5分基準
//    ・TradePlan の entryPrice     … SAT Pattern 成立時の15秒 close
//    zn.buildPlanWithTpDepth() は built-in を 1 つも参照せず、引数の
//    entryPrice と Zone のフィールドだけで判定するため、この組み合わせが成立する。
//
//  ★ Zone Obstacle Filter も Zone 表示も OFF のときは request.security を
//    1 本も発行しない (計算負荷ゼロ)。useZoneObstacleFilter / showZones は
//    input なので、この分岐は全バーで同じ = ta 状態がずれることはない。
//
//  ★ Zone は Entry 根拠にも SL/TP にも使わない ★
//    zn.buildPlan() / zn.buildPlanWithTpDepth() は呼ばない。
//    Zone Map は「固定 TP までの進行方向に障害物があるか」だけに使う。
// ============================================================================
var zn.ZoneEngine zoneEng = zn.newEngine()

zn.ZoneCfg zoneCfg = zn.newCfg()
zoneCfg.zoneHalfWidth        := zoneHalfWidth
zoneCfg.useMaSource          := useMaSource
zoneCfg.maTfName             := maTf
zoneCfg.ma1Len               := ma1Len
zoneCfg.ma2Len               := ma2Len
zoneCfg.scoreMa1             := scoreMa1
zoneCfg.scoreMa2             := scoreMa2
zoneCfg.slopeThrMod          := slopeThrMod
zoneCfg.slopeThrStrong       := slopeThrStrong
zoneCfg.slopeBonusFlat       := slopeBonusFlat
zoneCfg.slopeBonusMod        := slopeBonusMod
zoneCfg.slopeBonusStr        := slopeBonusStr
zoneCfg.slopeBonusMax        := slopeBonusMode == "Max"
zoneCfg.maClusterDist        := maClusterDist
zoneCfg.maClusterBonus       := maClusterBonus
zoneCfg.maClusterDirBonus    := maClusterDirBonus
zoneCfg.useHzSource          := useHzSource
zoneCfg.hzTf1                := hzTf1
zoneCfg.hzTf2                := hzTf2
zoneCfg.hzTf3                := hzTf3
zoneCfg.scoreHz1             := scoreHz1
zoneCfg.scoreHz2             := scoreHz2
zoneCfg.scoreHz3             := scoreHz3
zoneCfg.reactionDist         := reactionDist
zoneCfg.reactionBonus1       := reactionBonus1
zoneCfg.reactionBonus2       := reactionBonus2
zoneCfg.reactionBonus3       := reactionBonus3
zoneCfg.reactionRearmDist    := reactionRearmDist
zoneCfg.reactionAllSrc       := reactionAllSrc
zoneCfg.useDayHL             := useDayHL
zoneCfg.scoreDayHL           := scoreDayHL
zoneCfg.carryPrevDayHL       := carryPrevDayHL
zoneCfg.scorePrevDayHL       := scorePrevDayHL
zoneCfg.lifePrevDayHL        := lifePrevDayHL
zoneCfg.useAccSource         := useAccSource
zoneCfg.accTf1               := accTf1
zoneCfg.accTf2               := accTf2
zoneCfg.accTf3               := accTf3
zoneCfg.scoreAcc1            := scoreAcc1
zoneCfg.scoreAcc2            := scoreAcc2
zoneCfg.scoreAcc3            := scoreAcc3
zoneCfg.accKeep1             := accKeep1
zoneCfg.accKeep2             := accKeep2
zoneCfg.accKeep3             := accKeep3
zoneCfg.clusterDist          := clusterDist
zoneCfg.thrMedium            := thrMedium
zoneCfg.thrStrong            := thrStrong
zoneCfg.thrVStrong           := thrVStrong
zoneCfg.confBonus2           := confBonus2
zoneCfg.confBonus3           := confBonus3
zoneCfg.confBonus4           := confBonus4
zoneCfg.flipBonus            := flipBonus
zoneCfg.requireHtfForVStrong := requireHtfForVStrong
zoneCfg.htfSwing1H           := htfSwing1H
zoneCfg.htfAccum1H           := htfAccum1H
zoneCfg.htfAccum4H           := htfAccum4H
zoneCfg.htfAccumD            := htfAccumD
zoneCfg.htfSwing15M          := htfSwing15M
zoneCfg.htfMa1               := htfMa1
zoneCfg.htfMa2               := htfMa2
zoneCfg.htfDayHL             := htfDayHL
zoneCfg.breakBuffer          := breakBuffer
zoneCfg.flipConfirmDist      := flipConfirmDist
zoneCfg.resetOnReclaim       := resetOnReclaim
zoneCfg.trackStaleBars       := trackStaleBars
zoneCfg.trackContinuity      := trackContinuity
zoneCfg.lifeHz1              := lifeHz1
zoneCfg.lifeHz2              := lifeHz2
zoneCfg.lifeHz3              := lifeHz3
zoneCfg.lifeExtendOn         := lifeExtendOn
zoneCfg.lifeExtendRatio      := lifeExtendRatio
zoneCfg.maxPersistZones      := maxPersistZones
zoneCfg.slBuffer             := slBuffer
zoneCfg.tpBuffer             := tpBuffer
zoneCfg.maxSlDist            := maxSlDist
zoneCfg.minStructRR          := minStructRR
zoneCfg.slMinScore           := slMinScore
zoneCfg.slMinStrength        := zn.strengthIdx(slMinStrStr)
zoneCfg.tpMinScore           := tpMinScore
zoneCfg.tpMinStrength        := zn.strengthIdx(tpMinStrStr)
zoneCfg.obsMinStrength       := zn.strengthIdx(obsMinStrStr)
zoneCfg.activeNoTradeMinStrength := zn.strengthIdx(activeNoTradeMinStrStr)
zoneCfg.structuralTpDepthRatio   := structuralTpDepthRatio
zoneCfg.fallbackRR           := fallbackRR

// ----------------------------------------------------------------------------
//  Zone Feed (外部足の取得はすべてここ)
// ----------------------------------------------------------------------------
//  ★ Zone は Base TF (既定 5分) 1 本につき 1 回だけ更新する ★
//
//  更新対象は「直前に確定した Base TF 足」= 論理バー N。
//  処理するチャートバーは「N が閉じた直後の最初の15秒足」= newBaseBar。
//  15秒足の毎バー zn.update() を呼ぶことは絶対にしない。
//
//  ■ Source 系のサンプリング位相 (元 5分 Strategy と一致させるため)
//    元 5分 Strategy は 5分バー N の時点で各 Source を
//      request.security(<SourceTF>, ..., lookahead_off)
//    で読んでいた。その値は「バー N の終了時刻」に見えていた値。
//
//    15秒チャートで同じ値を得るには、newBaseBar の 1 本前の15秒足
//    (= バー N の最後の15秒足。その終値時刻 = バー N の終了時刻) の値を使う。
//    したがって Source 系はすべて <raw>[1] を Feed へ渡す。
//
//      例) 5分足 12:00〜12:04:59 が確定
//          → newBaseBar は 12:05:00〜12:05:14 の15秒足
//          → その [1] は 12:04:45〜12:04:59 の15秒足 = 12:04:59 時点の値
//          → 5分チャートでバー N が確定した瞬間に見えていた値と一致する
//
//    ★ MA / Swing / Accum の「計算そのもの」は従来どおりそれぞれの本来の TF
//      (MA 1分 / Swing 5分・15分・1時間 / Accum 1時間・4時間・日足) で行う。
//      Base TF 化するのは ZoneEngine が「現在足」として直接参照していた部分だけ。
//
//  ■ 形成中の Base TF 足は一切使わない
//    12:03:45 に SAT Entry が出ても、12:00 の5分足はまだ形成中なので Zone へ
//    反映されていない。使われるのは 11:55〜11:59:59 までの確定情報で
//    作られた Zone Map。そこへ 12:03:45 の15秒 Entry 価格を渡して
//    Structural SL / TP を決める。
// ----------------------------------------------------------------------------

// ---- Base TF 足の確定値 ----------------------------------------------------
//  [1] を request.security の「内部」(Base TF の時系列) で掛けているので、
//  返るのは必ず「確定済みの Base TF 足」。lookahead_on は必ずこの [1] とセット。
//  単独の lookahead_on は未来参照になるので使わない。
//
//    [1] → 論理バー N      (Zone State 更新に使う現在足)
//    [2] → 論理バー N-1    (Break 判定に使う確定足)
//
//  ★ Break の位相について
//    元 5分 Strategy は 5分バー N で brBarClosed = true とし、
//    brClose = brCloseRaw[1] = バー N-1 の終値 を使って Break を判定していた。
//    (Reaction / Natural State / Day H/L はバー N、Break だけバー N-1 という混在)
//    本実装もその位相をそのまま再現する。
f_baseTfPack() =>
    [open[1], high[1], low[1], close[1], close[2], time[1], high[2], low[2]]

float bOpen      = na
float bHigh      = na
float bLow       = na
float bClose     = na
float bPrevClose = na
int   bTime      = na
float bPrevHigh  = na
float bPrevLow   = na
if useZoneFeatures
    [_bo, _bh, _bl, _bc, _bpc, _bt, _bph, _bpl] = request.security(syminfo.tickerid, zoneBaseTf,
         f_baseTfPack(), lookahead = barmerge.lookahead_on)
    bOpen      := _bo
    bHigh      := _bh
    bLow       := _bl
    bClose     := _bc
    bPrevClose := _bpc
    bTime      := _bt
    bPrevHigh  := _bph
    bPrevLow   := _bpl

// ---- 新しい Base TF 足の確定検出 + Zone 用の論理 bar sequence ---------------
//  time(zoneBaseTf) は request.security ではないので毎バー無条件に評価してよい。
//  Base TF 期間が切り替わった最初の15秒足で true になる = その直前の Base TF 足が確定した。
int  baseTfChg  = nz(ta.change(time(zoneBaseTf)), 0)
bool newBaseBar = useZoneFeatures and bar_index > 0 and baseTfChg != 0

//  Base TF 足 1 本につき +1。ZoneEngine の createdBar / breakBar / lastSeenBar /
//  trackStaleBars はすべてこの論理 bar 番号で動く。
//  → trackStaleBars = 500 は「Base TF 500本」の意味になる (15秒足500本ではない)。
var int zoneBaseSeq = 0
if newBaseBar
    zoneBaseSeq := zoneBaseSeq + 1

// ---- MA Source (MA TF = 1分 のまま。計算は 1分足 close から) ---------------
float ma1Raw  = na
float ma1dRaw = na
float ma2Raw  = na
float ma2dRaw = na
if useZoneFeatures and useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(zMaType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Raw  := _m1
    ma1dRaw := _m1d
    ma2Raw  := _m2
    ma2dRaw := _m2d

// ---- Horizontal Source (Swing) : 5分 / 15分 / 1時間 のまま -----------------
float ph1Raw = na
int   ph1tRaw = na
float pl1Raw = na
int   pl1tRaw = na
float ph2Raw = na
int   ph2tRaw = na
float pl2Raw = na
int   pl2tRaw = na
float ph3Raw = na
int   ph3tRaw = na
float pl3Raw = na
int   pl3tRaw = na
if useZoneFeatures and useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1Raw  := _h1
    ph1tRaw := _h1t
    pl1Raw  := _l1
    pl1tRaw := _l1t
    ph2Raw  := _h2
    ph2tRaw := _h2t
    pl2Raw  := _l2
    pl2tRaw := _l2t
    ph3Raw  := _h3
    ph3tRaw := _h3t
    pl3Raw  := _l3
    pl3tRaw := _l3t

// ---- Accumulation Source : 1時間 / 4時間 / 日足 のまま ---------------------
bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1HiRaw = na
float acc1LoRaw = na
int   acc1IdRaw = na
float acc2HiRaw = na
float acc2LoRaw = na
int   acc2IdRaw = na
float acc3HiRaw = na
float acc3LoRaw = na
int   acc3IdRaw = na
if useZoneFeatures and useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)
    acc1HiRaw := _a1h
    acc1LoRaw := _a1l
    acc1IdRaw := _a1i
    acc2HiRaw := _a2h
    acc2LoRaw := _a2l
    acc2IdRaw := _a2i
    acc3HiRaw := _a3h
    acc3LoRaw := _a3l
    acc3IdRaw := _a3i

// ---- 取引日ID ---------------------------------------------------------------
//  ★ Base TF 足の time から計算する (チャート足の time ではない)。
//    これにより Day High / Low の日付切り替わりも Base TF 足で起きる。
//  ※ timestamp() / hour() の timezone 引数は series 修飾子を受け付けないため、
//    タイムゾーン計算だけは Library ではなくここで行う (元 Strategy と同じ)。
//  ※ ウォームアップ中 (bTime が na) の値は使わない。下の update() を
//    not na(bTime) でガードしているため、ここでの nz() は計算エラー回避のみが目的。
int bTimeSafe    = nz(bTime, time)
int _locY        = year(bTimeSafe, dayTz)
int _locM        = month(bTimeSafe, dayTz)
int _locD        = dayofmonth(bTimeSafe, dayTz)
int _locH        = hour(bTimeSafe, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

// ---- ZoneFeed ---------------------------------------------------------------
//  Source 系は [1] (= 論理バー N の終了時刻に見えていた値)。
//  base* は Base TF の確定足 (論理バー N)。
//  br* は Break 判定用の Base TF 確定足 (論理バー N-1)。
zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Raw[1], ma1d = ma1dRaw[1], ma2 = ma2Raw[1], ma2d = ma2dRaw[1],
     ph1 = ph1Raw[1], ph1t = ph1tRaw[1], pl1 = pl1Raw[1], pl1t = pl1tRaw[1],
     ph2 = ph2Raw[1], ph2t = ph2tRaw[1], pl2 = pl2Raw[1], pl2t = pl2tRaw[1],
     ph3 = ph3Raw[1], ph3t = ph3tRaw[1], pl3 = pl3Raw[1], pl3t = pl3tRaw[1],
     acc1Hi = acc1HiRaw[1], acc1Lo = acc1LoRaw[1], acc1Id = acc1IdRaw[1],
     acc2Hi = acc2HiRaw[1], acc2Lo = acc2LoRaw[1], acc2Id = acc2IdRaw[1],
     acc3Hi = acc3HiRaw[1], acc3Lo = acc3LoRaw[1], acc3Id = acc3IdRaw[1],
     dayId = tradingDayId,
     brClose = bPrevClose, brHigh = bPrevHigh, brLow = bPrevLow,
     brEval  = zoneBaseSeq > 1 and not na(bPrevClose),
     baseOpen = bOpen, baseHigh = bHigh, baseLow = bLow, baseClose = bClose,
     basePrevClose = bPrevClose, baseTime = bTime, baseBarSeq = zoneBaseSeq)

// ---- Zone 更新 : Base TF 足 1 本につき 1 回だけ -----------------------------
//  ★ ここが 15秒足の毎バーで走らないことが本実装の要点。
//  ★ zoneCountNow は var。更新しないバーでは直前の Zone 数を保持する。
var int zoneCountNow  = 0
var int zoneUpdateCnt = 0
if newBaseBar and not na(bTime) and not na(bClose)
    zoneCountNow  := zn.update(zoneEng, zoneCfg, zoneFeed)
    zoneUpdateCnt := zoneUpdateCnt + 1

// ============================================================================
// 05c. ZONE OBSTACLE FILTER
// ----------------------------------------------------------------------------
//  Signal 成立後、Entry から固定 TP までの進行方向に「障害物」があるかだけを見る。
//  Zone を Entry 根拠には使わない。SL / TP も変えない。
//
//  ★ 障害物として扱う Zone ★
//    LONG  … state == ST_RESIST  (Resistance)
//    SHORT … state == ST_SUPPORT (Support)
//    初回検証では ST_ACTIVE / ST_BROKEN は障害物にしない。
//    強度は zoneObstacleMinStrength 以上のものだけ。Score 条件は使わない。
//
//  ★ Zone の中心ではなく「Entry 側の端」を最初にぶつかる価格として使う ★
//    LONG  … Resistance の下端 z.bottom
//    SHORT … Support   の上端 z.top
//
//  ★ 判定 (LONG。SHORT は不等号を反転した完全対称) ★
//    ケース A : entryPrice < z.bottom < tpPrice
//               → TP より先に Resistance へ到達するので BLOCK
//    ケース B : z.bottom <= entryPrice <= z.top  (Entry が Zone 内)
//               → 距離 0 で即 BLOCK
//    ケース C : z.bottom >= tpPrice
//               → 固定 TP の方が先なので BLOCK しない
//
//  ★ 「最寄り」を取る ★
//    Zone が 1 個でもあるか、ではなく進行方向で最も近い対象 Zone を選ぶ。
//    LONG  … Entry より上の Resistance のうち最小の z.bottom
//    SHORT … Entry より下の Support   のうち最大の z.top
//    Entry が Zone 内部なら nearestEdge = entryPrice / distance = 0。
//
//  戻り値 : [blocked, nearestEdge, distance, strength, zoneTop, zoneBottom]
//           対象 Zone がなければ blocked = false / それ以外は na。
// ============================================================================
int zoneObstacleMinStrength = zn.strengthIdx(zoneObstacleMinStrStr)

f_zoneObstacle(int dir, float entryPrice, float tpPrice) =>
    bool  blocked     = false
    float nearestEdge = na
    float distance    = na
    int   strength    = na
    float zoneTop     = na
    float zoneBottom  = na
    int   n = zn.zoneCount(zoneEng)
    if n > 0 and not na(entryPrice) and not na(tpPrice)
        for i = 0 to n - 1
            zn.Zone z = zn.zoneAt(zoneEng, i)
            //  方向ごとの対象 State と強度でふるいにかける
            bool targetState = dir > 0 ? z.state == ST_RESIST : z.state == ST_SUPPORT
            if targetState and z.strength >= zoneObstacleMinStrength and
                 not na(z.top) and not na(z.bottom)
                //  Entry が Zone 内部なら距離 0 で即 BLOCK
                bool inside = entryPrice >= z.bottom and entryPrice <= z.top
                //  Entry 側の端 : LONG は下端 / SHORT は上端
                float edge = dir > 0 ? z.bottom : z.top
                //  TP より手前にあるか
                bool ahead = dir > 0 ? (edge > entryPrice and edge < tpPrice)
                     : (edge < entryPrice and edge > tpPrice)
                if inside
                    //  距離 0 は常に最寄り。無条件で上書きする。
                    if na(distance) or distance > 0
                        blocked     := true
                        nearestEdge := entryPrice
                        distance    := 0.0
                        strength    := z.strength
                        zoneTop     := z.top
                        zoneBottom  := z.bottom
                else if ahead
                    float d = math.abs(edge - entryPrice)
                    if na(distance) or d < distance
                        blocked     := true
                        nearestEdge := edge
                        distance    := d
                        strength    := z.strength
                        zoneTop     := z.top
                        zoneBottom  := z.bottom
    [blocked, nearestEdge, distance, strength, zoneTop, zoneBottom]

//  Signal 成立時の価格と固定 TP。SL / TP そのものは 07 で従来どおり決める。
float longTpPrice  = close + fixedTpDollar
float shortTpPrice = close - fixedTpDollar

[longBlocked,  longObsEdge,  longObsDist,  longObsStr,  longObsTop,  longObsBottom]  =
     f_zoneObstacle(1,  close, longTpPrice)
[shortBlocked, shortObsEdge, shortObsDist, shortObsStr, shortObsTop, shortObsBottom] =
     f_zoneObstacle(-1, close, shortTpPrice)

//  ★ Filter OFF なら常に PASS ★
//    OFF のときは Zone 側の request も 1 本も出ないので Zone Map は空のまま。
//    どちらにしても Entry 判定は Filter 追加前と完全に同じになる。
bool longZonePass  = not useZoneObstacleFilter or not longBlocked
bool shortZonePass = not useZoneObstacleFilter or not shortBlocked

// ============================================================================
// 05d. ZONE DISTANCE RESEARCH
// ----------------------------------------------------------------------------
//  ★ Filter ではなく Research ★
//    Pattern Signal の条件は一切変えない。Signal 成立時点で「固定 TP までの
//    進行方向にある最寄り Zone までの距離」だけを見て 6 グループへ分類する。
//
//  ★ 対象 Zone ★
//    LONG  … state == ST_RESIST  (Resistance)
//    SHORT … state == ST_SUPPORT (Support)
//    ST_ACTIVE / ST_BROKEN は対象外。
//    強度は zoneResearchMinStrength 以上のものだけ。
//    ★ Zone Obstacle Filter の zoneObstacleMinStrength とは別 input ★
//
//  ★ 距離 ★
//    Entry 価格から対象 Zone の「Entry 側の端」までの距離。
//      LONG  … Resistance の下端 (bottom) − entryPrice
//      SHORT … entryPrice − Support の上端 (top)
//    Zone 中心は使わない。
//
//  ★ Zone内を最優先 ★
//    対象 Zone のうち 1 つでも bottom <= entryPrice <= top なら、
//    他にどんな距離の Zone があっても Bucket = Zone内 / 距離 0 とする。
//    これにより Zone内 は距離 Bucket と絶対に重複しない。
//
//  ★ 固定 TP より先の Zone は無視 ★
//    「TP までの障害物」を見る研究なので distance <= tpDistance のものだけを
//    最寄り候補にする。TP より先にしか Zone がなければ Bucket = Zoneなし。
//
//  ★ Bucket (優先順) ★
//    1 Zone内     : distance == 0
//    2 $0〜2.5    : 0 < distance <= 2.5
//    3 $2.5〜5    : 2.5 < distance <= 5.0
//    4 $5〜7.5    : 5.0 < distance <= 7.5
//    5 $7.5〜10   : 7.5 < distance <= tpDistance
//    0 Zoneなし   : Zone内でもなく、tpDistance 以内に対象 Zone がない
//    各 Signal は必ず 1 つの Bucket だけに所属する。
//
//  戻り値 : [bucket, nearestDistance, nearestEdge, nearestStrength,
//            nearestTop, nearestBottom]
// ============================================================================
int zoneResearchMinStrength = zn.strengthIdx(zoneResearchMinStrStr)

f_zoneDistanceBucket(int dir, float entryPrice, float tpDistance) =>
    int   bucket     = ZB_NONE
    float distance   = na
    float edge       = na
    int   strength   = na
    float zoneTop    = na
    float zoneBottom = na
    bool  inside     = false
    int   n = zn.zoneCount(zoneEng)
    if n > 0 and not na(entryPrice) and not na(tpDistance)
        for i = 0 to n - 1
            zn.Zone z = zn.zoneAt(zoneEng, i)
            bool targetState = dir > 0 ? z.state == ST_RESIST : z.state == ST_SUPPORT
            if targetState and z.strength >= zoneResearchMinStrength and
                 not na(z.top) and not na(z.bottom)
                if entryPrice >= z.bottom and entryPrice <= z.top
                    //  Zone内 は最優先。最初に見つかったものを採用する。
                    if not inside
                        inside     := true
                        distance   := 0.0
                        edge       := entryPrice
                        strength   := z.strength
                        zoneTop    := z.top
                        zoneBottom := z.bottom
                else if not inside
                    //  Entry 側の端 : LONG は下端 / SHORT は上端
                    float e = dir > 0 ? z.bottom : z.top
                    //  進行方向にあり、かつ固定 TP 以内のものだけ
                    float d = dir > 0 ? e - entryPrice : entryPrice - e
                    if d > 0 and d <= tpDistance
                        if na(distance) or d < distance
                            distance   := d
                            edge       := e
                            strength   := z.strength
                            zoneTop    := z.top
                            zoneBottom := z.bottom
    //  Bucket 判定
    if inside
        bucket := ZB_INSIDE
    else if na(distance)
        bucket := ZB_NONE
    else if distance <= 2.5
        bucket := ZB_0_2_5
    else if distance <= 5.0
        bucket := ZB_2_5_5
    else if distance <= 7.5
        bucket := ZB_5_7_5
    else
        bucket := ZB_7_5_10
    [bucket, distance, edge, strength, zoneTop, zoneBottom]

[longBucket,  longResDist,  longResEdge,  longResStr,  longResTop,  longResBottom]  =
     f_zoneDistanceBucket(1,  close, fixedTpDollar)
[shortBucket, shortResDist, shortResEdge, shortResStr, shortResTop, shortResBottom] =
     f_zoneDistanceBucket(-1, close, fixedTpDollar)

//  Entry ID へ埋め込む Bucket サフィックス
//  ★ TradingView の Deep Backtesting 365日分は Research Table では集計できない ★
//    (Table はチャート上で実行された範囲しか見られない)。
//    そこで実際に Entry した Trade の Entry ID へ Bucket を埋め込み、
//    List of Trades の CSV Export から全 Trade の Bucket を判別できるようにする。
f_bucketSuffix(int bucket) =>
    bucket == ZB_NONE   ? "ZNONE" :
     bucket == ZB_INSIDE ? "ZIN" :
     bucket == ZB_0_2_5  ? "Z0_2.5" :
     bucket == ZB_2_5_5  ? "Z2.5_5" :
     bucket == ZB_5_7_5  ? "Z5_7.5" : "Z7.5_10"

//  ★ Bucket は Entry を一切制限しない (Entry Gate は持たない) ★
//    Bucket で Entry を絞ると、Bucket ごとにポジション保有状態が変わり、
//    longActionable に含まれる flat = strategy.position_size == 0 の結果まで
//    変わってしまう。それでは「元の Pattern B の同一母集団を 6 Bucket へ
//    分解する」という研究目的を満たせない。
//    そのため Bucket は「実際に Entry した Trade へのタグ」としてだけ使い、
//    決済時に Bucket 別へ損益を集計する (Section 07b)。

// ============================================================================
// 06. RISK / QTY
// ----------------------------------------------------------------------------
//  Qty は必ず SL 距離から計算する。Long / Short 共通。
//    Risk Capital ÷ SL距離 ÷ syminfo.pointvalue → qtyStep 単位に切り下げ
// ============================================================================
f_baseCapital() =>
    useCompound ? strategy.equity : strategy.initial_capital

f_riskCapital() =>
    f_baseCapital() * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? f_riskCapital() / (riskPerUnit * syminfo.pointvalue) : 0.0
    float q = qtyStep > 0 ? math.floor(raw / qtyStep) * qtyStep : raw
    math.round(q, 8)

float tradeQty = f_qty(fixedSlDollar)

// ============================================================================
// 07. ORDER + Entry 成功時 Reset
// ----------------------------------------------------------------------------
//  ・最大同時保有 1 (ポジションを持っている間は新規 Entry しない)
//  ・SL / TP は固定。Entry 時の close から $ 距離で決める
//  ・Entry ID は Pattern 別 : L-A / L-B / S-A / S-B
//    SL / TP も from_entry で対応させる
//
//  ★ Entry 成功時の Reset は元 CURRENT と同じ挙動 ★
//    実際に Entry 注文を出せたときだけ、その方向の State を ST_WAIT へ戻す。
//    Base Signal が出ただけでは強制リセットしない。ポジション保有中 /
//    Qty 不足などで Entry できなかった場合は、State Machine の自然な次 State
//    (Pattern A なら ARMED / Pattern B なら SAW_FLAT) のまま継続する。
//    ★ Pattern Mode で除外された Signal でも Entry Reset は起きない。
//      longSignal / shortSignal に乗っていないため canLong / canShort が
//      false になり、下の Reset 条件を通らない。
//    ★ Zone Obstacle Filter で BLOCK された場合は Reset する ★
//      canLong / canShort が false になるので実注文は出ないが、
//      Pattern Signal が成立した時点でその Setup は消費済みとみなし、
//      その方向の State を ST_WAIT へ戻す (下の longActionable を参照)。
//      longSigA / longSigB / longSignal 自体は false にしないので、
//      Data Window で「Signal は出たが Zone で BLOCK された」ことを
//      確認できる。
// ============================================================================
bool flat     = strategy.position_size == 0
bool qtyOk    = tradeQty >= qtyMin and tradeQty > 0

//  Zone Filter を除いた「本来なら Entry できたはず」の条件。
//  Zone で BLOCK されても Setup は消費するので、Reset はこちらを使う。
bool longActionable  = longSignal  and enableLong  and flat and qtyOk
bool shortActionable = shortSignal and enableShort and flat and qtyOk

bool canLong  = longActionable  and longZonePass
bool canShort = shortActionable and shortZonePass

//  ★ Entry ID への Bucket 埋め込み ★
//    Research ON のときだけ  L-B-Z0_2.5 のように Bucket サフィックスを付ける。
//    OFF のときは従来どおり L-A / L-B / S-A / S-B のまま。
//    これで Research OFF の Strategy Tester 結果は完全に従来と同一になる。
//
//    ★ Bucket は ID の文字列に入るだけで、Entry 可否には一切関与しない ★
//      canLong / canShort は上で確定済み。ここでは ID を組み立てるだけなので、
//      Research の ON / OFF で Trade 数 / Entry 位置 / PnL / PF / DD は変わらない。
//      (毎回 flat のときだけ Entry し、strategy.exit は from_entry で
//       同じ ID に紐づけているため、ID 文字列が変わっても約定は変わらない)
if canLong
    string pfx = longEntryPattern == 1 ? "L-A" : "L-B"
    string eid = useZoneDistanceResearch ? pfx + "-" + f_bucketSuffix(longBucket) : pfx
    strategy.entry(eid, strategy.long, qty = tradeQty)
    strategy.exit(eid + "-X", from_entry = eid,
         stop = close - fixedSlDollar, limit = close + fixedTpDollar)

if canShort
    string pfx = shortEntryPattern == 1 ? "S-A" : "S-B"
    string eid = useZoneDistanceResearch ? pfx + "-" + f_bucketSuffix(shortBucket) : pfx
    strategy.entry(eid, strategy.short, qty = tradeQty)
    strategy.exit(eid + "-X", from_entry = eid,
         stop = close + fixedSlDollar, limit = close - fixedTpDollar)

//  Pattern Signal が成立した時点でその Setup は消費済みとする。
//  次の Signal には再度 15s + 30s + 1m の初期成立を要求する。
//
//  ★ Zone Obstacle Filter で BLOCK された場合も Reset する ★
//    Zone PASS  → Entry する      → ST_WAIT
//    Zone BLOCK → Entry しない    → ST_WAIT
//    どちらも Setup は消費される。BLOCK 後に同じ Setup の続きから
//    再び Pattern B / Pattern A を出すことはない。
//
//  ★ longActionable は Zone Filter を除いた Entry 可否 ★
//    canLong (Zone PASS で Entry) と「Zone BLOCK で Entry せず」の和集合が
//    ちょうど longActionable になる (longZonePass と Zone BLOCK は排他のため)。
//
//  ★ 既存仕様を変えていない範囲 ★
//    ・ポジション保有中 (flat == false)
//    ・Qty 不足 (qtyOk == false)
//    ・方向 OFF (enableLong / enableShort == false)
//    ・Pattern Mode で除外された Signal (longSignal に乗らない)
//    これらは longActionable が false になるので従来どおり Reset しない。
//    State Machine が返した自然な次 State のまま継続する。
//    今回追加した Reset は「Zone Obstacle Filter が最終的に BLOCK した場合」だけ。
//
//  ★ Zone Distance Research は Reset に一切関与しない ★
//    Research は Entry を制限しないので、追加の Reset も不要。
//    元 Baseline の Entry / Reset をそのまま維持する。
//
//  ★ Zone Filter が OFF のときは longZonePass が常に true なので
//    longActionable == canLong となり、Reset 条件は Filter 追加前と完全に同じ。
if longActionable
    lsNext := ST_WAIT
if shortActionable
    ssNext := ST_WAIT

longState  := lsNext
shortState := ssNext

// ============================================================================
// 07b. ZONE DISTANCE RESEARCH : Trade タグ付けと Bucket 別集計
// ----------------------------------------------------------------------------
//  ★ ここは記録と集計だけ。Entry / Exit / State には一切関与しない ★
//    Bucket で Entry を絞らないので、Research の ON / OFF で Strategy Tester の
//    Trade 数 / Entry 位置 / PnL / PF / DD は完全に一致する。
//
//  ★ 仕組み ★
//    1) 実際に Entry した瞬間に、その Signal 時点の Bucket を配列へ push する。
//       最大同時保有 1 なので Entry 順 == 決済順。したがって配列の index は
//       strategy.closedtrades の index とそのまま対応する。
//    2) strategy.closedtrades が増えたら、その Trade の profit を取り出し、
//       push しておいた Bucket のカウンタへ加算する。
//
//  ★ 決済処理を Entry より前に置く理由 ★
//    同じバーで「前の Trade が決済 → 新しい Trade を Entry」が起こりうるが、
//    配列 index で対応付けているので順序に依存しない。念のため決済の取り込みは
//    毎バー先に行い、取りこぼしがないようループで全件処理する。
// ============================================================================
//  Entry した Trade の Bucket (index = Trade 番号)
var array<int> tradeBucketArr = array.new<int>()
//  Bucket 別の集計 (index = Bucket Code 0〜5)
var array<int>   bkTrades = array.new<int>(6, 0)
var array<int>   bkWins   = array.new<int>(6, 0)
var array<int>   bkLosses = array.new<int>(6, 0)
var array<int>   bkBe     = array.new<int>(6, 0)
var array<float> bkGP     = array.new<float>(6, 0.0)
var array<float> bkGL     = array.new<float>(6, 0.0)
//  取り込み済みの決済 Trade 数
var int researchClosedSeen = 0
//  Debug 表示用 : いま保有中の Trade の Bucket / 方向
var int activeTradeBucket = na
var int activeTradeDir    = na

//  ---- 1) 決済済み Trade を Bucket へ集計 -----------------------------------
if strategy.closedtrades > researchClosedSeen
    for ci = researchClosedSeen to strategy.closedtrades - 1
        if ci < array.size(tradeBucketArr)
            int   bkt = array.get(tradeBucketArr, ci)
            float pnl = strategy.closedtrades.profit(ci)
            if bkt >= 0 and bkt <= 5 and not na(pnl)
                array.set(bkTrades, bkt, array.get(bkTrades, bkt) + 1)
                if pnl > 0
                    array.set(bkWins, bkt, array.get(bkWins, bkt) + 1)
                    array.set(bkGP,   bkt, array.get(bkGP,   bkt) + pnl)
                else if pnl < 0
                    array.set(bkLosses, bkt, array.get(bkLosses, bkt) + 1)
                    array.set(bkGL,     bkt, array.get(bkGL,     bkt) + math.abs(pnl))
                else
                    //  建値決済 (pnl == 0) は勝ちにも負けにも数えない
                    array.set(bkBe, bkt, array.get(bkBe, bkt) + 1)
    researchClosedSeen := strategy.closedtrades

//  ---- 2) 新規 Entry へ Bucket をタグ付け -----------------------------------
//  canLong / canShort は Section 07 で確定済み。Bucket は Entry の可否に
//  関与しないので、ここで記録するだけ。
if canLong
    array.push(tradeBucketArr, longBucket)
    activeTradeBucket := longBucket
    activeTradeDir    := 1
if canShort
    array.push(tradeBucketArr, shortBucket)
    activeTradeBucket := shortBucket
    activeTradeDir    := -1

// ============================================================================
// 08. DISPLAY / DEBUG
// ----------------------------------------------------------------------------
//  ★ ここから下は表示専用。Entry 判定には一切関与しない。
// ============================================================================
//  直近の Signal バーの Bucket / 距離を Debug Table 用に保持する。
var int   lastLongBucket  = na
var float lastLongDist    = na
var int   lastShortBucket = na
var float lastShortDist   = na
if longActionable
    lastLongBucket := longBucket
    lastLongDist   := longResDist
if shortActionable
    lastShortBucket := shortBucket
    lastShortDist   := shortResDist

f_bucketStr(int b) =>
    na(b) ? "-" : b == ZB_NONE ? "Zoneなし" : b == ZB_INSIDE ? "Zone内" :
     b == ZB_0_2_5 ? "$0〜2.5" : b == ZB_2_5_5 ? "$2.5〜5" :
     b == ZB_5_7_5 ? "$5〜7.5" : "$7.5〜10"

color bgFinal = not showBg ? na :
     bg15 == BG_BLUE ? color.new(bgBuyCol, bgTransp) :
     bg15 == BG_RED  ? color.new(bgSellCol, bgTransp) : na
bgcolor(bgFinal, title = "SAT 15s 背景")

// ---- Data Window ------------------------------------------------------------
//  Pattern Mode : 0 = ALL / 1 = A_ONLY / 2 = B_ONLY
plot(patternMode == MODE_ALL ? 0.0 : patternMode == MODE_A ? 1.0 : 2.0,
     title = "DW: Pattern Mode", display = display.data_window)
plot(bg15 * 1.0, title = "DW: 15s BG", display = display.data_window)
plot(bg30 * 1.0, title = "DW: 30s BG", display = display.data_window)
plot(bg1m * 1.0, title = "DW: 1m BG",  display = display.data_window)
plot(longState  * 1.0, title = "DW: LONG State",  display = display.data_window)
plot(shortState * 1.0, title = "DW: SHORT State", display = display.data_window)
//  Pattern 別の素の Signal (Pattern Mode に関係なく常に出る)
plot(longSigA  ? 1.0 : 0.0, title = "DW: LONG Pattern A Signal",  display = display.data_window)
plot(longSigB  ? 1.0 : 0.0, title = "DW: LONG Pattern B Signal",  display = display.data_window)
plot(shortSigA ? 1.0 : 0.0, title = "DW: SHORT Pattern A Signal", display = display.data_window)
plot(shortSigB ? 1.0 : 0.0, title = "DW: SHORT Pattern B Signal", display = display.data_window)
//  Pattern Mode 適用後の最終 Signal
plot(longSignal  ? 1.0 : 0.0, title = "DW: Final LONG Signal",  display = display.data_window)
plot(shortSignal ? 1.0 : 0.0, title = "DW: Final SHORT Signal", display = display.data_window)
//  ---- Zone Obstacle Filter (既存項目はそのまま。以下を追加) ----------------
//  ★ Zone で BLOCK されても longSignal / shortSignal は false にしない ★
//    「Signal は出たが Zone で BLOCK された」ことを CSV で確認できるようにする。
plot(useZoneObstacleFilter ? 1.0 : 0.0, title = "DW: Zone Filter Enabled", display = display.data_window)
plot(useZoneObstacleFilter and longBlocked  ? 1.0 : 0.0, title = "DW: LONG Zone Block",  display = display.data_window)
plot(useZoneObstacleFilter and shortBlocked ? 1.0 : 0.0, title = "DW: SHORT Zone Block", display = display.data_window)
//  対象 Zone がなければ na
plot(longObsDist,   title = "DW: LONG Nearest Obstacle Distance",  display = display.data_window)
plot(shortObsDist,  title = "DW: SHORT Nearest Obstacle Distance", display = display.data_window)
plot(longObsEdge,   title = "DW: LONG Nearest Obstacle Edge",  display = display.data_window)
plot(shortObsEdge,  title = "DW: SHORT Nearest Obstacle Edge", display = display.data_window)
plot(longObsStr,    title = "DW: LONG Obstacle Strength",  display = display.data_window)
plot(shortObsStr,   title = "DW: SHORT Obstacle Strength", display = display.data_window)
//  ---- Zone Distance Research (既存項目はそのまま。以下を追加) --------------
//  ★ Bucket / Distance は Signal が成立したバーだけ値を出す (それ以外は na) ★
//    Entry 判定に使うのは Signal バーの Bucket だけなので、CSV でもその足だけ
//    見れば十分。Bucket は 0=Zoneなし / 1=Zone内 / 2=$0〜2.5 / 3=$2.5〜5 /
//    4=$5〜7.5 / 5=$7.5〜10。
plot(useZoneDistanceResearch ? 1.0 : 0.0, title = "DW: Zone Research Enabled", display = display.data_window)
plot(longActionable  ? longBucket  : na, title = "DW: LONG Zone Bucket",  display = display.data_window)
plot(shortActionable ? shortBucket : na, title = "DW: SHORT Zone Bucket", display = display.data_window)
plot(longActionable  ? longResDist  : na, title = "DW: LONG Zone Distance",  display = display.data_window)
plot(shortActionable ? shortResDist : na, title = "DW: SHORT Zone Distance", display = display.data_window)
plot(longActionable  ? longResEdge  : na, title = "DW: LONG Zone Edge",  display = display.data_window)
plot(shortActionable ? shortResEdge : na, title = "DW: SHORT Zone Edge", display = display.data_window)
plot(longActionable  ? longResStr  : na, title = "DW: LONG Zone Strength",  display = display.data_window)
plot(shortActionable ? shortResStr : na, title = "DW: SHORT Zone Strength", display = display.data_window)

// ---- Debug Table (小さめ) ---------------------------------------------------
var table dbgTable = table.new(position.top_right, 2, 11,
     border_width = 1, frame_width = 1, frame_color = color.gray)

if showDebug and barstate.islast
    color bgH = color.new(color.black, 10)
    color bgC = color.new(color.black, 30)
    table.cell(dbgTable, 0, 0, "SAT Original Base", text_color = color.white, bgcolor = bgH, text_size = size.small)
    table.cell(dbgTable, 1, 0, patternMode,         text_color = color.white, bgcolor = bgH, text_size = size.small)

    table.cell(dbgTable, 0, 1, "15s BG", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 1, f_bgStr(bg15), text_color = f_bgCol(bg15), bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 0, 2, "30s BG", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 2, f_bgStr(bg30) + "  ※初期ARMのみ", text_color = f_bgCol(bg30), bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 0, 3, "1m BG",  text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 3, f_bgStr(bg1m) + "  ※維持必須", text_color = f_bgCol(bg1m), bgcolor = bgC, text_size = size.small)

    table.cell(dbgTable, 0, 4, "LONG State",  text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 4, f_longStateStr(longState),  text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 0, 5, "SHORT State", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 5, f_shortStateStr(shortState), text_color = color.white, bgcolor = bgC, text_size = size.small)

    table.cell(dbgTable, 0, 6, "Signal A / B", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 6,
         "LONG "  + (longSigA  ? "A" : "-") + (longSigB  ? "B" : "-") +
         "   SHORT " + (shortSigA ? "A" : "-") + (shortSigB ? "B" : "-"),
         text_color = color.white, bgcolor = bgC, text_size = size.small)

    //  ---- Zone Obstacle Filter (表示専用。Entry 判定にはここの値を使わない) ----
    table.cell(dbgTable, 0, 7, "Zone Filter", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 7,
         (useZoneObstacleFilter ? "ON" : "OFF") +
         "  (最低強度 " + zoneObstacleMinStrStr + ")" +
         "   Zone 数 " + str.tostring(zn.zoneCount(zoneEng)),
         text_color = color.white, bgcolor = bgC, text_size = size.small)

    table.cell(dbgTable, 0, 8, "Zone L / S", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 8,
         "LONG "  + (longBlocked  ? "BLOCK" : "PASS") +
         " (" + (na(longObsDist)  ? "-" : str.tostring(longObsDist,  format.mintick)) + ")" +
         "   SHORT " + (shortBlocked ? "BLOCK" : "PASS") +
         " (" + (na(shortObsDist) ? "-" : str.tostring(shortObsDist, format.mintick)) + ")",
         text_color = color.white, bgcolor = bgC, text_size = size.small)

    //  ---- Zone Distance Research (表示専用) ----------------------------------
    //  直近の Signal バーの Bucket / Distance を保持して表示する。
    table.cell(dbgTable, 0, 9, "Zone Research", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 9,
         (useZoneDistanceResearch ? "ON (記録専用)" : "OFF") +
         "  (最低強度 " + zoneResearchMinStrStr + ")",
         text_color = color.white, bgcolor = bgC, text_size = size.small)

    table.cell(dbgTable, 0, 10, "直近 Bucket", text_color = color.white, bgcolor = bgC, text_size = size.small)
    table.cell(dbgTable, 1, 10,
         "LONG "  + f_bucketStr(lastLongBucket)  +
         " (" + (na(lastLongDist)  ? "-" : str.tostring(lastLongDist,  format.mintick)) + ")" +
         "   SHORT " + f_bucketStr(lastShortBucket) +
         " (" + (na(lastShortDist) ? "-" : str.tostring(lastShortDist, format.mintick)) + ")" +
         "   保有中 " + f_bucketStr(activeTradeBucket) +
         (na(activeTradeDir) ? "" : activeTradeDir > 0 ? " (L)" : " (S)"),
         text_color = color.white, bgcolor = bgC, text_size = size.small)

// ---- Zone Box 描画 (検証用。Entry 判定には一切関与しない) -------------------
//  ★ box.new / box.delete は Strategy の注文にも State にも影響しない ★
//    showZones の ON / OFF で Strategy Tester 結果は変わらない。
f_zoneColor(int st) =>
    st == ST_SUPPORT ? colSupport : st == ST_RESIST ? colResistance : st == ST_ACTIVE ? colActive : colBroken

f_zoneTransp(int strength) =>
    strength == SR_VSTRONG ? 55 : strength == SR_STRONG ? 68 : strength == SR_MEDIUM ? 80 : 90

var array<box> gBoxes = array.new<box>()

if barstate.islast
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    if showZones and zn.zoneCount(zoneEng) > 0
        array<int> ord = zn.drawOrder(zoneEng, maxZonesDraw)
        if array.size(ord) > 0
            for k = 0 to array.size(ord) - 1
                zn.Zone z = zn.zoneAt(zoneEng, array.get(ord, k))
                color bc = f_zoneColor(z.state)
                int   tr = f_zoneTransp(z.strength)
                box b = box.new(
                     left         = bar_index - zoneLeftBars,
                     top          = z.top,
                     right        = bar_index + zoneRightBars,
                     bottom       = z.bottom,
                     bgcolor      = color.new(bc, tr),
                     border_color = color.new(bc, math.max(tr - 30, 0)),
                     border_width = z.strength >= SR_STRONG ? 2 : 1,
                     border_style = z.state == ST_BROKEN ? line.style_dashed : line.style_solid,
                     xloc         = xloc.bar_index)
                array.push(gBoxes, b)

// ============================================================================
//  Zone Distance Research Table (補助表示)
// ----------------------------------------------------------------------------
//  ★ これは補助。365日 Deep Backtesting の全 Trade は Entry ID で判別する ★
//    Table はチャート上で実行された範囲しか集計できないため、Deep Backtesting
//    の全期間を見るには List of Trades を CSV Export し、Entry ID の
//    サフィックス (ZNONE / ZIN / Z0_2.5 / Z2.5_5 / Z5_7.5 / Z7.5_10) で
//    Bucket を判別する。この Table は短期間の動作確認用。
//
//  実際に Entry した Trade を Bucket 別に集計したもの。
//  ★ 合計行の Trades は Strategy Tester の Total Trades と一致する ★
//    Bucket は Entry を一切制限していないので、6 Bucket の合計は
//    元 Baseline の Trade 数そのもの。
//  ★ Win / Loss は pnl > 0 / pnl < 0 で数える。pnl == 0 (建値) は BE 列へ。
//    そのため Wins + Losses + BE = Trades。Win Rate は Wins / Trades。
// ============================================================================
f_pfStr(float gp, float gl) =>
    gl > 0 ? str.tostring(gp / gl, "#.###") : gp > 0 ? "∞" : "-"

f_wrStr(int wins, int trades) =>
    trades > 0 ? str.tostring(wins / trades * 100.0, "#.##") + "%" : "-"

var table resTable = table.new(position.bottom_left, 8, 9,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

if useZoneDistanceResearch and barstate.islast
    color hdr = color.new(color.gray,  60)
    color row = color.new(color.black, 60)
    color totC = color.new(color.blue, 65)
    table.cell(resTable, 0, 0, "Zone Distance Research", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 1, 0, "Trades",       text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 2, 0, "Wins",         text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 3, 0, "Losses",       text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 4, 0, "Win Rate",     text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 5, 0, "Gross Profit", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 6, 0, "Gross Loss",   text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 7, 0, "PF",           text_color = color.white, bgcolor = hdr, text_size = size.small)

    int   totT = 0
    int   totW = 0
    int   totL = 0
    float totGP = 0.0
    float totGL = 0.0
    //  行の並びは Bucket Code 順ではなく、Zoneなし → Zone内 → 距離順にする
    for r = 0 to 5
        int bkt = r == 0 ? ZB_NONE : r == 1 ? ZB_INSIDE : r == 2 ? ZB_0_2_5 :
             r == 3 ? ZB_2_5_5 : r == 4 ? ZB_5_7_5 : ZB_7_5_10
        int   t  = array.get(bkTrades, bkt)
        int   w  = array.get(bkWins,   bkt)
        int   l  = array.get(bkLosses, bkt)
        float gp = array.get(bkGP,     bkt)
        float gl = array.get(bkGL,     bkt)
        totT  := totT  + t
        totW  := totW  + w
        totL  := totL  + l
        totGP := totGP + gp
        totGL := totGL + gl
        table.cell(resTable, 0, r + 1, f_bucketStr(bkt), text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 1, r + 1, str.tostring(t),  text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 2, r + 1, str.tostring(w),  text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 3, r + 1, str.tostring(l),  text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 4, r + 1, f_wrStr(w, t),    text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 5, r + 1, str.tostring(gp, "#.##"), text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 6, r + 1, str.tostring(gl, "#.##"), text_color = color.white, bgcolor = row, text_size = size.small)
        table.cell(resTable, 7, r + 1, f_pfStr(gp, gl),  text_color = color.white, bgcolor = row, text_size = size.small)

    table.cell(resTable, 0, 7, "合計",             text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 1, 7, str.tostring(totT), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 2, 7, str.tostring(totW), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 3, 7, str.tostring(totL), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 4, 7, f_wrStr(totW, totT), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 5, 7, str.tostring(totGP, "#.##"), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 6, 7, str.tostring(totGL, "#.##"), text_color = color.white, bgcolor = totC, text_size = size.small)
    table.cell(resTable, 7, 7, f_pfStr(totGP, totGL), text_color = color.white, bgcolor = totC, text_size = size.small)

    //  照合行 : Strategy Tester の Total Trades と一致しているかをその場で確認できる
    int beTot = 0
    for bi = 0 to 5
        beTot := beTot + array.get(bkBe, bi)
    table.cell(resTable, 0, 8, "照合", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(resTable, 1, 8,
         "Strategy Tester Total Trades = " + str.tostring(strategy.closedtrades) +
         "   /   Research 合計 = " + str.tostring(totT) +
         (totT == strategy.closedtrades ? "   一致" : "   ★不一致") +
         "   (建値 BE " + str.tostring(beTot) + " 件は Wins/Losses に含めず Trades には含む)",
         text_color = totT == strategy.closedtrades ? color.white : color.yellow,
         bgcolor = hdr, text_size = size.small)

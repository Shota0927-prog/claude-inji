// ============================================================================
//  SAT Original Base Research Strategy
// ----------------------------------------------------------------------------
//  既存 SAT MTF Strategy に最初から存在していた CURRENT Base Signal を、
//  余計な Filter / Zone を一切入れずに完全再現して再検証するためのファイル。
//
//  sat_mtf_strategy.pine / sat_base_v2_research.pine とは完全に独立した
//  別ファイルで、あちらのロジックは一切変更していない。
//
//  ■ 目的
//    ・CURRENT 全体
//    ・Pattern A 単独
//    ・Pattern B 単独
//    ・LONG / SHORT
//    を 365 日で分解し、「元ロジックのどこに Edge があるのか」を確認する。
//
//  ■ CURRENT ロジック (LONG。SHORT は色を反転した完全対称)
//    初期 ARM : 15s BLUE かつ 30s BLUE かつ 1m BLUE
//               ★ 30s は初期 ARM にだけ使う。ARM 後の維持条件ではない。
//    1m Guard : ST_WAIT 以外のとき確定1分背景が BLUE でなくなったら即 ST_WAIT
//    Pattern A: BLUE → FLAT (1本以上) → BLUE   ← BLUE へ復帰した足で Signal
//    Pattern B: BLUE → RED  (1本以上) → FLAT   ← 最初の FLAT で Signal
//               ★ Pattern B は FLAT 到達時点で Signal。BLUE 復帰までは待たない。
//
//  ■ このファイルに入れていないもの (意図的)
//    5m SAT / CANDIDATE_1 ～ 17 / SAT Base v2 の 3 仮説 / ZoneEngine /
//    Zone SLTP / Entry Filter ① / Entry Filter ② / HTF Filter / MA Filter /
//    Session Filter / Volatility Filter / DXY / Yield / Oil / Silver /
//    スコアリング / 追加 Confirm / Freshness / Setup Event / 新しい Entry 条件
//
//  ■ 構成
//    01. INPUTS
//    02. SAT BAND Reconstruction 計算関数
//    03. SAT 背景 : 15s / 30s / 1m
//    04. ORIGINAL CURRENT STATE MACHINE
//    05. PATTERN MODE → 最終 Signal
//    06. RISK / QTY
//    07. ORDER + Entry 成功時 Reset
//    08. DISPLAY / DEBUG
//
//  ■ リペイント防止
//   ・Entry State の更新は必ず確定した15秒足で行う (barstate.isconfirmed)。
//   ・30秒 / 1分の背景は request.security(..., lookahead_on) の内部で
//     式に [1] を掛け、「最後に確定した HTF バー」の値だけを使う。
//     形成中の HTF バーは絶対に使わない。
//     ★ lookahead_on は必ず [1] とセットで使う。単独では絶対に使わない。
//       [1] が「ひとつ前の閉じた HTF バー」を指すため、lookahead_on が
//       前借りするのはその確定済みバーの値だけで、未来の情報は入らない。
//       lookahead_off + [1] は HTF バー切り替わり直後にもう 1 本ぶん古い値を
//       返しうるので、ヒストリカルとリアルタイムで判定がずれる。
//   ・過去バーの Entry 位置が後から変わる実装は入れていない。
// ============================================================================

//@version=5
strategy(
     title             = "SAT Original Base Research Strategy",
     shorttitle        = "SAT-Orig-Base",
     overlay           = true,
     pyramiding        = 1,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     process_orders_on_close = true,
     dynamic_requests  = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ★★★ Library import ★★★
//  Zone Obstacle Filter でだけ使う。Zone 生成ロジックは ZoneEngine のまま変更しない。
import sekine3310/ZoneEngine/10 as zn

// Library 内の定数と同じ値 (定数 export は Pine のバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// ---- Zone Distance Research : Bucket Code ----------------------------------
//  0 = Zoneなし / 1 = Zone内 / 2 = $0〜2.5 / 3 = $2.5〜5 / 4 = $5〜7.5 / 5 = $7.5〜10
int ZB_NONE    = 0
int ZB_INSIDE  = 1
int ZB_0_2_5   = 2
int ZB_2_5_5   = 3
int ZB_5_7_5   = 4
int ZB_7_5_10  = 5

// ---- 背景 State -------------------------------------------------------------
int BG_BLUE = 1
int BG_FLAT = 0
int BG_RED  = -1

// ---- Entry State Machine (元 CURRENT と同じ 4 State) ------------------------
//   LONG  : 0 WAIT / 1 ARMED(青基準) / 2 SAW_FLAT / 3 SAW_RED
//   SHORT : 0 WAIT / 1 ARMED(赤基準) / 2 SAW_FLAT / 3 SAW_BLUE
int ST_WAIT  = 0
int ST_ARMED = 1
int ST_FLAT  = 2
int ST_OPP   = 3

// ============================================================================
// 01. INPUTS
// ============================================================================

// ---- 01-1 Pattern Mode -----------------------------------------------------
var string G_PAT = "01 · Pattern Mode"
MODE_ALL = "ORIGINAL · A + B"
MODE_A   = "PATTERN_A_ONLY"
MODE_B   = "PATTERN_B_ONLY"
patternMode = input.string(MODE_ALL, "Pattern Mode",
     options = ["ORIGINAL · A + B", "PATTERN_A_ONLY", "PATTERN_B_ONLY"], group = G_PAT,
     tooltip = "★ Pattern Mode で変わるのは「どの Signal を Order へ渡すか」だけ ★\n" +
     "  State Machine そのものは 3 Mode でまったく同じように進む。\n" +
     "  例えば PATTERN_B_ONLY でも Pattern A 相当の FLAT → BLUE の State 遷移は\n" +
     "  通常どおり処理する。ただし A Signal を Order には渡さない。\n\n" +
     "ORIGINAL · A + B : 元 CURRENT そのまま (A も B も Entry)\n" +
     "PATTERN_A_ONLY   : Pattern A (BLUE → FLAT → BLUE) だけ Entry\n" +
     "PATTERN_B_ONLY   : Pattern B (BLUE → RED → FLAT) だけ Entry")

// ---- 01-2 MTF --------------------------------------------------------------
var string G_MTF = "02 · MTF · 時間足"
satTf30 = input.timeframe("30S", "30秒足 の時間足指定", group = G_MTF,
     tooltip = "この時間足のコンテキスト内で STB / LINE1 / LINE2 / 背景 をすべて再計算する。\n15秒足のラインを流用しない。")
satTf1m = input.timeframe("1",   "1分足 の時間足指定",  group = G_MTF)

// ---- 01-3 方向 -------------------------------------------------------------
var string G_DIR = "03 · 方向"
enableLong  = input.bool(true, "Enable Long",  group = G_DIR)
enableShort = input.bool(true, "Enable Short", group = G_DIR)

// ---- 01-4 SL / TP (固定のみ) -----------------------------------------------
var string G_SLTP = "04 · SL / TP (固定のみ)"
fixedSlDollar = input.float(5.0,  "Fixed SL ($)", minval = 0.01, step = 0.1, group = G_SLTP)
fixedTpDollar = input.float(10.0, "Fixed TP ($)", minval = 0.01, step = 0.1, group = G_SLTP)

// ---- 01-4b Zone Obstacle Filter --------------------------------------------
//  ★ Zone は Entry 根拠ではない。SL/TP も変えない ★
//    Signal 成立後、固定 TP までの進行方向に「障害物」があるかだけを見て
//    Entry を見送る最終 Filter。
//    LONG  … Resistance Zone (ST_RESIST) だけを障害物として見る
//    SHORT … Support Zone   (ST_SUPPORT) だけを障害物として見る
//    初回検証では ST_ACTIVE / ST_BROKEN は障害物として扱わない。
var string G_ZOBS = "04 · Zone Obstacle Filter"
useZoneObstacleFilter = input.bool(false, "Zone Obstacle Filter を使う", group = G_ZOBS,
     tooltip = "OFF (既定) なら Zone は Entry 判定に一切関与しない。\n" +
     "OFF のときの Strategy Tester 結果は、この Filter を追加する前と完全に一致する。\n\n" +
     "ON のとき:\n" +
     "  LONG  … Entry から固定 TP までの間に Resistance Zone の下端 (bottom) が\n" +
     "          あれば Entry を見送る\n" +
     "  SHORT … Entry から固定 TP までの間に Support Zone の上端 (top) が\n" +
     "          あれば Entry を見送る\n" +
     "  Entry 価格が対象 Zone の内部にある場合も見送る (距離 0)\n" +
     "  TP より先にある Zone は障害物にしない")
zoneObstacleMinStrStr = input.string("Medium", "Obstacle Min Strength",
     options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_ZOBS,
     tooltip = "この強度以上の Zone だけを障害物として扱う。\n初回検証では Score 条件は追加せず Strength だけで判定する。")

// ---- 01-4 Zone Engine ------------------------------------------------------
//  ZONE モードのときだけ使う。Zone 生成ロジックは ZoneEngine のまま変更しない。
var string G_ZBASE = "04 · Zone · Base TF"
zoneBaseTf = input.timeframe("5", "Zone Base TF", group = G_ZBASE,
     tooltip = "Zone を生成 / 更新する基準時間足。元 Zone Strategy と同じ 5分が初期値。\n" +
     "★ SAT Entry は15秒足のまま。ここで変わるのは Zone 側だけ。\n" +
     "この時間足が 1 本確定するたびに ZoneEngine を 1 回だけ更新する。\n" +
     "Day High/Low / Reaction / Natural State / MA alignment / trackStaleBars /\n" +
     "createdBar / breakBar / lastSeenBar / Zone 寿命の time はすべてこの時間足基準になる。\n" +
     "Break 判定もこの時間足の確定終値で行う。")

var string G_ZONE = "04 · Zone Geometry"
zoneHalfWidth = input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE)

var string G_ZMA = "04 · Zone · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_ZMA)
zMaType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_ZMA)
useMaSource = input.bool(true, "Enable MA Source", group = G_ZMA)
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_ZMA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_ZMA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_ZMA)
scoreMa1 = input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_ZMA)
scoreMa2 = input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_ZMA)

var string G_ZSLOPE = "04 · Zone · MA Slope"
slopeThrMod       = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_ZSLOPE)
slopeThrStrong    = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_ZSLOPE)
slopeBonusFlat    = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_ZSLOPE)
slopeBonusMod     = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_ZSLOPE)
slopeBonusStr     = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_ZSLOPE)
slopeBonusMode    = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster", options = ["Sum (per MA)", "Max"], group = G_ZSLOPE)
maClusterDist     = input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_ZSLOPE)
maClusterBonus    = input.float(1.0,  "MA Cluster Bonus",        step = 0.5, group = G_ZSLOPE)
maClusterDirBonus = input.float(1.0,  "MA Cluster Bonus · Same Slope", step = 0.5, group = G_ZSLOPE)

var string G_ZHZ = "04 · Zone · Horizontal Source (Swing)"
useHzSource = input.bool(true, "Enable Horizontal Source", group = G_ZHZ)
hzTf1 = input.timeframe("5",  "Horizontal TF #1", group = G_ZHZ)
hzTf2 = input.timeframe("15", "Horizontal TF #2", group = G_ZHZ)
hzTf3 = input.timeframe("60", "Horizontal TF #3", group = G_ZHZ)
pivLen1 = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_ZHZ)
pivLen2 = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_ZHZ)
pivLen3 = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_ZHZ)
scoreHz1 = input.float(1.0, "Base Score · TF #1 Swing", step = 0.5, group = G_ZHZ)
scoreHz2 = input.float(2.0, "Base Score · TF #2 Swing", step = 0.5, group = G_ZHZ)
scoreHz3 = input.float(3.0, "Base Score · TF #3 Swing", step = 0.5, group = G_ZHZ)

var string G_ZREACT = "04 · Zone · Horizontal Reaction"
reactionDist      = input.float(20.0, "Reaction Distance ($)", step = 0.5, group = G_ZREACT)
reactionBonus1    = input.float(1.0,  "Reaction Bonus · 1 time",   step = 0.5, group = G_ZREACT)
reactionBonus2    = input.float(2.0,  "Reaction Bonus · 2 times",  step = 0.5, group = G_ZREACT)
reactionBonus3    = input.float(3.0,  "Reaction Bonus · 3+ times", step = 0.5, group = G_ZREACT)
reactionRearmDist = input.float(10.0, "Reaction Re-arm Distance ($)", step = 0.5, group = G_ZREACT)

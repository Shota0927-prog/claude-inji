htfMa2      = input.bool(false, "Count MA #2 (3000) as Higher TF",        group = G_ZHTF)
htfDayHL    = input.bool(false, "Count Day High / Low as Higher TF",      group = G_ZHTF)

var string G_ZBF = "04 · Zone · Break / Flip"
//  ★ Break 評価は Zone Base TF (= 04 · Zone · Base TF) で行う ★
//    元 Zone Strategy の Break TF は "5" で Base TF と同じなので、
//    別の input にせず Base TF へ統一した。
//    これにより Break は必ず「確定した Base TF 足の終値」で判定され、
//    15秒足のヒゲも 15秒終値も Break にはならない。
//    request.security も 1 本削減される。
breakBuffer     = input.float(5.0,  "Break Buffer ($)",          step = 0.5, group = G_ZBF)
flipConfirmDist = input.float(10.0, "Flip Confirm Distance ($)", step = 0.5, group = G_ZBF)
resetOnReclaim  = input.bool(true,  "Reset Broken on Reclaim", group = G_ZBF)
trackStaleBars  = input.int(500, "Zone State Retention (Base TF bars without match)", minval = 10, group = G_ZBF,
     tooltip = "★ Base TF の本数で数える (ZoneEngine v10 の baseBarSeq 基準)。\n" +
     "Base TF = 5分 なら 500 = 5分足500本 = 約42時間。\n" +
     "15秒足500本にはならない。")
trackContinuity = input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_ZBF)

var string G_ZLIFE = "04 · Zone · Lifetime"
lifeHz1         = input.float(5.0,  "Lifetime · TF #1 Horizontal (days)", step = 0.5, group = G_ZLIFE)
lifeHz2         = input.float(10.0, "Lifetime · TF #2 Horizontal (days)", step = 0.5, group = G_ZLIFE)

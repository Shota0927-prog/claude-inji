// ============================================================================
//  Gold Intermarket × Short Signal Cross Test  ―  追加ブロック (挿入用)
// ----------------------------------------------------------------------------
//  ★ これは単体で動くスクリプトではない。
//    「FVG + Zone Short Signal」(Short専用Strategy) をコピーして
//    gold_short_intermarket_cross_test.pine を作り、そこへ下記 A / B / C を
//    挿入するための追加コードのみを収めたファイル。
//
//  ★ なぜ完成した1ファイルではなく追加ブロックなのか
//    元 Short Strategy は本リポジトリに存在せず、取得できたのは
//    チャットへ貼られたテキストだけ。約1900行を手で書き写すと、
//    input のデフォルト値ひとつのタイプミスでバックテスト結果が変わり、
//    本仕様の最優先要件である Parity Gate (元Shortと完全一致) が
//    「検証不能なまま壊れている」状態になり得る。
//    そのため「売買ロジックを1行も書き写さない」形にしてある。
//    → 元ファイルをコピーしてリネームし、本ファイルの A / B / C を
//      貼り足すだけなので、Entry / Exit / SL / TP / Qty / BE /
//      TradePlan / Position制御 は構造的に1文字も変わらない。
//    元 Short Strategy をリポジトリへ入れてもらえれば、完成した
//    gold_short_intermarket_cross_test.pine を生成して diff で
//    「追加のみ」を証明できる。
//
//  ============================================================
//   挿入手順
//  ============================================================
//   0. 元ファイル「FVG + Zone Short Signal」を複製し、
//      gold_short_intermarket_cross_test.pine として保存する。
//
//   A. strategy() の title / shorttitle だけ差し替える (任意)
//      → 下の [A] を参照。title は売買結果に影響しない。
//
//   B. input を追加する
//      → 下の [B] を、Section 01-5 (DISPLAY / DEBUG INPUTS) の末尾、
//        つまり「showFvgBosDebug = input.bool(...)」の次の行へ貼る。
//        (input.* は Section 01 にまとめるという元ファイルの方針に合わせる)
//
//   C. Section 11 を追加する
//      → 下の [C] を、ファイルの一番最後
//        (Section 10.6 の f_shortProvisional(LOGIC_ZONE_SR, provWZsrS) の次の行)
//        へそのまま貼る。
//        ★ ファイル末尾である必要がある。理由:
//          ・Section 07 が返した Short の Entry ID 変数を参照する
//          ・Entry時 Structural SL を gTradeSL から読む
//            (Section 08.1 の掃除は「決済済みTrade」だけなので、
//             発注した足では必ず残っている)
//          ・f_isOpenEntry() (Section 08.1 で定義) を再利用する
//
//   D. TradingView 側の設定
//      1) 同じチャートへ「GOLD IM LAB」(gold_intermarket_signal_lab.pine) を追加
//      2) 本 Cross Strategy の設定 →「11 · Intermarket Cross Test」→
//         "Intermarket Bus" で  GOLD IM LAB : IM Cross Bus  を選択
//      3) Lab 側の設定 (シンボル / 方向判定 / 相関 / Regime) は既定のまま。
//         Lab の設定を変えると分類も変わるので、検証中は固定する。
//
//  ============================================================
//   このブロックが行うこと / 行わないこと
//  ============================================================
//   行うこと
//     ・Intermarket Bus (非表示plot 1本) を decode して
//       V1 / V2 / V3 state と Gold Regime を得る
//     ・Short の実Entry (strategy.entry まで到達し Entry ID が発行されたもの)
//       が成立した足で、その時点の V1 / V2 / V3 / Regime / 元SL を
//       Entry ID へ紐づけて Snapshot 固定する
//     ・closed trade が出たときだけ R を算出して集計する
//     ・BASELINE (分類なし全Short) と V1 / V2 / V3 × 5state を独立集計する
//     ・結果をテーブル1枚で表示する
//
//   行わないこと (Parity Gate)
//     ・strategy.entry / strategy.exit / strategy.close / strategy.cancel を
//       1回も呼ばない
//     ・request.*() を1本も追加しない (Bus は input.source で受け取るだけ)
//     ・Entry条件 / SL / TP / Qty / BE / Dynamic TP / TradePlan /
//       Position制御 / Engine state を一切読み書きしない (読み取り専用参照のみ)
//     ・ロット変更 / Intermarketによる Entry禁止・SL/TP変更・Exit を実装しない
//     ・Logic別成績 / Long側 / V0・V4クロス / 閾値最適化を実装しない
//     ・Bus が未設定 / na / 範囲外でも売買ロジックには影響しない
//       (その場合 Cross統計のフッターに NO BUS と表示するだけ)
// ============================================================================


// ============================================================================
//  [A] strategy() の title / shorttitle (任意・売買結果に影響しない)
// ----------------------------------------------------------------------------
//  元:
//       title             = "FVG + Zone Short Signal",
//       shorttitle        = "FVG-ZONE SHORT",
//  差し替え後:
//       title             = "FVG + Zone Short × IM Cross Test",
//       shorttitle        = "FVG-ZONE SHORT IMX",
//
//  ★ title / shorttitle 以外の strategy() 引数
//    (overlay / pyramiding / initial_capital / default_qty_type /
//     default_qty_value / dynamic_requests / calc_on_every_tick /
//     max_boxes_count / max_labels_count / max_lines_count)
//    は1つも変更しないこと。1つでも変えると Strategy Tester 結果が変わる。
// ============================================================================


// ============================================================================
//  [B] input 追加  ―  Section 01-5 の末尾 (showFvgBosDebug の次) へ貼る
// ============================================================================

var string G_IMX = "11 · Intermarket Cross Test"
//  ★ Intermarket Bus の受け取り口。GOLD IM LAB の非表示plot
//    "IM Cross Bus" を選択する。未選択 (既定 close) のままでも
//    売買ロジックには一切影響しない (Cross統計が NO BUS になるだけ)。
imBusSource = input.source(close, "Intermarket Bus (GOLD IM LAB → IM Cross Bus)", group = G_IMX,
     tooltip = "同じチャートに GOLD IM LAB を追加し、その IM Cross Bus を選ぶ。\n" +
     "未選択のままでも Entry / Exit / SL / TP / Qty / BE は一切変わらない。")
//  Entry時Snapshot の Gold Regime でフィルターする。現在のRegimeではない。
imResultRegime = input.string("ALL", "Result Regime (Entry時Snapshot)",
     options = ["ALL", "BULL", "BEAR", "RANGE"], group = G_IMX,
     tooltip = "Entry が成立した時点の Gold 4H Regime で絞り込む。\n" +
     "ALL = 絞り込みなし (既定)。Regime が N/A のトレードは ALL にのみ含まれる。")
imMinSample      = input.int(30, "Min Sample Warning (N 未満に ⚠)", minval = 1, group = G_IMX)
showImCrossTable = input.bool(true, "Intermarket Cross テーブルを表示", group = G_IMX)
imTableSizeStr   = input.string("tiny", "Cross テーブル 文字サイズ",
     options = ["tiny", "small", "normal"], group = G_IMX)


// ============================================================================
//  [C] Section 11  ―  ファイル末尾へ貼る
// ============================================================================
// ============================================================================
// 11. INTERMARKET CROSS TEST  (後分類の統計のみ・売買ロジックへ影響しない)
// ----------------------------------------------------------------------------
//  ★ このセクションは読み取りと自前Mapへの記録とテーブル描画だけ。
//    strategy.entry / strategy.exit / strategy.close / strategy.cancel /
//    request.*() を1回も呼ばない。Engine state も書き換えない。
// ============================================================================

// ---- 11.1 Intermarket Bus の decode ---------------------------------------
//  Lab 側の pack 式:
//    imBus = 100000 + V1 + 5 * V2 + 25 * V3 + 125 * regimeCode
//      V1 / V2 / V3 : 0..4
//        0 = NONE / 1 = STRONG LONG / 2 = STRONG SHORT /
//        3 = LONG BIAS / 4 = SHORT BIAS
//      regimeCode   : 0 = RANGE / 1 = BULL / 2 = BEAR / 3 = N/A
//    最小値 100000 / 最大値 100000 + 4 + 20 + 100 + 375 = 100499
//    100000 は Bus が選択されているかを自己識別するマジックベース。
//
//  decode 式:
//    p   = round(bus) - 100000      ... 0 <= p <= 499 でなければ Bus 未設定
//    reg = floor(p / 125)
//    r1  = p - reg * 125
//    V3  = floor(r1 / 25)
//    r2  = r1 - V3 * 25
//    V2  = floor(r2 / 5)
//    V1  = r2 - V2 * 5
//
//  ★ 整数判定 + 範囲判定の2段で「Busが選択されているか」を見る。
//    close 等を誤って選んでいる場合は範囲外になり NO BUS 扱いになる。
//  ★ すべて float のまま floor 演算するので型変換は使わない。
//    値は整数の厳密表現なので == 比較で問題なく分岐できる。
float imxBusRaw = imBusSource
bool  imxBusInt = not na(imxBusRaw) and math.abs(imxBusRaw - math.round(imxBusRaw)) < 0.001
float imxP      = imxBusInt ? math.round(imxBusRaw) - 100000.0 : na
bool  imxBusOk  = imxBusInt and not na(imxP) and imxP >= 0 and imxP <= 499

float imxReg = imxBusOk ? math.floor(imxP / 125.0) : na
float imxR1  = imxBusOk ? imxP - imxReg * 125.0 : na
float imxV3  = imxBusOk ? math.floor(imxR1 / 25.0) : na
float imxR2  = imxBusOk ? imxR1 - imxV3 * 25.0 : na
float imxV2  = imxBusOk ? math.floor(imxR2 / 5.0) : na
float imxV1  = imxBusOk ? imxR2 - imxV2 * 5.0 : na

//  Lab state code → Cross の表示順クラス
//    0 = STRONG SHORT / 1 = SHORT BIAS / 2 = NEUTRAL /
//    3 = LONG BIAS    / 4 = STRONG LONG / -1 = 不明 (Bus未設定)
f_imxClass(float st) =>
    na(st) ? -1 : st == 2 ? 0 : st == 4 ? 1 : st == 0 ? 2 : st == 3 ? 3 : st == 1 ? 4 : -1

//  Regime スライス : 1 = BULL / 2 = BEAR / 3 = RANGE / 0 = 不明 (Bus未設定 or N/A)
int imxRegSlice = not imxBusOk ? 0 : imxReg == 1 ? 1 : imxReg == 2 ? 2 : imxReg == 0 ? 3 : 0

// ---- 11.2 Entry時 Snapshot (Entry ID へ紐づけて固定) ----------------------
//  ★ Short の実Entryが成立し Entry ID が発行された「その足」で記録する。
//    Entry後に Intermarket state や Regime が変化しても、このトレードの
//    分類は一切変更しない (Entry時点Snapshot固定)。
//  ★ 元SL は Section 07 の f_executeTrade() が gTradeSL へ入れた
//    Entry時 Structural SL をそのまま読む (発注した足では必ず存在する)。
//    自前Mapへ複製して持つので、Section 08.1 が決済時に gTradeSL を
//    掃除しても Cross 側の集計には影響しない。
//  ★ 同一 Entry ID を二度 Snapshot しない (contains で判定)。
var map<string, int>   imxSnapC1  = map.new<string, int>()
var map<string, int>   imxSnapC2  = map.new<string, int>()
var map<string, int>   imxSnapC3  = map.new<string, int>()
var map<string, int>   imxSnapReg = map.new<string, int>()
var map<string, float> imxSnapSL  = map.new<string, float>()

f_imxSnapshot(string eid) =>
    if eid != "" and not imxSnapSL.contains(eid)
        imxSnapC1.put(eid,  f_imxClass(imxV1))
        imxSnapC2.put(eid,  f_imxClass(imxV2))
        imxSnapC3.put(eid,  f_imxClass(imxV3))
        imxSnapReg.put(eid, imxRegSlice)
        imxSnapSL.put(eid,  gTradeSL.contains(eid) ? gTradeSL.get(eid) : na)
    true

//  Section 07 が返した Short の Entry ID すべて。
//  空文字 ("") のときは Snapshot しない = TradePlan FAIL / Qty不足 /
//  Group制御で発注されなかったシグナルは母集団に入らない。
f_imxSnapshot(fvg15EidShort)
f_imxSnapshot(fvgEidShort)
f_imxSnapshot(abs15EidShort)
f_imxSnapshot(abs5EidShort)
f_imxSnapshot(zrbEidShort)
f_imxSnapshot(zfkEidShort)
f_imxSnapshot(zrtEidShort)
f_imxSnapshot(zbkEidShort)
f_imxSnapshot(zsrEidShort)

// ---- 11.3 集計スロット ----------------------------------------------------
//  slot = regSlice * 16 + cat
//    cat 0〜 4 : V1 Strength  × class 0..4
//    cat 5〜 9 : V2 Consensus × class 0..4
//    cat 10〜14: V3 Early     × class 0..4
//    cat 15    : BASELINE / ALL SHORT (Intermarket分類なし)
//    regSlice 0 = ALL / 1 = BULL / 2 = BEAR / 3 = RANGE
//  field 0 = N / 1 = 勝ち件数 / 2 = Gross Positive R /
//        3 = Gross Negative R (絶対値) / 4 = Sum R / 5 = 負け件数
//  配列 index = slot * 6 + field  (4 * 16 * 6 = 384)
//
//  ★ 1トレードは必ず ALL スライスへ1回、Regime が判明していれば
//    BULL / BEAR / RANGE のいずれか1スライスへ1回だけ加算される。
//    Regime が N/A (Bus未設定 / 4H EMA未成熟) のトレードは ALL のみ。
var array<float> imxStats = array.new_float(4 * 16 * 6, 0.0)

f_imxBump(array<float> a, int slot, int fld, float v) =>
    int _i = slot * 6 + fld
    array.set(a, _i, array.get(a, _i) + v)

f_imxGet(array<float> a, int slot, int fld) =>
    array.get(a, slot * 6 + fld)

//  R == 0 のトレードは N に数えるが勝ち / 負けどちらにも数えない。
f_imxRecord(array<float> a, int cat, int regSlice, float r) =>
    float _pos = r > 0 ?  r   : 0.0
    float _neg = r < 0 ? -r   : 0.0
    float _win = r > 0 ?  1.0 : 0.0
    float _los = r < 0 ?  1.0 : 0.0
    f_imxBump(a, cat, 0, 1.0)
    f_imxBump(a, cat, 1, _win)
    f_imxBump(a, cat, 2, _pos)
    f_imxBump(a, cat, 3, _neg)
    f_imxBump(a, cat, 4, r)
    f_imxBump(a, cat, 5, _los)
    if regSlice >= 1 and regSlice <= 3
        int _s = regSlice * 16 + cat
        f_imxBump(a, _s, 0, 1.0)
        f_imxBump(a, _s, 1, _win)
        f_imxBump(a, _s, 2, _pos)
        f_imxBump(a, _s, 3, _neg)
        f_imxBump(a, _s, 4, r)
        f_imxBump(a, _s, 5, _los)
    true

// ---- 11.4 closed trade の集計 --------------------------------------------
//  ★ 新しく closed trade が出たときだけ処理する。
//    自前カウンタ imxLastClosed で index 差分だけを見るので、
//    同じ closed trade を二度集計しない
//    (元Strategyの gLastClosedCount とは完全に別の変数)。
//  ★ R は Short なので
//        initialRisk = abs(実Entry価格 - Entry時Structural SL)
//        R           = (実Entry価格 - 実Exit価格) / initialRisk
//    実際の約定価格 (strategy.closedtrades.entry_price / exit_price) を使う。
//    BreakEven / Dynamic TP / 部分決済があっても、最終的な実Exit価格から
//    そのトレードの R が決まる。
//  ★ initialRisk <= 0 / データ欠損は imxExcluded へ診断カウントして除外。
//  ★ Snapshot が無い closed trade (Long など) は imxNoSnap へ数えるだけ。
var int   imxLastClosed = 0
var float imxExcluded   = 0.0
var float imxNoSnap     = 0.0
if strategy.closedtrades > imxLastClosed
    for i = imxLastClosed to strategy.closedtrades - 1
        string _eid = strategy.closedtrades.entry_id(i)
        float  _sz  = strategy.closedtrades.size(i)
        if _sz < 0 and imxSnapSL.contains(_eid)
            float _ep = strategy.closedtrades.entry_price(i)
            float _xp = strategy.closedtrades.exit_price(i)
            float _sl = imxSnapSL.get(_eid)
            float _ir = (na(_ep) or na(_sl)) ? na : math.abs(_ep - _sl)
            if na(_ep) or na(_xp) or na(_ir) or _ir <= 0
                imxExcluded += 1.0
            else
                float _r  = (_ep - _xp) / _ir
                int   _rs = imxSnapReg.contains(_eid) ? imxSnapReg.get(_eid) : 0
                //  BASELINE (Intermarket分類なし・現在ONの全Short実Entry)
                f_imxRecord(imxStats, 15, _rs, _r)
                //  V1 / V2 / V3 はそれぞれ独立に集計する (統合判定へまとめない)
                int _c1 = imxSnapC1.contains(_eid) ? imxSnapC1.get(_eid) : -1
                int _c2 = imxSnapC2.contains(_eid) ? imxSnapC2.get(_eid) : -1
                int _c3 = imxSnapC3.contains(_eid) ? imxSnapC3.get(_eid) : -1
                if _c1 >= 0
                    f_imxRecord(imxStats, 0 + _c1, _rs, _r)
                if _c2 >= 0
                    f_imxRecord(imxStats, 5 + _c2, _rs, _r)
                if _c3 >= 0
                    f_imxRecord(imxStats, 10 + _c3, _rs, _r)
        else if _sz < 0
            imxNoSnap += 1.0
        //  完全に決済済みなら Snapshot を掃除する。
        //  部分決済で同一 Entry ID がまだ建っている場合は残す
        //  (f_isOpenEntry は Section 08.1 で定義済みのものを再利用)。
        if not f_isOpenEntry(_eid)
            if imxSnapC1.contains(_eid)
                imxSnapC1.remove(_eid)
            if imxSnapC2.contains(_eid)
                imxSnapC2.remove(_eid)
            if imxSnapC3.contains(_eid)
                imxSnapC3.remove(_eid)
            if imxSnapReg.contains(_eid)
                imxSnapReg.remove(_eid)
            if imxSnapSL.contains(_eid)
                imxSnapSL.remove(_eid)
    imxLastClosed := strategy.closedtrades

// ---- 11.5 表示 ------------------------------------------------------------
f_imxTextSize(string s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

f_imxLogicName(int lg) =>
    lg == 0 ? "V1 Strength" : lg == 1 ? "V2 Consensus" : "V3 Early"

f_imxStateName(int cls) =>
    cls == 0 ? "STRONG SHORT" : cls == 1 ? "SHORT BIAS" : cls == 2 ? "NEUTRAL" :
     cls == 3 ? "LONG BIAS"   : cls == 4 ? "STRONG LONG" : "-"

f_imxPct(float num, float den) =>
    den > 0 ? str.tostring(num / den * 100.0, "0.0") : "-"

//  PF は R ベース : Gross Positive R / abs(Gross Negative R)
//  負け側が 0 のときは割り算しない (勝ちがあれば INF / 何も無ければ -)
f_imxPf(float pos, float neg) =>
    neg > 0 ? str.tostring(pos / neg, "0.00") : (pos > 0 ? "INF" : "-")

f_imxAvg(float sum, float den) =>
    den > 0 ? str.tostring(sum / den, "0.00") : "-"

f_imxCell(table t, int col, int row, string txt, color bg, string sz) =>
    table.cell(t, col, row, txt, text_color = color.white, bgcolor = bg, text_size = sz)

f_imxRow(table t, int row, string c0, string c1, int slot, array<float> a, color bg, string sz) =>
    float _n   = f_imxGet(a, slot, 0)
    float _win = f_imxGet(a, slot, 1)
    float _pos = f_imxGet(a, slot, 2)
    float _neg = f_imxGet(a, slot, 3)
    float _sum = f_imxGet(a, slot, 4)
    float _los = f_imxGet(a, slot, 5)
    f_imxCell(t, 0, row, c0, bg, sz)
    f_imxCell(t, 1, row, c1, bg, sz)
    f_imxCell(t, 2, row, str.tostring(_n, "0") + (_n < imMinSample ? " ⚠" : ""), bg, sz)
    f_imxCell(t, 3, row, f_imxPct(_win, _n), bg, sz)
    f_imxCell(t, 4, row, f_imxPf(_pos, _neg), bg, sz)
    f_imxCell(t, 5, row, f_imxAvg(_sum, _n), bg, sz)
    f_imxCell(t, 6, row, _n > 0 ? str.tostring(_sum, "0.00") : "-", bg, sz)
    f_imxCell(t, 7, row, f_imxAvg(_pos, _win), bg, sz)
    f_imxCell(t, 8, row, _los > 0 ? str.tostring(-_neg / _los, "0.00") : "-", bg, sz)

//  9列 × 18行 (ヘッダー1 + BASELINE 1 + 15 + フッター1)
//  位置は bottom_left。元Strategyの既存テーブル
//  (Zone Debug = Top Right / FVG環境 = middle_left /
//   日足ボラ = top_left / FVG BOS = bottom_right) と重ならない。
var table imxTbl = table.new(position.bottom_left, 9, 18, border_width = 1)

if barstate.islast and showImCrossTable
    string _sz = f_imxTextSize(imTableSizeStr)
    color  _hd = color.new(color.rgb(15, 15, 15), 10)
    color  _bs = color.new(color.rgb(35, 35, 35), 10)
    color  _bl = color.new(color.rgb(20, 50, 80), 10)
    //  Result Regime → slot オフセット (ALL = 従来と同一スライス)
    int _off = imResultRegime == "BULL" ? 16 : imResultRegime == "BEAR" ? 32 : imResultRegime == "RANGE" ? 48 : 0

    f_imxCell(imxTbl, 0, 0, "IM Logic",   _hd, _sz)
    f_imxCell(imxTbl, 1, 0, "IM State",   _hd, _sz)
    f_imxCell(imxTbl, 2, 0, "N",          _hd, _sz)
    f_imxCell(imxTbl, 3, 0, "Win %",      _hd, _sz)
    f_imxCell(imxTbl, 4, 0, "PF",         _hd, _sz)
    f_imxCell(imxTbl, 5, 0, "Avg R",      _hd, _sz)
    f_imxCell(imxTbl, 6, 0, "Net R",      _hd, _sz)
    f_imxCell(imxTbl, 7, 0, "Avg Win R",  _hd, _sz)
    f_imxCell(imxTbl, 8, 0, "Avg Loss R", _hd, _sz)

    //  BASELINE を必ず一番上に出す。Intermarket の価値は必ずこの行との差で判断する。
    f_imxRow(imxTbl, 1, "BASELINE", "ALL SHORT", _off + 15, imxStats, _bl, _sz)

    int _row = 2
    for lg = 0 to 2
        for cls = 0 to 4
            f_imxRow(imxTbl, _row, f_imxLogicName(lg), f_imxStateName(cls),
                 _off + lg * 5 + cls, imxStats, _bs, _sz)
            _row += 1

    //  フッター : Bus状態 / Regimeフィルター / 診断 / 現在のIM状態 (参考表示)
    f_imxCell(imxTbl, 0, _row, imxBusOk ? "BUS OK" : "NO BUS", _hd, _sz)
    f_imxCell(imxTbl, 1, _row, "Regime " + imResultRegime, _hd, _sz)
    f_imxCell(imxTbl, 2, _row, "Excl " + str.tostring(imxExcluded, "0"), _hd, _sz)
    f_imxCell(imxTbl, 3, _row, "NoSnap " + str.tostring(imxNoSnap, "0"), _hd, _sz)
    f_imxCell(imxTbl, 4, _row, "Closed " + str.tostring(strategy.closedtrades), _hd, _sz)
    f_imxCell(imxTbl, 5, _row, imxBusOk ? ("V1 " + f_imxStateName(f_imxClass(imxV1))) : "-", _hd, _sz)
    f_imxCell(imxTbl, 6, _row, imxBusOk ? ("V2 " + f_imxStateName(f_imxClass(imxV2))) : "-", _hd, _sz)
    f_imxCell(imxTbl, 7, _row, imxBusOk ? ("V3 " + f_imxStateName(f_imxClass(imxV3))) : "-", _hd, _sz)
    f_imxCell(imxTbl, 8, _row, imxBusOk ?
         ("Reg " + (imxReg == 1 ? "BULL" : imxReg == 2 ? "BEAR" : imxReg == 0 ? "RANGE" : "N/A")) : "-", _hd, _sz)

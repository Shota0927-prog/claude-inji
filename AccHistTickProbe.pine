//
// ============================================================================
//  Acc History Tick Probe (ACC-3)  —  TradingView 実機確認用 (売買の検証ではない)
//  AccumStrategyXAU の即時建値を「On history bar tick」(calc_on_every_history_tick) で再現できるかを決める前に、
//  ローカルでは確認できない実行の事実を TradingView 上で測る小さな Strategy。初期状態では注文を出さない。
//
//  使い方: XAUUSD 5分足に追加し、プロパティの「On history bar tick」を OFF / ON、高精細な履歴データ (利用できる場合) あり / なしで
//  切り替えて、右上の表を比べる (On history bar tick は Premium / Ultimate プランのみ)。
//   1 実行回数の多い足         : 1 本の足で 2 回以上実行された足の数 (varip の実行カウンタ。varip が巻き戻る場合は 0 になる)
//   2 var の増分 > 1 の足      : 毎実行 +1 する var が 1 本で 2 以上増えた足 (> 0 = 足の途中の実行で var が巻き戻らない)
//   3 varip の増分 > 1 の足    : 毎実行 +1 する varip が 1 本で 2 以上増えた足 (> 0 = 複数回実行され、varip は巻き戻らない)
//   4 isconfirmed が複数回の足 : barstate.isconfirmed が true の実行が 1 本で 2 回以上あった足
//   5 確定前の close で isconfirmed: isconfirmed = true の最初の実行の close が足の最終値と違った足
//                              (> 0 = isconfirmed だけでは「5分足の終値で判断」を守れない)
//   6 テスト注文 (初期 OFF): ON にすると N 本ごとに、その足の最初の isconfirmed 実行で成行 Long を 1 回出し、次の足で決済。
//      「約定が発注と同じ足」の回数 > 0 なら、足の途中の isconfirmed 実行で出した注文が足の中で約定している (次足始値ではない)。
//  1〜5 は varip / var の扱いそのものに依存するため、6 の注文 (巻き戻らない) で裏付けること。
// ============================================================================

//@version=5
strategy("Acc History Tick Probe", shorttitle = "ACC-PROBE", overlay = true, calc_on_every_tick = true,
     pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1)

prOrders = input.bool(false, "テスト注文 (成行 Long を出して約定した足を見る)")
prEvery  = input.int(50, "テスト注文の間隔 (本)", minval = 2)

varip int   pBar    = -1
varip int   pExec   = 0
varip int   pConf   = 0
varip float pConfC1 = na
var   int   cVar    = 0
varip int   cVip    = 0

if pBar != bar_index
    pBar    := bar_index
    pExec   := 0
    pConf   := 0
    pConfC1 := na
pExec += 1
cVar  += 1
cVip  += 1
if barstate.isconfirmed
    pConf += 1
    if na(pConfC1)
        pConfC1 := close

// 1 本ごとの値 (足の最後の実行の値が確定する)
int dVar  = cVar - nz(cVar[1])
int dVip  = cVip - nz(cVip[1])
bool hist = barstate.ishistory
float n1 = ta.cum(hist and pExec > 1 ? 1 : 0)
float n2 = ta.cum(hist and dVar > 1 ? 1 : 0)
float n3 = ta.cum(hist and dVip > 1 ? 1 : 0)
float n4 = ta.cum(hist and pConf > 1 ? 1 : 0)
float n5 = ta.cum(hist and not na(pConfC1) and pConfC1 != close ? 1 : 0)
float nH = ta.cum(hist ? 1 : 0)

// テスト注文: 足の最初の isconfirmed 実行で成行 Long (varip で 1 本 1 回)、次の足で決済
varip int oSent = -1
var int nSent = 0
var int nSame = 0
var int nNext = 0
if prOrders and hist and bar_index % prEvery == 0 and barstate.isconfirmed and oSent != bar_index and strategy.position_size == 0
    oSent := bar_index
    strategy.entry("P", strategy.long, qty = 1)
if strategy.opentrades > 0 and bar_index > strategy.opentrades.entry_bar_index(0)
    strategy.close("P")
int ct = strategy.closedtrades
var int ctSeen = 0
if ct > ctSeen
    for i = ctSeen to ct - 1
        int eb = strategy.closedtrades.entry_bar_index(i)
        nSent += 1
        nSame += eb % prEvery == 0 ? 1 : 0
        nNext += eb % prEvery == 1 ? 1 : 0
    ctSeen := ct

plot(pExec, "PROBE · 実行回数 (この足)", display = display.data_window)
plot(pConf, "PROBE · isconfirmed の回数 (この足)", display = display.data_window)
plot(dVar,  "PROBE · var の増分 (この足)", display = display.data_window)
plot(dVip,  "PROBE · varip の増分 (この足)", display = display.data_window)

var table tb = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "ヒストリカルの足", text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(nH), text_size = size.small)
    table.cell(tb, 0, 1, "1 実行回数が 2 以上の足", text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(n1), text_size = size.small)
    table.cell(tb, 0, 2, "2 var の増分 > 1 の足", text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(n2), text_size = size.small)
    table.cell(tb, 0, 3, "3 varip の増分 > 1 の足", text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(n3), text_size = size.small)
    table.cell(tb, 0, 4, "4 isconfirmed が 2 回以上の足", text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(n4), text_size = size.small)
    table.cell(tb, 0, 5, "5 確定前の close で isconfirmed", text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(n5), text_size = size.small)
    table.cell(tb, 0, 6, "6 テスト注文: 約定が発注と同じ足", text_size = size.small)
    table.cell(tb, 1, 6, str.tostring(nSame) + " / " + str.tostring(nSent), text_size = size.small)
    table.cell(tb, 0, 7, "6 テスト注文: 約定が次の足", text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(nNext) + " / " + str.tostring(nSent), text_size = size.small)

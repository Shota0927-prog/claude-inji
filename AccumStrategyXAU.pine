f_evCount(int side) =>
    int r = 0
    int n = array.size(acRts)
    if n > 0
        for i = 0 to n - 1
            AcRt w = array.get(acRts, i)
            r += w.side == side and w.evOn ? 1 : 0
    r
plot(f_evCount(-1), "ACC · FVG 根拠が有効な P5 待機 (現在)", display = display.data_window)
plot(f_evCount(1),  "ACC · FVG 根拠が有効な P6 待機 (現在)", display = display.data_window)
plot(na(acFvUp) ? na : acFvUp.lo, "ACC · FVG 監視中の上昇 FVG 下限", display = display.data_window)
plot(na(acFvDn) ? na : acFvDn.hi, "ACC · FVG 監視中の下降 FVG 上限", display = display.data_window)
f_dvCount(int side) =>
    int r = 0
    int n = array.size(dvBases)
    if n > 0
        for i = 0 to n - 1
            DvBase g = array.get(dvBases, i)
            r += g.side == side ? 1 : 0
    r
f_dvEvCount(int side) =>
    int r = 0
    int n = array.size(acRts)
    if n > 0
        for i = 0 to n - 1
            AcRt w = array.get(acRts, i)
            r += w.side == side and w.dvOn ? 1 : 0
    r

// ============================================================================
//  Accum Strategy XAU (ACC-1)  —  XAUUSD 5分足・アキュムレーション専用 Strategy
//  既存の Zone Strategy (ZoneStrategyXAU / ZoneStrategyXAULong) とは独立。Engine / Library は import しない。
//  Accum 以外の Source・Entry A〜D・SATS・MA・FVG・トレンド判定は使わない。
//
//  ・Accum 検出: ZoneStrategyXAU.pine の NR-A1 ブロック (f_nraAccumBoxCore / f_nraAccumBoxState = Library の
//    f_accumBoxCore / f_accumBoxState の写し) をそのまま使う (形成式・上下限・ID = 開始足の time は同一)。
//    差分は関数名と、終了判定用に形成中フラグ (_isAccum) を 4 番目の出力として返すことだけ
//    (fixture tests/acc_sim.py が NR-A1 本文との機械照合で固定)。Provisional ATR は持たない。
//  ・取得タイミング: NR-A1 と同じ (上位足の中で出力を [1]・lookahead_on。届くのは確定した上位足の状態だけ、
//    上位足確定後の最初の 5分足から)。追加の形成中フラグも同じ [1] で同じ足に届く。
//  ・Accum 終了: 同じ ID のまま形成中フラグが 0 になった上位足が届いた 5分足で上下限を固定 (以後変更しない)。
//    有効期限はこの 5分足の time から起算 (1H 3日 / 4H 7日 / D 30日)。形成中の上下限ではエントリーしない。
//    Keep Count (1H 3 / 4H 2 / D 1): 新しい ID が届いたとき、その時間足の (形成中を含む) 最新 Keep Count 個だけを有効に残す
//    (Engine の f_pruneAccumGenerations と同じ数え方)。押し出された Accum は期限切れと同じ扱い。
//  ・エントリー (確定 5分足で判断・次の 5分足始値で成行):
//    P1 上限ダマシ SHORT / P2 上限サポレジ LONG / P3 下限ダマシ LONG / P4 下限サポレジ SHORT (下に詳細)。
//  ・SL: P1 = 突破足〜ダマシ確定足の最高値 + Buffer / P2 = 上限 − Buffer / P3 = 最安値 − Buffer / P4 = 下限 + Buffer。
//    SL 幅 (判断足の終値から) が Min〜Max の外なら見送り (広げない・縮めない)。
//  ・TP: 利益方向で最も近い有効な Accum 境界 (全時間足・自分の Accum を含む・固定済み・期限内)。RR < 最低 RR なら見送り
//    (遠い境界へ飛ばさない)、以上ならその境界。境界がなければ固定 RR (実約定価格と初期 SL から計算)。
//  ・建値移動: 実約定価格から初期 SL までを 1R とし、含み益が Trigger (R) に届いたら stop を実約定価格へ (1 回だけ・TP は不変)。
//    リアルタイムは calc_on_every_tick で tick ごとに判定 (確定を待たない)。ヒストリカルは足の確定時にだけ実行されるため、
//    到達を確認した足の次の足から有効 (下の「検証できない部分」参照)。
//  ・資金管理: 元金基準額 × 損失率 = 予定損失予算 (円・単利)。strategy.convert_to_symbol で USD へ換算し、
//    判断足の終値〜SL から lot を lot 刻みで切り捨て (予算超過なら 1 刻み下げる)。最小 lot 未満は見送り。
//  ・新規エントリーとドテンは時間帯 (初期 日本時間 9:00〜翌 2:00、終了時刻は含まない) の中だけ。判定は次足始値の想定約定時刻
//    (= 判断足の time_close)。SL / TP / 建値移動は時間外も継続。
//  ・ドテン (初期 ON): 保有中に反対方向の有効シグナル → 次足始値で決済と逆方向エントリー (1 本の成行注文)。
//
//  ★ 注文と処理順 (確定 5分足の確定時):
//    (A) 毎実行 (形成中 tick を含む): 約定確認 → TP 確定 (固定 RR は実約定価格から) → 建値移動
//    (B) 確定足だけ: (B1) 上位足の Accum 状態を反映 (新規 / 形成中更新 / 終了固定 / Keep Count)
//        (B2) 既存の突破イベントを更新しシグナル候補を作る (期限 → 最高値 / 最安値 → ダマシ → リテスト → 乖離 の順)
//        (B3) 新しい突破イベントを開始 (この足の終値で突破した境界。突破足自身では P1〜P4 は出ない)
//        (B4) 候補の検査 (SL 幅 → RR / TP → 時間帯 → lot) → 時間足優先 (D > 4H > 1H) → 境界の近さ → 古い Accum
//             LONG と SHORT の有効候補が両方あればすべて見送り
//        (B5) 発注 (ノーポジ = 新規 / 反対ポジ + ドテン ON = ドテン / 同方向 = 無視)。entry と同時に SL・TP の exit を出す
//        (B6) 描画 (売買には影響しない)
//    SL / TP がシグナル足の中で約定済みなら確定時はノーポジなので、そのシグナルは通常の新規エントリーになる (ドテンではない)。
//    ドテン時は旧ポジの exit を取り消してから逆方向の entry を出す (次足始値で旧ポジ決済 + 新規を 1 注文。始値で旧 SL と
//    ドテンが重なっても価格は同じ始値で、数量が二重にならない)。
//
//  ★ 検証できない部分 (TradingView 実機での確認が必要):
//    ・ヒストリカル足は確定時に 1 回だけ実行される (calc_on_every_tick はリアルタイムだけ)。建値移動は Trigger 到達を
//      確認した足の次の足から有効で、到達した足の中で SL まで戻った場合は元の SL で決済される (tick の再現はできない)。
//      Bar Magnifier は約定価格の精度を上げるだけで、足の途中でスクリプトは実行されない。
//    ・固定 RR の TP は、約定するまでの間 (約定した足の中) は判断足の終値から計算した仮の TP。約定を確認した実行
//      (リアルタイム = 約定後の次の tick / ヒストリカル = 約定した足の確定時) で実約定価格からの TP に置き換える。
//    ・calc_on_order_fills は false (true の場合の履歴足の再計算タイミングを確認できていないため)。
// ============================================================================

//@version=5
strategy(
     title                   = "Accum Strategy XAU",
     shorttitle              = "ACC-ST",
     overlay                 = true,
     calc_on_every_tick      = true,
     calc_on_order_fills     = false,
     process_orders_on_close = false,
     pyramiding              = 0,
     initial_capital         = 300000,
     currency                = currency.JPY,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     max_lines_count         = 500,
     max_labels_count        = 500)

// ---- 5分足専用 ----------------------------------------------------------------
bool is5mChart = timeframe.isminutes and timeframe.multiplier == 5

// ============================================================================
// 01. INPUTS
// ============================================================================
var string G_TF = "01 · Accum 時間足"
acUse1  = input.bool(true, "1H Accum を使う", group = G_TF)
acUse2  = input.bool(true, "4H Accum を使う", group = G_TF)
acUse3  = input.bool(true, "日足 Accum を使う", group = G_TF,
     tooltip = "OFF の時間足は Accum の登録・突破・TP 候補・描画のすべてに使わない。")
acKeep1 = input.int(3, "Keep Count · 1H (instances)", minval = 1, group = G_TF)
acKeep2 = input.int(2, "Keep Count · 4H (instances)", minval = 1, group = G_TF)
acKeep3 = input.int(1, "Keep Count · D (instances)",  minval = 1, group = G_TF,
     tooltip = "新しい Accum (ID) が届いたとき、その時間足の最新 Keep Count 個 (形成中を含む) だけを有効に残す (既存 Engine と同じ数え方)。")
acLife1 = input.float(3.0,  "有効期限 · 1H (日)", minval = 0.0, step = 0.5, group = G_TF)
acLife2 = input.float(7.0,  "有効期限 · 4H (日)", minval = 0.0, step = 0.5, group = G_TF)
acLife3 = input.float(30.0, "有効期限 · D (日)",  minval = 0.0, step = 0.5, group = G_TF,
     tooltip = "Accum 終了 (上下限の固定) を確認した 5分足の時刻から起算。期限後は新しい突破イベントと TP 候補に使わない\n" +
     "(期限前に始まった突破イベントの待機は継続)。")

var string G_ACCP = "02 · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_EN = "03 · Entry"
enP1 = input.bool(true, "P1 · 上限ダマシ突破 → SHORT", group = G_EN)
enP2 = input.bool(true, "P2 · 上限サポレジ転換 → LONG", group = G_EN)
enP3 = input.bool(true, "P3 · 下限ダマシ突破 → LONG", group = G_EN)
enP4 = input.bool(true, "P4 · 下限サポレジ転換 → SHORT", group = G_EN,
     tooltip = "OFF のパターンは発注候補にしない (突破イベントの状態遷移は ON のときと同じ)。")
enRetestBars = input.int(24, "リテスト有効期限 (5分足本数)", minval = 1, group = G_EN,
     tooltip = "突破足 = 0 本目。1〜N 本目でシグナル可、N + 1 本目で期限切れ。実際に形成された 5分足だけを数える (休場は進まない)。")
enDev  = input.float(5.0, "サポレジ転換 · 最低乖離 ($)", minval = 0.0, step = 0.5, group = G_EN,
     tooltip = "上限突破後、終値 >= 上限 + この値 (下限は 終値 <= 下限 − この値) で乖離成立。突破足を含む。ダマシには使わない。")
enNear = input.float(3.0, "リテスト近接許容距離 ($)", minval = 0.0, step = 0.5, group = G_EN,
     tooltip = "乖離成立の後の足で、安値 <= 上限 + この値 (下限は 高値 >= 下限 − この値) かつ終値が境界の外側 (等値は不可) で反発成立。")
enFixMode = input.string("Wait for Cross", "Accum 確定時に終値が既に境界の外側", options = ["Wait for Cross", "Start at Fix"], group = G_EN,
     tooltip = "突破 = 前の 5分足終値 <= 上限 < 今の終値 (下限は 前 >= 下限 > 今)。Accum 終了の確定と同じ 5分足の突破も有効。\n" +
     "Wait for Cross: 確定した時点で前の終値から既に外側なら、いったん内側 (等値を含む) へ戻ってからの突破を待つ。\n" +
     "Start at Fix: 確定した 5分足の終値が外側なら、その足を突破足 (0 本目) として突破イベントを始める (比較用)。")

var string G_RK = "04 · SL / TP"
rkBuf   = input.float(1.5,  "SL Buffer ($)", minval = 0.0, step = 0.1, group = G_RK)
rkMinSl = input.float(5.0,  "Minimum SL ($)", minval = 0.0, step = 0.5, group = G_RK)
rkMaxSl = input.float(30.0, "Maximum SL ($)", minval = 0.0, step = 0.5, group = G_RK,
     tooltip = "SL 幅 = |判断足の終値 − SL|。Minimum 未満・Maximum 超は見送り (ちょうどは可)。SL は広げない・縮めない。")
rkRR    = input.float(1.5,  "固定 RR / 最低 RR", minval = 0.1, step = 0.1, group = G_RK)
rkTpAcc = input.bool(true, "TP · 利益方向の Accum 境界を使う", group = G_RK,
     tooltip = "ON: 利益方向で最も近い有効な Accum 境界の RR が最低 RR 以上ならその境界、未満なら見送り、境界がなければ固定 RR。\n" +
     "OFF: 常に固定 RR (比較用)。")

var string G_BE = "05 · 建値移動"
beOn = input.bool(true, "建値移動", group = G_BE)
beR  = input.float(1.0, "Trigger (R)", minval = 0.1, step = 0.1, group = G_BE,
     tooltip = "1R = |実約定価格 − 初期 SL|。Long は高値 >= 約定 + R × 1R、Short は安値 <= 約定 − R × 1R で stop を実約定価格へ。\n" +
     "リアルタイムは tick ごと (確定を待たない)。ヒストリカルは足の確定時の判定で次の足から有効。")

var string G_DT = "06 · ドテン"
dtOn = input.bool(true, "ドテン", group = G_DT,
     tooltip = "ON: 保有中に反対方向の有効シグナル (時間帯内・SL / RR / lot 条件を満たすもの) で、次足始値で決済して逆方向へ。\n" +
     "OFF: 保有中の反対シグナルは無視し、既存の SL / TP / 建値で決済。")

var string G_SE = "07 · 新規エントリーの時間帯"
seUse    = input.bool(true, "時間帯で新規エントリーを制限", group = G_SE)
seTz     = input.string("Asia/Tokyo", "Session Timezone", group = G_SE)
seStartH = input.int(9, "Start Hour", minval = 0, maxval = 23, group = G_SE)
seStartM = input.int(0, "Start Minute", minval = 0, maxval = 59, group = G_SE)
seEndH   = input.int(2, "End Hour (含まない)", minval = 0, maxval = 23, group = G_SE)
seEndM   = input.int(0, "End Minute", minval = 0, maxval = 59, group = G_SE,
     tooltip = "次足始値の想定約定時刻 (= 判断足の time_close) で判定。開始時刻は含み、終了時刻は含まない。")

var string G_MM = "08 · 資金管理 (単利・損失予算)"
mmCapBase = input.float(300000.0, "元金基準額 (円)", minval = 0.0, step = 10000.0, group = G_MM,
     tooltip = "単利: 予定損失予算 = この基準額 × 損失率 (残高・含み益・実現損益に連動しない)。")
mmRiskPct = input.float(3.0, "損失率 (%)", minval = 0.0, step = 0.1, group = G_MM)
mmLotOz   = input.float(100.0, "1 lot のオンス数", minval = 0.0001, step = 1.0, group = G_MM)
mmLotMin  = input.float(0.01, "最小 lot", minval = 0.0001, step = 0.01, group = G_MM)
mmLotStep = input.float(0.01, "lot 刻み", minval = 0.0001, step = 0.01, group = G_MM)

var string G_DS = "09 · 表示 (売買には影響しない)"
dsAcc    = input.bool(true, "Accum 上下限を表示", group = G_DS)
dsAccMax = input.int(30, "表示する Accum の最大数", minval = 1, maxval = 100, group = G_DS)
dsEnt    = input.bool(true, "エントリーラベルを表示", group = G_DS)
dsEntMax = input.int(50, "エントリーラベルの最大数", minval = 1, maxval = 200, group = G_DS)

// ============================================================================
// 02. ACCUM FEED (NR-A1 と同じ取得方式)
// ============================================================================
// ==== ACC Accum copy (begin) =================================================
//  f_acAccumBoxCore  = ZoneStrategyXAU.pine の f_nraAccumBoxCore (= Library f_accumBoxCore) と同一 (関数名だけ変更)。
//  f_acAccumBoxState = f_nraAccumBoxState と同一 + 最後の出力に形成中フラグ (_isAccum ? 1 : 0) を追加。
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== ACC Accum copy (end) ===================================================

//  上位足の中で 4 出力を [1] にし lookahead_on で取得 (NR-A1 の f_nraAccumConfirmed と同じ)。
//  5分足に届くのは確定した上位足の状態だけ (上位足確定後の最初の 5分足から。休場明けは最初の 5分足)。
f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

float acPrevClose = close[1]     // 突破判定用: 前の 5分足の終値

// ============================================================================
// 03. LOGIC
// ============================================================================
// ==== ACC Logic (begin) ======================================================
//  (この区間は tests/acc_sim.py が Python へ機械変換して実行する。na の算術・比較は使わない)
float EPS = 1e-7     // 浮動小数の誤差だけ吸収 (USD)

// Accum 1 個 (時間足ごと・ID ごと)。上限 / 下限は別々の境界として扱う (近い Accum の境界は統合しない)
type AcBox
    int   tf                  // 0 = 1H / 1 = 4H / 2 = D
    int   aid                 // 検出 ID (= 上位足の開始足の time)
    int   seq                 // 表示用の通し番号
    float up
    float lo
    bool  fixed    = false    // 終了を確認して上下限を固定した
    int   fixTime             // 固定した 5分足の time
    int   expTime             // 有効期限 (fixTime + 期限)
    bool  dead     = false    // Keep Count で押し出された
    bool  drawn    = false
    bool  shownExp = false
    line  lnU
    line  lnL
    label lbU
    label lbL

// 突破イベント 1 個 (境界ごと・突破ごと)
type AcEv
    int   tf
    int   aid
    int   aseq
    int   dir                 // 1 = 上限を上抜け / -1 = 下限を下抜け
    float lvl                 // 突破時の境界価格
    int   bBar                // 突破足の bar_index (0 本目)
    float ext                 // 突破足からの最高値 (dir 1) / 最安値 (dir -1)
    bool  dev      = false    // 乖離成立 (成立した足より後の足からリテスト可)
    int   devBar
    int   rtBar               // 最後にリテスト反発が成立した足
    int   nSig     = 0        // この突破から出たシグナル数

// シグナル候補 1 個 (確定足の中だけ)
type AcCand
    int   side                // 1 = LONG / -1 = SHORT
    int   pat                 // 1〜4
    int   tf
    int   aseq
    float lvl
    float sl
    float slw                 // SL 幅 (判断足の終値から)
    float tp
    int   tpMode   = 0        // 1 = Accum 境界 / 0 = 固定 RR
    float rr                  // 予定 RR (判断足の終値から)
    float qty
    float dist                // 判断足の終値と境界の距離
    int   why      = 0        // 0 = 有効 / 1 = SL 幅 / 2 = RR / 3 = 時間帯 / 4 = lot

var array<AcBox> acBoxes = array.new<AcBox>()     // 登録中の Accum (無効になったら外す)
var array<AcBox> acDrawn = array.new<AcBox>()     // 描画中の Accum (表示だけ)
var array<AcEv>  acEvs   = array.new<AcEv>()      // 有効な突破イベント
var array<label> acLbls  = array.new<label>()     // エントリーラベル
var int acSeq = 0
var array<int>   acLastId = array.new_int(3, na)   // 時間足ごとに前回届いた Accum ID

// 注文 / ポジション (1 つだけ)
var int    oState  = 0       // 0 なし / 1 entry 発注済み (約定待ち) / 2 保有中 / 3 不正な出口のため決済中
var int    oN      = 0       // 注文の通し番号
var string oId     = ""
var string oXid    = ""
var int    oSide   = 0
var int    oPat    = 0
var int    oTf     = 0
var float  oRef    = na      // 判断足の終値
var float  oSL     = na      // 初期 SL
var float  oTP     = na
var int    oTpMode = 0
var float  oQty    = na
var float  oFill   = na
var float  oStop   = na      // 現在の stop (初期 SL / 建値)
var bool   oBE     = false
var int    oBar    = na      // 発注した足
var int    oClosed = 0       // 発注時点の closedtrades
var float  oRRPlan = na
var float  oRRReal = na
var label  oLbl    = na
var string oTxt    = ""

// 集計 (Data Window)
var int nSig1 = 0
var int nSig2 = 0
var int nSig3 = 0
var int nSig4 = 0
var int nEnt1 = 0
var int nEnt2 = 0
var int nEnt3 = 0
var int nEnt4 = 0
var int nSkipSl   = 0
var int nSkipRR   = 0
var int nSkipSess = 0
var int nSkipQty  = 0
var int nConflict = 0
var int nDoten    = 0
var int nBE       = 0
var int nBadExit  = 0     // 約定ずれで SL / TP の価格関係が不正 → 出口注文を出さず成行決済
var int nQtyAnom  = 0     // 約定後の建玉数量が発注数量と違う

f_tfName(int k) =>
    k == 0 ? "1H" : k == 1 ? "4H" : "D"

f_tfUse(int k) =>
    k == 0 ? acUse1 : k == 1 ? acUse2 : acUse3

f_tfKeep(int k) =>
    k == 0 ? acKeep1 : k == 1 ? acKeep2 : acKeep3

f_tfLifeMs(int k) =>
    int(math.round((k == 0 ? acLife1 : k == 1 ? acLife2 : acLife3) * 86400000))

f_tfColor(int k) =>
    k == 0 ? color.teal : k == 1 ? color.orange : color.fuchsia

f_patName(int p) =>
    p == 1 ? "P1 上限ダマシ SHORT" : p == 2 ? "P2 上限サポレジ LONG" : p == 3 ? "P3 下限ダマシ LONG" : "P4 下限サポレジ SHORT"

f_patOn(int p) =>
    p == 1 ? enP1 : p == 2 ? enP2 : p == 3 ? enP3 : enP4

// 開始時刻を含み、終了時刻を含まない (開始 == 終了 は終日)
f_inSession(int t) =>
    int mins = hour(t, seTz) * 60 + minute(t, seTz)
    int s    = seStartH * 60 + seStartM
    int e    = seEndH * 60 + seEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)

// 新しい突破イベントと TP 候補に使える Accum: 固定済み・Keep Count 内・期限内・時間足 ON
f_valid(AcBox b) =>
    b.fixed and not b.dead and f_tfUse(b.tf) and time < b.expTime

f_findBox(int k, int aid) =>
    int r = -1
    int n = array.size(acBoxes)
    if n > 0
        for i = 0 to n - 1
            AcBox b = array.get(acBoxes, i)
            if b.tf == k and b.aid == aid
                r := i
                break
    r

f_hasEv(int k, int aid, int dir) =>
    bool r = false
    int n = array.size(acEvs)
    if n > 0
        for i = 0 to n - 1
            AcEv e = array.get(acEvs, i)
            if e.tf == k and e.aid == aid and e.dir == dir
                r := true
                break
    r

// 利益方向で最も近い有効な Accum 境界 (ref より厳密に先。なければ na)
f_tpBoundary(int side, float ref) =>
    float best = na
    int n = array.size(acBoxes)
    if n > 0
        for i = 0 to n - 1
            AcBox b = array.get(acBoxes, i)
            if f_valid(b)
                if side == 1
                    if b.up > ref and (na(best) or b.up < best)
                        best := b.up
                    if b.lo > ref and (na(best) or b.lo < best)
                        best := b.lo
                else
                    if b.up < ref and (na(best) or b.up > best)
                        best := b.up
                    if b.lo < ref and (na(best) or b.lo > best)
                        best := b.lo
    best

// 数量 (ZoneStrategyXAU f_stQty と同じ式): 円の予算を strategy.convert_to_symbol で USD へ換算 (固定 USDJPY なし)。
//  lot = 予算 USD ÷ (SL 距離 × 1 lot のオンス数) を lot 刻みで切り捨て、予算超過なら 1 刻み下げる。最小 lot 未満は na。
//  qty = lot × 1 lot のオンス数 ÷ syminfo.pointvalue。参照価格 (判断足の終値) に対する予定損失で、約定ずれ・スプレッド・
//  手数料を含む実損失の上限ではない。
f_qty(int side, float ref, float sl) =>
    float budget = mmCapBase * mmRiskPct / 100.0
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = budget > 0 ? strategy.convert_to_symbol(budget) : na
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and mmLotOz > 0 and mmLotStep > 0 and mmLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * mmLotOz * mmLotStep) + 1e-9)
        if n * mmLotStep * mmLotOz * dist > budSym
            n := n - 1
        if n >= 1 and n * mmLotStep >= mmLotMin * (1 - 1e-9)
            q := n * mmLotStep * mmLotOz / pv
    q

// 候補の検査 (SL 幅 → RR / TP → 時間帯 → lot)。最初に満たさなかった条件を why に残す
f_cand(int side, int pat, int tf, int aseq, float lvl, float sl, bool sessOK) =>
    float ref = close
    float slw = side * (ref - sl)
    AcCand c = AcCand.new(side, pat, tf, aseq, lvl, sl, slw)
    c.dist := math.abs(ref - lvl)
    if slw < rkMinSl - EPS or slw > rkMaxSl + EPS
        c.why := 1
    else
        float bnd = rkTpAcc ? f_tpBoundary(side, ref) : na
        if not na(bnd)
            c.tp     := bnd
            c.tpMode := 1
            c.rr     := side * (bnd - ref) / slw
            if c.rr < rkRR - EPS
                c.why := 2
        else
            c.tp     := ref + side * rkRR * slw
            c.tpMode := 0
            c.rr     := rkRR
        if c.why == 0 and not sessOK
            c.why := 3
        if c.why == 0
            c.qty := f_qty(side, ref, sl)
            if na(c.qty)
                c.why := 4
    c

// a が b より優先なら true: 時間足 (D > 4H > 1H) → 判断足の終値に近い境界 → 古い Accum
f_better(AcCand a, AcCand b) =>
    a.tf != b.tf ? a.tf > b.tf : a.dist != b.dist ? a.dist < b.dist : a.aseq < b.aseq

f_candText(AcCand c) =>
    f_patName(c.pat) + "\n" + f_tfName(c.tf) + " Accum #" + str.tostring(c.aseq) + "  境界 " + str.tostring(c.lvl, "#.##") +
     "\n判断 " + str.tostring(close, "#.##") + "  SL " + str.tostring(c.sl, "#.##") +
     "\nTP " + str.tostring(c.tp, "#.##") + (c.tpMode == 1 ? " (Accum 境界)" : " (固定 RR・約定後に再計算)") +
     "\n予定 RR " + str.tostring(c.rr, "#.##") + "  lot " + str.tostring(c.qty * syminfo.pointvalue / mmLotOz, "#.##")

bool acRun  = is5mChart
bool sessOK = not seUse or f_inSession(time_close)

if acRun
    // ---- (A) 毎実行 (形成中 tick を含む): 約定確認 → TP 確定 → 建値移動 --------------------------------
    //  リアルタイムの形成中 tick で変えた var は次の tick で巻き戻るが、判定は strategy の約定事実と確定済みの状態から
    //  毎回同じ結果を出す (exit 注文の更新は同じ ID・同じ価格で冪等)。
    if oState == 1
        int  ot = strategy.opentrades
        int  ct = strategy.closedtrades
        bool fo = false
        bool fc = false
        if ot > 0
            fo := strategy.opentrades.entry_id(ot - 1) == oId
        if not fo and ct > oClosed
            fc := strategy.closedtrades.entry_id(ct - 1) == oId
        if fo
            oFill  := strategy.opentrades.entry_price(ot - 1)
            oState := 2
            if math.abs(math.abs(strategy.position_size) - oQty) > oQty * 1e-6
                nQtyAnom += 1
            float risk = oSide * (oFill - oSL)
            if oTpMode == 0 and risk > 0
                oTP := oFill + oSide * rkRR * risk
            if risk > 0 and oSide * (oTP - oFill) > 0
                oStop   := oSL
                oRRReal := oSide * (oTP - oFill) / risk
                strategy.exit(oXid, oId, stop = oStop, limit = oTP)
            else
                // 約定ずれで初期 SL / TP が約定価格の反対側: 無効な出口注文を出さず成行で決済
                strategy.cancel(oXid)
                strategy.close(oId)
                oState  := 3
                oRRReal := na
                nBadExit += 1
            if not na(oLbl)
                label.set_text(oLbl, oTxt + "\n約定 " + str.tostring(oFill, "#.##") + "  TP " + str.tostring(oTP, "#.##") +
                     "  実 RR " + (na(oRRReal) ? "-" : str.tostring(oRRReal, "#.##")))
        else if fc
            // 約定した足の中で SL / TP まで決済済み
            oFill  := strategy.closedtrades.entry_price(ct - 1)
            oState := 0
            float risk = oSide * (oFill - oSL)
            oRRReal := risk > 0 ? oSide * (oTP - oFill) / risk : na
            // 約定ずれで初期 SL / 境界 TP が約定価格の反対側だった (ギャップ約定の直後に exit が成立した場合も数える)
            if risk <= 0 or (oTpMode == 1 and oSide * (oTP - oFill) <= 0)
                nBadExit += 1
            if not na(oLbl)
                label.set_text(oLbl, oTxt + "\n約定 " + str.tostring(oFill, "#.##") + "  (約定足で決済)")
        else if barstate.isconfirmed and bar_index > oBar
            strategy.cancel(oId)
            strategy.cancel(oXid)
            oState := 0
    else if oState >= 2 and strategy.position_size == 0
        oState := 0

    if beOn and oState == 2 and not oBE and strategy.position_size != 0
        float r1   = oSide * (oFill - oSL)
        float trig = oFill + oSide * beR * r1
        if (oSide == 1 and high >= trig) or (oSide == -1 and low <= trig)
            oBE   := true
            oStop := oFill
            nBE   += 1
            strategy.exit(oXid, oId, stop = oStop, limit = oTP)

    // ---- (B) 確定足だけ ----------------------------------------------------------------------------
    if barstate.isconfirmed
        // (B1) 上位足の Accum 状態を反映
        array<float> fU = array.from(f1u, f2u, f3u)
        array<float> fL = array.from(f1l, f2l, f3l)
        array<int>   fI = array.from(f1i, f2i, f3i)
        array<int>   fA = array.from(f1a, f2a, f3a)
        for k = 0 to 2
            int   aid = array.get(fI, k)
            float u   = array.get(fU, k)
            float l   = array.get(fL, k)
            if f_tfUse(k) and not na(aid) and not na(u) and not na(l)
                bool forming = array.get(fA, k) == 1
                int  last    = array.get(acLastId, k)
                if na(last) or aid != last
                    // 新しい Accum (ID が前回と違う = 既存 Engine と同じ判定)。上位足は終了後も同じ ID・上下限を送り続けるため、
                    // 新しい ID の判定は「前回届いた ID」と比べる (期限切れで登録から外した Accum を再登録しない)。
                    // 同じ時間足に未固定の Accum が残っていれば (終了の上位足を取りこぼした場合) ここで固定する
                    array.set(acLastId, k, aid)
                    int n0 = array.size(acBoxes)
                    if n0 > 0
                        for i = 0 to n0 - 1
                            AcBox q = array.get(acBoxes, i)
                            if q.tf == k and not q.fixed
                                q.fixed   := true
                                q.fixTime := time
                                q.expTime := time + f_tfLifeMs(k)
                    acSeq += 1
                    AcBox b = AcBox.new(k, aid, acSeq, u, l)
                    if not forming
                        b.fixed   := true
                        b.fixTime := time
                        b.expTime := time + f_tfLifeMs(k)
                    array.push(acBoxes, b)
                    // Keep Count: この時間足の (形成中を含む) 最新 Keep Count 個だけ残す。古い ID から押し出す
                    int live = 0
                    int n1   = array.size(acBoxes)
                    for i = 0 to n1 - 1
                        AcBox q = array.get(acBoxes, i)
                        if q.tf == k and not q.dead
                            live += 1
                    while live > f_tfKeep(k)
                        int oi = -1
                        int oa = 0
                        for i = 0 to n1 - 1
                            AcBox q = array.get(acBoxes, i)
                            if q.tf == k and not q.dead and (oi < 0 or q.aid < oa)
                                oi := i
                                oa := q.aid
                        AcBox qo = array.get(acBoxes, oi)
                        qo.dead := true
                        live -= 1
                else
                    // 同じ ID: 形成中は上下限を更新、形成中フラグが 0 になった足で固定 (固定後・登録から外した後は何もしない)
                    int bi = f_findBox(k, aid)
                    if bi >= 0
                        AcBox b = array.get(acBoxes, bi)
                        if not b.fixed
                            b.up := u
                            b.lo := l
                            if not forming
                                b.fixed   := true
                                b.fixTime := time
                                b.expTime := time + f_tfLifeMs(k)

        // (B2) 既存の突破イベント: 期限 → 最高値 / 最安値 → ダマシ → リテスト → 乖離
        array<AcCand> cands = array.new<AcCand>()
        int ne = array.size(acEvs)
        if ne > 0
            for i = ne - 1 to 0
                AcEv e = array.get(acEvs, i)
                int age = bar_index - e.bBar
                if age > enRetestBars
                    array.remove(acEvs, i)
                else if age >= 1
                    e.ext := e.dir == 1 ? math.max(e.ext, high) : math.min(e.ext, low)
                    bool fake = e.dir == 1 ? close < e.lvl : close > e.lvl
                    if fake
                        // P1 (上限) / P3 (下限): 境界の内側へ終値で戻った。SL = 突破足〜この足の最高値 + Buffer / 最安値 − Buffer
                        int pf = e.dir == 1 ? 1 : 3
                        e.nSig += 1
                        if f_patOn(pf)
                            array.push(cands, f_cand(-e.dir, pf, e.tf, e.aseq, e.lvl, e.ext + e.dir * rkBuf, sessOK))
                        array.remove(acEvs, i)
                    else
                        // P2 (上限) / P4 (下限): 乖離成立後の足で、ヒゲが境界 ± 近接距離まで戻り、終値が境界の外側
                        bool rt = e.dev and (e.dir == 1 ? (low - e.lvl <= enNear + EPS and close > e.lvl) : (e.lvl - high <= enNear + EPS and close < e.lvl))
                        if rt
                            int pr = e.dir == 1 ? 2 : 4
                            e.rtBar := bar_index
                            e.nSig  += 1
                            if f_patOn(pr)
                                array.push(cands, f_cand(e.dir, pr, e.tf, e.aseq, e.lvl, e.lvl - e.dir * rkBuf, sessOK))
                        if not e.dev and e.dir * (close - e.lvl) >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index

        // (B3) 新しい突破イベント: 有効な Accum の境界を終値で突破 (等値は突破ではない)。同じ境界で進行中のイベントがあれば始めない
        int nb = array.size(acBoxes)
        if nb > 0
            for i = 0 to nb - 1
                AcBox b = array.get(acBoxes, i)
                if f_valid(b)
                    bool atFix = enFixMode == "Start at Fix" and b.fixTime == time
                    if close > b.up and ((not na(acPrevClose) and acPrevClose <= b.up) or atFix) and not f_hasEv(b.tf, b.aid, 1)
                        AcEv e = AcEv.new(b.tf, b.aid, b.seq, 1, b.up, bar_index, high)
                        if close - b.up >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index
                        array.push(acEvs, e)
                    if close < b.lo and ((not na(acPrevClose) and acPrevClose >= b.lo) or atFix) and not f_hasEv(b.tf, b.aid, -1)
                        AcEv e = AcEv.new(b.tf, b.aid, b.seq, -1, b.lo, bar_index, low)
                        if b.lo - close >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index
                        array.push(acEvs, e)

        // (B4) 候補の選定: 有効な候補だけ → 時間足優先 → 近い境界 → 古い Accum。LONG と SHORT が両方あれば見送り
        AcCand bestL = na
        AcCand bestS = na
        int nc = array.size(cands)
        if nc > 0
            for i = 0 to nc - 1
                AcCand c = array.get(cands, i)
                nSig1 += c.pat == 1 ? 1 : 0
                nSig2 += c.pat == 2 ? 1 : 0
                nSig3 += c.pat == 3 ? 1 : 0
                nSig4 += c.pat == 4 ? 1 : 0
                nSkipSl   += c.why == 1 ? 1 : 0
                nSkipRR   += c.why == 2 ? 1 : 0
                nSkipSess += c.why == 3 ? 1 : 0
                nSkipQty  += c.why == 4 ? 1 : 0
                if c.why == 0
                    if c.side == 1
                        if na(bestL)
                            bestL := c
                        else if f_better(c, bestL)
                            bestL := c
                    else
                        if na(bestS)
                            bestS := c
                        else if f_better(c, bestS)
                            bestS := c
        AcCand pick = na
        if not na(bestL) and not na(bestS)
            nConflict += 1
        else if not na(bestL)
            pick := bestL
        else if not na(bestS)
            pick := bestS

        // (B5) 発注: ノーポジ = 新規 / 反対ポジ + ドテン ON = ドテン / 同方向・ドテン OFF = 何もしない
        if not na(pick)
            float pos  = strategy.position_size
            bool  flat = oState == 0 and pos == 0
            bool  rev  = dtOn and oState == 2 and pos != 0 and (pos > 0 ? 1 : -1) != pick.side
            if flat or rev
                if rev
                    // 旧ポジの SL / TP を取り消す (次足始値の逆方向 entry 1 注文で決済 + 新規。数量の二重化を防ぐ)
                    strategy.cancel(oXid)
                    nDoten += 1
                oN      += 1
                oId     := (pick.side == 1 ? "L" : "S") + str.tostring(oN)
                oXid    := "X" + str.tostring(oN)
                oSide   := pick.side
                oPat    := pick.pat
                oTf     := pick.tf
                oRef    := close
                oSL     := pick.sl
                oTP     := pick.tp
                oTpMode := pick.tpMode
                oQty    := pick.qty
                oFill   := na
                oStop   := pick.sl
                oBE     := false
                oBar    := bar_index
                oClosed := strategy.closedtrades
                oRRPlan := pick.rr
                oRRReal := na
                oState  := 1
                nEnt1 += pick.pat == 1 ? 1 : 0
                nEnt2 += pick.pat == 2 ? 1 : 0
                nEnt3 += pick.pat == 3 ? 1 : 0
                nEnt4 += pick.pat == 4 ? 1 : 0
                strategy.entry(oId, pick.side == 1 ? strategy.long : strategy.short, qty = pick.qty)
                strategy.exit(oXid, oId, stop = pick.sl, limit = pick.tp)
                oLbl := na
                oTxt := (rev ? "[ドテン] " : "") + f_candText(pick)
                if dsEnt
                    oLbl := label.new(bar_index, pick.side == 1 ? low : high, oTxt,
                         style = pick.side == 1 ? label.style_label_up : label.style_label_down,
                         color = pick.side == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
                         textcolor = color.white, size = size.small)
                    array.push(acLbls, oLbl)
                    if array.size(acLbls) > dsEntMax
                        label.delete(array.shift(acLbls))

        // (B6) 描画 (Accum 上下限・有効 / 期限切れ) と登録の整理
        int nb2 = array.size(acBoxes)
        if nb2 > 0
            for i = nb2 - 1 to 0
                AcBox b = array.get(acBoxes, i)
                if dsAcc and b.fixed and not b.drawn
                    b.drawn := true
                    color col = f_tfColor(b.tf)
                    string nm = f_tfName(b.tf) + " Accum #" + str.tostring(b.seq) + " (ID " + str.format_time(b.aid, "MM-dd HH:mm", seTz) + ")"
                    b.lnU := line.new(b.aid, b.up, b.expTime, b.up, xloc = xloc.bar_time, color = col, width = 2)
                    b.lnL := line.new(b.aid, b.lo, b.expTime, b.lo, xloc = xloc.bar_time, color = col, width = 2)
                    b.lbU := label.new(b.aid, b.up, nm + " 上限 " + str.tostring(b.up, "#.##") + " · 有効", xloc = xloc.bar_time,
                         style = label.style_label_lower_left, color = color.new(col, 85), textcolor = col, size = size.small)
                    b.lbL := label.new(b.aid, b.lo, nm + " 下限 " + str.tostring(b.lo, "#.##") + " · 有効", xloc = xloc.bar_time,
                         style = label.style_label_upper_left, color = color.new(col, 85), textcolor = col, size = size.small)
                    array.push(acDrawn, b)
                    if array.size(acDrawn) > dsAccMax
                        AcBox od = array.shift(acDrawn)
                        line.delete(od.lnU)
                        line.delete(od.lnL)
                        label.delete(od.lbU)
                        label.delete(od.lbL)
                if b.fixed and not f_valid(b)
                    array.remove(acBoxes, i)
        int nd = array.size(acDrawn)
        if nd > 0
            for i = 0 to nd - 1
                AcBox b = array.get(acDrawn, i)
                if not b.shownExp and not f_valid(b)
                    b.shownExp := true
                    string st = b.dead ? " · Keep 超過" : " · 期限切れ"
                    line.set_color(b.lnU, color.gray)
                    line.set_color(b.lnL, color.gray)
                    line.set_style(b.lnU, line.style_dotted)
                    line.set_style(b.lnL, line.style_dotted)
                    label.set_text(b.lbU, label.get_text(b.lbU) + st)
                    label.set_text(b.lbL, label.get_text(b.lbL) + st)
                    label.set_textcolor(b.lbU, color.gray)
                    label.set_textcolor(b.lbL, color.gray)
// ==== ACC Logic (end) ========================================================

// ============================================================================
// 04. DATA WINDOW
// ============================================================================
plot(oState == 2 ? oStop : na, "ACC · Stop (SL / 建値)", color = color.red, style = plot.style_linebr)
plot(oState == 2 ? oTP : na,   "ACC · TP",              color = color.green, style = plot.style_linebr)
plot(oState == 2 ? oFill : na, "ACC · 約定価格",          display = display.data_window)
plot(oState >= 1 ? oRRPlan : na, "ACC · 予定 RR",        display = display.data_window)
plot(oState == 2 ? oRRReal : na, "ACC · 実 RR (約定価格)", display = display.data_window)
plot(oState >= 1 ? oTf : na,   "ACC · 採用 Accum 時間足 (0 = 1H / 1 = 4H / 2 = D)", display = display.data_window)
plot(oState >= 1 ? oPat : na,  "ACC · 採用パターン",     display = display.data_window)
plot(nSig1, "ACC · シグナル P1", display = display.data_window)
plot(nSig2, "ACC · シグナル P2", display = display.data_window)
plot(nSig3, "ACC · シグナル P3", display = display.data_window)
plot(nSig4, "ACC · シグナル P4", display = display.data_window)
plot(nEnt1, "ACC · 発注 P1", display = display.data_window)
plot(nEnt2, "ACC · 発注 P2", display = display.data_window)
plot(nEnt3, "ACC · 発注 P3", display = display.data_window)
plot(nEnt4, "ACC · 発注 P4", display = display.data_window)
plot(nSkipSl,   "ACC · 見送り SL 幅",   display = display.data_window)
plot(nSkipRR,   "ACC · 見送り RR",      display = display.data_window)
plot(nSkipSess, "ACC · 見送り 時間帯",  display = display.data_window)
plot(nSkipQty,  "ACC · 見送り lot",     display = display.data_window)
plot(nConflict, "ACC · 見送り LONG/SHORT 競合", display = display.data_window)
plot(nDoten,    "ACC · ドテン",         display = display.data_window)
plot(nBE,       "ACC · 建値移動",       display = display.data_window)
plot(nBadExit,  "ACC · 不正な出口 (成行決済)", display = display.data_window)
plot(nQtyAnom,  "ACC · 数量の不一致",   display = display.data_window)
plot(array.size(acEvs), "ACC · 有効な突破イベント", display = display.data_window)

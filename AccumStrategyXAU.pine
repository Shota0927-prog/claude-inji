// ============================================================================
// 02. ACCUM FEED (NR-A1 と同じ取得方式)
// ============================================================================
// ==== ACC Accum copy (begin) =================================================
//  f_acAccumBoxCore  = ZoneStrategyXAU.pine の f_nraAccumBoxCore (= Library f_accumBoxCore) と同一 (関数名だけ変更)。
//  f_acAccumBoxState = f_nraAccumBoxState と同一 + 最後の出力に形成中フラグ (_isAccum ? 1 : 0) を追加。
f_acAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_acAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_acAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot, _isAccum ? 1 : 0]
// ==== ACC Accum copy (end) ===================================================

//  上位足の中で 4 出力を [1] にし lookahead_on で取得 (NR-A1 の f_nraAccumConfirmed と同じ)。
//  5分足に届くのは確定した上位足の状態だけ (上位足確定後の最初の 5分足から。休場明けは最初の 5分足)。
f_acConfirmed(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    [_i, _u, _l, _a] = f_acAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [_u[1], _l[1], _i[1], _a[1]]

[f1u, f1l, f1i, f1a] = request.security(syminfo.tickerid, "60", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f2u, f2l, f2i, f2a] = request.security(syminfo.tickerid, "240", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)
[f3u, f3l, f3i, f3a] = request.security(syminfo.tickerid, "D", f_acConfirmed(accumRangeLen, accumBaseLen, accumAtrLen,
     accumMinUpperCloses, accumMinLowerCloses, accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
     lookahead = barmerge.lookahead_on)

float acPrevClose = close[1]     // 突破判定用: 前の 5分足の終値
// ACC-5A FVG 用: 確定した 1 本前 / 2 本前の 5分足 (現在の足は確定足の分岐の中で使う)
float acH2 = high[2]
float acL2 = low[2]
float acO1 = open[1]
float acC1 = close[1]

// ACC-5B: 15分 / 1時間 / 4時間 / 日足の確定した 1 本 (上位足の中で [1]・lookahead_on = NR-A1 と同じ。届くのは確定した足だけ)
[dvh1, dvl1, dvt1] = request.security(syminfo.tickerid, "15",  [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh2, dvl2, dvt2] = request.security(syminfo.tickerid, "60",  [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh3, dvl3, dvt3] = request.security(syminfo.tickerid, "240", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[dvh4, dvl4, dvt4] = request.security(syminfo.tickerid, "D",   [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)

// ============================================================================
// 03. LOGIC
// ============================================================================
// ==== ACC Logic (begin) ======================================================
//  (この区間は tests/acc_sim.py が Python へ機械変換して実行する。na の算術・比較は使わない)
float EPS = 1e-7     // 浮動小数の誤差だけ吸収 (USD)

// Accum 1 個 (時間足ごと・ID ごと)。上限 / 下限は別々の境界として扱う (近い Accum の境界は統合しない)
type AcBox
    int   tf                  // 0 = 1H / 1 = 4H / 2 = D
    int   aid                 // 検出 ID (= 上位足の開始足の time)
    int   seq                 // 表示用の通し番号
    float up
    float lo
    bool  fixed    = false    // 終了を確認して上下限を固定した
    int   fixTime             // 固定した 5分足の time
    int   expTime             // 有効期限 (fixTime + 期限)
    bool  dead     = false    // Keep Count で押し出された
    bool  drawn    = false
    bool  shownExp = false
    line  lnU
    line  lnL
    label lbU
    label lbL
    bool  armU     = true     // ACC-4 P5: 上限で新しい接触を作れる (接触・突破で false、再アームで true)
    bool  armL     = true     // ACC-4 P6: 下限で新しい接触を作れる

// 突破イベント 1 個 (境界ごと・突破ごと)
type AcEv
    int   tf
    int   aid
    int   aseq
    int   dir                 // 1 = 上限を上抜け / -1 = 下限を下抜け
    float lvl                 // 突破時の境界価格
    int   bBar                // 突破足の bar_index (0 本目)
    float ext                 // 突破足からの最高値 (dir 1) / 最安値 (dir -1)
    bool  dev      = false    // 乖離成立 (成立した足より後の足からリテスト可)
    int   devBar
    int   rtBar               // 最後にリテスト反発が成立した足
    int   nSig     = 0        // この突破から出たシグナル数

// シグナル候補 1 個 (確定足の中だけ)
type AcCand
    int   side                // 1 = LONG / -1 = SHORT
    int   pat                 // 1〜4
    int   tf
    int   aseq
    float lvl
    float sl
    float slw                 // SL 幅 (判断足の終値から)
    float tp
    int   tpMode   = 0        // 1 = Accum 境界 / 0 = 固定 RR
    float rr                  // 予定 RR (判断足の終値から)
    float qty
    float dist                // 判断足の終値と境界の距離
    int   why      = 0        // 0 = 有効 / 1 = SL 幅 / 2 = RR / 3 = 時間帯 / 4 = lot / 5 = P5・P6 の SL 幅 / 6 = P5・P6 の RR・TP
    int   rtId     = -1       // ACC-4: P5 / P6 の待機 ID (P1〜P4 は -1)

// ACC-4: P5 / P6 の接触待機 1 個 (Accum の境界ごと。接触時の上下限・ID・時間足を保存)
type AcRt
    int   id
    int   tf
    int   aid
    int   aseq
    int   side                // -1 = P5 上限 (SHORT) / 1 = P6 下限 (LONG)
    float up
    float lo
    int   tBar                // 接触足の bar_index (0 本目)
    // ACC-5A: この待機の FVG 吸収根拠 (接触足以後の吸収だけ。待機が終われば一緒に消える)
    int   evFvgId  = -1       // 吸収した FVG の ID (-1 = 根拠なし)
    int   evFvgBar            // FVG の形成足
    float evFvgLo
    float evFvgHi
    int   evAbsBar            // 吸収足 (0 本目)
    int   evExpBar            // 根拠の最後の有効足 (吸収足 + 有効期限)
    bool  evOn     = false    // この確定足の時点で根拠が有効
    // ACC-5B: この待機のダブル / トリプル根拠 (接触足以後の検知だけ。待機が終われば一緒に消える)
    int   dvId     = -1       // 検知した基準の ID (-1 = 根拠なし)
    int   dvTf                // 基準の時間足 (0 = 5分 / 1 = 15分 / 2 = 1時間 / 3 = 4時間 / 4 = 日足)
    float dvLvl               // 基準の高値 H / 安値 L
    int   dvCnt               // 接近回数 (2 = ダブル / 3 = トリプル)
    int   dvAppBar            // 接近足
    int   dvDetBar            // 検知足 (0 本目)
    int   dvExpBar            // 根拠の最後の有効足
    bool  dvOn     = false

// ACC-5B: 時間足ごとの直近 (2N + 1) 本の高値・安値 (山・谷の判定用)
type DvTf
    array<float> hs
    array<float> ls
    int   lastT               // 最後に取り込んだ足の time

// ACC-5B: ダブル / トリプルの基準 (山 = トップ / 谷 = ボトム)
type DvBase
    int   id
    int   tf
    int   side                // -1 = トップ (H、SHORT 側) / 1 = ボトム (L、LONG 側)
    float lvl
    int   pTime               // 山・谷の足の time
    int   aBar                // 基準が届いた (使えるようになった) 5分足
    bool  away                // 最低離れ幅を満たしている (次の接近を数えられる)
    int   cnt      = 1        // 接近回数 (山・谷そのものが 1 回目)
    bool  waiting  = false    // 接近後の反転待ち
    int   appBar
    int   waitEnd             // 反転待ちの最後の足

// ACC-5A: 監視中の FVG (方向ごとに最新の未吸収 1 個)
type AcFvg
    int   id
    int   dir                 // 1 = 上昇 FVG (SHORT 吸収用) / -1 = 下降 FVG (LONG 吸収用)
    int   fBar                // 形成足 (3 本目) の bar_index
    float lo
    float hi
    box   bx

var array<AcBox> acBoxes = array.new<AcBox>()     // 登録中の Accum (無効になったら外す)
var array<AcBox> acDrawn = array.new<AcBox>()     // 描画中の Accum (表示だけ)
var array<AcEv>  acEvs   = array.new<AcEv>()      // 有効な突破イベント
var array<label> acLbls  = array.new<label>()     // エントリーラベル
var int acSeq = 0
var array<int>   acLastId = array.new_int(3, na)   // 時間足ごとに前回届いた Accum ID
var array<AcRt>  acRts    = array.new<AcRt>()     // ACC-4: P5 / P6 の接触待機
var int acRtSeq = 0
var AcFvg acFvUp = na                              // ACC-5A: 監視中の上昇 FVG
var AcFvg acFvDn = na                              // ACC-5A: 監視中の下降 FVG
var int   acFvSeq = 0
var array<box>   acFvBoxes = array.new<box>()      // ACC-5A 表示
var array<label> acFvLbls  = array.new<label>()
var array<DvTf>   dvTfs   = array.new<DvTf>()     // ACC-5B
var array<DvBase> dvBases = array.new<DvBase>()
var array<label>  dvLbls  = array.new<label>()
var int dvSeq = 0

// 注文 / ポジション (1 つだけ)
var int    oState  = 0       // 0 なし / 1 entry 発注済み (約定待ち) / 2 保有中 / 3 不正な出口のため決済中
var int    oN      = 0       // 注文の通し番号
var string oId     = ""
var string oXid    = ""
var int    oSide   = 0
var int    oPat    = 0
var int    oTf     = 0
var float  oRef    = na      // 判断足の終値
var float  oSL     = na      // 初期 SL
var float  oTP     = na
var int    oTpMode = 0
var float  oQty    = na
var float  oFill   = na
var float  oStop   = na      // 現在の stop (初期 SL / 建値)
var bool   oBE     = false
var int    oBar    = na      // 発注した足
var int    oClosed = 0       // 発注時点の closedtrades
var float  oRRPlan = na
var float  oRRReal = na
var label  oLbl    = na
var string oTxt    = ""

// 集計 (Data Window)
var int nSig1 = 0
var int nSig2 = 0
var int nSig3 = 0
var int nSig4 = 0
var int nEnt1 = 0
var int nEnt2 = 0
var int nEnt3 = 0
var int nEnt4 = 0
var int nSkipSl   = 0
var int nSkipRR   = 0
var int nSkipSess = 0
var int nSkipQty  = 0
var int nConflict = 0
var int nDoten    = 0
var int nBE       = 0
var int nBadExit  = 0     // 約定ずれで SL / TP の価格関係が不正 → 出口注文を出さず成行決済
var int nQtyAnom  = 0     // 約定後の建玉数量が発注数量と違う
// ACC-4 P5 / P6 (見送りの SL 幅 / RR は P5・P6 専用。時間帯 / lot / 競合は既存の集計に含む)
var int nTouch5  = 0
var int nTouch6  = 0
var int nSig5    = 0
var int nSig6    = 0
var int nEnt5    = 0
var int nEnt6    = 0
var int nRgExp   = 0     // 待機の期限切れ
var int nRgBrk   = 0     // 終値の突破で解除した待機
var int nSkipSl56 = 0
var int nSkipRR56 = 0
// ACC-5A FVG (形成 / 吸収 / 待機の根拠は別々に数える。売買の集計には含めない)
var int nFvUp     = 0     // 上昇 FVG の検出
var int nFvDn     = 0     // 下降 FVG の検出
var int nFvUpAbs  = 0     // 上昇 FVG の吸収 (SHORT 吸収)
var int nFvDnAbs  = 0     // 下降 FVG の吸収 (LONG 吸収)
var int nFvEv5    = 0     // P5 待機に紐づいた吸収 (待機 1 個 × 吸収 1 回 = 1)
var int nFvEv6    = 0     // P6 待機に紐づいた吸収
var int nFvEvExp  = 0     // 待機中に吸収後の有効期限を過ぎた根拠
// ACC-5B ダブル / トリプル (基準 / 接近 / 検知 / 根拠を別々に数える。売買の集計には含めない)
var int nDvTop    = 0     // トップの基準 (山) の登録
var int nDvBot    = 0     // ボトムの基準 (谷) の登録
var int nDvApp    = 0     // 接近 (2 回目・3 回目)
var int nDvDetT2  = 0     // ダブルトップの検知 (2 回目の接近)
var int nDvDetT3  = 0     // トリプルトップの検知
var int nDvDetB2  = 0     // ダブルボトムの検知
var int nDvDetB3  = 0     // トリプルボトムの検知
var int nDvDetApp = 0     // 接近足での検知
var int nDvDetLat = 0     // 接近の後 (反転待ちの間) の検知
var int nDvExp    = 0     // 反転待ちの期限切れ (見送り)
var int nDvInv    = 0     // 終値による無効化
var int nDvEv5    = 0     // P5 待機に紐づいた検知
var int nDvEv6    = 0     // P6 待機に紐づいた検知
var int nDvEvExp  = 0     // 待機中に検知後の有効期限を過ぎた根拠
var int nDvMaxAct = 0     // 同時に保持した有効な基準の最大数
// ACC-2 診断 (ヒストリカルの確定足だけ。売買には使わない): リアルタイムの即時建値 / 約定直後の TP と結果が異なり得た件数
var int nBeRevisit  = 0   // +1R に届いた足で建値 (実約定価格) まで戻る値幅もあった (リアルタイムなら建値決済の可能性)
var int nBeSlConf   = 0   // +1R に届いた足で初期 SL 決済になった (リアルタイムで +1R が先なら建値決済)
var int nTpProvDiff = 0   // 約定足の値幅が仮 TP と実約定価格からの TP の一方だけに届いた (固定 RR)

// ACC-2 再計算設定の保護: ヒストリカルの同じ足での実行回数 (varip = 足の途中の再計算でも巻き戻らない)
varip int acExecBar = -1
varip int acExecN   = 0

f_tfName(int k) =>
    k == 0 ? "1H" : k == 1 ? "4H" : "D"

f_tfUse(int k) =>
    k == 0 ? acUse1 : k == 1 ? acUse2 : acUse3

f_tfKeep(int k) =>
    k == 0 ? acKeep1 : k == 1 ? acKeep2 : acKeep3

f_tfLifeMs(int k) =>
    int(math.round((k == 0 ? acLife1 : k == 1 ? acLife2 : acLife3) * 86400000))

f_tfColor(int k) =>
    k == 0 ? color.teal : k == 1 ? color.orange : color.fuchsia

f_patName(int p) =>
    p == 1 ? "P1 上限ダマシ SHORT" : p == 2 ? "P2 上限サポレジ LONG" : p == 3 ? "P3 下限ダマシ LONG" : p == 4 ? "P4 下限サポレジ SHORT" : p == 5 ? "P5 上限反発 SHORT" : "P6 下限反発 LONG"

f_patOn(int p) =>
    p == 1 ? enP1 : p == 2 ? enP2 : p == 3 ? enP3 : p == 4 ? enP4 : p == 5 ? enP5 : enP6

// 開始時刻を含み、終了時刻を含まない (開始 == 終了 は終日)
f_inSession(int t) =>
    int mins = hour(t, seTz) * 60 + minute(t, seTz)
    int s    = seStartH * 60 + seStartM
    int e    = seEndH * 60 + seEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)

// 新しい突破イベントと TP 候補に使える Accum: 固定済み・Keep Count 内・期限内・時間足 ON
f_valid(AcBox b) =>
    b.fixed and not b.dead and f_tfUse(b.tf) and time < b.expTime

f_findBox(int k, int aid) =>
    int r = -1
    int n = array.size(acBoxes)
    if n > 0
        for i = 0 to n - 1
            AcBox b = array.get(acBoxes, i)
            if b.tf == k and b.aid == aid
                r := i
                break
    r

f_hasEv(int k, int aid, int dir) =>
    bool r = false
    int n = array.size(acEvs)
    if n > 0
        for i = 0 to n - 1
            AcEv e = array.get(acEvs, i)
            if e.tf == k and e.aid == aid and e.dir == dir
                r := true
                break
    r

// 利益方向で最も近い有効な Accum 境界 (ref より厳密に先。なければ na)
f_tpBoundary(int side, float ref) =>
    float best = na
    int n = array.size(acBoxes)
    if n > 0
        for i = 0 to n - 1
            AcBox b = array.get(acBoxes, i)
            if f_valid(b)
                if side == 1
                    if b.up > ref and (na(best) or b.up < best)
                        best := b.up
                    if b.lo > ref and (na(best) or b.lo < best)
                        best := b.lo
                else
                    if b.up < ref and (na(best) or b.up > best)
                        best := b.up
                    if b.lo < ref and (na(best) or b.lo > best)
                        best := b.lo
    best

// 数量 (ZoneStrategyXAU f_stQty と同じ式): 円の予算を strategy.convert_to_symbol で USD へ換算 (固定 USDJPY なし)。
//  lot = 予算 USD ÷ (SL 距離 × 1 lot のオンス数) を lot 刻みで切り捨て、予算超過なら 1 刻み下げる。最小 lot 未満は na。
//  qty = lot × 1 lot のオンス数 ÷ syminfo.pointvalue。参照価格 (判断足の終値) に対する予定損失で、約定ずれ・スプレッド・
//  手数料を含む実損失の上限ではない。
f_qty(int side, float ref, float sl) =>
    float budget = mmCapBase * mmRiskPct / 100.0
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = budget > 0 ? strategy.convert_to_symbol(budget) : na
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and mmLotOz > 0 and mmLotStep > 0 and mmLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * mmLotOz * mmLotStep) + 1e-9)
        if n * mmLotStep * mmLotOz * dist > budSym
            n := n - 1
        if n >= 1 and n * mmLotStep >= mmLotMin * (1 - 1e-9)
            q := n * mmLotStep * mmLotOz / pv
    q

// 候補の検査 (SL 幅 → RR / TP → 時間帯 → lot)。最初に満たさなかった条件を why に残す
f_cand(int side, int pat, int tf, int aseq, float lvl, float sl, bool sessOK) =>
    float ref = close
    float slw = side * (ref - sl)
    AcCand c = AcCand.new(side, pat, tf, aseq, lvl, sl, slw)
    c.dist := math.abs(ref - lvl)
    if slw < rkMinSl - EPS or slw > rkMaxSl + EPS
        c.why := 1
    else
        float bnd = rkTpAcc ? f_tpBoundary(side, ref) : na
        if not na(bnd)
            c.tp     := bnd
            c.tpMode := 1
            c.rr     := side * (bnd - ref) / slw
            if c.rr < rkRR - EPS
                c.why := 2
        else
            c.tp     := ref + side * rkRR * slw
            c.tpMode := 0
            c.rr     := rkRR
        if c.why == 0 and not sessOK
            c.why := 3
        if c.why == 0
            c.qty := f_qty(side, ref, sl)
            if na(c.qty)
                c.why := 4
    c

// a が b より優先なら true: 時間足 (D > 4H > 1H) → 判断足の終値に近い境界 → 古い Accum
// ACC-2: 同じ注文 ID の約定が既にある (再計算で巻き戻った通し番号の再利用 = 足の途中で発注・約定した) なら true
f_idUsed(string id) =>
    bool r = false
    int ot = strategy.opentrades
    if ot > 0
        for i = 0 to ot - 1
            if strategy.opentrades.entry_id(i) == id
                r := true
    int ct = strategy.closedtrades
    if ct > 0
        for i = ct - 1 to math.max(0, ct - 5)
            if strategy.closedtrades.entry_id(i) == id
                r := true
    r

// ACC-2 診断: この足で +1R に届いていたのに、直前に決済された取引が損失 (初期 SL) で終わった
f_beSlConflict(int side, float fill, float sl) =>
    bool r = false
    int ct = strategy.closedtrades
    if beOn and ct > 0 and not na(fill) and not na(sl)
        float r1   = side * (fill - sl)
        float trig = fill + side * beR * r1
        float xp   = strategy.closedtrades.exit_price(ct - 1)
        r := r1 > 0 and (side == 1 ? high >= trig : low <= trig) and side * (xp - fill) < 0
    r

// ACC-2 診断: 固定 RR の仮 TP (判断足の終値から) と実約定価格からの TP のどちらか一方だけに約定足の値幅が届いた
f_tpProvDiff(int side, float tpProv, float tpExact) =>
    bool hp = side == 1 ? high >= tpProv : low <= tpProv
    bool he = side == 1 ? high >= tpExact : low <= tpExact
    hp != he

// ACC-4: P5 / P6 の待機がこの Accum のこの境界に既にある
f_hasRt(int k, int aid, int side) =>
    bool r = false
    int n = array.size(acRts)
    if n > 0
        for i = 0 to n - 1
            AcRt w = array.get(acRts, i)
            if w.tf == k and w.aid == aid and w.side == side
                r := true
                break
    r

// ACC-4: P5 / P6 の候補の検査 (SL 幅 [P5・P6 の最小 / 共通の最大] → TP の位置・最低 RR → 時間帯 → lot)。TP = 同じ Accum の反対側
f_candRg(int side, int pat, int tf, int aseq, float lvl, float sl, float tp, bool sessOK, int rtId) =>
    float ref = close
    float slw = side * (ref - sl)
    AcCand c = AcCand.new(side, pat, tf, aseq, lvl, sl, slw)
    c.dist   := math.abs(ref - lvl)
    c.rtId   := rtId
    c.tp     := tp
    c.tpMode := 2
    if slw < rgMinSl - EPS or slw > rkMaxSl + EPS
        c.why := 5
    else if side * (tp - ref) <= 0
        c.why := 6
    else
        c.rr := side * (tp - ref) / slw
        if c.rr < rgRR - EPS
            c.why := 6
    if c.why == 0 and not sessOK
        c.why := 3
    if c.why == 0
        c.qty := f_qty(side, ref, sl)
        if na(c.qty)
            c.why := 4
    c

f_better(AcCand a, AcCand b) =>
    a.tf != b.tf ? a.tf > b.tf : a.dist != b.dist ? a.dist < b.dist : a.aseq < b.aseq

f_candText(AcCand c) =>
    f_patName(c.pat) + "\n" + f_tfName(c.tf) + " Accum #" + str.tostring(c.aseq) + "  境界 " + str.tostring(c.lvl, "#.##") +
     "\n判断 " + str.tostring(close, "#.##") + "  SL " + str.tostring(c.sl, "#.##") +
     "\nTP " + str.tostring(c.tp, "#.##") + (c.tpMode == 1 ? " (Accum 境界)" : c.tpMode == 2 ? " (同じ Accum の反対側)" : " (固定 RR・約定後に再計算)") +
     "\n予定 RR " + str.tostring(c.rr, "#.##") + "  lot " + str.tostring(c.qty * syminfo.pointvalue / mmLotOz, "#.##")

bool acRun  = is5mChart
bool sessOK = not seUse or f_inSession(time_close)

if acRun
    // ---- ACC-2 再計算設定の保護: ヒストリカルの足は確定時の 1 回だけ実行される前提 (2 回目を検出したら停止)
    if barstate.ishistory
        if acExecBar == bar_index
            acExecN += 1
        else
            acExecBar := bar_index
            acExecN   := 1
        if acExecN > 1
            runtime.error("ACC: ヒストリカルの同じ足でスクリプトが 2 回以上実行されました。プロパティの「再計算: 注文約定後」などを OFF にしてください (足の途中の再計算は足の最終値を見るため先読み・二重発注になる)。")

    // ---- (A) 毎実行 (形成中 tick を含む): 約定確認 → TP 確定 → 建値移動 --------------------------------
    //  リアルタイムの形成中 tick で変えた var は次の tick で巻き戻るが、判定は strategy の約定事実と確定済みの状態から
    //  毎回同じ結果を出す (exit 注文の更新は同じ ID・同じ価格で冪等)。
    if oState == 1
        int  ot = strategy.opentrades
        int  ct = strategy.closedtrades
        bool fo = false
        bool fc = false
        if ot > 0
            fo := strategy.opentrades.entry_id(ot - 1) == oId
        if not fo and ct > oClosed
            fc := strategy.closedtrades.entry_id(ct - 1) == oId
        if fo
            oFill  := strategy.opentrades.entry_price(ot - 1)
            oState := 2
            if math.abs(math.abs(strategy.position_size) - oQty) > oQty * 1e-6
                nQtyAnom += 1
            float risk = oSide * (oFill - oSL)
            if oTpMode == 0 and risk > 0
                if barstate.ishistory and barstate.isconfirmed and f_tpProvDiff(oSide, oTP, oFill + oSide * rkRR * risk)
                    nTpProvDiff += 1
                oTP := oFill + oSide * rkRR * risk
            if risk > 0 and oSide * (oTP - oFill) > 0
                oStop   := oSL
                oRRReal := oSide * (oTP - oFill) / risk
                strategy.exit(oXid, oId, stop = oStop, limit = oTP)
            else
                // 約定ずれで初期 SL / TP が約定価格の反対側: 無効な出口注文を出さず成行で決済
                strategy.cancel(oXid)
                strategy.close(oId)
                oState  := 3
                oRRReal := na
                nBadExit += 1
            if not na(oLbl)
                label.set_text(oLbl, oTxt + "\n約定 " + str.tostring(oFill, "#.##") + "  TP " + str.tostring(oTP, "#.##") +
                     "  実 RR " + (na(oRRReal) ? "-" : str.tostring(oRRReal, "#.##")))
        else if fc
            // 約定した足の中で SL / TP まで決済済み
            oFill  := strategy.closedtrades.entry_price(ct - 1)
            oState := 0
            float risk = oSide * (oFill - oSL)
            oRRReal := risk > 0 ? oSide * (oTP - oFill) / risk : na
            // 約定ずれで初期 SL / 境界 TP が約定価格の反対側だった (ギャップ約定の直後に exit が成立した場合も数える)
            if risk <= 0 or (oTpMode != 0 and oSide * (oTP - oFill) <= 0)
                nBadExit += 1
            if barstate.ishistory and barstate.isconfirmed
                if f_beSlConflict(oSide, oFill, oSL)
                    nBeSlConf += 1
                if oTpMode == 0 and risk > 0 and f_tpProvDiff(oSide, oTP, oFill + oSide * rkRR * risk)
                    nTpProvDiff += 1
            if not na(oLbl)
                label.set_text(oLbl, oTxt + "\n約定 " + str.tostring(oFill, "#.##") + "  (約定足で決済)")
        else if barstate.isconfirmed and bar_index > oBar
            strategy.cancel(oId)
            strategy.cancel(oXid)
            oState := 0
    else if oState >= 2 and strategy.position_size == 0
        if barstate.ishistory and barstate.isconfirmed and oState == 2 and not oBE and f_beSlConflict(oSide, oFill, oSL)
            nBeSlConf += 1
        oState := 0

    // ACC-2: 管理中の注文 ID 以外の建玉があれば停止 (足の途中の再計算で発注・約定し、状態が巻き戻った場合など)
    if strategy.opentrades > 0
        string otId = strategy.opentrades.entry_id(strategy.opentrades - 1)
        if otId != oId
            runtime.error("ACC: 管理外の建玉 " + otId + " を検出しました (管理中 " + oId + ")。足の途中の再計算で発注・約定した可能性があります。プロパティの再計算設定を確認してください。")

    //  ヒストリカルは確定時の実行だけで判定する (足の途中の再計算は足の最終の高値 / 安値を見るため使わない)
    if beOn and oState == 2 and not oBE and strategy.position_size != 0 and (not barstate.ishistory or barstate.isconfirmed)
        float r1   = oSide * (oFill - oSL)
        float trig = oFill + oSide * beR * r1
        if (oSide == 1 and high >= trig) or (oSide == -1 and low <= trig)
            oBE   := true
            oStop := oFill
            nBE   += 1
            strategy.exit(oXid, oId, stop = oStop, limit = oTP)
            if barstate.ishistory and barstate.isconfirmed and (oSide == 1 ? low <= oFill : high >= oFill)
                nBeRevisit += 1

    // ---- (B) 確定足だけ ----------------------------------------------------------------------------
    if barstate.isconfirmed
        // (B1) 上位足の Accum 状態を反映
        array<float> fU = array.from(f1u, f2u, f3u)
        array<float> fL = array.from(f1l, f2l, f3l)
        array<int>   fI = array.from(f1i, f2i, f3i)
        array<int>   fA = array.from(f1a, f2a, f3a)
        for k = 0 to 2
            int   aid = array.get(fI, k)
            float u   = array.get(fU, k)
            float l   = array.get(fL, k)
            if f_tfUse(k) and not na(aid) and not na(u) and not na(l)
                bool forming = array.get(fA, k) == 1
                int  last    = array.get(acLastId, k)
                if na(last) or aid != last
                    // 新しい Accum (ID が前回と違う = 既存 Engine と同じ判定)。上位足は終了後も同じ ID・上下限を送り続けるため、
                    // 新しい ID の判定は「前回届いた ID」と比べる (期限切れで登録から外した Accum を再登録しない)。
                    // 同じ時間足に未固定の Accum が残っていれば (終了の上位足を取りこぼした場合) ここで固定する
                    array.set(acLastId, k, aid)
                    int n0 = array.size(acBoxes)
                    if n0 > 0
                        for i = 0 to n0 - 1
                            AcBox q = array.get(acBoxes, i)
                            if q.tf == k and not q.fixed
                                q.fixed   := true
                                q.fixTime := time
                                q.expTime := time + f_tfLifeMs(k)
                    acSeq += 1
                    AcBox b = AcBox.new(k, aid, acSeq, u, l)
                    if not forming
                        b.fixed   := true
                        b.fixTime := time
                        b.expTime := time + f_tfLifeMs(k)
                    array.push(acBoxes, b)
                    // Keep Count: この時間足の (形成中を含む) 最新 Keep Count 個だけ残す。古い ID から押し出す
                    int live = 0
                    int n1   = array.size(acBoxes)
                    for i = 0 to n1 - 1
                        AcBox q = array.get(acBoxes, i)
                        if q.tf == k and not q.dead
                            live += 1
                    while live > f_tfKeep(k)
                        int oi = -1
                        int oa = 0
                        for i = 0 to n1 - 1
                            AcBox q = array.get(acBoxes, i)
                            if q.tf == k and not q.dead and (oi < 0 or q.aid < oa)
                                oi := i
                                oa := q.aid
                        AcBox qo = array.get(acBoxes, oi)
                        qo.dead := true
                        live -= 1
                else
                    // 同じ ID: 形成中は上下限を更新、形成中フラグが 0 になった足で固定 (固定後・登録から外した後は何もしない)
                    int bi = f_findBox(k, aid)
                    if bi >= 0
                        AcBox b = array.get(acBoxes, bi)
                        if not b.fixed
                            b.up := u
                            b.lo := l
                            if not forming
                                b.fixed   := true
                                b.fixTime := time
                                b.expTime := time + f_tfLifeMs(k)

        // (B2) 既存の突破イベント: 期限 → 最高値 / 最安値 → ダマシ → リテスト → 乖離
        array<AcCand> cands = array.new<AcCand>()
        int ne = array.size(acEvs)
        if ne > 0
            for i = ne - 1 to 0
                AcEv e = array.get(acEvs, i)
                int age = bar_index - e.bBar
                if age > enRetestBars
                    array.remove(acEvs, i)
                else if age >= 1
                    e.ext := e.dir == 1 ? math.max(e.ext, high) : math.min(e.ext, low)
                    bool fake = e.dir == 1 ? close < e.lvl : close > e.lvl
                    if fake
                        // P1 (上限) / P3 (下限): 境界の内側へ終値で戻った。SL = 突破足〜この足の最高値 + Buffer / 最安値 − Buffer
                        int pf = e.dir == 1 ? 1 : 3
                        e.nSig += 1
                        if f_patOn(pf)
                            array.push(cands, f_cand(-e.dir, pf, e.tf, e.aseq, e.lvl, e.ext + e.dir * rkBuf, sessOK))
                        array.remove(acEvs, i)
                    else
                        // P2 (上限) / P4 (下限): 乖離成立後の足で、ヒゲが境界 ± 近接距離まで戻り、終値が境界の外側
                        bool rt = e.dev and (e.dir == 1 ? (low - e.lvl <= enNear + EPS and close > e.lvl) : (e.lvl - high <= enNear + EPS and close < e.lvl))
                        if rt
                            int pr = e.dir == 1 ? 2 : 4
                            e.rtBar := bar_index
                            e.nSig  += 1
                            if f_patOn(pr)
                                array.push(cands, f_cand(e.dir, pr, e.tf, e.aseq, e.lvl, e.lvl - e.dir * rkBuf, sessOK))
                        if not e.dev and e.dir * (close - e.lvl) >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index

        // (B3) 新しい突破イベント: 有効な Accum の境界を終値で突破 (等値は突破ではない)。同じ境界で進行中のイベントがあれば始めない
        int nb = array.size(acBoxes)
        if nb > 0
            for i = 0 to nb - 1
                AcBox b = array.get(acBoxes, i)
                if f_valid(b)
                    bool atFix = enFixMode == "Start at Fix" and b.fixTime == time
                    if close > b.up and ((not na(acPrevClose) and acPrevClose <= b.up) or atFix) and not f_hasEv(b.tf, b.aid, 1)
                        AcEv e = AcEv.new(b.tf, b.aid, b.seq, 1, b.up, bar_index, high)
                        if close - b.up >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index
                        array.push(acEvs, e)
                    if close < b.lo and ((not na(acPrevClose) and acPrevClose >= b.lo) or atFix) and not f_hasEv(b.tf, b.aid, -1)
                        AcEv e = AcEv.new(b.tf, b.aid, b.seq, -1, b.lo, bar_index, low)
                        if b.lo - close >= enDev - EPS
                            e.dev    := true
                            e.devBar := bar_index
                        array.push(acEvs, e)

        // (B3b) ACC-4 P5 / P6 レンジ反発: 突破での待機解除 → 突破側の再アーム解除 → 接触 / 再アーム → 期限 → 反発シグナル
        //  状態は P5 / P6 の ON / OFF にかかわらず更新する (候補にするのは ON のパターンだけ)。P1〜P4 の状態には触れない。
        int nr0 = array.size(acRts)
        if nr0 > 0
            for i = nr0 - 1 to 0
                AcRt w = array.get(acRts, i)
                if close > w.up or close < w.lo
                    array.remove(acRts, i)
                    nRgBrk += 1
        int nb4 = array.size(acBoxes)
        if nb4 > 0
            for i = 0 to nb4 - 1
                AcBox b = array.get(acBoxes, i)
                if b.fixed
                    if close > b.up
                        b.armU := false
                    if close < b.lo
                        b.armL := false
                    // 接触 / 再アーム: 有効な Accum・固定した足の次の足から・終値がレンジを抜けていない足だけ
                    if f_valid(b) and time > b.fixTime and close <= b.up and close >= b.lo
                        if not f_hasRt(b.tf, b.aid, -1)
                            if b.armU and high >= b.up - rgNear - EPS
                                acRtSeq += 1
                                array.push(acRts, AcRt.new(acRtSeq, b.tf, b.aid, b.seq, -1, b.up, b.lo, bar_index))
                                b.armU  := false
                                nTouch5 += 1
                            else if not b.armU and high < b.up - rgNear - EPS
                                b.armU := true
                        if not f_hasRt(b.tf, b.aid, 1)
                            if b.armL and low <= b.lo + rgNear + EPS
                                acRtSeq += 1
                                array.push(acRts, AcRt.new(acRtSeq, b.tf, b.aid, b.seq, 1, b.up, b.lo, bar_index))
                                b.armL  := false
                                nTouch6 += 1
                            else if not b.armL and low > b.lo + rgNear + EPS
                                b.armL := true
        int nr1 = array.size(acRts)
        if nr1 > 0
            for i = nr1 - 1 to 0
                AcRt w = array.get(acRts, i)
                int rage = bar_index - w.tBar
                if rage > rgWait
                    array.remove(acRts, i)
                    nRgExp += 1
                else if close < w.up and close > w.lo
                    // P5: 陰線 (SL = 上限 + Buffer、TP = 同じ Accum の下限) / P6: 陽線 (SL = 下限 − Buffer、TP = 上限)
                    if w.side == -1 and close < open and enP5
                        array.push(cands, f_candRg(-1, 5, w.tf, w.aseq, w.up, w.up + rkBuf, w.lo, sessOK, w.id))
                    if w.side == 1 and close > open and enP6
                        array.push(cands, f_candRg(1, 6, w.tf, w.aseq, w.lo, w.lo - rkBuf, w.up, sessOK, w.id))

        // (B3c) ACC-5A FVG 吸収: 期限 → 吸収 (監視中の FVG・この足の終値) → 待機への根拠付け → 新しい FVG → 根拠の有効状態
        //  根拠の検出・保存・表示だけ。候補 (cands)・注文・P1〜P6 の状態には触れない。
        if fvUse
            if not na(acFvUp) and bar_index - acFvUp.fBar > fvLife
                acFvUp := na
            if not na(acFvDn) and bar_index - acFvDn.fBar > fvLife
                acFvDn := na
            for d = 0 to 1
                AcFvg fv = d == 0 ? acFvUp : acFvDn
                if not na(fv)
                    bool absd = fv.dir == 1 ? (close < open and close <= fv.lo) : (close > open and close >= fv.hi)
                    if absd
                        int wside = fv.dir == 1 ? -1 : 1
                        int nrv = array.size(acRts)
                        if nrv > 0
                            for i = 0 to nrv - 1
                                AcRt w = array.get(acRts, i)
                                if w.side == wside and w.tBar <= bar_index
                                    w.evFvgId  := fv.id
                                    w.evFvgBar := fv.fBar
                                    w.evFvgLo  := fv.lo
                                    w.evFvgHi  := fv.hi
                                    w.evAbsBar := bar_index
                                    w.evExpBar := bar_index + fvAbsLife
                                    w.evOn     := true
                                    nFvEv5 += wside == -1 ? 1 : 0
                                    nFvEv6 += wside == 1 ? 1 : 0
                        nFvUpAbs += fv.dir == 1 ? 1 : 0
                        nFvDnAbs += fv.dir == -1 ? 1 : 0
                        if dsFvg
                            if not na(fv.bx)
                                box.set_right(fv.bx, bar_index)
                            label lf = label.new(bar_index, fv.dir == 1 ? high : low, (fv.dir == 1 ? "FVG吸収 SHORT #" : "FVG吸収 LONG #") + str.tostring(fv.id),
                                 style = fv.dir == 1 ? label.style_label_down : label.style_label_up,
                                 color = fv.dir == 1 ? color.new(color.maroon, 30) : color.new(color.navy, 30), textcolor = color.white, size = size.tiny)
                            array.push(acFvLbls, lf)
                            if array.size(acFvLbls) > dsFvgMax
                                label.delete(array.shift(acFvLbls))
                        if d == 0
                            acFvUp := na
                        else
                            acFvDn := na
            bool upF = not na(acH2) and not na(acC1) and not na(acO1) and low > acH2 and acC1 > acO1 and low - acH2 >= fvMinW - EPS
            bool dnF = not na(acL2) and not na(acC1) and not na(acO1) and high < acL2 and acC1 < acO1 and acL2 - high >= fvMinW - EPS
            for d = 0 to 1
                bool fm = d == 0 ? upF : dnF
                if fm
                    acFvSeq += 1
                    AcFvg nf = d == 0 ? AcFvg.new(acFvSeq, 1, bar_index, acH2, low) : AcFvg.new(acFvSeq, -1, bar_index, high, acL2)
                    nFvUp += d == 0 ? 1 : 0
                    nFvDn += d == 1 ? 1 : 0
                    if dsFvg
                        nf.bx := box.new(bar_index - 2, nf.hi, bar_index + fvLife, nf.lo,
                             border_color = d == 0 ? color.new(color.green, 40) : color.new(color.red, 40),
                             bgcolor = d == 0 ? color.new(color.green, 85) : color.new(color.red, 85))
                        array.push(acFvBoxes, nf.bx)
                        if array.size(acFvBoxes) > dsFvgMax
                            box.delete(array.shift(acFvBoxes))
                    if d == 0
                        acFvUp := nf
                    else
                        acFvDn := nf
            int nre = array.size(acRts)
            if nre > 0
                for i = 0 to nre - 1
                    AcRt w = array.get(acRts, i)
                    if w.evFvgId >= 0
                        bool on = bar_index <= w.evExpBar
                        if w.evOn and not on
                            nFvEvExp += 1
                        w.evOn := on

        // (B3d) ACC-5B ダブル / トリプル: 足の取り込み → 山・谷の基準 → 各基準 (無効化 → 反転待ち → 接近 → 離れ幅) → 根拠の有効状態
        //  根拠の検出・保存・表示だけ。候補 (cands)・注文・P1〜P6・FVG の状態には触れない。
        if dvUse
            if array.size(dvTfs) == 0
                for k = 0 to 4
                    array.push(dvTfs, DvTf.new(array.new_float(), array.new_float(), na))
            int dvW = 2 * dvPiv + 1
            array<float> fH = array.from(high, dvh1, dvh2, dvh3, dvh4)
            array<float> fL = array.from(low, dvl1, dvl2, dvl3, dvl4)
            array<int>   fT = array.from(time, dvt1, dvt2, dvt3, dvt4)
            for k = 0 to 4
                int   nt = array.get(fT, k)
                float nh = array.get(fH, k)
                float nl = array.get(fL, k)
                DvTf  tw = array.get(dvTfs, k)
                if not na(nt) and not na(nh) and not na(nl) and (na(tw.lastT) or nt != tw.lastT)
                    tw.lastT := nt
                    array.push(tw.hs, nh)
                    array.push(tw.ls, nl)
                    if array.size(tw.hs) > dvW
                        array.shift(tw.hs)
                        array.shift(tw.ls)
                    if array.size(tw.hs) == dvW
                        float mh = array.get(tw.hs, dvPiv)
                        float ml = array.get(tw.ls, dvPiv)
                        bool  isH = true
                        bool  isL = true
                        float rMin = na
                        float rMax = na
                        for j = 0 to dvW - 1
                            if j != dvPiv
                                isH := isH and mh > array.get(tw.hs, j)
                                isL := isL and ml < array.get(tw.ls, j)
                            if j > dvPiv
                                rMin := na(rMin) ? array.get(tw.ls, j) : math.min(rMin, array.get(tw.ls, j))
                                rMax := na(rMax) ? array.get(tw.hs, j) : math.max(rMax, array.get(tw.hs, j))
                        // 上位足は届いた 5分足 (確認足の後) の値動きも離れ幅に含める。5分足では今の足が最後の確認足
                        if k > 0
                            rMin := math.min(rMin, low)
                            rMax := math.max(rMax, high)
                        float dD = k == 0 ? dvD0 : k == 1 ? dvD1 : k == 2 ? dvD2 : k == 3 ? dvD3 : dvD4
                        if isH
                            dvSeq += 1
                            array.push(dvBases, DvBase.new(dvSeq, k, -1, mh, nt, bar_index, mh - rMin >= dD - EPS))
                            nDvTop += 1
                        if isL
                            dvSeq += 1
                            array.push(dvBases, DvBase.new(dvSeq, k, 1, ml, nt, bar_index, rMax - ml >= dD - EPS))
                            nDvBot += 1
            int ng = array.size(dvBases)
            if ng > 0
                for i = ng - 1 to 0
                    DvBase g = array.get(dvBases, i)
                    if g.aBar < bar_index
                        float bB  = g.tf == 0 ? dvB0 : g.tf == 1 ? dvB1 : g.tf == 2 ? dvB2 : g.tf == 3 ? dvB3 : dvB4
                        float bD  = g.tf == 0 ? dvD0 : g.tf == 1 ? dvD1 : g.tf == 2 ? dvD2 : g.tf == 3 ? dvD3 : dvD4
                        bool  top = g.side == -1
                        bool  fin = false
                        // ① 無効化 (終値が H + B を超える / L − B を下回る。ヒゲ・ちょうどは許容)。反転より優先
                        if top ? close > g.lvl + bB + EPS : close < g.lvl - bB - EPS
                            fin := true
                            nDvInv += 1
                        else
                            bool det  = false
                            bool dApp = false
                            bool rev  = top ? close < open : close > open
                            if g.waiting
                                // ② 反転待ち: 最初の陰線 (陽線) で検知、最後の足を過ぎたら見送り (接近 1 回に数えたまま)
                                if rev
                                    det := true
                                    g.waiting := false
                                else if bar_index >= g.waitEnd
                                    g.waiting := false
                                    nDvExp += 1
                                fin := not g.waiting and g.cnt >= 3
                            else if g.away and g.cnt < 3 and (top ? high >= g.lvl - bB - EPS : low <= g.lvl + bB + EPS)
                                // ③ 接近 (2 回目・3 回目)。接近足が陰線 (陽線) ならこの足で検知、違えば反転待ち
                                g.cnt    += 1
                                g.away   := false
                                g.appBar := bar_index
                                g.waitEnd := bar_index + dvWait
                                nDvApp   += 1
                                if rev
                                    det  := true
                                    dApp := true
                                else if dvWait > 0
                                    g.waiting := true
                                else
                                    nDvExp += 1
                                fin := not g.waiting and g.cnt >= 3
                            if det
                                nDvDetT2  += top and g.cnt == 2 ? 1 : 0
                                nDvDetT3  += top and g.cnt == 3 ? 1 : 0
                                nDvDetB2  += not top and g.cnt == 2 ? 1 : 0
                                nDvDetB3  += not top and g.cnt == 3 ? 1 : 0
                                nDvDetApp += dApp ? 1 : 0
                                nDvDetLat += dApp ? 0 : 1
                                // 根拠: トップ → 有効な P5 待機 / ボトム → P6 待機。同じ足に複数の検知があれば上位の時間足を残す
                                int wside = top ? -1 : 1
                                int nrv = array.size(acRts)
                                if nrv > 0
                                    for j = 0 to nrv - 1
                                        AcRt w = array.get(acRts, j)
                                        if w.side == wside and (w.dvId < 0 or w.dvDetBar < bar_index or g.tf > w.dvTf)
                                            w.dvId     := g.id
                                            w.dvTf     := g.tf
                                            w.dvLvl    := g.lvl
                                            w.dvCnt    := g.cnt
                                            w.dvAppBar := g.appBar
                                            w.dvDetBar := bar_index
                                            w.dvExpBar := bar_index + dvEvLife
                                            w.dvOn     := true
                                            nDvEv5 += top ? 1 : 0
                                            nDvEv6 += top ? 0 : 1
                                if dsDv
                                    string nm = (top ? (g.cnt == 2 ? "DT " : "TT ") : (g.cnt == 2 ? "DB " : "TB ")) + (g.tf == 0 ? "5M" : g.tf == 1 ? "15M" : f_tfName(g.tf - 2)) +
                                         " " + str.tostring(g.lvl, "#.##") + " #" + str.tostring(g.id)
                                    label ld = label.new(bar_index, top ? high : low, nm, style = top ? label.style_label_down : label.style_label_up,
                                         color = top ? color.new(color.purple, 30) : color.new(color.teal, 30), textcolor = color.white, size = size.tiny)
                                    array.push(dvLbls, ld)
                                    if array.size(dvLbls) > dsDvMax
                                        label.delete(array.shift(dvLbls))
                            // ④ 最低離れ幅 (この足の終わりに更新。次の接近は次の足から)。接近足自身の値幅は数えない
                            //    (足の中で接近と離れ幅の順序が分からないため。離れ幅は接近の後の足で満たす)
                            if not fin and (na(g.appBar) or g.appBar != bar_index) and (top ? low <= g.lvl - bD + EPS : high >= g.lvl + bD - EPS)
                                g.away := true
                        if fin
                            array.remove(dvBases, i)
            nDvMaxAct := math.max(nDvMaxAct, array.size(dvBases))
            int nre2 = array.size(acRts)
            if nre2 > 0
                for i = 0 to nre2 - 1
                    AcRt w = array.get(acRts, i)
                    if w.dvId >= 0
                        bool on = bar_index <= w.dvExpBar
                        if w.dvOn and not on
                            nDvEvExp += 1
                        w.dvOn := on

        // (B4) 候補の選定: 有効な候補だけ → 時間足優先 → 近い境界 → 古い Accum。LONG と SHORT が両方あれば見送り
        AcCand bestL = na
        AcCand bestS = na
        int nc = array.size(cands)
        if nc > 0
            for i = 0 to nc - 1
                AcCand c = array.get(cands, i)
                nSig1 += c.pat == 1 ? 1 : 0
                nSig2 += c.pat == 2 ? 1 : 0
                nSig3 += c.pat == 3 ? 1 : 0
                nSig4 += c.pat == 4 ? 1 : 0
                nSig5 += c.pat == 5 ? 1 : 0
                nSig6 += c.pat == 6 ? 1 : 0
                nSkipSl56 += c.why == 5 ? 1 : 0
                nSkipRR56 += c.why == 6 ? 1 : 0
                nSkipSl   += c.why == 1 ? 1 : 0
                nSkipRR   += c.why == 2 ? 1 : 0
                nSkipSess += c.why == 3 ? 1 : 0
                nSkipQty  += c.why == 4 ? 1 : 0
                if c.why == 0
                    if c.side == 1
                        if na(bestL)
                            bestL := c
                        else if f_better(c, bestL)
                            bestL := c
                    else
                        if na(bestS)
                            bestS := c
                        else if f_better(c, bestS)
                            bestS := c
        AcCand pick = na
        if not na(bestL) and not na(bestS)
            nConflict += 1
        else if not na(bestL)
            pick := bestL
        else if not na(bestS)
            pick := bestS

        // (B5) 発注: ノーポジ = 新規 / 反対ポジ + ドテン ON = ドテン / 同方向・ドテン OFF = 何もしない
        if not na(pick)
            float pos  = strategy.position_size
            bool  flat = oState == 0 and pos == 0
            bool  rev  = dtOn and oState == 2 and pos != 0 and (pos > 0 ? 1 : -1) != pick.side
            if flat or rev
                string nid = (pick.side == 1 ? "L" : "S") + str.tostring(oN + 1)
                if f_idUsed(nid)
                    runtime.error("ACC: 注文 ID " + nid + " の約定が既にあります (足の途中の再計算で発注・約定した可能性)。プロパティの再計算設定を確認してください。")
                if rev
                    // 旧ポジの SL / TP を取り消す (次足始値の逆方向 entry 1 注文で決済 + 新規。数量の二重化を防ぐ)
                    strategy.cancel(oXid)
                    nDoten += 1
                oN      += 1
                oId     := (pick.side == 1 ? "L" : "S") + str.tostring(oN)
                oXid    := "X" + str.tostring(oN)
                oSide   := pick.side
                oPat    := pick.pat
                oTf     := pick.tf
                oRef    := close
                oSL     := pick.sl
                oTP     := pick.tp
                oTpMode := pick.tpMode
                oQty    := pick.qty
                oFill   := na
                oStop   := pick.sl
                oBE     := false
                oBar    := bar_index
                oClosed := strategy.closedtrades
                oRRPlan := pick.rr
                oRRReal := na
                oState  := 1
                nEnt1 += pick.pat == 1 ? 1 : 0
                nEnt2 += pick.pat == 2 ? 1 : 0
                nEnt3 += pick.pat == 3 ? 1 : 0
                nEnt4 += pick.pat == 4 ? 1 : 0
                nEnt5 += pick.pat == 5 ? 1 : 0
                nEnt6 += pick.pat == 6 ? 1 : 0
                // ACC-4: 発注した P5 / P6 の接触を消費する (見送りでは消費しない)
                if pick.rtId >= 0
                    int nw = array.size(acRts)
                    if nw > 0
                        for j = nw - 1 to 0
                            AcRt wj = array.get(acRts, j)
                            if wj.id == pick.rtId
                                array.remove(acRts, j)
                                break
                strategy.entry(oId, pick.side == 1 ? strategy.long : strategy.short, qty = pick.qty)
                strategy.exit(oXid, oId, stop = pick.sl, limit = pick.tp)
                oLbl := na
                oTxt := (rev ? "[ドテン] " : "") + f_candText(pick)
                if dsEnt
                    oLbl := label.new(bar_index, pick.side == 1 ? low : high, oTxt,
                         style = pick.side == 1 ? label.style_label_up : label.style_label_down,
                         color = pick.side == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
                         textcolor = color.white, size = size.small)
                    array.push(acLbls, oLbl)
                    if array.size(acLbls) > dsEntMax
                        label.delete(array.shift(acLbls))

        // (B6) 描画 (Accum 上下限・有効 / 期限切れ) と登録の整理
        int nb2 = array.size(acBoxes)
        if nb2 > 0
            for i = nb2 - 1 to 0
                AcBox b = array.get(acBoxes, i)
                if dsAcc and b.fixed and not b.drawn
                    b.drawn := true
                    color col = f_tfColor(b.tf)
                    string nm = f_tfName(b.tf) + " Accum #" + str.tostring(b.seq) + " (ID " + str.format_time(b.aid, "MM-dd HH:mm", seTz) + ")"
                    b.lnU := line.new(b.aid, b.up, b.expTime, b.up, xloc = xloc.bar_time, color = col, width = 2)
                    b.lnL := line.new(b.aid, b.lo, b.expTime, b.lo, xloc = xloc.bar_time, color = col, width = 2)
                    b.lbU := label.new(b.aid, b.up, nm + " 上限 " + str.tostring(b.up, "#.##") + " · 有効", xloc = xloc.bar_time,
                         style = label.style_label_lower_left, color = color.new(col, 85), textcolor = col, size = size.small)
                    b.lbL := label.new(b.aid, b.lo, nm + " 下限 " + str.tostring(b.lo, "#.##") + " · 有効", xloc = xloc.bar_time,
                         style = label.style_label_upper_left, color = color.new(col, 85), textcolor = col, size = size.small)
                    array.push(acDrawn, b)
                    if array.size(acDrawn) > dsAccMax
                        AcBox od = array.shift(acDrawn)
                        line.delete(od.lnU)
                        line.delete(od.lnL)
                        label.delete(od.lbU)
                        label.delete(od.lbL)
                if b.fixed and not f_valid(b)
                    array.remove(acBoxes, i)
        int nd = array.size(acDrawn)
        if nd > 0
            for i = 0 to nd - 1
                AcBox b = array.get(acDrawn, i)
                if not b.shownExp and not f_valid(b)
                    b.shownExp := true
                    string st = b.dead ? " · Keep 超過" : " · 期限切れ"
                    line.set_color(b.lnU, color.gray)
                    line.set_color(b.lnL, color.gray)
                    line.set_style(b.lnU, line.style_dotted)
                    line.set_style(b.lnL, line.style_dotted)
                    label.set_text(b.lbU, label.get_text(b.lbU) + st)
                    label.set_text(b.lbL, label.get_text(b.lbL) + st)
                    label.set_textcolor(b.lbU, color.gray)
                    label.set_textcolor(b.lbL, color.gray)
// ==== ACC Logic (end) ========================================================


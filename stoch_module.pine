// ============================================================
//  ストキャス 単体モジュール (Indicator版 / オシレーターペイン)
// ============================================================
//  ・ストキャスティクス関連だけを独立モジュール化。
//  ・後で 環境認識 / フィボ / FVG / 出来高 / EMA / 水平線 /
//    マクロ / Silver と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・request.security / ADX は使わない。
//  パターン:
//   A:Extreme Reversal(90/10) B:OB/OS Cross(80/20) C:Middle Cross(50)
//   D:Trend Stickiness(禁止フィルター) E:Regular Div F:Hidden Div
// ============================================================

//@version=5
indicator(
     title          = "Stochastic Module",
     shorttitle     = "STOCH",
     overlay        = false,
     max_bars_back  = 1000
 )

// ============================================================
//  ON/OFF
// ============================================================
grpSw = "ON/OFF"
useStochModule      = input.bool(true, "ストキャスモジュール全体", group = grpSw)
useExtremeReversal  = input.bool(true, "A: Extreme Reversal",  group = grpSw)
useOBOSCross        = input.bool(true, "B: OB/OS Cross",       group = grpSw)
useMiddleCross      = input.bool(true, "C: Middle Cross",      group = grpSw)
useStickinessFilter = input.bool(true, "D: Stickiness(禁止)",  group = grpSw)
useRegularDivergence= input.bool(true, "E: Regular Divergence", group = grpSw)
useHiddenDivergence = input.bool(true, "F: Hidden Divergence",  group = grpSw)

// ============================================================
//  ストキャス設定
// ============================================================
grpStoch = "ストキャス設定"
kLen    = input.int(14, "%K 期間",      minval = 1, group = grpStoch)
kSmooth = input.int(3,  "%K スムージング", minval = 1, group = grpStoch)
dLen    = input.int(3,  "%D 期間",      minval = 1, group = grpStoch)

// ============================================================
//  レベル設定
// ============================================================
grpLv = "レベル"
extremeHigh = input.float(90, "Extreme High", group = grpLv)
extremeLow  = input.float(10, "Extreme Low",  group = grpLv)
obLevel     = input.float(80, "OB Level",     group = grpLv)
osLevel     = input.float(20, "OS Level",     group = grpLv)
middleLevel = input.float(50, "Middle Level", group = grpLv)

// ============================================================
//  A: Extreme Reversal パラメータ
// ============================================================
grpA = "A: Extreme Reversal"
useExtremeSlopeTurn = input.bool(true, "傾き反転で確認", group = grpA)
useExtremeKDCross   = input.bool(true, "K/Dクロスで確認", group = grpA)
extremeLookback     = input.int(5, "Extreme 到達 参照本数", minval = 1, group = grpA)

// ============================================================
//  D: Stickiness パラメータ
// ============================================================
grpD = "D: Stickiness"
stickBars = input.int(5, "張り付き 本数", minval = 1, group = grpD)

// ============================================================
//  E/F: Divergence パラメータ
// ============================================================
grpDiv = "Divergence"
divPivotLen = input.int(5,  "Pivot 長さ",     minval = 1, group = grpDiv)
divLookback = input.int(60, "Pivot 間 最大本数", minval = 1, group = grpDiv)

// ============================================================
//  共通フィルター
// ============================================================
grpFilt = "共通フィルター"
useKDirectionFilter = input.bool(false, "K傾きフィルター",   group = grpFilt)
useKDRelationFilter = input.bool(false, "K/D位置フィルター", group = grpFilt)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showStochLabels    = input.bool(true, "シグナルラベル",   group = grpDisp)
showStochDebugTable= input.bool(true, "デバッグテーブル", group = grpDisp)
showStochPanePlots = input.bool(true, "K/D ライン表示",   group = grpDisp)

// ============================================================
//  ストキャス計算
// ============================================================
float rawK   = ta.stoch(high, low, close, kLen)
float stochK = ta.sma(rawK, kSmooth)
float stochD = ta.sma(stochK, dLen)

bool sAct = useStochModule

// 共通の傾き / クロス
bool slopeUp   = stochK > stochK[1]
bool slopeDown = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

// 共通フィルター
f_dirOK(isBuy) =>
    bool d = not useKDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool r = not useKDRelationFilter or (isBuy ? stochK > stochD : stochK < stochD)
    d and r

// ============================================================
//  A: Extreme Reversal (90/10 折り返し)
// ============================================================
bool reachedHigh = ta.highest(stochK, extremeLookback) >= extremeHigh
bool reachedLow  = ta.lowest(stochK, extremeLookback)  <= extremeLow
bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp)   or (useExtremeKDCross and kdCrossUp)

bool exSell = sAct and useExtremeReversal and reachedHigh and turnDown and f_dirOK(false)
bool exBuy  = sAct and useExtremeReversal and reachedLow  and turnUp   and f_dirOK(true)
bool stochSellExtremeSignal = exSell
bool stochBuyExtremeSignal  = exBuy

// ============================================================
//  B: OB/OS Cross (80/20 クロス)
// ============================================================
bool obSell = sAct and useOBOSCross and stochK > obLevel and kdCrossDown and f_dirOK(false)
bool obBuy  = sAct and useOBOSCross and stochK < osLevel and kdCrossUp   and f_dirOK(true)
bool stochSellOBOSCrossSignal = obSell
bool stochBuyOBOSCrossSignal  = obBuy

// ============================================================
//  C: Middle Cross (50 抜け / 順張り勢い確認)
// ============================================================
bool midBuy  = sAct and useMiddleCross and ta.crossover(stochK, middleLevel)  and stochK > stochD and f_dirOK(true)
bool midSell = sAct and useMiddleCross and ta.crossunder(stochK, middleLevel) and stochK < stochD and f_dirOK(false)
bool stochBuyMiddleCrossSignal  = midBuy
bool stochSellMiddleCrossSignal = midSell

// ============================================================
//  D: Trend Stickiness (張り付き → 逆張り禁止)
// ============================================================
var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := stochK >= obLevel ? bullStickCount + 1 : 0
bearStickCount := stochK <= osLevel ? bearStickCount + 1 : 0
bool stochBullSticky = sAct and useStickinessFilter and bullStickCount >= stickBars
bool stochBearSticky = sAct and useStickinessFilter and bearStickCount >= stickBars
bool stochNoSell = stochBullSticky   // 強い上昇中はSELL禁止
bool stochNoBuy  = stochBearSticky   // 強い下降中はBUY禁止

// ============================================================
//  E/F: Divergence (pivot ベース)
// ============================================================
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float stochAtPivot = stochK[divPivotLen]

// 直近2つの price/stoch ピボットを保持
var float phPrev    = na
var float phLast    = na
var float shHPrev   = na
var float shHLast   = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float shLPrev   = na
var float shLLast   = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    shHPrev := shHLast
    phBarPrev := phBarLast
    phLast := pricePH
    shHLast := stochAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    shLPrev := shLLast
    plBarPrev := plBarLast
    plLast := pricePL
    shLLast := stochAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

// Regular: 価格HH + stoch LH = SELL / 価格LL + stoch HL = BUY
bool regSell = sAct and useRegularDivergence and newPH and phInRange and phLast > phPrev and shHLast < shHPrev
bool regBuy  = sAct and useRegularDivergence and newPL and plInRange and plLast < plPrev and shLLast > shLPrev
// Hidden: 価格HL + stoch LH(継続SELL) / 価格LH+... → 仕様: BUY=価格LL切上げ+stoch切下げ
bool hidBuy  = sAct and useHiddenDivergence and newPL and plInRange and plLast > plPrev and shLLast < shLPrev
bool hidSell = sAct and useHiddenDivergence and newPH and phInRange and phLast < phPrev and shHLast > shHPrev

bool stochSellRegularDivSignal = regSell
bool stochBuyRegularDivSignal  = regBuy
bool stochBuyHiddenDivSignal   = hidBuy
bool stochSellHiddenDivSignal  = hidSell

// ============================================================
//  Signal Type / Direction
//   優先: Regular(4) > Hidden(5) > Extreme(1) > OBOS(2) > Middle(3)
// ============================================================
bool anyReg = regBuy or regSell
bool anyHid = hidBuy or hidSell
bool anyEx  = exBuy or exSell
bool anyOB  = obBuy or obSell
bool anyMid = midBuy or midSell

int stochSignalType = not sAct ? 0 :
                       anyReg ? 4 :
                       anyHid ? 5 :
                       anyEx  ? 1 :
                       anyOB  ? 2 :
                       anyMid ? 3 : 0

int stochDirection = not sAct ? 0 :
                      anyReg ? (regBuy ? 1 : -1) :
                      anyHid ? (hidBuy ? 1 : -1) :
                      anyEx  ? (exBuy ? 1 : -1) :
                      anyOB  ? (obBuy ? 1 : -1) :
                      anyMid ? (midBuy ? 1 : -1) : 0

// ============================================================
//  Rank
//   1 Middle / 2 OBOS / 3 Extreme / 4 Divergence / 5 Div+Extreme
// ============================================================
bool anyDiv = anyReg or anyHid
int stochRank = not sAct ? 0 :
                 (anyDiv and anyEx) ? 5 :
                 anyDiv ? 4 :
                 anyEx ? 3 :
                 anyOB ? 2 :
                 anyMid ? 1 : 0

// ============================================================
//  接続用出力
// ============================================================
bool allowLongByStoch  = useStochModule and stochDirection == 1  and not stochNoBuy
bool allowShortByStoch = useStochModule and stochDirection == -1 and not stochNoSell
bool stochNoTrade = stochNoBuy or stochNoSell

// ============================================================
//  表示 : レベル / K・D
// ============================================================
hline(extremeHigh, "Extreme High", color = color.new(color.red, 50), linestyle = hline.style_dotted)
hline(obLevel,     "OB",           color = color.new(color.red, 70))
hline(middleLevel, "Middle",       color = color.new(color.gray, 50))
hline(osLevel,     "OS",           color = color.new(color.green, 70))
hline(extremeLow,  "Extreme Low",  color = color.new(color.green, 50), linestyle = hline.style_dotted)

plot(showStochPanePlots ? stochK : na, "%K", color = color.new(color.blue, 0),  linewidth = 2)
plot(showStochPanePlots ? stochD : na, "%D", color = color.new(color.orange, 0), linewidth = 1)

// 張り付き 背景
bgcolor(stochBullSticky ? color.new(color.green, 88) : stochBearSticky ? color.new(color.red, 88) : na, title = "Sticky BG")

// ============================================================
//  表示 : ラベル (ペイン内 stochK 位置)
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, stochK, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.tiny)

if showStochLabels
    if stochBuyExtremeSignal
        f_mkLabel(true,  "Ex↑", color.new(color.green, 0))
    if stochSellExtremeSignal
        f_mkLabel(false, "Ex↓", color.new(color.red, 0))
    if stochBuyOBOSCrossSignal
        f_mkLabel(true,  "OBOS↑", color.new(color.teal, 0))
    if stochSellOBOSCrossSignal
        f_mkLabel(false, "OBOS↓", color.new(color.maroon, 0))
    if stochBuyMiddleCrossSignal
        f_mkLabel(true,  "Mid↑", color.new(color.lime, 0))
    if stochSellMiddleCrossSignal
        f_mkLabel(false, "Mid↓", color.new(color.fuchsia, 0))
    if stochBuyRegularDivSignal
        f_mkLabel(true,  "Div↑", color.new(color.aqua, 0))
    if stochSellRegularDivSignal
        f_mkLabel(false, "Div↓", color.new(color.orange, 0))
    if stochBuyHiddenDivSignal
        f_mkLabel(true,  "HDiv↑", color.new(color.blue, 0))
    if stochSellHiddenDivSignal
        f_mkLabel(false, "HDiv↓", color.new(color.purple, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Extreme" : t == 2 ? "OBOS" : t == 3 ? "Middle" : t == 4 ? "RegDiv" : t == 5 ? "HidDiv" : "-"

var table dbg = table.new(position.top_right, 2, 7, border_width = 1)
if showStochDebugTable and barstate.islast
    string sDir = stochDirection == 1 ? "BUY" : stochDirection == -1 ? "SELL" : "-"
    string sSticky = stochBullSticky ? "Bull" : stochBearSticky ? "Bear" : "-"
    table.cell(dbg, 0, 0, "Stoch", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, stochNoTrade ? "NoTrade" : (stochDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = stochNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "%K", text_color = color.white)
    table.cell(dbg, 1, 1, na(stochK) ? "-" : str.tostring(stochK, "#.#"), text_color = color.white)
    table.cell(dbg, 0, 2, "%D", text_color = color.white)
    table.cell(dbg, 1, 2, na(stochD) ? "-" : str.tostring(stochD, "#.#"), text_color = color.white)
    table.cell(dbg, 0, 3, "Signal Type", text_color = color.white)
    table.cell(dbg, 1, 3, f_typeStr(stochSignalType), text_color = color.white)
    table.cell(dbg, 0, 4, "Direction", text_color = color.white)
    table.cell(dbg, 1, 4, sDir, text_color = color.white)
    table.cell(dbg, 0, 5, "Rank / Sticky", text_color = color.white)
    table.cell(dbg, 1, 5, str.tostring(stochRank) + " / " + sSticky, text_color = color.white)
    table.cell(dbg, 0, 6, "NoTrade", text_color = color.white)
    table.cell(dbg, 1, 6, stochNoTrade ? "Y" : "N", text_color = stochNoTrade ? color.red : color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(stochK, "stochK", display = display.data_window)
plot(stochD, "stochD", display = display.data_window)
plot(stochSignalType, "stochSignalType", display = display.data_window)
plot(stochDirection,  "stochDirection",  display = display.data_window)
plot(stochRank,       "stochRank",       display = display.data_window)
plot(stochBullSticky ? 1 : 0, "stochBullSticky", display = display.data_window)
plot(stochBearSticky ? 1 : 0, "stochBearSticky", display = display.data_window)
plot(stochNoBuy  ? 1 : 0, "stochNoBuy",  display = display.data_window)
plot(stochNoSell ? 1 : 0, "stochNoSell", display = display.data_window)
plot(stochNoTrade ? 1 : 0, "stochNoTrade", display = display.data_window)
plot(allowLongByStoch  ? 1 : 0, "allowLongByStoch",  display = display.data_window)
plot(allowShortByStoch ? 1 : 0, "allowShortByStoch", display = display.data_window)
plot(stochBuyExtremeSignal  ? 1 : 0, "stochBuyExtremeSignal",  display = display.data_window)
plot(stochSellExtremeSignal ? 1 : 0, "stochSellExtremeSignal", display = display.data_window)
plot(stochBuyOBOSCrossSignal  ? 1 : 0, "stochBuyOBOSCrossSignal",  display = display.data_window)
plot(stochSellOBOSCrossSignal ? 1 : 0, "stochSellOBOSCrossSignal", display = display.data_window)
plot(stochBuyMiddleCrossSignal  ? 1 : 0, "stochBuyMiddleCrossSignal",  display = display.data_window)
plot(stochSellMiddleCrossSignal ? 1 : 0, "stochSellMiddleCrossSignal", display = display.data_window)
plot(stochBuyRegularDivSignal  ? 1 : 0, "stochBuyRegularDivSignal",  display = display.data_window)
plot(stochSellRegularDivSignal ? 1 : 0, "stochSellRegularDivSignal", display = display.data_window)
plot(stochBuyHiddenDivSignal   ? 1 : 0, "stochBuyHiddenDivSignal",   display = display.data_window)
plot(stochSellHiddenDivSignal  ? 1 : 0, "stochSellHiddenDivSignal",  display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(stochBuyExtremeSignal,  "Stoch BUY Extreme",  "{{ticker}} ストキャス Extreme BUY")
alertcondition(stochSellExtremeSignal, "Stoch SELL Extreme", "{{ticker}} ストキャス Extreme SELL")
alertcondition(stochBuyOBOSCrossSignal,  "Stoch BUY OBOS",  "{{ticker}} ストキャス OBOS BUY")
alertcondition(stochSellOBOSCrossSignal, "Stoch SELL OBOS", "{{ticker}} ストキャス OBOS SELL")
alertcondition(stochBuyMiddleCrossSignal,  "Stoch BUY Middle",  "{{ticker}} ストキャス Middle BUY")
alertcondition(stochSellMiddleCrossSignal, "Stoch SELL Middle", "{{ticker}} ストキャス Middle SELL")
alertcondition(stochBuyRegularDivSignal,  "Stoch BUY RegDiv",  "{{ticker}} ストキャス Regular Div BUY")
alertcondition(stochSellRegularDivSignal, "Stoch SELL RegDiv", "{{ticker}} ストキャス Regular Div SELL")
alertcondition(stochBuyHiddenDivSignal,  "Stoch BUY HidDiv",  "{{ticker}} ストキャス Hidden Div BUY")
alertcondition(stochSellHiddenDivSignal, "Stoch SELL HidDiv", "{{ticker}} ストキャス Hidden Div SELL")
alertcondition(allowLongByStoch,  "Allow Long Stoch",  "{{ticker}} ストキャス ロング許可")
alertcondition(allowShortByStoch, "Allow Short Stoch", "{{ticker}} ストキャス ショート許可")
alertcondition(stochNoTrade,      "Stoch NoTrade",     "{{ticker}} ストキャス ノートレード")

//@version=5
// =====================================================================================
// POINT MASTER FVG ABS REBOUND  ―  マルチロジック / マルチタイムフレーム スコアリング
// =====================================================================================
// POINT_MASTER_TEMPLATE.pine（原本）をベースに、以下を接続したものです。
//   Logic01 = FVG Absorption（FVG吸収）
//   Logic02 = FVG Rebound（FVG反発）
//   Logic03 = Accum Rebound（Accum境界反発）
//   Logic04 = Accum Break（Accumブレイク / ブレイク失敗の箱内復帰）
//   Logic05〜08 = EMA200 / 1000 / 2000 / 3000 Rebound（1M・5Mのみ）
//   Logic09〜12 = EMA200 / 1000 / 2000 / 3000 Break（1M・5Mのみ）
//   Logic13 = Trendline Rebound（全6TF）
//   Logic14 = Trendline Break（全6TF）
//   Logic15 = H&S Pattern（三尊 = SHORT / 逆三尊 = LONG・全6TF）
//   Logic16 = Double Top / Bottom（DT = SHORT / DB = LONG・全6TF）
//   Logic17 = Wedge Pattern（Bear = SHORT / Bull = LONG・全6TF）
//   Logic18 = Triangle Pattern（Ascending / Descending のみ・全6TF）
//   Logic19 = Horizontal Rebound（前日H/L + セッションH/L ゾーン反発・全6TF）
//   Logic20 = Horizontal Break（同ゾーンのブレイク / ブレイク後のゾーン復帰・全6TF）
//   Logic21 = Fib 38.2 Rebound（採用波の押し/戻しからの終値回復・全6TF）
//   Logic22 = Fib 50.0 Rebound（〃）
//   Logic23 = Fib 61.8 Rebound（〃）
//   Logic24 = Alice Band Bias（Alice BAND 2本の価格位置による状態型Bias・全6TF）
//   Logic25 = Stochastic Turn（%K の Extreme到達 → 折り返しイベント・全6TF）
//   Logic26以降 = 未使用（下の4ステップで追加）
// 共通基盤（MTF / 状態管理 / 保持 / Weight / 集計 / テーブル / アラート）は原本のままです。
//
//   ポイント計算式 :  ロジックWeight × 時間足Weight
//   集計           :  LONG SCORE / SHORT SCORE / NET SCORE ( = LONG - SHORT )
//   状態管理       :  同一ロジック × 同一TF は NONE / LONG / SHORT の3状態のみ
//                     （LONGとSHORTの同時保持は構造上できない）
//
// 【ロジックを1個追加する時に触る場所】
//   §0 : N_LOGIC を +1 し、追加先Engineの ENG_A_N / ENG_B_N / ENG_C_N を +1
//   §2 : 名称 / ロジックWeight の input ブロックを追加し、2つの array.from に足す
//   §3 : 保持本数の input ブロックを追加し、HOLD_ALL に array.concat を1行追加
//   §4 : LONG / SHORT の bool を書き、追加先Engineの longs / shorts の array.from に足す
//        （ロジックのパラメータは input ブロックの直後に PRM_XXX = array.from(...) を作り、
//          ロジック関数は array.get() で読む。§3.5 の external elements 対策を参照）
//   → これだけ。集計・状態管理・表示は自動的に対応します。
//
// 【MTF計算エンジンは3分割】（§5・external elements 254個制限の回避）
//   Engine A = Logic01〜12 / Engine B = Logic13〜18 / Engine C = Logic19〜25
//   request.security() は 6TF × 3Engine = 18回。Engineが増えたら §5 に6行足すだけです。
// =====================================================================================
indicator(
     title         = "POINT MASTER FVG ABS REBOUND",
     shorttitle    = "PM-FVG2",
     overlay       = true,
     max_bars_back = 500
 )

// =====================================================================================
// §0. 定数
// =====================================================================================
// ロジック本数。ロジックを1個追加したら必ずこの数字を +1 する。
int N_LOGIC = 25
// 対応時間足の本数（1M / 5M / 15M / 1H / 4H / 1D の6本。通常は変更不要）
int N_TF = 6

// -------------------------------------------------------------------------------------
// MTF計算エンジンの分割数（★external elements 対策）
// -------------------------------------------------------------------------------------
// request.security() の式1本が参照できる外部要素は254個までのため、ロジックを
// Engine A / B / C の3グループに分けて、TFごとにEngine単位で request.security() します。
//   Engine A : Logic01〜12（先頭から ENG_A_N 個）
//   Engine B : Logic13〜18（続く ENG_B_N 個）
//   Engine C : Logic19〜25（続く ENG_C_N 個。Fib解除マスクもここが返す）
// ★ ENG_A_N + ENG_B_N + ENG_C_N は必ず N_LOGIC と一致させること。
// ★ ロジックを追加する時は、余裕のあるEngineの末尾へ足してその個数を +1 する
//    （もしくは §4 / §5 の形をコピーして Engine D を追加する）。
int ENG_A_N = 12
int ENG_B_N = 6
int ENG_C_N = 7

// 状態コード
int ST_NONE  = 0
int ST_LONG  = 1
int ST_SHORT = -1

// 両方向同時発生時の裁定コード
int CONF_IGNORE = 0
int CONF_LONG   = 1
int CONF_SHORT  = 2

// 1次元配列のインデックス変換： index = ロジック番号 * TF数 + TF番号
f_idx(li, ti) => li * N_TF + ti

// =====================================================================================
// §1. 時間足設定（★TF Weight はここで変更）
// =====================================================================================
// 集計対象の時間足そのものも input なので「1M → 3M」のような差し替えも可能。
grpTF = "① 時間足設定 (TF)"
tfStr1 = input.timeframe("1",   "TF1 時間足", group = grpTF, inline = "tf1")
tfW1   = input.float(1.0,       "Weight",     group = grpTF, inline = "tf1", step = 0.1, minval = 0)
tfStr2 = input.timeframe("5",   "TF2 時間足", group = grpTF, inline = "tf2")
tfW2   = input.float(1.2,       "Weight",     group = grpTF, inline = "tf2", step = 0.1, minval = 0)
tfStr3 = input.timeframe("15",  "TF3 時間足", group = grpTF, inline = "tf3")
tfW3   = input.float(1.5,       "Weight",     group = grpTF, inline = "tf3", step = 0.1, minval = 0)
tfStr4 = input.timeframe("60",  "TF4 時間足", group = grpTF, inline = "tf4")
tfW4   = input.float(2.0,       "Weight",     group = grpTF, inline = "tf4", step = 0.1, minval = 0)
tfStr5 = input.timeframe("240", "TF5 時間足", group = grpTF, inline = "tf5")
tfW5   = input.float(3.0,       "Weight",     group = grpTF, inline = "tf5", step = 0.1, minval = 0)
tfStr6 = input.timeframe("D",   "TF6 時間足", group = grpTF, inline = "tf6")
tfW6   = input.float(4.0,       "Weight",     group = grpTF, inline = "tf6", step = 0.1, minval = 0)

// TFリスト（index 0..5 = 1M, 5M, 15M, 1H, 4H, 1D）
TF_LIST   = array.from(tfStr1, tfStr2, tfStr3, tfStr4, tfStr5, tfStr6)
TF_WEIGHT = array.from(tfW1,   tfW2,   tfW3,   tfW4,   tfW5,   tfW6)

// =====================================================================================
// §2. ロジック設定（★ロジック名 / ロジックWeight はここで変更）
// =====================================================================================
// ロジックを追加する時は、ここに1ブロック追加して LOGIC_NAME / LOGIC_WEIGHT に足す。
// 名称は input なので、Logic01 を後から "FVG" に書き換えればテーブル表示も変わる。
grpL1 = "② Logic01 : FVG Absorption"
l01Name = input.string("FVG Abs", "名称",           group = grpL1)
l01W    = input.float(1.0,        "ロジックWeight", group = grpL1, step = 0.1, minval = 0)

grpL2 = "② Logic02 : FVG Rebound"
l02Name = input.string("FVG Reb", "名称",           group = grpL2)
l02W    = input.float(1.0,        "ロジックWeight", group = grpL2, step = 0.1, minval = 0)

grpL3 = "② Logic03 : Accum Rebound"
l03Name = input.string("Accum Reb", "名称",           group = grpL3)
l03W    = input.float(1.0,          "ロジックWeight", group = grpL3, step = 0.1, minval = 0)

grpL4 = "② Logic04 : Accum Break"
l04Name = input.string("Accum Brk", "名称",           group = grpL4)
l04W    = input.float(1.5,          "ロジックWeight", group = grpL4, step = 0.1, minval = 0)

// --- Logic05〜08 : EMA Rebound（1M / 5M のみ）---
grpL5 = "② Logic05 : EMA200 Rebound"
l05Name = input.string("E200 Reb", "名称",           group = grpL5)
l05W    = input.float(1.0,         "ロジックWeight", group = grpL5, step = 0.1, minval = 0)

grpL6 = "② Logic06 : EMA1000 Rebound"
l06Name = input.string("E1000 Reb", "名称",           group = grpL6)
l06W    = input.float(1.5,          "ロジックWeight", group = grpL6, step = 0.1, minval = 0)

grpL7 = "② Logic07 : EMA2000 Rebound"
l07Name = input.string("E2000 Reb", "名称",           group = grpL7)
l07W    = input.float(2.0,          "ロジックWeight", group = grpL7, step = 0.1, minval = 0)

grpL8 = "② Logic08 : EMA3000 Rebound"
l08Name = input.string("E3000 Reb", "名称",           group = grpL8)
l08W    = input.float(2.5,          "ロジックWeight", group = grpL8, step = 0.1, minval = 0)

// --- Logic09〜12 : EMA Break（1M / 5M のみ）---
grpL9 = "② Logic09 : EMA200 Break"
l09Name = input.string("E200 Brk", "名称",           group = grpL9)
l09W    = input.float(1.0,         "ロジックWeight", group = grpL9, step = 0.1, minval = 0)

grpL10 = "② Logic10 : EMA1000 Break"
l10Name = input.string("E1000 Brk", "名称",           group = grpL10)
l10W    = input.float(1.5,          "ロジックWeight", group = grpL10, step = 0.1, minval = 0)

grpL11 = "② Logic11 : EMA2000 Break"
l11Name = input.string("E2000 Brk", "名称",           group = grpL11)
l11W    = input.float(2.0,          "ロジックWeight", group = grpL11, step = 0.1, minval = 0)

grpL12 = "② Logic12 : EMA3000 Break"
l12Name = input.string("E3000 Brk", "名称",           group = grpL12)
l12W    = input.float(2.5,          "ロジックWeight", group = grpL12, step = 0.1, minval = 0)

// --- Logic13 / 14 : Trendline（全6TF）---
grpL13 = "② Logic13 : Trendline Rebound"
l13Name = input.string("TL Reb", "名称",           group = grpL13)
l13W    = input.float(1.0,       "ロジックWeight", group = grpL13, step = 0.1, minval = 0)

grpL14 = "② Logic14 : Trendline Break"
l14Name = input.string("TL Brk", "名称",           group = grpL14)
l14W    = input.float(1.0,       "ロジックWeight", group = grpL14, step = 0.1, minval = 0)

// --- Logic15 : 三尊 / 逆三尊（全6TF）---
grpL15 = "② Logic15 : H&S Pattern"
l15Name = input.string("H&S", "名称",           group = grpL15)
l15W    = input.float(1.0,    "ロジックWeight", group = grpL15, step = 0.1, minval = 0)

// --- Logic16 : Double Top / Bottom（全6TF）---
grpL16 = "② Logic16 : Double Top / Bottom"
l16Name = input.string("DT/DB", "名称",           group = grpL16)
l16W    = input.float(1.0,      "ロジックWeight", group = grpL16, step = 0.1, minval = 0)

// --- Logic17 : Wedge Pattern（全6TF）---
grpL17 = "② Logic17 : Wedge Pattern"
l17Name = input.string("Wedge", "名称",           group = grpL17)
l17W    = input.float(1.0,      "ロジックWeight", group = grpL17, step = 0.1, minval = 0)

// --- Logic18 : Triangle Pattern（全6TF）---
grpL18 = "② Logic18 : Triangle Pattern"
l18Name = input.string("Triangle", "名称",           group = grpL18)
l18W    = input.float(1.0,         "ロジックWeight", group = grpL18, step = 0.1, minval = 0)

// --- Logic19 : Horizontal Rebound（全6TF）---
grpL19 = "② Logic19 : Horizontal Rebound"
l19Name = input.string("Horiz Reb", "名称",           group = grpL19)
l19W    = input.float(1.0,          "ロジックWeight", group = grpL19, step = 0.1, minval = 0)

// --- Logic20 : Horizontal Break（全6TF）---
grpL20 = "② Logic20 : Horizontal Break"
l20Name = input.string("Horiz Brk", "名称",           group = grpL20)
l20W    = input.float(1.0,          "ロジックWeight", group = grpL20, step = 0.1, minval = 0)

// --- Logic21 : Fib 38.2 Rebound（全6TF）---
grpL21 = "② Logic21 : Fib 38.2 Rebound"
l21Name = input.string("Fib382", "名称",           group = grpL21)
l21W    = input.float(1.0,       "ロジックWeight", group = grpL21, step = 0.1, minval = 0)

// --- Logic22 : Fib 50.0 Rebound（全6TF）---
grpL22 = "② Logic22 : Fib 50.0 Rebound"
l22Name = input.string("Fib500", "名称",           group = grpL22)
l22W    = input.float(1.0,       "ロジックWeight", group = grpL22, step = 0.1, minval = 0)

// --- Logic23 : Fib 61.8 Rebound（全6TF）---
grpL23 = "② Logic23 : Fib 61.8 Rebound"
l23Name = input.string("Fib618", "名称",           group = grpL23)
l23W    = input.float(1.0,       "ロジックWeight", group = grpL23, step = 0.1, minval = 0)

// --- Logic24 : Alice Band Bias（全6TF・状態型）---
grpL24 = "② Logic24 : Alice Band Bias"
l24Name = input.string("Alice Band", "名称",           group = grpL24)
l24W    = input.float(1.0,           "ロジックWeight", group = grpL24, step = 0.1, minval = 0)

// --- Logic25 : Stochastic Turn（全6TF）---
grpL25 = "② Logic25 : Stochastic Turn"
l25Name = input.string("Stoch Turn", "名称",           group = grpL25)
l25W    = input.float(1.0,           "ロジックWeight", group = grpL25, step = 0.1, minval = 0)

// ★ロジック追加時はここに grpL26 ブロックを追加し、下の2行に足す
LOGIC_NAME   = array.from(l01Name, l02Name, l03Name, l04Name, l05Name, l06Name, l07Name, l08Name, l09Name, l10Name, l11Name, l12Name, l13Name, l14Name, l15Name, l16Name, l17Name, l18Name, l19Name, l20Name, l21Name, l22Name, l23Name, l24Name, l25Name)
LOGIC_WEIGHT = array.from(l01W,    l02W,    l03W,    l04W,    l05W,    l06W,    l07W,    l08W,    l09W,    l10W,    l11W,    l12W,    l13W,    l14W,    l15W,    l16W,    l17W,    l18W,    l19W,    l20W,    l21W,    l22W,    l23W,    l24W,    l25W)

// =====================================================================================
// §3. 保持本数設定（★保持本数はここで変更 / ロジック × 時間足ごと）
// =====================================================================================
// 「そのTFの確定足で何本ぶんシグナルを保持するか」。
// 例) Logic01 の 15M を 24 にすると、15M足24本のあいだポイントが加算され続ける。
//     （チャート足の本数ではなく、必ずそのTF自身の本数で数えます）
grpH1 = "③ Logic01 保持本数"
h01a = input.int(6, "1M",  group = grpH1, minval = 1, inline = "h1a")
h01b = input.int(6, "5M",  group = grpH1, minval = 1, inline = "h1a")
h01c = input.int(6, "15M", group = grpH1, minval = 1, inline = "h1a")
h01d = input.int(6, "1H",  group = grpH1, minval = 1, inline = "h1b")
h01e = input.int(6, "4H",  group = grpH1, minval = 1, inline = "h1b")
h01f = input.int(6, "1D",  group = grpH1, minval = 1, inline = "h1b")

grpH2 = "③ Logic02 (FVG Rebound) 保持本数"
h02a = input.int(6, "1M",  group = grpH2, minval = 1, inline = "h2a")
h02b = input.int(6, "5M",  group = grpH2, minval = 1, inline = "h2a")
h02c = input.int(6, "15M", group = grpH2, minval = 1, inline = "h2a")
h02d = input.int(6, "1H",  group = grpH2, minval = 1, inline = "h2b")
h02e = input.int(6, "4H",  group = grpH2, minval = 1, inline = "h2b")
h02f = input.int(6, "1D",  group = grpH2, minval = 1, inline = "h2b")

grpH3 = "③ Logic03 (Accum Rebound) 保持本数"
h03a = input.int(6, "1M",  group = grpH3, minval = 1, inline = "h3a")
h03b = input.int(6, "5M",  group = grpH3, minval = 1, inline = "h3a")
h03c = input.int(6, "15M", group = grpH3, minval = 1, inline = "h3a")
h03d = input.int(6, "1H",  group = grpH3, minval = 1, inline = "h3b")
h03e = input.int(6, "4H",  group = grpH3, minval = 1, inline = "h3b")
h03f = input.int(6, "1D",  group = grpH3, minval = 1, inline = "h3b")

grpH4 = "③ Logic04 (Accum Break) 保持本数"
h04a = input.int(6, "1M",  group = grpH4, minval = 1, inline = "h4a")
h04b = input.int(6, "5M",  group = grpH4, minval = 1, inline = "h4a")
h04c = input.int(6, "15M", group = grpH4, minval = 1, inline = "h4a")
h04d = input.int(6, "1H",  group = grpH4, minval = 1, inline = "h4b")
h04e = input.int(6, "4H",  group = grpH4, minval = 1, inline = "h4b")
h04f = input.int(6, "1D",  group = grpH4, minval = 1, inline = "h4b")

// --- Logic05〜12（EMA）は 1M / 5M のみ対象なので保持本数も 1M / 5M だけ ---
grpH5  = "③ Logic05 (EMA200 Reb) 保持本数"
h05a = input.int(30, "1M", group = grpH5,  minval = 1, inline = "h5")
h05b = input.int(24, "5M", group = grpH5,  minval = 1, inline = "h5")
grpH6  = "③ Logic06 (EMA1000 Reb) 保持本数"
h06a = input.int(30, "1M", group = grpH6,  minval = 1, inline = "h6")
h06b = input.int(24, "5M", group = grpH6,  minval = 1, inline = "h6")
grpH7  = "③ Logic07 (EMA2000 Reb) 保持本数"
h07a = input.int(30, "1M", group = grpH7,  minval = 1, inline = "h7")
h07b = input.int(24, "5M", group = grpH7,  minval = 1, inline = "h7")
grpH8  = "③ Logic08 (EMA3000 Reb) 保持本数"
h08a = input.int(30, "1M", group = grpH8,  minval = 1, inline = "h8")
h08b = input.int(24, "5M", group = grpH8,  minval = 1, inline = "h8")
grpH9  = "③ Logic09 (EMA200 Brk) 保持本数"
h09a = input.int(30, "1M", group = grpH9,  minval = 1, inline = "h9")
h09b = input.int(24, "5M", group = grpH9,  minval = 1, inline = "h9")
grpH10 = "③ Logic10 (EMA1000 Brk) 保持本数"
h10a = input.int(30, "1M", group = grpH10, minval = 1, inline = "h10")
h10b = input.int(24, "5M", group = grpH10, minval = 1, inline = "h10")
grpH11 = "③ Logic11 (EMA2000 Brk) 保持本数"
h11a = input.int(30, "1M", group = grpH11, minval = 1, inline = "h11")
h11b = input.int(24, "5M", group = grpH11, minval = 1, inline = "h11")
grpH12 = "③ Logic12 (EMA3000 Brk) 保持本数"
h12a = input.int(30, "1M", group = grpH12, minval = 1, inline = "h12")
h12b = input.int(24, "5M", group = grpH12, minval = 1, inline = "h12")

// --- Logic13 / 14（Trendline）は全6TF対象 ---
grpH13 = "③ Logic13 (TL Rebound) 保持本数"
h13a = input.int(6, "1M",  group = grpH13, minval = 1, inline = "h13a")
h13b = input.int(6, "5M",  group = grpH13, minval = 1, inline = "h13a")
h13c = input.int(6, "15M", group = grpH13, minval = 1, inline = "h13a")
h13d = input.int(6, "1H",  group = grpH13, minval = 1, inline = "h13b")
h13e = input.int(6, "4H",  group = grpH13, minval = 1, inline = "h13b")
h13f = input.int(6, "1D",  group = grpH13, minval = 1, inline = "h13b")

grpH14 = "③ Logic14 (TL Break) 保持本数"
h14a = input.int(6, "1M",  group = grpH14, minval = 1, inline = "h14a")
h14b = input.int(6, "5M",  group = grpH14, minval = 1, inline = "h14a")
h14c = input.int(6, "15M", group = grpH14, minval = 1, inline = "h14a")
h14d = input.int(6, "1H",  group = grpH14, minval = 1, inline = "h14b")
h14e = input.int(6, "4H",  group = grpH14, minval = 1, inline = "h14b")
h14f = input.int(6, "1D",  group = grpH14, minval = 1, inline = "h14b")

// --- Logic15（三尊 / 逆三尊）は全6TF対象 ---
grpH15 = "③ Logic15 (H&S) 保持本数"
h15a = input.int(6, "1M",  group = grpH15, minval = 1, inline = "h15a")
h15b = input.int(6, "5M",  group = grpH15, minval = 1, inline = "h15a")
h15c = input.int(6, "15M", group = grpH15, minval = 1, inline = "h15a")
h15d = input.int(6, "1H",  group = grpH15, minval = 1, inline = "h15b")
h15e = input.int(6, "4H",  group = grpH15, minval = 1, inline = "h15b")
h15f = input.int(6, "1D",  group = grpH15, minval = 1, inline = "h15b")

// --- Logic16（DT/DB）は全6TF対象 ---
grpH16 = "③ Logic16 (DT/DB) 保持本数"
h16a = input.int(6, "1M",  group = grpH16, minval = 1, inline = "h16a")
h16b = input.int(6, "5M",  group = grpH16, minval = 1, inline = "h16a")
h16c = input.int(6, "15M", group = grpH16, minval = 1, inline = "h16a")
h16d = input.int(6, "1H",  group = grpH16, minval = 1, inline = "h16b")
h16e = input.int(6, "4H",  group = grpH16, minval = 1, inline = "h16b")
h16f = input.int(6, "1D",  group = grpH16, minval = 1, inline = "h16b")

// --- Logic17（Wedge）は全6TF対象 ---
grpH17 = "③ Logic17 (Wedge) 保持本数"
h17a = input.int(6, "1M",  group = grpH17, minval = 1, inline = "h17a")
h17b = input.int(6, "5M",  group = grpH17, minval = 1, inline = "h17a")
h17c = input.int(6, "15M", group = grpH17, minval = 1, inline = "h17a")
h17d = input.int(6, "1H",  group = grpH17, minval = 1, inline = "h17b")
h17e = input.int(6, "4H",  group = grpH17, minval = 1, inline = "h17b")
h17f = input.int(6, "1D",  group = grpH17, minval = 1, inline = "h17b")

// --- Logic18（Triangle）は全6TF対象 ---
grpH18 = "③ Logic18 (Triangle) 保持本数"
h18a = input.int(6, "1M",  group = grpH18, minval = 1, inline = "h18a")
h18b = input.int(6, "5M",  group = grpH18, minval = 1, inline = "h18a")
h18c = input.int(6, "15M", group = grpH18, minval = 1, inline = "h18a")
h18d = input.int(6, "1H",  group = grpH18, minval = 1, inline = "h18b")
h18e = input.int(6, "4H",  group = grpH18, minval = 1, inline = "h18b")
h18f = input.int(6, "1D",  group = grpH18, minval = 1, inline = "h18b")

// --- Logic19（Horizontal Rebound）は全6TF対象 ---
grpH19 = "③ Logic19 (Horiz Reb) 保持本数"
h19a = input.int(6, "1M",  group = grpH19, minval = 1, inline = "h19a")
h19b = input.int(6, "5M",  group = grpH19, minval = 1, inline = "h19a")
h19c = input.int(6, "15M", group = grpH19, minval = 1, inline = "h19a")
h19d = input.int(6, "1H",  group = grpH19, minval = 1, inline = "h19b")
h19e = input.int(6, "4H",  group = grpH19, minval = 1, inline = "h19b")
h19f = input.int(6, "1D",  group = grpH19, minval = 1, inline = "h19b")

// --- Logic20（Horizontal Break）は全6TF対象 ---
grpH20 = "③ Logic20 (Horiz Brk) 保持本数"
h20a = input.int(6, "1M",  group = grpH20, minval = 1, inline = "h20a")
h20b = input.int(6, "5M",  group = grpH20, minval = 1, inline = "h20a")
h20c = input.int(6, "15M", group = grpH20, minval = 1, inline = "h20a")
h20d = input.int(6, "1H",  group = grpH20, minval = 1, inline = "h20b")
h20e = input.int(6, "4H",  group = grpH20, minval = 1, inline = "h20b")
h20f = input.int(6, "1D",  group = grpH20, minval = 1, inline = "h20b")

// --- Logic21（Fib 38.2 Rebound）は全6TF対象 ---
grpH21 = "③ Logic21 (Fib382) 保持本数"
h21a = input.int(6, "1M",  group = grpH21, minval = 1, inline = "h21a")
h21b = input.int(6, "5M",  group = grpH21, minval = 1, inline = "h21a")
h21c = input.int(6, "15M", group = grpH21, minval = 1, inline = "h21a")
h21d = input.int(6, "1H",  group = grpH21, minval = 1, inline = "h21b")
h21e = input.int(6, "4H",  group = grpH21, minval = 1, inline = "h21b")
h21f = input.int(6, "1D",  group = grpH21, minval = 1, inline = "h21b")

// --- Logic22（Fib 50.0 Rebound）は全6TF対象 ---
grpH22 = "③ Logic22 (Fib500) 保持本数"
h22a = input.int(6, "1M",  group = grpH22, minval = 1, inline = "h22a")
h22b = input.int(6, "5M",  group = grpH22, minval = 1, inline = "h22a")
h22c = input.int(6, "15M", group = grpH22, minval = 1, inline = "h22a")
h22d = input.int(6, "1H",  group = grpH22, minval = 1, inline = "h22b")
h22e = input.int(6, "4H",  group = grpH22, minval = 1, inline = "h22b")
h22f = input.int(6, "1D",  group = grpH22, minval = 1, inline = "h22b")

// --- Logic23（Fib 61.8 Rebound）は全6TF対象 ---
grpH23 = "③ Logic23 (Fib618) 保持本数"
h23a = input.int(6, "1M",  group = grpH23, minval = 1, inline = "h23a")
h23b = input.int(6, "5M",  group = grpH23, minval = 1, inline = "h23a")
h23c = input.int(6, "15M", group = grpH23, minval = 1, inline = "h23a")
h23d = input.int(6, "1H",  group = grpH23, minval = 1, inline = "h23b")
h23e = input.int(6, "4H",  group = grpH23, minval = 1, inline = "h23b")
h23f = input.int(6, "1D",  group = grpH23, minval = 1, inline = "h23b")

// ロジック別の保持本数リスト（TF順）
HOLD01 = array.from(h01a, h01b, h01c, h01d, h01e, h01f)
HOLD02 = array.from(h02a, h02b, h02c, h02d, h02e, h02f)
HOLD03 = array.from(h03a, h03b, h03c, h03d, h03e, h03f)
HOLD04 = array.from(h04a, h04b, h04c, h04d, h04e, h04f)
// EMAロジックは15M以降を使わないため、そのTFの保持本数はダミー値（イベントが発生しない）
HOLD05 = array.from(h05a, h05b, 1, 1, 1, 1)
HOLD06 = array.from(h06a, h06b, 1, 1, 1, 1)
HOLD07 = array.from(h07a, h07b, 1, 1, 1, 1)
HOLD08 = array.from(h08a, h08b, 1, 1, 1, 1)
HOLD09 = array.from(h09a, h09b, 1, 1, 1, 1)
HOLD10 = array.from(h10a, h10b, 1, 1, 1, 1)
HOLD11 = array.from(h11a, h11b, 1, 1, 1, 1)
HOLD12 = array.from(h12a, h12b, 1, 1, 1, 1)
HOLD13 = array.from(h13a, h13b, h13c, h13d, h13e, h13f)
HOLD14 = array.from(h14a, h14b, h14c, h14d, h14e, h14f)
HOLD15 = array.from(h15a, h15b, h15c, h15d, h15e, h15f)
HOLD16 = array.from(h16a, h16b, h16c, h16d, h16e, h16f)
HOLD17 = array.from(h17a, h17b, h17c, h17d, h17e, h17f)
HOLD18 = array.from(h18a, h18b, h18c, h18d, h18e, h18f)
HOLD19 = array.from(h19a, h19b, h19c, h19d, h19e, h19f)
HOLD20 = array.from(h20a, h20b, h20c, h20d, h20e, h20f)
HOLD21 = array.from(h21a, h21b, h21c, h21d, h21e, h21f)
HOLD22 = array.from(h22a, h22b, h22c, h22d, h22e, h22f)
HOLD23 = array.from(h23a, h23b, h23c, h23d, h23e, h23f)
// --- Logic25（Stochastic Turn）は全6TF対象（イベント型なので保持本数を使う）---
grpH25 = "③ Logic25 (Stoch Turn) 保持本数"
h25a = input.int(6, "1M",  group = grpH25, minval = 1, inline = "h25a")
h25b = input.int(6, "5M",  group = grpH25, minval = 1, inline = "h25a")
h25c = input.int(6, "15M", group = grpH25, minval = 1, inline = "h25a")
h25d = input.int(6, "1H",  group = grpH25, minval = 1, inline = "h25b")
h25e = input.int(6, "4H",  group = grpH25, minval = 1, inline = "h25b")
h25f = input.int(6, "1D",  group = grpH25, minval = 1, inline = "h25b")

// Logic24（Alice Band Bias）は状態型ロジックで保持本数を使わないため、input を持たず 0 固定。
// （§6 で ST_HOLD を使わず、現在のAlice状態をそのまま ST_STATE へ反映します）
HOLD24 = array.from(0, 0, 0, 0, 0, 0)
HOLD25 = array.from(h25a, h25b, h25c, h25d, h25e, h25f)

// 全ロジック分を1本の配列に連結（index = f_idx(logicIndex, tfIndex)）
var HOLD_ALL = array.new_int(0)
if array.size(HOLD_ALL) == 0
    array.concat(HOLD_ALL, HOLD01)
    array.concat(HOLD_ALL, HOLD02)
    array.concat(HOLD_ALL, HOLD03)
    array.concat(HOLD_ALL, HOLD04)
    array.concat(HOLD_ALL, HOLD05)
    array.concat(HOLD_ALL, HOLD06)
    array.concat(HOLD_ALL, HOLD07)
    array.concat(HOLD_ALL, HOLD08)
    array.concat(HOLD_ALL, HOLD09)
    array.concat(HOLD_ALL, HOLD10)
    array.concat(HOLD_ALL, HOLD11)
    array.concat(HOLD_ALL, HOLD12)
    array.concat(HOLD_ALL, HOLD13)
    array.concat(HOLD_ALL, HOLD14)
    array.concat(HOLD_ALL, HOLD15)
    array.concat(HOLD_ALL, HOLD16)
    array.concat(HOLD_ALL, HOLD17)
    array.concat(HOLD_ALL, HOLD18)
    array.concat(HOLD_ALL, HOLD19)
    array.concat(HOLD_ALL, HOLD20)
    array.concat(HOLD_ALL, HOLD21)
    array.concat(HOLD_ALL, HOLD22)
    array.concat(HOLD_ALL, HOLD23)
    array.concat(HOLD_ALL, HOLD24)
    array.concat(HOLD_ALL, HOLD25)
    // ★ロジック追加時はここに array.concat(HOLD_ALL, HOLD26) を1行追加

// =====================================================================================
// §3.5 パラメータ束 PRM_xxx（★external elements 対策 / ロジック追加時の増え方を抑える仕組み）
// =====================================================================================
// Pine の関数 / request.security() の式は「外部要素（グローバル変数 / input / 関数）」を
// 254個までしか参照できません（"#security.expr uses N external elements. The limit is 254."）。
//
// ★根本対策は §5 の Engine分割（Logic01〜12 / 13〜18 / 19〜23 の3本立て）です。
//   PRM束は「関数へ渡すパラメータの整理」であって、外部要素の削減手段ではありません
//   （array.from() の中身の input まで依存関係として展開されて数えられるため）。
//   コードの見通しのために残していますが、上限に近づいた時に効くのは Engine を増やす方です。
//
// 【PRM束の仕組み】ロジック判定用のパラメータを、ロジックごとに1本の float 配列へ束ねます。
//   ・input 自体は削除も変更もしていません（項目・既定値・グループ・表示は従来どおり）
//   ・各ロジックの input ブロックの直後に
//         var array<float> PRM_XXX = array.from( ... )
//     を置き、input の値をその配列へ格納する（bool は 1.0/0.0、モード文字列は数値コード）
//   ・ロジック関数は先頭で array.get(PRM_XXX, index) を読み、_pXxx というローカルで使う
//   ・array.from() の中身は input（定数）なので、request.security() の上位足コンテキストで
//     再評価されても同じ値になります（配列を後から array.set() で埋める方式にすると
//     上位足コンテキストで空のままになるため、必ず array.from() で作ります）。
//
// 【ロジックを追加する時】
//   そのロジックの input ブロックの直後に PRM_XXX を1本作り、関数側は array.get() で読むだけ。
//   外部要素の余裕は、そのロジックをどのEngineに入れるかで調整します（§0 / §5）。
//
// 【PRM へ入れないもの】
//   ta.atr / ta.ema / ta.sma / ta.pivothigh などの length 引数は simple int が必要で、
//   array.get() の戻り値（series float）を渡せません。そのため下記の「期間系」input だけは
//   従来どおり直接参照します（1ロジックあたり1〜2個）。
//     fvgAtrLen / rebAtrLen / accRangeLen / accBaseLen / accAtrLen / emaLenA〜D /
//     emaTolAtrLen / tlPivotLen / hsPivotLen / dtdbPivotLen / wedgePivotLen /
//     wedgeAtrExpandLen / triPivotLen / triAtrExpandLen / hzAtrLen / fibAtrLen / fibSwingLen
//   同じ理由で time(timeframe, session, timezone) のセッション文字列（hzSessTZ / hzAsiaSess /
//   hzLondonSess / hzNySess）と、timeframe.in_seconds() へ渡す tfStr1 / tfStr2 も直接参照です。
//
// ※ 判定条件・Weight・保持本数・MTF方式・状態管理・invalidate仕様は一切変更していません。
//    変わったのは「パラメータの受け渡し方」だけです。

// =====================================================================================
// §4. LOGIC SIGNAL INPUT AREA  ―― ★後から各ロジックをここへ接続する
// =====================================================================================
// この関数は request.security() 経由で「各時間足のコンテキスト」で実行されます。
// つまりここに書いた close / high / ta.ema() などは、自動的にその時間足の値になります。
// MTF対応のために特別なことをする必要はありません。
//
//   Logic01 → FVG Absorption（接続済み）
//   Logic02 → FVG Rebound（接続済み）
//   Logic03 → Accum Rebound（接続済み）
//   Logic04 → Accum Break（接続済み）
//   Logic05〜08 → EMA200/1000/2000/3000 Rebound（接続済み・1M/5Mのみ）
//   Logic09〜12 → EMA200/1000/2000/3000 Break（接続済み・1M/5Mのみ）
//   Logic13 → Trendline Rebound（接続済み・全6TF）
//   Logic14 → Trendline Break（接続済み・全6TF）
//   Logic15 → H&S Pattern（接続済み・全6TF）
//   Logic16 → Double Top / Bottom（接続済み・全6TF）
//   Logic17 → Wedge Pattern（接続済み・全6TF）
//   Logic18 → Triangle Pattern（接続済み・全6TF）
//   Logic19 → Horizontal Rebound（接続済み・全6TF）
//   Logic20 → Horizontal Break（接続済み・全6TF）
//   Logic21〜23 → Fib 38.2 / 50.0 / 61.8 Rebound（接続済み・全6TF）
//
// ロジックは3つのEngineに分かれています（§5・external elements 254個制限の回避）。
//   f_signalMasksA() : Logic01〜12 → [longMaskA, shortMaskA]
//   f_signalMasksB() : Logic13〜18 → [longMaskB, shortMaskB]
//   f_signalMasksC() : Logic19〜25 → [longMaskC, shortMaskC, invalidateMaskC]
// 各Engineは自分の担当ロジックだけをビットマスクへ圧縮して返します（ビットは0始まりの
// Engine内通し番号。元のロジック番号への対応は §6 で行います）。
// 解除マスクは Fibグループ（Logic21〜23）専用で、深いFib到達時に浅いFibロジックの
// 保持状態を解除するためだけに使います（Engine C 内の bit2/3/4 のみ・他ロジックは常に0）。

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic01 = FVG Absorption
// -------------------------------------------------------------------------------------
// 出力は「その確定足で吸収が新規発生したか」のイベント2値だけです。
// 保持 / 保持期限 / 同方向再発生 / LONG⇔SHORT切替 は一切行いません（POINT MASTER の責務）。
//
//   Bearish FVG（上端 = low[2]）を終値で上抜け → LONG イベント
//   Bullish FVG（下端 = high[2]）を終値で下抜け → SHORT イベント
//   ※ ヒゲだけの抜けでは成立しません（終値でFVG全体を抜けること）
//
// 最新の Bullish FVG / Bearish FVG を1本ずつ保持し、各FVGにつき吸収は1回だけ。
// 新しい同方向FVGが形成されたら、再び吸収判定が可能になります。
// この関数は §5 の共通MTF基盤から各時間足のコンテキストで評価されるため、
// FVG専用の request.security は一切追加していません。
grpFVG = "④ Logic01 : FVG吸収 パラメータ"
fvgAtrLen   = input.int(14,    "ATR期間",                group = grpFVG, minval = 1)
fvgMinThick = input.float(0.0, "FVG最小厚み (FVG幅/ATR)", group = grpFVG, step = 0.05, minval = 0)
useAbsColor = input.bool(true, "吸収: 方向と同じローソク色を要求", group = grpFVG)
useAbsBody  = input.bool(true, "吸収: 最低実体率を要求",   group = grpFVG, inline = "body")
fvgAbsBody  = input.float(0.50, "比率",                  group = grpFVG, inline = "body", step = 0.05)
useAbsEdge  = input.bool(true, "吸収: 終値端寄せを要求",   group = grpFVG, inline = "edge")
fvgAbsEdge  = input.float(0.60, "比率",                  group = grpFVG, inline = "edge", step = 0.05)

// --- Logic01 FVG Absorption のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_FVG = array.from(
     fvgMinThick,              // 00 : fvgMinThick
     useAbsColor ? 1.0 : 0.0,  // 01 : useAbsColor
     useAbsBody ? 1.0 : 0.0,   // 02 : useAbsBody
     fvgAbsBody,               // 03 : fvgAbsBody
     useAbsEdge ? 1.0 : 0.0,   // 04 : useAbsEdge
     fvgAbsEdge                // 05 : fvgAbsEdge
 )

f_fvgAbsEvent() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pFvgMinThick            = array.get(PRM_FVG, 0)
    bool  _pUseAbsColor            = array.get(PRM_FVG, 1) > 0.5
    bool  _pUseAbsBody             = array.get(PRM_FVG, 2) > 0.5
    float _pFvgAbsBody             = array.get(PRM_FVG, 3)
    bool  _pUseAbsEdge             = array.get(PRM_FVG, 4) > 0.5
    float _pFvgAbsEdge             = array.get(PRM_FVG, 5)
    float _atr = ta.atr(fvgAtrLen)
    var float _bullBot  = na     // Bullish FVG 下端 (= high[2])
    var int   _bullBar  = na
    var bool  _bullUsed = true   // 吸収済みフラグ（1FVGにつき1回）
    var float _bearTop  = na     // Bearish FVG 上端 (= low[2])
    var int   _bearBar  = na
    var bool  _bearUsed = true

    // FVG形成：最新の1本だけを監視対象とし、吸収済みフラグをリセットする
    if _atr > 0 and low > high[2] and (low - high[2]) / _atr >= _pFvgMinThick
        _bullBot  := high[2]
        _bullBar  := bar_index
        _bullUsed := false
    if _atr > 0 and high < low[2] and (low[2] - high) / _atr >= _pFvgMinThick
        _bearTop  := low[2]
        _bearBar  := bar_index
        _bearUsed := false

    // 吸収品質フィルター（3条件は個別にON/OFF可能）
    float _rng   = high - low
    float _body  = math.abs(close - open)
    bool  _bodyOk = _rng > 0 and _body / _rng >= _pFvgAbsBody
    bool  _nearHi = _rng > 0 and (close - low)  / _rng >= _pFvgAbsEdge
    bool  _nearLo = _rng > 0 and (high - close) / _rng >= _pFvgAbsEdge

    // 吸収イベント（最低条件 = 終値でFVG全体を抜ける）
    bool _long  = not na(_bearTop) and not _bearUsed and bar_index > _bearBar and close > _bearTop and (not _pUseAbsColor or close > open) and (not _pUseAbsBody or _bodyOk) and (not _pUseAbsEdge or _nearHi)
    bool _short = not na(_bullBot) and not _bullUsed and bar_index > _bullBar and close < _bullBot and (not _pUseAbsColor or close < open) and (not _pUseAbsBody or _bodyOk) and (not _pUseAbsEdge or _nearLo)

    // 同一足で両方成立した場合も両FVGを使用済みにする（方向の裁定は POINT MASTER §6 に任せる）
    if _long
        _bearUsed := true
    if _short
        _bullUsed := true
    [_long, _short]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic02 = FVG Rebound
// -------------------------------------------------------------------------------------
// 出力は「その確定足で反発が新規発生したか」のイベント2値だけです。
// 保持 / 保持期限 / 同方向再発生 / LONG⇔SHORT切替 は行いません（POINT MASTER の責務）。
//
//   Bullish FVG（top = low / bottom = high[2]）へのサポート反発 → LONG イベント
//   Bearish FVG（top = low[2] / bottom = high）へのレジ反発     → SHORT イベント
//
// 反発の条件（元コードと同一）
//   LONG  : low <= top / 侵入率 (top - low)/幅 <= 最大侵入率 /
//           close >= bottom + 幅 × 回復位置 / 陽線 (close > open)
//   SHORT : high >= bottom / 侵入率 (high - bottom)/幅 <= 最大侵入率 /
//           close <= top - 幅 × 回復位置 / 陰線 (close < open)
//
// 各FVGにつき反発は1回だけ。FVG完全否定（Bullish: close <= bottom / Bearish: close >= top）
// が起きたFVGからは以後反発を出しません。どちらも新しい同方向FVG形成でリセットされます。
// Logic01 と同じく §5 の共通MTF基盤から評価されるため、request.security は追加していません。
grpREB = "④ Logic02 : FVG反発 パラメータ"
rebAtrLen   = input.int(14,     "ATR期間",                group = grpREB, minval = 1)
rebMinThick = input.float(0.0,  "FVG最小厚み (FVG幅/ATR)", group = grpREB, step = 0.05, minval = 0)
rebDepthMax = input.float(0.30, "反発 最大侵入率 (FVG幅比率)", group = grpREB, step = 0.05, minval = 0)
rebRecover  = input.float(0.90, "反発 回復位置 (FVG幅比率)",   group = grpREB, step = 0.05, minval = 0, maxval = 1)

// --- Logic02 FVG Rebound のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_REB = array.from(
     rebMinThick,  // 00 : rebMinThick
     rebDepthMax,  // 01 : rebDepthMax
     rebRecover    // 02 : rebRecover
 )

f_fvgReboundEvent() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pRebMinThick            = array.get(PRM_REB, 0)
    float _pRebDepthMax            = array.get(PRM_REB, 1)
    float _pRebRecover             = array.get(PRM_REB, 2)
    float _atr = ta.atr(rebAtrLen)
    var float _bTop  = na      // Bullish FVG 上端 (= low)
    var float _bBot  = na      // Bullish FVG 下端 (= high[2])
    var int   _bBar  = na
    var bool  _bUsed = true    // 反発済みフラグ（1FVGにつき1回）
    var bool  _bDead = true    // 完全否定フラグ
    var float _rTop  = na      // Bearish FVG 上端 (= low[2])
    var float _rBot  = na      // Bearish FVG 下端 (= high)
    var int   _rBar  = na
    var bool  _rUsed = true
    var bool  _rDead = true

    // FVG形成：最新の1本だけを監視対象とし、反発済み / 完全否定フラグをリセットする
    if _atr > 0 and low > high[2] and (low - high[2]) / _atr >= _pRebMinThick
        _bTop  := low
        _bBot  := high[2]
        _bBar  := bar_index
        _bUsed := false
        _bDead := false
    if _atr > 0 and high < low[2] and (low[2] - high) / _atr >= _pRebMinThick
        _rTop  := low[2]
        _rBot  := high
        _rBar  := bar_index
        _rUsed := false
        _rDead := false

    // FVG完全否定：以後そのFVGから反発を出さない（新しい同方向FVG形成でリセット）
    if not na(_bBot) and close <= _bBot
        _bDead := true
    if not na(_rTop) and close >= _rTop
        _rDead := true

    // 反発イベント（各FVG1回のみ）
    float _bW = _bTop - _bBot
    float _rW = _rTop - _rBot
    bool _long  = not _bUsed and not _bDead and not na(_bW) and _bW > 0 and bar_index > _bBar and low <= _bTop and (_bTop - low) / _bW <= _pRebDepthMax and close >= _bBot + _bW * _pRebRecover and close > open
    bool _short = not _rUsed and not _rDead and not na(_rW) and _rW > 0 and bar_index > _rBar and high >= _rBot and (high - _rBot) / _rW <= _pRebDepthMax and close <= _rTop - _rW * _pRebRecover and close < open

    // 同一足で両方成立した場合も両FVGを反発使用済みにする（方向の裁定は POINT MASTER §6 に任せる）
    if _long
        _bUsed := true
    if _short
        _rUsed := true
    [_long, _short]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic03 = Accum Rebound / Logic04 = Accum Break
// -------------------------------------------------------------------------------------
// Accum判定・箱の上下限は元 Accum ストラテジー（f_accumNTDetect / f_accumEnvBox）と同一。
// 判定パラメータも同じ9項目で、簡略化・変更は一切していません。
//   boxHigh = そのAccum内の max(open, close) / boxLow = min(open, close)（実体基準）
// 箱は「Accum終了が確定した足」で上下限を固定します（形成中の箱は上下限が動くため使わない）。
//
//   Logic03 : 下限タッチ + 陽線確定 → LONG / 上限タッチ + 陰線確定 → SHORT（未ブレイクの箱のみ）
//   Logic04 : 確定終値で上限を上抜け → LONG / 下限を下抜け → SHORT
//             上抜け後に確定終値で箱内へ復帰 → SHORT（上方向ブレイク失敗）
//             下抜け後に確定終値で箱内へ復帰 → LONG（下方向ブレイク失敗）
//
// ブレイク状態は箱ごとに1つだけ保持し、新しい箱を確定した時点でその箱基準に作り直します。
// そのため「別の箱への侵入」で前の箱のブレイクが反転することはありません。
// イベントは状態が変化した確定足だけ。同じ状態が続く間は再発生しません。
// 出力は4つのイベントのみで、保持・期限・方向切替は POINT MASTER 側が行います。
grpACC = "④ Logic03/04 : Accum パラメータ"
accRangeLen    = input.int(10,     "Accum判定レンジ本数",           group = grpACC, minval = 6)
accBaseLen     = input.int(20,     "基準平均本数",                 group = grpACC, minval = 10)
accAtrLen      = input.int(14,     "ATR本数",                      group = grpACC, minval = 1)
accMinUpper    = input.int(4,      "上半分の最低終値本数",           group = grpACC, minval = 1)
accMinLower    = input.int(4,      "下半分の最低終値本数",           group = grpACC, minval = 1)
accMaxRun      = input.int(4,      "同色連続の上限",                group = grpACC, minval = 1)
accAtrMult     = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     group = grpACC, minval = 0.5,  step = 0.1)
accBarRatioMax = input.float(0.70, "Accum 平均値幅/基準平均 上限",   group = grpACC, minval = 0.1,  step = 0.01)
accDriftMax    = input.float(0.30, "Accum ドリフト上限",            group = grpACC, minval = 0.05, maxval = 1.0, step = 0.05)
accTouchTol    = input.float(1.0,  "境界タッチ許容($) ※反発判定用",  group = grpACC, minval = 0.0,  step = 0.1)

// --- Logic03/04 Accum のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_ACC = array.from(
     accMinUpper * 1.0,  // 00 : accMinUpper
     accMinLower * 1.0,  // 01 : accMinLower
     accMaxRun * 1.0,    // 02 : accMaxRun
     accAtrMult,         // 03 : accAtrMult
     accBarRatioMax,     // 04 : accBarRatioMax
     accDriftMax,        // 05 : accDriftMax
     accTouchTol         // 06 : accTouchTol
 )

// Accum成立判定（元コードの f_accumNTDetect と同一。条件・計算方法とも変更なし）
f_accumDetect() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pAccMinUpper            = int(array.get(PRM_ACC, 0))
    int   _pAccMinLower            = int(array.get(PRM_ACC, 1))
    int   _pAccMaxRun              = int(array.get(PRM_ACC, 2))
    float _pAccAtrMult             = array.get(PRM_ACC, 3)
    float _pAccBarRatioMax         = array.get(PRM_ACC, 4)
    float _pAccDriftMax            = array.get(PRM_ACC, 5)
    _atr       = ta.atr(accAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accRangeLen - 1] + close[accRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * _pAccAtrMult
    _rangeShort = ta.highest(_bodyTop, accRangeLen) - ta.lowest(_bodyBot, accRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accBaseLen)  - ta.lowest(_bodyBot, accBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _pAccBarRatioMax
    _condBalance  = _upperCloses >= _pAccMinUpper and _lowerCloses >= _pAccMinLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _pAccDriftMax
    _condColorRun = _maxBullRun <= _pAccMaxRun and _maxBearRun <= _pAccMaxRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accRangeLen)
    [_isAccum, _hi, _lo]

// Accum箱の管理 + Logic03 / Logic04 のイベント生成（1関数で両ロジック分を返す）
f_accumEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pAccTouchTol            = array.get(PRM_ACC, 6)
    [_isA, _hi, _lo] = f_accumDetect()
    var float _fHi   = na    // 形成中の箱（上下限が動く）
    var float _fLo   = na
    var float _bxHi  = na    // 確定した箱（上下限は以後不変）
    var float _bxLo  = na
    var int   _bk    = 0     // ブレイク状態 0=箱内 / 1=上抜け中 / -1=下抜け中（箱ごとに作り直す）
    var bool  _loArm = true  // 同一接触で反発イベントを繰り返さないためのアーム
    var bool  _upArm = true

    // 形成中の箱を実体基準で拡張（元コードと同じ）
    if _isA and not nz(_isA[1], false)
        _fHi := _hi
        _fLo := _lo
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _fHi := math.max(nz(_fHi, _bt), _bt)
        _fLo := math.min(nz(_fLo, _bb), _bb)

    // Accum終了確定 → 箱を確定（上下限を固定）。
    // ブレイク状態はこの新しい箱を基準に初期化するだけで、イベントは出さない。
    if nz(_isA[1], false) and not _isA
        _bxHi  := _fHi
        _bxLo  := _fLo
        _bk    := close > _bxHi ? 1 : close < _bxLo ? -1 : 0
        _loArm := true
        _upArm := true

    bool _rebLong  = false
    bool _rebShort = false
    bool _brkLong  = false
    bool _brkShort = false

    if not na(_bxHi) and not na(_bxLo)
        // --- Logic04 : ブレイク / ブレイク失敗の箱内復帰（確定終値のみ・状態変化時だけ）---
        int _new = close > _bxHi ? 1 : close < _bxLo ? -1 : 0
        if _new != _bk
            if _new == 1
                _brkLong := true          // 上限を確定終値で上抜け
            else if _new == -1
                _brkShort := true         // 下限を確定終値で下抜け
            else if _bk == 1
                _brkShort := true         // 上抜け失敗：同じ箱の中へ確定終値で復帰
            else
                _brkLong := true          // 下抜け失敗：同じ箱の中へ確定終値で復帰
            _bk := _new

        // --- Logic03 : 境界反発（未ブレイクの箱のみ・元コードのタッチ条件）---
        bool _loTouch = low  <= _bxLo + _pAccTouchTol and high >= _bxLo - _pAccTouchTol
        bool _upTouch = high >= _bxHi - _pAccTouchTol and low  <= _bxHi + _pAccTouchTol
        if not _loTouch
            _loArm := true
        if not _upTouch
            _upArm := true
        // タッチだけでは成立させず、反発方向のローソクが確定した足で発火する。
        // 方向ローソクでなかった足ではアームを落とさないので、同じ接触中に次の足で成立できる。
        if _bk == 0 and _loTouch and _loArm and close > open
            _rebLong := true              // 下限タッチ + 陽線確定 → LONG
            _loArm   := false
        if _bk == 0 and _upTouch and _upArm and close < open
            _rebShort := true             // 上限タッチ + 陰線確定 → SHORT
            _upArm    := false
    [_rebLong, _rebShort, _brkLong, _brkShort]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic05〜08 = EMA Rebound / Logic09〜12 = EMA Break
// -------------------------------------------------------------------------------------
// 判定は元 EMA ストラテジー（f_emaEnvEvt）と同一。EMA1本ぶんを1関数で処理し、
// EMA200 / 1000 / 2000 / 3000 に同じ関数を適用します（EMA別に関数は作りません）。
//
//   Rebound LONG  : close[1] >= EMA[1] かつ low  <= EMA + 許容幅 かつ close > EMA
//   Rebound SHORT : close[1] <= EMA[1] かつ high >= EMA - 許容幅 かつ close < EMA
//   Break   LONG  : close[1] <= EMA[1] かつ close > EMA（跨いだ確定足のみ）
//   Break   SHORT : close[1] >= EMA[1] かつ close < EMA（跨いだ確定足のみ）
//
// ブレイク後に終値で逆側へ戻った足は、そのまま逆方向の Break 条件を満たすため
// 逆方向イベントになります（上抜け後に終値がEMA下 → SHORT / 下抜け後に上 → LONG）。
// EMAの上下にいるだけ・ヒゲだけでは発火しません。
//
// 各EMAは独立したロジック（Logic05〜12）なので、OR でまとめず別々に加点されます。
// Rebound と Break も別ロジックなので互いに解除しません。
// 対象は1M・5Mのみ。共通MTF基盤の各TFコンテキストで4本まとめて計算するので、
// EMA用の request.security は1つも追加していません。
grpEMA = "④ Logic05〜12 : EMA パラメータ"
emaLenA     = input.int(200,   "EMA期間 A (Logic05/09)",  group = grpEMA, minval = 1)
emaLenB     = input.int(1000,  "EMA期間 B (Logic06/10)",  group = grpEMA, minval = 1)
emaLenC     = input.int(2000,  "EMA期間 C (Logic07/11)",  group = grpEMA, minval = 1)
emaLenD     = input.int(3000,  "EMA期間 D (Logic08/12)",  group = grpEMA, minval = 1)
useEmaTol   = input.bool(true, "EMA接触許容幅を使う",      group = grpEMA)
emaTolATR   = input.float(0.5, "EMA接触許容幅 ATR倍率",    group = grpEMA, minval = 0.0, step = 0.05)

// --- Logic05〜12 EMA のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_EMA = array.from(
     useEmaTol ? 1.0 : 0.0,  // 00 : useEmaTol
     emaTolATR               // 01 : emaTolATR
 )
emaTolAtrLen= input.int(14,    "接触許容 ATR期間",         group = grpEMA, minval = 1)

// EMA1本ぶんの Rebound / Break イベント（_on = そのTFでEMAロジックを使うか）
f_emaEvents(_on, _emaNow, _emaPrev, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pUseEmaTol              = array.get(PRM_EMA, 0) > 0.5
    float _pEmaTolATR              = array.get(PRM_EMA, 1)
    float _tol = _pUseEmaTol ? _atr * _pEmaTolATR : 0.0
    bool _rebL = _on and close[1] >= _emaPrev and low  <= _emaNow + _tol and close > _emaNow
    bool _rebS = _on and close[1] <= _emaPrev and high >= _emaNow - _tol and close < _emaNow
    bool _brkL = _on and close[1] <= _emaPrev and close > _emaNow
    bool _brkS = _on and close[1] >= _emaPrev and close < _emaNow
    [_rebL, _rebS, _brkL, _brkS]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic13 = Trendline Rebound / Logic14 = Trendline Break
// -------------------------------------------------------------------------------------
// Trendline の生成・選択・Line Quality は元 Trendline/Channel ストラテジー
// （f_tlEnvState）と同一です。簡略化していません。
//   ・確定Pivot（ATR Swing Filter付き）を高値側・安値側それぞれ4点保持
//   ・上昇TL = Pivot Low 側から3本、下降TL = Pivot High 側から3本の候補を生成
//   ・ライン有効期限 / Touch数 / Broken数 / Slope から Line Quality を算出
//   ・Quality最高（同点は価格に近い方）を採用
//   ・Quality は方向別に分離（上昇TLのイベントは上昇TLのQuality、下降TLは下降TLのQuality）
//
//   Logic13 : 上昇TL接近 + bullishReversal + close > 上昇TL値 → LONG
//             下降TL接近 + bearishReversal + close < 下降TL値 → SHORT
//   Logic14 : close[1] <= 下降TL[1] かつ close > 下降TL → LONG（下降TLを終値で上抜け）
//             close[1] >= 上昇TL[1] かつ close < 上昇TL → SHORT（上昇TLを終値で下抜け）
//             ブレイク後、その「同じTrendline」の現在バー延長値を終値で逆側へ跨いだら
//             逆方向イベント（上抜け後に下へ戻る → SHORT / 下抜け後に上へ戻る → LONG）
//
// ブレイクしたラインは x1/y1/x2/y2 と方向を保存して追跡するので、別のTrendlineを
// 跨いだだけでは反転しません。ラインが有効期限切れになれば追跡を終了します。
// イベントは跨いだ確定足だけ。同じ側に滞在している間は再発生しません。
// Channel / Retest / Fake Break は移植していません。
// Rebound と Break は別ロジックなので互いに解除しません。全6TF対象で、
// 共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpTL = "④ Logic13/14 : Trendline パラメータ"
tlPivotLen         = input.int(5,     "Pivot Length",           group = grpTL, minval = 1)
tlUseATRSwing      = input.bool(true, "ATR Swing Filterを使う",  group = grpTL)
tlMinSwingATR      = input.float(0.5, "最低Swing幅 ATR倍率",     group = grpTL, step = 0.1)
tlTouchMode        = input.string("ATR", "接近判定", options = ["Dollar", "ATR"], group = grpTL)
tlTouchDollar      = input.float(3.0, "接近幅($)",              group = grpTL, step = 0.1)
tlTouchATR         = input.float(0.3, "接近幅 ATR倍率",          group = grpTL, step = 0.05)
tlMaxLineAgeBars   = input.int(300,   "ライン有効期限 Bars",     group = grpTL, minval = 20)
tlMinLineTouches   = input.int(2,     "最低Touch数",            group = grpTL, minval = 2)
tlBreakConfirmBars = input.int(2,     "Break Confirm Bars",     group = grpTL, minval = 1)
tlMinSlopeATR      = input.float(0.03, "最低Slope ATR倍率",      group = grpTL, step = 0.01)
tlMaxSlopeATR      = input.float(1.5,  "最大Slope ATR倍率",      group = grpTL, step = 0.1)
useTlQualityFilter = input.bool(true, "Line Quality Filterを使う", group = grpTL)
minTlQuality       = input.int(70,    "最低Line Quality",        group = grpTL, minval = 0, maxval = 100)

// --- Logic13/14 Trendline のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_TL = array.from(
     tlUseATRSwing ? 1.0 : 0.0,            // 00 : tlUseATRSwing
     tlMinSwingATR,                        // 01 : tlMinSwingATR
     tlTouchMode == "Dollar" ? 0.0 : 1.0,  // 02 : tlTouchMode
     tlTouchDollar,                        // 03 : tlTouchDollar
     tlTouchATR,                           // 04 : tlTouchATR
     tlMaxLineAgeBars * 1.0,               // 05 : tlMaxLineAgeBars
     tlMinLineTouches * 1.0,               // 06 : tlMinLineTouches
     tlBreakConfirmBars * 1.0,             // 07 : tlBreakConfirmBars
     tlMinSlopeATR,                        // 08 : tlMinSlopeATR
     tlMaxSlopeATR,                        // 09 : tlMaxSlopeATR
     useTlQualityFilter ? 1.0 : 0.0,       // 10 : useTlQualityFilter
     minTlQuality * 1.0                    // 11 : minTlQuality
 )

// --- 元コードと同一の補助関数 ---
f_tlNear(_price, _level, _rng) =>
    not na(_level) and math.abs(_price - _level) <= _rng

f_tlLineValue(_x1, _y1, _x2, _y2, _xNow) =>
    float _slope = (_y2 - _y1) / math.max(_x2 - _x1, 1)
    _y1 + _slope * (_xNow - _x1)

f_tlQualityScore(_touch, _ageBars, _slopeAbsATR, _broken) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pTlMinSlopeATR          = array.get(PRM_TL, 8)
    float _pTlMaxSlopeATR          = array.get(PRM_TL, 9)
    int _tS = _touch >= 4 ? 40 : _touch == 3 ? 30 : _touch >= 2 ? 20 : 0
    int _aS = (_ageBars >= 20 and _ageBars <= 150) ? 20 : (_ageBars >= 151 and _ageBars <= 300) ? 10 : 0
    int _sS = na(_slopeAbsATR) ? 0 : (_slopeAbsATR < _pTlMinSlopeATR ? 5 : _slopeAbsATR > _pTlMaxSlopeATR ? 5 : 20)
    int _bS = _broken == 0 ? 20 : _broken == 1 ? 10 : 0
    math.min(100, _tS + _aS + _sS + _bS)

f_tlSlopeATR(_p1, _b1, _p2, _b2, _atrv) =>
    _atrv != 0 ? math.abs((_p2 - _p1) / math.max(_b2 - _b1, 1)) / _atrv : na

f_trendlineEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pTlUseATRSwing          = array.get(PRM_TL, 0) > 0.5
    float _pTlMinSwingATR          = array.get(PRM_TL, 1)
    int   _pTlTouchMode            = int(array.get(PRM_TL, 2))
    float _pTlTouchDollar          = array.get(PRM_TL, 3)
    float _pTlTouchATR             = array.get(PRM_TL, 4)
    int   _pTlMaxLineAgeBars       = int(array.get(PRM_TL, 5))
    int   _pTlMinLineTouches       = int(array.get(PRM_TL, 6))
    int   _pTlBreakConfirmBars     = int(array.get(PRM_TL, 7))
    bool  _pUseTlQualityFilter     = array.get(PRM_TL, 10) > 0.5
    int   _pMinTlQuality           = int(array.get(PRM_TL, 11))
    float _atr = ta.atr(14)
    float _touchRange = _pTlTouchMode == 1 ? _atr * _pTlTouchATR : _pTlTouchDollar

    // --- 反転ローソク（元コードと同一）---
    bool _bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool _bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    float _body   = math.abs(close - open)
    float _upWick = high - math.max(open, close)
    float _dnWick = math.min(open, close) - low
    bool _pinLower = _dnWick >= _body and _dnWick >= _upWick
    bool _pinUpper = _upWick >= _body and _upWick >= _dnWick
    bool _bullishReversal = _bullEng or _pinLower or close > open
    bool _bearishReversal = _bearEng or _pinUpper or close < open

    // --- 確定Pivot（ATR Swing Filter）を高値側・安値側それぞれ4点保持 ---
    float _ph = ta.pivothigh(high, tlPivotLen, tlPivotLen)
    float _pl = ta.pivotlow(low, tlPivotLen, tlPivotLen)
    var float _hp1P = na
    var float _hp2P = na
    var float _hp3P = na
    var float _hp4P = na
    var int   _hp1B = na
    var int   _hp2B = na
    var int   _hp3B = na
    var int   _hp4B = na
    var float _lp1P = na
    var float _lp2P = na
    var float _lp3P = na
    var float _lp4P = na
    var int   _lp1B = na
    var int   _lp2B = na
    var int   _lp3B = na
    var int   _lp4B = na
    bool _newHighPivot = false
    bool _newLowPivot  = false
    if not na(_ph)
        if na(_hp1P) or not _pTlUseATRSwing or math.abs(_ph - _hp1P) >= _atr * _pTlMinSwingATR
            _hp4P := _hp3P
            _hp4B := _hp3B
            _hp3P := _hp2P
            _hp3B := _hp2B
            _hp2P := _hp1P
            _hp2B := _hp1B
            _hp1P := _ph
            _hp1B := bar_index - tlPivotLen
            _newHighPivot := true
    if not na(_pl)
        if na(_lp1P) or not _pTlUseATRSwing or math.abs(_pl - _lp1P) >= _atr * _pTlMinSwingATR
            _lp4P := _lp3P
            _lp4B := _lp3B
            _lp3P := _lp2P
            _lp3B := _lp2B
            _lp2P := _lp1P
            _lp2B := _lp1B
            _lp1P := _pl
            _lp1B := bar_index - tlPivotLen
            _newLowPivot := true

    // --- Touch / Broken カウンタ（新Pivotでリセット）---
    var int _upTouchA = 0
    var int _upTouchB = 0
    var int _upTouchC = 0
    var int _upBrokA  = 0
    var int _upBrokB  = 0
    var int _upBrokC  = 0
    var int _upBelowA = 0
    var int _upBelowB = 0
    var int _upBelowC = 0
    var int _dnTouchA = 0
    var int _dnTouchB = 0
    var int _dnTouchC = 0
    var int _dnBrokA  = 0
    var int _dnBrokB  = 0
    var int _dnBrokC  = 0
    var int _dnAboveA = 0
    var int _dnAboveB = 0
    var int _dnAboveC = 0
    if _newLowPivot
        _upTouchA := 0
        _upTouchB := 0
        _upTouchC := 0
        _upBrokA := 0
        _upBrokB := 0
        _upBrokC := 0
        _upBelowA := 0
        _upBelowB := 0
        _upBelowC := 0
    if _newHighPivot
        _dnTouchA := 0
        _dnTouchB := 0
        _dnTouchC := 0
        _dnBrokA := 0
        _dnBrokB := 0
        _dnBrokC := 0
        _dnAboveA := 0
        _dnAboveB := 0
        _dnAboveC := 0

    // --- 上昇Trendline候補（Pivot Low 側）---
    bool _upValidA = not na(_lp1P) and not na(_lp2P) and _lp1B != _lp2B and (bar_index - _lp2B) <= _pTlMaxLineAgeBars
    bool _upValidB = not na(_lp1P) and not na(_lp3P) and _lp1B != _lp3B and (bar_index - _lp3B) <= _pTlMaxLineAgeBars
    bool _upValidC = not na(_lp1P) and not na(_lp4P) and _lp1B != _lp4B and (bar_index - _lp4B) <= _pTlMaxLineAgeBars
    float _upValA = _upValidA ? f_tlLineValue(_lp2B, _lp2P, _lp1B, _lp1P, bar_index) : na
    float _upValB = _upValidB ? f_tlLineValue(_lp3B, _lp3P, _lp1B, _lp1P, bar_index) : na
    float _upValC = _upValidC ? f_tlLineValue(_lp4B, _lp4P, _lp1B, _lp1P, bar_index) : na
    if not na(_upValA)
        if f_tlNear(low, _upValA, _touchRange) and _bullishReversal and close > _upValA
            _upTouchA := _upTouchA + 1
        _upBelowA := close < _upValA ? _upBelowA + 1 : 0
        if _upBelowA == _pTlBreakConfirmBars
            _upBrokA := _upBrokA + 1
    if not na(_upValB)
        if f_tlNear(low, _upValB, _touchRange) and _bullishReversal and close > _upValB
            _upTouchB := _upTouchB + 1
        _upBelowB := close < _upValB ? _upBelowB + 1 : 0
        if _upBelowB == _pTlBreakConfirmBars
            _upBrokB := _upBrokB + 1
    if not na(_upValC)
        if f_tlNear(low, _upValC, _touchRange) and _bullishReversal and close > _upValC
            _upTouchC := _upTouchC + 1
        _upBelowC := close < _upValC ? _upBelowC + 1 : 0
        if _upBelowC == _pTlBreakConfirmBars
            _upBrokC := _upBrokC + 1

    // --- 下降Trendline候補（Pivot High 側）---
    bool _dnValidA = not na(_hp1P) and not na(_hp2P) and _hp1B != _hp2B and (bar_index - _hp2B) <= _pTlMaxLineAgeBars
    bool _dnValidB = not na(_hp1P) and not na(_hp3P) and _hp1B != _hp3B and (bar_index - _hp3B) <= _pTlMaxLineAgeBars
    bool _dnValidC = not na(_hp1P) and not na(_hp4P) and _hp1B != _hp4B and (bar_index - _hp4B) <= _pTlMaxLineAgeBars
    float _dnValA = _dnValidA ? f_tlLineValue(_hp2B, _hp2P, _hp1B, _hp1P, bar_index) : na
    float _dnValB = _dnValidB ? f_tlLineValue(_hp3B, _hp3P, _hp1B, _hp1P, bar_index) : na
    float _dnValC = _dnValidC ? f_tlLineValue(_hp4B, _hp4P, _hp1B, _hp1P, bar_index) : na
    if not na(_dnValA)
        if f_tlNear(high, _dnValA, _touchRange) and _bearishReversal and close < _dnValA
            _dnTouchA := _dnTouchA + 1
        _dnAboveA := close > _dnValA ? _dnAboveA + 1 : 0
        if _dnAboveA == _pTlBreakConfirmBars
            _dnBrokA := _dnBrokA + 1
    if not na(_dnValB)
        if f_tlNear(high, _dnValB, _touchRange) and _bearishReversal and close < _dnValB
            _dnTouchB := _dnTouchB + 1
        _dnAboveB := close > _dnValB ? _dnAboveB + 1 : 0
        if _dnAboveB == _pTlBreakConfirmBars
            _dnBrokB := _dnBrokB + 1
    if not na(_dnValC)
        if f_tlNear(high, _dnValC, _touchRange) and _bearishReversal and close < _dnValC
            _dnTouchC := _dnTouchC + 1
        _dnAboveC := close > _dnValC ? _dnAboveC + 1 : 0
        if _dnAboveC == _pTlBreakConfirmBars
            _dnBrokC := _dnBrokC + 1

    // --- 各ライン Quality ---
    int _upQA = _upValidA ? f_tlQualityScore(_upTouchA, bar_index - _lp2B, f_tlSlopeATR(_lp2P, _lp2B, _lp1P, _lp1B, _atr), _upBrokA) : -1
    int _upQB = _upValidB ? f_tlQualityScore(_upTouchB, bar_index - _lp3B, f_tlSlopeATR(_lp3P, _lp3B, _lp1P, _lp1B, _atr), _upBrokB) : -1
    int _upQC = _upValidC ? f_tlQualityScore(_upTouchC, bar_index - _lp4B, f_tlSlopeATR(_lp4P, _lp4B, _lp1P, _lp1B, _atr), _upBrokC) : -1
    int _dnQA = _dnValidA ? f_tlQualityScore(_dnTouchA, bar_index - _hp2B, f_tlSlopeATR(_hp2P, _hp2B, _hp1P, _hp1B, _atr), _dnBrokA) : -1
    int _dnQB = _dnValidB ? f_tlQualityScore(_dnTouchB, bar_index - _hp3B, f_tlSlopeATR(_hp3P, _hp3B, _hp1P, _hp1B, _atr), _dnBrokB) : -1
    int _dnQC = _dnValidC ? f_tlQualityScore(_dnTouchC, bar_index - _hp4B, f_tlSlopeATR(_hp4P, _hp4B, _hp1P, _hp1B, _atr), _dnBrokC) : -1

    // --- 上昇TL採用（Quality最高・同点は価格に近い方）---
    int   _selUpIdx = na
    float _upVal    = na
    int   _upQual   = 0
    int   _upTouch  = 0
    float _upAncP   = na
    int   _upAncB   = na
    if _upValidA
        _selUpIdx := 0
        _upVal := _upValA
        _upQual := _upQA
        _upTouch := _upTouchA
        _upAncP := _lp2P
        _upAncB := _lp2B
    if _upValidB and (na(_selUpIdx) or _upQB > _upQual or (_upQB == _upQual and math.abs(close - _upValB) < math.abs(close - _upVal)))
        _selUpIdx := 1
        _upVal := _upValB
        _upQual := _upQB
        _upTouch := _upTouchB
        _upAncP := _lp3P
        _upAncB := _lp3B
    if _upValidC and (na(_selUpIdx) or _upQC > _upQual or (_upQC == _upQual and math.abs(close - _upValC) < math.abs(close - _upVal)))
        _selUpIdx := 2
        _upVal := _upValC
        _upQual := _upQC
        _upTouch := _upTouchC
        _upAncP := _lp4P
        _upAncB := _lp4B
    bool _upValid = not na(_upVal)

    // --- 下降TL採用 ---
    int   _selDnIdx = na
    float _dnVal    = na
    int   _dnQual   = 0
    int   _dnTouch  = 0
    float _dnAncP   = na
    int   _dnAncB   = na
    if _dnValidA
        _selDnIdx := 0
        _dnVal := _dnValA
        _dnQual := _dnQA
        _dnTouch := _dnTouchA
        _dnAncP := _hp2P
        _dnAncB := _hp2B
    if _dnValidB and (na(_selDnIdx) or _dnQB > _dnQual or (_dnQB == _dnQual and math.abs(close - _dnValB) < math.abs(close - _dnVal)))
        _selDnIdx := 1
        _dnVal := _dnValB
        _dnQual := _dnQB
        _dnTouch := _dnTouchB
        _dnAncP := _hp3P
        _dnAncB := _hp3B
    if _dnValidC and (na(_selDnIdx) or _dnQC > _dnQual or (_dnQC == _dnQual and math.abs(close - _dnValC) < math.abs(close - _dnVal)))
        _selDnIdx := 2
        _dnVal := _dnValC
        _dnQual := _dnQC
        _dnTouch := _dnTouchC
        _dnAncP := _hp4P
        _dnAncB := _hp4B
    bool _dnValid = not na(_dnVal)

    // --- Quality Filter（方向別に分離。反対側のQualityでは許可しない）---
    bool _upStrong = _upValid and _upQual >= _pMinTlQuality and _upTouch >= _pTlMinLineTouches
    bool _dnStrong = _dnValid and _dnQual >= _pMinTlQuality and _dnTouch >= _pTlMinLineTouches
    bool _upQualOk = not _pUseTlQualityFilter or _upStrong
    bool _dnQualOk = not _pUseTlQualityFilter or _dnStrong

    // ================= Logic13 : Trendline Rebound =================
    bool _nearUp = f_tlNear(low,  _upVal, _touchRange)
    bool _nearDn = f_tlNear(high, _dnVal, _touchRange)
    bool _rebLong  = _upQualOk and _nearUp and _bullishReversal and close > _upVal
    bool _rebShort = _dnQualOk and _nearDn and _bearishReversal and close < _dnVal

    // ================= Logic14 : Trendline Break =================
    // 元コードの rawTlBuyBreak / rawTlSellBreak と同一（確定終値で跨いだ瞬間のみ）
    bool _rawBuyBreak  = not na(_dnVal) and not na(_dnVal[1]) and close > _dnVal and close[1] <= _dnVal[1]
    bool _rawSellBreak = not na(_upVal) and not na(_upVal[1]) and close < _upVal and close[1] >= _upVal[1]
    bool _brkLong  = _dnQualOk and _rawBuyBreak
    bool _brkShort = _upQualOk and _rawSellBreak

    // --- ブレイクしたラインを x1/y1/x2/y2 で保存して追跡（同じラインへの戻り判定用）---
    //     _trkSide : 1 = 現在そのラインより上 / -1 = 下 / 0 = 追跡なし
    var int   _trkX1 = na
    var float _trkY1 = na
    var int   _trkX2 = na
    var float _trkY2 = na
    var int   _trkOldB = na   // 古い方のPivotバー（有効期限判定用）
    var int   _trkSide = 0

    if _brkLong
        // 下降TLを上抜け → その下降TLを追跡（価格はライン上側）
        _trkX1 := _dnAncB
        _trkY1 := _dnAncP
        _trkX2 := _hp1B
        _trkY2 := _hp1P
        _trkOldB := _dnAncB
        _trkSide := 1
    else if _brkShort
        // 上昇TLを下抜け → その上昇TLを追跡（価格はライン下側）
        _trkX1 := _upAncB
        _trkY1 := _upAncP
        _trkX2 := _lp1B
        _trkY2 := _lp1P
        _trkOldB := _upAncB
        _trkSide := -1
    else if _trkSide != 0
        // 追跡中：ラインが有効期限切れ / データ欠損なら追跡終了
        if na(_trkX1) or na(_trkX2) or na(_trkOldB) or (bar_index - _trkOldB) > _pTlMaxLineAgeBars
            _trkSide := 0
        else
            // 同じラインの現在バー延長値を終値で逆側へ跨いだら逆方向イベント（1回だけ）
            float _trkNow = f_tlLineValue(_trkX1, _trkY1, _trkX2, _trkY2, bar_index)
            if _trkSide == 1 and close < _trkNow
                _brkShort := true         // 上抜け失敗：同じ下降TLの下へ終値で復帰
                _trkSide  := -1
            else if _trkSide == -1 and close > _trkNow
                _brkLong := true          // 下抜け失敗：同じ上昇TLの上へ終値で復帰
                _trkSide := 1
    [_rebLong, _rebShort, _brkLong, _brkShort]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic15 = H&S Pattern（三尊 / 逆三尊）
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + 三尊 環境認識ストラテジー」（f_hsEnvPush / f_hsFindHS）と同一です。
// 簡略化していません。
//   ・確定Pivotを配列保持（同方向連続は極値のみ / 前Pivotから ATR×ノイズ倍率 未満は除外 / 上限で最古を破棄）
//   ・H-L-H-L-H（三尊）/ L-H-L-H-L（逆三尊）の全候補を探索
//   ・頭の位置 / 頭の突出 / 頭と各肩の最低距離 / 左右肩の価格差 / 肩の時間比 /
//     ネックライン高低差 / ネックライン傾斜 / パターン横幅 をすべて必須条件として判定
//   ・スコアリングして最良候補（直近Head優先 → 同一Head内でスコア最高）を採用
//
//   形が完成しただけではイベントを出しません。ネックライン（2つのネックPivotを結ぶ斜め線）を
//   現在バーへ延長し、ATRバッファ込みで確定終値が抜けた足だけがイベントになります。
//     逆三尊 : close > ネックライン + ATR×バッファ → LONG
//     三尊   : close < ネックライン - ATR×バッファ → SHORT
//   右肩完成からブレイク期限内であること、実体率フィルター、方向ローソクも元コードどおり。
//
// 同じパターンからは1回だけ（Consumed管理）。新Pivotで再探索しますが、確定済みパターンは
// 再採用しません。ブレイク前に頭を更新する極値が出た候補はそのHeadごと恒久無効化します。
// 出力はイベント2値のみで、保持・期限・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpHS = "④ Logic15 : 三尊 / 逆三尊 パラメータ"
hsPivotLen        = input.int(4,     "Pivot Length",                    group = grpHS, minval = 1)
hsMaxPivots       = input.int(16,    "保持Pivot数 (探索対象)",           group = grpHS, minval = 5, maxval = 24)
hsNoiseATR        = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率",   group = grpHS, step = 0.05)
hsHeadPromMult    = input.float(1.0, "頭と肩の最低差 ATR倍率",           group = grpHS, step = 0.1)
hsMinHeadShATR    = input.float(1.0, "頭と各肩の最低距離 ATR倍率",       group = grpHS, step = 0.1)
hsShoulderATR     = input.float(1.0, "左右肩の価格差 ATR上限",           group = grpHS, step = 0.1)
hsTimeRatioMin    = input.float(0.5, "肩の時間比 下限",                 group = grpHS, step = 0.05)
hsTimeRatioMax    = input.float(2.0, "肩の時間比 上限",                 group = grpHS, step = 0.1)
hsNeckDiffATR     = input.float(1.0, "ネックライン高低差 ATR上限",       group = grpHS, step = 0.1)
hsMaxNeckSlopeATR = input.float(0.07, "ネックライン最大傾斜 ATR/Bar",    group = grpHS, step = 0.01)
hsMinPatternBars  = input.int(20,    "パターン最小横幅",                group = grpHS, minval = 1)
hsMaxPatternBars  = input.int(80,    "パターン最大横幅",                group = grpHS, minval = 2)
hsBreakBufferATR  = input.float(0.1, "ネックラインブレイクのATRバッファ", group = grpHS, step = 0.05)
hsBreakMaxBars    = input.int(20,    "右肩完成後のブレイク期限",         group = grpHS, minval = 1)
useHsBodyFilter   = input.bool(true, "ブレイク実体率フィルターを使う",    group = grpHS)
hsMinBodyRatio    = input.float(0.45, "最低ブレイク実体率",              group = grpHS, minval = 0.0, maxval = 1.0, step = 0.05)

// --- Logic15 H&S のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_HS = array.from(
     hsMaxPivots * 1.0,            // 00 : hsMaxPivots
     hsNoiseATR,                   // 01 : hsNoiseATR
     hsHeadPromMult,               // 02 : hsHeadPromMult
     hsMinHeadShATR,               // 03 : hsMinHeadShATR
     hsShoulderATR,                // 04 : hsShoulderATR
     hsTimeRatioMin,               // 05 : hsTimeRatioMin
     hsTimeRatioMax,               // 06 : hsTimeRatioMax
     hsNeckDiffATR,                // 07 : hsNeckDiffATR
     hsMaxNeckSlopeATR,            // 08 : hsMaxNeckSlopeATR
     hsMinPatternBars * 1.0,       // 09 : hsMinPatternBars
     hsMaxPatternBars * 1.0,       // 10 : hsMaxPatternBars
     hsBreakBufferATR,             // 11 : hsBreakBufferATR
     hsBreakMaxBars * 1.0,         // 12 : hsBreakMaxBars
     useHsBodyFilter ? 1.0 : 0.0,  // 13 : useHsBodyFilter
     hsMinBodyRatio                // 14 : hsMinBodyRatio
 )

// Pivot を配列へ追加（元コード f_hsEnvPush と同一。ラベル用の時刻配列だけ省略）
f_hsPush(_pr, _bar, _hi, _price, _b, _isHigh, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pHsMaxPivots            = int(array.get(PRM_HS, 0))
    float _pHsNoiseATR             = array.get(PRM_HS, 1)
    int _n = array.size(_pr)
    if _n == 0
        array.push(_pr, _price)
        array.push(_bar, _b)
        array.push(_hi, _isHigh)
    else
        bool _lastHigh = array.get(_hi, _n - 1)
        if _isHigh == _lastHigh
            float _lastP = array.get(_pr, _n - 1)
            if (_isHigh and _price > _lastP) or (not _isHigh and _price < _lastP)
                array.set(_pr, _n - 1, _price)
                array.set(_bar, _n - 1, _b)
        else
            float _lastP = array.get(_pr, _n - 1)
            if math.abs(_price - _lastP) >= _atr * _pHsNoiseATR
                array.push(_pr, _price)
                array.push(_bar, _b)
                array.push(_hi, _isHigh)
    while array.size(_pr) > _pHsMaxPivots
        array.shift(_pr)
        array.shift(_bar)
        array.shift(_hi)

// 最良候補の探索（元コード f_hsFindHS と同一。_inv=true で逆三尊）
// 戻り値 [lsIdx, hdIdx, rsIdx, n1Idx, n2Idx]（未検出は全て -1）
f_hsFind(_pr, _bar, _hi, _atr, _inv) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pHsHeadPromMult         = array.get(PRM_HS, 2)
    float _pHsMinHeadShATR         = array.get(PRM_HS, 3)
    float _pHsShoulderATR          = array.get(PRM_HS, 4)
    float _pHsTimeRatioMin         = array.get(PRM_HS, 5)
    float _pHsTimeRatioMax         = array.get(PRM_HS, 6)
    float _pHsNeckDiffATR          = array.get(PRM_HS, 7)
    float _pHsMaxNeckSlopeATR      = array.get(PRM_HS, 8)
    int   _pHsMinPatternBars       = int(array.get(PRM_HS, 9))
    int   _pHsMaxPatternBars       = int(array.get(PRM_HS, 10))
    int _n = array.size(_pr)
    float _best = -1e18
    int _bestHeadBar = -1
    int _rLs = -1
    int _rHd = -1
    int _rRs = -1
    int _rN1 = -1
    int _rN2 = -1
    if _n >= 5 and _atr > 0
        for _h = 2 to _n - 3
            if array.get(_hi, _h) != _inv
                float _hdP = array.get(_pr, _h)
                int   _hdB = array.get(_bar, _h)
                for _i = 0 to _h - 2
                    if array.get(_hi, _i) != _inv
                        for _j = _h + 2 to _n - 1
                            if array.get(_hi, _j) != _inv
                                float _lsP = array.get(_pr, _i)
                                float _rsP = array.get(_pr, _j)
                                int   _lsB = array.get(_bar, _i)
                                int   _rsB = array.get(_bar, _j)
                                int   _n1 = -1
                                float _n1P = na
                                if _i + 1 <= _h - 1
                                    for _a = _i + 1 to _h - 1
                                        if array.get(_hi, _a) == _inv
                                            float _v = array.get(_pr, _a)
                                            if _n1 == -1 or (_inv ? _v > _n1P : _v < _n1P)
                                                _n1 := _a
                                                _n1P := _v
                                int   _n2 = -1
                                float _n2P = na
                                if _h + 1 <= _j - 1
                                    for _a = _h + 1 to _j - 1
                                        if array.get(_hi, _a) == _inv
                                            float _v = array.get(_pr, _a)
                                            if _n2 == -1 or (_inv ? _v > _n2P : _v < _n2P)
                                                _n2 := _a
                                                _n2P := _v
                                if _n1 != -1 and _n2 != -1
                                    float _avgSh = (_lsP + _rsP) / 2.0
                                    float _prom  = _inv ? (_avgSh - _hdP) : (_hdP - _avgSh)
                                    bool  _headPosOk = _inv ? (_hdP < _lsP and _hdP < _rsP) : (_hdP > _lsP and _hdP > _rsP)
                                    bool  _promOk = _prom >= _atr * _pHsHeadPromMult
                                    float _hlDist = _inv ? (_lsP - _hdP) : (_hdP - _lsP)
                                    float _hrDist = _inv ? (_rsP - _hdP) : (_hdP - _rsP)
                                    bool  _headDistOk = _hlDist >= _atr * _pHsMinHeadShATR and _hrDist >= _atr * _pHsMinHeadShATR
                                    bool  _symOk  = math.abs(_lsP - _rsP) <= _atr * _pHsShoulderATR
                                    float _t1 = _hdB - _lsB
                                    float _t2 = _rsB - _hdB
                                    bool  _timeOk = _t1 > 0 and _t2 > 0 and (_t1 / _t2) >= _pHsTimeRatioMin and (_t1 / _t2) <= _pHsTimeRatioMax
                                    bool  _neckOk = math.abs(_n1P - _n2P) <= _atr * _pHsNeckDiffATR
                                    int   _n1B = array.get(_bar, _n1)
                                    int   _n2B = array.get(_bar, _n2)
                                    float _neckSlope = math.abs(_n2P - _n1P) / math.max(math.abs(_n2B - _n1B), 1) / _atr
                                    bool  _neckSlopeOk = _neckSlope <= _pHsMaxNeckSlopeATR
                                    int   _patBars = _rsB - _lsB
                                    bool  _widthOk = _patBars >= _pHsMinPatternBars and _patBars <= _pHsMaxPatternBars
                                    if _headPosOk and _promOk and _headDistOk and _symOk and _timeOk and _neckOk and _neckSlopeOk and _widthOk
                                        float _midW = (_pHsMinPatternBars + _pHsMaxPatternBars) / 2.0
                                        float _rngW = math.max(_pHsMaxPatternBars - _pHsMinPatternBars, 1)
                                        float _sc = _prom / _atr - math.abs(_lsP - _rsP) / _atr - math.abs(_t1 - _t2) / math.max(_t1 + _t2, 1.0) * 2.0 - math.abs(_n1P - _n2P) / _atr - math.abs(_patBars - _midW) / _rngW
                                        if _hdB > _bestHeadBar or (_hdB == _bestHeadBar and _sc > _best)
                                            _best := _sc
                                            _bestHeadBar := _hdB
                                            _rLs := _i
                                            _rHd := _h
                                            _rRs := _j
                                            _rN1 := _n1
                                            _rN2 := _n2
    [_rLs, _rHd, _rRs, _rN1, _rN2]

f_hsEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pHsBreakBufferATR       = array.get(PRM_HS, 11)
    int   _pHsBreakMaxBars         = int(array.get(PRM_HS, 12))
    bool  _pUseHsBodyFilter        = array.get(PRM_HS, 13) > 0.5
    float _pHsMinBodyRatio         = array.get(PRM_HS, 14)
    float _atr = ta.atr(14)
    float _ph = ta.pivothigh(hsPivotLen, hsPivotLen)
    float _pl = ta.pivotlow(hsPivotLen, hsPivotLen)
    var array<float> _pPr   = array.new_float()
    var array<int>   _pBar  = array.new_int()
    var array<bool>  _pHigh = array.new_bool()
    // 採用中の 逆三尊(up) / 三尊(dn) パターン（ネックライン計算と期限判定に必要な値だけ保持）
    var bool  _upReady = false
    var bool  _upConsumed = false
    var int   _upHdBar = na
    var float _upHdP = na
    var int   _upRsBar = na
    var float _upN1P = na
    var int   _upN1B = na
    var float _upN2P = na
    var int   _upN2B = na
    var int   _upDeadHdBar = na
    var bool  _dnReady = false
    var bool  _dnConsumed = false
    var int   _dnHdBar = na
    var float _dnHdP = na
    var int   _dnRsBar = na
    var float _dnN1P = na
    var int   _dnN1B = na
    var float _dnN2P = na
    var int   _dnN2B = na
    var int   _dnDeadHdBar = na

    bool _newPivot = not na(_ph) or not na(_pl)
    if not na(_ph)
        f_hsPush(_pPr, _pBar, _pHigh, _ph, bar_index - hsPivotLen, true, _atr)
    if not na(_pl)
        f_hsPush(_pPr, _pBar, _pHigh, _pl, bar_index - hsPivotLen, false, _atr)

    // 新Pivotのたびに両方向を再探索（確定済みHeadは Consumed / Dead で再発火しない）
    if _newPivot
        int  _sz   = array.size(_pPr)
        bool _szOk = array.size(_pBar) == _sz and array.size(_pHigh) == _sz
        [_uLs, _uHd, _uRs, _uN1, _uN2] = f_hsFind(_pPr, _pBar, _pHigh, _atr, true)
        _upReady := false
        bool _upIdxOk = _szOk and _uLs >= 0 and _uLs < _sz and _uHd >= 0 and _uHd < _sz and _uRs >= 0 and _uRs < _sz and _uN1 >= 0 and _uN1 < _sz and _uN2 >= 0 and _uN2 < _sz
        if _upIdxOk
            int _hb = array.get(_pBar, _uHd)
            if _hb != _upHdBar
                _upConsumed := false
            _upHdBar := _hb
            _upHdP  := array.get(_pPr, _uHd)
            _upRsBar := array.get(_pBar, _uRs)
            _upN1P := array.get(_pPr, _uN1)
            _upN1B := array.get(_pBar, _uN1)
            _upN2P := array.get(_pPr, _uN2)
            _upN2B := array.get(_pBar, _uN2)
            if not na(_upDeadHdBar) and _hb == _upDeadHdBar
                _upReady := false
            else
                _upReady := true
                _upDeadHdBar := na
        [_dLs, _dHd, _dRs, _dN1, _dN2] = f_hsFind(_pPr, _pBar, _pHigh, _atr, false)
        _dnReady := false
        bool _dnIdxOk = _szOk and _dLs >= 0 and _dLs < _sz and _dHd >= 0 and _dHd < _sz and _dRs >= 0 and _dRs < _sz and _dN1 >= 0 and _dN1 < _sz and _dN2 >= 0 and _dN2 < _sz
        if _dnIdxOk
            int _hbd = array.get(_pBar, _dHd)
            if _hbd != _dnHdBar
                _dnConsumed := false
            _dnHdBar := _hbd
            _dnHdP  := array.get(_pPr, _dHd)
            _dnRsBar := array.get(_pBar, _dRs)
            _dnN1P := array.get(_pPr, _dN1)
            _dnN1B := array.get(_pBar, _dN1)
            _dnN2P := array.get(_pPr, _dN2)
            _dnN2B := array.get(_pBar, _dN2)
            if not na(_dnDeadHdBar) and _hbd == _dnDeadHdBar
                _dnReady := false
            else
                _dnReady := true
                _dnDeadHdBar := na

    // 構造否定（ブレイク前に頭を更新する極値が出たら、そのHeadを恒久無効化）
    if not na(_pl) and not _upConsumed and not na(_upHdP) and _pl < _upHdP
        _upReady := false
        _upDeadHdBar := _upHdBar
    if not na(_ph) and not _dnConsumed and not na(_dnHdP) and _ph > _dnHdP
        _dnReady := false
        _dnDeadHdBar := _dnHdBar

    // ネックラインを斜め線として現在バーへ延長し、ATRバッファ込みの確定終値ブレイクで確定
    float _bodyRatio = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool  _bodyOk = not _pUseHsBodyFilter or _bodyRatio >= _pHsMinBodyRatio
    float _neckUp = (_upReady and not na(_upN1B) and not na(_upN2B) and _upN2B != _upN1B) ? _upN1P + (_upN2P - _upN1P) / (_upN2B - _upN1B) * (bar_index - _upN1B) : na
    float _neckDn = (_dnReady and not na(_dnN1B) and not na(_dnN2B) and _dnN2B != _dnN1B) ? _dnN1P + (_dnN2P - _dnN1P) / (_dnN2B - _dnN1B) * (bar_index - _dnN1B) : na
    bool _timeUpOk = not na(_upRsBar) and (bar_index - _upRsBar) <= _pHsBreakMaxBars
    bool _timeDnOk = not na(_dnRsBar) and (bar_index - _dnRsBar) <= _pHsBreakMaxBars
    bool _buyConfirm  = _upReady and not _upConsumed and _timeUpOk and not na(_neckUp) and close > _neckUp + _atr * _pHsBreakBufferATR and close > open and _bodyOk
    bool _sellConfirm = _dnReady and not _dnConsumed and _timeDnOk and not na(_neckDn) and close < _neckDn - _atr * _pHsBreakBufferATR and close < open and _bodyOk

    bool _hsLong  = false
    bool _hsShort = false
    if _buyConfirm and not _sellConfirm
        _hsLong := true            // 逆三尊ネックライン上抜け → LONG
        _upConsumed := true        // 同じパターンからは1回だけ
    else if _sellConfirm and not _buyConfirm
        _hsShort := true           // 三尊ネックライン下抜け → SHORT
        _dnConsumed := true
    [_hsLong, _hsShort]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic16 = Double Top / Double Bottom
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + DT/DB 環境認識ストラテジー」（f_dtdbEnvPush / f_dtdbEnvTolOk /
// f_dtdbEnvScore と候補探索）と同一です。簡略化していません。Triple は実装しません。
//   ・確定Pivotを時系列1配列で保持（同方向連続はより極端な価格へ置換 / ATRノイズ除外 / 上限で最古を破棄）
//   ・Double Top = High → Low → High / Double Bottom = Low → High → Low
//   ・2頂点(2底値)の許容判定（Percent / ATR / PercentOrATR / PercentAndATR）
//   ・ネック最低深さ / パターン横幅（最小・最大）を必須条件として判定
//   ・候補スコア（左右差が小 / ネックが深い / 横幅が適正 / 左右の時間バランスが良い）で最良候補を採用
//
//   2頂点(2底値)が揃っただけではイベントを出しません。確定終値がネックラインを
//   ATRバッファ込みで抜けた足だけがイベントになります。
//     Double Bottom : close > neck + ATR×バッファ → LONG
//     Double Top    : close < neck - ATR×バッファ → SHORT
//   2回目の頂点/底値の形成からブレイク期限内であること、実体率フィルター、
//   ブレイク足の色要求も元コードどおりです。
//
// 各パターンのブレイクは1回だけ（Broken管理）。新しい右側Pivotで新候補を採用したときに
// 再びイベント可能になります。同一足でDTとDBが両方確定した場合は両方のイベントを返し、
// 方向の裁定は POINT MASTER §6 の同時発生設定に任せます。
// 出力はイベント2値のみで、保持・期限・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpDTDB = "④ Logic16 : Double Top / Bottom パラメータ"
dtdbPivotLen       = input.int(3,     "Pivot Length",                   group = grpDTDB, minval = 1)
dtdbMaxPivots      = input.int(30,    "保持Pivot数 (探索対象)",          group = grpDTDB, minval = 5, maxval = 50)
dtdbNoiseATR       = input.float(0.3, "ノイズ除外 前Pivot値幅 ATR倍率",  group = grpDTDB, step = 0.05)
dtdbTolMode        = input.string("ATR", "頂点/底値の許容判定", options = ["Percent", "ATR", "PercentOrATR", "PercentAndATR"], group = grpDTDB)
dtdbTolPct         = input.float(0.01, "許容率 (Percent)",              group = grpDTDB, minval = 0.0, step = 0.001)
dtdbTolATR         = input.float(0.6,  "許容差 (ATR倍率)",              group = grpDTDB, minval = 0.0, step = 0.05)
dtdbMinNeckDepthATR = input.float(0.6, "ネック最小深さ ATR倍率",         group = grpDTDB, minval = 0.0, step = 0.1)
dtdbMinPatternBars = input.int(6,     "パターン最小横幅",                group = grpDTDB, minval = 1)
dtdbMaxPatternBars = input.int(80,    "パターン最大横幅",                group = grpDTDB, minval = 2)
dtdbBreakBufferATR = input.float(0.0, "ネックラインブレイクのATRバッファ", group = grpDTDB, minval = 0.0, step = 0.05)
dtdbBreakMaxBars   = input.int(30,    "2回目頂点/底値後のブレイク期限",   group = grpDTDB, minval = 1)
useDtdbBodyFilter  = input.bool(false, "ブレイク実体率フィルターを使う",   group = grpDTDB)
dtdbMinBodyRatio   = input.float(0.45, "最低ブレイク実体率",             group = grpDTDB, minval = 0.0, maxval = 1.0, step = 0.05)
useDtdbBreakColor  = input.bool(false, "ブレイク足の色を要求 (DT=陰線/DB=陽線)", group = grpDTDB)

// --- Logic16 DT/DB のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_DTDB = array.from(
     dtdbMaxPivots * 1.0,                                                                                      // 00 : dtdbMaxPivots
     dtdbNoiseATR,                                                                                             // 01 : dtdbNoiseATR
     dtdbTolMode == "Percent" ? 0.0 : dtdbTolMode == "ATR" ? 1.0 : dtdbTolMode == "PercentOrATR" ? 2.0 : 3.0,  // 02 : dtdbTolMode
     dtdbTolPct,                                                                                               // 03 : dtdbTolPct
     dtdbTolATR,                                                                                               // 04 : dtdbTolATR
     dtdbMinNeckDepthATR,                                                                                      // 05 : dtdbMinNeckDepthATR
     dtdbMinPatternBars * 1.0,                                                                                 // 06 : dtdbMinPatternBars
     dtdbMaxPatternBars * 1.0,                                                                                 // 07 : dtdbMaxPatternBars
     dtdbBreakBufferATR,                                                                                       // 08 : dtdbBreakBufferATR
     dtdbBreakMaxBars * 1.0,                                                                                   // 09 : dtdbBreakMaxBars
     useDtdbBodyFilter ? 1.0 : 0.0,                                                                            // 10 : useDtdbBodyFilter
     dtdbMinBodyRatio,                                                                                         // 11 : dtdbMinBodyRatio
     useDtdbBreakColor ? 1.0 : 0.0                                                                             // 12 : useDtdbBreakColor
 )

// Pivot を時系列1配列へ追加（元コード f_dtdbEnvPush と同一。描画用の時刻配列だけ省略）
f_dtdbPush(_pr, _bar, _hi, _price, _b, _isHigh, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pDtdbMaxPivots          = int(array.get(PRM_DTDB, 0))
    float _pDtdbNoiseATR           = array.get(PRM_DTDB, 1)
    int _n = array.size(_pr)
    if _n == 0
        array.push(_pr, _price)
        array.push(_bar, _b)
        array.push(_hi, _isHigh)
    else
        bool _lastHigh = array.get(_hi, _n - 1)
        if _isHigh == _lastHigh
            float _lastP = array.get(_pr, _n - 1)
            if (_isHigh and _price > _lastP) or (not _isHigh and _price < _lastP)
                array.set(_pr, _n - 1, _price)
                array.set(_bar, _n - 1, _b)
        else
            float _lastP = array.get(_pr, _n - 1)
            if math.abs(_price - _lastP) >= _atr * _pDtdbNoiseATR
                array.push(_pr, _price)
                array.push(_bar, _b)
                array.push(_hi, _isHigh)
    while array.size(_pr) > _pDtdbMaxPivots
        array.shift(_pr)
        array.shift(_bar)
        array.shift(_hi)

// 頂点/底値の許容判定（元コード f_dtdbEnvTolOk と同一）
f_dtdbTolOk(_a, _b, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pDtdbTolMode            = int(array.get(PRM_DTDB, 2))
    float _pDtdbTolPct             = array.get(PRM_DTDB, 3)
    float _pDtdbTolATR             = array.get(PRM_DTDB, 4)
    float _diff = math.abs(_a - _b)
    bool _pctOk = _a != 0 and (_diff / _a) <= _pDtdbTolPct
    bool _atrOk = _atr > 0 and _diff <= _atr * _pDtdbTolATR
    _pDtdbTolMode == 0              ? _pctOk :
     _pDtdbTolMode == 1             ? _atrOk :
     _pDtdbTolMode == 2             ? (_pctOk or _atrOk) :
     (_pctOk and _atrOk)

// 候補スコア 0〜100（元コード f_dtdbEnvScore と同一）
f_dtdbScore(_diff, _atr, _depth, _width, _p1b, _neckb, _p2b) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pDtdbMinPatternBars     = int(array.get(PRM_DTDB, 6))
    int   _pDtdbMaxPatternBars     = int(array.get(PRM_DTDB, 7))
    float _sym = _atr > 0 ? math.max(0.0, 1.0 - (_diff / _atr)) : 0.0
    float _dep = _atr > 0 ? math.min(1.0, _depth / (_atr * 3.0)) : 0.0
    float _mid = (_pDtdbMinPatternBars + _pDtdbMaxPatternBars) / 2.0
    float _wid = _mid > 0 ? math.max(0.0, 1.0 - math.abs(_width - _mid) / _mid) : 0.0
    int _left  = _neckb - _p1b
    int _right = _p2b - _neckb
    float _bal = (_left > 0 and _right > 0) ? (math.min(_left, _right) / math.max(_left, _right)) : 0.0
    (_sym * 40.0) + (_dep * 25.0) + (_wid * 20.0) + (_bal * 15.0)

f_dtdbEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pDtdbMinNeckDepthATR    = array.get(PRM_DTDB, 5)
    int   _pDtdbMinPatternBars     = int(array.get(PRM_DTDB, 6))
    int   _pDtdbMaxPatternBars     = int(array.get(PRM_DTDB, 7))
    float _pDtdbBreakBufferATR     = array.get(PRM_DTDB, 8)
    int   _pDtdbBreakMaxBars       = int(array.get(PRM_DTDB, 9))
    bool  _pUseDtdbBodyFilter      = array.get(PRM_DTDB, 10) > 0.5
    float _pDtdbMinBodyRatio       = array.get(PRM_DTDB, 11)
    bool  _pUseDtdbBreakColor      = array.get(PRM_DTDB, 12) > 0.5
    float _atr = ta.atr(14)
    var array<float> _pPr   = array.new_float()
    var array<int>   _pBar  = array.new_int()
    var array<bool>  _pHigh = array.new_bool()
    float _ph = ta.pivothigh(high, dtdbPivotLen, dtdbPivotLen)
    float _pl = ta.pivotlow(low, dtdbPivotLen, dtdbPivotLen)
    bool _newHigh = not na(_ph)
    bool _newLow  = not na(_pl)
    if _newHigh
        f_dtdbPush(_pPr, _pBar, _pHigh, _ph, bar_index - dtdbPivotLen, true, _atr)
    if _newLow
        f_dtdbPush(_pPr, _pBar, _pHigh, _pl, bar_index - dtdbPivotLen, false, _atr)

    // --- DT候補 状態 ---
    var bool  _dtActive = false
    var bool  _dtBroken = false
    var float _dtNeP = na
    var int   _dtFormBar = na
    // --- DB候補 状態 ---
    var bool  _dbActive = false
    var bool  _dbBroken = false
    var float _dbNeP = na
    var int   _dbFormBar = na

    int _n = array.size(_pPr)

    // --- DT候補探索（新しい High = 2回目の頂点）---
    if _newHigh and _n >= 3
        int _k = _n - 1
        if array.get(_pHigh, _k)
            float _t2  = array.get(_pPr, _k)
            int   _t2b = array.get(_pBar, _k)
            float _best = na
            for _i = 0 to _k - 2
                if array.get(_pHigh, _i)
                    float _t1  = array.get(_pPr, _i)
                    int   _t1b = array.get(_pBar, _i)
                    // _i と _k の間で最安の Low をネックラインに
                    float _neck = na
                    int   _neckb = na
                    for _m = _i + 1 to _k - 1
                        if not array.get(_pHigh, _m)
                            float _lp = array.get(_pPr, _m)
                            if na(_neck) or _lp < _neck
                                _neck  := _lp
                                _neckb := array.get(_pBar, _m)
                    if not na(_neck)
                        float _diff  = math.abs(_t1 - _t2)
                        float _depth = math.min(_t1, _t2) - _neck
                        int   _width = _t2b - _t1b
                        bool  _tolOk   = f_dtdbTolOk(_t1, _t2, _atr)
                        bool  _depthOk = _depth >= _atr * _pDtdbMinNeckDepthATR
                        bool  _widthOk = _width >= _pDtdbMinPatternBars and _width <= _pDtdbMaxPatternBars
                        if _tolOk and _depthOk and _widthOk
                            float _sc = f_dtdbScore(_diff, _atr, _depth, _width, _t1b, _neckb, _t2b)
                            if na(_best) or _sc > _best
                                _best := _sc
                                _dtActive := true
                                _dtBroken := false
                                _dtNeP := _neck
                                _dtFormBar := bar_index

    // --- DB候補探索（新しい Low = 2回目の底値）---
    if _newLow and _n >= 3
        int _k = _n - 1
        if not array.get(_pHigh, _k)
            float _b2  = array.get(_pPr, _k)
            int   _b2b = array.get(_pBar, _k)
            float _best = na
            for _i = 0 to _k - 2
                if not array.get(_pHigh, _i)
                    float _b1  = array.get(_pPr, _i)
                    int   _b1b = array.get(_pBar, _i)
                    // _i と _k の間で最高の High をネックラインに
                    float _neck = na
                    int   _neckb = na
                    for _m = _i + 1 to _k - 1
                        if array.get(_pHigh, _m)
                            float _hp = array.get(_pPr, _m)
                            if na(_neck) or _hp > _neck
                                _neck  := _hp
                                _neckb := array.get(_pBar, _m)
                    if not na(_neck)
                        float _diff  = math.abs(_b1 - _b2)
                        float _depth = _neck - math.max(_b1, _b2)
                        int   _width = _b2b - _b1b
                        bool  _tolOk   = f_dtdbTolOk(_b1, _b2, _atr)
                        bool  _depthOk = _depth >= _atr * _pDtdbMinNeckDepthATR
                        bool  _widthOk = _width >= _pDtdbMinPatternBars and _width <= _pDtdbMaxPatternBars
                        if _tolOk and _depthOk and _widthOk
                            float _sc = f_dtdbScore(_diff, _atr, _depth, _width, _b1b, _neckb, _b2b)
                            if na(_best) or _sc > _best
                                _best := _sc
                                _dbActive := true
                                _dbBroken := false
                                _dbNeP := _neck
                                _dbFormBar := bar_index

    // --- ブレイク足フィルター（実体率 / 色）---
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool  _bodyOk    = not _pUseDtdbBodyFilter or (_rng > 0 and (_body / _rng) >= _pDtdbMinBodyRatio)
    bool  _dtColorOk = not _pUseDtdbBreakColor or close < open
    bool  _dbColorOk = not _pUseDtdbBreakColor or close > open

    // --- DT ネックライン下抜け（期限切れは失効・同じパターンからは1回だけ）---
    bool _dtdbShort = false
    if _dtActive and not _dtBroken and not na(_dtNeP)
        if not na(_dtFormBar) and (bar_index - _dtFormBar) > _pDtdbBreakMaxBars
            _dtActive := false
        else if close < _dtNeP - _atr * _pDtdbBreakBufferATR and _bodyOk and _dtColorOk
            _dtdbShort := true
            _dtBroken := true

    // --- DB ネックライン上抜け（期限切れは失効・同じパターンからは1回だけ）---
    bool _dtdbLong = false
    if _dbActive and not _dbBroken and not na(_dbNeP)
        if not na(_dbFormBar) and (bar_index - _dbFormBar) > _pDtdbBreakMaxBars
            _dbActive := false
        else if close > _dbNeP + _atr * _pDtdbBreakBufferATR and _bodyOk and _dbColorOk
            _dtdbLong := true
            _dbBroken := true

    // 同一足で両方確定した場合も両方のイベントを返す（方向の裁定は POINT MASTER §6）
    [_dtdbLong, _dtdbShort]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic17 = Wedge Pattern（Bear / Bull）
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + ウェッジ 環境認識ストラテジー」（f_wedgeEnvLinePrice /
// f_wedgeEnvSlope / f_wedgeEnvPush / f_wedgeEnvScore と候補探索）と同一です。
//   ・確定Pivot High / Low を別配列で保持（ATRノイズ除外 / 上限で最古を破棄）
//   ・Bear（Rising Wedge） : upSlope > 0 かつ loSlope > 0 かつ loSlope > upSlope
//   ・Bull（Falling Wedge）: upSlope < 0 かつ loSlope < 0 かつ upSlope < loSlope
//   ・Slope は ATR正規化して最低 / 最大でフィルター
//   ・収束条件 WidthNow <= WidthStart × ContractionRatio
//   ・Pattern Width（最小 / 最大）とラインからの許容誤差付き最低Touch数
//   ・Quality（Touch数 / 平均誤差 / 収束度 / 横幅）で Bear・Bull の最良候補を独立に保持
//
//   候補が完成しただけではイベントを出しません。現在バーまで延長したラインを
//   確定終値がATRバッファ込みで抜けた足だけがイベントになります。
//     Bear : close < 下限ライン - ATR×バッファ → SHORT
//     Bull : close > 上限ライン + ATR×バッファ → LONG
//   上下ライン交差（WidthNow <= 0 / upper <= lower）で候補は即失効し、ブレイク期限、
//   実体率フィルター、ブレイク足の色要求、ATR拡大フィルターも元コードどおりです。
//
// 各候補のブレイクは1回だけ（Broken管理）。同一足でBearとBullが両方確定した場合は
// 両方のイベントを返し、方向の裁定は POINT MASTER §6 の同時発生設定に任せます。
// 出力はイベント2値のみで、保持・期限・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpWedge = "④ Logic17 : Wedge パラメータ"
wedgePivotLen        = input.int(3,     "Pivot Length",                  group = grpWedge, minval = 1)
wedgeMinTouches      = input.int(2,     "最低Pivotタッチ数 (両サイド)",   group = grpWedge, minval = 2, maxval = 4)
wedgeMaxPivots       = input.int(12,    "保持Pivot数 (各サイド)",         group = grpWedge, minval = 4, maxval = 24)
wedgeNoiseATR        = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率", group = grpWedge, step = 0.05)
wedgeTouchTolATR     = input.float(0.5, "ラインからの許容誤差 ATR倍率",   group = grpWedge, minval = 0.0, step = 0.05)
wedgeMinSlopeATR     = input.float(0.01, "最低傾き slope/ATR (絶対値)",   group = grpWedge, minval = 0.0, step = 0.01)
wedgeMaxSlopeATR     = input.float(2.0,  "最大傾き slope/ATR (絶対値)",   group = grpWedge, minval = 0.1, step = 0.1)
wedgeContractionRatio = input.float(0.7, "収束率 WidthNow <= WidthStart ×", group = grpWedge, minval = 0.1, maxval = 1.0, step = 0.05)
wedgeMinPatternBars  = input.int(8,     "パターン最小横幅",               group = grpWedge, minval = 1)
wedgeMaxPatternBars  = input.int(80,    "パターン最大横幅",               group = grpWedge, minval = 2)
wedgeBreakBufferATR  = input.float(0.1, "ラインブレイクのATRバッファ",     group = grpWedge, minval = 0.0, step = 0.05)
wedgeBreakMaxBars    = input.int(20,    "候補完成後のブレイク期限",        group = grpWedge, minval = 1)
useWedgeBreakColor   = input.bool(false, "ブレイク足の色を要求 (Bear=陰線/Bull=陽線)", group = grpWedge)
useWedgeBodyFilter   = input.bool(true,  "ブレイク実体率フィルターを使う",  group = grpWedge)
wedgeMinBodyRatio    = input.float(0.45, "最低ブレイク実体率",            group = grpWedge, minval = 0.0, maxval = 1.0, step = 0.05)
useWedgeVolExpansion = input.bool(false, "ブレイク時のATR拡大を要求",      group = grpWedge)
wedgeAtrExpandLen    = input.int(20,    "ATR拡大 比較本数",               group = grpWedge, minval = 1)
wedgeAtrExpandMult   = input.float(1.1, "ATR > 平均ATR ×",               group = grpWedge, step = 0.05)
useWedgeQualityFilter = input.bool(false, "Quality Filterを使う",         group = grpWedge)
wedgeMinQuality      = input.int(50,    "最低Quality",                   group = grpWedge, minval = 0, maxval = 100)

// --- Logic17 Wedge のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_WEDGE = array.from(
     wedgeMinTouches * 1.0,              // 00 : wedgeMinTouches
     wedgeMaxPivots * 1.0,               // 01 : wedgeMaxPivots
     wedgeNoiseATR,                      // 02 : wedgeNoiseATR
     wedgeTouchTolATR,                   // 03 : wedgeTouchTolATR
     wedgeMinSlopeATR,                   // 04 : wedgeMinSlopeATR
     wedgeMaxSlopeATR,                   // 05 : wedgeMaxSlopeATR
     wedgeContractionRatio,              // 06 : wedgeContractionRatio
     wedgeMinPatternBars * 1.0,          // 07 : wedgeMinPatternBars
     wedgeMaxPatternBars * 1.0,          // 08 : wedgeMaxPatternBars
     wedgeBreakBufferATR,                // 09 : wedgeBreakBufferATR
     wedgeBreakMaxBars * 1.0,            // 10 : wedgeBreakMaxBars
     useWedgeBreakColor ? 1.0 : 0.0,     // 11 : useWedgeBreakColor
     useWedgeBodyFilter ? 1.0 : 0.0,     // 12 : useWedgeBodyFilter
     wedgeMinBodyRatio,                  // 13 : wedgeMinBodyRatio
     useWedgeVolExpansion ? 1.0 : 0.0,   // 14 : useWedgeVolExpansion
     wedgeAtrExpandMult,                 // 15 : wedgeAtrExpandMult
     useWedgeQualityFilter ? 1.0 : 0.0,  // 16 : useWedgeQualityFilter
     wedgeMinQuality * 1.0               // 17 : wedgeMinQuality
 )

// --- 元コードと同一の補助関数 ---
f_wedgeLinePrice(_x1, _y1, _x2, _y2, _xNow) =>
    float _res = na
    if _x2 != _x1
        float _slope = (_y2 - _y1) / (_x2 - _x1)
        _res := _y1 + _slope * (_xNow - _x1)
    _res

f_wedgeSlope(_x1, _y1, _x2, _y2) =>
    _x2 != _x1 ? (_y2 - _y1) / (_x2 - _x1) : na

f_wedgePush(_p, _b, _price, _bar, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pWedgeMaxPivots         = int(array.get(PRM_WEDGE, 1))
    float _pWedgeNoiseATR          = array.get(PRM_WEDGE, 2)
    int _n = array.size(_p)
    if _n == 0
        array.push(_p, _price)
        array.push(_b, _bar)
    else
        float _last = array.get(_p, _n - 1)
        if math.abs(_price - _last) >= _atr * _pWedgeNoiseATR
            array.push(_p, _price)
            array.push(_b, _bar)
    while array.size(_p) > _pWedgeMaxPivots
        array.shift(_p)
        array.shift(_b)

f_wedgeScore(_touchHi, _touchLo, _avgErr, _atr, _wStart, _wNow, _patBars) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pWedgeContractionRatio  = array.get(PRM_WEDGE, 6)
    int   _pWedgeMinPatternBars    = int(array.get(PRM_WEDGE, 7))
    int   _pWedgeMaxPatternBars    = int(array.get(PRM_WEDGE, 8))
    float _touchPts = math.min(20.0, (_touchHi + _touchLo) * 4.0)
    float _errPts = _atr > 0 ? math.max(0.0, 20.0 - (_avgErr / _atr) * 20.0) : 0.0
    float _ratio = (not na(_wStart) and _wStart > 0 and not na(_wNow)) ? _wNow / _wStart : 1.0
    float _contrPts = math.min(25.0, math.max(0.0, (1.0 - _ratio) / math.max(1.0 - _pWedgeContractionRatio, 0.01) * 25.0))
    float _mid = (_pWedgeMinPatternBars + _pWedgeMaxPatternBars) / 2.0
    float _barPts = _mid > 0 ? math.max(0.0, 15.0 * (1.0 - math.abs(_patBars - _mid) / _mid)) : 0.0
    float _crossPts = math.min(20.0, math.max(0.0, (1.0 - _ratio) * 20.0))
    math.min(100.0, _touchPts + _errPts + _contrPts + _barPts + _crossPts)

f_wedgeEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pWedgeMinTouches        = int(array.get(PRM_WEDGE, 0))
    float _pWedgeTouchTolATR       = array.get(PRM_WEDGE, 3)
    float _pWedgeMinSlopeATR       = array.get(PRM_WEDGE, 4)
    float _pWedgeMaxSlopeATR       = array.get(PRM_WEDGE, 5)
    float _pWedgeContractionRatio  = array.get(PRM_WEDGE, 6)
    int   _pWedgeMinPatternBars    = int(array.get(PRM_WEDGE, 7))
    int   _pWedgeMaxPatternBars    = int(array.get(PRM_WEDGE, 8))
    float _pWedgeBreakBufferATR    = array.get(PRM_WEDGE, 9)
    int   _pWedgeBreakMaxBars      = int(array.get(PRM_WEDGE, 10))
    bool  _pUseWedgeBreakColor     = array.get(PRM_WEDGE, 11) > 0.5
    bool  _pUseWedgeBodyFilter     = array.get(PRM_WEDGE, 12) > 0.5
    float _pWedgeMinBodyRatio      = array.get(PRM_WEDGE, 13)
    bool  _pUseWedgeVolExpansion   = array.get(PRM_WEDGE, 14) > 0.5
    float _pWedgeAtrExpandMult     = array.get(PRM_WEDGE, 15)
    bool  _pUseWedgeQualityFilter  = array.get(PRM_WEDGE, 16) > 0.5
    int   _pWedgeMinQuality        = int(array.get(PRM_WEDGE, 17))
    float _atr = ta.atr(14)
    float _atrAvg = ta.sma(_atr, wedgeAtrExpandLen)
    var array<float> _phP = array.new_float()
    var array<int>   _phB = array.new_int()
    var array<float> _plP = array.new_float()
    var array<int>   _plB = array.new_int()
    float _ph = ta.pivothigh(high, wedgePivotLen, wedgePivotLen)
    float _pl = ta.pivotlow(low, wedgePivotLen, wedgePivotLen)
    bool _newHigh = not na(_ph)
    bool _newLow  = not na(_pl)
    if _newHigh
        f_wedgePush(_phP, _phB, _ph, bar_index - wedgePivotLen, _atr)
    if _newLow
        f_wedgePush(_plP, _plB, _pl, bar_index - wedgePivotLen, _atr)

    // --- Bear候補（Rising Wedge）状態 ---
    var bool  _bearActive = false
    var bool  _bearBroken = false
    var float _bearUpP1 = na
    var int   _bearUpB1 = na
    var float _bearUpP2 = na
    var int   _bearUpB2 = na
    var float _bearLoP1 = na
    var int   _bearLoB1 = na
    var float _bearLoP2 = na
    var int   _bearLoB2 = na
    var int   _bearFormBar = na
    var float _bearQual = na
    // --- Bull候補（Falling Wedge）状態 ---
    var bool  _bullActive = false
    var bool  _bullBroken = false
    var float _bullUpP1 = na
    var int   _bullUpB1 = na
    var float _bullUpP2 = na
    var int   _bullUpB2 = na
    var float _bullLoP1 = na
    var int   _bullLoB1 = na
    var float _bullLoP2 = na
    var int   _bullLoB2 = na
    var int   _bullFormBar = na
    var float _bullQual = na

    int _nH = array.size(_phP)
    int _nL = array.size(_plP)
    float _touchTol = _atr * _pWedgeTouchTolATR

    // --- 候補探索（新しいPivotが出た時のみ・右端は最新の高値/安値）---
    if (_newHigh or _newLow) and _nH >= 2 and _nL >= 2
        int   _kH  = _nH - 1
        int   _kL  = _nL - 1
        float _h2  = array.get(_phP, _kH)
        int   _h2b = array.get(_phB, _kH)
        float _l2  = array.get(_plP, _kL)
        int   _l2b = array.get(_plB, _kL)
        float _bestBear = na
        float _bestBull = na
        for _i = 0 to _kH - 1
            float _h1  = array.get(_phP, _i)
            int   _h1b = array.get(_phB, _i)
            for _a = 0 to _kL - 1
                float _l1  = array.get(_plP, _a)
                int   _l1b = array.get(_plB, _a)
                float _upSlope = f_wedgeSlope(_h1b, _h1, _h2b, _h2)
                float _loSlope = f_wedgeSlope(_l1b, _l1, _l2b, _l2)
                if not na(_upSlope) and not na(_loSlope)
                    // Rising(Bear): 両方上昇・安値傾き>高値傾き / Falling(Bull): 両方下降・高値傾き<安値傾き
                    bool _isBear = _upSlope > 0 and _loSlope > 0 and _loSlope > _upSlope
                    bool _isBull = _upSlope < 0 and _loSlope < 0 and _upSlope < _loSlope
                    if _isBear or _isBull
                        int _startX = math.min(_h1b, _l1b)
                        int _rightX = math.max(_h2b, _l2b)
                        float _upStart = f_wedgeLinePrice(_h1b, _h1, _h2b, _h2, _startX)
                        float _loStart = f_wedgeLinePrice(_l1b, _l1, _l2b, _l2, _startX)
                        float _upNow = f_wedgeLinePrice(_h1b, _h1, _h2b, _h2, bar_index)
                        float _loNow = f_wedgeLinePrice(_l1b, _l1, _l2b, _l2, bar_index)
                        float _wStart = (not na(_upStart) and not na(_loStart)) ? _upStart - _loStart : na
                        float _wNow   = (not na(_upNow) and not na(_loNow)) ? _upNow - _loNow : na
                        int   _patBars = _rightX - _startX
                        float _upSlopeATR = _atr > 0 ? _upSlope / _atr : na
                        float _loSlopeATR = _atr > 0 ? _loSlope / _atr : na
                        bool _slopeOk = not na(_upSlopeATR) and not na(_loSlopeATR) and math.abs(_upSlopeATR) >= _pWedgeMinSlopeATR and math.abs(_upSlopeATR) <= _pWedgeMaxSlopeATR and math.abs(_loSlopeATR) >= _pWedgeMinSlopeATR and math.abs(_loSlopeATR) <= _pWedgeMaxSlopeATR
                        bool _widthOk = not na(_wStart) and not na(_wNow) and _wStart > 0 and _wNow > 0 and _wNow <= _wStart * _pWedgeContractionRatio
                        bool _barsOk = _patBars >= _pWedgeMinPatternBars and _patBars <= _pWedgeMaxPatternBars
                        if _slopeOk and _widthOk and _barsOk
                            // タッチ数 / ラインからの誤差
                            int _touchHi = 0
                            float _errHiSum = 0.0
                            for _m = 0 to _nH - 1
                                int _mb = array.get(_phB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_wedgeLinePrice(_h1b, _h1, _h2b, _h2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_phP, _m) - _lv)
                                        _errHiSum += _e
                                        if _e <= _touchTol
                                            _touchHi += 1
                            int _touchLo = 0
                            float _errLoSum = 0.0
                            for _m = 0 to _nL - 1
                                int _mb = array.get(_plB, _m)
                                if _mb >= _startX and _mb <= _rightX
                                    float _lv = f_wedgeLinePrice(_l1b, _l1, _l2b, _l2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_plP, _m) - _lv)
                                        _errLoSum += _e
                                        if _e <= _touchTol
                                            _touchLo += 1
                            bool _touchOk = _touchHi >= _pWedgeMinTouches and _touchLo >= _pWedgeMinTouches
                            float _avgErr = (_errHiSum + _errLoSum) / math.max(_touchHi + _touchLo, 1)
                            float _score = f_wedgeScore(_touchHi, _touchLo, _avgErr, _atr, _wStart, _wNow, _patBars)
                            if _touchOk
                                if _isBear and (na(_bestBear) or _score > _bestBear)
                                    _bestBear := _score
                                    _bearActive := true
                                    _bearBroken := false
                                    _bearUpP1 := _h1
                                    _bearUpB1 := _h1b
                                    _bearUpP2 := _h2
                                    _bearUpB2 := _h2b
                                    _bearLoP1 := _l1
                                    _bearLoB1 := _l1b
                                    _bearLoP2 := _l2
                                    _bearLoB2 := _l2b
                                    _bearFormBar := bar_index
                                    _bearQual := _score
                                if _isBull and (na(_bestBull) or _score > _bestBull)
                                    _bestBull := _score
                                    _bullActive := true
                                    _bullBroken := false
                                    _bullUpP1 := _h1
                                    _bullUpB1 := _h1b
                                    _bullUpP2 := _h2
                                    _bullUpB2 := _h2b
                                    _bullLoP1 := _l1
                                    _bullLoB1 := _l1b
                                    _bullLoP2 := _l2
                                    _bullLoB2 := _l2b
                                    _bullFormBar := bar_index
                                    _bullQual := _score

    // 品質フィルター（採用候補が品質未満なら候補を無効化）
    if _bearActive and _pUseWedgeQualityFilter and not na(_bearQual) and _bearQual < _pWedgeMinQuality
        _bearActive := false
    if _bullActive and _pUseWedgeQualityFilter and not na(_bullQual) and _bullQual < _pWedgeMinQuality
        _bullActive := false

    // --- 各候補を現在バーへ延長 ---
    float _bearUpNow = _bearActive ? f_wedgeLinePrice(_bearUpB1, _bearUpP1, _bearUpB2, _bearUpP2, bar_index) : na
    float _bearLoNow = _bearActive ? f_wedgeLinePrice(_bearLoB1, _bearLoP1, _bearLoB2, _bearLoP2, bar_index) : na
    float _bearWNow  = (not na(_bearUpNow) and not na(_bearLoNow)) ? _bearUpNow - _bearLoNow : na
    float _bullUpNow = _bullActive ? f_wedgeLinePrice(_bullUpB1, _bullUpP1, _bullUpB2, _bullUpP2, bar_index) : na
    float _bullLoNow = _bullActive ? f_wedgeLinePrice(_bullLoB1, _bullLoP1, _bullLoB2, _bullLoP2, bar_index) : na
    float _bullWNow  = (not na(_bullUpNow) and not na(_bullLoNow)) ? _bullUpNow - _bullLoNow : na

    // --- ブレイク足フィルター ---
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool  _bodyOk = not _pUseWedgeBodyFilter or (_rng > 0 and (_body / _rng) >= _pWedgeMinBodyRatio)
    bool  _volOk  = not _pUseWedgeVolExpansion or (not na(_atrAvg) and _atr > _atrAvg * _pWedgeAtrExpandMult)
    bool  _bearColorOk = not _pUseWedgeBreakColor or close < open
    bool  _bullColorOk = not _pUseWedgeBreakColor or close > open

    // --- Bear候補: ライン交差失効 / 期限切れ / 下限下抜け ---
    bool _bearLinesValid = not na(_bearUpNow) and not na(_bearLoNow) and not na(_bearWNow) and _bearWNow > 0 and _bearUpNow > _bearLoNow
    bool _wedgeShort = false
    if _bearActive and not _bearBroken
        if not _bearLinesValid
            _bearActive := false
        else if not na(_bearFormBar) and (bar_index - _bearFormBar) > _pWedgeBreakMaxBars
            _bearActive := false
        else if close < _bearLoNow - _atr * _pWedgeBreakBufferATR and _bodyOk and _bearColorOk and _volOk
            _wedgeShort := true
            _bearBroken := true

    // --- Bull候補: ライン交差失効 / 期限切れ / 上限上抜け ---
    bool _bullLinesValid = not na(_bullUpNow) and not na(_bullLoNow) and not na(_bullWNow) and _bullWNow > 0 and _bullUpNow > _bullLoNow
    bool _wedgeLong = false
    if _bullActive and not _bullBroken
        if not _bullLinesValid
            _bullActive := false
        else if not na(_bullFormBar) and (bar_index - _bullFormBar) > _pWedgeBreakMaxBars
            _bullActive := false
        else if close > _bullUpNow + _atr * _pWedgeBreakBufferATR and _bodyOk and _bullColorOk and _volOk
            _wedgeLong := true
            _bullBroken := true

    // 同一足で両方確定した場合も両方のイベントを返す（方向の裁定は POINT MASTER §6）
    [_wedgeLong, _wedgeShort]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic18 = Triangle Pattern（Ascending / Descending のみ）
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + トライアングル 環境認識ストラテジー」（f_triangleEnvLinePrice /
// f_triangleEnvSlope / f_triangleEnvHorizOk / f_triangleEnvPush / f_triangleEnvScore と
// 候補探索）と同一です。
//   ・確定Pivot High / Low を別配列で保持（ATRノイズ除外 / 上限で最古を破棄）
//   ・Ascending  : 上限が水平 かつ 下限が上昇（Higher Low）
//   ・Descending : 下限が水平 かつ 上限が下降（Lower High）
//   ・水平判定は Percent / ATR / PercentOrATR / PercentAndATR の4モード
//   ・収束条件 WidthNow <= WidthStart × ContractionRatio
//   ・Pattern Width（最小 / 最大）、許容誤差付きの最低Touch数、最大Touch探索数
//   ・Quality（Touch数 / 平均誤差 / 収束度 / 横幅 / 種類別ライン精度）で最良候補を採用
//   ・最良と次点が完全同点なら候補競合として失効（方向を勝手に決めない）
//
// ★ Symmetrical Triangle は候補探索段階で作らず、イベント出力でも type 1/2 に限定します。
//
//   形が完成しただけではイベントを出しません。現在バーまで延長した境界ラインを
//   確定終値がATRバッファ込みで抜けた足だけがイベントになります。
//     上限上抜け → LONG（Ascending のブレイク / Descending の否定）
//     下限下抜け → SHORT（Descending のブレイク / Ascending の否定）
//   ライン交差（WidthNow <= 0 / upper <= lower）で候補は即失効し、Setup有効期限、
//   ブレイク期限、実体率フィルター、ブレイク足の色要求、ATR拡大フィルターも元コードどおり。
//   Retest / FakeBreak / Invalidationイベントモードは移植していません（Breakのみ）。
//
// 各候補のブレイクは1回だけ（_brokeDir 管理）。同一足で上下両方が確定した場合は
// 両方のイベントを返し、方向の裁定は POINT MASTER §6 の同時発生設定に任せます。
// 出力はイベント2値のみで、保持・期限・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpTri = "④ Logic18 : Triangle パラメータ"
triPivotLen        = input.int(3,     "Pivot Length",                  group = grpTri, minval = 1)
triMinTouches      = input.int(2,     "最低Pivotタッチ数 (両サイド)",   group = grpTri, minval = 2, maxval = 4)
triMaxTouches      = input.int(6,     "最大タッチ数 (探索上限)",        group = grpTri, minval = 2, maxval = 10)
triMaxPivots       = input.int(12,    "保持Pivot数 (各サイド)",         group = grpTri, minval = 4, maxval = 24)
triNoiseATR        = input.float(0.5, "ノイズ除外 前Pivot値幅 ATR倍率", group = grpTri, step = 0.05)
triTouchTolATR     = input.float(0.5, "ラインからの許容誤差 ATR倍率",   group = grpTri, minval = 0.0, step = 0.05)
triHorizontalMode  = input.string("PercentOrATR", "水平判定モード", options = ["Percent", "ATR", "PercentOrATR", "PercentAndATR"], group = grpTri)
triTolerancePct    = input.float(0.004, "水平許容率 (Percent)",        group = grpTri, minval = 0.0, step = 0.001)
triToleranceATR    = input.float(0.5,  "水平許容差 (ATR倍率)",         group = grpTri, minval = 0.0, step = 0.05)
triContractionRatio = input.float(0.9, "収束率 WidthNow <= WidthStart ×", group = grpTri, minval = 0.1, maxval = 1.0, step = 0.05)
triMinPatternBars  = input.int(16,    "パターン最小横幅",               group = grpTri, minval = 1)
triMaxPatternBars  = input.int(80,    "パターン最大横幅",               group = grpTri, minval = 2)
triSetupValidBars  = input.int(50,    "セットアップ有効本数",            group = grpTri, minval = 1)
triBreakMaxBars    = input.int(20,    "候補完成後のブレイク期限",        group = grpTri, minval = 1)
triBreakBufferATR  = input.float(0.05, "ラインブレイクのATRバッファ",    group = grpTri, minval = 0.0, step = 0.05)
useTriBreakColor   = input.bool(false, "ブレイク足の色を要求 (上抜け=陽線/下抜け=陰線)", group = grpTri)
useTriBodyFilter   = input.bool(true,  "ブレイク実体率フィルターを使う",  group = grpTri)
triMinBodyRatio    = input.float(0.45, "最低ブレイク実体率",            group = grpTri, minval = 0.0, maxval = 1.0, step = 0.05)
useTriATRExpansion = input.bool(false, "ブレイク時のATR拡大を要求",      group = grpTri)
triAtrExpandLen    = input.int(20,    "ATR拡大 比較本数",               group = grpTri, minval = 1)
triAtrExpandMult   = input.float(1.1, "ATR > 平均ATR ×",               group = grpTri, step = 0.05)
useTriQualityFilter = input.bool(false, "Quality Filterを使う",         group = grpTri)
triMinQuality      = input.int(50,    "最低Quality",                   group = grpTri, minval = 0, maxval = 100)

// --- Logic18 Triangle のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_TRI = array.from(
     triMinTouches * 1.0,                                                                                                        // 00 : triMinTouches
     triMaxTouches * 1.0,                                                                                                        // 01 : triMaxTouches
     triMaxPivots * 1.0,                                                                                                         // 02 : triMaxPivots
     triNoiseATR,                                                                                                                // 03 : triNoiseATR
     triTouchTolATR,                                                                                                             // 04 : triTouchTolATR
     triHorizontalMode == "Percent" ? 0.0 : triHorizontalMode == "ATR" ? 1.0 : triHorizontalMode == "PercentOrATR" ? 2.0 : 3.0,  // 05 : triHorizontalMode
     triTolerancePct,                                                                                                            // 06 : triTolerancePct
     triToleranceATR,                                                                                                            // 07 : triToleranceATR
     triContractionRatio,                                                                                                        // 08 : triContractionRatio
     triMinPatternBars * 1.0,                                                                                                    // 09 : triMinPatternBars
     triMaxPatternBars * 1.0,                                                                                                    // 10 : triMaxPatternBars
     triSetupValidBars * 1.0,                                                                                                    // 11 : triSetupValidBars
     triBreakMaxBars * 1.0,                                                                                                      // 12 : triBreakMaxBars
     triBreakBufferATR,                                                                                                          // 13 : triBreakBufferATR
     useTriBreakColor ? 1.0 : 0.0,                                                                                               // 14 : useTriBreakColor
     useTriBodyFilter ? 1.0 : 0.0,                                                                                               // 15 : useTriBodyFilter
     triMinBodyRatio,                                                                                                            // 16 : triMinBodyRatio
     useTriATRExpansion ? 1.0 : 0.0,                                                                                             // 17 : useTriATRExpansion
     triAtrExpandMult,                                                                                                           // 18 : triAtrExpandMult
     useTriQualityFilter ? 1.0 : 0.0,                                                                                            // 19 : useTriQualityFilter
     triMinQuality * 1.0                                                                                                         // 20 : triMinQuality
 )

// --- 元コードと同一の補助関数 ---
f_triLinePrice(_x1, _y1, _x2, _y2, _xNow) =>
    float _res = na
    if _x2 != _x1
        float _slope = (_y2 - _y1) / (_x2 - _x1)
        _res := _y1 + _slope * (_xNow - _x1)
    _res

f_triSlope(_x1, _y1, _x2, _y2) =>
    _x2 != _x1 ? (_y2 - _y1) / (_x2 - _x1) : na

f_triHorizOk(_a, _b, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pTriHorizontalMode      = int(array.get(PRM_TRI, 5))
    float _pTriTolerancePct        = array.get(PRM_TRI, 6)
    float _pTriToleranceATR        = array.get(PRM_TRI, 7)
    float _diff = math.abs(_a - _b)
    bool _pctOk = _a != 0 and (_diff / _a) <= _pTriTolerancePct
    bool _atrOk = _atr > 0 and _diff <= _atr * _pTriToleranceATR
    _pTriHorizontalMode == 0              ? _pctOk :
     _pTriHorizontalMode == 1             ? _atrOk :
     _pTriHorizontalMode == 2             ? (_pctOk or _atrOk) :
     (_pctOk and _atrOk)

f_triPush(_p, _b, _price, _bar, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pTriMaxPivots           = int(array.get(PRM_TRI, 2))
    float _pTriNoiseATR            = array.get(PRM_TRI, 3)
    int _n = array.size(_p)
    if _n == 0
        array.push(_p, _price)
        array.push(_b, _bar)
    else
        float _last = array.get(_p, _n - 1)
        if math.abs(_price - _last) >= _atr * _pTriNoiseATR
            array.push(_p, _price)
            array.push(_b, _bar)
    while array.size(_p) > _pTriMaxPivots
        array.shift(_p)
        array.shift(_b)

f_triScore(_touchHi, _touchLo, _avgErr, _atr, _wStart, _wNow, _patBars, _lineP) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pTriContractionRatio    = array.get(PRM_TRI, 8)
    int   _pTriMinPatternBars      = int(array.get(PRM_TRI, 9))
    int   _pTriMaxPatternBars      = int(array.get(PRM_TRI, 10))
    float _touchPts = math.min(20.0, (_touchHi + _touchLo) * 4.0)
    float _errPts = _atr > 0 ? math.max(0.0, 15.0 - (_avgErr / _atr) * 15.0) : 0.0
    float _ratio = (not na(_wStart) and _wStart > 0 and not na(_wNow)) ? _wNow / _wStart : 1.0
    float _contrPts = math.min(20.0, math.max(0.0, (1.0 - _ratio) / math.max(1.0 - _pTriContractionRatio, 0.01) * 20.0))
    float _mid = (_pTriMinPatternBars + _pTriMaxPatternBars) / 2.0
    float _barPts = _mid > 0 ? math.max(0.0, 10.0 * (1.0 - math.abs(_patBars - _mid) / _mid)) : 0.0
    float _crossPts = math.min(10.0, math.max(0.0, (1.0 - _ratio) * 10.0))
    math.min(100.0, _touchPts + _errPts + _contrPts + _barPts + _crossPts + math.min(25.0, math.max(0.0, _lineP)))

f_triangleEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pTriMinTouches          = int(array.get(PRM_TRI, 0))
    int   _pTriMaxTouches          = int(array.get(PRM_TRI, 1))
    float _pTriTouchTolATR         = array.get(PRM_TRI, 4)
    float _pTriTolerancePct        = array.get(PRM_TRI, 6)
    float _pTriContractionRatio    = array.get(PRM_TRI, 8)
    int   _pTriMinPatternBars      = int(array.get(PRM_TRI, 9))
    int   _pTriMaxPatternBars      = int(array.get(PRM_TRI, 10))
    int   _pTriSetupValidBars      = int(array.get(PRM_TRI, 11))
    int   _pTriBreakMaxBars        = int(array.get(PRM_TRI, 12))
    float _pTriBreakBufferATR      = array.get(PRM_TRI, 13)
    bool  _pUseTriBreakColor       = array.get(PRM_TRI, 14) > 0.5
    bool  _pUseTriBodyFilter       = array.get(PRM_TRI, 15) > 0.5
    float _pTriMinBodyRatio        = array.get(PRM_TRI, 16)
    bool  _pUseTriATRExpansion     = array.get(PRM_TRI, 17) > 0.5
    float _pTriAtrExpandMult       = array.get(PRM_TRI, 18)
    bool  _pUseTriQualityFilter    = array.get(PRM_TRI, 19) > 0.5
    int   _pTriMinQuality          = int(array.get(PRM_TRI, 20))
    float _atr = ta.atr(14)
    float _atrAvg = ta.sma(_atr, triAtrExpandLen)
    var array<float> _phP = array.new_float()
    var array<int>   _phB = array.new_int()
    var array<float> _plP = array.new_float()
    var array<int>   _plB = array.new_int()
    float _ph = ta.pivothigh(high, triPivotLen, triPivotLen)
    float _pl = ta.pivotlow(low, triPivotLen, triPivotLen)
    bool _newHigh = not na(_ph)
    bool _newLow  = not na(_pl)
    if _newHigh
        f_triPush(_phP, _phB, _ph, bar_index - triPivotLen, _atr)
    if _newLow
        f_triPush(_plP, _plB, _pl, bar_index - triPivotLen, _atr)

    // --- 採用候補 状態（1候補・種類混線なし）---
    var bool  _active = false
    var int   _type   = 0     // 1=Ascending / 2=Descending（Symmetricalは作らない）
    var float _upP1 = na
    var int   _upB1 = na
    var float _upP2 = na
    var int   _upB2 = na
    var float _loP1 = na
    var int   _loB1 = na
    var float _loP2 = na
    var int   _loB2 = na
    var float _wStart  = na
    var int   _formBar = na
    var float _quality = na
    var int   _brokeDir = 0   // 1候補につきブレイクは1回だけ

    int _nH = array.size(_phP)
    int _nL = array.size(_plP)
    float _touchTol = _atr * _pTriTouchTolATR

    // --- 候補探索（新しいPivotが出た時のみ・右端は最新の高値/安値）---
    if (_newHigh or _newLow) and _nH >= 2 and _nL >= 2
        int   _kH  = _nH - 1
        int   _kL  = _nL - 1
        float _h2  = array.get(_phP, _kH)
        int   _h2b = array.get(_phB, _kH)
        float _l2  = array.get(_plP, _kL)
        int   _l2b = array.get(_plB, _kL)
        float _bestScore = na
        float _secondBest = na
        int   _bestType  = 0
        float _cUpP1 = na
        int   _cUpB1 = na
        float _cLoP1 = na
        int   _cLoB1 = na
        float _cWStart = na
        float _cQual = na
        for _i = 0 to _kH - 1
            float _h1  = array.get(_phP, _i)
            int   _h1b = array.get(_phB, _i)
            for _a = 0 to _kL - 1
                float _l1  = array.get(_plP, _a)
                int   _l1b = array.get(_plB, _a)
                float _upSl = f_triSlope(_h1b, _h1, _h2b, _h2)
                float _loSl = f_triSlope(_l1b, _l1, _l2b, _l2)
                if not na(_upSl) and not na(_loSl)
                    bool _upHoriz = f_triHorizOk(_h1, _h2, _atr)
                    bool _loHoriz = f_triHorizOk(_l1, _l2, _atr)
                    bool _isAsc  = _upHoriz and _loSl > 0
                    bool _isDesc = _loHoriz and _upSl < 0
                    // ★ Symmetrical（_upSl < 0 and _loSl > 0 で両方非水平）はここで作らない
                    if _isAsc or _isDesc
                        int _startX = math.min(_h1b, _l1b)
                        int _rightX = math.max(_h2b, _l2b)
                        float _upStart = f_triLinePrice(_h1b, _h1, _h2b, _h2, _startX)
                        float _loStart = f_triLinePrice(_l1b, _l1, _l2b, _l2, _startX)
                        float _upNw = f_triLinePrice(_h1b, _h1, _h2b, _h2, bar_index)
                        float _loNw = f_triLinePrice(_l1b, _l1, _l2b, _l2, bar_index)
                        float _wS = (not na(_upStart) and not na(_loStart)) ? _upStart - _loStart : na
                        float _wN = (not na(_upNw) and not na(_loNw)) ? _upNw - _loNw : na
                        int   _pB = _rightX - _startX
                        bool _widthOk = not na(_wS) and not na(_wN) and _wS > 0 and _wN > 0 and _upNw > _loNw and _wN <= _wS * _pTriContractionRatio
                        bool _barsOk = _pB >= _pTriMinPatternBars and _pB <= _pTriMaxPatternBars
                        if _widthOk and _barsOk
                            int _tHi = 0
                            float _eHi = 0.0
                            for _m = 0 to _nH - 1
                                int _mb = array.get(_phB, _m)
                                if _mb >= _startX and _mb <= _rightX and _tHi < _pTriMaxTouches
                                    float _lv = f_triLinePrice(_h1b, _h1, _h2b, _h2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_phP, _m) - _lv)
                                        _eHi += _e
                                        if _e <= _touchTol
                                            _tHi += 1
                            int _tLo = 0
                            float _eLo = 0.0
                            for _m = 0 to _nL - 1
                                int _mb = array.get(_plB, _m)
                                if _mb >= _startX and _mb <= _rightX and _tLo < _pTriMaxTouches
                                    float _lv = f_triLinePrice(_l1b, _l1, _l2b, _l2, _mb)
                                    if not na(_lv)
                                        float _e = math.abs(array.get(_plP, _m) - _lv)
                                        _eLo += _e
                                        if _e <= _touchTol
                                            _tLo += 1
                            if _tHi >= _pTriMinTouches and _tLo >= _pTriMinTouches
                                float _avgE = (_eHi + _eLo) / math.max(_tHi + _tLo, 1)
                                // ライン精度点: Asc=上限水平精度 / Desc=下限水平精度
                                float _lineP = 0.0
                                if _isAsc
                                    _lineP := (_h1 != 0 and _pTriTolerancePct > 0) ? math.max(0.0, 25.0 * (1.0 - (math.abs(_h1 - _h2) / _h1) / _pTriTolerancePct)) : 12.0
                                else
                                    _lineP := (_l1 != 0 and _pTriTolerancePct > 0) ? math.max(0.0, 25.0 * (1.0 - (math.abs(_l1 - _l2) / _l1) / _pTriTolerancePct)) : 12.0
                                float _sc = f_triScore(_tHi, _tLo, _avgE, _atr, _wS, _wN, _pB, _lineP)
                                int _ty = _isAsc ? 1 : 2
                                if na(_bestScore) or _sc > _bestScore
                                    _secondBest := _bestScore
                                    _bestScore := _sc
                                    _bestType := _ty
                                    _cUpP1 := _h1
                                    _cUpB1 := _h1b
                                    _cLoP1 := _l1
                                    _cLoB1 := _l1b
                                    _cWStart := _wS
                                    _cQual := _sc
                                else if na(_secondBest) or _sc > _secondBest
                                    _secondBest := _sc
        // 候補競合: 最良と次点が完全同点なら失効（方向を勝手に決めない）。品質フィルターも適用。
        bool _qualOk = not _pUseTriQualityFilter or (not na(_cQual) and _cQual >= _pTriMinQuality)
        if _bestType != 0 and not na(_bestScore) and (na(_secondBest) or _bestScore > _secondBest) and _qualOk
            _active := true
            _type := _bestType
            _upP1 := _cUpP1
            _upB1 := _cUpB1
            _upP2 := _h2
            _upB2 := _h2b
            _loP1 := _cLoP1
            _loB1 := _cLoB1
            _loP2 := _l2
            _loB2 := _l2b
            _wStart := _cWStart
            _formBar := bar_index
            _quality := _cQual
            _brokeDir := 0        // 新候補 → ブレイク判定を再有効化
        else if _bestType != 0 and not na(_bestScore) and not na(_secondBest) and _bestScore == _secondBest
            _active := false

    // --- 現在バーへライン延長 ---
    float _upperNow = _active ? f_triLinePrice(_upB1, _upP1, _upB2, _upP2, bar_index) : na
    float _lowerNow = _active ? f_triLinePrice(_loB1, _loP1, _loB2, _loP2, bar_index) : na
    float _widthNow = (not na(_upperNow) and not na(_lowerNow)) ? _upperNow - _lowerNow : na

    // --- ライン交差失効 / Setup有効期限 / ブレイク期限 ---
    bool _linesValid = not na(_upperNow) and not na(_lowerNow) and not na(_widthNow) and _widthNow > 0 and _upperNow > _lowerNow
    if _active
        if not _linesValid
            _active := false
        else if not na(_formBar) and (bar_index - _formBar) > _pTriSetupValidBars
            _active := false
        else if _brokeDir == 0 and not na(_formBar) and (bar_index - _formBar) > _pTriBreakMaxBars
            _active := false

    // --- ブレイク足フィルター ---
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool  _bodyOk = not _pUseTriBodyFilter or (_rng > 0 and (_body / _rng) >= _pTriMinBodyRatio)
    bool  _volOk  = not _pUseTriATRExpansion or (not na(_atrAvg) and _atr > _atrAvg * _pTriAtrExpandMult)
    bool  _upColorOk = not _pUseTriBreakColor or close > open
    bool  _loColorOk = not _pUseTriBreakColor or close < open

    // --- ブレイク検出（Ascending / Descending のみ・1候補1ブレイク）---
    bool _typeOk = _type == 1 or _type == 2
    bool _upperBreak = _active and _typeOk and _brokeDir == 0 and _linesValid and close > _upperNow + _atr * _pTriBreakBufferATR and _bodyOk and _upColorOk and _volOk
    bool _lowerBreak = _active and _typeOk and _brokeDir == 0 and _linesValid and close < _lowerNow - _atr * _pTriBreakBufferATR and _bodyOk and _loColorOk and _volOk
    if _upperBreak
        _brokeDir := 1
    if _lowerBreak
        _brokeDir := -1

    // 上限上抜け → LONG（Ascブレイク / Desc否定）/ 下限下抜け → SHORT（Descブレイク / Asc否定）
    // 同一足で両方確定した場合も両方のイベントを返す（方向の裁定は POINT MASTER §6）
    [_upperBreak, _lowerBreak]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic19 = Horizontal Rebound / Logic20 = Horizontal Break
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + 水平線 環境認識ストラテジー」の水平線モジュール
// （f_lineEnvAddZone / f_lineEnvMergeZone / f_lineEnvSession / f_lineEnvCommonOK と
// A:反発 / C:ブレイク の判定式）と同一です。移植したのは次の部分だけです。
//   ・水平線ソース : 前日 高値/安値（確定前日値のみ）＋ セッション 高値/安値（終了後の確定値のみ）
//     セッションは Asia / London / New York。時間・Timezone は元コードと同じ input です。
//   ・近い水平線は別々に扱わず、タッチ数の加重平均で1つの水平ゾーンへ統合（統合許容幅 = ATR倍率）
//   ・ゾーン幅（ATR連動 / 固定）付きの最近接 Support（close以下）/ Resistance（closeより上）
//   ・A: 反発（ゾーン接触 + 回復位置モード + 方向/ヒゲ/実体率/ATR の共通ローソク品質）
//   ・C: ブレイク（確定終値 + ゾーン幅 + ATRバッファ + 実体率 + 任意でブレイク足の色）
//
// ★ Pivot High/Low、複数回反応価格帯（Reaction Zone）、Flip、Sweep、障害物NoTrade、
//   強度（Strength）によるスコア倍率、MTF統合（WeightedScore / HigherTF）、独自bias・独自保持、
//   テーブル / ラベル / 水平線描画は移植していません（今回の仕様どおり）。
//   強度はポイント倍率に一切使いません。前日だけ / セッションだけ / 両方が重なったゾーンでも
//   Logic19 / Logic20 の Weight は同じです。
//
// 1ゾーン = 1イベント源です。前日高値と London High と NY High が近接していても
// 統合後の1ゾーンから Logic19 は1回、Logic20 は1回しかイベントを出しません。
//
//   Logic19 : Support反発 → LONG / Resistance反発 → SHORT（単なる接触では発火しない）
//   Logic20 : Resistance上抜け → LONG / Support下抜け → SHORT（確定終値のみ。ヒゲ抜けは無効）
//             ブレイク後は「そのブレイクした同じゾーン」（価格 / 上限 / 下限 / 方向）を保存し、
//             確定終値がゾーンの反対側へ戻った足で逆方向イベントを出します。
//               上抜け後にゾーン下側へ確定 → SHORT（POINT MASTER側で LONG解除 → SHORT切替）
//               下抜け後にゾーン上側へ確定 → LONG （POINT MASTER側で SHORT解除 → LONG切替）
//             追跡中は別ゾーンのブレイクを検出してもイベントを出さず、追跡対象も差し替えません。
//             戻りで追跡が終わった後は、次の新規ブレイクを再び受け付けます。
//             ブレイク対象は「前バーで最近接だったゾーン」なので、現在足に最近接Resistance /
//             Support が残っているかどうかはブレイク成立条件に入れません。
//
// Logic19 と Logic20 は完全に独立したロジックです（互いのイベントで相手を解除しません）。
// 出力はイベント4値のみで、保持・期限・同方向再発生・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
// 非リペイント：前日H/Lは確定前日値のみ、セッションH/Lは終了後の確定値のみを使います
// （形成中セッションの動くHigh/Lowでは判定しません）。
grpHz = "④ Logic19/20 : Horizontal パラメータ"
useHzPrevDayHL   = input.bool(true,  "水平線ソース : 前日 高値/安値",       group = grpHz)
useHzSessionHL   = input.bool(true,  "水平線ソース : セッション 高値/安値", group = grpHz)
hzAtrLen         = input.int(14,     "ATR期間",                            group = grpHz, minval = 1)
hzMaxZones       = input.int(20,     "水平ゾーン 最大保持数",               group = grpHz, minval = 1, maxval = 60)
useHzMergeZone   = input.bool(true,  "近い水平線をゾーン統合する",           group = grpHz)
hzMergeToleranceATR = input.float(0.5, "統合許容幅 ATR倍率",                group = grpHz, minval = 0.0, step = 0.05)
useHzATRZone     = input.bool(true,  "ゾーン幅をATR連動にする",             group = grpHz)
hzZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率",                   group = grpHz, minval = 0.0, step = 0.05)
hzZoneFixedWidth = input.float(0.0,  "ゾーン幅 固定",                      group = grpHz, minval = 0.0, step = 0.1)
hzSessTZ         = input.string("GMT",         "セッション タイムゾーン",    group = grpHz)
hzAsiaSess       = input.session("0000-0800",  "Asia",                     group = grpHz)
hzLondonSess     = input.session("0700-1600",  "London",                   group = grpHz)
hzNySess         = input.session("1200-2100",  "New York",                 group = grpHz)
hzBounceRecoverMode = input.string("Center", "反発 回復位置", options = ["Center", "OuterEdge", "PreviousCloseSide"], group = grpHz)
useHzDirCandleFilter = input.bool(true,  "反発 方向ローソク",  group = grpHz)
useHzWickFilter      = input.bool(false, "反発 ヒゲ確認",      group = grpHz)
useHzBodyFilter      = input.bool(false, "反発 実体率",        group = grpHz)
useHzATRFilter       = input.bool(false, "反発 ATR(値幅)",     group = grpHz)
hzBodyRatioMin       = input.float(0.3, "反発 実体率 最小",     group = grpHz, minval = 0.0, maxval = 1.0, step = 0.05)
hzAtrMinMult         = input.float(0.5, "反発 最小値幅 ATR倍率", group = grpHz, minval = 0.0, step = 0.05)
hzEventRearmMode = input.string("LeaveZone", "反発 再アーム", options = ["LeaveZone", "Bars", "LeaveZoneOrBars"], group = grpHz)
hzEventRearmATR  = input.float(0.5, "反発 再アーム ゾーン離脱 ATR倍率", group = grpHz, minval = 0.0, step = 0.05)
hzEventRearmBars = input.int(3,     "反発 再アーム 最低本数",            group = grpHz, minval = 1)
hzBreakBufferATR = input.float(0.05, "ブレイク バッファ ATR倍率",        group = grpHz, minval = 0.0, step = 0.05)
useHzBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター",        group = grpHz)
hzBreakBodyRatio     = input.float(0.5, "ブレイク 実体率最小",           group = grpHz, minval = 0.0, maxval = 1.0, step = 0.05)
useHzBreakCandleColor = input.bool(false, "ブレイク 方向ローソク色を要求", group = grpHz)

// --- Logic19/20 Horizontal のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_HZ = array.from(
     useHzPrevDayHL ? 1.0 : 0.0,                                                              // 00 : useHzPrevDayHL
     useHzSessionHL ? 1.0 : 0.0,                                                              // 01 : useHzSessionHL
     hzMaxZones * 1.0,                                                                        // 02 : hzMaxZones
     useHzMergeZone ? 1.0 : 0.0,                                                              // 03 : useHzMergeZone
     hzMergeToleranceATR,                                                                     // 04 : hzMergeToleranceATR
     useHzATRZone ? 1.0 : 0.0,                                                                // 05 : useHzATRZone
     hzZoneATRMult,                                                                           // 06 : hzZoneATRMult
     hzZoneFixedWidth,                                                                        // 07 : hzZoneFixedWidth
     hzBounceRecoverMode == "Center" ? 0.0 : hzBounceRecoverMode == "OuterEdge" ? 1.0 : 2.0,  // 08 : hzBounceRecoverMode
     useHzDirCandleFilter ? 1.0 : 0.0,                                                        // 09 : useHzDirCandleFilter
     useHzWickFilter ? 1.0 : 0.0,                                                             // 10 : useHzWickFilter
     useHzBodyFilter ? 1.0 : 0.0,                                                             // 11 : useHzBodyFilter
     useHzATRFilter ? 1.0 : 0.0,                                                              // 12 : useHzATRFilter
     hzBodyRatioMin,                                                                          // 13 : hzBodyRatioMin
     hzAtrMinMult,                                                                            // 14 : hzAtrMinMult
     hzEventRearmMode == "LeaveZone" ? 0.0 : hzEventRearmMode == "Bars" ? 1.0 : 2.0,          // 15 : hzEventRearmMode
     hzEventRearmATR,                                                                         // 16 : hzEventRearmATR
     hzEventRearmBars * 1.0,                                                                  // 17 : hzEventRearmBars
     hzBreakBufferATR,                                                                        // 18 : hzBreakBufferATR
     useHzBreakBodyFilter ? 1.0 : 0.0,                                                        // 19 : useHzBreakBodyFilter
     hzBreakBodyRatio,                                                                        // 20 : hzBreakBodyRatio
     useHzBreakCandleColor ? 1.0 : 0.0                                                        // 21 : useHzBreakCandleColor
 )

// --- 元コードと同一の補助関数 ---
// 共通ローソク品質（方向 / ヒゲ / 実体率 / ATR。各OFFなら影響しない）
f_hzCommonOK(_isBuy, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pUseHzDirCandleFilter   = array.get(PRM_HZ, 9) > 0.5
    bool  _pUseHzWickFilter        = array.get(PRM_HZ, 10) > 0.5
    bool  _pUseHzBodyFilter        = array.get(PRM_HZ, 11) > 0.5
    bool  _pUseHzATRFilter         = array.get(PRM_HZ, 12) > 0.5
    float _pHzBodyRatioMin         = array.get(PRM_HZ, 13)
    float _pHzAtrMinMult           = array.get(PRM_HZ, 14)
    float _rng  = high - low
    float _body = math.abs(close - open)
    float _upW  = high - math.max(close, open)
    float _dnW  = math.min(close, open) - low
    float _bRatio = _rng > 0 ? _body / _rng : 0.0
    bool _ok = true
    if _pUseHzDirCandleFilter
        _ok := _ok and (_isBuy ? close > open : close < open)
    if _pUseHzWickFilter
        _ok := _ok and (_isBuy ? _dnW >= _body : _upW >= _body)
    if _pUseHzBodyFilter
        _ok := _ok and _bRatio >= _pHzBodyRatioMin
    if _pUseHzATRFilter
        _ok := _ok and _rng >= _atr * _pHzAtrMinMult
    _ok

// 水平ゾーンへ追加 / 統合（近接があればタッチ数の加重平均で統合。無ければ push。上限超過で最古を削除）
f_hzAddZone(array<float> _zP, array<int> _zT, array<int> _zCB, _p, _mergeTol) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pHzMaxZones             = int(array.get(PRM_HZ, 2))
    int _idx = -1
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if _idx == -1 and math.abs(array.get(_zP, _i) - _p) <= _mergeTol
                _idx := _i
    if _idx >= 0
        int _oldT = array.get(_zT, _idx)
        int _newT = _oldT + 1
        array.set(_zP, _idx, (array.get(_zP, _idx) * _oldT + _p) / _newT)
        array.set(_zT, _idx, _newT)
    else
        array.push(_zP, _p)
        array.push(_zT, 1)
        array.push(_zCB, bar_index)
        while array.size(_zP) > _pHzMaxZones
            array.shift(_zP)
            array.shift(_zT)
            array.shift(_zCB)
    array.size(_zP)

// セッション 高値/安値 追跡（終了時に確定・[hi, lo, ended]）
f_hzSession(_sessStr, _prevHi, _prevLo) =>
    bool _inSess  = not na(time(timeframe.period, _sessStr, hzSessTZ))
    bool _started = _inSess and not _inSess[1]
    bool _ended   = not _inSess and _inSess[1]
    float _hi = _prevHi
    float _lo = _prevLo
    if _started
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(_prevHi) ? high : math.max(_prevHi, high)
        _lo := na(_prevLo) ? low  : math.min(_prevLo, low)
    [_hi, _lo, _ended]

// 反発イベントの再アーム（同じゾーンで毎足発火させないため。ゾーン離脱 / 経過本数）
f_hzRearmOK(_bar, _price, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pHzEventRearmMode       = int(array.get(PRM_HZ, 15))
    float _pHzEventRearmATR        = array.get(PRM_HZ, 16)
    int   _pHzEventRearmBars       = int(array.get(PRM_HZ, 17))
    bool _leftZone = not na(_price) and math.abs(close - _price) >= _atr * _pHzEventRearmATR
    bool _barsOk   = not na(_bar) and (bar_index - _bar) >= _pHzEventRearmBars
    _pHzEventRearmMode == 0 ? _leftZone : _pHzEventRearmMode == 1 ? _barsOk : (_leftZone or _barsOk)

f_horizontalEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pUseHzPrevDayHL         = array.get(PRM_HZ, 0) > 0.5
    bool  _pUseHzSessionHL         = array.get(PRM_HZ, 1) > 0.5
    bool  _pUseHzMergeZone         = array.get(PRM_HZ, 3) > 0.5
    float _pHzMergeToleranceATR    = array.get(PRM_HZ, 4)
    bool  _pUseHzATRZone           = array.get(PRM_HZ, 5) > 0.5
    float _pHzZoneATRMult          = array.get(PRM_HZ, 6)
    float _pHzZoneFixedWidth       = array.get(PRM_HZ, 7)
    int   _pHzBounceRecoverMode    = int(array.get(PRM_HZ, 8))
    float _pHzBreakBufferATR       = array.get(PRM_HZ, 18)
    bool  _pUseHzBreakBodyFilter   = array.get(PRM_HZ, 19) > 0.5
    float _pHzBreakBodyRatio       = array.get(PRM_HZ, 20)
    bool  _pUseHzBreakCandleColor  = array.get(PRM_HZ, 21) > 0.5
    float _atr = ta.atr(hzAtrLen)
    float _zoneW = _pUseHzATRZone ? _atr * _pHzZoneATRMult : _pHzZoneFixedWidth
    float _mergeTol = _pUseHzMergeZone ? _atr * _pHzMergeToleranceATR : 0.0
    // 統合ゾーン配列（var: 呼び出しコンテキスト＝TFごとに独立）
    var array<float> _zP  = array.new_float()   // ゾーン価格（統合時は加重平均）
    var array<int>   _zT  = array.new_int()     // 統合回数（加重平均用）
    var array<int>   _zCB = array.new_int()     // 生成バー（生成前のバーでは使わない）

    // --- ① 前日 高値/安値（確定前日値のみ）---
    var float _curDayHigh = na
    var float _curDayLow  = na
    var float _prevHigh   = na
    var float _prevLow    = na
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        _prevHigh := _curDayHigh
        _prevLow  := _curDayLow
        _curDayHigh := high
        _curDayLow  := low
        if _pUseHzPrevDayHL and not na(_prevHigh)
            f_hzAddZone(_zP, _zT, _zCB, _prevHigh, _mergeTol)
        if _pUseHzPrevDayHL and not na(_prevLow)
            f_hzAddZone(_zP, _zT, _zCB, _prevLow, _mergeTol)
    else
        _curDayHigh := na(_curDayHigh) ? high : math.max(_curDayHigh, high)
        _curDayLow  := na(_curDayLow)  ? low  : math.min(_curDayLow, low)

    // --- ② セッション 高値/安値（そのセッションが終了して確定した足で登録）---
    var float _asiaHigh   = na
    var float _asiaLow    = na
    var float _londonHigh = na
    var float _londonLow  = na
    var float _nyHigh     = na
    var float _nyLow      = na
    [_aH, _aL, _aEnd] = f_hzSession(hzAsiaSess, _asiaHigh, _asiaLow)
    _asiaHigh := _aH
    _asiaLow  := _aL
    [_lH, _lL, _lEnd] = f_hzSession(hzLondonSess, _londonHigh, _londonLow)
    _londonHigh := _lH
    _londonLow  := _lL
    [_nH, _nL, _nEnd] = f_hzSession(hzNySess, _nyHigh, _nyLow)
    _nyHigh := _nH
    _nyLow  := _nL
    if _pUseHzSessionHL
        if _aEnd and not na(_asiaHigh)
            f_hzAddZone(_zP, _zT, _zCB, _asiaHigh, _mergeTol)
        if _aEnd and not na(_asiaLow)
            f_hzAddZone(_zP, _zT, _zCB, _asiaLow, _mergeTol)
        if _lEnd and not na(_londonHigh)
            f_hzAddZone(_zP, _zT, _zCB, _londonHigh, _mergeTol)
        if _lEnd and not na(_londonLow)
            f_hzAddZone(_zP, _zT, _zCB, _londonLow, _mergeTol)
        if _nEnd and not na(_nyHigh)
            f_hzAddZone(_zP, _zT, _zCB, _nyHigh, _mergeTol)
        if _nEnd and not na(_nyLow)
            f_hzAddZone(_zP, _zT, _zCB, _nyLow, _mergeTol)

    // --- ③ 最近接 Support（close以下）/ Resistance（closeより上）---
    float _nSupP = na
    float _nResP = na
    int   _nSupCB = na
    int   _nResCB = na
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if bar_index >= array.get(_zCB, _i)
                float _pr = array.get(_zP, _i)
                if _pr <= close
                    if na(_nSupP) or _pr > _nSupP
                        _nSupP := _pr
                        _nSupCB := array.get(_zCB, _i)
                else
                    if na(_nResP) or _pr < _nResP
                        _nResP := _pr
                        _nResCB := array.get(_zCB, _i)
    float _supZoneTop = _nSupP + _zoneW
    float _resZoneBot = _nResP - _zoneW
    bool _supUsable = not na(_nSupP) and not na(_nSupCB) and bar_index >= _nSupCB
    bool _resUsable = not na(_nResP) and not na(_nResCB) and bar_index >= _nResCB

    // --- ④ Logic19 : 反発（ゾーン接触 + 回復位置 + 共通ローソク品質）---
    float _buyRecover  = _pHzBounceRecoverMode == 1 ? _supZoneTop : _nSupP
    float _sellRecover = _pHzBounceRecoverMode == 1 ? _resZoneBot : _nResP
    bool _buyBounce  = _supUsable and low  <= _supZoneTop and close > _buyRecover  and (_pHzBounceRecoverMode != 2 or close[1] <= _supZoneTop) and f_hzCommonOK(true, _atr)
    bool _sellBounce = _resUsable and high >= _resZoneBot and close < _sellRecover and (_pHzBounceRecoverMode != 2 or close[1] >= _resZoneBot) and f_hzCommonOK(false, _atr)
    // 同じゾーンで毎足発火させない（ゾーンが変われば別イベントとして発火可能）
    var int   _armBuyZone  = na
    var int   _armSellZone = na
    var int   _armBuyBar   = na
    var int   _armSellBar  = na
    var float _armBuyP     = na
    var float _armSellP    = na
    int _supId = na(_nSupP) ? na : int(math.round(_nSupP / syminfo.mintick))
    int _resId = na(_nResP) ? na : int(math.round(_nResP / syminfo.mintick))
    bool _buyArmOk  = na(_armBuyZone)  or _armBuyZone  != _supId or f_hzRearmOK(_armBuyBar,  _armBuyP,  _atr)
    bool _sellArmOk = na(_armSellZone) or _armSellZone != _resId or f_hzRearmOK(_armSellBar, _armSellP, _atr)
    bool _l19Long  = _buyBounce  and _buyArmOk
    bool _l19Short = _sellBounce and _sellArmOk
    if _l19Long
        _armBuyZone := _supId
        _armBuyBar  := bar_index
        _armBuyP    := _nSupP
    if _l19Short
        _armSellZone := _resId
        _armSellBar  := bar_index
        _armSellP    := _nResP

    // --- ⑤ Logic20 : ブレイク（確定終値のみ。前バーの最近接ゾーンを対象にする）---
    var float _prevSupP = na      // 前バーの最近接Support（[1] の代わりに明示保持）
    var float _prevResP = na      // 前バーの最近接Resistance
    bool _breakBodyOK = not _pUseHzBreakBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= _pHzBreakBodyRatio)
    float _brkBuf = _atr * _pHzBreakBufferATR
    //   ブレイク対象は「前バーで最近接だったゾーン」です。現在足で最上位Resistance / 最下位Support が
    //   無くなっても正しい抜けが消えないよう、現在足の _resUsable / _supUsable は条件に入れません。
    bool _buyBreak  = not na(_prevResP) and close > _prevResP + _zoneW + _brkBuf and close[1] <= _prevResP + _zoneW + _brkBuf and _breakBodyOK and (not _pUseHzBreakCandleColor or close > open)
    bool _sellBreak = not na(_prevSupP) and close < _prevSupP - _zoneW - _brkBuf and close[1] >= _prevSupP - _zoneW - _brkBuf and _breakBodyOK and (not _pUseHzBreakCandleColor or close < open)

    // --- ⑥ ブレイクした「同じゾーン」を保存して戻りを追跡 ---
    //   追跡中（_brkDir != 0）は別ゾーンのブレイクを Logic20 イベントにしません。
    //   追跡中に出せるのは「保存した同じゾーンへ確定終値で戻った時の逆方向イベント」だけです。
    //   戻りで追跡が終了（_brkDir = 0）したら、次の新規ブレイクを再び受け付けます。
    var float _brkZoneP   = na
    var float _brkZoneTop = na
    var float _brkZoneBot = na
    var int   _brkDir     = 0     // 1 = 上抜け追跡中 / -1 = 下抜け追跡中 / 0 = 追跡なし
    int _brkDirPrev = _brkDir     // このバー開始時の追跡状態（新規ブレイクを採用してよいかの判定用）
    // 保存済みゾーンへ確定終値で戻ったら逆方向イベント（ヒゲだけの戻りは無効）
    bool _brkFailShort = _brkDir == 1  and not na(_brkZoneBot) and close < _brkZoneBot
    bool _brkFailLong  = _brkDir == -1 and not na(_brkZoneTop) and close > _brkZoneTop
    if _brkFailShort or _brkFailLong
        _brkDir     := 0
        _brkZoneP   := na
        _brkZoneTop := na
        _brkZoneBot := na
    // 新規ブレイクをイベントとして採用するのは「追跡していない時」だけ
    bool _newBuyBreak  = _buyBreak  and _brkDirPrev == 0
    bool _newSellBreak = _sellBreak and _brkDirPrev == 0
    if _newBuyBreak
        _brkZoneP   := _prevResP
        _brkZoneTop := _prevResP + _zoneW
        _brkZoneBot := _prevResP - _zoneW
        _brkDir     := 1
    else if _newSellBreak
        _brkZoneP   := _prevSupP
        _brkZoneTop := _prevSupP + _zoneW
        _brkZoneBot := _prevSupP - _zoneW
        _brkDir     := -1

    bool _l20Long  = _newBuyBreak  or _brkFailLong    // Resistance上抜け / 下抜けたゾーン上側への終値復帰
    bool _l20Short = _newSellBreak or _brkFailShort   // Support下抜け / 上抜けたゾーン下側への終値復帰

    // 次バー用に今バーの最近接ゾーンを保存
    _prevSupP := _nSupP
    _prevResP := _nResP

    [_l19Long, _l19Short, _l20Long, _l20Short]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic21 = Fib 38.2 / Logic22 = Fib 50.0 / Logic23 = Fib 61.8 Rebound
// -------------------------------------------------------------------------------------
// 採用波の検出は元「トレンド + フィボナッチ 環境認識ストラテジー」の f_fibEnvState と同一です。
//   ・確定Pivot High / Low のみ使用（未確定Pivotでは採用波を変えない）
//   ・上げ波候補 = 確定Pivot Low → その後の確定Pivot High（波幅 >= ATR×倍率 かつ 継続バー数 >= 最低）
//   ・下げ波候補 = 確定Pivot High → その後の確定Pivot Low（完全対称）
//   ・同方向継続中は起点(origin)を固定し、extreme を更新する確定Pivotが出たときだけ終点を更新
//   ・反転 = 反対方向の構造ブレイク(BOS)付きの新波、または起点の終値突破（ヒゲ無視）
//   ・小さな内部波では採用波を切り替えない（「直近高値と安値だけで引く」簡略化はしていません）
//
// ★ 移植していないもの：MTF統合 / WeightedScore / HigherTF / Fib bias保持 / Fib帯にいるだけの
//   方向判定 / エントリー範囲 input / strategy.entry / SL・TP / テーブル / Fib描画 / ラベル / デバッグ。
//
// Fib価格は現在の採用波（起点固定・終点は更新に追従）から毎バー再計算します。
//   price(r) = extreme + r × (origin - extreme)
//   上げ波：origin = Swing Low(0%) / extreme = Swing High(100%) → 押しが深いほど価格は下
//   下げ波：origin = Swing High(0%) / extreme = Swing Low(100%) → 戻しが深いほど価格は上
//
// 【最深到達レベル優先】同一TF・同一採用波では、到達済みの最も深いレベルだけが有効候補です。
//   到達判定はヒゲ（上げ波 = low、下げ波 = high）、Rebound確定は終値です。
//     38.2到達（50未到達） → Logic21 のみ判定
//     50到達               → Logic21 失効、Logic22 のみ判定
//     61.8到達             → Logic21 / 22 失効、Logic23 のみ判定
//     78.6到達             → Logic21 / 22 / 23 すべて失効（イベントなし）
//   深いレベル到達後に浅いFibへ価格が戻っても、浅いLogicは再発火しません。
//   同一採用波では各レベル1回だけ発火します（使用済みフラグ）。
//   「到達」は候補レベルの決定、「終値回復」が実際のReboundイベントです。
//   処理順は ①最深到達レベル更新 → ②浅いFibの解除フラグ → ③最深レベルのRebound判定 です。
//
// 採用波が変わった時（方向転換 / 新しい有効波）だけ、最深到達レベルと使用済みフラグをリセットします。
// Wave ID = 方向 + 起点バー + 起点価格。終点(extreme)の更新だけではリセットしません。
// 上げ波は LONG のみ、下げ波は SHORT のみ（逆張りイベントは出しません）。
// 出力はイベント6値 + Fib解除3値で、保持・期限・切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpFib = "④ Logic21〜23 : Fib パラメータ"
fibAtrLen          = input.int(14,   "ATR期間",                          group = grpFib, minval = 1)
fibSwingLen        = input.int(6,    "スイング検出 左右本数 (Pivot Length)", group = grpFib, minval = 1)
fibMinSwingAtrMult = input.float(5.0, "最低波幅 (ATR倍)",                 group = grpFib, minval = 0.1, step = 0.1)
fibMinWaveBars     = input.int(12,   "最低波継続バー数",                  group = grpFib, minval = 1)
fibRequireBOS      = input.bool(true, "直近構造ブレイク(BOS)を要求",       group = grpFib)

// --- Logic21〜23 Fib のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_FIB = array.from(
     fibMinSwingAtrMult,         // 00 : fibMinSwingAtrMult
     fibMinWaveBars * 1.0,       // 01 : fibMinWaveBars
     fibRequireBOS ? 1.0 : 0.0   // 02 : fibRequireBOS
 )

f_fibEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pFibMinSwingAtrMult     = array.get(PRM_FIB, 0)
    int   _pFibMinWaveBars         = int(array.get(PRM_FIB, 1))
    bool  _pFibRequireBOS          = array.get(PRM_FIB, 2) > 0.5
    float _atr = ta.atr(fibAtrLen)
    float _ph  = ta.pivothigh(high, fibSwingLen, fibSwingLen)
    float _pl  = ta.pivotlow(low,  fibSwingLen, fibSwingLen)
    float _minSwing = _atr * _pFibMinSwingAtrMult
    // 直近Pivot（価格 / bar）と1つ前Pivot価格（BOS判定用）
    var float _lastPHp = na
    var int   _lastPHb = na
    var float _prevPHp = na
    var float _lastPLp = na
    var int   _lastPLb = na
    var float _prevPLp = na
    // 現在採用中の波（起点固定・終点のみ更新）
    var int   _state      = 0
    var float _origin     = na
    var float _extreme    = na
    var int   _originBar  = na
    var int   _extremeBar = na
    bool _reversal = false
    // Pivot 更新（1つ前を退避してから最新を格納）
    if not na(_ph)
        _prevPHp := _lastPHp
        _lastPHp := _ph
        _lastPHb := bar_index - fibSwingLen
    if not na(_pl)
        _prevPLp := _lastPLp
        _lastPLp := _pl
        _lastPLb := bar_index - fibSwingLen
    // --- Bull波候補（新Pivot High確定 : 先行するPivot Low → 今回のPivot High = 上げ波）---
    if not na(_ph) and not na(_lastPLp) and _lastPLb < _lastPHb
        float _w    = _lastPHp - _lastPLp
        int   _bars = _lastPHb - _lastPLb
        bool _sizeOk = _w >= _minSwing and _bars >= _pFibMinWaveBars
        bool _bosUp  = na(_prevPHp) or _lastPHp > _prevPHp
        if _sizeOk
            if _state == -1
                // 方向反転 Bear→Bull: 上方向の構造ブレイクを必須
                if _bosUp
                    _state := 1
                    _origin := _lastPLp
                    _extreme := _lastPHp
                    _originBar := _lastPLb
                    _extremeBar := _lastPHb
                    _reversal := true
            else if _state == 0
                if not _pFibRequireBOS or _bosUp
                    _state := 1
                    _origin := _lastPLp
                    _extreme := _lastPHp
                    _originBar := _lastPLb
                    _extremeBar := _lastPHb
    // --- Bull継続中の終点(extreme)更新（origin固定・確定Pivot Highのみ・追加条件なし）---
    if _state == 1 and not na(_ph)
        if na(_extreme) or _lastPHp > _extreme
            _extreme := _lastPHp
            _extremeBar := _lastPHb
    // --- Bear波候補（新Pivot Low確定 : 先行するPivot High → 今回のPivot Low = 下げ波）---
    if not na(_pl) and not na(_lastPHp) and _lastPHb < _lastPLb
        float _w    = _lastPHp - _lastPLp
        int   _bars = _lastPLb - _lastPHb
        bool _sizeOk = _w >= _minSwing and _bars >= _pFibMinWaveBars
        bool _bosDn  = na(_prevPLp) or _lastPLp < _prevPLp
        if _sizeOk
            if _state == 1
                // 方向反転 Bull→Bear: 下方向の構造ブレイクを必須
                if _bosDn
                    _state := -1
                    _origin := _lastPHp
                    _extreme := _lastPLp
                    _originBar := _lastPHb
                    _extremeBar := _lastPLb
                    _reversal := true
            else if _state == 0
                if not _pFibRequireBOS or _bosDn
                    _state := -1
                    _origin := _lastPHp
                    _extreme := _lastPLp
                    _originBar := _lastPHb
                    _extremeBar := _lastPLb
    // --- Bear継続中の終点(extreme)更新（origin固定・確定Pivot Lowのみ・追加条件なし）---
    if _state == -1 and not na(_pl)
        if na(_extreme) or _lastPLp < _extreme
            _extreme := _lastPLp
            _extremeBar := _lastPLb
    // --- 起点の終値突破による即時反転（ヒゲ無視。旧extremeを新origin・突破足の高安を新extreme）---
    if not _reversal and _state == 1 and not na(_origin) and close < _origin
        _state := -1
        _origin := na(_extreme) ? _origin : _extreme
        _originBar := na(_extremeBar) ? _originBar : _extremeBar
        _extreme := low
        _extremeBar := bar_index
        _reversal := true
    else if not _reversal and _state == -1 and not na(_origin) and close > _origin
        _state := 1
        _origin := na(_extreme) ? _origin : _extreme
        _originBar := na(_extremeBar) ? _originBar : _extremeBar
        _extreme := high
        _extremeBar := bar_index
        _reversal := true

    // --- Wave ID（方向 + 起点バー + 起点価格）。終点更新だけでは変わらない ---
    var int   _wState     = 0
    var int   _wOriginBar = na
    var float _wOriginP   = na
    var int   _deep       = 0        // 最深到達 : 0=未到達 / 1=38.2 / 2=50 / 3=61.8 / 4=78.6
    var bool  _used382    = false
    var bool  _used500    = false
    var bool  _used618    = false
    bool _newWave = _state != _wState or nz(_originBar, -1) != nz(_wOriginBar, -1) or nz(_origin, -1e12) != nz(_wOriginP, -1e12)
    if _newWave
        _wState     := _state
        _wOriginBar := _originBar
        _wOriginP   := _origin
        _deep       := 0
        _used382    := false
        _used500    := false
        _used618    := false

    // --- Fib価格（現在の採用波から毎バー再計算）---
    bool _waveOk = _state != 0 and not na(_origin) and not na(_extreme) and _origin != _extreme
    float _f382 = _waveOk ? _extreme + 0.382 * (_origin - _extreme) : na
    float _f500 = _waveOk ? _extreme + 0.500 * (_origin - _extreme) : na
    float _f618 = _waveOk ? _extreme + 0.618 * (_origin - _extreme) : na
    float _f786 = _waveOk ? _extreme + 0.786 * (_origin - _extreme) : na

    // --- ① 到達判定（ヒゲ）→ 最深到達レベル更新 ---
    bool _t382 = _waveOk and (_state == 1 ? low <= _f382 : high >= _f382)
    bool _t500 = _waveOk and (_state == 1 ? low <= _f500 : high >= _f500)
    bool _t618 = _waveOk and (_state == 1 ? low <= _f618 : high >= _f618)
    bool _t786 = _waveOk and (_state == 1 ? low <= _f786 : high >= _f786)
    int _newDeep = _t786 ? 4 : _t618 ? 3 : _t500 ? 2 : _t382 ? 1 : 0
    if _waveOk and _newDeep > _deep
        _deep := _newDeep

    // --- ② 浅いFibロジックの解除情報（深い到達で上位ロジックを解除）---
    bool _inv21 = _deep >= 2       // 50到達 → Logic21解除
    bool _inv22 = _deep >= 3       // 61.8到達 → Logic22も解除
    bool _inv23 = _deep >= 4       // 78.6到達 → Logic23も解除

    // --- ③ 最深レベルのRebound判定（終値回復・同一採用波につき各レベル1回）---
    float _lvlP  = _deep == 1 ? _f382 : _deep == 2 ? _f500 : _deep == 3 ? _f618 : na
    bool  _usedNow = _deep == 1 ? _used382 : _deep == 2 ? _used500 : _deep == 3 ? _used618 : true
    bool  _recovered = _waveOk and not na(_lvlP) and (_state == 1 ? close > _lvlP : close < _lvlP)
    bool  _fire = _waveOk and _deep >= 1 and _deep <= 3 and not _usedNow and _recovered
    if _fire
        if _deep == 1
            _used382 := true
        else if _deep == 2
            _used500 := true
        else
            _used618 := true
    // 上げ波は LONG のみ / 下げ波は SHORT のみ（同一足で複数Logicが発火することはない）
    bool _l21Long  = _fire and _deep == 1 and _state == 1
    bool _l21Short = _fire and _deep == 1 and _state == -1
    bool _l22Long  = _fire and _deep == 2 and _state == 1
    bool _l22Short = _fire and _deep == 2 and _state == -1
    bool _l23Long  = _fire and _deep == 3 and _state == 1
    bool _l23Short = _fire and _deep == 3 and _state == -1
    [_l21Long, _l21Short, _l22Long, _l22Short, _l23Long, _l23Short, _inv21, _inv22, _inv23]

// -------------------------------------------------------------------------------------
// LONG / SHORT の bool 配列 → ビットマスク（Engine A / B / C 共通）
// -------------------------------------------------------------------------------------
// ビット位置は「そのEngine内での通し番号（0始まり）」です。
// Engine をまたぐ元のロジック番号への対応は §6 で行います。
f_packMasks(longs, shorts) =>
    float lm = 0.0
    float sm = 0.0
    for i = 0 to array.size(longs) - 1
        float bit = math.pow(2, i)
        lm += array.get(longs,  i) ? bit : 0.0
        sm += array.get(shorts, i) ? bit : 0.0
    [lm, sm]

// =====================================================================================
// Engine A : Logic01〜12（FVG Absorption / FVG Rebound / Accum / EMA）
// =====================================================================================
f_signalMasksA() =>
    // -------------------------------------------------------------------------------
    // ▼▼▼ ここから：Engine A のロジック判定 ▼▼▼
    // -------------------------------------------------------------------------------
    // Logic01 : FVG Absorption（吸収が新規発生した確定足だけ true。保持は POINT MASTER 側）
    [l01Long, l01Short] = f_fvgAbsEvent()

    // Logic02 : FVG Rebound（反発が新規発生した確定足だけ true。保持は POINT MASTER 側）
    [l02Long, l02Short] = f_fvgReboundEvent()

    // Logic03 : Accum Rebound / Logic04 : Accum Break
    // （同じAccum箱の状態から2ロジック分のイベントを取得。互いに独立したロジックとして扱う）
    [l03Long, l03Short, l04Long, l04Short] = f_accumEvents()

    // Logic05〜12 : EMA200/1000/2000/3000 の Rebound(05〜08) と Break(09〜12)
    // EMAロジックは1M・5M（TFスロット1・2）だけを対象にする
    bool _emaTfOk = timeframe.in_seconds() == timeframe.in_seconds(tfStr1) or timeframe.in_seconds() == timeframe.in_seconds(tfStr2)
    float _emaAtr = ta.atr(emaTolAtrLen)
    float _emaA = ta.ema(close, emaLenA)
    float _emaB = ta.ema(close, emaLenB)
    float _emaC = ta.ema(close, emaLenC)
    float _emaD = ta.ema(close, emaLenD)
    [l05Long, l05Short, l09Long, l09Short] = f_emaEvents(_emaTfOk, _emaA, _emaA[1], _emaAtr)
    [l06Long, l06Short, l10Long, l10Short] = f_emaEvents(_emaTfOk, _emaB, _emaB[1], _emaAtr)
    [l07Long, l07Short, l11Long, l11Short] = f_emaEvents(_emaTfOk, _emaC, _emaC[1], _emaAtr)
    [l08Long, l08Short, l12Long, l12Short] = f_emaEvents(_emaTfOk, _emaD, _emaD[1], _emaAtr)

    // ★Engine A へロジックを追加する時はここに定義し、下の array.from と ENG_A_N を更新する
    // -------------------------------------------------------------------------------
    // ▲▲▲ ここまで（Engine A）▲▲▲
    // -------------------------------------------------------------------------------
    // Engine A 内のビット順（0始まり）= Logic01, 02, ..., 12
    longsA  = array.from(l01Long,  l02Long,  l03Long,  l04Long,  l05Long,  l06Long,  l07Long,  l08Long,  l09Long,  l10Long,  l11Long,  l12Long)
    shortsA = array.from(l01Short, l02Short, l03Short, l04Short, l05Short, l06Short, l07Short, l08Short, l09Short, l10Short, l11Short, l12Short)
    [lmA, smA] = f_packMasks(longsA, shortsA)
    [lmA, smA]

// =====================================================================================
// Engine B : Logic13〜18（Trendline / H&S / DT/DB / Wedge / Triangle）
// =====================================================================================
f_signalMasksB() =>
    // -------------------------------------------------------------------------------
    // ▼▼▼ ここから：Engine B のロジック判定 ▼▼▼
    // -------------------------------------------------------------------------------
    // Logic13 : Trendline Rebound / Logic14 : Trendline Break（同じTrendline状態から両方を取得）
    [l13Long, l13Short, l14Long, l14Short] = f_trendlineEvents()

    // Logic15 : H&S Pattern（逆三尊ネックライン上抜け = LONG / 三尊ネックライン下抜け = SHORT）
    [l15Long, l15Short] = f_hsEvents()

    // Logic16 : Double Top / Bottom（DBネック上抜け = LONG / DTネック下抜け = SHORT）
    [l16Long, l16Short] = f_dtdbEvents()

    // Logic17 : Wedge Pattern（Bull上限上抜け = LONG / Bear下限下抜け = SHORT）
    [l17Long, l17Short] = f_wedgeEvents()

    // Logic18 : Triangle Pattern（上限上抜け = LONG / 下限下抜け = SHORT・Asc / Desc のみ）
    [l18Long, l18Short] = f_triangleEvents()

    // ★Engine B へロジックを追加する時はここに定義し、下の array.from と ENG_B_N を更新する
    // -------------------------------------------------------------------------------
    // ▲▲▲ ここまで（Engine B）▲▲▲
    // -------------------------------------------------------------------------------
    // Engine B 内のビット順（0始まり）= Logic13, 14, ..., 18
    longsB  = array.from(l13Long,  l14Long,  l15Long,  l16Long,  l17Long,  l18Long)
    shortsB = array.from(l13Short, l14Short, l15Short, l16Short, l17Short, l18Short)
    [lmB, smB] = f_packMasks(longsB, shortsB)
    [lmB, smB]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic24 = Alice Band Bias（状態型ロジック）
// -------------------------------------------------------------------------------------
// 検出は元「Alice Complete」の Alice BAND 部分（maLen / atrLen1 / atrLen2 / mult1 / mult2 /
// flip_buf と calcST()）と同一です。MTF 200EMA / Zones / EF・IB / ZigZag / Market State /
// OB・BB / ラベル / アラート / ライン描画は移植していません。
//
//   basis = EMA(close, maLen)、LINE1 = ATR(atrLen1) × mult1、LINE2 = ATR(atrLen2) × mult2 で
//   それぞれ SuperTrend 風にフリップ判定し、line = trend == 1 ? rawL : rawU を返します。
//     LINE1・LINE2 が両方とも価格より下（bothBelow）→ LONG 状態
//     LINE1・LINE2 が両方とも価格より上（bothAbove）→ SHORT 状態
//     1本が上・1本が下（混在）                      → NONE
//   ★ 元コードの表示色（c1 / c2）は判定に使わず、価格との上下関係だけで判定します。
//
// ★このロジックだけ「イベント + 保持本数」ではなく状態型です。
//   §6 で ST_HOLD を使わず、そのTFの確定足ごとに現在のAlice状態を ST_STATE へ直接反映します
//   （混在になった瞬間に NONE、反対状態になった瞬間に即切替。古い状態は一切残しません）。
// 全6TF対象。共通MTF基盤（Engine C）の各TFコンテキストで評価するため request.security は
// 追加していません。反映は既存どおり [1] + lookahead_on の確定足ベースです。
grpAlice = "④ Logic24 : Alice Band パラメータ"
aliceMaLen   = input.int(12,     "MA 期間",        group = grpAlice, minval = 1)
aliceAtrLen1 = input.int(10,     "LINE1 ATR 期間", group = grpAlice, minval = 1)
aliceAtrLen2 = input.int(14,     "LINE2 ATR 期間", group = grpAlice, minval = 1)
aliceMult1   = input.float(1.5,  "LINE1 倍率",     group = grpAlice, minval = 0.1, step = 0.1)
aliceMult2   = input.float(2.7,  "LINE2 倍率",     group = grpAlice, minval = 0.1, step = 0.1)
aliceFlipBuf = input.float(0.3,  "フリップ余裕 (ATR倍)", group = grpAlice, minval = 0.0, step = 0.1)

// --- Logic24 Alice Band のパラメータ束（期間系は ta.* の simple 制約のため直接参照）---
var array<float> PRM_ALICE = array.from(
     aliceMult1,    // 00 : aliceMult1
     aliceMult2,    // 01 : aliceMult2
     aliceFlipBuf   // 02 : aliceFlipBuf
 )

// 元コードの calcST() と同一（フリップ判定・line の選び方を変更していません）
f_aliceST(_mult, _aLen, _initBull) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pAliceFlipBuf = array.get(PRM_ALICE, 2)
    float _basis = ta.ema(close, aliceMaLen)
    float _atr   = ta.atr(_aLen)
    float _rawU  = _basis + _mult * _atr
    float _rawL  = _basis - _mult * _atr
    var int _trend = _initBull ? 1 : -1
    int _prev = nz(_trend[1], _initBull ? 1 : -1)
    _trend := _prev ==  1 and close < _rawL[1] - _pAliceFlipBuf * _atr ? -1 :
              _prev == -1 and close > _rawU[1] + _pAliceFlipBuf * _atr ?  1 : _prev
    float _line = _trend == 1 ? _rawL : _rawU
    [_line, _trend]

// 現在の Alice Band Bias 状態（イベントではなく「今の状態」を返す）
f_aliceEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pAliceMult1 = array.get(PRM_ALICE, 0)
    float _pAliceMult2 = array.get(PRM_ALICE, 1)
    [_st1, _t1] = f_aliceST(_pAliceMult1, aliceAtrLen1, false)
    [_st2, _t2] = f_aliceST(_pAliceMult2, aliceAtrLen2, false)
    bool _bothBelow = _st1 < close and _st2 < close   // 元コードと同一
    bool _bothAbove = _st1 > close and _st2 > close   // 元コードと同一
    [_bothBelow, _bothAbove]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic25 = Stochastic Turn（イベント型）
// -------------------------------------------------------------------------------------
// %K は元コードと同じ ta.stoch(close, high, low, %K Length) → ta.sma(..., %K Smooth)、
// %D は ta.sma(%K, %D Length) で算出します。
//   ★ 判定に使うのは %K だけです（%D は将来の検証用に計算しているだけで判定には未使用）。
//   ★ K/D クロスは必須条件にしていません。
//
//   LONG  : %K が一度 Long Extreme(5) 以下へ到達 → Long待機状態
//           その後 %K が Long Turn(10) 以上になった最初の確定足で LONGイベント
//   SHORT : %K が一度 Short Extreme(95) 以上へ到達 → Short待機状態
//           その後 %K が Short Turn(90) 以下になった最初の確定足で SHORTイベント
//   ・「Extreme到達 → 折り返し」の順番が必須です（折り返し値に触れただけでは発生しません）。
//   ・イベント発生で待機状態を解除するため、同じExtreme到達から複数回は発生しません。
//     LONGは再び5以下へ、SHORTは再び95以上へ到達するまで再発生しません。
//   ・Alice Band のような常時状態型ではなくイベント型です。発生後は Logic01〜23 と同じ
//     保持本数システム（§3 の Logic25 保持本数 / §6 の f_applySignal）で保持します。
// 全6TF対象。共通MTF基盤（Engine C）の各TFコンテキストで評価するため request.security は
// 追加していません。反映は既存どおり [1] + lookahead_on の確定足ベースです。
grpStoch = "④ Logic25 : Stochastic Turn パラメータ"
stochKLen         = input.int(10,     "%K Length",  group = grpStoch, minval = 1)
stochKSmooth      = input.int(3,      "%K Smooth",  group = grpStoch, minval = 1)
stochDLen         = input.int(3,      "%D Length",  group = grpStoch, minval = 1)
stochLongExtreme  = input.float(5.0,  "Long Extreme (%K 到達ライン)",   group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochLongTurn     = input.float(10.0, "Long Turn (%K 折り返しライン)",  group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochShortExtreme = input.float(95.0, "Short Extreme (%K 到達ライン)",  group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochShortTurn    = input.float(90.0, "Short Turn (%K 折り返しライン)", group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)

// --- Logic25 Stochastic Turn のパラメータ束（%K/%D の期間は ta.* の simple 制約のため直接参照）---
var array<float> PRM_STOCH = array.from(
     stochLongExtreme,   // 00 : stochLongExtreme
     stochLongTurn,      // 01 : stochLongTurn
     stochShortExtreme,  // 02 : stochShortExtreme
     stochShortTurn      // 03 : stochShortTurn
 )

f_stochTurnEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pLongExtreme  = array.get(PRM_STOCH, 0)
    float _pLongTurn     = array.get(PRM_STOCH, 1)
    float _pShortExtreme = array.get(PRM_STOCH, 2)
    float _pShortTurn    = array.get(PRM_STOCH, 3)
    float _rawK = ta.stoch(close, high, low, stochKLen)
    float _k    = ta.sma(_rawK, stochKSmooth)
    float _d    = ta.sma(_k, stochDLen)      // 将来の検証用（LONG/SHORT判定には未使用）
    // Extreme到達で待機状態にする（順番の担保）
    var bool _longArmed  = false
    var bool _shortArmed = false
    if _k <= _pLongExtreme
        _longArmed := true
    if _k >= _pShortExtreme
        _shortArmed := true
    // 待機中に折り返しラインへ到達した最初の確定足でイベント（同じ到達から1回だけ）
    bool _long  = _longArmed  and _k >= _pLongTurn
    bool _short = _shortArmed and _k <= _pShortTurn
    if _long
        _longArmed := false      // 再び Long Extreme へ到達するまで再発生しない
    if _short
        _shortArmed := false     // 再び Short Extreme へ到達するまで再発生しない
    [_long, _short]

// =====================================================================================
// Engine C : Logic19〜25（Horizontal / Fib / Alice Band / Stoch）※Fib の解除マスクはこのEngineが返す
// =====================================================================================
f_signalMasksC() =>
    // -------------------------------------------------------------------------------
    // ▼▼▼ ここから：Engine C のロジック判定 ▼▼▼
    // -------------------------------------------------------------------------------
    // Logic19 : Horizontal Rebound / Logic20 : Horizontal Break
    // （前日H/L + セッションH/L を統合した同じ水平ゾーン状態から、独立した2ロジック分を取得）
    [l19Long, l19Short, l20Long, l20Short] = f_horizontalEvents()

    // Logic21〜23 : Fib 38.2 / 50.0 / 61.8 Rebound
    // （採用波1セットから3ロジック分のイベント + Fibグループ専用の解除情報を取得）
    [l21Long, l21Short, l22Long, l22Short, l23Long, l23Short, fibInv21, fibInv22, fibInv23] = f_fibEvents()

    // Logic24 : Alice Band Bias（状態型。イベントではなく現在のBias状態をビットで返す）
    [l24Long, l24Short] = f_aliceEvents()

    // Logic25 : Stochastic Turn（%K の Extreme到達 → 折り返しイベント。保持は POINT MASTER 側）
    [l25Long, l25Short] = f_stochTurnEvents()

    // ★Engine C へロジックを追加する時はここに定義し、下の array.from と ENG_C_N を更新する
    // -------------------------------------------------------------------------------
    // ▲▲▲ ここまで（Engine C）▲▲▲
    // -------------------------------------------------------------------------------
    // Engine C 内のビット順（0始まり）= Logic19, 20, 21, 22, 23, 24, 25
    longsC  = array.from(l19Long,  l20Long,  l21Long,  l22Long,  l23Long,  l24Long,  l25Long)
    shortsC = array.from(l19Short, l20Short, l21Short, l22Short, l23Short, l24Short, l25Short)
    [lmC, smC] = f_packMasks(longsC, shortsC)

    // 解除ビットマスク（Fibグループ専用。Engine C 内のビット位置で立てる）
    //   Engine C index 2 = Logic21 / 3 = Logic22 / 4 = Logic23
    float imC = 0.0
    imC += fibInv21 ? math.pow(2, 2) : 0.0
    imC += fibInv22 ? math.pow(2, 3) : 0.0
    imC += fibInv23 ? math.pow(2, 4) : 0.0
    [lmC, smC, imC]

// ビットマスクから「ロジック番号 idx」のフラグを取り出す
f_bitOn(mask, idx) =>
    na(mask) ? false : math.floor(mask / math.pow(2, idx)) % 2 > 0.5

// =====================================================================================
// §5. MTF 取得（リペイント / 未来参照 対策）
// =====================================================================================
// 使用する組み合わせ： request.security(..., <式>[1], lookahead = barmerge.lookahead_on)
// これが「非リペイント かつ 余計な遅延なし」の定型パターンです。
//
//   ・lookahead_on は上位足データを「その上位足の開始位置」に揃えます。
//     単独では未来参照（まだ確定していない足の終値が見える）になります。
//   ・そこへ [1] を掛けて 1本前＝すでに確定した上位足を参照するため、未来参照は消えます。
//   ・結果として「上位足が閉じた直後のチャート足」から即座に反映されます。
//       例) 15M足 10:00-10:15 でシグナル成立 → 10:15 に15M足確定
//           → 10:15 のチャート足から有効化（10:30 まで待ちません）
//   ・歴史足でもリアルタイム足でも同じ値になるため、リペイントしません。
//
// ★ [1] は絶対に外さないでください。外すと lookahead_on が未来参照になります。
//
// 【なぜ lookahead_off ではないか】
//   lookahead_off は歴史足では「直近の確定した上位足」を返し、リアルタイム足では
//   「形成中の上位足」を返す、という非対称な挙動をします。
//   そこへ [1] を掛けると、歴史足では2本前の確定足を見ることになり
//   必要のない1本ぶんの遅延が発生し、さらに歴史足とリアルタイム足で値がズレます。
//
// ・time[1] も同じ形で取得し、「そのTFの新しい確定足が来た瞬間」を検出します
//   （＝保持本数のカウントを、そのTF自身の足で1本ずつ進めるため）
//
// 【注意】チャートの時間足より小さいTFを集計する場合（例：日足チャートで1M）、
//        request.security() はそのチャート足に含まれる最後の1M足しか返せません
//        （lookahead の設定に関係なく発生する制限です）。
//        正確に集計したい場合は、集計対象の最小TF以下のチャートで表示してください。
// 上位足コンテキストで [1]（＝直近の確定足）を返すパケット
// 【Engine分割について】
//   1つの request.security() の式（#security.expr）が参照できる外部要素（グローバル / input /
//   関数）は254個までです。全ロジックを1つの式に入れるとロジック数に比例して増え、
//   Logic23 の時点で285になり上限を超えました（パラメータを配列へ束ねても、その配列を作る
//   元 input まで依存関係として展開されるため、外部要素は減りません）。
//   そこでロジックを Engine A / B / C の3グループへ分割し、TFごとに Engine ごとの
//   request.security() を発行します（6TF × 3Engine = 18回）。
//   1本あたりの外部要素は Engine A ≒60 / Engine B ≒165 / Engine C ≒70 程度になり、
//   254 に対して十分な余裕ができます。将来 Engine D を足す場合も同じ形で増やせます。
//   ★ [1] + lookahead_on の非リペイント方式は3Engineとも同一で、変更していません。
//   ★ 確定足の時刻 tt は Engine A のパケットだけで取得します（同じTFなのでA/B/Cで同一）。
f_htfPacketA() =>
    [lmRaw, smRaw] = f_signalMasksA()
    float lm = nz(lmRaw)
    float sm = nz(smRaw)
    int   tt = time
    [lm[1], sm[1], tt[1]]   // ★この [1] は必須（外すと未来参照になります）

f_htfPacketB() =>
    [lmRaw, smRaw] = f_signalMasksB()
    float lm = nz(lmRaw)
    float sm = nz(smRaw)
    [lm[1], sm[1]]          // ★この [1] は必須

f_htfPacketC() =>
    [lmRaw, smRaw, imRaw] = f_signalMasksC()
    float lm = nz(lmRaw)
    float sm = nz(smRaw)
    float im = nz(imRaw)
    [lm[1], sm[1], im[1]]   // ★この [1] は必須（Fib解除マスクも同じ確定足の値）

// TF × Engine の数だけ明示的に展開（request.security() をループ内で呼ばないため）
[lmA1, smA1, tt1] = request.security(syminfo.tickerid, tfStr1, f_htfPacketA(), lookahead = barmerge.lookahead_on)
[lmA2, smA2, tt2] = request.security(syminfo.tickerid, tfStr2, f_htfPacketA(), lookahead = barmerge.lookahead_on)
[lmA3, smA3, tt3] = request.security(syminfo.tickerid, tfStr3, f_htfPacketA(), lookahead = barmerge.lookahead_on)
[lmA4, smA4, tt4] = request.security(syminfo.tickerid, tfStr4, f_htfPacketA(), lookahead = barmerge.lookahead_on)
[lmA5, smA5, tt5] = request.security(syminfo.tickerid, tfStr5, f_htfPacketA(), lookahead = barmerge.lookahead_on)
[lmA6, smA6, tt6] = request.security(syminfo.tickerid, tfStr6, f_htfPacketA(), lookahead = barmerge.lookahead_on)

[lmB1, smB1] = request.security(syminfo.tickerid, tfStr1, f_htfPacketB(), lookahead = barmerge.lookahead_on)
[lmB2, smB2] = request.security(syminfo.tickerid, tfStr2, f_htfPacketB(), lookahead = barmerge.lookahead_on)
[lmB3, smB3] = request.security(syminfo.tickerid, tfStr3, f_htfPacketB(), lookahead = barmerge.lookahead_on)
[lmB4, smB4] = request.security(syminfo.tickerid, tfStr4, f_htfPacketB(), lookahead = barmerge.lookahead_on)
[lmB5, smB5] = request.security(syminfo.tickerid, tfStr5, f_htfPacketB(), lookahead = barmerge.lookahead_on)
[lmB6, smB6] = request.security(syminfo.tickerid, tfStr6, f_htfPacketB(), lookahead = barmerge.lookahead_on)

[lmC1, smC1, imC1] = request.security(syminfo.tickerid, tfStr1, f_htfPacketC(), lookahead = barmerge.lookahead_on)
[lmC2, smC2, imC2] = request.security(syminfo.tickerid, tfStr2, f_htfPacketC(), lookahead = barmerge.lookahead_on)
[lmC3, smC3, imC3] = request.security(syminfo.tickerid, tfStr3, f_htfPacketC(), lookahead = barmerge.lookahead_on)
[lmC4, smC4, imC4] = request.security(syminfo.tickerid, tfStr4, f_htfPacketC(), lookahead = barmerge.lookahead_on)
[lmC5, smC5, imC5] = request.security(syminfo.tickerid, tfStr5, f_htfPacketC(), lookahead = barmerge.lookahead_on)
[lmC6, smC6, imC6] = request.security(syminfo.tickerid, tfStr6, f_htfPacketC(), lookahead = barmerge.lookahead_on)

// Engineごとのマスク（index = TFスロット）
MASK_LONG_A  = array.from(nz(lmA1), nz(lmA2), nz(lmA3), nz(lmA4), nz(lmA5), nz(lmA6))
MASK_SHORT_A = array.from(nz(smA1), nz(smA2), nz(smA3), nz(smA4), nz(smA5), nz(smA6))
MASK_LONG_B  = array.from(nz(lmB1), nz(lmB2), nz(lmB3), nz(lmB4), nz(lmB5), nz(lmB6))
MASK_SHORT_B = array.from(nz(smB1), nz(smB2), nz(smB3), nz(smB4), nz(smB5), nz(smB6))
MASK_LONG_C  = array.from(nz(lmC1), nz(lmC2), nz(lmC3), nz(lmC4), nz(lmC5), nz(lmC6))
MASK_SHORT_C = array.from(nz(smC1), nz(smC2), nz(smC3), nz(smC4), nz(smC5), nz(smC6))
MASK_INV_C   = array.from(nz(imC1), nz(imC2), nz(imC3), nz(imC4), nz(imC5), nz(imC6))
TF_TIME      = array.from(nz(tt1),  nz(tt2),  nz(tt3),  nz(tt4),  nz(tt5),  nz(tt6))

// =====================================================================================
// §6. 状態管理エンジン（★LONG→SHORT 切替はここで処理）
// =====================================================================================
// 状態と残り保持本数は1次元配列で保持する（index = f_idx(logicIndex, tfIndex)）。
// 「どのロジックが、どのTFで、LONG / SHORT / NONE か」が常に分かる形なので、
// 将来のロジック詳細テーブル（§8下段）もこの配列を読むだけで作れます。
var ST_STATE    = array.new_int(N_LOGIC * N_TF, ST_NONE)  // NONE / LONG / SHORT
var ST_HOLD     = array.new_int(N_LOGIC * N_TF, 0)        // 残り保持本数
var LAST_TFTIME = array.new_int(N_TF, 0)                  // TFごとの最終確定足の時刻

// -------------------------------------------------------------------------------------
// 状態型ロジックの指定（★ここに入れたロジックだけ保持本数を使いません）
// -------------------------------------------------------------------------------------
// 通常ロジックは「イベント発生 → 保持本数ぶん保持」ですが、状態型ロジックは
// 「そのTFの確定足ごとの現在状態」をそのまま ST_STATE へ反映します（ST_HOLD は 0 固定）。
//   ・LONG状態が続く限り LONG のまま（本数で消えない）
//   ・状態が消えた瞬間に NONE、反対状態になった瞬間に即 LONG⇔SHORT 切替
// Logic24 = Alice Band Bias（index 23）が該当します。
int LI_ALICE = 23
var IS_STATE_LOGIC = array.new_bool(N_LOGIC, false)
array.set(IS_STATE_LOGIC, LI_ALICE, true)

grpRule = "⑤ 状態管理ルール"
conflictStr = input.string("無視 (現状維持)", "同一ロジック・同一TFで両方向が同時発生した時",
     options = ["無視 (現状維持)", "LONG優先", "SHORT優先"], group = grpRule)
conflictMode = conflictStr == "LONG優先" ? CONF_LONG : conflictStr == "SHORT優先" ? CONF_SHORT : CONF_IGNORE

// -------------------------------------------------------------------------------------
// 状態遷移の中核。すべてのロジック・すべてのTFがこの1関数だけを通ります。
// ロジックを何個増やしてもこの関数は変更不要です。
//
//   NONE       --LONG-->        LONG        保持本数をセット
//   LONG       --LONG-->        LONG        ポイントは加算せず「保持期限だけリセット」
//   LONG       --SHORT-->       SHORT       旧方向(LONG)を即解除して切替。保持は0から開始
//   SHORT      --SHORT-->       SHORT       保持期限だけリセット
//   SHORT      --LONG-->        LONG        旧方向(SHORT)を即解除して切替
//   LONG/SHORT --シグナル無し--> 残り-1、0になったら NONE
//
// state は常に単一値なので、同一ロジック・同一TFで LONG と SHORT を同時に持つことは
// 構造的に起こり得ません。ポイントの二重加算も起こりません。
// -------------------------------------------------------------------------------------
f_applySignal(stateArr, holdArr, k, sigLongRaw, sigShortRaw, holdBars, cMode) =>
    int  st = array.get(stateArr, k)
    int  hd = array.get(holdArr,  k)
    bool sigLong  = sigLongRaw
    bool sigShort = sigShortRaw

    // 両方向が同時に来た場合の裁定（同時保持は禁止なので、寄せるか無視する）
    if sigLong and sigShort
        sigLong  := cMode == CONF_LONG
        sigShort := cMode == CONF_SHORT

    if sigLong
        st := ST_LONG      // SHORT 保持中なら、ここで SHORT が即解除され LONG へ切替わる
        hd := holdBars     // 同方向の再発生なら「期限リセット」だけになる
    else if sigShort
        st := ST_SHORT     // LONG 保持中なら、ここで LONG が即解除され SHORT へ切替わる
        hd := holdBars
    else if st != ST_NONE
        // シグナル無し：そのTFの確定足が1本進むごとに保持本数を消化
        hd := hd - 1
        if hd <= 0
            st := ST_NONE
            hd := 0

    array.set(stateArr, k, st)
    array.set(holdArr,  k, hd)

// -------------------------------------------------------------------------------------
// 全TF × 全ロジックの状態更新
// 更新は「そのTFの確定足が新しくなった瞬間」だけ実行する（チャート足ごとには進めない）
// → 保持本数“6本”は、常にそのTF自身の6本を意味します
// -------------------------------------------------------------------------------------
for ti = 0 to N_TF - 1
    int tNow = array.get(TF_TIME, ti)
    if tNow > array.get(LAST_TFTIME, ti)
        array.set(LAST_TFTIME, ti, tNow)
        float lmA = array.get(MASK_LONG_A,  ti)
        float smA = array.get(MASK_SHORT_A, ti)
        float lmB = array.get(MASK_LONG_B,  ti)
        float smB = array.get(MASK_SHORT_B, ti)
        float lmC = array.get(MASK_LONG_C,  ti)
        float smC = array.get(MASK_SHORT_C, ti)
        float imC = array.get(MASK_INV_C,   ti)
        for li = 0 to N_LOGIC - 1
            int k = f_idx(li, ti)
            // Engine内ビット位置 → 元のロジック番号 li への対応
            //   li 0〜11  = Engine A の bit 0〜11 （Logic01〜12）
            //   li 12〜17 = Engine B の bit 0〜5  （Logic13〜18）
            //   li 18〜24 = Engine C の bit 0〜6  （Logic19〜25）
            bool sigLong  = li < ENG_A_N ? f_bitOn(lmA, li) : li < ENG_A_N + ENG_B_N ? f_bitOn(lmB, li - ENG_A_N) : f_bitOn(lmC, li - ENG_A_N - ENG_B_N)
            bool sigShort = li < ENG_A_N ? f_bitOn(smA, li) : li < ENG_A_N + ENG_B_N ? f_bitOn(smB, li - ENG_A_N) : f_bitOn(smC, li - ENG_A_N - ENG_B_N)
            if array.get(IS_STATE_LOGIC, li)
                // 状態型ロジック（Logic24 Alice Band Bias）：保持本数を使わず現在状態をそのまま反映
                array.set(ST_STATE, k, sigLong ? ST_LONG : sigShort ? ST_SHORT : ST_NONE)
                array.set(ST_HOLD,  k, 0)
            else
                f_applySignal(ST_STATE, ST_HOLD, k, sigLong, sigShort, array.get(HOLD_ALL, k), conflictMode)
            // Fibグループ専用の解除（深いFib到達 → 浅いFibロジックの保持を解除）。
            // 解除マスクは Engine C だけが返し、その中でも Logic21〜23 のビットしか立たないため、
            // Logic01〜20 には影響しません。
            if li >= ENG_A_N + ENG_B_N and f_bitOn(imC, li - ENG_A_N - ENG_B_N)
                array.set(ST_STATE, k, ST_NONE)
                array.set(ST_HOLD,  k, 0)

// =====================================================================================
// §7. ポイント集計
// =====================================================================================
// ポイント = ロジックWeight × 時間足Weight
// LONG と SHORT は完全に独立集計（別ロジックであれば同時に立って構わない）
TF_LONG  = array.new_float(N_TF, 0.0)
TF_SHORT = array.new_float(N_TF, 0.0)

float longScore  = 0.0
float shortScore = 0.0

for ti = 0 to N_TF - 1
    float tw   = array.get(TF_WEIGHT, ti)
    float sumL = 0.0
    float sumS = 0.0
    for li = 0 to N_LOGIC - 1
        int   st = array.get(ST_STATE, f_idx(li, ti))
        float pt = array.get(LOGIC_WEIGHT, li) * tw   // ← ロジックWeight × 時間足Weight
        if st == ST_LONG
            sumL += pt
        else if st == ST_SHORT
            sumS += pt
    array.set(TF_LONG,  ti, sumL)
    array.set(TF_SHORT, ti, sumS)
    longScore  += sumL
    shortScore += sumS

float netScore = longScore - shortScore

// 他スクリプトからの参照 / データウィンドウでの確認用
plot(longScore,  "LONG SCORE",  display = display.data_window)
plot(shortScore, "SHORT SCORE", display = display.data_window)
plot(netScore,   "NET SCORE",   display = display.data_window)

// =====================================================================================
// §8. テーブル表示
// =====================================================================================
grpView = "⑥ 表示設定"
showMain   = input.bool(true,  "スコアテーブルを表示 (右上)", group = grpView)
showDetail = input.bool(false, "ロジック詳細テーブルを表示 (右下)", group = grpView,
     tooltip = "ロジック × TF のポイント内訳。L3.00 [4] = LONGで+3.00ポイント・残り保持4本。" +
     "ポイントは ロジックWeight × 時間足Weight で、メインテーブルの LONG / SHORT の内訳になります。")
tblSize    = input.string(size.small, "文字サイズ",
     options = [size.tiny, size.small, size.normal, size.large], group = grpView)
decimals   = input.int(2, "小数点桁数", minval = 0, maxval = 3, group = grpView)

colLong  = input.color(color.new(#26a69a, 0),  "LONG 色",  group = grpView, inline = "col")
colShort = input.color(color.new(#ef5350, 0),  "SHORT 色", group = grpView, inline = "col")
colBg    = input.color(color.new(#1e222d, 20), "背景色",   group = grpView)
colTxt   = input.color(color.new(#d1d4dc, 0),  "文字色",   group = grpView)

// 数値フォーマット（小数点桁数を input で切替）
FMT = decimals == 0 ? "0" : decimals == 1 ? "0.0" : decimals == 2 ? "0.00" : "0.000"
f_fmt(v) => str.tostring(v, FMT)
f_fmtSigned(v) => (v > 0 ? "+" : v < 0 ? "-" : "") + str.tostring(math.abs(v), FMT)

// 時間足コードを表示用ラベルへ（"60" → "1H" など）
f_tfLabel(tf) =>
    string s = str.upper(tf)
    string r = switch s
        "1"   => "1M"
        "3"   => "3M"
        "5"   => "5M"
        "15"  => "15M"
        "30"  => "30M"
        "45"  => "45M"
        "60"  => "1H"
        "120" => "2H"
        "180" => "3H"
        "240" => "4H"
        "360" => "6H"
        "480" => "8H"
        "720" => "12H"
        "D"   => "1D"
        "W"   => "1W"
        "M"   => "1MO"
        => s
    r

// ---- メインテーブル（右上）: TFごとの LONG / SHORT と TOTAL / NET --------------------
var mainTbl = table.new(position.top_right, 3, N_TF + 3, border_width = 1)

if showMain and barstate.islast
    table.cell(mainTbl, 0, 0, "POINT MASTER", text_color = colTxt,   bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 1, 0, "LONG",         text_color = colLong,  bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 2, 0, "SHORT",        text_color = colShort, bgcolor = colBg, text_size = tblSize)

    for ti = 0 to N_TF - 1
        int   row = ti + 1
        float lv  = array.get(TF_LONG,  ti)
        float sv  = array.get(TF_SHORT, ti)
        table.cell(mainTbl, 0, row, f_tfLabel(array.get(TF_LIST, ti)), text_color = colTxt, bgcolor = colBg, text_size = tblSize)
        table.cell(mainTbl, 1, row, f_fmt(lv), text_color = lv > 0 ? colLong  : colTxt, bgcolor = colBg, text_size = tblSize)
        table.cell(mainTbl, 2, row, f_fmt(sv), text_color = sv > 0 ? colShort : colTxt, bgcolor = colBg, text_size = tblSize)

    int rTotal = N_TF + 1
    table.cell(mainTbl, 0, rTotal, "TOTAL",           text_color = colTxt,   bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 1, rTotal, f_fmt(longScore),  text_color = colLong,  bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 2, rTotal, f_fmt(shortScore), text_color = colShort, bgcolor = colBg, text_size = tblSize)

    int rNet = N_TF + 2
    color netCol = netScore > 0 ? colLong : netScore < 0 ? colShort : colTxt
    table.cell(mainTbl, 0, rNet, "NET", text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 1, rNet, f_fmtSigned(netScore), text_color = netCol, bgcolor = colBg, text_size = tblSize)
    table.cell(mainTbl, 2, rNet, "",    text_color = colTxt, bgcolor = colBg, text_size = tblSize)

// ---- 詳細テーブル（右下）: ロジック × TF のポイント内訳 -----------------------------
// 内部状態（ST_STATE / ST_HOLD）と Weight をそのまま表示しているだけなので、
// ロジックを増やせば行が自動的に増えます（コード変更不要）。
//   表示は  L3.00 [4]  = LONGで +3.00ポイント / 残り保持4本
//           L2.00 [LIVE] = 状態型ロジック（Logic24 Alice Band Bias）が現在LONG状態
//           S2.40 [2]  = SHORTで +2.40ポイント / 残り保持2本
//           -          = NONE（加点なし）
//   ポイントは §7 の集計と同じ「ロジックWeight × 時間足Weight」なので、
//   各TF列の L の合計 = メインテーブルのそのTFの LONG、S の合計 = SHORT になります。
//   EMA(Logic05〜12) のように対象外TFがあるロジックは、そのTFでイベントが起きないため
//   自動的に「-」のままです（特別な処理は入れていません）。
var detailTbl = table.new(position.bottom_right, N_TF + 1, N_LOGIC + 1, border_width = 1)

if showDetail and barstate.islast
    table.cell(detailTbl, 0, 0, "LOGIC / TF", text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    for ti = 0 to N_TF - 1
        table.cell(detailTbl, ti + 1, 0, f_tfLabel(array.get(TF_LIST, ti)), text_color = colTxt, bgcolor = colBg, text_size = tblSize)
    for li = 0 to N_LOGIC - 1
        table.cell(detailTbl, 0, li + 1, array.get(LOGIC_NAME, li), text_color = colTxt, bgcolor = colBg, text_size = tblSize)
        for ti = 0 to N_TF - 1
            int    st  = array.get(ST_STATE, f_idx(li, ti))
            int    hd  = array.get(ST_HOLD,  f_idx(li, ti))
            // §7 と同じポイント計算（ロジックWeight × 時間足Weight）
            float  pt  = array.get(LOGIC_WEIGHT, li) * array.get(TF_WEIGHT, ti)
            // 状態型ロジック（保持本数を使わない）は本数の代わりに [LIVE] と表示する
            string hold = array.get(IS_STATE_LOGIC, li) ? "[LIVE]" : "[" + str.tostring(hd) + "]"
            string txt = st == ST_LONG  ? "L" + f_fmt(pt) + " " + hold :
                         st == ST_SHORT ? "S" + f_fmt(pt) + " " + hold : "-"
            color  c   = st == ST_LONG ? colLong : st == ST_SHORT ? colShort : colTxt
            table.cell(detailTbl, ti + 1, li + 1, txt, text_color = c, bgcolor = colBg, text_size = tblSize)

// =====================================================================================
// §9. アラート土台
// =====================================================================================
// 実売買ロジック（エントリー / SL / TP）は未実装。スコアのしきい値だけ用意しています。
// longScore / shortScore / netScore は §7 で確定済みの変数としてここから参照できます。
grpAlert = "⑦ アラート"
thLong  = input.float(5.0, "LONG SCORE >= ",  group = grpAlert, step = 0.1)
thShort = input.float(5.0, "SHORT SCORE >= ", group = grpAlert, step = 0.1)
thNet   = input.float(5.0, "|NET SCORE| >= ", group = grpAlert, step = 0.1)

bool alertLongHit  = longScore  >= thLong
bool alertShortHit = shortScore >= thShort
bool alertNetUp    = netScore   >=  thNet
bool alertNetDown  = netScore   <= -thNet

alertcondition(alertLongHit,  "LONG SCORE 到達",  "POINT MASTER : LONG SCORE がしきい値に到達しました")
alertcondition(alertShortHit, "SHORT SCORE 到達", "POINT MASTER : SHORT SCORE がしきい値に到達しました")
alertcondition(alertNetUp,    "NET SCORE 上抜け", "POINT MASTER : NET SCORE が +しきい値に到達しました")
alertcondition(alertNetDown,  "NET SCORE 下抜け", "POINT MASTER : NET SCORE が -しきい値に到達しました")

//    bool _sellSweep = useLineSweep and _resUsable and (high - nearestResistance) >= _sweepTol and close < nearestResistance and f_lineCommonOK(false, lineAtr)
//    lineRawLong  := _buyBounce or _buyFlip or _buyBreak or _buySweep
//    lineRawShort := _sellBounce or _sellFlip or _sellBreak or _sellSweep
//    bool _obsAbove = not na(nearestResistance) and (nearestResistance - close) <= lineAtr * lineObstacleATR
//    bool _obsBelow = not na(nearestSupport)    and (close - nearestSupport)    <= lineAtr * lineObstacleATR
//    lineNoTradeLong  := useLineObstacleFilter and _obsAbove
//    lineNoTradeShort := useLineObstacleFilter and _obsBelow
//
//if not (useLineWZ and useLineBreak)
//    f_clearPendingUp()
//    f_clearPendingDn()

var int lineLongStateBar  = na
var int lineShortStateBar = na
if useLineWZ and useLineStateWindow
    if lineRawLong
        lineLongStateBar := bar_index
    if lineRawShort
        lineShortStateBar := bar_index
bool lineLongState  = useLineStateWindow and not na(lineLongStateBar)  and (bar_index - lineLongStateBar)  <= lineStateMaxBars
bool lineShortState = useLineStateWindow and not na(lineShortStateBar) and (bar_index - lineShortStateBar) <= lineStateMaxBars

bool lineLongWinZone  = useLineWZ ? (useLineStateWindow ? lineLongState  : lineRawLong)  : false
bool lineShortWinZone = useLineWZ ? (useLineStateWindow ? lineShortState : lineRawShort) : false

// ============================================================
//  5b-2g. Trendline / Channel WinZone モジュール (判定ロジックのみ)
// ------------------------------------------------------------
//  FVG/Volume/Fib/EMA/Line と並列の場所条件。useTrendWZ=false の時は
//  ta.atr/pivot・Trendline・Channel・状態管理更新 を一切走らせない (軽量)。
//  出力 : trendLongWinZone / trendShortWinZone
// ============================================================
f_tlNear(float price, float level, float rng) =>
    not na(level) and math.abs(price - level) <= rng

f_tlLineValue(int x1, float y1, int x2, float y2, int xNow) =>
    float slope = (y2 - y1) / math.max(x2 - x1, 1)
    y1 + slope * (xNow - x1)

f_tlQualityScore(int touch, int ageBars, float slopeAbsATR, int broken) =>
    int touchScore  = touch >= 4 ? 40 : touch == 3 ? 30 : touch >= 2 ? 20 : 0
    int ageScore    = (ageBars >= 20 and ageBars <= 150) ? 20 : (ageBars >= 151 and ageBars <= 300) ? 10 : 0
    int slopeScore  = na(slopeAbsATR) ? 0 : (slopeAbsATR < minSlopeATR ? 5 : slopeAbsATR > maxSlopeATR ? 5 : 20)
    int brokenScore = broken == 0 ? 20 : broken == 1 ? 10 : 0
    math.min(100, touchScore + ageScore + slopeScore + brokenScore)

f_tlSlopeATR(float p1, int b1, float p2, int b2, float atrv) =>
    atrv != 0 ? math.abs((p2 - p1) / math.max(b2 - b1, 1)) / atrv : na

bool trendEntryBuy     = false
bool trendEntrySell    = false
bool trendNoTradeLong  = false
bool trendNoTradeShort = false
bool trendQualityOk    = true
int  trendlineQuality  = 0

if useTrendWZ
    float atr = ta.atr(14)
    float trendTouchRange = trendTouchMode == "ATR" ? atr * trendTouchATR : trendTouchDollar

    float tl_body   = math.abs(close - open)
    float tl_upWick = high - math.max(open, close)
    float tl_dnWick = math.min(open, close) - low
    bool tl_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool tl_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool tl_pinLower = tl_dnWick >= tl_body and tl_dnWick >= tl_upWick
    bool tl_pinUpper = tl_upWick >= tl_body and tl_upWick >= tl_dnWick
    bool bullishReversal = tl_bullEngulf or tl_pinLower or close > open
    bool bearishReversal = tl_bearEngulf or tl_pinUpper or close < open

    float ph = ta.pivothigh(high, tlPivotLen, tlPivotLen)
    float pl = ta.pivotlow(low, tlPivotLen, tlPivotLen)

    var float hp1P = na
    var float hp2P = na
    var float hp3P = na
    var float hp4P = na
    var int   hp1B = na
    var int   hp2B = na
    var int   hp3B = na
    var int   hp4B = na
    var float lp1P = na
    var float lp2P = na
    var float lp3P = na
    var float lp4P = na
    var int   lp1B = na
    var int   lp2B = na
    var int   lp3B = na
    var int   lp4B = na

    bool newHighPivot = false
    bool newLowPivot  = false
    if not na(ph)
        if na(hp1P) or not useATRSwingFilter or math.abs(ph - hp1P) >= atr * minSwingATR
            hp4P := hp3P
            hp4B := hp3B
            hp3P := hp2P
            hp3B := hp2B
            hp2P := hp1P
            hp2B := hp1B
            hp1P := ph
            hp1B := bar_index - tlPivotLen
            newHighPivot := true
    if not na(pl)
        if na(lp1P) or not useATRSwingFilter or math.abs(pl - lp1P) >= atr * minSwingATR
            lp4P := lp3P
            lp4B := lp3B
            lp3P := lp2P
            lp3B := lp2B
            lp2P := lp1P
            lp2B := lp1B
            lp1P := pl
            lp1B := bar_index - tlPivotLen
            newLowPivot := true

    var int upTouchA = 0
    var int upTouchB = 0
    var int upTouchC = 0
    var int upBrokA = 0
    var int upBrokB = 0
    var int upBrokC = 0
    var int upBelowA = 0
    var int upBelowB = 0
    var int upBelowC = 0
    var int dnTouchA = 0
    var int dnTouchB = 0
    var int dnTouchC = 0
    var int dnBrokA = 0
    var int dnBrokB = 0
    var int dnBrokC = 0
    var int dnAboveA = 0
    var int dnAboveB = 0
    var int dnAboveC = 0
    if newLowPivot
        upTouchA := 0
        upTouchB := 0
        upTouchC := 0
        upBrokA := 0
        upBrokB := 0
        upBrokC := 0
        upBelowA := 0
        upBelowB := 0
        upBelowC := 0
    if newHighPivot
        dnTouchA := 0
        dnTouchB := 0
        dnTouchC := 0
        dnBrokA := 0
        dnBrokB := 0
        dnBrokC := 0
        dnAboveA := 0
        dnAboveB := 0
        dnAboveC := 0

    bool upValidA = not na(lp1P) and not na(lp2P) and lp1B != lp2B
    bool upValidB = not na(lp1P) and not na(lp3P) and lp1B != lp3B
    bool upValidC = not na(lp1P) and not na(lp4P) and lp1B != lp4B
    float upValA = upValidA ? f_tlLineValue(lp2B, lp2P, lp1B, lp1P, bar_index) : na
    float upValB = upValidB ? f_tlLineValue(lp3B, lp3P, lp1B, lp1P, bar_index) : na
    float upValC = upValidC ? f_tlLineValue(lp4B, lp4P, lp1B, lp1P, bar_index) : na
    if not na(upValA)
        if f_tlNear(low, upValA, trendTouchRange) and bullishReversal and close > upValA
            upTouchA := upTouchA + 1
        upBelowA := close < upValA ? upBelowA + 1 : 0
        if upBelowA == breakConfirmBars
            upBrokA := upBrokA + 1
    if not na(upValB)
        if f_tlNear(low, upValB, trendTouchRange) and bullishReversal and close > upValB
            upTouchB := upTouchB + 1
        upBelowB := close < upValB ? upBelowB + 1 : 0
        if upBelowB == breakConfirmBars
            upBrokB := upBrokB + 1
    if not na(upValC)
        if f_tlNear(low, upValC, trendTouchRange) and bullishReversal and close > upValC
            upTouchC := upTouchC + 1
        upBelowC := close < upValC ? upBelowC + 1 : 0
        if upBelowC == breakConfirmBars
            upBrokC := upBrokC + 1

    bool dnValidA = not na(hp1P) and not na(hp2P) and hp1B != hp2B
    bool dnValidB = not na(hp1P) and not na(hp3P) and hp1B != hp3B
    bool dnValidC = not na(hp1P) and not na(hp4P) and hp1B != hp4B
    float dnValA = dnValidA ? f_tlLineValue(hp2B, hp2P, hp1B, hp1P, bar_index) : na
    float dnValB = dnValidB ? f_tlLineValue(hp3B, hp3P, hp1B, hp1P, bar_index) : na
    float dnValC = dnValidC ? f_tlLineValue(hp4B, hp4P, hp1B, hp1P, bar_index) : na
    if not na(dnValA)
        if f_tlNear(high, dnValA, trendTouchRange) and bearishReversal and close < dnValA
            dnTouchA := dnTouchA + 1
        dnAboveA := close > dnValA ? dnAboveA + 1 : 0
        if dnAboveA == breakConfirmBars
            dnBrokA := dnBrokA + 1
    if not na(dnValB)
        if f_tlNear(high, dnValB, trendTouchRange) and bearishReversal and close < dnValB
            dnTouchB := dnTouchB + 1
        dnAboveB := close > dnValB ? dnAboveB + 1 : 0
        if dnAboveB == breakConfirmBars
            dnBrokB := dnBrokB + 1
    if not na(dnValC)
        if f_tlNear(high, dnValC, trendTouchRange) and bearishReversal and close < dnValC
            dnTouchC := dnTouchC + 1
        dnAboveC := close > dnValC ? dnAboveC + 1 : 0
        if dnAboveC == breakConfirmBars
            dnBrokC := dnBrokC + 1

    int upQA = upValidA ? f_tlQualityScore(upTouchA, bar_index - lp2B, f_tlSlopeATR(lp2P, lp2B, lp1P, lp1B, atr), upBrokA) : -1
    int upQB = upValidB ? f_tlQualityScore(upTouchB, bar_index - lp3B, f_tlSlopeATR(lp3P, lp3B, lp1P, lp1B, atr), upBrokB) : -1
    int upQC = upValidC ? f_tlQualityScore(upTouchC, bar_index - lp4B, f_tlSlopeATR(lp4P, lp4B, lp1P, lp1B, atr), upBrokC) : -1
    int dnQA = dnValidA ? f_tlQualityScore(dnTouchA, bar_index - hp2B, f_tlSlopeATR(hp2P, hp2B, hp1P, hp1B, atr), dnBrokA) : -1
    int dnQB = dnValidB ? f_tlQualityScore(dnTouchB, bar_index - hp3B, f_tlSlopeATR(hp3P, hp3B, hp1P, hp1B, atr), dnBrokB) : -1
    int dnQC = dnValidC ? f_tlQualityScore(dnTouchC, bar_index - hp4B, f_tlSlopeATR(hp4P, hp4B, hp1P, hp1B, atr), dnBrokC) : -1

    int   selUpIdx = na
    float upTrendlineValue = na
    int   upTrendlineQuality = 0
    int   upTouchCount = 0
    float selUpAnchorP = na
    int   selUpAnchorB = na
    if upValidA
        selUpIdx := 0
        upTrendlineValue := upValA
        upTrendlineQuality := upQA
        upTouchCount := upTouchA
        selUpAnchorP := lp2P
        selUpAnchorB := lp2B
    if upValidB and (na(selUpIdx) or upQB > upTrendlineQuality or (upQB == upTrendlineQuality and math.abs(close - upValB) < math.abs(close - upTrendlineValue)))
        selUpIdx := 1
        upTrendlineValue := upValB
        upTrendlineQuality := upQB
        upTouchCount := upTouchB
        selUpAnchorP := lp3P
        selUpAnchorB := lp3B
    if upValidC and (na(selUpIdx) or upQC > upTrendlineQuality or (upQC == upTrendlineQuality and math.abs(close - upValC) < math.abs(close - upTrendlineValue)))
        selUpIdx := 2
        upTrendlineValue := upValC
        upTrendlineQuality := upQC
        upTouchCount := upTouchC
        selUpAnchorP := lp4P
        selUpAnchorB := lp4B
    bool upValid = not na(upTrendlineValue)

    int   selDnIdx = na
    float downTrendlineValue = na
    int   downTrendlineQuality = 0
    int   downTouchCount = 0
    float selDnAnchorP = na
    int   selDnAnchorB = na
    if dnValidA
        selDnIdx := 0
        downTrendlineValue := dnValA
        downTrendlineQuality := dnQA
        downTouchCount := dnTouchA
        selDnAnchorP := hp2P
        selDnAnchorB := hp2B
    if dnValidB and (na(selDnIdx) or dnQB > downTrendlineQuality or (dnQB == downTrendlineQuality and math.abs(close - dnValB) < math.abs(close - downTrendlineValue)))
        selDnIdx := 1
        downTrendlineValue := dnValB
        downTrendlineQuality := dnQB
        downTouchCount := dnTouchB
        selDnAnchorP := hp3P
        selDnAnchorB := hp3B
    if dnValidC and (na(selDnIdx) or dnQC > downTrendlineQuality or (dnQC == downTrendlineQuality and math.abs(close - dnValC) < math.abs(close - downTrendlineValue)))
        selDnIdx := 2
        downTrendlineValue := dnValC
        downTrendlineQuality := dnQC
        downTouchCount := dnTouchC
        selDnAnchorP := hp4P
        selDnAnchorB := hp4B
    bool downValid = not na(downTrendlineValue)

    trendlineQuality := math.max(upTrendlineQuality, downTrendlineQuality)

    float upTLatHP = (upValid and not na(hp1B)) ? f_tlLineValue(selUpAnchorB, selUpAnchorP, lp1B, lp1P, hp1B) : na
    float upOffset = (not na(upTLatHP) and not na(hp1P)) ? math.abs(hp1P - upTLatHP) : na
    float upChannelLower = upTrendlineValue
    float upChannelUpper = (not na(upTrendlineValue) and not na(upOffset)) ? upTrendlineValue + upOffset : na
    float downTLatLP = (downValid and not na(lp1B)) ? f_tlLineValue(selDnAnchorB, selDnAnchorP, hp1B, hp1P, lp1B) : na
    float downOffset = (not na(downTLatLP) and not na(lp1P)) ? math.abs(lp1P - downTLatLP) : na
    float downChannelUpper = downTrendlineValue
    float downChannelLower = (not na(downTrendlineValue) and not na(downOffset)) ? downTrendlineValue - downOffset : na
    float upChannelWidth   = (not na(upChannelUpper) and not na(upChannelLower)) ? upChannelUpper - upChannelLower : na
    float downChannelWidth = (not na(downChannelUpper) and not na(downChannelLower)) ? downChannelUpper - downChannelLower : na

    float upSlopeSigned   = upValid   ? (lp1P - selUpAnchorP) / math.max(lp1B - selUpAnchorB, 1) : na
    float downSlopeSigned = downValid ? (hp1P - selDnAnchorP) / math.max(hp1B - selDnAnchorB, 1) : na
    float slopeFlatTh = atr * minSlopeATR
    bool activeUp = upValid
    float channelSlope = activeUp ? upSlopeSigned : downSlopeSigned
    int channelSlopeState = na(channelSlope) ? 0 : channelSlope > slopeFlatTh ? 1 : channelSlope < -slopeFlatTh ? -1 : 0

    bool nearUpTrendline   = f_tlNear(low,  upTrendlineValue, trendTouchRange)
    bool nearDownTrendline = f_tlNear(high, downTrendlineValue, trendTouchRange)
    bool nearUpChannelLower = f_tlNear(low,  upChannelLower, trendTouchRange)
    bool nearUpChannelUpper = f_tlNear(high, upChannelUpper, trendTouchRange)
    bool nearDownChannelUpper = f_tlNear(high, downChannelUpper, trendTouchRange)
    bool nearDownChannelLower = f_tlNear(low,  downChannelLower, trendTouchRange)

    bool touchCountOk = (upValid and upTouchCount >= minLineTouches) or (downValid and downTouchCount >= minLineTouches)
    trendQualityOk := not useTrendQualityFilter or (trendlineQuality >= minTrendlineQuality and touchCountOk)

    bool trendBuyBounceSignal  = useTrendBounce and nearUpTrendline   and bullishReversal and close > upTrendlineValue   and trendQualityOk
    bool trendSellBounceSignal = useTrendBounce and nearDownTrendline and bearishReversal and close < downTrendlineValue and trendQualityOk

    bool trendBuyBreakSignal  = useTrendBreak and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and close > downTrendlineValue and close[1] <= downTrendlineValue[1]
    bool trendSellBreakSignal = useTrendBreak and not na(upTrendlineValue) and not na(upTrendlineValue[1]) and close < upTrendlineValue and close[1] >= upTrendlineValue[1]

    var int trendBreakUpBar   = na
    var int trendBreakDownBar = na
    if trendBuyBreakSignal
        trendBreakUpBar := bar_index
    if trendSellBreakSignal
        trendBreakDownBar := bar_index
    bool trendBuyRetestSignal  = useTrendRetest and not na(trendBreakUpBar)   and (bar_index - trendBreakUpBar)   <= trendRetestBars and not na(downTrendlineValue) and f_tlNear(low, downTrendlineValue, trendTouchRange) and close > downTrendlineValue and bullishReversal
    bool trendSellRetestSignal = useTrendRetest and not na(trendBreakDownBar) and (bar_index - trendBreakDownBar) <= trendRetestBars and not na(upTrendlineValue)   and f_tlNear(high, upTrendlineValue, trendTouchRange) and close < upTrendlineValue and bearishReversal

    bool trendBuyFakeBreakSignal  = useTrendFakeBreak and not na(upTrendlineValue)   and not na(upTrendlineValue[1])   and low  < upTrendlineValue   and close > upTrendlineValue   and close[1] <= upTrendlineValue[1]   and bullishReversal
    bool trendSellFakeBreakSignal = useTrendFakeBreak and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and high > downTrendlineValue and close < downTrendlineValue and close[1] >= downTrendlineValue[1] and bearishReversal

    bool channelBuyBounceSignal  = useChannel and useChannelBounce and (nearUpChannelLower or nearDownChannelLower) and bullishReversal
    bool channelSellBounceSignal = useChannel and useChannelBounce and (nearUpChannelUpper or nearDownChannelUpper) and bearishReversal

    bool channelBuyBreakSignal  = useChannel and useChannelBreak and ((not na(upChannelUpper) and not na(upChannelUpper[1]) and close > upChannelUpper and close[1] <= upChannelUpper[1]) or (not na(downChannelUpper) and not na(downChannelUpper[1]) and close > downChannelUpper and close[1] <= downChannelUpper[1]))
    bool channelSellBreakSignal = useChannel and useChannelBreak and ((not na(upChannelLower) and not na(upChannelLower[1]) and close < upChannelLower and close[1] >= upChannelLower[1]) or (not na(downChannelLower) and not na(downChannelLower[1]) and close < downChannelLower and close[1] >= downChannelLower[1]))

    var int chBreakUpBar = na
    var int chBreakDnBar = na
    if channelBuyBreakSignal
        chBreakUpBar := bar_index
    if channelSellBreakSignal
        chBreakDnBar := bar_index
    bool channelBuyRetestSignal  = useChannel and useChannelRetest and not na(chBreakUpBar) and (bar_index - chBreakUpBar) <= channelRetestBars and bullishReversal and ((not na(upChannelUpper) and f_tlNear(low, upChannelUpper, trendTouchRange) and close > upChannelUpper) or (not na(downChannelUpper) and f_tlNear(low, downChannelUpper, trendTouchRange) and close > downChannelUpper))
    bool channelSellRetestSignal = useChannel and useChannelRetest and not na(chBreakDnBar) and (bar_index - chBreakDnBar) <= channelRetestBars and bearishReversal and ((not na(upChannelLower) and f_tlNear(high, upChannelLower, trendTouchRange) and close < upChannelLower) or (not na(downChannelLower) and f_tlNear(high, downChannelLower, trendTouchRange) and close < downChannelLower))

    float channelPosition = (upValid and not na(upChannelWidth) and upChannelWidth > 0) ? (close - upChannelLower) / upChannelWidth * 100.0 : (downValid and not na(downChannelWidth) and downChannelWidth > 0) ? (close - downChannelLower) / downChannelWidth * 100.0 : na
    bool ch_posTop    = not na(channelPosition) and channelPosition >= 67
    bool ch_posBottom = not na(channelPosition) and channelPosition <= 33
    bool ch_biasOn = useChannelPositionBias and not na(channelPosition)
    bool channelBiasLong  = ch_biasOn and ((channelSlopeState == 1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posBottom))
    bool channelBiasShort = ch_biasOn and ((channelSlopeState == -1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posTop))

    bool trendNoTradeWeakLine = useTrendNoTradeWeakLine and trendlineQuality < minTrendlineQuality
    trendNoTradeLong  := trendNoTradeWeakLine
    trendNoTradeShort := trendNoTradeWeakLine

    int trendEnabledCount = (useTrendBounce ? 1 : 0) + (useTrendBreak ? 1 : 0) + (useTrendRetest ? 1 : 0) + (useTrendFakeBreak ? 1 : 0) + ((useChannel and useChannelBounce) ? 1 : 0) + ((useChannel and useChannelBreak) ? 1 : 0) + ((useChannel and useChannelRetest) ? 1 : 0)
    int trendFiredBuy = (trendBuyBounceSignal ? 1 : 0) + (trendBuyBreakSignal ? 1 : 0) + (trendBuyRetestSignal ? 1 : 0) + (trendBuyFakeBreakSignal ? 1 : 0) + (channelBuyBounceSignal ? 1 : 0) + (channelBuyBreakSignal ? 1 : 0) + (channelBuyRetestSignal ? 1 : 0) + (channelBiasLong ? 1 : 0)
    int trendFiredSell = (trendSellBounceSignal ? 1 : 0) + (trendSellBreakSignal ? 1 : 0) + (trendSellRetestSignal ? 1 : 0) + (trendSellFakeBreakSignal ? 1 : 0) + (channelSellBounceSignal ? 1 : 0) + (channelSellBreakSignal ? 1 : 0) + (channelSellRetestSignal ? 1 : 0) + (channelBiasShort ? 1 : 0)
    trendEntryBuy  := (trendFiredBuy  >= 1) and (trendEntryMode == "All" ? (trendEnabledCount > 0 and trendFiredBuy  >= trendEnabledCount) : true) and not trendNoTradeLong
    trendEntrySell := (trendFiredSell >= 1) and (trendEntryMode == "All" ? (trendEnabledCount > 0 and trendFiredSell >= trendEnabledCount) : true) and not trendNoTradeShort

var bool longTrendStateOk  = false
var bool shortTrendStateOk = false
var int  longTrendStateBar  = na
var int  shortTrendStateBar = na

if useTrendWZ and useTrendStateWindow
    if trendEntryBuy
        longTrendStateOk := true
        longTrendStateBar := bar_index
    if trendEntrySell
        shortTrendStateOk := true
        shortTrendStateBar := bar_index
    if longTrendStateOk and not na(longTrendStateBar) and bar_index - longTrendStateBar > trendStateMaxBars
        longTrendStateOk := false
    if shortTrendStateOk and not na(shortTrendStateBar) and bar_index - shortTrendStateBar > trendStateMaxBars
        shortTrendStateOk := false

bool trendLongWinZone  = useTrendWZ ? (useTrendStateWindow ? (longTrendStateOk  and trendQualityOk and not trendNoTradeLong)  : (trendEntryBuy  and trendQualityOk and not trendNoTradeLong))  : false
bool trendShortWinZone = useTrendWZ ? (useTrendStateWindow ? (shortTrendStateOk and trendQualityOk and not trendNoTradeShort) : (trendEntrySell and trendQualityOk and not trendNoTradeShort)) : false

// ============================================================
//  5b-2h. Bollinger Bands WinZone モジュール (判定ロジックのみ)
// ------------------------------------------------------------
//  FVG/Volume/Fib/EMA/Line/Trend と並列の場所条件。useBBWZ=false の時は
//  ta.sma/ta.stdev/ta.atr/BB計算/状態管理更新 を一切走らせない (軽量)。描画なし。
//  出力 : bbLongWinZone / bbShortWinZone
// ============================================================
bool bbEntryBuy         = false
bool bbEntrySell        = false
bool bbDirectionOkLong  = true
bool bbDirectionOkShort = true
bool bbNoTradeLong      = false
bool bbNoTradeShort     = false
bool bbPercentBOkLong   = true
bool bbPercentBOkShort  = true
bool bbZScoreOkLong     = true
bool bbZScoreOkShort    = true

//if useBBWZ
//    float basis = ta.sma(bbSource, bbLen)
//    float dev   = ta.stdev(bbSource, bbLen)
//    float upper1 = basis + dev * bbMult1
//    float lower1 = basis - dev * bbMult1
//    float upper2 = basis + dev * bbMult2
//    float lower2 = basis - dev * bbMult2
//    float upper3 = basis + dev * bbMult3
//    float lower3 = basis - dev * bbMult3
//    float bandWidth = upper2 - lower2
//    float percentB = (upper2 - lower2) != 0 ? (bbSource - lower2) / (upper2 - lower2) : na
//    float zScore   = (not na(dev) and dev != 0) ? (bbSource - basis) / dev : na
//
//    bool bbAboveBasis = close > basis
//    bool bbBelowBasis = close < basis
//    float bbSlope = basis - basis[bbSlopeLookback]
//    bool bbSlopeUp   = bbSlope > 0
//    bool bbSlopeDown = bbSlope < 0
//
//    float bb_body   = math.abs(close - open)
//    float bb_upWick = high - math.max(open, close)
//    float bb_dnWick = math.min(open, close) - low
//    bool bb_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
//    bool bb_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
//    bool bb_pinLower = bb_dnWick >= bb_body and bb_dnWick >= bb_upWick
//    bool bb_pinUpper = bb_upWick >= bb_body and bb_upWick >= bb_dnWick
//    bool bb_bullishReversal = bb_bullEngulf or bb_pinLower or close > open
//    bool bb_bearishReversal = bb_bearEngulf or bb_pinUpper or close < open
//    float bb_touchRange = bbTouchMode == "ATR" ? ta.atr(14) * bbTouchATR : bbTouchDollar
//
//    // A: BB方向フィルター
//    bbDirectionOkLong  := not useBBDirectionFilter or (bbAboveBasis and bbSlopeUp)
//    bbDirectionOkShort := not useBBDirectionFilter or (bbBelowBasis and bbSlopeDown)
//
//    // B: 極端な外側NoTrade
//    bool bbNoTradeLongBase  = useBBOutsideNoTrade and not na(zScore) and zScore >= bbExtremeZ
//    bool bbNoTradeShortBase = useBBOutsideNoTrade and not na(zScore) and zScore <= -bbExtremeZ
//
//    // C: ±2σ反発
//    bool bbBuyReversal2Signal  = useBBReversal2 and low  <= lower2 and bb_bullishReversal and close > lower2
//    bool bbSellReversal2Signal = useBBReversal2 and high >= upper2 and bb_bearishReversal and close < upper2
//
//    // D: ±3σ反発
//    bool bbBuyReversal3Signal  = useBBReversal3 and low  <= lower3 and bb_bullishReversal and close > lower3
//    bool bbSellReversal3Signal = useBBReversal3 and high >= upper3 and bb_bearishReversal and close < upper3
//
//    // E: Band Walk
//    bool bbBuyBandWalkSignal  = useBBBandWalk and ta.lowest(close, bbBandWalkBars)  > basis and close >= upper1
//    bool bbSellBandWalkSignal = useBBBandWalk and ta.highest(close, bbBandWalkBars) < basis and close <= lower1
//    bool bbBandWalkLong  = bbBuyBandWalkSignal
//    bool bbBandWalkShort = bbSellBandWalkSignal
//
//    // F: スクイーズ
//    float bbWidthLowest  = ta.lowest(bandWidth, bbSqueezeLookback)
//    float bbWidthHighest = ta.highest(bandWidth, bbSqueezeLookback)
//    float bbWidthRank = (bbWidthHighest - bbWidthLowest) != 0 ? (bandWidth - bbWidthLowest) / (bbWidthHighest - bbWidthLowest) * 100.0 : na
//    bool bbSqueezeSignal = useBBSqueeze and not na(bbWidthRank) and bbWidthRank <= bbSqueezePercentile
//
//    // NoTrade 統合
//    bool bbNoTradeLongWalk  = useBBBandWalkBlockReverse and bbBandWalkShort
//    bool bbNoTradeShortWalk = useBBBandWalkBlockReverse and bbBandWalkLong
//    bbNoTradeLong  := bbNoTradeLongBase  or bbNoTradeLongWalk or (useBBSqueezeNoTrade and bbSqueezeSignal)
//    bbNoTradeShort := bbNoTradeShortBase or bbNoTradeShortWalk or (useBBSqueezeNoTrade and bbSqueezeSignal)
//
//    // G: エクスパンション
//    bool bbExpansion = not na(bandWidth[bbExpansionLookback]) and bandWidth > bandWidth[bbExpansionLookback] * bbExpansionMinRatio
//    bool bbBuyExpansionSignal  = useBBExpansion and bbExpansion and bbAboveBasis and bbSlopeUp
//    bool bbSellExpansionSignal = useBBExpansion and bbExpansion and bbBelowBasis and bbSlopeDown
//
//    // H: ミドルライン反発
//    bool bbBuyMiddleBounceSignal  = useBBMiddleBounce and bbSlopeUp   and low  <= basis + bb_touchRange and close > basis and bb_bullishReversal
//    bool bbSellMiddleBounceSignal = useBBMiddleBounce and bbSlopeDown and high >= basis - bb_touchRange and close < basis and bb_bearishReversal
//
//    // I: ミドルラインブレイク
//    bool bbBuyMiddleBreakSignal  = useBBMiddleBreak and ta.crossover(close, basis)
//    bool bbSellMiddleBreakSignal = useBBMiddleBreak and ta.crossunder(close, basis)
//
//    // J: %B判定 / K: ZScore判定
//    bbPercentBOkLong  := not useBBPercentB or (not na(percentB) and percentB >= bbPercentBLongMin)
//    bbPercentBOkShort := not useBBPercentB or (not na(percentB) and percentB <= bbPercentBShortMax)
//    bbZScoreOkLong  := not useBBZScore or (not na(zScore) and zScore >= bbZLongMin)
//    bbZScoreOkShort := not useBBZScore or (not na(zScore) and zScore <= bbZShortMax)
//
//    // エントリー結合 (Any / All)
//    int bbEnabledCount = (useBBReversal2 ? 1 : 0) + (useBBReversal3 ? 1 : 0) + (useBBBandWalk ? 1 : 0) + (useBBExpansion ? 1 : 0) + (useBBMiddleBounce ? 1 : 0) + (useBBMiddleBreak ? 1 : 0)
//    int bbFiredBuy  = (bbBuyReversal2Signal ? 1 : 0) + (bbBuyReversal3Signal ? 1 : 0) + (bbBuyBandWalkSignal ? 1 : 0) + (bbBuyExpansionSignal ? 1 : 0) + (bbBuyMiddleBounceSignal ? 1 : 0) + (bbBuyMiddleBreakSignal ? 1 : 0)
//    int bbFiredSell = (bbSellReversal2Signal ? 1 : 0) + (bbSellReversal3Signal ? 1 : 0) + (bbSellBandWalkSignal ? 1 : 0) + (bbSellExpansionSignal ? 1 : 0) + (bbSellMiddleBounceSignal ? 1 : 0) + (bbSellMiddleBreakSignal ? 1 : 0)
//    bbEntryBuy  := bbEnabledCount > 0 and (bbEntryMode == "All" ? bbFiredBuy  == bbEnabledCount : bbFiredBuy  >= 1)
//    bbEntrySell := bbEnabledCount > 0 and (bbEntryMode == "All" ? bbFiredSell == bbEnabledCount : bbFiredSell >= 1)

var bool bbLongState     = false
var bool bbShortState    = false
var int  bbLongStateBar  = na
var int  bbShortStateBar = na

//if useBBWZ and useBBStateWindow
//    if bbEntryBuy
//        bbLongState    := true
//        bbLongStateBar := bar_index
//    if bbEntrySell
//        bbShortState    := true
//        bbShortStateBar := bar_index
//    if bbLongState and not na(bbLongStateBar) and bar_index - bbLongStateBar > bbStateMaxBars
//        bbLongState := false
//    if bbShortState and not na(bbShortStateBar) and bar_index - bbShortStateBar > bbStateMaxBars
//        bbShortState := false

bool bbLongWinZone  = useBBWZ ? (useBBStateWindow ? (bbLongState  and bbDirectionOkLong  and not bbNoTradeLong  and bbPercentBOkLong  and bbZScoreOkLong)  : (bbEntryBuy  and bbDirectionOkLong  and not bbNoTradeLong  and bbPercentBOkLong  and bbZScoreOkLong))  : false
bool bbShortWinZone = useBBWZ ? (useBBStateWindow ? (bbShortState and bbDirectionOkShort and not bbNoTradeShort and bbPercentBOkShort and bbZScoreOkShort) : (bbEntrySell and bbDirectionOkShort and not bbNoTradeShort and bbPercentBOkShort and bbZScoreOkShort)) : false

// ============================================================
// ===== H&S モジュール 一時停止 (compiled tokens 上限 / ロジック不変) =====
// ------------------------------------------------------------
//  FVG/Volume/Fib/EMA/Line/Trend/BB と同じ WinZone (場所条件) 階層。
//  出力: hsLongWinZone / hsShortWinZone (BUY=逆三尊系 / SELL=三尊系)。
//  ・useHSWZ=false の時は request.security・Pivot・Queue・配列操作・
//    Quality・Retest・Break・Invalidation を一切実行しない (軽量)。
//  ・判定ロジックのみ (描画なし)。
// ============================================================

// Pivot 間にある反対 Pivot を探す (pure。呼ばれない時は実行されない)
f_findBetween(_vals, _idxs, _lo, _hi) =>
    float _res = na
    if array.size(_vals) > 0
        for i = 0 to array.size(_vals) - 1
            int _id = array.get(_idxs, i)
            if _id > _lo and _id < _hi
                _res := array.get(_vals, i)
    _res

// --- Pivot 配列 (var: 状態保持。宣言はグローバル / 操作は if useHSWZ 内のみ) ---
var array<float> phVals = array.new_float()
var array<int>   phIdx  = array.new_int()
var array<float> plVals = array.new_float()
var array<int>   plIdx  = array.new_int()
var int htfCount     = 0
var int lastPivotDir = 0

// --- Pattern Queue (完成パターン最大5件) ---
var array<float> qSellNeck     = array.new_float()
var array<float> qSellHead     = array.new_float()
var array<float> qSellRS       = array.new_float()
var array<float> qSellLS       = array.new_float()
var array<int>   qSellCreated  = array.new_int()
var array<int>   qSellBreakBar = array.new_int()
var array<bool>  qSellBroke    = array.new_bool()
var array<float> qBuyNeck     = array.new_float()
var array<float> qBuyHead     = array.new_float()
var array<float> qBuyRS       = array.new_float()
var array<float> qBuyLS       = array.new_float()
var array<int>   qBuyCreated  = array.new_int()
var array<int>   qBuyBreakBar = array.new_int()
var array<bool>  qBuyBroke    = array.new_bool()

// --- 最新パターンのスカラ状態 (var) ---
var float sellLeftShoulderHigh  = na
var float sellHeadHigh          = na
var float sellRightShoulderHigh = na
var float necklineSell          = na
var bool  sellPatternFound      = false
var bool  sellBreakDone         = false
var int   sellBreakBar          = na
var float buyLeftShoulderLow  = na
var float buyHeadLow          = na
var float buyRightShoulderLow = na
var float necklineBuy         = na
var bool  buyPatternFound     = false
var bool  buyBreakDone        = false
var int   buyBreakBar         = na
var float bsSellHead = na
var float bsSellLS   = na
var bool  sellRSBuilding = false
var float bsBuyHead = na
var float bsBuyLS   = na
var bool  buyRSBuilding = false

// --- H&S 出力 (if外で初期化) ---
bool hsSellPattern      = false
bool hsBuyPattern       = false
bool hsSellBreak        = false
bool hsBuyBreak         = false
bool hsSellRetest       = false
bool hsBuyRetest        = false
bool hsSellInvalidation = false
bool hsBuyInvalidation  = false
bool hsBiasLong         = false
bool hsBiasShort        = false
bool hsNoTrade          = false
bool hsLongEventOk      = false
bool hsShortEventOk     = false
string hsLongEventType  = ""
string hsShortEventType = ""
//
if useHSWZ
    float atrHS = ta.atr(retestAtrLen)
    float retestRange = atrHS * retestAtrMult
    // --- HTF Pivot (確定後のみ / lookahead_off) ---
    [htfPh, htfPl, htfClose, htfHigh, htfLow, htfTime] = request.security(syminfo.tickerid, patternTf, [ta.pivothigh(pivotLen, pivotLen), ta.pivotlow(pivotLen, pivotLen), close[1], high[1], low[1], time], lookahead = barmerge.lookahead_off)
    bool newHTF = na(htfTime[1]) ? false : htfTime != htfTime[1]
    // バー内イベントフラグ
    bool sellRSFailEventHTF = false
    bool buyRSFailEventHTF  = false
    // --- パターン検出 (newHTF 時) ---
    if newHTF
        htfCount := htfCount + 1
        int _pIdx = htfCount - pivotLen
        if not na(htfPh)
            if lastPivotDir == 1 and array.size(phVals) > 0
                int _li = array.size(phVals) - 1
                if htfPh > array.get(phVals, _li)
                    array.set(phVals, _li, htfPh)
                    array.set(phIdx,  _li, _pIdx)
            else
                array.push(phVals, htfPh)
                array.push(phIdx,  _pIdx)
                lastPivotDir := 1
                while array.size(phVals) > 10
                    array.shift(phVals)
                    array.shift(phIdx)
        if not na(htfPl)
            if lastPivotDir == -1 and array.size(plVals) > 0
                int _li = array.size(plVals) - 1
                if htfPl < array.get(plVals, _li)
                    array.set(plVals, _li, htfPl)
                    array.set(plIdx,  _li, _pIdx)
            else
                array.push(plVals, htfPl)
                array.push(plIdx,  _pIdx)
                lastPivotDir := -1
                while array.size(plVals) > 10
                    array.shift(plVals)
                    array.shift(plIdx)
        // 三尊 (直近3つの PH)
        int nH = array.size(phVals)
        if nH >= 3
            float lsN = array.get(phVals, nH - 3)
            float hdN = array.get(phVals, nH - 2)
            float rsN = array.get(phVals, nH - 1)
            int lsNI = array.get(phIdx, nH - 3)
            int hdNI = array.get(phIdx, nH - 2)
            int rsNI = array.get(phIdx, nH - 1)
            float nl1 = f_findBetween(plVals, plIdx, lsNI, hdNI)
            float nl2 = f_findBetween(plVals, plIdx, hdNI, rsNI)
            bool promOk = not useHeadProm or (hdN - math.max(lsN, rsN)) > atrHS * headPromMult
            bool symOk  = math.abs(lsN - rsN) / hdN <= shoulderTolerancePct
            bool headHi = hdN > lsN and hdN > rsN
            if headHi and symOk and promOk and not na(nl1) and not na(nl2)
                array.push(qSellNeck, (nl1 + nl2) / 2.0)
                array.push(qSellHead, hdN)
                array.push(qSellRS, rsN)
                array.push(qSellLS, lsN)
                array.push(qSellCreated, bar_index)
                array.push(qSellBreakBar, -1)
                array.push(qSellBroke, false)
                if array.size(qSellNeck) > 5
                    array.shift(qSellNeck)
                    array.shift(qSellHead)
                    array.shift(qSellRS)
                    array.shift(qSellLS)
                    array.shift(qSellCreated)
                    array.shift(qSellBreakBar)
                    array.shift(qSellBroke)
            else if headHi and not symOk
                sellRSFailEventHTF := true
        // 逆三尊 (直近3つの PL)
        int nL = array.size(plVals)
        if nL >= 3
            float lsbN = array.get(plVals, nL - 3)
            float hdbN = array.get(plVals, nL - 2)
            float rsbN = array.get(plVals, nL - 1)
            int lsbNI = array.get(plIdx, nL - 3)
            int hdbNI = array.get(plIdx, nL - 2)
            int rsbNI = array.get(plIdx, nL - 1)
            float nh1 = f_findBetween(phVals, phIdx, lsbNI, hdbNI)
            float nh2 = f_findBetween(phVals, phIdx, hdbNI, rsbNI)
            bool promOkB = not useHeadProm or (math.min(lsbN, rsbN) - hdbN) > atrHS * headPromMult
            bool symOkB  = math.abs(lsbN - rsbN) / hdbN <= shoulderTolerancePct
            bool headLo  = hdbN < lsbN and hdbN < rsbN
            if headLo and symOkB and promOkB and not na(nh1) and not na(nh2)
                array.push(qBuyNeck, (nh1 + nh2) / 2.0)
                array.push(qBuyHead, hdbN)
                array.push(qBuyRS, rsbN)
                array.push(qBuyLS, lsbN)
                array.push(qBuyCreated, bar_index)
                array.push(qBuyBreakBar, -1)
                array.push(qBuyBroke, false)
                if array.size(qBuyNeck) > 5
                    array.shift(qBuyNeck)
                    array.shift(qBuyHead)
                    array.shift(qBuyRS)
                    array.shift(qBuyLS)
                    array.shift(qBuyCreated)
                    array.shift(qBuyBreakBar)
                    array.shift(qBuyBroke)
            else if headLo and not symOkB
                buyRSFailEventHTF := true
        // 右肩形成中 (SELL)
        int nHs = array.size(phVals)
        float fHead = na
        int   fHeadI = na
        if nHs > 0
            for i = 0 to nHs - 1
                float v = array.get(phVals, i)
                if na(fHead) or v > fHead
                    fHead := v
                    fHeadI := array.get(phIdx, i)
        float fLS = na
        if nHs > 0 and not na(fHeadI)
            for i = 0 to nHs - 1
                int idx = array.get(phIdx, i)
                float v = array.get(phVals, i)
                if idx < fHeadI and v < fHead
                    if na(fLS) or v > fLS
                        fLS := v
        if not na(fHead) and not na(fLS)
            bsSellHead := fHead
            bsSellLS := fLS
            sellRSBuilding := true
        else
            sellRSBuilding := false
        // 右肩形成中 (BUY)
        int nLs = array.size(plVals)
        float fHeadB = na
        int   fHeadBI = na
        if nLs > 0
            for i = 0 to nLs - 1
                float v = array.get(plVals, i)
                if na(fHeadB) or v < fHeadB
                    fHeadB := v
                    fHeadBI := array.get(plIdx, i)
        float fLSB = na
        if nLs > 0 and not na(fHeadBI)
            for i = 0 to nLs - 1
                int idx = array.get(plIdx, i)
                float v = array.get(plVals, i)
                if idx < fHeadBI and v > fHeadB
                    if na(fLSB) or v < fLSB
                        fLSB := v
        if not na(fHeadB) and not na(fLSB)
            bsBuyHead := fHeadB
            bsBuyLS := fLSB
            buyRSBuilding := true
        else
            buyRSBuilding := false
    // --- Queue: Break / Retest / 期限切れ (SELL) ---
    bool sellBreakEvent   = false
    bool sellRetestEvent  = false
    bool sellExpiredEvent = false
    if array.size(qSellNeck) > 0
        int i = array.size(qSellNeck) - 1
        while i >= 0
            float nk = array.get(qSellNeck, i)
            bool broke = array.get(qSellBroke, i)
            int createdB = array.get(qSellCreated, i)
            int brokeB = array.get(qSellBreakBar, i)
            bool remove = false
            if not broke
                if not na(htfClose) and htfClose < nk
                    array.set(qSellBroke, i, true)
                    array.set(qSellBreakBar, i, bar_index)
                    sellBreakEvent := true
                else if bar_index - createdB > setupValidBars
                    remove := true
                    sellExpiredEvent := true
            else
                if high >= nk - retestRange and close <= nk + retestRange
                    sellRetestEvent := true
                if bar_index - brokeB > setupValidBars
                    remove := true
            if remove
                array.remove(qSellNeck, i)
                array.remove(qSellHead, i)
                array.remove(qSellRS, i)
                array.remove(qSellLS, i)
                array.remove(qSellCreated, i)
                array.remove(qSellBreakBar, i)
                array.remove(qSellBroke, i)
            i := i - 1
    // --- Queue: Break / Retest / 期限切れ (BUY) ---
    bool buyBreakEvent   = false
    bool buyRetestEvent  = false
    bool buyExpiredEvent = false
    if array.size(qBuyNeck) > 0
        int i = array.size(qBuyNeck) - 1
        while i >= 0
            float nk = array.get(qBuyNeck, i)
            bool broke = array.get(qBuyBroke, i)
            int createdB = array.get(qBuyCreated, i)
            int brokeB = array.get(qBuyBreakBar, i)
            bool remove = false
            if not broke
                if not na(htfClose) and htfClose > nk
                    array.set(qBuyBroke, i, true)
                    array.set(qBuyBreakBar, i, bar_index)
                    buyBreakEvent := true
                else if bar_index - createdB > setupValidBars
                    remove := true
                    buyExpiredEvent := true
            else
                if low <= nk + retestRange and close >= nk - retestRange
                    buyRetestEvent := true
                if bar_index - brokeB > setupValidBars
                    remove := true
            if remove
                array.remove(qBuyNeck, i)
                array.remove(qBuyHead, i)
                array.remove(qBuyRS, i)
                array.remove(qBuyLS, i)
                array.remove(qBuyCreated, i)
                array.remove(qBuyBreakBar, i)
                array.remove(qBuyBroke, i)
            i := i - 1
    // --- H&S 否定 (最新の未ブレイクパターンを消費 / 逆方向 Bias) ---
    if useHSInvalidation and array.size(qSellNeck) > 0
        int li = array.size(qSellNeck) - 1
        if not array.get(qSellBroke, li)
            float rs = array.get(qSellRS, li)
            if not na(rs) and close > rs + atrHS * invalidationAtrMult
                hsSellInvalidation := true
                array.remove(qSellNeck, li)
                array.remove(qSellHead, li)
                array.remove(qSellRS, li)
                array.remove(qSellLS, li)
                array.remove(qSellCreated, li)
                array.remove(qSellBreakBar, li)
                array.remove(qSellBroke, li)
    if useHSInvalidation and array.size(qBuyNeck) > 0
        int li = array.size(qBuyNeck) - 1
        if not array.get(qBuyBroke, li)
            float rs = array.get(qBuyRS, li)
            if not na(rs) and close < rs - atrHS * invalidationAtrMult
                hsBuyInvalidation := true
                array.remove(qBuyNeck, li)
                array.remove(qBuyHead, li)
                array.remove(qBuyRS, li)
                array.remove(qBuyLS, li)
                array.remove(qBuyCreated, li)
                array.remove(qBuyBreakBar, li)
                array.remove(qBuyBroke, li)
    // --- 右肩崩れ (頭更新 or 肩許容率超え) ---
    bool sellPriceFail = sellRSBuilding and not na(bsSellHead) and high > bsSellHead + atrHS * invalidationAtrMult
    bool buyPriceFail  = buyRSBuilding and not na(bsBuyHead) and low < bsBuyHead - atrHS * invalidationAtrMult
    bool hsRSFailedSell = sellPriceFail or sellRSFailEventHTF
    bool hsRSFailedBuy  = buyPriceFail or buyRSFailEventHTF
    if hsRSFailedSell
        sellRSBuilding := false
        bsSellHead := na
        bsSellLS := na
    if hsRSFailedBuy
        buyRSBuilding := false
        bsBuyHead := na
        bsBuyLS := na
    // --- 最新パターンのスカラ状態へ同期 ---
    int nSellQ = array.size(qSellNeck)
    sellPatternFound := nSellQ > 0
    if nSellQ > 0
        int li = nSellQ - 1
        necklineSell          := array.get(qSellNeck, li)
        sellHeadHigh          := array.get(qSellHead, li)
        sellLeftShoulderHigh  := array.get(qSellLS, li)
        sellRightShoulderHigh := array.get(qSellRS, li)
        sellBreakDone         := array.get(qSellBroke, li)
        int bb = array.get(qSellBreakBar, li)
        sellBreakBar          := bb < 0 ? na : bb
    else
        necklineSell          := na
        sellHeadHigh          := na
        sellLeftShoulderHigh  := na
        sellRightShoulderHigh := na
        sellBreakDone         := false
    int nBuyQ = array.size(qBuyNeck)
    buyPatternFound := nBuyQ > 0
    if nBuyQ > 0
        int li = nBuyQ - 1
        necklineBuy         := array.get(qBuyNeck, li)
        buyHeadLow          := array.get(qBuyHead, li)
        buyLeftShoulderLow  := array.get(qBuyLS, li)
        buyRightShoulderLow := array.get(qBuyRS, li)
        buyBreakDone        := array.get(qBuyBroke, li)
        int bb = array.get(qBuyBreakBar, li)
        buyBreakBar         := bb < 0 ? na : bb
    else
        necklineBuy         := na
        buyHeadLow          := na
        buyLeftShoulderLow  := na
        buyRightShoulderLow := na
        buyBreakDone        := false
    // Break / Retest 集約
    hsSellBreak  := sellBreakEvent
    hsBuyBreak   := buyBreakEvent
    hsSellRetest := sellRetestEvent
    hsBuyRetest  := buyRetestEvent
    // --- 反転ローソク ---
    float _hsBody    = math.abs(close - open)
    float _hsAvgBody = ta.sma(math.abs(close - open), 20)
    bool _hsStrongBody = not useHSBodyFilter or _hsBody > _hsAvgBody * hsBodyMult
    bool _hsBearEng = close < open and open >= close[1] and close <= open[1] and _hsStrongBody
    bool _hsBullEng = close > open and open <= close[1] and close >= open[1] and _hsStrongBody
    float _hsBarRng = math.max(high - low, syminfo.mintick)
    float _hsUpWick = high - math.max(open, close)
    float _hsDnWick = math.min(open, close) - low
    bool _hsBearPin = _hsUpWick / _hsBarRng >= hsPinWickRatio
    bool _hsBullPin = _hsDnWick / _hsBarRng >= hsPinWickRatio
    bool sellReversal = not useHSReversalCandle or _hsBearEng or _hsBearPin
    bool buyReversal  = not useHSReversalCandle or _hsBullEng or _hsBullPin
    bool sellCloseStrong = not useCloseStrong or close <= low + _hsBarRng * closeStrongFrac
    bool buyCloseStrong  = not useCloseStrong or close >= high - _hsBarRng * closeStrongFrac
    // --- Legacy 型 (左肩戻り型) ---
    float rsCandHigh = math.max(high, high[1])
    float rsCandLow  = math.min(low, low[1])
    bool retSell = not na(sellLeftShoulderHigh) and math.abs(rsCandHigh - sellLeftShoulderHigh) / sellLeftShoulderHigh <= shoulderTolerancePct
    bool retBuy  = not na(buyLeftShoulderLow) and math.abs(rsCandLow - buyLeftShoulderLow) / buyLeftShoulderLow <= shoulderTolerancePct
    bool headOkSell = not na(sellHeadHigh) and high <= sellHeadHigh
    bool headOkBuy  = not na(buyHeadLow) and low >= buyHeadLow
    bool headPromOkSell = not useHeadProm or (not na(sellHeadHigh) and not na(sellLeftShoulderHigh) and (sellHeadHigh - sellLeftShoulderHigh) > atrHS * headPromMult)
    bool headPromOkBuy  = not useHeadProm or (not na(buyHeadLow) and not na(buyLeftShoulderLow) and (buyLeftShoulderLow - buyHeadLow) > atrHS * headPromMult)
    bool hsSellLegacy = headOkSell and retSell and sellReversal and headPromOkSell
    bool hsBuyLegacy  = headOkBuy and retBuy and buyReversal and headPromOkBuy
    // --- Quality Score ---
    float sellSymPts = (na(sellHeadHigh) or na(sellLeftShoulderHigh) or na(sellRightShoulderHigh) or sellHeadHigh == 0 or shoulderTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(sellLeftShoulderHigh - sellRightShoulderHigh) / sellHeadHigh) / shoulderTolerancePct))
    float buySymPts = (na(buyHeadLow) or na(buyLeftShoulderLow) or na(buyRightShoulderLow) or buyHeadLow == 0 or shoulderTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(buyLeftShoulderLow - buyRightShoulderLow) / buyHeadLow) / shoulderTolerancePct))
    int hsSellQuality = math.min(100, math.round(sellSymPts) + (headPromOkSell and useHeadProm ? 20 : 0) + (not na(necklineSell) ? 20 : 0) + (sellBreakDone ? 15 : 0) + (hsSellRetest ? 15 : 0) + ((useHSReversalCandle and (_hsBearEng or _hsBearPin)) ? 10 : 0))
    int hsBuyQuality = math.min(100, math.round(buySymPts) + (headPromOkBuy and useHeadProm ? 20 : 0) + (not na(necklineBuy) ? 20 : 0) + (buyBreakDone ? 15 : 0) + (hsBuyRetest ? 15 : 0) + ((useHSReversalCandle and (_hsBullEng or _hsBullPin)) ? 10 : 0))
    int hsQuality = math.max(hsSellQuality, hsBuyQuality)
    bool qualityOk = not useHSQualityFilter or hsQuality >= minHSQuality
    // --- WinZone イベント (パターン別。品質・反転確認込み) ---
    bool hsBuyPatternWZ = buyPatternFound
    bool hsSellPatternWZ = sellPatternFound
    bool hsBuyBreakWZ  = buyBreakEvent and qualityOk
    bool hsSellBreakWZ = sellBreakEvent and qualityOk
    bool hsBuyRetestWZ  = buyRetestEvent and buyReversal and buyCloseStrong and qualityOk
    bool hsSellRetestWZ = sellRetestEvent and sellReversal and sellCloseStrong and qualityOk
    // 否定は逆方向: 三尊否定=BUY / 逆三尊否定=SELL
    bool hsBuyInvalWZ  = hsSellInvalidation
    bool hsSellInvalWZ = hsBuyInvalidation
    // Legacy モード対応 (hsMode==Legacy の時は Pattern/Any に Legacy を混ぜる)
    bool hsBuyLegacyOk  = hsMode == "Legacy" and hsBuyLegacy and qualityOk
    bool hsSellLegacyOk = hsMode == "Legacy" and hsSellLegacy and qualityOk
    // 出力フラグ (パターン/否定)
    hsSellPattern := sellPatternFound
    hsBuyPattern  := buyPatternFound
    // Bias = 全イベントの論理和
    hsBiasLong  := hsBuyPatternWZ or hsBuyBreakWZ or hsBuyRetestWZ or hsBuyInvalWZ or hsBuyLegacyOk
    hsBiasShort := hsSellPatternWZ or hsSellBreakWZ or hsSellRetestWZ or hsSellInvalWZ or hsSellLegacyOk
    // --- NoTrade (両パターン競合 / 低品質 / 期限切れ / 右肩崩れ / 否定) ---
    bool rConflict = hsSellPattern and hsBuyPattern
    bool rLowQual  = useHSQualityFilter and (hsSellPattern or hsBuyPattern) and not qualityOk
    bool rExpired  = sellExpiredEvent or buyExpiredEvent
    bool rFailedRS = hsRSFailedSell or hsRSFailedBuy
    hsNoTrade := rConflict or rLowQual or rExpired or rFailedRS
    // --- WinZone モード選択 (Pattern/Break/Retest/Invalidation/Any) + NoTrade ---
    bool _longSel  = hsWinZoneMode == "Pattern" ? hsBuyPatternWZ : hsWinZoneMode == "Break" ? hsBuyBreakWZ : hsWinZoneMode == "Retest" ? hsBuyRetestWZ : hsWinZoneMode == "Invalidation" ? hsBuyInvalWZ : hsBiasLong
    bool _shortSel = hsWinZoneMode == "Pattern" ? hsSellPatternWZ : hsWinZoneMode == "Break" ? hsSellBreakWZ : hsWinZoneMode == "Retest" ? hsSellRetestWZ : hsWinZoneMode == "Invalidation" ? hsSellInvalWZ : hsBiasShort
    hsLongEventOk  := _longSel  and not hsNoTrade
    hsShortEventOk := _shortSel and not hsNoTrade
    hsLongEventType  := hsWinZoneMode == "Any" ? (hsBuyRetestWZ ? "Retest" : hsBuyBreakWZ ? "Break" : hsBuyInvalWZ ? "Invalidation" : "Pattern") : hsWinZoneMode
    hsShortEventType := hsWinZoneMode == "Any" ? (hsSellRetestWZ ? "Retest" : hsSellBreakWZ ? "Break" : hsSellInvalWZ ? "Invalidation" : "Pattern") : hsWinZoneMode

// --- H&S 状態管理 (FVG/Volume/Fib/Accum と同思想) ---
var bool   hsLongState      = false
var bool   hsShortState     = false
var int    hsLongStateBar   = na
var int    hsShortStateBar  = na
var string hsLongStateType  = ""
var string hsShortStateType = ""

if useHSWZ and useHSStateWindow
    if hsLongEventOk
        hsLongState     := true
        hsLongStateBar  := bar_index
        hsLongStateType := hsLongEventType
    if hsShortEventOk
        hsShortState     := true
        hsShortStateBar  := bar_index
        hsShortStateType := hsShortEventType
    if hsLongState and not na(hsLongStateBar) and bar_index - hsLongStateBar > hsStateMaxBars
        hsLongState := false
    if hsShortState and not na(hsShortStateBar) and bar_index - hsShortStateBar > hsStateMaxBars
        hsShortState := false

// H&S WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool hsLongWinZone  = useHSWZ ? (useHSStateWindow ? hsLongState  : hsLongEventOk)  : false
bool hsShortWinZone = useHSWZ ? (useHSStateWindow ? hsShortState : hsShortEventOk) : false

// ============================================================
//  5b-2j. DT/DB (ダブル/トリプル トップ・ボトム) WinZone モジュール
// ------------------------------------------------------------
//  FVG/Volume/Fib/EMA/Line/Trend/BB/H&S と並列の WinZone (場所条件)。
//  出力: dtdbLongWinZone / dtdbShortWinZone (BUY=DB/TB系 / SELL=DT/TT系)。
//  ・useDTDBWZ=false の時は request.security・Pivot・配列・検出・Quality を
//    一切実行しない (軽量)。判定ロジックのみ (描画なし)。
//  ・pivot配列等は H&S と名前衝突しないよう dtdb 接頭辞にリネーム済み。
// ============================================================
// ===== DT/DB モジュール 一時停止 (compiled tokens 上限 / ロジック不変) =====
//f_dtdbFindBetween(array<float> _vals, array<int> _idxs, int _lo, int _hi) =>
//    (DT/DB 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)

bool dtdbBiasLong     = false
bool dtdbBiasShort    = false
bool dtdbNoTrade      = false
bool dtdbNoTradeLong  = false
bool dtdbNoTradeShort = false
int  dtdbSignalType   = 0
int  dtdbDirection    = 0
int  dtdbRank         = 0
int  dtdbQuality      = 0
//
//if useDTDBWZ
//    (DT/DB 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)

// --- DT/DB 状態管理 (FVG/H&S 等と同思想) + WinZone 出力 ---
var bool dtdbLongState     = false
var bool dtdbShortState    = false
var int  dtdbLongStateBar  = na
var int  dtdbShortStateBar = na

if useDTDBWZ and useDTDBStateWindow
    if dtdbBiasLong
        dtdbLongState    := true
        dtdbLongStateBar := bar_index
    if dtdbBiasShort
        dtdbShortState    := true
        dtdbShortStateBar := bar_index
    if dtdbLongState and not na(dtdbLongStateBar) and bar_index - dtdbLongStateBar > dtdbStateMaxBars
        dtdbLongState := false
    if dtdbShortState and not na(dtdbShortStateBar) and bar_index - dtdbShortStateBar > dtdbStateMaxBars
        dtdbShortState := false

bool dtdbLongWinZone  = useDTDBWZ ? (useDTDBStateWindow ? (dtdbLongState  and not dtdbNoTradeLong)  : (dtdbBiasLong  and not dtdbNoTradeLong))  : false
bool dtdbShortWinZone = useDTDBWZ ? (useDTDBStateWindow ? (dtdbShortState and not dtdbNoTradeShort) : (dtdbBiasShort and not dtdbNoTradeShort)) : false

// ============================================================
//  5b-2k. Wedge (ベア/ブル ウェッジ) WinZone モジュール
// ------------------------------------------------------------
//  Bear Wedge(Rising)=下限割れSELL / Bull Wedge(Falling)=上限抜けBUY。
//  Pattern / Break / Retest / Invalidation / Building / Quality。
//  FVG/Volume/Fib/BB/H&S/DT/DB と並列の WinZone (場所条件)。判定ロジックのみ。
//  useWedgeWZ=false の時は request.security/ta.*/pivot/配列/判定を走らせない。
//  htf* は他モジュールと衝突しないよう wedgeHtf* にリネーム済み。
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
//f_wedgeLinePrice(int _x1, float _y1, int _x2, float _y2, int _xNow) =>
//    (Wedge 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool wedgeBiasLong     = false
bool wedgeBiasShort    = false
bool wedgeEventLong    = false
bool wedgeEventShort   = false
bool wedgeNoTrade      = false
bool wedgeNoTradeLong  = false
bool wedgeNoTradeShort = false
int  wedgeQuality      = 0

//if useWedgeWZ
//    (Wedge 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)
//
// --- Wedge 状態管理 (FVG/H&S 等と同思想) + WinZone 出力 ---
var bool wedgeLongState     = false
var bool wedgeShortState    = false
var int  wedgeLongStateBar  = na
var int  wedgeShortStateBar = na

//if useWedgeWZ and useWedgeStateWindow
//    if wedgeEventLong
//        wedgeLongState    := true
//        wedgeLongStateBar := bar_index
//    if wedgeEventShort
//        wedgeShortState    := true
//        wedgeShortStateBar := bar_index
//    if wedgeLongState and not na(wedgeLongStateBar) and bar_index - wedgeLongStateBar > wedgeStateMaxBars
//        wedgeLongState := false
//    if wedgeShortState and not na(wedgeShortStateBar) and bar_index - wedgeShortStateBar > wedgeStateMaxBars
//        wedgeShortState := false

bool wedgeLongWinZone  = useWedgeWZ ? (useWedgeStateWindow ? (wedgeLongState  and not wedgeNoTradeLong)  : (wedgeEventLong  and not wedgeNoTradeLong))  : false
bool wedgeShortWinZone = useWedgeWZ ? (useWedgeStateWindow ? (wedgeShortState and not wedgeNoTradeShort) : (wedgeEventShort and not wedgeNoTradeShort)) : false

// ============================================================
//  5b-2l. Triangle (アセ/ディセ/シンメトリカル) WinZone モジュール
// ------------------------------------------------------------
//  Ascending / Descending / Symmetrical Triangle。
//  Pattern / Break / Retest / FakeBreak / Invalidation / Quality。
//  Sym は Break後のみ Bias、未Break中は NoTrade。判定ロジックのみ (描画なし)。
//  FVG/BB/H&S/DT/DB/Wedge と並列の WinZone (場所条件)。
//  useTriangleWZ=false の時は request.security/ta.*/pivot/配列を走らせない。
//  htf* は他モジュールと衝突しないよう triHtf* にリネーム済み。
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
//f_triLinePrice(int _x1, float _y1, int _x2, float _y2, int _xNow) =>
//    (Triangle 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool triangleBiasLong     = false
bool triangleBiasShort    = false
bool triangleEventLong    = false
bool triangleEventShort   = false
bool triangleNoTrade      = false
bool triangleNoTradeLong  = false
bool triangleNoTradeShort = false
int  triangleQuality      = 0

//if useTriangleWZ
//    (Triangle 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)
//
// --- Triangle 状態管理 (FVG/H&S 等と同思想) + WinZone 出力 ---
var bool triangleLongState     = false
var bool triangleShortState    = false
var int  triangleLongStateBar  = na
var int  triangleShortStateBar = na

//if useTriangleWZ and useTriangleStateWindow
//    if triangleEventLong
//        triangleLongState    := true
//        triangleLongStateBar := bar_index
//    if triangleEventShort
//        triangleShortState    := true
//        triangleShortStateBar := bar_index
//    if triangleLongState and not na(triangleLongStateBar) and bar_index - triangleLongStateBar > triangleStateMaxBars
//        triangleLongState := false
//    if triangleShortState and not na(triangleShortStateBar) and bar_index - triangleShortStateBar > triangleStateMaxBars
//        triangleShortState := false

bool triangleLongWinZone  = useTriangleWZ ? (useTriangleStateWindow ? (triangleLongState  and not triangleNoTradeLong)  : (triangleEventLong  and not triangleNoTradeLong))  : false
bool triangleShortWinZone = useTriangleWZ ? (useTriangleStateWindow ? (triangleShortState and not triangleNoTradeShort) : (triangleEventShort and not triangleNoTradeShort)) : false

// ============================================================
//  5b-2m. Elliott Wave WinZone モジュール
// ------------------------------------------------------------
//  ③波候補 / ⑤波終了警戒 をスコア判定し WinZone (場所条件) として使う。
//  FVG/BB/H&S/Wedge/Triangle と並列。出力: elliottLongWinZone/elliottShortWinZone
//  (= ③波候補方向の Bias。状態管理＋⑤波警戒NoTrade込み)。判定ロジックのみ (描画なし)。
//  useElliottWZ=false の時は ta(ATR/RSI/MACD/EMA/Volume SMA/Pivot)・配列を走らせない。
//  macdSignal は本体MACDと衝突するため elliottMacdSignal にリネーム済み。
// ============================================================

// --- 出力 (OFF時デフォルト = 場所条件を通さない) ---
bool elliottBiasLong     = false
bool elliottBiasShort    = false
bool elliottNoTradeLong  = false
bool elliottNoTradeShort = false
bool elliottNoTrade      = false
int  elliottDirection    = 0
int  elliottScore        = 0
int  elliottRank         = 0
int  elliottSignalType   = 0

// --- 情報用 (OFF時デフォルト) ---
bool elliottW3CandLong   = false
bool elliottW3CandShort  = false
bool elliottWarnLongOn   = false
bool elliottWarnShortOn  = false
int  elliottW3ScoreLong  = 0
int  elliottW3ScoreShort = 0
int  elliottW5WarnLong   = 0
int  elliottW5WarnShort  = 0
int  elliottPivotCount   = 0
bool elliottMomLong      = false
bool elliottMomShort     = false
bool elliottEmaLong      = false
bool elliottEmaShort     = false

// --- 状態管理 (var: 全バー保持) ---
var bool longElliottStateOk   = false
var bool shortElliottStateOk  = false
var int  longElliottStateBar  = na
var int  shortElliottStateBar = na

if useElliottWZ
    // === 共通計算 (ON の時だけ ta を呼ぶ) ===
    float _atr  = ta.atr(elliottAtrLen)
    float _rsi  = ta.rsi(close, rsiLen)
    [_macd, _sig, _hist] = ta.macd(close, macdFast, macdSlow, elliottMacdSignal)
    float _emaF = ta.ema(close, emaFastLen)
    float _emaM = ta.ema(close, emaMidLen)
    float _emaS = ta.ema(close, emaSlowLen)
    float _vAvg = ta.sma(volume, elliottVolAvgLen)

    bool _momL   = _rsi > 50 and _rsi > _rsi[1] and _macd > _sig and _hist > _hist[1]
    bool _momS   = _rsi < 50 and _rsi < _rsi[1] and _macd < _sig and _hist < _hist[1]
    bool _emaL   = _emaF > _emaM and _emaM > _emaS and (_emaF - _emaM) > (_emaF[3] - _emaM[3])
    bool _emaShr = _emaF < _emaM and _emaM < _emaS and (_emaM - _emaF) > (_emaM[3] - _emaF[3])
    bool _volU   = not na(volume) and not na(_vAvg) and volume > _vAvg
    bool _volD   = not na(volume) and not na(_vAvg) and volume < _vAvg
    elliottMomLong  := _momL
    elliottMomShort := _momS
    elliottEmaLong  := _emaL
    elliottEmaShort := _emaShr

    // === Pivot 保存 (確定後のみ / 交互保持 / 同方向は極値更新 / 最大10) ===
    float _ph = ta.pivothigh(high, elliottPivotLen, elliottPivotLen)
    float _pl = ta.pivotlow(low,  elliottPivotLen, elliottPivotLen)

    var array<float> _pPrice = array.new_float()
    var array<int>   _pBar   = array.new_int()
    var array<int>   _pType  = array.new_int()
    var array<float> _pRsi   = array.new_float()
    var array<float> _pHist  = array.new_float()

    if not na(_ph)
        float _pr = _ph
        int   _bi = bar_index - elliottPivotLen
        float _rv = _rsi[elliottPivotLen]
        float _hv = _hist[elliottPivotLen]
        int   _n  = array.size(_pType)
        if _n > 0
            int _lt = array.get(_pType, _n - 1)
            if _lt == 1
                int _li = _n - 1
                if _pr > array.get(_pPrice, _li)
                    array.set(_pPrice, _li, _pr)
                    array.set(_pBar,   _li, _bi)
                    array.set(_pRsi,   _li, _rv)
                    array.set(_pHist,  _li, _hv)
            else
                array.push(_pPrice, _pr)
                array.push(_pBar,   _bi)
                array.push(_pType,  1)
                array.push(_pRsi,   _rv)
                array.push(_pHist,  _hv)
        else
            array.push(_pPrice, _pr)
            array.push(_pBar,   _bi)
            array.push(_pType,  1)
            array.push(_pRsi,   _rv)
            array.push(_pHist,  _hv)
        while array.size(_pPrice) > 10
            array.shift(_pPrice)
            array.shift(_pBar)
            array.shift(_pType)
            array.shift(_pRsi)
            array.shift(_pHist)

    if not na(_pl)
        float _pr = _pl
        int   _bi = bar_index - elliottPivotLen
        float _rv = _rsi[elliottPivotLen]
        float _hv = _hist[elliottPivotLen]
        int   _n  = array.size(_pType)
        if _n > 0
            int _lt = array.get(_pType, _n - 1)
            if _lt == -1
                int _li = _n - 1
                if _pr < array.get(_pPrice, _li)
                    array.set(_pPrice, _li, _pr)
                    array.set(_pBar,   _li, _bi)
                    array.set(_pRsi,   _li, _rv)
                    array.set(_pHist,  _li, _hv)
            else
                array.push(_pPrice, _pr)
                array.push(_pBar,   _bi)
                array.push(_pType,  -1)
                array.push(_pRsi,   _rv)
                array.push(_pHist,  _hv)
        else
            array.push(_pPrice, _pr)
            array.push(_pBar,   _bi)
            array.push(_pType,  -1)
            array.push(_pRsi,   _rv)
            array.push(_pHist,  _hv)
        while array.size(_pPrice) > 10
            array.shift(_pPrice)
            array.shift(_pBar)
            array.shift(_pType)
            array.shift(_pRsi)
            array.shift(_pHist)

    int _sz = array.size(_pPrice)
    elliottPivotCount := _sz

    // --- 直近 Pivot を末尾から取得 (e0=最新 … e5=6番目) ---
    float _pe0 = _sz >= 1 ? array.get(_pPrice, _sz - 1) : na
    float _pe1 = _sz >= 2 ? array.get(_pPrice, _sz - 2) : na
    float _pe2 = _sz >= 3 ? array.get(_pPrice, _sz - 3) : na
    float _pe3 = _sz >= 4 ? array.get(_pPrice, _sz - 4) : na
    float _pe4 = _sz >= 5 ? array.get(_pPrice, _sz - 5) : na
    float _pe5 = _sz >= 6 ? array.get(_pPrice, _sz - 6) : na
    int _te0 = _sz >= 1 ? array.get(_pType, _sz - 1) : na
    int _te1 = _sz >= 2 ? array.get(_pType, _sz - 2) : na
    int _te2 = _sz >= 3 ? array.get(_pType, _sz - 3) : na
    int _te3 = _sz >= 4 ? array.get(_pType, _sz - 4) : na
    int _te4 = _sz >= 5 ? array.get(_pType, _sz - 5) : na
    int _te5 = _sz >= 6 ? array.get(_pType, _sz - 6) : na
    float _re0 = _sz >= 1 ? array.get(_pRsi, _sz - 1) : na
    float _re2 = _sz >= 3 ? array.get(_pRsi, _sz - 3) : na
    float _he0 = _sz >= 1 ? array.get(_pHist, _sz - 1) : na
    float _he2 = _sz >= 3 ? array.get(_pHist, _sz - 3) : na

    // === ③波 形状 / 波幅 (BUY: Low→High→Low→High / SELL: High→Low→High→Low) ===
    bool _shapeL = _sz >= 4 and _te0 == 1  and _te1 == -1 and _te2 == 1  and _te3 == -1
    bool _shapeS = _sz >= 4 and _te0 == -1 and _te1 == 1  and _te2 == -1 and _te3 == 1

    // BUY: Low0=e3 High1=e2 Low2=e1 High3=e0
    float _w1L  = _pe2 - _pe3
    float _w2rL = _w1L > 0 ? (_pe2 - _pe1) / _w1L : na
    float _w3L  = _pe0 - _pe1
    bool  _brk3L = _pe0 > _pe2

    // SELL: High0=e3 Low1=e2 High2=e1 Low3=e0
    float _w1S  = _pe3 - _pe2
    float _w2rS = _w1S > 0 ? (_pe1 - _pe2) / _w1S : na
    float _w3S  = _pe1 - _pe0
    bool  _brk3S = _pe0 < _pe2

    bool _candL = _shapeL and _w1L >= _atr * minWave1ATR and not na(_w2rL) and _w2rL >= wave2MinRetrace and _w2rL <= wave2MaxRetrace and _brk3L and _w3L >= _atr * minWave3ATR and _w3L >= _w1L
    bool _candS = _shapeS and _w1S >= _atr * minWave1ATR and not na(_w2rS) and _w2rS >= wave2MinRetrace and _w2rS <= wave2MaxRetrace and _brk3S and _w3S >= _atr * minWave3ATR and _w3S >= _w1S
    elliottW3CandLong  := _candL
    elliottW3CandShort := _candS

    // ③波スコア (100点満点 / 形状未成立は 0)
    int _s3L = not _shapeL ? 0 : math.min(100, 25 + (_w1L >= _atr * minWave1ATR ? 10 : 0) + ((not na(_w2rL) and _w2rL >= wave2MinRetrace and _w2rL <= wave2MaxRetrace) ? 15 : 0) + (_brk3L ? 15 : 0) + (_w3L >= _atr * minWave3ATR ? 10 : 0) + (_w3L >= _w1L ? 10 : 0) + ((useMomentumConfirm and _momL) ? 10 : 0) + ((useEMAConfirm and _emaL) ? 5 : 0) + ((useVolumeConfirm and _volU) ? 5 : 0))
    int _s3S = not _shapeS ? 0 : math.min(100, 25 + (_w1S >= _atr * minWave1ATR ? 10 : 0) + ((not na(_w2rS) and _w2rS >= wave2MinRetrace and _w2rS <= wave2MaxRetrace) ? 15 : 0) + (_brk3S ? 15 : 0) + (_w3S >= _atr * minWave3ATR ? 10 : 0) + (_w3S >= _w1S ? 10 : 0) + ((useMomentumConfirm and _momS) ? 10 : 0) + ((useEMAConfirm and _emaShr) ? 5 : 0) + ((useVolumeConfirm and _volU) ? 5 : 0))
    elliottW3ScoreLong  := _s3L
    elliottW3ScoreShort := _s3S

    // === ⑤波終了警戒 (6 Pivot) ===
    bool _shape5L = _sz >= 6 and _te0 == 1  and _te1 == -1 and _te2 == 1  and _te3 == -1 and _te4 == 1  and _te5 == -1
    bool _shape5S = _sz >= 6 and _te0 == -1 and _te1 == 1  and _te2 == -1 and _te3 == 1  and _te4 == -1 and _te5 == 1

    // BUY: High5=e0 Low4=e1 High3=e2 Low2=e3 High1=e4 Low0=e5
    float _w5L  = _pe0 - _pe1
    float _w3Lp = _pe2 - _pe3
    float _w1Lp = _pe4 - _pe5
    bool _upd5L   = _pe0 > _pe2
    bool _short5L = _w5L < _w3Lp
    bool _rsiDivL = _upd5L and _re0 < _re2
    bool _macdSlL = _upd5L and _he0 < _he2
    bool _extL    = _w5L >= _w1Lp * wave5ExtRatio
    bool _emaNarL = (_emaF - _emaM) < (_emaF[3] - _emaM[3])

    // SELL: Low5=e0 High4=e1 Low3=e2 High2=e3 Low1=e4 High0=e5
    float _w5S  = _pe1 - _pe0
    float _w3Sp = _pe3 - _pe2
    float _w1Sp = _pe5 - _pe4
    bool _upd5S   = _pe0 < _pe2
    bool _short5S = _w5S < _w3Sp
    bool _rsiDivS = _upd5S and _re0 > _re2
    bool _macdSlS = _upd5S and _he0 > _he2
    bool _extS    = _w5S >= _w1Sp * wave5ExtRatio
    bool _emaNarS = (_emaM - _emaF) < (_emaM[3] - _emaF[3])

    int _w5LSc = not _shape5L ? 0 : math.min(100, (_upd5L ? 20 : 0) + (_short5L ? 15 : 0) + ((useDivergenceWarning and _rsiDivL) ? 20 : 0) + (_macdSlL ? 15 : 0) + ((useOverExtensionWarning and _extL) ? 15 : 0) + ((useEMAConfirm and _emaNarL) ? 10 : 0) + ((useVolumeConfirm and _volD) ? 5 : 0))
    int _w5SSc = not _shape5S ? 0 : math.min(100, (_upd5S ? 20 : 0) + (_short5S ? 15 : 0) + ((useDivergenceWarning and _rsiDivS) ? 20 : 0) + (_macdSlS ? 15 : 0) + ((useOverExtensionWarning and _extS) ? 15 : 0) + ((useEMAConfirm and _emaNarS) ? 10 : 0) + ((useVolumeConfirm and _volD) ? 5 : 0))
    elliottW5WarnLong  := _w5LSc
    elliottW5WarnShort := _w5SSc

    bool _warnLOn = _w5LSc >= minWave5WarningScore
    bool _warnSOn = _w5SSc >= minWave5WarningScore
    elliottWarnLongOn  := _warnLOn
    elliottWarnShortOn := _warnSOn

    // === NoTrade (⑤波警戒) : NoTradeOnly モード or useWave5WarningFilter で有効 ===
    bool _w5NoTradeActive = elliottEntryMode == "NoTradeOnly" or useWave5WarningFilter
    elliottNoTradeLong  := _w5NoTradeActive and _warnLOn
    elliottNoTradeShort := _w5NoTradeActive and _warnSOn
    elliottNoTrade      := elliottNoTradeLong or elliottNoTradeShort

    // === 状態管理 : ③波候補(Score>=min)が出たら状態ON、maxBars保持 ===
    bool _longEvent  = useWave3Filter and _s3L >= minWave3Score
    bool _shortEvent = useWave3Filter and _s3S >= minWave3Score
    if useElliottStateWindow
        if _longEvent
            longElliottStateOk  := true
            longElliottStateBar := bar_index
        if _shortEvent
            shortElliottStateOk  := true
            shortElliottStateBar := bar_index
        if longElliottStateOk and not na(longElliottStateBar) and bar_index - longElliottStateBar > elliottStateMaxBars
            longElliottStateOk := false
        if shortElliottStateOk and not na(shortElliottStateBar) and bar_index - shortElliottStateBar > elliottStateMaxBars
            shortElliottStateOk := false

    // === Bias ===
    //   状態管理ON … 保持中フラグ / OFF … イベント単バー
    bool _biasLongRaw  = useWave3Filter and (useElliottStateWindow ? longElliottStateOk  : _longEvent)
    bool _biasShortRaw = useWave3Filter and (useElliottStateWindow ? shortElliottStateOk : _shortEvent)
    elliottBiasLong  := _biasLongRaw  and not elliottNoTradeLong
    elliottBiasShort := _biasShortRaw and not elliottNoTradeShort

    // === Direction / Score ===
    elliottDirection := _s3L > _s3S ? 1 : _s3S > _s3L ? -1 : 0
    int _sBase = math.max(_s3L, _s3S)
    elliottScore := math.max(0, math.min(100, _sBase - ((_warnLOn and elliottDirection == 1) ? 20 : 0) - ((_warnSOn and elliottDirection == -1) ? 20 : 0)))

    // === Signal Type (優先: NoTrade > Wave5 Div > Wave5 Warn > Wave3+Mom > Wave3) ===
    bool _w3Cand  = _candL or _candS
    bool _w3Mom   = (_candL and _momL) or (_candS and _momS)
    bool _warnAny = _warnLOn or _warnSOn
    bool _divAny  = (_rsiDivL and _warnLOn) or (_rsiDivS and _warnSOn)
    elliottSignalType := elliottNoTrade ? 5 : _divAny ? 4 : _warnAny ? 2 : _w3Mom ? 3 : _w3Cand ? 1 : 0

    // === Rank (0〜10) ===
    bool _domIsLong  = _s3L >= _s3S
    bool _domShape   = _domIsLong ? _shapeL : _shapeS
    bool _domBreak   = _domIsLong ? _brk3L : _brk3S
    bool _momEma     = _domIsLong ? (_candL and _momL and _emaL) : (_candS and _momS and _emaShr)
    int  _s3Max      = math.max(_s3L, _s3S)
    bool _warnStrong = math.max(_w5LSc, _w5SSc) >= 85
    elliottRank := (_s3Max >= 85 and not _warnAny) ? 10 : (_momEma and _s3Max >= minWave3Score) ? 9 : _warnStrong ? 8 : _warnAny ? 7 : _s3Max >= 85 ? 6 : _s3Max >= 75 ? 5 : _s3Max >= 60 ? 4 : _domBreak ? 3 : _domShape ? 2 : (_s3Max > 0 or _warnAny) ? 1 : 0

// --- Elliott WinZone 出力 (③波候補方向の Bias。状態管理＋⑤波警戒NoTrade込み) ---
bool elliottLongWinZone =
     not useElliottWZ ? false :
     elliottEntryMode == "NoTradeOnly" ? not elliottNoTradeLong :
     elliottEntryMode == "AllowOnly"   ? elliottBiasLong :
     true
bool elliottShortWinZone =
     not useElliottWZ ? false :
     elliottEntryMode == "NoTradeOnly" ? not elliottNoTradeShort :
     elliottEntryMode == "AllowOnly"   ? elliottBiasShort :
     true

// ============================================================
//  5b-3. WinZone 結合 (FVG / 出来高POC / フィボ / EMA / 水平線 / トレンドライン / BB)
// ============================================================
bool longWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY"    ? longFVGOk :
     winZoneMode == "VOLUME_ONLY" ? longVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? longFibZoneOk :
     winZoneMode == "EMA_ONLY"    ? emaLongWinZone :
     winZoneMode == "LINE_ONLY"   ? lineLongWinZone :
     winZoneMode == "TREND_ONLY"  ? trendLongWinZone :
     winZoneMode == "BB_ONLY"     ? bbLongWinZone :
     winZoneMode == "HS_ONLY"     ? hsLongWinZone :
     winZoneMode == "DTDB_ONLY"   ? dtdbLongWinZone :
     winZoneMode == "WEDGE_ONLY"  ? wedgeLongWinZone :
     winZoneMode == "TRIANGLE_ONLY" ? triangleLongWinZone :
     winZoneMode == "ELLIOTT_ONLY" ? elliottLongWinZone :
     winZoneMode == "OR"          ? ((useFVGWinZone and longFVGOk) or (useVolumeWinZone and longVolumeZoneOk) or (useFibWinZone and longFibZoneOk) or (useEMAWinZone and emaLongWinZone) or (useLineWinZone and lineLongWinZone) or (useTrendWinZone and trendLongWinZone) or (useBBWinZone and bbLongWinZone) or (useHSWinZone and hsLongWinZone) or (useDTDBWinZone and dtdbLongWinZone) or (useWedgeWinZone and wedgeLongWinZone) or (useTriangleWinZone and triangleLongWinZone) or (useElliottWinZone and elliottLongWinZone)) :
     winZoneMode == "AND"         ? ((not useFVGWinZone or longFVGOk) and (not useVolumeWinZone or longVolumeZoneOk) and (not useFibWinZone or longFibZoneOk) and (not useEMAWinZone or emaLongWinZone) and (not useLineWinZone or lineLongWinZone) and (not useTrendWinZone or trendLongWinZone) and (not useBBWinZone or bbLongWinZone) and (not useHSWinZone or hsLongWinZone) and (not useDTDBWinZone or dtdbLongWinZone) and (not useWedgeWinZone or wedgeLongWinZone) and (not useTriangleWinZone or triangleLongWinZone) and (not useElliottWinZone or elliottLongWinZone)) :
     true

bool shortWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY"    ? shortFVGOk :
     winZoneMode == "VOLUME_ONLY" ? shortVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? shortFibZoneOk :
     winZoneMode == "EMA_ONLY"    ? emaShortWinZone :
     winZoneMode == "LINE_ONLY"   ? lineShortWinZone :
     winZoneMode == "TREND_ONLY"  ? trendShortWinZone :
     winZoneMode == "BB_ONLY"     ? bbShortWinZone :
     winZoneMode == "HS_ONLY"     ? hsShortWinZone :
     winZoneMode == "DTDB_ONLY"   ? dtdbShortWinZone :
     winZoneMode == "WEDGE_ONLY"  ? wedgeShortWinZone :
     winZoneMode == "TRIANGLE_ONLY" ? triangleShortWinZone :
     winZoneMode == "ELLIOTT_ONLY" ? elliottShortWinZone :
     winZoneMode == "OR"          ? ((useFVGWinZone and shortFVGOk) or (useVolumeWinZone and shortVolumeZoneOk) or (useFibWinZone and shortFibZoneOk) or (useEMAWinZone and emaShortWinZone) or (useLineWinZone and lineShortWinZone) or (useTrendWinZone and trendShortWinZone) or (useBBWinZone and bbShortWinZone) or (useHSWinZone and hsShortWinZone) or (useDTDBWinZone and dtdbShortWinZone) or (useWedgeWinZone and wedgeShortWinZone) or (useTriangleWinZone and triangleShortWinZone) or (useElliottWinZone and elliottShortWinZone)) :
     winZoneMode == "AND"         ? ((not useFVGWinZone or shortFVGOk) and (not useVolumeWinZone or shortVolumeZoneOk) and (not useFibWinZone or shortFibZoneOk) and (not useEMAWinZone or emaShortWinZone) and (not useLineWinZone or lineShortWinZone) and (not useTrendWinZone or trendShortWinZone) and (not useBBWinZone or bbShortWinZone) and (not useHSWinZone or hsShortWinZone) and (not useDTDBWinZone or dtdbShortWinZone) and (not useWedgeWinZone or wedgeShortWinZone) and (not useTriangleWinZone or triangleShortWinZone) and (not useElliottWinZone or elliottShortWinZone)) :
     true

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

bool finalBullTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur :
     triggerTFMode == "LowerOnly"       ? trigBullLower :
     triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBullCur or trigBullLower) :
     trigBullCur

bool finalBearTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur :
     triggerTFMode == "LowerOnly"       ? trigBearLower :
     triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBearCur or trigBearLower) :
     trigBearCur

bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

bool allowLongByTrigger  = enabledTrigCount == 0 ? true : (finalBullTrig and not trigNoTrade and trigCooldownOk)
bool allowShortByTrigger = enabledTrigCount == 0 ? true : (finalBearTrig and not trigNoTrade and trigCooldownOk)

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
//   request.security(..., f_envTrendConfirmed(...), lookahead = barmerge.lookahead_on)
//   と組み合わせると、形成途中の上位足ではなく「直近で確定した上位足」の判定を得られる。
//   ・lookahead_on だけでは未来参照になるが、[1] で確定済み1本前に固定するため未来参照は発生しない。
//   ・関数呼び出し結果への直接 [1] を避けるため、いったん変数に受けてから [1] を返す。
//   ・判定ロジック(f_envTrend)自体は不変。取得する足を確定足にするだけ。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useEnvFilter
    // 4H / 1H / 15M : 確定済み上位足のみ参照 (lookahead_on + 確定1本前 → 完全非リペイント)
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    // 5M / 1M : 現状の仕様を維持
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8a. Macro (DXY/金利) 逆相関復帰フィルター (Environment に接続)
// ------------------------------------------------------------
//  Gold と DXY / 米金利の関係を「逆相関復帰」思想で使う:
//    通常 : Gold と DXY/金利 は逆相関
//    歪み : 同方向に動く → NoTrade (逆相関が崩れている)
//    復帰 : 歪み → 逆相関へ戻る → 逆相関方向にエントリー許可
//  ・Macro は Trigger ではなく Environment。WinZone/Trigger には混ぜない。
//  ・useMacroModule=false の時は request.security を一切呼ばない。
//  出力: allowLongByMacro / allowShortByMacro / macroNoTrade
// ============================================================
f_macroChg(src, len) =>
    (na(src[len]) or src[len] == 0) ? 0.0 : (src - src[len]) / src[len] * 100.0

bool allowLongByMacro  = true
bool allowShortByMacro = true
bool macroNoTrade      = false
bool macroDistortion   = false
bool dxyReturnSignal   = false
bool yieldReturnSignal = false
int  macroReturnDir    = 0
var bool macroReturnLongState  = false
var bool macroReturnShortState = false
var int  macroReturnBar        = na

if useMacroModule
    float _goldC  = request.security(macroGoldSymbol,  macroTF, close, lookahead = barmerge.lookahead_off)
    float _dxyC   = request.security(macroDxySymbol,   macroTF, close, lookahead = barmerge.lookahead_off)
    float _yieldC = request.security(macroYieldSymbol, macroTF, close, lookahead = barmerge.lookahead_off)
    float _dxyCorr   = ta.correlation(_goldC, _dxyC,   macroCorrLen)
    float _yieldCorr = ta.correlation(_goldC, _yieldC, macroCorrLen)
    float _dxyChg   = f_macroChg(_dxyC,   macroDirLookback)
    float _yieldChg = f_macroChg(_yieldC, macroDirLookback)
    float _goldChg  = f_macroChg(_goldC,  macroDirLookback)
    // 方向 (DXY下落/金利低下 = Gold ロング寄り = +1)。バイアス方式のフォールバック用。
    int _dxyDir   = _dxyChg   < 0 ? 1 : _dxyChg   > 0 ? -1 : 0
    int _yieldDir = _yieldChg < 0 ? 1 : _yieldChg > 0 ? -1 : 0
    int _biasDir = _dxyDir == _yieldDir ? _dxyDir : 0
    // --- 歪み判定 (Gold と DXY/金利 が同方向 = 逆相関が崩れている) ---
    bool _dxyDistortion   = (_dxyChg   > 0 and _goldChg > 0) or (_dxyChg   < 0 and _goldChg < 0)
    bool _yieldDistortion = (_yieldChg > 0 and _goldChg > 0) or (_yieldChg < 0 and _goldChg < 0)
    macroDistortion := _dxyDistortion or _yieldDistortion
    // --- 逆相関復帰判定 (歪み → 逆相関へ戻った瞬間) ---
    bool _dxyInverseNow   = (_dxyChg   > 0 and _goldChg < 0) or (_dxyChg   < 0 and _goldChg > 0)
    bool _yieldInverseNow = (_yieldChg > 0 and _goldChg < 0) or (_yieldChg < 0 and _goldChg > 0)
    bool _wasDxyDistortion   = ta.barssince(_dxyDistortion)   <= macroReturnLookback
    bool _wasYieldDistortion = ta.barssince(_yieldDistortion) <= macroReturnLookback
    dxyReturnSignal   := _wasDxyDistortion   and _dxyInverseNow   and not _dxyInverseNow[1]
    yieldReturnSignal := _wasYieldDistortion and _yieldInverseNow and not _yieldInverseNow[1]
    // --- 復帰方向 (DXY下落&Gold上昇 = +1 / DXY上昇&Gold下落 = -1) ---
    int _dxyReturnDir   = (_dxyChg   < 0 and _goldChg > 0) ? 1 : (_dxyChg   > 0 and _goldChg < 0) ? -1 : 0
    int _yieldReturnDir = (_yieldChg < 0 and _goldChg > 0) ? 1 : (_yieldChg > 0 and _goldChg < 0) ? -1 : 0
    // --- 復帰方向の合成 (両方一致→確定 / 片方→その方向) ---
    macroReturnDir := dxyReturnSignal and yieldReturnSignal and _dxyReturnDir == _yieldReturnDir ? _dxyReturnDir : dxyReturnSignal ? _dxyReturnDir : yieldReturnSignal ? _yieldReturnDir : 0
    // --- 復帰シグナル状態管理 (macroReturnStateBars 本だけ方向許可を保持) ---
    if useMacroReturnEntry and macroReturnDir == 1
        macroReturnLongState  := true
        macroReturnShortState := false
        macroReturnBar := bar_index
    if useMacroReturnEntry and macroReturnDir == -1
        macroReturnShortState := true
        macroReturnLongState  := false
        macroReturnBar := bar_index
    if not na(macroReturnBar) and bar_index - macroReturnBar > macroReturnStateBars
        macroReturnLongState  := false
        macroReturnShortState := false
    // --- NoTrade (歪み中は禁止。ただし復帰シグナルが出た足は解除) ---
    bool _macroReturnNow = macroReturnDir != 0
    macroNoTrade := useMacroNoTrade and macroDistortion and not _macroReturnNow
    // --- allowLong / allowShort ---
    //   復帰方式ON: 復帰状態のみ許可 / OFF: バイアス方向 (中立は両方許可)
    allowLongByMacro  := not useMacroBias ? true : useMacroReturnEntry ? macroReturnLongState  : _biasDir >= 0
    allowShortByMacro := not useMacroBias ? true : useMacroReturnEntry ? macroReturnShortState : _biasDir <= 0
else
    // Macro OFF : 環境判定に一切影響させない (パススルー)
    allowLongByMacro  := true
    allowShortByMacro := true
    macroNoTrade      := false
    macroReturnLongState  := false
    macroReturnShortState := false

// 環境フィルタ最終判定 : 既存環境条件 に Macro 方向バイアス と Macro NoTrade を AND 接続。
bool envLongOk =
     (not useEnvFilter or allowByEnv)
     and (not useMacroModule or not useMacroBias or allowLongByMacro)
     and (not useMacroModule or not useMacroNoTrade or not macroNoTrade)
bool envShortOk =
     (not useEnvFilter or allowByEnv)
     and (not useMacroModule or not useMacroBias or allowShortByMacro)
     and (not useMacroModule or not useMacroNoTrade or not macroNoTrade)

// ============================================================
//  8a-2. Intermarket (市場間分析) モジュール / Silver
// ------------------------------------------------------------
//  環境認識(トレンド)・WinZone(場所)・Momentum(勢い) とは独立。
//  Silver の 先行確認 / 方向一致 / 逆行警戒 / 乖離確認 を許可/NoTradeに使う。
//  useIntermarketModule=false … 下の if に入らず全処理停止 (security/ta なし)
//  useSilverModule=false      … Silver の request.security すら呼ばない
//  出力: longIntermarketOk / shortIntermarketOk (OFF時は常に許可)
//  ※ 表示コード(label/table/bgcolor)は本ファイルの方針に従い省略。
// ============================================================
// Silver 単体出力 (OFF時のデフォルト = 常に許可)
bool  allowLongBySilver  = true
bool  allowShortBySilver = true
bool  silverNoTrade      = false
int   silverDirection    = 0
int   silverSignalType   = 0
int   silverRank         = 0
// Silver 生シグナル / 指標 (OFF時 false / na)
bool  silverLeadLong      = false
bool  silverLeadShort     = false
bool  silverConfirmLong   = false
bool  silverConfirmShort  = false
bool  silverConflict      = false
bool  silverDivergence    = false
bool  silverLongEvent     = false
bool  silverShortEvent    = false
int   silverLeadDirection       = 0
int   silverConflictDirection   = 0
int   silverDivergenceDirection = 0
float silverChange       = na
float goldChange         = na
float silverRecentChange = na
float goldRecentChange   = na
float goldAtrRank        = na
// Silver 状態管理 (var。FVG・ストキャスと同思想)
var bool longSilverStateOk  = false
var bool shortSilverStateOk = false
var int  longSilverStateBar  = na
var int  shortSilverStateBar = na

// 変化率ヘルパー
f_imChg(src, len) =>
    (na(src[len]) or src[len] == 0) ? 0.0 : (src - src[len]) / src[len] * 100.0

// Silver 本体 : useIntermarketModule かつ useSilverModule の時だけ全処理
if useIntermarketModule and useSilverModule
    float goldC   = request.security(goldSymbol,   silverTF, close,               lookahead = barmerge.lookahead_off)
    float silverC = request.security(silverSymbol, silverTF, close,               lookahead = barmerge.lookahead_off)
    float goldATR = request.security(goldSymbol,   silverTF, ta.atr(silverAtrLen), lookahead = barmerge.lookahead_off)
    // 変化率
    silverChange       := f_imChg(silverC, silverLeadLookback)
    goldChange         := f_imChg(goldC,   silverLeadLookback)
    silverRecentChange := f_imChg(silverC, silverRecentLookback)
    goldRecentChange   := f_imChg(goldC,   silverRecentLookback)
    // A: Silver先行
    bool goldLag = math.abs(goldChange) <= goldLagThreshold
    silverLeadLong  := useSilverLead and (silverChange >=  silverMinChange) and (goldLag or goldChange < silverChange / silverLeadRatio)
    silverLeadShort := useSilverLead and (silverChange <= -silverMinChange) and (goldLag or goldChange > silverChange / silverLeadRatio)
    silverLeadDirection := silverLeadLong ? 1 : silverLeadShort ? -1 : 0
    // B: Silver方向一致
    silverConfirmLong  := useSilverConfirm and goldLongSetup  and silverChange > 0 and silverRecentChange > 0
    silverConfirmShort := useSilverConfirm and goldShortSetup and silverChange < 0 and silverRecentChange < 0
    // C: Silver逆行警戒
    bool silverConflictLong  = goldLongSetup  and silverChange < 0
    bool silverConflictShort = goldShortSetup and silverChange > 0
    silverConflict := useSilverConflict and (silverConflictLong or silverConflictShort)
    silverConflictDirection := silverConflictLong ? 1 : silverConflictShort ? -1 : 0
    // D: Gold/Silver乖離
    float divergenceAbs = math.abs(silverChange - goldChange)
    silverDivergence := useSilverDivergence and divergenceAbs >= silverDivThreshold
    silverDivergenceDirection := silverDivergence ? (silverChange > goldChange ? 1 : -1) : 0
    // ボラフィルター (Gold ATR percentile)
    goldAtrRank := ta.percentrank(goldATR, silverAtrRankLookback)
    bool silverVolOK = not useSilverVolFilter or (not na(goldAtrRank) and goldAtrRank >= silverAtrRankMin)
    // E: Silver確認ランク (0なし /1方向一致 /2先行 /3先行+一致 /4先行+一致+ボラOK)
    bool hasLead    = silverLeadLong or silverLeadShort
    bool hasConfirm = silverConfirmLong or silverConfirmShort
    silverRank := useSilverRank ? (
                   (hasLead and hasConfirm and silverVolOK) ? 4 :
                   (hasLead and hasConfirm) ? 3 :
                   hasLead ? 2 :
                   hasConfirm ? 1 : 0) : 0
    // Signal Type (0None/1Lead/2Confirm/3Conflict/4Divergence。優先: Conflict>Lead>Divergence>Confirm)
    silverSignalType := silverConflict ? 3 : hasLead ? 1 : silverDivergence ? 4 : hasConfirm ? 2 : 0
    // Direction (1=BUY / -1=SELL / 0=なし。採用順 Lead→Confirm→Divergence)
    silverDirection := hasLead ? silverLeadDirection : hasConfirm ? (silverConfirmLong ? 1 : -1) : silverDivergence ? silverDivergenceDirection : 0
    // NoTrade (逆行警戒)
    silverNoTrade := silverConflict
    // 生イベント (そのバーのシグナル。逆行時は不許可)
    silverLongEvent  := not silverConflict and (silverLeadLong  or silverConfirmLong)
    silverShortEvent := not silverConflict and (silverLeadShort or silverConfirmShort)
    // 状態管理 : イベント発生後 silverStateMaxBars 本だけ OK を保持 (期限切れで false)
    if useSilverStateWindow
        if silverLongEvent
            longSilverStateOk  := true
            longSilverStateBar := bar_index
        if silverShortEvent
            shortSilverStateOk  := true
            shortSilverStateBar := bar_index
        if longSilverStateOk and not na(longSilverStateBar) and bar_index - longSilverStateBar > silverStateMaxBars
            longSilverStateOk := false
        if shortSilverStateOk and not na(shortSilverStateBar) and bar_index - shortSilverStateBar > silverStateMaxBars
            shortSilverStateOk := false
    // Silver 最終出力 (状態管理ON=状態ベース / OFF=イベント単バー)
    allowLongBySilver  := useSilverStateWindow ? (longSilverStateOk  and not silverNoTrade) : silverLongEvent
    allowShortBySilver := useSilverStateWindow ? (shortSilverStateOk and not silverNoTrade) : silverShortEvent

// Intermarket 集約 (現状 Silver のみ。将来 DXY/US10Y/US2Y/SPX/NQ/VIX を AND/OR で追加)
//   OFFの市場は「通過」。将来は imLongSilver and imLongDXY (AND) のように拡張。
bool imLongSilver  = not useSilverModule or allowLongBySilver
bool imShortSilver = not useSilverModule or allowShortBySilver
bool allowLongByIntermarket  = intermarketMode == "AND" ? imLongSilver  : imLongSilver
bool allowShortByIntermarket = intermarketMode == "AND" ? imShortSilver : imShortSilver
bool intermarketNoTrade      = useIntermarketModule and useSilverModule and silverNoTrade
int  intermarketDirection    = silverDirection
int  intermarketSignalType   = silverSignalType
int  intermarketRank         = silverRank
// Intermarket 最終許可 (OFFなら常に許可。NoTrade中は禁止)
bool longIntermarketOk  = not useIntermarketModule or (allowLongByIntermarket  and not intermarketNoTrade)
bool shortIntermarketOk = not useIntermarketModule or (allowShortByIntermarket and not intermarketNoTrade)

// ============================================================
//  8b. Momentum モジュール (ストキャス)
// ============================================================
bool sAct = useMomentumModule and useStochMomentum

f_stochCalc() =>
    float _rawK = ta.stoch(close, high, low, kLen)
    float _k = ta.sma(_rawK, kSmooth)
    float _d = ta.sma(_k, dLen)
    [_k, _d]

float stochK = na
float stochD = na
if useStochTF
    [k1, d1] = request.security(syminfo.tickerid, stochTF, f_stochCalc(), lookahead = barmerge.lookahead_off)
    stochK := k1
    stochD := d1
else
    [k2, d2] = f_stochCalc()
    stochK := k2
    stochD := d2

bool slopeUp     = stochK > stochK[1]
bool slopeDown   = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

f_dirOK(bool isBuy) =>
    bool d = not useKDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool r = not useKDRelationFilter or (isBuy ? stochK > stochD : stochK < stochD)
    d and r

bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp)   or (useExtremeKDCross and kdCrossUp)

float stochSlope = stochK - stochK[1]
bool slopeStrengthOK_sell = not useSlopeStrengthFilter or stochSlope <= -stochSlopeMin
bool slopeStrengthOK_buy  = not useSlopeStrengthFilter or stochSlope >=  stochSlopeMin

var bool  wasExtremeHigh       = false
var bool  wasExtremeLow        = false
var bool  extremeHighTriggered = false
var bool  extremeLowTriggered  = false
var float lastExtremeHighValue = na
var float lastExtremeLowValue  = na

if stochK >= extremeHigh
    wasExtremeHigh := true
    lastExtremeHighValue := na(lastExtremeHighValue) ? stochK : math.max(lastExtremeHighValue, stochK)
if stochK <= extremeLow
    wasExtremeLow := true
    lastExtremeLowValue := na(lastExtremeLowValue) ? stochK : math.min(lastExtremeLowValue, stochK)
if stochK <= extremeResetLevelHigh
    wasExtremeHigh := false
    extremeHighTriggered := false
    lastExtremeHighValue := na
if stochK >= extremeResetLevelLow
    wasExtremeLow := false
    extremeLowTriggered := false
    lastExtremeLowValue := na

bool retraceOK_sell = not useExtremeRetraceFilter or (not na(lastExtremeHighValue) and (lastExtremeHighValue - stochK) >= extremeRetraceMin)
bool retraceOK_buy  = not useExtremeRetraceFilter or (not na(lastExtremeLowValue)  and (stochK - lastExtremeLowValue)  >= extremeRetraceMin)

bool exSell = sAct and useExtremeReversal and wasExtremeHigh and (not useExtremeOneShot or not extremeHighTriggered) and turnDown and slopeStrengthOK_sell and retraceOK_sell and f_dirOK(false)
bool exBuy  = sAct and useExtremeReversal and wasExtremeLow  and (not useExtremeOneShot or not extremeLowTriggered)  and turnUp   and slopeStrengthOK_buy  and retraceOK_buy  and f_dirOK(true)

if exSell
    extremeHighTriggered := true
if exBuy
    extremeLowTriggered := true

bool obSell = sAct and useOBOSCross and stochK > obLevel and kdCrossDown and f_dirOK(false)
bool obBuy  = sAct and useOBOSCross and stochK < osLevel and kdCrossUp   and f_dirOK(true)

bool midBuy  = sAct and useMiddleCross and ta.crossover(stochK, middleLevel)  and stochK > stochD and f_dirOK(true)
bool midSell = sAct and useMiddleCross and ta.crossunder(stochK, middleLevel) and stochK < stochD and f_dirOK(false)

var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := stochK >= obLevel ? bullStickCount + 1 : 0
bearStickCount := stochK <= osLevel ? bearStickCount + 1 : 0
bool stochBullSticky = sAct and useStickinessFilter and bullStickCount >= stickBars
bool stochBearSticky = sAct and useStickinessFilter and bearStickCount >= stickBars
bool stochNoSell = stochBullSticky
bool stochNoBuy  = stochBearSticky

float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float stochAtPivot = stochK[divPivotLen]

var float phPrev    = na
var float phLast    = na
var float shHPrev   = na
var float shHLast   = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float shLPrev   = na
var float shLLast   = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    shHPrev := shHLast
    phBarPrev := phBarLast
    phLast := pricePH
    shHLast := stochAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    shLPrev := shLLast
    plBarPrev := plBarLast
    plLast := pricePL
    shLLast := stochAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

bool regSell = sAct and useRegularDivergence and newPH and phInRange and phLast > phPrev and shHLast < shHPrev
bool regBuy  = sAct and useRegularDivergence and newPL and plInRange and plLast < plPrev and shLLast > shLPrev
bool hidBuy  = sAct and useHiddenDivergence and newPL and plInRange and plLast > plPrev and shLLast < shLPrev
bool hidSell = sAct and useHiddenDivergence and newPH and phInRange and phLast < phPrev and shHLast > shHPrev

bool anyReg = regBuy or regSell
bool anyHid = hidBuy or hidSell
bool anyEx  = exBuy or exSell
bool anyOB  = obBuy or obSell
bool anyMid = midBuy or midSell

int stochDirection = not sAct ? 0 :
                      anyReg ? (regBuy ? 1 : -1) :
                      anyHid ? (hidBuy ? 1 : -1) :
                      anyEx  ? (exBuy ? 1 : -1) :
                      anyOB  ? (obBuy ? 1 : -1) :
                      anyMid ? (midBuy ? 1 : -1) : 0

bool stochLongEvent  = sAct and stochDirection == 1  and not stochNoBuy
bool stochShortEvent = sAct and stochDirection == -1 and not stochNoSell

var bool stochLongStateOk   = false
var bool stochShortStateOk  = false
var int  stochLongStateBar  = na
var int  stochShortStateBar = na

if useStochStateWindow
    if stochLongEvent
        stochLongStateOk   := true
        stochLongStateBar  := bar_index
    if stochShortEvent
        stochShortStateOk   := true
        stochShortStateBar  := bar_index
    if stochLongStateOk and not na(stochLongStateBar) and bar_index - stochLongStateBar > stochStateMaxBars
        stochLongStateOk := false
    if stochShortStateOk and not na(stochShortStateBar) and bar_index - stochShortStateBar > stochStateMaxBars
        stochShortStateOk := false

bool allowLongByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochLongStateOk and not stochNoBuy) :
     stochLongEvent
bool allowShortByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochShortStateOk and not stochNoSell) :
     stochShortEvent
bool stochNoTrade = sAct and (stochNoBuy or stochNoSell)

// ============================================================
//  8b-MACD. Momentum : MACD モジュール
// ============================================================
//f_macdDirOK(bool isBuy, float _line, float _hist, bool _zOKB, bool _zOKS) =>
//    bool z = not useMACDZeroDirectionFilter or ((isBuy ? _line > 0 : _line < 0) and (isBuy ? _zOKB : _zOKS))
//    bool h = not useMACDHistDirectionFilter or (isBuy ? _hist > 0 : _hist < 0)
//    bool s = not useMACDSlopeFilter or (isBuy ? _line > _line[1] : _line < _line[1])
//    z and h and s

int  macdDirection  = 0
bool macdNoTrade      = false
bool macdNoTradeLong  = false
bool macdNoTradeShort = false
bool macdMomentumLong  = false
bool macdMomentumShort = false

//if useMACDModule
//    (MACD 判定ロジック本体は compiled tokens 上限のため一時停止。ロジック不変)
//
var bool longMACDStateOk  = false
var bool shortMACDStateOk = false
var int  longMACDStateBar  = na
var int  shortMACDStateBar = na
//if useMACDModule and useMACDStateWindow
//    if macdMomentumLong
//        longMACDStateOk := true
//        longMACDStateBar := bar_index
//    if macdMomentumShort
//        shortMACDStateOk := true
//        shortMACDStateBar := bar_index
//    if longMACDStateOk and not na(longMACDStateBar) and bar_index - longMACDStateBar > macdStateMaxBars
//        longMACDStateOk := false
//    if shortMACDStateOk and not na(shortMACDStateBar) and bar_index - shortMACDStateBar > macdStateMaxBars
//        shortMACDStateOk := false

bool allowLongByMACD  = not useMACDModule ? true : useMACDStateWindow ? (longMACDStateOk and not macdNoTradeLong) : (macdMomentumLong and not macdNoTradeLong)
bool allowShortByMACD = not useMACDModule ? true : useMACDStateWindow ? (shortMACDStateOk and not macdNoTradeShort) : (macdMomentumShort and not macdNoTradeShort)

// ============================================================
//  8c. Momentum 集約
// ============================================================
bool stochMomentumEnabled = useStochMomentum
bool macdMomentumEnabled  = useMACDModule

bool momoLongStoch  = not useStochMomentum or allowLongByStoch
bool momoShortStoch = not useStochMomentum or allowShortByStoch
bool momoLongMACD   = not useMACDModule or allowLongByMACD
bool momoShortMACD  = not useMACDModule or allowShortByMACD

bool momoLongCombined = momentumMode == "AND" ? (momoLongStoch and momoLongMACD) : ((stochMomentumEnabled and allowLongByStoch) or (macdMomentumEnabled and allowLongByMACD) or (not stochMomentumEnabled and not macdMomentumEnabled))
bool momoShortCombined = momentumMode == "AND" ? (momoShortStoch and momoShortMACD) : ((stochMomentumEnabled and allowShortByStoch) or (macdMomentumEnabled and allowShortByMACD) or (not stochMomentumEnabled and not macdMomentumEnabled))

bool momoNoTradeLong  = stochNoTrade or macdNoTradeLong
bool momoNoTradeShort = stochNoTrade or macdNoTradeShort

bool allowLongByMomentum  = not useMomentumModule or (momoLongCombined  and not momoNoTradeLong)
bool allowShortByMomentum = not useMomentumModule or (momoShortCombined and not momoNoTradeShort)

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 最終エントリー条件
// ============================================================

int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ------------------------------------------------------------
//  Accum Box Indicator の f_is_accum_core と同一条件で 5分足/15分足の
//  アキュムレーション価格帯を検出し、直近 accumNTKeep 個を配列に保持する。
//  現在の終値が保持中いずれかの価格帯の内部 (上限〜下限, 端一致含む) にあれば
//  blockedByAccum=true。これは canLong/canShort の最終許可にのみ AND し、
//  既存の WinZone/Momentum/Trigger/状態管理は一切変更・リセットしない。
//  useAccumNoTrade=false の時は検出処理を一切走らせない (従来と完全に同一結果)。
// ============================================================

// Accum コア検出 (呼ばれた足のコンテキストで isAccum / 実体ベース上下限 を返す)
//   Accum Box Indicator の f_is_accum_core と同じ AND 条件。上下限もヒゲでなく実体基準。
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

// 15分足コンテキストで箱を構築 (var で 15分足の生存期間だけ上下限を拡張)。
//   返り値: [isAccum, boxHigh, boxLow, boxStartBar]  boxStartBar = 箱識別子。
f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

// 確定済み1本前の15分足 box を「15分足コンテキスト内」で参照して返す。
//   [1] を関数内 (= 15分足コンテキスト) で適用し、lookahead_on と組み合わせることで、
//   ヒストリカル/リアルタイムとも「直前に確定した15分足」の box を一貫して取得する
//   (未来参照なし・非リペイント)。チャート側では [1] を一切使わない。
f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        // 新規Accum確定 → 配列へ追加。4つ目 (accumNTKeep超) で最古を削除。
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        // 形成中は最新箱の上下限を拡張 (配列の末尾=最新も更新)
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    // 内部判定 : 直近保持のどれか1つでも close が上限〜下限 (端一致含む) にあれば内部
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
//   確定参照は 15分足コンテキスト内で [1] を適用する f_accumNT15Confirmed + lookahead_on。
//   → 返る box は常に「直前に確定した15分足」の最終値 (ヒストリカル/リアルタイム一致)。
//   登録/更新は ta.change(time(15分足)) で「新しい15分足が始まった最初の5分足」だけ。
//   ※ チャート側では [1] を一切使わない。形成途中の15分足値は配列に入らない。
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        // 直前に確定した15分足の box をこの1本だけで処理 (3本に1回)
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            // 新しい15分Accum箱 → 登録 (箱識別子が変わった時のみ = 重複登録なし)
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            // 同一箱が拡張 (確定15分足で更新) → 最新エントリーの上下限を更新
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    // 内部判定は毎5分足で実施 (保持中の確定箱に対して現在の終値を判定)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
//   Accum外へ出た最初の足では許可せず、accumExitConfirmBars 本連続で外部維持後に許可。
//   離脱足は計数に含めず、その次の足から連続外部本数を数える。
//   確認中にAccum内へ戻ったらカウント完全リセット。最初から外部なら待機なし (従来どおり即許可)。
//   ※ WinZone/Momentum/Trigger/各状態管理・有効期限・リセットには一切干渉しない。
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        // Accum内 (または戻った) → 待機・カウント完全リセット
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        // 離脱足 → 待機開始 (この足は計数に含めない)
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        // 離脱の次足以降、外部維持で計数
        accumOutsideConfirmCount += 1
    // 確認完了 → 待機解除 (この確定バーで許可)
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

// 確認完了前だけ新規エントリー禁止 (blockedByAccum とは別条件)
bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
//   Accum内NoTrade・離脱待機確認は不変。離脱後のみ、抜けた方向にエントリーを限定する。
//   方向判定は「直前バーで実際に内部にいた保持箱」ごとに close 基準 (ヒゲ無視) で行う。
//   ・最初から外部 (一度もAccumを通過していない) → 方向制限なし (accumBreakDirectionActive=false)。
//   ・Accum内へ戻る / 有効期限切れ / 方向不明 → 状態リセット。
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        // Accum内へ戻った → 方向状態リセット (Accum内なので両方向禁止のまま)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        // 離脱足 : 直前バーで内部にいた箱ごとに close 基準で上抜け/下抜けを判定
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            // 上抜け/下抜け同時成立 or どちらも不成立 → 方向不明 (両方禁止しない=非アクティブ)
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    // 有効期限切れ → リセット
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

// 方向別許可 (非アクティブ時=最初から外部/方向不明/期限切れ は従来どおり両方向許可)
bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

bool canLong =
     useLong and
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     envLongOk and
     longWinZoneOk and
     longIntermarketOk and
     allowLongByMomentum and
     allowLongByTrigger and
     volOk and
     not lineNoTradeLong and
     not trendNoTradeLong and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk and
     longRisk > 0 and
     longQty >= 1

bool canShort =
     useShort and
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     envShortOk and
     shortWinZoneOk and
     shortIntermarketOk and
     allowShortByMomentum and
     allowShortByTrigger and
     volOk and
     not lineNoTradeShort and
     not trendNoTradeShort and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk and
     shortRisk > 0 and
     shortQty >= 1

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if resetFVGStateAfterEntry
        longFVGStateOk := false
    if resetVolumeStateAfterEntry
        longVolumeStateOk := false
    if resetFibStateAfterEntry
        longFibStateOk := false
    if useTrendWZ and resetTrendStateAfterEntry
        longTrendStateOk := false
    if useBBWZ and resetBBStateAfterEntry
        bbLongState := false
    if resetStochStateAfterEntry
        stochLongStateOk := false
    if useMACDModule and resetMACDStateAfterEntry
        longMACDStateOk := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if resetFVGStateAfterEntry
        shortFVGStateOk := false
    if resetVolumeStateAfterEntry
        shortVolumeStateOk := false
    if resetFibStateAfterEntry
        shortFibStateOk := false
    if useTrendWZ and resetTrendStateAfterEntry
        shortTrendStateOk := false
    if useBBWZ and resetBBStateAfterEntry
        bbShortState := false
    if resetStochStateAfterEntry
        stochShortStateOk := false
    if useMACDModule and resetMACDStateAfterEntry
        shortMACDStateOk := false

// --- 状態管理: エントリー後リセット (エントリー成立足だけ・入った方向だけ) ---
bool didEnterLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool didEnterShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
if useEMAWZ and resetEMAStateAfterEntry and didEnterLong
    emaLongState     := false
    emaLongStateBar  := na
    emaLongWinZone   := false
if useEMAWZ and resetEMAStateAfterEntry and didEnterShort
    emaShortState    := false
    emaShortStateBar := na
    emaShortWinZone  := false
if useLineWZ and resetLineStateAfterEntry and didEnterLong
    lineLongStateBar := na
if useLineWZ and resetLineStateAfterEntry and didEnterShort
    lineShortStateBar := na
if useTrendWZ and resetTrendStateAfterEntry and didEnterLong
    longTrendStateOk   := false
    longTrendStateBar  := na
if useTrendWZ and resetTrendStateAfterEntry and didEnterShort
    shortTrendStateOk  := false
    shortTrendStateBar := na
if useBBWZ and resetBBStateAfterEntry and didEnterLong
    bbLongState    := false
    bbLongStateBar := na
if useBBWZ and resetBBStateAfterEntry and didEnterShort
    bbShortState    := false
    bbShortStateBar := na
if useHSWZ and resetHSStateAfterEntry and didEnterLong
    hsLongState    := false
    hsLongStateBar := na
    hsLongWinZone  := false
if useHSWZ and resetHSStateAfterEntry and didEnterShort
    hsShortState    := false
    hsShortStateBar := na
    hsShortWinZone  := false
if useDTDBWZ and resetDTDBStateAfterEntry and didEnterLong
    dtdbLongState    := false
    dtdbLongStateBar := na
    dtdbLongWinZone  := false
if useDTDBWZ and resetDTDBStateAfterEntry and didEnterShort
    dtdbShortState    := false
    dtdbShortStateBar := na
    dtdbShortWinZone  := false
if useWedgeWZ and resetWedgeStateAfterEntry and didEnterLong
    wedgeLongState    := false
    wedgeLongStateBar := na
    wedgeLongWinZone  := false
if useWedgeWZ and resetWedgeStateAfterEntry and didEnterShort
    wedgeShortState    := false
    wedgeShortStateBar := na
    wedgeShortWinZone  := false
if useTriangleWZ and resetTriangleStateAfterEntry and didEnterLong
    triangleLongState    := false
    triangleLongStateBar := na
    triangleLongWinZone  := false
if useTriangleWZ and resetTriangleStateAfterEntry and didEnterShort
    triangleShortState    := false
    triangleShortStateBar := na
    triangleShortWinZone  := false
if useElliottWZ and resetElliottStateAfterEntry and didEnterLong
    longElliottStateOk  := false
    longElliottStateBar := na
    elliottLongWinZone  := false
if useElliottWZ and resetElliottStateAfterEntry and didEnterShort
    shortElliottStateOk  := false
    shortElliottStateBar := na
    elliottShortWinZone  := false
// Silver 状態リセット (エントリー後に同じ状態で再入しない)
if useIntermarketModule and useSilverModule and resetSilverStateAfterEntry and didEnterLong
    longSilverStateOk := false
if useIntermarketModule and useSilverModule and resetSilverStateAfterEntry and didEnterShort
    shortSilverStateOk := false

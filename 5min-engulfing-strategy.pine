     not useVolume ? false :
     useVolumeStateWindow ? longVolumeStateOk : longVolumeOk
bool shortVolumeZoneOk =
     not useVolume ? false :
     useVolumeStateWindow ? shortVolumeStateOk : shortVolumeOk


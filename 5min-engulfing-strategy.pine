// © ka.mickey15
//
// ============================================================
//  5分足 包み足ストラテジー (Engulfing Strategy)
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing)
//  ・ボラフィルタ : OFF / ATR(高速ボラフィルタ) / 固定値 の3モード
//  ・環境フィルタ : 環境認識モジュール (4H/1H/15M/5M/1M) を統合
//  ・WinZone      : FVG / 出来高POC / フィボ / EMA / 水平線 / トレンドライン を場所条件として並列統合
//  ・リスク       : 1トレードの損失を元金(単利) or 残高(複利) の X% に固定
//  ・ロット       : 整数に切り捨て。1未満はエントリーしない。
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "5min Engulfing Strategy",
     shorttitle        = "ENG5",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100
 )

// ============================================================
//  1. 入力 : エントリー (トリガーは常に包み足)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 下位足トリガー確認 (OFF で request.security を呼ばない)
useLowerTFTrigger = input.bool(false, "下位足トリガー確認 (重い)")
triggerTF         = input.timeframe("5", "下位足TF")
triggerTFMode     = input.string("CurrentOnly", "現在足/下位足 結合", options = ["CurrentOnly", "LowerOnly", "CurrentAndLower", "CurrentOrLower"])

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
useOppositeTriggerNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

// ============================================================
//  3c. 入力 : Macro (DXY/金利) 方向フィルター
// ------------------------------------------------------------
//  Environment の「方向フィルター」。WinZone / Trigger ではない。
//  Gold と DXY / 米金利の逆相関から 方向バイアス と NoTrade を作る。
//  useMacroModule=false の時は request.security を一切呼ばない (軽量)。
// ============================================================
useMacroModule  = input.bool(false, "マクロモジュールを使う (重い/OFFで軽量)")
useMacroBias    = input.bool(false, "マクロ方向バイアスを使う")
useMacroNoTrade = input.bool(false, "マクロNoTradeを使う")
macroGoldSymbol  = input.symbol("TVC:GOLD",  "Gold")
macroDxySymbol   = input.symbol("TVC:DXY",   "DXY")
macroYieldSymbol = input.symbol("TVC:US10Y", "Yield (US10Y)")
macroTF          = input.timeframe("15",     "マクロ時間足")
macroCorrLen     = input.int(20,   "相関計算期間", minval = 2)
macroDirLookback = input.int(10,   "方向判定期間", minval = 1)
macroWeakCorr    = input.float(0.2, "相関 弱すぎ しきい値 |corr|<", minval = 0.0, maxval = 1.0, step = 0.05)
useMacroReturnEntry  = input.bool(false, "逆相関復帰をエントリー許可に使う")
macroReturnLookback  = input.int(3, "歪み→復帰 判定本数", minval = 1)
macroReturnStateBars = input.int(5, "復帰シグナル 有効本数", minval = 1)

// ============================================================
//  3d. 入力 : Intermarket (市場間分析) モジュール / Silver
// ------------------------------------------------------------
//  環境認識・WinZone・Momentum とは独立した「市場間」フィルター。
//  Silver の 先行確認 / 方向一致 / 逆行警戒 / 乖離確認 を許可/NoTradeに使う。
//  useIntermarketModule=false … 全処理停止 (security/ta を一切呼ばない)
//  useSilverModule=false      … Silver の request.security すら呼ばない
// ============================================================
useIntermarketModule = input.bool(false, "Intermarketモジュールを使う (OFFで完全停止)")
intermarketMode      = input.string("AND", "Intermarket結合 (将来 Silver/DXY/金利...)", options = ["AND", "OR"])
useSilverModule      = input.bool(true,  "Silver を使う (OFFで security も呼ばない)")
goldSymbol           = input.symbol("TVC:GOLD",   "Gold シンボル")
silverSymbol         = input.symbol("TVC:SILVER", "Silver シンボル")
silverTF             = input.timeframe("5", "Silver 時間足")
silverLeadLookback   = input.int(4, "先行/方向 判定期間", minval = 1)
silverRecentLookback = input.int(3,  "直近 確認期間",     minval = 1)
useSilverLead        = input.bool(true, "A: Silver先行")
useSilverConfirm     = input.bool(false, "B: Silver方向一致")
useSilverConflict    = input.bool(false, "C: Silver逆行警戒")
useSilverDivergence  = input.bool(false, "D: Gold/Silver乖離")
useSilverRank        = input.bool(false, "E: Silver確認ランク")
goldLongSetup        = input.bool(false, "Gold ロング条件 (接続用)")
goldShortSetup       = input.bool(false, "Gold ショート条件 (接続用)")
silverMinChange      = input.float(0.5, "Silver 最小変化率(%)", minval = 0.0, step = 0.05)
silverLeadRatio      = input.float(2.0, "先行 比率 (silver/leadRatio)", minval = 0.1, step = 0.1)
goldLagThreshold     = input.float(0.1, "Gold 未反応 変化率(%)", minval = 0.0, step = 0.05)
silverDivThreshold   = input.float(0.8, "乖離 しきい値(%)",     minval = 0.0, step = 0.05)
useSilverVolFilter    = input.bool(false, "ボラフィルターを使う")
silverAtrLen          = input.int(14,  "Gold ATR期間",       minval = 1)
silverAtrRankLookback = input.int(100, "ATR percentile 期間", minval = 1)
silverAtrRankMin      = input.float(30, "ATR rank 最小(%)",   minval = 0.0, maxval = 100.0, step = 5)
useSilverStateWindow       = input.bool(true, "Silver状態管理を使う")
silverStateMaxBars         = input.int(3, "Silver状態 有効本数", minval = 1)
resetSilverStateAfterEntry = input.bool(true, "エントリー後Silver状態をリセット")

// ============================================================
//  3e. 入力 : Accumulation NoTrade フィルター
// ------------------------------------------------------------
//  5分足・15分足の直近アキュムレーション価格帯の内部では新規エントリーを禁止する。
//  ・既存の WinZone/Momentum/Trigger/状態管理には一切干渉しない。
//  ・最終エントリー許可 (canLong/canShort) にのみ not blockedByAccum を AND。
//  ・箱終了後も直近保持分は価格帯として右方向へ延長し、内部なら禁止。
//  ・useAccumNoTrade=false の時は検出処理 (ta/security) を一切走らせない (軽量)。
// ============================================================
groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(true, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(1, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

// ============================================================
//  4. 入力 : リスク / 決済
// ============================================================
riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"])
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時")
slFixed     = input.float(12, "固定SL幅 (価格) ※固定時")
rrRatio     = input.float(1.0, "リスクリワード比 (TP)")

// ============================================================
//  4b. 入力 : 時間帯フィルタ (東京時間 JST 基準)
// ============================================================
useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4c. 入力 : WinZone モジュール
// ============================================================
useWinZoneModule = input.bool(true, "WinZoneモジュールを使う")
useFVGWinZone    = input.bool(true, "FVGをWinZoneに使う")
useVolumeWinZone = input.bool(false, "出来高/POCをWinZoneに使う")
useFibWinZone    = input.bool(false, "フィボをWinZoneに使う")
useEMAWinZone    = input.bool(false, "EMAをWinZoneに使う")
useLineWinZone   = input.bool(false, "水平線をWinZoneに使う")
useTrendWinZone  = input.bool(true, "トレンドラインをWinZoneに使う")
useBBWinZone     = input.bool(false, "BBをWinZoneに使う")
useHSWinZone     = input.bool(true, "三尊(H&S)をWinZoneに使う")
useDTDBWinZone   = input.bool(false, "DT/DBをWinZoneに使う")
useWedgeWinZone  = input.bool(false, "WedgeをWinZoneに使う")
useTriangleWinZone = input.bool(false, "TriangleをWinZoneに使う")
useElliottWinZone = input.bool(true, "ElliottをWinZoneに使う")
winZoneMode      = input.string("AND", "WinZone結合", options = ["FVG_ONLY", "VOLUME_ONLY", "FIB_ONLY", "EMA_ONLY", "LINE_ONLY", "TREND_ONLY", "BB_ONLY", "HS_ONLY", "DTDB_ONLY", "WEDGE_ONLY", "TRIANGLE_ONLY", "ELLIOTT_ONLY", "OR", "AND"])

// ============================================================
//  4o. 入力 : Elliott Wave WinZone
// ------------------------------------------------------------
//  ③波候補 / ⑤波終了警戒 をスコア判定する WinZone。判定ロジックのみ。
//  useElliottModule=false の時は ta(ATR/RSI/MACD/EMA/Volume/Pivot)・配列を走らせない。
// ============================================================
useElliottModule = input.bool(true, "Elliottモジュールを使う (WinZone ON時のみ有効)")
elliottPivotLen = input.int(5,  "Pivot Length")
elliottAtrLen   = input.int(14, "ATR Length")
minWave1ATR = input.float(1.0, "最低1波幅 ATR倍率")
minWave3ATR = input.float(1.5, "最低3波幅 ATR倍率")
wave2MinRetrace = input.float(0.382, "2波 最低戻し")
wave2MaxRetrace = input.float(0.786, "2波 最大戻し")
wave4MinRetrace = input.float(0.236, "4波 最低戻し")
wave4MaxRetrace = input.float(0.5,   "4波 最大戻し")
useWave3Filter = input.bool(true, "③波候補を使う")
minWave3Score  = input.int(70, "③波 最低Score")
useWave5WarningFilter = input.bool(false, "⑤波警戒でNoTrade")
minWave5WarningScore  = input.int(80, "⑤波警戒 最低Score")
useMomentumConfirm = input.bool(false, "Momentum確認を使う")
rsiLen     = input.int(14, "RSI Length")
macdFast   = input.int(12, "MACD Fast")
macdSlow   = input.int(26, "MACD Slow")
elliottMacdSignal = input.int(9,  "MACD Signal")
useVolumeConfirm = input.bool(false, "Volume確認を使う")
elliottVolAvgLen = input.int(20, "Volume平均本数")
useEMAConfirm = input.bool(false, "EMA発散確認を使う")
emaFastLen = input.int(20,  "EMA Fast")
emaMidLen  = input.int(50,  "EMA Mid")
emaSlowLen = input.int(200, "EMA Slow")
useOverExtensionWarning = input.bool(true, "伸び切り警戒を使う")
wave5ExtRatio = input.float(1.618, "⑤波 伸び切り倍率")
useDivergenceWarning = input.bool(true, "ダイバージェンス警戒を使う")
elliottEntryMode = input.string("AllowOnly", "Elliott使用モード", options = ["BiasOnly", "AllowOnly", "NoTradeOnly"])
useElliottStateWindow       = input.bool(true, "Elliott状態管理を使う")
elliottStateMaxBars         = input.int(3, "Elliott状態 有効本数")
resetElliottStateAfterEntry = input.bool(true, "エントリー後Elliott状態をリセット")
// ============================================================
//  4n. 入力 : Triangle (アセ/ディセ/シンメトリカル) WinZone
// ------------------------------------------------------------
//  Triangle を WinZone (場所条件) として使う。判定ロジックのみ。
//  useTriangleModule=false の時は request.security/ta.*/pivot/配列を走らせない。
// ============================================================
useTriangleModule = input.bool(true, "Triangleモジュールを使う (WinZone ON時のみ有効)")
trianglePatternTf = input.timeframe("5", "Pattern TF")
trianglePivotLen  = input.int(5, "Pivot Length")
triangleTolerancePct = input.float(0.004, "水平ライン許容率")
triangleMinTouches = input.int(2, "最低タッチ数")
triangleMaxTouches = input.int(6, "最大タッチ数")
triangleContractionRatio = input.float(0.9, "収束率 WidthNow <= WidthStart ×")
minTriangleBars = input.int(16, "Triangle最小形成本数")
maxTriangleBars = input.int(80, "Triangle最大形成本数")
triangleMaxLookback = input.int(10, "Pivot最大保持数")
triangleSetupValidBars = input.int(50, "セットアップ有効本数")
triangleRetestAtrLen  = input.int(14, "Retest ATR Length")
triangleRetestAtrMult = input.float(0.5, "Retest ATR Mult")
triangleLineBreakAtrMult = input.float(0.05, "ラインブレイク ATR余白")
triangleFakeBreakBars    = input.int(5, "FakeBreak 戻り最大本数")
useTriangleReversalCandle = input.bool(true, "反転ローソクを要求")
useTriangleBodyFilter = input.bool(true, "包み足の実体強度を要求")
triangleBodyMult      = input.float(1.4, "実体 > 平均実体 ×")
trianglePinWickRatio  = input.float(0.7, "ピンバーのヒゲ比率")
useTriangleQualityFilter = input.bool(false, "Quality Filterを使う")
minTriangleQuality       = input.int(50, "最低Triangle Quality")
useTriangleInvalidation = input.bool(true, "Triangle否定を使う")
useTriangleSymNoTrade = input.bool(true, "Sym Triangle中はNoTrade")
useTriangleATRExpansion = input.bool(false, "ブレイク時ATR拡大を要求")
triangleAtrExpandLen    = input.int(20, "ATR拡大比較本数")
triangleAtrExpandMult   = input.float(1.1, "ATR > 平均ATR ×")
triangleEntryMode = input.string("FakeBreakOnly", "Triangle Entry Mode", options = ["Any", "BreakOnly", "RetestOnly", "FakeBreakOnly", "InvalidationOnly"])
useTriangleStateWindow       = input.bool(true, "Triangle状態管理を使う")
triangleStateMaxBars         = input.int(15, "Triangle状態 有効本数")
resetTriangleStateAfterEntry = input.bool(true, "エントリー後Triangle状態をリセット")

// ============================================================
//  4m. 入力 : Wedge (ベア/ブル ウェッジ) WinZone
// ------------------------------------------------------------
//  Bear/Bull Wedge を WinZone (場所条件) として使う。判定ロジックのみ。
//  useWedgeModule=false の時は request.security/ta.*/pivot/配列を走らせない。
// ============================================================
useWedgeModule = input.bool(true, "Wedgeモジュールを使う (WinZone ON時のみ有効)")
wedgePatternTf = input.timeframe("5", "Pattern TF")
wedgePivotLen  = input.int(5, "Pivot Length")
wedgeMinTouches  = input.int(2, "最低Pivotタッチ数")
wedgeMaxLookback = input.int(10, "Pivot最大保持数")
wedgeContractionRatio = input.float(0.7, "収束率 WidthNow <= WidthStart ×")
minWedgeBars = input.int(8, "Wedge最小形成本数")
maxWedgeBars = input.int(80, "Wedge最大形成本数")
wedgeMinSlopeAtrMult  = input.float(0.05, "最低傾き ATR倍率")
wedgeLineBreakAtrMult = input.float(0.1, "ラインブレイク ATR余白")
wedgeRetestAtrLen  = input.int(14, "Retest ATR Length")
wedgeRetestAtrMult = input.float(0.5, "Retest ATR Mult")
wedgeSetupValidBars = input.int(24, "セットアップ有効本数")
useWedgeReversalCandle = input.bool(true, "反転ローソクを要求")
useWedgeBodyFilter = input.bool(true, "包み足の実体強度を要求")
wedgeBodyMult      = input.float(1.4, "実体 > 平均実体 ×")
wedgePinWickRatio  = input.float(0.7, "ピンバーのヒゲ比率")
useWedgeQualityFilter = input.bool(false, "Quality Filterを使う")
minWedgeQuality       = input.int(50, "最低Wedge Quality")
useWedgeInvalidation     = input.bool(true, "Wedge否定を使う")
wedgeInvalidationAtrMult = input.float(0.2, "否定判定 ATR余白")
useWedgeVolExpansion = input.bool(false, "ブレイク時ATR拡大を要求")
wedgeAtrExpandLen  = input.int(20, "ATR拡大比較本数")
wedgeAtrExpandMult = input.float(1.1, "ATR > 平均ATR ×")
wedgeEntryMode = input.string("Any", "Wedge Entry Mode", options = ["Any", "BreakOnly", "RetestOnly", "InvalidationOnly"])
useWedgeStateWindow       = input.bool(true, "Wedge状態管理を使う")
wedgeStateMaxBars         = input.int(10, "Wedge状態 有効本数")
resetWedgeStateAfterEntry = input.bool(true, "エントリー後Wedge状態をリセット")

// ============================================================
//  4l. 入力 : DT/DB (ダブル/トリプル トップ・ボトム) WinZone
// ------------------------------------------------------------
//  DT/DB・TT/TB を WinZone (場所条件) として使う。判定ロジックのみ。
//  useDTDBModule=false の時は request.security・pivot・配列・検出を走らせない。
// ============================================================
useDTDBModule = input.bool(true, "DT/DBモジュールを使う (WinZone ON時のみ有効)")
dtdbPatternTf = input.timeframe("5", "Pattern TF")
dtdbPivotLen  = input.int(3, "Pivot Length")
doubleTolerancePct = input.float(0.01, "2回目頂点/底値の許容率")
useNeckDepth  = input.bool(true, "ネック深さを要求")
neckDepthMult = input.float(0.5, "ネック深さ >= ATR ×")
useQuickRev  = input.bool(false, "2回目到達後N本以内の反転のみ")
quickRevBars = input.int(5, "反転までの最大本数")
dtdbRetestAtrLen  = input.int(14, "Retest ATR Length")
dtdbRetestAtrMult = input.float(0.5, "Retest ATR Mult")
useDTDBReversalCandle = input.bool(false, "反転ローソクを要求")
useDTDBBodyFilter = input.bool(false, "包み足の実体強度を要求")
dtdbBodyMult      = input.float(1.6, "実体 > 平均実体 ×")
dtdbPinWickRatio  = input.float(0.7, "ピンバーのヒゲ比率")
useDTDBQualityFilter = input.bool(false, "Quality Filterを使う")
minDTDBQuality       = input.int(50, "最低DT/DB Quality")
useDTDBInvalidation    = input.bool(true, "DT/DB否定を使う")
dtdbInvalidationAtrMult = input.float(0.3, "否定判定 ATR余白")
useDTDBRightSideFailNoTrade = input.bool(false, "右山/右底崩れをNoTradeにする")
useSweepDTDB        = input.bool(true, "スイープ型DT/DBを使う")
dtdbSweepAtrMult    = input.float(0.3, "スイープ許容 ATR×")
dtdbSweepReturnBars = input.int(3, "スイープ後に戻る最大本数")
useTripleDTDB = input.bool(true, "Triple Top/Bottomを使う")
tripleTolerancePct = input.float(0.006, "3回目頂点/底値の許容率")
useTripleOnlyAfterDouble = input.bool(true, "Double成立後のTripleのみ採用")
dtdbSetupValidBars = input.int(96, "セットアップ有効本数")
dtdbEntryMode = input.string("Pattern", "DTDB Entry Mode", options = ["Pattern", "Any", "BreakOnly", "RetestOnly", "InvalidationOnly", "SweepOnly"])
useDTDBStateWindow       = input.bool(true, "DTDB状態管理を使う")
dtdbStateMaxBars         = input.int(48, "DTDB状態 有効本数")
resetDTDBStateAfterEntry = input.bool(true, "エントリー後DTDB状態をリセット")

// ============================================================
//  4k. 入力 : Head & Shoulders WinZone (三尊 / 逆三尊 場所条件)
// ------------------------------------------------------------
//  H&S は WinZone (場所条件)。FVG/Volume/Fib/EMA/Line/Trend/BB と同じ階層。
//  ・useHSModule=false の時は request.security・Pivot・Queue・配列操作・
//    Quality・Retest・Break・Invalidation を一切走らせない (軽量)。
// ============================================================
useHSModule = input.bool(true, "H&Sモジュールを使う (WinZone ON時のみ有効)")
patternTf   = input.timeframe("5", "Pattern TF")
pivotLen    = input.int(5, "Pivot Length")
hsMode      = input.string("NecklineRetest", "H&S Mode", options = ["Legacy", "NecklineBreak", "NecklineRetest"])
shoulderTolerancePct = input.float(0.004, "肩の対称性 許容率")
useHeadProm  = input.bool(true, "頭と肩の高低差を要求")
headPromMult = input.float(1.0, "頭-肩 > ATR ×")
setupValidBars = input.int(24, "セットアップ有効本数")
retestAtrLen  = input.int(14, "Retest ATR Length")
retestAtrMult = input.float(0.8, "Retest ATR Mult")
useCloseStrong  = input.bool(false, "反転足の終値強度を要求")
closeStrongFrac = input.float(0.8, "終値ゾーン")
useHSReversalCandle = input.bool(false, "反転ローソクを要求")
useHSBodyFilter = input.bool(false, "包み足の実体強度を要求")
hsBodyMult      = input.float(1.2, "実体 > 平均実体 ×")
hsPinWickRatio  = input.float(0.7, "ピンバーのヒゲ比率")
useHSQualityFilter = input.bool(false, "Quality Filterを使う")
minHSQuality       = input.int(50, "最低H&S Quality")
useHSInvalidation   = input.bool(false, "H&S否定を使う")
invalidationAtrMult = input.float(0.2, "否定判定 ATR余白")
hsWinZoneMode = input.string("Any", "H&S WinZone", options = ["Pattern", "Break", "Retest", "Invalidation", "Any"])
useHSStateWindow       = input.bool(true, "H&S状態管理を使う")
hsStateMaxBars         = input.int(15, "H&S状態 有効本数")
resetHSStateAfterEntry = input.bool(true, "エントリー後H&S状態をリセット")

// ============================================================
//  1b. 入力 : FVG 場所フィルター
// ============================================================
grpFvg = "FVG 場所フィルター"
useFVGFilter           = input.bool(true, "FVG場所フィルターを使う", group = grpFvg)
useFVGReboundFilter    = input.bool(true,  "FVG反発を許可",          group = grpFvg)
useFVGAbsorptionFilter = input.bool(true, "FVG吸収を許可",          group = grpFvg)
useIFVGFilter          = input.bool(false, "iFVGを許可",             group = grpFvg)
useBullishFVG    = input.bool(true,  "Bullish FVG (ロング側)",  group = grpFvg)
useBearishFVG    = input.bool(true,  "Bearish FVG (ショート側)", group = grpFvg)
useOppositeFVGFilter  = input.bool(true, "逆側FVG近接フィルター",   group = grpFvg)
fvgMaxAge        = input.int(100, "FVG最大年齢(本)",    minval = 1, group = grpFvg)
maxFVGPerSide    = input.int(120, "片側 最大FVG保持数", minval = 1, maxval = 500, group = grpFvg)
absorbBodyMinRatio = input.float(0.50, "吸収 実体最小比率",         minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
absorbCloseEdgeRatio = input.float(0.0, "吸収 close端寄り比率",    minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
// FVG状態管理 (イベント発生後、一定本数だけ「FVG条件OK」を保持する)
useFVGStateWindow       = input.bool(true, "FVG状態管理を使う", group = grpFvg)
fvgStateMaxBars         = input.int(1, "FVG状態 有効本数", minval = 1, group = grpFvg)
resetFVGStateAfterEntry = input.bool(true, "エントリー後FVG状態をリセット", group = grpFvg)

// ============================================================
//  1b-2. 入力 : USレンジ式 FVG (Accumulation → MSS → フェーズ収集)
// ------------------------------------------------------------
//  FVG検出を「Accumulation検出 → MSS成立 → フェーズ開始後に形成された
//  FVGだけ収集」へ変更。厚みは直前Accumulation幅比。反発=侵入深度 /
//  吸収=吸収足で即成立 / 吸収後の方向ロック。変数は fvg/fvgAccum/fvgMss/
//  fvgPhase 接頭辞で既存と衝突回避。
// ============================================================
grpFvgUS = "FVG: USレンジ式 (Accum/MSS)"
// Accumulation
fvgAccumRangeLen       = input.int(10, "Accum判定レンジ本数",   minval = 6,  group = grpFvgUS)
fvgAccumBaseLen        = input.int(20, "Accum基準平均本数",     minval = 10, group = grpFvgUS)
fvgAccumAtrLen         = input.int(14, "Accum ATR本数",         minval = 1,  group = grpFvgUS)
fvgAccumMinUpperCloses = input.int(4,  "上半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMinLowerCloses = input.int(4,  "下半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMaxSameColorRun= input.int(4,  "同色連続の上限",         minval = 1,  group = grpFvgUS)
fvgAccumAtrMult        = input.float(2.5,  "Accum レンジ幅/ATR 上限",  minval = 0.5, step = 0.1,  group = grpFvgUS)
fvgAccumBarRatioMax    = input.float(0.70, "Accum 短期/基準 幅比 上限", minval = 0.1, step = 0.01, group = grpFvgUS)
fvgAccumDriftMax       = input.float(0.30, "Accum ドリフト上限",       minval = 0.05, maxval = 1.0, step = 0.05, group = grpFvgUS)
// MSS
fvgMssValidBars        = input.int(100, "MSS有効本数", minval = 10, group = grpFvgUS)
fvgMssNeedBodyStrength = input.bool(true, "MSSで実体強度を使う", group = grpFvgUS)
fvgMssImpulseMult      = input.float(0.5, "MSS インパルス強度", minval = 0.0, step = 0.05, group = grpFvgUS)
// 厚み (Accum幅比。反発用/吸収用を分離)
fvgThicknessMinRebound    = input.float(0.1, "FVG厚み最小[反発] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgThicknessMinAbsorption = input.float(0.00, "FVG厚み最小[吸収] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
// 反発 (侵入深度・ローソク強度)
fvgReboundConfirmDepthBuy  = input.float(0.70, "反発確定深度上限[BUY]",  minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundConfirmDepthSell = input.float(0.70, "反発確定深度上限[SELL]", minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
useFVGReboundStrictCandleBuy  = input.bool(false, "反発 ローソク強度[BUY]",  group = grpFvgUS)
useFVGReboundStrictCandleSell = input.bool(false, "反発 ローソク強度[SELL]", group = grpFvgUS)
fvgReboundBodyMinRatioBuy   = input.float(0.05, "反発 実体率下限[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundBodyMinRatioSell  = input.float(0.05, "反発 実体率下限[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioBuy  = input.float(0.30, "反発 close端寄り[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioSell = input.float(0.30, "反発 close端寄り[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
// 逆側FVG近接 (距離 + 厚みの両方を満たす時だけブロック)
fvgOppositeNearGapMax   = input.float(0.0, "逆側FVG近接距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgOppositeMinThickness = input.float(0.0, "逆側FVG最低厚み (厚み/Accum幅)",     minval = 0.0, step = 0.01, group = grpFvgUS)
// 吸収 (薄い最新FVG + 近接した厚い前FVG優先)
fvgAbsorbThinRatioMax = input.float(0.00, "吸収 薄いFVG上限 (幅/Accum幅)",   minval = 0.0, step = 0.01, group = grpFvgUS)
fvgAbsorbNearGapMax   = input.float(0.00, "吸収 近接FVG距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)



// --- 出来高: パターン ON/OFF ---
usePOCAcceptance  = input.bool(true, "A: POC貫通・定着")
usePOCReject      = input.bool(false, "B: POCリジェクト(押し目/戻り)")
useVolumeBreakout = input.bool(false, "C: 出来高急増ブレイク")
useClimaxReversal = input.bool(false, "D: クライマックス反転")

useLowVolumeFilter   = input.bool(false,  "出来高不足フィルター")
useVolumeSMAFilter   = input.bool(false, "出来高SMAフィルター(>SMA)")
useBodyFilter        = input.bool(false, "実体率フィルター")
useCompressionFilter = input.bool(false, "圧縮→爆発フィルター(C)")
useFirstSignalOnly   = input.bool(true,  "連続シグナル抑制(初回のみ)")

vpLookback = input.int(80, "VP ルックバック(本)")
vpBins     = input.int(20,  "VP ビン数")
pocZoneWidth = input.float(0.0, "POCゾーン幅(固定/価格)")
useVolAdaptivePOCWidth = input.bool(true, "POCゾーン幅をATR連動にする")
volAtrLen     = input.int(14,  "出来高ATR期間")
pocZoneATRMult= input.float(0.25, "POCゾーン幅 (ATR倍率)")

crossLookback = input.int(10, "貫通前 参照本数")
acceptBars    = input.int(2,  "定着本数")
useDirCandleForAcceptance     = input.bool(false, "方向ローソク確認")

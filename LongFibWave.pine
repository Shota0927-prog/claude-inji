//@version=5
// =====================================================================================
//  Long Fib Wave (LFW-3) — 長期フィボナッチ単体インジケーター（日足・4時間足）
// -------------------------------------------------------------------------------------
//  目的 : 各対象時間足の「最新の大きな波」に起点・終点・結ぶ線・フィボ水準を引き、
//         波の終点から「どこまで戻ってから元の方向へ進むことが多いか」を集計する。
//  範囲 : 価格帯の検知と統計だけ。エントリー条件・Strong/Weak 判定・反転シグナル保持・Zone 連携は持たない。
//  詳細 : LONG_FIB_WAVE_ja.md / 検証 : tests/lfw_sim.py（下の Logic 区間をそのまま変換して実行）
//
//  ■ データの受け取り（リペイントしない）
//    request.security(…, "D" / "240", [high[1], low[1], time[1], ta.atr(14)[1]], lookahead_on)
//    → 確定した対象時間足 1 本分だけが届く。チャート足が確定した時点で「新しく届いた確定足」を 1 回だけ処理する。
//    チャート足 == 対象時間足のときは、その足自身を確定時に処理する。チャート足 > 対象時間足は計算しない（表示で明示）。
//
//  ■ 主要高安による逆方向の新しい波（下降波候補で説明。上昇は上下対称）
//    主要高値 = 左 N 本・右 R 本のすべての高値を厳密に上回る足（D: 20 / 3、4H: 60 / 3）。右 R 本目の確定で利用可能。
//    必要下落幅 = その極値足の ATR(14) × 倍率（時間足別。既定 日足 7.0 / 4H 6.0。極値足で固定）。極値足より後の最安値までの下落が必要幅以上、
//    候補が確認済み・未無効化（後の高値が候補を厳密に上回っていない）・未採用、かつ現在の波が上昇波でその起点足より新しい
//    → 新しい下降波（起点 = 主要高値、終点 = その最安値）を採用する。同方向の pivot では起点を変えない。
//
//  ■ 同じ波の継続・同方向の切替・方向反転（下降波で説明）
//    ① 起点高値を保持し、安値（ヒゲ）を更新するたびに終点を更新する
//    ② 終点からの戻り高値（ヒゲ）が 波幅 × 切替率（時間足別。既定 日足 0.90 / 4H 0.782）以上 → その戻り高値を次の起点候補として追跡
//    ③ 戻る前の安値（終点）を割った足で、その戻り高値を新しい起点にして新しい下降波へ切り替える
//    ④ 起点を厳密に上抜け（高値 > 起点）→ 方向反転：旧終点を起点とする上昇波へ。起点ちょうどは反転しない（全戻し）
//    逆方向の採用が成立した足では①〜④の代わりにその採用 1 つだけを適用する（1 本の足に切替を重ねない）。
//
//  ■ 足内の順序（上下対称）
//    1 本の確定足は「高値→安値」「安値→高値」の両方で処理する。結果の波が同じなら確定、違えば仮定で選ばず「保留」。
//    保留中は候補の波をすべて同じ規則（主要高安の採用を含む）で進め、全候補が同じ波になった確定足で保留を解く。
//
//  ■ 戻り観測（統計）
//    終点からの戻りが 波幅の 10% 以上になった時点で 1 件の正式観測を開始。分母（起点・終点）は開始時に固定。
//    決着 : 再開 / 全戻し（起点ちょうど）/ 波切替終了（起点突破の反転、または主要高安による新波の採用。後者は 100% 未満もある）/
//           順序不明。未決着は「観測中」。観測期限なし。集計の段は決着理由と別に、固定分母での最大戻り率で決める。
// =====================================================================================
indicator("Long Fib Wave (D / 4H)", "LFW", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ---------------------------------------------------------------- inputs
grpT = "① 対象時間足"
lfwOnD          = input.bool(true, "日足 (D) を計算",            group = grpT)
lfwOn4          = input.bool(true, "4時間足 (240) を計算",       group = grpT)
lfwShowD        = input.bool(true, "日足 (D) を表示（OFF でも計算・集計は続ける）",  group = grpT)
lfwShow4        = input.bool(true, "4時間足 (240) を表示（OFF でも計算・集計は続ける）", group = grpT)

grpW = "② 波の切替・観測"
lfwSwitchRatioD = input.float(0.90,  "日足: 同方向切替率（この戻り率以上の戻り高安を次の起点候補にする）", minval = 0.01, maxval = 1.0, step = 0.001, group = grpW)
lfwSwitchRatio4 = input.float(0.782, "4H: 同方向切替率（この戻り率以上の戻り高安を次の起点候補にする）",   minval = 0.01, maxval = 1.0, step = 0.001, group = grpW)
lfwStartRatio   = input.float(0.10,  "観測開始の戻り率",           minval = 0.01, maxval = 1.0, step = 0.01, group = grpW)
lfwExclInit     = input.bool(true,  "最初の波の観測を統計から除外", group = grpW)

grpP = "③ 主要高安（逆方向の新しい波）"
lfwAtrLen       = input.int(14,     "ATR 期間（各対象時間足自身）", minval = 1, group = grpP)
lfwPivLD        = input.int(20,     "日足: 左の本数",               minval = 1, maxval = 200, group = grpP)
lfwPivRD        = input.int(3,      "日足: 右の本数（確認）",       minval = 1, maxval = 50,  group = grpP)
lfwPivMD        = input.float(7.0,  "日足: 必要値幅（極値足の ATR 倍率）", minval = 0.1, step = 0.1, group = grpP)
lfwPivL4        = input.int(60,     "4H: 左の本数",                 minval = 1, maxval = 200, group = grpP)
lfwPivR4        = input.int(3,      "4H: 右の本数（確認）",         minval = 1, maxval = 50,  group = grpP)
lfwPivM4        = input.float(6.0,  "4H: 必要値幅（極値足の ATR 倍率）",   minval = 0.1, step = 0.1, group = grpP)

grpD = "④ 描画"
lfwLevelsStr    = input.string("0,0.236,0.382,0.5,0.618,0.79,1", "表示するフィボ水準（0=終点 / 1=起点）", group = grpD)
lfwShowCand     = input.bool(true,  "切替候補（戻り高安）を表示",  group = grpD)
lfwColD         = input.color(color.new(color.purple, 0), "日足の色",  group = grpD)
lfwCol4         = input.color(color.new(color.teal, 0),   "4時間足の色", group = grpD)

grpS = "⑤ 統計表示"
lfwStatSel      = input.string("4H 下降", "統計表",  options = ["4H 下降", "4H 上昇", "日足 下降", "日足 上昇", "非表示"], group = grpS)
lfwShowInfo     = input.bool(true,  "波の状態表を表示",            group = grpS)
lfwMaxRecs      = input.int(1000,   "保存する観測記録の上限（件数集計は上限なし）", minval = 10, group = grpS)

grpG = "⑥ 診断（起点・方向の変更理由）"
lfwDiagOn       = input.bool(true,  "診断表を表示",               group = grpG)
lfwDiagTf       = input.string("4H", "診断の対象", options = ["日足", "4H"], group = grpG)

// ---------------------------------------------------------------- confirmed higher-timeframe bars
lfwChartSec = timeframe.in_seconds()
lfwOkD = lfwOnD and lfwChartSec <= timeframe.in_seconds("D")
lfwOk4 = lfwOn4 and lfwChartSec <= timeframe.in_seconds("240")

// チャート足 == 対象時間足 : その足が確定した時点で、その足自身を処理する（1 本遅れにしない）
lfwSameD = lfwChartSec == timeframe.in_seconds("D")
lfwSame4 = lfwChartSec == timeframe.in_seconds("240")
lfwAtrC  = ta.atr(lfwAtrLen)

// チャート足 < 対象時間足 : 確定した対象時間足 1 本分（[1] + lookahead_on）。対象時間足の確定後、最初のチャート足で届く
[lfwDhS, lfwDlS, lfwDtS, lfwDatrS] = request.security(syminfo.tickerid, "D",   [high[1], low[1], time[1], ta.atr(lfwAtrLen)[1]], lookahead = barmerge.lookahead_on)
[lfw4hS, lfw4lS, lfw4tS, lfw4atrS] = request.security(syminfo.tickerid, "240", [high[1], low[1], time[1], ta.atr(lfwAtrLen)[1]], lookahead = barmerge.lookahead_on)

lfwDh   = lfwSameD ? high     : lfwDhS
lfwDl   = lfwSameD ? low      : lfwDlS
lfwDt   = lfwSameD ? time     : lfwDtS
lfwDatr = lfwSameD ? lfwAtrC  : lfwDatrS
lfw4h   = lfwSame4 ? high     : lfw4hS
lfw4l   = lfwSame4 ? low      : lfw4lS
lfw4t   = lfwSame4 ? time     : lfw4tS
lfw4atr = lfwSame4 ? lfwAtrC  : lfw4atrS

// 新しい確定足を処理するチャート足（の確定時）だけ true
lfwNewD = lfwOkD and barstate.isconfirmed and not na(lfwDt) and (lfwSameD or lfwDtS != nz(lfwDtS[1], -1))
lfwNew4 = lfwOk4 and barstate.isconfirmed and not na(lfw4t) and (lfwSame4 or lfw4tS != nz(lfw4tS[1], -1))

// ==== LFW Logic (begin) — tests/lfw_sim.py translates and runs this section as is ====
// 観測の決着区分 (outcome) : 0 再開 / 1 全戻し / 2 波切替終了 / 4 順序不明（3 = 観測中は記録せず、表示時に数える）
// ビン (bin) : 固定分母での最大戻り率。1..9 = [10,20) .. [90,100) / 10 = 100%（全戻し）/ 11 = 100% 超（起点突破）
type LfwRec
    int dir
    int waveId
    int seq
    float refO
    float refE
    int startAvail
    int endAvail
    int outcome
    float rMax
    float rAlt
    int bin

// 波の状態だけ（観測を含まない）。保留中は候補をこの型で複数持つ
type LfwWave
    int dir = 0
    bool init = false
    float O = na
    int oT = na
    int oAvail = na
    float E = na
    int eT = na
    int eAvail = na
    float rx = na
    int rxT = na
    // 診断専用（判定・保留の比較には使わない）: この波の起点・方向を最後に決めた分岐と、そのとき使った値
    int dgWhy = 0          // 1 最初の波（主要高安） / 2 主要高安採用 / 3 同方向切替（時間足別の切替率） / 4 起点突破（方向反転）
    float dgRatio = na     // 3: 判定に使った戻り率 / 4: 突破した価格の戻り率（> 1）
    float dgSw = na        // 3: 判定に使ったこの時間足の同方向切替率
    int dgCandT = na       // 1・2: 候補の極値足の時刻
    float dgAtr = na       // 1・2: 極値足で固定した ATR
    float dgThr = na       // 1・2: 必要値幅
    float dgMove = na      // 1・2: 採用時の実値幅
    bool dgMulti = false   // 保留の解除で、同じ波に至る候補が別の経路を持っていた

// 起点または方向の変更 1 件の診断記録（日足・4H 別に直近 10 件）
type LfwDiag
    int avail
    bool viaHold
    int holdAvail
    int bDir
    float bO
    int bOT
    float bE
    int aDir
    float aO
    int aOT
    float aE
    int why
    float ratio
    int candT
    float atr
    float thr
    float move
    bool multi
    float sw

// 主要高安の候補。kind 1 = 主要高値（下降波の候補）/ -1 = 主要安値（上昇波の候補）
type LfwCand
    int kind
    float p
    int t
    float atr
    float thr
    int avail
    float ext = na
    int extT = na
    float rx = na
    int rxT = na
    bool adopted = false

type LfwTf
    LfwWave w
    bool hold = false
    array<LfwWave> hyps
    int holdAvail = na
    int waveId = 0
    bool obsOn = false
    bool obsDone = false
    int obsDir = 0
    float obsO = na
    float obsE = na
    int obsStart = na
    int obsSeq = 0
    bool obsInit = false
    int pL = 20
    int pR = 3
    float pM = 5.0
    float sw = 0.782       // この時間足の同方向切替率（入力）
    array<float> bH
    array<float> bL
    array<int> bT
    array<float> bA
    LfwCand cHi = na
    LfwCand cLo = na
    float initAtr = na
    int initAvail = na
    int firstT = na
    int nBars = 0
    array<int> cnt
    array<int> nWaveObs
    array<LfwRec> recs
    array<LfwDiag> diag
    int nExclInit = 0
    int nStartAmb = 0
    int nHold = 0
    int nNoRetro = 0
    int nReinit = 0
    int nCandBroken = 0
    int nAdopt = 0

lfwNewTf(int pl, int pr, float pm, float sw) =>
    LfwTf.new(w = LfwWave.new(), hyps = array.new<LfwWave>(), pL = pl, pR = pr, pM = pm, sw = sw, bH = array.new_float(),
     bL = array.new_float(), bT = array.new_int(), bA = array.new_float(), cnt = array.new_int(120, 0),
     nWaveObs = array.new_int(2, 0), recs = array.new<LfwRec>(), diag = array.new<LfwDiag>())

lfwIdx(int d, int b, int o) =>
    ((d == 1 ? 0 : 1) * 12 + b) * 5 + o

lfwBin(float r) =>
    r > 1.0 ? 11 : r >= 1.0 ? 10 : math.max(0, math.min(9, math.floor(r * 10.0 + 0.000000001)))

// 戻り率 : 終点から価格 p までの戻り ÷ 波幅（上昇波・下降波共通の式）
lfwRatio(LfwWave w, float p) =>
    (w.E - p) / (w.E - w.O)

// ---------------------------------------------------------------- 主要高安の候補
// 候補の極値足より後の確定足 1 本で、候補を進める。返り値 false = 候補を後の高値（安値候補は安値）が厳密に超えた（無効）
// 極値の更新（高値候補なら最安値の更新）があった足の反対側のヒゲは、その後の戻りに使わない
lfwCandBar(LfwCand c, float h, float l, int t) =>
    bool ok = true
    if c.kind == 1
        if h > c.p
            ok := false
        else if na(c.ext) or l < c.ext
            c.ext := l
            c.extT := t
            c.rx := na
            c.rxT := na
        else if na(c.rx) or h > c.rx
            c.rx := h
            c.rxT := t
    else
        if l < c.p
            ok := false
        else if na(c.ext) or h > c.ext
            c.ext := h
            c.extT := t
            c.rx := na
            c.rxT := na
        else if na(c.rx) or l < c.rx
            c.rx := l
            c.rxT := t
    ok

// 窓の中央の足（左 pL 本・右 pR 本）から候補を作る。右の pR 本で極値より後の動きを初期化する
lfwMakeCand(LfwTf S, int kind, int c, float a, int availT) =>
    float p = kind == 1 ? array.get(S.bH, c) : array.get(S.bL, c)
    LfwCand k = LfwCand.new(kind, p, array.get(S.bT, c), a, a * S.pM, availT)
    for i = c + 1 to array.size(S.bH) - 1
        lfwCandBar(k, array.get(S.bH, i), array.get(S.bL, i), array.get(S.bT, i))
    k

// 確定足 1 本ごと : 既存候補を進め（無効化を含む）、窓に足して、右 pR 本目が確定した足を候補にする
lfwCandStep(LfwTf S, float h, float l, int t, float atr, int availT) =>
    if not na(S.cHi)
        if not lfwCandBar(S.cHi, h, l, t)
            S.cHi := na
            S.nCandBroken := S.nCandBroken + 1
    if not na(S.cLo)
        if not lfwCandBar(S.cLo, h, l, t)
            S.cLo := na
            S.nCandBroken := S.nCandBroken + 1
    array.push(S.bH, h)
    array.push(S.bL, l)
    array.push(S.bT, t)
    array.push(S.bA, atr)
    int n = S.pL + S.pR + 1
    if array.size(S.bH) > n
        array.shift(S.bH)
        array.shift(S.bL)
        array.shift(S.bT)
        array.shift(S.bA)
    if array.size(S.bH) == n
        int c = S.pL
        float ph = array.get(S.bH, c)
        float pl = array.get(S.bL, c)
        bool isH = true
        bool isL = true
        for i = 0 to n - 1
            if i != c
                if array.get(S.bH, i) >= ph
                    isH := false
                if array.get(S.bL, i) <= pl
                    isL := false
        float a = array.get(S.bA, c)
        if not na(a)
            if a > 0
                if isH
                    S.cHi := lfwMakeCand(S, 1, c, a, availT)
                if isL
                    S.cLo := lfwMakeCand(S, -1, c, a, availT)
    true

// 採用できる候補か（確認済み・未無効化・未採用・極値足より後の値幅が固定閾値以上）
lfwCandOk(LfwCand c) =>
    bool ok = false
    if not na(c)
        if not c.adopted and not na(c.ext)
            ok := math.abs(c.p - c.ext) >= c.thr
    ok

lfwCandWave(LfwCand c, bool init, int availT) =>
    LfwWave.new(-c.kind, init, c.p, c.t, availT, c.ext, c.extT, availT, c.rx, c.rxT, dgWhy = init ? 1 : 2, dgCandT = c.t,
     dgAtr = c.atr, dgThr = c.thr, dgMove = math.abs(c.p - c.ext))

// 波 w に対する主要高安の採用。上昇波には主要高値、下降波には主要安値だけ（起点足より新しい極値）。
// 波がない場合は両方を見て、極値足が新しい方。同じ足なら方向を選べないので採用しない
lfwAdopt(LfwTf S, LfwWave w, int availT) =>
    LfwWave res = na
    if w.dir == 1
        if lfwCandOk(S.cHi)
            if S.cHi.t > w.oT
                res := lfwCandWave(S.cHi, false, availT)
    else if w.dir == -1
        if lfwCandOk(S.cLo)
            if S.cLo.t > w.oT
                res := lfwCandWave(S.cLo, false, availT)
    else
        bool okH = lfwCandOk(S.cHi)
        bool okL = lfwCandOk(S.cLo)
        if okH and okL
            if S.cHi.t > S.cLo.t
                res := lfwCandWave(S.cHi, true, availT)
            else if S.cLo.t > S.cHi.t
                res := lfwCandWave(S.cLo, true, availT)
        else if okH
            res := lfwCandWave(S.cHi, true, availT)
        else if okL
            res := lfwCandWave(S.cLo, true, availT)
    res

// 採用した波の起点が候補そのものなら、その候補を採用済みにする（重複採用しない）
lfwMarkAdopted(LfwTf S, LfwWave w) =>
    LfwCand ch = S.cHi
    LfwCand cl = S.cLo
    if w.dir == -1 and not na(ch)
        if ch.t == w.oT and ch.p == w.O
            ch.adopted := true
    if w.dir == 1 and not na(cl)
        if cl.t == w.oT and cl.p == w.O
            cl.adopted := true
    true

// ---------------------------------------------------------------- 波の状態
// 診断 : 起点・方向を変える分岐の中で、その分岐の理由と値を波に書く（判定には使わない）
lfwDgSet(LfwWave w, int why, float ratio) =>
    w.dgWhy := why
    w.dgRatio := ratio
    w.dgCandT := na
    w.dgAtr := na
    w.dgThr := na
    w.dgMove := na
    w.dgMulti := false
    w.dgSw := na
    true

// 価格 1 点の処理（波の状態だけ）。noRet = 同じ足で既に終点が変わった後の点（終点より後とは限らないので戻りに使わない）
// 返り値 : 終点が変わったか
lfwPoint(LfwWave w, float p, int t, int availT, bool noRet, float sw) =>
    int s = w.dir
    bool changed = false
    if s * (p - w.E) > 0
        // 終点更新。切替率以上の戻り高安（候補）があれば、それを新しい起点にする（同方向の波切替）
        if not na(w.rx) and lfwRatio(w, w.rx) >= sw
            lfwDgSet(w, 3, lfwRatio(w, w.rx))
            w.dgSw := sw
            w.O := w.rx
            w.oT := w.rxT
            w.oAvail := availT
            w.init := false
        w.E := p
        w.eT := t
        w.eAvail := availT
        w.rx := na
        w.rxT := na
        changed := true
    else if s * (w.O - p) > 0
        // 起点を厳密に突破 : 方向反転。旧終点が新しい起点
        lfwDgSet(w, 4, lfwRatio(w, p))
        w.dir := -s
        w.O := w.E
        w.oT := w.eT
        w.oAvail := availT
        w.E := p
        w.eT := t
        w.eAvail := availT
        w.rx := na
        w.rxT := na
        w.init := false
        changed := true
    else if not noRet and (na(w.rx) or lfwRatio(w, p) > lfwRatio(w, w.rx))
        w.rx := p
        w.rxT := t
    changed

lfwSame(LfwWave a, LfwWave b) =>
    a.dir == b.dir and a.init == b.init and a.O == b.O and a.oT == b.oT and a.E == b.E and a.eT == b.eT and
     (na(a.rx) ? na(b.rx) : (not na(b.rx) and a.rx == b.rx and a.rxT == b.rxT))

// 確定足 1 本 = 高値と安値（順序は OHLC から分からない）。高値→安値・安値→高値の両方で処理し、
// 結果が同じなら 1 個、違えば 2 個を out に追加する（どちらかを仮定で選ばない）
lfwBarStep(LfwWave w, float h, float l, int t, int availT, array<LfwWave> out, float sw) =>
    LfwWave a = w.copy()
    bool ca = lfwPoint(a, h, t, availT, false, sw)
    lfwPoint(a, l, t, availT, ca, sw)
    LfwWave b = w.copy()
    bool cb = lfwPoint(b, l, t, availT, false, sw)
    lfwPoint(b, h, t, availT, cb, sw)
    array.push(out, a)
    if not lfwSame(a, b)
        array.push(out, b)
    array.size(out)

// 1 つの波（保留中は各候補）の確定足 1 本 : 主要高安の採用が成立すればその 1 つ、なければ従来の処理
lfwHypStep(LfwTf S, LfwWave w, float h, float l, int t, int availT, array<LfwWave> out) =>
    LfwWave a = lfwAdopt(S, w, availT)
    if not na(a)
        array.push(out, a)
    else
        lfwBarStep(w, h, l, t, availT, out, S.sw)
    array.size(out)

// ---------------------------------------------------------------- 観測
lfwStartObs(LfwTf S, int availT) =>
    S.obsOn := true
    S.obsDir := S.w.dir
    S.obsO := S.w.O
    S.obsE := S.w.E
    S.obsStart := availT
    S.obsSeq := S.obsSeq + 1
    S.obsInit := S.w.init and lfwExclInit
    if not S.obsInit and S.obsSeq == 1
        int k = S.obsDir == 1 ? 0 : 1
        array.set(S.nWaveObs, k, array.get(S.nWaveObs, k) + 1)
    true

// 決着の保存。段は決着理由と別に、固定分母での戻り率 r から決める（主要高安の採用による波切替終了は 100% 未満もある）
lfwRecord(LfwTf S, int outcome, float r, float rAlt, int availT) =>
    int b = lfwBin(r)
    if S.obsInit
        S.nExclInit := S.nExclInit + 1
    else
        int idx = lfwIdx(S.obsDir, b, outcome)
        array.set(S.cnt, idx, array.get(S.cnt, idx) + 1)
        array.push(S.recs, LfwRec.new(S.obsDir, S.waveId, S.obsSeq, S.obsO, S.obsE, S.obsStart, availT, outcome, r, rAlt, b))
        if array.size(S.recs) > lfwMaxRecs
            array.shift(S.recs)
    S.obsOn := false
    b

// 新しい波（起点が変わった・保留が解けた・採用した）: 波番号を進め、観測を新しい波で数え直す
lfwBook(LfwTf S) =>
    S.waveId := S.waveId + 1
    S.obsOn := false
    S.obsDone := false
    S.obsSeq := 0
    true

// 診断 : 起点または方向が変わったときだけ記録する（終点だけの更新は記録しない）。直近 10 件
lfwLog(LfwTf S, LfwWave b, LfwWave a, int availT, bool viaHold) =>
    if a.dir != b.dir or a.O != b.O or a.oT != b.oT or na(b.O)
        array.push(S.diag, LfwDiag.new(availT, viaHold, S.holdAvail, b.dir, b.O, b.oT, b.E, a.dir, a.O, a.oT, a.E, a.dgWhy,
             a.dgRatio, a.dgCandT, a.dgAtr, a.dgThr, a.dgMove, a.dgMulti, a.dgSw))
        if array.size(S.diag) > 10
            array.shift(S.diag)
    true

// 採用・保留解除より前に起きた戻りからは観測を作らない（この終点が更新されるまで）
lfwNoRetro(LfwTf S) =>
    if not na(S.w.rx)
        if lfwRatio(S.w, S.w.rx) >= lfwStartRatio
            S.obsDone := true
            S.nNoRetro := S.nNoRetro + 1
    true

// 波がない（最初・安全弁の後）: 主要高安＋値幅で最初の波を採用する
lfwStartFirst(LfwTf S, int availT) =>
    LfwWave a = lfwAdopt(S, S.w, availT)
    if not na(a)
        lfwLog(S, S.w, a, availT, false)
        S.w := a
        lfwMarkAdopted(S, a)
        S.initAvail := availT
        if a.dir == -1
            S.initAtr := S.cHi.atr
        else
            S.initAtr := S.cLo.atr
        S.nAdopt := S.nAdopt + 1
        lfwBook(S)
        lfwNoRetro(S)
    true

// 保留中 : 各候補を同じ規則で進め、結果がすべて同じになった確定足で保留を解く（保留中は観測しない）
lfwHoldStep(LfwTf S, float h, float l, int t, int availT) =>
    array<LfwWave> nxt = array.new<LfwWave>()
    for i = 0 to array.size(S.hyps) - 1
        array<LfwWave> res = array.new<LfwWave>()
        lfwHypStep(S, array.get(S.hyps, i), h, l, t, availT, res)
        for k = 0 to array.size(res) - 1
            LfwWave c = array.get(res, k)
            bool dup = false
            if array.size(nxt) > 0
                for j = 0 to array.size(nxt) - 1
                    LfwWave x = array.get(nxt, j)
                    if lfwSame(x, c)
                        dup := true
                        // 診断だけ : 同じ波に別の経路で至った候補があったことを残す（判定・解除には使わない）
                        if x.dgWhy != c.dgWhy or x.oAvail != c.oAvail
                            x.dgMulti := true
            if not dup
                array.push(nxt, c)
    S.hyps := nxt
    if array.size(nxt) == 1
        LfwWave nw = array.get(nxt, 0)
        // 一意になった時点が、この起点・終点を使える時刻
        nw.oAvail := availT
        nw.eAvail := availT
        lfwLog(S, S.w, nw, availT, true)
        S.w := nw
        S.hold := false
        S.hyps := array.new<LfwWave>()
        lfwMarkAdopted(S, nw)
        lfwBook(S)
        lfwNoRetro(S)
    else if array.size(nxt) > 16
        // 候補が増え続ける場合の安全弁 : 波を捨て、主要高安の方式で最初の波からやり直す（件数を表示）
        S.hold := false
        S.hyps := array.new<LfwWave>()
        S.w := LfwWave.new()
        S.nReinit := S.nReinit + 1
        lfwStartFirst(S, availT)
    true

// 確定した対象時間足 1 本の処理
lfwProcess(LfwTf S, float h, float l, int t, float atr, int availT) =>
    if na(S.firstT)
        S.firstT := t
    S.nBars := S.nBars + 1
    lfwCandStep(S, h, l, t, atr, availT)
    if S.hold
        lfwHoldStep(S, h, l, t, availT)
    else if S.w.dir == 0
        lfwStartFirst(S, availT)
    else
        LfwWave w = S.w
        int s = w.dir
        float extP = s == 1 ? h : l
        float retP = s == 1 ? l : h
        bool X = s * (extP - w.E) > 0
        bool B = s * (w.O - retP) > 0
        bool T = retP == w.O
        float rPrior = na(w.rx) ? 0.0 : lfwRatio(w, w.rx)
        float rBar = lfwRatio(w, retP)
        LfwWave aw = lfwAdopt(S, w, availT)
        array<LfwWave> res = array.new<LfwWave>()
        if na(aw)
            lfwBarStep(w, h, l, t, availT, res, S.sw)
        if na(aw) and array.size(res) > 1
            // 足内の順序で波の状態が変わる : 判定を保留。観測中の観測は順序不明で閉じる
            if S.obsOn
                lfwRecord(S, 4, rPrior, rBar, availT)
            S.hold := true
            S.hyps := res
            S.holdAvail := availT
            S.nHold := S.nHold + 1
        else
            // 旧観測を旧分母で先に処理してから、波を更新する
            if X
                // 元方向へ終点更新 : 旧観測の決着を旧分母で保存
                if S.obsOn
                    if rBar > rPrior and (rBar >= 1.0 or lfwBin(rBar) != lfwBin(rPrior))
                        lfwRecord(S, 4, rPrior, rBar, availT)
                    else
                        lfwRecord(S, 0, rPrior, na, availT)
                else if not S.obsDone and rBar >= lfwStartRatio
                    S.nStartAmb := S.nStartAmb + 1
                S.obsDone := false
            else if B
                // 起点を厳密に突破 : 波切替終了（10% 未満から 1 本で突破した場合も、この足で開始して終了）
                if S.obsOn
                    lfwRecord(S, 2, rBar, na, availT)
                else if not S.obsDone
                    lfwStartObs(S, availT)
                    lfwRecord(S, 2, rBar, na, availT)
            else
                // 戻り側だけ : 最大戻り率を更新し、観測の開始・全戻しを判定
                float rNow = na(w.rx) ? rBar : math.max(rPrior, rBar)
                if not S.obsOn and not S.obsDone and rNow >= lfwStartRatio
                    lfwStartObs(S, availT)
                if S.obsOn and T
                    lfwRecord(S, 1, 1.0, na, availT)
                    S.obsDone := true
                // それでも観測中のまま主要高安の新しい波へ切り替わる : 旧分母・旧最大戻り率で波切替終了
                if S.obsOn and not na(aw)
                    lfwRecord(S, 2, rNow, na, availT)
            LfwWave nw = aw
            if na(aw)
                nw := array.get(res, 0)
            bool newWave = nw.dir != w.dir or nw.O != w.O or nw.oT != w.oT
            if newWave
                lfwLog(S, w, nw, availT, false)
            S.w := nw
            if newWave
                lfwBook(S)
            if not na(aw)
                lfwMarkAdopted(S, aw)
                S.nAdopt := S.nAdopt + 1
                lfwNoRetro(S)
    true

var LfwTf lfwD = lfwNewTf(lfwPivLD, lfwPivRD, lfwPivMD, lfwSwitchRatioD)
var LfwTf lfw4 = lfwNewTf(lfwPivL4, lfwPivR4, lfwPivM4, lfwSwitchRatio4)
if lfwNewD
    lfwProcess(lfwD, lfwDh, lfwDl, lfwDt, lfwDatr, time_close)
if lfwNew4
    lfwProcess(lfw4, lfw4h, lfw4l, lfw4t, lfw4atr, time_close)
// ==== LFW Logic (end) ====

// ---------------------------------------------------------------- display helpers (not part of the logic)
f_px(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

f_tm(int t) =>
    na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", syminfo.timezone)

f_levels() =>
    array<float> out = array.new_float()
    for s in str.split(lfwLevelsStr, ",")
        float v = str.tonumber(str.replace_all(s, " ", ""))
        if not na(v)
            array.push(out, v)
    out

// 描画オブジェクトは時間足ごとのプールを再利用する（毎回作り直さない）。使わないものは透明にして隠す
f_ln(array<line> pool, int i) =>
    if array.size(pool) <= i
        array.push(pool, line.new(time, close, time, close, xloc = xloc.bar_time, color = color.new(color.gray, 100)))
    array.get(pool, i)

f_lb(array<label> pool, int i) =>
    if array.size(pool) <= i
        array.push(pool, label.new(time, close, "", xloc = xloc.bar_time, color = color.new(color.gray, 100),
                     textcolor = color.new(color.gray, 100), size = size.tiny))
    array.get(pool, i)

f_setLn(line ln, int x1, float y1, int x2, float y2, color c, string st, int wd) =>
    line.set_xy1(ln, x1, y1)
    line.set_xy2(ln, x2, y2)
    line.set_color(ln, c)
    line.set_style(ln, st)
    line.set_width(ln, wd)
    line.set_extend(ln, extend.none)
    true

f_setLb(label lb, int x, float y, string tx, color bg, color fg, string st, string sz, string tip) =>
    label.set_xy(lb, x, y)
    label.set_text(lb, tx)
    label.set_color(lb, bg)
    label.set_textcolor(lb, fg)
    label.set_style(lb, st)
    label.set_size(lb, sz)
    label.set_tooltip(lb, tip)
    true

f_hide(array<line> lns, int nl, array<label> lbs, int nb) =>
    if array.size(lns) > nl
        for i = nl to array.size(lns) - 1
            line.set_color(array.get(lns, i), color.new(color.gray, 100))
    if array.size(lbs) > nb
        for i = nb to array.size(lbs) - 1
            label.set_text(array.get(lbs, i), "")
            label.set_color(array.get(lbs, i), color.new(color.gray, 100))
            label.set_textcolor(array.get(lbs, i), color.new(color.gray, 100))
            label.set_tooltip(array.get(lbs, i), "")
    true

// 波の描画 : 最新の確定済み波 1 本だけ（未採用の主要高安候補は描かない）。
// 位置は極値を含む対象時間足の足、利用可能時刻は tooltip に別記。水準線は起点の足から現在の足まで（チャート全体へ延長しない）
f_draw(LfwTf S, string tag, color col, bool show, array<line> lns, array<label> lbs) =>
    int nl = 0
    int nb = 0
    if show and S.hold
        for hw in S.hyps
            f_setLn(f_ln(lns, nl), hw.oT, hw.O, hw.eT, hw.E, color.new(color.gray, 30), line.style_dotted, 1)
            nl += 1
        LfwWave h0 = array.get(S.hyps, 0)
        f_setLb(f_lb(lbs, nb), h0.eT, h0.E, tag + " 保留中（候補 " + str.tostring(array.size(S.hyps)) + "）",
             color.new(color.gray, 20), color.white, label.style_label_left, size.small,
             "足内の順序が分からないため、波を一意に決められない（フィボは描かない）。\n保留開始: " + f_tm(S.holdAvail))
        nb += 1
    else if show and S.w.dir != 0
        LfwWave w = S.w
        bool dn = w.dir == -1
        string kind = tag + " " + (dn ? "下降波" : "上昇波") + (w.init ? "（最初の波）" : "")
        f_setLn(f_ln(lns, nl), w.oT, w.O, w.eT, w.E, col, line.style_solid, 2)
        nl += 1
        f_setLb(f_lb(lbs, nb), w.oT, w.O, kind + " 起点 " + f_px(w.O) + "\n" + f_tm(w.oT), col, color.white,
             dn ? label.style_label_down : label.style_label_up, size.small,
             kind + " / 波 ID " + str.tostring(S.waveId) + "\n極値の足: " + f_tm(w.oT) + "\n起点として利用可能: " + f_tm(w.oAvail))
        nb += 1
        f_setLb(f_lb(lbs, nb), w.eT, w.E, kind + " 終点 " + f_px(w.E) + "\n" + f_tm(w.eT), col, color.white,
             dn ? label.style_label_up : label.style_label_down, size.small,
             kind + "\n極値の足: " + f_tm(w.eT) + "\n終点として利用可能: " + f_tm(w.eAvail))
        nb += 1
        array<float> lv = f_levels()
        for v in lv
            float p = w.E + v * (w.O - w.E)
            f_setLn(f_ln(lns, nl), w.oT, p, time, p, color.new(col, 45), line.style_dashed, 1)
            nl += 1
            f_setLb(f_lb(lbs, nb), time, p, tag + " " + str.tostring(v) + "  " + f_px(p), color.new(col, 85), col,
                 label.style_label_left, size.tiny, "現在の終点 " + f_px(w.E) + " で計算した比較用の表示（過去の各時点に存在した線ではない）")
            nb += 1
        if lfwShowCand and not na(w.rx)
            float rr = lfwRatio(w, w.rx)
            if rr >= S.sw
                f_setLn(f_ln(lns, nl), w.rxT, w.rx, time, w.rx, color.new(color.orange, 0), line.style_dotted, 2)
                nl += 1
                f_setLb(f_lb(lbs, nb), w.rxT, w.rx, tag + " 切替候補 " + f_px(w.rx) + " (" + str.tostring(rr * 100, "#.0") + "%)",
                     color.new(color.orange, 0), color.black, dn ? label.style_label_down : label.style_label_up, size.tiny,
                     "終点 " + f_px(w.E) + " を割る（上昇波は超える）と、ここが新しい起点になる")
                nb += 1
    f_hide(lns, nl, lbs, nb)

var array<line>  lfwLnD = array.new<line>()
var array<label> lfwLbD = array.new<label>()
var array<line>  lfwLn4 = array.new<line>()
var array<label> lfwLb4 = array.new<label>()

// 各時点で利用できた波（データウィンドウで確認用。保留中は起点・終点を出さない）
plot(lfwD.w.dir != 0 and not lfwD.hold ? lfwD.w.O : na, "日足 起点", display = display.data_window)
plot(lfwD.w.dir != 0 and not lfwD.hold ? lfwD.w.E : na, "日足 終点", display = display.data_window)
plot(lfwD.hold ? 0 : lfwD.w.dir, "日足 方向 (1 上昇 / -1 下降 / 0 波なし・保留中)", display = display.data_window)
plot(lfwD.hold ? 1 : 0, "日足 保留中", display = display.data_window)
plot(lfwD.waveId, "日足 波 ID", display = display.data_window)
plot(lfw4.w.dir != 0 and not lfw4.hold ? lfw4.w.O : na, "4H 起点", display = display.data_window)
plot(lfw4.w.dir != 0 and not lfw4.hold ? lfw4.w.E : na, "4H 終点", display = display.data_window)
plot(lfw4.hold ? 0 : lfw4.w.dir, "4H 方向 (1 上昇 / -1 下降 / 0 波なし・保留中)", display = display.data_window)
plot(lfw4.hold ? 1 : 0, "4H 保留中", display = display.data_window)
plot(lfw4.waveId, "4H 波 ID", display = display.data_window)

// ---------------------------------------------------------------- tables
f_cell(table tb, int c, int r, string tx, color bg) =>
    table.cell(tb, c, r, tx, text_color = color.white, bgcolor = bg, text_size = size.small)
    true

f_pct(int n, int d) =>
    d > 0 ? str.tostring(100.0 * n / d, "#.0") + "%" : "—"

f_stats(table tb, LfwTf S, int d, string title) =>
    color hd = color.new(color.gray, 20)
    color bd = color.new(color.black, 30)
    array<string> heads = array.from("最大戻り率", "再開", "全戻し", "波切替終了", "観測中", "順序不明", "計",
         "構成比 (計/全正式)", "区間内の再開率 (再開/計)", "再開確定例に限った分布 (再開/再開計)")
    for c = 0 to 9
        f_cell(tb, c, 1, array.get(heads, c), hd)
    table.merge_cells(tb, 0, 0, 9, 0)
    // 観測中は 1 時間足につき最大 1 件（現在の最大戻り率の段に数える）
    int liveBin = -1
    if S.obsOn and not S.obsInit and S.obsDir == d
        liveBin := lfwBin(lfwRatio(S.w, S.w.rx))
    array<int> tot = array.new_int(5, 0)
    int nAll = 0
    int nRes = 0
    for b = 1 to 11
        nRes += array.get(S.cnt, lfwIdx(d, b, 0))
        for o = 0 to 4
            nAll += o == 3 ? (b == liveBin ? 1 : 0) : array.get(S.cnt, lfwIdx(d, b, o))
    for b = 1 to 11
        int row = b + 1
        string nm = b <= 9 ? "[" + str.tostring(b * 10) + "," + str.tostring(b * 10 + 10) + ")" : b == 10 ? "100%（全戻し）" : "100% 超（起点突破）"
        f_cell(tb, 0, row, nm, bd)
        int rowTot = 0
        for o = 0 to 4
            int n = o == 3 ? (b == liveBin ? 1 : 0) : array.get(S.cnt, lfwIdx(d, b, o))
            rowTot += n
            array.set(tot, o, array.get(tot, o) + n)
            f_cell(tb, o + 1, row, str.tostring(n), bd)
        int rr = array.get(S.cnt, lfwIdx(d, b, 0))
        f_cell(tb, 6, row, str.tostring(rowTot), bd)
        f_cell(tb, 7, row, f_pct(rowTot, nAll), bd)
        f_cell(tb, 8, row, f_pct(rr, rowTot), bd)
        f_cell(tb, 9, row, f_pct(rr, nRes), bd)
    int ended = array.get(tot, 0) + array.get(tot, 1) + array.get(tot, 2) + array.get(tot, 4)
    f_cell(tb, 0, 13, "計", hd)
    for o = 0 to 4
        f_cell(tb, o + 1, 13, str.tostring(array.get(tot, o)) + "（" + f_pct(array.get(tot, o), nAll) + "）", hd)
    f_cell(tb, 6, 13, str.tostring(nAll), hd)
    f_cell(tb, 7, 13, nAll > 0 ? "100%" : "—", hd)
    f_cell(tb, 8, 13, f_pct(array.get(tot, 0), nAll), hd)
    f_cell(tb, 9, 13, "分母 " + str.tostring(nRes), hd)
    f_cell(tb, 0, 0, title + "：全正式観測 " + str.tostring(nAll) + " 件（終了 " + str.tostring(ended) + " ＋ 観測中 " +
         str.tostring(array.get(tot, 3)) + (nAll == ended + array.get(tot, 3) ? " ✔" : " ✘") + "）／ 観測のあった波 " +
         str.tostring(array.get(S.nWaveObs, d == 1 ? 0 : 1)) + " 本 ／ 最初の波の除外 " + str.tostring(S.nExclInit) +
         " 件 ／ 処理 " + str.tostring(S.nBars) + " 本（" + f_tm(S.firstT) + " から。チャートに読み込まれた範囲を毎回再計算）", hd)
    table.merge_cells(tb, 0, 14, 9, 14)
    f_cell(tb, 0, 14, "段は固定分母での最大戻り率。波切替終了は起点突破（100% 超）と主要高安による新しい波の採用（100% 未満もある）。" +
         "観測中は未確定（失敗ではない）。0 件は「—」", bd)
    true

f_cand(LfwCand c) =>
    string s = "—"
    if not na(c)
        s := f_px(c.p) + (c.adopted ? " 採用済" : " " + (na(c.ext) ? "—" : str.tostring(100.0 * math.abs(c.p - c.ext) / c.thr, "#") + "%"))
    s

f_info(table tb, int row, string tag, LfwTf S, bool ok, bool on) =>
    color bd = color.new(color.black, 30)
    LfwWave w = S.w
    string st = not on ? "OFF" : not ok ? "チャート足が対象時間足より長いため計算しない" :
         S.hold ? "保留中（候補 " + str.tostring(array.size(S.hyps)) + "・" + f_tm(S.holdAvail) + " から）" :
         w.dir == 0 ? "波なし（主要高安＋値幅の成立待ち）" : (w.dir == -1 ? "下降波" : "上昇波") + (w.init ? "（最初の波）" : "")
    f_cell(tb, 0, row, tag, bd)
    f_cell(tb, 1, row, st, bd)
    f_cell(tb, 2, row, S.hold or w.dir == 0 ? "—" : f_px(w.O) + "（" + f_tm(w.oT) + "）→ " + f_px(w.E) + "（" + f_tm(w.eT) + "）", bd)
    string cand = "—"
    if not S.hold and w.dir != 0 and not na(w.rx)
        float rr = lfwRatio(w, w.rx)
        cand := f_px(w.rx) + " (" + str.tostring(rr * 100, "#.0") + "%" + (rr >= S.sw ? " 候補" : "") + ")"
    f_cell(tb, 3, row, cand, bd)
    f_cell(tb, 4, row, S.obsOn ? (S.obsInit ? "観測中（除外）" : "観測中 #" + str.tostring(S.obsSeq)) : "—", bd)
    f_cell(tb, 5, row, "高 " + f_cand(S.cHi) + " ／ 安 " + f_cand(S.cLo), bd)
    f_cell(tb, 6, row, f_tm(S.initAvail) + " / ATR " + f_px(S.initAtr), bd)
    f_cell(tb, 7, row, str.tostring(S.nAdopt) + " / " + str.tostring(S.nHold) + " / " + str.tostring(S.nNoRetro) + " / " +
         str.tostring(S.nStartAmb) + " / " + str.tostring(S.nReinit), bd)
    true

// 診断表 : 選んだ時間足で起点または方向が変わった直近 10 件（記録は常に行い、表示だけを切り替える）
f_dir(int d) =>
    d == 1 ? "上昇" : d == -1 ? "下降" : "なし"

// 同方向切替は、判定に使ったその時間足の切替率を表示する（固定の 78.2% は出さない）
f_why(int w, float sw) =>
    w == 1 ? "最初の波（主要高安）" : w == 2 ? "主要高安採用" : w == 3 ? "同方向切替（切替率 " + str.tostring(sw * 100, "#.0") + "%）" :
     w == 4 ? "起点突破（方向反転）" : "—"

f_diag(table tb, LfwTf S, string tag) =>
    color hd = color.new(color.gray, 20)
    color bd = color.new(color.black, 30)
    table.merge_cells(tb, 0, 0, 5, 0)
    f_cell(tb, 0, 0, tag + "：起点・方向の変更（直近 10 件・新しい順。理由は実行された分岐の記録。終点だけの更新は含まない）", hd)
    array<string> hs = array.from("判明した時刻", "理由（経路）", "変更前 方向 / 起点（極値の足）/ 終点", "変更後 方向 / 起点（極値の足）/ 終点",
         "判定に使った値", "保留解除")
    for c = 0 to 5
        f_cell(tb, c, 1, array.get(hs, c), hd)
    int n = array.size(S.diag)
    if n == 0
        f_cell(tb, 0, 2, "記録なし", bd)
    else
        for i = 0 to n - 1
            LfwDiag d = array.get(S.diag, n - 1 - i)
            int row = i + 2
            string val = "—"
            if d.why == 3
                val := "戻り率 " + str.tostring(d.ratio * 100, "#.0") + "%（切替率 " + str.tostring(d.sw * 100, "#.0") + "%）"
            else if d.why == 4
                val := "突破した価格の戻り率 " + str.tostring(d.ratio * 100, "#.0") + "%"
            else if d.why == 1 or d.why == 2
                val := "候補の極値 " + f_tm(d.candT) + " / 固定 ATR " + f_px(d.atr) + " / 必要値幅 " + f_px(d.thr) + " / 実値幅 " + f_px(d.move)
            f_cell(tb, 0, row, f_tm(d.avail), bd)
            f_cell(tb, 1, row, f_why(d.why, d.sw) + (d.multi ? "（同じ波に至る別経路の候補あり。表示は先の候補）" : ""), bd)
            f_cell(tb, 2, row, f_dir(d.bDir) + " / " + f_px(d.bO) + "（" + f_tm(d.bOT) + "）/ " + f_px(d.bE), bd)
            f_cell(tb, 3, row, f_dir(d.aDir) + " / " + f_px(d.aO) + "（" + f_tm(d.aOT) + "）/ " + f_px(d.aE), bd)
            f_cell(tb, 4, row, val, bd)
            f_cell(tb, 5, row, d.viaHold ? "解除（保留開始 " + f_tm(d.holdAvail) + "）" : "—", bd)
    true

var table lfwDiagTb = table.new(position.bottom_left, 6, 12, border_width = 1)
var table lfwStatTb = table.new(position.bottom_right, 10, 15, border_width = 1)
var table lfwInfoTb = table.new(position.top_right, 8, 3, border_width = 1)

if barstate.islast
    f_draw(lfwD, "D", lfwColD, lfwShowD and lfwOkD, lfwLnD, lfwLbD)
    f_draw(lfw4, "4H", lfwCol4, lfwShow4 and lfwOk4, lfwLn4, lfwLb4)
    table.clear(lfwStatTb, 0, 0, 9, 14)
    if lfwStatSel != "非表示"
        bool selD = str.startswith(lfwStatSel, "日足")
        int sd = str.endswith(lfwStatSel, "上昇") ? 1 : -1
        f_stats(lfwStatTb, selD ? lfwD : lfw4, sd, lfwStatSel)
    table.clear(lfwDiagTb, 0, 0, 5, 11)
    if lfwDiagOn
        f_diag(lfwDiagTb, lfwDiagTf == "日足" ? lfwD : lfw4, lfwDiagTf)
    table.clear(lfwInfoTb, 0, 0, 7, 2)
    if lfwShowInfo
        color hd = color.new(color.gray, 20)
        array<string> hs = array.from("時間足", "最新の波（確定済み）", "起点（極値の足）→ 終点（極値の足）", "戻り高安（率）", "観測",
             "主要高安の候補（未採用は描かない。値幅/閾値）", "最初の波（採用時刻 / 候補の ATR）", "採用 / 保留 / 採用前の戻りで観測対象外 / 開始の順序不明 / 再初期化")
        for c = 0 to 7
            f_cell(lfwInfoTb, c, 0, array.get(hs, c), hd)
        f_info(lfwInfoTb, 1, "日足", lfwD, lfwOkD, lfwOnD)
        f_info(lfwInfoTb, 2, "4H", lfw4, lfwOk4, lfwOn4)

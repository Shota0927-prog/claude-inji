        x.freshLane := true
    else if code == 508
        // D08
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 130, 140, true)
        pAddF(x, 3, TF_D, FVG_BULLISH, ROOT_ACTIVE, 160, 170, true)

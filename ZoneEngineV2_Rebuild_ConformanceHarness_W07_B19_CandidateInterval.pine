//@version=6
// ============================================================
// ZoneEngineV2_Rebuild_ConformanceHarness_W07_B19_CandidateInterval.pine
// W07 B19 Lane1 : FVG interval / Fresh interval / Broad (P) + Main E2E conformance. Build 190101.
// P (58 fixtures) is an auxiliary parity of the W07Fvg /10 interval primitives plus one canonical semantic filter:
//   raw  : per query, naive full scan (w07RefIntervalNaiveRaw, inclusive nativeBottom <= high and nativeTop >= low)
//          vs W07Fvg.fvgIntervalOrderBuild + fvgIntervalQuery on every fixture FVG -> exact rootId set;
//   pair : the same canonical filter (pSemRaw) over every FVG (Reference) and over the Side index hits of the
//          query range (Optimized), plus the final BroadContext scan -> exact record multiset;
//   Fresh: (D01 / D08) naive fresh-only scan vs a Fresh index kept by W07Fvg.freshIndexApply.
//   P is NOT the W05 /4 actual Stage A / B pair parity (that is Lane2 AP).
// Main E2E (8 fixtures) : Main /22 public API only (newCfg / validateCfg / newEngine / newFeed / updateConfirmed5m /
//   rootCount / rootAt and read-only exported fields).
// Fixture dispatch uses for loops only (no while in the dispatcher). No request.*, no bar_index / timenow, no random.
// ============================================================
indicator("ZoneEngineV2 W07 B19 Candidate Interval Lane1", overlay = false)

import sekine3310/ZoneEngineV2_W07Fvg_Worker/10 as W07Fvg
import sekine3310/ZoneEngineV2_Rebuild/22 as ZE

// ---- canonical constants (mirrors of Main / W05 enums; mintick 1.0, clusterMaxWidth 20.0, denseRatio 0.50) ----
const int   CAT_MA              = 0
const int   CAT_SWING           = 1
const int   CAT_ACCUM           = 2
const int   CAT_TIME_HL         = 3
const int   CAT_FVG             = 4
const int   CAT_PSYCH           = 5
const int   ROOT_ACTIVE         = 1
const int   ROOT_INVALIDATED    = 2
const int   ROOT_INVERSE_WAIT   = 3
const int   ROOT_INVERSE_ACTIVE = 4
const int   FVG_BULLISH         = 1
const int   FVG_BEARISH         = 2
const int   TF_1H               = 60
const int   TF_4H               = 240
const int   TF_D                = 1440
const int   SIDE_SUPPORT        = 1
const int   SIDE_RESISTANCE     = -1
const int   M_TICK              = 20
const int   D_TICK              = 10
const int   FVG_INTERVAL_BUILD_OK = 0
const float FX_MINTICK          = 1.0
const int   FX_T0               = 1700000000000
const int   FX_H                = 3600000
const int   FX_M5               = 300000

// query kinds / record modes / record stride
const int Q_POINT            = 1
const int Q_FVG              = 2
const int MODE_STANDALONE    = 1
const int MODE_INSIDE        = 2
const int MODE_PROXIMAL      = 3
const int MODE_OVERLAP       = 4
const int MODE_BROAD_CONTEXT = 5
// record : 0 query, 1 side, 2 mode, 3 fvgRootIdA, 4 fvgRootIdB, 5 effBottomTick, 6 effTopTick, 7 high, 8 broadContext, 9 broadLocalized
const int REC = 10

// compare codes
const int CMP_NONE          = 0
const int CMP_FIXTURE_ORDER = 1
const int CMP_BUILD         = 2
const int CMP_QUERY         = 3
const int CMP_RAW_SET       = 4
const int CMP_PAIR_SET      = 5
const int CMP_FRESH_APPLY   = 6
const int CMP_FRESH_SET     = 7
const int CMP_M_CFG         = 8
const int CMP_M_COMMIT      = 9
const int CMP_M_ROOT        = 10
const int CMP_M_BROAD       = 11
const int CMP_M_FRESH       = 12
const int CMP_M_FRESH_INDEX = 13
const int CMP_M_STATE       = 14

// one P fixture : FVG Roots (ascending rootId), point Roots, queries
type PFx
    array<int>  fId
    array<int>  fTf
    array<int>  fDir
    array<int>  fState
    array<int>  fBot
    array<int>  fTop
    array<bool> fFresh
    array<int>  pId
    array<int>  pCat
    array<int>  pTick
    array<bool> pHigh
    array<int>  qKind
    array<int>  qSide
    array<int>  qA
    array<int>  qB
    bool        freshLane
    bool        synthetic

pNew() =>
    PFx.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), false, false)
pAddF(PFx x, int id, int tf, int dir, int st, int bottomTick, int topTick, bool fresh) =>
    array.push(x.fId, id)
    array.push(x.fTf, tf)
    array.push(x.fDir, dir)
    array.push(x.fState, st)
    array.push(x.fBot, bottomTick)
    array.push(x.fTop, topTick)
    array.push(x.fFresh, fresh)
    true
pAddP(PFx x, int id, int cat, int tick, bool isHigh) =>
    array.push(x.pId, id)
    array.push(x.pCat, cat)
    array.push(x.pTick, tick)
    array.push(x.pHigh, isHigh)
    true
pAddQ(PFx x, int kind, int side, int a, int b) =>
    array.push(x.qKind, kind)
    array.push(x.qSide, side)
    array.push(x.qA, a)
    array.push(x.qB, b)
    true

// A fixtures (code 1xx)
pBuildA(PFx x, int code) =>
    if code == 101
        // A01
        pAddP(x, 101, CAT_SWING, 100, false)
        pAddP(x, 102, CAT_TIME_HL, 105, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 102
        // A02
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 103, false)
        pAddP(x, 102, CAT_TIME_HL, 106, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
    else if code == 103
        // A03
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 95, false)
        pAddP(x, 102, CAT_TIME_HL, 115, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
    else if code == 104
        // A04
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 80, false)
        pAddP(x, 102, CAT_TIME_HL, 85, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 105
        // A05
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 120, false)
        pAddP(x, 102, CAT_TIME_HL, 125, false)
        pAddP(x, 103, CAT_SWING, 115, false)
        pAddP(x, 104, CAT_ACCUM, 118, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 2, 3)
    else if code == 106
        // A06
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 105, 118, true)
        pAddF(x, 3, TF_D, FVG_BULLISH, ROOT_ACTIVE, 130, 140, true)
        pAddF(x, 4, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 90, 98, true)
        pAddF(x, 5, TF_4H, FVG_BEARISH, ROOT_ACTIVE, 108, 112, true)
        pAddF(x, 6, TF_D, FVG_BEARISH, ROOT_ACTIVE, 150, 160, true)
        pAddP(x, 101, CAT_SWING, 104, false)
        pAddP(x, 102, CAT_TIME_HL, 107, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_POINT, SIDE_RESISTANCE, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 2, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 3, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 4, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 5, -1)
    else if code == 107
        // A07
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 102, false)
        pAddP(x, 102, CAT_TIME_HL, 104, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
    else if code == 108
        // A08
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 118, true)
        pAddF(x, 2, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 104, 110, true)
        pAddP(x, 101, CAT_SWING, 106, false)
        pAddP(x, 102, CAT_TIME_HL, 108, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
    else if code == 109
        // A09
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 106, 115, true)
        pAddP(x, 101, CAT_SWING, 105, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 0)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
    else if code == 110
        // A10
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 150, 160, true)
        pAddF(x, 2, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 3, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 125, 135, true)
        pAddF(x, 4, TF_D, FVG_BULLISH, ROOT_ACTIVE, 95, 105, true)
        pAddP(x, 101, CAT_SWING, 102, false)
        pAddP(x, 102, CAT_TIME_HL, 104, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 2, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 3, -1)
    true
// H fixtures (code 2xx)

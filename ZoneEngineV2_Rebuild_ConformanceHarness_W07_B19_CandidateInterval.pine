        pAddF(x, 5, TF_4H, FVG_BEARISH, ROOT_ACTIVE, 145, 155, false)
        pAddF(x, 6, TF_D, FVG_BEARISH, ROOT_ACTIVE, 175, 185, true)
        pAddP(x, 101, CAT_SWING, 108, false)
        pAddP(x, 102, CAT_TIME_HL, 132, false)
        pAddP(x, 103, CAT_SWING, 150, false)
        pAddP(x, 104, CAT_ACCUM, 165, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
        pAddQ(x, Q_POINT, SIDE_RESISTANCE, 0, 1)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 2, 3)
        x.freshLane := true
    true

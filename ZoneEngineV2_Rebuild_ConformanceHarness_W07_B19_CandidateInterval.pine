        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 1, -1)
        pAddQ(x, Q_POINT, SIDE_RESISTANCE, 0, 1)
    else if code == 403
        // C03
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_INVERSE_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 105, 115, true)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 0, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 1, -1)
    else if code == 404
        // C04
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_INVALIDATED, 100, 110, true)
        pAddF(x, 2, TF_1H, FVG_BULLISH, ROOT_INVERSE_WAIT, 102, 108, true)
        pAddF(x, 3, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 104, 112, true)
        pAddP(x, 101, CAT_SWING, 105, false)
        pAddP(x, 102, CAT_TIME_HL, 106, false)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 2, -1)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 405
        // C05
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 120, 130, true)
        pAddF(x, 3, TF_D, FVG_BULLISH, ROOT_ACTIVE, 140, 150, true)
        pAddF(x, 4, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 5, TF_4H, FVG_BEARISH, ROOT_ACTIVE, 120, 130, true)
        pAddF(x, 6, TF_D, FVG_BEARISH, ROOT_ACTIVE, 140, 150, true)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 2, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 3, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 4, -1)
        pAddQ(x, Q_FVG, SIDE_RESISTANCE, 5, -1)
    else if code == 406
        // C06
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 105, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 0)
    true

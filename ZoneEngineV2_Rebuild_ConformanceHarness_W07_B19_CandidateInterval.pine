        pAddQ(x, Q_POINT, SIDE_SUPPORT, 2, 2)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        x.synthetic := true
    else if code == 206
        // H06
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 108, false)
        pAddP(x, 102, CAT_TIME_HL, 110, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 207
        // H07
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 111, false)
        pAddP(x, 102, CAT_TIME_HL, 113, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 208
        // H08
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 115, false)
        pAddP(x, 102, CAT_TIME_HL, 120, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 209
        // H09
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 116, false)
        pAddP(x, 102, CAT_TIME_HL, 121, false)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 210

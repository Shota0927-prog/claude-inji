// C fixtures (code 4xx)
pBuildC(PFx x, int code) =>
    if code == 401
        // C01
        pAddF(x, 1, TF_1H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 105, 115, true)
        pAddP(x, 101, CAT_SWING, 106, false)
        pAddP(x, 102, CAT_TIME_HL, 108, false)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 0, -1)
        pAddQ(x, Q_FVG, SIDE_SUPPORT, 1, -1)
        pAddQ(x, Q_POINT, SIDE_SUPPORT, 0, 1)
    else if code == 402
        // C02
        pAddF(x, 1, TF_4H, FVG_BULLISH, ROOT_ACTIVE, 100, 110, true)
        pAddF(x, 2, TF_4H, FVG_BEARISH, ROOT_ACTIVE, 105, 115, true)
        pAddP(x, 101, CAT_SWING, 106, false)
        pAddP(x, 102, CAT_TIME_HL, 108, false)

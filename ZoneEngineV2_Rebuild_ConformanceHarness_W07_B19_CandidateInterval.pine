        pAddF(x, 1, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 100, false)
        pAddP(x, 102, CAT_TIME_HL, 103, false)
        pAddQ(x, Q_POINT, SIDE_RESISTANCE, 0, 1)
    else if code == 214
        // H14
        pAddF(x, 1, TF_1H, FVG_BEARISH, ROOT_ACTIVE, 100, 110, true)
        pAddP(x, 101, CAT_SWING, 97, false)
        pAddP(x, 102, CAT_TIME_HL, 99, false)
        pAddQ(x, Q_POINT, SIDE_RESISTANCE, 0, 1)

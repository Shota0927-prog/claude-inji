//@version=6
// ============================================================
// ZoneEngineV2_W07Fvg_Worker - W07 FVG state / index / localization worker
//
// B01 : shared FVG NativeRange interval helpers, used later by the Fresh path and the
// Candidate path alike. A Root is the inclusive tick interval [nativeBottomTick,
// nativeTopTick]; a query is the inclusive tick interval [queryLowTick, queryHighTick];
// they intersect exactly when rootBottomTick <= queryHighTick and rootTopTick >=
// queryLowTick (equality intersects, int ticks only, no epsilon, no float compare).
// Pure price-intersection helpers: no category / Fresh / state / direction / Broad / TF /
// Inverse / Side filter (callers filter). Inputs are never mutated; only the output
// arrays named by each function are rebuilt, and only after the whole input validated.
// No import, no type, no persistent storage, no request, no drawing.
// ============================================================
library("ZoneEngineV2_W07Fvg_Worker", overlay = false)

// ---- constants ----
const int ID_NONE      = 0
const int SLOT_INVALID = -1
// W07 FVG Inverse progress (int per Root; defined in B01, used from B08)
const int FVG_INV_PROGRESS_NONE            = 0
const int FVG_INV_PROGRESS_WAIT_MOVED_AWAY = 1
const int FVG_INV_PROGRESS_MOVED_AWAY      = 2
const int FVG_INV_PROGRESS_RETOUCHED       = 3
const int FVG_INV_PROGRESS_ACTIVE          = 4
// fvgIntervalOrderBuild internal status (B01 only; not the W06 Candidate status enum)
const int FVG_INTERVAL_BUILD_OK            = 0
const int FVG_INTERVAL_BUILD_INVALID_INPUT = 1
// exact copies of the Main declarations used by the B04 Fresh facts
const int CAT_FVG             = 4
const int ROOT_ACTIVE         = 1
const int ROOT_INVALIDATED    = 2
const int ROOT_INVERSE_WAIT   = 3
const int ROOT_INVERSE_ACTIVE = 4
const int FVG_BULLISH = 1
const int FVG_BEARISH = 2
const int TF_1H = 60
const int TF_4H = 240
const int TF_D  = 1440
const int JGROUP_E1 = 1
const int JGROUP_E2 = 2
const int JGROUP_E3 = 3
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_FVG_FRESH_END  = 6

// First index i in [0, array.size(order)) whose key tick (NativeBottomTick when keyBottom,
// else NativeTopTick) of slot order[i] is > target (strictGreater) or >= target (not
// strictGreater); array.size(order) when none. order must already be ascending by that
// key (index invariant kept by the build / update path, not re-audited here). Binary search:
// only the O(log n) probed slots are read, and each probed slot is checked (slot in range,
// rootId > 0, both ticks not na, bottom <= top); a bad probed slot returns -1.
fvgIntervalLowerBoundRaw(array<int> order, array<int> rootIds, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, bool keyBottom, int target, bool strictGreater) =>
    int  lo = 0
    int  hi = array.size(order)
    bool ok = true
    while ok and lo < hi
        int mid  = int(math.floor((lo + hi) / 2))
        int slot = array.get(order, mid)
        ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootNativeBottomTicks) and slot < array.size(rootNativeTopTicks)
        if ok
            int bTick = array.get(rootNativeBottomTicks, slot)
            int tTick = array.get(rootNativeTopTicks,    slot)
            ok := array.get(rootIds, slot) > ID_NONE and not na(bTick) and not na(tTick) and bTick <= tTick
            if ok
                int  tick   = keyBottom ? bTick : tTick
                bool passed = strictGreater ? tick > target : tick >= target
                if passed
                    hi := mid
                else
                    lo := mid + 1
    ok ? lo : -1

// W07 B01: build the NativeBottomTick order and the NativeTopTick order of the first len
// slots of slots. Each order is ascending by its tick, equal tick by rootId ascending (a
// physical order of this helper only, never a Candidate / Zone tie-break); equal tick and
// equal rootId keep the input order (stable merge). Every one of the len slots is in each
// order exactly once (no cap, no cut-off). Invalid input (len < 0, len > size, slot out of
// range, rootId <= 0, na tick, bottom > top, duplicate slot) -> both outputs emptied and
// FVG_INTERVAL_BUILD_INVALID_INPUT; otherwise both outputs rebuilt to exactly len slots
// and FVG_INTERVAL_BUILD_OK.
export fvgIntervalOrderBuild(array<int> slots, int len, array<int> rootIds, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> outBottomOrder, array<int> outTopOrder) =>
    bool ok = len >= 0 and len <= array.size(slots)
    int  n  = ok ? len : 0
    array<int> work = array.new_int(n, SLOT_INVALID)
    map<int, int> seen = map.new<int, int>()
    int i = 0
    while ok and i < n
        int slot = array.get(slots, i)
        ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootNativeBottomTicks) and slot < array.size(rootNativeTopTicks)
        if ok
            int bTick = array.get(rootNativeBottomTicks, slot)
            int tTick = array.get(rootNativeTopTicks,    slot)
            ok := array.get(rootIds, slot) > ID_NONE and not na(bTick) and not na(tTick) and bTick <= tTick and not map.contains(seen, slot)
        if ok
            map.put(seen, slot, 1)
            array.set(work, i, slot)
        i += 1
    array<int> bottomResult = array.new_int(0)
    array<int> topResult    = array.new_int(0)
    if ok
        int m = 0
        while m < 2
            array<int> ticks = m == 0 ? rootNativeBottomTicks : rootNativeTopTicks
            array<int> src   = array.copy(work)
            array<int> tmp   = array.new_int(n, SLOT_INVALID)
            int width = 1
            while width < n
                int left = 0
                while left < n
                    int mid   = math.min(left + width, n)
                    int right = math.min(left + 2 * width, n)
                    int a = left
                    int b = mid
                    int k = left
                    while k < right
                        bool takeA = false
                        if a < mid and b < right
                            int sa = array.get(src, a)
                            int sb = array.get(src, b)
                            int ta = array.get(ticks, sa)
                            int tb = array.get(ticks, sb)
                            takeA := ta < tb or (ta == tb and array.get(rootIds, sa) <= array.get(rootIds, sb))
                        else
                            takeA := a < mid
                        if takeA
                            array.set(tmp, k, array.get(src, a))
                            a += 1
                        else
                            array.set(tmp, k, array.get(src, b))
                            b += 1
                        k += 1
                    left += 2 * width
                array<int> swap = src
                src := tmp
                tmp := swap
                width := width * 2
            if m == 0
                bottomResult := src
            else
                topResult := src
            m += 1
    // outputs are written only after every input was read and validated
    while array.size(outBottomOrder) > 0
        array.pop(outBottomOrder)
    while array.size(outTopOrder) > 0
        array.pop(outTopOrder)
    if ok
        int j = 0
        while j < n
            array.push(outBottomOrder, array.get(bottomResult, j))
            array.push(outTopOrder,    array.get(topResult,    j))
            j += 1
    ok ? FVG_INTERVAL_BUILD_OK : FVG_INTERVAL_BUILD_INVALID_INPUT

// W07 B01: every slot of the order pair whose NativeRange intersects [queryLowTick,
// queryHighTick] (rootBottomTick <= queryHighTick and rootTopTick >= queryLowTick), in
// outSlots by rootId ascending (equal rootId: the order of the scanned side; stable
// bottom-up merge, no array.sort). Hot-path search on an index that is already valid: the
// two orders are built and kept valid by fvgIntervalOrderBuild and the later insert /
// detach / rebuild paths, and are not re-audited per query. O(1) pre-check: both query
// ticks not na, queryLowTick <= queryHighTick, equal order sizes. Bottom prefix
// (bottomTick <= queryHighTick) and top suffix (topTick >= queryLowTick) come from binary
// search; only the smaller one is scanned (equal sizes: the bottom prefix) and checked
// against the other bound, so the result set is the same either way. Every slot actually
// read (binary-search probes and scanned candidates) is checked (slot in range, rootId > 0,
// both ticks not na, bottom <= top). Any failure -> outSlots cleared, -1 (no partial
// result). Otherwise the match count (>= 0). Only outSlots is written.
// Cost on a valid index: O(log n + min(prefix, suffix) + K log K).
// Callers never pass outSlots aliased to bottomOrder / topOrder (not detectable in Pine).
export fvgIntervalQuery(array<int> bottomOrder, array<int> topOrder, array<int> rootIds, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, int queryLowTick, int queryHighTick, array<int> outSlots) =>
    int  n  = array.size(bottomOrder)
    bool ok = not na(queryLowTick) and not na(queryHighTick) and queryLowTick <= queryHighTick and array.size(topOrder) == n
    array<int> matches = array.new_int(0)
    if ok
        int prefixCount = fvgIntervalLowerBoundRaw(bottomOrder, rootIds, rootNativeBottomTicks, rootNativeTopTicks, true,  queryHighTick, true)
        int suffixStart = fvgIntervalLowerBoundRaw(topOrder,    rootIds, rootNativeBottomTicks, rootNativeTopTicks, false, queryLowTick,  false)
        ok := prefixCount >= 0 and suffixStart >= 0
        if ok
            bool scanBottom = prefixCount <= n - suffixStart
            int  scanStart = scanBottom ? 0 : suffixStart
            int  scanEnd   = scanBottom ? prefixCount : n
            int  i = scanStart
            while ok and i < scanEnd
                int slot = array.get(scanBottom ? bottomOrder : topOrder, i)
                ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootNativeBottomTicks) and slot < array.size(rootNativeTopTicks)
                if ok
                    int bTick = array.get(rootNativeBottomTicks, slot)
                    int tTick = array.get(rootNativeTopTicks,    slot)
                    ok := array.get(rootIds, slot) > ID_NONE and not na(bTick) and not na(tTick) and bTick <= tTick
                    if ok
                        bool hit = scanBottom ? tTick >= queryLowTick : bTick <= queryHighTick
                        if hit
                            array.push(matches, slot)
                i += 1
    array.clear(outSlots)
    if ok
        // stable bottom-up merge by rootId ascending: O(K log K)
        int k = array.size(matches)
        array<int> src = matches
        array<int> tmp = array.new_int(k, SLOT_INVALID)
        int width = 1
        while width < k
            int left = 0
            while left < k
                int mid   = math.min(left + width, k)
                int right = math.min(left + 2 * width, k)
                int a = left
                int b = mid
                int w = left
                while w < right
                    bool takeA = false
                    if a < mid and b < right
                        takeA := array.get(rootIds, array.get(src, a)) <= array.get(rootIds, array.get(src, b))
                    else
                        takeA := a < mid
                    if takeA
                        array.set(tmp, w, array.get(src, a))
                        a += 1
                    else
                        array.set(tmp, w, array.get(src, b))
                        b += 1
                    w += 1
                left += 2 * width
            array<int> swap = src
            src := tmp
            tmp := swap
            width := width * 2
        int j = 0
        while j < k
            array.push(outSlots, array.get(src, j))
            j += 1
    ok ? array.size(outSlots) : -1

// ---- W07 B03 : Fresh FVG NativeRange interval index maintenance ----
// The Fresh index is two sorted slot orders over the Fresh FVG Roots, the same order
// contract as fvgIntervalOrderBuild: bottom order ascending by (nativeBottomTick, rootId),
// top order ascending by (nativeTopTick, rootId), each with a Root-slot -> position reverse
// array (SLOT_INVALID when not in the order). Membership follows the caller's Fresh fact
// only: no category / state / direction / TF / Broad / Side filter. Caller contract (not
// detectable in Pine): the bottom order, top order, bottom positions, top positions and
// rootFvgW07ExpectedRootIds are five distinct arrays, never aliased to one another.

// Insert rootSlot into one sorted order (keyBottom: bottom order by (nativeBottomTick,
// rootId), else top order by (nativeTopTick, rootId)). The position is the upper bound of
// (tick, rootId) found by binary search; the tail is shifted right by one with array.set
// after an array.push (no array.insert / unshift) and every shifted slot's position is
// moved +1. Everything that can fail (rootSlot / rootId / ticks, positions[rootSlot] ==
// SLOT_INVALID, each probed slot, each shifted slot with positions[s] == its index) is
// checked before the first write; commit = false checks only and writes nothing.
// Returns true when the insert is (or, dry run, would be) done; false leaves every array
// unchanged.
freshIndexInsertRaw(array<int> order, array<int> positions, array<int> rootIds, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, bool keyBottom, int rootSlot, int rootId, bool commit) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks) and rootSlot < array.size(positions) and rootId > ID_NONE
    int  key = int(na)
    if ok
        int bTick = array.get(rootNativeBottomTicks, rootSlot)
        int tTick = array.get(rootNativeTopTicks,    rootSlot)
        ok := array.get(rootIds, rootSlot) == rootId and not na(bTick) and not na(tTick) and bTick <= tTick and array.get(positions, rootSlot) == SLOT_INVALID
        key := keyBottom ? bTick : tTick
    int n  = array.size(order)
    int lo = 0
    int hi = n
    while ok and lo < hi
        int mid = int(math.floor((lo + hi) / 2))
        int s   = array.get(order, mid)
        ok := s >= 0 and s < array.size(rootIds) and s < array.size(rootNativeBottomTicks) and s < array.size(rootNativeTopTicks) and s != rootSlot
        if ok
            int sTick = keyBottom ? array.get(rootNativeBottomTicks, s) : array.get(rootNativeTopTicks, s)
            int sId   = array.get(rootIds, s)
            ok := not na(sTick) and sId > ID_NONE
            if ok
                if sTick < key or (sTick == key and sId <= rootId)
                    lo := mid + 1
                else
                    hi := mid
    int insertPos = lo
    int j = insertPos
    while ok and j < n
        int s = array.get(order, j)
        ok := s >= 0 and s < array.size(positions) and s != rootSlot
        if ok
            ok := array.get(positions, s) == j
        j += 1
    if ok and commit
        array.push(order, SLOT_INVALID)
        int k = n
        while k > insertPos
            int moved = array.get(order, k - 1)
            array.set(order, k, moved)
            array.set(positions, moved, k)
            k -= 1
        array.set(order, insertPos, rootSlot)
        array.set(positions, rootSlot, insertPos)
    ok

// Detach rootSlot from one sorted order: positions[rootSlot] must be a valid index whose
// entry is rootSlot, and every later entry s must have positions[s] == its index (all
// checked before the first write; commit = false checks only). The tail is shifted left by
// one with array.set (no array.remove(0) / unshift), each shifted slot's position moves -1,
// then array.pop and positions[rootSlot] := SLOT_INVALID. Returns true when the detach is
// (or, dry run, would be) done; false leaves every array unchanged.
freshIndexDetachRaw(array<int> order, array<int> positions, int rootSlot, bool commit) =>
    int  n   = array.size(order)
    bool ok  = rootSlot >= 0 and rootSlot < array.size(positions)
    int  pos = SLOT_INVALID
    if ok
        pos := array.get(positions, rootSlot)
        ok  := pos != SLOT_INVALID and pos >= 0 and pos < n
        if ok
            ok := array.get(order, pos) == rootSlot
    int j = pos + 1
    while ok and j < n
        int s = array.get(order, j)
        ok := s >= 0 and s < array.size(positions) and s != rootSlot
        if ok
            ok := array.get(positions, s) == j
        j += 1
    if ok and commit
        int k = pos
        while k < n - 1
            int moved = array.get(order, k + 1)
            array.set(order, k, moved)
            array.set(positions, moved, k)
            k += 1
        array.pop(order)
        array.set(positions, rootSlot, SLOT_INVALID)
    ok

// W07 B03: bring the Fresh index membership of one resolved Root slot to shouldBeFresh.
// Checks first: rootSlot in range, expectedRootId > 0 == rootIds[rootSlot], both native
// ticks not na, bottom <= top. Then the position arrays and rootFvgW07ExpectedRootIds are
// extended to rootSlot + 1 (SLOT_INVALID / ID_NONE) before any order write. Identity:
// stored ID_NONE -> expectedRootId is recorded on success; stored == expectedRootId ->
// continue; anything else -> false (slot reuse / stale W07 state, nothing overwritten).
// Membership must be both-in (each position valid and pointing back at rootSlot) or
// both-out (both SLOT_INVALID); a mixed state -> false. Already in the wanted state ->
// true (idempotent). Otherwise both orders are dry-run checked, then both are written;
// an unexpected second-order failure rolls the first order back and returns false, so no
// partial membership is ever left. rootFvgW07ExpectedRootIds is never cleared (it is
// shared with the later Inverse state).
export freshIndexApply(int rootSlot, int expectedRootId, bool shouldBeFresh, array<int> rootIds, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootFvgW07ExpectedRootIds, array<int> freshFvgNativeBottomOrderRootSlots, array<int> freshFvgNativeTopOrderRootSlots, array<int> rootFreshFvgNativeBottomOrderPositions, array<int> rootFreshFvgNativeTopOrderPositions) =>
    bool ok = not na(rootSlot) and rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks) and not na(expectedRootId) and expectedRootId > ID_NONE
    if ok
        int bTick = array.get(rootNativeBottomTicks, rootSlot)
        int tTick = array.get(rootNativeTopTicks,    rootSlot)
        ok := array.get(rootIds, rootSlot) == expectedRootId and not na(bTick) and not na(tTick) and bTick <= tTick
    if ok
        while array.size(rootFvgW07ExpectedRootIds) <= rootSlot
            array.push(rootFvgW07ExpectedRootIds, ID_NONE)
        while array.size(rootFreshFvgNativeBottomOrderPositions) <= rootSlot
            array.push(rootFreshFvgNativeBottomOrderPositions, SLOT_INVALID)
        while array.size(rootFreshFvgNativeTopOrderPositions) <= rootSlot
            array.push(rootFreshFvgNativeTopOrderPositions, SLOT_INVALID)
    int storedExpected = ok ? array.get(rootFvgW07ExpectedRootIds, rootSlot) : ID_NONE
    if ok
        ok := storedExpected == ID_NONE or storedExpected == expectedRootId
    bool isIn  = false
    if ok
        int bPos = array.get(rootFreshFvgNativeBottomOrderPositions, rootSlot)
        int tPos = array.get(rootFreshFvgNativeTopOrderPositions,    rootSlot)
        bool bothOut = bPos == SLOT_INVALID and tPos == SLOT_INVALID
        bool bothIn  = bPos >= 0 and tPos >= 0 and bPos < array.size(freshFvgNativeBottomOrderRootSlots) and tPos < array.size(freshFvgNativeTopOrderRootSlots)
        if bothIn
            bothIn := array.get(freshFvgNativeBottomOrderRootSlots, bPos) == rootSlot and array.get(freshFvgNativeTopOrderRootSlots, tPos) == rootSlot
        ok   := bothOut or bothIn
        isIn := bothIn
    if ok and shouldBeFresh != isIn
        if shouldBeFresh
            ok := freshIndexInsertRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootIds, rootNativeBottomTicks, rootNativeTopTicks, true,  rootSlot, expectedRootId, false) and freshIndexInsertRaw(freshFvgNativeTopOrderRootSlots, rootFreshFvgNativeTopOrderPositions, rootIds, rootNativeBottomTicks, rootNativeTopTicks, false, rootSlot, expectedRootId, false)
            if ok
                ok := freshIndexInsertRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootIds, rootNativeBottomTicks, rootNativeTopTicks, true, rootSlot, expectedRootId, true)
                if ok
                    ok := freshIndexInsertRaw(freshFvgNativeTopOrderRootSlots, rootFreshFvgNativeTopOrderPositions, rootIds, rootNativeBottomTicks, rootNativeTopTicks, false, rootSlot, expectedRootId, true)
                    if not ok
                        // unexpected: undo the bottom insert, no partial membership
                        freshIndexDetachRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootSlot, true)
        else
            ok := freshIndexDetachRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootSlot, false) and freshIndexDetachRaw(freshFvgNativeTopOrderRootSlots, rootFreshFvgNativeTopOrderPositions, rootSlot, false)
            if ok
                ok := freshIndexDetachRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootSlot, true)
                if ok
                    ok := freshIndexDetachRaw(freshFvgNativeTopOrderRootSlots, rootFreshFvgNativeTopOrderPositions, rootSlot, true)
                    if not ok
                        // unexpected: put the bottom entry back, no partial membership
                        freshIndexInsertRaw(freshFvgNativeBottomOrderRootSlots, rootFreshFvgNativeBottomOrderPositions, rootIds, rootNativeBottomTicks, rootNativeTopTicks, true, rootSlot, expectedRootId, true)
    if ok and storedExpected == ID_NONE
        array.set(rootFvgW07ExpectedRootIds, rootSlot, expectedRootId)
    ok

// ---- W07 B04 : indexed FVG Fresh facts (legacy W03 Path A / Path B journal parity) ----

// Reorder the first matchCount slots of matchSlots into the live W03 Path A emission order:
// ascending (TF rank, rootFvgFreshSetPositions[slot]) with TF rank 60 -> 0, 240 -> 1,
// 1440 -> 2 (the 1H set, then 4H, then D, each in array index order). Only these K slots are
// read (never a whole Fresh set). Every slot is checked first (slot in range of both arrays,
// TF 60 / 240 / 1440, position >= 0); any failure -> -1 and matchSlots untouched. Stable
// bottom-up merge (no array.sort), O(K log K); the result is written back only on success.
// Returns matchCount on success.
freshMatchLegacyOrderRaw(array<int> matchSlots, int matchCount, array<int> rootTfCodes, array<int> rootFvgFreshSetPositions) =>
    bool ok = not na(matchCount) and matchCount >= 0 and matchCount <= array.size(matchSlots)
    int  k  = ok ? matchCount : 0
    array<int> src = array.new_int(k, SLOT_INVALID)
    int i = 0
    while ok and i < k
        int slot = array.get(matchSlots, i)
        ok := slot >= 0 and slot < array.size(rootTfCodes) and slot < array.size(rootFvgFreshSetPositions)
        if ok
            int tf = array.get(rootTfCodes, slot)
            ok := (tf == TF_1H or tf == TF_4H or tf == TF_D) and array.get(rootFvgFreshSetPositions, slot) >= 0
        if ok
            array.set(src, i, slot)
        i += 1
    if ok and k > 1
        array<int> tmp = array.new_int(k, SLOT_INVALID)
        int width = 1
        while width < k
            int left = 0
            while left < k
                int mid   = math.min(left + width, k)
                int right = math.min(left + 2 * width, k)
                int a = left
                int b = mid
                int w = left
                while w < right
                    bool takeA = false
                    if a < mid and b < right
                        int sa = array.get(src, a)
                        int sb = array.get(src, b)
                        int tfA = array.get(rootTfCodes, sa)
                        int tfB = array.get(rootTfCodes, sb)
                        int rankA = tfA == TF_1H ? 0 : tfA == TF_4H ? 1 : 2
                        int rankB = tfB == TF_1H ? 0 : tfB == TF_4H ? 1 : 2
                        takeA := rankA < rankB or (rankA == rankB and array.get(rootFvgFreshSetPositions, sa) <= array.get(rootFvgFreshSetPositions, sb))
                    else
                        takeA := a < mid
                    if takeA
                        array.set(tmp, w, array.get(src, a))
                        a += 1
                    else
                        array.set(tmp, w, array.get(src, b))
                        b += 1
                    w += 1
                left += 2 * width
            array<int> swap = src
            src := tmp
            tmp := swap
            width := width * 2
    if ok
        int j = 0
        while j < k
            array.set(matchSlots, j, array.get(src, j))
            j += 1
    ok ? k : -1

// W07 B04: the live W03 Fresh Path A and Path B (w03StageEFvgRaw Fresh section of
// ZoneEngineV2_W03ETimeFvg_Worker /1), appending the same JOP_FVG_FRESH_END / JGROUP_E3 rows
// in the same order with the same payload. Gate: cfgUseFvg, no incoming violation, base
// close time / high / low not na, mintick > 0; closed gate -> no row, count and violation
// returned unchanged.
// Path A (committed Fresh Roots): fvgIntervalQuery on the Fresh index with the base bar's
// [low tick, high tick] (inclusive) gives the K candidates only; they are put in the legacy
// order (1H set, 4H set, D set, each by set position) by freshMatchLegacyOrderRaw; each is
// checked against its TF fresh set position and the live Path A Root checks (live, rootId,
// CAT_FVG, TF, Fresh flag, Bullish / Bearish, native ticks, confirmed / origin time, origin
// key); its virtual state is the committed state, ROOT_INVALIDATED when this bar's journal
// holds its JOP_FVG_INVALIDATE / JGROUP_E1 row (more than one -> violation), and it is
// skipped when this bar's journal already holds its JOP_FVG_FRESH_END. Accepted virtual
// states: ACTIVE, INVALIDATED (live) and INVERSE_WAIT, INVERSE_ACTIVE (strict extension).
// A row is emitted when baseCloseTime > rootConfirmedTime (strict) and the native range
// touches the bar (inclusive; the query already guarantees it and it is re-checked). All K
// are checked before the first Path A row, so a failure appends no Path A row.
// O(1) guard: the Fresh index size must equal the sum of the three Fresh set sizes.
// Path B (Roots created on this bar): unchanged live journal scan, scanEnd = journal count
// after Path A, JOP_NEW_ROOT / JGROUP_E2 / CAT_FVG rows in row order, target SLOT_INVALID,
// state ROOT_ACTIVE; its rows are appended after the scan (a Path B violation appends none).
// Only the journal arrays are written (rootFvgFreshFlags / rootStates / the index are not).
// Returns [journalCountOut, violationOut].
export freshFacts(bool cfgUseFvg, float feedBaseHigh, float feedBaseLow, int feedBaseCloseTime, float feedMintick, array<int> freshFvgNativeBottomOrderRootSlots, array<int> freshFvgNativeTopOrderRootSlots, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginKeys, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootConfirmedTimes, array<float> rootNativeBottoms, array<float> rootNativeTops, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootStates, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<int> rootFvgFreshSetPositions, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, int journalCountIn, bool journalInvariantViolationIn) =>
    int  journalCountNow = journalCountIn
    bool violation       = journalInvariantViolationIn
    bool mintickOk = not na(feedMintick) and feedMintick > 0
    bool freshGate = not na(feedBaseCloseTime) and not na(feedBaseHigh) and not na(feedBaseLow) and mintickOk
    if cfgUseFvg and not journalInvariantViolationIn and freshGate
        int baseLowTick  = int(math.round(feedBaseLow  / feedMintick))
        int baseHighTick = int(math.round(feedBaseHigh / feedMintick))
        // pending rows of the current phase: source 0 = committed Root slot (Path A), 1 = journal row (Path B)
        array<int> specSources = array.new_int(0)
        array<int> specIndexes = array.new_int(0)
        array<int> specStates  = array.new_int(0)
        int phase = 0
        while not violation and phase < 2
            array.clear(specSources)
            array.clear(specIndexes)
            array.clear(specStates)
            if phase == 0
                bool ok = array.size(freshFvgNativeBottomOrderRootSlots) == array.size(freshFvg1hRootSlots) + array.size(freshFvg4hRootSlots) + array.size(freshFvgDRootSlots)
                array<int> matches = array.new_int(0)
                int k = -1
                if ok
                    k := fvgIntervalQuery(freshFvgNativeBottomOrderRootSlots, freshFvgNativeTopOrderRootSlots, rootIds, rootNativeBottomTicks, rootNativeTopTicks, baseLowTick, baseHighTick, matches)
                ok := k >= 0
                if ok
                    ok := freshMatchLegacyOrderRaw(matches, k, rootTfCodes, rootFvgFreshSetPositions) == k
                int i = 0
                while ok and i < k
                    int  slot = array.get(matches, i)
                    bool valid = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootCategories) and slot < array.size(rootSubtypes) and slot < array.size(rootTfCodes) and slot < array.size(rootFvgFreshFlags) and slot < array.size(rootDirections) and slot < array.size(rootNativeBottoms) and slot < array.size(rootNativeTops) and slot < array.size(rootNativeBottomTicks) and slot < array.size(rootNativeTopTicks) and slot < array.size(rootConfirmedTimes) and slot < array.size(rootOriginTimes) and slot < array.size(rootOriginEndTimes) and slot < array.size(rootOriginKeys) and slot < array.size(rootStates) and slot < array.size(rootIsBroadFvgFlags) and slot < array.size(rootFvgFreshSetPositions)
                    int  rootId = ID_NONE
                    if valid
                        int tf = array.get(rootTfCodes, slot)
                        array<int> freshSet = tf == TF_1H ? freshFvg1hRootSlots : tf == TF_4H ? freshFvg4hRootSlots : freshFvgDRootSlots
                        int setPos = array.get(rootFvgFreshSetPositions, slot)
                        valid := (tf == TF_1H or tf == TF_4H or tf == TF_D) and setPos >= 0 and setPos < array.size(freshSet)
                        if valid
                            valid := array.get(freshSet, setPos) == slot
                    if valid
                        rootId := array.get(rootIds, slot)
                        int dir   = array.get(rootDirections, slot)
                        int bTick = array.get(rootNativeBottomTicks, slot)
                        int tTick = array.get(rootNativeTopTicks,    slot)
                        valid := array.get(rootSlotLiveFlags, slot) and rootId != ID_NONE and array.get(rootCategories, slot) == CAT_FVG and array.get(rootFvgFreshFlags, slot) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and not na(bTick) and not na(tTick) and bTick <= tTick and not na(array.get(rootConfirmedTimes, slot)) and not na(array.get(rootOriginTimes, slot)) and array.get(rootOriginKeys, slot) != ID_NONE
                    if not valid
                        ok := false
                    else
                        int  virtualState = array.get(rootStates, slot)
                        int  invalidates  = 0
                        bool freshEnded   = false
                        int  row = 0
                        while row < journalCountNow
                            if array.get(journalTargetRootSlots, row) == slot and array.get(journalExpectedRootIds, row) == rootId
                                int op = array.get(journalOps, row)
                                if op == JOP_FVG_INVALIDATE and array.get(journalGroups, row) == JGROUP_E1
                                    invalidates += 1
                                    virtualState := ROOT_INVALIDATED
                                else if op == JOP_FVG_FRESH_END
                                    freshEnded := true
                            row += 1
                        if invalidates > 1 or not (virtualState == ROOT_ACTIVE or virtualState == ROOT_INVALIDATED or virtualState == ROOT_INVERSE_WAIT or virtualState == ROOT_INVERSE_ACTIVE)
                            ok := false
                        else if not freshEnded
                            bool touched = baseLowTick <= array.get(rootNativeTopTicks, slot) and baseHighTick >= array.get(rootNativeBottomTicks, slot)
                            if feedBaseCloseTime > array.get(rootConfirmedTimes, slot) and touched
                                array.push(specSources, 0)
                                array.push(specIndexes, slot)
                                array.push(specStates,  virtualState)
                    i += 1
                if not ok
                    violation := true
            else
                int scanEnd = journalCountNow
                int n = 0
                while not violation and n < scanEnd
                    if array.get(journalOps, n) == JOP_NEW_ROOT and array.get(journalGroups, n) == JGROUP_E2 and array.get(journalCategories, n) == CAT_FVG
                        int   nTf        = array.get(journalTfCodes,        n)
                        int   nDir       = array.get(journalDirections,     n)
                        int   nOrigin    = array.get(journalOriginTimes,    n)
                        int   nConfirmed = array.get(journalConfirmedTimes, n)
                        float nBottom    = array.get(journalNativeBottoms,  n)
                        float nTop       = array.get(journalNativeTops,     n)
                        bool  valid = (nTf == TF_1H or nTf == TF_4H or nTf == TF_D) and (nDir == FVG_BULLISH or nDir == FVG_BEARISH) and not na(nOrigin) and not na(nConfirmed) and not na(nBottom) and not na(nTop) and array.get(journalOriginKeys, n) != ID_NONE and array.get(journalFvgFreshFlags, n) and array.get(journalTargetRootSlots, n) == SLOT_INVALID and array.get(journalExpectedRootIds, n) == ID_NONE
                        int  sameNew    = 0
                        bool pathBFound = false
                        int  j = 0
                        while valid and j < journalCountNow
                            int jOp = array.get(journalOps, j)
                            if array.get(journalCategories, j) == CAT_FVG and array.get(journalTfCodes, j) == nTf and array.get(journalDirections, j) == nDir and array.get(journalOriginTimes, j) == nOrigin
                                if jOp == JOP_NEW_ROOT
                                    sameNew += 1
                                else if jOp == JOP_FVG_FRESH_END and array.get(journalTargetRootSlots, j) == SLOT_INVALID and array.get(journalExpectedRootIds, j) == ID_NONE
                                    pathBFound := true
                            j += 1
                        // Path B rows of this phase are still pending (the live code had appended them already)
                        int p = 0
                        while valid and p < array.size(specIndexes)
                            int pn = array.get(specIndexes, p)
                            if array.get(journalTfCodes, pn) == nTf and array.get(journalDirections, pn) == nDir and array.get(journalOriginTimes, pn) == nOrigin
                                pathBFound := true
                            p += 1
                        if not valid or sameNew != 1
                            violation := true
                        else if not pathBFound
                            int  nBottomTick = int(math.round(nBottom / feedMintick))
                            int  nTopTick    = int(math.round(nTop    / feedMintick))
                            bool touched     = baseLowTick <= nTopTick and baseHighTick >= nBottomTick
                            if feedBaseCloseTime > nConfirmed and touched
                                array.push(specSources, 1)
                                array.push(specIndexes, n)
                                array.push(specStates,  ROOT_ACTIVE)
                    n += 1
            // append the phase's rows (same payload as the live journalAppendRaw calls)
            int r = 0
            while not violation and r < array.size(specIndexes)
                bool  fromRoot = array.get(specSources, r) == 0
                int   idx      = array.get(specIndexes, r)
                int   st       = array.get(specStates,  r)
                int   target   = fromRoot ? idx : SLOT_INVALID
                int   expected = fromRoot ? array.get(rootIds, idx) : ID_NONE
                int   subtype  = fromRoot ? array.get(rootSubtypes, idx)       : array.get(journalSubtypes, idx)
                int   tfCode   = fromRoot ? array.get(rootTfCodes, idx)        : array.get(journalTfCodes, idx)
                int   oKey     = fromRoot ? array.get(rootOriginKeys, idx)     : array.get(journalOriginKeys, idx)
                int   oTime    = fromRoot ? array.get(rootOriginTimes, idx)    : array.get(journalOriginTimes, idx)
                int   oEnd     = fromRoot ? array.get(rootOriginEndTimes, idx) : array.get(journalOriginEndTimes, idx)
                int   cTime    = fromRoot ? array.get(rootConfirmedTimes, idx) : array.get(journalConfirmedTimes, idx)
                float nb       = fromRoot ? array.get(rootNativeBottoms, idx)  : array.get(journalNativeBottoms, idx)
                float nt       = fromRoot ? array.get(rootNativeTops, idx)     : array.get(journalNativeTops, idx)
                bool  broad    = fromRoot ? array.get(rootIsBroadFvgFlags, idx) : array.get(journalIsBroadFlags, idx)
                int   dir      = fromRoot ? array.get(rootDirections, idx)     : array.get(journalDirections, idx)
                int   row      = journalCountNow
                if row < array.size(journalOps)
                    array.set(journalOps,             row, JOP_FVG_FRESH_END)
                    array.set(journalGroups,          row, JGROUP_E3)
                    array.set(journalTargetRootSlots, row, target)
                    array.set(journalExpectedRootIds, row, expected)
                    array.set(journalCategories,      row, CAT_FVG)
                    array.set(journalSubtypes,        row, subtype)
                    array.set(journalTfCodes,         row, tfCode)
                    array.set(journalOriginKeys,      row, oKey)
                    array.set(journalOriginTimes,     row, oTime)
                    array.set(journalOriginEndTimes,  row, oEnd)
                    array.set(journalConfirmedTimes,  row, cTime)
                    array.set(journalPointPrices,     row, float(na))
                    array.set(journalNativeBottoms,   row, nb)
                    array.set(journalNativeTops,      row, nt)
                    array.set(journalOldStates,       row, st)
                    array.set(journalNewStates,       row, st)
                    array.set(journalFvgFreshFlags,   row, false)
                    array.set(journalIsBroadFlags,    row, broad)
                    array.set(journalDirections,      row, dir)
                    array.set(journalOldMasks,        row, 0)
                    array.set(journalNewMasks,        row, 0)
                    array.set(journalPairKeys,        row, ID_NONE)
                    array.set(journalSlopeDirs,       row, int(na))
                else
                    array.push(journalOps,             JOP_FVG_FRESH_END)
                    array.push(journalGroups,          JGROUP_E3)
                    array.push(journalTargetRootSlots, target)
                    array.push(journalExpectedRootIds, expected)
                    array.push(journalCategories,      CAT_FVG)
                    array.push(journalSubtypes,        subtype)
                    array.push(journalTfCodes,         tfCode)
                    array.push(journalOriginKeys,      oKey)
                    array.push(journalOriginTimes,     oTime)
                    array.push(journalOriginEndTimes,  oEnd)
                    array.push(journalConfirmedTimes,  cTime)
                    array.push(journalPointPrices,     float(na))
                    array.push(journalNativeBottoms,   nb)
                    array.push(journalNativeTops,      nt)
                    array.push(journalOldStates,       st)
                    array.push(journalNewStates,       st)
                    array.push(journalFvgFreshFlags,   false)
                    array.push(journalIsBroadFlags,    broad)
                    array.push(journalDirections,      dir)
                    array.push(journalOldMasks,        0)
                    array.push(journalNewMasks,        0)
                    array.push(journalPairKeys,        ID_NONE)
                    array.push(journalSlopeDirs,       int(na))
                journalCountNow := row + 1
                r += 1
            phase += 1
    [journalCountNow, violation]

// ---- W07 B08 : FVG InverseWait entry (ROOT_INVALIDATED -> ROOT_INVERSE_WAIT) ----

// Generic Root state set move ROOT_INVALIDATED -> ROOT_INVERSE_WAIT of one Root, the same
// membership semantics as W03Apply rootStateSetMoveRaw restricted to these two sets:
// rootStateSetPositions[rootSlot] must index rootSlot in stateInvalidatedRootSlots and the
// set's last entry must be a live Root whose position is the last index; then swap-pop from
// the Invalidated set (the last entry moves into the freed position, its position updated),
// push onto the InverseWait set and write the new position. rootStates is not written here
// (the caller writes it, as with rootStateSetMoveRaw). Everything is checked before the first
// write; commit = false checks only. Returns true when the move is (or would be) done.
rootStateMoveW07Raw(array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> stateInvalidatedRootSlots, array<int> stateInverseWaitRootSlots, array<int> rootStateSetPositions, int rootSlot, bool commit) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootStateSetPositions)
    int statePos = SLOT_INVALID
    if ok
        statePos := array.get(rootStateSetPositions, rootSlot)
        ok := statePos >= 0 and statePos < array.size(stateInvalidatedRootSlots)
        if ok
            ok := array.get(stateInvalidatedRootSlots, statePos) == rootSlot
    int oldLastPos      = array.size(stateInvalidatedRootSlots) - 1
    int oldLastRootSlot = SLOT_INVALID
    if ok
        ok := oldLastPos >= 0
        if ok
            oldLastRootSlot := array.get(stateInvalidatedRootSlots, oldLastPos)
            ok := oldLastRootSlot >= 0 and oldLastRootSlot < array.size(rootIds) and oldLastRootSlot < array.size(rootSlotLiveFlags) and oldLastRootSlot < array.size(rootStateSetPositions)
        if ok
            ok := array.get(rootSlotLiveFlags, oldLastRootSlot) and array.get(rootIds, oldLastRootSlot) != ID_NONE and array.get(rootStateSetPositions, oldLastRootSlot) == oldLastPos
    if ok and commit
        int newPos = array.size(stateInverseWaitRootSlots)
        if statePos != oldLastPos
            array.set(stateInvalidatedRootSlots, statePos, oldLastRootSlot)
            array.set(rootStateSetPositions, oldLastRootSlot, statePos)
        array.pop(stateInvalidatedRootSlots)
        array.push(stateInverseWaitRootSlots, rootSlot)
        array.set(rootStateSetPositions, rootSlot, newPos)
    ok

// W07 B08: move one structurally invalidated FVG Root into the Inverse wait: rootStates
// ROOT_INVALIDATED -> ROOT_INVERSE_WAIT, generic state set Invalidated -> InverseWait, append to
// inverseWaitFvgRootSlots (position in rootFvgInverseWaitSetPositions), inverse progress
// FVG_INV_PROGRESS_NONE -> FVG_INV_PROGRESS_WAIT_MOVED_AWAY. A transition, not a sync: a Root
// not in ROOT_INVALIDATED (already waiting included) -> false. Preconditions, all checked
// before any write: rootSlot in range and live, expectedRootId > 0 == rootIds[rootSlot] ==
// rootFvgW07ExpectedRootIds[rootSlot], CAT_FVG, ROOT_INVALIDATED, Bullish / Bearish, generic
// Invalidated membership valid, progress NONE (or not yet extended), FVG wait / active
// positions SLOT_INVALID (or not yet extended). The per-Root W07 arrays are extended to
// rootSlot + 1 (NONE / SLOT_INVALID) only after every check passed, so false -> no write.
// No price / close / reset distance is read and nothing moves past WAIT_MOVED_AWAY here (the
// invalidation bar is never a moved-away bar). Fresh, structurallyActive sets, direction,
// NativeRange, Side / Touch, pending and confirm storage, revisions and seeds are untouched.
export inverseWaitEnterApply(int rootSlot, int expectedRootId, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootFvgW07ExpectedRootIds, array<int> rootFvgInverseProgresses, array<int> rootFvgInverseWaitSetPositions, array<int> rootFvgInverseActiveSetPositions, array<int> inverseWaitFvgRootSlots, array<int> inverseActiveFvgRootSlots, array<int> stateInvalidatedRootSlots, array<int> stateInverseWaitRootSlots, array<int> rootStateSetPositions) =>
    bool ok = not na(rootSlot) and rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootDirections) and rootSlot < array.size(rootFvgW07ExpectedRootIds) and not na(expectedRootId) and expectedRootId > ID_NONE
    if ok
        int dir = array.get(rootDirections, rootSlot)
        ok := array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) == expectedRootId and array.get(rootFvgW07ExpectedRootIds, rootSlot) == expectedRootId and array.get(rootCategories, rootSlot) == CAT_FVG and array.get(rootStates, rootSlot) == ROOT_INVALIDATED and (dir == FVG_BULLISH or dir == FVG_BEARISH)
    if ok and rootSlot < array.size(rootFvgInverseProgresses)
        ok := array.get(rootFvgInverseProgresses, rootSlot) == FVG_INV_PROGRESS_NONE
    if ok and rootSlot < array.size(rootFvgInverseWaitSetPositions)
        ok := array.get(rootFvgInverseWaitSetPositions, rootSlot) == SLOT_INVALID
    if ok and rootSlot < array.size(rootFvgInverseActiveSetPositions)
        ok := array.get(rootFvgInverseActiveSetPositions, rootSlot) == SLOT_INVALID
    if ok
        // O(1) store invariant: the FVG InverseActive set is a subset of the Root slots
        ok := array.size(inverseActiveFvgRootSlots) <= array.size(rootIds)
    if ok
        ok := rootStateMoveW07Raw(rootIds, rootSlotLiveFlags, stateInvalidatedRootSlots, stateInverseWaitRootSlots, rootStateSetPositions, rootSlot, false)
    if ok
        while array.size(rootFvgInverseProgresses) <= rootSlot
            array.push(rootFvgInverseProgresses, FVG_INV_PROGRESS_NONE)
        while array.size(rootFvgInverseWaitSetPositions) <= rootSlot
            array.push(rootFvgInverseWaitSetPositions, SLOT_INVALID)
        while array.size(rootFvgInverseActiveSetPositions) <= rootSlot
            array.push(rootFvgInverseActiveSetPositions, SLOT_INVALID)
        rootStateMoveW07Raw(rootIds, rootSlotLiveFlags, stateInvalidatedRootSlots, stateInverseWaitRootSlots, rootStateSetPositions, rootSlot, true)
        array.set(rootStates, rootSlot, ROOT_INVERSE_WAIT)
        array.set(rootFvgInverseWaitSetPositions, rootSlot, array.size(inverseWaitFvgRootSlots))
        array.push(inverseWaitFvgRootSlots, rootSlot)
        array.set(rootFvgInverseProgresses, rootSlot, FVG_INV_PROGRESS_WAIT_MOVED_AWAY)
    ok

// ---- W07 B09 : FVG Inverse progress evaluation (facts only, no canonical mutation) ----

// One confirmed 5m bar for one InverseWait FVG Root, from its start progress only (one step
// per call, no chaining): WAIT_MOVED_AWAY -> MOVED_AWAY when the close moved away by resetTick
// (Bull: close <= bottom - reset, Bear: close >= top + reset); MOVED_AWAY -> ACTIVE when the bar
// touches the NativeRange (inclusive: low <= top and high >= bottom) and the close confirms
// (Bull: close <= bottom, Bear: close >= top), -> RETOUCHED when it touches without the close
// confirm; RETOUCHED -> ACTIVE on the close confirm alone. Otherwise the start progress is
// returned (no reset to an earlier progress). Invalid input (progress not 1 / 2 / 3, direction
// not Bullish / Bearish, bottom > top, low > high, resetTick < 0, any na) -> -1. Pure.
inverseEvalOneRaw(int progress, int direction, int nativeBottomTick, int nativeTopTick, int baseHighTick, int baseLowTick, int baseCloseTick, int resetTick) =>
    bool ok = not na(progress) and not na(direction) and not na(nativeBottomTick) and not na(nativeTopTick) and not na(baseHighTick) and not na(baseLowTick) and not na(baseCloseTick) and not na(resetTick)
    if ok
        ok := (progress == FVG_INV_PROGRESS_WAIT_MOVED_AWAY or progress == FVG_INV_PROGRESS_MOVED_AWAY or progress == FVG_INV_PROGRESS_RETOUCHED) and (direction == FVG_BULLISH or direction == FVG_BEARISH) and nativeBottomTick <= nativeTopTick and baseLowTick <= baseHighTick and resetTick >= 0
    int nextProgress = -1
    if ok
        bool isBull  = direction == FVG_BULLISH
        bool confirm = isBull ? baseCloseTick <= nativeBottomTick : baseCloseTick >= nativeTopTick
        nextProgress := progress
        if progress == FVG_INV_PROGRESS_WAIT_MOVED_AWAY
            bool movedAway = isBull ? baseCloseTick <= nativeBottomTick - resetTick : baseCloseTick >= nativeTopTick + resetTick
            if movedAway
                nextProgress := FVG_INV_PROGRESS_MOVED_AWAY
        else if progress == FVG_INV_PROGRESS_MOVED_AWAY
            bool touched = baseLowTick <= nativeTopTick and baseHighTick >= nativeBottomTick
            if touched
                nextProgress := confirm ? FVG_INV_PROGRESS_ACTIVE : FVG_INV_PROGRESS_RETOUCHED
        else if confirm
            nextProgress := FVG_INV_PROGRESS_ACTIVE
    nextProgress

// W07 B09: evaluate every Root of inverseWaitFvgRootSlots (index order) on the confirmed base bar
// and write one pending fact (rootSlot, rootId, new progress) per Root whose progress changes,
// into index 0 .. pendingCountOut - 1 of the three pending arrays (set when the slot exists,
// push otherwise; never cleared). Only the pending arrays are written: rootStates, progress,
// generic / FVG sets and positions, Fresh, Side / Touch, confirm list and revisions are read-only
// (a pending ACTIVE is applied later, not here). Ticks: round(price / mintick), resetTick =
// round(touchResetDistance / mintick). Each wait Root is checked (slot range, live, rootId,
// W07 identity, CAT_FVG, ROOT_INVERSE_WAIT, Bullish / Bearish, native ticks, progress 1 / 2 / 3,
// wait position == index, active position SLOT_INVALID, generic InverseWait position); any
// failure, or a non-empty wait set with an unusable base bar / reset distance -> [0, true].
// cfgUseFvg false -> [0, false]. Cost O(W) for W waiting Roots, O(1) each.
export inverseFacts(bool cfgUseFvg, float feedBaseHigh, float feedBaseLow, float feedBaseClose, float feedMintick, float touchResetDistance, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootFvgW07ExpectedRootIds, array<int> rootFvgInverseProgresses, array<int> rootFvgInverseWaitSetPositions, array<int> rootFvgInverseActiveSetPositions, array<int> inverseWaitFvgRootSlots, array<int> stateInverseWaitRootSlots, array<int> rootStateSetPositions, array<int> fvgInversePendingRootSlots, array<int> fvgInversePendingExpectedRootIds, array<int> fvgInversePendingNewProgresses) =>
    int  count     = 0
    bool violation = false
    int  w = array.size(inverseWaitFvgRootSlots)
    if cfgUseFvg and w > 0
        bool feedOk = not na(feedBaseHigh) and not na(feedBaseLow) and not na(feedBaseClose) and not na(feedMintick) and feedMintick > 0 and not na(touchResetDistance)
        int baseHighTick  = feedOk ? int(math.round(feedBaseHigh  / feedMintick)) : int(na)
        int baseLowTick   = feedOk ? int(math.round(feedBaseLow   / feedMintick)) : int(na)
        int baseCloseTick = feedOk ? int(math.round(feedBaseClose / feedMintick)) : int(na)
        int resetTick     = feedOk ? int(math.round(touchResetDistance / feedMintick)) : int(na)
        violation := not feedOk
        int i = 0
        while not violation and i < w
            int  rootSlot = array.get(inverseWaitFvgRootSlots, i)
            bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootDirections) and rootSlot < array.size(rootNativeBottomTicks) and rootSlot < array.size(rootNativeTopTicks) and rootSlot < array.size(rootFvgW07ExpectedRootIds) and rootSlot < array.size(rootFvgInverseProgresses) and rootSlot < array.size(rootFvgInverseWaitSetPositions) and rootSlot < array.size(rootFvgInverseActiveSetPositions) and rootSlot < array.size(rootStateSetPositions)
            int  rootId   = ID_NONE
            int  progress = FVG_INV_PROGRESS_NONE
            if ok
                rootId   := array.get(rootIds, rootSlot)
                progress := array.get(rootFvgInverseProgresses, rootSlot)
                int dir = array.get(rootDirections, rootSlot)
                ok := array.get(rootSlotLiveFlags, rootSlot) and rootId > ID_NONE and array.get(rootFvgW07ExpectedRootIds, rootSlot) == rootId and array.get(rootCategories, rootSlot) == CAT_FVG and array.get(rootStates, rootSlot) == ROOT_INVERSE_WAIT and (dir == FVG_BULLISH or dir == FVG_BEARISH) and (progress == FVG_INV_PROGRESS_WAIT_MOVED_AWAY or progress == FVG_INV_PROGRESS_MOVED_AWAY or progress == FVG_INV_PROGRESS_RETOUCHED) and array.get(rootFvgInverseWaitSetPositions, rootSlot) == i and array.get(rootFvgInverseActiveSetPositions, rootSlot) == SLOT_INVALID
            if ok
                int p = array.get(rootStateSetPositions, rootSlot)
                ok := p >= 0 and p < array.size(stateInverseWaitRootSlots)
                if ok
                    ok := array.get(stateInverseWaitRootSlots, p) == rootSlot
            int nextProgress = -1
            if ok
                nextProgress := inverseEvalOneRaw(progress, array.get(rootDirections, rootSlot), array.get(rootNativeBottomTicks, rootSlot), array.get(rootNativeTopTicks, rootSlot), baseHighTick, baseLowTick, baseCloseTick, resetTick)
                ok := nextProgress >= 0
            if not ok
                violation := true
            else if nextProgress != progress
                if count < array.size(fvgInversePendingRootSlots)
                    array.set(fvgInversePendingRootSlots, count, rootSlot)
                else
                    array.push(fvgInversePendingRootSlots, rootSlot)
                if count < array.size(fvgInversePendingExpectedRootIds)
                    array.set(fvgInversePendingExpectedRootIds, count, rootId)
                else
                    array.push(fvgInversePendingExpectedRootIds, rootId)
                if count < array.size(fvgInversePendingNewProgresses)
                    array.set(fvgInversePendingNewProgresses, count, nextProgress)
                else
                    array.push(fvgInversePendingNewProgresses, nextProgress)
                count += 1
            i += 1
    [violation ? 0 : count, violation]

// ---- W07 B10 : FVG Inverse pending preflight / apply ----

// W07 B10: check the pending Inverse facts 0 .. pendingCount - 1 (from inverseFacts) without
// writing anything. pendingCount must fit all three pending arrays (0 -> true). Allowed
// (current progress -> new progress): 1 -> 2, 2 -> 3, 2 -> 4, 3 -> 4 only. Each row: slot in range
// of every per-Root array, live, rootId > 0 == expected == rootFvgW07ExpectedRootIds, CAT_FVG,
// ROOT_INVERSE_WAIT, Bullish / Bearish, wait position valid and pointing back, active position
// SLOT_INVALID, generic InverseWait position valid and pointing back; wait positions strictly
// increase over the rows (pending order and no duplicate Root, O(P)). An ACTIVE row also needs
// the generic InverseWait -> InverseActive move to pass (rootStateMoveW07Raw dry run) and the FVG
// wait set's last entry to be consistent. O(1) store invariants: both InverseActive sets have no
// more entries than Root slots. Cost O(P).
export inversePendingPreflight(int pendingCount, array<int> fvgInversePendingRootSlots, array<int> fvgInversePendingExpectedRootIds, array<int> fvgInversePendingNewProgresses, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootFvgW07ExpectedRootIds, array<int> rootFvgInverseProgresses, array<int> rootFvgInverseWaitSetPositions, array<int> rootFvgInverseActiveSetPositions, array<int> inverseWaitFvgRootSlots, array<int> inverseActiveFvgRootSlots, array<int> stateInverseWaitRootSlots, array<int> stateInverseActiveRootSlots, array<int> rootStateSetPositions) =>
    bool ok = not na(pendingCount) and pendingCount >= 0 and pendingCount <= array.size(fvgInversePendingRootSlots) and pendingCount <= array.size(fvgInversePendingExpectedRootIds) and pendingCount <= array.size(fvgInversePendingNewProgresses)
    if ok
        ok := array.size(inverseActiveFvgRootSlots) <= array.size(rootIds) and array.size(stateInverseActiveRootSlots) <= array.size(rootIds)
    int prevWaitPos = SLOT_INVALID
    int j = 0
    while ok and j < pendingCount
        int slot           = array.get(fvgInversePendingRootSlots, j)
        int expectedRootId = array.get(fvgInversePendingExpectedRootIds, j)
        int newProgress    = array.get(fvgInversePendingNewProgresses, j)
        ok := slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootCategories) and slot < array.size(rootStates) and slot < array.size(rootDirections) and slot < array.size(rootFvgW07ExpectedRootIds) and slot < array.size(rootFvgInverseProgresses) and slot < array.size(rootFvgInverseWaitSetPositions) and slot < array.size(rootFvgInverseActiveSetPositions) and slot < array.size(rootStateSetPositions) and not na(expectedRootId) and expectedRootId > ID_NONE
        int waitPos = SLOT_INVALID
        if ok
            int dir = array.get(rootDirections, slot)
            int cur = array.get(rootFvgInverseProgresses, slot)
            ok := array.get(rootSlotLiveFlags, slot) and array.get(rootIds, slot) == expectedRootId and array.get(rootFvgW07ExpectedRootIds, slot) == expectedRootId and array.get(rootCategories, slot) == CAT_FVG and array.get(rootStates, slot) == ROOT_INVERSE_WAIT and (dir == FVG_BULLISH or dir == FVG_BEARISH) and ((cur == FVG_INV_PROGRESS_WAIT_MOVED_AWAY and newProgress == FVG_INV_PROGRESS_MOVED_AWAY) or (cur == FVG_INV_PROGRESS_MOVED_AWAY and (newProgress == FVG_INV_PROGRESS_RETOUCHED or newProgress == FVG_INV_PROGRESS_ACTIVE)) or (cur == FVG_INV_PROGRESS_RETOUCHED and newProgress == FVG_INV_PROGRESS_ACTIVE))
        if ok
            waitPos := array.get(rootFvgInverseWaitSetPositions, slot)
            ok := waitPos >= 0 and waitPos < array.size(inverseWaitFvgRootSlots) and waitPos > prevWaitPos and array.get(rootFvgInverseActiveSetPositions, slot) == SLOT_INVALID
            if ok
                ok := array.get(inverseWaitFvgRootSlots, waitPos) == slot
        if ok
            int genericPos = array.get(rootStateSetPositions, slot)
            ok := genericPos >= 0 and genericPos < array.size(stateInverseWaitRootSlots)
            if ok
                ok := array.get(stateInverseWaitRootSlots, genericPos) == slot
        if ok and newProgress == FVG_INV_PROGRESS_ACTIVE
            ok := rootStateMoveW07Raw(rootIds, rootSlotLiveFlags, stateInverseWaitRootSlots, stateInverseActiveRootSlots, rootStateSetPositions, slot, false)
            if ok
                int lastIndex = array.size(inverseWaitFvgRootSlots) - 1
                int lastSlot  = array.get(inverseWaitFvgRootSlots, lastIndex)
                ok := lastSlot >= 0 and lastSlot < array.size(rootIds) and lastSlot < array.size(rootSlotLiveFlags) and lastSlot < array.size(rootFvgInverseWaitSetPositions)
                if ok
                    ok := array.get(rootSlotLiveFlags, lastSlot) and array.get(rootIds, lastSlot) > ID_NONE and array.get(rootFvgInverseWaitSetPositions, lastSlot) == lastIndex
        prevWaitPos := waitPos
        j += 1
    ok

// W07 B10: apply the pending Inverse facts after inversePendingPreflight passed (false -> false,
// nothing written). Rows 0 .. pendingCount - 1 in order. MOVED_AWAY / RETOUCHED rows write only
// rootFvgInverseProgresses. An ACTIVE row re-checks its current state (ROOT_INVERSE_WAIT, progress
// 2 / 3, current wait / generic positions, active position SLOT_INVALID, generic move dry run)
// from the arrays as they are now (earlier rows may have moved entries), then: generic
// InverseWait -> InverseActive move, swap-pop out of inverseWaitFvgRootSlots, append to
// inverseActiveFvgRootSlots, rootStates := ROOT_INVERSE_ACTIVE, progress := ACTIVE. A failed
// re-check after preflight is an internal invariant break: runtime.error. rootDirections, Fresh,
// Side / Touch, confirm list, pending arrays and revisions are untouched; no Root / Core is made.
export inversePendingApply(int pendingCount, array<int> fvgInversePendingRootSlots, array<int> fvgInversePendingExpectedRootIds, array<int> fvgInversePendingNewProgresses, array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootCategories, array<int> rootStates, array<int> rootDirections, array<int> rootFvgW07ExpectedRootIds, array<int> rootFvgInverseProgresses, array<int> rootFvgInverseWaitSetPositions, array<int> rootFvgInverseActiveSetPositions, array<int> inverseWaitFvgRootSlots, array<int> inverseActiveFvgRootSlots, array<int> stateInverseWaitRootSlots, array<int> stateInverseActiveRootSlots, array<int> rootStateSetPositions) =>
    bool ok = inversePendingPreflight(pendingCount, fvgInversePendingRootSlots, fvgInversePendingExpectedRootIds, fvgInversePendingNewProgresses, rootIds, rootSlotLiveFlags, rootCategories, rootStates, rootDirections, rootFvgW07ExpectedRootIds, rootFvgInverseProgresses, rootFvgInverseWaitSetPositions, rootFvgInverseActiveSetPositions, inverseWaitFvgRootSlots, inverseActiveFvgRootSlots, stateInverseWaitRootSlots, stateInverseActiveRootSlots, rootStateSetPositions)
    int j = 0
    while ok and j < pendingCount
        int slot        = array.get(fvgInversePendingRootSlots, j)
        int newProgress = array.get(fvgInversePendingNewProgresses, j)
        if newProgress != FVG_INV_PROGRESS_ACTIVE
            array.set(rootFvgInverseProgresses, slot, newProgress)
        else
            int  cur       = array.get(rootFvgInverseProgresses, slot)
            int  waitPos   = array.get(rootFvgInverseWaitSetPositions, slot)
            int  lastIndex = array.size(inverseWaitFvgRootSlots) - 1
            bool live = array.get(rootStates, slot) == ROOT_INVERSE_WAIT and (cur == FVG_INV_PROGRESS_MOVED_AWAY or cur == FVG_INV_PROGRESS_RETOUCHED) and array.get(rootFvgInverseActiveSetPositions, slot) == SLOT_INVALID and waitPos >= 0 and waitPos <= lastIndex
            int  lastSlot = SLOT_INVALID
            if live
                lastSlot := array.get(inverseWaitFvgRootSlots, lastIndex)
                live := array.get(inverseWaitFvgRootSlots, waitPos) == slot and lastSlot >= 0 and lastSlot < array.size(rootFvgInverseWaitSetPositions) and array.get(rootFvgInverseWaitSetPositions, lastSlot) == lastIndex
            if live
                live := rootStateMoveW07Raw(rootIds, rootSlotLiveFlags, stateInverseWaitRootSlots, stateInverseActiveRootSlots, rootStateSetPositions, slot, false)
            if not live
                runtime.error("W07_INVERSE_APPLY_INVARIANT")
            rootStateMoveW07Raw(rootIds, rootSlotLiveFlags, stateInverseWaitRootSlots, stateInverseActiveRootSlots, rootStateSetPositions, slot, true)
            if slot != lastSlot
                array.set(inverseWaitFvgRootSlots, waitPos, lastSlot)
                array.set(rootFvgInverseWaitSetPositions, lastSlot, waitPos)
            array.pop(inverseWaitFvgRootSlots)
            array.set(rootFvgInverseWaitSetPositions, slot, SLOT_INVALID)
            array.set(rootFvgInverseActiveSetPositions, slot, array.size(inverseActiveFvgRootSlots))
            array.push(inverseActiveFvgRootSlots, slot)
            array.set(rootStates, slot, ROOT_INVERSE_ACTIVE)
            array.set(rootFvgInverseProgresses, slot, FVG_INV_PROGRESS_ACTIVE)
        j += 1
    ok

// ============================================================
//  雲 単体モジュール (Ichimoku Cloud / Indicator版)
// ============================================================
//  ・一目均衡表の雲だけを独立モジュール化。
//  ・後で FVG / Pivot / Fib / EMA / RSI / MACD / ストキャス /
//    出来高 / レジサポ と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・strategy.entry/exit/closedtrades/opentrades は使わない。
//  ・未来参照禁止: 判定は senkouA[displacement]/senkouB[displacement]、
//    表示は plot offset=displacement。
//  役割: A方向F B雲中NoTrade C雲抜けBO D雲抜けRetest E雲反発
//        F厚み G ねじれ + Tenkan/Kijun整合 + Rank
// ============================================================

//@version=5
indicator(
     title          = "Ichimoku Cloud Module",
     shorttitle     = "CLOUD",
     overlay        = true,
     max_bars_back  = 1000,
     max_labels_count = 500
 )

// ============================================================
//  入力 (グループ: Cloud Module)
// ============================================================
grpCloud = "Cloud Module"

useCloudModule      = input.bool(true, "雲モジュールを使う", group = grpCloud)
showCloud           = input.bool(true, "雲を表示",           group = grpCloud)
showTenkanKijun     = input.bool(false,"転換線/基準線を表示", group = grpCloud)
showCloudLabels     = input.bool(true, "シグナルラベルを表示", group = grpCloud)
showCloudDebugTable = input.bool(true, "デバッグテーブルを表示", group = grpCloud)

tenkanLen    = input.int(9,  "転換線 Length",   minval = 1, group = grpCloud)
kijunLen     = input.int(26, "基準線 Length",   minval = 1, group = grpCloud)
senkouBLen   = input.int(52, "先行スパンB Length", minval = 1, group = grpCloud)
displacement = input.int(26, "雲の先行表示本数", minval = 1, group = grpCloud)

cloudPriceMode = input.string("Close", "価格判定", options = ["Close", "HighLow"], group = grpCloud)

useCloudDirectionFilter = input.bool(true,  "A: 雲上/雲下フィルター", group = grpCloud)
useCloudInsideNoTrade   = input.bool(true,  "B: 雲中ノートレード",     group = grpCloud)
useCloudBreakout        = input.bool(true,  "C: 雲抜けブレイク",       group = grpCloud)
useCloudRetest          = input.bool(true,  "D: 雲抜け後リテスト",     group = grpCloud)
useCloudBounce          = input.bool(true,  "E: 雲反発",               group = grpCloud)
useCloudThicknessFilter = input.bool(false, "F: 雲厚みフィルター",     group = grpCloud)
useCloudTwist           = input.bool(true,  "G: 雲ねじれ検知",         group = grpCloud)

cloudEntryMode = input.string("Any", "エントリー結合", options = ["Any", "All"], group = grpCloud)

cloudTouchMode   = input.string("ATR", "雲接近判定", options = ["Dollar", "ATR"], group = grpCloud)
cloudTouchDollar = input.float(3.0, "雲接近幅($)",      step = 0.1,  group = grpCloud)
cloudTouchATR    = input.float(0.3, "雲接近幅 ATR倍率", step = 0.05, group = grpCloud)

cloudRetestBars  = input.int(10, "雲リテスト有効本数", minval = 1, group = grpCloud)

minCloudThicknessDollar = input.float(3.0,  "最低雲厚み($)", step = 0.1, group = grpCloud)
maxCloudThicknessDollar = input.float(30.0, "最大雲厚み($)", step = 0.1, group = grpCloud)

useTenkanKijunConfirm = input.bool(true, "転換線/基準線の整合を使う", group = grpCloud)

// ============================================================
//  優先度1: 一目均衡表 計算
// ============================================================
float cloud_tenkan = (ta.highest(high, tenkanLen) + ta.lowest(low, tenkanLen)) / 2.0
float cloud_kijun  = (ta.highest(high, kijunLen)  + ta.lowest(low, kijunLen))  / 2.0
float cloud_senkouA = (cloud_tenkan + cloud_kijun) / 2.0
float cloud_senkouB = (ta.highest(high, senkouBLen) + ta.lowest(low, senkouBLen)) / 2.0
float cloud_chikou  = close

bool pAct = useCloudModule

// 判定用 = 現在足に対応する雲 (未来参照しない)
float cloudA_now = cloud_senkouA[displacement]
float cloudB_now = cloud_senkouB[displacement]
bool  cloud_valid = not na(cloudA_now) and not na(cloudB_now)

float cloud_top = cloud_valid ? math.max(cloudA_now, cloudB_now) : na
float cloud_bot = cloud_valid ? math.min(cloudA_now, cloudB_now) : na
float cloudThickness = cloud_valid ? math.abs(cloudA_now - cloudB_now) : na

// ============================================================
//  優先度1: 雲の 上/下/中 判定
// ============================================================
bool aboveCloud  = cloud_valid and (cloudPriceMode == "HighLow" ? low > cloud_top  : close > cloud_top)
bool belowCloud  = cloud_valid and (cloudPriceMode == "HighLow" ? high < cloud_bot : close < cloud_bot)
bool insideCloud = cloud_valid and not aboveCloud and not belowCloud

// ============================================================
//  接近幅 / 反転ローソク (共通)
// ============================================================
float cloud_touchRange = cloudTouchMode == "ATR" ? ta.atr(14) * cloudTouchATR : cloudTouchDollar

float cloud_body   = math.abs(close - open)
float cloud_upWick = high - math.max(open, close)
float cloud_dnWick = math.min(open, close) - low
bool cloud_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool cloud_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool cloud_pinLower = cloud_dnWick >= cloud_body and cloud_dnWick >= cloud_upWick
bool cloud_pinUpper = cloud_upWick >= cloud_body and cloud_upWick >= cloud_dnWick
bool cloud_bullishReversal = cloud_bullEngulf or cloud_pinLower or close > open
bool cloud_bearishReversal = cloud_bearEngulf or cloud_pinUpper or close < open

// ============================================================
//  A: 雲上/雲下フィルター
// ============================================================
bool cloudDirectionOkLong  = not (pAct and useCloudDirectionFilter) or aboveCloud
bool cloudDirectionOkShort = not (pAct and useCloudDirectionFilter) or belowCloud

// ============================================================
//  B: 雲中ノートレード
// ============================================================
bool cloudNoTradeLong  = pAct and useCloudInsideNoTrade and insideCloud
bool cloudNoTradeShort = pAct and useCloudInsideNoTrade and insideCloud

// ============================================================
//  C: 雲抜けブレイク
// ============================================================
bool cloudBuyBreakoutSignal  = pAct and useCloudBreakout and cloud_valid and not aboveCloud[1] and aboveCloud
bool cloudSellBreakoutSignal = pAct and useCloudBreakout and cloud_valid and not belowCloud[1] and belowCloud

// ============================================================
//  D: 雲抜け後リテスト
// ============================================================
var int cloud_breakUpBar = na
var int cloud_breakDnBar = na
if aboveCloud and not aboveCloud[1]
    cloud_breakUpBar := bar_index
if belowCloud and not belowCloud[1]
    cloud_breakDnBar := bar_index

bool cloudBuyRetestSignal  = pAct and useCloudRetest and cloud_valid and not na(cloud_breakUpBar) and (bar_index - cloud_breakUpBar) <= cloudRetestBars and low <= cloud_top + cloud_touchRange and close > cloud_top and close > open
bool cloudSellRetestSignal = pAct and useCloudRetest and cloud_valid and not na(cloud_breakDnBar) and (bar_index - cloud_breakDnBar) <= cloudRetestBars and high >= cloud_bot - cloud_touchRange and close < cloud_bot and close < open

// ============================================================
//  E: 雲反発
// ============================================================
bool cloud_near = cloud_valid and (math.abs(close - cloud_top) <= cloud_touchRange or math.abs(close - cloud_bot) <= cloud_touchRange)
bool cloudBuyBounceSignal  = pAct and useCloudBounce and cloud_near and cloud_bullishReversal and close > cloud_bot
bool cloudSellBounceSignal = pAct and useCloudBounce and cloud_near and cloud_bearishReversal and close < cloud_top

// ============================================================
//  F: 雲厚みフィルター
// ============================================================
bool cloud_thickInRange = cloud_valid and cloudThickness >= minCloudThicknessDollar and cloudThickness <= maxCloudThicknessDollar
bool cloudThicknessOk = not (pAct and useCloudThicknessFilter) or cloud_thickInRange

// ============================================================
//  G: 雲ねじれ検知 (現在計算できる senkouA/B のクロス)
// ============================================================
bool cloud_twistNow = ta.cross(cloud_senkouA, cloud_senkouB)
bool cloudTwistSignal = pAct and useCloudTwist and cloud_twistNow

// ============================================================
//  転換線/基準線の整合
// ============================================================
bool tenkanKijunOkLong  = not (pAct and useTenkanKijunConfirm) or cloud_tenkan > cloud_kijun
bool tenkanKijunOkShort = not (pAct and useTenkanKijunConfirm) or cloud_tenkan < cloud_kijun

// ============================================================
//  エントリー結合 (Any / All)
//   対象: Breakout / Retest / Bounce のうち ON のものだけ
// ============================================================
int cloudEnabledCount = (useCloudBreakout ? 1 : 0) + (useCloudRetest ? 1 : 0) + (useCloudBounce ? 1 : 0)
int cloudFiredBuy  = (cloudBuyBreakoutSignal ? 1 : 0) + (cloudBuyRetestSignal ? 1 : 0) + (cloudBuyBounceSignal ? 1 : 0)
int cloudFiredSell = (cloudSellBreakoutSignal ? 1 : 0) + (cloudSellRetestSignal ? 1 : 0) + (cloudSellBounceSignal ? 1 : 0)
bool cloudEntryBuy  = pAct and cloudEnabledCount > 0 and (cloudEntryMode == "All" ? cloudFiredBuy  == cloudEnabledCount : cloudFiredBuy  >= 1)
bool cloudEntrySell = pAct and cloudEnabledCount > 0 and (cloudEntryMode == "All" ? cloudFiredSell == cloudEnabledCount : cloudFiredSell >= 1)

// ============================================================
//  最終出力
// ============================================================
bool allowLongByCloud  = pAct and cloudEntryBuy  and cloudDirectionOkLong  and not cloudNoTradeLong  and cloudThicknessOk and tenkanKijunOkLong
bool allowShortByCloud = pAct and cloudEntrySell and cloudDirectionOkShort and not cloudNoTradeShort and cloudThicknessOk and tenkanKijunOkShort
bool cloudNoTrade = cloudNoTradeLong or cloudNoTradeShort

// 方向フィルター用バイアス (Breakout/Retest/Bounce は要求しない)
//   雲方向 + 雲中NoTrade + 厚み + 転換線/基準線整合 のみで判定
bool cloudBiasLong  = pAct and aboveCloud and not cloudNoTradeLong  and cloudThicknessOk and tenkanKijunOkLong
bool cloudBiasShort = pAct and belowCloud and not cloudNoTradeShort and cloudThicknessOk and tenkanKijunOkShort

// ============================================================
//  Signal Type / Direction / Rank
//   type: 0None /1Breakout /2Retest /3Bounce /4Twist (優先 Retest>BO>Bounce>Twist)
// ============================================================
bool cloud_anyRetest = cloudBuyRetestSignal or cloudSellRetestSignal
bool cloud_anyBreak  = cloudBuyBreakoutSignal or cloudSellBreakoutSignal
bool cloud_anyBounce = cloudBuyBounceSignal or cloudSellBounceSignal

int cloudSignalType = not pAct ? 0 :
                       cloud_anyRetest ? 2 :
                       cloud_anyBreak  ? 1 :
                       cloud_anyBounce ? 3 :
                       cloudTwistSignal? 4 : 0

int cloudDirection = not pAct ? 0 :
                      cloud_anyRetest ? (cloudBuyRetestSignal ? 1 : -1) :
                      cloud_anyBreak  ? (cloudBuyBreakoutSignal ? 1 : -1) :
                      cloud_anyBounce ? (cloudBuyBounceSignal ? 1 : -1) : 0

// Rank: 0なし /1雲上下 /2BO /3Bounce /4Retest /5Retest+整合+厚み /6Twist+合流
bool cloud_rank5 = cloud_anyRetest and ((cloudBuyRetestSignal and cloud_tenkan > cloud_kijun) or (cloudSellRetestSignal and cloud_tenkan < cloud_kijun)) and cloud_thickInRange
bool cloud_rank6 = cloudTwistSignal and (cloud_anyRetest or cloud_anyBreak or cloud_anyBounce)
int cloudRank = not pAct ? 0 :
                 cloud_rank6 ? 6 :
                 cloud_rank5 ? 5 :
                 cloud_anyRetest ? 4 :
                 cloud_anyBounce ? 3 :
                 cloud_anyBreak  ? 2 :
                 (aboveCloud or belowCloud) ? 1 : 0

// ============================================================
//  表示 : 雲 / 転換線 / 基準線
// ============================================================
bool cloud_show = useCloudModule and showCloud
pA = plot(cloud_show ? cloud_senkouA : na, "Senkou A", color = cloud_show ? color.new(color.green, 50) : na, offset = displacement)
pB = plot(cloud_show ? cloud_senkouB : na, "Senkou B", color = cloud_show ? color.new(color.red, 50) : na,   offset = displacement)
fill(pA, pB, color = cloud_show ? (cloud_senkouA >= cloud_senkouB ? color.new(color.green, 85) : color.new(color.red, 85)) : na, title = "Cloud Fill")
plot(useCloudModule and showTenkanKijun ? cloud_tenkan : na, "Tenkan", color = color.new(color.blue, 0))
plot(useCloudModule and showTenkanKijun ? cloud_kijun  : na, "Kijun",  color = color.new(color.orange, 0))

// ============================================================
//  表示 : ラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, isBuy ? low : high, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, yloc = isBuy ? yloc.belowbar : yloc.abovebar, size = size.small)

if showCloudLabels
    if cloudBuyBreakoutSignal
        f_mkLabel(true,  "Cloud BO↑", color.new(color.green, 0))
    if cloudSellBreakoutSignal
        f_mkLabel(false, "Cloud BO↓", color.new(color.red, 0))
    if cloudBuyRetestSignal
        f_mkLabel(true,  "Cloud RT↑", color.new(color.lime, 0))
    if cloudSellRetestSignal
        f_mkLabel(false, "Cloud RT↓", color.new(color.fuchsia, 0))
    if cloudBuyBounceSignal
        f_mkLabel(true,  "Cloud Bounce↑", color.new(color.teal, 0))
    if cloudSellBounceSignal
        f_mkLabel(false, "Cloud Bounce↓", color.new(color.maroon, 0))
    if cloudTwistSignal
        f_mkLabel(false, "Cloud Twist", color.new(color.purple, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Breakout" : t == 2 ? "Retest" : t == 3 ? "Bounce" : t == 4 ? "Twist" : "-"
f_stateStr() =>
    aboveCloud ? "Above" : belowCloud ? "Below" : insideCloud ? "Inside" : "-"

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if showCloudDebugTable and barstate.islast
    string sDir = cloudDirection == 1 ? "BUY" : cloudDirection == -1 ? "SELL" : "-"
    table.cell(dbg, 0, 0, "Cloud", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, cloudNoTrade ? "NoTrade" : (cloudDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = cloudNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "State", text_color = color.white)
    table.cell(dbg, 1, 1, f_stateStr(), text_color = color.white)
    table.cell(dbg, 0, 2, "Signal Type", text_color = color.white)
    table.cell(dbg, 1, 2, f_typeStr(cloudSignalType), text_color = color.white)
    table.cell(dbg, 0, 3, "Direction", text_color = color.white)
    table.cell(dbg, 1, 3, sDir, text_color = color.white)
    table.cell(dbg, 0, 4, "Rank", text_color = color.white)
    table.cell(dbg, 1, 4, str.tostring(cloudRank), text_color = color.white)
    table.cell(dbg, 0, 5, "Thickness", text_color = color.white)
    table.cell(dbg, 1, 5, na(cloudThickness) ? "-" : str.tostring(cloudThickness, "#.##") + (cloudThicknessOk ? " OK" : " NG"), text_color = color.white)
    table.cell(dbg, 0, 6, "Tenkan/Kijun", text_color = color.white)
    table.cell(dbg, 1, 6, cloud_tenkan > cloud_kijun ? "T>K" : cloud_tenkan < cloud_kijun ? "T<K" : "T=K", text_color = color.white)
    table.cell(dbg, 0, 7, "NoTrade L/S", text_color = color.white)
    table.cell(dbg, 1, 7, (cloudNoTradeLong ? "Y" : "N") + " / " + (cloudNoTradeShort ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 8, "Allow L/S", text_color = color.white)
    table.cell(dbg, 1, 8, (allowLongByCloud ? "Y" : "N") + " / " + (allowShortByCloud ? "Y" : "N"), text_color = color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(cloud_tenkan,  "tenkan",  display = display.data_window)
plot(cloud_kijun,   "kijun",   display = display.data_window)
plot(cloud_senkouA, "senkouA", display = display.data_window)
plot(cloud_senkouB, "senkouB", display = display.data_window)
plot(cloudA_now,    "cloudA_now",   display = display.data_window)
plot(cloudB_now,    "cloudB_now",   display = display.data_window)
plot(cloud_top,     "cloudTop",     display = display.data_window)
plot(cloud_bot,     "cloudBottom",  display = display.data_window)
plot(cloudThickness,"cloudThickness", display = display.data_window)
plot(aboveCloud  ? 1 : 0, "aboveCloud",  display = display.data_window)
plot(belowCloud  ? 1 : 0, "belowCloud",  display = display.data_window)
plot(insideCloud ? 1 : 0, "insideCloud", display = display.data_window)
plot(cloudBuyBreakoutSignal  ? 1 : 0, "cloudBuyBreakoutSignal",  display = display.data_window)
plot(cloudSellBreakoutSignal ? 1 : 0, "cloudSellBreakoutSignal", display = display.data_window)
plot(cloudBuyRetestSignal  ? 1 : 0, "cloudBuyRetestSignal",  display = display.data_window)
plot(cloudSellRetestSignal ? 1 : 0, "cloudSellRetestSignal", display = display.data_window)
plot(cloudBuyBounceSignal  ? 1 : 0, "cloudBuyBounceSignal",  display = display.data_window)
plot(cloudSellBounceSignal ? 1 : 0, "cloudSellBounceSignal", display = display.data_window)
plot(cloudTwistSignal ? 1 : 0, "cloudTwistSignal", display = display.data_window)
plot(cloudSignalType, "cloudSignalType", display = display.data_window)
plot(cloudDirection,  "cloudDirection",  display = display.data_window)
plot(cloudRank,       "cloudRank",       display = display.data_window)
plot(cloudNoTrade      ? 1 : 0, "cloudNoTrade",      display = display.data_window)
plot(cloudNoTradeLong  ? 1 : 0, "cloudNoTradeLong",  display = display.data_window)
plot(cloudNoTradeShort ? 1 : 0, "cloudNoTradeShort", display = display.data_window)
plot(allowLongByCloud  ? 1 : 0, "allowLongByCloud",  display = display.data_window)
plot(allowShortByCloud ? 1 : 0, "allowShortByCloud", display = display.data_window)
plot(cloudBiasLong  ? 1 : 0, "cloudBiasLong",  display = display.data_window)
plot(cloudBiasShort ? 1 : 0, "cloudBiasShort", display = display.data_window)
plot(cloudThicknessOk  ? 1 : 0, "cloudThicknessOk",  display = display.data_window)
plot(tenkanKijunOkLong  ? 1 : 0, "tenkanKijunOkLong",  display = display.data_window)
plot(tenkanKijunOkShort ? 1 : 0, "tenkanKijunOkShort", display = display.data_window)

// ============================================================
//  シグナル形状
// ============================================================
plotshape(cloudBuyBreakoutSignal,  title = "BUY Breakout",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0),   size = size.tiny)
plotshape(cloudSellBreakoutSignal, title = "SELL Breakout", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),     size = size.tiny)
plotshape(cloudBuyRetestSignal,  title = "BUY Retest",  style = shape.diamond, location = location.belowbar, color = color.new(color.lime, 0),    size = size.tiny)
plotshape(cloudSellRetestSignal, title = "SELL Retest", style = shape.diamond, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)
plotshape(cloudBuyBounceSignal,  title = "BUY Bounce",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0),   size = size.tiny)
plotshape(cloudSellBounceSignal, title = "SELL Bounce", style = shape.circle, location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(cloudTwistSignal, title = "Twist", style = shape.xcross, location = location.bottom, color = color.new(color.purple, 0), size = size.tiny)

// ============================================================
//  アラート
// ============================================================
alertcondition(cloudBuyBreakoutSignal,  "Cloud BUY Breakout",  "{{ticker}} 雲抜けブレイク BUY")
alertcondition(cloudSellBreakoutSignal, "Cloud SELL Breakout", "{{ticker}} 雲抜けブレイク SELL")
alertcondition(cloudBuyRetestSignal,  "Cloud BUY Retest",  "{{ticker}} 雲リテスト BUY")
alertcondition(cloudSellRetestSignal, "Cloud SELL Retest", "{{ticker}} 雲リテスト SELL")
alertcondition(cloudBuyBounceSignal,  "Cloud BUY Bounce",  "{{ticker}} 雲反発 BUY")
alertcondition(cloudSellBounceSignal, "Cloud SELL Bounce", "{{ticker}} 雲反発 SELL")
alertcondition(cloudTwistSignal, "Cloud Twist", "{{ticker}} 雲ねじれ")
alertcondition(allowLongByCloud,  "Allow Long Cloud",  "{{ticker}} 雲 ロング許可")
alertcondition(allowShortByCloud, "Allow Short Cloud", "{{ticker}} 雲 ショート許可")
alertcondition(cloudNoTrade, "Cloud NoTrade", "{{ticker}} 雲 ノートレード")

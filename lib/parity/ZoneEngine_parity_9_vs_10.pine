// © shota0927-prog
//
// ============================================================================
//  ZoneEngine /9 vs /10 Parity Checker (チャート検証専用・Alert不要)
// ----------------------------------------------------------------------------
//  同一の ZoneFeed / ZoneCfg を /9 と /10 の2エンジンへ毎バー与え、
//  Raw / Zone / Track / Event / TradePlan の全フィールドを完全一致で比較する。
//  不一致があれば累積カウントが 0 から増える (plot / 最終バーのラベル)。
//  ★ 浮動小数も「!=」の完全一致で比較する (許容誤差なし)。
//  ★ Feed の作り方・input 既定値は FVG + Zone Short Signal の Section 3.2 と同じ。
//  ★ 5分足 XAUUSD チャートで使用すること。
// ============================================================================
//@version=5
indicator("ZoneEngine Parity 9 vs 10", overlay = false, dynamic_requests = true,
     max_labels_count = 10)

import sekine3310/ZoneEngine/9  as z9
import sekine3310/ZoneEngine/10 as z10

// ---- Input (Short Production の既定値) -------------------------------------
maTf          = input.timeframe("1", "MA Timeframe")
maType        = input.string("EMA", "MA Type", options = ["SMA", "EMA"])
useMaSource   = input.bool(true, "Enable MA Source")
ma1Len        = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999)
ma2Len        = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999)
slopeLookback = input.int(60, "Slope Lookback")
useHzSource   = input.bool(true, "Enable Horizontal Source")
hzTf1 = input.timeframe("5",  "Horizontal TF #1")
hzTf2 = input.timeframe("15", "Horizontal TF #2")
hzTf3 = input.timeframe("60", "Horizontal TF #3")
pivLen1 = input.int(10, "Pivot Len #1")
pivLen2 = input.int(8,  "Pivot Len #2")
pivLen3 = input.int(6,  "Pivot Len #3")
useAccSource = input.bool(true, "Enable Accumulation Source")
accTf1 = input.timeframe("60",  "Accum TF #1")
accTf2 = input.timeframe("240", "Accum TF #2")
accTf3 = input.timeframe("D",   "Accum TF #3")
breakTf = input.timeframe("5", "Break Evaluation Timeframe")
dayTz        = input.string("Asia/Tokyo", "Day Session Timezone")
dayResetHour = input.int(5, "Day Reset Hour", minval = 0, maxval = 23)

// ---- Cfg : 両エンジンへ同じ値を入れる (Short の zoneCfg と同じ代入) --------
f_cfg9() =>
    c = z9.newCfg()
    c.useMaSource := useMaSource
    c.maTfName := maTf
    c.ma1Len := ma1Len
    c.ma2Len := ma2Len
    c.useHzSource := useHzSource
    c.hzTf1 := hzTf1
    c.hzTf2 := hzTf2
    c.hzTf3 := hzTf3
    c.useAccSource := useAccSource
    c.accTf1 := accTf1
    c.accTf2 := accTf2
    c.accTf3 := accTf3
    c.tpBuffer := 0.0
    c
f_cfg10() =>
    c = z10.newCfg()
    c.useMaSource := useMaSource
    c.maTfName := maTf
    c.ma1Len := ma1Len
    c.ma2Len := ma2Len
    c.useHzSource := useHzSource
    c.hzTf1 := hzTf1
    c.hzTf2 := hzTf2
    c.hzTf3 := hzTf3
    c.useAccSource := useAccSource
    c.accTf1 := accTf1
    c.accTf2 := accTf2
    c.accTf3 := accTf3
    c.tpBuffer := 0.0
    c
z9.ZoneCfg  cfg9  = f_cfg9()
z10.ZoneCfg cfg10 = f_cfg10()

var z9.ZoneEngine  e9  = z9.newEngine()
var z10.ZoneEngine e10 = z10.newEngine()

// ---- Feed (Short Section 3.2 と同じ取得。両エンジンで値を共有する) --------
float ma1Val = na
float ma1Delta = na
float ma2Val = na
float ma2Delta = na
if useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         z9.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Val := _m1
    ma1Delta := _m1d
    ma2Val := _m2
    ma2Delta := _m2d

float ph1 = na
int ph1T = na
float pl1 = na
int pl1T = na
float ph2 = na
int ph2T = na
float pl2 = na
int pl2T = na
float ph3 = na
int ph3T = na
float pl3 = na
int pl3T = na
if useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, z9.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, z9.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, z9.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1 := _h1
    ph1T := _h1t
    pl1 := _l1
    pl1T := _l1t
    ph2 := _h2
    ph2T := _h2t
    pl2 := _l2
    pl2T := _l2t
    ph3 := _h3
    ph3T := _h3t
    pl3 := _l3
    pl3T := _l3t

float acc1Hi = na
float acc1Lo = na
int acc1Id = na
float acc2Hi = na
float acc2Lo = na
int acc2Id = na
float acc3Hi = na
float acc3Lo = na
int acc3Id = na
if useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1, z9.accumPack(true, 10, 20, 14, 4, 4, 4, 2.5, 0.70, 0.30, 20, 1.2), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2, z9.accumPack(true, 10, 20, 14, 4, 4, 4, 2.5, 0.70, 0.30, 20, 1.2), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3, z9.accumPack(true, 10, 20, 14, 4, 4, 4, 2.5, 0.70, 0.30, 15, 1.2), lookahead = barmerge.lookahead_off)
    acc1Hi := _a1h
    acc1Lo := _a1l
    acc1Id := _a1i
    acc2Hi := _a2h
    acc2Lo := _a2l
    acc2Id := _a2i
    acc3Hi := _a3h
    acc3Lo := _a3l
    acc3Id := _a3i

[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low], lookahead = barmerge.lookahead_off)
bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

z9.ZoneFeed f9 = z9.ZoneFeed.new(ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T, ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id, acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id, dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)
z10.ZoneFeed f10 = z10.ZoneFeed.new(ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T, ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id, acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id, dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)

int n9  = z9.update(e9, cfg9, f9)
int n10 = z10.update(e10, cfg10, f10)

// ---- 比較 -------------------------------------------------------------------
f_fne(float a, float b) =>
    (na(a) != na(b)) or (not na(a) and not na(b) and a != b)
f_ine(int a, int b) =>
    (na(a) != na(b)) or (not na(a) and not na(b) and a != b)
f_ane(array<int> a, array<int> b) =>
    bool d = na(a) != na(b)
    if not d and not na(a)
        if array.size(a) != array.size(b)
            d := true
        else if array.size(a) > 0
            for i = 0 to array.size(a) - 1
                if array.get(a, i) != array.get(b, i)
                    d := true
                    break
    d

int dRaw = 0
int dZone = 0
int dTrack = 0
int dEvent = 0
int dPlan = 0

dRaw += e9.rawCount != e10.rawCount ? 1 : 0
dZone += n9 != n10 ? 1 : 0
if n9 == n10 and n9 > 0
    for i = 0 to n9 - 1
        z9.Zone  a = z9.zoneAt(e9, i)
        z10.Zone b = z10.zoneAt(e10, i)
        bool d = f_fne(a.center, b.center) or f_fne(a.top, b.top) or f_fne(a.bottom, b.bottom) or
             f_fne(a.score, b.score) or f_fne(a.baseSum, b.baseSum) or f_fne(a.slopeBonus, b.slopeBonus) or
             f_fne(a.maBonus, b.maBonus) or f_fne(a.reactionBonus, b.reactionBonus) or
             f_fne(a.flipBonus, b.flipBonus) or f_fne(a.confBonus, b.confBonus) or
             a.strength != b.strength or a.state != b.state or a.flipped != b.flipped or
             a.flipDir != b.flipDir or a.catCount != b.catCount or a.memberCount != b.memberCount or
             a.trackId != b.trackId or a.reactionCnt != b.reactionCnt or a.hasHtf != b.hasHtf or
             a.sources != b.sources or a.htfSources != b.htfSources or f_ane(a.memberUids, b.memberUids)
        dZone += d ? 1 : 0

int nt9 = array.size(e9.tracks)
int nt10 = array.size(e10.tracks)
dTrack += (e9.trackSeq != e10.trackSeq or nt9 != nt10) ? 1 : 0
if nt9 == nt10 and nt9 > 0
    for i = 0 to nt9 - 1
        z9.ZoneTrack  a = array.get(e9.tracks, i)
        z10.ZoneTrack b = array.get(e10.tracks, i)
        bool d = a.id != b.id or f_fne(a.center, b.center) or f_fne(a.top, b.top) or f_fne(a.bottom, b.bottom) or
             a.state != b.state or a.lastRole != b.lastRole or a.breakDir != b.breakDir or
             a.breakBar != b.breakBar or a.retested != b.retested or a.flipped != b.flipped or
             a.flipDir != b.flipDir or a.lastSeenBar != b.lastSeenBar or a.matched != b.matched or
             f_ane(a.memberUids, b.memberUids)
        dTrack += d ? 1 : 0

dEvent += (e9.evUpBreak != e10.evUpBreak or e9.evDownBreak != e10.evDownBreak or
     e9.evFlipSup != e10.evFlipSup or e9.evFlipRes != e10.evFlipRes or
     e9.ma1Dir != e10.ma1Dir or e9.ma2Dir != e10.ma2Dir or f_fne(e9.maClusterBonus, e10.maClusterBonus)) ? 1 : 0

f_planDiff(int dir) =>
    z9.TradePlan  p = z9.buildPlan(e9, cfg9, dir, close)
    z10.TradePlan q = z10.buildPlan(e10, cfg10, dir, close)
    bool d = p.valid != q.valid or p.status != q.status or p.reason != q.reason or p.dir != q.dir or
         f_fne(p.entry, q.entry) or f_fne(p.sl, q.sl) or f_fne(p.tp, q.tp) or f_fne(p.risk, q.risk) or
         f_fne(p.reward, q.reward) or f_fne(p.rr, q.rr) or p.obstacles != q.obstacles or
         f_fne(p.slZoneCenter, q.slZoneCenter) or f_fne(p.slZoneScore, q.slZoneScore) or
         f_fne(p.tpZoneCenter, q.tpZoneCenter) or f_fne(p.tpZoneScore, q.tpZoneScore) or
         f_fne(p.tpZoneTop, q.tpZoneTop) or f_fne(p.tpZoneBottom, q.tpZoneBottom) or
         p.usedFallbackTP != q.usedFallbackTP or p.tpType != q.tpType
    d ? 1 : 0
dPlan += f_planDiff(1) + f_planDiff(-1)

var int cRaw = 0
var int cZone = 0
var int cTrack = 0
var int cEvent = 0
var int cPlan = 0
var int cBars = 0
cRaw += dRaw
cZone += dZone
cTrack += dTrack
cEvent += dEvent
cPlan += dPlan
cBars += 1
int cTotal = cRaw + cZone + cTrack + cEvent + cPlan

plot(cTotal, "TOTAL diff (must stay 0)", color = cTotal == 0 ? color.green : color.red, linewidth = 2)
plot(cRaw,   "Raw diff",   display = display.data_window)
plot(cZone,  "Zone diff",  display = display.data_window)
plot(cTrack, "Track diff", display = display.data_window)
plot(cEvent, "Event diff", display = display.data_window)
plot(cPlan,  "Plan diff",  display = display.data_window)
plot(nt9,    "Tracks /9",  display = display.data_window)
plot(e9.trackSeq, "trackSeq /9", display = display.data_window)

if barstate.islast
    label.new(bar_index, 0, "Parity 9 vs 10\nBars: " + str.tostring(cBars) +
         "\nRaw: " + str.tostring(cRaw) + "  Zone: " + str.tostring(cZone) +
         "\nTrack: " + str.tostring(cTrack) + "  Event: " + str.tostring(cEvent) +
         "\nPlan: " + str.tostring(cPlan) +
         "\nTOTAL: " + str.tostring(cTotal) + (cTotal == 0 ? "  → PASS" : "  → FAIL"),
         style = label.style_label_left, color = cTotal == 0 ? color.green : color.red, textcolor = color.white)

// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  Long-Term Double / Triple Top Bottom XAU (LTB-1)  —  1時間・4時間・日足のダブル / トリプル トップ・ボトム検知（上位足の Zone 候補の目視検証用）
//
//  参照元: DoubleTripleTopBottomXAU.pine (DTB-3、5分足のエントリータイミング用。このファイルからは変更しない)。
//    状態遷移 (山・谷の基準 → 各基準 ① 終値の無効化 → ② 反転待ち → ③ 接近 → ④ 最低離れ幅 → 終了) と比較演算子・EPS・基準の処理順
//    (新しい基準から古い基準へ) を引き継ぎ、「判定する足」と「本数の単位」を各対象時間足へ変えた。
//
//  ■ 計算する場所【旧版との構造差】
//    旧版: 5分足チャートで、request.security で届いた上位足の高安を積み上げて山・谷を作り、接近・反転・離隔・無効化は 5分足で判定。
//    本版: 時間足ごとに独立した検知器を request.security(…, "60" / "240" / "D", f_ltCore(…)) の中に持ち、その時間足の確定 OHLC を
//          その時間足の履歴順に 1 本ずつ処理する（基準・接近・反転待ち・無効化・再離隔・終了・本数のすべてがその時間足）。
//          状態は f_ltCore の var（呼び出しごとに別 = 1時間・4時間・日足で共有しない）。チャートの先頭足・bar_index・表示範囲は使わない。
//          5分足など表示チャートの足の陰線 / 陽線・ヒゲは判定に使わない。チャート側は届いたイベントを描くだけ。
//
//  ■ 確定した結果がチャートへ届くタイミング
//    ・チャート足 < 対象時間足 (例 5分足チャートの 1時間検知): 対象時間足の中で計算した結果を 1 本ずらし ([1]、lookahead_on) で受け取る。
//      対象足 k の結果は、その足が確定した後 = 対象足 k + 1 に入った最初のチャート足で届く（形成中の対象足の結果は使わない）。
//    ・チャート足 == 対象時間足 (1時間足チャートの 1時間検知): 同じ足の結果を、その足の確定時に反映する（1 本遅れにしない）。
//    ・チャート側は確定したチャート足でだけ処理する。届いた結果は「対象足の開始時刻」で 1 回だけ取り込む（同じ値を何度受け取っても
//      状態更新・ラベルを重複させない）。直前 2 本分の結果を送り、欠落した対象足があれば表で数える。
//    ・検知ラベルは結果を受け取ったチャート足に出し、ツールチップに元の判定足 (対象時間足) の開始〜終了時刻を書く。
//    ・対応チャート: 時間ベースの 1時間足以下 (秒・分・1時間)。それより大きい足・ティック / レンコ等では計算せず、表で切替を案内する。
//
//  ■ 検知ルール (対象時間足ごと。トップで説明、ボトムは上下反転)
//    ・基準 = 左右 N 本の高値より厳密に高い山 (同値は基準にしない)。右側 N 本目の確定足で登録。その足では接近を見ず、次の対象足から監視。
//    ・登録時の最低離れ幅 = 右側の確認足 N 本の安値で判定 (旧版の「上位足を受け取った 5分足の高安を加える」処理はない)。
//    ・各対象足で、新しい基準から順に: ① 終値 > H + buffer で無効化 (ヒゲ・ちょうどは許容。反転より優先)
//      ② 反転待ち中: 最初の陰線で検知 / 期限 (接近足 = 0 本目、反転待ちの本数目まで) を過ぎたら期限切れ (接近 1 回に数えたまま)
//      ③ 最低離れ幅を満たした後、高値 ≥ H − buffer で接近 (2 回目 / 3 回目)。接近足が陰線ならその足で検知、違えば反転待ち
//      ④ 足の終わりに最低離れ幅 (安値 ≤ H − 最低離れ幅) を更新 (接近足自身の値幅では再離隔にしない)
//    ・3 回目の接近が検知または期限切れで終わったら基準を終了。ネックライン抜けは待たない (早期検知)。
//    ・持ち込まないもの: 5分足用の最大離れ幅 (DTB-3)・5分足の基準・15分足の基準・重複統合・時間上限・その他のフィルター。
//
//  ■ 表示 (#番号 = 時間足ごとの基準 ID。表示 OFF・描画を残す基準数は描画だけを変え、検知器には渡さない)
//    ・灰色「基準 1時間#ID 山 / 谷 価格」: 1 回目 = 実際の山・谷の足 (中央足の time) と価格。
//    ・灰色「1時間#ID 確定」と点線: Pivot の右側 N 本目の足 (この足の確定で利用可能)。
//    ・◆「1時間#ID 2回目 / 3回目」: 接近を数えた対象足 (開始時刻) とその高値 / 安値。下の行が結果。基準から破線。
//      基準・確定・接近の注記は、その情報が届いた後に過去の位置へ描く注記 (その位置でシグナルが出たという意味ではない)。
//    ・「ダブルトップ 1時間」など: 検知結果を受け取ったチャート足。接近足と判定足が違えば「接近から n 本目」と点線で示す。
//  検証: tests/ltb_sim.py (下の LTB Logic / LTB Chart 区間をそのまま Python へ変換して実行)。TradingView での実行は未確認。
// ============================================================================

//@version=5
indicator("Long-Term Double / Triple Top Bottom XAU", shorttitle = "LTB-XAU", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// 01. INPUTS
// ============================================================================
var string G_DV = "1 · 検知 (各対象時間足の確定足・本数で判定。目視検証の開始値)"
dvPiv  = input.int(4, "山・谷の前後の本数", minval = 1, group = G_DV,
     tooltip = "左右この本数の足より高値が厳密に高い足を山、安値が厳密に低い足を谷にする (同値は山・谷にしない)。全対象時間足で共通。本数は各対象時間足の足。")
dvWait = input.int(3, "反転待ちの本数", minval = 0, group = G_DV,
     tooltip = "接近した対象足 = 0 本目。その後この本数目の対象足まで、最初の陰線 (トップ) / 陽線 (ボトム) の確定を待つ。各対象時間足の本数で数える。")
dvB1 = input.float(5.0,  "1時間足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD1 = input.float(15.0, "1時間足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvB4 = input.float(10.0, "4時間足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvD4 = input.float(30.0, "4時間足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV)
dvBD = input.float(20.0, "日足 · buffer ($)", minval = 0.0, step = 0.5, group = G_DV)
dvDD = input.float(60.0, "日足 · 最低離れ幅 ($)", minval = 0.0, step = 0.5, group = G_DV,
     tooltip = "検証開始用の仮初期値 (採用確定値ではない)。時間足ごとに buffer と最低離れ幅を独立に設定。最大離れ幅は持たない。")

var string G_DS = "2 · 表示 (描画だけ。OFF でも検知器は動き続ける)"
dsTf1    = input.bool(true,  "1時間足の基準を表示", group = G_DS)
dsTf4    = input.bool(false, "4時間足の基準を表示", group = G_DS)
dsTfD    = input.bool(false, "日足の基準を表示", group = G_DS,
     tooltip = "OFF: その時間足の基準・接近・検知を描かない (検知器の計算と状態は変わらない)。")
dsAllB   = input.bool(false, "接近がない基準の注記も表示", group = G_DS,
     tooltip = "OFF: 2 回目の接近を数えた基準だけ、基準位置・確定足の注記を描く。ON: 登録を受け取った時点ですべての基準の注記を描く。")
dsMaxGrp = input.int(40, "描画を残す基準の最大数", minval = 1, maxval = 80, group = G_DS,
     tooltip = "基準ごとの描画 (注記・接近点・線・検知ラベル) を、最後に描いた順で古いものから削除する。検知器の有効な基準は削除しない。")
dsTable  = input.bool(true, "状態表を表示", group = G_DS)
dsTz     = input.string("Asia/Tokyo", "ラベルの時刻のタイムゾーン", group = G_DS)

// ============================================================================
// 02. CHART SUPPORT
// ============================================================================
// 時間ベースの 1時間足以下だけ対応 (それより大きい足では 1時間足のイベントを取りこぼすため計算しない)
int  ltChSec   = timeframe.in_seconds()
bool ltTimeBar = not timeframe.isticks and not (chart.is_renko or chart.is_kagi or chart.is_pnf or chart.is_linebreak or chart.is_range)
bool ltChartOk = ltTimeBar and ltChSec <= 3600
// チャート足 == 対象時間足なら同じ足の結果 (off 0)、それ以外は 1 本ずらした確定済みの結果 (off 1)
int  ltOff1 = ltChSec == 3600 ? 0 : 1
string ltTk = ticker.standard(syminfo.tickerid)     // 平均足などのチャート種別でも通常の OHLC で判定する

// 表示専用: 同じ足に複数の検知ラベルを縦にずらす幅 (検知には使わない)
float dsAtr = ta.atr(14)

// ============================================================================
// 03. LOGIC (対象時間足の中で実行する検知器)
// ============================================================================
// ==== LTB Logic (begin) ======================================================
//  (この区間は tests/ltb_sim.py が tests/acc_pine.py の変換器で Python へ機械変換して実行する)
float EPS = 1e-7     // 浮動小数の誤差だけ吸収 (USD) — 旧版と同一

// ダブル / トリプルの基準 (山 = トップ / 谷 = ボトム)。本数はすべて対象時間足の bar_index
type LtBase
    int   id
    int   side                // -1 = トップ (H) / 1 = ボトム (L)
    float lvl
    int   pvT                 // 実際の山・谷の足 (中央足) の time
    int   cfT                 // Pivot の右側 N 本目 (確定足) の time
    int   cfTc                // 確定足の time_close (この時刻から利用可能)
    int   aBar                // 登録した対象足 (この足では接近を見ない)
    bool  away                // 最低離れ幅を満たしている (次の接近を数えられる)
    int   cnt      = 1        // 接近回数 (山・谷そのものが 1 回目)
    bool  waiting  = false    // 接近後の反転待ち
    int   appBar
    int   appT                // 最新の接近足の time / time_close / 高値 (トップ)・安値 (ボトム)
    int   appTc
    float appP
    int   waitEnd             // 反転待ちの最後の足

// 対象時間足 1 つの検知器 (状態はこの中だけ。時間足どうしで共有しない)
type LtTf
    int   k                   // 0 = 1時間 / 1 = 4時間 / 2 = 日足
    int   piv
    int   wait
    float buf
    float dist
    array<float>  hs          // 直近 (2N + 1) 本の高値・安値・time
    array<float>  ls
    array<int>    ts
    array<LtBase> bases
    int   seq      = 0        // 基準 ID (時間足ごと)
    int   prevT               // 前に処理した足の time (欠落の検出用)

ltNew(int k, int piv, int wait, float buf, float dist) =>
    LtTf.new(k, piv, wait, buf, dist, array.new_float(), array.new_float(), array.new_int(), array.new<LtBase>())

// イベント (フィールドは ","、イベントは ";" 区切り)。基準の情報を含め、チャート側だけで描けるようにする
//   R,id,side,lvl,pvT,cfT,cfTc                                   登録
//   A,(同上),cnt,appT,appTc,appP,st                              接近 (st 0 反転待ち / 1 接近足で検知 / 2 期限切れ (反転待ち 0 本))
//   D,(同上),cnt,appT,appTc,appP,dT,dTc,lag,dH,dL                検知 (dT / dTc = 判定足、lag = 接近足からの本数)
//   X,id   期限切れ / V,id,waiting  終値の無効化 / E,id  基準の終了
ltEvB(LtBase g, string ty) =>
    ";" + ty + "," + str.tostring(g.id) + "," + str.tostring(g.side) + "," + str.tostring(g.lvl, "#.########") + "," +
         str.tostring(g.pvT) + "," + str.tostring(g.cfT) + "," + str.tostring(g.cfTc)

ltEvA(LtBase g, string ty) =>
    ltEvB(g, ty) + "," + str.tostring(g.cnt) + "," + str.tostring(g.appT) + "," + str.tostring(g.appTc) + "," +
         str.tostring(g.appP, "#.########")

// 対象足 1 本 (確定 OHLC) の処理。返り値 = その足のブロック "B,time,time_close,前の足の time,有効な基準数,bar_index" + イベント
ltStep(LtTf S, float o, float h, float l, float c, int t, int tc, int bi) =>
    string ev = ""
    int W = 2 * S.piv + 1
    array.push(S.hs, h)
    array.push(S.ls, l)
    array.push(S.ts, t)
    if array.size(S.hs) > W
        array.shift(S.hs)
        array.shift(S.ls)
        array.shift(S.ts)
    // 山・谷の基準: 右側 N 本目のこの足で中央足が確定。登録時の最低離れ幅は右側の確認足 N 本の値動きだけで判定
    if array.size(S.hs) == W
        float mh = array.get(S.hs, S.piv)
        float ml = array.get(S.ls, S.piv)
        bool  isH = true
        bool  isL = true
        float rMin = na
        float rMax = na
        for j = 0 to W - 1
            if j != S.piv
                isH := isH and mh > array.get(S.hs, j)
                isL := isL and ml < array.get(S.ls, j)
            if j > S.piv
                rMin := na(rMin) ? array.get(S.ls, j) : math.min(rMin, array.get(S.ls, j))
                rMax := na(rMax) ? array.get(S.hs, j) : math.max(rMax, array.get(S.hs, j))
        int pvT = array.get(S.ts, S.piv)
        if isH
            S.seq += 1
            LtBase gh = LtBase.new(S.seq, -1, mh, pvT, t, tc, bi, mh - rMin >= S.dist - EPS)
            array.push(S.bases, gh)
            ev += ltEvB(gh, "R")
        if isL
            S.seq += 1
            LtBase gl = LtBase.new(S.seq, 1, ml, pvT, t, tc, bi, rMax - ml >= S.dist - EPS)
            array.push(S.bases, gl)
            ev += ltEvB(gl, "R")
    // 各基準 (新しい基準から): ① 無効化 → ② 反転待ち → ③ 接近 → ④ 最低離れ幅。登録した足は飛ばす
    int ng = array.size(S.bases)
    if ng > 0
        for i = ng - 1 to 0
            LtBase g = array.get(S.bases, i)
            if g.aBar < bi
                bool top = g.side == -1
                bool fin = false
                // ① 無効化 (終値が H + B を超える / L − B を下回る。ヒゲ・ちょうどは許容)。反転より優先
                if top ? c > g.lvl + S.buf + EPS : c < g.lvl - S.buf - EPS
                    fin := true
                    ev += ";V," + str.tostring(g.id) + "," + (g.waiting ? "1" : "0")
                else
                    bool det = false
                    bool rev = top ? c < o : c > o
                    if g.waiting
                        // ② 反転待ち: 最初の陰線 (陽線) で検知、最後の足を過ぎたら見送り (接近 1 回に数えたまま)
                        if rev
                            det := true
                            g.waiting := false
                        else if bi >= g.waitEnd
                            g.waiting := false
                            ev += ";X," + str.tostring(g.id)
                        fin := not g.waiting and g.cnt >= 3
                    else if g.away and g.cnt < 3 and (top ? h >= g.lvl - S.buf - EPS : l <= g.lvl + S.buf + EPS)
                        // ③ 接近 (2 回目・3 回目)。接近足が陰線 (陽線) ならこの足で検知、違えば反転待ち
                        g.cnt    += 1
                        g.away   := false
                        g.appBar := bi
                        g.appT   := t
                        g.appTc  := tc
                        g.appP   := top ? h : l
                        g.waitEnd := bi + S.wait
                        if rev
                            det := true
                        else if S.wait > 0
                            g.waiting := true
                        ev += ltEvA(g, "A") + "," + (rev ? "1" : S.wait > 0 ? "0" : "2")
                        fin := not g.waiting and g.cnt >= 3
                    if det
                        ev += ltEvA(g, "D") + "," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(bi - g.appBar) + "," +
                             str.tostring(h, "#.########") + "," + str.tostring(l, "#.########")
                    // ④ 最低離れ幅 (この足の終わりに更新。次の接近は次の足から)。接近足自身の値幅は数えない
                    if not fin and (na(g.appBar) or g.appBar != bi) and (top ? l <= g.lvl - S.dist + EPS : h >= g.lvl + S.dist - EPS)
                        g.away := true
                if fin
                    array.remove(S.bases, i)
                    ev += ";E," + str.tostring(g.id)
    string hd = "B," + str.tostring(t) + "," + str.tostring(tc) + "," + str.tostring(S.prevT) + "," + str.tostring(array.size(S.bases)) +
         "," + str.tostring(bi)
    S.prevT := t
    hd + ev
// ==== LTB Logic (end) ========================================================

// ---- 対象時間足の中での計算 (request.security の中で、その時間足の履歴順に 1 本ずつ) ------------------------------
// 検知器はこの関数の var (呼び出しごとに別の状態)。返すのは「直前の足 + この足」のブロック文字列を off 本ずらしたもの:
//   off = 1 (チャート足 < 対象時間足): 確定済みの足 (k − 1、k − 2) の結果だけ。形成中の足 k の結果は返さない
//   off = 0 (チャート足 == 対象時間足): この足 (k) と直前の足 (k − 1) の結果。チャート側はその足の確定時にだけ取り込む
f_ltCore(int k, float buf, float dist, bool on, int off) =>
    var LtTf S = ltNew(k, dvPiv, dvWait, buf, dist)
    var string prevBlk = ""
    string blk = ""
    if on
        blk := ltStep(S, open, high, low, close, time, time_close, bar_index)
    string out = prevBlk == "" ? blk : blk == "" ? prevBlk : prevBlk + ";" + blk
    prevBlk := blk
    out[off]

string ltPk1 = request.security(ltTk, "60",  f_ltCore(0, dvB1, dvD1, ltChartOk, ltOff1), lookahead = barmerge.lookahead_on)
string ltPk4 = request.security(ltTk, "240", f_ltCore(1, dvB4, dvD4, ltChartOk, 1), lookahead = barmerge.lookahead_on)
string ltPkD = request.security(ltTk, "D",   f_ltCore(2, dvBD, dvDD, ltChartOk, 1), lookahead = barmerge.lookahead_on)

// ============================================================================
// 04. CHART (受け取った結果の取り込みと描画。判定はしない)
// ============================================================================
// ==== LTB Chart (begin) ======================================================
//  (この区間も tests/ltb_sim.py が機械変換して実行する)
// 描画専用: 基準 1 個の表示 (時間足 k と ID で識別。検知器の状態は持たない)
type LtDr
    int    k
    int    id
    int    side
    float  lvl
    int    pvT
    int    cfT
    int    cfTc
    bool   shown    = false   // 描画を保持している
    array<label> lbs
    array<line>  lns
    label  apLb               // 最新の接近マーカー (結果の表示を更新する)
    string apTx
    int    apT                // 最新の接近足の time / time_close / 高値・安値 / 回数
    int    apTc
    float  apP
    int    apCnt

var array<LtDr>   ltDrs   = array.new<LtDr>()       // 描画に使う基準 (終了イベントで外す)
var array<LtDr>   ltDrQ   = array.new<LtDr>()       // 描画を保持している基準 (最後に描いた順)
var array<int>    ltLastT = array.new_int(3)        // 時間足ごとに最後に取り込んだ対象足の time (重複取り込みの防止)
var array<string> ltLastPk = array.new_string(3, "")
var array<int>    ltLastTc = array.new_int(3)       // 最後に取り込んだ対象足の time_close
var array<int>    ltNAct  = array.new_int(3)        // 最後に取り込んだ対象足の後の有効な基準数 (検知器の値)
var array<int>    ltNBlk  = array.new_int(3, 0)     // 取り込んだ対象足の数
var array<int>    ltNGap  = array.new_int(3, 0)     // 取り込めなかった対象足の数 (前の足の time が合わない)
var array<int>    ltNDet  = array.new_int(3, 0)     // 受け取った検知の数 (表示 ON / OFF に関係なく数える)
var array<int>    ltNApp  = array.new_int(3, 0)     // 受け取った接近の数
var array<int>    ltStk   = array.new_int(2, 0)     // この足で描いたトップ / ボトム検知ラベルの数 (縦に並べる)

ltTfJa(int k) =>
    k == 0 ? "1時間" : k == 1 ? "4時間" : "日足"

ltDsOn(int k) =>
    k == 0 ? dsTf1 : k == 1 ? dsTf4 : dsTfD

ltTm(int t) =>
    str.format_time(t, "yyyy/MM/dd HH:mm", dsTz)

ltNum(array<string> f, int i) =>
    str.tonumber(array.get(f, i))

ltInt(array<string> f, int i) =>
    int(str.tonumber(array.get(f, i)))

ltBaseTx(LtDr r) =>
    "基準 " + ltTfJa(r.k) + "#" + str.tostring(r.id) + " " + (r.side == -1 ? "山 " : "谷 ") + str.tostring(r.lvl, "#.##")

// 描画の保持: 初めてなら基準位置・確定足の注記を描いて末尾へ、既に保持していれば末尾へ移す。上限を超えたら古い描画を削除
//  (削除するのは描画オブジェクトだけ。検知器の状態・ltDrs には触れない)
ltGrpOpen(LtDr r) =>
    if r.shown
        int n  = array.size(ltDrQ)
        int ix = -1
        if n > 0
            for i = 0 to n - 1
                LtDr q = array.get(ltDrQ, i)
                if ix < 0 and q.k == r.k and q.id == r.id
                    ix := i
        if ix >= 0
            array.remove(ltDrQ, ix)
        array.push(ltDrQ, r)
    else
        bool top = r.side == -1
        r.shown := true
        r.lbs   := array.new<label>()
        r.lns   := array.new<line>()
        r.apLb  := na
        array.push(r.lbs, label.new(r.pvT, r.lvl, ltBaseTx(r), xloc = xloc.bar_time,
             style = top ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 55), textcolor = color.white,
             size = size.tiny, tooltip = ltBaseTx(r) + "\n1 回目 (実際の" + (top ? "山" : "谷") + "の" + ltTfJa(r.k) + "足) " + ltTm(r.pvT) +
             "\nPivot 確定足 " + ltTm(r.cfT) + "〜" + ltTm(r.cfTc) + " (この時刻から利用可能)" +
             "\n(基準が利用可能になった後に過去の位置へ描いた注記。この足のシグナルではない)"))
        array.push(r.lbs, label.new(r.cfT, r.lvl, ltTfJa(r.k) + "#" + str.tostring(r.id) + " 確定", xloc = xloc.bar_time,
             style = label.style_label_left, color = color.new(color.gray, 75), textcolor = color.white, size = size.tiny,
             tooltip = ltBaseTx(r) + "\nPivot の右側 " + str.tostring(dvPiv) + " 本目の" + ltTfJa(r.k) + "足 " + ltTm(r.cfT) + "〜" +
             ltTm(r.cfTc) + "\nこの足の確定で利用可能。監視は次の" + ltTfJa(r.k) + "足から"))
        array.push(r.lns, line.new(r.pvT, r.lvl, r.cfT, r.lvl, xloc = xloc.bar_time, color = color.new(color.gray, 40),
             style = line.style_dotted, width = 1))
        array.push(ltDrQ, r)
        while array.size(ltDrQ) > dsMaxGrp
            LtDr o = array.shift(ltDrQ)
            int nl = array.size(o.lbs)
            if nl > 0
                for j = 0 to nl - 1
                    label.delete(array.get(o.lbs, j))
            int nn = array.size(o.lns)
            if nn > 0
                for j = 0 to nn - 1
                    line.delete(array.get(o.lns, j))
            o.shown := false
            o.apLb  := na
    r.shown

// 接近マーカー (接近を数えた対象足の開始時刻・その足の高値 / 安値) と、基準の山・谷からの線 (保持済みの apT / apP / apCnt から)
ltAppMk(LtDr r, string st) =>
    bool top = r.side == -1
    r.apTx := ltTfJa(r.k) + "#" + str.tostring(r.id) + " " + str.tostring(r.apCnt) + "回目"
    r.apLb := label.new(r.apT, r.apP, r.apTx + "\n" + st, xloc = xloc.bar_time, style = label.style_diamond,
         color = top ? color.new(color.red, 0) : color.new(color.green, 0), textcolor = top ? color.red : color.green, size = size.tiny,
         tooltip = ltBaseTx(r) + "\n" + str.tostring(r.apCnt) + " 回目の接近 (" + ltTfJa(r.k) + "足) " + ltTm(r.apT) + "〜" + ltTm(r.apTc) +
         (top ? " 高値 " : " 安値 ") + str.tostring(r.apP, "#.##") + "\n(接近足の確定後に描いた注記)")
    array.push(r.lbs, r.apLb)
    array.push(r.lns, line.new(r.pvT, r.lvl, r.apT, r.apP, xloc = xloc.bar_time, color = top ? color.new(color.red, 30) :
         color.new(color.green, 30), style = line.style_dashed, width = 1))
    r.shown

// 接近マーカーの結果表示 (描画を保持していて、その接近のマーカーがある場合だけ)
ltStat(LtDr r, string st) =>
    if r.shown and not na(r.apLb)
        label.set_text(r.apLb, r.apTx + "\n" + st)
    r.shown

// 描画に使う基準を探す (無ければ -1)
ltFind(int k, int id) =>
    int ix = -1
    int n = array.size(ltDrs)
    if n > 0
        for i = 0 to n - 1
            LtDr q = array.get(ltDrs, i)
            if ix < 0 and q.k == k and q.id == id
                ix := i
    ix

// イベントの基準情報から描画用の基準を取得 (チャートの読み込み開始より前に登録された基準もここで作る)
ltRec(int k, array<string> f) =>
    int ix = ltFind(k, ltInt(f, 1))
    LtDr r = na
    if ix >= 0
        r := array.get(ltDrs, ix)
    else
        r := LtDr.new(k, ltInt(f, 1), ltInt(f, 2), ltNum(f, 3), ltInt(f, 4), ltInt(f, 5), ltInt(f, 6))
        array.push(ltDrs, r)
    r

ltSetApp(LtDr r, array<string> f) =>
    r.apCnt := ltInt(f, 7)
    r.apT   := ltInt(f, 8)
    r.apTc  := ltInt(f, 9)
    r.apP   := ltNum(f, 10)
    r.shown

// 検知ラベル (結果を受け取ったチャート足)。描画上限で描画を失った基準は基準・確定の注記から描き直し、その検知に対応する接近
//  (最新の接近) のマーカーと線も作り直す。描画が残っていれば作り直さない (二重作成しない)
ltDet(LtDr r, array<string> f) =>
    bool lost = not r.shown
    ltGrpOpen(r)
    if lost
        ltAppMk(r, "検知")
    bool   top = r.side == -1
    int    cnt = r.apCnt
    int    dT  = ltInt(f, 11)
    int    dTc = ltInt(f, 12)
    int    lag = ltInt(f, 13)
    int    sk  = top ? array.get(ltStk, 0) : array.get(ltStk, 1)
    float  of  = nz(dsAtr, high - low) * 0.9
    float  y   = top ? ltNum(f, 14) + sk * of : ltNum(f, 15) - sk * of
    string nm  = (cnt == 2 ? "ダブル" : "トリプル") + (top ? "トップ" : "ボトム") + " " + ltTfJa(r.k)
    string lg  = lag == 0 ? "接近足で検知" : "接近から " + str.tostring(lag) + " 本目で検知"
    array.push(r.lbs, label.new(time, y, nm + "\n#" + str.tostring(r.id) + " " + str.tostring(cnt) + "回目 · " + lg, xloc = xloc.bar_time,
         style = top ? label.style_label_down : label.style_label_up, color = top ? color.new(color.red, 15) : color.new(color.green, 15),
         textcolor = color.white, size = size.small,
         tooltip = nm + " (" + ltBaseTx(r) + ")\n1 回目 " + ltTm(r.pvT) + " / Pivot 確定足 " + ltTm(r.cfT) + "〜" + ltTm(r.cfTc) +
         "\n" + str.tostring(cnt) + " 回目の接近足 " + ltTm(r.apT) + "〜" + ltTm(r.apTc) + (top ? " 高値 " : " 安値 ") + str.tostring(r.apP, "#.##") +
         "\n反転の判定足 (" + ltTfJa(r.k) + "足) " + ltTm(dT) + "〜" + ltTm(dTc) + " (" + lg + ")" +
         "\nこのチャート足で結果を受信 " + ltTm(time) + " (判定足の確定後)"))
    if lag > 0
        array.push(r.lns, line.new(r.apT, r.apP, time, y, xloc = xloc.bar_time, color = color.new(color.gray, 30),
             style = line.style_dotted, width = 1))
    if top
        array.set(ltStk, 0, sk + 1)
    else
        array.set(ltStk, 1, sk + 1)
    ltStat(r, "検知")

// イベント 1 件 (取り込むブロックの中だけ)。数は表示 ON / OFF に関係なく数え、描画は表示 ON の時間足だけ
ltEvent(int k, array<string> f) =>
    string ty = array.get(f, 0)
    bool   on = ltDsOn(k)
    if ty == "A"
        array.set(ltNApp, k, array.get(ltNApp, k) + 1)
    if ty == "D"
        array.set(ltNDet, k, array.get(ltNDet, k) + 1)
    if on
        if ty == "R"
            if dsAllB
                ltGrpOpen(ltRec(k, f))
        else if ty == "A"
            LtDr r = ltRec(k, f)
            ltSetApp(r, f)
            int st = ltInt(f, 11)
            ltGrpOpen(r)
            ltAppMk(r, st == 1 ? "検知" : st == 0 ? "反転待ち" : "期限切れ")
        else if ty == "D"
            LtDr r = ltRec(k, f)
            if na(r.apCnt) or r.apCnt != ltInt(f, 7) or r.apT != ltInt(f, 8)
                // 接近を受け取る前 (チャートの読み込み開始前) の接近: 検知イベントの接近情報で描く
                ltSetApp(r, f)
                r.apLb := na
                if r.shown
                    ltAppMk(r, "検知")
            ltDet(r, f)
        else if ty == "X" or ty == "V" or ty == "E"
            int ix = ltFind(k, ltInt(f, 1))
            if ix >= 0
                LtDr r = array.get(ltDrs, ix)
                if ty == "X"
                    ltStat(r, "期限切れ")
                else if ty == "V"
                    if ltInt(f, 2) == 1
                        ltStat(r, "無効化")
                else
                    array.remove(ltDrs, ix)
    on

// 時間足 k の受信値: 対象足ごとのブロックを、まだ取り込んでいない対象足 (time が前回より新しい) だけ順に取り込む
ltRecv(int k, string pk) =>
    int nNew = 0
    if not na(pk) and pk != "" and pk != array.get(ltLastPk, k)
        array.set(ltLastPk, k, pk)
        array<string> evs = str.split(pk, ";")
        bool take = false
        int  n = array.size(evs)
        for i = 0 to n - 1
            string e = array.get(evs, i)
            if e != ""
                array<string> f = str.split(e, ",")
                if array.get(f, 0) == "B"
                    int sT = ltInt(f, 1)
                    int lT = array.get(ltLastT, k)
                    take := na(lT) or sT > lT
                    if take
                        int pT = ltInt(f, 3)
                        if not na(lT) and (na(pT) or pT != lT)
                            array.set(ltNGap, k, array.get(ltNGap, k) + 1)
                        array.set(ltLastT, k, sT)
                        array.set(ltLastTc, k, ltInt(f, 2))
                        array.set(ltNAct, k, ltInt(f, 4))
                        array.set(ltNBlk, k, array.get(ltNBlk, k) + 1)
                        nNew += 1
                else if take
                    ltEvent(k, f)
    nNew

if barstate.isconfirmed and ltChartOk
    array.set(ltStk, 0, 0)
    array.set(ltStk, 1, 0)
    ltRecv(0, ltPk1)
    ltRecv(1, ltPk4)
    ltRecv(2, ltPkD)
// ==== LTB Chart (end) ========================================================

// ============================================================================
// 05. TABLE
// ============================================================================
var table ltTb = table.new(position.top_right, 6, 5, border_width = 1)
f_cell(int c, int r, string tx, color bg) =>
    table.cell(ltTb, c, r, tx, text_color = color.white, bgcolor = bg, text_size = size.small)
    true

if barstate.islast and dsTable
    table.clear(ltTb, 0, 0, 5, 4)
    if not ltChartOk
        table.cell(ltTb, 0, 0, "LTB: このチャートには対応していません (" + timeframe.period + ")。\n1時間足以下の時間ベースのチャート (秒・分・1時間) へ切り替えてください。\n" +
             "1時間足より大きい足では 1時間足のイベントを取りこぼすため、計算していません。",
             text_color = color.white, bgcolor = color.new(color.maroon, 0), text_size = size.normal)
    else
        color hb = color.new(color.gray, 20)
        f_cell(0, 0, "時間足", hb)
        f_cell(1, 0, "表示", hb)
        f_cell(2, 0, "最後に取り込んだ確定足", hb)
        f_cell(3, 0, "有効な基準", hb)
        f_cell(4, 0, "受信 接近 / 検知", hb)
        f_cell(5, 0, "欠落した足", hb)
        for k = 0 to 2
            color bg = color.new(color.navy, 30)
            int lt = array.get(ltLastT, k)
            f_cell(0, k + 1, ltTfJa(k), bg)
            f_cell(1, k + 1, ltDsOn(k) ? "ON" : "OFF (計算は継続)", bg)
            f_cell(2, k + 1, na(lt) ? "—" : ltTm(lt) + "〜" + ltTm(array.get(ltLastTc, k)), bg)
            f_cell(3, k + 1, na(array.get(ltNAct, k)) ? "—" : str.tostring(array.get(ltNAct, k)), bg)
            f_cell(4, k + 1, str.tostring(array.get(ltNApp, k)) + " / " + str.tostring(array.get(ltNDet, k)), bg)
            f_cell(5, k + 1, str.tostring(array.get(ltNGap, k)), array.get(ltNGap, k) > 0 ? color.new(color.maroon, 0) : bg)

//
// ============================================================
//  MACD 単体モジュール (Indicator版 / オシレーターペイン)
// ============================================================
//  ・MACD関連だけを独立モジュール化。
//  ・後で 環境認識 / フィボ / FVG / 出来高 / EMA / 水平線 /
//    マクロ / Silver / ストキャス / RSI と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・request.security / ADX は使わない。
//  ・MACDは単体エントリーではなく、順張り許可・勢い確認・失速確認が主目的。
//  パターン:
//   A:Signalクロス B:ゼロ上下(方向F) C:ゼロクロス D:Hist拡大
//   E:Hist縮小(Exit警戒) F:Regular Div G:Hidden Div H:収束→拡散
// ============================================================

//@version=5
indicator(
     title          = "MACD Module",
     shorttitle     = "MACD-M",
     overlay        = false,
     max_bars_back  = 1000
 )

// ============================================================
//  ON/OFF
// ============================================================
grpSw = "ON/OFF"
useMACDModule             = input.bool(true, "MACDモジュール全体",     group = grpSw)
useMACDSignalCross        = input.bool(true, "A: Signalクロス",        group = grpSw)
useMACDZeroFilter         = input.bool(true, "B: ゼロ上下(方向F)",     group = grpSw)
useMACDZeroCross          = input.bool(true, "C: ゼロクロス",          group = grpSw)
useMACDHistExpansion      = input.bool(true, "D: Hist拡大",            group = grpSw)
useMACDHistShrink         = input.bool(true, "E: Hist縮小(Exit警戒)",  group = grpSw)
useMACDRegularDivergence  = input.bool(true, "F: Regular Divergence",  group = grpSw)
useMACDHiddenDivergence   = input.bool(true, "G: Hidden Divergence",   group = grpSw)
useMACDCompressionExpansion= input.bool(true,"H: 収束→拡散",          group = grpSw)

// ============================================================
//  MACD設定
// ============================================================
grpMACD = "MACD設定"
fastLen   = input.int(12, "Fast EMA",   minval = 1, group = grpMACD)
slowLen   = input.int(26, "Slow EMA",   minval = 1, group = grpMACD)
signalLen = input.int(9,  "Signal EMA", minval = 1, group = grpMACD)

// ============================================================
//  D: Hist拡大 / H: 収束→拡散 / 共通 パラメータ
// ============================================================
grpD = "D: Hist拡大"
histExpansionBars        = input.int(2, "拡大 連続本数", minval = 1, group = grpD)
useHistExpansionConsecutive = input.bool(false, "連続拡大を要求", group = grpD)

grpH = "H: 収束→拡散"
useATRNormalizedThreshold = input.bool(false, "収束しきい値をATR正規化", group = grpH)
atrLen                    = input.int(14, "ATR期間", minval = 1, group = grpH)
macdCompressionThreshold  = input.float(0.05, "収束しきい値 |hist|", minval = 0.0, step = 0.01, group = grpH)
compressionBars           = input.int(5, "収束 継続本数", minval = 1, group = grpH)

// ============================================================
//  F/G: Divergence パラメータ
// ============================================================
grpDiv = "Divergence"
divPivotLen = input.int(5,  "Pivot 長さ",       minval = 1, group = grpDiv)
divLookback = input.int(60, "Pivot 間 最大本数", minval = 1, group = grpDiv)

// ============================================================
//  共通フィルター
// ============================================================
grpFilt = "共通フィルター"
useMACDZeroDirectionFilter = input.bool(false, "ゼロ位置フィルター(line)", group = grpFilt)
useMACDHistDirectionFilter = input.bool(false, "Hist位置フィルター",       group = grpFilt)
useMACDSlopeFilter         = input.bool(false, "MACD傾きフィルター",       group = grpFilt)

// NoTrade (基本false / 後で拡張用)
grpNT = "NoTrade (拡張用)"
useMACDFlatNoTrade = input.bool(false, "横ばい(収束)時 NoTrade", group = grpNT)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showMACDLabels    = input.bool(true, "シグナルラベル",   group = grpDisp)
showMACDDebugTable= input.bool(true, "デバッグテーブル", group = grpDisp)
showMACDPanePlots = input.bool(true, "MACD/Signal/Hist 表示", group = grpDisp)

// ============================================================
//  MACD 計算
// ============================================================
[macdLine, macdSignal, macdHist] = ta.macd(close, fastLen, slowLen, signalLen)
float atr = ta.atr(atrLen)

bool mAct = useMACDModule

// 共通フィルター
f_dirOK(isBuy) =>
    bool z = not useMACDZeroDirectionFilter or (isBuy ? macdLine > 0 : macdLine < 0)
    bool h = not useMACDHistDirectionFilter or (isBuy ? macdHist > 0 : macdHist < 0)
    bool s = not useMACDSlopeFilter or (isBuy ? macdLine > macdLine[1] : macdLine < macdLine[1])
    z and h and s

// ============================================================
//  B: ゼロライン 上/下 (方向フィルター)
// ============================================================
bool macdAboveZero = macdLine > 0
bool macdBelowZero = macdLine < 0
bool allowLongByMACDZero  = mAct and (not useMACDZeroFilter or macdAboveZero)
bool allowShortByMACDZero = mAct and (not useMACDZeroFilter or macdBelowZero)

// ============================================================
//  A: MACD / Signal クロス
// ============================================================
bool macdBuyCrossSignal  = mAct and useMACDSignalCross and ta.crossover(macdLine, macdSignal)  and f_dirOK(true)
bool macdSellCrossSignal = mAct and useMACDSignalCross and ta.crossunder(macdLine, macdSignal) and f_dirOK(false)

// ============================================================
//  C: ゼロラインクロス
// ============================================================
bool macdBuyZeroCrossSignal  = mAct and useMACDZeroCross and ta.crossover(macdLine, 0)  and f_dirOK(true)
bool macdSellZeroCrossSignal = mAct and useMACDZeroCross and ta.crossunder(macdLine, 0) and f_dirOK(false)

// ============================================================
//  D: ヒストグラム拡大 (勢い確認)
// ============================================================
bool macdHistExpandingBull = macdHist > 0 and macdHist > macdHist[1]
bool macdHistExpandingBear = macdHist < 0 and macdHist < macdHist[1]
var int bullExpCount = 0
var int bearExpCount = 0
bullExpCount := macdHistExpandingBull ? bullExpCount + 1 : 0
bearExpCount := macdHistExpandingBear ? bearExpCount + 1 : 0
bool histBullOK = useHistExpansionConsecutive ? bullExpCount >= histExpansionBars : macdHistExpandingBull
bool histBearOK = useHistExpansionConsecutive ? bearExpCount >= histExpansionBars : macdHistExpandingBear
bool macdBuyHistExpansionSignal  = mAct and useMACDHistExpansion and histBullOK and f_dirOK(true)
bool macdSellHistExpansionSignal = mAct and useMACDHistExpansion and histBearOK and f_dirOK(false)

// ============================================================
//  E: ヒストグラム縮小 (Exit / 失速警戒)
// ============================================================
bool macdLongWeakening  = macdHist > 0 and macdHist < macdHist[1]
bool macdShortWeakening = macdHist < 0 and macdHist > macdHist[1]
bool macdExitLongWarning  = mAct and useMACDHistShrink and macdLongWeakening
bool macdExitShortWarning = mAct and useMACDHistShrink and macdShortWeakening

// ============================================================
//  F/G: Divergence (pivot ベース / macdLine 値で判定)
// ============================================================
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float macdAtPivot = macdLine[divPivotLen]

var float phPrev    = na
var float phLast    = na
var float mhPrev    = na
var float mhLast    = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float mlPrev    = na
var float mlLast    = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    mhPrev := mhLast
    phBarPrev := phBarLast
    phLast := pricePH
    mhLast := macdAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    mlPrev := mlLast
    plBarPrev := plBarLast
    plLast := pricePL
    mlLast := macdAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

// Regular: 価格HH+MACD LH=SELL / 価格LL+MACD HL=BUY
bool regSell = mAct and useMACDRegularDivergence and newPH and phInRange and phLast > phPrev and mhLast < mhPrev
bool regBuy  = mAct and useMACDRegularDivergence and newPL and plInRange and plLast < plPrev and mlLast > mlPrev
// Hidden: 価格HL(切上げ)+MACD切下げ=BUY / 価格LH(切下げ)+MACD切上げ=SELL
bool hidBuy  = mAct and useMACDHiddenDivergence and newPL and plInRange and plLast > plPrev and mlLast < mlPrev
bool hidSell = mAct and useMACDHiddenDivergence and newPH and phInRange and phLast < phPrev and mhLast > mhPrev

bool macdSellRegularDivSignal = regSell
bool macdBuyRegularDivSignal  = regBuy
bool macdBuyHiddenDivSignal   = hidBuy
bool macdSellHiddenDivSignal  = hidSell

// ============================================================
//  H: 収束 → 拡散 (レンジ後の初動)
// ============================================================
float compThresh = useATRNormalizedThreshold ? atr * macdCompressionThreshold : macdCompressionThreshold
var int compCount = 0
compCount := math.abs(macdHist) <= compThresh ? compCount + 1 : 0
bool macdCompression = mAct and useMACDCompressionExpansion and compCount >= compressionBars
// 収束直後の拡散 (前足まで収束 → 今足で拡大)
bool wasCompressed = macdCompression[1]
bool macdBuyExpansionFromCompression  = mAct and useMACDCompressionExpansion and wasCompressed and macdHist > 0 and macdHist > macdHist[1] and f_dirOK(true)
bool macdSellExpansionFromCompression = mAct and useMACDCompressionExpansion and wasCompressed and macdHist < 0 and macdHist < macdHist[1] and f_dirOK(false)

// ============================================================
//  Signal Type / Direction
//   優先: RegDiv(4) > HidDiv(5) > CompExp(6) > ZeroCross(2) >
//         SignalCross(1) > HistExp(3)
// ============================================================
bool anyReg    = regBuy or regSell
bool anyHid    = hidBuy or hidSell
bool anyComp   = macdBuyExpansionFromCompression or macdSellExpansionFromCompression
bool anyZeroX  = macdBuyZeroCrossSignal or macdSellZeroCrossSignal
bool anySigX   = macdBuyCrossSignal or macdSellCrossSignal
bool anyHistX  = macdBuyHistExpansionSignal or macdSellHistExpansionSignal

int macdSignalType = not mAct ? 0 :
                      anyReg  ? 4 :
                      anyHid  ? 5 :
                      anyComp ? 6 :
                      anyZeroX? 2 :
                      anySigX ? 1 :
                      anyHistX? 3 : 0

int macdDirection = not mAct ? 0 :
                     anyReg  ? (regBuy ? 1 : -1) :
                     anyHid  ? (hidBuy ? 1 : -1) :
                     anyComp ? (macdBuyExpansionFromCompression ? 1 : -1) :
                     anyZeroX? (macdBuyZeroCrossSignal ? 1 : -1) :
                     anySigX ? (macdBuyCrossSignal ? 1 : -1) :
                     anyHistX? (macdBuyHistExpansionSignal ? 1 : -1) : 0

// ============================================================
//  Rank
//   1 HistExp /2 SignalCross /3 ZeroCross・CompExp /4 Div /5 強合流
// ============================================================
bool anyDiv = anyReg or anyHid
bool rank5 = (anyComp and anyZeroX) or (anyDiv and anyHistX)
int macdRank = not mAct ? 0 :
                rank5 ? 5 :
                anyDiv ? 4 :
                (anyZeroX or anyComp) ? 3 :
                anySigX ? 2 :
                anyHistX ? 1 : 0

// ============================================================
//  接続用出力
// ============================================================
bool macdNoTrade = useMACDFlatNoTrade and macdCompression   // 基本false / 横ばい時のみ
bool allowLongByMACD  = useMACDModule and macdDirection == 1  and not macdNoTrade
bool allowShortByMACD = useMACDModule and macdDirection == -1 and not macdNoTrade

// ============================================================
//  表示 : MACD / Signal / Hist / ゼロライン
// ============================================================
hline(0, "Zero", color = color.new(color.gray, 40))
plot(showMACDPanePlots ? macdHist : na, "Histogram", color = macdHist >= 0 ? (macdHist >= macdHist[1] ? color.new(color.green, 0) : color.new(color.green, 60)) : (macdHist < macdHist[1] ? color.new(color.red, 0) : color.new(color.red, 60)), style = plot.style_columns)
plot(showMACDPanePlots ? macdLine : na, "MACD", color = color.new(color.blue, 0), linewidth = 2)
plot(showMACDPanePlots ? macdSignal : na, "Signal", color = color.new(color.orange, 0), linewidth = 1)

// Compression 背景
bgcolor(macdCompression ? color.new(color.gray, 85) : na, title = "Compression BG")

// ============================================================
//  表示 : ラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, macdLine, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.tiny)

if showMACDLabels
    if macdBuyCrossSignal
        f_mkLabel(true,  "X↑", color.new(color.green, 0))
    if macdSellCrossSignal
        f_mkLabel(false, "X↓", color.new(color.red, 0))
    if macdBuyZeroCrossSignal
        f_mkLabel(true,  "0↑", color.new(color.lime, 0))
    if macdSellZeroCrossSignal
        f_mkLabel(false, "0↓", color.new(color.fuchsia, 0))
    if macdBuyHistExpansionSignal
        f_mkLabel(true,  "H↑", color.new(color.teal, 0))
    if macdSellHistExpansionSignal
        f_mkLabel(false, "H↓", color.new(color.maroon, 0))
    if macdBuyRegularDivSignal
        f_mkLabel(true,  "Div↑", color.new(color.aqua, 0))
    if macdSellRegularDivSignal
        f_mkLabel(false, "Div↓", color.new(color.orange, 0))
    if macdBuyHiddenDivSignal
        f_mkLabel(true,  "HDiv↑", color.new(color.blue, 0))
    if macdSellHiddenDivSignal
        f_mkLabel(false, "HDiv↓", color.new(color.purple, 0))
    if macdBuyExpansionFromCompression
        f_mkLabel(true,  "Exp↑", color.new(color.green, 0))
    if macdSellExpansionFromCompression
        f_mkLabel(false, "Exp↓", color.new(color.red, 0))
    if macdExitLongWarning
        f_mkLabel(false, "ExitL", color.new(color.gray, 0))
    if macdExitShortWarning
        f_mkLabel(true,  "ExitS", color.new(color.gray, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "SignalX" : t == 2 ? "ZeroX" : t == 3 ? "HistExp" : t == 4 ? "RegDiv" : t == 5 ? "HidDiv" : t == 6 ? "CompExp" : "-"

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if showMACDDebugTable and barstate.islast
    string sDir = macdDirection == 1 ? "BUY" : macdDirection == -1 ? "SELL" : "-"
    string sExit = macdExitLongWarning ? "ExitL" : macdExitShortWarning ? "ExitS" : "-"
    table.cell(dbg, 0, 0, "MACD", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, macdNoTrade ? "NoTrade" : (macdDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = macdNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "MACD", text_color = color.white)
    table.cell(dbg, 1, 1, na(macdLine) ? "-" : str.tostring(macdLine, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 2, "Signal", text_color = color.white)
    table.cell(dbg, 1, 2, na(macdSignal) ? "-" : str.tostring(macdSignal, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 3, "Hist", text_color = color.white)
    table.cell(dbg, 1, 3, na(macdHist) ? "-" : str.tostring(macdHist, "#.###"), text_color = macdHist >= 0 ? color.lime : color.red)
    table.cell(dbg, 0, 4, "Signal Type", text_color = color.white)
    table.cell(dbg, 1, 4, f_typeStr(macdSignalType), text_color = color.white)
    table.cell(dbg, 0, 5, "Direction", text_color = color.white)
    table.cell(dbg, 1, 5, sDir, text_color = color.white)
    table.cell(dbg, 0, 6, "Rank", text_color = color.white)
    table.cell(dbg, 1, 6, str.tostring(macdRank), text_color = color.white)
    table.cell(dbg, 0, 7, "Compression", text_color = color.white)
    table.cell(dbg, 1, 7, macdCompression ? "Y" : "N", text_color = macdCompression ? color.yellow : color.white)
    table.cell(dbg, 0, 8, "Exit Warning", text_color = color.white)
    table.cell(dbg, 1, 8, sExit, text_color = color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(macdLine,   "macdLine",   display = display.data_window)
plot(macdSignal, "macdSignal", display = display.data_window)
plot(macdHist,   "macdHist",   display = display.data_window)
plot(macdAboveZero ? 1 : 0, "macdAboveZero", display = display.data_window)
plot(macdBelowZero ? 1 : 0, "macdBelowZero", display = display.data_window)
plot(macdSignalType, "macdSignalType", display = display.data_window)
plot(macdDirection,  "macdDirection",  display = display.data_window)
plot(macdRank,       "macdRank",       display = display.data_window)
plot(allowLongByMACD  ? 1 : 0, "allowLongByMACD",  display = display.data_window)
plot(allowShortByMACD ? 1 : 0, "allowShortByMACD", display = display.data_window)
plot(allowLongByMACDZero  ? 1 : 0, "allowLongByMACDZero",  display = display.data_window)
plot(allowShortByMACDZero ? 1 : 0, "allowShortByMACDZero", display = display.data_window)
plot(macdExitLongWarning  ? 1 : 0, "macdExitLongWarning",  display = display.data_window)
plot(macdExitShortWarning ? 1 : 0, "macdExitShortWarning", display = display.data_window)
plot(macdNoTrade ? 1 : 0, "macdNoTrade", display = display.data_window)
plot(macdHistExpandingBull ? 1 : 0, "macdHistExpandingBull", display = display.data_window)
plot(macdHistExpandingBear ? 1 : 0, "macdHistExpandingBear", display = display.data_window)
plot(macdLongWeakening  ? 1 : 0, "macdLongWeakening",  display = display.data_window)
plot(macdShortWeakening ? 1 : 0, "macdShortWeakening", display = display.data_window)
plot(macdBuyCrossSignal  ? 1 : 0, "macdBuyCrossSignal",  display = display.data_window)
plot(macdSellCrossSignal ? 1 : 0, "macdSellCrossSignal", display = display.data_window)
plot(macdBuyZeroCrossSignal  ? 1 : 0, "macdBuyZeroCrossSignal",  display = display.data_window)
plot(macdSellZeroCrossSignal ? 1 : 0, "macdSellZeroCrossSignal", display = display.data_window)
plot(macdBuyHistExpansionSignal  ? 1 : 0, "macdBuyHistExpansionSignal",  display = display.data_window)
plot(macdSellHistExpansionSignal ? 1 : 0, "macdSellHistExpansionSignal", display = display.data_window)
plot(macdBuyRegularDivSignal  ? 1 : 0, "macdBuyRegularDivSignal",  display = display.data_window)
plot(macdSellRegularDivSignal ? 1 : 0, "macdSellRegularDivSignal", display = display.data_window)
plot(macdBuyHiddenDivSignal   ? 1 : 0, "macdBuyHiddenDivSignal",   display = display.data_window)
plot(macdSellHiddenDivSignal  ? 1 : 0, "macdSellHiddenDivSignal",  display = display.data_window)
plot(macdCompression ? 1 : 0, "macdCompression", display = display.data_window)
plot(macdBuyExpansionFromCompression  ? 1 : 0, "macdBuyExpansionFromCompression",  display = display.data_window)
plot(macdSellExpansionFromCompression ? 1 : 0, "macdSellExpansionFromCompression", display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(macdBuyCrossSignal,  "MACD BUY Cross",  "{{ticker}} MACD Signalクロス BUY")
alertcondition(macdSellCrossSignal, "MACD SELL Cross", "{{ticker}} MACD Signalクロス SELL")
alertcondition(macdBuyZeroCrossSignal,  "MACD BUY ZeroX",  "{{ticker}} MACD ゼロクロス BUY")
alertcondition(macdSellZeroCrossSignal, "MACD SELL ZeroX", "{{ticker}} MACD ゼロクロス SELL")
alertcondition(macdBuyHistExpansionSignal,  "MACD BUY HistExp",  "{{ticker}} MACD Hist拡大 BUY")
alertcondition(macdSellHistExpansionSignal, "MACD SELL HistExp", "{{ticker}} MACD Hist拡大 SELL")
alertcondition(macdBuyRegularDivSignal,  "MACD BUY RegDiv",  "{{ticker}} MACD Regular Div BUY")
alertcondition(macdSellRegularDivSignal, "MACD SELL RegDiv", "{{ticker}} MACD Regular Div SELL")
alertcondition(macdBuyHiddenDivSignal,  "MACD BUY HidDiv",  "{{ticker}} MACD Hidden Div BUY")
alertcondition(macdSellHiddenDivSignal, "MACD SELL HidDiv", "{{ticker}} MACD Hidden Div SELL")
alertcondition(macdBuyExpansionFromCompression,  "MACD BUY Expansion",  "{{ticker}} MACD 収束→拡散 BUY")
alertcondition(macdSellExpansionFromCompression, "MACD SELL Expansion", "{{ticker}} MACD 収束→拡散 SELL")
alertcondition(allowLongByMACD,  "Allow Long MACD",  "{{ticker}} MACD ロング許可")
alertcondition(allowShortByMACD, "Allow Short MACD", "{{ticker}} MACD ショート許可")
alertcondition(macdExitLongWarning,  "MACD Exit Long",  "{{ticker}} MACD ロング失速警戒")
alertcondition(macdExitShortWarning, "MACD Exit Short", "{{ticker}} MACD ショート失速警戒")

    r.sideFlipAttemptCounts                     := array.new_int(0)
    r.sideInverseAttemptCounts                  := array.new_int(0)
    r.sideLastFlipConfirmSeqs                   := array.new_int(0)
    r.sideEffectiveBottoms                      := array.new_float(0)
    r.sideEffectiveTops                         := array.new_float(0)
    r.sideReferencePrices                       := array.new_float(0)
    r.sideCCounts                               := array.new_int(0)
    r.sideHCounts                               := array.new_int(0)
    r.sideDensities                             := array.new_int(0)
    r.sideBaseStrongFlags                       := array.new_bool(0)
    r.sideHasNonPsychRootFlags                  := array.new_bool(0)
    r.sideIsBroadContextFlags                   := array.new_bool(0)
    r.sideEligibleFlags                         := array.new_bool(0)
    r.sideCategoryMasks                         := array.new_int(0)
    r.sideHighMasks                             := array.new_int(0)
    r.sidePhaseSetPositions                     := array.new_int(0)
    r.sideArmedEffectiveBottomOrderPositions    := array.new_int(0)
    r.sideArmedEffectiveTopOrderPositions       := array.new_int(0)
    r.sideDormantRecoveryBottomOrderPositions   := array.new_int(0)
    r.sideDormantRecoveryTopOrderPositions      := array.new_int(0)
    r.sideBrokenSnapshotBottomOrderPositions    := array.new_int(0)
    r.sideBrokenSnapshotTopOrderPositions       := array.new_int(0)
    r.sideFlipSnapshotBottomOrderPositions      := array.new_int(0)
    r.sideFlipSnapshotTopOrderPositions         := array.new_int(0)
    r.corePruneRevisions                        := array.new_int(0)
    r.sideTouchStartSnapshotValidFlags          := array.new_bool(0)
    r.sideTouchStartSnapshotCoreIds             := array.new_int(0)
    r.sideTouchStartSnapshotGenerationIds       := array.new_int(0)

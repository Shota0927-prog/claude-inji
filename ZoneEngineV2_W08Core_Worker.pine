newCoreRegistryStoreRaw() =>
    CoreRegistryStore r = CoreRegistryStore.new()
    r.coreIds                                   := array.new_int(0)
    r.coreGenerationIds                         := array.new_int(0)
    r.coreZoneFreshFlags                        := array.new_bool(0)
    r.corePhysicalBottoms                       := array.new_float(0)
    r.corePhysicalTops                          := array.new_float(0)
    r.coreCreatedTimes                          := array.new_int(0)
    r.coreLastSeenTimes                         := array.new_int(0)
    r.coreDormantFlags                          := array.new_bool(0)
    r.coreSlotLiveFlags                         := array.new_bool(0)
    r.coreFreeSlots                             := array.new_int(0)
    r.coreLiveSlots                             := array.new_int(0)
    r.coreIdOrderSlots                          := array.new_int(0)
    r.coreIdToSlot                              := map.new<int, int>()
    r.touchMarkRingOwnerCoreIds                 := array.new_int(0)
    r.touchMarkRingHeads                        := array.new_int(0)
    r.touchMarkRingCounts                       := array.new_int(0)
    r.touchMarkBaseSeqs                         := array.new_int(0)
    r.touchMarkTimes                            := array.new_int(0)
    r.touchMarkSides                            := array.new_int(0)
    r.touchMarkContactBottoms                   := array.new_float(0)
    r.touchMarkContactTops                      := array.new_float(0)
    r.touchMarkCloseAtTouches                   := array.new_float(0)
    r.touchMarkGenerationIds                    := array.new_int(0)
    r.touchMarkIsNormalTouchFlags               := array.new_bool(0)
    r.touchMarkTouchNos                         := array.new_int(0)
    r.touchMarkWeakByDepthFlags                 := array.new_bool(0)
    r.touchMarkMaxDepthPcts                     := array.new_float(0)
    r.sideTouchCounts                           := array.new_int(0)
    r.sideWeakByTouchFlags                      := array.new_bool(0)
    r.sideWeakByDepthFlags                      := array.new_bool(0)
    r.sideMaxDepthPcts                          := array.new_float(0)
    r.sideFreshFlags                            := array.new_bool(0)
    r.sidePhases                                := array.new_int(0)
    r.sideGrades                                := array.new_int(0)
    r.sideCurrentTouchNos                       := array.new_int(0)
    r.sideUpcomingTouchNos                      := array.new_int(0)
    r.sideArmedFromSeqs                         := array.new_int(0)
    r.sideLastArmedRangeBottoms                 := array.new_float(0)

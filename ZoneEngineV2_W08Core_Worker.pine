export type W08Store
    array<int>  coreIntervalOrderData
    array<int>  coreIntervalTopOrderData
    array<int>  coreZoneOriginRootHeadNodeIndexes
    array<int>  coreZoneOriginRootTailNodeIndexes
    array<int>  coreZoneOriginRootCounts
    array<int>  coreZoneOriginRootNodeRootIds
    array<int>  coreZoneOriginRootNodeNextIndexes
    array<int>  coreZoneOriginRootNodeOwnerCoreSlots
    array<int>  coreZoneOriginRootNodeExpectedCoreIds
    array<int>  coreZoneOriginRootNodeExpectedGenerationIds
    array<bool> coreZoneOriginRootNodeLiveFlags
    array<int>  coreZoneOriginRootNodeFreeIndexes
    int         topologyRevision = 0
    array<int>  inverseOriginData
    array<int>  identityGatherData
    array<int>  pairingSupportBottomOrderData
    array<int>  pairingSupportTopOrderData
    array<int>  pairingResistanceBottomOrderData
    array<int>  pairingResistanceTopOrderData
    int          physicalCandidateLogicalCount = 0
    array<int>   physicalCandidateSupportWinnerIndexes
    array<int>   physicalCandidateResistanceWinnerIndexes
    array<int>   physicalCandidateBottomTicks
    array<int>   physicalCandidateTopTicks
    array<float> physicalCandidateExactPrices
    array<int>   physicalCandidateMinRootIds
    array<int>   physicalCandidateRootIdOffsets
    array<int>   physicalCandidateRootIdLengths
    array<int>   physicalCandidateRootIds
    int          physicalCandidateRootIdLength = 0
    array<int>   physicalIdentityEdges
    array<int>   physicalIdentityMatches
    int          physicalIdentityEdgeCount = 0
    int          physicalIdentityMatchCount = 0
    array<int>   physicalOwnershipKinds
    array<int>   physicalContinuationOldCoreSlots
    array<int>   physicalContinuationCoreIds
    array<int>   physicalContinuationGenerationIds
    array<int>   physicalFreshAllocationRanks
    int          physicalFreshAllocationCount = 0
    array<int>   physicalMaterializedCoreSlots
    array<int>   physicalMaterializedCoreIds
    array<int>   physicalMaterializedGenerationIds
    int          physicalMaterializedLogicalCount = 0
    array<int>   mergeRelations
    array<int>   mergeAbsorbed
    int          mergeRelationCount = 0
    int          mergeAbsorbedLogicalCount = 0
    array<int>   splitRelations
    array<int>   splitChildren
    int          splitRelationCount = 0
    int          splitChildLogicalCount = 0
    array<int>   changedOldCores
    array<int>   changedTargets
    int          changedComponentCount = 0
    CoreRegistryStore coreRegistry

export newStore() =>
    W08Store s = W08Store.new()
    s.coreIntervalOrderData                       := array.new_int(0)
    s.coreIntervalTopOrderData                    := array.new_int(0)
    s.coreZoneOriginRootHeadNodeIndexes           := array.new_int(0)
    s.coreZoneOriginRootTailNodeIndexes           := array.new_int(0)
    s.coreZoneOriginRootCounts                    := array.new_int(0)
    s.coreZoneOriginRootNodeRootIds               := array.new_int(0)
    s.coreZoneOriginRootNodeNextIndexes           := array.new_int(0)
    s.coreZoneOriginRootNodeOwnerCoreSlots        := array.new_int(0)
    s.coreZoneOriginRootNodeExpectedCoreIds       := array.new_int(0)
    s.coreZoneOriginRootNodeExpectedGenerationIds := array.new_int(0)
    s.coreZoneOriginRootNodeLiveFlags             := array.new_bool(0)
    s.coreZoneOriginRootNodeFreeIndexes           := array.new_int(0)
    s.inverseOriginData                           := array.new_int(0)
    s.identityGatherData                          := array.new_int(0)
    s.pairingSupportBottomOrderData               := array.new_int(0)
    s.pairingSupportTopOrderData                  := array.new_int(0)
    s.pairingResistanceBottomOrderData            := array.new_int(0)
    s.pairingResistanceTopOrderData               := array.new_int(0)
    s.physicalCandidateSupportWinnerIndexes       := array.new_int(0)
    s.physicalCandidateResistanceWinnerIndexes    := array.new_int(0)
    s.physicalCandidateBottomTicks                := array.new_int(0)
    s.physicalCandidateTopTicks                   := array.new_int(0)
    s.physicalCandidateExactPrices                := array.new_float(0)
    s.physicalCandidateMinRootIds                 := array.new_int(0)
    s.physicalCandidateRootIdOffsets              := array.new_int(0)
    s.physicalCandidateRootIdLengths              := array.new_int(0)
    s.physicalCandidateRootIds                    := array.new_int(0)
    s.physicalIdentityEdges                       := array.new_int(0)
    s.physicalIdentityMatches                     := array.new_int(0)
    s.physicalOwnershipKinds                      := array.new_int(0)
    s.physicalContinuationOldCoreSlots            := array.new_int(0)
    s.physicalContinuationCoreIds                 := array.new_int(0)
    s.physicalContinuationGenerationIds           := array.new_int(0)
    s.physicalFreshAllocationRanks                := array.new_int(0)
    s.physicalMaterializedCoreSlots               := array.new_int(0)
    s.physicalMaterializedCoreIds                 := array.new_int(0)
    s.physicalMaterializedGenerationIds           := array.new_int(0)
    s.mergeRelations                              := array.new_int(0)
    s.mergeAbsorbed                               := array.new_int(0)
    s.splitRelations                              := array.new_int(0)
    s.splitChildren                               := array.new_int(0)
    s.changedOldCores                             := array.new_int(0)
    s.changedTargets                              := array.new_int(0)
    s.coreRegistry                                := newCoreRegistryStoreRaw()
    s

// currentCoreId = the Core ID of a live Core at coreSlot, ID_NONE when the slot is out of
// range or not live (caller side). The physical range is read by the caller and passed in.
// B04-A: every interval mutation keeps the bottom-order index (coreIntervalOrderData) and the
// top-order index (coreIntervalTopOrderData) as the same tuple set. The target entry is located
// in both before any write; a target present in only one index, different ticks between the
// two, or unequal index sizes fail the call with no write (local checks only, no full audit).
// B07-D: the input / storage predicate of intervalInsert (shared with coreIndexCanInstall)
intervalInsertInputOkRaw(W08Store store, int coreSlot, int expectedCoreId, int currentCoreId, float physicalBottom, float physicalTop, float mintick) =>
    int dataSize = array.size(store.coreIntervalOrderData)
    coreSlot >= 0 and expectedCoreId != ID_NONE and currentCoreId == expectedCoreId and mintick > 0 and physicalBottom <= physicalTop and dataSize % 4 == 0 and array.size(store.coreIntervalTopOrderData) == dataSize

export intervalInsert(W08Store store, int coreSlot, int expectedCoreId, int currentCoreId, float physicalBottom, float physicalTop, float mintick) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if intervalInsertInputOkRaw(store, coreSlot, expectedCoreId, currentCoreId, physicalBottom, physicalTop, mintick)
        int bTick = int(math.round(physicalBottom / mintick))
        int tTick = int(math.round(physicalTop    / mintick))
        int k     = 0
        while k < dataSize and (array.get(d, k) != coreSlot or array.get(d, k + 1) != expectedCoreId)
            k += 4
        int j = 0
        while j < dataSize and (array.get(e, j) != coreSlot or array.get(e, j + 1) != expectedCoreId)
            j += 4
        if k < dataSize and j < dataSize
            ok := array.get(d, k + 2) == bTick and array.get(d, k + 3) == tTick and array.get(e, j + 2) == bTick and array.get(e, j + 3) == tTick
        else if k == dataSize and j == dataSize
            ok := true
            array.push(d, coreSlot)
            array.push(d, expectedCoreId)
            array.push(d, bTick)
            array.push(d, tTick)
            while k > 0 and (array.get(d, k - 2) > bTick or (array.get(d, k - 2) == bTick and (array.get(d, k - 1) > tTick or (array.get(d, k - 1) == tTick and array.get(d, k - 3) > expectedCoreId))))
                for n = 0 to 3
                    array.set(d, k + n, array.get(d, k - 4 + n))
                k -= 4
            array.set(d, k,     coreSlot)
            array.set(d, k + 1, expectedCoreId)
            array.set(d, k + 2, bTick)
            array.set(d, k + 3, tTick)
            array.push(e, coreSlot)
            array.push(e, expectedCoreId)
            array.push(e, bTick)
            array.push(e, tTick)
            while j > 0 and (array.get(e, j - 1) > tTick or (array.get(e, j - 1) == tTick and (array.get(e, j - 2) > bTick or (array.get(e, j - 2) == bTick and array.get(e, j - 3) > expectedCoreId))))
                for n = 0 to 3
                    array.set(e, j + n, array.get(e, j - 4 + n))
                j -= 4
            array.set(e, j,     coreSlot)
            array.set(e, j + 1, expectedCoreId)
            array.set(e, j + 2, bTick)
            array.set(e, j + 3, tTick)
            changed := true
    [ok, changed]

// B07-D: the read-only failure predicate of intervalDetach (shared with coreIndexCanRelease). Returns [ok, k, j]:
// the tuple positions in the bottom / top order (dataSize = absent from both).
intervalDetachCheckRaw(W08Store store, int coreSlot, int expectedCoreId) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool ok       = false
    int  dataSize = array.size(d)
    int  k        = 0
    int  j        = 0
    if coreSlot >= 0 and expectedCoreId != ID_NONE and dataSize % 4 == 0 and array.size(e) == dataSize
        while k < dataSize and (array.get(d, k) != coreSlot or array.get(d, k + 1) != expectedCoreId)
            k += 4
        while j < dataSize and (array.get(e, j) != coreSlot or array.get(e, j + 1) != expectedCoreId)
            j += 4
        if k == dataSize and j == dataSize
            ok := true
        else if k < dataSize and j < dataSize
            ok := array.get(d, k + 2) == array.get(e, j + 2) and array.get(d, k + 3) == array.get(e, j + 3)
    [ok, k, j]

export intervalDetach(W08Store store, int coreSlot, int expectedCoreId) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    bool changed  = false
    int  dataSize = array.size(d)
    [ok, k0, j0] = intervalDetachCheckRaw(store, coreSlot, expectedCoreId)
    if ok
        int k = k0
        int j = j0
        if k < dataSize and j < dataSize
            if ok
                while k < dataSize - 4
                    array.set(d, k, array.get(d, k + 4))
                    k += 1
                while j < dataSize - 4
                    array.set(e, j, array.get(e, j + 4))
                    j += 1
                for n = 1 to 4
                    array.pop(d)
                    array.pop(e)
                changed := true
    [ok, changed]


// B04-A: exact interval collection. Writes every [coreSlot, expectedCoreId] whose entry has
// bottomTick <= candidateTopTick + mTick and topTick >= candidateBottomTick - mTick (interval
// gap <= M, equality included) into outCores (stride 2, physical index order: not the
// canonical pair order, never an Identity tie-break) and returns the count; -1 with an empty
// outCores for bottom > top, mTick < 0 or bad storage. Binary search gives the bottom-index
// prefix meeting the first bound and the top-index suffix meeting the second; only the
// smaller of the two is scanned (bottom on a tie) and each scanned entry is checked against
// the other bound. No cap, no live Core check (the caller matches coreIds[coreSlot]).
export intervalCollect(W08Store store, int candidateBottomTick, int candidateTopTick, int mTick, array<int> outCores) =>
    array<int> d = store.coreIntervalOrderData
    array<int> e = store.coreIntervalTopOrderData
    array.clear(outCores)
    int result   = -1
    int dataSize = array.size(d)
    if candidateBottomTick <= candidateTopTick and mTick >= 0 and dataSize % 4 == 0 and array.size(e) == dataSize
        int hiTick = candidateTopTick + mTick
        int loTick = candidateBottomTick - mTick
        int n  = int(dataSize / 4)
        int lo = 0
        int hi = n
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(d, mid * 4 + 2) <= hiTick
                lo := mid + 1
            else
                hi := mid
        int bottomPrefixCount = lo
        lo := 0
        hi := n
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(e, mid * 4 + 3) < loTick
                lo := mid + 1
            else
                hi := mid
        int topSuffixStart = lo
        if bottomPrefixCount <= n - topSuffixStart
            int i = 0
            while i < bottomPrefixCount * 4
                if array.get(d, i + 3) >= loTick
                    array.push(outCores, array.get(d, i))
                    array.push(outCores, array.get(d, i + 1))
                i += 4
        else
            int i = topSuffixStart * 4
            while i < dataSize
                if array.get(e, i + 2) <= hiTick
                    array.push(outCores, array.get(e, i))
                    array.push(outCores, array.get(e, i + 1))
                i += 4
        result := int(array.size(outCores) / 2)
    result

// B07-D: the input predicate of originAdd (shared with coreIndexCanInstall)
originAddInputOkRaw(int coreSlot, int currentCoreId, int rootId) =>
    coreSlot >= 0 and currentCoreId != ID_NONE and rootId >= 1

export originAdd(W08Store store, int coreSlot, int currentCoreId, int currentGenerationId, int rootId) =>
    bool ok      = false
    bool changed = false
    if originAddInputOkRaw(coreSlot, currentCoreId, rootId)
        ok := true
        while array.size(store.coreZoneOriginRootCounts) <= coreSlot
            array.push(store.coreZoneOriginRootHeadNodeIndexes, SLOT_INVALID)
            array.push(store.coreZoneOriginRootTailNodeIndexes, SLOT_INVALID)
            array.push(store.coreZoneOriginRootCounts,          0)
        int cur = array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        if cur != SLOT_INVALID and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) != currentCoreId
            cur := SLOT_INVALID
            array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootCounts,          coreSlot, 0)
        int prevNode = SLOT_INVALID
        while cur != SLOT_INVALID and array.get(store.coreZoneOriginRootNodeRootIds, cur) < rootId
            prevNode := cur
            cur      := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
        if cur == SLOT_INVALID or array.get(store.coreZoneOriginRootNodeRootIds, cur) != rootId
            int nodeIndex = array.size(store.coreZoneOriginRootNodeRootIds)
            if array.size(store.coreZoneOriginRootNodeFreeIndexes) > 0
                nodeIndex := array.pop(store.coreZoneOriginRootNodeFreeIndexes)
                array.set(store.coreZoneOriginRootNodeRootIds,               nodeIndex, rootId)
                array.set(store.coreZoneOriginRootNodeNextIndexes,           nodeIndex, cur)
                array.set(store.coreZoneOriginRootNodeOwnerCoreSlots,        nodeIndex, coreSlot)
                array.set(store.coreZoneOriginRootNodeExpectedCoreIds,       nodeIndex, currentCoreId)
                array.set(store.coreZoneOriginRootNodeExpectedGenerationIds, nodeIndex, currentGenerationId)
                array.set(store.coreZoneOriginRootNodeLiveFlags,             nodeIndex, true)
            else
                array.push(store.coreZoneOriginRootNodeRootIds,               rootId)
                array.push(store.coreZoneOriginRootNodeNextIndexes,           cur)
                array.push(store.coreZoneOriginRootNodeOwnerCoreSlots,        coreSlot)
                array.push(store.coreZoneOriginRootNodeExpectedCoreIds,       currentCoreId)
                array.push(store.coreZoneOriginRootNodeExpectedGenerationIds, currentGenerationId)
                array.push(store.coreZoneOriginRootNodeLiveFlags,             true)
            if prevNode == SLOT_INVALID
                array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, nodeIndex)
            else
                array.set(store.coreZoneOriginRootNodeNextIndexes, prevNode, nodeIndex)
            if cur == SLOT_INVALID
                array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, nodeIndex)
            array.set(store.coreZoneOriginRootCounts, coreSlot, array.get(store.coreZoneOriginRootCounts, coreSlot) + 1)
            store.topologyRevision := store.topologyRevision + 1
            changed := true
    [ok, changed]


// Copies the origin Root ID set of the live Core at coreSlot into outRootIds in rootId ASC
// order and returns its count; -1 with an empty outRootIds for an invalid slot, a non-live
// Core (currentCoreId = ID_NONE) or an out-of-range node index (never a partial set).
export originReadAsc(W08Store store, int coreSlot, int currentCoreId, array<int> outRootIds) =>
    array.clear(outRootIds)
    int result = -1
    if coreSlot >= 0 and currentCoreId != ID_NONE
        int nodeRows = array.size(store.coreZoneOriginRootNodeRootIds)
        int cur      = coreSlot < array.size(store.coreZoneOriginRootCounts) ? array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot) : SLOT_INVALID
        if cur >= 0 and cur < nodeRows and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) != currentCoreId
            cur := SLOT_INVALID
        while cur >= 0 and cur < nodeRows
            array.push(outRootIds, array.get(store.coreZoneOriginRootNodeRootIds, cur))
            cur := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
        if cur == SLOT_INVALID
            result := array.size(outRootIds)
        else
            array.clear(outRootIds)
    result

// B07-D: the input / storage predicate of inverseOriginAdd (shared with coreIndexCanInstall)
inverseOriginInputOkRaw(W08Store store, int fvgOriginRootId, int coreSlot, int currentCoreId) =>
    fvgOriginRootId >= 1 and coreSlot >= 0 and currentCoreId != ID_NONE and array.size(store.inverseOriginData) % 3 == 0

export inverseOriginAdd(W08Store store, int fvgOriginRootId, int coreSlot, int currentCoreId) =>
    array<int> d = store.inverseOriginData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if inverseOriginInputOkRaw(store, fvgOriginRootId, coreSlot, currentCoreId)
        ok := true
        int k = dataSize
        while k > 0 and (array.get(d, k - 3) > fvgOriginRootId or (array.get(d, k - 3) == fvgOriginRootId and (array.get(d, k - 1) > currentCoreId or (array.get(d, k - 1) == currentCoreId and array.get(d, k - 2) > coreSlot))))
            k -= 3
        if k == 0 or array.get(d, k - 3) != fvgOriginRootId or array.get(d, k - 2) != coreSlot or array.get(d, k - 1) != currentCoreId
            array.push(d, fvgOriginRootId)
            array.push(d, coreSlot)
            array.push(d, currentCoreId)
            int j = dataSize - 1
            while j >= k
                array.set(d, j + 3, array.get(d, j))
                j -= 1
            array.set(d, k,     fvgOriginRootId)
            array.set(d, k + 1, coreSlot)
            array.set(d, k + 2, currentCoreId)
            changed := true
    [ok, changed]


// Writes every [coreSlot, expectedCoreId] registered for fvgOriginRootId into outCores
// (stride 2, index order, no cap) and returns the candidate count; -1 with an empty
// outCores for an invalid origin or storage. Only that origin's run is read (binary search
// to its first entry).
export inverseOriginCollect(W08Store store, int fvgOriginRootId, array<int> outCores) =>
    array<int> d = store.inverseOriginData
    array.clear(outCores)
    int result   = -1
    int dataSize = array.size(d)
    if fvgOriginRootId >= 1 and dataSize % 3 == 0
        int lo = 0
        int hi = int(dataSize / 3)
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2.0))
            if array.get(d, mid * 3) < fvgOriginRootId
                lo := mid + 1
            else
                hi := mid
        int k = lo * 3
        while k < dataSize and array.get(d, k) == fvgOriginRootId
            array.push(outCores, array.get(d, k + 1))
            array.push(outCores, array.get(d, k + 2))
            k += 3
        result := int(array.size(outCores) / 2)
    result

export identityGatherReset(W08Store store) =>
    array.clear(store.identityGatherData)
    true

// Adds the physical Core (currentCoreId at coreSlot) once, at its coreId ASC position. Same
// coreId and slot again: no-op. Same coreId with another slot, or the slot already held by
// another coreId: ok = false with no write (never merged or repaired here).
export identityGatherOffer(W08Store store, int coreSlot, int currentCoreId) =>
    array<int> d = store.identityGatherData
    bool ok       = false
    bool changed  = false
    int  dataSize = array.size(d)
    if coreSlot >= 0 and currentCoreId >= 1 and dataSize % 2 == 0
        bool conflict = false
        bool exact    = false
        int  pos      = dataSize
        int  k        = 0
        while k < dataSize and not conflict
            int id = array.get(d, k)
            int sl = array.get(d, k + 1)
            if id == currentCoreId
                exact    := sl == coreSlot
                conflict := sl != coreSlot
            else if sl == coreSlot
                conflict := true
            if pos == dataSize and id > currentCoreId
                pos := k
            k += 2
        if not conflict
            ok := true
            if not exact
                array.push(d, currentCoreId)
                array.push(d, coreSlot)
                int j = dataSize - 1
                while j >= pos
                    array.set(d, j + 2, array.get(d, j))
                    j -= 1
                array.set(d, pos,     currentCoreId)
                array.set(d, pos + 1, coreSlot)
                changed := true
    [ok, changed]

// Writes the gathered Cores into outPairs as [coreSlot, coreId] (stride 2), coreId ASC, and
// returns the count; -1 with an empty outPairs when the scratch is not a strictly ascending
// stride-2 list (checked in the same read pass, never a partial result).
export identityGatherReadAsc(W08Store store, array<int> outPairs) =>
    array<int> d = store.identityGatherData
    array.clear(outPairs)
    int  result   = -1
    int  dataSize = array.size(d)
    bool valid    = dataSize % 2 == 0
    int  lastId   = 0
    int  k        = 0
    while valid and k < dataSize
        int id = array.get(d, k)
        valid := id > lastId
        if valid
            array.push(outPairs, array.get(d, k + 1))
            array.push(outPairs, id)
            lastId := id
        k += 2
    if valid
        result := int(dataSize / 2)
    else
        array.clear(outPairs)
    result

export pairingReset(W08Store store) =>
    array.clear(store.pairingSupportBottomOrderData)
    array.clear(store.pairingSupportTopOrderData)
    array.clear(store.pairingResistanceBottomOrderData)
    array.clear(store.pairingResistanceTopOrderData)
    true

// side: Support = 1, Resistance = -1. The winner is located in both indexes of its Side before
// any write: absent from both -> inserted into both at the canonical positions; present in both
// with the same range -> no-op; any other case (other range, present in one index only, unequal
// index sizes) -> ok = false with no write. Local checks only, no full audit.
export pairingAddCandidate(W08Store store, int side, int candidateWinnerIndex, int bottomTick, int topTick) =>
    bool ok      = false
    bool changed = false
    if (side == 1 or side == -1) and candidateWinnerIndex >= 0 and bottomTick <= topTick
        array<int> d = side == 1 ? store.pairingSupportBottomOrderData : store.pairingResistanceBottomOrderData
        array<int> e = side == 1 ? store.pairingSupportTopOrderData    : store.pairingResistanceTopOrderData
        int dataSize = array.size(d)
        if dataSize % 3 == 0 and array.size(e) == dataSize
            int k = 0
            while k < dataSize and array.get(d, k) != candidateWinnerIndex
                k += 3
            int j = 0
            while j < dataSize and array.get(e, j) != candidateWinnerIndex
                j += 3
            if k < dataSize and j < dataSize
                ok := array.get(d, k + 1) == bottomTick and array.get(d, k + 2) == topTick and array.get(e, j + 1) == bottomTick and array.get(e, j + 2) == topTick
            else if k == dataSize and j == dataSize
                ok := true
                array.push(d, candidateWinnerIndex)
                array.push(d, bottomTick)
                array.push(d, topTick)
                while k > 0 and (array.get(d, k - 2) > bottomTick or (array.get(d, k - 2) == bottomTick and (array.get(d, k - 1) > topTick or (array.get(d, k - 1) == topTick and array.get(d, k - 3) > candidateWinnerIndex))))
                    for n = 0 to 2
                        array.set(d, k + n, array.get(d, k - 3 + n))
                    k -= 3
                array.set(d, k,     candidateWinnerIndex)
                array.set(d, k + 1, bottomTick)
                array.set(d, k + 2, topTick)
                array.push(e, candidateWinnerIndex)
                array.push(e, bottomTick)
                array.push(e, topTick)
                while j > 0 and (array.get(e, j - 1) > topTick or (array.get(e, j - 1) == topTick and (array.get(e, j - 2) > bottomTick or (array.get(e, j - 2) == bottomTick and array.get(e, j - 3) > candidateWinnerIndex))))
                    for n = 0 to 2
                        array.set(e, j + n, array.get(e, j - 3 + n))
                    j -= 3
                array.set(e, j,     candidateWinnerIndex)
                array.set(e, j + 1, bottomTick)
                array.set(e, j + 2, topTick)
                changed := true
    [ok, changed]

// Writes every (supportWinnerIndex, resistanceWinnerIndex) with R.bottom <= S.top + mTick and
// R.top >= S.bottom - mTick (interval gap <= M, equality included) into outPairs, stride 2,
// ordered by supportWinnerIndex ASC then resistanceWinnerIndex ASC, and returns the count; -1
// with an empty outPairs for mTick < 0 or bad storage. Sweep over the Support intervals widened
// by mTick and the Resistance intervals: starts come from the two bottom orders, expiries from
// the two top orders; each new interval pairs with the live intervals of the other Side (exact
// condition re-checked), so each pair is found once and no Support x Resistance scan is made.
// The pairs are then put in canonical order by a stable two-pass counting sort.
export pairingCollectPairs(W08Store store, int mTick, array<int> outPairs) =>
    array<int> sb = store.pairingSupportBottomOrderData
    array<int> st = store.pairingSupportTopOrderData
    array<int> rb = store.pairingResistanceBottomOrderData
    array<int> rt = store.pairingResistanceTopOrderData
    array.clear(outPairs)
    int  sSize = array.size(sb)
    int  rSize = array.size(rb)
    bool ok    = mTick >= 0 and sSize % 3 == 0 and rSize % 3 == 0 and array.size(st) == sSize and array.size(rt) == rSize
    array<int> activeS = array.new_int(0)
    array<int> activeR = array.new_int(0)
    array<int> ps      = array.new_int(0)
    array<int> pr      = array.new_int(0)
    int maxS = 0
    int maxR = 0
    int si = 0
    int ri = 0
    int se = 0
    int re = 0
    while ok and (si < sSize or ri < rSize)
        bool takeS    = ri >= rSize or (si < sSize and array.get(sb, si + 1) - mTick <= array.get(rb, ri + 1))
        int  curStart = 0
        if takeS
            curStart := array.get(sb, si + 1) - mTick
        else
            curStart := array.get(rb, ri + 1)
        while ok and se < sSize and array.get(st, se + 2) + mTick < curStart
            int idx = array.get(st, se)
            int a   = 0
            while a < array.size(activeS) and array.get(activeS, a) != idx
                a += 3
            ok := a < array.size(activeS)
            if ok
                int last = array.size(activeS) - 3
                for n = 0 to 2
                    array.set(activeS, a + n, array.get(activeS, last + n))
                for n = 1 to 3
                    array.pop(activeS)
            se += 3
        while ok and re < rSize and array.get(rt, re + 2) < curStart
            int idx = array.get(rt, re)
            int a   = 0
            while a < array.size(activeR) and array.get(activeR, a) != idx
                a += 3
            ok := a < array.size(activeR)
            if ok
                int last = array.size(activeR) - 3
                for n = 0 to 2
                    array.set(activeR, a + n, array.get(activeR, last + n))
                for n = 1 to 3
                    array.pop(activeR)
            re += 3
        if ok
            if takeS
                int sIdx = array.get(sb, si)
                int sBot = array.get(sb, si + 1)
                int sTop = array.get(sb, si + 2)
                int a = 0
                while a < array.size(activeR)
                    if array.get(activeR, a + 1) <= sTop + mTick and array.get(activeR, a + 2) >= sBot - mTick
                        array.push(ps, sIdx)
                        array.push(pr, array.get(activeR, a))
                        maxS := math.max(maxS, sIdx)
                        maxR := math.max(maxR, array.get(activeR, a))
                    a += 3
                array.push(activeS, sIdx)
                array.push(activeS, sBot)
                array.push(activeS, sTop)
                si += 3
            else
                int rIdx = array.get(rb, ri)
                int rBot = array.get(rb, ri + 1)
                int rTop = array.get(rb, ri + 2)
                int a = 0
                while a < array.size(activeS)
                    if rBot <= array.get(activeS, a + 2) + mTick and rTop >= array.get(activeS, a + 1) - mTick
                        array.push(ps, array.get(activeS, a))
                        array.push(pr, rIdx)
                        maxS := math.max(maxS, array.get(activeS, a))
                        maxR := math.max(maxR, rIdx)
                    a += 3
                array.push(activeR, rIdx)
                array.push(activeR, rBot)
                array.push(activeR, rTop)
                ri += 3
    int result = -1
    if ok
        int count = array.size(ps)
        array<int> byR  = array.new_int(count, 0)
        array<int> cntR = array.new_int(maxR + 2, 0)
        int x = 0
        while x < count
            array.set(cntR, array.get(pr, x) + 1, array.get(cntR, array.get(pr, x) + 1) + 1)
            x += 1
        x := 1
        while x < maxR + 2
            array.set(cntR, x, array.get(cntR, x) + array.get(cntR, x - 1))
            x += 1
        x := 0
        while x < count
            int key = array.get(pr, x)
            array.set(byR, array.get(cntR, key), x)
            array.set(cntR, key, array.get(cntR, key) + 1)
            x += 1
        array<int> finalOrder = array.new_int(count, 0)
        array<int> cntS       = array.new_int(maxS + 2, 0)
        x := 0
        while x < count
            array.set(cntS, array.get(ps, x) + 1, array.get(cntS, array.get(ps, x) + 1) + 1)
            x += 1
        x := 1
        while x < maxS + 2
            array.set(cntS, x, array.get(cntS, x) + array.get(cntS, x - 1))
            x += 1
        x := 0
        while x < count
            int p   = array.get(byR, x)
            int key = array.get(ps, p)
            array.set(finalOrder, array.get(cntS, key), p)
            array.set(cntS, key, array.get(cntS, key) + 1)
            x += 1
        x := 0
        while x < count
            int p = array.get(finalOrder, x)
            array.push(outPairs, array.get(ps, p))
            array.push(outPairs, array.get(pr, p))
            x += 1
        result := count
    result

// Maximum matching cardinality of the eligible graph (Kuhn augmenting paths, iterative stack,
// no recursion, no cap). adjStart / edgeR: edges grouped by Support rank, Resistance rank ASC
// inside a group, so an edge position is its canonical edge order. Only edges with position >
// minEdgePos whose two endpoints are not used take part. Support ranks are tried in rank order
// and edges in position order; the returned cardinality does not depend on that order.
matchingMaxCardinalityRaw(array<int> adjStart, array<int> edgeR, int nS, int nR, int minEdgePos, array<bool> usedS, array<bool> usedR) =>
    array<int> matchR  = array.new_int(nR, -1)
    array<int> seenR   = array.new_int(nR, -1)
    array<int> stackS  = array.new_int(0)
    array<int> stackC  = array.new_int(0)
    array<int> stackR  = array.new_int(0)
    int result = 0
    int u = 0
    while u < nS
        if not array.get(usedS, u)
            array.clear(stackS)
            array.clear(stackC)
            array.clear(stackR)
            array.push(stackS, u)
            array.push(stackC, array.get(adjStart, u))
            array.push(stackR, -1)
            bool found = false
            while not found and array.size(stackS) > 0
                int top = array.size(stackS) - 1
                int v   = array.get(stackS, top)
                int c   = array.get(stackC, top)
                if c >= array.get(adjStart, v + 1)
                    array.pop(stackS)
                    array.pop(stackC)
                    array.pop(stackR)
                else
                    array.set(stackC, top, c + 1)
                    int r = array.get(edgeR, c)
                    if c > minEdgePos and not array.get(usedR, r) and array.get(seenR, r) != u
                        array.set(seenR, r, u)
                        array.set(stackR, top, r)
                        int owner = array.get(matchR, r)
                        if owner == -1
                            found := true
                        else
                            array.push(stackS, owner)
                            array.push(stackC, array.get(adjStart, owner))
                            array.push(stackR, -1)
            if found
                int d = array.size(stackS) - 1
                while d >= 0
                    array.set(matchR, array.get(stackR, d), array.get(stackS, d))
                    d -= 1
                result += 1
        u += 1
    result

// Selects the canonical maximum matching of the eligible Support x Resistance pairs into
// outMatchedPairs (stride 2 [supportWinnerIndex, resistanceWinnerIndex], canonical edge order)
// and returns its cardinality; 0 with an empty output for an empty graph. -1 with an empty
// output (no partial write) for an odd length, a negative index, a Support index absent from
// the Support bottom order, a Resistance index absent from the Resistance bottom order, a
// duplicated edge or bad pairing storage. Step A: K = maximum cardinality. Step C: edges in
// canonical order; an edge free of selected endpoints is taken when, forced in, the edges after
// it still complete the remaining count. Nothing is deduplicated silently, no cap.
// Canonical maximum matching over rank edges (es[i], er[i]) of nS row ranks and nR column ranks (B07-A1 machinery).
// edgeS / edgeR receive the edges in canonical order (row rank, then column rank ASC, stable counting sorts); a repeated
// edge fails. K = maximum cardinality, then each edge in canonical order free of chosen endpoints is taken when, forced
// in, the edges after it still complete the remaining count. pickS / pickR receive the chosen edges in canonical order.
// Returns K, or -1 (a repeated edge / incomplete selection).
matchingCanonicalRaw(array<int> es, array<int> er, int nS, int nR, array<int> edgeS, array<int> edgeR, array<int> pickS, array<int> pickR) =>
    int nE = array.size(es)
    int result = -1
    array.clear(edgeS)
    array.clear(edgeR)
    array.clear(pickS)
    array.clear(pickR)
    bool ok = true
    if nS >= 0
        // canonical edge order: stable counting sort by Resistance rank, then by Support rank
        array<int> cnt  = array.new_int(nR + 1, 0)
        array<int> byR  = array.new_int(nE, 0)
        int x = 0
        while x < nE
            array.set(cnt, array.get(er, x) + 1, array.get(cnt, array.get(er, x) + 1) + 1)
            x += 1
        x := 1
        while x <= nR
            array.set(cnt, x, array.get(cnt, x) + array.get(cnt, x - 1))
            x += 1
        x := 0
        while x < nE
            int key = array.get(er, x)
            array.set(byR, array.get(cnt, key), x)
            array.set(cnt, key, array.get(cnt, key) + 1)
            x += 1
        array<int> adjStart = array.new_int(nS + 1, 0)
        int x0 = 0
        while x0 < nE
            array.push(edgeS, 0)
            array.push(edgeR, 0)
            x0 += 1
        x := 0
        while x < nE
            array.set(adjStart, array.get(es, x) + 1, array.get(adjStart, array.get(es, x) + 1) + 1)
            x += 1
        x := 1
        while x <= nS
            array.set(adjStart, x, array.get(adjStart, x) + array.get(adjStart, x - 1))
            x += 1
        array<int> fill = array.copy(adjStart)
        x := 0
        while x < nE
            int p   = array.get(byR, x)
            int key = array.get(es, p)
            array.set(edgeS, array.get(fill, key), key)
            array.set(edgeR, array.get(fill, key), array.get(er, p))
            array.set(fill, key, array.get(fill, key) + 1)
            x += 1
        // a repeated (S, R) edge is a structural failure, never deduplicated
        x := 1
        while ok and x < nE
            ok := not (array.get(edgeS, x) == array.get(edgeS, x - 1) and array.get(edgeR, x) == array.get(edgeR, x - 1))
            x += 1
        if ok
            array<bool> usedS = array.new_bool(nS, false)
            array<bool> usedR = array.new_bool(nR, false)
            int need     = matchingMaxCardinalityRaw(adjStart, edgeR, nS, nR, -1, usedS, usedR)
            int total    = need
            int selected = 0
            int e = 0
            while need > 0 and e < nE
                int s = array.get(edgeS, e)
                int r = array.get(edgeR, e)
                if not array.get(usedS, s) and not array.get(usedR, r)
                    array.set(usedS, s, true)
                    array.set(usedR, r, true)
                    int rest = matchingMaxCardinalityRaw(adjStart, edgeR, nS, nR, e, usedS, usedR)
                    if 1 + rest >= need
                        array.push(pickS, s)
                        array.push(pickR, r)
                        selected += 1
                        need     -= 1
                    else
                        array.set(usedS, s, false)
                        array.set(usedR, r, false)
                e += 1
            if selected == total
                result := total
    result

export pairingSelectCanonicalMatching(W08Store store, array<int> eligiblePairs, array<int> outMatchedPairs) =>
    array<int> sb = store.pairingSupportBottomOrderData
    array<int> rb = store.pairingResistanceBottomOrderData
    array.clear(outMatchedPairs)
    int  sSize = array.size(sb)
    int  rSize = array.size(rb)
    int  eSize = array.size(eligiblePairs)
    bool ok    = sSize % 3 == 0 and rSize % 3 == 0 and array.size(store.pairingSupportTopOrderData) == sSize and array.size(store.pairingResistanceTopOrderData) == rSize and eSize % 2 == 0
    int nS = int(sSize / 3)
    int nR = int(rSize / 3)
    int nE = int(eSize / 2)
    // winnerIndex -> Side rank (position in the Side bottom order)
    int maxS = -1
    int maxR = -1
    int k = 0
    while ok and k < sSize
        ok   := array.get(sb, k) >= 0
        maxS := math.max(maxS, array.get(sb, k))
        k += 3
    k := 0
    while ok and k < rSize
        ok   := array.get(rb, k) >= 0
        maxR := math.max(maxR, array.get(rb, k))
        k += 3
    array<int> rankOfS = array.new_int(ok ? maxS + 1 : 0, -1)
    array<int> rankOfR = array.new_int(ok ? maxR + 1 : 0, -1)
    k := 0
    while ok and k < sSize
        ok := array.get(rankOfS, array.get(sb, k)) == -1
        if ok
            array.set(rankOfS, array.get(sb, k), int(k / 3))
        k += 3
    k := 0
    while ok and k < rSize
        ok := array.get(rankOfR, array.get(rb, k)) == -1
        if ok
            array.set(rankOfR, array.get(rb, k), int(k / 3))
        k += 3
    // eligible pairs -> ranks
    array<int> es = array.new_int(0)
    array<int> er = array.new_int(0)
    k := 0
    while ok and k < eSize
        int s = array.get(eligiblePairs, k)
        int r = array.get(eligiblePairs, k + 1)
        ok := s >= 0 and r >= 0 and s <= maxS and r <= maxR
        if ok
            ok := array.get(rankOfS, s) != -1 and array.get(rankOfR, r) != -1
        if ok
            array.push(es, array.get(rankOfS, s))
            array.push(er, array.get(rankOfR, r))
        k += 2
    int result = -1
    if ok
        array<int> pickS = array.new_int(0)
        array<int> pickR = array.new_int(0)
        result := matchingCanonicalRaw(es, er, nS, nR, array.new_int(0), array.new_int(0), pickS, pickR)
        ok := result >= 0
        int x = 0
        while ok and x < result
            array.push(outMatchedPairs, array.get(sb, array.get(pickS, x) * 3))
            array.push(outMatchedPairs, array.get(rb, array.get(pickR, x) * 3))
            x += 1
    if not ok
        array.clear(outMatchedPairs)
    result

// Appends one physical Candidate of Support winner sIdx and / or Resistance winner rIdx (-1 = absent side). Each
// present slice must lie in [0, rootIdLength) with Root IDs >= 1 strictly ascending; the union is merged by two
// pointers (a shared Root ID once). minRootId = first union ID and must equal the min winner minRootId; tick envelope
// bottom <= top; exact envelope set, bottom <= top, each price rounding to its envelope tick. false -> nothing checked
// further (the caller clears the whole physical storage).
physicalAppendRaw(W08Store store, int sIdx, int rIdx, array<int> bottomTicks, array<int> topTicks, array<float> exactPrices, array<int> minRootIds, array<int> rootIdOffsets, array<int> rootIdLengths, array<int> rootIds, int rootIdLength, float mintick) =>
    int a    = 0
    int aEnd = 0
    int b    = 0
    int bEnd = 0
    if sIdx >= 0
        a    := array.get(rootIdOffsets, sIdx)
        aEnd := a + array.get(rootIdLengths, sIdx)
    if rIdx >= 0
        b    := array.get(rootIdOffsets, rIdx)
        bEnd := b + array.get(rootIdLengths, rIdx)
    bool ok    = a >= 0 and a <= aEnd and aEnd <= rootIdLength and b >= 0 and b <= bEnd and bEnd <= rootIdLength and aEnd - a + bEnd - b > 0
    int  start = array.size(store.physicalCandidateRootIds)
    int  lastA = 0
    int  lastB = 0
    int  last  = 0
    while ok and (a < aEnd or b < bEnd)
        int x = 0
        int y = 0
        if a < aEnd
            x := array.get(rootIds, a)
        if b < bEnd
            y := array.get(rootIds, b)
        int v = b >= bEnd or (a < aEnd and x <= y) ? x : y
        if a < aEnd and x == v
            ok    := x > lastA
            lastA := x
            a     += 1
        if b < bEnd and y == v
            ok    := ok and y > lastB
            lastB := y
            b     += 1
        ok := ok and v > last
        last := v
        array.push(store.physicalCandidateRootIds, v)
    int   bt = 0
    int   tt = 0
    float bp = na
    float tp = na
    int   mr = 0
    if ok
        bool first = true
        int i = 0
        while i < 2
            int w = i == 0 ? sIdx : rIdx
            if w >= 0
                int   wb  = array.get(bottomTicks, w)
                int   wt  = array.get(topTicks, w)
                float wbp = array.get(exactPrices, 2 * w)
                float wtp = array.get(exactPrices, 2 * w + 1)
                int   wmr = array.get(minRootIds, w)
                ok := ok and not na(wbp) and not na(wtp)
                bt := first ? wb : math.min(bt, wb)
                tt := first ? wt : math.max(tt, wt)
                bp := first ? wbp : math.min(bp, wbp)
                tp := first ? wtp : math.max(tp, wtp)
                mr := first ? wmr : math.min(mr, wmr)
                first := false
            i += 1
        ok := ok and mr == array.get(store.physicalCandidateRootIds, start) and bt <= tt and bp <= tp and int(math.round(bp / mintick)) == bt and int(math.round(tp / mintick)) == tt
    if ok
        array.push(store.physicalCandidateSupportWinnerIndexes, sIdx)
        array.push(store.physicalCandidateResistanceWinnerIndexes, rIdx)
        array.push(store.physicalCandidateBottomTicks, bt)
        array.push(store.physicalCandidateTopTicks, tt)
        array.push(store.physicalCandidateExactPrices, bp)
        array.push(store.physicalCandidateExactPrices, tp)
        array.push(store.physicalCandidateMinRootIds, mr)
        array.push(store.physicalCandidateRootIdOffsets, start)
        array.push(store.physicalCandidateRootIdLengths, array.size(store.physicalCandidateRootIds) - start)
    ok

// Builds the current-pass physical Candidates from the winner arrays and the canonical matching of
// pairingSelectCanonicalMatching (stride 2 [supportWinnerIndex, resistanceWinnerIndex]) and returns their count
// (winners - matched pairs); the unmatched winners are read from the pairing bottom orders of this pass (built by
// pairingAddCandidate for every winner). Physical storage is reset first; -1 with empty physical storage (no partial
// output) for bad sizes, an odd / out-of-range / wrong-Side / repeated matched endpoint, a pairing order entry that is
// not a winner of that Side with the same ticks, a winner left unassigned, or any physicalAppendRaw failure.
export physicalBuild(W08Store store, int candidateWinnerLogicalCount, array<int> candidateWinnerSides, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<float> candidateWinnerExactPrices, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerRootIdOffsets, array<int> candidateWinnerRootIdLengths, array<int> candidateWinnerRootIds, int candidateWinnerRootIdLength, array<int> matchedPairs, float mintick) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalCandidateSupportWinnerIndexes)
    array.clear(store.physicalCandidateResistanceWinnerIndexes)
    array.clear(store.physicalCandidateBottomTicks)
    array.clear(store.physicalCandidateTopTicks)
    array.clear(store.physicalCandidateExactPrices)
    array.clear(store.physicalCandidateMinRootIds)
    array.clear(store.physicalCandidateRootIdOffsets)
    array.clear(store.physicalCandidateRootIdLengths)
    array.clear(store.physicalCandidateRootIds)
    int  n    = candidateWinnerLogicalCount
    int  mLen = array.size(matchedPairs)
    bool ok   = n >= 0 and n <= array.size(candidateWinnerSides) and n <= array.size(candidateWinnerEffectiveBottomTicks) and n <= array.size(candidateWinnerEffectiveTopTicks) and 2 * n <= array.size(candidateWinnerExactPrices) and n <= array.size(candidateWinnerMinRootIds) and n <= array.size(candidateWinnerRootIdOffsets) and n <= array.size(candidateWinnerRootIdLengths) and candidateWinnerRootIdLength >= 0 and candidateWinnerRootIdLength <= array.size(candidateWinnerRootIds) and mLen % 2 == 0 and not na(mintick) and mintick > 0
    array<bool> assigned = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < mLen
        int sIdx = array.get(matchedPairs, k)
        int rIdx = array.get(matchedPairs, k + 1)
        ok := sIdx >= 0 and sIdx < n and rIdx >= 0 and rIdx < n
        if ok
            ok := array.get(candidateWinnerSides, sIdx) == 1 and array.get(candidateWinnerSides, rIdx) == -1 and not array.get(assigned, sIdx) and not array.get(assigned, rIdx)
        if ok
            array.set(assigned, sIdx, true)
            array.set(assigned, rIdx, true)
            ok := physicalAppendRaw(store, sIdx, rIdx, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerExactPrices, candidateWinnerMinRootIds, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds, candidateWinnerRootIdLength, mintick)
        k += 2
    int side = 1
    while ok and side >= -1
        array<int> d = side == 1 ? store.pairingSupportBottomOrderData : store.pairingResistanceBottomOrderData
        ok := array.size(d) % 3 == 0
        k := 0
        while ok and k < array.size(d)
            int w = array.get(d, k)
            ok := w >= 0 and w < n
            if ok
                ok := array.get(candidateWinnerSides, w) == side and array.get(candidateWinnerEffectiveBottomTicks, w) == array.get(d, k + 1) and array.get(candidateWinnerEffectiveTopTicks, w) == array.get(d, k + 2)
            if ok and not array.get(assigned, w)
                array.set(assigned, w, true)
                ok := physicalAppendRaw(store, side == 1 ? w : -1, side == 1 ? -1 : w, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerExactPrices, candidateWinnerMinRootIds, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds, candidateWinnerRootIdLength, mintick)
            k += 3
        side -= 2
    k := 0
    while ok and k < n
        ok := array.get(assigned, k)
        k += 1
    int count = array.size(store.physicalCandidateMinRootIds)
    if ok
        ok := count == n - int(mLen / 2)
    if not ok
        array.clear(store.physicalCandidateSupportWinnerIndexes)
        array.clear(store.physicalCandidateResistanceWinnerIndexes)
        array.clear(store.physicalCandidateBottomTicks)
        array.clear(store.physicalCandidateTopTicks)
        array.clear(store.physicalCandidateExactPrices)
        array.clear(store.physicalCandidateMinRootIds)
        array.clear(store.physicalCandidateRootIdOffsets)
        array.clear(store.physicalCandidateRootIdLengths)
        array.clear(store.physicalCandidateRootIds)
    store.physicalCandidateLogicalCount := ok ? count : 0
    store.physicalCandidateRootIdLength := ok ? array.size(store.physicalCandidateRootIds) : 0
    ok ? count : -1

// New canonical order of two physical Candidates: bottomTick, topTick, minRootId, then the complete rootId ASC Root
// set lexicographic (first differing ID, else the shorter set first). -1 / 1, or 0 on a complete tie.
physicalNewCompareRaw(W08Store store, int p, int q) =>
    int c  = 0
    int ka = array.get(store.physicalCandidateBottomTicks, p) - array.get(store.physicalCandidateBottomTicks, q)
    int kb = array.get(store.physicalCandidateTopTicks, p) - array.get(store.physicalCandidateTopTicks, q)
    int kc = array.get(store.physicalCandidateMinRootIds, p) - array.get(store.physicalCandidateMinRootIds, q)
    c := ka != 0 ? ka : kb != 0 ? kb : kc
    int a    = array.get(store.physicalCandidateRootIdOffsets, p)
    int b    = array.get(store.physicalCandidateRootIdOffsets, q)
    int aEnd = a + array.get(store.physicalCandidateRootIdLengths, p)
    int bEnd = b + array.get(store.physicalCandidateRootIdLengths, q)
    while c == 0 and a < aEnd and b < bEnd
        c := array.get(store.physicalCandidateRootIds, a) - array.get(store.physicalCandidateRootIds, b)
        a += 1
        b += 1
    if c == 0
        c := (aEnd - a) - (bEnd - b)
    c > 0 ? 1 : c < 0 ? -1 : 0

// Builds the physical Identity plan from rawEdges (stride 4 [physicalCandidateIndex, oldCoreSlot, oldCoreId,
// oldCoreCreatedTime], any order; exact Identity already decided by the caller) for physicalCount Candidates (must be
// this pass's physicalCandidateLogicalCount). Old / new ranks as in the header, canonical edges and the canonical
// maximum continuation matching are stored; returns the match count. -1 with both lists empty (no partial plan) for
// bad input, an index out of range, a na createdTime, a coreId seen with another slot / createdTime, a repeated edge, or
// two edge-bearing Candidates that tie on the complete new order. The physical Candidate storage is never touched.
export identityPlanBuild(W08Store store, int physicalCount, array<int> rawEdges) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalIdentityEdges)
    array.clear(store.physicalIdentityMatches)
    int  rLen = array.size(rawEdges)
    bool ok   = physicalCount >= 0 and physicalCount == store.physicalCandidateLogicalCount and rLen % 4 == 0
    // old: distinct coreIds sorted by (createdTime, coreId); new: distinct Candidates sorted by the new order
    array<int> oldIds   = array.new_int(0)
    array<int> oldSlots = array.new_int(0)
    array<int> oldTimes = array.new_int(0)
    array<int> newIdx   = array.new_int(0)
    int k = 0
    while ok and k < rLen
        int p  = array.get(rawEdges, k)
        int sl = array.get(rawEdges, k + 1)
        int id = array.get(rawEdges, k + 2)
        int ct = array.get(rawEdges, k + 3)
        ok := p >= 0 and p < physicalCount and sl >= 0 and id >= 1 and not na(ct)
        int pos = 0
        bool found = false
        while ok and not found and pos < array.size(oldIds)
            int oid = array.get(oldIds, pos)
            if oid == id
                found := true
                ok    := array.get(oldSlots, pos) == sl and array.get(oldTimes, pos) == ct
            else if array.get(oldTimes, pos) > ct or (array.get(oldTimes, pos) == ct and oid > id)
                break
            else
                pos += 1
        if ok and not found
            array.insert(oldIds, pos, id)
            array.insert(oldSlots, pos, sl)
            array.insert(oldTimes, pos, ct)
        pos   := 0
        found := false
        while ok and not found and pos < array.size(newIdx)
            int c = array.get(newIdx, pos) == p ? 0 : physicalNewCompareRaw(store, p, array.get(newIdx, pos))
            if array.get(newIdx, pos) == p
                found := true
            else if c == 0
                ok := false
            else if c < 0
                break
            else
                pos += 1
        if ok and not found
            array.insert(newIdx, pos, p)
        k += 4
    map<int, int> oldRank = map.new<int, int>()
    map<int, int> newRank = map.new<int, int>()
    k := 0
    while ok and k < array.size(oldIds)
        map.put(oldRank, array.get(oldIds, k), k)
        k += 1
    k := 0
    while ok and k < array.size(newIdx)
        map.put(newRank, array.get(newIdx, k), k)
        k += 1
    array<int> es    = array.new_int(0)
    array<int> er    = array.new_int(0)
    k := 0
    while ok and k < rLen
        array.push(es, map.get(oldRank, array.get(rawEdges, k + 2)))
        array.push(er, map.get(newRank, array.get(rawEdges, k)))
        k += 4
    array<int> edgeS = array.new_int(0)
    array<int> edgeR = array.new_int(0)
    array<int> pickS = array.new_int(0)
    array<int> pickR = array.new_int(0)
    int result = -1
    if ok
        result := matchingCanonicalRaw(es, er, array.size(oldIds), array.size(newIdx), edgeS, edgeR, pickS, pickR)
        ok := result >= 0
    int side = 0
    while ok and side < 2
        array<int> os  = side == 0 ? edgeS : pickS
        array<int> ns  = side == 0 ? edgeR : pickR
        array<int> out = side == 0 ? store.physicalIdentityEdges : store.physicalIdentityMatches
        k := 0
        while k < array.size(os)
            array.push(out, array.get(newIdx, array.get(ns, k)))
            array.push(out, array.get(oldSlots, array.get(os, k)))
            array.push(out, array.get(oldIds, array.get(os, k)))
            k += 1
        side += 1
    if not ok
        array.clear(store.physicalIdentityEdges)
        array.clear(store.physicalIdentityMatches)
    store.physicalIdentityEdgeCount  := ok ? int(array.size(store.physicalIdentityEdges) / 3) : 0
    store.physicalIdentityMatchCount := ok ? result : 0
    ok ? result : -1

// Side provenance order of two winners (-1 = the Side is absent): presence, Stage, effective bottom / top tick,
// minRootId, complete rootId ASC Root set lexicographic (shorter first on a common prefix), FVG mode, Psych presence,
// Psych tick. -1 / 1, or 0 on a complete tie.
winnerProvenanceCompareRaw(int v, int w, array<int> stages, array<int> bottomTicks, array<int> topTicks, array<int> minRootIds, array<int> fvgModes, array<int> psychLevelTicks, array<int> rootIdOffsets, array<int> rootIdLengths, array<int> rootIds) =>
    int c = (v >= 0 ? 1 : 0) - (w >= 0 ? 1 : 0)
    if c == 0 and v >= 0
        int pv = array.get(psychLevelTicks, v)
        int pw = array.get(psychLevelTicks, w)
        int k  = 0
        while c == 0 and k < 7
            int x = k == 0 ? array.get(stages, v) : k == 1 ? array.get(bottomTicks, v) : k == 2 ? array.get(topTicks, v) : k == 3 ? array.get(minRootIds, v) : k == 4 ? array.get(fvgModes, v) : k == 5 ? (na(pv) ? 0 : 1) : (na(pv) ? 0 : pv)
            int y = k == 0 ? array.get(stages, w) : k == 1 ? array.get(bottomTicks, w) : k == 2 ? array.get(topTicks, w) : k == 3 ? array.get(minRootIds, w) : k == 4 ? array.get(fvgModes, w) : k == 5 ? (na(pw) ? 0 : 1) : (na(pw) ? 0 : pw)
            c := x - y
            // the Root set is compared right after minRootId (key 4 of the descriptor)
            if c == 0 and k == 3
                int a    = array.get(rootIdOffsets, v)
                int b    = array.get(rootIdOffsets, w)
                int aEnd = a + array.get(rootIdLengths, v)
                int bEnd = b + array.get(rootIdLengths, w)
                while c == 0 and a < aEnd and b < bEnd
                    c := array.get(rootIds, a) - array.get(rootIds, b)
                    a += 1
                    b += 1
                if c == 0
                    c := (aEnd - a) - (bEnd - b)
            k += 1
    c > 0 ? 1 : c < 0 ? -1 : 0

// Builds the ownership plan of the current physical Candidates from physicalIdentityMatches (identityMatchCount must
// equal this pass's physicalIdentityMatchCount) and returns the fresh count. Every selected match must name a live old
// Core with coreIds[slot] == coreId >= 1 and generationId >= 1, each physical Candidate and each old Core at most once.
// Fresh Candidates are ranked by physicalNewCompareRaw, then Support and Resistance winnerProvenanceCompareRaw; a
// complete tie fails (no index or storage fallback). -1 with empty ownership storage on any fault.
export ownershipPlanBuild(W08Store store, int identityMatchCount, array<bool> coreLive, array<int> coreIds, array<int> coreGenerationIds, array<int> candidateWinnerStages, array<int> candidateWinnerEffectiveBottomTicks, array<int> candidateWinnerEffectiveTopTicks, array<int> candidateWinnerMinRootIds, array<int> candidateWinnerFvgModes, array<int> candidateWinnerPsychLevelTicks, array<int> candidateWinnerRootIdOffsets, array<int> candidateWinnerRootIdLengths, array<int> candidateWinnerRootIds, int candidateWinnerRootIdLength) =>
    store.physicalMaterializedLogicalCount := 0
    array.clear(store.physicalOwnershipKinds)
    array.clear(store.physicalContinuationOldCoreSlots)
    array.clear(store.physicalContinuationCoreIds)
    array.clear(store.physicalContinuationGenerationIds)
    array.clear(store.physicalFreshAllocationRanks)
    int  n  = store.physicalCandidateLogicalCount
    bool ok = identityMatchCount >= 0 and identityMatchCount == store.physicalIdentityMatchCount and array.size(store.physicalIdentityMatches) == 3 * identityMatchCount and candidateWinnerRootIdLength <= array.size(candidateWinnerRootIds)
    int k = 0
    while ok and k < n
        array.push(store.physicalOwnershipKinds, 1)
        array.push(store.physicalContinuationOldCoreSlots, -1)
        array.push(store.physicalContinuationCoreIds, 0)
        array.push(store.physicalContinuationGenerationIds, 0)
        array.push(store.physicalFreshAllocationRanks, -1)
        // every present Side winner must hold a valid Root slice (read by the provenance order)
        int side = 0
        while ok and side < 2
            int w = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, k) : array.get(store.physicalCandidateResistanceWinnerIndexes, k)
            if w >= 0
                ok := w < array.size(candidateWinnerStages) and w < array.size(candidateWinnerEffectiveBottomTicks) and w < array.size(candidateWinnerEffectiveTopTicks) and w < array.size(candidateWinnerMinRootIds) and w < array.size(candidateWinnerFvgModes) and w < array.size(candidateWinnerPsychLevelTicks) and w < array.size(candidateWinnerRootIdOffsets) and w < array.size(candidateWinnerRootIdLengths)
                if ok
                    ok := array.get(candidateWinnerRootIdOffsets, w) >= 0 and array.get(candidateWinnerRootIdLengths, w) >= 0 and array.get(candidateWinnerRootIdOffsets, w) + array.get(candidateWinnerRootIdLengths, w) <= candidateWinnerRootIdLength
            side += 1
        k += 1
    map<int, bool> usedOld = map.new<int, bool>()
    k := 0
    while ok and k < identityMatchCount
        int p    = array.get(store.physicalIdentityMatches, 3 * k)
        int slot = array.get(store.physicalIdentityMatches, 3 * k + 1)
        int id   = array.get(store.physicalIdentityMatches, 3 * k + 2)
        ok := p >= 0 and p < n and slot >= 0 and slot < array.size(coreLive) and slot < array.size(coreIds) and slot < array.size(coreGenerationIds) and id >= 1 and not map.contains(usedOld, id)
        if ok
            ok := array.get(store.physicalOwnershipKinds, p) == 1 and array.get(coreLive, slot) and array.get(coreIds, slot) == id and array.get(coreGenerationIds, slot) >= 1
        if ok
            map.put(usedOld, id, true)
            array.set(store.physicalOwnershipKinds, p, 0)
            array.set(store.physicalContinuationOldCoreSlots, p, slot)
            array.set(store.physicalContinuationCoreIds, p, id)
            array.set(store.physicalContinuationGenerationIds, p, array.get(coreGenerationIds, slot))
        k += 1
    // fresh allocation order (insertion into a sorted list)
    array<int> fresh = array.new_int(0)
    k := 0
    while ok and k < n
        if array.get(store.physicalOwnershipKinds, k) == 1
            int pos = 0
            int c   = 1
            while ok and c > 0 and pos < array.size(fresh)
                int q = array.get(fresh, pos)
                c := physicalNewCompareRaw(store, k, q)
                int side = 0
                while c == 0 and side < 2
                    int v = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, k) : array.get(store.physicalCandidateResistanceWinnerIndexes, k)
                    int w = side == 0 ? array.get(store.physicalCandidateSupportWinnerIndexes, q) : array.get(store.physicalCandidateResistanceWinnerIndexes, q)
                    c := winnerProvenanceCompareRaw(v, w, candidateWinnerStages, candidateWinnerEffectiveBottomTicks, candidateWinnerEffectiveTopTicks, candidateWinnerMinRootIds, candidateWinnerFvgModes, candidateWinnerPsychLevelTicks, candidateWinnerRootIdOffsets, candidateWinnerRootIdLengths, candidateWinnerRootIds)
                    side += 1
                ok := c != 0
                if c > 0
                    pos += 1
            if ok
                array.insert(fresh, pos, k)
        k += 1
    k := 0
    while ok and k < array.size(fresh)
        array.set(store.physicalFreshAllocationRanks, array.get(fresh, k), k)
        k += 1
    if not ok
        array.clear(store.physicalOwnershipKinds)
        array.clear(store.physicalContinuationOldCoreSlots)
        array.clear(store.physicalContinuationCoreIds)
        array.clear(store.physicalContinuationGenerationIds)
        array.clear(store.physicalFreshAllocationRanks)
    store.physicalFreshAllocationCount := ok ? array.size(fresh) : 0
    ok ? array.size(fresh) : -1

// Read-only failure predicate of coreIndexRelease: the origin chain of coreSlot holds only live nodes of this slot and
// expectedCoreId and its length matches the row count, the interval tuple is in both orders or in neither with the
// same ticks (intervalDetachCheckRaw), and the inverse storage has whole 3-value groups.
export coreIndexCanRelease(W08Store store, int coreSlot, int expectedCoreId) =>
    bool ok    = coreSlot >= 0 and expectedCoreId != ID_NONE and array.size(store.inverseOriginData) % 3 == 0
    int  cur   = SLOT_INVALID
    int  total = 0
    if ok and coreSlot < array.size(store.coreZoneOriginRootCounts)
        cur   := array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        total := array.get(store.coreZoneOriginRootCounts, coreSlot)
    int n = 0
    while ok and cur != SLOT_INVALID
        ok := cur >= 0 and cur < array.size(store.coreZoneOriginRootNodeRootIds) and n < total
        if ok
            ok := array.get(store.coreZoneOriginRootNodeLiveFlags, cur) and array.get(store.coreZoneOriginRootNodeOwnerCoreSlots, cur) == coreSlot and array.get(store.coreZoneOriginRootNodeExpectedCoreIds, cur) == expectedCoreId
        n += 1
        if ok
            cur := array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
    ok := ok and n == total
    if ok
        [iOk, iK, iJ] = intervalDetachCheckRaw(store, coreSlot, expectedCoreId)
        ok := iOk
    ok

// Removes every Worker entry of the Core (coreSlot, expectedCoreId): its whole origin chain (each node reclaimed to the
// free list, topologyRevision bumped once when a node goes), its interval tuple in both orders and every inverse-origin
// tuple of that slot and ID. Applies only when coreIndexCanRelease holds (then nothing below can fail); else false and
// nothing changes.
export coreIndexRelease(W08Store store, int coreSlot, int expectedCoreId) =>
    bool ok = coreIndexCanRelease(store, coreSlot, expectedCoreId)
    if ok
        [dOk, dChanged] = intervalDetach(store, coreSlot, expectedCoreId)
        int cur = SLOT_INVALID
        if coreSlot < array.size(store.coreZoneOriginRootCounts)
            cur := array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot)
        if cur != SLOT_INVALID
            array.set(store.coreZoneOriginRootHeadNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootTailNodeIndexes, coreSlot, SLOT_INVALID)
            array.set(store.coreZoneOriginRootCounts,          coreSlot, 0)
            store.topologyRevision := store.topologyRevision + 1
        while cur != SLOT_INVALID
            int nx = array.get(store.coreZoneOriginRootNodeNextIndexes, cur)
            array.set(store.coreZoneOriginRootNodeRootIds,               cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeNextIndexes,           cur, SLOT_INVALID)
            array.set(store.coreZoneOriginRootNodeOwnerCoreSlots,        cur, SLOT_INVALID)
            array.set(store.coreZoneOriginRootNodeExpectedCoreIds,       cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeExpectedGenerationIds, cur, ID_NONE)
            array.set(store.coreZoneOriginRootNodeLiveFlags,             cur, false)
            array.push(store.coreZoneOriginRootNodeFreeIndexes, cur)
            cur := nx
        array<int> d = store.inverseOriginData
        int w = 0
        int k = 0
        while k < array.size(d)
            if not (array.get(d, k + 1) == coreSlot and array.get(d, k + 2) == expectedCoreId)
                array.set(d, w,     array.get(d, k))
                array.set(d, w + 1, array.get(d, k + 1))
                array.set(d, w + 2, array.get(d, k + 2))
                w += 3
            k += 3
        while array.size(d) > w
            array.pop(d)
    ok

// Read-only install predicate of one target Core after its release (or on a clean slot): every Root ID passes the
// originAdd / inverseOriginAdd input predicates and is strictly ascending (no duplicate node), and the interval tuple
// passes the intervalInsert input predicate. With no tuple of (coreSlot, coreId) left, originAdd / intervalInsert /
// inverseOriginAdd then cannot fail on this Core.
export coreIndexCanInstall(W08Store store, int coreSlot, int coreId, float physicalBottom, float physicalTop, float mintick, array<int> rootIds, int rootStart, int rootLen) =>
    bool ok   = rootStart >= 0 and rootLen > 0 and rootStart + rootLen <= array.size(rootIds) and intervalInsertInputOkRaw(store, coreSlot, coreId, coreId, physicalBottom, physicalTop, mintick)
    int  last = 0
    int  r    = 0
    while ok and r < rootLen
        int rootId = array.get(rootIds, rootStart + r)
        ok   := rootId > last and originAddInputOkRaw(coreSlot, coreId, rootId) and inverseOriginInputOkRaw(store, rootId, coreSlot, coreId)
        last := rootId
        r += 1
    ok

// true when coreSlot holds no Worker entry of any Core ID: no origin node counted on the slot, no interval tuple in
// either order and no inverse-origin tuple naming the slot.
export coreIndexClean(W08Store store, int coreSlot) =>
    bool clean = coreSlot >= 0 and array.size(store.coreIntervalTopOrderData) == array.size(store.coreIntervalOrderData)
    if clean and coreSlot < array.size(store.coreZoneOriginRootCounts)
        clean := array.get(store.coreZoneOriginRootCounts, coreSlot) == 0 and array.get(store.coreZoneOriginRootHeadNodeIndexes, coreSlot) == SLOT_INVALID
    int k = 0
    while clean and k < array.size(store.coreIntervalOrderData)
        clean := array.get(store.coreIntervalOrderData, k) != coreSlot and array.get(store.coreIntervalTopOrderData, k) != coreSlot
        k += 4
    k := 0
    while clean and k < array.size(store.inverseOriginData)
        clean := array.get(store.inverseOriginData, k + 1) != coreSlot
        k += 3
    clean

// Canonical Identity edge order: old canonical order (coreCreatedTime, coreId ASC), inside one old strictly ascending
// physicalNewCompareRaw (so no edge repeats). Edge k (> 0) must follow the previous edge (lastCt, lastId, lastP).
identityEdgeFollowsRaw(W08Store store, int k, int ct, int id, int p, int lastCt, int lastId, int lastP) =>
    bool ok = k == 0 or ct > lastCt or (ct == lastCt and id > lastId)
    if not ok and k > 0 and ct == lastCt and id == lastId
        ok := physicalNewCompareRaw(store, lastP, p) < 0
    ok

// Builds the Merge relations of the current pass from physicalIdentityEdges and physicalIdentityMatches (ownershipResult
// must equal this pass's physicalFreshAllocationCount) and returns the relation count. Every edge must name a live old
// Core with coreIds[slot] == coreId >= 1, a set coreCreatedTime and one slot per coreId, edges in canonical old order
// with no repeat; a Candidate holds at most one match and that match must be one of its edges. Relation order =
// physicalNewCompareRaw (complete ties fail). Only the Merge storage is written; -1 with it empty on any fault.
export mergePlanBuild(W08Store store, int ownershipResult, array<bool> coreLive, array<int> coreIds, array<int> coreCreatedTimes) =>
    array.clear(store.mergeRelations)
    array.clear(store.mergeAbsorbed)
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nm = store.physicalIdentityMatchCount
    array<int> ed = store.physicalIdentityEdges
    bool ok = ownershipResult >= 0 and ownershipResult == store.physicalFreshAllocationCount and array.size(ed) == 3 * ne and array.size(store.physicalIdentityMatches) == 3 * nm
    array<int>  deg      = array.new_int(ok ? n : 0, 0)
    array<int>  matchId  = array.new_int(ok ? n : 0, 0)
    array<int>  matchSl  = array.new_int(ok ? n : 0, -1)
    array<bool> matchHit = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < nm
        int p = array.get(store.physicalIdentityMatches, 3 * k)
        ok := p >= 0 and p < n
        if ok
            ok := array.get(matchId, p) == 0 and array.get(store.physicalIdentityMatches, 3 * k + 2) >= 1
            array.set(matchSl, p, array.get(store.physicalIdentityMatches, 3 * k + 1))
            array.set(matchId, p, array.get(store.physicalIdentityMatches, 3 * k + 2))
        k += 1
    map<int, int> slotOf = map.new<int, int>()
    int lastCt = 0
    int lastId = 0
    int lastP  = -1
    k := 0
    while ok and k < ne
        int p  = array.get(ed, 3 * k)
        int sl = array.get(ed, 3 * k + 1)
        int id = array.get(ed, 3 * k + 2)
        ok := p >= 0 and p < n and sl >= 0 and sl < array.size(coreLive) and sl < array.size(coreIds) and sl < array.size(coreCreatedTimes) and id >= 1
        if ok
            ok := array.get(coreLive, sl) and array.get(coreIds, sl) == id and not na(array.get(coreCreatedTimes, sl)) and (not map.contains(slotOf, id) or map.get(slotOf, id) == sl)
        if ok
            int ct = array.get(coreCreatedTimes, sl)
            ok := identityEdgeFollowsRaw(store, k, ct, id, p, lastCt, lastId, lastP)
            map.put(slotOf, id, sl)
            array.set(deg, p, array.get(deg, p) + 1)
            if array.get(matchId, p) == id
                ok := ok and array.get(matchSl, p) == sl and not array.get(matchHit, p)
                array.set(matchHit, p, true)
            lastCt := ct
            lastId := id
            lastP  := p
        k += 1
    k := 0
    while ok and k < n
        ok := array.get(matchId, k) == 0 or array.get(matchHit, k)
        k += 1
    // Merge targets (degree >= 2) in new canonical order
    array<int> targets = array.new_int(0)
    k := 0
    while ok and k < n
        if array.get(deg, k) >= 2
            int pos = 0
            int c   = 1
            while ok and c > 0 and pos < array.size(targets)
                c  := physicalNewCompareRaw(store, k, array.get(targets, pos))
                ok := c != 0
                if c > 0
                    pos += 1
            if ok
                array.insert(targets, pos, k)
        k += 1
    int t = 0
    while ok and t < array.size(targets)
        int p   = array.get(targets, t)
        int off = int(array.size(store.mergeAbsorbed) / 2)
        k := 0
        while k < ne
            if array.get(ed, 3 * k) == p and array.get(ed, 3 * k + 2) != array.get(matchId, p)
                array.push(store.mergeAbsorbed, array.get(ed, 3 * k + 1))
                array.push(store.mergeAbsorbed, array.get(ed, 3 * k + 2))
            k += 1
        array.push(store.mergeRelations, p)
        array.push(store.mergeRelations, array.get(matchSl, p))
        array.push(store.mergeRelations, array.get(matchId, p))
        array.push(store.mergeRelations, off)
        array.push(store.mergeRelations, int(array.size(store.mergeAbsorbed) / 2) - off)
        t += 1
    if not ok
        array.clear(store.mergeRelations)
        array.clear(store.mergeAbsorbed)
    store.mergeRelationCount        := ok ? array.size(targets) : 0
    store.mergeAbsorbedLogicalCount := ok ? int(array.size(store.mergeAbsorbed) / 2) : 0
    ok ? array.size(targets) : -1

// Builds the Split relations of the current pass from physicalIdentityEdges, physicalIdentityMatches and the ownership
// plan (mergeResult must equal this pass's mergeRelationCount) and returns the relation count. Edge rows are validated
// as in mergePlanBuild; every match must be a full edge, each old / Candidate matched at most once, and the matched
// Candidate must be the continuation of that old in the ownership plan (the continuation count equals the match
// count). Edges already run in old canonical order with each old's Candidates in new canonical order, so a relation is
// one old's edge run of length >= 2. Only the Split storage is written; -1 with it empty on any fault.
export splitPlanBuild(W08Store store, int mergeResult, array<bool> coreLive, array<int> coreIds, array<int> coreCreatedTimes) =>
    array.clear(store.splitRelations)
    array.clear(store.splitChildren)
    int  n  = store.physicalCandidateLogicalCount
    int  ne = store.physicalIdentityEdgeCount
    int  nm = store.physicalIdentityMatchCount
    array<int> ed = store.physicalIdentityEdges
    array<int> mt = store.physicalIdentityMatches
    bool ok = mergeResult >= 0 and mergeResult == store.mergeRelationCount and array.size(ed) == 3 * ne and array.size(mt) == 3 * nm and array.size(store.physicalOwnershipKinds) == n and array.size(store.physicalContinuationOldCoreSlots) == n and array.size(store.physicalContinuationCoreIds) == n
    map<int, int> contOf = map.new<int, int>()
    array<bool> usedP = array.new_bool(ok ? n : 0, false)
    int k = 0
    while ok and k < nm
        int p  = array.get(mt, 3 * k)
        int sl = array.get(mt, 3 * k + 1)
        int id = array.get(mt, 3 * k + 2)
        ok := p >= 0 and p < n and id >= 1 and not map.contains(contOf, id)
        if ok
            ok := not array.get(usedP, p) and array.get(store.physicalOwnershipKinds, p) == 0 and array.get(store.physicalContinuationOldCoreSlots, p) == sl and array.get(store.physicalContinuationCoreIds, p) == id
            array.set(usedP, p, true)
            map.put(contOf, id, p)
        k += 1
    int conts = 0
    k := 0
    while ok and k < n
        if array.get(store.physicalOwnershipKinds, k) == 0
            conts += 1
        k += 1
    ok := ok and conts == nm
    map<int, int> slotOf = map.new<int, int>()
    int hits   = 0
    int lastCt = 0
    int lastId = 0
    int lastP  = -1
    k := 0
    while ok and k < ne
        int p  = array.get(ed, 3 * k)
        int sl = array.get(ed, 3 * k + 1)
        int id = array.get(ed, 3 * k + 2)
        ok := p >= 0 and p < n and sl >= 0 and sl < array.size(coreLive) and sl < array.size(coreIds) and sl < array.size(coreCreatedTimes) and id >= 1
        if ok
            ok := array.get(coreLive, sl) and array.get(coreIds, sl) == id and not na(array.get(coreCreatedTimes, sl)) and (not map.contains(slotOf, id) or map.get(slotOf, id) == sl)
        if ok
            int ct = array.get(coreCreatedTimes, sl)
            ok := identityEdgeFollowsRaw(store, k, ct, id, p, lastCt, lastId, lastP)
            map.put(slotOf, id, sl)
            if map.contains(contOf, id)
                if map.get(contOf, id) == p
                    ok := ok and array.get(store.physicalContinuationOldCoreSlots, p) == sl
                    hits += 1
            lastCt := ct
            lastId := id
            lastP  := p
        k += 1
    ok := ok and hits == nm
    // one relation per old edge run of length >= 2 (run order = old canonical order, rows = new canonical order)
    int a = 0
    while ok and a < ne
        int id = array.get(ed, 3 * a + 2)
        int b  = a + 1
        while b < ne and array.get(ed, 3 * b + 2) == id
            b += 1
        if b - a >= 2
            int off  = array.size(store.splitChildren)
            int cont = -1
            if map.contains(contOf, id)
                cont := map.get(contOf, id)
            k := a
            while k < b
                array.push(store.splitChildren, array.get(ed, 3 * k))
                k += 1
            array.push(store.splitRelations, array.get(ed, 3 * a + 1))
            array.push(store.splitRelations, id)
            array.push(store.splitRelations, cont)
            array.push(store.splitRelations, off)
            array.push(store.splitRelations, b - a)
        a := b
    if not ok
        array.clear(store.splitRelations)
        array.clear(store.splitChildren)
    store.splitRelationCount     := ok ? int(array.size(store.splitRelations) / 5) : 0
    store.splitChildLogicalCount := ok ? array.size(store.splitChildren) : 0
    ok ? int(array.size(store.splitRelations) / 5) : -1

export type PendingTopologyStore
    array<bool>  corePendingTopologyFlags
    array<int>   corePendingTopologyChildHeadIndexes
    array<int>   corePendingTopologyChildTailIndexes
    array<int>   corePendingTopologyChildCounts
    array<int>   pendingTopologyChildNextIndexes
    array<int>   pendingTopologyChildOwnerCoreSlots
    array<int>   pendingTopologyChildExpectedCoreIds
    array<int>   pendingTopologyChildExpectedGenerationIds
    array<int>   pendingTopologyChildRootHeadNodeIndexes
    array<int>   pendingTopologyChildRootTailNodeIndexes
    array<int>   pendingTopologyChildRootCounts
    array<bool>  pendingTopologyChildLiveFlags
    array<int>   pendingTopologyChildFreeIndexes
    array<int>   pendingTopologyRootNodeRootIds
    array<int>   pendingTopologyRootNodeNextIndexes
    array<int>   pendingTopologyRootNodeOwnerChildIndexes
    array<int>   pendingTopologyRootNodeExpectedCoreIds
    array<int>   pendingTopologyRootNodeExpectedGenerationIds
    array<bool>  pendingTopologyRootNodeLiveFlags
    array<int>   pendingTopologyRootNodeFreeIndexes












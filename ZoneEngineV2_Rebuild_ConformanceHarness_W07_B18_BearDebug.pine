//@version=6
// ============================================================
// ZoneEngineV2_Rebuild_ConformanceHarness_W07_B18_BearDebug.pine
// W07 B18 DIAGNOSTIC ONLY : a copy of ZoneEngineV2_Rebuild_ConformanceHarness_W07_B18_Inverse.pine (same fixtures,
// expected values, Reference expressions and comparisons) that additionally records, for fixture 3 (BI3, Bull
// control), 9 (BEI2), 17 (BD3) and 18 (BD4), the Reference inputs / sub-expressions and the Production state /
// progress before and after the diagnosed bar, into a DebugOut holder shown in the Data Window. Build marker 180202 (R2: direction dataflow trace for
// fixtures 3 / 9 / 17 in DebugOut.trace, 9 values each).
// The original description of the copied harness follows.
// W07 B18 : FVG Inverse lifecycle / eligibility direction / InverseConfirm Touch non-consumption / Root identity,
// end to end on the published Main. Production lane = ZoneEngineV2_Rebuild /21 through newCfg / validateCfg /
// newEngine / newFeed / updateConfirmed5m, observed through rootCount / rootAt and the exported ZoneEngine /
// W02AuxStore fields (read only). Every Root is created and invalidated through Feeds (1H formation, then a 1H
// structural source close), never injected.
// Current Production path (read-only audit): Stage D structural invalidation -> Stage E W07 inverseFacts on the
// committed wait set (+ pending preflight) -> Stage F W03 apply, then W07 inverseStageFCommitWithConfirm (pending
// apply, ACTIVE seed / dirty, confirm list, wait entry of this bar's invalidations). So the invalidation bar ends at
// ROOT_INVERSE_WAIT / progress WAIT_MOVED_AWAY and its close never counts as moved away.
// Reference lane = w07RefInverseNaiveRaw here (primitive comparisons only, no Production helper, no Production
// progress as input): WAIT -> MOVED_AWAY when Bull close <= bottom - reset / Bear close >= top + reset;
// MOVED_AWAY -> ACTIVE (touch and confirm) or RETOUCHED (touch only), touch = low <= top and high >= bottom;
// RETOUCHED -> ACTIVE when Bull close <= bottom / Bear close >= top. Confirmed 5m High / Low / Close only.
// 22 fixed deterministic fixtures run once on the last bar (no market data, no request.*, no bar_index / timenow,
// no random). Numbering: 1..7 BI1..BI7, 8..14 BEI1..BEI7, 15..18 BD1..BD4, 19..20 EL1..EL2, 21..22 T1..T2.
// ============================================================
indicator("ZoneEngineV2 W07 B18 Bear Debug", overlay = false)

import sekine3310/ZoneEngineV2_Rebuild/22 as ZE

// exact mirrors of the current Main enums and W07 /10 progress values
const int   CAT_FVG             = 4
const int   ROOT_ACTIVE         = 1
const int   ROOT_INVERSE_WAIT   = 3
const int   ROOT_INVERSE_ACTIVE = 4
const int   PROG_NONE           = 0
const int   PROG_WAIT           = 1
const int   PROG_MOVED_AWAY     = 2
const int   PROG_RETOUCHED      = 3
const int   PROG_ACTIVE         = 4
const int   FVG_BULLISH         = 1
const int   FVG_BEARISH         = 2
const int   TF_1H               = 60
const float FX_MINTICK          = 1.0
const float FX_RESET_DISTANCE   = 10.0
const float FX_BOTTOM           = 100.0
const float FX_TOP              = 110.0
const int   FX_T0               = 1700000000000
const int   FX_H                = 3600000
const int   FX_M5               = 300000
const int   FX_COUNT            = 22

// compare codes
const int CMP_NONE            = 0
const int CMP_CFG_INVALID     = 1
const int CMP_NOT_COMMITTED   = 2
const int CMP_ROOT_COUNT      = 3
const int CMP_ROOT_MISSING    = 4
const int CMP_IDENTITY        = 5
const int CMP_STATE           = 6
const int CMP_PROGRESS        = 7
const int CMP_SET_MEMBERSHIP  = 8
const int CMP_CONFIRM_COUNT   = 9
const int CMP_CONFIRM_ROOT    = 10
const int CMP_ELIGIBILITY     = 11
const int CMP_TOUCH_FIELDS    = 12
const int CMP_EXPECT_FINAL    = 13

// one confirmed 5m base bar; srcClosePrice is the 1H structural close of this bar (na: none); bar 0 forms the FVG
type FxBar
    int   closeTime
    float high
    float low
    float close
    float srcClosePrice

type RefRoot
    int state
    int progress
    int direction
    int bottomTick
    int topTick
    int resetTick

// diagnostic holder (tag 1 = BEI2 WAIT -> MOVED bar, 2 = BD3 moved-away bar, 3 = BD4 confirm bar, 4 = BI3 confirm bar)
type DebugOut
    float bei2High
    float bei2Low
    float bei2Close
    float bei2ResetTick
    float bei2RefDir
    float bei2RefBottom
    float bei2RefTop
    float bei2RefStateBefore
    float bei2RefProgBefore
    float bei2Threshold
    float bei2Moved
    float bei2RefStateAfter
    float bei2RefProgAfter
    float bei2OptDir
    float bei2OptBottom
    float bei2OptTop
    float bei2OptStateBefore
    float bei2OptProgBefore
    float bei2OptStateAfter
    float bei2OptProgAfter
    float bei2IsBull
    float bei2IsBear
    float bei2CloseGETop
    float bei2TopPlusReset
    float bei2CloseGETopPlusReset
    float bd3Close
    float bd3Top
    float bd3Reset
    float bd3Threshold
    float bd3Moved
    float bd3RefProgAfter
    float bd3OptProgAfter
    float bd4Close
    float bd4Top
    float bd4RefStateBefore
    float bd4RefProgBefore
    float bd4Confirm
    float bd4RefStateAfter
    float bd4RefProgAfter
    float bd4OptStateAfter
    float bd4OptProgAfter
    float bi3Close
    float bi3Bottom
    float bi3Confirm
    float bi3RefStateAfter
    float bi3RefProgAfter
    float bi3OptStateAfter
    float bi3OptProgAfter
    array<float> trace

b01(bool v) =>
    v ? 1.0 : 0.0
// values seen inside the Reference right where its expressions are evaluated (no expression changed)
dbgRefInside(DebugOut d, int tag, RefRoot r, int hiTick, int loTick, int clTick, bool isBull, bool confirm) =>
    if tag == 1
        d.bei2High           := hiTick
        d.bei2Low            := loTick
        d.bei2Close          := clTick
        d.bei2ResetTick      := r.resetTick
        d.bei2RefDir         := r.direction
        d.bei2RefBottom      := r.bottomTick
        d.bei2RefTop         := r.topTick
        d.bei2IsBull         := b01(isBull)
        d.bei2IsBear         := b01(not isBull)
        d.bei2CloseGETop     := b01(clTick >= r.topTick)
        d.bei2TopPlusReset   := r.topTick + r.resetTick
        d.bei2CloseGETopPlusReset := b01(clTick >= r.topTick + r.resetTick)
        d.bei2Threshold      := isBull ? r.bottomTick - r.resetTick : r.topTick + r.resetTick
    else if tag == 2
        d.bd3Close     := clTick
        d.bd3Top       := r.topTick
        d.bd3Reset     := r.resetTick
        d.bd3Threshold := isBull ? r.bottomTick - r.resetTick : r.topTick + r.resetTick
    else if tag == 3
        d.bd4Close   := clTick
        d.bd4Top     := r.topTick
        d.bd4Confirm := b01(confirm)
    else if tag == 4
        d.bi3Close   := clTick
        d.bi3Bottom  := r.bottomTick
        d.bi3Confirm := b01(confirm)
    true
dbgRefMoved(DebugOut d, int tag, bool moved) =>
    if tag == 1
        d.bei2Moved := b01(moved)
    else if tag == 2
        d.bd3Moved := b01(moved)
    true
dbgRefBefore(DebugOut d, int tag, RefRoot r) =>
    if tag == 1
        d.bei2RefStateBefore := r.state
        d.bei2RefProgBefore  := r.progress
    else if tag == 3
        d.bd4RefStateBefore := r.state
        d.bd4RefProgBefore  := r.progress
    true
dbgRefAfter(DebugOut d, int tag, RefRoot r) =>
    if tag == 1
        d.bei2RefStateAfter := r.state
        d.bei2RefProgAfter  := r.progress
    else if tag == 2
        d.bd3RefProgAfter := r.progress
    else if tag == 3
        d.bd4RefStateAfter := r.state
        d.bd4RefProgAfter  := r.progress
    else if tag == 4
        d.bi3RefStateAfter := r.state
        d.bi3RefProgAfter  := r.progress
    true
// R2 trace slots: group 0 = fixture 9, 1 = fixture 17, 2 = fixture 3; k = 0 RunFixture Arg, 1 FxBuild Arg,
// 2 FxBuild IsBullFx, 3 FxBuild Dir, 4 Tuple Dir After Return, 5 RefRoot Direction, 6 OptFeed BullNew,
// 7 OptFeed BearNew, 8 Opt Root Direction. Each slot is written by exactly one site, once per run.
trGroup(int fx) =>
    fx == 9 ? 0 : fx == 17 ? 1 : fx == 3 ? 2 : -1
trSet(DebugOut d, int fx, int k, float v) =>
    int g = trGroup(fx)
    if g >= 0
        array.set(d.trace, g * 9 + k, v)
    true
dbgOpt(DebugOut d, int tag, int stateBefore, int progBefore, int stateAfter, int progAfter, int dir, int bottomTick, int topTick) =>
    if tag == 1
        d.bei2OptDir         := dir
        d.bei2OptBottom      := bottomTick
        d.bei2OptTop         := topTick
        d.bei2OptStateBefore := stateBefore
        d.bei2OptProgBefore  := progBefore
        d.bei2OptStateAfter  := stateAfter
        d.bei2OptProgAfter   := progAfter
    else if tag == 2
        d.bd3OptProgAfter := progAfter
    else if tag == 3
        d.bd4OptStateAfter := stateAfter
        d.bd4OptProgAfter  := progAfter
    else if tag == 4
        d.bi3OptStateAfter := stateAfter
        d.bi3OptProgAfter  := progAfter
    true

fxBar(array<FxBar> bars, float high, float low, float close, float srcClosePrice) =>
    int i = array.size(bars)
    int closeTime = i == 0 ? FX_T0 + FX_H : i == 1 ? FX_T0 + 2 * FX_H + FX_M5 : FX_T0 + 2 * FX_H + i * FX_M5
    array.push(bars, FxBar.new(closeTime, high, low, close, srcClosePrice))
    array.size(bars)
// formation bar + invalidation bar (1H source close breaks the Distal; the base close also meets moved-away)
fxStart(array<FxBar> bars, int dir) =>
    fxBar(bars, 500.0, 490.0, 495.0, na)
    if dir == FVG_BULLISH
        fxBar(bars, 95.0, 85.0, 90.0, 99.0)
    else
        fxBar(bars, 125.0, 115.0, 120.0, 111.0)
    array.size(bars)
fxMovedBull(array<FxBar> bars) =>
    fxBar(bars, 95.0, 85.0, 88.0, na)
fxMovedBear(array<FxBar> bars) =>
    fxBar(bars, 125.0, 115.0, 122.0, na)

// returns [bars, direction, expectFinalState, expectFinalProgress]
fxBuild(int fx, DebugOut dbg) =>
    array<FxBar> bars = array.new<FxBar>()
    // direction selector: the Bull test is a parenthesised bool first; `a or b ? x : y` must not be written here
    // (TradingView evaluated the old one-line form as Bull for every fixture)
    bool isBullFx = (fx <= 7) or (fx == 15) or (fx == 16) or (fx == 19) or (fx == 21)
    int dir = isBullFx ? FVG_BULLISH : FVG_BEARISH
    trSet(dbg, fx, 1, fx)
    trSet(dbg, fx, 2, isBullFx ? 1.0 : 0.0)
    trSet(dbg, fx, 3, dir)
    int expState = ROOT_INVERSE_WAIT
    int expProg  = PROG_WAIT
    fxStart(bars, dir)
    if fx == 1
        // BI1 invalidation bar close also meets moved-away : WAIT only
        expProg := PROG_WAIT
    else if fx == 2
        // BI2 WAIT, moved-away + range touch + confirm-side close on one bar : MOVED_AWAY only
        fxBar(bars, 105.0, 85.0, 88.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 3
        // BI3 MOVED_AWAY, touch + close <= bottom : ACTIVE on the same bar (2 -> 4)
        fxMovedBull(bars)
        fxBar(bars, 105.0, 95.0, 99.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 4
        // BI4 MOVED_AWAY, touch + close > bottom : RETOUCHED (2 -> 3)
        fxMovedBull(bars)
        fxBar(bars, 105.0, 99.0, 102.0, na)
        expProg := PROG_RETOUCHED
    else if fx == 5
        // BI5 RETOUCHED, close <= bottom : ACTIVE (3 -> 4)
        fxMovedBull(bars)
        fxBar(bars, 105.0, 99.0, 102.0, na)
        fxBar(bars, 103.0, 98.0, 99.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 6
        // BI6 MOVED_AWAY, no touch, close <= bottom : stays MOVED_AWAY
        fxMovedBull(bars)
        fxBar(bars, 99.0, 90.0, 95.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 7
        // BI7 RETOUCHED, close > bottom : stays RETOUCHED
        fxMovedBull(bars)
        fxBar(bars, 105.0, 99.0, 102.0, na)
        fxBar(bars, 108.0, 101.0, 105.0, na)
        expProg := PROG_RETOUCHED
    else if fx == 8
        // BEI1
        expProg := PROG_WAIT
    else if fx == 9
        // BEI2
        fxBar(bars, 125.0, 105.0, 122.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 10
        // BEI3
        fxMovedBear(bars)
        fxBar(bars, 115.0, 105.0, 111.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 11
        // BEI4
        fxMovedBear(bars)
        fxBar(bars, 111.0, 101.0, 108.0, na)
        expProg := PROG_RETOUCHED
    else if fx == 12
        // BEI5
        fxMovedBear(bars)
        fxBar(bars, 111.0, 101.0, 108.0, na)
        fxBar(bars, 112.0, 107.0, 111.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 13
        // BEI6
        fxMovedBear(bars)
        fxBar(bars, 120.0, 111.0, 115.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 14
        // BEI7
        fxMovedBear(bars)
        fxBar(bars, 111.0, 101.0, 108.0, na)
        fxBar(bars, 109.0, 102.0, 105.0, na)
        expProg := PROG_RETOUCHED
    else if fx == 15
        // BD1 Bull moved-away close == bottom - reset
        fxBar(bars, 95.0, 85.0, 90.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 16
        // BD2 Bull confirm close == bottom
        fxMovedBull(bars)
        fxBar(bars, 105.0, 95.0, 100.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 17
        // BD3 Bear moved-away close == top + reset
        fxBar(bars, 125.0, 115.0, 120.0, na)
        expProg := PROG_MOVED_AWAY
    else if fx == 18
        // BD4 Bear confirm close == top
        fxMovedBear(bars)
        fxBar(bars, 115.0, 105.0, 110.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 19
        // EL1 Bull inverse : Resistance eligibility change only
        fxMovedBull(bars)
        fxBar(bars, 105.0, 95.0, 99.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 20
        // EL2 Bear inverse : Support eligibility change only
        fxMovedBear(bars)
        fxBar(bars, 115.0, 105.0, 111.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else if fx == 21
        // T1 Bull inverse confirm, then one more accepted bar without a confirm
        fxMovedBull(bars)
        fxBar(bars, 105.0, 95.0, 99.0, na)
        fxBar(bars, 130.0, 120.0, 125.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    else
        // T2 Bear inverse confirm, then one more accepted bar without a confirm
        fxMovedBear(bars)
        fxBar(bars, 115.0, 105.0, 111.0, na)
        fxBar(bars, 90.0, 80.0, 85.0, na)
        expState := ROOT_INVERSE_ACTIVE, expProg := PROG_ACTIVE
    [bars, dir, expState, expProg]

// ---------------- Reference ----------------
// one accepted base bar in Main order: structural check on the active Root (Stage D), Inverse facts on the Root
// that was waiting before this bar (Stage E), then this bar's invalidation enters WAIT (Stage F).
// Returns [confirmedThisBar, invalidatedThisBar].
w07RefInverseNaiveRaw(RefRoot r, FxBar bar, DebugOut dbg, int tag) =>
    bool invalidated = false
    if not na(bar.srcClosePrice) and r.state == ROOT_ACTIVE
        int srcTick = int(math.round(bar.srcClosePrice / FX_MINTICK))
        invalidated := r.direction == FVG_BULLISH ? srcTick < r.bottomTick : srcTick > r.topTick
    bool confirmed = false
    if r.state == ROOT_INVERSE_WAIT and (r.progress == PROG_WAIT or r.progress == PROG_MOVED_AWAY or r.progress == PROG_RETOUCHED)
        int  hiTick  = int(math.round(bar.high  / FX_MINTICK))
        int  loTick  = int(math.round(bar.low   / FX_MINTICK))
        int  clTick  = int(math.round(bar.close / FX_MINTICK))
        bool isBull  = r.direction == FVG_BULLISH
        bool confirm = isBull ? clTick <= r.bottomTick : clTick >= r.topTick
        int  next    = r.progress
        if tag > 0
            dbgRefInside(dbg, tag, r, hiTick, loTick, clTick, isBull, confirm)
        if r.progress == PROG_WAIT
            bool moved = isBull ? clTick <= r.bottomTick - r.resetTick : clTick >= r.topTick + r.resetTick
            if tag > 0
                dbgRefMoved(dbg, tag, moved)
            if moved
                next := PROG_MOVED_AWAY
        else if r.progress == PROG_MOVED_AWAY
            bool touched = loTick <= r.topTick and hiTick >= r.bottomTick
            if touched
                next := confirm ? PROG_ACTIVE : PROG_RETOUCHED
        else if confirm
            next := PROG_ACTIVE
        r.progress := next
        if next == PROG_ACTIVE
            r.state   := ROOT_INVERSE_ACTIVE
            confirmed := true
    if invalidated
        r.state    := ROOT_INVERSE_WAIT
        r.progress := PROG_WAIT
    [confirmed, invalidated]

// ---------------- Production lane (Main /21) ----------------
fxCfg() =>
    ZE.ZoneCfg cfg = ZE.newCfg()
    cfg.useMa              := false
    cfg.useSwing           := false
    cfg.useAccum           := false
    cfg.useTimeHl          := false
    cfg.usePsych           := false
    cfg.useFvg             := true
    cfg.chartTfMinutes     := 5
    cfg.mintick            := FX_MINTICK
    cfg.touchResetDistance := FX_RESET_DISTANCE
    cfg
optFeed(FxBar bar, int seq, int dir) =>
    ZE.Feed f = ZE.newFeed()
    f.baseOpen       := bar.close
    f.baseHigh       := bar.high
    f.baseLow        := bar.low
    f.baseClose      := bar.close
    f.basePrevClose  := bar.close
    f.baseOpenTime   := bar.closeTime - FX_M5
    f.baseCloseTime  := bar.closeTime
    f.baseSeq        := seq
    f.baseConfirmed  := true
    f.mintick        := FX_MINTICK
    f.chartTfMinutes := 5
    if seq == 1
        f.src1hOpenTime  := FX_T0
        f.src1hCloseTime := FX_T0 + FX_H
        if dir == FVG_BULLISH
            f.fvg1hBullNew    := true
            f.fvg1hBullBottom := FX_BOTTOM
            f.fvg1hBullTop    := FX_TOP
        else
            f.fvg1hBearNew    := true
            f.fvg1hBearBottom := FX_BOTTOM
            f.fvg1hBearTop    := FX_TOP
    else if not na(bar.srcClosePrice)
        f.src1hOpenTime  := FX_T0 + FX_H
        f.src1hCloseTime := FX_T0 + 2 * FX_H
        f.htf1hClose     := bar.srcClosePrice
    f
optFvgCount(ZE.ZoneEngine e) =>
    int cnt = 0
    int i = 0
    while i < ZE.rootCount(e)
        ZE.Root pr = ZE.rootAt(e, i)
        if pr.category == CAT_FVG
            cnt += 1
        i += 1
    cnt
optFind(ZE.ZoneEngine e, int dir) =>
    int found = -1
    int cnt = 0
    int i = 0
    while i < ZE.rootCount(e)
        ZE.Root pr = ZE.rootAt(e, i)
        if pr.category == CAT_FVG and pr.tfCode == TF_1H and pr.direction == dir and pr.nativeBottom == FX_BOTTOM and pr.nativeTop == FX_TOP
            cnt += 1
            found := i
        i += 1
    cnt == 1 ? found : -1
countOf(array<int> a, int v) =>
    int cnt = 0
    int i = 0
    while i < array.size(a)
        if array.get(a, i) == v
            cnt += 1
        i += 1
    cnt
// normal Touch Side storage (sizes, then every element) for an exact before / after comparison
sideTouchSnapshot(ZE.ZoneEngine e) =>
    array<int> s = array.new_int(0)
    array.push(s, array.size(e.sideTouchCounts))
    array.push(s, array.size(e.sideWeakByTouchFlags))
    array.push(s, array.size(e.sideWeakByDepthFlags))
    array.push(s, array.size(e.sideFreshFlags))
    int i = 0
    while i < array.size(e.sideTouchCounts)
        array.push(s, array.get(e.sideTouchCounts, i))
        i += 1
    i := 0
    while i < array.size(e.sideWeakByTouchFlags)
        array.push(s, array.get(e.sideWeakByTouchFlags, i) ? 1 : 0)
        i += 1
    i := 0
    while i < array.size(e.sideWeakByDepthFlags)
        array.push(s, array.get(e.sideWeakByDepthFlags, i) ? 1 : 0)
        i += 1
    i := 0
    while i < array.size(e.sideFreshFlags)
        array.push(s, array.get(e.sideFreshFlags, i) ? 1 : 0)
        i += 1
    s
sameInts(array<int> a, array<int> b) =>
    bool same = array.size(a) == array.size(b)
    int i = 0
    while same and i < array.size(a)
        same := array.get(a, i) == array.get(b, i)
        i += 1
    same

// runs one fixture; returns [code, field, refActiveFinal, optActiveFinal]
runFixture(int fx, DebugOut dbg) =>
    trSet(dbg, fx, 0, fx)
    [bars, dir, expState, expProg] = fxBuild(fx, dbg)
    trSet(dbg, fx, 4, dir)
    bool isElig  = fx == 19 or fx == 20
    bool isTouch = fx == 21 or fx == 22
    RefRoot       r   = RefRoot.new(int(na), PROG_NONE, dir, int(math.round(FX_BOTTOM / FX_MINTICK)), int(math.round(FX_TOP / FX_MINTICK)), int(math.round(FX_RESET_DISTANCE / FX_MINTICK)))
    trSet(dbg, fx, 5, r.direction)
    ZE.ZoneCfg    cfg = fxCfg()
    ZE.ZoneEngine e   = ZE.newEngine(cfg)
    int code  = ZE.validateCfg(cfg) == 0 ? CMP_NONE : CMP_CFG_INVALID
    int field = -1
    int idRootId   = 0
    int idOrigin   = 0
    int idConfirm  = 0
    bool idBroad   = false
    bool optActiveFinal = false
    array<int> touchBefore = array.new_int(0)
    bool touchArmed = false
    int prevOptState = int(na)
    int prevOptProg  = int(na)
    int bi = 0
    while code == CMP_NONE and bi < array.size(bars)
        FxBar bar = array.get(bars, bi)
        // Reference (never reads the Production lane)
        bool refConfirmed = false
        bool refInvalidated = false
        bool refFormed = bi == 0
        int  tag = (fx == 9 and bi == 2) ? 1 : (fx == 17 and bi == 2) ? 2 : (fx == 18 and bi == 3) ? 3 : (fx == 3 and bi == 3) ? 4 : 0
        if tag > 0
            dbgRefBefore(dbg, tag, r)
        if refFormed
            r.state := ROOT_ACTIVE
        else
            [c1, i1] = w07RefInverseNaiveRaw(r, bar, dbg, tag)
            refConfirmed   := c1
            refInvalidated := i1
        if tag > 0
            dbgRefAfter(dbg, tag, r)
        // Production
        int  eligSupBefore = e.rootEligibilityRevisionSupport
        int  eligResBefore = e.rootEligibilityRevisionResistance
        if isTouch and refConfirmed
            touchBefore := sideTouchSnapshot(e)
            touchArmed  := true
        ZE.Feed feedNow = optFeed(bar, bi + 1, dir)
        if bi == 0
            trSet(dbg, fx, 6, feedNow.fvg1hBullNew ? 1.0 : 0.0)
            trSet(dbg, fx, 7, feedNow.fvg1hBearNew ? 1.0 : 0.0)
        bool committed = ZE.updateConfirmed5m(e, cfg, feedNow)
        int idx = -1
        if not committed
            code  := CMP_NOT_COMMITTED
            field := bi
        else if optFvgCount(e) != 1
            code  := CMP_ROOT_COUNT
            field := bi
        else
            idx := optFind(e, dir)
            if idx < 0
                code  := CMP_ROOT_MISSING
                field := bi
        if code == CMP_NONE
            ZE.Root pr = ZE.rootAt(e, idx)
            int slot = array.get(e.rootIdOrderSlots, idx)
            if bi == 0
                idRootId  := pr.rootId
                idOrigin  := pr.originTime
                idConfirm := pr.confirmedTime
                idBroad   := pr.isBroadFvg
            int optProg = slot < array.size(e.w02Aux.rootFvgInverseProgresses) ? array.get(e.w02Aux.rootFvgInverseProgresses, slot) : PROG_NONE
            if tag > 0
                dbgOpt(dbg, tag, prevOptState, prevOptProg, pr.state, optProg, pr.direction, array.get(e.rootNativeBottomTicks, slot), array.get(e.rootNativeTopTicks, slot))
            prevOptState := pr.state
            prevOptProg  := optProg
            int waitCnt    = countOf(e.inverseWaitFvgRootSlots, slot)
            int activeCnt  = countOf(e.inverseActiveFvgRootSlots, slot)
            int gWaitCnt   = countOf(e.stateInverseWaitRootSlots, slot)
            int gActiveCnt = countOf(e.stateInverseActiveRootSlots, slot)
            int expWait    = r.state == ROOT_INVERSE_WAIT ? 1 : 0
            int expActive  = r.state == ROOT_INVERSE_ACTIVE ? 1 : 0
            if pr.rootId != idRootId or pr.category != CAT_FVG or pr.originTime != idOrigin or pr.confirmedTime != idConfirm or pr.tfCode != TF_1H or pr.nativeBottom != FX_BOTTOM or pr.nativeTop != FX_TOP or pr.direction != dir or pr.isBroadFvg != idBroad
                code := CMP_IDENTITY
            else if pr.state != r.state
                code := CMP_STATE
            else if optProg != r.progress
                code := CMP_PROGRESS
            else if waitCnt != expWait or activeCnt != expActive or gWaitCnt != expWait or gActiveCnt != expActive
                code := CMP_SET_MEMBERSHIP
            else if e.w02Aux.fvgInverseConfirmCount != (refConfirmed ? 1 : 0)
                code := CMP_CONFIRM_COUNT
            else if refConfirmed and array.get(e.w02Aux.fvgInverseConfirmRootIds, 0) != pr.rootId
                code := CMP_CONFIRM_ROOT
            if code == CMP_NONE and isElig
                // formation / invalidation dirty the original Side, the inverse confirm dirties the other Side only
                bool origSup = dir == FVG_BULLISH
                int expSup = ((refFormed or refInvalidated) and origSup) or (refConfirmed and not origSup) ? 1 : 0
                int expRes = ((refFormed or refInvalidated) and not origSup) or (refConfirmed and origSup) ? 1 : 0
                if e.rootEligibilityRevisionSupport - eligSupBefore != expSup or e.rootEligibilityRevisionResistance - eligResBefore != expRes
                    code := CMP_ELIGIBILITY
            if code == CMP_NONE and isTouch and touchArmed
                if not sameInts(touchBefore, sideTouchSnapshot(e))
                    code := CMP_TOUCH_FIELDS
            if code != CMP_NONE and field < 0
                field := bi
            optActiveFinal := pr.state == ROOT_INVERSE_ACTIVE
            if bi == 0
                trSet(dbg, fx, 8, pr.direction)
        bi += 1
    if code == CMP_NONE and (r.state != expState or r.progress != expProg)
        code := CMP_EXPECT_FINAL
    [code, field, r.state == ROOT_INVERSE_ACTIVE, optActiveFinal]

// returns [failures, firstFail, firstCompare, firstField, lifecycleF, boundaryF, eligibilityF, touchF, refActive, optActive]
runAll(DebugOut dbg) =>
    int failures = 0
    int firstFail = -1
    int firstCompare = CMP_NONE
    int firstField = -1
    int lifeF = 0
    int boundF = 0
    int eligF = 0
    int touchF = 0
    int refAct = 0
    int optAct = 0
    int fx = 1
    while fx <= FX_COUNT
        [code, field, refA, optA] = runFixture(fx, dbg)
        refAct += refA ? 1 : 0
        optAct += optA ? 1 : 0
        if code != CMP_NONE
            failures += 1
            if fx <= 14
                lifeF += 1
            else if fx <= 18
                boundF += 1
            else if fx <= 20
                eligF += 1
            else
                touchF += 1
            if firstFail < 0
                firstFail    := fx
                firstCompare := code
                firstField   := field
        fx += 1
    [failures, firstFail, firstCompare, firstField, lifeF, boundF, eligF, touchF, refAct, optAct]

var DebugOut dbg        = DebugOut.new(trace = array.new_float(27, na))
var int gFailures       = -1
var int gFixtureCount   = 0
var int gFirstFail      = -1
var int gFirstCompare   = -1
if barstate.islast and gFixtureCount == 0
    [f, ff, fc, fd, lf, bf, ef, tf, ra, oa] = runAll(dbg)
    gFailures     := f
    gFixtureCount := FX_COUNT
    gFirstFail    := ff
    gFirstCompare := fc

plot(180202,              "W07 B18 Debug Build",            display = display.data_window)

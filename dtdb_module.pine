// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © ka.mickey15
//
// ============================================================
//  Double Top / Double Bottom 単体モジュール (Indicator版)
// ============================================================
//  参考コードの DT/DB ロジックを独立モジュール化。
//  実装: ダブルトップ / ダブルボトム / 否定 / ネックラインブレイク /
//        リテスト / 右山・右底形成中・崩れ / スイープ型 / Quality Score。
//  ・strategy ではなく indicator。strategy.entry/exit 不使用。
//  ・Pivot は確定後のみ (request.security lookahead_off / 未来参照なし)。
//  ・useDTDBModule=false の時は allowLong/Short=true (AND 接続を邪魔しない)。
//  ・変数名は dtdb / dt / db prefix (H&S モジュールと衝突回避)。
// ============================================================

//@version=5
indicator(
     title            = "Double Top / Bottom Module",
     shorttitle       = "DTDB",
     overlay          = true,
     max_bars_back    = 1000,
     max_labels_count = 500
 )

// ============================================================
//  Input (グループ: Double Top / Bottom Module)
// ============================================================
grpDTDB = "Double Top / Bottom Module"

useDTDBModule = input.bool(true, "DT/DBモジュールを使う", group = grpDTDB)

showDTDBLines      = input.bool(true, "ネックラインを表示", group = grpDTDB)
showDTDBLabels     = input.bool(true, "DT/DBラベルを表示", group = grpDTDB)
showDTDBDebugTable = input.bool(true, "Debug Tableを表示", group = grpDTDB)

patternTf = input.timeframe("5", "Pattern TF", group = grpDTDB)
pivotLen  = input.int(5, "Pivot Length", minval = 1, group = grpDTDB)

doubleTolerancePct = input.float(0.004, "2回目頂点/底値の許容率", step = 0.001, group = grpDTDB)

useNeckDepth  = input.bool(true, "ネック深さを要求", group = grpDTDB)
neckDepthMult = input.float(0.8, "ネック深さ >= ATR ×", step = 0.1, group = grpDTDB)

useQuickRev  = input.bool(true, "2回目到達後N本以内の反転のみ", group = grpDTDB)
quickRevBars = input.int(5, "反転までの最大本数", minval = 1, group = grpDTDB)

retestAtrLen  = input.int(14, "Retest ATR Length", minval = 1, group = grpDTDB)
retestAtrMult = input.float(0.5, "Retest ATR Mult", step = 0.1, group = grpDTDB)

useDTDBReversalCandle = input.bool(true, "反転ローソクを要求", group = grpDTDB)
useBodyFilter = input.bool(true, "包み足の実体強度を要求", group = grpDTDB)
bodyMult      = input.float(1.6, "実体 > 平均実体 ×", step = 0.1, group = grpDTDB)
pinWickRatio  = input.float(0.7, "ピンバーのヒゲ比率", minval = 0.1, maxval = 1.0, step = 0.05, group = grpDTDB)

useDTDBQualityFilter = input.bool(false, "Quality Filterを使う", group = grpDTDB)
minDTDBQuality       = input.int(50, "最低DT/DB Quality", minval = 0, maxval = 100, group = grpDTDB)

useDTDBInvalidation = input.bool(true, "DT/DB否定を使う", group = grpDTDB)
invalidationAtrMult = input.float(0.2, "否定判定 ATR余白", step = 0.1, group = grpDTDB)

useSweepDTDB    = input.bool(true, "スイープ型DT/DBを使う", group = grpDTDB)
sweepAtrMult    = input.float(0.3, "スイープ許容 ATR×", step = 0.1, group = grpDTDB)
sweepReturnBars = input.int(3, "スイープ後に戻る最大本数", minval = 1, group = grpDTDB)

// --- Triple Top / Bottom (DT/DB の拡張: 接触3回) ---
useTripleDTDB = input.bool(true, "Triple Top/Bottomを使う", group = grpDTDB)
tripleTolerancePct = input.float(0.004, "3回目頂点/底値の許容率", step = 0.001, group = grpDTDB)
minTripleTouches = input.int(3, "Triple成立タッチ数", minval = 3, maxval = 3, group = grpDTDB)
useTripleOnlyAfterDouble = input.bool(true, "Double成立後のTripleのみ採用", group = grpDTDB)

setupValidBars = input.int(24, "セットアップ有効本数", minval = 1, group = grpDTDB)

dtdbEntryMode = input.string("Any", "Entry Mode", options = ["Any", "BreakOnly", "RetestOnly", "InvalidationOnly", "SweepOnly"], group = grpDTDB)

bool dAct = useDTDBModule

// ============================================================
//  共通計算
// ============================================================
float atrV = ta.atr(retestAtrLen)
float retestRange = atrV * retestAtrMult

// ============================================================
//  3. HTF Pivot 取得 (確定後のみ / lookahead_off)
// ============================================================
[htfPh, htfPl, htfClose, htfHigh, htfLow, htfTime] = request.security(syminfo.tickerid, patternTf, [ta.pivothigh(pivotLen, pivotLen), ta.pivotlow(pivotLen, pivotLen), close[1], high[1], low[1], time], lookahead = barmerge.lookahead_off)
bool newHTF = na(htfTime[1]) ? false : htfTime != htfTime[1]

// ============================================================
//  5. 補助関数: 2つの Pivot 間にある反対 Pivot を探す
// ============================================================
f_findBetween(_vals, _idxs, _lo, _hi) =>
    float _res = na
    if array.size(_vals) > 0
        for i = 0 to array.size(_vals) - 1
            int _id = array.get(_idxs, i)
            if _id > _lo and _id < _hi
                _res := array.get(_vals, i)
    _res

// ============================================================
//  4. Pivot 配列
// ============================================================
var array<float> phVals = array.new_float()
var array<int>   phIdx  = array.new_int()
var array<float> plVals = array.new_float()
var array<int>   plIdx  = array.new_int()
var int htfCount     = 0
var int lastPivotDir = 0

// ============================================================
//  パターン状態 (DT)
// ============================================================
var float dtFirstTop   = na
var float dtSecondTop  = na
var float necklineDT   = na
var bool  dtPatternFound = false
var bool  dtBreakDone    = false
var bool  dtInvalidated  = false
var bool  dtIsSweep      = false
var int   dtPatternBar   = na
var int   dtBreakBar     = na

// パターン状態 (DB)
var float dbFirstBottom  = na
var float dbSecondBottom = na
var float necklineDB     = na
var bool  dbPatternFound = false
var bool  dbBreakDone    = false
var bool  dbInvalidated  = false
var bool  dbIsSweep      = false
var int   dbPatternBar   = na
var int   dbBreakBar     = na

// 右山 / 右底 形成ビルド状態 + Stage
var bool  dtRSBuilding = false
var float dtBuildTop   = na
var int   dtStageV     = 0
var bool  dbRSBuilding = false
var float dbBuildBot   = na
var int   dbStageV     = 0

// スイープ ステート (発生 → sweepReturnBars 本以内に戻れば成立)
var bool dtSweepArmed     = false
var int  dtSweepBar       = na
var bool dtSweepConfirmed = false
var bool dbSweepArmed     = false
var int  dbSweepBar       = na
var bool dbSweepConfirmed = false

// --- Triple Top (TT) 状態 ---
var float ttTop1 = na
var float ttTop2 = na
var float ttTop3 = na
var float necklineTT = na
var bool  ttPatternFound = false
var bool  ttBreakDone    = false
var bool  ttInvalidated  = false
var bool  ttIsSweep      = false
var int   ttPatternBar   = na
var int   ttBreakBar     = na
var bool  ttSweepArmed     = false
var int   ttSweepBar       = na
var bool  ttSweepConfirmed = false
var float ttSweepZone      = na
var bool  ttRSBuilding = false
var float ttZoneTop    = na

// --- Triple Bottom (TB) 状態 ---
var float tbBottom1 = na
var float tbBottom2 = na
var float tbBottom3 = na
var float necklineTB = na
var bool  tbPatternFound = false
var bool  tbBreakDone    = false
var bool  tbInvalidated  = false
var bool  tbIsSweep      = false
var int   tbPatternBar   = na
var int   tbBreakBar     = na
var bool  tbSweepArmed     = false
var int   tbSweepBar       = na
var bool  tbSweepConfirmed = false
var float tbSweepZone      = na
var bool  tbRSBuilding = false
var float tbZoneBot    = na

// バー内イベント
bool dtRSFailHTF   = false
bool dbRSFailHTF   = false
bool dtExpiredEvent = false
bool dbExpiredEvent = false
bool dtCompletedNow = false
bool dbCompletedNow = false
bool ttRSFailHTF    = false
bool tbRSFailHTF    = false
bool ttExpiredEvent = false
bool tbExpiredEvent = false
bool ttCompletedNow = false
bool tbCompletedNow = false

// ============================================================
//  6/7/8/9. 検出 (newHTF 時)
// ============================================================
if newHTF
    htfCount := htfCount + 1
    int _pIdx = htfCount - pivotLen
    if not na(htfPh)
        if lastPivotDir == 1 and array.size(phVals) > 0
            int _li = array.size(phVals) - 1
            if htfPh > array.get(phVals, _li)
                array.set(phVals, _li, htfPh)
                array.set(phIdx,  _li, _pIdx)
        else
            array.push(phVals, htfPh)
            array.push(phIdx,  _pIdx)
            lastPivotDir := 1
            while array.size(phVals) > 10
                array.shift(phVals)
                array.shift(phIdx)
    if not na(htfPl)
        if lastPivotDir == -1 and array.size(plVals) > 0
            int _li = array.size(plVals) - 1
            if htfPl < array.get(plVals, _li)
                array.set(plVals, _li, htfPl)
                array.set(plIdx,  _li, _pIdx)
        else
            array.push(plVals, htfPl)
            array.push(plIdx,  _pIdx)
            lastPivotDir := -1
            while array.size(plVals) > 10
                array.shift(plVals)
                array.shift(plIdx)

    // --- ダブルトップ (新しい PH が確定したとき / 直近2 PH) ---
    int nH = array.size(phVals)
    if not na(htfPh) and nH >= 2
        float t1 = array.get(phVals, nH - 2)
        float t2 = array.get(phVals, nH - 1)
        int t1i = array.get(phIdx, nH - 2)
        int t2i = array.get(phIdx, nH - 1)
        float neck = f_findBetween(plVals, plIdx, t1i, t2i)
        bool symOk   = math.abs(t1 - t2) / t1 <= doubleTolerancePct
        bool depthOk = not useNeckDepth or (not na(neck) and (math.min(t1, t2) - neck) >= atrV * neckDepthMult)
        bool normalDT = symOk and depthOk
        bool sweepRaw = useSweepDTDB and t2 > t1 and t2 <= t1 + atrV * sweepAtrMult and depthOk
        if not na(neck) and (normalDT or sweepRaw)
            dtFirstTop     := t1
            dtSecondTop    := t2
            necklineDT     := neck
            dtPatternFound := true
            dtBreakDone    := false
            dtInvalidated  := false
            dtIsSweep      := sweepRaw and not normalDT
            dtPatternBar   := bar_index
            dtCompletedNow := true
            dtStageV       := 4
            dtSweepConfirmed := false
            if dtIsSweep
                dtSweepArmed := true
                dtSweepBar   := bar_index
            else
                dtSweepArmed := false
        else if not na(neck) and t2 > t1
            dtRSFailHTF := true

    // --- ダブルボトム (新しい PL が確定したとき / 直近2 PL) ---
    int nL = array.size(plVals)
    if not na(htfPl) and nL >= 2
        float b1 = array.get(plVals, nL - 2)
        float b2 = array.get(plVals, nL - 1)
        int b1i = array.get(plIdx, nL - 2)
        int b2i = array.get(plIdx, nL - 1)
        float neckB = f_findBetween(phVals, phIdx, b1i, b2i)
        bool symOkB   = math.abs(b1 - b2) / b1 <= doubleTolerancePct
        bool depthOkB = not useNeckDepth or (not na(neckB) and (neckB - math.max(b1, b2)) >= atrV * neckDepthMult)
        bool normalDB = symOkB and depthOkB
        bool sweepRawB = useSweepDTDB and b2 < b1 and b2 >= b1 - atrV * sweepAtrMult and depthOkB
        if not na(neckB) and (normalDB or sweepRawB)
            dbFirstBottom  := b1
            dbSecondBottom := b2
            necklineDB     := neckB
            dbPatternFound := true
            dbBreakDone    := false
            dbInvalidated  := false
            dbIsSweep      := sweepRawB and not normalDB
            dbPatternBar   := bar_index
            dbCompletedNow := true
            dbStageV       := 4
            dbSweepConfirmed := false
            if dbIsSweep
                dbSweepArmed := true
                dbSweepBar   := bar_index
            else
                dbSweepArmed := false
        else if not na(neckB) and b2 < b1
            dbRSFailHTF := true

    // --- Triple Top (直近3 PH) ---
    int nHt = array.size(phVals)
    if useTripleDTDB and not na(htfPh) and nHt >= 3
        float tp1 = array.get(phVals, nHt - 3)
        float tp2 = array.get(phVals, nHt - 2)
        float tp3 = array.get(phVals, nHt - 1)
        int tp1i = array.get(phIdx, nHt - 3)
        int tp2i = array.get(phIdx, nHt - 2)
        int tp3i = array.get(phIdx, nHt - 1)
        float n1 = f_findBetween(plVals, plIdx, tp1i, tp2i)
        float n2 = f_findBetween(plVals, plIdx, tp2i, tp3i)
        float necT = na(n1) or na(n2) ? na : math.min(n1, n2)
        float tMax = math.max(tp1, math.max(tp2, tp3))
        float tMin = math.min(tp1, math.min(tp2, tp3))
        bool symT = math.abs(tp1 - tp2) / tp1 <= tripleTolerancePct and math.abs(tp1 - tp3) / tp1 <= tripleTolerancePct and math.abs(tp2 - tp3) / tp2 <= tripleTolerancePct
        bool depthT = not useNeckDepth or (not na(necT) and (tMin - necT) >= atrV * neckDepthMult)
        bool afterDoubleT = not useTripleOnlyAfterDouble or dtPatternFound
        bool normalTT = symT and depthT and afterDoubleT
        bool sweepRawT = useSweepDTDB and tp3 > math.max(tp1, tp2) and tp3 <= math.max(tp1, tp2) + atrV * sweepAtrMult and depthT and afterDoubleT
        if not na(necT) and (normalTT or sweepRawT)
            ttTop1 := tp1
            ttTop2 := tp2
            ttTop3 := tp3
            necklineTT := necT
            ttPatternFound := true
            ttBreakDone := false
            ttInvalidated := false
            ttIsSweep := sweepRawT and not normalTT
            ttPatternBar := bar_index
            ttCompletedNow := true
            ttSweepConfirmed := false
            if ttIsSweep
                ttSweepArmed := true
                ttSweepBar := bar_index
                ttSweepZone := math.max(tp1, tp2)
            else
                ttSweepArmed := false
        else if not na(necT) and tp3 > math.max(tp1, tp2)
            ttRSFailHTF := true

    // --- Triple Bottom (直近3 PL) ---
    int nLt = array.size(plVals)
    if useTripleDTDB and not na(htfPl) and nLt >= 3
        float bt1 = array.get(plVals, nLt - 3)
        float bt2 = array.get(plVals, nLt - 2)
        float bt3 = array.get(plVals, nLt - 1)
        int bt1i = array.get(plIdx, nLt - 3)
        int bt2i = array.get(plIdx, nLt - 2)
        int bt3i = array.get(plIdx, nLt - 1)
        float m1 = f_findBetween(phVals, phIdx, bt1i, bt2i)
        float m2 = f_findBetween(phVals, phIdx, bt2i, bt3i)
        float necTB = na(m1) or na(m2) ? na : math.max(m1, m2)
        float bMax = math.max(bt1, math.max(bt2, bt3))
        float bMin = math.min(bt1, math.min(bt2, bt3))
        bool symTB = math.abs(bt1 - bt2) / bt1 <= tripleTolerancePct and math.abs(bt1 - bt3) / bt1 <= tripleTolerancePct and math.abs(bt2 - bt3) / bt2 <= tripleTolerancePct
        bool depthTB = not useNeckDepth or (not na(necTB) and (necTB - bMax) >= atrV * neckDepthMult)
        bool afterDoubleB = not useTripleOnlyAfterDouble or dbPatternFound
        bool normalTB = symTB and depthTB and afterDoubleB
        bool sweepRawTB = useSweepDTDB and bt3 < math.min(bt1, bt2) and bt3 >= math.min(bt1, bt2) - atrV * sweepAtrMult and depthTB and afterDoubleB
        if not na(necTB) and (normalTB or sweepRawTB)
            tbBottom1 := bt1
            tbBottom2 := bt2
            tbBottom3 := bt3
            necklineTB := necTB
            tbPatternFound := true
            tbBreakDone := false
            tbInvalidated := false
            tbIsSweep := sweepRawTB and not normalTB
            tbPatternBar := bar_index
            tbCompletedNow := true
            tbSweepConfirmed := false
            if tbIsSweep
                tbSweepArmed := true
                tbSweepBar := bar_index
                tbSweepZone := math.min(bt1, bt2)
            else
                tbSweepArmed := false
        else if not na(necTB) and bt3 < math.min(bt1, bt2)
            tbRSFailHTF := true

    // --- Triple 右側ビルド (Double 成立後に neck2 形成 → 3rd 待ち) ---
    if not na(htfPl) and dtPatternFound and not na(dtFirstTop)
        ttRSBuilding := true
        ttZoneTop := math.max(dtFirstTop, dtSecondTop)
    if not na(htfPh) and not ttCompletedNow
        ttRSBuilding := false
    if not na(htfPh) and dbPatternFound and not na(dbFirstBottom)
        tbRSBuilding := true
        tbZoneBot := math.min(dbFirstBottom, dbSecondBottom)
    if not na(htfPl) and not tbCompletedNow
        tbRSBuilding := false

    // --- 右山 / 右底 ビルド状態 + Stage(1:First Top/Bottom, 2:Neck) ---
    if not na(htfPh)
        dtBuildTop := htfPh
        dtRSBuilding := false
        if not dtCompletedNow
            dtStageV := 1
    if not na(htfPl)
        if not na(dtBuildTop)
            dtRSBuilding := true
            if not dtCompletedNow
                dtStageV := 2
    if not na(htfPl)
        dbBuildBot := htfPl
        dbRSBuilding := false
        if not dbCompletedNow
            dbStageV := 1
    if not na(htfPh)
        if not na(dbBuildBot)
            dbRSBuilding := true
            if not dbCompletedNow
                dbStageV := 2

// ============================================================
//  10. 右山崩れ / 右底崩れ
// ============================================================
bool dtPriceFail = dtRSBuilding and not na(dtBuildTop) and high > dtBuildTop + atrV * invalidationAtrMult
bool dbPriceFail = dbRSBuilding and not na(dbBuildBot) and low < dbBuildBot - atrV * invalidationAtrMult
bool dtRightSideFailed = dtPriceFail or dtRSFailHTF
bool dbRightSideFailed = dbPriceFail or dbRSFailHTF
if dtRightSideFailed
    dtRSBuilding := false
    dtBuildTop := na
    dtStageV := 0
if dbRightSideFailed
    dbRSBuilding := false
    dbBuildBot := na
    dbStageV := 0

// Stage 3 (Waiting Second Top/Bottom): ネック後に1st天底へ価格が戻り始めたら
if dtRSBuilding and dtStageV == 2 and not na(dtBuildTop) and high >= dtBuildTop - retestRange
    dtStageV := 3
if dbRSBuilding and dbStageV == 2 and not na(dbBuildBot) and low <= dbBuildBot + retestRange
    dbStageV := 3

// スイープ ステート: 発生後 sweepReturnBars 本以内に 1st天底へ戻れば成立
if dtSweepArmed
    if not na(dtFirstTop) and close < dtFirstTop
        dtSweepConfirmed := true
    else if not na(dtSweepBar) and (bar_index - dtSweepBar) > sweepReturnBars
        dtSweepArmed := false
if dbSweepArmed
    if not na(dbFirstBottom) and close > dbFirstBottom
        dbSweepConfirmed := true
    else if not na(dbSweepBar) and (bar_index - dbSweepBar) > sweepReturnBars
        dbSweepArmed := false

bool dtRightSideBuilding = dAct and dtRSBuilding and not dtRightSideFailed
bool dbRightSideBuilding = dAct and dbRSBuilding and not dbRightSideFailed
int dtStage = dAct ? dtStageV : 0
int dbStage = dAct ? dbStageV : 0

// Triple 右山/右底崩れ
bool ttPriceFail = ttRSBuilding and not na(ttZoneTop) and high > ttZoneTop + atrV * invalidationAtrMult
bool tbPriceFail = tbRSBuilding and not na(tbZoneBot) and low < tbZoneBot - atrV * invalidationAtrMult
bool ttRightSideFailed = dAct and useTripleDTDB and (ttPriceFail or ttRSFailHTF)
bool tbRightSideFailed = dAct and useTripleDTDB and (tbPriceFail or tbRSFailHTF)
if ttRightSideFailed
    ttRSBuilding := false
    ttZoneTop := na
if tbRightSideFailed
    tbRSBuilding := false
    tbZoneBot := na

// Triple スイープ ステート
if ttSweepArmed
    if not na(ttSweepZone) and close < ttSweepZone
        ttSweepConfirmed := true
    else if not na(ttSweepBar) and (bar_index - ttSweepBar) > sweepReturnBars
        ttSweepArmed := false
if tbSweepArmed
    if not na(tbSweepZone) and close > tbSweepZone
        tbSweepConfirmed := true
    else if not na(tbSweepBar) and (bar_index - tbSweepBar) > sweepReturnBars
        tbSweepArmed := false

bool ttRightSideBuilding = dAct and useTripleDTDB and ttRSBuilding and not ttRightSideFailed
bool tbRightSideBuilding = dAct and useTripleDTDB and tbRSBuilding and not tbRightSideFailed
int ttStage = (dAct and useTripleDTDB) ? (ttPatternFound ? 4 : ttRSBuilding ? 3 : (dtPatternFound ? 1 : 0)) : 0
int tbStage = (dAct and useTripleDTDB) ? (tbPatternFound ? 4 : tbRSBuilding ? 3 : (dbPatternFound ? 1 : 0)) : 0

// ============================================================
//  13. 反転ローソク
// ============================================================
float body    = math.abs(close - open)
float avgBody = ta.sma(math.abs(close - open), 20)
bool strongBody = not useBodyFilter or body > avgBody * bodyMult

bool bearEngulf = close < open and open >= close[1] and close <= open[1] and strongBody
bool bullEngulf = close > open and open <= close[1] and close >= open[1] and strongBody
float barRng = math.max(high - low, syminfo.mintick)
float upWick = high - math.max(open, close)
float dnWick = math.min(open, close) - low
bool bearPin = upWick / barRng >= pinWickRatio
bool bullPin = dnWick / barRng >= pinWickRatio

bool dtReversal = not useDTDBReversalCandle or bearEngulf or bearPin
bool dbReversal = not useDTDBReversalCandle or bullEngulf or bullPin

// ============================================================
//  14. DT/DB 否定 / 11. ネックラインブレイク (状態更新)
// ============================================================
bool dtInvalidation = useDTDBInvalidation and dtPatternFound and not dtBreakDone and not na(dtFirstTop) and not na(dtSecondTop) and close > math.max(dtFirstTop, dtSecondTop) + atrV * invalidationAtrMult
bool dbInvalidation = useDTDBInvalidation and dbPatternFound and not dbBreakDone and not na(dbFirstBottom) and not na(dbSecondBottom) and close < math.min(dbFirstBottom, dbSecondBottom) - atrV * invalidationAtrMult

bool dtBreak = dtPatternFound and not dtBreakDone and not na(necklineDT) and not na(htfClose) and htfClose < necklineDT
bool dbBreak = dbPatternFound and not dbBreakDone and not na(necklineDB) and not na(htfClose) and htfClose > necklineDB

if dtInvalidation
    dtInvalidated  := true
    dtPatternFound := false
if dbInvalidation
    dbInvalidated  := true
    dbPatternFound := false

if dtBreak and not dtInvalidation
    dtBreakDone := true
    dtBreakBar  := bar_index
if dbBreak and not dbInvalidation
    dbBreakDone := true
    dbBreakBar  := bar_index

// セットアップ有効期限切れ
if dtPatternFound and dtBreakDone and not na(dtBreakBar) and (bar_index - dtBreakBar > setupValidBars)
    dtPatternFound := false
    dtBreakDone    := false
    dtExpiredEvent := true
else if dtPatternFound and not dtBreakDone and not na(dtPatternBar) and (bar_index - dtPatternBar > setupValidBars)
    dtPatternFound := false
    dtExpiredEvent := true
if dbPatternFound and dbBreakDone and not na(dbBreakBar) and (bar_index - dbBreakBar > setupValidBars)
    dbPatternFound := false
    dbBreakDone    := false
    dbExpiredEvent := true
else if dbPatternFound and not dbBreakDone and not na(dbPatternBar) and (bar_index - dbPatternBar > setupValidBars)
    dbPatternFound := false
    dbExpiredEvent := true

// --- Triple 否定 / ブレイク ---
bool ttInvalidation = useDTDBInvalidation and useTripleDTDB and ttPatternFound and not ttBreakDone and not na(ttTop1) and close > math.max(ttTop1, math.max(ttTop2, ttTop3)) + atrV * invalidationAtrMult
bool tbInvalidation = useDTDBInvalidation and useTripleDTDB and tbPatternFound and not tbBreakDone and not na(tbBottom1) and close < math.min(tbBottom1, math.min(tbBottom2, tbBottom3)) - atrV * invalidationAtrMult
bool ttBreak = ttPatternFound and not ttBreakDone and not na(necklineTT) and not na(htfClose) and htfClose < necklineTT
bool tbBreak = tbPatternFound and not tbBreakDone and not na(necklineTB) and not na(htfClose) and htfClose > necklineTB
if ttInvalidation
    ttInvalidated  := true
    ttPatternFound := false
if tbInvalidation
    tbInvalidated  := true
    tbPatternFound := false
if ttBreak and not ttInvalidation
    ttBreakDone := true
    ttBreakBar  := bar_index
if tbBreak and not tbInvalidation
    tbBreakDone := true
    tbBreakBar  := bar_index
if ttPatternFound and ttBreakDone and not na(ttBreakBar) and (bar_index - ttBreakBar > setupValidBars)
    ttPatternFound := false
    ttBreakDone    := false
    ttExpiredEvent := true
else if ttPatternFound and not ttBreakDone and not na(ttPatternBar) and (bar_index - ttPatternBar > setupValidBars)
    ttPatternFound := false
    ttExpiredEvent := true
if tbPatternFound and tbBreakDone and not na(tbBreakBar) and (bar_index - tbBreakBar > setupValidBars)
    tbPatternFound := false
    tbBreakDone    := false
    tbExpiredEvent := true
else if tbPatternFound and not tbBreakDone and not na(tbPatternBar) and (bar_index - tbPatternBar > setupValidBars)
    tbPatternFound := false
    tbExpiredEvent := true

// ============================================================
//  12. ネックラインリテスト
// ============================================================
bool dtSetupValid = dtPatternFound and dtBreakDone and not na(dtBreakBar) and (bar_index - dtBreakBar <= setupValidBars)
bool dbSetupValid = dbPatternFound and dbBreakDone and not na(dbBreakBar) and (bar_index - dbBreakBar <= setupValidBars)
bool dtRetest = dtSetupValid and not na(necklineDT) and high >= necklineDT - retestRange and close <= necklineDT + retestRange
bool dbRetest = dbSetupValid and not na(necklineDB) and low <= necklineDB + retestRange and close >= necklineDB - retestRange

bool ttSetupValid = ttPatternFound and ttBreakDone and not na(ttBreakBar) and (bar_index - ttBreakBar <= setupValidBars)
bool tbSetupValid = tbPatternFound and tbBreakDone and not na(tbBreakBar) and (bar_index - tbBreakBar <= setupValidBars)
bool ttRetest = ttSetupValid and not na(necklineTT) and high >= necklineTT - retestRange and close <= necklineTT + retestRange
bool tbRetest = tbSetupValid and not na(necklineTB) and low <= necklineTB + retestRange and close >= necklineTB - retestRange

// ============================================================
//  8. スイープ型 (Pattern 出力)
// ============================================================
bool dtSweepPattern = dAct and useSweepDTDB and dtPatternFound and dtIsSweep and dtSweepConfirmed
bool dbSweepPattern = dAct and useSweepDTDB and dbPatternFound and dbIsSweep and dbSweepConfirmed
bool ttSweepPattern = dAct and useSweepDTDB and useTripleDTDB and ttPatternFound and ttIsSweep and ttSweepConfirmed
bool tbSweepPattern = dAct and useSweepDTDB and useTripleDTDB and tbPatternFound and tbIsSweep and tbSweepConfirmed

// パターンフラグ出力
bool dtPattern = dtPatternFound
bool dbPattern = dbPatternFound
bool tripleTopPattern    = dAct and useTripleDTDB and ttPatternFound
bool tripleBottomPattern = dAct and useTripleDTDB and tbPatternFound
int topTouchCount    = not dAct ? 0 : ttPatternFound ? 3 : dtPatternFound ? 2 : 0
int bottomTouchCount = not dAct ? 0 : tbPatternFound ? 3 : dbPatternFound ? 2 : 0

// ============================================================
//  15. Quality Score (対称性は線形補間)
// ============================================================
bool revSpeedOkDt = not na(dtPatternBar) and (bar_index - dtPatternBar) <= quickRevBars
bool revSpeedOkDb = not na(dbPatternBar) and (bar_index - dbPatternBar) <= quickRevBars
bool quickOkDt = not useQuickRev or revSpeedOkDt
bool quickOkDb = not useQuickRev or revSpeedOkDb

float dtSymPts = (na(dtFirstTop) or na(dtSecondTop) or dtFirstTop == 0 or doubleTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(dtFirstTop - dtSecondTop) / dtFirstTop) / doubleTolerancePct))
float dbSymPts = (na(dbFirstBottom) or na(dbSecondBottom) or dbFirstBottom == 0 or doubleTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(dbFirstBottom - dbSecondBottom) / dbFirstBottom) / doubleTolerancePct))

bool dtNeckDepthOk = not useNeckDepth or (not na(dtFirstTop) and not na(dtSecondTop) and not na(necklineDT) and (math.min(dtFirstTop, dtSecondTop) - necklineDT) >= atrV * neckDepthMult)
bool dbNeckDepthOk = not useNeckDepth or (not na(dbFirstBottom) and not na(dbSecondBottom) and not na(necklineDB) and (necklineDB - math.max(dbFirstBottom, dbSecondBottom)) >= atrV * neckDepthMult)

int dtQuality = not dtPatternFound ? 0 : math.min(100, math.round(dtSymPts) + (dtNeckDepthOk ? 20 : 0) + (revSpeedOkDt ? 15 : 0) + ((useDTDBReversalCandle and (bearEngulf or bearPin)) ? 15 : 0) + (dtBreakDone ? 15 : 0) + (dtRetest ? 10 : 0) + (dtIsSweep ? 5 : 0))
int dbQuality = not dbPatternFound ? 0 : math.min(100, math.round(dbSymPts) + (dbNeckDepthOk ? 20 : 0) + (revSpeedOkDb ? 15 : 0) + ((useDTDBReversalCandle and (bullEngulf or bullPin)) ? 15 : 0) + (dbBreakDone ? 15 : 0) + (dbRetest ? 10 : 0) + (dbIsSweep ? 5 : 0))

// Triple Quality (3点の対称性は線形補間 +25)
bool revSpeedOkTt = not na(ttPatternBar) and (bar_index - ttPatternBar) <= quickRevBars
bool revSpeedOkTb = not na(tbPatternBar) and (bar_index - tbPatternBar) <= quickRevBars
float ttSymPts = (na(ttTop1) or na(ttTop2) or na(ttTop3) or tripleTolerancePct == 0) ? 0.0 : math.max(0.0, 25.0 * (1.0 - ((math.max(ttTop1, math.max(ttTop2, ttTop3)) - math.min(ttTop1, math.min(ttTop2, ttTop3))) / math.max(ttTop1, math.max(ttTop2, ttTop3))) / tripleTolerancePct))
float tbSymPts = (na(tbBottom1) or na(tbBottom2) or na(tbBottom3) or tripleTolerancePct == 0) ? 0.0 : math.max(0.0, 25.0 * (1.0 - ((math.max(tbBottom1, math.max(tbBottom2, tbBottom3)) - math.min(tbBottom1, math.min(tbBottom2, tbBottom3))) / math.max(tbBottom1, math.max(tbBottom2, tbBottom3))) / tripleTolerancePct))
bool ttNeckDepthOk = not useNeckDepth or (not na(ttTop1) and not na(necklineTT) and (math.min(ttTop1, math.min(ttTop2, ttTop3)) - necklineTT) >= atrV * neckDepthMult)
bool tbNeckDepthOk = not useNeckDepth or (not na(tbBottom1) and not na(necklineTB) and (necklineTB - math.max(tbBottom1, math.max(tbBottom2, tbBottom3))) >= atrV * neckDepthMult)
int ttQuality = not ttPatternFound ? 0 : math.min(100, math.round(ttSymPts) + (ttNeckDepthOk ? 20 : 0) + 10 + ((useDTDBReversalCandle and (bearEngulf or bearPin)) ? 15 : 0) + (ttBreakDone ? 15 : 0) + (ttRetest ? 10 : 0) + (ttIsSweep ? 5 : 0))
int tbQuality = not tbPatternFound ? 0 : math.min(100, math.round(tbSymPts) + (tbNeckDepthOk ? 20 : 0) + 10 + ((useDTDBReversalCandle and (bullEngulf or bullPin)) ? 15 : 0) + (tbBreakDone ? 15 : 0) + (tbRetest ? 10 : 0) + (tbIsSweep ? 5 : 0))

int dtdbQuality = math.max(math.max(dtQuality, dbQuality), math.max(ttQuality, tbQuality))
bool qualityOk = not useDTDBQualityFilter or dtdbQuality >= minDTDBQuality
bool quickOkTt = not useQuickRev or revSpeedOkTt
bool quickOkTb = not useQuickRev or revSpeedOkTb

// ============================================================
//  16. Signal 判定
// ============================================================
bool dtBreakSignal  = dtBreak and dtReversal and qualityOk and quickOkDt
bool dtRetestSignal = dtRetest and dtReversal and qualityOk and quickOkDt
bool dtSweepSignal  = dtSweepPattern and dtReversal and qualityOk and quickOkDt
bool dbBreakSignal  = dbBreak and dbReversal and qualityOk and quickOkDb
bool dbRetestSignal = dbRetest and dbReversal and qualityOk and quickOkDb
bool dbSweepSignal  = dbSweepPattern and dbReversal and qualityOk and quickOkDb

bool ttBreakSignal  = ttBreak and dtReversal and qualityOk and quickOkTt
bool ttRetestSignal = ttRetest and dtReversal and qualityOk and quickOkTt
bool ttSweepSignal  = ttSweepPattern and dtReversal and qualityOk and quickOkTt
bool tbBreakSignal  = tbBreak and dbReversal and qualityOk and quickOkTb
bool tbRetestSignal = tbRetest and dbReversal and qualityOk and quickOkTb
bool tbSweepSignal  = tbSweepPattern and dbReversal and qualityOk and quickOkTb

// 否定は逆方向 Bias
bool dbByInvalidation = dtInvalidation
bool dtByInvalidation = dbInvalidation
bool tbByInvalidation = ttInvalidation
bool ttByInvalidation = tbInvalidation

// ============================================================
//  17/18/19. Bias / Allow / NoTrade
// ============================================================
bool dtdbBiasShort = dAct and (dtBreakSignal or dtRetestSignal or dtSweepSignal or dtByInvalidation or ttBreakSignal or ttRetestSignal or ttSweepSignal or ttByInvalidation)
bool dtdbBiasLong  = dAct and (dbBreakSignal or dbRetestSignal or dbSweepSignal or dbByInvalidation or tbBreakSignal or tbRetestSignal or tbSweepSignal or tbByInvalidation)

bool allowLongByDTDB =
     not dAct ? true :
     dtdbEntryMode == "InvalidationOnly" ? (dbByInvalidation or tbByInvalidation) :
     dtdbEntryMode == "BreakOnly" ? (dbBreakSignal or tbBreakSignal) :
     dtdbEntryMode == "RetestOnly" ? (dbRetestSignal or tbRetestSignal) :
     dtdbEntryMode == "SweepOnly" ? (dbSweepSignal or tbSweepSignal) :
     dtdbBiasLong
bool allowShortByDTDB =
     not dAct ? true :
     dtdbEntryMode == "InvalidationOnly" ? (dtByInvalidation or ttByInvalidation) :
     dtdbEntryMode == "BreakOnly" ? (dtBreakSignal or ttBreakSignal) :
     dtdbEntryMode == "RetestOnly" ? (dtRetestSignal or ttRetestSignal) :
     dtdbEntryMode == "SweepOnly" ? (dtSweepSignal or ttSweepSignal) :
     dtdbBiasShort

bool anyTopPattern    = dtPattern or tripleTopPattern
bool anyBottomPattern = dbPattern or tripleBottomPattern
bool rConflict = anyTopPattern and anyBottomPattern
bool rLowQual  = useDTDBQualityFilter and (anyTopPattern or anyBottomPattern) and not qualityOk
bool rExpired  = dtExpiredEvent or dbExpiredEvent or ttExpiredEvent or tbExpiredEvent
bool rFailedRS = dtRightSideFailed or dbRightSideFailed or ttRightSideFailed or tbRightSideFailed
bool rInval    = dtInvalidation or dbInvalidation or ttInvalidation or tbInvalidation

int dtdbNoTradeReason = not dAct ? 0 : rConflict ? 1 : rLowQual ? 2 : rExpired ? 3 : rFailedRS ? 4 : rInval ? 5 : 0
bool dtdbNoTrade      = dAct and (rConflict or rLowQual or rExpired or rFailedRS or rInval)
bool dtdbNoTradeLong  = dtdbNoTrade
bool dtdbNoTradeShort = dtdbNoTrade

// ============================================================
//  20. Signal Type
//  優先: NoTrade > Invalidation > Retest > Break > Sweep > Pattern
// ============================================================
int dtdbSignalType =
     not dAct ? 0 :
     dtdbNoTrade ? 11 :
     dtInvalidation ? 7 :
     dbInvalidation ? 8 :
     ttInvalidation ? 18 :
     tbInvalidation ? 19 :
     dtRetest ? 5 :
     dbRetest ? 6 :
     ttRetest ? 16 :
     tbRetest ? 17 :
     dtBreak ? 3 :
     dbBreak ? 4 :
     ttBreak ? 14 :
     tbBreak ? 15 :
     dtSweepPattern ? 9 :
     dbSweepPattern ? 10 :
     ttSweepPattern ? 20 :
     tbSweepPattern ? 21 :
     tripleTopPattern ? 12 :
     tripleBottomPattern ? 13 :
     dtPattern ? 1 :
     dbPattern ? 2 : 0

// ============================================================
//  21. Direction
// ============================================================
int dtdbDirection = not dAct ? 0 : (dtdbBiasLong and not dtdbBiasShort) ? 1 : (dtdbBiasShort and not dtdbBiasLong) ? -1 : 0

// ============================================================
//  22. Rank (0〜10)
// ============================================================
bool anyRetest = dtRetest or dbRetest or ttRetest or tbRetest
bool anyBreak  = dtBreak or dbBreak or ttBreak or tbBreak
bool anyInval  = dtInvalidation or dbInvalidation or ttInvalidation or tbInvalidation
bool anySweep  = dtSweepPattern or dbSweepPattern or ttSweepPattern or tbSweepPattern
bool anyRev    = dtReversal or dbReversal

int dtdbRank =
     not dAct ? 0 :
     (anySweep and anyRetest and dtdbQuality >= 80) ? 10 :
     anyInval ? 9 :
     dtdbQuality >= 80 ? 8 :
     dtdbQuality >= 70 ? 7 :
     anySweep ? 6 :
     (anyRetest and anyRev) ? 5 :
     anyRetest ? 4 :
     anyBreak ? 3 :
     (qualityOk and dtdbQuality > 0) ? 2 :
     (dtPattern or dbPattern or tripleTopPattern or tripleBottomPattern) ? 1 : 0

// ============================================================
//  23. 表示 : ネックライン (パターン保持中のみ)
// ============================================================
plot(showDTDBLines and dtPatternFound ? necklineDT : na, "necklineDT", color = color.new(color.red, 0),   style = plot.style_linebr)
plot(showDTDBLines and dbPatternFound ? necklineDB : na, "necklineDB", color = color.new(color.green, 0), style = plot.style_linebr)
plot(showDTDBLines and ttPatternFound ? necklineTT : na, "necklineTT", color = color.new(color.maroon, 0), style = plot.style_linebr)
plot(showDTDBLines and tbPatternFound ? necklineTB : na, "necklineTB", color = color.new(color.teal, 0),   style = plot.style_linebr)

// ============================================================
//  23. 表示 : ラベル (状態変化時のみ)
// ============================================================
if showDTDBLabels and dAct
    if dtPattern and not dtPattern[1]
        label.new(bar_index, high, "Double Top", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 30), textcolor = color.white, size = size.small)
    if dbPattern and not dbPattern[1]
        label.new(bar_index, low, "Double Bottom", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 30), textcolor = color.white, size = size.small)
    if dtBreak and not dtBreak[1]
        label.new(bar_index, high, "DT Break", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
    if dbBreak and not dbBreak[1]
        label.new(bar_index, low, "DB Break", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
    if dtRetest and not dtRetest[1]
        label.new(bar_index, high, "DT Retest", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    if dbRetest and not dbRetest[1]
        label.new(bar_index, low, "DB Retest", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    if dtInvalidation and not dtInvalidation[1]
        label.new(bar_index, low, "DT Invalid", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
    if dbInvalidation and not dbInvalidation[1]
        label.new(bar_index, high, "DB Invalid", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
    if dtSweepPattern and not dtSweepPattern[1]
        label.new(bar_index, high, "DT Sweep", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
    if dbSweepPattern and not dbSweepPattern[1]
        label.new(bar_index, low, "DB Sweep", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
    if dtRightSideBuilding and not dtRightSideBuilding[1]
        label.new(bar_index, high, "DT Right Build", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny)
    if dbRightSideBuilding and not dbRightSideBuilding[1]
        label.new(bar_index, low, "DB Right Build", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny)
    if dtRightSideFailed and not dtRightSideFailed[1]
        label.new(bar_index, high, "DT Right Fail", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.gray, 0), textcolor = color.white, size = size.tiny)
    if dbRightSideFailed and not dbRightSideFailed[1]
        label.new(bar_index, low, "DB Right Fail", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.gray, 0), textcolor = color.white, size = size.tiny)
    if tripleTopPattern and not tripleTopPattern[1]
        label.new(bar_index, high, "Triple Top", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.maroon, 20), textcolor = color.white, size = size.small)
    if tripleBottomPattern and not tripleBottomPattern[1]
        label.new(bar_index, low, "Triple Bottom", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.teal, 20), textcolor = color.white, size = size.small)
    if ttBreak and not ttBreak[1]
        label.new(bar_index, high, "TT Break", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
    if tbBreak and not tbBreak[1]
        label.new(bar_index, low, "TB Break", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
    if ttRetest and not ttRetest[1]
        label.new(bar_index, high, "TT Retest", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.maroon, 0), textcolor = color.white, size = size.small)
    if tbRetest and not tbRetest[1]
        label.new(bar_index, low, "TB Retest", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
    if ttInvalidation and not ttInvalidation[1]
        label.new(bar_index, low, "TT Invalid", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
    if tbInvalidation and not tbInvalidation[1]
        label.new(bar_index, high, "TB Invalid", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
    if ttSweepPattern and not ttSweepPattern[1]
        label.new(bar_index, high, "TT Sweep", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
    if tbSweepPattern and not tbSweepPattern[1]
        label.new(bar_index, low, "TB Sweep", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
    if ttRightSideBuilding and not ttRightSideBuilding[1]
        label.new(bar_index, high, "TT Right Build", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.olive, 0), textcolor = color.white, size = size.tiny)
    if tbRightSideBuilding and not tbRightSideBuilding[1]
        label.new(bar_index, low, "TB Right Build", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.olive, 0), textcolor = color.white, size = size.tiny)
    if ttRightSideFailed and not ttRightSideFailed[1]
        label.new(bar_index, high, "TT Right Fail", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.gray, 0), textcolor = color.white, size = size.tiny)
    if tbRightSideFailed and not tbRightSideFailed[1]
        label.new(bar_index, low, "TB Right Fail", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.gray, 0), textcolor = color.white, size = size.tiny)

// ============================================================
//  23. 表示 : Shape
// ============================================================
plotshape(showDTDBLabels and dAct and dtBreak and not dtBreak[1],  title = "DT Break",  style = shape.xcross,  location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(showDTDBLabels and dAct and dbBreak and not dbBreak[1],  title = "DB Break",  style = shape.xcross,  location = location.belowbar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(showDTDBLabels and dAct and dtRetest and not dtRetest[1], title = "DT Retest", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),    size = size.tiny)
plotshape(showDTDBLabels and dAct and dbRetest and not dbRetest[1], title = "DB Retest", style = shape.circle, location = location.belowbar, color = color.new(color.green, 0),  size = size.tiny)

// ============================================================
//  24. Debug Table
// ============================================================
f_typeStr(t) =>
    t == 1  ? "DT Pattern" :
     t == 2  ? "DB Pattern" :
     t == 3  ? "DT Break" :
     t == 4  ? "DB Break" :
     t == 5  ? "DT Retest" :
     t == 6  ? "DB Retest" :
     t == 7  ? "DT Invalidation" :
     t == 8  ? "DB Invalidation" :
     t == 9  ? "DT Sweep" :
     t == 10 ? "DB Sweep" :
     t == 11 ? "NoTrade" :
     t == 12 ? "TT Pattern" :
     t == 13 ? "TB Pattern" :
     t == 14 ? "TT Break" :
     t == 15 ? "TB Break" :
     t == 16 ? "TT Retest" :
     t == 17 ? "TB Retest" :
     t == 18 ? "TT Invalidation" :
     t == 19 ? "TB Invalidation" :
     t == 20 ? "TT Sweep" :
     t == 21 ? "TB Sweep" :
     "None"
f_reasonStr(r) =>
    r == 1 ? "Conflict" : r == 2 ? "Low Quality" : r == 3 ? "Expired" : r == 4 ? "Right Failed" : r == 5 ? "Invalidated" : "None"

var table dbg = table.new(position.top_right, 2, 28, border_width = 1)
if showDTDBDebugTable and dAct and barstate.islast
    string sDir = dtdbDirection == 1 ? "BUY" : dtdbDirection == -1 ? "SELL" : "-"
    string sState = dtdbNoTrade ? "NoTrade" : dtdbBiasLong ? "BIAS L" : dtdbBiasShort ? "BIAS S" : "-"
    table.cell(dbg, 0, 0,  "DTDB State", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0,  sState, text_color = color.white, bgcolor = dtdbNoTrade ? color.new(color.red, 20) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1,  "SignalType", text_color = color.white)
    table.cell(dbg, 1, 1,  f_typeStr(dtdbSignalType), text_color = color.white)
    table.cell(dbg, 0, 2,  "Direction", text_color = color.white)
    table.cell(dbg, 1, 2,  sDir, text_color = color.white)
    table.cell(dbg, 0, 3,  "Rank / Quality", text_color = color.white)
    table.cell(dbg, 1, 3,  str.tostring(dtdbRank) + " / " + str.tostring(dtdbQuality), text_color = color.white)
    table.cell(dbg, 0, 4,  "DT/DB Qual", text_color = color.white)
    table.cell(dbg, 1, 4,  str.tostring(dtQuality) + " / " + str.tostring(dbQuality), text_color = color.white)
    table.cell(dbg, 0, 5,  "DT/DB Pat", text_color = color.white)
    table.cell(dbg, 1, 5,  (dtPattern ? "Y" : "N") + " / " + (dbPattern ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 6,  "DT/DB Break", text_color = color.white)
    table.cell(dbg, 1, 6,  (dtBreakDone ? "Y" : "N") + " / " + (dbBreakDone ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 7,  "DT/DB Retest", text_color = color.white)
    table.cell(dbg, 1, 7,  (dtRetest ? "Y" : "N") + " / " + (dbRetest ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 8,  "DT/DB Inval", text_color = color.white)
    table.cell(dbg, 1, 8,  (dtInvalidated ? "Y" : "N") + " / " + (dbInvalidated ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 9,  "DT/DB Sweep", text_color = color.white)
    table.cell(dbg, 1, 9,  (dtSweepPattern ? "Y" : "N") + " / " + (dbSweepPattern ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 10, "Right Build DT/DB", text_color = color.white)
    table.cell(dbg, 1, 10, (dtRightSideBuilding ? "Y" : "N") + " / " + (dbRightSideBuilding ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 11, "Right Fail DT/DB", text_color = color.white)
    table.cell(dbg, 1, 11, (dtRightSideFailed ? "Y" : "N") + " / " + (dbRightSideFailed ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 12, "NoTrade Reason", text_color = color.white)
    table.cell(dbg, 1, 12, f_reasonStr(dtdbNoTradeReason), text_color = color.white)
    table.cell(dbg, 0, 13, "DT Neckline", text_color = color.white)
    table.cell(dbg, 1, 13, na(necklineDT) ? "-" : str.tostring(necklineDT, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 14, "DB Neckline", text_color = color.white)
    table.cell(dbg, 1, 14, na(necklineDB) ? "-" : str.tostring(necklineDB, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 15, "Pivot H/L", text_color = color.white)
    table.cell(dbg, 1, 15, str.tostring(array.size(phVals)) + " / " + str.tostring(array.size(plVals)), text_color = color.white)
    table.cell(dbg, 0, 16, "Entry Mode", text_color = color.white)
    table.cell(dbg, 1, 16, dtdbEntryMode, text_color = color.white)
    table.cell(dbg, 0, 17, "Allow L/S", text_color = color.white)
    table.cell(dbg, 1, 17, (allowLongByDTDB ? "L" : "-") + " / " + (allowShortByDTDB ? "S" : "-"), text_color = color.white)
    table.cell(dbg, 0, 18, "Stage DT/DB", text_color = color.white)
    table.cell(dbg, 1, 18, str.tostring(dtStage) + " / " + str.tostring(dbStage), text_color = color.white)
    table.cell(dbg, 0, 19, "TT/TB Pattern", text_color = color.white)
    table.cell(dbg, 1, 19, (tripleTopPattern ? "Y" : "N") + " / " + (tripleBottomPattern ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 20, "TT/TB Break", text_color = color.white)
    table.cell(dbg, 1, 20, (ttBreakDone ? "Y" : "N") + " / " + (tbBreakDone ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 21, "TT/TB Retest", text_color = color.white)
    table.cell(dbg, 1, 21, (ttRetest ? "Y" : "N") + " / " + (tbRetest ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 22, "TT/TB Invalid", text_color = color.white)
    table.cell(dbg, 1, 22, (ttInvalidated ? "Y" : "N") + " / " + (tbInvalidated ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 23, "TT/TB Sweep", text_color = color.white)
    table.cell(dbg, 1, 23, (ttSweepPattern ? "Y" : "N") + " / " + (tbSweepPattern ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 24, "TT/TB Quality", text_color = color.white)
    table.cell(dbg, 1, 24, str.tostring(ttQuality) + " / " + str.tostring(tbQuality), text_color = color.white)
    table.cell(dbg, 0, 25, "Touch Top/Bot", text_color = color.white)
    table.cell(dbg, 1, 25, str.tostring(topTouchCount) + " / " + str.tostring(bottomTouchCount), text_color = color.white)
    table.cell(dbg, 0, 26, "TT/TB Stage", text_color = color.white)
    table.cell(dbg, 1, 26, str.tostring(ttStage) + " / " + str.tostring(tbStage), text_color = color.white)
    table.cell(dbg, 0, 27, "Triple Enabled", text_color = color.white)
    table.cell(dbg, 1, 27, useTripleDTDB ? "ON" : "OFF", text_color = color.white)

// ============================================================
//  25. Data Window 出力
// ============================================================
plot(allowLongByDTDB  ? 1 : 0, "allowLongByDTDB",  display = display.data_window)
plot(allowShortByDTDB ? 1 : 0, "allowShortByDTDB", display = display.data_window)
plot(dtdbBiasLong  ? 1 : 0, "dtdbBiasLong",  display = display.data_window)
plot(dtdbBiasShort ? 1 : 0, "dtdbBiasShort", display = display.data_window)

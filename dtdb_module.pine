plot(dbQuality, "dbQuality", display = display.data_window)
plot(dtPattern ? 1 : 0, "dtPattern", display = display.data_window)
plot(dbPattern ? 1 : 0, "dbPattern", display = display.data_window)
plot(dtBreak ? 1 : 0, "dtBreak", display = display.data_window)
plot(dbBreak ? 1 : 0, "dbBreak", display = display.data_window)
plot(dtRetest ? 1 : 0, "dtRetest", display = display.data_window)
plot(dbRetest ? 1 : 0, "dbRetest", display = display.data_window)
plot(dtInvalidation ? 1 : 0, "dtInvalidation", display = display.data_window)
plot(dbInvalidation ? 1 : 0, "dbInvalidation", display = display.data_window)
plot(dtRightSideBuilding ? 1 : 0, "dtRightSideBuilding", display = display.data_window)
plot(dbRightSideBuilding ? 1 : 0, "dbRightSideBuilding", display = display.data_window)
plot(dtRightSideFailed ? 1 : 0, "dtRightSideFailed", display = display.data_window)
plot(dbRightSideFailed ? 1 : 0, "dbRightSideFailed", display = display.data_window)
plot(dtSweepPattern ? 1 : 0, "dtSweepPattern", display = display.data_window)
plot(dbSweepPattern ? 1 : 0, "dbSweepPattern", display = display.data_window)
plot(necklineDT, "necklineDTVal", display = display.data_window)
plot(necklineDB, "necklineDBVal", display = display.data_window)
plot(dtStage, "dtStage", display = display.data_window)
plot(dbStage, "dbStage", display = display.data_window)

// --- Triple Top/Bottom 出力 ---
plot(tripleTopPattern    ? 1 : 0, "tripleTopPattern",    display = display.data_window)
plot(tripleBottomPattern ? 1 : 0, "tripleBottomPattern", display = display.data_window)
plot(ttBreak ? 1 : 0, "ttBreak", display = display.data_window)
plot(tbBreak ? 1 : 0, "tbBreak", display = display.data_window)
plot(ttRetest ? 1 : 0, "ttRetest", display = display.data_window)
plot(tbRetest ? 1 : 0, "tbRetest", display = display.data_window)
plot(ttInvalidation ? 1 : 0, "ttInvalidation", display = display.data_window)
plot(tbInvalidation ? 1 : 0, "tbInvalidation", display = display.data_window)
plot(ttQuality, "ttQuality", display = display.data_window)
plot(tbQuality, "tbQuality", display = display.data_window)
plot(topTouchCount,    "topTouchCount",    display = display.data_window)
plot(bottomTouchCount, "bottomTouchCount", display = display.data_window)
plot(ttSweepPattern ? 1 : 0, "ttSweepPattern", display = display.data_window)
plot(tbSweepPattern ? 1 : 0, "tbSweepPattern", display = display.data_window)
plot(ttRightSideBuilding ? 1 : 0, "ttRightSideBuilding", display = display.data_window)
plot(tbRightSideBuilding ? 1 : 0, "tbRightSideBuilding", display = display.data_window)
plot(ttRightSideFailed ? 1 : 0, "ttRightSideFailed", display = display.data_window)
plot(tbRightSideFailed ? 1 : 0, "tbRightSideFailed", display = display.data_window)
plot(necklineTT, "necklineTTVal", display = display.data_window)
plot(necklineTB, "necklineTBVal", display = display.data_window)

// ============================================================
//  26. Alert (全て状態変化時のみ)
// ============================================================
alertcondition(dAct and dtPattern and not dtPattern[1], "DT Pattern", "{{ticker}} ダブルトップ 形成")
alertcondition(dAct and dbPattern and not dbPattern[1], "DB Pattern", "{{ticker}} ダブルボトム 形成")
alertcondition(dAct and dtBreak and not dtBreak[1], "DT Break", "{{ticker}} DT ネックラインブレイク")
alertcondition(dAct and dbBreak and not dbBreak[1], "DB Break", "{{ticker}} DB ネックラインブレイク")
alertcondition(dAct and dtRetest and not dtRetest[1], "DT Retest", "{{ticker}} DT リテスト")
alertcondition(dAct and dbRetest and not dbRetest[1], "DB Retest", "{{ticker}} DB リテスト")
alertcondition(dAct and dtInvalidation and not dtInvalidation[1], "DT Invalidation", "{{ticker}} DT 否定")
alertcondition(dAct and dbInvalidation and not dbInvalidation[1], "DB Invalidation", "{{ticker}} DB 否定")
alertcondition(dAct and dtSweepPattern and not dtSweepPattern[1], "DT Sweep", "{{ticker}} DT スイープ")
alertcondition(dAct and dbSweepPattern and not dbSweepPattern[1], "DB Sweep", "{{ticker}} DB スイープ")
alertcondition(dAct and dtRightSideBuilding and not dtRightSideBuilding[1], "DT Right Side Building", "{{ticker}} DT 右山形成中")
alertcondition(dAct and dbRightSideBuilding and not dbRightSideBuilding[1], "DB Right Side Building", "{{ticker}} DB 右底形成中")
alertcondition(dAct and dtRightSideFailed and not dtRightSideFailed[1], "DT Right Side Failed", "{{ticker}} DT 右山崩れ")
alertcondition(dAct and dbRightSideFailed and not dbRightSideFailed[1], "DB Right Side Failed", "{{ticker}} DB 右底崩れ")
alertcondition(allowLongByDTDB and not allowLongByDTDB[1],   "Allow Long DTDB",  "{{ticker}} DT/DB ロング許可")
alertcondition(allowShortByDTDB and not allowShortByDTDB[1], "Allow Short DTDB", "{{ticker}} DT/DB ショート許可")
alertcondition(dtdbNoTrade and not dtdbNoTrade[1], "DTDB NoTrade", "{{ticker}} DT/DB ノートレード")
alertcondition(dAct and tripleTopPattern and not tripleTopPattern[1], "Triple Top Pattern", "{{ticker}} トリプルトップ 形成")
alertcondition(dAct and tripleBottomPattern and not tripleBottomPattern[1], "Triple Bottom Pattern", "{{ticker}} トリプルボトム 形成")
alertcondition(dAct and ttBreak and not ttBreak[1], "TT Break", "{{ticker}} TT ネックラインブレイク")
alertcondition(dAct and tbBreak and not tbBreak[1], "TB Break", "{{ticker}} TB ネックラインブレイク")
alertcondition(dAct and ttRetest and not ttRetest[1], "TT Retest", "{{ticker}} TT リテスト")
alertcondition(dAct and tbRetest and not tbRetest[1], "TB Retest", "{{ticker}} TB リテスト")
alertcondition(dAct and ttInvalidation and not ttInvalidation[1], "TT Invalidation", "{{ticker}} TT 否定")
alertcondition(dAct and tbInvalidation and not tbInvalidation[1], "TB Invalidation", "{{ticker}} TB 否定")
alertcondition(dAct and ttSweepPattern and not ttSweepPattern[1], "TT Sweep", "{{ticker}} TT スイープ")
alertcondition(dAct and tbSweepPattern and not tbSweepPattern[1], "TB Sweep", "{{ticker}} TB スイープ")
alertcondition(dAct and ttRightSideBuilding and not ttRightSideBuilding[1], "TT Right Side Building", "{{ticker}} TT 右山形成中")
alertcondition(dAct and tbRightSideBuilding and not tbRightSideBuilding[1], "TB Right Side Building", "{{ticker}} TB 右底形成中")
alertcondition(dAct and ttRightSideFailed and not ttRightSideFailed[1], "TT Right Side Failed", "{{ticker}} TT 右山崩れ")
alertcondition(dAct and tbRightSideFailed and not tbRightSideFailed[1], "TB Right Side Failed", "{{ticker}} TB 右底崩れ")

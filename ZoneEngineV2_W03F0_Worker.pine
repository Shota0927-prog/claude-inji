            if setKind == SET_SIM_ACTIVE
                if array.get(rootStates, rootSlot) == ROOT_ACTIVE
                    pos := array.get(rootStateSetPositions, rootSlot)
            else if array.get(rootCategories, rootSlot) == CAT_FVG and array.get(rootTfCodes, rootSlot) == tfCode and (tfCode == TF_1H or tfCode == TF_4H or tfCode == TF_D)

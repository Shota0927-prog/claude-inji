virtualSetCommittedPositionRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<int> rootStates, array<bool> rootSlotLiveFlags, array<int> rootStateSetPositions, array<int> rootFvgFreshSetPositions, array<int> rootFvgStructuralStateSetPositions, int setKind, int tfCode, int rootSlot) =>

// Main virtualSetCommittedSizeRaw (lines 6790-6808)
virtualSetCommittedSizeRaw(array<int> stateActiveRootSlots, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> structurallyActiveFvg1hRootSlots, array<int> structurallyActiveFvg4hRootSlots, array<int> structurallyActiveFvgDRootSlots, int setKind, int tfCode) =>
    int size = SLOT_INVALID
    if setKind == SET_SIM_ACTIVE
        size := array.size(stateActiveRootSlots)
    else if setKind == SET_SIM_FVG_STRUCTURAL
        if tfCode == TF_1H
            size := array.size(structurallyActiveFvg1hRootSlots)
        else if tfCode == TF_4H
            size := array.size(structurallyActiveFvg4hRootSlots)
        else if tfCode == TF_D
            size := array.size(structurallyActiveFvgDRootSlots)
    else if setKind == SET_SIM_FVG_FRESH
        if tfCode == TF_1H
            size := array.size(freshFvg1hRootSlots)
        else if tfCode == TF_4H
            size := array.size(freshFvg4hRootSlots)
        else if tfCode == TF_D
            size := array.size(freshFvgDRootSlots)
    size

// Main virtualSetCommittedSlotAtRaw (lines 6812-6831)
virtualSetCommittedSlotAtRaw(array<int> stateActiveRootSlots, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> structurallyActiveFvg1hRootSlots, array<int> structurallyActiveFvg4hRootSlots, array<int> structurallyActiveFvgDRootSlots, int setKind, int tfCode, int index) =>
    int slot = SLOT_INVALID
    if index >= 0 and index < virtualSetCommittedSizeRaw(stateActiveRootSlots, freshFvg1hRootSlots, freshFvg4hRootSlots, freshFvgDRootSlots, structurallyActiveFvg1hRootSlots, structurallyActiveFvg4hRootSlots, structurallyActiveFvgDRootSlots, setKind, tfCode)
        if setKind == SET_SIM_ACTIVE
            slot := array.get(stateActiveRootSlots, index)
        else if setKind == SET_SIM_FVG_STRUCTURAL
            if tfCode == TF_1H
                slot := array.get(structurallyActiveFvg1hRootSlots, index)
            else if tfCode == TF_4H
                slot := array.get(structurallyActiveFvg4hRootSlots, index)
            else if tfCode == TF_D
                slot := array.get(structurallyActiveFvgDRootSlots, index)
        else if setKind == SET_SIM_FVG_FRESH
            if tfCode == TF_1H
                slot := array.get(freshFvg1hRootSlots, index)
            else if tfCode == TF_4H
                slot := array.get(freshFvg4hRootSlots, index)
            else if tfCode == TF_D
                slot := array.get(freshFvgDRootSlots, index)
    slot


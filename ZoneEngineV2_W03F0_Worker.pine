//@version=6
// ============================================================
// ZoneEngineV2_W03F0_Worker - W03 Stage F F0 preflight worker (PLAN S3-B)
//
// Read-only journal preflight moved out of the Main library for the compiled token
// limit. Every helper below is the Main function of the same name with the Main
// Engine fields passed in as parameters of the same name; the logic is unchanged.
// Failure stops the script with runtime.error("W03_JOURNAL_PREFLIGHT") before any
// apply write. No import, no type, no persistent storage, no request, no drawing.
// ============================================================
library("ZoneEngineV2_W03F0_Worker", overlay = false)

// ---- constants : exact copies of the Main declarations ----
const int ID_NONE         = 0
const int SLOT_INVALID    = -1
const int SEQ_UNSET       = -1
const int CAT_MA          = 0
const int CAT_SWING       = 1
const int CAT_ACCUM       = 2
const int CAT_TIME_HL     = 3
const int CAT_FVG         = 4
const int CAT_PSYCH       = 5
const int ROOT_CANDIDATE      = 0
const int ROOT_ACTIVE         = 1
const int ROOT_INVALIDATED    = 2
const int ROOT_INVERSE_WAIT   = 3
const int ROOT_INVERSE_ACTIVE = 4
const int ROOT_RETIRED        = 5
const int FVG_NONE     = 0
const int FVG_BULLISH  = 1
const int FVG_BEARISH  = 2
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_D   = 1440
const int JGROUP_E1 = 1
const int JGROUP_E2 = 2
const int JGROUP_E3 = 3
const int JGROUP_E4 = 4
const int JOP_FVG_INVALIDATE = 1
const int JOP_NEW_ROOT       = 2
const int JOP_MA_UPDATE      = 3
const int JOP_SWING_TF_MERGE = 4
const int JOP_TIMEHL_LABEL   = 5
const int JOP_FVG_FRESH_END  = 6
const int JOP_ROOT_RETIRE    = 7
const int SWING_TF_MASK_NONE = 0
const int SWING_TF_MASK_5M   = 1
const int SWING_TF_MASK_15M  = 2
const int SWING_TF_MASK_1H   = 4
const int SUB_MA_EMA2000   = 1
const int SUB_MA_EMA3000   = 2
const int SUB_SWING_HIGH   = 1
const int SUB_SWING_LOW    = 2
const int SUB_ACCUM_UPPER  = 1
const int SUB_ACCUM_LOWER  = 2
const int SUB_TIMEHL_HIGH  = 1
const int SUB_TIMEHL_LOW   = 2
const int SET_SIM_ACTIVE         = 1
const int SET_SIM_FVG_STRUCTURAL = 2
const int SET_SIM_FVG_FRESH      = 3

// Main rootPriceOrderUpperBoundRaw (lines 3059-3079)
rootPriceOrderUpperBoundRaw(array<int> rootIds, array<bool> rootIsRangeRootFlags, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, int pointTick) =>
    int  pos = SLOT_INVALID
    bool ok  = not na(pointTick)
    if ok
        int lo = 0
        int hi = array.size(rootPriceOrderSlots)
        while ok and lo < hi
            int mid  = int(math.floor((lo + hi) / 2))
            int slot = array.get(rootPriceOrderSlots, mid)
            bool entryOk = slot >= 0 and slot < array.size(rootIds) and slot < array.size(rootSlotLiveFlags) and slot < array.size(rootPointTicks) and slot < array.size(rootIsRangeRootFlags) and slot < array.size(rootPriceOrderPositions)
            if entryOk
                entryOk := array.get(rootSlotLiveFlags, slot) and array.get(rootPriceOrderPositions, slot) == mid and not array.get(rootIsRangeRootFlags, slot) and not na(array.get(rootPointTicks, slot))
            if not entryOk
                ok := false
            else if array.get(rootPointTicks, slot) <= pointTick
                lo := mid + 1
            else
                hi := mid
        if ok
            pos := lo
    [pos, ok]

// Main fvgSetMembershipValidRaw (lines 4559-4605)
fvgSetMembershipValidRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<int> rootStates, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<bool> rootSlotLiveFlags, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> structurallyActiveFvg1hRootSlots, array<int> structurallyActiveFvg4hRootSlots, array<int> structurallyActiveFvgDRootSlots, array<int> bullishFvgRootSlots, array<int> bearishFvgRootSlots, array<int> broadFvgRootSlots, array<int> rootFvgFreshSetPositions, array<int> rootFvgStructuralStateSetPositions, array<int> rootFvgDirectionSetPositions, array<int> rootFvgBroadSetPositions, int rootSlot, int expectedRootId) =>
    bool ok = rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootTfCodes) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootDirections) and rootSlot < array.size(rootFvgFreshFlags) and rootSlot < array.size(rootIsBroadFvgFlags) and rootSlot < array.size(rootFvgFreshSetPositions) and rootSlot < array.size(rootFvgStructuralStateSetPositions) and rootSlot < array.size(rootFvgDirectionSetPositions) and rootSlot < array.size(rootFvgBroadSetPositions)
    int  tf    = int(na)
    int  dir   = int(na)
    int  state = int(na)
    if ok
        tf    := array.get(rootTfCodes,    rootSlot)
        dir   := array.get(rootDirections, rootSlot)
        state := array.get(rootStates,     rootSlot)
        ok    := array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId and array.get(rootCategories, rootSlot) == CAT_FVG and (tf == TF_1H or tf == TF_4H or tf == TF_D) and (dir == FVG_BULLISH or dir == FVG_BEARISH) and (state == ROOT_ACTIVE or state == ROOT_INVALIDATED or state == ROOT_INVERSE_WAIT or state == ROOT_INVERSE_ACTIVE)
    if ok
        array<int> freshSet  = tf == TF_1H ? freshFvg1hRootSlots : tf == TF_4H ? freshFvg4hRootSlots : freshFvgDRootSlots
        array<int> activeSet = tf == TF_1H ? structurallyActiveFvg1hRootSlots : tf == TF_4H ? structurallyActiveFvg4hRootSlots : structurallyActiveFvgDRootSlots
        array<int> dirSet    = dir == FVG_BULLISH ? bullishFvgRootSlots : bearishFvgRootSlots
        int freshPos  = array.get(rootFvgFreshSetPositions,           rootSlot)
        int structPos = array.get(rootFvgStructuralStateSetPositions, rootSlot)
        int dirPos    = array.get(rootFvgDirectionSetPositions,       rootSlot)
        int broadPos  = array.get(rootFvgBroadSetPositions,           rootSlot)
        if array.get(rootFvgFreshFlags, rootSlot)
            ok := freshPos >= 0 and freshPos < array.size(freshSet)
            if ok
                ok := array.get(freshSet, freshPos) == rootSlot
        else
            ok := freshPos == SLOT_INVALID
        if ok
            if state == ROOT_ACTIVE
                ok := structPos >= 0 and structPos < array.size(activeSet)
                if ok
                    ok := array.get(activeSet, structPos) == rootSlot
            else
                ok := structPos == SLOT_INVALID
        if ok
            ok := dirPos >= 0 and dirPos < array.size(dirSet)
            if ok
                ok := array.get(dirSet, dirPos) == rootSlot
        if ok
            if array.get(rootIsBroadFvgFlags, rootSlot)
                ok := broadPos >= 0 and broadPos < array.size(broadFvgRootSlots)
                if ok
                    ok := array.get(broadFvgRootSlots, broadPos) == rootSlot
            else
                ok := broadPos == SLOT_INVALID
    ok

// Main rootSetMembershipValidRaw (lines 4954-5025)
rootSetMembershipValidRaw(array<int> rootIds, array<int> rootCategories, array<int> rootTfCodes, array<int> rootStates, array<bool> rootSlotLiveFlags, array<int> categoryMaRootSlots, array<int> categorySwingRootSlots, array<int> categoryAccumRootSlots, array<int> categoryTimeHlRootSlots, array<int> categoryFvgRootSlots, array<int> categoryPsychRootSlots, array<int> tf1mRootSlots, array<int> tf5mRootSlots, array<int> tf15mRootSlots, array<int> tf1hRootSlots, array<int> tf4hRootSlots, array<int> tfDRootSlots, array<int> stateCandidateRootSlots, array<int> stateActiveRootSlots, array<int> stateInvalidatedRootSlots, array<int> stateInverseWaitRootSlots, array<int> stateInverseActiveRootSlots, array<int> stateRetiredRootSlots, array<int> rootCategorySetPositions, array<int> rootTfSetPositions, array<int> rootStateSetPositions, int rootSlot) =>
    bool valid = false
    if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootCategories) and rootSlot < array.size(rootTfCodes) and rootSlot < array.size(rootStates) and rootSlot < array.size(rootCategorySetPositions) and rootSlot < array.size(rootTfSetPositions) and rootSlot < array.size(rootStateSetPositions)
        if array.get(rootSlotLiveFlags, rootSlot) and array.get(rootIds, rootSlot) != ID_NONE
            int category = array.get(rootCategories,          rootSlot)
            int tfCode   = array.get(rootTfCodes,             rootSlot)
            int state    = array.get(rootStates,              rootSlot)
            int catPos   = array.get(rootCategorySetPositions, rootSlot)
            int tfPos    = array.get(rootTfSetPositions,       rootSlot)
            int statePos = array.get(rootStateSetPositions,    rootSlot)
            bool catValid   = false
            bool tfValid    = false
            bool stateValid = false
            if catPos >= 0
                if category == CAT_MA
                    if catPos < array.size(categoryMaRootSlots)
                        catValid := array.get(categoryMaRootSlots, catPos) == rootSlot
                else if category == CAT_SWING
                    if catPos < array.size(categorySwingRootSlots)
                        catValid := array.get(categorySwingRootSlots, catPos) == rootSlot
                else if category == CAT_ACCUM
                    if catPos < array.size(categoryAccumRootSlots)
                        catValid := array.get(categoryAccumRootSlots, catPos) == rootSlot
                else if category == CAT_TIME_HL
                    if catPos < array.size(categoryTimeHlRootSlots)
                        catValid := array.get(categoryTimeHlRootSlots, catPos) == rootSlot
                else if category == CAT_FVG
                    if catPos < array.size(categoryFvgRootSlots)
                        catValid := array.get(categoryFvgRootSlots, catPos) == rootSlot
                else if category == CAT_PSYCH
                    if catPos < array.size(categoryPsychRootSlots)
                        catValid := array.get(categoryPsychRootSlots, catPos) == rootSlot
            if tfPos >= 0
                if tfCode == TF_1M
                    if tfPos < array.size(tf1mRootSlots)
                        tfValid := array.get(tf1mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_5M
                    if tfPos < array.size(tf5mRootSlots)
                        tfValid := array.get(tf5mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_15M
                    if tfPos < array.size(tf15mRootSlots)
                        tfValid := array.get(tf15mRootSlots, tfPos) == rootSlot
                else if tfCode == TF_1H
                    if tfPos < array.size(tf1hRootSlots)
                        tfValid := array.get(tf1hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_4H
                    if tfPos < array.size(tf4hRootSlots)
                        tfValid := array.get(tf4hRootSlots, tfPos) == rootSlot
                else if tfCode == TF_D
                    if tfPos < array.size(tfDRootSlots)
                        tfValid := array.get(tfDRootSlots, tfPos) == rootSlot
            if statePos >= 0
                if state == ROOT_CANDIDATE
                    if statePos < array.size(stateCandidateRootSlots)
                        stateValid := array.get(stateCandidateRootSlots, statePos) == rootSlot
                else if state == ROOT_ACTIVE
                    if statePos < array.size(stateActiveRootSlots)
                        stateValid := array.get(stateActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_INVALIDATED
                    if statePos < array.size(stateInvalidatedRootSlots)
                        stateValid := array.get(stateInvalidatedRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_WAIT
                    if statePos < array.size(stateInverseWaitRootSlots)
                        stateValid := array.get(stateInverseWaitRootSlots, statePos) == rootSlot
                else if state == ROOT_INVERSE_ACTIVE
                    if statePos < array.size(stateInverseActiveRootSlots)
                        stateValid := array.get(stateInverseActiveRootSlots, statePos) == rootSlot
                else if state == ROOT_RETIRED
                    if statePos < array.size(stateRetiredRootSlots)
                        stateValid := array.get(stateRetiredRootSlots, statePos) == rootSlot
            valid := catValid and tfValid and stateValid
    valid

// Main journalAppliedBeforeRaw (lines 6073-6076)
journalAppliedBeforeRaw(array<int> journalGroups, int rowA, int rowB) =>
    int groupA = array.get(journalGroups, rowA)
    int groupB = array.get(journalGroups, rowB)
    groupA < groupB or (groupA == groupB and rowA < rowB)

// Main predictedNewRootSlotRaw (lines 6082-6093)
predictedNewRootSlotRaw(array<int> rootIds, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, int journalCount, int newRow) =>
    int slot = SLOT_INVALID
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCount
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        int freeSize = array.size(rootFreeSlots)
        slot := rank < freeSize ? array.get(rootFreeSlots, freeSize - 1 - rank) : array.size(rootIds) + (rank - freeSize)
    slot

// Main predictedNewRootIdRaw (lines 6099-6109)
predictedNewRootIdRaw(array<int> journalOps, array<int> journalGroups, int journalCount, int nextRootId, int newRow) =>
    int rootId = ID_NONE
    if array.get(journalOps, newRow) == JOP_NEW_ROOT
        int rank = 0
        int row  = 0
        while row < journalCount
            if row != newRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, newRow)
                rank += 1
            row += 1
        rootId := nextRootId + rank
    rootId

// Main pendingNewRootRowByAddressRaw (lines 6115-6126)
pendingNewRootRowByAddressRaw(array<int> rootIds, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, int journalCount, int nextRootId, int rootSlot, int expectedRootId, int beforeRow) =>
    int matchRow   = SLOT_INVALID
    int matchCount = 0
    if rootSlot != SLOT_INVALID and expectedRootId != ID_NONE
        int row = 0
        while row < journalCount
            if row != beforeRow and array.get(journalOps, row) == JOP_NEW_ROOT and journalAppliedBeforeRaw(journalGroups, row, beforeRow)
                if predictedNewRootSlotRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCount, row) == rootSlot and predictedNewRootIdRaw(journalOps, journalGroups, journalCount, nextRootId, row) == expectedRootId
                    matchRow   := row
                    matchCount += 1
            row += 1
    [matchRow, matchCount]

// Main pendingNewFvgRowRaw (lines 6131-6144)
pendingNewFvgRowRaw(array<int> journalOps, array<int> journalGroups, array<int> journalCategories, array<int> journalTfCodes, array<int> journalOriginTimes, array<int> journalDirections, int journalCount, int freshRow) =>
    int matchRow   = SLOT_INVALID
    int matchCount = 0
    int tfCode     = array.get(journalTfCodes,     freshRow)
    int direction  = array.get(journalDirections,  freshRow)
    int originTime = array.get(journalOriginTimes, freshRow)
    int row = 0
    while row < journalCount
        if row != freshRow and array.get(journalOps, row) == JOP_NEW_ROOT and array.get(journalCategories, row) == CAT_FVG and journalAppliedBeforeRaw(journalGroups, row, freshRow)
            if array.get(journalTfCodes, row) == tfCode and array.get(journalDirections, row) == direction and array.get(journalOriginTimes, row) == originTime
                matchRow   := row
                matchCount += 1
        row += 1
    [matchRow, matchCount]

// Main virtualRootStateBeforeRaw (lines 6151-6176)
virtualRootStateBeforeRaw(array<int> rootIds, array<int> rootStates, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalNewStates, int journalCount, int nextRootId, int rootSlot, int expectedRootId, int beforeRow) =>
    int  state    = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootStates)
        if array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
            state    := array.get(rootStates, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCount, nextRootId, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            state    := array.get(journalNewStates, newRow)
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < journalCount
                if row != beforeRow and array.get(journalGroups, row) == group and journalAppliedBeforeRaw(journalGroups, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(journalGroups, baseRow, row)) and array.get(journalTargetRootSlots, row) == rootSlot and array.get(journalExpectedRootIds, row) == expectedRootId
                    int op = array.get(journalOps, row)
                    if op == JOP_FVG_INVALIDATE or op == JOP_ROOT_RETIRE
                        state := array.get(journalNewStates, row)
                row += 1
            group += 1
    state

// Main virtualSwingTfMaskBeforeRaw (lines 6182-6206)
virtualSwingTfMaskBeforeRaw(array<int> rootIds, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalNewMasks, array<int> rootSwingTfMasks, int journalCount, int nextRootId, int rootSlot, int expectedRootId, int beforeRow) =>
    int  mask     = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootSwingTfMasks)
        if array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
            mask     := array.get(rootSwingTfMasks, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCount, nextRootId, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            mask     := array.get(journalCategories, newRow) == CAT_SWING ? array.get(journalNewMasks, newRow) : SWING_TF_MASK_NONE
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < journalCount
                if row != beforeRow and array.get(journalGroups, row) == group and journalAppliedBeforeRaw(journalGroups, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(journalGroups, baseRow, row)) and array.get(journalTargetRootSlots, row) == rootSlot and array.get(journalExpectedRootIds, row) == expectedRootId
                    if array.get(journalOps, row) == JOP_SWING_TF_MERGE
                        mask := array.get(journalNewMasks, row)
                row += 1
            group += 1
    mask

// Main virtualTimeHlLabelMaskBeforeRaw (lines 6212-6236)
virtualTimeHlLabelMaskBeforeRaw(array<int> rootIds, array<int> rootLabelMasks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalNewMasks, int journalCount, int nextRootId, int rootSlot, int expectedRootId, int beforeRow) =>
    int  mask     = int(na)
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootLabelMasks)
        if array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
            mask     := array.get(rootLabelMasks, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCount, nextRootId, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            mask     := array.get(journalCategories, newRow) == CAT_TIME_HL ? array.get(journalNewMasks, newRow) : 0
            baseRow  := newRow
            resolved := true
    if resolved
        int group = JGROUP_E1
        while group <= JGROUP_E4
            int row = 0
            while row < journalCount
                if row != beforeRow and array.get(journalGroups, row) == group and journalAppliedBeforeRaw(journalGroups, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(journalGroups, baseRow, row)) and array.get(journalTargetRootSlots, row) == rootSlot and array.get(journalExpectedRootIds, row) == expectedRootId
                    if array.get(journalOps, row) == JOP_TIMEHL_LABEL
                        mask := array.get(journalNewMasks, row)
                row += 1
            group += 1
    mask

// Main virtualFvgFreshBeforeRaw (lines 6243-6263)
virtualFvgFreshBeforeRaw(array<int> rootIds, array<bool> rootFvgFreshFlags, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<bool> journalFvgFreshFlags, int journalCount, int nextRootId, int rootSlot, int expectedRootId, int beforeRow) =>
    bool fresh    = false
    int  baseRow  = SLOT_INVALID
    bool resolved = false
    if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootFvgFreshFlags)
        if array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
            fresh    := array.get(rootFvgFreshFlags, rootSlot)
            resolved := true
    if not resolved
        [newRow, newCount] = pendingNewRootRowByAddressRaw(rootIds, rootFreeSlots, journalOps, journalGroups, journalCount, nextRootId, rootSlot, expectedRootId, beforeRow)
        if newCount == 1
            fresh    := array.get(journalCategories, newRow) == CAT_FVG ? array.get(journalFvgFreshFlags, newRow) : false
            baseRow  := newRow
            resolved := true
    if resolved
        int row = 0
        while row < journalCount
            if row != beforeRow and journalAppliedBeforeRaw(journalGroups, row, beforeRow) and (baseRow == SLOT_INVALID or journalAppliedBeforeRaw(journalGroups, baseRow, row)) and array.get(journalOps, row) == JOP_FVG_FRESH_END and array.get(journalTargetRootSlots, row) == rootSlot and array.get(journalExpectedRootIds, row) == expectedRootId
                fresh := false
            row += 1
    [fresh, resolved]

// Main virtualPointOrderPreflightRaw (lines 6280-6761)
virtualPointOrderPreflightRaw(array<int> rootIds, array<bool> rootIsRangeRootFlags, array<int> rootPointTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<float> journalPointPrices, int journalCount, int nextRootId, int row, float mintick) =>
    int  count     = journalCount
    int  op        = array.get(journalOps, row)
    int  orderSize = array.size(rootPriceOrderSlots)
    bool ok        = not na(mintick) and mintick > 0 and ((op == JOP_NEW_ROOT and array.get(journalCategories, row) != CAT_FVG) or op == JOP_MA_UPDATE) and not na(array.get(journalPointPrices, row))
    int  newTick   = int(na)
    if ok
        newTick := int(math.round(array.get(journalPointPrices, row) / mintick))
        ok      := not na(newTick)
    int virtualSize = orderSize
    if ok
        int j = 0
        while j < count
            if j != row and array.get(journalOps, j) == JOP_NEW_ROOT and array.get(journalCategories, j) != CAT_FVG and journalAppliedBeforeRaw(journalGroups, j, row)
                virtualSize += 1
            j += 1
    int newUpperC = SLOT_INVALID
    if ok
        [ubPos, ubOk] = rootPriceOrderUpperBoundRaw(rootIds, rootIsRangeRootFlags, rootPointTicks, rootSlotLiveFlags, rootPriceOrderSlots, rootPriceOrderPositions, newTick)
        ok        := ubOk
        newUpperC := ubPos
    int  rootSlot       = SLOT_INVALID
    int  expectedRootId = ID_NONE
    bool eCommitted     = false
    int  eCpos          = SLOT_INVALID
    int  eNewRow        = SLOT_INVALID
    int  oldTick        = int(na)
    int  oldPlace       = SLOT_INVALID
    int  eCommittedTick = int(na)
    if ok and op == JOP_MA_UPDATE
        rootSlot       := array.get(journalTargetRootSlots, row)
        expectedRootId := array.get(journalExpectedRootIds, row)
        if rootSlot >= 0 and rootSlot < array.size(rootIds) and rootSlot < array.size(rootSlotLiveFlags) and rootSlot < array.size(rootPointTicks) and rootSlot < array.size(rootIsRangeRootFlags) and rootSlot < array.size(rootPriceOrderPositions)
            if array.get(rootSlotLiveFlags, rootSlot) and expectedRootId != ID_NONE and array.get(rootIds, rootSlot) == expectedRootId
                eCommitted := true

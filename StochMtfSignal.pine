// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  Stoch MTF Signal (1M)  —  ストキャス・マルチタイム判定の単体インジ (SMT-5)
//  1分足の通常ローソク足チャート専用。エントリー候補の合図を矢印で表示するだけ。
//  注文・SL / TP・成績集計・アラートは無い。既存の Zone Lab / Zone Combo Lab / Strategy とは独立。
//
//  ストキャス (全時間足共通・MT5 Stochastic Oscillator の計算手順):
//    LL[i] = 直近 %K期間 本の Low の最小、HH[i] = 直近 %K期間 本の High の最大 (価格フィールド Low/High)
//    Main[i]   = Σ(Close[k] − LL[k]) / Σ(HH[k] − LL[k]) × 100   (k = i−スローイング+1 .. i、分母 0 なら 100)
//                ← スローイングは「速い %K の SMA」ではなく、分子・分母それぞれの合計の比
//    Signal[i] = (Main[i] + Main[i−1] + … + Main[i−%D期間+1]) / %D期間   (Simple)
//    有効: Main は i >= %K期間+スローイング−2、Signal は i >= %K期間+スローイング+%D期間−3 (MT5 の初期化用 0 は使わない)。
//
//  5分・15分足 (SMT-4): 確定した 1分足から再現する (request.security は使わない)。
//    ・区切りは time("5") / time("15") (銘柄の実際のバー境界)。1分足が確定するたびに、同じ区間の上位足 1本を更新する:
//      Open = 区間最初の 1分足の始値、High / Low = その時点までの最大 / 最小、Close = 今回確定した 1分足の終値。
//    ・区間が完成したら (1分足の time_close >= 区間の time_close、または次の区間の最初の 1分足が来たとき) 履歴へ一度だけ登録する。
//      区間最後の 1分足の判定には、その完成した上位足を使う (二重計上しない)。存在しない 1分足は補間しない。
//    ・読込開始時に区間の途中から始まった最初の区間は履歴に採用しない。
//    ・計算系列 = 確定済み上位足の履歴 + 現在の上位足 1本。%K期間・スローイングは上位足の本数で数える。
//      確定済み上位足の LL / HH / K は、その足の完成時の値を保存して使う。
//    ・K0 = 今回の 1分足確定時点までの現在の上位足の K、K1 / K2 = その 1本前 / 2本前の確定済み上位足の K。
//      Δ0 = K0 − K1、Δ1 = K1 − K2 (その時間足自身の前の足と比較)。
//    ・更新は 1分足の確定実行 (barstate.isconfirmed) だけ。各時点までの 1分足だけを使うので、後で完成した上位足の最終値が
//      区間途中の過去判定に入らない。
//
//  5分足: 「5分足：50条件を使う」(初期 ON) と「5分足の方向判定」(方向のみ / 方向または減速、初期 方向または減速)。
//    方向のみ: S Δ0 < 0 / L Δ0 > 0。方向または減速: S Δ0 < 0 or 0 < Δ0 < Δ1 / L Δ0 > 0 or Δ1 < Δ0 < 0。Δ0 = 0 は不成立。
//  15分足 (SMT-5: 「15分足条件を使う」初期 ON、「15分足：50条件を使う」初期 ON):
//    S (50条件 ON なら K0 > 50) かつ (Δ0 < 0 or 0 < Δ0 < Δ1) / L (50条件 ON なら K0 < 50) かつ (Δ0 > 0 or Δ1 < Δ0 < 0)。
//    15分足条件 OFF なら 15分足 (データ不足を含む) を判定に使わない。
//  1時間・4時間の見送りフィルタ (SMT-5、初期 ON): 1時間・4時間足も確定した 1分足から同じ方法で再現し、現在の足の K (速い線) を使う。
//    ロング: 1時間 K >= 上側レベル かつ 4時間 K >= 上側レベル なら見送り。ショート: 両方 <= 下側レベル なら見送り。
//    どちらかの K が計算できなければ「上位足データ不足」で合図なし。OFF なら 1時間・4時間は判定に使わない。
//  選んだ条件に必要な値が無ければ不成立。
//
//  判定: 1分足の確定時 (barstate.isconfirmed) に 1回だけ。クロスの保存・到達履歴の消費・クールダウンは無い。
// ============================================================================

//@version=5
indicator("Stoch MTF Signal (1M)", shorttitle = "STO-MTF", overlay = true, max_bars_back = 1000,
     max_labels_count = 500)

// ==== 入力 ===================================================================
G_STO = "ストキャス (1・5・15分共通)"
G_LV  = "判定"
G_DBG = "検証"
iKPer   = input.int(21, "%K期間",        minval = 1, maxval = 500, group = G_STO)
iDPer   = input.int(3,  "%D期間",        minval = 1, maxval = 100, group = G_STO)
iSlow   = input.int(3,  "スローイング",  minval = 1, maxval = 100, group = G_STO)
iUpLv   = input.float(90.0, "上側到達レベル", group = G_LV)
iLoLv   = input.float(10.0, "下側到達レベル", group = G_LV)
iReachN = input.int(10, "到達確認本数 (クロス足を含む)", minval = 1, maxval = 500, group = G_LV)
iMinMv  = input.float(3.0, "1分足クロス足の最低変化幅 (ポイント)", minval = 0.0, group = G_LV,
     tooltip = "1分足だけに適用。5分・15分には使わない。")
G_5M = "5分足"
M5_DIR   = "方向のみ"
M5_DECEL = "方向または減速"
i5Mid   = input.bool(true, "5分足：50条件を使う", group = G_5M,
     tooltip = "ON: ショートは K0 > 50、ロングは K0 < 50 (50 ちょうどは除外)。OFF: K0 の位置 (50 の上・下・ちょうど) を問わない。")
i5Mode  = input.string(M5_DECEL, "5分足の方向判定", options = [M5_DIR, M5_DECEL], group = G_5M,
     tooltip = "Δ0 = K0 − K1、Δ1 = K1 − K2 (5分足自身の前の足と比較)。方向のみ: ショート Δ0 < 0 / ロング Δ0 > 0。" +
     "方向または減速: ショート Δ0 < 0 または 0 < Δ0 < Δ1 / ロング Δ0 > 0 または Δ1 < Δ0 < 0。Δ0 = 0 はどちらも不成立。")
G_15M = "15分足"
i15Use  = input.bool(true, "15分足条件を使う", group = G_15M,
     tooltip = "OFF: 15分足の 50条件・方向・減速条件をすべて判定から外す (15分足のデータ不足でも合図を止めない)。")
i15Mid  = input.bool(true, "15分足：50条件を使う", group = G_15M,
     tooltip = "ON: ショートは K0 > 50、ロングは K0 < 50 (50 ちょうどは除外)。OFF: 50 による制限なし (方向・減速条件は適用)。" +
     "15分足条件が OFF なら使わない。")
G_HF = "1時間・4時間の見送りフィルタ"
iHfUse  = input.bool(true, "1時間・4時間の見送りフィルタを使う", group = G_HF,
     tooltip = "ロング: 1時間 K と 4時間 K がともに上側レベル以上なら見送り。ショート: ともに下側レベル以下なら見送り。" +
     "どちらかの K が計算できなければ合図なし (上位足データ不足)。")
iHfUp   = input.float(90.0, "ロング見送り上側レベル", group = G_HF)
iHfLo   = input.float(10.0, "ショート見送り下側レベル", group = G_HF)
iDebug  = input.bool(false, "検証表示", group = G_DBG,
     tooltip = "ON: 全クロスに判定ラベル、右上に最新状態の表、データウィンドウに判定値。判定結果は変わらない。")

// 固定 (今回の仕様)
float MID   = 50.0
string TF5  = "5"
string TF15 = "15"
string TF60 = "60"
string TF240 = "240"

// ==== SMT Logic (begin) ======================================================
// MT5 Stochastic Oscillator (Low/High・Simple)。チャート (1分足) の系列用。戻り値 [Main, Signal]。データ不足の間は na。
f_mtStoch(int kPer, int dPer, int slow) =>
    float ll = ta.lowest(low, kPer)
    float hh = ta.highest(high, kPer)
    float mainV = na
    if bar_index >= kPer + slow - 2
        float sLow  = 0.0
        float sHigh = 0.0
        for j = slow - 1 to 0                       // MT5: k = i−slow+1 .. i (同じ加算順)
            sLow  += close[j] - ll[j]
            sHigh += hh[j] - ll[j]
        mainV := sHigh == 0.0 ? 100.0 : sLow / sHigh * 100
    float sigV = na
    if bar_index >= kPer + slow + dPer - 3
        float s = 0.0
        for j = 0 to dPer - 1                       // MT5: sum += Main[i−k], k = 0 .. dPer−1
            s += mainV[j]
        sigV := s / dPer
    [mainV, sigV]

// ---- 1分足から再現する上位足 ----
// 確定済み上位足の履歴 (古い順、直近 cap 本) と現在の上位足 1本。
type HtfAgg
    array<float> hi          // 確定済み上位足の High
    array<float> lo          // 確定済み上位足の Low
    array<float> cl          // 確定済み上位足の Close
    array<float> ll          // 確定済み上位足の LL (完成時の値)
    array<float> hh          // 確定済み上位足の HH (完成時の値)
    array<float> mk          // 確定済み上位足の K  (完成時の値)
    int   nDone              // 採用した確定済み上位足の本数 (= 現在の上位足の通し番号)
    bool  started            // 1本目の区間を始めたか
    int   curOpen            // 現在の上位足の開始時刻 (time(tf))
    int   curClose           // 現在の上位足の終了予定時刻 (time_close(tf))
    float cO
    float cH
    float cL
    float cC
    bool  curValid           // 現在の区間を採用するか (読込開始時に途中から始まった最初の区間は false)
    bool  curFinal           // 現在の区間を登録済みか

f_newAgg() =>
    HtfAgg.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), 0, false, na, na, na, na, na, na, false, false)

// 現在の上位足 (High h / Low l / Close c) の [K, LL, HH]。系列 = 確定済み履歴 + 現在の 1本 (MT5 と同じ式・加算順)。
f_curMain(HtfAgg a, int kPer, int slow, float h, float l, float c) =>
    int n  = a.nDone
    int sz = array.size(a.hi)
    float llv = na
    float hhv = na
    float mainv = na
    if n >= kPer - 1
        llv := l
        hhv := h
        if kPer > 1
            for j = 1 to kPer - 1
                llv := math.min(llv, array.get(a.lo, sz - j))
                hhv := math.max(hhv, array.get(a.hi, sz - j))
    if n >= kPer + slow - 2
        float sL = 0.0
        float sH = 0.0
        if slow > 1
            for j = slow - 1 to 1                    // 古い足から (MT5: k = i−slow+1 .. i)
                sL += array.get(a.cl, sz - j) - array.get(a.ll, sz - j)
                sH += array.get(a.hh, sz - j) - array.get(a.ll, sz - j)
        sL += c - llv
        sH += hhv - llv
        mainv := sH == 0.0 ? 100.0 : sL / sH * 100
    [mainv, llv, hhv]

// 現在の上位足を確定済み履歴へ一度だけ登録する
f_push(HtfAgg a, int cap, float m, float llv, float hhv) =>
    array.push(a.hi, a.cH)
    array.push(a.lo, a.cL)
    array.push(a.cl, a.cC)
    array.push(a.ll, llv)
    array.push(a.hh, hhv)
    array.push(a.mk, m)
    if array.size(a.hi) > cap
        array.shift(a.hi)
        array.shift(a.lo)
        array.shift(a.cl)
        array.shift(a.ll)
        array.shift(a.hh)
        array.shift(a.mk)
    a.nDone := a.nDone + 1
    a.curFinal := true
    true

// 確定した 1分足 1本で上位足を進める。戻り値 [K0, K1, K2, 今回完成したか, 現在の区間を採用しているか]
f_step(HtfAgg a, int tfOpen, int tfClose, int kPer, int slow, int cap) =>
    float k0 = na
    float k1 = na
    float k2 = na
    bool closedNow = false
    if not na(tfOpen)
        if not a.started or tfOpen != a.curOpen
            // 前の区間が最後の 1分足なしで終わっていた場合: その時点までの値で一度だけ登録
            if a.started and a.curValid and not a.curFinal
                [pm, pl, ph] = f_curMain(a, kPer, slow, a.cH, a.cL, a.cC)
                f_push(a, cap, pm, pl, ph)
            a.curValid := a.started or time == tfOpen      // 読込開始時の不完全な区間は採用しない
            a.started  := true
            a.curOpen  := tfOpen
            a.curClose := tfClose
            a.cO := open
            a.cH := high
            a.cL := low
            a.cC := close
            a.curFinal := false
        else
            a.curClose := tfClose
            a.cH := math.max(a.cH, high)
            a.cL := math.min(a.cL, low)
            a.cC := close
        int sz = array.size(a.mk)
        k1 := sz >= 1 ? array.get(a.mk, sz - 1) : na
        k2 := sz >= 2 ? array.get(a.mk, sz - 2) : na
        closedNow := not na(tfClose) and time_close >= tfClose
        if a.curValid
            [cm, cl0, ch0] = f_curMain(a, kPer, slow, a.cH, a.cL, a.cC)
            k0 := cm
            if closedNow and not a.curFinal
                f_push(a, cap, cm, cl0, ch0)               // 区間最後の 1分足: 完成した上位足を登録 (この判定の K0 も同じ足)
        else if closedNow
            a.curFinal := true                              // 不採用の区間は登録しない
    [k0, k1, k2, closedNow, a.curValid]

// 1分足
[k1m, d1m] = f_mtStoch(iKPer, iDPer, iSlow)

// 上位足の境界 (銘柄の実際のバー境界)
int t5o  = time(TF5)
int t5c  = time_close(TF5)
int t15o = time(TF15)
int t15c = time_close(TF15)
int t60o  = time(TF60)
int t60c  = time_close(TF60)
int t240o = time(TF240)
int t240c = time_close(TF240)
int HCAP = math.max(iKPer, iSlow) + 3

var HtfAgg agg5  = f_newAgg()
var HtfAgg agg15 = f_newAgg()
var HtfAgg agg60  = f_newAgg()
var HtfAgg agg240 = f_newAgg()

// 1分足の確定実行でだけ更新 (リアルタイムの途中 tick では前の確定時点の値のまま)
var float k5_0  = na
var float k5_1  = na
var float k5_2  = na
var bool  c5Now = false
var bool  v5    = false
var float k15_0 = na
var float k15_1 = na
var float k15_2 = na
var bool  c15Now = false
var bool  v15   = false
var float k60_0  = na
var float k240_0 = na
var float tEval = na
var float s5Open  = na
var float s5Close = na
var float s15Open  = na
var float s15Close = na
if barstate.isconfirmed
    [a0, a1, a2, ac, av] = f_step(agg5, t5o, t5c, iKPer, iSlow, HCAP)
    k5_0 := a0
    k5_1 := a1
    k5_2 := a2
    c5Now := ac
    v5 := av
    [b0, b1, b2, bc, bv] = f_step(agg15, t15o, t15c, iKPer, iSlow, HCAP)
    k15_0 := b0
    k15_1 := b1
    k15_2 := b2
    c15Now := bc
    v15 := bv
    [h0, h1, h2, hc, hv] = f_step(agg60, t60o, t60c, iKPer, iSlow, HCAP)
    k60_0 := h0
    [g0, g1, g2, gc, gv] = f_step(agg240, t240o, t240c, iKPer, iSlow, HCAP)
    k240_0 := g0
    tEval := time_close
    s5Open  := agg5.curOpen
    s5Close := agg5.curClose
    s15Open  := agg15.curOpen
    s15Close := agg15.curClose

// 対象チャート: 1分足の通常ローソク足
bool chartOK = timeframe.isminutes and timeframe.multiplier == 1 and chart.is_standard

// ---- 1分足 ----
bool d1Ok = not na(k1m) and not na(k1m[1]) and not na(d1m) and not na(d1m[1])
float k1Max = na
float k1Min = na
bool winOk = true
for j = 0 to iReachN - 1
    float v = k1m[j]
    if na(v)
        winOk := false
        break
    k1Max := na(k1Max) ? v : math.max(k1Max, v)
    k1Min := na(k1Min) ? v : math.min(k1Min, v)
bool data1 = d1Ok and winOk
float k1Chg = k1m - k1m[1]

bool sCross1 = data1 and k1m[1] >= d1m[1] and k1m < d1m
bool lCross1 = data1 and k1m[1] <= d1m[1] and k1m > d1m
bool sMove1  = data1 and -k1Chg >= iMinMv
bool lMove1  = data1 and k1Chg >= iMinMv
bool sReach1 = data1 and k1Max >= iUpLv
bool lReach1 = data1 and k1Min <= iLoLv

// ---- 5分足 (K0 = 現在の 5分足、K1 / K2 = 1本前 / 2本前の確定済み 5分足) ----
bool m5Decel = i5Mode == M5_DECEL
bool data5 = not na(k5_0) and not na(k5_1) and (not m5Decel or not na(k5_2))
float dl5_0 = k5_0 - k5_1
float dl5_1 = k5_1 - k5_2
bool s5Mid = not i5Mid or k5_0 > MID
bool l5Mid = not i5Mid or k5_0 < MID
bool s5Dir = m5Decel ? (dl5_0 < 0 or (0 < dl5_0 and dl5_0 < dl5_1)) : dl5_0 < 0
bool l5Dir = m5Decel ? (dl5_0 > 0 or (dl5_1 < dl5_0 and dl5_0 < 0)) : dl5_0 > 0
bool s5 = data5 and s5Mid and s5Dir
bool l5 = data5 and l5Mid and l5Dir

// ---- 15分足 (K0 = 現在の 15分足、K1 / K2 = 1本前 / 2本前の確定済み 15分足) ----
bool data15 = not na(k15_0) and not na(k15_1) and not na(k15_2)
float dl0 = k15_0 - k15_1
float dl1 = k15_1 - k15_2
bool s15Mid = not i15Mid or k15_0 > MID
bool l15Mid = not i15Mid or k15_0 < MID
bool s15Dir = dl0 < 0 or (0 < dl0 and dl0 < dl1)
bool l15Dir = dl0 > 0 or (dl1 < dl0 and dl0 < 0)
bool s15 = data15 and s15Mid and s15Dir
bool l15 = data15 and l15Mid and l15Dir
bool s15Ok = not i15Use or s15               // 15分足条件 OFF: 判定に使わない
bool l15Ok = not i15Use or l15

// ---- 1時間・4時間の見送りフィルタ (現在の 1時間足・4時間足の K) ----
bool dataHf = not na(k60_0) and not na(k240_0)
bool lSkipHf = dataHf and k60_0 >= iHfUp and k240_0 >= iHfUp
bool sSkipHf = dataHf and k60_0 <= iHfLo and k240_0 <= iHfLo
bool lHfOk = not iHfUse or (dataHf and not lSkipHf)
bool sHfOk = not iHfUse or (dataHf and not sSkipHf)

// ---- 成立 (1分足の確定時に 1回だけ。状態は持たない) ----
bool evalNow  = chartOK and barstate.isconfirmed
bool dataAll  = data1 and data5 and (not i15Use or data15) and (not iHfUse or dataHf)
bool shortSig = evalNow and dataAll and sCross1 and sMove1 and sReach1 and s5 and s15Ok and sHfOk
bool longSig  = evalNow and dataAll and lCross1 and lMove1 and lReach1 and l5 and l15Ok and lHfOk
// ==== SMT Logic (end) ========================================================

// ==== 通常表示 ===============================================================
plotshape(shortSig, "ショート", shape.arrowdown, location.abovebar, color.new(color.red, 0),  size = size.normal)
plotshape(longSig,  "ロング",   shape.arrowup,   location.belowbar, color.new(color.teal, 0), size = size.normal)

if barstate.islast and not chartOK
    var label offLbl = na
    label.delete(offLbl)
    offLbl := label.new(bar_index, high, "STO-MTF: 1分足の通常ローソク足チャート専用。この時間足・チャート種別では合図を停止中。",
         style = label.style_label_down, color = color.new(color.gray, 0), textcolor = color.white)

// ==== 検証表示 ===============================================================
f_ox(bool b) => b ? "○" : "×"
f_t(float t) => na(t) ? "na" : str.format_time(int(t), "yyyy-MM-dd HH:mm", syminfo.timezone)
f_n(float x) => na(x) ? "na" : str.tostring(x, "#.##")
// 上位足の状態: 今回完成 / 形成中 / 不採用 (読込開始時の不完全な区間)
f_st(bool valid, bool closedNow) => not valid ? "不採用 (読込開始の不完全区間)" : closedNow ? "今回完成 (確定)" : "形成中"
// 判定コード: 桁 = [データ][クロス][変化幅][到達][5分][15分][1H4H]、1 = 成立 (OFF の条件も 1) / 0 = 不成立 (データ桁 0 = 不足)
f_code(bool d, bool c, bool m, bool r, bool h5, bool h15, bool hf) =>
    (d ? 1000000 : 0) + (c ? 100000 : 0) + (m ? 10000 : 0) + (r ? 1000 : 0) + (h5 ? 100 : 0) + (h15 ? 10 : 0) + (hf ? 1 : 0)
f_onf(bool use, bool b) => use ? f_ox(b) : "OFF"
f_ymdhm(float t) =>
    float r = na
    if not na(t)
        int ti = int(t)
        r := year(ti, syminfo.timezone) * 100000000.0 + month(ti, syminfo.timezone) * 1000000.0 +
             dayofmonth(ti, syminfo.timezone) * 10000.0 + hour(ti, syminfo.timezone) * 100.0 + minute(ti, syminfo.timezone)
    r

string reasonS = (not data1 ? " 1分データ不足" : "") + (not data5 ? " 5分データ不足" : "") +
     (i15Use and not data15 ? " 15分データ不足" : "") + (iHfUse and not dataHf ? " 上位足データ不足" : "") +
     (data1 and not sMove1 ? " 変化幅" : "") + (data1 and not sReach1 ? " 到達" : "") +
     (data5 and not s5Mid ? " 5分(50)" : "") + (data5 and not s5Dir ? " 5分(" + i5Mode + ")" : "") +
     (i15Use and data15 and not s15Mid ? " 15分(50)" : "") + (i15Use and data15 and not s15Dir ? " 15分(方向・減速)" : "") +
     (iHfUse and sSkipHf ? " 1H・4H見送り" : "")
string reasonL = (not data1 ? " 1分データ不足" : "") + (not data5 ? " 5分データ不足" : "") +
     (i15Use and not data15 ? " 15分データ不足" : "") + (iHfUse and not dataHf ? " 上位足データ不足" : "") +
     (data1 and not lMove1 ? " 変化幅" : "") + (data1 and not lReach1 ? " 到達" : "") +
     (data5 and not l5Mid ? " 5分(50)" : "") + (data5 and not l5Dir ? " 5分(" + i5Mode + ")" : "") +
     (i15Use and data15 and not l15Mid ? " 15分(50)" : "") + (i15Use and data15 and not l15Dir ? " 15分(方向・減速)" : "") +
     (iHfUse and lSkipHf ? " 1H・4H見送り" : "")
string set15 = "15分設定: 15分足条件 " + (i15Use ? "ON" : "OFF") + " / 50条件 " + (i15Use ? (i15Mid ? "ON" : "OFF") : "OFF (15分足条件 OFF)")
string setHf = "1H・4H見送りフィルタ " + (iHfUse ? "ON (ロング ≧" + f_n(iHfUp) + " / ショート ≦" + f_n(iHfLo) + ")" : "OFF")
string hfLine = "1時間 K " + f_n(k60_0) + " / 4時間 K " + f_n(k240_0) +
     (iHfUse ? (dataHf ? " / ロング見送り " + (lSkipHf ? "該当" : "非該当") + " / ショート見送り " + (sSkipHf ? "該当" : "非該当") : " / 上位足データ不足") : " / OFF")
string set5 = "5分設定: 50条件 " + (i5Mid ? "ON" : "OFF") + " / " + i5Mode

string detail = "K1 " + f_n(k1m) + " / D1 " + f_n(d1m) + " / 前K1 " + f_n(k1m[1]) + " / 前D1 " + f_n(d1m[1]) +
     "\n変化 " + f_n(k1Chg) + " / 直近" + str.tostring(iReachN) + "本 最大 " + f_n(k1Max) + " 最小 " + f_n(k1Min) +
     "\n5分 K0 " + f_n(k5_0) + " / K1 " + f_n(k5_1) + " / K2 " + f_n(k5_2) + " / Δ0 " + f_n(dl5_0) + " / Δ1 " + f_n(dl5_1) +
     "\n5分足 " + f_t(s5Open) + " 〜 " + f_t(s5Close) + " " + f_st(v5, c5Now) +
     "\n" + set5 +
     "\n15分 K0 " + f_n(k15_0) + " / K1 " + f_n(k15_1) + " / K2 " + f_n(k15_2) + " / Δ0 " + f_n(dl0) + " / Δ1 " + f_n(dl1) +
     "\n15分足 " + f_t(s15Open) + " 〜 " + f_t(s15Close) + " " + f_st(v15, c15Now) +
     "\n" + set15 +
     "\n" + setHf +
     "\n" + hfLine +
     "\n判定時刻 " + f_t(tEval)

if iDebug and evalNow
    bool sx = k1m[1] >= d1m[1] and k1m < d1m        // 検証ラベル用 (判定には使わない)
    bool lx = k1m[1] <= d1m[1] and k1m > d1m
    if sx
        string txtS = "S " + (shortSig ? "成立" : "見送り") + "\n1分" + f_ox(sMove1 and sReach1) + " 5分" + f_ox(s5) + " 15分" + f_onf(i15Use, s15) + " 1H4H" + f_onf(iHfUse, sHfOk)
        string tipS = "ショート " + (shortSig ? "成立" : "不成立:" + reasonS) +
             "\nクロス" + f_ox(sCross1) + " 変化幅" + f_ox(sMove1) + " 到達" + f_ox(sReach1) + " 5分" + f_ox(s5) + " 15分" + f_onf(i15Use, s15) + " 1H4H" + f_onf(iHfUse, sHfOk) + "\n" + detail
        label.new(bar_index, high, txtS, style = label.style_label_down, size = size.tiny, tooltip = tipS,
             color = shortSig ? color.new(color.red, 20) : color.new(color.gray, 60), textcolor = color.white)
    if lx
        string txtL = "L " + (longSig ? "成立" : "見送り") + "\n1分" + f_ox(lMove1 and lReach1) + " 5分" + f_ox(l5) + " 15分" + f_onf(i15Use, l15) + " 1H4H" + f_onf(iHfUse, lHfOk)
        string tipL = "ロング " + (longSig ? "成立" : "不成立:" + reasonL) +
             "\nクロス" + f_ox(lCross1) + " 変化幅" + f_ox(lMove1) + " 到達" + f_ox(lReach1) + " 5分" + f_ox(l5) + " 15分" + f_onf(i15Use, l15) + " 1H4H" + f_onf(iHfUse, lHfOk) + "\n" + detail
        label.new(bar_index, low, txtL, style = label.style_label_up, size = size.tiny, tooltip = tipL,
             color = longSig ? color.new(color.teal, 20) : color.new(color.gray, 60), textcolor = color.white)

var table dbg = table.new(position.top_right, 3, 20, bgcolor = color.new(color.black, 20), border_width = 1)
if iDebug and barstate.islast
    table.cell(dbg, 0, 0, "STO-MTF", text_color = color.white)
    table.cell(dbg, 1, 0, "ショート", text_color = color.white)
    table.cell(dbg, 2, 0, "ロング", text_color = color.white)
    table.cell(dbg, 0, 1, "チャート", text_color = color.white)
    table.cell(dbg, 1, 1, chartOK ? "1分 通常" : "対象外 (停止)", text_color = color.white)
    table.cell(dbg, 2, 1, barstate.isconfirmed ? "確定足" : "形成中 (判定なし・前の確定時点の値)", text_color = color.white)
    table.cell(dbg, 0, 2, "1分 K / D", text_color = color.white)
    table.cell(dbg, 1, 2, f_n(k1m) + " / " + f_n(d1m), text_color = color.white)
    table.cell(dbg, 2, 2, "変化 " + f_n(k1Chg), text_color = color.white)
    table.cell(dbg, 0, 3, "1分 クロス", text_color = color.white)
    table.cell(dbg, 1, 3, f_ox(sCross1), text_color = color.white)
    table.cell(dbg, 2, 3, f_ox(lCross1), text_color = color.white)
    table.cell(dbg, 0, 4, "1分 変化幅", text_color = color.white)
    table.cell(dbg, 1, 4, f_ox(sMove1), text_color = color.white)
    table.cell(dbg, 2, 4, f_ox(lMove1), text_color = color.white)
    table.cell(dbg, 0, 5, "1分 到達", text_color = color.white)
    table.cell(dbg, 1, 5, f_ox(sReach1) + " 最大 " + f_n(k1Max), text_color = color.white)
    table.cell(dbg, 2, 5, f_ox(lReach1) + " 最小 " + f_n(k1Min), text_color = color.white)
    table.cell(dbg, 0, 6, "5分 K0 / K1 / K2", text_color = color.white)
    table.cell(dbg, 1, 6, f_n(k5_0) + " / " + f_n(k5_1) + " / " + f_n(k5_2), text_color = color.white)
    table.cell(dbg, 2, 6, "Δ0 " + f_n(dl5_0) + " / Δ1 " + f_n(dl5_1), text_color = color.white)
    table.cell(dbg, 0, 7, "5分 設定", text_color = color.white)
    table.cell(dbg, 1, 7, "50条件 " + (i5Mid ? "ON" : "OFF") + " / " + i5Mode, text_color = color.white)
    table.cell(dbg, 0, 8, "5分 50 / 方向 / 判定", text_color = color.white)
    table.cell(dbg, 1, 8, (i5Mid ? f_ox(s5Mid) : "-") + " / " + f_ox(s5Dir) + " / " + f_ox(s5), text_color = color.white)
    table.cell(dbg, 2, 8, (i5Mid ? f_ox(l5Mid) : "-") + " / " + f_ox(l5Dir) + " / " + f_ox(l5), text_color = color.white)
    table.cell(dbg, 0, 9, "5分足 区間", text_color = color.white)
    table.cell(dbg, 1, 9, f_t(s5Open) + " 〜 " + f_t(s5Close), text_color = color.white)
    table.cell(dbg, 2, 9, f_st(v5, c5Now), text_color = color.white)
    table.cell(dbg, 0, 10, "15分 K0 / K1 / K2", text_color = color.white)
    table.cell(dbg, 1, 10, f_n(k15_0) + " / " + f_n(k15_1) + " / " + f_n(k15_2), text_color = color.white)
    table.cell(dbg, 2, 10, "Δ0 " + f_n(dl0) + " / Δ1 " + f_n(dl1), text_color = color.white)
    table.cell(dbg, 0, 11, "15分 50 / 方向 / 判定", text_color = color.white)
    table.cell(dbg, 1, 11, i15Use ? (i15Mid ? f_ox(s15Mid) : "OFF") + " / " + f_ox(s15Dir) + " / " + f_ox(s15) : "OFF", text_color = color.white)
    table.cell(dbg, 2, 11, i15Use ? (i15Mid ? f_ox(l15Mid) : "OFF") + " / " + f_ox(l15Dir) + " / " + f_ox(l15) : "OFF", text_color = color.white)
    table.cell(dbg, 0, 15, "15分 設定", text_color = color.white)
    table.cell(dbg, 1, 15, "15分足条件 " + (i15Use ? "ON" : "OFF") + " / 50条件 " + (i15Use and i15Mid ? "ON" : "OFF"), text_color = color.white)
    table.cell(dbg, 0, 16, "1H・4H 見送り", text_color = color.white)
    table.cell(dbg, 1, 16, iHfUse ? (dataHf ? (sSkipHf ? "該当 (見送り)" : "非該当") : "上位足データ不足") : "OFF", text_color = color.white)
    table.cell(dbg, 2, 16, iHfUse ? (dataHf ? (lSkipHf ? "該当 (見送り)" : "非該当") : "上位足データ不足") : "OFF", text_color = color.white)
    table.cell(dbg, 0, 17, "1H K / 4H K", text_color = color.white)
    table.cell(dbg, 1, 17, f_n(k60_0) + " / " + f_n(k240_0), text_color = color.white)
    table.cell(dbg, 2, 17, setHf, text_color = color.white)
    table.cell(dbg, 0, 12, "15分足 区間", text_color = color.white)
    table.cell(dbg, 1, 12, f_t(s15Open) + " 〜 " + f_t(s15Close), text_color = color.white)
    table.cell(dbg, 2, 12, f_st(v15, c15Now), text_color = color.white)
    table.cell(dbg, 0, 13, "不成立理由", text_color = color.white)
    table.cell(dbg, 1, 13, reasonS == "" ? "-" : reasonS, text_color = color.white)
    table.cell(dbg, 2, 13, reasonL == "" ? "-" : reasonL, text_color = color.white)
    table.cell(dbg, 0, 14, "判定時刻", text_color = color.white)
    table.cell(dbg, 1, 14, f_t(tEval), text_color = color.white)

// データウィンドウ (検証表示 ON のときだけ。過去の足の判定根拠を足ごとに確認する)
// 上位足の状態コード: 1 = 今回完成 (確定)、0 = 形成中、-1 = 不採用 / なし
plot(k1m,   "1分 K1",            display = iDebug ? display.data_window : display.none)
plot(d1m,   "1分 D1",            display = iDebug ? display.data_window : display.none)
plot(k1Chg, "1分 K1変化",        display = iDebug ? display.data_window : display.none)
plot(k1Max, "1分 直近K1最大",    display = iDebug ? display.data_window : display.none)
plot(k1Min, "1分 直近K1最小",    display = iDebug ? display.data_window : display.none)
plot(k5_0,  "5分 K0 (現在の足)", display = iDebug ? display.data_window : display.none)
plot(k5_1,  "5分 K1 (1本前)",    display = iDebug ? display.data_window : display.none)
plot(k5_2,  "5分 K2 (2本前)",    display = iDebug ? display.data_window : display.none)
plot(dl5_0, "5分 Δ0",            display = iDebug ? display.data_window : display.none)
plot(dl5_1, "5分 Δ1",            display = iDebug ? display.data_window : display.none)
plot(f_ymdhm(s5Open),  "5分足 開始 (yyyymmddhhmm)",     display = iDebug ? display.data_window : display.none, precision = 0)
plot(f_ymdhm(s5Close), "5分足 終了予定 (yyyymmddhhmm)", display = iDebug ? display.data_window : display.none, precision = 0)
plot(not v5 ? -1 : c5Now ? 1 : 0, "5分足 状態 (1 完成 / 0 形成中 / -1 不採用)", display = iDebug ? display.data_window : display.none, precision = 0)
plot(k15_0, "15分 K0 (現在の足)", display = iDebug ? display.data_window : display.none)
plot(k15_1, "15分 K1 (1本前)",    display = iDebug ? display.data_window : display.none)
plot(k15_2, "15分 K2 (2本前)",    display = iDebug ? display.data_window : display.none)
plot(dl0,   "15分 Δ0",            display = iDebug ? display.data_window : display.none)
plot(dl1,   "15分 Δ1",            display = iDebug ? display.data_window : display.none)
plot(f_ymdhm(s15Open),  "15分足 開始 (yyyymmddhhmm)",     display = iDebug ? display.data_window : display.none, precision = 0)
plot(f_ymdhm(s15Close), "15分足 終了予定 (yyyymmddhhmm)", display = iDebug ? display.data_window : display.none, precision = 0)
plot(not v15 ? -1 : c15Now ? 1 : 0, "15分足 状態 (1 完成 / 0 形成中 / -1 不採用)", display = iDebug ? display.data_window : display.none, precision = 0)
plot(k60_0,  "1時間 K (現在の足)", display = iDebug ? display.data_window : display.none)
plot(k240_0, "4時間 K (現在の足)", display = iDebug ? display.data_window : display.none)
plot(not iHfUse ? -2 : not dataHf ? -1 : lSkipHf ? 1 : 0, "ロング 1H4H見送り (1 該当 / 0 非該当 / -1 データ不足 / -2 OFF)",
     display = iDebug ? display.data_window : display.none, precision = 0)
plot(not iHfUse ? -2 : not dataHf ? -1 : sSkipHf ? 1 : 0, "ショート 1H4H見送り (1 該当 / 0 非該当 / -1 データ不足 / -2 OFF)",
     display = iDebug ? display.data_window : display.none, precision = 0)
plot(f_ymdhm(tEval), "判定時刻 (yyyymmddhhmm)", display = iDebug ? display.data_window : display.none, precision = 0)
plot(f_code(dataAll, sCross1, sMove1, sReach1, s5, s15Ok, sHfOk), "S判定コード [データ|クロス|変化|到達|5分|15分|1H4H]",
     display = iDebug ? display.data_window : display.none, precision = 0)
plot(f_code(dataAll, lCross1, lMove1, lReach1, l5, l15Ok, lHfOk), "L判定コード [データ|クロス|変化|到達|5分|15分|1H4H]",
     display = iDebug ? display.data_window : display.none, precision = 0)
plot(shortSig ? 1 : 0, "ショート合図", display = iDebug ? display.data_window : display.none, precision = 0)
plot(longSig ? 1 : 0,  "ロング合図",   display = iDebug ? display.data_window : display.none, precision = 0)

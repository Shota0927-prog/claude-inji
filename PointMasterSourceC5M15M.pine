//@version=5

// =====================================================================================
// POINT MASTER SOURCE C 5M15M  ―  POINT MASTER B 5分・15分専用版 Source C（Logic19〜25 : 水平線 / Fib / SAT / ストキャス）
// =====================================================================================
// 1 分足あり版 Source（PM-SRC-C-V2）から 1 分足の取得・状態・準備確認・保持設定・BUS を取り除き、
// 5 分足と 15 分足だけで、担当ロジックの検知・抑止前 PRE・V2 有効根拠（否定ライン / 価格否定 / 期限 / Fib 解除）・
// 系統点・データ準備確認を行う版。5M / 15M の処理内容と取得方式（[1] + lookahead_on）は 1 分足あり版と同じ。
// 検知モジュール（入力・PRM 束・ロジック関数・Engine 関数）は V2 版からそのまま移している（条件の変更なし）。
// 取り除いたもの : 他 Source のロジック / 1H・4H・1D の取得 / ロジック名・Weight / 元版の ST_STATE・スコア・PRE スコア・
//                  PHASE・VALID TP / 旧テーブル・旧アラート・LOT ADJUST / モード A / 判定（Decision が担当）
// 使い方 : 5 分足チャートに追加し、PointMasterDecision5M15M（PM-DEC-515）の入力
//          「C 5M BUS / C 15M BUS」へ、この Source の同名出力を接続する。TF は 5M / 15M 固定。
// 【BUS 仕様（Decision への受け渡し）】plot の値 1 本 = 1 TF ぶんの集約結果（非負整数 < 2^49）
//   bus = 1(format) + 4 × SourceID + 16 × TFID + 64 × slot + 2^28 × payload
//     bit 0-1   : format = 2（5分・15分専用版。1 分足あり版の BUS は format 1 なので Decision 5M15M は受け付けない）
//     bit 2-3   : SourceID（1 = A / 2 = B / 3 = C）
//     bit 4-5   : TFID（1 = 5M / 2 = 15M。この版は 1M を出さない）
//     bit 6-27  : slot = (集約結果を確定した 5 分足の確定時刻 time_close − 2020-01-01 00:00 UTC) / 5 分
//                 0〜4,194,303（2020-01-01 00:05 〜 2059-11-23 頃の 5 分足）。範囲外は折り返さず na
//     bit 28-48 : payload（21 bit）
//       bit 0 : LONG 方向の根拠がこの 5 分足の処理中に価格否定された / bit 1 : SHORT 方向
//       bit 2 : 価格基準なし（未対応）の有効根拠がある
//       bit 3- : 系統ごとに [LONG 確認済み 1bit, LONG 統合, SHORT 確認済み 1bit, SHORT 統合]
//                統合は SAT だけ 2bit（0〜3 = 強度 0 / 1/3 / 2/3 / 1）、他の系統は 1bit（強度 0 / 1 しか取らない）
//   最大値 < 2^49 = 562,949,953,421,312 ≤ 2^53 − 1。各フィールドは重ならず、境界値まで可逆。
//   未準備・不整合の 5 分足では na（根拠ゼロを有効値として送らない）。
//   値は 5 分足の確定時点で確定し、足の途中では最後に確定した値を出し続ける。
//   payload の系統配置（この Source）: 価格帯（Logic19〜20）= bit 3-6 / Fib = bit 7-10 / SAT = bit 11-16（LONG 確認 11・統合 12-13、SHORT 確認 14・統合 15-16）/ ストキャス = bit 17-20
// =====================================================================================
indicator(
     title         = "POINT MASTER SOURCE C 5M15M",
     shorttitle    = "PM-C-515",
     overlay       = true,
     max_bars_back = 500
 )

// =====================================================================================
// §0. 定数（この Source 内のロジック番号は 0 始まりのローカル番号。0〜1 = Logic19〜20 / 2〜4 = Logic21〜23 / 5 = Logic24 / 6 = Logic25）
// =====================================================================================
int N_LOGIC = 7
int N_TF    = 2            // 内部 index 0 = 5M / 1 = 15M（1M は持たない）
int CONF_IGNORE = 0
int CONF_LONG   = 1
int CONF_SHORT  = 2
f_idx(li, ti) => li * N_TF + ti
// 時間足（5M / 15M 固定）。tfStr1 は Engine A の EMA 対象 TF 判定（元版は 1M / 5M のみ対象）で参照されるだけで、
// 1M のデータ取得には使わない（この版は 1M を取得しない。15M へ EMA ロジックを新たに適用しない）
tfStr1 = "1"
tfStr2 = "5"
tfStr3 = "15"

// =====================================================================================
// §3. 保持本数（元版と同じ input・初期値。5M / 15M のみ）＝ V2 有効根拠の期限
// =====================================================================================
grpH19 = "③ Logic19 (Horiz Reb) 保持本数"
h19b = input.int(6, "5M",  group = grpH19, minval = 1, inline = "h19a")
h19c = input.int(4, "15M", group = grpH19, minval = 1, inline = "h19a")
grpH20 = "③ Logic20 (Horiz Brk) 保持本数"
h20b = input.int(6, "5M",  group = grpH20, minval = 1, inline = "h20a")
h20c = input.int(4, "15M", group = grpH20, minval = 1, inline = "h20a")
grpH21 = "③ Logic21 (Fib382) 保持本数"
h21b = input.int(6, "5M",  group = grpH21, minval = 1, inline = "h21a")
h21c = input.int(4, "15M", group = grpH21, minval = 1, inline = "h21a")
grpH22 = "③ Logic22 (Fib500) 保持本数"
h22b = input.int(6, "5M",  group = grpH22, minval = 1, inline = "h22a")
h22c = input.int(4, "15M", group = grpH22, minval = 1, inline = "h22a")
grpH23 = "③ Logic23 (Fib618) 保持本数"
h23b = input.int(6, "5M",  group = grpH23, minval = 1, inline = "h23a")
h23c = input.int(4, "15M", group = grpH23, minval = 1, inline = "h23a")
grpH25 = "③ Logic25 (Stoch Turn) 保持本数"
h25b = input.int(6, "5M",  group = grpH25, minval = 1, inline = "h25a")
h25c = input.int(4, "15M", group = grpH25, minval = 1, inline = "h25a")
HOLD19 = array.from(h19b, h19c)
HOLD20 = array.from(h20b, h20c)
HOLD21 = array.from(h21b, h21c)
HOLD22 = array.from(h22b, h22c)
HOLD23 = array.from(h23b, h23c)
HOLD24 = array.from(0, 0)             // 状態型（保持本数を使わない）
HOLD25 = array.from(h25b, h25c)
var HOLD_ALL = array.new_int(0)
if array.size(HOLD_ALL) == 0
    array.concat(HOLD_ALL, HOLD19)
    array.concat(HOLD_ALL, HOLD20)
    array.concat(HOLD_ALL, HOLD21)
    array.concat(HOLD_ALL, HOLD22)
    array.concat(HOLD_ALL, HOLD23)
    array.concat(HOLD_ALL, HOLD24)
    array.concat(HOLD_ALL, HOLD25)

grpRule = "⑤ 状態管理ルール"
conflictStr = input.string("無視 (現状維持)", "同一ロジック・同一TFで両方向が同時発生した時",
     options = ["無視 (現状維持)", "LONG優先", "SHORT優先"], group = grpRule)
conflictMode = conflictStr == "LONG優先" ? CONF_LONG : conflictStr == "SHORT優先" ? CONF_SHORT : CONF_IGNORE

// =====================================================================================
// §4. 検知モジュール（V2 版からそのまま移したもの）
// =====================================================================================

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic19 = Horizontal Rebound / Logic20 = Horizontal Break
// -------------------------------------------------------------------------------------
// 検出は元「トレンド + 水平線 環境認識ストラテジー」の水平線モジュール
// （f_lineEnvAddZone / f_lineEnvMergeZone / f_lineEnvSession / f_lineEnvCommonOK と
// A:反発 / C:ブレイク の判定式）と同一です。移植したのは次の部分だけです。
//   ・水平線ソース : 前日 高値/安値（確定前日値のみ）＋ セッション 高値/安値（終了後の確定値のみ）
//     セッションは Asia / London / New York。時間・Timezone は元コードと同じ input です。
//   ・近い水平線は別々に扱わず、タッチ数の加重平均で1つの水平ゾーンへ統合（統合許容幅 = ATR倍率）
//   ・ゾーン幅（ATR連動 / 固定）付きの最近接 Support（close以下）/ Resistance（closeより上）
//   ・A: 反発（ゾーン接触 + 回復位置モード + 方向/ヒゲ/実体率/ATR の共通ローソク品質）
//   ・C: ブレイク（確定終値 + ゾーン幅 + ATRバッファ + 実体率 + 任意でブレイク足の色）
//
// ★ Pivot High/Low、複数回反応価格帯（Reaction Zone）、Flip、Sweep、障害物NoTrade、
//   強度（Strength）によるスコア倍率、MTF統合（WeightedScore / HigherTF）、独自bias・独自保持、
//   テーブル / ラベル / 水平線描画は移植していません（今回の仕様どおり）。
//   強度はポイント倍率に一切使いません。前日だけ / セッションだけ / 両方が重なったゾーンでも
//   Logic19 / Logic20 の Weight は同じです。
//
// 1ゾーン = 1イベント源です。前日高値と London High と NY High が近接していても
// 統合後の1ゾーンから Logic19 は1回、Logic20 は1回しかイベントを出しません。
//
//   Logic19 : Support反発 → LONG / Resistance反発 → SHORT（単なる接触では発火しない）
//   Logic20 : Resistance上抜け → LONG / Support下抜け → SHORT（確定終値のみ。ヒゲ抜けは無効）
//             ブレイク後は「そのブレイクした同じゾーン」（価格 / 上限 / 下限 / 方向）を保存し、
//             確定終値がゾーンの反対側へ戻った足で逆方向イベントを出します。
//               上抜け後にゾーン下側へ確定 → SHORT（POINT MASTER側で LONG解除 → SHORT切替）
//               下抜け後にゾーン上側へ確定 → LONG （POINT MASTER側で SHORT解除 → LONG切替）
//             追跡中は別ゾーンのブレイクを検出してもイベントを出さず、追跡対象も差し替えません。
//             戻りで追跡が終わった後は、次の新規ブレイクを再び受け付けます。
//             ブレイク対象は「前バーで最近接だったゾーン」なので、現在足に最近接Resistance /
//             Support が残っているかどうかはブレイク成立条件に入れません。
//
// Logic19 と Logic20 は完全に独立したロジックです（互いのイベントで相手を解除しません）。
// 出力はイベント4値のみで、保持・期限・同方向再発生・LONG⇔SHORT切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
// 非リペイント：前日H/Lは確定前日値のみ、セッションH/Lは終了後の確定値のみを使います
// （形成中セッションの動くHigh/Lowでは判定しません）。
grpHz = "④ Logic19/20 : Horizontal パラメータ"
useHzPrevDayHL   = input.bool(true,  "水平線ソース : 前日 高値/安値",       group = grpHz)
useHzSessionHL   = input.bool(true,  "水平線ソース : セッション 高値/安値", group = grpHz)
hzAtrLen         = input.int(14,     "ATR期間",                            group = grpHz, minval = 1)
hzMaxZones       = input.int(20,     "水平ゾーン 最大保持数",               group = grpHz, minval = 1, maxval = 60)
useHzMergeZone   = input.bool(true,  "近い水平線をゾーン統合する",           group = grpHz)
hzMergeToleranceATR = input.float(0.5, "統合許容幅 ATR倍率",                group = grpHz, minval = 0.0, step = 0.05)
useHzATRZone     = input.bool(true,  "ゾーン幅をATR連動にする",             group = grpHz)
hzZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率",                   group = grpHz, minval = 0.0, step = 0.05)
hzZoneFixedWidth = input.float(0.0,  "ゾーン幅 固定",                      group = grpHz, minval = 0.0, step = 0.1)
hzSessTZ         = input.string("GMT",         "セッション タイムゾーン",    group = grpHz)
hzAsiaSess       = input.session("0000-0800",  "Asia",                     group = grpHz)
hzLondonSess     = input.session("0700-1600",  "London",                   group = grpHz)
hzNySess         = input.session("1200-2100",  "New York",                 group = grpHz)
hzBounceRecoverMode = input.string("Center", "反発 回復位置", options = ["Center", "OuterEdge", "PreviousCloseSide"], group = grpHz)
useHzDirCandleFilter = input.bool(true,  "反発 方向ローソク",  group = grpHz)
useHzWickFilter      = input.bool(false, "反発 ヒゲ確認",      group = grpHz)
useHzBodyFilter      = input.bool(false, "反発 実体率",        group = grpHz)
useHzATRFilter       = input.bool(false, "反発 ATR(値幅)",     group = grpHz)
hzBodyRatioMin       = input.float(0.3, "反発 実体率 最小",     group = grpHz, minval = 0.0, maxval = 1.0, step = 0.05)
hzAtrMinMult         = input.float(0.5, "反発 最小値幅 ATR倍率", group = grpHz, minval = 0.0, step = 0.05)
hzEventRearmMode = input.string("LeaveZone", "反発 再アーム", options = ["LeaveZone", "Bars", "LeaveZoneOrBars"], group = grpHz)
hzEventRearmATR  = input.float(0.5, "反発 再アーム ゾーン離脱 ATR倍率", group = grpHz, minval = 0.0, step = 0.05)
hzEventRearmBars = input.int(3,     "反発 再アーム 最低本数",            group = grpHz, minval = 1)
hzBreakBufferATR = input.float(0.05, "ブレイク バッファ ATR倍率",        group = grpHz, minval = 0.0, step = 0.05)
useHzBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター",        group = grpHz)
hzBreakBodyRatio     = input.float(0.5, "ブレイク 実体率最小",           group = grpHz, minval = 0.0, maxval = 1.0, step = 0.05)
useHzBreakCandleColor = input.bool(false, "ブレイク 方向ローソク色を要求", group = grpHz)

// --- Logic19/20 Horizontal のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_HZ = array.from(
     useHzPrevDayHL ? 1.0 : 0.0,                                                              // 00 : useHzPrevDayHL
     useHzSessionHL ? 1.0 : 0.0,                                                              // 01 : useHzSessionHL
     hzMaxZones * 1.0,                                                                        // 02 : hzMaxZones
     useHzMergeZone ? 1.0 : 0.0,                                                              // 03 : useHzMergeZone
     hzMergeToleranceATR,                                                                     // 04 : hzMergeToleranceATR
     useHzATRZone ? 1.0 : 0.0,                                                                // 05 : useHzATRZone
     hzZoneATRMult,                                                                           // 06 : hzZoneATRMult
     hzZoneFixedWidth,                                                                        // 07 : hzZoneFixedWidth
     hzBounceRecoverMode == "Center" ? 0.0 : hzBounceRecoverMode == "OuterEdge" ? 1.0 : 2.0,  // 08 : hzBounceRecoverMode
     useHzDirCandleFilter ? 1.0 : 0.0,                                                        // 09 : useHzDirCandleFilter
     useHzWickFilter ? 1.0 : 0.0,                                                             // 10 : useHzWickFilter
     useHzBodyFilter ? 1.0 : 0.0,                                                             // 11 : useHzBodyFilter
     useHzATRFilter ? 1.0 : 0.0,                                                              // 12 : useHzATRFilter
     hzBodyRatioMin,                                                                          // 13 : hzBodyRatioMin
     hzAtrMinMult,                                                                            // 14 : hzAtrMinMult
     hzEventRearmMode == "LeaveZone" ? 0.0 : hzEventRearmMode == "Bars" ? 1.0 : 2.0,          // 15 : hzEventRearmMode
     hzEventRearmATR,                                                                         // 16 : hzEventRearmATR
     hzEventRearmBars * 1.0,                                                                  // 17 : hzEventRearmBars
     hzBreakBufferATR,                                                                        // 18 : hzBreakBufferATR
     useHzBreakBodyFilter ? 1.0 : 0.0,                                                        // 19 : useHzBreakBodyFilter
     hzBreakBodyRatio,                                                                        // 20 : hzBreakBodyRatio
     useHzBreakCandleColor ? 1.0 : 0.0                                                        // 21 : useHzBreakCandleColor
 )

// --- 元コードと同一の補助関数 ---
// 共通ローソク品質（方向 / ヒゲ / 実体率 / ATR。各OFFなら影響しない）
f_hzCommonOK(_isBuy, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pUseHzDirCandleFilter   = array.get(PRM_HZ, 9) > 0.5
    bool  _pUseHzWickFilter        = array.get(PRM_HZ, 10) > 0.5
    bool  _pUseHzBodyFilter        = array.get(PRM_HZ, 11) > 0.5
    bool  _pUseHzATRFilter         = array.get(PRM_HZ, 12) > 0.5
    float _pHzBodyRatioMin         = array.get(PRM_HZ, 13)
    float _pHzAtrMinMult           = array.get(PRM_HZ, 14)
    float _rng  = high - low
    float _body = math.abs(close - open)
    float _upW  = high - math.max(close, open)
    float _dnW  = math.min(close, open) - low
    float _bRatio = _rng > 0 ? _body / _rng : 0.0
    bool _ok = true
    if _pUseHzDirCandleFilter
        _ok := _ok and (_isBuy ? close > open : close < open)
    if _pUseHzWickFilter
        _ok := _ok and (_isBuy ? _dnW >= _body : _upW >= _body)
    if _pUseHzBodyFilter
        _ok := _ok and _bRatio >= _pHzBodyRatioMin
    if _pUseHzATRFilter
        _ok := _ok and _rng >= _atr * _pHzAtrMinMult
    _ok

// 水平ゾーンへ追加 / 統合（近接があればタッチ数の加重平均で統合。無ければ push。上限超過で最古を削除）
f_hzAddZone(array<float> _zP, array<int> _zT, array<int> _zCB, _p, _mergeTol) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pHzMaxZones             = int(array.get(PRM_HZ, 2))
    int _idx = -1
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if _idx == -1 and math.abs(array.get(_zP, _i) - _p) <= _mergeTol
                _idx := _i
    if _idx >= 0
        int _oldT = array.get(_zT, _idx)
        int _newT = _oldT + 1
        array.set(_zP, _idx, (array.get(_zP, _idx) * _oldT + _p) / _newT)
        array.set(_zT, _idx, _newT)
    else
        array.push(_zP, _p)
        array.push(_zT, 1)
        array.push(_zCB, bar_index)
        while array.size(_zP) > _pHzMaxZones
            array.shift(_zP)
            array.shift(_zT)
            array.shift(_zCB)
    array.size(_zP)

// セッション 高値/安値 追跡（終了時に確定・[hi, lo, ended]）
f_hzSession(_sessStr, _prevHi, _prevLo) =>
    bool _inSess  = not na(time(timeframe.period, _sessStr, hzSessTZ))
    bool _started = _inSess and not _inSess[1]
    bool _ended   = not _inSess and _inSess[1]
    float _hi = _prevHi
    float _lo = _prevLo
    if _started
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(_prevHi) ? high : math.max(_prevHi, high)
        _lo := na(_prevLo) ? low  : math.min(_prevLo, low)
    [_hi, _lo, _ended]

// 反発イベントの再アーム（同じゾーンで毎足発火させないため。ゾーン離脱 / 経過本数）
f_hzRearmOK(_bar, _price, _atr) =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    int   _pHzEventRearmMode       = int(array.get(PRM_HZ, 15))
    float _pHzEventRearmATR        = array.get(PRM_HZ, 16)
    int   _pHzEventRearmBars       = int(array.get(PRM_HZ, 17))
    bool _leftZone = not na(_price) and math.abs(close - _price) >= _atr * _pHzEventRearmATR
    bool _barsOk   = not na(_bar) and (bar_index - _bar) >= _pHzEventRearmBars
    _pHzEventRearmMode == 0 ? _leftZone : _pHzEventRearmMode == 1 ? _barsOk : (_leftZone or _barsOk)

f_horizontalEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    bool  _pUseHzPrevDayHL         = array.get(PRM_HZ, 0) > 0.5
    bool  _pUseHzSessionHL         = array.get(PRM_HZ, 1) > 0.5
    bool  _pUseHzMergeZone         = array.get(PRM_HZ, 3) > 0.5
    float _pHzMergeToleranceATR    = array.get(PRM_HZ, 4)
    bool  _pUseHzATRZone           = array.get(PRM_HZ, 5) > 0.5
    float _pHzZoneATRMult          = array.get(PRM_HZ, 6)
    float _pHzZoneFixedWidth       = array.get(PRM_HZ, 7)
    int   _pHzBounceRecoverMode    = int(array.get(PRM_HZ, 8))
    float _pHzBreakBufferATR       = array.get(PRM_HZ, 18)
    bool  _pUseHzBreakBodyFilter   = array.get(PRM_HZ, 19) > 0.5
    float _pHzBreakBodyRatio       = array.get(PRM_HZ, 20)
    bool  _pUseHzBreakCandleColor  = array.get(PRM_HZ, 21) > 0.5
    float _atr = ta.atr(hzAtrLen)
    float _zoneW = _pUseHzATRZone ? _atr * _pHzZoneATRMult : _pHzZoneFixedWidth
    float _mergeTol = _pUseHzMergeZone ? _atr * _pHzMergeToleranceATR : 0.0
    // 統合ゾーン配列（var: 呼び出しコンテキスト＝TFごとに独立）
    var array<float> _zP  = array.new_float()   // ゾーン価格（統合時は加重平均）
    var array<int>   _zT  = array.new_int()     // 統合回数（加重平均用）
    var array<int>   _zCB = array.new_int()     // 生成バー（生成前のバーでは使わない）

    // --- ① 前日 高値/安値（確定前日値のみ）---
    var float _curDayHigh = na
    var float _curDayLow  = na
    var float _prevHigh   = na
    var float _prevLow    = na
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        _prevHigh := _curDayHigh
        _prevLow  := _curDayLow
        _curDayHigh := high
        _curDayLow  := low
        if _pUseHzPrevDayHL and not na(_prevHigh)
            f_hzAddZone(_zP, _zT, _zCB, _prevHigh, _mergeTol)
        if _pUseHzPrevDayHL and not na(_prevLow)
            f_hzAddZone(_zP, _zT, _zCB, _prevLow, _mergeTol)
    else
        _curDayHigh := na(_curDayHigh) ? high : math.max(_curDayHigh, high)
        _curDayLow  := na(_curDayLow)  ? low  : math.min(_curDayLow, low)

    // --- ② セッション 高値/安値（そのセッションが終了して確定した足で登録）---
    var float _asiaHigh   = na
    var float _asiaLow    = na
    var float _londonHigh = na
    var float _londonLow  = na
    var float _nyHigh     = na
    var float _nyLow      = na
    [_aH, _aL, _aEnd] = f_hzSession(hzAsiaSess, _asiaHigh, _asiaLow)
    _asiaHigh := _aH
    _asiaLow  := _aL
    [_lH, _lL, _lEnd] = f_hzSession(hzLondonSess, _londonHigh, _londonLow)
    _londonHigh := _lH
    _londonLow  := _lL
    [_nH, _nL, _nEnd] = f_hzSession(hzNySess, _nyHigh, _nyLow)
    _nyHigh := _nH
    _nyLow  := _nL
    if _pUseHzSessionHL
        if _aEnd and not na(_asiaHigh)
            f_hzAddZone(_zP, _zT, _zCB, _asiaHigh, _mergeTol)
        if _aEnd and not na(_asiaLow)
            f_hzAddZone(_zP, _zT, _zCB, _asiaLow, _mergeTol)
        if _lEnd and not na(_londonHigh)
            f_hzAddZone(_zP, _zT, _zCB, _londonHigh, _mergeTol)
        if _lEnd and not na(_londonLow)
            f_hzAddZone(_zP, _zT, _zCB, _londonLow, _mergeTol)
        if _nEnd and not na(_nyHigh)
            f_hzAddZone(_zP, _zT, _zCB, _nyHigh, _mergeTol)
        if _nEnd and not na(_nyLow)
            f_hzAddZone(_zP, _zT, _zCB, _nyLow, _mergeTol)

    // --- ③ 最近接 Support（close以下）/ Resistance（closeより上）---
    float _nSupP = na
    float _nResP = na
    int   _nSupCB = na
    int   _nResCB = na
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if bar_index >= array.get(_zCB, _i)
                float _pr = array.get(_zP, _i)
                if _pr <= close
                    if na(_nSupP) or _pr > _nSupP
                        _nSupP := _pr
                        _nSupCB := array.get(_zCB, _i)
                else
                    if na(_nResP) or _pr < _nResP
                        _nResP := _pr
                        _nResCB := array.get(_zCB, _i)
    float _supZoneTop = _nSupP + _zoneW
    float _resZoneBot = _nResP - _zoneW
    bool _supUsable = not na(_nSupP) and not na(_nSupCB) and bar_index >= _nSupCB
    bool _resUsable = not na(_nResP) and not na(_nResCB) and bar_index >= _nResCB

    // --- ④ Logic19 : 反発（ゾーン接触 + 回復位置 + 共通ローソク品質）---
    float _buyRecover  = _pHzBounceRecoverMode == 1 ? _supZoneTop : _nSupP
    float _sellRecover = _pHzBounceRecoverMode == 1 ? _resZoneBot : _nResP
    bool _buyBounce  = _supUsable and low  <= _supZoneTop and close > _buyRecover  and (_pHzBounceRecoverMode != 2 or close[1] <= _supZoneTop) and f_hzCommonOK(true, _atr)
    bool _sellBounce = _resUsable and high >= _resZoneBot and close < _sellRecover and (_pHzBounceRecoverMode != 2 or close[1] >= _resZoneBot) and f_hzCommonOK(false, _atr)
    // 同じゾーンで毎足発火させない（ゾーンが変われば別イベントとして発火可能）
    var int   _armBuyZone  = na
    var int   _armSellZone = na
    var int   _armBuyBar   = na
    var int   _armSellBar  = na
    var float _armBuyP     = na
    var float _armSellP    = na
    int _supId = na(_nSupP) ? na : int(math.round(_nSupP / syminfo.mintick))
    int _resId = na(_nResP) ? na : int(math.round(_nResP / syminfo.mintick))
    bool _buyArmOk  = na(_armBuyZone)  or _armBuyZone  != _supId or f_hzRearmOK(_armBuyBar,  _armBuyP,  _atr)
    bool _sellArmOk = na(_armSellZone) or _armSellZone != _resId or f_hzRearmOK(_armSellBar, _armSellP, _atr)
    bool _l19Long  = _buyBounce  and _buyArmOk
    bool _l19Short = _sellBounce and _sellArmOk
    if _l19Long
        _armBuyZone := _supId
        _armBuyBar  := bar_index
        _armBuyP    := _nSupP
    if _l19Short
        _armSellZone := _resId
        _armSellBar  := bar_index
        _armSellP    := _nResP

    // --- ⑤ Logic20 : ブレイク（確定終値のみ。前バーの最近接ゾーンを対象にする）---
    var float _prevSupP = na      // 前バーの最近接Support（[1] の代わりに明示保持）
    var float _prevResP = na      // 前バーの最近接Resistance
    bool _breakBodyOK = not _pUseHzBreakBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= _pHzBreakBodyRatio)
    float _brkBuf = _atr * _pHzBreakBufferATR
    //   ブレイク対象は「前バーで最近接だったゾーン」です。現在足で最上位Resistance / 最下位Support が
    //   無くなっても正しい抜けが消えないよう、現在足の _resUsable / _supUsable は条件に入れません。
    bool _buyBreak  = not na(_prevResP) and close > _prevResP + _zoneW + _brkBuf and close[1] <= _prevResP + _zoneW + _brkBuf and _breakBodyOK and (not _pUseHzBreakCandleColor or close > open)
    bool _sellBreak = not na(_prevSupP) and close < _prevSupP - _zoneW - _brkBuf and close[1] >= _prevSupP - _zoneW - _brkBuf and _breakBodyOK and (not _pUseHzBreakCandleColor or close < open)

    // --- ⑥ ブレイクした「同じゾーン」を保存して戻りを追跡 ---
    //   追跡中（_brkDir != 0）は別ゾーンのブレイクを Logic20 イベントにしません。
    //   追跡中に出せるのは「保存した同じゾーンへ確定終値で戻った時の逆方向イベント」だけです。
    //   戻りで追跡が終了（_brkDir = 0）したら、次の新規ブレイクを再び受け付けます。
    var float _brkZoneP   = na
    var float _brkZoneTop = na
    var float _brkZoneBot = na
    var int   _brkDir     = 0     // 1 = 上抜け追跡中 / -1 = 下抜け追跡中 / 0 = 追跡なし
    int _brkDirPrev = _brkDir     // このバー開始時の追跡状態（新規ブレイクを採用してよいかの判定用）
    // 保存済みゾーンへ確定終値で戻ったら逆方向イベント（ヒゲだけの戻りは無効）
    bool _brkFailShort = _brkDir == 1  and not na(_brkZoneBot) and close < _brkZoneBot
    bool _brkFailLong  = _brkDir == -1 and not na(_brkZoneTop) and close > _brkZoneTop
    float _v2FailTop = _brkZoneTop   // ★V2: 戻りイベントの否定ライン（リセット前に退避）
    float _v2FailBot = _brkZoneBot
    if _brkFailShort or _brkFailLong
        _brkDir     := 0
        _brkZoneP   := na
        _brkZoneTop := na
        _brkZoneBot := na
    // 新規ブレイクをイベントとして採用するのは「追跡していない時」だけ
    bool _newBuyBreak  = _buyBreak  and _brkDirPrev == 0
    bool _newSellBreak = _sellBreak and _brkDirPrev == 0
    if _newBuyBreak
        _brkZoneP   := _prevResP
        _brkZoneTop := _prevResP + _zoneW
        _brkZoneBot := _prevResP - _zoneW
        _brkDir     := 1
    else if _newSellBreak
        _brkZoneP   := _prevSupP
        _brkZoneTop := _prevSupP + _zoneW
        _brkZoneBot := _prevSupP - _zoneW
        _brkDir     := -1

    bool _l20Long  = _newBuyBreak  or _brkFailLong    // Resistance上抜け / 下抜けたゾーン上側への終値復帰
    bool _l20Short = _newSellBreak or _brkFailShort   // Support下抜け / 上抜けたゾーン下側への終値復帰

    // ★V2: 判定条件は変更せず、V2 の価格否定用に「成立時の否定ライン」を追加で返す（成立しない足は na）
    //     Logic19 : LONG = Support ゾーン下端 / SHORT = Resistance ゾーン上端（帯の反発）
    //     Logic20 : 新規ブレイク = 跨いだゾーン端（LONG 上端 / SHORT 下端）、戻りイベント = 戻ったゾーン端
    float _v2HzRebL = _l19Long  ? _nSupP - _zoneW : na
    float _v2HzRebS = _l19Short ? _nResP + _zoneW : na
    float _v2HzBrkL = _newBuyBreak  ? _prevResP + _zoneW : _brkFailLong  ? _v2FailTop : na
    float _v2HzBrkS = _newSellBreak ? _prevSupP - _zoneW : _brkFailShort ? _v2FailBot : na

    // 次バー用に今バーの最近接ゾーンを保存
    _prevSupP := _nSupP
    _prevResP := _nResP

    [_l19Long, _l19Short, _l20Long, _l20Short, _v2HzRebL, _v2HzRebS, _v2HzBrkL, _v2HzBrkS]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic21 = Fib 38.2 / Logic22 = Fib 50.0 / Logic23 = Fib 61.8 Rebound
// -------------------------------------------------------------------------------------
// 採用波の検出は元「トレンド + フィボナッチ 環境認識ストラテジー」の f_fibEnvState と同一です。
//   ・確定Pivot High / Low のみ使用（未確定Pivotでは採用波を変えない）
//   ・上げ波候補 = 確定Pivot Low → その後の確定Pivot High（波幅 >= ATR×倍率 かつ 継続バー数 >= 最低）
//   ・下げ波候補 = 確定Pivot High → その後の確定Pivot Low（完全対称）
//   ・同方向継続中は起点(origin)を固定し、extreme を更新する確定Pivotが出たときだけ終点を更新
//   ・反転 = 反対方向の構造ブレイク(BOS)付きの新波、または起点の終値突破（ヒゲ無視）
//   ・小さな内部波では採用波を切り替えない（「直近高値と安値だけで引く」簡略化はしていません）
//
// ★ 移植していないもの：MTF統合 / WeightedScore / HigherTF / Fib bias保持 / Fib帯にいるだけの
//   方向判定 / エントリー範囲 input / strategy.entry / SL・TP / テーブル / Fib描画 / ラベル / デバッグ。
//
// Fib価格は現在の採用波（起点固定・終点は更新に追従）から毎バー再計算します。
//   price(r) = extreme + r × (origin - extreme)
//   上げ波：origin = Swing Low(0%) / extreme = Swing High(100%) → 押しが深いほど価格は下
//   下げ波：origin = Swing High(0%) / extreme = Swing Low(100%) → 戻しが深いほど価格は上
//
// 【最深到達レベル優先】同一TF・同一採用波では、到達済みの最も深いレベルだけが有効候補です。
//   到達判定はヒゲ（上げ波 = low、下げ波 = high）、Rebound確定は終値です。
//     38.2到達（50未到達） → Logic21 のみ判定
//     50到達               → Logic21 失効、Logic22 のみ判定
//     61.8到達             → Logic21 / 22 失効、Logic23 のみ判定
//     78.6到達             → Logic21 / 22 / 23 すべて失効（イベントなし）
//   深いレベル到達後に浅いFibへ価格が戻っても、浅いLogicは再発火しません。
//   同一採用波では各レベル1回だけ発火します（使用済みフラグ）。
//   「到達」は候補レベルの決定、「終値回復」が実際のReboundイベントです。
//   処理順は ①最深到達レベル更新 → ②浅いFibの解除フラグ → ③最深レベルのRebound判定 です。
//
// 採用波が変わった時（方向転換 / 新しい有効波）だけ、最深到達レベルと使用済みフラグをリセットします。
// Wave ID = 方向 + 起点バー + 起点価格。終点(extreme)の更新だけではリセットしません。
// 上げ波は LONG のみ、下げ波は SHORT のみ（逆張りイベントは出しません）。
// 出力はイベント6値 + Fib解除3値で、保持・期限・切替は POINT MASTER 側が行います。
// 全6TF対象。共通MTF基盤の各TFコンテキストで評価するため request.security は追加していません。
grpFib = "④ Logic21〜23 : Fib パラメータ"
fibAtrLen          = input.int(14,   "ATR期間",                          group = grpFib, minval = 1)
fibSwingLen        = input.int(6,    "スイング検出 左右本数 (Pivot Length)", group = grpFib, minval = 1)
fibMinSwingAtrMult = input.float(5.0, "最低波幅 (ATR倍)",                 group = grpFib, minval = 0.1, step = 0.1)
fibMinWaveBars     = input.int(12,   "最低波継続バー数",                  group = grpFib, minval = 1)
fibRequireBOS      = input.bool(true, "直近構造ブレイク(BOS)を要求",       group = grpFib)

// --- Logic21〜23 Fib のパラメータ束（input の値をそのまま格納。index = 下のコメント順）---
//     ロジック関数はここから array.get() で読むため、外部要素は この配列1個だけになります。
var array<float> PRM_FIB = array.from(
     fibMinSwingAtrMult,         // 00 : fibMinSwingAtrMult
     fibMinWaveBars * 1.0,       // 01 : fibMinWaveBars
     fibRequireBOS ? 1.0 : 0.0   // 02 : fibRequireBOS
 )

f_fibEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pFibMinSwingAtrMult     = array.get(PRM_FIB, 0)
    int   _pFibMinWaveBars         = int(array.get(PRM_FIB, 1))
    bool  _pFibRequireBOS          = array.get(PRM_FIB, 2) > 0.5
    float _atr = ta.atr(fibAtrLen)
    float _ph  = ta.pivothigh(high, fibSwingLen, fibSwingLen)
    float _pl  = ta.pivotlow(low,  fibSwingLen, fibSwingLen)
    float _minSwing = _atr * _pFibMinSwingAtrMult
    // 直近Pivot（価格 / bar）と1つ前Pivot価格（BOS判定用）
    var float _lastPHp = na
    var int   _lastPHb = na
    var float _prevPHp = na
    var float _lastPLp = na
    var int   _lastPLb = na
    var float _prevPLp = na
    // 現在採用中の波（起点固定・終点のみ更新）
    var int   _state      = 0
    var float _origin     = na
    var float _extreme    = na
    var int   _originBar  = na
    var int   _extremeBar = na
    bool _reversal = false
    // Pivot 更新（1つ前を退避してから最新を格納）
    if not na(_ph)
        _prevPHp := _lastPHp
        _lastPHp := _ph
        _lastPHb := bar_index - fibSwingLen
    if not na(_pl)
        _prevPLp := _lastPLp
        _lastPLp := _pl
        _lastPLb := bar_index - fibSwingLen
    // --- Bull波候補（新Pivot High確定 : 先行するPivot Low → 今回のPivot High = 上げ波）---
    if not na(_ph) and not na(_lastPLp) and _lastPLb < _lastPHb
        float _w    = _lastPHp - _lastPLp
        int   _bars = _lastPHb - _lastPLb
        bool _sizeOk = _w >= _minSwing and _bars >= _pFibMinWaveBars
        bool _bosUp  = na(_prevPHp) or _lastPHp > _prevPHp
        if _sizeOk
            if _state == -1
                // 方向反転 Bear→Bull: 上方向の構造ブレイクを必須
                if _bosUp
                    _state := 1
                    _origin := _lastPLp
                    _extreme := _lastPHp
                    _originBar := _lastPLb
                    _extremeBar := _lastPHb
                    _reversal := true
            else if _state == 0
                if not _pFibRequireBOS or _bosUp
                    _state := 1
                    _origin := _lastPLp
                    _extreme := _lastPHp
                    _originBar := _lastPLb
                    _extremeBar := _lastPHb
    // --- Bull継続中の終点(extreme)更新（origin固定・確定Pivot Highのみ・追加条件なし）---
    if _state == 1 and not na(_ph)
        if na(_extreme) or _lastPHp > _extreme
            _extreme := _lastPHp
            _extremeBar := _lastPHb
    // --- Bear波候補（新Pivot Low確定 : 先行するPivot High → 今回のPivot Low = 下げ波）---
    if not na(_pl) and not na(_lastPHp) and _lastPHb < _lastPLb
        float _w    = _lastPHp - _lastPLp
        int   _bars = _lastPLb - _lastPHb
        bool _sizeOk = _w >= _minSwing and _bars >= _pFibMinWaveBars
        bool _bosDn  = na(_prevPLp) or _lastPLp < _prevPLp
        if _sizeOk
            if _state == 1
                // 方向反転 Bull→Bear: 下方向の構造ブレイクを必須
                if _bosDn
                    _state := -1
                    _origin := _lastPHp
                    _extreme := _lastPLp
                    _originBar := _lastPHb
                    _extremeBar := _lastPLb
                    _reversal := true
            else if _state == 0
                if not _pFibRequireBOS or _bosDn
                    _state := -1
                    _origin := _lastPHp
                    _extreme := _lastPLp
                    _originBar := _lastPHb
                    _extremeBar := _lastPLb
    // --- Bear継続中の終点(extreme)更新（origin固定・確定Pivot Lowのみ・追加条件なし）---
    if _state == -1 and not na(_pl)
        if na(_extreme) or _lastPLp < _extreme
            _extreme := _lastPLp
            _extremeBar := _lastPLb
    // --- 起点の終値突破による即時反転（ヒゲ無視。旧extremeを新origin・突破足の高安を新extreme）---
    if not _reversal and _state == 1 and not na(_origin) and close < _origin
        _state := -1
        _origin := na(_extreme) ? _origin : _extreme
        _originBar := na(_extremeBar) ? _originBar : _extremeBar
        _extreme := low
        _extremeBar := bar_index
        _reversal := true
    else if not _reversal and _state == -1 and not na(_origin) and close > _origin
        _state := 1
        _origin := na(_extreme) ? _origin : _extreme
        _originBar := na(_extremeBar) ? _originBar : _extremeBar
        _extreme := high
        _extremeBar := bar_index
        _reversal := true

    // --- Wave ID（方向 + 起点バー + 起点価格）。終点更新だけでは変わらない ---
    var int   _wState     = 0
    var int   _wOriginBar = na
    var float _wOriginP   = na
    var int   _deep       = 0        // 最深到達 : 0=未到達 / 1=38.2 / 2=50 / 3=61.8 / 4=78.6
    var bool  _used382    = false
    var bool  _used500    = false
    var bool  _used618    = false
    bool _newWave = _state != _wState or nz(_originBar, -1) != nz(_wOriginBar, -1) or nz(_origin, -1e12) != nz(_wOriginP, -1e12)
    if _newWave
        _wState     := _state
        _wOriginBar := _originBar
        _wOriginP   := _origin
        _deep       := 0
        _used382    := false
        _used500    := false
        _used618    := false

    // --- Fib価格（現在の採用波から毎バー再計算）---
    bool _waveOk = _state != 0 and not na(_origin) and not na(_extreme) and _origin != _extreme
    float _f382 = _waveOk ? _extreme + 0.382 * (_origin - _extreme) : na
    float _f500 = _waveOk ? _extreme + 0.500 * (_origin - _extreme) : na
    float _f618 = _waveOk ? _extreme + 0.618 * (_origin - _extreme) : na
    float _f786 = _waveOk ? _extreme + 0.786 * (_origin - _extreme) : na

    // --- ① 到達判定（ヒゲ）→ 最深到達レベル更新 ---
    bool _t382 = _waveOk and (_state == 1 ? low <= _f382 : high >= _f382)
    bool _t500 = _waveOk and (_state == 1 ? low <= _f500 : high >= _f500)
    bool _t618 = _waveOk and (_state == 1 ? low <= _f618 : high >= _f618)
    bool _t786 = _waveOk and (_state == 1 ? low <= _f786 : high >= _f786)
    int _newDeep = _t786 ? 4 : _t618 ? 3 : _t500 ? 2 : _t382 ? 1 : 0
    if _waveOk and _newDeep > _deep
        _deep := _newDeep

    // --- ② 浅いFibロジックの解除情報（深い到達で上位ロジックを解除）---
    bool _inv21 = _deep >= 2       // 50到達 → Logic21解除
    bool _inv22 = _deep >= 3       // 61.8到達 → Logic22も解除
    bool _inv23 = _deep >= 4       // 78.6到達 → Logic23も解除

    // --- ③ 最深レベルのRebound判定（終値回復・同一採用波につき各レベル1回）---
    float _lvlP  = _deep == 1 ? _f382 : _deep == 2 ? _f500 : _deep == 3 ? _f618 : na
    bool  _usedNow = _deep == 1 ? _used382 : _deep == 2 ? _used500 : _deep == 3 ? _used618 : true
    bool  _recovered = _waveOk and not na(_lvlP) and (_state == 1 ? close > _lvlP : close < _lvlP)
    bool  _fire = _waveOk and _deep >= 1 and _deep <= 3 and not _usedNow and _recovered
    if _fire
        if _deep == 1
            _used382 := true
        else if _deep == 2
            _used500 := true
        else
            _used618 := true
    // 上げ波は LONG のみ / 下げ波は SHORT のみ（同一足で複数Logicが発火することはない）
    bool _l21Long  = _fire and _deep == 1 and _state == 1
    bool _l21Short = _fire and _deep == 1 and _state == -1
    bool _l22Long  = _fire and _deep == 2 and _state == 1
    bool _l22Short = _fire and _deep == 2 and _state == -1
    bool _l23Long  = _fire and _deep == 3 and _state == 1
    bool _l23Short = _fire and _deep == 3 and _state == -1

    // --- ④ PRE（Phase B）: 最深到達レベルだけが終値回復待ちの間ON（最深レベル方式は変更なし）---
    //     Bull波 → PRE LONG / Bear波 → PRE SHORT。_deep==4 は全0。
    //     該当レベルが used 済み（CURRENT発火後を含む）なら0。浅いFibと深いFibを同時PREにしない。
    bool _pre21 = _waveOk and _deep == 1 and not _used382
    bool _pre22 = _waveOk and _deep == 2 and not _used500
    bool _pre23 = _waveOk and _deep == 3 and not _used618
    bool _l21PreLong  = _pre21 and _state == 1
    bool _l21PreShort = _pre21 and _state == -1
    bool _l22PreLong  = _pre22 and _state == 1
    bool _l22PreShort = _pre22 and _state == -1
    bool _l23PreLong  = _pre23 and _state == 1
    bool _l23PreShort = _pre23 and _state == -1
    [_l21Long, _l21Short, _l22Long, _l22Short, _l23Long, _l23Short, _inv21, _inv22, _inv23, _l21PreLong, _l21PreShort, _l22PreLong, _l22PreShort, _l23PreLong, _l23PreShort]

// -------------------------------------------------------------------------------------
// LONG / SHORT の bool 配列 → ビットマスク（Engine A / B / C 共通）
// -------------------------------------------------------------------------------------
// ビット位置は「そのEngine内での通し番号（0始まり）」です。
// Engine をまたぐ元のロジック番号への対応は §6 で行います。
f_packMasks(longs, shorts) =>
    float lm = 0.0
    float sm = 0.0
    for i = 0 to array.size(longs) - 1
        float bit = math.pow(2, i)
        lm += array.get(longs,  i) ? bit : 0.0
        sm += array.get(shorts, i) ? bit : 0.0
    [lm, sm]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic24 = SAT Band Bias（状態型ロジック）
// -------------------------------------------------------------------------------------
// 計算は「SAT BAND Reconstruction Test」の f_satBand() の計算コア（LINE1 / LINE2 / STB /
// Band State）と同一です。式・定数・State 更新順は一切変更していません。
// SAT単体版の request.security() / 独自MTF / アラート / plot / bgcolor / debug /
// GoldOnly / htfConfirmedOnly / 表示設定は移植していません。
//
//   basis    = ta.vwma(hlc3, 5)        common   = basis * 0.5
//   atr50    = ta.atr(50)[1]
//   src      = close[1] * 0.5          trigLow  = low[1] * 0.5     trigHigh = high[1] * 0.5
//   LINE1（k = 5.0）/ LINE2（k = 2.5）は同じ State 機械（初期 dir = +1）：
//     Bull(+1) 中： trigLow  < prevAnchor → Bear へ反転し anchor = src + k * atr50
//                   それ以外              → anchor = math.max(prevAnchor, src - k * atr50)
//     Bear(-1) 中： trigHigh > prevAnchor → Bull へ反転し anchor = src - k * atr50
//                   それ以外              → anchor = math.min(prevAnchor, src + k * atr50)
//     line = common + anchor
//     （同一バー内で更新済みの anchor / dir を判定に再利用しないよう prevAnchor / prevDir へ退避）
//   STB（Donchian。LINE1 / LINE2 とは独立）：
//     high > ta.highest(high, 20)[1] → stbDir = +1（上下同時突破も +1 優先）
//     low  < ta.lowest(low, 20)[1]   → stbDir = -1、どちらでもなければ維持（初期 +1）
//     stb = stbDir == +1 ? ta.lowest(low, 10) : ta.highest(high, 10)
//
//   Band State（dir1 / dir2 / stbDir は判定に使わず、価格と3本の位置関係だけで判定）：
//     close > LINE1 and close > LINE2 and close > STB → LONG 状態
//     close < LINE1 and close < LINE2 and close < STB → SHORT 状態
//     それ以外                                         → NONE
//
// ★このロジックだけ「イベント + 保持本数」ではなく状態型です。
//   §6 で ST_HOLD を使わず、そのTFの確定足ごとに現在のSAT状態を ST_STATE へ直接反映します
//   （フラットになった瞬間に NONE、反対状態になった瞬間に即切替。古い状態は一切残しません）。
// 全6TF対象。共通MTF基盤（Engine C）の各TFコンテキストで評価するため request.security は
// 追加していません。反映は既存どおり（1M = security_lower_tf / 5M〜1D = [1] + lookahead_on）。
// ※ SAT内部の close[1] / high[1] / low[1] / ta.atr(50)[1] はSAT本体の式であり、
//   POINT MASTER の HTF packet 側の [1] とは別物です（両方とも必要）。

// SAT BAND 本体（正本 f_satBand() の計算コア。戻り値 [line1, line2, stb, bandState]）
//   bandState は +1 = BLUE（LONG）/ -1 = RED（SHORT）/ 0 = フラット
f_satBand() =>
    // --- 共通 Basis（VWMA。source は hlc3、length は 5）---
    float _basis  = ta.vwma(hlc3, 5)
    float _common = _basis * 0.5

    // --- ATR（現在足ではなく 1 本前の値）---
    float _atr50 = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から）---
    float _src      = close[1] * 0.5
    float _trigLow  = low[1]   * 0.5
    float _trigHigh = high[1]  * 0.5

    bool _ready = not na(_atr50) and not na(_src) and not na(_trigLow) and not na(_trigHigh)

    // --- LINE1（k = 5.0）---
    float _k1 = 5.0
    var float _anchor1 = na
    var int   _dir1    = 1
    float _prevAnchor1 = _anchor1
    int   _prevDir1    = _dir1
    if _ready
        if na(_prevAnchor1)
            // 初期化：Bull から開始する
            _anchor1 := _src - _k1 * _atr50
            _dir1    := 1
        else if _prevDir1 == 1
            if _trigLow < _prevAnchor1
                // Bull → Bear
                _dir1    := -1
                _anchor1 := _src + _k1 * _atr50
            else
                _dir1    := 1
                _anchor1 := math.max(_prevAnchor1, _src - _k1 * _atr50)
        else
            if _trigHigh > _prevAnchor1
                // Bear → Bull
                _dir1    := 1
                _anchor1 := _src - _k1 * _atr50
            else
                _dir1    := -1
                _anchor1 := math.min(_prevAnchor1, _src + _k1 * _atr50)
    float _line1 = _common + _anchor1

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ）---
    float _k2 = 2.5
    var float _anchor2 = na
    var int   _dir2    = 1
    float _prevAnchor2 = _anchor2
    int   _prevDir2    = _dir2
    if _ready
        if na(_prevAnchor2)
            // 初期化：Bull から開始する
            _anchor2 := _src - _k2 * _atr50
            _dir2    := 1
        else if _prevDir2 == 1
            if _trigLow < _prevAnchor2
                // Bull → Bear
                _dir2    := -1
                _anchor2 := _src + _k2 * _atr50
            else
                _dir2    := 1
                _anchor2 := math.max(_prevAnchor2, _src - _k2 * _atr50)
        else
            if _trigHigh > _prevAnchor2
                // Bear → Bull
                _dir2    := 1
                _anchor2 := _src - _k2 * _atr50
            else
                _dir2    := -1
                _anchor2 := math.min(_prevAnchor2, _src + _k2 * _atr50)
    float _line2 = _common + _anchor2

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立）---
    float _stbUpper   = ta.highest(high, 10)
    float _stbLower   = ta.lowest(low, 10)
    float _prev20High = ta.highest(high, 20)[1]
    float _prev20Low  = ta.lowest(low, 20)[1]
    var int _stbDir = 1
    if not na(_prev20High) and not na(_prev20Low)
        if high > _prev20High
            _stbDir := 1
        else if low < _prev20Low
            _stbDir := -1
    // UP は下側（lower10）、DOWN は上側（upper10）
    float _stb = _stbDir == 1 ? _stbLower : _stbUpper

    // --- BLUE / RED / フラット（価格と3本の位置関係だけで判定）---
    int _state = 0
    if close > _line1 and close > _line2 and close > _stb
        _state := 1
    else if close < _line1 and close < _line2 and close < _stb
        _state := -1
    [_line1, _line2, _stb, _state]

// 現在の SAT Band Bias 状態（イベントではなく「今の状態」を返す）
//   PRE（Phase B）: SAT CURRENT 崩壊途中の fractional 反転圧力を satPreSigned（-2/3〜+2/3）で返す。
//     lastNonFlatSAT（0 = 未確定 / +1 = BLUE / -1 = RED）を各TFコンテキスト内で保持。
//     BLUE → FLAT : close < line の本数 1本 = PRE SHORT 1/3、2本 = 2/3（負値）
//     RED  → FLAT : close > line の本数 1本 = PRE LONG  1/3、2本 = 2/3（正値）
//     3本揃えば CURRENT（BLUE / RED）へ移行するので PRE = 0。
//     lastNonFlatSAT == 0 / ラインのどれかが na / CURRENT が BLUE・RED の時は 0。比較は strict（< / >）のみ。
f_satEvents() =>
    [_l1, _l2, _stb, _st] = f_satBand()
    bool _satLong  = _st == 1     // 3本すべてが価格より下
    bool _satShort = _st == -1    // 3本すべてが価格より上

    var int _lastNonFlat = 0
    if _st == 1
        _lastNonFlat := 1
    else if _st == -1
        _lastNonFlat := -1
    float _satPreSigned = 0.0
    bool  _linesOk = not na(_l1) and not na(_l2) and not na(_stb)
    if _st == 0 and _linesOk and _lastNonFlat != 0
        if _lastNonFlat == 1
            int _nBreak = (close < _l1 ? 1 : 0) + (close < _l2 ? 1 : 0) + (close < _stb ? 1 : 0)
            if _nBreak == 1 or _nBreak == 2
                _satPreSigned := -(_nBreak / 3.0)     // PRE SHORT
        else
            int _nBreak = (close > _l1 ? 1 : 0) + (close > _l2 ? 1 : 0) + (close > _stb ? 1 : 0)
            if _nBreak == 1 or _nBreak == 2
                _satPreSigned := _nBreak / 3.0        // PRE LONG
    [_satLong, _satShort, _satPreSigned]

// -------------------------------------------------------------------------------------
// SIGNAL MODULE : Logic25 = Stochastic Turn（イベント型）
// -------------------------------------------------------------------------------------
// %K は元コードと同じ ta.stoch(close, high, low, %K Length) → ta.sma(..., %K Smooth)、
// %D は ta.sma(%K, %D Length) で算出します。
//   ★ 判定に使うのは %K だけです（%D は将来の検証用に計算しているだけで判定には未使用）。
//   ★ K/D クロスは必須条件にしていません。
//
//   LONG  : %K が一度 Long Extreme(5) 以下へ到達 → Long待機状態
//           その後 %K が Long Turn(10) 以上になった最初の確定足で LONGイベント
//   SHORT : %K が一度 Short Extreme(95) 以上へ到達 → Short待機状態
//           その後 %K が Short Turn(90) 以下になった最初の確定足で SHORTイベント
//   ・「Extreme到達 → 折り返し」の順番が必須です（折り返し値に触れただけでは発生しません）。
//   ・イベント発生で待機状態を解除するため、同じExtreme到達から複数回は発生しません。
//     LONGは再び5以下へ、SHORTは再び95以上へ到達するまで再発生しません。
//   ・SAT Band のような常時状態型ではなくイベント型です。発生後は Logic01〜23 と同じ
//     保持本数システム（§3 の Logic25 保持本数 / §6 の f_applySignal）で保持します。
// 全6TF対象。共通MTF基盤（Engine C）の各TFコンテキストで評価するため request.security は
// 追加していません。反映は既存どおり [1] + lookahead_on の確定足ベースです。
grpStoch = "④ Logic25 : Stochastic Turn パラメータ"
stochKLen         = input.int(10,     "%K Length",  group = grpStoch, minval = 1)
stochKSmooth      = input.int(3,      "%K Smooth",  group = grpStoch, minval = 1)
stochDLen         = input.int(3,      "%D Length",  group = grpStoch, minval = 1)
stochLongExtreme  = input.float(5.0,  "Long Extreme (%K 到達ライン)",   group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochLongTurn     = input.float(10.0, "Long Turn (%K 折り返しライン)",  group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochShortExtreme = input.float(95.0, "Short Extreme (%K 到達ライン)",  group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)
stochShortTurn    = input.float(90.0, "Short Turn (%K 折り返しライン)", group = grpStoch, minval = 0.0, maxval = 100.0, step = 1.0)

// --- Logic25 Stochastic Turn のパラメータ束（%K/%D の期間は ta.* の simple 制約のため直接参照）---
var array<float> PRM_STOCH = array.from(
     stochLongExtreme,   // 00 : stochLongExtreme
     stochLongTurn,      // 01 : stochLongTurn
     stochShortExtreme,  // 02 : stochShortExtreme
     stochShortTurn      // 03 : stochShortTurn
 )

f_stochTurnEvents() =>
    // --- パラメータ読み出し（PRM束。値は input と同一）---
    float _pLongExtreme  = array.get(PRM_STOCH, 0)
    float _pLongTurn     = array.get(PRM_STOCH, 1)
    float _pShortExtreme = array.get(PRM_STOCH, 2)
    float _pShortTurn    = array.get(PRM_STOCH, 3)
    float _rawK = ta.stoch(close, high, low, stochKLen)
    float _k    = ta.sma(_rawK, stochKSmooth)
    float _d    = ta.sma(_k, stochDLen)      // 将来の検証用（LONG/SHORT判定には未使用）
    // Extreme到達で待機状態にする（順番の担保）
    var bool _longArmed  = false
    var bool _shortArmed = false
    if _k <= _pLongExtreme
        _longArmed := true
    if _k >= _pShortExtreme
        _shortArmed := true
    // 待機中に折り返しラインへ到達した最初の確定足でイベント（同じ到達から1回だけ）
    bool _long  = _longArmed  and _k >= _pLongTurn
    bool _short = _shortArmed and _k <= _pShortTurn
    if _long
        _longArmed := false      // 再び Long Extreme へ到達するまで再発生しない
    if _short
        _shortArmed := false     // 再び Short Extreme へ到達するまで再発生しない
    // PRE（Phase B）: Extreme到達済みで Turn 待ちの Armed 状態。
    //   CURRENT判定後に Armed を落とした値を返すため、CURRENT と同方向PREが同じ足に残ることはない。
    bool _stochPreLong  = _longArmed
    bool _stochPreShort = _shortArmed
    [_long, _short, _stochPreLong, _stochPreShort]

// =====================================================================================
// Engine C : Logic19〜25（Horizontal / Fib / SAT Band / Stoch）※Fib の解除マスクはこのEngineが返す
// =====================================================================================
f_signalMasksC() =>
    // -------------------------------------------------------------------------------
    // ▼▼▼ ここから：Engine C のロジック判定 ▼▼▼
    // -------------------------------------------------------------------------------
    // Logic19 : Horizontal Rebound / Logic20 : Horizontal Break
    // （前日H/L + セッションH/L を統合した同じ水平ゾーン状態から、独立した2ロジック分を取得）
    [l19Long, l19Short, l20Long, l20Short, x19L, x19S, x20L, x20S] = f_horizontalEvents()

    // Logic21〜23 : Fib 38.2 / 50.0 / 61.8 Rebound
    // （採用波1セットから3ロジック分のイベント + Fibグループ専用の解除情報を取得）
    [l21Long, l21Short, l22Long, l22Short, l23Long, l23Short, fibInv21, fibInv22, fibInv23, l21PreLong, l21PreShort, l22PreLong, l22PreShort, l23PreLong, l23PreShort] = f_fibEvents()

    // Logic24 : SAT Band Bias（状態型。イベントではなく現在のBias状態をビットで返す）
    [l24Long, l24Short, satPreSigned] = f_satEvents()

    // Logic25 : Stochastic Turn（%K の Extreme到達 → 折り返しイベント。保持は POINT MASTER 側）
    [l25Long, l25Short, l25PreLong, l25PreShort] = f_stochTurnEvents()

    // ★Engine C へロジックを追加する時はここに定義し、下の array.from と ENG_C_N を更新する
    // -------------------------------------------------------------------------------
    // ▲▲▲ ここまで（Engine C）▲▲▲
    // -------------------------------------------------------------------------------
    // Engine C 内のビット順（0始まり）= Logic19, 20, 21, 22, 23, 24, 25
    longsC  = array.from(l19Long,  l20Long,  l21Long,  l22Long,  l23Long,  l24Long,  l25Long)
    shortsC = array.from(l19Short, l20Short, l21Short, l22Short, l23Short, l24Short, l25Short)
    [lmC, smC] = f_packMasks(longsC, shortsC)

    // 解除ビットマスク（Fibグループ専用。Engine C 内のビット位置で立てる）
    //   Engine C index 2 = Logic21 / 3 = Logic22 / 4 = Logic23
    float imC = 0.0
    imC += fibInv21 ? math.pow(2, 2) : 0.0
    imC += fibInv22 ? math.pow(2, 3) : 0.0
    imC += fibInv23 ? math.pow(2, 4) : 0.0

    // PRE ビットマスク（Phase B）。Logic19 / 20 は PRE 対象外なので常に 0。
    // Logic24 SAT は fractional のためビットに入れず（常に 0）、satPreSigned で別に返す。
    preLongsC  = array.from(false, false, l21PreLong,  l22PreLong,  l23PreLong,  false, l25PreLong)
    preShortsC = array.from(false, false, l21PreShort, l22PreShort, l23PreShort, false, l25PreShort)
    [preLmC, preSmC] = f_packMasks(preLongsC, preShortsC)
    // ★V2 追加出力（判定には使わない）: Logic19 / 20 の否定ライン（成立時の値）
    [lmC, smC, imC, preLmC, preSmC, satPreSigned, close, high, low, x19L, x19S, x20L, x20S]

// ビットマスクから「ロジック番号 idx」のフラグを取り出す
f_bitOn(mask, idx) =>
    na(mask) ? false : math.floor(mask / math.pow(2, idx)) % 2 > 0.5
// =====================================================================================
// §5. 5M / 15M 取得（元版の非リペイント方式のまま。1M の取得は持たない）
// =====================================================================================
// request.security(..., <式>[1], lookahead = barmerge.lookahead_on)（直近の確定足。[1] は必須）
// V2 用の追加出力（この TF 足の close 等・否定ライン）は 1 個の UDT にまとめて返す。
// request 呼び出し 2 本、タプル要素 8 × 2 = 16 個。
type SRCCX
    float f0 = na
    float f1 = na
    float f2 = na
    float f3 = na
    float f4 = na
    float f5 = na
    float f6 = na

f_srcArr(SRCCX o) =>
    SRCCX q = na(o) ? SRCCX.new() : o
    array.from(q.f0, q.f1, q.f2, q.f3, q.f4, q.f5, q.f6)

f_htfPacket() =>
    [lmRaw, smRaw, imRaw, plmRaw, psmRaw, spRaw, xC, xH, xL, x19L, x19S, x20L, x20S] = f_signalMasksC()
    float lm  = nz(lmRaw)
    float sm  = nz(smRaw)
    float im  = nz(imRaw)
    float plm = nz(plmRaw)
    float psm = nz(psmRaw)
    float sp  = nz(spRaw)
    int   tt  = time
    [lm[1], sm[1], im[1], plm[1], psm[1], sp[1], tt[1], SRCCX.new(xC[1], xH[1], xL[1], x19L[1], x19S[1], x20L[1], x20S[1])]   // ★[1] は必須

[lm5, sm5, im5, plm5, psm5, sp5, tt5, ox5]               = request.security(syminfo.tickerid, tfStr2, f_htfPacket(), lookahead = barmerge.lookahead_on)
[lm15, sm15, im15, plm15, psm15, sp15, tt15, ox15]       = request.security(syminfo.tickerid, tfStr3, f_htfPacket(), lookahead = barmerge.lookahead_on)


// =====================================================================================
// §6. V2 有効根拠（ロジック × TF × 方向）と抑止前 PRE（1 分足あり版と同じ扱い。TF は 5M / 15M の 2 枠）
// =====================================================================================
// 生シグナル成立時に登録し、元版の保持本数（期限）と価格否定（その TF の確定終値）の早い方で解除。
// 同方向の新シグナルで再登録、同じロジック × TF で反対方向の新シグナルが出たら切替で解除。
// 同一足で両方向が出た場合の裁定は元版の「状態管理ルール」と同じ。
// 否定ルール（V2_RULE）: 0 ライン（成立時の値 + 傾き × 経過本数）/ 1 EMA 現在値 / 2 Fib 継承（価格ラインなし）/
//                         3 状態型（SAT）/ 4 成立足の安値・高値（Stoch）
// PRE は抑止前の State Factor（0 / 1、SAT のみ 0 / 1/3 / 2/3）を、その TF の確定足ごとに上書き（保持なし）。
// 内部 index : ti 0 = 5M / 1 = 15M（BUS の TF ID は 5M = 1 / 15M = 2 で別物）
var LAST_TFTIME = array.new_int(N_TF, 0)
var V2_RULE  = array.from(0, 0, 2, 2, 2, 3, 4)
// B の系統点へ採用するか（ロジック × TF。index = f_idx(li, ti)）。採用 OFF は確認済み点・統合点（PRE 含む）・寄与系統数・
// 価格否定フラグ・価格基準なしから外す。検知・保持・価格否定の計算そのものは変えない（単体診断の生シグナルは採用前）。
adoptModeStr = input.string("全て採用", "B の系統点へ採用するロジック", options = ["全て採用", "カスタム（下のチェック）"], group = "⑧ 採用設定（実験用。初期値 = 全て採用）",
     tooltip = "全て採用 = 変更前と同じ。カスタムでは下のチェックを外したロジック × 時間足を、B の確認済み点・統合点・寄与系統数・価格否定・価格基準なしから外します（検知と保持は変えません）。")
bool adoptAll = adoptModeStr == "全て採用"
ad0m5  = input.bool(true, "Logic19 Horiz Reb 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad0")
ad0m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad0")
ad1m5  = input.bool(true, "Logic20 Horiz Brk 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad1")
ad1m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad1")
ad2m5  = input.bool(true, "Logic21 Fib382 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad2")
ad2m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad2")
ad3m5  = input.bool(true, "Logic22 Fib500 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad3")
ad3m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad3")
ad4m5  = input.bool(true, "Logic23 Fib618 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad4")
ad4m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad4")
ad5m5  = input.bool(true, "Logic24 SAT 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad5")
ad5m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad5")
ad6m5  = input.bool(true, "Logic25 Stoch 5M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad6")
ad6m15 = input.bool(true, "15M", group = "⑧ 採用設定（実験用。初期値 = 全て採用）", inline = "ad6")
V2_ADOPT = array.from(adoptAll or ad0m5, adoptAll or ad0m15, adoptAll or ad1m5, adoptAll or ad1m15, adoptAll or ad2m5, adoptAll or ad2m15, adoptAll or ad3m5, adoptAll or ad3m15, adoptAll or ad4m5, adoptAll or ad4m15, adoptAll or ad5m5, adoptAll or ad5m15, adoptAll or ad6m5, adoptAll or ad6m15)
var V2_VALID = array.new_bool(N_LOGIC * N_TF * 2, false)   // index = f_idx(li, ti) × 2 + (0 LONG / 1 SHORT)
var V2_PRICE = array.new_bool(N_LOGIC * N_TF * 2, false)
var V2_REM   = array.new_int(N_LOGIC * N_TF * 2, 0)
var V2_AGE   = array.new_int(N_LOGIC * N_TF * 2, 0)
var V2_LVL   = array.new_float(N_LOGIC * N_TF * 2, na)
var V2_SLP   = array.new_float(N_LOGIC * N_TF * 2, 0.0)
var V2_PRE   = array.new_float(N_LOGIC * N_TF * 2, 0.0)     // 抑止前 PRE State Factor
var V2_NEG   = array.new_int(N_TF * 2, 0)
var V2_WARM  = array.new_int(N_TF, 0)
var V2_BADX  = array.new_bool(N_TF, false)
// 単体診断（Logic Verifier 用。通常 BUS・判定には使わない。下の f_v2ApplyTf の中で既存の値を記録するだけ）
var V2_RAW    = array.new_bool(N_LOGIC * N_TF * 2, false)   // その TF 足の生シグナル（裁定・採用設定の前）
var V2_NEGF   = array.new_bool(N_LOGIC * N_TF * 2, false)   // その TF 足で価格否定により解除
var V2_EXPF   = array.new_bool(N_LOGIC * N_TF * 2, false)   // その TF 足で期限切れにより解除
var V2_SINCE  = array.new_int(N_LOGIC * N_TF * 2, -1)       // 最後の生シグナルからのその TF の本数（-1 = 未発生）
var V2_NEWBAR = array.new_bool(N_TF, false)                 // この 5 分足の間にその TF の新しい確定足を処理した

f_v2ApplyTf(int ti, float lm, float sm, float plm, float psm, float im, float sp, array<float> x) =>
    float tc = array.get(x, 0)
    array.set(V2_WARM, ti, array.get(V2_WARM, ti) + 1)
    array.set(V2_BADX, ti, array.get(V2_BADX, ti) or na(tc))
    array.set(V2_NEWBAR, ti, true)
    for li = 0 to N_LOGIC - 1
        int  k      = f_idx(li, ti)
        int  rule   = array.get(V2_RULE, li)
        bool isSt   = rule == 3
        int  ei     = 0
        bool rawL   = f_bitOn(lm, li)
        bool rawS   = f_bitOn(sm, li)
        bool both   = rawL and rawS
        bool sigL   = both ? conflictMode == CONF_LONG  : rawL
        bool sigS   = both ? conflictMode == CONF_SHORT : rawS
        bool fibInv = li >= 2 and li <= 4 and f_bitOn(im, li)
        float emaNow = array.get(x, ei)
        for d = 0 to 1
            int   j     = k * 2 + d
            bool  reg   = d == 0 ? sigL : sigS
            bool  opp   = d == 0 ? sigS : sigL
            bool  vld   = array.get(V2_VALID, j)
            bool  aging = vld and not isSt
            int   age1  = array.get(V2_AGE, j) + (aging ? 1 : 0)
            int   rem1  = array.get(V2_REM, j) - (aging ? 1 : 0)
            float lv    = rule == 1 ? emaNow : array.get(V2_LVL, j) + array.get(V2_SLP, j) * age1
            bool  negd  = aging and rem1 > 0 and rule != 2 and array.get(V2_PRICE, j) and not na(lv) and not na(tc) and (d == 0 ? tc < lv : tc > lv)
            bool  alive = vld and rem1 > 0 and not negd
            float lvN   = li <= 1 ? array.get(x, 3 + math.min(math.max(li, 0), 1) * 2 + d) : li == 6 ? (d == 0 ? array.get(x, 2) : array.get(x, 1)) : float(na)
            float slN   = 0.0
            bool  pOk   = rule == 2 or (rule == 1 ? not na(emaNow) : not na(lvN))
            bool  regNew = reg and not isSt
            array.set(V2_VALID, j, (isSt ? reg : (reg ? true : opp ? false : alive)) and not fibInv)
            array.set(V2_PRICE, j, isSt ? true : regNew ? pOk : array.get(V2_PRICE, j))
            array.set(V2_REM,   j, regNew ? array.get(HOLD_ALL, k) : rem1)
            array.set(V2_AGE,   j, regNew ? 0 : age1)
            array.set(V2_LVL,   j, regNew ? lvN : array.get(V2_LVL, j))
            array.set(V2_SLP,   j, regNew ? slN : array.get(V2_SLP, j))
            array.set(V2_NEG,   ti * 2 + d, array.get(V2_NEG, ti * 2 + d) + (negd and array.get(V2_ADOPT, k) ? 1 : 0))
            // 抑止前 PRE（その TF の確定足1本ぶんの現在値で上書き）
            array.set(V2_PRE, j, li == 5 ? (d == 0 ? math.max(sp, 0.0) : math.max(-sp, 0.0)) : d == 0 ? (f_bitOn(plm, li) ? 1.0 : 0.0) : (f_bitOn(psm, li) ? 1.0 : 0.0))
            // 単体診断（上で計算済みの値を記録するだけ）
            bool  raw   = d == 0 ? rawL : rawS
            int   since = array.get(V2_SINCE, j)
            array.set(V2_RAW,   j, raw)
            array.set(V2_NEGF,  j, negd)
            array.set(V2_EXPF,  j, aging and rem1 <= 0 and not reg)
            array.set(V2_SINCE, j, raw ? 0 : since < 0 ? -1 : since + 1)
    N_LOGIC

// 5M / 15M : その TF の確定足が新しくなった瞬間だけ更新（1 分足あり版と同じタイミング）
int t5  = nz(tt5)
int t15 = nz(tt15)
if t5 > array.get(LAST_TFTIME, 0)
    array.set(LAST_TFTIME, 0, t5)
    f_v2ApplyTf(0, nz(lm5), nz(sm5), nz(plm5), nz(psm5), nz(im5), nz(sp5), f_srcArr(ox5))
if t15 > array.get(LAST_TFTIME, 1)
    array.set(LAST_TFTIME, 1, t15)
    f_v2ApplyTf(1, nz(lm15), nz(sm15), nz(plm15), nz(psm15), nz(im15), nz(sp15), f_srcArr(ox15))


// =====================================================================================
// §7. データ準備 / 更新整合（5M / 15M のみ）と BUS 出力
// =====================================================================================
//   5M / 15M : 受信した確定足の開始時刻（tt[1]）が「この足の TF 区間の直前に足が存在した区間」と一致すること
//              （休場・週末は直前に足が存在した区間と比べるので不整合にしない）
//   値 : 処理した TF 足の確定終値が na なら不整合 / 準備 : 不整合なしで各 TF の処理本数 >= その TF の最大保持本数
//   1M は取得しないので、1M の準備は待たない。
bool isChart5M = timeframe.isminutes and timeframe.multiplier == 5
var int bk5Cur   = na
var int bk5Prev  = na
var int bk15Cur  = na
var int bk15Prev = na
int bk5  = time - time % 300000
int bk15 = time - time % 900000
bk5Prev  := na(bk5Cur)  or bk5  != bk5Cur  ? bk5Cur  : bk5Prev
bk5Cur   := bk5
bk15Prev := na(bk15Cur) or bk15 != bk15Cur ? bk15Cur : bk15Prev
bk15Cur  := bk15

f_maxHold(int ti) =>
    int mx = 1
    for li = 0 to N_LOGIC - 1
        mx := math.max(mx, array.get(HOLD_ALL, f_idx(li, ti)))
    mx

bool t5Miss  = t5 == 0 or na(bk5Prev)
bool t15Miss = t15 == 0 or na(bk15Prev)
bool t5Bad   = not t5Miss  and t5  != bk5Prev
bool t15Bad  = not t15Miss and t15 != bk15Prev
bool valBad  = array.get(V2_BADX, 0) or array.get(V2_BADX, 1)
var int need5  = f_maxHold(0)
var int need15 = f_maxHold(1)
bool srcBad  = t5Bad or t15Bad or valBad
bool srcWarm = array.get(V2_WARM, 0) >= need5 and array.get(V2_WARM, 1) >= need15
// STATUS : 0 出力中 / 1 データ準備中 / 3 5分足以外 / 4 更新不整合
int srcStatusNow = not isChart5M ? 3 : srcBad ? 4 : (t5Miss or t15Miss or not srcWarm) ? 1 : 0

// 系統ごとの点（TF ti）: [LONG 確認済み 0/1, LONG 統合 ×3（0〜3）, SHORT 確認済み, SHORT 統合 ×3]
f_famPts(int ti, int li0, int li1) =>
    bool  cL = false
    bool  cS = false
    float iL = 0.0
    float iS = 0.0
    for li = li0 to li1
        int  j  = f_idx(li, ti) * 2
        bool ad = array.get(V2_ADOPT, f_idx(li, ti))      // 採用 OFF は CURRENT も PRE も入れない
        bool vL = ad and array.get(V2_VALID, j)     and array.get(V2_PRICE, j)
        bool vS = ad and array.get(V2_VALID, j + 1) and array.get(V2_PRICE, j + 1)
        cL := cL or vL
        cS := cS or vS
        iL := math.max(iL, math.max(vL ? 1.0 : 0.0, ad ? array.get(V2_PRE, j)     : 0.0))
        iS := math.max(iS, math.max(vS ? 1.0 : 0.0, ad ? array.get(V2_PRE, j + 1) : 0.0))
    [cL ? 1 : 0, int(math.round(iL * 3)), cS ? 1 : 0, int(math.round(iS * 3))]

f_fam1(int ti, int li0, int li1, int off) =>
    [cL, qL, cS, qS] = f_famPts(ti, li0, li1)
    (cL + 2 * (qL >= 3 ? 1 : 0) + 4 * cS + 8 * (qS >= 3 ? 1 : 0)) * math.pow(2, off)

f_unpriced(int ti) =>
    bool u = false
    for li = 0 to N_LOGIC - 1
        int j = f_idx(li, ti) * 2
        u := u or (array.get(V2_ADOPT, f_idx(li, ti)) and ((array.get(V2_VALID, j) and not array.get(V2_PRICE, j)) or (array.get(V2_VALID, j + 1) and not array.get(V2_PRICE, j + 1))))
    u

// SAT 系統（Logic24 のみ）: bit 11 LONG 確認 / 12-13 LONG 統合 0〜3 / 14 SHORT 確認 / 15-16 SHORT 統合 0〜3
f_satBits(int ti) =>
    [cL, qL, cS, qS] = f_famPts(ti, 5, 5)
    (cL + 2 * qL + 8 * cS + 16 * qS) * math.pow(2, 11)

f_payload(int ti) =>
    float base = (array.get(V2_NEG, ti * 2) > 0 ? 1 : 0) + (array.get(V2_NEG, ti * 2 + 1) > 0 ? 2 : 0) + (f_unpriced(ti) ? 4 : 0)
    base + f_fam1(ti, 0, 1, 3) + f_fam1(ti, 2, 4, 7) + f_satBits(ti) + f_fam1(ti, 6, 6, 17)

int   BUS_BASE   = 1577836800000          // 2020-01-01 00:00 UTC
float BUS_SLOTS  = 4194304.0              // 2^22
int   BUS_FORMAT = 2                      // 5分・15分専用版（1 分足あり版は 1）
f_bus(int tfId, float payload, int tclose) =>
    float slot = (tclose - BUS_BASE) / 300000.0
    bool  ok   = slot >= 0 and slot < BUS_SLOTS and slot == math.floor(slot) and payload >= 0 and payload < 2097152
    ok ? BUS_FORMAT + 4 * 3 + 16 * tfId + 64 * slot + 268435456.0 * payload : na

// ---- 単体診断 BUS（STUDY DATA BUS / STUDY META BUS）-------------------------------------
// 選んだ 1 ロジック × 1 TF の、既に計算済みの値を 5 分足の確定時点で整数へ詰める（検知関数・request は呼び直さない）。
// STUDY META BUS（非負整数 < 2^37）
//   bit 0-1 format = 1 / bit 2-3 SourceID（1 A / 2 B / 3 C）/ bit 4-5 TFID（1 = 5M / 2 = 15M）/
//   bit 6-10 ロジック番号（1〜25。元版の Logic 番号）/ bit 11-13 状態（0 出力中 / 1 データ準備中 / 4 更新不整合 / 6 対象外）/
//   bit 14 採用（1 = B の系統点へ採用中）/ bit 15-36 slot（= 通常 BUS と同じ。2020-01-01 00:05〜2059-11-23 頃の 5 分足）
//   slot が範囲外の足、5 分足以外のチャートでは na。状態が 0 以外でも META は出す（DATA は na）。
// STUDY DATA BUS（非負整数 < 2^51。META の状態 0 の足だけ出す）
//   bit 0 / 1  : 生シグナル LONG / SHORT（その TF の新しい確定足で検知関数が発火。裁定・採用の前）
//   bit 2 / 3  : 有効な CURRENT LONG / SHORT（価格否定・期限・裁定・採用設定を適用した後）
//   bit 4-5 / 6-7 : 抑止前 PRE 強度 LONG / SHORT（0〜3 = 0 / 1/3 / 2/3 / 1。丸めなし）
//   bit 8 / 9  : 価格否定による解除 LONG / SHORT（その TF 足）
//   bit 10 / 11: 期限切れによる解除 LONG / SHORT（その TF 足。同じ足で同方向に再登録された場合は含めない）
//   bit 12-17 / 18-23 : 最後の生シグナルからのその TF の本数 LONG / SHORT（0〜61、62 = 62 本以上、63 = 未発生）
//   bit 24-29 / 30-35 : 有効根拠の経過本数 LONG / SHORT（最後の登録 = 同方向の新シグナルによる期限更新から数え直し。
//                       0〜61、62 = 62 本以上、63 = 有効根拠なし。状態型 SAT は生シグナルからの本数）
//   bit 36     : この 5 分足の間に、その TF の新しい確定足を処理した（0 のときは bit 0/1/8〜11 は 0）
//   bit 37-50  : slot の下位 14 bit（META と同じ 5 分足であることの照合用）
studyLogicStr = input.string("Logic19 Horiz Reb", "診断対象ロジック", options = ["Logic19 Horiz Reb", "Logic20 Horiz Brk", "Logic21 Fib382", "Logic22 Fib500", "Logic23 Fib618", "Logic24 SAT", "Logic25 Stoch"], group = "⑨ 単体診断（Logic Verifier 用。通常 BUS・判定には影響しない）")
studyTfStr    = input.string("5M", "診断対象の時間足", options = ["5M", "15M"], group = "⑨ 単体診断（Logic Verifier 用。通常 BUS・判定には影響しない）")
var LABELS = array.from("Logic19 Horiz Reb", "Logic20 Horiz Brk", "Logic21 Fib382", "Logic22 Fib500", "Logic23 Fib618", "Logic24 SAT", "Logic25 Stoch")
int  STUDY_LI = array.indexof(LABELS, studyLogicStr)
int  STUDY_TI = studyTfStr == "5M" ? 0 : 1
// 元々その TF が対象外の組合せ（EMA ロジックの 15M など）は「対象外」。検知対象は増やさない
bool STUDY_NA = false

f_cap6(int v) =>
    v < 0 ? 63 : v >= 62 ? 62 : v

f_study(int status, int tclose) =>
    float slot = (tclose - BUS_BASE) / 300000.0
    bool  sOk  = slot >= 0 and slot < BUS_SLOTS and slot == math.floor(slot)
    int   st   = STUDY_NA ? 6 : status
    int   j    = f_idx(STUDY_LI, STUDY_TI) * 2
    bool  nb   = array.get(V2_NEWBAR, STUDY_TI)
    bool  ad   = array.get(V2_ADOPT, f_idx(STUDY_LI, STUDY_TI))
    bool  cL   = ad and array.get(V2_VALID, j)     and array.get(V2_PRICE, j)
    bool  cS   = ad and array.get(V2_VALID, j + 1) and array.get(V2_PRICE, j + 1)
    bool  isSt = array.get(V2_RULE, STUDY_LI) == 3
    int   ageL = cL ? (isSt ? array.get(V2_SINCE, j)     : array.get(V2_AGE, j))     : -1
    int   ageS = cS ? (isSt ? array.get(V2_SINCE, j + 1) : array.get(V2_AGE, j + 1)) : -1
    float data = (nb and array.get(V2_RAW, j) ? 1 : 0) + (nb and array.get(V2_RAW, j + 1) ? 2 : 0) + (cL ? 4 : 0) + (cS ? 8 : 0) +
         16 * math.round(array.get(V2_PRE, j) * 3) + 64 * math.round(array.get(V2_PRE, j + 1) * 3) +
         (nb and array.get(V2_NEGF, j) ? 256 : 0) + (nb and array.get(V2_NEGF, j + 1) ? 512 : 0) +
         (nb and array.get(V2_EXPF, j) ? 1024 : 0) + (nb and array.get(V2_EXPF, j + 1) ? 2048 : 0) +
         4096.0 * f_cap6(array.get(V2_SINCE, j)) + 262144.0 * f_cap6(array.get(V2_SINCE, j + 1)) +
         16777216.0 * f_cap6(ageL) + 1073741824.0 * f_cap6(ageS) + (nb ? 68719476736.0 : 0) +
         137438953472.0 * (slot % 16384)
    float meta = 1 + 4 * 3 + 16 * (STUDY_TI + 1) + 64 * (18 + STUDY_LI + 1) + 2048 * st + 16384 * (ad ? 1 : 0) + 32768.0 * slot
    [sOk and st == 0 ? data : na, sOk ? meta : na]

var float studyData = na
var float studyMeta = na
var float bus5  = na
var float bus15 = na
var int   srcLastBar = 0
var int   srcStatus  = 1
if isChart5M and barstate.isconfirmed and time > srcLastBar
    srcLastBar := time
    srcStatus  := srcStatusNow
    array.set(V2_WARM, 0, t5Bad  or t5Miss  or array.get(V2_BADX, 0) ? 0 : array.get(V2_WARM, 0))
    array.set(V2_WARM, 1, t15Bad or t15Miss or array.get(V2_BADX, 1) ? 0 : array.get(V2_WARM, 1))
    // BUS の TF ID は 5M = 1 / 15M = 2（内部 index 0 / 1 とは別）
    bus5  := srcStatusNow == 0 ? f_bus(1, f_payload(0), time_close) : na
    bus15 := srcStatusNow == 0 ? f_bus(2, f_payload(1), time_close) : na
    [sData, sMeta] = f_study(srcStatusNow, time_close)
    studyData := sData
    studyMeta := sMeta
    array.fill(V2_NEG, 0)
    array.fill(V2_BADX, false)
    array.fill(V2_NEWBAR, false)

plot(isChart5M ? bus5  : na, "C 5M BUS",  display = display.data_window)
plot(isChart5M ? bus15 : na, "C 15M BUS", display = display.data_window)
plot(isChart5M ? srcStatus : 3, "C STATUS", display = display.data_window)
plot(isChart5M ? studyData : na, "STUDY DATA BUS", display = display.data_window)
plot(isChart5M ? studyMeta : na, "STUDY META BUS", display = display.data_window)

// ---- 設定の記録（採用 / 保持本数の比較結果と一緒に控える用。計算には影響しない）-------------------
// 保持本数の比較は既存の「③ 保持本数」input を 1 ロジック × 1 TF ずつ変えて、履歴再計算で 1 設定ずつ行う
// （複数候補を同時に計算しない）。本数はその TF 自身の本数（5M の 3 本と 15M の 3 本は同じ経過時間ではない）。
// 保持本数を変えると準備本数（最大保持本数）も変わる場合があるので、比較は同じ集計期間に揃える。
recShow = input.bool(false, "設定の記録を表示", group = "⑩ 設定の記録（結果と一緒に控える用）")
recPos  = input.string(position.top_left, "表示位置", options = [position.top_left, position.middle_left, position.bottom_left, position.top_center, position.bottom_center], group = "⑩ 設定の記録（結果と一緒に控える用）")
var recTbl = table.new(recPos, 1, 4, border_width = 1)
if barstate.islast
    table.clear(recTbl, 0, 0, 0, 3)
    if recShow
        string offTxt  = ""
        string holdTxt = ""
        for li = 0 to N_LOGIC - 1
            for ti = 0 to N_TF - 1
                int  k   = f_idx(li, ti)
                bool app = not (false)
                string nm = array.get(LABELS, li) + (ti == 0 ? " 5M" : " 15M")
                offTxt  += app and not array.get(V2_ADOPT, k) ? (offTxt == "" ? "" : ", ") + nm : ""
                holdTxt += app and array.get(V2_RULE, li) != 3 and array.get(HOLD_ALL, k) != (ti == 0 ? 6 : 4) ? (holdTxt == "" ? "" : ", ") + nm + "=" + str.tostring(array.get(HOLD_ALL, k)) : ""
        table.cell(recTbl, 0, 0, "PM-C-515 設定（比較元 0e56963 の既定 : 全て採用 / 保持 5M 6・15M 4）", text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)
        table.cell(recTbl, 0, 1, "採用 : " + (adoptAll ? "全て採用" : "カスタム / OFF = " + (offTxt == "" ? "なし" : offTxt)), text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)
        table.cell(recTbl, 0, 2, "保持本数（既定と異なるもの）: " + (holdTxt == "" ? "なし" : holdTxt), text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)
        table.cell(recTbl, 0, 3, "単体診断 : " + studyLogicStr + " " + studyTfStr + "（状態型 SAT は保持本数を使わない）", text_color = color.white, bgcolor = color.new(#1e222d, 20), text_size = size.small)


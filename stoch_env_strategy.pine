//
// ============================================================
//  Stochastic 環境認識ストラテジー (Stochastic Multi-Timeframe Environment)
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing) + 任意トリガー
//  ・環境認識     : 従来のEMAトレンド認識(EMAスコア) + Stochastic環境認識(折り返し) を結合
//  ・場所条件     : WinZone(FVG/出来高/フィボ/EMA/水平線/トレンドライン/BB/H&S/…) は全て不使用
//  ・その他       : ボラフィルタ / リスク管理 / 時間帯フィルタ / Accumulation NoTrade を維持
//  ・FVG環境認識 / EMA環境認識(50/200/1000) は削除済み
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "Stoch Env Strategy",
     shorttitle        = "STOCHENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 200
 )

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 1分足トリガー検知 (OFF で request.security_lower_tf を呼ばない)
//   現在の5分足に含まれる確定済み1分足を配列で取得し、各1分足内で結合判定する。
//   結合(Any/All/MinCount)は各1分足内で完結 → 異なる1分足の条件を合算しない。
useLowerTFTrigger = input.bool(true, "1分足トリガーを使う")
triggerTF         = input.timeframe("1", "トリガー時間足")

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)




// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(true, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

useTrendEnv = input.bool(true, "トレンド環境認識(EMAスコア)を使う (重い/OFFで軽量)")

reqTrend4H  = input.string("レンジ", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("レンジ", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("レンジ", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
// --- ① SL方式 (可変・固定/パターンに加えATRを選択可) ---
grpVSL = "① SL方式 (可変)"
slMode    = input.string("固定", "SL方式", options = ["固定", "パターン", "ATR"], group = grpVSL)
slBuf     = input.float(0.0, "SL バッファ (価格) ※パターン時", group = grpVSL)
slFixed   = input.float(10, "固定SL幅 (価格) ※固定時", group = grpVSL)
slAtrLen  = input.int(14, "ATR SL 期間 ※ATR時", group = grpVSL)
slAtrMult = input.float(3.0, "ATR SL 倍率 ※ATR時", group = grpVSL)
// --- ② TP方式 (可変・RR / ATR) ---
grpVTP = "② TP方式 (可変)"
tpMode    = input.string("RR", "TP方式", options = ["RR", "ATR"], group = grpVTP)
rrRatio   = input.float(2.0, "リスクリワード比 (RR時)", group = grpVTP)
tpAtrLen  = input.int(14, "ATR TP 期間 ※ATR時", group = grpVTP)
tpAtrMult = input.float(6.0, "ATR TP 倍率 ※ATR時", group = grpVTP)
// --- 建値移動 (break-even) : 有利方向へ一定幅進んだらSLをエントリー価格へ (SLのみ更新・TP不変) ---
grpBE = "建値移動 (break-even)"
useBreakEven         = input.bool(false, "建値移動を使う", group = grpBE)
breakEvenTrigger     = input.float(10.0, "建値移動開始幅 ($)", step = 0.1, group = grpBE)
breakEvenTriggerMode = input.string("到達瞬間", "建値移動判定", options = ["到達瞬間", "確定足"], group = grpBE)
breakEvenShowStats   = input.bool(false, "建値: 勝ち/負け/引き分け 表示", group = grpBE)

// ============================================================
//  4h. 入力 : Stochastic 環境認識モジュール (折り返しのみ)
// ------------------------------------------------------------
//  EMA環境認識と同じ設計。ストキャスの「折り返し」だけを評価する。
//    ・K が 10以下へ到達 → 上向き折り返し = +2 (Long)
//    ・K が 90以上へ到達 → 下向き折り返し = +2 (Short)
//  張り付き評価・マイナス点は無し。到達履歴は EMA と同じ状態管理で保持。
//  非リペイント: request.security + lookahead_on + 上位足内 確定1本前[1]。
// ============================================================
grpEStoch = "Stochastic 環境認識"
useEStochEnv = input.bool(true, "Stochastic環境認識をエントリーに使う (OFFで既存挙動を維持)", group = grpEStoch)
// --- 対象時間足 (OFFにした足は request.security を呼ばない) ---
useEStochDaily = input.bool(false, "日足Stochを使う", group = grpEStoch)
useEStoch4H    = input.bool(false, "4時間足Stochを使う", group = grpEStoch)
useEStoch1H    = input.bool(false, "1時間足Stochを使う", group = grpEStoch)
useEStoch15M   = input.bool(true, "15分足Stochを使う", group = grpEStoch)
useEStoch5M    = input.bool(false, "5分足Stochを使う", group = grpEStoch)
useEStoch1M    = input.bool(false, "1分足Stochを使う", group = grpEStoch)
eStochDailyTF = input.timeframe("D",   "日足TF", group = grpEStoch)
eStoch4HTF    = input.timeframe("240", "4時間足TF", group = grpEStoch)
eStoch1HTF    = input.timeframe("60",  "1時間足TF", group = grpEStoch)
eStoch15MTF   = input.timeframe("15",  "15分足TF", group = grpEStoch)
eStoch5MTF    = input.timeframe("5",   "5分足TF", group = grpEStoch)
eStoch1MTF    = input.timeframe("1",   "1分足TF", group = grpEStoch)
// --- 時間足の重み (小数可・float) ---
eStochWeightD   = input.float(2.0, "重み 日足",  step = 0.1, group = grpEStoch)
eStochWeight4H  = input.float(1.5, "重み 4H",   step = 0.1, group = grpEStoch)
eStochWeight1H  = input.float(1.0, "重み 1H",   step = 0.1, group = grpEStoch)
eStochWeight15M = input.float(0.5, "重み 15M",  step = 0.1, group = grpEStoch)
eStochWeight5M  = input.float(0.5, "重み 5M",   step = 0.1, group = grpEStoch)
eStochWeight1M  = input.float(0.5, "重み 1M",   step = 0.1, group = grpEStoch)
// --- ストキャス設定 (%K Length / %K Smooth / %D Length) ---
eStochKLen    = input.int(10, "%K Length",   minval = 1, group = grpEStoch)
eStochKSmooth = input.int(3,  "%K Smooth",   minval = 1, group = grpEStoch)
eStochDLen    = input.int(3,  "%D Length",   minval = 1, group = grpEStoch)
// --- 折り返し判定 ---
stochArmLow   = input.float(10.0,  "Long 到達ライン",  group = grpEStoch)
stochExitLow  = input.float(15.0, "Long 脱出ライン",  group = grpEStoch)
stochArmHigh  = input.float(90.0, "Short 到達ライン", group = grpEStoch)
stochExitHigh = input.float(85.0, "Short 脱出ライン", group = grpEStoch)
useEStochKDConfirm = input.bool(true, "折り返しに K/D 位置も要求 (Long:K>D / Short:K<D)", group = grpEStoch)
eStochTurnScore    = input.float(2.0, "折り返し 点数", step = 0.5, group = grpEStoch)
eStochArmMaxBars   = input.int(10, "Extreme到達後 折り返し待機上限本数", minval = 1, group = grpEStoch)
// --- 状態保持本数 (足ごと。到達→折り返し確定後この本数だけ優勢を保持) ---
eStochHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpEStoch)
eStochHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpEStoch)
eStochHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpEStoch)
eStochHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpEStoch)
eStochHold5M    = input.int(24, "5M 状態保持本数",   minval = 1, group = grpEStoch)
eStochHold1M    = input.int(30, "1M 状態保持本数",   minval = 1, group = grpEStoch)
// --- 最終判定 ---
eStochScoreThreshold = input.float(1.0, "Stoch合計スコア閾値 (±・ロング/ショート共通)", step = 0.5, group = grpEStoch)
// --- 表示 ---
eStochShowTable = input.bool(true,  "Stoch環境テーブルを表示", group = grpEStoch)
eStochShowDebug = input.bool(false, "Stochデバッグ表示", group = grpEStoch)







useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// 有効化されたトリガー数 (Any/All/MinCount 判定で使用・全コンテキスト共通)。
//   f_calcTriggers 内 (=1分足コンテキスト) からも参照するため関数より前で定義する。
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// 1分足コンテキストで全トリガーを判定し、その1分足単体で Any/All/MinCount を評価して
//   [bullTrigger, bearTrigger] を返す。異なる1分足で発生した条件を合算しない。
//   各トリガー条件・品質フィルターは既存ロジックと完全に同一 (変更なし)。
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    // この1分足単体で Any/All/MinCount を評価 (1分足内で完結)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

// 現在足(5分足)での直接判定 (useLowerTFTrigger = false 時のフォールバックのみに使用)
bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 1分足トリガー集約 ---
//   request.security_lower_tf で現在の5分足に含まれる確定済み1分足 (最大5本) の
//   [bullTrigger, bearTrigger] を配列で取得。5本のうち1本でも成立していれば
//   その方向を5分足の候補とする (途中の1分足トリガーを取りこぼさない)。
//   Any/All/MinCount は各1分足内で f_calcTriggers が評価済み → 異なる足の条件は合算しない。
//   ※ 形成途中の1分足は request.security_lower_tf の確定済み配列に含まれないため非リペイント。
bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, triggerTF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    // 1分足トリガー OFF → 現在足(5分足)で直接判定
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

// 同一5分足内でロング/ショート両方の1分足トリガーが発生 → 方向を予想せず NoTrade (既定)。
bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

// エントリークールダウン (5分足単位・トリガーON時のみ 10c で参照)
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
//   request.security(..., f_envTrendConfirmed(...), lookahead = barmerge.lookahead_on)
//   と組み合わせると、形成途中の上位足ではなく「直近で確定した上位足」の判定を得られる。
//   ・lookahead_on だけでは未来参照になるが、[1] で確定済み1本前に固定するため未来参照は発生しない。
//   ・関数呼び出し結果への直接 [1] を避けるため、いったん変数に受けてから [1] を返す。
//   ・判定ロジック(f_envTrend)自体は不変。取得する足を確定足にするだけ。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useTrendEnv
    // 4H / 1H / 15M : 確定済み上位足のみ参照 (lookahead_on + 確定1本前 → 完全非リペイント)
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    // 5M / 1M : 現状の仕様を維持
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8g-2. Stochastic 環境認識モジュール 本体 (折り返しのみ)
// ------------------------------------------------------------
//  f_eStochState : 呼ばれた足(=上位足)コンテキストで %K/%D を算出し、
//    「10以下へ到達→上向き折り返し=Long / 90以上へ到達→下向き折り返し=Short」
//    のみをスコア化 (+eStochTurnScore)。張り付き・マイナス点は無し。
//    到達フラグは折り返し確定で消費し、再到達で再アーム (毎バー再発火しない)。
//  戻り値 [score(float), reason(int)]。 reason: 1=Long折返し / -1=Short折返し / 0=なし
// ============================================================
f_eStochState(int holdBars) =>
    float _rawK = ta.stoch(close, high, low, eStochKLen)
    float _k = ta.sma(_rawK, eStochKSmooth)
    float _d = ta.sma(_k, eStochDLen)
    var bool _lowArmed  = false
    var bool _highArmed = false
    var int  _lowArmBar  = na
    var int  _highArmBar = na
    var float _score  = 0.0
    var int   _reason = 0
    var int   _evbar  = na
    if _k <= stochArmLow
        _lowArmed := true
        _lowArmBar := bar_index
    if _k >= stochArmHigh
        _highArmed := true
        _highArmBar := bar_index
    // 到達から折り返しまでの待機上限を超えたら到達履歴を無効化
    if _lowArmed and bar_index - _lowArmBar > eStochArmMaxBars
        _lowArmed := false
        _lowArmBar := na
    if _highArmed and bar_index - _highArmBar > eStochArmMaxBars
        _highArmed := false
        _highArmBar := na
    // 折り返し = Extremeゾーンから脱出した瞬間 (armed 中に K が Extreme を上抜け/下抜け)
    bool _turnUp = _lowArmed  and _k >= stochExitLow  and _k[1] < stochExitLow  and (not useEStochKDConfirm or _k > _d)
    bool _turnDn = _highArmed and _k <= stochExitHigh and _k[1] > stochExitHigh and (not useEStochKDConfirm or _k < _d)
    if _turnUp and not _turnDn
        _score := eStochTurnScore
        _reason := 1
        _evbar := bar_index
        // 成立側の到達履歴 + 逆側の古い到達履歴を同時にリセット
        _lowArmed := false
        _lowArmBar := na
        _highArmed := false
        _highArmBar := na
    else if _turnDn and not _turnUp
        _score := eStochTurnScore
        _reason := -1
        _evbar := bar_index
        _highArmed := false
        _highArmBar := na
        _lowArmed := false
        _lowArmBar := na
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    float _outScore  = _active ? (_reason == 1 ? _score : -_score) : 0.0
    int   _outReason = _active ? _reason : 0
    [_outScore, _outReason]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_eStochConfirmed(int holdBars) =>
    [_s, _r] = f_eStochState(holdBars)
    [_s[1], _r[1]]

f_eStochReasonText(int c) =>
    c == 1 ? "Long Turn (OS)" : c == -1 ? "Short Turn (OB)" : "No Turn"

// --- 各足の確定Stoch状態 (エントリー使用 or テーブル表示時のみ算出。OFF足は呼ばない) ---
bool eStochCompute = useEStochEnv or eStochShowTable
float eStochDScore = 0.0
int   eStochDReason = 0
float eStochHScore = 0.0
int   eStochHReason = 0
float eStochOScore = 0.0
int   eStochOReason = 0
float eStochMScore = 0.0
int   eStochMReason = 0
float eStoch5Score = 0.0
int   eStoch5Reason = 0
float eStoch1Score = 0.0
int   eStoch1Reason = 0
if eStochCompute and useEStochDaily
    [_s, _r] = request.security(syminfo.tickerid, eStochDailyTF, f_eStochConfirmed(eStochHoldDaily), lookahead = barmerge.lookahead_on)
    eStochDScore := _s
    eStochDReason := _r
if eStochCompute and useEStoch4H
    [_s, _r] = request.security(syminfo.tickerid, eStoch4HTF, f_eStochConfirmed(eStochHold4H), lookahead = barmerge.lookahead_on)
    eStochHScore := _s
    eStochHReason := _r
if eStochCompute and useEStoch1H
    [_s, _r] = request.security(syminfo.tickerid, eStoch1HTF, f_eStochConfirmed(eStochHold1H), lookahead = barmerge.lookahead_on)
    eStochOScore := _s
    eStochOReason := _r
if eStochCompute and useEStoch15M
    [_s, _r] = request.security(syminfo.tickerid, eStoch15MTF, f_eStochConfirmed(eStochHold15M), lookahead = barmerge.lookahead_on)
    eStochMScore := _s
    eStochMReason := _r
// 5M / 1M も確定済み1本前 (f_eStochConfirmed = 上位足内 [1]) + lookahead_on で非リペイント。
//   5分足チャートで 5M を request.security 参照しても、[1] により形成途中足を使わない。
if eStochCompute and useEStoch5M
    [_s, _r] = request.security(syminfo.tickerid, eStoch5MTF, f_eStochConfirmed(eStochHold5M), lookahead = barmerge.lookahead_on)
    eStoch5Score := _s
    eStoch5Reason := _r
if eStochCompute and useEStoch1M
    [_s, _r] = request.security(syminfo.tickerid, eStoch1MTF, f_eStochConfirmed(eStochHold1M), lookahead = barmerge.lookahead_on)
    eStoch1Score := _s
    eStoch1Reason := _r

// --- 加重合算 → 最終Stochバイアス (WeightedScore : ON足のみ加重合算・OFF足はスコア0) ---
float eStochDW = useEStochDaily ? eStochDScore * eStochWeightD   : 0.0
float eStochHW = useEStoch4H    ? eStochHScore * eStochWeight4H  : 0.0
float eStochOW = useEStoch1H    ? eStochOScore * eStochWeight1H  : 0.0
float eStochMW = useEStoch15M   ? eStochMScore * eStochWeight15M : 0.0
float eStoch5W = useEStoch5M    ? eStoch5Score * eStochWeight5M  : 0.0
float eStoch1W = useEStoch1M    ? eStoch1Score * eStochWeight1M  : 0.0
float eStochTotal = eStochDW + eStochHW + eStochOW + eStochMW + eStoch5W + eStoch1W
bool eStochBiasLong  = eStochTotal >= eStochScoreThreshold
bool eStochBiasShort = eStochTotal <= -eStochScoreThreshold
int eStochFinalBias = eStochBiasLong and not eStochBiasShort ? 1 : eStochBiasShort and not eStochBiasLong ? -1 : 0

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  各環境モジュールを個別の使用ON/OFFで管理し、ONのモジュールをすべて
//  通過した場合のみエントリー許可。OFFのモジュールは常に通過扱い。
//  今後モジュールを増やす場合も「xxxLongOk = not useXxxEnv or xxxBiasLong」を
//  1行足して allEnvLongOk / allEnvShortOk の and に加えるだけで拡張できる。
//  ※ FVG環境認識 / EMA環境認識(50/200/1000) は削除済み。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool stochLongOk = not useEStochEnv or eStochBiasLong
bool allEnvLongOk =
     trendLongOk and
     stochLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool stochShortOk = not useEStochEnv or eStochBiasShort
bool allEnvShortOk =
     trendShortOk and
     stochShortOk

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// --- ①② 可変 SL/TP 用 ATR (チャート足・エントリーは確定足のみ=非リペイント) ---
float slAtr = ta.atr(slAtrLen)
float tpAtr = ta.atr(tpAtrLen)

float longStop = slMode == "ATR" ? entryEst - slAtr * slAtrMult : slMode == "パターン" ? patLow - slBuf : entryEst - slFixed
float longRisk = entryEst - longStop
float longTP   = tpMode == "ATR" ? entryEst + tpAtr * tpAtrMult : entryEst + longRisk * rrRatio

float shortStop = slMode == "ATR" ? entryEst + slAtr * slAtrMult : slMode == "パターン" ? patHigh + slBuf : entryEst + slFixed
float shortRisk = shortStop - entryEst
float shortTP   = tpMode == "ATR" ? entryEst - tpAtr * tpAtrMult : entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

// 15分足コンテキストで箱を構築 (var で 15分足の生存期間だけ上下限を拡張)。
//   返り値: [isAccum, boxHigh, boxLow, boxStartBar]  boxStartBar = 箱識別子。
f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

// 確定済み1本前の15分足 box を「15分足コンテキスト内」で参照して返す。
//   [1] を関数内 (= 15分足コンテキスト) で適用し、lookahead_on と組み合わせることで、
//   ヒストリカル/リアルタイムとも「直前に確定した15分足」の box を一貫して取得する
//   (未来参照なし・非リペイント)。チャート側では [1] を一切使わない。
f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        // 新規Accum確定 → 配列へ追加。4つ目 (accumNTKeep超) で最古を削除。
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        // 形成中は最新箱の上下限を拡張 (配列の末尾=最新も更新)
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    // 内部判定 : 直近保持のどれか1つでも close が上限〜下限 (端一致含む) にあれば内部
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
//   確定参照は 15分足コンテキスト内で [1] を適用する f_accumNT15Confirmed + lookahead_on。
//   → 返る box は常に「直前に確定した15分足」の最終値 (ヒストリカル/リアルタイム一致)。
//   登録/更新は ta.change(time(15分足)) で「新しい15分足が始まった最初の5分足」だけ。
//   ※ チャート側では [1] を一切使わない。形成途中の15分足値は配列に入らない。
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        // 直前に確定した15分足の box をこの1本だけで処理 (3本に1回)
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            // 新しい15分Accum箱 → 登録 (箱識別子が変わった時のみ = 重複登録なし)
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            // 同一箱が拡張 (確定15分足で更新) → 最新エントリーの上下限を更新
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    // 内部判定は毎5分足で実施 (保持中の確定箱に対して現在の終値を判定)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
//   Accum外へ出た最初の足では許可せず、accumExitConfirmBars 本連続で外部維持後に許可。
//   離脱足は計数に含めず、その次の足から連続外部本数を数える。
//   確認中にAccum内へ戻ったらカウント完全リセット。最初から外部なら待機なし (従来どおり即許可)。
//   ※ WinZone/Momentum/Trigger/各状態管理・有効期限・リセットには一切干渉しない。
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        // Accum内 (または戻った) → 待機・カウント完全リセット
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        // 離脱足 → 待機開始 (この足は計数に含めない)
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        // 離脱の次足以降、外部維持で計数
        accumOutsideConfirmCount += 1
    // 確認完了 → 待機解除 (この確定バーで許可)
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

// 確認完了前だけ新規エントリー禁止 (blockedByAccum とは別条件)
bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
//   Accum内NoTrade・離脱待機確認は不変。離脱後のみ、抜けた方向にエントリーを限定する。
//   方向判定は「直前バーで実際に内部にいた保持箱」ごとに close 基準 (ヒゲ無視) で行う。
//   ・最初から外部 (一度もAccumを通過していない) → 方向制限なし (accumBreakDirectionActive=false)。
//   ・Accum内へ戻る / 有効期限切れ / 方向不明 → 状態リセット。
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        // Accum内へ戻った → 方向状態リセット (Accum内なので両方向禁止のまま)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        // 離脱足 : 直前バーで内部にいた箱ごとに close 基準で上抜け/下抜けを判定
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            // 上抜け/下抜け同時成立 or どちらも不成立 → 方向不明 (両方禁止しない=非アクティブ)
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    // 有効期限切れ → リセット
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

// 方向別許可 (非アクティブ時=最初から外部/方向不明/期限切れ は従来どおり両方向許可)
bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + Stochastic)
// ------------------------------------------------------------
//  WinZone / Momentum / Intermarket は本ストラテジーでは不使用。
//  環境認識は allEnvLongOk/allEnvShortOk (ON中の全環境モジュールのAND) に一本化。
//  FVG環境認識 / EMA環境認識(50/200/1000) は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。環境認識(トレンド+Stoch)は主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     allEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     allEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

// --- 建値移動 状態 (Entry ID 単位。エントリー/元SL/TP計算には一切関与しない) ---
//   beOrigTP     : 各Entry IDの発注時TP (建値移動でSL更新時も TP は不変で再指定するため保持)。
//   beActivated  : 各Entry IDが建値到達済みか (一度trueになったら二度と元SLへ戻さない一方向遷移)。
var map<string, float> beOrigTP    = map.new<string, float>()
var map<string, bool>  beActivated = map.new<string, bool>()

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    // 建値移動ON時のみ: この発注のTPを Entry ID 単位で保持 (発注/SL/TP計算は不変)。
    if useBreakEven
        beOrigTP.put(_idL, longTP)
        beActivated.put(_idL, false)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    // 建値移動ON時のみ: この発注のTPを Entry ID 単位で保持 (発注/SL/TP計算は不変)。
    if useBreakEven
        beOrigTP.put(_idS, shortTP)
        beActivated.put(_idS, false)
    if noTriggerMode
        shortArmed := false

// ============================================================
//  12c. Stochastic 環境認識 表示 (デバッグテーブル)
// ============================================================
f_biasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_biasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

var table eStochTbl = na
if eStochShowTable
    if na(eStochTbl)
        eStochTbl := table.new(position.bottom_right, 5, 8, border_width = 1)
    if barstate.islast
        table.cell(eStochTbl, 0, 0, "TF",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(eStochTbl, 1, 0, "Stoch", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(eStochTbl, 2, 0, "Score", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(eStochTbl, 3, 0, "重み",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(eStochTbl, 4, 0, "加重",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // Daily
        table.cell(eStochTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 1, useEStochDaily ? f_eStochReasonText(eStochDReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 1, useEStochDaily ? str.tostring(eStochDScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 1, useEStochDaily ? str.tostring(eStochWeightD, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 1, useEStochDaily ? str.tostring(eStochDW, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 4H
        table.cell(eStochTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 2, useEStoch4H ? f_eStochReasonText(eStochHReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 2, useEStoch4H ? str.tostring(eStochHScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 2, useEStoch4H ? str.tostring(eStochWeight4H, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 2, useEStoch4H ? str.tostring(eStochHW, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 1H
        table.cell(eStochTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 3, useEStoch1H ? f_eStochReasonText(eStochOReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 3, useEStoch1H ? str.tostring(eStochOScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 3, useEStoch1H ? str.tostring(eStochWeight1H, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 3, useEStoch1H ? str.tostring(eStochOW, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 15M
        table.cell(eStochTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 4, useEStoch15M ? f_eStochReasonText(eStochMReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 4, useEStoch15M ? str.tostring(eStochMScore, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 4, useEStoch15M ? str.tostring(eStochWeight15M, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 4, useEStoch15M ? str.tostring(eStochMW, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 5M
        table.cell(eStochTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 5, useEStoch5M ? f_eStochReasonText(eStoch5Reason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 5, useEStoch5M ? str.tostring(eStoch5Score, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 5, useEStoch5M ? str.tostring(eStochWeight5M, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 5, useEStoch5M ? str.tostring(eStoch5W, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 1M
        table.cell(eStochTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 1, 6, useEStoch1M ? f_eStochReasonText(eStoch1Reason) : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 2, 6, useEStoch1M ? str.tostring(eStoch1Score, "#.##") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 6, useEStoch1M ? str.tostring(eStochWeight1M, "#.#") : "-", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 6, useEStoch1M ? str.tostring(eStoch1W, "#.##") : "-", text_color = color.white, text_size = size.small)
        // 合計 / 最終
        table.cell(eStochTbl, 0, 7, "STOCH BIAS", text_color = color.white, bgcolor = f_biasColor(eStochFinalBias), text_size = size.small)
        table.cell(eStochTbl, 1, 7, f_biasText(eStochFinalBias), text_color = color.white, bgcolor = f_biasColor(eStochFinalBias), text_size = size.small)
        table.cell(eStochTbl, 2, 7, eStochShowDebug ? ("Th:" + str.tostring(eStochScoreThreshold, "#.#")) : "", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 3, 7, "合計", text_color = color.white, text_size = size.small)
        table.cell(eStochTbl, 4, 7, str.tostring(eStochTotal, "#.##"), text_color = color.white, bgcolor = f_biasColor(eStochFinalBias), text_size = size.small)

// ============================================================
//  11b. 建値移動 (break-even) — 保有中ポジションの SL のみ更新
// ------------------------------------------------------------
//  ・useBreakEven=OFF → 本ブロックは何もしない (発注/SL/TP/結果は追加前と完全一致)。
//  ・各 Entry ID (ピラミッディングの各ポジション) を個別に管理。建値到達 (Long: +幅 / Short: -幅)
//    で その Entry ID の strategy.exit を「stop=実際のエントリー価格 / limit=元TP」に更新。
//    判定 : "到達瞬間"=high/low基準 (TV標準約定に委譲) / "確定足"=確定足のclose基準。
//    一度到達したら beActivated=true を保持し、以後ずっと建値SL (元SLへは戻さない)。TPは不変。
//  ・建値SL決済は exit_comment="BE" (引き分け) / TP決済="TP" (勝ち) で判別可能。
// ============================================================
if useBreakEven and strategy.opentrades > 0
    for _i = 0 to strategy.opentrades - 1
        string _eid = strategy.opentrades.entry_id(_i)
        if beOrigTP.contains(_eid)
            float _ep     = strategy.opentrades.entry_price(_i)
            bool  _isLong = strategy.opentrades.size(_i) > 0
            bool  _wasOn  = beActivated.contains(_eid) and beActivated.get(_eid)
            bool  _reach  = false
            if _isLong
                _reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close >= _ep + breakEvenTrigger) : (high >= _ep + breakEvenTrigger)
            else
                _reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close <= _ep - breakEvenTrigger) : (low <= _ep - breakEvenTrigger)
            if _wasOn or _reach
                beActivated.put(_eid, true)
                strategy.exit(_eid + "X", from_entry = _eid, stop = _ep, limit = beOrigTP.get(_eid), comment_loss = "BE", comment_profit = "TP")

// ============================================================
//  13. 建値 勝ち/負け/引き分け 集計 (表示専用・発注に影響しない)
// ------------------------------------------------------------
//  ・引き分け : 建値SL決済 (exit_comment=="BE")。勝ち : 利益>0。負け : それ以外。
//  ・勝率 = 勝ち ÷ (勝ち + 負け)。引き分けは分母から除外。breakEvenShowStats=OFFなら描画なし。
// ============================================================
var table beTbl = na
if breakEvenShowStats
    if na(beTbl)
        beTbl := table.new(position.bottom_left, 2, 4, border_width = 1)
    if barstate.islast
        int _win  = 0
        int _loss = 0
        int _draw = 0
        if strategy.closedtrades > 0
            for _ci = 0 to strategy.closedtrades - 1
                if strategy.closedtrades.exit_comment(_ci) == "BE"
                    _draw += 1
                else if strategy.closedtrades.profit(_ci) > 0
                    _win += 1
                else
                    _loss += 1
        float _wr = (_win + _loss) > 0 ? _win / (_win + _loss) * 100.0 : na
        table.cell(beTbl, 0, 0, "勝ち",   text_color = color.white, bgcolor = color.new(color.green, 0), text_size = size.small)
        table.cell(beTbl, 1, 0, str.tostring(_win),  text_color = color.white, text_size = size.small)
        table.cell(beTbl, 0, 1, "負け",   text_color = color.white, bgcolor = color.new(color.red, 0), text_size = size.small)
        table.cell(beTbl, 1, 1, str.tostring(_loss), text_color = color.white, text_size = size.small)
        table.cell(beTbl, 0, 2, "引き分け", text_color = color.white, bgcolor = color.new(color.gray, 0), text_size = size.small)
        table.cell(beTbl, 1, 2, str.tostring(_draw), text_color = color.white, text_size = size.small)
        table.cell(beTbl, 0, 3, "勝率%",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(beTbl, 1, 3, na(_wr) ? "-" : str.tostring(_wr, "#.#"), text_color = color.white, text_size = size.small)

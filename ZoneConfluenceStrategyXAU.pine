// ---- 入力: Zone (ZCR-9 と同じ入力名・初期値。種類・時間足ごとの ON / OFF は無い: 選んだペアに含まれる根拠だけを計算する) ----
var string G_ZW = "Z01 · Zone 共通"
zHalf = input.float(2.0, "共通の価格帯幅 (中心から上下 $)", minval = 0.0, step = 0.5, group = G_ZW,
     tooltip = "ZA / ZB / ZC / ZD / ZE の帯 = 中心 ± この値。ZF (FVG) は本来の上下限、ZG は専用の幅を使う。")

var string G_ZA = "Z02a · ZA アキュム (1H / 4H / D)"

zaKeep2 = input.int(1, "4時間足: 最新から採用する箱数", minval = 1, group = G_ZA)
zaKeep3 = input.int(1, "日足: 最新から採用する箱数", minval = 1, group = G_ZA,
     tooltip = "形成終了で固定した箱の上辺・下辺 (別々の Zone) のうち、時間足ごとに最新 N 箱だけを使う (Lab と同じ)。")

var string G_ACCP = "Z02a' · Accum Box のパラメータ (ZoneComboLabXAU と同じ)"

//@version=6
// ZCS-1: XAUUSD Zone 2 根拠ペアの売買検証ストラテジー (タイミング条件なし。TradingView 標準のストラテジーレポートで成績を見る)
//
//  未検証: TradingView 上のコンパイル・request (動的リクエスト) の挙動・約定は未検証 (PINE_NOT_VERIFIED)。tests/zcs_sim.py は下の
//          「ZCS Logic」区間そのものを Python に機械変換し、TradingView の既定の約定の仮定を模した簡単な約定モデルの上で実行した検証で、
//          request.* / input.source が返す値は合成データで与えている。
//  仕様書: ZONE_CONFLUENCE_STRATEGY_XAU_ja.md。要点だけ:
//  ペア: ZCR-9 (ZoneConfluenceReactionStatsXAU) の 26 根拠の全 325 ペア × LONG / SHORT = 650 個のチェック (初期は全 OFF。自動選別なし)。
//    この入力は tests/zcs_build.py が機械的に生成する (「ZCS pairs (generated)」区間)。
//  Zone: 検知・登録・更新・失効・FVG → iFVG・根拠 ID・帯のティック丸めは ZCR-9 の写し (テストが照合)。選んだペアに必要な種類・時間足
//    だけ request と計算をする (不要なものは request を呼ばない)。
//  エントリー帯: ペア (A, B) の、A の有効 Zone と B の有効 Zone の帯そのもの (切り詰めない) の共通区間 (端点一致も重なり)。
//    他の根拠が重なっても狭めない。共通区間が無ければ発注しない。
//  注文: 確定 5分足の終値で判断し、次の足から有効な指値を置く (過去の足では約定させない)。
//    LONG = 終値が帯より上 → 帯の上端に買い指値 (候補のうち上端が最も高い帯)、SHORT = 終値が帯より下 → 帯の下端に売り指値
//    (下端が最も低い帯)。通常 FVG は 上昇 FVG = LONG だけ・下降 FVG = SHORT だけ、さらに終値がその FVG の外 (LONG は上端より上・SHORT は下端より下)
//    のときだけ (ZCR-9 と同じ「FVG へ上から / 下から」。iFVG は条件なし)。条件を満たさなくなった注文は取消。
//    全注文は 1 つの OCA グループ (最初の約定で他を取消)。同時保有 1 (pyramiding 0)。
//  SL / TP: 実際の約定価格から ± X (5 / 10 / 15 ドル。strategy.exit の profit / loss をティック数で指定)。固定 (建値移動・分割・トレーリングなし)。
//  再エントリー: ペア・方向ごとに、候補帯に触れた足 (約定した足を含む) から接触中。帯から離脱幅 (5 ドル) 以上離れるか、帯の外側が
//    離脱時間 (30 分) 続くまで新しい注文を置かない (ZCR と同じ離脱規則)。保有中に触れたペアも接触中になる (決済後に遅れて入らない)。
//  上位足サッツバンド (任意・既定 OFF): 選んだ足 (日足 / 4H / 1H) の確定済みの帯。赤 = SHORT のみ / 青 = LONG のみ /
//    フラット = 見送り (既定) か両方向。取得できない間 (na) は発注しない。
strategy("ZoneConfluenceStrategyXAU", shorttitle = "ZCS-XAU", overlay = true,
     pyramiding                      = 0,
     initial_capital                 = 10000,
     default_qty_type                = strategy.fixed,
     default_qty_value               = 1,
     commission_type                 = strategy.commission.cash_per_contract,
     commission_value                = 0,
     slippage                        = 0,
     process_orders_on_close         = false,
     calc_on_every_tick              = false,
     calc_on_order_fills             = false,
     backtest_fill_limits_assumption = 0,
     margin_long                     = 0,
     margin_short                    = 0,
     max_bars_back                   = 1100,
     dynamic_requests                = true)
// dynamic_requests = true: 必要な種類・時間足の request だけを if の中で呼ぶため (Pine v6 の動的リクエスト)

// 上位足サッツバンドの計算ライブラリ (ZoneComboLabXAU と同じ。公開したユーザー名・版に合わせて書き換える)
import sekine3310/LabTimingXAU/2 as ltb     // 別名 ltb: ZCR / Lab から写した登録ブロックのローカル変数 lt と同名にしない

// ---- 入力: 売買 ------------------------------------------------------------------------------------------------
var string G_TR = "00 · 売買 (SL / TP・再エントリー・発注期間)"
zsX = input.int(15, "SL / TP の値幅 X ($)", options = [5, 10, 15], group = G_TR,
     tooltip = "実際の約定価格から TP = 反発方向へ X、SL = 逆行方向へ X (strategy.exit の profit / loss をティック数で指定)。約定後は固定。")
zcDepW = input.float(5.0, "離脱幅 ($)", minval = 0.01, step = 0.5, group = G_TR,
     tooltip = "ペア・方向ごとの接触中の解除: 確定 5分足が接触の帯の完全に外側で、帯の端からの距離がこの値以上 (ZCR と同じ規則)。接触中は新しい注文を置かない。")
zcDepMin = input.int(30, "離脱時間 (分)", minval = 1, group = G_TR,
     tooltip = "接触中の解除: 完全に外側の状態が、最初の外側の足の開始から今の足の確定までこの分数以上続いた (実際の経過時間)。")
zcStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "発注開始日時 (判断足の確定時刻)", group = G_TR,
     tooltip = "判断足 (確定 5分足) の time_close がこの日時より前は注文を置かない。")
zcWarm = input.int(6000, "先頭から発注しない助走本数 (0 = 無効)", minval = 0, group = G_TR,
     tooltip = "読み込んだ確定 5分足の先頭からこの本数の間は注文を置かない (EMA 3000 の初期誤差と、上位足由来の Zone がまだ揃っていない区間を外す)。\n" +
     "その間も Zone の登録・更新・失効と接触中の状態の更新は通常どおり行う。")

var string G_FB = "01 · 上位足サッツバンド フィルター"
fbUse  = input.bool(false, "上位足の帯色で方向を制限する", group = G_FB,
     tooltip = "選んだ足の確定済みのサッツバンド (ZoneComboLabXAU の 04a と同じ計算・同じ取得): 赤 → SHORT のみ / 青 → LONG のみ。\n" +
     "許可するのは Zone エントリーの可否だけ (帯色だけでは発注しない)。帯が取得できない間は発注しない (フラットとして扱わない)。OFF なら取得しない。")
fbTf   = input.string("4H", "参照足", options = ["日足", "4H", "1H"], group = G_FB)
fbFlat = input.string("見送り", "フラットのとき", options = ["見送り", "両方向を許可"], group = G_FB)

// ==== ZCS pairs (generated begin) ====

// ---- ZD: POC (ZCR-9 の写し = MtfPocFeedXAU の f_pocCore / f_feed。f_feed の off = 1 で確定済み上位足だけ) ----
// ==== FEED POC core (begin) ==================================================
f_pocCore(bool enabled, int off, int lookback, int bins) =>
    float poc = na
    float pUp = na
    float pLo = na
    if enabled and lookback > 0 and bins > 0 and bar_index - off >= lookback
        float hi = na
        float lo = na
        bool  ok = true
        for k = off to off + lookback - 1
            float h = high[k]
            float l = low[k]
            float v = volume[k]
            if na(h) or na(l) or na(v)
                ok := false
                break
            hi := na(hi) ? h : math.max(hi, h)
            lo := na(lo) ? l : math.min(lo, l)
        float rangeAll = ok ? hi - lo : na
        if ok and rangeAll > 0
            array<float> bv = array.new_float(bins, 0.0)
            float bs = rangeAll / bins
            float total = 0.0
            for k = off to off + lookback - 1
                float ch = high[k]
                float cl = low[k]
                float cv = volume[k]
                total += cv
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    int b0 = math.max(0, math.floor((cl - lo) / bs) - 1)
                    int b1 = math.min(bins - 1, math.floor((ch - lo) / bs) + 1)
                    for bi = b0 to b1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
            if total > 0
                float best  = -1.0
                int   bestI = 0
                for bi = 0 to bins - 1
                    float bvv = array.get(bv, bi)
                    if bvv > best
                        best  := bvv
                        bestI := bi
                pLo := lo + bestI * bs
                pUp := pLo + bs
                poc := (pUp + pLo) / 2.0
    [poc, pUp, pLo]
// ==== FEED POC core (end) ====================================================

// 上位足の中で評価: 1 本前 (確定済み) の上位足までで計算 → [区画下限, 区画上限, 対象足時刻]
f_feed(bool enabled, int lookback, int bins) =>
    [pc, up, lo] = f_pocCore(enabled, 1, lookback, bins)
    int   tk = time[1]
    float tOut = not enabled ? 0.0 : na(tk) ? na : na(pc) ? -float(tk) : float(tk)
    [enabled ? lo : na, enabled ? up : na, tOut]

float zdL1 = na
float zdU1 = na
float zdT1 = na
if zdUse1
    [r0, r1, r2] = request.security(syminfo.tickerid, "60",  f_feed(zdUse1, zdLen1, vpBins), lookahead = barmerge.lookahead_on)
    zdL1 := r0
    zdU1 := r1
    zdT1 := r2
float zdL2 = na
float zdU2 = na
float zdT2 = na
if zdUse2
    [r0, r1, r2] = request.security(syminfo.tickerid, "240", f_feed(zdUse2, zdLen2, vpBins), lookahead = barmerge.lookahead_on)
    zdL2 := r0
    zdU2 := r1
    zdT2 := r2
float zdL3 = na

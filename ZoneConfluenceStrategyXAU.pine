accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ZB = "Z02b · ZB MA (EMA)"
zbLen1 = input.int(3000, "1分足 EMA 本数", minval = 1, group = G_ZB)
zbWarm1 = input.int(1800, "ZB-1m の助走本数 (5分足。0 = 無効)", minval = 0, group = G_ZB,
     tooltip = "1分 EMA の有効値を受け取り始めてからこの本数 (5分足) の間は、未収束として ZB-1m を「不明」にする (Zone を作らず、不明の件数に数える)。\n" +
     "初期値 1800 本 = 1分足 9000 本相当。ZB-5m は「先頭から発注しない助走本数」で扱う。")
zbLen2 = input.int(3000, "5分足 EMA 本数", minval = 1, group = G_ZB,
     tooltip = "帯 = EMA ± 共通幅。確定 5分足 k の終わりに置く注文 (足 k+1 で有効) には足 k が確定した時点の値を使う。ta.ema は先頭の足から値を返すので、読み込んだ履歴の先頭側は\n" +
     "EMA 3000 の初期誤差が残る (「先頭から発注しない助走本数」で外す)。値が na の足 (1分足の履歴が届いていない区間など) は「不明」として MA の帯を作らない。")


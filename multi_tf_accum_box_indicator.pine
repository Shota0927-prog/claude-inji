//@version=5
indicator("Multi-TF Accum Box Indicator", overlay=true, max_boxes_count=500, max_lines_count=500)

// =====================================================
// Inputs
// =====================================================
groupAccum = "01. Accumulation 判定（全時間足共通）"
groupDisp  = "02. 表示 ON/OFF"
groupColor = "03. 時間足ごとの色"

// --- Accumulation 判定パラメータ（元コードと同一。各時間足で共通利用）---
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",        minval=6,   group=groupAccum)
accumBaseLen         = input.int(20,   "基準平均本数",              minval=10,  group=groupAccum)
accumAtrLen          = input.int(14,   "ATR本数",                  minval=1,   group=groupAccum)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",       minval=1,   group=groupAccum)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",       minval=1,   group=groupAccum)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",            minval=1,   group=groupAccum)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",       minval=0.5,  step=0.1,  group=groupAccum)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",    minval=0.1,  step=0.01, group=groupAccum)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",             minval=0.05, maxval=1.0, step=0.05, group=groupAccum)

// --- 表示 ON/OFF（時間足別）---
show15  = input.bool(true, "15分足を表示", group=groupDisp)
show60  = input.bool(true, "1時間足を表示", group=groupDisp)
show240 = input.bool(true, "4時間足を表示", group=groupDisp)
showD   = input.bool(true, "日足を表示",   group=groupDisp)

// --- 色（時間足別。設定画面から変更可）---
col15  = input.color(color.aqua,   "15分足 色", group=groupColor)
col60  = input.color(color.yellow, "1時間足 色", group=groupColor)
col240 = input.color(color.orange, "4時間足 色", group=groupColor)
colD   = input.color(color.red,    "日足 色",   group=groupColor)

// =====================================================
// Accumulation core detection（元コードと完全一致・変更なし）
// =====================================================
f_is_accum_core(_atrMult, _barRatioMax, _driftMax) =>
    _atr = ta.atr(accumAtrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * _atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, accumRangeLen) - ta.lowest(_bodyBotNow, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, accumBaseLen)  - ta.lowest(_bodyBotNow, accumBaseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _barRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _driftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    // 全5条件 + colorRun 必須（AND結合）
    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

// =====================================================
// HTF 状態計算（request.security 内で使用。描画はしない）
// 返り値: [検出ID(=開始time), 上限(実体), 下限(実体), 左time, 右time]
// リペイント防止: barstate.isconfirmed（＝上位足確定）でのみ state 更新
// =====================================================
f_htf_accum_state() =>
    _isAccum   = f_is_accum_core(accumAtrMult, accumBarRatioMax, accumDriftMax)
    _accumHigh = ta.highest(math.max(open, close), accumRangeLen)  // 実体ベース上限
    _accumLow  = ta.lowest(math.min(open, close), accumRangeLen)   // 実体ベース下限
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top   = na
    var float _bot   = na
    var int   _left  = na
    var int   _right = na
    var int   _sid   = na   // 検出ID（新規アキュム開始時のtime）＝重複防止キー

    if barstate.isconfirmed
        // 新規アキュム開始：古い範囲を破棄し、新しい範囲へ更新
        if _isStart
            _top   := _accumHigh
            _bot   := _accumLow
            _left  := time[accumRangeLen - 1]
            _right := time
            _sid   := time
        // アキュム継続中：実体ベースで範囲を拡張しつつ右端を更新
        if _isAccum
            _bt = math.max(open, close)
            _bb = math.min(open, close)
            _top   := math.max(nz(_top, _bt), _bt)
            _bot   := math.min(nz(_bot, _bb), _bb)
            _right := time

    [_sid, _top, _bot, _left, _right]

// =====================================================
// 各上位足の結果を取得（lookahead_off でリペイント防止）
// =====================================================
[sid15,  top15,  bot15,  left15,  right15]  = request.security(syminfo.tickerid, "15",  f_htf_accum_state(), lookahead=barmerge.lookahead_off)
[sid60,  top60,  bot60,  left60,  right60]  = request.security(syminfo.tickerid, "60",  f_htf_accum_state(), lookahead=barmerge.lookahead_off)
[sid240, top240, bot240, left240, right240] = request.security(syminfo.tickerid, "240", f_htf_accum_state(), lookahead=barmerge.lookahead_off)
[sidD,   topD,   botD,   leftD,   rightD]   = request.security(syminfo.tickerid, "D",   f_htf_accum_state(), lookahead=barmerge.lookahead_off)

// =====================================================
// 描画ヘルパ（5分足側で box / line を生成・更新・削除）
// 表示OFF or 未検出 なら削除。ON かつ検出済みなら生成/更新。
// box: 元期間のみ（右延長なし） / line: 上限・下限を extend.right で右へ延長
// =====================================================
f_render(_show, _has, _top, _bot, _left, _right, _col, _box, _up, _dn) =>
    box  _b = _box
    line _u = _up
    line _d = _dn
    _bg = color.new(_col, 85)
    if not _show or not _has
        if not na(_b)
            box.delete(_b)
            _b := na
        if not na(_u)
            line.delete(_u)
            _u := na
        if not na(_d)
            line.delete(_d)
            _d := na
    else
        // ボックス（発生期間のみ・右延長なし）
        if na(_b)
            _b := box.new(_left, _top, _right, _bot, xloc=xloc.bar_time, bgcolor=_bg, border_color=_col, border_width=1)
        else
            box.set_lefttop(_b, _left, _top)
            box.set_rightbottom(_b, _right, _bot)
        // 上限ライン（右へ延長）
        if na(_u)
            _u := line.new(_left, _top, _right, _top, xloc=xloc.bar_time, color=_col, width=1, extend=extend.right)
        else
            line.set_xy1(_u, _left, _top)
            line.set_xy2(_u, _right, _top)
        // 下限ライン（右へ延長）
        if na(_d)
            _d := line.new(_left, _bot, _right, _bot, xloc=xloc.bar_time, color=_col, width=1, extend=extend.right)
        else
            line.set_xy1(_d, _left, _bot)
            line.set_xy2(_d, _right, _bot)
    [_b, _u, _d]

// =====================================================
// 時間足ごとの描画（他の時間足の表示は削除しない）
// =====================================================
// --- 15分足 ---
var box  box15 = na
var line up15  = na
var line dn15  = na
has15 = not na(sid15) and not na(top15) and not na(left15)
[nb15, nu15, nd15] = f_render(show15, has15, top15, bot15, left15, right15, col15, box15, up15, dn15)
box15 := nb15
up15  := nu15
dn15  := nd15

// --- 1時間足 ---
var box  box60 = na
var line up60  = na
var line dn60  = na
has60 = not na(sid60) and not na(top60) and not na(left60)
[nb60, nu60, nd60] = f_render(show60, has60, top60, bot60, left60, right60, col60, box60, up60, dn60)
box60 := nb60
up60  := nu60
dn60  := nd60

// --- 4時間足 ---
var box  box240 = na
var line up240  = na
var line dn240  = na
has240 = not na(sid240) and not na(top240) and not na(left240)
[nb240, nu240, nd240] = f_render(show240, has240, top240, bot240, left240, right240, col240, box240, up240, dn240)
box240 := nb240
up240  := nu240
dn240  := nd240

// --- 日足 ---
var box  boxD = na
var line upD  = na
var line dnD  = na
hasD = not na(sidD) and not na(topD) and not na(leftD)
[nbD, nuD, ndD] = f_render(showD, hasD, topD, botD, leftD, rightD, colD, boxD, upD, dnD)
boxD := nbD
upD  := nuD
dnD  := ndD

// =====================================================
// 新規アキュム検出（検出ID=開始time の変化で重複防止）
// =====================================================
newAccum15  = not na(sid15)  and (na(sid15[1])  or sid15  != sid15[1])
newAccum60  = not na(sid60)  and (na(sid60[1])  or sid60  != sid60[1])
newAccum240 = not na(sid240) and (na(sid240[1]) or sid240 != sid240[1])
newAccumD   = not na(sidD)   and (na(sidD[1])   or sidD   != sidD[1])

// =====================================================
// アラート
// =====================================================
// 動的価格つき alert()（フェーズで1回・確定バーのみ）
if barstate.isconfirmed and newAccum15
    alert("15分足 新規アキュム検出 High:" + str.tostring(top15, "#.##") + " Low:" + str.tostring(bot15, "#.##"), alert.freq_once_per_bar)
if barstate.isconfirmed and newAccum60
    alert("1時間足 新規アキュム検出 High:" + str.tostring(top60, "#.##") + " Low:" + str.tostring(bot60, "#.##"), alert.freq_once_per_bar)
if barstate.isconfirmed and newAccum240
    alert("4時間足 新規アキュム検出 High:" + str.tostring(top240, "#.##") + " Low:" + str.tostring(bot240, "#.##"), alert.freq_once_per_bar)
if barstate.isconfirmed and newAccumD
    alert("日足 新規アキュム検出 High:" + str.tostring(topD, "#.##") + " Low:" + str.tostring(botD, "#.##"), alert.freq_once_per_bar)

// 時間足別 alertcondition
alertcondition(newAccum15,  title="15分足 新規アキュム検出", message="{{ticker}} 15分足 新規アキュム検出")
alertcondition(newAccum60,  title="1時間足 新規アキュム検出", message="{{ticker}} 1時間足 新規アキュム検出")
alertcondition(newAccum240, title="4時間足 新規アキュム検出", message="{{ticker}} 4時間足 新規アキュム検出")
alertcondition(newAccumD,   title="日足 新規アキュム検出",   message="{{ticker}} 日足 新規アキュム検出")

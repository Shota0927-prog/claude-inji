absBreakEvenTrigger  = input.float(10.0, "FVG吸収 建値移動開始幅 ($)", step = 0.1, group = G_BE,
     tooltip = "FVG吸収系列 (FVGABS5 / FVGABS15) だけこの幅を使う。\n" +

// 01-4. TRADE ENGINE INPUTS
// ============================================================================
var string G_RISK = "04 · Trade Engine · Risk"
//  ★ Indicator専用の追加input (1つだけ) ★
//    Strategy の strategy(initial_capital = 1000) に対応する。
//    Indicator は strategy.initial_capital / strategy.equity を読めないため、
//    同じ数値をここから与える。必ず Strategy の initial_capital と一致させること。
//    ここがズレると Qty が変わり、Qty不足によるEntry可否が Strategy とズレる。
indInitialCapital = input.float(1000, "初期資金 (Strategyの initial_capital と一致させる)", minval = 0.01, group = G_RISK,
     tooltip = "Strategy側 strategy(initial_capital = 1000) と同じ値にする。\n" +
     "useCompound = false のときは f_qty が完全一致する。")
riskPct     = input.float(5.0, "1トレード損失率 (%)", step = 0.1, group = G_RISK,
     tooltip = "Risk Amount ÷ Structural SL距離 でQtyを計算する。")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = G_RISK)
qtyStep     = input.float(1, "Qty 刻み (最小ロット単位)", minval = 0.00000001, step = 0.01, group = G_RISK,
     tooltip = "XAUUSD等の小数ロットを潰さないための刻み。\n" +
               "0.01 → 0.01単位で発注 / 1 → 整数ロットのみ。\n" +

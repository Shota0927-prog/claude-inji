zoneBosBreakEvenTrigger = input.float(10.0, "ZONEBOS 建値移動開始幅 ($)", step = 0.1, group = G_BE,
     tooltip = "Zone Touch → BOS Logic (ZONEBOS) だけこの幅を使う。")
breakEvenTriggerMode = input.string("到達瞬間", "建値移動判定", options = ["到達瞬間", "確定足"], group = G_BE)


var string GF_ZBOS = "03 · ZONEBOS · Zone Touch → BOS"
zoneBosMinStrStr = input.string("Strong", "Zone BOS · 対象 最低Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = GF_ZBOS,
     tooltip = "このStrength以上のZoneへのタッチだけをEntry対象にする。\n" +
     "Long は Support Zone、Short は Resistance Zone のタッチのみ有効。")
zoneBosTf        = input.timeframe("1", "Zone BOS Timeframe", group = GF_ZBOS,
     tooltip = "BOSを判定する時間足。既存FVGの triggerTF 等とは共有しない専用設定。")
zoneBosLookback  = input.int(10, "Zone BOS Lookback", minval = 1, group = GF_ZBOS,
     tooltip = "BOSの定義は既存と同一 (close > ta.highest(high, n)[1] / close < ta.lowest(low, n)[1])。\n" +
     "Lookback値だけ Zone BOS 単独で変更できる。")
zoneBosReqDailyVolatility    = input.string("中ボラ", "Zone BOS · 日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GF_ZBOS,
     tooltip = "FVG側の「日足ボラ」とは完全に独立。どちらを変えても他方に影響しない。")
zoneBosDailyLowVolThreshold  = input.float(0.0,  "Zone BOS · 低ボラ上限", group = GF_ZBOS)
zoneBosDailyHighVolThreshold = input.float(80.0, "Zone BOS · 高ボラ下限", group = GF_ZBOS)
zoneBosMinMoveAway = input.float(0.0, "Zone BOS · 最低離脱距離 ($)", minval = 0.0, step = 0.5, group = GF_ZBOS,
     tooltip = "Zoneタッチ後、この距離ぶんZoneから離れてからでないとBOSを有効にしない。\n" +
     "  Long  : close >= タッチしたSupport Zoneの上端 + この距離\n" +
     "  Short : close <= タッチしたResistance Zoneの下端 - この距離\n" +
     "基準はタッチ価格ではなくZoneの境界。判定は終値のみ (ヒゲだけでは成立しない)。\n" +
     "0 にすると条件OFF = 従来の Touch → BOS → Entry と同じ挙動。")
zoneBosWaitBars  = input.int(30, "Zone BOS · BOS待機本数", minval = 0, group = GF_ZBOS,
     tooltip = "Zoneタッチした「BOS対象時間足の足」を0本目として、この本数後まで有効。\n" +
     "同一足でのタッチ+BOS (経過0本) も有効。既定の 1M × 30本 なら約30分の待機期間。\n" +
     "BOS時間足を変えると、待機期限もその時間足基準の本数になる (5M × 30本 なら約150分)。")


//@version=6
// ============================================================
// ZoneEngineV2_W08Runtime_ProbeHarness - W08 B15-B0 runtime worker type / reference probe
//
// Builds scratch arrays and scratch W08Core / W08Touch UDTs on the first bar (no production array, no market logic,
// no Root / Core engine) and passes them to the W08Runtime probe exports. Checks:
//   1 cross-library UDT arguments compile and every probe call returns its expected value
//   2 W08Core type identity (W08Store from W08Core.newStore, caller-built PendingTopologyStore through W08Runtime into
//     W08Core.pendingClearCore)
//   3 W08Touch type identity (caller-built TouchRing through W08Runtime into W08Touch.markAppend, TouchPlan and
//     W08Touch.newSplitTouchPlan into W08Runtime)
//   4 bare array mutation is visible to the caller
//   5 mutation of arrays held inside UDTs (and of a UDT scalar field) is visible to the caller, also through an alias
//     of the field taken before the call
// Any mismatch raises runtime.error naming the failed check; PROBE_PASS = 1 only when all 5 checks pass.
// ============================================================
indicator("ZoneEngineV2_W08Runtime_ProbeHarness", overlay = false)

import sekine3310/ZoneEngineV2_W08Core_Worker/15 as W08Core
import sekine3310/ZoneEngineV2_W08Touch_Worker/2 as W08Touch
import sekine3310/ZoneEngineV2_W08Runtime_Worker/1 as W08Runtime

var int probePass  = 0
var int checksPass = 0

if barstate.isfirst
    // Check 4: bare array.
    array<int> scratch = array.from(0, 0, 0)
    int prev = W08Runtime.probeArrayWrite(scratch, 1, 7)
    bool c4 = prev == 0 and array.get(scratch, 0) == 0 and array.get(scratch, 1) == 7 and array.get(scratch, 2) == 0

    // Checks 2 / 5: W08Store array field and scalar field.
    W08Core.W08Store store = W08Core.newStore()
    array.push(store.changedTargets, 0)
    array.push(store.changedTargets, 0)
    array.push(store.changedTargets, 0)
    array<int> targetsAlias = store.changedTargets
    int cnt = W08Runtime.probeStoreWrite(store, 2, 9)
    bool c5Store = cnt == 1 and store.changedComponentCount == 1 and array.get(store.changedTargets, 2) == 9 and array.get(targetsAlias, 2) == 9 and array.size(store.changedTargets) == 3

    // Checks 2 / 5: caller-built PendingTopologyStore (1 Core slot, 1 live child, 1 live Root node) cleared by W08Core.
    W08Core.PendingTopologyStore ps = W08Core.PendingTopologyStore.new(corePendingTopologyFlags = array.from(true), corePendingTopologyChildHeadIndexes = array.from(0), corePendingTopologyChildTailIndexes = array.from(0), corePendingTopologyChildCounts = array.from(1), pendingTopologyChildNextIndexes = array.from(-1), pendingTopologyChildOwnerCoreSlots = array.from(0), pendingTopologyChildExpectedCoreIds = array.from(11), pendingTopologyChildExpectedGenerationIds = array.from(3), pendingTopologyChildRootHeadNodeIndexes = array.from(0), pendingTopologyChildRootTailNodeIndexes = array.from(0), pendingTopologyChildRootCounts = array.from(1), pendingTopologyChildLiveFlags = array.from(true), pendingTopologyChildFreeIndexes = array.new_int(0), pendingTopologyRootNodeRootIds = array.from(5), pendingTopologyRootNodeNextIndexes = array.from(-1), pendingTopologyRootNodeOwnerChildIndexes = array.from(0), pendingTopologyRootNodeExpectedCoreIds = array.from(11), pendingTopologyRootNodeExpectedGenerationIds = array.from(3), pendingTopologyRootNodeLiveFlags = array.from(true), pendingTopologyRootNodeFreeIndexes = array.new_int(0))
    array<bool> pendingFlagsAlias = ps.corePendingTopologyFlags
    bool wrongIdClear = W08Runtime.probePendingClear(ps, 0, 12, 3)
    bool unchanged = array.get(ps.corePendingTopologyFlags, 0) and array.get(ps.pendingTopologyChildLiveFlags, 0) and array.size(ps.pendingTopologyChildFreeIndexes) == 0
    bool cleared = W08Runtime.probePendingClear(ps, 0, 11, 3)
    bool c5Pending = not wrongIdClear and unchanged and cleared and not array.get(ps.corePendingTopologyFlags, 0) and not array.get(pendingFlagsAlias, 0) and array.get(ps.corePendingTopologyChildCounts, 0) == 0 and array.get(ps.corePendingTopologyChildHeadIndexes, 0) == -1 and not array.get(ps.pendingTopologyChildLiveFlags, 0) and not array.get(ps.pendingTopologyRootNodeLiveFlags, 0) and array.size(ps.pendingTopologyChildFreeIndexes) == 1 and array.size(ps.pendingTopologyRootNodeFreeIndexes) == 1 and array.get(ps.pendingTopologyRootNodeRootIds, 0) == 0
    bool c2 = c5Store and c5Pending

    // Checks 3 / 5: caller-built TouchRing (1 Core slot, capacity 2) appended by W08Touch; Touch plans.
    W08Touch.TouchRing ring = W08Touch.TouchRing.new(touchMarkRingOwnerCoreIds = array.from(11), touchMarkRingHeads = array.from(0), touchMarkRingCounts = array.from(0), touchMarkBaseSeqs = array.new_int(2, 0), touchMarkTimes = array.new_int(2, 0), touchMarkSides = array.new_int(2, 0), touchMarkContactBottoms = array.new_float(2, 0.0), touchMarkContactTops = array.new_float(2, 0.0), touchMarkCloseAtTouches = array.new_float(2, 0.0), touchMarkGenerationIds = array.new_int(2, 0), touchMarkIsNormalTouchFlags = array.new_bool(2, false), sideTouchHistoryTruncatedFlags = array.new_bool(2, false), coreIds = array.from(11), coreSlotLiveFlags = array.from(true), touchMarkCapacityPerCore = 2)
    int row0 = W08Runtime.probeTouchAppend(ring, 0, 1, 1000, 1, 10.0, 11.0, 10.5, 3)
    int row1 = W08Runtime.probeTouchAppend(ring, 0, 2, 2000, -1, 12.0, 13.0, 12.5, 3)
    bool c5Ring = row0 == 0 and row1 == 1 and array.get(ring.touchMarkRingCounts, 0) == 2 and array.get(ring.touchMarkTimes, 0) == 1000 and array.get(ring.touchMarkTimes, 1) == 2000 and array.get(ring.touchMarkSides, 1) == -1 and array.get(ring.touchMarkContactTops, 1) == 13.0 and array.get(ring.touchMarkIsNormalTouchFlags, 0) and not array.get(ring.sideTouchHistoryTruncatedFlags, 0)
    W08Touch.TouchPlan plan = W08Touch.TouchPlan.new(array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0))
    W08Touch.SplitTouchPlan splitPlan = W08Touch.newSplitTouchPlan()
    int planSize = W08Runtime.probeTouchPlanWrite(plan, splitPlan, 4)
    bool c5Plan = planSize == 2 and array.size(plan.mergeTouchPlanOffsets) == 1 and array.get(plan.mergeTouchPlanOffsets, 0) == 4 and array.size(splitPlan.targetPhysicalIndexes) == 1 and array.get(splitPlan.targetPhysicalIndexes, 0) == 4
    bool c3 = c5Ring and c5Plan

    bool c5 = c5Store and c5Pending and c5Ring and c5Plan
    // Check 1: every probe call above compiled with the real cross-library UDTs and returned its expected value.
    bool c1 = prev == 0 and cnt == 1 and cleared and row0 == 0 and row1 == 1 and planSize == 2

    if not c1
        runtime.error("B15B0_PROBE_FAIL: check 1 cross-library UDT call")
    if not c2
        runtime.error("B15B0_PROBE_FAIL: check 2 W08Core type identity")
    if not c3
        runtime.error("B15B0_PROBE_FAIL: check 3 W08Touch type identity")
    if not c4
        runtime.error("B15B0_PROBE_FAIL: check 4 array mutation visibility")
    if not c5
        runtime.error("B15B0_PROBE_FAIL: check 5 UDT array mutation visibility")
    checksPass := (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0)
    probePass  := checksPass == 5 ? 1 : 0

plot(probePass, "PROBE_PASS")
plot(checksPass, "PROBE_CHECKS_PASSED", display = display.data_window)

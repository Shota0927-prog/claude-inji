// ============================================================
//  Pivot モジュール (既存ストラテジー貼り付け用 断片 / Pine v5)
// ============================================================
//  使い方:
//   1. これは「断片(スニペット)」です。あなたの既存 strategy() の中に
//      貼り付けて使ってください (単体ではコンパイルしません)。
//   2. 前提として既存コードに以下があること:
//        - strategy(...) 宣言
//        - bool longCondition / bool shortCondition
//        - (任意) existingLongTP / existingShortTP (float, TP価格)
//        - (任意) signalScore (int/float, スコア)
//   3. grpPivot が既に定義済みなら、最初の grpPivot 行は削除してください。
//   4. 末尾の「接続」セクションで finalLongCondition / finalShortCondition を
//      作り、あなたの strategy.entry に渡してください。
//
//  設計方針:
//   - usePivotModule=false なら全フィルター/条件が true 扱い → 既存挙動を変えない。
//   - 各 use 系 OFF 時も該当 Ok 変数は true → 邪魔しない。
//   - 未来参照なし (request.security は lookahead_off、確定済み前足を使用)。
//   - na 対策込み。変数は pivot_ prefix で衝突回避。
//
//  --- テスト用スタブ (コンパイル確認したい時だけ下を一時的に有効化) ---
//  strategy("Pivot Test", overlay=true, max_lines_count=100)
//  bool longCondition  = ta.crossover(ta.ema(close, 9), ta.ema(close, 21))
//  bool shortCondition = ta.crossunder(ta.ema(close, 9), ta.ema(close, 21))
//  float existingLongTP  = na
//  float existingShortTP = na
//  float signalScore = 0.0
//  ------------------------------------------------------------

// ============================================================
//  入力 (グループ: Pivot Module)
// ============================================================
grpPivot = "Pivot Module"

usePivotModule  = input.bool(false, "Pivotモジュールを使う", group = grpPivot)
showPivotLines  = input.bool(true,  "Pivotラインを表示",     group = grpPivot)
pivotTf         = input.timeframe("D", "Pivot計算TF",        group = grpPivot)

pivotTouchMode  = input.string("ATR", "Pivot接近判定", options = ["Dollar", "ATR"], group = grpPivot)
pivotTouchDollar= input.float(3.0, "Pivot接近幅($)",      step = 0.1,  group = grpPivot)
pivotTouchATR   = input.float(0.3, "Pivot接近幅 ATR倍率", step = 0.05, group = grpPivot)

usePivotBounceEntry      = input.bool(false, "Pivot反発をエントリー条件に使う",       group = grpPivot)
usePivotSweepEntry       = input.bool(false, "Pivotスイープ反転を使う",               group = grpPivot)
usePivotBreakRetestEntry = input.bool(false, "Pivotブレイク→レジサポ転換を使う",      group = grpPivot)
pivotEntryMode           = input.string("Any", "Pivotエントリー条件の結合", options = ["Any", "All"], group = grpPivot)
pivotRetestBars          = input.int(10, "Pivotリテスト有効本数", minval = 1, group = grpPivot)

usePivotBlockFilter = input.bool(false, "近くのPivotでエントリー禁止", group = grpPivot)
pivotBlockDollar    = input.float(5.0, "禁止するPivotまでの距離($)", step = 0.1, group = grpPivot)

usePivotRoomFilter  = input.bool(false, "Pivotまでの利幅フィルターを使う", group = grpPivot)
minPivotRoomDollar  = input.float(8.0, "最低Pivot利幅($)", step = 0.1, group = grpPivot)

usePivotAsTP   = input.bool(false, "次のPivotをTP候補にする", group = grpPivot)
usePivotScore  = input.bool(false, "Pivot重複スコアを使う",   group = grpPivot)
pivotScoreAdd  = input.int(20, "Pivot接近時の加点", minval = 0, maxval = 100, group = grpPivot)
usePivotStats  = input.bool(true,  "Pivot統計を表示", group = grpPivot)

// ============================================================
//  優先度1: Pivot計算 (Classic / 関数化 / 確定済み前足)
// ============================================================
f_pivotClassic(tf) =>
    [pH, pL, pC] = request.security(syminfo.tickerid, tf, [high[1], low[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
    float pp = (pH + pL + pC) / 3.0
    float r1 = 2.0 * pp - pL
    float s1 = 2.0 * pp - pH
    float r2 = pp + (pH - pL)
    float s2 = pp - (pH - pL)
    float r3 = pH + 2.0 * (pp - pL)
    float s3 = pL - 2.0 * (pH - pp)
    [pp, r1, r2, r3, s1, s2, s3]

[pivot_pp, pivot_r1, pivot_r2, pivot_r3, pivot_s1, pivot_s2, pivot_s3] = f_pivotClassic(pivotTf)

// ============================================================
//  優先度1: 接近判定
// ============================================================
float pivot_atr = ta.atr(14)
float pivot_touchRange = pivotTouchMode == "ATR" ? pivot_atr * pivotTouchATR : pivotTouchDollar

f_isNear(price, level, rng) =>
    not na(level) and math.abs(price - level) <= rng

// 上側 Pivot(R系+PP) / 下側 Pivot(S系+PP) への接近
bool pivot_nearUpper = f_isNear(close, pivot_r1, pivot_touchRange) or f_isNear(close, pivot_r2, pivot_touchRange) or f_isNear(close, pivot_r3, pivot_touchRange) or f_isNear(close, pivot_pp, pivot_touchRange)
bool pivot_nearLower = f_isNear(close, pivot_s1, pivot_touchRange) or f_isNear(close, pivot_s2, pivot_touchRange) or f_isNear(close, pivot_s3, pivot_touchRange) or f_isNear(close, pivot_pp, pivot_touchRange)

// ============================================================
//  優先度1: 最寄り Pivot と距離 (Block/Room/TP 共用)
// ============================================================
pivot_levels = array.from(pivot_pp, pivot_r1, pivot_r2, pivot_r3, pivot_s1, pivot_s2, pivot_s3)
float pivot_nearestUpper = na
float pivot_nearestLower = na
for pivot_i = 0 to array.size(pivot_levels) - 1
    float lv = array.get(pivot_levels, pivot_i)
    if not na(lv)
        if lv > close
            pivot_nearestUpper := na(pivot_nearestUpper) ? lv : math.min(pivot_nearestUpper, lv)
        if lv < close
            pivot_nearestLower := na(pivot_nearestLower) ? lv : math.max(pivot_nearestLower, lv)

float pivot_nearestUpperDist = na(pivot_nearestUpper) ? na : pivot_nearestUpper - close
float pivot_nearestLowerDist = na(pivot_nearestLower) ? na : close - pivot_nearestLower

// ============================================================
//  優先度1: Pivot禁止フィルター (進行方向のすぐ先に Pivot)
//   SELL → 下の最寄り Pivot が近すぎたら禁止
//   BUY  → 上の最寄り Pivot が近すぎたら禁止
// ============================================================
bool pivotBlockOkSell = not (usePivotModule and usePivotBlockFilter) or na(pivot_nearestLowerDist) or pivot_nearestLowerDist >= pivotBlockDollar
bool pivotBlockOkBuy  = not (usePivotModule and usePivotBlockFilter) or na(pivot_nearestUpperDist) or pivot_nearestUpperDist >= pivotBlockDollar

// ============================================================
//  優先度1: Pivot利幅フィルター (TP余地の最低条件)
// ============================================================
bool pivotRoomOkSell = not (usePivotModule and usePivotRoomFilter) or na(pivot_nearestLowerDist) or pivot_nearestLowerDist >= minPivotRoomDollar
bool pivotRoomOkBuy  = not (usePivotModule and usePivotRoomFilter) or na(pivot_nearestUpperDist) or pivot_nearestUpperDist >= minPivotRoomDollar

// ============================================================
//  優先度2: 反転ローソク判定 (共通)
// ============================================================
float pivot_body   = math.abs(close - open)
float pivot_upWick = high - math.max(open, close)
float pivot_dnWick = math.min(open, close) - low
bool pivot_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool pivot_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool pivot_pinLower = pivot_dnWick >= pivot_body and pivot_dnWick >= pivot_upWick
bool pivot_pinUpper = pivot_upWick >= pivot_body and pivot_upWick >= pivot_dnWick
bool pivot_bullishReversal = pivot_bullEngulf or pivot_pinLower or close > open
bool pivot_bearishReversal = pivot_bearEngulf or pivot_pinUpper or close < open

// ============================================================
//  優先度2: Pivot反発エントリー
// ============================================================
bool pivot_buyBounce  = usePivotModule and usePivotBounceEntry and pivot_nearLower and pivot_bullishReversal
bool pivot_sellBounce = usePivotModule and usePivotBounceEntry and pivot_nearUpper and pivot_bearishReversal
bool pivotBounceOkBuy  = not usePivotModule or not usePivotBounceEntry or pivot_buyBounce
bool pivotBounceOkSell = not usePivotModule or not usePivotBounceEntry or pivot_sellBounce

// ============================================================
//  優先度2: Pivotスイープ反転
//   SELL: high>上Pivot かつ close<該当Pivot / 上ヒゲ>実体 / 陰線優先
//   BUY : low<下Pivot かつ close>該当Pivot / 下ヒゲ>実体 / 陽線優先
// ============================================================
f_sweptUp(level) => not na(level) and high > level and close < level
f_sweptDn(level) => not na(level) and low  < level and close > level

bool pivot_upSwept = f_sweptUp(pivot_r1) or f_sweptUp(pivot_r2) or f_sweptUp(pivot_r3) or f_sweptUp(pivot_pp)
bool pivot_dnSwept = f_sweptDn(pivot_s1) or f_sweptDn(pivot_s2) or f_sweptDn(pivot_s3) or f_sweptDn(pivot_pp)

bool pivot_sellSweep = usePivotModule and usePivotSweepEntry and pivot_upSwept and pivot_upWick > pivot_body and close < open
bool pivot_buySweep  = usePivotModule and usePivotSweepEntry and pivot_dnSwept and pivot_dnWick > pivot_body and close > open
bool pivotSweepOkBuy  = not usePivotModule or not usePivotSweepEntry or pivot_buySweep
bool pivotSweepOkSell = not usePivotModule or not usePivotSweepEntry or pivot_sellSweep

// ============================================================
//  優先度2: Pivotブレイク → レジサポ転換 (簡易版)
//   R1/R2/PP を上抜け → pivotRetestBars 以内に該当付近へ戻り → 再反発 = BUY
//   S1/S2/PP を下抜け → pivotRetestBars 以内に該当付近へ戻り → 再反落 = SELL
// ============================================================
var float pivot_breakUpLevel = na
var int   pivot_breakUpBar   = na
var float pivot_breakDnLevel = na
var int   pivot_breakDnBar   = na

// 上抜け検出 (直近に上抜けた Pivot を1つ保持)
if ta.crossover(close, pivot_r2)
    pivot_breakUpLevel := pivot_r2
    pivot_breakUpBar := bar_index
else if ta.crossover(close, pivot_r1)
    pivot_breakUpLevel := pivot_r1
    pivot_breakUpBar := bar_index
else if ta.crossover(close, pivot_pp)
    pivot_breakUpLevel := pivot_pp
    pivot_breakUpBar := bar_index
// 下抜け検出
if ta.crossunder(close, pivot_s2)
    pivot_breakDnLevel := pivot_s2
    pivot_breakDnBar := bar_index
else if ta.crossunder(close, pivot_s1)
    pivot_breakDnLevel := pivot_s1
    pivot_breakDnBar := bar_index
else if ta.crossunder(close, pivot_pp)
    pivot_breakDnLevel := pivot_pp
    pivot_breakDnBar := bar_index

bool pivot_buyBreakRetest = usePivotModule and usePivotBreakRetestEntry and not na(pivot_breakUpLevel) and (bar_index - pivot_breakUpBar) <= pivotRetestBars and low <= pivot_breakUpLevel + pivot_touchRange and close > pivot_breakUpLevel and close > open
bool pivot_sellBreakRetest= usePivotModule and usePivotBreakRetestEntry and not na(pivot_breakDnLevel) and (bar_index - pivot_breakDnBar) <= pivotRetestBars and high >= pivot_breakDnLevel - pivot_touchRange and close < pivot_breakDnLevel and close < open
bool pivotBreakRetestOkBuy  = not usePivotModule or not usePivotBreakRetestEntry or pivot_buyBreakRetest
bool pivotBreakRetestOkSell = not usePivotModule or not usePivotBreakRetestEntry or pivot_sellBreakRetest

// ============================================================
//  Pivotエントリー条件の結合 (Any / All)
//   有効化されている反発/Sweep/BreakRetest のうち、
//   Any: いずれか1つ成立 / All: 有効な全てが成立 でエントリー許可。
//   有効パターンが0個 → 制限なし(true)。usePivotModule=false → true。
// ============================================================
int pivot_enabledCount = (usePivotBounceEntry ? 1 : 0) + (usePivotSweepEntry ? 1 : 0) + (usePivotBreakRetestEntry ? 1 : 0)
int pivot_firedBuy  = ((usePivotBounceEntry and pivot_buyBounce) ? 1 : 0) + ((usePivotSweepEntry and pivot_buySweep) ? 1 : 0) + ((usePivotBreakRetestEntry and pivot_buyBreakRetest) ? 1 : 0)
int pivot_firedSell = ((usePivotBounceEntry and pivot_sellBounce) ? 1 : 0) + ((usePivotSweepEntry and pivot_sellSweep) ? 1 : 0) + ((usePivotBreakRetestEntry and pivot_sellBreakRetest) ? 1 : 0)

bool pivotEntryOkBuy  = not usePivotModule or pivot_enabledCount == 0 or (pivotEntryMode == "All" ? pivot_firedBuy  == pivot_enabledCount : pivot_firedBuy  >= 1)
bool pivotEntryOkSell = not usePivotModule or pivot_enabledCount == 0 or (pivotEntryMode == "All" ? pivot_firedSell == pivot_enabledCount : pivot_firedSell >= 1)

// ============================================================
//  優先度3: Pivot TP (既存TPと比較してより保守的な方を採用)
//   ※ existingLongTP / existingShortTP が無いストラテジーでは
//     下2行をコメントアウトし、pivot_longTP/pivot_shortTP を直接使ってください。
// ============================================================
f_pivotLongTP(existing) =>
    (not usePivotModule or not usePivotAsTP or na(pivot_nearestUpper)) ? existing : na(existing) ? pivot_nearestUpper : math.min(existing, pivot_nearestUpper)
f_pivotShortTP(existing) =>
    (not usePivotModule or not usePivotAsTP or na(pivot_nearestLower)) ? existing : na(existing) ? pivot_nearestLower : math.max(existing, pivot_nearestLower)

// 既存TP変数がある場合 (無ければ na を渡す)
float pivot_longTP  = f_pivotLongTP(na)   // 例: f_pivotLongTP(existingLongTP)
float pivot_shortTP = f_pivotShortTP(na)  // 例: f_pivotShortTP(existingShortTP)

// ============================================================
//  優先度3: Pivotスコア
//   既存 signalScore がある場合: signalScore += pivot_scoreBuy / pivot_scoreSell
// ============================================================
int pivot_scoreBuy  = (usePivotModule and usePivotScore and pivot_nearLower and pivot_bullishReversal) ? pivotScoreAdd : 0
int pivot_scoreSell = (usePivotModule and usePivotScore and pivot_nearUpper and pivot_bearishReversal) ? pivotScoreAdd : 0
// 例: signalScore := signalScore + (longCondition ? pivot_scoreBuy : shortCondition ? pivot_scoreSell : 0)

// ============================================================
//  優先度1: Pivotライン表示
// ============================================================
plot(showPivotLines and usePivotModule ? pivot_pp : na, "PP", color = color.new(color.gray, 0),  linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_r1 : na, "R1", color = color.new(color.red, 30),   linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_r2 : na, "R2", color = color.new(color.red, 50),   linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_r3 : na, "R3", color = color.new(color.red, 70),   linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_s1 : na, "S1", color = color.new(color.blue, 30),  linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_s2 : na, "S2", color = color.new(color.blue, 50),  linewidth = 1, style = plot.style_linebr)
plot(showPivotLines and usePivotModule ? pivot_s3 : na, "S3", color = color.new(color.blue, 70),  linewidth = 1, style = plot.style_linebr)

// ============================================================
//  優先度3: Pivot統計 (カテゴリ別 件数/勝敗/勝率)
//   ※ strategy() 内でのみ動作。1ポジずつ前提の簡易FIFO集計。
//   カテゴリ: 0=Bounce 1=Sweep 2=BreakRetest 3=NoPivot
// ============================================================
var array<int> pivot_catCount  = array.new_int(4, 0)
var array<int> pivot_catWin    = array.new_int(4, 0)
var array<int> pivot_catLoss   = array.new_int(4, 0)
var array<int> pivot_openCat   = array.new_int()   // エントリー順のカテゴリ(FIFO)
var int pivot_prevOpen   = 0
var int pivot_prevClosed = 0

if usePivotModule and usePivotStats
    // --- 新規エントリー検出 → カテゴリを記録 ---
    if strategy.opentrades > pivot_prevOpen
        bool isLong = strategy.position_size >= 0
        int catLong  = pivot_buySweep ? 1 : pivot_buyBreakRetest ? 2 : pivot_buyBounce ? 0 : 3
        int catShort = pivot_sellSweep ? 1 : pivot_sellBreakRetest ? 2 : pivot_sellBounce ? 0 : 3
        int cat = isLong ? catLong : catShort
        array.push(pivot_openCat, cat)
        array.set(pivot_catCount, cat, array.get(pivot_catCount, cat) + 1)
    pivot_prevOpen := strategy.opentrades

    // --- 決済検出 → 勝敗を紐付け (FIFO) ---
    if strategy.closedtrades > pivot_prevClosed
        for ti = pivot_prevClosed to strategy.closedtrades - 1
            float pf = strategy.closedtrades.profit(ti)
            int cat = array.size(pivot_openCat) > 0 ? array.shift(pivot_openCat) : 3
            if pf >= 0
                array.set(pivot_catWin, cat, array.get(pivot_catWin, cat) + 1)
            else
                array.set(pivot_catLoss, cat, array.get(pivot_catLoss, cat) + 1)
    pivot_prevClosed := strategy.closedtrades

// 統計テーブル
var table pivot_statTbl = table.new(position.top_right, 5, 6, border_width = 1)
f_pivotCatName(c) =>
    c == 0 ? "Bounce" : c == 1 ? "Sweep" : c == 2 ? "BreakRT" : "NoPivot"
if usePivotModule and usePivotStats and barstate.islast
    table.cell(pivot_statTbl, 0, 0, "Pivot", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(pivot_statTbl, 1, 0, "Cnt",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(pivot_statTbl, 2, 0, "Win",   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(pivot_statTbl, 3, 0, "Loss",  text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(pivot_statTbl, 4, 0, "Win%",  text_color = color.white, bgcolor = color.new(color.blue, 0))
    for c = 0 to 3
        int cnt = array.get(pivot_catCount, c)
        int win = array.get(pivot_catWin, c)
        int los = array.get(pivot_catLoss, c)
        int dec = win + los
        float wr = dec > 0 ? win / dec * 100.0 : na
        table.cell(pivot_statTbl, 0, c + 1, f_pivotCatName(c), text_color = color.white)
        table.cell(pivot_statTbl, 1, c + 1, str.tostring(cnt), text_color = color.white)
        table.cell(pivot_statTbl, 2, c + 1, str.tostring(win), text_color = color.white)
        table.cell(pivot_statTbl, 3, c + 1, str.tostring(los), text_color = color.white)
        table.cell(pivot_statTbl, 4, c + 1, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color = color.white)
    table.cell(pivot_statTbl, 0, 5, "Net Pivot",     text_color = color.white)
    table.cell(pivot_statTbl, 1, 5, str.tostring(usePivotModule), text_color = color.white)
    table.cell(pivot_statTbl, 2, 5, "", text_color = color.white)
    table.cell(pivot_statTbl, 3, 5, "", text_color = color.white)
    table.cell(pivot_statTbl, 4, 5, "", text_color = color.white)

// ============================================================
//  接続 (既存 longCondition / shortCondition に AND)
//   ※ 下を有効化して、あなたの strategy.entry に finalLong/Short を渡す。
//   各 use 系 OFF 時は Ok 変数が true なので既存挙動を変えない。
// ============================================================
// 反発/Sweep/BreakRetest は Any/All で結合した pivotEntryOk を使用。
// Block/Room はリスクフィルターなので常に AND。
// bool finalLongCondition  = longCondition  and pivotEntryOkBuy  and pivotBlockOkBuy  and pivotRoomOkBuy
// bool finalShortCondition = shortCondition and pivotEntryOkSell and pivotBlockOkSell and pivotRoomOkSell
//
// if finalLongCondition
//     strategy.entry("Long", strategy.long)
//     // TP例: strategy.exit("L-TP", "Long", limit = pivot_longTP)
// if finalShortCondition
//     strategy.entry("Short", strategy.short)
//     // TP例: strategy.exit("S-TP", "Short", limit = pivot_shortTP)

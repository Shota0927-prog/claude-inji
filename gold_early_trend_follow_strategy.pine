//@version=5
// =============================================================================
// Gold Early Trend Follow Strategy  ×  ①〜⑤ Range Definition  ×  H&S Trigger
// -----------------------------------------------------------------------------
//  ・元戦略「Gold Range H&S Reversion」の骨格(ボラ基盤/①〜⑤レンジ定義/H&S検出/
//    資金管理/建値移動/再エントリー/MAスナップ/Obstacle/セッション/Info Table)を流用。
//  ・違い = 「レンジ内の反転売買」→「レンジ外(トレンド)での順張り」。
//      レンジ端の定義 = ①〜⑤（固定ゾーン＋反発カウント／rangeValid）※絶対変更なし
//      トレンド判定   = rangeValidではない + fastVolOk + 方向確定（ADX不使用）
//                       trendMode:
//                         ShortST  = 短期スーパートレンド方向で確定（早さ重視・既定）
//                                    ST方向が消えたら trendRegime=0（長くラッチしない）
//                         BreakRun = レンジ外終値の連続維持 → trendRegime をラッチ
//                                    1=上昇/-1=下降/0=なし/2=上昇終了後監視/-2=下降終了後監視
//                       ※ShortSTはトレンドレジーム判定のみに使用（エントリーシグナルではない）
//      エントリー     = トレンド方向に一致する H&S が出たら順張りIN
//                         上昇(regime=+1) → 逆三尊(inverse H&S, 安値圏) → BUY
//                         下降(regime=-1) → 三尊  (H&S, 高値圏)         → SELL
//                       右肩=左肩±許容への戻り(=押し目/戻り) + 反転足 で確定。
//  ・下流コードは rangeHigh/rangeLow/rangeMid/rangeWidth/isRange の名前を維持。
//  ・ADX は一切使用しない。
// =============================================================================
strategy("Gold Early Trend Follow Strategy (①〜⑤ Range → Trend H&S)",
     overlay              = true,
     pyramiding           = 0,
     calc_on_order_fills  = false,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     initial_capital      = 1000,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 0.0,
     max_labels_count     = 500)

// =============================================================================
// 1) Inputs
// =============================================================================
grpVol = "0) Volatility Base"
atrLenBase = input.int(14, "基準ATR本数", minval=1, group=grpVol)
atrTf      = input.timeframe("", "基準ATR時間足(空=チャート)", group=grpVol)
baseAtr    = atrTf == "" ? ta.atr(atrLenBase)
                         : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead=barmerge.lookahead_off)
useMinVol    = input.bool(false,  "低ボラ時はエントリー禁止", group=grpVol)
minAtrDollar = input.float(1.5,  "最低ATR($) これ未満は入らない", minval=0.0, step=0.1, group=grpVol)
volModeRel  = input.bool(false,  "低ボラ判定を相対(ATR平均比)にする", group=grpVol)
volAvgLen   = input.int(480,    "ATR平均の本数(相対用)", minval=10, group=grpVol)
volRatioMin = input.float(0.9,  "ATR ÷ ATR平均 の最低比", minval=0.1, step=0.05, group=grpVol)
atrAvg      = ta.sma(baseAtr, volAvgLen)
volOk = not useMinVol or (volModeRel ? (baseAtr >= atrAvg * volRatioMin) : (baseAtr >= minAtrDollar))

useFastVol       = input.bool(true,  "高速ボラフィルター(fastATR/実体/比率)", group=grpVol)
fastAtrLen       = input.int(5,    "fastATR 本数", minval=1, group=grpVol)
fastAtrMin       = input.float(1.2, "① fastATR 最低($)", step=0.1, group=grpVol)
bodyAvgLen       = input.int(5,    "実体平均 本数", minval=1, group=grpVol)
bodyAvgMin       = input.float(0.5, "② 実体平均 最低($)", step=0.1, group=grpVol)
atrRangeRatioMin = input.float(0.0,"③ fastATR ÷ RangeWidth 最低比(0=無効)", step=0.01, group=grpVol)

// ===== ①〜⑤ レンジ定義の入力（絶対変更なし） =====
grpRangeDef = "1') Range Definition (①〜⑤)"
emaLen            = input.int(200, "① EMA Length",              minval=1, group=grpRangeDef)
emaSlopeLookback  = input.int(20,  "① EMA Slope Lookback",      minval=1, group=grpRangeDef)
emaSlopeThreshold = input.float(3.0,"① EMA Slope Threshold",    step=0.1, group=grpRangeDef)
rangeLookback     = input.int(20,  "② Range Lookback(再アンカー)", minval=2, group=grpRangeDef)
minRangeWidth     = input.float(10,"② Min Range Width",         step=0.5, group=grpRangeDef)
maxRangeWidth     = input.float(50,"② Max Range Width",         step=0.5, group=grpRangeDef)
touchToleranceATR = input.float(1.5,"③④ Touch Tolerance(×ATR)", step=0.1, group=grpRangeDef)
minUpperReactions = input.int(2,   "③ Min Upper Reactions",     minval=1, group=grpRangeDef)
minLowerReactions = input.int(2,   "④ Min Lower Reactions",     minval=1, group=grpRangeDef)
rangeQualityMin   = input.float(3, "⑤ Range Width ÷ ATR Min",   step=0.5, group=grpRangeDef)

grpRange   = "1) MA (補助)"
maFastLen  = input.int(20,   "MA Fast Len", minval=1, group=grpRange)
maMidLen   = input.int(50,   "MA Mid Len",  minval=1, group=grpRange)
maSlowLen  = input.int(100,  "MA Slow Len", minval=1, group=grpRange)

// ===== ★Early Trend（rangeValid外 + fastVolOk + 短期ST方向 / ADX不使用）=====
grpTrend = "2) Early Trend Definition"
trendMode          = input.string("ShortST", "Trend Mode", options=["ShortST","BreakRun","BreakRun+EMA"], group=grpTrend)
shortStFactor      = input.float(3.0,  "短期ST Factor", step=0.1, group=grpTrend)
shortStAtrLen      = input.int(10,     "短期ST ATR Length", minval=1, group=grpTrend)
useStCloseSideFilter = input.bool(true, "終値がSTラインの順行側にあることを要求", group=grpTrend)
trendBreakAtrMult  = input.float(0.3,  "レンジ外ブレイク判定 ATR× (BreakRun)", minval=0.0, step=0.05, group=grpTrend)
trendBreakBars     = input.int(2,      "レンジ外終値の連続本数 (BreakRun)",    minval=1, group=grpTrend)
useTrendBodyFilter = input.bool(false, "トレンド足 実体フィルター",  group=grpTrend)
trendBodyMult      = input.float(1.2,  "実体 > 平均実体(20) ×",     step=0.1, group=grpTrend)
trendExitSwingLen     = input.int(10,  "トレンド解除用スイング本数 (BreakRun)", minval=2, group=grpTrend)
useEma20TrendExit     = input.bool(true, "EMA20もトレンド解除に使う (BreakRun)", group=grpTrend)
trendReentryBars      = input.int(2,   "復帰/転換の連続終値本数 (BreakRun)",    minval=1, group=grpTrend)
useEma20ReentryFilter = input.bool(true, "復帰/転換にEMA20方向を要求 (BreakRun)", group=grpTrend)

// ===== ★Head & Shoulder（トレンド方向に一致するH&Sで順張り）=====
grpHS = "3) Head & Shoulder (Trigger)"
patternTf            = input.timeframe("5", "Pattern TF (左肩/頭の検出)", group=grpHS)
pivotLen             = input.int(3,    "Pivot length (左肩/頭)", minval=1, group=grpHS)
shoulderTolerancePct = input.float(0.003, "右肩=左肩±許容率(=押し目/戻り)", step=0.001, group=grpHS)
useSweep = input.bool(false, "右肩で流動性狩り(スイープ)を要求", group=grpHS)
useHeadProm  = input.bool(true, "頭と肩の高低差を要求", group=grpHS)
headPromMult = input.float(1.0, "頭-肩 > ATR ×", step=0.1, group=grpHS)
useHeadRecency = input.bool(false, "右肩は頭から一定本数内のみ", group=grpHS)
headMaxBars    = input.int(30, "頭からの最大本数", minval=1, group=grpHS)

// ===== ★Reversal Candle（ヒゲ抜け・V反転を抑制 / H&S右肩の確定足）=====
grpRev = "4) Reversal Candle"
useBodyFilter = input.bool(true,  "包み足の実体強度を要求", group=grpRev)
bodyMult      = input.float(1.2,  "実体 > 平均実体(20) ×",  step=0.1, group=grpRev)
pinWickRatio  = input.float(0.7,  "ピンバーのヒゲ比率(0-1)", minval=0.1, maxval=1.0, step=0.05, group=grpRev)

// ===== ★押し目ゾーン(任意)：右肩がレンジ端/EMA20付近である事も要求 =====
grpPB = "4') Pullback Zone (任意)"
usePullbackZone = input.bool(false, "押し目/戻りゾーンも要求(レンジ端/EMA20)", group=grpPB)
pullbackMode    = input.string("RangeEdge", "Pullback Mode", options=["RangeEdge","EMA20","Both"], group=grpPB)
pullbackAtrMult = input.float(0.5, "押し目/戻り許容 ATR×", minval=0.0, step=0.1, group=grpPB)
emaPullbackLen  = input.int(20,    "EMA Pullback Length",   minval=1, group=grpPB)

grpObstacle = "5) Obstacle Filter"
useObstacleFilter = input.bool(false,  "Use Obstacle Filter",      group=grpObstacle)
swingLen          = input.int(10,     "Swing Pivot Lookback",     minval=2, group=grpObstacle)
usePivotObstacle  = input.bool(false, "Use Swing Pivot as Obstacle", group=grpObstacle)
useMaObstacle = input.bool(false, "MAも障害物に含める", group=grpObstacle)
obstacleMaxDistMult = input.float(1.67, "Obstacle Max (xATR)", minval=0.1, step=0.1, group=grpObstacle)
obstacleMaxDist = baseAtr * obstacleMaxDistMult

grpWin     = "6) TP / SL / Risk"
slFixed   = input.float(15.0, "SL ($/固定)", minval=0.1, step=0.1, group=grpWin)
useAtrSL  = input.bool(true, "SLをATR可変にする", group=grpWin)
atrSLMult = input.float(2.0, "SL用ATR係数", minval=0.1, step=0.1, group=grpWin)
slSwingLen = input.int(10,   "SL用 直近高安 本数", minval=1, group=grpWin)
useHeadSL  = input.bool(true, "SLを頭(Head)の外側にも置く", group=grpWin)
riskPctPerTrade   = input.float(5.0, "Risk % per Trade", minval=0.1, step=0.1, group=grpWin)
useRRTP   = input.bool(true,  "TPをRR比率で出す", group=grpWin)
rrRatio   = input.float(1.5,  "RR (TP = Risk × RR)", minval=0.1, step=0.1, group=grpWin)
tpFixed   = input.float(20.0, "TP ($/固定:RR OFF時)", minval=0.1, step=0.1, group=grpWin)
winZoneMult = input.float(0.2, "Win Zone 余地(xRisk)", minval=0.0, step=0.1, group=grpWin)
minTpDist    = input.float(2.0,  "最小TP距離($) 安全弁", minval=0.1, step=0.1, group=grpWin)
minRiskGuard = input.float(3.0, "最小リスク幅($)", minval=0.1, step=0.1, group=grpWin)

useBreakeven = input.bool(true,  "建値移動を使う", group=grpWin)
beTrigger    = input.float(0.8,  "建値移動の発動(xTP到達)", minval=0.1, maxval=1.0, step=0.05, group=grpWin)
beOffset     = input.float(0.0,  "建値オフセット($) +で少し利益側", step=0.1, group=grpWin)

useReentry = input.bool(false, "建値決済後に再エントリー", group=grpWin)
maxReentry = input.int(1, "再エントリー最大回数", minval=1, group=grpWin)

useMaSLTP  = input.bool(false, "MAでSL調整", group=grpWin)
maSlBuffer = input.float(10.0, "MAスナップ余白：SL($)", minval=0.0, step=0.1, group=grpWin)
maSnapMaxMult   = input.float(1.2, "EMAスナップ許容（当初SLの何倍まで）", minval=1.0, step=0.1, group=grpWin)
useMaTP         = input.bool(false, "MAでTP調整（±バンド）", group=grpWin)
maTpBuffer      = input.float(1.0,  "MAスナップ余白：TP($)", minval=0.0, step=0.1, group=grpWin)
maTpSnapBandPct = input.float(30.0, "TPスナップ許容バンド(±%)", minval=0.0, step=1.0, group=grpWin)

grpTrendF  = "7) Trend Confirm Filter (ADX不使用)"
useMaAlign  = input.bool(false, "MAパーフェクトオーダーで方向確認", group=grpTrendF)
useStFilter = input.bool(false, "上位足スーパートレンドで順張りのみ", group=grpTrendF)
stTf        = input.timeframe("1440", "ST 時間足",     group=grpTrendF)
stFactor    = input.float(3.0, "ST Factor", step=0.1, group=grpTrendF)
stAtrLen    = input.int(10,  "ST ATR Length", minval=1, group=grpTrendF)

grpSession = "8) Session Filter (Asia/Tokyo time)"
useTokyoSession   = input.bool(true,  "Tokyo  10:00-16:00",     group=grpSession)
useLondonSession  = input.bool(true,  "London 16:00-21:00",     group=grpSession)
useNYSession      = input.bool(true, "NY     21:00-03:00",     group=grpSession)
manualNewsBlock   = input.bool(false, "Manual News Block (OFF=trade, ON=no trade)", group=grpSession)
avoidOpenMin    = input.bool(false, "セッション初動を回避", group=grpSession)
blockLondonOpen = input.session("1600-1645", "London初動ブロック帯", group=grpSession)
blockNYOpen     = input.session("2100-2145", "NY初動ブロック帯",     group=grpSession)
useYearEndBlock = input.bool(true, "年末年始は停止(12/25-1/7)", group=grpSession)

grpDisp    = "9) Display"
showRange         = input.bool(true,  "Show Range Lines",       group=grpDisp)
showBgRange       = input.bool(true,  "Color Background (Range/Trend)",group=grpDisp)
showPatternMarks  = input.bool(true,  "Show Head/Shoulder & Trend Marks", group=grpDisp)
showEntryLabels   = input.bool(true,  "Show Entry/SL/TP Labels",group=grpDisp)
showInfoTable     = input.bool(true,  "Show Info Table",        group=grpDisp)

// =============================================================================
// 2) Core Calculations
// =============================================================================
maFast = ta.ema(close, maFastLen)
maMid  = ta.ema(close, maMidLen)
maSlow = ta.ema(close, maSlowLen)

ema_1m_1000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1m_3000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_5m_1000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_5m_3000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_15m_1000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_15m_3000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_1h_1000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1h_3000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_4h_1000  = request.security(syminfo.tickerid, "240", ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_4h_3000  = request.security(syminfo.tickerid, "240", ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
maArr = array.from(ema_1m_1000, ema_1m_3000, ema_5m_1000, ema_5m_3000, ema_15m_1000, ema_15m_3000, ema_1h_1000, ema_1h_3000, ema_4h_1000, ema_4h_3000)

// =============================================================================
// 2') ①〜⑤ Range Definition（固定ゾーン＋反発カウント）  ※絶対変更なし
// =============================================================================
ema200 = ta.ema(close, emaLen)
hh  = ta.highest(high, rangeLookback)
ll  = ta.lowest(low,  rangeLookback)
tol = baseAtr * touchToleranceATR

var float rangeHighFixed = na
var float rangeLowFixed  = na
var int   upperReactions = 0
var int   lowerReactions = 0
var bool  inUpperZone    = false
var bool  inLowerZone    = false

if barstate.isconfirmed
    needInit  = na(rangeHighFixed) or na(rangeLowFixed)
    brokeUp   = not needInit and close > rangeHighFixed + tol and close[1] > rangeHighFixed + tol
    brokeDown = not needInit and close < rangeLowFixed  - tol and close[1] < rangeLowFixed  - tol
    if needInit or brokeUp or brokeDown
        rangeHighFixed := hh
        rangeLowFixed  := ll
        upperReactions := 0
        lowerReactions := 0
        inUpperZone    := false
        inLowerZone    := false
    else
        if high >= rangeHighFixed - tol
            inUpperZone := true
        if inUpperZone and close < rangeHighFixed - tol
            upperReactions += 1
            inUpperZone    := false
        if low <= rangeLowFixed + tol
            inLowerZone := true
        if inLowerZone and close > rangeLowFixed + tol
            lowerReactions += 1
            inLowerZone    := false

emaSlopeNorm     = math.abs((ema200 - ema200[emaSlopeLookback]) / baseAtr)
emaSlopeOK       = emaSlopeNorm < emaSlopeThreshold
rangeWidthVal    = rangeHighFixed - rangeLowFixed
rangeWidthOK     = rangeWidthVal >= minRangeWidth and rangeWidthVal <= maxRangeWidth
upperReactionsOK = upperReactions >= minUpperReactions
lowerReactionsOK = lowerReactions >= minLowerReactions
rangeQuality     = rangeWidthVal / baseAtr
rangeQualityOK   = rangeQuality >= rangeQualityMin
rangeValid       = emaSlopeOK and rangeWidthOK and upperReactionsOK and lowerReactionsOK and rangeQualityOK

rangeHigh  = rangeHighFixed
rangeLow   = rangeLowFixed
rangeWidth = rangeWidthVal
rangeMid   = (rangeHighFixed + rangeLowFixed) / 2.0
isRange    = rangeValid

// 高速ボラフィルター（絶対値＋実体＋レンジ比 ※比率は0で無効化可）
fastAtr       = ta.atr(fastAtrLen)
bodyAvgFast   = ta.sma(math.abs(close - open), bodyAvgLen)
atrRangeRatio = rangeWidth > 0 ? fastAtr / rangeWidth : 0.0
fastVolOk = not useFastVol or (fastAtr >= fastAtrMin and bodyAvgFast >= bodyAvgMin and atrRangeRatio >= atrRangeRatioMin)

// =============================================================================
// 3) Early Trend Detection（ADX不使用）→ trendRegime
//    トレンド候補 = rangeValidではない + fastVolOk
//    ShortST  : 短期スーパートレンド方向で確定（早さ重視・既定）
//    BreakRun : レンジ外終値が trendBreakBars 本連続でブレイクレベルを維持
// =============================================================================
ema20 = ta.ema(close, emaPullbackLen)

trendCandidate = not rangeValid and fastVolOk

bodyAbs20       = ta.sma(math.abs(close - open), 20)
trendBodyStrong = not useTrendBodyFilter or math.abs(close - open) > bodyAbs20 * trendBodyMult

// --- 短期スーパートレンド（トレンドレジーム判定にのみ使用 / エントリーには使わない） ---
[shortStLine, shortStDirRaw] = ta.supertrend(shortStFactor, shortStAtrLen)
shortStBullish = shortStDirRaw < 0      // TradingView仕様: dir<0=bullish
shortStBearish = shortStDirRaw > 0      //                   dir>0=bearish
shortStBuyOk  = shortStBullish and (not useStCloseSideFilter or close > shortStLine)
shortStSellOk = shortStBearish and (not useStCloseSideFilter or close < shortStLine)

trendUpShortST   = trendCandidate and shortStBuyOk
trendDownShortST = trendCandidate and shortStSellOk

// --- BreakRun系（既存・残置） ---
breakLevelUpTrend = rangeHigh + baseAtr * trendBreakAtrMult
breakLevelDnTrend = rangeLow  - baseAtr * trendBreakAtrMult

int upRunCount = 0
int dnRunCount = 0
for i = 0 to trendBreakBars - 1
    if close[i] > breakLevelUpTrend[i]
        upRunCount += 1
    if close[i] < breakLevelDnTrend[i]
        dnRunCount += 1
trendBrokeUpRun   = upRunCount   == trendBreakBars
trendBrokeDownRun = dnRunCount == trendBreakBars

trendUpBreakRun   = trendCandidate and trendBrokeUpRun   and trendBodyStrong
trendDownBreakRun = trendCandidate and trendBrokeDownRun and trendBodyStrong

trendUpBreakRunEma   = trendUpBreakRun   and close > ema200
trendDownBreakRunEma = trendDownBreakRun and close < ema200

// --- 最終判定 ---
trendUp = trendMode == "ShortST"  ? trendUpShortST :
          trendMode == "BreakRun" ? trendUpBreakRun :
          trendUpBreakRunEma

trendDown = trendMode == "ShortST"  ? trendDownShortST :
            trendMode == "BreakRun" ? trendDownBreakRun :
            trendDownBreakRunEma

// --- トレンド解除/復帰/転換の判定材料（BreakRun系のラッチ用） ---
// recentHighForExit/Low は「現在足を除く」直近スイング（[1]）
recentHighForExit = ta.highest(high, trendExitSwingLen)[1]
recentLowForExit  = ta.lowest(low,  trendExitSwingLen)[1]

// trendRegime: 1=上昇 / -1=下降 / 0=なし / 2=上昇終了後の監視 / -2=下降終了後の監視
var int trendRegime = 0

// 早期トレンド終了（レンジ端まで戻るのを待たずに検知 / BreakRun系）
exitUpTrend   = trendRegime == 1  and close < recentLowForExit  and (not useEma20TrendExit or close < ema20)
exitDownTrend = trendRegime == -1 and close > recentHighForExit and (not useEma20TrendExit or close > ema20)

// 監視状態からの復帰/転換用：直近 trendReentryBars 本連続の終値ブレイク（BreakRun系）
int reBreakUpCount   = 0
int reBreakDownCount = 0
for i = 0 to trendReentryBars - 1
    if close[i] > recentHighForExit[i]
        reBreakUpCount += 1
    if close[i] < recentLowForExit[i]
        reBreakDownCount += 1
reBreakUp   = reBreakUpCount   == trendReentryBars
reBreakDown = reBreakDownCount == trendReentryBars

// --- trendRegime の更新 ---
if barstate.isconfirmed
    if trendMode == "ShortST"
        // ShortST: ST方向に素直に追従。方向が消えたら即0（長くラッチしない）
        if rangeValid
            trendRegime := 0
        else if trendUp
            trendRegime := 1
        else if trendDown
            trendRegime := -1
        else
            trendRegime := 0
    else
        // BreakRun / BreakRun+EMA: 既存のラッチ + 監視状態の状態遷移を維持
        if rangeValid
            trendRegime := 0                               // レンジ復帰 → 解除（最優先）
        else if trendRegime == 1
            if exitUpTrend or close < rangeLow             // 早期終了 or 反対側レンジ抜け
                trendRegime := 2
        else if trendRegime == -1
            if exitDownTrend or close > rangeHigh
                trendRegime := -2
        else if trendRegime == 2
            if reBreakDown and fastVolOk and (not useEma20ReentryFilter or close < ema20)
                trendRegime := -1
            else if reBreakUp and fastVolOk
                trendRegime := 1
        else if trendRegime == -2
            if reBreakUp and fastVolOk and (not useEma20ReentryFilter or close > ema20)
                trendRegime := 1
            else if reBreakDown and fastVolOk
                trendRegime := -1
        else
            if trendUp
                trendRegime := 1
            else if trendDown
                trendRegime := -1

// =============================================================================
// 4) Head & Shoulder 検出（左肩/頭=Pivot確定, 右肩=左肩±許容への戻り）
//    ※元戦略のH&S検出ロジックをそのまま流用
// =============================================================================
// 上位足ピボット（lookahead_off / 確定値のみ）= 左肩/頭の確定に使用
[htfPh, htfPl, htfTime] = request.security(syminfo.tickerid, patternTf,
     [ta.pivothigh(pivotLen, pivotLen), ta.pivotlow(pivotLen, pivotLen), time],
     lookahead = barmerge.lookahead_off)
newHTF = na(htfTime[1]) ? false : (htfTime != htfTime[1])

var float[] phVals = array.new_float()
var int[]   phIdx  = array.new_int()
var float[] plVals = array.new_float()
var int[]   plIdx  = array.new_int()
var int htfCount = 0

var float sellHeadHigh         = na   // 頭(最高PH)
var float sellLeftShoulderHigh = na   // 左肩(頭より前で頭より低い直近PH)
var float buyHeadLow           = na   // 頭(最安PL)
var float buyLeftShoulderLow   = na   // 左肩(頭より前で頭より高い直近PL)
var int sellHeadBar = na
var int buyHeadBar  = na

if newHTF
    htfCount += 1
    if not na(htfPh)
        array.push(phVals, htfPh)
        array.push(phIdx, htfCount - pivotLen)
        if array.size(phVals) > 8
            array.shift(phVals)
            array.shift(phIdx)
    if not na(htfPl)
        array.push(plVals, htfPl)
        array.push(plIdx, htfCount - pivotLen)
        if array.size(plVals) > 8
            array.shift(plVals)
            array.shift(plIdx)

    // --- 三尊(H&S): 頭=最高PH / 左肩=頭より前で頭より低い直近PH ---
    int nH = array.size(phVals)
    if nH >= 2
        float _hd = na
        int   _hdI = na
        for i = 0 to nH - 1
            float v = array.get(phVals, i)
            if na(_hd) or v > _hd
                _hd  := v
                _hdI := array.get(phIdx, i)
        float _ls = na
        int   _lsI = na
        for i = 0 to nH - 1
            int idx = array.get(phIdx, i)
            float v = array.get(phVals, i)
            if idx < _hdI and v < _hd
                if na(_lsI) or idx > _lsI
                    _lsI := idx
                    _ls  := v
        if not na(_hd) and not na(_ls) and _hd > _ls
            if na(sellHeadHigh) or _hd != sellHeadHigh
                sellHeadBar := bar_index
            sellHeadHigh         := _hd
            sellLeftShoulderHigh := _ls

    // --- 逆三尊(inverse H&S): 頭=最安PL / 左肩=頭より前で頭より高い直近PL ---
    int nL = array.size(plVals)
    if nL >= 2
        float _hdb = na
        int   _hdbI = na
        for i = 0 to nL - 1
            float v = array.get(plVals, i)
            if na(_hdb) or v < _hdb
                _hdb  := v
                _hdbI := array.get(plIdx, i)
        float _lsb = na
        int   _lsbI = na
        for i = 0 to nL - 1
            int idx = array.get(plIdx, i)
            float v = array.get(plVals, i)
            if idx < _hdbI and v > _hdb
                if na(_lsbI) or idx > _lsbI
                    _lsbI := idx
                    _lsb  := v
        if not na(_hdb) and not na(_lsb) and _hdb < _lsb
            if na(buyHeadLow) or _hdb != buyHeadLow
                buyHeadBar := bar_index
            buyHeadLow         := _hdb
            buyLeftShoulderLow := _lsb

// --- 反転足：包み足 or ピンバー（H&S右肩の確定足） ---
body       = math.abs(close - open)
avgBody    = ta.sma(math.abs(close - open), 20)
strongBody = not useBodyFilter or (body > avgBody * bodyMult)

bearEngulf = close < open and open >= close[1] and close <= open[1] and strongBody
bullEngulf = close > open and open <= close[1] and close >= open[1] and strongBody
barRng     = math.max(high - low, syminfo.mintick)
upWick     = high - math.max(open, close)
dnWick     = math.min(open, close) - low
bearPin    = (upWick / barRng) >= pinWickRatio      // 上ヒゲピンバー
bullPin    = (dnWick / barRng) >= pinWickRatio      // 下ヒゲピンバー
sellReversal = bearEngulf or bearPin
buyReversal  = bullEngulf or bullPin

// 流動性狩り：前足高値/安値を取ってから終値で戻す
sweepSell = high > high[1] and close < high[1]
sweepBuy  = low  < low[1]  and close > low[1]

// --- 右肩=左肩±許容への戻り（=押し目/戻り）---
rsCandHigh = math.max(high, high[1])
rsCandLow  = math.min(low,  low[1])
retSell = not na(sellLeftShoulderHigh) and (math.abs(rsCandHigh - sellLeftShoulderHigh) / sellLeftShoulderHigh <= shoulderTolerancePct)
retBuy  = not na(buyLeftShoulderLow)  and (math.abs(rsCandLow  - buyLeftShoulderLow)  / buyLeftShoulderLow  <= shoulderTolerancePct)

// 頭未超
headOkSell = not na(sellHeadHigh) and high <= sellHeadHigh
headOkBuy  = not na(buyHeadLow)   and low  >= buyHeadLow

// 頭と肩の高低差
headPromOkSell = not useHeadProm or (not na(sellHeadHigh) and not na(sellLeftShoulderHigh) and (sellHeadHigh - sellLeftShoulderHigh) > baseAtr * headPromMult)
headPromOkBuy  = not useHeadProm or (not na(buyHeadLow)  and not na(buyLeftShoulderLow)  and (buyLeftShoulderLow - buyHeadLow)  > baseAtr * headPromMult)
// 右肩は頭から一定本数内
recencyOkSell = not useHeadRecency or (not na(sellHeadBar) and (bar_index - sellHeadBar) < headMaxBars)
recencyOkBuy  = not useHeadRecency or (not na(buyHeadBar)  and (bar_index - buyHeadBar)  < headMaxBars)

// --- H&S 引き金（方向別の合成）---
sellHsOk = headOkSell and retSell and sellReversal and (not useSweep or sweepSell) and headPromOkSell and recencyOkSell
buyHsOk  = headOkBuy  and retBuy  and buyReversal  and (not useSweep or sweepBuy)  and headPromOkBuy  and recencyOkBuy

// --- 押し目ゾーン(任意)：右肩がレンジ端/EMA20付近か ---
// 下降→戻りはレンジ下端(=ブレイクした支持→抵抗)やEMA20付近、上昇→押し目は逆
pbSellRange = high >= rangeLow  - baseAtr * pullbackAtrMult
pbSellEma   = high >= ema20     - baseAtr * pullbackAtrMult and high <= ema20 + baseAtr * pullbackAtrMult
pbBuyRange  = low  <= rangeHigh + baseAtr * pullbackAtrMult
pbBuyEma    = low  <= ema20     + baseAtr * pullbackAtrMult and low  >= ema20 - baseAtr * pullbackAtrMult
pullbackSellOk = not usePullbackZone or (pullbackMode == "RangeEdge" ? pbSellRange : pullbackMode == "EMA20" ? pbSellEma : (pbSellRange or pbSellEma))
pullbackBuyOk  = not usePullbackZone or (pullbackMode == "RangeEdge" ? pbBuyRange  : pullbackMode == "EMA20" ? pbBuyEma  : (pbBuyRange  or pbBuyEma))

// =============================================================================
// 5) Obstacle Filter  ※元戦略から流用
// =============================================================================
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)

newDay = ta.change(time("D")) != 0
var float todayHighRun = na
var float todayLowRun  = na
if newDay
    todayHighRun := high
    todayLowRun  := low
else
    todayHighRun := math.max(nz(todayHighRun, high), high)
    todayLowRun  := math.min(nz(todayLowRun,  low),  low)

todayHigh = todayHighRun[7]
todayLow  = todayLowRun[7]

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low,   swingLen, swingLen)
var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(pivotHigh)
    lastSwingHigh := pivotHigh
if not na(pivotLow)
    lastSwingLow  := pivotLow

f_obstacleAbove(_priceRef) =>
    bool found = false
    if not na(prevDayHigh)   and prevDayHigh   > _priceRef and (prevDayHigh   - _priceRef) <= obstacleMaxDist
        found := true
    if not na(todayHigh)     and todayHigh     > _priceRef and (todayHigh     - _priceRef) <= obstacleMaxDist
        found := true
    if usePivotObstacle and not na(lastSwingHigh) and lastSwingHigh > _priceRef and (lastSwingHigh - _priceRef) <= obstacleMaxDist
        found := true
    if useMaObstacle
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            if not na(_m) and _m > _priceRef and (_m - _priceRef) <= obstacleMaxDist
                found := true
    found

f_obstacleBelow(_priceRef) =>
    bool found = false
    if not na(prevDayLow)   and prevDayLow   < _priceRef and (_priceRef - prevDayLow)   <= obstacleMaxDist
        found := true
    if not na(todayLow)     and todayLow     < _priceRef and (_priceRef - todayLow)     <= obstacleMaxDist
        found := true
    if usePivotObstacle and not na(lastSwingLow) and lastSwingLow < _priceRef and (_priceRef - lastSwingLow) <= obstacleMaxDist
        found := true
    if useMaObstacle
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            if not na(_m) and _m < _priceRef and (_priceRef - _m) <= obstacleMaxDist
                found := true
    found

// トレンド順張りでは「進行方向に近い障害物が無い」ことを要求（任意）
obstacleOkBuy  = not useObstacleFilter or not f_obstacleAbove(close)
obstacleOkSell = not useObstacleFilter or not f_obstacleBelow(close)

f_nearestAboveDist(_p) =>
    float d = na
    if not na(prevDayHigh)   and prevDayHigh   > _p
        d := na(d) ? prevDayHigh   - _p : math.min(d, prevDayHigh   - _p)
    if not na(todayHigh)     and todayHigh     > _p
        d := na(d) ? todayHigh     - _p : math.min(d, todayHigh     - _p)
    if usePivotObstacle and not na(lastSwingHigh) and lastSwingHigh > _p
        d := na(d) ? lastSwingHigh - _p : math.min(d, lastSwingHigh - _p)
    d

f_nearestBelowDist(_p) =>
    float d = na
    if not na(prevDayLow)   and prevDayLow   < _p
        d := na(d) ? _p - prevDayLow   : math.min(d, _p - prevDayLow)
    if not na(todayLow)     and todayLow     < _p
        d := na(d) ? _p - todayLow     : math.min(d, _p - todayLow)
    if usePivotObstacle and not na(lastSwingLow) and lastSwingLow < _p
        d := na(d) ? _p - lastSwingLow : math.min(d, _p - lastSwingLow)
    d

// =============================================================================
// 6) Trend Confirm Filter（ADX不使用：MAパーフェクトオーダー / 上位足ST）
// =============================================================================
perfectUp   = maFast > maMid and maMid > maSlow
perfectDown = maFast < maMid and maMid < maSlow
maAlignOkBuy  = not useMaAlign or perfectUp
maAlignOkSell = not useMaAlign or perfectDown

f_stDir() =>
    [_st, _dir] = ta.supertrend(stFactor, stAtrLen)
    _dir
stDir = request.security(syminfo.tickerid, stTf, f_stDir()[1], lookahead = barmerge.lookahead_off)
stBullish = stDir < 0
stBearish = stDir > 0
stOkBuy  = not useStFilter or stBullish
stOkSell = not useStFilter or stBearish

// =============================================================================
// 7) Session Filter (Asia/Tokyo time)  ※元戦略から流用
// =============================================================================
inTokyo  = not na(time(timeframe.period, "1000-1600", "Asia/Tokyo"))
inLondon = not na(time(timeframe.period, "1600-2100", "Asia/Tokyo"))
inNY     = not na(time(timeframe.period, "2100-0300", "Asia/Tokyo"))

sessionOk =
     (useTokyoSession  and inTokyo)  or
     (useLondonSession and inLondon) or
     (useNYSession     and inNY)

noSessionSelected = not useTokyoSession and not useLondonSession and not useNYSession
sessionFinal = noSessionSelected ? false : sessionOk

newsOk = not manualNewsBlock

inOpenBlock = avoidOpenMin and (
     not na(time(timeframe.period, blockLondonOpen, "Asia/Tokyo")) or
     not na(time(timeframe.period, blockNYOpen,     "Asia/Tokyo")))

yM = month(time, "Asia/Tokyo")
yD = dayofmonth(time, "Asia/Tokyo")
inYearEnd = (yM == 12 and yD >= 25) or (yM == 1 and yD <= 7)
yearEndOk = not useYearEndBlock or not inYearEnd

// =============================================================================
// 8) SL / TP / Lots（順張り：SLは頭/直近高安の外側 / TPはRR）
// =============================================================================
riskUSD  = strategy.initial_capital * (riskPctPerTrade / 100.0)

swingLowSL  = ta.lowest(low,  slSwingLen)
swingHighSL = ta.highest(high, slSwingLen)

f_snap_sl_to_ema(_dir, _entry, _slRaw) =>
    _sl = _slRaw
    if useMaSLTP and array.size(maArr) > 0
        _bestMA = float(na)
        _bestD  = float(na)
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            _valid = _dir == 1 ? _m < _entry : _m > _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _slRaw)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maSlBuffer : _bestMA + maSlBuffer
            _cand := _dir == 1 ? math.min(_cand, _entry - minRiskGuard) : math.max(_cand, _entry + minRiskGuard)
            _riskRaw  = math.abs(_entry - _slRaw)
            _riskSnap = math.abs(_entry - _cand)
            if _riskRaw > 0 and _riskSnap <= _riskRaw * maSnapMaxMult
                _sl := _cand
    _sl

f_snap_tp_to_ema(_dir, _entry, _tpRR) =>
    _tp = _tpRR
    if useMaTP and array.size(maArr) > 0
        _rewardRR = math.abs(_tpRR - _entry)
        _bestMA = float(na)
        _bestD  = float(na)
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            _valid = _dir == 1 ? _m > _entry : _m < _entry
            if not na(_m) and _valid
                _d = math.abs(_m - _tpRR)
                if na(_bestD) or _d < _bestD
                    _bestD  := _d
                    _bestMA := _m
        if not na(_bestMA)
            _cand = _dir == 1 ? _bestMA - maTpBuffer : _bestMA + maTpBuffer
            _candReward = _dir == 1 ? _cand - _entry : _entry - _cand
            _band = maTpSnapBandPct / 100.0
            _loR  = _rewardRR * (1.0 - _band)
            _hiR  = _rewardRR * (1.0 + _band)
            if _candReward >= _loR and _candReward <= _hiR
                _tp := _cand
    _tp

// --- BUY 想定 SL/TP/Lots（逆三尊：頭=安値の外側） ---
buyHeadRef = (useHeadSL and not na(buyHeadLow)) ? math.min(swingLowSL, buyHeadLow) : swingLowSL
buySlRaw   = useAtrSL ? close - baseAtr * atrSLMult : close - slFixed
buySl0     = math.min(buySlRaw, buyHeadRef - baseAtr * 0.2)   // 頭/直近安値より浅くしない
buySl1     = f_snap_sl_to_ema(1, close, buySl0)
buySl      = math.min(buySl1, close - minRiskGuard)           // 最小リスク幅を担保
buyRisk    = close - buySl
buyTpDist  = useRRTP ? buyRisk * rrRatio : tpFixed
buyTp      = f_snap_tp_to_ema(1, close, close + buyTpDist)
buyLots    = buyRisk > 0 ? math.floor(riskUSD / buyRisk) : 0
buyWinOk   = (buyTpDist >= minTpDist) and (buyTpDist >= buyRisk * winZoneMult)

// --- SELL 想定 SL/TP/Lots（三尊：頭=高値の外側） ---
sellHeadRef = (useHeadSL and not na(sellHeadHigh)) ? math.max(swingHighSL, sellHeadHigh) : swingHighSL
sellSlRaw   = useAtrSL ? close + baseAtr * atrSLMult : close + slFixed
sellSl0     = math.max(sellSlRaw, sellHeadRef + baseAtr * 0.2) // 頭/直近高値より浅くしない
sellSl1     = f_snap_sl_to_ema(-1, close, sellSl0)
sellSl      = math.max(sellSl1, close + minRiskGuard)
sellRisk    = sellSl - close
sellTpDist  = useRRTP ? sellRisk * rrRatio : tpFixed
sellTp      = f_snap_tp_to_ema(-1, close, close - sellTpDist)
sellLots    = sellRisk > 0 ? math.floor(riskUSD / sellRisk) : 0
sellWinOk   = (sellTpDist >= minTpDist) and (sellTpDist >= sellRisk * winZoneMult)

// =============================================================================
// 9) Entry Conditions（レンジ外トレンド方向に一致するH&Sで順張り）
//    上昇(regime=+1) → 逆三尊 → BUY  /  下降(regime=-1) → 三尊 → SELL
// =============================================================================
baseOk = barstate.isconfirmed and (not isRange) and sessionFinal and newsOk and not inOpenBlock and volOk and fastVolOk and yearEndOk and strategy.position_size == 0

buyEntry  = baseOk and trendRegime == 1  and buyHsOk  and pullbackBuyOk  and obstacleOkBuy  and maAlignOkBuy  and stOkBuy  and buyWinOk  and buyLots  >= 1
sellEntry = baseOk and trendRegime == -1 and sellHsOk and pullbackSellOk and obstacleOkSell and maAlignOkSell and stOkSell and sellWinOk and sellLots >= 1

// =============================================================================
// 10) Strategy Orders（Risk = riskPctPerTrade% per trade / 単利）
// =============================================================================
var float posEntry = na
var float posTP    = na
var int   posDir   = 0
var bool  beDone   = false
var bool  reIsLong     = false
var float reRiskW      = na
var float reTpW        = na
var int   reentryCount = 0
var bool  armReentry   = false

if buyEntry
    strategy.entry("BUY", strategy.long, qty = buyLots)
    strategy.exit("Exit BUY", from_entry="BUY", limit=buyTp, stop=buySl)
    posEntry := close
    posTP    := buyTp
    posDir   := 1
    beDone   := false
    reIsLong := true
    reRiskW  := buyRisk
    reTpW    := math.abs(buyTp - close)
    reentryCount := 0

if sellEntry
    strategy.entry("SELL", strategy.short, qty = sellLots)
    strategy.exit("Exit SELL", from_entry="SELL", limit=sellTp, stop=sellSl)
    posEntry := close
    posTP    := sellTp
    posDir   := -1
    beDone   := false
    reIsLong := false
    reRiskW  := sellRisk
    reTpW    := math.abs(sellTp - close)
    reentryCount := 0

// =============================================================================
// 11) Plot / Display
// =============================================================================
plot(showRange ? rangeHigh : na, "Range High",  color=color.new(color.red,   0), linewidth=1, style=plot.style_linebr)
plot(showRange ? rangeLow  : na, "Range Low",   color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(showRange ? rangeMid  : na, "Range Mid",   color=color.new(color.gray, 0),  style=plot.style_linebr)
plot(ema200, "EMA200", color=color.new(color.blue, 0), linewidth=2)
plot(ema20,  "EMA20",  color=color.new(color.purple, 0), linewidth=1)
plot(shortStLine, "Short Supertrend", color = shortStBullish ? color.green : color.red, linewidth=2)

bgcolor(showBgRange and isRange            ? color.new(color.yellow, 92) : na, title="Range BG")
bgcolor(showBgRange and trendRegime == 1   ? color.new(color.green, 90)  : na, title="Trend Up BG")
bgcolor(showBgRange and trendRegime == -1  ? color.new(color.red, 90)    : na, title="Trend Down BG")
bgcolor(showBgRange and trendRegime == 2   ? color.new(color.green, 96)  : na, title="Trend Up Watch BG")
bgcolor(showBgRange and trendRegime == -2  ? color.new(color.red, 96)    : na, title="Trend Down Watch BG")

// 頭/左肩レベル
plot(showPatternMarks ? sellHeadHigh : na,         "Head High",  color=color.new(color.red, 55),   style=plot.style_circles)
plot(showPatternMarks ? sellLeftShoulderHigh : na, "L.Shoulder H", color=color.new(color.red, 75), style=plot.style_circles)
plot(showPatternMarks ? buyHeadLow : na,           "Head Low",   color=color.new(color.green, 55), style=plot.style_circles)
plot(showPatternMarks ? buyLeftShoulderLow : na,   "L.Shoulder L", color=color.new(color.green, 75), style=plot.style_circles)

// トレンド方向の小矢印
plotshape(showPatternMarks and trendRegime == 1,  title="Trend Up",   style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showPatternMarks and trendRegime == -1, title="Trend Down", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.tiny)

if showEntryLabels and buyEntry
    label.new(bar_index, low,
         text  = "BUY (iH&S)\nE=" + str.tostring(close, "#.##") +
                 "\nSL=" + str.tostring(buySl, "#.##") +
                 "\nTP=" + str.tostring(buyTp, "#.##"),
         style = label.style_label_up,
         color = color.new(color.green, 0),
         textcolor = color.white,
         size  = size.small)

if showEntryLabels and sellEntry
    label.new(bar_index, high,
         text  = "SELL (H&S)\nE=" + str.tostring(close, "#.##") +
                 "\nSL=" + str.tostring(sellSl, "#.##") +
                 "\nTP=" + str.tostring(sellTp, "#.##"),
         style = label.style_label_down,
         color = color.new(color.red, 0),
         textcolor = color.white,
         size  = size.small)

// --- 建値移動 (Breakeven) ---
if useBreakeven and strategy.position_size != 0 and not beDone and posDir != 0
    tpDist = math.abs(posTP - posEntry)
    if posDir == 1 and high >= posEntry + tpDist * beTrigger
        beDone := true
        strategy.exit("Exit BUY", from_entry="BUY", limit=posTP, stop=posEntry + beOffset)
    if posDir == -1 and low <= posEntry - tpDist * beTrigger
        beDone := true
        strategy.exit("Exit SELL", from_entry="SELL", limit=posTP, stop=posEntry - beOffset)

// ===== 建値決済の検知 → 再エントリー =====
if useReentry and beDone[1] and strategy.position_size == 0 and strategy.position_size[1] != 0 and reentryCount < maxReentry and not (sellEntry or buyEntry)
    float _exitP  = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float _entryP = strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    if not na(_exitP) and not na(_entryP) and math.abs(_exitP - _entryP) <= syminfo.mintick * 5
        armReentry := true

if armReentry and strategy.position_size == 0
    float _e2  = close
    float _sl2 = reIsLong ? _e2 - reRiskW : _e2 + reRiskW
    float _tp2 = reIsLong ? _e2 + reTpW   : _e2 - reTpW
    if reRiskW > 0
        reentryCount += 1
        float _lots2 = math.floor(riskUSD / math.max(reRiskW, 0.01))
        if _lots2 >= 1
            if reIsLong
                strategy.entry("BUY", strategy.long, qty=_lots2)
                strategy.exit("Exit BUY", from_entry="BUY", limit=_tp2, stop=_sl2)
            else
                strategy.entry("SELL", strategy.short, qty=_lots2)
                strategy.exit("Exit SELL", from_entry="SELL", limit=_tp2, stop=_sl2)
        posEntry := _e2
        posTP    := _tp2
        posDir   := reIsLong ? 1 : -1
        beDone   := false
        alert("再エントリー(" + str.tostring(reentryCount) + "/" + str.tostring(maxReentry) + ") " + (reIsLong ? "BUY" : "SELL") + " | E=" + str.tostring(_e2, "#.##"), alert.freq_once_per_bar)
    armReentry := false

// =============================================================================
// 12) Alerts（Pattern=TrendHS / Risk幅・Range Width 付き / ADX無し）
// =============================================================================
obsDistBuy  = f_nearestAboveDist(close)
obsDistSell = f_nearestBelowDist(close)

alertcondition(buyEntry,  title="Trend BUY (iH&S)", message="BUY iH&S | E={{close}} (①〜⑤ Range→Trend)")
alertcondition(sellEntry, title="Trend SELL (H&S)", message="SELL H&S | E={{close}} (①〜⑤ Range→Trend)")

if buyEntry
    alert("Dir=BUY"
         + " E="    + str.tostring(close, "#.##")
         + " SL="   + str.tostring(buySl, "#.##")
         + " TP="   + str.tostring(buyTp, "#.##")
         + " Risk=" + str.tostring(buyRisk, "#.##")
         + " RW="   + str.tostring(rangeWidth, "#.##")
         + " ObsDist=" + (na(obsDistBuy) ? "NA" : str.tostring(obsDistBuy, "#.##"))
         + " Pattern=TrendInvHS",
         alert.freq_once_per_bar_close)

if sellEntry
    alert("Dir=SELL"
         + " E="    + str.tostring(close, "#.##")
         + " SL="   + str.tostring(sellSl, "#.##")
         + " TP="   + str.tostring(sellTp, "#.##")
         + " Risk=" + str.tostring(sellRisk, "#.##")
         + " RW="   + str.tostring(rangeWidth, "#.##")
         + " ObsDist=" + (na(obsDistSell) ? "NA" : str.tostring(obsDistSell, "#.##"))
         + " Pattern=TrendHS",
         alert.freq_once_per_bar_close)

// =============================================================================
// 13) Info Table（①〜⑤ + トレンド状態を可視化）
// =============================================================================
var table infoTable = table.new(position.top_right, 2, 12, border_width = 1, frame_width = 1, frame_color = color.gray)
if showInfoTable and barstate.islast
    table.cell(infoTable, 0, 0, "Range High",      text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(rangeHighFixed, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, "Range Low",       text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(rangeLowFixed, "#.##"),  text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "Range Width",     text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(rangeWidthVal, "#.##"),  text_color=(rangeWidthOK?color.lime:color.red), text_size=size.small)
    table.cell(infoTable, 0, 3, "Width ÷ ATR",      text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rangeQuality, "#.##"),   text_color=(rangeQualityOK?color.lime:color.red), text_size=size.small)
    table.cell(infoTable, 0, 4, "Range Valid",     text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 4, (rangeValid?"TRUE":"FALSE"),          text_color=(rangeValid?color.lime:color.red), text_size=size.small)
    table.cell(infoTable, 0, 5, "Trend Cand.",     text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 5, (trendCandidate?"TRUE":"FALSE"),      text_color=(trendCandidate?color.lime:color.gray), text_size=size.small)
    table.cell(infoTable, 0, 6, "Trend Regime",    text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    regimeTxt = trendRegime==1?"UP":trendRegime==-1?"DOWN":trendRegime==2?"WATCH UP":trendRegime==-2?"WATCH DN":"-"
    regimeCol = trendRegime==1?color.lime:trendRegime==-1?color.red:trendRegime==2?color.new(color.lime,40):trendRegime==-2?color.new(color.red,40):color.gray
    table.cell(infoTable, 1, 6, regimeTxt, text_color=regimeCol, text_size=size.small)
    table.cell(infoTable, 0, 7, "Sell H&S Ready",  text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 7, (sellHsOk?"TRUE":"FALSE"),            text_color=(sellHsOk?color.lime:color.gray), text_size=size.small)
    table.cell(infoTable, 0, 8, "Buy iH&S Ready",  text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 8, (buyHsOk?"TRUE":"FALSE"),            text_color=(buyHsOk?color.lime:color.gray), text_size=size.small)
    table.cell(infoTable, 0, 9, "Head H / Head L", text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 9, (na(sellHeadHigh)?"-":str.tostring(sellHeadHigh,"#.#")) + " / " + (na(buyHeadLow)?"-":str.tostring(buyHeadLow,"#.#")), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 10, "Trend Mode",     text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 10, trendMode,        text_color=color.white, text_size=size.small)
    stDirTxt = shortStBullish ? "BULL" : shortStBearish ? "BEAR" : "-"
    stDirCol = shortStBullish ? color.lime : shortStBearish ? color.red : color.gray
    table.cell(infoTable, 0, 11, "Short ST Dir",   text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(infoTable, 1, 11, stDirTxt,         text_color=stDirCol, text_size=size.small)

plot(baseAtr, "baseAtr", color=color.orange, display=display.data_window)

//
// Gold Early Trend Follow Strategy
// XAUUSD向け。既存レンジstrategyのレンジ定義を流用し、
// 「rangeValidではない + ボラあり + レンジ外終値維持」で
// ADXを使わずに早期トレンドを検知し、押し目/戻りで順張りする。

//@version=5
strategy(
     title                   = "Gold Early Trend Follow Strategy",
     shorttitle              = "GoldEarlyTrend",
     overlay                 = true,
     pyramiding              = 0,
     process_orders_on_close = true,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     initial_capital         = 1000,
     calc_on_every_tick      = false,
     max_labels_count        = 500,
     max_bars_back           = 500
 )

// ============================================================
// 1. Volatility Base
// ============================================================
grp_vol = "1. Volatility Base"

baseAtrLen = input.int(14, "Base ATR Length", minval = 1, group = grp_vol)
baseAtrTF  = input.timeframe("", "Base ATR Timeframe (空=チャート足)", group = grp_vol)

// 指定TFのATR（空ならチャート足）
baseAtrLocal = ta.atr(baseAtrLen)
baseAtr = request.security(
     syminfo.tickerid,
     baseAtrTF == "" ? timeframe.period : baseAtrTF,
     baseAtrLocal,
     lookahead = barmerge.lookahead_off
 )

// --- fastVolOk : 低ボラ除外 ---
useFastVol = input.bool(true,  "Use Fast Volatility Filter", group = grp_vol)
fastAtrLen = input.int(5,      "Fast ATR Length",            minval = 1,  group = grp_vol)
fastAtrMin = input.float(1.2,  "Fast ATR Min",               minval = 0,  group = grp_vol)
bodyAvgLen = input.int(5,      "Body Avg Length",            minval = 1,  group = grp_vol)
bodyAvgMin = input.float(0.5,  "Body Avg Min",               minval = 0,  group = grp_vol)

fastAtr     = ta.atr(fastAtrLen)
bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)

fastVolOk = not useFastVol or (fastAtr >= fastAtrMin and bodyAvgFast >= bodyAvgMin)

// ============================================================
// 2. Range Definition（既存レンジstrategyと同じ思想）
// ============================================================
grp_rng = "2. Range Definition"

emaLen            = input.int(200,   "EMA Length",               minval = 1,  group = grp_rng)
emaSlopeLookback  = input.int(20,    "EMA Slope Lookback",       minval = 1,  group = grp_rng)
emaSlopeThreshold = input.float(3.0, "EMA Slope Threshold (ATR)", minval = 0, group = grp_rng)
rangeLookback     = input.int(20,    "Range Lookback",           minval = 1,  group = grp_rng)
minRangeWidth     = input.float(10,  "Min Range Width",          minval = 0,  group = grp_rng)
maxRangeWidth     = input.float(50,  "Max Range Width",          minval = 0,  group = grp_rng)
touchToleranceATR = input.float(1.5, "Touch Tolerance (ATR)",    minval = 0,  group = grp_rng)
minUpperReactions = input.int(2,     "Min Upper Reactions",      minval = 0,  group = grp_rng)
minLowerReactions = input.int(2,     "Min Lower Reactions",      minval = 0,  group = grp_rng)
rangeQualityMin   = input.float(3.0, "Range Quality Min (Width/ATR)", minval = 0, group = grp_rng)

ema200 = ta.ema(close, emaLen)
hh     = ta.highest(high, rangeLookback)
ll     = ta.lowest(low,  rangeLookback)
tol    = baseAtr * touchToleranceATR

// 固定レンジ状態
var float rangeHighFixed = na
var float rangeLowFixed  = na
var int   upperReactions = 0
var int   lowerReactions = 0
var bool  inUpperZone    = false
var bool  inLowerZone    = false
var int   aboveRunCount  = 0
var int   belowRunCount  = 0

// 初期化
if na(rangeHighFixed) or na(rangeLowFixed)
    rangeHighFixed := hh
    rangeLowFixed  := ll

// 終値がレンジ上端/下端 ± tol を2本連続で抜けたら再アンカー
brokeUpClose = close > rangeHighFixed + tol
brokeDnClose = close < rangeLowFixed  - tol
aboveRunCount := brokeUpClose ? aboveRunCount + 1 : 0
belowRunCount := brokeDnClose ? belowRunCount + 1 : 0

if aboveRunCount >= 2 or belowRunCount >= 2
    rangeHighFixed := hh
    rangeLowFixed  := ll
    upperReactions := 0
    lowerReactions := 0
    inUpperZone    := false
    inLowerZone    := false
    aboveRunCount  := 0
    belowRunCount  := 0

// 上端ゾーン滞在 → 終値が戻ったら upperReactions
if high >= rangeHighFixed - tol
    inUpperZone := true
if inUpperZone and close < rangeHighFixed - tol
    upperReactions := upperReactions + 1
    inUpperZone    := false

// 下端ゾーン滞在 → 終値が戻ったら lowerReactions
if low <= rangeLowFixed + tol
    inLowerZone := true
if inLowerZone and close > rangeLowFixed + tol
    lowerReactions := lowerReactions + 1
    inLowerZone    := false

// rangeValid 判定
emaSlopeNorm    = math.abs((ema200 - ema200[emaSlopeLookback]) / baseAtr)
emaSlopeOK      = emaSlopeNorm < emaSlopeThreshold
rangeWidthVal   = rangeHighFixed - rangeLowFixed
rangeWidthOK    = rangeWidthVal >= minRangeWidth and rangeWidthVal <= maxRangeWidth
upperReactionsOK = upperReactions >= minUpperReactions
lowerReactionsOK = lowerReactions >= minLowerReactions
rangeQuality    = rangeWidthVal / baseAtr
rangeQualityOK  = rangeQuality >= rangeQualityMin

rangeValid = emaSlopeOK and rangeWidthOK and upperReactionsOK and lowerReactionsOK and rangeQualityOK

rangeHigh = rangeHighFixed
rangeLow  = rangeLowFixed
rangeMid  = (rangeHigh + rangeLow) / 2

// ============================================================
// 3. Early Trend Definition（ADX不使用）
// ============================================================
grp_trend = "3. Early Trend"

trendBreakAtrMult  = input.float(0.3, "レンジ外ブレイク判定 ATR×",  minval = 0, group = grp_trend)
trendBreakBars     = input.int(2,     "レンジ外終値の連続本数",      minval = 1, group = grp_trend)
trendMode          = input.string("BreakRun", "Trend Mode", options = ["Candidate", "BreakRun", "BreakRun+EMA"], group = grp_trend)
useTrendBodyFilter = input.bool(false, "Use Trend Body Filter",     group = grp_trend)
trendBodyMult      = input.float(1.2,  "Trend Body Mult",           minval = 0, group = grp_trend)

breakLevelUpTrend = rangeHigh + baseAtr * trendBreakAtrMult
breakLevelDnTrend = rangeLow  - baseAtr * trendBreakAtrMult

trendCandidate = not rangeValid and fastVolOk

bodyAbs20 = ta.sma(math.abs(close - open), 20)
trendBodyStrong = not useTrendBodyFilter or math.abs(close - open) > bodyAbs20 * trendBodyMult

// 直近 trendBreakBars 本のcloseがブレイクレベルの上/下を維持しているか
int upRunCount = 0
int dnRunCount = 0
for i = 0 to trendBreakBars - 1
    if close[i] > breakLevelUpTrend[i]
        upRunCount += 1
    if close[i] < breakLevelDnTrend[i]
        dnRunCount += 1
trendBrokeUpRun   = upRunCount == trendBreakBars
trendBrokeDownRun = dnRunCount == trendBreakBars

trendUpCandidate   = trendCandidate and close > rangeHigh and trendBodyStrong
trendDownCandidate = trendCandidate and close < rangeLow  and trendBodyStrong

trendUpBreakRun   = trendCandidate and trendBrokeUpRun   and trendBodyStrong
trendDownBreakRun = trendCandidate and trendBrokeDownRun and trendBodyStrong

trendUpBreakRunEma   = trendUpBreakRun   and close > ema200
trendDownBreakRunEma = trendDownBreakRun and close < ema200

trendUp = trendMode == "Candidate" ? trendUpCandidate :
          trendMode == "BreakRun"  ? trendUpBreakRun  :
          trendUpBreakRunEma

trendDown = trendMode == "Candidate" ? trendDownCandidate :
            trendMode == "BreakRun"  ? trendDownBreakRun  :
            trendDownBreakRunEma

// ============================================================
// 4. Entry Logic（押し目/戻りで入る）
// ============================================================
grp_pb = "4. Pullback Entry"

pullbackMode    = input.string("RangeEdge", "Pullback Mode", options = ["RangeEdge", "EMA20", "Both"], group = grp_pb)
pullbackAtrMult = input.float(0.5, "押し目/戻り許容 ATR×", minval = 0, group = grp_pb)
emaPullbackLen  = input.int(20,    "EMA Pullback Length",   minval = 1, group = grp_pb)

ema20 = ta.ema(close, emaPullbackLen)

// Buy Pullback
pullbackBuyRange = low <= rangeHigh + baseAtr * pullbackAtrMult and close > rangeHigh
pullbackBuyEma   = low <= ema20    + baseAtr * pullbackAtrMult and close > ema20

// Sell Pullback
pullbackSellRange = high >= rangeLow - baseAtr * pullbackAtrMult and close < rangeLow
pullbackSellEma   = high >= ema20    - baseAtr * pullbackAtrMult and close < ema20

pullbackBuyOk = pullbackMode == "RangeEdge" ? pullbackBuyRange :
                pullbackMode == "EMA20"     ? pullbackBuyEma   :
                pullbackBuyRange or pullbackBuyEma

pullbackSellOk = pullbackMode == "RangeEdge" ? pullbackSellRange :
                 pullbackMode == "EMA20"     ? pullbackSellEma   :
                 pullbackSellRange or pullbackSellEma

// ============================================================
// 5. Reversal Candle Trigger（ヒゲ抜け・V反転を抑制）
// ============================================================
grp_rev = "5. Reversal Candle"

useBodyFilter = input.bool(true,  "Use Body Filter",  group = grp_rev)
bodyMult      = input.float(1.2,  "Body Mult",        minval = 0, group = grp_rev)
pinWickRatio  = input.float(0.7,  "Pin Wick Ratio",   minval = 0, maxval = 1, group = grp_rev)

body      = math.abs(close - open)
avgBody   = ta.sma(math.abs(close - open), 20)
strongBody = not useBodyFilter or body > avgBody * bodyMult

bullEngulf = close > open and open <= close[1] and close >= open[1] and strongBody
bearEngulf = close < open and open >= close[1] and close <= open[1] and strongBody

barRng = math.max(high - low, syminfo.mintick)
upWick = high - math.max(open, close)
dnWick = math.min(open, close) - low

bullPin = dnWick / barRng >= pinWickRatio
bearPin = upWick / barRng >= pinWickRatio

buyTrigger  = bullEngulf or bullPin
sellTrigger = bearEngulf or bearPin

// ============================================================
// 7. Session Filter（Asia/Tokyo基準）
// ============================================================
grp_sess = "7. Session Filter"

useTokyoSession = input.bool(true,  "Tokyo 10:00-16:00",  group = grp_sess)
useLondonSession = input.bool(true, "London 16:00-21:00", group = grp_sess)
useNYSession    = input.bool(true,  "NY 21:00-03:00",     group = grp_sess)
avoidOpenMin    = input.bool(false, "Avoid Open Minutes",  group = grp_sess)
blockLondonOpen = input.session("1600-1645", "Block London Open", group = grp_sess)
blockNYOpen     = input.session("2100-2145", "Block NY Open",     group = grp_sess)
useYearEndBlock = input.bool(true,  "Use Year-End Block (12/25-1/7)", group = grp_sess)

tz = "Asia/Tokyo"
inTokyo  = useTokyoSession  and not na(time(timeframe.period, "1000-1600", tz))
inLondon = useLondonSession and not na(time(timeframe.period, "1600-2100", tz))
inNY     = useNYSession     and not na(time(timeframe.period, "2100-0300", tz))
sessionRaw = inTokyo or inLondon or inNY

inBlockLondon = not na(time(timeframe.period, blockLondonOpen, tz))
inBlockNY     = not na(time(timeframe.period, blockNYOpen, tz))
sessionBlocked = avoidOpenMin and (inBlockLondon or inBlockNY)

sessionFinal = sessionRaw and not sessionBlocked

// 年末年始停止 12/25〜1/7
mth = month(time, tz)
dy  = dayofmonth(time, tz)
inYearEnd = (mth == 12 and dy >= 25) or (mth == 1 and dy <= 7)
yearEndOk = not (useYearEndBlock and inYearEnd)

// ============================================================
// 8. SL / TP / Lots
// ============================================================
grp_risk = "8. SL / TP / Risk"

riskPctPerTrade = input.float(5.0,  "Risk % per Trade", minval = 0, group = grp_risk)
useAtrSL        = input.bool(true,  "Use ATR SL",       group = grp_risk)
atrSLMult       = input.float(2.0,  "ATR SL Mult",      minval = 0, group = grp_risk)
slFixed         = input.float(15.0, "Fixed SL",         minval = 0, group = grp_risk)
rrRatio         = input.float(1.5,  "RR Ratio",         minval = 0, group = grp_risk)
minRiskGuard    = input.float(3.0,  "Min Risk Guard",   minval = 0, group = grp_risk)
swingLen        = input.int(10,     "Swing Length",     minval = 1, group = grp_risk)

lastSwingLow  = ta.lowest(low,  swingLen)
lastSwingHigh = ta.highest(high, swingLen)

entryPrice = close

// Buy SL/TP
buySlRaw = useAtrSL ? entryPrice - baseAtr * atrSLMult : entryPrice - slFixed
buySl    = math.min(buySlRaw, lastSwingLow - baseAtr * 0.2)
buySl    := math.min(buySl, entryPrice - minRiskGuard)
buyRisk  = entryPrice - buySl
buyTp    = entryPrice + buyRisk * rrRatio

// Sell SL/TP
sellSlRaw = useAtrSL ? entryPrice + baseAtr * atrSLMult : entryPrice + slFixed
sellSl    = math.max(sellSlRaw, lastSwingHigh + baseAtr * 0.2)
sellSl    := math.max(sellSl, entryPrice + minRiskGuard)
sellRisk  = sellSl - entryPrice
sellTp    = entryPrice - sellRisk * rrRatio

// lot計算
riskUSD  = strategy.initial_capital * riskPctPerTrade / 100
buyLots  = buyRisk  > 0 ? math.floor(riskUSD / buyRisk)  : 0
sellLots = sellRisk > 0 ? math.floor(riskUSD / sellRisk) : 0

// ============================================================
// 6. Final Entry Conditions
// ============================================================
baseOk = barstate.isconfirmed and sessionFinal and fastVolOk and yearEndOk and strategy.position_size == 0

buyEntry  = baseOk and trendUp   and pullbackBuyOk  and buyTrigger  and buyLots  >= 1
sellEntry = baseOk and trendDown and pullbackSellOk and sellTrigger and sellLots >= 1

// ============================================================
// Order Execution + 9. Breakeven
// ============================================================
grp_be = "9. Breakeven"

useBreakeven = input.bool(true, "Use Breakeven",          group = grp_be)
beTrigger    = input.float(0.8, "建値移動の発動 xTP",      minval = 0, group = grp_be)
beOffset     = input.float(0.0, "Breakeven Offset",        group = grp_be)

// ポジション管理用ステート
var float curEntry = na
var float curSl    = na
var float curTp    = na
var bool  beMoved  = false

if buyEntry
    strategy.entry("Long", strategy.long, qty = buyLots)
    curEntry := entryPrice
    curSl    := buySl
    curTp    := buyTp
    beMoved  := false

if sellEntry
    strategy.entry("Short", strategy.short, qty = sellLots)
    curEntry := entryPrice
    curSl    := sellSl
    curTp    := sellTp
    beMoved  := false

// Long のエグジット + 建値移動
if strategy.position_size > 0 and not na(curEntry)
    tpDistL = curTp - curEntry
    if useBreakeven and not beMoved and high >= curEntry + tpDistL * beTrigger
        beMoved := true
    effStopL = beMoved ? curEntry + beOffset : curSl
    strategy.exit("Long Exit", "Long", stop = effStopL, limit = curTp)

// Short のエグジット + 建値移動
if strategy.position_size < 0 and not na(curEntry)
    tpDistS = curEntry - curTp
    if useBreakeven and not beMoved and low <= curEntry - tpDistS * beTrigger
        beMoved := true
    effStopS = beMoved ? curEntry - beOffset : curSl
    strategy.exit("Short Exit", "Short", stop = effStopS, limit = curTp)

// フラットに戻ったらステートをリセット
if strategy.position_size == 0
    curEntry := na
    curSl    := na
    curTp    := na
    beMoved  := false

// ============================================================
// 10. Display
// ============================================================
grp_disp = "10. Display"
showLevels = input.bool(true, "Show Range / EMA Levels", group = grp_disp)

plot(showLevels ? rangeHigh : na, "Range High", color = color.new(color.orange, 0),  linewidth = 1, style = plot.style_linebr)
plot(showLevels ? rangeLow  : na, "Range Low",  color = color.new(color.orange, 0),  linewidth = 1, style = plot.style_linebr)
plot(showLevels ? rangeMid  : na, "Range Mid",  color = color.new(color.gray, 40),   linewidth = 1, style = plot.style_linebr)
plot(showLevels ? ema200    : na, "EMA200",     color = color.new(color.blue, 0),    linewidth = 2)
plot(showLevels ? ema20     : na, "EMA20",      color = color.new(color.purple, 0),  linewidth = 1)

// トレンド方向の小矢印
plotshape(trendUp,   title = "Trend Up",   style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)
plotshape(trendDown, title = "Trend Down", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.tiny)

// エントリーラベル
plotshape(buyEntry,  title = "BUY",  style = shape.labelup,   location = location.belowbar, color = color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellEntry, title = "SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)

// SL / TP ラベル
if buyEntry
    label.new(bar_index, buySl, "SL " + str.tostring(buySl, format.mintick), color = color.new(color.red, 20),   style = label.style_label_up,   textcolor = color.white, size = size.tiny)
    label.new(bar_index, buyTp, "TP " + str.tostring(buyTp, format.mintick), color = color.new(color.green, 20), style = label.style_label_down, textcolor = color.white, size = size.tiny)
if sellEntry
    label.new(bar_index, sellSl, "SL " + str.tostring(sellSl, format.mintick), color = color.new(color.red, 20),   style = label.style_label_down, textcolor = color.white, size = size.tiny)
    label.new(bar_index, sellTp, "TP " + str.tostring(sellTp, format.mintick), color = color.new(color.green, 20), style = label.style_label_up,   textcolor = color.white, size = size.tiny)

// 背景
bgcolor(rangeValid ? color.new(color.yellow, 90) : na, title = "Range Valid BG")
bgcolor(trendUp    ? color.new(color.green, 90)  : na, title = "Trend Up BG")
bgcolor(trendDown  ? color.new(color.red, 90)    : na, title = "Trend Down BG")

// ============================================================
// 11. Alerts
// ============================================================
buyMsg  = "Dir=BUY E="  + str.tostring(entryPrice, format.mintick) + " SL=" + str.tostring(buySl, format.mintick)  + " TP=" + str.tostring(buyTp, format.mintick)  + " Risk=" + str.tostring(buyRisk, format.mintick)  + " Pattern=EarlyTrendPullback"
sellMsg = "Dir=SELL E=" + str.tostring(entryPrice, format.mintick) + " SL=" + str.tostring(sellSl, format.mintick) + " TP=" + str.tostring(sellTp, format.mintick) + " Risk=" + str.tostring(sellRisk, format.mintick) + " Pattern=EarlyTrendPullback"

if buyEntry
    alert(buyMsg, alert.freq_once_per_bar_close)
if sellEntry
    alert(sellMsg, alert.freq_once_per_bar_close)

alertcondition(buyEntry,  title = "Trend BUY",  message = "Dir=BUY E={{close}} SL=? TP=? Risk=? Pattern=EarlyTrendPullback")
alertcondition(sellEntry, title = "Trend SELL", message = "Dir=SELL E={{close}} SL=? TP=? Risk=? Pattern=EarlyTrendPullback")

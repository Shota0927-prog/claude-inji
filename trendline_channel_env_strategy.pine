//
// ============================================================
//  Trendline / Channel 環境認識ストラテジー
// ------------------------------------------------------------
//  ・エントリー：
//    既存トリガー
//  ・環境認識：
//    EMAトレンド環境
//    +
//    Trendline / Channel MTF環境
//    日足 / 4H / 1H / 15M
//  ・Trendline / ChannelはWinZoneではなく、
//    エントリー方向フィルターとして使用
//  ・上位足は確定足のみを使用し、非リペイント
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "Trendline Channel Env Strategy",
     shorttitle        = "TLCHENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 200
 )

// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 下位足トリガー確認 (OFF で request.security を呼ばない)
useLowerTFTrigger = input.bool(false, "下位足トリガー確認 (重い)")
triggerTF         = input.timeframe("5", "下位足TF")
triggerTFMode     = input.string("CurrentOnly", "現在足/下位足 結合", options = ["CurrentOnly", "LowerOnly", "CurrentAndLower", "CurrentOrLower"])

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
useOppositeTriggerNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"])
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時")
slFixed     = input.float(15, "固定SL幅 (価格) ※固定時")
rrRatio     = input.float(2.0, "リスクリワード比 (TP)")

useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4f. 入力 : Trendline / Channel 環境認識モジュール (日足 / 4H / 1H / 15M)
// ------------------------------------------------------------
//  上位足の確定足のみで Trendline / Channel を生成し、方向イベント
//  (反発 / ブレイク / リテスト / Fake Break / Channel位置Bias) から
//  各足の優勢 (1/0/-1) を判定。複数足を統合し EMAトレンド環境と結合する。
//  ※ 非リペイント: request.security + lookahead_on + 確定1本前[1] を使用。
//  ※ WinZoneではなくエントリー方向フィルターとして使用。
// ============================================================
grpTLEnv = "Trendline / Channel 環境認識"
useTLEnv = input.bool(true, "Trendline/Channel環境認識を使う", group = grpTLEnv)
tlEnvCombineMode = input.string("TrendAndTL", "トレンド環境との結合", options = ["TrendOnly", "TLOnly", "TrendAndTL", "TrendOrTL"], group = grpTLEnv)
// --- 対象時間足 (OFFにした足は request.security を呼ばない) ---
useTLEnvDaily = input.bool(false, "日足を使う", group = grpTLEnv)
useTLEnv4H    = input.bool(false, "4時間足を使う", group = grpTLEnv)
useTLEnv1H    = input.bool(true,  "1時間足を使う", group = grpTLEnv)
useTLEnv15M   = input.bool(true,  "15分足を使う", group = grpTLEnv)
tlEnvDailyTF = input.timeframe("D",   "日足TF", group = grpTLEnv)
tlEnv4HTF    = input.timeframe("240", "4時間足TF", group = grpTLEnv)
tlEnv1HTF    = input.timeframe("60",  "1時間足TF", group = grpTLEnv)
tlEnv15MTF   = input.timeframe("15",  "15分足TF", group = grpTLEnv)
// --- 使用する判定種類 (個別ON/OFF) ---
useTLEnvTrendBounce        = input.bool(true,  "A: Trendline反発", group = grpTLEnv)
useTLEnvTrendBreak         = input.bool(false, "B: Trendlineブレイク", group = grpTLEnv)
useTLEnvTrendRetest        = input.bool(false, "C: Trendlineリテスト", group = grpTLEnv)
useTLEnvTrendFakeBreak     = input.bool(true,  "D: Trendline Fake Break", group = grpTLEnv)
useTLEnvChannel            = input.bool(true,  "E: Channelを使う", group = grpTLEnv)
useTLEnvChannelBounce      = input.bool(true,  "F: Channel反発", group = grpTLEnv)
useTLEnvChannelBreak       = input.bool(false, "G: Channelブレイク", group = grpTLEnv)
useTLEnvChannelRetest      = input.bool(false, "H: Channelリテスト", group = grpTLEnv)
useTLEnvChannelPositionBias = input.bool(false, "I: Channel内位置Bias", group = grpTLEnv)
// --- 時間足内イベント結合 ---
//   Any           : 有効イベントのどれか1件が発生
//   SameDirection : 1件以上発生 かつ 反対方向イベントが発生していない (相互排他イベント対策)
//   MinCount      : 指定数以上のイベントが同方向に発生
tlEnvEventMode     = input.string("Any", "時間足内イベント結合 (Any/SameDirection/MinCount)", options = ["Any", "SameDirection", "MinCount"], group = grpTLEnv)
tlEnvMinEventCount = input.int(1, "最低イベント一致数 (MinCount時)", minval = 1, group = grpTLEnv)
// --- 状態保持本数 (各足の足数。イベント確定後この本数だけ優勢を保持) ---
tlEnvHoldDaily = input.int(3,  "日足 状態保持本数", minval = 1, group = grpTLEnv)
tlEnvHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpTLEnv)
tlEnvHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpTLEnv)
tlEnvHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpTLEnv)
// --- Line Quality Filter ---
useTLEnvQualityFilter   = input.bool(true, "Line Quality Filterを使う", group = grpTLEnv)
minTLEnvQuality         = input.int(70, "最低Line Quality", minval = 0, maxval = 100, group = grpTLEnv)
useTLEnvNoTradeWeakLine = input.bool(false, "弱いラインはEVEN(NoTrade)", group = grpTLEnv)
// --- ライン生成 共通パラメータ ---
tlEnvPivotLen          = input.int(5, "Pivot Length", minval = 1, group = grpTLEnv)
tlEnvUseATRSwingFilter = input.bool(true, "ATR Swing Filterを使う", group = grpTLEnv)
tlEnvMinSwingATR       = input.float(0.5, "最低Swing幅 ATR倍率", step = 0.1, group = grpTLEnv)
tlEnvTouchMode         = input.string("ATR", "接近判定", options = ["Dollar", "ATR"], group = grpTLEnv)
tlEnvTouchDollar       = input.float(3.0, "接近幅($)", step = 0.1, group = grpTLEnv)
tlEnvTouchATR          = input.float(0.3, "接近幅 ATR倍率", step = 0.05, group = grpTLEnv)
tlEnvRetestBars        = input.int(10, "Trendlineリテスト有効本数", minval = 1, group = grpTLEnv)
tlEnvChannelRetestBars = input.int(10, "Channelリテスト有効本数", minval = 1, group = grpTLEnv)
tlEnvMaxLineAgeBars    = input.int(300, "ライン有効期限 Bars", minval = 20, group = grpTLEnv)
tlEnvMinLineTouches    = input.int(2, "最低Touch数", minval = 2, group = grpTLEnv)
tlEnvBreakConfirmBars  = input.int(2, "Break Confirm Bars", minval = 1, group = grpTLEnv)
tlEnvMinSlopeATR       = input.float(0.03, "最低Slope ATR倍率", step = 0.01, group = grpTLEnv)
tlEnvMaxSlopeATR       = input.float(1.5, "最大Slope ATR倍率", step = 0.1, group = grpTLEnv)
// --- 複数足 統合方式 ---
tlEnvIntegrationMode = input.string("WeightedScore", "複数足 統合方式", options = ["AllAgree", "MatchCount", "WeightedScore", "HTFPriority"], group = grpTLEnv)
tlEnvReqMatch  = input.int(3, "必要一致足数 (MatchCount時)", minval = 1, maxval = 4, group = grpTLEnv)
tlEnvWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpTLEnv)
tlEnvWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpTLEnv)
tlEnvWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpTLEnv)
tlEnvWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpTLEnv)
tlEnvScoreThresh = input.int(3, "スコア閾値 (±・WeightedScore時)", minval = 1, group = grpTLEnv)
tlEnvHTFAllowLowerConflict = input.bool(false, "HTF優先時 下位逆行でもエントリー許可 (falseでNoTrade)", group = grpTLEnv)
// --- 表示 / デバッグ / ライン ---
tlEnvShowTable = input.bool(true,  "Trendline/Channel環境テーブルを表示", group = grpTLEnv)
tlEnvShowDebug = input.bool(false, "デバッグ情報を表示", group = grpTLEnv)
tlEnvShowLines = input.bool(false, "上位足Trendline/Channelを表示", group = grpTLEnv)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

bool finalBullTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur :
     triggerTFMode == "LowerOnly"       ? trigBullLower :
     triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBullCur or trigBullLower) :
     trigBullCur

bool finalBearTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur :
     triggerTFMode == "LowerOnly"       ? trigBearLower :
     triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBearCur or trigBearLower) :
     trigBearCur

bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

bool allowLongByTrigger  = enabledTrigCount == 0 ? true : (finalBullTrig and not trigNoTrade and trigCooldownOk)
bool allowShortByTrigger = enabledTrigCount == 0 ? true : (finalBearTrig and not trigNoTrade and trigCooldownOk)

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useEnvFilter
    // 4H / 1H / 15M : 確定済み上位足のみ参照 (lookahead_on + 確定1本前 → 完全非リペイント)
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    // 5M / 1M : 現状の仕様を維持
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8t. Trendline / Channel 環境認識モジュール 本体
// ------------------------------------------------------------
//  f_tlEnvState : 呼ばれた足(=上位足)のコンテキストで Trendline / Channel を
//    生成・選択し、方向イベントから優勢 (1/0/-1) と reason を判定する。
//    line / label / table は生成しない (数値・bool・intのみ返す)。
//  戻り値 [bias, reason, remain, quality, lineValue, chUpper, chLower, slope]。
//    bias  : 1=LONG優勢 / 0=EVEN / -1=SHORT優勢
//    reason: 1 TL反発 / 2 TLブレイク / 3 TLリテスト / 4 TL Fake /
//            5 CH反発 / 6 CHブレイク / 7 CHリテスト / 8 CH位置Bias /
//            9 Weak Line / 0 なし
//    remain: 状態保持の残り本数 / slope: 選択ライン傾き (価格/上位足バー)
// ============================================================
f_tlNear(float price, float level, float rng) =>
    not na(level) and math.abs(price - level) <= rng

f_tlLineValue(int x1, float y1, int x2, float y2, int xNow) =>
    float slope = (y2 - y1) / math.max(x2 - x1, 1)
    y1 + slope * (xNow - x1)

f_tlQualityScore(int touch, int ageBars, float slopeAbsATR, int broken) =>
    int touchScore = touch >= 4 ? 40 : touch == 3 ? 30 : touch >= 2 ? 20 : 0
    int ageScore = (ageBars >= 20 and ageBars <= 150) ? 20 : (ageBars >= 151 and ageBars <= 300) ? 10 : 0
    int slopeScore = na(slopeAbsATR) ? 0 : (slopeAbsATR < tlEnvMinSlopeATR ? 5 : slopeAbsATR > tlEnvMaxSlopeATR ? 5 : 20)
    int brokenScore = broken == 0 ? 20 : broken == 1 ? 10 : 0
    math.min(100, touchScore + ageScore + slopeScore + brokenScore)

f_tlSlopeATR(float p1, int b1, float p2, int b2, float atrv) =>
    atrv != 0 ? math.abs((p2 - p1) / math.max(b2 - b1, 1)) / atrv : na

f_tlEnvReasonText(int c) =>
    c == 1 ? "TL Bounce" : c == 2 ? "TL Break" : c == 3 ? "TL Retest" : c == 4 ? "TL Fake" : c == 5 ? "CH Bounce" : c == 6 ? "CH Break" : c == 7 ? "CH Retest" : c == 8 ? "CH Bias" : c == 9 ? "WeakLine" : "-"

f_tlEnvBiasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"

f_tlEnvState(int holdBars) =>
    // ---- 基礎 ----
    float atr = ta.atr(14)
    float trendTouchRange = tlEnvTouchMode == "ATR" ? atr * tlEnvTouchATR : tlEnvTouchDollar

    // 反転ローソク
    bool tl_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool tl_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    float tl_body   = math.abs(close - open)
    float tl_upWick = high - math.max(open, close)
    float tl_dnWick = math.min(open, close) - low
    bool tl_pinLower = tl_dnWick >= tl_body and tl_dnWick >= tl_upWick
    bool tl_pinUpper = tl_upWick >= tl_body and tl_upWick >= tl_dnWick
    bool bullishReversal = tl_bullEngulf or tl_pinLower or close > open
    bool bearishReversal = tl_bearEngulf or tl_pinUpper or close < open

    // ---- Pivot検知 (確定Pivot / ATR Swing Filter) 直近4点保持 ----
    float ph = ta.pivothigh(high, tlEnvPivotLen, tlEnvPivotLen)
    float pl = ta.pivotlow(low, tlEnvPivotLen, tlEnvPivotLen)

    var float hp1P = na
    var float hp2P = na
    var float hp3P = na
    var float hp4P = na
    var int   hp1B = na
    var int   hp2B = na
    var int   hp3B = na
    var int   hp4B = na
    var float lp1P = na
    var float lp2P = na
    var float lp3P = na
    var float lp4P = na
    var int   lp1B = na
    var int   lp2B = na
    var int   lp3B = na
    var int   lp4B = na

    bool newHighPivot = false
    bool newLowPivot  = false
    if not na(ph)
        if na(hp1P) or not tlEnvUseATRSwingFilter or math.abs(ph - hp1P) >= atr * tlEnvMinSwingATR
            hp4P := hp3P
            hp4B := hp3B
            hp3P := hp2P
            hp3B := hp2B
            hp2P := hp1P
            hp2B := hp1B
            hp1P := ph
            hp1B := bar_index - tlEnvPivotLen
            newHighPivot := true
    if not na(pl)
        if na(lp1P) or not tlEnvUseATRSwingFilter or math.abs(pl - lp1P) >= atr * tlEnvMinSwingATR
            lp4P := lp3P
            lp4B := lp3B
            lp3P := lp2P
            lp3B := lp2B
            lp2P := lp1P
            lp2B := lp1B
            lp1P := pl
            lp1B := bar_index - tlEnvPivotLen
            newLowPivot := true

    // ---- 複数Trendline (短期/中期/長期) + Touch / Broken カウンタ ----
    var int upTouchA = 0
    var int upTouchB = 0
    var int upTouchC = 0
    var int upBrokA = 0
    var int upBrokB = 0
    var int upBrokC = 0
    var int upBelowA = 0
    var int upBelowB = 0
    var int upBelowC = 0
    var int dnTouchA = 0
    var int dnTouchB = 0
    var int dnTouchC = 0
    var int dnBrokA = 0
    var int dnBrokB = 0
    var int dnBrokC = 0
    var int dnAboveA = 0
    var int dnAboveB = 0
    var int dnAboveC = 0
    if newLowPivot
        upTouchA := 0
        upTouchB := 0
        upTouchC := 0
        upBrokA := 0
        upBrokB := 0
        upBrokC := 0
        upBelowA := 0
        upBelowB := 0
        upBelowC := 0
    if newHighPivot
        dnTouchA := 0
        dnTouchB := 0
        dnTouchC := 0
        dnBrokA := 0
        dnBrokB := 0
        dnBrokC := 0
        dnAboveA := 0
        dnAboveB := 0
        dnAboveC := 0

    // --- 上昇ライン値 (ライン年齢 tlEnvMaxLineAgeBars 超過は無効) ---
    bool upValidA = not na(lp1P) and not na(lp2P) and lp1B != lp2B and (bar_index - lp2B) <= tlEnvMaxLineAgeBars
    bool upValidB = not na(lp1P) and not na(lp3P) and lp1B != lp3B and (bar_index - lp3B) <= tlEnvMaxLineAgeBars
    bool upValidC = not na(lp1P) and not na(lp4P) and lp1B != lp4B and (bar_index - lp4B) <= tlEnvMaxLineAgeBars
    float upValA = upValidA ? f_tlLineValue(lp2B, lp2P, lp1B, lp1P, bar_index) : na
    float upValB = upValidB ? f_tlLineValue(lp3B, lp3P, lp1B, lp1P, bar_index) : na
    float upValC = upValidC ? f_tlLineValue(lp4B, lp4P, lp1B, lp1P, bar_index) : na
    if not na(upValA)
        if f_tlNear(low, upValA, trendTouchRange) and bullishReversal and close > upValA
            upTouchA := upTouchA + 1
        upBelowA := close < upValA ? upBelowA + 1 : 0
        if upBelowA == tlEnvBreakConfirmBars
            upBrokA := upBrokA + 1
    if not na(upValB)
        if f_tlNear(low, upValB, trendTouchRange) and bullishReversal and close > upValB
            upTouchB := upTouchB + 1
        upBelowB := close < upValB ? upBelowB + 1 : 0
        if upBelowB == tlEnvBreakConfirmBars
            upBrokB := upBrokB + 1
    if not na(upValC)
        if f_tlNear(low, upValC, trendTouchRange) and bullishReversal and close > upValC
            upTouchC := upTouchC + 1
        upBelowC := close < upValC ? upBelowC + 1 : 0
        if upBelowC == tlEnvBreakConfirmBars
            upBrokC := upBrokC + 1

    // --- 下降ライン値 (ライン年齢 tlEnvMaxLineAgeBars 超過は無効) ---
    bool dnValidA = not na(hp1P) and not na(hp2P) and hp1B != hp2B and (bar_index - hp2B) <= tlEnvMaxLineAgeBars
    bool dnValidB = not na(hp1P) and not na(hp3P) and hp1B != hp3B and (bar_index - hp3B) <= tlEnvMaxLineAgeBars
    bool dnValidC = not na(hp1P) and not na(hp4P) and hp1B != hp4B and (bar_index - hp4B) <= tlEnvMaxLineAgeBars
    float dnValA = dnValidA ? f_tlLineValue(hp2B, hp2P, hp1B, hp1P, bar_index) : na
    float dnValB = dnValidB ? f_tlLineValue(hp3B, hp3P, hp1B, hp1P, bar_index) : na
    float dnValC = dnValidC ? f_tlLineValue(hp4B, hp4P, hp1B, hp1P, bar_index) : na
    if not na(dnValA)
        if f_tlNear(high, dnValA, trendTouchRange) and bearishReversal and close < dnValA
            dnTouchA := dnTouchA + 1
        dnAboveA := close > dnValA ? dnAboveA + 1 : 0
        if dnAboveA == tlEnvBreakConfirmBars
            dnBrokA := dnBrokA + 1
    if not na(dnValB)
        if f_tlNear(high, dnValB, trendTouchRange) and bearishReversal and close < dnValB
            dnTouchB := dnTouchB + 1
        dnAboveB := close > dnValB ? dnAboveB + 1 : 0
        if dnAboveB == tlEnvBreakConfirmBars
            dnBrokB := dnBrokB + 1
    if not na(dnValC)
        if f_tlNear(high, dnValC, trendTouchRange) and bearishReversal and close < dnValC
            dnTouchC := dnTouchC + 1
        dnAboveC := close > dnValC ? dnAboveC + 1 : 0
        if dnAboveC == tlEnvBreakConfirmBars
            dnBrokC := dnBrokC + 1

    // 各ライン Quality
    int upQA = upValidA ? f_tlQualityScore(upTouchA, bar_index - lp2B, f_tlSlopeATR(lp2P, lp2B, lp1P, lp1B, atr), upBrokA) : -1
    int upQB = upValidB ? f_tlQualityScore(upTouchB, bar_index - lp3B, f_tlSlopeATR(lp3P, lp3B, lp1P, lp1B, atr), upBrokB) : -1
    int upQC = upValidC ? f_tlQualityScore(upTouchC, bar_index - lp4B, f_tlSlopeATR(lp4P, lp4B, lp1P, lp1B, atr), upBrokC) : -1
    int dnQA = dnValidA ? f_tlQualityScore(dnTouchA, bar_index - hp2B, f_tlSlopeATR(hp2P, hp2B, hp1P, hp1B, atr), dnBrokA) : -1
    int dnQB = dnValidB ? f_tlQualityScore(dnTouchB, bar_index - hp3B, f_tlSlopeATR(hp3P, hp3B, hp1P, hp1B, atr), dnBrokB) : -1
    int dnQC = dnValidC ? f_tlQualityScore(dnTouchC, bar_index - hp4B, f_tlSlopeATR(hp4P, hp4B, hp1P, hp1B, atr), dnBrokC) : -1

    // 上昇: Quality最高(同点は近い方)を採用
    int   selUpIdx = na
    float upTrendlineValue = na
    int   upTrendlineQuality = 0
    int   upTouchCount = 0
    float selUpAnchorP = na
    int   selUpAnchorB = na
    if upValidA
        selUpIdx := 0
        upTrendlineValue := upValA
        upTrendlineQuality := upQA
        upTouchCount := upTouchA
        selUpAnchorP := lp2P
        selUpAnchorB := lp2B
    if upValidB and (na(selUpIdx) or upQB > upTrendlineQuality or (upQB == upTrendlineQuality and math.abs(close - upValB) < math.abs(close - upTrendlineValue)))
        selUpIdx := 1
        upTrendlineValue := upValB
        upTrendlineQuality := upQB
        upTouchCount := upTouchB
        selUpAnchorP := lp3P
        selUpAnchorB := lp3B
    if upValidC and (na(selUpIdx) or upQC > upTrendlineQuality or (upQC == upTrendlineQuality and math.abs(close - upValC) < math.abs(close - upTrendlineValue)))
        selUpIdx := 2
        upTrendlineValue := upValC
        upTrendlineQuality := upQC
        upTouchCount := upTouchC
        selUpAnchorP := lp4P
        selUpAnchorB := lp4B
    bool upValid = not na(upTrendlineValue)

    // 下降: 同様
    int   selDnIdx = na
    float downTrendlineValue = na
    int   downTrendlineQuality = 0
    int   downTouchCount = 0
    float selDnAnchorP = na
    int   selDnAnchorB = na
    if dnValidA
        selDnIdx := 0
        downTrendlineValue := dnValA
        downTrendlineQuality := dnQA
        downTouchCount := dnTouchA
        selDnAnchorP := hp2P
        selDnAnchorB := hp2B
    if dnValidB and (na(selDnIdx) or dnQB > downTrendlineQuality or (dnQB == downTrendlineQuality and math.abs(close - dnValB) < math.abs(close - downTrendlineValue)))
        selDnIdx := 1
        downTrendlineValue := dnValB
        downTrendlineQuality := dnQB
        downTouchCount := dnTouchB
        selDnAnchorP := hp3P
        selDnAnchorB := hp3B
    if dnValidC and (na(selDnIdx) or dnQC > downTrendlineQuality or (dnQC == downTrendlineQuality and math.abs(close - dnValC) < math.abs(close - downTrendlineValue)))
        selDnIdx := 2
        downTrendlineValue := dnValC
        downTrendlineQuality := dnQC
        downTouchCount := dnTouchC
        selDnAnchorP := hp4P
        selDnAnchorB := hp4B
    bool downValid = not na(downTrendlineValue)

    // ---- Channel計算 (実Pivotを通る平行線) ----
    float upTLatHP = (upValid and not na(hp1B)) ? f_tlLineValue(selUpAnchorB, selUpAnchorP, lp1B, lp1P, hp1B) : na
    float upOffset = (not na(upTLatHP) and not na(hp1P)) ? math.abs(hp1P - upTLatHP) : na
    float upChannelLower = upTrendlineValue
    float upChannelUpper = (not na(upTrendlineValue) and not na(upOffset)) ? upTrendlineValue + upOffset : na
    float downTLatLP = (downValid and not na(lp1B)) ? f_tlLineValue(selDnAnchorB, selDnAnchorP, hp1B, hp1P, lp1B) : na
    float downOffset = (not na(downTLatLP) and not na(lp1P)) ? math.abs(lp1P - downTLatLP) : na
    float downChannelUpper = downTrendlineValue
    float downChannelLower = (not na(downTrendlineValue) and not na(downOffset)) ? downTrendlineValue - downOffset : na
    float upChannelWidth   = (not na(upChannelUpper) and not na(upChannelLower)) ? upChannelUpper - upChannelLower : na
    float downChannelWidth = (not na(downChannelUpper) and not na(downChannelLower)) ? downChannelUpper - downChannelLower : na

    // Channel Slope (採用ラインの符号付き傾き / 本)
    float upSlopeSigned   = upValid   ? (lp1P - selUpAnchorP) / math.max(lp1B - selUpAnchorB, 1) : na
    float downSlopeSigned = downValid ? (hp1P - selDnAnchorP) / math.max(hp1B - selDnAnchorB, 1) : na
    float slopeFlatTh = atr * tlEnvMinSlopeATR
    // Channel の基準側を Trendline 選択と統一 (両方有効ならQuality高い方)
    bool activeUp = upValid and (not downValid or upTrendlineQuality >= downTrendlineQuality)
    float channelSlope = activeUp ? upSlopeSigned : downSlopeSigned
    int channelSlopeState = na(channelSlope) ? 0 : channelSlope > slopeFlatTh ? 1 : channelSlope < -slopeFlatTh ? -1 : 0

    // ---- 接近判定 ----
    bool nearUpTrendline   = f_tlNear(low,  upTrendlineValue, trendTouchRange)
    bool nearDownTrendline = f_tlNear(high, downTrendlineValue, trendTouchRange)
    bool nearUpChannelLower = f_tlNear(low,  upChannelLower, trendTouchRange)
    bool nearUpChannelUpper = f_tlNear(high, upChannelUpper, trendTouchRange)
    bool nearDownChannelUpper = f_tlNear(high, downChannelUpper, trendTouchRange)
    bool nearDownChannelLower = f_tlNear(low,  downChannelLower, trendTouchRange)

    // 採用ライン / Channel は activeUp (Trendline選択と統一) に一致させる
    int   selectedTrendlineQuality = math.max(upTrendlineQuality, downTrendlineQuality)
    float selectedTrendlineValue   = activeUp ? upTrendlineValue : downTrendlineValue
    float selectedChannelUpper     = activeUp ? upChannelUpper : downChannelUpper
    float selectedChannelLower     = activeUp ? upChannelLower : downChannelLower
    float selectedSlope            = activeUp ? upSlopeSigned : downSlopeSigned

    // Quality判定を方向別・ライン別に分離 (反対側ラインのQualityでイベントを許可しない)
    bool upStrong   = upValid   and upTrendlineQuality   >= minTLEnvQuality and upTouchCount   >= tlEnvMinLineTouches
    bool downStrong = downValid and downTrendlineQuality >= minTLEnvQuality and downTouchCount >= tlEnvMinLineTouches
    bool upQualityOk   = not useTLEnvQualityFilter or upStrong
    bool downQualityOk = not useTLEnvQualityFilter or downStrong
    // Channel の Quality は基準側 (activeUp) の Trendline Quality を使用
    bool chQualityOk   = activeUp ? upQualityOk : downQualityOk
    // 弱いライン (両側とも基準未達) → その足は EVEN (reason 9)
    bool weakLine = useTLEnvNoTradeWeakLine and not upStrong and not downStrong

    // ---- 各イベント (方向定義は参考コードと同一 / Quality は方向別に分離) ----
    // A: Trendline反発 (上昇TL反発=LONG→upQualityOk / 下降TL反発=SHORT→downQualityOk)
    bool tlBuyBounce  = useTLEnvTrendBounce and upQualityOk   and nearUpTrendline   and bullishReversal and close > upTrendlineValue
    bool tlSellBounce = useTLEnvTrendBounce and downQualityOk and nearDownTrendline and bearishReversal and close < downTrendlineValue
    // B: Trendlineブレイク (終値) — raw検出 と 採用判定 を分離
    bool rawTlBuyBreak  = not na(downTrendlineValue) and not na(downTrendlineValue[1]) and close > downTrendlineValue and close[1] <= downTrendlineValue[1]
    bool rawTlSellBreak = not na(upTrendlineValue)   and not na(upTrendlineValue[1])   and close < upTrendlineValue   and close[1] >= upTrendlineValue[1]
    bool tlBuyBreak  = useTLEnvTrendBreak and downQualityOk and rawTlBuyBreak
    bool tlSellBreak = useTLEnvTrendBreak and upQualityOk   and rawTlSellBreak
    // C: Trendlineリテスト (raw ブレイク履歴を Break OFF でも保存 → Retest 単独ONで発生)
    var int tlBreakUpBar   = na
    var int tlBreakDownBar = na
    if rawTlBuyBreak
        tlBreakUpBar := bar_index
    if rawTlSellBreak
        tlBreakDownBar := bar_index
    bool tlBuyRetest  = useTLEnvTrendRetest and downQualityOk and not na(tlBreakUpBar)   and (bar_index - tlBreakUpBar)   <= tlEnvRetestBars and not na(downTrendlineValue) and f_tlNear(low, downTrendlineValue, trendTouchRange) and close > downTrendlineValue and bullishReversal
    bool tlSellRetest = useTLEnvTrendRetest and upQualityOk   and not na(tlBreakDownBar) and (bar_index - tlBreakDownBar) <= tlEnvRetestBars and not na(upTrendlineValue)   and f_tlNear(high, upTrendlineValue, trendTouchRange) and close < upTrendlineValue and bearishReversal
    // D: Fake Break (上昇TL Fake=LONG→upQualityOk / 下降TL Fake=SHORT→downQualityOk)
    bool tlBuyFake  = useTLEnvTrendFakeBreak and upQualityOk   and not na(upTrendlineValue)   and not na(upTrendlineValue[1])   and low  < upTrendlineValue   and close > upTrendlineValue   and close[1] <= upTrendlineValue[1]   and bullishReversal
    bool tlSellFake = useTLEnvTrendFakeBreak and downQualityOk and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and high > downTrendlineValue and close < downTrendlineValue and close[1] >= downTrendlineValue[1] and bearishReversal
    // F: Channel反発 (基準側 chQualityOk)
    bool chBuyBounce  = useTLEnvChannel and useTLEnvChannelBounce and chQualityOk and (nearUpChannelLower or nearDownChannelLower) and bullishReversal
    bool chSellBounce = useTLEnvChannel and useTLEnvChannelBounce and chQualityOk and (nearUpChannelUpper or nearDownChannelUpper) and bearishReversal
    // G: Channelブレイク — raw検出 と 採用判定 を分離
    bool rawChBuyBreak  = useTLEnvChannel and ((not na(upChannelUpper) and not na(upChannelUpper[1]) and close > upChannelUpper and close[1] <= upChannelUpper[1]) or (not na(downChannelUpper) and not na(downChannelUpper[1]) and close > downChannelUpper and close[1] <= downChannelUpper[1]))
    bool rawChSellBreak = useTLEnvChannel and ((not na(upChannelLower) and not na(upChannelLower[1]) and close < upChannelLower and close[1] >= upChannelLower[1]) or (not na(downChannelLower) and not na(downChannelLower[1]) and close < downChannelLower and close[1] >= downChannelLower[1]))
    bool chBuyBreak  = useTLEnvChannelBreak and chQualityOk and rawChBuyBreak
    bool chSellBreak = useTLEnvChannelBreak and chQualityOk and rawChSellBreak
    // H: Channelリテスト (raw ブレイク履歴を Break OFF でも保存 → Retest 単独ONで発生)
    var int chBreakUpBar = na
    var int chBreakDnBar = na
    if rawChBuyBreak
        chBreakUpBar := bar_index
    if rawChSellBreak
        chBreakDnBar := bar_index
    bool chBuyRetest  = useTLEnvChannel and useTLEnvChannelRetest and chQualityOk and not na(chBreakUpBar) and (bar_index - chBreakUpBar) <= tlEnvChannelRetestBars and bullishReversal and ((not na(upChannelUpper) and f_tlNear(low, upChannelUpper, trendTouchRange) and close > upChannelUpper) or (not na(downChannelUpper) and f_tlNear(low, downChannelUpper, trendTouchRange) and close > downChannelUpper))
    bool chSellRetest = useTLEnvChannel and useTLEnvChannelRetest and chQualityOk and not na(chBreakDnBar) and (bar_index - chBreakDnBar) <= tlEnvChannelRetestBars and bearishReversal and ((not na(upChannelLower) and f_tlNear(high, upChannelLower, trendTouchRange) and close < upChannelLower) or (not na(downChannelLower) and f_tlNear(high, downChannelLower, trendTouchRange) and close < downChannelLower))
    // I: Channel内 Position Bias (継続状態・基準側 activeUp / chQualityOk)
    float channelPosition = (activeUp and not na(upChannelWidth) and upChannelWidth > 0) ? (close - upChannelLower) / upChannelWidth * 100.0 : (not activeUp and downValid and not na(downChannelWidth) and downChannelWidth > 0) ? (close - downChannelLower) / downChannelWidth * 100.0 : na
    bool ch_posTop    = not na(channelPosition) and channelPosition >= 67
    bool ch_posBottom = not na(channelPosition) and channelPosition <= 33
    bool ch_biasOn = useTLEnvChannel and useTLEnvChannelPositionBias and chQualityOk and not na(channelPosition)
    bool chBiasLong  = ch_biasOn and ((channelSlopeState == 1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posBottom))
    bool chBiasShort = ch_biasOn and ((channelSlopeState == -1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posTop))

    // ---- 有効イベント集計 (各イベントは既に方向別Qualityでゲート済み) ----
    bool gate = not weakLine
    int buyCount = gate ? ((tlBuyBounce?1:0)+(tlBuyBreak?1:0)+(tlBuyRetest?1:0)+(tlBuyFake?1:0)+(chBuyBounce?1:0)+(chBuyBreak?1:0)+(chBuyRetest?1:0)+(chBiasLong?1:0)) : 0
    int sellCount = gate ? ((tlSellBounce?1:0)+(tlSellBreak?1:0)+(tlSellRetest?1:0)+(tlSellFake?1:0)+(chSellBounce?1:0)+(chSellBreak?1:0)+(chSellRetest?1:0)+(chBiasShort?1:0)) : 0

    // 時間足内イベント結合
    bool longEvt = false
    bool shortEvt = false
    if tlEnvEventMode == "Any"
        longEvt := buyCount >= 1
        shortEvt := sellCount >= 1
    else if tlEnvEventMode == "SameDirection"
        // 1件以上発生 かつ 反対方向イベントが発生していない
        longEvt := buyCount >= 1 and sellCount == 0
        shortEvt := sellCount >= 1 and buyCount == 0
    else
        longEvt := buyCount >= tlEnvMinEventCount
        shortEvt := sellCount >= tlEnvMinEventCount

    // reason (勝ち方向を優先順で決定)
    int reasonLong = tlBuyRetest ? 3 : chBuyRetest ? 7 : tlBuyFake ? 4 : tlBuyBreak ? 2 : chBuyBreak ? 6 : tlBuyBounce ? 1 : chBuyBounce ? 5 : chBiasLong ? 8 : 0
    int reasonShort = tlSellRetest ? 3 : chSellRetest ? 7 : tlSellFake ? 4 : tlSellBreak ? 2 : chSellBreak ? 6 : tlSellBounce ? 1 : chSellBounce ? 5 : chBiasShort ? 8 : 0

    // ---- 状態保持 (イベント足を1本目として数える) ----
    var int _evBar    = na
    var int _evBias   = 0
    var int _evReason = 0
    if longEvt and shortEvt
        // 同一確定バーでロング・ショート同時成立 → 方向を予想せず EVEN
        _evBias := 0
        _evReason := 0
        _evBar := na
    else if longEvt
        _evBias := 1
        _evReason := reasonLong
        _evBar := bar_index
    else if shortEvt
        _evBias := -1
        _evReason := reasonShort
        _evBar := bar_index

    bool active = not na(_evBar) and (bar_index - _evBar) < holdBars
    int outBias   = active ? _evBias : 0
    int outReason = active ? _evReason : (weakLine ? 9 : 0)
    int outRemain = active ? holdBars - (bar_index - _evBar) : 0

    [outBias, outReason, outRemain, selectedTrendlineQuality, selectedTrendlineValue, selectedChannelUpper, selectedChannelLower, selectedSlope]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助。
f_tlEnvConfirmed(int holdBars) =>
    [_b, _r, _rem, _q, _lv, _cu, _cl, _sl] = f_tlEnvState(holdBars)
    [_b[1], _r[1], _rem[1], _q[1], _lv[1], _cu[1], _cl[1], _sl[1]]

// --- 各足の確定TL/CH環境状態 (OFF足は request.security を呼ばない) ---
int   tlEnvDBias = 0
int   tlEnvDReason = 0
int   tlEnvDRem = 0
int   tlEnvDQual = 0
float tlEnvDLine = na
float tlEnvDChU = na
float tlEnvDChL = na
float tlEnvDSlope = na
int   tlEnvHBias = 0
int   tlEnvHReason = 0
int   tlEnvHRem = 0
int   tlEnvHQual = 0
float tlEnvHLine = na
float tlEnvHChU = na
float tlEnvHChL = na
float tlEnvHSlope = na
int   tlEnvOBias = 0
int   tlEnvOReason = 0
int   tlEnvORem = 0
int   tlEnvOQual = 0
float tlEnvOLine = na
float tlEnvOChU = na
float tlEnvOChL = na
float tlEnvOSlope = na
int   tlEnvMBias = 0
int   tlEnvMReason = 0
int   tlEnvMRem = 0
int   tlEnvMQual = 0
float tlEnvMLine = na
float tlEnvMChU = na
float tlEnvMChL = na
float tlEnvMSlope = na

if useTLEnv and useTLEnvDaily
    [_b, _r, _rem, _q, _lv, _cu, _cl, _sl] = request.security(syminfo.tickerid, tlEnvDailyTF, f_tlEnvConfirmed(tlEnvHoldDaily), lookahead = barmerge.lookahead_on)
    tlEnvDBias := _b
    tlEnvDReason := _r
    tlEnvDRem := _rem
    tlEnvDQual := _q
    tlEnvDLine := _lv
    tlEnvDChU := _cu
    tlEnvDChL := _cl
    tlEnvDSlope := _sl
if useTLEnv and useTLEnv4H
    [_b, _r, _rem, _q, _lv, _cu, _cl, _sl] = request.security(syminfo.tickerid, tlEnv4HTF, f_tlEnvConfirmed(tlEnvHold4H), lookahead = barmerge.lookahead_on)
    tlEnvHBias := _b
    tlEnvHReason := _r
    tlEnvHRem := _rem
    tlEnvHQual := _q
    tlEnvHLine := _lv
    tlEnvHChU := _cu
    tlEnvHChL := _cl
    tlEnvHSlope := _sl
if useTLEnv and useTLEnv1H
    [_b, _r, _rem, _q, _lv, _cu, _cl, _sl] = request.security(syminfo.tickerid, tlEnv1HTF, f_tlEnvConfirmed(tlEnvHold1H), lookahead = barmerge.lookahead_on)
    tlEnvOBias := _b
    tlEnvOReason := _r
    tlEnvORem := _rem
    tlEnvOQual := _q
    tlEnvOLine := _lv
    tlEnvOChU := _cu
    tlEnvOChL := _cl
    tlEnvOSlope := _sl
if useTLEnv and useTLEnv15M
    [_b, _r, _rem, _q, _lv, _cu, _cl, _sl] = request.security(syminfo.tickerid, tlEnv15MTF, f_tlEnvConfirmed(tlEnvHold15M), lookahead = barmerge.lookahead_on)
    tlEnvMBias := _b
    tlEnvMReason := _r
    tlEnvMRem := _rem
    tlEnvMQual := _q
    tlEnvMLine := _lv
    tlEnvMChU := _cu
    tlEnvMChL := _cl
    tlEnvMSlope := _sl

// --- 複数足 統合 (AllAgree / MatchCount / WeightedScore / HTFPriority) ---
// マスター (useTLEnv) OFF の場合は全時間足を無効扱い (統合数・スコア・Biasを 0 に)。
bool eD = useTLEnv and useTLEnvDaily
bool e4 = useTLEnv and useTLEnv4H
bool eO = useTLEnv and useTLEnv1H
bool eM = useTLEnv and useTLEnv15M
int tlEnvEnabledCount = (eD ? 1 : 0) + (e4 ? 1 : 0) + (eO ? 1 : 0) + (eM ? 1 : 0)
// AllAgree
bool tlEnvAllLong  = tlEnvEnabledCount > 0 and (not eD or tlEnvDBias == 1) and (not e4 or tlEnvHBias == 1) and (not eO or tlEnvOBias == 1) and (not eM or tlEnvMBias == 1)
bool tlEnvAllShort = tlEnvEnabledCount > 0 and (not eD or tlEnvDBias == -1) and (not e4 or tlEnvHBias == -1) and (not eO or tlEnvOBias == -1) and (not eM or tlEnvMBias == -1)
// MatchCount
int tlEnvLongCnt  = (eD and tlEnvDBias == 1 ? 1 : 0) + (e4 and tlEnvHBias == 1 ? 1 : 0) + (eO and tlEnvOBias == 1 ? 1 : 0) + (eM and tlEnvMBias == 1 ? 1 : 0)
int tlEnvShortCnt = (eD and tlEnvDBias == -1 ? 1 : 0) + (e4 and tlEnvHBias == -1 ? 1 : 0) + (eO and tlEnvOBias == -1 ? 1 : 0) + (eM and tlEnvMBias == -1 ? 1 : 0)
bool tlEnvCntLong  = tlEnvEnabledCount > 0 and tlEnvLongCnt  >= tlEnvReqMatch
bool tlEnvCntShort = tlEnvEnabledCount > 0 and tlEnvShortCnt >= tlEnvReqMatch
// WeightedScore
int tlEnvScore = (eD ? tlEnvWeightD * tlEnvDBias : 0) + (e4 ? tlEnvWeight4H * tlEnvHBias : 0) + (eO ? tlEnvWeight1H * tlEnvOBias : 0) + (eM ? tlEnvWeight15M * tlEnvMBias : 0)
bool tlEnvScoreLong  = tlEnvEnabledCount > 0 and tlEnvScore >= tlEnvScoreThresh
bool tlEnvScoreShort = tlEnvEnabledCount > 0 and tlEnvScore <= -tlEnvScoreThresh
// HTFPriority (日足/4H を優先。下位足が逆行なら NoTrade 既定)
int tlEnvHtfScore = (eD ? tlEnvWeightD * tlEnvDBias : 0) + (e4 ? tlEnvWeight4H * tlEnvHBias : 0)
int tlEnvHtfDir = tlEnvHtfScore > 0 ? 1 : tlEnvHtfScore < 0 ? -1 : 0
bool tlEnvLoConflictLong  = (eO and tlEnvOBias == -1) or (eM and tlEnvMBias == -1)
bool tlEnvLoConflictShort = (eO and tlEnvOBias == 1) or (eM and tlEnvMBias == 1)
bool tlEnvHtfLong  = tlEnvHtfDir == 1 and (tlEnvHTFAllowLowerConflict or not tlEnvLoConflictLong)
bool tlEnvHtfShort = tlEnvHtfDir == -1 and (tlEnvHTFAllowLowerConflict or not tlEnvLoConflictShort)
// 最終 TL/CH バイアス
bool tlEnvBiasLong =
     tlEnvIntegrationMode == "AllAgree"      ? tlEnvAllLong :
     tlEnvIntegrationMode == "MatchCount"    ? tlEnvCntLong :
     tlEnvIntegrationMode == "WeightedScore" ? tlEnvScoreLong :
     tlEnvHtfLong
bool tlEnvBiasShort =
     tlEnvIntegrationMode == "AllAgree"      ? tlEnvAllShort :
     tlEnvIntegrationMode == "MatchCount"    ? tlEnvCntShort :
     tlEnvIntegrationMode == "WeightedScore" ? tlEnvScoreShort :
     tlEnvHtfShort
int tlEnvFinalBias = tlEnvBiasLong and not tlEnvBiasShort ? 1 : tlEnvBiasShort and not tlEnvBiasLong ? -1 : 0

// --- EMAトレンド環境 と結合 ---
bool tlTrendOk = not useEnvFilter or allowByEnv
bool finalEnvLongOk =
     not useTLEnv ? tlTrendOk :
     tlEnvCombineMode == "TrendOnly"  ? tlTrendOk :
     tlEnvCombineMode == "TLOnly"     ? tlEnvBiasLong :
     tlEnvCombineMode == "TrendAndTL" ? (tlTrendOk and tlEnvBiasLong) :
     (tlTrendOk or tlEnvBiasLong)
bool finalEnvShortOk =
     not useTLEnv ? tlTrendOk :
     tlEnvCombineMode == "TrendOnly"  ? tlTrendOk :
     tlEnvCombineMode == "TLOnly"     ? tlEnvBiasShort :
     tlEnvCombineMode == "TrendAndTL" ? (tlTrendOk and tlEnvBiasShort) :
     (tlTrendOk or tlEnvBiasShort)

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = EMAトレンド + Trendline/Channel)
// ------------------------------------------------------------
//  環境認識は finalEnvLongOk/finalEnvShortOk (EMAトレンド環境 +
//  Trendline/Channel MTF環境の結合) に一本化。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
bool canLong =
     useLong and
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     allowLongByTrigger and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk and
     longRisk > 0 and
     longQty >= 1

bool canShort =
     useShort and
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     allowShortByTrigger and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk and
     shortRisk > 0 and
     shortQty >= 1

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)

// ============================================================
//  12. Trendline / Channel 環境認識 表示 (テーブル / デバッグ / ライン)
// ============================================================
f_tlEnvBiasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

var table tlEnvTbl = na
if tlEnvShowTable
    if na(tlEnvTbl)
        tlEnvTbl := table.new(position.top_right, 5, 6, border_width = 1)
    if barstate.islast
        table.cell(tlEnvTbl, 0, 0, "TF",      text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(tlEnvTbl, 1, 0, "方向",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(tlEnvTbl, 2, 0, "理由",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(tlEnvTbl, 3, 0, "Quality", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(tlEnvTbl, 4, 0, "残",      text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // Daily (マスターOFF時は eD=false → OFF表示)
        table.cell(tlEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 1, 1, eD ? f_tlEnvBiasText(tlEnvDBias) : "-", text_color = color.white, bgcolor = eD ? f_tlEnvBiasColor(tlEnvDBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(tlEnvTbl, 2, 1, eD ? f_tlEnvReasonText(tlEnvDReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 3, 1, eD ? str.tostring(tlEnvDQual) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 4, 1, eD ? str.tostring(tlEnvDRem) : "-", text_color = color.white, text_size = size.small)
        // 4H
        table.cell(tlEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 1, 2, e4 ? f_tlEnvBiasText(tlEnvHBias) : "-", text_color = color.white, bgcolor = e4 ? f_tlEnvBiasColor(tlEnvHBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(tlEnvTbl, 2, 2, e4 ? f_tlEnvReasonText(tlEnvHReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 3, 2, e4 ? str.tostring(tlEnvHQual) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 4, 2, e4 ? str.tostring(tlEnvHRem) : "-", text_color = color.white, text_size = size.small)
        // 1H
        table.cell(tlEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 1, 3, eO ? f_tlEnvBiasText(tlEnvOBias) : "-", text_color = color.white, bgcolor = eO ? f_tlEnvBiasColor(tlEnvOBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(tlEnvTbl, 2, 3, eO ? f_tlEnvReasonText(tlEnvOReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 3, 3, eO ? str.tostring(tlEnvOQual) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 4, 3, eO ? str.tostring(tlEnvORem) : "-", text_color = color.white, text_size = size.small)
        // 15M
        table.cell(tlEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 1, 4, eM ? f_tlEnvBiasText(tlEnvMBias) : "-", text_color = color.white, bgcolor = eM ? f_tlEnvBiasColor(tlEnvMBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(tlEnvTbl, 2, 4, eM ? f_tlEnvReasonText(tlEnvMReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 3, 4, eM ? str.tostring(tlEnvMQual) : "-", text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 4, 4, eM ? str.tostring(tlEnvMRem) : "-", text_color = color.white, text_size = size.small)
        // FINAL
        table.cell(tlEnvTbl, 0, 5, "FINAL", text_color = color.white, bgcolor = f_tlEnvBiasColor(tlEnvFinalBias), text_size = size.small)
        table.cell(tlEnvTbl, 1, 5, f_tlEnvBiasText(tlEnvFinalBias), text_color = color.white, bgcolor = f_tlEnvBiasColor(tlEnvFinalBias), text_size = size.small)
        table.cell(tlEnvTbl, 2, 5, tlEnvIntegrationMode, text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 3, 5, str.tostring(tlEnvScore), text_color = color.white, text_size = size.small)
        table.cell(tlEnvTbl, 4, 5, "-", text_color = color.white, text_size = size.small)

// --- デバッグ情報 (別テーブル) ---
var table tlEnvDbg = na
if tlEnvShowDebug
    if na(tlEnvDbg)
        tlEnvDbg := table.new(position.bottom_right, 2, 9, border_width = 1)
    if barstate.islast
        table.cell(tlEnvDbg, 0, 0, "TL/CH Debug", text_color = color.white, bgcolor = color.new(color.blue, 0), text_size = size.small)
        table.cell(tlEnvDbg, 1, 0, tlEnvCombineMode, text_color = color.white, bgcolor = color.new(color.blue, 0), text_size = size.small)
        table.cell(tlEnvDbg, 0, 1, "Score", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 1, str.tostring(tlEnvScore), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 2, "LONG一致数", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 2, str.tostring(tlEnvLongCnt), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 3, "SHORT一致数", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 3, str.tostring(tlEnvShortCnt), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 4, "有効時間足数", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 4, str.tostring(tlEnvEnabledCount), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 5, "最終Bias", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 5, f_tlEnvBiasText(tlEnvFinalBias), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 6, "reason(D/4H/1H/15M)", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 6, str.tostring(tlEnvDReason) + "/" + str.tostring(tlEnvHReason) + "/" + str.tostring(tlEnvOReason) + "/" + str.tostring(tlEnvMReason), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 7, "Q(D/4H/1H/15M)", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 7, str.tostring(tlEnvDQual) + "/" + str.tostring(tlEnvHQual) + "/" + str.tostring(tlEnvOQual) + "/" + str.tostring(tlEnvMQual), text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 0, 8, "EMA環境 (allowByEnv)", text_color = color.white, text_size = size.small)
        table.cell(tlEnvDbg, 1, 8, tlTrendOk ? "OK" : "NG", text_color = color.white, text_size = size.small)

// --- 上位足Trendline/Channel ライン表示 (5分足側で描画・傾き維持・現在時刻へ投影) ---
//   valNow    : 確定済み上位足1本前のライン値 (判定と同じ非リペイント値)
//   slopeHTF  : 上位足1バー当たりの傾き (価格/上位足バー)
//   ratio     : チャート秒 / 上位足秒 (= 1チャートバー当たりの上位足バー割合)
//   確定値は上位足1本分遅れているため、slopeHTF を1本分加算して現在の5分足時刻へ投影する。
f_tlEnvUpdateLine(line ln, bool show, float valNow, float slopeHTF, float ratio, int dispBars, color col) =>
    line r = ln
    if show and not na(valNow)
        float _sPerBar = nz(slopeHTF) * ratio
        float y2 = valNow + nz(slopeHTF)
        float y1 = y2 - _sPerBar * dispBars
        int x2 = bar_index
        int x1 = bar_index - dispBars
        if na(r)
            r := line.new(x1, y1, x2, y2, color = col, width = 2)
        else
            line.set_xy1(r, x1, y1)
            line.set_xy2(r, x2, y2)
            line.set_color(r, col)
    else
        if not na(r)
            line.delete(r)
            r := na
    r

var line tlEnvDLineTL = na
var line tlEnvDLineU  = na
var line tlEnvDLineL  = na
var line tlEnvHLineTL = na
var line tlEnvHLineU  = na
var line tlEnvHLineL  = na
var line tlEnvOLineTL = na
var line tlEnvOLineU  = na
var line tlEnvOLineL  = na
var line tlEnvMLineTL = na
var line tlEnvMLineU  = na
var line tlEnvMLineL  = na

if barstate.islast
    int _dispBars = 60
    float _chartSec = timeframe.in_seconds(timeframe.period)
    // 各上位足の 1上位足バー当たり傾き → 1チャートバー当たり傾きへ換算
    float _ratioD = _chartSec / math.max(timeframe.in_seconds(tlEnvDailyTF), 1)
    float _ratioH = _chartSec / math.max(timeframe.in_seconds(tlEnv4HTF), 1)
    float _ratioO = _chartSec / math.max(timeframe.in_seconds(tlEnv1HTF), 1)
    float _ratioM = _chartSec / math.max(timeframe.in_seconds(tlEnv15MTF), 1)
    bool _showD = tlEnvShowLines and useTLEnv and useTLEnvDaily
    bool _showH = tlEnvShowLines and useTLEnv and useTLEnv4H
    bool _showO = tlEnvShowLines and useTLEnv and useTLEnv1H
    bool _showM = tlEnvShowLines and useTLEnv and useTLEnv15M
    // 日足：紫 / 4H：青 / 1H：オレンジ / 15M：水色
    tlEnvDLineTL := f_tlEnvUpdateLine(tlEnvDLineTL, _showD, tlEnvDLine, tlEnvDSlope, _ratioD, _dispBars, color.new(color.purple, 0))
    tlEnvDLineU  := f_tlEnvUpdateLine(tlEnvDLineU,  _showD, tlEnvDChU,  tlEnvDSlope, _ratioD, _dispBars, color.new(color.purple, 50))
    tlEnvDLineL  := f_tlEnvUpdateLine(tlEnvDLineL,  _showD, tlEnvDChL,  tlEnvDSlope, _ratioD, _dispBars, color.new(color.purple, 50))
    tlEnvHLineTL := f_tlEnvUpdateLine(tlEnvHLineTL, _showH, tlEnvHLine, tlEnvHSlope, _ratioH, _dispBars, color.new(color.blue, 0))
    tlEnvHLineU  := f_tlEnvUpdateLine(tlEnvHLineU,  _showH, tlEnvHChU,  tlEnvHSlope, _ratioH, _dispBars, color.new(color.blue, 50))
    tlEnvHLineL  := f_tlEnvUpdateLine(tlEnvHLineL,  _showH, tlEnvHChL,  tlEnvHSlope, _ratioH, _dispBars, color.new(color.blue, 50))
    tlEnvOLineTL := f_tlEnvUpdateLine(tlEnvOLineTL, _showO, tlEnvOLine, tlEnvOSlope, _ratioO, _dispBars, color.new(color.orange, 0))
    tlEnvOLineU  := f_tlEnvUpdateLine(tlEnvOLineU,  _showO, tlEnvOChU,  tlEnvOSlope, _ratioO, _dispBars, color.new(color.orange, 50))
    tlEnvOLineL  := f_tlEnvUpdateLine(tlEnvOLineL,  _showO, tlEnvOChL,  tlEnvOSlope, _ratioO, _dispBars, color.new(color.orange, 50))
    tlEnvMLineTL := f_tlEnvUpdateLine(tlEnvMLineTL, _showM, tlEnvMLine, tlEnvMSlope, _ratioM, _dispBars, color.new(color.aqua, 0))
    tlEnvMLineU  := f_tlEnvUpdateLine(tlEnvMLineU,  _showM, tlEnvMChU,  tlEnvMSlope, _ratioM, _dispBars, color.new(color.aqua, 50))
    tlEnvMLineL  := f_tlEnvUpdateLine(tlEnvMLineL,  _showM, tlEnvMChL,  tlEnvMSlope, _ratioM, _dispBars, color.new(color.aqua, 50))

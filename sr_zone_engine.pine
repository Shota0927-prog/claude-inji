//
// ============================================================================
//  Support / Resistance Zone Engine  (Ver.1 - Zone Map only, no Entry logic)
// ============================================================================
//  目的:
//    「どこで支えられやすいか / どこが抵抗になりやすいか / そのZoneがどれくらい
//      強いか / 上下にどれだけPrice Spaceがあるか」を構造化して検出する。
//    Entryシグナルは出さない。将来のEntry ModuleがLive Zone Mapを参照して
//    Structural SL / TP / RR / Obstacle Count / PASS-FAIL を取得する。
//
//  セクション構成:
//     1. Inputs
//     2. Constants & User Defined Types
//     3. Utility Functions
//     4. MA Source Module
//     5. Horizontal Source Module          (5M / 15M / 1H Swing Pivot)
//     6. Day High / Low Module             (Asia/Tokyo 基準)
//     7. Accumulation Module               (1H / 4H / D)  ← 外部Module差し替え点
//     8. Raw Zone Generation
//     9. Cluster Engine
//    10. Strength Score Engine
//    11. Zone State Engine
//    12. Break / Flip Engine
//    13. Live Zone Map
//    14. Structural SL / TP Utility Functions  (Entry Module 接続点)
//    15. Display
//    16. Debug Table
//
//  既知の制約 (Pine Script仕様上のもの / 仕様は変更していない):
//   L1. request.security でチャート足より下位の足を参照すると、TradingViewは
//       その足の「最後のintrabar値」しか返さず精度が落ちる。1分足2000/3000MA
//       および5M Break判定を仕様どおり機能させるため、本インジケーターは
//       1分足チャートでの使用を前提とする。上位足で使うとDebug Tableに警告が出る。
//   L2. ta.sma(close, 3000) は1分足で3000本の履歴を要求する。履歴が足りない
//       銘柄/プランでは MA Zone は na となりZone生成から除外される。
//   L3. Pineには連想配列が無いため、毎バー作り直されるCluster Zoneと永続的な
//       Break/Flip状態の紐付けは「価格帯の近さ (clusterDist以内)」で行っている。
//   L4. box / label は最大500個。描画は現在価格に近い maxZonesDraw 本のみ、
//       最新バー上に描画する (Live Zone Mapの可視化であり履歴描画ではない)。
//   L5. Accumulation判定は Section 7 の差し替え可能Moduleに閉じ込めてある。
//       Zone Engine本体が使うのは各TFの [Accum Upper / Accum Lower / 更新stamp]
//       の3値のみ。"Provisional ATR" は暫定の簡易判定であり本番用ではない。
// ============================================================================

//@version=5
indicator(
     title            = "Support / Resistance Zone Engine",
     shorttitle       = "SR Zone Engine",
     overlay          = true,
     max_boxes_count  = 500,
     max_labels_count = 500,
     max_lines_count  = 500
 )

// ============================================================================
// 1. INPUTS
// ============================================================================

// ---- 1.1 Zone Geometry -----------------------------------------------------
var string G_ZONE = "01 · Zone Geometry"
zoneHalfWidth = input.float(10.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE,
     tooltip = "Zone = 中心価格 ± この値。Strengthによって幅は変えない。")

// ---- 1.2 MA Source ---------------------------------------------------------
var string G_MA = "02 · MA Source"
maTf        = input.timeframe("1",  "MA Timeframe",           group = G_MA)
maType      = input.string("EMA",   "MA Type", options = ["SMA", "EMA"], group = G_MA)
ma1Len      = input.int(2000,       "MA #1 Length", minval = 1, maxval = 4999, group = G_MA)
ma2Len      = input.int(3000,       "MA #2 Length", minval = 1, maxval = 4999, group = G_MA)
scoreMa1    = input.float(2.0,      "Base Score · MA #1", step = 0.5, group = G_MA)
scoreMa2    = input.float(2.0,      "Base Score · MA #2", step = 0.5, group = G_MA)
useMaSource = input.bool(true,      "Enable MA Source",   group = G_MA)

// ---- 1.3 MA Slope ----------------------------------------------------------
var string G_SLOPE = "03 · MA Slope"
slopeLookback   = input.int(60,   "Slope Lookback (MA TF bars)", minval = 1, group = G_SLOPE)
slopeThrMod     = input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_SLOPE)
slopeThrStrong  = input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_SLOPE)
slopeBonusFlat  = input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_SLOPE)
slopeBonusMod   = input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_SLOPE)
slopeBonusStr   = input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_SLOPE)
slopeBonusMode  = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster",
     options = ["Sum (per MA)", "Max"], group = G_SLOPE,
     tooltip = "同一Cluster内に2000MAと3000MAが両方入った場合、Slope Bonusを合算するか最大値のみ採用するか。")
maClusterDist   = input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_SLOPE)
maClusterBonusV = input.float(1.0, "MA Cluster Bonus",              step = 0.5, group = G_SLOPE)
maClusterDirBns = input.float(1.0, "MA Cluster Bonus · Same Slope", step = 0.5, group = G_SLOPE)

// ---- 1.4 Horizontal Source -------------------------------------------------
var string G_HZ = "04 · Horizontal Source (Swing)"
useHzSource = input.bool(true,      "Enable Horizontal Source", group = G_HZ)
hzTf1       = input.timeframe("5",  "Horizontal TF #1", group = G_HZ)
hzTf2       = input.timeframe("15", "Horizontal TF #2", group = G_HZ)
hzTf3       = input.timeframe("60", "Horizontal TF #3", group = G_HZ)
pivLen1     = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_HZ)
pivLen2     = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_HZ)
pivLen3     = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_HZ)
// Base Score は「同一Cluster内の同一TF Swing件数」で圧縮評価する。
// 同じ種類のSwingが何本あってもTier上限までしか伸びない (Score膨張の防止)。
scoreHz1    = input.float(1.0, "Base Score · TF #1 Swing (Tier1 = 1本)", step = 0.5, group = G_HZ)
scoreHz2    = input.float(2.0, "Base Score · TF #2 Swing (Tier1 = 1本)", step = 0.5, group = G_HZ)
scoreHz3    = input.float(3.0, "Base Score · TF #3 Swing (Tier1 = 1本)", step = 0.5, group = G_HZ)
swingTier2Cnt = input.int(2, "Swing件数 · Tier2 開始本数", minval = 2, group = G_HZ)
swingTier3Cnt = input.int(4, "Swing件数 · Tier3 開始本数", minval = 2, group = G_HZ)
scoreHz1T2  = input.float(2.0, "Base Score · TF #1 Swing (Tier2)", step = 0.5, group = G_HZ)
scoreHz1T3  = input.float(3.0, "Base Score · TF #1 Swing (Tier3)", step = 0.5, group = G_HZ)
scoreHz2T2  = input.float(3.0, "Base Score · TF #2 Swing (Tier2)", step = 0.5, group = G_HZ)
scoreHz2T3  = input.float(4.0, "Base Score · TF #2 Swing (Tier3)", step = 0.5, group = G_HZ)
scoreHz3T2  = input.float(4.0, "Base Score · TF #3 Swing (Tier2)", step = 0.5, group = G_HZ)
scoreHz3T3  = input.float(4.0, "Base Score · TF #3 Swing (Tier3)", step = 0.5, group = G_HZ)

// ---- 1.5 Horizontal Reaction ----------------------------------------------
var string G_REACT = "05 · Horizontal Reaction"
reactionDist    = input.float(10.0, "Reaction Distance ($)", step = 0.5, group = G_REACT,
     tooltip = "Zoneに接触したあと、来た方向へこの距離以上戻ればReaction 1回。")
reactionBonus1  = input.float(1.0, "Reaction Bonus · 1 time",  step = 0.5, group = G_REACT)
reactionBonus2  = input.float(2.0, "Reaction Bonus · 2+ times", step = 0.5, group = G_REACT)
reactionCap     = input.float(2.0, "Reaction Bonus Cap",        step = 0.5, group = G_REACT)
reactionAllSrc  = input.bool(false, "Track Reaction on Accum / DayHL too", group = G_REACT,
     tooltip = "仕様どおりの既定は OFF (水平線のみ)。ONにすると静的Zone全般でReactionを数える。")

// ---- 1.6 Day High / Low ----------------------------------------------------
var string G_DHL = "06 · Day High / Low"
useDayHL        = input.bool(true, "Enable Day High / Low Source", group = G_DHL)
dayTz           = input.string("Asia/Tokyo", "Day Session Timezone", group = G_DHL)
scoreDayHL      = input.float(3.0, "Base Score · Day High / Low", step = 0.5, group = G_DHL)
carryPrevDayHL  = input.bool(false, "Carry Previous Day H/L as Horizontal Zone", group = G_DHL,
     tooltip = "日付変更時に旧Day High / Low をHorizontal Zoneとして保持する。")
scorePrevDayHL  = input.float(2.0, "Base Score · Carried Prev Day H/L", step = 0.5, group = G_DHL)
lifePrevDayHL   = input.float(5.0, "Lifetime · Carried Prev Day H/L (days)", step = 1.0, group = G_DHL)

// ---- 1.7 Accumulation ------------------------------------------------------
// Zone Engine が使うのは「各TFの Accum Upper / Accum Lower」だけ。
// 判定ロジック本体は Section 7 の差し替え可能Moduleに閉じ込めてある。
var string G_ACC = "07 · Accumulation"
useAccSource = input.bool(true,       "Enable Accumulation Source", group = G_ACC)
accumModule  = input.string("Accum Box (ported)", "Accum Detection Module",
     options = ["Accum Box (ported)", "Provisional ATR (暫定)"], group = G_ACC,
     tooltip = "Accum Box (ported) = 実運用のAccum判定ロジック。\nProvisional ATR = Ver.1初期の暫定簡易判定 (本番用ではない)。")
accTf1       = input.timeframe("60",  "Accum TF #1", group = G_ACC)
accTf2       = input.timeframe("240", "Accum TF #2", group = G_ACC)
accTf3       = input.timeframe("D",   "Accum TF #3", group = G_ACC)
scoreAcc1    = input.float(3.0, "Base Score · TF #1 Accum", step = 0.5, group = G_ACC)
scoreAcc2    = input.float(4.0, "Base Score · TF #2 Accum", step = 0.5, group = G_ACC)
scoreAcc3    = input.float(5.0, "Base Score · TF #3 Accum", step = 0.5, group = G_ACC)
lifeAcc      = input.float(30.0, "Lifetime · Accum Zone (days)", step = 1.0, group = G_ACC)

// ---- 1.7a Accum Box (ported) パラメータ ------------------------------------
var string G_ACCP = "07a · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",            minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",                minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

// ---- 1.7b Provisional ATR (暫定) パラメータ --------------------------------
// ★ 暫定ロジック専用。本番のAccum判定では使用しない。
var string G_ACCQ = "07b · Provisional ATR Accum (暫定・本番未使用)"
accLen1      = input.int(20, "[暫定] Accum Lookback · TF #1 (bars)", minval = 3, group = G_ACCQ)
accLen2      = input.int(20, "[暫定] Accum Lookback · TF #2 (bars)", minval = 3, group = G_ACCQ)
accLen3      = input.int(15, "[暫定] Accum Lookback · TF #3 (bars)", minval = 3, group = G_ACCQ)
accMult      = input.float(1.2, "[暫定] Accum Max Range / ATR", step = 0.1, minval = 0.1, group = G_ACCQ,
     tooltip = "★暫定★ レンジ幅(highest-lowest) <= ATR * この値 でAccumとみなす簡易判定。")

// ---- 1.8 Cluster -----------------------------------------------------------
var string G_CLU = "08 · Cluster"
clusterDist = input.float(20.0, "Cluster Distance ($)", step = 1.0, group = G_CLU,
     tooltip = "Raw Zone中心同士がこの距離以内ならCluster候補。統合後も全Sourceが最終Centerからこの距離以内であることを検証する。")

// ---- 1.9 Strength Score ----------------------------------------------------
var string G_SCORE = "09 · Strength Score"
thrMedium   = input.float(5.0,  "Medium Score Threshold",      step = 0.5, group = G_SCORE,
     tooltip = "これ未満は Weak。")
thrStrong   = input.float(10.0, "Strong Score Threshold",      step = 0.5, group = G_SCORE)
thrVStrong  = input.float(15.0, "Very Strong Score Threshold", step = 0.5, group = G_SCORE)
confBonus2  = input.float(1.0, "Confluence Bonus · 2 categories",  step = 0.5, group = G_SCORE)
confBonus3  = input.float(2.0, "Confluence Bonus · 3 categories",  step = 0.5, group = G_SCORE)
confBonus4  = input.float(3.0, "Confluence Bonus · 4+ categories", step = 0.5, group = G_SCORE)
flipBonusV  = input.float(2.0, "Flip Bonus", step = 0.5, group = G_SCORE)

// ---- 1.9a Very Strong · Higher Timeframe Structure --------------------------
// Very Strong は Score だけでは決めない。上位足構造を最低1つ含むことを条件にする。
// どのSourceを「上位足構造」とみなすかは個別にON/OFFできる (後から検証で変更可)。
var string G_HTF = "09a · Very Strong · Higher TF Structure"
requireHtfForVStrong = input.bool(true, "Require Higher TF Structure for Very Strong", group = G_HTF,
     tooltip = "true  : Score >= Very Strong閾値 かつ 上位足構造あり → VERY STRONG\n" +
               "false : Score >= Very Strong閾値 だけで → VERY STRONG")
htfSwing1H  = input.bool(true,  "Count 1H Swing (TF #3) as Higher TF",   group = G_HTF)
htfAccum1H  = input.bool(true,  "Count 1H Accum (TF #1) as Higher TF",   group = G_HTF)
htfAccum4H  = input.bool(true,  "Count 4H Accum (TF #2) as Higher TF",   group = G_HTF)
htfAccumD   = input.bool(true,  "Count Daily Accum (TF #3) as Higher TF", group = G_HTF)
htfSwing15M = input.bool(false, "Count 15M Swing (TF #2) as Higher TF",  group = G_HTF)
htfMa1      = input.bool(false, "Count MA #1 (2000) as Higher TF",       group = G_HTF)
htfMa2      = input.bool(false, "Count MA #2 (3000) as Higher TF",       group = G_HTF)
htfDayHL    = input.bool(false, "Count Day High / Low as Higher TF",     group = G_HTF)

// ---- 1.10 Break / Flip -----------------------------------------------------
var string G_BF = "10 · Break / Flip"
breakTf         = input.timeframe("5", "Break Evaluation Timeframe", group = G_BF,
     tooltip = "Breakはヒゲではなくこの時間足の確定終値で判定する。")
breakBuffer     = input.float(5.0,  "Break Buffer ($)",         step = 0.5, group = G_BF)
flipConfirmDist = input.float(10.0, "Flip Confirm Distance ($)", step = 0.5, group = G_BF)
resetOnReclaim  = input.bool(true,  "Reset Broken on Reclaim", group = G_BF,
     tooltip = "Break後、Flip未成立のまま元の側へ明確に戻った場合はBreakを無効化してStateを再判定する。")
trackStaleBars  = input.int(500, "Zone State Retention (bars without match)", minval = 10, group = G_BF)
trackContinuity = input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_BF,
     tooltip = "ZoneTrackを継承する条件。Center距離が近いだけでは継承せず、Source構成の重なり率が\nこの値以上であることを要求する。1.0 = Source構成完全一致のみ継承。")

// ---- 1.11 Zone Lifetime ----------------------------------------------------
var string G_LIFE = "11 · Zone Lifetime"
lifeHz1         = input.float(2.0,  "Lifetime · TF #1 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeHz2         = input.float(5.0,  "Lifetime · TF #2 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeHz3         = input.float(14.0, "Lifetime · TF #3 Horizontal (days)",  step = 0.5, group = G_LIFE)
lifeExtendOn    = input.bool(true,  "Extend Lifetime on Reaction / Flip", group = G_LIFE)
lifeExtendRatio = input.float(0.5,  "Lifetime Extension Ratio", step = 0.1, minval = 0.0, group = G_LIFE)
maxPersistZones = input.int(200, "Max Persistent Raw Zones", minval = 20, maxval = 800, group = G_LIFE)

// ---- 1.12 Structural SL / TP ----------------------------------------------
var string G_SLTP = "12 · Structural SL / TP (Entry Module API)"
slBuffer      = input.float(5.0,  "SL Buffer ($)", step = 0.5, group = G_SLTP)
tpBuffer      = input.float(5.0,  "TP Buffer ($)", step = 0.5, group = G_SLTP)
maxSlDist     = input.float(30.0, "Max SL Distance ($)", step = 1.0, group = G_SLTP)
minStructRR   = input.float(1.0,  "Minimum Structural RR", step = 0.1, group = G_SLTP)
slMinScore    = input.float(4.0,  "SL Zone · Min Score", step = 0.5, group = G_SLTP)
slMinStrStr   = input.string("Medium", "SL Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
tpMinScore    = input.float(7.0,  "TP Zone · Min Score", step = 0.5, group = G_SLTP)
tpMinStrStr   = input.string("Strong", "TP Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
obsMinStrStr  = input.string("Medium", "Obstacle · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
// SL / TP / Obstacle は Zone State も必須条件とする。
// ST_ACTIVE と ST_BROKEN は常に候補外 (input で有効化する手段は設けない)。

// ---- 1.13 Display ----------------------------------------------------------
var string G_DISP = "13 · Display"
showZones      = input.bool(true,  "Show Zones (box)",        group = G_DISP)
showMaLines    = input.bool(true,  "Plot MA Source Lines",    group = G_DISP)
showLabels     = input.bool(true,  "Show Zone Labels",        group = G_DISP)
showDetailLbl  = input.bool(false, "Detailed Labels (sources)", group = G_DISP)
maxZonesDraw   = input.int(30, "Max Zones Drawn", minval = 1, maxval = 120, group = G_DISP)
zoneLeftBars   = input.int(150, "Zone Box · Left Extension (bars)",  minval = 1, group = G_DISP)
zoneRightBars  = input.int(30,  "Zone Box · Right Extension (bars)", minval = 1, group = G_DISP)
colSupport     = input.color(color.new(#26A69A, 0), "Color · Support",    group = G_DISP)
colResistance  = input.color(color.new(#EF5350, 0), "Color · Resistance", group = G_DISP)
colActive      = input.color(color.new(#FFB300, 0), "Color · Active",     group = G_DISP)
colBroken      = input.color(color.new(#78909C, 0), "Color · Broken",     group = G_DISP)
trWeak         = input.int(90, "Transparency · Weak",        minval = 0, maxval = 100, group = G_DISP)
trMedium       = input.int(80, "Transparency · Medium",      minval = 0, maxval = 100, group = G_DISP)
trStrong       = input.int(68, "Transparency · Strong",      minval = 0, maxval = 100, group = G_DISP)
trVStrong      = input.int(55, "Transparency · Very Strong", minval = 0, maxval = 100, group = G_DISP)

// ---- 1.14 Debug ------------------------------------------------------------
var string G_DBG = "14 · Debug"
showDebugTable = input.bool(true, "Show Debug Table", group = G_DBG)
dbgPosStr      = input.string("Top Right", "Debug Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = G_DBG)
dbgNearestN    = input.int(3, "Nearest Zones per Side", minval = 1, maxval = 5, group = G_DBG)
dbgTextSize    = input.string("Small", "Debug Table Text Size", options = ["Tiny", "Small", "Normal"], group = G_DBG)
showPlanPrev   = input.bool(false, "Show Structural Plan Preview", group = G_DBG,
     tooltip = "Entryロジックは未実装。ここではEntry Priceを手入力してSL/TP/RR/Obstacle/PASS-FAILの動作確認だけを行う。")
prevEntryDir   = input.string("Long", "Preview Direction", options = ["Long", "Short"], group = G_DBG)
prevEntryPrice = input.float(0.0, "Preview Entry Price (0 = current close)", step = 0.1, group = G_DBG)

// ============================================================================
// 2. CONSTANTS & USER DEFINED TYPES
// ============================================================================

// Zone State
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3

// Strength tier
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// Source Category (§14) — Confluence判定はこの文字列だけを見る。
// 新Sourceを足すときは既存カテゴリーに割り当てるか、ここへ1つ追加するだけでよい。
string CAT_MA   = "MA"
string CAT_HZ   = "Horizontal"
string CAT_DHL  = "DayHL"
string CAT_ACC  = "Accum"

int MS_PER_DAY = 86400000

// ---------------------------------------------------------------------------
// 2.1 RawZone : 個々のSourceが生成する単位Zone (§10)
// ---------------------------------------------------------------------------
type RawZone
    int    uid          = 0         // Source インスタンス識別子 (ZoneTrack継承判定に使用)
    int    instId       = 0         // Sourceインスタンスの同一性キー (Accum検出ID / 日付など)
    string srcId        = ""        // "MA1" / "SWING" / "DAY_HIGH" / "ACC_HI" ...
    string srcCat       = ""        // CAT_MA / CAT_HZ / CAT_DHL / CAT_ACC
    string srcTf        = ""        // Source Timeframe
    string srcLabel     = ""        // 表示用ラベル ("2000MA↑", "1H Accum Low" ...)
    float  center       = 0.0
    float  top          = 0.0
    float  bottom       = 0.0
    float  baseScore    = 0.0
    int    slopeState   = 0         // 0 Flat / 1 Moderate / 2 Strong
    int    slopeDir     = 0         // -1 down / 0 flat / +1 up
    float  slopeBonus   = 0.0
    float  maClusterBonus = 0.0
    int    reactionCnt  = 0
    float  reactionBonus = 0.0
    bool   flipped      = false     // 直近マッチしたZone Trackのflip状態
    float  flipBonus    = 0.0
    int    entrySide    = 0         // Reaction計測用: +1 上から進入 / -1 下から進入
    int    createdBar   = 0
    int    createdTime  = 0
    int    expireTime   = 0         // 0 = 無期限
    int    lifeMs       = 0
    bool   dynamic      = false     // true = 毎バー再計算 (MA / Day H-L)

// ---------------------------------------------------------------------------
// 2.2 Zone : Cluster統合後の最終Zone。Live Zone Mapの構成要素 (§23)
// ---------------------------------------------------------------------------
type Zone
    float  center       = 0.0
    float  top          = 0.0
    float  bottom       = 0.0
    float  score        = 0.0
    float  baseSum      = 0.0
    float  slopeBonus   = 0.0
    float  maBonus      = 0.0
    float  reactionBonus = 0.0
    float  flipBonus    = 0.0
    float  confBonus    = 0.0
    int    strength     = 1
    int    state        = 0
    bool   flipped      = false
    int    flipDir      = 0
    int    catCount     = 0
    int    memberCount  = 0
    string sources      = ""
    int    trackId      = -1
    array<int> memberUids           // 構成SourceのuidリストID (誤継承防止 §6)
    string sourceSig    = ""        // 構成Sourceの署名文字列 (Debug / 目視確認用)
    bool   hasHtf       = false     // 上位足構造を含むか (Very Strong成立条件)
    string htfSources   = ""        // 含んでいる上位足構造の内訳 (Debug用)

// ---------------------------------------------------------------------------
// 2.3 ZoneTrack : Zone State / Break / Flip の永続ステート (§17-§20)
//     Cluster Zoneは毎バー作り直されるため、状態は価格帯で紐付けて保持する。
// ---------------------------------------------------------------------------
type ZoneTrack
    int   id          = 0
    float center      = 0.0
    float top         = 0.0
    float bottom      = 0.0
    int   state       = 0
    int   lastRole    = 0     // 直近の確定Role: +1 Support / -1 Resistance / 0 未確定
    int   breakDir    = 0     // +1 Up Break済 / -1 Down Break済 / 0 なし
    int   breakBar    = 0
    bool  retested    = false
    bool  flipped     = false
    int   flipDir     = 0     // +1 Resistance→Support / -1 Support→Resistance
    int   lastSeenBar = 0
    bool  matched     = false
    array<int> memberUids           // 前回マッチ時のSource構成スナップショット
    string sourceSig  = ""

// ---------------------------------------------------------------------------
// 2.4 TradePlan : Entry Moduleへ返す構造 (§24-§29)
// ---------------------------------------------------------------------------
type TradePlan
    bool   valid        = false
    string status       = "FAIL"
    string reason       = "NO_ENTRY"
    int    dir          = 0        // +1 Long / -1 Short
    float  entry        = 0.0
    float  sl           = 0.0
    float  tp           = 0.0
    float  risk         = 0.0
    float  reward       = 0.0
    float  rr           = 0.0
    int    obstacles    = 0
    float  slZoneCenter = 0.0
    float  slZoneScore  = 0.0
    float  tpZoneCenter = 0.0
    float  tpZoneScore  = 0.0

// ============================================================================
// 3. UTILITY FUNCTIONS
// ============================================================================

// タイムフレーム文字列の表示名 (HTF表示用のみ。Score計算には無関係)
f_tfName(string tf) =>
    tf == "1"    ? "1M"  : tf == "3"   ? "3M"  : tf == "5"   ? "5M"  :
     tf == "15"  ? "15M" : tf == "30"  ? "30M" : tf == "45"  ? "45M" :
     tf == "60"  ? "1H"  : tf == "120" ? "2H"  : tf == "180" ? "3H"  :
     tf == "240" ? "4H"  : tf == "360" ? "6H"  : tf == "720" ? "12H" : tf

// Score + Higher TF Structure → Strength Tier (§16)
//   score < mediumThreshold      → Weak
//   score < strongThreshold      → Medium
//   score < veryStrongThreshold  → Strong
//   それ以上                     → requireHtfForVStrong が true なら
//                                  上位足構造を含む場合のみ Very Strong、
//                                  含まなければ Strong 止まり。
f_strengthOf(float score, bool hasHtf) =>
    int t = score < thrMedium ? SR_WEAK : score < thrStrong ? SR_MEDIUM : score < thrVStrong ? SR_STRONG : SR_VSTRONG
    if t == SR_VSTRONG and requireHtfForVStrong and not hasHtf
        t := SR_STRONG
    t

f_strengthName(int s) =>
    s == SR_VSTRONG ? "VERY STRONG" : s == SR_STRONG ? "STRONG" : s == SR_MEDIUM ? "MEDIUM" : "WEAK"

f_strengthIdx(string s) =>
    s == "Very Strong" ? SR_VSTRONG : s == "Strong" ? SR_STRONG : s == "Medium" ? SR_MEDIUM : SR_WEAK

f_stateName(int st) =>
    st == ST_SUPPORT ? "SUP" : st == ST_RESIST ? "RES" : st == ST_ACTIVE ? "ACT" : "BRK"

f_stateFull(int st) =>
    st == ST_SUPPORT ? "Support" : st == ST_RESIST ? "Resistance" : st == ST_ACTIVE ? "Active" : "Broken"

f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)

f_arrow(int dir) =>
    dir > 0 ? "↑" : dir < 0 ? "↓" : "→"

// Slope 3段階判定 (§4)
f_slopeState(float delta) =>
    float a = math.abs(nz(delta))
    a >= slopeThrStrong ? 2 : a >= slopeThrMod ? 1 : 0

f_slopeDir(float delta) =>
    nz(delta) > 0 ? 1 : nz(delta) < 0 ? -1 : 0

f_slopeBonusValue(int st) =>
    st == 2 ? slopeBonusStr : st == 1 ? slopeBonusMod : slopeBonusFlat

// Reaction回数 → Bonus (§7)
f_reactionBonus(int cnt) =>
    math.min(cnt <= 0 ? 0.0 : cnt == 1 ? reactionBonus1 : reactionBonus2, reactionCap)

// Horizontal Swing の件数圧縮 (同一Cluster内・同一TFのSwing本数 → Base Score)
//   既定: 5M  1本+1 / 2-3本+2 / 4本以上+3
//         15M 1本+2 / 2-3本+3 / 4本以上+4
//         1H  1本+3 / 2本以上+4  (Tier2 = Tier3 = 4 として表現)
f_swingTierScore(int cnt, float s1, float s2, float s3) =>
    cnt <= 0 ? 0.0 : cnt >= swingTier3Cnt ? s3 : cnt >= swingTier2Cnt ? s2 : s1

// Confluence Bonus (§15)
f_confluenceBonus(int catCount) =>
    catCount >= 4 ? confBonus4 : catCount == 3 ? confBonus3 : catCount == 2 ? confBonus2 : 0.0

f_days2ms(float d) =>
    int(d * MS_PER_DAY)

// ============================================================================
// 4. MA SOURCE MODULE  (§3 / §4 / §5 / §22)
// ============================================================================
// 1分足 2000MA / 3000MA。動的Sourceなので毎バー再計算される。

f_ma(float src, simple int len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

f_maPack() =>
    float m1 = f_ma(close, ma1Len)
    float m2 = f_ma(close, ma2Len)
    float d1 = m1 - m1[slopeLookback]
    float d2 = m2 - m2[slopeLookback]
    [m1, d1, m2, d2]

[ma1Val, ma1Delta, ma2Val, ma2Delta] = request.security(syminfo.tickerid, maTf, f_maPack(),
     lookahead = barmerge.lookahead_off)

int   ma1Dir   = f_slopeDir(ma1Delta)
int   ma2Dir   = f_slopeDir(ma2Delta)
int   ma1State = f_slopeState(ma1Delta)
int   ma2State = f_slopeState(ma2Delta)

// Slope Bonusは「MAの向き」と「そのZoneが機能する向き」が一致した時だけ (§4)
f_maSlopeBonus(float maVal, int dir, int st) =>
    bool aligned = (dir > 0 and close > maVal) or (dir < 0 and close < maVal)
    aligned ? f_slopeBonusValue(st) : 0.0

float ma1SlopeBonus = na(ma1Val) ? 0.0 : f_maSlopeBonus(ma1Val, ma1Dir, ma1State)
float ma2SlopeBonus = na(ma2Val) ? 0.0 : f_maSlopeBonus(ma2Val, ma2Dir, ma2State)

// MA Cluster Bonus (§5)
float maClusterBonus = 0.0
if not na(ma1Val) and not na(ma2Val) and math.abs(ma1Val - ma2Val) <= maClusterDist
    maClusterBonus := maClusterBonusV
    if ma1Dir != 0 and ma1Dir == ma2Dir
        maClusterBonus += maClusterDirBns

// ============================================================================
// 5. HORIZONTAL SOURCE MODULE  (§6)
// ============================================================================
// Swing High / Low。ta.pivothigh/pivotlow は右側 len 本が確定して初めて値が出る
// ため、未確定Pivotは構造的に使用されない (= リペイントしない)。

f_pivotPack(simple int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low,  len, len)
    int   pt = na(ph) ? int(na) : time
    int   lt = na(pl) ? int(na) : time
    [ph, pt, pl, lt]

[ph1, ph1T, pl1, pl1T] = request.security(syminfo.tickerid, hzTf1, f_pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
[ph2, ph2T, pl2, pl2T] = request.security(syminfo.tickerid, hzTf2, f_pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
[ph3, ph3T, pl3, pl3T] = request.security(syminfo.tickerid, hzTf3, f_pivotPack(pivLen3), lookahead = barmerge.lookahead_off)

// 「新しいPivot / Accumが確定した瞬間」だけ true になる立ち上がりエッジは
// §8.0 でグローバル系列として計算する (関数引数の履歴参照を避けるため)。

// ============================================================================
// 6. DAY HIGH / LOW MODULE  (§8)
// ============================================================================
// Asia/Tokyo (input) 基準の暦日で当日高値・安値を保持する。
// 日付変更でリセット。旧値はオプションでHorizontal Zoneへ引き継げる。

int  _dayNo  = dayofmonth(time, dayTz)
bool isNewDay = na(_dayNo[1]) or _dayNo != _dayNo[1]

var float dayHigh     = na
var float dayLow      = na
var float prevDayHigh = na
var float prevDayLow  = na

if isNewDay
    prevDayHigh := dayHigh
    prevDayLow  := dayLow
    dayHigh     := high
    dayLow      := low
else
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow  := na(dayLow)  ? low  : math.min(dayLow,  low)

// ============================================================================
// 7. ACCUMULATION MODULE  (§9)   ★ 外部Accum判定Moduleの差し替えポイント ★
// ============================================================================
// Zone Engine 本体が Accumulation について必要とするのは、各時間足の
//     1H Accum Upper / 1H Accum Lower
//     4H Accum Upper / 4H Accum Lower
//     D  Accum Upper / D  Accum Lower
// の6値だけである。したがってこのModuleの対外契約は次の1点しかない。
//
//     f_accumPack(...) => [accumUpper, accumLower, accumInstId]
//         accumUpper  : Accum Box の上限価格 (na = Accum無し)
//         accumLower  : Accum Box の下限価格 (na = Accum無し)
//         accumInstId : Accum検出ID。同一Accumインスタンスが継続している間は不変で、
//                       新しいAccumが発生したときだけ値が変わること。
//                       Zone Engine はこのIDで「同一Accumの範囲更新」と
//                       「新規Accum」を区別する (価格距離では判定しない)。
//
// この3値さえ返せば、Raw Zone化から下流 (Cluster / Score / State / Break /
// Flip / Structural SL-TP) は一切変更せずに判定ロジックを差し替えられる。
//
// 同梱実装は2つ。input "Accum Detection Module" で選択する。
//   (A) "Accum Box (ported)"   : 実運用のAccum判定ロジック。既定。
//   (B) "Provisional ATR (暫定)" : ★暫定★ Ver.1初期の仮実装。
//                                 highest-lowest <= ATR*mult だけの簡易判定であり
//                                 本番のAccum判定ではない。差し替え対象。
// ---------------------------------------------------------------------------

bool usePortedAccum = accumModule == "Accum Box (ported)"

// ---------------------------------------------------------------------------
// (A) Accum Box (ported)  — 実運用ロジック
//     ★ここを丸ごと置き換えれば別のAccum判定へ差し替えられる★
//     f_accumBoxState() が [検出ID, 上限(実体), 下限(実体)] を返すことだけが契約。
//     リペイント防止: barstate.isconfirmed (= 上位足確定) でのみ state を更新。
// ---------------------------------------------------------------------------
f_accumBoxCore(_atrMult, _barRatioMax, _driftMax) =>
    _atr = ta.atr(accumAtrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * _atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, accumRangeLen) - ta.lowest(_bodyBotNow, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, accumBaseLen)  - ta.lowest(_bodyBotNow, accumBaseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _barRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _driftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_accumBoxState() =>
    _isAccum   = f_accumBoxCore(accumAtrMult, accumBarRatioMax, accumDriftMax)
    _accumHigh = ta.highest(math.max(open, close), accumRangeLen)   // 実体ベース上限
    _accumLow  = ta.lowest(math.min(open, close), accumRangeLen)    // 実体ベース下限
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na    // 検出ID (新規Accum開始時のtime) = 重複登録防止キー

    if barstate.isconfirmed
        // 新規Accum開始: 古い範囲を破棄して新しい範囲へ
        if _isStart
            _top := _accumHigh
            _bot := _accumLow
            _sid := time
        // Accum継続中: 実体ベースで範囲を拡張
        if _isAccum
            _bt = math.max(open, close)
            _bb = math.min(open, close)
            _top := math.max(nz(_top, _bt), _bt)
            _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot]

// ---------------------------------------------------------------------------
// (B) Provisional ATR  — ★暫定ロジック★ (本番未使用 / 差し替え対象)
//     Ver.1初期の仮実装。直近 len 本のレンジ幅が ATR(len)*mult 以下なら Accum。
// ---------------------------------------------------------------------------
f_accumDetectProvisional(simple int len, float mult) =>
    float hh   = ta.highest(high, len)
    float ll   = ta.lowest(low,  len)
    float atrv = ta.atr(len)
    bool  isAcc = not na(atrv) and atrv > 0 and (hh - ll) <= atrv * mult
    [hh, ll, isAcc]

// ---------------------------------------------------------------------------
// アダプタ: 選択されたModuleの結果を共通契約 [upper, lower, instId] に変換する。
// Zone Engine 側はこの3値しか見ない。
// 検出IDは「Accumが継続している間は不変 / 新規Accumで変化」であることが必須。
//   (A) ported      : f_accumBoxState() の _sid をそのまま使う (新規Accum開始時のtime)
//   (B) provisional : 一過性フラグしか持たないため、ここでAccum継続中は保持し、
//                     Accum終了で na に戻す形へ変換する
// ---------------------------------------------------------------------------
f_accumPack(simple int provLen, float provMult) =>
    // (A) ported: barstate.isconfirmed 内でのみ更新されるので既に確定値
    [pSid, pTop, pBot] = f_accumBoxState()
    // (B) provisional: 上位足の確定バーのみ見るため 1 本ずらす
    [qHi, qLo, qIsAcc] = f_accumDetectProvisional(provLen, provMult)
    bool qNew = qIsAcc and not qIsAcc[1]
    var int qSid = na
    if not nz(qIsAcc[1], false)
        qSid := int(na)                 // Accum終了 → インスタンス終了
    if nz(qNew[1], false)
        qSid := time[1]                 // 新規Accum開始 → 新インスタンスID

    float upper  = usePortedAccum ? pTop : qHi[1]
    float lower  = usePortedAccum ? pBot : qLo[1]
    int   instId = usePortedAccum ? pSid : qSid
    [upper, lower, instId]

[acc1Hi, acc1Lo, acc1Id] = request.security(syminfo.tickerid, accTf1, f_accumPack(accLen1, accMult), lookahead = barmerge.lookahead_off)
[acc2Hi, acc2Lo, acc2Id] = request.security(syminfo.tickerid, accTf2, f_accumPack(accLen2, accMult), lookahead = barmerge.lookahead_off)
[acc3Hi, acc3Lo, acc3Id] = request.security(syminfo.tickerid, accTf3, f_accumPack(accLen3, accMult), lookahead = barmerge.lookahead_off)

// ============================================================================
// 7.5 BREAK TIMEFRAME FEED  (§18)
// ============================================================================
// Break判定は breakTf の「確定終値」のみ。ヒゲでは判定しない。

[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low],
     lookahead = barmerge.lookahead_off)

bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

// ============================================================================
// 8. RAW ZONE GENERATION  (§10 / §21 / §36)
// ============================================================================
// 静的Source (Swing / Accum / 引き継いだPrev Day H-L) は gPersist に蓄積し、
// 寿命が来たら破棄する。動的Source (MA / 当日High-Low) は毎バー作り直す。
//
// ★ 新Sourceを追加する場合はここに f_registerStatic() / f_makeRaw() を1行
//    足すだけでよい。Cluster / Score / State 以降は一切変更不要。

var array<RawZone> gPersist = array.new<RawZone>()

// Source インスタンス識別子 (uid)。ZoneTrackの誤継承防止に使う (§6)。
//   MA #1 / MA #2 : 固定の負値。価格が動いても常に同一Sourceであり続ける。
//   Day High/Low  : 日付ごとに新規発行。前日と翌日は別Sourceとして扱う。
//   Swing / Accum / Prev Day : 実体ごとに 1, 2, 3, ... を発行 (Accumは検出ID単位)。
// 関数からグローバルスカラーは書き換えられないため、カウンターは配列で保持する。
var array<int> gUidSeq = array.new_int(1, 0)
int UID_MA1 = -1
int UID_MA2 = -2

f_nextUid() =>
    int u = array.get(gUidSeq, 0) + 1
    array.set(gUidSeq, 0, u)
    u

// Day High / Low は日付が変われば「別Source」である。
// 日付変更時に新しいUIDを発行し、前日のBreak / Flip状態を翌日へ継承させない。
// 同一日の中では Day High / Low が更新されても同じUIDを維持するため、
// 当日中の高値・安値切り上げにはZoneTrackが追従する。
// (MA1 / MA2 は固定UIDのまま = 常に同一Source)
var int gDayHighUid = 0
var int gDayLowUid  = 0
if isNewDay or gDayHighUid == 0
    gDayHighUid := f_nextUid()
    gDayLowUid  := f_nextUid()

f_makeRaw(int uid, string id, string cat, string tf, string lbl, float c, float bs, bool dyn) =>
    RawZone.new(uid = uid, srcId = id, srcCat = cat, srcTf = tf, srcLabel = lbl,
         center = c, top = c + zoneHalfWidth, bottom = c - zoneHalfWidth,
         baseScore = bs, createdBar = bar_index, createdTime = time, dynamic = dyn)

// 静的Zoneの登録 (同一TF・同一価格帯の重複は寿命リフレッシュのみ)
f_registerStatic(bool trig, float price, string id, string cat, string tf, string lbl, float bs, float lifeDays) =>
    if trig and not na(price)
        int life = f_days2ms(lifeDays)
        bool dup = false
        if array.size(gPersist) > 0
            for i = 0 to array.size(gPersist) - 1
                RawZone z = array.get(gPersist, i)
                if z.srcId == id and z.srcTf == tf and math.abs(z.center - price) <= zoneHalfWidth
                    dup := true
                    if life > 0
                        z.expireTime := time + life
                    break
        if not dup
            RawZone nz = f_makeRaw(f_nextUid(), id, cat, tf, lbl, price, bs, false)
            nz.lifeMs     := life
            nz.expireTime := life > 0 ? time + life : 0
            array.push(gPersist, nz)

// ---- 8.0 新規確定の立ち上がりエッジ (全バーで無条件に評価する) -------------
bool nPh1 = not na(ph1T)  and (na(ph1T[1])  or ph1T  != ph1T[1])
bool nPl1 = not na(pl1T)  and (na(pl1T[1])  or pl1T  != pl1T[1])
bool nPh2 = not na(ph2T)  and (na(ph2T[1])  or ph2T  != ph2T[1])
bool nPl2 = not na(pl2T)  and (na(pl2T[1])  or pl2T  != pl2T[1])
bool nPh3 = not na(ph3T)  and (na(ph3T[1])  or ph3T  != ph3T[1])
bool nPl3 = not na(pl3T)  and (na(pl3T[1])  or pl3T  != pl3T[1])
// Accumは「新規検出 (検出IDの変化)」だけでなく「Box上限/下限の更新」でも評価する。
// 同一検出IDなら f_registerAccumZone 側で既存Raw Zoneの位置更新に回るため、
// 継続中のAccumが複数Zoneに分裂することはない。
bool nAc1 = (not na(acc1Id) and (na(acc1Id[1]) or acc1Id != acc1Id[1]))
          or (not na(acc1Hi) and (na(acc1Hi[1]) or acc1Hi != acc1Hi[1]))
          or (not na(acc1Lo) and (na(acc1Lo[1]) or acc1Lo != acc1Lo[1]))
bool nAc2 = (not na(acc2Id) and (na(acc2Id[1]) or acc2Id != acc2Id[1]))
          or (not na(acc2Hi) and (na(acc2Hi[1]) or acc2Hi != acc2Hi[1]))
          or (not na(acc2Lo) and (na(acc2Lo[1]) or acc2Lo != acc2Lo[1]))
bool nAc3 = (not na(acc3Id) and (na(acc3Id[1]) or acc3Id != acc3Id[1]))
          or (not na(acc3Hi) and (na(acc3Hi[1]) or acc3Hi != acc3Hi[1]))
          or (not na(acc3Lo) and (na(acc3Lo[1]) or acc3Lo != acc3Lo[1]))

// Accum専用の登録/更新。同一Accumインスタンス (検出ID一致) であれば新規追加せず、
// UIDを維持したまま center / top / bottom を最新の Accum Upper / Lower へ追従させる。
// 新しいAccumが発生したとき (検出IDが変化したとき) だけ新UIDのRaw Zoneを発行する。
// 同一性の判定に価格距離は一切使わないため、過去Accumと現在Accumが混ざらない。
f_registerAccumZone(bool trig, float price, int instId, string id, string tf, string lbl, float bs, float lifeDays) =>
    if trig and not na(price) and not na(instId)
        int life = f_days2ms(lifeDays)
        bool found = false
        if array.size(gPersist) > 0
            for i = 0 to array.size(gPersist) - 1
                RawZone z = array.get(gPersist, i)
                if z.srcCat == CAT_ACC and z.srcId == id and z.srcTf == tf and z.instId == instId
                    found    := true
                    z.center := price
                    z.top    := price + zoneHalfWidth
                    z.bottom := price - zoneHalfWidth
                    if life > 0
                        z.expireTime := time + life
                    break
        if not found
            RawZone nz = f_makeRaw(f_nextUid(), id, CAT_ACC, tf, lbl, price, bs, false)
            nz.instId     := instId
            nz.lifeMs     := life
            nz.expireTime := life > 0 ? time + life : 0
            array.push(gPersist, nz)

// ---- 8.1 Swing High / Low 登録 --------------------------------------------
f_registerStatic(useHzSource and nPh1, ph1, "SWING_H", CAT_HZ, hzTf1, hzTf1 + " Swing High", scoreHz1, lifeHz1)
f_registerStatic(useHzSource and nPl1, pl1, "SWING_L", CAT_HZ, hzTf1, hzTf1 + " Swing Low",  scoreHz1, lifeHz1)
f_registerStatic(useHzSource and nPh2, ph2, "SWING_H", CAT_HZ, hzTf2, hzTf2 + " Swing High", scoreHz2, lifeHz2)
f_registerStatic(useHzSource and nPl2, pl2, "SWING_L", CAT_HZ, hzTf2, hzTf2 + " Swing Low",  scoreHz2, lifeHz2)
f_registerStatic(useHzSource and nPh3, ph3, "SWING_H", CAT_HZ, hzTf3, hzTf3 + " Swing High", scoreHz3, lifeHz3)
f_registerStatic(useHzSource and nPl3, pl3, "SWING_L", CAT_HZ, hzTf3, hzTf3 + " Swing Low",  scoreHz3, lifeHz3)

// ---- 8.2 Accumulation Box 上限 / 下限 登録 (Box全体はZone化しない §9) ------
f_registerAccumZone(useAccSource and nAc1, acc1Hi, acc1Id, "ACC_HI", accTf1, accTf1 + " Accum High", scoreAcc1, lifeAcc)
f_registerAccumZone(useAccSource and nAc1, acc1Lo, acc1Id, "ACC_LO", accTf1, accTf1 + " Accum Low",  scoreAcc1, lifeAcc)
f_registerAccumZone(useAccSource and nAc2, acc2Hi, acc2Id, "ACC_HI", accTf2, accTf2 + " Accum High", scoreAcc2, lifeAcc)
f_registerAccumZone(useAccSource and nAc2, acc2Lo, acc2Id, "ACC_LO", accTf2, accTf2 + " Accum Low",  scoreAcc2, lifeAcc)
f_registerAccumZone(useAccSource and nAc3, acc3Hi, acc3Id, "ACC_HI", accTf3, accTf3 + " Accum High", scoreAcc3, lifeAcc)
f_registerAccumZone(useAccSource and nAc3, acc3Lo, acc3Id, "ACC_LO", accTf3, accTf3 + " Accum Low",  scoreAcc3, lifeAcc)

// ---- 8.3 旧Day High / Low の Horizontal 化 (§8 後半) -----------------------
f_registerStatic(useDayHL and carryPrevDayHL and isNewDay, prevDayHigh, "PDH", CAT_HZ, "PD", "Prev Day High", scorePrevDayHL, lifePrevDayHL)
f_registerStatic(useDayHL and carryPrevDayHL and isNewDay, prevDayLow,  "PDL", CAT_HZ, "PD", "Prev Day Low",  scorePrevDayHL, lifePrevDayHL)

// ---- 8.4 Horizontal Reaction 計測 (§7) ------------------------------------
// 「タッチだけ」ではReactionにしない。Zoneへ接触 → 進入してきた側へ
// reactionDist 以上離れた場合のみ +1。反対側へ抜けた場合はノーカウント。
f_updateReactions() =>
    if array.size(gPersist) > 0
        for i = 0 to array.size(gPersist) - 1
            RawZone z = array.get(gPersist, i)
            bool target = z.srcCat == CAT_HZ or (reactionAllSrc and (z.srcCat == CAT_ACC or z.srcCat == CAT_DHL))
            if target
                bool touching = low <= z.top and high >= z.bottom
                if touching and z.entrySide == 0
                    z.entrySide := close[1] > z.top ? 1 : close[1] < z.bottom ? -1 : 0
                if z.entrySide == 1
                    if high >= z.top + reactionDist
                        z.reactionCnt := z.reactionCnt + 1
                        z.entrySide   := 0
                        if lifeExtendOn and z.expireTime > 0
                            z.expireTime := z.expireTime + int(z.lifeMs * lifeExtendRatio)
                    else if close <= z.bottom - reactionDist
                        z.entrySide := 0
                else if z.entrySide == -1
                    if low <= z.bottom - reactionDist
                        z.reactionCnt := z.reactionCnt + 1
                        z.entrySide   := 0
                        if lifeExtendOn and z.expireTime > 0
                            z.expireTime := z.expireTime + int(z.lifeMs * lifeExtendRatio)
                    else if close >= z.top + reactionDist
                        z.entrySide := 0
                z.reactionBonus := f_reactionBonus(z.reactionCnt)
f_updateReactions()

// ---- 8.5 寿命切れ / 上限超過の破棄 (§21) ----------------------------------
f_prunePersist() =>
    if array.size(gPersist) > 0
        for i = array.size(gPersist) - 1 to 0
            if i < array.size(gPersist)
                RawZone z = array.get(gPersist, i)
                if z.expireTime > 0 and time > z.expireTime
                    array.remove(gPersist, i)
    while array.size(gPersist) > maxPersistZones
        array.shift(gPersist)
f_prunePersist()

// ---- 8.6 このバーで評価するRaw Zone一式を組み立てる ------------------------
array<RawZone> gRaw = array.new<RawZone>()

if array.size(gPersist) > 0
    for i = 0 to array.size(gPersist) - 1
        array.push(gRaw, array.get(gPersist, i))

// 動的Source: MA (§22 Live Zone Mapでは常時再計算)
if useMaSource and not na(ma1Val)
    RawZone rMa1 = f_makeRaw(UID_MA1, "MA1", CAT_MA, maTf, str.tostring(ma1Len) + "MA" + f_arrow(ma1Dir), ma1Val, scoreMa1, true)
    rMa1.slopeState     := ma1State
    rMa1.slopeDir       := ma1Dir
    rMa1.slopeBonus     := ma1SlopeBonus
    rMa1.maClusterBonus := maClusterBonus
    array.push(gRaw, rMa1)

if useMaSource and not na(ma2Val)
    RawZone rMa2 = f_makeRaw(UID_MA2, "MA2", CAT_MA, maTf, str.tostring(ma2Len) + "MA" + f_arrow(ma2Dir), ma2Val, scoreMa2, true)
    rMa2.slopeState     := ma2State
    rMa2.slopeDir       := ma2Dir
    rMa2.slopeBonus     := ma2SlopeBonus
    rMa2.maClusterBonus := maClusterBonus
    array.push(gRaw, rMa2)

// 動的Source: 当日High / Low
if useDayHL and not na(dayHigh)
    array.push(gRaw, f_makeRaw(gDayHighUid, "DAY_HIGH", CAT_DHL, "D", "Day High", dayHigh, scoreDayHL, true))
if useDayHL and not na(dayLow)
    array.push(gRaw, f_makeRaw(gDayLowUid, "DAY_LOW", CAT_DHL, "D", "Day Low", dayLow, scoreDayHL, true))

// ============================================================================
// 9. CLUSTER ENGINE  (§11 / §12 / §13)
// ============================================================================
// - Raw Zone中心が clusterDist 以内なら同一Cluster候補
// - Cluster中心は Base Score 加重平均
// - 追加のたびに「全構成Sourceが最終Centerから clusterDist 以内か」を再検証し、
//   外れるならClusterを切る (連鎖統合の防止 §13)

f_weightOf(RawZone z) =>
    math.max(z.baseScore, 0.01)

// Cluster確定 → Zone生成 + Score算出 (Flip Bonusは Zone State Engine で加算)
//
// ★ Weight の分離 ★
//   ・Cluster Center 用 Weight = Raw Zone ごとの Base Score  … 従来どおり変更なし
//   ・Strength Score 用 Base   = 種類ごとに圧縮した合計      … ここだけ集計方法を変更
//
//   圧縮ルール
//     Horizontal Swing : 同一TFの本数を Tier 化 (1本 / 2-3本 / 4本以上)
//     Accum            : 同一TF・同一種別 (High/Low) は1回だけ加点
//     MA / DayHL       : 従来どおり個別に加算
//     その他Horizontal (Prev Day H/L 等) : 従来どおり個別に加算
f_finalizeCluster(array<RawZone> members) =>
    float tw      = 0.0
    float ts      = 0.0
    float baseSum = 0.0
    float slopeB  = 0.0
    float maB     = 0.0
    float reactB  = 0.0
    bool  hasMA   = false
    bool  hasHZ   = false
    bool  hasDHL  = false
    bool  hasACC  = false

    // Horizontal Swing 本数カウンタ (同一TFはまとめて圧縮評価)
    int cntSw1 = 0
    int cntSw2 = 0
    int cntSw3 = 0
    // Accum 重複除外フラグ (同一TF・同一種別は1回だけ加点)
    bool accHi1 = false
    bool accLo1 = false
    bool accHi2 = false
    bool accLo2 = false
    bool accHi3 = false
    bool accLo3 = false
    // Higher Timeframe Structure 検出フラグ (Very Strong成立条件用)
    bool htfSw1h = false
    bool htfAc1  = false
    bool htfAc2  = false
    bool htfAc3  = false
    bool htfSw15 = false
    bool htfM1   = false
    bool htfM2   = false
    bool htfDay  = false

    string srcStr = ""
    string sigStr = ""
    array<int>    uids   = array.new_int()
    array<string> grpKey = array.new_string()   // 表示用: 種類ごとの件数集計
    array<int>    grpCnt = array.new_int()

    int n = array.size(members)
    for j = 0 to n - 1
        RawZone m = array.get(members, j)

        // ---- Cluster Center 用 Weight (従来どおり Raw Zone の Base Score) ----
        float w = f_weightOf(m)
        tw += w
        ts += m.center * w

        // ---- Strength Score 用 Base Score (種類ごとに圧縮) -------------------
        bool isSwing = m.srcCat == CAT_HZ and (m.srcId == "SWING_H" or m.srcId == "SWING_L")
        bool isAccHi = m.srcId == "ACC_HI"
        if isSwing
            // Swing High / Low は同一TF内では同じ「Horizontal Swing系」として数える
            if m.srcTf == hzTf1
                cntSw1 += 1
            else if m.srcTf == hzTf2
                cntSw2 += 1
            else if m.srcTf == hzTf3
                cntSw3 += 1
            else
                baseSum += m.baseScore
        else if m.srcCat == CAT_ACC
            // 同一TF・同一種別は1回だけ。TFが違えば別々に加算、High/Lowも別種別。
            if m.srcTf == accTf1
                if isAccHi and not accHi1
                    accHi1  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo1
                    accLo1  := true
                    baseSum += m.baseScore
            else if m.srcTf == accTf2
                if isAccHi and not accHi2
                    accHi2  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo2
                    accLo2  := true
                    baseSum += m.baseScore
            else if m.srcTf == accTf3
                if isAccHi and not accHi3
                    accHi3  := true
                    baseSum += m.baseScore
                else if not isAccHi and not accLo3
                    accLo3  := true
                    baseSum += m.baseScore
            else
                baseSum += m.baseScore
        else
            // MA #1 / MA #2 / Day High / Day Low / Prev Day H-L は個別加算
            baseSum += m.baseScore

        // ---- Bonus 集計 (従来どおり) ----------------------------------------
        slopeB  := slopeBonusMode == "Max" ? math.max(slopeB, m.slopeBonus) : slopeB + m.slopeBonus
        maB     := math.max(maB, m.maClusterBonus)      // MA Cluster Bonusは二重計上しない
        reactB  := math.max(reactB, m.reactionBonus)    // Reaction Bonusはcap付き最大値

        // ---- Higher Timeframe Structure 判定 (input で対象を変更可) ----------
        if isSwing and m.srcTf == hzTf3 and htfSwing1H
            htfSw1h := true
        if isSwing and m.srcTf == hzTf2 and htfSwing15M
            htfSw15 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf1 and htfAccum1H
            htfAc1 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf2 and htfAccum4H
            htfAc2 := true
        if m.srcCat == CAT_ACC and m.srcTf == accTf3 and htfAccumD
            htfAc3 := true
        if m.srcId == "MA1" and htfMa1
            htfM1 := true
        if m.srcId == "MA2" and htfMa2
            htfM2 := true
        if m.srcCat == CAT_DHL and htfDayHL
            htfDay := true

        // ---- Source情報は圧縮せずすべて保持 ---------------------------------
        sigStr  := sigStr + (j > 0 ? "+" : "") + m.srcId + "@" + m.srcTf + "#" + str.tostring(m.uid)
        array.push(uids, m.uid)
        hasMA   := hasMA  or m.srcCat == CAT_MA
        hasHZ   := hasHZ  or m.srcCat == CAT_HZ
        hasDHL  := hasDHL or m.srcCat == CAT_DHL
        hasACC  := hasACC or m.srcCat == CAT_ACC

        // ---- 表示用: 種類ごとの件数を集計 (Scoreには影響しない) --------------
        string gk = m.srcLabel
        if isSwing
            gk := m.srcTf + " Swing"
        else if m.srcCat == CAT_ACC
            gk := m.srcTf + " Accum " + (isAccHi ? "High" : "Low")
        int gi = array.indexof(grpKey, gk)
        if gi >= 0
            array.set(grpCnt, gi, array.get(grpCnt, gi) + 1)
        else
            array.push(grpKey, gk)
            array.push(grpCnt, 1)

    // ---- Swing本数を Tier 化して Base Score へ加算 ---------------------------
    baseSum += f_swingTierScore(cntSw1, scoreHz1, scoreHz1T2, scoreHz1T3)
    baseSum += f_swingTierScore(cntSw2, scoreHz2, scoreHz2T2, scoreHz2T3)
    baseSum += f_swingTierScore(cntSw3, scoreHz3, scoreHz3T2, scoreHz3T3)

    // ---- Higher TF Structure の内訳文字列 (なぜVery Strongなのかの確認用) ----
    string htfStr = ""
    if htfSw1h
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(hzTf3) + " Swing"
    if htfAc1
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf1) + " Accum"
    if htfAc2
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf2) + " Accum"
    if htfAc3
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(accTf3) + " Accum"
    if htfSw15
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + f_tfName(hzTf2) + " Swing"
    if htfM1
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + str.tostring(ma1Len) + "MA"
    if htfM2
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + str.tostring(ma2Len) + "MA"
    if htfDay
        htfStr := htfStr + (htfStr == "" ? "" : " / ") + "Day H/L"
    bool hasHtfStruct = htfStr != ""

    // ---- 表示用サマリ文字列  例: "5 Swing x7 / 60 Accum High x2 / 2000MA↑" ---
    if array.size(grpKey) > 0
        for k = 0 to array.size(grpKey) - 1
            int c = array.get(grpCnt, k)
            srcStr := srcStr + (k > 0 ? " / " : "") + array.get(grpKey, k) + (c > 1 ? " x" + str.tostring(c) : "")

    float ctr = tw > 0 ? ts / tw : na
    int   cat = (hasMA ? 1 : 0) + (hasHZ ? 1 : 0) + (hasDHL ? 1 : 0) + (hasACC ? 1 : 0)
    reactB := math.min(reactB, reactionCap)
    float confB = f_confluenceBonus(cat)
    Zone.new(
         center = ctr, top = ctr + zoneHalfWidth, bottom = ctr - zoneHalfWidth,
         score = baseSum + slopeB + maB + reactB + confB,
         baseSum = baseSum, slopeBonus = slopeB, maBonus = maB,
         reactionBonus = reactB, flipBonus = 0.0, confBonus = confB,
         strength = SR_WEAK, state = ST_ACTIVE, flipped = false, flipDir = 0,
         catCount = cat, memberCount = n, sources = srcStr, trackId = -1,
         memberUids = uids, sourceSig = sigStr,
         hasHtf = hasHtfStruct, htfSources = htfStr)

f_buildClusters(array<RawZone> src) =>
    array<Zone> out = array.new<Zone>()
    int n = array.size(src)
    if n > 0
        array<float> centers = array.new_float()
        for i = 0 to n - 1
            array.push(centers, array.get(src, i).center)
        array<int> ord = array.sort_indices(centers, order.ascending)

        array<RawZone> cur = array.new<RawZone>()
        for k = 0 to n - 1
            RawZone z = array.get(src, array.get(ord, k))
            if array.size(cur) == 0
                array.push(cur, z)
            else
                // 加重平均の暫定中心を計算
                float tw = 0.0
                float ts = 0.0
                for j = 0 to array.size(cur) - 1
                    RawZone m = array.get(cur, j)
                    float w = f_weightOf(m)
                    tw += w
                    ts += m.center * w
                float wz = f_weightOf(z)
                float newCenter = (ts + z.center * wz) / (tw + wz)

                // §13: 追加後の中心から全メンバーが clusterDist 以内であること
                bool ok = math.abs(z.center - newCenter) <= clusterDist
                if ok
                    for j = 0 to array.size(cur) - 1
                        if math.abs(array.get(cur, j).center - newCenter) > clusterDist
                            ok := false
                            break
                if ok
                    array.push(cur, z)
                else
                    array.push(out, f_finalizeCluster(cur))
                    cur := array.new<RawZone>()
                    array.push(cur, z)
        if array.size(cur) > 0
            array.push(out, f_finalizeCluster(cur))
    out

array<Zone> gZones = f_buildClusters(gRaw)

// ============================================================================
// 10. STRENGTH SCORE ENGINE  (§14 / §15 / §16)
// ============================================================================
// 圧縮後Base Score + MA Slope Bonus + MA Cluster Bonus + Reaction Bonus
//   + Flip Bonus + Confluence Bonus   ← Flip Bonusのみ §12 の後で加算する。
// ここでは Flip 以外を確定させ、Strength Tier を暫定計算しておく。
//
// 圧縮後Base Score は f_finalizeCluster() で算出済み:
//   ・同一TFのHorizontal Swingは本数をTier化 (単純加算しない)
//   ・同一TF・同一種別のAccumは1回だけ加点
//   ・MA #1 / #2 / Day High / Day Low は個別加算 (従来どおり)
// Confluence Bonus は Category数のみで決まり、同一Category内の本数では増えない。

f_applyStrength(Zone z) =>
    z.score    := z.baseSum + z.slopeBonus + z.maBonus + z.reactionBonus + z.flipBonus + z.confBonus
    z.strength := f_strengthOf(z.score, z.hasHtf)

if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        f_applyStrength(array.get(gZones, i))

// ============================================================================
// 11. ZONE STATE ENGINE  (§17 / §22)
// ============================================================================
// Cluster Zoneは毎バー作り直されるため、State / Break / Flip は
// ZoneTrack (永続オブジェクト) 側で保持し、価格帯の近さで毎バー紐付ける。
// これにより MA Zone が動いても、また Cluster が分離・再結合しても
// Break / Flip の履歴が失われない。

var array<ZoneTrack> gTracks   = array.new<ZoneTrack>()
var int              gTrackSeq = 0

// --- Source構成の連続性判定 (§6 ZoneTrack誤継承防止) -----------------------
// 「価格が近い」だけでは過去のBroken / Flip状態を継承させない。
// 構成Sourceのuid集合がどれだけ重なっているかを見る。
//   ・MA Clusterが少しずつ移動しているだけ → uidは MA1/MA2 のまま → 重なり100% → 継承
//   ・Horizontalが寿命切れした跡へMAが到達 → uid集合が全く別 → 重なり0% → 新Track
//   ・構成が1つ増減した程度 → 重なり率が trackContinuity 以上なら継承
f_uidOverlap(array<int> a, array<int> b) =>
    int c = 0
    if not na(a) and not na(b) and array.size(a) > 0 and array.size(b) > 0
        for i = 0 to array.size(a) - 1
            if array.includes(b, array.get(a, i))
                c += 1
    c

f_trackContinuous(ZoneTrack t, Zone z) =>
    int ov = f_uidOverlap(z.memberUids, t.memberUids)
    int sz = na(z.memberUids) ? 0 : array.size(z.memberUids)
    int st = na(t.memberUids) ? 0 : array.size(t.memberUids)
    int mx = math.max(sz, st)
    ov >= 1 and mx > 0 and (float(ov) / float(mx)) >= trackContinuity

// マッチ条件は「1. Center距離が clusterDist 以内」かつ「2. Source構成に連続性がある」
// の両方。片方だけでは継承しない。
f_findTrack(Zone z) =>
    int best = -1
    float bestD = 1e20
    if array.size(gTracks) > 0
        for i = 0 to array.size(gTracks) - 1
            ZoneTrack t = array.get(gTracks, i)
            if not t.matched
                float d = math.abs(t.center - z.center)
                if d <= clusterDist and d < bestD and f_trackContinuous(t, z)
                    bestD := d
                    best  := i
    best

f_naturalState(float top, float bottom) =>
    close > top ? ST_SUPPORT : close < bottom ? ST_RESIST : ST_ACTIVE

// ============================================================================
// 12. BREAK / FLIP ENGINE  (§18 / §19 / §20)
// ============================================================================
// Break判定は breakTf の確定終値のみ (ヒゲ不可)。
//   Resistance : 5M Close > Top    + breakBuffer  → Up Break   → Broken
//   Support    : 5M Close < Bottom - breakBuffer  → Down Break → Broken
// Break直後は反転させない (§19)。Flipは次の4段階すべてを満たして初めて成立。
//   1) 確定終値でBreak  2) 旧ZoneへRetest  3) 再度明確に抜け返さない
//   4) Zoneから flipConfirmDist 以上離れる
// 戻り値: 0 なし / +1 UpBreak / -1 DownBreak / +2 Support Flip / -2 Resistance Flip
f_updateTrack(ZoneTrack t, bool evalBar, float bc, float bh, float bl) =>
    int ev = 0

    // ---- 1) Break判定前の既存Stateを保持 -----------------------------------
    int  prevState = t.state
    bool handled   = false      // このバーでBreak / Broken進行を処理したか

    // Break判定に使うState。現在価格がZone内部 (ST_ACTIVE) にある間は、
    // 直近の確定Role (Support / Resistance) へフォールバックする。
    // これにより「現在バーのcloseがZoneのどこにあるか」に関係なく、
    // 確定 breakTf 終値によるBreakを取りこぼさない。
    int evalState = prevState == ST_ACTIVE ? (t.lastRole > 0 ? ST_SUPPORT : t.lastRole < 0 ? ST_RESIST : ST_ACTIVE) : prevState

    // ---- 2) 確定 breakTf 終値による Break / Flip 判定 -----------------------
    //        natural state の更新より必ず先に評価する。
    if evalBar
        if evalState == ST_RESIST and bc > t.top + breakBuffer
            // Resistance + 確定終値 > Top + Buffer → 現在価格の位置に関係なくUp Break
            t.state    := ST_BROKEN
            t.breakDir := 1
            t.breakBar := bar_index
            t.retested := false
            t.flipped  := false      // 再Breakで過去のFlipは無効化 (Flip Bonusも消える)
            t.flipDir  := 0
            handled    := true
            ev := 1
        else if evalState == ST_SUPPORT and bc < t.bottom - breakBuffer
            // Support + 確定終値 < Bottom - Buffer → 現在価格の位置に関係なくDown Break
            t.state    := ST_BROKEN
            t.breakDir := -1
            t.breakBar := bar_index
            t.retested := false
            t.flipped  := false      // 再Breakで過去のFlipは無効化 (Flip Bonusも消える)
            t.flipDir  := 0
            handled    := true
            ev := -1
        else if prevState == ST_BROKEN and t.breakDir == 1
            // Resistance → Support Flip の進行管理 (Break直後に反転させない §19)
            handled := true
            if bc < t.bottom - breakBuffer
                // Breakが否定された
                t.breakDir := 0
                t.retested := false
                if resetOnReclaim
                    t.state := f_naturalState(t.top, t.bottom)
            else if not t.retested
                if bl <= t.top and bh >= t.bottom
                    t.retested := true
            else if bc >= t.top + flipConfirmDist
                t.flipped  := true
                t.flipDir  := 1
                t.state    := ST_SUPPORT
                t.breakDir := 0
                t.retested := false
                ev := 2
        else if prevState == ST_BROKEN and t.breakDir == -1
            // Support → Resistance Flip の進行管理
            handled := true
            if bc > t.top + breakBuffer
                t.breakDir := 0
                t.retested := false
                if resetOnReclaim
                    t.state := f_naturalState(t.top, t.bottom)
            else if not t.retested
                if bh >= t.bottom and bl <= t.top
                    t.retested := true
            else if bc <= t.bottom - flipConfirmDist
                t.flipped  := true
                t.flipDir  := -1
                t.state    := ST_RESIST
                t.breakDir := 0
                t.retested := false
                ev := -2

    // ---- 3) Breakが成立しなかった場合のみ natural state を更新 --------------
    //        Broken中はここでは触らない (必ず Retest → Flip の順序を守る)。
    if not handled and t.state != ST_BROKEN
        t.state := f_naturalState(t.top, t.bottom)

    // ---- 4) 直近の確定Roleを記録 (Zone内部 / Broken中は更新しない) ----------
    if t.state == ST_SUPPORT
        t.lastRole := 1
    else if t.state == ST_RESIST
        t.lastRole := -1
    ev

// ---- 12.1 Track と Cluster Zone の紐付け + 状態更新 ------------------------
bool evUpBreak   = false
bool evDownBreak = false
bool evFlipSup   = false
bool evFlipRes   = false

if array.size(gTracks) > 0
    for i = 0 to array.size(gTracks) - 1
        ZoneTrack tt = array.get(gTracks, i)
        tt.matched := false

if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        Zone z = array.get(gZones, i)
        int ti = f_findTrack(z)
        ZoneTrack t = na
        if ti >= 0
            t := array.get(gTracks, ti)
        else
            gTrackSeq += 1
            t := ZoneTrack.new(id = gTrackSeq, center = z.center, top = z.top, bottom = z.bottom,
                 state = f_naturalState(z.top, z.bottom), lastSeenBar = bar_index,
                 memberUids = array.copy(z.memberUids), sourceSig = z.sourceSig)
            array.push(gTracks, t)
        t.matched     := true
        t.center      := z.center
        t.top         := z.top
        t.bottom      := z.bottom
        t.lastSeenBar := bar_index
        // Source構成のスナップショットを更新 (緩やかな構成変化には追従させる)
        t.memberUids  := array.copy(z.memberUids)
        t.sourceSig   := z.sourceSig

        int ev = f_updateTrack(t, brEval, brClose, brHigh, brLow)
        evUpBreak   := evUpBreak   or ev == 1
        evDownBreak := evDownBreak or ev == -1
        evFlipSup   := evFlipSup   or ev == 2
        evFlipRes   := evFlipRes   or ev == -2

        // Flip Bonus を Score に反映 (§20) してから Strength を確定
        z.state     := t.state
        z.flipped   := t.flipped
        z.flipDir   := t.flipDir
        z.flipBonus := t.flipped ? flipBonusV : 0.0
        z.trackId   := t.id
        f_applyStrength(z)

// ---- 12.2 長期間マッチしないTrackを破棄 ------------------------------------
if array.size(gTracks) > 0
    for i = array.size(gTracks) - 1 to 0
        if i < array.size(gTracks)
            ZoneTrack t = array.get(gTracks, i)
            if bar_index - t.lastSeenBar > trackStaleBars
                array.remove(gTracks, i)

// ============================================================================
// 13. LIVE ZONE MAP  (§23)
// ============================================================================
// 将来のEntry Moduleが参照する唯一の中心データ。
// Entry側でZoneを再計算してはならず、必ずこのMapを読むこと。

var array<Zone> gLiveMap = array.new<Zone>()
array.clear(gLiveMap)
if array.size(gZones) > 0
    for i = 0 to array.size(gZones) - 1
        array.push(gLiveMap, array.get(gZones, i))

// Live Zone Map への公開アクセサ (Entry Module 用)
f_zoneCount() => array.size(gLiveMap)
f_zoneAt(int i) => array.get(gLiveMap, i)

// ============================================================================
// 14. STRUCTURAL SL / TP UTILITY FUNCTIONS   ★ Entry Module 接続点 ★
//     (§24 / §25 / §26 / §27 / §28 / §29)
// ============================================================================
// 将来 Entry Module 側は
//     bool longSignal / bool shortSignal / float entryPrice
// を作り、下記の関数へ entryPrice を渡すだけでよい。
// Zone検出ロジックには一切触れない (疎結合)。

int SL_MIN_STR  = f_strengthIdx(slMinStrStr)
int TP_MIN_STR  = f_strengthIdx(tpMinStrStr)
int OBS_MIN_STR = f_strengthIdx(obsMinStrStr)

// ---- 14.1 Structural SL (§25) ---------------------------------------------
// Long : zoneTop < entryPrice / state == ST_SUPPORT / Strength>=指定 / Score>=指定
//        の最も近いZone → SL = Zone Bottom - slBuffer
// ★ ST_ACTIVE と ST_BROKEN は常にStructural SL候補から除外する。
//   (Brokenを使えるようにするinputは意図的に設けていない)
// 戻り値: [slPrice, zoneIndex]  (該当なしは [na, -1])
f_getLongStructuralSL(float entryPrice) =>
    float sl = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_SUPPORT
            if z.top < entryPrice and z.strength >= SL_MIN_STR and z.score >= slMinScore and okState
                float d = entryPrice - z.top
                if d < bestD
                    bestD := d
                    sl    := z.bottom - slBuffer
                    idx   := i
    [sl, idx]

// Short : zoneBottom > entryPrice / state == ST_RESIST / Strength>=指定 / Score>=指定
//         → SL = Zone Top + slBuffer   (ST_ACTIVE / ST_BROKEN は常に除外)
f_getShortStructuralSL(float entryPrice) =>
    float sl = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_RESIST
            if z.bottom > entryPrice and z.strength >= SL_MIN_STR and z.score >= slMinScore and okState
                float d = z.bottom - entryPrice
                if d < bestD
                    bestD := d
                    sl    := z.top + slBuffer
                    idx   := i
    [sl, idx]

// ---- 14.2 Structural TP (§26) ---------------------------------------------
// Long : zoneBottom > entryPrice / state == ST_RESIST / Strong以上 / Score>=TP閾値
//        の最初のもの → TP = Resistance Bottom - tpBuffer
// ★ ST_ACTIVE と ST_BROKEN は常にMain TP候補から除外する。
f_getLongStructuralTP(float entryPrice) =>
    float tp = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_RESIST
            if z.bottom > entryPrice and z.strength >= TP_MIN_STR and z.score >= tpMinScore and okState
                float d = z.bottom - entryPrice
                if d < bestD
                    bestD := d
                    tp    := z.bottom - tpBuffer
                    idx   := i
    [tp, idx]

// Short : zoneTop < entryPrice / state == ST_SUPPORT / Strong以上 / Score>=TP閾値
//         → TP = Support Top + tpBuffer   (ST_ACTIVE / ST_BROKEN は常に除外)
f_getShortStructuralTP(float entryPrice) =>
    float tp = na
    int   idx = -1
    float bestD = 1e20
    if array.size(gLiveMap) > 0
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = z.state == ST_SUPPORT
            if z.top < entryPrice and z.strength >= TP_MIN_STR and z.score >= tpMinScore and okState
                float d = entryPrice - z.top
                if d < bestD
                    bestD := d
                    tp    := z.top + tpBuffer
                    idx   := i
    [tp, idx]

// ---- 14.3 Structural RR (§28) ---------------------------------------------
// 戻り値: [riskDistance, rewardDistance, structuralRR]
f_getStructuralRR(float entryPrice, float sl, float tp) =>
    float risk   = na(sl) or na(entryPrice) ? na : math.abs(entryPrice - sl)
    float reward = na(tp) or na(entryPrice) ? na : math.abs(tp - entryPrice)
    float rr     = na(risk) or na(reward) or risk <= 0 ? na : reward / risk
    [risk, reward, rr]

// ---- 14.4 Obstacle Count (§27) --------------------------------------------
// Entry ～ Main TP の間にあり、進行方向に対して実際に抵抗となるStateのZoneだけ数える。
//   Long  : state == ST_RESIST  かつ Medium以上
//   Short : state == ST_SUPPORT かつ Medium以上
// ★ ST_ACTIVE / ST_BROKEN は Obstacle に含めない。
// Main TP Zone自身は、境界を「TP Zoneの内側の縁 (tpPrice ± tpBuffer)」に取ることで
// これまで通り自動的に除外される。
f_getObstacleCount(float entryPrice, float tpPrice, int direction) =>
    int cnt = 0
    if not na(entryPrice) and not na(tpPrice) and array.size(gLiveMap) > 0
        float boundary = direction > 0 ? tpPrice + tpBuffer : tpPrice - tpBuffer
        for i = 0 to array.size(gLiveMap) - 1
            Zone z = array.get(gLiveMap, i)
            bool okState = direction > 0 ? z.state == ST_RESIST : z.state == ST_SUPPORT
            if z.strength >= OBS_MIN_STR and okState
                bool inWay = direction > 0 ? (z.bottom > entryPrice and z.top < boundary)
                                           : (z.top < entryPrice and z.bottom > boundary)
                if inWay
                    cnt += 1
    cnt

// ---- 14.5 PASS / FAIL (§29) -----------------------------------------------
// FAIL条件: NO_SL_ZONE / NO_TP_ZONE / SL_TOO_FAR / LOW_STRUCTURAL_RR
// Ver.1 では Entry Signal が無いため実際の表示は行わない。関数だけ用意する。
f_buildTradePlan(int direction, float entryPrice) =>
    // タプル分解はネストしたifブロック内では行わず、関数本体の先頭で確定させる。
    [lSl, lSi] = f_getLongStructuralSL(entryPrice)
    [lTp, lTi] = f_getLongStructuralTP(entryPrice)
    [sSl, sSi] = f_getShortStructuralSL(entryPrice)
    [sTp, sTi] = f_getShortStructuralTP(entryPrice)

    float sl = direction > 0 ? lSl : direction < 0 ? sSl : na
    int   si = direction > 0 ? lSi : direction < 0 ? sSi : -1
    float tp = direction > 0 ? lTp : direction < 0 ? sTp : na
    int   ti = direction > 0 ? lTi : direction < 0 ? sTi : -1

    [risk, reward, rr] = f_getStructuralRR(entryPrice, sl, tp)

    TradePlan p = TradePlan.new(dir = direction, entry = entryPrice)
    p.sl        := sl
    p.tp        := tp
    p.risk      := risk
    p.reward    := reward
    p.rr        := rr
    p.obstacles := na(tp) ? 0 : f_getObstacleCount(entryPrice, tp, direction)
    if si >= 0
        Zone zs = array.get(gLiveMap, si)
        p.slZoneCenter := zs.center
        p.slZoneScore  := zs.score
    if ti >= 0
        Zone zt = array.get(gLiveMap, ti)
        p.tpZoneCenter := zt.center
        p.tpZoneScore  := zt.score

    if direction == 0
        p.status := "FAIL"
        p.reason := "NO_ENTRY"
    else if si < 0
        p.status := "FAIL"
        p.reason := "NO_SL_ZONE"
    else if ti < 0
        p.status := "FAIL"
        p.reason := "NO_TP_ZONE"
    else if risk > maxSlDist
        p.status := "FAIL"
        p.reason := "SL_TOO_FAR"
    else if na(rr) or rr < minStructRR
        p.status := "FAIL"
        p.reason := "LOW_STRUCTURAL_RR"
    else
        p.valid  := true
        p.status := "PASS"
        p.reason := "OK"
    p

// --- 将来の Entry Module はここに接続する -----------------------------------
//     bool  longSignal  = <your entry logic>
//     bool  shortSignal = <your entry logic>
//     float entryPrice  = close
//     if longSignal
//         TradePlan plan = f_buildTradePlan(1, entryPrice)
//         if plan.valid
//             // plan.sl / plan.tp / plan.rr / plan.obstacles を使う
// ---------------------------------------------------------------------------

// ============================================================================
// 15. DISPLAY  (§30 / §31)
// ============================================================================
// Zoneは line ではなく box で描画する。
//   色      : State (Support / Resistance / Active / Broken)
//   透明度  : Strength (Weak / Medium / Strong / Very Strong)
//   枠線幅  : Strength、Broken は破線

var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()

f_clearDrawings() =>
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    while array.size(gLabels) > 0
        label.delete(array.pop(gLabels))

f_zoneColor(int st) =>
    st == ST_SUPPORT ? colSupport : st == ST_RESIST ? colResistance : st == ST_ACTIVE ? colActive : colBroken

f_zoneTransp(int strength) =>
    strength == SR_VSTRONG ? trVStrong : strength == SR_STRONG ? trStrong : strength == SR_MEDIUM ? trMedium : trWeak

// 現在価格に近い順のZone index配列
f_drawOrder(int maxN) =>
    array<int> out = array.new_int()
    int n = array.size(gLiveMap)
    if n > 0
        array<float> d = array.new_float()
        for i = 0 to n - 1
            array.push(d, math.abs(array.get(gLiveMap, i).center - close))
        array<int> ord = array.sort_indices(d, order.ascending)
        int lim = int(math.min(n, maxN))
        for k = 0 to lim - 1
            array.push(out, array.get(ord, k))
    out

// Support / Resistance 側それぞれで、現在価格に近い順のZone index配列
f_nearestIdx(bool wantSupport, int maxN) =>
    array<int>   pick = array.new_int()
    array<float> dist = array.new_float()
    int n = array.size(gLiveMap)
    if n > 0
        for i = 0 to n - 1
            Zone z = array.get(gLiveMap, i)
            bool ok = wantSupport ? z.top < close : z.bottom > close
            if ok
                array.push(pick, i)
                array.push(dist, wantSupport ? close - z.top : z.bottom - close)
    array<int> out = array.new_int()
    if array.size(dist) > 0
        array<int> ord = array.sort_indices(dist, order.ascending)
        int lim = int(math.min(array.size(ord), maxN))
        for k = 0 to lim - 1
            array.push(out, array.get(pick, array.get(ord, k)))
    out

if barstate.islast
    f_clearDrawings()
    if showZones and array.size(gLiveMap) > 0
        array<int> ord = f_drawOrder(maxZonesDraw)
        if array.size(ord) > 0
            for k = 0 to array.size(ord) - 1
                Zone  z  = array.get(gLiveMap, array.get(ord, k))
                color bc = f_zoneColor(z.state)
                int   tr = f_zoneTransp(z.strength)
                box b = box.new(
                     left         = bar_index - zoneLeftBars,
                     top          = z.top,
                     right        = bar_index + zoneRightBars,
                     bottom       = z.bottom,
                     bgcolor      = color.new(bc, tr),
                     border_color = color.new(bc, math.max(tr - 30, 0)),
                     border_width = z.strength >= SR_STRONG ? 2 : 1,
                     border_style = z.state == ST_BROKEN ? line.style_dashed : line.style_solid,
                     xloc         = xloc.bar_index)
                array.push(gBoxes, b)

                if showLabels
                    string txt = f_stateName(z.state) + " | " + f_num(z.score, "#.#") + " | " + f_strengthName(z.strength)
                    txt := txt + " | HTF: " + (z.hasHtf ? z.htfSources : "NO")
                    if z.flipped
                        txt := txt + " | FLIP"
                    if showDetailLbl
                        txt := txt + "\n" + z.sources
                    label lb = label.new(
                         x         = bar_index + zoneRightBars,
                         y         = z.top,
                         text      = txt,
                         xloc      = xloc.bar_index,
                         style     = label.style_label_left,
                         color     = color.new(bc, 20),
                         textcolor = color.white,
                         size      = size.small)
                    array.push(gLabels, lb)

// ---- 15.1 MA Source の可視化 (Ver.1 の精度検証用) --------------------------
plot(showMaLines and useMaSource ? ma1Val : na, "MA #1", color = color.new(color.aqua, 25), linewidth = 1)
plot(showMaLines and useMaSource ? ma2Val : na, "MA #2", color = color.new(color.fuchsia, 25), linewidth = 1)

// ---- 15.2 Alerts ----------------------------------------------------------
alertcondition(evUpBreak,   "Zone Up Break",      "SR Zone Engine: Resistance Zone を上方Break")
alertcondition(evDownBreak, "Zone Down Break",    "SR Zone Engine: Support Zone を下方Break")
alertcondition(evFlipSup,   "Flip to Support",    "SR Zone Engine: Resistance → Support Flip 成立")
alertcondition(evFlipRes,   "Flip to Resistance", "SR Zone Engine: Support → Resistance Flip 成立")

// ============================================================================
// 16. DEBUG TABLE  (§32)
// ============================================================================

f_tablePos(string s) =>
    s == "Top Left"      ? position.top_left :
     s == "Bottom Right" ? position.bottom_right :
     s == "Bottom Left"  ? position.bottom_left :
     s == "Middle Right" ? position.middle_right : position.top_right

f_textSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

var table dbg = table.new(f_tablePos(dbgPosStr), 7, dbgNearestN * 2 + 8,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))

f_cell(int col, int row, string txt, color txtCol, color bgCol) =>
    table.cell(dbg, col, row, txt, text_color = txtCol, bgcolor = bgCol,
         text_size = f_textSize(dbgTextSize), text_halign = text.align_left)

f_zoneRow(int row, string tag, int zi, color tagCol) =>
    Zone z = array.get(gLiveMap, zi)
    float d = z.center - close
    f_cell(0, row, tag,                                   tagCol,      color.new(tagCol, 88))
    f_cell(1, row, f_num(z.center, "#.##"),               color.white, color.new(tagCol, 92))
    f_cell(2, row, f_num(z.score, "#.#"),                 color.white, color.new(tagCol, 92))
    f_cell(3, row, f_strengthName(z.strength) + " · HTF " + (z.hasHtf ? z.htfSources : "NO"), color.white, color.new(tagCol, 92))
    f_cell(4, row, f_stateFull(z.state) + (z.flipped ? " (Flip)" : ""), color.white, color.new(tagCol, 92))
    f_cell(5, row, f_num(math.abs(d), "#.#"),             color.white, color.new(tagCol, 92))
    f_cell(6, row, z.sources,                             color.white, color.new(tagCol, 92))

if barstate.islast and showDebugTable
    table.clear(dbg, 0, 0, 6, dbgNearestN * 2 + 7)
    color hdr = color.new(color.gray, 70)
    f_cell(0, 0, "Zone",     color.white, hdr)
    f_cell(1, 0, "Center",   color.white, hdr)
    f_cell(2, 0, "Score",    color.white, hdr)
    f_cell(3, 0, "Strength", color.white, hdr)
    f_cell(4, 0, "State",    color.white, hdr)
    f_cell(5, 0, "Distance", color.white, hdr)
    f_cell(6, 0, "Sources",  color.white, hdr)

    array<int> resIdx = f_nearestIdx(false, dbgNearestN)
    array<int> supIdx = f_nearestIdx(true,  dbgNearestN)

    // Resistance は遠い順に並べて上から表示 (チャートの上下と一致させる)
    int row = 1
    if array.size(resIdx) > 0
        for k = array.size(resIdx) - 1 to 0
            f_zoneRow(row, "RES " + str.tostring(k + 1), array.get(resIdx, k), colResistance)
            row += 1
    if array.size(resIdx) < dbgNearestN
        for k = array.size(resIdx) to dbgNearestN - 1
            f_cell(0, row, "RES -", color.gray, color.new(color.gray, 90))
            row += 1

    f_cell(0, row, "PRICE", color.black, color.new(color.yellow, 20))
    f_cell(1, row, f_num(close, "#.##"), color.black, color.new(color.yellow, 40))
    f_cell(2, row, "Zones: " + str.tostring(array.size(gLiveMap)), color.black, color.new(color.yellow, 60))
    f_cell(3, row, "Raw: " + str.tostring(array.size(gRaw)),       color.black, color.new(color.yellow, 60))
    f_cell(4, row, "MA1 " + f_arrow(ma1Dir) + " MA2 " + f_arrow(ma2Dir), color.black, color.new(color.yellow, 60))
    f_cell(5, row, "MAcl +" + f_num(maClusterBonus, "#.#"),        color.black, color.new(color.yellow, 60))
    f_cell(6, row, "Day H/L " + f_num(dayHigh, "#.#") + " / " + f_num(dayLow, "#.#"), color.black, color.new(color.yellow, 60))
    row += 1

    if array.size(supIdx) > 0
        for k = 0 to array.size(supIdx) - 1
            f_zoneRow(row, "SUP " + str.tostring(k + 1), array.get(supIdx, k), colSupport)
            row += 1
    if array.size(supIdx) < dbgNearestN
        for k = array.size(supIdx) to dbgNearestN - 1
            f_cell(0, row, "SUP -", color.gray, color.new(color.gray, 90))
            row += 1

    // ---- Structural Plan Preview (Entry未実装のため手動Entry Priceで検証用) --
    if showPlanPrev
        int   pdir  = prevEntryDir == "Long" ? 1 : -1
        float pent  = prevEntryPrice > 0 ? prevEntryPrice : close
        TradePlan pl = f_buildTradePlan(pdir, pent)
        color pc = pl.valid ? color.new(color.teal, 70) : color.new(color.maroon, 70)
        f_cell(0, row, "PLAN", color.white, pc)
        f_cell(1, row, (pdir > 0 ? "LONG @" : "SHORT @") + f_num(pent, "#.##"), color.white, pc)
        f_cell(2, row, "SL " + f_num(pl.sl, "#.##"),   color.white, pc)
        f_cell(3, row, "TP " + f_num(pl.tp, "#.##"),   color.white, pc)
        f_cell(4, row, "RR " + f_num(pl.rr, "#.##"),   color.white, pc)
        f_cell(5, row, "Obst " + str.tostring(pl.obstacles), color.white, pc)
        f_cell(6, row, pl.status + " · " + pl.reason,  color.white, pc)
        row += 1

    // ---- 環境警告 -----------------------------------------------------------
    string warn = ""
    if timeframe.in_seconds() > timeframe.in_seconds(maTf)
        warn := warn + "Chart TF > MA TF (下位足参照は精度低下). "
    if timeframe.in_seconds() > timeframe.in_seconds(breakTf)
        warn := warn + "Chart TF > Break TF. "
    if timeframe.in_seconds() > timeframe.in_seconds(hzTf1)
        warn := warn + "Chart TF > Horizontal TF#1. "
    if warn != ""
        f_cell(0, row, "WARN", color.white, color.new(color.orange, 40))
        f_cell(1, row, warn, color.white, color.new(color.orange, 60))
        table.merge_cells(dbg, 1, row, 6, row)

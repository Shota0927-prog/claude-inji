newFx() =>
    map<int, int> idToSlot = map.new<int, int>()
    map.put(idToSlot, 1, 0)
    map.put(idToSlot, 2, 1)
    map.put(idToSlot, 5, 2)
    Fx.new(
         rootPriceOrderSlots = array.from(0, 1, 2),
         categoryFvgRootSlots = array.new_int(0),
         rootIds = array.from(1, 2, 5),
         rootSlotLiveFlags = array.new_bool(3, true),
         rootCategories = array.new_int(3, CAT_SWING),
         rootStates = array.new_int(3, ROOT_ACTIVE),
         rootDirections = array.new_int(3, 0),
         rootPointTicks = array.from(100, 120, 128),
         rootNativeBottomTicks = array.new_int(3, int(na)),
         rootNativeTopTicks = array.new_int(3, int(na)),
         rootIsBroadFvgFlags = array.new_bool(3, false),
         rootSubtypes = array.new_int(3, 0),
         rootPairKeys = array.new_int(3, 0),
         rootOriginKeys = array.new_int(3, 0),
         rootIdToSlot = idToSlot,

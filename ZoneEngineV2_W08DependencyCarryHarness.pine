         candQueueRootSlots = array.new_int(0),
         candComponentIds = array.new_int(0),
         candComponentKinds = array.new_int(0),
         candComponentMemberOffsets = array.new_int(0),
         candComponentMemberLengths = array.new_int(0),
         candComponentCfgRevisions = array.new_int(0),
         candComponentStageKeys = array.new_int(0),
         candComponentUsedEpochKeys = array.new_int(0),
         candComponentSupportStatuses = array.new_int(0),
         candComponentResistanceStatuses = array.new_int(0),
         candComponentSupportRecordOffsets = array.new_int(0),
         candComponentSupportRecordLengths = array.new_int(0),
         candComponentResistanceRecordOffsets = array.new_int(0),
         candComponentResistanceRecordLengths = array.new_int(0),

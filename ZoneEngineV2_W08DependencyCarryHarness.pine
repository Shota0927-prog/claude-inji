plot(array.get(dg, 25), "C_SEM_ROOT_JOIN_IS_NA", display = display.data_window, precision = 0)
plot(array.get(dg, 26), "C_SEM_ROOT_JOIN_LENGTH", display = display.data_window, precision = 0)
plot(array.get(dg, 27), "C_SEM_ROOT_JOIN_EQ_EMPTY", display = display.data_window, precision = 0)
plot(array.get(dg, 28), "D_BASELINE_OK", display = display.data_window, precision = 0)
plot(array.get(dg, 29), "D_BASELINE_COMPONENT_COUNT", display = display.data_window, precision = 0)
plot(array.get(dg, 30), "D_BASELINE_KEY_MATCH", display = display.data_window, precision = 0)
plot(array.get(dg, 31), "D_INJECTED_COUNT", display = display.data_window, precision = 0)

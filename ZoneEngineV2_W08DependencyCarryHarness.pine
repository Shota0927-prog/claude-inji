         pendingTopologyChildExpectedCoreIds = array.new_int(0),
         pendingTopologyChildExpectedGenerationIds = array.new_int(0),
         pendingTopologyChildRootHeadNodeIndexes = array.new_int(0),
         pendingTopologyChildRootCounts = array.new_int(0),
         pendingTopologyChildLiveFlags = array.new_bool(0),
         pendingTopologyRootNodeRootIds = array.new_int(0),
         pendingTopologyRootNodeNextIndexes = array.new_int(0),
         pendingTopologyRootNodeOwnerChildIndexes = array.new_int(0),
         pendingTopologyRootNodeExpectedCoreIds = array.new_int(0),
         pendingTopologyRootNodeExpectedGenerationIds = array.new_int(0),
         pendingTopologyRootNodeLiveFlags = array.new_bool(0),
         rootIdOrderSlots = array.from(0, 1, 2),
         rootCandGeometryRevisions = array.new_int(3, 0),
         rootCandQualityRevisions = array.new_int(3, 0),
         rootCandTieBreakRevisions = array.new_int(3, 0),
         rootCandStateRevisions = array.new_int(3, 0))


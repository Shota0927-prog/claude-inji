         rootIds = array.from(1, 2, 5),
         rootSlotLiveFlags = array.new_bool(3, true),
         rootCategories = array.new_int(3, CAT_SWING),
         rootStates = array.new_int(3, ROOT_ACTIVE),
         rootDirections = array.new_int(3, 0),
         rootPointTicks = array.from(100, 120, 128),
         rootNativeBottomTicks = array.new_int(3, int(na)),
         rootNativeTopTicks = array.new_int(3, int(na)),

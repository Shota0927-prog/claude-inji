// Stage G authority: the real W06Comp.recomputeAndMerge (component build, W05 per row, merge) with the Main call
// arguments (generated from the W06 /19 signature and the Main b76c54e call), forceFull as Main
// (not cacheValid or cacheCfgRevision != cfgRevision), the Main write-back of the W05 scalars and of the W06 cache
// scalars (nextComponentId / cacheValid / cacheCfgRevision / visitEpoch / lastRunMode). cfg: clusterMaxWidth 10, denseRatio
// 0.3, every use flag true, mintick 1, cfgRevision 1. Returns 0 when the run was LOCAL (component path committed), else
// the run mode (2 = FULL fallback).
w06Recompute(Fx f, CompStore c, W05Fx w, array<int> seedIds, array<int> seedMasks, int seedCount, int capacity) =>
    bool forceFull = not c.cacheValid or c.cacheCfgRevision != 1
    [w05SupportWinnerCount, w05ResistanceWinnerCount, w05ScratchSupportNewLength, w05ScratchResistanceNewLength, w05SupportFvgLength, w05ResistanceFvgLength, w05BestSide, w05BestStage, w05BestLeftIndex, w05BestRightIndex, w05BestEffectiveBottomTick, w05BestEffectiveTopTick, w05BestCCount, w05BestHCount, w05BestDensity, w05BestBaseStrong, w05BestCreatedTime, w05BestMinRootId, w05BestFvgMode, w05BestFvgRootSlot, w05BestCategoryMask, w05BestHighMask, w05RoundTie, w05FailedSupport, w05FailedResistance, w05WinnerLogicalCount, w05WinnerRootIdLength, w05WinnerRefValueLength, w05WinnerRefRepLength, w05PoolMode, w05BroadSeenEpoch, w06NextComponentId, w06CacheValid, w06CacheCfgRevision, w06VisitEpoch, w06AffectedCount, w06RemovedCount, w06LastRunMode] = W06Comp.recomputeAndMerge(f.rootIds, f.rootCategories, f.rootSubtypes, f.rootTfCodes, f.rootConfirmedTimes, f.rootPointPrices, f.rootPointTicks, f.rootNativeBottoms, f.rootNativeTops, f.rootNativeBottomTicks, f.rootNativeTopTicks, f.rootStates, f.rootPairKeys, f.rootDirections, f.rootIsBroadFvgFlags, f.rootLabelMasks, f.rootSlotLiveFlags, f.rootPriceOrderSlots, f.rootIdOrderSlots, f.rootIdToSlot, f.accumPairUpperRootSlotByKey, f.accumPairLowerRootSlotByKey, f.rootSwingTfMasks, w.ema2000RootSlot, w.ema2000ExpectedRootId, w.ema2000SlopeDir, w.ema3000RootSlot, w.ema3000ExpectedRootId, w.ema3000SlopeDir, 10.0, 0.3, true, true, true, true, true, true, 1.0, w.candidateScratchSupportNewRootSlots, w.candidateScratchResistanceNewRootSlots, w.candidateSupportScratchPosByRootSlot, w.candidateResistanceScratchPosByRootSlot, w.candidateSupportUsedByRootSlot, w.candidateResistanceUsedByRootSlot, w.candidateSupportFvgRootSlots, w.candidateResistanceFvgRootSlots, w.candidateWindowMinRootIdDequeScratchIndexes, w.candidateWindowMaxConfirmedTimeDequeScratchIndexes, w.candidateWinnerSides, w.candidateWinnerStages, w.candidateWinnerEffectiveBottomTicks, w.candidateWinnerEffectiveTopTicks, w.candidateWinnerCCounts, w.candidateWinnerHCounts, w.candidateWinnerDensities, w.candidateWinnerBaseStrongFlags, w.candidateWinnerCategoryMasks, w.candidateWinnerHighMasks, w.candidateWinnerCreatedTimes, w.candidateWinnerMinRootIds, w.candidateWinnerFvgModes, w.candidateWinnerPsychLevelTicks, w.candidateWinnerReferencePrices, w.candidateWinnerExactPrices, w.candidateWinnerRootIdOffsets, w.candidateWinnerRootIdLengths, w.candidateWinnerRootIds, w.candidateWinnerRefValueScratch, w.candidateWinnerRefRepScratch, w.candidateBroadSeenEpochByRootSlot, w.candidateScratchSupportNewLength, w.candidateScratchResistanceNewLength, w.candidateSupportFvgLength, w.candidateResistanceFvgLength, w.candidateBestSide, w.candidateBestStage, w.candidateBestLeftIndex, w.candidateBestRightIndex, w.candidateBestEffectiveBottomTick, w.candidateBestEffectiveTopTick, w.candidateBestCCount, w.candidateBestHCount, w.candidateBestDensity, w.candidateBestBaseStrong, w.candidateBestCreatedTime, w.candidateBestMinRootId, w.candidateBestFvgMode, w.candidateBestFvgRootSlot, w.candidateBestCategoryMask, w.candidateBestHighMask, w.candidateRoundTie, w.candidateFailedSupport, w.candidateFailedResistance, w.candidateWinnerLogicalCount, w.candidateWinnerRootIdLength, w.candidateWinnerRefValueLength, w.candidateWinnerRefRepLength, w.candidatePoolMode, w.candidateBroadSeenEpoch, 1, c.cacheValid, c.cacheCfgRevision, c.nextComponentId, c.visitEpoch, f.categoryFvgRootSlots, f.rootOriginKeys, f.originKeyBucketHeadRootSlots, f.rootOriginBucketNextRootSlots, f.rootOriginBucketExpectedRootIds, f.rootParticipationHeadEdgeIndexes, f.rootParticipationCounts, f.participationEdgeRootSlots, f.participationEdgeExpectedRootIds, f.participationEdgeSideSlots, f.participationEdgeExpectedCoreIds, f.participationEdgeNextByRootIndexes, f.participationEdgeLiveFlags, f.sidePhases, f.coreIds, f.coreGenerationIds, f.coreSlotLiveFlags, f.coreLiveSlots, f.corePhysicalBottoms, f.corePhysicalTops, f.corePendingTopologyChildHeadIndexes, f.corePendingTopologyChildCounts, f.pendingTopologyChildNextIndexes, f.pendingTopologyChildOwnerCoreSlots, f.pendingTopologyChildExpectedCoreIds, f.pendingTopologyChildExpectedGenerationIds, f.pendingTopologyChildRootHeadNodeIndexes, f.pendingTopologyChildRootCounts, f.pendingTopologyChildLiveFlags, f.pendingTopologyRootNodeRootIds, f.pendingTopologyRootNodeNextIndexes, f.pendingTopologyRootNodeOwnerChildIndexes, f.pendingTopologyRootNodeExpectedCoreIds, f.pendingTopologyRootNodeExpectedGenerationIds, f.pendingTopologyRootNodeLiveFlags, c.candVisitedEpochByRootSlot, c.candQueueRootSlots, seedIds, seedMasks, seedCount, f.rootCandGeometryRevisions, f.rootCandQualityRevisions, f.rootCandTieBreakRevisions, f.rootCandStateRevisions, c.rootCandComponentIds, c.rootCandComponentExpectedRootIds, c.candComponentIds, c.candComponentKinds, c.candComponentMemberOffsets, c.candComponentMemberLengths, c.candComponentCfgRevisions, c.candComponentStageKeys, c.candComponentUsedEpochKeys, c.candComponentSupportStatuses, c.candComponentResistanceStatuses, c.candComponentSupportRecordOffsets, c.candComponentSupportRecordLengths, c.candComponentResistanceRecordOffsets, c.candComponentResistanceRecordLengths, c.candComponentSupportSeenOffsets, c.candComponentSupportSeenLengths, c.candComponentResistanceSeenOffsets, c.candComponentResistanceSeenLengths, c.candMemberRootIds, c.candMemberRoleFlags, c.candMemberSideMasks, c.candMemberGeometryRevisions, c.candMemberQualityRevisions, c.candMemberTieBreakRevisions, c.candMemberStateRevisions, c.candRecordInts, c.candRecordReferencePrices, c.candRecordExactPrices, c.candRecordRootIds, c.candSeenBroadRootIds, c.candAffectedComponentIds, c.candRemovedComponentIds, c.candSemanticChangedRootIds, c.candSemanticChangedCurrentComponentIds, c.candChangedScopeFull, forceFull, capacity)
    w.candidateScratchSupportNewLength := w05ScratchSupportNewLength
    w.candidateScratchResistanceNewLength := w05ScratchResistanceNewLength
    w.candidateSupportFvgLength := w05SupportFvgLength
    w.candidateResistanceFvgLength := w05ResistanceFvgLength
    w.candidateBestSide := w05BestSide
    w.candidateBestStage := w05BestStage
    w.candidateBestLeftIndex := w05BestLeftIndex
    w.candidateBestRightIndex := w05BestRightIndex
    w.candidateBestEffectiveBottomTick := w05BestEffectiveBottomTick
    w.candidateBestEffectiveTopTick := w05BestEffectiveTopTick
    w.candidateBestCCount := w05BestCCount
    w.candidateBestHCount := w05BestHCount
    w.candidateBestDensity := w05BestDensity
    w.candidateBestBaseStrong := w05BestBaseStrong
    w.candidateBestCreatedTime := w05BestCreatedTime
    w.candidateBestMinRootId := w05BestMinRootId
    w.candidateBestFvgMode := w05BestFvgMode
    w.candidateBestFvgRootSlot := w05BestFvgRootSlot
    w.candidateBestCategoryMask := w05BestCategoryMask
    w.candidateBestHighMask := w05BestHighMask
    w.candidateRoundTie := w05RoundTie
    w.candidateFailedSupport := w05FailedSupport
    w.candidateFailedResistance := w05FailedResistance
    w.candidateWinnerLogicalCount := w05WinnerLogicalCount
    w.candidateWinnerRootIdLength := w05WinnerRootIdLength
    w.candidateWinnerRefValueLength := w05WinnerRefValueLength
    w.candidateWinnerRefRepLength := w05WinnerRefRepLength
    w.candidatePoolMode := w05PoolMode
    w.candidateBroadSeenEpoch := w05BroadSeenEpoch
    c.nextComponentId := w06NextComponentId
    c.cacheValid := w06CacheValid
    c.cacheCfgRevision := w06CacheCfgRevision
    c.visitEpoch := w06VisitEpoch
    c.lastRunMode := w06LastRunMode
    c.lastRunMode == CAND_LAST_RUN_LOCAL ? 0 : c.lastRunMode

// Metadata-only full W06 build (the reference): no cache state is advanced from it.
w06Build(Fx f, CompStore c, array<int> seedIds, array<int> seedMasks, int seedCount, bool forceFull, int capacity) =>
    [code, nid, cv, ccfg, ep, aff, rem] = W06Comp.buildComponents(1, c.cacheValid, c.cacheCfgRevision, c.nextComponentId, 10, 3, c.visitEpoch, 1.0, f.rootPriceOrderSlots, f.categoryFvgRootSlots, f.rootIds, f.rootSlotLiveFlags, f.rootCategories, f.rootStates, f.rootDirections, f.rootPointTicks, f.rootNativeBottomTicks, f.rootNativeTopTicks, f.rootIsBroadFvgFlags, f.rootSubtypes, f.rootPairKeys, f.rootOriginKeys, f.rootIdToSlot, f.accumPairUpperRootSlotByKey, f.accumPairLowerRootSlotByKey, f.originKeyBucketHeadRootSlots, f.rootOriginBucketNextRootSlots, f.rootOriginBucketExpectedRootIds, f.rootParticipationHeadEdgeIndexes, f.rootParticipationCounts, f.participationEdgeRootSlots, f.participationEdgeExpectedRootIds, f.participationEdgeSideSlots, f.participationEdgeExpectedCoreIds, f.participationEdgeNextByRootIndexes, f.participationEdgeLiveFlags, f.sidePhases, f.coreIds, f.coreGenerationIds, f.coreSlotLiveFlags, f.coreLiveSlots, f.corePhysicalBottoms, f.corePhysicalTops, f.corePendingTopologyChildHeadIndexes, f.corePendingTopologyChildCounts, f.pendingTopologyChildNextIndexes, f.pendingTopologyChildOwnerCoreSlots, f.pendingTopologyChildExpectedCoreIds, f.pendingTopologyChildExpectedGenerationIds, f.pendingTopologyChildRootHeadNodeIndexes, f.pendingTopologyChildRootCounts, f.pendingTopologyChildLiveFlags, f.pendingTopologyRootNodeRootIds, f.pendingTopologyRootNodeNextIndexes, f.pendingTopologyRootNodeOwnerChildIndexes, f.pendingTopologyRootNodeExpectedCoreIds, f.pendingTopologyRootNodeExpectedGenerationIds, f.pendingTopologyRootNodeLiveFlags, c.candVisitedEpochByRootSlot, c.candQueueRootSlots, seedIds, seedMasks, seedCount, f.rootIdOrderSlots, f.rootCandGeometryRevisions, f.rootCandQualityRevisions, f.rootCandTieBreakRevisions, f.rootCandStateRevisions, c.rootCandComponentIds, c.rootCandComponentExpectedRootIds, c.candComponentIds, c.candComponentKinds, c.candComponentMemberOffsets, c.candComponentMemberLengths, c.candComponentCfgRevisions, c.candComponentStageKeys, c.candComponentUsedEpochKeys, c.candComponentSupportStatuses, c.candComponentResistanceStatuses, c.candComponentSupportRecordOffsets, c.candComponentSupportRecordLengths, c.candComponentResistanceRecordOffsets, c.candComponentResistanceRecordLengths, c.candComponentSupportSeenOffsets, c.candComponentSupportSeenLengths, c.candComponentResistanceSeenOffsets, c.candComponentResistanceSeenLengths, c.candMemberRootIds, c.candMemberRoleFlags, c.candMemberSideMasks, c.candMemberGeometryRevisions, c.candMemberQualityRevisions, c.candMemberTieBreakRevisions, c.candMemberStateRevisions, c.candRecordInts, c.candRecordReferencePrices, c.candRecordExactPrices, c.candRecordRootIds, c.candSeenBroadRootIds, c.candAffectedComponentIds, c.candRemovedComponentIds, c.candSemanticChangedRootIds, c.candSemanticChangedCurrentComponentIds, c.candChangedScopeFull, forceFull, capacity)
    c.lastCode         := code
    code

// LOCAL component member sets of a W06 output ("a,b|c,d", rows sorted), read only
compKey(CompStore c) =>
    array<string> keys = array.new_string(0)
    int r = 0
    while r < array.size(c.candComponentIds)
        if array.get(c.candComponentKinds, r) == KIND_LOCAL
            array<string> parts = array.new_string(0)
            int o = array.get(c.candComponentMemberOffsets, r)
            int k = 0
            while k < array.get(c.candComponentMemberLengths, r)
                if array.get(c.candMemberRoleFlags, o + k) == ROLE_MEMBER
                    array.push(parts, str.tostring(array.get(c.candMemberRootIds, o + k)))
                k += 1
            array.push(keys, array.join(parts, ","))
        r += 1
    array.sort(keys, order.ascending)
    array.join(keys, "|")

// every LOCAL row reported as a semantic changed current component, and nothing else
semCompsAllLocal(CompStore c) =>
    int localRows = 0
    bool ok = true
    int r = 0
    while r < array.size(c.candComponentIds)
        if array.get(c.candComponentKinds, r) == KIND_LOCAL
            localRows += 1
            ok := ok and array.includes(c.candSemanticChangedCurrentComponentIds, array.get(c.candComponentIds, r))
        r += 1
    ok and array.size(c.candSemanticChangedCurrentComponentIds) == localRows

intsEq(array<int> a, array<int> b) =>
    bool eq = array.size(a) == array.size(b)
    int i = 0
    while eq and i < array.size(a)
        eq := array.get(a, i) == array.get(b, i)
        i += 1
    eq

// Diagnostics (read only): LOCAL row count of a W06 output.
localRowCount(CompStore c) =>
    int n = 0
    int r = 0
    while r < array.size(c.candComponentIds)
        if array.get(c.candComponentKinds, r) == KIND_LOCAL
            n += 1
        r += 1
    n

// W06 case: baseline (full) -> K freed (the committed W08 change) -> semantic seeds + carry [1, 2, 5] injected by W08Runtime
// -> W06 build (capacity cap1) -> Main clear condition (injected and cache valid) -> on failure one retry with fresh seeds
// -> full W06 reference of the same live state.
w06Case(array<int> semIds, array<int> semMasks, int cap1) =>
    Fx        f = newFx()
    CompStore c = newComp()
    W05Fx     w = newW05()
    int    code0 = w06Recompute(f, c, w, array.new_int(0), array.new_int(0), 0, 100000)
    string base  = compKey(c)
    int    baseRows = localRowCount(c)
    array.set(f.coreSlotLiveFlags, 0, false)
    array.clear(f.coreLiveSlots)
    array<int> carry = array.from(1, 2, 5)
    int initCarry = array.size(carry)
    array<int> ids1   = array.copy(semIds)
    array<int> masks1 = array.copy(semMasks)
    int cnt1  = W08Runtime.dependencyCarryInject(carry, ids1, masks1, array.size(semIds))
    int code1 = w06Recompute(f, c, w, ids1, masks1, cnt1, cap1)
    bool cv1  = c.cacheValid
    string semRoots1 = array.join(c.candSemanticChangedRootIds, ",")
    int semRoots1Size = array.size(c.candSemanticChangedRootIds)
    if array.size(carry) > 0 and c.cacheValid
        array.clear(carry)
    int carryAfter1 = array.size(carry)
    int code2 = -1
    string ids2Str   = ""
    string masks2Str = ""
    int  cnt2o  = -1
    bool cv2    = false
    bool clear2 = false
    if not cv1
        array<int> ids2   = array.copy(semIds)
        array<int> masks2 = array.copy(semMasks)
        int cnt2 = W08Runtime.dependencyCarryInject(carry, ids2, masks2, array.size(semIds))
        ids2Str   := array.join(array.slice(ids2, 0, cnt2), ",")
        masks2Str := array.join(array.slice(masks2, 0, cnt2), ",")
        code2 := w06Recompute(f, c, w, ids2, masks2, cnt2, 100000)
        cnt2o  := cnt2
        cv2    := c.cacheValid
        clear2 := array.size(carry) > 0 and c.cacheValid
        if array.size(carry) > 0 and c.cacheValid
            array.clear(carry)
    CompStore ref = newComp()
    int refCode = w06Build(f, ref, array.new_int(0), array.new_int(0), 0, true, 10000)
    array<int> rowIds = array.new_int(0)
    int broadRowId = 0
    int rr = 0
    while rr < array.size(c.candComponentIds)
        if array.get(c.candComponentKinds, rr) == KIND_LOCAL
            array.push(rowIds, array.get(c.candComponentIds, rr))
        else
            broadRowId := array.get(c.candComponentIds, rr)
        rr += 1
    while array.size(rowIds) < 3
        array.push(rowIds, 0)
    array.push(rowIds, broadRowId)
    [code0, base, code1, cv1, carryAfter1, code2, ids2Str, masks2Str, array.size(carry), compKey(c), compKey(ref), array.join(c.candSemanticChangedRootIds, ","), semRoots1, semCompsAllLocal(c), initCarry, cnt1, baseRows, cnt2o, cv2, clear2, refCode, localRowCount(c), localRowCount(ref), semRoots1Size, array.size(c.candSemanticChangedRootIds), array.size(c.candSemanticChangedCurrentComponentIds), array.copy(c.candSemanticChangedCurrentComponentIds), rowIds]

// ---- W08 fixture: Roots (ids ASC, Swing, ACTIVE) with ticks, one Support winner {1} [100, 120]; mintick 1, mTick 10 ----
// mode 0: pass 1 alloc (runShadow) -> pass 2 the same winner with the range [100, 105] (canonical continuation, coreId /
//         generationId kept), real planPass / preflightPass / commitPass
// mode 1: pass 1 alloc -> pass 2 the same winner (continuation, nothing W06 reads changes)
w08Scenario(array<int> ids, array<int> ticks, int mode) =>
    int n = array.size(ids)
    W08Core.W08Store ws = W08Core.newStore()
    W08Core.CoreRegistryStore cr = ws.coreRegistry
    cr.touchMarkCapacityPerCore := 4
    map<int, int> idToSlot = map.new<int, int>()
    for i = 0 to n - 1
        map.put(idToSlot, array.get(ids, i), i)
    W08Runtime.RootView rv = W08Runtime.RootView.new(rootIds = ids, rootSlotLiveFlags = array.new_bool(n, true), rootIdToSlot = idToSlot, rootCategories = array.new_int(n, CAT_SWING), rootIsBroadFvgFlags = array.new_bool(n, false), rootParticipationHeadEdgeIndexes = array.new_int(n, SLOT_INVALID), rootParticipationCounts = array.new_int(n, 0), rootPriceOrderSlots = array.sort_indices(ticks, order.ascending), rootPointTicks = ticks, rootStates = array.new_int(n, ROOT_ACTIVE), rootDirections = array.new_int(n, 0), rootNativeBottomTicks = array.new_int(n, int(na)), rootNativeTopTicks = array.new_int(n, int(na)))
    W08Runtime.ParticipationView pv = W08Runtime.ParticipationView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Runtime.PhaseSetView hv = W08Runtime.PhaseSetView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0))
    W08Runtime.WinnerView wv = W08Runtime.WinnerView.new(1, 1, array.from(1), array.from(1), array.from(100), array.from(120), array.from(1), array.from(0), array.from(0), array.from(100.0, 120.0), array.from(0), array.from(1), array.from(1))
    W08Runtime.ComponentMetaView mv = W08Runtime.ComponentMetaView.new(array.new_int(n, 0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.from(true))
    W08Core.PendingTopologyStore ps = W08Core.PendingTopologyStore.new(cr.corePendingTopologyFlags, cr.corePendingTopologyChildHeadIndexes, cr.corePendingTopologyChildTailIndexes, cr.corePendingTopologyChildCounts, array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Touch.TouchPlan tp = W08Touch.TouchPlan.new(array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0))
    W08Runtime.ShadowScalars sc = W08Runtime.ShadowScalars.new(1, 1, int(array.max(ids)) + 1, 0, false)
    W08Runtime.ShadowContext ctx = W08Runtime.ShadowContext.new(ws, rv, pv, hv, wv, mv, ps, ps, tp, W08Touch.newSplitTouchPlan(), sc, 10.0, 1.0, false)
    // pass 1: fresh K from winner {1}
    W08Runtime.ShadowPass pr1 = W08Runtime.runShadow(ctx, 1000)
    bool ok1 = pr1.committed and pr1.freshApplied == 1 and array.size(cr.coreIds) == 1
    if ok1
        ok1 := array.get(cr.coreSlotLiveFlags, 0) and array.get(cr.corePhysicalBottoms, 0) == 100.0 and array.get(cr.corePhysicalTops, 0) == 120.0
    bool idGenKept = false
    int  plan2    = -99
    bool pre2     = false
    bool com2     = false
    int  freed2   = -1
    int  applied2 = -1
    int  fresh2   = -1
    bool ok2 = false
    array<int> c2 = array.new_int(0)
    if ok1 and mode == 0
        // K identity after pass 1 (the continuation must keep coreId / generationId)
        int kId  = array.get(cr.coreIds, 0)
        int kGen = array.get(cr.coreGenerationIds, 0)
        // pass 2: the same winner {1} with the range [100, 105]: the canonical 1 -> 1 continuation of K (Root 1 still
        // participates and is the shared live non-Broad origin, gap <= mTick), real planPass / preflightPass / commitPass;
        // the tick range change carries the old L7 neighborhood [90, 130] and the new one [90, 115] (120 / 128 / 130 old only)
        array.set(wv.candidateWinnerEffectiveTopTicks, 0, 105)
        array.set(wv.candidateWinnerExactPrices, 1, 105.0)
        W08Runtime.ShadowPass pr2 = W08Runtime.planPass(ctx)
        if pr2.planResult >= 0
            pre2 := W08Runtime.preflightPass(ctx, pr2, 2000)
            if pre2
                W08Runtime.commitPass(ctx, pr2, 2000)
        plan2    := pr2.planResult
        com2     := pr2.committed
        freed2   := pr2.freed
        applied2 := pr2.appliedTargets
        fresh2   := pr2.freshApplied
        idGenKept := array.get(cr.coreIds, 0) == kId and array.get(cr.coreGenerationIds, 0) == kGen
        ok2 := idGenKept and pr2.committed and pr2.appliedTargets == 1 and pr2.freshApplied == 0 and pr2.freed == 0 and array.get(cr.coreSlotLiveFlags, 0) and array.get(cr.corePhysicalBottoms, 0) == 100.0 and array.get(cr.corePhysicalTops, 0) == 105.0
        c2 := pr2.dependencyChangedRootIds
    if ok1 and mode == 1
        W08Runtime.ShadowPass pr2 = W08Runtime.runShadow(ctx, 2000)
        plan2  := pr2.planResult
        pre2   := pr2.preflightOk
        com2   := pr2.committed
        freed2 := pr2.freed
        ok2 := pr2.committed and pr2.appliedTargets == 1 and pr2.freshApplied == 0 and array.get(cr.coreSlotLiveFlags, 0)
        c2 := pr2.dependencyChangedRootIds
    [ok1, pr1.dependencyChangedRootIds, ok2, c2, pr1.committed, idGenKept, plan2, pre2, com2, freed2, applied2, fresh2]

// ---- Diagnostics (read only, data window): 54 values in dg; the PASS conditions above are unchanged ----
// packIds: the first 4 IDs as e0 * 1e9 + e1 * 1e6 + e2 * 1e3 + e3 (a missing element is 0)
// B_HAS_x: 1 = in the pass 1 (alloc, new range) carry, 2 = in the pass 2 (free, old range) carry, 3 = both
// *_JOIN_CODE: isNa * 1000 + eqEmpty * 100 + str.length (0 when na) of the joined semantic Root string
// A_PASS2_APPLIED_FRESH_FREED: appliedTargets * 100 + freshApplied * 10 + freed of pass 2 (continuation: 100)
// F_CACHE_VALID_PROXY: 0 (no cache-valid proxy: the W06 cache state advances only through recomputeAndMerge)
// D_SEM_COMPONENT_IDS_PACKED: the first 4 semantic changed current component IDs; D_ROW_IDS_PACKED: the LOCAL row IDs
// (3 places, 0 padded) then the BROAD_ONLY row ID
packIds(array<int> a) =>
    float v = 0.0
    for i = 0 to 3
        int x = 0
        if i < array.size(a)
            x := array.get(a, i)
        v := v * 1000 + x
    v
b2f(bool b) =>
    b ? 1.0 : 0.0
joinIsNa(string s) =>
    na(s) ? 1.0 : 0.0
joinLen(string s) =>
    float v = na
    if not na(s)
        v := str.length(s)
    v
joinEqEmpty(string s) =>
    bool e = s == ""
    e ? 1.0 : 0.0
joinCode(string s) =>
    float lenPart = 0.0
    if not na(s)
        lenPart := math.min(str.length(s), 99)
    joinIsNa(s) * 1000 + joinEqEmpty(s) * 100 + lenPart
hasCode(array<int> c1, array<int> c2, int id) =>
    (array.includes(c1, id) ? 1.0 : 0.0) + (array.includes(c2, id) ? 2.0 : 0.0)

var array<float> dg = array.new_float(55, na)
var int probePass = 0
var int tA = 0
var int tB = 0
var int tC = 0
var int tD = 0
var int tE = 0
var int tF = 0
var int tG = 0
var int tH = 0

if barstate.isfirst
    // A: canonical continuation, old-range-only L7 PCs in the carry
    [a1, aC1, a2, aC2, aCom1, aIdGen, aPlan2, aPre2, aCom2, aFreed2, aApplied2, aFresh2] = w08Scenario(array.from(1, 2, 5), array.from(100, 120, 128), 0)
    bool passA = a1 and a2 and intsEq(aC1, array.from(1, 2, 5)) and intsEq(aC2, array.from(1, 2, 5))
    // B: boundary (Root 6 @ 89, 7 @ 90, 8 @ 130, 9 @ 131)
    [b1, bC1, b2, bC2, bCom1, bIdGen, bPlan2, bPre2, bCom2, bFreed2, bApplied2, bFresh2] = w08Scenario(array.from(1, 6, 7, 8, 9), array.from(100, 89, 90, 130, 131), 0)
    bool passB = b1 and b2 and intsEq(bC1, array.from(1, 7, 8)) and intsEq(bC2, array.from(1, 7, 8))
    // C: mask-0 injection into empty seeds, duplicate-free
    array<int> cCarry = array.from(1, 2, 5)
    array<int> cIds   = array.new_int(0)
    array<int> cMasks = array.new_int(0)
    int cN1 = W08Runtime.dependencyCarryInject(cCarry, cIds, cMasks, 0)
    int cN2 = W08Runtime.dependencyCarryInject(cCarry, cIds, cMasks, cN1)
    bool injOk = cN1 == 3 and cN2 == 3 and intsEq(cIds, array.from(1, 2, 5)) and intsEq(cMasks, array.from(0, 0, 0)) and intsEq(cCarry, array.from(1, 2, 5))
    [d0, dBase, d1, dCv1, dCarry1, d2, dIds2, dMasks2, dCarryEnd, dKey, dRef, dSemRoots, dSemRoots1, dSemComps, dInitCarry, dCnt1, dBaseRows, dCnt2, dCv2, dClear2, dRefCode, dLocalRows, dRefRows, dSemRoots1Size, dSemRootsSize, dSemCompCount, dSemCompIds, dRowIds] = w06Case(array.new_int(0), array.new_int(0), 100000)
    bool passC = injOk and d1 == 0 and dSemRoots1 == ""
    // D: component rebuild through mask-0 seeds equals the full W06 rebuild
    bool passD = d0 == 0 and dBase == "1,2,5" and d1 == 0 and dCv1 and dKey == "1|2,5" and dKey == dRef and dSemRoots == "" and dSemComps and intsEq(dSemCompIds, array.from(3, 4)) and dCarryEnd == 0
    // E: carry merge
    array<int> eCarry = array.from(1, 5, 9)
    int eN = W08Runtime.dependencyCarryMerge(eCarry, array.from(2, 5, 8))
    bool passE = eN == 5 and intsEq(eCarry, array.from(1, 2, 5, 8, 9))
    // F: retry after a W06 build failure (capacity 2 < 3 Roots)
    [f0, fBase, f1, fCv1, fCarry1, f2, fIds2, fMasks2, fCarryEnd, fKey, fRef, fSemRoots, fSemRoots1, fSemComps, fInitCarry, fCnt1, fBaseRows, fCnt2, fCv2, fClear2, fRefCode, fLocalRows, fRefRows, fSemRoots1Size, fSemRootsSize, fSemCompCount, fSemCompIds, fRowIds] = w06Case(array.new_int(0), array.new_int(0), 2)
    bool passF = f0 == 0 and f1 != 0 and not fCv1 and fCarry1 == 3 and fIds2 == "1,2,5" and fMasks2 == "0,0,0" and f2 == 0 and fCarryEnd == 0 and fKey == fRef and fKey == "1|2,5" and fSemRoots == ""
    // G: semantic seed 2 (mask 4) keeps its mask; W06 semantic Roots = [2]
    array<int> gIds   = array.from(2)
    array<int> gMasks = array.from(4)
    int gN = W08Runtime.dependencyCarryInject(array.from(1, 2, 5), gIds, gMasks, 1)
    [g0, gBase, g1, gCv1, gCarry1, g2, gIds2, gMasks2, gCarryEnd, gKey, gRef, gSemRoots, gSemRoots1, gSemComps, gInitCarry, gCnt1, gBaseRows, gCnt2, gCv2, gClear2, gRefCode, gLocalRows, gRefRows, gSemRoots1Size, gSemRootsSize, gSemCompCount, gSemCompIds, gRowIds] = w06Case(array.from(2), array.from(4), 100000)
    bool passG = gN == 3 and intsEq(gIds, array.from(2, 1, 5)) and intsEq(gMasks, array.from(4, 0, 0)) and g1 == 0 and gSemRoots1 == "2" and gKey == gRef
    // H: no-op
    array<int> hCarry = array.from(1, 5)
    int hN = W08Runtime.dependencyCarryMerge(hCarry, array.new_int(0))
    array<int> hIds   = array.from(3)
    array<int> hMasks = array.from(4)
    int hS = W08Runtime.dependencyCarryInject(array.new_int(0), hIds, hMasks, 1)
    [h1, hC1, h2, hC2, hCom1, hIdGen, hPlan2, hPre2, hCom2, hFreed2, hApplied2, hFresh2] = w08Scenario(array.from(1, 2, 5), array.from(100, 120, 128), 1)
    bool passH = hN == 2 and intsEq(hCarry, array.from(1, 5)) and hS == 1 and intsEq(hIds, array.from(3)) and intsEq(hMasks, array.from(4)) and h1 and h2 and array.size(hC2) == 0
    // ---- diagnostics ----
    array.set(dg, 0, b2f(a1))
    array.set(dg, 1, b2f(aCom1))
    array.set(dg, 2, array.size(aC1))
    array.set(dg, 3, packIds(aC1))
    array.set(dg, 4, b2f(aIdGen))
    array.set(dg, 5, aPlan2)
    array.set(dg, 6, b2f(aPre2))
    array.set(dg, 7, b2f(aCom2))
    array.set(dg, 8, aApplied2 * 100 + aFresh2 * 10 + aFreed2)
    array.set(dg, 9, array.size(aC2))
    array.set(dg, 10, packIds(aC2))
    array.set(dg, 11, array.size(bC2))
    array.set(dg, 12, hasCode(bC1, bC2, 1))
    array.set(dg, 13, hasCode(bC1, bC2, 6))
    array.set(dg, 14, hasCode(bC1, bC2, 7))

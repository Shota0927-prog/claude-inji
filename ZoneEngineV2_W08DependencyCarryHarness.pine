         rootOriginBucketNextRootSlots = array.new_int(3, SLOT_INVALID),
         rootOriginBucketExpectedRootIds = array.new_int(3, 0),
         rootParticipationHeadEdgeIndexes = array.new_int(3, SLOT_INVALID),
         rootParticipationCounts = array.new_int(3, 0),
         participationEdgeRootSlots = array.new_int(0),
         participationEdgeExpectedRootIds = array.new_int(0),
         participationEdgeSideSlots = array.new_int(0),
         participationEdgeExpectedCoreIds = array.new_int(0),
         participationEdgeNextByRootIndexes = array.new_int(0),
         participationEdgeLiveFlags = array.new_bool(0),
         sidePhases = array.from(0, 0),
         coreIds = array.from(11),
         coreGenerationIds = array.from(1),
         coreSlotLiveFlags = array.from(true),
         coreLiveSlots = array.from(0),
         corePhysicalBottoms = array.from(100.0),
         corePhysicalTops = array.from(120.0),
         corePendingTopologyChildHeadIndexes = array.from(SLOT_INVALID),
         corePendingTopologyChildCounts = array.from(0),
         pendingTopologyChildNextIndexes = array.new_int(0),

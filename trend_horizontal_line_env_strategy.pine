//
// ============================================================
//  トレンド + 水平線 環境認識ストラテジー
// ------------------------------------------------------------
//  ・エントリー   : 包み足 (Bullish / Bearish Engulfing) + 任意トリガー
//  ・環境認識     : EMAトレンド環境認識 + 水平線環境認識 (日足〜1分足の6TF)
//  ・水平線       = 確定Pivot/複数反応/前日H・L/セッションH・L のゾーンでの反発/転換/ブレイク/スイープから方向判定 (線の上下では判定しない)。
//  ・場所条件     : WinZone は全て不使用
//  ・その他       : ボラフィルタ / リスク管理 / 時間帯フィルタ / Accumulation NoTrade を維持
//  ・環境認識のうち FVG / EMA(50/200/1000) / Stochastic / Volume / 三尊 / DT/DB / ウェッジ / トライアングル / エリオット / フィボナッチ は不使用 (削除)
//
//  ※ 5分足チャートに適用してください。
// ============================================================

//@version=5
strategy(
     title             = "Trend Horizontal Line Env Strategy",
     shorttitle        = "THLINEENV",
     overlay           = true,
     pyramiding        = 50,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_boxes_count   = 200,
     max_labels_count  = 100,
     max_lines_count   = 500
 )

// ============================================================
//  1. 入力 : エントリー / トリガー / ボラ / 環境(トレンド)
// ============================================================
useLong      = input.bool(true, "ロングを有効")
useShort     = input.bool(false, "ショートを有効")
strictEngulf = input.bool(true, "実体が前足を完全に包む")
reqOppColor  = input.bool(true, "前足が反対色であることを要求")
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
useEngulfingTrigger    = input.bool(false, "包み足")
usePinbarTrigger       = input.bool(false, "ピンバー")
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新")
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト")
useFVGTriggerFormation = input.bool(false, "FVG形成")
useStrongCandleTrigger = input.bool(false, "強ローソク")

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"])
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)")

// 1分足トリガー確認 (request.security_lower_tf で現在の5分足内の確定1分足を配列取得)
//   トリガー検知は 1分足 OHLC で行い、最終エントリーは 5分足確定時に判定する。
//   現在足(5分足)との結合モード (triggerTFMode) は廃止。最終トリガーは 1分足のみで判断。
useLowerTFTrigger = input.bool(true, "1分足トリガーを使う")
triggerTF         = input.timeframe("1", "トリガー時間足")

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)")
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター")
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数")
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率")
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間")
bosLookback        = input.int(10,  "BOS Lookback")
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率")
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限")
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター")
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率")
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター")
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間")
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率")
strongBodyRatio    = input.float(0.6, "強ローソク 実体率")
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率")
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター")
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率")
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター")
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率")
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター")
engulfAtrLen               = input.int(14, "包み足 ATR期間")
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率")

useTriggerCooldown        = input.bool(false, "トリガークールダウン")
triggerCooldownBars       = input.int(3, "クールダウン本数")
// 既定 true : 同一5分足内で1分足のロング/ショートが両方成立したら NoTrade。
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade")

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)")

atrLenBase   = input.int(14, "基準ATR本数")
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)")
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止")
minAtrDollar = input.float(1.5,  "最低ATR($)")
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする")
volAvgLen    = input.int(480,    "ATR平均本数")
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比")
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"])
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数")
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時")
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時")
bodyAvgLen   = input.int(5,      "実体平均本数")
bodyAvgMin   = input.float(0.5,  "実体平均最低($)")
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時")
rangeLookback       = input.int(20,    "RangeWidth参照本数")
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比")
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う")
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数")

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
useTrendEnv = input.bool(true, "トレンド環境認識(EMAスコア)を使う (重い/OFFで軽量)")

reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4")
tf4H        = input.timeframe("240", "TF", inline = "tf4")
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1")
tf1H        = input.timeframe("60",  "TF", inline = "tf1")
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15")
tf15M       = input.timeframe("15",  "TF", inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5")
tf5M        = input.timeframe("5",   "TF", inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m")
tf1M        = input.timeframe("1",   "TF", inline = "tf1m")

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50")
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き")
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き")
useCloseAboveEma50  = input.bool(true, "4. close > EMA50")
useCloseAboveEma200 = input.bool(true, "5. close > EMA200")
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中")

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50")
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き")
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き")
useCloseBelowEma50  = input.bool(true, "4. close < EMA50")
useCloseBelowEma200 = input.bool(true, "5. close < EMA200")
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い")
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中")

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い")
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い")
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い")
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中")
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ")
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ")
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい")

len20        = input.int(20,   "EMA20 length")
len50        = input.int(50,   "EMA50 length")
len200       = input.int(200,  "EMA200 length")
envAtrLen    = input.int(14,   "環境ATR length")
slopeBars    = input.int(3,    "EMA 傾き判定本数")
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率")
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率")
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率")
convDivBars  = input.int(5,    "収束/拡散 判定本数")
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数")
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数")
rangeBars    = input.int(20,   "レンジ幅 判定本数")
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率")

tieAsRange          = input.bool(true, "同点時にレンジ扱いする")
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする")
minScore4H  = input.int(3, "4H 最低必要スコア")
minScore1H  = input.int(3, "1H 最低必要スコア")
minScore15M = input.int(3, "15M 最低必要スコア")
minScore5M  = input.int(3, "5M 最低必要スコア")
minScore1M  = input.int(3, "1M 最低必要スコア")

reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)")

useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う")
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"])

reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"])
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"])

dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"])
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数")
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル")
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル")
dailyAtrLen       = input.int(14, "日足ATR期間")
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR")
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR")
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)")
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)")

useHighVol140to170 = input.bool(true, "高ボラ 140〜170")
useHighVol170to200 = input.bool(true, "高ボラ 170〜200")
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上")
highVolLevel1   = input.float(140.0, "高ボラ1 下限")
highVolLevel2   = input.float(170.0, "高ボラ2 下限")
extremeVolLevel = input.float(200.0, "異常ボラ 下限")

dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率")
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限")
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限")
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)")

groupAccumNoTrade = "Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = groupAccumNoTrade)
useAccumNT5M    = input.bool(true,  "5分足Accumを使う",  group = groupAccumNoTrade)
useAccumNT15M   = input.bool(true,  "15分足Accumを使う", group = groupAccumNoTrade)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = groupAccumNoTrade)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = groupAccumNoTrade)
// 判定パラメータ (Accum Box Indicator と同一)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",     minval = 6,   group = groupAccumNoTrade)
accumNTBaseLen         = input.int(20,   "基準平均本数",           minval = 10,  group = groupAccumNoTrade)
accumNTAtrLen          = input.int(14,   "ATR本数",                minval = 1,   group = groupAccumNoTrade)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",     minval = 1,   group = groupAccumNoTrade)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",          minval = 1,   group = groupAccumNoTrade)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",     minval = 0.5,  step = 0.1,  group = groupAccumNoTrade)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限",  minval = 0.1,  step = 0.01, group = groupAccumNoTrade)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",           minval = 0.05, maxval = 1.0, step = 0.05, group = groupAccumNoTrade)
// Accum離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = groupAccumNoTrade)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = groupAccumNoTrade)
// Accum離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = groupAccumNoTrade)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = groupAccumNoTrade)

riskPct     = input.float(5.0, "1トレード損失率 (%)")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利")
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"])
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時")
slFixed     = input.float(12, "固定SL幅 (価格) ※固定時")
rrRatio     = input.float(1.0, "リスクリワード比 (TP)")

useSessionFilter = input.bool(true, "時間帯フィルタを使う")
useAsiaSession   = input.bool(true, "アジア 09:00-16:00")
useEUSession     = input.bool(true, "EU 16:00-21:00")
useNYSession     = input.bool(true, "NY 21:00-翌03:00")

// ============================================================
//  4b-2. 入力 : 重要指標時間フィルタ (Asia/Tokyo 基準・新規エントリーのみ除外)
// ============================================================
useNewsTimeFilter = input.bool(false, "重要指標時間を除外")
newsSession1 = input.session("2130-2230", "指標除外時間1")
newsSession2 = input.session("2330-0030", "指標除外時間2")
newsSession3 = input.session("0300-0400", "指標除外時間3")

// ============================================================
//  4i. 入力 : 水平線 環境認識モジュール (MTF・レジサポ反応)
// ------------------------------------------------------------
//  各TFで確定Pivot/複数反応帯/前日H・L/セッションH・L を統合ゾーン化し、
//  ゾーン付近で実際に起きた反応から方向を決める (線の上/下では判定しない)。
//    Long環境イベント : サポート反発 / レジ上抜け後のサポート転換 / 上方向ブレイク / 下方向スイープ後の上方回帰。
//    Short環境イベント: レジ反発 / サポ下抜け後のレジ転換 / 下方向ブレイク / 上方向スイープ後の下方回帰。
//    形成中/接近中/線が存在するだけ では bias を出さない。同一バー両方向成立 → bias=0(Conflict)。
//    反応は単発イベントのため holdBars 本だけ bias を保持。反対方向の新イベントで即上書き。
//  障害物 (近すぎる反対側レジサポ) は NoTrade。反対方向 bias へは変換しない。
//  既存の EMAトレンド環境とは独立 (接頭辞 lineEnv)。方向必須の環境フィルター。
//  非リペイント: request.security + lookahead_on + 関数内 確定1本前[1]。5分足のみ直接計算。
// ============================================================
grpLineEnv = "環境: 水平線"
useLineEnvEnv = input.bool(true, "水平線環境認識を使う", group = grpLineEnv)
useLineEnvD   = input.bool(true,  "日足を使う", group = grpLineEnv)
useLineEnv4H  = input.bool(true,  "4Hを使う",  group = grpLineEnv)
useLineEnv1H  = input.bool(true,  "1Hを使う",  group = grpLineEnv)
useLineEnv15M = input.bool(true,  "15Mを使う", group = grpLineEnv)
useLineEnv5M  = input.bool(false, "5Mを使う", group = grpLineEnv)
useLineEnv1M  = input.bool(false, "1Mを使う (通常のrequest.securityでは1分イベントを取りこぼすため既定OFF)", group = grpLineEnv)
lineEnvDailyTF = input.timeframe("D",   "日足TF", group = grpLineEnv)
lineEnv4HTF    = input.timeframe("240", "4H TF",  group = grpLineEnv)
lineEnv1HTF    = input.timeframe("60",  "1H TF",  group = grpLineEnv)
lineEnv15MTF   = input.timeframe("15",  "15M TF", group = grpLineEnv)
lineEnv5MTF    = input.timeframe("5",   "5M TF",  group = grpLineEnv)
lineEnv1MTF    = input.timeframe("1",   "1M TF",  group = grpLineEnv)
// --- 水平線ソース (個別ON/OFF) ---
useLineEnvPivot        = input.bool(true, "Pivot High/Low", group = grpLineEnv)
useLineEnvReaction     = input.bool(true, "複数回反応価格帯", group = grpLineEnv)
useLineEnvPreviousDayHL = input.bool(true, "前日 高値/安値", group = grpLineEnv)
useLineEnvSessionHL    = input.bool(true, "セッション 高値/安値", group = grpLineEnv)
// --- 基本パラメータ ---
lineEnvAtrLen   = input.int(14, "ATR期間", minval = 1, group = grpLineEnv)
lineEnvPivotLen = input.int(10, "Pivot Length", minval = 1, group = grpLineEnv)
lineEnvMaxZones = input.int(20, "水平線 最大保持数", minval = 1, maxval = 60, group = grpLineEnv)
// --- 複数回反応帯 ---
lineEnvReactionLookback     = input.int(300, "反応 参照本数", minval = 1, group = grpLineEnv)
lineEnvReactionToleranceATR = input.float(0.3, "反応 許容幅 ATR倍率", step = 0.05, group = grpLineEnv)
lineEnvReactionMinTouches   = input.int(2, "反応 最小タッチ数", minval = 2, group = grpLineEnv)
// --- ゾーン統合 ---
useLineEnvMergeZone   = input.bool(true, "近い水平線をゾーン統合する", group = grpLineEnv)
lineEnvMergeToleranceATR = input.float(0.5, "統合許容幅 ATR倍率", step = 0.05, group = grpLineEnv)
// --- ゾーン幅 ---
useLineEnvATRZone     = input.bool(true, "ゾーン幅をATR連動にする", group = grpLineEnv)
lineEnvZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率", step = 0.05, group = grpLineEnv)
lineEnvZoneFixedWidth = input.float(0.0, "ゾーン幅 固定", step = 0.1, group = grpLineEnv)
// --- 水平線強度フィルター ---
useLineEnvStrengthFilter = input.bool(false, "強度フィルターを使う", group = grpLineEnv)
lineEnvMinStrength       = input.int(1, "最低強度 (1〜5)", minval = 1, maxval = 5, group = grpLineEnv)
// --- 4種類の反応 (個別ON/OFF) ---
useLineEnvBounce = input.bool(true, "A: 反発", group = grpLineEnv)
useLineEnvFlip   = input.bool(true, "B: レジサポ転換", group = grpLineEnv)
useLineEnvBreak  = input.bool(true, "C: ブレイク", group = grpLineEnv)
useLineEnvSweep  = input.bool(true, "D: スイープ反転", group = grpLineEnv)
// --- A: 反発 ---
lineEnvBounceRecoverMode = input.string("Center", "反発 回復位置", options = ["Center", "OuterEdge", "PreviousCloseSide"], group = grpLineEnv)
// --- B: レジサポ転換 ---
lineEnvFlipLookback    = input.int(30, "転換 参照本数", minval = 1, group = grpLineEnv)
lineEnvFlipConfirmBars = input.int(2,  "転換 確定本数", minval = 0, group = grpLineEnv)
// --- C: ブレイク ---
lineEnvBreakBufferATR    = input.float(0.05, "ブレイク バッファ ATR倍率", minval = 0.0, step = 0.05, group = grpLineEnv)
useLineEnvBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター", group = grpLineEnv)
lineEnvBreakBodyRatio    = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineEnv)
useLineEnvBreakCandleColor = input.bool(false, "ブレイク 方向ローソク色を要求", group = grpLineEnv)
// --- D: スイープ反転 ---
lineEnvSweepToleranceATR = input.float(0.2, "スイープ 最小貫通 ATR倍率", minval = 0.0, step = 0.05, group = grpLineEnv)
// --- イベント再アーム (同じゾーンの将来の新しい反応を許可) ---
lineEnvEventRearmMode = input.string("LeaveZone", "イベント再アーム", options = ["LeaveZone", "Bars", "LeaveZoneOrBars"], group = grpLineEnv)
lineEnvEventRearmATR  = input.float(0.5, "再アーム ゾーン離脱 ATR倍率", minval = 0.0, step = 0.05, group = grpLineEnv)
lineEnvEventRearmBars = input.int(3, "再アーム 最低本数", minval = 1, group = grpLineEnv)
// --- 共通ローソク品質 ---
useLineEnvDirCandleFilter = input.bool(true,  "方向ローソク", group = grpLineEnv)
useLineEnvWickFilter      = input.bool(false, "ヒゲ確認",     group = grpLineEnv)
useLineEnvBodyFilter      = input.bool(false, "実体率",       group = grpLineEnv)
useLineEnvATRFilter       = input.bool(false, "ATR(値幅)",    group = grpLineEnv)
lineEnvBodyRatioMin       = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineEnv)
lineEnvAtrMinMult         = input.float(0.5, "最小値幅 ATR倍率", minval = 0.0, step = 0.05, group = grpLineEnv)
// --- 両方向同時成立 ---
lineEnvConflictMode = input.string("ConflictNoTrade", "両方向同時成立の扱い", options = ["ConflictNoTrade", "HigherStrength", "HigherPriority"], group = grpLineEnv)
// --- 障害物 NoTrade ---
useLineEnvObstacleFilter = input.bool(false, "障害物NoTradeを使う", group = grpLineEnv)
lineEnvObstacleATR       = input.float(0.5, "障害物 近接 ATR倍率", step = 0.05, group = grpLineEnv)
lineEnvObstacleCombineMode = input.string("AnyTF", "障害物のMTF統合", options = ["AnyTF", "Weighted", "SelectedTFOnly"], group = grpLineEnv)
lineEnvObstacleWeightThresh = input.int(3, "障害物 Weighted 閾値", minval = 1, group = grpLineEnv)
lineEnvObstacleSelectedTF   = input.string("15M", "障害物 SelectedTF", options = ["D", "4H", "1H", "15M", "5M", "1M"], group = grpLineEnv)
// --- スコアリング ---
lineEnvScoringMode = input.string("EventStrength", "スコア方式", options = ["BinaryBias", "EventStrength"], group = grpLineEnv)
// --- セッション ---
lineEnvSessTZ     = input.string("GMT", "セッション タイムゾーン", group = grpLineEnv)
lineEnvAsiaSess   = input.session("0000-0800", "Asia",   group = grpLineEnv)
lineEnvLondonSess = input.session("0700-1600", "London", group = grpLineEnv)
lineEnvNySess     = input.session("1200-2100", "New York", group = grpLineEnv)
// --- 状態保持本数 (足ごと。反応は単発イベントのため保持) ---
lineEnvHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = grpLineEnv)
lineEnvHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = grpLineEnv)
lineEnvHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = grpLineEnv)
lineEnvHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = grpLineEnv)
lineEnvHold5M    = input.int(24, "5M 状態保持本数",   minval = 1, group = grpLineEnv)
lineEnvHold1M    = input.int(30, "1M 状態保持本数",   minval = 1, group = grpLineEnv)
// --- 統合 ---
lineEnvCombineMode = input.string("WeightedScore", "水平線環境の結合方法", options = ["HigherTF", "WeightedScore"], group = grpLineEnv)
lineEnvWeightD   = input.int(4, "重み 日足",  minval = 0, group = grpLineEnv)
lineEnvWeight4H  = input.int(3, "重み 4H",   minval = 0, group = grpLineEnv)
lineEnvWeight1H  = input.int(2, "重み 1H",   minval = 0, group = grpLineEnv)
lineEnvWeight15M = input.int(1, "重み 15M",  minval = 0, group = grpLineEnv)
lineEnvWeight5M  = input.int(1, "重み 5M",   minval = 0, group = grpLineEnv)
lineEnvWeight1M  = input.int(1, "重み 1M",   minval = 0, group = grpLineEnv)
lineEnvScoreThreshold = input.int(3, "Net Score 閾値 (Long: Net>=閾値 / Short: Net<=-閾値)", minval = 1, group = grpLineEnv)
// --- トレンド環境との結合 ---
lineEnvTrendCombineMode = input.string("TrendAndLine", "トレンドとの結合", options = ["TrendOnly", "LineOnly", "TrendAndLine", "TrendOrLine"], group = grpLineEnv)
useLineEnvBias = input.bool(false, "水平線方向バイアスを使う (OFFで既存挙動を維持)", group = grpLineEnv)
// --- 表示 ---
lineEnvShowTable = input.bool(true,  "水平線環境テーブルを表示", group = grpLineEnv)
lineEnvShowDebug = input.bool(false, "水平線環境デバッグ表示", group = grpLineEnv)
lineEnvLabelTF   = input.string("15M", "描画対象TF", options = ["D", "4H", "1H", "15M", "5M", "1M"], group = grpLineEnv)
// --- 描画 (表示専用・検知/スコア/エントリーに影響しない) ---
lineEnvShowZones  = input.bool(true, "最近接Support/Resistanceを表示", group = grpLineEnv)
lineEnvShowLabels = input.bool(true, "反応ラベル (Bounce/Flip/Break/Sweep) を表示", group = grpLineEnv)
// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// 有効化されたトリガー数 (Any/All/MinCount 判定で使用・全コンテキスト共通)。
//   f_calcTriggers 内 (=1分足コンテキスト) からも参照するため関数より前で定義する。
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// 1分足コンテキストで全トリガーを判定し、その1分足単体で Any/All/MinCount を評価して
//   [bullTrigger, bearTrigger] を返す。異なる1分足で発生した条件を合算しない。
//   各トリガー条件・品質フィルターは既存ロジックと完全に同一 (変更なし)。
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    // この1分足単体で Any/All/MinCount を評価 (1分足内で完結)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

// 現在足(5分足)での直接判定 (useLowerTFTrigger = false 時のフォールバックのみに使用)
bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 1分足トリガー集約 ---
//   request.security_lower_tf で現在の5分足に含まれる確定済み1分足 (最大5本) の
//   [bullTrigger, bearTrigger] を配列で取得。5本のうち1本でも成立していれば
//   その方向を5分足の候補とする (途中の1分足トリガーを取りこぼさない)。
//   Any/All/MinCount は各1分足内で f_calcTriggers が評価済み → 異なる足の条件は合算しない。
//   ※ 形成途中の1分足は request.security_lower_tf の確定済み配列に含まれないため非リペイント。
bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, triggerTF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    // 1分足トリガー OFF → 現在足(5分足)で直接判定
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

// 同一5分足内でロング/ショート両方の1分足トリガーが発生 → 方向を予想せず NoTrade (既定)。
bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

// エントリークールダウン (5分足単位・トリガーON時のみ 10c で参照)
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// ============================================================
//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境(トレンド)判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 上位足の「確定済み1本前」の環境判定を返す非リペイント補助。
f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

// ============================================================
//  8. 環境(トレンド)フィルタ計算
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useTrendEnv
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  本ファイルの環境認識モジュールは トレンド(EMAスコア) のみ。
//  FVG / EMA(50/200/1000) / Stochastic / Fib / Volume は削除済み。
// ============================================================
bool trendLongOk = not useTrendEnv or allowByEnv
bool allEnvLongOk = trendLongOk

bool trendShortOk = not useTrendEnv or allowByEnv
bool allEnvShortOk = trendShortOk
// ============================================================
//  8i. 水平線 環境認識モジュール 本体 (MTF・レジサポ反応)
// ------------------------------------------------------------
//  f_lineEnvState : 呼ばれた足(=上位足)コンテキストで、確定Pivot/前日H・L/セッションH・L を
//    統合ゾーン配列で管理 (近接は加重平均で統合)。最近接Support/Resistance を求め、
//    反発(Bounce)/レジサポ転換(Flip)/ブレイク(Break)/スイープ反転(Sweep) を判定して方向を決める。
//      ・線の上下では判定しない。実際の反応イベントだけが bias を出す。
//      ・優先順位 Sweep > Break > Flip > Bounce。同一バー両方向 → Conflict(lineEnvConflictMode)。
//      ・反応は単発イベントのため holdBars 本だけ保持。反対方向の新イベントで即上書き。
//      ・イベントID (ゾーン価格+種別+方向) で同じイベントの毎バー再発火を防ぐ。
//    障害物 (近すぎる反対側レジサポ) は NoTrade。反対方向 bias へは変換しない。
//  戻り値 (23要素):
//    [bias, reason, remain, longScore, shortScore, signalType, strength, source, hitTF,
//     nearestSupport, nearestResistance, hitZonePrice, zoneWidth, touchCount,
//     noTradeLong, noTradeShort, longEvent, shortEvent, conflict, eventId,
//     supTime, resTime, hitZoneTime]
//    reason : 1=Sup Bounce Long / -1=Res Bounce Short / 2=Res Flip Long / -2=Sup Flip Short
//             3=Res Break Long / -3=Sup Break Short / 4=Sup Sweep Long / -4=Res Sweep Short
//             5=Conflict / 0=None
//    signalType : 1=Bounce / 2=Flip / 3=Break / 4=Sweep / 0=None
//    source : 1=Pivot / 2=Reaction / 3=Previous Day / 4=Session / 5=Multiple Sources
//  非リペイント: Pivot確定後のみ / 前日は確定前日値 / セッションは確定後のみ / ヒゲ抜けと終値を区別。
// ============================================================

// 共通ローソク品質 (方向/ヒゲ/実体/ATR。各OFFなら影響しない)
f_lineEnvCommonOK(_isBuy, _atr) =>
    float _rng  = high - low
    float _body = math.abs(close - open)
    float _upW  = high - math.max(close, open)
    float _dnW  = math.min(close, open) - low
    float _bRatio = _rng > 0 ? _body / _rng : 0.0
    bool _ok = true
    if useLineEnvDirCandleFilter
        _ok := _ok and (_isBuy ? close > open : close < open)
    if useLineEnvWickFilter
        _ok := _ok and (_isBuy ? _dnW >= _body : _upW >= _body)
    if useLineEnvBodyFilter
        _ok := _ok and _bRatio >= lineEnvBodyRatioMin
    if useLineEnvATRFilter
        _ok := _ok and _rng >= _atr * lineEnvAtrMinMult
    _ok

// 水平線強度: 1=Pivotのみ / 2=複数反応 / 3=前日 / 4=セッション / 5=複数ソース重合
f_lineEnvZoneStrength(_isPivot, _isPrev, _isSess, _touches) =>
    int _srcCount = (_isPivot ? 1 : 0) + (_isPrev ? 1 : 0) + (_isSess ? 1 : 0)
    _srcCount >= 2 ? 5 : _isSess ? 4 : _isPrev ? 3 : (useLineEnvReaction and _touches >= lineEnvReactionMinTouches) ? 2 : 1

// ソース種別 (1=Pivot / 2=Reaction / 3=Previous Day / 4=Session / 5=Multiple)
f_lineEnvSourceCode(_isPivot, _isPrev, _isSess, _touches) =>
    int _srcCount = (_isPivot ? 1 : 0) + (_isPrev ? 1 : 0) + (_isSess ? 1 : 0)
    _srcCount >= 2 ? 5 : _isSess ? 4 : _isPrev ? 3 : (useLineEnvReaction and _touches >= lineEnvReactionMinTouches) ? 2 : 1

// 既存ゾーンへタッチ数加重平均で統合 (index 指定)
f_lineEnvMergeZone(array<float> _zP, array<int> _zT, array<int> _zL, array<bool> _zPv, array<bool> _zPr, array<bool> _zSe, _i, _p, _srcPivot, _srcPrev, _srcSess) =>
    int _oldT = array.get(_zT, _i)
    int _newT = _oldT + 1
    array.set(_zP, _i, (array.get(_zP, _i) * _oldT + _p) / _newT)
    array.set(_zT, _i, _newT)
    array.set(_zL, _i, bar_index)
    array.set(_zPv, _i, array.get(_zPv, _i) or _srcPivot)
    array.set(_zPr, _i, array.get(_zPr, _i) or _srcPrev)
    array.set(_zSe, _i, array.get(_zSe, _i) or _srcSess)
    array.size(_zP)

// ゾーンへ追加/統合 (近接があれば統合・無ければ push。最大数超過で最古を削除)
f_lineEnvAddZone(array<float> _zP, array<int> _zT, array<int> _zCB, array<int> _zCT, array<int> _zL, array<bool> _zPv, array<bool> _zPr, array<bool> _zSe, array<int> _zRct, array<int> _zRctFirst, array<int> _zRctLast, _p, _srcPivot, _srcPrev, _srcSess, _mergeTol) =>
    int _idx = -1
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if _idx == -1 and math.abs(array.get(_zP, _i) - _p) <= _mergeTol
                _idx := _i
    if _idx >= 0
        // 統合は構造的な追加 (Pivot/前日/セッション)。反応タッチ数 (_zRct) には加算しない。
        f_lineEnvMergeZone(_zP, _zT, _zL, _zPv, _zPr, _zSe, _idx, _p, _srcPivot, _srcPrev, _srcSess)
    else
        array.push(_zP, _p)
        array.push(_zT, 1)
        array.push(_zCB, bar_index)
        array.push(_zCT, time)
        array.push(_zL, bar_index)
        array.push(_zPv, _srcPivot)
        array.push(_zPr, _srcPrev)
        array.push(_zSe, _srcSess)
        array.push(_zRct, 0)
        array.push(_zRctFirst, na)
        array.push(_zRctLast, na)
        while array.size(_zP) > lineEnvMaxZones
            array.shift(_zP)
            array.shift(_zT)
            array.shift(_zCB)
            array.shift(_zCT)
            array.shift(_zL)
            array.shift(_zPv)
            array.shift(_zPr)
            array.shift(_zSe)
            array.shift(_zRct)
            array.shift(_zRctFirst)
            array.shift(_zRctLast)
    array.size(_zP)

// セッション 高値/安値 追跡 (終了時に確定・[hi, lo, ended])
f_lineEnvSession(_sessStr, _prevHi, _prevLo) =>
    bool _inSess  = not na(time(timeframe.period, _sessStr, lineEnvSessTZ))
    bool _started = _inSess and not _inSess[1]
    bool _ended   = not _inSess and _inSess[1]
    float _hi = _prevHi
    float _lo = _prevLo
    if _started
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(_prevHi) ? high : math.max(_prevHi, high)
        _lo := na(_prevLo) ? low  : math.min(_prevLo, low)
    [_hi, _lo, _ended]

// イベント種別×強度 → 0〜5 の基礎点 (EventStrength)
f_lineEnvScore(_signalType, _strength) =>
    _signalType == 1 ? (_strength >= 3 ? 2 : 1) : _signalType == 3 ? (_strength >= 3 ? 2 : 1) : _signalType == 4 ? (_strength >= 3 ? 3 : 2) : _signalType == 2 ? (_strength >= 3 ? 3 : 2) : 0

// イベントID (同じゾーン・同じ種別・同じ方向 → 同一ID。毎バー再発火を防ぐ)
f_lineEnvEventId(_zonePrice, _signalType, _direction) =>
    na(_zonePrice) ? 0 : int(math.round(_zonePrice / syminfo.mintick)) * 100 + _signalType * 10 + (_direction == 1 ? 1 : 2)

// 各足の確定 水平線 環境状態 (呼ばれた足コンテキスト内で完結)
f_lineEnvState(int holdBars, int tfCode) =>
    float _atr = ta.atr(lineEnvAtrLen)
    float _zoneW = useLineEnvATRZone ? _atr * lineEnvZoneATRMult : lineEnvZoneFixedWidth
    float _mergeTol = useLineEnvMergeZone ? _atr * lineEnvMergeToleranceATR : _atr * lineEnvReactionToleranceATR
    // 統合ゾーン配列 (var: 呼び出しコンテキストごとに独立)
    var array<float> _zP  = array.new_float()
    var array<int>   _zT  = array.new_int()
    var array<int>   _zCB = array.new_int()
    var array<int>   _zCT = array.new_int()
    var array<int>   _zL  = array.new_int()
    var array<bool>  _zPv = array.new_bool()
    var array<bool>  _zPr = array.new_bool()
    var array<bool>  _zSe = array.new_bool()
    // 実際の価格反応 (touchCount) : Pivot/前日/セッションの追加回数とは分離して管理する。
    //   _zRct=直近クラスター内の反応バー数 / _zRctFirst=クラスター先頭バー / _zRctLast=最終反応バー。
    var array<int>   _zRct      = array.new_int()
    var array<int>   _zRctFirst = array.new_int()
    var array<int>   _zRctLast  = array.new_int()
    // ① Pivot High/Low → ゾーン (確定後のみ)
    if useLineEnvPivot or useLineEnvReaction
        float _ph = ta.pivothigh(high, lineEnvPivotLen, lineEnvPivotLen)
        float _pl = ta.pivotlow(low,  lineEnvPivotLen, lineEnvPivotLen)
        if not na(_ph)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _ph, true, false, false, _mergeTol)
        if not na(_pl)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _pl, true, false, false, _mergeTol)
    // ③ 前日 高値/安値 (確定前日値のみ)
    var float _curDayHigh = na
    var float _curDayLow  = na
    var float _prevHigh   = na
    var float _prevLow    = na
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        _prevHigh := _curDayHigh
        _prevLow  := _curDayLow
        _curDayHigh := high
        _curDayLow  := low
        if useLineEnvPreviousDayHL and not na(_prevHigh)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _prevHigh, false, true, false, _mergeTol)
        if useLineEnvPreviousDayHL and not na(_prevLow)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _prevLow, false, true, false, _mergeTol)
    else
        _curDayHigh := na(_curDayHigh) ? high : math.max(_curDayHigh, high)
        _curDayLow  := na(_curDayLow)  ? low  : math.min(_curDayLow, low)
    // ④ セッション 高値/安値 (確定後のみ)
    var float _asiaHigh   = na
    var float _asiaLow    = na
    var float _londonHigh = na
    var float _londonLow  = na
    var float _nyHigh     = na
    var float _nyLow      = na
    [_aH, _aL, _aEnd] = f_lineEnvSession(lineEnvAsiaSess, _asiaHigh, _asiaLow)
    _asiaHigh := _aH
    _asiaLow  := _aL
    [_lH, _lL, _lEnd] = f_lineEnvSession(lineEnvLondonSess, _londonHigh, _londonLow)
    _londonHigh := _lH
    _londonLow  := _lL
    [_nH, _nL, _nEnd] = f_lineEnvSession(lineEnvNySess, _nyHigh, _nyLow)
    _nyHigh := _nH
    _nyLow  := _nL
    if useLineEnvSessionHL
        if _aEnd and not na(_asiaHigh)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _asiaHigh, false, false, true, _mergeTol)
        if _aEnd and not na(_asiaLow)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _asiaLow, false, false, true, _mergeTol)
        if _lEnd and not na(_londonHigh)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _londonHigh, false, false, true, _mergeTol)
        if _lEnd and not na(_londonLow)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _londonLow, false, false, true, _mergeTol)
        if _nEnd and not na(_nyHigh)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _nyHigh, false, false, true, _mergeTol)
        if _nEnd and not na(_nyLow)
            f_lineEnvAddZone(_zP, _zT, _zCB, _zCT, _zL, _zPv, _zPr, _zSe, _zRct, _zRctFirst, _zRctLast, _nyLow, false, false, true, _mergeTol)
    // --- 実際の価格反応スキャン (このバーのみ・O(ゾーン数)。lineEnvReactionLookback 内でクラスター化) ---
    //   同じバーは最大1回。lineEnvReactionLookback より古いクラスターは先頭からリセット。
    //   Reaction OFF時は反応履歴計算を行わない (Pivot/前日/セッションの追加ではタッチ数を増やさない)。
    if useLineEnvReaction and array.size(_zP) > 0
        float _rTol = _atr * lineEnvReactionToleranceATR
        for _i = 0 to array.size(_zP) - 1
            // 失効: 最終タッチから lookback 超過で反応履歴を全リセット (新タッチが無くても古いReactionは失効)。
            int _lastR0 = array.get(_zRctLast, _i)
            if not na(_lastR0) and (bar_index - _lastR0) > lineEnvReactionLookback
                array.set(_zRct, _i, 0)
                array.set(_zRctFirst, _i, na)
                array.set(_zRctLast, _i, na)
            float _zp = array.get(_zP, _i)
            bool _touch = low <= _zp + _rTol and high >= _zp - _rTol
            if _touch
                int _lastR = array.get(_zRctLast, _i)
                if na(_lastR) or _lastR != bar_index
                    int _cntR  = array.get(_zRct, _i)
                    int _firstR = array.get(_zRctFirst, _i)
                    // 窓の先頭が lookback 外なら新起点で数え直す (クラスターの span を lookback 以内に保つ)。
                    if _cntR == 0 or na(_firstR) or (bar_index - _firstR) > lineEnvReactionLookback
                        array.set(_zRct, _i, 1)
                        array.set(_zRctFirst, _i, bar_index)
                    else
                        array.set(_zRct, _i, _cntR + 1)
                    array.set(_zRctLast, _i, bar_index)
    // --- 最近接 Support(<=close) / Resistance(>close) ---
    float _nSupP = na
    float _nResP = na
    int   _nSupStr = 0
    int   _nResStr = 0
    int   _nSupSrc = 0
    int   _nResSrc = 0
    int   _nSupCB = na
    int   _nResCB = na
    int   _nSupCT = na
    int   _nResCT = na
    int   _nSupTouch = 0
    int   _nResTouch = 0
    if array.size(_zP) > 0
        for _i = 0 to array.size(_zP) - 1
            if bar_index >= array.get(_zCB, _i)
                float _pr = array.get(_zP, _i)
                int   _rct = array.get(_zRct, _i)   // 実際の反応回数 (touchCount)
                bool  _ip = array.get(_zPv, _i)
                bool  _ipr= array.get(_zPr, _i)
                bool  _iss= array.get(_zSe, _i)
                int   _st = f_lineEnvZoneStrength(_ip, _ipr, _iss, _rct)
                int   _src = f_lineEnvSourceCode(_ip, _ipr, _iss, _rct)
                bool  _strengthOk = not useLineEnvStrengthFilter or _st >= lineEnvMinStrength
                if _strengthOk
                    if _pr <= close
                        if na(_nSupP) or _pr > _nSupP
                            _nSupP := _pr
                            _nSupStr := _st
                            _nSupSrc := _src
                            _nSupCB := array.get(_zCB, _i)
                            _nSupCT := array.get(_zCT, _i)
                            _nSupTouch := _rct
                    else
                        if na(_nResP) or _pr < _nResP
                            _nResP := _pr
                            _nResStr := _st
                            _nResSrc := _src
                            _nResCB := array.get(_zCB, _i)
                            _nResCT := array.get(_zCT, _i)
                            _nResTouch := _rct
    float _supZoneTop = _nSupP + _zoneW
    float _resZoneBot = _nResP - _zoneW
    bool _supUsable = not na(_nSupP) and not na(_nSupCB) and bar_index >= _nSupCB
    bool _resUsable = not na(_nResP) and not na(_nResCB) and bar_index >= _nResCB
    // --- A: 反発 (回復位置モード) ---
    float _buyRecover  = lineEnvBounceRecoverMode == "OuterEdge" ? _supZoneTop : _nSupP
    float _sellRecover = lineEnvBounceRecoverMode == "OuterEdge" ? _resZoneBot : _nResP
    bool _buyBounce  = useLineEnvBounce and _supUsable and low  <= _supZoneTop and close > _buyRecover  and (lineEnvBounceRecoverMode != "PreviousCloseSide" or close[1] <= _supZoneTop) and f_lineEnvCommonOK(true, _atr)
    bool _sellBounce = useLineEnvBounce and _resUsable and high >= _resZoneBot and close < _sellRecover and (lineEnvBounceRecoverMode != "PreviousCloseSide" or close[1] >= _resZoneBot) and f_lineEnvCommonOK(false, _atr)
    // --- B: レジサポ転換 (Flip) ---
    //   Flip候補は「ブレイクされた旧レジサポ」のレベルとメタ情報を保存して使う (最近接線ではない)。
    var float _flipResLevel = na
    var int   _flipResBar   = na
    var int   _flipResStr   = 0
    var int   _flipResSrc   = 0
    var int   _flipResTouch = 0
    var int   _flipResCT    = na
    var float _flipSupLevel = na
    var int   _flipSupBar   = na
    var int   _flipSupStr   = 0
    var int   _flipSupSrc   = 0
    var int   _flipSupTouch = 0
    var int   _flipSupCT    = na
    if _resUsable and not na(_nResP[1]) and close > _nResP[1] and close[1] <= _nResP[1]
        _flipResLevel := _nResP[1]
        _flipResBar   := bar_index
        _flipResStr   := _nResStr[1]
        _flipResSrc   := _nResSrc[1]
        _flipResTouch := _nResTouch[1]
        _flipResCT    := _nResCT[1]
    if _supUsable and not na(_nSupP[1]) and close < _nSupP[1] and close[1] >= _nSupP[1]
        _flipSupLevel := _nSupP[1]
        _flipSupBar   := bar_index
        _flipSupStr   := _nSupStr[1]
        _flipSupSrc   := _nSupSrc[1]
        _flipSupTouch := _nSupTouch[1]
        _flipSupCT    := _nSupCT[1]
    bool _buyFlip  = useLineEnvFlip and not na(_flipResLevel) and (bar_index - _flipResBar) >= lineEnvFlipConfirmBars and (bar_index - _flipResBar) <= lineEnvFlipLookback and low <= _flipResLevel + _zoneW and close > _flipResLevel and f_lineEnvCommonOK(true, _atr)
    bool _sellFlip = useLineEnvFlip and not na(_flipSupLevel) and (bar_index - _flipSupBar) >= lineEnvFlipConfirmBars and (bar_index - _flipSupBar) <= lineEnvFlipLookback and high >= _flipSupLevel - _zoneW and close < _flipSupLevel and f_lineEnvCommonOK(false, _atr)
    // Flip確定レベルは消費前に確保 (hitZone用)
    float _buyFlipLevel  = _buyFlip  ? _flipResLevel : na
    float _sellFlipLevel = _sellFlip ? _flipSupLevel : na
    if _buyFlip
        _flipResLevel := na
    if _sellFlip
        _flipSupLevel := na
    // --- C: ブレイク (終値で確定・バッファ・実体率・任意で方向ローソク色) ---
    bool _breakBodyOK = not useLineEnvBreakBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= lineEnvBreakBodyRatio)
    float _brkBuf = _atr * lineEnvBreakBufferATR
    bool _buyBreak  = useLineEnvBreak and _resUsable and not na(_nResP[1]) and close > _nResP[1] + _zoneW + _brkBuf and close[1] <= _nResP[1] + _zoneW + _brkBuf and _breakBodyOK and (not useLineEnvBreakCandleColor or close > open)
    bool _sellBreak = useLineEnvBreak and _supUsable and not na(_nSupP[1]) and close < _nSupP[1] - _zoneW - _brkBuf and close[1] >= _nSupP[1] - _zoneW - _brkBuf and _breakBodyOK and (not useLineEnvBreakCandleColor or close < open)
    // --- D: スイープ反転 (ゾーン外へATR指定幅以上ヒゲで貫通 → 終値はゾーン内/戻り) ---
    float _sweepTol = _atr * lineEnvSweepToleranceATR
    bool _buySweep  = useLineEnvSweep and _supUsable and (_nSupP - low)  >= _sweepTol and low < _nSupP - _zoneW and close > _nSupP - _zoneW and close >= open and f_lineEnvCommonOK(true, _atr)
    bool _sellSweep = useLineEnvSweep and _resUsable and (high - _nResP) >= _sweepTol and high > _nResP + _zoneW and close < _nResP + _zoneW and close <= open and f_lineEnvCommonOK(false, _atr)
    // --- 種別 (優先順位 Sweep > Break > Flip > Bounce) ---
    int _longType  = _buySweep  ? 4 : _buyBreak  ? 3 : _buyFlip  ? 2 : _buyBounce  ? 1 : 0
    int _shortType = _sellSweep ? 4 : _sellBreak ? 3 : _sellFlip ? 2 : _sellBounce ? 1 : 0
    bool _longEvent  = _longType  != 0
    bool _shortEvent = _shortType != 0
    // イベント種別に対応した方向別強度 (HigherStrength競合用)。
    //   Long : Bounce/Sweep→Support / Break→突破Resistance(前バー) / Flip→旧Resistance候補。
    //   Short: Bounce/Sweep→Resistance / Break→突破Support(前バー) / Flip→旧Support候補。
    int _longStr  = _longType  == 3 ? _nResStr[1] : _longType  == 2 ? _flipResStr : _nSupStr
    int _shortStr = _shortType == 3 ? _nSupStr[1] : _shortType == 2 ? _flipSupStr : _nResStr
    // --- 両方向同時成立の解決 ---
    bool _conflict = false
    int _dirNow = 0
    if _longEvent and _shortEvent
        if lineEnvConflictMode == "HigherStrength"
            _dirNow := _longStr > _shortStr ? 1 : _shortStr > _longStr ? -1 : 0
            _conflict := _dirNow == 0
        else if lineEnvConflictMode == "HigherPriority"
            _dirNow := _longType > _shortType ? 1 : _shortType > _longType ? -1 : 0
            _conflict := _dirNow == 0
        else
            _conflict := true
            _dirNow := 0
    else if _longEvent
        _dirNow := 1
    else if _shortEvent
        _dirNow := -1
    // --- 選択方向の種別 ---
    int _signalType = _dirNow == 1 ? _longType : _dirNow == -1 ? _shortType : math.max(_longType, _shortType)
    // --- イベント種別ごとに正しいゾーン側を使う ---
    //   Long : Bounce(1)/Sweep(4)→Support / Flip(2)→旧Resistance候補 / Break(3)→上抜けたResistance(前バー)
    //   Short: Bounce(1)/Sweep(4)→Resistance / Flip(2)→旧Support候補 / Break(3)→下抜けたSupport(前バー)
    float _hitZoneP = na
    int   _hitZoneT = na
    int   _hitStr   = 0
    int   _hitSrc   = 0
    int   _hitTouch = 0
    if _dirNow == 1
        if _signalType == 1 or _signalType == 4
            _hitZoneP := _nSupP
            _hitZoneT := _nSupCT
            _hitStr   := _nSupStr
            _hitSrc   := _nSupSrc
            _hitTouch := _nSupTouch
        else if _signalType == 3
            _hitZoneP := _nResP[1]
            _hitZoneT := _nResCT[1]
            _hitStr   := _nResStr[1]
            _hitSrc   := _nResSrc[1]
            _hitTouch := _nResTouch[1]
        else if _signalType == 2
            _hitZoneP := _buyFlipLevel
            _hitZoneT := _flipResCT
            _hitStr   := _flipResStr
            _hitSrc   := _flipResSrc
            _hitTouch := _flipResTouch
    else if _dirNow == -1
        if _signalType == 1 or _signalType == 4
            _hitZoneP := _nResP
            _hitZoneT := _nResCT
            _hitStr   := _nResStr
            _hitSrc   := _nResSrc
            _hitTouch := _nResTouch
        else if _signalType == 3
            _hitZoneP := _nSupP[1]
            _hitZoneT := _nSupCT[1]
            _hitStr   := _nSupStr[1]
            _hitSrc   := _nSupSrc[1]
            _hitTouch := _nSupTouch[1]
        else if _signalType == 2
            _hitZoneP := _sellFlipLevel
            _hitZoneT := _flipSupCT
            _hitStr   := _flipSupStr
            _hitSrc   := _flipSupSrc
            _hitTouch := _flipSupTouch
    int _strength = _hitStr
    int _source   = _hitSrc
    int _touchCnt = _hitTouch
    // --- スコア (BinaryBias / EventStrength) ---
    int _rawScore = lineEnvScoringMode == "BinaryBias" ? 1 : f_lineEnvScore(_signalType, _strength)
    // --- 状態保持 / イベント再アーム (direction × signalType × zoneId をキーに管理) ---
    //   発火した (dir, type, zone) を「解除中キー」配列へ登録。同じキーが登録済みの間は再発火禁止。
    //   別ゾーンの同種イベントは別キーなので独立発火可能。反対方向イベントも別キーで即時上書き可能。
    //   再アーム = 元イベント条件が一度解除(false)された後 に、ゾーン離脱 (ATR) / 本数経過 を満たしたとき。
    //   → 接触/反応継続中は再アームしない。holdBars 切れだけでも再アームしない。
    var int _evBar = na
    var int _evDir = 0
    var int _evScore = 0
    var int _evReason = 0
    var int _evSignal = 0
    var int _evStrength = 0
    var int _evSource = 0
    var float _evHitP = na
    var int _evHitT = na
    var int _evTouch = 0
    var int _lastEventId = na
    // 解除中イベントキー配列 (dir/type/zoneId/zonePrice/fireBar/conditionReleased)。最大保持数で古いキーを削除。
    var array<int>   _dkDir  = array.new_int()
    var array<int>   _dkType = array.new_int()
    var array<int>   _dkZone = array.new_int()
    var array<float> _dkZoneP = array.new_float()
    var array<int>   _dkBar  = array.new_int()
    var array<bool>  _dkRel  = array.new_bool()
    int _maxKeys = 32
    bool _wouldFire = (_longEvent or _shortEvent) and not _conflict and _dirNow != 0 and _signalType != 0 and not na(_hitZoneP)
    int _zoneId = not na(_hitZoneP) ? int(math.round(_hitZoneP / syminfo.mintick)) : na
    // 再アーム & 条件解除の更新 (解除中キーを後方から走査)
    if array.size(_dkDir) > 0
        int _j = array.size(_dkDir) - 1
        while _j >= 0
            int   _kd  = array.get(_dkDir, _j)
            int   _kt  = array.get(_dkType, _j)
            int   _kz  = array.get(_dkZone, _j)
            float _kzp = array.get(_dkZoneP, _j)
            int   _kb  = array.get(_dkBar, _j)
            bool  _krel = array.get(_dkRel, _j)
            // 同一キー (dir/type/zone) のイベント条件が このバーも継続しているか
            bool _activeSame = _wouldFire and _dirNow == _kd and _signalType == _kt and not na(_zoneId) and _zoneId == _kz
            if not _activeSame
                _krel := true
                array.set(_dkRel, _j, true)
            bool _leftZone = not na(_kzp) and math.abs(close - _kzp) >= _atr * lineEnvEventRearmATR
            bool _barsOk   = not na(_kb) and (bar_index - _kb) >= lineEnvEventRearmBars
            bool _rearm = _krel and (lineEnvEventRearmMode == "LeaveZone" ? _leftZone : lineEnvEventRearmMode == "Bars" ? _barsOk : (_leftZone or _barsOk))
            if _rearm
                array.remove(_dkDir, _j)
                array.remove(_dkType, _j)
                array.remove(_dkZone, _j)
                array.remove(_dkZoneP, _j)
                array.remove(_dkBar, _j)
                array.remove(_dkRel, _j)
            _j := _j - 1
    // 発火判定: 解除中キーに同一 (dir, type, zone) が無ければ発火
    bool _keyDisarmed = false
    if _wouldFire and array.size(_dkDir) > 0
        for _j = 0 to array.size(_dkDir) - 1
            if not _keyDisarmed and array.get(_dkDir, _j) == _dirNow and array.get(_dkType, _j) == _signalType and array.get(_dkZone, _j) == _zoneId
                _keyDisarmed := true
    bool _fire = _wouldFire and not _keyDisarmed
    if _fire
        array.push(_dkDir, _dirNow)
        array.push(_dkType, _signalType)
        array.push(_dkZone, _zoneId)
        array.push(_dkZoneP, _hitZoneP)
        array.push(_dkBar, bar_index)
        array.push(_dkRel, false)
        while array.size(_dkDir) > _maxKeys
            array.shift(_dkDir)
            array.shift(_dkType)
            array.shift(_dkZone)
            array.shift(_dkZoneP)
            array.shift(_dkBar)
            array.shift(_dkRel)
        _evBar := bar_index
        _evDir := _dirNow
        _evScore := _rawScore
        _evReason := _dirNow == 1 ? _signalType : -_signalType
        _evSignal := _signalType
        _evStrength := _strength
        _evSource := _source
        _evHitP := _hitZoneP
        _evHitT := _hitZoneT
        _evTouch := _touchCnt
        _lastEventId := f_lineEnvEventId(_hitZoneP, _signalType, _dirNow)
    bool _hold = not na(_evBar) and (bar_index - _evBar) < holdBars
    int _bias = _conflict ? 0 : (_hold ? _evDir : 0)
    int _remain = _bias != 0 ? holdBars - (bar_index - _evBar) : 0
    int _reason = _conflict ? 5 : (_bias != 0 ? _evReason : 0)
    int _outSignal = _bias != 0 ? _evSignal : (_conflict ? math.max(_longType, _shortType) : 0)
    int _outStrength = _bias != 0 ? _evStrength : _strength
    int _outSource = _bias != 0 ? _evSource : _source
    float _outHitP = _bias != 0 ? _evHitP : na
    int _outHitT = _bias != 0 ? _evHitT : na
    int _outTouch = _bias != 0 ? _evTouch : _touchCnt
    int _longScore  = _bias == 1 ? _evScore : 0
    int _shortScore = _bias == -1 ? _evScore : 0
    // --- 障害物 NoTrade (近すぎる反対側レジサポ。反対方向 bias にはしない) ---
    bool _obsAbove = not na(_nResP) and (_nResP - close) <= _atr * lineEnvObstacleATR
    bool _obsBelow = not na(_nSupP) and (close - _nSupP) <= _atr * lineEnvObstacleATR
    bool _noTradeLong  = useLineEnvObstacleFilter and _obsAbove
    bool _noTradeShort = useLineEnvObstacleFilter and _obsBelow
    int _outEventId = _bias != 0 ? _lastEventId : 0
    [_bias, _reason, _remain, _longScore, _shortScore, _outSignal, _outStrength, _outSource, tfCode, _nSupP, _nResP, _outHitP, _zoneW, _outTouch, _noTradeLong, _noTradeShort, _longEvent, _shortEvent, _conflict, _outEventId, _nSupCT, _nResCT, _outHitT]

// 確定済み1本前を上位足コンテキスト内で返す非リペイント補助 (lookahead_on + [1])。
f_lineEnvConfirmed(int holdBars, int tfCode) =>
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = f_lineEnvState(holdBars, tfCode)
    [_b[1], _rs[1], _rem[1], _ls[1], _ss[1], _st[1], _str[1], _src[1], _tf[1], _nsup[1], _nres[1], _hzp[1], _zw[1], _tc[1], _ntl[1], _nts[1], _le[1], _se[1], _cf[1], _eid[1], _spt[1], _rst[1], _hzt[1]]

// --- テキスト / カラー ---
f_lineEnvBiasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_lineEnvReasonText(int c) =>
    c == 1 ? "Bounce Long" : c == -1 ? "Bounce Short" : c == 2 ? "Flip Long" : c == -2 ? "Flip Short" : c == 3 ? "Break Long" : c == -3 ? "Break Short" : c == 4 ? "Sweep Long" : c == -4 ? "Sweep Short" : c == 5 ? "Conflict" : "None"
f_lineEnvSourceText(int s) =>
    s == 1 ? "Pivot" : s == 2 ? "Reaction" : s == 3 ? "Prev Day" : s == 4 ? "Session" : s == 5 ? "Mixed" : "-"
f_lineEnvBiasColor(int b, bool on) =>
    not on ? color.new(color.black, 0) : b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- 各足の確定 水平線 環境状態 (使用 or 表示時のみ算出。OFF足は request.security を呼ばない) ---
bool lineEnvWantDraw = lineEnvShowZones or lineEnvShowLabels
bool lineEnvCompute  = useLineEnvEnv and (useLineEnvBias or lineEnvShowTable or lineEnvWantDraw)

// --- 各足 bias / longScore / shortScore / 表示値 ---
int   lineEnvBiasD   = 0
int   lineEnvBias4H  = 0
int   lineEnvBias1H  = 0
int   lineEnvBias15M = 0
int   lineEnvBias5M  = 0
int   lineEnvBias1M  = 0
int   lineEnvReasonD   = 0
int   lineEnvReason4H  = 0
int   lineEnvReason1H  = 0
int   lineEnvReason15M = 0
int   lineEnvReason5M  = 0
int   lineEnvReason1M  = 0
int   lineEnvRemD   = 0
int   lineEnvRem4H  = 0
int   lineEnvRem1H  = 0
int   lineEnvRem15M = 0
int   lineEnvRem5M  = 0
int   lineEnvRem1M  = 0
int   lineEnvLongD   = 0
int   lineEnvLong4H  = 0
int   lineEnvLong1H  = 0
int   lineEnvLong15M = 0
int   lineEnvLong5M  = 0
int   lineEnvLong1M  = 0
int   lineEnvShortD   = 0
int   lineEnvShort4H  = 0
int   lineEnvShort1H  = 0
int   lineEnvShort15M = 0
int   lineEnvShort5M  = 0
int   lineEnvShort1M  = 0
int   lineEnvStrengthD   = 0
int   lineEnvStrength4H  = 0
int   lineEnvStrength1H  = 0
int   lineEnvStrength15M = 0
int   lineEnvStrength5M  = 0
int   lineEnvStrength1M  = 0
int   lineEnvSourceD   = 0
int   lineEnvSource4H  = 0
int   lineEnvSource1H  = 0
int   lineEnvSource15M = 0
int   lineEnvSource5M  = 0
int   lineEnvSource1M  = 0
float lineEnvHitPD   = na
float lineEnvHitP4H  = na
float lineEnvHitP1H  = na
float lineEnvHitP15M = na
float lineEnvHitP5M  = na
float lineEnvHitP1M  = na
bool  lineEnvNTLongD   = false
bool  lineEnvNTLong4H  = false
bool  lineEnvNTLong1H  = false
bool  lineEnvNTLong15M = false
bool  lineEnvNTLong5M  = false
bool  lineEnvNTLong1M  = false
bool  lineEnvNTShortD   = false
bool  lineEnvNTShort4H  = false
bool  lineEnvNTShort1H  = false
bool  lineEnvNTShort15M = false
bool  lineEnvNTShort5M  = false
bool  lineEnvNTShort1M  = false

// --- ラベル描画 / デバッグ用 (lineEnvLabelTF の足の値) ---
int   lineLblBias = 0
int   lineLblReason = 0
int   lineLblSignal = 0
int   lineLblStrength = 0
int   lineLblSource = 0
float lineLblNearestSup = na
float lineLblNearestRes = na
float lineLblHitP = na
float lineLblZoneW = na
int   lineLblTouch = 0
int   lineLblSupT = na
int   lineLblResT = na
bool  lineLblConflict = false
bool  lineLblNTLong = false
bool  lineLblNTShort = false

if lineEnvCompute and useLineEnvD
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = request.security(syminfo.tickerid, lineEnvDailyTF, f_lineEnvConfirmed(lineEnvHoldDaily, 4), lookahead = barmerge.lookahead_on)
    lineEnvBiasD := _b
    lineEnvReasonD := _rs
    lineEnvRemD := _rem
    lineEnvLongD := _ls
    lineEnvShortD := _ss
    lineEnvStrengthD := _str
    lineEnvSourceD := _src
    lineEnvHitPD := _hzp
    lineEnvNTLongD := _ntl
    lineEnvNTShortD := _nts
    if lineEnvLabelTF == "D"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts
if lineEnvCompute and useLineEnv4H
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = request.security(syminfo.tickerid, lineEnv4HTF, f_lineEnvConfirmed(lineEnvHold4H, 3), lookahead = barmerge.lookahead_on)
    lineEnvBias4H := _b
    lineEnvReason4H := _rs
    lineEnvRem4H := _rem
    lineEnvLong4H := _ls
    lineEnvShort4H := _ss
    lineEnvStrength4H := _str
    lineEnvSource4H := _src
    lineEnvHitP4H := _hzp
    lineEnvNTLong4H := _ntl
    lineEnvNTShort4H := _nts
    if lineEnvLabelTF == "4H"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts
if lineEnvCompute and useLineEnv1H
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = request.security(syminfo.tickerid, lineEnv1HTF, f_lineEnvConfirmed(lineEnvHold1H, 2), lookahead = barmerge.lookahead_on)
    lineEnvBias1H := _b
    lineEnvReason1H := _rs
    lineEnvRem1H := _rem
    lineEnvLong1H := _ls
    lineEnvShort1H := _ss
    lineEnvStrength1H := _str
    lineEnvSource1H := _src
    lineEnvHitP1H := _hzp
    lineEnvNTLong1H := _ntl
    lineEnvNTShort1H := _nts
    if lineEnvLabelTF == "1H"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts
if lineEnvCompute and useLineEnv15M
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = request.security(syminfo.tickerid, lineEnv15MTF, f_lineEnvConfirmed(lineEnvHold15M, 1), lookahead = barmerge.lookahead_on)
    lineEnvBias15M := _b
    lineEnvReason15M := _rs
    lineEnvRem15M := _rem
    lineEnvLong15M := _ls
    lineEnvShort15M := _ss
    lineEnvStrength15M := _str
    lineEnvSource15M := _src
    lineEnvHitP15M := _hzp
    lineEnvNTLong15M := _ntl
    lineEnvNTShort15M := _nts
    if lineEnvLabelTF == "15M"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts
if lineEnvCompute and useLineEnv5M
    // 5分足はチャート足そのもの → request.security / f_lineEnvConfirmed / [1] を使わず
    //   f_lineEnvState をチャート上で直接計算する。最終エントリーの barstate.isconfirmed で
    //   「確定した現在の5分足」の状態を採用するため、1本余計に遅れない。
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = f_lineEnvState(lineEnvHold5M, 0)
    lineEnvBias5M := _b
    lineEnvReason5M := _rs
    lineEnvRem5M := _rem
    lineEnvLong5M := _ls
    lineEnvShort5M := _ss
    lineEnvStrength5M := _str
    lineEnvSource5M := _src
    lineEnvHitP5M := _hzp
    lineEnvNTLong5M := _ntl
    lineEnvNTShort5M := _nts
    if lineEnvLabelTF == "5M"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts
if lineEnvCompute and useLineEnv1M
    [_b, _rs, _rem, _ls, _ss, _st, _str, _src, _tf, _nsup, _nres, _hzp, _zw, _tc, _ntl, _nts, _le, _se, _cf, _eid, _spt, _rst, _hzt] = request.security(syminfo.tickerid, lineEnv1MTF, f_lineEnvConfirmed(lineEnvHold1M, 5), lookahead = barmerge.lookahead_on)
    lineEnvBias1M := _b
    lineEnvReason1M := _rs
    lineEnvRem1M := _rem
    lineEnvLong1M := _ls
    lineEnvShort1M := _ss
    lineEnvStrength1M := _str
    lineEnvSource1M := _src
    lineEnvHitP1M := _hzp
    lineEnvNTLong1M := _ntl
    lineEnvNTShort1M := _nts
    if lineEnvLabelTF == "1M"
        lineLblBias := _b
        lineLblReason := _rs
        lineLblSignal := _st
        lineLblStrength := _str
        lineLblSource := _src
        lineLblNearestSup := _nsup
        lineLblNearestRes := _nres
        lineLblHitP := _hzp
        lineLblZoneW := _zw
        lineLblTouch := _tc
        lineLblSupT := _spt
        lineLblResT := _rst
        lineLblConflict := _cf
        lineLblNTLong := _ntl
        lineLblNTShort := _nts

// --- MTF統合 : Long基礎点×重み / Short基礎点×重み を合算 (OFF足・重み0足は完全除外) ---
int lineEnvWLongD   = useLineEnvD   ? lineEnvWeightD   * lineEnvLongD   : 0
int lineEnvWLong4H  = useLineEnv4H  ? lineEnvWeight4H  * lineEnvLong4H  : 0
int lineEnvWLong1H  = useLineEnv1H  ? lineEnvWeight1H  * lineEnvLong1H  : 0
int lineEnvWLong15M = useLineEnv15M ? lineEnvWeight15M * lineEnvLong15M : 0
int lineEnvWLong5M  = useLineEnv5M  ? lineEnvWeight5M  * lineEnvLong5M  : 0
int lineEnvWLong1M  = useLineEnv1M  ? lineEnvWeight1M  * lineEnvLong1M  : 0
int lineEnvWShortD   = useLineEnvD   ? lineEnvWeightD   * lineEnvShortD   : 0
int lineEnvWShort4H  = useLineEnv4H  ? lineEnvWeight4H  * lineEnvShort4H  : 0
int lineEnvWShort1H  = useLineEnv1H  ? lineEnvWeight1H  * lineEnvShort1H  : 0
int lineEnvWShort15M = useLineEnv15M ? lineEnvWeight15M * lineEnvShort15M : 0
int lineEnvWShort5M  = useLineEnv5M  ? lineEnvWeight5M  * lineEnvShort5M  : 0
int lineEnvWShort1M  = useLineEnv1M  ? lineEnvWeight1M  * lineEnvShort1M  : 0
int lineEnvLongTotal  = lineEnvWLongD + lineEnvWLong4H + lineEnvWLong1H + lineEnvWLong15M + lineEnvWLong5M + lineEnvWLong1M
int lineEnvShortTotal = lineEnvWShortD + lineEnvWShort4H + lineEnvWShort1H + lineEnvWShort15M + lineEnvWShort5M + lineEnvWShort1M
int lineEnvNetScore   = lineEnvLongTotal - lineEnvShortTotal
int lineEnvWeighted   = lineEnvNetScore >= lineEnvScoreThreshold ? 1 : lineEnvNetScore <= -lineEnvScoreThreshold ? -1 : 0

// --- 障害物 MTF統合 (AnyTF / Weighted / SelectedTFOnly) ---
bool lineEnvObsLongAny = (useLineEnvD and lineEnvNTLongD) or (useLineEnv4H and lineEnvNTLong4H) or (useLineEnv1H and lineEnvNTLong1H) or (useLineEnv15M and lineEnvNTLong15M) or (useLineEnv5M and lineEnvNTLong5M) or (useLineEnv1M and lineEnvNTLong1M)
bool lineEnvObsShortAny = (useLineEnvD and lineEnvNTShortD) or (useLineEnv4H and lineEnvNTShort4H) or (useLineEnv1H and lineEnvNTShort1H) or (useLineEnv15M and lineEnvNTShort15M) or (useLineEnv5M and lineEnvNTShort5M) or (useLineEnv1M and lineEnvNTShort1M)
int lineEnvObsLongW = (useLineEnvD and lineEnvNTLongD ? lineEnvWeightD : 0) + (useLineEnv4H and lineEnvNTLong4H ? lineEnvWeight4H : 0) + (useLineEnv1H and lineEnvNTLong1H ? lineEnvWeight1H : 0) + (useLineEnv15M and lineEnvNTLong15M ? lineEnvWeight15M : 0) + (useLineEnv5M and lineEnvNTLong5M ? lineEnvWeight5M : 0) + (useLineEnv1M and lineEnvNTLong1M ? lineEnvWeight1M : 0)
int lineEnvObsShortW = (useLineEnvD and lineEnvNTShortD ? lineEnvWeightD : 0) + (useLineEnv4H and lineEnvNTShort4H ? lineEnvWeight4H : 0) + (useLineEnv1H and lineEnvNTShort1H ? lineEnvWeight1H : 0) + (useLineEnv15M and lineEnvNTShort15M ? lineEnvWeight15M : 0) + (useLineEnv5M and lineEnvNTShort5M ? lineEnvWeight5M : 0) + (useLineEnv1M and lineEnvNTShort1M ? lineEnvWeight1M : 0)
bool lineEnvObsLongSel = lineEnvObstacleSelectedTF == "D" ? (useLineEnvD and lineEnvNTLongD) : lineEnvObstacleSelectedTF == "4H" ? (useLineEnv4H and lineEnvNTLong4H) : lineEnvObstacleSelectedTF == "1H" ? (useLineEnv1H and lineEnvNTLong1H) : lineEnvObstacleSelectedTF == "15M" ? (useLineEnv15M and lineEnvNTLong15M) : lineEnvObstacleSelectedTF == "5M" ? (useLineEnv5M and lineEnvNTLong5M) : (useLineEnv1M and lineEnvNTLong1M)
bool lineEnvObsShortSel = lineEnvObstacleSelectedTF == "D" ? (useLineEnvD and lineEnvNTShortD) : lineEnvObstacleSelectedTF == "4H" ? (useLineEnv4H and lineEnvNTShort4H) : lineEnvObstacleSelectedTF == "1H" ? (useLineEnv1H and lineEnvNTShort1H) : lineEnvObstacleSelectedTF == "15M" ? (useLineEnv15M and lineEnvNTShort15M) : lineEnvObstacleSelectedTF == "5M" ? (useLineEnv5M and lineEnvNTShort5M) : (useLineEnv1M and lineEnvNTShort1M)
bool lineEnvNoTradeLong  = useLineEnvObstacleFilter and (lineEnvObstacleCombineMode == "Weighted" ? lineEnvObsLongW >= lineEnvObstacleWeightThresh : lineEnvObstacleCombineMode == "SelectedTFOnly" ? lineEnvObsLongSel : lineEnvObsLongAny)
bool lineEnvNoTradeShort = useLineEnvObstacleFilter and (lineEnvObstacleCombineMode == "Weighted" ? lineEnvObsShortW >= lineEnvObstacleWeightThresh : lineEnvObstacleCombineMode == "SelectedTFOnly" ? lineEnvObsShortSel : lineEnvObsShortAny)

// HigherTF: 上位足優先で「有効スコア方向」が最初に見つかった足を採用 (障害物NoTrade方向は不許可)
int lineEnvSignD   = lineEnvLongD   > 0 ? 1 : lineEnvShortD   > 0 ? -1 : 0
int lineEnvSign4H  = lineEnvLong4H  > 0 ? 1 : lineEnvShort4H  > 0 ? -1 : 0
int lineEnvSign1H  = lineEnvLong1H  > 0 ? 1 : lineEnvShort1H  > 0 ? -1 : 0
int lineEnvSign15M = lineEnvLong15M > 0 ? 1 : lineEnvShort15M > 0 ? -1 : 0
int lineEnvSign5M  = lineEnvLong5M  > 0 ? 1 : lineEnvShort5M  > 0 ? -1 : 0
int lineEnvSign1M  = lineEnvLong1M  > 0 ? 1 : lineEnvShort1M  > 0 ? -1 : 0
int lineEnvHigherTF =
     (useLineEnvD   and lineEnvSignD   != 0) ? lineEnvSignD   :
     (useLineEnv4H  and lineEnvSign4H  != 0) ? lineEnvSign4H  :
     (useLineEnv1H  and lineEnvSign1H  != 0) ? lineEnvSign1H  :
     (useLineEnv15M and lineEnvSign15M != 0) ? lineEnvSign15M :
     (useLineEnv5M  and lineEnvSign5M  != 0) ? lineEnvSign5M  :
     (useLineEnv1M  and lineEnvSign1M  != 0) ? lineEnvSign1M  : 0
int lineEnvBiasRaw = not useLineEnvEnv ? 0 : lineEnvCombineMode == "HigherTF" ? lineEnvHigherTF : lineEnvWeighted
// HigherTFでも障害物NoTrade方向は許可しない (Even化)
int lineEnvBias = lineEnvBiasRaw
if lineEnvBias == 1 and lineEnvNoTradeLong
    lineEnvBias := 0
if lineEnvBias == -1 and lineEnvNoTradeShort
    lineEnvBias := 0

// --- トレンド環境 (EMAスコア) と 水平線環境 の結合 (方向別に明示) ---
//   useLineEnvBias=OFF or useLineEnvEnv=OFF → 完全素通し (既存=トレンドのみ)。
//   TrendOnly    : Long=trendLongOk       / Short=trendShortOk
//   LineOnly     : Long=lineLong          / Short=lineShort
//   TrendAndLine : Long=trendLongOk and lineLong  / Short=trendShortOk and lineShort
//   TrendOrLine  : Long=trendLongOk or  lineLong  / Short=trendShortOk or  lineShort
//   障害物NoTradeが成立した方向は、結合結果から必ず除外する (反対方向 bias にはしない)。
bool lineEnvActive = useLineEnvEnv and useLineEnvBias
bool lineLong  = lineEnvBias == 1
bool lineShort = lineEnvBias == -1
bool finalEnvLongOk0 =
     not lineEnvActive ? trendLongOk :
     lineEnvTrendCombineMode == "TrendOnly"    ? trendLongOk :
     lineEnvTrendCombineMode == "LineOnly"     ? lineLong :
     lineEnvTrendCombineMode == "TrendAndLine" ? (trendLongOk and lineLong) :
     lineEnvTrendCombineMode == "TrendOrLine"  ? (trendLongOk or lineLong) :
     trendLongOk
bool finalEnvShortOk0 =
     not lineEnvActive ? trendShortOk :
     lineEnvTrendCombineMode == "TrendOnly"    ? trendShortOk :
     lineEnvTrendCombineMode == "LineOnly"     ? lineShort :
     lineEnvTrendCombineMode == "TrendAndLine" ? (trendShortOk and lineShort) :
     lineEnvTrendCombineMode == "TrendOrLine"  ? (trendShortOk or lineShort) :
     trendShortOk
bool finalEnvLongOk  = finalEnvLongOk0  and not (lineEnvActive and lineEnvNoTradeLong)
bool finalEnvShortOk = finalEnvShortOk0 and not (lineEnvActive and lineEnvNoTradeShort)



// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ============================================================
//  10c. 最終エントリー条件 (環境認識 = トレンド + 水平線)
// ------------------------------------------------------------
//  環境認識は finalEnvLongOk/finalEnvShortOk (EMAトレンド + 水平線 の結合結果)。
//  FVG / EMA / Stochastic / Volume / 三尊 / DT/DB / ウェッジ / トライアングル / エリオット / フィボナッチ の各環境認識は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。水平線方向フィルターは主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    if noTriggerMode
        longArmed := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    if noTriggerMode
        shortArmed := false

// ============================================================
// ============================================================
//  12d. 水平線 環境認識 表示 (テーブル + レジサポ描画 + Data Window)
// ============================================================
f_lineRowBias(bool _on, int _b) =>
    _on ? f_lineEnvBiasText(_b) : "OFF"
f_lineRowReason(bool _on, int _r) =>
    _on ? f_lineEnvReasonText(_r) : "OFF"
f_lineRowSource(bool _on, int _s) =>
    _on ? f_lineEnvSourceText(_s) : "OFF"
f_lineRowInt(bool _on, int _v) =>
    _on ? str.tostring(_v) : "-"
f_lineRowPrice(bool _on, float _p) =>
    _on and not na(_p) ? str.tostring(_p, "#.####") : "-"
f_lineScoreMax(bool _on, int _l, int _s) =>
    _on ? str.tostring(math.max(_l, _s)) : "-"

var table lineEnvTbl = na
if lineEnvShowTable
    if na(lineEnvTbl)
        lineEnvTbl := table.new(position.bottom_left, 8, 26, border_width = 1)
    if barstate.islast
        table.cell(lineEnvTbl, 0, 0, "Line",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 1, 0, "Bias",     text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 2, 0, "Reason",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 3, 0, "残",       text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 4, 0, "Score",    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 5, 0, "Str",      text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 6, 0, "Source",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(lineEnvTbl, 7, 0, "Hit",      text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        // D
        table.cell(lineEnvTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 1, f_lineRowBias(useLineEnvD, lineEnvBiasD), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBiasD, useLineEnvD), text_size = size.small)
        table.cell(lineEnvTbl, 2, 1, f_lineRowReason(useLineEnvD, lineEnvReasonD), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 1, f_lineRowInt(useLineEnvD, lineEnvRemD), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 1, f_lineScoreMax(useLineEnvD, lineEnvLongD, lineEnvShortD), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 1, f_lineRowInt(useLineEnvD, lineEnvStrengthD), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 1, f_lineRowSource(useLineEnvD, lineEnvSourceD), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 1, f_lineRowPrice(useLineEnvD, lineEnvHitPD), text_color = color.white, text_size = size.small)
        // 4H
        table.cell(lineEnvTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 2, f_lineRowBias(useLineEnv4H, lineEnvBias4H), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias4H, useLineEnv4H), text_size = size.small)
        table.cell(lineEnvTbl, 2, 2, f_lineRowReason(useLineEnv4H, lineEnvReason4H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 2, f_lineRowInt(useLineEnv4H, lineEnvRem4H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 2, f_lineScoreMax(useLineEnv4H, lineEnvLong4H, lineEnvShort4H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 2, f_lineRowInt(useLineEnv4H, lineEnvStrength4H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 2, f_lineRowSource(useLineEnv4H, lineEnvSource4H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 2, f_lineRowPrice(useLineEnv4H, lineEnvHitP4H), text_color = color.white, text_size = size.small)
        // 1H
        table.cell(lineEnvTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 3, f_lineRowBias(useLineEnv1H, lineEnvBias1H), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias1H, useLineEnv1H), text_size = size.small)
        table.cell(lineEnvTbl, 2, 3, f_lineRowReason(useLineEnv1H, lineEnvReason1H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 3, f_lineRowInt(useLineEnv1H, lineEnvRem1H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 3, f_lineScoreMax(useLineEnv1H, lineEnvLong1H, lineEnvShort1H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 3, f_lineRowInt(useLineEnv1H, lineEnvStrength1H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 3, f_lineRowSource(useLineEnv1H, lineEnvSource1H), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 3, f_lineRowPrice(useLineEnv1H, lineEnvHitP1H), text_color = color.white, text_size = size.small)
        // 15M
        table.cell(lineEnvTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 4, f_lineRowBias(useLineEnv15M, lineEnvBias15M), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias15M, useLineEnv15M), text_size = size.small)
        table.cell(lineEnvTbl, 2, 4, f_lineRowReason(useLineEnv15M, lineEnvReason15M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 4, f_lineRowInt(useLineEnv15M, lineEnvRem15M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 4, f_lineScoreMax(useLineEnv15M, lineEnvLong15M, lineEnvShort15M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 4, f_lineRowInt(useLineEnv15M, lineEnvStrength15M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 4, f_lineRowSource(useLineEnv15M, lineEnvSource15M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 4, f_lineRowPrice(useLineEnv15M, lineEnvHitP15M), text_color = color.white, text_size = size.small)
        // 5M
        table.cell(lineEnvTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 5, f_lineRowBias(useLineEnv5M, lineEnvBias5M), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias5M, useLineEnv5M), text_size = size.small)
        table.cell(lineEnvTbl, 2, 5, f_lineRowReason(useLineEnv5M, lineEnvReason5M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 5, f_lineRowInt(useLineEnv5M, lineEnvRem5M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 5, f_lineScoreMax(useLineEnv5M, lineEnvLong5M, lineEnvShort5M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 5, f_lineRowInt(useLineEnv5M, lineEnvStrength5M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 5, f_lineRowSource(useLineEnv5M, lineEnvSource5M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 5, f_lineRowPrice(useLineEnv5M, lineEnvHitP5M), text_color = color.white, text_size = size.small)
        // 1M
        table.cell(lineEnvTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 6, f_lineRowBias(useLineEnv1M, lineEnvBias1M), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias1M, useLineEnv1M), text_size = size.small)
        table.cell(lineEnvTbl, 2, 6, f_lineRowReason(useLineEnv1M, lineEnvReason1M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 6, f_lineRowInt(useLineEnv1M, lineEnvRem1M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 6, f_lineScoreMax(useLineEnv1M, lineEnvLong1M, lineEnvShort1M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 6, f_lineRowInt(useLineEnv1M, lineEnvStrength1M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 6, f_lineRowSource(useLineEnv1M, lineEnvSource1M), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 6, f_lineRowPrice(useLineEnv1M, lineEnvHitP1M), text_color = color.white, text_size = size.small)
        // Combined Bias / Totals
        table.cell(lineEnvTbl, 0, 7, "COMBINED", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 7, f_lineEnvBiasText(lineEnvBias), text_color = color.white, bgcolor = f_lineEnvBiasColor(lineEnvBias, useLineEnvEnv), text_size = size.small)
        table.cell(lineEnvTbl, 2, 7, "Net", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 7, str.tostring(lineEnvNetScore), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 7, "L/S Tot", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 7, str.tostring(lineEnvLongTotal), text_color = color.white, bgcolor = color.new(color.green, 70), text_size = size.small)
        table.cell(lineEnvTbl, 6, 7, str.tostring(lineEnvShortTotal), text_color = color.white, bgcolor = color.new(color.red, 70), text_size = size.small)
        table.cell(lineEnvTbl, 7, 7, "", text_color = color.white, text_size = size.small)
        // Combine Mode / Trend Combine
        table.cell(lineEnvTbl, 0, 8, "Combine", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 8, lineEnvCombineMode == "HigherTF" ? "HTF" : "WScore", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 2, 8, "TrendComb", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 8, lineEnvTrendCombineMode, text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 4, 8, useLineEnvBias ? "Bias:ON" : "Bias:OFF", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 8, "Thr", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 6, 8, str.tostring(lineEnvScoreThreshold), text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 8, "", text_color = color.white, text_size = size.small)
        // Final Long / Short
        table.cell(lineEnvTbl, 0, 9, "Final Long", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 1, 9, finalEnvLongOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvLongOk ? color.new(color.green, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(lineEnvTbl, 2, 9, "Final Short", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 3, 9, finalEnvShortOk ? "OK" : "-", text_color = color.white, bgcolor = finalEnvShortOk ? color.new(color.red, 20) : color.new(color.gray, 50), text_size = size.small)
        table.cell(lineEnvTbl, 4, 9, "Obs L/S", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 5, 9, (lineEnvNoTradeLong ? "Y" : "N") + " / " + (lineEnvNoTradeShort ? "Y" : "N"), text_color = color.white, bgcolor = (lineEnvNoTradeLong or lineEnvNoTradeShort) ? color.new(color.orange, 0) : na, text_size = size.small)
        table.cell(lineEnvTbl, 6, 9, "", text_color = color.white, text_size = size.small)
        table.cell(lineEnvTbl, 7, 9, "", text_color = color.white, text_size = size.small)
        // デバッグ (lineEnvLabelTF の値)
        if lineEnvShowDebug
            table.cell(lineEnvTbl, 0, 10, "LabelTF", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 1, 10, lineEnvLabelTF, text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 2, 10, "Signal", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 3, 10, str.tostring(lineLblSignal), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 4, 10, "Strength", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 5, 10, str.tostring(lineLblStrength), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 6, 10, "Source", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 7, 10, f_lineEnvSourceText(lineLblSource), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 0, 11, "Nearest Sup", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 1, 11, na(lineLblNearestSup) ? "-" : str.tostring(lineLblNearestSup, "#.####"), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 2, 11, "Nearest Res", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 3, 11, na(lineLblNearestRes) ? "-" : str.tostring(lineLblNearestRes, "#.####"), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 4, 11, "Hit Zone", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 5, 11, na(lineLblHitP) ? "-" : str.tostring(lineLblHitP, "#.####"), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 6, 11, "Hit TF", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 7, 11, lineEnvLabelTF, text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 0, 12, "Zone Width", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 1, 12, na(lineLblZoneW) ? "-" : str.tostring(lineLblZoneW, "#.####"), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 2, 12, "Touch", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 3, 12, str.tostring(lineLblTouch), text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 4, 12, "Conflict", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 5, 12, lineLblConflict ? "Y" : "N", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 6, 12, "NT L/S", text_color = color.white, text_size = size.small)
            table.cell(lineEnvTbl, 7, 12, (lineLblNTLong ? "Y" : "N") + " / " + (lineLblNTShort ? "Y" : "N"), text_color = color.white, text_size = size.small)

// --- Data Window 出力 ---
plot(useLineEnvEnv ? lineEnvNetScore : na, "lineEnvNetScore", display = display.data_window)
plot(useLineEnvEnv ? lineEnvBias : na, "lineEnvBias", display = display.data_window)
plot(finalEnvLongOk  ? 1 : 0, "finalEnvLongOk",  display = display.data_window)
plot(finalEnvShortOk ? 1 : 0, "finalEnvShortOk", display = display.data_window)

// --- レジサポ描画 (lineEnvLabelTF・時刻アンカー。表示専用・検知/スコア/エントリー不変) ---
//   状態関数が管理している最近接Support/Resistanceを確定時刻から現在まで水平ラインで描画。
//   別のPivot検出は作らない。xloc.bar_time で上位足でも位置がずれない。OFF/環境OFF/TF変更時は削除。
var line  lineLnSup = na
var line  lineLnRes = na
var label lineLbBias = na

if barstate.islast
    bool _lineDraw = lineEnvWantDraw and useLineEnvEnv
    // 最近接Supportライン
    bool _supOk = _lineDraw and lineEnvShowZones and not na(lineLblNearestSup) and not na(lineLblSupT)
    if _supOk
        if na(lineLnSup)
            lineLnSup := line.new(lineLblSupT, lineLblNearestSup, time, lineLblNearestSup, xloc = xloc.bar_time, color = color.new(color.green, 0), width = 2)
        else
            line.set_xy1(lineLnSup, lineLblSupT, lineLblNearestSup)
            line.set_xy2(lineLnSup, time, lineLblNearestSup)
    else if not na(lineLnSup)
        line.delete(lineLnSup)
        lineLnSup := na
    // 最近接Resistanceライン
    bool _resOk = _lineDraw and lineEnvShowZones and not na(lineLblNearestRes) and not na(lineLblResT)
    if _resOk
        if na(lineLnRes)
            lineLnRes := line.new(lineLblResT, lineLblNearestRes, time, lineLblNearestRes, xloc = xloc.bar_time, color = color.new(color.red, 0), width = 2)
        else
            line.set_xy1(lineLnRes, lineLblResT, lineLblNearestRes)
            line.set_xy2(lineLnRes, time, lineLblNearestRes)
    else if not na(lineLnRes)
        line.delete(lineLnRes)
        lineLnRes := na
    // 反応ラベル (Bounce/Flip/Break/Sweep ↑↓) — 現在biasの反応種別を表示
    bool _lblOk = _lineDraw and lineEnvShowLabels and lineLblBias != 0 and lineLblSignal != 0
    if _lblOk
        string _arrow = lineLblBias == 1 ? "↑" : "↓"
        string _typeStr = lineLblSignal == 1 ? "Bounce" : lineLblSignal == 2 ? "Flip" : lineLblSignal == 3 ? "Break" : lineLblSignal == 4 ? "Sweep" : "?"
        string _txt = _typeStr + _arrow
        color  _col = lineLblBias == 1 ? color.new(color.green, 0) : color.new(color.red, 0)
        float  _y = not na(lineLblHitP) ? lineLblHitP : close
        if na(lineLbBias)
            lineLbBias := label.new(time, _y, _txt, xloc = xloc.bar_time, style = lineLblBias == 1 ? label.style_label_up : label.style_label_down, color = _col, textcolor = color.white, size = size.small)
        else
            label.set_xy(lineLbBias, time, _y)
            label.set_text(lineLbBias, _txt)
            label.set_style(lineLbBias, lineLblBias == 1 ? label.style_label_up : label.style_label_down)
            label.set_color(lineLbBias, _col)
    else if not na(lineLbBias)
        label.delete(lineLbBias)
        lineLbBias := na

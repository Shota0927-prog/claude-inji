//@version=6
// ============================================================================
// Zone v2 Current Snapshot - Visual
//
// Historical bars do exactly one thing: feed the Source Collectors. No
// Candidate, no clustering, no Zone state machine, no drawing.
//
// The current Zone set is built ONCE at barstate.islastconfirmedhistory, and
// after that once per confirmed 5m bar. Drawing happens only on barstate.islast.
//
// Zones present at bootstrap carry historyKnown = false: their structure is
// computed from the definition, but their past Touch / Weak / Break /
// Generation state is unknown and is never guessed.
// ============================================================================
indicator("Zone v2 Current Snapshot", overlay = true,
     max_boxes_count = 30, max_lines_count = 30, max_labels_count = 30)

// IMPORTANT: publish both libraries first and put their real publication
// numbers here. Do not guess them.
import sekine3310/ZoneCoreV2_Common/1 as zc
import sekine3310/ZoneCurrentEngineV2/1 as ze

// ============================================================================
// Inputs - Zone definition. Do not tune these for appearance.
// ============================================================================
gLogic = "Zone Logic"
clusterMaxWidth = input.float(20.0, "M / max width ($)", minval = 0.01, group = gLogic)
denseRatio = input.float(0.50, "Dense ratio", minval = 0.01, maxval = 1.0, group = gLogic)
touchResetDistance = input.float(10.0, "Touch reset distance ($)", minval = 0.01, group = gLogic)
strongUntilTouch = input.int(1, "Strong until touch", minval = 1, group = gLogic)
strongUnlimited = input.bool(false, "Strong unlimited", group = gLogic)
weakFromTouch = input.int(2, "Weak from touch", minval = 2, group = gLogic)
weakFromTouchOff = input.bool(false, "Weak-by-touch OFF", group = gLogic)
weakDepthPct = input.float(50.0, "Weak depth %", minval = 0, maxval = 100, group = gLogic)
weakDepthOff = input.bool(false, "Weak-depth OFF", group = gLogic)
breakBuffer = input.float(2.0, "Break buffer ($)", minval = 0, group = gLogic)
touchTolerance = input.float(0.0, "Line touch tolerance ($)", minval = 0, group = gLogic)

gSource = "Source"
emaSlopeLookback = input.int(60, "EMA slope lookback (1m bars)", minval = 1, group = gSource)
swingLen5m = input.int(10, "Swing length 5m", minval = 1, group = gSource)
swingLen15m = input.int(8, "Swing length 15m", minval = 1, group = gSource)
swingLen1h = input.int(6, "Swing length 1h", minval = 1, group = gSource)
accumRangeLen = input.int(10, "Accum range length", minval = 2, group = gSource)
accumBaseLen = input.int(20, "Accum base length", minval = 2, group = gSource)
accumAtrLen = input.int(14, "Accum ATR length", minval = 1, group = gSource)
accumMinUpper = input.int(4, "Accum min upper closes", minval = 0, group = gSource)
accumMinLower = input.int(4, "Accum min lower closes", minval = 0, group = gSource)
accumMaxRun = input.int(4, "Accum max same-color run", minval = 0, group = gSource)
accumAtrMult = input.float(2.5, "Accum range/ATR max", minval = 0.01, group = gSource)
accumBarRatio = input.float(0.70, "Accum short/base width max", minval = 0.01, group = gSource)
accumDriftMax = input.float(0.30, "Accum drift max", minval = 0.0, group = gSource)

gCategory = "Categories"
enableMA = input.bool(true, "MA", group = gCategory)
enableSwing = input.bool(true, "Swing", group = gCategory)
enableAccum = input.bool(true, "Accum", group = gCategory)
enableTimeHL = input.bool(true, "Session / Day / Week H-L", group = gCategory)
enableFVG = input.bool(true, "HTF FVG", group = gCategory)
enablePsych = input.bool(true, "Psychological prices", group = gCategory)

gDisplay = "Display"
showZones = input.bool(true, "Show zones", group = gDisplay)
showLabels = input.bool(true, "Show labels", group = gDisplay)
showDebug = input.bool(false, "Show debug table", group = gDisplay)
maxDraw = input.int(30, "Max views drawn", minval = 0, maxval = 30, group = gDisplay)
balanceSides = input.bool(true, "Balance Support / Resistance", group = gDisplay)

// ============================================================================
// Config
// ============================================================================
var zc.ZoneCfg cfg = zc.newCfg(syminfo.mintick)
if barstate.isfirst
    cfg.clusterMaxWidth := clusterMaxWidth
    cfg.denseRatio := denseRatio
    cfg.touchResetDistance := touchResetDistance
    cfg.strongUntilTouch := strongUntilTouch
    cfg.strongUnlimited := strongUnlimited
    cfg.weakFromTouch := weakFromTouch
    cfg.weakFromTouchOff := weakFromTouchOff
    cfg.weakDepthPct := weakDepthPct
    cfg.weakDepthOff := weakDepthOff
    cfg.breakBuffer := breakBuffer
    cfg.touchTolerance := touchTolerance
    cfg.emaSlopeLookback := emaSlopeLookback
    cfg.swingLen5m := swingLen5m
    cfg.swingLen15m := swingLen15m
    cfg.swingLen1h := swingLen1h
    cfg.accumRangeLen := accumRangeLen
    cfg.accumBaseLen := accumBaseLen
    cfg.accumAtrLen := accumAtrLen
    cfg.accumMinUpperCloses := accumMinUpper
    cfg.accumMinLowerCloses := accumMinLower
    cfg.accumMaxSameColorRun := accumMaxRun
    cfg.accumAtrMult := accumAtrMult
    cfg.accumBarRatioMax := accumBarRatio
    cfg.accumDriftMax := accumDriftMax
    cfg.enableMA := enableMA
    cfg.enableSwing := enableSwing
    cfg.enableAccum := enableAccum
    cfg.enableTimeHL := enableTimeHL
    cfg.enableFVG := enableFVG
    cfg.enablePsych := enablePsych
    cfg.mintick := syminfo.mintick
    cfg.revision := 1

// ============================================================================
// Source. Five requested contexts plus the 5m chart itself, one request each.
// No calc_bars_count: Source warmup is not shortened.
// ============================================================================
bool is5m = timeframe.in_seconds(timeframe.period) == 300

ze.MAPack ma1m = request.security(syminfo.tickerid, "1", ze.maPackV2(emaSlopeLookback),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
ze.SwingPack sw5 = ze.swingPackV2(swingLen5m)
ze.SwingPack sw15 = request.security(syminfo.tickerid, "15", ze.swingPackV2(swingLen15m),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
ze.TFPack p1h = request.security(syminfo.tickerid, "60",
     ze.pack1hV2(swingLen1h, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
         accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
ze.TFPack p4h = request.security(syminfo.tickerid, "240",
     ze.pack4hV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
         accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
ze.TFPack p1d = request.security(syminfo.tickerid, "1D",
     ze.pack1dV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpper, accumMinLower,
         accumMaxRun, accumAtrMult, accumBarRatio, accumDriftMax),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// ============================================================================
// Historical bars: Source Collectors ONLY.
//
// Every collect* call is gated on a newly confirmed source structure, so a bar
// with no event does no array work. Nothing below builds a Zone.
// ============================================================================
var ze.CurrentEngine eng = ze.newCurrentEngine()

if is5m and barstate.isconfirmed
    ze.collectMA(eng.col, ma1m, time_close)
    ze.collectSwings(eng.col, sw5, sw15, p1h.swing, time_close)
    ze.collectAccums(eng.col, p1h.accum, p4h.accum, p1d.accum, time_close)
    // HTF source event only: adds a new FVG or registers a structural
    // invalidation as InverseWait. It never advances the Inverse machine.
    ze.collectFvgs(eng.col, p1h.fvg, p4h.fvg, p1d.fvg, time_close)
    // Base-bar work, and the only FVG work a Base bar does. It walks the two
    // index lists (Fresh, InverseWait) and nothing else.
    ze.updateFvgBaseBar(eng.col, high, low, close, time_close, cfg)
    ze.collectTimeHL(eng.col, high, low, time, cfg)

// ============================================================================
// Current build.
//
// Once at the end of history, then once per confirmed 5m bar in real time.
// Historical bars never reach either call.
// ============================================================================
bool didBuild = false
bool didTrack = false

if is5m and barstate.islastconfirmedhistory and not ze.isBuilt(eng)
    ze.buildCurrent(eng, cfg, close, bar_index, time_close)
    didBuild := true
else if is5m and barstate.isconfirmed and ze.isBuilt(eng) and time_close > ze.bootstrapTime(eng)
    // Live: advance the Zones we have been watching, then refresh structure.
    didTrack := ze.trackLive(eng, cfg, high, low, close, bar_index, time_close)
    ze.buildCurrent(eng, cfg, close, bar_index, time_close)
    didBuild := true

// ============================================================================
// Presentation (sections 42, 43). Nothing here runs on a historical bar.
// ============================================================================
var array<box> boxPool = array.new<box>()
var array<line> linePool = array.new<line>()
var array<label> labelPool = array.new<label>()

f_ensurePools(int n) =>
    while array.size(boxPool) < n
        array.push(boxPool, box.new(left = bar_index, top = close, right = bar_index + 1, bottom = close,
             xloc = xloc.bar_index, extend = extend.right, border_color = na, bgcolor = na))
        array.push(linePool, line.new(x1 = bar_index, y1 = close, x2 = bar_index + 1, y2 = close,
             xloc = xloc.bar_index, extend = extend.right, color = na))
        array.push(labelPool, label.new(x = bar_index, y = close, text = "", xloc = xloc.bar_index,
             style = label.style_label_left, textcolor = color.white, color = na, size = size.tiny))

f_viewColor(ze.ZoneViewOut v) =>
    color base = v.side == 1 ? color.green : color.red
    if v.broadContext
        color.new(base, 90)
    else if not v.historyKnown
        // Structure is known, history is not: shown, but never as a confirmed
        // Strong Zone.
        color.new(base, v.baseStrong ? 70 : 84)
    else if v.grade == 1
        color.new(base, 62)
    else if v.grade == 3
        color.new(base, 88)
    else if v.grade == 4
        color.new(color.gray, 35)
    else
        color.new(base, 76)

f_labelText(ze.ZoneViewOut v, string rootSummary) =>
    string txt = "Z" + str.tostring(v.zoneId) + " / " + ze.sideLabel(v.side) + " / " + ze.phaseLabel(v.phase) + "\n"
    txt := txt + ze.gradeLabel(v) + "\n"
    txt := txt + str.tostring(v.bottom, format.mintick) + " - " + str.tostring(v.top, format.mintick) + " | Ref " + str.tostring(v.reference, format.mintick) + "\n"
    txt := txt + "C" + str.tostring(v.cCount) + " / H" + str.tostring(v.hCount) + " / " + ze.densityLabel(v.density) + "\n"
    if v.historyKnown
        txt := txt + "Touch " + str.tostring(v.touchCount) + " | Weak " + ze.weakReasonLabel(v.weakReason) + " | Depth " + str.tostring(v.maxDepthPct, "#.0") + "%\n"
    else
        txt := txt + "History unknown since bootstrap\n"
    txt := txt + "FVG dir " + str.tostring(v.fvgDirectionMask) + " fresh " + str.tostring(v.fvgFreshCount) + "/" + str.tostring(v.fvgRootCount)
    txt := str.length(rootSummary) == 0 ? txt : txt + "\n" + rootSummary
    txt

f_insertByDistance(array<int> idxs, array<float> dists, int idx, float dist) =>
    int pos = array.size(dists)
    int n = array.size(dists)
    if n > 0
        for j = 0 to n - 1
            if dist < array.get(dists, j)
                pos := j
                break
    array.insert(idxs, pos, idx)
    array.insert(dists, pos, dist)
    true

f_hasIdx(array<int> idxs, int idx) =>
    bool found = false
    int n = array.size(idxs)
    if n > 0
        for j = 0 to n - 1
            if array.get(idxs, j) == idx
                found := true
                break
    found

f_buildDrawOrder(int totalViews, int maxCount, float px, bool balance) =>
    array<int> allIdx = array.new<int>()
    array<float> allDist = array.new<float>()
    array<int> supIdx = array.new<int>()
    array<float> supDist = array.new<float>()
    array<int> resIdx = array.new<int>()
    array<float> resDist = array.new<float>()
    if totalViews > 0
        for vi = 0 to totalViews - 1
            ze.ZoneViewOut vv = ze.viewAt(eng, cfg, vi)
            if not na(vv) and not na(vv.bottom)
                float dd = ze.viewDistance(vv, px)
                f_insertByDistance(allIdx, allDist, vi, dd)
                if vv.side == 1
                    f_insertByDistance(supIdx, supDist, vi, dd)
                else
                    f_insertByDistance(resIdx, resDist, vi, dd)
    int target = math.min(maxCount, array.size(allIdx))
    array<int> selected = array.new<int>()
    if balance and target > 0
        int half = int(math.floor(target * 0.5))
        int supTake = math.min(half, array.size(supIdx))
        int resTake = math.min(half, array.size(resIdx))
        if supTake > 0
            for j = 0 to supTake - 1
                array.push(selected, array.get(supIdx, j))
        if resTake > 0
            for j = 0 to resTake - 1
                array.push(selected, array.get(resIdx, j))
        int allN = array.size(allIdx)
        if allN > 0 and array.size(selected) < target
            for j = 0 to allN - 1
                int idx = array.get(allIdx, j)
                if not f_hasIdx(selected, idx)
                    array.push(selected, idx)
                    if array.size(selected) >= target
                        break
    else if target > 0
        for j = 0 to target - 1
            array.push(selected, array.get(allIdx, j))
    array<int> finalIdx = array.new<int>()
    array<float> finalDist = array.new<float>()
    int sn = array.size(selected)
    if sn > 0
        for j = 0 to sn - 1
            int idx = array.get(selected, j)
            f_insertByDistance(finalIdx, finalDist, idx, ze.viewDistance(ze.viewAt(eng, cfg, idx), px))
    finalIdx

if barstate.islast
    int totalViews = ze.viewCount(eng)
    array<int> drawOrder = f_buildDrawOrder(totalViews, math.min(maxDraw, 30), close, balanceSides)
    f_ensurePools(30)
    for i = 0 to 29
        box bx = array.get(boxPool, i)
        line ln = array.get(linePool, i)
        label lb = array.get(labelPool, i)
        if showZones and i < array.size(drawOrder)
            int viewIdx = array.get(drawOrder, i)
            ze.ZoneViewOut v = ze.viewAt(eng, cfg, viewIdx)
            bool lineZone = not na(v) and v.bottom == v.top
            color vc = not na(v) ? f_viewColor(v) : na
            if not na(v) and lineZone
                line.set_xy1(ln, bar_index - 1, v.bottom)
                line.set_xy2(ln, bar_index, v.top)
                line.set_extend(ln, extend.right)
                line.set_color(ln, vc)
                line.set_width(ln, v.phase == 3 ? 3 : 1)
                box.set_bgcolor(bx, na)
                box.set_border_color(bx, na)
            else if not na(v)
                box.set_lefttop(bx, bar_index - 1, v.top)
                box.set_rightbottom(bx, bar_index, v.bottom)
                box.set_extend(bx, extend.right)
                box.set_bgcolor(bx, vc)
                box.set_border_color(bx, color.new(vc, v.phase == 3 ? 0 : 35))
                box.set_border_width(bx, v.phase == 3 ? 2 : 1)
                line.set_color(ln, na)
            if showLabels and not na(v)
                label.set_xy(lb, bar_index + 1, na(v.reference) ? (v.bottom + v.top) * 0.5 : v.reference)
                // Root detail is a Debug-only string; with Debug off it is never built.
                label.set_text(lb, f_labelText(v, showDebug ? ze.viewRootSummary(eng, viewIdx) : ""))
                label.set_color(lb, color.new(color.black, 20))
                label.set_textcolor(lb, color.white)
            else
                label.set_text(lb, "")
                label.set_color(lb, na)
        else
            box.set_bgcolor(bx, na)
            box.set_border_color(bx, na)
            line.set_color(ln, na)
            label.set_text(lb, "")
            label.set_color(lb, na)

// ============================================================================
// Debug (section 44)
// ============================================================================
var table dbg = table.new(position.top_right, 2, 12, border_width = 1)
if barstate.islast and showDebug
    table.cell(dbg, 0, 0, "Build")
    table.cell(dbg, 1, 0, zc.coreBuildId() + " / " + ze.currentBuildId())
    table.cell(dbg, 0, 1, "Chart")
    table.cell(dbg, 1, 1, is5m ? "5m OK" : "ERROR: use 5m")
    table.cell(dbg, 0, 2, "Bootstrap time")
    table.cell(dbg, 1, 2, str.format_time(ze.bootstrapTime(eng), "yyyy-MM-dd HH:mm", syminfo.timezone))
    table.cell(dbg, 0, 3, "Last build")
    table.cell(dbg, 1, 3, str.format_time(ze.lastBuildTime(eng), "yyyy-MM-dd HH:mm", syminfo.timezone))
    table.cell(dbg, 0, 4, "Swing 5m/15m/1H")
    table.cell(dbg, 1, 4, str.tostring(ze.collectorCounts(eng, 0)) + " / " + str.tostring(ze.collectorCounts(eng, 1)) + " / " + str.tostring(ze.collectorCounts(eng, 2)))
    table.cell(dbg, 0, 5, "Accum 1H/4H/1D")
    table.cell(dbg, 1, 5, str.tostring(ze.collectorCounts(eng, 3)) + " / " + str.tostring(ze.collectorCounts(eng, 4)) + " / " + str.tostring(ze.collectorCounts(eng, 5)))
    table.cell(dbg, 0, 6, "FVG 1H/4H/1D")
    table.cell(dbg, 1, 6, str.tostring(ze.collectorCounts(eng, 6)) + " / " + str.tostring(ze.collectorCounts(eng, 7)) + " / " + str.tostring(ze.collectorCounts(eng, 8)))
    table.cell(dbg, 0, 7, "Current Roots")
    table.cell(dbg, 1, 7, str.tostring(ze.currentRootCount(eng)))
    table.cell(dbg, 0, 8, "Candidates")
    table.cell(dbg, 1, 8, str.tostring(ze.currentCandidateCount(eng)))
    table.cell(dbg, 0, 9, "Cores / Views")
    table.cell(dbg, 1, 9, str.tostring(ze.currentZoneCount(eng)) + " / " + str.tostring(ze.viewCount(eng)))
    table.cell(dbg, 0, 10, "historyKnown / unknown")
    table.cell(dbg, 1, 10, str.tostring(ze.historyKnownCount(eng)) + " / " + str.tostring(ze.historyUnknownCount(eng)))
    table.cell(dbg, 0, 11, "Historical Zone ops / built / tracked")
    table.cell(dbg, 1, 11, str.tostring(ze.historicalZoneOps(eng)) + " (must be 0) / " + str.tostring(didBuild) + " / " + str.tostring(didTrack))
else if barstate.islast
    table.clear(dbg, 0, 0, 1, 11)

//@version=5
strategy("EUレンジ Strategy", overlay=true, max_labels_count=500, max_boxes_count=500, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=5,pyramiding=4)
is5m = timeframe.period == "5"
// =====================================================
// Inputs
// =====================================================
groupCore     = "01. Core / 共通"
groupAccum    = "02. Accumulation"
groupMss      = "03. MSS"
groupFvg      = "04. FVG"
groupEntryReb = "05. エントリー：反発"
groupEntryAbs = "06. エントリー：吸収"
groupHtf      = "07. HTFフィルタ（ADX/ゾーン）"
groupRisk     = "08. Risk / RR"
groupDisp     = "09. 表示"

manualNewsBlock = input.bool(false, "重要指標回避ON", group=groupCore)
tokyoHour = hour(time, "Asia/Tokyo")
isTokyoSession = (tokyoHour >= 16 and tokyoHour < 21)
_year  = year(time, "Asia/Tokyo")
_month = month(time, "Asia/Tokyo")
_day   = dayofmonth(time, "Asia/Tokyo")
holidayBlock = (_month == 12 and _day >= 24) or (_month == 1 and _day <= 7)

accumRangeLen     = input.int(10, "Accum判定レンジ本数", minval=6, group=groupAccum)
accumBaseLen      = input.int(20, "基準平均本数", minval=10, group=groupAccum)
accumAtrLen       = input.int(14, "ATR本数", minval=1, group=groupAccum)
accumMinUpperCloses = input.int(4, "上半分の最低終値本数", minval=1, group=groupAccum)
accumMinLowerCloses = input.int(4, "下半分の最低終値本数", minval=1, group=groupAccum)
accumMaxSameColorRun = input.int(4, "同色連続の上限", minval=1, group=groupAccum)
accumAtrMult       = input.float(3.0, "Accum レンジ幅 / ATR 上限", minval=0.5, step=0.1, group=groupAccum)
accumBarRatioMax  = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval=0.1, step=0.01, group=groupAccum)
accumDriftMax     = input.float(0.40, "Accum ドリフト上限",           minval=0.05, maxval=1.0, step=0.05, group=groupAccum)

mssValidBars = input.int(100, "MSS有効本数", minval=10, group=groupMss)
mssNeedBodyStrength = input.bool(true, "MSSで実体強度を使う", group=groupMss)
mssImpulseMult = input.float(0.3, "MSS インパルス強度", group=groupMss)

fvgMaxAge          = input.int(80, "FVG有効本数", minval=1, group=groupFvg)
absorbThinRatioMax = input.float(0.00, "吸収 薄いFVG上限（幅/Accum幅）", minval=0.00, step=0.01, group=groupFvg)
absorbNearGapMax   = input.float(0.00, "吸収 近接FVG距離上限（距離/Accum幅）", minval=0.00, step=0.01, group=groupFvg)
fvgThicknessMin_Reb = input.float(0.00, "FVG厚み最小[反発]", minval=0.00, step=0.01, group=groupFvg)
fvgThicknessMin_Abs = input.float(0.00, "FVG厚み最小[吸収]", minval=0.00, step=0.01, group=groupFvg)

confirmDepth_RB = input.float(0.80, "反発確定深度上限[反発BUY]",  minval=0.1, maxval=1.0, step=0.05, group=groupEntryReb)
confirmDepth_RS = input.float(0.80, "反発確定深度上限[反発SELL]", minval=0.1, maxval=1.0, step=0.05, group=groupEntryReb)
useStrictBar_RB = input.bool(true, "ローソク強度フィルタON[反発BUY]",  group=groupEntryReb)
useStrictBar_RS = input.bool(true, "ローソク強度フィルタON[反発SELL]", group=groupEntryReb)
barBodyMinRatio_RB = input.float(0.00, "実体/値幅 下限[反発BUY]",  minval=0.0, maxval=1.0, step=0.05, group=groupEntryReb)
barBodyMinRatio_RS = input.float(0.00, "実体/値幅 下限[反発SELL]", minval=0.0, maxval=1.0, step=0.05, group=groupEntryReb)
barCloseEdgeRatio_RB = input.float(0.40, "close位置の上下端寄り(>=)[反発BUY]",  minval=0.0, maxval=1.0, step=0.05, group=groupEntryReb)
barCloseEdgeRatio_RS = input.float(0.40, "close位置の上下端寄り(>=)[反発SELL]", minval=0.0, maxval=1.0, step=0.05, group=groupEntryReb)
reboundNearGapMax = input.float(0.4, "反発 逆側FVG近接距離上限（距離/Accum幅）", minval=0.0, step=0.01, group=groupEntryReb)
reboundOppMinThick   = input.float(0.05, "反発 逆側FVG最低厚み（厚み/Accum幅）", minval=0.0, step=0.01, group=groupEntryReb)

absorbBodyMinRatio   = input.float(0.5, "吸収バー実体率最小", group=groupEntryAbs)
absorbCloseEdgeRatio = input.float(0.6, "吸収バーclose端寄せ", group=groupEntryAbs)

trendTf   = input.timeframe("1440", "上位足トレンドTF", group=groupHtf)
trendTfMtf = input.timeframe("240",  "中期TF（反発フィルタ用）",   group=groupHtf)
h4RangeLen = input.int(10, "4Hレンジ参照本数", minval=5, group=groupHtf)
stAtrLen  = input.int(10, "Supertrend ATR Length", minval=1, group=groupHtf)
stFactor  = input.float(3.0, "Supertrend Factor", minval=0.1, step=0.1, group=groupHtf)
adxMin_Reb = input.float(15.0, "ADX下限[反発]", group=groupHtf)
adxMax_Reb = input.float(25.0, "ADX上限[反発]", group=groupHtf)
adxMin_Abs = input.float(20.0, "ADX下限[吸収]", group=groupHtf)
adxMax_Abs = input.float(35.0, "ADX上限[吸収]", group=groupHtf)
buyZonePctTop  = input.float(0.30, "BUYゾーン上限", group=groupHtf)
buyZonePctLow  = input.float(0.00, "BUYゾーン下限", group=groupHtf)
sellZonePctBot = input.float(0.50, "SELLゾーン下限", group=groupHtf)
sellZonePctTop = input.float(0.80, "SELLゾーン上限", group=groupHtf)

// SLオフセット：固定 or ATR可変を切り替え
slOffsetFixed = input.float(8.0, "SLオフセット($/固定)", minval=0.1, step=0.1, group=groupRisk)
useAtrSL      = input.bool(false, "SLオフセットをATR可変にする", group=groupRisk)
atrSLLen      = input.int(14,  "SL用ATR本数", minval=1, group=groupRisk)
atrSLMult     = input.float(0.5, "SL用ATR係数", minval=0.1, step=0.1, group=groupRisk)

// 実際に使うSLオフセット（ON=ATR×係数 / OFF=固定値）
slOffset = useAtrSL ? ta.atr(atrSLLen) * atrSLMult : slOffsetFixed

maxRisk  = input.float(17.0, "最大リスク幅($)", minval=1.0, step=0.5, group=groupRisk)
minRisk = input.float(10.0, "最小リスク幅($)", minval=0.1, step=0.5, group=groupRisk)
rr1_Reb = input.float(1.5, "TP RR[反発]", group=groupRisk)
rr1_Abs = input.float(1.5, "TP RR[吸収]", group=groupRisk)
cooldownBars = input.int(1, "エントリー間隔[バー]", minval=1, group=groupRisk)
useBE     = input.bool(false,  "建値移動ON",        group=groupRisk)
beTrigger = input.float(20.0, "建値移動 発動幅($)", minval=0.1, step=0.1, group=groupRisk)
// MAでSL/TP調整
useMaSLTP = input.bool(true,  "MAでSL/TP調整ON", group=groupRisk)
maNearPct = input.float(0.20, "MA近接判定（リスク幅の割合）", minval=0.01, maxval=1.0, step=0.01, group=groupRisk)

useRRmin = input.bool(false, "RR下限ガードON", group=groupRisk)
rrMin    = input.float(1.5, "RR下限（これ未満は見送り）", minval=0.1, step=0.1, group=groupRisk)

maSlBuffer = input.float(3.0, "MAスナップ余白：SL($)", minval=0.0, step=0.1, group=groupRisk)
maTpBuffer = input.float(1.0, "MAスナップ余白：TP($)", minval=0.0, step=0.1, group=groupRisk)

showBoxes    = input.bool(false, "FVGボックス表示", group=groupDisp)
showAccumBox  = input.bool(true, "Accumボックス表示", group=groupDisp)
accumBoxColor = input.color(color.new(color.yellow, 85), "Accum背景色", group=groupDisp)
accumBoxBorder= input.color(color.new(color.yellow, 30), "Accum枠色",   group=groupDisp)

groupStrat = "10. ストラテジー"
useRiskBasedSize = input.bool(true, "リスクベースのロット計算", group=groupStrat)
riskPctPerTrade  = input.float(5.0, "1トレードのリスク% (エクイティ基準)", minval=0.1, maxval=20.0, step=0.1, group=groupStrat)
minLotSize      = input.float(0.01, "最小ロット (MT4換算)", minval=0.01, step=0.01, group=groupStrat)
contractsPerLot = input.int(100, "1ロットあたりの契約数 (Gold=100, FX=100000)", minval=1, group=groupStrat)
// =====================================================
// Multi-FVG arrays
// =====================================================
var bullTopArr         = array.new_float()
var bullBotArr         = array.new_float()
var bullBarArr         = array.new_int()
var bullRefArr         = array.new_float()
var bullReboundUsedArr = array.new_bool()
var bullAbsorbUsedArr  = array.new_bool()
var bullDeadArr        = array.new_bool()
var bullBoxArr         = array.new_box()

var bearTopArr         = array.new_float()
var bearBotArr         = array.new_float()
var bearBarArr         = array.new_int()
var bearRefArr         = array.new_float()
var bearReboundUsedArr = array.new_bool()
var bearAbsorbUsedArr  = array.new_bool()
var bearDeadArr        = array.new_bool()
var bearBoxArr         = array.new_box()

var bullFilledThisBarArr = array.new_bool()
var bearFilledThisBarArr = array.new_bool()

f_accum_range() =>
    ta.highest(math.max(open, close), accumRangeLen) - ta.lowest(math.min(open, close), accumRangeLen)

f_is_accum_core(_atrMult, _barRatioMax, _driftMax) =>
    _atr = ta.atr(accumAtrLen)

    _bodyTop = math.max(open, close)
    _bodyBot = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to accumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[accumRangeLen - 1] + close[accumRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * _atrMult

    _bodyTopNow  = math.max(open, close)
    _bodyBotNow  = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, accumRangeLen) - ta.lowest(_bodyBotNow, accumRangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, accumBaseLen)  - ta.lowest(_bodyBotNow, accumBaseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * _barRatioMax
    _condBalance  = _upperCloses >= accumMinUpperCloses and _lowerCloses >= accumMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= _driftMax
    _condColorRun = _maxBullRun <= accumMaxSameColorRun and _maxBearRun <= accumMaxSameColorRun

    // 全5条件 + colorRun 必須（AND結合）
    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

// FVG間距離（C: 2つのFVGの空白距離。重なり/接触なら0）
f_zone_gap(_top1, _bot1, _top2, _bot2) =>
    _upperGap = _bot1 > _top2 ? (_bot1 - _top2) : 0.0
    _lowerGap = _bot2 > _top1 ? (_bot2 - _top1) : 0.0
    math.max(_upperGap, _lowerGap)

f_has_near_opposite_bear_for_bull(_top, _bot, _ref) =>
    _blocked = false
    if array.size(bearTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bearTopArr) - 1
            if not array.get(bearDeadArr, j) and not array.get(bearReboundUsedArr, j)
                _otop = array.get(bearTopArr, j)
                _obot = array.get(bearBotArr, j)
                _oWidth = _otop - _obot                            // ← 追加
                _gap = f_zone_gap(_top, _bot, _otop, _obot)
                _near = (_gap / _ref) <= reboundNearGapMax
                _thick = (_oWidth / _ref) >= reboundOppMinThick    // ← 追加
                if _near and _thick                                // ← AND条件
                    _blocked := true
    _blocked

f_has_near_opposite_bull_for_bear(_top, _bot, _ref) =>
    _blocked = false
    if array.size(bullTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bullTopArr) - 1
            if not array.get(bullDeadArr, j) and not array.get(bullReboundUsedArr, j)
                _otop = array.get(bullTopArr, j)
                _obot = array.get(bullBotArr, j)
                _oWidth = _otop - _obot                            // ← 追加
                _gap = f_zone_gap(_top, _bot, _otop, _obot)
                _near = (_gap / _ref) <= reboundNearGapMax
                _thick = (_oWidth / _ref) >= reboundOppMinThick    // ← 追加
                if _near and _thick
                    _blocked := true
    _blocked

f_adx(_len) =>
    _up   = ta.change(high)
    _down = -ta.change(low)
    _plusDM  = na(_up) ? na : (_up > _down and _up > 0 ? _up : 0)
    _minusDM = na(_down) ? na : (_down > _up and _down > 0 ? _down : 0)
    _trur = ta.rma(ta.tr, _len)
    _plus  = 100 * ta.rma(_plusDM, _len) / _trur
    _minus = 100 * ta.rma(_minusDM, _len) / _trur
    _sum   = _plus + _minus
    _adx   = 100 * ta.rma(math.abs(_plus - _minus) / (_sum == 0 ? 1 : _sum), _len)
    _adx

h4Adx = request.security(syminfo.tickerid, trendTfMtf, f_adx(14)[1], lookahead=barmerge.lookahead_on)
// 5m換算: 4H 1本 = 5m 48本（4×60÷5）。h4RangeLen は「4H本数換算」のまま使う
h4RangeHigh = ta.highest(high, h4RangeLen * 48)
h4RangeLow  = ta.lowest(low,  h4RangeLen * 48)

h4RangeWidth  = h4RangeHigh - h4RangeLow

isRangeMode_RB = h4Adx >= adxMin_Reb and h4Adx <= adxMax_Reb
isRangeMode_RS = h4Adx >= adxMin_Reb and h4Adx <= adxMax_Reb
isRangeMode_AB = h4Adx >= adxMin_Abs and h4Adx <= adxMax_Abs
isRangeMode_AS = h4Adx >= adxMin_Abs and h4Adx <= adxMax_Abs

priceZone_RB = h4RangeWidth > 0 and close < h4RangeLow + h4RangeWidth*buyZonePctTop  and close >= h4RangeLow + h4RangeWidth*buyZonePctLow
priceZone_AB = h4RangeWidth > 0 and close < h4RangeLow + h4RangeWidth*buyZonePctTop  and close >= h4RangeLow + h4RangeWidth*buyZonePctLow
priceZone_RS = h4RangeWidth > 0 and close > h4RangeLow + h4RangeWidth*sellZonePctBot and close <= h4RangeLow + h4RangeWidth*sellZonePctTop
priceZone_AS = h4RangeWidth > 0 and close > h4RangeLow + h4RangeWidth*sellZonePctBot and close <= h4RangeLow + h4RangeWidth*sellZonePctTop

// ===== MA（各足の1000/3000 EMA）。確定値参照でリペイント無し =====
ema_1m_1000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1m_3000  = request.security(syminfo.tickerid, "1",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_5m_1000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_5m_3000  = request.security(syminfo.tickerid, "5",   ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_15m_1000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_15m_3000 = request.security(syminfo.tickerid, "15",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_1h_1000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_1h_3000  = request.security(syminfo.tickerid, "60",  ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)
ema_4h_1000  = request.security(syminfo.tickerid, "240", ta.ema(close, 1000)[1], lookahead=barmerge.lookahead_on)
ema_4h_3000  = request.security(syminfo.tickerid, "240", ta.ema(close, 3000)[1], lookahead=barmerge.lookahead_on)

maArr = array.from(ema_1m_1000, ema_1m_3000, ema_5m_1000, ema_5m_3000, ema_15m_1000, ema_15m_3000, ema_1h_1000, ema_1h_3000, ema_4h_1000, ema_4h_3000)
// =====================================================
// Core calculations
// =====================================================
accumRange = f_accum_range()

isAccum = f_is_accum_core(accumAtrMult, accumBarRatioMax, accumDriftMax)

accumHighNow = ta.highest(math.max(open, close), accumRangeLen)
accumLowNow  = ta.lowest(math.min(open, close),  accumRangeLen)

newBullFVG = barstate.isconfirmed and low > high[2]
newBearFVG = barstate.isconfirmed and high < low[2]

// =====================================================
// Phase / lock state
// =====================================================

var int absorbBias = 0
// 0 = 制限なし
// 1 = BUYのみ許可
// -1 = SELLのみ許可
// 2 = 全停止
var box   curAccumBox     = na
var float curAccumBoxHigh = na
var float curAccumBoxLow  = na

var float runAccumHigh   = na
var float runAccumLow    = na
var float lastAccumHigh  = na
var float lastAccumLow   = na
var float lastAccumWidth = na
var float phaseAccumRef  = na

var int lastEntryBar = na
// 建値移動用：エントリーごとのTPを保持（stopだけ建値に書き換えてもTPを維持するため）
var map<string, float> beTpMap = map.new<string, float>()

// ===== ④-1 シグナル別 state（4セット完全分離） =====

// --- 反発BUY (RB) ---
var bool  phaseActive_RB    = false
var int   lastMssBar_RB     = na
var bool  bullBreakSeen_RB  = false
var float bullCumBody_RB    = 0.0
var bool  bullMssDone_RB    = false

// --- 反発SELL (RS) ---
var bool  phaseActive_RS    = false
var int   lastMssBar_RS     = na
var bool  bearBreakSeen_RS  = false
var float bearCumBody_RS    = 0.0
var bool  bearMssDone_RS    = false

// --- 吸収BUY (AB) ---
var bool  phaseActive_AB    = false
var int   lastMssBar_AB     = na
var bool  bearBreakSeen_AB  = false
var float bearCumBody_AB    = 0.0
var bool  bearMssDone_AB    = false

// --- 吸収SELL (AS) ---
var bool  phaseActive_AS    = false
var int   lastMssBar_AS     = na
var bool  bullBreakSeen_AS  = false
var float bullCumBody_AS    = 0.0
var bool  bullMssDone_AS    = false

// ===== 共通アキュム検出 =====
newAccum = isAccum and not nz(isAccum[1], false)
endAccum = not isAccum and nz(isAccum[1], false)

// アキュム新規開始：共通リセット ＋ シグナル別MSSリセット
if newAccum
    lastAccumHigh  := na
    lastAccumLow   := na
    lastAccumWidth := na
    runAccumHigh   := accumHighNow
    runAccumLow    := accumLowNow

    // RB
    bullBreakSeen_RB := false
    bullCumBody_RB   := 0.0
    bullMssDone_RB   := false
    phaseActive_RB   := false
    lastMssBar_RB    := na
    // RS
    bearBreakSeen_RS := false
    bearCumBody_RS   := 0.0
    bearMssDone_RS   := false
    phaseActive_RS   := false
    lastMssBar_RS    := na
    // AB
    bearBreakSeen_AB := false
    bearCumBody_AB   := 0.0
    bearMssDone_AB   := false
    phaseActive_AB   := false
    lastMssBar_AB    := na
    // AS
    bullBreakSeen_AS := false
    bullCumBody_AS   := 0.0
    bullMssDone_AS   := false
    phaseActive_AS   := false
    lastMssBar_AS    := na

// アキュム継続中：実体ベースで高値・安値追跡
if isAccum
    _bt = math.max(open, close)
    _bb = math.min(open, close)
    runAccumHigh := na(runAccumHigh) ? _bt : math.max(runAccumHigh, _bt)
    runAccumLow  := na(runAccumLow)  ? _bb : math.min(runAccumLow,  _bb)

// アキュム終了：確定値を保存
if endAccum
    lastAccumHigh  := runAccumHigh
    lastAccumLow   := runAccumLow
    lastAccumWidth := runAccumHigh - runAccumLow
    phaseAccumRef  := lastAccumWidth
    runAccumHigh   := na
    runAccumLow    := na

// ===== MSS（4セット：方向×インパルス強度別）=====

// ----- 反発BUY (RB) -----
bullMSS_RB = false
if not na(lastAccumHigh) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bullMssDone_RB
    _brk = close > lastAccumHigh and close[1] <= lastAccumHigh
    if _brk and not bullBreakSeen_RB
        bullBreakSeen_RB := true
        bullCumBody_RB   := close - open
    else if bullBreakSeen_RB
        bullCumBody_RB += (close - open)
    _imp = math.abs(bullCumBody_RB) >= lastAccumWidth * mssImpulseMult
    bullMSS_RB := barstate.isconfirmed and bullBreakSeen_RB and (not mssNeedBodyStrength or _imp)
    if bullMSS_RB
        bullMssDone_RB := true

if bullMSS_RB
    phaseActive_RB := true
    lastMssBar_RB  := bar_index

// ----- 反発SELL (RS) -----
bearMSS_RS = false
if not na(lastAccumLow) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bearMssDone_RS
    _brk = close < lastAccumLow and close[1] >= lastAccumLow
    if _brk and not bearBreakSeen_RS
        bearBreakSeen_RS := true
        bearCumBody_RS   := open - close
    else if bearBreakSeen_RS
        bearCumBody_RS += (open - close)
    _imp = math.abs(bearCumBody_RS) >= lastAccumWidth * mssImpulseMult
    bearMSS_RS := barstate.isconfirmed and bearBreakSeen_RS and (not mssNeedBodyStrength or _imp)
    if bearMSS_RS
        bearMssDone_RS := true

if bearMSS_RS
    phaseActive_RS := true
    lastMssBar_RS  := bar_index

// ----- 吸収BUY (AB) - 下向きMSSで発動 -----
bearMSS_AB = false
if not na(lastAccumLow) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bearMssDone_AB
    _brk = close < lastAccumLow and close[1] >= lastAccumLow
    if _brk and not bearBreakSeen_AB
        bearBreakSeen_AB := true
        bearCumBody_AB   := open - close
    else if bearBreakSeen_AB
        bearCumBody_AB += (open - close)
    _imp = math.abs(bearCumBody_AB) >= lastAccumWidth * mssImpulseMult
    bearMSS_AB := barstate.isconfirmed and bearBreakSeen_AB and (not mssNeedBodyStrength or _imp)
    if bearMSS_AB
        bearMssDone_AB := true

if bearMSS_AB
    phaseActive_AB := true
    lastMssBar_AB  := bar_index

// ----- 吸収SELL (AS) - 上向きMSSで発動 -----
bullMSS_AS = false
if not na(lastAccumHigh) and not na(lastAccumWidth) and lastAccumWidth > 0 and not bullMssDone_AS
    _brk = close > lastAccumHigh and close[1] <= lastAccumHigh
    if _brk and not bullBreakSeen_AS
        bullBreakSeen_AS := true
        bullCumBody_AS   := close - open
    else if bullBreakSeen_AS
        bullCumBody_AS += (close - open)
    _imp = math.abs(bullCumBody_AS) >= lastAccumWidth * mssImpulseMult
    bullMSS_AS := barstate.isconfirmed and bullBreakSeen_AS and (not mssNeedBodyStrength or _imp)
    if bullMSS_AS
        bullMssDone_AS := true

if bullMSS_AS
    phaseActive_AS := true
    lastMssBar_AS  := bar_index

// ===== ④-3 FVGクリア＋共通ロックリセット（いずれかのアキュムが新規開始したら） =====
newAccumAny = newAccum

if newAccumAny
    while array.size(bullTopArr) > 0
        _bx = array.get(bullBoxArr, 0)
        if not na(_bx)
            box.delete(_bx)
        array.remove(bullTopArr, 0)
        array.remove(bullBotArr, 0)
        array.remove(bullBarArr, 0)
        array.remove(bullRefArr, 0)
        array.remove(bullReboundUsedArr, 0)
        array.remove(bullAbsorbUsedArr, 0)
        array.remove(bullDeadArr, 0)
        array.remove(bullBoxArr, 0)
        array.remove(bullFilledThisBarArr, 0)

    while array.size(bearTopArr) > 0
        _bx = array.get(bearBoxArr, 0)
        if not na(_bx)
            box.delete(_bx)
        array.remove(bearTopArr, 0)
        array.remove(bearBotArr, 0)
        array.remove(bearBarArr, 0)
        array.remove(bearRefArr, 0)
        array.remove(bearReboundUsedArr, 0)
        array.remove(bearAbsorbUsedArr, 0)
        array.remove(bearDeadArr, 0)
        array.remove(bearBoxArr, 0)
        array.remove(bearFilledThisBarArr, 0)

    absorbBias    := 0

// =====================================================
// Accumボックス描画（任意のシグナルのアキュム期間を可視化）
// =====================================================
isAccumStart = isAccum and not nz(isAccum[1], false)

if isAccumStart
    curAccumBoxHigh := accumHighNow
    curAccumBoxLow  := accumLowNow
    if showAccumBox
        curAccumBox := box.new(left=bar_index - accumRangeLen + 1, top=accumHighNow, right=bar_index, bottom=accumLowNow, bgcolor=accumBoxColor, border_color=accumBoxBorder)

if isAccum
    _bt = math.max(open, close)
    _bb = math.min(open, close)
    curAccumBoxHigh := math.max(nz(curAccumBoxHigh, _bt), _bt)
    curAccumBoxLow  := math.min(nz(curAccumBoxLow,  _bb), _bb)
    if showAccumBox and not na(curAccumBox)
        box.set_top(curAccumBox, curAccumBoxHigh)
        box.set_bottom(curAccumBox, curAccumBoxLow)
        box.set_right(curAccumBox, bar_index)
// =====================================================
// Keep collecting multiple FVGs after phase activation
// 同方向縛りなしで、Bull / Bear 両方保持
// =====================================================
phaseActiveAny = phaseActive_RB or phaseActive_RS or phaseActive_AB or phaseActive_AS
phaseRefAny    = nz(phaseAccumRef, accumRange)
fvgThickMinAny = math.min(fvgThicknessMin_Reb, fvgThicknessMin_Abs)
if phaseActiveAny
    _ref = phaseRefAny

    if newBullFVG and _ref > 0 and ((low - high[2]) / _ref) >= fvgThickMinAny
        _top = low
        _bot = high[2]
        box _b = na
        if showBoxes
            _b := box.new(left=bar_index, top=_top, right=bar_index + fvgMaxAge, bottom=_bot, bgcolor=color.new(color.lime, 88), border_color=color.new(color.lime, 35))
        array.push(bullTopArr, _top)
        array.push(bullBotArr, _bot)
        array.push(bullBarArr, bar_index)
        array.push(bullRefArr, _ref)
        array.push(bullReboundUsedArr, false)
        array.push(bullAbsorbUsedArr, false)
        array.push(bullDeadArr, false)
        array.push(bullBoxArr, _b)
        array.push(bullFilledThisBarArr, false)

    if newBearFVG and _ref > 0 and ((low[2] - high) / _ref) >= fvgThickMinAny
        _top = low[2]
        _bot = high
        box _b = na
        if showBoxes
            _b := box.new(left=bar_index, top=_top, right=bar_index + fvgMaxAge, bottom=_bot, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 35))
        array.push(bearTopArr, _top)
        array.push(bearBotArr, _bot)
        array.push(bearBarArr, bar_index)
        array.push(bearRefArr, _ref)
        array.push(bearReboundUsedArr, false)
        array.push(bearAbsorbUsedArr, false)
        array.push(bearDeadArr, false)
        array.push(bearBoxArr, _b)
        array.push(bearFilledThisBarArr, false)

// =====================================================
// Safety guard for too many FVGs
// =====================================================
MAX_FVGS_PER_SIDE = 120

while array.size(bullTopArr) > MAX_FVGS_PER_SIDE
    _bx = array.get(bullBoxArr, 0)
    if not na(_bx)
        box.delete(_bx)
    array.remove(bullTopArr, 0)
    array.remove(bullBotArr, 0)
    array.remove(bullBarArr, 0)
    array.remove(bullRefArr, 0)
    array.remove(bullReboundUsedArr, 0)
    array.remove(bullAbsorbUsedArr, 0)
    array.remove(bullDeadArr, 0)
    array.remove(bullBoxArr, 0)
    array.remove(bullFilledThisBarArr, 0)

while array.size(bearTopArr) > MAX_FVGS_PER_SIDE
    _bx = array.get(bearBoxArr, 0)
    if not na(_bx)
        box.delete(_bx)
    array.remove(bearTopArr, 0)
    array.remove(bearBotArr, 0)
    array.remove(bearBarArr, 0)
    array.remove(bearRefArr, 0)
    array.remove(bearReboundUsedArr, 0)
    array.remove(bearAbsorbUsedArr, 0)
    array.remove(bearDeadArr, 0)
    array.remove(bearBoxArr, 0)
    array.remove(bearFilledThisBarArr, 0)

if array.size(bullFilledThisBarArr) > 0
    for i = 0 to array.size(bullFilledThisBarArr) - 1
        array.set(bullFilledThisBarArr, i, false)

if array.size(bearFilledThisBarArr) > 0
    for i = 0 to array.size(bearFilledThisBarArr) - 1
        array.set(bearFilledThisBarArr, i, false)

// =====================================================
// Per-bar FVG maintenance / invalidation
// =====================================================

// Bull FVG side
if array.size(bullTopArr) > 0
    for i = array.size(bullTopArr) - 1 to 0
        if not array.get(bullDeadArr, i)
            _top = array.get(bullTopArr, i)
            _bot = array.get(bullBotArr, i)
            _bar = array.get(bullBarArr, i)
            _zone = math.max(_top - _bot, syminfo.mintick)
            _ageExpired = (bar_index - _bar) > fvgMaxAge
            _depth = math.max(0.0, (_top - low) / _zone)
            _filledConfirmed = barstate.isconfirmed and bar_index > _bar and close < _bot
            if _filledConfirmed
                array.set(bullFilledThisBarArr, i, true)

            _invalidate = _ageExpired or isAccum

            if _invalidate
                _bx = array.get(bullBoxArr, i)
                if not na(_bx)
                    box.delete(_bx)
                array.set(bullDeadArr, i, true)

// Bear FVG side
if array.size(bearTopArr) > 0
    for i = array.size(bearTopArr) - 1 to 0
        if not array.get(bearDeadArr, i)
            _top = array.get(bearTopArr, i)
            _bot = array.get(bearBotArr, i)
            _bar = array.get(bearBarArr, i)
            _zone = math.max(_top - _bot, syminfo.mintick)
            _ageExpired = (bar_index - _bar) > fvgMaxAge
            _depth = math.max(0.0, (high - _bot) / _zone)
            _filledConfirmed = barstate.isconfirmed and bar_index > _bar and close > _top
            if _filledConfirmed
                array.set(bearFilledThisBarArr, i, true)
            _invalidate = _ageExpired or isAccum

            if _invalidate
                _bx = array.get(bearBoxArr, i)
                if not na(_bx)
                    box.delete(_bx)
                array.set(bearDeadArr, i, true)

bool bullFillHappenedThisBar = false
bool bearFillHappenedThisBar = false

if array.size(bullFilledThisBarArr) > 0
    for i = 0 to array.size(bullFilledThisBarArr) - 1
        if array.get(bullFilledThisBarArr, i)
            bullFillHappenedThisBar := true

if array.size(bearFilledThisBarArr) > 0
    for i = 0 to array.size(bearFilledThisBarArr) - 1
        if array.get(bearFilledThisBarArr, i)
            bearFillHappenedThisBar := true

// Bear FVG埋め = BUYのみ許可方向
if bearFillHappenedThisBar
    if absorbBias == 0
        absorbBias := 1
    else if absorbBias == -1
        absorbBias := 2

// Bull FVG埋め = SELLのみ許可方向
if bullFillHappenedThisBar
    if absorbBias == 0
        absorbBias := -1
    else if absorbBias == 1
        absorbBias := 2

    // このバーで一度でも埋めたFVGは、次バー以降は二度と使えない
if array.size(bullFilledThisBarArr) > 0
    for i = 0 to array.size(bullFilledThisBarArr) - 1
        if array.get(bullFilledThisBarArr, i)
            array.set(bullReboundUsedArr, i, true)

if array.size(bearFilledThisBarArr) > 0
    for i = 0 to array.size(bearFilledThisBarArr) - 1
        if array.get(bearFilledThisBarArr, i)
            array.set(bearReboundUsedArr, i, true)

// =====================================================
// Scan rebound candidates（FVGごとに1回だけ）
// 反発BUY = Bull rebound / 反発SELL = Bear rebound（BUYミラー版）
// =====================================================

// MSS窓と許可シグナル（反発側だけここで作る。吸収側は⑥で別途）
mssWindowOk_RB = not na(lastMssBar_RB) and (bar_index - lastMssBar_RB <= mssValidBars)
mssWindowOk_RS = not na(lastMssBar_RS) and (bar_index - lastMssBar_RS <= mssValidBars)

buyBiasAllowed   = absorbBias == 0 or absorbBias ==  1
sellBiasAllowed  = absorbBias == 0 or absorbBias == -1

buySignalAllowed_RB  = phaseActive_RB and buyBiasAllowed  and isTokyoSession and mssWindowOk_RB
sellSignalAllowed_RS = phaseActive_RS and sellBiasAllowed and isTokyoSession and mssWindowOk_RS

bullReboundIdx  = -1
bearReboundIdx  = -1

// ----- Bull rebound = 反発BUY -----
if phaseActive_RB and not manualNewsBlock and isTokyoSession and array.size(bullTopArr) > 0
    for i = array.size(bullTopArr) - 1 to 0
        if bullReboundIdx == -1 and not array.get(bullDeadArr, i) and not array.get(bullReboundUsedArr, i)
            _top = array.get(bullTopArr, i)
            _bot = array.get(bullBotArr, i)
            _bar = array.get(bullBarArr, i)
            _ref = array.get(bullRefArr, i)
            _thickRel = _ref > 0 ? (_top - _bot) / _ref : 0.0           // ← 追加
            _thickOk  = _thickRel >= fvgThicknessMin_Reb                 // ← 追加
            if _thickOk                                                   // ← 追加（以下の処理を if 内に）
                _zone = math.max(_top - _bot, syminfo.mintick)
                _depth = math.max(0.0, (_top - low) / _zone)
                _touched = bar_index > _bar and low <= _top and high >= _bot
                _blockedByOpposite = f_has_near_opposite_bear_for_bull(_top, _bot, _ref)
                _barRange    = high - low
                _bodyAbs     = math.abs(close - open)
                _bodyStrong  = not useStrictBar_RB or (_barRange > 0 and _bodyAbs >= _barRange * barBodyMinRatio_RB)
                _closeNearHi = not useStrictBar_RB or (_barRange > 0 and (close - low) / _barRange >= barCloseEdgeRatio_RB)
                _bullBar     = not useStrictBar_RB or close > open
                _riskCheck   = (close - (_bot - slOffset)) >= minRisk
                _confirm = not _blockedByOpposite and buySignalAllowed_RB and _touched and _depth < confirmDepth_RB and _bullBar and _closeNearHi and _bodyStrong and _riskCheck
                _prevTouched = bar_index - 1 > _bar and low[1] <= _top and high[1] >= _bot
                _prevDepth   = math.max(0.0, (_top - math.min(open[1], close[1])) / _zone)
                _prevDepthOk = _prevDepth < confirmDepth_RB
                _confirmDeferred = not _blockedByOpposite and buySignalAllowed_RB and _prevTouched and _prevDepthOk and _bullBar and _closeNearHi and _bodyStrong and _riskCheck
                if _confirm or _confirmDeferred
                    bullReboundIdx := i

// ----- Bear rebound = 反発SELL -----
if phaseActive_RS and not manualNewsBlock and isTokyoSession and array.size(bearTopArr) > 0
    for i = array.size(bearTopArr) - 1 to 0
        if bearReboundIdx == -1 and not array.get(bearDeadArr, i) and not array.get(bearReboundUsedArr, i)
            _top = array.get(bearTopArr, i)
            _bot = array.get(bearBotArr, i)
            _bar = array.get(bearBarArr, i)
            _ref = array.get(bearRefArr, i)
            _thickRel = _ref > 0 ? (_top - _bot) / _ref : 0.0           // ← 追加
            _thickOk  = _thickRel >= fvgThicknessMin_Reb                 // ← 追加
            if _thickOk                                                   // ← 追加
                _zone = math.max(_top - _bot, syminfo.mintick)
                _depth = math.max(0.0, (high - _bot) / _zone)
                _touched = bar_index > _bar and high >= _bot and low <= _top
                _blockedByOpposite = f_has_near_opposite_bull_for_bear(_top, _bot, _ref)
                _barRange    = high - low
                _bodyAbs     = math.abs(close - open)
                _bodyStrong  = not useStrictBar_RS or (_barRange > 0 and _bodyAbs >= _barRange * barBodyMinRatio_RS)
                _closeNearLo = not useStrictBar_RS or (_barRange > 0 and (high - close) / _barRange >= barCloseEdgeRatio_RS)
                _bearBar     = not useStrictBar_RS or close < open
                _riskCheck   = ((_top + slOffset) - close) >= minRisk
                _confirm = not _blockedByOpposite and sellSignalAllowed_RS and _touched and _depth < confirmDepth_RS and _bearBar and _closeNearLo and _bodyStrong and _riskCheck
                _prevTouched = bar_index - 1 > _bar and high[1] >= _bot and low[1] <= _top
                _prevDepth   = math.max(0.0, (math.max(open[1], close[1]) - _bot) / _zone)
                _prevDepthOk = _prevDepth < confirmDepth_RS
                _confirmDeferred = not _blockedByOpposite and sellSignalAllowed_RS and _prevTouched and _prevDepthOk and _bearBar and _closeNearLo and _bodyStrong and _riskCheck
                if _confirm or _confirmDeferred
                    bearReboundIdx := i

// =====================================================
// Scan absorption candidates
// 最新FVG優先。最新FVGが薄く、すぐ手前に厚いFVGが近接しているなら
// 最新は発火させず、手前FVGの充足を待つ
// =====================================================

// MSS窓 / 許可シグナル（吸収側）
mssWindowOk_AB = not na(lastMssBar_AB) and (bar_index - lastMssBar_AB <= mssValidBars)
mssWindowOk_AS = not na(lastMssBar_AS) and (bar_index - lastMssBar_AS <= mssValidBars)

buySignalAllowed_AB  = phaseActive_AB and buyBiasAllowed  and isTokyoSession and mssWindowOk_AB
sellSignalAllowed_AS = phaseActive_AS and sellBiasAllowed and isTokyoSession and mssWindowOk_AS

buyAbsorbProv  = false
sellAbsorbProv = false
buyAbsorbIdx   = -1
sellAbsorbIdx  = -1

// ----- BUY吸収 = Bear FVG が MSS後に上抜け（吸収BUY仕様） -----
if phaseActive_AB and not manualNewsBlock and isTokyoSession
    latestBearFilledIdx = -1

    if array.size(bearTopArr) > 0 and not na(lastMssBar_AB)
        for i = array.size(bearTopArr) - 1 to 0
            _fvgBar = array.get(bearBarArr, i)
            _afterMss = _fvgBar > lastMssBar_AB
            if latestBearFilledIdx == -1 and _afterMss and not array.get(bearDeadArr, i) and not array.get(bearAbsorbUsedArr, i)
                _topI = array.get(bearTopArr, i)
                _filledIntra = bar_index > _fvgBar and close > _topI
                if array.get(bearFilledThisBarArr, i) or _filledIntra
                    latestBearFilledIdx := i

    if latestBearFilledIdx != -1 and buySignalAllowed_AB
        _idx = latestBearFilledIdx
        _top = array.get(bearTopArr, _idx)
        _bot = array.get(bearBotArr, _idx)
        _ref = array.get(bearRefArr, _idx)
        _width = _top - _bot

        _usePrev = false
        _prevIdx = -1
        _thin = (_ref > 0) and ((_width / _ref) <= absorbThinRatioMax)

        if _idx > 0
            for j = _idx - 1 to 0
                _prevBar = array.get(bearBarArr, j)
                _prevAfterMss = _prevBar > lastMssBar_AB
                if _prevIdx == -1 and _prevAfterMss and not array.get(bearDeadArr, j) and not array.get(bearAbsorbUsedArr, j)
                    _prevIdx := j

        if _thin and _prevIdx != -1
            _ptop = array.get(bearTopArr, _prevIdx)
            _pbot = array.get(bearBotArr, _prevIdx)
            _pwidth = _ptop - _pbot
            _gap = f_zone_gap(_top, _bot, _ptop, _pbot)
            _near = (_ref > 0) and ((_gap / _ref) <= absorbNearGapMax)
            _prevThicker = _pwidth > _width
            if _near and _prevThicker
                _usePrev := true
                if barstate.isconfirmed
                    array.set(bearAbsorbUsedArr, _idx, true)

        _chosenIdx = _idx
        if _usePrev
            if _prevIdx != -1
                _ptop2 = array.get(bearTopArr, _prevIdx)
                _pbar  = array.get(bearBarArr, _prevIdx)
                if _pbar > lastMssBar_AB and bar_index > _pbar and close > _ptop2
                    _chosenIdx := _prevIdx
                else
                    _chosenIdx := -1

        if _chosenIdx != -1
            _ctop = array.get(bearTopArr, _chosenIdx)
            _cbot = array.get(bearBotArr, _chosenIdx)
            _cref = array.get(bearRefArr, _chosenIdx)                              // ← 追加
            _cThickRel = _cref > 0 ? (_ctop - _cbot) / _cref : 0.0                 // ← 追加
            _cThickOk  = _cThickRel >= fvgThicknessMin_Abs
            _bodyOk     = close > open
            _barRange   = high - low
            _bodyRatio  = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
            _bodyStrong = _bodyRatio >= absorbBodyMinRatio
            _closeNearHi = _barRange > 0 and (close - low) / _barRange >= absorbCloseEdgeRatio

            _buySL    = _cbot - slOffset
            _buyRisk  = close - _buySL
            _buyRiskOk = _buyRisk > 0 and _buyRisk <= maxRisk

            if _bodyOk and close > _ctop and _buyRiskOk and _bodyStrong and _closeNearHi and _buyRisk >= minRisk and _cThickOk
                buyAbsorbIdx  := _chosenIdx
                buyAbsorbProv := true

// ----- SELL吸収 = Bull FVG が MSS後に下抜け（吸収SELL仕様） -----
if phaseActive_AS and not manualNewsBlock and isTokyoSession
    latestBullFilledIdx = -1

    if array.size(bullTopArr) > 0 and not na(lastMssBar_AS)
        for i = array.size(bullTopArr) - 1 to 0
            _fvgBar = array.get(bullBarArr, i)
            _afterMss = _fvgBar > lastMssBar_AS
            if latestBullFilledIdx == -1 and _afterMss and not array.get(bullDeadArr, i) and not array.get(bullAbsorbUsedArr, i)
                _botI = array.get(bullBotArr, i)
                _filledIntra = bar_index > _fvgBar and close < _botI
                if array.get(bullFilledThisBarArr, i) or _filledIntra
                    latestBullFilledIdx := i

    if latestBullFilledIdx != -1 and sellSignalAllowed_AS
        _idx = latestBullFilledIdx
        _top = array.get(bullTopArr, _idx)
        _bot = array.get(bullBotArr, _idx)
        _ref = array.get(bullRefArr, _idx)
        _width = _top - _bot

        _usePrev = false
        _prevIdx = -1
        _thin = (_ref > 0) and ((_width / _ref) <= absorbThinRatioMax)

        if _idx > 0
            for j = _idx - 1 to 0
                _prevBar = array.get(bullBarArr, j)
                _prevAfterMss = _prevBar > lastMssBar_AS
                if _prevIdx == -1 and _prevAfterMss and not array.get(bullDeadArr, j) and not array.get(bullAbsorbUsedArr, j)
                    _prevIdx := j

        if _thin and _prevIdx != -1
            _ptop = array.get(bullTopArr, _prevIdx)
            _pbot = array.get(bullBotArr, _prevIdx)
            _pwidth = _ptop - _pbot
            _gap = f_zone_gap(_top, _bot, _ptop, _pbot)
            _near = (_ref > 0) and ((_gap / _ref) <= absorbNearGapMax)
            _prevThicker = _pwidth > _width
            if _near and _prevThicker
                _usePrev := true
                if barstate.isconfirmed
                    array.set(bullAbsorbUsedArr, _idx, true)

        _chosenIdx = _idx
        if _usePrev
            if _prevIdx != -1
                _pbot2 = array.get(bullBotArr, _prevIdx)
                _pbar  = array.get(bullBarArr, _prevIdx)
                if _pbar > lastMssBar_AS and bar_index > _pbar and close < _pbot2
                    _chosenIdx := _prevIdx
                else
                    _chosenIdx := -1

        if _chosenIdx != -1
            _ctop = array.get(bullTopArr, _chosenIdx)
            _cbot = array.get(bullBotArr, _chosenIdx)
            _cref = array.get(bullRefArr, _chosenIdx)                              // ← 追加
            _cThickRel = _cref > 0 ? (_ctop - _cbot) / _cref : 0.0                 // ← 追加
            _cThickOk  = _cThickRel >= fvgThicknessMin_Abs
            _bodyOk     = close < open
            _barRange   = high - low
            _bodyRatio  = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
            _bodyStrong = _bodyRatio >= absorbBodyMinRatio
            _closeNearLo = _barRange > 0 and (high - close) / _barRange >= absorbCloseEdgeRatio

            _sellSL   = _ctop + slOffset
            _sellRisk = _sellSL - close
            _sellRiskOk = _sellRisk > 0 and _sellRisk <= maxRisk

            if _bodyOk and close < _cbot and _sellRiskOk and _bodyStrong and _closeNearLo and _sellRisk >= minRisk and _cThickOk
                sellAbsorbIdx  := _chosenIdx
                sellAbsorbProv := true

// =====================================================
// Absorption > Rebound priority
// BUY rebound is suppressed by SELL absorb
// SELL rebound is suppressed by BUY absorb
// =====================================================
bullAbsorbConfirm = buyAbsorbIdx != -1
bearAbsorbConfirm = sellAbsorbIdx != -1

bullReboundConfirm = bullReboundIdx != -1 and not bearAbsorbConfirm and not bullAbsorbConfirm
bearReboundConfirm = bearReboundIdx != -1 and not bullAbsorbConfirm and not bearAbsorbConfirm
// =====================================================
// Fire confirmed signals
// FVGごとに1回だけ
// =====================================================
// 各シグナルの最終確定
sig_RB = barstate.isconfirmed and is5m and bullReboundConfirm and isRangeMode_RB and priceZone_RB and not holidayBlock
sig_RS = barstate.isconfirmed and is5m and bearReboundConfirm and isRangeMode_RS and priceZone_RS and not holidayBlock
sig_AB = barstate.isconfirmed and is5m and bullAbsorbConfirm  and isRangeMode_AB and priceZone_AB and not holidayBlock
sig_AS = barstate.isconfirmed and is5m and bearAbsorbConfirm  and isRangeMode_AS and priceZone_AS and not holidayBlock

// =====================================================
// 仮シグナル（リアルタイム / バー形状フィルタを外したゆるめ版）
// barstate.isconfirmed を含めない = 足途中で条件が揃った瞬間に発火
// =====================================================
// 反発: sig_RB / sig_RS と同条件、barstate.isconfirmed だけ外す
// → _confirm / _confirmDeferred どちらも intra-bar 評価で拾える
loose_RB = is5m and bullReboundConfirm and isRangeMode_RB and priceZone_RB and not holidayBlock
loose_RS = is5m and bearReboundConfirm and isRangeMode_RS and priceZone_RS and not holidayBlock

// 吸収: そのまま（FVG上抜けの瞬間 = 確定の intra-bar 早期版）
loose_AB = is5m and buyAbsorbProv   and isRangeMode_AB and priceZone_AB and not holidayBlock and phaseActive_AB
loose_AS = is5m and sellAbsorbProv  and isRangeMode_AS and priceZone_AS and not holidayBlock and phaseActive_AS
// =====================================================
// 仮アラート発火管理（確定が出るまでにフェーズで1回だけ）
// =====================================================
var int tentFiredIdx_RB = -1
var int tentFiredIdx_RS = -1
var int tentFiredIdx_AB = -1
var int tentFiredIdx_AS = -1

if sig_RB or newAccumAny
    tentFiredIdx_RB := -1
if sig_RS or newAccumAny
    tentFiredIdx_RS := -1
if sig_AB or newAccumAny
    tentFiredIdx_AB := -1
if sig_AS or newAccumAny
    tentFiredIdx_AS := -1

// 時間ブロック / レンジモード外 / ゾーン外 等で sig_* が不発でも、
// 埋めが起きたFVGは「使用済み」にして次バー以降に使い回されないようにする
if array.size(bullFilledThisBarArr) > 0
    for i = 0 to array.size(bullFilledThisBarArr) - 1
        if array.get(bullFilledThisBarArr, i)
            array.set(bullAbsorbUsedArr, i, true)

if array.size(bearFilledThisBarArr) > 0
    for i = 0 to array.size(bearFilledThisBarArr) - 1
        if array.get(bearFilledThisBarArr, i)
            array.set(bearAbsorbUsedArr, i, true)

// =====================================================
// 仮アラート（リアルタイム・ラベルなし・フェーズ1回）
// =====================================================
if loose_RB and not sig_RB and bullReboundIdx != tentFiredIdx_RB
    _slBase = array.get(bullBotArr, bullReboundIdx)
    _sl = _slBase - slOffset
    _risk = close - _sl
    alert("仮 レンジ反発BUY E:" + str.tostring(close, "#.##") + " SL:" + str.tostring(_sl, "#.##") + " 幅:" + str.tostring(_risk, "#.##") + "ドル", alert.freq_once_per_bar)
    tentFiredIdx_RB := bullReboundIdx

if loose_RS and not sig_RS and bearReboundIdx != tentFiredIdx_RS
    _slBase = array.get(bearTopArr, bearReboundIdx)
    _sl = _slBase + slOffset
    _risk = _sl - close
    alert("仮 レンジ反発SELL E:" + str.tostring(close, "#.##") + " SL:" + str.tostring(_sl, "#.##") + " 幅:" + str.tostring(_risk, "#.##") + "ドル", alert.freq_once_per_bar)
    tentFiredIdx_RS := bearReboundIdx

if loose_AB and not sig_AB and buyAbsorbIdx != tentFiredIdx_AB
    _slBase = array.get(bearBotArr, buyAbsorbIdx)
    _sl = _slBase - slOffset
    _risk = close - _sl
    alert("仮 レンジ吸収BUY E:" + str.tostring(close, "#.##") + " SL:" + str.tostring(_sl, "#.##") + " 幅:" + str.tostring(_risk, "#.##") + "ドル", alert.freq_once_per_bar)
    tentFiredIdx_AB := buyAbsorbIdx

if loose_AS and not sig_AS and sellAbsorbIdx != tentFiredIdx_AS
    _slBase = array.get(bullTopArr, sellAbsorbIdx)
    _sl = _slBase + slOffset
    _risk = _sl - close
    alert("仮 レンジ吸収SELL E:" + str.tostring(close, "#.##") + " SL:" + str.tostring(_sl, "#.##") + " 幅:" + str.tostring(_risk, "#.##") + "ドル", alert.freq_once_per_bar)
    tentFiredIdx_AS := sellAbsorbIdx

// MA近接でSL/TPをEMAへスナップ（線の上下どちらのEMAでも、最も近いものに寄せる）
// _dir: 1=long / -1=short   戻り値: [調整後SL, 調整後TP]
f_adjust_sl_tp(_dir, _entry, _slRaw, _tpRaw) =>
    _risk0 = math.abs(_entry - _slRaw)
    _thr   = _risk0 * maNearPct
    _slOut = _slRaw
    _tpOut = _tpRaw
    if useMaSLTP and _risk0 > 0 and array.size(maArr) > 0
        _slMA   = float(na)
        _slBest = float(na)
        _tpMA   = float(na)
        _tpBest = float(na)
        for _i = 0 to array.size(maArr) - 1
            _m = array.get(maArr, _i)
            if not na(_m)
                _dSL = math.abs(_m - _slRaw)
                if _dSL <= _thr and (na(_slBest) or _dSL < _slBest)
                    _slBest := _dSL
                    _slMA   := _m
                _dTP = math.abs(_m - _tpRaw)
                if _dTP <= _thr and (na(_tpBest) or _dTP < _tpBest)
                    _tpBest := _dTP
                    _tpMA   := _m
        if _dir == 1
            if not na(_slMA)
                _candSL = _slMA - maSlBuffer
                _slOut := math.min(_candSL, _entry - minRisk)
            if not na(_tpMA)
                _candTP = _tpMA - maTpBuffer
                if _candTP > _entry
                    _tpOut := _candTP
        else
            if not na(_slMA)
                _candSL = _slMA + maSlBuffer
                _slOut := math.max(_candSL, _entry + minRisk)
            if not na(_tpMA)
                _candTP = _tpMA + maTpBuffer
                if _candTP < _entry
                    _tpOut := _candTP
    [_slOut, _tpOut]

// ラベル発火ヘルパ
f_fire_label(_dir, _e, _sl, _tp, _txt, _col) =>
    _rk = _dir == 1 ? _e - _sl : _sl - _e
    if _rk > 0
        label.new(bar_index, _dir == 1 ? low : high, _txt + "\nE:" + str.tostring(_e, "#.##") + "\nSL:" + str.tostring(_sl, "#.##") + "\nTP:" + str.tostring(_tp, "#.##"), style = _dir == 1 ? label.style_label_up : label.style_label_down, color = _col, textcolor = color.white, size = size.small)

if sig_RB and (na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars)
    _idx = bullReboundIdx
    _slBase = array.get(bullBotArr, _idx)
    _slRaw  = _slBase - slOffset
    _riskRaw = close - _slRaw
    _tpRaw   = close + _riskRaw * rr1_Reb
    [_sl, _tp] = f_adjust_sl_tp(1, close, _slRaw, _tpRaw)
    _risk = close - _sl
    _reward = _tp - close
    _rrNow  = _risk > 0 ? _reward / _risk : 0.0
    _rawContracts = (strategy.initial_capital * riskPctPerTrade / 100) / _risk
    _rawLot = _rawContracts / contractsPerLot
    _lotFloored = math.floor(_rawLot / minLotSize) * minLotSize
    if _risk > 0 and _lotFloored >= minLotSize and (not useRRmin or _rrNow >= rrMin)
        _qty = useRiskBasedSize ? _lotFloored * contractsPerLot : na
        _tag = "RB_" + str.tostring(bar_index)
        strategy.entry(_tag, strategy.long, qty=_qty, comment="RB")
        strategy.exit(_tag + "_x", from_entry=_tag, stop=_sl, limit=_tp)
        map.put(beTpMap, _tag, _tp)
        f_fire_label(1, close, _sl, _tp, "レンジ反発BUY", color.new(color.lime, 0))
        array.set(bullReboundUsedArr, _idx, true)
        lastEntryBar := bar_index

if sig_RS and (na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars)
    _idx = bearReboundIdx
    _slBase = array.get(bearTopArr, _idx)
    _slRaw  = _slBase + slOffset
    _riskRaw = _slRaw - close
    _tpRaw   = close - _riskRaw * rr1_Reb
    [_sl, _tp] = f_adjust_sl_tp(-1, close, _slRaw, _tpRaw)
    _risk = _sl - close
    _reward = close - _tp
    _rrNow  = _risk > 0 ? _reward / _risk : 0.0
    _rawContracts = (strategy.initial_capital * riskPctPerTrade / 100) / _risk
    _rawLot = _rawContracts / contractsPerLot
    _lotFloored = math.floor(_rawLot / minLotSize) * minLotSize
    if _risk > 0 and _lotFloored >= minLotSize and (not useRRmin or _rrNow >= rrMin)
        _qty = useRiskBasedSize ? _lotFloored * contractsPerLot : na
        _tag = "RS_" + str.tostring(bar_index)
        strategy.entry(_tag, strategy.short, qty=_qty, comment="RS")
        strategy.exit(_tag + "_x", from_entry=_tag, stop=_sl, limit=_tp)
        map.put(beTpMap, _tag, _tp)
        f_fire_label(-1, close, _sl, _tp, "レンジ反発SELL", color.new(color.red, 0))
        array.set(bearReboundUsedArr, _idx, true)
        lastEntryBar := bar_index

if sig_AB and (na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars)
    _idx = buyAbsorbIdx
    _slBase = array.get(bearBotArr, _idx)
    _slRaw  = _slBase - slOffset
    _riskRaw = close - _slRaw
    _tpRaw   = close + _riskRaw * rr1_Abs
    [_sl, _tp] = f_adjust_sl_tp(1, close, _slRaw, _tpRaw)
    _risk = close - _sl
    _reward = _tp - close
    _rrNow  = _risk > 0 ? _reward / _risk : 0.0
    _rawContracts = (strategy.initial_capital * riskPctPerTrade / 100) / _risk
    _rawLot = _rawContracts / contractsPerLot
    _lotFloored = math.floor(_rawLot / minLotSize) * minLotSize
    if _risk > 0 and _lotFloored >= minLotSize and (not useRRmin or _rrNow >= rrMin)
        _qty = useRiskBasedSize ? _lotFloored * contractsPerLot : na
        _tag = "AB_" + str.tostring(bar_index)
        strategy.entry(_tag, strategy.long, qty=_qty, comment="AB")
        strategy.exit(_tag + "_x", from_entry=_tag, stop=_sl, limit=_tp)
        map.put(beTpMap, _tag, _tp)
        f_fire_label(1, close, _sl, _tp, "吸収BUY", color.new(color.aqua, 0))
        array.set(bearAbsorbUsedArr, _idx, true)
        lastEntryBar := bar_index

if sig_AS and (na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars)
    _idx = sellAbsorbIdx
    _slBase = array.get(bullTopArr, _idx)
    _slRaw  = _slBase + slOffset
    _riskRaw = _slRaw - close
    _tpRaw   = close - _riskRaw * rr1_Abs
    [_sl, _tp] = f_adjust_sl_tp(-1, close, _slRaw, _tpRaw)
    _risk = _sl - close
    _reward = close - _tp
    _rrNow  = _risk > 0 ? _reward / _risk : 0.0
    _rawContracts = (strategy.initial_capital * riskPctPerTrade / 100) / _risk
    _rawLot = _rawContracts / contractsPerLot
    _lotFloored = math.floor(_rawLot / minLotSize) * minLotSize
    if _risk > 0 and _lotFloored >= minLotSize and (not useRRmin or _rrNow >= rrMin)
        _qty = useRiskBasedSize ? _lotFloored * contractsPerLot : na
        _tag = "AS_" + str.tostring(bar_index)
        strategy.entry(_tag, strategy.short, qty=_qty, comment="AS")
        strategy.exit(_tag + "_x", from_entry=_tag, stop=_sl, limit=_tp)
        map.put(beTpMap, _tag, _tp)
        f_fire_label(-1, close, _sl, _tp, "吸収SELL", color.new(color.fuchsia, 0))
        array.set(bullAbsorbUsedArr, _idx, true)
        lastEntryBar := bar_index

// =====================================================
// 建値移動（ブレイクイーブン）
// 含み益が beTrigger($) に達したら SL を建値へ移動
// =====================================================
if useBE and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        _eid  = strategy.opentrades.entry_id(i)
        _ep   = strategy.opentrades.entry_price(i)
        _long = strategy.opentrades.size(i) > 0
        _tp   = map.contains(beTpMap, _eid) ? map.get(beTpMap, _eid) : na
        if _long and high >= _ep + beTrigger
            strategy.exit(_eid + "_x", from_entry=_eid, stop=_ep, limit=_tp)
        else if not _long and low <= _ep - beTrigger
            strategy.exit(_eid + "_x", from_entry=_eid, stop=_ep, limit=_tp)

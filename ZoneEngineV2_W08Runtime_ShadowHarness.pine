//@version=6
// ============================================================
// ZoneEngineV2_W08Runtime_ShadowHarness - W08 B15-B2 shadow runtime entry probe
//
// Builds scratch W08Core /16 stores and empty reference views on the first bar (no production Main state, no market
// logic) and drives the W08Runtime /3 shadow entries with the W08Core /16 and W08Touch /3 types. Checks:
//   1 stores / views / context construct and planPass returns a plan (empty pass: 0 changed components)
//   2 pass F0 on the empty pass passes (one global pending pool scan)
//   3 commitPass on the empty pass commits and writes nothing (registry sizes, pool, scalars unchanged)
//   4 a second no-op pass (runShadow) gives the same state
//   5 an invalid F0 (nextCoreId = 0 breaks the materialization F0) is rejected and changes nothing
// Any mismatch raises runtime.error naming the failed check; SHADOW_PROBE_PASS = 1 only when all 5 checks pass.
// ============================================================
indicator("ZoneEngineV2_W08Runtime_ShadowHarness", overlay = false)

import sekine3310/ZoneEngineV2_W08Core_Worker/16 as W08Core
import sekine3310/ZoneEngineV2_W08Touch_Worker/3 as W08Touch
import sekine3310/ZoneEngineV2_W08Runtime_Worker/3 as W08Runtime

var int shadowProbePass = 0
var int checksPass      = 0

stateSize(W08Runtime.ShadowContext ctx) =>
    W08Core.CoreRegistryStore cr = ctx.ws.coreRegistry
    array.size(cr.coreIds) + array.size(cr.coreLiveSlots) + array.size(cr.coreFreeSlots) + array.size(cr.touchMarkTimes) + array.size(ctx.ps.corePendingTopologyFlags) + array.size(ctx.ps.pendingTopologyChildLiveFlags) + array.size(ctx.ps.pendingTopologyRootNodeLiveFlags) + array.size(ctx.pv.participationEdgeLiveFlags) + array.size(ctx.hv.phaseWaitingSideSlots) + array.size(ctx.ws.coreIntervalOrderData)

if barstate.isfirst
    W08Core.W08Store ws = W08Core.newStore()
    W08Core.CoreRegistryStore cr = ws.coreRegistry
    cr.touchMarkCapacityPerCore := 4
    W08Runtime.RootView rv = W08Runtime.RootView.new(array.new_int(0), array.new_bool(0), map.new<int, int>(), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0))
    W08Runtime.ParticipationView pv = W08Runtime.ParticipationView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Runtime.PhaseSetView hv = W08Runtime.PhaseSetView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0))
    W08Runtime.WinnerView wv = W08Runtime.WinnerView.new(0, 0, array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_int(0), array.new_int(0), array.new_int(0))
    W08Runtime.ComponentMetaView mv = W08Runtime.ComponentMetaView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.from(false))
    W08Core.PendingTopologyStore ps = W08Core.PendingTopologyStore.new(cr.corePendingTopologyFlags, cr.corePendingTopologyChildHeadIndexes, cr.corePendingTopologyChildTailIndexes, cr.corePendingTopologyChildCounts, array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Touch.TouchPlan tp = W08Touch.TouchPlan.new(array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0))
    W08Runtime.ShadowScalars sc = W08Runtime.ShadowScalars.new(1, 1, 1, 0, false)
    W08Runtime.ShadowContext ctx = W08Runtime.ShadowContext.new(ws, rv, pv, hv, wv, mv, ps, ps, tp, W08Touch.newSplitTouchPlan(), sc, 1.0, 0.01)
    int size0 = stateSize(ctx)

    // Check 1 / 2 / 3: empty pass plan -> F0 -> commit, nothing written.
    W08Runtime.ShadowPass pr1 = W08Runtime.planPass(ctx)
    bool c1 = pr1.planResult == 0 and pr1.appliedTargets == 0
    bool f0 = W08Runtime.preflightPass(ctx, pr1, 1000)
    bool c2 = f0 and pr1.preflightOk and pr1.poolScans == 1
    if f0
        W08Runtime.commitPass(ctx, pr1, 1000)
    bool c3 = pr1.committed and pr1.freshApplied == 0 and pr1.freed == 0 and pr1.touchRowsWritten == 0 and stateSize(ctx) == size0 and sc.nextCoreId == 1 and sc.nextGenerationId == 1 and sc.coreRangeRevision == 0

    // Check 4: a second no-op pass through runShadow.
    W08Runtime.ShadowPass pr2 = W08Runtime.runShadow(ctx, 2000)
    bool c4 = pr2.committed and pr2.planResult == 0 and stateSize(ctx) == size0 and sc.nextCoreId == 1

    // Check 5: invalid F0 (nextCoreId 0 fails the materialization F0) -> rejected, nothing written.
    sc.nextCoreId := 0
    W08Runtime.ShadowPass pr3 = W08Runtime.planPass(ctx)
    bool f0Bad = W08Runtime.preflightPass(ctx, pr3, 3000)
    bool c5 = not f0Bad and not pr3.preflightOk and not pr3.committed and stateSize(ctx) == size0 and sc.nextCoreId == 0
    sc.nextCoreId := 1

    if not c1
        runtime.error("B15B2_SHADOW_PROBE_FAIL: check 1 empty plan")
    if not c2
        runtime.error("B15B2_SHADOW_PROBE_FAIL: check 2 empty pr1 F0")
    if not c3
        runtime.error("B15B2_SHADOW_PROBE_FAIL: check 3 no-op commit")
    if not c4
        runtime.error("B15B2_SHADOW_PROBE_FAIL: check 4 no-op shadow pr1")
    if not c5
        runtime.error("B15B2_SHADOW_PROBE_FAIL: check 5 invalid F0 no mutation")
    checksPass      := (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0)
    shadowProbePass := checksPass == 5 ? 1 : 0

plot(shadowProbePass, "SHADOW_PROBE_PASS")
plot(checksPass, "SHADOW_PROBE_CHECKS_PASSED", display = display.data_window)

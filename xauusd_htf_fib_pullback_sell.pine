// © ka.mickey15
//
// XAUUSD HTF Downtrend Fib Pullback Sell Strategy
// -----------------------------------------------
// 上位足(4H/15M/5M)が下降目線のとき、直近下降波のフィボ 38.2%〜61.8% 戻し帯を
// 「売りゾーン」として扱い、FVG / iFVG / レジサポ転換が重なり、かつ下位足で
// 反転(失速)が確認できた場合にのみ戻り売り SELL を行う順張り戦略。
//
// 思想: 下落 → 戻り → 売りゾーン到達 → 下位足で反転確認 → SELL
//        単なるフィボ到達だけでは入らない。

//@version=5
strategy(
     title             = "XAUUSD HTF Downtrend Fib Pullback Sell Strategy",
     shorttitle        = "XAU HTF Fib Sell",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 10,
     calc_on_every_tick= false,
     max_bars_back     = 500,
     max_boxes_count   = 300,
     max_lines_count   = 300,
     max_labels_count  = 300
 )

// ============================================================
// 1. 上位足 下降トレンド フィルター
// ============================================================
grpHTF = "1) 上位足 下降フィルター"
useHTF4HFilter = input.bool(true,  "4時間足フィルターを使う",  group = grpHTF)
useMTF15MFilter= input.bool(true,  "15分足フィルターを使う",   group = grpHTF)
useLTF5MFilter = input.bool(true,  "5分足フィルターを使う",     group = grpHTF)
emaFastLen     = input.int(20,  "EMA Fast 期間", minval = 1, group = grpHTF)
emaSlowLen     = input.int(200, "EMA Slow 期間", minval = 1, group = grpHTF)
tf4H           = input.timeframe("240", "4時間足 TF", group = grpHTF)
tf15M          = input.timeframe("15",  "15分足 TF",  group = grpHTF)
tf5M           = input.timeframe("5",   "5分足 TF",   group = grpHTF)

// 下降目線の判定: 価格 < EMA200, EMA20 < EMA200, EMA20 傾き下向き
f_isDowntrend() =>
    emaF = ta.ema(close, emaFastLen)
    emaS = ta.ema(close, emaSlowLen)
    down = (close < emaS) and (emaF < emaS) and (emaF < emaF[1])
    down

htf4hDown  = request.security(syminfo.tickerid, tf4H,  f_isDowntrend(), lookahead = barmerge.lookahead_off)
mtf15mDown = request.security(syminfo.tickerid, tf15M, f_isDowntrend(), lookahead = barmerge.lookahead_off)
ltf5mDown  = request.security(syminfo.tickerid, tf5M,  f_isDowntrend(), lookahead = barmerge.lookahead_off)

// 5分足 EMA20 上抜け定着の判定 (無効条件用)
f_emaFast() => ta.ema(close, emaFastLen)
htfEmaFast  = request.security(syminfo.tickerid, tf5M, f_emaFast(), lookahead = barmerge.lookahead_off)
f_closeTf5() => close
close5m     = request.security(syminfo.tickerid, tf5M, f_closeTf5(), lookahead = barmerge.lookahead_off)

htfFilterOK = (not useHTF4HFilter  or htf4hDown) and (not useMTF15MFilter or mtf15mDown) and (not useLTF5MFilter  or ltf5mDown)

// ============================================================
// 共通: ATR
// ============================================================
grpGen = "共通設定"
atrLen = input.int(14, "ATR 期間", minval = 1, group = grpGen)
atr    = ta.atr(atrLen)

// EMA (現在足) — 可視化 / EMA リジェクト / EMA 重合判定用
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// ============================================================
// 2. 下降波の自動検出
// ============================================================
grpWave = "2) 下降波 検出"
swingLookback = input.int(5,   "スイング検出 左右本数", minval = 1, group = grpWave)
waveLookback  = input.int(100, "波の有効本数 (古すぎる波は無視)", minval = 10, group = grpWave)
minWaveATR    = input.float(2.0, "最低波幅 (ATR 倍)", minval = 0.0, step = 0.1, group = grpWave)

ph = ta.pivothigh(high, swingLookback, swingLookback)
pl = ta.pivotlow(low,  swingLookback, swingLookback)

var float lastPH    = na
var int   lastPHbar = na
var float lastPL    = na
var int   lastPLbar = na

if not na(ph)
    lastPH    := ph
    lastPHbar := bar_index - swingLookback
if not na(pl)
    lastPL    := pl
    lastPLbar := bar_index - swingLookback

// 下降波: スイング高値が先に出来て、その後に安値が出来た / 波幅が ATR×X 以上 / 古すぎない
validWave = not na(lastPH) and not na(lastPL) and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)

swingHigh = lastPH
swingLow  = lastPL
waveRange = swingHigh - swingLow

// SELL 用フィボ (安値起点で戻りを測る)
fib382 = swingLow + waveRange * 0.382
fib500 = swingLow + waveRange * 0.5
fib618 = swingLow + waveRange * 0.618

// ============================================================
// 3. 売りゾーン (38.2% 〜 61.8%)
// ============================================================
sellZoneLow  = fib382
sellZoneHigh = fib618

priceInSellZone = validWave and (close >= sellZoneLow) and (close <= sellZoneHigh)

// ============================================================
// 4. FVG / iFVG
// ============================================================
grpFVG = "4) FVG / iFVG"
useFVGFilter    = input.bool(true,  "FVG フィルターを使う", group = grpFVG)
fvgLookback     = input.int(50,   "FVG 保存本数", minval = 5, group = grpFVG)
fvgToleranceATR = input.float(0.3, "FVG 接触許容 (ATR 倍)", minval = 0.0, step = 0.1, group = grpFVG)

// Bearish FVG: 現在足の高値が 2本前の安値より下 (上方向に空いたギャップ)
bearishFVG = high < low[2]
// Bullish FVG: 現在足の安値が 2本前の高値より上 (下方向に空いたギャップ) — iFVG 判定の素材
bullishFVG = low > high[2]

// Bearish FVG ゾーンを保存 (top = low[2], bottom = high)
var array<float> fvgTop    = array.new_float()
var array<float> fvgBot    = array.new_float()
// Bullish FVG ゾーン (iFVG 化監視用)
var array<float> bullTop   = array.new_float()  // = low[0]
var array<float> bullBot   = array.new_float()  // = high[2]
var array<bool>  bullBroke = array.new_bool()   // 価格が下抜けて反転(iFVG化)したか

if bearishFVG and not na(low[2])
    array.unshift(fvgTop, low[2])
    array.unshift(fvgBot, high)
    if array.size(fvgTop) > fvgLookback
        array.pop(fvgTop)
        array.pop(fvgBot)

if bullishFVG and not na(high[2])
    array.unshift(bullTop, low)
    array.unshift(bullBot, high[2])
    array.unshift(bullBroke, false)
    if array.size(bullTop) > fvgLookback
        array.pop(bullTop)
        array.pop(bullBot)
        array.pop(bullBroke)

// 価格が Bearish FVG ゾーンに戻ったか (上方向への戻りで接触)
f_touchBearFVG() =>
    bool touched = false
    if array.size(fvgTop) > 0
        for i = 0 to array.size(fvgTop) - 1
            t = array.get(fvgTop, i) + atr * fvgToleranceATR
            b = array.get(fvgBot, i) - atr * fvgToleranceATR
            if (high >= b) and (low <= t)
                touched := true
    touched
fvgTouch = f_touchBearFVG()

// iFVG (簡易): 過去 Bullish FVG を価格が一度下抜け、その後レジスタンスとして機能。
// 下抜け検出 → broke=true。broke 済みゾーンに価格が下から戻って接触したら iFVG ヒット。
f_touchIFVG() =>
    bool hit = false
    if array.size(bullBot) > 0
        for i = 0 to array.size(bullBot) - 1
            b = array.get(bullBot, i)
            t = array.get(bullTop, i)
            broke = array.get(bullBroke, i)
            // ゾーン下限を明確に下抜けたら iFVG 化フラグ
            if close < b - atr * fvgToleranceATR
                array.set(bullBroke, i, true)
            // iFVG 化済みゾーンへ下から戻って接触 → レジスタンスとして機能
            if broke and (high >= b - atr * fvgToleranceATR) and (high <= t + atr * fvgToleranceATR)
                hit := true
    hit
ifvgTouch = f_touchIFVG()

fvgConfluence = (not useFVGFilter) or fvgTouch or ifvgTouch

// ============================================================
// 5. レジサポ転換 (Support → Resistance Flip)
// ============================================================
grpSR = "5) レジサポ転換"
useSRFlipFilter   = input.bool(true,  "レジサポ転換フィルターを使う", group = grpSR)
srLookback        = input.int(100, "サポレジ 探索本数", minval = 10, group = grpSR)
srTouchToleranceATR = input.float(0.3, "タッチ許容 (ATR 倍)", minval = 0.0, step = 0.1, group = grpSR)
minSRTouches      = input.int(2, "最低タッチ回数", minval = 1, group = grpSR)

// 簡易: 現在価格帯付近で過去 pivotlow が複数回タッチされた水平帯 = 旧サポート。
// その帯を一度下抜け、いま価格が戻って到達 → レジサポ転換とみなす。
f_srFlip() =>
    tol = atr * srTouchToleranceATR
    int touches = 0
    bool brokeBelow = false
    lvl = close
    if bar_index > srLookback
        for i = 1 to srLookback
            // 過去のスイング安値水準付近のタッチ数
            if not na(low[i]) and math.abs(low[i] - lvl) <= tol
                touches := touches + 1
            // 過去にその水準を明確に下抜けた事実があるか
            if not na(close[i]) and close[i] < lvl - tol
                brokeBelow := true
    flip = (touches >= minSRTouches) and brokeBelow
    flip
srFlip = f_srFlip()
srConfluence = (not useSRFlipFilter) or srFlip

// EMA 重合 (売りゾーン付近に EMA200/EMA20 がある)
emaConfluence = (math.abs(close - emaSlow) <= atr * 0.5) or (math.abs(close - emaFast) <= atr * 0.5)

// POC / VPVR 代用: 任意の水平線 (重合判定に使う)
grpPOC = "重合: 水平線 (POC/VPVR 代用)"
usePocLine = input.bool(false, "POC 水平線を使う", group = grpPOC)
pocPrice   = input.float(0.0, "POC 価格", group = grpPOC)
pocConfluence = usePocLine and (math.abs(close - pocPrice) <= atr * 0.5)

// 売りゾーンの重合判定 (検証しやすいよう個別ON/OFF + 判定モード)
grpConf = "重合判定"
useFVGConfluence    = input.bool(true,  "FVG 重合を使う",    group = grpConf)
useSRFlipConfluence = input.bool(true,  "SRFlip 重合を使う", group = grpConf)
useEMAConfluence    = input.bool(false, "EMA 重合を使う",    group = grpConf)
usePOCConfluence    = input.bool(false, "POC 重合を使う",    group = grpConf)
confluenceMode      = input.string("ANY", "重合判定モード", options = ["ANY", "ALL", "MIN_COUNT"], group = grpConf)
minConfluenceCount  = input.int(1, "MIN_COUNT: 最低重合数", minval = 1, group = grpConf)

// ON にした各条件が「満たされているか」
cFVG = useFVGConfluence    and (fvgTouch or ifvgTouch)
cSR  = useSRFlipConfluence and srFlip
cEMA = useEMAConfluence    and emaConfluence
cPOC = usePOCConfluence    and pocConfluence

enabledCount   = (useFVGConfluence ? 1 : 0) + (useSRFlipConfluence ? 1 : 0) + (useEMAConfluence ? 1 : 0) + (usePOCConfluence ? 1 : 0)
satisfiedCount = (cFVG ? 1 : 0) + (cSR ? 1 : 0) + (cEMA ? 1 : 0) + (cPOC ? 1 : 0)

// ANY: ONのうち1つ以上 / ALL: ONを全て / MIN_COUNT: ONのうち最低n個
hasConfluence = switch confluenceMode
    "ANY"       => enabledCount == 0 or satisfiedCount >= 1
    "ALL"       => satisfiedCount >= enabledCount
    "MIN_COUNT" => satisfiedCount >= minConfluenceCount
    => true

// ============================================================
// 6. エントリートリガー (下位足 反転確認)
// ============================================================
grpTrig = "6) エントリートリガー"
useBearishEngulfing = input.bool(true,  "弱気包み足",         group = grpTrig)
usePinbar           = input.bool(true,  "上ヒゲピンバー",      group = grpTrig)
useBOS              = input.bool(true,  "直近安値更新 / BOS", group = grpTrig)
useEMAReject        = input.bool(false, "EMA20 リジェクト",   group = grpTrig)
useBearishFVGTrigger= input.bool(true,  "Bearish FVG 形成",   group = grpTrig)
bosLookback         = input.int(10, "BOS 直近安値 本数", minval = 2, group = grpTrig)
useLowerTFTrigger   = input.bool(true, "下位足(1分足)で反転確認", group = grpTrig)
triggerTF           = input.timeframe("1", "反転確認 TF", group = grpTrig)

// A. 弱気包み足
bearishEngulfing = (close < open) and (close[1] > open[1]) and (close <= open[1]) and (open >= close[1])
// B. 上ヒゲピンバー
body      = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
pinbar    = (upperWick > body * 2) and (upperWick > lowerWick)
// C. 直近安値更新 / BOS (下方向)
bos = close < ta.lowest(low, bosLookback)[1]
// D. EMA20 下抜けリジェクト (上ヒゲで EMA20 を試して終値は下)
emaReject = (high > emaFast) and (close < emaFast)
// E. Bearish FVG 形成
bearFVGtrig = bearishFVG

// 現在足ベースの反転トリガー
trigCurrent = (useBearishEngulfing and bearishEngulfing) or (usePinbar and pinbar) or (useBOS and bos) or (useEMAReject and emaReject) or (useBearishFVGTrigger and bearFVGtrig)

// 同じ反転トリガーを triggerTF (1分足) で評価する関数
f_lowerTrigger() =>
    eF      = ta.ema(close, emaFastLen)
    bodyL   = math.abs(close - open)
    uw      = high - math.max(close, open)
    lw      = math.min(close, open) - low
    be      = (close < open) and (close[1] > open[1]) and (close <= open[1]) and (open >= close[1])
    pb      = (uw > bodyL * 2) and (uw > lw)
    bo      = close < ta.lowest(low, bosLookback)[1]
    er      = (high > eF) and (close < eF)
    bf      = high < low[2]
    (useBearishEngulfing and be) or (usePinbar and pb) or (useBOS and bo) or (useEMAReject and er) or (useBearishFVGTrigger and bf)

// 売りゾーンの検出は現在足/5分足ベース、最後の反転確認だけを下位足(1分足)で行う
trigLowerTF = request.security(syminfo.tickerid, triggerTF, f_lowerTrigger(), lookahead = barmerge.lookahead_off)
trigger     = useLowerTFTrigger ? trigLowerTF : trigCurrent

// ============================================================
// 7. 無効条件 (SELL 禁止)
// ============================================================
grpInv = "7) 無効条件"
useFib618Invalid = input.bool(true, "fib618 上抜けで無効",   group = grpInv)
useADXRangeFilter= input.bool(true, "ADX レンジフィルター",  group = grpInv)
adxLen           = input.int(14, "ADX / DI 期間", minval = 1, group = grpInv)
minADX           = input.float(18, "最低 ADX",     minval = 0, group = grpInv)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// 各種無効化
invFib618    = useFib618Invalid and validWave and (close > fib618)
inv5mAbove   = validWave and (close5m > sellZoneHigh)             // 5分足終値が売りゾーン上限より上で確定
invEmaSettle = validWave and (close > htfEmaFast) and (close[1] > htfEmaFast)  // 上位足 EMA20 上抜け定着
invOrigin    = validWave and (close > swingHigh)                  // 下降波の起点高値を上抜け
invADXrange  = useADXRangeFilter and (adxVal < minADX)            // レンジ判定

invalidated  = invFib618 or inv5mAbove or invEmaSettle or invOrigin or invADXrange

// ============================================================
// エントリー条件 統合
// ============================================================
sellSetup  = htfFilterOK and priceInSellZone and hasConfluence and not invalidated
sellSignal = sellSetup and trigger and strategy.position_size == 0

// ============================================================
// 8. SL / TP
// ============================================================
grpRisk = "8) SL / TP"
slATRBuffer  = input.float(0.3, "SL バッファ (ATR 倍)", minval = 0.0, step = 0.1, group = grpRisk)
riskReward   = input.float(1.5, "リスクリワード",        minval = 0.1, step = 0.1, group = grpRisk)
useSwingLowTP= input.bool(true, "TP に直近安値を使う",   group = grpRisk)
useFixedRRTP = input.bool(true, "TP に固定 RR を使う",   group = grpRisk)
useBreakEven = input.bool(true, "建値移動を使う",        group = grpRisk)
breakEvenAtR = input.float(1.0, "建値移動 発動 R",       minval = 0.1, step = 0.1, group = grpRisk)
useTrailing  = input.bool(false,"トレーリングを使う",    group = grpRisk)
trailATR     = input.float(1.5, "トレーリング距離 (ATR 倍)", minval = 0.1, step = 0.1, group = grpRisk)

// エントリー時点の各価格を保持
var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na
var float riskDist   = na

if sellSignal
    entryPrice := close
    slPrice    := sellZoneHigh + atr * slATRBuffer
    riskDist   := slPrice - entryPrice
    // TP 候補: 直近安値 → 無ければ / 固定 RR
    float tpFixed = entryPrice - riskDist * riskReward
    float tpSwing = swingLow
    tpPrice := useSwingLowTP and not na(tpSwing) and tpSwing < entryPrice ? tpSwing : (useFixedRRTP ? tpFixed : tpFixed)

if sellSignal
    strategy.entry("SELL", strategy.short)

// 決済 (SL / TP)
if strategy.position_size < 0 and not na(slPrice) and not na(tpPrice)
    strategy.exit("EXIT", from_entry = "SELL", stop = slPrice, limit = tpPrice)

// 建値移動: 含み益が breakEvenAtR×risk に達したら SL を建値へ
var bool beDone = false
if strategy.position_size < 0
    if useBreakEven and not beDone and not na(riskDist)
        if (entryPrice - low) >= riskDist * breakEvenAtR
            slPrice := entryPrice
            beDone  := true
            strategy.exit("EXIT", from_entry = "SELL", stop = slPrice, limit = tpPrice)
else
    beDone := false

// トレーリング (任意)
if useTrailing and strategy.position_size < 0
    strategy.exit("TRAIL", from_entry = "SELL", trail_points = trailATR * atr / syminfo.mintick, trail_offset = trailATR * atr / syminfo.mintick)

// ============================================================
// 9. 可視化
// ============================================================
grpViz = "9) 可視化"
showFib  = input.bool(true, "フィボ / 波を表示", group = grpViz)
showZone = input.bool(true, "売りゾーンを表示",   group = grpViz)
showFVG  = input.bool(true, "FVG ゾーンを表示",   group = grpViz)
showSLTP = input.bool(true, "SL / TP を表示",     group = grpViz)

// フィボ / スイング ライン
plot(showFib and validWave ? swingHigh   : na, "Swing High", color = color.new(color.red,   0),    style = plot.style_linebr, linewidth = 2)
plot(showFib and validWave ? swingLow    : na, "Swing Low",  color = color.new(color.green, 0),    style = plot.style_linebr, linewidth = 2)
plot(showFib and validWave ? fib382      : na, "Fib 38.2%",  color = color.new(color.orange,0),    style = plot.style_linebr)
plot(showFib and validWave ? fib500      : na, "Fib 50.0%",  color = color.new(color.gray,  0),    style = plot.style_linebr)
plot(showFib and validWave ? fib618      : na, "Fib 61.8%",  color = color.new(color.purple,0),    style = plot.style_linebr)

// EMA
plot(emaFast, "EMA Fast", color = color.new(color.blue,   30))
plot(emaSlow, "EMA Slow", color = color.new(color.maroon, 30))

// POC 水平線
plot(usePocLine ? pocPrice : na, "POC", color = color.new(color.teal, 0), style = plot.style_linebr)

// 売りゾーン (赤ボックス)
var box zoneBox = na
if showZone and validWave
    if na(zoneBox)
        zoneBox := box.new(bar_index, sellZoneHigh, bar_index + 1, sellZoneLow, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
    else
        box.set_lefttop(zoneBox, bar_index - waveLookback < lastPHbar ? lastPHbar : bar_index - 50, sellZoneHigh)
        box.set_rightbottom(zoneBox, bar_index + 5, sellZoneLow)

// FVG ゾーン (直近のものを薄く表示)
var box fvgBox = na
if showFVG and array.size(fvgTop) > 0
    t = array.get(fvgTop, 0)
    b = array.get(fvgBot, 0)
    if na(fvgBox)
        fvgBox := box.new(bar_index - 1, t, bar_index + 1, b, border_color = color.new(color.fuchsia, 50), bgcolor = color.new(color.fuchsia, 90))
    else
        box.set_lefttop(fvgBox, bar_index - 1, t)
        box.set_rightbottom(fvgBox, bar_index + 3, b)

// SELL シグナル
plotshape(sellSignal, title = "SELL", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), text = "SELL", textcolor = color.white, size = size.small)

// 売りゾーン到達 / 反転確認のマーカー
plotshape(sellSetup and not sellSignal, title = "Zone Ready", style = shape.circle, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)

// SL / TP ライン (建玉中のみ)
plot(showSLTP and strategy.position_size < 0 ? slPrice : na, "SL", color = color.new(color.red,   0), style = plot.style_linebr, linewidth = 2)
plot(showSLTP and strategy.position_size < 0 ? tpPrice : na, "TP", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)

// 無効化ラベル
if invalidated and validWave and not invalidated[1]
    label.new(bar_index, high, text = "無効化", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)

// ============================================================
// 10. アラート
// ============================================================
zoneArrival   = priceInSellZone and not priceInSellZone[1]
reversalInZone= sellSetup and trigger
tpHit         = strategy.position_size < 0 and not na(tpPrice) and low <= tpPrice
slHit         = strategy.position_size < 0 and not na(slPrice) and high >= slPrice

alertcondition(zoneArrival,    title = "1) 売りゾーン到達",       message = "XAUUSD: 価格が売りゾーンに到達しました")
alertcondition(reversalInZone, title = "2) 売りゾーン内 反転確認", message = "XAUUSD: 売りゾーン内で反転確認 (トリガー発生)")
alertcondition(sellSignal,     title = "3) SELL エントリー",      message = "XAUUSD: SELL エントリーシグナル")
alertcondition(invFib618,      title = "4) fib618 上抜けで無効",  message = "XAUUSD: fib618 上抜けで売りセットアップ無効化")
alertcondition(tpHit,          title = "5) TP 到達",             message = "XAUUSD: TP 到達")
alertcondition(slHit,          title = "6) SL 到達",             message = "XAUUSD: SL 到達")

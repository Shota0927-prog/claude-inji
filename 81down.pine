// ============================================================
//  下降環境版 ランク分けインジケーター (81 Down / A-B-C Rank)
// ------------------------------------------------------------
//  「81レンジ」(レンジ環境ごとのA/B/Cランク) の共通構造を雛形に、
//  下降環境の各パターンを A/B/C ランクへ場合分けして出力する。
//
//  今回のAランクロジック＝添付「5分足 包み足ストラテジー」の最終条件。
//    ・添付ストラテジーの判定式・初期値・ON/OFFをそのまま移植。
//    ・strategy.* は使わず、インジケーター用の仮想ポジションへ置換。
//  Bランク・Cランクは未実装 (false)。将来ロジック判定を追加するだけで
//  同じ「ランク選択 → 共通シグナル管理 → 共通表示/alert」へ接続できる。
//
//  共通構造 (81レンジ準拠):
//    1. 資金入力  2. 共通計算  3. ロジック別実効設定  4. 環境場合分け
//    5. ランク別シグナル判定  6. ランク優先(A>B>C)  7. 仮/確定管理
//    8. セットアップID  9. 仮想ポジション  10. SL/TP/ロット
//    11. ラベル  12. alert  13. デバッグ
//
//  ※ 5分足チャートに適用してください (5分足でのみ仮/確定・ラベル・仮想ポジションを有効化)。
// ============================================================

//@version=5
indicator(
     title             = "81 Down",
     overlay           = true,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_labels_count  = 500,
     max_boxes_count   = 200
 )

// ============================================================
//  0. 入力 : インジケーター専用 (基準資金)
// ------------------------------------------------------------
//  strategy.equity / strategy.initial_capital は使用できないため、
//  ロット計算の基準資金を input で受け取る (81レンジと同方式)。
//    複利OFF … 計算用資金 (元金・単利)   = indicatorCapital
//    複利ON  … 現在資金 (手入力)         = manualEquity
// ============================================================
grpIndicator = "インジケーター設定"
indicatorCapital = input.float(1000, "計算用資金 (元金・単利)", minval = 0.0, step = 100, group = grpIndicator)
manualEquity     = input.float(1000, "現在資金 (複利ON時に使用・手入力)", minval = 0.0, step = 100, group = grpIndicator)

// ============================================================
//  1. 入力 : エントリー (トリガーは常に包み足)
// ============================================================
grpEntry = "エントリー"
useLong      = input.bool(false, "ロングを有効",              group = grpEntry)
useShort     = input.bool(true, "ショートを有効",            group = grpEntry)
strictEngulf = input.bool(true, "実体が前足を完全に包む",     group = grpEntry)
reqOppColor  = input.bool(true, "前足が反対色であることを要求", group = grpEntry)
// ピラミッディング入力 (添付ストラテジーの設定を保持)。
//   ※ 本インジケーターの仮想ポジションは雛形(81レンジ)仕様に合わせ「最大1ポジション」で管理する。
//     初期値=1 のため挙動は最大1で一致。将来ここを使ってピラミッディング化する場合は仮想ポジション側を拡張する。
maxPyramiding = input.int(1, "最大同方向ポジション数 (ピラミッディング)", minval = 1, maxval = 50, group = grpEntry, tooltip = "同じ方向へ同時に持てる建玉数の上限。1=積み増しなし(従来動作)。本インジケーターは雛形仕様で最大1ポジション管理。")

// ============================================================
//  1a. 入力 : エントリートリガー (追加条件・ON/OFF)
// ============================================================
grpTrig = "エントリートリガー (追加条件)"
useEngulfingTrigger    = input.bool(false, "包み足",             group = grpTrig)
usePinbarTrigger       = input.bool(false, "ピンバー",           group = grpTrig)
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新", group = grpTrig)
useEMARejectTrigger    = input.bool(false,  "EMAリジェクト",      group = grpTrig)
useFVGTriggerFormation = input.bool(false, "FVG形成",            group = grpTrig)
useStrongCandleTrigger = input.bool(false, "強ローソク",         group = grpTrig)

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"], group = grpTrig)
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)", minval = 1, group = grpTrig)

// 下位足トリガー確認 (OFF で request.security を呼ばない)
useLowerTFTrigger = input.bool(false, "下位足トリガー確認 (重い)", group = grpTrig)
triggerTF         = input.timeframe("5", "下位足TF", group = grpTrig)
triggerTFMode     = input.string("CurrentOnly", "現在足/下位足 結合", options = ["CurrentOnly", "LowerOnly", "CurrentAndLower", "CurrentOrLower"], group = grpTrig)

// トリガー個別パラメータ
emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)", minval = 1, group = grpTrig)
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター", group = grpTrig)
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数", minval = 1, group = grpTrig)
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率", minval = 0.0, step = 0.01, group = grpTrig)
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間", minval = 1, group = grpTrig)
bosLookback        = input.int(10,  "BOS Lookback", minval = 2, group = grpTrig)
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率", step = 0.1, group = grpTrig)
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限", step = 0.1, group = grpTrig)
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター", group = grpTrig)
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率", minval = 0.05, maxval = 1.0, step = 0.05, group = grpTrig)
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター", group = grpTrig)
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間", minval = 1, group = grpTrig)
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率", step = 0.05, group = grpTrig)
strongBodyRatio    = input.float(0.6, "強ローソク 実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
useEngulfBodyRatioFilter   = input.bool(false, "包み足 包み込み率フィルター", group = grpTrig)
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率", minval = 1.0, step = 0.05, group = grpTrig)
useEngulfBodyQualityFilter = input.bool(false, "包み足 実体率フィルター", group = grpTrig)
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrig)
useEngulfBodyAtrFilter     = input.bool(false, "包み足 最低実体ATRフィルター", group = grpTrig)
engulfAtrLen               = input.int(14, "包み足 ATR期間", minval = 1, group = grpTrig)
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率", minval = 0.0, step = 0.05, group = grpTrig)

useTriggerCooldown        = input.bool(false, "トリガークールダウン", group = grpTrig)
triggerCooldownBars       = input.int(3, "クールダウン本数", minval = 1, group = grpTrig)
useOppositeTriggerNoTrade = input.bool(false, "逆方向トリガー同時発生はNoTrade", group = grpTrig)

// ============================================================
//  1b. 入力 : FVG 場所フィルター
// ============================================================
grpFvg = "FVG 場所フィルター"
useFVGFilter           = input.bool(true, "FVG場所フィルターを使う", group = grpFvg)
useFVGReboundFilter    = input.bool(true,  "FVG反発を許可",          group = grpFvg)
useFVGAbsorptionFilter = input.bool(true, "FVG吸収を許可",          group = grpFvg)
useIFVGFilter          = input.bool(false, "iFVGを許可",             group = grpFvg)
useBullishFVG    = input.bool(true,  "Bullish FVG (ロング側)",  group = grpFvg)
useBearishFVG    = input.bool(true,  "Bearish FVG (ショート側)", group = grpFvg)
useOppositeFVGFilter  = input.bool(true, "逆側FVG近接フィルター",   group = grpFvg)
fvgMaxAge        = input.int(100, "FVG最大年齢(本)",    minval = 1, group = grpFvg)
maxFVGPerSide    = input.int(120, "片側 最大FVG保持数", minval = 1, maxval = 500, group = grpFvg)
absorbBodyMinRatio = input.float(0.50, "吸収 実体最小比率",         minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
absorbCloseEdgeRatio = input.float(0.0, "吸収 close端寄り比率",    minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
useFVGStateWindow       = input.bool(true, "FVG状態管理を使う", group = grpFvg)
fvgStateMaxBars         = input.int(1, "FVG状態 有効本数", minval = 1, group = grpFvg)
resetFVGStateAfterEntry = input.bool(true, "エントリー後FVG状態をリセット", group = grpFvg)

// ============================================================
//  1b-2. 入力 : USレンジ式 FVG (Accumulation → MSS → フェーズ収集)
// ============================================================
grpFvgUS = "FVG: USレンジ式 (Accum/MSS)"
fvgAccumRangeLen       = input.int(10, "Accum判定レンジ本数",   minval = 6,  group = grpFvgUS)
fvgAccumBaseLen        = input.int(20, "Accum基準平均本数",     minval = 10, group = grpFvgUS)
fvgAccumAtrLen         = input.int(14, "Accum ATR本数",         minval = 1,  group = grpFvgUS)
fvgAccumMinUpperCloses = input.int(4,  "上半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMinLowerCloses = input.int(4,  "下半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMaxSameColorRun= input.int(4,  "同色連続の上限",         minval = 1,  group = grpFvgUS)
fvgAccumAtrMult        = input.float(2.5,  "Accum レンジ幅/ATR 上限",  minval = 0.5, step = 0.1,  group = grpFvgUS)
fvgAccumBarRatioMax    = input.float(0.70, "Accum 短期/基準 幅比 上限", minval = 0.1, step = 0.01, group = grpFvgUS)
fvgAccumDriftMax       = input.float(0.30, "Accum ドリフト上限",       minval = 0.05, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgMssValidBars        = input.int(100, "MSS有効本数", minval = 10, group = grpFvgUS)
fvgMssNeedBodyStrength = input.bool(true, "MSSで実体強度を使う", group = grpFvgUS)
fvgMssImpulseMult      = input.float(2.0, "MSS インパルス強度", minval = 0.0, step = 0.05, group = grpFvgUS)
fvgThicknessMinRebound    = input.float(0.1, "FVG厚み最小[反発] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgThicknessMinAbsorption = input.float(0.00, "FVG厚み最小[吸収] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgReboundConfirmDepthBuy  = input.float(0.70, "反発確定深度上限[BUY]",  minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundConfirmDepthSell = input.float(0.70, "反発確定深度上限[SELL]", minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
useFVGReboundStrictCandleBuy  = input.bool(false, "反発 ローソク強度[BUY]",  group = grpFvgUS)
useFVGReboundStrictCandleSell = input.bool(false, "反発 ローソク強度[SELL]", group = grpFvgUS)
fvgReboundBodyMinRatioBuy   = input.float(0.05, "反発 実体率下限[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundBodyMinRatioSell  = input.float(0.05, "反発 実体率下限[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioBuy  = input.float(0.30, "反発 close端寄り[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioSell = input.float(0.30, "反発 close端寄り[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgOppositeNearGapMax   = input.float(0.0, "逆側FVG近接距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgOppositeMinThickness = input.float(0.0, "逆側FVG最低厚み (厚み/Accum幅)",     minval = 0.0, step = 0.01, group = grpFvgUS)
fvgAbsorbThinRatioMax = input.float(0.00, "吸収 薄いFVG上限 (幅/Accum幅)",   minval = 0.0, step = 0.01, group = grpFvgUS)
fvgAbsorbNearGapMax   = input.float(0.00, "吸収 近接FVG距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)

// ============================================================
//  2. 入力 : ボラフィルタ
// ============================================================
grpVol   = "ボラフィルタ"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)

fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", minval = 0.0, step = 0.1, group = grpVol)

atrLenBase   = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5,  "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen    = input.int(480,    "ATR平均本数", minval = 10, group = grpVol)
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数", minval = 1, group = grpVol)
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時", step = 0.1, group = grpVol)
fastFixedMin = input.float(10.0,  "直近値幅 最低($) ※固定値時", minval = 0.0, step = 0.1, group = grpVol)
bodyAvgLen   = input.int(5,      "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin   = input.float(0.5,  "実体平均最低($)", step = 0.1, group = grpVol)
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時", group = grpVol)
rangeLookback       = input.int(20,    "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)
useVolExpansion      = input.bool(false, "ボラ拡大判定を使う", group = grpVol)
volExpansionLookback = input.int(3,     "ボラ拡大判定本数", minval = 1, group = grpVol)
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数", minval = 1, group = grpVol)

// ============================================================
//  3. 入力 : 環境フィルタ (環境認識モジュール)
// ============================================================
grpEnvMaster = "環境フィルタ"
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)", group = grpEnvMaster)

grpTF = "環境: 時間足 要求状態 / 参照時間足"
reqTrend4H  = input.string("下降", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf4")
tf4H        = input.timeframe("240", "TF",    group = grpTF, inline = "tf4")
reqTrend1H  = input.string("下降", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1")
tf1H        = input.timeframe("60",  "TF",    group = grpTF, inline = "tf1")
reqTrend15M = input.string("下降", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf15")
tf15M       = input.timeframe("15",  "TF",    group = grpTF, inline = "tf15")
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf5")
tf5M        = input.timeframe("5",   "TF",    group = grpTF, inline = "tf5")
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], group = grpTF, inline = "tf1m")
tf1M        = input.timeframe("1",   "TF",    group = grpTF, inline = "tf1m")

grpBull = "環境: 上昇条件 ON/OFF"
useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50",       group = grpBull)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き",       group = grpBull)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き",       group = grpBull)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50",       group = grpBull)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200",      group = grpBull)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBull)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBull)

grpBear = "環境: 下降条件 ON/OFF"
useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50",       group = grpBear)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き",       group = grpBear)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き",       group = grpBear)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50",       group = grpBear)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200",      group = grpBear)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBear)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBear)

grpRange = "環境: レンジ条件 ON/OFF"
useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い",       group = grpRange)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い",         group = grpRange)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い",         group = grpRange)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中",          group = grpRange)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ", group = grpRange)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ", group = grpRange)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい",         group = grpRange)

grpParam = "環境: 調整パラメータ"
len20        = input.int(20,   "EMA20 length",  minval = 1, group = grpParam)
len50        = input.int(50,   "EMA50 length",  minval = 1, group = grpParam)
len200       = input.int(200,  "EMA200 length", minval = 1, group = grpParam)
envAtrLen    = input.int(14,   "環境ATR length", minval = 1, group = grpParam)
slopeBars    = input.int(3,    "EMA 傾き判定本数", minval = 1, group = grpParam)
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率",       minval = 0, step = 0.01, group = grpParam)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
convDivBars  = input.int(5,    "収束/拡散 判定本数",   minval = 1, group = grpParam)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数", minval = 1, group = grpParam)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数", minval = 1, group = grpParam)
rangeBars    = input.int(20,   "レンジ幅 判定本数",    minval = 1, group = grpParam)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率",    minval = 0, step = 0.1, group = grpParam)

grpJudge = "環境: 判定ルール"
tieAsRange          = input.bool(true, "同点時にレンジ扱いする",     group = grpJudge)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = grpJudge)
minScore4H  = input.int(3, "4H 最低必要スコア",  minval = 1, group = grpJudge)
minScore1H  = input.int(3, "1H 最低必要スコア",  minval = 1, group = grpJudge)
minScore15M = input.int(3, "15M 最低必要スコア", minval = 1, group = grpJudge)
minScore5M  = input.int(3, "5M 最低必要スコア",  minval = 1, group = grpJudge)
minScore1M  = input.int(3, "1M 最低必要スコア",  minval = 1, group = grpJudge)

grpLink = "環境: 判定"
reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)", minval = 0, group = grpLink)

// ============================================================
//  3b. 入力 : Momentum モジュール (ストキャス)
// ============================================================
grpMomentum = "Momentum"
useMomentumModule = input.bool(true, "Momentumモジュールを使う", group = grpMomentum)
useStochMomentum  = input.bool(false, "ストキャス",              group = grpMomentum)
momentumMode      = input.string("AND", "Momentum結合", options = ["AND", "OR"], group = grpMomentum)
useStochStateWindow       = input.bool(true, "ストキャス状態管理を使う", group = grpMomentum)
stochStateMaxBars         = input.int(5, "ストキャス状態 有効本数", minval = 1, group = grpMomentum)
resetStochStateAfterEntry = input.bool(true, "エントリー後ストキャス状態をリセット", group = grpMomentum)

grpStochSw = "Momentum: ストキャス パターン"
useExtremeReversal   = input.bool(false, "A: Extreme Reversal",   group = grpStochSw)
useOBOSCross         = input.bool(true, "B: OB/OS Cross",        group = grpStochSw)
useMiddleCross       = input.bool(false, "C: Middle Cross",       group = grpStochSw)
useStickinessFilter  = input.bool(false, "D: Stickiness(禁止)",   group = grpStochSw)
useRegularDivergence = input.bool(false, "E: Regular Divergence", group = grpStochSw)
useHiddenDivergence  = input.bool(false, "F: Hidden Divergence",  group = grpStochSw)

grpStoch = "Momentum: ストキャス設定"
kLen    = input.int(21, "%K 期間",      minval = 1, group = grpStoch)
kSmooth = input.int(3,  "%K スムージング", minval = 1, group = grpStoch)
dLen    = input.int(3,  "%D 期間",      minval = 1, group = grpStoch)
useStochTF = input.bool(false, "ストキャス参照TFを使う", group = grpStoch)
stochTF    = input.timeframe("5", "ストキャス参照TF", group = grpStoch)
extremeHigh = input.float(85, "Extreme High", group = grpStoch)
extremeLow  = input.float(15, "Extreme Low",  group = grpStoch)
obLevel     = input.float(80, "OB Level",     group = grpStoch)
osLevel     = input.float(20, "OS Level",     group = grpStoch)
middleLevel = input.float(50, "Middle Level", group = grpStoch)

grpStochA = "Momentum: A Extreme Reversal"
useExtremeSlopeTurn    = input.bool(true, "傾き反転で確認", group = grpStochA)
useExtremeKDCross      = input.bool(true, "K/Dクロスで確認", group = grpStochA)
extremeLookback        = input.int(5, "Extreme 到達 参照本数", minval = 1, group = grpStochA)
useExtremeOneShot      = input.bool(true, "Extreme 一回だけ発火", group = grpStochA)
extremeResetLevelHigh  = input.float(80, "High リセットレベル", group = grpStochA)
extremeResetLevelLow   = input.float(20, "Low リセットレベル",  group = grpStochA)
useSlopeStrengthFilter = input.bool(false, "折り返し角度フィルター", group = grpStochA)
stochSlopeMin          = input.float(2.0, "最小スロープ(|ΔK|)", minval = 0.0, step = 0.5, group = grpStochA)
useExtremeRetraceFilter= input.bool(false, "戻り量フィルター", group = grpStochA)
extremeRetraceMin      = input.float(5.0, "最小戻り量(ポイント)", minval = 0.0, step = 0.5, group = grpStochA)

grpStochD = "Momentum: D/Div/共通"
stickBars           = input.int(5, "Stickiness 張り付き本数", minval = 1, group = grpStochD)
divPivotLen         = input.int(5,  "Div Pivot 長さ",     minval = 1, group = grpStochD)
divLookback         = input.int(50, "Div Pivot 間 最大本数", minval = 1, group = grpStochD)
useKDirectionFilter = input.bool(false, "K傾きフィルター",   group = grpStochD)
useKDRelationFilter = input.bool(false, "K/D位置フィルター", group = grpStochD)

// ============================================================
//  3c. 入力 : Momentum MACD モジュール
// ============================================================
grpMomentumMACD = "Momentum: MACD"
useMACDModule = input.bool(false, "MACDモジュールを使う", group = grpMomentumMACD)
useMACDStateWindow = input.bool(true, "MACD状態管理を使う", group = grpMomentumMACD)
macdStateMaxBars   = input.int(5, "MACD状態 有効本数", minval = 1, group = grpMomentumMACD)
resetMACDStateAfterEntry = input.bool(true, "エントリー後MACD状態をリセット", group = grpMomentumMACD)

grpMACDSw = "Momentum: MACD パターン"
useMACDSignalCross          = input.bool(false,  "A: Signalクロス",         group = grpMACDSw)
useMACDZeroFilter           = input.bool(false, "B: ゼロ上下(方向F)",       group = grpMACDSw)
useMACDZeroCross            = input.bool(false, "C: ゼロクロス",            group = grpMACDSw)
useMACDHistExpansion        = input.bool(true, "D: Hist拡大",             group = grpMACDSw)
useMACDRegularDivergence    = input.bool(false,  "F: Regular Divergence",   group = grpMACDSw)
useMACDHiddenDivergence     = input.bool(true, "G: Hidden Divergence",    group = grpMACDSw)
useMACDCompressionExpansion = input.bool(false, "H: 収束→拡散",            group = grpMACDSw)

grpMACDSet = "Momentum: MACD 設定"
macdFastLen   = input.int(8,  "Fast EMA",   minval = 1, group = grpMACDSet)
macdSlowLen   = input.int(21, "Slow EMA",   minval = 1, group = grpMACDSet)
macdSignalLen = input.int(5,  "Signal EMA", minval = 1, group = grpMACDSet)

grpMACDD = "Momentum: MACD D Hist拡大"
macdHistExpansionBars           = input.int(3, "拡大 連続本数", minval = 1, group = grpMACDD)
useMACDHistExpansionConsecutive = input.bool(true, "連続拡大を要求", group = grpMACDD)
useMACDHistSlopeStrength        = input.bool(false, "Histスロープ勢いを要求", group = grpMACDD)
macdHistSlopeMin                = input.float(0.02, "最小Histスロープ", minval = 0.0, step = 0.01, group = grpMACDD)

grpMACDH = "Momentum: MACD H 収束→拡散"
useMACDATRNormalizedThreshold   = input.bool(false, "収束しきい値をATR正規化", group = grpMACDH)
macdAtrLen                      = input.int(14, "ATR期間", minval = 1, group = grpMACDH)
macdCompressionThreshold        = input.float(0.05, "収束しきい値 |hist|", minval = 0.0, step = 0.01, group = grpMACDH)
macdCompressionBars             = input.int(3, "収束 継続本数", minval = 1, group = grpMACDH)
useMACDRelativeCompression      = input.bool(true, "相対収束を使う", group = grpMACDH)
macdRelativeCompressionLookback = input.int(50, "相対収束 参照本数", minval = 1, group = grpMACDH)
macdRelativeCompressionMult     = input.float(0.4, "相対収束 倍率(平均比)", minval = 0.0, step = 0.05, group = grpMACDH)

grpMACDDiv = "Momentum: MACD Divergence"
macdDivPivotLen = input.int(3,  "Pivot 長さ",       minval = 1, group = grpMACDDiv)
macdDivLookback = input.int(50, "Pivot 間 最大本数", minval = 1, group = grpMACDDiv)

grpMACDFilt = "Momentum: MACD 共通フィルター"
useMACDZeroDirectionFilter = input.bool(false, "ゼロ位置フィルター(line)", group = grpMACDFilt)
useMACDHistDirectionFilter = input.bool(true, "Hist位置フィルター",       group = grpMACDFilt)
useMACDSlopeFilter         = input.bool(false, "MACD傾きフィルター",       group = grpMACDFilt)
useMACDZeroDistanceFilter  = input.bool(false, "ゼロ距離フィルター",       group = grpMACDFilt)
macdZeroDistanceMin        = input.float(0.05, "ゼロから最小距離", minval = 0.0, step = 0.01, group = grpMACDFilt)

grpMACDNT = "Momentum: MACD NoTrade"
useMACDFlatNoTrade = input.bool(false, "横ばい(収束)時 NoTrade", group = grpMACDNT)

// ============================================================
//  4. 入力 : リスク / 決済
// ============================================================
grpRisk = "リスク / 決済"
riskPct     = input.float(5.0, "1トレード損失率 (%)",  minval = 0.1, step = 0.1, group = grpRisk)
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = grpRisk)
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"], group = grpRisk)
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時", minval = 0.0, step = 0.1, group = grpRisk)
slFixed     = input.float(15, "固定SL幅 (価格) ※固定時",         minval = 0.0, step = 0.1, group = grpRisk)
rrRatio     = input.float(1.5, "リスクリワード比 (TP)", minval = 0.1, step = 0.1, group = grpRisk)

// ============================================================
//  4b. 入力 : 時間帯フィルタ (東京時間 JST 基準)
// ============================================================
grpSession = "時間帯フィルタ (東京時間)"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = grpSession)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = grpSession)
useEUSession     = input.bool(true, "EU 16:00-21:00",   group = grpSession)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = grpSession)

// ============================================================
//  4c. 入力 : WinZone モジュール
// ============================================================
grpWinZone = "WinZone: FVG / Volume / Fib / EMA / Line"
useWinZoneModule = input.bool(true, "WinZoneモジュールを使う", group = grpWinZone)
useFVGWinZone    = input.bool(true, "FVGをWinZoneに使う", group = grpWinZone)
useVolumeWinZone = input.bool(false, "出来高/POCをWinZoneに使う", group = grpWinZone)
useFibWinZone    = input.bool(false, "フィボをWinZoneに使う", group = grpWinZone)
useEMAWinZone    = input.bool(false, "EMAをWinZoneに使う", group = grpWinZone)
useLineWinZone   = input.bool(false, "水平線をWinZoneに使う", group = grpWinZone)
winZoneMode      = input.string("AND", "WinZone結合", options = ["FVG_ONLY", "VOLUME_ONLY", "FIB_ONLY", "EMA_ONLY", "LINE_ONLY", "OR", "AND"], group = grpWinZone)

grpVolPat = "出来高: パターン ON/OFF"
usePOCAcceptance  = input.bool(false, "A: POC貫通・定着",       group = grpVolPat)
usePOCReject      = input.bool(false, "B: POCリジェクト(押し目/戻り)", group = grpVolPat)
useVolumeBreakout = input.bool(true, "C: 出来高急増ブレイク",    group = grpVolPat)
useClimaxReversal = input.bool(false, "D: クライマックス反転",    group = grpVolPat)

grpVolFilt = "出来高: 共通フィルター ON/OFF"
useLowVolumeFilter   = input.bool(true,  "出来高不足フィルター",     group = grpVolFilt)
useVolumeSMAFilter   = input.bool(false, "出来高SMAフィルター(>SMA)", group = grpVolFilt)
useBodyFilter        = input.bool(false, "実体率フィルター",         group = grpVolFilt)
useCompressionFilter = input.bool(false, "圧縮→爆発フィルター(C)",   group = grpVolFilt)
useFirstSignalOnly   = input.bool(true,  "連続シグナル抑制(初回のみ)", group = grpVolFilt)

grpVP = "出来高: VPVR / POC"
vpLookback = input.int(80, "VP ルックバック(本)", minval = 10, group = grpVP)
vpBins     = input.int(20,  "VP ビン数",           minval = 4,  maxval = 100, group = grpVP)
pocZoneWidth = input.float(0.0, "POCゾーン幅(固定/価格)", minval = 0.0, step = 0.1, group = grpVP)
useVolAdaptivePOCWidth = input.bool(true, "POCゾーン幅をATR連動にする", group = grpVP)
volAtrLen     = input.int(14,  "出来高ATR期間",          minval = 1,   group = grpVP)
pocZoneATRMult= input.float(0.25, "POCゾーン幅 (ATR倍率)", minval = 0.0, step = 0.05, group = grpVP)

grpVolA = "出来高: A アクセプタンス"
crossLookback = input.int(10, "貫通前 参照本数", minval = 1, group = grpVolA)
acceptBars    = input.int(2,  "定着本数",       minval = 1, group = grpVolA)
useDirCandleForAcceptance     = input.bool(false, "方向ローソク確認", group = grpVolA)
useVolumeConfirmForAcceptance = input.bool(false, "出来高増加確認",   group = grpVolA)

grpVolB = "出来高: B リジェクト"
pocRejectDepthMax = input.float(0.5, "許容 割込み深さ(ゾーン比)", minval = 0.0, step = 0.05, group = grpVolB)
usePOCRejectCandleConfirm    = input.bool(false, "リジェクト: 方向ローソク",  group = grpVolB)
usePOCRejectWickConfirm      = input.bool(false, "リジェクト: ヒゲ確認",      group = grpVolB)
usePOCRejectCloseEdgeConfirm = input.bool(false, "リジェクト: close寄り確認", group = grpVolB)

grpVolTrend = "出来高: トレンドフィルター"
useTrendFilter  = input.bool(true, "トレンドフィルターを使う", group = grpVolTrend)
allowTrendLong  = input.bool(true, "ロング許可",             group = grpVolTrend)
allowTrendShort = input.bool(true, "ショート許可",           group = grpVolTrend)

grpVolC = "出来高: C ブレイク"
breakoutLookback     = input.int(5, "ブレイク 参照本数", minval = 1, group = grpVolC)
volumeSmaLen         = input.int(20, "出来高SMA期間",     minval = 1, group = grpVolC)
volumeSpikeMult      = input.float(1.2, "出来高急増 倍率", minval = 0.0, step = 0.1, group = grpVolC)
breakoutBodyRatioMin = input.float(0.3, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpVolC)
useATRExpansionFilter = input.bool(false, "ATR拡大フィルター", group = grpVolC)
atrExpansionMult     = input.float(1.2, "ATR拡大 倍率", minval = 0.0, step = 0.05, group = grpVolC)
compressionLookback  = input.int(10, "圧縮 参照本数", minval = 1, group = grpVolC)
compressionATRMult   = input.float(1.5, "圧縮 レンジ <= ATR×", minval = 0.0, step = 0.1, group = grpVolC)

grpVolD = "出来高: D クライマックス"
climaxLookback   = input.int(20, "クライマックス 参照本数", minval = 1, group = grpVolD)
climaxVolumeMult = input.float(2.5, "クライマックス 出来高倍率", minval = 0.0, step = 0.1, group = grpVolD)
climaxWickRatio  = input.float(0.5, "ヒゲ比率(ヒゲ/レンジ)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpVolD)
climaxCloseEdgeRatio = input.float(0.35, "close端寄り比率", minval = 0.0, maxval = 1.0, step = 0.05, group = grpVolD)

grpVolCommon = "出来高: 共通値 / 表示"
lowVolumeMult = input.float(0.7, "出来高不足 倍率(volume<SMA×)", minval = 0.0, step = 0.05, group = grpVolCommon)
bodyRatioMin  = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpVolCommon)

grpVolState = "出来高: 状態管理"
useVolumeStateWindow       = input.bool(true, "出来高状態管理を使う", group = grpVolState)
volumeStateMaxBars         = input.int(10, "出来高状態 有効本数", minval = 1, group = grpVolState)
resetVolumeStateAfterEntry = input.bool(true, "エントリー後出来高状態をリセット", group = grpVolState)

// ============================================================
//  4d. 入力 : フィボ WinZone (戻り売り/押し目買い・場所条件)
// ============================================================
grpFib = "フィボ: 波検出 / 設定"
useFibSell = input.bool(true, "SELL(戻り売り)検出", group = grpFib)
useFibBuy  = input.bool(true, "BUY(押し目買い)検出", group = grpFib)
fibAtrLen        = input.int(14,  "Fib ATR期間", minval = 1, group = grpFib)
fibEma20Len      = input.int(20,  "Fib EMA20期間 (反転確認用)", minval = 1, group = grpFib)
swingLookback    = input.int(3,   "スイング検出 左右本数", minval = 1, group = grpFib)
waveLookback     = input.int(100, "波の有効本数 (古い波は無視)", minval = 10, group = grpFib)
minWaveATR       = input.float(2.0, "最低波幅 (ATR倍)", minval = 0.0, step = 0.1, group = grpFib)
fibZoneBufferATR = input.float(0.3, "フィボゾーン許容 (ATR倍)", step = 0.05, group = grpFib)

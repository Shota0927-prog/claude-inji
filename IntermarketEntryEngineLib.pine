    bool   useDxyRetNeutral       = false
    bool   useDxyRetSameDir       = true
    bool   useDxyRetOriginal      = true
    bool   useDxyRetOpposite      = false
    float  dxyMinChange           = 0.1
    float  dxyDistMinChange       = 0.05
    float  dxyWeight              = 1.0
    float  dxyEventPoint          = 2.0
    float  tfWeight15M            = 0.5
    int    hold15M                = 24
    float  corrThreshold          = 0.2
    int    corrLen                = 20
    int    returnLookback         = 3
    bool   distRequireCorr        = true
    bool   useDistMinMove         = true
    float  goldRespMinChange      = 0.05

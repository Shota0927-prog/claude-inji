// ============================================================================
//  IntermarketEntryEngine  —  Intermarket Entry Candidate Library
// ============================================================================
//  役割 : Intermarket市場 (今回は DXY のみ) の状態計算と Entry Candidate の生成。
//
//  ★ このLibraryが「やらないこと」 ★
//    strategy.entry / strategy.exit / Qty計算 / SL・TP計算 / 建値移動 /
//    ポジション管理 / 共通Trade Engineの再実装 / Zone生成 / FVG再計算。
//    注文とポジション管理は Main の共通Trade Engine がそのまま担当する。
//
//  ★ 既存Libraryとの関係 ★
//    SignalEngine / ZoneEngine を import せず、それらのUDTにも依存しない。
//    型・関数・状態はすべてこのLibrary専用。
//
//  ★ request.*() は持たない ★
//    Library は request.*() を呼べないため、外部データ取得は Main 側で行い、
//    プリミティブ値と本Library専用型だけを受け取る。
//    request の「式」として使う関数 (dxyDataPack / dxyTriggerPack /
//    dxyAccum15Pack / dxyDailyPack) だけを export し、呼び出しは Main が行う。
//
//  ★ 移植元 ★
//    "Gold Intermarket Environment Strategy" の DXY 経路。
//    canLong / canShort から、移植元固有の SL・Qty 判定
//    (longRisk > 0 / longQty >= 1) だけを外したものを Candidate とする。
//    条件式・評価順序・状態遷移は移植元のソースをそのまま移している。
// ============================================================================

//@version=5
library("IntermarketEntryEngine", overlay = true)

// ============================================================================
// 01. TYPES
// ============================================================================

// @type  日足レジーム用パック。request.security が返す16値を1オブジェクトにまとめる。
//   ★ tuple ではなく UDT にしているのは、request.*() が返す tuple 要素の合計 127
//     という上限を圧迫しないため。値の式・[1]位置は移植元 f_drDailyTuple と同一。
//   ★ 取得しない設定では Main が na を渡す。Engine 側は na安全に読むので、
//     移植元で「tuple要素が na」になる場合と同じ値になる。
export type DxyDaily
    float o0   = na
    float h0   = na
    float l0   = na
    float c0   = na
    float a0   = na
    float r0   = na
    float loT0 = na
    float hiT0 = na
    float o1   = na
    float h1   = na
    float l1   = na
    float c1   = na
    float a1   = na
    float r1   = na
    float loT1 = na
    float hiT1 = na

// @type  DXY Entry Candidate の全設定。既定値は移植元の input 既定値と同一。

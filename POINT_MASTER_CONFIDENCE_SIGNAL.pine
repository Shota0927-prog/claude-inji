//@version=5
// =====================================================================================
// POINT MASTER Confidence Signal  ―  NET SCORE から信頼度ランクを判定する専用インジケーター
// =====================================================================================
// POINT MASTER 本体（POINT_MASTER_FVG_ABS_REBOUND.pine）とは完全に別のインジケーターです。
// 本体のロジック / Weight / 保持本数 / 状態管理 は一切コピーしていません。
// 本体が plot している「NET SCORE」だけを input.source() で受け取り、その値から
//   LONG 70% / 80% / 90%、SHORT 70% / 80% / 90%、70%未満
// の7段階を判定します（判定・状態遷移・各シグナルboolは全レベル分そのまま動いています）。
//
// 【★5分足チャート専用】マーク表示とアラートは5分足チャートでのみ有効です。
//
// 【表示 / アラートは絞っています】
//   チャートのマーク : LONG 90% = ▲（緑・足の下） / SHORT 90% = ▼（赤・足の上） /
//                      LONG 70→70%未満 = ×（緑・足の下） / SHORT 70→70%未満 = ×（赤・足の上）
//   アラート         : LONG 90% / SHORT 90% の2種類
//   70% / 80% 到達や 90→80 などの格下げは、内部判定は継続しつつ表示・アラートは出しません
//   （§7 のコメントアウトを外せばアラートを復活できます）。
//
// 【使い方】
//   1. チャートへ POINT MASTER 本体を追加する（NET SCORE が plot されています）
//   2. チャートへ このインジケーターを追加する
//   3. このインジケーターの設定 → 「POINT MASTER NET SCORE」で
//      "POINT MASTER FVG ABS REBOUND : NET SCORE" を選択して接続する
//
// ※ 70% / 80% / 90% は実勝率を保証する数値ではなく、POINT MASTER のスコアに基づく
//    「信頼度ランクの名称」です。閾値は検証結果に合わせて設定画面から変更できます。
//
// 【非リペイント】
//   判定は確定足の NET SCORE で行います（既定 ON）。形成中の足で一時的に90%へ達しても、
//   確定時に80%へ戻った場合は 80% としてだけ扱われ、誤ラベル / 誤アラートは残りません。
// =====================================================================================
indicator(
     title            = "POINT MASTER Confidence Signal",
     shorttitle       = "PM-CONF",
     overlay          = true,
     max_labels_count = 500
 )

// =====================================================================================
// §0. 入力
// =====================================================================================
grpSrc = "① 接続元"
netSource = input.source(close, "POINT MASTER NET SCORE", group = grpSrc,
     tooltip = "POINT MASTER 本体の NET SCORE を選択してください（NET SCORE = LONG SCORE - SHORT SCORE）。")
useConfirmedOnly = input.bool(true, "確定足だけで判定する (非リペイント)", group = grpSrc,
     tooltip = "OFF にすると形成中の足でもレベルが動き、確定前のラベル / アラートが発生します。")

grpTh = "② 信頼度しきい値 (NET SCORE)"
th70 = input.float(5.0,  "70% Threshold", group = grpTh, step = 0.1, minval = 0)
th80 = input.float(7.0,  "80% Threshold", group = grpTh, step = 0.1, minval = 0)
th90 = input.float(20.0, "90% Threshold", group = grpTh, step = 0.1, minval = 0)
// ★ th70 < th80 < th90 を前提に判定します。

grpLbl = "③ ラベル表示"
// チャートへ出すのは 90%到達 (▲ / ▼) と 70%→70%未満 (×) の4種類だけです
// （70% / 80% 到達、90→80 などの格下げラベルは表示しません。判定自体は §3 で継続しています）
showLong90Label  = input.bool(true, "LONG 90% マーク (▲) を表示",  group = grpLbl)
showShort90Label = input.bool(true, "SHORT 90% マーク (▼) を表示", group = grpLbl)
showBelowLabels  = input.bool(true, "70→70%未満 マーク (×) を表示", group = grpLbl)

grpCol = "④ 色"
colLong70  = input.color(color.new(#a5d6a7, 0), "LONG 70%",  group = grpCol)
colLong80  = input.color(color.new(#43a047, 0), "LONG 80%",  group = grpCol)
colLong90  = input.color(color.new(#1b5e20, 0), "LONG 90%",  group = grpCol)
colShort70 = input.color(color.new(#ef9a9a, 0), "SHORT 70%", group = grpCol)
colShort80 = input.color(color.new(#e53935, 0), "SHORT 80%", group = grpCol)
colShort90 = input.color(color.new(#b71c1c, 0), "SHORT 90%", group = grpCol)
colNone    = input.color(color.new(#9e9e9e, 0), "70%未満",   group = grpCol)
// チャート上のシグナルマーク（▲ / ▼ / ×）専用の明るい色
signalLongColor  = input.color(color.new(#ffffff, 0), "シグナル LONG 色 (▲ / ×)",  group = grpCol)
signalShortColor = input.color(color.new(#ff5297, 0), "シグナル SHORT 色 (▼ / ×)", group = grpCol)

grpTbl = "⑤ 現在状態テーブル"
showTable = input.bool(true, "現在状態テーブルを表示 (5分足チャートのみ)", group = grpTbl)
// テーブルに表示する NET SCORE の取得元。
//   OFF : ①で接続した NET SCORE をそのまま表示（＝チャート足で計算された POINT MASTER の値）
//   ON  : 下の「テーブル用 NET SCORE」に接続した別ソースを表示
//         （1分足基準の NET SCORE を別 plot として用意できた場合に、そこへ接続して使います）
// ★ 外部 input.source() は「チャート足で計算された他インジケーターの plot」しか受け取れないため、
//   5分足チャート上から request.security(..., "1", netSource) で1分足基準の値を作ることはできません
//   （POINT MASTER のイベント / 保持 / 状態管理は他スクリプト側の内部状態で、別TFで再計算できないため）。
//   テーブル専用の変数なので、ここを切り替えても ▲▼× やアラートの判定には一切影響しません。
useTableNetSource  = input.bool(false, "テーブルに別の NET SCORE を使う", group = grpTbl)
tableNetSourceIn   = input.source(close, "テーブル用 NET SCORE", group = grpTbl,
     tooltip = "1分足基準の NET SCORE を持つ plot があれば、それを選択してください（未使用時は①の NET SCORE を表示します）。")
tblPosStr = input.string("右上", "表示位置", options = ["右上", "右下", "左上", "左下"], group = grpTbl)
tblSize   = input.string(size.small, "文字サイズ",
     options = [size.tiny, size.small, size.normal, size.large], group = grpTbl)
colTblBg  = input.color(color.new(#1e222d, 20), "背景色", group = grpTbl)
colTblTxt = input.color(color.new(#d1d4dc, 0),  "文字色", group = grpTbl)

// =====================================================================================
// §1. レベル判定（状態コード）
// =====================================================================================
//   +3 = LONG 90% / +2 = LONG 80% / +1 = LONG 70%
//    0 = 70%未満（中立）
//   -1 = SHORT 70% / -2 = SHORT 80% / -3 = SHORT 90%
//
//   NET >= +th90            → +3        NET <= -th90            → -3
//   +th80 <= NET < +th90    → +2        -th90 <  NET <= -th80   → -2
//   +th70 <= NET < +th80    → +1        -th80 <  NET <= -th70   → -1
//   -th70 <  NET <  +th70   →  0（LONG / SHORT 完全対称）
f_level(_net) =>
    int _l = 0
    if na(_net)
        _l := 0
    else if _net >= th90
        _l := 3
    else if _net >= th80
        _l := 2
    else if _net >= th70
        _l := 1
    else if _net <= -th90
        _l := -3
    else if _net <= -th80
        _l := -2
    else if _net <= -th70
        _l := -1
    _l

// 表示用テキスト
f_dirText(_l) =>
    _l > 0 ? "LONG" : _l < 0 ? "SHORT" : "NONE"
f_pctNum(_l) =>
    int _a = math.abs(_l)
    _a == 3 ? "90" : _a == 2 ? "80" : _a == 1 ? "70" : "-"
f_levelText(_l) =>
    _l == 0 ? "70%未満" : f_dirText(_l) + " " + f_pctNum(_l) + "%"
f_levelColor(_l) =>
    _l ==  3 ? colLong90  : _l ==  2 ? colLong80  : _l ==  1 ? colLong70 :
     _l == -1 ? colShort70 : _l == -2 ? colShort80 : _l == -3 ? colShort90 : colNone

// =====================================================================================
// §2. 状態の更新（確定足ベース）
// =====================================================================================
// 確定足でのみ curLevel / prevLevel を進めるため、形成中の値でラベルやアラートが
// 出たり消えたりしません（リペイント対策）。
int rawLevel = f_level(netSource)
var int curLevel  = 0
var int prevLevel = 0
bool evalNow = not useConfirmedOnly or barstate.isconfirmed
bool changed = false
if evalNow
    prevLevel := curLevel
    curLevel  := rawLevel
    changed   := curLevel != prevLevel

// =====================================================================================
// §3. シグナル（bool）
// =====================================================================================
// 新規到達 : そのレベルへ「上げ方向」で到達した瞬間だけ true。
//   ・中立から到達 / 下位レベルから昇格 / 反対方向からの直接反転 が対象
//   ・LONG80 → LONG90 なら long90Signal だけが true（long70/80 は同時に立ちません）
//   ・LONG⇔SHORT の直接反転は「新しい方向の新規シグナル」として扱います
bool newLong  = changed and curLevel > 0 and curLevel > prevLevel
bool newShort = changed and curLevel < 0 and curLevel < prevLevel

bool long70Signal  = newLong  and curLevel ==  1
bool long80Signal  = newLong  and curLevel ==  2
bool long90Signal  = newLong  and curLevel ==  3
bool short70Signal = newShort and curLevel == -1
bool short80Signal = newShort and curLevel == -2
bool short90Signal = newShort and curLevel == -3

// 格下げ : 同じ方向のまま信頼度が下がった（0 = 70%未満 への移行を含む）
bool longDowngrade  = changed and prevLevel > 0 and curLevel >= 0 and curLevel < prevLevel
bool shortDowngrade = changed and prevLevel < 0 and curLevel <= 0 and curLevel > prevLevel

// 段階別（1バーで複数段階動いた場合も正しく分類されます）
bool long90to80    = changed and prevLevel ==  3 and curLevel ==  2
bool long90to70    = changed and prevLevel ==  3 and curLevel ==  1
bool long80to70    = changed and prevLevel ==  2 and curLevel ==  1
bool long70toBelow = changed and prevLevel ==  1 and curLevel ==  0
bool long80toBelow = changed and prevLevel ==  2 and curLevel ==  0
bool long90toBelow = changed and prevLevel ==  3 and curLevel ==  0
bool longToBelow   = changed and prevLevel >   0 and curLevel ==  0

bool short90to80    = changed and prevLevel == -3 and curLevel == -2
bool short90to70    = changed and prevLevel == -3 and curLevel == -1
bool short80to70    = changed and prevLevel == -2 and curLevel == -1
bool short70toBelow = changed and prevLevel == -1 and curLevel ==  0
bool short80toBelow = changed and prevLevel == -2 and curLevel ==  0
bool short90toBelow = changed and prevLevel == -3 and curLevel ==  0
bool shortToBelow   = changed and prevLevel <   0 and curLevel ==  0

// =====================================================================================
// §4. チャート表示（マークは4種類だけ）
// =====================================================================================
// 文字ラベルは使わず、plotshape() のマークだけを表示します。判定 (§3) は全レベル分そのまま動いています。
//   LONG 90%          … long90Signal   → ローソク足のすぐ下に 大きい明るい緑の ▲
//   SHORT 90%         … short90Signal  → ローソク足のすぐ上に 大きい明るい赤の ▼
//   LONG 70→70%未満   … long70toBelow  → ローソク足のすぐ下に 大きい明るい緑の ×
//   SHORT 70→70%未満  … short70toBelow → ローソク足のすぐ上に 大きい明るい赤の ×
// 70% / 80% 到達、90→80 / 90→70 / 80→70 の格下げ、80・90 から中立への移行は表示しません
// （× を出すのは「直前が70%だった場合」＝ long70toBelow / short70toBelow だけです）。
// 同じレベルが続いている間はマークを出しません（毎バーの増殖なし）。
//
// ★ このインジケーターは5分足チャート専用です（POINT MASTER 本体が5分足運用のため）。
//   5分足以外のチャートでは、マークもアラートも一切出しません（判定・テーブルは動きます）。
bool is5m = timeframe.isminutes and timeframe.multiplier == 5

plotshape(is5m and long90Signal and showLong90Label,   title = "LONG 90%",
     style = shape.triangleup,   location = location.belowbar, size = size.small, color = signalLongColor)
plotshape(is5m and short90Signal and showShort90Label, title = "SHORT 90%",
     style = shape.triangledown, location = location.abovebar, size = size.small, color = signalShortColor)
plotshape(is5m and long70toBelow and showBelowLabels,  title = "LONG 70% → BELOW",
     style = shape.xcross,       location = location.belowbar, size = size.small, color = signalLongColor)
plotshape(is5m and short70toBelow and showBelowLabels, title = "SHORT 70% → BELOW",
     style = shape.xcross,       location = location.abovebar, size = size.small, color = signalShortColor)

// =====================================================================================
// §5. データウィンドウ出力（NET SCORE と閾値ライン）
// =====================================================================================
// overlay = true なのでチャート上には描かず、データウィンドウでのみ確認できます。
// アラート文の {{plot("NET SCORE")}} / {{plot("LEVEL CODE")}} もこの plot を参照します。
plot(netSource, "NET SCORE",  display = display.data_window)
plot(curLevel,  "LEVEL CODE", display = display.data_window)
plot(th70,      "+70% Th",    display = display.data_window)
plot(th80,      "+80% Th",    display = display.data_window)
plot(th90,      "+90% Th",    display = display.data_window)
plot(-th70,     "-70% Th",    display = display.data_window)
plot(-th80,     "-80% Th",    display = display.data_window)
plot(-th90,     "-90% Th",    display = display.data_window)

// =====================================================================================
// §6. 現在状態テーブル
// =====================================================================================
f_tblPos(_s) =>
    _s == "右上" ? position.top_right : _s == "右下" ? position.bottom_right :
     _s == "左上" ? position.top_left : position.bottom_left

// テーブル専用の値（シグナル側の netSource / rawLevel / curLevel / prevLevel には触れません）
float tableNetScore = useTableNetSource ? tableNetSourceIn : netSource
int   tableLevel    = f_level(tableNetScore)   // しきい値は §1 と同じ（70 = 5.0 / 80 = 7.0 / 90 = 20.0）

var table stateTbl = table.new(f_tblPos(tblPosStr), 2, 3, border_width = 1)
// 表示は5分足チャートのみ。それ以外のTFへ切り替えたら、描画済みセルを消して何も残さない。
if showTable and is5m and barstate.islast
    table.cell(stateTbl, 0, 0, "NET SCORE", text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(stateTbl, 1, 0, na(tableNetScore) ? "-" : (tableNetScore > 0 ? "+" : "") + str.tostring(tableNetScore, "0.00"),
         text_color = f_levelColor(tableLevel), bgcolor = colTblBg, text_size = tblSize)
    table.cell(stateTbl, 0, 1, "DIRECTION", text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(stateTbl, 1, 1, f_dirText(tableLevel), text_color = f_levelColor(tableLevel), bgcolor = colTblBg, text_size = tblSize)
    table.cell(stateTbl, 0, 2, "LEVEL", text_color = colTblTxt, bgcolor = colTblBg, text_size = tblSize)
    table.cell(stateTbl, 1, 2, tableLevel == 0 ? "<70%" : f_pctNum(tableLevel) + "%",
         text_color = f_levelColor(tableLevel), bgcolor = colTblBg, text_size = tblSize)
else
    table.clear(stateTbl, 0, 0, 1, 2)

// =====================================================================================
// §7. アラート
// =====================================================================================
// メッセージ内の {{plot("NET SCORE")}} / {{plot("LEVEL CODE")}} で
// 現在の NET SCORE と Level コード（+3〜-3）が展開されます。
// 実際に用意するアラートは LONG 90% / SHORT 90% の2個だけです（5分足チャートでのみ発生）。
alertcondition(is5m and long90Signal,  title = "LONG 90%",
     message = 'POINT MASTER: LONG 90% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
alertcondition(is5m and short90Signal, title = "SHORT 90%",
     message = 'POINT MASTER: SHORT 90% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')

// --- 以下は今回アラートとして出しません（将来の再利用のためコメントで残しています）---
//   判定用の bool（long70Signal / long80Signal / short70Signal / short80Signal /
//   longDowngrade / shortDowngrade / longToBelow / shortToBelow など）は §3 に残っているので、
//   下の行のコメントを外すだけでアラートを復活できます。
// alertcondition(long70Signal,  title = "LONG 70%",
//      message = 'POINT MASTER: LONG 70% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(long80Signal,  title = "LONG 80%",
//      message = 'POINT MASTER: LONG 80% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(short70Signal, title = "SHORT 70%",
//      message = 'POINT MASTER: SHORT 70% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(short80Signal, title = "SHORT 80%",
//      message = 'POINT MASTER: SHORT 80% 到達 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(longDowngrade,  title = "LONG 信頼度低下",
//      message = 'POINT MASTER: LONG 信頼度低下 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(shortDowngrade, title = "SHORT 信頼度低下",
//      message = 'POINT MASTER: SHORT 信頼度低下 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(longToBelow,  title = "LONG 70%未満へ",
//      message = 'POINT MASTER: LONG が 70%未満へ低下 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')
// alertcondition(shortToBelow, title = "SHORT 70%未満へ",
//      message = 'POINT MASTER: SHORT が 70%未満へ低下 (NET={{plot("NET SCORE")}} / LEVEL={{plot("LEVEL CODE")}})')

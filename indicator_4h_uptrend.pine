//
// ============================================================
//  4H上昇 専用 統合インジケーター (4H Uptrend Integrated Indicator)
// ------------------------------------------------------------
//  「4Hが上昇している環境」の各パターンを 1つずつ logic として追加し、
//  最終的に 4H上昇専用の統合インジケーターへまとめる。
//
//  ・4Hレンジ版 (indicator.pine) とは完全に別ファイル。相互参照しない。
//  ・strategy() は使わない。実注文は出さない (indicator)。
//    シグナル表示 (ラベル) と alert のみ。
//  ・構造・変数管理・シグナル管理の思想は 4Hレンジ版に合わせる。
//
//  構成 (今後 logic02, logic03 … を追加できる設計):
//    1. 共通入力        2. 共通計算        3. 環境認識        4. 日足レジーム
//    5. ボラ判定        6. 時間帯・指標除外 7. WinZoneモジュール 8. モメンタムモジュール
//    9. トリガーモジュール 10. ロジック別条件  11. ランク優先処理   12. 競合処理
//    13. 仮シグナル      14. 確定シグナル     15. 仮想ポジション管理 16. 表示・アラート
//
//  === 実装済みロジック一覧 ===
//  logic01:
//    4H上昇 / 1H下降 / 15M下降
//    Bランク
//    高ボラ
//    MACD Hist拡大
//    SL15 / RR1.0
//  logic02:
//    4H上昇 / 1Hレンジ / 15M下降
//    Cランク
//    低ボラ
//    複数回反応水平線の反発
//    NYのみ
//    SL12 / RR1.0
//  logic03:
//    4H上昇 / 1Hレンジ / 15M下降
//    Bランク
//    ショートのみ
//    高ボラ
//    Fibまたは水平線
//    Asia＋NY
//    SL12 / RR1.0
//  logic04:
//    4H上昇 / 1Hレンジ / 15Mレンジ
//    Cランク
//    ロング＋ショート
//    低ボラ
//    出来高ブレイク
//    NYのみ
//    SL12 / RR1.0
//  logic05:
//    4H上昇 / 1Hレンジ / 15M上昇
//    Bランク
//    ロングのみ
//    低ボラ
//    フィボ
//    NYのみ
//    SL12 / RR1.0
//  logic06:
//    4H上昇 / 1H上昇 / 15M下降
//    Bランク
//    ロングのみ
//    低ボラ
//    水平線反発
//    (共通セッション/指標時間/ボラを使用)
//    SL・RR は共通リスク計算を使用
//  logic07:
//    4H上昇 / 1H上昇 / 15M下降
//    Aランク
//    ショートのみ
//    高ボラ
//    フィボ
//    (共通セッション/指標時間/ボラを使用)
//    SL12 / RR1.0
//  logic08:
//    4H上昇 / 1H上昇 / 15Mレンジ
//    Bランク
//    ロング＋ショート
//    低ボラ
//    水平線スイープ反転 ＋ EMA20リジェクト
//    NYのみ
//    SL10 / RR1.0
//  logic09:
//    4H上昇 / 1H上昇 / 15M上昇
//    Cランク
//    ロングのみ
//    低ボラ
//    FVG
//    (共通セッション Asia＋EU＋NY / 指標時間 / ボラを使用)
//    SL12 / RR1.0
//  logic10:
//    4H上昇 / 1H上昇 / 15M上昇
//    Bランク
//    ロングのみ
//    中ボラ
//    1分ストキャス Extreme Reversal
//    (共通セッション Asia＋EU＋NY / 指標時間 / ボラを使用)
//    SL12 / RR1.0
//
//  === logic01 (詳細) ===
//    ・4H:上昇 / 1H:下降 / 15M:下降 / 5M・1M:環境判定に使用しない
//    ・ランク: Bランク固定 (logic01Rank = "B")
//    ・添付「5min Engulfing Strategy」の最終エントリー条件のみを移植:
//        環境 = 4H上昇∧1H下降∧15M下降
//        日足 = 高ボラ (当日進行中ベース・固定値法・当日累積値幅≥140)
//        ボラ = 高速ボラ固定値 (直近5本値幅≥10 ∧ 実体平均5本≥0.5)
//        モメンタム = MACD(8,21,5) ヒスト拡大D (hist>0/<0・3本連続・状態5本)
//        WinZone/トリガー = 非使用 (元コードで全OFF・非接続)
//        SL = 固定15 / RR = 1.0 (元設定を維持)
//
//  === logic02 (詳細) ===
//    ・4H:上昇 / 1H:レンジ / 15M:下降 / 5M・1M:環境判定に使用しない
//    ・ランク: Cランク固定 (logic02Rank = "C")
//    ・添付「5min Engulfing Strategy」(初期設定違い版) の最終エントリー条件のみを移植:
//        環境 = 4H上昇∧1Hレンジ∧15M下降
//        日足 = 低ボラ (当日進行中ベース・固定値法・当日累積値幅<80)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = 水平線 反発のみ (複数回反応価格帯・5分・状態3本) → logic02LineLong/logic02LineShort (=lineBounceLong/Short)
//                  + not lineNoTradeLong / not lineNoTradeShort
//        モメンタム = 非使用 (ストキャス/MACD 共にOFF → logic02MomentumLong/Short = true)
//        トリガー = 非使用 (全OFF → logic02TriggerLong/Short = true)
//        セッション = NYのみ (Asia/EU OFF)
//        SL = 固定12 / RR = 1.0 (元設定を維持)
//
//  === logic04 (詳細) ===
//    ・4H:上昇 / 1H:レンジ / 15M:レンジ / 5M・1M:環境判定に使用しない
//    ・ランク: Cランク固定 (logic04Rank = "C")
//    ・添付「5min Engulfing Strategy」(出来高ブレイク版) の最終エントリー条件のみを移植:
//        環境 = 4H上昇∧1Hレンジ∧15Mレンジ
//        日足 = 低ボラ (当日進行中ベース・固定値法・当日累積値幅<80 / 高ボラ3バンドは使用しない)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = 出来高ブレイク のみ (Cパターン・5分・状態10本) → logic04VolumeLong/logic04VolumeShort
//                  ※ 水平線/Fib/POC等は接続しない
//        モメンタム = 非使用 (全OFF → logic04MomentumLong/Short = true)
//        トリガー = 非使用 (全OFF → logic04TriggerLong/Short = true)
//        セッション = NYのみ (Asia/EU OFF)
//        SL = 固定12 / RR = 1.0 (元設定を維持)
//
//  === logic05 (詳細) ===
//    ・4H:上昇 / 1H:レンジ / 15M:上昇 / 5M・1M:環境判定に使用しない
//    ・ランク: Bランク固定 (logic05Rank = "B") ※ロング専用 (logic05FinalShort=false)
//    ・添付「5min Engulfing Strategy」(フィボ版) の最終エントリー条件のみを移植:
//        環境 = 4H上昇∧1Hレンジ∧15M上昇
//        日足 = 低ボラ (当日進行中ベース・固定値法・当日累積値幅<80 / 高ボラ3区分は使用しない)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = フィボ のみ (押し目買い A/B/C帯・状態5本) → logic05FibLong (=longFibZoneOk)
//                  ※ FVG/出来高/EMA/水平線/lineNoTrade は接続しない
//                  ※ フィボ内部の A/B/C帯 と 統合ランク(B固定) は別物
//        モメンタム = 非使用 (ストキャス/MACD 共にOFF → logic05MomentumLong = true)
//        トリガー = 非使用 (全OFF → logic05TriggerLong = true)
//        セッション = NYのみ (Asia/EU OFF)
//        SL = 固定12 / RR = 1.0 (元設定を維持)
//
//  === logic06 (詳細) ===
//    ・4H:上昇 / 1H:上昇 / 15M:下降 / 5M・1M:環境判定に使用しない
//    ・ランク: Bランク固定 (logic06Rank = "B") ※ロング専用 (logic06FinalShort=false)
//    ・既存モジュールの出力のみを再利用 (新規計算・request.security 追加なし):
//        環境 = 4H上昇∧1H上昇∧15M下降 (共通 env4H/env1H/env15M を固定パターンで判定)
//        日足 = 低ボラ (方向は問わない / 高ボラ3区分は使用しない / 共通 drVolTextOut を参照)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = 水平線 反発ロングのみ → logic06LineLong (= 既存 lineBounceLong)
//                  + not lineNoTradeLong (統合出力 lineLongWinZone は使わず反発専用出力を使用)
//                  ※ 転換/ブレイク/スイープ・FVG/出来高/Fib/EMA は接続しない
//        モメンタム = 非使用 (共通設定の影響を受けない → logic06MomentumLong = true)
//        トリガー = 非使用 (共通設定の影響を受けない → logic06TriggerLong = true)
//        セッション/指標時間 = 既存共通 (sessionOk / allowByNewsTime) を再利用
//        SL/RR/ロット = 既存共通リスク計算 (longStop/longRisk/longTP/longQty) を再利用
//
//  === logic07 (詳細) ===
//    ・4H:上昇 / 1H:上昇 / 15M:下降 / 5M・1M:環境判定に使用しない
//    ・ランク: Aランク固定 (logic07Rank = "A") ※ショート専用 (logic07FinalLong=false)
//    ・既存モジュールの出力のみを再利用 (新規計算・request.security 追加なし):
//        環境 = 4H上昇∧1H上昇∧15M下降 (共通 env4H/env1H/env15M を固定パターンで判定)
//        日足 = 高ボラ (方向は問わない / 共通 drVolTextOut を参照)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = フィボ ショートのみ → logic07FibShort (= 既存 shortFibZoneOk)
//                  ※ FVG/出来高/EMA/水平線 は接続しない
//        モメンタム = 非使用 (共通設定の影響を受けない → logic07MomentumShort = true)
//        トリガー = 非使用 (共通設定の影響を受けない → logic07TriggerShort = true)
//        セッション/指標時間 = 既存共通 (sessionOk / allowByNewsTime) を再利用
//        SL = 固定12 / RR = 1.0 (共通 f_qty でロット算出)
//
//  === logic08 (詳細) ===
//    ・4H:上昇 / 1H:上昇 / 15M:レンジ / 5M・1M:環境判定に使用しない
//    ・ランク: Bランク固定 (logic08Rank = "B") ※ロング＋ショート両方
//    ・既存モジュールの出力を再利用 (新規 request.security / ATR / 水平線計算 追加なし):
//        環境 = 4H上昇∧1H上昇∧15Mレンジ (共通 env4H/env1H/env15M を固定パターンで判定)
//        日足 = 低ボラ (方向は問わない / 高ボラ3区分は使用しない / 共通 drVolTextOut を参照)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = 水平線 スイープ反転のみ → logic08LineLong/logic08LineShort (= logic08専用 logic08SweepLong/Short)
//                  ※ 最小貫通 ATR×0.3 の logic08専用生スイープ (共通 lineSweepToleranceATR=0.5 は不変)
//                  + not lineNoTradeLong / not lineNoTradeShort
//                  ※ 反発/転換/ブレイク・FVG/出来高/Fib/EMA は接続しない
//        モメンタム = 非使用 (共通設定の影響を受けない → logic08MomentumLong/Short = true)
//        トリガー = EMA20リジェクトのみ (傾きフィルターOFF → logic08TriggerLong/Short)
//                  ※ 包み足/ピンバー/BOS/FVG形成/強ローソク は接続しない
//                  ※ 4H-up には Trigger モジュール未移植のため EMA20 リジェクト判定を最小構成で追加
//        セッション = NYのみ (logic08専用 inNY) / 指標時間 = 既存共通 allowByNewsTime
//        SL = 固定10 / RR = 1.0 (共通 f_qty でロット算出)
//
//  === logic09 (詳細) ===
//    ・4H:上昇 / 1H:上昇 / 15M:上昇 / 5M・1M:環境判定に使用しない
//    ・ランク: Cランク固定 (logic09Rank = "C") ※ロングのみ (ショートは必ず無効)
//    ・既存 FVG モジュール (7d) の出力を再利用 (新規 request.security / ATR / FVG検出 追加なし):
//        環境 = 4H上昇∧1H上昇∧15M上昇 (共通 env4H/env1H/env15M を固定パターンで判定)
//        日足 = 低ボラ (方向は問わない / 高ボラ3区分・drDirTextOut は使用しない / 共通 drVolTextOut を参照)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = FVG のみ → logic09FVGLong (= 共通 longFVGOk)
//                  ※ Bullish FVG / FVG反発 / FVG吸収 / 逆側FVG近接 / USレンジ式(Accum→MSS) / 状態管理1本 /
//                    エントリー後リセット を再利用。ロング FVG 出力のみ。
//                  ※ 出来高POC/フィボ/EMA/水平線/iFVG/Bearish FVG のショート条件は接続しない
//        モメンタム = 非使用 (共通設定の影響を受けない → logic09MomentumLong = true)
//        トリガー = 非使用 (包み足/ピンバー/BOS/EMAリジェクト/FVG形成/強ローソク 全て非接続 → logic09TriggerLong = true)
//        セッション = Asia・EU・NY 全て (共通 sessionOk) / 指標時間 = 既存共通 allowByNewsTime
//        SL = 固定12 / RR = 1.0 (共通 f_qty でロット算出)
//
//  === logic10 (詳細) ===
//    ・4H:上昇 / 1H:上昇 / 15M:上昇 / 5M・1M:環境判定に使用しない
//    ・ランク: Bランク固定 (logic10Rank = "B") ※ロングのみ (ショートは必ず無効)
//    ・8b で移植した 1分ストキャスモジュールの出力を再利用:
//        環境 = 4H上昇∧1H上昇∧15M上昇 (共通 env4H/env1H/env15M を固定パターンで判定)
//        日足 = 中ボラ (方向は問わない / 高ボラ3区分・drDirTextOut は使用しない / 共通 drVolTextOut を参照)
//        ボラ = logic01 と同一の共通 volOk (高速ボラ固定値)
//        WinZone = 使用しない (元ストラテジーで FVG/出来高/POC/フィボ/EMA/水平線 が全OFF → 常時通過)
//                  ※ lineNoTradeLong は接続しない
//        モメンタム = 1分ストキャス Extreme Reversal のみ → logic10MomentumLong (= 共通 allowLongByStoch)
//                  ※ %K21/%Kスムージング3/%D3 / 1分参照 / Extreme High90・Low10 /
//                    傾き反転ON・K/DクロスON・一回発火ON・Highリセット80・Lowリセット20 /
//                    状態管理ON・有効5本・エントリー後リセットON。ロング側のみ使用。
//                  ※ MACD・OB/OS・Middle・Stickiness・Divergence は接続しない
//        トリガー = 非使用 (包み足/ピンバー/BOS/EMAリジェクト/FVG形成/強ローソク 全て非接続 → logic10TriggerLong = true)
//        セッション = Asia・EU・NY 全て (共通 sessionOk) / 指標時間 = 既存共通 allowByNewsTime
//        SL = 固定12 / RR = 1.0 (共通 f_qty でロット算出)
//  ※ 5分足でのみ 仮/確定シグナル・ラベル・仮想ポジションを有効化。
// ============================================================

//@version=5
indicator(
     title             = "4H Uptrend Integrated Indicator",
     shorttitle        = "4H-UP",
     overlay           = true,
     dynamic_requests  = true,
     max_bars_back     = 1000,
     max_labels_count  = 500
 )

// ============================================================
//  1. 共通入力
// ============================================================
// --- 資金 / リスク (strategy.equity は使えないため input で受ける) ---
grpCap = "資金 / リスク"
indicatorCapital = input.float(1000, "計算用資金 (元金・単利)", minval = 0.0, step = 100, group = grpCap)
riskPct          = input.float(5.0,  "1トレード損失率 (%)", minval = 0.1, step = 0.1, group = grpCap)

// --- エントリー方向 ---
grpEntry = "エントリー"
useLong  = input.bool(true, "ロングを有効",   group = grpEntry)
useShort = input.bool(true, "ショートを有効", group = grpEntry)

// --- 時間帯フィルタ (東京時間 JST) ---
grpSession = "時間帯フィルタ (東京時間)"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = grpSession)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = grpSession)
useEUSession     = input.bool(true, "EU 16:00-21:00",   group = grpSession)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = grpSession)

// --- 指標時間フィルタ (Asia/Tokyo・新規のみ除外) ---
grpNews = "指標時間フィルタ (Asia/Tokyo)"
useNewsTimeFilter = input.bool(false, "重要指標時間を除外", group = grpNews)
newsSession1 = input.session("2130-2230", "指標除外時間1", group = grpNews)
newsSession2 = input.session("2330-0030", "指標除外時間2", group = grpNews)
newsSession3 = input.session("0300-0400", "指標除外時間3", group = grpNews)

// --- 仮想ポジション ---
grpPos = "仮想ポジション"
useVirtualPositionBlock = input.bool(true, "仮想ポジション保有中は新規シグナルを抑止", group = grpPos)

// ============================================================
//  3. 環境認識 (入力) — 4Hレンジ版と同一の環境認識ロジック
// ------------------------------------------------------------
//  EMA20/50/200・傾き・EMA間距離・収束/拡散・スコア・最低必要スコア・
//  同点処理・条件不足処理・request.security の時間足・lookahead は
//  添付ストラテジーから変更しない。
// ============================================================
grpTF = "環境: 参照時間足"
tf4H  = input.timeframe("240", "4H TF",  group = grpTF)
tf1H  = input.timeframe("60",  "1H TF",  group = grpTF)
tf15M = input.timeframe("15",  "15M TF", group = grpTF)

grpBull = "環境: 上昇条件 ON/OFF"
useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50",       group = grpBull)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き",       group = grpBull)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き",       group = grpBull)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50",       group = grpBull)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200",      group = grpBull)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBull)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBull)

grpBear = "環境: 下降条件 ON/OFF"
useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50",       group = grpBear)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き",       group = grpBear)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き",       group = grpBear)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50",       group = grpBear)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200",      group = grpBear)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い",  group = grpBear)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中",    group = grpBear)

grpRange = "環境: レンジ条件 ON/OFF"
useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い",       group = grpRange)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い",         group = grpRange)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い",         group = grpRange)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中",          group = grpRange)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ", group = grpRange)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ", group = grpRange)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい",         group = grpRange)

grpParam = "環境: 調整パラメータ"
len20        = input.int(20,   "EMA20 length",  minval = 1, group = grpParam)
len50        = input.int(50,   "EMA50 length",  minval = 1, group = grpParam)
len200       = input.int(200,  "EMA200 length", minval = 1, group = grpParam)
envAtrLen    = input.int(14,   "環境ATR length", minval = 1, group = grpParam)
slopeBars    = input.int(3,    "EMA 傾き判定本数", minval = 1, group = grpParam)
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率",       minval = 0, step = 0.01, group = grpParam)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率", minval = 0, step = 0.01, group = grpParam)
convDivBars  = input.int(5,    "収束/拡散 判定本数",   minval = 1, group = grpParam)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数", minval = 1, group = grpParam)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数", minval = 1, group = grpParam)
rangeBars    = input.int(20,   "レンジ幅 判定本数",    minval = 1, group = grpParam)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率",    minval = 0, step = 0.1, group = grpParam)

grpJudge = "環境: 判定ルール"
tieAsRange          = input.bool(true, "同点時にレンジ扱いする",     group = grpJudge)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = grpJudge)
minScore4H  = input.int(3, "4H 最低必要スコア",  minval = 1, group = grpJudge)
minScore1H  = input.int(3, "1H 最低必要スコア",  minval = 1, group = grpJudge)
minScore15M = input.int(3, "15M 最低必要スコア", minval = 1, group = grpJudge)

// ============================================================
//  4. 日足レジーム (入力) — 分類のみ行い、各ロジックが要求レジームを判定
// ============================================================
grpDailyRegime = "日足レジーム"
useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う", group = grpDailyRegime)
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"], group = grpDailyRegime, tooltip = "前日確定ベース=確定済み前日日足で翌日を制限 (非リペイント)。当日進行中ベース=当日始値からその足までの累積値幅で分類 (未来参照なし・非リペイント・エントリー接続)。当日確定後分析=完成日足の事後分類 (エントリー制限には使用しない・表示専用)。")
dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"], group = grpDailyRegime)
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数", minval = 30, group = grpDailyRegime)
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル", minval = 1, maxval = 49, step = 1, group = grpDailyRegime)
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル", minval = 51, maxval = 99, step = 1, group = grpDailyRegime)
dailyAtrLen       = input.int(14, "日足ATR期間", minval = 1, group = grpDailyRegime)
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR", minval = 0.1, step = 0.05, group = grpDailyRegime)
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR", minval = 0.1, step = 0.05, group = grpDailyRegime)
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)", minval = 0, step = 0.1, group = grpDailyRegime)
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)", minval = 0, step = 0.1, group = grpDailyRegime)
dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い", group = grpDailyRegime)
// --- 高ボラ3区分 (140以上を細分化・個別ON/OFF。境界は重複なし)。ONの区分だけ許可 ---
//   140以上170未満 / 170以上200未満 / 200以上。高ボラ判定日にのみ影響 (低/中ボラ日は不変)。
useHighVol140to170 = input.bool(true, "高ボラ 140〜170", group = grpDailyRegime)
useHighVol170to200 = input.bool(true, "高ボラ 170〜200", group = grpDailyRegime)
useHighVol200Plus  = input.bool(true, "異常ボラ 200以上", group = grpDailyRegime)
highVolLevel1   = input.float(140.0, "高ボラ1 下限", minval = 0, step = 0.1, group = grpDailyRegime)
highVolLevel2   = input.float(170.0, "高ボラ2 下限", minval = 0, step = 0.1, group = grpDailyRegime)
extremeVolLevel = input.float(200.0, "異常ボラ 下限", minval = 0, step = 0.1, group = grpDailyRegime)

// ============================================================
//  5. ボラ判定 (入力) — 通常ボラ / 高速ボラ
// ============================================================
grpVol = "ボラフィルタ"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)
fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", minval = 0.0, step = 0.1, group = grpVol)
atrLenBase   = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5,  "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen    = input.int(480,    "ATR平均本数", minval = 10, group = grpVol)
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = grpVol)
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数", minval = 1, group = grpVol)
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時", step = 0.1, group = grpVol)
fastFixedMin = input.float(10.0, "直近値幅 最低($) ※固定値時", minval = 0.0, step = 0.1, group = grpVol)
bodyAvgLen   = input.int(5,      "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin   = input.float(0.5,  "実体平均最低($)", step = 0.1, group = grpVol)
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時", group = grpVol)
rangeLookback       = input.int(20,    "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数", minval = 1, group = grpVol)

// ============================================================
//  8. モメンタム (入力) — MACD (logic01 が使用する唯一の接続モメンタム)
// ============================================================
grpMACD = "Momentum: MACD"
useMACDModule      = input.bool(true, "MACDモジュールを使う", group = grpMACD)
macdFastLen        = input.int(8,  "Fast EMA",   minval = 1, group = grpMACD)
macdSlowLen        = input.int(21, "Slow EMA",   minval = 1, group = grpMACD)
macdSignalLen      = input.int(5,  "Signal EMA", minval = 1, group = grpMACD)
useMACDHistDirectionFilter = input.bool(true, "Hist位置フィルター (hist>0/<0)", group = grpMACD)
macdHistExpansionBars = input.int(3, "Hist拡大 連続本数", minval = 1, group = grpMACD)
useMACDStateWindow = input.bool(true, "MACD状態管理を使う", group = grpMACD)
macdStateMaxBars   = input.int(5, "MACD状態 有効本数", minval = 1, group = grpMACD)
resetMACDStateAfterEntry = input.bool(true, "エントリー後MACD状態をリセット", group = grpMACD)

// ============================================================
//  8b. モメンタム (入力) — 1分ストキャス Extreme Reversal (logic10 が使用)
// ------------------------------------------------------------
//  添付ストラテジーの Momentum ストキャス設定を移植 (変更しない):
//    ストキャス %K=21 / %Kスムージング=3 / %D=3 / 参照TF=1分 (lookahead_off)
//    Extreme High=90 / Extreme Low=10。パターンは A: Extreme Reversal のみ ON
//    (OB/OS Cross・Middle Cross・Stickiness・Divergence は未使用=未移植)。
//    Extreme Reversal: 傾き反転確認ON / K/Dクロス確認ON / Extreme一回発火ON /
//    Highリセット80 / Lowリセット20 / 角度・戻り量フィルターOFF。
//    状態管理ON / 有効本数5 / エントリー後リセットON。
//  ※ 4H-up には元々ストキャスモジュールが無いため最小構成で移植。1分参照の
//    request.security は logic10 に不可欠なため1つだけ追加 (重複追加なし)。
// ============================================================
grpStoch = "Momentum: 1分ストキャス (logic10が使用)"
useStochModule   = input.bool(true, "1分ストキャスモジュールを使う (logic10が使用)", group = grpStoch)
useExtremeReversal = input.bool(true, "A: Extreme Reversal", group = grpStoch)
kLen    = input.int(21, "%K 期間",       minval = 1, group = grpStoch)
kSmooth = input.int(3,  "%K スムージング", minval = 1, group = grpStoch)
dLen    = input.int(3,  "%D 期間",       minval = 1, group = grpStoch)
useStochTF = input.bool(true, "ストキャス参照TFを使う", group = grpStoch)
stochTF    = input.timeframe("1", "ストキャス参照TF", group = grpStoch)
extremeHigh = input.float(90, "Extreme High", group = grpStoch)
extremeLow  = input.float(10, "Extreme Low",  group = grpStoch)
useExtremeSlopeTurn    = input.bool(true, "傾き反転で確認", group = grpStoch)
useExtremeKDCross      = input.bool(true, "K/Dクロスで確認", group = grpStoch)
extremeLookback        = input.int(5, "Extreme 到達 参照本数", minval = 1, group = grpStoch)
useExtremeOneShot      = input.bool(true, "Extreme 一回だけ発火", group = grpStoch)
extremeResetLevelHigh  = input.float(80, "High リセットレベル", group = grpStoch)
extremeResetLevelLow   = input.float(20, "Low リセットレベル",  group = grpStoch)
useSlopeStrengthFilter = input.bool(false, "折り返し角度フィルター", group = grpStoch)
stochSlopeMin          = input.float(2.0, "最小スロープ(|ΔK|)", minval = 0.0, step = 0.5, group = grpStoch)
useExtremeRetraceFilter= input.bool(false, "戻り量フィルター", group = grpStoch)
extremeRetraceMin      = input.float(5.0, "最小戻り量(ポイント)", minval = 0.0, step = 0.5, group = grpStoch)
useStochStateWindow       = input.bool(true, "ストキャス状態管理を使う", group = grpStoch)
stochStateMaxBars         = input.int(5, "ストキャス状態 有効本数", minval = 1, group = grpStoch)
resetStochStateAfterEntry = input.bool(true, "エントリー後ストキャス状態をリセット", group = grpStoch)

// ============================================================
//  7. WinZone: 水平線モジュール (入力) — logic02 が使用
// ------------------------------------------------------------
//  添付ストラテジーの水平線WinZone設定をそのまま移植 (変更しない):
//    ソース  : 複数回反応価格帯のみ ON (Pivot/前日HL/セッションHL は OFF)
//    パターン: 反発のみ ON (レジサポ転換/ブレイク/スイープ は OFF)
//    MTF     : 5分のみ ON
//    状態    : 状態管理ON / 有効3本 / エントリー後リセットON
//  ※ logic01 はこのモジュールを使わない (logic01 の longWinZoneOk は常時true)。
// ============================================================
grpLineSrc = "水平線: 検出ソース"
useLineModule    = input.bool(true, "水平線モジュールを使う (logic02が使用)", group = grpLineSrc)
usePivotLine     = input.bool(false, "Pivot High/Low", group = grpLineSrc)
useReactionLine  = input.bool(true, "複数回反応価格帯", group = grpLineSrc)
usePreviousDayHL = input.bool(false, "前日 高値/安値", group = grpLineSrc)
useSessionHL     = input.bool(false, "セッション 高値/安値", group = grpLineSrc)

grpLineTF = "水平線: MTF"
useLine1M  = input.bool(false, "1分水平線を使う",   group = grpLineTF)
useLine5M  = input.bool(true,  "5分水平線を使う",   group = grpLineTF)
useLine15M = input.bool(false, "15分水平線を使う",  group = grpLineTF)
useLine1H  = input.bool(false, "1時間水平線を使う", group = grpLineTF)
useLine4H  = input.bool(false, "4時間水平線を使う", group = grpLineTF)
tfLine1M  = input.timeframe("1",   "1分TF",   group = grpLineTF)
tfLine5M  = input.timeframe("5",   "5分TF",   group = grpLineTF)
tfLine15M = input.timeframe("15",  "15分TF",  group = grpLineTF)
tfLine1H  = input.timeframe("60",  "1時間TF", group = grpLineTF)
tfLine4H  = input.timeframe("240", "4時間TF", group = grpLineTF)

grpLinePat = "水平線: パターン"
//  4パターンをすべて計算し、方向別に個別出力する。各ロジックが必要なパターンだけを選択:
//    logic02 = 反発のみ (lineBounceLong/Short)
//    logic03 = ショート全パターン (反発/転換/ブレイク/スイープ)
//  ※ 全ONにしても logic02 は反発出力しか読まないため logic02 の条件は変わらない。
useLineBounce = input.bool(true, "反発", group = grpLinePat)
useLineFlip   = input.bool(true, "レジサポ転換", group = grpLinePat)
useLineBreak  = input.bool(true, "ブレイク", group = grpLinePat)
useLineSweep  = input.bool(true, "スイープ反転", group = grpLinePat)

grpLineParam = "水平線: パラメータ"
lineAtrLen   = input.int(14, "ATR期間", minval = 1, group = grpLineParam)
lineMaxZones = input.int(20, "水平線 最大保持数", minval = 1, group = grpLineParam)
linePivotLen = input.int(10, "Pivot Length", minval = 1, group = grpLineParam)
reactionLookback     = input.int(300, "反応 参照本数", minval = 1, group = grpLineParam)
reactionToleranceATR = input.float(0.3, "反応 許容幅 ATR倍率", step = 0.05, group = grpLineParam)
reactionMinTouches   = input.int(2, "反応 最小タッチ数", minval = 2, group = grpLineParam)
lineFlipLookback     = input.int(30, "転換 参照本数", minval = 1, group = grpLineParam)
lineFlipConfirmBars  = input.int(2,  "転換 確定本数", minval = 0, group = grpLineParam)
useLineBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター", group = grpLineParam)
lineBreakBodyRatio     = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineParam)
lineSweepToleranceATR  = input.float(0.5, "スイープ 最小貫通 ATR倍率", minval = 0.0, step = 0.05, group = grpLineParam)
lineBreakBufferMode   = input.string("ATR", "ブレイク 最小バッファ方式", options = ["Dollar", "ATR", "None"], group = grpLineParam)
lineBreakBufferDollar = input.float(0.5,  "ブレイク バッファ(ドル/価格)", minval = 0.0, step = 0.1,  group = grpLineParam)
lineBreakBufferATR    = input.float(0.10, "ブレイク バッファ ATR倍率",   minval = 0.0, step = 0.05, group = grpLineParam)
lineBreakConfirmMode  = input.string("CloseOnly", "ブレイク 確定方式", options = ["CloseOnly", "NextBar", "Consecutive"], group = grpLineParam)
lineBreakConfirmBars  = input.int(2, "ブレイク 連続確定本数(Consecutive)", minval = 1, maxval = 10, group = grpLineParam)
lineSessionMaxDays    = input.int(2, "セッション水平線 有効日数(当日含む)", minval = 1, maxval = 10, group = grpLineParam)

grpLineFilt = "水平線: 共通フィルター"
useLineDirCandleFilter = input.bool(false, "方向ローソク", group = grpLineFilt)
useLineWickFilter      = input.bool(false, "ヒゲ確認",     group = grpLineFilt)
useLineBodyFilter      = input.bool(false, "実体率",       group = grpLineFilt)
useLineATRFilter       = input.bool(false, "ATR(値幅)",    group = grpLineFilt)
lineBodyRatioMin       = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineFilt)
lineAtrMinMult         = input.float(0.5, "最小値幅 ATR倍率", minval = 0.0, step = 0.05, group = grpLineFilt)

grpLineZone = "水平線: ゾーン"
useLineATRZone     = input.bool(false, "ゾーン幅をATR連動にする", group = grpLineZone)
lineZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率", step = 0.05, group = grpLineZone)
lineZoneFixedWidth = input.float(0.1, "ゾーン幅 固定", step = 0.1, group = grpLineZone)
useLineMergeZone   = input.bool(false, "近い水平線をゾーン統合する", group = grpLineZone)
lineMergeToleranceATR = input.float(0.2, "統合許容幅 ATR倍率", step = 0.05, group = grpLineZone)

grpLineSess = "水平線: セッション"
lineSessTZ     = input.string("GMT", "セッション タイムゾーン", group = grpLineSess)
lineAsiaSess   = input.session("0000-0800", "Asia",   group = grpLineSess)
lineLondonSess = input.session("0700-1600", "London", group = grpLineSess)
lineNySess     = input.session("1200-2100", "New York", group = grpLineSess)

grpLineObs = "水平線: 障害物"
useLineObstacleFilter = input.bool(false, "水平線障害物フィルターを使う", group = grpLineObs)
lineObstacleATR       = input.float(0.5, "障害物 近接 ATR倍率", step = 0.05, group = grpLineObs)

grpLineState = "水平線: 状態管理"
useLineStateWindow       = input.bool(true, "水平線状態管理を使う", group = grpLineState)
lineStateMaxBars         = input.int(3, "水平線状態 有効本数", minval = 1, group = grpLineState)
resetLineStateAfterEntry = input.bool(true, "エントリー後水平線状態をリセット", group = grpLineState)

// ============================================================
//  7. WinZone: フィボモジュール (入力) — logic03 が使用
// ------------------------------------------------------------
//  添付ストラテジーのフィボWinZone設定をそのまま移植 (変更しない):
//    BUY検出/SELL検出=ON / 波検出 ATR14・EMA20・スイング3・波100・最低波幅ATR×2.0 /
//    ゾーン許容 ATR×0.3 / 確定足のみ ON / ランク帯 A/B/C 全ON /
//    反転確認=すべてOFF / 無効=深限界ON・波起点ON・EMA定着OFF / 状態管理ON 5本 リセットON。
//  ※ フィボ内部ランク(A/B/C帯)は 統合シグナルのランクとは無関係 (logic03は常にBランク)。
//  ※ logic01/logic02 はこのモジュールを使わない。logic03 は shortFibZoneOk のみ使用。
// ============================================================
grpFibModule = "フィボ WinZone"
useFibModule = input.bool(true, "フィボモジュールを使う (logic03が使用)", group = grpFibModule)

grpFib = "フィボ: 波検出 / 設定"
useFibSell = input.bool(true, "SELL(戻り売り)検出", group = grpFib)
useFibBuy  = input.bool(true, "BUY(押し目買い)検出", group = grpFib)
fibAtrLen        = input.int(14,  "Fib ATR期間", minval = 1, group = grpFib)
fibEma20Len      = input.int(20,  "Fib EMA20期間 (反転確認用)", minval = 1, group = grpFib)
swingLookback    = input.int(3,   "スイング検出 左右本数", minval = 1, group = grpFib)
waveLookback     = input.int(100, "波の有効本数 (古い波は無視)", minval = 10, group = grpFib)
minWaveATR       = input.float(2.0, "最低波幅 (ATR倍)", minval = 0.0, step = 0.1, group = grpFib)
fibZoneBufferATR = input.float(0.3, "フィボゾーン許容 (ATR倍)", step = 0.05, group = grpFib)
requireConfirmedBar = input.bool(true, "確定足でのみシグナル (リペイント回避)", group = grpFib)

grpFibRank = "フィボ: ランク / レベル (内部帯・シグナルランクとは無関係)"
useRankA = input.bool(true, "A ランク (深い)", group = grpFibRank)
useRankB = input.bool(true, "B ランク (王道)", group = grpFibRank)
useRankC = input.bool(true, "C ランク (浅い)", group = grpFibRank)
fibAStart = input.float(0.618, "A 開始", step = 0.001, group = grpFibRank)
fibAEnd   = input.float(0.786, "A 終了", step = 0.001, group = grpFibRank)
fibBStart = input.float(0.500, "B 開始", step = 0.001, group = grpFibRank)
fibBEnd   = input.float(0.618, "B 終了", step = 0.001, group = grpFibRank)
fibCStart = input.float(0.382, "C 開始", step = 0.001, group = grpFibRank)
fibCEnd   = input.float(0.500, "C 終了", step = 0.001, group = grpFibRank)

grpFibConf = "フィボ: 反転確認"
useRejectConfirm    = input.bool(false, "反転確認を必須にする", group = grpFibConf)
useCandleConfirm    = input.bool(false, "陽線/陰線 確定",       group = grpFibConf)
usePinbarConfirm    = input.bool(false, "ピンバー (上/下ヒゲ)", group = grpFibConf)
useEngulfingConfirm = input.bool(false, "包み足 (engulfing)",   group = grpFibConf)
useEma20Confirm     = input.bool(false, "close と EMA20 の関係", group = grpFibConf)
useBreakPrevConfirm = input.bool(false, "直近足の高値/安値更新",  group = grpFibConf)

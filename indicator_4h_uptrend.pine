breakoutBodyRatioMin = input.float(0.3, "ブレイク実体比 下限", minval = 0, step = 0.05, group = grpVolBrk)
// 以下フィルタは元コードで全OFF (非接続) のため既定OFFのまま保持
useATRExpansionFilter = input.bool(false, "ATR拡大フィルタ",     group = grpVolBrk)
atrExpansionMult      = input.float(1.2, "ATR拡大倍率", minval = 0, step = 0.1, group = grpVolBrk)

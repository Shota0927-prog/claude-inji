grpFvg = "FVG 場所フィルター"
useFVGFilter           = input.bool(true, "FVG場所フィルターを使う", group = grpFvg)
useFVGReboundFilter    = input.bool(true,  "FVG反発を許可",          group = grpFvg)
useFVGAbsorptionFilter = input.bool(true, "FVG吸収を許可",          group = grpFvg)
useIFVGFilter          = input.bool(false, "iFVGを許可",             group = grpFvg)
useBullishFVG    = input.bool(true,  "Bullish FVG (ロング側)",  group = grpFvg)
useBearishFVG    = input.bool(true,  "Bearish FVG (ショート側)", group = grpFvg)
useOppositeFVGFilter  = input.bool(true, "逆側FVG近接フィルター",   group = grpFvg)
fvgMaxAge        = input.int(100, "FVG最大年齢(本)",    minval = 1, group = grpFvg)
maxFVGPerSide    = input.int(120, "片側 最大FVG保持数", minval = 1, maxval = 500, group = grpFvg)
absorbBodyMinRatio = input.float(0.50, "吸収 実体最小比率",         minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
absorbCloseEdgeRatio = input.float(0.0, "吸収 close端寄り比率",    minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
useFVGStateWindow       = input.bool(true, "FVG状態管理を使う", group = grpFvg)
fvgStateMaxBars         = input.int(1, "FVG状態 有効本数", minval = 1, group = grpFvg)
resetFVGStateAfterEntry = input.bool(true, "エントリー後FVG状態をリセット", group = grpFvg)

grpFvgUS = "FVG: USレンジ式 (Accum/MSS)"
fvgAccumRangeLen       = input.int(10, "Accum判定レンジ本数",   minval = 6,  group = grpFvgUS)
fvgAccumBaseLen        = input.int(20, "Accum基準平均本数",     minval = 10, group = grpFvgUS)
fvgAccumAtrLen         = input.int(14, "Accum ATR本数",         minval = 1,  group = grpFvgUS)
fvgAccumMinUpperCloses = input.int(4,  "上半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMinLowerCloses = input.int(4,  "下半分の最低終値本数",   minval = 1,  group = grpFvgUS)
fvgAccumMaxSameColorRun= input.int(4,  "同色連続の上限",         minval = 1,  group = grpFvgUS)
fvgAccumAtrMult        = input.float(2.5,  "Accum レンジ幅/ATR 上限",  minval = 0.5, step = 0.1,  group = grpFvgUS)
fvgAccumBarRatioMax    = input.float(0.70, "Accum 短期/基準 幅比 上限", minval = 0.1, step = 0.01, group = grpFvgUS)
fvgAccumDriftMax       = input.float(0.30, "Accum ドリフト上限",       minval = 0.05, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgMssValidBars        = input.int(100, "MSS有効本数", minval = 10, group = grpFvgUS)
fvgMssNeedBodyStrength = input.bool(true, "MSSで実体強度を使う", group = grpFvgUS)
fvgMssImpulseMult      = input.float(0.5, "MSS インパルス強度", minval = 0.0, step = 0.05, group = grpFvgUS)
fvgThicknessMinRebound    = input.float(0.1, "FVG厚み最小[反発] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgThicknessMinAbsorption = input.float(0.00, "FVG厚み最小[吸収] (幅/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgReboundConfirmDepthBuy  = input.float(0.70, "反発確定深度上限[BUY]",  minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundConfirmDepthSell = input.float(0.70, "反発確定深度上限[SELL]", minval = 0.1, maxval = 1.0, step = 0.05, group = grpFvgUS)
useFVGReboundStrictCandleBuy  = input.bool(false, "反発 ローソク強度[BUY]",  group = grpFvgUS)
useFVGReboundStrictCandleSell = input.bool(false, "反発 ローソク強度[SELL]", group = grpFvgUS)
fvgReboundBodyMinRatioBuy   = input.float(0.05, "反発 実体率下限[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundBodyMinRatioSell  = input.float(0.05, "反発 実体率下限[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioBuy  = input.float(0.30, "反発 close端寄り[BUY]",  minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgReboundCloseEdgeRatioSell = input.float(0.30, "反発 close端寄り[SELL]", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvgUS)
fvgOppositeNearGapMax   = input.float(0.0, "逆側FVG近接距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)
fvgOppositeMinThickness = input.float(0.0, "逆側FVG最低厚み (厚み/Accum幅)",     minval = 0.0, step = 0.01, group = grpFvgUS)
fvgAbsorbThinRatioMax = input.float(0.00, "吸収 薄いFVG上限 (幅/Accum幅)",   minval = 0.0, step = 0.01, group = grpFvgUS)
fvgAbsorbNearGapMax   = input.float(0.00, "吸収 近接FVG距離上限 (距離/Accum幅)", minval = 0.0, step = 0.01, group = grpFvgUS)

// ============================================================
//  2. 共通計算
// ============================================================
bool is5m = timeframe.isminutes and timeframe.multiplier == 5

// 資金 → 損失許容額 → 整数ロット (1未満はエントリー不可)
float riskCapital = indicatorCapital * riskPct / 100.0
f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

// 出力ヘルパー (4Hレンジ版と同一形式)
f_fmtP(float p) => str.tostring(p, format.mintick)
f_fmtSize(float s) => str.tostring(s, "#.##")
f_rankText(string r) => r + "ランク"

f_sigMsg(string state, string dir, string rankText, string logicName, float entry, float sl, float tp, float sz, string volT) =>
    "【" + (state == "仮" ? "仮シグナル" : "確定シグナル") + "】\n" +
     "状態: " + state + "\n" +
     dir + "\n" +
     f_rankText(rankText) + "\n" +
     logicName + "\n" +
     "Entry: " + f_fmtP(entry) + "\n" +
     "SL: " + f_fmtP(sl) + "\n" +
     "TP: " + f_fmtP(tp) + "\n" +
     "Size: " + f_fmtSize(sz) + "\n" +
     "日足ボラ: " + volT

f_labelText(string dir, string rankText, string logicName, float entry, float sl, float tp, float sz, string volT) =>
    "確定\n" + dir + "\n" +
     f_rankText(rankText) + "\n" +
     logicName + "\n" +
     "Entry: " + f_fmtP(entry) + "\n" +
     "SL: " + f_fmtP(sl) + "\n" +
     "TP: " + f_fmtP(tp) + "\n" +
     "Size: " + f_fmtSize(sz) + "\n" +
     "日足ボラ: " + volT

// ランク色 (A>B>C。将来のロジック追加を見越して3色用意)
color COLOR_RANK_A = color.rgb(25, 70, 140)    // Aランク=濃紺
color COLOR_RANK_B = color.rgb(0, 100, 0)      // Bランク=深緑 (4Hレンジ版と同一)
color COLOR_RANK_C = color.rgb(150, 90, 0)     // Cランク=琥珀

// ============================================================
//  3. 環境認識 (計算) — f_envTrend は添付ストラテジーから不変
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = maxScore < minScore ? (insufficientAsRange ? 0 : na) :
                 tie                 ? (tieAsRange ? 0 : na) :
                 isBullTop           ? 1 :
                 isBearTop           ? -1 :
                 0
    trend

f_trendText(int c) => c == 1 ? "上昇" : c == 0 ? "レンジ" : c == -1 ? "下降" : "-"

// 共有 環境トレンド (logic01〜logic10 が 4H/1H/15M を使用)
//   4H・1H・15M環境判定は、リアルタイムと再読込後の不一致を防ぐため、直前に確定した
//   上位足を使用する (関数戻り値 [1] + lookahead_on = 標準の非リペイント取得)。
//   [1] で 1本前 (=確定済み) の上位足結果を参照し、lookahead_on と組み合わせても未来参照は
//   発生しない (確定値のみを見るため)。
//   そのため、未確定上位足を参照していた旧版 (lookahead_off・[1]なし) と比べて、
//   環境切替およびシグナル発生タイミングが変わる可能性がある。
int env4H  = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H)[1],  lookahead = barmerge.lookahead_on)
int env1H  = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H)[1],  lookahead = barmerge.lookahead_on)
int env15M = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M)[1], lookahead = barmerge.lookahead_on)

// ============================================================
//  4. 日足レジーム (計算) — 分類のみ (drVolTextOut / drDirTextOut を出力)
// ============================================================
f_dailyDirectionText(int code) => code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) => code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

// --- 日足レジーム本体 (方向/ボラ分類・モード・データ不足処理は添付ストラテジーと同一) ---
f_calcDailyRegime() =>
    int    drDirCodeAdj = na
    int    drVolCodeAdj = na
    string drDirTextOut = "-"
    string drVolTextOut = "-"
    bool   drHighVolBandOk = true   // 高ボラ3区分 (ONの区分のみ許可)。高ボラ日以外は常に true
    if useDailyRegimeFilter
        [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

        var float drCurDayOpen = na
        var float drCurDayHigh = na
        var float drCurDayLow  = na
        bool drNewDay = ta.change(time("D")) != 0
        bool drDayReset = drNewDay or na(drCurDayHigh)
        drCurDayOpen := drDayReset ? open : drCurDayOpen
        drCurDayHigh := drDayReset ? high : math.max(drCurDayHigh, high)
        drCurDayLow  := drDayReset ? low  : math.min(drCurDayLow, low)
        float drIntradayRange = drCurDayHigh - drCurDayLow

        bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
        bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

        float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
        float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
        float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
        float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

        float drRange   = drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
        float drDailyATR = drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
        float drLoThr = drUsePrev ? _loT1 : _loT0
        float drHiThr = drUsePrev ? _hiT1 : _hiT0

        int drDirCode = f_drDirCode(drO, drH, drL, drC)
        int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
        bool drDirInsufficient = na(drDirCode)
        bool drVolInsufficient = na(drVolCode)
        drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
        drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode
        drDirTextOut := f_dailyDirectionText(drDirCodeAdj)
        drVolTextOut := f_dailyVolatilityText(drVolCodeAdj)
        // --- 高ボラ3区分 (共通日足値幅 drRange を再利用・境界重複なし) ---
        //   140以上170未満 / 170以上200未満 / 200以上。ONの区分のOR。
        //   高ボラ日 (drVolCodeAdj==1) にのみ影響。低/中ボラ日は常に true (logic02の低ボラは非影響)。
        bool _highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
        bool _highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
        bool _highVol200Plus  = drRange >= extremeVolLevel
        bool _allowHighVol =
             (useHighVol140to170 and _highVol140to170) or
             (useHighVol170to200 and _highVol170to200) or
             (useHighVol200Plus  and _highVol200Plus)
        bool _drIsHighVol = not na(drVolCodeAdj) and drVolCodeAdj == 1
        drHighVolBandOk := not _drIsHighVol or _allowHighVol
    [drDirTextOut, drVolTextOut, drHighVolBandOk]

[drDirTextOut, drVolTextOut, drHighVolBandOk] = f_calcDailyRegime()

// 日足レジームを売買条件へ接続するモードか (前日確定 or 当日進行中)。
//   「当日確定後分析」は表示専用でエントリー制限には接続しない (元ストラテジー仕様)。
bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"

// ============================================================
//  5. ボラ判定 (計算) — 添付ストラテジーと同一
// ============================================================
f_calcVolatility() =>
    bool baseVolOk = true
    if volMode == "ATR"
        // ATR取得 (ATRフィルターのみ。他計算には影響しない):
        //   ・atrTf == ""            → チャート足の ta.atr(atrLenBase) (従来どおり・遅れなし)
        //   ・atrTf がチャート足より上位 → 直前に確定した上位足ATR ([1] + lookahead_on で
        //                                未来参照なし・非リペイント)
        //   ・atrTf がチャート足と同じ  → チャート足でそのまま計算 (不要な1本遅れを出さない)
        //   ・atrTf がチャート足より下位 → 上位足用の [1]+lookahead_on は使わず lookahead_off で取得
        //   大小判定は timeframe.in_seconds() で行う。
        float baseAtr = na
        if atrTf == ""
            baseAtr := ta.atr(atrLenBase)
        else
            int _atrTfSec   = timeframe.in_seconds(atrTf)
            int _chartTfSec = timeframe.in_seconds()
            if _atrTfSec > _chartTfSec
                baseAtr := request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_on)
            else if _atrTfSec == _chartTfSec
                baseAtr := ta.atr(atrLenBase)
            else
                baseAtr := request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase), lookahead = barmerge.lookahead_off)
        float atrAvg  = ta.sma(baseAtr, volAvgLen)
        bool volAbsOk = baseAtr >= minAtrDollar
        bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
        baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
    else if volMode == "固定値"
        baseVolOk := (high - low) >= fixedMin

    bool fastVolPass = true
    if fastVolMode == "ATR"
        float fastAtr = ta.atr(fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
        float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
        bool fastAtrOk    = fastAtr >= fastAtrMin
        bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
        bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
        fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
    else if fastVolMode == "固定値"
        float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        bool fastRangeOk = fastRange >= fastFixedMin
        bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
        fastVolPass := fastRangeOk and bodyAvgOk

    bool volPassRaw = baseVolOk and fastVolPass
    bool volLowNow  = not volPassRaw
    var int volRecoveryStartBar = na
    if volLowNow
        volRecoveryStartBar := na
    if not volLowNow and nz(volLowNow[1], false)
        volRecoveryStartBar := bar_index
    bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars
    volPassRaw and volRecoveryOk

bool volOk = f_calcVolatility()

// ============================================================
//  6. 時間帯・指標除外 (計算)
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================
//  7. WinZoneモジュール
// ------------------------------------------------------------
//  logic01 は WinZone 非使用 (longWinZoneOk / shortWinZoneOk 常時true)。
//  logic02/logic03 は水平線WinZoneを使用 → 下の共通水平線モジュールが
//  パターン別×方向別 (lineBounceLong/Short, lineFlipLong/Short, lineBreakLong/Short,
//  lineSweepLong/Short) と lineNoTradeLong / lineNoTradeShort を出力する。
//    logic02 = 反発のみ / logic03 = ショート全パターン を各ロジックが選択して接続する
//    (logic01 の longWinZoneOk には一切影響しない)。
// ============================================================
bool longWinZoneOk  = true
bool shortWinZoneOk = true

// ------------------------------------------------------------
//  7a. 共通 水平線 WinZone モジュール (添付ストラテジー 5b-2f を変更せず移植)
// ------------------------------------------------------------
//  Pivot / 複数回反応 / 前日H・L / セッションH・L を統合ゾーン化し、
//  反発 / レジサポ転換 / ブレイク / スイープ反転 を場所条件(Zone)として使う。
//  logic02 は「複数回反応価格帯の反発」のみを有効化した設定で使用する。
//  ・useLineWZ=false の時は全処理を走らせない。
// ============================================================
bool useLineWZ = useLineModule

// --- 統合水平線ゾーン配列 (var: 状態保持。操作は if useLineWZ 内のみ) ---
var array<float> zPrice   = array.new_float()
var array<int>   zTouch   = array.new_int()
var array<int>   zCreated = array.new_int()
var array<int>   zLast    = array.new_int()
var array<bool>  zPivot   = array.new_bool()
var array<bool>  zPrev    = array.new_bool()
var array<bool>  zSess    = array.new_bool()
var array<int>   zTF      = array.new_int()
var array<bool>  zBreakUsed  = array.new_bool()
var array<int>   zSessionDay = array.new_int()
var array<int>   zId         = array.new_int()
var array<int>   zIdCounter  = array.new_int(1, 0)
var int          sessDayCounter = 0
var array<int>   pendingUpZoneIds    = array.new_int()
var array<float> pendingUpThresholds = array.new_float()
var array<int>   pendingUpCounts     = array.new_int()
var array<int>   pendingDnZoneIds    = array.new_int()
var array<float> pendingDnThresholds = array.new_float()
var array<int>   pendingDnCounts     = array.new_int()

// 共通フィルター (ローソク品質)
f_lineCommonOK(bool isBuy, float _atr) =>
    float _rng  = high - low
    float _body = math.abs(close - open)
    float _upW  = high - math.max(close, open)
    float _dnW  = math.min(close, open) - low
    float _bRatio = _rng > 0 ? _body / _rng : 0.0
    bool _ok = true
    if useLineDirCandleFilter
        _ok := _ok and (isBuy ? close > open : close < open)
    if useLineWickFilter
        _ok := _ok and (isBuy ? _dnW >= _body : _upW >= _body)
    if useLineBodyFilter
        _ok := _ok and _bRatio >= lineBodyRatioMin
    if useLineATRFilter
        _ok := _ok and _rng >= _atr * lineAtrMinMult
    _ok

// ゾーンへ追加/統合
f_lineAddZone(float p, bool srcPivot, bool srcPrev, bool srcSess, int _tfCode, float _mergeTol, int _sessDay) =>
    bool _found = false
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not _found and math.abs(array.get(zPrice, i) - p) <= _mergeTol
                int _oldT = array.get(zTouch, i)
                int _newT = _oldT + 1
                array.set(zPrice, i, (array.get(zPrice, i) * _oldT + p) / _newT)
                array.set(zTouch, i, _newT)
                array.set(zLast,  i, bar_index)
                array.set(zPivot, i, array.get(zPivot, i) or srcPivot)
                array.set(zPrev,  i, array.get(zPrev,  i) or srcPrev)
                array.set(zSess,  i, array.get(zSess,  i) or srcSess)
                array.set(zTF,    i, math.max(array.get(zTF, i), _tfCode))
                array.set(zSessionDay, i, math.max(array.get(zSessionDay, i), _sessDay))
                _found := true
    if not _found
        array.push(zPrice, p)
        array.push(zTouch, 1)
        array.push(zCreated, bar_index)
        array.push(zLast, bar_index)
        array.push(zPivot, srcPivot)
        array.push(zPrev,  srcPrev)
        array.push(zSess,  srcSess)
        array.push(zTF,    _tfCode)
        array.push(zBreakUsed,  false)
        array.push(zSessionDay, _sessDay)
        int _newId = array.get(zIdCounter, 0) + 1
        array.set(zIdCounter, 0, _newId)
        array.push(zId, _newId)
        if array.size(zPrice) > lineMaxZones
            array.shift(zPrice)
            array.shift(zTouch)
            array.shift(zCreated)
            array.shift(zLast)
            array.shift(zPivot)
            array.shift(zPrev)
            array.shift(zSess)
            array.shift(zTF)
            array.shift(zBreakUsed)
            array.shift(zSessionDay)
            array.shift(zId)

// MTF Pivot 取得 → ゾーン追加 (ONのTFだけ request.security を呼ぶ)
f_lineAddTFPivots(bool _tfOn, string _tf, int _tfCode, float _mergeTol, int _sessDay) =>
    if _tfOn
        [_ph, _pl] = request.security(syminfo.tickerid, _tf, [ta.pivothigh(linePivotLen, linePivotLen), ta.pivotlow(linePivotLen, linePivotLen)], lookahead = barmerge.lookahead_off)
        if not na(_ph) and (na(_ph[1]) or _ph != _ph[1])
            f_lineAddZone(_ph, true, false, false, _tfCode, _mergeTol, _sessDay)
        if not na(_pl) and (na(_pl[1]) or _pl != _pl[1])
            f_lineAddZone(_pl, true, false, false, _tfCode, _mergeTol, _sessDay)

f_lineSourceOn(bool _ip, bool _ipr, bool _iss) =>
    (_ip and (usePivotLine or useReactionLine)) or (_ipr and usePreviousDayHL) or (_iss and useSessionHL)

f_findZoneIndexById(int _id) =>
    int _idx = na
    if array.size(zId) > 0
        for i = 0 to array.size(zId) - 1
            if array.get(zId, i) == _id
                _idx := i
                break
    _idx

f_idInArray(array<int> _arr, int _id) =>
    bool _f = false
    if array.size(_arr) > 0
        for i = 0 to array.size(_arr) - 1
            if array.get(_arr, i) == _id
                _f := true
                break
    _f

f_lineBreakValidIdx(int _id) =>
    int _idx = f_findZoneIndexById(_id)
    int _res = na
    if not na(_idx)
        bool _iss = array.get(zSess, _idx)
        bool _ipv = array.get(zPivot, _idx)
        bool _ipr = array.get(zPrev, _idx)
        bool _pureSess = _iss and not _ipv and not _ipr
        bool _sessOK = not _pureSess or (array.get(zSessionDay, _idx) >= sessDayCounter - (lineSessionMaxDays - 1))
        if not array.get(zBreakUsed, _idx) and f_lineSourceOn(_ipv, _ipr, _iss) and _sessOK
            _res := _idx
    _res

f_clearPendingUp() =>
    if array.size(pendingUpZoneIds) > 0
        array.clear(pendingUpZoneIds)
        array.clear(pendingUpThresholds)
        array.clear(pendingUpCounts)
f_clearPendingDn() =>
    if array.size(pendingDnZoneIds) > 0
        array.clear(pendingDnZoneIds)
        array.clear(pendingDnThresholds)
        array.clear(pendingDnCounts)

f_lineSession(string sessStr, float prevHi, float prevLo) =>
    bool _inSess  = not na(time(timeframe.period, sessStr, lineSessTZ))
    bool _started = _inSess and not _inSess[1]
    bool _ended   = not _inSess and _inSess[1]
    float _hi = prevHi
    float _lo = prevLo
    if _started
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(prevHi) ? high : math.max(prevHi, high)
        _lo := na(prevLo) ? low  : math.min(prevLo, low)
    [_hi, _lo, _ended]

// --- 水平線 出力 (if外で初期化) ---
bool  lineRawLong        = false
bool  lineRawShort       = false
// パターン別・方向別 生イベント (このバーで各パターンが成立したか)。
//   各ロジックが必要なパターンだけを選択できるよう個別に出力する。
bool lineBounceLongRaw = false
bool lineBounceShortRaw = false
bool lineFlipLongRaw   = false
bool lineFlipShortRaw  = false
bool lineBreakLongRaw  = false
bool lineBreakShortRaw = false
bool lineSweepLongRaw  = false
bool lineSweepShortRaw = false
// logic08 専用 生スイープ (最小貫通 ATR×0.3。共通 lineSweepToleranceATR=0.5 とは別判定)
bool logic08SweepLongRaw  = false
bool logic08SweepShortRaw = false
float nearestSupport     = na
float nearestResistance  = na
bool  lineNoTradeLong    = false
bool  lineNoTradeShort   = false
bool  lineNoTrade        = false

var float curDayHigh = na
var float curDayLow  = na
var float prevHigh   = na
var float prevLow    = na
var float asiaHigh   = na
var float asiaLow    = na
var float londonHigh = na
var float londonLow  = na
var float nyHigh     = na
var float nyLow      = na
var float flipResLevel = na
var int   flipResBar   = na
var float flipSupLevel = na
var int   flipSupBar   = na

if useLineWZ
    float lineAtr = ta.atr(lineAtrLen)
    float lineZoneW = useLineATRZone ? lineAtr * lineZoneATRMult : lineZoneFixedWidth
    float _mergeTol = useLineMergeZone ? lineAtr * lineMergeToleranceATR : lineAtr * reactionToleranceATR
    int _dayId = year(time, lineSessTZ) * 10000 + month(time, lineSessTZ) * 100 + dayofmonth(time, lineSessTZ)
    if not na(_dayId[1]) and _dayId != _dayId[1]
        sessDayCounter := sessDayCounter + 1
    if usePivotLine or useReactionLine
        f_lineAddTFPivots(useLine1M,  tfLine1M,  1,   _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine5M,  tfLine5M,  5,   _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine15M, tfLine15M, 15,  _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine1H,  tfLine1H,  60,  _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine4H,  tfLine4H,  240, _mergeTol, sessDayCounter)
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        prevHigh := curDayHigh
        prevLow  := curDayLow
        curDayHigh := high
        curDayLow  := low
        if usePreviousDayHL and not na(prevHigh)
            f_lineAddZone(prevHigh, false, true, false, 0, _mergeTol, sessDayCounter)
        if usePreviousDayHL and not na(prevLow)
            f_lineAddZone(prevLow, false, true, false, 0, _mergeTol, sessDayCounter)
    else
        curDayHigh := na(curDayHigh) ? high : math.max(curDayHigh, high)
        curDayLow  := na(curDayLow)  ? low  : math.min(curDayLow, low)
    [_aH, _aL, _aEnd] = f_lineSession(lineAsiaSess, asiaHigh, asiaLow)
    asiaHigh := _aH
    asiaLow  := _aL
    [_lH, _lL, _lEnd] = f_lineSession(lineLondonSess, londonHigh, londonLow)
    londonHigh := _lH
    londonLow  := _lL
    [_nH, _nL, _nEnd] = f_lineSession(lineNySess, nyHigh, nyLow)
    nyHigh := _nH
    nyLow  := _nL
    if useSessionHL
        if _aEnd and not na(asiaHigh)
            f_lineAddZone(asiaHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _aEnd and not na(asiaLow)
            f_lineAddZone(asiaLow, false, false, true, 0, _mergeTol, sessDayCounter)
        if _lEnd and not na(londonHigh)
            f_lineAddZone(londonHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _lEnd and not na(londonLow)
            f_lineAddZone(londonLow, false, false, true, 0, _mergeTol, sessDayCounter)
        if _nEnd and not na(nyHigh)
            f_lineAddZone(nyHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _nEnd and not na(nyLow)
            f_lineAddZone(nyLow, false, false, true, 0, _mergeTol, sessDayCounter)
    if array.size(zPrice) > 0
        for i = array.size(zPrice) - 1 to 0
            bool _pureSess = array.get(zSess, i) and not array.get(zPivot, i) and not array.get(zPrev, i)
            if _pureSess and array.get(zSessionDay, i) < sessDayCounter - (lineSessionMaxDays - 1)
                array.remove(zPrice, i)
                array.remove(zTouch, i)
                array.remove(zCreated, i)
                array.remove(zLast, i)
                array.remove(zPivot, i)
                array.remove(zPrev, i)
                array.remove(zSess, i)
                array.remove(zTF, i)
                array.remove(zBreakUsed, i)
                array.remove(zSessionDay, i)
                array.remove(zId, i)
    int  _nsCreated = na
    int  _nrCreated = na
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if bar_index >= array.get(zCreated, i)
                float _pr = array.get(zPrice, i)
                if _pr <= close
                    if na(nearestSupport) or _pr > nearestSupport
                        nearestSupport := _pr
                        _nsCreated := array.get(zCreated, i)
                if _pr >= close
                    if na(nearestResistance) or _pr < nearestResistance
                        nearestResistance := _pr
                        _nrCreated := array.get(zCreated, i)
    float _supZoneTop = nearestSupport + lineZoneW
    float _resZoneBot = nearestResistance - lineZoneW
    bool _supUsable = not na(nearestSupport)    and not na(_nsCreated) and bar_index >= _nsCreated
    bool _resUsable = not na(nearestResistance) and not na(_nrCreated) and bar_index >= _nrCreated
    // A: 反発
    bool _buyBounce  = useLineBounce and _supUsable and low  <= _supZoneTop and close > nearestSupport    and f_lineCommonOK(true, lineAtr)
    bool _sellBounce = useLineBounce and _resUsable and high >= _resZoneBot and close < nearestResistance and f_lineCommonOK(false, lineAtr)
    // B: レジサポ転換 (Flip)
    if _resUsable and not na(nearestResistance[1]) and close > nearestResistance[1] and close[1] <= nearestResistance[1]
        flipResLevel := nearestResistance[1]
        flipResBar   := bar_index
    if _supUsable and not na(nearestSupport[1]) and close < nearestSupport[1] and close[1] >= nearestSupport[1]
        flipSupLevel := nearestSupport[1]
        flipSupBar   := bar_index
    bool _buyFlip  = useLineFlip and not na(flipResLevel) and (bar_index - flipResBar) >= lineFlipConfirmBars and (bar_index - flipResBar) <= lineFlipLookback and low <= flipResLevel + lineZoneW and close > flipResLevel and f_lineCommonOK(true, lineAtr)
    bool _sellFlip = useLineFlip and not na(flipSupLevel) and (bar_index - flipSupBar) >= lineFlipConfirmBars and (bar_index - flipSupBar) <= lineFlipLookback and high >= flipSupLevel - lineZoneW and close < flipSupLevel and f_lineCommonOK(false, lineAtr)
    if _buyFlip
        flipResLevel := na
    if _sellFlip
        flipSupLevel := na
    // C: ブレイク (固有ID管理版)
    bool _breakBodyOK = not useLineBreakBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= lineBreakBodyRatio)
    float _brkBuf = lineBreakBufferMode == "Dollar" ? lineBreakBufferDollar : lineBreakBufferMode == "ATR" ? lineAtr * lineBreakBufferATR : 0.0
    int _confN = lineBreakConfirmMode == "CloseOnly" ? 1 : lineBreakConfirmMode == "NextBar" ? 2 : lineBreakConfirmBars
    bool _buyBreak  = false
    bool _sellBreak = false
    if useLineBreak and array.size(pendingUpZoneIds) > 0
        for k = array.size(pendingUpZoneIds) - 1 to 0
            int   _pid = array.get(pendingUpZoneIds, k)
            float _thr = array.get(pendingUpThresholds, k)
            int   _cnt = array.get(pendingUpCounts, k)
            int   _vidx = f_lineBreakValidIdx(_pid)
            if na(_vidx)
                array.remove(pendingUpZoneIds, k)
                array.remove(pendingUpThresholds, k)
                array.remove(pendingUpCounts, k)
            else if close > _thr
                int _newCnt = _cnt + 1
                if _newCnt >= _confN
                    array.set(zBreakUsed, _vidx, true)
                    _buyBreak := true
                    array.remove(pendingUpZoneIds, k)
                    array.remove(pendingUpThresholds, k)
                    array.remove(pendingUpCounts, k)
                else
                    array.set(pendingUpCounts, k, _newCnt)
            else
                array.remove(pendingUpZoneIds, k)
                array.remove(pendingUpThresholds, k)
                array.remove(pendingUpCounts, k)
    if useLineBreak and array.size(pendingDnZoneIds) > 0
        for k = array.size(pendingDnZoneIds) - 1 to 0
            int   _pid = array.get(pendingDnZoneIds, k)
            float _thr = array.get(pendingDnThresholds, k)
            int   _cnt = array.get(pendingDnCounts, k)
            int   _vidx = f_lineBreakValidIdx(_pid)
            if na(_vidx)
                array.remove(pendingDnZoneIds, k)
                array.remove(pendingDnThresholds, k)
                array.remove(pendingDnCounts, k)
            else if close < _thr
                int _newCnt = _cnt + 1
                if _newCnt >= _confN
                    array.set(zBreakUsed, _vidx, true)
                    _sellBreak := true
                    array.remove(pendingDnZoneIds, k)
                    array.remove(pendingDnThresholds, k)
                    array.remove(pendingDnCounts, k)
                else
                    array.set(pendingDnCounts, k, _newCnt)
            else
                array.remove(pendingDnZoneIds, k)
                array.remove(pendingDnThresholds, k)
                array.remove(pendingDnCounts, k)
    if useLineBreak and _breakBodyOK and array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not array.get(zBreakUsed, i) and bar_index >= array.get(zCreated, i)
                bool _ipv = array.get(zPivot, i)
                bool _ipr = array.get(zPrev, i)
                bool _iss = array.get(zSess, i)
                bool _pureSess = _iss and not _ipv and not _ipr
                bool _sessOK = not _pureSess or (array.get(zSessionDay, i) >= sessDayCounter - (lineSessionMaxDays - 1))
                if f_lineSourceOn(_ipv, _ipr, _iss) and _sessOK
                    int   _zid   = array.get(zId, i)
                    float _zp    = array.get(zPrice, i)
                    float _thrUp = _zp + lineZoneW + _brkBuf
                    float _thrDn = _zp - lineZoneW - _brkBuf
                    if close[1] <= _thrUp and close > _thrUp and not f_idInArray(pendingUpZoneIds, _zid)
                        if _confN <= 1
                            array.set(zBreakUsed, i, true)
                            _buyBreak := true
                        else
                            array.push(pendingUpZoneIds, _zid)
                            array.push(pendingUpThresholds, _thrUp)
                            array.push(pendingUpCounts, 1)
                    if close[1] >= _thrDn and close < _thrDn and not f_idInArray(pendingDnZoneIds, _zid)
                        if _confN <= 1
                            array.set(zBreakUsed, i, true)
                            _sellBreak := true
                        else
                            array.push(pendingDnZoneIds, _zid)
                            array.push(pendingDnThresholds, _thrDn)
                            array.push(pendingDnCounts, 1)
    // D: スイープ反転
    float _sweepTol = lineAtr * lineSweepToleranceATR
    bool _buySweep  = useLineSweep and _supUsable and (nearestSupport - low)     >= _sweepTol and close > nearestSupport    and f_lineCommonOK(true, lineAtr)
    bool _sellSweep = useLineSweep and _resUsable and (high - nearestResistance) >= _sweepTol and close < nearestResistance and f_lineCommonOK(false, lineAtr)
    // 統合 (参考: 優先 Sweep > Break > Flip > Bounce)。各ロジックはパターン別出力から選択する。
    lineRawLong  := _buyBounce or _buyFlip or _buyBreak or _buySweep
    lineRawShort := _sellBounce or _sellFlip or _sellBreak or _sellSweep
    // パターン別・方向別 生イベントを個別出力 (各ロジックが必要なパターンだけ選択できるように)
    lineBounceLongRaw  := _buyBounce
    lineBounceShortRaw := _sellBounce
    lineFlipLongRaw    := _buyFlip
    lineFlipShortRaw   := _sellFlip
    lineBreakLongRaw   := _buyBreak
    lineBreakShortRaw  := _sellBreak
    lineSweepLongRaw   := _buySweep
    lineSweepShortRaw  := _sellSweep
    // logic08 専用 スイープ (最小貫通 ATR×0.3)。共通 lineSweepToleranceATR=0.5 は変更せず、
    //   既存の lineAtr / nearestSupport / nearestResistance / _supUsable / _resUsable /
    //   f_lineCommonOK をそのまま再利用 (水平線ゾーン検出・ta.atr の重複追加なし)。
    float _sweepTol08 = lineAtr * 0.3
    logic08SweepLongRaw  := useLineSweep and _supUsable and (nearestSupport - low)     >= _sweepTol08 and close > nearestSupport    and f_lineCommonOK(true, lineAtr)
    logic08SweepShortRaw := useLineSweep and _resUsable and (high - nearestResistance) >= _sweepTol08 and close < nearestResistance and f_lineCommonOK(false, lineAtr)
    // E: 障害物 (近すぎるレジサポで NoTrade)
    bool _obsAbove = not na(nearestResistance) and (nearestResistance - close) <= lineAtr * lineObstacleATR
    bool _obsBelow = not na(nearestSupport)    and (close - nearestSupport)    <= lineAtr * lineObstacleATR
    lineNoTradeLong  := useLineObstacleFilter and _obsAbove
    lineNoTradeShort := useLineObstacleFilter and _obsBelow
    lineNoTrade      := lineNoTradeLong or lineNoTradeShort

// Break OFF / モジュールOFF 時は方向別 pending を完全クリア
if not (useLineWZ and useLineBreak)
    f_clearPendingUp()
    f_clearPendingDn()

// --- 水平線 状態管理 (シグナル後 lineStateMaxBars 本だけ WinZone 維持・パターン別×方向別) ---
//   各パターン×方向に独立した状態バーを持たせ、個別に状態管理する。
//   ※ パターン別状態のORは「最後に成立した任意パターンから N本以内」と一致するため、
//     全パターンを使う logic03 は「統合生イベント→単一状態」と同結果になる (非対称なし)。
//   ※ logic02 は反発のみを使うため、従来の反発ベース状態と完全一致する。
var int lineBounceLongStateBar  = na
var int lineBounceShortStateBar = na
var int lineFlipLongStateBar    = na
var int lineFlipShortStateBar   = na
var int lineBreakLongStateBar   = na
var int lineBreakShortStateBar  = na
var int lineSweepLongStateBar   = na
var int lineSweepShortStateBar  = na
var int logic08SweepLongStateBar  = na
var int logic08SweepShortStateBar = na
if useLineWZ and useLineStateWindow
    lineBounceLongStateBar  := lineBounceLongRaw  ? bar_index : lineBounceLongStateBar
    lineBounceShortStateBar := lineBounceShortRaw ? bar_index : lineBounceShortStateBar
    lineFlipLongStateBar    := lineFlipLongRaw    ? bar_index : lineFlipLongStateBar
    lineFlipShortStateBar   := lineFlipShortRaw   ? bar_index : lineFlipShortStateBar
    lineBreakLongStateBar   := lineBreakLongRaw   ? bar_index : lineBreakLongStateBar
    lineBreakShortStateBar  := lineBreakShortRaw  ? bar_index : lineBreakShortStateBar
    lineSweepLongStateBar   := lineSweepLongRaw   ? bar_index : lineSweepLongStateBar
    lineSweepShortStateBar  := lineSweepShortRaw  ? bar_index : lineSweepShortStateBar
    logic08SweepLongStateBar  := logic08SweepLongRaw  ? bar_index : logic08SweepLongStateBar
    logic08SweepShortStateBar := logic08SweepShortRaw ? bar_index : logic08SweepShortStateBar

// パターン別・方向別 WinZone 出力 (状態管理ON=状態フラグ / OFF=生イベント / 未使用=false)
f_lineStateOut(int _bar, bool _raw) =>
     useLineStateWindow ? (not na(_bar) and (bar_index - _bar) <= lineStateMaxBars) : _raw
bool lineBounceLong  = useLineWZ ? f_lineStateOut(lineBounceLongStateBar,  lineBounceLongRaw)  : false
bool lineBounceShort = useLineWZ ? f_lineStateOut(lineBounceShortStateBar, lineBounceShortRaw) : false
bool lineFlipLong    = useLineWZ ? f_lineStateOut(lineFlipLongStateBar,    lineFlipLongRaw)    : false
bool lineFlipShort   = useLineWZ ? f_lineStateOut(lineFlipShortStateBar,   lineFlipShortRaw)   : false
bool lineBreakLong   = useLineWZ ? f_lineStateOut(lineBreakLongStateBar,   lineBreakLongRaw)   : false
bool lineBreakShort  = useLineWZ ? f_lineStateOut(lineBreakShortStateBar,  lineBreakShortRaw)  : false
bool lineSweepLong   = useLineWZ ? f_lineStateOut(lineSweepLongStateBar,   lineSweepLongRaw)   : false
bool lineSweepShort  = useLineWZ ? f_lineStateOut(lineSweepShortStateBar,  lineSweepShortRaw)  : false
// logic08 専用 スイープ WinZone (ATR×0.3・状態3本)。既存 lineSweepLong/Short (ATR×0.5) には触れない。
bool logic08SweepLong  = useLineWZ ? f_lineStateOut(logic08SweepLongStateBar,  logic08SweepLongRaw)  : false
bool logic08SweepShort = useLineWZ ? f_lineStateOut(logic08SweepShortStateBar, logic08SweepShortRaw) : false

// ------------------------------------------------------------
//  7b. 共通 フィボ WinZone モジュール (添付ストラテジー 5b-2b を変更せず移植)
// ------------------------------------------------------------
//  トレンド波の戻り/押しを A/B/C ランク帯のフィボで捉える場所条件。
//  出力: shortFibZoneOk / longFibZoneOk。logic03 は shortFibZoneOk のみ使用。
//  ・useFibWZ=false の時は ta.pivot/atr/ema・波計算・ランク・反転確認を一切走らせない。
//  ・フィボ内部ランク(A/B/C帯)は 統合シグナルのランクとは別物 (logic03は常にBランク)。
// ============================================================
bool useFibWZ = useFibModule

// ランク判定関数 (pure)
f_fibRank(float pct, float bufPct) =>
    int r = 0
    if not na(pct)
        if useRankA and pct >= fibAStart - bufPct and pct <= fibAEnd + bufPct
            r := 3
        else if useRankB and pct >= fibBStart - bufPct and pct < fibBEnd + bufPct
            r := 2
        else if useRankC and pct >= fibCStart - bufPct and pct < fibCEnd + bufPct
            r := 1
    r

// 出力 (if外で初期化)
bool fibBuySignal  = false
bool fibSellSignal = false
bool fibInvalidBuy  = false
bool fibInvalidSell = false

if useFibWZ
    float _atr   = ta.atr(fibAtrLen)
    float _ema20 = ta.ema(close, fibEma20Len)
    float _ph = ta.pivothigh(high, swingLookback, swingLookback)
    float _pl = ta.pivotlow(low,  swingLookback, swingLookback)
    var float lastPH    = na
    var int   lastPHbar = na
    var float lastPL    = na
    var int   lastPLbar = na
    if not na(_ph)
        lastPH := _ph
        lastPHbar := bar_index - swingLookback
    if not na(_pl)
        lastPL := _pl
        lastPLbar := bar_index - swingLookback
    bool bothPivots = not na(lastPH) and not na(lastPL)
    // 下降波(高→安=SELL用) / 上昇波(安→高=BUY用)
    bool downWaveValid = bothPivots and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)
    bool upWaveValid   = bothPivots and (lastPLbar < lastPHbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPLbar) <= waveLookback)
    float sSwingHigh = lastPH
    float sSwingLow  = lastPL
    float sRange = sSwingHigh - sSwingLow
    float bSwingHigh = lastPH
    float bSwingLow  = lastPL
    float bRange = bSwingHigh - bSwingLow
    float buf = _atr * fibZoneBufferATR
    float sBufPct = sRange > 0 ? buf / sRange : 0.0
    float bBufPct = bRange > 0 ? buf / bRange : 0.0
    float sRetracePct = downWaveValid and sRange > 0 ? math.max(0.0, math.min(1.0, (high - sSwingLow) / sRange)) : na
    float bRetracePct = upWaveValid and bRange > 0 ? math.max(0.0, math.min(1.0, (bSwingHigh - low) / bRange)) : na
    int sRank = f_fibRank(sRetracePct, sBufPct)
    int bRank = f_fibRank(bRetracePct, bBufPct)
    float sZoneLowPrice  = sSwingLow + fibCStart * sRange
    float sZoneHighPrice = sSwingLow + fibAEnd   * sRange
    float sDeepLimit     = sSwingLow + fibAEnd   * sRange
    float bZoneHighPrice = bSwingHigh - fibCStart * bRange
    float bZoneLowPrice  = bSwingHigh - fibAEnd   * bRange
    float bDeepLimit     = bSwingHigh - fibAEnd   * bRange
    bool priceInSellZone = downWaveValid and sRank > 0 and (high >= sZoneLowPrice - buf) and (low <= sZoneHighPrice + buf)
    bool priceInBuyZone  = upWaveValid   and bRank > 0 and (low <= bZoneHighPrice + buf) and (high >= bZoneLowPrice - buf)
    // 反転確認
    float _body     = math.abs(close - open)
    float _bodyPrev = math.abs(close[1] - open[1])
    float _upWick   = high - math.max(close, open)
    float _loWick   = math.min(close, open) - low
    bool _bearCandle   = close < open
    bool _upPinbar     = _body > 0 and _upWick >= pinbarWickRatio * _body and _upWick > _loWick
    bool _fibBearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1] and _body >= engulfingBodyRatio * _bodyPrev
    bool _breakPrevLow = low < low[1]
    bool sellConfirm = (useCandleConfirm and _bearCandle) or (usePinbarConfirm and _upPinbar) or (useEngulfingConfirm and _fibBearEngulf) or (useEma20Confirm and close < _ema20) or (useBreakPrevConfirm and _breakPrevLow)
    bool _bullCandle   = close > open
    bool _dnPinbar     = _body > 0 and _loWick >= pinbarWickRatio * _body and _loWick > _upWick
    bool _fibBullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1] and _body >= engulfingBodyRatio * _bodyPrev
    bool _breakPrevHigh = high > high[1]
    bool buyConfirm = (useCandleConfirm and _bullCandle) or (usePinbarConfirm and _dnPinbar) or (useEngulfingConfirm and _fibBullEngulf) or (useEma20Confirm and close > _ema20) or (useBreakPrevConfirm and _breakPrevHigh)
    // 無効条件
    bool invSell = downWaveValid and ((useDeepLimitInvalid and close > sDeepLimit) or (useOriginInvalid and close > sSwingHigh) or (useEMASettleInvalid and close > _ema20 and close[1] > _ema20))
    bool invBuy  = upWaveValid   and ((useDeepLimitInvalid and close < bDeepLimit) or (useOriginInvalid and close < bSwingLow)  or (useEMASettleInvalid and close < _ema20 and close[1] < _ema20))
    fibInvalidSell := invSell
    fibInvalidBuy  := invBuy
    bool confirmedOK = not requireConfirmedBar or barstate.isconfirmed
    bool sellSetup = useFibSell and priceInSellZone and not invSell
    bool buySetup  = useFibBuy  and priceInBuyZone  and not invBuy
    bool _fibSellSig = sellSetup and (not useRejectConfirm or sellConfirm) and confirmedOK
    bool _fibBuySig  = buySetup  and (not useRejectConfirm or buyConfirm)  and confirmedOK
    fibSellSignal := _fibSellSig
    fibBuySignal  := _fibBuySig

bool longFibOk  = fibBuySignal
bool shortFibOk = fibSellSignal

// --- フィボ 状態管理 (イベント後 一定本数保持・無効条件で即リセット) ---
var bool longFibStateOk   = false
var bool shortFibStateOk  = false
var int  longFibStateBar  = na
var int  shortFibStateBar = na
if useFibWZ and useFibStateWindow
    if fibBuySignal
        longFibStateOk   := true
        longFibStateBar  := bar_index
    if fibSellSignal
        shortFibStateOk   := true
        shortFibStateBar  := bar_index
    if longFibStateOk and not na(longFibStateBar) and bar_index - longFibStateBar > fibStateMaxBars
        longFibStateOk := false
    if shortFibStateOk and not na(shortFibStateBar) and bar_index - shortFibStateBar > fibStateMaxBars
        shortFibStateOk := false
    if fibInvalidBuy
        longFibStateOk  := false
        longFibStateBar := na
    if fibInvalidSell
        shortFibStateOk  := false
        shortFibStateBar := na

// フィボ 場所条件 (状態管理ON=状態フラグ / OFF=シグナル単バー / 未使用=false)
bool longFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? longFibStateOk : fibBuySignal
bool shortFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? shortFibStateOk : fibSellSignal

// ============================================================
//  7c. 出来高ブレイク WinZone モジュール (計算) — logic04 が使用
//      ・元コード「出来高ブレイク版」の最終接続コアのみを移植:
//        直近高値/安値ブレイク ∧ 出来高スパイク ∧ 実体比下限
//      ・ATR拡大/圧縮/低ボラ/SMA/共通実体などのフィルタは元コードで全OFF (非接続)
//      ・トレンドフィルタはブレイクに接続しない
//      ・出力は logic04VolumeLong / logic04VolumeShort のみ (他モジュールと AND/OR しない)
// ------------------------------------------------------------
float _brkRHigh = ta.highest(high, breakoutLookback)[1]
float _brkRLow  = ta.lowest(low, breakoutLookback)[1]
float _brkVolSma = ta.sma(volume, volumeSmaLen)
float _brkBody   = math.abs(close - open)
float _brkRange  = high - low
float _brkBodyRatio = _brkRange > 0 ? _brkBody / _brkRange : 0.0

bool brkBuyCore =
     not na(_brkRHigh) and close > _brkRHigh
     and volume > _brkVolSma * volumeSpikeMult
     and _brkBodyRatio >= breakoutBodyRatioMin
bool brkSellCore =
     not na(_brkRLow) and close < _brkRLow
     and volume > _brkVolSma * volumeSpikeMult
     and _brkBodyRatio >= breakoutBodyRatioMin

// 初回シグナルのみ有効 (元コード useFirstSignalOnly)
bool volumeBreakoutLongRaw  = brkBuyCore  and (not useFirstSignalOnly or not brkBuyCore[1])
bool volumeBreakoutShortRaw = brkSellCore and (not useFirstSignalOnly or not brkSellCore[1])

// 出来高ブレイク 状態管理 (イベント後 一定本数保持)
var bool logic04VolumeLongStateOk  = false
var bool logic04VolumeShortStateOk = false
var int  logic04VolumeLongStateBar  = na
var int  logic04VolumeShortStateBar = na
if useVolumeStateWindow
    if volumeBreakoutLongRaw
        logic04VolumeLongStateOk  := true
        logic04VolumeLongStateBar := bar_index
    if volumeBreakoutShortRaw
        logic04VolumeShortStateOk  := true
        logic04VolumeShortStateBar := bar_index
    if logic04VolumeLongStateOk and not na(logic04VolumeLongStateBar) and bar_index - logic04VolumeLongStateBar > volumeStateMaxBars
        logic04VolumeLongStateOk := false
    if logic04VolumeShortStateOk and not na(logic04VolumeShortStateBar) and bar_index - logic04VolumeShortStateBar > volumeStateMaxBars
        logic04VolumeShortStateOk := false

bool logic04VolumeLong  = useVolumeStateWindow ? logic04VolumeLongStateOk  : volumeBreakoutLongRaw
bool logic04VolumeShort = useVolumeStateWindow ? logic04VolumeShortStateOk : volumeBreakoutShortRaw

// ============================================================
//  7d. 共通 FVG WinZone モジュール (添付ストラテジー 5b を変更せず移植) — logic09 が使用
// ------------------------------------------------------------
//  USレンジ式 FVG (Accumulation → MSS → フェーズ収集 → 反発/吸収 → 状態管理)。
//  出力: longFVGOk / shortFVGOk。logic09 は longFVGOk (ロング側) のみ使用。
//  ・useFVGWZ=false の時は FVG検出・配列・ループ・ta系・判定を一切走らせない (軽量)。
//  ・新規 request.security なし (チャート足 ta.atr / ta.highest/lowest のみ)。
// ============================================================
bool useFVGWZ = useFVGModule
bool useFVG   = useFVGWZ

// Accum判定レンジ幅 (実体ベース)
f_fvgAccumRange() =>
    ta.highest(math.max(open, close), fvgAccumRangeLen) - ta.lowest(math.min(open, close), fvgAccumRangeLen)

// Accumulation 中核判定 (ATR幅・短期/基準幅比・上下終値バランス・ドリフト・同色連続の全AND)
f_fvgIsAccumCore() =>
    float _atr = ta.atr(fvgAccumAtrLen)
    float _bodyTop = math.max(open, close)
    float _bodyBot = math.min(open, close)
    float _rangeHigh = ta.highest(_bodyTop, fvgAccumRangeLen)
    float _rangeLow  = ta.lowest(_bodyBot, fvgAccumRangeLen)
    float _rangeNow  = _rangeHigh - _rangeLow
    float _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to fvgAccumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    float _startMid = (open[fvgAccumRangeLen - 1] + close[fvgAccumRangeLen - 1]) * 0.5
    float _endMid   = (open + close) * 0.5
    float _drift    = math.abs(_endMid - _startMid)
    bool _condAtr = _atr > 0 and _rangeNow <= _atr * fvgAccumAtrMult
    float _rangeShort = ta.highest(_bodyTop, fvgAccumRangeLen) - ta.lowest(_bodyBot, fvgAccumRangeLen)
    float _rangeBase  = ta.highest(_bodyTop, fvgAccumBaseLen)  - ta.lowest(_bodyBot, fvgAccumBaseLen)
    bool _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * fvgAccumBarRatioMax
    bool _condBalance  = _upperCloses >= fvgAccumMinUpperCloses and _lowerCloses >= fvgAccumMinLowerCloses
    bool _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= fvgAccumDriftMax
    bool _condColorRun = _maxBullRun <= fvgAccumMaxSameColorRun and _maxBearRun <= fvgAccumMaxSameColorRun
    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

// FVG間距離 (2ゾーンの空白。重なり/接触なら0)
f_fvgZoneGap(float _top1, float _bot1, float _top2, float _bot2) =>
    float _upperGap = _bot1 > _top2 ? (_bot1 - _top2) : 0.0
    float _lowerGap = _bot2 > _top1 ? (_bot2 - _top1) : 0.0
    math.max(_upperGap, _lowerGap)

// --- FVG 保存配列 (USレンジ式: Accum幅基準 + 当バー埋めフラグ。全配列を同一indexで並列管理) ---
var array<float> bullTopArr   = array.new_float()
var array<float> bullBotArr   = array.new_float()
var array<int>   bullBarArr   = array.new_int()
var array<float> bullRefArr   = array.new_float()
var array<bool>  bullRebUsed  = array.new_bool()
var array<bool>  bullAbsUsed  = array.new_bool()
var array<bool>  bullDeadArr  = array.new_bool()
var array<bool>  bullFilledArr = array.new_bool()

var array<float> bearTopArr   = array.new_float()
var array<float> bearBotArr   = array.new_float()
var array<int>   bearBarArr   = array.new_int()
var array<float> bearRefArr   = array.new_float()
var array<bool>  bearRebUsed  = array.new_bool()
var array<bool>  bearAbsUsed  = array.new_bool()
var array<bool>  bearDeadArr  = array.new_bool()
var array<bool>  bearFilledArr = array.new_bool()

// 逆側 (Bear) FVG が近接かつ十分厚い時だけ Bull反発をブロック (距離+厚みの両方)
f_fvgNearOppBearForBull(float _top, float _bot, float _ref) =>
    bool _blocked = false
    if useOppositeFVGFilter and array.size(bearTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bearTopArr) - 1
            if not array.get(bearDeadArr, j) and not array.get(bearRebUsed, j)
                float _otop = array.get(bearTopArr, j)
                float _obot = array.get(bearBotArr, j)
                float _ow = _otop - _obot
                float _gap = f_fvgZoneGap(_top, _bot, _otop, _obot)
                if (_gap / _ref) <= fvgOppositeNearGapMax and (_ow / _ref) >= fvgOppositeMinThickness
                    _blocked := true
    _blocked

f_fvgNearOppBullForBear(float _top, float _bot, float _ref) =>
    bool _blocked = false
    if useOppositeFVGFilter and array.size(bullTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bullTopArr) - 1
            if not array.get(bullDeadArr, j) and not array.get(bullRebUsed, j)
                float _otop = array.get(bullTopArr, j)
                float _obot = array.get(bullBotArr, j)
                float _ow = _otop - _obot
                float _gap = f_fvgZoneGap(_top, _bot, _otop, _obot)
                if (_gap / _ref) <= fvgOppositeNearGapMax and (_ow / _ref) >= fvgOppositeMinThickness
                    _blocked := true
    _blocked

// FVG シグナル (種類別。単バーイベント)
bool fvgReboundBuy  = false
bool fvgReboundSell = false
bool fvgAbsorbBuy   = false
bool fvgAbsorbSell  = false
bool ifvgBuy        = false
bool ifvgSell       = false
bool fvgResetStateNow = false

var int   fvgAbsorbBias    = 0
var bool  fvgIsAccumPrev   = false
var float fvgRunAccumHigh  = na
var float fvgRunAccumLow   = na
var float fvgLastAccumHigh = na
var float fvgLastAccumLow  = na
var float fvgLastAccumWidth= na
var float fvgPhaseAccumRef = na
var bool  fvgPhaseActive   = false
var bool  fvgUpBreakSeen   = false
var float fvgUpCumBody     = 0.0
var bool  fvgUpMssDone     = false
var int   fvgUpMssBar      = na
var bool  fvgDnBreakSeen   = false
var float fvgDnCumBody     = 0.0
var bool  fvgDnMssDone     = false
var int   fvgDnMssBar      = na

if useFVG
    bool _conf = barstate.isconfirmed
    float _accRange   = f_fvgAccumRange()
    bool  fvgIsAccum  = f_fvgIsAccumCore()
    float _accHighNow = ta.highest(math.max(open, close), fvgAccumRangeLen)
    float _accLowNow  = ta.lowest(math.min(open, close), fvgAccumRangeLen)
    bool _newAccum = fvgIsAccum and not fvgIsAccumPrev
    bool _endAccum = not fvgIsAccum and fvgIsAccumPrev

    // 1. 新Accum開始 → 状態リセット + 前フェーズFVG全削除
    if _newAccum
        fvgLastAccumHigh := na
        fvgLastAccumLow  := na
        fvgLastAccumWidth:= na
        fvgPhaseAccumRef := na
        fvgRunAccumHigh  := _accHighNow
        fvgRunAccumLow   := _accLowNow
        fvgUpBreakSeen := false
        fvgUpCumBody   := 0.0
        fvgUpMssDone   := false
        fvgUpMssBar    := na
        fvgDnBreakSeen := false
        fvgDnCumBody   := 0.0
        fvgDnMssDone   := false
        fvgDnMssBar    := na
        fvgPhaseActive := false
        fvgAbsorbBias  := 0
        fvgResetStateNow := true
        while array.size(bullTopArr) > 0
            array.remove(bullTopArr, 0)
            array.remove(bullBotArr, 0)
            array.remove(bullBarArr, 0)
            array.remove(bullRefArr, 0)
            array.remove(bullRebUsed, 0)
            array.remove(bullAbsUsed, 0)
            array.remove(bullDeadArr, 0)
            array.remove(bullFilledArr, 0)
        while array.size(bearTopArr) > 0
            array.remove(bearTopArr, 0)
            array.remove(bearBotArr, 0)
            array.remove(bearBarArr, 0)
            array.remove(bearRefArr, 0)
            array.remove(bearRebUsed, 0)
            array.remove(bearAbsUsed, 0)
            array.remove(bearDeadArr, 0)
            array.remove(bearFilledArr, 0)

    // 2. Accum継続中 → 実体ベースで高安追跡
    if fvgIsAccum
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        fvgRunAccumHigh := na(fvgRunAccumHigh) ? _bt : math.max(fvgRunAccumHigh, _bt)
        fvgRunAccumLow  := na(fvgRunAccumLow)  ? _bb : math.min(fvgRunAccumLow,  _bb)

    // 3. Accum終了 → 確定幅を保存
    if _endAccum
        fvgLastAccumHigh := fvgRunAccumHigh
        fvgLastAccumLow  := fvgRunAccumLow
        fvgLastAccumWidth:= fvgRunAccumHigh - fvgRunAccumLow
        fvgPhaseAccumRef := fvgLastAccumWidth
        fvgRunAccumHigh  := na
        fvgRunAccumLow   := na

    // 4. MSS (上抜け / 下抜け) → phaseActive 有効化
    bool _upMSS = false
    if not na(fvgLastAccumHigh) and not na(fvgLastAccumWidth) and fvgLastAccumWidth > 0 and not fvgUpMssDone
        bool _brk = close > fvgLastAccumHigh and close[1] <= fvgLastAccumHigh
        if _brk and not fvgUpBreakSeen
            fvgUpBreakSeen := true
            fvgUpCumBody   := close - open
        else if fvgUpBreakSeen
            fvgUpCumBody := fvgUpCumBody + (close - open)
        bool _imp = math.abs(fvgUpCumBody) >= fvgLastAccumWidth * fvgMssImpulseMult
        _upMSS := _conf and fvgUpBreakSeen and (not fvgMssNeedBodyStrength or _imp)
        if _upMSS
            fvgUpMssDone := true
    if _upMSS
        fvgPhaseActive := true
        fvgUpMssBar    := bar_index
    bool _dnMSS = false
    if not na(fvgLastAccumLow) and not na(fvgLastAccumWidth) and fvgLastAccumWidth > 0 and not fvgDnMssDone
        bool _brk = close < fvgLastAccumLow and close[1] >= fvgLastAccumLow
        if _brk and not fvgDnBreakSeen
            fvgDnBreakSeen := true
            fvgDnCumBody   := open - close
        else if fvgDnBreakSeen
            fvgDnCumBody := fvgDnCumBody + (open - close)
        bool _imp = math.abs(fvgDnCumBody) >= fvgLastAccumWidth * fvgMssImpulseMult
        _dnMSS := _conf and fvgDnBreakSeen and (not fvgMssNeedBodyStrength or _imp)
        if _dnMSS
            fvgDnMssDone := true
    if _dnMSS
        fvgPhaseActive := true
        fvgDnMssBar    := bar_index

    // 5. フェーズ中に形成されたFVGだけ収集
    float _ref = nz(fvgPhaseAccumRef, _accRange)
    float _thickMinAny = math.min(fvgThicknessMinRebound, fvgThicknessMinAbsorption)
    bool _newBull = _conf and low > high[2]
    bool _newBear = _conf and high < low[2]
    if fvgPhaseActive and useBullishFVG and _newBull and _ref > 0 and ((low - high[2]) / _ref) >= _thickMinAny
        array.push(bullTopArr, low)
        array.push(bullBotArr, high[2])
        array.push(bullBarArr, bar_index)
        array.push(bullRefArr, _ref)
        array.push(bullRebUsed, false)
        array.push(bullAbsUsed, false)
        array.push(bullDeadArr, false)
        array.push(bullFilledArr, false)
    if fvgPhaseActive and useBearishFVG and _newBear and _ref > 0 and ((low[2] - high) / _ref) >= _thickMinAny
        array.push(bearTopArr, low[2])
        array.push(bearBotArr, high)
        array.push(bearBarArr, bar_index)
        array.push(bearRefArr, _ref)
        array.push(bearRebUsed, false)
        array.push(bearAbsUsed, false)
        array.push(bearDeadArr, false)
        array.push(bearFilledArr, false)

    // 6. 最大保持数 超過 → 最古から削除
    while array.size(bullTopArr) > maxFVGPerSide
        array.remove(bullTopArr, 0)
        array.remove(bullBotArr, 0)
        array.remove(bullBarArr, 0)
        array.remove(bullRefArr, 0)
        array.remove(bullRebUsed, 0)
        array.remove(bullAbsUsed, 0)
        array.remove(bullDeadArr, 0)
        array.remove(bullFilledArr, 0)
    while array.size(bearTopArr) > maxFVGPerSide
        array.remove(bearTopArr, 0)
        array.remove(bearBotArr, 0)
        array.remove(bearBarArr, 0)
        array.remove(bearRefArr, 0)
        array.remove(bearRebUsed, 0)
        array.remove(bearAbsUsed, 0)
        array.remove(bearDeadArr, 0)
        array.remove(bearFilledArr, 0)

    // 7. 当バー埋めフラグを毎バー初期化
    if array.size(bullFilledArr) > 0
        for i = 0 to array.size(bullFilledArr) - 1
            array.set(bullFilledArr, i, false)
    if array.size(bearFilledArr) > 0
        for i = 0 to array.size(bearFilledArr) - 1
            array.set(bearFilledArr, i, false)

    // 8. 維持 / 無効化 (年齢超過 or Accum中 → dead)。終値貫通=当バー埋めフラグ
    if array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if not array.get(bullDeadArr, i)
                float _bot = array.get(bullBotArr, i)
                int   _bar = array.get(bullBarArr, i)
                if _conf and bar_index > _bar and close < _bot
                    array.set(bullFilledArr, i, true)
                if (bar_index - _bar) > fvgMaxAge or fvgIsAccum
                    array.set(bullDeadArr, i, true)
    if array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if not array.get(bearDeadArr, i)
                float _top = array.get(bearTopArr, i)
                int   _bar = array.get(bearBarArr, i)
                if _conf and bar_index > _bar and close > _top
                    array.set(bearFilledArr, i, true)
                if (bar_index - _bar) > fvgMaxAge or fvgIsAccum
                    array.set(bearDeadArr, i, true)

    // 9. 埋め集計 → 方向ロック
    bool _bullFill = false
    bool _bearFill = false
    if array.size(bullFilledArr) > 0
        for i = 0 to array.size(bullFilledArr) - 1
            if array.get(bullFilledArr, i)
                _bullFill := true
                array.set(bullRebUsed, i, true)
    if array.size(bearFilledArr) > 0
        for i = 0 to array.size(bearFilledArr) - 1
            if array.get(bearFilledArr, i)
                _bearFill := true
                array.set(bearRebUsed, i, true)
    if _bearFill
        if fvgAbsorbBias == 0
            fvgAbsorbBias := 1
        else if fvgAbsorbBias == -1
            fvgAbsorbBias := 2
    if _bullFill
        if fvgAbsorbBias == 0
            fvgAbsorbBias := -1
        else if fvgAbsorbBias == 1
            fvgAbsorbBias := 2

    bool _upWinOk = not na(fvgUpMssBar) and (bar_index - fvgUpMssBar <= fvgMssValidBars)
    bool _dnWinOk = not na(fvgDnMssBar) and (bar_index - fvgDnMssBar <= fvgMssValidBars)

    // 10. 吸収スキャン (先に評価 → 反発へ優先)
    int _absBuyIdx = -1
    if useFVGAbsorptionFilter and fvgPhaseActive and _dnWinOk and array.size(bearTopArr) > 0
        int _latest = -1
        for i = array.size(bearTopArr) - 1 to 0
            if _latest == -1 and array.get(bearBarArr, i) > fvgDnMssBar and not array.get(bearDeadArr, i) and not array.get(bearAbsUsed, i)
                if array.get(bearFilledArr, i) or (bar_index > array.get(bearBarArr, i) and close > array.get(bearTopArr, i))
                    _latest := i
        if _latest != -1
            float _top  = array.get(bearTopArr, _latest)
            float _bot  = array.get(bearBotArr, _latest)
            float _refL = array.get(bearRefArr, _latest)
            float _w    = _top - _bot
            bool _thin = _refL > 0 and (_w / _refL) <= fvgAbsorbThinRatioMax
            int _prev = -1
            if _latest > 0
                for j = _latest - 1 to 0
                    if _prev == -1 and array.get(bearBarArr, j) > fvgDnMssBar and not array.get(bearDeadArr, j) and not array.get(bearAbsUsed, j)
                        _prev := j
            bool _usePrev = false
            if _thin and _prev != -1
                float _ptop = array.get(bearTopArr, _prev)
                float _pbot = array.get(bearBotArr, _prev)
                float _pw = _ptop - _pbot
                float _gap = f_fvgZoneGap(_top, _bot, _ptop, _pbot)
                if _refL > 0 and (_gap / _refL) <= fvgAbsorbNearGapMax and _pw > _w
                    _usePrev := true
                    if _conf
                        array.set(bearAbsUsed, _latest, true)
            int _chosen = _latest
            if _usePrev
                if _prev != -1 and array.get(bearBarArr, _prev) > fvgDnMssBar and bar_index > array.get(bearBarArr, _prev) and close > array.get(bearTopArr, _prev)
                    _chosen := _prev
                else
                    _chosen := -1
            if _chosen != -1
                float _ctop = array.get(bearTopArr, _chosen)
                float _cref = array.get(bearRefArr, _chosen)
                float _cwidth = _ctop - array.get(bearBotArr, _chosen)
                bool _cThickOk = _cref > 0 and (_cwidth / _cref) >= fvgThicknessMinAbsorption
                float _barRange = high - low
                float _bodyRatio = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
                bool _closeNearHi = _barRange > 0 and (close - low) / _barRange >= absorbCloseEdgeRatio
                if _conf and close > open and close > _ctop and _bodyRatio >= absorbBodyMinRatio and _closeNearHi and _cThickOk
                    _absBuyIdx := _chosen
    int _absSellIdx = -1
    if useFVGAbsorptionFilter and fvgPhaseActive and _upWinOk and array.size(bullTopArr) > 0
        int _latest = -1
        for i = array.size(bullTopArr) - 1 to 0
            if _latest == -1 and array.get(bullBarArr, i) > fvgUpMssBar and not array.get(bullDeadArr, i) and not array.get(bullAbsUsed, i)
                if array.get(bullFilledArr, i) or (bar_index > array.get(bullBarArr, i) and close < array.get(bullBotArr, i))
                    _latest := i
        if _latest != -1
            float _top  = array.get(bullTopArr, _latest)
            float _bot  = array.get(bullBotArr, _latest)
            float _refL = array.get(bullRefArr, _latest)
            float _w    = _top - _bot
            bool _thin = _refL > 0 and (_w / _refL) <= fvgAbsorbThinRatioMax
            int _prev = -1
            if _latest > 0
                for j = _latest - 1 to 0
                    if _prev == -1 and array.get(bullBarArr, j) > fvgUpMssBar and not array.get(bullDeadArr, j) and not array.get(bullAbsUsed, j)
                        _prev := j
            bool _usePrev = false
            if _thin and _prev != -1
                float _ptop = array.get(bullTopArr, _prev)
                float _pbot = array.get(bullBotArr, _prev)
                float _pw = _ptop - _pbot
                float _gap = f_fvgZoneGap(_top, _bot, _ptop, _pbot)
                if _refL > 0 and (_gap / _refL) <= fvgAbsorbNearGapMax and _pw > _w
                    _usePrev := true
                    if _conf
                        array.set(bullAbsUsed, _latest, true)
            int _chosen = _latest
            if _usePrev
                if _prev != -1 and array.get(bullBarArr, _prev) > fvgUpMssBar and bar_index > array.get(bullBarArr, _prev) and close < array.get(bullBotArr, _prev)
                    _chosen := _prev
                else
                    _chosen := -1
            if _chosen != -1
                float _cbot = array.get(bullBotArr, _chosen)
                float _cref = array.get(bullRefArr, _chosen)
                float _cwidth = array.get(bullTopArr, _chosen) - _cbot
                bool _cThickOk = _cref > 0 and (_cwidth / _cref) >= fvgThicknessMinAbsorption
                float _barRange = high - low
                float _bodyRatio = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
                bool _closeNearLo = _barRange > 0 and (high - close) / _barRange >= absorbCloseEdgeRatio
                if _conf and close < open and close < _cbot and _bodyRatio >= absorbBodyMinRatio and _closeNearLo and _cThickOk
                    _absSellIdx := _chosen

    // 11. 反発スキャン (侵入深度方式 + 前足接触→現在足反転の遅延確定)
    int _rebBuyIdx = -1
    if useFVGReboundFilter and fvgPhaseActive and _upWinOk and array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if _rebBuyIdx == -1 and not array.get(bullDeadArr, i) and not array.get(bullRebUsed, i)
                float _top  = array.get(bullTopArr, i)
                float _bot  = array.get(bullBotArr, i)
                int   _bar  = array.get(bullBarArr, i)
                float _refI = array.get(bullRefArr, i)
                if _refI > 0 and ((_top - _bot) / _refI) >= fvgThicknessMinRebound
                    float _zone = math.max(_top - _bot, syminfo.mintick)
                    float _depth = math.max(0.0, (_top - low) / _zone)
                    bool _touched = bar_index > _bar and low <= _top and high >= _bot
                    bool _blk = f_fvgNearOppBearForBull(_top, _bot, _refI)
                    float _barRange = high - low
                    bool _bodyStrong  = not useFVGReboundStrictCandleBuy or (_barRange > 0 and math.abs(close - open) >= _barRange * fvgReboundBodyMinRatioBuy)
                    bool _closeNearHi = not useFVGReboundStrictCandleBuy or (_barRange > 0 and (close - low) / _barRange >= fvgReboundCloseEdgeRatioBuy)
                    bool _bullBar     = not useFVGReboundStrictCandleBuy or close > open
                    bool _direct = _touched and _depth < fvgReboundConfirmDepthBuy
                    bool _prevTouched = bar_index - 1 > _bar and low[1] <= _top and high[1] >= _bot
                    float _prevDepth  = math.max(0.0, (_top - math.min(open[1], close[1])) / _zone)
                    bool _deferred = _prevTouched and _prevDepth < fvgReboundConfirmDepthBuy
                    if _conf and not _blk and (_direct or _deferred) and _bullBar and _closeNearHi and _bodyStrong
                        _rebBuyIdx := i
    int _rebSellIdx = -1
    if useFVGReboundFilter and fvgPhaseActive and _dnWinOk and array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if _rebSellIdx == -1 and not array.get(bearDeadArr, i) and not array.get(bearRebUsed, i)
                float _top  = array.get(bearTopArr, i)
                float _bot  = array.get(bearBotArr, i)
                int   _bar  = array.get(bearBarArr, i)
                float _refI = array.get(bearRefArr, i)
                if _refI > 0 and ((_top - _bot) / _refI) >= fvgThicknessMinRebound
                    float _zone = math.max(_top - _bot, syminfo.mintick)
                    float _depth = math.max(0.0, (high - _bot) / _zone)
                    bool _touched = bar_index > _bar and high >= _bot and low <= _top
                    bool _blk = f_fvgNearOppBullForBear(_top, _bot, _refI)
                    float _barRange = high - low
                    bool _bodyStrong  = not useFVGReboundStrictCandleSell or (_barRange > 0 and math.abs(close - open) >= _barRange * fvgReboundBodyMinRatioSell)
                    bool _closeNearLo = not useFVGReboundStrictCandleSell or (_barRange > 0 and (high - close) / _barRange >= fvgReboundCloseEdgeRatioSell)
                    bool _bearBar     = not useFVGReboundStrictCandleSell or close < open
                    bool _direct = _touched and _depth < fvgReboundConfirmDepthSell
                    bool _prevTouched = bar_index - 1 > _bar and high[1] >= _bot and low[1] <= _top
                    float _prevDepth  = math.max(0.0, (math.max(open[1], close[1]) - _bot) / _zone)
                    bool _deferred = _prevTouched and _prevDepth < fvgReboundConfirmDepthSell
                    if _conf and not _blk and (_direct or _deferred) and _bearBar and _closeNearLo and _bodyStrong
                        _rebSellIdx := i

    // 12. 確定 (吸収優先 > 反発)
    if _absBuyIdx != -1
        fvgAbsorbBuy := true
        array.set(bearAbsUsed, _absBuyIdx, true)
    if _absSellIdx != -1
        fvgAbsorbSell := true
        array.set(bullAbsUsed, _absSellIdx, true)
    bool _anyAbsorb = fvgAbsorbBuy or fvgAbsorbSell
    if _rebBuyIdx != -1 and not _anyAbsorb
        fvgReboundBuy := true
        array.set(bullRebUsed, _rebBuyIdx, true)
    if _rebSellIdx != -1 and not _anyAbsorb
        fvgReboundSell := true
        array.set(bearRebUsed, _rebSellIdx, true)

    // 13. iFVG (吸収済みFVGの後日リテスト。useIFVGFilterで任意)
    if useIFVGFilter and _conf and array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if not array.get(bullDeadArr, i) and array.get(bullAbsUsed, i)
                float _top = array.get(bullTopArr, i)
                float _bot = array.get(bullBotArr, i)
                if high >= _bot and close < open and close <= _top
                    ifvgSell := true
                    array.set(bullDeadArr, i, true)
    if useIFVGFilter and _conf and array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if not array.get(bearDeadArr, i) and array.get(bearAbsUsed, i)
                float _top = array.get(bearTopArr, i)
                float _bot = array.get(bearBotArr, i)
                if low <= _top and close > open and close >= _bot
                    ifvgBuy := true
                    array.set(bearDeadArr, i, true)

    // 14. 前バーAccum状態の保存
    fvgIsAccumPrev := fvgIsAccum

// --- FVGイベントOK (そのバー限定) : 状態管理 OFF 時の従来判定に使う ---
bool longFVGEventOk =
     (useFVGReboundFilter    and fvgReboundBuy) or
     (useFVGAbsorptionFilter and fvgAbsorbBuy) or
     (useIFVGFilter          and ifvgBuy)
bool shortFVGEventOk =
     (useFVGReboundFilter    and fvgReboundSell) or
     (useFVGAbsorptionFilter and fvgAbsorbSell) or
     (useIFVGFilter          and ifvgSell)

// --- FVG状態管理 : イベント発生後、一定本数だけ「FVG条件OK」を保持 ---
var bool longFVGStateOk    = false
var bool shortFVGStateOk   = false
var int  longFVGStateBar   = na
var int  shortFVGStateBar  = na
if useFVGStateWindow
    if longFVGEventOk
        longFVGStateOk   := true
        longFVGStateBar  := bar_index
    if shortFVGEventOk
        shortFVGStateOk   := true
        shortFVGStateBar  := bar_index
    if longFVGStateOk and not na(longFVGStateBar) and (bar_index - longFVGStateBar > fvgStateMaxBars)
        longFVGStateOk := false
    if shortFVGStateOk and not na(shortFVGStateBar) and (bar_index - shortFVGStateBar > fvgStateMaxBars)
        shortFVGStateOk := false
if fvgResetStateNow
    longFVGStateOk  := false
    shortFVGStateOk := false

// --- 吸収後 方向ロック ---
bool allowLongByFVGBias  = fvgAbsorbBias == 0 or fvgAbsorbBias == 1
bool allowShortByFVGBias = fvgAbsorbBias == 0 or fvgAbsorbBias == -1

// --- FVG 場所フィルター条件 (ロング側=longFVGOk / ショート側=shortFVGOk) ---
bool longFVGOk =
     not useFVGFilter or
     ((useFVGStateWindow ? longFVGStateOk : longFVGEventOk) and (not useFVGWZ or allowLongByFVGBias))
bool shortFVGOk =
     not useFVGFilter or
     ((useFVGStateWindow ? shortFVGStateOk : shortFVGEventOk) and (not useFVGWZ or allowShortByFVGBias))

// ============================================================
//  8. モメンタムモジュール (計算) — MACD ヒスト拡大D (logic01 が使用)
// ------------------------------------------------------------
//  添付ストラテジーで接続されている唯一のモメンタム:
//    MACD(8,21,5) の Hist拡大D。BUY = hist>0 かつ 3本連続で拡大、
//    SELL = hist<0 かつ 3本連続で縮小 (Hist位置フィルターはこれと整合)。
//  イベント後 macdStateMaxBars(5) 本だけ状態を保持。エントリー後リセット。
// ============================================================
f_calcMACDMomentum() =>
    bool _long  = false
    bool _short = false
    if useMACDModule
        [_line, _sig, _hist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)
        bool _bullExpand = _hist > 0 and _hist > _hist[1]
        bool _bearExpand = _hist < 0 and _hist < _hist[1]
        var int _bullCnt = 0
        var int _bearCnt = 0
        _bullCnt := _bullExpand ? _bullCnt + 1 : 0
        _bearCnt := _bearExpand ? _bearCnt + 1 : 0
        bool _bullOk = _bullCnt >= macdHistExpansionBars
        bool _bearOk = _bearCnt >= macdHistExpansionBars
        bool _dirBuy  = not useMACDHistDirectionFilter or _hist > 0
        bool _dirSell = not useMACDHistDirectionFilter or _hist < 0
        _long  := _bullOk and _dirBuy
        _short := _bearOk and _dirSell
    [_long, _short]

[macdMomLongEvent, macdMomShortEvent] = f_calcMACDMomentum()

var bool longMACDStateOk  = false
var bool shortMACDStateOk = false
var int  longMACDStateBar  = na
var int  shortMACDStateBar = na
if useMACDModule and useMACDStateWindow
    longMACDStateBar  := macdMomLongEvent  ? bar_index : longMACDStateBar
    shortMACDStateBar := macdMomShortEvent ? bar_index : shortMACDStateBar
    longMACDStateOk   := (longMACDStateOk  or macdMomLongEvent)  and (na(longMACDStateBar)  or not (bar_index - longMACDStateBar  > macdStateMaxBars))
    shortMACDStateOk  := (shortMACDStateOk or macdMomShortEvent) and (na(shortMACDStateBar) or not (bar_index - shortMACDStateBar > macdStateMaxBars))

bool allowLongByMomentum  = not useMACDModule ? true : useMACDStateWindow ? longMACDStateOk  : macdMomLongEvent
bool allowShortByMomentum = not useMACDModule ? true : useMACDStateWindow ? shortMACDStateOk : macdMomShortEvent

// ============================================================
//  8b. モメンタムモジュール (計算) — 1分ストキャス Extreme Reversal (logic10 が使用)
// ------------------------------------------------------------
//  添付ストラテジーの Momentum ストキャス (A: Extreme Reversal のみ ON) を移植。
//  1分足を request.security(lookahead_off) で参照し %K/%D を算出。Extreme Low
//  到達後に上向き反転 (傾き反転 or K/Dクロス) でロングイベント、Extreme High
//  到達後に下向き反転でショートイベント。一回発火で同一到達からの多重発火を防ぐ。
//  イベント後 stochStateMaxBars(5) 本だけ状態を保持。出力 allowLongByStoch /
//  allowShortByStoch。logic10 は allowLongByStoch (ロング側) のみ使用。
//  ※ ストキャスの判定式は添付ストラテジーの単体モジュールと同一。接続のみ。
//    K傾き/K/D位置フィルター (grpStochD・元既定OFF) は未使用のため未移植。
// ============================================================
bool sAct = useStochModule and useExtremeReversal

// ストキャス計算 (関数化 → 参照TF切り替え可能)。useStochTF=true 時のみ 1分参照。
f_stochCalc() =>
    float _rawK = ta.stoch(close, high, low, kLen)
    float _k = ta.sma(_rawK, kSmooth)
    float _d = ta.sma(_k, dLen)
    [_k, _d]

float stochK = na
float stochD = na
if useStochTF
    [k1, d1] = request.security(syminfo.tickerid, stochTF, f_stochCalc(), lookahead = barmerge.lookahead_off)
    stochK := k1
    stochD := d1
else
    [k2, d2] = f_stochCalc()
    stochK := k2
    stochD := d2

// 傾き / K・D クロス
bool slopeUp     = stochK > stochK[1]
bool slopeDown   = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

// A: Extreme Reversal (90/10 折り返し)
bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp)   or (useExtremeKDCross and kdCrossUp)

float stochSlope = stochK - stochK[1]
bool slopeStrengthOK_sell = not useSlopeStrengthFilter or stochSlope <= -stochSlopeMin
bool slopeStrengthOK_buy  = not useSlopeStrengthFilter or stochSlope >=  stochSlopeMin

var bool  wasExtremeHigh       = false
var bool  wasExtremeLow        = false
var bool  extremeHighTriggered = false
var bool  extremeLowTriggered  = false
var float lastExtremeHighValue = na
var float lastExtremeLowValue  = na

if stochK >= extremeHigh
    wasExtremeHigh := true
    lastExtremeHighValue := na(lastExtremeHighValue) ? stochK : math.max(lastExtremeHighValue, stochK)
if stochK <= extremeLow
    wasExtremeLow := true
    lastExtremeLowValue := na(lastExtremeLowValue) ? stochK : math.min(lastExtremeLowValue, stochK)
if stochK <= extremeResetLevelHigh
    wasExtremeHigh := false
    extremeHighTriggered := false
    lastExtremeHighValue := na
if stochK >= extremeResetLevelLow
    wasExtremeLow := false
    extremeLowTriggered := false
    lastExtremeLowValue := na

bool retraceOK_sell = not useExtremeRetraceFilter or (not na(lastExtremeHighValue) and (lastExtremeHighValue - stochK) >= extremeRetraceMin)
bool retraceOK_buy  = not useExtremeRetraceFilter or (not na(lastExtremeLowValue)  and (stochK - lastExtremeLowValue)  >= extremeRetraceMin)

bool exSell = sAct and wasExtremeHigh and (not useExtremeOneShot or not extremeHighTriggered) and turnDown and slopeStrengthOK_sell and retraceOK_sell
bool exBuy  = sAct and wasExtremeLow  and (not useExtremeOneShot or not extremeLowTriggered)  and turnUp   and slopeStrengthOK_buy  and retraceOK_buy

if exSell
    extremeHighTriggered := true
if exBuy
    extremeLowTriggered := true

// ストキャス イベント (そのバーで発生したロング/ショート)
bool stochLongEvent  = sAct and exBuy
bool stochShortEvent = sAct and exSell

// ストキャス 状態管理 : イベント発生後 stochStateMaxBars 本 OK を保持
var bool stochLongStateOk   = false
var bool stochShortStateOk  = false
var int  stochLongStateBar  = na
var int  stochShortStateBar = na
if useStochStateWindow
    if stochLongEvent
        stochLongStateOk   := true
        stochLongStateBar  := bar_index
    if stochShortEvent
        stochShortStateOk   := true
        stochShortStateBar  := bar_index
    if stochLongStateOk and not na(stochLongStateBar) and bar_index - stochLongStateBar > stochStateMaxBars
        stochLongStateOk := false
    if stochShortStateOk and not na(stochShortStateBar) and bar_index - stochShortStateBar > stochStateMaxBars
        stochShortStateOk := false

// ストキャス 接続用出力 (状態管理ON=保持中フラグ / OFF=イベント単バー / 未使用=常時通過)
bool allowLongByStoch  = not sAct ? true : useStochStateWindow ? stochLongStateOk  : stochLongEvent
bool allowShortByStoch = not sAct ? true : useStochStateWindow ? stochShortStateOk : stochShortEvent

// ============================================================
//  9. トリガーモジュール (logic01 は非使用 = 常時許可)
// ------------------------------------------------------------
//  添付ストラテジーは全トリガーOFF (enabledTrigCount=0 → 常時true)。
//  logic01 はトリガー条件を持たない。将来ロジックが価格アクショントリガー
//  (包み足/ピンバー/BOS/EMAリジェクト等) を使う場合はここに追加する。
// ============================================================
bool allowLongByTrigger  = true
bool allowShortByTrigger = true

// ============================================================
//  10. ロジック別条件 — logic01
// ------------------------------------------------------------
//  4H:上昇 / 1H:下降 / 15M:下降 / 5M・1M:環境判定に使用しない / ランク:B固定
// ============================================================
bool   logic01Enabled = true
string logic01Rank    = "B"
string logic01Name    = "4H上昇 / 1H下降 / 15M下降"

// SL / RR (添付ストラテジーの設定を維持: 固定SL15 / RR1.0)
float logic01SlFixed = 15.0
float logic01RR      = 1.0

// 環境条件 (ロング/ショート共有 = 元コードで envLongOk == envShortOk)
bool logic01EnvLong  = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == -1 and env15M == -1
bool logic01EnvShort = logic01EnvLong

// 日足レジーム条件 (高ボラ要求。方向はOFF=制限なし。「当日確定後分析」は売買非接続=drTradeConnected)
bool logic01DailyOk = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "高ボラ"

// SL / TP / ロット
float logic01LongStop  = close - logic01SlFixed
float logic01LongRisk  = close - logic01LongStop
float logic01LongTP    = close + logic01LongRisk * logic01RR
float logic01ShortStop = close + logic01SlFixed
float logic01ShortRisk = logic01ShortStop - close
float logic01ShortTP   = close - logic01ShortRisk * logic01RR
float logic01LongQty   = f_qty(logic01LongRisk)
float logic01ShortQty  = f_qty(logic01ShortRisk)

// セットアップ (場所条件+モメンタム+トリガー。logic01 は WinZone/トリガー非使用のため実質モメンタム)
bool logic01SetupLong  = longWinZoneOk  and allowLongByMomentum  and allowLongByTrigger
bool logic01SetupShort = shortWinZoneOk and allowShortByMomentum and allowShortByTrigger

// 最終条件 (添付ストラテジー canLong / canShort を忠実に再現。WinZone/トリガーは常時true)
bool logic01FinalLong =
     logic01Enabled and
     useLong and
     logic01DailyOk and
     sessionOk and
     allowByNewsTime and
     logic01EnvLong and
     logic01SetupLong and
     volOk and
     logic01LongRisk > 0 and
     logic01LongQty >= 1
bool logic01FinalShort =
     logic01Enabled and
     useShort and
     logic01DailyOk and
     sessionOk and
     allowByNewsTime and
     logic01EnvShort and
     logic01SetupShort and
     volOk and
     logic01ShortRisk > 0 and
     logic01ShortQty >= 1

// ============================================================
//  10b. ロジック別条件 — logic02
// ------------------------------------------------------------
//  4H:上昇 / 1H:レンジ / 15M:下降 / 5M・1M:環境判定に使用しない / ランク:C固定
//  WinZone = 水平線 (複数回反応価格帯の反発) / モメンタム・トリガー = 非使用
//  日足 = 低ボラ / セッション = NYのみ / SL=固定12 / RR=1.0
// ============================================================
bool   logic02Enabled = true
string logic02Rank    = "C"
string logic02Name    = "4H上昇 / 1Hレンジ / 15M下降 / 水平線反発"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.0)
float logic02SlFixed = 12.0
float logic02RR      = 1.0

// 環境条件 (ロング/ショート共有 = 元コードで envLongOk == envShortOk)
bool logic02EnvLong  = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 0 and env15M == -1
bool logic02EnvShort = logic02EnvLong

// 日足レジーム条件 (低ボラ要求。方向はOFF=制限なし。「当日確定後分析」は売買非接続=drTradeConnected)
bool logic02DailyOk = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// セッション条件 (logic02専用: NYのみ。logic01 の共通 sessionOk は流用しない)
bool logic02SessionOk = not useSessionFilter or inNY

// WinZone (logic02専用: 反発のみ)。水平線パターン別出力から反発だけを選択する。
bool logic02LineLong  = lineBounceLong
bool logic02LineShort = lineBounceShort

// モメンタム / トリガー (添付ストラテジーで最終条件へ非接続 = 常時通過。logic01のMACDは混ぜない)
bool logic02MomentumLong  = true
bool logic02MomentumShort = true
bool logic02TriggerLong   = true
bool logic02TriggerShort  = true

// SL / TP / ロット
float logic02LongStop  = close - logic02SlFixed
float logic02LongRisk  = close - logic02LongStop
float logic02LongTP    = close + logic02LongRisk * logic02RR
float logic02ShortStop = close + logic02SlFixed
float logic02ShortRisk = logic02ShortStop - close
float logic02ShortTP   = close - logic02ShortRisk * logic02RR
float logic02LongQty   = f_qty(logic02LongRisk)
float logic02ShortQty  = f_qty(logic02ShortRisk)

// 最終条件 (添付ストラテジー canLong / canShort を忠実に再現)
bool logic02FinalLong =
     logic02Enabled and
     useLong and
     logic02DailyOk and
     logic02SessionOk and
     allowByNewsTime and
     logic02EnvLong and
     logic02LineLong and
     logic02MomentumLong and
     logic02TriggerLong and
     volOk and
     not lineNoTradeLong and
     logic02LongRisk > 0 and
     logic02LongQty >= 1
bool logic02FinalShort =
     logic02Enabled and
     useShort and
     logic02DailyOk and
     logic02SessionOk and
     allowByNewsTime and
     logic02EnvShort and
     logic02LineShort and
     logic02MomentumShort and
     logic02TriggerShort and
     volOk and
     not lineNoTradeShort and
     logic02ShortRisk > 0 and
     logic02ShortQty >= 1

// ============================================================
//  10c. ロジック別条件 — logic03 (ショート専用)
// ------------------------------------------------------------
//  4H:上昇 / 1H:レンジ / 15M:下降 / 5M・1M:環境判定に使用しない / ランク:B固定
//  ショート専用 (ロング無効)。WinZone = フィボ OR 水平線。
//  日足 = 高ボラ + 高ボラ3区分 / セッション = Asia+NY / SL=固定12 / RR=1.0
//  モメンタム・トリガー = 非使用 (常時通過)。既存logic01のMACDは混ぜない。
// ============================================================
bool   logic03Enabled = true
string logic03Rank    = "B"
string logic03Name    = "4H上昇 / 1Hレンジ / 15M下降 / Fib・水平線"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.0)
float logic03SlFixed = 12.0
float logic03RR      = 1.0

// 環境条件 (ショート専用。logic03EnvLong は使用しない)
bool logic03EnvShort = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 0 and env15M == -1

// 日足レジーム条件 (高ボラ要求 + 高ボラ3区分)。「当日確定後分析」は売買非接続 (drTradeConnected)。
bool logic03DailyOk        = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "高ボラ"
bool logic03HighVolBandOk  = drHighVolBandOk

// セッション条件 (logic03専用: Asia + NY。logic01/logic02 のセッションは流用しない)
bool logic03SessionOk = not useSessionFilter or inAsia or inNY

// WinZone (logic03専用: フィボ OR 水平線[全パターン])。
//   水平線側は反発/転換/ブレイク/スイープ の全パターンショートを OR (添付元 全ON)。
//   logic02 の反発のみ条件 (logic02LineShort) へは混ぜない。
bool logic03LineShort      = lineBounceShort or lineFlipShort or lineBreakShort or lineSweepShort
bool logic03ShortWinZoneOk = shortFibZoneOk or logic03LineShort

// モメンタム / トリガー (添付ストラテジーで最終条件へ非接続 = 常時通過)
bool logic03MomentumShort = true
bool logic03TriggerShort  = true

// SL / TP / ロット (ショートのみ)
float logic03ShortStop = close + logic03SlFixed
float logic03ShortRisk = logic03ShortStop - close
float logic03ShortTP   = close - logic03ShortRisk * logic03RR
float logic03ShortQty  = f_qty(logic03ShortRisk)

// 最終条件
bool logic03FinalLong = false
bool logic03FinalShort =
     logic03Enabled and
     useShort and
     logic03DailyOk and
     logic03HighVolBandOk and
     logic03SessionOk and
     allowByNewsTime and
     logic03EnvShort and
     logic03ShortWinZoneOk and
     logic03MomentumShort and
     logic03TriggerShort and
     volOk and
     not lineNoTradeShort and
     logic03ShortRisk > 0 and
     logic03ShortQty >= 1

// ============================================================
//  10d. ロジック別条件 — logic04 (ロング＋ショート)
// ------------------------------------------------------------
//  4H:上昇 / 1H:レンジ / 15M:レンジ / 5M・1M:環境判定に使用しない / ランク:C固定
//  WinZone = 出来高ブレイクのみ (水平線/Fib/POC等は接続しない)。
//  日足 = 低ボラ (高ボラ3区分は使用しない) / セッション = NYのみ / SL=固定12 / RR=1.0
//  モメンタム・トリガー = 非使用 (常時通過)。既存logic01/02/03 の条件は混ぜない。
// ============================================================
bool   logic04Enabled = true
string logic04Rank    = "C"
string logic04Name    = "4H上昇 / 1Hレンジ / 15Mレンジ / 出来高ブレイク"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.0)
float logic04SlFixed = 12.0
float logic04RR      = 1.0

// 環境条件 (4H上昇 / 1Hレンジ / 15Mレンジ。ロング/ショート共通)
bool logic04EnvLong  = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 0 and env15M == 0
bool logic04EnvShort = logic04EnvLong

// 日足レジーム条件 (低ボラ要求。高ボラ3区分は使用しない)。「当日確定後分析」は売買非接続。
bool logic04DailyOk = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// セッション条件 (logic04専用: NYのみ。他ロジックのセッションは流用しない)
bool logic04SessionOk = not useSessionFilter or inNY

// WinZone (logic04専用: 出来高ブレイクのみ。他モジュールと AND/OR しない)
bool logic04VolumeLongOk  = logic04VolumeLong
bool logic04VolumeShortOk = logic04VolumeShort

// モメンタム / トリガー (添付ストラテジーで最終条件へ非接続 = 常時通過)
bool logic04MomentumLong  = true
bool logic04MomentumShort = true
bool logic04TriggerLong   = true
bool logic04TriggerShort  = true

// SL / TP / ロット
float logic04LongStop  = close - logic04SlFixed
float logic04LongRisk  = close - logic04LongStop
float logic04LongTP    = close + logic04LongRisk * logic04RR
float logic04LongQty   = f_qty(logic04LongRisk)
float logic04ShortStop = close + logic04SlFixed
float logic04ShortRisk = logic04ShortStop - close
float logic04ShortTP   = close - logic04ShortRisk * logic04RR
float logic04ShortQty  = f_qty(logic04ShortRisk)

// 最終条件 (水平線を使用しないため lineNoTrade は接続しない)
bool logic04FinalLong =
     logic04Enabled and
     useLong and
     logic04DailyOk and
     logic04SessionOk and
     allowByNewsTime and
     logic04EnvLong and
     logic04VolumeLongOk and
     logic04MomentumLong and
     logic04TriggerLong and
     volOk and
     logic04LongRisk > 0 and
     logic04LongQty >= 1
bool logic04FinalShort =
     logic04Enabled and
     useShort and
     logic04DailyOk and
     logic04SessionOk and
     allowByNewsTime and
     logic04EnvShort and
     logic04VolumeShortOk and
     logic04MomentumShort and
     logic04TriggerShort and
     volOk and
     logic04ShortRisk > 0 and
     logic04ShortQty >= 1

// ============================================================
//  10e. ロジック別条件 — logic05 (ロング専用)
// ------------------------------------------------------------
//  4H:上昇 / 1H:レンジ / 15M:上昇 / 5M・1M:環境判定に使用しない / ランク:B固定
//  ロング専用 (ショート無効)。WinZone = フィボのみ (押し目買い)。
//  日足 = 低ボラ (高ボラ3区分は使用しない) / セッション = NYのみ / SL=固定12 / RR=1.0
//  モメンタム・トリガー = 非使用 (常時通過)。既存logic01〜04 の条件は混ぜない。
// ============================================================
bool   logic05Enabled = true
string logic05Rank    = "B"
string logic05Name    = "4H上昇 / 1Hレンジ / 15M上昇 / フィボ"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.0)
float logic05SlFixed = 12.0
float logic05RR      = 1.0

// 環境条件 (4H上昇 / 1Hレンジ / 15M上昇。ロング専用。logic05EnvShort は使用しない)
bool logic05EnvLong  = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 0 and env15M == 1
bool logic05EnvShort = false

// 日足レジーム条件 (低ボラ要求。高ボラ3区分は使用しない)。「当日確定後分析」は売買非接続。
bool logic05DailyOk = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// セッション条件 (logic05専用: NYのみ。他ロジックのセッションは流用しない)
bool logic05SessionOk = not useSessionFilter or inNY

// WinZone (logic05専用: フィボのみ。ロング側 longFibZoneOk を使用。他モジュールは接続しない)
bool logic05FibLong = longFibZoneOk

// モメンタム / トリガー (添付ストラテジーで最終条件へ非接続 = 常時通過)
bool logic05MomentumLong = true
bool logic05TriggerLong  = true

// SL / TP / ロット (ロングのみ)
float logic05LongStop = close - logic05SlFixed
float logic05LongRisk = close - logic05LongStop
float logic05LongTP   = close + logic05LongRisk * logic05RR
float logic05LongQty  = f_qty(logic05LongRisk)

// 最終条件 (水平線を使用しないため lineNoTrade は接続しない)
bool logic05FinalLong =
     logic05Enabled and
     useLong and
     logic05DailyOk and
     logic05SessionOk and
     allowByNewsTime and
     logic05EnvLong and
     logic05FibLong and
     logic05MomentumLong and
     logic05TriggerLong and
     volOk and
     logic05LongRisk > 0 and
     logic05LongQty >= 1
bool logic05FinalShort = false

// ============================================================
//  10f. ロジック別条件 — logic06 (ロング専用)
// ------------------------------------------------------------
//  4H:上昇 / 1H:上昇 / 15M:下降 / 5M・1M:環境判定に使用しない / ランク:B固定
//  ロング専用 (ショート無効)。WinZone = 水平線 反発ロングのみ (既存 lineBounceLong を再利用)。
//  日足 = 低ボラ (方向は問わない / 高ボラ3区分は使用しない) / SL=固定12 / RR=1.2。
//  モメンタム・トリガー = 非使用 (常時通過)。既存logic01〜05 の条件は混ぜない。
//  ※ 既存モジュール出力のみ再利用 (新規 request.security / ta.atr / Pivot / 配列 追加なし)。
// ============================================================
bool   logic06Enabled = true
string logic06Rank    = "B"
string logic06Name    = "4H上昇 / 1H上昇 / 15M下降 / 水平線反発"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.2)
float logic06SlFixed = 12.0
float logic06RR      = 1.2

// 環境条件 (4H上昇 / 1H上昇 / 15M下降。ロング専用。logic06EnvShort は使用しない)
//   共通の env4H/env1H/env15M を固定パターンで判定 (共通入力 reqTrend* は書き換えない)。
bool logic06EnvLong  = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 1 and env15M == -1
bool logic06EnvShort = false

// 日足レジーム条件 (低ボラ要求・方向は問わない。高ボラ3区分は使用しない)。「当日確定後分析」は売買非接続。
bool logic06DailyOk = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// WinZone (logic06専用: 水平線 反発ロングのみ。統合出力ではなく反発専用出力 lineBounceLong を使用)
bool logic06LineLong = lineBounceLong

// モメンタム / トリガー (未使用 = 常時通過。共通 Momentum/Trigger 設定の影響を受けない)
bool logic06MomentumLong = true
bool logic06TriggerLong  = true

// SL / TP / ロット (ロングのみ。既存共通のリスク計算 f_qty / 固定SL / RR を再利用)
float logic06LongStop = close - logic06SlFixed
float logic06LongRisk = close - logic06LongStop
float logic06LongTP   = close + logic06LongRisk * logic06RR
float logic06LongQty  = f_qty(logic06LongRisk)

// 最終条件 (水平線の NoTrade は既存どおり適用。共通セッション/指標時間/ボラを再利用)
bool logic06FinalLong =
     logic06Enabled and
     useLong and
     logic06DailyOk and
     sessionOk and
     allowByNewsTime and
     logic06EnvLong and
     logic06LineLong and
     logic06MomentumLong and
     logic06TriggerLong and
     volOk and
     not lineNoTradeLong and
     logic06LongRisk > 0 and
     logic06LongQty >= 1
bool logic06FinalShort = false

// ============================================================
//  10g. ロジック別条件 — logic07 (ショート専用)
// ------------------------------------------------------------
//  4H:上昇 / 1H:上昇 / 15M:下降 / 5M・1M:環境判定に使用しない / ランク:A固定
//  ショート専用 (ロング無効)。WinZone = フィボ ショートのみ (既存 shortFibZoneOk を再利用)。
//  日足 = 高ボラ (方向は問わない) / SL=固定12 / RR=1.0。
//  モメンタム・トリガー = 非使用 (常時通過)。既存logic01〜06 の条件は混ぜない。
//  ※ 既存モジュール出力のみ再利用 (新規 request.security / ta.atr 追加なし)。
// ============================================================
bool   logic07Enabled = true
string logic07Rank    = "A"
string logic07Name    = "4H上昇 / 1H上昇 / 15M下降 / フィボ"

// SL / RR (添付ストラテジーの設定を維持: 固定SL12 / RR1.0)
float logic07SlFixed = 12.0
float logic07RR      = 1.0

// 環境条件 (4H上昇 / 1H上昇 / 15M下降。ショート専用。logic07EnvLong は使用しない)
//   共通の env4H/env1H/env15M を固定パターンで判定 (共通入力 reqTrend* は書き換えない)。
bool logic07EnvShort = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 1 and env15M == -1
bool logic07EnvLong  = false

// 日足レジーム条件 (高ボラ要求・方向は問わない)。「当日確定後分析」は売買非接続。
bool logic07DailyHighVol = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "高ボラ"

// WinZone (logic07専用: フィボのみ。ショート側 shortFibZoneOk を使用。他モジュールは接続しない)
bool logic07FibShort = shortFibZoneOk

// モメンタム / トリガー (未使用 = 常時通過。共通 Momentum/Trigger 設定の影響を受けない)
bool logic07MomentumShort = true
bool logic07TriggerShort  = true

// SL / TP / ロット (ショートのみ。既存共通のリスク計算 f_qty / 固定SL / RR を再利用)
float logic07ShortStop = close + logic07SlFixed
float logic07ShortRisk = logic07ShortStop - close
float logic07ShortTP   = close - logic07ShortRisk * logic07RR
float logic07ShortQty  = f_qty(logic07ShortRisk)

// 最終条件 (共通セッション/指標時間/ボラを再利用。水平線を使用しないため lineNoTrade は接続しない)
bool logic07FinalShort =
     logic07Enabled and
     useShort and
     logic07EnvShort and
     logic07DailyHighVol and
     logic07FibShort and
     sessionOk and
     allowByNewsTime and
     logic07MomentumShort and
     logic07TriggerShort and
     volOk and
     logic07ShortRisk > 0 and
     logic07ShortQty >= 1
bool logic07FinalLong = false

// ============================================================
//  10h. ロジック別条件 — logic08 (ロング＋ショート)
// ------------------------------------------------------------
//  4H:上昇 / 1H:上昇 / 15M:レンジ / 5M・1M:環境判定に使用しない / ランク:B固定
//  ロング・ショート両方。WinZone = 水平線 スイープ反転のみ (既存 lineSweepLong/Short を再利用)。
//  日足 = 低ボラ (方向は問わない / 高ボラ3区分は使用しない) / セッション = NYのみ / SL=固定10 / RR=1.0。
//  モメンタム = 非使用 (常時通過) / トリガー = EMA20リジェクトのみ (傾きフィルターOFF)。
//  ※ 4H-up には Trigger モジュールが未移植のため、EMA20リジェクト判定のみ最小構成で追加
//    (元Triggerの trBullEMA/trBearEMA と同一式・傾きフィルターOFF)。既存モジュールは変更しない。
// ============================================================
bool   logic08Enabled = true
string logic08Rank    = "B"
string logic08Name    = "4H上昇 / 1H上昇 / 15Mレンジ / 水平線スイープ＋EMA20リジェクト"

// SL / RR (固定SL10 / RR1.0)
float logic08SlFixed = 10.0
float logic08RR      = 1.0

// 環境条件 (4H上昇 / 1H上昇 / 15Mレンジ。ロング/ショート共通。共通入力 reqTrend* は書き換えない)
bool logic08EnvOk = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 1 and env15M == 0

// 日足レジーム条件 (低ボラ要求・方向は問わない。高ボラ3区分は使用しない)。「当日確定後分析」は売買非接続。
bool logic08DailyLowVol = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// セッション条件 (logic08専用: NYのみ。共通 sessionOk は使わず inNY を直接要求)
bool logic08SessionOk = not useSessionFilter or inNY

// WinZone (logic08専用: 水平線 スイープ反転のみ。最小貫通 ATR×0.3 の logic08専用出力を使用)
//   ※ 共通 lineSweepLong/Short (ATR×0.5) は使わない。logic03 の lineSweepShort には影響しない。
bool logic08LineLong  = logic08SweepLong
bool logic08LineShort = logic08SweepShort

// モメンタム (未使用 = 常時通過。共通 Momentum 設定の影響を受けない)
bool logic08MomentumLong  = true
bool logic08MomentumShort = true

// トリガー: EMA20リジェクトのみ (傾きフィルターOFF)。元Trigger trBullEMA/trBearEMA と同一式。
//   ロング = 安値がEMA20接触/割込 ∧ 終値>EMA20 ∧ 陽線 / ショート = 高値がEMA20接触/上抜 ∧ 終値<EMA20 ∧ 陰線
float logic08EmaTrig = ta.ema(close, 20)
bool logic08TriggerLong  = low  <= logic08EmaTrig and close > logic08EmaTrig and close > open
bool logic08TriggerShort = high >= logic08EmaTrig and close < logic08EmaTrig and close < open

// SL / TP / ロット (既存共通のリスク計算 f_qty / 固定SL / RR を再利用)
float logic08LongStop = close - logic08SlFixed
float logic08LongRisk = close - logic08LongStop
float logic08LongTP   = close + logic08LongRisk * logic08RR
float logic08LongQty  = f_qty(logic08LongRisk)
float logic08ShortStop = close + logic08SlFixed
float logic08ShortRisk = logic08ShortStop - close
float logic08ShortTP   = close - logic08ShortRisk * logic08RR
float logic08ShortQty  = f_qty(logic08ShortRisk)

// 最終条件 (水平線の方向別 NoTrade を適用。共通指標時間/ボラを再利用)
bool logic08FinalLong =
     logic08Enabled and
     useLong and
     logic08EnvOk and
     logic08DailyLowVol and
     logic08SessionOk and
     allowByNewsTime and
     logic08LineLong and
     logic08MomentumLong and
     logic08TriggerLong and
     volOk and
     not lineNoTradeLong and
     logic08LongRisk > 0 and
     logic08LongQty >= 1
bool logic08FinalShort =
     logic08Enabled and
     useShort and
     logic08EnvOk and
     logic08DailyLowVol and
     logic08SessionOk and
     allowByNewsTime and
     logic08LineShort and
     logic08MomentumShort and
     logic08TriggerShort and
     volOk and
     not lineNoTradeShort and
     logic08ShortRisk > 0 and
     logic08ShortQty >= 1

// ============================================================
//  10i. ロジック別条件 — logic09 (ロングのみ)
// ------------------------------------------------------------
//  4H:上昇 / 1H:上昇 / 15M:上昇 / 5M・1M:環境判定に使用しない / ランク:C固定
//  ロングのみ (ショートは必ず無効)。WinZone = FVG のみ (共通 longFVGOk を再利用)。
//  日足 = 低ボラ (方向は問わない / 高ボラ3区分・drDirTextOut は接続しない) /
//  セッション = Asia・EU・NY 全て (共通 sessionOk) / 指標除外 = allowByNewsTime /
//  SL=固定12 / RR=1.0。モメンタム・トリガーは非使用 (常時通過)。
//  ※ FVG モジュール (7d) は共通出力 longFVGOk を再利用し、logic09 は条件差 (環境/セッション)
//    のみを分離する。新規 request.security / FVG 配列 / ATR / 検出は追加していない。
// ============================================================
bool   logic09Enabled = true
string logic09Rank    = "C"
string logic09Name    = "4H上昇 / 1H上昇 / 15M上昇 / FVG"

// SL / RR (固定SL12 / RR1.0)
float logic09SlFixed = 12.0
float logic09RR      = 1.0

// 環境条件 (4H上昇 / 1H上昇 / 15M上昇。ロング専用。共通入力 reqTrend* は書き換えない)
bool logic09EnvOk = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 1 and env15M == 1

// 日足レジーム条件 (低ボラ要求・方向は問わない。高ボラ3区分・drDirTextOut は使用しない)。「当日確定後分析」は売買非接続。
bool logic09DailyLowVol = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "低ボラ"

// セッション条件 (Asia・EU・NY 全て = 共通 sessionOk を再利用)
bool logic09SessionOk = sessionOk

// WinZone (FVG のみ。共通 longFVGOk = FVG反発/吸収/逆側近接/USレンジ式/Accum/MSS/状態管理 を再利用)
//   ※ 出来高POC・フィボ・EMA・水平線・iFVG・Bearish FVG のショート条件は接続しない。ロング FVG 出力のみ。
bool logic09FVGLong = longFVGOk

// モメンタム (未使用 = 常時通過。共通 Momentum 設定の影響を受けない)
bool logic09MomentumLong = true

// トリガー (未使用 = 常時通過。包み足/ピンバー/BOS/EMAリジェクト/FVG形成/強ローソクは接続しない)
bool logic09TriggerLong = true

// SL / TP / ロット (既存共通のリスク計算 f_qty / 固定SL / RR を再利用)
float logic09LongStop = close - logic09SlFixed
float logic09LongRisk = close - logic09LongStop
float logic09LongTP   = close + logic09LongRisk * logic09RR
float logic09LongQty  = f_qty(logic09LongRisk)

// 最終条件 (ロングのみ。FVG は NoTrade 出力を持たないため NoTrade は接続しない。共通指標時間/ボラを再利用)
bool logic09FinalLong =
     logic09Enabled and
     useLong and
     logic09EnvOk and
     logic09DailyLowVol and
     logic09SessionOk and
     allowByNewsTime and
     logic09FVGLong and
     logic09MomentumLong and
     logic09TriggerLong and
     volOk and
     logic09LongRisk > 0 and
     logic09LongQty >= 1
// ショートは必ず無効
bool logic09FinalShort = false

// ============================================================
//  10j. ロジック別条件 — logic10 (ロングのみ)
// ------------------------------------------------------------
//  4H:上昇 / 1H:上昇 / 15M:上昇 / 5M・1M:環境判定に使用しない / ランク:B固定
//  ロングのみ (ショートは必ず無効)。Momentum = 1分ストキャス Extreme Reversal のみ
//  (共通 allowLongByStoch を再利用)。WinZone = 使用しない (元ストラテジーで FVG/出来高/
//  POC/フィボ/EMA/水平線 が全OFF → 常時通過)。日足 = 中ボラのみ (方向は問わない /
//  drDirTextOut・高ボラ3区分は非接続) / セッション = Asia・EU・NY 全て (共通 sessionOk) /
//  指標除外 = allowByNewsTime / SL=固定12 / RR=1.0。トリガーは非使用 (常時通過)。
//  ※ 4H-up には元々ストキャスモジュールが無いため、8b で最小構成の 1分ストキャス
//    Extreme Reversal を移植し、その allowLongByStoch を再利用する。
//    水平線 lineNoTradeLong は接続しない (元ストラテジーで水平線WinZoneがOFFのため)。
// ============================================================
bool   logic10Enabled = true
string logic10Rank    = "B"
string logic10Name    = "4H上昇 / 1H上昇 / 15M上昇 / 1M Stoch Extreme"

// SL / RR (固定SL12 / RR1.0)
float logic10SlFixed = 12.0
float logic10RR      = 1.0

// 環境条件 (4H上昇 / 1H上昇 / 15M上昇。ロング専用。共通入力 reqTrend* は書き換えない)
bool logic10EnvOk = not na(env4H) and not na(env1H) and not na(env15M) and env4H == 1 and env1H == 1 and env15M == 1

// 日足レジーム条件 (中ボラ要求・方向は問わない。高ボラ3区分・drDirTextOut は使用しない)。「当日確定後分析」は売買非接続。
bool logic10DailyMidVol = not useDailyRegimeFilter or not drTradeConnected or drVolTextOut == "中ボラ"

// セッション条件 (Asia・EU・NY 全て = 共通 sessionOk を再利用)
bool logic10SessionOk = sessionOk

// WinZone (未使用 = 常時通過)。FVG/出来高/POC/フィボ/EMA/水平線・lineNoTradeLong は接続しない。
bool logic10WinZoneLong = true

// モメンタム (1分ストキャス Extreme Reversal のロング側のみ。共通 allowLongByStoch を再利用)
bool logic10MomentumLong = allowLongByStoch

// トリガー (未使用 = 常時通過。包み足/ピンバー/BOS/EMAリジェクト/FVG形成/強ローソクは接続しない)
bool logic10TriggerLong = true

// SL / TP / ロット (既存共通のリスク計算 f_qty / 固定SL / RR を再利用)
float logic10LongStop = close - logic10SlFixed
float logic10LongRisk = close - logic10LongStop
float logic10LongTP   = close + logic10LongRisk * logic10RR
float logic10LongQty  = f_qty(logic10LongRisk)

// 最終条件 (ロングのみ。水平線を使用しないため lineNoTradeLong は接続しない。共通指標時間/ボラを再利用)
bool logic10FinalLong =
     logic10Enabled and
     useLong and
     logic10EnvOk and
     logic10DailyMidVol and
     logic10SessionOk and
     allowByNewsTime and
     logic10WinZoneLong and
     logic10MomentumLong and
     logic10TriggerLong and
     volOk and
     logic10LongRisk > 0 and
     logic10LongQty >= 1
// ショートは必ず無効
bool logic10FinalShort = false

// ============================================================
//  11. ランク優先処理 (A > B > C)
// ------------------------------------------------------------
//  各ロジックから直接ラベル/alertを出さず、一度共通の採用シグナルへ集約する。
//  同方向で複数ロジックが成立した場合は最上位ランクを採用し、同ランクは
//  ロジック番号の若い順を優先する (4Hレンジ版の優先順位仕様に準拠)。
//  ※ 現在 logic01〜logic10 を候補へ集約 (logic03・logic07 はショート専用 / logic05・logic06・logic09・logic10 はロング専用 / logic08 は両方向)。将来 logic11 … を追加する。
// ============================================================
f_rankNum(string r) => r == "A" ? 3 : r == "B" ? 2 : r == "C" ? 1 : 0

// --- ロング候補の集約 ---
//   より上位ランク (f_rankNum 大) を採用。同ランクは先に評価したロジック番号の若い順を優先
//   ( `>` 厳密比較のため、同ランクの後続ロジックは先勝ちを上書きしない)。
bool   selLong      = false
string selLongRank  = ""
string selLongName  = ""
float  selLongStop  = na
float  selLongTP    = na
float  selLongQty   = na
int    selLongLogic = 0        // 採用ロジック番号 (0=なし/1/2/4/5/6/8/9/10) — 状態リセットの振り分けに使用
int    _selLongRankNum = 0
// logic01 (Bランク)
if logic01FinalLong and f_rankNum(logic01Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic01Rank
    selLongName    := logic01Name
    selLongStop    := logic01LongStop
    selLongTP      := logic01LongTP
    selLongQty     := logic01LongQty
    selLongLogic   := 1
    _selLongRankNum := f_rankNum(logic01Rank)
// logic02 (Cランク)
if logic02FinalLong and f_rankNum(logic02Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic02Rank
    selLongName    := logic02Name
    selLongStop    := logic02LongStop
    selLongTP      := logic02LongTP
    selLongQty     := logic02LongQty
    selLongLogic   := 2
    _selLongRankNum := f_rankNum(logic02Rank)
// logic04 (Cランク)
//   厳密 `>` のため、先に評価した同ランク logic02(C) が成立していれば logic04 は採用されない
//   (同ランクは番号の若い順)。
if logic04FinalLong and f_rankNum(logic04Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic04Rank
    selLongName    := logic04Name
    selLongStop    := logic04LongStop
    selLongTP      := logic04LongTP
    selLongQty     := logic04LongQty
    selLongLogic   := 4
    _selLongRankNum := f_rankNum(logic04Rank)
// logic05 (Bランク・ロング専用)
//   厳密 `>` のため、先に評価した同ランク logic01(B) が成立していれば logic05 は採用されない
//   (同ランクは番号の若い順)。現在の最高ランクが C 以下のときだけ logic05 が採用される。
if logic05FinalLong and f_rankNum(logic05Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic05Rank
    selLongName    := logic05Name
    selLongStop    := logic05LongStop
    selLongTP      := logic05LongTP
    selLongQty     := logic05LongQty
    selLongLogic   := 5
    _selLongRankNum := f_rankNum(logic05Rank)
// logic06 (Bランク・ロング専用)
//   厳密 `>` のため、先に評価した同ランク logic01(B) / logic05(B) が成立していれば logic06 は採用されない
//   (同ランクは番号の若い順)。現在の最高ランクが C 以下のときだけ logic06 が採用される。
if logic06FinalLong and f_rankNum(logic06Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic06Rank
    selLongName    := logic06Name
    selLongStop    := logic06LongStop
    selLongTP      := logic06LongTP
    selLongQty     := logic06LongQty
    selLongLogic   := 6
    _selLongRankNum := f_rankNum(logic06Rank)
// logic08 (Bランク・ロング)
//   厳密 `>` のため、先に評価した同ランク logic01(B)/logic05(B)/logic06(B) が成立していれば
//   logic08 は採用されない (同ランクは番号の若い順)。Aランクには勝たず、C以下には勝つ。
if logic08FinalLong and f_rankNum(logic08Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic08Rank
    selLongName    := logic08Name
    selLongStop    := logic08LongStop
    selLongTP      := logic08LongTP
    selLongQty     := logic08LongQty
    selLongLogic   := 8
    _selLongRankNum := f_rankNum(logic08Rank)
// logic09 (Cランク・ロング専用)
//   logic01〜logic08 より後に評価。厳密 `>` のため、先に評価した同ランク以上のロジックが
//   成立していれば logic09(C) は採用されない (Aランク/Bランク/先行 Cランクに勝たず、
//   現在の最高ランクがなし=0 のときだけ採用される)。ショート候補には追加しない。
if logic09FinalLong and f_rankNum(logic09Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic09Rank
    selLongName    := logic09Name
    selLongStop    := logic09LongStop
    selLongTP      := logic09LongTP
    selLongQty     := logic09LongQty
    selLongLogic   := 9
    _selLongRankNum := f_rankNum(logic09Rank)
// logic10 (Bランク・ロング専用)
//   logic01〜logic09 より後に評価。厳密 `>` のため、先に評価した同ランク以上のロジックが
//   成立していれば logic10(B) は採用されない (Aランク/先行 Bランクに勝たず、Cランク以下には勝つ)。
//   logic09(C) が先に候補になっていても、logic10(B) が成立すれば logic10 を採用する。
//   ショート候補には追加しない。
if logic10FinalLong and f_rankNum(logic10Rank) > _selLongRankNum
    selLong        := true
    selLongRank    := logic10Rank
    selLongName    := logic10Name
    selLongStop    := logic10LongStop
    selLongTP      := logic10LongTP
    selLongQty     := logic10LongQty
    selLongLogic   := 10
    _selLongRankNum := f_rankNum(logic10Rank)

// --- ショート候補の集約 ---
bool   selShort      = false
string selShortRank  = ""
string selShortName  = ""
float  selShortStop  = na
float  selShortTP    = na
float  selShortQty   = na
int    selShortLogic = 0        // 採用ロジック番号 (0=なし/1/2/3/4/7/8) — 状態リセットの振り分けに使用
int    _selShortRankNum = 0
// logic01 (Bランク)
if logic01FinalShort and f_rankNum(logic01Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic01Rank
    selShortName    := logic01Name
    selShortStop    := logic01ShortStop
    selShortTP      := logic01ShortTP
    selShortQty     := logic01ShortQty
    selShortLogic   := 1
    _selShortRankNum := f_rankNum(logic01Rank)
// logic02 (Cランク)
if logic02FinalShort and f_rankNum(logic02Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic02Rank
    selShortName    := logic02Name
    selShortStop    := logic02ShortStop
    selShortTP      := logic02ShortTP
    selShortQty     := logic02ShortQty
    selShortLogic   := 2
    _selShortRankNum := f_rankNum(logic02Rank)
// logic03 (Bランク・ショート専用)
//   厳密 `>` のため、先に評価した同ランク logic01(B) が成立していれば logic03 は採用されない
//   (同ランクは番号の若い順)。現在の最高ランクが C 以下のときだけ logic03 が採用される。
if logic03FinalShort and f_rankNum(logic03Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic03Rank
    selShortName    := logic03Name
    selShortStop    := logic03ShortStop
    selShortTP      := logic03ShortTP
    selShortQty     := logic03ShortQty
    selShortLogic   := 3
    _selShortRankNum := f_rankNum(logic03Rank)
// logic04 (Cランク)
//   厳密 `>` のため、先に評価した同ランク logic02(C) が成立していれば logic04 は採用されない
//   (同ランクは番号の若い順)。
if logic04FinalShort and f_rankNum(logic04Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic04Rank
    selShortName    := logic04Name
    selShortStop    := logic04ShortStop
    selShortTP      := logic04ShortTP
    selShortQty     := logic04ShortQty
    selShortLogic   := 4
    _selShortRankNum := f_rankNum(logic04Rank)
// logic07 (Aランク・ショート専用)
//   Aランクは最上位。厳密 `>` のため、先に評価した同ランクの既存Aロジックがあれば
//   それを上書きしない (同ランクは番号の若い順)。現時点で他のAランクが無いため、
//   logic07 成立時は B/C を上書きして採用される (A > B > C)。
if logic07FinalShort and f_rankNum(logic07Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic07Rank
    selShortName    := logic07Name
    selShortStop    := logic07ShortStop
    selShortTP      := logic07ShortTP
    selShortQty     := logic07ShortQty
    selShortLogic   := 7
    _selShortRankNum := f_rankNum(logic07Rank)
// logic08 (Bランク・ショート)
//   厳密 `>` のため、先に評価した同ランク logic01(B)/logic03(B) が成立していれば
//   logic08 は採用されない (同ランクは番号の若い順)。Aランク(logic07)には勝たず、C以下には勝つ。
if logic08FinalShort and f_rankNum(logic08Rank) > _selShortRankNum
    selShort        := true
    selShortRank    := logic08Rank
    selShortName    := logic08Name
    selShortStop    := logic08ShortStop
    selShortTP      := logic08ShortTP
    selShortQty     := logic08ShortQty
    selShortLogic   := 8
    _selShortRankNum := f_rankNum(logic08Rank)
// (logic09 以降はここへ同形式で追加)

// ============================================================
//  12. 競合処理 — 同一足で BUY と SELL が両成立 → 元ストラテジー準拠のローソク方向選択
// ------------------------------------------------------------
//  添付ストラテジーの発注部 (11. 発注) と同一の競合処理を移植:
//      if wantLong and wantShort
//          if close >= open
//              wantShort := false   // 陽線 (および始値=終値) は BUY を採用
//          else
//              wantLong  := false   // 陰線は SELL を採用
//  → close >= open で BUY、close < open で SELL。
//    始値と終値が同値の場合は close >= open が true となるため BUY を採用 (元コードどおり)。
// ============================================================
bool selectedLong  = selLong
bool selectedShort = selShort
if selLong and selShort
    if close >= open
        selectedShort := false
    else
        selectedLong := false

// ============================================================
//  15. 仮想ポジション管理 (実注文なし。連続シグナル抑止用)
// ------------------------------------------------------------
//  ・採用シグナル発生時に仮想ポジション開始 (固定SL・RRからTP)。
//  ・BUY/SELL とも high/low で SL/TP 到達判定。同一足で両到達は SL 優先。
//  ・保有中の新規抑止は useVirtualPositionBlock で ON/OFF。
//  ・決済後は次のシグナルを許可。ピラミッディングなし (1ポジション)。
//  ・将来ロジック別管理へ拡張可能 (posLogicName でどのロジックの建玉かを保持)。
// ============================================================
var bool   posActive   = false
var int    posDir      = 0
var float  posSL       = na
var float  posTP       = na
var int    posEntryBar = na
var string posLogicName = ""

// 決済監視 (シグナル判定より前。次バー以降・同一足SL/TP両到達はSL優先)
if posActive and not na(posEntryBar) and bar_index > posEntryBar
    if posDir == 1
        if low <= posSL
            posActive := false
        else if high >= posTP
            posActive := false
    else if posDir == -1
        if high >= posSL
            posActive := false
        else if low <= posTP
            posActive := false

// 新規受付可否 (抑止ON時は非保有のみ許可)
bool canOpenNew = not useVirtualPositionBlock or not posActive

// ============================================================
//  13/14/16. 仮シグナル / 確定シグナル / 表示・アラート
// ------------------------------------------------------------
//  ・仮シグナル  : リアルタイム足の確定前。1セットアップにつき確定前1回だけ alert。
//                  同一ロジック・同一方向で条件が継続 (次の5分足まで続く) しても再発火
//                  しない。条件が完全に消えて再成立すると新セットアップとして再び1回。
//                  ロング/ショートは別管理・別ロジックは別セットアップとして管理する。
//  ・確定シグナル: 足確定時に採用シグナルが成立していれば alert + ラベル。
//                  仮を発火済みでも確定は正常に出す (仮管理と確定管理は分離)。
//                  同一ロジック・同一方向・同一 bar_index の二重確定のみ抑止 (下記配列)。
//  ・5分足でのみ有効。競合処理後の selectedLong/selectedShort・selLongLogic/selShortLogic
//    (最終選択結果) に対して適用する (各ロジックの生条件へは直接接続しない)。
// ============================================================

// --- 仮シグナル セットアップ管理 (方向別・ロジック別。1セットアップ1回だけ発火) ---
//   セットアップID = 新規選択 or 採用ロジック切替のたびに採番する連番。条件が継続する
//   間は同じIDを維持し、方向が外れたら終了 (次の新規選択で新IDを採番)。
//   ※ bar_index だけをIDにすると継続時に毎足別IDになり毎足発火するため連番で識別する。
//   ※ 毎足無条件で発火履歴を na へ戻さない (戻すと継続中に何度も出るため)。
var int longSetupSeq          = 0
var int currentLongSetupId    = na
var int activeLongSetupLogic  = na
var int firedProvLongSetupId  = na
var int shortSetupSeq         = 0
var int currentShortSetupId   = na
var int activeShortSetupLogic = na
var int firedProvShortSetupId = na

// 発火済みID (リアルタイム保持用)。通常の var は未確定足のティック更新でロールバック
//   されるため、同一足中の発火済み状態を確実に保持する目的で varip を併用する。
//   ・仮アラートが実際に発火した時だけ RT 用IDへ保存する。
//   ・足確定時に RT 用IDを通常の var へコミットする。
//   ・新しいバー開始時に varip を無条件で na へ戻さない (セットアップIDが変われば
//     比較で新しい仮を許可できるため、前回IDを保持したままでよい)。
varip int firedProvLongSetupIdRT  = na
varip int firedProvShortSetupIdRT = na

// ロング セットアップ: 新規選択 or ロジック切替で採番 / 非選択で終了
bool longSetupStartNew = selectedLong and (na(currentLongSetupId) or activeLongSetupLogic != selLongLogic)
if longSetupStartNew
    longSetupSeq         += 1
    currentLongSetupId   := longSetupSeq
    activeLongSetupLogic := selLongLogic
else if not selectedLong
    currentLongSetupId   := na
    activeLongSetupLogic := na

// ショート セットアップ: 同上
bool shortSetupStartNew = selectedShort and (na(currentShortSetupId) or activeShortSetupLogic != selShortLogic)
if shortSetupStartNew
    shortSetupSeq         += 1
    currentShortSetupId   := shortSetupSeq
    activeShortSetupLogic := selShortLogic
else if not selectedShort
    currentShortSetupId   := na
    activeShortSetupLogic := na

// 仮ロング: 未確定足・そのセットアップが未発火 (var/varip 両方で未発火) のときだけ 1 回 alert
bool longProvEligible = is5m and canOpenNew and selectedLong and not na(currentLongSetupId) and (na(firedProvLongSetupId) or firedProvLongSetupId != currentLongSetupId) and (na(firedProvLongSetupIdRT) or firedProvLongSetupIdRT != currentLongSetupId)
bool newProvLong = longProvEligible and not barstate.isconfirmed
if newProvLong
    alert(f_sigMsg("仮", "BUY",  selLongRank,  selLongName,  close, selLongStop,  selLongTP,  selLongQty,  drVolTextOut), alert.freq_once_per_bar)
    // 仮が実際に発火した時だけ RT 用IDへ保存 (同一足中の重複発火を確実に防ぐ)
    firedProvLongSetupIdRT := currentLongSetupId

// 仮ショート: 同上
bool shortProvEligible = is5m and canOpenNew and selectedShort and not na(currentShortSetupId) and (na(firedProvShortSetupId) or firedProvShortSetupId != currentShortSetupId) and (na(firedProvShortSetupIdRT) or firedProvShortSetupIdRT != currentShortSetupId)
bool newProvShort = shortProvEligible and not barstate.isconfirmed
if newProvShort
    alert(f_sigMsg("仮", "SELL", selShortRank, selShortName, close, selShortStop, selShortTP, selShortQty, drVolTextOut), alert.freq_once_per_bar)
    // 仮が実際に発火した時だけ RT 用IDへ保存
    firedProvShortSetupIdRT := currentShortSetupId

// 足確定時: 実際に仮が発火した RT 用IDだけを通常の var へコミットする。
//   これにより「仮が出ていない確定足だけのセットアップ」を発火済みとして記録しない。
if is5m and barstate.isconfirmed
    if not na(firedProvLongSetupIdRT)
        firedProvLongSetupId := firedProvLongSetupIdRT
    if not na(firedProvShortSetupIdRT)
        firedProvShortSetupId := firedProvShortSetupIdRT

// 確定シグナル 重複防止 (ロジック別・方向別)
//   同一ロジック・同一方向・同一 bar_index で確定ラベル/アラートが二重発火するのを防ぐ。
//   全ロジック共通の1変数で抑止すると、同じ足で別ロジックが成立した場合まで潰すため、
//   採用ロジック番号 (selLongLogic / selShortLogic) をインデックスに、方向別の独立した
//   配列で最後に確定した bar_index を保持する (index 1..10 = logic01..logic10、0=未使用)。
//   ※ ロング候補: 1/2/4/5/6/8/9/10 ・ ショート候補: 1/2/3/4/7/8。存在しない方向のスロットは
//     参照されない (selLongLogic/selShortLogic がその番号にならないため)。
//   ※ 配列初期値は na のため「na != bar_index」は true でなく na になる。初回確定が停止し
//     配列も更新されず以後も確定が出なくなるバグを避けるため、na() を明示的に考慮する。
var array<int> lastLongConfBarByLogic  = array.new_int(11, na)
var array<int> lastShortConfBarByLogic = array.new_int(11, na)

int  lastLongConfBar       = array.get(lastLongConfBarByLogic,  selLongLogic)
int  lastShortConfBar      = array.get(lastShortConfBarByLogic, selShortLogic)
bool longConfBarAvailable  = na(lastLongConfBar)  or lastLongConfBar  != bar_index
bool shortConfBarAvailable = na(lastShortConfBar) or lastShortConfBar != bar_index

bool confLong  = is5m and barstate.isconfirmed and canOpenNew and selectedLong  and longConfBarAvailable
bool confShort = is5m and barstate.isconfirmed and canOpenNew and selectedShort and shortConfBarAvailable
if confLong
    float _e = close
    alert(f_sigMsg("確定", "BUY", selLongRank, selLongName, _e, selLongStop, selLongTP, selLongQty, drVolTextOut), alert.freq_once_per_bar)
    label.new(bar_index, low, f_labelText("BUY", selLongRank, selLongName, _e, selLongStop, selLongTP, selLongQty, drVolTextOut), yloc = yloc.belowbar, style = label.style_label_up, color = selLongRank == "A" ? COLOR_RANK_A : selLongRank == "C" ? COLOR_RANK_C : COLOR_RANK_B, textcolor = color.white, size = size.small)
    posActive    := true
    posDir       := 1
    posSL        := selLongStop
    posTP        := selLongTP
    posEntryBar  := bar_index
    posLogicName := selLongName
    // エントリー後 状態リセット (採用ロジックが実際に使用した状態のみリセット)
    //   logic01 = MACD状態 / logic02 = 水平線 反発ロング状態 / logic04 = 出来高ブレイク状態
    //   logic05 = フィボ ロング状態 / logic06 = 水平線 反発ロング状態 / logic08 = 水平線 スイープロング状態
    //   logic09 = FVG ロング状態 (longFVGStateOk のみ) / logic10 = ストキャス ロング状態 (stochLongStateOk のみ)
    //   (使用していない MACD/出来高/EMA/水平線他パターン/ショート側フィボ/ショート側FVG/ショート側ストキャス 状態は触らない)
    if selLongLogic == 1 and useMACDModule and resetMACDStateAfterEntry
        longMACDStateOk := false
    if selLongLogic == 2 and useLineWZ and resetLineStateAfterEntry
        lineBounceLongStateBar := na
    if selLongLogic == 4 and useVolumeStateWindow and resetVolumeStateAfterEntry
        logic04VolumeLongStateOk  := false
        logic04VolumeLongStateBar := na
    if selLongLogic == 5 and useFibWZ and resetFibStateAfterEntry
        longFibStateOk  := false
        longFibStateBar := na
    if selLongLogic == 6 and useLineWZ and resetLineStateAfterEntry
        lineBounceLongStateBar := na
    if selLongLogic == 8 and useLineWZ and resetLineStateAfterEntry
        logic08SweepLongStateBar := na
    if selLongLogic == 9 and useFVGStateWindow and resetFVGStateAfterEntry
        longFVGStateOk  := false
        longFVGStateBar := na
    if selLongLogic == 10 and useStochStateWindow and resetStochStateAfterEntry
        stochLongStateOk  := false
        stochLongStateBar := na
    // 確定ラベル・アラート・状態処理が完了 → 採用ロジックのロング側 確定barを保存 (同一足の重複防止)
    array.set(lastLongConfBarByLogic, selLongLogic, bar_index)
if confShort
    float _e = close
    alert(f_sigMsg("確定", "SELL", selShortRank, selShortName, _e, selShortStop, selShortTP, selShortQty, drVolTextOut), alert.freq_once_per_bar)
    label.new(bar_index, high, f_labelText("SELL", selShortRank, selShortName, _e, selShortStop, selShortTP, selShortQty, drVolTextOut), yloc = yloc.abovebar, style = label.style_label_down, color = selShortRank == "A" ? COLOR_RANK_A : selShortRank == "C" ? COLOR_RANK_C : COLOR_RANK_B, textcolor = color.white, size = size.small)
    posActive    := true
    posDir       := -1
    posSL        := selShortStop
    posTP        := selShortTP
    posEntryBar  := bar_index
    posLogicName := selShortName
    // エントリー後 状態リセット (採用ロジックが実際に使用した状態のみリセット)
    //   logic01 = MACD状態 / logic02 = 水平線 反発ショート状態 / logic03 = フィボ + 水平線 全ショート状態
    //   logic04 = 出来高ブレイク ショート状態 / logic07 = フィボ ショート状態 / logic08 = 水平線 スイープショート状態
    //   (使用していない MACD/ストキャス/FVG/EMA/水平線他パターン/出来高 状態は触らない)
    if selShortLogic == 1 and useMACDModule and resetMACDStateAfterEntry
        shortMACDStateOk := false
    if selShortLogic == 2 and useLineWZ and resetLineStateAfterEntry
        lineBounceShortStateBar := na
    if selShortLogic == 3
        if useFibWZ and resetFibStateAfterEntry
            shortFibStateOk  := false
            shortFibStateBar := na
        if useLineWZ and resetLineStateAfterEntry
            lineBounceShortStateBar := na
            lineFlipShortStateBar   := na
            lineBreakShortStateBar  := na
            lineSweepShortStateBar  := na
    if selShortLogic == 4 and useVolumeStateWindow and resetVolumeStateAfterEntry
        logic04VolumeShortStateOk  := false
        logic04VolumeShortStateBar := na
    if selShortLogic == 7 and useFibWZ and resetFibStateAfterEntry
        shortFibStateOk  := false
        shortFibStateBar := na
    if selShortLogic == 8 and useLineWZ and resetLineStateAfterEntry
        logic08SweepShortStateBar := na
    // 確定ラベル・アラート・状態処理が完了 → 採用ロジックのショート側 確定barを保存 (同一足の重複防止)
    array.set(lastShortConfBarByLogic, selShortLogic, bar_index)

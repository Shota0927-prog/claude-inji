// ---- 出来高ブレイク WinZone (logic04 専用) ----
grpVolBrk = "出来高ブレイク (logic04)"
breakoutLookback     = input.int(5, "ブレイク参照本数 (直近高値/安値)", minval = 1, group = grpVolBrk)

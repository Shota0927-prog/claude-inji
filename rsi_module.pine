//
// ============================================================
//  RSI 単体モジュール (Indicator版 / オシレーターペイン)
// ============================================================
//  ・RSI関連だけを独立モジュール化。
//  ・後で 環境認識 / フィボ / FVG / 出来高 / EMA / 水平線 /
//    マクロ / Silver / ストキャス と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・request.security / ADX は使わない。
//  パターン:
//   A:70/30反転 B:80/20極端反転 C:50抜け D:張り付き(禁止)
//   E:Regular Div F:Hidden Div G:Trend Zone(環境) H:Slope(勢い)
// ============================================================

//@version=5
indicator(
     title          = "RSI Module",
     shorttitle     = "RSI-M",
     overlay        = false,
     max_bars_back  = 1000
 )

// ============================================================
//  ON/OFF
// ============================================================
grpSw = "ON/OFF"
useRSIModule           = input.bool(true, "RSIモジュール全体",     group = grpSw)
useRSIReversal7030     = input.bool(true, "A: 70/30反転",          group = grpSw)
useRSIExtreme8020      = input.bool(true, "B: 80/20極端反転",      group = grpSw)
useRSIMiddleCross      = input.bool(true, "C: 50ライン抜け",       group = grpSw)
useRSIStickinessFilter = input.bool(true, "D: 張り付き(禁止)",     group = grpSw)
useRSIRegularDivergence= input.bool(true, "E: Regular Divergence", group = grpSw)
useRSIHiddenDivergence = input.bool(true, "F: Hidden Divergence",  group = grpSw)
useRSITrendZone        = input.bool(true, "G: Trend Zone(環境)",   group = grpSw)
useRSISlopeStrength    = input.bool(true, "H: Slope(勢い)",        group = grpSw)

// ============================================================
//  RSI設定 / レベル
// ============================================================
grpRSI = "RSI設定"
rsiLen = input.int(14, "RSI 期間", minval = 1, group = grpRSI)

grpLv = "レベル"
rsiOB         = input.float(70, "OB (70)", group = grpLv)
rsiOS         = input.float(30, "OS (30)", group = grpLv)
rsiExtremeHigh= input.float(80, "Extreme High (80)", group = grpLv)
rsiExtremeLow = input.float(20, "Extreme Low (20)",  group = grpLv)
rsiMiddle     = input.float(50, "Middle (50)", group = grpLv)
trendBullLow  = input.float(40, "Bull Zone Low (40)",  group = grpLv)
trendBullHigh = input.float(80, "Bull Zone High (80)", group = grpLv)
trendBearLow  = input.float(20, "Bear Zone Low (20)",  group = grpLv)
trendBearHigh = input.float(60, "Bear Zone High (60)", group = grpLv)
rangeLow      = input.float(40, "Range Low (40)",  group = grpLv)
rangeHigh     = input.float(60, "Range High (60)", group = grpLv)

// ============================================================
//  A/B: Reversal パラメータ
// ============================================================
grpA = "A/B: Reversal"
useRSISlopeTurn = input.bool(true, "傾き反転で確認", group = grpA)
useRSILevelCross= input.bool(true, "レベル抜けで確認", group = grpA)
rsiReversalLookback = input.int(5, "到達 参照本数", minval = 1, group = grpA)
useRSIOneShot   = input.bool(true, "一回だけ発火", group = grpA)
rsiResetLevelHigh = input.float(60, "High リセットレベル", group = grpA)
rsiResetLevelLow  = input.float(40, "Low リセットレベル",  group = grpA)

// ============================================================
//  D: Stickiness / G: Trend Zone / H: Slope パラメータ
// ============================================================
grpEtc = "D/G/H パラメータ"
stickBars     = input.int(5, "張り付き 本数",     minval = 1, group = grpEtc)
trendZoneBars = input.int(5, "ゾーン滞在 本数",   minval = 1, group = grpEtc)
rsiSlopeMin   = input.float(2.0, "最小スロープ(|ΔRSI|)", minval = 0.0, step = 0.5, group = grpEtc)

// ============================================================
//  E/F: Divergence パラメータ
// ============================================================
grpDiv = "Divergence"
divPivotLen = input.int(5,  "Pivot 長さ",       minval = 1, group = grpDiv)
divLookback = input.int(60, "Pivot 間 最大本数", minval = 1, group = grpDiv)

// ============================================================
//  共通フィルター
// ============================================================
grpFilt = "共通フィルター"
useRSIDirectionFilter = input.bool(false, "RSI傾きフィルター", group = grpFilt)
useRSIMiddleFilter    = input.bool(false, "RSI 50位置フィルター", group = grpFilt)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showRSILabels    = input.bool(true, "シグナルラベル",   group = grpDisp)
showRSIDebugTable= input.bool(true, "デバッグテーブル", group = grpDisp)
showRSIPanePlots = input.bool(true, "RSIライン表示",    group = grpDisp)

// ============================================================
//  RSI 計算
// ============================================================
float rsiValue = ta.rsi(close, rsiLen)
float rsiSlope = rsiValue - rsiValue[1]

bool rAct = useRSIModule

bool slopeUp   = rsiValue > rsiValue[1]
bool slopeDown = rsiValue < rsiValue[1]

// 共通フィルター
f_dirOK(isBuy) =>
    bool d = not useRSIDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool m = not useRSIMiddleFilter or (isBuy ? rsiValue > rsiMiddle : rsiValue < rsiMiddle)
    d and m

// ============================================================
//  H: RSI 角度・勢い
// ============================================================
bool rsiSlopeBull = rsiSlope >=  rsiSlopeMin
bool rsiSlopeBear = rsiSlope <= -rsiSlopeMin
bool slopeBuy  = rAct and useRSISlopeStrength and rsiSlopeBull
bool slopeSell = rAct and useRSISlopeStrength and rsiSlopeBear

// ============================================================
//  A: 70/30 反転 (一回だけ発火)
// ============================================================
bool turnDown70 = (useRSISlopeTurn and slopeDown) or (useRSILevelCross and ta.crossunder(rsiValue, rsiOB))
bool turnUp30   = (useRSISlopeTurn and slopeUp)   or (useRSILevelCross and ta.crossover(rsiValue, rsiOS))

var bool wasRSIHigh       = false
var bool wasRSILow        = false
var bool rsiHighTriggered = false
var bool rsiLowTriggered  = false

if rsiValue >= rsiOB
    wasRSIHigh := true
if rsiValue <= rsiOS
    wasRSILow := true
if rsiValue <= rsiResetLevelHigh
    wasRSIHigh := false
    rsiHighTriggered := false
if rsiValue >= rsiResetLevelLow
    wasRSILow := false
    rsiLowTriggered := false

bool revSell = rAct and useRSIReversal7030 and wasRSIHigh and (not useRSIOneShot or not rsiHighTriggered) and turnDown70 and f_dirOK(false)
bool revBuy  = rAct and useRSIReversal7030 and wasRSILow  and (not useRSIOneShot or not rsiLowTriggered)  and turnUp30   and f_dirOK(true)
if revSell
    rsiHighTriggered := true
if revBuy
    rsiLowTriggered := true
bool rsiSellReversalSignal = revSell
bool rsiBuyReversalSignal  = revBuy

// ============================================================
//  B: 80/20 極端反転 (A より強い過熱反転)
// ============================================================
bool reachedExtHigh = ta.highest(rsiValue, rsiReversalLookback) >= rsiExtremeHigh
bool reachedExtLow  = ta.lowest(rsiValue, rsiReversalLookback)  <= rsiExtremeLow
bool turnDownExt = (useRSISlopeTurn and slopeDown) or (useRSILevelCross and ta.crossunder(rsiValue, rsiExtremeHigh))
bool turnUpExt   = (useRSISlopeTurn and slopeUp)   or (useRSILevelCross and ta.crossover(rsiValue, rsiExtremeLow))

bool exSell = rAct and useRSIExtreme8020 and reachedExtHigh and turnDownExt and f_dirOK(false)
bool exBuy  = rAct and useRSIExtreme8020 and reachedExtLow  and turnUpExt   and f_dirOK(true)
bool rsiSellExtremeSignal = exSell
bool rsiBuyExtremeSignal  = exBuy

// ============================================================
//  C: 50ライン抜け (順張り勢い確認)
// ============================================================
bool midBuy  = rAct and useRSIMiddleCross and ta.crossover(rsiValue, rsiMiddle)  and f_dirOK(true)
bool midSell = rAct and useRSIMiddleCross and ta.crossunder(rsiValue, rsiMiddle) and f_dirOK(false)
bool rsiBuyMiddleCrossSignal  = midBuy
bool rsiSellMiddleCrossSignal = midSell

// ============================================================
//  D: 張り付き (逆張り禁止)
// ============================================================
var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := rsiValue >= rsiOB ? bullStickCount + 1 : 0
bearStickCount := rsiValue <= rsiOS ? bearStickCount + 1 : 0
bool rsiBullSticky = rAct and useRSIStickinessFilter and bullStickCount >= stickBars
bool rsiBearSticky = rAct and useRSIStickinessFilter and bearStickCount >= stickBars
bool rsiNoSell = rsiBullSticky   // 強い上昇中はSELL禁止
bool rsiNoBuy  = rsiBearSticky   // 強い下降中はBUY禁止

// ============================================================
//  E/F: Divergence (pivot ベース)
// ============================================================
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float rsiAtPivot = rsiValue[divPivotLen]

var float phPrev    = na
var float phLast    = na
var float rhPrev    = na
var float rhLast    = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float rlPrev    = na
var float rlLast    = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    rhPrev := rhLast
    phBarPrev := phBarLast
    phLast := pricePH
    rhLast := rsiAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    rlPrev := rlLast
    plBarPrev := plBarLast
    plLast := pricePL
    rlLast := rsiAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

// Regular: 価格HH+RSI LH=SELL / 価格LL+RSI HL=BUY
bool regSell = rAct and useRSIRegularDivergence and newPH and phInRange and phLast > phPrev and rhLast < rhPrev
bool regBuy  = rAct and useRSIRegularDivergence and newPL and plInRange and plLast < plPrev and rlLast > rlPrev
// Hidden: 価格HL(切上げ)+RSI切下げ=BUY / 価格LH(切下げ)+RSI切上げ=SELL
bool hidBuy  = rAct and useRSIHiddenDivergence and newPL and plInRange and plLast > plPrev and rlLast < rlPrev
bool hidSell = rAct and useRSIHiddenDivergence and newPH and phInRange and phLast < phPrev and rhLast > rhPrev

bool rsiSellRegularDivSignal = regSell
bool rsiBuyRegularDivSignal  = regBuy
bool rsiBuyHiddenDivSignal   = hidBuy
bool rsiSellHiddenDivSignal  = hidSell

// ============================================================
//  G: Trend Zone (環境フィルター)
// ============================================================
var int bullZoneCount  = 0
var int bearZoneCount  = 0
var int rangeZoneCount = 0
bullZoneCount  := (rsiValue >= trendBullLow and rsiValue <= trendBullHigh) ? bullZoneCount + 1 : 0
bearZoneCount  := (rsiValue >= trendBearLow and rsiValue <= trendBearHigh) ? bearZoneCount + 1 : 0
rangeZoneCount := (rsiValue >= rangeLow     and rsiValue <= rangeHigh)     ? rangeZoneCount + 1 : 0
bool rsiBullTrendZone = rAct and useRSITrendZone and bullZoneCount  >= trendZoneBars
bool rsiBearTrendZone = rAct and useRSITrendZone and bearZoneCount  >= trendZoneBars
bool rsiRangeZone     = rAct and useRSITrendZone and rangeZoneCount >= trendZoneBars

// ============================================================
//  Signal Type / Direction
//   優先: RegDiv(4) > HidDiv(5) > Extreme(2) > Reversal(1) >
//         Middle(3) > Slope(7) > TrendZone(6)
// ============================================================
bool anyReg   = regBuy or regSell
bool anyHid   = hidBuy or hidSell
bool anyEx    = exBuy or exSell
bool anyRev   = revBuy or revSell
bool anyMid   = midBuy or midSell
bool anySlope = slopeBuy or slopeSell
bool anyZone  = rsiBullTrendZone or rsiBearTrendZone

int rsiSignalType = not rAct ? 0 :
                     anyReg ? 4 :
                     anyHid ? 5 :
                     anyEx  ? 2 :
                     anyRev ? 1 :
                     anyMid ? 3 :
                     anySlope ? 7 :
                     anyZone ? 6 : 0

int rsiDirection = not rAct ? 0 :
                    anyReg ? (regBuy ? 1 : -1) :
                    anyHid ? (hidBuy ? 1 : -1) :
                    anyEx  ? (exBuy ? 1 : -1) :
                    anyRev ? (revBuy ? 1 : -1) :
                    anyMid ? (midBuy ? 1 : -1) :
                    anySlope ? (slopeBuy ? 1 : -1) :
                    anyZone ? (rsiBullTrendZone ? 1 : -1) : 0

// ============================================================
//  Rank
//   1 Middle/Slope /2 Reversal /3 Extreme /4 Divergence /5 Div+Extreme
// ============================================================
bool anyDiv = anyReg or anyHid
int rsiRank = not rAct ? 0 :
               (anyDiv and anyEx) ? 5 :
               anyDiv ? 4 :
               anyEx ? 3 :
               anyRev ? 2 :
               (anyMid or anySlope) ? 1 : 0

// ============================================================
//  接続用出力
// ============================================================
bool allowLongByRSI  = useRSIModule and rsiDirection == 1  and not rsiNoBuy
bool allowShortByRSI = useRSIModule and rsiDirection == -1 and not rsiNoSell
bool rsiNoTrade = rsiNoBuy or rsiNoSell

// ============================================================
//  表示 : レベル / RSI
// ============================================================
hline(rsiExtremeHigh, "Extreme High", color = color.new(color.red, 50), linestyle = hline.style_dotted)
hline(rsiOB,          "OB",           color = color.new(color.red, 70))
hline(rsiMiddle,      "Middle",       color = color.new(color.gray, 50))
hline(rsiOS,          "OS",           color = color.new(color.green, 70))
hline(rsiExtremeLow,  "Extreme Low",  color = color.new(color.green, 50), linestyle = hline.style_dotted)

plot(showRSIPanePlots ? rsiValue : na, "RSI", color = color.new(color.purple, 0), linewidth = 2)

// 張り付き / トレンドゾーン 背景
bgcolor(rsiBullSticky ? color.new(color.green, 85) : rsiBearSticky ? color.new(color.red, 85) : na, title = "Sticky BG")
bgcolor(rsiBullTrendZone ? color.new(color.green, 94) : rsiBearTrendZone ? color.new(color.red, 94) : rsiRangeZone ? color.new(color.gray, 94) : na, title = "Trend Zone BG")

// ============================================================
//  表示 : ラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, rsiValue, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.tiny)

if showRSILabels
    if rsiBuyReversalSignal
        f_mkLabel(true,  "Rev↑", color.new(color.green, 0))
    if rsiSellReversalSignal
        f_mkLabel(false, "Rev↓", color.new(color.red, 0))
    if rsiBuyExtremeSignal
        f_mkLabel(true,  "Ex↑", color.new(color.teal, 0))
    if rsiSellExtremeSignal
        f_mkLabel(false, "Ex↓", color.new(color.maroon, 0))
    if rsiBuyMiddleCrossSignal
        f_mkLabel(true,  "Mid↑", color.new(color.lime, 0))
    if rsiSellMiddleCrossSignal
        f_mkLabel(false, "Mid↓", color.new(color.fuchsia, 0))
    if rsiBuyRegularDivSignal
        f_mkLabel(true,  "Div↑", color.new(color.aqua, 0))
    if rsiSellRegularDivSignal
        f_mkLabel(false, "Div↓", color.new(color.orange, 0))
    if rsiBuyHiddenDivSignal
        f_mkLabel(true,  "HDiv↑", color.new(color.blue, 0))
    if rsiSellHiddenDivSignal
        f_mkLabel(false, "HDiv↓", color.new(color.purple, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "70/30" : t == 2 ? "80/20" : t == 3 ? "Middle" : t == 4 ? "RegDiv" : t == 5 ? "HidDiv" : t == 6 ? "TrendZone" : t == 7 ? "Slope" : "-"
f_zoneStr() =>
    rsiBullTrendZone ? "Bull" : rsiBearTrendZone ? "Bear" : rsiRangeZone ? "Range" : "-"

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if showRSIDebugTable and barstate.islast
    string sDir = rsiDirection == 1 ? "BUY" : rsiDirection == -1 ? "SELL" : "-"
    string sSticky = rsiBullSticky ? "Bull" : rsiBearSticky ? "Bear" : "-"
    table.cell(dbg, 0, 0, "RSI", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, rsiNoTrade ? "NoTrade" : (rsiDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = rsiNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "RSI", text_color = color.white)
    table.cell(dbg, 1, 1, na(rsiValue) ? "-" : str.tostring(rsiValue, "#.#"), text_color = color.white)
    table.cell(dbg, 0, 2, "Slope", text_color = color.white)
    table.cell(dbg, 1, 2, na(rsiSlope) ? "-" : str.tostring(rsiSlope, "#.#"), text_color = color.white)
    table.cell(dbg, 0, 3, "Signal Type", text_color = color.white)
    table.cell(dbg, 1, 3, f_typeStr(rsiSignalType), text_color = color.white)
    table.cell(dbg, 0, 4, "Direction", text_color = color.white)
    table.cell(dbg, 1, 4, sDir, text_color = color.white)
    table.cell(dbg, 0, 5, "Rank", text_color = color.white)
    table.cell(dbg, 1, 5, str.tostring(rsiRank), text_color = color.white)
    table.cell(dbg, 0, 6, "Sticky", text_color = color.white)
    table.cell(dbg, 1, 6, sSticky, text_color = color.white)
    table.cell(dbg, 0, 7, "Trend Zone", text_color = color.white)
    table.cell(dbg, 1, 7, f_zoneStr(), text_color = color.white)
    table.cell(dbg, 0, 8, "NoTrade", text_color = color.white)
    table.cell(dbg, 1, 8, rsiNoTrade ? "Y" : "N", text_color = rsiNoTrade ? color.red : color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(rsiValue, "rsiValue", display = display.data_window)
plot(rsiSlope, "rsiSlope", display = display.data_window)
plot(rsiSignalType, "rsiSignalType", display = display.data_window)
plot(rsiDirection,  "rsiDirection",  display = display.data_window)
plot(rsiRank,       "rsiRank",       display = display.data_window)
plot(rsiBullSticky ? 1 : 0, "rsiBullSticky", display = display.data_window)
plot(rsiBearSticky ? 1 : 0, "rsiBearSticky", display = display.data_window)
plot(rsiNoBuy  ? 1 : 0, "rsiNoBuy",  display = display.data_window)
plot(rsiNoSell ? 1 : 0, "rsiNoSell", display = display.data_window)
plot(rsiNoTrade ? 1 : 0, "rsiNoTrade", display = display.data_window)
plot(rsiBullTrendZone ? 1 : 0, "rsiBullTrendZone", display = display.data_window)
plot(rsiBearTrendZone ? 1 : 0, "rsiBearTrendZone", display = display.data_window)
plot(rsiRangeZone     ? 1 : 0, "rsiRangeZone",     display = display.data_window)
plot(rsiSlopeBull ? 1 : 0, "rsiSlopeBull", display = display.data_window)
plot(rsiSlopeBear ? 1 : 0, "rsiSlopeBear", display = display.data_window)
plot(allowLongByRSI  ? 1 : 0, "allowLongByRSI",  display = display.data_window)
plot(allowShortByRSI ? 1 : 0, "allowShortByRSI", display = display.data_window)
plot(rsiBuyReversalSignal  ? 1 : 0, "rsiBuyReversalSignal",  display = display.data_window)
plot(rsiSellReversalSignal ? 1 : 0, "rsiSellReversalSignal", display = display.data_window)
plot(rsiBuyExtremeSignal  ? 1 : 0, "rsiBuyExtremeSignal",  display = display.data_window)
plot(rsiSellExtremeSignal ? 1 : 0, "rsiSellExtremeSignal", display = display.data_window)
plot(rsiBuyMiddleCrossSignal  ? 1 : 0, "rsiBuyMiddleCrossSignal",  display = display.data_window)
plot(rsiSellMiddleCrossSignal ? 1 : 0, "rsiSellMiddleCrossSignal", display = display.data_window)
plot(rsiBuyRegularDivSignal  ? 1 : 0, "rsiBuyRegularDivSignal",  display = display.data_window)
plot(rsiSellRegularDivSignal ? 1 : 0, "rsiSellRegularDivSignal", display = display.data_window)
plot(rsiBuyHiddenDivSignal   ? 1 : 0, "rsiBuyHiddenDivSignal",   display = display.data_window)
plot(rsiSellHiddenDivSignal  ? 1 : 0, "rsiSellHiddenDivSignal",  display = display.data_window)

// ============================================================
//  アラート
// ============================================================
alertcondition(rsiBuyReversalSignal,  "RSI BUY 70/30",  "{{ticker}} RSI 70/30反転 BUY")
alertcondition(rsiSellReversalSignal, "RSI SELL 70/30", "{{ticker}} RSI 70/30反転 SELL")
alertcondition(rsiBuyExtremeSignal,  "RSI BUY 80/20",  "{{ticker}} RSI 80/20極端反転 BUY")
alertcondition(rsiSellExtremeSignal, "RSI SELL 80/20", "{{ticker}} RSI 80/20極端反転 SELL")
alertcondition(rsiBuyMiddleCrossSignal,  "RSI BUY Middle",  "{{ticker}} RSI 50抜け BUY")
alertcondition(rsiSellMiddleCrossSignal, "RSI SELL Middle", "{{ticker}} RSI 50抜け SELL")
alertcondition(rsiBuyRegularDivSignal,  "RSI BUY RegDiv",  "{{ticker}} RSI Regular Div BUY")
alertcondition(rsiSellRegularDivSignal, "RSI SELL RegDiv", "{{ticker}} RSI Regular Div SELL")
alertcondition(rsiBuyHiddenDivSignal,  "RSI BUY HidDiv",  "{{ticker}} RSI Hidden Div BUY")
alertcondition(rsiSellHiddenDivSignal, "RSI SELL HidDiv", "{{ticker}} RSI Hidden Div SELL")
alertcondition(allowLongByRSI,  "Allow Long RSI",  "{{ticker}} RSI ロング許可")
alertcondition(allowShortByRSI, "Allow Short RSI", "{{ticker}} RSI ショート許可")
alertcondition(rsiNoTrade,      "RSI NoTrade",     "{{ticker}} RSI ノートレード")

// ============================================================
//  水平線 単体モジュール (Support / Resistance / Indicator版)
// ============================================================
//  ・水平線(レジサポ)関連だけを独立モジュール化。
//  ・後で 環境認識 / フィボ / FVG / 出来高 / EMA と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  検出: ①Pivot ②複数回反応 ③前日H/L ④セッションH/L
//  役割: A:反発 / B:レジサポ転換 / C:ブレイク / D:スイープ / E:障害物
//  ※ レンジ判定はこのモジュールでは行わない(環境認識モジュール担当)。
// ============================================================

//@version=5
indicator(
     title          = "S/R Line Module",
     shorttitle     = "SRLINE",
     overlay        = true,
     max_bars_back  = 1000,
     max_boxes_count  = 50,
     max_lines_count  = 50,
     max_labels_count = 500
 )

// ============================================================
//  検出ソース ON/OFF
// ============================================================
grpSrc = "検出ソース"
usePivotLine    = input.bool(true,  "① Pivot High/Low",   group = grpSrc)
useReactionLine = input.bool(true,  "② 複数回反応価格帯",  group = grpSrc)
usePreviousDayHL= input.bool(true,  "③ 前日 高値/安値",   group = grpSrc)
useSessionHL    = input.bool(true,  "④ セッション 高値/安値", group = grpSrc)

// ============================================================
//  パターン ON/OFF
// ============================================================
grpPat = "パターン ON/OFF"
useBounce = input.bool(true, "A: 反発",        group = grpPat)
useFlip   = input.bool(true, "B: レジサポ転換", group = grpPat)
useBreak  = input.bool(true, "C: ブレイク",     group = grpPat)
useSweep  = input.bool(true, "D: スイープ反転", group = grpPat)

// ============================================================
//  パラメータ
// ============================================================
grpParam = "パラメータ"
atrLen   = input.int(14, "ATR期間", minval = 1, group = grpParam)
maxLines = input.int(20, "水平線 最大保持数", minval = 1, group = grpParam)

// ① Pivot
pivotLen = input.int(10, "Pivot Length", minval = 1, group = grpParam)

// ② 反応
reactionLookback     = input.int(300, "反応 参照本数", minval = 1, group = grpParam)
reactionToleranceATR = input.float(0.3, "反応 許容幅(ATR倍率)", minval = 0.0, step = 0.05, group = grpParam)
reactionMinTouches   = input.int(2, "反応 最小タッチ数", minval = 2, group = grpParam)

// ============================================================
//  水平線ゾーン
// ============================================================
grpZone = "水平線ゾーン"
useATRZone     = input.bool(true,  "ゾーン幅をATR連動にする", group = grpZone)
zoneATRMult    = input.float(0.25, "ゾーン幅 (ATR倍率)", minval = 0.0, step = 0.05, group = grpZone)
zoneFixedWidth = input.float(0.0,  "ゾーン幅 (固定/価格)", minval = 0.0, step = 0.1, group = grpZone)

// 近い水平線を1本のゾーンに統合
useLineMergeZone = input.bool(true,  "近い水平線をゾーン統合する", group = grpZone)
mergeUseATR      = input.bool(true,  "統合許容幅をATR連動にする",   group = grpZone)
mergeToleranceATR= input.float(0.5,  "統合許容幅 (ATR倍率)", minval = 0.0, step = 0.05, group = grpZone)
mergeFixedWidth  = input.float(0.0,  "統合許容幅 (固定/価格)", minval = 0.0, step = 0.1, group = grpZone)

// ============================================================
//  パターン別 パラメータ
// ============================================================
grpB = "B: レジサポ転換"
flipLookback    = input.int(30, "転換 参照本数", minval = 1, group = grpB)
flipConfirmBars = input.int(2,  "転換 確定本数", minval = 0, group = grpB)

grpC = "C: ブレイク"
useBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター", group = grpC)
breakBodyRatio     = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpC)

grpD = "D: スイープ"
sweepToleranceATR = input.float(0.2, "スイープ 最小貫通(ATR倍率)", minval = 0.0, step = 0.05, group = grpD)

// ============================================================
//  障害物フィルター
// ============================================================
grpObs = "障害物フィルター"
useLineObstacleFilter = input.bool(false, "水平線障害物フィルターを使う", group = grpObs)
obstacleATR = input.float(0.5, "障害物 近接(ATR倍率)", minval = 0.0, step = 0.05, group = grpObs)

// ============================================================
//  共通フィルター
// ============================================================
grpFilt = "共通フィルター"
useDirCandleFilter = input.bool(true,  "方向ローソク",   group = grpFilt)
useWickFilter      = input.bool(false, "ヒゲ確認",       group = grpFilt)
useBodyFilter      = input.bool(false, "実体率",         group = grpFilt)
useATRFilter       = input.bool(false, "ATR(値幅)",      group = grpFilt)
bodyRatioMin       = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFilt)
atrMinMult         = input.float(0.5, "最小値幅 (ATR倍率)", minval = 0.0, step = 0.05, group = grpFilt)

// ============================================================
//  セッション
// ============================================================
grpSess = "セッション"
sessTZ   = input.string("GMT", "セッション タイムゾーン", group = grpSess)
asiaSess = input.session("0000-0800", "Asia",   group = grpSess)
londonSess = input.session("0700-1600", "London", group = grpSess)
nySess   = input.session("1200-2100", "New York", group = grpSess)

// ============================================================
//  表示
// ============================================================
grpDisp = "表示"
showLines      = input.bool(true, "水平線を表示",       group = grpDisp)
showZones      = input.bool(true, "ゾーンを表示",       group = grpDisp)
showLabels     = input.bool(true, "シグナルラベルを表示", group = grpDisp)
showDebugTable = input.bool(true, "デバッグテーブルを表示", group = grpDisp)
lineDrawBars   = input.int(200, "水平線 描画本数(右からの長さ)", minval = 10, group = grpDisp)
colSupport     = input.color(color.new(color.green, 0), "Support 色(現在使用中)", group = grpDisp)
colResistance  = input.color(color.new(color.red,   0), "Resistance 色(現在使用中)", group = grpDisp)

// ============================================================
//  基礎計算
// ============================================================
float atr    = ta.atr(atrLen)
float rng    = high - low
float body   = math.abs(close - open)
float upWick = high - math.max(close, open)
float dnWick = math.min(close, open) - low
float clPos  = rng > 0 ? (close - low) / rng : 0.5
float bodyRatio = rng > 0 ? body / rng : 0.0

float zoneW = useATRZone ? atr * zoneATRMult : zoneFixedWidth

// ============================================================
//  共通フィルター
// ============================================================
f_commonOK(isBuy) =>
    bool ok = true
    if useDirCandleFilter
        ok := ok and (isBuy ? close > open : close < open)
    if useWickFilter
        ok := ok and (isBuy ? dnWick >= body : upWick >= body)
    if useBodyFilter
        ok := ok and bodyRatio >= bodyRatioMin
    if useATRFilter
        ok := ok and rng >= atr * atrMinMult
    ok

// ============================================================
//  統合水平線ゾーン (全ソースを1つの配列にマージ保持)
//   各ゾーン: 価格 / タッチ数 / 生成バー / 最終更新バー /
//             ソース有無(Pivot, 前日, セッション)
//   ・近い水平線は mergeTolerance 以内なら1ゾーンに統合。
//   ・統合時: 価格=加重平均, touches加算, ソースOR, 複数ソース→strength5
//   ・各ゾーンは createdBar 以降のみ判定に使用。
// ============================================================
var array<float> zPrice   = array.new_float()
var array<int>   zTouch   = array.new_int()
var array<int>   zCreated = array.new_int()
var array<int>   zLast    = array.new_int()
var array<bool>  zPivot   = array.new_bool()
var array<bool>  zPrev    = array.new_bool()
var array<bool>  zSess    = array.new_bool()

// 統合許容幅
float mergeTol = useLineMergeZone ? (mergeUseATR ? atr * mergeToleranceATR : mergeFixedWidth) : atr * reactionToleranceATR

// ゾーンへ追加/統合 (srcPivot/srcPrev/srcSess のいずれか1つを true で渡す)
f_addZone(p, srcPivot, srcPrev, srcSess) =>
    bool found = false
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not found and math.abs(array.get(zPrice, i) - p) <= mergeTol
                int oldT = array.get(zTouch, i)
                int newT = oldT + 1
                array.set(zPrice, i, (array.get(zPrice, i) * oldT + p) / newT)
                array.set(zTouch, i, newT)
                array.set(zLast,  i, bar_index)
                array.set(zPivot, i, array.get(zPivot, i) or srcPivot)
                array.set(zPrev,  i, array.get(zPrev,  i) or srcPrev)
                array.set(zSess,  i, array.get(zSess,  i) or srcSess)
                found := true
    if not found
        array.push(zPrice, p)
        array.push(zTouch, 1)
        array.push(zCreated, bar_index)
        array.push(zLast, bar_index)
        array.push(zPivot, srcPivot)
        array.push(zPrev,  srcPrev)
        array.push(zSess,  srcSess)
        if array.size(zPrice) > maxLines
            array.shift(zPrice)
            array.shift(zTouch)
            array.shift(zCreated)
            array.shift(zLast)
            array.shift(zPivot)
            array.shift(zPrev)
            array.shift(zSess)

// strength: 1=Pivotのみ / 2=複数反応 / 3=前日 / 4=セッション / 5=複数ソース重合
f_zoneStrength(isPivot, isPrev, isSess, touches) =>
    int srcCount = (isPivot ? 1 : 0) + (isPrev ? 1 : 0) + (isSess ? 1 : 0)
    srcCount >= 2 ? 5 : isSess ? 4 : isPrev ? 3 : (useReactionLine and touches >= reactionMinTouches) ? 2 : 1

// ① Pivot High/Low → ゾーン (確定足で追加 = createdBar 以降のみ有効)
float ph = ta.pivothigh(pivotLen, pivotLen)
float pl = ta.pivotlow(pivotLen, pivotLen)
if usePivotLine or useReactionLine
    if not na(ph)
        f_addZone(ph, true, false, false)
    if not na(pl)
        f_addZone(pl, true, false, false)

// ============================================================
//  ③ 前日 高値/安値 (日替わりで確定 → ゾーン追加)
// ============================================================
var float curDayHigh = na
var float curDayLow  = na
var float prevHigh   = na
var float prevLow    = na
bool newDay = ta.change(time("D")) != 0
if newDay
    prevHigh := curDayHigh
    prevLow  := curDayLow
    curDayHigh := high
    curDayLow  := low
    if usePreviousDayHL and not na(prevHigh)
        f_addZone(prevHigh, false, true, false)
    if usePreviousDayHL and not na(prevLow)
        f_addZone(prevLow, false, true, false)
else
    curDayHigh := na(curDayHigh) ? high : math.max(curDayHigh, high)
    curDayLow  := na(curDayLow)  ? low  : math.min(curDayLow, low)

// ============================================================
//  ④ セッション 高値/安値 (セッション終了で確定 → ゾーン追加)
// ============================================================
f_session(sessStr, prevHi, prevLo) =>
    bool inSess  = not na(time(timeframe.period, sessStr, sessTZ))
    bool started = inSess and not inSess[1]
    bool ended   = not inSess and inSess[1]
    float hi = prevHi
    float lo = prevLo
    if started
        hi := high
        lo := low
    else if inSess
        hi := na(prevHi) ? high : math.max(prevHi, high)
        lo := na(prevLo) ? low  : math.min(prevLo, low)
    [hi, lo, ended]

var float asiaHigh   = na
var float asiaLow    = na
var float londonHigh = na
var float londonLow  = na
var float nyHigh     = na
var float nyLow      = na
[aH, aL, aEnd] = f_session(asiaSess, asiaHigh, asiaLow)
asiaHigh := aH
asiaLow  := aL
[lH, lL, lEnd] = f_session(londonSess, londonHigh, londonLow)
londonHigh := lH
londonLow  := lL
[nH, nL, nEnd] = f_session(nySess, nyHigh, nyLow)
nyHigh := nH
nyLow  := nL
if useSessionHL
    if aEnd and not na(asiaHigh)
        f_addZone(asiaHigh, false, false, true)
    if aEnd and not na(asiaLow)
        f_addZone(asiaLow, false, false, true)
    if lEnd and not na(londonHigh)
        f_addZone(londonHigh, false, false, true)
    if lEnd and not na(londonLow)
        f_addZone(londonLow, false, false, true)
    if nEnd and not na(nyHigh)
        f_addZone(nyHigh, false, false, true)
    if nEnd and not na(nyLow)
        f_addZone(nyLow, false, false, true)

// ============================================================
//  最近接 Support(<=close) / Resistance(>=close)
//   ※ createdBar 以降のゾーンのみ採用 (bar_index >= createdBar)
// ============================================================
float nearestSupport    = na
float nearestResistance = na
int   nsStrength = 0
int   nrStrength = 0
int   nsTouch = 0
int   nrTouch = 0
int   nsCreated = na
int   nrCreated = na
bool  nsPivot = false
bool  nsPrev  = false
bool  nsSess  = false
bool  nrPivot = false
bool  nrPrev  = false
bool  nrSess  = false
if array.size(zPrice) > 0
    for i = 0 to array.size(zPrice) - 1
        if bar_index >= array.get(zCreated, i)
            float pr = array.get(zPrice, i)
            int   tc = array.get(zTouch, i)
            bool  ip = array.get(zPivot, i)
            bool  ipr= array.get(zPrev, i)
            bool  iss= array.get(zSess, i)
            int   st = f_zoneStrength(ip, ipr, iss, tc)
            if pr <= close
                if na(nearestSupport) or pr > nearestSupport
                    nearestSupport := pr
                    nsStrength := st
                    nsTouch := tc
                    nsCreated := array.get(zCreated, i)
                    nsPivot := ip
                    nsPrev := ipr
                    nsSess := iss
            if pr >= close
                if na(nearestResistance) or pr < nearestResistance
                    nearestResistance := pr
                    nrStrength := st
                    nrTouch := tc
                    nrCreated := array.get(zCreated, i)
                    nrPivot := ip
                    nrPrev := ipr
                    nrSess := iss

float supportDistanceATR    = (not na(nearestSupport) and atr > 0)    ? (close - nearestSupport) / atr : na
float resistanceDistanceATR = (not na(nearestResistance) and atr > 0) ? (nearestResistance - close) / atr : na

// ゾーン上下端
float supZoneTop = nearestSupport + zoneW
float supZoneBot = nearestSupport - zoneW
float resZoneTop = nearestResistance + zoneW
float resZoneBot = nearestResistance - zoneW

// 各ゾーンが「生成済み」で判定に使えるか (createdBar 以降)
bool supUsable = not na(nearestSupport)    and not na(nsCreated) and bar_index >= nsCreated
bool resUsable = not na(nearestResistance) and not na(nrCreated) and bar_index >= nrCreated

// ============================================================
//  A: 反発
// ============================================================
bool buyBounceCore  = useBounce and supUsable and low  <= supZoneTop and close > nearestSupport    and f_commonOK(true)
bool sellBounceCore = useBounce and resUsable and high >= resZoneBot and close < nearestResistance and f_commonOK(false)
bool lineBuyBounceSignal  = buyBounceCore
bool lineSellBounceSignal = sellBounceCore

// ============================================================
//  B: レジサポ転換 (Flip)
//   Resistance突破→戻り→Support化=BUY / Support割れ→戻り→Resistance化=SELL
// ============================================================
var float flipResLevel = na
var int   flipResBar   = na
var float flipSupLevel = na
var int   flipSupBar   = na

// 直近レジスタンスを終値で上抜け → そのレベルを転換候補(将来サポート)に
if resUsable and not na(nearestResistance[1]) and close > nearestResistance[1] and close[1] <= nearestResistance[1]
    flipResLevel := nearestResistance[1]
    flipResBar   := bar_index
// 直近サポートを終値で下抜け → そのレベルを転換候補(将来レジスタンス)に
if supUsable and not na(nearestSupport[1]) and close < nearestSupport[1] and close[1] >= nearestSupport[1]
    flipSupLevel := nearestSupport[1]
    flipSupBar   := bar_index

bool buyFlipCore = useFlip and not na(flipResLevel) and (bar_index - flipResBar) >= flipConfirmBars and (bar_index - flipResBar) <= flipLookback and low <= flipResLevel + zoneW and close > flipResLevel and f_commonOK(true)
bool sellFlipCore = useFlip and not na(flipSupLevel) and (bar_index - flipSupBar) >= flipConfirmBars and (bar_index - flipSupBar) <= flipLookback and high >= flipSupLevel - zoneW and close < flipSupLevel and f_commonOK(false)

bool lineBuyFlipSignal  = buyFlipCore
bool lineSellFlipSignal = sellFlipCore
// 使い切り (再発火防止)
if lineBuyFlipSignal
    flipResLevel := na
if lineSellFlipSignal
    flipSupLevel := na

// ============================================================
//  C: ブレイク
// ============================================================
bool breakBodyOK = not useBreakBodyFilter or bodyRatio >= breakBodyRatio
bool buyBreakCore  = useBreak and resUsable and not na(nearestResistance[1]) and close > nearestResistance[1] and close[1] <= nearestResistance[1] and breakBodyOK
bool sellBreakCore = useBreak and supUsable and not na(nearestSupport[1])    and close < nearestSupport[1]    and close[1] >= nearestSupport[1]    and breakBodyOK
bool lineBuyBreakSignal  = buyBreakCore
bool lineSellBreakSignal = sellBreakCore

// ============================================================
//  D: スイープ反転
//   Supportを一瞬割って終値で戻る=BUY / Resistanceを一瞬抜いて戻る=SELL
// ============================================================
float sweepTol = atr * sweepToleranceATR
bool buySweepCore  = useSweep and supUsable and (nearestSupport - low)     >= sweepTol and close > nearestSupport    and f_commonOK(true)
bool sellSweepCore = useSweep and resUsable and (high - nearestResistance) >= sweepTol and close < nearestResistance and f_commonOK(false)
bool lineBuySweepSignal  = buySweepCore
bool lineSellSweepSignal = sellSweepCore

// ============================================================
//  E: 障害物フィルター
// ============================================================
bool lineObstacleAbove = not na(nearestResistance) and (nearestResistance - close) <= atr * obstacleATR
bool lineObstacleBelow = not na(nearestSupport)    and (close - nearestSupport)    <= atr * obstacleATR
bool allowEntryByLine  = not lineObstacleAbove and not lineObstacleBelow

// ============================================================
//  統合 (優先順位: Sweep > Break > Flip > Bounce)
// ============================================================
int lineSignalType = (lineBuySweepSignal or lineSellSweepSignal) ? 4 :
                      (lineBuyBreakSignal or lineSellBreakSignal) ? 3 :
                      (lineBuyFlipSignal  or lineSellFlipSignal)  ? 2 :
                      (lineBuyBounceSignal or lineSellBounceSignal) ? 1 : 0

int lineDirection = lineSignalType == 4 ? (lineBuySweepSignal  ? 1 : -1) :
                     lineSignalType == 3 ? (lineBuyBreakSignal  ? 1 : -1) :
                     lineSignalType == 2 ? (lineBuyFlipSignal   ? 1 : -1) :
                     lineSignalType == 1 ? (lineBuyBounceSignal ? 1 : -1) : 0

bool lineSignal = lineSignalType != 0

// 接続用 (障害物で禁止)
bool allowEntryLongByLine  = lineSignal and lineDirection == 1  and (not useLineObstacleFilter or not lineObstacleAbove)
bool allowEntryShortByLine = lineSignal and lineDirection == -1 and (not useLineObstacleFilter or not lineObstacleBelow)

// 水平線の強さ (シグナル方向側のレベル強度)
int lineStrength = lineDirection == 1 ? nsStrength : lineDirection == -1 ? nrStrength : math.max(nsStrength, nrStrength)

// ============================================================
//  表示 : 強さ(strength)に応じた色・太さ
//   1=Pivotのみ:グレー/細  2=複数反応:水色/通常  3=前日:黄/通常
//   4=セッション:オレンジ/太  5=複数重合:赤/太
// ============================================================
f_strengthColor(s) =>
    s >= 5 ? color.red : s == 4 ? color.orange : s == 3 ? color.yellow : s == 2 ? color.aqua : color.gray

f_strengthWidth(s) =>
    s >= 4 ? 3 : s >= 2 ? 2 : 1

// ============================================================
//  表示 : 現在判定に使っている水平線を line / box で描画
//   ・Support = 緑 / Resistance = 赤 (一目で基準が分かる)
//   ・strength は線の太さ(box枠の太さ)で表現
//   ・毎バー、現在の最近接 S/R に追従して更新 (1本ずつ)
// ============================================================
var line supLine = na
var line resLine = na
var box  supBox  = na
var box  resBox  = na

// 描画左端 (createdBar以降、かつ右から lineDrawBars 本以内に収めて確実に表示)
int supLeft = math.max(math.max(0, nsCreated), bar_index - lineDrawBars)
int resLeft = math.max(math.max(0, nrCreated), bar_index - lineDrawBars)

if showLines and supUsable
    int sw = math.max(2, f_strengthWidth(nsStrength))
    if na(supLine)
        supLine := line.new(supLeft, nearestSupport, bar_index, nearestSupport, color = colSupport, width = sw)
    else
        line.set_xy1(supLine, supLeft, nearestSupport)
        line.set_xy2(supLine, bar_index, nearestSupport)
        line.set_color(supLine, colSupport)
        line.set_width(supLine, sw)
if showLines and resUsable
    int rw = math.max(2, f_strengthWidth(nrStrength))
    if na(resLine)
        resLine := line.new(resLeft, nearestResistance, bar_index, nearestResistance, color = colResistance, width = rw)
    else
        line.set_xy1(resLine, resLeft, nearestResistance)
        line.set_xy2(resLine, bar_index, nearestResistance)
        line.set_color(resLine, colResistance)
        line.set_width(resLine, rw)

if showZones and supUsable
    if na(supBox)
        supBox := box.new(supLeft, supZoneTop, bar_index, supZoneBot, border_color = colSupport, bgcolor = color.new(colSupport, 80), border_width = 1)
    else
        box.set_lefttop(supBox, supLeft, supZoneTop)
        box.set_rightbottom(supBox, bar_index, supZoneBot)
        box.set_border_color(supBox, colSupport)
        box.set_bgcolor(supBox, color.new(colSupport, 80))
if showZones and resUsable
    if na(resBox)
        resBox := box.new(resLeft, resZoneTop, bar_index, resZoneBot, border_color = colResistance, bgcolor = color.new(colResistance, 80), border_width = 1)
    else
        box.set_lefttop(resBox, resLeft, resZoneTop)
        box.set_rightbottom(resBox, bar_index, resZoneBot)
        box.set_border_color(resBox, colResistance)
        box.set_bgcolor(resBox, color.new(colResistance, 80))

// ============================================================
//  表示 : シグナルラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, isBuy ? low : high, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, yloc = isBuy ? yloc.belowbar : yloc.abovebar, size = size.small)

if showLabels
    if lineBuyBounceSignal
        f_mkLabel(true,  "Bounce↑", color.new(color.green, 0))
    if lineSellBounceSignal
        f_mkLabel(false, "Bounce↓", color.new(color.red, 0))
    if lineBuyFlipSignal
        f_mkLabel(true,  "Flip↑", color.new(color.teal, 0))
    if lineSellFlipSignal
        f_mkLabel(false, "Flip↓", color.new(color.maroon, 0))
    if lineBuyBreakSignal
        f_mkLabel(true,  "Break↑", color.new(color.lime, 0))
    if lineSellBreakSignal
        f_mkLabel(false, "Break↓", color.new(color.fuchsia, 0))
    if lineBuySweepSignal
        f_mkLabel(true,  "Sweep↑", color.new(color.aqua, 0))
    if lineSellSweepSignal
        f_mkLabel(false, "Sweep↓", color.new(color.orange, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_srcStr(isPivot, isPrev, isSess) =>
    string s = (isPivot ? "Piv " : "") + (isPrev ? "Prev " : "") + (isSess ? "Sess" : "")
    s == "" ? "-" : s

var table dbg = table.new(position.top_right, 2, 13, border_width = 1)
if showDebugTable and barstate.islast
    string sType = lineSignalType == 1 ? "Bounce" : lineSignalType == 2 ? "Flip" : lineSignalType == 3 ? "Break" : lineSignalType == 4 ? "Sweep" : "-"
    string sDir  = lineDirection == 1 ? "BUY" : lineDirection == -1 ? "SELL" : "-"
    color scol = f_strengthColor(nsStrength)
    color rcol = f_strengthColor(nrStrength)
    table.cell(dbg, 0, 0, "S/R Line",  text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, lineSignal ? "SIGNAL" : "-", text_color = color.white, bgcolor = color.new(color.blue, 0))
    // Support 側
    table.cell(dbg, 0, 1, "Nearest Support", text_color = color.white)
    table.cell(dbg, 1, 1, na(nearestSupport) ? "-" : str.tostring(nearestSupport, format.mintick), text_color = color.white, bgcolor = supUsable ? colSupport : color.new(color.gray, 70))
    table.cell(dbg, 0, 2, "Sup Strength", text_color = color.white)
    table.cell(dbg, 1, 2, supUsable ? str.tostring(nsStrength) : "-", text_color = color.black, bgcolor = supUsable ? scol : color.new(color.gray, 70))
    table.cell(dbg, 0, 3, "Sup Source", text_color = color.white)
    table.cell(dbg, 1, 3, supUsable ? f_srcStr(nsPivot, nsPrev, nsSess) : "-", text_color = color.white)
    table.cell(dbg, 0, 4, "Sup Created Bar", text_color = color.white)
    table.cell(dbg, 1, 4, na(nsCreated) ? "-" : str.tostring(nsCreated), text_color = color.white)
    table.cell(dbg, 0, 5, "Sup Touches", text_color = color.white)
    table.cell(dbg, 1, 5, supUsable ? str.tostring(nsTouch) : "-", text_color = color.white)
    // Resistance 側
    table.cell(dbg, 0, 6, "Nearest Resistance", text_color = color.white)
    table.cell(dbg, 1, 6, na(nearestResistance) ? "-" : str.tostring(nearestResistance, format.mintick), text_color = color.white, bgcolor = resUsable ? colResistance : color.new(color.gray, 70))
    table.cell(dbg, 0, 7, "Res Strength", text_color = color.white)
    table.cell(dbg, 1, 7, resUsable ? str.tostring(nrStrength) : "-", text_color = color.black, bgcolor = resUsable ? rcol : color.new(color.gray, 70))
    table.cell(dbg, 0, 8, "Res Source", text_color = color.white)
    table.cell(dbg, 1, 8, resUsable ? f_srcStr(nrPivot, nrPrev, nrSess) : "-", text_color = color.white)
    table.cell(dbg, 0, 9, "Res Created Bar", text_color = color.white)
    table.cell(dbg, 1, 9, na(nrCreated) ? "-" : str.tostring(nrCreated), text_color = color.white)
    table.cell(dbg, 0, 10, "Res Touches", text_color = color.white)
    table.cell(dbg, 1, 10, resUsable ? str.tostring(nrTouch) : "-", text_color = color.white)
    // シグナル
    table.cell(dbg, 0, 11, "Signal", text_color = color.white)
    table.cell(dbg, 1, 11, sType, text_color = color.white)
    table.cell(dbg, 0, 12, "Direction", text_color = color.white)
    table.cell(dbg, 1, 12, sDir, text_color = color.white)

// ============================================================
//  プロット (接続用 : Data Window)
// ============================================================
plot(nearestSupport,         "nearestSupport",         display = display.data_window)
plot(nearestResistance,      "nearestResistance",      display = display.data_window)
plot(supportDistanceATR,     "supportDistanceATR",     display = display.data_window)
plot(resistanceDistanceATR,  "resistanceDistanceATR",  display = display.data_window)
plot(lineSignal ? 1 : 0,     "lineSignal",             display = display.data_window)
plot(lineDirection,          "lineDirection",          display = display.data_window)
plot(lineSignalType,         "lineSignalType",         display = display.data_window)
plot(lineStrength,           "lineStrength",           display = display.data_window)
plot(nsStrength,             "supportStrength",        display = display.data_window)
plot(nrStrength,             "resistanceStrength",     display = display.data_window)
plot(na(nsCreated) ? na : nsCreated, "supportCreatedBar",    display = display.data_window)
plot(na(nrCreated) ? na : nrCreated, "resistanceCreatedBar", display = display.data_window)
plot(nsTouch,                "supportTouchCount",      display = display.data_window)
plot(nrTouch,                "resistanceTouchCount",   display = display.data_window)
plot(allowEntryLongByLine  ? 1 : 0, "allowEntryLongByLine",  display = display.data_window)
plot(allowEntryShortByLine ? 1 : 0, "allowEntryShortByLine", display = display.data_window)
plot(allowEntryByLine ? 1 : 0,      "allowEntryByLine",      display = display.data_window)
plot(lineObstacleAbove ? 1 : 0,     "lineObstacleAbove",     display = display.data_window)
plot(lineObstacleBelow ? 1 : 0,     "lineObstacleBelow",     display = display.data_window)

plot(lineBuyBounceSignal  ? 1 : 0, "lineBuyBounceSignal",  display = display.data_window)
plot(lineSellBounceSignal ? 1 : 0, "lineSellBounceSignal", display = display.data_window)
plot(lineBuyFlipSignal    ? 1 : 0, "lineBuyFlipSignal",    display = display.data_window)
plot(lineSellFlipSignal   ? 1 : 0, "lineSellFlipSignal",   display = display.data_window)
plot(lineBuyBreakSignal   ? 1 : 0, "lineBuyBreakSignal",   display = display.data_window)
plot(lineSellBreakSignal  ? 1 : 0, "lineSellBreakSignal",  display = display.data_window)
plot(lineBuySweepSignal   ? 1 : 0, "lineBuySweepSignal",   display = display.data_window)
plot(lineSellSweepSignal  ? 1 : 0, "lineSellSweepSignal",  display = display.data_window)

// Session H/L (Data Window)
plot(prevHigh,   "prevHigh",   display = display.data_window)
plot(prevLow,    "prevLow",    display = display.data_window)
plot(asiaHigh,   "asiaHigh",   display = display.data_window)
plot(asiaLow,    "asiaLow",    display = display.data_window)
plot(londonHigh, "londonHigh", display = display.data_window)
plot(londonLow,  "londonLow",  display = display.data_window)
plot(nyHigh,     "nyHigh",     display = display.data_window)
plot(nyLow,      "nyLow",      display = display.data_window)

// ============================================================
//  シグナル形状
// ============================================================
plotshape(lineBuyBounceSignal,  title = "BUY Bounce",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0),   size = size.tiny)
plotshape(lineSellBounceSignal, title = "SELL Bounce", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),     size = size.tiny)
plotshape(lineBuyFlipSignal,    title = "BUY Flip",    style = shape.circle,       location = location.belowbar, color = color.new(color.teal, 0),    size = size.tiny)
plotshape(lineSellFlipSignal,   title = "SELL Flip",   style = shape.circle,       location = location.abovebar, color = color.new(color.maroon, 0),  size = size.tiny)
plotshape(lineBuyBreakSignal,   title = "BUY Break",   style = shape.diamond,      location = location.belowbar, color = color.new(color.lime, 0),    size = size.tiny)
plotshape(lineSellBreakSignal,  title = "SELL Break",  style = shape.diamond,      location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)
plotshape(lineBuySweepSignal,   title = "BUY Sweep",   style = shape.flag,         location = location.belowbar, color = color.new(color.aqua, 0),    size = size.tiny)
plotshape(lineSellSweepSignal,  title = "SELL Sweep",  style = shape.flag,         location = location.abovebar, color = color.new(color.orange, 0),  size = size.tiny)

// ============================================================
//  アラート
// ============================================================
alertcondition(lineBuyBounceSignal,  "BUY Bounce",  "{{ticker}} 水平線反発BUY ({{close}})")
alertcondition(lineSellBounceSignal, "SELL Bounce", "{{ticker}} 水平線反落SELL ({{close}})")
alertcondition(lineBuyFlipSignal,    "BUY Flip",    "{{ticker}} レジサポ転換BUY ({{close}})")
alertcondition(lineSellFlipSignal,   "SELL Flip",   "{{ticker}} レジサポ転換SELL ({{close}})")
alertcondition(lineBuyBreakSignal,   "BUY Break",   "{{ticker}} 水平線ブレイクBUY ({{close}})")
alertcondition(lineSellBreakSignal,  "SELL Break",  "{{ticker}} 水平線ブレイクSELL ({{close}})")
alertcondition(lineBuySweepSignal,   "BUY Sweep",   "{{ticker}} スイープ反転BUY ({{close}})")
alertcondition(lineSellSweepSignal,  "SELL Sweep",  "{{ticker}} スイープ反転SELL ({{close}})")
alertcondition(allowEntryLongByLine,  "Allow Long (Line)",  "{{ticker}} 水平線ロング許可 ({{close}})")
alertcondition(allowEntryShortByLine, "Allow Short (Line)", "{{ticker}} 水平線ショート許可 ({{close}})")

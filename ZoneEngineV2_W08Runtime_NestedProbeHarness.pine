//@version=6
// ============================================================
// ZoneEngineV2_W08Runtime_NestedProbeHarness - W08 B15-B1 nested CoreRegistryStore cross-library probe
//
// Builds a scratch W08Core.W08Store (W08Core.newStore, never the production Main store) on the first bar and passes it,
// or its nested CoreRegistryStore, to the W08Runtime /2 probe exports. Checks:
//   1 cross-library W08Store / CoreRegistryStore / TouchRing arguments compile and every probe call returns its expected
//     value
//   2 newStore default: the nested registry exists, its arrays / map are empty and touchMarkCapacityPerCore = 0
//   3 two-level write (store.coreRegistry array + scalar) is visible to the caller through the store, a registry alias and
//     an array alias taken before the call
//   4 write through the directly passed nested CoreRegistryStore (array push, map put) is visible through the store
//   5 a TouchRing built over the registry ring arrays (the Main touchRingViewRaw source layout) is appended by W08Touch
//     through W08Runtime and the rows land in store.coreRegistry
// Any mismatch raises runtime.error naming the failed check; NESTED_PROBE_PASS = 1 only when all 5 checks pass.
// ============================================================
indicator("ZoneEngineV2_W08Runtime_NestedProbeHarness", overlay = false)

import sekine3310/ZoneEngineV2_W08Core_Worker/16 as W08Core
import sekine3310/ZoneEngineV2_W08Touch_Worker/2 as W08Touch
import sekine3310/ZoneEngineV2_W08Runtime_Worker/2 as W08Runtime

var int nestedProbePass = 0
var int checksPass      = 0

if barstate.isfirst
    W08Core.W08Store store = W08Core.newStore()
    W08Core.CoreRegistryStore reg = store.coreRegistry

    // Check 2: default state of the nested registry.
    bool c2 = not na(reg) and array.size(reg.coreIds) == 0 and array.size(reg.sidePhases) == 0 and array.size(reg.touchMarkTimes) == 0 and array.size(reg.corePendingTopologyFlags) == 0 and array.size(reg.sideTouchStartSnapshotValidFlags) == 0 and array.size(reg.sideTouchHistoryTruncatedFlags) == 0 and array.size(reg.corePruneRevisions) == 0 and map.size(reg.coreIdToSlot) == 0 and reg.touchMarkCapacityPerCore == 0

    // Check 3: two-level write through W08Store.
    array.push(reg.coreIds, 0)
    array.push(reg.coreIds, 0)
    array.push(reg.coreIds, 0)
    array<int> idsAlias = store.coreRegistry.coreIds
    int cap = W08Runtime.probeRegistryWrite(store, 1, 42)
    bool c3 = cap == 1 and store.coreRegistry.touchMarkCapacityPerCore == 1 and reg.touchMarkCapacityPerCore == 1 and array.get(store.coreRegistry.coreIds, 1) == 42 and array.get(reg.coreIds, 1) == 42 and array.get(idsAlias, 1) == 42 and array.get(idsAlias, 0) == 0 and array.size(store.coreRegistry.coreIds) == 3

    // Check 4: nested registry passed directly.
    int flagCount = W08Runtime.probeRegistryDirectWrite(store.coreRegistry, true, 7, 9)
    bool c4 = flagCount == 1 and array.size(store.coreRegistry.sideTouchHistoryTruncatedFlags) == 1 and array.get(store.coreRegistry.sideTouchHistoryTruncatedFlags, 0) and array.get(store.coreRegistry.corePruneRevisions, 0) == 9 and map.get(store.coreRegistry.coreIdToSlot, 7) == 9

    // Check 5: TouchRing over the registry ring arrays (1 Core slot, capacity 2), appended through W08Runtime -> W08Touch.
    reg.touchMarkCapacityPerCore := 2
    array.push(reg.touchMarkRingOwnerCoreIds, 11)
    array.push(reg.touchMarkRingHeads, 0)
    array.push(reg.touchMarkRingCounts, 0)
    for k = 0 to 1
        array.push(reg.touchMarkBaseSeqs, 0)
        array.push(reg.touchMarkTimes, 0)
        array.push(reg.touchMarkSides, 0)
        array.push(reg.touchMarkContactBottoms, 0.0)
        array.push(reg.touchMarkContactTops, 0.0)
        array.push(reg.touchMarkCloseAtTouches, 0.0)
        array.push(reg.touchMarkGenerationIds, 0)
        array.push(reg.touchMarkIsNormalTouchFlags, false)
    array.push(reg.sideTouchHistoryTruncatedFlags, false)
    array<int>  ringIds  = array.from(11)
    array<bool> ringLive = array.from(true)
    W08Touch.TouchRing ring = W08Touch.TouchRing.new(reg.touchMarkRingOwnerCoreIds, reg.touchMarkRingHeads, reg.touchMarkRingCounts, reg.touchMarkBaseSeqs, reg.touchMarkTimes, reg.touchMarkSides, reg.touchMarkContactBottoms, reg.touchMarkContactTops, reg.touchMarkCloseAtTouches, reg.touchMarkGenerationIds, reg.touchMarkIsNormalTouchFlags, reg.sideTouchHistoryTruncatedFlags, ringIds, ringLive, reg.touchMarkCapacityPerCore)
    int row0 = W08Runtime.probeTouchAppend(ring, 0, 1, 1000, 1, 10.0, 11.0, 10.5, 3)
    int row1 = W08Runtime.probeTouchAppend(ring, 0, 2, 2000, -1, 12.0, 13.0, 12.5, 3)
    bool c5 = row0 == 0 and row1 == 1 and array.get(store.coreRegistry.touchMarkRingCounts, 0) == 2 and array.get(store.coreRegistry.touchMarkTimes, 0) == 1000 and array.get(store.coreRegistry.touchMarkTimes, 1) == 2000 and array.get(store.coreRegistry.touchMarkSides, 1) == -1 and array.get(store.coreRegistry.touchMarkContactTops, 1) == 13.0 and array.get(store.coreRegistry.touchMarkIsNormalTouchFlags, 0)

    // Check 1: every probe call above compiled with the real nested cross-library UDTs and returned its expected value.
    bool c1 = cap == 1 and flagCount == 1 and row0 == 0 and row1 == 1

    if not c1
        runtime.error("B15B1_NESTED_PROBE_FAIL: check 1 cross-library nested UDT call")
    if not c2
        runtime.error("B15B1_NESTED_PROBE_FAIL: check 2 registry default")
    if not c3
        runtime.error("B15B1_NESTED_PROBE_FAIL: check 3 two-level write visibility")
    if not c4
        runtime.error("B15B1_NESTED_PROBE_FAIL: check 4 direct registry write visibility")
    if not c5
        runtime.error("B15B1_NESTED_PROBE_FAIL: check 5 registry TouchRing write visibility")
    checksPass      := (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0)
    nestedProbePass := checksPass == 5 ? 1 : 0

plot(nestedProbePass, "NESTED_PROBE_PASS")
plot(checksPass, "NESTED_PROBE_CHECKS_PASSED", display = display.data_window)

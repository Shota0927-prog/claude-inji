// ============================================================
//  Fast Volatility Filter 単体モジュール (Indicator版)
// ============================================================
//  ・参考ストラテジーの「高速ボラフィルター」を独立モジュール化。
//  ・ボラティリティが低い時はエントリー禁止 (NoTrade) にする。
//  ・方向性は持たない: allowLong/Short は同一条件。
//  ・strategy ではなく indicator。strategy.entry/exit 不使用。
//  ・未来参照禁止。HTF ATR は request.security(lookahead_off)。
//  ・全機能 ON/OFF 可能。各変数を Data Window へ出力。
//  ・他モジュールの最終条件に AND する前提。
// ============================================================

//@version=5
indicator(
     title         = "Fast Volatility Filter Module",
     shorttitle    = "VOLF",
     overlay       = true,
     max_bars_back = 1000
 )

// ============================================================
//  Input (グループ: Fast Volatility Module)
// ============================================================
grpVol = "Fast Volatility Module"

useVolModule = input.bool(true, "Volモジュールを使う", group = grpVol)

showVolDebugTable = input.bool(true, "Debug Tableを表示",   group = grpVol)
showVolBg         = input.bool(true, "低ボラ背景を表示",     group = grpVol)
showVolLabels     = input.bool(true, "Volラベルを表示",      group = grpVol)

atrLenBase = input.int(14, "基準ATR本数", minval = 1, group = grpVol)
atrTf      = input.timeframe("", "基準ATR時間足(空=チャート)", group = grpVol)

useMinVol    = input.bool(true, "低ボラ時はエントリー禁止", group = grpVol)
minAtrDollar = input.float(1.5, "最低ATR($)", minval = 0.0, step = 0.1, group = grpVol)

volModeRel  = input.bool(false, "低ボラ判定を相対ATRにする", group = grpVol)
volAvgLen   = input.int(480, "ATR平均本数", minval = 10, group = grpVol)
volRatioMin = input.float(0.9, "ATR ÷ ATR平均 最低比", minval = 0.1, step = 0.05, group = grpVol)

useFastVol = input.bool(true, "高速ボラフィルター", group = grpVol)
fastAtrLen = input.int(5, "fastATR本数", minval = 1, group = grpVol)
fastAtrMin = input.float(2.2, "fastATR最低($)", step = 0.1, group = grpVol)

bodyAvgLen = input.int(5, "実体平均本数", minval = 1, group = grpVol)
bodyAvgMin = input.float(0.5, "実体平均最低($)", step = 0.1, group = grpVol)

useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う", group = grpVol)
rangeLookback       = input.int(20, "RangeWidth参照本数", minval = 2, group = grpVol)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", step = 0.01, group = grpVol)

useVolExpansion      = input.bool(true, "ボラ拡大判定を使う", group = grpVol)
volExpansionLookback = input.int(3, "ボラ拡大判定本数", minval = 1, group = grpVol)

useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = grpVol)
volRecoveryBars = input.int(2, "低ボラ解除後の待機本数", minval = 1, group = grpVol)

bool vAct = useVolModule

// ============================================================
//  3. 基本計算
// ============================================================
float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
float atrAvg  = ta.sma(baseAtr, volAvgLen)
float fastAtr = ta.atr(fastAtrLen)
float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)

float rangeHigh = ta.highest(high, rangeLookback)
float rangeLow  = ta.lowest(low,  rangeLookback)
float rangeWidth = rangeHigh - rangeLow
float atrRangeRatio = rangeWidth > 0 ? fastAtr / rangeWidth : 0.0

// ============================================================
//  4. 低ボラ判定
// ============================================================
bool volAbsOk = baseAtr >= minAtrDollar
bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
bool volBaseOk = not useMinVol or (volModeRel ? volRelOk : volAbsOk)

// ============================================================
//  5. 高速ボラフィルター
// ============================================================
bool fastAtrOk    = not useFastVol or fastAtr >= fastAtrMin
bool bodyAvgOk    = not useFastVol or bodyAvgFast >= bodyAvgMin
bool rangeRatioOk = not useFastVol or not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
bool fastVolOk    = not useFastVol or (fastAtrOk and bodyAvgOk and rangeRatioOk)

// ============================================================
//  6. ボラ拡大判定
// ============================================================
bool volExpanding   = useVolExpansion and fastAtr > fastAtr[volExpansionLookback] and baseAtr >= baseAtr[volExpansionLookback]
bool volContracting = fastAtr < fastAtr[volExpansionLookback] and baseAtr < baseAtr[volExpansionLookback]

// ============================================================
//  7. 最終Vol判定
// ============================================================
bool volOk  = useVolModule and volBaseOk and fastVolOk
bool volLow = useVolModule and not volOk

// 低ボラ解除後の待機
var int volRecoveryStartBar = na
if volLow
    volRecoveryStartBar := na
if not volLow and nz(volLow[1], false)
    volRecoveryStartBar := bar_index

bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars
bool finalVolOk = volOk and volRecoveryOk

// ============================================================
//  8. NoTrade
// ============================================================
bool volNoTrade      = useVolModule and not finalVolOk
bool volNoTradeLong  = volNoTrade
bool volNoTradeShort = volNoTrade

// ============================================================
//  9. Bias / allow (方向性なし → 両方向同一条件)
// ============================================================
bool volBiasLong  = useVolModule and finalVolOk
bool volBiasShort = useVolModule and finalVolOk

bool allowLongByVol  = useVolModule and finalVolOk
bool allowShortByVol = useVolModule and finalVolOk

int volDirection = 0

// ============================================================
//  10. Signal Type
//  優先: LowVol NoTrade > Expansion > Contracting > FullVolOK > FastVolOK > BaseATR OK
// ============================================================
int volSignalType =
     not useVolModule ? 0 :
     volNoTrade       ? 1 :
     volExpanding     ? 4 :
     volContracting   ? 5 :
     finalVolOk       ? 6 :
     fastVolOk        ? 3 :
     volBaseOk        ? 2 : 0

// ============================================================
//  11. Rank / Score
// ============================================================
int volScore = not useVolModule ? 0 : (volBaseOk ? 30 : 0) + (fastAtrOk ? 25 : 0) + (bodyAvgOk ? 20 : 0) + (rangeRatioOk ? 15 : 0) + (volExpanding ? 10 : 0)

int volRank =
     not useVolModule ? 0 :
     volScore >= 90 ? 5 :
     volScore >= 75 ? 4 :
     volScore >= 60 ? 3 :
     volScore >= 40 ? 2 :
     volScore > 0   ? 1 : 0

// ============================================================
//  12. 表示 : 背景 / ラベル
// ============================================================
bgcolor(showVolBg and vAct and volNoTrade   ? color.new(color.gray,   88) : na, title = "Low Vol BG")
bgcolor(showVolBg and vAct and volExpanding ? color.new(color.purple, 88) : na, title = "Vol EXP BG")

if showVolLabels and vAct
    if volNoTrade and not nz(volNoTrade[1], false)
        label.new(bar_index, high, "Low Vol", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.gray, 0), textcolor = color.white, size = size.small)
    if volExpanding and not nz(volExpanding[1], false)
        label.new(bar_index, low, "Vol EXP", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)

// ============================================================
//  13. Debug Table
// ============================================================
f_typeStr(t) =>
    t == 1 ? "LowVol NoTrade" : t == 2 ? "Base ATR OK" : t == 3 ? "Fast Vol OK" : t == 4 ? "Vol EXP" : t == 5 ? "Vol Contracting" : t == 6 ? "Full Vol OK" : "None"

var table dbg = table.new(position.top_right, 2, 14, border_width = 1)
if showVolDebugTable and vAct and barstate.islast
    string sState = volNoTrade ? "NoTrade" : finalVolOk ? "Vol OK" : "-"
    color  sCol   = volNoTrade ? color.new(color.red, 20) : color.new(color.green, 0)
    table.cell(dbg, 0, 0,  "Vol State", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0,  sState, text_color = color.white, bgcolor = sCol)
    table.cell(dbg, 0, 1,  "SignalType", text_color = color.white)
    table.cell(dbg, 1, 1,  f_typeStr(volSignalType), text_color = color.white)
    table.cell(dbg, 0, 2,  "Rank", text_color = color.white)
    table.cell(dbg, 1, 2,  str.tostring(volRank), text_color = color.white)
    table.cell(dbg, 0, 3,  "Score", text_color = color.white)
    table.cell(dbg, 1, 3,  str.tostring(volScore), text_color = color.white)
    table.cell(dbg, 0, 4,  "baseATR", text_color = color.white)
    table.cell(dbg, 1, 4,  str.tostring(baseAtr, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 5,  "fastATR", text_color = color.white)
    table.cell(dbg, 1, 5,  str.tostring(fastAtr, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 6,  "bodyAvg", text_color = color.white)
    table.cell(dbg, 1, 6,  str.tostring(bodyAvgFast, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 7,  "ATR Avg", text_color = color.white)
    table.cell(dbg, 1, 7,  str.tostring(atrAvg, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 8,  "ATR Ratio", text_color = color.white)
    table.cell(dbg, 1, 8,  atrAvg > 0 ? str.tostring(baseAtr / atrAvg, "#.##") : "-", text_color = color.white)
    table.cell(dbg, 0, 9,  "ATR/Range", text_color = color.white)
    table.cell(dbg, 1, 9,  str.tostring(atrRangeRatio, "#.###"), text_color = color.white)
    table.cell(dbg, 0, 10, "Base OK", text_color = color.white)
    table.cell(dbg, 1, 10, volBaseOk ? "Y" : "N", text_color = volBaseOk ? color.lime : color.red)
    table.cell(dbg, 0, 11, "Fast OK", text_color = color.white)
    table.cell(dbg, 1, 11, fastVolOk ? "Y" : "N", text_color = fastVolOk ? color.lime : color.red)
    table.cell(dbg, 0, 12, "NoTrade", text_color = color.white)
    table.cell(dbg, 1, 12, volNoTrade ? "Y" : "N", text_color = color.white)
    table.cell(dbg, 0, 13, "Allow L/S", text_color = color.white)
    table.cell(dbg, 1, 13, (allowLongByVol ? "L" : "-") + " / " + (allowShortByVol ? "S" : "-"), text_color = color.white)

// ============================================================
//  14. Data Window 出力
// ============================================================
plot(baseAtr,       "baseAtr",       display = display.data_window)
plot(atrAvg,        "atrAvg",        display = display.data_window)
plot(fastAtr,       "fastAtr",       display = display.data_window)
plot(bodyAvgFast,   "bodyAvgFast",   display = display.data_window)
plot(rangeWidth,    "rangeWidth",    display = display.data_window)
plot(atrRangeRatio, "atrRangeRatio", display = display.data_window)

plot(volAbsOk      ? 1 : 0, "volAbsOk",      display = display.data_window)
plot(volRelOk      ? 1 : 0, "volRelOk",      display = display.data_window)
plot(volBaseOk     ? 1 : 0, "volBaseOk",     display = display.data_window)
plot(fastAtrOk     ? 1 : 0, "fastAtrOk",     display = display.data_window)
plot(bodyAvgOk     ? 1 : 0, "bodyAvgOk",     display = display.data_window)
plot(rangeRatioOk  ? 1 : 0, "rangeRatioOk",  display = display.data_window)
plot(fastVolOk     ? 1 : 0, "fastVolOk",     display = display.data_window)
plot(volOk         ? 1 : 0, "volOk",         display = display.data_window)
plot(finalVolOk    ? 1 : 0, "finalVolOk",    display = display.data_window)

plot(volLow          ? 1 : 0, "volLow",          display = display.data_window)
plot(volNoTrade      ? 1 : 0, "volNoTrade",      display = display.data_window)
plot(volNoTradeLong  ? 1 : 0, "volNoTradeLong",  display = display.data_window)
plot(volNoTradeShort ? 1 : 0, "volNoTradeShort", display = display.data_window)

plot(volExpanding   ? 1 : 0, "volExpanding",   display = display.data_window)
plot(volContracting ? 1 : 0, "volContracting", display = display.data_window)

plot(allowLongByVol  ? 1 : 0, "allowLongByVol",  display = display.data_window)
plot(allowShortByVol ? 1 : 0, "allowShortByVol", display = display.data_window)
plot(volBiasLong     ? 1 : 0, "volBiasLong",     display = display.data_window)
plot(volBiasShort    ? 1 : 0, "volBiasShort",    display = display.data_window)

plot(volSignalType, "volSignalType", display = display.data_window)
plot(volDirection,  "volDirection",  display = display.data_window)
plot(volRank,       "volRank",       display = display.data_window)
plot(volScore,      "volScore",      display = display.data_window)

// ============================================================
//  15. Alert
// ============================================================
alertcondition(vAct and volLow and not volLow[1],            "Vol Low NoTrade", "{{ticker}} 低ボラ ノートレード")
alertcondition(vAct and finalVolOk and not finalVolOk[1],    "Vol Recovered",   "{{ticker}} ボラ回復")
alertcondition(vAct and volExpanding and not volExpanding[1], "Vol Expansion",  "{{ticker}} ボラ拡大")
alertcondition(allowLongByVol,  "Allow Long Vol",  "{{ticker}} Vol ロング許可")
alertcondition(allowShortByVol, "Allow Short Vol", "{{ticker}} Vol ショート許可")

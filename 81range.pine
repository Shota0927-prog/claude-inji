float  rlbSlFixed  = 10.0                     // 固定SL($)
float  rlbRR       = 1.2                      // リスクリワード
// RLB専用 水平線設定 (自己完結・固定値。共通の useLineModule/useLineWinZone/useLineBreak/useReactionLine/useLine5M に依存しない)
// 元ストラテジー: 5分足Pivotのみ・複数回反応(反応帯)・ブレイクのみ・反発/フリップ/スイープOFF・タッチ2・状態3本・CloseOnly・加重平均統合。
int    rlbPivotLen = 10                       // Pivot Length (元 linePivotLen 初期値)
int    rlbAtrLen   = 14                       // ATR期間 (元 lineAtrLen 初期値)
int    rlbMaxZones = 20                       // 水平線 最大保持数 (元 lineMaxZones 初期値)
float  rlbZoneWidth = 0.1                     // ゾーン幅 固定 (元 useLineATRZone=false → lineZoneFixedWidth)

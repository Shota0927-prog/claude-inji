// ---------- フィボC (元ストラテジー準拠・完全独立) ----------
// 仮シグナル (足未確定。fibCPos非保有。同一バー内重複は alert.freq_once_per_bar が防止)
bool fibCLongProv  = is5m and not barstate.isconfirmed and not fibCPosActive and fibCWantLongRaw
bool fibCShortProv = is5m and not barstate.isconfirmed and not fibCPosActive and fibCWantShortRaw
if fibCLongProv
    alert(f_sigMsg("仮", "LONG", close, fibCLongStop, fibCLongTP, fibCLongQty, LOGIC_FIB_C_RANK_DISPLAY, LOGIC_FIB_C_NAME, envDirText, drVolTextOut), alert.freq_once_per_bar)

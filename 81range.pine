int    rlbMinTouches = 2                      // 反応 最小タッチ数 (元 reactionMinTouches 初期値)
bool   rlbBodyFilter = true                   // ブレイク 実体フィルター (元 useLineBreakBodyFilter 初期値)
float  rlbBreakBodyRatio = 0.5               // ブレイク 実体率最小 (元 lineBreakBodyRatio 初期値)
float  rlbBreakBufferATR = 0.10              // ブレイク バッファ ATR倍率 (元 lineBreakBufferMode=ATR → lineBreakBufferATR)
int    rlbBreakConfirmN = 1                   // ブレイク 確定=CloseOnly → 1本 (元 lineBreakConfirmMode=CloseOnly)
int    rlbStateMaxBars = 3                    // 水平線状態 有効本数 (元 lineStateMaxBars 初期値)

// --- 追加: フィボB戦略 (内部判定=Aランク帯 0.618-0.786 / 表示ランク=B・ロング+ショート) ---
string LOGIC_FBB_NAME = "フィボB"
string LOGIC_FBB_RANK_DISPLAY = "B"          // 表示ランク=B (既存Bと同色・同表記)
int    LOGIC_FBB_ID   = 8
bool   useFbbLogic = true                     // フィボB戦略 有効
float  fbbSlFixed  = 12.0                     // 固定SL($)
float  fbbRR       = 1.0                      // リスクリワード
string LOGIC_FBB_ENV_TEXT = "レンジ/上昇/上昇"

// --- 確定ラベル色 Cランク (既存の A/B と明確に区別。C表示の共通色) ---
color COLOR_RANK_C = color.rgb(150, 90, 0)   // Cランク=琥珀/濃橙 (A濃紺・B深緑と区別)

// ============================================================
// 5b-2g. セッション水平線 反発 モジュール (第3ロジック専用・ショートのみ)
// ============================================================
// セッション高安トラッカー (var) + レベル配列 (価格 / 作成バー / 作成日ID / タッチ回数 を同一indexで並列管理)
// slrLvlTouch は元ストラテジー f_lineAddZone の zTouch 相当 (統合時の加重平均に必須)。
var array<float> slrLvl      = array.new_float()
var array<int>   slrLvlBar   = array.new_int()
var array<int>   slrLvlDay   = array.new_int()   // 作成日ID (GMT暦日カウンター。有効日数判定用)
var array<int>   slrLvlTouch = array.new_int()   // タッチ回数 (統合時の加重平均用。元 zTouch)

// セッション高安トラッカー (専用TZ slrSessTZ 使用 = グローバル lineSessTZ に非依存)
f_slrSession(string sessStr, float prevHi, float prevLo) =>
    bool _inSess = not na(time(timeframe.period, sessStr, slrSessTZ))
    bool _ended = not _inSess and _inSess[1]
    float _hi = prevHi
    float _lo = prevLo
    if _inSess and not _inSess[1]
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(prevHi) ? high : math.max(prevHi, high)
        _lo := na(prevLo) ? low : math.min(prevLo, low)
    [_hi, _lo, _ended]

// レベル追加/統合 (元ストラテジー f_lineAddZone と同一の統合方法を再現)。
// ・許容幅 _mergeTol 以内に既存水平線があれば統合 (先頭一致のみ)。
//     価格 = (既存価格 * 旧タッチ回数 + p) / 新タッチ回数 … タッチ回数加重平均 (元 zPrice 更新式そのまま)
//     タッチ回数 += 1 / 作成日ID = max(既存, 新) … 再タッチで延命 (元 zSessionDay 更新式そのまま)
//     ※ 作成バー(slrLvlBar) は統合時に更新しない (元 zCreated と同じく生成時のまま)。
// ・許容幅以内が無ければ新規追加。上限 slrMaxZones(20) 超過で最古shift。作成日IDを保存。
f_slrPush(float p, int _dayId, float _mergeTol) =>
    if not na(p)
        bool _found = false
        if array.size(slrLvl) > 0
            for i = 0 to array.size(slrLvl) - 1
                if not _found and math.abs(array.get(slrLvl, i) - p) <= _mergeTol
                    int _oldT = array.get(slrLvlTouch, i)
                    int _newT = _oldT + 1
                    array.set(slrLvl, i, (array.get(slrLvl, i) * _oldT + p) / _newT)
                    array.set(slrLvlTouch, i, _newT)
                    array.set(slrLvlDay, i, math.max(array.get(slrLvlDay, i), _dayId))
                    _found := true
        if not _found
            array.push(slrLvl, p)
            array.push(slrLvlBar, bar_index)
            array.push(slrLvlDay, _dayId)
            array.push(slrLvlTouch, 1)
            if array.size(slrLvl) > slrMaxZones
                array.shift(slrLvl)
                array.shift(slrLvlBar)
                array.shift(slrLvlDay)
                array.shift(slrLvlTouch)

// --- SLR 本体を関数化 (反発ショート判定は不変) ---
// セッション高安トラッカー var は関数ローカルへ。レベル配列 (slrLvl) はグローバル参照。外部参照する slrShortEvent を返す。
// _dayCounter = GMT暦日カウンター (関数外で算出して渡す。グローバルスカラーは関数内で書換え不可のため)。
// _mergeTol   = 統合許容幅 (ATR14 × 0.3。関数外で算出して渡す)。
f_calcSLR(int _dayCounter, float _mergeTol) =>
    var float slrAsiaHi = na
    var float slrAsiaLo = na
    var float slrLdnHi = na
    var float slrLdnLo = na
    var float slrNyHi = na
    var float slrNyLo = na
    bool slrShortEvent = false
    float slrNearestRes = na
    if useSLRLogic
        [_saH, _saL, _saEnd] = f_slrSession(slrAsiaSess, slrAsiaHi, slrAsiaLo)
        slrAsiaHi := _saH
        slrAsiaLo := _saL
        [_slH, _slL, _slEnd] = f_slrSession(slrLondonSess, slrLdnHi, slrLdnLo)
        slrLdnHi := _slH
        slrLdnLo := _slL
        [_snH, _snL, _snEnd] = f_slrSession(slrNySess, slrNyHi, slrNyLo)
        slrNyHi := _snH
        slrNyLo := _snL
        if _saEnd
            f_slrPush(slrAsiaHi, _dayCounter, _mergeTol)
            f_slrPush(slrAsiaLo, _dayCounter, _mergeTol)
        if _slEnd
            f_slrPush(slrLdnHi, _dayCounter, _mergeTol)
            f_slrPush(slrLdnLo, _dayCounter, _mergeTol)
        if _snEnd
            f_slrPush(slrNyHi, _dayCounter, _mergeTol)
            f_slrPush(slrNyLo, _dayCounter, _mergeTol)
        // 有効日数を超えた古い水平線を削除 (作成日 < 現在日 - (maxDays-1))。判定より先に適用。
        // 元ストラテジーの純セッション水平線 有効日数(当日含む slrSessionMaxDays 日)管理に一致させる。
        if array.size(slrLvl) > 0
            for i = array.size(slrLvl) - 1 to 0
                if array.get(slrLvlDay, i) < _dayCounter - (slrSessionMaxDays - 1)
                    array.remove(slrLvl, i)
                    array.remove(slrLvlBar, i)
                    array.remove(slrLvlDay, i)
                    array.remove(slrLvlTouch, i)
        if array.size(slrLvl) > 0
            for i = 0 to array.size(slrLvl) - 1
                float _p = array.get(slrLvl, i)
                if _p >= close and bar_index >= array.get(slrLvlBar, i)
                    if na(slrNearestRes) or _p < slrNearestRes
                        slrNearestRes := _p
        bool _resUse = not na(slrNearestRes)
        float _resZoneBot = slrNearestRes - slrZoneWidth
        slrShortEvent := _resUse and high >= _resZoneBot and close < slrNearestRes
    slrShortEvent

// SLR専用 セッション日カウンター (GMT暦日変化で+1。グローバルスカラーのため関数外で算出)
var int slrSessDayCounter = 0
int _slrDayId = year(time, slrSessTZ) * 10000 + month(time, slrSessTZ) * 100 + dayofmonth(time, slrSessTZ)
if not na(_slrDayId[1]) and _slrDayId != _slrDayId[1]
    slrSessDayCounter := slrSessDayCounter + 1

// SLR専用 統合許容幅 = ATR14 × 0.3 (元ストラテジー useLineMergeZone=false 時の lineAtr * reactionToleranceATR 準拠)
float slrMergeTol = ta.atr(slrMergeAtrLen) * slrMergeToleranceATR

bool slrShortEvent = f_calcSLR(slrSessDayCounter, slrMergeTol)

// 状態管理 (反発イベント後 slrStateMaxBars 本だけ場所条件OKを保持)
var bool slrShortState = false
var int  slrShortStateBar = na
if useSLRLogic
    slrShortStateBar := slrShortEvent ? bar_index : slrShortStateBar
    slrShortState := (slrShortState or slrShortEvent) and (na(slrShortStateBar) or not (bar_index - slrShortStateBar > slrStateMaxBars))
bool slrShortZoneOk = useSLRLogic and slrShortState

// ============================================================
// 5b-2h. MACDヒスト拡大 モジュール (第5ロジック専用・グローバルMomentum設定に非依存)
// ============================================================
// --- MACDヒスト拡大 イベント判定を関数化 (連続拡大/方向確認は不変) ---
// var カウンタは関数ローカルへ。外部参照するイベント2値を返す。
f_calcMHX() =>
    [mhxLine, mhxSig, mhxHist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)
    bool mhxBullExpand = mhxHist > 0 and mhxHist > mhxHist[1]
    bool mhxBearExpand = mhxHist < 0 and mhxHist < mhxHist[1]
    var int mhxBullExpCount = 0
    var int mhxBearExpCount = 0
    mhxBullExpCount := mhxBullExpand ? mhxBullExpCount + 1 : 0
    mhxBearExpCount := mhxBearExpand ? mhxBearExpCount + 1 : 0
    bool mhxLongEvent  = useMHXLogic and mhxBullExpCount >= mhxExpBars and mhxHist > 0
    bool mhxShortEvent = useMHXLogic and mhxBearExpCount >= mhxExpBars and mhxHist < 0
    [mhxLongEvent, mhxShortEvent]

[mhxLongEvent, mhxShortEvent] = f_calcMHX()
var bool mhxLongStateOk  = false
var bool mhxShortStateOk = false
var int  mhxLongStateBar  = na
var int  mhxShortStateBar = na
if useMHXLogic
    mhxLongStateBar  := mhxLongEvent  ? bar_index : mhxLongStateBar
    mhxShortStateBar := mhxShortEvent ? bar_index : mhxShortStateBar
    mhxLongStateOk  := (mhxLongStateOk  or mhxLongEvent)  and (na(mhxLongStateBar)  or not (bar_index - mhxLongStateBar  > mhxStateMaxBars))
    mhxShortStateOk := (mhxShortStateOk or mhxShortEvent) and (na(mhxShortStateBar) or not (bar_index - mhxShortStateBar > mhxStateMaxBars))
bool mhxLongZoneOk  = useMHXLogic and mhxLongStateOk
bool mhxShortZoneOk = useMHXLogic and mhxShortStateOk

// ============================================================
// 5b-2i. MACD拡大/Regular Divergence モジュール (第6ロジック専用・グローバルMomentum設定に非依存)
// ============================================================
// --- MACD拡大/Div イベント判定を関数化 (Hist拡大 OR Regular Divergence は不変) ---
// var カウンタ / divergence pivot は関数ローカルへ。外部参照するイベント2値を返す。
f_calcMHD() =>
    [mhdLine, mhdSig, mhdHist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)
    bool mhdBullExpand = mhdHist > 0 and mhdHist > mhdHist[1]
    bool mhdBearExpand = mhdHist < 0 and mhdHist < mhdHist[1]
    var int mhdBullExpCount = 0
    var int mhdBearExpCount = 0
    mhdBullExpCount := mhdBullExpand ? mhdBullExpCount + 1 : 0
    mhdBearExpCount := mhdBearExpand ? mhdBearExpCount + 1 : 0
    bool mhdHistLong  = mhdBullExpCount >= mhdExpBars and mhdHist > 0
    bool mhdHistShort = mhdBearExpCount >= mhdExpBars and mhdHist < 0
    float mhdPricePH = ta.pivothigh(high, macdDivPivotLen, macdDivPivotLen)
    float mhdPricePL = ta.pivotlow(low, macdDivPivotLen, macdDivPivotLen)
    float mhdAtPivot = mhdLine[macdDivPivotLen]
    var float mhdPhPrev = na
    var float mhdPhLast = na
    var float mhdMhPrev = na
    var float mhdMhLast = na
    var int   mhdPhBarPrev = na
    var int   mhdPhBarLast = na
    var float mhdPlPrev = na
    var float mhdPlLast = na
    var float mhdMlPrev = na
    var float mhdMlLast = na
    var int   mhdPlBarPrev = na
    var int   mhdPlBarLast = na
    bool mhdNewPH = not na(mhdPricePH)
    bool mhdNewPL = not na(mhdPricePL)
    if mhdNewPH
        mhdPhPrev := mhdPhLast
        mhdMhPrev := mhdMhLast
        mhdPhBarPrev := mhdPhBarLast
        mhdPhLast := mhdPricePH
        mhdMhLast := mhdAtPivot
        mhdPhBarLast := bar_index - macdDivPivotLen
    if mhdNewPL
        mhdPlPrev := mhdPlLast
        mhdMlPrev := mhdMlLast
        mhdPlBarPrev := mhdPlBarLast
        mhdPlLast := mhdPricePL
        mhdMlLast := mhdAtPivot
        mhdPlBarLast := bar_index - macdDivPivotLen
    bool mhdPhInRange = not na(mhdPhPrev) and (mhdPhBarLast - mhdPhBarPrev) <= macdDivLookback
    bool mhdPlInRange = not na(mhdPlPrev) and (mhdPlBarLast - mhdPlBarPrev) <= macdDivLookback
    bool mhdRegShort = mhdNewPH and mhdPhInRange and mhdPhLast > mhdPhPrev and mhdMhLast < mhdMhPrev
    bool mhdRegLong  = mhdNewPL and mhdPlInRange and mhdPlLast < mhdPlPrev and mhdMlLast > mhdMlPrev
    bool mhdLongEvent  = useMHDLogic and (mhdHistLong  or mhdRegLong)
    bool mhdShortEvent = useMHDLogic and (mhdHistShort or mhdRegShort)
    [mhdLongEvent, mhdShortEvent]

[mhdLongEvent, mhdShortEvent] = f_calcMHD()
var bool mhdLongStateOk  = false
var bool mhdShortStateOk = false
var int  mhdLongStateBar  = na
var int  mhdShortStateBar = na
if useMHDLogic
    mhdLongStateBar  := mhdLongEvent  ? bar_index : mhdLongStateBar
    mhdShortStateBar := mhdShortEvent ? bar_index : mhdShortStateBar
    mhdLongStateOk  := (mhdLongStateOk  or mhdLongEvent)  and (na(mhdLongStateBar)  or not (bar_index - mhdLongStateBar  > mhdStateMaxBars))
    mhdShortStateOk := (mhdShortStateOk or mhdShortEvent) and (na(mhdShortStateBar) or not (bar_index - mhdShortStateBar > mhdStateMaxBars))
bool mhdLongZoneOk  = useMHDLogic and mhdLongStateOk
bool mhdShortZoneOk = useMHDLogic and mhdShortStateOk

// ============================================================
// 5b-2j. 水平線ブレイク(複数回反応価格帯) モジュール (第7ロジック専用・グローバル水平線/マスター非依存)
// ============================================================
var array<float> rlbPrice     = array.new_float()
var array<int>   rlbTouch     = array.new_int()
var array<int>   rlbCreated   = array.new_int()
var array<bool>  rlbBreakUsed = array.new_bool()
var array<int>   rlbId        = array.new_int()
var array<int>   rlbIdCtr     = array.new_int(1, 0)
var array<int>   rlbPendUpId  = array.new_int()
var array<float> rlbPendUpThr = array.new_float()
var array<int>   rlbPendUpCnt = array.new_int()
var array<int>   rlbPendDnId  = array.new_int()
var array<float> rlbPendDnThr = array.new_float()
var array<int>   rlbPendDnCnt = array.new_int()

// 反応帯 追加/統合 (近接ゾーンはタッチ加算=複数回反応。lineMaxZones で保持数制限)
f_rlbAddZone(float p, float tol) =>
    bool _found = false
    if array.size(rlbPrice) > 0
        for i = 0 to array.size(rlbPrice) - 1
            if not _found and math.abs(array.get(rlbPrice, i) - p) <= tol
                int _o = array.get(rlbTouch, i)
                array.set(rlbPrice, i, (array.get(rlbPrice, i) * _o + p) / (_o + 1))
                array.set(rlbTouch, i, _o + 1)
                _found := true
    if not _found
        array.push(rlbPrice, p)
        array.push(rlbTouch, 1)
        array.push(rlbCreated, bar_index)
        array.push(rlbBreakUsed, false)
        int _nid = array.get(rlbIdCtr, 0) + 1
        array.set(rlbIdCtr, 0, _nid)
        array.push(rlbId, _nid)
        if array.size(rlbPrice) > rlbMaxZones
            array.shift(rlbPrice)
            array.shift(rlbTouch)
            array.shift(rlbCreated)
            array.shift(rlbBreakUsed)
            array.shift(rlbId)

f_rlbFindIdx(int _id) =>
    int _idx = na
    if array.size(rlbId) > 0
        for i = 0 to array.size(rlbId) - 1
            if array.get(rlbId, i) == _id
                _idx := i
                break
    _idx

f_rlbIdIn(array<int> _a, int _id) =>
    bool _f = false
    if array.size(_a) > 0
        for i = 0 to array.size(_a) - 1
            if array.get(_a, i) == _id
                _f := true
                break
    _f

// --- 水平線ブレイク 本体を関数化 (反応帯検出/ブレイク/確定/pending は不変) ---
// グローバル配列 (rlb*) は参照渡しで直接ミューテート。外部参照するイベント2値を返す。
f_calcRLB(float _ph, float _pl) =>
    bool rlbLongEvent  = false
    bool rlbShortEvent = false
    if useRLBLogic
        float _atr = ta.atr(rlbAtrLen)
        float _zoneW = rlbZoneWidth
        float _tol = _atr * rlbReactionTolATR
        if not na(_ph)
            f_rlbAddZone(_ph, _tol)
        if not na(_pl)
            f_rlbAddZone(_pl, _tol)
        float _buf = _atr * rlbBreakBufferATR
        int _confN = rlbBreakConfirmN
        bool _bodyOK = not rlbBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= rlbBreakBodyRatio)
        if array.size(rlbPendUpId) > 0
            for k = array.size(rlbPendUpId) - 1 to 0
                int _pid = array.get(rlbPendUpId, k)
                float _thr = array.get(rlbPendUpThr, k)
                int _cnt = array.get(rlbPendUpCnt, k)
                int _idx = f_rlbFindIdx(_pid)
                bool _valid = not na(_idx) and not array.get(rlbBreakUsed, _idx) and array.get(rlbTouch, _idx) >= rlbMinTouches
                if not _valid
                    array.remove(rlbPendUpId, k)
                    array.remove(rlbPendUpThr, k)
                    array.remove(rlbPendUpCnt, k)
                else if close > _thr
                    int _nc = _cnt + 1
                    if _nc >= _confN
                        array.set(rlbBreakUsed, _idx, true)
                        rlbLongEvent := true
                        array.remove(rlbPendUpId, k)
                        array.remove(rlbPendUpThr, k)
                        array.remove(rlbPendUpCnt, k)
                    else
                        array.set(rlbPendUpCnt, k, _nc)
                else
                    array.remove(rlbPendUpId, k)
                    array.remove(rlbPendUpThr, k)
                    array.remove(rlbPendUpCnt, k)
        if array.size(rlbPendDnId) > 0
            for k = array.size(rlbPendDnId) - 1 to 0
                int _pid = array.get(rlbPendDnId, k)
                float _thr = array.get(rlbPendDnThr, k)
                int _cnt = array.get(rlbPendDnCnt, k)
                int _idx = f_rlbFindIdx(_pid)
                bool _valid = not na(_idx) and not array.get(rlbBreakUsed, _idx) and array.get(rlbTouch, _idx) >= rlbMinTouches
                if not _valid
                    array.remove(rlbPendDnId, k)
                    array.remove(rlbPendDnThr, k)
                    array.remove(rlbPendDnCnt, k)
                else if close < _thr
                    int _nc = _cnt + 1
                    if _nc >= _confN
                        array.set(rlbBreakUsed, _idx, true)
                        rlbShortEvent := true
                        array.remove(rlbPendDnId, k)
                        array.remove(rlbPendDnThr, k)
                        array.remove(rlbPendDnCnt, k)
                    else
                        array.set(rlbPendDnCnt, k, _nc)
                else
                    array.remove(rlbPendDnId, k)
                    array.remove(rlbPendDnThr, k)
                    array.remove(rlbPendDnCnt, k)
        if _bodyOK and array.size(rlbPrice) > 0
            for i = 0 to array.size(rlbPrice) - 1
                if not array.get(rlbBreakUsed, i) and bar_index >= array.get(rlbCreated, i) and array.get(rlbTouch, i) >= rlbMinTouches
                    int _zid = array.get(rlbId, i)
                    float _zp = array.get(rlbPrice, i)
                    float _thrUp = _zp + _zoneW + _buf
                    float _thrDn = _zp - _zoneW - _buf
                    if close[1] <= _thrUp and close > _thrUp and not f_rlbIdIn(rlbPendUpId, _zid)
                        if _confN <= 1
                            array.set(rlbBreakUsed, i, true)
                            rlbLongEvent := true
                        else
                            array.push(rlbPendUpId, _zid)
                            array.push(rlbPendUpThr, _thrUp)
                            array.push(rlbPendUpCnt, 1)
                    if close[1] >= _thrDn and close < _thrDn and not f_rlbIdIn(rlbPendDnId, _zid)
                        if _confN <= 1
                            array.set(rlbBreakUsed, i, true)
                            rlbShortEvent := true
                        else
                            array.push(rlbPendDnId, _zid)
                            array.push(rlbPendDnThr, _thrDn)
                            array.push(rlbPendDnCnt, 1)
    [rlbLongEvent, rlbShortEvent]

// 5分足Pivot取得 (元ストラテジーと一致: request.security で 5分足の ta.pivothigh/pivotlow を取得)。
// 同一 5分足内で値が繰り返し返るため、新しい確定Pivotが出た時のみ (前回と異なる非na値) をゾーン追加対象にする。
[_rlbPhRaw, _rlbPlRaw] = request.security(syminfo.tickerid, "5", [ta.pivothigh(rlbPivotLen, rlbPivotLen), ta.pivotlow(rlbPivotLen, rlbPivotLen)], lookahead = barmerge.lookahead_off)
float rlbPhNew = not na(_rlbPhRaw) and (na(_rlbPhRaw[1]) or _rlbPhRaw != _rlbPhRaw[1]) ? _rlbPhRaw : na
float rlbPlNew = not na(_rlbPlRaw) and (na(_rlbPlRaw[1]) or _rlbPlRaw != _rlbPlRaw[1]) ? _rlbPlRaw : na
[rlbLongEvent, rlbShortEvent] = f_calcRLB(rlbPhNew, rlbPlNew)

// 水平線ブレイク 状態管理 (シグナル後 rlbStateMaxBars 本 保持。RLB専用の固定本数)
var bool rlbLongStateOk  = false
var bool rlbShortStateOk = false
var int  rlbLongStateBar  = na
var int  rlbShortStateBar = na
if useRLBLogic
    rlbLongStateBar  := rlbLongEvent  ? bar_index : rlbLongStateBar
    rlbShortStateBar := rlbShortEvent ? bar_index : rlbShortStateBar
    rlbLongStateOk  := (rlbLongStateOk  or rlbLongEvent)  and (na(rlbLongStateBar)  or not (bar_index - rlbLongStateBar  > rlbStateMaxBars))
    rlbShortStateOk := (rlbShortStateOk or rlbShortEvent) and (na(rlbShortStateBar) or not (bar_index - rlbShortStateBar > rlbStateMaxBars))
bool rlbLongZoneOk  = useRLBLogic and rlbLongStateOk
bool rlbShortZoneOk = useRLBLogic and rlbShortStateOk

// ============================================================
// 【レイヤー3: ロジック別シグナル判定 (足確定を含まないロジック本体)】
// ============================================================
int jstHour = hour(time, "Asia/Tokyo")
bool inAsia = jstHour >= 9 and jstHour < 16
bool inEU   = jstHour >= 16 and jstHour < 21
bool inNY   = jstHour >= 21 or jstHour < 3
bool sessionOk = not useSessionFilter or (useAsiaSession and inAsia) or (useEUSession and inEU) or (useNYSession and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// 出来高リジェクト ロジック本体 (Size>=1 / risk>0 を含む・barstate は含まない)
bool canLong = useLong and dailyRegimeLongOk and sessionOk and allowByNewsTime and envLongOk and longWinZoneOk and allowLongByMomentum and allowLongByTrigger and volOk and not lineNoTradeLong and longRisk > 0 and longQty >= 1

bool canShort = useShort and dailyRegimeShortOk and sessionOk and allowByNewsTime and envShortOk and shortWinZoneOk and allowShortByMomentum and allowShortByTrigger and volOk and not lineNoTradeShort and shortRisk > 0 and shortQty >= 1

// ------------------------------------------------------------
// フィボC ロジック本体 (第2ロジック・出来高リジェクトとは完全分離)
// ------------------------------------------------------------
bool fibCSessionOk = not useSessionFilter or inEU or inNY
bool fibCDailyRegimeOk = not useDailyRegimeFilter or drVolTextOut == "中ボラ"
float fibCLongStop = close - fibCSlFixed
float fibCLongRisk = close - fibCLongStop
float fibCLongTP   = close + fibCLongRisk * fibCRR
float fibCShortStop = close + fibCSlFixed
float fibCShortRisk = fibCShortStop - close
float fibCShortTP   = close - fibCShortRisk * fibCRR
float fibCLongQty  = f_qty(fibCLongRisk)
float fibCShortQty = f_qty(fibCShortRisk)
bool fibCBaseLong  = useFibCLogic and useLong and fibCDailyRegimeOk and fibCSessionOk and allowByNewsTime and envLongOk and allowLongByMomentum and allowLongByTrigger and volOk and fibCLongRisk > 0 and fibCLongQty >= 1
bool fibCBaseShort = useFibCLogic and useShort and fibCDailyRegimeOk and fibCSessionOk and allowByNewsTime and envShortOk and allowShortByMomentum and allowShortByTrigger and volOk and fibCShortRisk > 0 and fibCShortQty >= 1
bool fibCCanLong  = fibCBaseLong  and longFibZoneOk
bool fibCCanShort = fibCBaseShort and shortFibZoneOk
bool fibCCanLongRaw  = fibCBaseLong  and longFibZoneRawOk
bool fibCCanShortRaw = fibCBaseShort and shortFibZoneRawOk

// ------------------------------------------------------------
// セッション水平線反発 ロジック本体 (第3ロジック・ショートのみ)
// ------------------------------------------------------------
bool slrSessionOk = not useSessionFilter or inAsia or inNY
bool slrEnvShortOk = not useEnvFilter or (envRaw4H == 0 and envRaw1H == -1 and envRaw15M == 0)
bool slrDailyRegimeOk = not useDailyRegimeFilter or drVolTextOut == "低ボラ"
float slrShortStop = close + slrSlFixed
float slrShortRisk = slrShortStop - close
float slrShortTP   = close - slrShortRisk * slrRR
float slrShortQty  = f_qty(slrShortRisk)
bool slrCanShort = useSLRLogic and useShort and slrDailyRegimeOk and slrSessionOk and allowByNewsTime and slrEnvShortOk and slrShortZoneOk and allowShortByMomentum and allowShortByTrigger and volOk and slrShortRisk > 0 and slrShortQty >= 1

// ------------------------------------------------------------
// フィボA戦略 ロジック本体 (第4ロジック・ロング+ショート)
// ------------------------------------------------------------
bool fibASessionOk = not useSessionFilter or inEU or inNY
bool fibAEnvOk = not useEnvFilter or (envRaw4H == 0 and envRaw1H == 0 and envRaw15M == 0)
bool fibADailyRegimeOk = not useDailyRegimeFilter or drVolTextOut == "低ボラ"
float fibALongStop = close - fibASlFixed
float fibALongRisk = close - fibALongStop
float fibALongTP   = close + fibALongRisk * fibARR
float fibAShortStop = close + fibASlFixed
float fibAShortRisk = fibAShortStop - close
float fibAShortTP   = close - fibAShortRisk * fibARR
float fibALongQty  = f_qty(fibALongRisk)
float fibAShortQty = f_qty(fibAShortRisk)
bool fibABaseLong  = useFibALogic and useLong and fibADailyRegimeOk and fibASessionOk and allowByNewsTime and fibAEnvOk and allowLongByMomentum and allowLongByTrigger and volOk and fibALongRisk > 0 and fibALongQty >= 1
bool fibABaseShort = useFibALogic and useShort and fibADailyRegimeOk and fibASessionOk and allowByNewsTime and fibAEnvOk and allowShortByMomentum and allowShortByTrigger and volOk and fibAShortRisk > 0 and fibAShortQty >= 1
bool fibACanLong  = fibABaseLong  and longFibAZoneOk
bool fibACanShort = fibABaseShort and shortFibAZoneOk
bool fibACanLongRaw  = fibABaseLong  and longFibAZoneRawOk
bool fibACanShortRaw = fibABaseShort and shortFibAZoneRawOk

// ------------------------------------------------------------
// MACDヒスト拡大 ロジック本体 (第5ロジック・ロング+ショート)
// ------------------------------------------------------------
bool mhxSessionOk = not useSessionFilter or inAsia
bool mhxEnvOk = not useEnvFilter or (envRaw4H == 0 and envRaw1H == 0 and envRaw15M == 1)
bool mhxDailyRegimeOk = not useDailyRegimeFilter or drVolTextOut == "低ボラ"
float mhxLongStop = close - mhxSlFixed
float mhxLongRisk = close - mhxLongStop
float mhxLongTP   = close + mhxLongRisk * mhxRR
float mhxShortStop = close + mhxSlFixed
float mhxShortRisk = mhxShortStop - close
float mhxShortTP   = close - mhxShortRisk * mhxRR
float mhxLongQty  = f_qty(mhxLongRisk)
float mhxShortQty = f_qty(mhxShortRisk)
bool mhxCanLong  = useMHXLogic and useLong and mhxDailyRegimeOk and mhxSessionOk and allowByNewsTime and mhxEnvOk and mhxLongZoneOk and allowLongByTrigger and volOk and mhxLongRisk > 0 and mhxLongQty >= 1
bool mhxCanShort = useMHXLogic and useShort and mhxDailyRegimeOk and mhxSessionOk and allowByNewsTime and mhxEnvOk and mhxShortZoneOk and allowShortByTrigger and volOk and mhxShortRisk > 0 and mhxShortQty >= 1

// ------------------------------------------------------------
// MACD拡大/Div ロジック本体 (第6ロジック・ロング+ショート)
// ------------------------------------------------------------
bool mhdSessionOk = inAsia or inEU or inNY
// 共有 環境トレンド (envShared*) を再利用 (元の mhdRaw* と同一 request.security 呼び出し・値も同一)
int mhdRaw4H  = envShared4H
int mhdRaw1H  = envShared1H
int mhdRaw15M = envShared15M
bool mhdEnvOk = not na(mhdRaw4H) and not na(mhdRaw1H) and not na(mhdRaw15M) and mhdRaw4H == 0 and mhdRaw1H == 0 and mhdRaw15M == 1
var float mhdDayHigh = na
var float mhdDayLow  = na
bool mhdNewDay = ta.change(time("D")) != 0
bool mhdDayReset = mhdNewDay or na(mhdDayHigh)   // 条件を更新前に確定 (na判定順序を保持)
mhdDayHigh := mhdDayReset ? high : math.max(mhdDayHigh, high)
mhdDayLow  := mhdDayReset ? low  : math.min(mhdDayLow, low)
float mhdDayRange = mhdDayHigh - mhdDayLow
float mhdVolLo = math.min(dailyLowRangeMax, dailyHighRangeMin)
float mhdVolHi = math.max(dailyLowRangeMax, dailyHighRangeMin)
bool mhdDailyRegimeOk = not na(mhdDayRange) and mhdDayRange >= mhdVolLo and mhdDayRange < mhdVolHi
float mhdLongStop = close - mhdSlFixed
float mhdLongRisk = close - mhdLongStop
float mhdLongTP   = close + mhdLongRisk * mhdRR
float mhdShortStop = close + mhdSlFixed
float mhdShortRisk = mhdShortStop - close
float mhdShortTP   = close - mhdShortRisk * mhdRR
float mhdLongQty  = f_qty(mhdLongRisk)
float mhdShortQty = f_qty(mhdShortRisk)
bool mhdCanLong  = useMHDLogic and useLong and mhdDailyRegimeOk and mhdSessionOk and allowByNewsTime and mhdEnvOk and mhdLongZoneOk and allowLongByTrigger and volOk and mhdLongRisk > 0 and mhdLongQty >= 1
bool mhdCanShort = useMHDLogic and useShort and mhdDailyRegimeOk and mhdSessionOk and allowByNewsTime and mhdEnvOk and mhdShortZoneOk and allowShortByTrigger and volOk and mhdShortRisk > 0 and mhdShortQty >= 1

// ------------------------------------------------------------
// 水平線ブレイク ロジック本体 (第7ロジック・ロング+ショート)
// ------------------------------------------------------------
bool rlbSessionOk = inAsia or inEU or inNY
// 共有 環境トレンド (envShared*) を再利用 (元の rlbRaw* と同一 request.security 呼び出し・値も同一)
int rlbRaw4H  = envShared4H
int rlbRaw1H  = envShared1H
int rlbRaw15M = envShared15M
bool rlbEnvOk = not na(rlbRaw4H) and not na(rlbRaw1H) and not na(rlbRaw15M) and rlbRaw4H == 0 and rlbRaw1H == 1 and rlbRaw15M == 1
var float rlbDayHigh = na
var float rlbDayLow  = na
bool rlbNewDay = ta.change(time("D")) != 0
bool rlbDayReset = rlbNewDay or na(rlbDayHigh)   // 条件を更新前に確定 (na判定順序を保持)
rlbDayHigh := rlbDayReset ? high : math.max(rlbDayHigh, high)
rlbDayLow  := rlbDayReset ? low  : math.min(rlbDayLow, low)
float rlbDayRange = rlbDayHigh - rlbDayLow
float rlbVolLo = math.min(dailyLowRangeMax, dailyHighRangeMin)
bool rlbDailyRegimeOk = not na(rlbDayRange) and rlbDayRange < rlbVolLo
float rlbLongStop = close - rlbSlFixed
float rlbLongRisk = close - rlbLongStop
float rlbLongTP   = close + rlbLongRisk * rlbRR
float rlbShortStop = close + rlbSlFixed
float rlbShortRisk = rlbShortStop - close
float rlbShortTP   = close - rlbShortRisk * rlbRR
float rlbLongQty  = f_qty(rlbLongRisk)
float rlbShortQty = f_qty(rlbShortRisk)
bool rlbCanLong  = useRLBLogic and useLong and rlbDailyRegimeOk and rlbSessionOk and allowByNewsTime and rlbEnvOk and rlbLongZoneOk and allowLongByTrigger and volOk and rlbLongRisk > 0 and rlbLongQty >= 1
bool rlbCanShort = useRLBLogic and useShort and rlbDailyRegimeOk and rlbSessionOk and allowByNewsTime and rlbEnvOk and rlbShortZoneOk and allowShortByTrigger and volOk and rlbShortRisk > 0 and rlbShortQty >= 1

// ------------------------------------------------------------
// フィボB戦略 ロジック本体 (第8ロジック・ロング+ショート)
// ------------------------------------------------------------
bool fbbSessionOk = not useSessionFilter or inEU or inNY
bool fbbEnvOk = not useEnvFilter or (envRaw4H == 0 and envRaw1H == 1 and envRaw15M == 1)
bool fbbDailyRegimeOk = not useDailyRegimeFilter or drVolTextOut == "中ボラ"
float fbbLongStop = close - fbbSlFixed
float fbbLongRisk = close - fbbLongStop
float fbbLongTP   = close + fbbLongRisk * fbbRR
float fbbShortStop = close + fbbSlFixed
float fbbShortRisk = fbbShortStop - close
float fbbShortTP   = close - fbbShortRisk * fbbRR
float fbbLongQty  = f_qty(fbbLongRisk)
float fbbShortQty = f_qty(fbbShortRisk)
bool fbbBaseLong  = useFbbLogic and useLong and fbbDailyRegimeOk and fbbSessionOk and allowByNewsTime and fbbEnvOk and allowLongByMomentum and allowLongByTrigger and volOk and fbbLongRisk > 0 and fbbLongQty >= 1
bool fbbBaseShort = useFbbLogic and useShort and fbbDailyRegimeOk and fbbSessionOk and allowByNewsTime and fbbEnvOk and allowShortByMomentum and allowShortByTrigger and volOk and fbbShortRisk > 0 and fbbShortQty >= 1
bool fbbCanLong  = fbbBaseLong  and longFbbZoneOk
bool fbbCanShort = fbbBaseShort and shortFbbZoneOk
bool fbbCanLongRaw  = fbbBaseLong  and longFbbZoneRawOk
bool fbbCanShortRaw = fbbBaseShort and shortFbbZoneRawOk

// ============================================================
// 出力ヘルパー (価格整形 / alert本文 / ラベル本文)
// ============================================================
f_fmtP(float p) =>
    str.tostring(p, format.mintick)
f_fmtSize(float s) =>
    str.tostring(s, "#.##")

f_sigMsg(string state, string dir, float entry, float sl, float tp, float sz, string rankText, string logicName, string envT, string volT) =>
    "【" + (state == "仮" ? "仮シグナル" : "確定シグナル") + "】\n" +
     "状態: " + state + "\n" +
     "方向: " + dir + "\n" +
     "Entry: " + f_fmtP(entry) + "\n" +
     "SL: " + f_fmtP(sl) + "\n" +
     "TP: " + f_fmtP(tp) + "\n" +
     "Size: " + f_fmtSize(sz) + "\n" +
     "Rank: " + rankText + "\n" +
     "WinZone: " + logicName + "\n" +
     "環境: " + envT + "\n" +
     "日足ボラ: " + volT

f_labelText(string dir, float entry, float sl, float tp, float sz, string rankText, string logicName, string envT, string volT) =>
    "確定\n" +
     dir + "\n" +
     "Entry: " + f_fmtP(entry) + "\n" +
     "SL: " + f_fmtP(sl) + "\n" +
     "TP: " + f_fmtP(tp) + "\n" +
     "Size: " + f_fmtSize(sz) + "\n" +
     "Rank: " + rankText + "\n" +
     "WinZone: " + logicName + "\n" +
     "環境: " + envT + "\n" +
     "日足ボラ: " + volT

// ============================================================
// 【レイヤー5: 共通 仮想ポジション管理】(状態宣言 + 決済監視)
// ============================================================
var int   posDir   = 0    // 1=ロング / -1=ショート / 0=なし
var float posEntry = na
var float posSL    = na
var float posTP    = na
var float posQty   = na
var int   posLogic = 0    // エントリーしたロジックID
var int   posEntryBar = na
var bool  posActive = false

// 決済監視 (シグナル判定より前に実行 → 解除後に新セットアップの受付を可能にする)
if posActive and not na(posEntryBar) and bar_index > posEntryBar
    if posDir == 1
        if low <= posSL
            posActive := false
        else if high >= posTP
            posActive := false
    else if posDir == -1
        if high >= posSL
            posActive := false
        else if low <= posTP
            posActive := false

// ============================================================
// 【出来高リジェクト 専用 仮想ポジション】(元ストラテジー準拠・共通posと独立)
// ============================================================
var int   vrPosDir   = 0
var float vrPosEntry = na
var float vrPosSL    = na
var float vrPosTP    = na
var float vrPosQty   = na
var int   vrPosEntryBar = na
var bool  vrPosActive = false

// 出来高リジェクト専用 決済監視 (自分のSL/TPのみ。エントリー足では判定しない=bar_index>entryBar)
if vrPosActive and not na(vrPosEntryBar) and bar_index > vrPosEntryBar
    if vrPosDir == 1
        if low <= vrPosSL
            vrPosActive := false
        else if high >= vrPosTP
            vrPosActive := false
    else if vrPosDir == -1
        if high >= vrPosSL
            vrPosActive := false
        else if low <= vrPosTP
            vrPosActive := false

// ============================================================
// 【フィボC 専用 仮想ポジション】(元ストラテジー準拠・共通posと独立)
// ============================================================
var int   fibCPosDir   = 0
var float fibCPosEntry = na
var float fibCPosSL    = na
var float fibCPosTP    = na
var float fibCPosQty   = na
var int   fibCPosEntryBar = na
var bool  fibCPosActive = false

// フィボC専用 決済監視 (自分のSL/TPのみ。エントリー足では判定しない=bar_index>entryBar)
if fibCPosActive and not na(fibCPosEntryBar) and bar_index > fibCPosEntryBar
    if fibCPosDir == 1
        if low <= fibCPosSL
            fibCPosActive := false
        else if high >= fibCPosTP
            fibCPosActive := false
    else if fibCPosDir == -1
        if high >= fibCPosSL
            fibCPosActive := false
        else if low <= fibCPosTP
            fibCPosActive := false

// ============================================================
// 【セッション水平線反発 専用 仮想ポジション】(共通posと独立・ショートのみ)
// ============================================================
var int   slrPosDir   = 0
var float slrPosEntry = na
var float slrPosSL    = na
var float slrPosTP    = na
var float slrPosQty   = na
var int   slrPosEntryBar = na
var bool  slrPosActive = false

// SLR専用 決済監視 (ショートのみ。次バー以降。同一バーSL/TP両到達はSL優先)
if slrPosActive and not na(slrPosEntryBar) and bar_index > slrPosEntryBar
    if high >= slrPosSL
        slrPosActive := false
    else if low <= slrPosTP
        slrPosActive := false

// ============================================================
// 【フィボA戦略 専用 仮想ポジション】(共通posと独立・ロング+ショート)
// ============================================================
var int   fibAPosDir   = 0
var float fibAPosEntry = na
var float fibAPosSL    = na
var float fibAPosTP    = na
var float fibAPosQty   = na
var int   fibAPosEntryBar = na
var bool  fibAPosActive = false

// フィボA専用 決済監視 (自分のSL/TPのみ。エントリー足では判定しない。同一バーSL/TP両到達はSL優先)
if fibAPosActive and not na(fibAPosEntryBar) and bar_index > fibAPosEntryBar
    if fibAPosDir == 1
        if low <= fibAPosSL
            fibAPosActive := false
        else if high >= fibAPosTP
            fibAPosActive := false
    else if fibAPosDir == -1
        if high >= fibAPosSL
            fibAPosActive := false
        else if low <= fibAPosTP
            fibAPosActive := false

// ============================================================
// 【MACDヒスト拡大(MHX) 専用 仮想ポジション】(共通posと独立・ロング+ショート)
// ============================================================
var int   mhxPosDir   = 0
var float mhxPosEntry = na
var float mhxPosSL    = na
var float mhxPosTP    = na
var float mhxPosQty   = na
var int   mhxPosEntryBar = na
var bool  mhxPosActive = false

// MHX専用 決済監視 (自分のSL/TPのみ。同一バーSL/TP両到達はSL優先)
if mhxPosActive and not na(mhxPosEntryBar) and bar_index > mhxPosEntryBar
    if mhxPosDir == 1
        if low <= mhxPosSL
            mhxPosActive := false
        else if high >= mhxPosTP
            mhxPosActive := false
    else if mhxPosDir == -1
        if high >= mhxPosSL
            mhxPosActive := false
        else if low <= mhxPosTP
            mhxPosActive := false

// ============================================================
// 【MACD拡大/Div(MHD) 専用 仮想ポジション】(共通posと独立・ロング+ショート)
// ============================================================
var int   mhdPosDir   = 0
var float mhdPosEntry = na
var float mhdPosSL    = na
var float mhdPosTP    = na
var float mhdPosQty   = na
var int   mhdPosEntryBar = na
var bool  mhdPosActive = false

// MHD専用 決済監視 (自分のSL/TPのみ。同一バーSL/TP両到達はSL優先)
if mhdPosActive and not na(mhdPosEntryBar) and bar_index > mhdPosEntryBar
    if mhdPosDir == 1
        if low <= mhdPosSL
            mhdPosActive := false
        else if high >= mhdPosTP
            mhdPosActive := false
    else if mhdPosDir == -1
        if high >= mhdPosSL
            mhdPosActive := false
        else if low <= mhdPosTP
            mhdPosActive := false

// ============================================================
// 水平線ブレイク(RLB) 専用 仮想ポジション
// ============================================================
var int   rlbPosDir   = 0
var float rlbPosEntry = na
var float rlbPosSL    = na
var float rlbPosTP    = na
var float rlbPosQty   = na
var int   rlbPosEntryBar = na
var bool  rlbPosActive = false

// RLB専用 決済監視 (自分のSL/TPのみ。同一バーSL/TP両到達はSL優先)
if rlbPosActive and not na(rlbPosEntryBar) and bar_index > rlbPosEntryBar
    if rlbPosDir == 1
        if low <= rlbPosSL
            rlbPosActive := false
        else if high >= rlbPosTP
            rlbPosActive := false
    else if rlbPosDir == -1
        if high >= rlbPosSL
            rlbPosActive := false
        else if low <= rlbPosTP
            rlbPosActive := false

// ============================================================
// フィボB戦略(FBB) 専用 仮想ポジション
// ============================================================
var bool  fbbPosActive = false
var int   fbbPosDir   = 0
var float fbbPosEntry = na
var float fbbPosSL    = na
var float fbbPosTP    = na
var float fbbPosQty   = na
var int   fbbPosEntryBar = na

// FBB専用 決済監視 (自分のSL/TPのみ。同一バーSL/TP両到達はSL優先)
// 決済解除時は全フィールドを初期化 → 次の有効フィボ状態で再エントリー可能。
if fbbPosActive and not na(fbbPosEntryBar) and bar_index > fbbPosEntryBar
    bool _fbbExit = false
    if fbbPosDir == 1
        if low <= fbbPosSL
            _fbbExit := true
        else if high >= fbbPosTP
            _fbbExit := true
    else if fbbPosDir == -1
        if high >= fbbPosSL
            _fbbExit := true
        else if low <= fbbPosTP
            _fbbExit := true
    if _fbbExit
        fbbPosActive := false
        fbbPosDir := 0
        fbbPosEntry := na
        fbbPosSL := na
        fbbPosTP := na
        fbbPosQty := na
        fbbPosEntryBar := na

// ============================================================
// 【レイヤー4: 共通 仮/確定シグナル管理】(各ロジックを独立管理)
// ============================================================
bool is5m = timeframe.isminutes and timeframe.multiplier == 5

// 出来高リジェクト (元ストラテジーと同じ: 同一バー両成立は陽線→ロング / 陰線→ショート)
bool vrWantLong  = canLong
bool vrWantShort = canShort
if vrWantLong and vrWantShort
    if close >= open
        vrWantShort := false
    else
        vrWantLong := false

// フィボC
bool fibCWantLong  = fibCCanLong   // 確定用
bool fibCWantShort = fibCCanShort
if fibCWantLong and fibCWantShort
    if close >= open
        fibCWantShort := false
    else
        fibCWantLong := false
bool fibCWantLongRaw  = fibCCanLongRaw    // 仮用 (確定制限前)
bool fibCWantShortRaw = fibCCanShortRaw
if fibCWantLongRaw and fibCWantShortRaw
    if close >= open
        fibCWantShortRaw := false
    else
        fibCWantLongRaw := false

// フィボA戦略
bool fibAWantLong  = fibACanLong   // 確定用
bool fibAWantShort = fibACanShort
if fibAWantLong and fibAWantShort
    if close >= open
        fibAWantShort := false
    else
        fibAWantLong := false
bool fibAWantLongRaw  = fibACanLongRaw    // 仮用 (確定制限前)
bool fibAWantShortRaw = fibACanShortRaw
if fibAWantLongRaw and fibAWantShortRaw
    if close >= open
        fibAWantShortRaw := false
    else
        fibAWantLongRaw := false

// MACDヒスト拡大
bool mhxWantLong  = mhxCanLong
bool mhxWantShort = mhxCanShort
if mhxWantLong and mhxWantShort
    if close >= open
        mhxWantShort := false
    else
        mhxWantLong := false

// MACD拡大/Div
bool mhdWantLong  = mhdCanLong
bool mhdWantShort = mhdCanShort
if mhdWantLong and mhdWantShort
    if close >= open
        mhdWantShort := false
    else
        mhdWantLong := false

// 水平線ブレイク
bool rlbWantLong  = rlbCanLong
bool rlbWantShort = rlbCanShort
if rlbWantLong and rlbWantShort
    if close >= open
        rlbWantShort := false
    else
        rlbWantLong := false

// フィボB戦略
bool fbbWantLong  = fbbCanLong   // 確定用
bool fbbWantShort = fbbCanShort
if fbbWantLong and fbbWantShort
    if close >= open
        fbbWantShort := false
    else
        fbbWantLong := false
bool fbbWantLongRaw  = fbbCanLongRaw    // 仮用 (確定制限前)
bool fbbWantShortRaw = fbbCanShortRaw
if fbbWantLongRaw and fbbWantShortRaw
    if close >= open
        fbbWantShortRaw := false
    else
        fbbWantLongRaw := false

// セッション水平線反発 (ショートのみ・long/short 競合なし)
bool slrWantShort = slrCanShort

// ============================================================
// 【レイヤー6: 共通 ラベル / alert 出力】
// 各ロジックは独立発報 (claimed/共通pos/優先順位/セットアップIDに依存しない)。

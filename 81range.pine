lineFlipConfirmBars = input.int(2, "転換 確定本数", minval = 0, group = grpLineParam)
useLineBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター", group = grpLineParam)
lineBreakBodyRatio = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineParam)
lineSweepToleranceATR = input.float(0.5, "スイープ 最小貫通 ATR倍率", minval = 0.0, step = 0.05, group = grpLineParam)
lineBreakBufferMode = input.string("ATR", "ブレイク 最小バッファ方式", options = ["Dollar", "ATR", "None"], group = grpLineParam)
lineBreakBufferDollar = input.float(0.5, "ブレイク バッファ(ドル/価格)", minval = 0.0, step = 0.1, group = grpLineParam)
lineBreakBufferATR = input.float(0.10, "ブレイク バッファ ATR倍率", minval = 0.0, step = 0.05, group = grpLineParam)
lineBreakConfirmMode = input.string("CloseOnly", "ブレイク 確定方式", options = ["CloseOnly", "NextBar", "Consecutive"], group = grpLineParam)
lineBreakConfirmBars = input.int(2, "ブレイク 連続確定本数(Consecutive)", minval = 1, maxval = 10, group = grpLineParam)
lineSessionMaxDays = input.int(2, "セッション水平線 有効日数(当日含む)", minval = 1, maxval = 10, group = grpLineParam)

grpLineFilt = "水平線: 共通フィルター"
useLineDirCandleFilter = input.bool(false, "方向ローソク", group = grpLineFilt)
useLineWickFilter = input.bool(false, "ヒゲ確認", group = grpLineFilt)
useLineBodyFilter = input.bool(false, "実体率", group = grpLineFilt)
useLineATRFilter  = input.bool(false, "ATR(値幅)", group = grpLineFilt)
lineBodyRatioMin  = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineFilt)
lineAtrMinMult    = input.float(0.5, "最小値幅 ATR倍率", minval = 0.0, step = 0.05, group = grpLineFilt)

grpLineZone = "水平線: ゾーン"
useLineATRZone   = input.bool(false, "ゾーン幅をATR連動にする", group = grpLineZone)
lineZoneATRMult  = input.float(0.25, "ゾーン幅 ATR倍率", step = 0.05, group = grpLineZone)
lineZoneFixedWidth = input.float(0.1, "ゾーン幅 固定", step = 0.1, group = grpLineZone)
useLineMergeZone = input.bool(false, "近い水平線をゾーン統合する", group = grpLineZone)
lineMergeToleranceATR = input.float(0.2, "統合許容幅 ATR倍率", step = 0.05, group = grpLineZone)

grpLineSess = "水平線: セッション"
lineSessTZ    = input.string("GMT", "セッション タイムゾーン", group = grpLineSess)
lineAsiaSess  = input.session("0000-0800", "Asia", group = grpLineSess)
lineLondonSess = input.session("0700-1600", "London", group = grpLineSess)
lineNySess    = input.session("1200-2100", "New York", group = grpLineSess)

grpLineObs = "水平線: 障害物"
useLineObstacleFilter = input.bool(false, "水平線障害物フィルターを使う", group = grpLineObs)
lineObstacleATR = input.float(0.5, "障害物 近接 ATR倍率", step = 0.05, group = grpLineObs)

grpLineState = "水平線: 状態管理"
useLineStateWindow = input.bool(true, "水平線状態管理を使う", group = grpLineState)
lineStateMaxBars   = input.int(3, "水平線状態 有効本数", minval = 1, group = grpLineState)
resetLineStateAfterEntry = input.bool(true, "エントリー後水平線状態をリセット", group = grpLineState)

grpMACDSet = "Momentum: MACD 設定"
macdFastLen   = input.int(8, "Fast EMA", minval = 1, group = grpMACDSet)
macdSlowLen   = input.int(21, "Slow EMA", minval = 1, group = grpMACDSet)
macdSignalLen = input.int(5, "Signal EMA", minval = 1, group = grpMACDSet)

grpMACDDiv = "Momentum: MACD Divergence"
macdDivPivotLen = input.int(3, "Pivot 長さ", minval = 1, group = grpMACDDiv)
macdDivLookback = input.int(50, "Pivot 間 最大本数", minval = 1, group = grpMACDDiv)

// ============================================================
// 【レイヤー1: 共通計算】 以降はロジック共通の計算。
// 各モジュールは1回だけ計算し、結果を bool/数値として再利用する。
// ============================================================

// ============================================================
// 5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open, close)
float curBodyLo  = math.min(open, close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
// 5b. FVG 場所検知 (フィルター用)
// ============================================================
bool useFVGWZ  = useWinZoneModule and useFVGWinZone and (winZoneMode == "FVG_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useVolume = useWinZoneModule and useVolumeWinZone and (winZoneMode == "VOLUME_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useFibWZ  = useWinZoneModule and useFibWinZone and (winZoneMode == "FIB_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// フィボC (第2ロジック) は winZoneMode / useFibWinZone に依存せずフィボ計算を必要とする。
//   ・共有WinZone結合用の useFibWZ は一切変更しない (出来高リジェクトの結合は不変)。
//   ・フィボ計算の実行可否だけを useFibCalc として分離し、フィボC用に常時計算する。
bool useFibCLogicNeedsFib = true
bool useFibCalc = useFibWZ or useFibCLogicNeedsFib
bool useLineWZ = useWinZoneModule and useLineModule and useLineWinZone and (winZoneMode == "LINE_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useEMAWZ  = useWinZoneModule and useEMAWinZone and useEMAModule and (winZoneMode == "EMA_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useFVG    = useFVGWZ

// ============================================================
// 5b-2. 出来高 / VPVR / POC モジュール (WinZone 場所条件) ★本ロジックの中核
// ============================================================
f_poc(lookback, bins) =>
    float hi = ta.highest(high, lookback)
    float lo = ta.lowest(low, lookback)
    float rangeAll = hi - lo
    float poc = close
    if rangeAll > 0 and bins > 0 and bar_index >= lookback
        array<float> bv = array.new_float(bins, 0.0)
        float bs = rangeAll / bins
        for k = 0 to lookback - 1
            float ch = high[k]
            float cl = low[k]
            float cv = volume[k]
            if not na(ch) and not na(cl) and not na(cv)
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    for bi = 0 to bins - 1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
        float best = -1.0
        int bestI = 0
        for bi = 0 to bins - 1
            float v = array.get(bv, bi)
            if v > best
                best := v
                bestI := bi
        poc := lo + (bestI + 0.5) * bs
    poc

// --- 出来高/POC モジュール本体を関数化 (判定式・数値・状態は不変) ---
// 内部 var (abovePocCnt/belowPocCnt) は関数ローカルへ。外部参照する longVolumeOk/shortVolumeOk を返す。
f_calcVolumePOC() =>
    bool longVolumeOk  = false
    bool shortVolumeOk = false

    if useVolume
        float v_atr     = ta.atr(volAtrLen)
        float v_rng     = high - low
        float v_body    = math.abs(close - open)
        float v_upWick  = high - math.max(close, open)
        float v_dnWick  = math.min(close, open) - low
        float v_clPos   = v_rng > 0 ? (close - low) / v_rng : 0.5
        float v_bodyRatio = v_rng > 0 ? v_body / v_rng : 0.0
        float v_volSMA  = ta.sma(volume, volumeSmaLen)
        float poc = f_poc(vpLookback, vpBins)
        float pw  = useVolAdaptivePOCWidth ? v_atr * pocZoneATRMult : pocZoneWidth
        float pUp = poc + pw
        float pLo = poc - pw
        bool  pocActive = not na(poc) and (pUp > pLo)
        float pocFull   = pUp - pLo

        bool liqOK = not useLowVolumeFilter or (not na(v_volSMA) and volume >= v_volSMA * lowVolumeMult)
        bool smaOK = not useVolumeSMAFilter or (not na(v_volSMA) and volume > v_volSMA)
        bool bOK   = not useBodyFilter or v_bodyRatio >= bodyRatioMin
        bool fOK   = liqOK and smaOK and bOK

        bool cameBelow = ta.lowest(close, crossLookback) <= pLo
        bool cameAbove = ta.highest(close, crossLookback) >= pUp
        bool accBuyConf  = (not useDirCandleForAcceptance or close > open) and (not useVolumeConfirmForAcceptance or (not na(v_volSMA) and volume > v_volSMA))
        bool accSellConf = (not useDirCandleForAcceptance or close < open) and (not useVolumeConfirmForAcceptance or (not na(v_volSMA) and volume > v_volSMA))
        var int abovePocCnt = 0
        var int belowPocCnt = 0
        abovePocCnt := close > pUp ? abovePocCnt + 1 : 0
        belowPocCnt := close < pLo ? belowPocCnt + 1 : 0
        bool accBuyCore  = pocActive and cameBelow and abovePocCnt >= acceptBars and accBuyConf
        bool accSellCore = pocActive and cameAbove and belowPocCnt >= acceptBars and accSellConf
        bool accBuyEvt   = accBuyCore  and not accBuyCore[1]
        bool accSellEvt  = accSellCore and not accSellCore[1]
        bool _accB = fOK and usePOCAcceptance and accBuyEvt
        bool _accS = fOK and usePOCAcceptance and accSellEvt
        bool buyAccept  = _accB and (not useFirstSignalOnly or not _accB[1])
        bool sellAccept = _accS and (not useFirstSignalOnly or not _accS[1])

        bool trendL = not useTrendFilter or allowTrendLong
        bool trendS = not useTrendFilter or allowTrendShort
        bool rjTouchBuy = low <= pUp
        float rjDepthBuy = (low < pLo and pocFull > 0) ? (pLo - low) / pocFull : 0.0
        bool rjConfBuy = (not usePOCRejectCandleConfirm or close > open) and (not usePOCRejectWickConfirm or v_dnWick >= v_body) and (not usePOCRejectCloseEdgeConfirm or v_clPos >= 0.5)
        bool rejBuyCore = pocActive and rjTouchBuy and rjDepthBuy <= pocRejectDepthMax and close > pLo and rjConfBuy
        bool rjTouchSell = high >= pLo
        float rjDepthSell = (high > pUp and pocFull > 0) ? (high - pUp) / pocFull : 0.0
        bool rjConfSell = (not usePOCRejectCandleConfirm or close < open) and (not usePOCRejectWickConfirm or v_upWick >= v_body) and (not usePOCRejectCloseEdgeConfirm or v_clPos <= 0.5)
        bool rejSellCore = pocActive and rjTouchSell and rjDepthSell <= pocRejectDepthMax and close < pUp and rjConfSell
        bool _rejB = fOK and usePOCReject and trendL and rejBuyCore
        bool _rejS = fOK and usePOCReject and trendS and rejSellCore
        bool buyReject  = _rejB and (not useFirstSignalOnly or not _rejB[1])
        bool sellReject = _rejS and (not useFirstSignalOnly or not _rejS[1])

        float rHigh = ta.highest(high, breakoutLookback)[1]
        float rLow  = ta.lowest(low,  breakoutLookback)[1]
        bool  volSpike  = not na(v_volSMA) and volume > v_volSMA * volumeSpikeMult
        bool  atrExpand = v_atr > nz(v_atr[breakoutLookback]) * atrExpansionMult
        bool  compressed = (ta.highest(high, compressionLookback) - ta.lowest(low, compressionLookback)) <= v_atr * compressionATRMult
        bool brkBuyCore  = not na(rHigh) and close > rHigh and volSpike and v_bodyRatio >= breakoutBodyRatioMin and (not useATRExpansionFilter or atrExpand) and (not useCompressionFilter or compressed[1])
        bool brkSellCore = not na(rLow)  and close < rLow  and volSpike and v_bodyRatio >= breakoutBodyRatioMin and (not useATRExpansionFilter or atrExpand) and (not useCompressionFilter or compressed[1])
        bool _brkB = fOK and useVolumeBreakout and brkBuyCore
        bool _brkS = fOK and useVolumeBreakout and brkSellCore
        bool buyBreak  = _brkB and (not useFirstSignalOnly or not _brkB[1])
        bool sellBreak = _brkS and (not useFirstSignalOnly or not _brkS[1])

        bool climaxVol = not na(v_volSMA) and volume > v_volSMA * climaxVolumeMult
        bool newLow  = low  <= ta.lowest(low,  climaxLookback)
        bool newHigh = high >= ta.highest(high, climaxLookback)
        bool climaxBuyCore  = climaxVol and v_rng > 0 and v_dnWick >= v_rng * climaxWickRatio and newLow  and v_clPos >= (1.0 - climaxCloseEdgeRatio)
        bool climaxSellCore = climaxVol and v_rng > 0 and v_upWick >= v_rng * climaxWickRatio and newHigh and v_clPos <= climaxCloseEdgeRatio
        bool _clmB = fOK and useClimaxReversal and climaxBuyCore
        bool _clmS = fOK and useClimaxReversal and climaxSellCore
        bool buyClimax  = _clmB and (not useFirstSignalOnly or not _clmB[1])
        bool sellClimax = _clmS and (not useFirstSignalOnly or not _clmS[1])

        int vType = (buyClimax or sellClimax) ? 4 : (buyAccept or sellAccept) ? 1 : (buyBreak or sellBreak) ? 3 : (buyReject or sellReject) ? 2 : 0
        int vDir = vType == 4 ? (buyClimax ? 1 : -1) : vType == 1 ? (buyAccept ? 1 : -1) : vType == 3 ? (buyBreak ? 1 : -1) : vType == 2 ? (buyReject ? 1 : -1) : 0
        bool vSig = vType != 0

        longVolumeOk  := vSig and vDir == 1
        shortVolumeOk := vSig and vDir == -1
    [longVolumeOk, shortVolumeOk]

[longVolumeOk, shortVolumeOk] = f_calcVolumePOC()
var bool longVolumeStateOk  = false
var bool shortVolumeStateOk = false
var int  longVolumeStateBar  = na
var int  shortVolumeStateBar = na
if useVolumeStateWindow
    longVolumeStateBar  := longVolumeOk  ? bar_index : longVolumeStateBar
    shortVolumeStateBar := shortVolumeOk ? bar_index : shortVolumeStateBar
    longVolumeStateOk  := (longVolumeStateOk  or longVolumeOk)  and (na(longVolumeStateBar)  or not (bar_index - longVolumeStateBar  > volumeStateMaxBars))
    shortVolumeStateOk := (shortVolumeStateOk or shortVolumeOk) and (na(shortVolumeStateBar) or not (bar_index - shortVolumeStateBar > volumeStateMaxBars))

bool longVolumeZoneOk  = not useVolume ? false : useVolumeStateWindow ? longVolumeStateOk  : longVolumeOk
bool shortVolumeZoneOk = not useVolume ? false : useVolumeStateWindow ? shortVolumeStateOk : shortVolumeOk

// ============================================================
// 5b-2b. フィボ WinZone モジュール
// ============================================================
f_fibRank(float pct, float bufPct) =>
    int r = 0
    if not na(pct)
        if useRankA and pct >= fibAStart - bufPct and pct <= fibAEnd + bufPct
            r := 3
        else if useRankB and pct >= fibBStart - bufPct and pct < fibBEnd + bufPct
            r := 2
        else if useRankC and pct >= fibCStart - bufPct and pct < fibCEnd + bufPct
            r := 1
    r

// --- フィボ モジュール本体を関数化 (波検出/範囲/無効/反転確認/フィボA帯 は完全に不変) ---
// 内部 var (lastPH/lastPL 等) は関数ローカルへ (元も if 内 var)。外部参照する10出力をタプルで返す。
f_calcFib() =>
    bool fibBuySignal        = false
    bool fibSellSignal       = false
    bool fibBuyConditionRaw  = false
    bool fibSellConditionRaw = false
    bool fibInvalidBuy       = false
    bool fibInvalidSell      = false
    bool fibBuySignalA        = false
    bool fibSellSignalA       = false
    bool fibBuyConditionRawA  = false
    bool fibSellConditionRawA = false
    // フィボB(FBB)専用: 反転確認OFF固定 (useRejectConfirm に依存しない) のAランク帯条件
    bool fbbBuyRawA  = false
    bool fbbSellRawA = false
    bool fbbBuySigA  = false
    bool fbbSellSigA = false

    if useFibCalc
        float _atr   = ta.atr(fibAtrLen)
        float _ema20 = ta.ema(close, fibEma20Len)
        float _ph = ta.pivothigh(high, swingLookback, swingLookback)
        float _pl = ta.pivotlow(low,  swingLookback, swingLookback)
        var float lastPH    = na
        var int   lastPHbar = na
        var float lastPL    = na
        var int   lastPLbar = na
        if not na(_ph)
            lastPH := _ph
            lastPHbar := bar_index - swingLookback
        if not na(_pl)
            lastPL := _pl
            lastPLbar := bar_index - swingLookback
        bool bothPivots = not na(lastPH) and not na(lastPL)
        bool downWaveValid = bothPivots and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)
        bool upWaveValid   = bothPivots and (lastPLbar < lastPHbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPLbar) <= waveLookback)
        float sSwingHigh = lastPH
        float sSwingLow  = lastPL
        float sRange = sSwingHigh - sSwingLow
        float bSwingHigh = lastPH
        float bSwingLow  = lastPL
        float bRange = bSwingHigh - bSwingLow
        float buf = _atr * fibZoneBufferATR
        float sBufPct = sRange > 0 ? buf / sRange : 0.0
        float bBufPct = bRange > 0 ? buf / bRange : 0.0
        float sRetracePct = downWaveValid and sRange > 0 ? math.max(0.0, math.min(1.0, (high - sSwingLow) / sRange)) : na
        float bRetracePct = upWaveValid and bRange > 0 ? math.max(0.0, math.min(1.0, (bSwingHigh - low) / bRange)) : na
        int sRank = f_fibRank(sRetracePct, sBufPct)
        int bRank = f_fibRank(bRetracePct, bBufPct)
        float sZoneLowPrice  = sSwingLow + fibCStart * sRange
        float sZoneHighPrice = sSwingLow + fibAEnd   * sRange
        float sDeepLimit     = sSwingLow + fibAEnd   * sRange
        float bZoneHighPrice = bSwingHigh - fibCStart * bRange
        float bZoneLowPrice  = bSwingHigh - fibAEnd   * bRange
        float bDeepLimit     = bSwingHigh - fibAEnd   * bRange
        bool priceInSellZone = downWaveValid and sRank > 0 and (high >= sZoneLowPrice - buf) and (low <= sZoneHighPrice + buf)
        bool priceInBuyZone  = upWaveValid   and bRank > 0 and (low <= bZoneHighPrice + buf) and (high >= bZoneLowPrice - buf)
        float _body     = math.abs(close - open)
        float _bodyPrev = math.abs(close[1] - open[1])
        float _upWick   = high - math.max(close, open)
        float _loWick   = math.min(close, open) - low
        bool _bearCandle   = close < open
        bool _upPinbar     = _body > 0 and _upWick >= pinbarWickRatio * _body and _upWick > _loWick
        bool _fibBearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1] and _body >= engulfingBodyRatio * _bodyPrev
        bool _breakPrevLow = low < low[1]
        bool sellConfirm = (useCandleConfirm and _bearCandle) or (usePinbarConfirm and _upPinbar) or (useEngulfingConfirm and _fibBearEngulf) or (useEma20Confirm and close < _ema20) or (useBreakPrevConfirm and _breakPrevLow)
        bool _bullCandle   = close > open
        bool _dnPinbar     = _body > 0 and _loWick >= pinbarWickRatio * _body and _loWick > _upWick
        bool _fibBullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1] and _body >= engulfingBodyRatio * _bodyPrev
        bool _breakPrevHigh = high > high[1]
        bool buyConfirm = (useCandleConfirm and _bullCandle) or (usePinbarConfirm and _dnPinbar) or (useEngulfingConfirm and _fibBullEngulf) or (useEma20Confirm and close > _ema20) or (useBreakPrevConfirm and _breakPrevHigh)
        bool invSell = downWaveValid and ((useDeepLimitInvalid and close > sDeepLimit) or (useOriginInvalid and close > sSwingHigh) or (useEMASettleInvalid and close > _ema20 and close[1] > _ema20))
        bool invBuy  = upWaveValid   and ((useDeepLimitInvalid and close < bDeepLimit) or (useOriginInvalid and close < bSwingLow)  or (useEMASettleInvalid and close < _ema20 and close[1] < _ema20))
        fibInvalidSell := invSell
        fibInvalidBuy  := invBuy
        bool confirmedOK = not requireConfirmedBar or barstate.isconfirmed
        bool sellSetup = useFibSell and priceInSellZone and not invSell
        bool buySetup  = useFibBuy  and priceInBuyZone  and not invBuy
        bool _fibBuyRaw  = buySetup  and (not useRejectConfirm or buyConfirm)
        bool _fibSellRaw = sellSetup and (not useRejectConfirm or sellConfirm)
        fibBuyConditionRaw  := _fibBuyRaw
        fibSellConditionRaw := _fibSellRaw
        fibSellSignal := _fibSellRaw and confirmedOK
        fibBuySignal  := _fibBuyRaw  and confirmedOK
        float _sZoneLoA = sSwingLow  + fibAStart * sRange
        float _sZoneHiA = sSwingLow  + fibAEnd   * sRange
        float _bZoneHiA = bSwingHigh - fibAStart * bRange
        float _bZoneLoA = bSwingHigh - fibAEnd   * bRange
        bool _sInBandA = downWaveValid and not na(sRetracePct) and sRetracePct >= fibAStart - sBufPct and sRetracePct <= fibAEnd + sBufPct
        bool _bInBandA = upWaveValid   and not na(bRetracePct) and bRetracePct >= fibAStart - bBufPct and bRetracePct <= fibAEnd + bBufPct
        bool _priceInSellA = downWaveValid and _sInBandA and (high >= _sZoneLoA - buf) and (low <= _sZoneHiA + buf)
        bool _priceInBuyA  = upWaveValid   and _bInBandA and (low <= _bZoneHiA + buf) and (high >= _bZoneLoA - buf)
        bool _sellSetupA = useFibSell and _priceInSellA and not invSell
        bool _buySetupA  = useFibBuy  and _priceInBuyA  and not invBuy
        fibBuyConditionRawA  := _buySetupA  and (not useRejectConfirm or buyConfirm)
        fibSellConditionRawA := _sellSetupA and (not useRejectConfirm or sellConfirm)
        fibBuySignalA  := fibBuyConditionRawA  and confirmedOK
        fibSellSignalA := fibSellConditionRawA and confirmedOK
        // FBB専用: 反転確認OFF固定 → confirm項を通さず setup のみ (波検出/無効条件は共通再利用)
        fbbBuyRawA  := _buySetupA
        fbbSellRawA := _sellSetupA
        fbbBuySigA  := _buySetupA  and confirmedOK
        fbbSellSigA := _sellSetupA and confirmedOK
    [fibBuySignal, fibSellSignal, fibBuyConditionRaw, fibSellConditionRaw, fibInvalidBuy, fibInvalidSell, fibBuySignalA, fibSellSignalA, fibBuyConditionRawA, fibSellConditionRawA, fbbBuyRawA, fbbSellRawA, fbbBuySigA, fbbSellSigA]

[fibBuySignal, fibSellSignal, fibBuyConditionRaw, fibSellConditionRaw, fibInvalidBuy, fibInvalidSell, fibBuySignalA, fibSellSignalA, fibBuyConditionRawA, fibSellConditionRawA, fbbBuyRawA, fbbSellRawA, fbbBuySigA, fbbSellSigA] = f_calcFib()
bool longFibOk  = fibBuySignal
bool shortFibOk = fibSellSignal

var bool longFibStateOk  = false
var bool shortFibStateOk = false
var int  longFibStateBar  = na
var int  shortFibStateBar = na
if useFibCalc and useFibStateWindow
    // set → expiry → invalid の順序を保ったまま直接代入化 (意味不変)
    longFibStateBar  := fibBuySignal  ? bar_index : longFibStateBar
    shortFibStateBar := fibSellSignal ? bar_index : shortFibStateBar
    longFibStateOk  := (longFibStateOk  or fibBuySignal)  and (na(longFibStateBar)  or not (bar_index - longFibStateBar  > fibStateMaxBars))
    shortFibStateOk := (shortFibStateOk or fibSellSignal) and (na(shortFibStateBar) or not (bar_index - shortFibStateBar > fibStateMaxBars))
    longFibStateOk  := fibInvalidBuy  ? false : longFibStateOk
    longFibStateBar := fibInvalidBuy  ? na    : longFibStateBar
    shortFibStateOk  := fibInvalidSell ? false : shortFibStateOk
    shortFibStateBar := fibInvalidSell ? na    : shortFibStateBar

bool longFibZoneOk  = not useFibCalc ? false : useFibStateWindow ? longFibStateOk  : fibBuySignal
bool shortFibZoneOk = not useFibCalc ? false : useFibStateWindow ? shortFibStateOk : fibSellSignal

// --- フィボ 状態管理 (仮シグナル用・確定制限前 raw) ---
var bool longFibStateRawOk  = false
var bool shortFibStateRawOk = false
var int  longFibStateRawBar  = na
var int  shortFibStateRawBar = na
if useFibCalc and useFibStateWindow
    longFibStateRawBar  := fibBuyConditionRaw  ? bar_index : longFibStateRawBar
    shortFibStateRawBar := fibSellConditionRaw ? bar_index : shortFibStateRawBar
    longFibStateRawOk  := (longFibStateRawOk  or fibBuyConditionRaw)  and (na(longFibStateRawBar)  or not (bar_index - longFibStateRawBar  > fibStateMaxBars))
    shortFibStateRawOk := (shortFibStateRawOk or fibSellConditionRaw) and (na(shortFibStateRawBar) or not (bar_index - shortFibStateRawBar > fibStateMaxBars))
    longFibStateRawOk  := fibInvalidBuy  ? false : longFibStateRawOk
    longFibStateRawBar := fibInvalidBuy  ? na    : longFibStateRawBar
    shortFibStateRawOk  := fibInvalidSell ? false : shortFibStateRawOk
    shortFibStateRawBar := fibInvalidSell ? na    : shortFibStateRawBar

// フィボ raw 場所条件 (仮用。状態管理ON=状態フラグ / OFF=raw単バー / 未使用=false)
bool longFibZoneRawOk  = not useFibCalc ? false : useFibStateWindow ? longFibStateRawOk  : fibBuyConditionRaw
bool shortFibZoneRawOk = not useFibCalc ? false : useFibStateWindow ? shortFibStateRawOk : fibSellConditionRaw

// ============================================================
// フィボA戦略 専用 状態管理 (確定側 / raw側) — フィボC状態には一切干渉しない
// ============================================================
int fibAStateMaxBars = 5
var bool longFibAStateOk  = false
var bool shortFibAStateOk = false
var int  longFibAStateBar  = na
var int  shortFibAStateBar = na
var bool longFibAStateRawOk  = false
var bool shortFibAStateRawOk = false
var int  longFibAStateRawBar  = na
var int  shortFibAStateRawBar = na
if useFibCalc
    // 確定側 set→expiry→invalid
    longFibAStateBar  := fibBuySignalA  ? bar_index : longFibAStateBar
    shortFibAStateBar := fibSellSignalA ? bar_index : shortFibAStateBar
    longFibAStateOk  := (longFibAStateOk  or fibBuySignalA)  and (na(longFibAStateBar)  or not (bar_index - longFibAStateBar  > fibAStateMaxBars))
    shortFibAStateOk := (shortFibAStateOk or fibSellSignalA) and (na(shortFibAStateBar) or not (bar_index - shortFibAStateBar > fibAStateMaxBars))
    longFibAStateOk  := fibInvalidBuy  ? false : longFibAStateOk
    longFibAStateBar := fibInvalidBuy  ? na    : longFibAStateBar
    shortFibAStateOk  := fibInvalidSell ? false : shortFibAStateOk
    shortFibAStateBar := fibInvalidSell ? na    : shortFibAStateBar
    // raw側 set→expiry→invalid
    longFibAStateRawBar  := fibBuyConditionRawA  ? bar_index : longFibAStateRawBar
    shortFibAStateRawBar := fibSellConditionRawA ? bar_index : shortFibAStateRawBar
    longFibAStateRawOk  := (longFibAStateRawOk  or fibBuyConditionRawA)  and (na(longFibAStateRawBar)  or not (bar_index - longFibAStateRawBar  > fibAStateMaxBars))
    shortFibAStateRawOk := (shortFibAStateRawOk or fibSellConditionRawA) and (na(shortFibAStateRawBar) or not (bar_index - shortFibAStateRawBar > fibAStateMaxBars))
    longFibAStateRawOk  := fibInvalidBuy  ? false : longFibAStateRawOk
    longFibAStateRawBar := fibInvalidBuy  ? na    : longFibAStateRawBar
    shortFibAStateRawOk  := fibInvalidSell ? false : shortFibAStateRawOk
    shortFibAStateRawBar := fibInvalidSell ? na    : shortFibAStateRawBar

bool longFibAZoneOk     = useFibCalc ? longFibAStateOk     : false
bool shortFibAZoneOk    = useFibCalc ? shortFibAStateOk    : false
bool longFibAZoneRawOk  = useFibCalc ? longFibAStateRawOk  : false
bool shortFibAZoneRawOk = useFibCalc ? shortFibAStateRawOk : false

// ============================================================
// フィボB戦略 専用 状態管理 (Aランク帯 0.618-0.786 を使うが表示ランクはB)
//   自己完結・固定値: 状態保持5本 / 反転確認OFF (useRejectConfirm 非依存) /
//   fbb専用のAランク帯no-confirm条件 (fbbBuySigA 等) を使用。
//   共通の useRankA/B/C・useFibWinZone・winZoneMode・fibStateMaxBars・useRejectConfirm を
//   変更してもFBB結果は変わらない (波検出/無効条件のみ既存共通計算を再利用)。
// ============================================================
int fbbStateMaxBars = 5
var bool longFbbStateOk  = false
var bool shortFbbStateOk = false
var int  longFbbStateBar  = na
var int  shortFbbStateBar = na
var bool longFbbStateRawOk  = false
var bool shortFbbStateRawOk = false
var int  longFbbStateRawBar  = na
var int  shortFbbStateRawBar = na
if useFibCalc
    // 確定側 set→expiry→invalid
    longFbbStateBar  := fbbBuySigA  ? bar_index : longFbbStateBar
    shortFbbStateBar := fbbSellSigA ? bar_index : shortFbbStateBar
    longFbbStateOk  := (longFbbStateOk  or fbbBuySigA)  and (na(longFbbStateBar)  or not (bar_index - longFbbStateBar  > fbbStateMaxBars))
    shortFbbStateOk := (shortFbbStateOk or fbbSellSigA) and (na(shortFbbStateBar) or not (bar_index - shortFbbStateBar > fbbStateMaxBars))
    longFbbStateOk  := fibInvalidBuy  ? false : longFbbStateOk
    longFbbStateBar := fibInvalidBuy  ? na    : longFbbStateBar
    shortFbbStateOk  := fibInvalidSell ? false : shortFbbStateOk
    shortFbbStateBar := fibInvalidSell ? na    : shortFbbStateBar
    // raw側 set→expiry→invalid
    longFbbStateRawBar  := fbbBuyRawA  ? bar_index : longFbbStateRawBar
    shortFbbStateRawBar := fbbSellRawA ? bar_index : shortFbbStateRawBar
    longFbbStateRawOk  := (longFbbStateRawOk  or fbbBuyRawA)  and (na(longFbbStateRawBar)  or not (bar_index - longFbbStateRawBar  > fbbStateMaxBars))
    shortFbbStateRawOk := (shortFbbStateRawOk or fbbSellRawA) and (na(shortFbbStateRawBar) or not (bar_index - shortFbbStateRawBar > fbbStateMaxBars))
    longFbbStateRawOk  := fibInvalidBuy  ? false : longFbbStateRawOk
    longFbbStateRawBar := fibInvalidBuy  ? na    : longFbbStateRawBar
    shortFbbStateRawOk  := fibInvalidSell ? false : shortFbbStateRawOk
    shortFbbStateRawBar := fibInvalidSell ? na    : shortFbbStateRawBar

bool longFbbZoneOk     = useFibCalc ? longFbbStateOk     : false
bool shortFbbZoneOk    = useFibCalc ? shortFbbStateOk    : false
bool longFbbZoneRawOk  = useFibCalc ? longFbbStateRawOk  : false
bool shortFbbZoneRawOk = useFibCalc ? shortFbbStateRawOk : false

// ============================================================
// 5b-2f. 水平線 WinZone (削除済み・現在OFF)
// ------------------------------------------------------------
// useLineWinZone=false のため未使用。lineNoTradeLong/Short は常に false だったため定数化。
// ※ 水平線ブレイク(RLB)・セッション水平線反発(SLR) は別モジュールなので影響なし。
// ============================================================
bool lineNoTradeLong  = false
bool lineNoTradeShort = false

// ============================================================
// 5b-3. WinZone 結合
// ============================================================
// FVG/EMA/水平線 WinZone は削除済み (現在OFFでバイパス済み)。出来高/フィボのみで結合。
bool longWinZoneOk = not useWinZoneModule ? true :
     winZoneMode == "VOLUME_ONLY" ? longVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? longFibZoneOk :
     winZoneMode == "OR"          ? ((useVolumeWinZone and longVolumeZoneOk) or (useFibWinZone and longFibZoneOk)) :
     winZoneMode == "AND"         ? ((not useVolumeWinZone or longVolumeZoneOk) and (not useFibWinZone or longFibZoneOk)) :
     true

bool shortWinZoneOk = not useWinZoneModule ? true :
     winZoneMode == "VOLUME_ONLY" ? shortVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? shortFibZoneOk :
     winZoneMode == "OR"          ? ((useVolumeWinZone and shortVolumeZoneOk) or (useFibWinZone and shortFibZoneOk)) :
     winZoneMode == "AND"         ? ((not useVolumeWinZone or shortVolumeZoneOk) and (not useFibWinZone or shortFibZoneOk)) :
     true

// ============================================================
// 5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any" ? cnt >= 1 : triggerMode == "All" ? (enabled > 0 and cnt >= enabled) : cnt >= minTriggerCount

f_calcTriggers() =>
    float _body = math.abs(close - open)
    float _range = high - low
    float _upWick = high - math.max(open, close)
    float _loWick = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos = _range > 0 ? (close - low) / _range : 0.0
    bool _pUp = close[1] > open[1]
    bool _pDn = close[1] < open[1]
    float _cHi = math.max(open, close)
    float _cLo = math.min(open, close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk = not useEngulfBodyRatioFilter or (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk = not useEngulfBodyQualityFilter or (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk = not useEngulfBodyAtrFilter or _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk = _engulfRatioOk and _engulfBodyQualityOk and _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk = not usePinRangeFilter or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope > _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

float trBody = math.abs(close - open)
float trRange = high - low
float trUpWick = high - math.max(open, close)
float trLoWick = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = useEngulfingTrigger and useEngulfBodyAtrFilter ? ta.atr(engulfAtrLen) : na
bool engulfRatioOk = not useEngulfBodyRatioFilter or (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk = not useEngulfBodyQualityFilter or (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk = not useEngulfBodyAtrFilter or curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk = engulfRatioOk and engulfBodyQualityOk and engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = usePinbarTrigger and usePinRangeFilter ? ta.atr(pinRangeAtrLen) : na
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk = not usePinRangeFilter or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = useBOSTrigger ? ta.highest(high, bosLookback)[1] : na
float bosLow  = useBOSTrigger ? ta.lowest(low, bosLookback)[1] : na
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

// useEMARejectTrigger ゲートを三項演算子へ (値選択のみ・意味不変。ta.* はシリーズ連続のため常時評価されるが
// 値の選択結果は元の if 版と同一)。
float emaTrig = useEMARejectTrigger ? ta.ema(close, emaLenTrigger) : na
float emaSlope = useEMARejectTrigger ? emaTrig - emaTrig[emaRejectSlopeLookback] : na
float emaSlopeAtr = useEMARejectTrigger ? ta.atr(emaRejectSlopeAtrLen) : na
float emaSlopeMin = useEMARejectTrigger ? emaSlopeAtr * emaRejectSlopeMinATR : na
bool emaRejectSlopeLongOk  = useEMARejectTrigger ? (not useEMARejectSlopeFilter or emaSlope > emaSlopeMin) : true
bool emaRejectSlopeShortOk = useEMARejectTrigger ? (not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin) : true
bool trBullEMA = useEMARejectTrigger and low <= emaTrig and close > emaTrig and close > open and emaRejectSlopeLongOk
bool trBearEMA = useEMARejectTrigger and high >= emaTrig and close < emaTrig and close < open and emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

bool finalBullTrig = not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur :
     triggerTFMode == "LowerOnly"      ? trigBullLower :
     triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBullCur or trigBullLower) :
     trigBullCur

bool finalBearTrig = not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur :
     triggerTFMode == "LowerOnly"      ? trigBearLower :
     triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBearCur or trigBearLower) :
     trigBearCur

bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

var int lastTrigBar = na
bool trigFiredNow = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

bool allowLongByTrigger  = enabledTrigCount == 0 ? true : (finalBullTrig and not trigNoTrade and trigCooldownOk)
bool allowShortByTrigger = enabledTrigCount == 0 ? true : (finalBearTrig and not trigNoTrade and trigCooldownOk)

// ============================================================
// 6. ボラフィルタ判定
// ============================================================
// --- ボラフィルタ本体を関数化 (通常ボラ/高速ボラ判定は不変) ---
// 内部 var (volRecoveryStartBar) は関数ローカルへ。外部参照する volOk を返す。
f_calcVolatility() =>
    bool baseVolOk = true
    if volMode == "ATR"
        float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
        float atrAvg = ta.sma(baseAtr, volAvgLen)
        bool volAbsOk = baseAtr >= minAtrDollar
        bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
        baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
    else if volMode == "固定値"
        baseVolOk := (high - low) >= fixedMin

    bool fastVolPass = true
    if fastVolMode == "ATR"
        float fastAtr = ta.atr(fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
        float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
        bool fastAtrOk    = fastAtr >= fastAtrMin
        bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
        bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
        fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
    else if fastVolMode == "固定値"
        float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        bool fastRangeOk = fastRange >= fastFixedMin
        bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
        fastVolPass := fastRangeOk and bodyAvgOk

    bool volPassRaw = baseVolOk and fastVolPass
    bool volLowNow  = not volPassRaw
    var int volRecoveryStartBar = na
    if volLowNow
        volRecoveryStartBar := na
    if not volLowNow and nz(volLowNow[1], false)
        volRecoveryStartBar := bar_index
    bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

    bool volOk = volPassRaw and volRecoveryOk
    volOk

bool volOk = f_calcVolatility()

// ============================================================
// 7. 環境判定関数
// ============================================================
f_envTrend(int minScore) =>
    ema20 = ta.ema(close, len20)
    ema50 = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    // if/else if チェーンを三項演算子へ (値選択のみ・意味不変)。request.security で複製されるため
    // ここのスコープ削減が最も効く。分岐の優先順位・戻り値は元と完全一致。
    int trend = maxScore < minScore ? (insufficientAsRange ? 0 : na) :
                 tie                 ? (tieAsRange ? 0 : na) :
                 isBullTop           ? 1 :
                 isBearTop           ? -1 :
                 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 環境コード → 表示テキスト (ラベル/alert用)
f_trendText(int c) =>
    c == 1 ? "上昇" : c == 0 ? "レンジ" : c == -1 ? "下降" : "-"

// ============================================================
// 8. 環境フィルタ計算
// ============================================================
// --- 共通 環境トレンド (4H/1H/15M) を1回だけ算出して共有 ---
// 元は f_calcEnvironment 内 (useEnvFilter時) と mhd/rlb で計3〜9回 同一 request.security を発行し
// f_envTrend が都度複製されローカルスコープを消費していた。呼び出し内容 (tickerid/TF/expr/lookahead) は
// 完全に同一なので 1 回に集約して共有する (mhd/rlb は元から無条件発行 → 挙動不変)。
int envShared4H  = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
int envShared1H  = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
int envShared15M = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)

// --- 環境フィルタ計算を関数化 (判定・スコア・一致数は不変) ---
// 内部集計 (envEnabled/envMatched) は関数ローカルへ。外部参照する allowByEnv・envRaw* をタプルで返す。
// 4H/1H/15M は共有値を引数で受け取る (元は useEnvFilter 時のみ算出。envRaw* への代入は useEnvFilter
// ゲート内のままなので、OFF時の envRaw*=na / envDirText 表示は元と同一)。
f_calcEnvironment(int raw4H, int raw1H, int raw15M) =>
    bool allowByEnv = true
    int envEnabled = 0
    int envMatched = 0
    int envRaw4H = na
    int envRaw1H = na
    int envRaw15M = na
    int envRaw5M = na
    int envRaw1M = na

    if useEnvFilter
        raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
        raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

        envRaw4H  := raw4H
        envRaw1H  := raw1H
        envRaw15M := raw15M
        envRaw5M  := raw5M
        envRaw1M  := raw1M

        en4H  = reqTrend4H  != "OFF"
        en1H  = reqTrend1H  != "OFF"
        en15M = reqTrend15M != "OFF"
        en5M  = reqTrend5M  != "OFF"
        en1M  = reqTrend1M  != "OFF"

        m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
        m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
        m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
        m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
        m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

        envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
        envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

        int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
        allowByEnv := envEnabled == 0 or envMatched >= needMatch
    [allowByEnv, envRaw4H, envRaw1H, envRaw15M, envRaw5M, envRaw1M]

[allowByEnv, envRaw4H, envRaw1H, envRaw15M, envRaw5M, envRaw1M] = f_calcEnvironment(envShared4H, envShared1H, envShared15M)
bool envLongOk  = not useEnvFilter or allowByEnv
bool envShortOk = not useEnvFilter or allowByEnv

// 環境方向テキスト (有効TFのみを "4H/1H/15M/5M/1M" 順で連結。シグナル時=要求と一致した実判定)
f_envDirText() =>
    string _t = ""
    if reqTrend4H != "OFF"
        _t := _t + (str.length(_t) > 0 ? "/" : "") + f_trendText(envRaw4H)
    if reqTrend1H != "OFF"
        _t := _t + (str.length(_t) > 0 ? "/" : "") + f_trendText(envRaw1H)
    if reqTrend15M != "OFF"
        _t := _t + (str.length(_t) > 0 ? "/" : "") + f_trendText(envRaw15M)
    if reqTrend5M != "OFF"
        _t := _t + (str.length(_t) > 0 ? "/" : "") + f_trendText(envRaw5M)
    if reqTrend1M != "OFF"
        _t := _t + (str.length(_t) > 0 ? "/" : "") + f_trendText(envRaw1M)
    str.length(_t) == 0 ? "-" : _t
string envDirText = f_envDirText()

// ============================================================
// 8b. Momentum (ストキャス/MACD momentum は未使用のため削除)
// ------------------------------------------------------------
// useStochMomentum=false / useMACDModule=false のため、元の Momentum 集約は常に
// allowLong/ShortByMomentum = true を返していた。ロジック不変のまま定数化してトークン削減。
// ============================================================
bool allowLongByMomentum  = true
bool allowShortByMomentum = true

// ============================================================
// 9. SL / TP / ロット計算
// ------------------------------------------------------------
// strategy.equity / initial_capital は使用不可のため 計算用資金(input)を基準にする。
//   複利OFF … indicatorCapital (元金単利)
//   複利ON  … manualEquity (手入力の現在資金)
// ============================================================
float patLow  = math.min(low, low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? manualEquity : indicatorCapital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
// 9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

// --- 日足レジーム本体を関数化 (方向/ボラ分類/モード/高ボラ帯/データ不足処理 は不変) ---
// 内部 var (当日 O/H/L) は関数ローカルへ。外部参照する4値をタプルで返す。
f_calcDailyRegime() =>
    bool dailyRegimeLongOk  = true
    bool dailyRegimeShortOk = true
    bool dailyRegimeOk      = true
    int drDirCodeAdj = na
    int drVolCodeAdj = na
    float drRange = na
    float drDailyATR = na
    string drVolTextOut = "-"

    bool drActive = useDailyRegimeFilter

    if drActive
        [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

        var float drCurDayOpen = na
        var float drCurDayHigh = na
        var float drCurDayLow  = na
        bool drNewDay = ta.change(time("D")) != 0
        bool drDayReset = drNewDay or na(drCurDayHigh)   // 条件を更新前に確定 (na判定順序を保持)
        drCurDayOpen := drDayReset ? open : drCurDayOpen
        drCurDayHigh := drDayReset ? high : math.max(drCurDayHigh, high)
        drCurDayLow  := drDayReset ? low  : math.min(drCurDayLow, low)
        float drIntradayRange = drCurDayHigh - drCurDayLow

        bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
        bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

        float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
        float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
        float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
        float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

        drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
        drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
        float drLoThr = drUsePrev ? _loT1 : _loT0
        float drHiThr = drUsePrev ? _hiT1 : _hiT0

        int drDirCode = f_drDirCode(drO, drH, drL, drC)
        int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
        bool drDirInsufficient = na(drDirCode)
        bool drVolInsufficient = na(drVolCode)
        drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
        drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

        string drDirText = f_dailyDirectionText(drDirCodeAdj)
        string drVolText = f_dailyVolatilityText(drVolCodeAdj)
        drVolTextOut := drVolText
        bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
        bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
        bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
        bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
        bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
        bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
        bool highVol200Plus  = drRange >= extremeVolLevel
        bool allowHighVol =
             (useHighVol140to170 and highVol140to170) or
             (useHighVol170to200 and highVol170to200) or
             (useHighVol200Plus  and highVol200Plus)
        bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
        bool highVolBandOk = not drIsHighVol or allowHighVol
        dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

    bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
    if drTradeConnected
        dailyRegimeLongOk  := dailyRegimeOk
        dailyRegimeShortOk := dailyRegimeOk
    [dailyRegimeLongOk, dailyRegimeShortOk, dailyRegimeOk, drVolTextOut]

[dailyRegimeLongOk, dailyRegimeShortOk, dailyRegimeOk, drVolTextOut] = f_calcDailyRegime()

// ============================================================
// 【レイヤー2: 環境・ロジック別の実効設定】
// ------------------------------------------------------------
// 今後ロジック(相場環境別)を追加する際は、ここで各ロジックごとに
// 「実際に使用する設定値(実効値)」を決めてから判定へ渡す。
// 出来高リジェクト(Bランク)は添付ストラテジーの現在設定を実効値として使用する。
// ※ useLong/useShort・各セッション・使用WinZone・WinZone内機能・数値・
//    トリガー・モメンタム・日足レジーム・ボラ区分 は将来ロジック別に変えられる。
// ============================================================
// --- 既存: 出来高リジェクト (Bランク・低ボラ・アジア+NY・POCリジェクト・固定SL12) ---
string LOGIC_VR_NAME = "出来高リジェクト"
string LOGIC_VR_RANK = "B"
int    LOGIC_VR_ID   = 1

// --- 追加: フィボC (内部判定=Cランク 0.382〜0.500 / 表示ランクのみ=A) ---
string LOGIC_FIB_C_NAME = "フィボC"          // 内部=Cランク、表示ランクのみA
string LOGIC_FIB_C_RANK_DISPLAY = "A"        // 表示専用ランク (内部はC)
int    LOGIC_FIB_C_ID   = 2
bool   useFibCLogic = true                   // フィボCロジック有効
float  fibCSlFixed  = 15.0                    // フィボC 固定SL($)
float  fibCRR       = 1.0                     // フィボC リスクリワード

// --- 確定ラベル色 (ランク別) ---
color COLOR_RANK_B = color.rgb(0, 100, 0)    // Bランク=深緑 (既存・不変)
color COLOR_RANK_A = color.rgb(25, 70, 140)  // Aランク=濃紺 (深緑と明確に区別・派手すぎない)

// --- 追加: セッション水平線反発 (内部判定=Bランク / 表示ランク=B・ショートのみ) ---
string LOGIC_SLR_NAME = "セッション水平線反発"
string LOGIC_SLR_RANK = "B"
int    LOGIC_SLR_ID   = 3
bool   useSLRLogic = true                     // セッション水平線反発ロジック有効
float  slrSlFixed  = 12.0                     // 固定SL($)
float  slrRR       = 1.0                      // リスクリワード
float  slrZoneWidth = 0.1                     // 反発ゾーン幅 (固定・ATR連動しない)
int    slrStateMaxBars = 3                    // 状態 有効本数
int    slrSessionMaxDays = 2                  // セッション水平線 有効日数 (当日含む・元ストラテジー lineSessionMaxDays 準拠)
int    slrMaxZones = 20                       // 最大保持数 (元ストラテジー lineMaxZones 初期値 準拠)
int    slrMergeAtrLen = 14                    // 統合許容幅 算出用ATR期間 (元ストラテジー lineAtrLen 準拠)
float  slrMergeToleranceATR = 0.3             // 統合許容幅 ATR倍率 (元ストラテジー reactionToleranceATR 初期値 準拠)
string slrSessTZ = "GMT"                      // セッションTZ (固定)
string slrAsiaSess   = "0000-0800"           // セッション定義 (877既定・GMT。固定)
string slrLondonSess = "0700-1600"
string slrNySess     = "1200-2100"

// --- 追加: フィボA戦略 (内部判定=Aランク / 表示ランク=A・ロング+ショート) ---
string LOGIC_FIB_A_NAME = "フィボA"
string LOGIC_FIB_A_RANK_DISPLAY = "A"        // 表示ランク=A (既存Aと同色)
int    LOGIC_FIB_A_ID   = 4
bool   useFibALogic = true                    // フィボA戦略 有効
float  fibASlFixed  = 12.0                    // 固定SL($)
float  fibARR       = 1.0                     // リスクリワード

// --- 追加: MACDヒスト拡大 戦略 (表示ランク=C・ロング+ショート) ---
string LOGIC_MHX_NAME = "MACDヒスト拡大"
string LOGIC_MHX_RANK_DISPLAY = "C"          // 表示ランク=C (仮/確定 共通)
int    LOGIC_MHX_ID   = 5
bool   useMHXLogic = true                     // MACDヒスト拡大 戦略 有効
float  mhxSlFixed  = 12.0                     // 固定SL($)
float  mhxRR       = 1.0                      // リスクリワード
int    mhxExpBars  = 3                        // Hist連続拡大 本数 (固定)
int    mhxStateMaxBars = 5                    // MACD Hist拡大 状態 有効本数 (固定)

// --- 追加: MACD拡大/Div 戦略 (表示ランク=C・ロング+ショート・中ボラ・全セッション) ---
string LOGIC_MHD_NAME = "MACD拡大/Div"
string LOGIC_MHD_RANK_DISPLAY = "C"          // 表示ランク=C (仮/確定 共通・Div発生時もC)
int    LOGIC_MHD_ID   = 6
bool   useMHDLogic = true                     // MACD拡大/Div 戦略 有効
float  mhdSlFixed  = 12.0                     // 固定SL($)
float  mhdRR       = 1.0                      // リスクリワード
int    mhdExpBars  = 3                        // Hist連続拡大 本数 (固定)
int    mhdStateMaxBars = 5                    // MACD拡大/Div 状態 有効本数 (固定)

// --- 追加: 水平線ブレイク 戦略 (表示ランク=C・ロング+ショート・低ボラ・全セッション) ---
string LOGIC_RLB_NAME = "水平線ブレイク"
string LOGIC_RLB_RANK_DISPLAY = "C"          // 表示ランク=C (仮/確定 共通)
int    LOGIC_RLB_ID   = 7

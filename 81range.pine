// 確定シグナル (足確定 + fibCPos非保有 + fibCWant成立)
bool fibCLongConf  = is5m and barstate.isconfirmed and not fibCPosActive and fibCWantLong
bool fibCShortConf = is5m and barstate.isconfirmed and not fibCPosActive and fibCWantShort
if fibCLongConf
    float _e = close
    float _sl = fibCLongStop
    float _tp = fibCLongTP
    alert(f_sigMsg("確定", "LONG", _e, _sl, _tp, fibCLongQty, LOGIC_FIB_C_RANK_DISPLAY, LOGIC_FIB_C_NAME, envDirText, drVolTextOut), alert.freq_once_per_bar)
    label.new(bar_index, low, f_labelText("LONG", _e, _sl, _tp, fibCLongQty, LOGIC_FIB_C_RANK_DISPLAY, LOGIC_FIB_C_NAME, envDirText, drVolTextOut), yloc = yloc.belowbar, style = label.style_label_up, color = COLOR_RANK_A, textcolor = color.white, size = size.small)
    fibCPosActive := true
    fibCPosDir := 1
    fibCPosEntry := _e
    fibCPosSL := _sl
    fibCPosTP := _tp
    fibCPosQty := fibCLongQty
    fibCPosEntryBar := bar_index
    // エントリー後 状態リセット (元ストラテジーと同じ): フィボ状態(確定/raw)をリセット。
    if resetFibStateAfterEntry
        longFibStateOk := false
        longFibStateRawOk := false
if fibCShortConf
    float _e = close
    float _sl = fibCShortStop
    float _tp = fibCShortTP
    alert(f_sigMsg("確定", "SHORT", _e, _sl, _tp, fibCShortQty, LOGIC_FIB_C_RANK_DISPLAY, LOGIC_FIB_C_NAME, envDirText, drVolTextOut), alert.freq_once_per_bar)

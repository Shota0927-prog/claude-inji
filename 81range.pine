    fibCPosActive := true
    fibCPosDir := -1
    fibCPosEntry := _e
    fibCPosSL := _sl
    fibCPosTP := _tp
    fibCPosQty := fibCShortQty
    fibCPosEntryBar := bar_index
    if resetFibStateAfterEntry
        shortFibStateOk := false
        shortFibStateRawOk := false

// ---------- 出来高リジェクト (元ストラテジー準拠・完全独立) ----------
// 仮シグナル (足未確定。vrPos非保有。同一バー内重複は alert.freq_once_per_bar が防止)

// ############################################################################
// ##  PROFILER ONLY — 本番では使わないこと                                   ##
// ############################################################################
//  Pine Profiler で「どこが重いか」を測るためだけの一時コピー。
//
//  ・ZoneEngineV2_VisualHarness.pine と中身は同一で、次の 2 点だけ違う。
//      1) indicator() に calc_bars_count = 3000 を付けて計算本数を絞っている
//      2) shorttitle を分けてチャート上で区別できるようにしている
//  ・calc_bars_count は「計測を現実的な時間で終わらせる」ためだけの制限であり、
//    古い Root / Zone / Touch 履歴が存在しない状態になる。
//    ここで出た Zone の中身を本番の判定結果として扱わないこと。
//  ・本番コード (ZoneEngineV2_VisualHarness.pine) には calc_bars_count を入れていない。
//
//  使い方
//    Pine Editor -> More -> Profiler mode -> このスクリプトをチャートへ適用
//    次の実行回数 / 負荷割合を記録する:
//      request.security 6 本 / time(tf) 5 本 / zn2.update() / f_rebuildCores() /
//      f_buildSideCands() / f_searchDenseBest() / f_buildPointSnapshot() /
//      f_fvgAttachAndStandalone() / f_pairSides() / f_buildViews() /
//      f_pruneRoots() / 描画・テーブル・Event Log
//    Baseline (最適化前) を測るときは baseline/ZoneEngineV2_VisualHarness_baseline.pine
//    に同じ calc_bars_count = 3000 を 1 行足したコピーを使い、import 先も
//    最適化前に公開した Library バージョンへ向けること。
// ############################################################################

// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  ZoneEngineV2 Visual Harness  (indicator / 表示検証専用)
// ============================================================================
//  目的
//    ZoneEngineV2 が作る Zone の生成 / 状態遷移 / 診断値を目視確認する。
//
//  ★ このスクリプトがやらないこと (指示書 22.5) ★
//      strategy() 宣言 / Entry / Exit / 勝敗集計 / 環境認識フィルター /
//      Zone 選択を 1 件へ絞る処理。
//    Zone は該当するものを全件表示する (距離や Grade で勝手に 1 つへ絞らない)。
//
//  ★ 前提 ★
//    ・チャート時間足 = 5分足。5分足以外では状態を更新せず警告を出す。
//      (Library 自体は将来、別チャート足から確定 5分足 Feed を渡せる構造のまま)
//    ・対象は XAUUSD。別銘柄では警告を出すだけで、Zone ロジックは一切変えない。
//    ・外部足はすべて lookahead_off。未確定値で Engine を更新しない。
//
//  ★ request.security の本数 (同じ式 / 同じ時間足はまとめる) ★
//    時間足文字列が完全に一致するものを統合 Pack で 1 本へまとめる。
//
//    既定設定 (MA 1 / Swing 5、15、60 / Accum 60、240、D / FVG 60、240、D)
//      MA 1分                             : 1 call
//      Swing #1 (5分)                      : 1 call
//      Swing #2 (15分)                     : 1 call
//      Swing#3 + Accum#1 + FVG#1 (60分)    : 1 call   ← 従来 3 calls
//      Accum#2 + FVG#2 (240分)             : 1 call   ← 従来 2 calls
//      Accum#3 + FVG#3 (D)                  : 1 call   ← 従来 2 calls
//      Base 5分                            : built-in (このスクリプトが 5分足なので request 不要)
//      合計 6 calls (旧 10 calls) / time(tf) は 5 本 (旧 9 本)
//
//    グループごとの場合分け (時間足設定の自由度は落とさない)
//      Group 60  ① Swing#3 = Accum#1 = FVG#1 → swingAccumFvgPackV2  : 1 call
//                ② Accum#1 = FVG#1 だけ      → accumFvgPackV2
//                                                + pivotPackV2        : 2 calls
//                ③ 不一致                    → 個別 3 本              : 3 calls
//      Group 240 ① Accum#2 = FVG#2           → accumFvgPackV2       : 1 call
//                ② 不一致                    → 個別 2 本              : 2 calls
//      Group D   ① Accum#3 = FVG#3           → accumFvgPackV2       : 1 call
//                ② 不一致                    → 個別 2 本              : 2 calls
//      最小 6 calls / 最大 10 calls (全て不一致 = 従来と同じ本数)
//
//    まとめる判定は時間足文字列の完全一致。timeframe.in_seconds() ではないのは、
//    "1440" と "D" が秒数では同じでも足の区切り方が違うから。文字列が同じなら
//    request.security の結果も time() の結果も必ず同じ値になる。
//    各グループは if / else if / else なので、まとめたデータを別 request で
//    二重に取ることはない。dynamic_requests = true なのでこの分岐は許される。
//
//  ★ セッション / 日 / 週 の ID はここで計算して Feed へ渡す ★
//    Pine の hour()/timestamp() の timezone 引数は series 化できないため、
//    timezone 依存の区切り判定は Library ではなく呼び出し側の責務にしている。
// ============================================================================

//@version=6
indicator(
     title            = "ZoneEngineV2 Visual Harness",
     shorttitle        = "ZONEv2-HARNESS-PROF",
     overlay           = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 500,
     dynamic_requests  = true,
     calc_bars_count   = 3000
 )

// ############################################################################
// ##  ★ Library バージョン番号 (この 1 行だけで指定する) ★                  ##
// ##                                                                        ##
// ##  下の /4 は「直前の公開が /3 (Phase3A) だった」からの連番である。  ##
// ##  ★★ Publish 直後に TradingView が実際に発行した番号を見て、      ##
// ##     違っていたらここを直すこと。仮に入れている値である。  ★★      ##
// ##                                                                        ##
// ##  この Harness は Version 3 には無い次の API を使うため、               ##
// ##  /3 以前を指していると "Could not find function" でコンパイルできない。 ##
// ##      zn2.swingAccumFvgPackV2()  (Swing + Accum + FVG を 1 request へ)   ##
// ##      zn2.accumFvgPackV2()       (Accum + FVG を 1 request へ)          ##
// ##                                                                        ##
// ##  同じ番号を profiler/ZoneEngineV2_VisualHarness_Profiler.pine と          ##
// ##  ZoneEngineV2_ParityHarness.pine (vB 側) にも入れる。                 ##
// ############################################################################
import sekine3310/ZoneEngineV2/4 as zn2          // ← ★ Publish 後の実番号を確認すること

// ============================================================================
// 01. INPUTS
// ============================================================================
var string G_CORE  = "01 · Zone 論理パラメータ"
var string G_CAT   = "02 · カテゴリ ON / OFF"
var string G_TF    = "03 · 時間足"
var string G_ACC   = "04 · Accum 検出"
var string G_TIME  = "05 · セッション / 日 / 週"
var string G_STORE = "06 · 保存上限 / Dormant"
var string G_DISP  = "07 · 表示"
var string G_DBG   = "08 · Debug"

clusterMaxWidth    = input.float(20.0, "M : Zone 全幅の上限 ($)", minval = 0.1, step = 0.5, group = G_CORE)
denseRatio         = input.float(0.50, "DenseRatio (dense 幅 = M × これ)", minval = 0.01, maxval = 1.0, step = 0.05, group = G_CORE)
touchResetDistance = input.float(10.0, "TouchResetDistance ($)", minval = 0.1, step = 0.5, group = G_CORE)
strongUnlimited    = input.bool(false, "StrongUntilTouch = Unlimited", group = G_CORE)
strongUntilTouch   = input.int(1, "StrongUntilTouch", minval = 1, group = G_CORE)
weakFromTouchOff   = input.bool(false, "WeakFromTouch = OFF", group = G_CORE)
weakFromTouch      = input.int(2, "WeakFromTouch", minval = 2, group = G_CORE)
weakDepthOff       = input.bool(false, "WeakDepth = OFF", group = G_CORE)
weakDepthPct       = input.float(50.0, "WeakDepthPct (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_CORE)
breakBuffer        = input.float(2.0, "BreakBuffer ($)", minval = 0.0, step = 0.5, group = G_CORE)
touchTolerance     = input.float(0.0, "TouchTolerance ($ · 一本線 Zone 専用)", minval = 0.0, step = 0.1, group = G_CORE)

useMa    = input.bool(true, "MA 系",          group = G_CAT)
useSwing = input.bool(true, "Swing 系",       group = G_CAT)
useAccum = input.bool(true, "Accum 系",       group = G_CAT)
useTime  = input.bool(true, "時間区切り高安系", group = G_CAT)
useFvg   = input.bool(true, "HTF FVG 系",     group = G_CAT)
usePsych = input.bool(true, "心理価格系",     group = G_CAT)

maTf            = input.timeframe("1", "MA 時間足", group = G_TF)
emaLen1         = input.int(2000, "EMA #1 期間", minval = 1, maxval = 4999, group = G_TF)
emaLen2         = input.int(3000, "EMA #2 期間", minval = 1, maxval = 4999, group = G_TF)
emaSlopeLookback = input.int(60, "EMA 傾き Lookback (1分足本数)", minval = 1, group = G_TF)
swTf1 = input.timeframe("5",  "Swing TF #1", group = G_TF)
swTf2 = input.timeframe("15", "Swing TF #2", group = G_TF)
swTf3 = input.timeframe("60", "Swing TF #3", group = G_TF)
swLen1 = input.int(10, "Swing Pivot Length #1", minval = 1, group = G_TF)
swLen2 = input.int(8,  "Swing Pivot Length #2", minval = 1, group = G_TF)
swLen3 = input.int(6,  "Swing Pivot Length #3", minval = 1, group = G_TF)
accTf1 = input.timeframe("60",  "Accum TF #1", group = G_TF)
accTf2 = input.timeframe("240", "Accum TF #2", group = G_TF)
accTf3 = input.timeframe("D",   "Accum TF #3", group = G_TF)
fvgTf1 = input.timeframe("60",  "FVG TF #1", group = G_TF)
fvgTf2 = input.timeframe("240", "FVG TF #2", group = G_TF)
fvgTf3 = input.timeframe("D",   "FVG TF #3", group = G_TF)

accumRangeLen        = input.int(10,  "Accum 判定レンジ本数", minval = 6, group = G_ACC)
accumBaseLen         = input.int(20,  "Accum 基準本数",      minval = 10, group = G_ACC)
accumAtrLen          = input.int(14,  "Accum ATR 本数",      minval = 1, group = G_ACC)
accumMinUpperCloses  = input.int(4,   "上半分 最低終値本数",  minval = 1, group = G_ACC)
accumMinLowerCloses  = input.int(4,   "下半分 最低終値本数",  minval = 1, group = G_ACC)
accumMaxSameColorRun = input.int(4,   "同色連続上限",        minval = 1, group = G_ACC)
accumAtrMult         = input.float(2.5,  "レンジ幅 / ATR 上限",    minval = 0.1, step = 0.1, group = G_ACC)
accumBarRatioMax     = input.float(0.70, "短期幅 / 基準幅 上限",   minval = 0.1, step = 0.05, group = G_ACC)
accumDriftMax        = input.float(0.30, "ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACC)

zoneTz       = input.string("Asia/Tokyo", "Timezone", group = G_TIME)
dayResetHour = input.int(5,  "日区切り (時)",     minval = 0, maxval = 23, group = G_TIME)
asiaStart    = input.int(9,  "Asia 開始 (時)",    minval = 0, maxval = 23, group = G_TIME)
euStart      = input.int(14, "Europe 開始 (時)",  minval = 0, maxval = 23, group = G_TIME)
nyStart      = input.int(19, "New York 開始 (時)", minval = 0, maxval = 23, group = G_TIME)
nyEnd        = input.int(3,  "New York 終了 (時)", minval = 0, maxval = 23, group = G_TIME)

maxSwingRoots       = input.int(180, "最大 Swing Root 数",   minval = 1, group = G_STORE)
maxAccumBoxes       = input.int(60,  "最大 Accum Box 数",    minval = 1, group = G_STORE)
maxFvgRoots         = input.int(120, "最大 FVG Root 数",     minval = 1, group = G_STORE)
maxTimeRoots        = input.int(32,  "最大 時間高安 Root 数", minval = 1, group = G_STORE)
maxZoneCores        = input.int(80,  "最大 ZoneCore 数",     minval = 1, group = G_STORE)
maxEndedGenerations = input.int(30,  "終了世代の保存数",     minval = 1, group = G_STORE)
maxTouchMarks       = input.int(64,  "Core ごとの TouchMark 上限", minval = 1, group = G_STORE)
dormantDistance     = input.float(500.0, "Dormant 距離 ($)", minval = 1.0, step = 10.0, group = G_STORE)

showZones     = input.bool(true, "Zone を描画", group = G_DISP)
showLabels    = input.bool(true, "Zone ラベルを表示", group = G_DISP)
showFvg50     = input.bool(false, "FVG 50% を表示 (DISPLAY ONLY)", group = G_DISP,
     tooltip = "表示専用。Library の Zone 計算へは一切渡していない。")
maxZonesDrawn  = input.int(30, "描画する Zone 数", minval = 1, maxval = 120, group = G_DISP)
zoneLeftBars   = input.int(120, "Zone Box 左方向の長さ (bars)", minval = 1, group = G_DISP)
zoneRightBars  = input.int(30,  "Zone Box 右方向の長さ (bars)", minval = 1, group = G_DISP)
colSupport     = input.color(color.new(#26A69A, 0), "色 · Support", group = G_DISP)
colResistance  = input.color(color.new(#EF5350, 0), "色 · Resistance", group = G_DISP)
colInactive    = input.color(color.new(#78909C, 0), "色 · Unavailable / FlipWait", group = G_DISP)

showDebugTable = input.bool(true,  "Debug table を表示", group = G_DBG)
showRootTable  = input.bool(true,  "Root Debug table を表示", group = G_DBG)
showEventLog   = input.bool(false, "Event log を表示", group = G_DBG,
     tooltip = "既定 OFF。OFF の間は Event の「表示用ログへの格納」だけを止める。\n" +
     "Engine 内部の ZoneEvent 生成は従来どおり動いており、ON にすればそのまま表示できる。")
rootTableMax   = input.int(18, "Root table の行数", minval = 1, maxval = 40, group = G_DBG)
eventLogMax    = input.int(14, "Event log の行数", minval = 1, maxval = 40, group = G_DBG)
dbgTextSize    = input.string("Small", "Table 文字サイズ", options = ["Tiny", "Small", "Normal"], group = G_DBG)

// ============================================================================
// 02. 環境チェック (ロジックへは影響させない)
// ============================================================================
bool isFiveMin = timeframe.in_seconds() == timeframe.in_seconds("5")
bool isGold    = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")

// ============================================================================
// 03. ENGINE / CONFIG
// ============================================================================
var zn2.ZoneEngine eng = zn2.newEngine()

//  ★ Phase2 (allocation 削減) : ZoneCfg を毎足 new せず永続オブジェクトにする。
//    input が変わると TradingView がスクリプト全体を再計算するので、初回 1 回の
//    設定で値は維持される。Engine へ渡る Cfg の値は毎足まったく同じ。
var zn2.ZoneCfg cfg = zn2.newCfg()
var bool cfgInitialized = false
if not cfgInitialized
    cfgInitialized := true
    cfg.clusterMaxWidth     := clusterMaxWidth
    cfg.denseRatio          := denseRatio
    cfg.touchResetDistance  := touchResetDistance
    cfg.strongUntilTouch    := strongUntilTouch
    cfg.strongUnlimited     := strongUnlimited
    cfg.weakFromTouch       := weakFromTouch
    cfg.weakFromTouchOff    := weakFromTouchOff
    cfg.weakDepthPct        := weakDepthPct
    cfg.weakDepthOff        := weakDepthOff
    cfg.breakBuffer         := breakBuffer
    cfg.touchTolerance      := touchTolerance
    cfg.emaSlopeLookback    := emaSlopeLookback
    cfg.swingLen5m          := swLen1
    cfg.swingLen15m         := swLen2
    cfg.swingLen1h          := swLen3
    cfg.useMa               := useMa
    cfg.useSwing            := useSwing
    cfg.useAccum            := useAccum
    cfg.useTimeHL           := useTime
    cfg.useFvg              := useFvg
    cfg.usePsych            := usePsych
    cfg.accumRangeLen       := accumRangeLen
    cfg.accumBaseLen        := accumBaseLen
    cfg.accumAtrLen         := accumAtrLen
    cfg.accumMinUpperCloses := accumMinUpperCloses
    cfg.accumMinLowerCloses := accumMinLowerCloses
    cfg.accumMaxSameColorRun := accumMaxSameColorRun
    cfg.accumAtrMult        := accumAtrMult
    cfg.accumBarRatioMax    := accumBarRatioMax
    cfg.accumDriftMax       := accumDriftMax
    cfg.zoneTimezone        := zoneTz
    cfg.dayResetHour        := dayResetHour
    cfg.asiaStartHour       := asiaStart
    cfg.europeStartHour     := euStart
    cfg.nyStartHour         := nyStart
    cfg.nyEndHour           := nyEnd
    cfg.tfMa                := maTf
    cfg.tfSwing1            := swTf1
    cfg.tfSwing2            := swTf2
    cfg.tfSwing3            := swTf3
    cfg.tfAccum1            := accTf1
    cfg.tfAccum2            := accTf2
    cfg.tfAccum3            := accTf3
    cfg.tfFvg1              := fvgTf1
    cfg.tfFvg2              := fvgTf2
    cfg.tfFvg3              := fvgTf3
    cfg.maxSwingRoots       := maxSwingRoots
    cfg.maxAccumBoxes       := maxAccumBoxes
    cfg.maxFvgRoots         := maxFvgRoots
    cfg.maxTimeRoots        := maxTimeRoots
    cfg.maxZoneCores        := maxZoneCores
    cfg.maxEndedGenerations := maxEndedGenerations
    cfg.maxTouchMarksPerCore := maxTouchMarks
    cfg.dormantDistance     := dormantDistance
    cfg.maxZonesDrawn       := maxZonesDrawn
    cfg.maxLabelsDrawn      := maxZonesDrawn
    cfg.mintick             := syminfo.mintick
    //  表示専用 : ラベルを描かないなら ZoneView の説明文字列も作らせない
    cfg.buildDisplayStrings := showLabels

// Library と同じ定数値を名前で取得する (再宣言しない)
//  ★ Phase2 : var で初回 1 回だけ取得する (毎足 constOf() を呼ばない)
var int SIDE_SUPPORT    = zn2.constOf("SIDE_SUPPORT")
var int SIDE_RESISTANCE = zn2.constOf("SIDE_RESISTANCE")
var int PH_ACTIVE_TOUCH = zn2.constOf("PH_ACTIVE_TOUCH")
var int PH_BROKEN       = zn2.constOf("PH_BROKEN")
var int PH_FLIP_WAIT    = zn2.constOf("PH_FLIP_WAIT")
var int PH_DORMANT      = zn2.constOf("PH_DORMANT")
var int GR_STRONG       = zn2.constOf("GR_STRONG")
var int GR_NEUTRAL      = zn2.constOf("GR_NEUTRAL")
var int GR_WEAK         = zn2.constOf("GR_WEAK")
var int GR_UNAVAILABLE  = zn2.constOf("GR_UNAVAILABLE")
var int DEN_BROAD       = zn2.constOf("DEN_BROAD_CONTEXT")
var int TF_5M           = zn2.constOf("TF_5M")
var int TF_15M          = zn2.constOf("TF_15M")
var int TF_1H           = zn2.constOf("TF_1H")
var int TF_4H           = zn2.constOf("TF_4H")
var int TF_D            = zn2.constOf("TF_D")
var int SESS_NONE       = zn2.constOf("SESS_NONE")
var int SESS_ASIA       = zn2.constOf("SESS_ASIA")
var int SESS_EUROPE     = zn2.constOf("SESS_EUROPE")
var int SESS_NY         = zn2.constOf("SESS_NY")
var int CAT_FVG         = zn2.constOf("CAT_FVG")

//  時間足文字列 -> Library の tfCode
tfCodeOf(simple string tf) =>
    timeframe.in_seconds(tf) == timeframe.in_seconds("5")   ? TF_5M :
     timeframe.in_seconds(tf) == timeframe.in_seconds("15") ? TF_15M :
     timeframe.in_seconds(tf) == timeframe.in_seconds("60") ? TF_1H :
     timeframe.in_seconds(tf) == timeframe.in_seconds("240") ? TF_4H : TF_D

//  ★ Phase2 : Feed 作成のたびに 9 回呼ばず、初回だけ確定させる
//    (input が変われば再計算されるので値はずれない)
var int swCode1  = tfCodeOf(swTf1)
var int swCode2  = tfCodeOf(swTf2)
var int swCode3  = tfCodeOf(swTf3)
var int accCode1 = tfCodeOf(accTf1)
var int accCode2 = tfCodeOf(accTf2)
var int accCode3 = tfCodeOf(accTf3)
var int fvgCode1 = tfCodeOf(fvgTf1)
var int fvgCode2 = tfCodeOf(fvgTf2)
var int fvgCode3 = tfCodeOf(fvgTf3)

// ============================================================================
// 04. セッション / 日 / 週 ID (timezone 依存部分は Harness の責務)
// ----------------------------------------------------------------------------
//  ・Base 足の time (足の開始時刻) で判定する。
//    14:00 開始足は Europe / 19:00 開始足は New York /
//    03:00 開始足はセッションなし / 05:00 開始足は新取引日。
// ============================================================================
int locY = year(time, zoneTz)
int locM = month(time, zoneTz)
int locD = dayofmonth(time, zoneTz)
int locH = hour(time, zoneTz)
int calDayNo    = int(timestamp(zoneTz, locY, locM, locD, 0, 0) / 86400000)
int tradingDay  = locH < dayResetHour ? calDayNo - 1 : calDayNo
//  1970-01-01 は木曜。1970-01-05 が月曜なので、月曜起点は (day - 4) / 7。
int tradingWeek = int(math.floor((tradingDay - 4) / 7.0))
int sessCode = locH >= asiaStart and locH < euStart ? SESS_ASIA :
     locH >= euStart and locH < nyStart ? SESS_EUROPE :
     (locH >= nyStart or locH < nyEnd) ? SESS_NY : SESS_NONE
int sessId = tradingDay * 8 + sessCode

// ============================================================================
// 05. EXTERNAL DATA FEED (すべて lookahead_off / 確定足のみ)
// ============================================================================
// ---- MA (1分足コンテキストで EMA と傾きを計算) ----
[ema1, ema1d, ema2, ema2d, maCt] = request.security(syminfo.tickerid, maTf,
     zn2.maPackV2(emaLen1, emaLen2, emaSlopeLookback), lookahead = barmerge.lookahead_off)

// ---- Swing #1 / #2 (単独の時間足) --------------------------------------
[s1ph, s1phO, s1phE, s1phC, s1pl, s1plO, s1plE, s1plC] =
     request.security(syminfo.tickerid, swTf1, zn2.pivotPackV2(swLen1), lookahead = barmerge.lookahead_off)
[s2ph, s2phO, s2phE, s2phC, s2pl, s2plO, s2plE, s2plC] =
     request.security(syminfo.tickerid, swTf2, zn2.pivotPackV2(swLen2), lookahead = barmerge.lookahead_off)

// ============================================================================
//  ★ Phase3B : 同じ時間足への request.security を 1 本へまとめる
// ----------------------------------------------------------------------------
//  まとめる条件は「時間足文字列が完全に一致すること」。
//  timeframe.in_seconds() ではなく文字列比較にしているのは、例えば "1440" と "D"
//  が秒数では同じでも足の区切り方が違うから。文字列が同じなら request.security
//  の結果も time() の結果も必ず同じ値になる。
//  1 つでも違えば従来どおり個別の Pack を個別の時間足へ出す (値は変わらない)。
//  dynamic_requests = true なのでこの分岐は許される。
// ============================================================================
//  ★ Group 60 のまとめ方は 3 段階 ★
//    ① Swing #3 / Accum #1 / FVG #1 が全部同じ時間足
//        → swingAccumFvgBundleV2() 1 本だけ (1 call / tuple 要素 1)
//    ② Accum #1 / FVG #1 だけ同じ (Swing #3 は別の時間足)
//        → accumFvgBundleV2() 1 本 + pivotPackV2() 1 本 (2 calls / tuple 要素 1+8)
//    ③ どれも一致しない
//        → 従来どおり pivotPackV2 / accumPackV2 / fvgPackV2 の 3 本
//          (3 calls / tuple 要素 8+6+15 = 29)
//    どの段階でも、まとめた分を別 request で重ねて取り直すことはしない
//    (if / else if / else なので同時に成立しない)。
//
//  ★ 統合分岐で tuple 版 (swingAccumFvgPackV2 / accumFvgPackV2) を使わない理由 ★
//    Pine の request.* は「スクリプト内の全 request の tuple 要素数の合計」に
//    127 の上限がある。if / else で実行時に 1 分岐しか通らなくても、
//    input で分岐する以上ソース上の全分岐が合算されるため、tuple 版を使うと
//    Group60 だけで 29 + 27 + 29 = 87 要素を食って上限を超える。
//    UDT を返す Bundle 版なら 1 request = 1 要素になる。値は tuple 版と完全に同じ。
bool sameAccFvg1 = accTf1 == fvgTf1
bool merge60All  = sameAccFvg1 and swTf3 == accTf1
bool merge60AF   = sameAccFvg1 and not merge60All
bool merge240    = accTf2 == fvgTf2
bool mergeDay    = accTf3 == fvgTf3

// ---- Group 60 : Swing #3 + Accum #1 + FVG #1 -------------------------------
//  ★ 統合分岐は UDT を 1 要素として取る (request tuple 要素数を 1 にするため)。
//    HTF の確定足がまだ無い間は UDT 自体が na になるので、na のときは宣言時の
//    既定値 (float/int は na / bool は false) をそのまま残す。tuple 版で各要素が
//    na / false で返ってくるのと同じ状態になる。
float s3ph = na
int   s3phO = na
int   s3phE = na
int   s3phC = na
float s3pl = na
int   s3plO = na
int   s3plE = na
int   s3plC = na
bool  a1New = false
float a1Top = na
float a1Bot = na
int   a1Id = na
int   a1Cs = na
int   a1Ct = na
bool  f1bN = false
float f1bT = na
float f1bB = na
int   f1bO = na
int   f1bC = na
bool  f1sN = false
float f1sT = na
float f1sB = na
int   f1sO = na
int   f1sC = na
float f1h = na
float f1l = na
float f1c = na
int   f1ot = na
int   f1ct = na
if merge60All
    zn2.SwingAccumFvgBundle b60 =
         request.security(syminfo.tickerid, swTf3,
         zn2.swingAccumFvgBundleV2(swLen3, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    if not na(b60)
        s3ph  := b60.ph
        s3phO := b60.phOriginTime
        s3phE := b60.phOriginEndTime
        s3phC := b60.phConfirmedTime
        s3pl  := b60.pl
        s3plO := b60.plOriginTime
        s3plE := b60.plOriginEndTime
        s3plC := b60.plConfirmedTime
        a1New := b60.accNewBox
        a1Top := b60.accTop
        a1Bot := b60.accBottom
        a1Id  := b60.accBoxId
        a1Cs  := b60.accCandStart
        a1Ct  := b60.accConfirmedTime
        f1bN  := b60.fvgBullNew
        f1bT  := b60.fvgBullTop
        f1bB  := b60.fvgBullBottom
        f1bO  := b60.fvgBullOriginTime
        f1bC  := b60.fvgBullConfirmedTime
        f1sN  := b60.fvgBearNew
        f1sT  := b60.fvgBearTop
        f1sB  := b60.fvgBearBottom
        f1sO  := b60.fvgBearOriginTime
        f1sC  := b60.fvgBearConfirmedTime
        f1h   := b60.srcHigh
        f1l   := b60.srcLow
        f1c   := b60.srcClose
        f1ot  := b60.srcOpenTime
        f1ct  := b60.srcCloseTime
    true
else if merge60AF
    [p1, p2, p3, p4, p5, p6, p7, p8] =
         request.security(syminfo.tickerid, swTf3, zn2.pivotPackV2(swLen3),
         lookahead = barmerge.lookahead_off)
    zn2.AccumFvgBundle bAF1 =
         request.security(syminfo.tickerid, accTf1,
         zn2.accumFvgBundleV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    s3ph  := p1
    s3phO := p2
    s3phE := p3
    s3phC := p4
    s3pl  := p5
    s3plO := p6
    s3plE := p7
    s3plC := p8
    if not na(bAF1)
        a1New := bAF1.accNewBox
        a1Top := bAF1.accTop
        a1Bot := bAF1.accBottom
        a1Id  := bAF1.accBoxId
        a1Cs  := bAF1.accCandStart
        a1Ct  := bAF1.accConfirmedTime
        f1bN  := bAF1.fvgBullNew
        f1bT  := bAF1.fvgBullTop
        f1bB  := bAF1.fvgBullBottom
        f1bO  := bAF1.fvgBullOriginTime
        f1bC  := bAF1.fvgBullConfirmedTime
        f1sN  := bAF1.fvgBearNew
        f1sT  := bAF1.fvgBearTop
        f1sB  := bAF1.fvgBearBottom
        f1sO  := bAF1.fvgBearOriginTime
        f1sC  := bAF1.fvgBearConfirmedTime
        f1h   := bAF1.srcHigh
        f1l   := bAF1.srcLow
        f1c   := bAF1.srcClose
        f1ot  := bAF1.srcOpenTime
        f1ct  := bAF1.srcCloseTime
    true
else
    [p1, p2, p3, p4, p5, p6, p7, p8] =
         request.security(syminfo.tickerid, swTf3, zn2.pivotPackV2(swLen3),
         lookahead = barmerge.lookahead_off)
    [r1, r2, r3, r4, r5, r6] =
         request.security(syminfo.tickerid, accTf1,
         zn2.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    [u1, u2, u3, u4, u5, u6, u7, u8, u9, u10, u11, u12, u13, u14, u15] =
         request.security(syminfo.tickerid, fvgTf1, zn2.fvgPackV2(),
         lookahead = barmerge.lookahead_off)
    s3ph  := p1
    s3phO := p2
    s3phE := p3
    s3phC := p4
    s3pl  := p5
    s3plO := p6
    s3plE := p7
    s3plC := p8
    a1New := r1
    a1Top := r2
    a1Bot := r3
    a1Id  := r4
    a1Cs  := r5
    a1Ct  := r6
    f1bN := u1
    f1bT := u2
    f1bB := u3
    f1bO := u4
    f1bC := u5
    f1sN := u6
    f1sT := u7
    f1sB := u8
    f1sO := u9
    f1sC := u10
    f1h  := u11
    f1l  := u12
    f1c  := u13
    f1ot := u14
    f1ct := u15
    true

// ---- Group 240 : Accum #2 + FVG #2 -----------------------------------------
bool  a2New = false
float a2Top = na
float a2Bot = na
int   a2Id = na
int   a2Cs = na
int   a2Ct = na
bool  f2bN = false
float f2bT = na
float f2bB = na
int   f2bO = na
int   f2bC = na
bool  f2sN = false
float f2sT = na
float f2sB = na
int   f2sO = na
int   f2sC = na
float f2h = na
float f2l = na
float f2c = na
int   f2ot = na
int   f2ct = na
if merge240
    zn2.AccumFvgBundle bAF2 =
         request.security(syminfo.tickerid, accTf2,
         zn2.accumFvgBundleV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    if not na(bAF2)
        a2New := bAF2.accNewBox
        a2Top := bAF2.accTop
        a2Bot := bAF2.accBottom
        a2Id  := bAF2.accBoxId
        a2Cs  := bAF2.accCandStart
        a2Ct  := bAF2.accConfirmedTime
        f2bN  := bAF2.fvgBullNew
        f2bT  := bAF2.fvgBullTop
        f2bB  := bAF2.fvgBullBottom
        f2bO  := bAF2.fvgBullOriginTime
        f2bC  := bAF2.fvgBullConfirmedTime
        f2sN  := bAF2.fvgBearNew
        f2sT  := bAF2.fvgBearTop
        f2sB  := bAF2.fvgBearBottom
        f2sO  := bAF2.fvgBearOriginTime
        f2sC  := bAF2.fvgBearConfirmedTime
        f2h   := bAF2.srcHigh
        f2l   := bAF2.srcLow
        f2c   := bAF2.srcClose
        f2ot  := bAF2.srcOpenTime
        f2ct  := bAF2.srcCloseTime
    true
else
    [r1, r2, r3, r4, r5, r6] =
         request.security(syminfo.tickerid, accTf2,
         zn2.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    [u1, u2, u3, u4, u5, u6, u7, u8, u9, u10, u11, u12, u13, u14, u15] =
         request.security(syminfo.tickerid, fvgTf2, zn2.fvgPackV2(),
         lookahead = barmerge.lookahead_off)
    a2New := r1
    a2Top := r2
    a2Bot := r3
    a2Id  := r4
    a2Cs  := r5
    a2Ct  := r6
    f2bN := u1
    f2bT := u2
    f2bB := u3
    f2bO := u4
    f2bC := u5
    f2sN := u6
    f2sT := u7
    f2sB := u8
    f2sO := u9
    f2sC := u10
    f2h  := u11
    f2l  := u12
    f2c  := u13
    f2ot := u14
    f2ct := u15
    true

// ---- Group D : Accum #3 + FVG #3 -------------------------------------------
bool  a3New = false
float a3Top = na
float a3Bot = na
int   a3Id = na
int   a3Cs = na
int   a3Ct = na
bool  f3bN = false
float f3bT = na
float f3bB = na
int   f3bO = na
int   f3bC = na
bool  f3sN = false
float f3sT = na
float f3sB = na
int   f3sO = na
int   f3sC = na
float f3h = na
float f3l = na
float f3c = na
int   f3ot = na
int   f3ct = na
if mergeDay
    zn2.AccumFvgBundle bAF3 =
         request.security(syminfo.tickerid, accTf3,
         zn2.accumFvgBundleV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    if not na(bAF3)
        a3New := bAF3.accNewBox
        a3Top := bAF3.accTop
        a3Bot := bAF3.accBottom
        a3Id  := bAF3.accBoxId
        a3Cs  := bAF3.accCandStart
        a3Ct  := bAF3.accConfirmedTime
        f3bN  := bAF3.fvgBullNew
        f3bT  := bAF3.fvgBullTop
        f3bB  := bAF3.fvgBullBottom
        f3bO  := bAF3.fvgBullOriginTime
        f3bC  := bAF3.fvgBullConfirmedTime
        f3sN  := bAF3.fvgBearNew
        f3sT  := bAF3.fvgBearTop
        f3sB  := bAF3.fvgBearBottom
        f3sO  := bAF3.fvgBearOriginTime
        f3sC  := bAF3.fvgBearConfirmedTime
        f3h   := bAF3.srcHigh
        f3l   := bAF3.srcLow
        f3c   := bAF3.srcClose
        f3ot  := bAF3.srcOpenTime
        f3ct  := bAF3.srcCloseTime
    true
else
    [r1, r2, r3, r4, r5, r6] =
         request.security(syminfo.tickerid, accTf3,
         zn2.accumPackV2(accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax),
         lookahead = barmerge.lookahead_off)
    [u1, u2, u3, u4, u5, u6, u7, u8, u9, u10, u11, u12, u13, u14, u15] =
         request.security(syminfo.tickerid, fvgTf3, zn2.fvgPackV2(),
         lookahead = barmerge.lookahead_off)
    a3New := r1
    a3Top := r2
    a3Bot := r3
    a3Id  := r4
    a3Cs  := r5
    a3Ct  := r6
    f3bN := u1
    f3bT := u2
    f3bB := u3
    f3bO := u4
    f3bC := u5
    f3sN := u6
    f3sT := u7
    f3sB := u8
    f3sO := u9
    f3sC := u10
    f3h  := u11
    f3l  := u12
    f3c  := u13
    f3ot := u14
    f3ct := u15
    true
// ---- 各時間足が「新しく 1 本確定した」5分足を 1 回だけ検出する ----
//  ★ Phase3B : 時間足文字列が同じなら time() の結果も必ず同じなので、
//    まとめられたグループでは time() を 1 本しか要求しない。
//    merge フラグは入力だけで決まりバーをまたいで変わらないため、
//    三項演算子の遅延評価で time() の履歴がすれることはない。
//    ta.change() は従来どおり全て global scope で無条件に呼ぶ。
int t60  = time(swTf3)
int t240 = time(accTf2)
int tDay = time(accTf3)
//  ① 全部同じ : Accum #1 / FVG #1 も swTf3 の time() をそのまま使う (time は 1 本)
//  ② Accum #1 / FVG #1 だけ同じ : accTf1 の time() を 1 本取り FVG #1 と共有 (time は 2 本)
//  ③ 不一致 : 従来どおり 3 本
int tA1  = merge60All   ? t60 : time(accTf1)
int tF1  = sameAccFvg1  ? tA1 : time(fvgTf1)
int tF2  = merge240     ? t240 : time(fvgTf2)
int tF3  = mergeDay     ? tDay : time(fvgTf3)
bool nSw1 = nz(ta.change(time(swTf1)), 0) != 0
bool nSw2 = nz(ta.change(time(swTf2)), 0) != 0
bool nSw3 = nz(ta.change(t60), 0) != 0
bool nAc1 = nz(ta.change(tA1), 0) != 0
bool nAc2 = nz(ta.change(t240), 0) != 0
bool nAc3 = nz(ta.change(tDay), 0) != 0
bool nFv1 = nz(ta.change(tF1), 0) != 0
bool nFv2 = nz(ta.change(tF2), 0) != 0
bool nFv3 = nz(ta.change(tF3), 0) != 0

// ============================================================================
// 06. ENGINE UPDATE (確定 5分足 1 本につき 1 回だけ)
// ============================================================================
var int baseSeq  = 0
var int viewsNow = 0
//  ★ Phase2 (allocation 削減) : ZoneFeed を毎足 new せず 1 つを使い回す。
//    各足の先頭で resetFeed() が swings / accums / fvgs を clear し、
//    スカラーを既定値へ戻す。その後の代入順・値・格納順は従来と完全に同じ。
var zn2.ZoneFeed fd = zn2.newFeed()
if isFiveMin and barstate.isconfirmed
    baseSeq += 1
    zn2.resetFeed(fd)
    fd.baseOpen      := open
    fd.baseHigh      := high
    fd.baseLow       := low
    fd.baseClose     := close
    fd.basePrevClose := close[1]
    fd.baseOpenTime  := time
    fd.baseCloseTime := time_close
    fd.baseSeq       := baseSeq
    fd.baseConfirmed := true
    fd.mintick       := syminfo.mintick
    fd.maValid       := not na(ema1) and not na(ema2)
    fd.ema1          := ema1
    fd.ema1Delta     := ema1d
    fd.ema2          := ema2
    fd.ema2Delta     := ema2d
    fd.maConfirmTime := maCt
    fd.sessionCode   := sessCode
    fd.sessionId     := sessId
    fd.dayId         := tradingDay
    fd.weekId        := tradingWeek
    zn2.feedSwing(fd, swCode1, nSw1, s1ph, s1phO, s1phE, s1phC, s1pl, s1plO, s1plE, s1plC)
    zn2.feedSwing(fd, swCode2, nSw2, s2ph, s2phO, s2phE, s2phC, s2pl, s2plO, s2plE, s2plC)
    zn2.feedSwing(fd, swCode3, nSw3, s3ph, s3phO, s3phE, s3phC, s3pl, s3plO, s3plE, s3plC)
    zn2.feedAccum(fd, accCode1, nAc1, a1New, a1Top, a1Bot, a1Id, a1Cs, a1Ct)
    zn2.feedAccum(fd, accCode2, nAc2, a2New, a2Top, a2Bot, a2Id, a2Cs, a2Ct)
    zn2.feedAccum(fd, accCode3, nAc3, a3New, a3Top, a3Bot, a3Id, a3Cs, a3Ct)
    zn2.feedFvg(fd, fvgCode1, nFv1, f1bN, f1bT, f1bB, f1bO, f1bC, f1sN, f1sT, f1sB, f1sO, f1sC,
         f1h, f1l, f1c, f1ot, f1ct)
    zn2.feedFvg(fd, fvgCode2, nFv2, f2bN, f2bT, f2bB, f2bO, f2bC, f2sN, f2sT, f2sB, f2sO, f2sC,
         f2h, f2l, f2c, f2ot, f2ct)
    zn2.feedFvg(fd, fvgCode3, nFv3, f3bN, f3bT, f3bB, f3bO, f3bC, f3sN, f3sT, f3sB, f3sO, f3sC,
         f3h, f3l, f3c, f3ot, f3ct)
    viewsNow := zn2.update(eng, cfg, fd)

// ============================================================================
// 07. EVENT LOG (表示専用)
// ============================================================================
//  ★ Phase2 (表示専用) : showEventLog が OFF なら Event を一切拾わない。
//    Engine 内部の Event 生成は止めない (zn2.update() 側でそのまま動く)。
//  ★ Phase3C (表示専用) : 確定足ごとに str.format_time / str.tostring を呼ばず、
//    数値と列挙値のまま 60 件だけ保持する。文字列化は最終描画時に
//    実際に表へ出す eventLogMax 件にだけ行う。表示内容は従来と完全に同じ。
var array<int>    evTime  = array.new_int()
var array<int>    evType  = array.new_int()
var array<int>    evCore  = array.new_int()
var array<int>    evGen   = array.new_int()
var array<int>    evSide  = array.new_int()
var array<int>    evTouch = array.new_int()
var array<float>  evBot   = array.new_float()
var array<float>  evTop   = array.new_float()
var array<int>    evRoot  = array.new_int()
var array<string> evInfo  = array.new_string()

f_evTrim(int keep) =>
    while array.size(evTime) > keep
        array.shift(evTime)
        array.shift(evType)
        array.shift(evCore)
        array.shift(evGen)
        array.shift(evSide)
        array.shift(evTouch)
        array.shift(evBot)
        array.shift(evTop)
        array.shift(evRoot)
        array.shift(evInfo)
    array.size(evTime)

if showEventLog and isFiveMin and barstate.isconfirmed
    int ec = zn2.eventCount(eng)
    if ec > 0
        for i = 0 to ec - 1
            zn2.ZoneEvent ev = zn2.eventAt(eng, i)
            array.push(evTime,  nz(ev.eventTime, time))
            array.push(evType,  ev.eventType)
            array.push(evCore,  ev.coreId)
            array.push(evGen,   ev.generationId)
            array.push(evSide,  ev.side)
            array.push(evTouch, ev.touchNo)
            array.push(evBot,   ev.rangeBottom)
            array.push(evTop,   ev.rangeTop)
            array.push(evRoot,  ev.rootId)
            array.push(evInfo,  ev.info)
    f_evTrim(60)

//  保持した数値から 1 行分の文字列を作る (旧実装と同じ連結順 / 同じ書式)。
f_evLine(int k) =>
    str.format_time(array.get(evTime, k), "MM-dd HH:mm", zoneTz) + "  " +
     zn2.eventName(array.get(evType, k)) + "  core " + str.tostring(array.get(evCore, k)) +
     "/g" + str.tostring(array.get(evGen, k)) + "  " + zn2.sideName(array.get(evSide, k)) +
     "  T" + str.tostring(array.get(evTouch, k)) +
     "  [" + str.tostring(array.get(evBot, k), "#.##") + " - " +
     str.tostring(array.get(evTop, k), "#.##") + "]" +
     (array.get(evRoot, k) != 0 ? "  root#" + str.tostring(array.get(evRoot, k)) : "") +
     (array.get(evInfo, k) == "" ? "" : "  " + array.get(evInfo, k))

// ============================================================================
// 08. 描画 (表示はロジックへ一切影響しない)
// ============================================================================
//  ★ Phase2 (表示専用 / allocation 削減) ★
//    ・毎回すべての box / line / label を delete して作り直す方式をやめ、
//      プールに持った既存オブジェクトを setter で更新する。
//    ・必要数を超えた分だけ削除し、不足分だけ新規作成する。
//    ・リアルタイムの未確定ティックごとに再構築せず、Engine の確定状態が
//      進んだとき (processedBars が増えたとき) だけ描画とテーブルを更新する。
//    描画内容・座標・色・文字列は従来と同一。Engine の判定には一切関与しない。
var array<box>   gBoxes  = array.new<box>()
var array<line>  gLines  = array.new<line>()
var array<label> gLabels = array.new<label>()
var label        warnLbl = na

//  varip : 未確定ティックでも巻き戻らない表示用カウンタ (判定には使わない)
varip int  drawnProcessed = -1
varip bool drawnOnce      = false
//  更新するのは「初回表示」「新しいリアルタイム足の開始」「確定足で Engine が進んだ」
//  の 3 つだけ。未確定足の全ティックでは再描画しない。
bool needRedraw = barstate.islast and (
     not drawnOnce or
     barstate.isnew or
     eng.processedBars != drawnProcessed)

f_boxAt(int idx) =>
    box b = na
    if idx < array.size(gBoxes)
        b := array.get(gBoxes, idx)
    else
        b := box.new(bar_index, 0.0, bar_index, 0.0, xloc = xloc.bar_index)
        array.push(gBoxes, b)
    b

f_lineAt(int idx) =>
    line l = na
    if idx < array.size(gLines)
        l := array.get(gLines, idx)
    else
        l := line.new(bar_index, 0.0, bar_index, 0.0, xloc = xloc.bar_index)
        array.push(gLines, l)
    l

f_labelAt(int idx) =>
    label lb = na
    if idx < array.size(gLabels)
        lb := array.get(gLabels, idx)
    else
        lb := label.new(bar_index, 0.0, text = "", xloc = xloc.bar_index)
        array.push(gLabels, lb)
    lb

f_trimPools(int usedBox, int usedLine, int usedLabel) =>
    while array.size(gBoxes) > usedBox
        box.delete(array.pop(gBoxes))
    while array.size(gLines) > usedLine
        line.delete(array.pop(gLines))
    while array.size(gLabels) > usedLabel
        label.delete(array.pop(gLabels))
    true

f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)

f_viewColor(int side, int grade, int phase) =>
    grade == GR_UNAVAILABLE or phase == PH_FLIP_WAIT ? colInactive :
     side == SIDE_SUPPORT ? colSupport : colResistance

f_viewTransp(int grade, bool broad) =>
    broad ? 92 : grade == GR_STRONG ? 55 : grade == GR_NEUTRAL ? 75 : grade == GR_WEAK ? 88 : 92

f_viewLabel(zn2.ZoneView w) =>
    string t = "Core " + str.tostring(w.coreId) + " / Gen " + str.tostring(w.generationId) +
         " / " + zn2.sideName(w.side)
    t := t + "\n" + zn2.phaseName(w.phase) + " | " + zn2.gradeName(w.grade) +
         (w.baseStrong ? " (BaseStrong)" : "")
    t := t + "\nRange " + f_num(w.effectiveBottom, "#.##") + " - " + f_num(w.effectiveTop, "#.##") +
         " / Ref " + f_num(w.referencePrice, "#.##")
    t := t + "\nC " + str.tostring(w.cCount) + " / H " + str.tostring(w.hCount) +
         " / " + zn2.densityName(w.density)
    t := t + "\n" + (w.phase == PH_ACTIVE_TOUCH ? "Current Touch " + str.tostring(w.currentTouchNo)
         : "Upcoming Touch " + str.tostring(w.upcomingTouchNo))
    t := t + "\n" + zn2.weakReasonName(w.weakReason) + " / MaxDepth " + f_num(w.maxDepthPct, "#.#") + "%"
    t := t + "\nZoneFresh " + (w.zoneFresh ? "Y" : "N") + " / SideFresh " + (w.sideFresh ? "Y" : "N")
    t := t + "\nFVG " + zn2.fvgDirectionName(w.fvgDirectionMask) + " / roots " + str.tostring(w.fvgRootCount) +
         " / fresh " + str.tostring(w.fvgFreshCount) + " / state " + str.tostring(w.fvgStructuralStateMask)
    t := t + "\n" + w.categorySummary
    t := t + "\nRoots: " + w.rootSummary
    if w.phase == PH_ACTIVE_TOUCH and not na(w.snapshotBottom)
        t := t + "\nSnapshot " + f_num(w.snapshotBottom, "#.##") + " - " + f_num(w.snapshotTop, "#.##") +
             " | StartGrade " + zn2.gradeName(w.touchStartGrade)
    if w.pendingTopology
        t := t + "\nPendingTopology"
    if w.pendingGeneration
        t := t + "\nPendingGeneration"
    if w.isBroadContext
        t := t + "\nBROAD CONTEXT (not Strong)"
    if w.flipAttemptCount > 0
        t := t + "\nFlipAttempt x" + str.tostring(w.flipAttemptCount)
    t

if needRedraw and isFiveMin
    int nBox   = 0
    int nLine  = 0
    int nLabel = 0
    int vc = zn2.viewCount(eng)
    if showZones and vc > 0
        //  現在価格に近い順に並べ、描画本数だけ表示する (Zone の選別ではなく描画上限)
        array<float> dist = array.new_float()
        for i = 0 to vc - 1
            zn2.ZoneView w = zn2.viewAt(eng, i)
            float d = na(w.effectiveBottom) ? 1e9 :
                 close < w.effectiveBottom ? w.effectiveBottom - close :
                 close > w.effectiveTop ? close - w.effectiveTop : 0.0
            array.push(dist, d)
        array<int> ord = array.sort_indices(dist, order.ascending)
        int lim = int(math.min(vc, maxZonesDrawn))
        for k = 0 to lim - 1
            zn2.ZoneView w = zn2.viewAt(eng, array.get(ord, k))
            if not na(w.effectiveBottom) and not na(w.effectiveTop)
                color bc = f_viewColor(w.side, w.grade, w.phase)
                int   tr = f_viewTransp(w.grade, w.isBroadContext)
                bool  dashed = w.phase == PH_BROKEN or w.phase == PH_FLIP_WAIT or w.isBroadContext
                int   bw = w.phase == PH_ACTIVE_TOUCH ? 3 : w.grade == GR_STRONG ? 2 : 1
                if w.effectiveTop - w.effectiveBottom <= syminfo.mintick
                    //  一本線 Zone : 描画は line だが、ロジック上の幅は 0 のまま
                    line ln = f_lineAt(nLine)
                    nLine := nLine + 1
                    line.set_xy1(ln, bar_index - zoneLeftBars, w.effectiveBottom)
                    line.set_xy2(ln, bar_index + zoneRightBars, w.effectiveBottom)
                    line.set_color(ln, color.new(bc, math.max(tr - 40, 0)))
                    line.set_width(ln, bw)
                    line.set_style(ln, dashed ? line.style_dashed : line.style_solid)
                else
                    box bx = f_boxAt(nBox)
                    nBox := nBox + 1
                    box.set_lefttop(bx, bar_index - zoneLeftBars, w.effectiveTop)
                    box.set_rightbottom(bx, bar_index + zoneRightBars, w.effectiveBottom)
                    box.set_bgcolor(bx, color.new(bc, tr))
                    box.set_border_color(bx, color.new(bc, math.max(tr - 35, 0)))
                    box.set_border_width(bx, bw)
                    box.set_border_style(bx, dashed ? line.style_dashed : line.style_solid)
                if showLabels
                    label lb = f_labelAt(nLabel)
                    nLabel := nLabel + 1
                    label.set_xy(lb, bar_index + zoneRightBars,
                         w.side == SIDE_SUPPORT ? w.effectiveBottom : w.effectiveTop)
                    label.set_text(lb, f_viewLabel(w))
                    label.set_style(lb, label.style_label_left)
                    label.set_color(lb, color.new(bc, 25))
                    label.set_textcolor(lb, color.white)
                    label.set_size(lb, size.small)
    //  FVG 50% : 表示専用。Library の Zone 計算へは渡していない。
    if showFvg50
        int rc = zn2.rootCount(eng)
        if rc > 0
            for i = 0 to rc - 1
                zn2.RootDebugView r = zn2.rootAt(eng, i)
                if r.category == CAT_FVG and not na(r.nativeBottom) and not na(r.nativeTop)
                    float mid = (r.nativeBottom + r.nativeTop) / 2
                    line l50 = f_lineAt(nLine)
                    nLine := nLine + 1
                    line.set_xy1(l50, bar_index - zoneLeftBars, mid)
                    line.set_xy2(l50, bar_index + zoneRightBars, mid)
                    line.set_color(l50, color.new(color.gray, 40))
                    line.set_width(l50, 1)
                    line.set_style(l50, line.style_dotted)
                    label l5l = f_labelAt(nLabel)
                    nLabel := nLabel + 1
                    label.set_xy(l5l, bar_index + zoneRightBars, mid)
                    label.set_text(l5l, "FVG 50% DISPLAY ONLY (root#" + str.tostring(r.rootId) + ")")
                    label.set_style(l5l, label.style_label_left)
                    label.set_color(l5l, color.new(color.gray, 70))
                    label.set_textcolor(l5l, color.white)
                    label.set_size(l5l, size.tiny)
    //  使わなかった分だけ削除する (毎回の全削除・全再生成をしない)
    f_trimPools(nBox, nLine, nLabel)

// ============================================================================
// 09. DEBUG TABLES
// ============================================================================
f_txtSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_sessName(int code) =>
    code == SESS_ASIA ? "Asia" : code == SESS_EUROPE ? "Europe" : code == SESS_NY ? "NewYork" : "None"

var table dbg = na
if na(dbg)
    dbg := table.new(position.top_right, 2, 18, border_width = 1, frame_width = 1,
         frame_color = color.new(color.gray, 40))

f_dbgRow(int row, string k, string v, color bg) =>
    table.cell(dbg, 0, row, k, text_color = color.white, bgcolor = bg, text_size = f_txtSize(dbgTextSize),
         text_halign = text.align_left)
    table.cell(dbg, 1, row, v, text_color = color.white, bgcolor = color.new(bg, 80),
         text_size = f_txtSize(dbgTextSize), text_halign = text.align_left)

if needRedraw and showDebugTable
    table.clear(dbg, 0, 0, 1, 17)
    color hdr = color.new(color.gray, 30)
    color ok  = color.new(color.teal, 40)
    color bad = color.new(color.red, 30)
    f_dbgRow(0, "ZoneEngineV2 Harness", "v2 / display verification only", hdr)
    f_dbgRow(1, "Chart TF", isFiveMin ? "5M (OK)" : timeframe.period + "  ★5分足以外のため更新停止★",
         isFiveMin ? ok : bad)
    f_dbgRow(2, "Symbol", syminfo.ticker + (isGold ? " (XAUUSD OK)" : "  ★XAUUSD 以外★"), isGold ? ok : bad)
    f_dbgRow(3, "Config", eng.configValid ? "valid" : "INVALID : " + eng.configError, eng.configValid ? ok : bad)
    f_dbgRow(4, "Live cores / views", str.tostring(zn2.coreCount(eng)) + " cores / " +
         str.tostring(zn2.viewCount(eng)) + " views", hdr)
    f_dbgRow(5, "Roots", str.tostring(zn2.rootCount(eng)) + " (ended generations " +
         str.tostring(zn2.endedGenerationCount(eng)) + ")", hdr)
    f_dbgRow(6, "Pending", "topology " + str.tostring(eng.pendingTopologyCount) +
         " / generation " + str.tostring(eng.pendingGenerationCount), hdr)
    f_dbgRow(7, "Merge / Split", str.tostring(eng.mergeCount) + " / " + str.tostring(eng.splitCount), hdr)
    f_dbgRow(8, "Storage", (eng.storagePruned ? "PRUNED this bar" : "ok") +
         "  roots " + str.tostring(eng.prunedRootCount) + " / zones " + str.tostring(eng.prunedZoneCount) +
         (eng.touchHistoryTruncated ? "  ★touchHistoryTruncated★" : ""),
         eng.storagePruned or eng.touchHistoryTruncated ? bad : ok)
    f_dbgRow(9, "MA slope", "EMA" + str.tostring(emaLen1) + " " +
         (eng.maSlope1 > 0 ? "Up" : eng.maSlope1 < 0 ? "Down" : "Flat") + "  /  EMA" + str.tostring(emaLen2) + " " +
         (eng.maSlope2 > 0 ? "Up" : eng.maSlope2 < 0 ? "Down" : "Flat"), hdr)
    f_dbgRow(10, "Session", f_sessName(sessCode) + "  id " + str.tostring(sessId), hdr)
    f_dbgRow(11, "Day / Week id", str.tostring(tradingDay) + " / " + str.tostring(tradingWeek), hdr)
    f_dbgRow(12, "Session H/L", f_num(eng.sessHigh, "#.##") + " / " + f_num(eng.sessLow, "#.##"), hdr)
    f_dbgRow(13, "Day H/L", f_num(eng.dayHigh, "#.##") + " / " + f_num(eng.dayLow, "#.##"), hdr)
    f_dbgRow(14, "Week H/L", f_num(eng.weekHigh, "#.##") + " / " + f_num(eng.weekLow, "#.##"), hdr)
    f_dbgRow(15, "Processed bars", str.tostring(eng.processedBars) +
         (eng.duplicateBarSkipped ? "  (duplicate base bar skipped)" : ""), hdr)
    f_dbgRow(16, "Last base time", na(eng.lastBaseTime) ? "-" :
         str.format_time(eng.lastBaseTime, "yyyy-MM-dd HH:mm", zoneTz) + "  seq " + str.tostring(eng.lastBaseSeq), hdr)
    f_dbgRow(17, "Events this bar", str.tostring(zn2.eventCount(eng)) +
         "  (last update returned " + str.tostring(viewsNow) + " views)", hdr)

// ---- Root Debug table ------------------------------------------------------
var table rtb = na
if na(rtb)
    rtb := table.new(position.bottom_left, 6, 41, border_width = 1, frame_width = 1,
         frame_color = color.new(color.gray, 40))

f_rtbCell(int col, int row, string v, color bg) =>
    table.cell(rtb, col, row, v, text_color = color.white, bgcolor = bg,
         text_size = f_txtSize(dbgTextSize), text_halign = text.align_left)

if needRedraw and showRootTable
    table.clear(rtb, 0, 0, 5, 40)
    color hdr = color.new(color.gray, 30)
    f_rtbCell(0, 0, "Root", hdr)
    f_rtbCell(1, 0, "Category / Subtype", hdr)
    f_rtbCell(2, 0, "TF", hdr)
    f_rtbCell(3, 0, "State", hdr)
    f_rtbCell(4, 0, "Price / NativeRange", hdr)
    f_rtbCell(5, 0, "Detail", hdr)
    int rc = zn2.rootCount(eng)
    if rc > 0
        array<float> rd = array.new_float()
        for i = 0 to rc - 1
            zn2.RootDebugView r = zn2.rootAt(eng, i)
            float p = r.isRangeRoot ? (r.nativeBottom + r.nativeTop) / 2 : r.pointPrice
            array.push(rd, na(p) ? 1e9 : math.abs(p - close))
        array<int> ord = array.sort_indices(rd, order.ascending)
        int lim = int(math.min(rc, rootTableMax))
        for k = 0 to lim - 1
            int idx = array.get(ord, k)
            zn2.RootDebugView r = zn2.rootAt(eng, idx)
            color bg = color.new(color.gray, 70)
            f_rtbCell(0, k + 1, "#" + str.tostring(r.rootId), bg)
            f_rtbCell(1, k + 1, zn2.categoryName(r.category) + " / " + zn2.subtypeName(r.subtype), bg)
            f_rtbCell(2, k + 1, zn2.tfName(r.tfCode), bg)
            f_rtbCell(3, k + 1, zn2.rootStateName(r.state), bg)
            f_rtbCell(4, k + 1, r.isRangeRoot ? f_num(r.nativeBottom, "#.##") + " - " + f_num(r.nativeTop, "#.##")
                 : f_num(r.pointPrice, "#.##"), bg)
            string det = ""
            if r.category == CAT_FVG
                det := zn2.fvgDirectionName(r.direction == 0 ? 0 : r.direction) +
                     (r.fvgFresh ? " / Fresh" : " / FreshUsed") + (r.isBroadFvg ? " / BROAD" : "")
            else if r.pairKey != ""
                det := "pair " + r.pairKey
            else if r.periodKind != 0
                det := zn2.timeLabelName(zn2.rootLabelMaskAt(eng, idx))
            else
                det := r.originKey
            f_rtbCell(5, k + 1, det, bg)

// ---- Event log table -------------------------------------------------------
var table etb = na
if na(etb)
    etb := table.new(position.bottom_right, 1, 41, border_width = 1, frame_width = 1,
         frame_color = color.new(color.gray, 40))

if needRedraw and showEventLog
    table.clear(etb, 0, 0, 0, 40)
    table.cell(etb, 0, 0, "ZoneEngineV2 Events (newest first)", text_color = color.white,
         bgcolor = color.new(color.gray, 30), text_size = f_txtSize(dbgTextSize), text_halign = text.align_left)
    int n = array.size(evTime)
    int lim = int(math.min(n, eventLogMax))
    if lim > 0
        for k = 0 to lim - 1
            //  ★ Phase3C : 表へ出す 1 行をここで初めて文字列化する。
            string one = f_evLine(n - 1 - k)
            table.cell(etb, 0, k + 1, one, text_color = color.white, bgcolor = color.new(color.gray, 80),
                 text_size = f_txtSize(dbgTextSize), text_halign = text.align_left)

// ============================================================================
// 10. 環境警告 (チャート上でも分かるように出す)
// ============================================================================
//  ★ Phase2 : 警告ラベルも 1 つを使い回し、確定状態が変わったときだけ更新する
if needRedraw
    string w = ""
    if not isFiveMin
        w := w + "★ チャート時間足が " + timeframe.period + " です。ZoneEngineV2 Harness は 5分足専用のため Engine を更新していません。\n"
    if not isGold
        w := w + "★ 銘柄が " + syminfo.ticker + " です (想定は XAUUSD)。Zone ロジックは変更していません。\n"
    if not eng.configValid
        w := w + "★ ZoneCfg が不正です : " + eng.configError + " (更新を停止しています)\n"
    if w != ""
        if na(warnLbl)
            warnLbl := label.new(bar_index, high, text = w, style = label.style_label_down,
                 color = color.new(color.red, 15), textcolor = color.white, size = size.normal)
        else
            label.set_xy(warnLbl, bar_index, high)
            label.set_text(warnLbl, w)
    else if not na(warnLbl)
        label.delete(warnLbl)
        warnLbl := na
    //  この確定状態ぶんの表示更新は完了 (次は Engine が進んだときだけ)
    drawnProcessed := eng.processedBars
    drawnOnce      := true

// ============================================================================
//  END OF ZoneEngineV2 Visual Harness
// ============================================================================

// ============================================================================
//  Zone Sync Probe 入れ子 (ZSP-0N)  —  検証専用。Zone は描かない。既存スクリプトは変更しない。
// ----------------------------------------------------------------------------
//  代替構成 (5分コンテキストの中で Lab と同じ処理を 1 本ずつ進める) に必要な Pine の動作を確かめる:
//   ① 5分コンテキストの中の入れ子の request.security (1分 / 1H / 4H / 日足 / 週足) がコンパイル・実行できるか
//   ② 入れ子の 1分 EMA3000 (Lab: 5分足チャートで request.security("1", ta.ema(close, 3000), lookahead_off)) の確定値が、
//      5分足チャートの Lab の「MA 1分足 EMA」と同じになるか (チャート足を変えても同じか)
//   ③ 入れ子の上位足 (確定足 time[1]・lookahead_on) が届いた 5分足 = 登録 5分足 (開始時刻) と、その確定時刻 (利用可能時刻)
//   ④ 入れ子の各コンテキストの最初の足と本数 (= その時間足で使える履歴。Lab の 5分足チャートから見た値と比べる)
//   ⑤ request.security から配列と長い文字列 (表示帯の一覧の受け渡しに使う) を返せるか
//  ★ TradingView 実機でのコンパイル・表示は未実施。コンパイルエラー・実行時エラーの文面も結果として記録する (ZONE_SYNC_FEASIBILITY_ja.md §5)。
// ============================================================================

//@version=5
indicator("Zone Sync Probe 入れ子 (ZSP-0N)", "ZSP0N", overlay = true)

znAnchor = input.time(timestamp("2026-10-26T07:00:00+09:00"), "蓄積開始時刻 (ZSP-0 と同じ値)")
znLen1   = input.int(3000, "1分足 EMA 本数 (Lab と同じ)", minval = 1)
znStrN   = input.int(300, "文字列試験: 要素数 (1 要素 約 40 文字)", minval = 1, maxval = 1000)
znTbl    = input.bool(true, "表を表示")

simple bool znLowTf = timeframe.in_seconds() <= 300

// 入れ子のコンテキストの最初の足と本数
f_znCtx() =>
    var int ft = time
    var int nb = 0
    nb += 1
    [ft, nb]

// 配列を返す
f_znArr() =>
    array.from(float(time[1]), close[1], high[1], low[1])

f_znEng(int aT, simple int l1, int sN) =>
    float e1 = request.security(syminfo.tickerid, "1", ta.ema(close, l1), lookahead = barmerge.lookahead_off)
    int   k1 = request.security(syminfo.tickerid, "60",  time[1], lookahead = barmerge.lookahead_on)
    int   k4 = request.security(syminfo.tickerid, "240", time[1], lookahead = barmerge.lookahead_on)
    int   kD = request.security(syminfo.tickerid, "D",   time[1], lookahead = barmerge.lookahead_on)
    int   kW = request.security(syminfo.tickerid, "W",   time[1], lookahead = barmerge.lookahead_on)
    [c1T, c1N] = request.security(syminfo.tickerid, "1",   f_znCtx(), lookahead = barmerge.lookahead_off)
    [cHT, cHN] = request.security(syminfo.tickerid, "60",  f_znCtx(), lookahead = barmerge.lookahead_on)
    [c4T, c4N] = request.security(syminfo.tickerid, "240", f_znCtx(), lookahead = barmerge.lookahead_on)
    [cDT, cDN] = request.security(syminfo.tickerid, "D",   f_znCtx(), lookahead = barmerge.lookahead_on)
    [cWT, cWN] = request.security(syminfo.tickerid, "W",   f_znCtx(), lookahead = barmerge.lookahead_on)
    array<float> aH = request.security(syminfo.tickerid, "60", f_znArr(), lookahead = barmerge.lookahead_on)
    var int ft5 = time
    var int n   = 0
    // 1H の確定足が新しく届いた 5分足 (Lab の登録足に当たる) の開始時刻と確定時刻
    var int rKey = na
    var int rT   = na
    var int rAv  = na
    var int nReg = 0
    int pT  = time[1]
    int pTc = time_close[1]
    int pK1 = k1[1]
    if not na(pT) and pT >= aT
        n += 1
        if not na(pK1) and (na(rKey) or pK1 != rKey)
            rKey := pK1
            rT   := pT
            rAv  := pTc
            nReg += 1
    // 長い文字列 (確定した 5分足ごとに作り直す。表示帯の一覧の受け渡しを想定した長さ)
    string s = ""
    if not na(pT) and pT >= aT
        for i = 1 to sN
            s := s + str.tostring(close[1] + i, "#.###") + "," + str.tostring(pT) + "," + str.tostring(i) + ";"
    array<float> aOut = na(aH) ? array.new_float() : array.copy(aH)
    array.push(aOut, float(nz(pT)))
    [ft5, n, time_close, e1, e1[1], k1[1], k4[1], kD[1], kW[1], rKey, rT, rAv, nReg, c1T, c1N, cHT, cHN, c4T, c4N, cDT, cDN, cWT, cWN, aOut, s]

[znFt5, znN, znTc5, znE1a, znE1b, znK1, znK4, znKD, znKW, znRKey, znRT, znRAv, znNReg, znC1T, znC1N, znCHT, znCHN, znC4T, znC4N, znCDT, znCDN,
     znCWT, znCWN, znArr, znStr] = request.security(syminfo.tickerid, "5", f_znEng(znAnchor, znLen1, znStrN),
     lookahead = znLowTf ? barmerge.lookahead_on : barmerge.lookahead_off)

// 1分 EMA: その 5分足が確定済みならその足の値、形成中なら 1 本前の値 (ZSP-0 と同じ選び方)。他の行は「確定した 5分足 t-1 まで」
bool  znUseCur = not na(znTc5) and math.min(time_close, timenow) >= znTc5
float znE1 = znUseCur ? znE1a : znE1b
plot(znE1, "1分 EMA (5分基準・確定値)", color = color.new(color.blue, 30))

f_znTm(int t) =>
    na(t) ? "na" : str.format_time(t, "yyyy-MM-dd HH:mm", syminfo.timezone)

var table znTb = table.new(position.bottom_right, 2, 20, border_width = 1)
f_znRow(int r, string a, string b) =>
    table.cell(znTb, 0, r, a, text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(znTb, 1, r, b, text_color = color.white, bgcolor = color.new(color.teal, 20), text_size = size.small)
    true

if znTbl and barstate.islast
    f_znRow(0, "チャート足", timeframe.period)
    f_znRow(1, "5分: 最初の足 / 処理数", f_znTm(znFt5) + " / " + str.tostring(znN))
    f_znRow(2, "1分 EMA (確定値)", str.tostring(znE1, format.mintick) + (znUseCur ? " (その5分足)" : " (1本前の5分足)"))
    f_znRow(3, "確定済み 1H / 4H", f_znTm(znK1) + " / " + f_znTm(znK4))
    f_znRow(4, "確定済み 日足 / 週足", f_znTm(znKD) + " / " + f_znTm(znKW))
    f_znRow(5, "1H 登録: 5分足開始 / 利用可能", f_znTm(znRT) + " / " + f_znTm(znRAv) + " (" + str.tostring(znNReg) + " 回)")
    f_znRow(6, "1分 履歴: 最初 / 本数", f_znTm(znC1T) + " / " + str.tostring(znC1N))
    f_znRow(7, "1H 履歴: 最初 / 本数", f_znTm(znCHT) + " / " + str.tostring(znCHN))
    f_znRow(8, "4H 履歴: 最初 / 本数", f_znTm(znC4T) + " / " + str.tostring(znC4N))
    f_znRow(9, "日足 履歴: 最初 / 本数", f_znTm(znCDT) + " / " + str.tostring(znCDN))
    f_znRow(10, "週足 履歴: 最初 / 本数", f_znTm(znCWT) + " / " + str.tostring(znCWN))
    f_znRow(11, "配列 (1H 確定足 OHLC の一部 + 5分)", na(znArr) ? "na" : str.tostring(array.size(znArr)) + " 要素: " + str.tostring(znArr))
    f_znRow(12, "文字列の長さ", str.tostring(str.length(znStr)))

// ============================================================
//  EMA 単体モジュール (EMA200/600/1000/2000/3000 / Indicator版)
// ============================================================
//  ・EMA群だけを独立モジュール化。
//  ・後で Pivot / Cloud / BB / FVG / Fib / RSI / MACD /
//    ストキャス / 出来高 / レジサポ と AND 接続する前提。
//  ・strategy ではなく indicator。シグナル出力のみ。
//  ・strategy.entry/exit/closedtrades/opentrades は使わない。
//  役割: A帯上中下 B帯中NoTrade C反発 D SRフリップ E クロス
//        F 傾き G/H 収束/発散 I パーフェクトオーダー J 帯リテスト
//        K 3000 Clean Touch + Rank
//  ※ plot上限(64)対策で 各EMA傾きは状態値(1/0/-1)1本に集約。
//     Up/Down/Flat 個別は内部判定・カウント・デバッグテーブルで保持。
// ============================================================

//@version=5
indicator(
     title          = "EMA Module",
     shorttitle     = "EMA-M",
     overlay        = true,
     max_bars_back  = 3000,
     max_labels_count = 500
 )

// ============================================================
//  入力 (グループ: EMA Module)
// ============================================================
grpEMA = "EMA Module"

useEMAModule      = input.bool(true, "EMAモジュールを使う", group = grpEMA)
showEMA           = input.bool(true, "EMAを表示",           group = grpEMA)
showEMALabels     = input.bool(true, "シグナルラベルを表示", group = grpEMA)
showEMADebugTable = input.bool(true, "デバッグテーブルを表示", group = grpEMA)

emaLen1 = input.int(200,  "EMA 1 Length", minval = 1, group = grpEMA)
emaLen2 = input.int(600,  "EMA 2 Length", minval = 1, group = grpEMA)
emaLen3 = input.int(1000, "EMA 3 Length", minval = 1, group = grpEMA)
emaLen4 = input.int(2000, "EMA 4 Length", minval = 1, group = grpEMA)
emaLen5 = input.int(3000, "EMA 5 Length", minval = 1, group = grpEMA)
emaSource = input.source(close, "EMA Source", group = grpEMA)

useEMABandFilter     = input.bool(true, "A: EMA帯 上/中/下フィルター", group = grpEMA)
useEMAInsideNoTrade  = input.bool(true, "B: EMA帯の中はNoTrade",       group = grpEMA)
useEMABounce         = input.bool(true, "C: EMA反発",                  group = grpEMA)
useEMASRFlip         = input.bool(true, "D: EMAサポレジ転換",          group = grpEMA)
useEMACross          = input.bool(true, "E: EMAクロス",                group = grpEMA)
useEMASlope          = input.bool(true, "F: EMA傾き判定",              group = grpEMA)
useEMAConvergence    = input.bool(true, "G: EMA収束",                  group = grpEMA)
useEMADivergence     = input.bool(true, "H: EMA発散",                  group = grpEMA)
useEMAPerfectOrder   = input.bool(false, "I: パーフェクトオーダー",    group = grpEMA)
useEMABandRetest     = input.bool(true, "J: EMA帯抜けリテスト",        group = grpEMA)
useEMA3000CleanTouch = input.bool(true, "K: 3000EMA Clean Touch",      group = grpEMA)

emaEntryMode = input.string("Any", "エントリー結合", options = ["Any", "All"], group = grpEMA)

emaTouchMode   = input.string("ATR", "EMA接近判定", options = ["Dollar", "ATR"], group = grpEMA)
emaTouchDollar = input.float(3.0,  "EMA接近幅($)",      step = 0.1,  group = grpEMA)
emaTouchATR    = input.float(0.25, "EMA接近幅 ATR倍率", step = 0.05, group = grpEMA)

emaSlopeLookback = input.int(5, "EMA傾き判定本数", minval = 1, group = grpEMA)
emaSlopeMinATR   = input.float(0.15, "最低傾き ATR倍率", step = 0.05, group = grpEMA)
emaFlatATR       = input.float(0.05, "水平判定 ATR倍率", step = 0.01, group = grpEMA)

emaSRFlipBars     = input.int(10, "EMAサポレジ転換 有効本数", minval = 1, group = grpEMA)
emaBandRetestBars = input.int(10, "EMA帯リテスト 有効本数",   minval = 1, group = grpEMA)

emaConvergenceATR = input.float(1.0, "EMA収束判定 ATR倍率", step = 0.1, group = grpEMA)
emaDivergenceATR  = input.float(2.0, "EMA発散判定 ATR倍率", step = 0.1, group = grpEMA)
useEMAConvergenceNoTrade = input.bool(false, "EMA収束中NoTrade", group = grpEMA)

ema3000CleanDistanceATR = input.float(0.8, "3000EMA Clean距離 ATR倍率", step = 0.1, group = grpEMA)
useEMAFlatWeakFilter    = input.bool(true,  "水平EMAは反発弱い判定にする", group = grpEMA)
useEMAFlatBounceBlock   = input.bool(false, "水平EMA反発を禁止",           group = grpEMA)

// L: EMA Market State (アリゲーター思想)
useEMAMarketState     = input.bool(true,  "L: EMA Market Stateを使う", group = grpEMA)
useEMASleepingNoTrade = input.bool(true,  "Sleeping中NoTrade",         group = grpEMA)
useEMAEndingNoTrade   = input.bool(false, "Ending中NoTrade",           group = grpEMA)
emaStateLookback      = input.int(5, "Market State判定Lookback", minval = 1, group = grpEMA)
emaAwakeningSpreadChangeATR = input.float(0.3, "Awakening 最低Spread拡大 ATR倍率", step = 0.05, group = grpEMA)
emaEndingSpreadShrinkATR    = input.float(0.3, "Ending 最低Spread縮小 ATR倍率",   step = 0.05, group = grpEMA)
showEMAStateLabels    = input.bool(true, "Market Stateラベルを表示", group = grpEMA)

// ============================================================
//  優先度1: EMA計算
// ============================================================
float ema1 = ta.ema(emaSource, emaLen1)
float ema2 = ta.ema(emaSource, emaLen2)
float ema3 = ta.ema(emaSource, emaLen3)
float ema4 = ta.ema(emaSource, emaLen4)
float ema5 = ta.ema(emaSource, emaLen5)
float atr = ta.atr(14)
float emaTouchRange = emaTouchMode == "ATR" ? atr * emaTouchATR : emaTouchDollar

bool eAct = useEMAModule

// ============================================================
//  優先度1: EMA帯 上/中/下
// ============================================================
float emaBandTop    = math.max(ema1, math.max(ema2, math.max(ema3, math.max(ema4, ema5))))
float emaBandBottom = math.min(ema1, math.min(ema2, math.min(ema3, math.min(ema4, ema5))))
bool emaBandValid = not na(emaBandTop) and not na(emaBandBottom)

bool aboveEMABand  = emaBandValid and close > emaBandTop
bool belowEMABand  = emaBandValid and close < emaBandBottom
bool insideEMABand = emaBandValid and not aboveEMABand and not belowEMABand

bool emaBandOkLong  = not (eAct and useEMABandFilter) or aboveEMABand
bool emaBandOkShort = not (eAct and useEMABandFilter) or belowEMABand

// ============================================================
//  反転ローソク (共通)
// ============================================================
float ema_body   = math.abs(close - open)
float ema_upWick = high - math.max(open, close)
float ema_dnWick = math.min(open, close) - low
bool ema_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool ema_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool ema_pinLower = ema_dnWick >= ema_body and ema_dnWick >= ema_upWick
bool ema_pinUpper = ema_upWick >= ema_body and ema_upWick >= ema_dnWick
bool ema_bullishReversal = ema_bullEngulf or ema_pinLower or close > open
bool ema_bearishReversal = ema_bearEngulf or ema_pinUpper or close < open

// ============================================================
//  EMA接近判定
// ============================================================
f_near(price, level, rng) =>
    not na(level) and math.abs(price - level) <= rng

bool nearEMA1 = f_near(close, ema1, emaTouchRange)
bool nearEMA2 = f_near(close, ema2, emaTouchRange)
bool nearEMA3 = f_near(close, ema3, emaTouchRange)
bool nearEMA4 = f_near(close, ema4, emaTouchRange)
bool nearEMA5 = f_near(close, ema5, emaTouchRange)
bool nearAnyEMA = nearEMA1 or nearEMA2 or nearEMA3 or nearEMA4 or nearEMA5
bool nearLowerEMA1 = nearEMA1 and ema1 <= close
bool nearLowerEMA2 = nearEMA2 and ema2 <= close
bool nearLowerEMA3 = nearEMA3 and ema3 <= close
bool nearLowerEMA4 = nearEMA4 and ema4 <= close
bool nearLowerEMA5 = nearEMA5 and ema5 <= close
bool nearUpperEMA1 = nearEMA1 and ema1 >= close
bool nearUpperEMA2 = nearEMA2 and ema2 >= close
bool nearUpperEMA3 = nearEMA3 and ema3 >= close
bool nearUpperEMA4 = nearEMA4 and ema4 >= close
bool nearUpperEMA5 = nearEMA5 and ema5 >= close
bool nearLowerEMA = nearLowerEMA1 or nearLowerEMA2 or nearLowerEMA3 or nearLowerEMA4 or nearLowerEMA5
bool nearUpperEMA = nearUpperEMA1 or nearUpperEMA2 or nearUpperEMA3 or nearUpperEMA4 or nearUpperEMA5

// ============================================================
//  F: EMA傾き判定
// ============================================================
float slopeThreshold = atr * emaSlopeMinATR
float flatThreshold  = atr * emaFlatATR
float ema1Slope = ema1 - ema1[emaSlopeLookback]
float ema2Slope = ema2 - ema2[emaSlopeLookback]
float ema3Slope = ema3 - ema3[emaSlopeLookback]
float ema4Slope = ema4 - ema4[emaSlopeLookback]
float ema5Slope = ema5 - ema5[emaSlopeLookback]
bool ema1SlopeUp = ema1Slope >  slopeThreshold
bool ema2SlopeUp = ema2Slope >  slopeThreshold
bool ema3SlopeUp = ema3Slope >  slopeThreshold
bool ema4SlopeUp = ema4Slope >  slopeThreshold
bool ema5SlopeUp = ema5Slope >  slopeThreshold
bool ema1SlopeDown = ema1Slope < -slopeThreshold
bool ema2SlopeDown = ema2Slope < -slopeThreshold
bool ema3SlopeDown = ema3Slope < -slopeThreshold
bool ema4SlopeDown = ema4Slope < -slopeThreshold
bool ema5SlopeDown = ema5Slope < -slopeThreshold
bool ema1Flat = math.abs(ema1Slope) <= flatThreshold
bool ema2Flat = math.abs(ema2Slope) <= flatThreshold
bool ema3Flat = math.abs(ema3Slope) <= flatThreshold
bool ema4Flat = math.abs(ema4Slope) <= flatThreshold
bool ema5Flat = math.abs(ema5Slope) <= flatThreshold
int emaSlopeUpCount   = (ema1SlopeUp ? 1 : 0) + (ema2SlopeUp ? 1 : 0) + (ema3SlopeUp ? 1 : 0) + (ema4SlopeUp ? 1 : 0) + (ema5SlopeUp ? 1 : 0)
int emaSlopeDownCount = (ema1SlopeDown ? 1 : 0) + (ema2SlopeDown ? 1 : 0) + (ema3SlopeDown ? 1 : 0) + (ema4SlopeDown ? 1 : 0) + (ema5SlopeDown ? 1 : 0)
int emaFlatCount      = (ema1Flat ? 1 : 0) + (ema2Flat ? 1 : 0) + (ema3Flat ? 1 : 0) + (ema4Flat ? 1 : 0) + (ema5Flat ? 1 : 0)
int ema1SlopeState = ema1SlopeUp ? 1 : ema1SlopeDown ? -1 : 0
int ema2SlopeState = ema2SlopeUp ? 1 : ema2SlopeDown ? -1 : 0
int ema3SlopeState = ema3SlopeUp ? 1 : ema3SlopeDown ? -1 : 0
int ema4SlopeState = ema4SlopeUp ? 1 : ema4SlopeDown ? -1 : 0
int ema5SlopeState = ema5SlopeUp ? 1 : ema5SlopeDown ? -1 : 0

bool emaSlopeOkLong  = not (eAct and useEMASlope) or emaSlopeUpCount   >= 3
bool emaSlopeOkShort = not (eAct and useEMASlope) or emaSlopeDownCount >= 3

// ============================================================
//  B: EMA帯の中NoTrade (Base)
// ============================================================
bool emaNoTradeLong  = eAct and useEMAInsideNoTrade and insideEMABand
bool emaNoTradeShort = eAct and useEMAInsideNoTrade and insideEMABand

// ============================================================
//  C: EMA反発
// ============================================================
// 水平EMA反発の弱判定 (方向別: BUYは下側EMA / SELLは上側EMAのみ見る)
bool emaBounceWeakBuy  = useEMAFlatWeakFilter and ((nearLowerEMA1 and ema1Flat) or (nearLowerEMA2 and ema2Flat) or (nearLowerEMA3 and ema3Flat) or (nearLowerEMA4 and ema4Flat) or (nearLowerEMA5 and ema5Flat))
bool emaBounceWeakSell = useEMAFlatWeakFilter and ((nearUpperEMA1 and ema1Flat) or (nearUpperEMA2 and ema2Flat) or (nearUpperEMA3 and ema3Flat) or (nearUpperEMA4 and ema4Flat) or (nearUpperEMA5 and ema5Flat))
bool emaBounceWeak = emaBounceWeakBuy or emaBounceWeakSell   // 表示用/総合
// 方向別: BUY反発は価格下側EMA(サポート) / SELL反発は価格上側EMA(レジスタンス)
bool emaBuyBounceSignalBase  = eAct and useEMABounce and nearLowerEMA and ema_bullishReversal and close > emaBandBottom
bool emaSellBounceSignalBase = eAct and useEMABounce and nearUpperEMA and ema_bearishReversal and close < emaBandTop
// 水平EMA反発を禁止できる (方向別 weak で判定)
bool emaBuyBounceSignal  = emaBuyBounceSignalBase  and not (useEMAFlatBounceBlock and emaBounceWeakBuy)
bool emaSellBounceSignal = emaSellBounceSignalBase and not (useEMAFlatBounceBlock and emaBounceWeakSell)

// ============================================================
//  D: EMAサポレジ転換 (長期EMA優先で保存)
// ============================================================
var float emaBreakUpLevel = na
var int   emaBreakUpBar   = na
var float emaBreakDnLevel = na
var int   emaBreakDnBar   = na
if ta.crossover(close, ema5)
    emaBreakUpLevel := ema5
    emaBreakUpBar := bar_index
else if ta.crossover(close, ema4)
    emaBreakUpLevel := ema4
    emaBreakUpBar := bar_index
else if ta.crossover(close, ema3)
    emaBreakUpLevel := ema3
    emaBreakUpBar := bar_index
else if ta.crossover(close, ema2)
    emaBreakUpLevel := ema2
    emaBreakUpBar := bar_index
else if ta.crossover(close, ema1)
    emaBreakUpLevel := ema1
    emaBreakUpBar := bar_index
if ta.crossunder(close, ema5)
    emaBreakDnLevel := ema5
    emaBreakDnBar := bar_index
else if ta.crossunder(close, ema4)
    emaBreakDnLevel := ema4
    emaBreakDnBar := bar_index
else if ta.crossunder(close, ema3)
    emaBreakDnLevel := ema3
    emaBreakDnBar := bar_index
else if ta.crossunder(close, ema2)
    emaBreakDnLevel := ema2
    emaBreakDnBar := bar_index
else if ta.crossunder(close, ema1)
    emaBreakDnLevel := ema1
    emaBreakDnBar := bar_index

bool emaBuySRFlipSignal  = eAct and useEMASRFlip and not na(emaBreakUpLevel) and (bar_index - emaBreakUpBar) <= emaSRFlipBars and low <= emaBreakUpLevel + emaTouchRange and close > emaBreakUpLevel and ema_bullishReversal
bool emaSellSRFlipSignal = eAct and useEMASRFlip and not na(emaBreakDnLevel) and (bar_index - emaBreakDnBar) <= emaSRFlipBars and high >= emaBreakDnLevel - emaTouchRange and close < emaBreakDnLevel and ema_bearishReversal

// ============================================================
//  E: EMAクロス (Rank加点/Bias補助)
// ============================================================
bool emaBuyCrossSignal  = eAct and useEMACross and (ta.crossover(ema1, ema2) or ta.crossover(ema1, ema3) or ta.crossover(ema2, ema3))
bool emaSellCrossSignal = eAct and useEMACross and (ta.crossunder(ema1, ema2) or ta.crossunder(ema1, ema3) or ta.crossunder(ema2, ema3))

// ============================================================
//  G/H: 収束 / 発散
// ============================================================
float emaSpread    = emaBandValid ? emaBandTop - emaBandBottom : na
float emaSpreadATR = (not na(emaSpread) and atr != 0) ? emaSpread / atr : na
bool emaConvergenceSignal = eAct and useEMAConvergence and not na(emaSpread) and emaSpread <= atr * emaConvergenceATR
bool emaDivergenceSignal  = eAct and useEMADivergence  and not na(emaSpread) and emaSpread >= atr * emaDivergenceATR
bool emaSpreadExpanding   = not na(emaSpread) and not na(emaSpread[1]) and emaSpread > emaSpread[1]
bool emaSpreadContracting = not na(emaSpread) and not na(emaSpread[1]) and emaSpread < emaSpread[1]
bool emaNoTradeConvergence = eAct and useEMAConvergenceNoTrade and emaConvergenceSignal

// ============================================================
//  I: パーフェクトオーダー
// ============================================================
bool emaPerfectOrderLong  = ema1 > ema2 and ema2 > ema3 and ema3 > ema4 and ema4 > ema5
bool emaPerfectOrderShort = ema1 < ema2 and ema2 < ema3 and ema3 < ema4 and ema4 < ema5
bool emaPerfectOrderOkLong  = not (eAct and useEMAPerfectOrder) or emaPerfectOrderLong
bool emaPerfectOrderOkShort = not (eAct and useEMAPerfectOrder) or emaPerfectOrderShort

// ============================================================
//  J: EMA帯抜けリテスト
// ============================================================
var int emaBandBreakUpBar = na
var int emaBandBreakDnBar = na
if aboveEMABand and not aboveEMABand[1]
    emaBandBreakUpBar := bar_index
if belowEMABand and not belowEMABand[1]
    emaBandBreakDnBar := bar_index

bool emaBuyBandRetestSignal  = eAct and useEMABandRetest and emaBandValid and not na(emaBandBreakUpBar) and (bar_index - emaBandBreakUpBar) <= emaBandRetestBars and low <= emaBandTop + emaTouchRange and close > emaBandTop and ema_bullishReversal
bool emaSellBandRetestSignal = eAct and useEMABandRetest and emaBandValid and not na(emaBandBreakDnBar) and (bar_index - emaBandBreakDnBar) <= emaBandRetestBars and high >= emaBandBottom - emaTouchRange and close < emaBandBottom and ema_bearishReversal

// ============================================================
//  K: 3000EMA Clean Touch
// ============================================================
float ema3000CleanDistance = atr * ema3000CleanDistanceATR
bool ema3000Clean = not na(ema5) and math.abs(ema1 - ema5) > ema3000CleanDistance and math.abs(ema2 - ema5) > ema3000CleanDistance and math.abs(ema3 - ema5) > ema3000CleanDistance and math.abs(ema4 - ema5) > ema3000CleanDistance
bool ema3000CleanTouch = eAct and useEMA3000CleanTouch and nearEMA5 and ema3000Clean
bool ema3000WeakTouch  = nearEMA5 and not ema3000Clean

// ============================================================
//  L: EMA Market State (アリゲーター思想)
//   1 Sleeping(寝/レンジ) 2 Awakening(初動) 3 Hunting(強トレンド) 4 Ending(終了)
// ============================================================
bool emaStateActive = useEMAModule and useEMAMarketState
float emaSpreadChange    = (not na(emaSpread) and not na(emaSpread[emaStateLookback])) ? emaSpread - emaSpread[emaStateLookback] : na
float emaSpreadChangeATR = (atr != 0 and not na(emaSpreadChange)) ? emaSpreadChange / atr : na
bool emaSpreadExpansionStrong = not na(emaSpreadChangeATR) and emaSpreadChangeATR >=  emaAwakeningSpreadChangeATR
bool emaSpreadShrinkStrong    = not na(emaSpreadChangeATR) and emaSpreadChangeATR <= -emaEndingSpreadShrinkATR

bool emaStateSleeping = emaStateActive and emaConvergenceSignal and emaFlatCount >= 3
bool emaStateAwakeningLong  = emaStateActive and emaSpreadExpanding and emaSpreadExpansionStrong and aboveEMABand and emaSlopeUpCount >= 2
bool emaStateAwakeningShort = emaStateActive and emaSpreadExpanding and emaSpreadExpansionStrong and belowEMABand and emaSlopeDownCount >= 2
bool emaStateAwakening = emaStateAwakeningLong or emaStateAwakeningShort
bool emaStateHuntingLong  = emaStateActive and emaDivergenceSignal and aboveEMABand and (emaPerfectOrderLong or emaSlopeUpCount >= 4)
bool emaStateHuntingShort = emaStateActive and emaDivergenceSignal and belowEMABand and (emaPerfectOrderShort or emaSlopeDownCount >= 4)
bool emaStateHunting = emaStateHuntingLong or emaStateHuntingShort

bool emaPerfectOrderAny     = emaPerfectOrderLong or emaPerfectOrderShort
bool emaPerfectOrderAnyPrev = emaPerfectOrderAny[1]
bool emaPerfectOrderBreak   = emaPerfectOrderAnyPrev and not emaPerfectOrderAny
bool emaStateEndingLong  = emaStateActive and (emaSpreadShrinkStrong or (emaPerfectOrderLong[1] and not emaPerfectOrderLong)) and aboveEMABand
bool emaStateEndingShort = emaStateActive and (emaSpreadShrinkStrong or (emaPerfectOrderShort[1] and not emaPerfectOrderShort)) and belowEMABand
bool emaStateEnding = emaStateEndingLong or emaStateEndingShort

// 数値State (優先: Ending>Hunting>Awakening>Sleeping)
int emaMarketState = not emaStateActive ? 0 :
                      emaStateEnding ? 4 :
                      emaStateHunting ? 3 :
                      emaStateAwakening ? 2 :
                      emaStateSleeping ? 1 : 0
int emaMarketStateDirection = (emaStateAwakeningLong or emaStateHuntingLong or emaStateEndingLong) ? 1 : (emaStateAwakeningShort or emaStateHuntingShort or emaStateEndingShort) ? -1 : 0

// State NoTrade
bool emaNoTradeSleeping = emaStateActive and useEMASleepingNoTrade and emaStateSleeping
bool emaNoTradeEnding   = emaStateActive and useEMAEndingNoTrade   and emaStateEnding

// State Bias (Awakening/Hunting方向、Sleeping/Endingは除外)
bool emaStateBiasLong  = emaStateActive and (emaStateAwakeningLong or emaStateHuntingLong)   and not emaStateSleeping and not emaStateEnding
bool emaStateBiasShort = emaStateActive and (emaStateAwakeningShort or emaStateHuntingShort) and not emaStateSleeping and not emaStateEnding

// ============================================================
//  エントリー結合 (Any / All)
//   対象: 反発 / SRフリップ / クロス / 帯リテスト / 3000Clean
// ============================================================
int emaEnabledCount = (useEMABounce ? 1 : 0) + (useEMASRFlip ? 1 : 0) + (useEMACross ? 1 : 0) + (useEMABandRetest ? 1 : 0) + (useEMA3000CleanTouch ? 1 : 0)
int emaFiredBuy  = (emaBuyBounceSignal ? 1 : 0) + (emaBuySRFlipSignal ? 1 : 0) + (emaBuyCrossSignal ? 1 : 0) + (emaBuyBandRetestSignal ? 1 : 0) + ((ema3000CleanTouch and close > ema5 and ema_bullishReversal) ? 1 : 0)
int emaFiredSell = (emaSellBounceSignal ? 1 : 0) + (emaSellSRFlipSignal ? 1 : 0) + (emaSellCrossSignal ? 1 : 0) + (emaSellBandRetestSignal ? 1 : 0) + ((ema3000CleanTouch and close < ema5 and ema_bearishReversal) ? 1 : 0)
bool emaEntryBuy  = eAct and emaEnabledCount > 0 and (emaEntryMode == "All" ? emaFiredBuy  == emaEnabledCount : emaFiredBuy  >= 1)
bool emaEntrySell = eAct and emaEnabledCount > 0 and (emaEntryMode == "All" ? emaFiredSell == emaEnabledCount : emaFiredSell >= 1)

// ============================================================
//  Bias (方向フィルター用)
// ============================================================
bool emaBiasLong  = eAct and emaBandOkLong  and not emaNoTradeLong  and emaSlopeOkLong  and emaPerfectOrderOkLong
bool emaBiasShort = eAct and emaBandOkShort and not emaNoTradeShort and emaSlopeOkShort and emaPerfectOrderOkShort

// State統合 Bias (既存は維持)
bool emaBiasLongWithState  = emaBiasLong  and (not useEMAMarketState or emaStateBiasLong  or emaMarketState == 0)
bool emaBiasShortWithState = emaBiasShort and (not useEMAMarketState or emaStateBiasShort or emaMarketState == 0)

// ============================================================
//  最終出力
// ============================================================
bool allowLongByEMA  = eAct and emaEntryBuy  and emaBandOkLong  and not emaNoTradeLong  and emaSlopeOkLong  and emaPerfectOrderOkLong
bool allowShortByEMA = eAct and emaEntrySell and emaBandOkShort and not emaNoTradeShort and emaSlopeOkShort and emaPerfectOrderOkShort
bool emaNoTrade = emaNoTradeLong or emaNoTradeShort or emaNoTradeConvergence or emaNoTradeSleeping or emaNoTradeEnding

// State統合 allow (既存は維持 / 統合時にどちらを使うか選べる)
bool allowLongByEMAWithState  = allowLongByEMA  and (not useEMAMarketState or emaStateBiasLong  or emaMarketState == 0) and not emaNoTradeSleeping and not emaNoTradeEnding
bool allowShortByEMAWithState = allowShortByEMA and (not useEMAMarketState or emaStateBiasShort or emaMarketState == 0) and not emaNoTradeSleeping and not emaNoTradeEnding

// ============================================================
//  Signal Type / Direction / Rank
//   type: 1Bounce 2SRFlip 3Cross 4PerfectOrder 5Conv 6Div 7BandRetest 8CleanTouch
//   優先: BandRetest>SRFlip>Bounce>CleanTouch>Cross>PerfectOrder>Div>Conv
// ============================================================
bool ema_anyBandRetest = emaBuyBandRetestSignal or emaSellBandRetestSignal
bool ema_anySRFlip = emaBuySRFlipSignal or emaSellSRFlipSignal
bool ema_anyBounce = emaBuyBounceSignal or emaSellBounceSignal
bool ema_anyCross  = emaBuyCrossSignal or emaSellCrossSignal
bool ema_anyPO     = emaPerfectOrderLong or emaPerfectOrderShort

int emaSignalType = not eAct ? 0 :
                     ema_anyBandRetest ? 7 :
                     ema_anySRFlip ? 2 :
                     ema_anyBounce ? 1 :
                     ema3000CleanTouch ? 8 :
                     ema_anyCross ? 3 :
                     ema_anyPO ? 4 :
                     emaDivergenceSignal ? 6 :
                     emaConvergenceSignal ? 5 :
                     (useEMAMarketState and emaStateEnding) ? 12 :
                     (useEMAMarketState and emaStateHunting) ? 11 :
                     (useEMAMarketState and emaStateAwakening) ? 10 :
                     (useEMAMarketState and emaStateSleeping) ? 9 : 0

int emaDirection = not eAct ? 0 :
                    ema_anyBandRetest ? (emaBuyBandRetestSignal ? 1 : -1) :
                    ema_anySRFlip ? (emaBuySRFlipSignal ? 1 : -1) :
                    ema_anyBounce ? (emaBuyBounceSignal ? 1 : -1) :
                    ema3000CleanTouch ? (close > ema5 ? 1 : -1) :
                    ema_anyCross ? (emaBuyCrossSignal ? 1 : -1) :
                    ema_anyPO ? (emaPerfectOrderLong ? 1 : -1) :
                    (emaDivergenceSignal or emaConvergenceSignal) ? (aboveEMABand ? 1 : belowEMABand ? -1 : 0) : 0

bool ema_slopeAligned = emaSlopeUpCount >= 3 or emaSlopeDownCount >= 3
int emaRank = not eAct ? 0 :
               (ema_anyBandRetest and ema_anyPO and emaDivergenceSignal) ? 10 :
               (ema3000CleanTouch and ema_slopeAligned) ? 9 :
               ema_anyBandRetest ? 8 :
               (ema_anyPO and emaDivergenceSignal) ? 7 :
               ema_anyPO ? 6 :
               ema_anySRFlip ? 5 :
               ema_anyBounce ? 4 :
               ema_anyCross ? 3 :
               ema_slopeAligned ? 2 :
               (aboveEMABand or belowEMABand) ? 1 : 0
// 水平EMA反発は Rank を1段階下げる (方向別)
if emaRank == 4
    if emaDirection == 1 and emaBounceWeakBuy
        emaRank := 3
    if emaDirection == -1 and emaBounceWeakSell
        emaRank := 3
// Market State による Rank 加減
if useEMAMarketState
    if emaStateAwakening
        emaRank := emaRank + 1
    if emaStateHunting
        emaRank := emaRank + 2
    if emaStateEnding and emaRank > 0
        emaRank := emaRank - 1
    emaRank := math.min(emaRank, 12)

// ============================================================
//  表示 : EMA / 帯
// ============================================================
bool ema_show = useEMAModule and showEMA
plot(ema_show ? ema1 : na, "EMA1(200)",  color = ema_show ? color.new(color.yellow, 0)  : na, linewidth = 1)
plot(ema_show ? ema2 : na, "EMA2(600)",  color = ema_show ? color.new(color.orange, 0)  : na, linewidth = 1)
plot(ema_show ? ema3 : na, "EMA3(1000)", color = ema_show ? color.new(color.red, 0)     : na, linewidth = 2)
plot(ema_show ? ema4 : na, "EMA4(2000)", color = ema_show ? color.new(color.purple, 0)  : na, linewidth = 2)
plot(ema_show ? ema5 : na, "EMA5(3000)", color = ema_show ? color.new(color.fuchsia, 0) : na, linewidth = 3)
pTop = plot(ema_show ? emaBandTop : na, "BandTop", color = na)
pBot = plot(ema_show ? emaBandBottom : na, "BandBottom", color = na)
fill(pTop, pBot, color = ema_show ? color.new(color.gray, 90) : na, title = "EMA Band")

// ============================================================
//  表示 : ラベル
// ============================================================
f_mkLabel(isBuy, txt, col) =>
    label.new(bar_index, isBuy ? low : high, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, yloc = isBuy ? yloc.belowbar : yloc.abovebar, size = size.small)

if eAct and showEMALabels
    if emaBuyBounceSignal
        f_mkLabel(true,  "EMA Bounce↑", color.new(color.green, 0))
    if emaSellBounceSignal
        f_mkLabel(false, "EMA Bounce↓", color.new(color.red, 0))
    if emaBuySRFlipSignal
        f_mkLabel(true,  "EMA SR↑", color.new(color.lime, 0))
    if emaSellSRFlipSignal
        f_mkLabel(false, "EMA SR↓", color.new(color.maroon, 0))
    if emaBuyCrossSignal
        f_mkLabel(true,  "EMA Cross↑", color.new(color.teal, 0))
    if emaSellCrossSignal
        f_mkLabel(false, "EMA Cross↓", color.new(color.fuchsia, 0))
    if emaBuyBandRetestSignal
        f_mkLabel(true,  "EMA BRT↑", color.new(color.aqua, 0))
    if emaSellBandRetestSignal
        f_mkLabel(false, "EMA BRT↓", color.new(color.orange, 0))
    if ema3000CleanTouch
        f_mkLabel(close <= ema5, "EMA3000 Clean", color.new(color.blue, 0))
    if emaPerfectOrderLong
        f_mkLabel(true,  "PO↑", color.new(color.green, 30))
    if emaPerfectOrderShort
        f_mkLabel(false, "PO↓", color.new(color.red, 30))
    if emaConvergenceSignal
        f_mkLabel(false, "EMA Conv", color.new(color.gray, 0))
    if emaDivergenceSignal
        f_mkLabel(true,  "EMA Div", color.new(color.blue, 30))

if eAct and showEMAStateLabels
    if emaStateSleeping
        f_mkLabel(false, "EMA Sleep", color.new(color.gray, 20))
    if emaStateAwakeningLong
        f_mkLabel(true,  "EMA Awake↑", color.new(color.green, 0))
    if emaStateAwakeningShort
        f_mkLabel(false, "EMA Awake↓", color.new(color.red, 0))
    if emaStateHuntingLong
        f_mkLabel(true,  "EMA Hunt↑", color.new(color.lime, 0))
    if emaStateHuntingShort
        f_mkLabel(false, "EMA Hunt↓", color.new(color.maroon, 0))
    if emaStateEndingLong
        f_mkLabel(true,  "EMA End↑", color.new(color.orange, 0))
    if emaStateEndingShort
        f_mkLabel(false, "EMA End↓", color.new(color.purple, 0))

// ============================================================
//  表示 : デバッグテーブル
// ============================================================
f_typeStr(t) =>
    t == 1 ? "Bounce" : t == 2 ? "SRFlip" : t == 3 ? "Cross" : t == 4 ? "PerfectOrder" : t == 5 ? "Convergence" : t == 6 ? "Divergence" : t == 7 ? "BandRetest" : t == 8 ? "CleanTouch" : "-"
f_stateStr() =>
    aboveEMABand ? "Above" : insideEMABand ? "Inside" : belowEMABand ? "Below" : "-"
f_marketStateStr(s) =>
    s == 1 ? "Sleep" : s == 2 ? "Awake" : s == 3 ? "Hunt" : s == 4 ? "End" : "None"

var table dbg = table.new(position.top_right, 2, 13, border_width = 1)
if eAct and showEMADebugTable and barstate.islast
    string sDir = emaDirection == 1 ? "BUY" : emaDirection == -1 ? "SELL" : "-"
    table.cell(dbg, 0, 0, "EMA", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dbg, 1, 0, emaNoTrade ? "NoTrade" : (emaDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = emaNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
    table.cell(dbg, 0, 1, "State", text_color = color.white)
    table.cell(dbg, 1, 1, f_stateStr(), text_color = color.white)
    table.cell(dbg, 0, 2, "Signal Type", text_color = color.white)
    table.cell(dbg, 1, 2, f_typeStr(emaSignalType), text_color = color.white)
    table.cell(dbg, 0, 3, "Direction", text_color = color.white)
    table.cell(dbg, 1, 3, sDir, text_color = color.white)
    table.cell(dbg, 0, 4, "Rank / Weak B/S / FlatBlk", text_color = color.white)
    table.cell(dbg, 1, 4, str.tostring(emaRank) + " / " + (emaBounceWeakBuy ? "B" : "-") + (emaBounceWeakSell ? "S" : "-") + " / " + (useEMAFlatBounceBlock ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 5, "Spread ATR", text_color = color.white)
    table.cell(dbg, 1, 5, na(emaSpreadATR) ? "-" : str.tostring(emaSpreadATR, "#.##"), text_color = color.white)
    table.cell(dbg, 0, 6, "Slope U/D/F", text_color = color.white)
    table.cell(dbg, 1, 6, str.tostring(emaSlopeUpCount) + "/" + str.tostring(emaSlopeDownCount) + "/" + str.tostring(emaFlatCount), text_color = color.white)
    table.cell(dbg, 0, 7, "Perfect Order L/S", text_color = color.white)
    table.cell(dbg, 1, 7, (emaPerfectOrderLong ? "Y" : "N") + " / " + (emaPerfectOrderShort ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 8, "Conv / Div", text_color = color.white)
    table.cell(dbg, 1, 8, (emaConvergenceSignal ? "Y" : "N") + " / " + (emaDivergenceSignal ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 9, "3000 Clean / Weak", text_color = color.white)
    table.cell(dbg, 1, 9, (ema3000CleanTouch ? "Y" : "N") + " / " + (ema3000WeakTouch ? "Y" : "N"), text_color = color.white)
    table.cell(dbg, 0, 10, "NoTrade / Bias L/S", text_color = color.white)
    table.cell(dbg, 1, 10, (emaNoTrade ? "Y" : "N") + " | " + (emaBiasLong ? "L" : "-") + (emaBiasShort ? "S" : "-"), text_color = color.white)
    table.cell(dbg, 0, 11, "Allow L/S", text_color = color.white)
    table.cell(dbg, 1, 11, (allowLongByEMA ? "Y" : "N") + " / " + (allowShortByEMA ? "Y" : "N"), text_color = color.white)
    string sStateDir = emaMarketStateDirection == 1 ? "BUY" : emaMarketStateDirection == -1 ? "SELL" : "-"
    table.cell(dbg, 0, 12, "MktState / Dir / SleepEndNT", text_color = color.white)
    table.cell(dbg, 1, 12, f_marketStateStr(emaMarketState) + " / " + sStateDir + " / " + (emaNoTradeSleeping ? "Sl" : "-") + (emaNoTradeEnding ? "En" : "-"), text_color = color.white)

// ============================================================
//  プロット (接続用 : Data Window)
//   ※ ema1-5 / BandTop / BandBottom は上の可視plotで Data Window にも出る
//   ※ plot上限対策: 各EMA傾きは状態値(1/0/-1) 1本に集約
// ============================================================
plot(emaSpread,    "emaSpread",    display = display.data_window)
plot(emaSpreadATR, "emaSpreadATR", display = display.data_window)
plot(aboveEMABand  ? 1 : 0, "aboveEMABand",  display = display.data_window)
plot(belowEMABand  ? 1 : 0, "belowEMABand",  display = display.data_window)
plot(insideEMABand ? 1 : 0, "insideEMABand", display = display.data_window)
// Market State (plot上限のため各EMA SlopeStateと差し替え)
plot(emaMarketState,          "emaMarketState",          display = display.data_window)
plot(emaMarketStateDirection, "emaMarketStateDirection", display = display.data_window)
plot(emaNoTradeSleeping ? 1 : 0, "emaNoTradeSleeping", display = display.data_window)
plot(emaNoTradeEnding   ? 1 : 0, "emaNoTradeEnding",   display = display.data_window)
plot(emaBiasLongWithState  ? 1 : 0, "emaBiasLongWithState",  display = display.data_window)
plot(emaBiasShortWithState ? 1 : 0, "emaBiasShortWithState", display = display.data_window)
plot(allowLongByEMAWithState  ? 1 : 0, "allowLongByEMAWithState",  display = display.data_window)
plot(allowShortByEMAWithState ? 1 : 0, "allowShortByEMAWithState", display = display.data_window)
plot(emaSpreadChangeATR, "emaSpreadChangeATR", display = display.data_window)
plot(emaSlopeUpCount,   "emaSlopeUpCount",   display = display.data_window)
plot(emaSlopeDownCount, "emaSlopeDownCount", display = display.data_window)
plot(emaBuyBounceSignal  ? 1 : 0, "emaBuyBounceSignal",  display = display.data_window)
plot(emaSellBounceSignal ? 1 : 0, "emaSellBounceSignal", display = display.data_window)
plot(emaBuySRFlipSignal  ? 1 : 0, "emaBuySRFlipSignal",  display = display.data_window)
plot(emaSellSRFlipSignal ? 1 : 0, "emaSellSRFlipSignal", display = display.data_window)
plot(emaBuyCrossSignal  ? 1 : 0, "emaBuyCrossSignal",  display = display.data_window)
plot(emaSellCrossSignal ? 1 : 0, "emaSellCrossSignal", display = display.data_window)
plot(emaBuyBandRetestSignal  ? 1 : 0, "emaBuyBandRetestSignal",  display = display.data_window)
plot(emaSellBandRetestSignal ? 1 : 0, "emaSellBandRetestSignal", display = display.data_window)
plot(ema3000CleanTouch ? 1 : 0, "ema3000CleanTouch", display = display.data_window)
plot(emaConvergenceSignal ? 1 : 0, "emaConvergenceSignal", display = display.data_window)
plot(emaDivergenceSignal  ? 1 : 0, "emaDivergenceSignal",  display = display.data_window)
plot(emaPerfectOrderLong  ? 1 : 0, "emaPerfectOrderLong",  display = display.data_window)
plot(emaPerfectOrderShort ? 1 : 0, "emaPerfectOrderShort", display = display.data_window)
plot(emaBounceWeakBuy  ? 1 : 0, "emaBounceWeakBuy",  display = display.data_window)
plot(emaBounceWeakSell ? 1 : 0, "emaBounceWeakSell", display = display.data_window)
plot(emaBuyBounceSignalBase  ? 1 : 0, "emaBuyBounceSignalBase",  display = display.data_window)
plot(emaSellBounceSignalBase ? 1 : 0, "emaSellBounceSignalBase", display = display.data_window)
plot(emaSignalType, "emaSignalType", display = display.data_window)
plot(emaDirection,  "emaDirection",  display = display.data_window)
plot(emaRank,       "emaRank",       display = display.data_window)
plot(emaBiasLong  ? 1 : 0, "emaBiasLong",  display = display.data_window)
plot(emaBiasShort ? 1 : 0, "emaBiasShort", display = display.data_window)
plot(emaNoTrade      ? 1 : 0, "emaNoTrade",      display = display.data_window)
plot(emaNoTradeLong  ? 1 : 0, "emaNoTradeLong",  display = display.data_window)
plot(emaNoTradeShort ? 1 : 0, "emaNoTradeShort", display = display.data_window)
plot(emaNoTradeConvergence ? 1 : 0, "emaNoTradeConvergence", display = display.data_window)
plot(allowLongByEMA  ? 1 : 0, "allowLongByEMA",  display = display.data_window)
plot(allowShortByEMA ? 1 : 0, "allowShortByEMA", display = display.data_window)

// ============================================================
//  シグナル形状
// ============================================================
plotshape(emaBuyBounceSignal,  title = "BUY Bounce",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0),  size = size.tiny)
plotshape(emaSellBounceSignal, title = "SELL Bounce", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),    size = size.tiny)
plotshape(emaBuySRFlipSignal,  title = "BUY SR Flip",  style = shape.diamond, location = location.belowbar, color = color.new(color.lime, 0),    size = size.tiny)
plotshape(emaSellSRFlipSignal, title = "SELL SR Flip", style = shape.diamond, location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(emaBuyCrossSignal,  title = "BUY Cross",  style = shape.cross, location = location.belowbar, color = color.new(color.teal, 0),    size = size.tiny)
plotshape(emaSellCrossSignal, title = "SELL Cross", style = shape.cross, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)
plotshape(emaBuyBandRetestSignal,  title = "BUY Band Retest",  style = shape.flag, location = location.belowbar, color = color.new(color.aqua, 0),   size = size.tiny)
plotshape(emaSellBandRetestSignal, title = "SELL Band Retest", style = shape.flag, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(ema3000CleanTouch, title = "EMA3000 Clean Touch", style = shape.circle, location = location.bottom, color = color.new(color.blue, 0), size = size.tiny)
plotshape(emaPerfectOrderLong,  title = "Perfect Order Long",  style = shape.arrowup,   location = location.bottom, color = color.new(color.green, 0), size = size.tiny)
plotshape(emaPerfectOrderShort, title = "Perfect Order Short", style = shape.arrowdown, location = location.top,    color = color.new(color.red, 0),   size = size.tiny)
plotshape(emaConvergenceSignal, title = "Convergence", style = shape.xcross, location = location.bottom, color = color.new(color.gray, 0),   size = size.tiny)
plotshape(emaDivergenceSignal,  title = "Divergence",  style = shape.square, location = location.top,    color = color.new(color.blue, 0), size = size.tiny)

// ============================================================
//  アラート
// ============================================================
alertcondition(emaBuyBounceSignal,  "EMA BUY Bounce",  "{{ticker}} EMA反発 BUY")
alertcondition(emaSellBounceSignal, "EMA SELL Bounce", "{{ticker}} EMA反発 SELL")
alertcondition(emaBuySRFlipSignal,  "EMA BUY SR Flip",  "{{ticker}} EMAサポレジ転換 BUY")
alertcondition(emaSellSRFlipSignal, "EMA SELL SR Flip", "{{ticker}} EMAサポレジ転換 SELL")
alertcondition(emaBuyCrossSignal,  "EMA BUY Cross",  "{{ticker}} EMAクロス BUY")
alertcondition(emaSellCrossSignal, "EMA SELL Cross", "{{ticker}} EMAクロス SELL")
alertcondition(emaBuyBandRetestSignal,  "EMA BUY Band Retest",  "{{ticker}} EMA帯リテスト BUY")
alertcondition(emaSellBandRetestSignal, "EMA SELL Band Retest", "{{ticker}} EMA帯リテスト SELL")
alertcondition(ema3000CleanTouch, "EMA3000 Clean Touch", "{{ticker}} 3000EMA Clean Touch")
alertcondition(emaPerfectOrderLong,  "EMA Perfect Order Long",  "{{ticker}} パーフェクトオーダー Long")
alertcondition(emaPerfectOrderShort, "EMA Perfect Order Short", "{{ticker}} パーフェクトオーダー Short")
alertcondition(emaConvergenceSignal, "EMA Convergence", "{{ticker}} EMA収束")
alertcondition(emaDivergenceSignal,  "EMA Divergence",  "{{ticker}} EMA発散")
alertcondition(allowLongByEMA,  "Allow Long EMA",  "{{ticker}} EMA ロング許可")
alertcondition(allowShortByEMA, "Allow Short EMA", "{{ticker}} EMA ショート許可")
alertcondition(emaNoTrade, "EMA NoTrade", "{{ticker}} EMA ノートレード")
alertcondition(emaStateSleeping,      "EMA State Sleeping",       "{{ticker}} EMA Market State Sleeping")
alertcondition(emaStateAwakeningLong, "EMA State Awakening Long",  "{{ticker}} EMA Awakening Long")
alertcondition(emaStateAwakeningShort,"EMA State Awakening Short", "{{ticker}} EMA Awakening Short")
alertcondition(emaStateHuntingLong,   "EMA State Hunting Long",    "{{ticker}} EMA Hunting Long")
alertcondition(emaStateHuntingShort,  "EMA State Hunting Short",   "{{ticker}} EMA Hunting Short")
alertcondition(emaStateEndingLong,    "EMA State Ending Long",     "{{ticker}} EMA Ending Long")
alertcondition(emaStateEndingShort,   "EMA State Ending Short",    "{{ticker}} EMA Ending Short")
alertcondition(emaNoTradeSleeping, "EMA NoTrade Sleeping", "{{ticker}} EMA NoTrade Sleeping")
alertcondition(emaNoTradeEnding,   "EMA NoTrade Ending",   "{{ticker}} EMA NoTrade Ending")
alertcondition(allowLongByEMAWithState,  "Allow Long EMA With State",  "{{ticker}} EMA ロング許可(State)")
alertcondition(allowShortByEMAWithState, "Allow Short EMA With State", "{{ticker}} EMA ショート許可(State)")

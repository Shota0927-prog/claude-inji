            bool ct  = mv0 and hT >= bT and lT <= tT
            bool ex  = sup ? hT < bT : lT > tT
            bool rs  = mv0 ? (ct ? true : ex ? false : rs0) : rs0
            bool cf  = ct and (sup ? cT <= bT : cT >= tT)
            bool rc  = mv0 and (sup ? cT >= tT + bbT : cT <= bT - bbT)

// W09 B07-R2 (/20, shared): a completed TSS of Side slot s back to the invalid defaults (Root list head / tail / count, the
// valid flag, the 17 scalars); its Root nodes are freed by the caller. The former inline block of the C2 completed-TSS clear.
tssResetRaw(TouchStartPlanView tv, int s) =>
    array.set(tv.tssRootHeadNodeIndexes, s, SLOT_INVALID)
    array.set(tv.tssRootTailNodeIndexes, s, SLOT_INVALID)
    array.set(tv.tssRootCounts, s, 0)
    array.set(tv.tssValidFlags, s, false)
    array.set(tv.tssCoreIds, s, ID_NONE)
    array.set(tv.tssGenerationIds, s, ID_NONE)
    array.set(tv.tssSides, s, 0)
    array.set(tv.tssRangeBottoms, s, float(na))
    array.set(tv.tssRangeTops, s, float(na))
    array.set(tv.tssCategoryMasks, s, 0)
    array.set(tv.tssHighMasks, s, 0)
    array.set(tv.tssCCounts, s, 0)
    array.set(tv.tssHCounts, s, 0)
    array.set(tv.tssDensities, s, int(na))
    array.set(tv.tssGrades, s, GR_UNAVAILABLE)
    array.set(tv.tssCurrentTouchNos, s, 0)
    array.set(tv.tssApproachSides, s, 0)
    array.set(tv.tssStartSeqs, s, SEQ_UNSET)
    array.set(tv.tssStartTimes, s, int(na))
    array.set(tv.tssDeepestCloses, s, float(na))
    array.set(tv.tssMaxDepthPcts, s, 0.0)

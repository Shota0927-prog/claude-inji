                    array.concat(tv.planFloats, array.from(b, t, math.max(baseLow, b), math.min(baseHigh, t), baseClose, float(na), 0.0))
                array.concat(fli, array.from(sf, sb, (mv ? 1 : 0) + (rs ? 2 : 0) + (at ? 4 : 0) + (cf ? 8 : 0) + (rc ? 16 : 0), mr, (array.get(tv.sideWeakByTouchFlags, sf) ? 1 : 0) + (array.get(tv.sideWeakByDepthFlags, sf) ? 2 : 0), array.get(tv.coreIds, c), array.get(tv.coreGenerationIds, c)))
                array.push(flf, b)
                array.push(flf, t)
        i += 1
    // D3 order: the Episode rows with an Event and the Flip rows with an Attempt / Confirm, canonical
    int a = 0
    int f = 0
    while ok and (a < array.size(ei) or f < array.size(fli))
        bool pa = a < array.size(ei)
        if pa and f < array.size(fli)
            int ia = array.get(ei, a + EP_I_CORE_ID)
            int ifl = array.get(fli, f + 5)
            int ga = array.get(ei, a + EP_I_GENERATION_ID)
            int gf = array.get(fli, f + 6)
            pa := ia < ifl or (ia == ifl and (ga < gf or (ga == gf and array.get(ei, a) % 2 < array.get(fli, f) % 2)))
        if pa
            int fe = array.get(ei, a + EP_I_FLAGS)
            if fe % 16 >= 8 or fe % 32 >= EF_RESET or fe % 2 == 1
                array.push(d3, a)
            a += EP_INT_STRIDE

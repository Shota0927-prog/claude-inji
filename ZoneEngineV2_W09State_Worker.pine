//@version=6
// ============================================================
// ZoneEngineV2_W09State_Worker - W09 State set / price index / canonical extraction primitives
//
// W09 B02 (I16): the base of the event-driven State pass. The per-bar State stages must not scan every Core / Side; they
// take the transition-capable Views from state sets (ActiveTouch: the whole set) and from price-key order indexes, then
// evaluate them in the canonical order. This worker owns no persistent state and never imports the Main library: the
// caller passes references of its own storage (no copy). Primitives only; no Phase / Touch / Weak / Break / Flip /
// Reclaim / Inverse writer and no I27-15 Side state transfer here (later W09 batches).
//
// P1 membership: stateSetUpdate (unordered set, O(1) push / swap-remove, per-slot position) and priceOrderUpdate (order
//    index sorted by (key tick ASC, slot ASC), per-slot position; the tick is round(keyPrice / mintick), computed at the
//    comparison only (D12)). A slot's key must not change while it is indexed (the caller removes, rewrites, re-adds).
// P2 priceOrderRange: every indexed slot whose key tick lies in [loTick, hiTick] (inclusive; na = unbounded side), in
//    index order. Exact: the index is totally ordered by key tick, so the result is the contiguous run between the two
//    lower bounds - no cap, no nearest-N, no distance cutoff (a false negative needs a corrupt index, which fails closed).
// P3 canonicalSideSlots: Side slot candidates (coreSlot * 2 + 0 Support / + 1 Resistance) of any sources -> unique, in
//    the canonical order coreId ASC, generationId ASC, Support, Resistance. Index / set / map storage order never leaks
//    into the evaluation order.
// Every primitive validates what it touches and fails closed: false / -1 and no partial effect (an update that fails
// writes nothing; a failed range append or canonical build leaves out as it was / empty).
//
// W09 B03 (spec 7.2 / 9.1 / A13.4): pure Grade evaluation, no state read or write (no Phase / Grade / TouchCount / Weak
// flag / TouchStartSnapshot writer). The caller picks the target Touch number (Waiting / Armed: UpcomingTouchNo =
// SideTouchCount + 1; ActiveTouch: the Episode's fixed CurrentTouchNo) and the Flip-unconfirmed fact; the cfg values are
// the validated ones (validateCfg), used as given (no clamp, no reorder, no default substitution).
//
// W09 B04 (spec 7.4 / 8.4 / A12 / A13.2): pure Armed distance / Touch Reset distance / next-bar seq, no state read or
// write. Prices compare in ticks (D12, as W07 Inverse): round(price / mintick) each, resetTick = round(touchResetDistance
// / mintick); equality included; the confirmed close only. Reset takes the TouchStartSnapshot range, never the live
// range. A side for which armedDistanceMet is true is that side's approach candidate (no High / Low / candle inference).
// The caller keeps the next-bar rules: a bar that first meets the distance arms from the next seq; a Reset bar or a
// FlipConfirm / InverseConfirm bar starts no normal Touch on the same bar.
//
// W09 B05 (spec 8.1 / 8.2 / 10.2 / 15 / A13.1 / A14.2, I8 Stage D1, I16): Stage D1 target extraction only (no Touch start,
// no GapBreak commit, no state write, no Event). Geometry = the caller's previous-bar (Stage C) Armed range per Side slot
// (rangeBottoms / rangeTops) and its two price-order indexes (bottom order keyed by rangeBottoms, top order keyed by
// rangeTops); ticks = round(price / mintick) (D12). Touch: width Zone bottomTick <= highTick and topTick >= lowTick
// (bottom index (-inf, highTick] intersected with top index [lowTick, +inf)); one-line Zone (bottomTick == topTick) also
// linePriceTick in [lowTick - toleranceTick, highTick + toleranceTick] (the tolerance never widens a width Zone). GapBreak:
// Support bottomTick >= max(highTick + 1, closeTick + breakBufferTick) (bottom index), Resistance topTick <= min(lowTick -
// 1, closeTick - breakBufferTick) (top index). These are the exact predicates, so the target set is exact (no cap, no
// nearest-N). d1TargetSlots keeps previous-bar Armed, eligible, currentSeq >= armedFromSeq Sides and returns them unique in
// the canonical order (canonicalSideSlots).
//
// W09 B06-A (spec 13.1 / 14.1 / 14.2, I27-16): the per-Side Touch / GapBreak predicates of the Stage D1 targets, pure (no
// state read or write). normalTouchMetExact is the touchTargetSlots geometry for one range; gapBreakMetExclusive is the
// gapBreakTargetSlots geometry for one Side, false whenever the normal Touch holds (normal Touch > GapBreak).
// ============================================================
library("ZoneEngineV2_W09State_Worker", overlay = false)

const int SLOT_INVALID = -1
const int ID_NONE      = 0

const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SEQ_UNSET       = -1
const int PH_WAITING      = 0
const int PH_ARMED        = 1
const int PH_ACTIVE_TOUCH = 2
const int PH_BROKEN       = 3
const int PH_FLIP_WAIT    = 4
const int PH_DORMANT      = 5

const int GR_STRONG      = 0
const int GR_NEUTRAL     = 1
const int GR_WEAK        = 2
const int GR_UNAVAILABLE = 3

// W09 H06-B1: bridge View types (array references of the Main storage, no copy; the W08Runtime View pattern). Main builds
// them with <Type>.new(...) directly; no constructor wrapper. Field order is fixed for the H06-B2..B4 wrappers.
// CurrentRootPoolView: Side current Root pool = Side metadata (head / tail / count), node payload (Root ID, next, owner Side
// slot, expected Core / Generation ID, live) and the free stack.
export type CurrentRootPoolView
    array<int>  headNodeIndexes
    array<int>  tailNodeIndexes
    array<int>  counts
    array<int>  rootIds
    array<int>  nextIndexes
    array<int>  ownerSideSlots
    array<int>  expectedCoreIds
    array<int>  expectedGenerationIds
    array<int>  freeIndexes
    array<bool> liveFlags
// TouchSnapshotRootPoolView: TouchStartSnapshot Root pool (W10-owned) = Side metadata, node payload (Root ID, next, owner
// Side slot, expected Core / Generation ID, expected Touch number, live) and the free stack.
export type TouchSnapshotRootPoolView
    array<int>  headNodeIndexes
    array<int>  tailNodeIndexes
    array<int>  counts
    array<int>  rootIds
    array<int>  nextIndexes
    array<int>  ownerSideSlots
    array<int>  expectedCoreIds
    array<int>  expectedGenerationIds
    array<int>  expectedTouchNos
    array<int>  freeIndexes
    array<bool> liveFlags
// PhaseSetView: sidePhases, sidePhaseSetPositions and the six Phase sets (Waiting, Armed, ActiveTouch, Broken, FlipWait,
// Dormant).
export type PhaseSetView
    array<int> sidePhases
    array<int> sidePhaseSetPositions
    array<int> waitingSideSlots
    array<int> armedSideSlots
    array<int> activeTouchSideSlots
    array<int> brokenSideSlots
    array<int> flipWaitSideSlots
    array<int> dormantSideSlots

// P1a: unordered state set. add = true pushes slot (it must not be a member: position == SLOT_INVALID); add = false
// removes a member by swap-remove (the last member takes its position). Returns true when the update was applied.
export stateSetUpdate(array<int> members, array<int> positions, int slot, bool add) =>
    bool ok = slot >= 0 and slot < array.size(positions)
    if ok
        int pos = array.get(positions, slot)
        if add
            ok := pos == SLOT_INVALID
            if ok
                array.set(positions, slot, array.size(members))
                array.push(members, slot)
        else
            ok := pos >= 0 and pos < array.size(members)
            if ok
                ok := array.get(members, pos) == slot
            if ok
                int lastPos  = array.size(members) - 1
                int lastSlot = array.get(members, lastPos)
                if pos != lastPos
                    array.set(members, pos, lastSlot)
                    array.set(positions, lastSlot, pos)
                array.pop(members)
                array.set(positions, slot, SLOT_INVALID)
    ok

// Order index search: the first position whose entry (key tick, slot) is >= (tick, slot) in lexicographic order, with the
// visited entries validated (in range, position back-reference, non-na key). slot = SLOT_INVALID gives the first entry
// with key tick >= tick. Returns [position, ok].
priceOrderSearchRaw(array<int> orderSlots, array<int> positions, array<float> keyPrices, float mintick, int tick, int slot) =>
    bool ok = mintick > 0 and not na(tick)
    int  lo = 0
    int  hi = array.size(orderSlots)
    while ok and lo < hi
        int mid = int(math.floor((lo + hi) / 2))
        int s   = array.get(orderSlots, mid)
        ok := s >= 0 and s < array.size(positions) and s < array.size(keyPrices)
        if ok
            ok := array.get(positions, s) == mid and not na(array.get(keyPrices, s))
        if ok
            int t = int(math.round(array.get(keyPrices, s) / mintick))
            if t < tick or (t == tick and s < slot)
                lo := mid + 1
            else
                hi := mid
    [lo, ok]

// P1b: price-key order index, sorted by (round(keyPrice / mintick) ASC, slot ASC). add = true inserts slot (not indexed,
// non-na key) at its unique ordered position; add = false removes an indexed slot. Shifts use array.set (no
// array.insert / array.remove at 0, no unshift) and keep every moved slot's position. Returns true when applied.
export priceOrderUpdate(array<int> orderSlots, array<int> positions, array<float> keyPrices, float mintick, int slot, bool add) =>
    bool ok = mintick > 0 and slot >= 0 and slot < array.size(positions) and slot < array.size(keyPrices)
    int  n  = array.size(orderSlots)
    if ok and add
        ok := array.get(positions, slot) == SLOT_INVALID and not na(array.get(keyPrices, slot))
        int tick = ok ? int(math.round(array.get(keyPrices, slot) / mintick)) : int(na)
        [insertPos, searchOk] = priceOrderSearchRaw(orderSlots, positions, keyPrices, mintick, tick, slot)
        ok := ok and searchOk
        // neighbours: the left entry is strictly smaller, the right entry strictly larger (slot not already present)
        if ok and insertPos > 0
            int l = array.get(orderSlots, insertPos - 1)
            ok := l >= 0 and l < array.size(positions) and l < array.size(keyPrices)
            if ok
                ok := l != slot and array.get(positions, l) == insertPos - 1 and not na(array.get(keyPrices, l))
            if ok
                int lt = int(math.round(array.get(keyPrices, l) / mintick))
                ok := lt < tick or (lt == tick and l < slot)
        if ok and insertPos < n
            int r = array.get(orderSlots, insertPos)
            ok := r >= 0 and r < array.size(positions) and r < array.size(keyPrices)
            if ok
                ok := r != slot and array.get(positions, r) == insertPos and not na(array.get(keyPrices, r))
            if ok
                int rt = int(math.round(array.get(keyPrices, r) / mintick))
                ok := rt > tick or (rt == tick and r > slot)
        if ok
            array.push(orderSlots, slot)
            int i = n
            while i > insertPos
                int moved = array.get(orderSlots, i - 1)
                array.set(orderSlots, i, moved)
                array.set(positions, moved, i)
                i -= 1
            array.set(orderSlots, insertPos, slot)
            array.set(positions, slot, insertPos)
    else if ok
        int pos = array.get(positions, slot)
        ok := pos >= 0 and pos < n
        if ok
            ok := array.get(orderSlots, pos) == slot
        if ok
            int i = pos
            while i < n - 1
                int moved = array.get(orderSlots, i + 1)
                array.set(orderSlots, i, moved)
                array.set(positions, moved, i)
                i += 1
            array.pop(orderSlots)
            array.set(positions, slot, SLOT_INVALID)
    ok

// P2: append to out every indexed slot whose key tick is in [loTick, hiTick] (inclusive; na loTick / hiTick = unbounded
// on that side), in index order. The run is [search(loTick), search(hiTick + 1)); every entry in it is re-validated.
// Returns the appended count, or -1 (corrupt index / invalid input: out is restored to its size on entry).
export priceOrderRange(array<int> orderSlots, array<int> positions, array<float> keyPrices, float mintick, int loTick, int hiTick, array<int> out) =>
    int  base = array.size(out)
    int  n    = array.size(orderSlots)
    bool ok   = mintick > 0
    int  from = 0
    int  toIdx = n
    if ok and not na(loTick)
        [p, pOk] = priceOrderSearchRaw(orderSlots, positions, keyPrices, mintick, loTick, SLOT_INVALID)
        ok   := pOk
        from := p
    if ok and not na(hiTick)
        [q, qOk] = priceOrderSearchRaw(orderSlots, positions, keyPrices, mintick, hiTick + 1, SLOT_INVALID)
        ok := qOk
        toIdx := q
    int i = from
    while ok and i < toIdx
        int s = array.get(orderSlots, i)
        ok := s >= 0 and s < array.size(positions) and s < array.size(keyPrices)
        if ok
            ok := array.get(positions, s) == i and not na(array.get(keyPrices, s))
        if ok
            int t = int(math.round(array.get(keyPrices, s) / mintick))
            ok := (na(loTick) or t >= loTick) and (na(hiTick) or t <= hiTick)
        if ok
            array.push(out, s)
        i += 1
    if not ok
        while array.size(out) > base
            array.pop(out)
    ok ? array.size(out) - base : -1

// P3: canonical View order of Side slot candidates gathered from any sets / indexes (duplicates allowed). out = the unique
// Side slots, coreId ASC, generationId ASC, Support (slot % 2 == 0) before Resistance. Every candidate must be a live
// Core Side whose coreId maps back to its slot (coreIdToSlot): a live coreId is unique, so (coreId, side) is a total key
// and the generationId level never has to break a tie. Returns true; false (out empty) on any invalid candidate.
export canonicalSideSlots(array<int> candidates, array<int> coreIds, array<int> coreGenerationIds, array<bool> coreSlotLiveFlags, map<int, int> coreIdToSlot, array<int> out) =>
    array.clear(out)
    int  n    = array.size(candidates)
    bool ok   = true
    array<int> keys = array.new_int(n, 0)
    int i = 0
    while ok and i < n
        int s = array.get(candidates, i)
        int c = s >= 0 ? int(math.floor(s / 2)) : SLOT_INVALID
        ok := s >= 0 and c < array.size(coreIds) and c < array.size(coreGenerationIds) and c < array.size(coreSlotLiveFlags)
        if ok
            int id = array.get(coreIds, c)
            ok := array.get(coreSlotLiveFlags, c) and id >= 1 and array.get(coreGenerationIds, c) >= 1 and map.contains(coreIdToSlot, id)
            if ok
                ok := map.get(coreIdToSlot, id) == c
            if ok
                array.set(keys, i, id * 2 + s % 2)
        i += 1
    if ok and n > 0
        array<int> idx = array.sort_indices(keys, order.ascending)
        int lastKey = 0
        int k = 0
        while k < n
            int j   = array.get(idx, k)
            int key = array.get(keys, j)
            // equal keys = the same live (coreId, side) = the same Side slot (coreIdToSlot is one-to-one): dedupe
            if k == 0 or key != lastKey
                array.push(out, array.get(candidates, j))
            lastKey := key
            k += 1
    if not ok
        array.clear(out)
    ok

// B03 P1: the Touch-number Weak condition of the target Touch number. WeakFromTouch OFF: never (WeakByDepth is separate
// and stays in force); else targetTouchNo >= weakFromTouch (equality included).
export weakByTouchNow(int targetTouchNo, int weakFromTouch, bool weakFromTouchOff) =>
    not weakFromTouchOff and targetTouchNo >= weakFromTouch

// B03 P2: the Touch-number Strong window of the target Touch number. StrongUntilTouch Unlimited: always inside (it only
// removes the Touch-number expiry; the Weak step of the Grade order still comes first); else targetTouchNo <=
// strongUntilTouch (equality included).
export strongTouchEligible(int targetTouchNo, int strongUntilTouch, bool strongUnlimited) =>
    strongUnlimited or targetTouchNo <= strongUntilTouch

// B03 P3: the Side View Grade in the fixed order of spec 7.2 / A13.4 (D03 values):
// 1 no valid non-psych Root, or the role is Flip-unconfirmed -> Unavailable
// 2 WeakByDepth, or the target Touch number reached WeakFromTouch -> Weak
// 3 Base Strong and the target Touch number inside StrongUntilTouch -> Strong
// 4 otherwise -> Neutral
// weakByTouch is the caller's Touch-number Weak input (weakByTouchNow of the target Touch number, or the kept WeakByTouch
// fact); Phase is not an input (Phase and Grade are separate).
export gradeExact(bool hasNonPsychRoot, bool flipUnconfirmed, bool weakByDepth, bool weakByTouch, bool baseStrong, bool strongEligible) =>
    int grade = GR_NEUTRAL
    if not hasNonPsychRoot or flipUnconfirmed
        grade := GR_UNAVAILABLE
    else if weakByDepth or weakByTouch
        grade := GR_WEAK
    else if baseStrong and strongEligible
        grade := GR_STRONG
    grade

// B04 P1: the Armed distance of one Side on the confirmed close. Support: closeTick >= topTick + resetTick; Resistance:
// closeTick <= bottomTick - resetTick (equality included). Any other side, na input or mintick <= 0: false.
export armedDistanceMet(int side, float baseClose, float effectiveBottom, float effectiveTop, float touchResetDistance, float mintick) =>
    bool met = false
    if mintick > 0 and not na(baseClose) and not na(touchResetDistance)
        int closeTick = int(math.round(baseClose / mintick))
        int resetTick = int(math.round(touchResetDistance / mintick))
        if side == SIDE_SUPPORT and not na(effectiveTop)
            met := closeTick >= int(math.round(effectiveTop / mintick)) + resetTick
        else if side == SIDE_RESISTANCE and not na(effectiveBottom)
            met := closeTick <= int(math.round(effectiveBottom / mintick)) - resetTick
    met

// B04 P2: the Touch Episode Reset of one Side on the confirmed close, against the TouchStartSnapshot range fixed at the
// Touch start. Support: closeTick >= snapshotTopTick + resetTick; Resistance: closeTick <= snapshotBottomTick -
// resetTick (equality included). Any other side, na input or mintick <= 0: false.
export touchResetMet(int side, float baseClose, float snapshotBottom, float snapshotTop, float touchResetDistance, float mintick) =>
    bool met = false
    if mintick > 0 and not na(baseClose) and not na(touchResetDistance)
        int closeTick = int(math.round(baseClose / mintick))
        int resetTick = int(math.round(touchResetDistance / mintick))
        if side == SIDE_SUPPORT and not na(snapshotTop)
            met := closeTick >= int(math.round(snapshotTop / mintick)) + resetTick
        else if side == SIDE_RESISTANCE and not na(snapshotBottom)
            met := closeTick <= int(math.round(snapshotBottom / mintick)) - resetTick
    met

// B04 P3: the first seq from which a Side that qualifies on the current confirmed bar may start a Touch: currentSeq + 1
// (never the current bar); SEQ_UNSET when it does not qualify now (or currentSeq is not a valid baseSeq). Pure: no
// existing armedFromSeq is read or kept here.
export nextArmedFromSeq(int currentSeq, bool qualifiesNow) =>
    qualifiesNow and not na(currentSeq) and currentSeq >= 0 ? currentSeq + 1 : SEQ_UNSET

// Index membership of a slot (position back-reference). Used to prove the two range indexes hold the same Sides.
indexMemberRaw(array<int> orderSlots, array<int> positions, int slot) =>
    bool member = slot >= 0 and slot < array.size(positions)
    if member
        int pos = array.get(positions, slot)
        member := pos >= 0 and pos < array.size(orderSlots)
        if member
            member := array.get(orderSlots, pos) == slot
    member

// B05 P1: Touch targets of the current bar High / Low against the previous-bar Armed range indexes, appended to out (any
// order, duplicates possible). Width Zone: bottom index (-inf, highTick] intersected with top index [lowTick, +inf).
// One-line Zone: bottom index [lowTick - toleranceTick, highTick + toleranceTick] restricted to bottomTick == topTick.
// Every hit must be in both indexes with non-na keys. Returns the appended count, -1 on invalid input / index (out
// restored to its size on entry).
export touchTargetSlots(array<int> bottomOrder, array<int> bottomPositions, array<int> topOrder, array<int> topPositions, array<float> rangeBottoms, array<float> rangeTops, float mintick, float baseHigh, float baseLow, float touchTolerance, array<int> out) =>
    int  base = array.size(out)
    bool ok   = mintick > 0 and not na(baseHigh) and not na(baseLow) and not na(touchTolerance)
    int  highTick = ok ? int(math.round(baseHigh / mintick)) : int(na)
    int  lowTick  = ok ? int(math.round(baseLow / mintick)) : int(na)
    int  tolTick  = ok ? int(math.round(touchTolerance / mintick)) : int(na)
    ok := ok and lowTick <= highTick and tolTick >= 0
    array<int> byBottom = array.new_int(0)
    array<int> byTop    = array.new_int(0)
    array<int> byLine   = array.new_int(0)
    if ok
        ok := priceOrderRange(bottomOrder, bottomPositions, rangeBottoms, mintick, int(na), highTick, byBottom) >= 0
    if ok
        ok := priceOrderRange(topOrder, topPositions, rangeTops, mintick, lowTick, int(na), byTop) >= 0
    if ok
        ok := priceOrderRange(bottomOrder, bottomPositions, rangeBottoms, mintick, lowTick - tolTick, highTick + tolTick, byLine) >= 0
    map<int, bool> inTop = map.new<int, bool>()
    int i = 0
    while ok and i < array.size(byTop)
        int s = array.get(byTop, i)
        ok := indexMemberRaw(bottomOrder, bottomPositions, s)
        if ok
            map.put(inTop, s, true)
        i += 1
    i := 0
    while ok and i < array.size(byBottom)
        int s = array.get(byBottom, i)
        ok := indexMemberRaw(topOrder, topPositions, s) and s < array.size(rangeTops) and not na(array.get(rangeTops, s))
        if ok and map.contains(inTop, s)
            array.push(out, s)
        i += 1
    i := 0
    while ok and i < array.size(byLine)
        int s = array.get(byLine, i)
        ok := indexMemberRaw(topOrder, topPositions, s) and s < array.size(rangeTops) and not na(array.get(rangeTops, s))
        if ok and int(math.round(array.get(rangeTops, s) / mintick)) == int(math.round(array.get(rangeBottoms, s) / mintick))
            array.push(out, s)
        i += 1
    if not ok
        while array.size(out) > base
            array.pop(out)
    ok ? array.size(out) - base : -1

// B05 P2: GapBreak targets of the current bar, appended to out. Support Sides (slot % 2 == 0) from the bottom index
// [max(highTick + 1, closeTick + breakBufferTick), +inf): a strict full gap below the range and a close at or beyond the
// break level. Resistance Sides (slot % 2 == 1) from the top index (-inf, min(lowTick - 1, closeTick - breakBufferTick)].
// Every hit must be in both indexes with non-na keys. Returns the appended count, -1 on invalid input / index (out
// restored).
export gapBreakTargetSlots(array<int> bottomOrder, array<int> bottomPositions, array<int> topOrder, array<int> topPositions, array<float> rangeBottoms, array<float> rangeTops, float mintick, float baseHigh, float baseLow, float baseClose, float breakBuffer, array<int> out) =>
    int  base = array.size(out)
    bool ok   = mintick > 0 and not na(baseHigh) and not na(baseLow) and not na(baseClose) and not na(breakBuffer)
    int  highTick  = ok ? int(math.round(baseHigh / mintick)) : int(na)
    int  lowTick   = ok ? int(math.round(baseLow / mintick)) : int(na)
    int  closeTick = ok ? int(math.round(baseClose / mintick)) : int(na)
    int  bufTick   = ok ? int(math.round(breakBuffer / mintick)) : int(na)
    ok := ok and lowTick <= highTick and bufTick >= 0
    array<int> sup = array.new_int(0)
    array<int> res = array.new_int(0)
    if ok
        ok := priceOrderRange(bottomOrder, bottomPositions, rangeBottoms, mintick, math.max(highTick + 1, closeTick + bufTick), int(na), sup) >= 0
    if ok
        ok := priceOrderRange(topOrder, topPositions, rangeTops, mintick, int(na), math.min(lowTick - 1, closeTick - bufTick), res) >= 0
    int i = 0
    while ok and i < array.size(sup)
        int s = array.get(sup, i)
        ok := indexMemberRaw(topOrder, topPositions, s) and s < array.size(rangeTops) and not na(array.get(rangeTops, s))
        if ok and s % 2 == 0
            array.push(out, s)
        i += 1
    i := 0
    while ok and i < array.size(res)
        int s = array.get(res, i)
        ok := indexMemberRaw(bottomOrder, bottomPositions, s) and s < array.size(rangeBottoms) and not na(array.get(rangeBottoms, s))
        if ok and s % 2 == 1
            array.push(out, s)
        i += 1
    if not ok
        while array.size(out) > base
            array.pop(out)
    ok ? array.size(out) - base : -1

// B05 P3: the Stage D1 target Sides = P1 union P2, kept only when the previous-bar Phase is Armed, the Side is eligible and
// currentSeq >= armedFromSeq (a Side armed on the current bar is not a target), unique and in the canonical order (coreId,
// generationId, Support, Resistance) through canonicalSideSlots. A dead Core, an Armed Side without armedFromSeq, an invalid
// slot / seq or any P1 / P2 / canonical failure fails the whole call: false, out empty.
export d1TargetSlots(array<int> bottomOrder, array<int> bottomPositions, array<int> topOrder, array<int> topPositions, array<float> rangeBottoms, array<float> rangeTops, float mintick, float baseHigh, float baseLow, float baseClose, float touchTolerance, float breakBuffer, array<int> sidePhases, array<bool> sideEligibleFlags, array<int> sideArmedFromSeqs, int currentSeq, array<int> coreIds, array<int> coreGenerationIds, array<bool> coreSlotLiveFlags, map<int, int> coreIdToSlot, array<int> out) =>
    array.clear(out)
    array<int> raw  = array.new_int(0)
    array<int> kept = array.new_int(0)
    bool ok = not na(currentSeq) and currentSeq >= 0
    if ok
        ok := touchTargetSlots(bottomOrder, bottomPositions, topOrder, topPositions, rangeBottoms, rangeTops, mintick, baseHigh, baseLow, touchTolerance, raw) >= 0
    if ok
        ok := gapBreakTargetSlots(bottomOrder, bottomPositions, topOrder, topPositions, rangeBottoms, rangeTops, mintick, baseHigh, baseLow, baseClose, breakBuffer, raw) >= 0
    int i = 0
    while ok and i < array.size(raw)
        int s = array.get(raw, i)
        int c = int(math.floor(s / 2))
        ok := s < array.size(sidePhases) and s < array.size(sideEligibleFlags) and s < array.size(sideArmedFromSeqs) and c < array.size(coreSlotLiveFlags)
        if ok
            ok := array.get(coreSlotLiveFlags, c)
        if ok and array.get(sidePhases, s) == PH_ARMED
            int fromSeq = array.get(sideArmedFromSeqs, s)
            ok := not na(fromSeq) and fromSeq >= 0
            if ok and array.get(sideEligibleFlags, s) and currentSeq >= fromSeq
                array.push(kept, s)
        i += 1
    if ok
        ok := canonicalSideSlots(kept, coreIds, coreGenerationIds, coreSlotLiveFlags, coreIdToSlot, out)
    if not ok
        array.clear(out)
    ok

// B06-A P1 (spec 13.1, D12): whether the current bar High / Low touches one Side's range, as a pure predicate (the same
// geometry as touchTargetSlots, per Side). Ticks = round(price / mintick). One-line Zone (bottomTick == topTick):
// lowTick - toleranceTick <= lineTick <= highTick + toleranceTick; width Zone: bottomTick <= highTick and topTick >= lowTick
// (the tolerance never widens a width Zone). Equality included. mintick <= 0, any na, lowTick > highTick or a negative
// tolerance: false.
export normalTouchMetExact(float rangeBottom, float rangeTop, float baseHigh, float baseLow, float touchTolerance, float mintick) =>
    bool met = false
    if mintick > 0 and not na(rangeBottom) and not na(rangeTop) and not na(baseHigh) and not na(baseLow) and not na(touchTolerance)
        int bottomTick = int(math.round(rangeBottom / mintick))
        int topTick    = int(math.round(rangeTop / mintick))
        int highTick   = int(math.round(baseHigh / mintick))
        int lowTick    = int(math.round(baseLow / mintick))
        int tolTick    = int(math.round(touchTolerance / mintick))
        if lowTick <= highTick and tolTick >= 0
            met := bottomTick == topTick ? bottomTick >= lowTick - tolTick and bottomTick <= highTick + tolTick : bottomTick <= highTick and topTick >= lowTick
    met

// B06-A P2 (spec 14.1 / 14.2, I27-16, D12): GapBreak of one Side against its BreakReferenceRange, exclusive of the normal
// Touch. Raw: Support highTick < bottomTick (strict full gap) and closeTick <= bottomTick - breakBufferTick; Resistance
// lowTick > topTick and closeTick >= topTick + breakBufferTick (the break close inclusive). A bar for which
// normalTouchMetExact holds (a one-line Zone reached through the tolerance) is a Touch, never a GapBreak, so the two are
// never both true for one Side on one bar. A pure predicate: no TouchCount / WeakDepth / Fresh effect. Any other side,
// mintick <= 0, any na, lowTick > highTick or a negative tolerance / break buffer: false.
export gapBreakMetExclusive(int side, float rangeBottom, float rangeTop, float baseHigh, float baseLow, float baseClose, float touchTolerance, float breakBuffer, float mintick) =>
    bool met = false
    if mintick > 0 and not na(rangeBottom) and not na(rangeTop) and not na(baseHigh) and not na(baseLow) and not na(baseClose) and not na(touchTolerance) and not na(breakBuffer)
        int highTick  = int(math.round(baseHigh / mintick))
        int lowTick   = int(math.round(baseLow / mintick))
        int closeTick = int(math.round(baseClose / mintick))
        int tolTick   = int(math.round(touchTolerance / mintick))
        int bufTick   = int(math.round(breakBuffer / mintick))
        if lowTick <= highTick and tolTick >= 0 and bufTick >= 0
            if side == SIDE_SUPPORT
                int bottomTick = int(math.round(rangeBottom / mintick))
                met := highTick < bottomTick and closeTick <= bottomTick - bufTick
            else if side == SIDE_RESISTANCE
                int topTick = int(math.round(rangeTop / mintick))
                met := lowTick > topTick and closeTick >= topTick + bufTick
            met := met and not normalTouchMetExact(rangeBottom, rangeTop, baseHigh, baseLow, touchTolerance, mintick)
    met

// W09 H01 (B06 size extraction): the Side current Root node raw lifecycle, ported unchanged from the Main
// sideCurrentRootNodeResetRaw / AllocRaw / FreeRaw (commit 83c3ccf) onto array references of that pool only (payload: Root ID,
// next, owner Side slot, expected Core / Generation ID, live; free stack). Private: no export, no call site yet.
// Reset: the row back to the sentinel (ID_NONE, SLOT_INVALID, SLOT_INVALID, ID_NONE, ID_NONE, false) when the six payload arrays
// have one size and nodeIndex is in range; else false, no write. The free stack is not touched.
currentRootNodeResetRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, int nodeIndex) =>
    int  n  = array.size(rootIds)
    bool ok = array.size(nextIndexes) == n and array.size(ownerSideSlots) == n and array.size(expectedCoreIds) == n and array.size(expectedGenerationIds) == n and array.size(liveFlags) == n and nodeIndex >= 0 and nodeIndex < n
    if ok
        array.set(rootIds,               nodeIndex, ID_NONE)
        array.set(nextIndexes,           nodeIndex, SLOT_INVALID)
        array.set(ownerSideSlots,        nodeIndex, SLOT_INVALID)
        array.set(expectedCoreIds,       nodeIndex, ID_NONE)
        array.set(expectedGenerationIds, nodeIndex, ID_NONE)
        array.set(liveFlags,             nodeIndex, false)
    ok
// Alloc: the free-stack top (peeked and proven an in-range dead sentinel row before the pop; it stays sentinel), else one
// sentinel row appended to every payload array. The caller writes the payload. SLOT_INVALID with no write on failure.
currentRootNodeAllocRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, array<int> freeIndexes) =>
    int  n    = array.size(rootIds)
    int  nf   = array.size(freeIndexes)
    int  node = SLOT_INVALID
    bool ok   = array.size(nextIndexes) == n and array.size(ownerSideSlots) == n and array.size(expectedCoreIds) == n and array.size(expectedGenerationIds) == n and array.size(liveFlags) == n
    if ok and nf > 0
        int top = array.get(freeIndexes, nf - 1)
        ok := top >= 0 and top < n
        if ok
            ok := not array.get(liveFlags, top) and array.get(rootIds, top) == ID_NONE and array.get(nextIndexes, top) == SLOT_INVALID and array.get(ownerSideSlots, top) == SLOT_INVALID and array.get(expectedCoreIds, top) == ID_NONE and array.get(expectedGenerationIds, top) == ID_NONE
        if ok
            node := array.pop(freeIndexes)
    else if ok
        node := n
        array.push(rootIds,               ID_NONE)
        array.push(nextIndexes,           SLOT_INVALID)
        array.push(ownerSideSlots,        SLOT_INVALID)
        array.push(expectedCoreIds,       ID_NONE)
        array.push(expectedGenerationIds, ID_NONE)
        array.push(liveFlags,             false)
    node
// Free: a live in-range row not already on the free stack (no double free) -> sentinel reset, then pushed on the free stack.
// List linkage is the caller's. False with no write on failure.
currentRootNodeFreeRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, array<int> freeIndexes, int nodeIndex) =>
    int  n  = array.size(rootIds)
    bool ok = array.size(nextIndexes) == n and array.size(ownerSideSlots) == n and array.size(expectedCoreIds) == n and array.size(expectedGenerationIds) == n and array.size(liveFlags) == n and nodeIndex >= 0 and nodeIndex < n
    if ok
        ok := array.get(liveFlags, nodeIndex)
    int i = 0
    while ok and i < array.size(freeIndexes)
        ok := array.get(freeIndexes, i) != nodeIndex
        i += 1
    if ok
        ok := currentRootNodeResetRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, liveFlags, nodeIndex)
    if ok
        array.push(freeIndexes, nodeIndex)
    ok

// W09 H02 (B06 size extraction): the Side current Root list helpers, ported unchanged from the Main
// sideCurrentRootListValidateRaw / AppendRaw / DetachAllRaw (commit 517f3c1) onto array references: Side metadata (head / tail /
// count per Side slot), the six node payload arrays and the free stack of that pool only. Validate is read only; Append and
// DetachAll are F0 then commit (no false after the first write), keep the given order, no sort / dedupe. Node rows go through
// the H01 currentRootNodeAllocRaw / FreeRaw. Private: no export, no call site yet.
currentRootListValidateRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, int sideSlot, int expectedCoreId, int expectedGenerationId) =>
    int  m  = array.size(headNodeIndexes)
    int  n  = array.size(rootIds)
    bool ok = expectedCoreId != ID_NONE and expectedGenerationId != ID_NONE and array.size(tailNodeIndexes) == m and array.size(counts) == m and sideSlot >= 0 and sideSlot < m and array.size(nextIndexes) == n and array.size(ownerSideSlots) == n and array.size(expectedCoreIds) == n and array.size(expectedGenerationIds) == n and array.size(liveFlags) == n
    if ok
        int head  = array.get(headNodeIndexes, sideSlot)
        int tail  = array.get(tailNodeIndexes, sideSlot)
        int count = array.get(counts, sideSlot)
        if count == 0
            ok := head == SLOT_INVALID and tail == SLOT_INVALID
        else
            ok := count > 0 and count <= n and head >= 0 and head < n and tail >= 0 and tail < n
            int cur  = head
            int last = SLOT_INVALID
            int k    = 0
            while ok and k < count
                ok := cur >= 0 and cur < n
                if ok
                    ok := array.get(liveFlags, cur) and array.get(ownerSideSlots, cur) == sideSlot and array.get(expectedCoreIds, cur) == expectedCoreId and array.get(expectedGenerationIds, cur) == expectedGenerationId and array.get(rootIds, cur) != ID_NONE
                if ok
                    last := cur
                    cur  := array.get(nextIndexes, cur)
                k += 1
            ok := ok and last == tail and cur == SLOT_INVALID
    ok
currentRootListAppendRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, array<int> freeIndexes, int sideSlot, int expectedCoreId, int expectedGenerationId, int rootId) =>
    bool ok = rootId != ID_NONE and currentRootListValidateRaw(headNodeIndexes, tailNodeIndexes, counts, rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, liveFlags, sideSlot, expectedCoreId, expectedGenerationId)
    int  nf = array.size(freeIndexes)
    if ok and nf > 0
        int top = array.get(freeIndexes, nf - 1)
        ok := top >= 0 and top < array.size(rootIds)
        if ok
            ok := not array.get(liveFlags, top) and array.get(rootIds, top) == ID_NONE and array.get(nextIndexes, top) == SLOT_INVALID and array.get(ownerSideSlots, top) == SLOT_INVALID and array.get(expectedCoreIds, top) == ID_NONE and array.get(expectedGenerationIds, top) == ID_NONE
    if ok
        int oldCount = array.get(counts, sideSlot)
        int oldTail  = array.get(tailNodeIndexes, sideSlot)
        int node     = currentRootNodeAllocRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, liveFlags, freeIndexes)
        array.set(rootIds,               node, rootId)
        array.set(nextIndexes,           node, SLOT_INVALID)
        array.set(ownerSideSlots,        node, sideSlot)
        array.set(expectedCoreIds,       node, expectedCoreId)
        array.set(expectedGenerationIds, node, expectedGenerationId)
        array.set(liveFlags,             node, true)
        if oldCount == 0
            array.set(headNodeIndexes, sideSlot, node)
        else
            array.set(nextIndexes, oldTail, node)
        array.set(tailNodeIndexes, sideSlot, node)
        array.set(counts,          sideSlot, oldCount + 1)
    ok
currentRootListDetachAllRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<bool> liveFlags, array<int> freeIndexes, int sideSlot, int expectedCoreId, int expectedGenerationId) =>
    bool ok = currentRootListValidateRaw(headNodeIndexes, tailNodeIndexes, counts, rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, liveFlags, sideSlot, expectedCoreId, expectedGenerationId)
    if ok and array.get(counts, sideSlot) > 0
        int count = array.get(counts, sideSlot)
        map<int, bool> onFree = map.new<int, bool>()
        int i = 0
        while i < array.size(freeIndexes)
            map.put(onFree, array.get(freeIndexes, i), true)
            i += 1
        int cur = array.get(headNodeIndexes, sideSlot)
        int k   = 0
        while ok and k < count
            ok  := not map.contains(onFree, cur)
            cur := array.get(nextIndexes, cur)
            k += 1
        if ok
            cur := array.get(headNodeIndexes, sideSlot)
            k   := 0
            while k < count
                int next = array.get(nextIndexes, cur)
                currentRootNodeFreeRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, liveFlags, freeIndexes, cur)
                cur := next
                k += 1
            array.set(headNodeIndexes, sideSlot, SLOT_INVALID)
            array.set(tailNodeIndexes, sideSlot, SLOT_INVALID)
            array.set(counts,          sideSlot, 0)
    ok

// W09 H03 (B06 size extraction): the TouchStartSnapshot Root node raw lifecycle (W10-owned pool), ported unchanged from the
// Main touchStartSnapshotRootNodeResetRaw / AllocRaw / FreeRaw (commit c178832) onto array references of that pool only
// (payload: Root ID, next, owner Side slot, expected Core / Generation ID, expected Touch number, live; free stack). Same
// contract as Main: Reset writes the sentinel without checks; Alloc pops the free-stack top and resets it, else appends a
// sentinel row; Free resets a live in-range row and pushes it. Never shared with the Side current Root pool. Private: no
// export, no call site yet.
touchSnapshotRootNodeResetRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, int nodeIndex) =>
    array.set(rootIds,               nodeIndex, ID_NONE)
    array.set(nextIndexes,           nodeIndex, SLOT_INVALID)
    array.set(ownerSideSlots,        nodeIndex, SLOT_INVALID)
    array.set(expectedCoreIds,       nodeIndex, ID_NONE)
    array.set(expectedGenerationIds, nodeIndex, ID_NONE)
    array.set(expectedTouchNos,      nodeIndex, 0)
    array.set(liveFlags,             nodeIndex, false)
touchSnapshotRootNodeAllocRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, array<int> freeIndexes) =>
    int nodeIndex = SLOT_INVALID
    if array.size(freeIndexes) > 0
        nodeIndex := array.pop(freeIndexes)
        touchSnapshotRootNodeResetRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, nodeIndex)
    else
        nodeIndex := array.size(rootIds)
        array.push(rootIds,               ID_NONE)
        array.push(nextIndexes,           SLOT_INVALID)
        array.push(ownerSideSlots,        SLOT_INVALID)
        array.push(expectedCoreIds,       ID_NONE)
        array.push(expectedGenerationIds, ID_NONE)
        array.push(expectedTouchNos,      0)
        array.push(liveFlags,             false)
    nodeIndex
touchSnapshotRootNodeFreeRaw(array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, array<int> freeIndexes, int nodeIndex) =>
    bool freed = false
    if nodeIndex >= 0 and nodeIndex < array.size(liveFlags)
        if array.get(liveFlags, nodeIndex)
            touchSnapshotRootNodeResetRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, nodeIndex)
            array.push(freeIndexes, nodeIndex)
            freed := true
    freed

// W09 H04 (B06 size extraction): the TouchStartSnapshot Root list helpers (W10-owned pool), ported unchanged from the Main
// touchStartSnapshotRootListValidateRaw / AppendRaw / DetachAllRaw (commit 6e79a50, after the W10-PRE atomicity fix) onto array
// references: TSS Side metadata (head / tail / count per Side slot), the seven node payload arrays and the free stack of that
// pool only. Owner token = Side slot + Core ID + Generation ID + Touch number. Append / DetachAll are F0 then commit: false only
// from F0, a broken F0 proof is runtime.error. Node rows go through the H03 touchSnapshotRootNodeAllocRaw / FreeRaw. Private:
// no export, no call site yet.
touchSnapshotRootListValidateRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo) =>
    int  n  = array.size(rootIds)
    bool ok = sideSlot >= 0 and sideSlot < array.size(headNodeIndexes) and sideSlot < array.size(tailNodeIndexes) and sideSlot < array.size(counts) and array.size(nextIndexes) == n and array.size(ownerSideSlots) == n and array.size(expectedCoreIds) == n and array.size(expectedGenerationIds) == n and array.size(expectedTouchNos) == n and array.size(liveFlags) == n
    if ok
        int head  = array.get(headNodeIndexes, sideSlot)
        int tail  = array.get(tailNodeIndexes, sideSlot)
        int count = array.get(counts, sideSlot)
        if count == 0
            ok := head == SLOT_INVALID and tail == SLOT_INVALID
        else
            ok := count > 0 and count <= n and head >= 0 and head < n and tail >= 0 and tail < n
            int cur  = head
            int last = SLOT_INVALID
            int k    = 0
            while ok and k < count
                ok := cur >= 0 and cur < n
                if ok
                    ok := array.get(liveFlags, cur) and array.get(ownerSideSlots, cur) == sideSlot and array.get(expectedCoreIds, cur) == expectedCoreId and array.get(expectedGenerationIds, cur) == expectedGenerationId and array.get(expectedTouchNos, cur) == expectedTouchNo and array.get(rootIds, cur) != ID_NONE
                if ok
                    last := cur
                    cur  := array.get(nextIndexes, cur)
                k += 1
            ok := ok and last == tail and cur == SLOT_INVALID
    ok
touchSnapshotRootListAppendRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, array<int> freeIndexes, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo, int rootId) =>
    bool ok = expectedCoreId != ID_NONE and expectedGenerationId != ID_NONE and expectedTouchNo > 0 and rootId != ID_NONE and touchSnapshotRootListValidateRaw(headNodeIndexes, tailNodeIndexes, counts, rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, sideSlot, expectedCoreId, expectedGenerationId, expectedTouchNo)
    int  nf = array.size(freeIndexes)
    if ok and nf > 0
        int top = array.get(freeIndexes, nf - 1)
        ok := top >= 0 and top < array.size(rootIds)
        if ok
            ok := not array.get(liveFlags, top) and array.get(rootIds, top) == ID_NONE and array.get(nextIndexes, top) == SLOT_INVALID and array.get(ownerSideSlots, top) == SLOT_INVALID and array.get(expectedCoreIds, top) == ID_NONE and array.get(expectedGenerationIds, top) == ID_NONE and array.get(expectedTouchNos, top) == 0
    if ok
        int oldCount = array.get(counts, sideSlot)
        int oldTail  = array.get(tailNodeIndexes, sideSlot)
        int node     = touchSnapshotRootNodeAllocRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, freeIndexes)
        if node < 0 or node >= array.size(liveFlags)
            runtime.error("W10-PRE: TSS Root node allocation broke its F0 proof")
        array.set(rootIds,               node, rootId)
        array.set(nextIndexes,           node, SLOT_INVALID)
        array.set(ownerSideSlots,        node, sideSlot)
        array.set(expectedCoreIds,       node, expectedCoreId)
        array.set(expectedGenerationIds, node, expectedGenerationId)
        array.set(expectedTouchNos,      node, expectedTouchNo)
        array.set(liveFlags,             node, true)
        if oldCount == 0
            array.set(headNodeIndexes, sideSlot, node)
        else
            array.set(nextIndexes, oldTail, node)
        array.set(tailNodeIndexes, sideSlot, node)
        array.set(counts,          sideSlot, oldCount + 1)
    ok
touchSnapshotRootListDetachAllRaw(array<int> headNodeIndexes, array<int> tailNodeIndexes, array<int> counts, array<int> rootIds, array<int> nextIndexes, array<int> ownerSideSlots, array<int> expectedCoreIds, array<int> expectedGenerationIds, array<int> expectedTouchNos, array<bool> liveFlags, array<int> freeIndexes, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo) =>
    bool ok = touchSnapshotRootListValidateRaw(headNodeIndexes, tailNodeIndexes, counts, rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, sideSlot, expectedCoreId, expectedGenerationId, expectedTouchNo)
    if ok and array.get(counts, sideSlot) > 0
        int count = array.get(counts, sideSlot)
        int nf    = array.size(freeIndexes)
        int cur   = array.get(headNodeIndexes, sideSlot)
        int k     = 0
        while ok and k < count
            int j = 0
            while ok and j < nf
                ok := array.get(freeIndexes, j) != cur
                j += 1
            cur := array.get(nextIndexes, cur)
            k += 1
        if ok
            cur := array.get(headNodeIndexes, sideSlot)
            k   := 0
            while k < count
                int next = array.get(nextIndexes, cur)
                if not touchSnapshotRootNodeFreeRaw(rootIds, nextIndexes, ownerSideSlots, expectedCoreIds, expectedGenerationIds, expectedTouchNos, liveFlags, freeIndexes, cur)
                    runtime.error("W10-PRE: TSS Root node free broke its F0 proof")
                cur := next
                k += 1
            array.set(headNodeIndexes, sideSlot, SLOT_INVALID)
            array.set(tailNodeIndexes, sideSlot, SLOT_INVALID)
            array.set(counts,          sideSlot, 0)
    ok

// W09 H05 (B06 size extraction): the Phase set membership helpers, ported unchanged from the Main phaseSetMembershipValidRaw /
// phaseSetAddRaw / phaseSetDetachRaw (commit 59e6ec5) onto array references: sidePhases, sidePhaseSetPositions and the six
// Phase sets (Waiting, Armed, ActiveTouch, Broken, FlipWait, Dormant). Membership is read only; Add pushes a non-member at the
// tail of its Phase set; Detach swap-pops a valid member (the moved last Side takes its position). Physical set helpers only:
// no Phase transition here. Private: no export, no call site yet.
phaseMembershipValidRaw(array<int> sidePhases, array<int> sidePhaseSetPositions, array<int> phaseWaitingSideSlots, array<int> phaseArmedSideSlots, array<int> phaseActiveTouchSideSlots, array<int> phaseBrokenSideSlots, array<int> phaseFlipWaitSideSlots, array<int> phaseDormantSideSlots, int sideSlot) =>
    bool valid = false
    if sideSlot >= 0 and sideSlot < array.size(sidePhases) and sideSlot < array.size(sidePhaseSetPositions)
        int phase = array.get(sidePhases,            sideSlot)
        int pos   = array.get(sidePhaseSetPositions, sideSlot)
        if pos >= 0
            if phase == PH_WAITING
                if pos < array.size(phaseWaitingSideSlots)
                    valid := array.get(phaseWaitingSideSlots, pos) == sideSlot
            else if phase == PH_ARMED
                if pos < array.size(phaseArmedSideSlots)
                    valid := array.get(phaseArmedSideSlots, pos) == sideSlot
            else if phase == PH_ACTIVE_TOUCH
                if pos < array.size(phaseActiveTouchSideSlots)
                    valid := array.get(phaseActiveTouchSideSlots, pos) == sideSlot
            else if phase == PH_BROKEN
                if pos < array.size(phaseBrokenSideSlots)
                    valid := array.get(phaseBrokenSideSlots, pos) == sideSlot
            else if phase == PH_FLIP_WAIT
                if pos < array.size(phaseFlipWaitSideSlots)
                    valid := array.get(phaseFlipWaitSideSlots, pos) == sideSlot
            else if phase == PH_DORMANT
                if pos < array.size(phaseDormantSideSlots)
                    valid := array.get(phaseDormantSideSlots, pos) == sideSlot
    valid
phaseAddRaw(array<int> sidePhases, array<int> sidePhaseSetPositions, array<int> phaseWaitingSideSlots, array<int> phaseArmedSideSlots, array<int> phaseActiveTouchSideSlots, array<int> phaseBrokenSideSlots, array<int> phaseFlipWaitSideSlots, array<int> phaseDormantSideSlots, int sideSlot) =>
    bool added = false
    if sideSlot >= 0 and sideSlot < array.size(sidePhases) and sideSlot < array.size(sidePhaseSetPositions)
        int pos = array.get(sidePhaseSetPositions, sideSlot)
        if pos == SLOT_INVALID
            int phase  = array.get(sidePhases, sideSlot)
            int newPos = SLOT_INVALID
            if phase == PH_WAITING
                newPos := array.size(phaseWaitingSideSlots)
                array.push(phaseWaitingSideSlots, sideSlot)
            else if phase == PH_ARMED
                newPos := array.size(phaseArmedSideSlots)
                array.push(phaseArmedSideSlots, sideSlot)
            else if phase == PH_ACTIVE_TOUCH
                newPos := array.size(phaseActiveTouchSideSlots)
                array.push(phaseActiveTouchSideSlots, sideSlot)
            else if phase == PH_BROKEN
                newPos := array.size(phaseBrokenSideSlots)
                array.push(phaseBrokenSideSlots, sideSlot)
            else if phase == PH_FLIP_WAIT
                newPos := array.size(phaseFlipWaitSideSlots)
                array.push(phaseFlipWaitSideSlots, sideSlot)
            else if phase == PH_DORMANT
                newPos := array.size(phaseDormantSideSlots)
                array.push(phaseDormantSideSlots, sideSlot)
            if newPos != SLOT_INVALID
                array.set(sidePhaseSetPositions, sideSlot, newPos)
                added := true
    added
phaseDetachRaw(array<int> sidePhases, array<int> sidePhaseSetPositions, array<int> phaseWaitingSideSlots, array<int> phaseArmedSideSlots, array<int> phaseActiveTouchSideSlots, array<int> phaseBrokenSideSlots, array<int> phaseFlipWaitSideSlots, array<int> phaseDormantSideSlots, int sideSlot) =>
    bool detached = false
    if phaseMembershipValidRaw(sidePhases, sidePhaseSetPositions, phaseWaitingSideSlots, phaseArmedSideSlots, phaseActiveTouchSideSlots, phaseBrokenSideSlots, phaseFlipWaitSideSlots, phaseDormantSideSlots, sideSlot)
        int phase        = array.get(sidePhases,            sideSlot)
        int pos          = array.get(sidePhaseSetPositions, sideSlot)
        int lastPos      = SLOT_INVALID
        int lastSideSlot = SLOT_INVALID
        if phase == PH_WAITING
            lastPos      := array.size(phaseWaitingSideSlots) - 1
            lastSideSlot := array.get(phaseWaitingSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseWaitingSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseWaitingSideSlots)
        else if phase == PH_ARMED
            lastPos      := array.size(phaseArmedSideSlots) - 1
            lastSideSlot := array.get(phaseArmedSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseArmedSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseArmedSideSlots)
        else if phase == PH_ACTIVE_TOUCH
            lastPos      := array.size(phaseActiveTouchSideSlots) - 1
            lastSideSlot := array.get(phaseActiveTouchSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseActiveTouchSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseActiveTouchSideSlots)
        else if phase == PH_BROKEN
            lastPos      := array.size(phaseBrokenSideSlots) - 1
            lastSideSlot := array.get(phaseBrokenSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseBrokenSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseBrokenSideSlots)
        else if phase == PH_FLIP_WAIT
            lastPos      := array.size(phaseFlipWaitSideSlots) - 1
            lastSideSlot := array.get(phaseFlipWaitSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseFlipWaitSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseFlipWaitSideSlots)
        else if phase == PH_DORMANT
            lastPos      := array.size(phaseDormantSideSlots) - 1
            lastSideSlot := array.get(phaseDormantSideSlots, lastPos)
            if pos != lastPos
                array.set(phaseDormantSideSlots, pos, lastSideSlot)
                array.set(sidePhaseSetPositions, lastSideSlot, pos)
            array.pop(phaseDormantSideSlots)
        array.set(sidePhaseSetPositions, sideSlot, SLOT_INVALID)
        detached := true
    detached

// W09 H06-B2: CurrentRoot bridge exports. Each expands the CurrentRootPoolView fields into the private helper's parameter
// order (payload ends with liveFlags; freeIndexes follows it where the helper takes the free stack) and returns that helper's
// result unchanged: one call, no extra check, no extra write. The raw node helpers stay private.
export currentRootListValidate(CurrentRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId) =>
    currentRootListValidateRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.liveFlags, sideSlot, expectedCoreId, expectedGenerationId)
export currentRootListAppend(CurrentRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId, int rootId) =>
    currentRootListAppendRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.liveFlags, view.freeIndexes, sideSlot, expectedCoreId, expectedGenerationId, rootId)
export currentRootListDetachAll(CurrentRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId) =>
    currentRootListDetachAllRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.liveFlags, view.freeIndexes, sideSlot, expectedCoreId, expectedGenerationId)

// W09 H06-B3: TouchStartSnapshot bridge exports. Each expands the TouchSnapshotRootPoolView fields into the private helper's
// parameter order (payload: ..., expectedTouchNos, liveFlags; freeIndexes follows where the helper takes the free stack) and
// returns that helper's result unchanged: one call, no extra check, no extra write. The raw node helpers stay private.
export touchSnapshotRootListValidate(TouchSnapshotRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo) =>
    touchSnapshotRootListValidateRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.expectedTouchNos, view.liveFlags, sideSlot, expectedCoreId, expectedGenerationId, expectedTouchNo)
export touchSnapshotRootListAppend(TouchSnapshotRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo, int rootId) =>
    touchSnapshotRootListAppendRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.expectedTouchNos, view.liveFlags, view.freeIndexes, sideSlot, expectedCoreId, expectedGenerationId, expectedTouchNo, rootId)
export touchSnapshotRootListDetachAll(TouchSnapshotRootPoolView view, int sideSlot, int expectedCoreId, int expectedGenerationId, int expectedTouchNo) =>
    touchSnapshotRootListDetachAllRaw(view.headNodeIndexes, view.tailNodeIndexes, view.counts, view.rootIds, view.nextIndexes, view.ownerSideSlots, view.expectedCoreIds, view.expectedGenerationIds, view.expectedTouchNos, view.liveFlags, view.freeIndexes, sideSlot, expectedCoreId, expectedGenerationId, expectedTouchNo)

// W09 H06-B4: PhaseSet bridge exports. Each expands the PhaseSetView fields into the private helper's parameter order
// (sidePhases, positions, then the Waiting / Armed / ActiveTouch / Broken / FlipWait / Dormant sets) and returns that helper's
// result unchanged: one call, no extra check, no extra write, no Phase transition (sidePhases is never written here).
export phaseMembershipValid(PhaseSetView view, int sideSlot) =>
    phaseMembershipValidRaw(view.sidePhases, view.sidePhaseSetPositions, view.waitingSideSlots, view.armedSideSlots, view.activeTouchSideSlots, view.brokenSideSlots, view.flipWaitSideSlots, view.dormantSideSlots, sideSlot)
export phaseAdd(PhaseSetView view, int sideSlot) =>
    phaseAddRaw(view.sidePhases, view.sidePhaseSetPositions, view.waitingSideSlots, view.armedSideSlots, view.activeTouchSideSlots, view.brokenSideSlots, view.flipWaitSideSlots, view.dormantSideSlots, sideSlot)
export phaseDetach(PhaseSetView view, int sideSlot) =>
    phaseDetachRaw(view.sidePhases, view.sidePhaseSetPositions, view.waitingSideSlots, view.armedSideSlots, view.activeTouchSideSlots, view.brokenSideSlots, view.flipWaitSideSlots, view.dormantSideSlots, sideSlot)

// W09 B06-B2B2 R1 (/11): current structural SideViewState materialization (12 fields) of the applied Candidates' two Sides
// from the same Side winner as the current Root list, moved out of Main (mechanical port of the B06-B2B2 WIP helpers; same
// predicates, same writes). SideViewMaterializeView: flat references of the Main storage (winner rows, the W08 physical
// Candidate winner indexes / materialized Core slots, the pass applyP, the 12 Side destinations); no copy. The W05 constants
// (category mask bounds, density enum) come in as arguments (no second definition here).
export type SideViewMaterializeView
    array<int>   winnerEffectiveBottomTicks
    array<int>   winnerEffectiveTopTicks
    array<float> winnerExactPrices
    array<float> winnerReferencePrices
    array<int>   winnerCCounts
    array<int>   winnerHCounts
    array<int>   winnerDensities
    array<bool>  winnerBaseStrongFlags
    array<int>   winnerCategoryMasks
    array<int>   winnerHighMasks
    array<int>   winnerRootIdOffsets
    array<int>   winnerRootIdLengths
    array<int>   supportWinnerIndexes
    array<int>   resistanceWinnerIndexes
    array<int>   materializedCoreSlots
    array<bool>  applyP
    array<float> sideEffectiveBottoms
    array<float> sideEffectiveTops
    array<float> sideReferencePrices
    array<int>   sideCCounts
    array<int>   sideHCounts
    array<int>   sideDensities
    array<bool>  sideBaseStrongFlags
    array<bool>  sideHasNonPsychRootFlags
    array<bool>  sideIsBroadContextFlags
    array<bool>  sideEligibleFlags
    array<int>   sideCategoryMasks
    array<int>   sideHighMasks
// Read-only preflight, run after the current Root preflight (which proved each applied winner index SLOT_INVALID or a winner
// row of that Side, < winnerLogicalCount): every read winner row is complete - effective ticks / exact floats (round(price /
// mintick) = tick), masks (highMask within categoryMask, C / H their popcounts), density enum, ReferencePrice, a non-empty
// Root slice. A Side without a winner reads nothing.
export sideViewPreflight(SideViewMaterializeView view, int winnerLogicalCount, int winnerRootIdLength, float mintick, int catMaskAll, int catMaskPsych, int denHigh, int denNormal, int denBroadContext) =>
    int  n  = winnerLogicalCount
    bool ok = mintick > 0 and array.size(view.winnerEffectiveBottomTicks) >= n and array.size(view.winnerEffectiveTopTicks) >= n and array.size(view.winnerExactPrices) >= 2 * n and array.size(view.winnerReferencePrices) >= n and array.size(view.winnerCCounts) >= n and array.size(view.winnerHCounts) >= n and array.size(view.winnerDensities) >= n and array.size(view.winnerBaseStrongFlags) >= n and array.size(view.winnerCategoryMasks) >= n and array.size(view.winnerHighMasks) >= n and array.size(view.winnerRootIdOffsets) >= n and array.size(view.winnerRootIdLengths) >= n
    int p = 0
    while ok and p < array.size(view.applyP)
        int k = 0
        while ok and k < 2 and array.get(view.applyP, p)
            int w = array.get(k == 0 ? view.supportWinnerIndexes : view.resistanceWinnerIndexes, p)
            if w >= 0
                int   bt = array.get(view.winnerEffectiveBottomTicks, w)
                int   tt = array.get(view.winnerEffectiveTopTicks, w)
                float xb = array.get(view.winnerExactPrices, 2 * w)
                float xt = array.get(view.winnerExactPrices, 2 * w + 1)
                int   cm = array.get(view.winnerCategoryMasks, w)
                int   hm = array.get(view.winnerHighMasks, w)
                int   d  = array.get(view.winnerDensities, w)
                int   o  = array.get(view.winnerRootIdOffsets, w)
                int   l  = array.get(view.winnerRootIdLengths, w)
                ok := not na(bt) and not na(tt) and bt <= tt and not na(xb) and not na(xt) and xb <= xt and int(math.round(xb / mintick)) == bt and int(math.round(xt / mintick)) == tt and not na(array.get(view.winnerReferencePrices, w)) and cm >= 1 and cm <= catMaskAll and hm >= 0 and hm <= catMaskAll and (d == denHigh or d == denNormal or d == denBroadContext) and not na(o) and not na(l) and o >= 0 and l >= 1 and o + l <= winnerRootIdLength
                int c = 0
                int h = 0
                int b = 1
                while ok and b <= catMaskPsych
                    bool cb = cm % (2 * b) >= b
                    bool hb = hm % (2 * b) >= b
                    ok := cb or not hb
                    c += cb ? 1 : 0
                    h += hb ? 1 : 0
                    b *= 2
                ok := ok and c == array.get(view.winnerCCounts, w) and h == array.get(view.winnerHCounts, w)
            k += 1
        p += 1
    ok
// After commitPass and the current Root producer: each applied Candidate's two Sides on its materialized Core get the
// complete replace of the 12 fields by their Side winner's stored values (no winner: the reset defaults). Copy only, no
// quality recomputation; pending / retained Cores are not applied and keep their values.
export sideViewProduce(SideViewMaterializeView view, int denBroadContext) =>
    int p = 0
    while p < array.size(view.applyP)
        int k = 0
        while k < 2 and array.get(view.applyP, p)
            int  s = array.get(view.materializedCoreSlots, p) * 2 + k
            int  w = array.get(k == 0 ? view.supportWinnerIndexes : view.resistanceWinnerIndexes, p)
            bool v = w >= 0
            int  d = v ? array.get(view.winnerDensities, w) : int(na)
            array.set(view.sideEffectiveBottoms, s, v ? array.get(view.winnerExactPrices, 2 * w) : float(na))
            array.set(view.sideEffectiveTops, s, v ? array.get(view.winnerExactPrices, 2 * w + 1) : float(na))
            array.set(view.sideReferencePrices, s, v ? array.get(view.winnerReferencePrices, w) : float(na))
            array.set(view.sideCCounts, s, v ? array.get(view.winnerCCounts, w) : 0)
            array.set(view.sideHCounts, s, v ? array.get(view.winnerHCounts, w) : 0)
            array.set(view.sideDensities, s, d)
            array.set(view.sideBaseStrongFlags, s, v ? array.get(view.winnerBaseStrongFlags, w) : false)
            array.set(view.sideHasNonPsychRootFlags, s, v ? array.get(view.winnerRootIdLengths, w) > 0 : false)
            array.set(view.sideIsBroadContextFlags, s, v ? d == denBroadContext : false)
            array.set(view.sideEligibleFlags, s, v)
            array.set(view.sideCategoryMasks, s, v ? array.get(view.winnerCategoryMasks, w) : 0)
            array.set(view.sideHighMasks, s, v ? array.get(view.winnerHighMasks, w) : 0)
            k += 1
        p += 1
    true

// W09 B06-B2B3-A (/12): Phase / Armed transfer foundation (spec 7.4 / 12 / 12.1 / 14.1, I8 Stage J, I27-15 §10 / §16 / §20,
// B06-B2B3-PRE decision: 1:1 continuation Armed without the distance -> Waiting, ArmedFromSeq / LastArmedRange kept).
// Transfer class of one applied physical Candidate p (W08 plan metadata only: ownership kind, pass mergeOfP / splitOfP,
// Merge relation survivor / absorbed rows, Split plan source old, consumed READY parents); TX_READY is added when one of its
// source old Cores is a consumed READY pending parent. Non-applied (retained / pending): TX_NONE.
const int TX_NONE               = -1
const int TX_FRESH              = 0
const int TX_CONTINUATION       = 1
const int TX_MERGE_SURVIVOR     = 2
const int TX_MERGE_FRESH        = 3
const int TX_SPLIT_CONTINUATION = 4
const int TX_SPLIT_FRESH        = 5
const int TX_READY              = 8
// PhaseArmedTransferView: flat references of the pass (applyP, mergeOfP, splitOfP, consumedSlots, freeSlots / Core IDs /
// Generation IDs), the W08 plan (ownership kinds, continuation old Core slot / ID / Generation ID, mergeRelations stride 5,
// mergeAbsorbed stride 2, Split plan source old Core slot / ID per splitOfP row), the Core tokens, the Side Phase / Armed /
// structural / BreakSnapshot-valid fields and the two Armed price-order indexes (keys sideLastArmedRangeBottoms / Tops).
export type PhaseArmedTransferView
    array<bool>  applyP
    array<int>   mergeOfP
    array<int>   splitOfP
    array<int>   consumedSlots
    array<int>   freeSlots
    array<int>   freeCoreIds
    array<int>   freeGenerationIds
    array<int>   ownershipKinds
    array<int>   continuationOldCoreSlots
    array<int>   continuationCoreIds
    array<int>   continuationGenerationIds
    array<int>   mergeRelations
    array<int>   mergeAbsorbed
    array<int>   splitSourceOldCoreSlots
    array<int>   splitSourceOldCoreIds
    array<int>   coreIds
    array<int>   coreGenerationIds
    array<bool>  coreSlotLiveFlags
    array<int>   sidePhases
    array<int>   sideArmedFromSeqs
    array<float> sideLastArmedRangeBottoms
    array<float> sideLastArmedRangeTops
    array<float> sideEffectiveBottoms
    array<float> sideEffectiveTops
    array<bool>  sideEligibleFlags
    array<bool>  sideBreakSnapshotValidFlags
    array<int>   armedBottomOrderSideSlots
    array<int>   armedBottomPositions
    array<int>   armedTopOrderSideSlots
    array<int>   armedTopPositions
// Read-only preflight (before the W08 F0 / commit; no persistent write). Every applied p gets exactly one transfer class
// in outClasses (caller scratch, cleared first; emptied again on failure). Checked on every old Core the transaction
// reads: the continuation old of each applied p, Merge survivor / absorbed rows, the Split source old, every freed
// Core: slot live with the expected Core ID (and Generation ID where the plan carries one), both Sides' Phase a canonical
// enum and not ActiveTouch (applied components hold none: W08 PendingTopology), Armed <-> member of both Armed indexes
// (reverse positions checked), Armed -> ArmedFromSeq set, LastArmedRange valid, eligible with a valid EffectiveRange;
// non-Armed -> no index position. Merge / Split sources (I27-15 §10 / §12, BreakSnapshot transfer not implemented yet):
// a Side in Broken / FlipWait or with a valid BreakSnapshot fails the pass (temporary fail-closed).
export phaseArmedTransferPreflight(PhaseArmedTransferView view, float mintick, array<int> outClasses) =>
    array.clear(outClasses)
    int  n  = array.size(view.applyP)
    int  nc = array.size(view.coreIds)
    int  ns = 2 * nc
    bool ok = mintick > 0 and array.size(view.mergeOfP) == n and array.size(view.splitOfP) == n and array.size(view.ownershipKinds) >= n and array.size(view.continuationOldCoreSlots) >= n and array.size(view.continuationCoreIds) >= n and array.size(view.continuationGenerationIds) >= n and array.size(view.freeCoreIds) == array.size(view.freeSlots) and array.size(view.freeGenerationIds) == array.size(view.freeSlots) and array.size(view.splitSourceOldCoreIds) == array.size(view.splitSourceOldCoreSlots) and array.size(view.coreGenerationIds) == nc and array.size(view.coreSlotLiveFlags) == nc and array.size(view.sidePhases) == ns and array.size(view.sideArmedFromSeqs) == ns and array.size(view.sideLastArmedRangeBottoms) == ns and array.size(view.sideLastArmedRangeTops) == ns and array.size(view.sideEffectiveBottoms) == ns and array.size(view.sideEffectiveTops) == ns and array.size(view.sideEligibleFlags) == ns and array.size(view.sideBreakSnapshotValidFlags) == ns and array.size(view.armedBottomPositions) == ns and array.size(view.armedTopPositions) == ns
    // old Cores to check: stride 4 [slot, expected Core ID, expected Generation ID (ID_NONE: not carried), Merge / Split source]
    array<int> chk = array.new_int(0)
    int p = 0
    while ok and p < n
        int cls = TX_NONE
        if array.get(view.applyP, p)
            int  kind  = array.get(view.ownershipKinds, p)
            int  j     = array.get(view.mergeOfP, p)
            int  k     = array.get(view.splitOfP, p)
            bool cont  = kind == 0
            int  os    = cont ? array.get(view.continuationOldCoreSlots, p) : SLOT_INVALID
            bool ready = cont and array.includes(view.consumedSlots, os)
            ok := (kind == 0 or kind == 1) and (j < 0 or k < 0)
            if ok and cont
                array.push(chk, os)
                array.push(chk, array.get(view.continuationCoreIds, p))
                array.push(chk, array.get(view.continuationGenerationIds, p))
                array.push(chk, j >= 0 or k >= 0 ? 1 : 0)
            if ok and j >= 0
                ok := 5 * j + 4 < array.size(view.mergeRelations)
                if ok
                    int off = array.get(view.mergeRelations, 5 * j + 3)
                    int cnt = array.get(view.mergeRelations, 5 * j + 4)
                    ok := array.get(view.mergeRelations, 5 * j) == p and array.get(view.mergeRelations, 5 * j + 1) == os and off >= 0 and cnt >= 1 and 2 * (off + cnt) <= array.size(view.mergeAbsorbed)
                    int a = 0
                    while ok and a < cnt
                        int slot = array.get(view.mergeAbsorbed, 2 * (off + a))
                        array.push(chk, slot)
                        array.push(chk, array.get(view.mergeAbsorbed, 2 * (off + a) + 1))
                        array.push(chk, ID_NONE)
                        array.push(chk, 1)
                        ready := ready or array.includes(view.consumedSlots, slot)
                        a += 1
                cls := cont ? TX_MERGE_SURVIVOR : TX_MERGE_FRESH
            else if ok and k >= 0
                ok := k < array.size(view.splitSourceOldCoreSlots)
                int ps = ok ? array.get(view.splitSourceOldCoreSlots, k) : SLOT_INVALID
                ok := ok and (not cont or ps == os)
                if ok
                    array.push(chk, ps)
                    array.push(chk, array.get(view.splitSourceOldCoreIds, k))
                    array.push(chk, ID_NONE)
                    array.push(chk, 1)
                    ready := ready or array.includes(view.consumedSlots, ps)
                cls := cont ? TX_SPLIT_CONTINUATION : TX_SPLIT_FRESH
            else if ok
                cls := cont ? TX_CONTINUATION : TX_FRESH
            cls += ready ? TX_READY : 0
        array.push(outClasses, cls)
        p += 1
    int i = 0
    while ok and i < array.size(view.freeSlots)
        array.push(chk, array.get(view.freeSlots, i))
        array.push(chk, array.get(view.freeCoreIds, i))
        array.push(chk, array.get(view.freeGenerationIds, i))
        array.push(chk, 0)
        i += 1
    i := 0
    while ok and i < array.size(chk)
        int c   = array.get(chk, i)
        int gen = array.get(chk, i + 2)
        ok := c >= 0 and c < nc
        if ok
            ok := array.get(view.coreSlotLiveFlags, c) and array.get(view.coreIds, c) == array.get(chk, i + 1) and (gen == ID_NONE or array.get(view.coreGenerationIds, c) == gen)
        int k = 0
        while ok and k < 2
            int  s  = 2 * c + k
            int  ph = array.get(view.sidePhases, s)
            bool am = ph == PH_ARMED
            ok := ph >= PH_WAITING and ph <= PH_DORMANT and ph != PH_ACTIVE_TOUCH
            if ok and am
                float lb = array.get(view.sideLastArmedRangeBottoms, s)
                float lt = array.get(view.sideLastArmedRangeTops, s)
                ok := indexMemberRaw(view.armedBottomOrderSideSlots, view.armedBottomPositions, s) and indexMemberRaw(view.armedTopOrderSideSlots, view.armedTopPositions, s) and array.get(view.sideArmedFromSeqs, s) >= 0 and lb <= lt and array.get(view.sideEligibleFlags, s) and array.get(view.sideEffectiveBottoms, s) <= array.get(view.sideEffectiveTops, s)
            else if ok
                ok := array.get(view.armedBottomPositions, s) == SLOT_INVALID and array.get(view.armedTopPositions, s) == SLOT_INVALID
            if ok and array.get(chk, i + 3) == 1
                ok := ph != PH_BROKEN and ph != PH_FLIP_WAIT and not array.get(view.sideBreakSnapshotValidFlags, s)
            k += 1
        i += 4
    if not ok
        array.clear(outClasses)
    ok
// Pre-commit Armed index release (after every preflight passed, before W08Runtime.commitPass): each Armed Side of the
// continuation old Core of every applied p (1:1 / Merge survivor / Split continuation: its key is replaced or re-evaluated
// at Stage J) and of every freed Core (Merge absorbed: coreResetSlotRaw clears positions only) leaves both Armed indexes
// (priceOrderUpdate remove). Index only: Phase, ArmedFromSeq and LastArmedRange are not written; retained / pending (not
// applied, not freed) are not touched. Until Stage J these Armed Sides are outside the indexes. Returns the released Side
// count; a failed remove is a broken preflight (runtime.error).
export phaseArmedIndexRelease(PhaseArmedTransferView view, float mintick) =>
    int n        = array.size(view.applyP)
    int released = 0
    int i = 0
    while i < n + array.size(view.freeSlots)
        int c = i < n ? (array.get(view.applyP, i) and array.get(view.ownershipKinds, i) == 0 ? array.get(view.continuationOldCoreSlots, i) : SLOT_INVALID) : array.get(view.freeSlots, i - n)
        int k = 0
        while c >= 0 and k < 2
            int s = 2 * c + k
            if array.get(view.sidePhases, s) == PH_ARMED
                if not (priceOrderUpdate(view.armedBottomOrderSideSlots, view.armedBottomPositions, view.sideLastArmedRangeBottoms, mintick, s, false) and priceOrderUpdate(view.armedTopOrderSideSlots, view.armedTopPositions, view.sideLastArmedRangeTops, mintick, s, false))
                    runtime.error("W09 B06-B2B3-A: Armed index release broke its preflight")
                released += 1
            k += 1
        i += 1
    released

// W09 B07-R2 (/20): the exact-key TouchMark of an Episode in the ring of Core slot c (C1 / I27-18 key: generationId, side,
// touchNo, baseSeq, time, normal): its physical index, SLOT_INVALID when absent, -2 when not unique. The ring block is
// valid (the caller's proof).
episodeMarkRaw(TouchStartPlanView tv, int c, int cap, int gn, int side, int no, int seq, int t) =>
    int h   = array.get(tv.ringHeads, c)
    int mk  = SLOT_INVALID
    int k   = 0
    while k < array.get(tv.ringCounts, c)
        int x = c * cap + (h + k) % cap
        if array.get(tv.ringGenerationIds, x) == gn and array.get(tv.ringSides, x) == side and array.get(tv.ringTouchNos, x) == no and array.get(tv.ringBaseSeqs, x) == seq and array.get(tv.ringTimes, x) == t and array.get(tv.ringIsNormalFlags, x)
            mk := mk == SLOT_INVALID ? x : -2
        k += 1
    mk
// W09 B07-R2 (/20): ActiveTouch Episode plan of the confirmed bar (spec 8 / 13.2 / 14.1 / 15, I8 D2 / D3), read-only, before
// the W08 plan. Episodes: every previous-bar ActiveTouch Side (A) and every TouchStart plan row of this bar (B, the same-bar
// Episode), each once, canonical order. Authority = the TouchStartSnapshot (A: the TSS; B: the plan row the TouchStart
// apply writes into it), never the live EffectiveRange. A: Phase ActiveTouch, TSS valid and owned (Core / Generation ID,
// side), CurrentTouchNo = the TSS TouchNo > 0, snapshot bottom <= top, TSS Root list valid, ring block valid, the exact-key
// mark unique, or absent with the Side history truncated (never guessed; absent and not truncated fails). B: Phase Armed
// (the TouchStart post-plan preflight proves the rest). Per Episode: wouldBreak (breakWouldMet); measured = not wouldBreak
// and topTick > bottomTick (a line Zone has no depth); depth = clamp((Support top - close | Resistance close - bottom) /
// (top - bottom) * 100, 0, 100); hit = measured and not OFF and depth >= weakDepthPct; DeepestClose (measured: Support min,
// Resistance max, first = close); Episode max = max(TSS max, depth); Side max = max(Side max, Episode max); Reset =
// touchResetMet on the snapshot range. Rows into ei / ef (layout EP_*). false (scratch empty) on any fault.
// W09 B10 (/27): flag 128 = movedAway already on the Local Break bar (close <= bottom - touchResetDistance for Support,
// close >= top + touchResetDistance for Resistance, on the TSS range).
// W09 B08-A (/25): flag 1 is the Local Break (BreakReferenceRange = the TSS range, never the live range): Break > Reset
// (no Reset flag with a Break) and the Episode ends -> projected override FORCE_INACTIVE (A) / NO_OVERRIDE (B).
export episodePlan(TouchStartPlanView tv, array<int> activeSides, array<float> sideMaxDepthPcts, array<bool> truncatedFlags, int cap, float baseClose, float mintick, float breakBuffer, float touchResetDistance, float weakDepthPct, bool weakDepthOff, array<int> ei, array<float> ef) =>
    array.clear(ei)
    array.clear(ef)
    int nc = array.size(tv.coreIds)
    array<int> cand = array.copy(activeSides)
    array.concat(cand, tv.planSideSlots)
    array<int> rows = array.new_int(0)
    bool ok = mintick > 0 and not na(baseClose) and cap >= 0 and array.size(sideMaxDepthPcts) == 2 * nc and array.size(truncatedFlags) == 2 * nc and canonicalSideSlots(cand, tv.coreIds, tv.coreGenerationIds, tv.coreSlotLiveFlags, tv.coreIdToSlot, rows)
    ok := ok and array.size(rows) == array.size(cand)
    int i = 0
    while ok and i < array.size(rows)
        int   s    = array.get(rows, i)
        int   c    = int(math.floor(s / 2))
        bool  sup  = s % 2 == 0
        int   side = sup ? SIDE_SUPPORT : SIDE_RESISTANCE
        int   id   = array.get(tv.coreIds, c)
        int   gn   = array.get(tv.coreGenerationIds, c)
        int   row  = array.indexof(tv.planSideSlots, s)
        int   r    = PLAN_INT_STRIDE * row
        int   f    = PLAN_FLOAT_STRIDE * row
        bool  isA  = row < 0
        float b    = isA ? array.get(tv.tssRangeBottoms, s) : array.get(tv.planFloats, f + PLAN_F_RANGE_BOTTOM)
        float t    = isA ? array.get(tv.tssRangeTops, s) : array.get(tv.planFloats, f + PLAN_F_RANGE_TOP)
        int   no   = isA ? array.get(tv.tssCurrentTouchNos, s) : array.get(tv.planInts, r + PLAN_I_TOUCH_NO)
        float d0   = isA ? array.get(tv.tssDeepestCloses, s) : float(na)
        float m0   = isA ? array.get(tv.tssMaxDepthPcts, s) : 0.0
        bool  mw   = false
        int   mk   = SLOT_INVALID
        ok := isA ? array.get(tv.sidePhases, s) == PH_ACTIVE_TOUCH and array.get(tv.tssValidFlags, s) and array.get(tv.tssCoreIds, s) == id and array.get(tv.tssGenerationIds, s) == gn and array.get(tv.tssSides, s) == side and no > 0 and array.get(tv.sideCurrentTouchNos, s) == no and b <= t and touchSnapshotRootListValidateRaw(tv.tssRootHeadNodeIndexes, tv.tssRootTailNodeIndexes, tv.tssRootCounts, tv.tssRootNodeRootIds, tv.tssRootNodeNextIndexes, tv.tssRootNodeOwnerSideSlots, tv.tssRootNodeExpectedCoreIds, tv.tssRootNodeExpectedGenerationIds, tv.tssRootNodeExpectedTouchNos, tv.tssRootNodeLiveFlags, s, id, gn, no) : array.get(tv.sidePhases, s) == PH_ARMED
        if ok and isA
            int h   = array.get(tv.ringHeads, c)
            int cnt = array.get(tv.ringCounts, c)
            ok := array.get(tv.ringOwnerCoreIds, c) == id and cnt >= 0 and cnt <= cap and h >= 0 and (h < cap or (cap == 0 and h == 0)) and (c + 1) * cap <= math.min(array.size(tv.ringBaseSeqs), array.size(tv.ringTimes), array.size(tv.ringSides), array.size(tv.ringGenerationIds), array.size(tv.ringIsNormalFlags), array.size(tv.ringTouchNos), array.size(tv.ringWeakByDepthFlags), array.size(tv.ringMaxDepthPcts))
            mk := ok ? episodeMarkRaw(tv, c, cap, gn, side, no, array.get(tv.tssStartSeqs, s), array.get(tv.tssStartTimes, s)) : -2
            ok := mk >= 0 or (mk == SLOT_INVALID and array.get(truncatedFlags, s))
            mw := ok and mk >= 0 and array.get(tv.ringWeakByDepthFlags, mk)
        if ok
            bool  brk  = closeBeyondRaw(baseClose, sup ? b : t, breakBuffer, mintick, not sup)
            bool  meas = not brk and int(math.round(t / mintick)) > int(math.round(b / mintick))
            float dp   = meas ? math.max(0.0, math.min(100.0, (sup ? t - baseClose : baseClose - b) / (t - b) * 100.0)) : na
            float mx   = meas ? math.max(m0, dp) : m0
            bool  hit  = meas and not weakDepthOff and dp >= weakDepthPct
            bool  sw0  = array.get(tv.sideWeakByDepthFlags, s)
            bool  wt   = isA ? array.get(tv.sideWeakByTouchFlags, s) : array.get(tv.planInts, r + PLAN_I_WEAK_BY_TOUCH) == 1
            bool  rst  = not brk and closeBeyondRaw(baseClose, sup ? t : b, touchResetDistance, mintick, sup)
            array.concat(ei, array.from(s, no, (brk ? 1 : 0) + (meas ? 2 : 0) + (hit ? 4 : 0) + (hit and not sw0 ? 8 : 0) + (rst ? EF_RESET : 0) + (mw or hit ? 32 : 0) + (sw0 or hit ? 64 : 0) + (brk and closeBeyondRaw(baseClose, sup ? b : t, touchResetDistance, mintick, not sup) ? EP_BREAK_MOVED_AWAY : 0), id, gn, (wt ? 1 : 0) + (sw0 or hit ? 2 : 0), isA ? array.get(tv.tssGrades, s) : array.get(tv.planInts, r + PLAN_I_START_GRADE), row, mk, isA ? (rst or brk ? 2 : 0) : (rst or brk ? 0 : 1)))
            array.concat(ef, array.from(b, t, dp, not meas ? d0 : na(d0) ? baseClose : sup ? math.min(d0, baseClose) : math.max(d0, baseClose), mx, math.max(array.get(sideMaxDepthPcts, s), mx)))
        i += 1
    if not ok
        array.clear(ei)
        array.clear(ef)
    ok
// W09 B10 (/27): Flip facts of the confirmed bar (Stage D3, fact extraction; Stage D4 priority), read-only on the persistent
// state, after the Episode plan and before the W08 plan. Candidates = the Broken PhaseSet (the whole state set), each
// pair (Broken old Side sb, FlipWait Side sf) with the same valid BreakSnapshot on both (oldSide = sb, breakSeq <
// currentSeq: a BS of this bar is never evaluated), canonical by sf. Ticks = round(price / mintick) on the BS range only.
// movedAway (monotonic): sb Support: close <= bottom - resetDistance; Resistance: close >= top + resetDistance. Only a BS
// already movedAway at the bar start is retested: contact = the bar meets the range inclusively (high >= bottom and
// low <= top); full exit to the break side (Support high < bottom, Resistance low > top) clears retestSeen; contact sets
// it. On a contact bar: FlipConfirm = close <= bottom (Support Break; Resistance close >= top); wouldReclaim (fact only,
// B11) = close >= top + breakBuffer (Support Break; Resistance close <= bottom - breakBuffer); FlipAttempt = the first
// contact bar (retestSeen false at the start) with neither. An Attempt / Confirm appends one non-normal TouchMark row to
// the TouchStart plan arrays after the TouchStart rows (side = sf, touchNo 0, contact = the bar / BS range intersection,
// normal 0; the W08 Merge / Split TouchMark plans project it like a TouchStart mark). Rows fli / flf (FL_*); d3 = the D3
// facts (Episode rows with a WeakDepth / Reset / LocalBreak Event and the Flip rows with an Attempt / Confirm) merged in
// the canonical (coreId, generationId, Support, Resistance) order. false (scratch empty, mark rows removed) on any fault.
export flipPlan(TouchStartPlanView tv, array<int> ei, array<int> brokenSides, array<int> fli, array<float> flf, array<int> d3, int currentSeq, int baseCloseTime, float baseHigh, float baseLow, float baseClose, float mintick, float touchResetDistance, float breakBuffer) =>
    array.clear(fli)
    array.clear(flf)
    array.clear(d3)
    int  n0   = array.size(tv.planInts)
    int  nf0  = array.size(tv.planFloats)
    array<int> cand = array.new_int(0)
    array<int> rows = array.new_int(0)
    int  i = 0
    while i < array.size(brokenSides)
        int x = array.get(brokenSides, i)
        array.push(cand, x % 2 == 0 ? x + 1 : x - 1)
        i += 1
    bool ok  = mintick > 0 and not na(baseHigh) and not na(baseLow) and not na(baseClose) and not na(touchResetDistance) and not na(breakBuffer) and canonicalSideSlots(cand, tv.coreIds, tv.coreGenerationIds, tv.coreSlotLiveFlags, tv.coreIdToSlot, rows)
    ok := ok and array.size(rows) == array.size(cand)

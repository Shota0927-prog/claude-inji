// W09 B10 (/27): Flip apply, after the GapBreak apply (every F0 passed), every Flip row of a role 0 / 1 Core (role 2: the
// BS transfer carried the projected state): movedAway / retestSeen on both BS copies; FlipAttempt: the FlipWait Side's
// attempt count + 1; FlipConfirm: Broken / FlipWait index detach, both BS copies and their Root nodes cleared, both Sides
// Waiting (not armed on this bar: noArm), CurrentTouchNo 0, attempt count 0, lastFlipConfirmSeq = currentSeq on the new
// Side. ringOut gets one flag per Flip TouchMark row (plan order; false on a role 2 Core). A failing step broke the plan
// proof: runtime.error.
export flipApply(TouchStartPlanView tv, PhaseArmedTransferView pav, array<int> fli, array<int> roles, array<bool> ringOut, array<int> noArm, int currentSeq, float mintick) =>
    bool ok = true
    int  g  = 0
    while ok and g < array.size(fli)
        int sf = array.get(fli, g)
        int sb = array.get(fli, g + 1)
        int fl = array.get(fli, g + 2)
        int c  = int(math.floor(sf / 2))
        int rl = c < array.size(roles) ? array.get(roles, c) : 0
        if array.get(fli, g + 3) >= 0
            array.push(ringOut, rl < 2)
        if rl < 2
            int k = 0
            while k < 2
                int x = k == 0 ? sf : sb
                array.set(pav.bsMovedAwayFlags, x, fl % 2 == 1)
                array.set(pav.bsRetestSeenFlags, x, fl % 4 >= 2)
                k += 1
            if fl % 8 >= 4
                array.set(pav.flipAttemptCounts, sf, array.get(pav.flipAttemptCounts, sf) + 1)
            if fl % 16 >= 8
                ok := bsIndexRaw(pav, sb, true, false, mintick) and bsIndexRaw(pav, sf, false, false, mintick)
                k := 0
                while ok and k < 2
                    int x  = k == 0 ? sf : sb
                    int nd = array.get(pav.bsRootHeadNodeIndexes, x)
                    int m  = array.get(pav.bsRootCounts, x)
                    while ok and m > 0
                        int nx = ok ? array.get(pav.bsNodeNextIndexes, nd) : SLOT_INVALID
                        ok := bsNodeFreeRaw(pav, nd, x)
                        nd := nx
                        m  -= 1
                    bsClearRaw(pav, x)
                    array.set(tv.sideCurrentTouchNos, x, 0)
                    array.push(noArm, x)
                    k += 1
                ok := ok and phaseMoveRaw(pav, sb, PH_WAITING) and phaseMoveRaw(pav, sf, PH_WAITING)
                array.set(pav.flipAttemptCounts, sf, 0)
                array.set(pav.lastFlipConfirmSeqs, sf, currentSeq)
        g += FL_STRIDE
    if not ok
        runtime.error("W09 B10: Flip apply broke its plan proof")
    ok
// W09 B07-R2 (/20): Episode apply, once, after every F0 passed and after the TouchStart apply and the caller's TouchMark
// append (a B Episode's TSS and mark exist by then). Per ei row, canonical order: the exact-key mark (TSS key) takes the
// Episode weakByDepth / maxDepthPct (absent only when the Side history is truncated: no guess); Side WeakByDepth /
// MaxDepthPct = the planned values (never cleared by a Reset). No Reset: TSS DeepestClose / MaxDepthPct, current Grade =
// gradeExact at the fixed CurrentTouchNo (TouchStartGrade untouched). Reset: the TSS Root list freed and the TSS back to
// the invalid defaults, CurrentTouchNo 0, Phase ActiveTouch -> Waiting through the PhaseSet (TouchCount, Weak flags, Fresh,
// MaxDepth kept; Stage J re-arms it from currentSeq + 1). A failing step broke the plan proof: runtime.error.
// W09 B07-R3B2 (/24): + roles (touchStartPostPlanPreflight). A row on a role 2 Core (Merge / Split old Core or freed; only a
// Reset Episode gets there) writes nothing: its mark is in the W08 plan, its history in the C2 transfer, its Phase in the
// Stage J baseline or the W08 free; its TSS is the C2 completed-TSS clear's, except a TSS C2 did not capture (a freed Core
// outside every relation), still valid here, which is cleared here (after commit and transfer; one owner, no double clear).
// Role 0 / 1 (1:1 continuation: same slot, ring and history): unchanged.
export episodeApply(TouchStartPlanView tv, PhaseArmedTransferView pav, array<int> ei, array<float> ef, int cap, int weakFromTouch, bool weakFromTouchOff, int strongUntilTouch, bool strongUnlimited, array<int> roles, int baseSeq, int baseCloseTime, float mintick) =>
    bool ok = true
    int  i  = 0
    while ok and i < array.size(ei)
        int s  = array.get(ei, i)
        int no = array.get(ei, i + EP_I_TOUCH_NO)
        int fl = array.get(ei, i + EP_I_FLAGS)
        int gn = array.get(ei, i + EP_I_GENERATION_ID)
        int f  = EP_FLOAT_STRIDE * int(i / EP_INT_STRIDE)
        int c  = int(math.floor(s / 2))
        bool top = c < array.size(roles) and array.get(roles, c) == 2
        int mk = top ? SLOT_INVALID : episodeMarkRaw(tv, c, cap, gn, s % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, no, array.get(tv.tssStartSeqs, s), array.get(tv.tssStartTimes, s))
        ok := top or mk >= 0 or (mk == SLOT_INVALID and array.get(pav.sideTouchHistoryTruncatedFlags, s))
        if ok and mk >= 0
            array.set(tv.ringWeakByDepthFlags, mk, fl % 64 >= 32)
            array.set(tv.ringMaxDepthPcts, mk, array.get(ef, f + EP_F_EPISODE_MAX))
        if not top
            array.set(pav.sideWeakByDepthFlags, s, fl % 128 >= 64)
            array.set(pav.sideMaxDepthPcts, s, array.get(ef, f + EP_F_SIDE_MAX))
        bool brk = fl % 2 == 1
        int  so  = s % 2 == 0 ? s + 1 : s - 1
        if brk or fl % 32 >= EF_RESET
            // W09 B08-A (/25): Local Break on a role 0 / 1 Core: the same logical BreakSnapshot on the broken Side and the
            // opposite Side from the TSS (Core / Generation ID, range, the TSS Root copy in order; oldSide = the broken
            // Side, breakSeq / breakTime of the bar, wasGapBreak / movedAway / retestSeen false), written before the TSS
            // clear. Role 2: the BS transfer carried it (bsTransferPlan / Apply). /26: through breakCommitRaw (shared with
            // the GapBreak); an Armed opposite on a role 1 Core was released before commit (no second removal).
            if brk and not top
                ok := breakCommitRaw(tv, pav, s, array.get(tv.tssCoreIds, s), array.get(tv.tssGenerationIds, s), array.get(tv.tssRangeBottoms, s), array.get(tv.tssRangeTops, s), baseSeq, baseCloseTime, fl >= EP_BREAK_MOVED_AWAY ? 2 : 0, c < array.size(roles) and array.get(roles, c) == 1, mintick)
                int k = 0
                while k < 2
                    int x = k == 0 ? s : so
                    int y = array.get(tv.tssRootHeadNodeIndexes, s)
                    int q = 0
                    while q < array.get(tv.tssRootCounts, s)
                        bsRootAppendRaw(pav, x, array.get(tv.tssRootNodeRootIds, y))
                        y := array.get(tv.tssRootNodeNextIndexes, y)
                        q += 1
                    k += 1
            if not top or array.get(tv.tssValidFlags, s)
                int nd = array.get(tv.tssRootHeadNodeIndexes, s)
                int m  = array.get(tv.tssRootCounts, s)
                while ok and m > 0
                    int nx = array.get(tv.tssRootNodeNextIndexes, nd)
                    ok := touchSnapshotRootNodeFreeRaw(tv.tssRootNodeRootIds, tv.tssRootNodeNextIndexes, tv.tssRootNodeOwnerSideSlots, tv.tssRootNodeExpectedCoreIds, tv.tssRootNodeExpectedGenerationIds, tv.tssRootNodeExpectedTouchNos, tv.tssRootNodeLiveFlags, tv.tssRootNodeFreeIndexes, nd)
                    nd := nx
                    m  -= 1
                tssResetRaw(tv, s)
            if not top
                array.set(tv.sideCurrentTouchNos, s, 0)
                if not brk and array.get(pav.sidePhases, s) == PH_ACTIVE_TOUCH
                    ok := ok and phaseMoveRaw(pav, s, PH_WAITING)
        else if top
            ok := false
        else
            array.set(tv.tssDeepestCloses, s, array.get(ef, f + EP_F_DEEPEST))
            array.set(tv.tssMaxDepthPcts, s, array.get(ef, f + EP_F_EPISODE_MAX))
            array.set(pav.sideGrades, s, gradeExact(array.get(pav.sideHasNonPsychRootFlags, s), false, fl % 128 >= 64, array.get(pav.sideWeakByTouchFlags, s) or weakByTouchNow(no, weakFromTouch, weakFromTouchOff), array.get(pav.sideBaseStrongFlags, s), strongTouchEligible(no, strongUntilTouch, strongUnlimited)))
        i += EP_INT_STRIDE
    if not ok
        runtime.error("W09 B07-R2: Episode apply broke its plan proof")
    ok
// After commitPass (after freshTransferApply): the planned history of every transfer target Side (post-commit
// materialized Core slot): SideTouchCount, WeakByTouch, WeakByDepth, MaxDepthPct, LastNormalTouchTime, CurrentTouchNo 0;
// then every captured completed TSS: its Root nodes freed, the 18 scalars and the Root list metadata back to the B01
// defaults. A missing plan or a node that cannot be freed broke the plan proof: runtime.error.
export touchHistoryTransferApply(PhaseArmedTransferView view, TouchStartPlanView tv) =>
    int n = array.size(view.applyP)
    if array.size(view.historyPlan) != 6 * n or array.size(view.historyDepthPlan) != 2 * n or array.size(view.materializedCoreSlots) < n
        runtime.error("W09 B06-B2C-C2: Touch history apply without its plan")
    int i = 0
    while i < 2 * n
        int fl = array.get(view.historyPlan, 3 * i + 2)
        if fl >= 0
            int s = 2 * array.get(view.materializedCoreSlots, int(math.floor(i / 2))) + i % 2
            array.set(view.sideTouchCounts, s, array.get(view.historyPlan, 3 * i))
            array.set(tv.sideLastNormalTouchTimes, s, array.get(view.historyPlan, 3 * i + 1))
            array.set(view.sideWeakByTouchFlags, s, fl % 2 == 1)
            array.set(view.sideWeakByDepthFlags, s, fl >= 2)
            array.set(view.sideMaxDepthPcts, s, array.get(view.historyDepthPlan, i))
            array.set(tv.sideCurrentTouchNos, s, 0)
        i += 1
    bool ok = true
    i := 0
    while ok and i < array.size(view.tssClearPlan)
        int s = array.get(view.tssClearPlan, i)
        int m = array.get(view.tssClearPlan, i + 1)
        int k = 0
        while ok and k < m
            ok := touchSnapshotRootNodeFreeRaw(tv.tssRootNodeRootIds, tv.tssRootNodeNextIndexes, tv.tssRootNodeOwnerSideSlots, tv.tssRootNodeExpectedCoreIds, tv.tssRootNodeExpectedGenerationIds, tv.tssRootNodeExpectedTouchNos, tv.tssRootNodeLiveFlags, tv.tssRootNodeFreeIndexes, array.get(view.tssClearPlan, i + 2 + k))
            k += 1
        tssResetRaw(tv, s)
        i += 2 + m
    if not ok
        runtime.error("W09 B06-B2C-C2: TSS clear broke its plan proof")
    ok
// W09 B10 (/27): the Flip row offset of Core slot c in fli (either Side), -1 when none; flipBitRaw: the projected BS flag
// (bit 1 movedAway / 2 retestSeen of the row) of Side slot s, else the persistent value p (1 / 0).
flipRowRaw(array<int> fli, int c) =>
    int r = -1
    int k = 0
    while r < 0 and k < array.size(fli)
        r := int(math.floor(array.get(fli, k) / 2)) == c ? k : -1
        k += FL_STRIDE
    r
flipBitRaw(array<int> fli, int s, int bit, bool p) =>
    int r = flipRowRaw(fli, int(math.floor(s / 2)))
    r >= 0 ? (array.get(fli, r + 2) % (2 * bit) >= bit ? 1 : 0) : p ? 1 : 0
// W09 B08-A (/25): the BreakSnapshot of Side slot s at the end of this bar's Stage D: the ei row of a Local Break Episode
// on its Core (either Side; the same logical BS on both Sides) -> that row (>= 0); else a valid persistent BS -> -1;
// else -2 (none). W09 B09 (/26): a GapBreak row k on the Core -> -3 - k (the same logical BS on both Sides).
bsSourceRaw(PhaseArmedTransferView v, array<int> ei, array<int> gbi, array<int> fli, int s) =>
    int c = int(math.floor(s / 2))
    int e = SLOT_INVALID
    int k = 0
    while e < 0 and k < 2
        int x = episodeRowRaw(ei, 2 * c + k)
        e := x >= 0 and array.get(ei, x + EP_I_FLAGS) % 2 == 1 ? x : SLOT_INVALID
        k += 1
    k := 0
    while e == SLOT_INVALID and k < array.size(gbi)
        e := int(math.floor(array.get(gbi, k) / 2)) == c ? -3 - int(k / GB_STRIDE) : SLOT_INVALID
        k += GB_STRIDE
    // W09 B10 (/27): a persistent BS consumed by a FlipConfirm of this bar is none (Stage J never revives it)
    bool fc = false
    k := 0
    while e == SLOT_INVALID and not fc and k < array.size(fli)
        fc := int(math.floor(array.get(fli, k) / 2)) == c and array.get(fli, k + 2) % 16 >= 8
        k += FL_STRIDE
    e != SLOT_INVALID ? e : array.get(v.sideBreakSnapshotValidFlags, s) and not fc ? -1 : -2
const int BSP_STRIDE = 12
// W09 B08-A (/25): BreakSnapshot Merge / Split transfer plan (I27-15 as fixed for B08-A), read-only, before the W08 F0,
// after the Touch history plan. Per applied p and Side (row BSP_STRIDE: kind (-1 no write: 1:1 continuation / fresh /
// not applied; 0 no BS; 1 BS), coreId, generationId, oldSide, breakSeq, breakTime, flags (1 wasGapBreak, 2 movedAway,
// 4 retestSeen), Root offset, Root count; floats: range bottom / top; Root IDs in bsRootPlan). Source BS = bsSourceRaw
// (a same-bar Local Break is the new logical BS: TSS / TouchStart plan range and Roots, breakSeq / breakTime of the bar).
// Merge: survivor (when the relation has one) and absorbed, same Side; several -> breakSeq max, breakTime max, then the
// old Core canonical order (coreId, generationId ASC); the whole row is taken. Split: the source's BS goes to every child
// whose Side winner EffectiveRange ticks intersect the BS range ticks inclusively (childTop >= bsBottom and childBottom <=
// bsTop); a split source BS reaching no applied child fails (never dropped). A freed Core outside every relation with a
// BS (persistent or same-bar Break) fails (invariant; W08 frees only explicit Merge absorbed Cores). Release list after
// the rows: every Merge / Split source Side holding a persistent BS (Side slot, node count, nodes; the list proven: live
// nodes owned by the Side, count exact). false (scratch empty) on any fault.
export bsTransferPlan(PhaseArmedTransferView v, TouchStartPlanView tv, SideViewMaterializeView sv, array<int> classes, array<int> ei, array<float> ef, float mintick, int baseSeq, int baseCloseTime, array<int> gbi, array<float> gbf, array<int> gbr, array<int> fli) =>
    array.clear(v.bsPlan)
    array.clear(v.bsPlanFloats)
    array.clear(v.bsRootPlan)
    int  n  = array.size(v.applyP)
    int  nc = array.size(v.coreIds)
    int  nk = array.size(v.splitSourceOldCoreSlots)
    bool ok = mintick > 0 and array.size(classes) == n
    array<int>  hit = array.new_int(ok ? 2 * nk : 0, -1)
    array<int>  src = array.new_int(0)
    array<bool> rel = array.new_bool(ok ? 2 * nc : 0, false)
    int p = 0
    while ok and p < 2 * n
        int  q   = int(math.floor(p / 2))
        int  sd  = p % 2
        int  cls = array.get(classes, q)
        int  b   = cls < 0 ? TX_NONE : cls % TX_READY
        bool mg  = b == TX_MERGE_SURVIVOR or b == TX_MERGE_FRESH
        bool sp  = b == TX_SPLIT_CONTINUATION or b == TX_SPLIT_FRESH
        int  j   = mg ? array.get(v.mergeOfP, q) : sp ? array.get(v.splitOfP, q) : -1
        array.clear(src)
        if mg
            ok := j >= 0 and 5 * j + 4 < array.size(v.mergeRelations)
            if ok and array.get(v.mergeRelations, 5 * j + 2) != ID_NONE
                array.push(src, array.get(v.mergeRelations, 5 * j + 1))
            int a = 0
            while ok and a < array.get(v.mergeRelations, 5 * j + 4)
                int off = array.get(v.mergeRelations, 5 * j + 3)
                ok := off >= 0 and 2 * (off + a) < array.size(v.mergeAbsorbed)
                if ok
                    array.push(src, array.get(v.mergeAbsorbed, 2 * (off + a)))
                a += 1
        else if sp
            ok := j >= 0 and j < nk
            if ok
                array.push(src, array.get(v.splitSourceOldCoreSlots, j))
                array.set(hit, 2 * j + sd, math.max(0, array.get(hit, 2 * j + sd)))
        int   bse = -2
        int   bss = SLOT_INVALID
        int   bid = ID_NONE
        int   bgn = ID_NONE
        int   bsq = SEQ_UNSET
        int   btm = int(na)
        int   x   = 0
        while ok and x < array.size(src)
            int c  = array.get(src, x)
            ok := c >= 0 and c < nc and array.get(v.coreSlotLiveFlags, c)
            int ss = 2 * c + sd
            int e  = ok ? bsSourceRaw(v, ei, gbi, fli, ss) : -2
            if e != -2
                int   f  = e >= 0 ? EP_FLOAT_STRIDE * int(e / EP_INT_STRIDE) : 0
                int   gk = e <= -3 ? -3 - e : 0
                int   id = e >= 0 ? array.get(ei, e + EP_I_CORE_ID) : e <= -3 ? array.get(gbi, GB_STRIDE * gk + 1) : array.get(v.bsCoreIds, ss)
                int   gn = e >= 0 ? array.get(ei, e + EP_I_GENERATION_ID) : e <= -3 ? array.get(gbi, GB_STRIDE * gk + 2) : array.get(v.bsGenerationIds, ss)
                int   sq = e != -1 ? baseSeq : array.get(v.bsBreakSeqs, ss)
                int   tm = e != -1 ? baseCloseTime : array.get(v.bsBreakTimes, ss)
                float rb = e >= 0 ? array.get(ef, f) : e <= -3 ? array.get(gbf, 2 * gk) : array.get(v.bsRangeBottoms, ss)
                float rt = e >= 0 ? array.get(ef, f + 1) : e <= -3 ? array.get(gbf, 2 * gk + 1) : array.get(v.bsRangeTops, ss)
                ok := not na(rb) and not na(rt) and rb <= rt and not na(sq) and not na(tm)
                bool take = ok
                if ok and sp
                    int w = array.get(sd == 0 ? sv.supportWinnerIndexes : sv.resistanceWinnerIndexes, q)
                    take := w >= 0 and array.get(sv.winnerEffectiveTopTicks, w) >= int(math.round(rb / mintick)) and array.get(sv.winnerEffectiveBottomTicks, w) <= int(math.round(rt / mintick))
                    if take
                        array.set(hit, 2 * j + sd, array.get(hit, 2 * j + sd) + 1)
                if take and (bse == -2 or sq > bsq or (sq == bsq and (tm > btm or (tm == btm and (id < bid or (id == bid and gn < bgn))))))
                    bse := e
                    bss := ss
                    bid := id
                    bgn := gn
                    bsq := sq
                    btm := tm
            x += 1
        // W09 B10 (/27): the Flip state of the row - attempt count of the chosen persistent source (+1 for its Attempt of
        // this bar), lastFlipConfirmSeq (Merge: max over the same-Side sources, a Confirm of this bar = baseSeq; Split: the
        // continuation keeps the source's, a fresh child gets baseSeq only on the confirmed new Side when its range meets
        // the confirmed BS, else unset), noArm (Merge with a confirmed source; a Split child whose new-Side range meets it)
        int  fa  = 0
        int  ls  = SEQ_UNSET
        bool nar = false
        if ok and (mg or sp)
            x := 0
            while x < array.size(src)
                int  cs  = array.get(src, x)
                int  ss  = 2 * cs + sd
                int  fr  = flipRowRaw(fli, cs)
                bool cfm = fr >= 0 and array.get(fli, fr + 2) % 16 >= 8
                int  sq  = cfm and array.get(fli, fr) == ss ? baseSeq : array.get(v.lastFlipConfirmSeqs, ss)
                if sp and cfm
                    int  so = array.get(fli, fr)
                    int  wn = array.get(so % 2 == 0 ? sv.supportWinnerIndexes : sv.resistanceWinnerIndexes, q)
                    bool hc = wn >= 0 and array.get(sv.winnerEffectiveTopTicks, wn) >= int(math.round(array.get(v.bsRangeBottoms, so) / mintick)) and array.get(sv.winnerEffectiveBottomTicks, wn) <= int(math.round(array.get(v.bsRangeTops, so) / mintick))
                    nar := nar or hc
                    sq  := b == TX_SPLIT_CONTINUATION ? sq : hc and so == ss ? baseSeq : SEQ_UNSET
                else if sp
                    sq  := b == TX_SPLIT_CONTINUATION ? sq : SEQ_UNSET
                nar := nar or (mg and cfm)
                ls  := math.max(ls, sq)
                x += 1
            if bse == -1
                int fr = flipRowRaw(fli, int(math.floor(bss / 2)))
                fa := array.get(v.flipAttemptCounts, bss) + (fr >= 0 and array.get(fli, fr) == bss and array.get(fli, fr + 2) % 8 >= 4 ? 1 : 0)
        // the row: the chosen whole BS (Roots copied by value into bsRootPlan)
        int ro = array.size(v.bsRootPlan)
        if ok and bse != -2
            int f = bse >= 0 ? EP_FLOAT_STRIDE * int(bse / EP_INT_STRIDE) : 0
            if bse <= -3
                // W09 B09 (/26): the same-bar GapBreak BS (LastArmedRange, the Side current Root copy, wasGapBreak)
                int gk = GB_STRIDE * (-3 - bse)
                int y  = 0
                while ok and y < array.get(gbi, gk + 5)
                    ok := array.get(gbi, gk + 4) + y < array.size(gbr)
                    if ok
                        array.push(v.bsRootPlan, array.get(gbr, array.get(gbi, gk + 4) + y))
                    y += 1
                array.concat(v.bsPlan, array.from(1, bid, bgn, array.get(gbi, gk) % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, bsq, btm, 1 + 2 * array.get(gbi, gk + 6), ro, array.size(v.bsRootPlan) - ro, fa, ls, nar ? 1 : 0))
                array.push(v.bsPlanFloats, array.get(gbf, 2 * (-3 - bse)))
                array.push(v.bsPlanFloats, array.get(gbf, 2 * (-3 - bse) + 1))
            else if bse >= 0
                int rw = array.get(ei, bse + EP_I_ROW)
                int bs = array.get(ei, bse)
                if rw >= 0
                    int o = array.get(tv.planInts, PLAN_INT_STRIDE * rw + PLAN_I_ROOT_OFFSET)
                    int y = 0
                    while ok and y < array.get(tv.planInts, PLAN_INT_STRIDE * rw + PLAN_I_ROOT_COUNT)
                        ok := o + y < array.size(tv.planRootIds)
                        if ok
                            array.push(v.bsRootPlan, array.get(tv.planRootIds, o + y))
                        y += 1
                else
                    int nd = array.get(tv.tssRootHeadNodeIndexes, bs)
                    int y  = 0
                    while ok and y < array.get(tv.tssRootCounts, bs)
                        ok := nd >= 0 and nd < array.size(tv.tssRootNodeRootIds) and array.get(tv.tssRootNodeLiveFlags, nd)
                        if ok
                            array.push(v.bsRootPlan, array.get(tv.tssRootNodeRootIds, nd))
                            nd := array.get(tv.tssRootNodeNextIndexes, nd)
                        y += 1
                array.concat(v.bsPlan, array.from(1, bid, bgn, bs % 2 == 0 ? SIDE_SUPPORT : SIDE_RESISTANCE, bsq, btm, array.get(ei, bse + EP_I_FLAGS) >= EP_BREAK_MOVED_AWAY ? 2 : 0, ro, array.size(v.bsRootPlan) - ro, fa, ls, nar ? 1 : 0))
                array.push(v.bsPlanFloats, array.get(ef, f))
                array.push(v.bsPlanFloats, array.get(ef, f + 1))
            else
                int nd = array.get(v.bsRootHeadNodeIndexes, bss)
                int y  = 0
                while ok and y < array.get(v.bsRootCounts, bss)
                    ok := nd >= 0 and nd < array.size(v.bsNodeRootIds) and array.get(v.bsNodeLiveFlags, nd) and array.get(v.bsNodeOwnerSideSlots, nd) == bss
                    if ok
                        array.push(v.bsRootPlan, array.get(v.bsNodeRootIds, nd))
                        nd := array.get(v.bsNodeNextIndexes, nd)
                    y += 1
                array.concat(v.bsPlan, array.from(1, bid, bgn, array.get(v.bsOldSides, bss), bsq, btm, (array.get(v.bsWasGapBreakFlags, bss) ? 1 : 0) + 2 * flipBitRaw(fli, bss, 1, array.get(v.bsMovedAwayFlags, bss)) + 4 * flipBitRaw(fli, bss, 2, array.get(v.bsRetestSeenFlags, bss)), ro, array.size(v.bsRootPlan) - ro, fa, ls, nar ? 1 : 0))
                array.push(v.bsPlanFloats, array.get(v.bsRangeBottoms, bss))
                array.push(v.bsPlanFloats, array.get(v.bsRangeTops, bss))
        else
            array.concat(v.bsPlan, array.from(mg or sp ? 0 : -1, ID_NONE, ID_NONE, SIDE_NONE, SEQ_UNSET, int(na), 0, ro, 0, fa, ls, nar ? 1 : 0))
            array.push(v.bsPlanFloats, float(na))
            array.push(v.bsPlanFloats, float(na))
        // release: the persistent BS of every Merge / Split source Side
        x := 0
        while ok and x < array.size(src)
            array.set(rel, 2 * array.get(src, x) + sd, true)
            x += 1
        p += 1
    // a split source BS (persistent or same-bar) must reach at least one applied child
    int k = 0
    while ok and k < 2 * nk
        ok := array.get(hit, k) != 0 or bsSourceRaw(v, ei, gbi, fli, 2 * array.get(v.splitSourceOldCoreSlots, int(math.floor(k / 2))) + k % 2) == -2
        k += 1
    // a freed Core outside every Merge / Split relation (W08 frees only explicit Merge absorbed Cores) holding a
    // BreakSnapshot or a same-bar Local Break is an invariant failure: F0 fail-closed (no BS drop, no Event)
    int i = 0
    while ok and i < array.size(v.freeSlots)
        int c = array.get(v.freeSlots, i)
        ok := c >= 0 and c < nc
        ok := ok and (array.get(rel, 2 * c) or (bsSourceRaw(v, ei, gbi, fli, 2 * c) == -2 and bsSourceRaw(v, ei, gbi, fli, 2 * c + 1) == -2))
        if ok
            array.set(rel, 2 * c, true)
            array.set(rel, 2 * c + 1, true)
        i += 1
    int s = 0
    while ok and s < 2 * nc
        if array.get(rel, s) and array.get(v.sideBreakSnapshotValidFlags, s)
            int m  = array.get(v.bsRootCounts, s)
            int nd = array.get(v.bsRootHeadNodeIndexes, s)
            array.push(v.bsPlan, s)
            array.push(v.bsPlan, m)
            while ok and m > 0
                ok := nd >= 0 and nd < array.size(v.bsNodeLiveFlags) and array.get(v.bsNodeLiveFlags, nd) and array.get(v.bsNodeOwnerSideSlots, nd) == s
                if ok
                    array.push(v.bsPlan, nd)
                    nd := array.get(v.bsNodeNextIndexes, nd)
                m -= 1
            ok := ok and nd == SLOT_INVALID
        s += 1
    ok := ok and array.size(v.bsNodeRootIds) + array.size(v.bsRootPlan) <= 100000
    if not ok
        array.clear(v.bsPlan)
        array.clear(v.bsPlanFloats)
        array.clear(v.bsRootPlan)
    ok
// W09 B08-A (/25): after commit and the Touch history apply: every released source BS (nodes freed, the Side back to the
// defaults), then every Merge / Split destination Side of the plan (its post-commit materialized Core slot): row kind 1 ->
// the whole BS written with its Root copy, kind 0 -> no BS. Stage J sets the Phase from it. A missing plan or a node
// that cannot be freed broke the plan proof: runtime.error.
export bsTransferApply(PhaseArmedTransferView v, array<int> noArm) =>
    int  n    = array.size(v.applyP)
    int  base = BSP_STRIDE * 2 * n
    bool ok   = array.size(v.bsPlan) >= base and array.size(v.bsPlanFloats) == 4 * n and array.size(v.materializedCoreSlots) >= n
    int  i    = base
    while ok and i < array.size(v.bsPlan)
        int s = array.get(v.bsPlan, i)
        int m = array.get(v.bsPlan, i + 1)
        int q = 0
        while ok and q < m
            ok := bsNodeFreeRaw(v, array.get(v.bsPlan, i + 2 + q), s)
            q += 1
        bsClearRaw(v, s)
        i += 2 + m
    int r = 0
    while ok and r < 2 * n
        int row = BSP_STRIDE * r
        int kd  = array.get(v.bsPlan, row)
        if kd >= 0
            int x = 2 * array.get(v.materializedCoreSlots, int(math.floor(r / 2))) + r % 2
            // W09 B10 (/27): the transferred Flip state; a Side of a destination that took a FlipConfirm of this bar is not
            // armed on this bar
            array.set(v.flipAttemptCounts, x, array.get(v.bsPlan, row + 9))
            array.set(v.lastFlipConfirmSeqs, x, array.get(v.bsPlan, row + 10))
            if array.get(v.bsPlan, row + 11) == 1
                array.push(noArm, x)
            bsClearRaw(v, x)
            if kd == 1
                bsWriteRaw(v, x, array.get(v.bsPlan, row + 1), array.get(v.bsPlan, row + 2), array.get(v.bsPlan, row + 3), array.get(v.bsPlanFloats, 2 * r), array.get(v.bsPlanFloats, 2 * r + 1), array.get(v.bsPlan, row + 4), array.get(v.bsPlan, row + 5), array.get(v.bsPlan, row + 6))
                int q = 0
                while q < array.get(v.bsPlan, row + 8)
                    bsRootAppendRaw(v, x, array.get(v.bsRootPlan, array.get(v.bsPlan, row + 7) + q))
                    q += 1
        r += 1
    if not ok
        runtime.error("W09 B08-A: BreakSnapshot transfer apply broke its plan proof")
    ok

// W09 B09 (/26): GapBreak apply, after the TouchStart apply (before the Episode apply), every GapBreak row of a role 0 / 1
// Core: breakCommitRaw with the row's Core / Generation ID, LastArmedRange, breakSeq / breakTime of the bar, wasGapBreak,
// then the Side current Root copy (previous-confirmed, captured in gbr) on both Sides. No TouchCount / Weak / MaxDepth /
// Fresh / TSS / TouchMark write. Role 2: the BS transfer carried it. A failing step broke the preflight: runtime.error.
export gapBreakApply(TouchStartPlanView tv, PhaseArmedTransferView pav, array<int> gbi, array<float> gbf, array<int> gbr, array<int> roles, int baseSeq, int baseCloseTime, float mintick) =>
    bool ok = true
    int  g  = 0
    while ok and g < array.size(gbi)
        int s  = array.get(gbi, g)
        int c  = int(math.floor(s / 2))
        int rl = c < array.size(roles) ? array.get(roles, c) : 0
        if rl < 2
            int k = 2 * int(g / GB_STRIDE)
            ok := breakCommitRaw(tv, pav, s, array.get(gbi, g + 1), array.get(gbi, g + 2), array.get(gbf, k), array.get(gbf, k + 1), baseSeq, baseCloseTime, 1 + 2 * array.get(gbi, g + 6), rl == 1, mintick)
            int j = 0
            while j < 2
                int q = 0
                while q < array.get(gbi, g + 5)
                    bsRootAppendRaw(pav, j == 0 ? s : (s % 2 == 0 ? s + 1 : s - 1), array.get(gbr, array.get(gbi, g + 4) + q))
                    q += 1
                j += 1
        g += GB_STRIDE
    if not ok
        runtime.error("W09 B09: GapBreak apply broke its preflight proof")
    ok

    int  lT  = ok ? int(math.round(baseLow / mintick)) : 0
    int  cT  = ok ? int(math.round(baseClose / mintick)) : 0
    int  rdT = ok ? int(math.round(touchResetDistance / mintick)) : 0
    int  bbT = ok ? int(math.round(breakBuffer / mintick)) : 0
    i := 0
    while ok and i < array.size(rows)
        int  sf  = array.get(rows, i)
        int  sb  = sf % 2 == 0 ? sf + 1 : sf - 1
        int  c   = int(math.floor(sf / 2))
        bool sup = sb % 2 == 0
        ok := array.get(tv.bValidFlags, sb) and array.get(tv.bValidFlags, sf) and array.get(tv.bOldSides, sb) == (sup ? SIDE_SUPPORT : SIDE_RESISTANCE) and array.get(tv.bOldSides, sf) == array.get(tv.bOldSides, sb) and array.get(tv.sidePhases, sb) == PH_BROKEN and array.get(tv.sidePhases, sf) == PH_FLIP_WAIT
        ok := ok and array.get(tv.bBreakSeqs, sb) < currentSeq and array.get(tv.bBreakSeqs, sf) == array.get(tv.bBreakSeqs, sb) and array.get(tv.bMovedAwayFlags, sf) == array.get(tv.bMovedAwayFlags, sb) and array.get(tv.bRetestSeenFlags, sf) == array.get(tv.bRetestSeenFlags, sb)
        float b  = ok ? array.get(tv.bRangeBottoms, sb) : na
        float t  = ok ? array.get(tv.bRangeTops, sb) : na

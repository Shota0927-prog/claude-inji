// ============================================================
//  Fib 環境認識モジュール (fibEnv)  ─ 追加ブロック集
// ------------------------------------------------------------
//  役割: 既存の Fib WinZone (=エントリー場所判定) とは別。
//        「現在の大きな波に対して、どの程度 押し/戻し が入っているか」を評価する環境認識。
//        Bull Wave / Bear Wave / Neutral の 1状態のみ保持。小さな押し戻しで波を切り替えない。
//  安全: 接頭辞 fibEnv で分離。既存の canLong/canShort・アラート・Fib WinZone には一切接続しない。
//        → 既存バックテストは不変 (別変数として出力するだけ)。
//
//  貼り付け位置 (既存 5min Engulfing Strategy 本体):
//    [A] 入力ブロック  … 「4d. 入力 : フィボ WinZone」の直後 (grpFibState の後)
//    [B] モジュール本体… 「8. 環境フィルタ計算」の直後 (envLongOk/envShortOk の後、8b の前)
//    [C] 表示ブロック  … 「12. 表示」内の末尾 (最後の plot(...) の後)
//  ※ 既存の行は一切変更しない。
// ============================================================


// ============================================================
//  [A] 入力ブロック  (貼り付け位置: 4d フィボ WinZone 入力の直後)
// ============================================================
grpFibEnv = "Fib 環境認識"
useFibEnvModule       = input.bool(true, "Fib環境認識を使う", group = grpFibEnv)
fibEnvAtrLen          = input.int(14, "Fib環境 ATR期間", minval = 1, group = grpFibEnv)
fibEnvSwingLen        = input.int(3,  "Fib環境 スイング検出 左右本数", minval = 1, group = grpFibEnv)
fibEnvMinSwingAtrMult = input.float(3.0, "Fib環境 最低波幅 (ATR倍)", minval = 0.1, step = 0.1, group = grpFibEnv)
// 既存環境スコアへの統合トグル (今回はOFF=接続しない。将来ONにした時だけ接続する構造)
useFibEnvBias         = input.bool(false, "Fib環境を既存環境へ統合 (今回OFF・将来用)", group = grpFibEnv)
// 表示
fibEnvShowTable = input.bool(true,  "Fib環境テーブルを表示", group = grpFibEnv)
fibEnvShowLines = input.bool(false, "Fib環境 起点/終点/リトレース線を表示", group = grpFibEnv)
fibEnvColBull = input.color(color.new(color.green, 0), "Bullカラー",    group = grpFibEnv)
fibEnvColBear = input.color(color.new(color.red,   0), "Bearカラー",    group = grpFibEnv)
fibEnvColNeut = input.color(color.new(color.gray,  0), "Neutralカラー", group = grpFibEnv)


// ============================================================
//  [B] モジュール本体  (貼り付け位置: 8. 環境フィルタ計算 の直後)
// ------------------------------------------------------------
//  Bull/Bear/Neutral を 1状態だけ保持。起点固定・終点のみ更新。
//  無効化は起点の終値突破。波の中の逆行は押し/戻しとして評価する。
//  出力: fibEnvDirection / fibEnvLongScore / fibEnvShortScore / fibEnvRetr
// ============================================================

// Fibリトレース位置 → スコア (境界は下側 >= 上側 < で重複なし)
f_fibEnvScore(float r) =>
    na(r) ? 0 :
     r >= 0.786 ? 0 :
     r >= 0.618 ? 2 :
     r >= 0.500 ? 3 :
     r >= 0.382 ? 2 :
     r >= 0.236 ? 1 : 0

// --- 状態 (var: バー跨ぎで保持) ---
var int   fibEnvState       = 0    // 1=Bull / -1=Bear / 0=Neutral
var float fibEnvOrigin      = na   // 起点 (Bull=固定安値 / Bear=固定高値)
var float fibEnvExtreme     = na   // 終点 (Bull=更新中の最高値 / Bear=最安値)
var int   fibEnvOriginBar   = na
var int   fibEnvExtremeBar  = na
var float fibEnvPendLow     = na   // Bull起点候補 (有意な安値)
var int   fibEnvPendLowBar  = na
var float fibEnvPendHigh    = na   // Bear起点候補 (有意な高値)
var int   fibEnvPendHighBar = na

float fibEnvAtr      = ta.atr(fibEnvAtrLen)
float fibEnvMinSwing = fibEnvAtr * fibEnvMinSwingAtrMult
float fibEnvPH = ta.pivothigh(high, fibEnvSwingLen, fibEnvSwingLen)
float fibEnvPL = ta.pivotlow(low,  fibEnvSwingLen, fibEnvSwingLen)

if useFibEnvModule
    // 1) 有意Pivotを起点候補として更新 (実際のPivot位置 = bar_index - fibEnvSwingLen)
    if not na(fibEnvPL)
        fibEnvPendLow    := fibEnvPL
        fibEnvPendLowBar := bar_index - fibEnvSwingLen
    if not na(fibEnvPH)
        fibEnvPendHigh    := fibEnvPH
        fibEnvPendHighBar := bar_index - fibEnvSwingLen
    int _fePrev = fibEnvState
    // 2) アクティブ波: 終点のみ更新 / 起点の終値突破で無効化 (ヒゲでは無効化しない)
    if fibEnvState == 1
        if high > fibEnvExtreme
            fibEnvExtreme    := high
            fibEnvExtremeBar := bar_index
        if close <= fibEnvOrigin      // 起点安値を終値で割り込み (=100%到達含む) → 無効化
            fibEnvState   := 0
            fibEnvOrigin  := na
            fibEnvExtreme := na
    else if fibEnvState == -1
        if low < fibEnvExtreme
            fibEnvExtreme    := low
            fibEnvExtremeBar := bar_index
        if close >= fibEnvOrigin      // 起点高値を終値で上抜き (=100%到達含む) → 無効化
            fibEnvState   := 0
            fibEnvOrigin  := na
            fibEnvExtreme := na
    // 3) 新しい有意な波の確定 (Neutralから来た足のみ = 無効化直後の同足では反対波を作らない)
    if _fePrev == 0 and fibEnvState == 0
        bool _feBullOk = not na(fibEnvPH) and not na(fibEnvPendLow)  and fibEnvPendLowBar  < (bar_index - fibEnvSwingLen) and (fibEnvPH - fibEnvPendLow) >= fibEnvMinSwing
        bool _feBearOk = not na(fibEnvPL) and not na(fibEnvPendHigh) and fibEnvPendHighBar < (bar_index - fibEnvSwingLen) and (fibEnvPendHigh - fibEnvPL) >= fibEnvMinSwing
        if _feBullOk and (not _feBearOk or (fibEnvPH - fibEnvPendLow) >= (fibEnvPendHigh - fibEnvPL))
            fibEnvState      := 1
            fibEnvOrigin     := fibEnvPendLow
            fibEnvOriginBar  := fibEnvPendLowBar
            fibEnvExtreme    := math.max(fibEnvPH, high)
            fibEnvExtremeBar := bar_index
        else if _feBearOk
            fibEnvState      := -1
            fibEnvOrigin     := fibEnvPendHigh
            fibEnvOriginBar  := fibEnvPendHighBar
            fibEnvExtreme    := math.min(fibEnvPL, low)
            fibEnvExtremeBar := bar_index

// 4) リトレース率 (毎バー現在値で再計算・0〜1・最大値は保持しない)
float fibEnvRetr = na
if fibEnvState == 1 and not na(fibEnvExtreme) and not na(fibEnvOrigin) and (fibEnvExtreme - fibEnvOrigin) > 0
    fibEnvRetr := math.max(0.0, math.min(1.0, (fibEnvExtreme - close) / (fibEnvExtreme - fibEnvOrigin)))
else if fibEnvState == -1 and not na(fibEnvExtreme) and not na(fibEnvOrigin) and (fibEnvOrigin - fibEnvExtreme) > 0
    fibEnvRetr := math.max(0.0, math.min(1.0, (close - fibEnvExtreme) / (fibEnvOrigin - fibEnvExtreme)))

// 5) Long/Short スコア (両方に同時に入らない) + 方向
int fibEnvScoreRaw   = f_fibEnvScore(fibEnvRetr)
int fibEnvLongScore  = fibEnvState == 1  ? fibEnvScoreRaw : 0
int fibEnvShortScore = fibEnvState == -1 ? fibEnvScoreRaw : 0
int fibEnvDirection  = fibEnvState          // 1=Bull / 0=Neutral / -1=Bear

// 6) 将来の統合用パススルー (useFibEnvBias=false の間は常に true = 既存挙動を一切変えない)
//    ※ canLong/canShort へは接続していない。統合する時だけ下記2変数を canLong/canShort に AND する。
bool allowLongByFibEnv  = not useFibEnvBias or fibEnvDirection == 1
bool allowShortByFibEnv = not useFibEnvBias or fibEnvDirection == -1


// ============================================================
//  [C] 表示ブロック  (貼り付け位置: 12. 表示 の末尾)
// ============================================================
// --- テーブル ---
var table fibEnvTbl = na
if fibEnvShowTable
    if na(fibEnvTbl)
        fibEnvTbl := table.new(position.middle_right, 2, 6, border_width = 1)
    if barstate.islast
        color _feCol = fibEnvState == 1 ? fibEnvColBull : fibEnvState == -1 ? fibEnvColBear : fibEnvColNeut
        string _feDir = fibEnvState == 1 ? "BULL WAVE" : fibEnvState == -1 ? "BEAR WAVE" : "NEUTRAL"
        table.cell(fibEnvTbl, 0, 0, "Fib Env", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 1, 0, _feDir,    text_color = color.white, bgcolor = _feCol, text_size = size.small)
        table.cell(fibEnvTbl, 0, 1, "起点", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 1, na(fibEnvOrigin) ? "-" : str.tostring(fibEnvOrigin, "#.##"), text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 0, 2, "終点", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 2, na(fibEnvExtreme) ? "-" : str.tostring(fibEnvExtreme, "#.##"), text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 0, 3, "リトレース率", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 3, na(fibEnvRetr) ? "-" : str.tostring(fibEnvRetr * 100.0, "#.#") + "%", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 0, 4, "LongScore", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 4, str.tostring(fibEnvLongScore), text_color = color.white, bgcolor = fibEnvLongScore > 0 ? fibEnvColBull : color.new(color.black, 0), text_size = size.small)
        table.cell(fibEnvTbl, 0, 5, "ShortScore", text_color = color.white, text_size = size.small)
        table.cell(fibEnvTbl, 1, 5, str.tostring(fibEnvShortScore), text_color = color.white, bgcolor = fibEnvShortScore > 0 ? fibEnvColBear : color.new(color.black, 0), text_size = size.small)

// --- 線 (起点/終点 + 23.6/38.2/50/61.8/78.6%)。毎バー大量生成せず、固定ハンドルを更新 ---
var line fibEnvLnOrigin = na
var line fibEnvLnExtreme = na
var line fibEnvLn236 = na
var line fibEnvLn382 = na
var line fibEnvLn500 = na
var line fibEnvLn618 = na
var line fibEnvLn786 = na
f_fibEnvSetLine(line _ln, int _x1, float _y, color _col, int _style) =>
    if not na(_ln)
        line.set_xy1(_ln, _x1, _y)
        line.set_xy2(_ln, bar_index, _y)
        line.set_color(_ln, _col)
if fibEnvShowLines
    if na(fibEnvLnOrigin)
        fibEnvLnOrigin  := line.new(bar_index, close, bar_index, close, color = color.gray, width = 2)
        fibEnvLnExtreme := line.new(bar_index, close, bar_index, close, color = color.gray, width = 2)
        fibEnvLn236 := line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dotted)
        fibEnvLn382 := line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dotted)
        fibEnvLn500 := line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dashed)
        fibEnvLn618 := line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dotted)
        fibEnvLn786 := line.new(bar_index, close, bar_index, close, color = color.gray, style = line.style_dotted)
    bool _feDraw = fibEnvState != 0 and not na(fibEnvOrigin) and not na(fibEnvExtreme) and not na(fibEnvOriginBar)
    color _feLc = fibEnvState == 1 ? fibEnvColBull : fibEnvColBear
    int _x1 = _feDraw ? fibEnvOriginBar : bar_index
    float _span = _feDraw ? (fibEnvExtreme - fibEnvOrigin) : 0.0   // Bull:+ / Bear:-
    // Bull: リトレース率rの価格 = extreme - r*span ; Bear は span<0 で同式が成立
    f_fibEnvSetLine(fibEnvLnOrigin,  _x1, _feDraw ? fibEnvOrigin  : na, na(fibEnvOrigin)  ? color.gray : _feLc, 0)
    f_fibEnvSetLine(fibEnvLnExtreme, _x1, _feDraw ? fibEnvExtreme : na, na(fibEnvExtreme) ? color.gray : _feLc, 0)
    f_fibEnvSetLine(fibEnvLn236, _x1, _feDraw ? fibEnvExtreme - 0.236 * _span : na, color.new(color.gray, 20), 0)
    f_fibEnvSetLine(fibEnvLn382, _x1, _feDraw ? fibEnvExtreme - 0.382 * _span : na, color.new(color.gray, 20), 0)
    f_fibEnvSetLine(fibEnvLn500, _x1, _feDraw ? fibEnvExtreme - 0.500 * _span : na, color.new(color.gray, 0),  0)
    f_fibEnvSetLine(fibEnvLn618, _x1, _feDraw ? fibEnvExtreme - 0.618 * _span : na, color.new(color.gray, 20), 0)
    f_fibEnvSetLine(fibEnvLn786, _x1, _feDraw ? fibEnvExtreme - 0.786 * _span : na, color.new(color.gray, 20), 0)

// --- Data Window (デバッグ) ---
plot(fibEnvDirection,  "fibEnvDirection",  display = display.data_window)
plot(fibEnvRetr,       "fibEnvRetr",       display = display.data_window)
plot(fibEnvLongScore,  "fibEnvLongScore",  display = display.data_window)
plot(fibEnvShortScore, "fibEnvShortScore", display = display.data_window)
plot(fibEnvOrigin,     "fibEnvOrigin",     display = display.data_window)
plot(fibEnvExtreme,    "fibEnvExtreme",    display = display.data_window)

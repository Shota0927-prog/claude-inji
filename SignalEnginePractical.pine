// ============================================================================
//  SignalEnginePractical  —  Entry Logic Library (Practical Zone Strategy 用)
// ============================================================================
//  SignalEngine/21 から、Practical Zone Strategy (LONG / SHORT) が使う 8 Logic
//  だけに必要な部分を抽出した Library。判定式・順序・state machine の正本は
//  SignalEngine/21 であり、本ファイルはその抽出版 (意味論の変更なし)。
//
//  対象 Logic:
//    FVG / FVG15 / FVGABS5 / FVGABS15 /
//    ZONEREBOUND / ZONEFAKE / ZONERETEST / ZONEBREAK
//  除外:
//    ZONEBOS (legacy section 08) / ZONESR / Future Logics (section 09) /
//    Debug 専用 field・関数 / 表示専用 helper (efvgBiasText 等) / 未使用 export
//
//  ★ 収録状況 ★
//    P01 : Types / Engine state / Cfg / Feed / Signal (確定 + Preview) / Factories /
//          consume* / fvg15Preview / 判定に使われる helper
//    P03 : FVG / FVG15 — 外部足で評価する計算式 (calcTriggers / envTrend /
//          envTrendConfirmed / efvgReboundState / efvgReboundConfirmed /
//          efvgRebound15Pack / drDailyTuple / accumNT15Confirmed /
//          dailyRangeMedian) と updateFvg / updateFvg15 を逐語移植
//    P04 : FVGABS5 / FVGABS15 — efvgAbsState / efvgAbsConfirmed / bosPack /
//          updateFvgAbs / fvgAbsEnvLong / fvgAbsEnvShort を逐語移植
//          (consumeFvgAbs は P01 で移植済み)
//    P05〜P06 : Zone 4Logic を逐語移植予定
//
//  ★ 方向の扱い ★
//    LONG / SHORT 両 Strategy から同じ Library を使う。SignalEngine/21 内部で
//    Long / Short が共有している state (Trigger cooldown / 15M gate /
//    Accum breakDir / Zone roleCycle / Zone event side / 1バー1スロット) は
//    すべて残している。反対方向の判定は「消す」のではなく、Feed / Cfg の
//    allow / enable を false にすることで旧Main (片方向ON) と同じ series を得る。
//
//  ★ Preview ★
//    確定 Signal と Preview (仮アラート用) は同じ式から派生する。Preview 用の
//    field は全 Signal type に残してあり、後から別式で作り直さない。
//
//  ★ 削除した field (どの判定からも読まれない / 旧Main Section 09 の表示専用) ★
//    FvgCfg     : minScore4H / 1H / 15M / 5M / 1M (期間系 simple 引数で渡すため未読)
//    FvgFeed    : d/h/o/b5/b1 の Reason・Rem と dBos / hBos / oBos / b1Bos (未読)
//    FvgSignal  : drLong/ShortOk, trigBull/Bear/NoTrade, long/shortMajorOk,
//                 efvgFinalBias, efvgScore, mBias/Reason/Rem/Bos, drDirCode,
//                 drVolCode, trigCooldownOk, dbg* 一式
//    Fvg15Signal: bosOkLong/Short, rebReason, previewBosOkLong/Short
//    FvgAbsSignal: bos5Ok / bos15Ok / bos5OkS / bos15OkS / previewBos15Ok(S)
//    ZoneEnvFeed: blockedByAccum (方向別の値だけが読まれる)
//    ZoneLogicSignal: evtCount / cand* / dbgRb* / dbgRbS*
// ============================================================================

//@version=5
library("SignalEnginePractical", overlay = true)

// ============================================================================
// 01. TYPES
// ============================================================================

// ---- FvgCfg : FVG Logic の全設定 (input は Main 側で定義して詰める) --------
// ---- FvgTrigCfg : calcTriggers (1分足コンテキスト) が参照する設定だけ ------
//  ★ request.security 式が参照する外部要素 (external elements) を最小にするため、
//    security で評価される関数ごとに設定UDTを分けている。
//    Pineの上限は 1つの security 式あたり 254 個。127フィールドの巨大UDTを
//    security 式へ渡すと、その構築チェーン全体が外部要素として数えられて超過する。
export type FvgTrigCfg
    bool   strictEngulf              = true
    bool   reqOppColor               = true
    bool   useEngulfingTrigger       = false
    bool   usePinbarTrigger          = false
    bool   useBOSTrigger             = false
    bool   useEMARejectTrigger       = false
    bool   useFVGTriggerFormation    = false
    bool   useStrongCandleTrigger    = false
    string triggerMode               = "Any"
    int    minTriggerCount           = 1
    bool   useEMARejectSlopeFilter   = false
    float  emaRejectSlopeMinATR      = 0.12
    float  pinWickBodyMult           = 3.0
    float  pinOppWickMaxRatio        = 2.0
    bool   usePinBodyRatioFilter     = false
    float  pinMaxBodyRatio           = 0.1
    bool   usePinRangeFilter         = false
    float  pinMinRangeATR            = 0.10
    float  strongBodyRatio           = 0.6
    float  trigCloseEdgeRatio        = 0.7
    bool   useEngulfBodyRatioFilter  = true
    float  engulfBodyRatioMin        = 1.20
    bool   useEngulfBodyQualityFilter = true
    float  engulfMinBodyRatio        = 0.60
    bool   useEngulfBodyAtrFilter    = true
    float  engulfMinBodyATR          = 0.30

// ---- FvgEnvCfg : envTrend (各TFコンテキスト) が参照する設定だけ -----------
export type FvgEnvCfg
    bool   useEma20Above50Up         = true
    bool   useEma20SlopeUp           = true
    bool   useEma50SlopeUp           = true
    bool   useCloseAboveEma50        = true
    bool   useCloseAboveEma200       = true
    bool   useEmaDistanceWideU       = true
    bool   useEmaExpansionU          = true
    bool   useEma20Below50Dn         = true
    bool   useEma20SlopeDown         = true
    bool   useEma50SlopeDown         = true
    bool   useCloseBelowEma50        = true
    bool   useCloseBelowEma200       = true
    bool   useEmaDistanceWideD       = true
    bool   useEmaExpansionD          = true
    bool   useEmaDistanceNarrow      = true
    bool   useEma20SlopeWeak         = true
    bool   useEma50SlopeWeak         = true
    bool   useEmaCompression         = true
    bool   useEma20CrossCount        = true
    bool   useEma50CrossCount        = true
    bool   useRangeWidthSmall        = true
    float  slopeMinMult              = 0.15
    float  distWideMult              = 0.50
    float  distNarrowMult            = 0.25
    int    crossMinCount             = 3
    float  rangeMult                 = 1.5
    bool   tieAsRange                = true
    bool   insufficientAsRange       = true

// ---- FvgAccCfg : accumNTDetect (15分足コンテキスト) が参照する設定だけ ----
export type FvgAccCfg
    int    accumNTMinUpperCloses     = 4
    int    accumNTMinLowerCloses     = 4
    int    accumNTMaxSameColorRun    = 4
    float  accumNTAtrMult            = 2.5
    float  accumNTBarRatioMax        = 0.70
    float  accumNTDriftMax           = 0.30

// ---- FvgCfg : 上記以外 (チャート足コンテキストでのみ使う設定) -------------
//  updateFvg でしか使わないため security の外部要素にはならない。
export type FvgCfg
    bool   useLowerTFTrigger         = true
    bool   useTriggerCooldown        = false
    int    triggerCooldownBars       = 3
    bool   useOppositeTriggerNoTrade = true
    string volMode                   = "OFF"
    float  fixedMin                  = 1.0
    bool   useMinVol                 = true
    float  minAtrDollar              = 1.5
    bool   volModeRel                = false
    float  volRatioMin               = 0.9
    string fastVolMode               = "固定値"
    float  fastAtrMin                = 2.2
    float  fastFixedMin              = 10.0
    float  bodyAvgMin                = 0.5
    bool   useRangeRatioFilter       = true
    float  atrRangeRatioMin          = 0.06
    bool   useVolCooldown            = false
    int    volRecoveryBars           = 2
    bool   useEnvFilter              = true
    string reqTrend4H                = "上昇"
    string reqTrend1H                = "上昇"
    string reqTrend15M               = "上昇"
    string reqTrend5M                = "OFF"
    string reqTrend1M                = "OFF"
    int    reqMatchCount             = 0
    bool   useDailyRegimeFilter      = true
    string dailyRegimeMode           = "当日進行中ベース"
    string reqDailyDirection         = "OFF"
    string reqDailyVolatility        = "低ボラ"
    float  dailyLowVolThreshold      = 100.0
    float  dailyHighVolThreshold     = 100.0
    float  dailyDirectionBodyRatio   = 0.40
    float  dailyBullCloseLocation    = 0.65
    float  dailyBearCloseLocation    = 0.35
    bool   dailyInsufficientAsRange  = true
    bool   useAccumNoTrade           = true
    bool   useAccumNT5M              = true
    bool   useAccumNT15M             = true
    int    accumNTKeep               = 1
    bool   useAccumExitConfirm       = false
    int    accumExitConfirmBars      = 2
    bool   useAccumBreakDirection    = true
    int    accumBreakDirectionBars   = 10
    //  ★ Accum内 Zone位置例外 (既定 false = 従来動作と完全一致)
    //    true のとき「現在価格がAccum内」でも、そのAccum箱と Zone中央値 の
    //    位置関係が条件を満たしていれば、その方向のAccum NoTradeだけを解除する。
    //      Long  : AccumLow  >= 有効Support Zone の中央値
    //      Short : AccumHigh <= 有効Resistance Zone の中央値
    //    Zone の探索は Main が行い、その結果 (中央値) だけを FvgFeed で受け取る。
    //    ★ 解除するのは Accum NoTrade だけ。Entry条件を1つも増減させない。
    //    ★ Accum離脱後確認 / 離脱方向フィルター / 保持数 / 5M・15M判定 は不変。
    bool   useAccumZoneException     = false
    bool   useEFVGEnv                = true
    string efvgCombineMode           = "TrendAndFVG"
    bool   useEFVGDaily              = false
    bool   useEFVG4H                 = false
    bool   useEFVG1H                 = false
    bool   useEFVG15M                = false
    bool   useEFVG5M                 = true
    bool   useEFVG1M                 = false
    string efvgIntegrationMode       = "WeightedScore"
    int    efvgReqMatch              = 3
    int    efvgWeightD               = 6
    int    efvgWeight4H              = 5
    int    efvgWeight1H              = 4
    int    efvgWeight15M             = 3
    int    efvgWeight5M              = 2
    int    efvgWeight1M              = 1
    int    efvgScoreThresh           = 1
    bool   efvgMode4Allow            = false
    bool   useFvgBosFilter           = true

// ---- FvgFeed : Main が request.* で取得して渡す外部データ ------------------
export type FvgFeed
    // 発注方向の許可 (Main の Use FVG / Enable Long / Enable Short)
    //  ※ ここで受け取るのは、同時Long/Short成立時の優先処理を分割前と完全に
    //    同じにするため。Main側でも f_submitSignal で再確認する。
    bool  allowLong  = false
    bool  allowShort = false
    // 共通フィルタの結果 (Main が判定。Logic Local に使うかは各Logicの自由)
    bool  sessionOk  = true
    bool  newsOk     = true
    // 1分足トリガー (request.security_lower_tf の結果)
    array<bool> bullTrig
    array<bool> bearTrig
    // ボラフィルタ用 基準ATR
    float baseAtr   = na
    // 環境認識 (各TFの確定トレンド)
    int   env4H     = na
    int   env1H     = na
    int   env15M    = na
    int   env5M     = na
    int   env1M     = na
    // FVG環境認識 (各TFの bias / reason / remain / BOS)
    int   dBias  = 0
    int   hBias  = 0
    int   oBias  = 0
    int   b5Bias = 0
    int   b5Bos  = 0
    int   b1Bias = 0
    // 15M は BOSゲート前の生の値を渡す (ゲートは 5M BOS で updateFvg 内が行う)
    int   mRawBias   = 0
    int   mRawReason = 0
    int   mRawRem    = 0
    int   mRawBos    = 0
    // 日足レジーム
    float drO0 = na
    float drH0 = na
    float drL0 = na
    float drC0 = na
    float drO1 = na
    float drH1 = na
    float drL1 = na
    float drC1 = na
    float drMedianRange = na
    bool  drNewDay = false
    // Accumulation NoTrade (15分足の確定Accum箱)
    float acc15Hi = na
    float acc15Lo = na
    int   acc15St = na
    bool  new15Bar = false
    // Accum内 Zone位置例外 (c.useAccumZoneException = true のときだけ使う)
    //  Main が zoneEng から読み出した「有効Zoneの座標」だけを渡す。
    //    accZnSupCtrs : 有効Support Zone の 中央値
    //    accZnResCtrs : 有効Resistance Zone の 中央値
    //  ★ SignalEngine は ZoneEngine を import しない。座標だけを受け取る。
    //  ★ どのZoneを選ぶかは Accum箱の Low / High が決まって初めて確定するため、
    //    選択は updateFvg 側 (= 実際にAccum内にいると分かった箱の中) で行う。
    //    そのため Main 側は「候補の収集」だけで、選択のための探索は行わない。
    //  ★ 空 (または na) のときは例外なし = 従来どおり NoTrade。
    array<float> accZnSupCtrs
    array<float> accZnResCtrs

// ---- FvgEngine : FVG Logic の永続状態 (Logicごとに独立) -------------------
export type FvgEngine
    // Trigger
    int   lastTrigBar          = na
    // Volatility
    int   volRecoveryStartBar  = na
    bool  prevVolLow           = false
    // FVG環境認識 15M ゲートのラッチ
    int   m15GateBias          = 0
    int   m15PrevReason        = 0
    int   m15PrevRem           = 0
    // 日足レジーム (当日進行中の高安)
    float drDayOpen            = na
    float drDayHigh            = na
    float drDayLow             = na
    // Accumulation NoTrade
    array<float> a5Hi
    array<float> a5Lo
    array<int>   a5St
    float a5BoxHi              = na
    float a5BoxLo              = na
    int   a5BoxSt              = na
    bool  a5Prev               = false
    array<float> a15Hi
    array<float> a15Lo
    array<int>   a15St
    int   a15LastSt            = na
    bool  prevBlockedByAccum   = false
    bool  waitExitConfirm      = false
    int   outsideConfirmCount  = 0
    int   breakDir             = 0
    int   breakDirStartBar     = na
    bool  breakDirActive       = false
    // Armed 管理 (トリガーOFFモード)
    bool  longArmed            = true
    bool  shortArmed           = true

// ---- FvgSignal : updateFvg の戻り値 ---------------------------------------
export type FvgSignal
    bool  longSignal        = false
    bool  shortSignal       = false
    float entryPrice        = na
    // 以下は FVGABS / Zone 4Logic が Filter として再利用する結果 (判定に使用)
    bool  noTriggerMode     = false
    bool  trendOk           = false
    bool  volOk             = false
    bool  blockedByAccum    = false
    // ★ 追加: Accum NoTrade を方向別に分けたもの。
    //   useAccumZoneException = false のときは blockedByAccum と常に同値。
    //   true のときだけ、Zone位置例外が成立した方向が false になる。
    bool  blockedByAccumLong  = false
    bool  blockedByAccumShort = false
    bool  blockedByExitWait = false
    // ★ 追加: Accum離脱方向Filterの結果。計算式は既存のまま、値を外へ出すだけ。
    //   FVG吸収系列がこの結果を再利用し、Accum判定を二重に計算しないようにする。
    bool  accumLongDirOk    = true
    bool  accumShortDirOk   = true
    // ★ 追加: 仮アラート (Provisional) 専用の Preview Signal。
    //   longSignal / shortSignal から barstate.isconfirmed だけを外した同じ式。
    //   Trigger Cooldown / Opposite Trigger NoTrade / Trigger条件 / 環境条件 /
    //   Session / News / ボラ / Daily Regime / Accum / Armed を全て含む。
    //   ★ 読み取り専用の出力。Engine state は一切変更しない。
    bool  previewLong       = false
    bool  previewShort      = false

// ---- Fvg15Engine : 15M FVG反発 → 5M BOS Logic 固有の永続状態 --------------
//  ★ 既存 FvgEngine とは別インスタンス。Armed / Cooldown / Accum 等の状態は
//    一切共有しない (共有するのは Main が計算した Feed の「計算結果」だけ)。
//  ここが持つのは「順序確認」に必要な状態のみ:
//    ・直近15M FVG反発イベントの反発足 開始時刻 (方向別)
//    ・そのイベントを既にEntryで消費したか (方向別)
//    ・新規イベント検出用の直近 reason / remain
//    ・方向別の直近5M BOS 成立時刻
export type Fvg15Engine
    int  longRebTime   = na
    int  shortRebTime  = na
    bool longConsumed  = false
    bool shortConsumed = false
    int  prevReason    = 0
    int  prevRem       = 0
    int  last5mBullT   = na
    int  last5mBearT   = na

// ---- Fvg15Signal : updateFvg15 の戻り値 -----------------------------------
export type Fvg15Signal
    bool  longSignal  = false
    bool  shortSignal = false
    float entryPrice  = na
    // ★ 追加: 仮アラート (Provisional) 専用の Preview Gate。
    //   確定Gate (bosOk + 未消費) と同じ式だが、5M BOS だけ
    //   「形成中の5M足で今この価格のまま確定すればBOS成立」も有効として扱う。
    //   確定用の e.last5mBullT / e.last5mBearT は書き換えない (読み取りのみ)。
    bool  previewGateLong  = false
    bool  previewGateShort = false

// ---- FvgAbsEngine : FVG吸収系列 (Abs5 / Abs15) の永続状態 -----------------
//  ★ 反発系列 (FvgEngine / Fvg15Engine) とは別インスタンス。
//    armed / consumed / eventId / BOS待機 を反発側と一切共有しない。
//    「FVG反発Event ≠ FVG吸収Event」なので、反発でEntryしても吸収は消費されない。
//  各TFが持つのは4つだけ:
//    evXId       … 最後に認識した吸収eventId (吸収成立バー)
//    evXTime     … その eventId をチャート(5分足)上で最初に認識したバーの time
//                  → 「これ以降のBOS」だけを有効にするための基準。同一バーも有効。
//    evXConsumed … 実際にEntryできた eventId (Mainが consumeFvgAbs で通知)
//    bosXTime    … 直近 Bullish BOS の成立時刻 (BOS待機状態はこの時刻比較で表現)
export type FvgAbsEngine
    int ev5Id       = na
    int ev5Time     = na
    int ev5Consumed = na
    int bos1mTime   = na
    int ev15Id       = na
    int ev15Time     = na
    int ev15Consumed = na
    int bos5mTime    = na
    // ★ 追加: Short用 (Long の完全対称)。Bearish BOS の成立時刻。
    //   Long側の bos1mTime / bos5mTime とは別に持つので、Longの判定は一切変わらない。
    int bos1mTimeS   = na
    int bos5mTimeS   = na

// ---- FvgAbsSignal : updateFvgAbs の戻り値 (Long / Short) ------------------
export type FvgAbsSignal
    bool  long5      = false
    bool  long15     = false
    // ★ 追加: Short (Long の完全対称)。
    //   同一TFの吸収イベントは bias が 1 か -1 のどちらか一方なので、
    //   long5 と short5 / long15 と short15 が同時に true になることはない。
    //   → entryPrice は方向別に分けず1つのままでよい (どちらも close)。
    bool  short5     = false
    bool  short15    = false
    float entryPrice = na
    // ★ 追加: 仮アラート (Provisional) 専用の Preview Signal。
    //   long5 / long15 から barstate.isconfirmed だけを外した同じ式。
    //   Abs15 の 5M BOS だけは「形成中の5M足で今この価格のまま確定すれば
    //   BOS成立」も有効として扱う (確定用の e.bos5mTime は書き換えない)。
    bool  previewLong5  = false
    bool  previewLong15 = false
    bool  previewShort5   = false
    bool  previewShort15  = false

// ============================================================================
// 01B. ZONE 4 LOGIC TYPES
// ============================================================================


// @type  1ロジック・1方向ぶんの上位足環境許可設定。
//   各時間足につき 上昇 / レンジ / 下降 を個別ON/OFF。
//   同一時間足内は OR。3状態とも OFF のその時間足は判定対象外。
//   時間足同士の結合は useAnd で AND / OR を切り替える。
//   4H / 1H / 15M が全て無効なら「環境フィルターなし = true」。
export type ZoneTfEnvCfg
    bool up4H   = false
    bool rg4H   = false
    bool dn4H   = false
    bool up1H   = false
    bool rg1H   = false
    bool dn1H   = false
    bool up15M  = false
    bool rg15M  = false
    bool dn15M  = false
    bool useAnd = false

// @type  4ロジック × Long/Short = 8個の環境設定をまとめて渡すための入れ物。
export type ZoneEnvSet
    ZoneTfEnvCfg rbLong
    ZoneTfEnvCfg rbShort
    ZoneTfEnvCfg fkLong
    ZoneTfEnvCfg fkShort
    ZoneTfEnvCfg rtLong
    ZoneTfEnvCfg rtShort
    ZoneTfEnvCfg bkLong
    ZoneTfEnvCfg bkShort

// @type  Zone 4Logic 共通設定。
export type ZoneCommonCfg
    bool   enableLong  = true
    bool   enableShort = true
    bool   useRebound  = true
    bool   useFake     = false
    bool   useRetest   = false
    bool   useBreak    = false
    string reqDailyVol = "OFF"
    float  dailyLowVol  = 0.0
    float  dailyHighVol = 80.0
    bool   insufficientAsRange = true
    float  breakBuffer     = 3.0
    int    fakeMaxBars     = 10
    float  retestMinDist   = 10.0
    float  retestWidthMult = 0.5
    int    waitBars        = 30
    float  minMoveAway     = 0.0
    //  ★ Rebound の「BOSを有効化する前の最低回復位置」を Zone幅比率で指定する。
    //    既定 1.0 = 従来 (Long は Zone上端 / Short は Zone下端)。
    //      Long  (Support Zone)    : 0.00 = Zone下端 / 0.50 = 中央値 / 1.00 = Zone上端
    //      Short (Resistance Zone) : 0.00 = Zone上端 / 0.50 = 中央値 / 1.00 = Zone下端
    //    基準価格を出したあと、従来どおり minMoveAway を追加距離として適用する。
    //      Long  : close >= (bottom + 幅 × ratio) + minMoveAway
    //      Short : close <= (top    - 幅 × ratio) - minMoveAway
    //    ★ 接触 / 接近方向 / BOS / 待機期限 / Break による候補失効など、Rebound の
    //      その他の状態遷移は一切変更しない。変えるのは最低回復位置だけ。
    float  reboundRecoveryRatio = 1.0
    //  ★ Zone Break (LOGIC_ZONEBREAK) 専用の上書き設定 ★
    //    Rebound / FakeBreak / Break Retest が参照する共通設定
    //    (waitBars / reqDailyVol / dailyLowVol / dailyHighVol) は一切変更せず、
    //    Zone Break の Entry判定だけ別の値で評価できるようにするためのもの。
    //    既定値は共通側と同じなので、Main が設定しなければ従来と完全に一致する。
    //      breakWaitBars     : Zone接近から 5M Break確定 までの有効期限 (精密TF本数)
    //      breakReqDailyVol  : Zone Break 用の日足ボラ要求区分
    //      breakDailyLowVol  : Zone Break 用の低ボラ上限
    //      breakDailyHighVol : Zone Break 用の高ボラ下限
    //    ★ ZoneEngine の Break判定 / Zone State管理そのものは分離していない。
    //      分離したのは「ZONEBREAK の Entry判定に使う設定」だけ。
    int    breakWaitBars     = 30
    string breakReqDailyVol  = "OFF"
    float  breakDailyLowVol  = 0.0
    float  breakDailyHighVol = 80.0
    //  ★ Zone Break の「Long側だけ」を旧基準ファイルと一致させるための互換設定 ★
    //    breakLongRefCompat = false (既定) のとき、以下のフィールドは
    //    1つも参照されない。全ての判定が上の Zone Break 共通設定へ戻るため、
    //    Zone Break Short / Zone Rebound / FakeBreak / Break Retest と、
    //    互換モードOFF時の Zone Break Long は修正前と完全に一致する。
    //      breakLongWaitBars         : Zone Break Long 専用の待機本数 (精密TF本数)
    //      breakLongReqDailyVol      : Zone Break Long 専用の日足ボラ要求区分
    //      breakLongDailyLowVol      : Zone Break Long 専用の低ボラ上限
    //      breakLongDailyHighVol     : Zone Break Long 専用の高ボラ下限
    //      breakLongUseAccumNoTrade  : false なら Long Break だけ Accum NoTrade を外す
    //      breakLongUseAccumExitWait : false なら Long Break だけ Accum離脱待機を外す
    //      breakLongUseAccumDirection: false なら Long Break だけ Accum離脱方向を外す
    //    ★ 外すのは「Zone Break Long の Entry判定」だけ。Accum の検出処理
    //      (updateFvg 側の blockedByAccumLong / blockedByExitWait / accumLongDirOk)
    //      は一切変更しないので、他Logicの Accum 判定は完全に不変。
    bool   breakLongRefCompat        = false
    int    breakLongWaitBars         = 30
    string breakLongReqDailyVol      = "OFF"
    float  breakLongDailyLowVol      = 0.0
    float  breakLongDailyHighVol     = 80.0
    bool   breakLongUseAccumNoTrade  = true
    bool   breakLongUseAccumExitWait = true
    bool   breakLongUseAccumDirection = true

// @type  共通フィルタの「結果」だけを受け取る (再計算も request も増やさない)。
export type ZoneEnvFeed
    bool  sessionOk = false
    bool  newsOk    = false
    bool  volOk     = false
    // 方向別 Accum NoTrade (FvgSignal.blockedByAccumLong / Short をそのまま渡す)
    bool  blockedByAccumLong  = false
    bool  blockedByAccumShort = false
    bool  blockedByExitWait = false
    bool  accumLongDirOk  = true
    bool  accumShortDirOk = true
    int   env4H  = 0
    int   env1H  = 0
    int   env15M = 0
    float drMedianRange = na

// @type  追跡中のZoneイベント1件。開始時のZone情報を凍結して保持する。
export type ZoneEvt
    int   zoneId    = na
    //  ★ 同じZoneでも「Roleサイクル」が変わったら別世代のイベントとして扱う。
    //    Roleサイクルは Zone が Support / Resistance として (再) 確立された
    //    回数。Break されて Role を失い、その後もう一度同じ Role になると +1。
    //    重複防止は zoneId + side + roleCycle の3点で行うので、古いBreak系
    //    イベントが生存していても新しい世代の Rebound候補を塞がない。
    int   roleCycle = 0
    float top       = na
    float bottom    = na
    //  ★ イベント作成時のZone Strength / Score も凍結する。
    //    Debug表示が「①有効Zone」と「②〜⑦のEvent」で別Zoneを指すことを防ぐため、
    //    どちらも このイベントが掴んだ1つのZoneの値だけを見る。
    int   strength  = 0
    float score     = na
    int   side      = 0
    int   startBar  = na
    int   phase     = 0
    //  ---- Break時点で凍結する情報 (Retest / FakeBreak が終わるまで不変) ----
    //    zoneId / top / bottom はイベント作成時から凍結済み。
    //    breakDir  :  1 = 上抜けBreak (Resistance) / -1 = 下抜けBreak (Support)
    //    breakTime : Break が確定した Break判定TF足の time (チャート足の time)
    int   breakBar  = na
    int   breakDir  = 0
    int   breakTime = na
    int   rearmBar  = na
    int   touchBar  = na
    int   reclaimBar = na
    int   rejectBar  = na
    int   rejectTime = na
    bool  movedAway   = false
    bool  reclaimed   = false
    bool  touched     = false
    bool  rejected    = false
    bool  fakeAlive   = false
    //  ★ Rebound候補が精密TFのBreakでキャンセルされたか。
    //    Rebound の挙動を改修前と完全一致させるためだけに存在する。
    //    Break / FakeBreak / Retest の phase 遷移には使わない。
    //  ★ 共通 waitBars を超えてから先も Zone Break のためだけに生かしている
    //    イベント。Rebound / FakeBreak / Break Retest からは完全に不可視で、
    //    Break が成立した時点で即座に alive = false にする。
    //    breakWaitBars <= waitBars のとき (既定) は永久に false のまま。
    bool  bkOnly      = false
    bool  rbCancelled = false
    bool  reboundDone = false
    bool  breakDone   = false
    bool  fakeDone    = false
    bool  retestDone  = false
    //  ★ このイベントの精密判定時間足 (秒)。作成時に焼き込み、イベントが
    //    終了するまで変更しない。Break以外の価格判定と本数カウントは全てこのTF。
    int   tfSec       = 0
    //  ★ Break を判定した時間足 (秒)。Break成立時に焼き込む。
    int   brkTfSec    = 0
    bool  alive       = true

// @type  Zone 4Logic の永続状態。Main Strategyで var 宣言すること。
//   sigXxx は「このバーのSignalを出したイベントの index」。
//   consumeZoneEvt() がこの index を使って該当イベントだけを消費する。
export type ZoneEvtEngine
    array<ZoneEvt> evts
    //  精密判定時間足の確定足カウンタ。startBar / breakBar / rearmBar / touchBar /
    //  reclaimBar / rejectBar と fakeMaxBars / waitBars はすべてこの本数で数える。
    int barNo = 0
    //  1本前の精密判定時間足の終値。Zoneへの接近方向 (上から / 下から) の判定に使う。
    float prevClose = na
    int sigRebound = -1
    int sigFake    = -1
    int sigRetest  = -1
    int sigBreak   = -1
    //  ---- Roleサイクル表 (zoneId 単位・イベントとは別管理) -----------------
    //    roleZoneId  : Zone の trackId
    //    roleSide    : 直近に観測した Role ( 1 = Support / -1 = Resistance /
    //                  0 = Role無し。Break等でスナップショットから消えた状態)
    //    roleCycleNo : その Zone の Roleサイクル番号。0 → ±1 や 1 → -1 のように
    //                  Role が (再) 確立されるたびに +1 する。
    //    roleSeen    : このバーのスナップショットに居たか (作業用)
    //    roleSeenBar : 最後に観測した bar_index (古い行の掃除用)
    array<int>  roleZoneId
    array<int>  roleSide
    array<int>  roleCycleNo
    array<bool> roleSeen
    array<int>  roleSeenBar

// @type  Zone 4Logic の出力。Logicごと・方向ごとに完全独立。
export type ZoneLogicSignal
    bool  reboundLong  = false
    bool  reboundShort = false
    bool  fakeLong     = false
    bool  fakeShort    = false
    bool  retestLong   = false
    bool  retestShort  = false
    bool  breakLong    = false
    bool  breakShort   = false
    float entryPrice   = na
    // 仮アラート用 Preview (確定足条件だけを外したもの)
    bool  pvReboundLong  = false
    bool  pvReboundShort = false
    bool  pvFakeLong     = false
    bool  pvFakeShort    = false
    bool  pvRetestLong   = false
    bool  pvRetestShort  = false
    bool  pvBreakLong    = false
    bool  pvBreakShort   = false

// ============================================================================
// 02. FACTORIES
// ============================================================================

// @function  既定値のFvgCfgを作る。Main側でフィールドを上書きする。
// @returns   FvgCfg
export newFvgCfg() =>
    FvgCfg.new()

// @function  FVG Logicの永続状態を作る。Main Strategyで var 宣言すること。
// @returns   FvgEngine
export newFvgEngine() =>
    FvgEngine.new(a5Hi = array.new_float(), a5Lo = array.new_float(), a5St = array.new_int(),
         a15Hi = array.new_float(), a15Lo = array.new_float(), a15St = array.new_int())

// @function  15M FVG → 5M BOS Logic の永続状態を作る。Main Strategyで var 宣言すること。
// @returns   Fvg15Engine
export newFvg15Engine() =>
    Fvg15Engine.new()

// @function  FVG吸収系列 (Abs5 / Abs15) の永続状態を作る。Main Strategyで var 宣言すること。
// @returns   FvgAbsEngine
export newFvgAbsEngine() =>
    FvgAbsEngine.new()

// @function  Zone 4Logic 共通設定の既定値を作る。Main側でフィールドを上書きする。
// @returns   ZoneCommonCfg
export newZoneCommonCfg() =>
    ZoneCommonCfg.new()

// @function  Zone 4Logic の永続状態を作る。Main Strategyで var 宣言すること。
// @returns   ZoneEvtEngine
export newZoneEvtEngine() =>
    ZoneEvtEngine.new(evts = array.new<ZoneEvt>(),
         roleZoneId = array.new_int(), roleSide = array.new_int(),
         roleCycleNo = array.new_int(), roleSeen = array.new_bool(),
         roleSeenBar = array.new_int())

// ============================================================================
// 02B. CONSUME / PREVIEW  (SignalEngine/21 から逐語コピー)
//   consume* : Main が「実際に発注できた」ときだけ呼ぶ state 遷移。
//   fvg15Preview : 確定 Signal と同じ authority から Preview を合成する。
// ============================================================================

// @function  15M FVG反発イベントを「消費済み」にする。
//   Main が「実際に発注できた (Entry IDが空でない)」ときだけ呼ぶこと。
//   Signalが出ただけ / TradePlan FAIL で呼んではいけない。
// @param e    Fvg15Engine
// @param dir  1 = Long / -1 = Short
// @returns    常に true (呼び出しを式として書けるようにするため)
export consumeFvg15(Fvg15Engine e, int dir) =>
    if dir > 0
        e.longConsumed := true
    else if dir < 0
        e.shortConsumed := true
    true

// @function  FVG15 の Provisional (仮アラート) Signal を返す。
//   確定Signal ( updateFvg15 の longSignal / shortSignal ) から
//   「確定足であること」だけを外したもの。それ以外の条件
//   (環境認識 / Session / News / ボラ / Daily Regime / Accum / Trigger /
//    Trigger Cooldown / Opposite Trigger NoTrade / Armed / 5M BOS順序 /
//    イベント消費) は確定と完全に同じ式で評価される。
//   ★ 完全に読み取り専用。Engine state / Armed / consumed / Cooldown を
//     一切書き換えず、strategy.* も呼ばない。
//   ★ Main で条件を組み直さないための合成関数。確定側の式を変えたら
//     Preview 側も同じ場所で追従するため、本番Entry条件とズレない。
// @param base  updateFvg (15M設定インスタンス) が返した FvgSignal
// @param s     updateFvg15 が返した Fvg15Signal
// @returns     [previewLong, previewShort]
export fvg15Preview(FvgSignal base, Fvg15Signal s) =>
    [base.previewLong and s.previewGateLong, base.previewShort and s.previewGateShort]

// @function  吸収イベントを「消費済み」にする。
//   Main が「実際に発注できた (Entry IDが空でない)」ときだけ呼ぶこと。
//   Signalが出ただけ / Zone TradePlan FAIL では呼んではいけない。
// @param e      FvgAbsEngine
// @param which  5 = Abs5 / 15 = Abs15
// @returns      常に true
export consumeFvgAbs(FvgAbsEngine e, int which) =>
    if which == 5
        e.ev5Consumed := e.ev5Id
    else if which == 15
        e.ev15Consumed := e.ev15Id
    true

// @function  Zoneイベントを「消費済み」にする。
//   Main が「実際に発注できた (Entry IDが空でない)」ときだけ呼ぶこと。
//   Signalが出ただけ / TradePlan FAIL では呼んではいけない。
//     kind 0 = Rebound   : そのイベントは終了
//     kind 1 = FakeBreak : そのイベントは終了 (未成立Retest候補も同時にキャンセル)
//     kind 2 = Retest    : そのイベントは終了
//     kind 3 = Break     : イベントは生かしたまま (Fake / Retest を続けて管理)
// @param e     ZoneEvtEngine
// @param kind  0 = Rebound / 1 = FakeBreak / 2 = Break Retest / 3 = Break
// @returns     常に true
export consumeZoneEvt(ZoneEvtEngine e, int kind) =>
    int idx = kind == 0 ? e.sigRebound : kind == 1 ? e.sigFake : kind == 2 ? e.sigRetest : e.sigBreak
    if not na(idx) and idx >= 0 and idx < array.size(e.evts)
        ZoneEvt q = array.get(e.evts, idx)
        if kind == 0
            q.reboundDone := true
            q.alive       := false
        else if kind == 1
            q.fakeDone   := true
            q.retestDone := true
            q.alive      := false
        else if kind == 2
            q.retestDone := true
            q.alive      := false
        else
            q.breakDone := true
    true

// ============================================================================
// 03. HELPERS  (SignalEngine/21 から逐語コピー。判定に使われるもの)
// ============================================================================
// 有効化されているトリガー数 (Any / All / MinCount 判定で使用)
// 有効化されているトリガー数 (Any / All / MinCount 判定で使用)
f_enabledTrigCount(FvgTrigCfg tc) =>
    (tc.useEngulfingTrigger?1:0) + (tc.usePinbarTrigger?1:0) + (tc.useBOSTrigger?1:0) + (tc.useEMARejectTrigger?1:0) + (tc.useFVGTriggerFormation?1:0) + (tc.useStrongCandleTrigger?1:0)

f_combineTrig(FvgTrigCfg tc, int cnt, int enabled) =>
    tc.triggerMode == "Any"  ? cnt >= 1 :
     tc.triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= tc.minTriggerCount

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

export dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
export dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(FvgCfg c, float o, float h, float l, float cl) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(cl) and _rng > 0
        float _body = math.abs(cl - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (cl - l) / _rng
        bool _bull = cl > o and _bodyRatio >= c.dailyDirectionBodyRatio and _closeLoc >= c.dailyBullCloseLocation
        bool _bear = cl < o and _bodyRatio >= c.dailyDirectionBodyRatio and _closeLoc <= c.dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

// ============================================================================
// P03 : FVG / FVG15  (以下は SignalEngine/21 から逐語移植。
//        変更点は FvgSignal.new / Fvg15Signal.new から P01 で削除した
//        Debug / 表示専用 field の名前付き引数を外したことだけ)
// ============================================================================

// ============================================================================
// 03. FVG · 外部足コンテキストで評価する計算式
// ----------------------------------------------------------------------------
//  これらは Main が request.security() / request.security_lower_tf() で包む。
//  中身のロジックは分割前と同一。
// ============================================================================

export calcTriggers(FvgTrigCfg tc, simple int engulfAtrLen, simple int pinRangeAtrLen,
     simple int bosLookback, simple int emaLenTrigger, simple int emaRejectSlopeLookback,
     simple int emaRejectSlopeAtrLen) =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not tc.useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * tc.engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not tc.useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= tc.engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not tc.useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * tc.engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = tc.useEngulfingTrigger and close > open and (not tc.reqOppColor or _pDn) and (tc.strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = tc.useEngulfingTrigger and close < open and (not tc.reqOppColor or _pUp) and (tc.strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not tc.usePinBodyRatioFilter or _bodyRatio <= tc.pinMaxBodyRatio
    bool _pinRangeOk     = not tc.usePinRangeFilter     or _range >= _pinAtr * tc.pinMinRangeATR
    bool _bullPin = tc.usePinbarTrigger and _loWick > _body * tc.pinWickBodyMult and _loWick > _upWick * tc.pinOppWickMaxRatio and _closePos >= tc.trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = tc.usePinbarTrigger and _upWick > _body * tc.pinWickBodyMult and _upWick > _loWick * tc.pinOppWickMaxRatio and _closePos <= 1.0 - tc.trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = tc.useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = tc.useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * tc.emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not tc.useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not tc.useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = tc.useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = tc.useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = tc.useFVGTriggerFormation and low > high[2]
    bool _bearFVG = tc.useFVGTriggerFormation and high < low[2]
    bool _bullStr = tc.useStrongCandleTrigger and close > open and _bodyRatio >= tc.strongBodyRatio and _closePos >= tc.trigCloseEdgeRatio
    bool _bearStr = tc.useStrongCandleTrigger and close < open and _bodyRatio >= tc.strongBodyRatio and _closePos <= 1.0 - tc.trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    bool _bullTrigger = f_combineTrig(tc, _bullCnt, f_enabledTrigCount(tc))
    bool _bearTrigger = f_combineTrig(tc, _bearCnt, f_enabledTrigCount(tc))
    [_bullTrigger, _bearTrigger]

export envTrend(FvgEnvCfg ec, simple int len20, simple int len50, simple int len200,
     simple int envAtrLen, simple int slopeBars, simple int convDivBars, simple int crossBars,
     simple int rangeBars, int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += ec.useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += ec.useEma20SlopeUp      and slope20 >=  atr * ec.slopeMinMult    ? 1 : 0
    bullScore += ec.useEma50SlopeUp      and slope50 >=  atr * ec.slopeMinMult    ? 1 : 0
    bullScore += ec.useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += ec.useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += ec.useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * ec.distWideMult ? 1 : 0
    bullScore += ec.useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += ec.useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += ec.useEma20SlopeDown    and slope20 <= -atr * ec.slopeMinMult    ? 1 : 0
    bearScore += ec.useEma50SlopeDown    and slope50 <= -atr * ec.slopeMinMult    ? 1 : 0
    bearScore += ec.useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += ec.useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += ec.useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * ec.distWideMult ? 1 : 0
    bearScore += ec.useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += ec.useEmaDistanceNarrow and dist <= atr * ec.distNarrowMult              ? 1 : 0
    rangeScore += ec.useEma20SlopeWeak     and math.abs(slope20) <= atr * ec.slopeMinMult  ? 1 : 0
    rangeScore += ec.useEma50SlopeWeak     and math.abs(slope50) <= atr * ec.slopeMinMult  ? 1 : 0
    rangeScore += ec.useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += ec.useEma20CrossCount    and cnt20 >= ec.crossMinCount                    ? 1 : 0
    rangeScore += ec.useEma50CrossCount    and cnt50 >= ec.crossMinCount                    ? 1 : 0
    rangeScore += ec.useRangeWidthSmall    and rangeWidth <= atr * ec.rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := ec.insufficientAsRange ? 0 : na
    else if tie
        trend := ec.tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend


export envTrendConfirmed(FvgEnvCfg ec, simple int len20, simple int len50, simple int len200,
     simple int envAtrLen, simple int slopeBars, simple int convDivBars, simple int crossBars,
     simple int rangeBars, int minScore) =>
    int _t = envTrend(ec, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore)
    _t[1]

export efvgReboundState(int holdBars, float minThickR, float depthMax, float recoverRatio,
     bool useBos, simple int bosLen) =>
    float _ref = ta.atr(14)
    var float _btop = na
    var float _bbot = na
    var int   _bbar = na
    var bool  _bReb  = false
    var bool  _bDead = false
    var float _rtop = na
    var float _rbot = na
    var int   _rbar = na
    var bool  _rReb  = false
    var bool  _rDead = false
    var int   _bias   = 0
    var int   _reason = 0
    var int   _evbar  = na
    var int   _bosState = 0
    //  ★ Debug用 : BOSが成立したバー。判定には使わない (値を外へ出すだけ)。
    var int   _bosBar = na
    bool _fbBull = close > ta.highest(high, bosLen)[1]
    bool _fbBear = close < ta.lowest(low,  bosLen)[1]
    if _fbBull
        _bosState := 1
        _bosBar   := bar_index
    if _fbBear
        _bosState := -1
        _bosBar   := bar_index
    bool _newBull = _ref > 0 and low > high[2] and ((low - high[2]) / _ref) >= minThickR
    bool _newBear = _ref > 0 and high < low[2] and ((low[2] - high) / _ref) >= minThickR
    if _newBull
        _btop := low
        _bbot := high[2]
        _bbar := bar_index
        _bReb := false
        _bDead := false
    if _newBear
        _rtop := low[2]
        _rbot := high
        _rbar := bar_index
        _rReb := false
        _rDead := false
    if not na(_bbot) and close <= _bbot
        _bDead := true
    if not na(_rtop) and close >= _rtop
        _rDead := true
    float _bWidth = (not na(_btop) and not na(_bbot)) ? _btop - _bbot : na
    float _rWidth = (not na(_rtop) and not na(_rbot)) ? _rtop - _rbot : na
    float _bPen = (not na(_bWidth) and _bWidth > 0) ? (_btop - low) / _bWidth : na
    float _rPen = (not na(_rWidth) and _rWidth > 0) ? (high - _rbot) / _rWidth : na
    //  ★ Debug用 : 反発条件が実際に使う「回復位置」を比率で出したもの。
    //    判定式は close >= _bbot + _bWidth * recoverRatio。その左辺を幅で割った値。
    float _bRec = (not na(_bWidth) and _bWidth > 0) ? (close - _bbot) / _bWidth : na
    float _rRec = (not na(_rWidth) and _rWidth > 0) ? (_rtop - close) / _rWidth : na
    bool _rebLong  = not na(_btop) and not _bReb and not _bDead and bar_index > _bbar and not na(_bWidth) and _bWidth > 0 and low <= _btop and _bPen <= depthMax and close >= _bbot + _bWidth * recoverRatio and close > open
    bool _rebShort = not na(_rtop) and not _rReb and not _rDead and bar_index > _rbar and not na(_rWidth) and _rWidth > 0 and high >= _rbot and _rPen <= depthMax and close <= _rtop - _rWidth * recoverRatio and close < open
    bool _longAllowed  = not useBos or _bosState != -1
    bool _shortAllowed = not useBos or _bosState !=  1
    if _rebLong and _rebShort
        _bias := 0
        _reason := 0
        _evbar := na
        _bReb := true
        _rReb := true
    else if _rebLong
        _bReb := true
        if _longAllowed
            _bias := 1
            _reason := 1
            _evbar := bar_index
    else if _rebShort
        _rReb := true
        if _shortAllowed
            _bias := -1
            _reason := -1
            _evbar := bar_index
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias   = _active ? _bias : 0
    int _outReason = _active ? _reason : 0
    int _outRemain = _active ? holdBars - (bar_index - _evbar) : 0
    int _outElapsed = na(_evbar) ? na : bar_index - _evbar
    //  ★ BOS成立からの経過本数 (その時間足の本数)。_bosBar は判定に使わない記録用。
    int _bosEl = na(_bosBar) ? na : bar_index - _bosBar
    //  ★ 先頭4値は従来と完全に同一。5番目以降は Debug専用の追加出力で、
    //    どれも「判定に実際に使った変数そのもの」を返しているだけ。
    [_outBias, _outReason, _outRemain, _bosState,
     _bPen, _bRec, _rPen, _rRec, _outElapsed, _evbar, _bbar, _rbar, _bosEl]

export efvgReboundConfirmed(int holdBars, float minThickR, float depthMax, float recoverRatio,
     bool useBos, simple int bosLen) =>
    [_b, _r, _rem, _bos, _bp, _br, _rp, _rr, _el, _ev, _bb, _rb, _bsb] =
         efvgReboundState(holdBars, minThickR, depthMax, recoverRatio, useBos, bosLen)
    [_b[1], _r[1], _rem[1], _bos[1]]

// @function  efvgReboundConfirmed と同じ4値に「その確定足の開始時刻」を足して返す。
//   15M FVG反発 → 5M BOS の順序確認は「反発が起きた15M足の開始時刻」を基準にするため、
//   反発状態と時刻を1回の request.security でまとめて取得できるようにしたもの。
//   先頭4要素は efvgReboundConfirmed と完全に同一の式なので、既存Logicが
//   この関数から4値を受け取っても取得値は変わらない (同一TFでの重複requestを避ける)。
// @returns   [bias, reason, remain, bosState, barOpenTime]
export efvgRebound15Pack(int holdBars, float minThickR, float depthMax, float recoverRatio,
     bool useBos, simple int bosLen) =>
    [_b, _r, _rem, _bos, _bp, _br, _rp, _rr, _el, _ev, _bb, _rb, _bsb] =
         efvgReboundState(holdBars, minThickR, depthMax, recoverRatio, useBos, bosLen)
    [_b[1], _r[1], _rem[1], _bos[1], time[1]]

export drDailyTuple() =>
    [open, high, low, close, open[1], high[1], low[1], close[1]]

f_accumNTDetect(FvgAccCfg ac, simple int rangeLen, simple int baseLen, simple int atrLen) =>
    _atr       = ta.atr(atrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * ac.accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, rangeLen) - ta.lowest(_bodyBot, rangeLen)
    _rangeBase  = ta.highest(_bodyTop, baseLen)  - ta.lowest(_bodyBot, baseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * ac.accumNTBarRatioMax
    _condBalance  = _upperCloses >= ac.accumNTMinUpperCloses and _lowerCloses >= ac.accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= ac.accumNTDriftMax
    _condColorRun = _maxBullRun <= ac.accumNTMaxSameColorRun and _maxBearRun <= ac.accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), rangeLen)
    float _lo = ta.lowest(math.min(open, close),  rangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15(FvgAccCfg ac, simple int rangeLen, simple int baseLen, simple int atrLen) =>
    [_isA, _hi, _lo] = f_accumNTDetect(ac, rangeLen, baseLen, atrLen)
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

export accumNT15Confirmed(FvgAccCfg ac, simple int rangeLen, simple int baseLen, simple int atrLen) =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15(ac, rangeLen, baseLen, atrLen)
    [_bxHi[1], _bxLo[1], _bxSt[1]]
// @function     日足レンジ(High-Low)の中央値。前日までの確定N本のみを見る。
//               request.security(sym, "D", sg.dailyRangeMedian(len), lookahead_on) で呼ぶ。
// @param len    中央値を取る本数
// @returns      float
export dailyRangeMedian(simple int len) =>
    ta.median(high - low, len)[1]


// ============================================================================
// 05. FVG · updateFvg (本体)
// ----------------------------------------------------------------------------
//  毎バー1回呼ぶ。分割前 Strategy の Section 5.7〜5.14 と同じ順序・同じ判定。
//
//  期間系 (simple int) を明示パラメータで受け取るのは、UDTフィールドが series
//  修飾になり ta.atr(length) 等へ渡せないため (制約4)。値は Main の input のまま
//  渡すこと。
// ============================================================================

// @function  FVG Entry Logic を1バー分評価する。
// @param e   FvgEngine (Mainで var 宣言した永続状態)
// @param c   FvgCfg
// @param f   FvgFeed
// @param engulfAtrLen           包み足 ATR期間
// @param pinRangeAtrLen         ピンバー ATR期間
// @param bosLookback            BOS Lookback
// @param emaLenTrigger          EMAリジェクト EMA期間
// @param emaRejectSlopeLookback EMAリジェクト 傾き判定本数
// @param emaRejectSlopeAtrLen   EMAリジェクト 傾きATR期間
// @param volAvgLen              ATR平均本数
// @param fastAtrLen             fastATR / 値幅 参照本数
// @param bodyAvgLen             実体平均本数
// @param rangeLookback          RangeWidth参照本数
// @param accumNTRangeLen        Accum判定レンジ本数
// @param accumNTBaseLen         Accum基準平均本数
// @param accumNTAtrLen          Accum ATR本数
// @returns   FvgSignal
// @function  Accum内 Zone位置例外 (Long)。内部用・非export。
//   Accum箱の Low に対して「下側にある有効Support Zone のうち最も近いもの」を
//   1つだけ選び、そのZoneについてだけ判定する。
//     選択 : ZoneCenter <= AccumLow を満たすSupportの中で ZoneCenter が最大のもの
//            (= AccumLow に最も近い下側Support)
//     条件 : AccumLow >= 選択ZoneのCenter
//   ★ Zone と Accum が重なっていることは必須にしない。
//     「Zone上半分にAccumが食い込んでいる」「Zone上端のすぐ上にAccumがある」
//     どちらも Long 対象。
//   ★ Strength / Score / 距離パラメータの追加フィルターは掛けていない。
//   ★ 走査するのは「実際にAccum箱の中にいる」と分かってから呼ばれたときだけ。
// @param c        FvgCfg
// @param f        FvgFeed
// @param accLow   その Accum箱 の下限
// @returns        bool (true = Long側のAccum NoTradeを解除してよい)
f_accZoneExcLong(FvgCfg c, FvgFeed f, float accLow) =>
    bool r = false
    if c.useAccumZoneException and not na(accLow) and not na(f.accZnSupCtrs)
        int   n    = array.size(f.accZnSupCtrs)
        float selC = na
        if n > 0
            for j = 0 to n - 1
                float zc = array.get(f.accZnSupCtrs, j)
                if zc <= accLow and (na(selC) or zc > selC)
                    selC := zc
        r := not na(selC) and accLow >= selC
    r

// @function  Accum内 Zone位置例外 (Short)。f_accZoneExcLong と完全対称・非export。
//     選択 : ZoneCenter >= AccumHigh を満たすResistanceの中で ZoneCenter が最小のもの
//            (= AccumHigh に最も近い上側Resistance)
//     条件 : AccumHigh <= 選択ZoneのCenter
//   ★ Zone と Accum が重なっていることは必須にしない (Long と完全対称)。
// @param c        FvgCfg
// @param f        FvgFeed
// @param accHigh  その Accum箱 の上限
// @returns        bool (true = Short側のAccum NoTradeを解除してよい)
f_accZoneExcShort(FvgCfg c, FvgFeed f, float accHigh) =>
    bool r = false
    if c.useAccumZoneException and not na(accHigh) and not na(f.accZnResCtrs)
        int   n    = array.size(f.accZnResCtrs)
        float selC = na
        if n > 0
            for j = 0 to n - 1
                float zc = array.get(f.accZnResCtrs, j)
                if zc >= accHigh and (na(selC) or zc < selC)
                    selC := zc
        r := not na(selC) and accHigh <= selC
    r

export updateFvg(FvgEngine e, FvgCfg c, FvgTrigCfg tc, FvgAccCfg ac, FvgFeed f,
     simple int engulfAtrLen, simple int pinRangeAtrLen, simple int bosLookback,
     simple int emaLenTrigger, simple int emaRejectSlopeLookback, simple int emaRejectSlopeAtrLen,
     simple int volAvgLen, simple int fastAtrLen, simple int bodyAvgLen, simple int rangeLookback,
     simple int accumNTRangeLen, simple int accumNTBaseLen, simple int accumNTAtrLen) =>
    // ---- 包み足判定 (変更なし) ---------------------------------------------
    bool prevUp = close[1] > open[1]
    bool prevDn = close[1] < open[1]
    bool curUp  = close > open
    bool curDn  = close < open

    float curBodyHi  = math.max(open,    close)
    float curBodyLo  = math.min(open,    close)
    float prevBodyHi = math.max(open[1], close[1])
    float prevBodyLo = math.min(open[1], close[1])

    bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

    bool bullEngulf = curUp and (not tc.reqOppColor or prevDn) and (tc.strictEngulf ? engulfBody : close >= prevBodyHi)
    bool bearEngulf = curDn and (not tc.reqOppColor or prevUp) and (tc.strictEngulf ? engulfBody : close <= prevBodyLo)

    // ---- エントリートリガー統合 (変更なし) ---------------------------------
    float trBody      = math.abs(close - open)
    float trRange     = high - low
    float trUpWick    = high - math.max(open, close)
    float trLoWick    = math.min(open, close) - low
    float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
    float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

    float curBodySize  = math.abs(close - open)
    float prevBodySize = math.abs(close[1] - open[1])
    float curRangeSize = high - low
    float engulfAtr = na
    if tc.useEngulfingTrigger and tc.useEngulfBodyAtrFilter
        engulfAtr := ta.atr(engulfAtrLen)
    bool engulfRatioOk =
         not tc.useEngulfBodyRatioFilter or
         (prevBodySize > 0 and curBodySize >= prevBodySize * tc.engulfBodyRatioMin)
    bool engulfBodyQualityOk =
         not tc.useEngulfBodyQualityFilter or
         (curRangeSize > 0 and curBodySize / curRangeSize >= tc.engulfMinBodyRatio)
    bool engulfBodyAtrOk =
         not tc.useEngulfBodyAtrFilter or
         curBodySize >= engulfAtr * tc.engulfMinBodyATR
    bool engulfQualityOk =
         engulfRatioOk and
         engulfBodyQualityOk and
         engulfBodyAtrOk
    bool trBullEng = tc.useEngulfingTrigger and bullEngulf and engulfQualityOk
    bool trBearEng = tc.useEngulfingTrigger and bearEngulf and engulfQualityOk

    float pinAtr = na
    if tc.usePinbarTrigger and tc.usePinRangeFilter
        pinAtr := ta.atr(pinRangeAtrLen)
    bool pinBodyRatioOk = not tc.usePinBodyRatioFilter or trBodyRatio <= tc.pinMaxBodyRatio
    bool pinRangeOk     = not tc.usePinRangeFilter     or trRange >= pinAtr * tc.pinMinRangeATR
    bool trBullPin = tc.usePinbarTrigger and trLoWick > trBody * tc.pinWickBodyMult and trLoWick > trUpWick * tc.pinOppWickMaxRatio and trClosePos >= tc.trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
    bool trBearPin = tc.usePinbarTrigger and trUpWick > trBody * tc.pinWickBodyMult and trUpWick > trLoWick * tc.pinOppWickMaxRatio and trClosePos <= 1.0 - tc.trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

    float bosHigh = na
    float bosLow  = na
    if tc.useBOSTrigger
        bosHigh := ta.highest(high, bosLookback)[1]
        bosLow  := ta.lowest(low,  bosLookback)[1]
    bool trBullBOS = tc.useBOSTrigger and close > bosHigh
    bool trBearBOS = tc.useBOSTrigger and close < bosLow

    float emaTrig     = na
    float emaSlope    = na
    float emaSlopeMin = na
    bool  emaRejectSlopeLongOk  = true
    bool  emaRejectSlopeShortOk = true
    if tc.useEMARejectTrigger
        emaTrig := ta.ema(close, emaLenTrigger)
        emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
        float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
        emaSlopeMin := emaSlopeAtr * tc.emaRejectSlopeMinATR
        emaRejectSlopeLongOk  := not tc.useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
        emaRejectSlopeShortOk := not tc.useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
    bool trBullEMA =
         tc.useEMARejectTrigger and
         low <= emaTrig and
         close > emaTrig and
         close > open and
         emaRejectSlopeLongOk
    bool trBearEMA =
         tc.useEMARejectTrigger and
         high >= emaTrig and
         close < emaTrig and
         close < open and
         emaRejectSlopeShortOk

    bool trBullFVG = tc.useFVGTriggerFormation and low > high[2]
    bool trBearFVG = tc.useFVGTriggerFormation and high < low[2]

    bool trBullStr = tc.useStrongCandleTrigger and close > open and trBodyRatio >= tc.strongBodyRatio and trClosePos >= tc.trigCloseEdgeRatio
    bool trBearStr = tc.useStrongCandleTrigger and close < open and trBodyRatio >= tc.strongBodyRatio and trClosePos <= 1.0 - tc.trigCloseEdgeRatio

    int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
    int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

    bool trigBullCur = f_combineTrig(tc, bullTrigCount, f_enabledTrigCount(tc))
    bool trigBearCur = f_combineTrig(tc, bearTrigCount, f_enabledTrigCount(tc))

    bool oneMinBullTriggered = false
    bool oneMinBearTriggered = false
    if c.useLowerTFTrigger
        // 1分足トリガー配列は Main が request.security_lower_tf で取得して Feed へ入れる
        if not na(f.bullTrig) and array.size(f.bullTrig) > 0
            for i = 0 to array.size(f.bullTrig) - 1
                if array.get(f.bullTrig, i)
                    oneMinBullTriggered := true
        if not na(f.bearTrig) and array.size(f.bearTrig) > 0
            for i = 0 to array.size(f.bearTrig) - 1
                if array.get(f.bearTrig, i)
                    oneMinBearTriggered := true
    else
        oneMinBullTriggered := trigBullCur
        oneMinBearTriggered := trigBearCur

    bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
    bool trigNoTrade     = c.useOppositeTriggerNoTrade and lowerTFConflict

    bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
    bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

    bool trigFiredNow   = finalBullTrig or finalBearTrig
    bool trigCooldownOk = not c.useTriggerCooldown or na(e.lastTrigBar) or (bar_index - e.lastTrigBar) > c.triggerCooldownBars
    if trigFiredNow and trigCooldownOk
        e.lastTrigBar := bar_index


    // ---- ボラフィルタ判定 (変更なし) ---------------------------------------
    bool baseVolOk = true
    //  ★ Debug用 : 判定に使った現在値と必要値をそのまま控える (式は一切変えない)。
    float dbgBaseVal  = na
    float dbgBaseNeed = na
    if c.volMode == "ATR"
        // baseAtr は atrTf 指定時に request.security が要るため Main が Feed へ入れる
        float baseAtr = f.baseAtr
        float atrAvg  = ta.sma(baseAtr, volAvgLen)
        bool volAbsOk = baseAtr >= c.minAtrDollar
        bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * c.volRatioMin
        baseVolOk := not c.useMinVol or (c.volModeRel ? volRelOk : volAbsOk)
        dbgBaseVal  := baseAtr
        dbgBaseNeed := c.volModeRel ? atrAvg * c.volRatioMin : c.minAtrDollar
    else if c.volMode == "固定値"
        baseVolOk := (high - low) >= c.fixedMin
        dbgBaseVal  := high - low
        dbgBaseNeed := c.fixedMin

    bool fastVolPass = true
    //  ★ Debug用 : 高速ボラ判定に使った現在値 / 必要値 / 実体平均をそのまま控える。
    float dbgFastVal  = na
    float dbgFastNeed = na
    float dbgBodyAvg  = na
    if c.fastVolMode == "ATR"
        float fastAtr = ta.atr(fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
        float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
        bool fastAtrOk    = fastAtr >= c.fastAtrMin
        bool bodyAvgOk    = bodyAvgFast >= c.bodyAvgMin
        bool rangeRatioOk = not c.useRangeRatioFilter or atrRangeRatio >= c.atrRangeRatioMin
        fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
        dbgFastVal  := fastAtr
        dbgFastNeed := c.fastAtrMin
        dbgBodyAvg  := bodyAvgFast
    else if c.fastVolMode == "固定値"
        float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
        float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
        bool fastRangeOk = fastRange >= c.fastFixedMin
        bool bodyAvgOk   = bodyAvgFast >= c.bodyAvgMin
        fastVolPass := fastRangeOk and bodyAvgOk
        dbgFastVal  := fastRange
        dbgFastNeed := c.fastFixedMin
        dbgBodyAvg  := bodyAvgFast

    bool volPassRaw = baseVolOk and fastVolPass
    bool volLowNow  = not volPassRaw
    if volLowNow
        e.volRecoveryStartBar := na
    if not volLowNow and e.prevVolLow
        e.volRecoveryStartBar := bar_index
    bool volRecoveryOk = not c.useVolCooldown or na(e.volRecoveryStartBar) or (bar_index - e.volRecoveryStartBar) >= c.volRecoveryBars

    bool volOk = volPassRaw and volRecoveryOk

    // ---- 環境(トレンド)フィルタ (変更なし) ---------------------------------
    bool allowByEnv  = true
    int  envEnabled = 0
    int  envMatched = 0
    //  ★ Debug用 : 判定に使った m4H..m1M / needMatch をそのまま外へ出すため、
    //    宣言だけ if の外へ出した (代入式・順序・値は一切変えていない)。
    bool dbgM4H  = false
    bool dbgM1H  = false
    bool dbgM15M = false
    bool dbgM5M  = false
    bool dbgM1M  = false
    int  dbgNeedMatch = 0

    if c.useEnvFilter
        // 各TFの環境判定は Main が request.security で取得して Feed へ入れる
        en4H  = c.reqTrend4H  != "OFF"
        en1H  = c.reqTrend1H  != "OFF"
        en15M = c.reqTrend15M != "OFF"
        en5M  = c.reqTrend5M  != "OFF"
        en1M  = c.reqTrend1M  != "OFF"

        m4H  = en4H  and not na(f.env4H)  and f.env4H  == f_reqCode(c.reqTrend4H)
        m1H  = en1H  and not na(f.env1H)  and f.env1H  == f_reqCode(c.reqTrend1H)
        m15M = en15M and not na(f.env15M) and f.env15M == f_reqCode(c.reqTrend15M)
        m5M  = en5M  and not na(f.env5M)  and f.env5M  == f_reqCode(c.reqTrend5M)
        m1M  = en1M  and not na(f.env1M)  and f.env1M  == f_reqCode(c.reqTrend1M)

        envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
        envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

        int needMatch = c.reqMatchCount == 0 ? envEnabled : c.reqMatchCount
        allowByEnv := envEnabled == 0 or envMatched >= needMatch
        dbgM4H  := m4H
        dbgM1H  := m1H
        dbgM15M := m15M
        dbgM5M  := m5M
        dbgM1M  := m1M
        dbgNeedMatch := needMatch


    // ---- FVG 環境認識 (15M は 5M BOS でゲート・変更なし) --------------------
    int efvgMBias = 0
    int efvgMReason = 0
    int efvgMRem = 0
    int efvgMBos = 0

    if c.useEFVGEnv and c.useEFVG15M
        // 15M の生の反発状態 (BOSゲート無し) は Main が Feed へ入れる
        int _b   = f.mRawBias
        int _r   = f.mRawReason
        int _rem = f.mRawRem
        efvgMBos := f.mRawBos
        bool _m15NewEvent = _r != 0 and (_r != e.m15PrevReason or _rem > e.m15PrevRem)
        if _m15NewEvent
            bool _allowL = not c.useFvgBosFilter or f.b5Bos != -1
            bool _allowS = not c.useFvgBosFilter or f.b5Bos !=  1
            e.m15GateBias := _r == 1 ? (_allowL ? 1 : 0) : _r == -1 ? (_allowS ? -1 : 0) : 0
        if _b == 0
            e.m15GateBias := 0
        if c.useFvgBosFilter
            if e.m15GateBias == 1 and f.b5Bos == -1
                e.m15GateBias := 0
            if e.m15GateBias == -1 and f.b5Bos == 1
                e.m15GateBias := 0
        e.m15PrevReason := _r
        e.m15PrevRem := _rem
        efvgMBias := e.m15GateBias
        efvgMReason := e.m15GateBias != 0 ? _r : 0
        efvgMRem := e.m15GateBias != 0 ? _rem : 0

    int efvgEnabledCount = (c.useEFVGDaily ? 1 : 0) + (c.useEFVG4H ? 1 : 0) + (c.useEFVG1H ? 1 : 0) + (c.useEFVG15M ? 1 : 0) + (c.useEFVG5M ? 1 : 0) + (c.useEFVG1M ? 1 : 0)
    bool efvgAllLong  = efvgEnabledCount > 0 and (not c.useEFVGDaily or f.dBias == 1) and (not c.useEFVG4H or f.hBias == 1) and (not c.useEFVG1H or f.oBias == 1) and (not c.useEFVG15M or efvgMBias == 1) and (not c.useEFVG5M or f.b5Bias == 1) and (not c.useEFVG1M or f.b1Bias == 1)
    bool efvgAllShort = efvgEnabledCount > 0 and (not c.useEFVGDaily or f.dBias == -1) and (not c.useEFVG4H or f.hBias == -1) and (not c.useEFVG1H or f.oBias == -1) and (not c.useEFVG15M or efvgMBias == -1) and (not c.useEFVG5M or f.b5Bias == -1) and (not c.useEFVG1M or f.b1Bias == -1)
    int efvgLongCnt  = (c.useEFVGDaily and f.dBias == 1 ? 1 : 0) + (c.useEFVG4H and f.hBias == 1 ? 1 : 0) + (c.useEFVG1H and f.oBias == 1 ? 1 : 0) + (c.useEFVG15M and efvgMBias == 1 ? 1 : 0) + (c.useEFVG5M and f.b5Bias == 1 ? 1 : 0) + (c.useEFVG1M and f.b1Bias == 1 ? 1 : 0)
    int efvgShortCnt = (c.useEFVGDaily and f.dBias == -1 ? 1 : 0) + (c.useEFVG4H and f.hBias == -1 ? 1 : 0) + (c.useEFVG1H and f.oBias == -1 ? 1 : 0) + (c.useEFVG15M and efvgMBias == -1 ? 1 : 0) + (c.useEFVG5M and f.b5Bias == -1 ? 1 : 0) + (c.useEFVG1M and f.b1Bias == -1 ? 1 : 0)
    bool efvgCntLong  = efvgLongCnt  >= c.efvgReqMatch
    bool efvgCntShort = efvgShortCnt >= c.efvgReqMatch
    int efvgScore = (c.useEFVGDaily ? c.efvgWeightD * f.dBias : 0) + (c.useEFVG4H ? c.efvgWeight4H * f.hBias : 0) + (c.useEFVG1H ? c.efvgWeight1H * f.oBias : 0) + (c.useEFVG15M ? c.efvgWeight15M * efvgMBias : 0) + (c.useEFVG5M ? c.efvgWeight5M * f.b5Bias : 0) + (c.useEFVG1M ? c.efvgWeight1M * f.b1Bias : 0)
    bool efvgScoreLong  = efvgScore >= c.efvgScoreThresh
    bool efvgScoreShort = efvgScore <= -c.efvgScoreThresh
    int efvgHtfScore = (c.useEFVGDaily ? c.efvgWeightD * f.dBias : 0) + (c.useEFVG4H ? c.efvgWeight4H * f.hBias : 0)
    int efvgHtfDir = efvgHtfScore > 0 ? 1 : efvgHtfScore < 0 ? -1 : 0
    bool efvgLoConflictLong  = (c.useEFVG1H and f.oBias == -1) or (c.useEFVG15M and efvgMBias == -1) or (c.useEFVG5M and f.b5Bias == -1) or (c.useEFVG1M and f.b1Bias == -1)
    bool efvgLoConflictShort = (c.useEFVG1H and f.oBias == 1) or (c.useEFVG15M and efvgMBias == 1) or (c.useEFVG5M and f.b5Bias == 1) or (c.useEFVG1M and f.b1Bias == 1)
    bool efvgHtfLong  = efvgHtfDir == 1 and (c.efvgMode4Allow or not efvgLoConflictLong)
    bool efvgHtfShort = efvgHtfDir == -1 and (c.efvgMode4Allow or not efvgLoConflictShort)
    bool efvgBiasLong =
         c.efvgIntegrationMode == "AllAgree"     ? efvgAllLong :
         c.efvgIntegrationMode == "MatchCount"   ? efvgCntLong :
         c.efvgIntegrationMode == "WeightedScore" ? efvgScoreLong :
         efvgHtfLong
    bool efvgBiasShort =
         c.efvgIntegrationMode == "AllAgree"     ? efvgAllShort :
         c.efvgIntegrationMode == "MatchCount"   ? efvgCntShort :
         c.efvgIntegrationMode == "WeightedScore" ? efvgScoreShort :
         efvgHtfShort
    int efvgFinalBias = efvgBiasLong and not efvgBiasShort ? 1 : efvgBiasShort and not efvgBiasLong ? -1 : 0

    bool efvgTrendOk = not c.useEnvFilter or allowByEnv
    bool finalEnvLongOk =
         not c.useEFVGEnv ? efvgTrendOk :
         c.efvgCombineMode == "TrendOnly"   ? efvgTrendOk :
         c.efvgCombineMode == "FVGOnly"     ? efvgBiasLong :
         c.efvgCombineMode == "TrendAndFVG" ? (efvgTrendOk and efvgBiasLong) :
         (efvgTrendOk or efvgBiasLong)
    bool finalEnvShortOk =
         not c.useEFVGEnv ? efvgTrendOk :
         c.efvgCombineMode == "TrendOnly"   ? efvgTrendOk :
         c.efvgCombineMode == "FVGOnly"     ? efvgBiasShort :
         c.efvgCombineMode == "TrendAndFVG" ? (efvgTrendOk and efvgBiasShort) :
         (efvgTrendOk or efvgBiasShort)

    // ---- 日足レジームフィルター (変更なし) ---------------------------------
    bool dailyRegimeLongOk  = true
    bool dailyRegimeShortOk = true
    bool dailyRegimeOk      = true
    int   drDirCodeAdj = na
    int   drVolCodeAdj = na
    //  ★ Debug用 : 日足「方向」単体 / 日足「ボラ」単体の判定 (宣言だけ外へ出す)。
    bool  dbgDirOk = true
    bool  dbgVolOk = true

    bool drActive = c.useDailyRegimeFilter

    if drActive
        // 確定日足OHLC / 日足Range中央値 / 日付変更フラグは Main が Feed へ入れる
        float _o0 = f.drO0
        float _h0 = f.drH0
        float _l0 = f.drL0
        float _c0 = f.drC0
        float _o1 = f.drO1
        float _h1 = f.drH1
        float _l1 = f.drL1
        float _c1 = f.drC1
        if f.drNewDay or na(e.drDayHigh)
            e.drDayOpen := open
            e.drDayHigh := high
            e.drDayLow  := low
        else
            e.drDayHigh := math.max(e.drDayHigh, high)
            e.drDayLow  := math.min(e.drDayLow, low)

        bool drUsePrev  = c.dailyRegimeMode == "前日確定ベース"
        bool drUseIntra = c.dailyRegimeMode == "当日進行中ベース"

        float drO = drUsePrev ? _o1 : drUseIntra ? e.drDayOpen : _o0
        float drH = drUsePrev ? _h1 : drUseIntra ? e.drDayHigh : _h0
        float drL = drUsePrev ? _l1 : drUseIntra ? e.drDayLow  : _l0
        float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

        int drDirCode = f_drDirCode(c, drO, drH, drL, drC)
        bool drDirInsufficient = na(drDirCode)
        drDirCodeAdj := drDirInsufficient ? (c.dailyInsufficientAsRange ? 0 : na) : drDirCode

        int drVolCode = na
        if not na(f.drMedianRange)
            drVolCode := f.drMedianRange >= c.dailyHighVolThreshold ? 1 : f.drMedianRange < c.dailyLowVolThreshold ? -1 : 0
        bool drVolInsufficient = na(drVolCode)
        drVolCodeAdj := drVolInsufficient ? (c.dailyInsufficientAsRange ? 0 : na) : drVolCode

        string drDirText = dailyDirectionText(drDirCodeAdj)
        string drVolText = dailyVolatilityText(drVolCodeAdj)
        bool directionMatch  = c.reqDailyDirection  == "OFF" or drDirText == c.reqDailyDirection
        bool volatilityMatch = c.reqDailyVolatility == "OFF" or drVolText == c.reqDailyVolatility
        bool drDirBlock = c.reqDailyDirection  != "OFF" and drDirInsufficient and not c.dailyInsufficientAsRange
        bool drVolBlock = c.reqDailyVolatility != "OFF" and drVolInsufficient and not c.dailyInsufficientAsRange
        dailyRegimeOk := not c.useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock)
        //  ★ Debug用 : 方向とボラを混ぜずに単体で外へ出す (式は上のものそのまま)。
        dbgDirOk := directionMatch and not drDirBlock
        dbgVolOk := volatilityMatch and not drVolBlock

    bool drTradeConnected = c.dailyRegimeMode == "前日確定ベース" or c.dailyRegimeMode == "当日進行中ベース"
    if drTradeConnected
        dailyRegimeLongOk  := dailyRegimeOk
        dailyRegimeShortOk := dailyRegimeOk


    // ---- Accumulation NoTrade ----------------------------------------------
    //  ★ insideAccum5M / insideAccum15M / blockedByAccum の式は従来のまま。
    //    離脱後確認 / 離脱方向フィルター / 保持数 / 5M・15M判定は一切変更しない。
    //  ★ 追加したのは「方向別のブロック判定」だけ:
    //    blkAcc*Long / blkAcc*Short は insideAccum* と同じ箱ループの中で求める
    //    (走査回数は増えない)。c.useAccumZoneException = false なら
    //    blkAcc*Long / blkAcc*Short は insideAccum* と常に同値になる。
    bool insideAccum5M  = false
    bool insideAccum15M = false
    bool blkAcc5Long   = false
    bool blkAcc5Short  = false
    bool blkAcc15Long  = false
    bool blkAcc15Short = false

    if c.useAccumNoTrade and c.useAccumNT5M
        [isA5, hi5, lo5] = f_accumNTDetect(ac, accumNTRangeLen, accumNTBaseLen, accumNTAtrLen)
        bool start5 = isA5 and not e.a5Prev
        e.a5Prev := isA5
        if start5
            e.a5BoxHi := hi5
            e.a5BoxLo := lo5
            e.a5BoxSt := bar_index
            array.push(e.a5Hi, e.a5BoxHi)
            array.push(e.a5Lo, e.a5BoxLo)
            array.push(e.a5St, e.a5BoxSt)
            while array.size(e.a5St) > c.accumNTKeep
                array.shift(e.a5Hi)
                array.shift(e.a5Lo)
                array.shift(e.a5St)
        if isA5
            float _bt = math.max(open, close)
            float _bb = math.min(open, close)
            e.a5BoxHi := math.max(nz(e.a5BoxHi, _bt), _bt)
            e.a5BoxLo := math.min(nz(e.a5BoxLo, _bb), _bb)
            if array.size(e.a5St) > 0
                array.set(e.a5Hi, array.size(e.a5Hi) - 1, e.a5BoxHi)
                array.set(e.a5Lo, array.size(e.a5Lo) - 1, e.a5BoxLo)
        if array.size(e.a5St) > 0
            for i = 0 to array.size(e.a5St) - 1
                float _aLo = array.get(e.a5Lo, i)
                float _aHi = array.get(e.a5Hi, i)
                if close >= _aLo and close <= _aHi
                    insideAccum5M := true
                    // その箱について Long / Short の Zone位置例外を判定する。
                    // 例外が成立しない箱の中にいる限り、その方向はブロックのまま。
                    if not f_accZoneExcLong(c, f, _aLo)
                        blkAcc5Long := true
                    if not f_accZoneExcShort(c, f, _aHi)
                        blkAcc5Short := true

    if c.useAccumNoTrade and c.useAccumNT15M
        // 確定15分足のAccum箱と「新しい15分足が始まったか」は Main が Feed へ入れる
        if f.new15Bar
            if not na(f.acc15St) and f.acc15St != e.a15LastSt
                array.push(e.a15Hi, f.acc15Hi)
                array.push(e.a15Lo, f.acc15Lo)
                array.push(e.a15St, f.acc15St)
                e.a15LastSt := f.acc15St
                while array.size(e.a15St) > c.accumNTKeep
                    array.shift(e.a15Hi)
                    array.shift(e.a15Lo)
                    array.shift(e.a15St)
            else if array.size(e.a15St) > 0 and not na(f.acc15St) and f.acc15St == e.a15LastSt
                array.set(e.a15Hi, array.size(e.a15Hi) - 1, f.acc15Hi)
                array.set(e.a15Lo, array.size(e.a15Lo) - 1, f.acc15Lo)
        if array.size(e.a15St) > 0
            for i = 0 to array.size(e.a15St) - 1
                float _aLo15 = array.get(e.a15Lo, i)
                float _aHi15 = array.get(e.a15Hi, i)
                if close >= _aLo15 and close <= _aHi15
                    insideAccum15M := true
                    if not f_accZoneExcLong(c, f, _aLo15)
                        blkAcc15Long := true
                    if not f_accZoneExcShort(c, f, _aHi15)
                        blkAcc15Short := true

    bool blockedByAccum = c.useAccumNoTrade and ((c.useAccumNT5M and insideAccum5M) or (c.useAccumNT15M and insideAccum15M))
    //  ★ 方向別。式の形は blockedByAccum と完全に同じで、inside* を
    //    「例外が成立しなかった箱の中にいるか」に置き換えただけ。
    //    useAccumZoneException = false なら 3つとも同値になる。
    //  ★ blockedByAccum 自体は従来のまま使う。離脱後確認 / 離脱方向 /
    //    e.prevBlockedByAccum は方向別の値を一切参照しない。
    bool blockedByAccumLong  = c.useAccumNoTrade and ((c.useAccumNT5M and blkAcc5Long)  or (c.useAccumNT15M and blkAcc15Long))
    bool blockedByAccumShort = c.useAccumNoTrade and ((c.useAccumNT5M and blkAcc5Short) or (c.useAccumNT15M and blkAcc15Short))


    bool exitedAccumThisBar =
         c.useAccumNoTrade and
         e.prevBlockedByAccum and
         not blockedByAccum

    if not c.useAccumNoTrade or not c.useAccumExitConfirm
        e.waitExitConfirm  := false
        e.outsideConfirmCount := 0
    else
        if blockedByAccum
            e.waitExitConfirm  := false
            e.outsideConfirmCount := 0
        else if exitedAccumThisBar
            e.waitExitConfirm  := true
            e.outsideConfirmCount := 0
        else if e.waitExitConfirm
            e.outsideConfirmCount += 1
        if e.waitExitConfirm and e.outsideConfirmCount >= c.accumExitConfirmBars
            e.waitExitConfirm := false

    bool blockedByAccumExitWait =
         c.useAccumNoTrade and
         c.useAccumExitConfirm and
         e.waitExitConfirm


    if not c.useAccumNoTrade or not c.useAccumBreakDirection
        e.breakDir         := 0
        e.breakDirStartBar := na
        e.breakDirActive   := false
    else
        if blockedByAccum
            e.breakDir         := 0
            e.breakDirStartBar := na
            e.breakDirActive   := false
        else if exitedAccumThisBar
            bool brokeUp   = false
            bool brokeDown = false
            if c.useAccumNT5M and array.size(e.a5St) > 0
                for i = 0 to array.size(e.a5St) - 1
                    float _bh = array.get(e.a5Hi, i)
                    float _bl = array.get(e.a5Lo, i)
                    bool _wasInside = close[1] >= _bl and close[1] <= _bh
                    if _wasInside and close > _bh
                        brokeUp := true
                    if _wasInside and close < _bl
                        brokeDown := true
            if c.useAccumNT15M and array.size(e.a15St) > 0
                for i = 0 to array.size(e.a15St) - 1
                    float _bh = array.get(e.a15Hi, i)
                    float _bl = array.get(e.a15Lo, i)
                    bool _wasInside = close[1] >= _bl and close[1] <= _bh
                    if _wasInside and close > _bh
                        brokeUp := true
                    if _wasInside and close < _bl
                        brokeDown := true
            if brokeUp and not brokeDown
                e.breakDir         := 1
                e.breakDirStartBar := bar_index
                e.breakDirActive   := true
            else if brokeDown and not brokeUp
                e.breakDir         := -1
                e.breakDirStartBar := bar_index
                e.breakDirActive   := true
            else
                e.breakDir         := 0
                e.breakDirStartBar := na
                e.breakDirActive   := false
        if e.breakDirActive and not na(e.breakDirStartBar) and (bar_index - e.breakDirStartBar > c.accumBreakDirectionBars)
            e.breakDir         := 0
            e.breakDirStartBar := na
            e.breakDirActive   := false

    bool accumLongDirectionOk =
         not c.useAccumNoTrade or
         not c.useAccumBreakDirection or
         not e.breakDirActive or
         e.breakDir == 1
    bool accumShortDirectionOk =
         not c.useAccumNoTrade or
         not c.useAccumBreakDirection or
         not e.breakDirActive or
         e.breakDir == -1


    // ---- 最終シグナル (変更なし) -------------------------------------------
    bool longMajorOk =
         dailyRegimeLongOk and
         f.sessionOk and
         f.newsOk and
         finalEnvLongOk and
         volOk and
         not blockedByAccumLong and
         not blockedByAccumExitWait and
         accumLongDirectionOk
    bool shortMajorOk =
         dailyRegimeShortOk and
         f.sessionOk and
         f.newsOk and
         finalEnvShortOk and
         volOk and
         not blockedByAccumShort and
         not blockedByAccumExitWait and
         accumShortDirectionOk

    bool baseLongCondition  = barstate.isconfirmed and f.allowLong  and longMajorOk
    bool baseShortCondition = barstate.isconfirmed and f.allowShort and shortMajorOk

    bool noTriggerMode = f_enabledTrigCount(tc) == 0

    // Armed管理 (トリガーOFF時: 主要条件の立ち上がりで1回だけ)
    if not longMajorOk
        e.longArmed := true
    if not shortMajorOk
        e.shortArmed := true

    bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and e.longArmed
    bool noTriggerShortSignal = noTriggerMode and baseShortCondition and e.shortArmed

    bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
    bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

    bool fvgLongRaw  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
    bool fvgShortRaw = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

    // 同一機会でロング/ショートが同時成立した場合はローソク色で優先方向を決定 (従来どおり)
    bool fvgLongSignal  = fvgLongRaw
    bool fvgShortSignal = fvgShortRaw
    if fvgLongSignal and fvgShortSignal
        if close >= open
            fvgShortSignal := false
        else
            fvgLongSignal := false

    // ---- Preview Signal (仮アラート専用・確定足条件だけを外したもの) --------
    //   確定式:  baseXCondition = barstate.isconfirmed and f.allowX and XMajorOk
    //   Preview:                                          f.allowX and XMajorOk
    //   それ以外 (Armed / Trigger / Trigger Cooldown / Opposite Trigger NoTrade /
    //   同時成立時のローソク色優先) は確定と完全に同じ式・同じ順序で評価する。
    //   ★ ここでは Engine state を一切書き換えない (読み取りのみ)。
    //     e.lastTrigBar の更新は上の Trigger ブロックで既に済んでおり、
    //     trigCooldownOk はその更新前に確定した値をそのまま使う (確定式と同一)。
    bool pvBaseLong  = f.allowLong  and longMajorOk
    bool pvBaseShort = f.allowShort and shortMajorOk
    bool pvNoTrigLong  = noTriggerMode and pvBaseLong  and e.longArmed
    bool pvNoTrigShort = noTriggerMode and pvBaseShort and e.shortArmed
    bool pvTrigLong  = not noTriggerMode and pvBaseLong  and finalBullTrig and trigCooldownOk
    bool pvTrigShort = not noTriggerMode and pvBaseShort and finalBearTrig and trigCooldownOk
    bool pvLong  = noTriggerMode ? pvNoTrigLong  : pvTrigLong
    bool pvShort = noTriggerMode ? pvNoTrigShort : pvTrigShort
    if pvLong and pvShort
        if close >= open
            pvShort := false
        else
            pvLong := false

    float fvgEntryPrice = close

    // ---- 次バー用に「1本前の値」を保存 (分割前の [1] 参照と等価) ----------
    e.prevVolLow          := volLowNow
    e.prevBlockedByAccum  := blockedByAccum

    FvgSignal.new(
         longSignal        = fvgLongSignal,
         shortSignal       = fvgShortSignal,
         entryPrice        = fvgEntryPrice,
         noTriggerMode     = noTriggerMode,
         trendOk           = efvgTrendOk,
         volOk             = volOk,
         blockedByAccum    = blockedByAccum,
         blockedByAccumLong  = blockedByAccumLong,
         blockedByAccumShort = blockedByAccumShort,
         blockedByExitWait = blockedByAccumExitWait,
         accumLongDirOk    = accumLongDirectionOk,
         accumShortDirOk   = accumShortDirectionOk,
         previewLong       = pvLong,
         previewShort      = pvShort)

// ============================================================================
// 06. FVG15 · updateFvg15 (15M FVG反発 → 5M BOS 順序確認)
// ----------------------------------------------------------------------------
//  この関数がやるのは「順序確認」だけ。
//    ・環境認識 / Session / News / ボラ / Accum / Daily Regime / Armed は
//      updateFvg() が計算した結果を baseLong / baseShort として受け取る。
//      → 共通計算を二重実装しない。
//    ・SL / TP / RR / Qty / 発注 は一切扱わない (Main の共通Trade Engineの担当)。
//
//  順序 (追加元 Strategy の「15M FVG → 下位足BOS 順序確認」と同じ意味):
//    15M FVG反発が確定
//      → その反発15M足の開始時刻を記録
//      → 「その時刻以降」に成立した同方向5M BOSだけを有効とする
//         (反発より前に出ていた古いBOSは使わない)
//      → 1つの反発イベントにつきEntryは1回だけ (consumed)
//      → 新しい反発イベントが来たら再びEntry可能 (再アーム)
//
//  ★ consumed は「実際に発注できたときだけ」Main が consume15() で立てる。
//    Signalが出ただけ / TradePlan FAIL では消費しない。
//  ★ 5M BOS はチャート足(5分足)で判定するため request.security は使わない。
// ============================================================================

// @function  15M FVG反発 → 5M BOS の順序ゲートを1バー分評価する。
// @param e               Fvg15Engine (Mainで var 宣言した永続状態)
// @param baseLong        updateFvg() が出した Long Signal (環境/フィルタ適用済み)
// @param baseShort       updateFvg() が出した Short Signal
// @param entryPrice      Entry価格 (updateFvg() の entryPrice をそのまま)
// @param rawReason       15M FVG反発の reason ( 1=Long反発 / -1=Short反発 / 0=なし)
// @param rawRem          15M FVG反発の remain (新規イベント検出に使う)
// @param rebBarOpenTime  反発が確定した15M足の開始時刻
// @param useOrder        順序確認を使うか (falseなら従来どおりゲートなし)
// @param bos5Lookback    5M BOS Lookback (15M用・既存 bosLookback とは別)
// @returns  Fvg15Signal
export updateFvg15(Fvg15Engine e, bool baseLong, bool baseShort, float entryPrice,
     int rawReason, int rawRem, int rebBarOpenTime, bool useOrder, simple int bos5Lookback) =>
    // ---- (1) 新規15M FVG反発イベント検出 -----------------------------------
    //   reason が変わった / remain が増えた = 新しい反発イベント。
    //   反発足の開始時刻を記録し、そのイベントの消費フラグを再アームする。
    bool newLong  = rawReason == 1  and (rawReason != e.prevReason or rawRem > e.prevRem)
    bool newShort = rawReason == -1 and (rawReason != e.prevReason or rawRem > e.prevRem)
    if newLong
        e.longRebTime  := rebBarOpenTime
        e.longConsumed := false
    if newShort
        e.shortRebTime  := rebBarOpenTime
        e.shortConsumed := false
    e.prevReason := rawReason
    e.prevRem    := rawRem

    // ---- (2) 5M BOS の方向別 最新成立時刻 ----------------------------------
    //   ta.highest / ta.lowest は毎バー評価してから確定足だけで記録する
    //   (条件分岐の中で ta.* を呼ばない)。判定式は追加元と同一。
    float bos5Hi = ta.highest(high, bos5Lookback)[1]
    float bos5Lo = ta.lowest(low,  bos5Lookback)[1]
    if barstate.isconfirmed
        if close > bos5Hi
            e.last5mBullT := time
        if close < bos5Lo
            e.last5mBearT := time

    // ---- (3) 順序判定 : 反発足の開始以降に成立した同方向5M BOSのみ有効 -----
    bool bosOkLong  = not na(e.last5mBullT) and not na(e.longRebTime)  and e.last5mBullT >= e.longRebTime
    bool bosOkShort = not na(e.last5mBearT) and not na(e.shortRebTime) and e.last5mBearT >= e.shortRebTime

    bool gateLong  = not useOrder or (bosOkLong  and not e.longConsumed)
    bool gateShort = not useOrder or (bosOkShort and not e.shortConsumed)

    // ---- Preview Gate (仮アラート専用) -------------------------------------
    //   確定側は (2) で barstate.isconfirmed のときだけ e.last5mBullT を記録する。
    //   Preview では「形成中の5M足で今この価格のまま確定すればBOS成立」を
    //   その場限りのローカル値として評価する。Engine state は書き換えない。
    //   確定足では (2) が既に記録済みなので Preview = 確定 で一致する。
    int pvBullT = close > bos5Hi ? time : e.last5mBullT
    int pvBearT = close < bos5Lo ? time : e.last5mBearT
    bool pvBosOkLong  = not na(pvBullT) and not na(e.longRebTime)  and pvBullT >= e.longRebTime
    bool pvBosOkShort = not na(pvBearT) and not na(e.shortRebTime) and pvBearT >= e.shortRebTime
    bool pvGateLong  = not useOrder or (pvBosOkLong  and not e.longConsumed)
    bool pvGateShort = not useOrder or (pvBosOkShort and not e.shortConsumed)

    Fvg15Signal.new(
         longSignal  = baseLong  and gateLong,
         shortSignal = baseShort and gateShort,
         entryPrice  = entryPrice,
         previewGateLong  = pvGateLong,
         previewGateShort = pvGateShort)

// ============================================================================
// P04 : FVGABS5 / FVGABS15  (以下は SignalEngine/21 から逐語移植。
//        変更点は FvgAbsSignal.new から P01 で削除した Debug 表示専用 field の
//        名前付き引数を外したこと、および section 07 見出しの誤記コメント訂正のみ)
// ============================================================================


// @function  FVG吸収の状態を返す (追加元 FVG Env Signal V の f_efvgState と同一定義)。
//   反発 (efvgReboundState) とは別物。反対方向FVGを終値で完全に抜けたイベントを検出する。
//     Long吸収  : Bearish FVG (top=low[2]) を close が上抜け → Bearish FVGを上方向へ吸収
//     Short吸収 : Bullish FVG (bot=high[2]) を close が下抜け
//   品質条件は追加元と同一 (吸収方向と同じローソク色 / 最低実体率 / 終値端寄せ)。
//   同一FVGにつき吸収は1回だけ (_rabs / _babs)。新しいFVG形成でリセットされる。
// @param holdBars   吸収bias の保持本数
// @param minThickR  FVG最小厚み (幅 / ATR14)
// @param absBodyMin 吸収 実体最小比率
// @param absEdge    吸収 終値端寄せ比率
// @param useColor   吸収方向と同じローソク色を要求するか
// @param useBody    最低実体率を要求するか
// @param useEdge    終値端寄せを要求するか
// @returns  [bias, eventId, eventTime]  bias: 1=Long吸収保持中 / -1=Short / 0=なし
//           eventId  : 吸収成立バー。新しい吸収成立時のみ変化し、hold中は不変
//                      → 「hold保持中」と「新規吸収イベント」を呼び出し側が区別できる。
//           eventTime: ★ 実際に吸収が成立した足の time (そのTFコンテキストの足の開始時刻)。
//                      Main が event を認識するのは confirmed の [1] のぶんだけ後のバーになるため、
//                      「Mainが認識した時刻」で順序判定すると吸収成立足の中で起きたBOSが
//                      すべて「古いBOS」として落ちてしまう。順序判定はこの eventTime を使う。
export efvgAbsState(int holdBars, float minThickR, float absBodyMin, float absEdge,
     bool useColor, bool useBody, bool useEdge) =>
    float _ref = ta.atr(14)
    var float _btop = na
    var float _bbot = na
    var int   _bbar = na
    var bool  _babs = false
    var float _rtop = na
    var float _rbot = na
    var int   _rbar = na
    var bool  _rabs = false
    var int   _bias  = 0
    var int   _evbar = na
    var int   _evtime = na
    float _body = math.abs(close - open)
    float _rng  = high - low
    bool _newBull = _ref > 0 and low > high[2] and ((low - high[2]) / _ref) >= minThickR
    bool _newBear = _ref > 0 and high < low[2] and ((low[2] - high) / _ref) >= minThickR
    if _newBull
        _btop := low
        _bbot := high[2]
        _bbar := bar_index
        _babs := false
    if _newBear
        _rtop := low[2]
        _rbot := high
        _rbar := bar_index
        _rabs := false
    bool _bodyStrong  = _rng > 0 and (_body / _rng) >= absBodyMin
    bool _closeNearHi = _rng > 0 and (close - low) / _rng >= absEdge
    bool _closeNearLo = _rng > 0 and (high - close) / _rng >= absEdge
    bool _absLong  = not na(_rtop) and not _rabs and bar_index > _rbar and close > _rtop and (not useColor or close > open) and (not useBody or _bodyStrong) and (not useEdge or _closeNearHi)
    bool _absShort = not na(_btop) and not _babs and bar_index > _bbar and close < _bbot and (not useColor or close < open) and (not useBody or _bodyStrong) and (not useEdge or _closeNearLo)
    if _absLong and _absShort
        _bias   := 0
        _evbar  := na
        _evtime := na
        _rabs   := true
        _babs   := true
    else if _absLong
        _bias   := 1
        _evbar  := bar_index
        _evtime := time
        _rabs   := true
    else if _absShort
        _bias   := -1
        _evbar  := bar_index
        _evtime := time
        _babs   := true
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias = _active ? _bias : 0
    //  ★ Debug用 : hold判定に実際に使っている (bar_index - _evbar) と holdBars。
    int _outRemain  = _active ? holdBars - (bar_index - _evbar) : 0
    int _outElapsed = na(_evbar) ? na : bar_index - _evbar
    [_outBias, _evbar, _evtime, _outRemain, _outElapsed]

// @function  efvgAbsState の確定済み1本前を返す非リペイント版。
//   Main が request.security(..., lookahead_on) で包む。
//   [1] を上位足コンテキスト内で適用するため、返るのは常に「直前に確定した足」の値。
//   eventTime も同じ [1] で取り出すので、値は「その確定足の中で実際に吸収が成立した足の
//   開始時刻」であり、未来のデータは一切含まない (非リペイント構造は不変)。
// @returns  [bias, eventId, eventTime]
export efvgAbsConfirmed(int holdBars, float minThickR, float absBodyMin, float absEdge,
     bool useColor, bool useBody, bool useEdge) =>
    [_b, _ev, _et, _rem, _el] = efvgAbsState(holdBars, minThickR, absBodyMin, absEdge, useColor, useBody, useEdge)
    [_b[1], _ev[1], _et[1]]

// @function  Bullish / Bearish BOS をまとめて返す。
//   計算式は既存BOS (calcTriggers の trBullBOS / trBearBOS、bosBullLowerTf) と完全に同一。
//     Bullish : close > ta.highest(high, lookback)[1]
//     Bearish : close < ta.lowest(low,  lookback)[1]
//   Main が request.security(..., <BOS対象TF>) で包む。Zone BOS Logic 用。
// @param lookback  BOS Lookback
// @returns  [bullBos, bearBos]
export bosPack(simple int lookback) =>
    bool _bull = close > ta.highest(high, lookback)[1]
    bool _bear = close < ta.lowest(low,  lookback)[1]
    [_bull, _bear]

// ============================================================================
// 07. FVGABS · updateFvgAbs (FVG吸収 → BOS 順序確認 / Long・Short対称)
// ----------------------------------------------------------------------------
//  FVG吸収系列は反発系列とは完全に別の系列。
//    Abs5  Long  : 5M Bearish FVG を上方向へ吸収 → 1M Bullish BOS  → Long
//    Abs5  Short : 5M Bullish FVG を下方向へ吸収 → 1M Bearish BOS  → Short
//    Abs15 Long  : 15M Bearish FVG を上方向へ吸収 → 5M Bullish BOS → Long
//    Abs15 Short : 15M Bullish FVG を下方向へ吸収 → 5M Bearish BOS → Short
//  Long / Short は完全対称。吸収判定・品質条件・Hold・BOS Lookback・環境条件の
//  仕組みはすべて共通で、方向に依存する部分だけを反転させている。
//
//  この関数がやるのは「吸収イベント管理 + BOS順序管理 + consumed管理」だけ。
//    ・環境認識 / Session / News / ボラ / Accum は Main が envLongOk にまとめて渡す
//      (Main は既存 updateFvg の出力 volOk / blockedByAccum / accumLongDirOk を
//       再利用するので、これらの重い判定を吸収系列用に再計算しない)。
//    ・SL / TP / RR / Qty / BE は一切扱わない (Main の共通Trade Engineの担当)。
//    ・Short も Long と完全対称に実装されている (正本の旧コメント「Shortは実装しない」は誤り)。
//
//  ★ 状態は反発系列 (FvgEngine / Fvg15Engine) と共有しない。
//    反発でEntryしても吸収イベントは消費されない。

// ============================================================================

// @function  FVG吸収系列を1バー分評価する。
// @param e             FvgAbsEngine (Mainで var 宣言した永続状態)
// @param envLongOk     環境条件がすべて成立しているか (Mainが既存出力から合成)
// @param entryPrice    Entry価格 (通常 close)
// @param abs5Bias      5M 吸収bias  ( 1=Long吸収 保持中)
// @param abs5Event     5M 吸収eventId
// @param abs5EventTime 5M 吸収が実際に成立した足の time (順序判定の基準)
// @param abs15Bias     15M 吸収bias
// @param abs15Event    15M 吸収eventId
// @param abs15EventTime 15M 吸収が実際に成立した足の time (順序判定の基準)
// @param bos1mBull     この5分足に含まれる確定1分足の Bullish BOS(10) 配列
// @param use5          Abs5 Logic を使うか
// @param use15         Abs15 Logic を使うか
// @param bos5Lookback  5M BOS Lookback (Abs15用)
// @returns  FvgAbsSignal
export updateFvgAbs(FvgAbsEngine e, bool envLongOk, bool envShortOk, float entryPrice,
     int abs5Bias, int abs5Event, int abs5EventTime,
     int abs15Bias, int abs15Event, int abs15EventTime,
     array<bool> bos1mBull, array<bool> bos1mBear,
     bool use5, bool use15, simple int bos5Lookback) =>
    // ---- (1) 新規吸収イベント検出 -----------------------------------------
    //   eventId (吸収成立バー) が変わったときだけ「新しいイベント」。
    //   hold保持中は eventId が変わらないので、何度も新規イベントにはならない。
    //   ★ evXTime には「Mainが認識したバーの time」ではなく、SignalEngineが返す
    //     「実際に吸収が成立した足の time」を入れる。
    //     confirmed ([1]) の都合で Main が認識するのは成立足より後になるため、
    //     認識時刻を基準にすると吸収成立足の中で起きたBOSが全部「古いBOS」として
    //     落ちてしまう。成立足の時刻を基準にすれば同一足のBOSも正しく有効になる。
    if not na(abs5Event) and (na(e.ev5Id) or abs5Event != e.ev5Id)
        e.ev5Id   := abs5Event
        e.ev5Time := abs5EventTime
    if not na(abs15Event) and (na(e.ev15Id) or abs15Event != e.ev15Id)
        e.ev15Id   := abs15Event
        e.ev15Time := abs15EventTime

    // ---- (2) BOS の成立時刻を記録 (Bullish / Bearish それぞれ) -------------
    //   1M BOS : この5分足に含まれる確定1分足のどれかで成立していれば
    //     「この5分足で成立」とみなす (1分単位の厳密順序は要求しない仕様)。
    //   ★ Bearish 側は Bullish 側と完全対称。別フィールドに記録するので
    //     Long の判定 (bos1mTime / bos5mTime) は一切変わらない。
    bool bos1mNow = false
    if array.size(bos1mBull) > 0
        for i = 0 to array.size(bos1mBull) - 1
            if array.get(bos1mBull, i)
                bos1mNow := true
    if bos1mNow
        e.bos1mTime := time
    bool bos1mNowS = false
    if array.size(bos1mBear) > 0
        for i = 0 to array.size(bos1mBear) - 1
            if array.get(bos1mBear, i)
                bos1mNowS := true
    if bos1mNowS
        e.bos1mTimeS := time
    //   5M BOS : チャート足。ta.* は毎バー評価してから確定足だけで記録する
    //     (条件分岐の中で ta.* を呼ばない)。
    float bos5Hi = ta.highest(high, bos5Lookback)[1]
    float bos5Lo = ta.lowest(low,   bos5Lookback)[1]
    if barstate.isconfirmed and close > bos5Hi
        e.bos5mTime := time
    if barstate.isconfirmed and close < bos5Lo
        e.bos5mTimeS := time

    // ---- (3) 順序判定 ------------------------------------------------------
    //   「吸収が実際に成立した足の開始時刻以降」のBOSだけ有効。
    //   BOS時刻はチャート(5分足)の足の開始時刻なので、吸収成立足と同じ5分足で
    //   起きたBOSは bosTime == eventTime となり >= で有効になる。
    //   吸収より前に出ていた古いBOSは time が小さいため自動的に除外される。
    bool bos5Ok  = not na(e.bos1mTime) and not na(e.ev5Time)  and e.bos1mTime >= e.ev5Time
    bool bos15Ok = not na(e.bos5mTime) and not na(e.ev15Time) and e.bos5mTime >= e.ev15Time
    //   Short は Bearish BOS の時刻で、まったく同じ順序判定を行う。
    bool bos5OkS  = not na(e.bos1mTimeS) and not na(e.ev5Time)  and e.bos1mTimeS >= e.ev5Time
    bool bos15OkS = not na(e.bos5mTimeS) and not na(e.ev15Time) and e.bos5mTimeS >= e.ev15Time

    // ---- (4) Signal (Long / Short 完全対称) --------------------------------
    //   abs*Bias ==  1 : Bearish FVG を上方向へ吸収したイベントが保持中 → Long
    //   abs*Bias == -1 : Bullish FVG を下方向へ吸収したイベントが保持中 → Short
    //   bias は1つのイベントにつき 1 か -1 のどちらか一方なので、
    //   同一TFで Long と Short が同時に成立することはない。
    //   consumed : 実際にEntryできた eventId だけを Main が consumeFvgAbs で通知する。
    //     → Signalを返しただけでは消費しない。Zone Plan FAIL なら次のチャンスを待てる。
    //     イベントは方向を1つしか持たないので、消費フラグも方向別に分ける必要がない。
    bool unused5  = na(e.ev5Consumed)  or e.ev5Consumed  != e.ev5Id
    bool unused15 = na(e.ev15Consumed) or e.ev15Consumed != e.ev15Id
    bool l5 = use5 and envLongOk and barstate.isconfirmed and abs5Bias == 1 and
     not na(e.ev5Id) and unused5 and bos5Ok
    bool l15 = use15 and envLongOk and barstate.isconfirmed and abs15Bias == 1 and
     not na(e.ev15Id) and unused15 and bos15Ok
    bool s5 = use5 and envShortOk and barstate.isconfirmed and abs5Bias == -1 and
     not na(e.ev5Id) and unused5 and bos5OkS
    bool s15 = use15 and envShortOk and barstate.isconfirmed and abs15Bias == -1 and
     not na(e.ev15Id) and unused15 and bos15OkS

    // ---- (5) Preview Signal (仮アラート専用) -------------------------------
    //   確定足条件 (barstate.isconfirmed) だけを外した同じ式。
    //   ★ Abs15 : 確定側は (2) で barstate.isconfirmed のときだけ e.bos5mTime を
    //     記録するため、形成中5M足のBOSは確定側には乗らない。Preview では
    //     「今この価格のまま確定すれば close > bos5Hi で BOS成立」という状態を
    //     その場限りのローカル値 pvBos5mTime として評価する。
    //     Engine state (e.bos5mTime) は書き換えない = 確定判定は一切変わらない。
    //     例) 5分足 03:20-03:25 / 03:23 に条件成立 → PROVISIONAL
    //         03:25 に同じ状態で確定 → 実Entry → CONFIRMED
    //   ★ Abs5 : 1M BOS は下位足の確定足で見ており e.bos1mTime は形成中5M足でも
    //     更新されるため、Preview と確定で同じ bos5Ok を使えば足りる。
    int  pvBos5mTime = close > bos5Hi ? time : e.bos5mTime
    bool pvBos15Ok = not na(pvBos5mTime) and not na(e.ev15Time) and pvBos5mTime >= e.ev15Time
    bool pv5 = use5 and envLongOk and abs5Bias == 1 and
     not na(e.ev5Id) and unused5 and bos5Ok
    bool pv15 = use15 and envLongOk and abs15Bias == 1 and
     not na(e.ev15Id) and unused15 and pvBos15Ok
    int  pvBos5mTimeS = close < bos5Lo ? time : e.bos5mTimeS
    bool pvBos15OkS = not na(pvBos5mTimeS) and not na(e.ev15Time) and pvBos5mTimeS >= e.ev15Time
    bool pvS5 = use5 and envShortOk and abs5Bias == -1 and
     not na(e.ev5Id) and unused5 and bos5OkS
    bool pvS15 = use15 and envShortOk and abs15Bias == -1 and
     not na(e.ev15Id) and unused15 and pvBos15OkS

    FvgAbsSignal.new(long5 = l5, long15 = l15, short5 = s5, short15 = s15,
         entryPrice = entryPrice,
         previewLong5 = pv5, previewLong15 = pv15,
         previewShort5 = pvS5, previewShort15 = pvS15)

// @function  FVG吸収系列の環境条件を判定する (Long)。
//   共通フィルタは「結果」を受け取るだけ (再計算も request も増やさない)。
//     上位足環境 : ★ 既存 Trend Env (useEnvFilter / reqTrend4H / 1H / 15M / 5M / 1M /
//                  必要一致TF数) の判定結果 trendEnvOk をそのまま受け取る。
//                  吸収系列専用の固定条件 (旧: 4H/1H/15M が3つとも上昇) は廃止した。
//                  判定そのものは updateFvg() が1度だけ行い、FvgSignal.trendOk として
//                  公開している値を使う → 判定の二重実装も request 追加も無い。
//     日足ボラ   : 中央値が [volMin, volMax) の範囲内
//     その他     : Session / News / 通常ボラ / Accum 各種
//   ★ trendEnvOk は Long / Short で共通の「要求する相場環境」。方向による自動反転は
//     一切行わない (Short だから下降へ読み替える、といった処理は入れない)。
// @param allowLong          Long発注が許可されているか (Logic ON/OFF × enableLong)
// @param trendEnvOk         既存 Trend Env の判定結果 (FvgSignal.trendOk)
// @param sessionOk          時間帯フィルタ
// @param newsOk             指標時間フィルタ
// @param drMedianRange      日足Range中央値
// @param volMin             日足ボラ 下限 (以上)
// @param volMax             日足ボラ 上限 (未満)
// @param volOk              通常ボラフィルタの結果
// @param blockedByAccum     Accumulation NoTrade
// @param blockedByExitWait  Accum離脱待機
// @param accumLongDirOk     Accum離脱方向 (Long)
// @returns  bool
export fvgAbsEnvLong(bool allowLong, bool trendEnvOk, bool sessionOk, bool newsOk,
     float drMedianRange, float volMin, float volMax,
     bool volOk, bool blockedByAccum, bool blockedByExitWait, bool accumLongDirOk) =>
    bool _dailyVolOk = not na(drMedianRange) and drMedianRange >= volMin and drMedianRange < volMax
    allowLong and
     trendEnvOk and
     _dailyVolOk and sessionOk and newsOk and
     volOk and not blockedByAccum and not blockedByExitWait and
     accumLongDirOk

// @function  FVG吸収系列の環境条件を判定する (Short)。
//   fvgAbsEnvLong と同じ式。方向に依存するのは Accum離脱方向だけ:
//     Accum : accumShortDirOk  (Long は accumLongDirOk)
//   ★ 上位足環境 trendEnvOk は Long と同じ値をそのまま使う。
//     「Short だから 上昇 → 下降 へ読み替える」といった自動反転は行わない。
//     reqTrend で "レンジ" を要求していれば Long も Short もレンジを要求する。
//   日足ボラ / Session / News / 通常ボラ / Accum NoTrade / 離脱待機も Long と共通。
// @param allowShort         Short発注が許可されているか (Logic ON/OFF × enableShort)
// @param trendEnvOk         既存 Trend Env の判定結果 (FvgSignal.trendOk)
// @param sessionOk          時間帯フィルタ
// @param newsOk             指標時間フィルタ
// @param drMedianRange      日足Range中央値
// @param volMin             日足ボラ 下限 (以上)
// @param volMax             日足ボラ 上限 (未満)
// @param volOk              通常ボラフィルタの結果
// @param blockedByAccum     Accumulation NoTrade
// @param blockedByExitWait  Accum離脱待機
// @param accumShortDirOk    Accum離脱方向 (Short)
// @returns  bool
export fvgAbsEnvShort(bool allowShort, bool trendEnvOk, bool sessionOk, bool newsOk,
     float drMedianRange, float volMin, float volMax,
     bool volOk, bool blockedByAccum, bool blockedByExitWait, bool accumShortDirOk) =>
    bool _dailyVolOk = not na(drMedianRange) and drMedianRange >= volMin and drMedianRange < volMax
    allowShort and
     trendEnvOk and
     _dailyVolOk and sessionOk and newsOk and
     volOk and not blockedByAccum and not blockedByExitWait and
     accumShortDirOk

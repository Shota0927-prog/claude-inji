//@version=6
// ============================================================
// ZoneEngineV2_W08MergeSplitTouchConformanceHarness - W08 B17 Merge / Split / TouchMark / Pending conformance TV probe
//
// Short deterministic fixtures. Production authority = published exports only: W08Runtime /4 runShadow (pass 1: the old
// Cores are allocated by the real materialization), W08Touch /3 markAppend (the old TouchMark rings; ring overflow sets
// the truncated flag through the real append), W08Runtime /4 planPass / preflightPass / commitPass (pass 2), then the
// W08Core Merge / Split relations, the W08Touch Merge / Split plans, the planned PendingTopology pool, the apply set, the
// Default Guard and the post-commit rings are read. Two fixture inputs have no W08 producer and are set directly (read
// only by the planner): an old Side phase = ActiveTouch (Pending case) and one Merge-deferred field != default (Guard
// case, sideTouchCounts; the W09 Merge Side state transfer stays OPEN).
// Reference (fixture only, no Production plan / ring read): per old Core the retained ring = its last `cap` appended
// marks, a Side truncated when a mark of that Side was lost; Merge: survivor first, then absorbed in old canonical order,
// each source chronological; a mark is inherited when its exact contact meets the new Side EffectiveRange (inclusive); one
// mark per (Side, time, contact bottom, contact top) = the first in that source order, payload whole; final order time,
// baseSeq, Support < Resistance, contact bottom, contact top; above the ring capacity the oldest rows drop and truncate
// their Side; truncated also = a source flag of that Side (target has the Side). Split: every non-Merge child gets, in
// source order, the marks whose contact meets its Side EffectiveRange (untouched child allowed), truncated per Side =
// child has the Side and the source Side flag. Pending: a component with an old Side in ActiveTouch is not applied and
// every old of it is pending with its latest children (Identity Candidates' Root unions).
// B17_CONFORMANCE_PASS = 1 only when every case passes.
// W09 B06-B2C-C1: the fixture marks carry the three TouchMark Episode fields (touchNo, weakByDepth, maxDepthPct; defaults
// 0 / false / 0.0 in the six cases, unchanged). The C1 episode subcases (outside the six) give them non-default values and
// check that every post-commit ring row holds the 11-field payload of its Reference mark (Merge representative row,
// Split assignment, cap / truncation drop).
// ============================================================
indicator("ZoneEngineV2_W08MergeSplitTouchConformanceHarness", overlay = false)

import sekine3310/ZoneEngineV2_W08Core_Worker/18 as W08Core
import sekine3310/ZoneEngineV2_W08Touch_Worker/4 as W08Touch
import sekine3310/ZoneEngineV2_W08Runtime_Worker/12 as W08Runtime

const int SLOT_INVALID    = -1
const int CAT_SWING       = 1
const int ROOT_ACTIVE     = 1
const int PH_ACTIVE_TOUCH = 2
const int SIDE_S          = 1
const int SIDE_R          = -1

type Win
    array<int>   sides
    array<int>   bots
    array<int>   tops
    array<float> exact
    array<int>   offs
    array<int>   lens
    array<int>   roots

// fixture TouchMarks in append order (owner = old coreId after pass 1)
type Mk
    array<int>   owner
    array<int>   side
    array<int>   t
    array<float> b
    array<float> u
    array<int>   seq
    array<float> c
    array<int>   g
    array<int>   no
    array<bool>  wd
    array<float> md

newWin() =>
    Win.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_int(0), array.new_int(0), array.new_int(0))
addW(Win w, int side, int bot, int top, array<int> rs) =>
    array.push(w.sides, side)
    array.push(w.bots, bot)
    array.push(w.tops, top)
    array.push(w.exact, bot * 1.0)
    array.push(w.exact, top * 1.0)
    array.push(w.offs, array.size(w.roots))
    array.push(w.lens, array.size(rs))
    int i = 0
    while i < array.size(rs)
        array.push(w.roots, array.get(rs, i))
        i += 1
    w
newMk() =>
    Mk.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_float(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_float(0))
addM(Mk m, int owner, int side, int t, float b, float u, int seq, float c, int g) =>
    array.push(m.owner, owner)
    array.push(m.side, side)
    array.push(m.t, t)
    array.push(m.b, b)
    array.push(m.u, u)
    array.push(m.seq, seq)
    array.push(m.c, c)
    array.push(m.g, g)
    array.push(m.no, 0)
    array.push(m.wd, false)
    array.push(m.md, 0.0)
    m
// Episode fields of the last added mark (C1 episode subcases)
setEp(Mk m, int no, bool wd, float md) =>
    int i = array.size(m.no) - 1
    array.set(m.no, i, no)
    array.set(m.wd, i, wd)
    array.set(m.md, i, md)
    m

// ---- Reference (fixture only) ----
// retained ring of an old Core: its last cap appended marks; [indexes, truncated S, truncated R]
retained(Mk m, int owner, int cap) =>
    array<int> all = array.new_int(0)
    int i = 0
    while i < array.size(m.owner)
        if array.get(m.owner, i) == owner
            array.push(all, i)
        i += 1
    int lost = math.max(0, array.size(all) - cap)
    bool trS = false
    bool trR = false
    array<int> keep = array.new_int(0)
    int k = 0
    while k < array.size(all)
        int x = array.get(all, k)
        if k < lost
            trS := trS or array.get(m.side, x) == SIDE_S
            trR := trR or array.get(m.side, x) == SIDE_R
        else
            array.push(keep, x)
        k += 1
    [keep, trS, trR]

// diagnostics: the Reference retained ring of an old Core packed as the historyExtract snapshot
// (S * 1000 + R * 100 + truncS * 10 + truncR)
refPack(Mk m, int owner, int cap) =>
    [idx, tS, tR] = retained(m, owner, cap)
    int nS = 0
    int nR = 0
    int k = 0
    while k < array.size(idx)
        nS += array.get(m.side, array.get(idx, k)) == SIDE_S ? 1 : 0
        nR += array.get(m.side, array.get(idx, k)) == SIDE_R ? 1 : 0
        k += 1
    float v = nS * 1000 + nR * 100 + (tS ? 10 : 0) + (tR ? 1 : 0)
    v

meets(Mk m, int x, float lo, float hi) =>
    array.get(m.b, x) <= hi and array.get(m.u, x) >= lo

// canonical Merge order key compare (time, baseSeq, Support < Resistance, bottom, top)
mkCmp(Mk m, int x, int y) =>
    int c = array.get(m.t, x) - array.get(m.t, y)
    if c == 0
        c := array.get(m.seq, x) - array.get(m.seq, y)
    if c == 0
        c := (array.get(m.side, x) == SIDE_S ? 0 : 1) - (array.get(m.side, y) == SIDE_S ? 0 : 1)
    if c == 0
        c := array.get(m.b, x) < array.get(m.b, y) ? -1 : array.get(m.b, x) > array.get(m.b, y) ? 1 : array.get(m.u, x) < array.get(m.u, y) ? -1 : array.get(m.u, x) > array.get(m.u, y) ? 1 : 0
    c

// Merge Reference: sources = coreIds in priority order; ranges per Side (has = false: no winner on that Side)
refMerge(Mk m, array<int> srcIds, bool hasS, float sLo, float sHi, bool hasR, float rLo, float rHi, int cap) =>
    array<int> kept = array.new_int(0)
    bool trS = false
    bool trR = false
    int sd = 0
    while sd < 2
        bool has  = sd == 0 ? hasS : hasR
        int  side = sd == 0 ? SIDE_S : SIDE_R
        if has
            int s = 0
            while s < array.size(srcIds)
                [idx, tS, tR] = retained(m, array.get(srcIds, s), cap)
                if sd == 0
                    trS := trS or tS
                else
                    trR := trR or tR
                int k = 0
                while k < array.size(idx)
                    int x = array.get(idx, k)
                    if array.get(m.side, x) == side and meets(m, x, sd == 0 ? sLo : rLo, sd == 0 ? sHi : rHi)
                        bool dup = false
                        int q = 0
                        while not dup and q < array.size(kept)
                            int y = array.get(kept, q)
                            dup := array.get(m.side, y) == side and array.get(m.t, y) == array.get(m.t, x) and array.get(m.b, y) == array.get(m.b, x) and array.get(m.u, y) == array.get(m.u, x)
                            q += 1
                        if not dup
                            array.push(kept, x)
                    k += 1
                s += 1
        sd += 1
    // canonical order (insertion sort)
    int a = 1
    while a < array.size(kept)
        int x = array.get(kept, a)
        int b = a - 1
        while b >= 0 and mkCmp(m, array.get(kept, b), x) > 0
            array.set(kept, b + 1, array.get(kept, b))
            b -= 1
        array.set(kept, b + 1, x)
        a += 1
    int over = math.max(0, array.size(kept) - cap)
    array<int> rows = array.new_int(0)
    int k2 = 0
    while k2 < array.size(kept)
        int x = array.get(kept, k2)
        if k2 < over
            trS := trS or array.get(m.side, x) == SIDE_S
            trR := trR or array.get(m.side, x) == SIDE_R
        else
            array.push(rows, x)
        k2 += 1
    [rows, trS, trR]

// Split Reference for one child: source marks (retained, append order) meeting the child's Side EffectiveRange
refSplit(Mk m, int srcId, bool hasS, float sLo, float sHi, bool hasR, float rLo, float rHi, int cap) =>
    [idx, tS, tR] = retained(m, srcId, cap)
    array<int> rows = array.new_int(0)
    int k = 0
    while k < array.size(idx)
        int x = array.get(idx, k)
        bool isS = array.get(m.side, x) == SIDE_S
        if isS ? (hasS and meets(m, x, sLo, sHi)) : (hasR and meets(m, x, rLo, rHi))
            array.push(rows, x)
        k += 1
    [rows, hasS and tS, hasR and tR]

// ---- Production (published exports only) ----
toView(Win w, bool reverseBacking) =>
    int n = array.size(w.sides)
    array<int> offs  = array.new_int(n, 0)
    array<int> roots = array.new_int(0)
    int k = 0
    while k < n
        int i = reverseBacking ? n - 1 - k : k
        array.set(offs, i, array.size(roots))
        int j = 0
        while j < array.get(w.lens, i)
            array.push(roots, array.get(w.roots, array.get(w.offs, i) + j))
            j += 1
        k += 1
    array<int> mins = array.new_int(0)
    k := 0
    while k < n
        array.push(mins, array.get(w.roots, array.get(w.offs, k)))
        k += 1
    W08Runtime.WinnerView.new(n, array.size(roots), array.copy(w.sides), array.new_int(n, 1), array.copy(w.bots), array.copy(w.tops), mins, array.new_int(n, 0), array.new_int(n, int(na)), array.copy(w.exact), offs, array.copy(w.lens), roots)

ringView(W08Core.CoreRegistryStore cr) =>
    W08Touch.TouchRing.new(cr.touchMarkRingOwnerCoreIds, cr.touchMarkRingHeads, cr.touchMarkRingCounts, cr.touchMarkBaseSeqs, cr.touchMarkTimes, cr.touchMarkSides, cr.touchMarkContactBottoms, cr.touchMarkContactTops, cr.touchMarkCloseAtTouches, cr.touchMarkGenerationIds, cr.touchMarkIsNormalTouchFlags, cr.sideTouchHistoryTruncatedFlags, cr.coreIds, cr.coreSlotLiveFlags, cr.touchMarkCapacityPerCore, cr.touchMarkTouchNos, cr.touchMarkWeakByDepthFlags, cr.touchMarkMaxDepthPcts)

// ---- B17 TV runtime diagnostics (read only; no PASS / fixture / Reference change) ----
// dg layout (scalar snapshots taken at the stage named, never re-read from a later scratch state):
const int D_OK1       = 0   // pass 1 committed (1 / 0)
const int D_PRE1      = 1   // pre-plan historyExtract of coreId 1: S * 1000 + R * 100 + truncS * 10 + truncR (-1 not readable)
const int D_PRE2      = 2   // same for coreId 2
const int D_PLANRES   = 3   // planPass planResult (right after planPass)
const int D_MREL      = 4   // ws.mergeRelationCount (after planPass)
const int D_SREL      = 5   // ws.splitRelationCount (after planPass)
const int D_MPLAN     = 6   // Merge Touch plan relation 0: S * 1000 + R * 100 + truncS * 10 + truncR (-1 no relation-side rows)
const int D_SPLAN0    = 7   // Split Touch plan row of Candidate 0: count * 100 + truncS * 10 + truncR (-1 no row)
const int D_SPLAN1    = 8   // same for Candidate 1
const int D_IDEDGE    = 9   // ws.physicalIdentityEdgeCount
const int D_PFLAG     = 10  // planned pool (ctx.psPlan) pending flags set
const int D_PPARENT   = 11  // planned pending parents (flag and live Core)
const int D_PCHILD    = 12  // planned pending children (sum over parents)
const int D_PROOT     = 13  // planned pending Root nodes (sum over children)
const int D_READY     = 14  // consumed READY parents (pass.consumedSlots)
const int D_APPLY     = 15  // applied Candidates (pass.applyP true)
const int D_COMPS     = 16  // pass.pendingComponents * 100 + pass.appliedComponents
const int D_PHS       = 17  // fixture write check: cr.sidePhases Support of the active Core (-1 none)
const int D_PHR       = 18  // Resistance
const int D_DEFER     = 19  // fixture write check: cr.sideTouchCounts Support of the non-default Core (-1 none)
const int D_PRE       = 20  // preflightPass result (-1 not called)
const int D_GUARD     = 21  // pass.guardRejected after preflightPass
const int D_COMMITCALL = 22 // commitPass called (1 / 0)
const int D_COMMITTED = 23  // pass.committed
const int D_FREED     = 24  // pass.freed
const int D_POST1     = 25  // post-run historyExtract of coreId 1 (packed as D_PRE1, -1 not readable)
const int D_POST2     = 26  // post-run historyExtract of coreId 2
const int D_MUTRING   = 27  // persistent ring rows / heads / counts / truncated flags changed between planPass start and the end
const int D_MUTCORE   = 28  // persistent Core ids / live flags / physical ranges changed
const int D_MUTPEND   = 29  // persistent pending flags changed
const int D_SIZE      = 30

b2f(bool b) =>
    b ? 1.0 : 0.0

// historyExtract (the published export) of both Sides of coreId: S * 1000 + R * 100 + truncS * 10 + truncR; -1 when the
// Core is not live or an extraction fails
hxPack(W08Core.CoreRegistryStore cr, W08Touch.TouchRing ring, int coreId) =>
    float v = -1.0
    if map.contains(cr.coreIdToSlot, coreId)
        int slot = map.get(cr.coreIdToSlot, coreId)
        array<int>   tt = array.new_int(0)
        array<float> tb = array.new_float(0)
        array<float> tu = array.new_float(0)
        array<int>   ti = array.new_int(0)
        [nS, trS] = W08Touch.historyExtract(ring, slot, coreId, SIDE_S, tt, tb, tu, ti)
        [nR, trR] = W08Touch.historyExtract(ring, slot, coreId, SIDE_R, tt, tb, tu, ti)
        if nS >= 0 and nR >= 0
            v := nS * 1000 + nR * 100 + b2f(trS) * 10 + b2f(trR)
    v

intDiff(array<int> a, array<int> b) =>
    int n = math.min(array.size(a), array.size(b))
    int d = math.abs(array.size(a) - array.size(b))
    int i = 0
    while i < n
        int x = array.get(a, i)
        int y = array.get(b, i)
        d += (na(x) and na(y)) or x == y ? 0 : 1
        i += 1
    d
floatDiff(array<float> a, array<float> b) =>
    int n = math.min(array.size(a), array.size(b))
    int d = math.abs(array.size(a) - array.size(b))
    int i = 0
    while i < n
        float x = array.get(a, i)
        float y = array.get(b, i)
        d += (na(x) and na(y)) or x == y ? 0 : 1
        i += 1
    d
boolDiff(array<bool> a, array<bool> b) =>
    int n = math.min(array.size(a), array.size(b))
    int d = math.abs(array.size(a) - array.size(b))
    int i = 0
    while i < n
        d += array.get(a, i) == array.get(b, i) ? 0 : 1
        i += 1
    d

// Split Touch plan row of Candidate p right after planPass: count * 100 + truncS * 10 + truncR (-1 no row)
splitPack(W08Touch.SplitTouchPlan sp, int p) =>
    int k = array.indexof(sp.targetPhysicalIndexes, p)
    float v = -1.0
    if k >= 0 and k < array.size(sp.markCounts) and 2 * k + 1 < array.size(sp.truncatedFlags)
        v := array.get(sp.markCounts, k) * 100 + b2f(array.get(sp.truncatedFlags, 2 * k)) * 10 + b2f(array.get(sp.truncatedFlags, 2 * k + 1))
    v

// pass 1 (runShadow w1) -> marks (markAppend) -> fixture phase / deferred input -> pass 2 planPass / preflightPass /
// commitPass (w2). permute: Root slots and winner backing reversed. Returns [ctx, pass, pass1 committed, preflight].
// viaOverlay (W09 B06-B2C-B): the active Side is not written to the persistent Phase; pass 2 plans with it as the current-bar
// ActiveTouch overlay (planPassWithActiveTouchOverlay) instead.
runScn(int nRoots, Win w1, Win w2, Mk mk, int cap, int activeId, int activeSide, int nondefaultId, bool permute, bool viaOverlay = false) =>
    array<int> ids   = array.new_int(nRoots, 0)
    array<int> ticks = array.new_int(nRoots, 0)
    int k = 0
    while k < nRoots
        int slot = permute ? nRoots - 1 - k : k
        array.set(ids, slot, k + 1)
        array.set(ticks, slot, 100 + k)
        k += 1
    map<int, int> idToSlot = map.new<int, int>()
    k := 0
    while k < nRoots
        map.put(idToSlot, array.get(ids, k), k)
        k += 1
    W08Core.W08Store ws = W08Core.newStore()
    W08Core.CoreRegistryStore cr = ws.coreRegistry
    cr.touchMarkCapacityPerCore := cap
    W08Runtime.RootView rv = W08Runtime.RootView.new(rootIds = ids, rootSlotLiveFlags = array.new_bool(nRoots, true), rootIdToSlot = idToSlot, rootCategories = array.new_int(nRoots, CAT_SWING), rootIsBroadFvgFlags = array.new_bool(nRoots, false), rootParticipationHeadEdgeIndexes = array.new_int(nRoots, SLOT_INVALID), rootParticipationCounts = array.new_int(nRoots, 0), rootPriceOrderSlots = array.sort_indices(ticks, order.ascending), rootPointTicks = ticks, rootStates = array.new_int(nRoots, ROOT_ACTIVE), rootDirections = array.new_int(nRoots, 0), rootNativeBottomTicks = array.new_int(nRoots, int(na)), rootNativeTopTicks = array.new_int(nRoots, int(na)))
    W08Runtime.ParticipationView pv = W08Runtime.ParticipationView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Runtime.PhaseSetView hv = W08Runtime.PhaseSetView.new(array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0))
    W08Runtime.ComponentMetaView mv = W08Runtime.ComponentMetaView.new(array.new_int(nRoots, 0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.from(true))
    W08Core.PendingTopologyStore ps = W08Core.PendingTopologyStore.new(cr.corePendingTopologyFlags, cr.corePendingTopologyChildHeadIndexes, cr.corePendingTopologyChildTailIndexes, cr.corePendingTopologyChildCounts, array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0))
    W08Touch.TouchPlan tp = W08Touch.TouchPlan.new(array.new_int(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_int(0), array.new_int(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_int(0), array.new_bool(0), array.new_int(0), array.new_bool(0), array.new_float(0))
    W08Runtime.ShadowScalars sc = W08Runtime.ShadowScalars.new(1, 1, nRoots + 1, 0, false)
    W08Runtime.ShadowContext ctx = W08Runtime.ShadowContext.new(ws, rv, pv, hv, toView(w1, permute), mv, ps, ps, tp, W08Touch.newSplitTouchPlan(), sc, 5.0, 1.0, false)
    W08Runtime.ShadowPass pr1 = W08Runtime.runShadow(ctx, 1000)
    bool ok1 = pr1.committed
    W08Touch.TouchRing ring = ringView(cr)
    int i = 0
    while ok1 and i < array.size(mk.owner)
        int id = array.get(mk.owner, i)
        ok1 := map.contains(cr.coreIdToSlot, id)
        if ok1
            W08Touch.markAppend(ring, map.get(cr.coreIdToSlot, id), array.get(mk.seq, i), array.get(mk.t, i), array.get(mk.side, i), array.get(mk.b, i), array.get(mk.u, i), array.get(mk.c, i), array.get(mk.g, i), true, array.get(mk.no, i), array.get(mk.wd, i), array.get(mk.md, i))
        i += 1
    array<int> ov = array.new_int(0)
    if ok1 and activeId > 0 and map.contains(cr.coreIdToSlot, activeId)
        if viaOverlay
            array.push(ov, 2 * map.get(cr.coreIdToSlot, activeId) + (activeSide == SIDE_S ? 0 : 1))
        else
            array.set(cr.sidePhases, 2 * map.get(cr.coreIdToSlot, activeId) + (activeSide == SIDE_S ? 0 : 1), PH_ACTIVE_TOUCH)
    if ok1 and nondefaultId > 0 and map.contains(cr.coreIdToSlot, nondefaultId)
        array.set(cr.sideTouchCounts, 2 * map.get(cr.coreIdToSlot, nondefaultId), 1)
    // diagnostics: pass 1 / fixture writes / pre-plan historyExtract, then the persistent state snapshot for mutation counts
    array<float> dg = array.new_float(D_SIZE, -1.0)
    array.set(dg, D_OK1, b2f(ok1))
    array.set(dg, D_PRE1, hxPack(cr, ring, 1))
    array.set(dg, D_PRE2, hxPack(cr, ring, 2))
    if activeId > 0 and map.contains(cr.coreIdToSlot, activeId)
        array.set(dg, D_PHS, array.get(cr.sidePhases, 2 * map.get(cr.coreIdToSlot, activeId)))
        array.set(dg, D_PHR, array.get(cr.sidePhases, 2 * map.get(cr.coreIdToSlot, activeId) + 1))
    if nondefaultId > 0 and map.contains(cr.coreIdToSlot, nondefaultId)
        array.set(dg, D_DEFER, array.get(cr.sideTouchCounts, 2 * map.get(cr.coreIdToSlot, nondefaultId)))
    array<int>   s0Cnt  = array.copy(cr.touchMarkRingCounts)
    array<int>   s0Head = array.copy(cr.touchMarkRingHeads)
    array<int>   s0Time = array.copy(cr.touchMarkTimes)
    array<int>   s0Seq  = array.copy(cr.touchMarkBaseSeqs)
    array<float> s0Bot  = array.copy(cr.touchMarkContactBottoms)
    array<bool>  s0Tr   = array.copy(cr.sideTouchHistoryTruncatedFlags)
    array<int>   s0Id   = array.copy(cr.coreIds)
    array<bool>  s0Live = array.copy(cr.coreSlotLiveFlags)
    array<float> s0PB   = array.copy(cr.corePhysicalBottoms)
    array<float> s0PT   = array.copy(cr.corePhysicalTops)
    array<bool>  s0Pend = array.copy(cr.corePendingTopologyFlags)
    ctx.wv := toView(w2, permute)
    W08Runtime.ShadowPass pr = viaOverlay ? W08Runtime.planPassWithActiveTouchOverlay(ctx, ov) : W08Runtime.planPass(ctx)
    // diagnostics: plan scratch snapshot right after planPass (before preflightPass / commitPass)
    array.set(dg, D_PLANRES, pr.planResult)
    array.set(dg, D_MREL, ws.mergeRelationCount)
    array.set(dg, D_SREL, ws.splitRelationCount)
    if array.size(ctx.tp.mergeTouchPlanCounts) >= 2 and array.size(ctx.tp.mergeTouchPlanTruncatedFlags) >= 2
        array.set(dg, D_MPLAN, array.get(ctx.tp.mergeTouchPlanCounts, 0) * 1000 + array.get(ctx.tp.mergeTouchPlanCounts, 1) * 100 + b2f(array.get(ctx.tp.mergeTouchPlanTruncatedFlags, 0)) * 10 + b2f(array.get(ctx.tp.mergeTouchPlanTruncatedFlags, 1)))
    array.set(dg, D_SPLAN0, splitPack(ctx.sp, 0))
    array.set(dg, D_SPLAN1, splitPack(ctx.sp, 1))
    array.set(dg, D_IDEDGE, ws.physicalIdentityEdgeCount)
    int pFlag   = 0
    int pParent = 0
    int pChild  = 0
    int pRoot   = 0
    int ps_ = 0
    while ps_ < array.size(ctx.psPlan.corePendingTopologyFlags)
        if array.get(ctx.psPlan.corePendingTopologyFlags, ps_)
            pFlag += 1
            if ps_ < array.size(cr.coreSlotLiveFlags) and array.get(cr.coreSlotLiveFlags, ps_)
                pParent += 1
                int nc = array.get(ctx.psPlan.corePendingTopologyChildCounts, ps_)
                int ci = array.get(ctx.psPlan.corePendingTopologyChildHeadIndexes, ps_)
                pChild += nc
                int c = 0
                while c < nc and ci >= 0 and ci < array.size(ctx.psPlan.pendingTopologyChildRootCounts)
                    pRoot += array.get(ctx.psPlan.pendingTopologyChildRootCounts, ci)
                    ci := array.get(ctx.psPlan.pendingTopologyChildNextIndexes, ci)
                    c += 1
        ps_ += 1
    array.set(dg, D_PFLAG, pFlag)
    array.set(dg, D_PPARENT, pParent)
    array.set(dg, D_PCHILD, pChild)
    array.set(dg, D_PROOT, pRoot)
    array.set(dg, D_READY, array.size(pr.consumedSlots))
    int nApply = 0
    int ap = 0
    while ap < array.size(pr.applyP)
        nApply += array.get(pr.applyP, ap) ? 1 : 0
        ap += 1
    array.set(dg, D_APPLY, nApply)
    array.set(dg, D_COMPS, pr.pendingComponents * 100 + pr.appliedComponents)
    bool pre = false
    if pr.planResult >= 0
        pre := W08Runtime.preflightPass(ctx, pr, 2000)
        array.set(dg, D_PRE, b2f(pre))
        array.set(dg, D_GUARD, pr.guardRejected)
        array.set(dg, D_COMMITCALL, b2f(pre))
        if pre
            W08Runtime.commitPass(ctx, pr, 2000)
    if pr.planResult < 0
        array.set(dg, D_COMMITCALL, 0.0)
    // diagnostics: post-run state (historyExtract authority) and persistent mutation counts
    array.set(dg, D_COMMITTED, b2f(pr.committed))
    array.set(dg, D_FREED, pr.freed)
    W08Touch.TouchRing ring2 = ringView(cr)
    array.set(dg, D_POST1, hxPack(cr, ring2, 1))
    array.set(dg, D_POST2, hxPack(cr, ring2, 2))
    array.set(dg, D_MUTRING, intDiff(s0Cnt, cr.touchMarkRingCounts) + intDiff(s0Head, cr.touchMarkRingHeads) + intDiff(s0Time, cr.touchMarkTimes) + intDiff(s0Seq, cr.touchMarkBaseSeqs) + floatDiff(s0Bot, cr.touchMarkContactBottoms) + boolDiff(s0Tr, cr.sideTouchHistoryTruncatedFlags))
    array.set(dg, D_MUTCORE, intDiff(s0Id, cr.coreIds) + boolDiff(s0Live, cr.coreSlotLiveFlags) + floatDiff(s0PB, cr.corePhysicalBottoms) + floatDiff(s0PT, cr.corePhysicalTops))
    array.set(dg, D_MUTPEND, boolDiff(s0Pend, cr.corePendingTopologyFlags))
    [ctx, pr, ok1, pre, dg]

// ---- comparisons (Production read after the pass) ----
// Merge plan rows of relation j, Side sd (0 S / 1 R), against the Reference rows of that Side (full payload)
planSideDrift(W08Touch.TouchPlan tp, int j, int sd, Mk m, array<int> rows) =>
    int side = sd == 0 ? SIDE_S : SIDE_R
    array<int> exp = array.new_int(0)
    int k = 0
    while k < array.size(rows)
        if array.get(m.side, array.get(rows, k)) == side
            array.push(exp, array.get(rows, k))
        k += 1
    int d = 0
    if 2 * j + sd >= array.size(tp.mergeTouchPlanOffsets)
        d := 1
    else
        int off = array.get(tp.mergeTouchPlanOffsets, 2 * j + sd)
        int cnt = array.get(tp.mergeTouchPlanCounts, 2 * j + sd)
        d += cnt == array.size(exp) ? 0 : 1
        int q = 0
        while d == 0 and q < cnt
            int x = array.get(exp, q)
            int r = off + q
            d += array.get(tp.mergeTouchPlanTimes, r) == array.get(m.t, x) and array.get(tp.mergeTouchPlanSides, r) == side and array.get(tp.mergeTouchPlanContactBottoms, r) == array.get(m.b, x) and array.get(tp.mergeTouchPlanContactTops, r) == array.get(m.u, x) and array.get(tp.mergeTouchPlanBaseSeqs, r) == array.get(m.seq, x) and array.get(tp.mergeTouchPlanCloseAtTouches, r) == array.get(m.c, x) and array.get(tp.mergeTouchPlanGenerationIds, r) == array.get(m.g, x) ? 0 : 1
            q += 1
    d

// ring of coreId after commit against the expected rows (in order) and truncated flags
ringDrift(W08Core.CoreRegistryStore cr, int coreId, Mk m, array<int> rows, bool trS, bool trR) =>
    int d = 0
    if not map.contains(cr.coreIdToSlot, coreId)
        d := 1
    else
        int slot = map.get(cr.coreIdToSlot, coreId)
        int cap  = cr.touchMarkCapacityPerCore
        int head = array.get(cr.touchMarkRingHeads, slot)
        int cnt  = array.get(cr.touchMarkRingCounts, slot)
        d += cnt == array.size(rows) ? 0 : 1
        int q = 0
        while d == 0 and q < cnt
            int ph = slot * cap + (head + q) % cap
            int x  = array.get(rows, q)
            d += array.get(cr.touchMarkTimes, ph) == array.get(m.t, x) and array.get(cr.touchMarkSides, ph) == array.get(m.side, x) and array.get(cr.touchMarkContactBottoms, ph) == array.get(m.b, x) and array.get(cr.touchMarkContactTops, ph) == array.get(m.u, x) and array.get(cr.touchMarkBaseSeqs, ph) == array.get(m.seq, x) and array.get(cr.touchMarkGenerationIds, ph) == array.get(m.g, x) ? 0 : 1
            q += 1
        d += array.get(cr.sideTouchHistoryTruncatedFlags, 2 * slot) == trS and array.get(cr.sideTouchHistoryTruncatedFlags, 2 * slot + 1) == trR ? 0 : 1
    d

// C1: the Episode fields (touchNo, weakByDepth, maxDepthPct) of every ring row of coreId against its Reference mark
// (rows in ring order), plus the row count
epRingDrift(W08Core.CoreRegistryStore cr, int coreId, Mk m, array<int> rows) =>
    int d = 0
    if not map.contains(cr.coreIdToSlot, coreId)
        d := 1
    else
        int slot = map.get(cr.coreIdToSlot, coreId)
        int cap  = cr.touchMarkCapacityPerCore
        int head = array.get(cr.touchMarkRingHeads, slot)
        int cnt  = array.get(cr.touchMarkRingCounts, slot)
        d += cnt == array.size(rows) and cnt > 0 ? 0 : 1
        int q = 0
        while d == 0 and q < cnt
            int ph = slot * cap + (head + q) % cap
            int x  = array.get(rows, q)
            d += array.get(cr.touchMarkTouchNos, ph) == array.get(m.no, x) and array.get(cr.touchMarkWeakByDepthFlags, ph) == array.get(m.wd, x) and array.get(cr.touchMarkMaxDepthPcts, ph) == array.get(m.md, x) and array.get(cr.touchMarkCloseAtTouches, ph) == array.get(m.c, x) and array.get(cr.touchMarkIsNormalTouchFlags, ph) ? 0 : 1
            q += 1
    d

// Split plan row of Candidate p against the Reference rows / flags
splitRowDrift(W08Touch.SplitTouchPlan sp, int p, int srcId, Mk m, array<int> rows, bool trS, bool trR) =>
    int k = array.indexof(sp.targetPhysicalIndexes, p)
    int d = 0
    if k < 0
        d := 1
    else
        int off = array.get(sp.markOffsets, k)
        int cnt = array.get(sp.markCounts, k)
        d += array.get(sp.sourceOldCoreIds, k) == srcId and cnt == array.size(rows) ? 0 : 1
        int q = 0
        while d == 0 and q < cnt
            int x = array.get(rows, q)
            int r = off + q
            d += array.get(sp.times, r) == array.get(m.t, x) and array.get(sp.sides, r) == array.get(m.side, x) and array.get(sp.contactBottoms, r) == array.get(m.b, x) and array.get(sp.contactTops, r) == array.get(m.u, x) and array.get(sp.baseSeqs, r) == array.get(m.seq, x) and array.get(sp.generationIds, r) == array.get(m.g, x) ? 0 : 1
            q += 1
        d += array.get(sp.truncatedFlags, 2 * k) == trS and array.get(sp.truncatedFlags, 2 * k + 1) == trR ? 0 : 1
    d

// Merge relation j: Candidate p, survivor id, absorbed ids
mergeRelDrift(W08Core.W08Store ws, int j, int p, int survivorId, array<int> absorbedIds) =>
    int d = 0
    if 5 * j + 4 >= array.size(ws.mergeRelations)
        d := 1
    else
        int off = array.get(ws.mergeRelations, 5 * j + 3)
        int cnt = array.get(ws.mergeRelations, 5 * j + 4)
        d += array.get(ws.mergeRelations, 5 * j) == p and array.get(ws.mergeRelations, 5 * j + 2) == survivorId and cnt == array.size(absorbedIds) ? 0 : 1
        int q = 0
        while d == 0 and q < cnt
            d += array.get(ws.mergeAbsorbed, 2 * (off + q) + 1) == array.get(absorbedIds, q) ? 0 : 1
            q += 1
    d

// planned pending of coreId: flag and the Root list of its single child
pendingDrift(W08Core.PendingTopologyStore ps, W08Core.CoreRegistryStore cr, int coreId, bool flag, array<int> childRoots) =>
    int d = 0
    if not map.contains(cr.coreIdToSlot, coreId)
        d := 1
    else
        int slot = map.get(cr.coreIdToSlot, coreId)
        bool f = array.get(ps.corePendingTopologyFlags, slot)
        d += f == flag ? 0 : 1
        if d == 0 and flag
            int ci = array.get(ps.corePendingTopologyChildHeadIndexes, slot)
            d += array.get(ps.corePendingTopologyChildCounts, slot) == 1 and ci >= 0 ? 0 : 1
            if d == 0
                int rn = array.get(ps.pendingTopologyChildRootHeadNodeIndexes, ci)
                d += array.get(ps.pendingTopologyChildRootCounts, ci) == array.size(childRoots) ? 0 : 1
                int q = 0
                while d == 0 and q < array.size(childRoots)
                    d += array.get(ps.pendingTopologyRootNodeRootIds, rn) == array.get(childRoots, q) ? 0 : 1
                    rn := array.get(ps.pendingTopologyRootNodeNextIndexes, rn)
                    q += 1
    d

// ---- fixtures ----
// Merge: K1 = S{1} [100, 104], K2 = S{2} [106, 110] (pass 1, coreId 1 / 2) -> S{1, 2} [100, 110]: survivor K1, absorbed K2
mergeMarks() =>
    Mk m = newMk()
    addM(m, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5)
    addM(m, 1, SIDE_S, 1002, 120.0, 121.0, 1, 120.5, 5)
    addM(m, 2, SIDE_S, 1000, 101.0, 102.0, 2, 101.7, 7)
    addM(m, 2, SIDE_S, 1001, 110.0, 112.0, 1, 111.0, 7)
    addM(m, 2, SIDE_R, 1003, 101.0, 102.0, 1, 101.5, 7)
    m
mergeW1() =>
    addW(addW(newWin(), SIDE_S, 100, 104, array.from(1)), SIDE_S, 106, 110, array.from(2))
mergeW2() =>
    addW(newWin(), SIDE_S, 100, 110, array.from(1, 2))

// result of one Merge case run: [mergeDrift, touchDrift, pendingDrift]
mergeCase(Win w2, Mk m, int cap, bool hasR, int activeId, int nondefaultId, bool permute, bool viaOverlay = false) =>
    [ctx, pr, ok1, pre, dg] = runScn(2, mergeW1(), w2, m, cap, activeId, SIDE_S, nondefaultId, permute, viaOverlay)
    W08Core.W08Store ws = ctx.ws
    W08Core.CoreRegistryStore cr = ws.coreRegistry
    [rows, trS, trR] = refMerge(m, array.from(1, 2), true, 100.0, 110.0, hasR, 100.0, 110.0, cap)
    int md = (ok1 ? 0 : 1) + mergeRelDrift(ws, 0, 0, 1, array.from(2))
    int td = planSideDrift(ctx.tp, 0, 0, m, rows) + planSideDrift(ctx.tp, 0, 1, m, rows)
    td += array.size(ctx.tp.mergeTouchPlanTruncatedFlags) >= 2 and array.get(ctx.tp.mergeTouchPlanTruncatedFlags, 0) == trS and array.get(ctx.tp.mergeTouchPlanTruncatedFlags, 1) == trR ? 0 : 1
    int pd = 0
    bool applied = array.size(pr.applyP) >= 1 and array.get(pr.applyP, 0)
    if activeId > 0
        // pending: not applied, both olds pending with the latest child S{1, 2}, rings untouched, nothing freed
        pd += applied ? 1 : 0
        pd += pendingDrift(ctx.psPlan, cr, 1, true, array.from(1, 2)) + pendingDrift(ctx.psPlan, cr, 2, true, array.from(1, 2))
        pd += map.contains(cr.coreIdToSlot, 2) ? 0 : 1
    else if nondefaultId > 0
        // Default Guard: the absorbed K2 holds a non-default deferred field -> preflight rejects, nothing committed
        pd += not pre and pr.guardRejected == 1 and not pr.committed and map.contains(cr.coreIdToSlot, 2) ? 0 : 1
    else
        pd += applied and pre and pr.committed and pr.freed == 1 and not map.contains(cr.coreIdToSlot, 2) ? 0 : 1
        pd += pendingDrift(ctx.psPlan, cr, 1, false, array.new_int(0))
        td += ringDrift(cr, 1, m, rows, trS, trR)
    // diagnostics only (the case result above is unchanged): the first stage whose comparison disagrees
    // 1 pass 1 / topology, 2 pre-plan historyExtract vs the Reference retained ring, 3 Touch plan (snapshot counts / flags
    // and the existing row comparison), 4 Pending plan / apply set, 5 preflight / Guard, 6 commit, 7 post historyExtract,
    // 8 aggregation only
    int stage = 0
    if md > 0
        stage := 1
    if stage == 0
        stage := dg.get(D_PRE1) != refPack(m, 1, cap) or dg.get(D_PRE2) != refPack(m, 2, cap) ? 2 : 0
    if stage == 0
        int eS = 0
        int eR = 0
        int k = 0
        while k < array.size(rows)
            eS += array.get(m.side, array.get(rows, k)) == SIDE_S ? 1 : 0
            eR += array.get(m.side, array.get(rows, k)) == SIDE_R ? 1 : 0
            k += 1
        float ePlan = eS * 1000 + eR * 100 + b2f(trS) * 10 + b2f(trR)
        int rowDrift = planSideDrift(ctx.tp, 0, 0, m, rows) + planSideDrift(ctx.tp, 0, 1, m, rows)
        stage := dg.get(D_MPLAN) != ePlan or rowDrift > 0 ? 3 : 0
    if stage == 0
        if activeId > 0
            stage := applied or pendingDrift(ctx.psPlan, cr, 1, true, array.from(1, 2)) + pendingDrift(ctx.psPlan, cr, 2, true, array.from(1, 2)) > 0 ? 4 : 0
        else
            stage := dg.get(D_PLANRES) < 0 or not applied or pendingDrift(ctx.psPlan, cr, 1, false, array.new_int(0)) > 0 ? 4 : 0
    if stage == 0
        if nondefaultId > 0
            stage := pre or pr.guardRejected != 1 ? 5 : 0
        else
            stage := not pre ? 5 : 0
    if stage == 0
        if activeId > 0 or nondefaultId > 0
            stage := pr.committed and nondefaultId > 0 or not map.contains(cr.coreIdToSlot, 2) ? 6 : 0
        else
            stage := not pr.committed or pr.freed != 1 or map.contains(cr.coreIdToSlot, 2) ? 6 : 0
    if stage == 0
        if activeId > 0 or nondefaultId > 0
            stage := dg.get(D_POST1) != dg.get(D_PRE1) or dg.get(D_POST2) != dg.get(D_PRE2) or dg.get(D_MUTRING) != 0 ? 7 : 0
        else
            stage := ringDrift(cr, 1, m, rows, trS, trR) > 0 ? 7 : 0
    if stage == 0 and md + td + pd > 0
        stage := 8
    [md, td, pd, dg, stage]

// diagnostics packing: two historyExtract snapshots (S * 1000 + R * 100 + truncS * 10 + truncR) of coreId 1 / 2 ->
// K1_S * 1000 + K1_R * 100 + K2_S * 10 + K2_R (counts) and K1truncS * 1000 + K1truncR * 100 + K2truncS * 10 + K2truncR
cnt4(float a, float b) =>
    a < 0 or b < 0 ? -1.0 : math.floor(a / 1000) * 1000 + math.floor((a % 1000) / 100) * 100 + math.floor(b / 1000) * 10 + math.floor((b % 1000) / 100)
tr4(float a, float b) =>
    a < 0 or b < 0 ? -1.0 : (a % 100) * 100 + (b % 100)

var array<float> dx = array.new_float(56, na)
var array<float> res = array.new_float(8, na)
var float mergeTotal = na
var float splitTotal = na
var float touchTotal = na
var float pendTotal  = na
var float passAll    = na
var float passed     = na
var float ovPass     = na
var float ovDrift    = na
var float epPass     = na
var float epDrift    = na

if barstate.isfirst
    int mT = 0
    int sT = 0
    int tT = 0
    int pT = 0
    // C1 MERGE: dedupe (survivor K1 payload), outside-range drop, boundary inherit, no R winner -> R mark not inherited
    Mk m1 = mergeMarks()
    [a1, a2, a3, aDg, aSt] = mergeCase(mergeW2(), m1, 4, false, 0, 0, false)
    array.set(res, 0, a1 + a2 + a3 == 0 ? 1.0 : 0.0)
    // C2 MERGE_OVERFLOW: cap 3, S{1, 2} + R{1} paired; 3 S + 1 R rows -> oldest S dropped, Support only truncated
    Mk m2 = newMk()
    addM(m2, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5)
    addM(m2, 1, SIDE_S, 1002, 102.0, 103.0, 1, 102.5, 5)
    addM(m2, 2, SIDE_S, 1001, 107.0, 108.0, 1, 107.5, 7)
    addM(m2, 2, SIDE_R, 1005, 105.0, 106.0, 1, 105.5, 7)
    Win w22 = addW(mergeW2(), SIDE_R, 100, 110, array.from(1))
    [b1, b2, b3, bDg, bSt] = mergeCase(w22, m2, 3, true, 0, 0, false)
    array.set(res, 1, b1 + b2 + b3 == 0 ? 1.0 : 0.0)
    // C3 SPLIT: K1 = S{1, 2} [100, 110], cap 3, 4 marks (the oldest S is overwritten -> source S truncated) ->
    // P0 S{1} [100, 103] (continuation), P1 S{2} [107, 110] (fresh): contact 102-108 to both, R mark to none, 104-106 to none
    Mk m3 = newMk()
    addM(m3, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5)
    addM(m3, 1, SIDE_S, 1001, 102.0, 108.0, 2, 105.0, 5)
    addM(m3, 1, SIDE_R, 1002, 101.0, 102.0, 3, 101.5, 5)
    addM(m3, 1, SIDE_S, 1003, 104.0, 106.0, 4, 105.0, 5)
    Win w31 = addW(newWin(), SIDE_S, 100, 110, array.from(1, 2))
    Win w32 = addW(addW(newWin(), SIDE_S, 100, 103, array.from(1)), SIDE_S, 107, 110, array.from(2))
    [ctx3, pr3, ok3, pre3, dg3] = runScn(2, w31, w32, m3, 3, 0, SIDE_S, 0, false)
    W08Core.W08Store ws3 = ctx3.ws
    int sd3 = (ok3 ? 0 : 1) + (ws3.splitRelationCount == 1 and array.size(ws3.splitRelations) == 5 ? 0 : 1)
    if sd3 == 0
        sd3 += array.get(ws3.splitRelations, 1) == 1 and array.get(ws3.splitRelations, 2) == 0 and array.get(ws3.splitRelations, 4) == 2 and array.get(ws3.splitChildren, 0) == 0 and array.get(ws3.splitChildren, 1) == 1 ? 0 : 1
    [r30, t30s, t30r] = refSplit(m3, 1, true, 100.0, 103.0, false, na, na, 3)
    [r31, t31s, t31r] = refSplit(m3, 1, true, 107.0, 110.0, false, na, na, 3)
    int td3 = splitRowDrift(ctx3.sp, 0, 1, m3, r30, t30s, t30r) + splitRowDrift(ctx3.sp, 1, 1, m3, r31, t31s, t31r)
    // post-commit: K1 (continuation of P0) and the fresh Core of P1 (coreId 2) hold the plan rows
    td3 += pre3 and pr3.committed ? 0 : 1
    td3 += ringDrift(ws3.coreRegistry, 1, m3, r30, t30s, t30r) + ringDrift(ws3.coreRegistry, 2, m3, r31, t31s, t31r)
    array.set(res, 2, sd3 + td3 == 0 ? 1.0 : 0.0)
    // diagnostics only: C3 first drift stage (same stage codes as mergeCase)
    int st3 = 0
    if sd3 > 0
        st3 := 1
    if st3 == 0
        st3 := dg3.get(D_PRE1) != refPack(m3, 1, 3) ? 2 : 0
    if st3 == 0
        float e30 = array.size(r30) * 100 + b2f(t30s) * 10 + b2f(t30r)
        float e31 = array.size(r31) * 100 + b2f(t31s) * 10 + b2f(t31r)
        st3 := dg3.get(D_SPLAN0) != e30 or dg3.get(D_SPLAN1) != e31 or splitRowDrift(ctx3.sp, 0, 1, m3, r30, t30s, t30r) + splitRowDrift(ctx3.sp, 1, 1, m3, r31, t31s, t31r) > 0 ? 3 : 0
    if st3 == 0
        st3 := dg3.get(D_PLANRES) < 0 or dg3.get(D_APPLY) != 2 or dg3.get(D_PFLAG) != 0 ? 4 : 0
    if st3 == 0
        st3 := not pre3 ? 5 : 0
    if st3 == 0
        st3 := not pr3.committed ? 6 : 0
    if st3 == 0
        st3 := ringDrift(ws3.coreRegistry, 1, m3, r30, t30s, t30r) + ringDrift(ws3.coreRegistry, 2, m3, r31, t31s, t31r) > 0 ? 7 : 0
    if st3 == 0 and sd3 + td3 > 0
        st3 := 8
    // C4 PENDING: C1 with K2 Support ActiveTouch -> the Merge component is pending (not applied)
    [c1, c2, c3, cDg, cSt] = mergeCase(mergeW2(), mergeMarks(), 4, false, 2, 0, false)
    array.set(res, 3, c1 + c2 + c3 == 0 ? 1.0 : 0.0)
    // C5 GUARD: C1 with the absorbed K2 holding one non-default Merge-deferred field -> Default Guard reject
    [d1, d2, d3, dDg, dSt] = mergeCase(mergeW2(), mergeMarks(), 4, false, 0, 2, false)
    array.set(res, 4, d1 + d2 + d3 == 0 ? 1.0 : 0.0)
    // C6 PERMUTATION: C1 with Root slots and winner backing reversed
    [e1, e2, e3, eDg, eSt] = mergeCase(mergeW2(), mergeMarks(), 4, false, 0, 0, true)
    array.set(res, 5, e1 + e2 + e3 == 0 ? 1.0 : 0.0)
    // W09 B06-B2C-B overlay subcase (outside the six cases): C4 with K2 Support ActiveTouch only as the current-bar overlay (the
    // persistent Phase stays Waiting) -> the same pending result as C4; the persistent Phase unchanged by the plan
    [f1, f2, f3, fDg, fSt] = mergeCase(mergeW2(), mergeMarks(), 4, false, 2, 0, false, true)
    ovDrift := f1 + f2 + f3 + (fDg.get(D_PHS) == 0 ? 0 : 1) + (fDg.get(D_COMPS) == cDg.get(D_COMPS) and fDg.get(D_PFLAG) == cDg.get(D_PFLAG) and fDg.get(D_PROOT) == cDg.get(D_PROOT) and fDg.get(D_APPLY) == cDg.get(D_APPLY) ? 0 : 1)
    ovPass  := ovDrift == 0 and fSt == 0 ? 1.0 : 0.0
    // W09 B06-B2C-C1 episode subcases (outside the six cases): non-default Episode fields through the real append / Merge /
    // Split plans / apply. E1 Merge (C1 fixture): the duplicate key (S, 1000, 101, 102) keeps the survivor K1 row whole
    // (touchNo 1, weak false, 0.5), not K2's (1, true, 0.9). E2 Merge overflow (C2 fixture, cap 3): the dropped row loses its
    // Episode fields with it. E3 Split (C3 fixture): each child row keeps its source mark's fields.
    Mk n1 = newMk()
    setEp(addM(n1, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5), 1, false, 0.5)
    setEp(addM(n1, 1, SIDE_S, 1002, 120.0, 121.0, 1, 120.5, 5), 2, true, 3.0)
    setEp(addM(n1, 2, SIDE_S, 1000, 101.0, 102.0, 2, 101.7, 7), 1, true, 0.9)
    setEp(addM(n1, 2, SIDE_S, 1001, 110.0, 112.0, 1, 111.0, 7), 2, true, 1.25)
    setEp(addM(n1, 2, SIDE_R, 1003, 101.0, 102.0, 1, 101.5, 7), 1, false, 0.25)
    [ctxE1, prE1, okE1, preE1, dgE1] = runScn(2, mergeW1(), mergeW2(), n1, 4, 0, SIDE_S, 0, false)
    [rE1, tE1s, tE1r] = refMerge(n1, array.from(1, 2), true, 100.0, 110.0, false, 100.0, 110.0, 4)
    int ed = (okE1 and preE1 and prE1.committed ? 0 : 1) + epRingDrift(ctxE1.ws.coreRegistry, 1, n1, rE1) + (array.size(rE1) == 2 and array.get(rE1, 0) == 0 ? 0 : 1)
    Mk n2 = newMk()
    setEp(addM(n2, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5), 1, true, 0.75)
    setEp(addM(n2, 1, SIDE_S, 1002, 102.0, 103.0, 1, 102.5, 5), 2, false, 0.125)
    setEp(addM(n2, 2, SIDE_S, 1001, 107.0, 108.0, 1, 107.5, 7), 1, true, 2.5)
    setEp(addM(n2, 2, SIDE_R, 1005, 105.0, 106.0, 1, 105.5, 7), 3, false, 0.0625)
    [ctxE2, prE2, okE2, preE2, dgE2] = runScn(2, mergeW1(), addW(mergeW2(), SIDE_R, 100, 110, array.from(1)), n2, 3, 0, SIDE_S, 0, false)
    [rE2, tE2s, tE2r] = refMerge(n2, array.from(1, 2), true, 100.0, 110.0, true, 100.0, 110.0, 3)
    ed += (okE2 and preE2 and prE2.committed ? 0 : 1) + epRingDrift(ctxE2.ws.coreRegistry, 1, n2, rE2) + (array.size(rE2) == 3 and tE2s ? 0 : 1)
    Mk n3 = newMk()
    setEp(addM(n3, 1, SIDE_S, 1000, 101.0, 102.0, 1, 101.5, 5), 1, false, 0.5)
    setEp(addM(n3, 1, SIDE_S, 1001, 102.0, 108.0, 2, 105.0, 5), 2, true, 1.5)
    setEp(addM(n3, 1, SIDE_R, 1002, 101.0, 102.0, 3, 101.5, 5), 1, true, 0.375)
    setEp(addM(n3, 1, SIDE_S, 1003, 104.0, 106.0, 4, 105.0, 5), 3, false, 0.875)
    [ctxE3, prE3, okE3, preE3, dgE3] = runScn(2, w31, w32, n3, 3, 0, SIDE_S, 0, false)
    [rE30, tE30s, tE30r] = refSplit(n3, 1, true, 100.0, 103.0, false, na, na, 3)
    [rE31, tE31s, tE31r] = refSplit(n3, 1, true, 107.0, 110.0, false, na, na, 3)
    ed += (okE3 and preE3 and prE3.committed ? 0 : 1) + epRingDrift(ctxE3.ws.coreRegistry, 1, n3, rE30) + epRingDrift(ctxE3.ws.coreRegistry, 2, n3, rE31)
    epDrift := ed
    epPass  := ed == 0 ? 1.0 : 0.0
    mT := a1 + b1 + c1 + d1 + e1
    sT := sd3
    tT := a2 + b2 + c2 + d2 + e2 + td3
    pT := a3 + b3 + c3 + d3 + e3
    mergeTotal := mT
    splitTotal := sT
    touchTotal := tT
    pendTotal  := pT
    int np = 0
    int q = 0
    while q < 6
        np += array.get(res, q) == 1.0 ? 1 : 0
        q += 1
    passed  := np
    passAll := np == 6 and mT + sT + tT + pT == 0 ? 1.0 : 0.0
    // ---- diagnostics (scalar snapshots from runScn / the case checks; expected values from the static audit) ----
    array.set(dx, 0, aSt)                                                  // expected 0
    array.set(dx, 1, bSt)                                                  // expected 0
    array.set(dx, 2, st3)                                                  // expected 0
    array.set(dx, 3, cSt)                                                  // expected 0
    array.set(dx, 4, dSt)                                                  // expected 0
    array.set(dx, 5, eSt)                                                  // expected 0
    array.set(dx, 6, array.get(res, 0) * 100000 + array.get(res, 1) * 10000 + array.get(res, 2) * 1000 + array.get(res, 3) * 100 + array.get(res, 4) * 10 + array.get(res, 5))  // expected 111111
    array.set(dx, 7, cnt4(aDg.get(D_PRE1), aDg.get(D_PRE2)))               // expected 2021 (K1 S2 R0, K2 S2 R1)
    array.set(dx, 8, tr4(aDg.get(D_PRE1), aDg.get(D_PRE2)))                // expected 0
    array.set(dx, 9, aDg.get(D_MPLAN))                                     // expected 2000 (S2 R0, trunc 0 / 0)
    array.set(dx, 10, aDg.get(D_PLANRES))                                  // expected 1
    array.set(dx, 11, aDg.get(D_PRE))                                      // expected 1
    array.set(dx, 12, aDg.get(D_COMMITTED))                                // expected 1
    array.set(dx, 13, aDg.get(D_FREED))                                    // expected 1
    array.set(dx, 14, aDg.get(D_POST1))                                    // expected 2000 (survivor K1: S2 R0, trunc 0 / 0)
    array.set(dx, 15, cnt4(bDg.get(D_PRE1), bDg.get(D_PRE2)))              // expected 2011 (K1 S2 R0, K2 S1 R1)
    array.set(dx, 16, tr4(bDg.get(D_PRE1), bDg.get(D_PRE2)))               // expected 0
    array.set(dx, 17, bDg.get(D_MPLAN))                                    // expected 2110 (S2 R1, trunc S 1 / R 0)
    array.set(dx, 18, (bDg.get(D_PLANRES) + 1) * 100 + (bDg.get(D_PRE) + 1) * 10 + bDg.get(D_COMMITTED))  // expected 221 (planResult 1, preflight 1, committed 1)
    array.set(dx, 19, bDg.get(D_POST1))                                    // expected 2110
    array.set(dx, 20, dg3.get(D_PRE1))                                     // expected 2110 (K1 S2 R1, trunc S 1 / R 0)
    array.set(dx, 21, dg3.get(D_SREL))                                     // expected 1
    array.set(dx, 22, dg3.get(D_SPLAN0))                                   // expected 110 (1 row, trunc S 1 / R 0)
    array.set(dx, 23, dg3.get(D_SPLAN1))                                   // expected 110
    array.set(dx, 24, dg3.get(D_PLANRES))                                  // expected 1
    array.set(dx, 25, dg3.get(D_PRE))                                      // expected 1
    array.set(dx, 26, dg3.get(D_COMMITTED))                                // expected 1
    array.set(dx, 27, dg3.get(D_POST1))                                    // expected 1010 (K1: S1 R0, trunc S 1 / R 0)
    array.set(dx, 28, dg3.get(D_POST2))                                    // expected 1010 (fresh coreId 2)
    array.set(dx, 29, cDg.get(D_PHS))                                      // expected 2 (ActiveTouch)
    array.set(dx, 30, cDg.get(D_PHR))                                      // expected 0 (Waiting)
    array.set(dx, 31, cDg.get(D_IDEDGE))                                   // expected 2
    array.set(dx, 32, cDg.get(D_COMPS))                                    // expected 100 (1 pending, 0 applied)
    array.set(dx, 33, cDg.get(D_PFLAG))                                    // expected 2
    array.set(dx, 34, cDg.get(D_PPARENT))                                  // expected 2
    array.set(dx, 35, cDg.get(D_PCHILD))                                   // expected 2
    array.set(dx, 36, cDg.get(D_PROOT))                                    // expected 4
    array.set(dx, 37, cDg.get(D_READY))                                    // expected 0
    array.set(dx, 38, cDg.get(D_APPLY))                                    // expected 0
    array.set(dx, 39, cDg.get(D_PLANRES))                                  // expected 1
    array.set(dx, 40, cDg.get(D_MUTRING))                                  // expected 0
    array.set(dx, 41, cDg.get(D_FREED))                                    // expected 0
    array.set(dx, 42, dDg.get(D_DEFER))                                    // expected 1
    array.set(dx, 43, dDg.get(D_GUARD))                                    // expected 1
    array.set(dx, 44, dDg.get(D_PRE))                                      // expected 0
    array.set(dx, 45, dDg.get(D_COMMITCALL))                               // expected 0
    array.set(dx, 46, dDg.get(D_MUTRING) + dDg.get(D_MUTCORE) + dDg.get(D_MUTPEND))  // expected 0
    array.set(dx, 47, d2)                                                  // expected 0 (C5 Touch comparison only)
    array.set(dx, 48, d3 == 0 ? 1.0 : 0.0)                                 // expected 1 (C5 Guard comparison only)
    array.set(dx, 49, dDg.get(D_PLANRES))                                  // expected 1
    array.set(dx, 50, cnt4(eDg.get(D_PRE1), eDg.get(D_PRE2)))              // expected 2021
    array.set(dx, 51, eDg.get(D_MPLAN))                                    // expected 2000
    array.set(dx, 52, eDg.get(D_POST1))                                    // expected 2000
    array.set(dx, 53, aDg.get(D_PRE1) == eDg.get(D_PRE1) and aDg.get(D_PRE2) == eDg.get(D_PRE2) ? 1.0 : 0.0)  // expected 1
    array.set(dx, 54, aDg.get(D_MPLAN) == eDg.get(D_MPLAN) and aDg.get(D_MREL) == eDg.get(D_MREL) and aDg.get(D_PLANRES) == eDg.get(D_PLANRES) ? 1.0 : 0.0)  // expected 1
    array.set(dx, 55, aDg.get(D_POST1) == eDg.get(D_POST1) and aDg.get(D_POST2) == eDg.get(D_POST2) and aDg.get(D_FREED) == eDg.get(D_FREED) ? 1.0 : 0.0)  // expected 1

plot(passAll, "B17_CONFORMANCE_PASS", display = display.data_window)

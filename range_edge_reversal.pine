//
// XAUUSD レンジ反転戦略（Range Edge Reversal）
// ------------------------------------------------------------
// 目的：4177〜4121 のレンジ内で「上限反発SELL / 下限反発BUY」を狙う
//       レンジ専用ストラテジー（順張りロジックとは完全に別戦略）。
// 対象：XAUUSD 5分足
//
// 基本思想：
//   「レンジ端到達」 → 「反転シグナル確認」 → 「エントリー」
//   単純に上限・下限到達では入らない。
// ------------------------------------------------------------

//@version=5
strategy(
     title             = "XAUUSD Range Edge Reversal",
     shorttitle        = "RangeEdgeRev",
     overlay           = true,
     max_bars_back     = 500,
     max_labels_count  = 500,
     max_lines_count   = 500,
     pyramiding        = 0,
     calc_on_every_tick = false,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_range = "レンジ定義"
rangeHigh = input.float(4177, title = "レンジ上限", group = grp_range)
rangeLow  = input.float(4121, title = "レンジ下限", group = grp_range)

grp_sig = "シグナル設定"
atrLen        = input.int(14,   title = "ATR 期間", minval = 1, group = grp_sig)
touchAtrMult  = input.float(0.2, title = "端到達 ATR 倍率 (touchAtrMult)", step = 0.05, group = grp_sig)
sweepLookback = input.int(5,    title = "スイープ参照本数", minval = 1, group = grp_sig)
pinWickRatio  = input.float(0.5, title = "ピンバー ヒゲ比率", step = 0.05, group = grp_sig)
requiredScore = input.int(2,    title = "必要スコア (requiredScore)", minval = 1, maxval = 3, group = grp_sig)

grp_tp = "TP 設定"
tpMode = input.string("Mode1", title = "TP モード",
             options = ["Mode1", "Mode2", "Mode3"], group = grp_tp,
             tooltip = "Mode1: レンジ中央 / Mode2: 反対側端 / Mode3: 固定RR")
rr     = input.float(1.5, title = "Mode3 リスクリワード比 (RR)", step = 0.1, group = grp_tp)

grp_sl = "SL 設定"
slAtrMult = input.float(0.2, title = "SL ATR 倍率", step = 0.05, group = grp_sl)

grp_filt = "フィルター"
maxRisk          = input.float(12, title = "SL 最大ドル (risk <=)", group = grp_filt)
maxEntriesPerDay = input.int(10,   title = "1日最大エントリー数", minval = 1, group = grp_filt)
cooldownBars     = input.int(3,    title = "クールダウン本数", minval = 0, group = grp_filt)

grp_disp = "表示設定"
show_lines  = input.bool(true, title = "レンジ水平線を表示", group = grp_disp)
show_labels = input.bool(true, title = "エントリーラベルを表示", group = grp_disp)

// ============================================================
// 優先度（上位足下降トレンドのため SELL 優勢）
// ============================================================
string sellRank = "A"
string buyRank  = "B"

// ============================================================
// 計算ロジック
// ============================================================
float atr = ta.atr(atrLen)

float midPoint = (rangeHigh + rangeLow) / 2

// ローソク足の各部位
float body      = math.abs(close - open)
float rng       = high - low
float upperWick = high - math.max(close, open)
float lowerWick = math.min(close, open) - low
float upperWickRatio = rng > 0 ? upperWick / rng : 0
float lowerWickRatio = rng > 0 ? lowerWick / rng : 0

// ------------------------------------------------------------
// SELL 条件
// ------------------------------------------------------------
// ① レンジ上限到達
bool sellZone = high >= rangeHigh - atr * touchAtrMult

// ② 反転確認
// A: Bear Engulfing
bool bearEngulf = close < open and open >= close[1] and close <= open[1]
// B: Bear Pin Bar
bool bearPin = upperWickRatio >= pinWickRatio and close < open
// C: スイープ（上方を抜けて陰線で戻る）
bool bearSweep = high > ta.highest(high[1], sweepLookback) and close < open

// ------------------------------------------------------------
// BUY 条件（SELL の完全反転版）
// ------------------------------------------------------------
// ① レンジ下限到達
bool buyZone = low <= rangeLow + atr * touchAtrMult

// ② 反転確認
// A: Bull Engulfing
bool bullEngulf = close > open and open <= close[1] and close >= open[1]
// B: Bull Pin Bar
bool bullPin = lowerWickRatio >= pinWickRatio and close > open
// C: 下抜けスイープ
bool bullSweep = low < ta.lowest(low[1], sweepLookback) and close > open

// ------------------------------------------------------------
// スコア制（反転シグナルを点数化）
// ------------------------------------------------------------
int sellScore = (bearEngulf ? 1 : 0) + (bearPin ? 1 : 0) + (bearSweep ? 1 : 0)
int buyScore  = (bullEngulf ? 1 : 0) + (bullPin ? 1 : 0) + (bullSweep ? 1 : 0)

// ============================================================
// フィルター
// ============================================================
// 1日のエントリー回数カウント
var int entriesToday = 0
if ta.change(time("D")) != 0
    entriesToday := 0

// クールダウン：最後にエントリーしてからの経過本数
var int lastEntryBar = na
bool cooldownOK = na(lastEntryBar) or (bar_index - lastEntryBar) > cooldownBars
bool dailyOK    = entriesToday < maxEntriesPerDay

// ============================================================
// SL / TP / Risk 計算
// ============================================================
float entryPrice = close

// SL
float sellSL = high + atr * slAtrMult
float buySL  = low  - atr * slAtrMult

// Risk（SL までのドル距離）
float sellRisk = sellSL - entryPrice
float buyRisk  = entryPrice - buySL

// TP（モード別）
float sellTP = switch tpMode
    "Mode1" => midPoint
    "Mode2" => rangeLow
    "Mode3" => entryPrice - sellRisk * rr
    => midPoint

float buyTP = switch tpMode
    "Mode1" => midPoint
    "Mode2" => rangeHigh
    "Mode3" => entryPrice + buyRisk * rr
    => midPoint

// ============================================================
// エントリー判定
// ============================================================
// レンジ端到達 + スコア条件 + フィルター
bool sellEntry = sellZone and sellScore >= requiredScore and sellRisk <= maxRisk and sellRisk > 0 and cooldownOK and dailyOK
bool buyEntry  = buyZone  and buyScore  >= requiredScore and buyRisk  <= maxRisk and buyRisk  > 0 and cooldownOK and dailyOK

// 同時成立時は優勢側（SELL）を優先
bool doSell = sellEntry
bool doBuy  = buyEntry and not sellEntry

// ============================================================
// 注文執行
// ============================================================
if doSell
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL TP/SL", from_entry = "SELL", limit = sellTP, stop = sellSL)
    lastEntryBar := bar_index
    entriesToday += 1

if doBuy
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY TP/SL", from_entry = "BUY", limit = buyTP, stop = buySL)
    lastEntryBar := bar_index
    entriesToday += 1

// ============================================================
// 表示：レンジ水平線（上限・中央・下限）
// ============================================================
plot(show_lines ? rangeHigh : na, title = "レンジ上限", color = color.red,    linewidth = 2, style = plot.style_linebr)
plot(show_lines ? midPoint  : na, title = "レンジ中央", color = color.gray,   linewidth = 1, style = plot.style_linebr)
plot(show_lines ? rangeLow  : na, title = "レンジ下限", color = color.green,  linewidth = 2, style = plot.style_linebr)

// ============================================================
// 表示：エントリーラベル
// ============================================================
// ラベル本文（Score / SL / TP / Risk）
f_label_text(_dir, _rank, _score, _sl, _tp, _risk) =>
    _dir + " " + _rank + "\n" +
     "Score=" + str.tostring(_score) + "\n" +
     "SL="   + str.tostring(_sl,  format.mintick) + "\n" +
     "TP="   + str.tostring(_tp,  format.mintick) + "\n" +
     "Risk=" + str.tostring(_risk, "#.##")

if show_labels and doSell
    label.new(
         bar_index, high,
         text  = f_label_text("SELL", sellRank, sellScore, sellSL, sellTP, sellRisk),
         color = color.new(color.red, 0),
         style = label.style_label_down,
         textcolor = color.white,
         size  = size.small
     )

if show_labels and doBuy
    label.new(
         bar_index, low,
         text  = f_label_text("BUY", buyRank, buyScore, buySL, buyTP, buyRisk),
         color = color.new(color.green, 0),
         style = label.style_label_up,
         textcolor = color.white,
         size  = size.small
     )

// ============================================================
// アラート
// ============================================================
alertcondition(doSell, title = "SELL シグナル", message = "{{ticker}} : レンジ上限反発 SELL ({{close}})")
alertcondition(doBuy,  title = "BUY シグナル",  message = "{{ticker}} : レンジ下限反発 BUY ({{close}})")

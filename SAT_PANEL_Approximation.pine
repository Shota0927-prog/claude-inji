// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// SAT PANEL Approximation - 表示専用インジケーター（XAUUSD 5分足を主対象）
//
// ============================================================================
// 【概要】
//   「SAT's PANEL」の表示を、各要素を分離して確認した結果にもとづき近似再現する
//   表示専用スクリプト。元インジケーターの計算式は非公開のため近似実装。
//
//   実装済み:
//     1. 長期移動平均線（既定 EMA200・方向で色替え）
//     2. STB ライン（Supertrend 近似 + フィルター強度による転換遅延／階段状）
//     3. SAT's BAND LINE1（既定 EMA ATR Breakout Band ／滑らかなバンド）
//     4. SAT's BAND LINE2（既定 EMA ATR Breakout Band ／LINE1 とは独立して転換）
//        ※ 表示バンドは上下それぞれ独立に EMA で平滑化できる（既定 OFF）。
//          平滑化は表示だけに効き、方向転換の判定には使わない。
//     5. 背景（判定方式を 4 種類から選択：突破／方向一致／並び順／なし）
//     6. MTF 方向スコア（※参考表示のみ。背景判定には一切使用しない）
//
//   未実装（意図的に除外）:
//     - 中央の EMA リボン状の雲
//     - エントリー / TP / SL / バックテスト / アラート
//
// ============================================================================
// 【コーディング上の注意】
//   Pine Script は「継続行のインデントが 4 の倍数だと新しいブロック」と解釈する。
//   そのため複数行に分割した三項演算子は構文エラーになりやすい。
//   本スクリプトでは複数行にまたがる三項演算子を一切使わず、
//   すべて if / else if 方式で記述している。
//
// ============================================================================
// 【背景ロジック】
//   元 SATS の背景仕様は未確定である。現時点では推測で仕様を決めず、
//   比較しやすい素直な判定を既定にしてある。
//
//   背景方式（06｜背景設定）:
//     ・価格が3本すべてを突破（既定）
//         判定ソース close のとき、
//           close が STB表示値・LINE1表示値・LINE2表示値の
//           すべてより上 → 青／すべてより下 → 赤／それ以外 → 背景なし
//         いずれかのライン値が na の場合は背景なし。
//         EMA200 や MTF は条件に含めない。保持本数の処理もしない。
//     ・3本の方向が一致 … STB / LINE1 / LINE2 の方向が全部そろう
//     ・3本の並び順     … 比較検証用。選んだ並びが成立している間だけ着色する。
//         ※ これは元 SATS の確定仕様ではない。
//         ※ 逆順を Buy として自動導出することはしない。
//           逆の並びを調べたいときは、選択肢からその並び自体を選ぶこと。
//     ・背景なし        … 背景を出さない
//
// ============================================================================
// 【確定足での更新と、形成中バーの変動について（区別して説明）】
//
//   ■ 方向状態の更新（確定足で行う）
//     「確定足のみで判定」を ON にすると、STB のフィルター状態および
//     EMA ATR Breakout Band の dirState を barstate.isconfirmed のバーでしか
//     更新しない。したがって形成中バーの途中で方向が反転することはない。
//     余分な 1 本の遅延は発生せず、フィルター強度 2 なら
//     「反対方向の確定足 2 本目のクローズ時点」で転換する。
//
//   ■ ライン価格と背景の変動（形成中バーでは動く）
//     方向が固定されていても、表示するライン価格そのものは EMA や ATR、
//     Supertrend のバンド計算から毎ティック再計算されるため、
//     形成中バーの間は上下に動く。背景判定も現在のライン値と価格から
//     毎ティック評価されるため、形成中バーでは点いたり消えたりしうる。
//     バーが確定した時点の値が最終値であり、
//     確定済みバーの履歴が後から書き換わることはない
//     （＝過去のリペイントは発生しない）。
//
//   ■ MTF（上位足・参考表示のみ）
//     request.security(..., lookahead_off) だけでは、リアルタイム進行中の
//     未確定な上位足の値は変動する（＝上位足が閉じるまで値が変わりうる）。
//     lookahead_off が保証するのは「未来の値が過去に漏れないこと」だけで、
//     「現在の上位足の値が動かないこと」ではない。
//     そのため「MTF確定方法」を用意し、既定の「確定した上位足のみ」では
//     request.security() の中で式に [1] を掛け、ひとつ前の "閉じた" 上位足の
//     値を参照する。[1] は security 内部（上位足の時系列）で適用するため、
//     未来の値が過去バーへ漏れることはない。
// ============================================================================

//@version=6
indicator(
     title         = "SAT PANEL Approximation",
     shorttitle    = "SAT PANEL Approx",
     overlay       = true,
     max_bars_back = 1000
 )

// ============================================================================
// 定数定義
// ============================================================================
// input() の group 引数は const string が必要なため、var を付けずに宣言する
G_TF    = "01｜時間軸設定（MTF：参考表示のみ）"
G_STB   = "02｜STB設定"
G_L1    = "03｜SAT's BAND LINE1"
G_L2    = "04｜SAT's BAND LINE2"
G_MA    = "05｜移動平均線"
G_BG    = "06｜背景設定"
G_VIEW  = "07｜比較表示"
G_DEBUG = "08｜デバッグ"

// 方向が未確定（0）のときに使う中立色（グレー）
C_FLAT_DEF = color.rgb(149, 152, 161)

// ラインの計算方式
M_BREAK = "EMA ATR Breakout Band"
M_TRAIL = "ATR Trailing Stop"
M_EMABD = "EMA + ATR Band"
M_SUPER = "現在のSupertrend"

// 背景の判定方式
BG_PRICE = "価格が3本すべてを突破"
BG_DIR   = "3本の方向が一致"
BG_ORDER = "3本の並び順"
BG_NONE  = "背景なし"

// 下降配列（高い順）の 6 パターン
O_112 = "LINE1 > LINE2 > STB"
O_1S2 = "LINE1 > STB > LINE2"
O_21S = "LINE2 > LINE1 > STB"
O_2S1 = "LINE2 > STB > LINE1"
O_S12 = "STB > LINE1 > LINE2"
O_S21 = "STB > LINE2 > LINE1"

// ============================================================================
// 01｜時間軸設定（MTF：参考表示のみ）
// ============================================================================
// 各時間軸の STB 方向を集計し、MTF 方向スコアを作る。
// ※ 重要：MTF の判定結果は「デバッグテーブルへの表示」だけに使う。
//   背景判定には一切使用しない（将来の比較検討用にコードを残してある）。
// ※ 注意（仕様）：
//   チャート時間足が 15分 / 1時間 などと同じ場合、同じ方向が二重に集計される。
//   初期版では二重集計を許容している。厳密に排除したい場合は各 TF の ON/OFF で調整。
useTfChart = input.bool(true,  "現在のチャート時間足を使う", group = G_TF)
useTf15    = input.bool(true,  "15分足を使う",               group = G_TF)
useTf60    = input.bool(true,  "1時間足を使う",              group = G_TF)
useTf240   = input.bool(true,  "4時間足を使う",              group = G_TF)
useTfD     = input.bool(true,  "日足を使う",                 group = G_TF)
useTfW     = input.bool(true,  "週足を使う",                 group = G_TF)

tf15  = input.timeframe("15",  "15分足の時間足指定",  group = G_TF)
tf60  = input.timeframe("60",  "1時間足の時間足指定", group = G_TF)
tf240 = input.timeframe("240", "4時間足の時間足指定", group = G_TF)
tfD   = input.timeframe("D",   "日足の時間足指定",    group = G_TF)
tfW   = input.timeframe("W",   "週足の時間足指定",    group = G_TF)

mtfConfirmMode = input.string("確定した上位足のみ", "MTF確定方法",
     options = ["確定した上位足のみ", "形成中の上位足も使用"], group = G_TF,
     tooltip = "確定した上位足のみ：request.security() 内で式に [1] を掛け、直前の閉じた上位足の値を使う。\n形成中の上位足も使用：進行中の上位足の現在値を使う（上位足が閉じるまで値が変動する）。")

mtfMode = input.string("指定数以上一致", "MTF一致条件（参考表示のみ）",
     options = ["全時間足一致", "過半数一致", "指定数以上一致"], group = G_TF,
     tooltip = "デバッグテーブルの MTF 判定表示にのみ使用する。背景には影響しない。")
mtfMinAgree = input.int(3, "指定数以上一致：必要本数", minval = 1, maxval = 6, group = G_TF)

// ============================================================================
// 02｜STB設定
// ============================================================================
// STB は元画像どおり「階段状」になる Supertrend 型を維持する。
showStb     = input.bool(true, "STBラインを表示", group = G_STB)
stbSrcType  = input.string("hl2", "STB ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_STB)
stbAtrLen   = input.int(10,  "STB ATR期間", minval = 1, maxval = 200, group = G_STB)
stbFactor   = input.float(2.0, "STB ATR倍率", minval = 0.1, maxval = 20.0, step = 0.1, group = G_STB)
stbFilter   = input.int(2,   "STB フィルター強度（連続確定本数）", minval = 1, maxval = 10, group = G_STB,
     tooltip = "反対方向の生シグナルが指定本数だけ連続で確定したら STB 方向を転換する。それまでは直前の方向を維持。")
stbWidth    = input.int(2,   "STB 線幅", minval = 1, maxval = 5, group = G_STB)
stbUpCol    = input.color(color.rgb(38, 198, 218), "STB 上昇色", group = G_STB)
stbDnCol    = input.color(color.rgb(255, 82, 82),  "STB 下降色", group = G_STB)
useConfirmed = input.bool(true, "確定足のみで判定（リペイント防止）", group = G_STB,
     tooltip = "ON：バーが確定したタイミングでのみ方向状態（dirState）を更新する。形成中バーの途中で方向が反転することはない。余分な 1 本の遅延は発生しない。\nこの設定は STB と EMA ATR Breakout Band の両方に効く。\n※ 方向が固定されていても、表示するライン価格そのものは形成中バーの間は動く（EMA / ATR / バンド計算が毎ティック更新されるため）。背景も同様に形成中は変化しうる。")

// ============================================================================
// 03｜SAT's BAND LINE1
// ============================================================================
// 元画像の LINE1 / LINE2 は階段状の Supertrend ではなく、価格へ滑らかに追従する
// バンド型に見える。既定を EMA ATR Breakout Band とし、方式を切替可能にしてある。
showL1     = input.bool(true, "BAND LINE1 を表示", group = G_L1)
l1Method   = input.string("EMA ATR Breakout Band", "LINE1 計算方式",
     options = ["EMA ATR Breakout Band", "ATR Trailing Stop", "EMA + ATR Band", "現在のSupertrend"], group = G_L1,
     tooltip = "EMA ATR Breakout Band：EMA±ATR×倍率のバンドを毎バー再計算。終値がバンドを抜けて確定したら方向転換。バンド値の切り上げ／切り下げ固定は行わないので滑らか。\nATR Trailing Stop：UT Bot 系のトレーリングストップ\nEMA + ATR Band：EMA を基準に片側バンドを表示\n現在のSupertrend：STB と同じ階段状")
l1SrcType  = input.string("close", "LINE1 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L1)
l1EmaLen   = input.int(50,  "LINE1 EMA期間", minval = 1, maxval = 500, group = G_L1)
l1AtrLen   = input.int(10,  "LINE1 ATR期間", minval = 1, maxval = 200, group = G_L1)
// --- EMA ATR Breakout Band 専用の 2 倍率 ---
//   転換判定と表示位置で別々の倍率を使うため、
//   「転換は鈍いが表示は価格に近い」といった調整ができる。
l1SwMult   = input.float(4.0, "LINE1 転換判定ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "EMA ATR Breakout Band の方向転換の判定にだけ使う倍率。大きくするほど転換が鈍くなる。\n表示バンドの幅（basis からの距離）そのものは変えないが、方向が変われば表示する側が上バンド／下バンドで入れ替わるため、見た目の位置は変わりうる。")
l1DpMult   = input.float(2.5, "LINE1 表示ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "EMA ATR Breakout Band の表示位置にだけ使う倍率。大きくするほど表示ラインが basis から離れる。\n方向転換の判定には一切使わないため、過去の転換タイミングは変わらない。")
// --- Breakout 以外の 3 方式が使う倍率（従来どおり） ---
l1Factor   = input.float(2.5, "LINE1 ATR倍率（Breakout以外の方式用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "ATR Trailing Stop / EMA + ATR Band / 現在のSupertrend で使う倍率。EMA ATR Breakout Band には影響しない。")
// --- 表示バンドの平滑化（EMA ATR Breakout Band 専用） ---
//   rawUpper / rawLower にそれぞれ独立して EMA をかける。
//   転換判定には平滑化後の値を使わない（switchUpper / switchLower は生のまま）。
l1Smooth    = input.bool(false, "LINE1 表示バンド平滑化", group = G_L1,
     tooltip = "ON：表示に使う上下バンドを、それぞれ独立に EMA で平滑化する。\n方向転換の判定は平滑化前の値で行うため、転換タイミングは変わらない。\nEMA ATR Breakout Band を選んでいるときだけ効く。")
l1SmoothLen = input.int(5, "LINE1 平滑化期間", minval = 1, maxval = 200, group = G_L1,
     tooltip = "表示バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている（比較モードで参照するため）。")
l1Width    = input.int(2,   "LINE1 線幅", minval = 1, maxval = 5, group = G_L1)
l1UpCol    = input.color(color.rgb(38, 198, 218), "LINE1 上昇色", group = G_L1)
l1DnCol    = input.color(color.rgb(255, 82, 82),  "LINE1 下降色", group = G_L1)

// ============================================================================
// 04｜SAT's BAND LINE2
// ============================================================================
// LINE2 は LINE1 と完全に独立した状態変数を持つ（別々に方向転換する）。
showL2     = input.bool(true, "BAND LINE2 を表示", group = G_L2)
l2Method   = input.string("EMA ATR Breakout Band", "LINE2 計算方式",
     options = ["EMA ATR Breakout Band", "ATR Trailing Stop", "EMA + ATR Band", "現在のSupertrend"], group = G_L2,
     tooltip = "EMA ATR Breakout Band：EMA±ATR×倍率のバンドを毎バー再計算。終値がバンドを抜けて確定したら方向転換。バンド値の切り上げ／切り下げ固定は行わないので滑らか。\nATR Trailing Stop：UT Bot 系のトレーリングストップ\nEMA + ATR Band：EMA を基準に片側バンドを表示\n現在のSupertrend：STB と同じ階段状")
l2SrcType  = input.string("close", "LINE2 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2)
l2EmaLen   = input.int(21,  "LINE2 EMA期間", minval = 1, maxval = 500, group = G_L2)
l2AtrLen   = input.int(10,  "LINE2 ATR期間", minval = 1, maxval = 200, group = G_L2)
// --- EMA ATR Breakout Band 専用の 2 倍率 ---
l2SwMult   = input.float(4.0, "LINE2 転換判定ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "EMA ATR Breakout Band の方向転換の判定にだけ使う倍率。大きくするほど転換が鈍くなる。\n表示バンドの幅（basis からの距離）そのものは変えないが、方向が変われば表示する側が上バンド／下バンドで入れ替わるため、見た目の位置は変わりうる。")
l2DpMult   = input.float(3.0, "LINE2 表示ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "EMA ATR Breakout Band の表示位置にだけ使う倍率。大きくするほど表示ラインが basis から離れる。\n方向転換の判定には一切使わないため、過去の転換タイミングは変わらない。")
// --- Breakout 以外の 3 方式が使う倍率（従来どおり） ---
l2Factor   = input.float(2.0, "LINE2 ATR倍率（Breakout以外の方式用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "ATR Trailing Stop / EMA + ATR Band / 現在のSupertrend で使う倍率。EMA ATR Breakout Band には影響しない。")
// --- 表示バンドの平滑化（EMA ATR Breakout Band 専用） ---
l2Smooth    = input.bool(false, "LINE2 表示バンド平滑化", group = G_L2,
     tooltip = "ON：表示に使う上下バンドを、それぞれ独立に EMA で平滑化する。\n方向転換の判定は平滑化前の値で行うため、転換タイミングは変わらない。\nEMA ATR Breakout Band を選んでいるときだけ効く。")
l2SmoothLen = input.int(5, "LINE2 平滑化期間", minval = 1, maxval = 200, group = G_L2,
     tooltip = "表示バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている（比較モードで参照するため）。")
l2Width    = input.int(2,   "LINE2 線幅", minval = 1, maxval = 5, group = G_L2)
l2UpCol    = input.color(color.rgb(38, 198, 218), "LINE2 上昇色", group = G_L2)
l2DnCol    = input.color(color.rgb(255, 82, 82),  "LINE2 下降色", group = G_L2)

// ============================================================================
// 05｜移動平均線
// ============================================================================
showMa    = input.bool(true, "移動平均線を表示", group = G_MA)
maType    = input.string("EMA", "MA 種別", options = ["EMA", "SMA", "RMA", "WMA"], group = G_MA)
maLen     = input.int(200, "MA 期間", minval = 1, maxval = 1000, group = G_MA)
maSrcType = input.string("close", "MA ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_MA)
maWidth   = input.int(2, "MA 線幅", minval = 1, maxval = 5, group = G_MA)
maUpCol   = input.color(color.rgb(38, 198, 218), "MA 上昇色", group = G_MA)
maDnCol   = input.color(color.rgb(255, 82, 82),  "MA 下降色", group = G_MA)
maFlatCol = input.color(color.rgb(149, 152, 161), "MA 中立色", group = G_MA)

// ============================================================================
// 06｜背景設定
// ============================================================================
// 既定は「価格が3本すべてを突破」。元 SATS の仕様が未確定のため、
// 推測を含まない素直な判定を初期値にしてある。
bgMode = input.string("価格が3本すべてを突破", "背景方式",
     options = ["価格が3本すべてを突破", "3本の方向が一致", "3本の並び順", "背景なし"], group = G_BG,
     tooltip = "価格が3本すべてを突破（既定）：判定ソースの価格が STB表示値・LINE1表示値・LINE2表示値のすべてより上なら青、すべてより下なら赤、それ以外は背景なし。いずれかが na なら背景なし。EMA200 と MTF は条件に含めない。\n3本の方向が一致：STB / LINE1 / LINE2 の方向が全部そろったら背景\n3本の並び順：比較検証用。選んだ並びが成立している間だけ着色する（元 SATS の確定仕様ではない）\n背景なし：背景を描かない")

bgSrcMode = input.string("close", "背景判定ソース（突破方式のみ）",
     options = ["close", "high/low", "ローソク足全体"], group = G_BG,
     tooltip = "「価格が3本すべてを突破」方式でのみ使用する。\nclose（既定）：終値が 3 本すべてより上／下\nhigh/low：高値が 3 本すべてより上（Buy）／安値が 3 本すべてより下（Sell）＝ゆるい判定\nローソク足全体：安値が 3 本すべてより上（Buy）／高値が 3 本すべてより下（Sell）＝厳しい判定")

bgOrderMode = input.string("LINE1 > LINE2 > STB", "検証する並び（高い順）",
     options = ["LINE1 > LINE2 > STB", "LINE1 > STB > LINE2", "LINE2 > LINE1 > STB", "LINE2 > STB > LINE1", "STB > LINE1 > LINE2", "STB > LINE2 > LINE1"],
     group = G_BG,
     tooltip = "「3本の並び順」方式で検証する並び（左が最も高い）。この並びが成立している間だけ着色する。\n※ 逆順を Buy として自動導出することはしない。逆の並びを調べたいときは、選択肢からその並び自体を選ぶこと。")

bgBuyCol   = input.color(color.rgb(38, 198, 218), "Buy背景色",  group = G_BG)
bgSellCol  = input.color(color.rgb(255, 82, 82),  "Sell背景色", group = G_BG)
bgOrderCol = input.color(color.rgb(180, 180, 180), "並び順一致の背景色（比較用）", group = G_BG,
     tooltip = "「3本の並び順」方式で使う色。Buy / Sell を意味しない、単なる並び成立の目印。")
bgTransp   = input.int(85, "背景の透明度", minval = 0, maxval = 100, group = G_BG)

// ============================================================================
// 07｜比較表示
// ============================================================================
// 単独表示モードでは対象以外のライン・EMA・背景を非表示にする。
// ※ 表示の切り替えは plot() へ渡す系列と bgcolor の色だけを変えるものであり、
//   内部の計算や方向状態（var dirState など）には一切影響しない。
viewMode = input.string("通常表示", "比較表示モード",
     options = ["通常表示", "STBだけ", "LINE1だけ", "LINE2だけ", "LINE1 上下バンド比較", "LINE2 上下バンド比較", "LINE2 中心線・固定ATR比較"], group = G_VIEW,
     tooltip = "単独表示：対象以外のライン・移動平均線・背景を非表示にする。\n上下バンド比較：対象ラインの上下バンドを方向に関係なく両方表示する。平滑化前は薄い線、平滑化後は濃い線。背景・STB・EMA200 は非表示。\nLINE2 中心線・固定ATR比較：中心線 basis（黄）／通常 ATR の下側バンド（青）／固定 ATR の下側バンド（白）を並べ、中心線の下降と ATR 幅の拡大の影響を分けて確認する。\nいずれのモードでも内部計算と方向状態は変わらない。")

// ATR を固定し始める日時。
// 【タイムゾーンについて】
//   ・比較には bar の time（UNIX ミリ秒・UTC 基準）をそのまま使う。
//   ・既定値は timestamp("01 Jan 2026 00:00 +0000") と日時文字列で指定し、
//     +0000（UTC）を明示している。input.time() の初期値は const int である
//     必要があるため、この文字列形式を使う。
//   ・TradingView の設定画面に出る日時ピッカーが何のタイムゾーンで表示・入力
//     されるかは環境（チャートのタイムゾーン設定）に依存するため、ここでは
//     断定しない。実際にどのバーで固定されたかは、データウィンドウの
//     「DW: LINE2 固定ATR取得バー時刻(UNIX ms)」と、デバッグテーブルの
//     「固定ATR」行に出る UTC 表記の時刻で必ず確認すること。
freezeTime = input.time(timestamp("01 Jan 2026 00:00 +0000"), "ATR固定開始日時", group = G_VIEW,
     tooltip = "「LINE2 中心線・固定ATR比較」で ATR を固定し始める日時。急落が始まる足を指定する想定。\n指定時刻以降で最初のバーの『1本前の ATR』を固定値として使う（固定開始バー自身の ATR は使わない）。\n以降その値は更新しない。\n\nタイムゾーン：内部比較は UNIX ミリ秒（UTC 基準）で行う。既定値は UTC で指定している。設定画面のピッカーの表示タイムゾーンは環境依存なので、実際に固定されたバーはデータウィンドウの『DW: LINE2 固定ATR取得バー時刻(UNIX ms)』とデバッグテーブルの UTC 表記で確認すること。")

showFlipMarker = input.bool(false, "転換確認マーカーを表示", group = G_VIEW,
     tooltip = "ON のとき、LINE1 / LINE2 の確定方向が反転したバーに小さなマーカーを表示する。初期化（方向 0 から最初の方向が決まった時点）は転換として扱わない。\nLINE1：三角／LINE2：ひし形。上昇転換は足の下、下降転換は足の上。")

// ============================================================================
// 08｜デバッグ
// ============================================================================
showDebug   = input.bool(false, "デバッグテーブルを表示", group = G_DEBUG)
debugTxtSize = input.string("tiny", "テーブル文字サイズ", options = ["tiny", "small", "normal"], group = G_DEBUG)

// ============================================================================
// 共通関数
// ============================================================================

// ソース文字列から価格系列を取得する
f_src(simple string t) =>
    switch t
        "close" => close
        "open"  => open
        "hl2"   => hl2
        "hlc3"  => hlc3
        "ohlc4" => ohlc4
        "hlcc4" => hlcc4
        =>         hl2

// 移動平均の種別切り替え
f_ma(simple string t, float src, simple int len) =>
    switch t
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        =>       ta.ema(src, len)

// ----------------------------------------------------------------------------
// [方式 A] Supertrend 型ライン（STB の本体・階段状になる）
//
//   戻り値: [最終上側バンド, 最終下側バンド, 生Supertrendライン, 生方向]
//   生方向は  +1 = 上昇 / -1 = 下降
//   ※ 組み込み ta.supertrend() は -1 が上昇・+1 が下降で紛らわしいため、
//     ここでは自前実装して +1=上昇 に統一している（方向値の解釈ミス対策）。
// ----------------------------------------------------------------------------
f_supertrend(float src, simple int atrLen, float factor) =>
    float atrVal     = ta.atr(atrLen)
    float upperBand  = src + factor * atrVal
    float lowerBand  = src - factor * atrVal
    float prevUpper  = nz(upperBand[1])
    float prevLower  = nz(lowerBand[1])
    // バンドは「トレンド方向に切り上がる／切り下がる」ように片方向に固定する
    lowerBand := lowerBand > prevLower or close[1] < prevLower ? lowerBand : prevLower
    upperBand := upperBand < prevUpper or close[1] > prevUpper ? upperBand : prevUpper
    int   dirRaw = na
    float stLine = na
    float prevSt = stLine[1]   // 直前バーのライン値（history 参照）
    if na(atrVal[1])
        dirRaw := -1           // 計算開始直後は下降から開始（na 初期化の型エラー回避）
    else if prevSt == prevUpper
        dirRaw := close > upperBand ?  1 : -1
    else
        dirRaw := close < lowerBand ? -1 :  1
    stLine := dirRaw == 1 ? lowerBand : upperBand
    [upperBand, lowerBand, stLine, dirRaw]

// ----------------------------------------------------------------------------
// [方式 B] EMA ATR Breakout Band（LINE1 / LINE2 の既定方式）
//
//   basis     = ta.ema(source, emaLength)
//   atrValue  = ta.atr(atrLength)
//
//   ■ 転換判定用バンド（switchMultiplier だけを使う）
//     switchUpper = basis + atrValue * switchMultiplier
//     switchLower = basis - atrValue * switchMultiplier
//
//   方向転換ルール（switchMultiplier のみ使用）:
//     ・下降状態のとき、終値が switchUpper を上抜けて確定したら上昇へ転換
//     ・上昇状態のとき、終値が switchLower を下抜けて確定したら下降へ転換
//     ・switchUpper と switchLower の間では直前方向を維持
//       → レンジ内では方向が頻繁に反転しない
//
//   表示バンド（displayMultiplier のみ使用）:
//     rawUpper = basis + atrValue * displayMultiplier
//     rawLower = basis - atrValue * displayMultiplier
//     さらに上下それぞれ独立に EMA をかけた平滑化バンドも毎バー計算する:
//       smoothUpper = ta.ema(rawUpper, smoothLen)
//       smoothLower = ta.ema(rawLower, smoothLen)
//     useSmooth が true なら smoothUpper / smoothLower を表示に使い、
//     false なら rawUpper / rawLower を使う。
//
//   表示ライン:
//     ・上昇状態 = 選択した下側バンド（青・価格の下側）
//     ・下降状態 = 選択した上側バンド（赤・価格の上側）
//     ※ 赤青に切り替えたあとの表示線に、さらに EMA をかけることはしない。
//     ※ 平滑化した値は方向転換の判定に一切使わない。
//
//   倍率を分離した効果（正確な表現）:
//     ・displayMultiplier は方向判定に一切使わないため、
//       これを変えても過去の方向転換タイミングは変わらない。
//     ・switchMultiplier は表示バンドの幅（basis からの距離）を変えない。
//       ただし switchMultiplier を変えると方向が変わりうるため、
//       方向が変わったバーでは表示する側が上バンド／下バンドで入れ替わる。
//       つまり「同じ方向・同じバーなら表示バンド値は変わらない。
//       ただし方向が変われば表示する上下バンドも変わる」。
//
//   ※ 重要：Supertrend のようなバンド値の切り上げ／切り下げ固定は行わない。
//     EMA と ATR から毎バー再計算した滑らかなバンドをそのまま表示する。
//   ※ var の状態は呼び出しごとに独立。LINE1 と LINE2 は完全に別状態になる。
//
//   戻り値:
//     [表示ライン, 方向, basis, atrValue, switchUpper, switchLower,
//      rawUpper, rawLower, smoothUpper, smoothLower]
// ----------------------------------------------------------------------------
f_emaAtrBreakout(float src, simple int emaLen, simple int atrLen, float switchMult, float displayMult, simple int smoothLen, bool useSmooth, bool allowUpdate) =>
    float basis    = ta.ema(src, emaLen)
    float atrValue = ta.atr(atrLen)
    // 転換判定にだけ使うバンド（平滑化しない）
    float switchUpper = basis + atrValue * switchMult
    float switchLower = basis - atrValue * switchMult
    // 表示にだけ使う生バンド
    float rawUpper = basis + atrValue * displayMult
    float rawLower = basis - atrValue * displayMult
    // 上下それぞれ独立に EMA をかけた平滑化バンド。
    // ta.ema() は条件分岐の外で毎バー無条件に呼ぶ（実行されないバーがあると値がずれるため）。
    float smoothUpper = ta.ema(rawUpper, smoothLen)
    float smoothLower = ta.ema(rawLower, smoothLen)
    // 表示に使うバンドを選ぶ。ここでは値を選ぶだけで、追加の平滑化はしない。
    float displayUpper = rawUpper
    float displayLower = rawLower
    if useSmooth
        displayUpper := smoothUpper
        displayLower := smoothLower
    var int dirState = 0
    if allowUpdate and not na(basis) and not na(atrValue)
        if dirState == 0
            // 初期化：転換判定バンドを抜けていればその方向、間なら基準線との位置で決める
            if close > switchUpper
                dirState := 1
            else if close < switchLower
                dirState := -1
            else if close > basis
                dirState := 1
            else
                dirState := -1
        else if dirState == -1 and close > switchUpper
            dirState := 1
        else if dirState == 1 and close < switchLower
            dirState := -1
    float lineVal = na
    if dirState == 1
        lineVal := displayLower
    else if dirState == -1
        lineVal := displayUpper
    [lineVal, dirState, basis, atrValue, switchUpper, switchLower, rawUpper, rawLower, smoothUpper, smoothLower]

// ----------------------------------------------------------------------------
// [方式 C] ATR Trailing Stop（UT Bot 系）
//
//   nLoss = ATR × 倍率 として、
//     ・価格が前回ストップより上で上昇継続 → max(前回ストップ, src - nLoss)
//     ・価格が前回ストップより下で下降継続 → min(前回ストップ, src + nLoss)
//     ・下から上へクロス                   → src - nLoss
//     ・上から下へクロス                   → src + nLoss
// ----------------------------------------------------------------------------
f_atrTrail(float src, simple int atrLen, float mult) =>
    float nLoss = mult * ta.atr(atrLen)
    var float stopVal  = na
    var int   dirState = 0
    if not na(nLoss)
        // 初回は下側に置いて上昇から開始する
        float prevStop = na(stopVal) ? src - nLoss : stopVal
        float prevSrc  = nz(src[1], src)
        if src > prevStop and prevSrc > prevStop
            // 上昇継続：ストップは切り上げのみ
            stopVal := math.max(prevStop, src - nLoss)
        else if src < prevStop and prevSrc < prevStop
            // 下降継続：ストップは切り下げのみ
            stopVal := math.min(prevStop, src + nLoss)
        else if src > prevStop
            // 下から上へクロス
            stopVal := src - nLoss
        else
            // 上から下へクロス
            stopVal := src + nLoss
        // 方向：どちらでもない（同値）ときは直前の方向を維持する
        if src > stopVal
            dirState := 1
        else if src < stopVal
            dirState := -1
    [stopVal, dirState]

// ----------------------------------------------------------------------------
// [方式 D] EMA + ATR Band
//   EMA を基準線として、価格が基準線より上なら下側バンド、
//   下なら上側バンドだけを表示する（基準線をまたぐたびに方向が変わる）。
// ----------------------------------------------------------------------------
f_emaAtrBand(float src, simple int emaLen, simple int atrLen, float mult) =>
    float basis = ta.ema(src, emaLen)
    float band  = mult * ta.atr(atrLen)
    var int dirState = 0
    if not na(basis) and not na(band)
        dirState := src > basis ? 1 : src < basis ? -1 : dirState
    float lineVal = na
    if dirState == 1
        lineVal := basis - band
    else if dirState == -1
        lineVal := basis + band
    [lineVal, dirState]

// ----------------------------------------------------------------------------
// フィルター強度つき方向確定ロジック（STB 専用）
//
//   反対方向の生シグナルが strength 本連続で確定したときだけ方向を転換する。
//   allowUpdate に barstate.isconfirmed を渡すと、確定したバーでしか
//   dirState / oppCount を更新しない。余分な 1 本の遅延は発生しない。
// ----------------------------------------------------------------------------
f_filterDir(int rawDir, simple int strength, bool allowUpdate) =>
    var int dirState = 0
    var int oppCount = 0
    int r = nz(rawDir, 0)
    if allowUpdate and r != 0
        if dirState == 0
            // 初期化：最初に得られた生方向をそのまま採用
            dirState := r
            oppCount := 0
        else if r != dirState
            oppCount := oppCount + 1
            if oppCount >= strength
                dirState := r
                oppCount := 0
        else
            oppCount := 0
    dirState

// ----------------------------------------------------------------------------
// STB 方向（フィルター適用後）をひとまとめに計算する関数
//   request.security() からも呼べるように、戻り値は int 単体にしている。
// ----------------------------------------------------------------------------
f_stbDir(simple string srcType, simple int atrLen, float factor, simple int strength, bool allowUpdate) =>
    float s = f_src(srcType)
    [_u, _l, _st, rawDirTuple] = f_supertrend(s, atrLen, factor)
    // タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
    int rawDir = rawDirTuple
    f_filterDir(rawDir, strength, allowUpdate)

// ----------------------------------------------------------------------------
// 上位足用の STB 方向（参考表示のみ）
//   confirmedOnly が true のときの [1] は「上位足の時系列上」で適用されるため、
//   ひとつ前の "閉じた" 上位足の値になる（未来の値が過去へ漏れることはない）。
//   ※ barstate.isconfirmed は request.security() 内では使わない。
// ----------------------------------------------------------------------------
f_stbDirHtf(simple string srcType, simple int atrLen, float factor, simple int strength, simple bool confirmedOnly) =>
    int d = f_stbDir(srcType, atrLen, factor, strength, true)
    confirmedOnly ? d[1] : d

// 方向 → 表示文字列
f_dirStr(int d) =>
    d ==  1 ? "▲ UP" : d == -1 ? "▼ DOWN" : "－"

// 方向 → 表示色
f_dirCol(int d, color upC, color dnC, color flatC) =>
    d ==  1 ? upC : d == -1 ? dnC : flatC

// 価格 → 表示文字列（na 対応）
f_priceStr(float v) =>
    na(v) ? "－" : str.tostring(v, format.mintick)

// ----------------------------------------------------------------------------
// 3 本のラインを高い順に並べた文字列を返す（デバッグ用）
//   引数は vStb = STB, vL1 = LINE1, vL2 = LINE2
//   同値がある場合は並び順を確定できないため「同値あり」を返す。
// ----------------------------------------------------------------------------
f_rankStr(float vStb, float vL1, float vL2) =>
    string res = "－"
    if not na(vStb) and not na(vL1) and not na(vL2)
        if vStb == vL1 or vStb == vL2 or vL1 == vL2
            res := "同値あり（Neutral）"
        else
            string hi  = "STB"
            string mid = "STB"
            string lo  = "STB"
            if vStb > vL1 and vStb > vL2
                hi := "STB"
                if vL1 > vL2
                    mid := "LINE1"
                    lo  := "LINE2"
                else
                    mid := "LINE2"
                    lo  := "LINE1"
            else if vL1 > vStb and vL1 > vL2
                hi := "LINE1"
                if vStb > vL2
                    mid := "STB"
                    lo  := "LINE2"
                else
                    mid := "LINE2"
                    lo  := "STB"
            else
                hi := "LINE2"
                if vStb > vL1
                    mid := "STB"
                    lo  := "LINE1"
                else
                    mid := "LINE1"
                    lo  := "STB"
            res := hi + " > " + mid + " > " + lo
    res

// ============================================================================
// 状態更新の可否（STB フィルターと EMA ATR Breakout Band の両方に効く）
//   useConfirmed = true  → 確定バーでのみ方向状態を更新する
//   useConfirmed = false → 形成中バーでも更新する（反応は早いが途中で揺れる）
// ※ 過去足へずらす（rawDir[1]）方式は使わない。余分な 1 本の遅延が出るため。
// ============================================================================
bool allowStateUpdate = useConfirmed ? barstate.isconfirmed : true

// ============================================================================
// 計算：STB ライン（階段状 Supertrend + フィルター強度）
// ============================================================================
float stbSrc = f_src(stbSrcType)

[stbUpperBand, stbLowerBand, stbLineRaw, stbRawDirT] = f_supertrend(stbSrc, stbAtrLen, stbFactor)

// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
int stbRaw = stbRawDirT

int stbDir = f_filterDir(nz(stbRaw, 0), stbFilter, allowStateUpdate)

// 表示用 STB ライン：確定方向に対応する側のバンドを描画する。
//   上昇（青）＝ 最終下側バンド（価格の下側）
//   下降（赤）＝ 最終上側バンド（価格の上側）
float stbDisplayLine = na
if stbDir == 1
    stbDisplayLine := stbLowerBand
else if stbDir == -1
    stbDisplayLine := stbUpperBand

// ============================================================================
// 計算：SAT's BAND LINE1 / LINE2
//
//   4 方式すべてを毎バー無条件に計算し、選択された方式の結果だけを採用する。
//   （ta.*() や var を持つ関数を if の中で呼ぶと、実行されないバーで状態が
//     更新されず値がずれるため。選択は計算後の値の取捨だけで行う。）
//   LINE1 と LINE2 は別々の関数呼び出しなので、状態変数は完全に独立している。
// ============================================================================
float l1Src = f_src(l1SrcType)
float l2Src = f_src(l2SrcType)

// --- LINE1：4 方式ぶんを計算 ---
[l1BreakLine, l1BreakDir, l1BreakBasis, l1BreakAtr, l1BreakSwUp, l1BreakSwLo, l1RawUp, l1RawLo, l1SmUp, l1SmLo] = f_emaAtrBreakout(l1Src, l1EmaLen, l1AtrLen, l1SwMult, l1DpMult, l1SmoothLen, l1Smooth, allowStateUpdate)
[l1TrailLine, l1TrailDir] = f_atrTrail(l1Src, l1AtrLen, l1Factor)
[l1EmaLine,   l1EmaDir]   = f_emaAtrBand(l1Src, l1EmaLen, l1AtrLen, l1Factor)
[l1StUpper, l1StLower, l1StLineRaw, l1StRawDirT] = f_supertrend(l1Src, l1AtrLen, l1Factor)
int   l1StDir  = nz(l1StRawDirT, 0)
float l1StLine = na
if l1StDir == 1
    l1StLine := l1StLower
else if l1StDir == -1
    l1StLine := l1StUpper

// --- LINE2：4 方式ぶんを計算 ---
[l2BreakLine, l2BreakDir, l2BreakBasis, l2BreakAtr, l2BreakSwUp, l2BreakSwLo, l2RawUp, l2RawLo, l2SmUp, l2SmLo] = f_emaAtrBreakout(l2Src, l2EmaLen, l2AtrLen, l2SwMult, l2DpMult, l2SmoothLen, l2Smooth, allowStateUpdate)
[l2TrailLine, l2TrailDir] = f_atrTrail(l2Src, l2AtrLen, l2Factor)
[l2EmaLine,   l2EmaDir]   = f_emaAtrBand(l2Src, l2EmaLen, l2AtrLen, l2Factor)
[l2StUpper, l2StLower, l2StLineRaw, l2StRawDirT] = f_supertrend(l2Src, l2AtrLen, l2Factor)
int   l2StDir  = nz(l2StRawDirT, 0)
float l2StLine = na
if l2StDir == 1
    l2StLine := l2StLower
else if l2StDir == -1
    l2StLine := l2StUpper

// --- 選択された方式の結果を採用 ---
float l1DisplayLine = na
int   l1Dir         = 0
if l1Method == M_BREAK
    l1DisplayLine := l1BreakLine
    l1Dir         := l1BreakDir
else if l1Method == M_TRAIL
    l1DisplayLine := l1TrailLine
    l1Dir         := l1TrailDir
else if l1Method == M_EMABD
    l1DisplayLine := l1EmaLine
    l1Dir         := l1EmaDir
else if l1Method == M_SUPER
    l1DisplayLine := l1StLine
    l1Dir         := l1StDir

float l2DisplayLine = na
int   l2Dir         = 0
if l2Method == M_BREAK
    l2DisplayLine := l2BreakLine
    l2Dir         := l2BreakDir
else if l2Method == M_TRAIL
    l2DisplayLine := l2TrailLine
    l2Dir         := l2TrailDir
else if l2Method == M_EMABD
    l2DisplayLine := l2EmaLine
    l2Dir         := l2EmaDir
else if l2Method == M_SUPER
    l2DisplayLine := l2StLine
    l2Dir         := l2StDir

// ----------------------------------------------------------------------------
// 診断値（データウィンドウ表示用）
//   basis / ATR / 転換判定バンドは EMA ATR Breakout Band 固有の値なので、
//   他方式を選んでいるときは na にしておく（誤読を防ぐため）。
// ----------------------------------------------------------------------------
float l1DiagBasis = na
float l1DiagAtr   = na
float l1DiagSwUp  = na
float l1DiagSwLo  = na
if l1Method == M_BREAK
    l1DiagBasis := l1BreakBasis
    l1DiagAtr   := l1BreakAtr
    l1DiagSwUp  := l1BreakSwUp
    l1DiagSwLo  := l1BreakSwLo

float l2DiagBasis = na
float l2DiagAtr   = na
float l2DiagSwUp  = na
float l2DiagSwLo  = na
if l2Method == M_BREAK
    l2DiagBasis := l2BreakBasis
    l2DiagAtr   := l2BreakAtr
    l2DiagSwUp  := l2BreakSwUp
    l2DiagSwLo  := l2BreakSwLo

// ============================================================================
// 計算：LINE2 中心線・固定ATR比較（表示モードに関係なく毎バー計算する）
//
//   目的：LINE2 の急落後の沈み込みについて、
//         「中心線 basis が下がった影響」と「ATR 幅が広がった影響」を分けて見る。
//
//   ・basis は固定しない（毎バー更新する）
//   ・固定するのは ATR だけ
//   ・rawNormal = basis - 現在ATR   × 表示倍率
//   ・rawFixed  = basis - 固定ATR   × 表示倍率
//   ・転換倍率や方向状態はこの比較に一切使わない
//
//   固定値の取り方：
//     指定時刻以降で最初のバーにおける「1 本前の ATR」を採用する。
//     固定開始バー自身の ATR は使わない。以降は更新しない。
//     未来の値は参照しない（[1] は必ず過去側）。
//     直前の ATR が na（履歴不足）の場合は固定値を na のままにし、失敗を記録する。
// ============================================================================
// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
float l2AtrNow   = l2BreakAtr
float l2BasisNow = l2BreakBasis

var float l2FrozenAtr     = na
var int   l2FrozenBarTime = na
var bool  l2FreezeDone    = false
var bool  l2FreezeFailed  = false

if not l2FreezeDone and time >= freezeTime
    l2FreezeDone    := true
    l2FrozenBarTime := time
    float prevAtr = l2AtrNow[1]
    if na(prevAtr)
        // 指定時刻より前の履歴が読み込まれておらず、直前バーの ATR を取れない
        l2FreezeFailed := true
    else
        l2FrozenAtr := prevAtr

// 生の比較バンド（表示倍率は LINE2 の表示ATR倍率をそのまま使う）
//   rawNormal は f_emaAtrBreakout() が返す下側生バンドと同一の式なので、
//   値がずれないよう l2RawLo をそのまま使う。
float cmpRawNormal = l2RawLo
float cmpRawFixed  = na
if not na(l2FrozenAtr)
    cmpRawFixed := l2BasisNow - l2FrozenAtr * l2DpMult

// --- 平滑化（表示モードの ON/OFF に関係なく毎バー計算する） ---
// 中心線の平滑化。ta.ema() は条件分岐の外で毎バー呼ぶ。
float cmpBasisSmooth = ta.ema(l2BasisNow, l2SmoothLen)
// 通常側の平滑化は f_emaAtrBreakout() 内で計算済みの下側平滑化バンドを使う。
float cmpNormalSmooth = l2SmLo

// 固定側の平滑化：
//   固定開始の前バーまでは通常側の EMA と同じ値を保持しておき、
//   固定開始バーから rawFixed を入力として同じ係数で更新する。
//   こうすると固定開始前の平滑化履歴が揃い、
//   開始後は「ATR を固定した影響」だけが差として出る。
float cmpAlpha = 2.0 / (l2SmoothLen + 1)
var float cmpFixedSmooth = na
if l2FreezeDone
    if na(cmpFixedSmooth)
        cmpFixedSmooth := cmpRawFixed
    else
        cmpFixedSmooth := cmpAlpha * cmpRawFixed + (1 - cmpAlpha) * cmpFixedSmooth
else
    cmpFixedSmooth := cmpNormalSmooth

// --- 表示に使う値を選ぶ（平滑化 ON/OFF で条件を揃える） ---
float l2CmpBasisPlot  = l2BasisNow
float l2CmpNormalPlot = cmpRawNormal
if l2Smooth
    l2CmpBasisPlot  := cmpBasisSmooth
    l2CmpNormalPlot := cmpNormalSmooth

// 固定側は固定開始バーより前は表示しない
float l2CmpFixedPlot = na
if l2FreezeDone
    if l2Smooth
        l2CmpFixedPlot := cmpFixedSmooth
    else
        l2CmpFixedPlot := cmpRawFixed

// ============================================================================
// 計算：移動平均線
// ============================================================================
float maSrc = f_src(maSrcType)
float maVal = f_ma(maType, maSrc, maLen)
int   maDir = maVal > maVal[1] ? 1 : maVal < maVal[1] ? -1 : 0

// ============================================================================
// 計算：MTF（マルチタイムフレーム）STB 方向 ※参考表示のみ
//   lookahead は必ず barmerge.lookahead_off（未来の値を過去へ漏らさない）。
//   ここで求めた結果は背景判定には一切使用しない。
// ============================================================================
bool mtfConfirmedOnly = mtfConfirmMode == "確定した上位足のみ"

int dirChart = stbDir   // 現在のチャート時間足はローカル計算をそのまま使う

int dir15 = nz(request.security(syminfo.tickerid, tf15,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dir60 = nz(request.security(syminfo.tickerid, tf60,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dir240 = nz(request.security(syminfo.tickerid, tf240,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dirD = nz(request.security(syminfo.tickerid, tfD,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dirW = nz(request.security(syminfo.tickerid, tfW,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

// --- 集計（OFF の時間足は集計対象外） ---
int buyCount  = 0
int sellCount = 0
int tfTotal   = 0

if useTfChart
    tfTotal := tfTotal + 1
    if dirChart == 1
        buyCount := buyCount + 1
    else if dirChart == -1
        sellCount := sellCount + 1

if useTf15
    tfTotal := tfTotal + 1
    if dir15 == 1
        buyCount := buyCount + 1
    else if dir15 == -1
        sellCount := sellCount + 1

if useTf60
    tfTotal := tfTotal + 1
    if dir60 == 1
        buyCount := buyCount + 1
    else if dir60 == -1
        sellCount := sellCount + 1

if useTf240
    tfTotal := tfTotal + 1
    if dir240 == 1
        buyCount := buyCount + 1
    else if dir240 == -1
        sellCount := sellCount + 1

if useTfD
    tfTotal := tfTotal + 1
    if dirD == 1
        buyCount := buyCount + 1
    else if dirD == -1
        sellCount := sellCount + 1

if useTfW
    tfTotal := tfTotal + 1
    if dirW == 1
        buyCount := buyCount + 1
    else if dirW == -1
        sellCount := sellCount + 1

// MTF 方向スコア（+ が Buy 寄り、- が Sell 寄り）
int mtfScore = buyCount - sellCount

// 説明用の総合判定（デバッグ表示のみ）
string mtfDesc = "Neutral"
if tfTotal == 0
    mtfDesc := "TF未選択"
else if buyCount == tfTotal
    mtfDesc := "強いBuy"
else if sellCount == tfTotal
    mtfDesc := "強いSell"
else if buyCount * 2 > tfTotal
    mtfDesc := "Buy優勢"
else if sellCount * 2 > tfTotal
    mtfDesc := "Sell優勢"

// 一致条件による MTF シグナル（デバッグ表示のみ・背景には使用しない）
int mtfSignal = 0
if tfTotal > 0
    if mtfMode == "全時間足一致"
        if buyCount == tfTotal
            mtfSignal := 1
        else if sellCount == tfTotal
            mtfSignal := -1
    else if mtfMode == "過半数一致"
        if buyCount * 2 > tfTotal
            mtfSignal := 1
        else if sellCount * 2 > tfTotal
            mtfSignal := -1
    else
        // 指定数以上一致：両方が条件を満たした場合は多い方を採用、同数なら Neutral
        bool bOk = buyCount  >= mtfMinAgree
        bool sOk = sellCount >= mtfMinAgree
        if bOk and (not sOk or buyCount > sellCount)
            mtfSignal := 1
        else if sOk and (not bOk or sellCount > buyCount)
            mtfSignal := -1

// ============================================================================
// 判定：3 本の並び順（比較検証用）
//
//   選択した並びを「高い順」に ordHi > ordMid > ordLo として取り出し、
//   その並びが成立しているかどうかだけを見る。
//   比較は厳密な不等号なので、ライン同士が同値なら不成立。
//   この方式では終値の位置を一切使わない。
//
//   ※ これは元 SATS の確定仕様ではない。あくまで比較のための表示である。
//   ※ 逆順を Buy として自動導出することはしない。
// ============================================================================
float ordHi  = na
float ordMid = na
float ordLo  = na

if bgOrderMode == O_112
    ordHi  := l1DisplayLine
    ordMid := l2DisplayLine
    ordLo  := stbDisplayLine
else if bgOrderMode == O_1S2
    ordHi  := l1DisplayLine
    ordMid := stbDisplayLine
    ordLo  := l2DisplayLine
else if bgOrderMode == O_21S
    ordHi  := l2DisplayLine
    ordMid := l1DisplayLine
    ordLo  := stbDisplayLine
else if bgOrderMode == O_2S1
    ordHi  := l2DisplayLine
    ordMid := stbDisplayLine
    ordLo  := l1DisplayLine
else if bgOrderMode == O_S12
    ordHi  := stbDisplayLine
    ordMid := l1DisplayLine
    ordLo  := l2DisplayLine
else
    ordHi  := stbDisplayLine
    ordMid := l2DisplayLine
    ordLo  := l1DisplayLine

bool ordValid = not na(ordHi) and not na(ordMid) and not na(ordLo)

// 選択した並びが成立しているかどうかだけを判定する。
// ※ 逆順を Buy として自動導出することはしない（反転の導出は行わない）。
//   逆の並びを検証したいときは、選択肢からその並び自体を選ぶこと。
bool orderMatch = false
if ordValid
    if ordHi > ordMid and ordMid > ordLo
        orderMatch := true

// ============================================================================
// 判定：価格が 3 本すべてを突破（突破方式用）
// ============================================================================
float highestLine = math.max(stbDisplayLine, math.max(l1DisplayLine, l2DisplayLine))
float lowestLine  = math.min(stbDisplayLine, math.min(l1DisplayLine, l2DisplayLine))

// 判定に使う価格。
//   close          ：Buy も Sell も終値
//   high/low       ：Buy は高値・Sell は安値（ゆるい判定）
//   ローソク足全体 ：Buy は安値・Sell は高値（厳しい判定＝足全体が抜けている）
float bgBuySrc  = bgSrcMode == "close" ? close : bgSrcMode == "high/low" ? high : low
float bgSellSrc = bgSrcMode == "close" ? close : bgSrcMode == "high/low" ? low  : high

bool priceBuy  = not na(highestLine) and bgBuySrc  > highestLine
bool priceSell = not na(lowestLine)  and bgSellSrc < lowestLine

// ============================================================================
// 判定：3 本の方向が一致（方向一致方式用）
// ============================================================================
bool dirBuy  = stbDir ==  1 and l1Dir ==  1 and l2Dir ==  1
bool dirSell = stbDir == -1 and l1Dir == -1 and l2Dir == -1

// ============================================================================
// 判定：最終的な背景（選択した背景方式で分岐）
// ============================================================================
bool buyBackground  = false
bool sellBackground = false
bool orderBackground = false

if bgMode == BG_PRICE
    buyBackground  := priceBuy
    sellBackground := priceSell
else if bgMode == BG_DIR
    buyBackground  := dirBuy
    sellBackground := dirSell
else if bgMode == BG_ORDER
    // 比較用。Buy / Sell として扱わず、専用色で並びの成立だけを示す。
    orderBackground := orderMatch

// ============================================================================
// 表示可否の決定（比較表示モード）
//   単独表示モードでは対象以外のライン・EMA・背景を非表示にする。
//   ここで決めるのは plot() へ渡す系列と bgcolor の色だけであり、
//   上で計算済みの値や var による方向状態には一切影響しない。
// ============================================================================
bool soloStb = viewMode == "STBだけ"
bool soloL1  = viewMode == "LINE1だけ"
bool soloL2  = viewMode == "LINE2だけ"
bool isSolo  = soloStb or soloL1 or soloL2

// 上下バンド比較モード。
// 対象ラインの上下バンドを方向に関係なく両方描くため、
// 方向で色分けした通常のラインと STB / EMA200 / 背景はすべて隠す。
// ※ 表示価格を使う背景判定は平滑化で結果が変わりうるので、
//   この比較モードでは背景を出さない。
bool cmpL1 = viewMode == "LINE1 上下バンド比較"
bool cmpL2 = viewMode == "LINE2 上下バンド比較"
// LINE2 中心線・固定ATR比較モード
bool cmpL2Fix = viewMode == "LINE2 中心線・固定ATR比較"
// 比較線が有効なのは EMA ATR Breakout Band を選んでいるときだけ
bool cmpL2FixOk = cmpL2Fix and l2Method == M_BREAK
bool isCmp = cmpL1 or cmpL2 or cmpL2Fix

bool visStb = showStb
bool visL1  = showL1
bool visL2  = showL2
bool visMa  = showMa
bool visBg  = true
if isSolo
    visStb := soloStb
    visL1  := soloL1
    visL2  := soloL2
    visMa  := false
    visBg  := false
else if isCmp
    visStb := false
    visL1  := false
    visL2  := false
    visMa  := false
    visBg  := false

// 上下バンド比較モードで描画する系列。
// 対象モードでないバーは na にして、チャートに何も出さない。
// ※ EMA ATR Breakout Band を選んでいないラインは値が意味を持たないため、
//   その場合も na にする。
float cmpRawUp = na
float cmpRawLo = na
float cmpSmUp  = na
float cmpSmLo  = na
color cmpUpCol = C_FLAT_DEF
color cmpLoCol = C_FLAT_DEF
if cmpL1 and l1Method == M_BREAK
    cmpRawUp := l1RawUp
    cmpRawLo := l1RawLo
    cmpSmUp  := l1SmUp
    cmpSmLo  := l1SmLo
    cmpUpCol := l1DnCol
    cmpLoCol := l1UpCol
else if cmpL2 and l2Method == M_BREAK
    cmpRawUp := l2RawUp
    cmpRawLo := l2RawLo
    cmpSmUp  := l2SmUp
    cmpSmLo  := l2SmLo
    cmpUpCol := l2DnCol
    cmpLoCol := l2UpCol

// LINE2 中心線・固定ATR比較で描画する 3 本。
// 対象モードでない、または方式が Breakout でない場合は na にして何も出さない。
float fixBasisPlot  = na
float fixNormalPlot = na
float fixFixedPlot  = na
if cmpL2FixOk
    fixBasisPlot  := l2CmpBasisPlot
    fixNormalPlot := l2CmpNormalPlot
    fixFixedPlot  := l2CmpFixedPlot

// ============================================================================
// 描画：ライン
//   plot() はグローバルスコープでのみ呼ぶ（ローカルスコープ禁止）。
//   ライン値・線色ともに同じ方向変数から決まるため、
//   「青なのに価格の上」「赤なのに価格の下」という矛盾は起きない。
// ============================================================================
plot(visL2 ? l2DisplayLine : na, title = "SAT's BAND LINE2",
     color = l2Dir == 1 ? l2UpCol : l2Dir == -1 ? l2DnCol : C_FLAT_DEF,
     linewidth = l2Width)

plot(visL1 ? l1DisplayLine : na, title = "SAT's BAND LINE1",
     color = l1Dir == 1 ? l1UpCol : l1Dir == -1 ? l1DnCol : C_FLAT_DEF,
     linewidth = l1Width)

plot(visStb ? stbDisplayLine : na, title = "STB Line",
     color = stbDir == 1 ? stbUpCol : stbDir == -1 ? stbDnCol : C_FLAT_DEF,
     linewidth = stbWidth)

plot(visMa ? maVal : na, title = "MA (EMA200)",
     color = maDir == 1 ? maUpCol : maDir == -1 ? maDnCol : maFlatCol,
     linewidth = maWidth)

// ============================================================================
// 描画：上下バンド比較（比較モードのときだけ値が入る）
//   平滑化前 = 薄い線（透明度高め・細い）
//   平滑化後 = 濃い線（不透明・太い）
//   上側は下降色系、下側は上昇色系で区別する。
// ============================================================================
plot(cmpRawUp, title = "比較: 上バンド（平滑化前）",
     color = color.new(cmpUpCol, 65), linewidth = 1)
plot(cmpRawLo, title = "比較: 下バンド（平滑化前）",
     color = color.new(cmpLoCol, 65), linewidth = 1)
plot(cmpSmUp,  title = "比較: 上バンド（平滑化後）",
     color = color.new(cmpUpCol, 0), linewidth = 2)
plot(cmpSmLo,  title = "比較: 下バンド（平滑化後）",
     color = color.new(cmpLoCol, 0), linewidth = 2)

// ============================================================================
// 描画：LINE2 中心線・固定ATR比較（対象モードのときだけ値が入る）
//   ① 中心線 basis            … 黄
//   ② 通常 ATR の下側バンド   … 青
//   ③ 固定 ATR の下側バンド   … 白
//   平滑化 ON/OFF は 3 本とも同じ条件で揃えてある。
// ============================================================================
plot(fixBasisPlot,  title = "比較: LINE2 中心線 basis",
     color = color.yellow, linewidth = 2)
plot(fixNormalPlot, title = "比較: LINE2 通常ATR 下側バンド",
     color = color.blue, linewidth = 2)
plot(fixFixedPlot,  title = "比較: LINE2 固定ATR 下側バンド",
     color = color.white, linewidth = 2)

// ============================================================================
// 描画：転換確認マーカー（初期値 OFF）
//   確定方向が反転したバーにだけ小さなマーカーを出す。
//   直前バーの方向が 0（未初期化）の場合は転換として扱わない。
//   LINE1 は三角、LINE2 はひし形。上昇転換は足の下、下降転換は足の上。
// ============================================================================
bool l1FlipUp   = l1Dir ==  1 and l1Dir[1] == -1
bool l1FlipDown = l1Dir == -1 and l1Dir[1] ==  1
bool l2FlipUp   = l2Dir ==  1 and l2Dir[1] == -1
bool l2FlipDown = l2Dir == -1 and l2Dir[1] ==  1

plotshape(showFlipMarker and visL1 and l1FlipUp, title = "LINE1 転換 UP",
     style = shape.triangleup, location = location.belowbar, color = l1UpCol, size = size.tiny)
plotshape(showFlipMarker and visL1 and l1FlipDown, title = "LINE1 転換 DOWN",
     style = shape.triangledown, location = location.abovebar, color = l1DnCol, size = size.tiny)
plotshape(showFlipMarker and visL2 and l2FlipUp, title = "LINE2 転換 UP",
     style = shape.diamond, location = location.belowbar, color = l2UpCol, size = size.tiny)
plotshape(showFlipMarker and visL2 and l2FlipDown, title = "LINE2 転換 DOWN",
     style = shape.diamond, location = location.abovebar, color = l2DnCol, size = size.tiny)

// ============================================================================
// 描画：診断値（データウィンドウのみ）
//   display = display.data_window を指定しているため、チャートには線が出ない。
//   カーソルを置いたバーの値をデータウィンドウで確認できる。
//   方向は 上昇 = 1 / 下降 = -1 / 未初期化 = 0。
//   LINE1 / LINE2 の basis・ATR・転換判定バンドは
//   EMA ATR Breakout Band を選んでいるときだけ値が入る（他方式では na）。
// ============================================================================
plot(stbDisplayLine,   title = "DW: STB 表示価格",        display = display.data_window)
plot(stbDir * 1.0,     title = "DW: STB 方向",            display = display.data_window)

plot(l1DisplayLine,    title = "DW: LINE1 表示価格",      display = display.data_window)
plot(l1Dir * 1.0,      title = "DW: LINE1 方向",          display = display.data_window)
plot(l1DiagBasis,      title = "DW: LINE1 EMA基準値",     display = display.data_window)
plot(l1DiagAtr,        title = "DW: LINE1 ATR値",         display = display.data_window)
plot(l1DiagSwUp,       title = "DW: LINE1 転換判定上限",  display = display.data_window)
plot(l1DiagSwLo,       title = "DW: LINE1 転換判定下限",  display = display.data_window)

plot(l2DisplayLine,    title = "DW: LINE2 表示価格",      display = display.data_window)
plot(l2Dir * 1.0,      title = "DW: LINE2 方向",          display = display.data_window)
plot(l2DiagBasis,      title = "DW: LINE2 EMA基準値",     display = display.data_window)
plot(l2DiagAtr,        title = "DW: LINE2 ATR値",         display = display.data_window)
plot(l2DiagSwUp,       title = "DW: LINE2 転換判定上限",  display = display.data_window)
plot(l2DiagSwLo,       title = "DW: LINE2 転換判定下限",  display = display.data_window)

// --- LINE2 中心線・固定ATR比較の診断値 ---
//   固定ATR取得バー時刻は UNIX ミリ秒（UTC 基準）。
//   読みやすい UTC 表記はデバッグテーブルの「固定ATR」行に出る。
plot(l2AtrNow,             title = "DW: LINE2 現在ATR",                    display = display.data_window)
plot(l2FrozenAtr,          title = "DW: LINE2 固定ATR",                    display = display.data_window)
plot(l2CmpBasisPlot,       title = "DW: LINE2 中心線 比較表示値",          display = display.data_window)
plot(l2CmpNormalPlot,      title = "DW: LINE2 通常ATR下側 比較表示値",     display = display.data_window)
plot(l2CmpFixedPlot,       title = "DW: LINE2 固定ATR下側 比較表示値",     display = display.data_window)
plot(l2FrozenBarTime * 1.0, title = "DW: LINE2 固定ATR取得バー時刻(UNIX ms)", display = display.data_window)

// ============================================================================
// 描画：背景
//   bgcolor() の多重呼び出しによる意図しない上書きを避けるため、
//   最終的な背景色を 1 つの変数にまとめてから 1 回だけ描画する。
//   ※ 突破方式の high/low モードでは巨大な包み足で Buy と Sell が同時に
//     成立しうるため、その場合は Buy を優先する（if / else if の評価順）。
//   ※ 単独表示モードでは背景を出さない。
// ============================================================================
color bgFinal = na

if visBg
    if buyBackground
        bgFinal := color.new(bgBuyCol, bgTransp)
    else if sellBackground
        bgFinal := color.new(bgSellCol, bgTransp)
    else if orderBackground
        bgFinal := color.new(bgOrderCol, bgTransp)

bgcolor(bgFinal, title = "SAT PANEL 背景")

// ============================================================================
// 比較モードの案内メッセージ
//   ラベルは最終バーに最大 1 個だけ。条件が解消したら削除する。
//     ・LINE2 の計算方式が EMA ATR Breakout Band でない → 切替案内
//     ・指定時刻より前の履歴が足りず固定 ATR を取得できなかった → その旨
// ============================================================================
var label cmpMsgLbl = na

if barstate.islast
    string cmpMsg = ""
    if cmpL2Fix and l2Method != M_BREAK
        cmpMsg := "LINE2 の計算方式を「" + M_BREAK + "」に切り替えてください（現在：" + l2Method + "）"
    else if cmpL2Fix and l2FreezeFailed
        cmpMsg := "指定時刻前の履歴が不足（固定開始バーの 1 本前の ATR を取得できませんでした）"
    if cmpMsg == ""
        if not na(cmpMsgLbl)
            label.delete(cmpMsgLbl)
            cmpMsgLbl := na
    else
        if na(cmpMsgLbl)
            cmpMsgLbl := label.new(bar_index, high, cmpMsg, style = label.style_label_down,
                 color = color.new(color.orange, 20), textcolor = color.black, size = size.small)
        else
            label.set_xy(cmpMsgLbl, bar_index, high)
            label.set_text(cmpMsgLbl, cmpMsg)

// ============================================================================
// デバッグテーブル（初期値 OFF・ラベルは出さない）
// ============================================================================
var table dbgTable = table.new(position.top_right, 2, 28,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

// 現在の背景判定を文字列化
string bgStr = "なし"
if not visBg
    bgStr := "非表示（単独表示モード）"
else if bgMode == BG_NONE
    bgStr := "背景なし（OFF）"
else if buyBackground
    bgStr := "青（Buy）"
else if sellBackground
    bgStr := "赤（Sell）"
else if orderBackground
    bgStr := "並び一致（比較用）"

// 3 本を高い順に並べた実測の並び
string rankStr = f_rankStr(stbDisplayLine, l1DisplayLine, l2DisplayLine)

// 固定 ATR の状態（値と、実際に固定されたバーの時刻を UTC 表記で出す）
string frozenStr = "未固定（指定時刻に未到達）"
if l2FreezeFailed
    frozenStr := "指定時刻前の履歴が不足"
else if not na(l2FrozenAtr)
    frozenStr := f_priceStr(l2FrozenAtr) + " @ " + str.format_time(l2FrozenBarTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"

// 選択した並びの成立状況（比較用。反転は導出しない）
string orderStr = bgOrderMode + "  " + (orderMatch ? "○ 成立" : "✕")

// EMA ATR Breakout Band の内部値。
// 他方式を選んでいるときは表示しても意味がないので「未選択」と出す。
string l1BasisStr = "－（Breakout未選択）"
string l1SwUpStr  = "－（Breakout未選択）"
string l1SwLoStr  = "－（Breakout未選択）"
if l1Method == M_BREAK
    l1BasisStr := f_priceStr(l1DiagBasis)
    l1SwUpStr  := f_priceStr(l1DiagSwUp)
    l1SwLoStr  := f_priceStr(l1DiagSwLo)

string l2BasisStr = "－（Breakout未選択）"
string l2SwUpStr  = "－（Breakout未選択）"
string l2SwLoStr  = "－（Breakout未選択）"
if l2Method == M_BREAK
    l2BasisStr := f_priceStr(l2DiagBasis)
    l2SwUpStr  := f_priceStr(l2DiagSwUp)
    l2SwLoStr  := f_priceStr(l2DiagSwLo)

if showDebug and barstate.islast
    string ts = debugTxtSize
    color  bgH = color.new(color.gray, 70)
    color  bgS = color.new(color.blue, 75)
    color  bgC = color.new(color.black, 60)

    table.cell(dbgTable, 0, 0, "SAT PANEL DEBUG", text_color = color.white, bgcolor = bgH, text_size = ts)
    table.cell(dbgTable, 1, 0, timeframe.period,  text_color = color.white, bgcolor = bgH, text_size = ts)

    // --- STB ---
    table.cell(dbgTable, 0, 1, "STB方向", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 1, f_dirStr(stbDir), text_color = f_dirCol(stbDir, stbUpCol, stbDnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 2, "STB displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 2, f_priceStr(stbDisplayLine), text_color = f_dirCol(stbDir, stbUpCol, stbDnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- LINE1 ---
    table.cell(dbgTable, 0, 3, "LINE1方向", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 3, f_dirStr(l1Dir) + "  (" + l1Method + ")", text_color = f_dirCol(l1Dir, l1UpCol, l1DnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 4, "LINE1 basis", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 4, l1BasisStr, text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 5, "LINE1 switchUpper", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 5, l1SwUpStr, text_color = l1DnCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 6, "LINE1 switchLower", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 6, l1SwLoStr, text_color = l1UpCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 7, "LINE1 displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 7, f_priceStr(l1DisplayLine), text_color = f_dirCol(l1Dir, l1UpCol, l1DnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- LINE2 ---
    table.cell(dbgTable, 0, 8, "LINE2方向", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 8, f_dirStr(l2Dir) + "  (" + l2Method + ")", text_color = f_dirCol(l2Dir, l2UpCol, l2DnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 9, "LINE2 basis", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 9, l2BasisStr, text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 10, "LINE2 switchUpper", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 10, l2SwUpStr, text_color = l2DnCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 11, "LINE2 switchLower", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 11, l2SwLoStr, text_color = l2UpCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 12, "LINE2 displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 12, f_priceStr(l2DisplayLine), text_color = f_dirCol(l2Dir, l2UpCol, l2DnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- MA ---
    table.cell(dbgTable, 0, 13, "MA方向", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 13, f_dirStr(maDir), text_color = f_dirCol(maDir, maUpCol, maDnCol, maFlatCol), bgcolor = bgC, text_size = ts)

    // --- 並び順・背景 ---
    table.cell(dbgTable, 0, 14, "高い順の並び", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 14, rankStr, text_color = color.white, bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 15, "検証中の並び", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 15, orderStr, text_color = orderMatch ? bgOrderCol : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 16, "比較表示モード", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 16, viewMode + (showFlipMarker ? " ／ 転換マーカーON" : " ／ 転換マーカーOFF"), text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 17, "3本の最高/最安", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 17, f_priceStr(highestLine) + " / " + f_priceStr(lowestLine), text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 18, "最終背景判定", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 18, bgStr + "  [" + bgMode + "]",
         text_color = buyBackground ? bgBuyCol : sellBackground ? bgSellCol : color.white, bgcolor = bgS, text_size = ts)

    // --- MTF（参考表示のみ・背景には未使用） ---
    table.cell(dbgTable, 0, 19, "現在足STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 19, useTfChart ? f_dirStr(dirChart) : "OFF",
         text_color = useTfChart ? f_dirCol(dirChart, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 20, "15分STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 20, useTf15 ? f_dirStr(dir15) : "OFF",
         text_color = useTf15 ? f_dirCol(dir15, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 21, "1時間STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 21, useTf60 ? f_dirStr(dir60) : "OFF",
         text_color = useTf60 ? f_dirCol(dir60, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 22, "4時間STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 22, useTf240 ? f_dirStr(dir240) : "OFF",
         text_color = useTf240 ? f_dirCol(dir240, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 23, "日足/週足STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 23,
         (useTfD ? f_dirStr(dirD) : "OFF") + " / " + (useTfW ? f_dirStr(dirW) : "OFF"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 24, "MTF（参考）", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 24,
         "B" + str.tostring(buyCount) + "/S" + str.tostring(sellCount) +
         " 計" + str.tostring(tfTotal) + " ｜" + mtfDesc +
         " [" + (mtfSignal == 1 ? "Buy" : mtfSignal == -1 ? "Sell" : "-") + "]",
         text_color = mtfSignal == 1 ? stbUpCol : mtfSignal == -1 ? stbDnCol : color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 25, "確定方法", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 25,
         (useConfirmed ? "確定足" : "形成中") + " / " + (mtfConfirmedOnly ? "MTF:確定" : "MTF:形成中"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 26, "表示バンド平滑化", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 26,
         "L1 " + (l1Smooth ? "ON(" + str.tostring(l1SmoothLen) + ")" : "OFF") +
         " / L2 " + (l2Smooth ? "ON(" + str.tostring(l2SmoothLen) + ")" : "OFF"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 27, "固定ATR", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 27, frozenStr, text_color = color.white, bgcolor = bgC, text_size = ts)

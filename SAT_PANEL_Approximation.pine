// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// SAT PANEL Approximation - 表示専用インジケーター（XAUUSD 5分足を主対象）
//
// ============================================================================
// 【概要】
//   「SAT's PANEL」の表示を、各要素を分離して確認した結果にもとづき近似再現する
//   表示専用スクリプト。元インジケーターの計算式は非公開のため近似実装。
//
//   実装済み:
//     1. 長期移動平均線（既定 EMA200・方向で色替え）
//     2. STB ライン（Supertrend 近似 + フィルター強度による転換遅延／階段状）
//     3. SAT's BAND LINE1（既定 EMA ATR Breakout Band ／滑らかなバンド）
//     4. SAT's BAND LINE2（既定 EMA ATR Breakout Band ／LINE1 とは独立して転換）
//        ※ 表示バンドは上下それぞれ独立に EMA で平滑化できる（既定 OFF）。
//          平滑化は表示だけに効き、方向転換の判定には使わない。
//     5. 背景（判定方式を 4 種類から選択：突破／方向一致／並び順／なし）
//     6. MTF 方向スコア（※参考表示のみ。背景判定には一切使用しない）
//
//   未実装（意図的に除外）:
//     - 中央の EMA リボン状の雲
//     - エントリー / TP / SL / バックテスト / アラート
//
// ============================================================================
// 【コーディング上の注意】
//   Pine Script は「継続行のインデントが 4 の倍数だと新しいブロック」と解釈する。
//   そのため複数行に分割した三項演算子は構文エラーになりやすい。
//   本スクリプトでは複数行にまたがる三項演算子を一切使わず、
//   すべて if / else if 方式で記述している。
//
// ============================================================================
// 【背景ロジック】
//   元 SATS の背景仕様は未確定である。現時点では推測で仕様を決めず、
//   比較しやすい素直な判定を既定にしてある。
//
//   背景方式（06｜背景設定）:
//     ・価格が3本すべてを突破（既定）
//         判定ソース close のとき、
//           close が STB表示値・LINE1表示値・LINE2表示値の
//           すべてより上 → 青／すべてより下 → 赤／それ以外 → 背景なし
//         いずれかのライン値が na の場合は背景なし。
//         EMA200 や MTF は条件に含めない。保持本数の処理もしない。
//     ・3本の方向が一致 … STB / LINE1 / LINE2 の方向が全部そろう
//     ・3本の並び順     … 比較検証用。選んだ並びが成立している間だけ着色する。
//         ※ これは元 SATS の確定仕様ではない。
//         ※ 逆順を Buy として自動導出することはしない。
//           逆の並びを調べたいときは、選択肢からその並び自体を選ぶこと。
//     ・背景なし        … 背景を出さない
//
// ============================================================================
// 【確定足での更新と、形成中バーの変動について（区別して説明）】
//
//   ■ 方向状態の更新（確定足で行う）
//     「確定足のみで判定」を ON にすると、STB のフィルター状態および
//     EMA ATR Breakout Band の dirState を barstate.isconfirmed のバーでしか
//     更新しない。したがって形成中バーの途中で方向が反転することはない。
//     余分な 1 本の遅延は発生せず、フィルター強度 2 なら
//     「反対方向の確定足 2 本目のクローズ時点」で転換する。
//
//   ■ ライン価格と背景の変動（形成中バーでは動く）
//     方向が固定されていても、表示するライン価格そのものは EMA や ATR、
//     Supertrend のバンド計算から毎ティック再計算されるため、
//     形成中バーの間は上下に動く。背景判定も現在のライン値と価格から
//     毎ティック評価されるため、形成中バーでは点いたり消えたりしうる。
//     バーが確定した時点の値が最終値であり、
//     確定済みバーの履歴が後から書き換わることはない
//     （＝過去のリペイントは発生しない）。
//
//   ■ MTF（上位足・参考表示のみ）
//     request.security(..., lookahead_off) だけでは、リアルタイム進行中の
//     未確定な上位足の値は変動する（＝上位足が閉じるまで値が変わりうる）。
//     lookahead_off が保証するのは「未来の値が過去に漏れないこと」だけで、
//     「現在の上位足の値が動かないこと」ではない。
//     そのため「MTF確定方法」を用意し、既定の「確定した上位足のみ」では
//     request.security() の中で式に [1] を掛け、ひとつ前の "閉じた" 上位足の
//     値を参照する。[1] は security 内部（上位足の時系列）で適用するため、
//     未来の値が過去バーへ漏れることはない。
// ============================================================================

//@version=6
indicator(
     title         = "SAT PANEL Approximation",
     shorttitle    = "SAT PANEL Approx",
     overlay       = true,
     max_bars_back = 1000
 )

// ============================================================================
// 定数定義
// ============================================================================
// input() の group 引数は const string が必要なため、var を付けずに宣言する
G_TF    = "01｜時間軸設定（MTF：参考表示のみ）"
G_STB   = "02｜STB設定"
G_L1    = "03｜SAT's BAND LINE1"
G_L2    = "04｜SAT's BAND LINE2"
G_MA    = "05｜移動平均線"
G_BG    = "06｜背景設定"
G_VIEW  = "07｜比較表示"
G_DEBUG = "08｜デバッグ"

// 方向が未確定（0）のときに使う中立色（グレー）
C_FLAT_DEF = color.rgb(149, 152, 161)

// ラインの計算方式
M_BREAK = "EMA ATR Breakout Band"
M_TRAIL = "ATR Trailing Stop"
M_EMABD = "EMA + ATR Band"
M_SUPER = "現在のSupertrend"

// LINE1 の価格 State 方式
//   LINE2 と同じ考え方で、「上側と下側のどちらの表示バンドを表示価格として採用するか」
//   を決める内部 State の作り方だけを切り替える。表示バンドの計算式には関与しない。
L1_PS_BREAK   = "既存Breakout State"
L1_PS_BANDCFM = "表示Band突破＋確認"
L1_PS_SEPARATE = "専用転換Band＋確認"

// LINE1 CSV検証プリセットの選択肢（LINE2 側の定数とは完全に別）
L1_PRESET_OFF  = "OFF"
L1_PRESET_CAND = "LINE1候補"

// LINE2 の価格 State 方式
//   「上側バンドと下側バンドのどちらを表示価格として採用するか」を決める内部 State の作り方。
//   表示バンドそのものの計算式には関与しない。
L2_PS_BREAK = "既存Breakout State"
L2_PS_ST    = "Supertrend方向＋確認"
L2_PS_ST_ASYM = "Supertrend非対称＋高ボラ補正"

// LINE2 の色判定方式
//   価格を決める内部状態（l2Dir）と、描画色を決める状態（l2ColorDir）を分けるための設定。
L2_COLOR_INTERNAL = "内部状態連動（従来）"
L2_COLOR_CLOSE    = "終値 vs 最終LINE2"

// LINE2 CSV検証プリセットの選択肢
PRESET_OFF = "OFF"
PRESET_CUR = "現行候補"
PRESET_NEW = "新候補"
PRESET_STDISPLAY = "ST表示候補"

// LINE2 の転換判定方式
SW_ATR      = "EMA ± ATRで転換"
SW_CLOSE    = "終値とEMA基準値で転換"
SW_BAND_CUR = "表示バンドで転換（当該足）"
SW_BAND_PRV = "表示バンドで転換（前の足）"
SW_SEPARATE = "専用転換バンドで転換（当該足）"

// 背景の判定方式
BG_PRICE = "価格が3本すべてを突破"
BG_DIR   = "3本の方向が一致"
BG_ORDER = "3本の並び順"
BG_NONE  = "背景なし"

// 下降配列（高い順）の 6 パターン
O_112 = "LINE1 > LINE2 > STB"
O_1S2 = "LINE1 > STB > LINE2"
O_21S = "LINE2 > LINE1 > STB"
O_2S1 = "LINE2 > STB > LINE1"
O_S12 = "STB > LINE1 > LINE2"
O_S21 = "STB > LINE2 > LINE1"

// ============================================================================
// 01｜時間軸設定（MTF：参考表示のみ）
// ============================================================================
// 各時間軸の STB 方向を集計し、MTF 方向スコアを作る。
// ※ 重要：MTF の判定結果は「デバッグテーブルへの表示」だけに使う。
//   背景判定には一切使用しない（将来の比較検討用にコードを残してある）。
// ※ 注意（仕様）：
//   チャート時間足が 15分 / 1時間 などと同じ場合、同じ方向が二重に集計される。
//   初期版では二重集計を許容している。厳密に排除したい場合は各 TF の ON/OFF で調整。
useTfChart = input.bool(true,  "現在のチャート時間足を使う", group = G_TF)
useTf15    = input.bool(true,  "15分足を使う",               group = G_TF)
useTf60    = input.bool(true,  "1時間足を使う",              group = G_TF)
useTf240   = input.bool(true,  "4時間足を使う",              group = G_TF)
useTfD     = input.bool(true,  "日足を使う",                 group = G_TF)
useTfW     = input.bool(true,  "週足を使う",                 group = G_TF)

tf15  = input.timeframe("15",  "15分足の時間足指定",  group = G_TF)
tf60  = input.timeframe("60",  "1時間足の時間足指定", group = G_TF)
tf240 = input.timeframe("240", "4時間足の時間足指定", group = G_TF)
tfD   = input.timeframe("D",   "日足の時間足指定",    group = G_TF)
tfW   = input.timeframe("W",   "週足の時間足指定",    group = G_TF)

mtfConfirmMode = input.string("確定した上位足のみ", "MTF確定方法",
     options = ["確定した上位足のみ", "形成中の上位足も使用"], group = G_TF,
     tooltip = "確定した上位足のみ：request.security() 内で式に [1] を掛け、直前の閉じた上位足の値を使う。\n形成中の上位足も使用：進行中の上位足の現在値を使う（上位足が閉じるまで値が変動する）。")

mtfMode = input.string("指定数以上一致", "MTF一致条件（参考表示のみ）",
     options = ["全時間足一致", "過半数一致", "指定数以上一致"], group = G_TF,
     tooltip = "デバッグテーブルの MTF 判定表示にのみ使用する。背景には影響しない。")
mtfMinAgree = input.int(3, "指定数以上一致：必要本数", minval = 1, maxval = 6, group = G_TF)

// ============================================================================
// 02｜STB設定
// ============================================================================
// STB は元画像どおり「階段状」になる Supertrend 型を維持する。
showStb     = input.bool(true, "STBラインを表示", group = G_STB)
stbSrcType  = input.string("hl2", "STB ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_STB)
stbAtrLen   = input.int(10,  "STB ATR期間", minval = 1, maxval = 200, group = G_STB)
stbFactor   = input.float(2.0, "STB ATR倍率", minval = 0.1, maxval = 20.0, step = 0.1, group = G_STB)
stbFilter   = input.int(2,   "STB フィルター強度（連続確定本数）", minval = 1, maxval = 10, group = G_STB,
     tooltip = "反対方向の生シグナルが指定本数だけ連続で確定したら STB 方向を転換する。それまでは直前の方向を維持。")
stbWidth    = input.int(2,   "STB 線幅", minval = 1, maxval = 5, group = G_STB)
stbUpCol    = input.color(color.rgb(38, 198, 218), "STB 上昇色", group = G_STB)
stbDnCol    = input.color(color.rgb(255, 82, 82),  "STB 下降色", group = G_STB)
useConfirmed = input.bool(true, "確定足のみで判定（リペイント防止）", group = G_STB,
     tooltip = "ON：バーが確定したタイミングでのみ方向状態（dirState）を更新する。形成中バーの途中で方向が反転することはない。余分な 1 本の遅延は発生しない。\nこの設定は STB と EMA ATR Breakout Band の両方に効く。\n※ 方向が固定されていても、表示するライン価格そのものは形成中バーの間は動く（EMA / ATR / バンド計算が毎ティック更新されるため）。背景も同様に形成中は変化しうる。")

// ============================================================================
// 03｜SAT's BAND LINE1
// ============================================================================
// 元画像の LINE1 / LINE2 は階段状の Supertrend ではなく、価格へ滑らかに追従する
// バンド型に見える。既定を EMA ATR Breakout Band とし、方式を切替可能にしてある。
//
// ■ 現在の標準初期値について
//   このセクションの初期値は、元 SAT's PANEL の LINE1 と見比べながら調整した
//   近似設定である。新規追加時・設定リセット時にそのまま使える値として採用している。
//     表示バンド … close → EMA1 → ATR58 × 3.0 → 上下バンドを EMA24 で平滑化
//     価格State … 専用転換Band＋確認
//                 DOWN→UP：EMA55 / ATR10 / ×4.0 / Smooth30 / Confirm3
//                 UP→DOWN：EMA34 / ATR58 / ×3.75 / Smooth20 / Confirm4
//   ※ ある検証期間で見た目が近かったというだけの近似値であり、
//     元 SAT's PANEL の計算式を特定したものではない。他の期間・他の銘柄で
//     同じように合う保証はないので、必要に応じて各値を調整すること。
//   ※ 旧初期値（EMA50 / ATR10 / 表示倍率2.5 / 平滑化OFF / 既存Breakout State）で
//     比較したい場合は、各 input を手動で戻せば従来どおりの挙動になる。
showL1     = input.bool(true, "BAND LINE1 を表示", group = G_L1)
l1Method   = input.string(M_BREAK, "LINE1 計算方式",
     options = ["EMA ATR Breakout Band", "ATR Trailing Stop", "EMA + ATR Band", "現在のSupertrend"], group = G_L1,
     tooltip = "EMA ATR Breakout Band：EMA±ATR×倍率のバンドを毎バー再計算。終値がバンドを抜けて確定したら方向転換。バンド値の切り上げ／切り下げ固定は行わないので滑らか。\nATR Trailing Stop：UT Bot 系のトレーリングストップ\nEMA + ATR Band：EMA を基準に片側バンドを表示\n現在のSupertrend：STB と同じ階段状")
l1SrcType  = input.string("close", "LINE1 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L1,
     tooltip = "標準初期値は close。表示バンドの basis に使う。")
l1EmaLen   = input.int(1,   "LINE1 EMA期間", minval = 1, maxval = 500, group = G_L1,
     tooltip = "表示バンドの basis に使う EMA 期間。標準初期値 1（＝ソースそのもの）は、元 LINE1 との比較で採用した近似設定。")
l1AtrLen   = input.int(58,  "LINE1 ATR期間", minval = 1, maxval = 200, group = G_L1,
     tooltip = "表示バンドの幅に使う ATR 期間。標準初期値 58 は、元 LINE1 との比較で採用した近似設定。")
// --- EMA ATR Breakout Band 専用の 2 倍率 ---
//   転換判定と表示位置で別々の倍率を使うため、
//   「転換は鈍いが表示は価格に近い」といった調整ができる。
l1SwMult   = input.float(4.0, "LINE1 転換判定ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "EMA ATR Breakout Band の方向転換の判定にだけ使う倍率。大きくするほど転換が鈍くなる。\n表示バンドの幅（basis からの距離）そのものは変えないが、方向が変われば表示する側が上バンド／下バンドで入れ替わるため、見た目の位置は変わりうる。\n※ 価格State方式が「既存Breakout State」のときだけ最終 State に影響する。標準初期値の「専用転換Band＋確認」では最終 State には使われないため、値は 4.0 のままにしてある。")
l1DpMult   = input.float(3.0, "LINE1 表示ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "EMA ATR Breakout Band の表示位置にだけ使う倍率。大きくするほど表示ラインが basis から離れる。\n「既存Breakout State」の方向転換の判定には一切使わない。\n標準初期値 3.0 は、元 LINE1 との比較で採用した近似設定。")
// --- Breakout 以外の 3 方式が使う倍率（従来どおり） ---
l1Factor   = input.float(2.5, "LINE1 ATR倍率（Breakout以外の方式用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L1,
     tooltip = "ATR Trailing Stop / EMA + ATR Band / 現在のSupertrend で使う倍率。EMA ATR Breakout Band には影響しない。")
// --- 表示バンドの平滑化（EMA ATR Breakout Band 専用） ---
//   rawUpper / rawLower にそれぞれ独立して EMA をかける。
//   転換判定には平滑化後の値を使わない（switchUpper / switchLower は生のまま）。
l1Smooth    = input.bool(true, "LINE1 表示バンド平滑化", group = G_L1,
     tooltip = "ON：表示に使う上下バンドを、それぞれ独立に EMA で平滑化する。\n「既存Breakout State」の方向転換の判定は平滑化前の値で行うため、その方式では転換タイミングは変わらない。\nEMA ATR Breakout Band を選んでいるときだけ効く。\n標準初期値 ON は、元 LINE1 との比較で採用した近似設定。")
l1SmoothLen = input.int(24, "LINE1 平滑化期間", minval = 1, maxval = 200, group = G_L1,
     tooltip = "表示バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている（比較モードで参照するため）。\n標準初期値 24 は、元 LINE1 との比較で採用した近似設定。")
l1Width    = input.int(2,   "LINE1 線幅", minval = 1, maxval = 5, group = G_L1)
l1UpCol    = input.color(color.rgb(38, 198, 218), "LINE1 上昇色", group = G_L1)
l1DnCol    = input.color(color.rgb(255, 82, 82),  "LINE1 下降色", group = G_L1)

// --- 価格 State 方式（上下どちらの表示バンドを採用するかだけを決める） ---
//   表示バンドの計算式（EMA / ATR / 倍率 / 平滑化）には一切関与しない。
//   標準初期値は「専用転換Band＋確認」。元 LINE1 との比較で採用した近似設定であり、
//   元 SAT's PANEL の計算式を特定したものではない。
//   従来挙動で比較したい場合は「既存Breakout State」を手動で選べばよい。
l1PsMode = input.string(L1_PS_SEPARATE, "LINE1 価格State方式",
     options = ["既存Breakout State", "表示Band突破＋確認", "専用転換Band＋確認"], group = G_L1,
     tooltip = "既存Breakout State（従来方式）：これまでどおり f_emaAtrBreakout() の内部 State で上下バンドを選ぶ。従来互換。\n表示Band突破＋確認（検証用）：いま採用している側と反対の表示バンドを終値が突破した状態が、指定本数連続したら転換する。\n\n・DOWN(-1) のとき close > 上側表示バンド が確認本数ぶん連続 → UP(+1)\n・UP(+1) のとき close < 下側表示バンド が確認本数ぶん連続 → DOWN(-1)\n・途中で条件が崩れたら、その方向の連続カウントは 0 に戻る\n・上下両方を同時に見るのではなく、現在の State に応じて反対側への突破だけを見る\n\n※ どちらを選んでも表示バンドの計算式は変わらない。決まるのは『上側と下側のどちらを表示価格として採用するか』だけ。\n専用転換Band＋確認（検証用）：表示バンドとは別に計算した『転換判定専用バンド』を終値が突破した状態が、指定本数連続したら転換する。DOWN→UP 用と UP→DOWN 用で EMA期間 / ATR期間 / 倍率 / 平滑化 / 確認本数をすべて別々に設定できる。設定は下の『LINE1 専用転換…』側で行う。\n\n※ どの方式を選んでも表示バンドの計算式は変わらない。決まるのは『上側と下側のどちらを表示価格として採用するか』だけ。\n※ 専用転換バンドは判定にだけ使い、LINE1 の表示価格には絶対に使わない。\n※ 転換後の完成 LINE1 へ追加の EMA はかけない。\n※ LINE1 計算方式が EMA ATR Breakout Band のときだけ適用される。\n\n標準初期値は「専用転換Band＋確認」。元 LINE1 との比較で採用した近似設定であり、元 SATS の計算式を特定したものではない。従来どおりの挙動と比べたいときは「既存Breakout State」を選ぶ。")
l1BandCfmBars = input.int(3, "LINE1 Band突破 確認本数", minval = 1, maxval = 10, group = G_L1,
     tooltip = "「表示Band突破＋確認」で転換に必要な連続本数。\n初期化（State が 0 の状態から最初の方向を決めるとき）にはこの確認本数を要求しない。中点との比較で即決する。\n『確定足のみで判定』が ON のとき、カウントは確定したバーでしか進まない。")

// --- 価格State：専用転換Band（表示バンドとは完全に独立した判定専用バンド） ---
//   表示価格を作るバンドと、上下どちらを採用するかを決めるしきい値を分離して検証するための設定。
//   ソースだけ共通で、EMA期間 / ATR期間 / 倍率 / 平滑化 / 確認本数は
//   DOWN→UP 用と UP→DOWN 用で完全に別々に持つ。
//   標準初期値は、元 LINE1 との比較で採用した近似設定。
//     DOWN→UP：EMA55 / ATR10 / ×4.0  / Smooth30 / Confirm3
//     UP→DOWN：EMA34 / ATR58 / ×3.75 / Smooth20 / Confirm4
//   上昇転換と下降転換で条件が非対称なのは意図的で、元 SATS の計算式を特定したものではない。
//   ※ LINE1 CSV検証プリセットからは一切上書きしない。表示バンド側の設定とも独立。
l1StateSrcType = input.string("close", "LINE1 専用転換ソース",
     options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L1,
     tooltip = "専用転換バンドのソース。DOWN→UP 用と UP→DOWN 用で共通。\n表示バンドのソース（LINE1 ソース／CSV検証プリセット）からは完全に独立。")

l1StateUpEmaLen    = input.int(55, "LINE1 DOWN→UP 転換EMA期間", minval = 1, maxval = 500, group = G_L1,
     tooltip = "DOWN → UP 判定に使う上側専用バンドの EMA 期間。")
l1StateUpAtrLen    = input.int(10, "LINE1 DOWN→UP 転換ATR期間", minval = 1, maxval = 500, group = G_L1,
     tooltip = "DOWN → UP 判定に使う上側専用バンドの ATR 期間。")
l1StateUpMult      = input.float(4.0, "LINE1 DOWN→UP 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L1,
     tooltip = "DOWN → UP 判定に使う上側専用バンドの ATR 倍率。\n小さくすると上昇転換が早くなり、大きくすると遅くなる。")
l1StateUpSmooth    = input.bool(true, "LINE1 DOWN→UP 転換Band平滑化", group = G_L1,
     tooltip = "ON：上側専用バンドを EMA で平滑化してから判定に使う。")
l1StateUpSmoothLen = input.int(30, "LINE1 DOWN→UP 転換平滑化期間", minval = 1, maxval = 200, group = G_L1,
     tooltip = "上側専用バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている。")
l1StateUpConfirm   = input.int(3, "LINE1 DOWN→UP 確認本数", minval = 1, maxval = 10, group = G_L1,
     tooltip = "DOWN 中に close > 上側専用バンド が何本連続したら UP へ転換するか。\n条件が 1 本でも崩れたらカウントは 0 に戻る。")

l1StateDnEmaLen    = input.int(34, "LINE1 UP→DOWN 転換EMA期間", minval = 1, maxval = 500, group = G_L1,
     tooltip = "UP → DOWN 判定に使う下側専用バンドの EMA 期間。")
l1StateDnAtrLen    = input.int(58, "LINE1 UP→DOWN 転換ATR期間", minval = 1, maxval = 500, group = G_L1,
     tooltip = "UP → DOWN 判定に使う下側専用バンドの ATR 期間。")
l1StateDnMult      = input.float(3.75, "LINE1 UP→DOWN 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L1,
     tooltip = "UP → DOWN 判定に使う下側専用バンドの ATR 倍率。\n小さくすると下降転換が早くなり、大きくすると遅くなる。")
l1StateDnSmooth    = input.bool(true, "LINE1 UP→DOWN 転換Band平滑化", group = G_L1,
     tooltip = "ON：下側専用バンドを EMA で平滑化してから判定に使う。")
l1StateDnSmoothLen = input.int(20, "LINE1 UP→DOWN 転換平滑化期間", minval = 1, maxval = 200, group = G_L1,
     tooltip = "下側専用バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている。")
l1StateDnConfirm   = input.int(4, "LINE1 UP→DOWN 確認本数", minval = 1, maxval = 10, group = G_L1,
     tooltip = "UP 中に close < 下側専用バンド が何本連続したら DOWN へ転換するか。\n条件が 1 本でも崩れたらカウントは 0 に戻る。")

// --- CSV 検証プリセット（LINE1 のみ・表示バンド側だけを強制する） ---
l1PresetMode = input.string("OFF", "LINE1 CSV検証プリセット",
     options = ["OFF", "LINE1候補"], group = G_L1,
     tooltip = "OFF（既定）：上の LINE1 設定をそのまま使う。計算結果は従来どおり。\nLINE1候補：計算方式＝EMA ATR Breakout Band / ソース＝close / EMA期間 1 / ATR期間 58 / 表示ATR倍率 3.0 / 表示バンド平滑化 ON・期間 24 を強制する。表示用 ATR の追加平滑化は使わない（OFF のまま）。\n\nCSV で探索した候補を整数期間へ丸めた検証用の設定であり、元 SATS の計算式を特定したものではない。ある検証期間で誤差が小さかったというだけで、他の期間でも良いとは限らない。\n\n※ このプリセットは表示バンド側だけを変更する。価格State方式・Band突破の確認本数・線幅・色・転換判定ATR倍率は変更しない。\n※ LINE2 / STB / EMA200 / 背景 / MTF には一切関与しない。")

// ----------------------------------------------------------------------------
// LINE1 の実効設定（CSV検証プリセットを反映した最終値）
//   以降の LINE1 計算・診断表示はすべてこの実効設定を参照する。
//   ※ 三項演算子で組み立てているのは、ta.ema() / ta.atr() の length に
//     simple int を渡す必要があるため（if ブロックでは series になる）。
//   ※ 転換判定ATR倍率（l1SwMult）、Breakout以外の方式用の倍率（l1Factor）、
//     線幅・色・価格State方式・確認本数はプリセットの対象外。
// ----------------------------------------------------------------------------
//   LINE1候補 … EMA 1 / ATR 58 / 表示倍率 3.0 / 表示用ATR平滑化 OFF / バンド平滑化 ON(24)
l1EffMethod    = l1PresetMode == L1_PRESET_CAND ? M_BREAK : l1Method
l1EffSrcType   = l1PresetMode == L1_PRESET_CAND ? "close" : l1SrcType
l1EffEmaLen    = l1PresetMode == L1_PRESET_CAND ? 1       : l1EmaLen
l1EffAtrLen    = l1PresetMode == L1_PRESET_CAND ? 58      : l1AtrLen
l1EffDpMult    = l1PresetMode == L1_PRESET_CAND ? 3.0     : l1DpMult
l1EffSmooth    = l1PresetMode == L1_PRESET_CAND ? true    : l1Smooth
l1EffSmoothLen = l1PresetMode == L1_PRESET_CAND ? 24      : l1SmoothLen

// ============================================================================
// 04｜SAT's BAND LINE2
// ============================================================================
// LINE2 は LINE1 と完全に独立した状態変数を持つ（別々に方向転換する）。
showL2     = input.bool(true, "BAND LINE2 を表示", group = G_L2)
l2Method   = input.string("EMA ATR Breakout Band", "LINE2 計算方式",
     options = ["EMA ATR Breakout Band", "ATR Trailing Stop", "EMA + ATR Band", "現在のSupertrend"], group = G_L2,
     tooltip = "EMA ATR Breakout Band：EMA±ATR×倍率のバンドを毎バー再計算。終値がバンドを抜けて確定したら方向転換。バンド値の切り上げ／切り下げ固定は行わないので滑らか。\nATR Trailing Stop：UT Bot 系のトレーリングストップ\nEMA + ATR Band：EMA を基準に片側バンドを表示\n現在のSupertrend：STB と同じ階段状")
l2SrcType  = input.string("close", "LINE2 ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2)
l2EmaLen   = input.int(21,  "LINE2 EMA期間", minval = 1, maxval = 500, group = G_L2)
l2AtrLen   = input.int(10,  "LINE2 ATR期間", minval = 1, maxval = 200, group = G_L2)
// --- EMA ATR Breakout Band 専用の 2 倍率 ---
l2SwMult   = input.float(4.0, "LINE2 転換判定ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "EMA ATR Breakout Band の方向転換の判定にだけ使う倍率。大きくするほど転換が鈍くなる。\n表示バンドの幅（basis からの距離）そのものは変えないが、方向が変われば表示する側が上バンド／下バンドで入れ替わるため、見た目の位置は変わりうる。")
l2DpMult   = input.float(3.0, "LINE2 表示ATR倍率（Breakout用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "EMA ATR Breakout Band の表示位置にだけ使う倍率。大きくするほど表示ラインが basis から離れる。\n方向転換の判定には一切使わないため、過去の転換タイミングは変わらない。")
// --- Breakout 以外の 3 方式が使う倍率（従来どおり） ---
l2Factor   = input.float(2.0, "LINE2 ATR倍率（Breakout以外の方式用）", minval = 0.1, maxval = 20.0, step = 0.1, group = G_L2,
     tooltip = "ATR Trailing Stop / EMA + ATR Band / 現在のSupertrend で使う倍率。EMA ATR Breakout Band には影響しない。")
// --- 表示バンドの平滑化（EMA ATR Breakout Band 専用） ---
// --- 転換判定方式（EMA ATR Breakout Band 専用） ---
//   元 SATS と自作で転換タイミングが違う件を検証するための切り替え。
//   元の計算式を特定したわけではないので、現行方式を既定のまま残してある。
l2SwitchMode = input.string("EMA ± ATRで転換", "LINE2 転換判定方式",
     options = ["EMA ± ATRで転換", "終値とEMA基準値で転換", "表示バンドで転換（当該足）", "表示バンドで転換（前の足）", "専用転換バンドで転換（当該足）"], group = G_L2,
     tooltip = "EMA ± ATRで転換（現行・既定）：終値が switchUpper / switchLower を抜けたら転換する。\n終値とEMA基準値で転換（検証用）：終値と平滑化前の EMA 基準値 basis を直接比べ、close > basis で上昇、close < basis で下降にする。同値なら前の方向を維持。\n表示バンドで転換（当該足）：実効設定を反映した displayUpper / displayLower を判定に使う。下降中は close > displayUpper で上昇へ、上昇中は close < displayLower で下降へ。バンドの間・同値では方向を維持する。\n表示バンドで転換（前の足）：判定に displayUpper[1] / displayLower[1] を使う。表示する価格は当該足のバンドのままで、遅らせない。\n専用転換バンドで転換（当該足）：表示バンドとは完全に別の「転換専用バンド」（下の 転換専用EMA期間 / ATR期間 / ATR倍率 / バンド平滑化 / 平滑化期間）で判定する。表示ラインの計算は表示用設定のままで一切変わらない。\n\n※ 表示バンド方式の初期化：判定用バンドが有効になるまで方向 0 を維持し、最初の有効な更新で close が上下バンドの中点より上なら +1、下なら -1、同値なら 0 のまま次の更新で再判定する。\n※ この設定は LINE2 の実効計算方式が「EMA ATR Breakout Band」のときだけ適用される。ATR Trailing Stop / EMA + ATR Band / 現在のSupertrend を選んでいる場合は無効。\n※ 確定足のみで判定の設定はそのまま効く（確定足モードでは足が確定したときだけ方向を更新する）。\n※ 判定は終値のみ。高値・安値による突破は使わない。")

// --- 表示用 ATR の平滑化（EMA ATR Breakout Band 専用・表示位置だけに効く） ---
//   ATR 幅の急拡大が表示バンドをどれだけ押し下げるかを検証するための設定。
//   ※ 元 SATS の計算式がこうであると断定するものではない。
l2AtrSmooth    = input.bool(false, "LINE2 表示用ATR平滑化", group = G_L2,
     tooltip = "ON：表示バンドを作るときの ATR に EMA をかける（ATR 幅の急拡大をなだらかにする）。\n方向転換の判定には従来どおり平滑化前の ATR を使うため、転換履歴は変わらない。\nEMA ATR Breakout Band を選んでいるときだけ効く。")
l2AtrSmoothLen = input.int(10, "LINE2 表示用ATR平滑化期間", minval = 1, maxval = 200, group = G_L2,
     tooltip = "表示用 ATR にかける EMA の期間。1 を指定すると EMA の係数が 1 になり、平滑化前と同じ値になる。\nOFF のときも毎バー計算している（比較モードで参照するため）。")

l2Smooth    = input.bool(false, "LINE2 表示バンド平滑化", group = G_L2,
     tooltip = "ON：表示に使う上下バンドを、それぞれ独立に EMA で平滑化する。\n方向転換の判定は平滑化前の値で行うため、転換タイミングは変わらない。\nEMA ATR Breakout Band を選んでいるときだけ効く。")
l2SmoothLen = input.int(5, "LINE2 平滑化期間", minval = 1, maxval = 200, group = G_L2,
     tooltip = "表示バンドにかける EMA の期間。平滑化 OFF でも毎バー計算はしている（比較モードで参照するため）。")
// --- 価格 State 方式（上下どちらの表示バンドを採用するかだけを決める） ---
//   ※ CSV検証プリセットからは上書きしない。表示バンド側とは独立して検証する。
l2PsMode = input.string("既存Breakout State", "LINE2 価格State方式",
     options = ["既存Breakout State", "Supertrend方向＋確認", "Supertrend非対称＋高ボラ補正"], group = G_L2,
     tooltip = "既存Breakout State（既定）：これまでどおり f_emaAtrBreakout() の内部 State で上下バンドを選ぶ。\nSupertrend方向＋確認（検証用）：Supertrend の方向（確認本数つき）で上下バンドを選ぶ。\nSupertrend非対称＋高ボラ補正（検証用）：上昇転換と下降転換で別々の Factor を使い、さらに高ボラ時だけ下降転換を早める。設定は下の『非対称ST』側で行う（上の ST 設定とは完全に独立）。\n\n※ どちらを選んでも表示バンドの計算式（EMA / ATR / 倍率 / 平滑化）は変わらない。決まるのは『上側と下側のどちらを表示価格として採用するか』だけ。\n※ Supertrend のライン価格そのものは LINE2 として表示しない。使うのは方向だけ。\n※ LINE2 計算方式が EMA ATR Breakout Band のときだけ適用される。\n※ 色判定方式とは別処理。色は完成した LINE2 と終値の比較で決まる。")

l2PsStSrcType = input.string("close", "LINE2 価格State STソース",
     options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2,
     tooltip = "価格State用 Supertrend のソース。表示バンドのソースとも CSV検証プリセットとも独立。")
l2PsStAtrLen  = input.int(43, "LINE2 価格State ST ATR期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "価格State用 Supertrend の ATR 期間。表示バンドの ATR 期間とは独立。")
l2PsStFactor  = input.float(4.71, "LINE2 価格State ST Factor", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "価格State用 Supertrend の ATR 倍率。表示バンドの倍率とは独立。")
l2PsStFilter  = input.int(2, "LINE2 価格State ST 確認本数", minval = 1, maxval = 10, group = G_L2,
     tooltip = "Supertrendの生方向が反対方向へ指定本数連続した時点で、LINE2の内部価格Stateを転換する。LINE2の色判定とは別。")

// --- 価格State：Supertrend非対称＋高ボラ補正（検証用） ---
//   上の「Supertrend方向＋確認」の設定とは完全に独立。A/B 比較のため両方を残している。
//   CSV検証プリセットからも上書きしない。表示バンド側の設定にも一切関与しない。
l2PsAsymSrcType = input.string("close", "LINE2 価格State 非対称STソース",
     options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2,
     tooltip = "非対称 Supertrend のソース。表示バンドのソース・CSV検証プリセット・上の ST ソースのいずれからも独立。")
l2PsAsymAtrLen  = input.int(43, "LINE2 価格State 非対称ST ATR期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "非対称 Supertrend の ATR 期間。上下バンドで共通に使う。高ボラ判定の比率もこの ATR で計算する。")
l2PsAsymUpFac   = input.float(4.83, "LINE2 価格State 非対称ST 上昇Factor（DOWN→UP）", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "DOWN → UP の判定に使う上側トレーリングバンドの ATR 倍率。\n小さくすると上昇転換が早くなり、大きくすると遅くなる。\nボラティリティによる切り替えは行わず、常にこの値を使う。")
l2PsAsymDnFac   = input.float(4.71, "LINE2 価格State 非対称ST 下降Factor（通常）", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "UP → DOWN の判定に使う下側トレーリングバンドの ATR 倍率（通常時）。\n高ボラしきい値を下回っている間はこの値を使う。")
l2PsAsymDnFacHV = input.float(4.49, "LINE2 価格State 非対称ST 下降Factor（高ボラ）", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "UP → DOWN の判定に使う下側トレーリングバンドの ATR 倍率（高ボラ時）。\n通常側より小さくすると、高ボラ時だけ下降転換が早くなる。")
l2PsAsymVolTh   = input.float(0.0018, "LINE2 価格State 非対称ST 高ボラしきい値（ATR/close）", minval = 0.0, maxval = 1.0, step = 0.0001, group = G_L2,
     tooltip = "高ボラ判定の比率。stateVolRatio = ATR / close がこの値以上のバーで、下降側の倍率を高ボラ用へ切り替える。\n0.0018 = 0.18% = 18bp。\n判定は当該バーの確定値で行い、未来の情報は使わない。")
l2PsAsymFilter  = input.int(2, "LINE2 価格State 非対称ST 確認本数", minval = 1, maxval = 10, group = G_L2,
     tooltip = "非対称 Supertrend の生方向が反対方向へ指定本数連続した時点で、LINE2 の内部価格 State を転換する。\n上の ST 側とは別の f_filterDir() 状態を使うため、互いに干渉しない。LINE2 の色判定とも別。")

// --- 色判定方式（LINE2 の描画色だけを内部価格状態から独立させる） ---
l2ColorMode = input.string("内部状態連動（従来）", "LINE2 色判定方式",
     options = ["内部状態連動（従来）", "終値 vs 最終LINE2"], group = G_L2,
     tooltip = "内部状態連動（従来・既定）：LINE2 の価格を決めている内部状態 l2Dir をそのまま描画色にも使う。従来どおりの挙動。\n終値 vs 最終LINE2（検証用）：チャートに実際に表示されている LINE2 の価格と終値を比べて色を決める。\n  close > 表示中のLINE2 → 青\n  close < 表示中のLINE2 → 赤\n  同値 → 直前の色を維持\n\n※ 比較対象は rawUpper / rawLower / displayUpper / displayLower / switchUpper / switchLower ではなく、最終的に描画される l2DisplayLine そのもの。\n※ 判定は終値のみ。高値・安値は使わない。\n※ どちらを選んでも LINE2 の価格計算は一切変わらない。変わるのは描画色と LINE2 の転換確認マーカーだけ。\n※ 背景ロジックは今回は従来どおり内部状態を参照する。")

// --- 転換専用バンド（転換判定方式が「専用転換バンドで転換（当該足）」のときだけ使う） ---
//   表示ラインとは完全に独立した設定。CSV検証プリセットからは上書きしない。
//   転換専用 ATR そのものの平滑化機能は用意していない（探索を複雑にしないため）。
l2SepSrcType = input.string("close", "LINE2 転換専用ソース",
     options = ["close", "hl2", "open", "hlc3", "ohlc4", "hlcc4"], group = G_L2,
     tooltip = "転換専用バンドの中心線に使うソース。\n表示ラインのソース（LINE2 ソース）とも、CSV検証プリセットが強制するソースとも完全に独立している。\n初期値 close。")
// 赤→青（下降 -1 → 上昇 +1）専用の上側しきい値を作る設定
l2SepUpEmaLen = input.int(1, "LINE2 赤→青 転換EMA期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "赤→青 用の中心線 ta.ema(転換専用ソース, 期間) に使う期間。\n青→赤 用の設定とも、表示ラインの EMA 期間とも独立。CSV検証プリセットの影響も受けない。")
l2SepUpAtrLen = input.int(100, "LINE2 赤→青 転換ATR期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "赤→青 用の ta.atr(期間) に使う期間。青→赤 用とも表示ラインとも独立。")
l2SepUpMult   = input.float(1.58, "LINE2 赤→青 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "下降（赤）から上昇（青）へ転換するときの上側しきい値に使う倍率。\nl2SepRawUp = 赤→青用中心線 + 赤→青用ATR × この倍率。\n\n小さくすると上側しきい値が下がるので 赤→青 が早くなる。\n大きくすると上側しきい値が上がるので 赤→青 が遅くなる。\n\n青→赤 の転換には影響しない。表示ATR倍率とも独立。")
l2SepUpSmooth = input.bool(true, "LINE2 赤→青 転換バンド平滑化", group = G_L2,
     tooltip = "ON：赤→青用の上側バンドに EMA をかける。OFF：raw 値をそのまま判定に使う。\n青→赤 用の平滑化設定とも、表示バンドの平滑化設定とも独立。")
l2SepUpSmLen  = input.int(12, "LINE2 赤→青 転換平滑化期間", minval = 1, maxval = 200, group = G_L2,
     tooltip = "赤→青用の上側バンドにかける EMA の期間。OFF のときも毎バー計算している。")

// 青→赤（上昇 +1 → 下降 -1）専用の下側しきい値を作る設定
l2SepDnEmaLen = input.int(1, "LINE2 青→赤 転換EMA期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "青→赤 用の中心線 ta.ema(転換専用ソース, 期間) に使う期間。\n赤→青 用の設定とも、表示ラインの EMA 期間とも独立。CSV検証プリセットの影響も受けない。")
l2SepDnAtrLen = input.int(100, "LINE2 青→赤 転換ATR期間", minval = 1, maxval = 500, group = G_L2,
     tooltip = "青→赤 用の ta.atr(期間) に使う期間。赤→青 用とも表示ラインとも独立。")
l2SepDnMult   = input.float(1.58, "LINE2 青→赤 転換ATR倍率", minval = 0.1, maxval = 20.0, step = 0.01, group = G_L2,
     tooltip = "上昇（青）から下降（赤）へ転換するときの下側しきい値に使う倍率。\nl2SepRawLo = 青→赤用中心線 - 青→赤用ATR × この倍率。\n\n小さくすると下側しきい値が上がるので 青→赤 が早くなる。\n大きくすると下側しきい値が下がるので 青→赤 が遅くなる。\n\n赤→青 の転換には影響しない。表示ATR倍率とも独立。")
l2SepDnSmooth = input.bool(true, "LINE2 青→赤 転換バンド平滑化", group = G_L2,
     tooltip = "ON：青→赤用の下側バンドに EMA をかける。OFF：raw 値をそのまま判定に使う。\n赤→青 用の平滑化設定とも、表示バンドの平滑化設定とも独立。")
l2SepDnSmLen  = input.int(12, "LINE2 青→赤 転換平滑化期間", minval = 1, maxval = 200, group = G_L2,
     tooltip = "青→赤用の下側バンドにかける EMA の期間。OFF のときも毎バー計算している。")

// --- CSV 検証プリセット（LINE2 のみ） ---
l2PresetMode = input.string("OFF", "LINE2 CSV検証プリセット",
     options = ["OFF", "現行候補", "新候補", "ST表示候補"], group = G_L2,
     tooltip = "OFF（既定）：上の LINE2 設定をそのまま使う。計算結果は従来どおり。\n\n現行候補  ：EMA期間 2 / ATR期間 100 / 表示ATR倍率 1.533 / 表示用ATR平滑化 OFF / 表示バンド平滑化 ON・期間 10\n新候補    ：EMA期間 1 / ATR期間 100 / 表示ATR倍率 1.58  / 表示用ATR平滑化 OFF / 表示バンド平滑化 ON・期間 12\nST表示候補：EMA2 / ATR30 / 表示ATR倍率1.675 / 表示用ATR平滑化ON・40 / 表示バンド平滑化ON・9\nいずれも 計算方式＝EMA ATR Breakout Band / ソース＝close を強制する。\n\nCSV で探索した候補を整数期間へ丸めた検証用の設定であり、元 SATS の計算式を特定したものではない。ある検証期間で元 LINE2 との平均誤差が小さかったというだけで、他の期間でも良いとは限らない。\n\n※ このプリセットは表示バンド側だけを変更する。LINE2 価格State方式・Supertrend 価格State設定（STソース / ST ATR期間 / ST Factor / ST確認本数）・色判定方式は変更しない。\n\nOFF 以外の間、上の『LINE2 計算方式 / ソース / EMA期間 / ATR期間 / 表示ATR倍率 / 表示用ATR平滑化とその期間 / 表示バンド平滑化とその期間』の手動設定は無効になる（値は保持されるが使われない）。\n無効にならない設定：価格State方式と Supertrend 価格State設定、色判定方式、転換判定方式、転換判定ATR倍率、ATR倍率（Breakout以外の方式用）、線幅、色、確定足のみで判定。\n\n※ 転換判定式は basis と ATR を参照するため、プリセットでそれらが変わると Breakout 側の方向の結果も変わりうる（価格State方式が Supertrend のときは最終的な上下選択には使われない）。")

l2Width    = input.int(2,   "LINE2 線幅", minval = 1, maxval = 5, group = G_L2)
l2UpCol    = input.color(color.rgb(38, 198, 218), "LINE2 上昇色", group = G_L2)
l2DnCol    = input.color(color.rgb(255, 82, 82),  "LINE2 下降色", group = G_L2)

// ----------------------------------------------------------------------------
// LINE2 の実効設定
//   ユーザーの入力値は書き換えず、実際に計算へ渡す値をここでまとめる。
//   LINE2 の本体計算・上下バンド比較・中心線・固定ATR比較・データウィンドウ・
//   デバッグ表示は、すべてこの実効設定を参照する。
//   ※ 三項演算子で組み立てているのは、ta.ema() / ta.atr() の length に
//     simple int を渡す必要があるため（if ブロックでは series になる）。
//   ※ 転換判定方式（l2SwitchMode）と転換判定ATR倍率（l2SwMult）、
//     Breakout以外の方式用の倍率（l2Factor）、線幅・色はプリセットの対象外。
// ----------------------------------------------------------------------------
//   現行候補   … EMA 2 / ATR 100 / 表示倍率 1.533 / ATR平滑化 OFF     / バンド平滑化 ON(10)
//   新候補     … EMA 1 / ATR 100 / 表示倍率 1.58  / ATR平滑化 OFF     / バンド平滑化 ON(12)
//   ST表示候補 … EMA 2 / ATR  30 / 表示倍率 1.675 / ATR平滑化 ON(40)  / バンド平滑化 ON(9)
//   ※ いずれも表示バンド側だけを変える。価格State方式・Supertrend 価格State設定・
//     色判定方式には一切関与しない。
l2EffMethod       = l2PresetMode == PRESET_CUR ? M_BREAK : l2PresetMode == PRESET_NEW ? M_BREAK : l2PresetMode == PRESET_STDISPLAY ? M_BREAK : l2Method
l2EffSrcType      = l2PresetMode == PRESET_CUR ? "close" : l2PresetMode == PRESET_NEW ? "close" : l2PresetMode == PRESET_STDISPLAY ? "close" : l2SrcType
l2EffEmaLen       = l2PresetMode == PRESET_CUR ? 2       : l2PresetMode == PRESET_NEW ? 1       : l2PresetMode == PRESET_STDISPLAY ? 2       : l2EmaLen
l2EffAtrLen       = l2PresetMode == PRESET_CUR ? 100     : l2PresetMode == PRESET_NEW ? 100     : l2PresetMode == PRESET_STDISPLAY ? 30      : l2AtrLen
l2EffDpMult       = l2PresetMode == PRESET_CUR ? 1.533   : l2PresetMode == PRESET_NEW ? 1.58    : l2PresetMode == PRESET_STDISPLAY ? 1.675   : l2DpMult
l2EffAtrSmooth    = l2PresetMode == PRESET_CUR ? false   : l2PresetMode == PRESET_NEW ? false   : l2PresetMode == PRESET_STDISPLAY ? true    : l2AtrSmooth
l2EffAtrSmoothLen = l2PresetMode == PRESET_CUR ? 10      : l2PresetMode == PRESET_NEW ? 10      : l2PresetMode == PRESET_STDISPLAY ? 40      : l2AtrSmoothLen
l2EffSmooth       = l2PresetMode == PRESET_CUR ? true    : l2PresetMode == PRESET_NEW ? true    : l2PresetMode == PRESET_STDISPLAY ? true    : l2Smooth
l2EffSmoothLen    = l2PresetMode == PRESET_CUR ? 10      : l2PresetMode == PRESET_NEW ? 12      : l2PresetMode == PRESET_STDISPLAY ? 9       : l2SmoothLen

// ============================================================================
// 05｜移動平均線
// ============================================================================
showMa    = input.bool(true, "移動平均線を表示", group = G_MA)
maType    = input.string("EMA", "MA 種別", options = ["EMA", "SMA", "RMA", "WMA"], group = G_MA)
maLen     = input.int(200, "MA 期間", minval = 1, maxval = 1000, group = G_MA)
maSrcType = input.string("close", "MA ソース", options = ["hl2", "close", "open", "hlc3", "ohlc4", "hlcc4"], group = G_MA)
maWidth   = input.int(2, "MA 線幅", minval = 1, maxval = 5, group = G_MA)
maUpCol   = input.color(color.rgb(38, 198, 218), "MA 上昇色", group = G_MA)
maDnCol   = input.color(color.rgb(255, 82, 82),  "MA 下降色", group = G_MA)
maFlatCol = input.color(color.rgb(149, 152, 161), "MA 中立色", group = G_MA)

// ============================================================================
// 06｜背景設定
// ============================================================================
// 既定は「価格が3本すべてを突破」。元 SATS の仕様が未確定のため、
// 推測を含まない素直な判定を初期値にしてある。
bgMode = input.string("価格が3本すべてを突破", "背景方式",
     options = ["価格が3本すべてを突破", "3本の方向が一致", "3本の並び順", "背景なし"], group = G_BG,
     tooltip = "価格が3本すべてを突破（既定）：判定ソースの価格が STB表示値・LINE1表示値・LINE2表示値のすべてより上なら青、すべてより下なら赤、それ以外は背景なし。いずれかが na なら背景なし。EMA200 と MTF は条件に含めない。\n3本の方向が一致：STB / LINE1 / LINE2 の方向が全部そろったら背景\n3本の並び順：比較検証用。選んだ並びが成立している間だけ着色する（元 SATS の確定仕様ではない）\n背景なし：背景を描かない")

bgSrcMode = input.string("close", "背景判定ソース（突破方式のみ）",
     options = ["close", "high/low", "ローソク足全体"], group = G_BG,
     tooltip = "「価格が3本すべてを突破」方式でのみ使用する。\nclose（既定）：終値が 3 本すべてより上／下\nhigh/low：高値が 3 本すべてより上（Buy）／安値が 3 本すべてより下（Sell）＝ゆるい判定\nローソク足全体：安値が 3 本すべてより上（Buy）／高値が 3 本すべてより下（Sell）＝厳しい判定")

bgOrderMode = input.string("LINE1 > LINE2 > STB", "検証する並び（高い順）",
     options = ["LINE1 > LINE2 > STB", "LINE1 > STB > LINE2", "LINE2 > LINE1 > STB", "LINE2 > STB > LINE1", "STB > LINE1 > LINE2", "STB > LINE2 > LINE1"],
     group = G_BG,
     tooltip = "「3本の並び順」方式で検証する並び（左が最も高い）。この並びが成立している間だけ着色する。\n※ 逆順を Buy として自動導出することはしない。逆の並びを調べたいときは、選択肢からその並び自体を選ぶこと。")

bgBuyCol   = input.color(color.rgb(38, 198, 218), "Buy背景色",  group = G_BG)
bgSellCol  = input.color(color.rgb(255, 82, 82),  "Sell背景色", group = G_BG)
bgOrderCol = input.color(color.rgb(180, 180, 180), "並び順一致の背景色（比較用）", group = G_BG,
     tooltip = "「3本の並び順」方式で使う色。Buy / Sell を意味しない、単なる並び成立の目印。")
bgTransp   = input.int(85, "背景の透明度", minval = 0, maxval = 100, group = G_BG)

// ============================================================================
// 07｜比較表示
// ============================================================================
// 単独表示モードでは対象以外のライン・EMA・背景を非表示にする。
// ※ 表示の切り替えは plot() へ渡す系列と bgcolor の色だけを変えるものであり、
//   内部の計算や方向状態（var dirState など）には一切影響しない。
viewMode = input.string("通常表示", "比較表示モード",
     options = ["通常表示", "STBだけ", "LINE1だけ", "LINE2だけ", "LINE1 上下バンド比較", "LINE2 上下バンド比較", "LINE2 中心線・固定ATR比較", "LINE2 表示ATR平滑化比較"], group = G_VIEW,
     tooltip = "単独表示：対象以外のライン・移動平均線・背景を非表示にする。\n上下バンド比較：対象ラインの上下バンドを方向に関係なく両方表示する。平滑化前は薄い線、平滑化後は濃い線。背景・STB・EMA200 は非表示。\nLINE2 中心線・固定ATR比較：中心線 basis（黄）／通常 ATR の下側バンド（青）／固定 ATR の下側バンド（白）を並べ、中心線の下降と ATR 幅の拡大の影響を分けて確認する。\nLINE2 表示ATR平滑化比較：中心線 basis（黄）／通常 ATR の下側バンド（青）／平滑化 ATR の下側バンド（白）を並べる。表示用ATR平滑化の ON/OFF に関係なく両方を表示する。\nいずれのモードでも内部計算と方向状態は変わらない。")

// ATR を固定し始める日時。
// 【タイムゾーンについて】
//   ・比較には bar の time（UNIX ミリ秒・UTC 基準）をそのまま使う。
//   ・既定値は timestamp("01 Jan 2026 00:00 +0000") と日時文字列で指定し、
//     +0000（UTC）を明示している。input.time() の初期値は const int である
//     必要があるため、この文字列形式を使う。
//   ・TradingView の設定画面に出る日時ピッカーが何のタイムゾーンで表示・入力
//     されるかは環境（チャートのタイムゾーン設定）に依存するため、ここでは
//     断定しない。実際にどのバーで固定されたかは、データウィンドウの
//     「DW: LINE2 固定ATR取得バー時刻(UNIX ms)」と、デバッグテーブルの
//     「固定ATR」行に出る UTC 表記の時刻で必ず確認すること。
freezeTime = input.time(timestamp("01 Jan 2026 00:00 +0000"), "ATR固定開始日時", group = G_VIEW,
     tooltip = "「LINE2 中心線・固定ATR比較」で ATR を固定し始める日時。急落が始まる足を指定する想定。\n指定時刻以降で最初のバーの『1本前の ATR』を固定値として使う（固定開始バー自身の ATR は使わない）。\n以降その値は更新しない。\n\nタイムゾーン：内部比較は UNIX ミリ秒（UTC 基準）で行う。既定値は UTC で指定している。設定画面のピッカーの表示タイムゾーンは環境依存なので、実際に固定されたバーはデータウィンドウの『DW: LINE2 固定ATR取得バー時刻(UNIX ms)』とデバッグテーブルの UTC 表記で確認すること。")

showApproachMarker = input.bool(false, "LINE2 接近挙動マーカーを表示", group = G_VIEW,
     tooltip = "ON のとき、LINE2 が価格の接近に対して『逃げた』バーに小さなマーカーを表示する。\n下側バンド逃げ（方向 +1・水色）：終値が前バーより下落 かつ 終値と LINE2 の距離が前バーより縮小 かつ LINE2 自体も前バーより下落。\n上側バンド逃げ（方向 -1・赤）：終値が前バーより上昇 かつ 距離が縮小 かつ LINE2 自体も前バーより上昇。\n\n※ これは診断表示のみ。LINE2 の計算・表示位置・方向転換には一切影響しない。\n※ 転換確認マーカーとは独立した設定。")

showFlipMarker = input.bool(false, "転換確認マーカーを表示", group = G_VIEW,
     tooltip = "ON のとき、LINE1 / LINE2 の確定方向が反転したバーに小さなマーカーを表示する。初期化（方向 0 から最初の方向が決まった時点）は転換として扱わない。\nLINE1：三角／LINE2：ひし形。上昇転換は足の下、下降転換は足の上。")

// ============================================================================
// 08｜デバッグ
// ============================================================================
showDebug   = input.bool(false, "デバッグテーブルを表示", group = G_DEBUG)
debugTxtSize = input.string("tiny", "テーブル文字サイズ", options = ["tiny", "small", "normal"], group = G_DEBUG)

// ============================================================================
// 共通関数
// ============================================================================

// ソース文字列から価格系列を取得する
f_src(simple string t) =>
    switch t
        "close" => close
        "open"  => open
        "hl2"   => hl2
        "hlc3"  => hlc3
        "ohlc4" => ohlc4
        "hlcc4" => hlcc4
        =>         hl2

// 移動平均の種別切り替え
f_ma(simple string t, float src, simple int len) =>
    switch t
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        =>       ta.ema(src, len)

// ----------------------------------------------------------------------------
// [方式 A] Supertrend 型ライン（STB の本体・階段状になる）
//
//   戻り値: [最終上側バンド, 最終下側バンド, 生Supertrendライン, 生方向]
//   生方向は  +1 = 上昇 / -1 = 下降
//   ※ 組み込み ta.supertrend() は -1 が上昇・+1 が下降で紛らわしいため、
//     ここでは自前実装して +1=上昇 に統一している（方向値の解釈ミス対策）。
// ----------------------------------------------------------------------------
f_supertrend(float src, simple int atrLen, float factor) =>
    float atrVal     = ta.atr(atrLen)
    float upperBand  = src + factor * atrVal
    float lowerBand  = src - factor * atrVal
    float prevUpper  = nz(upperBand[1])
    float prevLower  = nz(lowerBand[1])
    // バンドは「トレンド方向に切り上がる／切り下がる」ように片方向に固定する
    lowerBand := lowerBand > prevLower or close[1] < prevLower ? lowerBand : prevLower
    upperBand := upperBand < prevUpper or close[1] > prevUpper ? upperBand : prevUpper
    int   dirRaw = na
    float stLine = na
    float prevSt = stLine[1]   // 直前バーのライン値（history 参照）
    if na(atrVal[1])
        dirRaw := -1           // 計算開始直後は下降から開始（na 初期化の型エラー回避）
    else if prevSt == prevUpper
        dirRaw := close > upperBand ?  1 : -1
    else
        dirRaw := close < lowerBand ? -1 :  1
    stLine := dirRaw == 1 ? lowerBand : upperBand
    [upperBand, lowerBand, stLine, dirRaw]

// ----------------------------------------------------------------------------
// [補助] 非対称 Supertrend（LINE2 価格State の検証モード専用）
//
//   f_supertrend() との違いは「上側バンドと下側バンドで別々の倍率を使う」点だけで、
//   トレーリング処理と方向判定の構造は f_supertrend() と同一にしてある。
//
//     stateVolRatio = ta.atr(atrLen) / close                      ← 高ボラ判定用の比率
//     downFactor    = stateVolRatio >= volThreshold ? 高ボラ倍率 : 通常倍率
//     upperBand     = src + atrVal * upFactor                     ← DOWN → UP の判定に使う
//     lowerBand     = src - atrVal * downFactor                   ← UP → DOWN の判定に使う
//
//   高ボラ時だけ downFactor を小さくすることで、下降転換だけを少し早める。
//   上昇転換側（upFactor）はボラティリティに関係なく固定。
//   volThreshold は比率そのもの（0.0018 = 0.18% = 18bp）。
//
//   戻り値: [最終上側バンド, 最終下側バンド, 生Supertrendライン, 生方向,
//            stateVolRatio, 実際に使った downFactor]
//   生方向は +1 = 上昇 / -1 = 下降（f_supertrend() と同じ符号）。
//   ※ 生Supertrendラインは内部計算・診断用であり、LINE2 の表示価格には使わない。
// ----------------------------------------------------------------------------
f_supertrendAsym(float src, simple int atrLen, float upFactor, float dnFactorNormal, float dnFactorHighVol, float volThreshold) =>
    float atrVal   = ta.atr(atrLen)
    float volRatio = close == 0 ? float(na) : atrVal / close
    float dnFactor = nz(volRatio, 0.0) >= volThreshold ? dnFactorHighVol : dnFactorNormal
    float upperBand = src + atrVal * upFactor
    float lowerBand = src - atrVal * dnFactor
    float prevUpper = nz(upperBand[1])
    float prevLower = nz(lowerBand[1])
    // トレーリング処理は f_supertrend() と完全に同じ式
    lowerBand := lowerBand > prevLower or close[1] < prevLower ? lowerBand : prevLower
    upperBand := upperBand < prevUpper or close[1] > prevUpper ? upperBand : prevUpper
    int   dirRaw = na
    float stLine = na
    float prevSt = stLine[1]   // 直前バーのライン値（history 参照）
    if na(atrVal[1])
        dirRaw := -1           // 計算開始直後は下降から開始
    else if prevSt == prevUpper
        dirRaw := close > upperBand ?  1 : -1
    else
        dirRaw := close < lowerBand ? -1 :  1
    stLine := dirRaw == 1 ? lowerBand : upperBand
    [upperBand, lowerBand, stLine, dirRaw, volRatio, dnFactor]

// ----------------------------------------------------------------------------
// [方式 B] EMA ATR Breakout Band（LINE1 / LINE2 の既定方式）
//
//   basis     = ta.ema(source, emaLength)
//   atrValue  = ta.atr(atrLength)
//
//   ■ 転換判定用バンド（switchMultiplier だけを使う）
//     switchUpper = basis + atrValue * switchMultiplier
//     switchLower = basis - atrValue * switchMultiplier
//
//   方向転換ルールは switchMode で明示的に分岐する（倍率 0 などの代用はしない）:
//
//     [SW_ATR] EMA ± ATR で転換（現行・既定。switchMultiplier のみ使用）
//       ・下降状態のとき、終値が switchUpper を上抜けて確定したら上昇へ転換
//       ・上昇状態のとき、終値が switchLower を下抜けて確定したら下降へ転換
//       ・switchUpper と switchLower の間では直前方向を維持
//         → レンジ内では方向が頻繁に反転しない
//
//     [SW_SEPARATE] 専用転換バンド突破で転換（検証用）
//       判定に使うのは引数 sepUpper / sepLower（呼び出し側でグローバルに計算した
//       表示ラインとは完全に別のバンド）。表示ラインの計算には一切関与しない。
//       ・下降（-1）中は close > sepUpper で上昇（+1）へ転換、それ以外は維持
//       ・上昇（+1）中は close < sepLower で下降（-1）へ転換、それ以外は維持
//       ・バンドの間、および境界と同値では方向を維持
//       ・判定は close のみ。高値・安値による突破は使わない
//       初期化：sepUpper / sepLower が na の間は方向 0 を維持し、
//         最初の有効な更新で close が中点より上なら +1、下なら -1、同値なら 0 のまま。
//
//     [SW_BAND_CUR / SW_BAND_PRV] 表示バンド突破で転換（検証用）
//       判定用バンド:
//         当該足 … judgeUpper = displayUpper     / judgeLower = displayLower
//         前の足 … judgeUpper = displayUpper[1]  / judgeLower = displayLower[1]
//       ・下降（-1）中は close > judgeUpper で上昇（+1）へ転換、それ以外は維持
//       ・上昇（+1）中は close < judgeLower で下降（-1）へ転換、それ以外は維持
//       ・バンドの間、および境界と同値では方向を維持
//       ・判定は close のみ。高値・安値による突破は使わない
//       ・更新前の dirState で if / else if 分岐するため、
//         1 本の足で上下両方へ転換することはない
//       初期化（この 2 方式のみ）:
//         judgeUpper / judgeLower が na の間は方向 0 を維持し、
//         最初の有効な更新で close が中点より上なら +1、下なら -1、
//         同値なら 0 のまま次の更新で再判定する。
//       ※ 転換後に表示する価格は、前の足方式でも当該足のバンドを使う（遅らせない）。
//
//     [SW_CLOSE] 終値と EMA 基準値で転換（検証用。ATR を使わない）
//       ・close > basis         → 上昇（+1）
//       ・close < basis         → 下降（-1）
//       ・close == basis        → 前の方向を維持（初期状態なら未確定 0 のまま）
//       ・basis が na           → 方向を更新しない
//       ※ basis は平滑化前の EMA 基準値。表示バンドの平滑化や
//         表示用 ATR の平滑化はこの判定に一切関与しない。
//
//     どちらのモードでも allowUpdate（確定足のみで判定）を尊重する。
//     未来の値や先読みは使わない。
//
//   表示バンドの計算順序:
//     ① baseAtr = ta.atr(atrLength)
//     ② 任意で表示用 ATR を平滑化   slowAtr = ta.ema(baseAtr, atrSmoothLen)
//        useAtrSmooth が true なら dispAtr = slowAtr、false なら dispAtr = baseAtr
//        （slowAtr は ON/OFF に関係なく毎バー計算する）
//     ③ rawUpper = basis + dispAtr * displayMultiplier
//        rawLower = basis - dispAtr * displayMultiplier
//     ④ 任意で既存の表示バンド平滑化（rawUpper / rawLower にそれぞれ EMA）
//     方向で上下を切り替えたあとの線には EMA をかけない。
//
//   ※ 転換判定バンド（switchUpper / switchLower）は常に baseAtr から作る。
//     表示用 ATR の平滑化は方向転換にはいっさい影響しない。
//     さらに上下それぞれ独立に EMA をかけた平滑化バンドも毎バー計算する:
//       smoothUpper = ta.ema(rawUpper, smoothLen)
//       smoothLower = ta.ema(rawLower, smoothLen)
//     useSmooth が true なら smoothUpper / smoothLower を表示に使い、
//     false なら rawUpper / rawLower を使う。
//
//   表示ライン:
//     ・上昇状態 = 選択した下側バンド（青・価格の下側）
//     ・下降状態 = 選択した上側バンド（赤・価格の上側）
//     ※ 赤青に切り替えたあとの表示線に、さらに EMA をかけることはしない。
//     ※ 平滑化した値は方向転換の判定に一切使わない。
//
//   倍率を分離した効果（正確な表現）:
//     ・displayMultiplier は方向判定に一切使わないため、
//       これを変えても過去の方向転換タイミングは変わらない。
//     ・switchMultiplier は表示バンドの幅（basis からの距離）を変えない。
//       ただし switchMultiplier を変えると方向が変わりうるため、
//       方向が変わったバーでは表示する側が上バンド／下バンドで入れ替わる。
//       つまり「同じ方向・同じバーなら表示バンド値は変わらない。
//       ただし方向が変われば表示する上下バンドも変わる」。
//
//   ※ 重要：Supertrend のようなバンド値の切り上げ／切り下げ固定は行わない。
//     EMA と ATR から毎バー再計算した滑らかなバンドをそのまま表示する。
//   ※ var の状態は呼び出しごとに独立。LINE1 と LINE2 は完全に別状態になる。
//
//   戻り値:
//     [表示ライン, 方向, basis, atrValue, switchUpper, switchLower,
//      rawUpper, rawLower, smoothUpper, smoothLower]
// ----------------------------------------------------------------------------
f_emaAtrBreakout(float src, simple int emaLen, simple int atrLen, float switchMult, float displayMult, simple string switchMode, float sepUpper, float sepLower, simple int atrSmoothLen, bool useAtrSmooth, simple int smoothLen, bool useSmooth, bool allowUpdate) =>
    float basis = ta.ema(src, emaLen)
    // ① 生の ATR。転換判定と、戻り値の atrValue には常にこれを使う。
    float atrValue = ta.atr(atrLen)
    // ② 表示用 ATR の平滑化。ON/OFF に関係なく毎バー計算する。
    float slowAtr = ta.ema(atrValue, atrSmoothLen)
    float dispAtr = atrValue
    if useAtrSmooth
        dispAtr := slowAtr
    // 転換判定にだけ使うバンド（常に生の ATR。表示用 ATR の平滑化に影響されない）
    float switchUpper = basis + atrValue * switchMult
    float switchLower = basis - atrValue * switchMult
    // ③ 表示にだけ使う生バンド（表示用 ATR を使う）
    float rawUpper = basis + dispAtr * displayMult
    float rawLower = basis - dispAtr * displayMult
    // ④ 上下それぞれ独立に EMA をかけた平滑化バンド。
    // ta.ema() は条件分岐の外で毎バー無条件に呼ぶ（実行されないバーがあると値がずれるため）。
    float smoothUpper = ta.ema(rawUpper, smoothLen)
    float smoothLower = ta.ema(rawLower, smoothLen)
    // 表示に使うバンドを選ぶ。ここでは値を選ぶだけで、追加の平滑化はしない。
    float displayUpper = rawUpper
    float displayLower = rawLower
    if useSmooth
        displayUpper := smoothUpper
        displayLower := smoothLower
    // 表示バンド突破方式で使う判定バンド。
    // history 参照は条件分岐の外・関数のトップレベルで行う。
    float prevDispUpper = displayUpper[1]
    float prevDispLower = displayLower[1]
    float judgeUpper = switchMode == SW_BAND_PRV ? prevDispUpper : displayUpper
    float judgeLower = switchMode == SW_BAND_PRV ? prevDispLower : displayLower

    var int dirState = 0
    if allowUpdate
        if switchMode == SW_SEPARATE
            // [検証用] 表示バンドとは別の専用転換バンドで判定する。
            // 表示ライン（lineVal）は下で displayUpper / displayLower から決まるため、
            // ここでの判定は表示価格の計算に一切影響しない。
            if not na(sepUpper) and not na(sepLower)
                if dirState == 0
                    // 初期化：中点との位置で最初の方向を決める。同値なら 0 のまま。
                    float sepMid = (sepUpper + sepLower) / 2
                    if close > sepMid
                        dirState := 1
                    else if close < sepMid
                        dirState := -1
                else if dirState == -1
                    // 下降中：専用上側バンドを終値が上回ったときだけ上昇へ
                    if close > sepUpper
                        dirState := 1
                else if dirState == 1
                    // 上昇中：専用下側バンドを終値が下回ったときだけ下降へ
                    if close < sepLower
                        dirState := -1
        else if switchMode == SW_BAND_CUR or switchMode == SW_BAND_PRV
            // [検証用] 表示バンド突破で転換。判定用バンドが揃うまでは方向 0 を維持。
            if not na(judgeUpper) and not na(judgeLower)
                if dirState == 0
                    // 初期化：中点との位置で最初の方向を決める。同値なら 0 のまま。
                    float judgeMid = (judgeUpper + judgeLower) / 2
                    if close > judgeMid
                        dirState := 1
                    else if close < judgeMid
                        dirState := -1
                else if dirState == -1
                    // 下降中：上側バンドを終値が上回ったときだけ上昇へ
                    if close > judgeUpper
                        dirState := 1
                else if dirState == 1
                    // 上昇中：下側バンドを終値が下回ったときだけ下降へ
                    if close < judgeLower
                        dirState := -1
        else if switchMode == SW_CLOSE
            // [検証用] 終値と EMA 基準値 basis を直接比べる。ATR は使わない。
            // basis が na のバーでは方向を更新しない。
            if not na(basis)
                if close > basis
                    dirState := 1
                else if close < basis
                    dirState := -1
                // close == basis のときは前の方向を維持する。
                // 初期状態（dirState == 0）で同値なら未確定のまま。
        else
            // [現行] EMA ± ATR で転換。既存の条件と初期化処理をそのまま維持する。
            if not na(basis) and not na(atrValue)
                if dirState == 0
                    // 初期化：転換判定バンドを抜けていればその方向、間なら基準線との位置で決める
                    if close > switchUpper
                        dirState := 1
                    else if close < switchLower
                        dirState := -1
                    else if close > basis
                        dirState := 1
                    else
                        dirState := -1
                else if dirState == -1 and close > switchUpper
                    dirState := 1
                else if dirState == 1 and close < switchLower
                    dirState := -1
    float lineVal = na
    if dirState == 1
        lineVal := displayLower
    else if dirState == -1
        lineVal := displayUpper
    [lineVal, dirState, basis, atrValue, switchUpper, switchLower, rawUpper, rawLower, smoothUpper, smoothLower]

// ----------------------------------------------------------------------------
// [方式 C] ATR Trailing Stop（UT Bot 系）
//
//   nLoss = ATR × 倍率 として、
//     ・価格が前回ストップより上で上昇継続 → max(前回ストップ, src - nLoss)
//     ・価格が前回ストップより下で下降継続 → min(前回ストップ, src + nLoss)
//     ・下から上へクロス                   → src - nLoss
//     ・上から下へクロス                   → src + nLoss
// ----------------------------------------------------------------------------
f_atrTrail(float src, simple int atrLen, float mult) =>
    float nLoss = mult * ta.atr(atrLen)
    var float stopVal  = na
    var int   dirState = 0
    if not na(nLoss)
        // 初回は下側に置いて上昇から開始する
        float prevStop = na(stopVal) ? src - nLoss : stopVal
        float prevSrc  = nz(src[1], src)
        if src > prevStop and prevSrc > prevStop
            // 上昇継続：ストップは切り上げのみ
            stopVal := math.max(prevStop, src - nLoss)
        else if src < prevStop and prevSrc < prevStop
            // 下降継続：ストップは切り下げのみ
            stopVal := math.min(prevStop, src + nLoss)
        else if src > prevStop
            // 下から上へクロス
            stopVal := src - nLoss
        else
            // 上から下へクロス
            stopVal := src + nLoss
        // 方向：どちらでもない（同値）ときは直前の方向を維持する
        if src > stopVal
            dirState := 1
        else if src < stopVal
            dirState := -1
    [stopVal, dirState]

// ----------------------------------------------------------------------------
// [方式 D] EMA + ATR Band
//   EMA を基準線として、価格が基準線より上なら下側バンド、
//   下なら上側バンドだけを表示する（基準線をまたぐたびに方向が変わる）。
// ----------------------------------------------------------------------------
f_emaAtrBand(float src, simple int emaLen, simple int atrLen, float mult) =>
    float basis = ta.ema(src, emaLen)
    float band  = mult * ta.atr(atrLen)
    var int dirState = 0
    if not na(basis) and not na(band)
        dirState := src > basis ? 1 : src < basis ? -1 : dirState
    float lineVal = na
    if dirState == 1
        lineVal := basis - band
    else if dirState == -1
        lineVal := basis + band
    [lineVal, dirState]

// ----------------------------------------------------------------------------
// フィルター強度つき方向確定ロジック（STB 専用）
//
//   反対方向の生シグナルが strength 本連続で確定したときだけ方向を転換する。
//   allowUpdate に barstate.isconfirmed を渡すと、確定したバーでしか
//   dirState / oppCount を更新しない。余分な 1 本の遅延は発生しない。
// ----------------------------------------------------------------------------
f_filterDir(int rawDir, simple int strength, bool allowUpdate) =>
    var int dirState = 0
    var int oppCount = 0
    int r = nz(rawDir, 0)
    if allowUpdate and r != 0
        if dirState == 0
            // 初期化：最初に得られた生方向をそのまま採用
            dirState := r
            oppCount := 0
        else if r != dirState
            oppCount := oppCount + 1
            if oppCount >= strength
                dirState := r
                oppCount := 0
        else
            oppCount := 0
    dirState

// ----------------------------------------------------------------------------
// [LINE1 検証用] 表示バンド突破＋確認本数による価格 State
//
//   いま採用している側と反対の「表示バンド」を終値が突破した状態が
//   confirmBars 本連続したときだけ State を転換する。
//   上下両方を同時に判定するのではなく、現在の State に応じて
//   反対側への突破だけを見る（DOWN 中は上側、UP 中は下側のみ）。
//
//     State  0 : 初期化。mid = (upperBand + lowerBand) / 2 と終値を比較して即決する。
//                close > mid → +1 / close < mid → -1 / close == mid → 0 を維持。
//                初期化だけは確認本数を要求しない。
//     State -1 : close > upperBand のバーを数える。confirmBars 本連続で +1 へ。
//     State +1 : close < lowerBand のバーを数える。confirmBars 本連続で -1 へ。
//     条件が崩れたバーで、その方向のカウントは 0 に戻る。
//
//   allowUpdate（＝確定足のみで判定）が false のバーでは State もカウントも進めない。
//   [1] による追加の遅延は入れないため、確定足で条件が揃ったバーで転換する。
//   1 本のバーで処理されるのは片方向だけなので、UP → DOWN → UP の二重転換は起こらない。
//   上下バンドの計算自体は呼び出し側で毎バー無条件に行い、ここでは受け取るだけ。
// ----------------------------------------------------------------------------
f_bandConfirmState(float upperBand, float lowerBand, simple int confirmBars, bool allowUpdate) =>
    var int dirState = 0
    var int upCount  = 0
    var int dnCount  = 0
    bool valid = not na(upperBand) and not na(lowerBand)
    if allowUpdate and valid
        if dirState == 0
            // 初期化：中点との比較で即決する（確認本数は要求しない）
            float mid = (upperBand + lowerBand) / 2
            if close > mid
                dirState := 1
            else if close < mid
                dirState := -1
            upCount := 0
            dnCount := 0
        else if dirState == -1
            // DOWN 中は上側表示バンドの突破だけを見る
            if close > upperBand
                upCount := upCount + 1
                if upCount >= confirmBars
                    dirState := 1
                    upCount  := 0
                    dnCount  := 0
            else
                upCount := 0
        else
            // UP 中は下側表示バンドの突破だけを見る
            if close < lowerBand
                dnCount := dnCount + 1
                if dnCount >= confirmBars
                    dirState := -1
                    upCount  := 0
                    dnCount  := 0
            else
                dnCount := 0
    dirState

// ----------------------------------------------------------------------------
// [LINE1 検証用] 専用転換バンド突破＋確認本数による価格 State
//
//   f_bandConfirmState() との違いは、判定に使うバンドが「表示バンド」ではなく
//   呼び出し側で独立に計算した『転換判定専用バンド』である点と、
//   確認本数を DOWN→UP 用と UP→DOWN 用で別々に持てる点だけ。
//   専用バンドは判定にしか使わず、LINE1 の表示価格には一切使わない。
//
//     State  0 : 初期化。stateMid = (upBand + dnBand) / 2 と終値を比較して即決する。
//                close > stateMid → +1 / close < stateMid → -1 / 同値 → 0 を維持。
//                初期化だけは確認本数を要求しない。
//     State -1 : close > upBand のバーを数える。upConfirm 本連続で +1 へ。
//     State +1 : close < dnBand のバーを数える。dnConfirm 本連続で -1 へ。
//     条件が 1 本でも崩れたバーで、その方向のカウントは 0 に戻る。
//
//   allowUpdate（＝確定足のみで判定）が false のバーでは State もカウントも進めない。
//   専用バンドそのものは呼び出し側で毎バー無条件に計算する（形成中も更新されてよい）。
//   [1] による追加の遅延は入れない。1 本のバーで処理されるのは片方向だけなので、
//   UP → DOWN → UP の二重転換は起こらない。
// ----------------------------------------------------------------------------
f_l1SeparateState(float upBand, float dnBand, simple int upConfirm, simple int dnConfirm, bool allowUpdate) =>
    var int dirState = 0
    var int upCount  = 0
    var int dnCount  = 0
    bool valid = not na(upBand) and not na(dnBand)
    if allowUpdate and valid
        if dirState == 0
            // 初期化：専用バンドの中点との比較で即決する（確認本数は要求しない）
            float stateMid = (upBand + dnBand) / 2
            if close > stateMid
                dirState := 1
            else if close < stateMid
                dirState := -1
            upCount := 0
            dnCount := 0
        else if dirState == -1
            // DOWN 中は上側専用バンドの突破だけを見る
            if close > upBand
                upCount := upCount + 1
                if upCount >= upConfirm
                    dirState := 1
                    upCount  := 0
                    dnCount  := 0
            else
                upCount := 0
        else
            // UP 中は下側専用バンドの突破だけを見る
            if close < dnBand
                dnCount := dnCount + 1
                if dnCount >= dnConfirm
                    dirState := -1
                    upCount  := 0
                    dnCount  := 0
            else
                dnCount := 0
    dirState

// ----------------------------------------------------------------------------
// STB 方向（フィルター適用後）をひとまとめに計算する関数
//   request.security() からも呼べるように、戻り値は int 単体にしている。
// ----------------------------------------------------------------------------
f_stbDir(simple string srcType, simple int atrLen, float factor, simple int strength, bool allowUpdate) =>
    float s = f_src(srcType)
    [_u, _l, _st, rawDirTuple] = f_supertrend(s, atrLen, factor)
    // タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
    int rawDir = rawDirTuple
    f_filterDir(rawDir, strength, allowUpdate)

// ----------------------------------------------------------------------------
// 上位足用の STB 方向（参考表示のみ）
//   confirmedOnly が true のときの [1] は「上位足の時系列上」で適用されるため、
//   ひとつ前の "閉じた" 上位足の値になる（未来の値が過去へ漏れることはない）。
//   ※ barstate.isconfirmed は request.security() 内では使わない。
// ----------------------------------------------------------------------------
f_stbDirHtf(simple string srcType, simple int atrLen, float factor, simple int strength, simple bool confirmedOnly) =>
    int d = f_stbDir(srcType, atrLen, factor, strength, true)
    confirmedOnly ? d[1] : d

// 方向 → 表示文字列
f_dirStr(int d) =>
    d ==  1 ? "▲ UP" : d == -1 ? "▼ DOWN" : "－"

// 方向 → 表示色
f_dirCol(int d, color upC, color dnC, color flatC) =>
    d ==  1 ? upC : d == -1 ? dnC : flatC

// 価格 → 表示文字列（na 対応）
f_priceStr(float v) =>
    na(v) ? "－" : str.tostring(v, format.mintick)

// ----------------------------------------------------------------------------
// 3 本のラインを高い順に並べた文字列を返す（デバッグ用）
//   引数は vStb = STB, vL1 = LINE1, vL2 = LINE2
//   同値がある場合は並び順を確定できないため「同値あり」を返す。
// ----------------------------------------------------------------------------
f_rankStr(float vStb, float vL1, float vL2) =>
    string res = "－"
    if not na(vStb) and not na(vL1) and not na(vL2)
        if vStb == vL1 or vStb == vL2 or vL1 == vL2
            res := "同値あり（Neutral）"
        else
            string hi  = "STB"
            string mid = "STB"
            string lo  = "STB"
            if vStb > vL1 and vStb > vL2
                hi := "STB"
                if vL1 > vL2
                    mid := "LINE1"
                    lo  := "LINE2"
                else
                    mid := "LINE2"
                    lo  := "LINE1"
            else if vL1 > vStb and vL1 > vL2
                hi := "LINE1"
                if vStb > vL2
                    mid := "STB"
                    lo  := "LINE2"
                else
                    mid := "LINE2"
                    lo  := "STB"
            else
                hi := "LINE2"
                if vStb > vL1
                    mid := "STB"
                    lo  := "LINE1"
                else
                    mid := "LINE1"
                    lo  := "STB"
            res := hi + " > " + mid + " > " + lo
    res

// ============================================================================
// 状態更新の可否（STB フィルターと EMA ATR Breakout Band の両方に効く）
//   useConfirmed = true  → 確定バーでのみ方向状態を更新する
//   useConfirmed = false → 形成中バーでも更新する（反応は早いが途中で揺れる）
// ※ 過去足へずらす（rawDir[1]）方式は使わない。余分な 1 本の遅延が出るため。
// ============================================================================
bool allowStateUpdate = useConfirmed ? barstate.isconfirmed : true

// ============================================================================
// 計算：STB ライン（階段状 Supertrend + フィルター強度）
// ============================================================================
float stbSrc = f_src(stbSrcType)

[stbUpperBand, stbLowerBand, stbLineRaw, stbRawDirT] = f_supertrend(stbSrc, stbAtrLen, stbFactor)

// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
int stbRaw = stbRawDirT

int stbDir = f_filterDir(nz(stbRaw, 0), stbFilter, allowStateUpdate)

// 表示用 STB ライン：確定方向に対応する側のバンドを描画する。
//   上昇（青）＝ 最終下側バンド（価格の下側）
//   下降（赤）＝ 最終上側バンド（価格の上側）
float stbDisplayLine = na
if stbDir == 1
    stbDisplayLine := stbLowerBand
else if stbDir == -1
    stbDisplayLine := stbUpperBand

// ============================================================================
// 計算：SAT's BAND LINE1 / LINE2
//
//   4 方式すべてを毎バー無条件に計算し、選択された方式の結果だけを採用する。
//   （ta.*() や var を持つ関数を if の中で呼ぶと、実行されないバーで状態が
//     更新されず値がずれるため。選択は計算後の値の取捨だけで行う。）
//   LINE1 と LINE2 は別々の関数呼び出しなので、状態変数は完全に独立している。
// ============================================================================
float l1Src = f_src(l1EffSrcType)
float l2Src = f_src(l2EffSrcType)

// ----------------------------------------------------------------------------
// LINE2 転換専用バンド（表示ラインとは完全に独立）
//   転換判定方式が「専用転換バンドで転換（当該足）」のときだけ判定に使う。
//   ta.ema() / ta.atr() は条件分岐の外で毎バー無条件に呼ぶ。
//   ※ ソースは共通（l2SepSrcType）だが、EMA期間 / ATR期間 / 倍率 / 平滑化は
//     赤→青 用と 青→赤 用で完全に別々の設定を使う。
//   ※ ソースも専用の l2SepSrcType から作るため、表示ラインのソース（l2EffSrcType）
//     および CSV検証プリセットによるソース強制の影響を受けない。
//   ※ CSV検証プリセットはここに一切関与しない（表示ライン側だけを変える）。
//   ※ ここで作った値は f_emaAtrBreakout() へ引数として渡すだけで、
//     表示ライン（displayUpper / displayLower）の計算には使われない。
// ----------------------------------------------------------------------------
// ソースだけは共通。EMA / ATR / 倍率 / 平滑化は赤→青と青→赤で完全に別。
float l2SepSrc = f_src(l2SepSrcType)

// --- 赤→青（下降 -1 → 上昇 +1）用の上側しきい値 ---
float l2SepUpBasis = ta.ema(l2SepSrc, l2SepUpEmaLen)
float l2SepUpAtr   = ta.atr(l2SepUpAtrLen)
float l2SepRawUp   = l2SepUpBasis + l2SepUpAtr * l2SepUpMult
float l2SepSmUp    = ta.ema(l2SepRawUp, l2SepUpSmLen)
float l2SepUp      = l2SepUpSmooth ? l2SepSmUp : l2SepRawUp

// --- 青→赤（上昇 +1 → 下降 -1）用の下側しきい値 ---
float l2SepDnBasis = ta.ema(l2SepSrc, l2SepDnEmaLen)
float l2SepDnAtr   = ta.atr(l2SepDnAtrLen)
float l2SepRawLo   = l2SepDnBasis - l2SepDnAtr * l2SepDnMult
float l2SepSmLo    = ta.ema(l2SepRawLo, l2SepDnSmLen)
float l2SepLo      = l2SepDnSmooth ? l2SepSmLo : l2SepRawLo

// --- LINE1：4 方式ぶんを計算 ---
// ※ 転換判定方式・専用転換バンド・表示用 ATR の平滑化は LINE2 専用の検証機能なので、
//   LINE1 には常に現行方式（SW_ATR）、専用バンドなし（na, na）、OFF（10, false）を渡す。
//   LINE1 の方向・表示は従来どおり変わらない。
[l1BreakLine, l1BreakDir, l1BreakBasis, l1BreakAtr, l1BreakSwUp, l1BreakSwLo, l1RawUp, l1RawLo, l1SmUp, l1SmLo] = f_emaAtrBreakout(l1Src, l1EffEmaLen, l1EffAtrLen, l1SwMult, l1EffDpMult, SW_ATR, na, na, 10, false, l1EffSmoothLen, l1EffSmooth, allowStateUpdate)
[l1TrailLine, l1TrailDir] = f_atrTrail(l1Src, l1EffAtrLen, l1Factor)
[l1EmaLine,   l1EmaDir]   = f_emaAtrBand(l1Src, l1EffEmaLen, l1EffAtrLen, l1Factor)
[l1StUpper, l1StLower, l1StLineRaw, l1StRawDirT] = f_supertrend(l1Src, l1EffAtrLen, l1Factor)
int   l1StDir  = nz(l1StRawDirT, 0)
float l1StLine = na
if l1StDir == 1
    l1StLine := l1StLower
else if l1StDir == -1
    l1StLine := l1StUpper

// ----------------------------------------------------------------------------
// LINE1 の最終的な上側 / 下側表示バンド（State に関係なく毎バー計算する）
//   f_emaAtrBreakout() 内部の displayUpper / displayLower と同じ値。
//   新しい計算式は作らず、返ってきた raw / smooth を実効設定で選ぶだけ。
// ----------------------------------------------------------------------------
float l1DisplayUpperFinal = l1EffSmooth ? l1SmUp : l1RawUp
float l1DisplayLowerFinal = l1EffSmooth ? l1SmLo : l1RawLo

// 表示バンド突破＋確認本数による価格 State（選択されていなくても毎バー計算する）。
// f_bandConfirmState() はこの呼び出し専用の var 状態を持つため、他の State とは独立。
int l1BandCfmDir = f_bandConfirmState(l1DisplayUpperFinal, l1DisplayLowerFinal, l1BandCfmBars, allowStateUpdate)

// ----------------------------------------------------------------------------
// LINE1 転換判定専用バンド（表示バンドとは完全に独立）
//   ta.ema() / ta.atr() は State やモードの条件分岐の中では呼ばず、毎バー無条件に計算する。
//   ソースだけ共通で、EMA期間 / ATR期間 / 倍率 / 平滑化は
//   DOWN→UP 用と UP→DOWN 用で完全に別々。
//   ※ ここで作った値は価格 State の判定にしか使わない。
//     l1DisplayLine（表示価格）の計算には一切使わない。
//   ※ LINE1 CSV検証プリセットはここに関与しない。
// ----------------------------------------------------------------------------
float l1StateSrc = f_src(l1StateSrcType)

// --- DOWN → UP 用の上側しきい値 ---
float l1StateUpBasis = ta.ema(l1StateSrc, l1StateUpEmaLen)
float l1StateUpAtr   = ta.atr(l1StateUpAtrLen)
float l1StateUpRaw   = l1StateUpBasis + l1StateUpAtr * l1StateUpMult
float l1StateUpSm    = ta.ema(l1StateUpRaw, l1StateUpSmoothLen)
float l1StateUpBand  = l1StateUpSmooth ? l1StateUpSm : l1StateUpRaw

// --- UP → DOWN 用の下側しきい値 ---
float l1StateDnBasis = ta.ema(l1StateSrc, l1StateDnEmaLen)
float l1StateDnAtr   = ta.atr(l1StateDnAtrLen)
float l1StateDnRaw   = l1StateDnBasis - l1StateDnAtr * l1StateDnMult
float l1StateDnSm    = ta.ema(l1StateDnRaw, l1StateDnSmoothLen)
float l1StateDnBand  = l1StateDnSmooth ? l1StateDnSm : l1StateDnRaw

// 専用転換バンドによる価格 State（選択されていなくても毎バー計算する）。
// f_l1SeparateState() はこの呼び出し専用の var 状態を持つため、他の State とは独立。
int l1SepStateDir = f_l1SeparateState(l1StateUpBand, l1StateDnBand, l1StateUpConfirm, l1StateDnConfirm, allowStateUpdate)

// --- LINE2：4 方式ぶんを計算 ---
[l2BreakLine, l2BreakDir, l2BreakBasis, l2BreakAtr, l2BreakSwUp, l2BreakSwLo, l2RawUp, l2RawLo, l2SmUp, l2SmLo] = f_emaAtrBreakout(l2Src, l2EffEmaLen, l2EffAtrLen, l2SwMult, l2EffDpMult, l2SwitchMode, l2SepUp, l2SepLo, l2EffAtrSmoothLen, l2EffAtrSmooth, l2EffSmoothLen, l2EffSmooth, allowStateUpdate)
[l2TrailLine, l2TrailDir] = f_atrTrail(l2Src, l2EffAtrLen, l2Factor)
[l2EmaLine,   l2EmaDir]   = f_emaAtrBand(l2Src, l2EffEmaLen, l2EffAtrLen, l2Factor)
[l2StUpper, l2StLower, l2StLineRaw, l2StRawDirT] = f_supertrend(l2Src, l2EffAtrLen, l2Factor)
int   l2StDir  = nz(l2StRawDirT, 0)
float l2StLine = na
if l2StDir == 1
    l2StLine := l2StLower
else if l2StDir == -1
    l2StLine := l2StUpper

// ----------------------------------------------------------------------------
// LINE2 価格State用 Supertrend（表示バンドとは完全に別・毎バー計算）
//   既存の f_supertrend() / f_filterDir() をそのまま再利用する（重複実装しない）。
//   使うのは方向だけ。l2PsStUpper / l2PsStLower / l2PsStLineRaw は
//   内部方向計算のための素材であり、l2DisplayLine として表示しない。
//   確認本数の進み方は既存の allowStateUpdate を尊重する（[1] による追加の遅延はしない）。
//   f_filterDir() はこの呼び出し専用の var 状態を持つので、STB 側とは独立。
// ----------------------------------------------------------------------------
float l2PsStSrc = f_src(l2PsStSrcType)

[l2PsStUpper, l2PsStLower, l2PsStLineRaw, l2PsStRawDirT] = f_supertrend(l2PsStSrc, l2PsStAtrLen, l2PsStFactor)

int l2PsStRawDir = nz(l2PsStRawDirT, 0)
int l2PsStDir    = f_filterDir(l2PsStRawDir, l2PsStFilter, allowStateUpdate)

// ----------------------------------------------------------------------------
// LINE2 価格State用 非対称 Supertrend（検証モード「Supertrend非対称＋高ボラ補正」用）
//   上の「Supertrend方向＋確認」とは別インスタンスとして毎バー計算する。
//   どちらのモードを選んでいても両方が走るため、f_filterDir() の内部 var 状態が
//   途中で欠測してずれることはない（ta.* / var を条件分岐の中で呼ばない）。
//   使うのは方向だけで、l2PsAsymLineRaw を l2DisplayLine として表示することはない。
// ----------------------------------------------------------------------------
float l2PsAsymSrc = f_src(l2PsAsymSrcType)

[l2PsAsymUpper, l2PsAsymLower, l2PsAsymLineRaw, l2PsAsymRawDirT, l2PsAsymVolRatioT, l2PsAsymDnFacT] = f_supertrendAsym(l2PsAsymSrc, l2PsAsymAtrLen, l2PsAsymUpFac, l2PsAsymDnFac, l2PsAsymDnFacHV, l2PsAsymVolTh)

// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーしておく
int   l2PsAsymRawDir    = nz(l2PsAsymRawDirT, 0)
float l2PsAsymVolRatio  = l2PsAsymVolRatioT
float l2PsAsymDnFacUsed = l2PsAsymDnFacT
bool  l2PsAsymHighVol   = nz(l2PsAsymVolRatio, 0.0) >= l2PsAsymVolTh
int   l2PsAsymDir       = f_filterDir(l2PsAsymRawDir, l2PsAsymFilter, allowStateUpdate)

// 価格State が Supertrend 系（通常／非対称）かどうか。
// Breakout 側の転換判定が最終的な上下バンド選択に使われないケースの判定に使う。
bool l2PsUsesSt = l2PsMode == L2_PS_ST or l2PsMode == L2_PS_ST_ASYM

// Breakout 方式の最終的な上側 / 下側表示バンド。
// f_emaAtrBreakout() 内部の displayUpper / displayLower と同じ値になる
// （新しい計算式は作らず、返ってきた raw / smooth を実効設定で選ぶだけ）。
float l2DisplayUpperFinal = l2EffSmooth ? l2SmUp : l2RawUp
float l2DisplayLowerFinal = l2EffSmooth ? l2SmLo : l2RawLo

// --- 選択された方式の結果を採用 ---
float l1DisplayLine = na
int   l1Dir         = 0
if l1EffMethod == M_BREAK
    // 価格State方式で「上下どちらの表示バンドを採用するか」を決める。
    // 表示バンドの価格そのものはどちらの方式でも同じ。
    if l1PsMode == L1_PS_BANDCFM
        l1Dir := l1BandCfmDir
        if l1Dir == 1
            l1DisplayLine := l1DisplayLowerFinal
        else if l1Dir == -1
            l1DisplayLine := l1DisplayUpperFinal
    else if l1PsMode == L1_PS_SEPARATE
        // 専用転換バンドで方向だけを決める。表示価格は表示バンドのまま。
        l1Dir := l1SepStateDir
        if l1Dir == 1
            l1DisplayLine := l1DisplayLowerFinal
        else if l1Dir == -1
            l1DisplayLine := l1DisplayUpperFinal
    else
        // 従来どおり f_emaAtrBreakout() の内部 State と表示ラインをそのまま使う。
        l1DisplayLine := l1BreakLine
        l1Dir         := l1BreakDir
else if l1EffMethod == M_TRAIL
    l1DisplayLine := l1TrailLine
    l1Dir         := l1TrailDir
else if l1EffMethod == M_EMABD
    l1DisplayLine := l1EmaLine
    l1Dir         := l1EmaDir
else if l1EffMethod == M_SUPER
    l1DisplayLine := l1StLine
    l1Dir         := l1StDir

float l2DisplayLine = na
int   l2Dir         = 0
if l2EffMethod == M_BREAK
    // 価格State方式で「上下どちらの表示バンドを採用するか」を決める。
    // 表示バンドの価格そのものはどちらの方式でも同じ。
    if l2PsMode == L2_PS_ST
        // Supertrend の方向だけを使う。Supertrend のライン価格は使わない。
        l2Dir := l2PsStDir
        if l2Dir == 1
            l2DisplayLine := l2DisplayLowerFinal
        else if l2Dir == -1
            l2DisplayLine := l2DisplayUpperFinal
    else if l2PsMode == L2_PS_ST_ASYM
        // 非対称 Supertrend の方向だけを使う。ライン価格は使わない。
        // 採用する表示バンドは「Supertrend方向＋確認」と同じ規則。
        l2Dir := l2PsAsymDir
        if l2Dir == 1
            l2DisplayLine := l2DisplayLowerFinal
        else if l2Dir == -1
            l2DisplayLine := l2DisplayUpperFinal
    else
        // 従来どおり f_emaAtrBreakout() の内部 State と表示ラインをそのまま使う。
        l2DisplayLine := l2BreakLine
        l2Dir         := l2BreakDir
else if l2EffMethod == M_TRAIL
    l2DisplayLine := l2TrailLine
    l2Dir         := l2TrailDir
else if l2EffMethod == M_EMABD
    l2DisplayLine := l2EmaLine
    l2Dir         := l2EmaDir
else if l2EffMethod == M_SUPER
    l2DisplayLine := l2StLine
    l2Dir         := l2StDir

// ----------------------------------------------------------------------------
// LINE2 の色専用状態
//
//   l2Dir      = price state / internal band state
//                （上側バンドと下側バンドのどちらを l2DisplayLine にするかを決める内部状態）
//   l2ColorDir = color state
//                （チャートに描く赤／青を決める状態）
//
//   この 2 つを分離することで、
//   「価格 state は DOWN なのに色は青」といった状態を検証できる。
//
//   l2CloseColorState は色判定方式の選択に関係なく毎バー更新する。
//   設定を切り替えたときに過去の state が欠落しないようにするため。
//   確定足のみで判定（allowStateUpdate）は既存と同じように尊重する。
//   ※ LINE2 の価格計算（l2DisplayLine）には一切影響しない。
//   ※ この色判定は LINE2 専用。LINE1 / STB / EMA200 には適用しない。
// ----------------------------------------------------------------------------
var int l2CloseColorState = 0

if allowStateUpdate and not na(l2DisplayLine)
    if close > l2DisplayLine
        l2CloseColorState := 1
    else if close < l2DisplayLine
        l2CloseColorState := -1
    // close == l2DisplayLine のときは直前の色を維持する

int l2ColorDir = l2ColorMode == L2_COLOR_CLOSE ? l2CloseColorState : l2Dir

// ----------------------------------------------------------------------------
// 診断値（データウィンドウ表示用）
//   basis / ATR / 転換判定バンドは EMA ATR Breakout Band 固有の値なので、
//   他方式を選んでいるときは na にしておく（誤読を防ぐため）。
// ----------------------------------------------------------------------------
float l1DiagBasis = na
float l1DiagAtr   = na
float l1DiagSwUp  = na
float l1DiagSwLo  = na
if l1EffMethod == M_BREAK
    l1DiagBasis := l1BreakBasis
    l1DiagAtr   := l1BreakAtr
    if l1PsMode == L1_PS_BANDCFM or l1PsMode == L1_PS_SEPARATE
        // これらの方式では、この 2 本の Data Window 列に上側 / 下側の「表示バンド」を出す
        // （plot は増やさない）。専用転換バンドの値でここを上書きすることはしない。
        // ※「表示Band突破＋確認」では、この表示バンドがそのまま転換判定しきい値でもある。
        //   「専用転換Band＋確認」では、転換判定に使うのは別に計算した専用バンドであり、
        //   その値はデバッグテーブルの LINE1 欄で確認する。
        l1DiagSwUp := l1DisplayUpperFinal
        l1DiagSwLo := l1DisplayLowerFinal
    else
        l1DiagSwUp := l1BreakSwUp
        l1DiagSwLo := l1BreakSwLo

float l2DiagBasis = na
float l2DiagAtr   = na
float l2DiagSwUp  = na
float l2DiagSwLo  = na
if l2EffMethod == M_BREAK
    l2DiagBasis := l2BreakBasis
    l2DiagAtr   := l2BreakAtr
    l2DiagSwUp  := l2BreakSwUp
    l2DiagSwLo  := l2BreakSwLo

// ============================================================================
// 計算：LINE2 中心線・固定ATR比較（表示モードに関係なく毎バー計算する）
//
//   目的：LINE2 の急落後の沈み込みについて、
//         「中心線 basis が下がった影響」と「ATR 幅が広がった影響」を分けて見る。
//
//   ・basis は固定しない（毎バー更新する）
//   ・固定するのは ATR だけ
//   ・rawNormal = basis - 現在ATR   × 表示倍率
//   ・rawFixed  = basis - 固定ATR   × 表示倍率
//   ・転換倍率や方向状態はこの比較に一切使わない
//
//   固定値の取り方：
//     指定時刻以降で最初のバーにおける「1 本前の ATR」を採用する。
//     固定開始バー自身の ATR は使わない。以降は更新しない。
//     未来の値は参照しない（[1] は必ず過去側）。
//     直前の ATR が na（履歴不足）の場合は固定値を na のままにし、失敗を記録する。
// ============================================================================
// タプル分解した変数へ直接 history 参照をかけないよう、通常変数へコピーする
//   l2AtrNow は f_emaAtrBreakout() が返す生の ATR（baseATR）。
//   表示用 ATR の平滑化設定に左右されない値なので、固定ATR比較はこれを基準にする。
float l2AtrNow   = l2BreakAtr
float l2BasisNow = l2BreakBasis

// 選択中の転換判定方式で「実際に効いているしきい値」。
//   現行方式：switchUpper / switchLower
//   検証用  ：どちらも basis
// ※ LINE2 の計算方式が EMA ATR Breakout Band 以外のときは、
//   この転換判定方式の設定自体が無効なので na にする。
// 実効設定を反映した表示バンド（関数内の displayUpper / displayLower と同じ値）。
// 表示バンド突破方式の判定しきい値と、その 1 本前の値を出すために使う。
float l2DispUp = l2EffSmooth ? l2SmUp : l2RawUp
float l2DispLo = l2EffSmooth ? l2SmLo : l2RawLo

float l2EffSwUp = na
float l2EffSwLo = na
// 価格State方式が Supertrend 系（通常／非対称）のときは、Breakout 側の転換判定が
// 最終的な上下バンドの選択に使われないため、有効しきい値は na のままにする。
// （実際には効いていない値を DW へ出さないため。内部計算自体は継続している。）
if l2EffMethod == M_BREAK and not l2PsUsesSt
    if l2SwitchMode == SW_CLOSE
        l2EffSwUp := l2BasisNow
        l2EffSwLo := l2BasisNow
    else if l2SwitchMode == SW_SEPARATE
        l2EffSwUp := l2SepUp
        l2EffSwLo := l2SepLo
    else if l2SwitchMode == SW_BAND_CUR
        l2EffSwUp := l2DispUp
        l2EffSwLo := l2DispLo
    else if l2SwitchMode == SW_BAND_PRV
        l2EffSwUp := l2DispUp[1]
        l2EffSwLo := l2DispLo[1]
    else
        l2EffSwUp := l2BreakSwUp
        l2EffSwLo := l2BreakSwLo

// 表示用 ATR の平滑化（ON/OFF に関係なく毎バー計算する）
float l2SlowAtr = ta.ema(l2AtrNow, l2EffAtrSmoothLen)
// 実際に表示バンドへ使われている ATR（診断表示用）
float l2AtrUsed = l2EffAtrSmooth ? l2SlowAtr : l2AtrNow

var float l2FrozenAtr     = na
var int   l2FrozenBarTime = na
var bool  l2FreezeDone    = false
var bool  l2FreezeFailed  = false

if not l2FreezeDone and time >= freezeTime
    l2FreezeDone    := true
    l2FrozenBarTime := time
    float prevAtr = l2AtrNow[1]
    if na(prevAtr)
        // 指定時刻より前の履歴が読み込まれておらず、直前バーの ATR を取れない
        l2FreezeFailed := true
    else
        l2FrozenAtr := prevAtr

// 生の比較バンド（表示倍率は LINE2 の表示ATR倍率をそのまま使う）
//   通常側は必ず baseATR（l2AtrNow）から直接計算する。
//   l2RawLo は表示用 ATR 平滑化の設定で中身が変わるため、ここでは使わない。
//   こうすることで、表示用 ATR 平滑化を切り替えても固定ATR比較の結果は変わらない。
float cmpRawNormal = l2BasisNow - l2AtrNow * l2EffDpMult
float cmpRawFixed  = na
if not na(l2FrozenAtr)
    cmpRawFixed := l2BasisNow - l2FrozenAtr * l2EffDpMult

// --- 平滑化（表示モードの ON/OFF に関係なく毎バー計算する） ---
// 中心線の平滑化。ta.ema() は条件分岐の外で毎バー呼ぶ。
float cmpBasisSmooth = ta.ema(l2BasisNow, l2EffSmoothLen)
// 通常側の平滑化。baseATR から作った cmpRawNormal に対して EMA をかける
// （l2SmLo は表示用 ATR 平滑化の設定で中身が変わるため使わない）。
float cmpNormalSmooth = ta.ema(cmpRawNormal, l2EffSmoothLen)

// 固定側の平滑化：
//   固定開始の前バーまでは通常側の EMA と同じ値を保持しておき、
//   固定開始バーから rawFixed を入力として同じ係数で更新する。
//   こうすると固定開始前の平滑化履歴が揃い、
//   開始後は「ATR を固定した影響」だけが差として出る。
float cmpAlpha = 2.0 / (l2EffSmoothLen + 1)
var float cmpFixedSmooth = na
if l2FreezeDone
    if na(cmpFixedSmooth)
        cmpFixedSmooth := cmpRawFixed
    else
        cmpFixedSmooth := cmpAlpha * cmpRawFixed + (1 - cmpAlpha) * cmpFixedSmooth
else
    cmpFixedSmooth := cmpNormalSmooth

// --- 表示に使う値を選ぶ（平滑化 ON/OFF で条件を揃える） ---
float l2CmpBasisPlot  = l2BasisNow
float l2CmpNormalPlot = cmpRawNormal
if l2EffSmooth
    l2CmpBasisPlot  := cmpBasisSmooth
    l2CmpNormalPlot := cmpNormalSmooth

// 固定側は固定開始バーより前は表示しない
float l2CmpFixedPlot = na
if l2FreezeDone
    if l2EffSmooth
        l2CmpFixedPlot := cmpFixedSmooth
    else
        l2CmpFixedPlot := cmpRawFixed

// ============================================================================
// 計算：LINE2 表示ATR平滑化比較（表示モードに関係なく毎バー計算する）
//
//   ATR 幅の急拡大が表示バンドをどれだけ押し下げるかを見るための比較。
//   ※ 元 SATS の計算式がこうであると断定するものではない。
//
//   normalLower = basis - baseATR × 表示倍率
//   slowLower   = basis - slowATR × 表示倍率
//   既存の「表示バンド平滑化」が ON なら、中心線を含む 3 本すべてに
//   同じ期間の EMA を同じ条件でかける。
// ============================================================================
float atrCmpNormalLower = cmpRawNormal                       // basis - baseATR × 表示倍率
float atrCmpSlowLower   = l2BasisNow - l2SlowAtr * l2EffDpMult  // basis - slowATR × 表示倍率

// 平滑化版は ta.ema() を条件分岐の外で毎バー呼ぶ
float atrCmpNormalSmooth = cmpNormalSmooth                          // = ta.ema(atrCmpNormalLower, l2EffSmoothLen)
float atrCmpSlowSmooth   = ta.ema(atrCmpSlowLower, l2EffSmoothLen)

// 3 本とも同じ条件（既存の表示バンド平滑化 ON/OFF）で表示値を選ぶ
float l2AtrCmpBasisPlot  = l2BasisNow
float l2AtrCmpNormalPlot = atrCmpNormalLower
float l2AtrCmpSlowPlot   = atrCmpSlowLower
if l2EffSmooth
    l2AtrCmpBasisPlot  := cmpBasisSmooth
    l2AtrCmpNormalPlot := atrCmpNormalSmooth
    l2AtrCmpSlowPlot   := atrCmpSlowSmooth

// ============================================================================
// 診断：LINE2 の転換バーと接近挙動（表示モードに関係なく毎バー計算する）
//
//   ここは読み取り専用の診断ブロック。
//   l2DisplayLine / l2Dir / 背景 / その他の既存出力を一切書き換えない。
//   新しい補正ロジック（距離が近いときにラインを動かす等）は入れていない。
//   未来参照はしない（参照するのは当該足と [1] の過去足のみ）。
// ============================================================================

// --- 転換バーの判定 ---
//   -1 → +1（赤→水色）= 1 / +1 → -1（水色→赤）= -1 / それ以外 = 0
//   直前の方向が 0（未確定）のバーは転換として扱わない。
int l2DirPrev = nz(l2Dir[1], 0)
int l2FlipEvent = 0
if l2Dir == 1 and l2DirPrev == -1
    l2FlipEvent := 1
else if l2Dir == -1 and l2DirPrev == 1
    l2FlipEvent := -1

// --- 色 State の転換バーの判定 ---
//   実際に描画されている赤／青（l2ColorDir）の反転を見る。
//   元 SAT's PANEL の赤青転換と CSV で突き合わせるのはこちら。
//   上の l2Dir ベース（内部価格 State）の判定はそのまま残してある。
int l2ColorDirPrev = nz(l2ColorDir[1], 0)
int l2ColorFlipEvent = 0
if l2ColorDir == 1 and l2ColorDirPrev == -1
    l2ColorFlipEvent := 1
else if l2ColorDir == -1 and l2ColorDirPrev == 1
    l2ColorFlipEvent := -1

// 直近の転換バーの時刻。転換バーでは当該足の time と一致する。
var int l2FlipBarTime = na
if l2FlipEvent != 0
    l2FlipBarTime := time

// --- 接近挙動の素材 ---
float l2LinePrev   = l2DisplayLine[1]
float l2DistNow    = na
float l2DistPrev   = na
if not na(l2DisplayLine)
    l2DistNow := math.abs(close - l2DisplayLine)
if not na(l2LinePrev)
    l2DistPrev := math.abs(nz(close[1], close) - l2LinePrev)

float l2DistChange  = l2DistNow - l2DistPrev
float l2CloseChange = close - close[1]
float l2LineChange  = l2DisplayLine - l2LinePrev
float l2BasisChange = l2BasisNow - l2BasisNow[1]
float l2AtrChange   = l2AtrNow - l2AtrNow[1]

// --- 「逃げ」判定 ---
//   方向 +1（水色・価格の下側）：close 下落 かつ 距離縮小 かつ LINE2 も下落 → 1
//   方向 -1（赤・価格の上側）  ：close 上昇 かつ 距離縮小 かつ LINE2 も上昇 → -1
//
//   必須条件：l2Dir == l2DirPrev（＝ l2FlipEvent == 0）
//     転換バーでは LINE2 の表示値が上側バンド⇔下側バンドへ切り替わるため、
//     「価格接近に対してラインが逃げる」挙動とは別物になる。
//     そのため方向が前バーと同じバーだけを判定対象にし、
//     転換バーでは必ず l2Escape = 0 にする。
//     方向が未確定（0）から確定した最初のバーも同様に対象外。
int l2Escape = 0
if l2Dir == l2DirPrev and not na(l2DistChange) and not na(l2CloseChange) and not na(l2LineChange)
    if l2Dir == 1
        if l2CloseChange < 0 and l2DistChange < 0 and l2LineChange < 0
            l2Escape := 1
    else if l2Dir == -1
        if l2CloseChange > 0 and l2DistChange < 0 and l2LineChange > 0
            l2Escape := -1

// ============================================================================
// 計算：移動平均線
// ============================================================================
float maSrc = f_src(maSrcType)
float maVal = f_ma(maType, maSrc, maLen)
int   maDir = maVal > maVal[1] ? 1 : maVal < maVal[1] ? -1 : 0

// ============================================================================
// 計算：MTF（マルチタイムフレーム）STB 方向 ※参考表示のみ
//   lookahead は必ず barmerge.lookahead_off（未来の値を過去へ漏らさない）。
//   ここで求めた結果は背景判定には一切使用しない。
// ============================================================================
bool mtfConfirmedOnly = mtfConfirmMode == "確定した上位足のみ"

int dirChart = stbDir   // 現在のチャート時間足はローカル計算をそのまま使う

int dir15 = nz(request.security(syminfo.tickerid, tf15,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dir60 = nz(request.security(syminfo.tickerid, tf60,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dir240 = nz(request.security(syminfo.tickerid, tf240,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dirD = nz(request.security(syminfo.tickerid, tfD,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

int dirW = nz(request.security(syminfo.tickerid, tfW,
     f_stbDirHtf(stbSrcType, stbAtrLen, stbFactor, stbFilter, mtfConfirmedOnly),
     lookahead = barmerge.lookahead_off), 0)

// --- 集計（OFF の時間足は集計対象外） ---
int buyCount  = 0
int sellCount = 0
int tfTotal   = 0

if useTfChart
    tfTotal := tfTotal + 1
    if dirChart == 1
        buyCount := buyCount + 1
    else if dirChart == -1
        sellCount := sellCount + 1

if useTf15
    tfTotal := tfTotal + 1
    if dir15 == 1
        buyCount := buyCount + 1
    else if dir15 == -1
        sellCount := sellCount + 1

if useTf60
    tfTotal := tfTotal + 1
    if dir60 == 1
        buyCount := buyCount + 1
    else if dir60 == -1
        sellCount := sellCount + 1

if useTf240
    tfTotal := tfTotal + 1
    if dir240 == 1
        buyCount := buyCount + 1
    else if dir240 == -1
        sellCount := sellCount + 1

if useTfD
    tfTotal := tfTotal + 1
    if dirD == 1
        buyCount := buyCount + 1
    else if dirD == -1
        sellCount := sellCount + 1

if useTfW
    tfTotal := tfTotal + 1
    if dirW == 1
        buyCount := buyCount + 1
    else if dirW == -1
        sellCount := sellCount + 1

// MTF 方向スコア（+ が Buy 寄り、- が Sell 寄り）
int mtfScore = buyCount - sellCount

// 説明用の総合判定（デバッグ表示のみ）
string mtfDesc = "Neutral"
if tfTotal == 0
    mtfDesc := "TF未選択"
else if buyCount == tfTotal
    mtfDesc := "強いBuy"
else if sellCount == tfTotal
    mtfDesc := "強いSell"
else if buyCount * 2 > tfTotal
    mtfDesc := "Buy優勢"
else if sellCount * 2 > tfTotal
    mtfDesc := "Sell優勢"

// 一致条件による MTF シグナル（デバッグ表示のみ・背景には使用しない）
int mtfSignal = 0
if tfTotal > 0
    if mtfMode == "全時間足一致"
        if buyCount == tfTotal
            mtfSignal := 1
        else if sellCount == tfTotal
            mtfSignal := -1
    else if mtfMode == "過半数一致"
        if buyCount * 2 > tfTotal
            mtfSignal := 1
        else if sellCount * 2 > tfTotal
            mtfSignal := -1
    else
        // 指定数以上一致：両方が条件を満たした場合は多い方を採用、同数なら Neutral
        bool bOk = buyCount  >= mtfMinAgree
        bool sOk = sellCount >= mtfMinAgree
        if bOk and (not sOk or buyCount > sellCount)
            mtfSignal := 1
        else if sOk and (not bOk or sellCount > buyCount)
            mtfSignal := -1

// ============================================================================
// 判定：3 本の並び順（比較検証用）
//
//   選択した並びを「高い順」に ordHi > ordMid > ordLo として取り出し、
//   その並びが成立しているかどうかだけを見る。
//   比較は厳密な不等号なので、ライン同士が同値なら不成立。
//   この方式では終値の位置を一切使わない。
//
//   ※ これは元 SATS の確定仕様ではない。あくまで比較のための表示である。
//   ※ 逆順を Buy として自動導出することはしない。
// ============================================================================
float ordHi  = na
float ordMid = na
float ordLo  = na

if bgOrderMode == O_112
    ordHi  := l1DisplayLine
    ordMid := l2DisplayLine
    ordLo  := stbDisplayLine
else if bgOrderMode == O_1S2
    ordHi  := l1DisplayLine
    ordMid := stbDisplayLine
    ordLo  := l2DisplayLine
else if bgOrderMode == O_21S
    ordHi  := l2DisplayLine
    ordMid := l1DisplayLine
    ordLo  := stbDisplayLine
else if bgOrderMode == O_2S1
    ordHi  := l2DisplayLine
    ordMid := stbDisplayLine
    ordLo  := l1DisplayLine
else if bgOrderMode == O_S12
    ordHi  := stbDisplayLine
    ordMid := l1DisplayLine
    ordLo  := l2DisplayLine
else
    ordHi  := stbDisplayLine
    ordMid := l2DisplayLine
    ordLo  := l1DisplayLine

bool ordValid = not na(ordHi) and not na(ordMid) and not na(ordLo)

// 選択した並びが成立しているかどうかだけを判定する。
// ※ 逆順を Buy として自動導出することはしない（反転の導出は行わない）。
//   逆の並びを検証したいときは、選択肢からその並び自体を選ぶこと。
bool orderMatch = false
if ordValid
    if ordHi > ordMid and ordMid > ordLo
        orderMatch := true

// ============================================================================
// 判定：価格が 3 本すべてを突破（突破方式用）
// ============================================================================
float highestLine = math.max(stbDisplayLine, math.max(l1DisplayLine, l2DisplayLine))
float lowestLine  = math.min(stbDisplayLine, math.min(l1DisplayLine, l2DisplayLine))

// 判定に使う価格。
//   close          ：Buy も Sell も終値
//   high/low       ：Buy は高値・Sell は安値（ゆるい判定）
//   ローソク足全体 ：Buy は安値・Sell は高値（厳しい判定＝足全体が抜けている）
float bgBuySrc  = bgSrcMode == "close" ? close : bgSrcMode == "high/low" ? high : low
float bgSellSrc = bgSrcMode == "close" ? close : bgSrcMode == "high/low" ? low  : high

bool priceBuy  = not na(highestLine) and bgBuySrc  > highestLine
bool priceSell = not na(lowestLine)  and bgSellSrc < lowestLine

// ============================================================================
// 判定：3 本の方向が一致（方向一致方式用）
// ============================================================================
bool dirBuy  = stbDir ==  1 and l1Dir ==  1 and l2Dir ==  1
bool dirSell = stbDir == -1 and l1Dir == -1 and l2Dir == -1

// ============================================================================
// 判定：最終的な背景（選択した背景方式で分岐）
// ============================================================================
bool buyBackground  = false
bool sellBackground = false
bool orderBackground = false

if bgMode == BG_PRICE
    buyBackground  := priceBuy
    sellBackground := priceSell
else if bgMode == BG_DIR
    buyBackground  := dirBuy
    sellBackground := dirSell
else if bgMode == BG_ORDER
    // 比較用。Buy / Sell として扱わず、専用色で並びの成立だけを示す。
    orderBackground := orderMatch

// ============================================================================
// 表示可否の決定（比較表示モード）
//   単独表示モードでは対象以外のライン・EMA・背景を非表示にする。
//   ここで決めるのは plot() へ渡す系列と bgcolor の色だけであり、
//   上で計算済みの値や var による方向状態には一切影響しない。
// ============================================================================
bool soloStb = viewMode == "STBだけ"
bool soloL1  = viewMode == "LINE1だけ"
bool soloL2  = viewMode == "LINE2だけ"
bool isSolo  = soloStb or soloL1 or soloL2

// 上下バンド比較モード。
// 対象ラインの上下バンドを方向に関係なく両方描くため、
// 方向で色分けした通常のラインと STB / EMA200 / 背景はすべて隠す。
// ※ 表示価格を使う背景判定は平滑化で結果が変わりうるので、
//   この比較モードでは背景を出さない。
bool cmpL1 = viewMode == "LINE1 上下バンド比較"
bool cmpL2 = viewMode == "LINE2 上下バンド比較"
// LINE2 中心線・固定ATR比較モード
bool cmpL2Fix = viewMode == "LINE2 中心線・固定ATR比較"
// LINE2 表示ATR平滑化比較モード
bool cmpL2Atr = viewMode == "LINE2 表示ATR平滑化比較"
// 比較線が有効なのは EMA ATR Breakout Band を選んでいるときだけ
bool cmpL2FixOk = cmpL2Fix and l2EffMethod == M_BREAK
bool cmpL2AtrOk = cmpL2Atr and l2EffMethod == M_BREAK
bool isCmp = cmpL1 or cmpL2 or cmpL2Fix or cmpL2Atr

bool visStb = showStb
bool visL1  = showL1
bool visL2  = showL2
bool visMa  = showMa
bool visBg  = true
if isSolo
    visStb := soloStb
    visL1  := soloL1
    visL2  := soloL2
    visMa  := false
    visBg  := false
else if isCmp
    visStb := false
    visL1  := false
    visL2  := false
    visMa  := false
    visBg  := false

// 上下バンド比較モードで描画する系列。
// 対象モードでないバーは na にして、チャートに何も出さない。
// ※ EMA ATR Breakout Band を選んでいないラインは値が意味を持たないため、
//   その場合も na にする。
float cmpRawUp = na
float cmpRawLo = na
float cmpSmUp  = na
float cmpSmLo  = na
color cmpUpCol = C_FLAT_DEF
color cmpLoCol = C_FLAT_DEF
if cmpL1 and l1EffMethod == M_BREAK
    cmpRawUp := l1RawUp
    cmpRawLo := l1RawLo
    cmpSmUp  := l1SmUp
    cmpSmLo  := l1SmLo
    cmpUpCol := l1DnCol
    cmpLoCol := l1UpCol
else if cmpL2 and l2EffMethod == M_BREAK
    cmpRawUp := l2RawUp
    cmpRawLo := l2RawLo
    cmpSmUp  := l2SmUp
    cmpSmLo  := l2SmLo
    cmpUpCol := l2DnCol
    cmpLoCol := l2UpCol

// LINE2 中心線・固定ATR比較で描画する 3 本。
// 対象モードでない、または方式が Breakout でない場合は na にして何も出さない。
float fixBasisPlot  = na
float fixNormalPlot = na
float fixFixedPlot  = na
if cmpL2FixOk
    fixBasisPlot  := l2CmpBasisPlot
    fixNormalPlot := l2CmpNormalPlot
    fixFixedPlot  := l2CmpFixedPlot

// LINE2 表示ATR平滑化比較で描画する 3 本。
// 表示用ATR平滑化の ON/OFF に関係なく、通常版と平滑化版の両方を出す。
float atrCmpBasisPlot  = na
float atrCmpNormalPlot = na
float atrCmpSlowPlot   = na
if cmpL2AtrOk
    atrCmpBasisPlot  := l2AtrCmpBasisPlot
    atrCmpNormalPlot := l2AtrCmpNormalPlot
    atrCmpSlowPlot   := l2AtrCmpSlowPlot

// ============================================================================
// 描画：ライン
//   plot() はグローバルスコープでのみ呼ぶ（ローカルスコープ禁止）。
//   ※ LINE1 / STB は方向変数ひとつでライン値と線色の両方が決まる。
//   ※ LINE2 だけは価格 State（l2Dir）と色 State（l2ColorDir）を分離しているため、
//     色判定方式によっては「青なのに価格の上」という状態が起こりうる。
//     これは仕様どおりで、元 SAT's PANEL との比較検証のための構造。
// ============================================================================
// 価格系列は l2DisplayLine のまま。色だけ l2ColorDir から決める。
plot(visL2 ? l2DisplayLine : na, title = "SAT's BAND LINE2",
     color = l2ColorDir == 1 ? l2UpCol : l2ColorDir == -1 ? l2DnCol : C_FLAT_DEF,
     linewidth = l2Width)

plot(visL1 ? l1DisplayLine : na, title = "SAT's BAND LINE1",
     color = l1Dir == 1 ? l1UpCol : l1Dir == -1 ? l1DnCol : C_FLAT_DEF,
     linewidth = l1Width)

plot(visStb ? stbDisplayLine : na, title = "STB Line",
     color = stbDir == 1 ? stbUpCol : stbDir == -1 ? stbDnCol : C_FLAT_DEF,
     linewidth = stbWidth)

plot(visMa ? maVal : na, title = "MA (EMA200)",
     color = maDir == 1 ? maUpCol : maDir == -1 ? maDnCol : maFlatCol,
     linewidth = maWidth)

// ============================================================================
// 描画：上下バンド比較（比較モードのときだけ値が入る）
//   平滑化前 = 薄い線（透明度高め・細い）
//   平滑化後 = 濃い線（不透明・太い）
//   上側は下降色系、下側は上昇色系で区別する。
// ============================================================================
plot(cmpRawUp, title = "比較: 上バンド（平滑化前）",
     color = color.new(cmpUpCol, 65), linewidth = 1)
plot(cmpRawLo, title = "比較: 下バンド（平滑化前）",
     color = color.new(cmpLoCol, 65), linewidth = 1)
plot(cmpSmUp,  title = "比較: 上バンド（平滑化後）",
     color = color.new(cmpUpCol, 0), linewidth = 2)
plot(cmpSmLo,  title = "比較: 下バンド（平滑化後）",
     color = color.new(cmpLoCol, 0), linewidth = 2)

// ============================================================================
// 描画：LINE2 中心線・固定ATR比較（対象モードのときだけ値が入る）
//   ① 中心線 basis            … 黄
//   ② 通常 ATR の下側バンド   … 青
//   ③ 固定 ATR の下側バンド   … 白
//   平滑化 ON/OFF は 3 本とも同じ条件で揃えてある。
// ============================================================================
plot(fixBasisPlot,  title = "比較: LINE2 中心線 basis",
     color = color.yellow, linewidth = 2)
plot(fixNormalPlot, title = "比較: LINE2 通常ATR 下側バンド",
     color = color.blue, linewidth = 2)
plot(fixFixedPlot,  title = "比較: LINE2 固定ATR 下側バンド",
     color = color.white, linewidth = 2)

// ============================================================================
// 描画：LINE2 表示ATR平滑化比較（対象モードのときだけ値が入る）
//   中心線 basis          … 黄
//   通常 ATR の下側バンド … 青
//   平滑化 ATR の下側バンド … 白
//   既存の表示バンド平滑化 ON/OFF は 3 本とも同じ条件で適用している。
// ============================================================================
plot(atrCmpBasisPlot,  title = "比較: LINE2 中心線 basis（ATR平滑化比較）",
     color = color.yellow, linewidth = 2)
plot(atrCmpNormalPlot, title = "比較: LINE2 通常ATR 下側バンド（ATR平滑化比較）",
     color = color.blue, linewidth = 2)
plot(atrCmpSlowPlot,   title = "比較: LINE2 平滑化ATR 下側バンド",
     color = color.white, linewidth = 2)

// ============================================================================
// 描画：転換確認マーカー（初期値 OFF）
//   確定方向が反転したバーにだけ小さなマーカーを出す。
//   直前バーの方向が 0（未初期化）の場合は転換として扱わない。
//   LINE1 は三角、LINE2 はひし形。上昇転換は足の下、下降転換は足の上。
// ============================================================================
bool l1FlipUp   = l1Dir ==  1 and l1Dir[1] == -1
bool l1FlipDown = l1Dir == -1 and l1Dir[1] ==  1
// LINE2 のマーカーは、実際に見えている赤／青の色転換を示す（l2ColorDir ベース）。
// LINE1 のマーカーは従来どおり方向（l1Dir）ベースのまま。
bool l2FlipUp   = l2ColorDir ==  1 and l2ColorDir[1] == -1
bool l2FlipDown = l2ColorDir == -1 and l2ColorDir[1] ==  1

plotshape(showFlipMarker and visL1 and l1FlipUp, title = "LINE1 転換 UP",
     style = shape.triangleup, location = location.belowbar, color = l1UpCol, size = size.tiny)
plotshape(showFlipMarker and visL1 and l1FlipDown, title = "LINE1 転換 DOWN",
     style = shape.triangledown, location = location.abovebar, color = l1DnCol, size = size.tiny)
plotshape(showFlipMarker and visL2 and l2FlipUp, title = "LINE2 転換 UP",
     style = shape.diamond, location = location.belowbar, color = l2UpCol, size = size.tiny)
plotshape(showFlipMarker and visL2 and l2FlipDown, title = "LINE2 転換 DOWN",
     style = shape.diamond, location = location.abovebar, color = l2DnCol, size = size.tiny)

// ============================================================================
// 描画：LINE2 接近挙動マーカー（初期値 OFF・転換確認マーカーとは独立）
//   下側バンド逃げ（方向 +1）→ 水色系の小さいマーカーを足の下に
//   上側バンド逃げ（方向 -1）→ 赤系の小さいマーカーを足の上に
//   診断表示のみで、LINE2 の計算・表示位置・方向には影響しない。
// ============================================================================
plotshape(showApproachMarker and l2Escape == 1, title = "LINE2 下側バンド逃げ",
     style = shape.xcross, location = location.belowbar, color = l2UpCol, size = size.tiny)
plotshape(showApproachMarker and l2Escape == -1, title = "LINE2 上側バンド逃げ",
     style = shape.xcross, location = location.abovebar, color = l2DnCol, size = size.tiny)

// ============================================================================
// 描画：診断値（データウィンドウのみ）
//   display = display.data_window を指定しているため、チャートには線が出ない。
//   カーソルを置いたバーの値をデータウィンドウで確認できる。
//   方向は 上昇 = 1 / 下降 = -1 / 未初期化 = 0。
//   LINE1 / LINE2 の basis・ATR・転換判定バンドは
//   EMA ATR Breakout Band を選んでいるときだけ値が入る（他方式では na）。
// ============================================================================
plot(stbDisplayLine,   title = "DW: STB 表示価格",        display = display.data_window)
plot(stbDir * 1.0,     title = "DW: STB 方向",            display = display.data_window)

plot(l1DisplayLine,    title = "DW: LINE1 表示価格",      display = display.data_window)
plot(l1Dir * 1.0,      title = "DW: LINE1 方向",          display = display.data_window)
plot(l1DiagBasis,      title = "DW: LINE1 EMA基準値",     display = display.data_window)
plot(l1DiagAtr,        title = "DW: LINE1 ATR値",         display = display.data_window)
plot(l1DiagSwUp,       title = "DW: LINE1 転換判定上限／上側表示バンド",  display = display.data_window)
plot(l1DiagSwLo,       title = "DW: LINE1 転換判定下限／下側表示バンド",  display = display.data_window)

plot(l2DisplayLine,    title = "DW: LINE2 表示価格",      display = display.data_window)
plot(l2Dir * 1.0,      title = "DW: LINE2 方向",          display = display.data_window)
plot(l2DiagBasis,      title = "DW: LINE2 EMA基準値",     display = display.data_window)
plot(l2DiagAtr,        title = "DW: LINE2 ATR値",         display = display.data_window)
// ATR から作ったしきい値。転換判定方式が「終値とEMA基準値で転換」のときは
// 判定に使われないため、参考値であることが分かる名前にしてある。
plot(l2DiagSwUp,       title = "DW: LINE2 ATR転換判定上限(参考)",  display = display.data_window)
plot(l2DiagSwLo,       title = "DW: LINE2 ATR転換判定下限(参考)",  display = display.data_window)
// 選択中の方式で実際に効いているしきい値
plot(l2EffSwUp,        title = "DW: LINE2 有効な上昇転換しきい値",  display = display.data_window)
plot(l2EffSwLo,        title = "DW: LINE2 有効な下降転換しきい値",  display = display.data_window)

// --- LINE2 中心線・固定ATR比較の診断値 ---
//   固定ATR取得バー時刻は UNIX ミリ秒（UTC 基準）。
//   読みやすい UTC 表記はデバッグテーブルの「固定ATR」行に出る。
plot(l2AtrNow,             title = "DW: LINE2 現在ATR",                    display = display.data_window)
plot(l2FrozenAtr,          title = "DW: LINE2 固定ATR",                    display = display.data_window)
plot(l2CmpBasisPlot,       title = "DW: LINE2 中心線 比較表示値",          display = display.data_window)
plot(l2CmpNormalPlot,      title = "DW: LINE2 通常ATR下側 比較表示値",     display = display.data_window)
plot(l2CmpFixedPlot,       title = "DW: LINE2 固定ATR下側 比較表示値",     display = display.data_window)
plot(l2FrozenBarTime * 1.0, title = "DW: LINE2 固定ATR取得バー時刻(UNIX ms)", display = display.data_window)

// --- LINE2 表示用ATR平滑化の診断値 ---
plot(l2SlowAtr,  title = "DW: LINE2 平滑化ATR(slowATR)",       display = display.data_window)
plot(l2AtrUsed,  title = "DW: LINE2 表示に使用中のATR",         display = display.data_window)

// --- LINE2 転換バー・接近挙動の診断 ---
//   plot 数の上限（64）に収めるため、データウィンドウへ出すのは 4 項目だけに絞っている。
//   転換発生：転換なし = 0 / 赤→水色 = 1 / 水色→赤 = -1
//     ※ 実際に描画されている色 State（l2ColorDir）の転換を出す。
//       内部価格 State（l2Dir）の転換は l2FlipEvent として計算だけ残してある。
//   接近逃げ判定：なし = 0 / 下側バンド逃げ = 1 / 上側バンド逃げ = -1
//   ※ 転換前方向・転換後方向は既存の「DW: LINE2 方向」で、
//     basis変化量・ATR変化量は既存の「DW: LINE2 EMA基準値」「DW: LINE2 ATR値」で確認できる。
//   ※ l2DirPrev / l2FlipBarTime / l2DistChange / l2BasisChange / l2AtrChange は
//     内部計算として残してある（l2Escape の判定に使うため）。
plot(l2ColorFlipEvent * 1.0, title = "DW: LINE2 転換発生",     display = display.data_window)
plot(l2DistNow,           title = "DW: LINE2 価格距離",      display = display.data_window)
plot(l2LineChange,        title = "DW: LINE2 変化量",        display = display.data_window)
plot(l2Escape * 1.0,      title = "DW: LINE2 接近逃げ判定",  display = display.data_window)

// ============================================================================
// 描画：背景
//   bgcolor() の多重呼び出しによる意図しない上書きを避けるため、
//   最終的な背景色を 1 つの変数にまとめてから 1 回だけ描画する。
//   ※ 突破方式の high/low モードでは巨大な包み足で Buy と Sell が同時に
//     成立しうるため、その場合は Buy を優先する（if / else if の評価順）。
//   ※ 単独表示モードでは背景を出さない。
// ============================================================================
color bgFinal = na

if visBg
    if buyBackground
        bgFinal := color.new(bgBuyCol, bgTransp)
    else if sellBackground
        bgFinal := color.new(bgSellCol, bgTransp)
    else if orderBackground
        bgFinal := color.new(bgOrderCol, bgTransp)

bgcolor(bgFinal, title = "SAT PANEL 背景")

// ============================================================================
// 比較モードの案内メッセージ
//   ラベルは最終バーに最大 1 個だけ。条件が解消したら削除する。
//     ・LINE2 の計算方式が EMA ATR Breakout Band でない → 切替案内
//     ・指定時刻より前の履歴が足りず固定 ATR を取得できなかった → その旨
// ============================================================================
var label cmpMsgLbl = na

if barstate.islast
    string cmpMsg = ""
    if (cmpL2Fix or cmpL2Atr) and l2EffMethod != M_BREAK
        cmpMsg := "LINE2 の計算方式を「" + M_BREAK + "」に切り替えてください（現在：" + l2EffMethod + "）"
    else if cmpL2Fix and l2FreezeFailed
        cmpMsg := "指定時刻前の履歴が不足（固定開始バーの 1 本前の ATR を取得できませんでした）"
    if cmpMsg == ""
        if not na(cmpMsgLbl)
            label.delete(cmpMsgLbl)
            cmpMsgLbl := na
    else
        if na(cmpMsgLbl)
            cmpMsgLbl := label.new(bar_index, high, cmpMsg, style = label.style_label_down,
                 color = color.new(color.orange, 20), textcolor = color.black, size = size.small)
        else
            label.set_xy(cmpMsgLbl, bar_index, high)
            label.set_text(cmpMsgLbl, cmpMsg)

// ============================================================================
// デバッグテーブル（初期値 OFF・ラベルは出さない）
// ============================================================================
var table dbgTable = table.new(position.top_right, 2, 31,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

// 現在の背景判定を文字列化
string bgStr = "なし"
if not visBg
    bgStr := "非表示（単独表示モード）"
else if bgMode == BG_NONE
    bgStr := "背景なし（OFF）"
else if buyBackground
    bgStr := "青（Buy）"
else if sellBackground
    bgStr := "赤（Sell）"
else if orderBackground
    bgStr := "並び一致（比較用）"

// LINE2 の「価格 state」と「色 state」を 1 行で見せる文字列。
//   価格 state は l2Dir（どちらのバンドを表示価格にするかを決める内部状態）。
//   色は l2ColorDir（実際に描かれる赤／青）。
//   両者がずれている状態（例：価格State DOWN なのに色は青）を確認するための表示。
string l2PsStr = l2EffMethod
if l2EffMethod == M_BREAK
    if l2PsMode == L2_PS_ST
        l2PsStr := "ST(" + l2PsStSrcType + " / ATR" + str.tostring(l2PsStAtrLen) +
             " / ×" + str.tostring(l2PsStFactor) + " / Confirm" + str.tostring(l2PsStFilter) + ")"
    else if l2PsMode == L2_PS_ST_ASYM
        l2PsStr := "ST Asym(" + l2PsAsymSrcType + " / ATR" + str.tostring(l2PsAsymAtrLen) +
             " / Up" + str.tostring(l2PsAsymUpFac) +
             " / Dn" + str.tostring(l2PsAsymDnFac) +
             " / HighVol>=" + str.tostring(l2PsAsymVolTh * 100, "#.####") + "% → Dn" + str.tostring(l2PsAsymDnFacHV) +
             " / Confirm" + str.tostring(l2PsAsymFilter) + ")" +
             (l2PsAsymHighVol ? "  [高ボラ中 / 使用Dn=" + str.tostring(l2PsAsymDnFacUsed) + "]" : "  [通常 / 使用Dn=" + str.tostring(l2PsAsymDnFacUsed) + "]")
    else
        l2PsStr := l2PsMode

string l2StateStr = "価格State：" +
     (l2Dir == 1 ? "UP" : l2Dir == -1 ? "DOWN" : "－") +
     " / 色：" +
     (l2ColorDir == 1 ? "青" : l2ColorDir == -1 ? "赤" : "－") +
     "  " + l2PsStr

// 3 本を高い順に並べた実測の並び
string rankStr = f_rankStr(stbDisplayLine, l1DisplayLine, l2DisplayLine)

// LINE2 CSV検証プリセットの状態。OFF 以外のときは実効値を並べる。
string presetStr = "OFF（上の LINE2 設定をそのまま使用）"
if l2PresetMode == PRESET_STDISPLAY
    presetStr := "ST表示候補：EMA" + str.tostring(l2EffEmaLen) +
         " / ATR" + str.tostring(l2EffAtrLen) +
         " / ×" + str.tostring(l2EffDpMult) +
         " / ATRSmooth" + str.tostring(l2EffAtrSmoothLen) +
         " / BandSmooth" + str.tostring(l2EffSmoothLen) +
         "  ※表示バンドのみ。価格State方式・ST設定・色判定方式は対象外"
else if l2PresetMode != PRESET_OFF
    presetStr := l2PresetMode + "：EMA" + str.tostring(l2EffEmaLen) +
         " / ATR" + str.tostring(l2EffAtrLen) +
         " / " + str.tostring(l2EffDpMult) +
         " / Smooth" + str.tostring(l2EffSmoothLen) +
         "  ※手動の 方式/ソース/EMA期間/ATR期間/表示倍率/各平滑化 は無効（転換判定方式は対象外）"

// LINE2 の転換判定方式（EMA ATR Breakout Band 以外では無効である旨も出す）
string l2SwitchModeStr = l2SwitchMode
if l2EffMethod != M_BREAK
    l2SwitchModeStr := l2SwitchMode + "（方式が " + l2EffMethod + " のため無効）"
else if l2PsUsesSt
    l2SwitchModeStr := l2SwitchMode + "（" + l2PsMode + " を使用中のためBreakout転換判定は無効）"
else if l2SwitchMode == SW_SEPARATE
    l2SwitchModeStr := "専用Band Up：EMA" + str.tostring(l2SepUpEmaLen) +
         " / ATR" + str.tostring(l2SepUpAtrLen) +
         " / ×" + str.tostring(l2SepUpMult) +
         (l2SepUpSmooth ? " / Smooth" + str.tostring(l2SepUpSmLen) : " / Smoothなし") +
         " | Dn：EMA" + str.tostring(l2SepDnEmaLen) +
         " / ATR" + str.tostring(l2SepDnAtrLen) +
         " / ×" + str.tostring(l2SepDnMult) +
         (l2SepDnSmooth ? " / Smooth" + str.tostring(l2SepDnSmLen) : " / Smoothなし") +
         "  しきい値 上=" + f_priceStr(l2EffSwUp) + " / 下=" + f_priceStr(l2EffSwLo)
else
    l2SwitchModeStr := l2SwitchMode + "  しきい値 上=" + f_priceStr(l2EffSwUp) + " / 下=" + f_priceStr(l2EffSwLo)

// 固定 ATR の状態（値と、実際に固定されたバーの時刻を UTC 表記で出す）
string frozenStr = "未固定（指定時刻に未到達）"
if l2FreezeFailed
    frozenStr := "指定時刻前の履歴が不足"
else if not na(l2FrozenAtr)
    frozenStr := f_priceStr(l2FrozenAtr) + " @ " + str.format_time(l2FrozenBarTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"

// 選択した並びの成立状況（比較用。反転は導出しない）
string orderStr = bgOrderMode + "  " + (orderMatch ? "○ 成立" : "✕")

// EMA ATR Breakout Band の内部値。
// 他方式を選んでいるときは表示しても意味がないので「未選択」と出す。
string l1BasisStr = "－（Breakout未選択）"
string l1SwUpStr  = "－（Breakout未選択）"
string l1SwLoStr  = "－（Breakout未選択）"
if l1EffMethod == M_BREAK
    l1BasisStr := f_priceStr(l1DiagBasis)
    l1SwUpStr  := f_priceStr(l1DiagSwUp)
    l1SwLoStr  := f_priceStr(l1DiagSwLo)

// 価格State方式によって、上の 2 行が何を指しているのかが変わるのでラベルも切り替える。
string l1SwUpLabel = "LINE1 switchUpper"
string l1SwLoLabel = "LINE1 switchLower"
if l1EffMethod == M_BREAK and (l1PsMode == L1_PS_BANDCFM or l1PsMode == L1_PS_SEPARATE)
    l1SwUpLabel := "LINE1 上側表示バンド"
    l1SwLoLabel := "LINE1 下側表示バンド"

// LINE1 の方向欄に、CSV検証プリセットと価格State方式の状態も併記する。
string l1InfoStr = f_dirStr(l1Dir) + "  (" + l1EffMethod + ")"
if l1PresetMode == L1_PRESET_CAND
    l1InfoStr := l1InfoStr + "\nLINE1候補：EMA" + str.tostring(l1EffEmaLen) + " / ATR" + str.tostring(l1EffAtrLen) + " / ×" + str.tostring(l1EffDpMult) + " / BandSmooth" + str.tostring(l1EffSmoothLen)
else
    l1InfoStr := l1InfoStr + "\nプリセット：OFF（上の LINE1 設定をそのまま使用）"
if l1PsMode == L1_PS_BANDCFM
    l1InfoStr := l1InfoStr + "\nState：Band突破 / Confirm" + str.tostring(l1BandCfmBars)
else if l1PsMode == L1_PS_SEPARATE
    l1InfoStr := l1InfoStr + "\nState：専用Band（" + l1StateSrcType + "）"
    l1InfoStr := l1InfoStr + "\nUp：EMA" + str.tostring(l1StateUpEmaLen) + " / ATR" + str.tostring(l1StateUpAtrLen) + " / ×" + str.tostring(l1StateUpMult) + " / " + (l1StateUpSmooth ? "Smooth" + str.tostring(l1StateUpSmoothLen) : "SmoothOFF") + " / Confirm" + str.tostring(l1StateUpConfirm) + " = " + f_priceStr(l1StateUpBand)
    l1InfoStr := l1InfoStr + "\nDn：EMA" + str.tostring(l1StateDnEmaLen) + " / ATR" + str.tostring(l1StateDnAtrLen) + " / ×" + str.tostring(l1StateDnMult) + " / " + (l1StateDnSmooth ? "Smooth" + str.tostring(l1StateDnSmoothLen) : "SmoothOFF") + " / Confirm" + str.tostring(l1StateDnConfirm) + " = " + f_priceStr(l1StateDnBand)
else
    l1InfoStr := l1InfoStr + "\nState：" + l1PsMode

string l2BasisStr = "－（Breakout未選択）"
string l2SwUpStr  = "－（Breakout未選択）"
string l2SwLoStr  = "－（Breakout未選択）"
if l2EffMethod == M_BREAK
    l2BasisStr := f_priceStr(l2DiagBasis)
    l2SwUpStr  := f_priceStr(l2DiagSwUp)
    l2SwLoStr  := f_priceStr(l2DiagSwLo)

if showDebug and barstate.islast
    string ts = debugTxtSize
    color  bgH = color.new(color.gray, 70)
    color  bgS = color.new(color.blue, 75)
    color  bgC = color.new(color.black, 60)

    table.cell(dbgTable, 0, 0, "SAT PANEL DEBUG", text_color = color.white, bgcolor = bgH, text_size = ts)
    table.cell(dbgTable, 1, 0, timeframe.period,  text_color = color.white, bgcolor = bgH, text_size = ts)

    // --- STB ---
    table.cell(dbgTable, 0, 1, "STB方向", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 1, f_dirStr(stbDir), text_color = f_dirCol(stbDir, stbUpCol, stbDnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 2, "STB displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 2, f_priceStr(stbDisplayLine), text_color = f_dirCol(stbDir, stbUpCol, stbDnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- LINE1 ---
    table.cell(dbgTable, 0, 3, "LINE1方向", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 3, l1InfoStr, text_color = f_dirCol(l1Dir, l1UpCol, l1DnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 4, "LINE1 basis", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 4, l1BasisStr, text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 5, l1SwUpLabel, text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 5, l1SwUpStr, text_color = l1DnCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 6, l1SwLoLabel, text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 6, l1SwLoStr, text_color = l1UpCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 7, "LINE1 displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 7, f_priceStr(l1DisplayLine), text_color = f_dirCol(l1Dir, l1UpCol, l1DnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- LINE2 ---
    table.cell(dbgTable, 0, 8, "LINE2 価格State/色", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 8, l2StateStr, text_color = f_dirCol(l2ColorDir, l2UpCol, l2DnCol, C_FLAT_DEF), bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 9, "LINE2 basis", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 9, l2BasisStr, text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 10, "LINE2 switchUpper", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 10, l2SwUpStr, text_color = l2DnCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 11, "LINE2 switchLower", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 11, l2SwLoStr, text_color = l2UpCol, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 12, "LINE2 displayLine", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 12, f_priceStr(l2DisplayLine), text_color = f_dirCol(l2Dir, l2UpCol, l2DnCol, C_FLAT_DEF), bgcolor = bgC, text_size = ts)

    // --- MA ---
    table.cell(dbgTable, 0, 13, "MA方向", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 13, f_dirStr(maDir), text_color = f_dirCol(maDir, maUpCol, maDnCol, maFlatCol), bgcolor = bgC, text_size = ts)

    // --- 並び順・背景 ---
    table.cell(dbgTable, 0, 14, "高い順の並び", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 14, rankStr, text_color = color.white, bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 15, "検証中の並び", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 15, orderStr, text_color = orderMatch ? bgOrderCol : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 16, "比較表示モード", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 16, viewMode + (showFlipMarker ? " ／ 転換マーカーON" : " ／ 転換マーカーOFF"), text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 17, "3本の最高/最安", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 17, f_priceStr(highestLine) + " / " + f_priceStr(lowestLine), text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 18, "最終背景判定", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 18, bgStr + "  [" + bgMode + "]",
         text_color = buyBackground ? bgBuyCol : sellBackground ? bgSellCol : color.white, bgcolor = bgS, text_size = ts)

    // --- MTF（参考表示のみ・背景には未使用） ---
    table.cell(dbgTable, 0, 19, "現在足STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 19, useTfChart ? f_dirStr(dirChart) : "OFF",
         text_color = useTfChart ? f_dirCol(dirChart, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 20, "15分STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 20, useTf15 ? f_dirStr(dir15) : "OFF",
         text_color = useTf15 ? f_dirCol(dir15, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 21, "1時間STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 21, useTf60 ? f_dirStr(dir60) : "OFF",
         text_color = useTf60 ? f_dirCol(dir60, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 22, "4時間STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 22, useTf240 ? f_dirStr(dir240) : "OFF",
         text_color = useTf240 ? f_dirCol(dir240, stbUpCol, stbDnCol, C_FLAT_DEF) : C_FLAT_DEF, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 23, "日足/週足STB", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 23,
         (useTfD ? f_dirStr(dirD) : "OFF") + " / " + (useTfW ? f_dirStr(dirW) : "OFF"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 24, "MTF（参考）", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 24,
         "B" + str.tostring(buyCount) + "/S" + str.tostring(sellCount) +
         " 計" + str.tostring(tfTotal) + " ｜" + mtfDesc +
         " [" + (mtfSignal == 1 ? "Buy" : mtfSignal == -1 ? "Sell" : "-") + "]",
         text_color = mtfSignal == 1 ? stbUpCol : mtfSignal == -1 ? stbDnCol : color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 25, "確定方法", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 25,
         (useConfirmed ? "確定足" : "形成中") + " / " + (mtfConfirmedOnly ? "MTF:確定" : "MTF:形成中"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 26, "表示バンド平滑化", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 26,
         "L1 " + (l1EffSmooth ? "ON(" + str.tostring(l1EffSmoothLen) + ")" : "OFF") +
         " / L2 " + (l2EffSmooth ? "ON(" + str.tostring(l2EffSmoothLen) + ")" : "OFF"),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 27, "固定ATR", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 27, frozenStr, text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 28, "L2 転換判定方式", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 28, l2SwitchModeStr, text_color = color.white, bgcolor = bgS, text_size = ts)

    table.cell(dbgTable, 0, 29, "L2 表示用ATR", text_color = color.white, bgcolor = bgC, text_size = ts)
    table.cell(dbgTable, 1, 29,
         (l2EffAtrSmooth ? "平滑化ON(" + str.tostring(l2EffAtrSmoothLen) + ")" : "平滑化OFF") +
         "  base=" + f_priceStr(l2AtrNow) + " / slow=" + f_priceStr(l2SlowAtr),
         text_color = color.white, bgcolor = bgC, text_size = ts)

    table.cell(dbgTable, 0, 30, "L2 CSV検証プリセット", text_color = color.white, bgcolor = bgS, text_size = ts)
    table.cell(dbgTable, 1, 30, presetStr, text_color = color.white, bgcolor = bgS, text_size = ts)

// © ka.mickey15
//
// ============================================================
//  フィボ戻り売り/押し目買い エントリーモジュール (フィボ専用)
//  (Fib Pullback Entry Module - Fibonacci only)
// ------------------------------------------------------------
//  参考: XAUUSD HTF Downtrend Fib Pullback Sell Strategy
//  ・思想: トレンド方向 → 戻り → フィボ戻し帯到達 → (反転確認) → エントリー
//  ・本モジュールは strategy ではなく indicator (シグナル出力のみ)
//  ・フィボに関する処理のみ (FVG/iFVG, SRフリップ, 重合判定,
//    下位足トリガー, 上位足フィルターは含まない)
//  ・request.security は使わない (リペイント回避 / 確定足判定可)
//  ・ADX / HH-HL 判定は不使用
//  ・SELL(戻り売り) と BUY(押し目買い) を対称に実装
//  ・環境認識モジュールの allow* / isRange に接続可能 (input.bool で代用)
//  ・ピボットで波を検出 → A/B/C ランク + (任意で反転確認) + 無効化
// ============================================================

//@version=5
indicator(
     title         = "Fib Pullback Entry Module",
     shorttitle    = "FibPB",
     overlay       = true,
     max_bars_back = 500,
     max_boxes_count  = 300,
     max_labels_count = 300
 )

// ============================================================
//  0. モジュール ON/OFF
// ============================================================
grpMod = "0) モジュール ON/OFF"
useModule = input.bool(true, "モジュール ON", group = grpMod)
useSell   = input.bool(true, "SELL (戻り売り) 検出", group = grpMod)
useBuy    = input.bool(true, "BUY (押し目買い) 検出", group = grpMod)

// ============================================================
//  1. 環境フィルター (環境認識モジュール接続用 / input.bool 代用)
// ============================================================
grpEnv = "1) 環境フィルター (環境認識モジュール接続)"
allowLongByEnvironment  = input.bool(true,  "allowLongByEnvironment",  group = grpEnv)
allowShortByEnvironment = input.bool(true,  "allowShortByEnvironment", group = grpEnv)
isRangeEnvironment      = input.bool(false, "isRangeEnvironment",      group = grpEnv)
suppressInRange         = input.bool(true,  "レンジ環境では検出を抑制", group = grpEnv)

// ============================================================
//  2. 共通 / 波検出
// ============================================================
grpGen = "2) 共通 / 波検出"
atrLen        = input.int(14,  "ATR 期間", minval = 1, group = grpGen)
ema20Len      = input.int(20,  "EMA20 期間 (反転確認用)", minval = 1, group = grpGen)
swingLookback = input.int(5,   "スイング検出 左右本数", minval = 1, group = grpGen)
waveLookback  = input.int(100, "波の有効本数 (古い波は無視)", minval = 10, group = grpGen)
minWaveATR    = input.float(3.0, "最低波幅 (ATR 倍)", minval = 0.0, step = 0.1, group = grpGen)
fibZoneBufferATR = input.float(1.0, "フィボゾーン許容 (ATR 倍)", step = 0.05, group = grpGen)
requireConfirmedBar = input.bool(true, "確定足でのみシグナル (リペイント回避)", group = grpGen)

// ============================================================
//  3. ランク ON/OFF + フィボレベル
// ============================================================
grpRank = "3) ランク / フィボレベル"
useRankA = input.bool(true, "A ランク (深い)", group = grpRank)
useRankB = input.bool(true, "B ランク (王道)", group = grpRank)
useRankC = input.bool(true, "C ランク (浅い)", group = grpRank)
fibAStart = input.float(0.618, "A 開始", step = 0.001, group = grpRank)
fibAEnd   = input.float(0.786, "A 終了", step = 0.001, group = grpRank)
fibBStart = input.float(0.500, "B 開始", step = 0.001, group = grpRank)
fibBEnd   = input.float(0.618, "B 終了", step = 0.001, group = grpRank)
fibCStart = input.float(0.382, "C 開始", step = 0.001, group = grpRank)
fibCEnd   = input.float(0.500, "C 終了", step = 0.001, group = grpRank)

// ============================================================
//  4. 反転確認 (フィボ到達後のローソク足確認 / 任意)
// ============================================================
grpConf = "4) 反転確認"
useRejectConfirm      = input.bool(true,  "反転確認を必須にする (OFFでゾーン到達のみ)", group = grpConf)
useCandleConfirm      = input.bool(true,  "陽線/陰線 確定",       group = grpConf)
usePinbarConfirm      = input.bool(true,  "ピンバー (上/下ヒゲ)", group = grpConf)
useEngulfingConfirm   = input.bool(true,  "包み足 (engulfing)",   group = grpConf)
useEma20Confirm       = input.bool(true,  "close と EMA20 の関係", group = grpConf)
useBreakPrevConfirm   = input.bool(true,  "直近足の高値/安値更新",  group = grpConf)
pinbarWickRatio       = input.float(2.0, "pinbarWickRatio (ヒゲ/実体比)", minval = 0, step = 0.1, group = grpConf)
engulfingBodyRatio    = input.float(1.0, "engulfingBodyRatio (実体比)",   minval = 0, step = 0.1, group = grpConf)

// ============================================================
//  5. 無効条件
// ============================================================
grpInv = "5) 無効条件"
useDeepLimitInvalid = input.bool(true, "深限界 (A終了%) 突破で無効", group = grpInv)
useOriginInvalid    = input.bool(true, "波の起点突破で無効",         group = grpInv)
useEMASettleInvalid = input.bool(true, "EMA定着で無効",             group = grpInv)

// ============================================================
//  6. 表示
// ============================================================
grpViz = "6) 表示"
showFib  = input.bool(true, "フィボ / 波を表示", group = grpViz)
showZone = input.bool(true, "ゾーンを表示",      group = grpViz)
showSignalLabels = input.bool(true, "シグナルラベルを表示", group = grpViz)
showZoneTouchLabel = input.bool(true, "ゾーン到達ラベルを表示", group = grpViz)
showOnlyLatestZone = input.bool(true, "最新ゾーンのみ表示 (OFFで過去も残す)", group = grpViz)
zoneRightBars = input.int(20, "ゾーン右延長本数", minval = 1, group = grpViz)
showDebugTable = input.bool(true, "デバッグテーブルを表示", group = grpViz)

// ============================================================
//  共通計算
// ============================================================
atr   = ta.atr(atrLen)
ema20 = ta.ema(close, ema20Len)
tfMs  = timeframe.in_seconds(timeframe.period) * 1000

// レンジ環境抑制
envBlock  = isRangeEnvironment and suppressInRange
sellEnvOK = allowShortByEnvironment and not envBlock
buyEnvOK  = allowLongByEnvironment  and not envBlock

// ============================================================
//  波の自動検出 (ピボット)
// ============================================================
ph = ta.pivothigh(high, swingLookback, swingLookback)
pl = ta.pivotlow(low,  swingLookback, swingLookback)

var float lastPH     = na
var int   lastPHbar  = na
var int   lastPHtime = na
var float lastPL     = na
var int   lastPLbar  = na
var int   lastPLtime = na

if not na(ph)
    lastPH     := ph
    lastPHbar  := bar_index - swingLookback
    lastPHtime := time[swingLookback]
if not na(pl)
    lastPL     := pl
    lastPLbar  := bar_index - swingLookback
    lastPLtime := time[swingLookback]

bothPivots = not na(lastPH) and not na(lastPL)

// 下降波: 高値 → 安値 の順 (SELL 用)
downWaveValid = bothPivots and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)
// 上昇波: 安値 → 高値 の順 (BUY 用)
upWaveValid   = bothPivots and (lastPLbar < lastPHbar) and ((lastPH - lastPL) >= atr * minWaveATR) and ((bar_index - lastPLbar) <= waveLookback)

// --- SELL 波 (安値起点で戻りを測る) ---
sSwingHigh = lastPH
sSwingLow  = lastPL
sRange     = sSwingHigh - sSwingLow
sRetracePct = downWaveValid and sRange > 0 ? math.max(0.0, math.min(1.0, (close - sSwingLow) / sRange)) : na

// --- BUY 波 (高値起点で押しを測る) ---
bSwingHigh = lastPH
bSwingLow  = lastPL
bRange     = bSwingHigh - bSwingLow
bRetracePct = upWaveValid and bRange > 0 ? math.max(0.0, math.min(1.0, (bSwingHigh - close) / bRange)) : na

// ============================================================
//  ランク判定 (A>B>C / 非重複境界)
// ============================================================
f_rank(float pct) =>
    int r = 0
    if not na(pct)
        if useRankA and pct >= fibAStart and pct <= fibAEnd
            r := 3
        else if useRankB and pct >= fibBStart and pct < fibBEnd
            r := 2
        else if useRankC and pct >= fibCStart and pct < fibCEnd
            r := 1
    r

f_rankName(int r) => r == 3 ? "A" : r == 2 ? "B" : r == 1 ? "C" : "None"

sRank = f_rank(sRetracePct)
bRank = f_rank(bRetracePct)

// ============================================================
//  ゾーン価格レベル
// ============================================================
// SELL (安値から上に戻す)
sZoneLowPrice  = sSwingLow + fibCStart * sRange   // 38.2% (浅, 下端)
sZoneHighPrice = sSwingLow + fibAEnd   * sRange   // 78.6% (深, 上端)
sDeepLimit     = sSwingLow + fibAEnd   * sRange   // これ以上戻ると無効

// BUY (高値から下に押す)
bZoneHighPrice = bSwingHigh - fibCStart * bRange  // 38.2% (浅, 上端)
bZoneLowPrice  = bSwingHigh - fibAEnd   * bRange  // 78.6% (深, 下端)
bDeepLimit     = bSwingHigh - fibAEnd   * bRange  // これ以上押すと無効

// 価格がゾーン帯に重なっているか (バッファ込み)
buf = atr * fibZoneBufferATR
priceInSellZone = downWaveValid and sRank > 0 and (high >= sZoneLowPrice - buf) and (low <= sZoneHighPrice + buf)
priceInBuyZone  = upWaveValid   and bRank > 0 and (low <= bZoneHighPrice + buf) and (high >= bZoneLowPrice - buf)

// アクティブランクのゾーン高安 (出力用)
sActZoneHigh = sRank == 3 ? sSwingLow + fibAEnd*sRange : sRank == 2 ? sSwingLow + fibBEnd*sRange : sRank == 1 ? sSwingLow + fibCEnd*sRange : na
sActZoneLow  = sRank == 3 ? sSwingLow + fibAStart*sRange : sRank == 2 ? sSwingLow + fibBStart*sRange : sRank == 1 ? sSwingLow + fibCStart*sRange : na
bActZoneHigh = bRank == 3 ? bSwingHigh - fibAStart*bRange : bRank == 2 ? bSwingHigh - fibBStart*bRange : bRank == 1 ? bSwingHigh - fibCStart*bRange : na
bActZoneLow  = bRank == 3 ? bSwingHigh - fibAEnd*bRange : bRank == 2 ? bSwingHigh - fibBEnd*bRange : bRank == 1 ? bSwingHigh - fibCEnd*bRange : na

// ============================================================
//  反転確認 (フィボ到達後のローソク足確認)
// ============================================================
body      = math.abs(close - open)
bodyPrev  = math.abs(close[1] - open[1])
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// SELL 反転 (戻り上限での反転=陰転)
bearCandle = close < open
upPinbar   = body > 0 and upperWick >= pinbarWickRatio * body and upperWick > lowerWick
bearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1] and body >= engulfingBodyRatio * bodyPrev
breakPrevLow = low < low[1]
sellConfirm = (useCandleConfirm and bearCandle) or (usePinbarConfirm and upPinbar) or (useEngulfingConfirm and bearEngulf) or (useEma20Confirm and close < ema20) or (useBreakPrevConfirm and breakPrevLow)

// BUY 反転 (押し下限での反転=陽転)
bullCandle = close > open
dnPinbar   = body > 0 and lowerWick >= pinbarWickRatio * body and lowerWick > upperWick
bullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1] and body >= engulfingBodyRatio * bodyPrev
breakPrevHigh = high > high[1]
buyConfirm = (useCandleConfirm and bullCandle) or (usePinbarConfirm and dnPinbar) or (useEngulfingConfirm and bullEngulf) or (useEma20Confirm and close > ema20) or (useBreakPrevConfirm and breakPrevHigh)

// ============================================================
//  無効条件
// ============================================================
invSell = downWaveValid and ((useDeepLimitInvalid and close > sDeepLimit) or (useOriginInvalid and close > sSwingHigh) or (useEMASettleInvalid and close > ema20 and close[1] > ema20))
invBuy  = upWaveValid   and ((useDeepLimitInvalid and close < bDeepLimit) or (useOriginInvalid and close < bSwingLow)  or (useEMASettleInvalid and close < ema20 and close[1] < ema20))

// ============================================================
//  セットアップ / シグナル
// ============================================================
confirmedOK = not requireConfirmedBar or barstate.isconfirmed

sellSetup = useModule and useSell and sellEnvOK and priceInSellZone and not invSell
buySetup  = useModule and useBuy  and buyEnvOK  and priceInBuyZone  and not invBuy

fibSellSignal = sellSetup and (not useRejectConfirm or sellConfirm) and confirmedOK
fibBuySignal  = buySetup  and (not useRejectConfirm or buyConfirm)  and confirmedOK

// ============================================================
//  出力 (環境/エントリーモジュール接続用)
// ============================================================
// --- SELL ---
fibSellZone      = priceInSellZone
fibSellRank      = sRank
fibSellRankName  = f_rankName(sRank)
fibSellRetracePct = sRetracePct
fibSellZoneHigh  = sActZoneHigh
fibSellZoneLow   = sActZoneLow
fibSellSwingHigh = downWaveValid ? sSwingHigh : na
fibSellSwingLow  = downWaveValid ? sSwingLow  : na

// --- BUY ---
fibBuyZone      = priceInBuyZone
fibBuyRank      = bRank
fibBuyRankName  = f_rankName(bRank)
fibBuyRetracePct = bRetracePct
fibBuyZoneHigh  = bActZoneHigh
fibBuyZoneLow   = bActZoneLow
fibBuySwingHigh = upWaveValid ? bSwingHigh : na
fibBuySwingLow  = upWaveValid ? bSwingLow  : na

// --- 共通 ---
fibActive    = fibBuyZone or fibSellZone
fibDirection = fibBuySignal ? 1 : fibSellSignal ? -1 : fibBuyZone ? 1 : fibSellZone ? -1 : 0
fibRank      = fibDirection == 1 ? bRank : fibDirection == -1 ? sRank : 0
fibRankName  = f_rankName(fibRank)

// 後続エントリーモジュール接続用
allowEntryLong  = fibBuySignal
allowEntryShort = fibSellSignal

// ============================================================
//  可視化 : フィボ / 波ライン
// ============================================================
plotSwingHigh = showFib and (downWaveValid or upWaveValid) ? lastPH : na
plotSwingLow  = showFib and (downWaveValid or upWaveValid) ? lastPL : na
plot(plotSwingHigh, "Swing High", color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 2)
plot(plotSwingLow,  "Swing Low",  color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plot(showFib ? ema20 : na, "EMA20", color = color.new(color.blue, 40))

// ============================================================
//  可視化 : ゾーン box (time ベース)
// ============================================================
var box bxS_A = na
var box bxS_B = na
var box bxS_C = na
var box bxB_A = na
var box bxB_B = na
var box bxB_C = na

sellDrawEvent = priceInSellZone and not priceInSellZone[1]
buyDrawEvent  = priceInBuyZone  and not priceInBuyZone[1]

f_newBox(int lt, float top, int rt, float bot, color bc, color bg) =>
    box.new(lt, top, rt, bot, xloc = xloc.bar_time, border_color = bc, bgcolor = bg)

// 最新のみ表示モード : 毎足リフレッシュ
if showZone and showOnlyLatestZone and barstate.islast
    if not na(bxS_A)
        box.delete(bxS_A)
    if not na(bxS_B)
        box.delete(bxS_B)
    if not na(bxS_C)
        box.delete(bxS_C)
    if not na(bxB_A)
        box.delete(bxB_A)
    if not na(bxB_B)
        box.delete(bxB_B)
    if not na(bxB_C)
        box.delete(bxB_C)
    bxS_A := na
    bxS_B := na
    bxS_C := na
    bxB_A := na
    bxB_B := na
    bxB_C := na
    rt = time + zoneRightBars * tfMs
    if useSell and downWaveValid
        if useRankA
            bxS_A := f_newBox(lastPLtime, sSwingLow + fibAEnd*sRange,   rt, sSwingLow + fibAStart*sRange, color.new(color.red,40), color.new(color.red,75))
        if useRankB
            bxS_B := f_newBox(lastPLtime, sSwingLow + fibBEnd*sRange,   rt, sSwingLow + fibBStart*sRange, color.new(color.red,40), color.new(color.red,82))
        if useRankC
            bxS_C := f_newBox(lastPLtime, sSwingLow + fibCEnd*sRange,   rt, sSwingLow + fibCStart*sRange, color.new(color.red,40), color.new(color.red,88))
    if useBuy and upWaveValid
        if useRankA
            bxB_A := f_newBox(lastPHtime, bSwingHigh - fibAStart*bRange, rt, bSwingHigh - fibAEnd*bRange, color.new(color.green,40), color.new(color.green,75))
        if useRankB
            bxB_B := f_newBox(lastPHtime, bSwingHigh - fibBStart*bRange, rt, bSwingHigh - fibBEnd*bRange, color.new(color.green,40), color.new(color.green,82))
        if useRankC
            bxB_C := f_newBox(lastPHtime, bSwingHigh - fibCStart*bRange, rt, bSwingHigh - fibCEnd*bRange, color.new(color.green,40), color.new(color.green,88))

// 過去ゾーンも残すモード : ゾーン到達時に1度だけ描画
if showZone and not showOnlyLatestZone
    rtP = time + zoneRightBars * tfMs
    if useSell and downWaveValid and sellDrawEvent
        if useRankA
            f_newBox(lastPLtime, sSwingLow + fibAEnd*sRange, rtP, sSwingLow + fibAStart*sRange, color.new(color.red,40), color.new(color.red,75))
        if useRankB
            f_newBox(lastPLtime, sSwingLow + fibBEnd*sRange, rtP, sSwingLow + fibBStart*sRange, color.new(color.red,40), color.new(color.red,82))
        if useRankC
            f_newBox(lastPLtime, sSwingLow + fibCEnd*sRange, rtP, sSwingLow + fibCStart*sRange, color.new(color.red,40), color.new(color.red,88))
    if useBuy and upWaveValid and buyDrawEvent
        if useRankA
            f_newBox(lastPHtime, bSwingHigh - fibAStart*bRange, rtP, bSwingHigh - fibAEnd*bRange, color.new(color.green,40), color.new(color.green,75))
        if useRankB
            f_newBox(lastPHtime, bSwingHigh - fibBStart*bRange, rtP, bSwingHigh - fibBEnd*bRange, color.new(color.green,40), color.new(color.green,82))
        if useRankC
            f_newBox(lastPHtime, bSwingHigh - fibCStart*bRange, rtP, bSwingHigh - fibCEnd*bRange, color.new(color.green,40), color.new(color.green,88))

// ============================================================
//  可視化 : シグナル / ゾーン到達ラベル / 無効化
// ============================================================
if showSignalLabels and fibSellSignal
    label.new(bar_index, high, "SELL " + fibSellRankName + "\n" + str.tostring(math.round(sRetracePct*100,1)) + "%", style = label.style_label_down, color = color.new(color.red,0), textcolor = color.white, size = size.small)
if showSignalLabels and fibBuySignal
    label.new(bar_index, low, "BUY " + fibBuyRankName + "\n" + str.tostring(math.round(bRetracePct*100,1)) + "%", style = label.style_label_up, color = color.new(color.green,0), textcolor = color.white, size = size.small)

if showZoneTouchLabel and sellDrawEvent
    label.new(bar_index, high, "SELL ZONE " + fibSellRankName, style = label.style_label_down, color = color.new(color.red,40), textcolor = color.white, size = size.tiny)
if showZoneTouchLabel and buyDrawEvent
    label.new(bar_index, low, "BUY ZONE " + fibBuyRankName, style = label.style_label_up, color = color.new(color.green,40), textcolor = color.white, size = size.tiny)

// ゾーン待機マーカー (セットアップ成立だが反転確認未発火)
plotshape(sellSetup and not fibSellSignal, title = "Sell Ready", style = shape.circle, location = location.abovebar, color = color.new(color.orange,0), size = size.tiny)
plotshape(buySetup  and not fibBuySignal,  title = "Buy Ready",  style = shape.circle, location = location.belowbar, color = color.new(color.lime,0),   size = size.tiny)

// 無効化ラベル
if invSell and downWaveValid and not invSell[1]
    label.new(bar_index, high, "SELL 無効化", style = label.style_label_down, color = color.new(color.gray,20), textcolor = color.white, size = size.tiny)
if invBuy and upWaveValid and not invBuy[1]
    label.new(bar_index, low, "BUY 無効化", style = label.style_label_up, color = color.new(color.gray,20), textcolor = color.white, size = size.tiny)

// ============================================================
//  デバッグテーブル (右下)
// ============================================================
var table dbg = table.new(position.bottom_right, 2, 7, border_width = 1)
f_dir2txt(int d) => d == 1 ? "BUY" : d == -1 ? "SELL" : "None"

if showDebugTable and barstate.islast
    actRetr = fibDirection == 1 ? bRetracePct : fibDirection == -1 ? sRetracePct : na
    actZone = fibDirection == 1 ? fibBuyZone : fibDirection == -1 ? fibSellZone : false
    actSig  = fibDirection == 1 ? fibBuySignal : fibDirection == -1 ? fibSellSignal : false
    dCol = fibDirection == 1 ? color.new(color.green,0) : fibDirection == -1 ? color.new(color.red,0) : color.new(color.gray,0)
    table.cell(dbg, 0, 0, "FibPB", text_color = color.white, bgcolor = color.new(color.blue,0))
    table.cell(dbg, 1, 0, "値", text_color = color.white, bgcolor = color.new(color.blue,0))
    table.cell(dbg, 0, 1, "direction", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 1, f_dir2txt(fibDirection), text_color = color.white, bgcolor = dCol)
    table.cell(dbg, 0, 2, "retrace %", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 2, na(actRetr) ? "-" : str.tostring(math.round(actRetr*100,1)) + "%", text_color = color.white, bgcolor = color.new(color.gray,50))
    table.cell(dbg, 0, 3, "rank", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 3, fibRankName, text_color = color.white, bgcolor = color.new(color.gray,50))
    table.cell(dbg, 0, 4, "zone", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 4, actZone ? "true" : "false", text_color = color.white, bgcolor = actZone ? color.new(color.teal,20) : color.new(color.gray,50))
    table.cell(dbg, 0, 5, "signal", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 5, actSig ? "true" : "false", text_color = color.white, bgcolor = actSig ? color.new(color.orange,0) : color.new(color.gray,50))
    table.cell(dbg, 0, 6, "wave", text_color = color.white, bgcolor = color.new(color.gray,30))
    table.cell(dbg, 1, 6, downWaveValid ? "DOWN" : upWaveValid ? "UP" : "-", text_color = color.white, bgcolor = color.new(color.gray,50))

// ============================================================
//  アラート
// ============================================================
sellZoneArrival = priceInSellZone and not priceInSellZone[1]
buyZoneArrival  = priceInBuyZone  and not priceInBuyZone[1]
fibA_buy  = fibBuySignal  and bRank == 3
fibB_buy  = fibBuySignal  and bRank == 2
fibC_buy  = fibBuySignal  and bRank == 1
fibA_sell = fibSellSignal and sRank == 3
fibB_sell = fibSellSignal and sRank == 2
fibC_sell = fibSellSignal and sRank == 1

alertcondition(sellZoneArrival, "Sell Zone Arrival", "売りゾーン到達")
alertcondition(buyZoneArrival,  "Buy Zone Arrival",  "買いゾーン到達")
alertcondition(fibSellSignal,   "Fib SELL Signal",   "フィボ戻り売り シグナル")
alertcondition(fibBuySignal,    "Fib BUY Signal",    "フィボ押し目買い シグナル")
alertcondition(fibA_sell, "Fib A SELL", "A ランク SELL")
alertcondition(fibB_sell, "Fib B SELL", "B ランク SELL")
alertcondition(fibC_sell, "Fib C SELL", "C ランク SELL")
alertcondition(fibA_buy,  "Fib A BUY",  "A ランク BUY")
alertcondition(fibB_buy,  "Fib B BUY",  "B ランク BUY")
alertcondition(fibC_buy,  "Fib C BUY",  "C ランク BUY")

// ============================================================
//  Data Window 出力
// ============================================================
plot(fibDirection,        "fibDirection",     display = display.data_window)
plot(fibRank,             "fibRank",          display = display.data_window)
plot(fibActive ? 1 : 0,   "fibActive",        display = display.data_window)
plot(allowEntryLong ? 1:0, "allowEntryLong",  display = display.data_window)
plot(allowEntryShort ? 1:0,"allowEntryShort", display = display.data_window)
plot(fibSellSignal ? 1:0, "fibSellSignal",    display = display.data_window)
plot(fibSellZone ? 1:0,   "fibSellZone",      display = display.data_window)
plot(fibSellRank,         "fibSellRank",      display = display.data_window)
plot(fibSellRetracePct,   "fibSellRetracePct", display = display.data_window)
plot(fibSellSwingHigh,    "fibSellSwingHigh", display = display.data_window)
plot(fibSellSwingLow,     "fibSellSwingLow",  display = display.data_window)
plot(fibBuySignal ? 1:0,  "fibBuySignal",     display = display.data_window)
plot(fibBuyZone ? 1:0,    "fibBuyZone",       display = display.data_window)
plot(fibBuyRank,          "fibBuyRank",       display = display.data_window)
plot(fibBuyRetracePct,    "fibBuyRetracePct", display = display.data_window)
plot(fibBuySwingHigh,     "fibBuySwingHigh",  display = display.data_window)
plot(fibBuySwingLow,      "fibBuySwingLow",   display = display.data_window)

zoneCfg.tpBuffer             := tpBuffer
zoneCfg.maxSlDist            := maxSlDist
zoneCfg.minStructRR          := minStructRR
zoneCfg.slMinScore           := slMinScore
zoneCfg.slMinStrength        := zn.strengthIdx(slMinStrStr)
zoneCfg.tpMinScore           := tpMinScore
zoneCfg.tpMinStrength        := zn.strengthIdx(tpMinStrStr)
zoneCfg.obsMinStrength       := zn.strengthIdx(obsMinStrStr)
zoneCfg.activeNoTradeMinStrength := zn.strengthIdx(activeNoTradeMinStrStr)
zoneCfg.structuralTpDepthRatio := structuralTpDepthRatio
zoneCfg.fallbackRR           := fallbackRR

// ============================================================================
// 03. ZONE ENGINE FEED (安定版 Main と同じ request / Feed / update)
// ============================================================================
// ---- 3.2 Zone Engine Feed --------------------------------------------------
// ★ MA2000 / MA3000 : zn.maPack() を 1分足コンテキストで評価させる。
//   maPack() の中身は ta.ema(close, 2000) 等であり、この close は1分足のclose。
//   → 5分足closeからの再計算ではない。
//  ★ Source が OFF のときは取得自体を行わない (結果不変・下の理由による) ★
//    Library 側は MA / Swing / Accum のどれも
//      「c.useXxxSource が true」かつ「値が na でない」
//    ときにしか Zone を登録しない。OFF のとき取得値は元々一切使われていないため、
//    na を渡すのと実測値を渡すのは Zone 時系列に対して完全に等価。
//    エッジ検出 (nPh1 / nAc1 等) も not na(...) を要求するので false のまま。
float ma1Val   = na
float ma1Delta = na
float ma2Val   = na
float ma2Delta = na
if useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Val   := _m1
    ma1Delta := _m1d
    ma2Val   := _m2
    ma2Delta := _m2d

float ph1 = na
int   ph1T = na
float pl1 = na
int   pl1T = na
float ph2 = na
int   ph2T = na
float pl2 = na
int   pl2T = na
float ph3 = na
int   ph3T = na
float pl3 = na
int   pl3T = na
if useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1 := _h1
    ph1T := _h1t
    pl1 := _l1
    pl1T := _l1t
    ph2 := _h2
    ph2T := _h2t
    pl2 := _l2
    pl2T := _l2t
    ph3 := _h3
    ph3T := _h3t
    pl3 := _l3
    pl3T := _l3t

bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1Hi = na
float acc1Lo = na
int   acc1Id = na
float acc2Hi = na
float acc2Lo = na
int   acc2Id = na
float acc3Hi = na
float acc3Lo = na
int   acc3Id = na
if useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)
    acc1Hi := _a1h
    acc1Lo := _a1l
    acc1Id := _a1i
    acc2Hi := _a2h
    acc2Lo := _a2l
    acc2Id := _a2i
    acc3Hi := _a3h
    acc3Lo := _a3l
    acc3Id := _a3i

// Break判定は breakTf の「確定終値」のみ (ヒゲでは判定しない)
[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low],
     lookahead = barmerge.lookahead_off)
bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

// 取引日ID (timestamp/hour の timezone は series 不可なので Main で計算する)
int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T,
     ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id,
     acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id,
     dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)

int zoneCountNow = zn.update(zoneEng, zoneCfg, zoneFeed)


// ============================================================================
// 04. 移植元ロジック本体 (包み足 / トリガー / ボラ)
// ============================================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ============================================================
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// 有効化されたトリガー数 (Any/All/MinCount 判定で使用・全コンテキスト共通)。
//   f_calcTriggers 内 (=1分足コンテキスト) からも参照するため関数より前で定義する。
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// 1分足コンテキストで全トリガーを判定し、その1分足単体で Any/All/MinCount を評価して
//   [bullTrigger, bearTrigger] を返す。異なる1分足で発生した条件を合算しない。
//   各トリガー条件・品質フィルターは既存ロジックと完全に同一 (変更なし)。
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    // この1分足単体で Any/All/MinCount を評価 (1分足内で完結)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

// 現在足(5分足)での直接判定 (useLowerTFTrigger = false 時のフォールバックのみに使用)
bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 1分足トリガー集約 ---
//   request.security_lower_tf で現在の5分足に含まれる確定済み1分足 (最大5本) の
//   [bullTrigger, bearTrigger] を配列で取得。5本のうち1本でも成立していれば
//   その方向を5分足の候補とする (途中の1分足トリガーを取りこぼさない)。
//   Any/All/MinCount は各1分足内で f_calcTriggers が評価済み → 異なる足の条件は合算しない。
//   ※ 形成途中の1分足は request.security_lower_tf の確定済み配列に含まれないため非リペイント。
bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, TRIG_TF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    // 1分足トリガー OFF → 現在足(5分足)で直接判定
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

// 同一5分足内でロング/ショート両方の1分足トリガーが発生 → 方向を予想せず NoTrade (既定)。
bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

// エントリークールダウン (5分足単位・トリガーON時のみ 10c で参照)
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

//  6. ボラフィルタ判定
// ============================================================
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  8g-2. Intermarket 環境認識モジュール 本体 (DXY 単体 / 15分足)
// ------------------------------------------------------------
//  関数 (f_imDataConfirmed / f_corrPush2 / f_corrCalc / f_macroState) は
//  移植元と1文字も変えていない。呼び出しを DXY × 15M の1組だけに絞っている。
// ============================================================
// 確定TF足の [変化率%, 直近変化率%, 終値, 上昇構造維持, 下降構造維持] を返す。
//   ・すべて TFコンテキスト内で確定1本前[1] に固定 (lookahead_on と組み合わせて非リペイント)。
//   ・上昇構造維持 = 現在の終値が「直近 structLen 本の安値」を割っていない。
//   ・下降構造維持 = 現在の終値が「直近 structLen 本の高値」を超えていない。
//     直近 structLen 本は ta.lowest/ta.highest(...)[1] で当該足自身を除外して評価する。
f_imDataConfirmed(int len, int recentLen, int structLen) =>
    float _chg    = (na(close[len])       or close[len] == 0)       ? 0.0 : (close - close[len])       / close[len]       * 100.0
    float _recent = (na(close[recentLen]) or close[recentLen] == 0) ? 0.0 : (close - close[recentLen]) / close[recentLen] * 100.0
    float _loN = ta.lowest(low,   structLen)[1]
    float _hiN = ta.highest(high, structLen)[1]
    bool  _structUp = not na(_loN) and close >= _loN
    bool  _structDn = not na(_hiN) and close <= _hiN
    [_chg[1], _recent[1], close[1], _structUp[1], _structDn[1]]

// MTF相関: 各参照TFの確定足を「そのTF自身のバー単位」でバッファ蓄積し相関を計算する。
//   ・チャート(5分足)へ展開後の series に ta.correlation(..., len) すると len が
//     5分足本数になり本来のTF相関にならない。そこで doPush (= そのTFの新しい確定足
//     が始まった足) の時だけ Gold/市場の確定終値をペアで push し、TF足 len 本で計算。
//   ・Gold と市場を同時に push するので、常に「同じ確定TF足同士」の対で揃う (非リペイント)。
f_corrPush2(array<float> ga, array<float> ma, bool doPush, float g, float m, int len) =>
    if doPush and not na(g) and not na(m)
        array.push(ga, g)
        array.push(ma, m)
        while array.size(ga) > len
            array.shift(ga)
            array.shift(ma)

// バッファ (= 参照TF確定足 len 本) 上の Pearson 相関 (len 本揃うまで na)。
f_corrCalc(array<float> ga, array<float> ma, int len) =>
    int _n = array.size(ga)
    float _corr = na
    if _n >= len
        float _mg = array.avg(ga)
        float _mm = array.avg(ma)
        float _cov = 0.0
        float _vg  = 0.0
        float _vm  = 0.0
        for i = 0 to _n - 1
            float _dg = array.get(ga, i) - _mg
            float _dm = array.get(ma, i) - _mm
            _cov += _dg * _dm
            _vg  += _dg * _dg
            _vm  += _dm * _dm
        float _den = math.sqrt(_vg * _vm)
        _corr := _den > 0 ? _cov / _den : na
    _corr

// Intermarket Relationship 状態機械 (対象市場が「主」・Goldの反応が「従」)。
// ------------------------------------------------------------
//  inverseMkt = true  … DXY / Yield / Oil (Goldと逆相関前提)
//  inverseMkt = false … Silver            (Goldと正相関前提)
//
//  ① 主市場の方向 _mDir : |mChg| >= mMinMove のときだけ ±1。未満は 0 = 未分類。
//     市場が十分動いていない足では Normal / Distortion の状態遷移を一切行わない。
//  ② Goldの反応 _gResp : gChg >= +goldResponseMinChange → 1
//                        gChg <= -goldResponseMinChange → -1
//                        その間 → 0 (Neutral = 無反応 / 耐え)
//     単純な gChg > 0 / < 0 では方向判定しない。
//  ③ 期待方向 _expected = inverseMkt ? -_mDir : _mDir
//     関係 _rel : 1 = Normal            (_gResp == _expected)
//                 2 = DistortionNeutral (_gResp == 0 … 市場は動いたがGoldが反応しない)
//                 3 = DistortionOpposite/SameDirection (_gResp == -_expected)
//     「逆相関が崩れた」= 同方向になった場合だけではない。Gold無反応も崩れとして扱う。
//
//  状態遷移 (市場が動いた足 _rel != 0 のときだけ):
//     Normal     : 直前が Normal かつ (任意で直前の corr 条件成立) で _rel != 1 になった足 → Distortion 開始
//     Distortion : retLookback 本以内に _rel == 1 へ戻った最初の足 → Return 発火 → Normal へ
//                  戻らずに期限超過 → Expired → Normal へ (Returnイベントは出さない)
//     期限切れ判定だけは _rel == 0 (主市場が動いていない足) でも毎確定TF足で必ず進める。
//     Return は _rel == 1 の足でのみ発火する (_rel == 0 では発火しない)。
//     Return イベントは 2軸で独立に選別できる (検出ロジックではなく出力フィルタ)。
//       軸1 起点 Distortion の種別 : useRetNeutral / useRetSame
//         種別は Distortion 開始足で _distKindStart に保存し Return 成立まで保持する
//         (継続中に Neutral ⇔ SameDirection が入れ替わっても起点の種別は変わらない)。
//       軸2 Return の種別 (Original / Opposite) : useRetOriginal / useRetOpposite
//         既存の returnType をそのまま使う (判定の作り直しはしない)。
//  Return方向は「実際に正常な関係へ復帰したときのGold方向」= _gResp。
//     逆相関市場 : 市場↓/Gold↑ → Long / 市場↑/Gold↓ → Short
//     Silver     : Silver↑/Gold↑ → Long / Silver↓/Gold↓ → Short
//  Return種別 : _retDir == Distortion直前のGold方向 → Original / 不一致 → Opposite
//  Leader は「Distortion中にどちら側が元の方向+構造を維持しているか」の分析用情報であり、
//     Return方向の決定には一切使用しない (両方維持・両方崩れは 0 = 不明)。
//  戻り値 [score, reason(1/-1/0), noTrade,
//          state(0=Normal/1=DistNeutral/2=DistOpposite/3=Return/4=Expired),
//          preGoldDir, returnType(0/1=Original/2=Opposite), returnDir, leader(1=Gold/-1=市場/0=不明),
//          mktDir(1/-1/0), goldResp(1/-1/0), preMktDir]
f_macroState(bool active, bool newBar, int holdBars, float gChg, float mChg, float corr, bool gStructUp, bool gStructDn, bool mStructUp, bool mStructDn, bool inverseMkt, bool useDir, bool useCorr, bool useDistNT, bool useRet, bool useRetNeutral, bool useRetSame, bool useRetOriginal, bool useRetOpposite, float corrThresh, float dirMinChg, int retLookback, float eventPoint, float mMinMove) =>
    var int   _tfBar        = 0
    var int   _reason       = 0
    var int   _evBar        = na
    var bool  _noTrade      = false
    var int   _prevRawEvent = 0
    // --- Relationship 状態機械 ---
    var int   _state      = 0     // 0=Normal 1=Distortion
    var int   _distKind   = 0     // 1=Neutral 2=Opposite/SameDirection (表示用・継続中に更新される)
    var int   _distKindStart = 0  // Distortion 開始時の種別 (Return まで保持・イベント種別フィルタ用)
    var bool  _expired    = false
    var bool  _returnBar  = false
    var int   _distortBar = na
    var int   _returnType = 0
    var int   _returnDir  = 0
    var int   _leader     = 0
    var int   _mDirOut    = 0
    var int   _gRespOut   = 0
    // --- Distortion 直前 (= 最後に Normal だった確定TF足) の保存値 ---
    var int   _preGoldDir      = 0
    var int   _preMktDir       = 0
    var float _preGoldChg      = 0.0
    var float _preMktChg       = 0.0
    var bool  _preGoldLed      = false
    var bool  _preMktLed       = false
    var bool  _preGoldStructUp = false
    var bool  _preGoldStructDn = false
    var bool  _preMktStructUp  = false
    var bool  _preMktStructDn  = false
    // --- 1本前の「分類できた」確定TF足スナップショット ---
    var int   _prevGoldDir = 0
    var int   _prevMktDir  = 0
    var float _prevGoldChg = 0.0
    var float _prevMktChg  = 0.0
    var bool  _prevRelNormal = false
    var bool  _prevCorrOk    = false
    var bool  _prevGoldStructUp = false
    var bool  _prevGoldStructDn = false
    var bool  _prevMktStructUp  = false
    var bool  _prevMktStructDn  = false
    if active and newBar
        _tfBar += 1
        _returnBar := false
        // ① 主 = 市場。最低変化率以上動いた足だけ関係を分類する。
        float _mThr = useDistortionMinMove ? mMinMove : 0.0
        int   _mDir = (mChg > 0 and math.abs(mChg) >= _mThr) ? 1 : (mChg < 0 and math.abs(mChg) >= _mThr) ? -1 : 0
        // ② 従 = Gold。goldResponseMinChange 未満は Neutral (無反応)。
        int   _gResp = gChg >= goldResponseMinChange ? 1 : gChg <= -goldResponseMinChange ? -1 : 0
        _mDirOut  := _mDir
        _gRespOut := _gResp
        // 相関は補助条件。逆相関市場は corr <= -th、正相関市場(Silver)は corr >= +th。
        bool _corrOkNow = not na(corr) and (inverseMkt ? corr <= -corrThresh : corr >= corrThresh)
        // ③ 関係分類
        int _expected = inverseMkt ? -_mDir : _mDir
        int _rel      = _mDir == 0 ? 0 : _gResp == _expected ? 1 : _gResp == 0 ? 2 : 3
        int _retDir   = 0
        int _retType  = 0
        int _retKind  = 0
        // --- Distortion の期限切れ判定 ---
        //   時間経過は主市場が動いたかどうかに関係なく、参照TFの新しい確定足ごとに必ず進める。
        //   _rel == 0 (主市場が最低変化率未満) の足でも期限超過ならこの足で Expired へ遷移する。
        //   → Distortion を「次に主市場が動くまで無期限に残す」ことはしない。
        if _state == 1 and (na(_distortBar) or (_tfBar - _distortBar) > retLookback)
            _state         := 0
            _distKind      := 0
            _distKindStart := 0
            _expired       := true
        if _rel != 0
            // --- Distortion 継続中 : 主導判定 / 復帰 ---
            //   期限切れは上で処理済みなので、ここへ来た時点で必ず retLookback 以内。
            if _state == 1
                // 主導判定 : 片側だけが「直前の方向 + その方向の構造」を維持していればその側が主導。
                bool _goldHold = _preGoldDir == 1 ? (_gResp == 1 and gStructUp) : _preGoldDir == -1 ? (_gResp == -1 and gStructDn) : false
                bool _mktHold  = _preMktDir  == 1 ? (_mDir  == 1 and mStructUp) : _preMktDir  == -1 ? (_mDir  == -1 and mStructDn) : false
                if _goldHold and not _mktHold
                    _leader := 1
                else if _mktHold and not _goldHold
                    _leader := -1
                else
                    _leader := 0
                if _rel == 1
                    // 正常な関係へ復帰 → Return (この確定TF足1本だけ)
                    //   Return は主市場が最低変化率以上動いた足 (_rel != 0) でのみ成立する。
                    _retDir     := _gResp
                    _retType    := _retDir == _preGoldDir ? 1 : 2
                    _returnDir  := _retDir
                    _returnType := _retType
                    _retKind    := _distKindStart
                    _returnBar  := true
                    _expired    := false
                    _state      := 0
                    _distKind   := 0
                    _distKindStart := 0
                else
                    // Distortion 継続 (Neutral ⇔ Opposite の種別だけ更新)
                    _distKind := _rel == 2 ? 1 : 2
            // --- Normal → Distortion 開始判定 ---
            //   直前が Normal で、当該足の関係が Normal でなくなったら Distortion。
            //   Gold Neutral (耐え) も Gold逆行も 同方向 もすべて Distortion に含む。
            if _state == 0 and not _returnBar and _rel != 1 and _prevRelNormal and (not imDistortionRequireCorr or _prevCorrOk)
                _state           := 1
                _distKind        := _rel == 2 ? 1 : 2
                _distKindStart   := _rel == 2 ? 1 : 2
                _expired         := false
                _distortBar      := _tfBar
                _preGoldDir      := _prevGoldDir
                _preMktDir       := _prevMktDir
                _preGoldChg      := _prevGoldChg
                _preMktChg       := _prevMktChg
                _preGoldStructUp := _prevGoldStructUp
                _preGoldStructDn := _prevGoldStructDn
                _preMktStructUp  := _prevMktStructUp
                _preMktStructDn  := _prevMktStructDn
                bool _goldHeld = _prevGoldDir == 1 ? (_gResp == 1 and gStructUp) : _prevGoldDir == -1 ? (_gResp == -1 and gStructDn) : false
                bool _mktHeld  = _prevMktDir  == 1 ? (_mDir  == 1 and mStructUp) : _prevMktDir  == -1 ? (_mDir  == -1 and mStructDn) : false
                _preGoldLed := _goldHeld and not _mktHeld
                _preMktLed  := _mktHeld  and not _goldHeld
                if _goldHeld and not _mktHeld
                    _leader := 1
                else if _mktHeld and not _goldHeld
                    _leader := -1
                else
                    _leader := 0
                _returnType := 0
                _returnDir  := 0
            // --- スナップショット更新 (分類できた足だけ) ---
            _prevGoldDir      := _gResp
            _prevMktDir       := _mDir
            _prevGoldChg      := gChg
            _prevMktChg       := mChg
            _prevRelNormal    := _rel == 1
            _prevCorrOk       := _corrOkNow
            _prevGoldStructUp := gStructUp
            _prevGoldStructDn := gStructDn
            _prevMktStructUp  := mStructUp
            _prevMktStructDn  := mStructDn
        // --- イベント統合 (Direction と Return は完全独立) ---
        //   useDir = false のとき Direction は一切イベントを出さない。
        //   Return は useRet のみで制御し、Distortion → 復帰を経由した足だけ発火する。
        int _dirEvent = 0
        if useDir
            _dirEvent := mChg <= -dirMinChg ? 1 : mChg >= dirMinChg ? -1 : 0
        bool _corrOK   = not useCorr or _corrOkNow
        // Return イベントは 2軸で独立に選別する (検出ロジック自体は変更しない・出力フィルタのみ)。
        //   軸1 : 起点になった Distortion の種類 _retKind
        //         1 = Neutral 由来 → useRetNeutral / 2 = SameDirection 由来 → useRetSame
        //   軸2 : Return の種類 _retType (既存の Original / Opposite 判定をそのまま利用)
        //         1 = Original → useRetOriginal / 2 = Opposite → useRetOpposite
        //   どちらかの軸で該当スイッチが OFF ならイベントを出さない (両方 OFF でも同様)。
        //   状態遷移・Expired・NoTrade解除・内部状態のリセット・表示は選別に関係なくそのまま動作する。
        bool _retKindOk = _retKind == 1 ? useRetNeutral   : _retKind == 2 ? useRetSame     : false
        bool _retTypeOk = _retType == 1 ? useRetOriginal  : _retType == 2 ? useRetOpposite : false
        int  _retEvent = (useRet and _returnBar and _retKindOk and _retTypeOk) ? _retDir : 0
        int  _event    = _retEvent != 0 ? _retEvent : (useDir and _corrOK ? _dirEvent : 0)
        // Return は必ず Hold を張り直す (Distortion→Return サイクルごとに1回)。
        // Direction は従来どおり「生条件の立ち上がり」でのみ発火 (同方向継続では再発火しない)。
        if _retEvent != 0
            _reason := _retEvent
            _evBar  := _tfBar
        else if _event == 1 and _prevRawEvent != 1
            _reason := 1
            _evBar  := _tfBar
        else if _event == -1 and _prevRawEvent != -1
            _reason := -1
            _evBar  := _tfBar
        _prevRawEvent := _event
        // Distortion中は NoTrade。Return が成立した復帰足では解除される (_state が 0 に戻るため)。
        _noTrade := useDistNT and _state == 1
    bool  _act       = _reason != 0 and not na(_evBar) and (_tfBar - _evBar) < holdBars
    float _out       = _act ? (_reason == 1 ? eventPoint : -eventPoint) : 0.0
    int   _outR      = _act ? _reason : 0
    int   _stateCode = _returnBar ? 3 : _state == 1 ? (_distKind == 1 ? 1 : 2) : _expired ? 4 : 0
    [_out, _outR, active and _noTrade, _stateCode, _preGoldDir, _returnType, _returnDir, _leader, _mDirOut, _gRespOut, _preMktDir]

// --- 有効判定 (DXY OFF で完全素通し) ---
bool imActive = useDxyEnv

// --- 15M (移植元の 15M ブロックから Silver / Yield / Oil を除いたもの) ---
float gChg15M = 0.0
float gClose15M = na
float xChg15M = 0.0
float xClose15M = na
bool gStructUp15M = false
bool gStructDn15M = false
bool xStructUp15M = false
bool xStructDn15M = false
if imActive and useIntermarket15M
    [_gc, _gr, _gp, _gsu, _gsd] = request.security(goldSymbol, IM_TF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
    gChg15M := _gc
    gClose15M := _gp
    gStructUp15M := _gsu
    gStructDn15M := _gsd
    if useDxyEnv
        [_xc, _xr, _xp, _xsu, _xsd] = request.security(dxySymbol, IM_TF, f_imDataConfirmed(imChangeLookback, imRecentLookback, imStructureLookback), lookahead = barmerge.lookahead_on)
        xChg15M := _xc
        xClose15M := _xp
        xStructUp15M := _xsu
        xStructDn15M := _xsd
bool newBar15M = ta.change(time(IM_TF)) != 0
var array<float> gxBuf15M = array.new_float()
var array<float> xBuf15M  = array.new_float()
f_corrPush2(gxBuf15M, xBuf15M, imActive and useIntermarket15M and newBar15M and useDxyEnv,   gClose15M, xClose15M, imCorrLen)
float corrX15M = (imActive and useIntermarket15M and useDxyEnv)   ? f_corrCalc(gxBuf15M, xBuf15M, imCorrLen) : na
[xScore15M, xReason15M, xNT15M, xState15M, xPreDir15M, xRetType15M, xRetDir15M, xLeader15M, xMDir15M, xGResp15M, xPreMkt15M] = f_macroState(imActive and useDxyEnv and useIntermarket15M, newBar15M, imHold15M, gChg15M, xChg15M, corrX15M, gStructUp15M, gStructDn15M, xStructUp15M, xStructDn15M, true, useDxyDirection, useDxyInverseCorrelation, useDxyDistortionNoTrade, useDxyReturn, useDxyReturnNeutral, useDxyReturnSameDirection, useDxyReturnOriginal, useDxyReturnOpposite, imCorrThreshold, dxyMinChange, imReturnLookback, dxyEventPoint, dxyDistortionMinChange)
float xW15M = (useDxyEnv and useIntermarket15M)    ? xScore15M * imWeight15M : 0.0

// --- 市場別 加重合計 (DXYのみ) ---
float dxyTotalScore    = useDxyEnv    ? dxyWeight    * xW15M : 0.0
float intermarketTotalScore = dxyTotalScore

// --- 市場別 NoTrade ---
bool dxyNoTrade    = useDxyEnv    and xNT15M

// --- 市場別 バイアス (AND/OR 用。市場合計を閾値判定) ---
int dxyBias    = not useDxyEnv    ? 0 : dxyTotalScore    >= intermarketScoreThreshold ? 1 : dxyTotalScore    <= -intermarketScoreThreshold ? -1 : 0

// --- 市場結合 (WeightedScore / AND / OR)。DXY単体なので3モードとも同値になる ---
bool _wsLong  = intermarketTotalScore >= intermarketScoreThreshold
bool _wsShort = intermarketTotalScore <= -intermarketScoreThreshold
bool _andLong  = imActive and (not useDxyEnv or dxyBias == 1)
bool _andShort = imActive and (not useDxyEnv or dxyBias == -1)
bool _orLong  = useDxyEnv and dxyBias == 1
bool _orShort = useDxyEnv and dxyBias == -1
bool orConflict = intermarketMode == "OR" and _orLong and _orShort

bool imBiasLong  = intermarketMode == "WeightedScore" ? _wsLong  : intermarketMode == "AND" ? _andLong  : (_orLong  and not _orShort)
bool imBiasShort = intermarketMode == "WeightedScore" ? _wsShort : intermarketMode == "AND" ? _andShort : (_orShort and not _orLong)

// --- Intermarket NoTrade ---
bool _anyNT = useDxyEnv and dxyNoTrade
bool _allNT = imActive and (not useDxyEnv or dxyNoTrade)
bool intermarketNoTrade = imActive and ((intermarketNoTradeMode == "ALL" ? _allNT : _anyNT) or orConflict)

int intermarketFinalBias = imBiasLong and not imBiasShort ? 1 : imBiasShort and not imBiasLong ? -1 : 0

// ============================================================
//  8h. 環境認識の結合 (モジュール別 ON/OFF 通過方式)
// ------------------------------------------------------------
//  トレンド環境認識(EMAスコア)は本ファイルでは未実装のため常に通過扱い。
//  移植元の既定 useTrendEnv = false と同じ挙動 (allowByEnv = true 固定)。
// ============================================================
bool trendLongOk = true
bool imLongOk = not imActive or (imBiasLong and not intermarketNoTrade)
bool allEnvLongOk =
     trendLongOk and
     imLongOk

bool trendShortOk = true
bool imShortOk = not imActive or (imBiasShort and not intermarketNoTrade)
bool allEnvShortOk =
     trendShortOk and
     imShortOk


// ============================================================================
// 05. 移植元 SL / TP / ロット / 日足レジーム / 時間帯 / Accumulation
// ============================================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)
//  9b. 日足レジームフィルター
// ============================================================
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    bool highVol140to170 = drRange >= highVolLevel1 and drRange < highVolLevel2
    bool highVol170to200 = drRange >= highVolLevel2 and drRange < extremeVolLevel
    bool highVol200Plus  = drRange >= extremeVolLevel
    bool allowHighVol =
         (useHighVol140to170 and highVol140to170) or
         (useHighVol170to200 and highVol170to200) or
         (useHighVol200Plus  and highVol200Plus)
    bool drIsHighVol   = not na(drVolCodeAdj) and drVolCodeAdj == 1
    bool highVolBandOk = not drIsHighVol or allowHighVol
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock and highVolBandOk)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

//  10. 時間帯 / 指標時間フィルタ
// ============================================================
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

//  10b. Accumulation NoTrade フィルター
// ============================================================
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

// 15分足コンテキストで箱を構築 (var で 15分足の生存期間だけ上下限を拡張)。
//   返り値: [isAccum, boxHigh, boxLow, boxStartBar]  boxStartBar = 箱識別子。
f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

// 確定済み1本前の15分足 box を「15分足コンテキスト内」で参照して返す。
//   [1] を関数内 (= 15分足コンテキスト) で適用し、lookahead_on と組み合わせることで、
//   ヒストリカル/リアルタイムとも「直前に確定した15分足」の box を一貫して取得する
//   (未来参照なし・非リペイント)。チャート側では [1] を一切使わない。
f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

// --- 保持配列 (5分足 / 15分足 完全分離) ---
var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
// --- 5分足 箱トラッキング状態 (var) ---
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
// --- 15分足 重複登録防止 (直近登録済み箱の識別子) ---
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

// --- 5分足 (チャート足で直接検出。ヒゲでなく実体基準の上下限) ---
if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        // 新規Accum確定 → 配列へ追加。4つ目 (accumNTKeep超) で最古を削除。
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        // 形成中は最新箱の上下限を拡張 (配列の末尾=最新も更新)
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    // 内部判定 : 直近保持のどれか1つでも close が上限〜下限 (端一致含む) にあれば内部
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

// --- 15分足 (完全に15分足確定ベース。5分足で重複登録しない) ---
//   確定参照は 15分足コンテキスト内で [1] を適用する f_accumNT15Confirmed + lookahead_on。
//   → 返る box は常に「直前に確定した15分足」の最終値 (ヒストリカル/リアルタイム一致)。
//   登録/更新は ta.change(time(15分足)) で「新しい15分足が始まった最初の5分足」だけ。
//   ※ チャート側では [1] を一切使わない。形成途中の15分足値は配列に入らない。
if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, ACCUM_TF, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(ACCUM_TF)) != 0
    if new15Bar
        // 直前に確定した15分足の box をこの1本だけで処理 (3本に1回)
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            // 新しい15分Accum箱 → 登録 (箱識別子が変わった時のみ = 重複登録なし)
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            // 同一箱が拡張 (確定15分足で更新) → 最新エントリーの上下限を更新
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    // 内部判定は毎5分足で実施 (保持中の確定箱に対して現在の終値を判定)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

// --- 最終ブロック判定 (ロング・ショート共通) ---
bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

// --- Accum 離脱後の待機確認 (Liquidity Sweep / Fake Break ダマシ回避) ---
//   Accum外へ出た最初の足では許可せず、accumExitConfirmBars 本連続で外部維持後に許可。
//   離脱足は計数に含めず、その次の足から連続外部本数を数える。
//   確認中にAccum内へ戻ったらカウント完全リセット。最初から外部なら待機なし (従来どおり即許可)。
//   ※ WinZone/Momentum/Trigger/各状態管理・有効期限・リセットには一切干渉しない。
var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        // Accum内 (または戻った) → 待機・カウント完全リセット
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        // 離脱足 → 待機開始 (この足は計数に含めない)
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        // 離脱の次足以降、外部維持で計数
        accumOutsideConfirmCount += 1
    // 確認完了 → 待機解除 (この確定バーで許可)
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

// 確認完了前だけ新規エントリー禁止 (blockedByAccum とは別条件)
bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

// --- Accum 離脱方向フィルター (上抜け→ロングのみ / 下抜け→ショートのみ) ---
//   Accum内NoTrade・離脱待機確認は不変。離脱後のみ、抜けた方向にエントリーを限定する。
//   方向判定は「直前バーで実際に内部にいた保持箱」ごとに close 基準 (ヒゲ無視) で行う。
//   ・最初から外部 (一度もAccumを通過していない) → 方向制限なし (accumBreakDirectionActive=false)。
//   ・Accum内へ戻る / 有効期限切れ / 方向不明 → 状態リセット。
var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        // Accum内へ戻った → 方向状態リセット (Accum内なので両方向禁止のまま)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        // 離脱足 : 直前バーで内部にいた箱ごとに close 基準で上抜け/下抜けを判定
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            // 上抜け/下抜け同時成立 or どちらも不成立 → 方向不明 (両方禁止しない=非アクティブ)
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    // 有効期限切れ → リセット
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

// 方向別許可 (非アクティブ時=最初から外部/方向不明/期限切れ は従来どおり両方向許可)
bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

//  10c. 最終エントリー条件 (環境認識 = トレンド + Intermarket)
// ------------------------------------------------------------
//  WinZone / Momentum / Intermarket は本ストラテジーでは不使用。
//  環境認識は allEnvLongOk/allEnvShortOk (ON中の全環境モジュールのAND) に一本化。
//  FVG環境認識 / EMA環境認識(50/200/1000) は削除済み。
//  Accumulation NoTrade はそのまま維持。
// ============================================================
// --- 主要条件 (再アーム判定の対象) ---
//   最終条件からトリガーと機械的条件 (barstate/リスク/数量/ポジション/ピラミッディング) を
//   除いたもの。これらの一時変化では再アームしない。環境認識(トレンド+Intermarket)は主要条件に含める。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     allEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     allEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

// --- 基本エントリー条件 (トリガーを除く最終条件・5分足確定時) ---
bool baseLongCondition =
     barstate.isconfirmed and
     useLong and
     longMajorOk and
     longRisk > 0 and
     longQty >= 1
bool baseShortCondition =
     barstate.isconfirmed and
     useShort and
     shortMajorOk and
     shortRisk > 0 and
     shortQty >= 1

bool noTriggerMode = enabledTrigCount == 0

// --- トリガーOFF時: 主要条件の「立ち上がり」で1回だけ (ロング/ショート個別のアーム状態) ---
//   ・主要条件が一度でも不成立 → 再アーム (次の成立で再びエントリー可能)。
//   ・実際に発注したときだけ解除 (発注部 11 で longArmed/shortArmed := false)。
//   → 条件継続中は決済後も再エントリーせず、条件が崩れて再成立したら新たに1回。
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

// --- トリガーON時: 1分足トリガー + 5分足クールダウン ---
bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

// --- 最終エントリー可否 (モードで分岐) ---
bool canLong  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool canShort = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// ============================================================
//  11. 発注 (SL・TPモードで排他分岐)
// ------------------------------------------------------------
//  ★ Candidate (canLong / canShort) の算出はここより前で完了しており、
//    tradePlanMode を一切参照していない → 両モードで Candidate は同一。
//  ★ ここから下だけがモード分岐。同じ Candidate から両方の注文は出ない
//    (if / else の排他分岐で、片方のブランチしか実行されない)。
//  ★ ORIGINAL ブランチは移植元 11. と同じ処理・同じ順序・同じ変数。
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

var int pyrSeq = 0

// --- 建値移動 / 表示用の控え (Entry ID 単位) ---
var map<string, float> gTradeTP = map.new<string, float>()
var map<string, float> gTradeEP = map.new<string, float>()
var map<string, bool>  gTradeBE = map.new<string, bool>()

// --- Zone Reject 理由コード ---
//   1 NO_SL_ZONE / 2 NO_TP_ZONE / 3 INVALID_SL / 4 INVALID_TP / 5 SL_TOO_FAR /
//   6 LOW_RR / 7 NO_QTY / 8 POSITION_LIMIT / 9 OPPOSITE_POSITION /
//   10 INSIDE_ACTIVE_ZONE / 0 = 除外なし
f_zoneRejectName(int c) =>
    c == 1 ? "NO_SL_ZONE" : c == 2 ? "NO_TP_ZONE" : c == 3 ? "INVALID_SL" :
     c == 4 ? "INVALID_TP" : c == 5 ? "SL_TOO_FAR" : c == 6 ? "LOW_RR" :
     c == 7 ? "NO_QTY" : c == 8 ? "POSITION_LIMIT" : c == 9 ? "OPPOSITE_POSITION" :
     c == 10 ? "INSIDE_ACTIVE_ZONE" : "-"

// ZoneEngine が返した FAIL 理由を Reject コードへ写す (判定の作り直しはしない)。
f_zoneReasonCode(string r) =>
    r == "NO_SL_ZONE" ? 1 :
     r == "INVALID_SL" ? 3 :
     r == "SL_TOO_FAR" ? 5 :
     r == "TP_WRONG_SIDE" ? 4 :
     r == "LOW_STRUCTURAL_RR" ? 6 :
     r == "INSIDE_ACTIVE_ZONE" ? 10 : 0

// --- ラベル / 確定アラート (実発注時のみ) ---
f_dxyNum(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)

f_dxyEntryReport(string eid, int dir, float ep, float sl, float tp, float rr, float qty, float beW, int candTime) =>
    string _body =
     "\nLogic: DXY" +
     "\nMode: " + tradePlanMode +
     "\n" + (dir > 0 ? "LONG" : "SHORT") +
     "\n" + syminfo.ticker +
     "\nEntry: " + f_dxyNum(ep, "#.##") +
     "\nSL: "    + f_dxyNum(sl, "#.##") +
     "\nTP: "    + f_dxyNum(tp, "#.##") +
     "\nSL距離: " + f_dxyNum(math.abs(ep - sl), "#.##") +
     "\nRR: "    + f_dxyNum(rr, "#.##") +
     "\nQty: "   + f_dxyNum(qty, "#.####") +
     "\nBE: $"   + (useBreakEven ? f_dxyNum(beW, "#.##") : "OFF") +
     "\nID: "    + eid +
     "\nCandidate: " + str.format_time(candTime, "yyyy-MM-dd HH:mm", "Asia/Tokyo") +
     "\nOrder: "     + str.format_time(time,     "yyyy-MM-dd HH:mm", "Asia/Tokyo")
    if useEntryAlert
        alert("【確定 " + (dir > 0 ? "LONG" : "SHORT") + "】" + _body, alert.freq_once_per_bar)
    if showDxyLabel
        label.new(bar_index, dir > 0 ? low : high, text = _body,
             style = dir > 0 ? label.style_label_up : label.style_label_down,
             color = dir > 0 ? color.new(color.teal, 15) : color.new(color.maroon, 15),
             textcolor = color.white, size = size.small)
    true

// --- 実発注カウンタ / Zone Plan カウンタ (Debug 3段階) ---
var int dbgEntryL   = 0
var int dbgEntryS   = 0
var int dbgPlanOkL  = 0
var int dbgPlanOkS  = 0
var int dbgRejTotal = 0
var array<int> dbgRej = array.new_int(11, 0)
var string dbgLastRej = ""
bool zonePlanValidLong  = false
bool zonePlanValidShort = false

if tradePlanMode == "ORIGINAL"
    // ---- 移植元と同じ注文 (処理順・判定式・変数すべて移植元 11. のまま) ----
    if okAddLong and wantLong
        pyrSeq += 1
        string _idL = "L" + str.tostring(pyrSeq)
        strategy.entry(_idL, strategy.long, qty = longQty)
        strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
        if noTriggerMode
            longArmed := false
        dbgEntryL += 1
        gTradeTP.put(_idL, longTP)
        gTradeEP.put(_idL, entryEst)
        gTradeBE.put(_idL, false)
        f_dxyEntryReport(_idL, 1, entryEst, longStop, longTP, rrRatio, longQty, originalBreakEvenTrigger, time)

    if okAddShort and wantShort
        pyrSeq += 1
        string _idS = "S" + str.tostring(pyrSeq)
        strategy.entry(_idS, strategy.short, qty = shortQty)
        strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
        if noTriggerMode
            shortArmed := false
        dbgEntryS += 1
        gTradeTP.put(_idS, shortTP)
        gTradeEP.put(_idS, entryEst)
        gTradeBE.put(_idS, false)
        f_dxyEntryReport(_idS, -1, entryEst, shortStop, shortTP, rrRatio, shortQty, originalBreakEvenTrigger, time)
else
    // ---- Zone Plan による注文 ----
    //  ★ Candidate 成立バーで Zone Plan が組めるときだけ発注する。
    //    Zone が後から出るのを待って遅れてエントリーする処理は持たない。
    //    Plan 無効で発注しなかった Candidate は別バーで自動再試行しない
    //    (保留キューを一切持たない = そのバー限りで破棄)。
    //    さらに noTriggerMode (全トリガーOFF) では、Candidate を評価した時点で
    //    該当方向の armed を解除する。Zone Plan の可否・除外理由に関係なく
    //    消費するので、主要条件が継続していても同じ Candidate が次の足で
    //    再発生しない。トリガーが1つ以上ONの通常モードでは armed に触れない。
    //  ★ ORIGINAL の固定SL / 固定RR は実注文の SL / TP に一切使わない。
    if wantLong or wantShort
        int   _dir  = wantLong ? 1 : -1
        float _ep   = close
        // ★ Candidate を評価した時点で該当方向を消費する (noTriggerMode のときだけ)。
        //   Zone Plan 有効・発注成立 / NO_SL_ZONE / NO_TP_ZONE / INVALID_SL /
        //   INVALID_TP / SL_TOO_FAR / LOW_RR / NO_QTY / POSITION_LIMIT /
        //   OPPOSITE_POSITION / INSIDE_ACTIVE_ZONE のいずれでも必ず解除する。
        if noTriggerMode
            if _dir > 0
                longArmed := false
            else
                shortArmed := false
        zn.TradePlan _p = zn.buildPlan(zoneEng, zoneCfg, _dir, _ep)
        int   _rej  = 0
        // ① ZoneEngine の FAIL をそのまま Reject 理由にする
        if not _p.valid
            _rej := f_zoneReasonCode(_p.reason)
        // ② TP採用モード (Structural / Fallback の切り分け)
        if _rej == 0 and _p.valid
            if zoneTpMode == "STRUCTURAL_ONLY" and _p.tpType == "FALLBACK_RR"
                _rej := 2
            else if zoneTpMode == "FALLBACK_ONLY" and _p.tpType == "STRUCTURAL"
                _rej := 2
        // ③ SL / TP がEntry方向に対して正しいか
        if _rej == 0
            bool _slOk = _dir > 0 ? (not na(_p.sl) and _p.sl < _ep) : (not na(_p.sl) and _p.sl > _ep)
            bool _tpOk = _dir > 0 ? (not na(_p.tp) and _p.tp > _ep) : (not na(_p.tp) and _p.tp < _ep)
            if not _slOk
                _rej := 3
            else if not _tpOk
                _rej := 4
        // ④ Qty は Structural SL距離から計算する (ORIGINALの固定SL距離は使わない)
        float _qty = 0.0
        if _rej == 0
            _qty := f_qty(_p.risk)
            if _qty < zoneQtyMin or _qty <= 0
                _rej := 7
        // ⑤ 保有制御 (Zone Plan の可否とは別段で判定して理由を分ける)
        if _rej == 0
            bool _opp = (_dir > 0 and posShort) or (_dir < 0 and posLong)
            if _opp
                _rej := 9
            else if not underPyrLimit
                _rej := 8
        // Zone Plan 有効 (Stage 2) の集計は ⑤ の保有制御より前の段階で数える
        bool _planOk = _rej == 0 or _rej == 8 or _rej == 9
        if _planOk
            if _dir > 0
                zonePlanValidLong := true
                dbgPlanOkL += 1
            else
                zonePlanValidShort := true
                dbgPlanOkS += 1
        if _rej != 0
            dbgRejTotal += 1
            array.set(dbgRej, _rej, array.get(dbgRej, _rej) + 1)
            dbgLastRej := str.format_time(time, "MM-dd HH:mm", "Asia/Tokyo") + " " +
                 (_dir > 0 ? "L " : "S ") + f_zoneRejectName(_rej)
        else
            pyrSeq += 1
            string _idZ = (_dir > 0 ? "L" : "S") + str.tostring(pyrSeq)
            strategy.entry(_idZ, _dir > 0 ? strategy.long : strategy.short, qty = _qty)
            strategy.exit(_idZ + "X", from_entry = _idZ, stop = _p.sl, limit = _p.tp)
            if _dir > 0
                dbgEntryL += 1
            else
                dbgEntryS += 1
            gTradeTP.put(_idZ, _p.tp)
            gTradeEP.put(_idZ, _ep)
            gTradeBE.put(_idZ, false)
            f_dxyEntryReport(_idZ, _dir, _ep, _p.sl, _p.tp, _p.rr, _qty, zoneBreakEvenTrigger, time)


// ============================================================
//  12. 建値移動 (Entry ID 単位・モード別の幅)
// ------------------------------------------------------------
//  ★ 幅は現在のモードのものだけを使う。モード切替時に他方の幅は参照しない。
//  ★ 状態は Entry ID 単位。決済済みIDは即座に削除するので他トレードへ引き継がない。
//  ★ 既定 OFF。ORIGINAL回帰テストは必ず OFF で行うこと (移植元に建値移動は無い)。
// ============================================================
var int gLastClosed = 0
if strategy.closedtrades > gLastClosed
    for i = gLastClosed to strategy.closedtrades - 1
        string _cid = strategy.closedtrades.entry_id(i)
        if gTradeTP.contains(_cid)
            gTradeTP.remove(_cid)
        if gTradeEP.contains(_cid)
            gTradeEP.remove(_cid)
        if gTradeBE.contains(_cid)
            gTradeBE.remove(_cid)
    gLastClosed := strategy.closedtrades

float beTriggerNow = tradePlanMode == "ORIGINAL" ? originalBreakEvenTrigger : zoneBreakEvenTrigger
if useBreakEven and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string _eid = strategy.opentrades.entry_id(i)
        if gTradeEP.contains(_eid) and gTradeTP.contains(_eid)
            float _bep   = gTradeEP.get(_eid)
            float _btp   = gTradeTP.get(_eid)
            bool  _bLong = strategy.opentrades.size(i) > 0
            bool  _wasOn = gTradeBE.contains(_eid) ? gTradeBE.get(_eid) : false
            bool  _reach = false
            if _bLong
                _reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close >= _bep + beTriggerNow) : (high >= _bep + beTriggerNow)
            else
                _reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close <= _bep - beTriggerNow) : (low <= _bep - beTriggerNow)
            if _wasOn or _reach
                gTradeBE.put(_eid, true)
                strategy.exit(_eid + "X", from_entry = _eid, stop = _bep, limit = _btp)

// ============================================================
//  13. 3段階 Debug (Candidate / Zone Plan / 実Entry)
// ------------------------------------------------------------
//  Stage 1 : DXY Candidate       … 移植元の canLong / canShort 相当
//  Stage 2 : Zone Plan 有効      … Structural SL・TP・RR・Qty を通過した数
//  Stage 3 : 実Entry             … strategy.entry() を実行した数
//  ★ Stage 2 は ZONE モードでは実発注判定の一部、ORIGINAL モードでは参考表示のみ。
//    ORIGINAL の発注可否には一切使わない (下の参考計算はモード分岐の後ろにある)。
// ============================================================
// Stage 2 参考値 (ORIGINAL モードで Debug ON のときだけ評価する)
if tradePlanMode == "ORIGINAL" and showDxyDebug and (wantLong or wantShort)
    int _rdir = wantLong ? 1 : -1
    zn.TradePlan _rp = zn.buildPlan(zoneEng, zoneCfg, _rdir, close)
    if _rp.valid
        if _rdir > 0
            zonePlanValidLong := true
            dbgPlanOkL += 1
        else
            zonePlanValidShort := true
            dbgPlanOkS += 1

var int dbgCandL = 0
var int dbgCandS = 0
var string dbgLastCand = ""
if canLong
    dbgCandL += 1
if canShort
    dbgCandS += 1
if showDxyDebug and (canLong or canShort)
    dbgLastCand := str.format_time(time, "MM-dd HH:mm", "Asia/Tokyo") + (canLong ? " L" : " S")

//  --- 全期間の突合用 (チャートデータのエクスポートで CSV 化できる) ---
plot(canLong  ? 1 : 0, "DXY Candidate Long",      display = display.data_window)
plot(canShort ? 1 : 0, "DXY Candidate Short",     display = display.data_window)
plot(dbgCandL,         "DXY Candidate Long Cum",  display = display.data_window)
plot(dbgCandS,         "DXY Candidate Short Cum", display = display.data_window)
plot(zonePlanValidLong  ? 1 : 0, "Zone Plan Valid Long",  display = display.data_window)
plot(zonePlanValidShort ? 1 : 0, "Zone Plan Valid Short", display = display.data_window)
plot(dbgPlanOkL + dbgPlanOkS,    "Zone Plan Valid Cum",   display = display.data_window)
plot(dbgEntryL,   "Actual Entry Long Cum",  display = display.data_window)
plot(dbgEntryS,   "Actual Entry Short Cum", display = display.data_window)
plot(dbgRejTotal, "Zone Reject Cum",        display = display.data_window)

var table dxyTbl = na
if showDxyDebug
    if na(dxyTbl)
        dxyTbl := table.new(position.bottom_right, 2, 17, border_width = 1)
    if barstate.islast
        table.cell(dxyTbl, 0, 0, "DXY / " + tradePlanMode, text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(dxyTbl, 1, 0, useDxyEnv ? "ON" : "OFF", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(dxyTbl, 0, 1, "Bias / Score", text_size = size.tiny)
        table.cell(dxyTbl, 1, 1, str.tostring(dxyBias) + " / " + f_dxyNum(dxyTotalScore, "#.##"), text_size = size.tiny)
        table.cell(dxyTbl, 0, 2, "Dist state / NT", text_size = size.tiny)
        table.cell(dxyTbl, 1, 2, str.tostring(xState15M) + " / " + (intermarketNoTrade ? "Y" : "N"), text_size = size.tiny)
        table.cell(dxyTbl, 0, 3, "Return type / dir", text_size = size.tiny)
        table.cell(dxyTbl, 1, 3, str.tostring(xRetType15M) + " / " + str.tostring(xRetDir15M), text_size = size.tiny)
        table.cell(dxyTbl, 0, 4, "Zone count", text_size = size.tiny)
        table.cell(dxyTbl, 1, 4, str.tostring(zoneCountNow), text_size = size.tiny)
        table.cell(dxyTbl, 0, 5, "S1 Candidate L/S", text_size = size.tiny)
        table.cell(dxyTbl, 1, 5, str.tostring(dbgCandL) + " / " + str.tostring(dbgCandS), text_size = size.tiny)
        table.cell(dxyTbl, 0, 6, "S2 Zone Plan L/S", text_size = size.tiny)
        table.cell(dxyTbl, 1, 6, str.tostring(dbgPlanOkL) + " / " + str.tostring(dbgPlanOkS), text_size = size.tiny)
        table.cell(dxyTbl, 0, 7, "S3 Entry L/S", text_size = size.tiny)
        table.cell(dxyTbl, 1, 7, str.tostring(dbgEntryL) + " / " + str.tostring(dbgEntryS), text_size = size.tiny)
        table.cell(dxyTbl, 0, 8, "Zone Reject 合計", text_size = size.tiny)
        table.cell(dxyTbl, 1, 8, str.tostring(dbgRejTotal), text_size = size.tiny)
        table.cell(dxyTbl, 0, 9,  "NO_SL_ZONE / NO_TP_ZONE", text_size = size.tiny)
        table.cell(dxyTbl, 1, 9,  str.tostring(array.get(dbgRej, 1)) + " / " + str.tostring(array.get(dbgRej, 2)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 10, "INVALID_SL / INVALID_TP", text_size = size.tiny)
        table.cell(dxyTbl, 1, 10, str.tostring(array.get(dbgRej, 3)) + " / " + str.tostring(array.get(dbgRej, 4)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 11, "SL_TOO_FAR / LOW_RR", text_size = size.tiny)
        table.cell(dxyTbl, 1, 11, str.tostring(array.get(dbgRej, 5)) + " / " + str.tostring(array.get(dbgRej, 6)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 12, "NO_QTY", text_size = size.tiny)
        table.cell(dxyTbl, 1, 12, str.tostring(array.get(dbgRej, 7)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 13, "POSITION_LIMIT / OPPOSITE", text_size = size.tiny)
        table.cell(dxyTbl, 1, 13, str.tostring(array.get(dbgRej, 8)) + " / " + str.tostring(array.get(dbgRej, 9)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 14, "INSIDE_ACTIVE_ZONE", text_size = size.tiny)
        table.cell(dxyTbl, 1, 14, str.tostring(array.get(dbgRej, 10)), text_size = size.tiny)
        table.cell(dxyTbl, 0, 15, "直近 Candidate", text_size = size.tiny)
        table.cell(dxyTbl, 1, 15, dbgLastCand == "" ? "-" : dbgLastCand, text_size = size.tiny)
        table.cell(dxyTbl, 0, 16, "直近 Zone Reject", text_size = size.tiny)
        table.cell(dxyTbl, 1, 16, dbgLastRej == "" ? "-" : dbgLastRej, text_size = size.tiny)

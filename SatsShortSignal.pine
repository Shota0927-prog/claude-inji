// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © shota0927-prog
//
// ============================================================================
//  SATS Short/Long Signal (15S)  —  サッツバンド 売り・買いタイミング検知の単体インジ (SSS-3)
//  15秒チャート専用。15秒・30秒・1分の「開始時点の帯崩れ」が同じ方向で順に揃ったら SELL / BUY の合図を出す。
//  上位足の目線はこのインジの外で確認する。注文・SL / TP・アラートは無い (チャート上の検知表示のみ)。
//  計算の基準は「SAT BAND Reconstruction Test」。f_satBand() は一字一句そのまま (tests/sats_src/f_satBand.txt)。
//  既存の Zone / Strategy のファイルは編集していない。
//
//  ■ 開始時点の状態 (15秒 / 30秒 / 1分 共通。履歴とリアルタイムで同じ式)
//    新しい足 N から使う値は time と open だけ。それ以外は N が始まる前に確定していた直前足 P のデータだけを使う。
//    ・直前足の帯 bandState と LINE1 / LINE2 / STB の方向 = P の f_satBand() の確定値。
//    ・LINE1 / LINE2 の開始方向とアンカー = P の確定値 (close / high / low / ATR50 / アンカー / 方向) を
//      f_satBand() と同じ更新式 (f_nextAnchor) に入れた N のアンカー・方向。
//      開始時の線価格 = N のアンカー + P の common (= P の VWMA(hlc3, 5) × 0.5)。
//      【近似】本来 N の common は N の最初の更新の出来高・値を含む VWMA だが、それは履歴から復元できないため、
//      直前確定足の VWMA を使う。リアルタイムも同じ式に揃えている (リアルタイムでも N の値は open 以外使わない)。
//    ・STB の開始方向 = open を P までの直前 20本の高値・安値と比較 (high 側の突破を先に判定 = 既存と同じ優先順。
//      どちらも突破していなければ P の方向を維持)。開始価格 = 方向 +1 なら min(open, 直前 9本の安値)、
//      -1 なら max(open, 直前 9本の高値) (= 開始時点の 10本の安値 / 高値)。
//    ・開始時の帯 = open と上の 3本の厳密比較: 3本すべてより上 +1 (青) / すべてより下 -1 (赤) / それ以外 0 (背景なし)。
//    3本の線が P と N の両方で揃っている (na でない) ときだけ判定する。
//
//  ■ 成立条件 (その時間足で 1 回。3本中 1本でよい。複数の線が該当しても 1 イベント)
//    SELL: P が青 (+1)、N の開始時が背景なし (0)、ある線が P で +1 → N 開始で -1 かつその同じ線の開始価格 > open
//    BUY : P が赤 (-1)、N の開始時が背景なし (0)、ある線が P で -1 → N 開始で +1 かつその同じ線の開始価格 < open
//    開始時点で決まり、足の途中で変わらない・取り消さない。
//
//  ■ 順序 (方向ごとに独立。15秒 → 30秒 → 1分)
//    t15 <= t30 <= t1m かつ t1m - t15 <= 待ち時間 (分・初期 5 分。ちょうど期限は有効。足数ではなく実時刻差)。
//    ・直近の有効な 15秒イベントを記録。30秒イベントの時点で有効な 15秒があれば 2 件を「組」にする。組の後の新しい 15秒では
//      組は変わらない。新しい 30秒イベントで有効な組ができた場合だけ組を更新する。
//    ・1分イベントで有効な組を使ったら合図を 1 回出し、その方向の待機をリセットする。期限切れの記録は失効させる。
//    ・同じ時刻は 15秒 → 30秒 → 1分 の順。SELL と BUY の記録は混ざらない。先行足の線が後で戻っても成立記録は有効。
//
//  ■ 取得
//    15秒はチャート自身。30秒・1分は request.security(同じ銘柄, "30S" / "1", lookahead_on) で、要求先の時間足の
//    [現在足の開始時刻・開始判定 (SELL / BUY の該当線)、直前足の開始時刻・開始判定] を受け取る。開始判定に使うのは
//    その足の time / open と直前確定足の値だけ (新しい足の高値・安値・終値・出来高は使わない)。
//
//  ■ 処理待ちの行 (SSS-3: 受信順ではなく足の開始時刻順)
//    ・15秒足ごとに 1 行 (キー = 15秒チャートの time)。15秒の開始判定はその足で 1 回だけ保存する。
//      同じ行に 30秒・1分の欄があり、time("30S") / time("1") が切り替わった 15秒足ではその欄に「取得すべき開始時刻」を
//      記録して「未着」にする。切り替わらなかった欄は「処理不要」。
//    ・欄の状態: 処理不要 / 未着 / 受信済み / 欠落。要求先の現在足・直前足のデータは、時間足と開始時刻が一致する「未着」欄に
//      だけ入れる (条件不成立のデータも成立結果ゼロで受信済み)。受信済み・欠落の欄は上書きしない (欠落後に届いても処理しない)。
//    ・毎更新: 行の追加 → 現在足・直前足の照合 → 欠落判定 → 古い行からの処理。先頭の行に未着があれば後続の行も保留する。
//      行の中は開始時刻順、同時刻は 15秒 → 30秒 → 1分。5分の期限と順序は各イベントの実際の開始時刻で判定する
//      (データが届いた時刻は成立判定に使わない)。
//    ・欠落の確定 (照合の後、未着欄ごと): 取得した直前足の開始時刻が待っている開始時刻を厳密に超えた、または
//      15秒チャートの time が待っている開始時刻から 3 分以上進んだ。欠落欄はイベントなしとして処理を再開し、
//      確認表に時間足・開始時刻・理由を出す。3 分は取得待ちの上限 (売買の成立期限は別で初期 5 分)。
//
//  ■ 表示
//    行・待機状態・印の予約は varip で持つ (リアルタイムの更新ごとのロールバックで戻らず、処理済みの行は再処理しない)。
//    合図は条件が揃った更新で出し、label.new(xloc.bar_time) で 1分足の実際の開始時刻に SELL / BUY を 1 回描く。
//    (リアルタイムの足の途中で描いたラベルは次の更新のロールバックで消えるため、予約した印はその足が確定するまで
//    毎更新描き直す。確定後はそのまま残る。) ツールチップには 1分足の開始時刻と、リアルタイムで検知した場合はその検知時刻
//    (timenow) を出す。履歴の再計算ではデータの遅れが無く、ライブ検知時刻は出さない。再読み込み後も印は 1分足の開始位置。
//    印はラベルなので、古いものから 500 個を超えた分は消える。30秒足 (秒足) が使える TradingView のプランが必要。
// ============================================================================
//@version=6
indicator("SATS Short/Long Signal (15S)", "SATS-SL", overlay = true, max_labels_count = 500)

// ---- 入力 ----------------------------------------------------------------------------------------------------------------
int   waitMin = input.int(5, "待ち時間 (分): 1分の開始 - 15秒の開始 の上限", minval = 1,
     tooltip = "t1m - t15 がこの時間以内なら成立 (ちょうど期限も有効)。実時刻差で判定する。")
bool  showSig = input.bool(true, "SELL / BUY のラベル (ツールチップに各時間足の成立時刻・該当線)")
bool  sigDet  = input.bool(false, "SELL / BUY のラベル本文にも各時間足の成立時刻・該当線を書く")
bool  showEvt = input.bool(false, "確認用: 各時間足の単独成立イベントを表示 (時間足・該当線・開始時刻)")
bool  showTbl = input.bool(true, "確認用: 待機状態の表を表示")
bool  showLost = input.bool(true, "確認用: 欠落した 30秒 / 1分データを表示")
color sellCol = input.color(color.new(color.red, 0), "SELL の色")
color buyCol  = input.color(color.new(color.teal, 0), "BUY の色")

// ---- SAT BAND (移植元の関数をそのまま) --------------------------------------------------------------------------------
f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]

// ---- 次の足の LINE アンカー・方向 (f_satBand() の LINE1 / LINE2 更新式と同じ。直前確定足の値だけで決まる) ---------------
//  atrV / srcV / trigLowV / trigHighV は、確定足 P 上で計算した ta.atr(50) / close*0.5 / low*0.5 / high*0.5
//  (= 次の足 N の f_satBand() が [1] で参照する値)。
f_nextAnchor(float prevAnchor, int prevDir, float k, float srcV, float trigLowV, float trigHighV, float atrV) =>
    float a = prevAnchor
    int   d = prevDir
    bool readyV = not na(atrV) and not na(srcV) and not na(trigLowV) and not na(trigHighV)
    if readyV
        if na(prevAnchor)
            a := srcV - k * atrV
            d := 1
        else if prevDir == 1
            if trigLowV < prevAnchor
                d := -1
                a := srcV + k * atrV
            else
                d := 1
                a := math.max(prevAnchor, srcV - k * atrV)
        else
            if trigHighV > prevAnchor
                d := 1
                a := srcV - k * atrV
            else
                d := -1
                a := math.min(prevAnchor, srcV + k * atrV)
    [a, d]

//  確定足 P 上で、次の足 N の開始判定に必要な値をまとめる。
f_satsPrep() =>
    [l1, l2, sb, d1, d2, sd, st, b, cm, at, a1, a2] = f_satBand()
    float atrN = ta.atr(50)
    [a1n, d1n] = f_nextAnchor(a1, d1, 5.0, close * 0.5, low * 0.5, high * 0.5, atrN)
    [a2n, d2n] = f_nextAnchor(a2, d2, 2.5, close * 0.5, low * 0.5, high * 0.5, atrN)
    bool okP = not na(l1) and not na(l2) and not na(sb)
    [okP, st, d1, d2, sd, cm + a1n, cm + a2n, d1n, d2n, ta.highest(high, 20), ta.lowest(low, 20), ta.highest(high, 9), ta.lowest(low, 9)]

//  新しい足の time / open と、直前確定足 ([1]) の値。チャート上でも request.security の中でも同じ関数を使う。
f_satsStart() =>
    [okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9] = f_satsPrep()
    [time, open, okP[1], st[1], d1[1], d2[1], sd[1], l1s[1], l2s[1], d1s[1], d2s[1], hh20[1], ll20[1], hh9[1], ll9[1]]

//  開始時点の判定。戻り値 [sellMask, buyMask, 開始帯, STB 開始方向, STB 開始価格]。mask: 1 = LINE1, 2 = LINE2, 4 = STB。
f_evt(float o, bool okP, int stP, int d1P, int d2P, int sdP, float l1s, float l2s, int d1s, int d2s,
      float hh20, float ll20, float hh9, float ll9) =>
    int sdS = sdP
    if not na(hh20) and not na(ll20) and not na(o)
        if o > hh20
            sdS := 1
        else if o < ll20
            sdS := -1
    float sbS = na(o) ? na : sdS == 1 ? math.min(o, ll9) : math.max(o, hh9)
    int stS = na
    int ms = 0
    int mb = 0
    if okP and not na(o) and not na(l1s) and not na(l2s) and not na(sbS)
        stS := o > l1s and o > l2s and o > sbS ? 1 : o < l1s and o < l2s and o < sbS ? -1 : 0
        if stS == 0 and stP == 1
            ms += d1P == 1 and d1s == -1 and l1s > o ? 1 : 0
            ms += d2P == 1 and d2s == -1 and l2s > o ? 2 : 0
            ms += sdP == 1 and sdS == -1 and sbS > o ? 4 : 0
        if stS == 0 and stP == -1
            mb += d1P == -1 and d1s == 1 and l1s < o ? 1 : 0
            mb += d2P == -1 and d2s == 1 and l2s < o ? 2 : 0
            mb += sdP == -1 and sdS == 1 and sbS < o ? 4 : 0
    [ms, mb, stS, sdS, sbS]

f_lines(int m) =>
    string s = ""
    if m % 2 == 1
        s += "L1"
    if int(m / 2) % 2 == 1
        s += (s == "" ? "" : "+") + "L2"
    if m >= 4
        s += (s == "" ? "" : "+") + "STB"
    s

f_hms(int t) =>
    na(t) ? "-" : str.format_time(t, "HH:mm:ss", syminfo.timezone)

// ---- 待機 (方向ごとに 1 つ。varip の int 配列: 0 w15T, 1 w15M, 2 p15T, 3 p15M, 4 p30T, 5 p30M) ----------------------------
f_newSeq() =>
    array<int> a = array.new_int(6, na)
    array.set(a, 1, 0)
    array.set(a, 3, 0)
    array.set(a, 5, 0)
    a

f_seqReset(array<int> s) =>
    array.set(s, 0, na)
    array.set(s, 1, 0)
    array.set(s, 2, na)
    array.set(s, 3, 0)
    array.set(s, 4, na)
    array.set(s, 5, 0)

//  期限切れの失効 (t = 処理中のイベントの開始時刻)
f_seqExpire(array<int> s, int t, int waitMs) =>
    int w15T = array.get(s, 0)
    int p15T = array.get(s, 2)
    if not na(w15T) and t - w15T > waitMs
        array.set(s, 0, na)
        array.set(s, 1, 0)
    if not na(p15T) and t - p15T > waitMs
        array.set(s, 2, na)
        array.set(s, 3, 0)
        array.set(s, 4, na)
        array.set(s, 5, 0)

f_on15(array<int> s, int t, int m, int waitMs) =>
    f_seqExpire(s, t, waitMs)
    if m > 0
        array.set(s, 0, t)
        array.set(s, 1, m)

//  30秒イベントの時点で有効な 15秒があれば組を作る / 更新する (無ければ組はそのまま)
f_on30(array<int> s, int t, int m, int waitMs) =>
    f_seqExpire(s, t, waitMs)
    int w15T = array.get(s, 0)
    if m > 0 and not na(w15T) and w15T <= t and t - w15T <= waitMs
        array.set(s, 2, w15T)
        array.set(s, 3, array.get(s, 1))
        array.set(s, 4, t)
        array.set(s, 5, m)

//  1分イベントで有効な組があれば合図のツールチップを返してリセット。無ければ ""。
//  liveT = リアルタイムで検知したときの timenow (履歴の再計算では na)。
f_on60(array<int> s, int t, int m, int waitMs, string dirName, int liveT) =>
    f_seqExpire(s, t, waitMs)
    int p15T = array.get(s, 2)
    int p30T = array.get(s, 4)
    string r = ""
    if m > 0 and not na(p15T) and p15T <= p30T and p30T <= t and t - p15T <= waitMs
        r := dirName + "\n15s " + f_lines(array.get(s, 3)) + " " + f_hms(p15T) + "\n30s " + f_lines(array.get(s, 5)) + " "
             + f_hms(p30T) + "\n1m " + f_lines(m) + " " + f_hms(t) + "\n1分足の開始 " + f_hms(t)
             + (na(liveT) ? "" : "\nライブ検知 " + f_hms(liveT) + (liveT - t >= 15000 ? " (遅れ " + str.tostring(math.floor((liveT - t) / 1000)) + "秒)" : ""))
        f_seqReset(s)
    r

// ---- 取得 (毎足・無条件) --------------------------------------------------------------------------------------------------
//  その時間足の [現在足 time, SELL mask, BUY mask, 直前足 time, SELL mask, BUY mask, 現在足の開始帯]
//  直前足の 3 つは、要求先の時間足の中で現在足の組全体を 1 本ずらした値。
f_satsEvt() =>
    [t, o, okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9] = f_satsStart()
    [ms, mb, stS, sdS, sbS] = f_evt(o, okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9)
    [t, ms, mb, t[1], ms[1], mb[1], stS]

[t15, ms15, mb15, t15p, ms15p, mb15p, ss15] = f_satsEvt()
[t30, ms30, mb30, t30p, ms30p, mb30p, ss30] = request.security(syminfo.tickerid, "30S", f_satsEvt(), lookahead = barmerge.lookahead_on)
[t60, ms60, mb60, t60p, ms60p, mb60p, ss60] = request.security(syminfo.tickerid, "1",   f_satsEvt(), lookahead = barmerge.lookahead_on)

bool chartOk = timeframe.in_seconds() == 15
int  need30T = time("30S")
int  need60T = time("1")
bool new30   = not na(need30T) and need30T != nz(need30T[1], -1)
bool new60   = not na(need60T) and need60T != nz(need60T[1], -1)

// ---- 処理待ちの行 (varip。1 行 = 1 本の 15秒足) -----------------------------------------------------------------------------
//  欄の状態
int C_NONE = 0   // 処理不要
int C_WAIT = 1   // 未着
int C_RCV  = 2   // 受信済み
int C_LOST = 3   // 欠落
varip array<int> rT   = array.new_int()    // 15秒足の time (行のキー)
varip array<int> rS15 = array.new_int()
varip array<int> rB15 = array.new_int()
varip array<int> rT30 = array.new_int()    // 取得すべき 30秒足の開始時刻
varip array<int> rC30 = array.new_int()    // 30秒欄の状態
varip array<int> rS30 = array.new_int()
varip array<int> rB30 = array.new_int()
varip array<int> rT60 = array.new_int()
varip array<int> rC60 = array.new_int()
varip array<int> rS60 = array.new_int()
varip array<int> rB60 = array.new_int()
varip int    lastRowT = na
varip array<int> sqS = f_newSeq()
varip array<int> sqB = f_newSeq()
varip int    lostN    = 0
varip string lostTxt  = ""
//  印の予約 (描いた足が確定するまで毎更新描き直す)
varip array<int>    mkBar = array.new_int()     // 予約した 15秒足の time
varip array<int>    mkX   = array.new_int()     // 描く位置 (xloc.bar_time)
varip array<int>    mkK   = array.new_int()     // 1 SELL / -1 BUY / 0 単独イベント / 2 欠落
varip array<string> mkTip = array.new_string()

f_mark(int x, int k, string tip) =>
    array.push(mkBar, time)
    array.push(mkX, x)
    array.push(mkK, k)
    array.push(mkTip, tip)

//  時間足 tf (30 / 60) の開始時刻 t のデータを、一致する未着欄にだけ入れる
f_recv(int tf, int t, int ms, int mb) =>
    if not na(t)
        array<int> tt = tf == 30 ? rT30 : rT60
        array<int> cc = tf == 30 ? rC30 : rC60
        array<int> ss = tf == 30 ? rS30 : rS60
        array<int> bb = tf == 30 ? rB30 : rB60
        int n = array.size(tt)
        for i = 0 to n - 1
            if i >= n
                break
            if array.get(cc, i) == C_WAIT and array.get(tt, i) == t
                array.set(cc, i, C_RCV)
                array.set(ss, i, nz(ms))
                array.set(bb, i, nz(mb))

//  未着欄の欠落判定 (現在足・直前足の照合の後)
f_lost(int tf, int prevT) =>
    array<int> tt = tf == 30 ? rT30 : rT60
    array<int> cc = tf == 30 ? rC30 : rC60
    int n = array.size(tt)
    int cnt = 0
    string txt = ""
    for i = 0 to n - 1
        if i >= n
            break
        if array.get(cc, i) == C_WAIT
            int w = array.get(tt, i)
            string why = not na(prevT) and prevT > w ? "直前足 " + f_hms(prevT) + " が先行" : time - w >= 180000 ? "3分経過" : ""
            if why != ""
                array.set(cc, i, C_LOST)
                cnt += 1
                txt := (tf == 30 ? "30s " : "1m ") + f_hms(w) + " " + why + " (判定 " + f_hms(time) + ")"
                f_mark(array.get(rT, i), 2, "欠落: " + (tf == 30 ? "30秒" : "1分") + " 開始 " + f_hms(w) + "\n理由: " + why
                     + "\n判定した 15秒足 " + f_hms(time) + "\nイベントなしとして処理を再開")
    [cnt, txt]

f_rowPop() =>
    array.shift(rT)
    array.shift(rS15)
    array.shift(rB15)
    array.shift(rT30)
    array.shift(rC30)
    array.shift(rS30)
    array.shift(rB30)
    array.shift(rT60)
    array.shift(rC60)
    array.shift(rS60)
    array.shift(rB60)

f_evtTip(string tfn, int t, int ms, int mb, int liveT) =>
    (ms > 0 ? "S " + tfn + " " + f_lines(ms) : "") + (ms > 0 and mb > 0 ? "\n" : "") + (mb > 0 ? "B " + tfn + " " + f_lines(mb) : "")
     + "\n開始 " + f_hms(t) + (na(liveT) ? "" : "\nライブ検知 " + f_hms(liveT))

int waitMs = waitMin * 60000

if chartOk
    int liveT = barstate.isrealtime ? timenow : na
    // 1. 行の追加 (15秒足の time ごとに 1 回だけ)
    if na(lastRowT) or time != lastRowT
        lastRowT := time
        array.push(rT, time)
        array.push(rS15, ms15)
        array.push(rB15, mb15)
        array.push(rT30, new30 ? need30T : na)
        array.push(rC30, new30 ? C_WAIT : C_NONE)
        array.push(rS30, 0)
        array.push(rB30, 0)
        array.push(rT60, new60 ? need60T : na)
        array.push(rC60, new60 ? C_WAIT : C_NONE)
        array.push(rS60, 0)
        array.push(rB60, 0)
    // 2. 現在足・直前足の照合 (一致する未着欄だけ。受信済み・欠落は上書きしない)
    f_recv(30, t30,  ms30,  mb30)
    f_recv(30, t30p, ms30p, mb30p)
    f_recv(60, t60,  ms60,  mb60)
    f_recv(60, t60p, ms60p, mb60p)
    // 3. 欠落判定
    [n30, x30] = f_lost(30, t30p)
    [n60, x60] = f_lost(60, t60p)
    if n30 + n60 > 0
        lostN   += n30 + n60
        lostTxt := x60 != "" ? x60 : x30
    // 4. 古い行から処理 (先頭に未着があれば止める)。行の中は開始時刻順、同時刻は 15秒 → 30秒 → 1分
    while array.size(rT) > 0
        int c30 = array.get(rC30, 0)
        int c60 = array.get(rC60, 0)
        if c30 == C_WAIT or c60 == C_WAIT
            break
        int tr  = array.get(rT, 0)
        int a30 = array.get(rT30, 0)
        int a60 = array.get(rT60, 0)
        int s15 = array.get(rS15, 0)
        int b15 = array.get(rB15, 0)
        int s30 = c30 == C_RCV ? array.get(rS30, 0) : 0
        int b30 = c30 == C_RCV ? array.get(rB30, 0) : 0
        int s60 = c60 == C_RCV ? array.get(rS60, 0) : 0
        int b60 = c60 == C_RCV ? array.get(rB60, 0) : 0
        f_rowPop()
        // 区切りの 15秒足が欠けて 30秒 / 1分の開始時刻がこの行の 15秒より前なら、それを先に処理する
        bool e30 = c30 != C_NONE and a30 < tr
        bool e60 = c60 != C_NONE and a60 < tr
        for step = 0 to 4
            // step 0: 前の 30秒, 1: 前の 1分, 2: 15秒, 3: 同時刻の 30秒, 4: 同時刻の 1分
            bool do30 = c30 != C_NONE and ((step == 0 and e30) or (step == 3 and not e30))
            bool do60 = c60 != C_NONE and ((step == 1 and e60) or (step == 4 and not e60))
            if step == 2
                f_on15(sqS, tr, s15, waitMs)
                f_on15(sqB, tr, b15, waitMs)
                if showEvt and (s15 > 0 or b15 > 0)
                    f_mark(tr, 0, f_evtTip("15s", tr, s15, b15, liveT))
            if do30
                f_on30(sqS, a30, s30, waitMs)
                f_on30(sqB, a30, b30, waitMs)
                if showEvt and (s30 > 0 or b30 > 0)
                    f_mark(tr, 0, f_evtTip("30s", a30, s30, b30, liveT))
            if do60
                string sigS = f_on60(sqS, a60, s60, waitMs, "SELL", liveT)
                string sigB = f_on60(sqB, a60, b60, waitMs, "BUY", liveT)
                if sigS != ""
                    f_mark(a60, 1, sigS)
                if sigB != ""
                    f_mark(a60, -1, sigB)
                if showEvt and (s60 > 0 or b60 > 0)
                    f_mark(tr, 0, f_evtTip("1m", a60, s60, b60, liveT))

// ---- 印の描画 (予約した足が確定するまで毎更新描き直す。前の足で予約した分は確定済みなので外す) ----------------------------
while array.size(mkBar) > 0 and array.get(mkBar, 0) < time
    array.shift(mkBar)
    array.shift(mkX)
    array.shift(mkK)
    array.shift(mkTip)
for i = 0 to array.size(mkBar) - 1
    if i >= array.size(mkBar)
        break
    int    k   = array.get(mkK, i)
    int    x   = array.get(mkX, i)
    string tip = array.get(mkTip, i)
    if k == 1 and showSig
        label.new(x, high, sigDet ? tip : "SELL", xloc.bar_time, yloc.abovebar, sellCol, label.style_label_down,
             color.white, size.small, tooltip = tip)
    else if k == -1 and showSig
        label.new(x, low, sigDet ? tip : "BUY", xloc.bar_time, yloc.belowbar, buyCol, label.style_label_up,
             color.white, size.small, tooltip = tip)
    else if k == 0
        label.new(x, high, "•", xloc.bar_time, yloc.abovebar, color.new(color.orange, 100), label.style_label_down,
             color.orange, size.small, tooltip = tip)
    else if k == 2 and showLost
        label.new(x, high, "欠", xloc.bar_time, yloc.abovebar, color.new(color.gray, 0), label.style_label_down,
             color.white, size.tiny, tooltip = tip)

// ---- 確認用の表 ----------------------------------------------------------------------------------------------------------
f_cName(int c) =>
    c == 0 ? "不要" : c == 1 ? "未着" : c == 2 ? "受信" : "欠落"

var table tb = table.new(position.top_right, 3, 7, color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    table.cell(tb, 0, 0, "SATS-SL", text_color = color.white)
    table.cell(tb, 1, 0, "SELL", text_color = sellCol)
    table.cell(tb, 2, 0, "BUY", text_color = buyCol)
    table.cell(tb, 0, 1, "直近15s", text_color = color.white)
    table.cell(tb, 1, 1, na(array.get(sqS, 0)) ? "-" : f_lines(array.get(sqS, 1)) + " " + f_hms(array.get(sqS, 0)), text_color = color.white)
    table.cell(tb, 2, 1, na(array.get(sqB, 0)) ? "-" : f_lines(array.get(sqB, 1)) + " " + f_hms(array.get(sqB, 0)), text_color = color.white)
    table.cell(tb, 0, 2, "組 15s/30s", text_color = color.white)
    table.cell(tb, 1, 2, na(array.get(sqS, 2)) ? "-" : f_hms(array.get(sqS, 2)) + " / " + f_hms(array.get(sqS, 4)), text_color = color.white)
    table.cell(tb, 2, 2, na(array.get(sqB, 2)) ? "-" : f_hms(array.get(sqB, 2)) + " / " + f_hms(array.get(sqB, 4)), text_color = color.white)
    table.cell(tb, 0, 3, "1分の期限", text_color = color.white)
    table.cell(tb, 1, 3, na(array.get(sqS, 2)) ? "-" : f_hms(array.get(sqS, 2) + waitMs), text_color = color.white)
    table.cell(tb, 2, 3, na(array.get(sqB, 2)) ? "-" : f_hms(array.get(sqB, 2) + waitMs), text_color = color.white)
    string head = array.size(rT) == 0 ? "" : " 先頭 " + f_hms(array.get(rT, 0)) + " 30s " + f_cName(array.get(rC30, 0))
         + " 1m " + f_cName(array.get(rC60, 0))
    table.cell(tb, 0, 4, "処理待ち", text_color = color.white)
    table.cell(tb, 1, 4, str.tostring(array.size(rT)) + " 行" + head, text_color = color.white)
    table.cell(tb, 2, 4, "開始帯 " + str.tostring(ss15) + " / " + str.tostring(ss30) + " / " + str.tostring(ss60), text_color = color.white)
    table.cell(tb, 0, 5, "欠落", text_color = color.white)
    table.cell(tb, 1, 5, str.tostring(lostN) + " 件", text_color = lostN > 0 ? color.orange : color.white)
    table.cell(tb, 2, 5, lostTxt == "" ? "-" : "最後: " + lostTxt, text_color = color.white)
    table.cell(tb, 0, 6, "チャート", text_color = color.white)
    table.cell(tb, 1, 6, chartOk ? "15秒 OK" : "15秒チャートで使用してください", text_color = chartOk ? color.white : color.red)
    table.cell(tb, 2, 6, "LINE 開始価格は直前確定 VWMA 近似", text_color = color.white)

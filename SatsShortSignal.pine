// © shota0927-prog
//
// ============================================================================
//  SATS Short/Long Signal (15S)  —  サッツバンド 売り・買いタイミング検知の単体インジ (SSS-8)
//  15秒チャート専用。15秒・30秒・1分・5分の帯崩れ (開始判定 / 途中 STB) が、パターンごとに必要な時間足で同じ方向に 1 回ずつ
//  揃ったら (順不同) SELL / BUY を出す。パターン: 30秒まで (15秒・30秒, 初期 OFF) / 1分まで (+1分, 初期 ON) /
//  5分まで (+5分, 初期 OFF)。複数 ON 可。順張り・逆張りの判定はしない。
//  上位足の目線はこのインジの外で確認する。注文・SL / TP・アラートは無い (チャート上の検知表示のみ)。
//  計算の基準は「SAT BAND Reconstruction Test」。f_satBand() は一字一句そのまま (tests/sats_src/f_satBand.txt)。
//  既存の Zone / Strategy のファイルは編集していない。
//
//  ■ 開始時点の状態 (15秒 / 30秒 / 1分 共通。履歴とリアルタイムで同じ式)
//    新しい足 N から使う値は time と open だけ。それ以外は N が始まる前に確定していた直前足 P のデータだけを使う。
//    ・直前足の帯 bandState と LINE1 / LINE2 / STB の方向 = P の f_satBand() の確定値。
//    ・LINE1 / LINE2 の開始方向とアンカー = P の確定値 (close / high / low / ATR50 / アンカー / 方向) を
//      f_satBand() と同じ更新式 (f_nextAnchor) に入れた N のアンカー・方向。
//      開始時の線価格 = N のアンカー + P の common (= P の VWMA(hlc3, 5) × 0.5)。
//      【近似】本来 N の common は N の最初の更新の出来高・値を含む VWMA だが、それは履歴から復元できないため、
//      直前確定足の VWMA を使う。リアルタイムも同じ式に揃えている (リアルタイムでも N の値は open 以外使わない)。
//    ・STB の開始方向 = open を P までの直前 20本の高値・安値と比較 (high 側の突破を先に判定 = 既存と同じ優先順。
//      どちらも突破していなければ P の方向を維持)。開始価格 = 方向 +1 なら min(open, 直前 9本の安値)、
//      -1 なら max(open, 直前 9本の高値) (= 開始時点の 10本の安値 / 高値)。
//    ・開始時の帯 = open と上の 3本の厳密比較: 3本すべてより上 +1 (青) / すべてより下 -1 (赤) / それ以外 0 (背景なし)。
//    3本の線が P と N の両方で揃っている (na でない) ときだけ判定する。
//
//  ■ 成立条件 (その時間足で 1 回。3本中 1本でよい。複数の線が該当しても 1 イベント)
//    SELL: P が青 (+1)、N の開始時が背景なし (0)、ある線が P で +1 → N 開始で -1 かつその同じ線の開始価格 > open
//    BUY : P が赤 (-1)、N の開始時が背景なし (0)、ある線が P で -1 → N 開始で +1 かつその同じ線の開始価格 < open
//    開始時点で決まり、足の途中で変わらない・取り消さない。
//
//  ■ 途中の STB 転換 (SSS-5 / 8。15秒 / 30秒 / 1分 / 5分の各対象足。LINE1 / LINE2 は開始時判定だけ)
//    ・対象足の間は、直前確定足からの値 (帯、STB 方向、直前 20本 / 9本の高値・安値、LINE1 / LINE2 の開始価格) を固定する。
//    ・15秒足が確定するたびに、対象足の open からその時点までに確定した 15秒足の高値・安値を累積する
//      (30秒・1分も、その時点までの 15秒足だけ。対象足の最終高値・安値は先読みしない)。
//      累積高値 > 直前20本の高値 → STB 青、それ以外で累積安値 < 直前20本の安値 → 赤、どちらもなければ直前確定足の方向
//      (上下両方を抜いたら高値側 = 青)。STB 価格 = 青なら min(累積安値, 直前9本の安値)、赤なら max(累積高値, 直前9本の高値)。
//    ・前回の確認時点 (対象足の開始、または前の 15秒確定) から STB の色が変わったときだけ、今回確定した 15秒足の終値で
//      固定の LINE1 / LINE2 と更新後の STB から帯を判定する:
//        SELL: 直前確定足が青、STB 青 → 赤、帯は背景なし、赤 STB > 15秒終値
//        BUY : 直前確定足が赤、STB 赤 → 青、帯は背景なし、青 STB < 15秒終値
//      同じ方向・同じ対象足では最初の 1 回だけ。開始時に同方向が成立していれば、途中では再成立させない。
//    ・成立時刻 = 転換を確認した 15秒足の確定時刻 time_close (開始判定の成立時刻は従来どおり対象足の開始時刻)。
//
//  ■ 揃い方 (SSS-8: パターン別・方向別に独立。必要な時間足は順不同)
//    ・パターンごと・方向ごとに、そのパターンが使う時間足の最新の成立を 1 件ずつ持つ (再成立したらその枠を最新で更新)。
//    ・必要な枠が揃い、最も早い成立から最も遅い成立までが待ち時間以内 (全パターン共通、初期 5 分・ちょうどは有効) なら合図。
//      成立時刻から待ち時間を超えた枠はその枠だけ失効させる (基準は処理中のイベントの成立時刻)。
//    ・合図を出したらそのパターン・方向の枠だけを消し、同じ時刻の残りの同方向イベントもそのパターンでは消費済みにする。
//      同じ成立を別のパターンでは引き続き使える。反対方向の記録は保持する。
//    ・処理順: 成立時刻 → 同時刻は確定による消去が先 → 成立イベントは 15秒 → 30秒 → 1分 → 5分 → 同じ時間足では閉じる足
//      (途中 STB) が始まる足 (開始判定) より先。
//
//  ■ 元の帯への復帰 (SSS-7 / 8。15秒・30秒・1分・5分ごとに ON / OFF、初期はすべて ON)
//    ・対象時間足の確定足の f_satBand() の bandState が青 (+1) なら、その時間足を含む全パターンで SELL のその時間足の枠だけ、
//      赤 (-1) なら BUY のその時間足の枠だけ消す。背景なし (0)・帯の値の欠落・形成中の色変化では消さない。順不同の揃い方と 5 分の期限は変わらない。
//    ・確定帯はその足の time_close と一緒に取得する (15秒はチャートの [1]、30秒・1分は要求先の現在足・直前足それぞれの
//      直前確定足)。既存の処理待ちの行で時刻順に扱い、同じ時間足・確定時刻のクリアは 1 回だけ。
//    ・同じ時刻では、その時刻に確定した全時間足のクリアを先に適用し、その後で成立イベントを既存の同時刻順で処理する。
//    ・対象足の最終 15秒の途中 STB と、その対象足の元の帯への復帰確定が同時なら、その方向の STB 成立は待機に登録しない
//      (同じ時刻に次の足の開始判定が成立した場合は通常どおり登録する)。
//
//  ■ 取得
//    15秒はチャート自身。30秒・1分・5分は request.security(同じ銘柄, "30S" / "1" / "5", lookahead_on) で、要求先の時間足の
//    [現在足の開始時刻・開始判定 (SELL / BUY の該当線)・open・途中 STB 用の固定値、直前足の同じ組] を受け取る。
//    要求先から使うのはその足の time / open と直前確定足の値だけ (要求先の足の高値・安値・終値・出来高は使わない。
//    途中の高値・安値はチャートの確定した 15秒足から集計する)。
//
//  ■ 処理待ちの行 (SSS-3 / 8: 受信順ではなく成立時刻順。パターンは自分の時間足のデータだけを待つ)
//    ・15秒足ごとに 1 行 (キー = 15秒チャートの time)。15秒の開始判定と確定値 (time_close / 高値 / 安値 / 終値) を 1 回だけ保存。
//      30秒・1分・5分の欄は、time("30S") / time("1") / time("5") が切り替わった 15秒足で「取得すべき開始時刻」を記録して
//      「未着」にする (切り替わらなかった欄と、ON のパターンが使わない時間足の欄は「処理不要」)。
//    ・欄の状態: 処理不要 / 未着 / 受信済み / 欠落。要求先の現在足・直前足のデータは、時間足と開始時刻が一致する「未着」欄に
//      だけ入れる (条件不成立のデータも成立結果ゼロで受信済み)。受信済み・欠落の欄は上書きしない (欠落後に届いても処理しない)。
//    ・欠落の確定 (照合の後、未着欄ごと): 取得した直前足の開始時刻が待っている開始時刻を厳密に超えた、または 15秒チャートの
//      time が待っている開始時刻から 3 分以上進んだ。欠落欄はイベントなしとして進める。3 分は取得待ちの上限。
//    ・イベントの生成は時間足ごと: 行の順に「開始判定 (確定帯 + 開始イベント)」→「15秒確定 (途中 STB)」。その時間足の欄が
//      未着の行で止まるのはその時間足だけ (例: 5分が未着でも 15秒・30秒・1分は進む)。
//    ・パターンは、使う時間足すべてがイベントを積み終えた時刻より前のイベントだけを上の処理順で処理する。このため 15秒確定の
//      途中 STB は、同じ時刻に始まる次の 15秒足の開始判定と並べられるよう、次の 15秒足が始まってから処理される。
//      データが届いた時刻は成立判定に使わない。
//
//  ■ 表示
//    行・待機状態・印の予約は varip で持つ (リアルタイムの更新ごとのロールバックで戻らず、処理済みの行は再処理しない)。
//    合図は条件が揃った更新で出し、label.new(xloc.bar_time) で「SELL 1分まで」のように方向とパターンを描く。位置は最後に
//    揃ったイベントの位置 (開始判定ならその足の開始、途中 STB なら転換を確認した 15秒足)。同じ位置・同じ方向で複数パターンが
//    成立したら 1 つのラベルにまとめ「SELL 1分まで・5分まで」とする (あとから別パターンが揃った場合も、直近 15 分の印は
//    描き直してまとめる)。ツールチップにはパターンごとに、揃ったイベント、成立幅 (最大 - 最小。「成立幅 45秒」
//    「成立幅 4分20秒」)、各時間足の成立時刻・該当線を出す。
//    単独イベント表示も同じ考え方の位置で、途中 STB は対象足の開始時刻と 15秒足の確定時刻を出す。
//    (リアルタイムの足の途中で描いたラベルは次の更新のロールバックで消えるため、予約した印はその足が確定するまで
//    毎更新描き直す。確定後はそのまま残る。) ツールチップには 1分足の開始時刻と、リアルタイムで検知した場合はその検知時刻
//    (timenow) を出す。履歴の再計算ではデータの遅れが無く、ライブ検知時刻は出さない。再読み込み後も印は 1分足の開始位置。
//    印はラベルなので、古いものから 500 個を超えた分は消える。30秒足 (秒足) が使える TradingView のプランが必要。
// ============================================================================
//@version=6
indicator("SATS Short/Long Signal (15S)", "SATS-SL", overlay = true, max_labels_count = 500)

// ---- 入力 ----------------------------------------------------------------------------------------------------------------
int   waitMin = input.int(5, "待ち時間 (分): 必要な時間足の成立時刻の幅の上限 (全パターン共通)", minval = 1,
     tooltip = "3 つの成立時刻の最も早いものから最も遅いものまでがこの時間以内なら成立 (ちょうども有効)。実時刻差で判定する。")
bool  showSig = input.bool(true, "SELL / BUY のラベル (ツールチップに各時間足の成立時刻・該当線)")
bool  sigDet  = input.bool(false, "SELL / BUY のラベル本文にも各時間足の成立時刻・該当線を書く")
bool  showEvt = input.bool(false, "確認用: 各時間足の単独成立イベントを表示 (時間足・該当線・開始時刻)")
bool  showTbl = input.bool(true, "確認用: 待機状態の表を表示")
bool  showLost = input.bool(true, "確認用: 欠落した 30秒 / 1分 / 5分データを表示")
bool  clr15   = input.bool(true, "15秒: 元の帯に戻って確定したら成立記録を消す", group = "元の帯への復帰",
     tooltip = "SELL 待機中に 15秒足が青バンド (+1) で確定したら SELL の 15秒枠を、BUY 待機中に赤バンド (-1) で確定したら BUY の 15秒枠を消す。")
bool  clr30   = input.bool(true, "30秒: 元の帯に戻って確定したら成立記録を消す", group = "元の帯への復帰")
bool  clr60   = input.bool(true, "1分: 元の帯に戻って確定したら成立記録を消す", group = "元の帯への復帰")
bool  clr300  = input.bool(true, "5分: 元の帯に戻って確定したら成立記録を消す", group = "元の帯への復帰")
bool  pat30   = input.bool(false, "30秒まで (15秒・30秒)", group = "パターン (複数 ON 可)",
     tooltip = "必要な時間足が同じ方向で順不同に揃ったら合図。待ち時間は全パターン共通。")
bool  pat1m   = input.bool(true, "1分まで (15秒・30秒・1分)", group = "パターン (複数 ON 可)")
bool  pat5m   = input.bool(false, "5分まで (15秒・30秒・1分・5分)", group = "パターン (複数 ON 可)")
color sellCol = input.color(color.new(color.red, 0), "SELL の色")
color buyCol  = input.color(color.new(color.teal, 0), "BUY の色")

// ---- SAT BAND (移植元の関数をそのまま) --------------------------------------------------------------------------------
f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]

// ---- 次の足の LINE アンカー・方向 (f_satBand() の LINE1 / LINE2 更新式と同じ。直前確定足の値だけで決まる) ---------------
//  atrV / srcV / trigLowV / trigHighV は、確定足 P 上で計算した ta.atr(50) / close*0.5 / low*0.5 / high*0.5
//  (= 次の足 N の f_satBand() が [1] で参照する値)。
f_nextAnchor(float prevAnchor, int prevDir, float k, float srcV, float trigLowV, float trigHighV, float atrV) =>
    float a = prevAnchor
    int   d = prevDir
    bool readyV = not na(atrV) and not na(srcV) and not na(trigLowV) and not na(trigHighV)
    if readyV
        if na(prevAnchor)
            a := srcV - k * atrV
            d := 1
        else if prevDir == 1
            if trigLowV < prevAnchor
                d := -1
                a := srcV + k * atrV
            else
                d := 1
                a := math.max(prevAnchor, srcV - k * atrV)
        else
            if trigHighV > prevAnchor
                d := 1
                a := srcV - k * atrV
            else
                d := -1
                a := math.min(prevAnchor, srcV + k * atrV)
    [a, d]

//  確定足 P 上で、次の足 N の開始判定に必要な値をまとめる。
f_satsPrep() =>
    [l1, l2, sb, d1, d2, sd, st, b, cm, at, a1, a2] = f_satBand()
    float atrN = ta.atr(50)
    [a1n, d1n] = f_nextAnchor(a1, d1, 5.0, close * 0.5, low * 0.5, high * 0.5, atrN)
    [a2n, d2n] = f_nextAnchor(a2, d2, 2.5, close * 0.5, low * 0.5, high * 0.5, atrN)
    bool okP = not na(l1) and not na(l2) and not na(sb)
    [okP, st, d1, d2, sd, cm + a1n, cm + a2n, d1n, d2n, ta.highest(high, 20), ta.lowest(low, 20), ta.highest(high, 9), ta.lowest(low, 9)]

//  新しい足の time / open と、直前確定足 ([1]) の値。チャート上でも request.security の中でも同じ関数を使う。
f_satsStart() =>
    [okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9] = f_satsPrep()
    [time, open, okP[1], st[1], d1[1], d2[1], sd[1], l1s[1], l2s[1], d1s[1], d2s[1], hh20[1], ll20[1], hh9[1], ll9[1]]

//  開始時点の判定。戻り値 [sellMask, buyMask, 開始帯, STB 開始方向, STB 開始価格]。mask: 1 = LINE1, 2 = LINE2, 4 = STB。
f_evt(float o, bool okP, int stP, int d1P, int d2P, int sdP, float l1s, float l2s, int d1s, int d2s,
      float hh20, float ll20, float hh9, float ll9) =>
    int sdS = sdP
    if not na(hh20) and not na(ll20) and not na(o)
        if o > hh20
            sdS := 1
        else if o < ll20
            sdS := -1
    float sbS = na(o) ? na : sdS == 1 ? math.min(o, ll9) : math.max(o, hh9)
    int stS = na
    int ms = 0
    int mb = 0
    if okP and not na(o) and not na(l1s) and not na(l2s) and not na(sbS)
        stS := o > l1s and o > l2s and o > sbS ? 1 : o < l1s and o < l2s and o < sbS ? -1 : 0
        if stS == 0 and stP == 1
            ms += d1P == 1 and d1s == -1 and l1s > o ? 1 : 0
            ms += d2P == 1 and d2s == -1 and l2s > o ? 2 : 0
            ms += sdP == 1 and sdS == -1 and sbS > o ? 4 : 0
        if stS == 0 and stP == -1
            mb += d1P == -1 and d1s == 1 and l1s < o ? 1 : 0
            mb += d2P == -1 and d2s == 1 and l2s < o ? 2 : 0
            mb += sdP == -1 and sdS == 1 and sbS < o ? 4 : 0
    [ms, mb, stS, sdS, sbS]

f_lines(int m) =>
    string s = ""
    if m % 2 == 1
        s += "L1"
    if int(m / 2) % 2 == 1
        s += (s == "" ? "" : "+") + "L2"
    if m >= 4
        s += (s == "" ? "" : "+") + "STB"
    s

f_hms(int t) =>
    na(t) ? "-" : str.format_time(t, "HH:mm:ss", syminfo.timezone)

//  成立幅の表示: 45秒 / 4分20秒 / 5分
f_span(int ms) =>
    int sec = int(math.floor(ms / 1000))
    sec < 60 ? str.tostring(sec) + "秒" : str.tostring(int(math.floor(sec / 60))) + "分" + (sec % 60 > 0 ? str.tostring(sec % 60) + "秒" : "")

//  時間足の名前 (i = 0 15秒, 1 30秒, 2 1分, 3 5分)
f_tfn(int i) =>
    i == 0 ? "15s" : i == 1 ? "30s" : i == 2 ? "1m" : "5m"

//  イベントの説明。開始判定: 「1m L2 09:01:00 (開始)」。途中 STB: 対象足の開始時刻と、転換を確認した 15秒足の確定時刻。
f_desc(string tfn, int m, int t, bool mid, int tgt) =>
    mid ? tfn + " " + f_lines(m) + " " + f_hms(t) + " (途中: 対象足の開始 " + f_hms(tgt) + " / 15秒確定 " + f_hms(t) + ")"
         : tfn + " " + f_lines(m) + " " + f_hms(t) + " (開始)"

// ---- 取得 (毎足・無条件) --------------------------------------------------------------------------------------------------
//  その時間足の現在足と直前足 (要求先の時間足の中で組全体を 1 本ずらした値) について
//  [time, SELL mask, BUY mask, open, 直前確定足の帯, 直前確定足の STB 方向, LINE1 開始価格, LINE2 開始価格,
//   直前20本の高値, 直前20本の安値, 直前9本の高値, 直前9本の安値, 直前確定足の time_close] を返す。
//  直前確定足の帯 (f_satBand() の bandState) と time_close は「元の帯への復帰」のクリアにも使う。最後は現在足の開始帯 (表示用)。
f_satsEvt() =>
    [t, o, okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9] = f_satsStart()
    [ms, mb, stS, sdS, sbS] = f_evt(o, okP, st, d1, d2, sd, l1s, l2s, d1s, d2s, hh20, ll20, hh9, ll9)
    float stP = okP ? st : na
    float sdP = sd
    int   tcP = time_close[1]
    [t, ms, mb, o, stP, sdP, l1s, l2s, hh20, ll20, hh9, ll9, tcP,
         t[1], ms[1], mb[1], o[1], stP[1], sdP[1], l1s[1], l2s[1], hh20[1], ll20[1], hh9[1], ll9[1], tcP[1], stS]

[t15, ms15, mb15, o15, sp15, dp15, l1_15, l2_15, h20_15, w20_15, h9_15, w9_15, tq15,
     t15p, ms15p, mb15p, o15p, sp15p, dp15p, l1_15p, l2_15p, h20_15p, w20_15p, h9_15p, w9_15p, tq15p, ss15] = f_satsEvt()
[t30, ms30, mb30, o30, sp30, dp30, l1_30, l2_30, h20_30, w20_30, h9_30, w9_30, tq30,
     t30p, ms30p, mb30p, o30p, sp30p, dp30p, l1_30p, l2_30p, h20_30p, w20_30p, h9_30p, w9_30p, tq30p, ss30] =
     request.security(syminfo.tickerid, "30S", f_satsEvt(), lookahead = barmerge.lookahead_on)
[t60, ms60, mb60, o60, sp60, dp60, l1_60, l2_60, h20_60, w20_60, h9_60, w9_60, tq60,
     t60p, ms60p, mb60p, o60p, sp60p, dp60p, l1_60p, l2_60p, h20_60p, w20_60p, h9_60p, w9_60p, tq60p, ss60] =
     request.security(syminfo.tickerid, "1", f_satsEvt(), lookahead = barmerge.lookahead_on)
[t300, ms300, mb300, o300, sp300, dp300, l1_300, l2_300, h20_300, w20_300, h9_300, w9_300, tq300,
     t300p, ms300p, mb300p, o300p, sp300p, dp300p, l1_300p, l2_300p, h20_300p, w20_300p, h9_300p, w9_300p, tq300p, ss300] =
     request.security(syminfo.tickerid, "5", f_satsEvt(), lookahead = barmerge.lookahead_on)

bool chartOk  = timeframe.in_seconds() == 15
int  need30T  = time("30S")
int  need60T  = time("1")
int  need300T = time("5")
bool new30    = not na(need30T) and need30T != nz(need30T[1], -1)
bool new60    = not na(need60T) and need60T != nz(need60T[1], -1)
bool new300   = not na(need300T) and need300T != nz(need300T[1], -1)
//  直前の 15秒足の確定値 (リアルタイムで確定の更新を受け取れなかった行の補完用)
int   tc1 = time_close[1]
float h1  = high[1]
float lw1 = low[1]
float c1  = close[1]

// ---- 処理待ちの行 (varip。1 行 = 1 本の 15秒足) -----------------------------------------------------------------------------
//  欄の状態
int C_NONE = 0   // 処理不要
int C_WAIT = 1   // 未着
int C_RCV  = 2   // 受信済み
int C_LOST = 3   // 欠落
int waitMs = waitMin * 60000
int PK     = 10  // 固定値の組: 0 open, 1 直前確定足の帯, 2 直前確定足の STB 方向, 3 LINE1 開始, 4 LINE2 開始, 5 hh20, 6 ll20, 7 hh9, 8 ll9,
                //             9 直前確定足の time_close
int NC     = 3   // 行ごとの上位足の欄: 0 30秒, 1 1分, 2 5分 (時間足番号 i = 欄 + 1)
//  使う時間足の上限 (0 15秒 .. 3 5分)。OFF のパターンだけが使う時間足は取得待ちにしない
int maxTf  = pat5m ? 3 : pat1m ? 2 : 1
varip array<int>   rT   = array.new_int()    // 15秒足の time (行のキー)
varip array<int>   rS15 = array.new_int()
varip array<int>   rB15 = array.new_int()
varip array<float> rP15 = array.new_float()  // 15秒足の固定値 (PK 個ずつ)
varip array<int>   cT   = array.new_int()    // 欄: 取得すべき開始時刻 (行 × NC)
varip array<int>   cC   = array.new_int()    // 欄の状態
varip array<int>   cS   = array.new_int()    // SELL mask
varip array<int>   cB   = array.new_int()    // BUY mask
varip array<int>   cG   = array.new_int()    // この 15秒足を含むその時間足の足の開始時刻 (time(tf))
varip array<float> cP   = array.new_float()  // 固定値 (行 × NC × PK)
varip array<int>   rCl  = array.new_int()    // 1 = 確定値を記録済み
varip array<int>   rTc  = array.new_int()    // 15秒足の time_close
varip array<float> rH   = array.new_float()
varip array<float> rL   = array.new_float()
varip array<float> rC   = array.new_float()
varip int    lastRowT = na
varip int    lostN    = 0
varip string lostTxt  = ""
//  時間足ごとのイベント生成カーソル: 次に見る行 (先頭からの位置)、段階 (0 = 開始判定待ち, 1 = 15秒確定待ち)、
//  最後に確定を処理した 15秒足の time_close
varip array<int> curIdx = array.new_int(4, 0)
varip array<int> curPh  = array.new_int(4, 0)
varip array<int> tfTc   = array.new_int(4, na)
//  処理中の対象足 (時間足 i ごとに CX 個):
//    0 開始時刻, 1 有効 (1/0), 2 直前確定足の帯, 3 直前確定足の STB 方向, 4 LINE1 開始, 5 LINE2 開始, 6 hh20, 7 ll20,
//    8 hh9, 9 ll9, 10 前回確認時点の STB 方向, 11 累積高値, 12 累積安値, 13 SELL 成立済み, 14 BUY 成立済み
int CX = 15
varip array<float> cx = array.new_float(60, na)
//  イベント (時間足ごとに生成し、各パターンが成立時刻順に読む)
//    eG: 0 = 確定帯 (元の帯への復帰の消去。eMS に帯), 1 = 成立イベント。eR: 時間足 0..3。eSub: 0 = 閉じた足 (途中 STB), 1 = 始まる足
//    eDone: 処理済みパターンのビット (1 = 30秒まで, 2 = 1分まで, 4 = 5分まで)
varip array<int> eT    = array.new_int()
varip array<int> eG    = array.new_int()
varip array<int> eR    = array.new_int()
varip array<int> eSub  = array.new_int()
varip array<int> eMS   = array.new_int()
varip array<int> eMB   = array.new_int()
varip array<int> eX    = array.new_int()
varip array<int> eTgt  = array.new_int()
varip array<int> eDone = array.new_int()
//  待機 (パターン p 0..2 × 方向 d 0 SELL / 1 BUY。9 個ずつ: 時間足 i の成立時刻 2i、該当線 2i+1、8 = 最後の合図の成立時刻)
varip array<int>    sq  = array.new_int(54, na)
varip array<string> sx  = array.new_string(24, "")   // 説明 (パターン × 方向 × 時間足)
varip array<int>    pcT = array.new_int(12, na)      // パターン × 時間足: 最後に処理した確定帯の時刻
varip array<int>    pcB = array.new_int(12, 0)       //                   その帯
//  単独イベント・欠落の印の予約 (描いた足が確定するまで毎更新描き直す)
varip array<int>    mkBar = array.new_int()
varip array<int>    mkX   = array.new_int()
varip array<int>    mkK   = array.new_int()     // 0 単独イベント / 2 欠落
varip array<string> mkTip = array.new_string()
//  SELL / BUY の印 (同じ位置・同じ方向は 1 つにまとめる)。smTxt = 「SELL 1分まで・5分まで」
varip array<int>    smX   = array.new_int()
varip array<int>    smK   = array.new_int()     // 1 SELL / -1 BUY
varip array<string> smTxt = array.new_string()
varip array<string> smTip = array.new_string()

f_mark(int x, int k, string tip) =>
    array.push(mkBar, time)
    array.push(mkX, x)
    array.push(mkK, k)
    array.push(mkTip, tip)

f_pName(int p) =>
    p == 0 ? "30秒まで" : p == 1 ? "1分まで" : "5分まで"

f_pOn(int p) =>
    p == 0 ? pat30 : p == 1 ? pat1m : pat5m

//  パターン p が使う時間足: 30秒まで = 15秒・30秒、1分まで = + 1分、5分まで = + 5分
f_pHas(int p, int i) =>
    i <= p + 1

f_clrOn(int i) =>
    i == 0 ? clr15 : i == 1 ? clr30 : i == 2 ? clr60 : clr300

f_sigMark(int x, int k, int p, string sec) =>
    int n = array.size(smX)
    int at = -1
    for j = 0 to n - 1
        if j >= n
            break
        if array.get(smX, j) == x and array.get(smK, j) == k
            at := j
    if at >= 0
        array.set(smTxt, at, array.get(smTxt, at) + "・" + f_pName(p))
        array.set(smTip, at, array.get(smTip, at) + "\n\n" + sec)
    else
        array.push(smX, x)
        array.push(smK, k)
        array.push(smTxt, (k == 1 ? "SELL " : "BUY ") + f_pName(p))
        array.push(smTip, sec)

// ---- 待機 (パターン別・方向別。必要な時間足の最新の成立を 1 件ずつ。順不同) ----------------------------------------------------
f_slotClr(int p, int d, int i) =>
    int b = (p * 2 + d) * 9
    array.set(sq, b + 2 * i, na)
    array.set(sq, b + 2 * i + 1, 0)
    array.set(sx, (p * 2 + d) * 4 + i, "")

//  時間足 i の成立 (m > 0) をパターン p・方向 d の枠に入れる。必要な枠が揃い、最も早い〜最も遅い成立が待ち時間以内なら
//  ツールチップの節を返して枠をクリアする。無ければ ""。成立時刻から待ち時間を超えた枠はその枠だけ失効。
f_seqEvt(int p, int d, int i, int t, int m, string desc, int liveT) =>
    int b = (p * 2 + d) * 9
    for k = 0 to p + 1
        int tk = array.get(sq, b + 2 * k)
        if not na(tk) and t - tk > waitMs
            f_slotClr(p, d, k)
    string res = ""
    int lastSig = array.get(sq, b + 8)
    if m > 0 and not (not na(lastSig) and lastSig == t)
        array.set(sq, b + 2 * i, t)
        array.set(sq, b + 2 * i + 1, m)
        array.set(sx, (p * 2 + d) * 4 + i, desc)
        bool full = true
        int mn = na
        int mx = na
        for k = 0 to p + 1
            int tk = array.get(sq, b + 2 * k)
            if na(tk)
                full := false
            else
                mn := na(mn) or tk < mn ? tk : mn
                mx := na(mx) or tk > mx ? tk : mx
        if full and mx - mn <= waitMs
            res := f_pName(p) + " (揃った: " + f_tfn(i) + " " + f_hms(t) + ")\n成立幅 " + f_span(mx - mn)
            for k = 0 to p + 1
                res += "\n" + array.get(sx, (p * 2 + d) * 4 + k)
            res += na(liveT) ? "" : "\nライブ検知 " + f_hms(liveT) + (liveT - t >= 15000 ? " (遅れ " + str.tostring(math.floor((liveT - t) / 1000)) + "秒)" : "")
            for k = 0 to p + 1
                f_slotClr(p, d, k)
            array.set(sq, b + 8, t)
    res

// ---- 行・欄の操作 ----------------------------------------------------------------------------------------------------------
f_pushPack(array<float> pk, float o, float stP, float sdP, float l1s, float l2s, float hh20, float ll20, float hh9, float ll9, int tcP) =>
    array.push(pk, o)
    array.push(pk, stP)
    array.push(pk, sdP)
    array.push(pk, l1s)
    array.push(pk, l2s)
    array.push(pk, hh20)
    array.push(pk, ll20)
    array.push(pk, hh9)
    array.push(pk, ll9)
    array.push(pk, tcP)

f_setPack(array<float> pk, int q, float o, float stP, float sdP, float l1s, float l2s, float hh20, float ll20, float hh9, float ll9, int tcP) =>
    int b = q * PK
    array.set(pk, b, o)
    array.set(pk, b + 1, stP)
    array.set(pk, b + 2, sdP)
    array.set(pk, b + 3, l1s)
    array.set(pk, b + 4, l2s)
    array.set(pk, b + 5, hh20)
    array.set(pk, b + 6, ll20)
    array.set(pk, b + 7, hh9)
    array.set(pk, b + 8, ll9)
    array.set(pk, b + 9, tcP)

f_addCell(bool isNew, int need) =>
    array.push(cT, isNew ? need : na)
    array.push(cC, isNew ? C_WAIT : C_NONE)
    array.push(cS, 0)
    array.push(cB, 0)
    array.push(cG, need)
    f_pushPack(cP, na, na, na, na, na, na, na, na, na, na)

//  欄 k (0 30秒, 1 1分, 2 5分) の開始時刻 t のデータを、一致する未着欄にだけ入れる
f_recv(int k, int t, int ms, int mb, float o, float stP, float sdP, float l1s, float l2s, float hh20, float ll20, float hh9, float ll9, int tcP) =>
    if not na(t)
        int n = array.size(rT)
        for j = 0 to n - 1
            if j >= n
                break
            int q = j * NC + k
            if array.get(cC, q) == C_WAIT and array.get(cT, q) == t
                array.set(cC, q, C_RCV)
                array.set(cS, q, nz(ms))
                array.set(cB, q, nz(mb))
                f_setPack(cP, q, o, stP, sdP, l1s, l2s, hh20, ll20, hh9, ll9, tcP)

//  未着欄の欠落判定 (現在足・直前足の照合の後)
f_lost(int k, int prevT) =>
    int n = array.size(rT)
    int cnt = 0
    string txt = ""
    string nm = k == 0 ? "30秒" : k == 1 ? "1分" : "5分"
    for j = 0 to n - 1
        if j >= n
            break
        int q = j * NC + k
        if array.get(cC, q) == C_WAIT
            int w = array.get(cT, q)
            string why = not na(prevT) and prevT > w ? "直前足 " + f_hms(prevT) + " が先行" : time - w >= 180000 ? "3分経過" : ""
            if why != ""
                array.set(cC, q, C_LOST)
                cnt += 1
                txt := nm + " " + f_hms(w) + " " + why + " (判定 " + f_hms(time) + ")"
                f_mark(array.get(rT, j), 2, "欠落: " + nm + " 開始 " + f_hms(w) + "\n理由: " + why
                     + "\n判定した 15秒足 " + f_hms(time) + "\nイベントなしとして処理を再開 (" + nm + "を使うパターンだけが待つ)")
    [cnt, txt]

f_rowPop() =>
    array.shift(rT)
    array.shift(rS15)
    array.shift(rB15)
    array.shift(rCl)
    array.shift(rTc)
    array.shift(rH)
    array.shift(rL)
    array.shift(rC)
    for k = 1 to PK
        array.shift(rP15)
    for k = 1 to NC
        array.shift(cT)
        array.shift(cC)
        array.shift(cS)
        array.shift(cB)
        array.shift(cG)
    for k = 1 to NC * PK
        array.shift(cP)
    for i = 0 to 3
        array.set(curIdx, i, math.max(0, array.get(curIdx, i) - 1))

f_evtTip(int ms, int mb, string tfn, int t, bool mid, int tgt, int liveT) =>
    (ms > 0 ? "S " + f_desc(tfn, ms, t, mid, tgt) : "") + (ms > 0 and mb > 0 ? "\n" : "")
     + (mb > 0 ? "B " + f_desc(tfn, mb, t, mid, tgt) : "") + (na(liveT) ? "" : "\nライブ検知 " + f_hms(liveT))

// ---- 対象足の開始と途中 STB ------------------------------------------------------------------------------------------------
//  対象足の開始: 直前確定足からの固定値をその対象足の間保持し、STB の累積高値・安値を open から始める。
//  ok = false (欠落) ならその対象足の途中 STB は判定しない。開始時に同方向が成立していれば、その方向は途中で再成立させない。
//  pk / pb = 固定値の配列と、その組の先頭位置。
f_ctxStart(int i, int t, array<float> pk, int pb, bool ok, int ms, int mb) =>
    int b = i * CX
    bool okC = ok and not na(array.get(pk, pb))
    array.set(cx, b, t)
    array.set(cx, b + 1, okC ? 1 : 0)
    if okC
        float o = array.get(pk, pb)
        for k = 0 to 7
            array.set(cx, b + 2 + k, array.get(pk, pb + 1 + k))
        float hh20 = array.get(pk, pb + 5)
        float ll20 = array.get(pk, pb + 6)
        float sdS = array.get(pk, pb + 2)
        if not na(hh20) and not na(ll20) and not na(o)
            if o > hh20
                sdS := 1
            else if o < ll20
                sdS := -1
        array.set(cx, b + 10, sdS)
        array.set(cx, b + 11, o)
        array.set(cx, b + 12, o)
        array.set(cx, b + 13, ms > 0 ? 1 : 0)
        array.set(cx, b + 14, mb > 0 ? 1 : 0)

//  対象足の途中で 15秒足が確定したとき: 累積高値・安値で STB の方向と価格を更新し、色が変わったときだけ判定する。
//  価格は今回確定した 15秒足の終値 c。LINE1 / LINE2 は対象足の開始時の値で固定。成立は STB (mask 4) のみ。
f_ctxClose(int i, int tgt, float h, float l, float c) =>
    int b = i * CX
    int ms = 0
    int mb = 0
    if array.get(cx, b + 1) == 1 and array.get(cx, b) == tgt and not na(h) and not na(l) and not na(c)
        float cumH = math.max(array.get(cx, b + 11), h)
        float cumL = math.min(array.get(cx, b + 12), l)
        array.set(cx, b + 11, cumH)
        array.set(cx, b + 12, cumL)
        float stP    = array.get(cx, b + 2)
        float sdP    = array.get(cx, b + 3)
        float l1s    = array.get(cx, b + 4)
        float l2s    = array.get(cx, b + 5)
        float hh20   = array.get(cx, b + 6)
        float ll20   = array.get(cx, b + 7)
        float hh9    = array.get(cx, b + 8)
        float ll9    = array.get(cx, b + 9)
        float sdLast = array.get(cx, b + 10)
        // 高値側の突破を先に判定 (上下両方を抜いた場合は青)。どちらもなければ直前確定足の STB 方向
        float sd = sdP
        if not na(hh20) and not na(ll20)
            if cumH > hh20
                sd := 1
            else if cumL < ll20
                sd := -1
        float stb = sd == 1 ? (na(ll9) ? na : math.min(cumL, ll9)) : (na(hh9) ? na : math.max(cumH, hh9))
        if not na(sdLast) and sd != sdLast and not na(stb) and not na(l1s) and not na(l2s) and not na(stP)
            int band = c > l1s and c > l2s and c > stb ? 1 : c < l1s and c < l2s and c < stb ? -1 : 0
            if band == 0 and stP == 1 and sdLast == 1 and sd == -1 and stb > c and array.get(cx, b + 13) == 0
                ms := 4
                array.set(cx, b + 13, 1)
            if band == 0 and stP == -1 and sdLast == -1 and sd == 1 and stb < c and array.get(cx, b + 14) == 0
                mb := 4
                array.set(cx, b + 14, 1)
        array.set(cx, b + 10, sd)
    [ms, mb]

// ---- イベントの生成 (時間足ごと。その時間足のデータだけを待つ) ----------------------------------------------------------------
//  成立 (mask あり) と、消去に使う確定帯 (+1 / -1、その時間足の消去が ON) だけを積む。
f_emit(int t, int g, int i, int sub, int ms, int mb, int x, int tgt, int liveT) =>
    bool keep = g == 0 ? ((ms == 1 or ms == -1) and f_clrOn(i)) : (ms > 0 or mb > 0)
    if keep and not na(t)
        array.push(eT, t)
        array.push(eG, g)
        array.push(eR, i)
        array.push(eSub, sub)
        array.push(eMS, ms)
        array.push(eMB, mb)
        array.push(eX, x)
        array.push(eTgt, tgt)
        array.push(eDone, 0)
        if g == 1 and showEvt
            f_mark(x, 0, f_evtTip(ms, mb, f_tfn(i), t, sub == 0, tgt, liveT))

//  時間足 i のカーソルを進める: 行ごとに 開始判定 (確定帯 + 開始イベント) → 15秒確定 (途中 STB)。
//  30秒 / 1分 / 5分は、その行で始まる足の欄が未着なら止まる (他の時間足は止めない)。
f_tfRun(int i, int liveT) =>
    int guard = 0
    while guard < 5000
        guard += 1
        int j = array.get(curIdx, i)
        if j >= array.size(rT)
            break
        if array.get(curPh, i) == 0
            int rowT = array.get(rT, j)
            if i == 0
                f_emit(int(array.get(rP15, j * PK + 9)), 0, 0, 0, int(array.get(rP15, j * PK + 1)), 0, rowT, rowT, liveT)
                int ms0 = array.get(rS15, j)
                int mb0 = array.get(rB15, j)
                f_ctxStart(0, rowT, rP15, j * PK, true, ms0, mb0)
                f_emit(rowT, 1, 0, 1, ms0, mb0, rowT, rowT, liveT)
            else
                int q = j * NC + i - 1
                int c = array.get(cC, q)
                if c == C_WAIT
                    break
                if c != C_NONE
                    bool ok = c == C_RCV
                    int a = array.get(cT, q)
                    if ok
                        float bnd = array.get(cP, q * PK + 1)
                        float tq  = array.get(cP, q * PK + 9)
                        if not na(bnd) and not na(tq)
                            f_emit(int(tq), 0, i, 0, int(bnd), 0, rowT, rowT, liveT)
                    int msH = ok ? array.get(cS, q) : 0
                    int mbH = ok ? array.get(cB, q) : 0
                    f_ctxStart(i, a, cP, q * PK, ok, msH, mbH)
                    f_emit(a, 1, i, 1, msH, mbH, a, rowT, liveT)
            array.set(curPh, i, 1)
        else
            if array.get(rCl, j) == 0
                break
            int rowT = array.get(rT, j)
            int tgt = i == 0 ? rowT : array.get(cG, j * NC + i - 1)
            int tc = array.get(rTc, j)
            [msC, mbC] = f_ctxClose(i, tgt, array.get(rH, j), array.get(rL, j), array.get(rC, j))
            f_emit(tc, 1, i, 0, msC, mbC, rowT, tgt, liveT)
            array.set(tfTc, i, tc)
            array.set(curPh, i, 0)
            array.set(curIdx, i, j + 1)

//  時間足 i がまだ積んでいないイベントの成立時刻の下限 (これより前の時刻のイベントはすべて積み終わっている)。na = 不明
f_frontier(int i) =>
    int j = array.get(curIdx, i)
    int r = na
    if j >= array.size(rT)
        r := array.get(tfTc, i)
    else if array.get(curPh, i) == 0
        r := j > 0 ? array.get(rTc, j - 1) : array.get(tfTc, i)
    else
        r := array.get(rT, j) + 1
    r

//  パターン p: 使う時間足がすべて積み終わった時刻より前のイベントを、(成立時刻, 確定帯が先, 時間足 15→30→1分→5分,
//  閉じた足が先) の順に処理する。
f_patRun(int p, int liveT) =>
    int fr = na
    bool known = true
    for i = 0 to p + 1
        int fi = f_frontier(i)
        if na(fi)
            known := false
        else
            fr := na(fr) or fi < fr ? fi : fr
    int bit = p == 0 ? 1 : p == 1 ? 2 : 4
    int guard = 0
    while known and guard < 5000
        guard += 1
        int n = array.size(eT)
        int pk = -1
        for e = 0 to n - 1
            if e >= n
                break
            int te = array.get(eT, e)
            if te < fr and f_pHas(p, array.get(eR, e)) and int(array.get(eDone, e) / bit) % 2 == 0
                if pk < 0
                    pk := e
                else
                    int tp = array.get(eT, pk)
                    int gi = array.get(eG, e)
                    int gp = array.get(eG, pk)
                    int ri = array.get(eR, e)
                    int rp = array.get(eR, pk)
                    bool sub = gi == 1 and gp == 1 and array.get(eSub, e) < array.get(eSub, pk)
                    if te < tp or (te == tp and (gi < gp or (gi == gp and (ri < rp or (ri == rp and sub)))))
                        pk := e
        if pk < 0
            break
        array.set(eDone, pk, array.get(eDone, pk) + bit)
        int t = array.get(eT, pk)
        int i = array.get(eR, pk)
        if array.get(eG, pk) == 0
            // 確定帯: 青 (+1) なら SELL のその時間足の枠、赤 (-1) なら BUY の枠だけ消す
            int bnd = array.get(eMS, pk)
            array.set(pcT, p * 4 + i, t)
            array.set(pcB, p * 4 + i, bnd)
            if bnd == 1
                f_slotClr(p, 0, i)
            if bnd == -1
                f_slotClr(p, 1, i)
        else
            int ms = array.get(eMS, pk)
            int mb = array.get(eMB, pk)
            bool mid = array.get(eSub, pk) == 0
            int tgt = array.get(eTgt, pk)
            // 対象足の最終 15秒の途中 STB と、その対象足の元の帯への復帰確定が同時なら、その方向は待機に登録しない
            if mid and f_clrOn(i) and not na(array.get(pcT, p * 4 + i)) and array.get(pcT, p * 4 + i) == t
                ms := array.get(pcB, p * 4 + i) == 1 ? 0 : ms
                mb := array.get(pcB, p * 4 + i) == -1 ? 0 : mb
            string secS = f_seqEvt(p, 0, i, t, ms, f_desc(f_tfn(i), ms, t, mid, tgt), liveT)
            string secB = f_seqEvt(p, 1, i, t, mb, f_desc(f_tfn(i), mb, t, mid, tgt), liveT)
            if secS != ""
                f_sigMark(array.get(eX, pk), 1, p, secS)
            if secB != ""
                f_sigMark(array.get(eX, pk), -1, p, secB)

//  すべての ON のパターン (その時間足を使うもの) が処理したイベントを捨てる
f_evPrune() =>
    int n = array.size(eT)
    for e = n - 1 to 0
        if e < 0 or e >= array.size(eT)
            continue
        int i = array.get(eR, e)
        int dn = array.get(eDone, e)
        bool need = false
        for p = 0 to 2
            int bit = p == 0 ? 1 : p == 1 ? 2 : 4
            if f_pOn(p) and f_pHas(p, i) and int(dn / bit) % 2 == 0
                need := true
        if not need
            array.remove(eT, e)
            array.remove(eG, e)
            array.remove(eR, e)
            array.remove(eSub, e)
            array.remove(eMS, e)
            array.remove(eMB, e)
            array.remove(eX, e)
            array.remove(eTgt, e)
            array.remove(eDone, e)

if chartOk
    int liveT = barstate.isrealtime ? timenow : na
    // 1. 行の追加 (15秒足の time ごとに 1 回だけ)。前の行が確定値を受け取っていなければ [1] の確定値で補う
    if na(lastRowT) or time != lastRowT
        int nr = array.size(rT)
        if nr > 0 and array.get(rCl, nr - 1) == 0
            array.set(rCl, nr - 1, 1)
            array.set(rTc, nr - 1, tc1)
            array.set(rH, nr - 1, h1)
            array.set(rL, nr - 1, lw1)
            array.set(rC, nr - 1, c1)
        lastRowT := time
        array.push(rT, time)
        array.push(rS15, ms15)
        array.push(rB15, mb15)
        f_pushPack(rP15, o15, sp15, dp15, l1_15, l2_15, h20_15, w20_15, h9_15, w9_15, tq15)
        f_addCell(new30, need30T)
        f_addCell(new60 and maxTf >= 2, need60T)
        f_addCell(new300 and maxTf >= 3, need300T)
        array.push(rCl, 0)
        array.push(rTc, na)
        array.push(rH, na)
        array.push(rL, na)
        array.push(rC, na)
    // 2. 現在足・直前足の照合 (一致する未着欄だけ。受信済み・欠落は上書きしない)
    f_recv(0, t30,   ms30,   mb30,   o30,   sp30,   dp30,   l1_30,   l2_30,   h20_30,   w20_30,   h9_30,   w9_30,   tq30)
    f_recv(0, t30p,  ms30p,  mb30p,  o30p,  sp30p,  dp30p,  l1_30p,  l2_30p,  h20_30p,  w20_30p,  h9_30p,  w9_30p,  tq30p)
    f_recv(1, t60,   ms60,   mb60,   o60,   sp60,   dp60,   l1_60,   l2_60,   h20_60,   w20_60,   h9_60,   w9_60,   tq60)
    f_recv(1, t60p,  ms60p,  mb60p,  o60p,  sp60p,  dp60p,  l1_60p,  l2_60p,  h20_60p,  w20_60p,  h9_60p,  w9_60p,  tq60p)
    f_recv(2, t300,  ms300,  mb300,  o300,  sp300,  dp300,  l1_300,  l2_300,  h20_300,  w20_300,  h9_300,  w9_300,  tq300)
    f_recv(2, t300p, ms300p, mb300p, o300p, sp300p, dp300p, l1_300p, l2_300p, h20_300p, w20_300p, h9_300p, w9_300p, tq300p)
    // 3. 欠落判定
    [n30, x30] = f_lost(0, t30p)
    [n60, x60] = f_lost(1, t60p)
    [n300, x300] = f_lost(2, t300p)
    if n30 + n60 + n300 > 0
        lostN   += n30 + n60 + n300
        lostTxt := x300 != "" ? x300 : x60 != "" ? x60 : x30
    // 4. この 15秒足が確定したら確定値を記録 (途中 STB 用。1 行 1 回)
    int nl = array.size(rT)
    if barstate.isconfirmed and nl > 0 and array.get(rT, nl - 1) == time and array.get(rCl, nl - 1) == 0
        array.set(rCl, nl - 1, 1)
        array.set(rTc, nl - 1, time_close)
        array.set(rH, nl - 1, high)
        array.set(rL, nl - 1, low)
        array.set(rC, nl - 1, close)
    // 5. 時間足ごとにイベントを生成 (使う時間足だけ)
    for i = 0 to maxTf
        f_tfRun(i, liveT)
    // 6. パターンごとに成立時刻順に処理 (そのパターンが使う時間足が積み終わった時刻まで)
    for p = 0 to 2
        if f_pOn(p)
            f_patRun(p, liveT)
    f_evPrune()
    // 7. 使う時間足のカーソルがすべて通り過ぎた行を外す
    while array.size(rT) > 0
        bool allPast = true
        for i = 0 to maxTf
            if array.get(curIdx, i) == 0
                allPast := false
        if not allPast
            break
        f_rowPop()

// ---- 印の描画 ------------------------------------------------------------------------------------------------------------
//  単独イベント・欠落: 予約した足が確定するまで毎更新描き直す (前の足で予約した分は確定済みなので外す)
while array.size(mkBar) > 0 and array.get(mkBar, 0) < time
    array.shift(mkBar)
    array.shift(mkX)
    array.shift(mkK)
    array.shift(mkTip)
for i = 0 to array.size(mkBar) - 1
    if i >= array.size(mkBar)
        break
    int    k   = array.get(mkK, i)
    int    x   = array.get(mkX, i)
    string tip = array.get(mkTip, i)
    if k == 0
        label.new(x, high, "•", xloc.bar_time, yloc.abovebar, color.new(color.orange, 100), label.style_label_down,
             color.orange, size.small, tooltip = tip)
    else if k == 2 and showLost
        label.new(x, high, "欠", xloc.bar_time, yloc.abovebar, color.new(color.gray, 0), label.style_label_down,
             color.white, size.tiny, tooltip = tip)
//  SELL / BUY: 同じ位置・方向にあとから別パターンが揃ったときに 1 つのラベルへまとめ直せるよう、直近 15 分の印は毎更新
//  描き直す (古いラベルを消して最新の内容で描く)。15 分より古い印は描き直しをやめ、最後に描いたラベルを残す。
var array<label> smL = array.new<label>()
while array.size(smX) > 0 and array.get(smX, 0) < time - 15 * 60000
    array.shift(smX)
    array.shift(smK)
    array.shift(smTxt)
    array.shift(smTip)
for li = array.size(smL) - 1 to 0
    if li < 0 or li >= array.size(smL)
        continue
    label lb = array.get(smL, li)
    int   lx = label.get_x(lb)
    bool  lSell = str.startswith(label.get_text(lb), "SELL")
    bool  open = false
    for j = 0 to array.size(smX) - 1
        if j >= array.size(smX)
            break
        if array.get(smX, j) == lx and (array.get(smK, j) == 1) == lSell
            open := true
    if open
        label.delete(lb)
    array.remove(smL, li)
if showSig
    for j = 0 to array.size(smX) - 1
        if j >= array.size(smX)
            break
        int    x   = array.get(smX, j)
        string txt = array.get(smTxt, j)
        string tip = txt + "\n" + array.get(smTip, j)
        label lb = array.get(smK, j) == 1 ? label.new(x, high, sigDet ? tip : txt, xloc.bar_time, yloc.abovebar, sellCol,
             label.style_label_down, color.white, size.small, tooltip = tip) : label.new(x, low, sigDet ? tip : txt,
             xloc.bar_time, yloc.belowbar, buyCol, label.style_label_up, color.white, size.small, tooltip = tip)
        array.push(smL, lb)

// ---- 確認用の表 ----------------------------------------------------------------------------------------------------------
f_cName(int c) =>
    c == 0 ? "不要" : c == 1 ? "未着" : c == 2 ? "受信" : "欠落"

//  パターン p・方向 d の各時間足の成立時刻と、最も早い有効な成立の期限
f_slotTxt(int p, int d) =>
    int b = (p * 2 + d) * 9
    string s = ""
    int first = na
    for k = 0 to p + 1
        int tk = array.get(sq, b + 2 * k)
        s += (k == 0 ? "" : " / ") + f_hms(tk) + (na(tk) ? "" : " " + f_lines(array.get(sq, b + 2 * k + 1)))
        if not na(tk) and (na(first) or tk < first)
            first := tk
    s + "  期限 " + f_hms(na(first) ? na : first + waitMs)

var table tb = table.new(position.top_right, 3, 8, color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    table.cell(tb, 0, 0, "SATS-SL", text_color = color.white)
    table.cell(tb, 1, 0, "SELL (15s / 30s / 1m / 5m)", text_color = sellCol)
    table.cell(tb, 2, 0, "BUY (15s / 30s / 1m / 5m)", text_color = buyCol)
    for p = 0 to 2
        table.cell(tb, 0, 1 + p, f_pName(p) + (f_pOn(p) ? "" : " (OFF)"), text_color = color.white)
        table.cell(tb, 1, 1 + p, f_pOn(p) ? f_slotTxt(p, 0) : "-", text_color = color.white)
        table.cell(tb, 2, 1 + p, f_pOn(p) ? f_slotTxt(p, 1) : "-", text_color = color.white)
    string head = array.size(rT) == 0 ? "" : " 先頭 " + f_hms(array.get(rT, 0)) + " 30s " + f_cName(array.get(cC, 0))
         + " 1m " + f_cName(array.get(cC, 1)) + " 5m " + f_cName(array.get(cC, 2))
    table.cell(tb, 0, 4, "処理待ち", text_color = color.white)
    table.cell(tb, 1, 4, str.tostring(array.size(rT)) + " 行" + head, text_color = color.white)
    table.cell(tb, 2, 4, "開始帯 " + str.tostring(ss15) + " / " + str.tostring(ss30) + " / " + str.tostring(ss60) + " / "
         + str.tostring(ss300), text_color = color.white)
    table.cell(tb, 0, 5, "欠落", text_color = color.white)
    table.cell(tb, 1, 5, str.tostring(lostN) + " 件", text_color = lostN > 0 ? color.orange : color.white)
    table.cell(tb, 2, 5, lostTxt == "" ? "-" : "最後: " + lostTxt, text_color = color.white)
    table.cell(tb, 0, 6, "チャート", text_color = color.white)
    table.cell(tb, 1, 6, chartOk ? "15秒 OK" : "15秒チャートで使用してください", text_color = chartOk ? color.white : color.red)
    table.cell(tb, 2, 6, "LINE 開始価格は直前確定 VWMA 近似", text_color = color.white)

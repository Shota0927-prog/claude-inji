//@version=6
// ============================================================
// W03WorkerApply_InterfacePOC - interface compile POC only (NOT production)
//
// W03 B26 Repair / PLAN S3-B. The exact Apply Worker entry signature: every
// collection reference and scalar input the B18 F1 - F4 apply stack (28 functions
// reachable from w03StageFApplyThroughF5Raw without F0; the F5 revision commit
// stays in Main) reads from the Main Engine, exactly once, with the Production
// types, and the planned 10-value return shape. No business logic: every
// parameter is read; one array gets a logical no-op get / set at index 0.
// No import, no UDT, no external data request, no drawing.
// ============================================================
library("W03WorkerApply_InterfacePOC", overlay = false)

// 107 parameters : 101 collection references + 6 scalars.
// Returns [ok, nextRootIdOut, dirtyRootRegistry, dirtyRootPrice, dirtyEligibilitySupport,
//          dirtyEligibilityResistance, dirtyRootQuality, dirtyFvgState, dirtyFvgFresh, dirtyPriceOrder].
export pocApplyInterface(array<int> rootIds, array<int> rootOriginKeys, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootOriginTimes, array<int> rootOriginEndTimes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<float> rootNativeBottoms, array<float> rootNativeTops, array<bool> rootIsRangeRootFlags, array<bool> rootIsDynamicFlags, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootFvgFreshFlags, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<int> rootLastUpdateSeqs, array<int> rootPointTicks, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<bool> rootSlotLiveFlags, array<int> rootFreeSlots, array<int> rootLiveSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, array<int> rootPriceOrderSlots, array<int> rootPriceOrderPositions, array<int> categoryMaRootSlots, array<int> categorySwingRootSlots, array<int> categoryAccumRootSlots, array<int> categoryTimeHlRootSlots, array<int> categoryFvgRootSlots, array<int> categoryPsychRootSlots, array<int> tf1mRootSlots, array<int> tf5mRootSlots, array<int> tf15mRootSlots, array<int> tf1hRootSlots, array<int> tf4hRootSlots, array<int> tfDRootSlots, array<int> stateCandidateRootSlots, array<int> stateActiveRootSlots, array<int> stateInvalidatedRootSlots, array<int> stateInverseWaitRootSlots, array<int> stateInverseActiveRootSlots, array<int> stateRetiredRootSlots, array<int> rootCategorySetPositions, array<int> rootTfSetPositions, array<int> rootStateSetPositions, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, array<int> freshFvg1hRootSlots, array<int> freshFvg4hRootSlots, array<int> freshFvgDRootSlots, array<int> structurallyActiveFvg1hRootSlots, array<int> structurallyActiveFvg4hRootSlots, array<int> structurallyActiveFvgDRootSlots, array<int> bullishFvgRootSlots, array<int> bearishFvgRootSlots, array<int> broadFvgRootSlots, array<int> rootFvgFreshSetPositions, array<int> rootFvgStructuralStateSetPositions, array<int> rootFvgDirectionSetPositions, array<int> rootFvgBroadSetPositions, array<int> fvgNativeBottomOrderRootSlots, array<int> fvgNativeTopOrderRootSlots, array<int> rootFvgNativeBottomOrderPositions, array<int> rootFvgNativeTopOrderPositions, array<int> rootParticipationHeadEdgeIndexes, array<int> rootParticipationCounts, array<int> journalOps, array<int> journalGroups, array<int> journalTargetRootSlots, array<int> journalExpectedRootIds, array<int> journalCategories, array<int> journalSubtypes, array<int> journalTfCodes, array<int> journalOriginKeys, array<int> journalOriginTimes, array<int> journalOriginEndTimes, array<int> journalConfirmedTimes, array<float> journalPointPrices, array<float> journalNativeBottoms, array<float> journalNativeTops, array<int> journalOldStates, array<int> journalNewStates, array<bool> journalFvgFreshFlags, array<bool> journalIsBroadFlags, array<int> journalDirections, array<int> journalOldMasks, array<int> journalNewMasks, array<int> journalPairKeys, array<int> journalSlopeDirs, array<int> rootSwingTfMasks, array<int> rootPruneRevisions, map<int, int> originKeyBucketHeadRootSlots, array<int> rootOriginBucketPrevRootSlots, array<int> rootOriginBucketNextRootSlots, array<int> rootOriginBucketExpectedRootIds, int journalCount, int journalBaseSeq, int ema2000SlopeDir, int ema3000SlopeDir, int nextRootId, float mintick) =>
    int refSizes = 0
    refSizes += array.size(rootIds)
    refSizes += array.size(rootOriginKeys)
    refSizes += array.size(rootCategories)
    refSizes += array.size(rootSubtypes)
    refSizes += array.size(rootTfCodes)
    refSizes += array.size(rootOriginTimes)
    refSizes += array.size(rootOriginEndTimes)
    refSizes += array.size(rootConfirmedTimes)
    refSizes += array.size(rootPointPrices)
    refSizes += array.size(rootNativeBottoms)
    refSizes += array.size(rootNativeTops)
    refSizes += array.size(rootIsRangeRootFlags)
    refSizes += array.size(rootIsDynamicFlags)
    refSizes += array.size(rootStates)
    refSizes += array.size(rootPairKeys)
    refSizes += array.size(rootDirections)
    refSizes += array.size(rootFvgFreshFlags)
    refSizes += array.size(rootIsBroadFvgFlags)
    refSizes += array.size(rootLabelMasks)
    refSizes += array.size(rootLastUpdateSeqs)
    refSizes += array.size(rootPointTicks)
    refSizes += array.size(rootNativeBottomTicks)
    refSizes += array.size(rootNativeTopTicks)
    refSizes += array.size(rootSlotLiveFlags)
    refSizes += array.size(rootFreeSlots)
    refSizes += array.size(rootLiveSlots)
    refSizes += array.size(rootIdOrderSlots)
    refSizes += map.size(rootIdToSlot)
    refSizes += array.size(rootPriceOrderSlots)
    refSizes += array.size(rootPriceOrderPositions)
    refSizes += array.size(categoryMaRootSlots)
    refSizes += array.size(categorySwingRootSlots)
    refSizes += array.size(categoryAccumRootSlots)
    refSizes += array.size(categoryTimeHlRootSlots)
    refSizes += array.size(categoryFvgRootSlots)
    refSizes += array.size(categoryPsychRootSlots)
    refSizes += array.size(tf1mRootSlots)
    refSizes += array.size(tf5mRootSlots)
    refSizes += array.size(tf15mRootSlots)
    refSizes += array.size(tf1hRootSlots)
    refSizes += array.size(tf4hRootSlots)
    refSizes += array.size(tfDRootSlots)
    refSizes += array.size(stateCandidateRootSlots)
    refSizes += array.size(stateActiveRootSlots)
    refSizes += array.size(stateInvalidatedRootSlots)
    refSizes += array.size(stateInverseWaitRootSlots)
    refSizes += array.size(stateInverseActiveRootSlots)
    refSizes += array.size(stateRetiredRootSlots)
    refSizes += array.size(rootCategorySetPositions)
    refSizes += array.size(rootTfSetPositions)
    refSizes += array.size(rootStateSetPositions)
    refSizes += map.size(accumPairUpperRootSlotByKey)
    refSizes += map.size(accumPairLowerRootSlotByKey)
    refSizes += array.size(freshFvg1hRootSlots)
    refSizes += array.size(freshFvg4hRootSlots)
    refSizes += array.size(freshFvgDRootSlots)
    refSizes += array.size(structurallyActiveFvg1hRootSlots)
    refSizes += array.size(structurallyActiveFvg4hRootSlots)
    refSizes += array.size(structurallyActiveFvgDRootSlots)
    refSizes += array.size(bullishFvgRootSlots)
    refSizes += array.size(bearishFvgRootSlots)
    refSizes += array.size(broadFvgRootSlots)
    refSizes += array.size(rootFvgFreshSetPositions)
    refSizes += array.size(rootFvgStructuralStateSetPositions)
    refSizes += array.size(rootFvgDirectionSetPositions)
    refSizes += array.size(rootFvgBroadSetPositions)
    refSizes += array.size(fvgNativeBottomOrderRootSlots)
    refSizes += array.size(fvgNativeTopOrderRootSlots)
    refSizes += array.size(rootFvgNativeBottomOrderPositions)
    refSizes += array.size(rootFvgNativeTopOrderPositions)
    refSizes += array.size(rootParticipationHeadEdgeIndexes)
    refSizes += array.size(rootParticipationCounts)
    refSizes += array.size(journalOps)
    refSizes += array.size(journalGroups)
    refSizes += array.size(journalTargetRootSlots)
    refSizes += array.size(journalExpectedRootIds)
    refSizes += array.size(journalCategories)
    refSizes += array.size(journalSubtypes)
    refSizes += array.size(journalTfCodes)
    refSizes += array.size(journalOriginKeys)
    refSizes += array.size(journalOriginTimes)
    refSizes += array.size(journalOriginEndTimes)
    refSizes += array.size(journalConfirmedTimes)
    refSizes += array.size(journalPointPrices)
    refSizes += array.size(journalNativeBottoms)
    refSizes += array.size(journalNativeTops)
    refSizes += array.size(journalOldStates)
    refSizes += array.size(journalNewStates)
    refSizes += array.size(journalFvgFreshFlags)
    refSizes += array.size(journalIsBroadFlags)
    refSizes += array.size(journalDirections)
    refSizes += array.size(journalOldMasks)
    refSizes += array.size(journalNewMasks)
    refSizes += array.size(journalPairKeys)
    refSizes += array.size(journalSlopeDirs)
    refSizes += array.size(rootSwingTfMasks)
    refSizes += array.size(rootPruneRevisions)
    refSizes += map.size(originKeyBucketHeadRootSlots)
    refSizes += array.size(rootOriginBucketPrevRootSlots)
    refSizes += array.size(rootOriginBucketNextRootSlots)
    refSizes += array.size(rootOriginBucketExpectedRootIds)
    float scalarMix = 0.0
    scalarMix += nz(journalCount)
    scalarMix += nz(journalBaseSeq)
    scalarMix += nz(ema2000SlopeDir)
    scalarMix += nz(ema3000SlopeDir)
    scalarMix += nz(nextRootId)
    scalarMix += nz(mintick)
    // reference mutation compile proof : same value back to the same index
    if array.size(rootIds) > 0
        int v = array.get(rootIds, 0)
        array.set(rootIds, 0, v)
    bool ok                         = refSizes >= 0 and not na(scalarMix)
    int  nextRootIdOut              = nextRootId
    bool dirtyRootRegistry          = false
    bool dirtyRootPrice             = false
    bool dirtyEligibilitySupport    = false
    bool dirtyEligibilityResistance = false
    bool dirtyRootQuality           = false
    bool dirtyFvgState              = false
    bool dirtyFvgFresh              = false
    bool dirtyPriceOrder            = false
    [ok, nextRootIdOut, dirtyRootRegistry, dirtyRootPrice, dirtyEligibilitySupport, dirtyEligibilityResistance, dirtyRootQuality, dirtyFvgState, dirtyFvgFresh, dirtyPriceOrder]

//
// ============================================================================
//  FVG + Zone Engine Strategy  (Main)
//  Zone Engine は Library (ZoneEngine) へ分離済み
// ============================================================================
//  役割分担:
//    ZoneEngine Library … Zone検出 / Score / State / Break / Flip /
//                          Structural SL / TP / TradePlan生成
//    Main Strategy      … Inputs / Risk・Qty / 共通Trade Engine / Break Even /
//                          Entry Logic Modules / Order Execution / Debug
//
//  セクション構成:
//    01. Common Inputs
//    02. Zone Engine Config & Feed   (Library設定 + request.security + update)
//    03. Risk / Qty
//    04. Common Trade Engine
//    05. Entry Module - FVG
//    06. Future Entry Modules
//    07. Order Execution
//    08. Break Even
//    09. Display / Debug
//
//  新しいEntry Logicを追加するときに触るのは 06 と 07 だけ。
//  Zone Engine Library は変更不要。
//
//  前提: チャート時間足 = 5分足。
//        Zone Engine の 2000MA / 3000MA は 1分足コンテキストで直接計算する。
// ============================================================================

//@version=5
strategy(
     title             = "FVG + Zone Engine Strategy",
     shorttitle        = "FVG-ZONE",
     overlay           = true,
     pyramiding        = 100,
     initial_capital   = 1000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     dynamic_requests  = true,
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_lines_count   = 200
 )

// ★★★ Library import ★★★
//  "shota0927-prog" の部分は、Libraryを公開した自分のTradingViewユーザー名に置き換えること。
//  バージョン番号 (末尾の /1) は Library を再公開するたびに増える。
import shota0927-prog/ZoneEngine/1 as zn

// Library内の定数と同じ値 (定数exportはPineのバージョン依存機能のため再宣言する)
int ST_ACTIVE  = 0
int ST_SUPPORT = 1
int ST_RESIST  = 2
int ST_BROKEN  = 3
int SR_WEAK    = 1
int SR_MEDIUM  = 2
int SR_STRONG  = 3
int SR_VSTRONG = 4

// 表示用の小さなヘルパー
f_num(float v, string fmt) =>
    na(v) ? "-" : str.tostring(v, fmt)
f_arrow(int dir) =>
    dir > 0 ? "↑" : dir < 0 ? "↓" : "→"

// ============================================================================
// 01. COMMON INPUTS
// ============================================================================

// ---- 1.1 Direction (全Logic共通) ------------------------------------------
//  推奨検証手順:  Longのみ / Shortのみ を別々に実行する。
//  TradingView Strategy は単一ネットポジションのため、Long/Short同時ONは
//  完全なヘッジ検証にはならない。
var string G_DIR = "01 · Common · Direction"
enableLong  = input.bool(true,  "Enable Long  (全LogicのLongを許可)",  group = G_DIR)
enableShort = input.bool(false, "Enable Short (全LogicのShortを許可)", group = G_DIR)

// ---- 1.2 Logic ON / OFF ----------------------------------------------------
//  Logic単体成績を見たいときは、対象LogicだけONにして Strategy Tester を読む。
//  全部ONにすれば全Logic合算成績になる。
var string G_LOGIC = "01 · Common · Entry Logic ON/OFF"
useFvgLogic = input.bool(true, "Use FVG", group = G_LOGIC)
// 新Logicを足したらここに1行追加する:
// useEmaLogic = input.bool(false, "Use EMA Reject", group = G_LOGIC)

// ---- 1.3 Risk -------------------------------------------------------------
var string G_RISK = "01 · Common · Risk"
riskPct     = input.float(5.0, "1トレード損失率 (%)", step = 0.1, group = G_RISK,
     tooltip = "Risk Amount ÷ Structural SL距離 でQtyを計算する。")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = G_RISK)
qtyStep     = input.float(0.01, "Qty 刻み (最小ロット単位)", minval = 0.00000001, step = 0.01, group = G_RISK,
     tooltip = "XAUUSD等の小数ロットを潰さないための刻み。\n" +
               "0.01 → 0.01単位で発注 / 1 → 整数ロットのみ。\n" +
               "Qty = floor(RiskAmount ÷ SL距離 ÷ step) × step")
qtyMin      = input.float(0.01, "Qty 最小値 (これ未満はエントリーしない)", minval = 0.0, step = 0.01, group = G_RISK)

// ---- 1.4 Trade Engine ------------------------------------------------------
var string G_TE = "01 · Common · Trade Engine"
maxOpenPerLogic    = input.int(1, "Logicごとの最大同時保有トレード数", minval = 1, maxval = 50, group = G_TE,
     tooltip = "同一logicIdのポジションをいくつまで同時に持てるか。Logic間は互いに影響しない。")
allowOppositeEntry = input.bool(false, "反対方向Logicの同時Entryを許可", group = G_TE,
     tooltip = "TradingView Strategyは単一ネットポジションのため、反対方向Entryは既存Tradeを\n" +
               "打ち消してしまう。既定 (false) では反対方向シグナルをSKIPする。")

// ---- 1.5 Break Even --------------------------------------------------------
var string G_BE = "01 · Common · Break Even"
useBreakEven         = input.bool(false, "建値移動を使う", group = G_BE,
     tooltip = "既定OFF。OFF時はStructural SL / TPの結果をそのまま検証できる。")
breakEvenTrigger     = input.float(10.0, "建値移動開始幅 ($)", step = 0.1, group = G_BE)
breakEvenTriggerMode = input.string("到達瞬間", "建値移動判定", options = ["到達瞬間", "確定足"], group = G_BE)

// ---- 1.6 Session / News Filter (共通・どのLogicからも参照可) ---------------
var string G_SESS = "01 · Common · Session / News"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = G_SESS)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = G_SESS)
useEUSession     = input.bool(true, "EU 16:00-21:00", group = G_SESS)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = G_SESS)
useNewsTimeFilter = input.bool(false, "重要指標時間を除外", group = G_SESS)
newsSession1 = input.session("2130-2230", "指標除外時間1", group = G_SESS)
newsSession2 = input.session("2330-0030", "指標除外時間2", group = G_SESS)
newsSession3 = input.session("0300-0400", "指標除外時間3", group = G_SESS)

// ---- 1.7 Common Debug ------------------------------------------------------
var string G_DBGC = "01 · Common · Debug"
showEntryLabel = input.bool(true, "Entry Debug Label を表示", group = G_DBGC)
showTradeDebug = input.bool(true, "Trade Debug 行 (最新TradePlan) を表示", group = G_DBGC)

// ---- 1.8 Common Filter Calculation ----------------------------------------
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ============================================================================
// 02. ZONE ENGINE CONFIG & FEED
// ----------------------------------------------------------------------------
//  Zone生成そのものはLibraryが行う。ここで行うのは3つだけ:
//    (1) input を ZoneCfg へ詰める        … Library は input を持てないため
//    (2) request.security で外部足を取得   … Library は request.*() を呼べないため
//    (3) zn.update() を毎バー1回呼ぶ
// ============================================================================

var zn.ZoneEngine eng = zn.newEngine()
zn.ZoneCfg cfg = zn.newCfg()

// ---- 2.1 Zone Geometry -----------------------------------------------------
var string G_ZONE = "02 · Zone Geometry"
cfg.zoneHalfWidth := input.float(5.0, "Zone Half Width ($)", minval = 0.1, step = 0.5, group = G_ZONE,
     tooltip = "Zone = 中心価格 ± この値。Strengthによって幅は変えない。")

// ---- 2.2 MA Source (1分足コンテキストで直接計算) ---------------------------
var string G_MA = "02 · MA Source"
maTf = input.timeframe("1", "MA Timeframe", group = G_MA,
     tooltip = "既定 1分足。1分足コンテキスト内でMAを計算し、その結果を5分足へ取得する。")
maType = input.string("EMA", "MA Type", options = ["SMA", "EMA"], group = G_MA)
useMaSource = input.bool(true, "Enable MA Source", group = G_MA)
// ★ ma1Len / ma2Len / 各TF は request.security・zn.maPack へ渡すため
//   「input変数のまま (simple修飾)」保持する。UDTのフィールド読み出しは series 扱いになり、
//   request.security の timeframe や ta.ema の length には使えないため。
ma1Len = input.int(2000, "MA #1 Length", minval = 1, maxval = 4999, group = G_MA)
ma2Len = input.int(3000, "MA #2 Length", minval = 1, maxval = 4999, group = G_MA)
slopeLookback = input.int(60, "Slope Lookback (MA TF bars)", minval = 1, group = G_MA)
cfg.useMaSource := useMaSource
cfg.ma1Len      := ma1Len
cfg.ma2Len      := ma2Len
cfg.scoreMa1    := input.float(2.0, "Base Score · MA #1", step = 0.5, group = G_MA)
cfg.scoreMa2    := input.float(2.0, "Base Score · MA #2", step = 0.5, group = G_MA)
cfg.maTfName    := maTf

// ---- 2.3 MA Slope ----------------------------------------------------------
var string G_SLOPE = "02 · MA Slope"
cfg.slopeThrMod       := input.float(1.0, "Slope Threshold · Moderate ($/lookback)", step = 0.1, group = G_SLOPE)
cfg.slopeThrStrong    := input.float(3.0, "Slope Threshold · Strong ($/lookback)",   step = 0.1, group = G_SLOPE)
cfg.slopeBonusFlat    := input.float(0.0, "Slope Bonus · Flat",     step = 0.5, group = G_SLOPE)
cfg.slopeBonusMod     := input.float(1.0, "Slope Bonus · Moderate", step = 0.5, group = G_SLOPE)
cfg.slopeBonusStr     := input.float(2.0, "Slope Bonus · Strong",   step = 0.5, group = G_SLOPE)
slopeBonusMode = input.string("Sum (per MA)", "Slope Bonus Aggregation in Cluster",
     options = ["Sum (per MA)", "Max"], group = G_SLOPE,
     tooltip = "同一Cluster内に2000MAと3000MAが両方入った場合、Slope Bonusを合算するか最大値のみ採用するか。")
cfg.slopeBonusMax     := slopeBonusMode == "Max"
cfg.maClusterDist     := input.float(20.0, "MA Cluster Distance ($)", step = 1.0, group = G_SLOPE)
cfg.maClusterBonus    := input.float(1.0, "MA Cluster Bonus",              step = 0.5, group = G_SLOPE)
cfg.maClusterDirBonus := input.float(1.0, "MA Cluster Bonus · Same Slope", step = 0.5, group = G_SLOPE)

// ---- 2.4 Horizontal Source -------------------------------------------------
var string G_HZ = "02 · Horizontal Source (Swing)"
cfg.useHzSource := input.bool(true, "Enable Horizontal Source", group = G_HZ)
hzTf1 = input.timeframe("5",  "Horizontal TF #1", group = G_HZ)
hzTf2 = input.timeframe("15", "Horizontal TF #2", group = G_HZ)
hzTf3 = input.timeframe("60", "Horizontal TF #3", group = G_HZ)
cfg.hzTf1 := hzTf1
cfg.hzTf2 := hzTf2
cfg.hzTf3 := hzTf3
pivLen1 = input.int(10, "Swing Pivot Length · TF #1", minval = 1, group = G_HZ)
pivLen2 = input.int(8,  "Swing Pivot Length · TF #2", minval = 1, group = G_HZ)
pivLen3 = input.int(6,  "Swing Pivot Length · TF #3", minval = 1, group = G_HZ)
cfg.scoreHz1 := input.float(1.0, "Base Score · TF #1 Swing", step = 0.5, group = G_HZ)
cfg.scoreHz2 := input.float(2.0, "Base Score · TF #2 Swing", step = 0.5, group = G_HZ)
cfg.scoreHz3 := input.float(3.0, "Base Score · TF #3 Swing", step = 0.5, group = G_HZ)

// ---- 2.5 Horizontal Reaction ----------------------------------------------
var string G_REACT = "02 · Horizontal Reaction"
cfg.reactionDist      := input.float(20.0, "Reaction Distance ($)", step = 0.5, group = G_REACT,
     tooltip = "Zoneに接触したあと、来た方向へこの距離以上戻ればReaction 1回。")
cfg.reactionBonus1    := input.float(1.0, "Reaction Bonus · 1 time",   step = 0.5, group = G_REACT)
cfg.reactionBonus2    := input.float(2.0, "Reaction Bonus · 2 times",  step = 0.5, group = G_REACT)
cfg.reactionBonus3    := input.float(3.0, "Reaction Bonus · 3+ times", step = 0.5, group = G_REACT)
cfg.reactionRearmDist := input.float(10.0, "Reaction Re-arm Distance ($)", step = 0.5, group = G_REACT)
cfg.reactionAllSrc    := input.bool(false, "Track Reaction on Accum / DayHL too", group = G_REACT)

// ---- 2.6 Day High / Low ----------------------------------------------------
var string G_DHL = "02 · Day High / Low"
cfg.useDayHL       := input.bool(true, "Enable Day High / Low Source", group = G_DHL)
dayTz        = input.string("Asia/Tokyo", "Day Session Timezone", group = G_DHL)
dayResetHour = input.int(5, "Day Reset Hour (取引日の開始時刻)", minval = 0, maxval = 23, group = G_DHL,
     tooltip = "既定 5 = 日本時間 05:00 ～ 翌 04:59 を1取引日として扱う。0 にすると暦日基準。")
cfg.scoreDayHL     := input.float(3.0, "Base Score · Day High / Low", step = 0.5, group = G_DHL)
cfg.carryPrevDayHL := input.bool(false, "Carry Previous Day H/L as Horizontal Zone", group = G_DHL)
cfg.scorePrevDayHL := input.float(2.0, "Base Score · Carried Prev Day H/L", step = 0.5, group = G_DHL)
cfg.lifePrevDayHL  := input.float(5.0, "Lifetime · Carried Prev Day H/L (days)", step = 1.0, group = G_DHL)

// ---- 2.7 Accumulation ------------------------------------------------------
var string G_ACC = "02 · Accumulation"
cfg.useAccSource := input.bool(true, "Enable Accumulation Source", group = G_ACC)
accumModule = input.string("Accum Box (ported)", "Accum Detection Module",
     options = ["Accum Box (ported)", "Provisional ATR (暫定)"], group = G_ACC)
accTf1 = input.timeframe("60",  "Accum TF #1", group = G_ACC)
accTf2 = input.timeframe("240", "Accum TF #2", group = G_ACC)
accTf3 = input.timeframe("D",   "Accum TF #3", group = G_ACC)
cfg.accTf1 := accTf1
cfg.accTf2 := accTf2
cfg.accTf3 := accTf3
cfg.scoreAcc1 := input.float(3.0, "Base Score · TF #1 Accum", step = 0.5, group = G_ACC)
cfg.scoreAcc2 := input.float(4.0, "Base Score · TF #2 Accum", step = 0.5, group = G_ACC)
cfg.scoreAcc3 := input.float(5.0, "Base Score · TF #3 Accum", step = 0.5, group = G_ACC)
cfg.accKeep1  := input.int(3, "Keep Count · TF #1 Accum (instances)", minval = 1, group = G_ACC)
cfg.accKeep2  := input.int(2, "Keep Count · TF #2 Accum (instances)", minval = 1, group = G_ACC)
cfg.accKeep3  := input.int(1, "Keep Count · TF #3 Accum (instances)", minval = 1, group = G_ACC)

var string G_ACCP = "02a · Accum Box (ported) Parameters"
accumRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = G_ACCP)
accumBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = G_ACCP)
accumAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = G_ACCP)
accumMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = G_ACCP)
accumMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = G_ACCP)
accumAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = G_ACCP)
accumBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = G_ACCP)
accumDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = G_ACCP)

var string G_ACCQ = "02b · Provisional ATR Accum (暫定・本番未使用)"
accLen1 = input.int(20, "[暫定] Accum Lookback · TF #1 (bars)", minval = 3, group = G_ACCQ)
accLen2 = input.int(20, "[暫定] Accum Lookback · TF #2 (bars)", minval = 3, group = G_ACCQ)
accLen3 = input.int(15, "[暫定] Accum Lookback · TF #3 (bars)", minval = 3, group = G_ACCQ)
accMult = input.float(1.2, "[暫定] Accum Max Range / ATR", step = 0.1, minval = 0.1, group = G_ACCQ)

// ---- 2.8 Cluster / Score / HTF --------------------------------------------
var string G_CLU = "02 · Cluster"
cfg.clusterDist := input.float(20.0, "Cluster Distance ($)", step = 1.0, group = G_CLU)

var string G_SCORE = "02 · Strength Score"
cfg.thrMedium  := input.float(5.0,  "Medium Score Threshold",      step = 0.5, group = G_SCORE)
cfg.thrStrong  := input.float(10.0, "Strong Score Threshold",      step = 0.5, group = G_SCORE)
cfg.thrVStrong := input.float(15.0, "Very Strong Score Threshold", step = 0.5, group = G_SCORE)
cfg.confBonus2 := input.float(1.0, "Confluence Bonus · 2 categories",  step = 0.5, group = G_SCORE)
cfg.confBonus3 := input.float(2.0, "Confluence Bonus · 3 categories",  step = 0.5, group = G_SCORE)
cfg.confBonus4 := input.float(3.0, "Confluence Bonus · 4+ categories", step = 0.5, group = G_SCORE)
cfg.flipBonus  := input.float(2.0, "Flip Bonus", step = 0.5, group = G_SCORE)

var string G_HTF = "02a · Very Strong · Higher TF Structure"
cfg.requireHtfForVStrong := input.bool(true, "Require Higher TF Structure for Very Strong", group = G_HTF)
cfg.htfSwing1H  := input.bool(true,  "Count 1H Swing (TF #3) as Higher TF",    group = G_HTF)
cfg.htfAccum1H  := input.bool(true,  "Count 1H Accum (TF #1) as Higher TF",    group = G_HTF)
cfg.htfAccum4H  := input.bool(true,  "Count 4H Accum (TF #2) as Higher TF",    group = G_HTF)
cfg.htfAccumD   := input.bool(true,  "Count Daily Accum (TF #3) as Higher TF", group = G_HTF)
cfg.htfSwing15M := input.bool(false, "Count 15M Swing (TF #2) as Higher TF",   group = G_HTF)
cfg.htfMa1      := input.bool(false, "Count MA #1 (2000) as Higher TF",        group = G_HTF)
cfg.htfMa2      := input.bool(false, "Count MA #2 (3000) as Higher TF",        group = G_HTF)
cfg.htfDayHL    := input.bool(false, "Count Day High / Low as Higher TF",      group = G_HTF)

// ---- 2.9 Break / Flip / Lifetime ------------------------------------------
var string G_BF = "02 · Break / Flip"
breakTf = input.timeframe("5", "Break Evaluation Timeframe", group = G_BF,
     tooltip = "Breakはヒゲではなくこの時間足の確定終値で判定する。")
cfg.breakBuffer     := input.float(5.0,  "Break Buffer ($)",         step = 0.5, group = G_BF)
cfg.flipConfirmDist := input.float(10.0, "Flip Confirm Distance ($)", step = 0.5, group = G_BF)
cfg.resetOnReclaim  := input.bool(true,  "Reset Broken on Reclaim", group = G_BF)
cfg.trackStaleBars  := input.int(500, "Zone State Retention (bars without match)", minval = 10, group = G_BF)
cfg.trackContinuity := input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_BF)

var string G_LIFE = "02 · Zone Lifetime"
cfg.lifeHz1         := input.float(5.0,  "Lifetime · TF #1 Horizontal (days)", step = 0.5, group = G_LIFE)
cfg.lifeHz2         := input.float(10.0, "Lifetime · TF #2 Horizontal (days)", step = 0.5, group = G_LIFE)
cfg.lifeHz3         := input.float(30.0, "Lifetime · TF #3 Horizontal (days)", step = 0.5, group = G_LIFE)
cfg.lifeExtendOn    := input.bool(true,  "Extend Lifetime on Reaction / Flip", group = G_LIFE)
cfg.lifeExtendRatio := input.float(0.5,  "Lifetime Extension Ratio", step = 0.1, minval = 0.0, group = G_LIFE)
cfg.maxPersistZones := input.int(200, "Max Persistent Raw Zones", minval = 20, maxval = 800, group = G_LIFE)

// ---- 2.10 Structural SL / TP ----------------------------------------------
var string G_SLTP = "02 · Structural SL / TP"
cfg.slBuffer     := input.float(5.0,  "SL Buffer ($)", step = 0.5, group = G_SLTP)
cfg.tpBuffer     := input.float(5.0,  "TP Buffer ($)", step = 0.5, group = G_SLTP)
cfg.maxSlDist    := input.float(30.0, "Max SL Distance ($)", step = 1.0, group = G_SLTP)
cfg.minStructRR  := input.float(1.0,  "Minimum Structural RR", step = 0.1, group = G_SLTP,
     tooltip = "Structural TPが存在する場合、この値未満のRRならエントリー禁止 (固定RR TPへ逃げない)。")
cfg.slMinScore   := input.float(4.0,  "SL Zone · Min Score", step = 0.5, group = G_SLTP)
slMinStrStr  = input.string("Medium", "SL Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
cfg.tpMinScore   := input.float(7.0,  "TP Zone · Min Score", step = 0.5, group = G_SLTP)
tpMinStrStr  = input.string("Strong", "TP Zone · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
obsMinStrStr = input.string("Medium", "Obstacle · Min Strength", options = ["Weak", "Medium", "Strong", "Very Strong"], group = G_SLTP)
cfg.slMinStrength  := zn.strengthIdx(slMinStrStr)
cfg.tpMinStrength  := zn.strengthIdx(tpMinStrStr)
cfg.obsMinStrength := zn.strengthIdx(obsMinStrStr)
cfg.fallbackRR   := input.float(2.0, "Fallback RR (Structural TPが無い場合のみ使用)", step = 0.1, minval = 0.1, group = G_SLTP,
     tooltip = "有効なTP Zoneが見つからない場合のみ、Structural SL距離 × この値でTPを作る。")

// ---- 2.11 Zone Display -----------------------------------------------------
var string G_DISP = "02 · Zone Display"
showZones     = input.bool(true,  "Show Zones (box)",          group = G_DISP)
showMaLines   = input.bool(true,  "Plot MA Source Lines",      group = G_DISP)
showLabels    = input.bool(true,  "Show Zone Labels",          group = G_DISP)
showDetailLbl = input.bool(false, "Detailed Labels (sources)", group = G_DISP)
maxZonesDraw  = input.int(30, "Max Zones Drawn", minval = 1, maxval = 120, group = G_DISP)
zoneLeftBars  = input.int(150, "Zone Box · Left Extension (bars)",  minval = 1, group = G_DISP)
zoneRightBars = input.int(30,  "Zone Box · Right Extension (bars)", minval = 1, group = G_DISP)
colSupport    = input.color(color.new(#26A69A, 0), "Color · Support",    group = G_DISP)
colResistance = input.color(color.new(#EF5350, 0), "Color · Resistance", group = G_DISP)
colActive     = input.color(color.new(#FFB300, 0), "Color · Active",     group = G_DISP)
colBroken     = input.color(color.new(#78909C, 0), "Color · Broken",     group = G_DISP)
trWeak        = input.int(90, "Transparency · Weak",        minval = 0, maxval = 100, group = G_DISP)
trMedium      = input.int(80, "Transparency · Medium",      minval = 0, maxval = 100, group = G_DISP)
trStrong      = input.int(68, "Transparency · Strong",      minval = 0, maxval = 100, group = G_DISP)
trVStrong     = input.int(55, "Transparency · Very Strong", minval = 0, maxval = 100, group = G_DISP)

var string G_DBG = "02 · Zone Debug"
showDebugTable = input.bool(true, "Show Zone Debug Table", group = G_DBG)
dbgPosStr      = input.string("Top Right", "Debug Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = G_DBG)
dbgNearestN    = input.int(3, "Nearest Zones per Side", minval = 1, maxval = 5, group = G_DBG)
dbgTextSize    = input.string("Small", "Debug Table Text Size", options = ["Tiny", "Small", "Normal"], group = G_DBG)

// ---- 2.12 外部足の取得 (Library は request.*() を呼べないためここで行う) ---
// ★ MA2000 / MA3000 : zn.maPack() を 1分足コンテキストで評価させる。
//   maPack() の中身は ta.ema(close, 2000) 等であり、この close は1分足のclose。
//   → 5分足closeからの再計算ではない。5分足側はその時点で利用可能な最新の
//     1分足MA値を受け取る (lookahead_off なので未来参照なし)。
[ma1Val, ma1Delta, ma2Val, ma2Delta] = request.security(syminfo.tickerid, maTf,
     zn.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)

[ph1, ph1T, pl1, pl1T] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
[ph2, ph2T, pl2, pl2T] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
[ph3, ph3T, pl3, pl3T] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)

bool usePortedAccum = accumModule == "Accum Box (ported)"
[acc1Hi, acc1Lo, acc1Id] = request.security(syminfo.tickerid, accTf1,
     zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
[acc2Hi, acc2Lo, acc2Id] = request.security(syminfo.tickerid, accTf2,
     zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
[acc3Hi, acc3Lo, acc3Id] = request.security(syminfo.tickerid, accTf3,
     zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
     accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)

// 取引日ID (分割前と同じ計算式)。
//  暦日を日単位の通し番号にしてから、ローカル時刻が dayResetHour より前なら前取引日へ。
//  月跨ぎ・年跨ぎでも連番になるので -1 が安全に効く。
int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

// Break判定は breakTf の「確定終値」のみ (ヒゲでは判定しない)
[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low],
     lookahead = barmerge.lookahead_off)
bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

// ---- 2.13 Zone Engine を1バー分更新 ---------------------------------------
zn.ZoneFeed feed = zn.ZoneFeed.new(
     ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T,
     ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id,
     acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id,
     dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)

int zoneCountNow = zn.update(eng, cfg, feed)

// ============================================================================
// 03. RISK / QTY
// ----------------------------------------------------------------------------
//  Qty は必ず Structural SL距離 から計算する。Long / Short 共通。
//     Risk Amount ÷ Structural SL距離 ÷ pointvalue → qtyStep 単位に切り下げ
//  目標: SL到達時の想定損失額 ≒ Risk Capital
// ============================================================================
f_riskCapital() =>
    (useCompound ? strategy.equity : strategy.initial_capital) * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? f_riskCapital() / (riskPerUnit * syminfo.pointvalue) : 0.0
    // qtyStep 単位へ切り下げ (0.01 等の小数ロットを潰さない)。
    // 浮動小数の誤差で 0.30000000000004 のような値にならないよう丸めておく。
    float q = qtyStep > 0 ? math.floor(raw / qtyStep) * qtyStep : raw
    math.round(q, 8)

// ============================================================================
// 04. COMMON TRADE ENGINE
// ----------------------------------------------------------------------------
//  Entry ID生成 / Qty計算 / 発注 / SL-TP固定 を一括で持つ唯一の場所。
//  Entry Module 側には strategy.entry / strategy.exit / SL計算 / TP計算 /
//  勝敗管理を一切書かない。
//
//  Entry ID 書式 : <LOGIC_ID>_L_<seq> / <LOGIC_ID>_S_<seq>
//     例 : FVG_L_1 / FVG_S_2 / EMA_REJECT_L_3 / MACD_L_5
//  → List of Trades からどのLogicのトレードか判別できる。
//  → 将来 strategy.closedtrades.entry_id() を接頭辞で振り分ければ
//     Logic別の勝率 / PF / 連敗 / Profit を後から追加できる。
// ============================================================================

var array<int> gSeq = array.new_int(1, 0)
var map<string, float> gTradeTP = map.new<string, float>()
var map<string, bool>  gTradeBE = map.new<string, bool>()
var array<string> gLastPlan = array.new_string(2, "-")

f_openCountForLogic(string logicId) =>
    int c = 0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string oid = strategy.opentrades.entry_id(i)
            // "<LOGIC>_L_" / "<LOGIC>_S_" で厳密に判定する (別Logicの前方一致を拾わない)
            if str.startswith(oid, logicId + "_L_") or str.startswith(oid, logicId + "_S_")
                c += 1
    c

f_planText(string logicId, zn.TradePlan p) =>
    logicId + " " + (p.dir > 0 ? "LONG" : p.dir < 0 ? "SHORT" : "-") +
     " | E " + f_num(p.entry, "#.##") +
     " | SL " + f_num(p.sl, "#.##") +
     " | TP " + f_num(p.tp, "#.##") +
     " | RR " + f_num(p.rr, "#.##") +
     " | " + p.tpType +
     " | Obst " + str.tostring(p.obstacles)

f_recordPlan(string logicId, zn.TradePlan p, string extra) =>
    array.set(gLastPlan, 0, f_planText(logicId, p))
    array.set(gLastPlan, 1, p.status + " · " + p.reason + (extra == "" ? "" : " · " + extra))
    true

// ★ ここが唯一 strategy.entry / strategy.exit を呼ぶ場所。
//   Entry時点の Structural SL / TP (または Fallback TP) を strategy.exit へ
//   渡して固定する。以後Zoneが動いても、そのトレードのSL/TPは変更しない。
f_executeTrade(string logicId, int dir, float entryPrice, zn.TradePlan p) =>
    string eid  = ""
    bool   done = false
    if dir != 0
        if not p.valid
            // Structural SL無し / RR不足 など → 発注しない (理由はDebugへ)
            f_recordPlan(logicId, p, "")
            done := true
        else
            float qty = f_qty(p.risk)
            bool oppositeConflict = not allowOppositeEntry and
                 ((dir > 0 and strategy.position_size < 0) or (dir < 0 and strategy.position_size > 0))
            bool logicFull = f_openCountForLogic(logicId) >= maxOpenPerLogic
            if logicFull
                f_recordPlan(logicId, p, "SKIP_LOGIC_LIMIT")
                done := true
            else if oppositeConflict
                f_recordPlan(logicId, p, "SKIP_OPPOSITE_POSITION")
                done := true
            else if qty < qtyMin or qty <= 0
                f_recordPlan(logicId, p, "SKIP_NO_QTY")
                done := true
            else
                int n = array.get(gSeq, 0) + 1
                array.set(gSeq, 0, n)
                eid := logicId + (dir > 0 ? "_L_" : "_S_") + str.tostring(n)
                strategy.entry(eid, dir > 0 ? strategy.long : strategy.short, qty = qty)
                // ★ Entry時点の SL / TP をここで固定する。以後Zoneが変化しても更新しない。
                strategy.exit(eid + "X", from_entry = eid, stop = p.sl, limit = p.tp,
                     comment_profit = "TP", comment_loss = "SL")
                if useBreakEven
                    gTradeTP.put(eid, p.tp)
                    gTradeBE.put(eid, false)
                f_recordPlan(logicId, p, eid)
                if showEntryLabel
                    string ltxt = eid + "\n" + (dir > 0 ? "LONG" : "SHORT")
                    ltxt := ltxt + "\nE  " + f_num(p.entry, "#.##")
                    ltxt := ltxt + "\nSL " + f_num(p.sl, "#.##")
                    ltxt := ltxt + "\nTP " + f_num(p.tp, "#.##")
                    ltxt := ltxt + "\nRR " + f_num(p.rr, "#.##")
                    ltxt := ltxt + "\nQty " + str.tostring(qty)
                    ltxt := ltxt + "\n" + p.tpType
                    label.new(bar_index, dir > 0 ? low : high, text = ltxt,
                         style = dir > 0 ? label.style_label_up : label.style_label_down,
                         color = dir > 0 ? color.new(color.teal, 20) : color.new(color.maroon, 20),
                         textcolor = color.white, size = size.small)
                done := true
    done ? eid : ""

// ---- Entry Signal → 発注 の共通パイプライン -------------------------------
//  Entry Module は logicId / signal / direction / entryPrice だけを渡す。
//  Zone Libraryへの問い合わせ → Structural SL確認 → Structural TP / Fallback TP
//  → RR確認 → Risk Qty計算 → strategy.entry → strategy.exit は全てここ。
f_submitSignal(string logicId, bool signal, int dir, float entryPrice) =>
    string eid = ""
    bool dirOk = (dir > 0 and enableLong) or (dir < 0 and enableShort)
    if signal and dirOk
        zn.TradePlan p = zn.buildPlan(eng, cfg, dir, entryPrice)
        p.logicId := logicId
        eid := f_executeTrade(logicId, dir, entryPrice, p)
    eid
// ============================================================================
// 05. ENTRY MODULE - FVG  (logicId = "FVG")
// ----------------------------------------------------------------------------
//  FVG Rebound Env Strategy の Entry Logic をそのまま移植したモジュール。
//    ・環境認識 (EMAトレンド) / FVG反発判定 / BOS / Trigger /
//      Volatility Filter / Session Filter / News Filter / Accum NoTrade /
//      Armed管理 / Trigger Cooldown  … すべて変更していない。
//    ・SL/TP計算・発注・勝敗管理は一切持たない。
//  このモジュールの出力は次の4つだけ:
//      LOGIC_FVG (logicId) / fvgLongSignal / fvgShortSignal / fvgEntryPrice
//  Zone / Structural SL / TP / Qty / 発注 には一切関与しない。
// ============================================================================

string LOGIC_FVG = "FVG"

// ---- 5.1 Inputs : エントリー / トリガー -----------------------------------
var string GF_ENT = "05 · FVG · Entry"
// ※ 方向のON/OFFは Section 01 の共通 enableLong / enableShort、
//    Logic自体のON/OFFは Section 01 の useFvgLogic を使う (旧 useLong / useShort は廃止)。
strictEngulf = input.bool(true,  "実体が前足を完全に包む", group = GF_ENT)
reqOppColor  = input.bool(true,  "前足が反対色であることを要求", group = GF_ENT)

var string GF_TRG = "05 · FVG · Trigger"
useEngulfingTrigger    = input.bool(false, "包み足", group = GF_TRG)
usePinbarTrigger       = input.bool(false, "ピンバー", group = GF_TRG)
useBOSTrigger          = input.bool(false, "BOS / 直近高安更新", group = GF_TRG)
useEMARejectTrigger    = input.bool(false, "EMAリジェクト", group = GF_TRG)
useFVGTriggerFormation = input.bool(false, "FVG形成", group = GF_TRG)
useStrongCandleTrigger = input.bool(false, "強ローソク", group = GF_TRG)

triggerMode     = input.string("Any", "トリガー結合", options = ["Any", "All", "MinCount"], group = GF_TRG)
minTriggerCount = input.int(1, "最低トリガー数 (MinCount時)", group = GF_TRG)

useLowerTFTrigger = input.bool(true, "1分足トリガーを使う", group = GF_TRG)
triggerTF         = input.timeframe("1", "トリガー時間足", group = GF_TRG)

emaLenTrigger      = input.int(20,  "EMA Length (EMAリジェクト)", group = GF_TRG)
useEMARejectSlopeFilter = input.bool(false, "EMAリジェクト 傾きフィルター", group = GF_TRG)
emaRejectSlopeLookback  = input.int(3, "EMAリジェクト 傾き判定本数", group = GF_TRG)
emaRejectSlopeMinATR    = input.float(0.12, "EMAリジェクト 最低傾き ATR倍率", group = GF_TRG)
emaRejectSlopeAtrLen    = input.int(14, "EMAリジェクト 傾きATR期間", group = GF_TRG)
bosLookback        = input.int(10,  "BOS Lookback", group = GF_TRG)
pinWickBodyMult    = input.float(3.0, "ピンバー ヒゲ/実体倍率", group = GF_TRG)
pinOppWickMaxRatio = input.float(2.0, "ピンバー 反対ヒゲ上限", group = GF_TRG)
usePinBodyRatioFilter = input.bool(false, "ピンバー 実体率フィルター", group = GF_TRG)
pinMaxBodyRatio       = input.float(0.1, "ピンバー 最大実体率", group = GF_TRG)
usePinRangeFilter     = input.bool(false, "ピンバー 最低レンジフィルター", group = GF_TRG)
pinRangeAtrLen        = input.int(14, "ピンバー ATR期間", group = GF_TRG)
pinMinRangeATR        = input.float(0.10, "ピンバー 最低レンジ ATR倍率", group = GF_TRG)
strongBodyRatio    = input.float(0.6, "強ローソク 実体率", group = GF_TRG)
trigCloseEdgeRatio = input.float(0.7, "ピン/強 終値端寄せ比率", group = GF_TRG)
useEngulfBodyRatioFilter   = input.bool(true, "包み足 包み込み率フィルター", group = GF_TRG)
engulfBodyRatioMin         = input.float(1.20, "包み足 最低包み込み率", group = GF_TRG)
useEngulfBodyQualityFilter = input.bool(true, "包み足 実体率フィルター", group = GF_TRG)
engulfMinBodyRatio         = input.float(0.60, "包み足 最低実体率", group = GF_TRG)
useEngulfBodyAtrFilter     = input.bool(true, "包み足 最低実体ATRフィルター", group = GF_TRG)
engulfAtrLen               = input.int(14, "包み足 ATR期間", group = GF_TRG)
engulfMinBodyATR           = input.float(0.30, "包み足 最低実体 ATR倍率", group = GF_TRG)

useTriggerCooldown        = input.bool(false, "トリガークールダウン", group = GF_TRG)
triggerCooldownBars       = input.int(3, "クールダウン本数", group = GF_TRG)
useOppositeTriggerNoTrade = input.bool(true, "逆方向トリガー同時発生はNoTrade", group = GF_TRG)

// ---- 5.2 Inputs : ボラフィルタ --------------------------------------------
var string GF_VOL = "05 · FVG · Volatility"
volMode  = input.string("OFF", "通常ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = GF_VOL)
fixedMin = input.float(1.0, "最低レンジ (価格・固定値)", group = GF_VOL)
atrLenBase   = input.int(14, "基準ATR本数", group = GF_VOL)
atrTf        = input.timeframe("", "基準ATR時間足(空=チャート)", group = GF_VOL)
useMinVol    = input.bool(true,  "低ボラ時はエントリー禁止", group = GF_VOL)
minAtrDollar = input.float(1.5,  "最低ATR($)", group = GF_VOL)
volModeRel   = input.bool(false, "低ボラ判定を相対ATRにする", group = GF_VOL)
volAvgLen    = input.int(480,    "ATR平均本数", group = GF_VOL)
volRatioMin  = input.float(0.9,  "ATR ÷ ATR平均 最低比", group = GF_VOL)
fastVolMode  = input.string("固定値", "高速ボラ (OFF/ATR/固定値)", options = ["OFF", "ATR", "固定値"], group = GF_VOL)
fastAtrLen   = input.int(5,      "fastATR/値幅 参照本数", group = GF_VOL)
fastAtrMin   = input.float(2.2,  "fastATR最低($) ※ATR時", group = GF_VOL)
fastFixedMin = input.float(10.0, "直近値幅 最低($) ※固定値時", group = GF_VOL)
bodyAvgLen   = input.int(5,      "実体平均本数", group = GF_VOL)
bodyAvgMin   = input.float(0.5,  "実体平均最低($)", group = GF_VOL)
useRangeRatioFilter = input.bool(true, "fastATR ÷ RangeWidth を使う ※ATR時", group = GF_VOL)
rangeLookback       = input.int(20,    "RangeWidth参照本数", group = GF_VOL)
atrRangeRatioMin    = input.float(0.06, "fastATR ÷ RangeWidth 最低比", group = GF_VOL)
useVolCooldown  = input.bool(false, "低ボラ解除後の待機を使う", group = GF_VOL)
volRecoveryBars = input.int(2,      "低ボラ解除後の待機本数", group = GF_VOL)

// ---- 5.3 Inputs : 環境フィルタ (EMAトレンド) ------------------------------
var string GF_ENV = "05 · FVG · Trend Env"
useEnvFilter = input.bool(true, "環境フィルタを使う (重い/OFFで軽量)", group = GF_ENV)
reqTrend4H  = input.string("上昇", "4H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf4", group = GF_ENV)
tf4H        = input.timeframe("240", "TF", inline = "tf4", group = GF_ENV)
reqTrend1H  = input.string("上昇", "1H 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1", group = GF_ENV)
tf1H        = input.timeframe("60",  "TF", inline = "tf1", group = GF_ENV)
reqTrend15M = input.string("上昇", "15M 要求", options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf15", group = GF_ENV)
tf15M       = input.timeframe("15",  "TF", inline = "tf15", group = GF_ENV)
reqTrend5M  = input.string("OFF", "5M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf5", group = GF_ENV)
tf5M        = input.timeframe("5",   "TF", inline = "tf5", group = GF_ENV)
reqTrend1M  = input.string("OFF", "1M 要求",  options = ["OFF", "上昇", "レンジ", "下降"], inline = "tf1m", group = GF_ENV)
tf1M        = input.timeframe("1",   "TF", inline = "tf1m", group = GF_ENV)

useEma20Above50Up   = input.bool(true, "1. EMA20 > EMA50", group = GF_ENV)
useEma20SlopeUp     = input.bool(true, "2. EMA20 が上向き", group = GF_ENV)
useEma50SlopeUp     = input.bool(true, "3. EMA50 が上向き", group = GF_ENV)
useCloseAboveEma50  = input.bool(true, "4. close > EMA50", group = GF_ENV)
useCloseAboveEma200 = input.bool(true, "5. close > EMA200", group = GF_ENV)
useEmaDistanceWideU = input.bool(true, "6. EMA20/50 距離が広い", group = GF_ENV)
useEmaExpansionU    = input.bool(true, "7. EMA20/50 が拡散中", group = GF_ENV)

useEma20Below50Dn   = input.bool(true, "1. EMA20 < EMA50", group = GF_ENV)
useEma20SlopeDown   = input.bool(true, "2. EMA20 が下向き", group = GF_ENV)
useEma50SlopeDown   = input.bool(true, "3. EMA50 が下向き", group = GF_ENV)
useCloseBelowEma50  = input.bool(true, "4. close < EMA50", group = GF_ENV)
useCloseBelowEma200 = input.bool(true, "5. close < EMA200", group = GF_ENV)
useEmaDistanceWideD = input.bool(true, "6. EMA20/50 距離が広い", group = GF_ENV)
useEmaExpansionD    = input.bool(true, "7. EMA20/50 が拡散中", group = GF_ENV)

useEmaDistanceNarrow = input.bool(true, "1. EMA20/50 距離が近い", group = GF_ENV)
useEma20SlopeWeak    = input.bool(true, "2. EMA20 の傾きが弱い", group = GF_ENV)
useEma50SlopeWeak    = input.bool(true, "3. EMA50 の傾きが弱い", group = GF_ENV)
useEmaCompression    = input.bool(true, "4. EMA20/50 が収束中", group = GF_ENV)
useEma20CrossCount   = input.bool(true, "5. 価格が EMA20 を一定回数跨ぐ", group = GF_ENV)
useEma50CrossCount   = input.bool(true, "6. 価格が EMA50 を一定回数跨ぐ", group = GF_ENV)
useRangeWidthSmall   = input.bool(true, "7. 高値安値幅が小さい", group = GF_ENV)

len20        = input.int(20,   "EMA20 length", group = GF_ENV)
len50        = input.int(50,   "EMA50 length", group = GF_ENV)
len200       = input.int(200,  "EMA200 length", group = GF_ENV)
envAtrLen    = input.int(14,   "環境ATR length", group = GF_ENV)
slopeBars    = input.int(3,    "EMA 傾き判定本数", group = GF_ENV)
slopeMinMult = input.float(0.15, "EMA 傾きの最低値 ATR倍率", group = GF_ENV)
distWideMult = input.float(0.50, "EMA20/50 距離 広い判定 ATR倍率", group = GF_ENV)
distNarrowMult = input.float(0.25, "EMA20/50 距離 近い判定 ATR倍率", group = GF_ENV)
convDivBars  = input.int(5,    "収束/拡散 判定本数", group = GF_ENV)
crossBars    = input.int(20,   "EMA跨ぎ回数 判定本数", group = GF_ENV)
crossMinCount = input.int(3,   "EMA跨ぎ回数 最低回数", group = GF_ENV)
rangeBars    = input.int(20,   "レンジ幅 判定本数", group = GF_ENV)
rangeMult    = input.float(1.5, "レンジ幅 ATR倍率", group = GF_ENV)

tieAsRange          = input.bool(true, "同点時にレンジ扱いする", group = GF_ENV)
insufficientAsRange = input.bool(true, "条件不足時にレンジ扱いする", group = GF_ENV)
minScore4H  = input.int(3, "4H 最低必要スコア", group = GF_ENV)
minScore1H  = input.int(3, "1H 最低必要スコア", group = GF_ENV)
minScore15M = input.int(3, "15M 最低必要スコア", group = GF_ENV)
minScore5M  = input.int(3, "5M 最低必要スコア", group = GF_ENV)
minScore1M  = input.int(3, "1M 最低必要スコア", group = GF_ENV)
reqMatchCount = input.int(0, "必要一致TF数 (0=有効な全TFが一致)", group = GF_ENV)

// ---- 5.4 Inputs : 日足レジーム --------------------------------------------
var string GF_DR = "05 · FVG · Daily Regime"
useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う", group = GF_DR)
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"], group = GF_DR)
reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"], group = GF_DR)
reqDailyVolatility = input.string("低ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = GF_DR)
dailyVolMedianLength  = input.int(10, "日足ボラ中央値期間", minval = 3, group = GF_DR)
dailyLowVolThreshold  = input.float(100.0, "低ボラ上限", group = GF_DR)
dailyHighVolThreshold = input.float(100.0, "高ボラ下限", group = GF_DR)
dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率", group = GF_DR)
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限", group = GF_DR)
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限", group = GF_DR)
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い", group = GF_DR)
showDailyVolDebug = input.bool(true, "日足ボラ中央値デバッグ表示", group = GF_DR)

// ---- 5.5 Inputs : Accumulation NoTrade ------------------------------------
var string GF_ACC = "05 · FVG · Accumulation NoTrade"
useAccumNoTrade = input.bool(true, "Accumulation NoTradeフィルターを使う", group = GF_ACC)
useAccumNT5M    = input.bool(true, "5分足Accumを使う",  group = GF_ACC)
useAccumNT15M   = input.bool(true, "15分足Accumを使う", group = GF_ACC)
accumNTKeep     = input.int(1, "保持するAccum数", minval = 1, maxval = 10, group = GF_ACC)
accumNT15Tf     = input.timeframe("15", "15分足TF", group = GF_ACC)
accumNTRangeLen        = input.int(10,   "Accum判定レンジ本数",  minval = 6,  group = GF_ACC)
accumNTBaseLen         = input.int(20,   "基準平均本数",         minval = 10, group = GF_ACC)
accumNTAtrLen          = input.int(14,   "ATR本数",             minval = 1,  group = GF_ACC)
accumNTMinUpperCloses  = input.int(4,    "上半分の最低終値本数",  minval = 1,  group = GF_ACC)
accumNTMinLowerCloses  = input.int(4,    "下半分の最低終値本数",  minval = 1,  group = GF_ACC)
accumNTMaxSameColorRun = input.int(4,    "同色連続の上限",       minval = 1,  group = GF_ACC)
accumNTAtrMult         = input.float(2.5,  "Accum レンジ幅 / ATR 上限",    minval = 0.5,  step = 0.1,  group = GF_ACC)
accumNTBarRatioMax     = input.float(0.70, "Accum 平均値幅/基準平均 上限", minval = 0.1,  step = 0.01, group = GF_ACC)
accumNTDriftMax        = input.float(0.30, "Accum ドリフト上限",          minval = 0.05, maxval = 1.0, step = 0.05, group = GF_ACC)
useAccumExitConfirm  = input.bool(false, "Accum離脱後の確認を使う", group = GF_ACC)
accumExitConfirmBars = input.int(2, "Accum離脱後の待機本数", minval = 1, maxval = 20, group = GF_ACC)
useAccumBreakDirection  = input.bool(true, "Accum離脱方向フィルターを使う", group = GF_ACC)
accumBreakDirectionBars = input.int(10, "Accum離脱方向の有効本数", minval = 1, maxval = 100, group = GF_ACC)

// ---- 5.6 Inputs : FVG 環境認識 --------------------------------------------
var string GF_EFVG = "05 · FVG · FVG Env"
useEFVGEnv = input.bool(true, "FVG環境認識を使う (重い/OFFで軽量)", group = GF_EFVG)
efvgCombineMode = input.string("TrendAndFVG", "トレンド環境との結合", options = ["TrendOnly", "FVGOnly", "TrendAndFVG", "TrendOrFVG"], group = GF_EFVG)
useEFVGDaily = input.bool(false, "日足FVGを使う", group = GF_EFVG)
useEFVG4H    = input.bool(false, "4時間足FVGを使う", group = GF_EFVG)
useEFVG1H    = input.bool(false, "1時間足FVGを使う", group = GF_EFVG)
useEFVG15M   = input.bool(false, "15分足FVGを使う", group = GF_EFVG)
useEFVG5M    = input.bool(true,  "5分足FVGを使う", group = GF_EFVG)
useEFVG1M    = input.bool(false, "1分足FVGを使う", group = GF_EFVG)
efvgDailyTF = input.timeframe("D",   "日足TF", group = GF_EFVG)
efvg4HTF    = input.timeframe("240", "4時間足TF", group = GF_EFVG)
efvg1HTF    = input.timeframe("60",  "1時間足TF", group = GF_EFVG)
efvg15MTF   = input.timeframe("15",  "15分足TF", group = GF_EFVG)
efvg5MTF    = input.timeframe("5",   "5分足TF", group = GF_EFVG)
efvg1MTF    = input.timeframe("1",   "1分足TF", group = GF_EFVG)
efvgHoldDaily = input.int(3,  "日足 状態保持本数",  minval = 1, group = GF_EFVG)
efvgHold4H    = input.int(6,  "4H 状態保持本数",   minval = 1, group = GF_EFVG)
efvgHold1H    = input.int(12, "1H 状態保持本数",   minval = 1, group = GF_EFVG)
efvgHold15M   = input.int(24, "15M 状態保持本数",  minval = 1, group = GF_EFVG)
efvgHold5M    = input.int(30, "5M 状態保持本数",   minval = 1, group = GF_EFVG)
efvgHold1M    = input.int(40, "1M 状態保持本数",   minval = 1, group = GF_EFVG)
efvgMinThick        = input.float(0.0,  "FVG最小厚み (幅/ATR)", step = 0.05, group = GF_EFVG)
reboundDepthMax     = input.float(0.70, "反発 最大侵入率 (FVG内部・幅比率)", minval = 0.0, step = 0.05, group = GF_EFVG)
reboundRecoverRatio = input.float(0.10, "反発 回復位置 (FVG幅比率)", minval = 0.0, maxval = 1.0, step = 0.05, group = GF_EFVG)
efvgIntegrationMode = input.string("WeightedScore", "統合方式", options = ["AllAgree", "MatchCount", "WeightedScore", "HTFPriority"], group = GF_EFVG)
efvgReqMatch  = input.int(3, "必要一致足数 (MatchCount時)", minval = 1, maxval = 6, group = GF_EFVG)
efvgWeightD   = input.int(6, "重み 日足",  minval = 0, group = GF_EFVG)
efvgWeight4H  = input.int(5, "重み 4H",   minval = 0, group = GF_EFVG)
efvgWeight1H  = input.int(4, "重み 1H",   minval = 0, group = GF_EFVG)
efvgWeight15M = input.int(3, "重み 15M",  minval = 0, group = GF_EFVG)
efvgWeight5M  = input.int(2, "重み 5M",   minval = 0, group = GF_EFVG)
efvgWeight1M  = input.int(1, "重み 1M",   minval = 0, group = GF_EFVG)
efvgScoreThresh = input.int(1, "スコア閾値 (±・WeightedScore時)", minval = 1, group = GF_EFVG)
efvgMode4Allow  = input.bool(false, "HTF優先時 下位逆行でもエントリー許可", group = GF_EFVG)
efvgShowTable = input.bool(true,  "FVG環境テーブルを表示", group = GF_EFVG)
efvgShowDebug = input.bool(false, "デバッグ(スコア/状態)を表示", group = GF_EFVG)

var string GF_BOS = "05 · FVG · 構造管理 BOS"
useFvgBosFilter = input.bool(true, "FVG反発にBOS方向フィルターを使う", group = GF_BOS)
fvgBosLookback  = input.int(5, "BOS Lookback", minval = 2, group = GF_BOS)
showFvgBosDebug = input.bool(false, "FVG構造BOS デバッグ表示", group = GF_BOS)

// ---- 5.7 包み足判定 --------------------------------------------------------
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ---- 5.8 エントリートリガー統合 -------------------------------------------
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    bool _bullTrigger = f_combineTrig(_bullCnt, enabledTrigCount)
    bool _bearTrigger = f_combineTrig(_bearCnt, enabledTrigCount)
    [_bullTrigger, _bearTrigger]

float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

bool oneMinBullTriggered = false
bool oneMinBearTriggered = false
if useLowerTFTrigger
    [bullTriggerArray, bearTriggerArray] = request.security_lower_tf(syminfo.tickerid, triggerTF, f_calcTriggers())
    if array.size(bullTriggerArray) > 0
        for i = 0 to array.size(bullTriggerArray) - 1
            if array.get(bullTriggerArray, i)
                oneMinBullTriggered := true
    if array.size(bearTriggerArray) > 0
        for i = 0 to array.size(bearTriggerArray) - 1
            if array.get(bearTriggerArray, i)
                oneMinBearTriggered := true
else
    oneMinBullTriggered := trigBullCur
    oneMinBearTriggered := trigBearCur

bool lowerTFConflict = oneMinBullTriggered and oneMinBearTriggered
bool trigNoTrade     = useOppositeTriggerNoTrade and lowerTFConflict

bool finalBullTrig = oneMinBullTriggered and not trigNoTrade
bool finalBearTrig = oneMinBearTriggered and not trigNoTrade

var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// ---- 5.9 ボラフィルタ判定 --------------------------------------------------
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin

bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk

bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ---- 5.10 環境(トレンド)判定 ----------------------------------------------
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

f_envTrendConfirmed(int minScore) =>
    int _t = f_envTrend(minScore)
    _t[1]

bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useEnvFilter
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrendConfirmed(minScore4H),  lookahead = barmerge.lookahead_on)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrendConfirmed(minScore1H),  lookahead = barmerge.lookahead_on)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrendConfirmed(minScore15M), lookahead = barmerge.lookahead_on)
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// ---- 5.11 FVG 環境認識 本体 -----------------------------------------------
//  戻り値 [bias, reason, remain, bosState]
//    bias : 1=Long優勢 / 0=Even / -1=Short優勢
f_efvgReboundState(int holdBars, float minThickR, float depthMax, float recoverRatio, bool useBos, int bosLen) =>
    float _ref = ta.atr(14)
    var float _btop = na
    var float _bbot = na
    var int   _bbar = na
    var bool  _bReb  = false
    var bool  _bDead = false
    var float _rtop = na
    var float _rbot = na
    var int   _rbar = na
    var bool  _rReb  = false
    var bool  _rDead = false
    var int   _bias   = 0
    var int   _reason = 0
    var int   _evbar  = na
    var int   _bosState = 0
    bool _fbBull = close > ta.highest(high, bosLen)[1]
    bool _fbBear = close < ta.lowest(low,  bosLen)[1]
    if _fbBull
        _bosState := 1
    if _fbBear
        _bosState := -1
    bool _newBull = _ref > 0 and low > high[2] and ((low - high[2]) / _ref) >= minThickR
    bool _newBear = _ref > 0 and high < low[2] and ((low[2] - high) / _ref) >= minThickR
    if _newBull
        _btop := low
        _bbot := high[2]
        _bbar := bar_index
        _bReb := false
        _bDead := false
    if _newBear
        _rtop := low[2]
        _rbot := high
        _rbar := bar_index
        _rReb := false
        _rDead := false
    if not na(_bbot) and close <= _bbot
        _bDead := true
    if not na(_rtop) and close >= _rtop
        _rDead := true
    float _bWidth = (not na(_btop) and not na(_bbot)) ? _btop - _bbot : na
    float _rWidth = (not na(_rtop) and not na(_rbot)) ? _rtop - _rbot : na
    float _bPen = (not na(_bWidth) and _bWidth > 0) ? (_btop - low) / _bWidth : na
    float _rPen = (not na(_rWidth) and _rWidth > 0) ? (high - _rbot) / _rWidth : na
    bool _rebLong  = not na(_btop) and not _bReb and not _bDead and bar_index > _bbar and not na(_bWidth) and _bWidth > 0 and low <= _btop and _bPen <= depthMax and close >= _bbot + _bWidth * recoverRatio and close > open
    bool _rebShort = not na(_rtop) and not _rReb and not _rDead and bar_index > _rbar and not na(_rWidth) and _rWidth > 0 and high >= _rbot and _rPen <= depthMax and close <= _rtop - _rWidth * recoverRatio and close < open
    bool _longAllowed  = not useBos or _bosState != -1
    bool _shortAllowed = not useBos or _bosState !=  1
    if _rebLong and _rebShort
        _bias := 0
        _reason := 0
        _evbar := na
        _bReb := true
        _rReb := true
    else if _rebLong
        _bReb := true
        if _longAllowed
            _bias := 1
            _reason := 1
            _evbar := bar_index
    else if _rebShort
        _rReb := true
        if _shortAllowed
            _bias := -1
            _reason := -1
            _evbar := bar_index
    bool _active = not na(_evbar) and (bar_index - _evbar) < holdBars
    int _outBias   = _active ? _bias : 0
    int _outReason = _active ? _reason : 0
    int _outRemain = _active ? holdBars - (bar_index - _evbar) : 0
    [_outBias, _outReason, _outRemain, _bosState]

f_efvgReboundConfirmed(int holdBars, float minThickR, float depthMax, float recoverRatio, bool useBos, int bosLen) =>
    [_b, _r, _rem, _bos] = f_efvgReboundState(holdBars, minThickR, depthMax, recoverRatio, useBos, bosLen)
    [_b[1], _r[1], _rem[1], _bos[1]]

f_efvgBiasText(int b) =>
    b == 1 ? "LONG" : b == -1 ? "SHORT" : "EVEN"
f_efvgReasonText(int c) =>
    c == 1 ? "Bullish FVG Rebound" : c == -1 ? "Bearish FVG Rebound" : "No Rebound"

int efvgDBias = 0
int efvgDReason = 0
int efvgDRem = 0
int efvgHBias = 0
int efvgHReason = 0
int efvgHRem = 0
int efvgOBias = 0
int efvgOReason = 0
int efvgORem = 0
int efvgMBias = 0
int efvgMReason = 0
int efvgMRem = 0
int efvg5Bias = 0
int efvg5Reason = 0
int efvg5Rem = 0
int efvg1Bias = 0
int efvg1Reason = 0
int efvg1Rem = 0
int efvgDBos = 0
int efvgHBos = 0
int efvgOBos = 0
int efvgMBos = 0
int efvg5Bos = 0
int efvg1Bos = 0

if useEFVGEnv and useEFVGDaily
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvgDailyTF, f_efvgReboundConfirmed(efvgHoldDaily, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgDBias := _b
    efvgDReason := _r
    efvgDRem := _rem
    efvgDBos := _bos
if useEFVGEnv and useEFVG4H
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg4HTF, f_efvgReboundConfirmed(efvgHold4H, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgHBias := _b
    efvgHReason := _r
    efvgHRem := _rem
    efvgHBos := _bos
if useEFVGEnv and useEFVG1H
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg1HTF, f_efvgReboundConfirmed(efvgHold1H, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgOBias := _b
    efvgOReason := _r
    efvgORem := _rem
    efvgOBos := _bos

// 5M : 15M FVG のゲートにも 5M BOS を使うため、必要なら1回だけ取得する。
bool need5MState = useEFVGEnv and (useEFVG5M or (useEFVG15M and useFvgBosFilter))
if need5MState
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg5MTF, f_efvgReboundConfirmed(efvgHold5M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvg5Bias := _b
    efvg5Reason := _r
    efvg5Rem := _rem
    efvg5Bos := _bos

// 15M : FVG判定は15Mのまま。反発ゲートだけ 5M BOS を参照する (このTFだけの特別対応)。
var int m15GateBias   = 0
var int m15PrevReason = 0
var int m15PrevRem    = 0
if useEFVGEnv and useEFVG15M
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg15MTF, f_efvgReboundConfirmed(efvgHold15M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, false, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgMBos := _bos
    bool _m15NewEvent = _r != 0 and (_r != m15PrevReason or _rem > m15PrevRem)
    if _m15NewEvent
        bool _allowL = not useFvgBosFilter or efvg5Bos != -1
        bool _allowS = not useFvgBosFilter or efvg5Bos !=  1
        m15GateBias := _r == 1 ? (_allowL ? 1 : 0) : _r == -1 ? (_allowS ? -1 : 0) : 0
    if _b == 0
        m15GateBias := 0
    if useFvgBosFilter
        if m15GateBias == 1 and efvg5Bos == -1
            m15GateBias := 0
        if m15GateBias == -1 and efvg5Bos == 1
            m15GateBias := 0
    m15PrevReason := _r
    m15PrevRem := _rem
    efvgMBias := m15GateBias
    efvgMReason := m15GateBias != 0 ? _r : 0
    efvgMRem := m15GateBias != 0 ? _rem : 0

if useEFVGEnv and useEFVG1M
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg1MTF, f_efvgReboundConfirmed(efvgHold1M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvg1Bias := _b
    efvg1Reason := _r
    efvg1Rem := _rem
    efvg1Bos := _bos

int efvgEnabledCount = (useEFVGDaily ? 1 : 0) + (useEFVG4H ? 1 : 0) + (useEFVG1H ? 1 : 0) + (useEFVG15M ? 1 : 0) + (useEFVG5M ? 1 : 0) + (useEFVG1M ? 1 : 0)
bool efvgAllLong  = efvgEnabledCount > 0 and (not useEFVGDaily or efvgDBias == 1) and (not useEFVG4H or efvgHBias == 1) and (not useEFVG1H or efvgOBias == 1) and (not useEFVG15M or efvgMBias == 1) and (not useEFVG5M or efvg5Bias == 1) and (not useEFVG1M or efvg1Bias == 1)
bool efvgAllShort = efvgEnabledCount > 0 and (not useEFVGDaily or efvgDBias == -1) and (not useEFVG4H or efvgHBias == -1) and (not useEFVG1H or efvgOBias == -1) and (not useEFVG15M or efvgMBias == -1) and (not useEFVG5M or efvg5Bias == -1) and (not useEFVG1M or efvg1Bias == -1)
int efvgLongCnt  = (useEFVGDaily and efvgDBias == 1 ? 1 : 0) + (useEFVG4H and efvgHBias == 1 ? 1 : 0) + (useEFVG1H and efvgOBias == 1 ? 1 : 0) + (useEFVG15M and efvgMBias == 1 ? 1 : 0) + (useEFVG5M and efvg5Bias == 1 ? 1 : 0) + (useEFVG1M and efvg1Bias == 1 ? 1 : 0)
int efvgShortCnt = (useEFVGDaily and efvgDBias == -1 ? 1 : 0) + (useEFVG4H and efvgHBias == -1 ? 1 : 0) + (useEFVG1H and efvgOBias == -1 ? 1 : 0) + (useEFVG15M and efvgMBias == -1 ? 1 : 0) + (useEFVG5M and efvg5Bias == -1 ? 1 : 0) + (useEFVG1M and efvg1Bias == -1 ? 1 : 0)
bool efvgCntLong  = efvgLongCnt  >= efvgReqMatch
bool efvgCntShort = efvgShortCnt >= efvgReqMatch
int efvgScore = (useEFVGDaily ? efvgWeightD * efvgDBias : 0) + (useEFVG4H ? efvgWeight4H * efvgHBias : 0) + (useEFVG1H ? efvgWeight1H * efvgOBias : 0) + (useEFVG15M ? efvgWeight15M * efvgMBias : 0) + (useEFVG5M ? efvgWeight5M * efvg5Bias : 0) + (useEFVG1M ? efvgWeight1M * efvg1Bias : 0)
bool efvgScoreLong  = efvgScore >= efvgScoreThresh
bool efvgScoreShort = efvgScore <= -efvgScoreThresh
int efvgHtfScore = (useEFVGDaily ? efvgWeightD * efvgDBias : 0) + (useEFVG4H ? efvgWeight4H * efvgHBias : 0)
int efvgHtfDir = efvgHtfScore > 0 ? 1 : efvgHtfScore < 0 ? -1 : 0
bool efvgLoConflictLong  = (useEFVG1H and efvgOBias == -1) or (useEFVG15M and efvgMBias == -1) or (useEFVG5M and efvg5Bias == -1) or (useEFVG1M and efvg1Bias == -1)
bool efvgLoConflictShort = (useEFVG1H and efvgOBias == 1) or (useEFVG15M and efvgMBias == 1) or (useEFVG5M and efvg5Bias == 1) or (useEFVG1M and efvg1Bias == 1)
bool efvgHtfLong  = efvgHtfDir == 1 and (efvgMode4Allow or not efvgLoConflictLong)
bool efvgHtfShort = efvgHtfDir == -1 and (efvgMode4Allow or not efvgLoConflictShort)
bool efvgBiasLong =
     efvgIntegrationMode == "AllAgree"     ? efvgAllLong :
     efvgIntegrationMode == "MatchCount"   ? efvgCntLong :
     efvgIntegrationMode == "WeightedScore" ? efvgScoreLong :
     efvgHtfLong
bool efvgBiasShort =
     efvgIntegrationMode == "AllAgree"     ? efvgAllShort :
     efvgIntegrationMode == "MatchCount"   ? efvgCntShort :
     efvgIntegrationMode == "WeightedScore" ? efvgScoreShort :
     efvgHtfShort
int efvgFinalBias = efvgBiasLong and not efvgBiasShort ? 1 : efvgBiasShort and not efvgBiasLong ? -1 : 0

bool efvgTrendOk = not useEnvFilter or allowByEnv
bool finalEnvLongOk =
     not useEFVGEnv ? efvgTrendOk :
     efvgCombineMode == "TrendOnly"   ? efvgTrendOk :
     efvgCombineMode == "FVGOnly"     ? efvgBiasLong :
     efvgCombineMode == "TrendAndFVG" ? (efvgTrendOk and efvgBiasLong) :
     (efvgTrendOk or efvgBiasLong)
bool finalEnvShortOk =
     not useEFVGEnv ? efvgTrendOk :
     efvgCombineMode == "TrendOnly"   ? efvgTrendOk :
     efvgCombineMode == "FVGOnly"     ? efvgBiasShort :
     efvgCombineMode == "TrendAndFVG" ? (efvgTrendOk and efvgBiasShort) :
     (efvgTrendOk or efvgBiasShort)

// ---- 5.12 日足レジームフィルター ------------------------------------------
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

f_drDailyTuple() =>
    [open, high, low, close, open[1], high[1], low[1], close[1]]

bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drMedianRange = na

bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _o1, _h1, _l1, _c1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    drMedianRange := request.security(syminfo.tickerid, "D", ta.median(high - low, dailyVolMedianLength)[1], lookahead = barmerge.lookahead_on)

    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)

    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    bool drDirInsufficient = na(drDirCode)
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode

    int drVolCode = na
    if not na(drMedianRange)
        drVolCode := drMedianRange >= dailyHighVolThreshold ? 1 : drMedianRange < dailyLowVolThreshold ? -1 : 0
    bool drVolInsufficient = na(drVolCode)
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock)

bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ---- 5.13 Accumulation NoTrade フィルター ---------------------------------
f_accumNTDetect() =>
    _atr       = ta.atr(accumNTAtrLen)
    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, accumNTRangeLen)
    _rangeLow  = ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to accumNTRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    _startMid = (open[accumNTRangeLen - 1] + close[accumNTRangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)
    _condAtr    = _atr > 0 and _rangeNow <= _atr * accumNTAtrMult
    _rangeShort = ta.highest(_bodyTop, accumNTRangeLen) - ta.lowest(_bodyBot, accumNTRangeLen)
    _rangeBase  = ta.highest(_bodyTop, accumNTBaseLen)  - ta.lowest(_bodyBot, accumNTBaseLen)
    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * accumNTBarRatioMax
    _condBalance  = _upperCloses >= accumNTMinUpperCloses and _lowerCloses >= accumNTMinLowerCloses
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= accumNTDriftMax
    _condColorRun = _maxBullRun <= accumNTMaxSameColorRun and _maxBearRun <= accumNTMaxSameColorRun
    bool _isAccum = _condAtr and _condBar and _condBalance and _condDrift and _condColorRun
    float _hi = ta.highest(math.max(open, close), accumNTRangeLen)
    float _lo = ta.lowest(math.min(open, close),  accumNTRangeLen)
    [_isAccum, _hi, _lo]

f_accumNT15() =>
    [_isA, _hi, _lo] = f_accumNTDetect()
    var float _bxHi = na
    var float _bxLo = na
    var int   _bxSt = na
    bool _start = _isA and not nz(_isA[1], false)
    if _start
        _bxHi := _hi
        _bxLo := _lo
        _bxSt := bar_index
    if _isA
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        _bxHi := math.max(nz(_bxHi, _bt), _bt)
        _bxLo := math.min(nz(_bxLo, _bb), _bb)
    [_isA, _bxHi, _bxLo, _bxSt]

f_accumNT15Confirmed() =>
    [_isA, _bxHi, _bxLo, _bxSt] = f_accumNT15()
    [_bxHi[1], _bxLo[1], _bxSt[1]]

var array<float> accNT5Hi  = array.new_float()
var array<float> accNT5Lo  = array.new_float()
var array<int>   accNT5St  = array.new_int()
var array<float> accNT15Hi = array.new_float()
var array<float> accNT15Lo = array.new_float()
var array<int>   accNT15St = array.new_int()
var float accNT5BoxHi = na
var float accNT5BoxLo = na
var int   accNT5BoxSt = na
var bool  accNT5Prev  = false
var int   accNT15LastSt = na

bool insideAccum5M  = false
bool insideAccum15M = false

if useAccumNoTrade and useAccumNT5M
    [isA5, hi5, lo5] = f_accumNTDetect()
    bool start5 = isA5 and not accNT5Prev
    accNT5Prev := isA5
    if start5
        accNT5BoxHi := hi5
        accNT5BoxLo := lo5
        accNT5BoxSt := bar_index
        array.push(accNT5Hi, accNT5BoxHi)
        array.push(accNT5Lo, accNT5BoxLo)
        array.push(accNT5St, accNT5BoxSt)
        while array.size(accNT5St) > accumNTKeep
            array.shift(accNT5Hi)
            array.shift(accNT5Lo)
            array.shift(accNT5St)
    if isA5
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        accNT5BoxHi := math.max(nz(accNT5BoxHi, _bt), _bt)
        accNT5BoxLo := math.min(nz(accNT5BoxLo, _bb), _bb)
        if array.size(accNT5St) > 0
            array.set(accNT5Hi, array.size(accNT5Hi) - 1, accNT5BoxHi)
            array.set(accNT5Lo, array.size(accNT5Lo) - 1, accNT5BoxLo)
    if array.size(accNT5St) > 0
        for i = 0 to array.size(accNT5St) - 1
            if close >= array.get(accNT5Lo, i) and close <= array.get(accNT5Hi, i)
                insideAccum5M := true

if useAccumNoTrade and useAccumNT15M
    [bxHi15, bxLo15, bxSt15] = request.security(syminfo.tickerid, accumNT15Tf, f_accumNT15Confirmed(), lookahead = barmerge.lookahead_on)
    bool new15Bar = ta.change(time(accumNT15Tf)) != 0
    if new15Bar
        if not na(bxSt15) and bxSt15 != accNT15LastSt
            array.push(accNT15Hi, bxHi15)
            array.push(accNT15Lo, bxLo15)
            array.push(accNT15St, bxSt15)
            accNT15LastSt := bxSt15
            while array.size(accNT15St) > accumNTKeep
                array.shift(accNT15Hi)
                array.shift(accNT15Lo)
                array.shift(accNT15St)
        else if array.size(accNT15St) > 0 and not na(bxSt15) and bxSt15 == accNT15LastSt
            array.set(accNT15Hi, array.size(accNT15Hi) - 1, bxHi15)
            array.set(accNT15Lo, array.size(accNT15Lo) - 1, bxLo15)
    if array.size(accNT15St) > 0
        for i = 0 to array.size(accNT15St) - 1
            if close >= array.get(accNT15Lo, i) and close <= array.get(accNT15Hi, i)
                insideAccum15M := true

bool blockedByAccum = useAccumNoTrade and ((useAccumNT5M and insideAccum5M) or (useAccumNT15M and insideAccum15M))

var bool waitingAccumExitConfirm  = false
var int  accumOutsideConfirmCount = 0

bool exitedAccumThisBar =
     useAccumNoTrade and
     nz(blockedByAccum[1], false) and
     not blockedByAccum

if not useAccumNoTrade or not useAccumExitConfirm
    waitingAccumExitConfirm  := false
    accumOutsideConfirmCount := 0
else
    if blockedByAccum
        waitingAccumExitConfirm  := false
        accumOutsideConfirmCount := 0
    else if exitedAccumThisBar
        waitingAccumExitConfirm  := true
        accumOutsideConfirmCount := 0
    else if waitingAccumExitConfirm
        accumOutsideConfirmCount += 1
    if waitingAccumExitConfirm and accumOutsideConfirmCount >= accumExitConfirmBars
        waitingAccumExitConfirm := false

bool blockedByAccumExitWait =
     useAccumNoTrade and
     useAccumExitConfirm and
     waitingAccumExitConfirm

var int  accumBreakDirection         = 0
var int  accumBreakDirectionStartBar = na
var bool accumBreakDirectionActive   = false

if not useAccumNoTrade or not useAccumBreakDirection
    accumBreakDirection         := 0
    accumBreakDirectionStartBar := na
    accumBreakDirectionActive   := false
else
    if blockedByAccum
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false
    else if exitedAccumThisBar
        bool brokeUp   = false
        bool brokeDown = false
        if useAccumNT5M and array.size(accNT5St) > 0
            for i = 0 to array.size(accNT5St) - 1
                float _bh = array.get(accNT5Hi, i)
                float _bl = array.get(accNT5Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if useAccumNT15M and array.size(accNT15St) > 0
            for i = 0 to array.size(accNT15St) - 1
                float _bh = array.get(accNT15Hi, i)
                float _bl = array.get(accNT15Lo, i)
                bool _wasInside = close[1] >= _bl and close[1] <= _bh
                if _wasInside and close > _bh
                    brokeUp := true
                if _wasInside and close < _bl
                    brokeDown := true
        if brokeUp and not brokeDown
            accumBreakDirection         := 1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else if brokeDown and not brokeUp
            accumBreakDirection         := -1
            accumBreakDirectionStartBar := bar_index
            accumBreakDirectionActive   := true
        else
            accumBreakDirection         := 0
            accumBreakDirectionStartBar := na
            accumBreakDirectionActive   := false
    if accumBreakDirectionActive and not na(accumBreakDirectionStartBar) and (bar_index - accumBreakDirectionStartBar > accumBreakDirectionBars)
        accumBreakDirection         := 0
        accumBreakDirectionStartBar := na
        accumBreakDirectionActive   := false

bool accumLongDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == 1
bool accumShortDirectionOk =
     not useAccumNoTrade or
     not useAccumBreakDirection or
     not accumBreakDirectionActive or
     accumBreakDirection == -1

// ---- 5.14 FVG Entry Signal (このモジュールの唯一の出力) -------------------
//  ★ SL / TP / Qty / 発注はここでは一切扱わない。
//    「エントリー条件が成立した」という情報だけを Section 08 へ渡す。
bool longMajorOk =
     dailyRegimeLongOk and
     sessionOk and
     allowByNewsTime and
     finalEnvLongOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumLongDirectionOk
bool shortMajorOk =
     dailyRegimeShortOk and
     sessionOk and
     allowByNewsTime and
     finalEnvShortOk and
     volOk and
     not blockedByAccum and
     not blockedByAccumExitWait and
     accumShortDirectionOk

bool baseLongCondition  = barstate.isconfirmed and useFvgLogic and enableLong  and longMajorOk
bool baseShortCondition = barstate.isconfirmed and useFvgLogic and enableShort and shortMajorOk

bool noTriggerMode = enabledTrigCount == 0

// Armed管理 (トリガーOFF時: 主要条件の立ち上がりで1回だけ)
var bool longArmed  = true
var bool shortArmed = true
if not longMajorOk
    longArmed := true
if not shortMajorOk
    shortArmed := true

bool noTriggerLongSignal  = noTriggerMode and baseLongCondition  and longArmed
bool noTriggerShortSignal = noTriggerMode and baseShortCondition and shortArmed

bool triggerLongSignal  = not noTriggerMode and baseLongCondition  and finalBullTrig and trigCooldownOk
bool triggerShortSignal = not noTriggerMode and baseShortCondition and finalBearTrig and trigCooldownOk

bool fvgLongRaw  = noTriggerMode ? noTriggerLongSignal  : triggerLongSignal
bool fvgShortRaw = noTriggerMode ? noTriggerShortSignal : triggerShortSignal

// 同一機会でロング/ショートが同時成立した場合はローソク色で優先方向を決定 (従来どおり)
bool fvgLongSignal  = fvgLongRaw
bool fvgShortSignal = fvgShortRaw
if fvgLongSignal and fvgShortSignal
    if close >= open
        fvgShortSignal := false
    else
        fvgLongSignal := false

float fvgEntryPrice = close

// ============================================================================
// 06. FUTURE ENTRY MODULES
// ----------------------------------------------------------------------------
//  新しいEntry Logicを追加するときに触るのはこのセクションと Section 07 だけ。
//  Zone Engine Library / Structural SL / TP / Trade Engine は変更不要。
//
//  追加手順は4つだけ:
//    ① Section 01 の Logic ON/OFF に  useXxxLogic = input.bool(...)  を1行
//    ② このセクションに input を書く              (5〜20行)
//    ③ このセクションで Entry Signal を判定する    (5〜40行)
//    ④ Section 07 で f_submitSignal() へ渡す      (2行)
//
//  ---- テンプレート (EMA Reject の例) ----------------------------------------
//  string LOGIC_EMA = "EMA_REJECT"
//  var string GE = "06 · EMA Reject"
//  emaRejLen = input.int(20, "EMA Length", group = GE)
//  //  ③ Entry Signal (SL/TP/Qty/発注は書かない)
//  float _emaRej = ta.ema(close, emaRejLen)
//  bool emaLongSignal  = useEmaLogic and barstate.isconfirmed and sessionOk and
//                        low <= _emaRej and close > _emaRej and close > open
//  bool emaShortSignal = useEmaLogic and barstate.isconfirmed and sessionOk and
//                        high >= _emaRej and close < _emaRej and close < open
//  float emaEntryPrice = close
//  //  ④ Section 07 へ:
//  //     f_submitSignal(LOGIC_EMA, emaLongSignal,  1, emaEntryPrice)
//  //     f_submitSignal(LOGIC_EMA, emaShortSignal, -1, emaEntryPrice)
//  ---------------------------------------------------------------------------
//  ・logicId は Entry ID の接頭辞になる (EMA_REJECT_L_7 など)。
//  ・maxOpenPerLogic は logicId 単位で独立に効くため、
//    他Logicが保有中でも新Logicはエントリーできる。
//  ・enableLong / enableShort は共通Trade Engine側で自動的に効く。
//  ・各Logicが独自の再アーム条件を持ちたい場合は、そのLogicのSignal判定内で
//    完結させること (Trade Engineは関与しない)。
// ============================================================================

// ============================================================================
// 07. ORDER EXECUTION
// ----------------------------------------------------------------------------
//  各Entry Module の Signal を共通Trade Engineへ渡すだけ。
//  ここには SL / TP / RR / Qty の計算を一切書かない。
//
//  同じバーで複数Logicが成立しても、それぞれ独立したEntry IDで発注されるため
//  完全に別トレードとして扱われる (勝敗も別)。
// ============================================================================

// ---- 7.1 FVG Logic ---------------------------------------------------------
string fvgEidLong  = f_submitSignal(LOGIC_FVG, fvgLongSignal,   1, fvgEntryPrice)
string fvgEidShort = f_submitSignal(LOGIC_FVG, fvgShortSignal, -1, fvgEntryPrice)

// FVG Logic 固有の再アーム解除 (トリガーOFFモード時のみ・実際に発注できた時だけ)
if noTriggerMode and fvgEidLong != ""
    longArmed := false
if noTriggerMode and fvgEidShort != ""
    shortArmed := false

// ---- 7.2 Future Logic (追加例) ---------------------------------------------
//  f_submitSignal(LOGIC_EMA, emaLongSignal,  1, emaEntryPrice)
//  f_submitSignal(LOGIC_EMA, emaShortSignal, -1, emaEntryPrice)

// ============================================================================
// 08. BREAK EVEN
// ----------------------------------------------------------------------------
//  Entry ID 単位で管理。既定OFF。
//  ONの場合も TP は Entry時点で固定した値 (gTradeTP) をそのまま再指定する。
// ============================================================================
if useBreakEven and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string eid = strategy.opentrades.entry_id(i)
        if gTradeTP.contains(eid)
            float ep     = strategy.opentrades.entry_price(i)
            bool  isLong = strategy.opentrades.size(i) > 0
            bool  wasOn  = gTradeBE.contains(eid) and gTradeBE.get(eid)
            bool  reach  = false
            if isLong
                reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close >= ep + breakEvenTrigger) : (high >= ep + breakEvenTrigger)
            else
                reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close <= ep - breakEvenTrigger) : (low <= ep - breakEvenTrigger)
            if wasOn or reach
                gTradeBE.put(eid, true)
                strategy.exit(eid + "X", from_entry = eid, stop = ep, limit = gTradeTP.get(eid),
                     comment_loss = "BE", comment_profit = "TP")

// ============================================================================
// 09. DISPLAY / DEBUG
// ----------------------------------------------------------------------------
//  表示は全てON/OFF可能。ロジックには一切影響しない。
//  Zoneの中身は Library のアクセサ (zn.zoneAt / zn.nearestIdx / zn.drawOrder)
//  経由で読む。
// ============================================================================

// ---- 9.1 Zone 描画 ---------------------------------------------------------
var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()

f_clearDrawings() =>
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    while array.size(gLabels) > 0
        label.delete(array.pop(gLabels))
    true

f_zoneColor(int st) =>
    st == ST_SUPPORT ? colSupport : st == ST_RESIST ? colResistance : st == ST_ACTIVE ? colActive : colBroken

f_zoneTransp(int strength) =>
    strength == SR_VSTRONG ? trVStrong : strength == SR_STRONG ? trStrong : strength == SR_MEDIUM ? trMedium : trWeak

if barstate.islast
    f_clearDrawings()
    if showZones and zn.zoneCount(eng) > 0
        array<int> ord = zn.drawOrder(eng, maxZonesDraw)
        if array.size(ord) > 0
            for k = 0 to array.size(ord) - 1
                zn.Zone z = zn.zoneAt(eng, array.get(ord, k))
                color bc = f_zoneColor(z.state)
                int   tr = f_zoneTransp(z.strength)
                box b = box.new(
                     left         = bar_index - zoneLeftBars,
                     top          = z.top,
                     right        = bar_index + zoneRightBars,
                     bottom       = z.bottom,
                     bgcolor      = color.new(bc, tr),
                     border_color = color.new(bc, math.max(tr - 30, 0)),
                     border_width = z.strength >= SR_STRONG ? 2 : 1,
                     border_style = z.state == ST_BROKEN ? line.style_dashed : line.style_solid,
                     xloc         = xloc.bar_index)
                array.push(gBoxes, b)

                if showLabels
                    string txt = zn.stateName(z.state) + " | " + f_num(z.score, "#.#") + " | " + zn.strengthName(z.strength)
                    txt := txt + " | HTF: " + (z.hasHtf ? z.htfSources : "NO")
                    txt := txt + " | React " + str.tostring(z.reactionCnt)
                    if z.flipped
                        txt := txt + " | FLIP"
                    if showDetailLbl
                        txt := txt + "\n" + z.sources
                    label lb = label.new(
                         x         = bar_index + zoneRightBars,
                         y         = z.top,
                         text      = txt,
                         xloc      = xloc.bar_index,
                         style     = label.style_label_left,
                         color     = color.new(bc, 20),
                         textcolor = color.white,
                         size      = size.small)
                    array.push(gLabels, lb)

// ---- 9.2 MA Source の可視化 -----------------------------------------------
plot(showMaLines and useMaSource ? ma1Val : na, "MA #1 (1M)", color = color.new(color.aqua, 25), linewidth = 1)
plot(showMaLines and useMaSource ? ma2Val : na, "MA #2 (1M)", color = color.new(color.fuchsia, 25), linewidth = 1)

// ---- 9.3 Zone Debug Table --------------------------------------------------
f_tablePos(string s) =>
    s == "Top Left"      ? position.top_left :
     s == "Bottom Right" ? position.bottom_right :
     s == "Bottom Left"  ? position.bottom_left :
     s == "Middle Right" ? position.middle_right : position.top_right

f_textSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

var table dbg = table.new(f_tablePos(dbgPosStr), 7, dbgNearestN * 2 + 9,
     border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))

f_cell(int col, int row, string txt, color txtCol, color bgCol) =>
    table.cell(dbg, col, row, txt, text_color = txtCol, bgcolor = bgCol,
         text_size = f_textSize(dbgTextSize), text_halign = text.align_left)

f_zoneRow(int row, string tag, int zi, color tagCol) =>
    zn.Zone z = zn.zoneAt(eng, zi)
    float d = z.center - close
    f_cell(0, row, tag,                                   tagCol,      color.new(tagCol, 88))
    f_cell(1, row, f_num(z.center, "#.##"),               color.white, color.new(tagCol, 92))
    f_cell(2, row, f_num(z.score, "#.#") + " · R" + str.tostring(z.reactionCnt), color.white, color.new(tagCol, 92))
    f_cell(3, row, zn.strengthName(z.strength) + " · HTF " + (z.hasHtf ? z.htfSources : "NO"), color.white, color.new(tagCol, 92))
    f_cell(4, row, zn.stateFull(z.state) + (z.flipped ? " (Flip)" : ""), color.white, color.new(tagCol, 92))
    f_cell(5, row, f_num(math.abs(d), "#.#"),             color.white, color.new(tagCol, 92))
    f_cell(6, row, z.sources,                             color.white, color.new(tagCol, 92))

if barstate.islast and showDebugTable
    table.clear(dbg, 0, 0, 6, dbgNearestN * 2 + 8)
    color hdr = color.new(color.gray, 70)
    f_cell(0, 0, "Zone",     color.white, hdr)
    f_cell(1, 0, "Center",   color.white, hdr)
    f_cell(2, 0, "Score",    color.white, hdr)
    f_cell(3, 0, "Strength", color.white, hdr)
    f_cell(4, 0, "State",    color.white, hdr)
    f_cell(5, 0, "Distance", color.white, hdr)
    f_cell(6, 0, "Sources",  color.white, hdr)

    array<int> resIdx = zn.nearestIdx(eng, false, dbgNearestN)
    array<int> supIdx = zn.nearestIdx(eng, true,  dbgNearestN)

    int row = 1
    if array.size(resIdx) > 0
        for k = array.size(resIdx) - 1 to 0
            f_zoneRow(row, "RES " + str.tostring(k + 1), array.get(resIdx, k), colResistance)
            row += 1
    if array.size(resIdx) < dbgNearestN
        for k = array.size(resIdx) to dbgNearestN - 1
            f_cell(0, row, "RES -", color.gray, color.new(color.gray, 90))
            row += 1

    f_cell(0, row, "PRICE", color.black, color.new(color.yellow, 20))
    f_cell(1, row, f_num(close, "#.##"), color.black, color.new(color.yellow, 40))
    f_cell(2, row, "Zones: " + str.tostring(zoneCountNow), color.black, color.new(color.yellow, 60))
    f_cell(3, row, "Raw: " + str.tostring(eng.rawCount),   color.black, color.new(color.yellow, 60))
    f_cell(4, row, "MA1 " + f_arrow(eng.ma1Dir) + " MA2 " + f_arrow(eng.ma2Dir), color.black, color.new(color.yellow, 60))
    f_cell(5, row, "MAcl +" + f_num(eng.maClusterBonus, "#.#"), color.black, color.new(color.yellow, 60))
    f_cell(6, row, "Day H/L " + f_num(eng.dayHigh, "#.#") + " / " + f_num(eng.dayLow, "#.#"), color.black, color.new(color.yellow, 60))
    row += 1

    if array.size(supIdx) > 0
        for k = 0 to array.size(supIdx) - 1
            f_zoneRow(row, "SUP " + str.tostring(k + 1), array.get(supIdx, k), colSupport)
            row += 1
    if array.size(supIdx) < dbgNearestN
        for k = array.size(supIdx) to dbgNearestN - 1
            f_cell(0, row, "SUP -", color.gray, color.new(color.gray, 90))
            row += 1

    // ---- 直近TradePlan (Logic / Dir / Entry / SL / TP / RR / TP Type) -----
    if showTradeDebug
        color pc = color.new(color.blue, 70)
        f_cell(0, row, "PLAN", color.white, pc)
        f_cell(1, row, array.get(gLastPlan, 0), color.white, pc)
        for c = 2 to 6
            f_cell(c, row, "", color.white, pc)
        table.merge_cells(dbg, 1, row, 6, row)
        row += 1
        f_cell(0, row, "STATUS", color.white, pc)
        f_cell(1, row, array.get(gLastPlan, 1) + "  |  Open " + str.tostring(strategy.opentrades), color.white, pc)
        for c = 2 to 6
            f_cell(c, row, "", color.white, pc)
        table.merge_cells(dbg, 1, row, 6, row)
        row += 1

    // ---- 環境警告 ---------------------------------------------------------
    string warn = ""
    if timeframe.in_seconds() < timeframe.in_seconds(breakTf)
        warn := warn + "Chart TF < Break TF. "
    if timeframe.in_seconds() < timeframe.in_seconds(hzTf1)
        warn := warn + "Chart TF < Horizontal TF#1. "
    if timeframe.in_seconds() != timeframe.in_seconds("5")
        warn := warn + "本Strategyは5分足チャート前提。"
    if warn != ""
        f_cell(0, row, "WARN", color.white, color.new(color.orange, 40))
        f_cell(1, row, warn, color.white, color.new(color.orange, 60))
        for c = 2 to 6
            f_cell(c, row, "", color.white, color.new(color.orange, 60))
        table.merge_cells(dbg, 1, row, 6, row)

// ---- 9.4 FVG 環境認識 テーブル --------------------------------------------
f_efvgBiasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

var table efvgTbl = na
if efvgShowTable
    if na(efvgTbl)
        efvgTbl := table.new(position.middle_left, 4, 8, border_width = 1)
    if barstate.islast
        table.cell(efvgTbl, 0, 0, "TF",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 1, 0, "FVG",  text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 2, 0, "理由", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 3, 0, "残",   text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
        table.cell(efvgTbl, 0, 1, "D", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 1, useEFVGDaily ? f_efvgBiasText(efvgDBias) : "-", text_color = color.white, bgcolor = useEFVGDaily ? f_efvgBiasColor(efvgDBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 1, useEFVGDaily ? f_efvgReasonText(efvgDReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 1, useEFVGDaily ? str.tostring(efvgDRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 2, "4H", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 2, useEFVG4H ? f_efvgBiasText(efvgHBias) : "-", text_color = color.white, bgcolor = useEFVG4H ? f_efvgBiasColor(efvgHBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 2, useEFVG4H ? f_efvgReasonText(efvgHReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 2, useEFVG4H ? str.tostring(efvgHRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 3, "1H", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 3, useEFVG1H ? f_efvgBiasText(efvgOBias) : "-", text_color = color.white, bgcolor = useEFVG1H ? f_efvgBiasColor(efvgOBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 3, useEFVG1H ? f_efvgReasonText(efvgOReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 3, useEFVG1H ? str.tostring(efvgORem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 4, "15M", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 4, useEFVG15M ? f_efvgBiasText(efvgMBias) : "-", text_color = color.white, bgcolor = useEFVG15M ? f_efvgBiasColor(efvgMBias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 4, useEFVG15M ? f_efvgReasonText(efvgMReason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 4, useEFVG15M ? str.tostring(efvgMRem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 5, "5M", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 5, useEFVG5M ? f_efvgBiasText(efvg5Bias) : "-", text_color = color.white, bgcolor = useEFVG5M ? f_efvgBiasColor(efvg5Bias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 5, useEFVG5M ? f_efvgReasonText(efvg5Reason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 5, useEFVG5M ? str.tostring(efvg5Rem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 6, "1M", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 1, 6, useEFVG1M ? f_efvgBiasText(efvg1Bias) : "-", text_color = color.white, bgcolor = useEFVG1M ? f_efvgBiasColor(efvg1Bias) : color.new(color.gray, 60), text_size = size.small)
        table.cell(efvgTbl, 2, 6, useEFVG1M ? f_efvgReasonText(efvg1Reason) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 6, useEFVG1M ? str.tostring(efvg1Rem) : "-", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 0, 7, "FINAL FVG BIAS: " + f_efvgBiasText(efvgFinalBias), text_color = color.white, bgcolor = f_efvgBiasColor(efvgFinalBias), text_size = size.small)
        table.cell(efvgTbl, 1, 7, efvgShowDebug ? ("Score:" + str.tostring(efvgScore)) : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 2, 7, efvgShowDebug ? (efvgCombineMode + "/" + efvgIntegrationMode) : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 7, efvgShowDebug ? ("Trend:" + (efvgTrendOk ? "OK" : "NG")) : "", text_color = color.white, text_size = size.small)

// ---- 9.5 日足ボラ中央値 デバッグ ------------------------------------------
var table dailyVolTbl = na
if showDailyVolDebug and useDailyRegimeFilter
    if na(dailyVolTbl)
        dailyVolTbl := table.new(position.top_left, 2, 3, border_width = 1)
    if barstate.islast
        color _hb = color.new(color.black, 0)
        table.cell(dailyVolTbl, 0, 0, "日足ボラ (中央値" + str.tostring(dailyVolMedianLength) + "本)", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(dailyVolTbl, 1, 0, "", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(dailyVolTbl, 0, 1, "中央値", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 1, 1, (na(drMedianRange) ? "-" : str.tostring(drMedianRange, "#.#")) + "$", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 0, 2, "判定", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 1, 2, f_dailyVolatilityText(drVolCodeAdj), text_color = color.white, bgcolor = f_efvgBiasColor(nz(drVolCodeAdj, 0)), text_size = size.small)

// ---- 9.6 FVG構造管理 BOS デバッグ -----------------------------------------
f_fvgBosText(int s) =>
    s == 1 ? "Bull" : s == -1 ? "Bear" : "Neutral"
var table fvgBosTbl = na
if showFvgBosDebug and useEFVGEnv
    if na(fvgBosTbl)
        fvgBosTbl := table.new(position.bottom_right, 2, 7, border_width = 1)
    if barstate.islast
        color _hb = color.new(color.black, 0)
        table.cell(fvgBosTbl, 0, 0, "FVG構造BOS", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(fvgBosTbl, 1, 0, useFvgBosFilter ? "ON" : "OFF", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(fvgBosTbl, 0, 1, "D",   text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 1, useEFVGDaily ? f_fvgBosText(efvgDBos) : "-", text_color = color.white, bgcolor = useEFVGDaily ? f_efvgBiasColor(efvgDBos) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fvgBosTbl, 0, 2, "4H",  text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 2, useEFVG4H ? f_fvgBosText(efvgHBos) : "-", text_color = color.white, bgcolor = useEFVG4H ? f_efvgBiasColor(efvgHBos) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fvgBosTbl, 0, 3, "1H",  text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 3, useEFVG1H ? f_fvgBosText(efvgOBos) : "-", text_color = color.white, bgcolor = useEFVG1H ? f_efvgBiasColor(efvgOBos) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fvgBosTbl, 0, 4, "15M→5M", text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 4, useEFVG15M ? (useFvgBosFilter ? f_fvgBosText(efvg5Bos) : "OFF") : "-", text_color = color.white, bgcolor = (useEFVG15M and useFvgBosFilter) ? f_efvgBiasColor(efvg5Bos) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fvgBosTbl, 0, 5, "5M",  text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 5, useEFVG5M ? f_fvgBosText(efvg5Bos) : "-", text_color = color.white, bgcolor = useEFVG5M ? f_efvgBiasColor(efvg5Bos) : color.new(color.gray, 60), text_size = size.small)
        table.cell(fvgBosTbl, 0, 6, "1M",  text_color = color.white, text_size = size.small)
        table.cell(fvgBosTbl, 1, 6, useEFVG1M ? f_fvgBosText(efvg1Bos) : "-", text_color = color.white, bgcolor = useEFVG1M ? f_efvgBiasColor(efvg1Bos) : color.new(color.gray, 60), text_size = size.small)

var string G_RISK = "04 · Trade Engine · Risk"
riskPct     = input.float(5.0, "1トレード損失率 (%)", step = 0.1, group = G_RISK,
     tooltip = "Risk Amount ÷ Structural SL距離 でQtyを計算する。")
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = G_RISK)
qtyStep     = input.float(1, "Qty 刻み (最小ロット単位)", minval = 0.00000001, step = 0.01, group = G_RISK,
     tooltip = "XAUUSD等の小数ロットを潰さないための刻み。\n" +
               "0.01 → 0.01単位で発注 / 1 → 整数ロットのみ。\n" +
               "Qty = floor(RiskAmount ÷ SL距離 ÷ step) × step")
qtyMin      = input.float(0.01, "Qty 最小値 (これ未満はエントリーしない)", minval = 0.0, step = 0.01, group = G_RISK)

var string G_TE = "04 · Trade Engine · Order"
maxOpenPerLogic    = input.int(1, "Logicごとの最大同時保有トレード数", minval = 1, maxval = 50, group = G_TE,
     tooltip = "同一logicIdのポジションをいくつまで同時に持てるか。Logic間は互いに影響しない。")
allowOppositeEntry = input.bool(false, "反対方向Logicの同時Entryを許可", group = G_TE,
     tooltip = "TradingView Strategyは単一ネットポジションのため、反対方向Entryは既存Tradeを\n" +
               "打ち消してしまう。既定 (false) では反対方向シグナルをSKIPする。")
//  ---- TP管理方式 (FIXED = 従来どおり固定 / DYNAMIC = 近づける方向のみ可変) ----
tpManagementMode = input.string("FIXED", "TP管理", options = ["FIXED", "DYNAMIC"], group = G_TE,
     tooltip = "FIXED   : 現状と完全に同じ。Entry時に決定した TP を最後まで固定する。\n" +
     "          保有中に新しいStrong Zoneが出ても、Zoneが昇格・降格・消滅してもTPは動かない。\n" +
     "DYNAMIC : 保有中に現在TPより手前へ新しい有効な Strong以上のTP Zone が出現した\n" +
     "          場合のみ、TPをそのZoneまで近づける。TPを遠ざける変更は行わない。\n" +
     "          一度近づけたTPは、そのZoneが消滅・弱化しても元に戻さない (不可逆)。\n" +
     "★ Entry条件 / Structural SL / Risk / Qty / Break Even / Entry時TP算出は\n" +
     "  どちらのモードでも一切変わらない。FIXED のバックテスト結果は追加前と完全一致する。")
useDynamicTpAlert = input.bool(true, "Dynamic TP 変更時にアラートを出す", group = G_TE,
     tooltip = "TP管理 = DYNAMIC のときだけ有効。実際にTP価格が変わったときに1回だけ通知する。\n" +
     "同じTPへの更新では通知しない。")


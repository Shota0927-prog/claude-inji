// ============================================================================
// 02. ENGINE INITIALIZATION
// ----------------------------------------------------------------------------
//  Engine (永続状態) を var で1つずつ持ち、Config に Section 01 の input を詰める。
//  Library 側は input を持てないため、UI定義 (01) と Config代入 (02) を分離している。
//  Logicを増やす場合は、そのLogicの Engine と Cfg をここに1組追加する
//  (Cooldown / Armed 等の状態は Engine ごとに完全独立)。
// ============================================================================

// ---- 2.1 Engines -----------------------------------------------------------
var zn.ZoneEngine zoneEng = zn.newEngine()
var sg.FvgEngine  fvgEng  = sg.newFvgEngine()
// FVG15 Logic 用。Engineは既存 fvgEng とは別インスタンスなので、
// Armed / Cooldown / Accum / Daily の状態は既存5M Logicと一切混ざらない。
var sg.FvgEngine   fvg15Eng = sg.newFvgEngine()
var sg.Fvg15Engine fvg15Ord = sg.newFvg15Engine()
// FVG吸収系列 用。反発系列 (fvgEng / fvg15Eng / fvg15Ord) とstateを共有しない。
var sg.FvgAbsEngine fvgAbsEng = sg.newFvgAbsEngine()
// Zone 4系列 用。FVG系列のEngineとstateを共有しない。
//  4Logicは同じZoneイベント列を共有するが、消費フラグ (reboundDone / breakDone /
//  fakeDone / retestDone) はイベント内でLogicごとに独立している。
var sg.ZoneEvtEngine zoneEvtEng = sg.newZoneEvtEngine()

// ---- 2.2 Zone Engine Config -----------------------------------------------
zn.ZoneCfg zoneCfg = zn.newCfg()
zoneCfg.zoneHalfWidth        := zoneHalfWidth
zoneCfg.useMaSource          := useMaSource
zoneCfg.maTfName             := maTf
zoneCfg.ma1Len               := ma1Len
zoneCfg.ma2Len               := ma2Len
zoneCfg.scoreMa1             := scoreMa1
zoneCfg.scoreMa2             := scoreMa2
zoneCfg.slopeThrMod          := slopeThrMod
zoneCfg.slopeThrStrong       := slopeThrStrong
zoneCfg.slopeBonusFlat       := slopeBonusFlat
zoneCfg.slopeBonusMod        := slopeBonusMod
zoneCfg.slopeBonusStr        := slopeBonusStr
zoneCfg.slopeBonusMax        := slopeBonusMode == "Max"
zoneCfg.maClusterDist        := maClusterDist
zoneCfg.maClusterBonus       := maClusterBonus
zoneCfg.maClusterDirBonus    := maClusterDirBonus
zoneCfg.useHzSource          := useHzSource
zoneCfg.hzTf1                := hzTf1
zoneCfg.hzTf2                := hzTf2
zoneCfg.hzTf3                := hzTf3
zoneCfg.scoreHz1             := scoreHz1
zoneCfg.scoreHz2             := scoreHz2
zoneCfg.scoreHz3             := scoreHz3
zoneCfg.reactionDist         := reactionDist
zoneCfg.reactionBonus1       := reactionBonus1
zoneCfg.reactionBonus2       := reactionBonus2
zoneCfg.reactionBonus3       := reactionBonus3
zoneCfg.reactionRearmDist    := reactionRearmDist
zoneCfg.reactionAllSrc       := reactionAllSrc
zoneCfg.useDayHL             := useDayHL
zoneCfg.scoreDayHL           := scoreDayHL
zoneCfg.carryPrevDayHL       := carryPrevDayHL
zoneCfg.scorePrevDayHL       := scorePrevDayHL
zoneCfg.lifePrevDayHL        := lifePrevDayHL
zoneCfg.useAccSource         := useAccSource
zoneCfg.accTf1               := accTf1
zoneCfg.accTf2               := accTf2
zoneCfg.accTf3               := accTf3
zoneCfg.scoreAcc1            := scoreAcc1
zoneCfg.scoreAcc2            := scoreAcc2
zoneCfg.scoreAcc3            := scoreAcc3
zoneCfg.accKeep1             := accKeep1
zoneCfg.accKeep2             := accKeep2
zoneCfg.accKeep3             := accKeep3
zoneCfg.clusterDist          := clusterDist
zoneCfg.thrMedium            := thrMedium
zoneCfg.thrStrong            := thrStrong
zoneCfg.thrVStrong           := thrVStrong
zoneCfg.confBonus2           := confBonus2
zoneCfg.confBonus3           := confBonus3
zoneCfg.confBonus4           := confBonus4
zoneCfg.flipBonus            := flipBonus
zoneCfg.requireHtfForVStrong := requireHtfForVStrong
zoneCfg.htfSwing1H           := htfSwing1H
zoneCfg.htfAccum1H           := htfAccum1H
zoneCfg.htfAccum4H           := htfAccum4H
zoneCfg.htfAccumD            := htfAccumD
zoneCfg.htfSwing15M          := htfSwing15M
zoneCfg.htfMa1               := htfMa1
zoneCfg.htfMa2               := htfMa2
zoneCfg.htfDayHL             := htfDayHL
zoneCfg.breakBuffer          := breakBuffer
zoneCfg.flipConfirmDist      := flipConfirmDist
zoneCfg.resetOnReclaim       := resetOnReclaim
zoneCfg.trackStaleBars       := trackStaleBars
zoneCfg.trackContinuity      := trackContinuity
zoneCfg.lifeHz1              := lifeHz1
zoneCfg.lifeHz2              := lifeHz2
zoneCfg.lifeHz3              := lifeHz3
zoneCfg.lifeExtendOn         := lifeExtendOn
zoneCfg.lifeExtendRatio      := lifeExtendRatio
zoneCfg.maxPersistZones      := maxPersistZones
zoneCfg.slBuffer             := slBuffer
zoneCfg.tpBuffer             := tpBuffer
zoneCfg.maxSlDist            := maxSlDist
zoneCfg.minStructRR          := minStructRR
zoneCfg.slMinScore           := slMinScore
zoneCfg.slMinStrength        := zn.strengthIdx(slMinStrStr)
zoneCfg.tpMinScore           := tpMinScore
zoneCfg.tpMinStrength        := zn.strengthIdx(tpMinStrStr)
zoneCfg.obsMinStrength       := zn.strengthIdx(obsMinStrStr)
zoneCfg.activeNoTradeMinStrength := zn.strengthIdx(activeNoTradeMinStrStr)
zoneCfg.fallbackRR           := fallbackRR
// ---- 2.3 Signal Engine Config (FVG) ---------------------------------------
//  ★ Config を「どのコンテキストで評価されるか」で4つに分けている ★
//    Pine の external elements 上限は 1つの request.security 式あたり 254 個。
//    security 式へ渡したUDTは、その構築に使った input 全てが外部要素として
//    数えられるため、127フィールドの単一Cfgを渡すと超過する
//    (127 input + 127 代入 + 期間引数 ≒ 257 → コンパイルエラー)。
//    そこで security で評価される関数が実際に参照する設定だけを小さなUDTへ分けた。
//      FvgTrigCfg (26) … calcTriggers  → 1分足コンテキスト
//      FvgEnvCfg  (28) … envTrend      → 各TFコンテキスト
//      FvgAccCfg  ( 6) … accumNTDetect → 15分足コンテキスト
//      FvgCfg     (67) … updateFvg のみ (チャート足) = 上限と無関係
//    小さい3つは .new() の名前付き引数で一気に構築する
//    (中間代入を作らないぶん依存チェーンが短くなる)。
//    ※ Logicを追加するときも同じ方針にすること。security へ渡すUDTは
//      「そのsecurity関数が実際に読むフィールドだけ」に限定する。

// calcTriggers (1分足) が参照する設定
sg.FvgTrigCfg fvgTrigCfg = sg.FvgTrigCfg.new(
     strictEngulf = strictEngulf,
     reqOppColor = reqOppColor,
     useEngulfingTrigger = useEngulfingTrigger,
     usePinbarTrigger = usePinbarTrigger,
     useBOSTrigger = useBOSTrigger,
     useEMARejectTrigger = useEMARejectTrigger,
     useFVGTriggerFormation = useFVGTriggerFormation,
     useStrongCandleTrigger = useStrongCandleTrigger,
     triggerMode = triggerMode,
     minTriggerCount = minTriggerCount,
     useEMARejectSlopeFilter = useEMARejectSlopeFilter,
     emaRejectSlopeMinATR = emaRejectSlopeMinATR,
     pinWickBodyMult = pinWickBodyMult,
     pinOppWickMaxRatio = pinOppWickMaxRatio,
     usePinBodyRatioFilter = usePinBodyRatioFilter,
     pinMaxBodyRatio = pinMaxBodyRatio,
     usePinRangeFilter = usePinRangeFilter,
     pinMinRangeATR = pinMinRangeATR,
     strongBodyRatio = strongBodyRatio,
     trigCloseEdgeRatio = trigCloseEdgeRatio,
     useEngulfBodyRatioFilter = useEngulfBodyRatioFilter,
     engulfBodyRatioMin = engulfBodyRatioMin,
     useEngulfBodyQualityFilter = useEngulfBodyQualityFilter,
     engulfMinBodyRatio = engulfMinBodyRatio,
     useEngulfBodyAtrFilter = useEngulfBodyAtrFilter,
     engulfMinBodyATR = engulfMinBodyATR)

// envTrend (各TF) が参照する設定
sg.FvgEnvCfg fvgEnvCfg = sg.FvgEnvCfg.new(
     useEma20Above50Up = useEma20Above50Up,
     useEma20SlopeUp = useEma20SlopeUp,
     useEma50SlopeUp = useEma50SlopeUp,
     useCloseAboveEma50 = useCloseAboveEma50,
     useCloseAboveEma200 = useCloseAboveEma200,
     useEmaDistanceWideU = useEmaDistanceWideU,
     useEmaExpansionU = useEmaExpansionU,
     useEma20Below50Dn = useEma20Below50Dn,
     useEma20SlopeDown = useEma20SlopeDown,
     useEma50SlopeDown = useEma50SlopeDown,
     useCloseBelowEma50 = useCloseBelowEma50,
     useCloseBelowEma200 = useCloseBelowEma200,
     useEmaDistanceWideD = useEmaDistanceWideD,
     useEmaExpansionD = useEmaExpansionD,
     useEmaDistanceNarrow = useEmaDistanceNarrow,
     useEma20SlopeWeak = useEma20SlopeWeak,
     useEma50SlopeWeak = useEma50SlopeWeak,
     useEmaCompression = useEmaCompression,
     useEma20CrossCount = useEma20CrossCount,
     useEma50CrossCount = useEma50CrossCount,
     useRangeWidthSmall = useRangeWidthSmall,
     slopeMinMult = slopeMinMult,
     distWideMult = distWideMult,
     distNarrowMult = distNarrowMult,
     crossMinCount = crossMinCount,
     rangeMult = rangeMult,
     tieAsRange = tieAsRange,
     insufficientAsRange = insufficientAsRange)

// accumNTDetect (15分足) が参照する設定
sg.FvgAccCfg fvgAccCfg = sg.FvgAccCfg.new(
     accumNTMinUpperCloses = accumNTMinUpperCloses,
     accumNTMinLowerCloses = accumNTMinLowerCloses,
     accumNTMaxSameColorRun = accumNTMaxSameColorRun,
     accumNTAtrMult = accumNTAtrMult,
     accumNTBarRatioMax = accumNTBarRatioMax,
     accumNTDriftMax = accumNTDriftMax)

// updateFvg (チャート足) でのみ使う残りの設定
sg.FvgCfg fvgCfg = sg.newFvgCfg()
fvgCfg.useLowerTFTrigger          := useLowerTFTrigger
fvgCfg.useTriggerCooldown         := useTriggerCooldown
fvgCfg.triggerCooldownBars        := triggerCooldownBars
fvgCfg.useOppositeTriggerNoTrade  := useOppositeTriggerNoTrade
fvgCfg.volMode                    := volMode
fvgCfg.fixedMin                   := fixedMin
fvgCfg.useMinVol                  := useMinVol
fvgCfg.minAtrDollar               := minAtrDollar
fvgCfg.volModeRel                 := volModeRel
fvgCfg.volRatioMin                := volRatioMin
fvgCfg.fastVolMode                := fastVolMode
fvgCfg.fastAtrMin                 := fastAtrMin
fvgCfg.fastFixedMin               := fastFixedMin
fvgCfg.bodyAvgMin                 := bodyAvgMin
fvgCfg.useRangeRatioFilter        := useRangeRatioFilter
fvgCfg.atrRangeRatioMin           := atrRangeRatioMin
fvgCfg.useVolCooldown             := useVolCooldown
fvgCfg.volRecoveryBars            := volRecoveryBars
fvgCfg.useEnvFilter               := useEnvFilter
fvgCfg.reqTrend4H                 := reqTrend4H
fvgCfg.reqTrend1H                 := reqTrend1H
fvgCfg.reqTrend15M                := reqTrend15M
fvgCfg.reqTrend5M                 := reqTrend5M
fvgCfg.reqTrend1M                 := reqTrend1M
fvgCfg.minScore4H                 := minScore4H
fvgCfg.minScore1H                 := minScore1H
fvgCfg.minScore15M                := minScore15M
fvgCfg.minScore5M                 := minScore5M
fvgCfg.minScore1M                 := minScore1M
fvgCfg.reqMatchCount              := reqMatchCount
fvgCfg.useDailyRegimeFilter       := useDailyRegimeFilter
fvgCfg.dailyRegimeMode            := dailyRegimeMode
fvgCfg.reqDailyDirection          := reqDailyDirection
fvgCfg.reqDailyVolatility         := reqDailyVolatility
fvgCfg.dailyLowVolThreshold       := dailyLowVolThreshold
fvgCfg.dailyHighVolThreshold      := dailyHighVolThreshold
fvgCfg.dailyDirectionBodyRatio    := dailyDirectionBodyRatio
fvgCfg.dailyBullCloseLocation     := dailyBullCloseLocation
fvgCfg.dailyBearCloseLocation     := dailyBearCloseLocation
fvgCfg.dailyInsufficientAsRange   := dailyInsufficientAsRange
fvgCfg.useAccumNoTrade            := useAccumNoTrade
fvgCfg.useAccumNT5M               := useAccumNT5M
fvgCfg.useAccumNT15M              := useAccumNT15M
fvgCfg.accumNTKeep                := accumNTKeep
fvgCfg.useAccumExitConfirm        := useAccumExitConfirm
fvgCfg.accumExitConfirmBars       := accumExitConfirmBars
fvgCfg.useAccumBreakDirection     := useAccumBreakDirection
fvgCfg.accumBreakDirectionBars    := accumBreakDirectionBars
fvgCfg.useEFVGEnv                 := useEFVGEnv
fvgCfg.efvgCombineMode            := efvgCombineMode
fvgCfg.useEFVGDaily               := useEFVGDaily
fvgCfg.useEFVG4H                  := useEFVG4H
fvgCfg.useEFVG1H                  := useEFVG1H
fvgCfg.useEFVG15M                 := useEFVG15M
fvgCfg.useEFVG5M                  := useEFVG5M
fvgCfg.useEFVG1M                  := useEFVG1M
fvgCfg.efvgIntegrationMode        := efvgIntegrationMode
fvgCfg.efvgReqMatch               := efvgReqMatch
fvgCfg.efvgWeightD                := efvgWeightD
fvgCfg.efvgWeight4H               := efvgWeight4H
fvgCfg.efvgWeight1H               := efvgWeight1H
fvgCfg.efvgWeight15M              := efvgWeight15M
fvgCfg.efvgWeight5M               := efvgWeight5M
fvgCfg.efvgWeight1M               := efvgWeight1M
fvgCfg.efvgScoreThresh            := efvgScoreThresh
fvgCfg.efvgMode4Allow             := efvgMode4Allow
fvgCfg.useFvgBosFilter            := useFvgBosFilter

// ---- 2.4 Signal Engine Config (FVG15 Logic) --------------------------------
//  ★ 既存 fvgCfg は一切書き換えない。copy() して FVG環境認識のTFだけ差し替える。
//    追加元 Strategy の現在ONの設定 (15M FVG のみ ON / 他のTFは OFF) を再現する。
//    Session / News / ボラ / Accum / Daily Regime / EMAトレンド環境 /
//    統合方式 (WeightedScore) / 結合 (TrendAndFVG) は共通設定をそのまま継承。
//  ★ useFvgBosFilter は false にして、既存 updateFvg 内の 15M BOSラッチを
//    素通し (= 生の15M反発bias) にする。順序確認は updateFvg15 が別に行う。
sg.FvgCfg fvg15Cfg = fvgCfg.copy()
fvg15Cfg.useEFVGEnv      := true
fvg15Cfg.useEFVGDaily    := false
fvg15Cfg.useEFVG4H       := false
fvg15Cfg.useEFVG1H       := false
fvg15Cfg.useEFVG15M      := true
fvg15Cfg.useEFVG5M       := false
fvg15Cfg.useEFVG1M       := false
fvg15Cfg.useFvgBosFilter := false

// ============================================================================
// 03. EXTERNAL DATA FEED
// ----------------------------------------------------------------------------
//  Library は request.*() を呼べないため、外部足の取得はすべてここで行う。
//  取得した値は ZoneFeed / FvgFeed に詰めて各Engineへ渡す。
//
//  ★ request.* の本数 (分割前と同数。Library化で重複は増えていない) ★
//    Zone   : MA×1 / Swing×3 / Accum×3 / Break×1                  = 8
//    Signal : 1分足Trigger×1 / baseATR×1 / 環境×5 / FVG環境×最大6 /
//             日足×2 / Accum15M×1                                  = 最大16
//    合計 最大24。各呼び出しは (TF, 式) の組が全て異なるため共有できるものは無い。
//    Logicを増やす場合も、同じ (TF, 式) が既にあれば必ず再利用すること。
// ============================================================================

// ---- 3.1 共通フィルタ (Global Filter) -------------------------------------
//  Session / News は Main で判定し、必要とする Logic にだけ Feed で渡す。
//  「共通で計算する」だけであり、全Logicに自動適用はしない
//  (Logic Local Filter として使うかどうかは各Logicの自由)。
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool inNewsSession1 = not na(time(timeframe.period, newsSession1, "Asia/Tokyo"))
bool inNewsSession2 = not na(time(timeframe.period, newsSession2, "Asia/Tokyo"))
bool inNewsSession3 = not na(time(timeframe.period, newsSession3, "Asia/Tokyo"))
bool inNewsTime = inNewsSession1 or inNewsSession2 or inNewsSession3
bool allowByNewsTime = not useNewsTimeFilter or not inNewsTime

// ---- 3.2 Zone Engine Feed --------------------------------------------------
// ★ MA2000 / MA3000 : zn.maPack() を 1分足コンテキストで評価させる。
//   maPack() の中身は ta.ema(close, 2000) 等であり、この close は1分足のclose。
//   → 5分足closeからの再計算ではない。
//  ★ Source が OFF のときは取得自体を行わない (結果不変・下の理由による) ★
//    Library 側は MA / Swing / Accum のどれも
//      「c.useXxxSource が true」かつ「値が na でない」
//    ときにしか Zone を登録しない。OFF のとき取得値は元々一切使われていないため、
//    na を渡すのと実測値を渡すのは Zone 時系列に対して完全に等価。
//    エッジ検出 (nPh1 / nAc1 等) も not na(...) を要求するので false のまま。
float ma1Val   = na
float ma1Delta = na
float ma2Val   = na
float ma2Delta = na
if useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Val   := _m1
    ma1Delta := _m1d
    ma2Val   := _m2
    ma2Delta := _m2d

float ph1 = na
int   ph1T = na
float pl1 = na
int   pl1T = na
float ph2 = na
int   ph2T = na
float pl2 = na
int   pl2T = na
float ph3 = na
int   ph3T = na
float pl3 = na
int   pl3T = na
if useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = request.security(syminfo.tickerid, hzTf2, zn.pivotPack(pivLen2), lookahead = barmerge.lookahead_off)
    [_h3, _h3t, _l3, _l3t] = request.security(syminfo.tickerid, hzTf3, zn.pivotPack(pivLen3), lookahead = barmerge.lookahead_off)
    ph1 := _h1
    ph1T := _h1t
    pl1 := _l1
    pl1T := _l1t
    ph2 := _h2
    ph2T := _h2t
    pl2 := _l2
    pl2T := _l2t
    ph3 := _h3
    ph3T := _h3t
    pl3 := _l3
    pl3T := _l3t

bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1Hi = na
float acc1Lo = na
int   acc1Id = na
float acc2Hi = na
float acc2Lo = na
int   acc2Id = na
float acc3Hi = na
float acc3Lo = na
int   acc3Id = na
if useAccSource
    [_a1h, _a1l, _a1i] = request.security(syminfo.tickerid, accTf1,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult), lookahead = barmerge.lookahead_off)
    [_a2h, _a2l, _a2i] = request.security(syminfo.tickerid, accTf2,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult), lookahead = barmerge.lookahead_off)
    [_a3h, _a3l, _a3i] = request.security(syminfo.tickerid, accTf3,
         zn.accumPack(usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult), lookahead = barmerge.lookahead_off)
    acc1Hi := _a1h
    acc1Lo := _a1l
    acc1Id := _a1i
    acc2Hi := _a2h
    acc2Lo := _a2l
    acc2Id := _a2i
    acc3Hi := _a3h
    acc3Lo := _a3l
    acc3Id := _a3i

// Break判定は breakTf の「確定終値」のみ (ヒゲでは判定しない)
[brCloseRaw, brHighRaw, brLowRaw] = request.security(syminfo.tickerid, breakTf, [close, high, low],
     lookahead = barmerge.lookahead_off)
bool  brBarClosed = bar_index > 0 and not na(time(breakTf)) and nz(ta.change(time(breakTf)), 0) != 0
float brClose = brBarClosed ? brCloseRaw[1] : na
float brHigh  = brBarClosed ? brHighRaw[1]  : na
float brLow   = brBarClosed ? brLowRaw[1]   : na
bool  brEval  = brBarClosed and not na(brClose)

// 取引日ID (timestamp/hour の timezone は series 不可なので Main で計算する)
int _locY = year(time, dayTz)
int _locM = month(time, dayTz)
int _locD = dayofmonth(time, dayTz)
int _locH = hour(time, dayTz)
int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
int tradingDayId = _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T,
     ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id,
     acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id,
     dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)

int zoneCountNow = zn.update(zoneEng, zoneCfg, zoneFeed)

// ---- 3.3 Signal Engine Feed (FVG) -----------------------------------------
//  取得条件 (どのTFを取るか) は分割前と同一の if 条件を維持している。

// 1分足トリガー
//  ★ 有効なトリガーが1つも無いとき (enabledTrigCount == 0) は取得しない ★
//    そのとき SignalEngine は noTriggerMode に入り、finalBullTrig / finalBearTrig を
//    参照しない (triggerLongSignal / triggerShortSignal が not noTriggerMode で
//    無効化されるため)。取得を省いても Signal は完全に同じ。
//    calcTriggers は ta.atr×3 / ta.highest / ta.lowest / ta.ema を評価するので、
//    1分足5本ぶん × 全バー の計算が丸ごと不要になる。
int fvgEnabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)
//    ※ 取得しない場合でも na 配列を渡すと updateFvg 内の array.size() が
//      RE10052 (Cannot call array methods when ID of array is 'na') になるため、
//      必ず「空配列」で初期化して渡す。空配列なら array.size() == 0 で
//      ループに入らず、oneMinBullTriggered / oneMinBearTriggered は false のまま。
array<bool> fvgBullTrig = array.new_bool()
array<bool> fvgBearTrig = array.new_bool()
if useLowerTFTrigger and fvgEnabledTrigCount > 0
    [_bull, _bear] = request.security_lower_tf(syminfo.tickerid, triggerTF,
         sg.calcTriggers(fvgTrigCfg, engulfAtrLen, pinRangeAtrLen, bosLookback,
         emaLenTrigger, emaRejectSlopeLookback, emaRejectSlopeAtrLen))
    fvgBullTrig := _bull
    fvgBearTrig := _bear

// ボラフィルタ用 基準ATR (分割前と同じく volMode == "ATR" のときだけ)
float fvgBaseAtr = na
if volMode == "ATR"
    fvgBaseAtr := atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)

// 環境認識 (EMAトレンド)
int env4H  = na
int env1H  = na
int env15M = na
int env5M  = na
int env1M  = na
//  ★ 吸収系列は既存 Trend Env の判定結果 (fvgSig.trendOk) を共有するようになったため、
//    吸収系列のためだけに env4H/1H/15M を取得する必要は無くなった
//    (useEnvFilter = OFF なら trendOk は常に true = 環境フィルター無効)。
bool absAnyOn = useFvgAbs5Logic or useFvgAbs15Logic
//  ★ Zone 4系列 も 4H/1H/15M の環境判定結果 (env4H / env1H / env15M) を
//    ロジック別・方向別の許可設定で使うため、useEnvFilter が OFF でも取得する。
//    取得しても updateFvg 側は c.useEnvFilter の中でしか参照しないので、
//    既存FVG系Logicの判定は一切変わらない。
if useEnvFilter or useZoneAny
    env4H  := request.security(syminfo.tickerid, tf4H,  sg.envTrendConfirmed(fvgEnvCfg, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore4H),  lookahead = barmerge.lookahead_on)
    env1H  := request.security(syminfo.tickerid, tf1H,  sg.envTrendConfirmed(fvgEnvCfg, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore1H),  lookahead = barmerge.lookahead_on)
    env15M := request.security(syminfo.tickerid, tf15M, sg.envTrendConfirmed(fvgEnvCfg, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore15M), lookahead = barmerge.lookahead_on)
    env5M  := request.security(syminfo.tickerid, tf5M,  sg.envTrend(fvgEnvCfg, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore5M),  lookahead = barmerge.lookahead_off)
    env1M  := request.security(syminfo.tickerid, tf1M,  sg.envTrend(fvgEnvCfg, len20, len50, len200, envAtrLen, slopeBars, convDivBars, crossBars, rangeBars, minScore1M),  lookahead = barmerge.lookahead_off)

// FVG環境認識 (各TFの反発状態)
int efvgDBias = 0
int efvgDReason = 0
int efvgDRem = 0
int efvgDBos = 0
int efvgHBias = 0
int efvgHReason = 0
int efvgHRem = 0
int efvgHBos = 0
int efvgOBias = 0
int efvgOReason = 0
int efvgORem = 0
int efvgOBos = 0
int efvg5Bias = 0
int efvg5Reason = 0
int efvg5Rem = 0
int efvg5Bos = 0
int efvg1Bias = 0
int efvg1Reason = 0
int efvg1Rem = 0
int efvg1Bos = 0
int efvgMRawBias = 0
int efvgMRawReason = 0
int efvgMRawRem = 0
int efvgMRawBos = 0

if useEFVGEnv and useEFVGDaily
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvgDailyTF, sg.efvgReboundConfirmed(efvgHoldDaily, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgDBias := _b
    efvgDReason := _r
    efvgDRem := _rem
    efvgDBos := _bos
if useEFVGEnv and useEFVG4H
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg4HTF, sg.efvgReboundConfirmed(efvgHold4H, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgHBias := _b
    efvgHReason := _r
    efvgHRem := _rem
    efvgHBos := _bos
if useEFVGEnv and useEFVG1H
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg1HTF, sg.efvgReboundConfirmed(efvgHold1H, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgOBias := _b
    efvgOReason := _r
    efvgORem := _rem
    efvgOBos := _bos

// 5M : 15M FVG のゲートにも 5M BOS を使うため、必要なら1回だけ取得する。
bool need5MState = useEFVGEnv and (useEFVG5M or (useEFVG15M and useFvgBosFilter))
if need5MState
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg5MTF, sg.efvgReboundConfirmed(efvgHold5M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvg5Bias := _b
    efvg5Reason := _r
    efvg5Rem := _rem
    efvg5Bos := _bos

// 15M (既存5M FVG Logic の FVG環境認識用) : BOSゲート無し (useBos=false) の生の値を
//   取得し、5M BOSでのゲートは SignalEngine 内 (updateFvg) が行う。
//   ★ 保持本数は従来どおり efvgHold15M。FVG15 Logic 用とは分離したので、
//     FVG15 の保持本数を変えてもここは一切影響を受けない。
if useEFVGEnv and useEFVG15M
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg15MTF, sg.efvgReboundConfirmed(efvgHold15M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, false, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvgMRawBias := _b
    efvgMRawReason := _r
    efvgMRawRem := _rem
    efvgMRawBos := _bos

// 15M (FVG15 Logic 専用) : 保持本数だけ fvg15Hold に差し替えた別系統。
//   efvgRebound15Pack は上の4値 + 反発足の開始時刻 を返す (順序確認に使う)。
//   ★ 保持本数が違う = 別の計算なので、上のrequestとは共有できない。
//     ただし useEFVG15M = false (既定) のときは上は発行されないため、
//     15分足へのrequestは結局この1本だけになる。
int fvg15RawBias   = 0
int fvg15RawReason = 0
int fvg15RawRem    = 0
int fvg15RawBos    = 0
int fvg15RawTime   = na
if useFvg15Logic
    [_b, _r, _rem, _bos, _t] = request.security(syminfo.tickerid, efvg15MTF, sg.efvgRebound15Pack(fvg15Hold, efvgMinThick, reboundDepthMax, reboundRecoverRatio, false, fvgBosLookback), lookahead = barmerge.lookahead_on)
    fvg15RawBias   := _b
    fvg15RawReason := _r
    fvg15RawRem    := _rem
    fvg15RawBos    := _bos
    fvg15RawTime   := _t

if useEFVGEnv and useEFVG1M
    [_b, _r, _rem, _bos] = request.security(syminfo.tickerid, efvg1MTF, sg.efvgReboundConfirmed(efvgHold1M, efvgMinThick, reboundDepthMax, reboundRecoverRatio, useFvgBosFilter, fvgBosLookback), lookahead = barmerge.lookahead_on)
    efvg1Bias := _b
    efvg1Reason := _r
    efvg1Rem := _rem
    efvg1Bos := _bos

// ---- FVG吸収 (反発とは別の式なので既存requestは再利用できない) --------------
//  Logic が OFF のときは取得しない = 追加前と request 本数も計算量も同じ。
//  ★ 3値目 absEventTime は「実際に吸収が成立した足の time」。
//    Main が event を認識するのは confirmed ([1]) のぶんだけ後のバーになるので、
//    認識時刻ではなくこの成立時刻をBOS順序判定の基準にする。
int absBias5      = 0
int absEvent5     = na
int absEventTime5 = na
int absBias15      = 0
int absEvent15     = na
int absEventTime15 = na
if useFvgAbs5Logic
    [_ab, _ae, _at] = request.security(syminfo.tickerid, efvg5MTF, sg.efvgAbsConfirmed(absHold5M, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge, useAbsCandleColor, useAbsBodyFilter, useAbsEdgeFilter), lookahead = barmerge.lookahead_on)
    absBias5      := _ab
    absEvent5     := _ae
    absEventTime5 := _at
if useFvgAbs15Logic
    [_ab, _ae, _at] = request.security(syminfo.tickerid, efvg15MTF, sg.efvgAbsConfirmed(efvgHold15M, efvgMinThick, efvgAbsBodyMin, efvgAbsEdge, useAbsCandleColor, useAbsBodyFilter, useAbsEdgeFilter), lookahead = barmerge.lookahead_on)
    absBias15      := _ab
    absEvent15     := _ae
    absEventTime15 := _at

// 1M BOS : FVGABS5 用。既存の1分足トリガー取得とは式が違うため共有できない。
//  ★ Bullish (Long用) と Bearish (Short用) を1回の request で同時に取る。
//    sg.bosPack() は Zone BOS と同じ式で、Bullish 側の計算は従来の
//    sg.bosBullLowerTf() と完全に同一 (close > ta.highest(high, n)[1])。
//    → request.security_lower_tf の呼び出し数は増えない。
//  ★ na配列を渡すと updateFvgAbs 内の array.size() が RE10052 になるため、
//    取得しない場合も必ず「空配列」で初期化する。
array<bool> absBos1m  = array.new_bool()
array<bool> absBos1mS = array.new_bool()
if useFvgAbs5Logic
    [_a1b, _a1s] = request.security_lower_tf(syminfo.tickerid, triggerTF, sg.bosPack(absBos1mLookback))
    absBos1m  := _a1b
    absBos1mS := _a1s

// ---- Zone 4Logic 精密判定時間足データ (OHLC + BOS) -------------------------
//  ★ Break だけが Break判定TF (既定 5M・すぐ下で取得)、それ以外はすべて
//    この精密判定TF (既定 1M) で評価する。
//    そのため BOS だけでなく close / high / low も同じ1回の request で取得し、
//    Rebound の接近 / 接触 / 離脱 / BOS、Retest の再武装距離 / Zone接触 /
//    反発確認 (Rejection) / BOS、FakeBreak の完全Reclaim / BOS、
//    fakeBreakMaxBars / waitBars の本数カウントをすべてこの足の確定値で行う。
//    → 「1Mヒゲ抜けでBreakしてしまう」ことは構造的に起きない
//      (Break はこの配列を一切参照しない)。
//  ★ 判定TFがチャート足より下位 (5分足チャートで 1M 等) のときは
//    request.security_lower_tf を使い、そのチャート足に含まれる確定下位足を
//    古い順の配列として受け取る。SignalEngine はその1本ずつを1ステップとして
//    イベントを進める。
//  ★ チャート足以上のTFは request.security + lookahead_off。未来のデータは入らない。
//    判定TF = チャート足なら毎バー1本、上位足なら足が変わったときに1本だけ渡す。
//  ★ BOSの計算式 (sg.zoneTfPack 内) は従来の sg.bosPack と完全に同一。
//    どちらの経路でも request の本数は従来と同じ1本のまま。
bool zbLowerTf = timeframe.in_seconds(zoneBosTf) < timeframe.in_seconds()
bool zbSameTf  = timeframe.in_seconds(zoneBosTf) == timeframe.in_seconds()
//  na配列を array.size() に渡すと RE10052 になるため、必ず空配列で初期化する。
array<float> zbTfC    = array.new_float()
array<float> zbTfH    = array.new_float()
array<float> zbTfL    = array.new_float()
array<bool>  zbBullArr = array.new_bool()
array<bool>  zbBearArr = array.new_bool()
if useZoneAny
    if zbLowerTf
        [_zc, _zh, _zl, _lb, _ls] = request.security_lower_tf(syminfo.tickerid, zoneBosTf, sg.zoneTfPack(zoneBosLookback))
        zbTfC     := _zc
        zbTfH     := _zh
        zbTfL     := _zl
        zbBullArr := _lb
        zbBearArr := _ls
    else
        [_zc2, _zh2, _zl2, _zbb, _zbs] = request.security(syminfo.tickerid, zoneBosTf, sg.zoneTfPack(zoneBosLookback), lookahead = barmerge.lookahead_off)
        //  判定TF = チャート足 → 毎バー1本 (直接計算と完全に同じ値)。
        //  上位足 → その足が切り替わったバーで、直前に確定した1本だけを渡す。
        bool _zNewBar = zbSameTf or nz(ta.change(time(zoneBosTf)), 0) != 0
        if _zNewBar
            array.push(zbTfC,     _zc2)
            array.push(zbTfH,     _zh2)
            array.push(zbTfL,     _zl2)
            array.push(zbBullArr, _zbb)
            array.push(zbBearArr, _zbs)

//  精密判定時間足の秒数。イベント作成時に基準TFとして焼き込む。
int zoneJudgeTfSec = timeframe.in_seconds(zoneBosTf)

// ---- Zone Break判定時間足の確定終値 (Breakだけに使う) ----------------------
//  ★ Break は必ず「Break判定TF (既定 5M) の確定終値」で判定する。high / low は
//    一切見ないので、1Mヒゲ抜けでも1M終値抜けでも Break にはならない。
//  ★ Break判定TF = チャート足 (既定 5M / 5M) のときは、そのチャート足自身の
//    確定終値がそのまま Break判定価格になる。request は1本も増えない。
//    SignalEngine 側は「そのチャート足に含まれる1M sub-bar を全部進めてから、
//    最後に この5M終値で Break を確定する」順序で処理するので、実際の時間順序
//    (1分足5本 → その5分足の確定終値) と完全に一致する。
//  ★ Break判定TF > チャート足 のときだけ request.security を1本使い、その上位足が
//    新しく確定したバーで1回だけ Break判定を行う (lookahead_off なので先読み無し)。
float zbBrkClose = na
bool  zbBrkValid = false
if useZoneAny
    if timeframe.in_seconds(zoneBreakTf) <= timeframe.in_seconds()
        zbBrkClose := close
        zbBrkValid := true
    else
        float _zbc = request.security(syminfo.tickerid, zoneBreakTf, close, lookahead = barmerge.lookahead_off)
        zbBrkClose := _zbc
        zbBrkValid := nz(ta.change(time(zoneBreakTf)), 0) != 0
int zoneBreakTfSec = timeframe.in_seconds(zoneBreakTf)

// 日足レジーム
float drO0 = na
float drH0 = na
float drL0 = na
float drC0 = na
float drO1 = na
float drH1 = na
float drL1 = na
float drC1 = na
float drMedianRange = na
bool  drNewDay = ta.change(time("D")) != 0
if useDailyRegimeFilter
    [_o0, _h0, _l0, _c0, _o1, _h1, _l1, _c1] = request.security(syminfo.tickerid, "D", sg.drDailyTuple(), lookahead = barmerge.lookahead_off)
    drO0 := _o0
    drH0 := _h0
    drL0 := _l0
    drC0 := _c0
    drO1 := _o1
    drH1 := _h1
    drL1 := _l1
    drC1 := _c1
//  ★ 日足ボラ中央値は吸収系列の環境条件でも使うため、日足レジームフィルタが OFF でも
//    吸収系列がONなら取得する。同一 (TF, 式) を重複requestしないよう1本に統合。
//    updateFvg 側は c.useDailyRegimeFilter の中でしか参照しないので既存判定は不変。
//  ★ Zone 4系列 も日足ボラ中央値を使う (閾値だけ専用) ので、日足レジームフィルタが
//    OFF でも Zone系がONなら取得する。同一 (TF, 式) を1本に統合したまま。
if useDailyRegimeFilter or absAnyOn or useZoneAny
    drMedianRange := request.security(syminfo.tickerid, "D", sg.dailyRangeMedian(dailyVolMedianLength), lookahead = barmerge.lookahead_on)

// Accumulation NoTrade (15分足の確定Accum箱)
float acc15Hi = na
float acc15Lo = na
int   acc15St = na
bool  accNew15Bar = false
if useAccumNoTrade and useAccumNT15M
    [_h15, _l15, _s15] = request.security(syminfo.tickerid, accumNT15Tf, sg.accumNT15Confirmed(fvgAccCfg, accumNTRangeLen, accumNTBaseLen, accumNTAtrLen), lookahead = barmerge.lookahead_on)
    acc15Hi := _h15
    acc15Lo := _l15
    acc15St := _s15
    accNew15Bar := ta.change(time(accumNT15Tf)) != 0

sg.FvgFeed fvgFeed = sg.FvgFeed.new(
     allowLong = useFvgLogic and enableLong, allowShort = useFvgLogic and enableShort,
     sessionOk = sessionOk, newsOk = allowByNewsTime,
     bullTrig = fvgBullTrig, bearTrig = fvgBearTrig,
     baseAtr = fvgBaseAtr,
     env4H = env4H, env1H = env1H, env15M = env15M, env5M = env5M, env1M = env1M,
     dBias = efvgDBias, dReason = efvgDReason, dRem = efvgDRem, dBos = efvgDBos,
     hBias = efvgHBias, hReason = efvgHReason, hRem = efvgHRem, hBos = efvgHBos,
     oBias = efvgOBias, oReason = efvgOReason, oRem = efvgORem, oBos = efvgOBos,
     b5Bias = efvg5Bias, b5Reason = efvg5Reason, b5Rem = efvg5Rem, b5Bos = efvg5Bos,
     b1Bias = efvg1Bias, b1Reason = efvg1Reason, b1Rem = efvg1Rem, b1Bos = efvg1Bos,
     mRawBias = efvgMRawBias, mRawReason = efvgMRawReason, mRawRem = efvgMRawRem, mRawBos = efvgMRawBos,
     drO0 = drO0, drH0 = drH0, drL0 = drL0, drC0 = drC0,
     drO1 = drO1, drH1 = drH1, drL1 = drL1, drC1 = drC1,
     drMedianRange = drMedianRange, drNewDay = drNewDay,
     acc15Hi = acc15Hi, acc15Lo = acc15Lo, acc15St = acc15St, new15Bar = accNew15Bar)

// FVG15 Logic 用 Feed。中身は上の fvgFeed と同じ「計算結果」をそのまま共有し、
// Logic ON/OFF を表す allowLong / allowShort だけ差し替える。
// → request.security は1本も増えない。共有するのは計算結果だけで、
//   Armed / Consumed 等の Logic固有state は Engine 側で完全に分離している。
sg.FvgFeed fvg15Feed = fvgFeed.copy()
fvg15Feed.allowLong  := useFvg15Logic and enableLong
fvg15Feed.allowShort := useFvg15Logic and enableShort
// 15M反発の生の状態だけ、FVG15専用 (保持本数 fvg15Hold) の値に差し替える。
// 既存 fvgFeed 側は efvgHold15M ベースのまま = 既存5M Logic は影響を受けない。
fvg15Feed.mRawBias   := fvg15RawBias
fvg15Feed.mRawReason := fvg15RawReason
fvg15Feed.mRawRem    := fvg15RawRem
fvg15Feed.mRawBos    := fvg15RawBos

// ============================================================================
// 04. RISK / QTY
// ----------------------------------------------------------------------------
//  Qty は必ず Structural SL距離 から計算する。Long / Short 共通。構造は不変:
//     Risk Capital ÷ Structural SL距離 ÷ syminfo.pointvalue → qtyStep単位に切り下げ
//
//  ★★ 単位についての重要な注意 ★★
//   TradingView の qty は「銘柄の取引単位」であって、FXブローカーの "lot" ではない。
//   両者が一致する保証はないので、qtyStep = 0.01 を 0.01 lot と読み替えてはいけない。
//
//   TradingView の損益計算式:
//       損益 = (決済価格 - Entry価格) × qty × syminfo.pointvalue
//   したがって SL到達時の想定損失は
//       Expected SL Loss = SL距離 × qty × syminfo.pointvalue
//   であり、qty を上式で決めれば Expected SL Loss ≒ Risk Capital になる。
//
//   XAUUSD (CFD/FX系) では通常 syminfo.pointvalue = 1 で、qty の単位は「1オンス」。
//   一般的なFXの 1 lot = 100オンス なので qty 1.00 ≒ 0.01 lot 相当になる。
//   一方 GC等の先物では pointvalue = 100 のことがあり、その場合 qty の意味が変わる。
//   → 実際の値は Debug の "QTY" 行 (PV = syminfo.pointvalue) で必ず確認すること。
//
//  ★ 想定損失と実損失がズレる要因 (コード側では解消できないもの) ★
//   ・Qtyは「シグナル足のclose (= plan.entry)」基準だが、成行の約定は次足始値。
//   ・qtyStep への切り下げ分だけ、実損失は Risk Capital をわずかに下回る。
//   ・手数料 / スリッページ / SL突破は Risk Capital に含まれていない。
//   ・account_currency と銘柄の通貨が異なる場合、TradingViewが換算するためズレる。
//   → Debug の "QTY" 行に、直近SL決済の実損益 (LastSL) も表示して突合できるようにした。
// ============================================================================
f_baseCapital() =>
    useCompound ? strategy.equity : strategy.initial_capital

f_riskCapital() =>
    f_baseCapital() * riskPct / 100.0

f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? f_riskCapital() / (riskPerUnit * syminfo.pointvalue) : 0.0
    // qtyStep 単位へ切り下げ (0.01 等の小数ロットを潰さない)。
    // 浮動小数の誤差で 0.30000000000004 のような値にならないよう丸めておく。
    float q = qtyStep > 0 ? math.floor(raw / qtyStep) * qtyStep : raw
    math.round(q, 8)

// SL到達時の想定損失額 (TradingViewの損益式と同じ形)
f_expectedLoss(float qty, float slDist) =>
    nz(qty) * nz(slDist) * syminfo.pointvalue

// ============================================================================
// 05. COMMON TRADE ENGINE
// ----------------------------------------------------------------------------
//  Entry ID生成 / Qty計算 / 発注 / SL-TP固定 を一括で持つ唯一の場所。
//  Entry Logic (SignalEngine) 側には strategy.entry / strategy.exit /
//  SL計算 / TP計算 / 勝敗管理を一切書かない。
// ============================================================================
//  Entry ID 書式 : <LOGIC_ID>_L_<seq> / <LOGIC_ID>_S_<seq>
//     例 : FVG_L_1 / FVG_S_2 / EMA_REJECT_L_3 / MACD_L_5
//  → List of Trades からどのLogicのトレードか判別できる。
//  → 将来 strategy.closedtrades.entry_id() を接頭辞で振り分ければ
//     Logic別の勝率 / PF / 連敗 / Profit を後から追加できる。
// ============================================================================

var array<int> gSeq = array.new_int(1, 0)
//  gTradeTP : 各 Entry ID の「現在有効なTP」。Entry時は p.tp、Dynamic TP更新後は
//             更新後の値が入る。Break Even の TP再指定もこの値を使うため、
//             BE発動後も必ず Dynamic TP 適用後の最新TPが使われる。
var map<string, float> gTradeTP = map.new<string, float>()
//  gTradeSL : 各 Entry ID の Entry時 Structural SL。Dynamic TP で strategy.exit を
//             再発行するときに「BE未発動ならこのSL」を復元するために保持する。
//             SL自体は一切可変化しない (BE発動時のみ既存仕様どおりEntry価格へ)。
var map<string, float> gTradeSL = map.new<string, float>()
var map<string, bool>  gTradeBE = map.new<string, bool>()
// ★ 表示・通知専用 : 実発注した Entry ID → その発注に使った TradePlan の値。
//   ラベルと確定アラートが「strategy.entry / strategy.exit へ実際に渡した値」を
//   そのまま表示するためだけの受け渡し。Entry判定には一切使わない。
//   Section 10 の確定アラートが読んだ時点で削除する (Mapが増え続けないように)。
var map<string, float> gAlEntry = map.new<string, float>()
var map<string, float> gAlSl    = map.new<string, float>()
var map<string, float> gAlTp    = map.new<string, float>()
var map<string, float> gAlRr    = map.new<string, float>()
var array<string> gLastPlan = array.new_string(3, "-")

f_openCountForLogic(string logicId) =>
    int c = 0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string oid = strategy.opentrades.entry_id(i)
            // "<LOGIC>_L_" / "<LOGIC>_S_" で厳密に判定する (別Logicの前方一致を拾わない)
            if str.startswith(oid, logicId + "_L_") or str.startswith(oid, logicId + "_S_")
                c += 1
    c

// LOGIC_FVG と LOGIC_FVG15 を「1つのポジショングループ」として数える。
//  この2Logic合計で同時保有は最大1ポジション (Long/Short問わず)。
//  Strategy全体の pyramiding は変更しない。他のLogicにはこの制限を適用しない。
f_openCountFvgGroup() =>
    int c = 0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string oid = strategy.opentrades.entry_id(i)
            bool isGrp = str.startswith(oid, LOGIC_FVG + "_L_") or str.startswith(oid, LOGIC_FVG + "_S_")
            isGrp := isGrp or str.startswith(oid, LOGIC_FVG15 + "_L_") or str.startswith(oid, LOGIC_FVG15 + "_S_")
            if isGrp
                c += 1
    c

// LOGIC_FVG_ABS5 と LOGIC_FVG_ABS15 を「もう1つのポジショングループ」として数える。
//  吸収系列 合計で同時保有は最大1ポジション。反発系列とは完全に別Group。
//  ★ str.startswith(oid, "FVG") のような曖昧判定は使わない。必ず
//    "<LOGIC_ID>_L_" / "<LOGIC_ID>_S_" の完全な接頭辞で判定する。
//    ("FVGABS15_L_1" が "FVGABS5_L_" に一致することも、反発側の "FVG_L_" /
//     "FVG15_L_" が吸収側に一致することも無い。)
f_openCountFvgAbsGroup() =>
    int c = 0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            string oid = strategy.opentrades.entry_id(i)
            bool isGrp = str.startswith(oid, LOGIC_FVG_ABS5 + "_L_") or str.startswith(oid, LOGIC_FVG_ABS5 + "_S_")
            isGrp := isGrp or str.startswith(oid, LOGIC_FVG_ABS15 + "_L_") or str.startswith(oid, LOGIC_FVG_ABS15 + "_S_")
            if isGrp
                c += 1
    c

// Zone 4系列は「1Logic = 1Group」。共通の保有数カウンタ f_openCountForLogic() を
//  そのまま使う ("ZONEREBOUND_L_" 等の完全な接頭辞で判定するので混ざらない)。
//  → ZONEREBOUND / ZONEFAKE / ZONERETEST / ZONEBREAK は互いに独立して保有できる。

f_planText(string logicId, zn.TradePlan p) =>
    logicId + " " + (p.dir > 0 ? "LONG" : p.dir < 0 ? "SHORT" : "-") +
     " | E " + f_num(p.entry, "#.##") +
     " | SL " + f_num(p.sl, "#.##") +
     " | TP " + f_num(p.tp, "#.##") +
     " | RR " + f_num(p.rr, "#.##") +
     " | " + p.tpType +
     " | Obst " + str.tostring(p.obstacles)

// Qty検証用のテキスト (Risk Capital / SL Distance / Calculated Qty / Expected SL Loss)
f_qtyText(zn.TradePlan p) =>
    float rc = f_riskCapital()
    float q  = f_qty(p.risk)
    float el = f_expectedLoss(q, p.risk)
    float bc = f_baseCapital()
    "RiskCap " + f_num(rc, "#.##") + " (" + f_num(riskPct, "#.##") + "%)" +
     " | SLdist " + f_num(p.risk, "#.##") +
     " | Qty " + f_num(q, "#.####") +
     " | ExpLoss " + f_num(el, "#.##") +
     " (" + f_num(bc > 0 ? el / bc * 100.0 : na, "#.###") + "% of capital)" +
     " | PV " + str.tostring(syminfo.pointvalue) + " " + syminfo.currency +
     " / Acct " + strategy.account_currency +
     (syminfo.currency != strategy.account_currency ? " ※通貨換算あり(損失額がズレる)" : "")

f_recordPlan(string logicId, zn.TradePlan p, string extra) =>
    array.set(gLastPlan, 0, f_planText(logicId, p))
    array.set(gLastPlan, 1, p.status + " · " + p.reason + (extra == "" ? "" : " · " + extra))
    array.set(gLastPlan, 2, f_qtyText(p))
    true

// ★ ここが唯一 strategy.entry / strategy.exit を呼ぶ場所。
//   Entry時点の Structural SL / TP (または Fallback TP) を strategy.exit へ
//   渡して固定する。以後Zoneが動いても、そのトレードのSL/TPは変更しない。
f_executeTrade(string logicId, int dir, float entryPrice, zn.TradePlan p) =>
    string eid  = ""
    bool   done = false
    // ★ Gold Only : Gold以外では発注も Entry Debug Label も行わず eid = "" を返す。
    //   eid が "" なら確定アラート / ラベル / Break Even 登録も全て起きない。
    if isGold and dir != 0
        if not p.valid
            // Structural SL無し / RR不足 など → 発注しない (理由はDebugへ)
            f_recordPlan(logicId, p, "")
            done := true
        else
            float qty = f_qty(p.risk)
            bool oppositeConflict = not allowOppositeEntry and
                 ((dir > 0 and strategy.position_size < 0) or (dir < 0 and strategy.position_size > 0))
            bool logicFull = f_openCountForLogic(logicId) >= maxOpenPerLogic
            if logicFull
                f_recordPlan(logicId, p, "SKIP_LOGIC_LIMIT")
                done := true
            else if oppositeConflict
                f_recordPlan(logicId, p, "SKIP_OPPOSITE_POSITION")
                done := true
            else if qty < qtyMin or qty <= 0
                f_recordPlan(logicId, p, "SKIP_NO_QTY")
                done := true
            else
                int n = array.get(gSeq, 0) + 1
                array.set(gSeq, 0, n)
                eid := logicId + (dir > 0 ? "_L_" : "_S_") + str.tostring(n)
                strategy.entry(eid, dir > 0 ? strategy.long : strategy.short, qty = qty)
                // ★ Entry時点の SL / TP をここで固定する。以後Zoneが変化しても更新しない。
                strategy.exit(eid + "X", from_entry = eid, stop = p.sl, limit = p.tp,
                     comment_profit = "TP", comment_loss = "SL")
                //  ★ TP / SL の控えは Break Even とは独立に必ず登録する。
                //    Dynamic TP は BE OFF でも動く必要があるため。
                //    (Map へ入れるだけで、FIXED では誰も読まない = 発注は不変)
                gTradeTP.put(eid, p.tp)
                gTradeSL.put(eid, p.sl)
                if useBreakEven
                    gTradeBE.put(eid, false)
                f_recordPlan(logicId, p, eid)
                // ★ 表示・通知専用の控え。実発注に使った p の値をそのまま保存する。
                //   ラベルも確定アラートもこの値だけを使い、SL/TP/RRを別計算しない。
                gAlEntry.put(eid, p.entry)
                gAlSl.put(eid,    p.sl)
                gAlTp.put(eid,    p.tp)
                gAlRr.put(eid,    p.rr)
                if showEntryLabel
                    // ★ ここは実発注が確定した直後の表示だけ。条件判定は一切していない。
                    //   E / SL / TP / RR は strategy.exit へ渡した p の値そのもの。
                    //   E-SL は価格距離として math.abs(p.entry - p.sl) で表示する。
                    string ltxt = (dir > 0 ? "LONG" : "SHORT")
                    ltxt := ltxt + "\nE     " + f_num(p.entry, "#.##")
                    ltxt := ltxt + "\nSL    " + f_num(p.sl, "#.##")
                    ltxt := ltxt + "\nTP    " + f_num(p.tp, "#.##")
                    ltxt := ltxt + "\nE-SL  " + f_num(math.abs(p.entry - p.sl), "#.##")
                    ltxt := ltxt + "\nRR    " + f_num(p.rr, "#.##")
                    ltxt := ltxt + "\nLogic " + f_logicName(logicId)
                    ltxt := ltxt + "\n" + eid + " · Qty " + f_num(qty, "#.####")
                    ltxt := ltxt + " · Loss~ " + f_num(f_expectedLoss(qty, p.risk), "#.##")
                    ltxt := ltxt + " · " + p.tpType
                    label.new(bar_index, dir > 0 ? low : high, text = ltxt,
                         style = dir > 0 ? label.style_label_up : label.style_label_down,
                         color = dir > 0 ? color.new(color.teal, 20) : color.new(color.maroon, 20),
                         textcolor = color.white, size = size.small)
                done := true
    done ? eid : ""

// ---- Entry Signal → 発注 の共通パイプライン -------------------------------
//  Entry Module は logicId / signal / direction / entryPrice だけを渡す。
//  Zone Libraryへの問い合わせ → Structural SL確認 → Structural TP / Fallback TP
//  → RR確認 → Risk Qty計算 → strategy.entry → strategy.exit は全てここ。
f_submitSignal(string logicId, bool signal, int dir, float entryPrice) =>
    string eid = ""
    bool dirOk = (dir > 0 and enableLong) or (dir < 0 and enableShort)
    if signal and dirOk
        zn.TradePlan p = zn.buildPlan(zoneEng, zoneCfg, dir, entryPrice)
        p.logicId := logicId
        // ---- TP Mode フィルター (Structural / Fallback の成績切り分け用) ----------
        //  buildPlan() の判定順 (ActiveZone → SL無し → SL不正 → SL距離超過 → TP判定)
        //  には一切手を入れない。ここでやるのは確定したPlanの「採用可否」だけ。
        //  ・PASS → FAIL の一方向のみ。FAIL → PASS への昇格は絶対に行わない。
        //  ・p.tpType は SL判定を全て通過した場合にのみ "STRUCTURAL" / "FALLBACK_RR"
        //    が入るため、SL段階のFAIL理由 (NO_SL_ZONE / SL_TOO_FAR 等) を
        //    この分岐が上書きすることはない (その場合 tpType は "-" のまま)。
        //  ・LOW_STRUCTURAL_RR で既にFAILしたPlanもここでは復活しない
        //    (minStructRR の意味は変更しない)。
        if tpMode == "STRUCTURAL_ONLY" and p.tpType == "FALLBACK_RR"
            // Structural TP Zoneが無かったシグナル → Fallback TPを作らずNoTrade
            p.valid  := false
            p.status := "FAIL"
            p.reason := "NO_STRUCTURAL_TP"
        else if tpMode == "FALLBACK_ONLY" and p.tpType == "STRUCTURAL"
            // Structural TPが存在するシグナル自体を除外する。
            // ※ Structural TPを無視して強制的にRR TPへ差し替える処理ではない。
            p.valid  := false
            p.status := "FAIL"
            p.reason := "STRUCTURAL_TP_EXISTS"
        eid := f_executeTrade(logicId, dir, entryPrice, p)
    eid
// ============================================================================
// 06. SIGNAL ENGINE CALLS
// ----------------------------------------------------------------------------
//  各 Entry Logic の計算は SignalEngine Library が行う。
//  Main は Cfg / Feed を渡して Signal を受け取るだけで、内部の判定は知らない。
//
//  期間系 (simple int) を明示的に渡すのは、UDTフィールドが series 修飾になり
//  ta.atr(length) 等へ渡せないため。値は Section 01 の input のまま渡している。
//
//  Logicを追加する場合はここに1行追加する:
//     sg.EmaSignal emaSig = sg.updateEma(emaEng, emaCfg, emaFeed, emaLen)
// ============================================================================
// ---- 6.1 FVG Logic (既存5M・変更なし) --------------------------------------
sg.FvgSignal fvgSig = sg.updateFvg(fvgEng, fvgCfg, fvgTrigCfg, fvgAccCfg, fvgFeed,
     engulfAtrLen, pinRangeAtrLen, bosLookback,
     emaLenTrigger, emaRejectSlopeLookback, emaRejectSlopeAtrLen,
     volAvgLen, fastAtrLen, bodyAvgLen, rangeLookback,
     accumNTRangeLen, accumNTBaseLen, accumNTAtrLen)

// ---- 6.2 FVG15 Logic (15M FVG反発 → 5M BOS) --------------------------------
//  (a) 環境認識 / Session / News / ボラ / Accum / Daily Regime / Armed は
//      既存と同じ updateFvg() を使って計算する。ただし Engine も Cfg も Feed も
//      別インスタンスなので、既存5M Logicの状態とは一切混ざらない。
//      fvg15Cfg は FVG環境認識のTFだけ 15M に差し替えてある (5M FVGはOFF)。
//      → 共通計算を二重に書かず、追加元の「現在ONのFilter」をそのまま再現できる。
//  (b) その上に「15M FVG反発 → その反発足の開始以降の5M BOS」という順序ゲートを
//      updateFvg15() でかける。ここだけが FVG15 固有のロジック。
//  ★ useFvg15Logic = OFF のときは計算そのものを行わない ★
//    useFvg15Logic は input なので全バーで同じ値 = 分岐は常に成立/常に不成立。
//    「あるバーだけ評価されない」ことは起こらないため、内部の ta.* / var の
//    履歴がズレることはない (既存コードの useEngulfingTrigger 等と同じ形)。
//    OFF時は updateFvg の2回目 (ta.*14回 / forループ7本 / 配列操作46回) が
//    まるごと不要になり、既存5M単体のチャート更新時間は追加前と同じになる。
//    Signal既定値は longSignal=false / shortSignal=false なので発注もしない。
sg.FvgSignal   fvg15Base = sg.FvgSignal.new()
sg.Fvg15Signal fvg15Sig  = sg.Fvg15Signal.new()
if useFvg15Logic
    fvg15Base := sg.updateFvg(fvg15Eng, fvg15Cfg, fvgTrigCfg, fvgAccCfg, fvg15Feed,
         engulfAtrLen, pinRangeAtrLen, bosLookback,
         emaLenTrigger, emaRejectSlopeLookback, emaRejectSlopeAtrLen,
         volAvgLen, fastAtrLen, bodyAvgLen, rangeLookback,
         accumNTRangeLen, accumNTBaseLen, accumNTAtrLen)
    fvg15Sig  := sg.updateFvg15(fvg15Ord,
         fvg15Base.longSignal, fvg15Base.shortSignal, fvg15Base.entryPrice,
         fvg15RawReason, fvg15RawRem, fvg15RawTime,
         use15mFvgBosOrder, bos15mTo5mLookback)

// ---- 6.3 FVGABS Logic (FVG吸収 → BOS / Long・Short 対称) -------------------
//  ★ 環境条件は「既存 updateFvg (6.1) が計算済みの結果」を再利用して合成する。
//    吸収系列のために updateFvg を追加で呼ばない = 計算量を増やさない。
//      ・上位足環境         : ★ fvgSig.trendOk
//        = 既存「03 · FVG · Trend Env」(useEnvFilter / reqTrend4H / 1H / 15M /
//          5M / 1M / 必要一致TF数) の判定結果そのもの。
//          updateFvg() が1度だけ計算した値を FVG / FVG15 / FVGABS5 / FVGABS15 で
//          共有する → 判定の二重実装なし・input重複なし・request追加なし。
//          5M / 1M も含めて5時間足すべてが選択対象になる。
//          useEnvFilter = false なら trendOk は常に true = 環境フィルター無効。
//      ・日足ボラ中央値     : Section 03 で取得済みの drMedianRange (request増なし)
//      ・Session / News     : Section 03 の共通フィルタ
//      ・ボラ / Accum       : fvgSig.volOk / blockedByAccum / blockedByExitWait /
//                            accumLongDirOk / accumShortDirOk
//                            (updateFvg の出力をそのまま利用)
//  ★ 日足「方向」ゲートは追加しない (仕様どおりボラ範囲のみ)。
//  ★ Long / Short は完全対称。方向設定 (Enable Long / Enable Short) を必ず通す。
//      Long  : Bearish FVG を上方向へ吸収 → Bullish BOS
//      Short : Bullish FVG を下方向へ吸収 → Bearish BOS
//    吸収判定・品質条件・Hold・BOS Lookback・日足ボラ範囲は Long / Short 共通設定。
//  ★ 上位足環境 (reqTrend) は Long / Short 共通の「要求する相場環境」。
//    方向による自動反転は行わない。reqTrend1H = "レンジ" なら Long も Short も
//    1H レンジを要求する (Short だから下降へ読み替える、という処理は入れない)。
//  ★ 環境条件の「判定」は SignalEngine (sg.fvgAbsEnvLong / sg.fvgAbsEnvShort) が
//    持つ。Main は input と取得済みデータを渡すだけ。Long側の条件・順序は従来と同一。
bool absEnvLongOk = sg.fvgAbsEnvLong(enableLong and absAnyOn, fvgSig.trendOk, sessionOk, allowByNewsTime,
     drMedianRange, absVolMin, absVolMax,
     fvgSig.volOk, fvgSig.blockedByAccum, fvgSig.blockedByExitWait, fvgSig.accumLongDirOk)
bool absEnvShortOk = sg.fvgAbsEnvShort(enableShort and absAnyOn, fvgSig.trendOk, sessionOk, allowByNewsTime,
     drMedianRange, absVolMin, absVolMax,
     fvgSig.volOk, fvgSig.blockedByAccum, fvgSig.blockedByExitWait, fvgSig.accumShortDirOk)

//  Logic が両方OFFのときは吸収系列の計算そのものを行わない (input なので分岐は一定)。
sg.FvgAbsSignal absSig = sg.FvgAbsSignal.new()
if absAnyOn
    absSig := sg.updateFvgAbs(fvgAbsEng, absEnvLongOk, absEnvShortOk, close,
         absBias5, absEvent5, absEventTime5,
         absBias15, absEvent15, absEventTime15,
         absBos1m, absBos1mS, useFvgAbs5Logic, useFvgAbs15Logic, absBos5mLookback)

// ---- 6.4 Zone 4-Logic (Rebound / FakeBreak / Break Retest / Break) ---------
//  ★ Zoneの検索・Strengthフィルタ・Support/Resistance判定は「ZoneEngine を
//    import している Main」で行い、結果 (スナップショット) だけを SignalEngine へ渡す。
//    SignalEngine から ZoneEngine を import して密結合させない構造を維持する。
//  ★ ZoneEngine の Zone生成 / Score / Strength / State のルールは変更しない。
//  ★ 接近方向 (上から / 下から) の判定・状態遷移・4Logicへの振り分けは
//    SignalEngine (sg.updateZoneEvents) が持つ。Main は input と結果を渡すだけ。
int zoneMinStrength = zn.strengthIdx(zoneBosMinStrStr)
array<int>   zSnapId   = array.new_int()
array<int>   zSnapSide = array.new_int()
array<float> zSnapTop  = array.new_float()
array<float> zSnapBot  = array.new_float()
//  ★ Strength / Score も一緒に渡す。SignalEngine はイベント作成時にこれを凍結し、
//    Debug表示が「有効Zone」と「追跡中Event」で別Zoneを指さないようにする。
array<int>   zSnapStr   = array.new_int()
array<float> zSnapScore = array.new_float()
if useZoneAny
    int zSnapN = zn.zoneCount(zoneEng)
    if zSnapN > 0
        for zsI = 0 to zSnapN - 1
            zn.Zone zsZ = zn.zoneAt(zoneEng, zsI)
            //  対象Strength以上の Support / Resistance Zone だけを渡す。
            //  ここでは重なりもnearest制限もせず、Live Zoneを全部渡す。
            //  どのZoneでイベントを開始したかは SignalEngine が trackId で追跡する。
            if zsZ.strength >= zoneMinStrength and (zsZ.state == ST_SUPPORT or zsZ.state == ST_RESIST)
                array.push(zSnapId,   zsZ.trackId)
                array.push(zSnapSide, zsZ.state == ST_SUPPORT ? 1 : -1)
                array.push(zSnapTop,  zsZ.top)
                array.push(zSnapBot,  zsZ.bottom)
                array.push(zSnapStr,   zsZ.strength)
                array.push(zSnapScore, zsZ.score)

//  各Zone Logicの保有状況。4Logicそれぞれが独立したGroup (各最大1ポジション)。
//  FVG系列の保有状況とは無関係。
bool zrbOpen = false
bool zfkOpen = false
bool zrtOpen = false
bool zbkOpen = false
if useZoneRebound
    zrbOpen := f_openCountForLogic(LOGIC_ZONE_RB) > 0
if useZoneFake
    zfkOpen := f_openCountForLogic(LOGIC_ZONE_FK) > 0
if useZoneRetest
    zrtOpen := f_openCountForLogic(LOGIC_ZONE_RT) > 0
if useZoneBreak
    zbkOpen := f_openCountForLogic(LOGIC_ZONE_BK) > 0

//  ---- 共通Cfg -----------------------------------------------------------
sg.ZoneCommonCfg zoneCmnCfg = sg.newZoneCommonCfg()
zoneCmnCfg.enableLong          := enableLong
zoneCmnCfg.enableShort         := enableShort
zoneCmnCfg.useRebound          := useZoneRebound
zoneCmnCfg.useFake             := useZoneFake
zoneCmnCfg.useRetest           := useZoneRetest
zoneCmnCfg.useBreak            := useZoneBreak
zoneCmnCfg.reqDailyVol         := zoneBosReqDailyVolatility
zoneCmnCfg.dailyLowVol         := zoneBosDailyLowVolThreshold
zoneCmnCfg.dailyHighVol        := zoneBosDailyHighVolThreshold
zoneCmnCfg.insufficientAsRange := dailyInsufficientAsRange
zoneCmnCfg.breakBuffer         := zoneBreakBuffer
zoneCmnCfg.fakeMaxBars         := fakeBreakMaxBars
zoneCmnCfg.retestMinDist       := retestMinDistance
zoneCmnCfg.retestWidthMult     := retestZoneWidthMultiplier
zoneCmnCfg.waitBars            := zoneBosWaitBars
zoneCmnCfg.minMoveAway         := zoneBosMinMoveAway

//  ---- Zone系専用 高速ボラ (FVG系列の fastVolMode とは完全に独立) ----------
//    ★ 分離したのは「モード」だけ。判定式と各パラメータ
//      (fastAtrLen / fastAtrMin / fastFixedMin / bodyAvgLen / bodyAvgMin /
//       useRangeRatioFilter / rangeLookback / atrRangeRatioMin) は FVG系列と
//      同じものを共有する。
//    ★ 通常ボラ (volMode / useMinVol / minAtrDollar / volModeRel / volRatioMin /
//      fixedMin) と 低ボラ解除待機 (useVolCooldown / volRecoveryBars) の判定式も
//      SignalEngine の updateFvg 内と1行ずつ同一。したがって
//      zoneFastVolMode == fastVolMode のときは zoneVolOk == fvgSig.volOk になる。
//    ★ zoneFastVolMode == "OFF" なら zoneFastVolPass は常に true。
//      高速ボラ条件で Zone 4Logic のEntryが弾かれることはない。
//    ★ request は1つも増やさない (基準ATRは Section 03 の fvgBaseAtr を共有)。
bool zoneBaseVolOk = true
if volMode == "ATR"
    float zAtrAvg   = ta.sma(fvgBaseAtr, volAvgLen)
    bool  zVolAbsOk = fvgBaseAtr >= minAtrDollar
    bool  zVolRelOk = zAtrAvg > 0 and fvgBaseAtr >= zAtrAvg * volRatioMin
    zoneBaseVolOk := not useMinVol or (volModeRel ? zVolRelOk : zVolAbsOk)
else if volMode == "固定値"
    zoneBaseVolOk := (high - low) >= fixedMin

bool zoneFastVolPass = true
if zoneFastVolMode == "ATR"
    float zFastAtr       = ta.atr(fastAtrLen)
    float zBodyAvgFast   = ta.sma(math.abs(close - open), bodyAvgLen)
    float zRangeWidthV   = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float zAtrRangeRatio = zRangeWidthV > 0 ? zFastAtr / zRangeWidthV : 0.0
    bool  zFastAtrOk     = zFastAtr >= fastAtrMin
    bool  zBodyAvgOk     = zBodyAvgFast >= bodyAvgMin
    bool  zRangeRatioOk  = not useRangeRatioFilter or zAtrRangeRatio >= atrRangeRatioMin
    zoneFastVolPass := zFastAtrOk and zBodyAvgOk and zRangeRatioOk
else if zoneFastVolMode == "固定値"
    float zFastRange     = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float zBodyAvgFast   = ta.sma(math.abs(close - open), bodyAvgLen)
    bool  zFastRangeOk   = zFastRange >= fastFixedMin
    bool  zBodyAvgOk     = zBodyAvgFast >= bodyAvgMin
    zoneFastVolPass := zFastRangeOk and zBodyAvgOk

//    低ボラ解除後の待機も Zone系専用に持つ (FVG系列の state とは別物)。
//    useVolCooldown = false のときは常に true なので既存挙動と変わらない。
var int  zoneVolRecoveryStartBar = na
var bool zonePrevVolLow          = false
bool zoneVolPassRaw = zoneBaseVolOk and zoneFastVolPass
bool zoneVolLowNow  = not zoneVolPassRaw
if zoneVolLowNow
    zoneVolRecoveryStartBar := na
if not zoneVolLowNow and zonePrevVolLow
    zoneVolRecoveryStartBar := bar_index
bool zoneVolRecoveryOk = not useVolCooldown or na(zoneVolRecoveryStartBar) or (bar_index - zoneVolRecoveryStartBar) >= volRecoveryBars
bool zoneVolOk = zoneVolPassRaw and zoneVolRecoveryOk
zonePrevVolLow := zoneVolLowNow

//  ---- 共通フィルタの「結果」だけを渡す (再計算も request も増やさない) ----
//    Session / News        : Section 03 の共通フィルタ
//    通常ボラ + 高速ボラ   : zoneVolOk (Zone系専用。FVG系列の fvgSig.volOk とは
//                            高速ボラのモードだけが独立している)
//    Accum NoTrade / 離脱待機 / 離脱方向 : fvgSig.* の出力
//    環境認識 4H/1H/15M    : Section 03 で取得済みの env4H / env1H / env15M
//    日足ボラ中央値        : Section 03 で取得済みの drMedianRange
sg.ZoneEnvFeed zoneEnvFeed = sg.ZoneEnvFeed.new(
     sessionOk = sessionOk, newsOk = allowByNewsTime,
     volOk = zoneVolOk,
     blockedByAccum = fvgSig.blockedByAccum, blockedByExitWait = fvgSig.blockedByExitWait,
     accumLongDirOk = fvgSig.accumLongDirOk, accumShortDirOk = fvgSig.accumShortDirOk,
     env4H = env4H, env1H = env1H, env15M = env15M,
     drMedianRange = drMedianRange)

//  ---- ロジック別・方向別の上位足環境設定 (8個・完全独立) ------------------
sg.ZoneTfEnvCfg zcRbL = sg.ZoneTfEnvCfg.new(
     up4H  = zrbL4Up, rg4H  = zrbL4Rg, dn4H  = zrbL4Dn,
     up1H  = zrbL1Up, rg1H  = zrbL1Rg, dn1H  = zrbL1Dn,
     up15M = zrbLmUp, rg15M = zrbLmRg, dn15M = zrbLmDn,
     useAnd = zrbLAnd)
sg.ZoneTfEnvCfg zcRbS = sg.ZoneTfEnvCfg.new(
     up4H  = zrbS4Up, rg4H  = zrbS4Rg, dn4H  = zrbS4Dn,
     up1H  = zrbS1Up, rg1H  = zrbS1Rg, dn1H  = zrbS1Dn,
     up15M = zrbSmUp, rg15M = zrbSmRg, dn15M = zrbSmDn,
     useAnd = zrbSAnd)
sg.ZoneTfEnvCfg zcFkL = sg.ZoneTfEnvCfg.new(
     up4H  = zfkL4Up, rg4H  = zfkL4Rg, dn4H  = zfkL4Dn,
     up1H  = zfkL1Up, rg1H  = zfkL1Rg, dn1H  = zfkL1Dn,
     up15M = zfkLmUp, rg15M = zfkLmRg, dn15M = zfkLmDn,
     useAnd = zfkLAnd)
sg.ZoneTfEnvCfg zcFkS = sg.ZoneTfEnvCfg.new(
     up4H  = zfkS4Up, rg4H  = zfkS4Rg, dn4H  = zfkS4Dn,
     up1H  = zfkS1Up, rg1H  = zfkS1Rg, dn1H  = zfkS1Dn,
     up15M = zfkSmUp, rg15M = zfkSmRg, dn15M = zfkSmDn,
     useAnd = zfkSAnd)
sg.ZoneTfEnvCfg zcRtL = sg.ZoneTfEnvCfg.new(
     up4H  = zrtL4Up, rg4H  = zrtL4Rg, dn4H  = zrtL4Dn,
     up1H  = zrtL1Up, rg1H  = zrtL1Rg, dn1H  = zrtL1Dn,
     up15M = zrtLmUp, rg15M = zrtLmRg, dn15M = zrtLmDn,
     useAnd = zrtLAnd)
sg.ZoneTfEnvCfg zcRtS = sg.ZoneTfEnvCfg.new(
     up4H  = zrtS4Up, rg4H  = zrtS4Rg, dn4H  = zrtS4Dn,
     up1H  = zrtS1Up, rg1H  = zrtS1Rg, dn1H  = zrtS1Dn,
     up15M = zrtSmUp, rg15M = zrtSmRg, dn15M = zrtSmDn,
     useAnd = zrtSAnd)
sg.ZoneTfEnvCfg zcBkL = sg.ZoneTfEnvCfg.new(
     up4H  = zbkL4Up, rg4H  = zbkL4Rg, dn4H  = zbkL4Dn,
     up1H  = zbkL1Up, rg1H  = zbkL1Rg, dn1H  = zbkL1Dn,
     up15M = zbkLmUp, rg15M = zbkLmRg, dn15M = zbkLmDn,
     useAnd = zbkLAnd)
sg.ZoneTfEnvCfg zcBkS = sg.ZoneTfEnvCfg.new(
     up4H  = zbkS4Up, rg4H  = zbkS4Rg, dn4H  = zbkS4Dn,
     up1H  = zbkS1Up, rg1H  = zbkS1Rg, dn1H  = zbkS1Dn,
     up15M = zbkSmUp, rg15M = zbkSmRg, dn15M = zbkSmDn,
     useAnd = zbkSAnd)

sg.ZoneEnvSet zoneEnvSet = sg.ZoneEnvSet.new(
     rbLong = zcRbL, rbShort = zcRbS,
     fkLong = zcFkL, fkShort = zcFkS,
     rtLong = zcRtL, rtShort = zcRtS,
     bkLong = zcBkL, bkShort = zcBkS)

sg.ZoneLogicSignal zlSig = sg.ZoneLogicSignal.new()
if useZoneAny
    zlSig := sg.updateZoneEvents(zoneEvtEng, zoneCmnCfg, zoneEnvFeed, zoneEnvSet,
         zSnapId, zSnapSide, zSnapTop, zSnapBot, zSnapStr, zSnapScore,
         zbTfC, zbTfH, zbTfL, zbBullArr, zbBearArr,
         zoneJudgeTfSec, zbBrkClose, zbBrkValid, zoneBreakTfSec, close,
         zrbOpen, zfkOpen, zrtOpen, zbkOpen)

// ============================================================================
// 07. ORDER EXECUTION
// ----------------------------------------------------------------------------
//  Signal を共通Trade Engineへ渡すだけ。SL / TP / RR / Qty の計算は書かない。
//  同じバーで複数Logicが成立しても、それぞれ独立したEntry IDで発注される。
// ============================================================================

// ---- 7.0 FVG / FVG15 共通ポジション制御 -----------------------------------
//  この2Logic合計で同時保有は最大1ポジション (Long/Short問わず・同方向追加も禁止)。
//  ★ useFvg15Logic = OFF のときはこのゲート自体を無効にする。
//    → 既存5M Logic単体の挙動 (maxOpenPerLogic による従来の制限のみ) が
//      修正前と完全に一致する。
//  Pine の and は短絡評価されないため、OFF時に opentrades ループが走らないよう
//  if で囲む (結果は同じ)。
bool fvgGroupBlocked = false
if useFvg15Logic
    fvgGroupBlocked := f_openCountFvgGroup() > 0

// ---- 7.1 FVG15 Logic (同一バーでは既存5Mより優先) --------------------------
//  15M を先に処理する。ただし「Signalが出ただけ」では既存5Mを止めない。
//  実際に発注できた (Entry IDが空でない) ときだけ、同バーの5Mを禁止する。
string fvg15EidLong  = f_submitSignal(LOGIC_FVG15, fvg15Sig.longSignal  and not fvgGroupBlocked,  1, fvg15Sig.entryPrice)
string fvg15EidShort = f_submitSignal(LOGIC_FVG15, fvg15Sig.shortSignal and not fvgGroupBlocked and fvg15EidLong == "", -1, fvg15Sig.entryPrice)
bool fvg15Entered = fvg15EidLong != "" or fvg15EidShort != ""

// 15M反発イベントの消費 / 再アーム解除は「実際に発注できた時だけ」。
//  TradePlan FAIL (Active Zone / SL無し / RR不足 / Qty不足 等) で発注できなかった
//  場合はイベントを消費しないので、同じ反発イベントのまま次のチャンスを待てる。
if fvg15EidLong != ""
    sg.consumeFvg15(fvg15Ord, 1)
    if fvg15Base.noTriggerMode
        fvg15Eng.longArmed := false
if fvg15EidShort != ""
    sg.consumeFvg15(fvg15Ord, -1)
    if fvg15Base.noTriggerMode
        fvg15Eng.shortArmed := false

// ---- 7.2 FVG Logic (既存5M) -----------------------------------------------
//  fvg15Entered が true のバーだけ 5M をSKIPする (15M優先)。
//  15M SignalがTradePlan FAILで発注されなかった場合は、ここは通常判定のまま。
string fvgEidLong  = f_submitSignal(LOGIC_FVG, fvgSig.longSignal  and not fvgGroupBlocked and not fvg15Entered,  1, fvgSig.entryPrice)
string fvgEidShort = f_submitSignal(LOGIC_FVG, fvgSig.shortSignal and not fvgGroupBlocked and not fvg15Entered, -1, fvgSig.entryPrice)

// FVG Logic 固有の再アーム解除 (トリガーOFFモード時のみ・実際に発注できた時だけ)
// Armed状態は FvgEngine が持つため、Logic間で混ざらない。
if fvgSig.noTriggerMode and fvgEidLong != ""
    fvgEng.longArmed := false
if fvgSig.noTriggerMode and fvgEidShort != ""
    fvgEng.shortArmed := false

// ---- 7.3 FVGABS Logic (吸収系列) -------------------------------------------
//  ★ 反発系列とは別Group。反発側の fvgGroupBlocked / fvg15Entered を
//    吸収側のBlock条件に入れない (逆も同様)。
//    → 反発 最大1 + 吸収 最大1 = 最大2ポジション同時保有を許可する。
bool fvgAbsGroupBlocked = false
if absAnyOn
    fvgAbsGroupBlocked := f_openCountFvgAbsGroup() > 0

//  同一バーでは Abs15 を優先。ただし「Signalが出ただけ」では Abs5 を止めない。
//  実際に発注できた (Entry IDが空でない) ときだけ同バーの Abs5 を禁止する。
//  ★ 吸収イベントは bias を1つしか持たない (1 = Long / -1 = Short) ため、
//    同一TFで long15 と short15 が同時に true になることはない。
//    Long → Short の順に見て、Longが発注できたらShortは出さない (安全側の重複防止)。
//  ★ FVGABS5 / FVGABS15 は今までどおり同一Group。Long / Short 合計で最大1ポジション
//    (fvgAbsGroupBlocked = f_openCountFvgAbsGroup() > 0 は方向を区別しない)。
string abs15EidLong  = f_submitSignal(LOGIC_FVG_ABS15, absSig.long15  and not fvgAbsGroupBlocked, 1, absSig.entryPrice)
string abs15EidShort = f_submitSignal(LOGIC_FVG_ABS15, absSig.short15 and not fvgAbsGroupBlocked and abs15EidLong == "", -1, absSig.entryPrice)
bool abs15Entered = abs15EidLong != "" or abs15EidShort != ""
string abs5EidLong  = f_submitSignal(LOGIC_FVG_ABS5, absSig.long5  and not fvgAbsGroupBlocked and not abs15Entered, 1, absSig.entryPrice)
string abs5EidShort = f_submitSignal(LOGIC_FVG_ABS5, absSig.short5 and not fvgAbsGroupBlocked and not abs15Entered and abs5EidLong == "", -1, absSig.entryPrice)

//  吸収イベントの消費は「実際に発注できた時だけ」。
//  Active Zone / Structural SL無し / RR不足 / Qty不足 等で Zone TradePlan が
//  FAIL した場合は消費しないので、同じ吸収イベントのまま次のチャンスを待てる。
//  ★ 1イベント = 1方向なので、消費フラグ (ev5Consumed / ev15Consumed) は
//    方向別に分ける必要がない。Long / Short どちらで発注できても同じイベントを消費する。
if abs15EidLong != "" or abs15EidShort != ""
    sg.consumeFvgAbs(fvgAbsEng, 15)
if abs5EidLong != "" or abs5EidShort != ""
    sg.consumeFvgAbs(fvgAbsEng, 5)

// ---- 7.4 Zone 4-Logic (Rebound / FakeBreak / Break Retest / Break) ---------
//  ★ FVG系列とは完全に別Group。FVG側の fvgGroupBlocked / fvg15Entered /
//    fvgAbsGroupBlocked / abs15Entered をここのBlock条件に入れない (逆も同様)。
//  ★ Zone 4Logic も互いに別Group。1つのLogicが保有していても他の3つは入れる。
//    各Logic内だけ Long / Short 合計で最大1ポジション (maxOpenPerLogic)。
//  ★ 保有ゲート (zrbOpen 等) は Section 6.4 で SignalEngine へ渡し済みなので、
//    Signal自体がすでにそのLogicの保有中は出ない。ここでは方向の重複だけ抑える。
string zrbEidLong  = f_submitSignal(LOGIC_ZONE_RB, zlSig.reboundLong,  1, zlSig.entryPrice)
string zrbEidShort = f_submitSignal(LOGIC_ZONE_RB, zlSig.reboundShort and zrbEidLong == "", -1, zlSig.entryPrice)

string zfkEidLong  = f_submitSignal(LOGIC_ZONE_FK, zlSig.fakeLong,  1, zlSig.entryPrice)
string zfkEidShort = f_submitSignal(LOGIC_ZONE_FK, zlSig.fakeShort and zfkEidLong == "", -1, zlSig.entryPrice)

string zrtEidLong  = f_submitSignal(LOGIC_ZONE_RT, zlSig.retestLong,  1, zlSig.entryPrice)
string zrtEidShort = f_submitSignal(LOGIC_ZONE_RT, zlSig.retestShort and zrtEidLong == "", -1, zlSig.entryPrice)

string zbkEidLong  = f_submitSignal(LOGIC_ZONE_BK, zlSig.breakLong,  1, zlSig.entryPrice)
string zbkEidShort = f_submitSignal(LOGIC_ZONE_BK, zlSig.breakShort and zbkEidLong == "", -1, zlSig.entryPrice)

//  Zoneイベントの消費は「実際に発注できた時だけ」(1イベント1エントリー)。
//  Zone TradePlan FAIL (Active Zone / SL無し / RR不足 / Qty不足 等) で発注できな
//  かった場合は消費しないので、待機期限内なら次のチャンスでまだEntryできる。
//    Rebound / Retest 成立 → そのイベントは終了
//    FakeBreak 成立        → 同じBreakイベントの未成立Retest候補も同時にキャンセル
//    Break 成立            → イベントは生かしたまま (Fake / Retest を続けて管理)
if zrbEidLong != "" or zrbEidShort != ""
    sg.consumeZoneEvt(zoneEvtEng, 0)
if zfkEidLong != "" or zfkEidShort != ""
    sg.consumeZoneEvt(zoneEvtEng, 1)
if zrtEidLong != "" or zrtEidShort != ""
    sg.consumeZoneEvt(zoneEvtEng, 2)
if zbkEidLong != "" or zbkEidShort != ""
    sg.consumeZoneEvt(zoneEvtEng, 3)

// ---- 7.5 Future Logic (追加例) ---------------------------------------------
//  f_submitSignal("EMA_REJECT", emaSig.longSignal,  1, emaSig.entryPrice)
//  f_submitSignal("EMA_REJECT", emaSig.shortSignal, -1, emaSig.entryPrice)

// ============================================================================
// 08. BREAK EVEN
// ----------------------------------------------------------------------------
//  Entry ID 単位で管理。既定OFF。
//  ONの場合も TP は Entry時点で固定した値 (gTradeTP) をそのまま再指定する。
// ============================================================================
// ---- 8.1 決済済みTradeのクリーンアップ ------------------------------------
//  gTradeTP / gTradeBE に終了済みTradeのEntry IDが永久に残らないようにする。
//  毎バー全closedtradesを走査せず、lastClosedCount からの差分 (このバーで新しく
//  終了したTradeだけ) を処理する。長期バックテスト・多数Logicでも負荷が増えない。
//  ※ BE OFF時はMapが空なので remove は走らない (LastSL集計だけ行う)。
var int   gLastClosedCount = 0
var float gLastSlLoss      = na   // 直近のSL決済の実損益 (Qty検証用)
var float gLastSlQty       = na

f_isOpenEntry(string eid) =>
    bool found = false
    if strategy.opentrades > 0
        for j = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(j) == eid
                found := true
                break
    found

if strategy.closedtrades > gLastClosedCount
    for i = gLastClosedCount to strategy.closedtrades - 1
        string ceid = strategy.closedtrades.entry_id(i)
        // Qty検証用: 直近のSL決済の実損益を控えておく
        if strategy.closedtrades.exit_comment(i) == "SL"
            gLastSlLoss := strategy.closedtrades.profit(i)
            gLastSlQty  := strategy.closedtrades.size(i)
        // Map掃除 (部分決済で同一Entry IDがまだ建っている場合は残す)
        //  ★ gTradeTP / gTradeSL は Dynamic TP が BE OFF でも使うため、
        //    掃除を useBreakEven に依存させない。gTradeBE だけ存在確認で削除する。
        if not f_isOpenEntry(ceid)
            if gTradeTP.contains(ceid)
                gTradeTP.remove(ceid)
            if gTradeSL.contains(ceid)
                gTradeSL.remove(ceid)
            if gTradeBE.contains(ceid)
                gTradeBE.remove(ceid)
    gLastClosedCount := strategy.closedtrades

// ---- 8.2 建値移動 ----------------------------------------------------------
if useBreakEven and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string eid = strategy.opentrades.entry_id(i)
        if gTradeTP.contains(eid)
            float ep     = strategy.opentrades.entry_price(i)
            bool  isLong = strategy.opentrades.size(i) > 0
            bool  wasOn  = gTradeBE.contains(eid) and gTradeBE.get(eid)
            bool  reach  = false
            // ---- 建値移動開始幅の切り替え (Logicごと) ----------------------
            //  Entry ID の接頭辞を完全一致で判定して幅を選ぶ。
            //    FVG15_L_ / FVG15_S_          → fvg15BreakEvenTrigger
            //    FVGABS5_L_ / _S_ / FVGABS15_L_ / _S_  → absBreakEvenTrigger
            //    ZONEREBOUND_ / ZONEFAKE_ / ZONERETEST_ / ZONEBREAK_
            //                                 → zoneBreakEvenTrigger
            //    それ以外 (FVG_L_ / FVG_S_ / 将来のLogic) → breakEvenTrigger
            //  ("FVG15_L_" が "FVG_L_" に一致することはないので取り違えは起きない。)
            //  判定方式 / SLを建値へ動かす処理 / TP再指定 / Map管理は不変。
            bool isFvg15Trade = str.startswith(eid, LOGIC_FVG15 + "_L_") or
                 str.startswith(eid, LOGIC_FVG15 + "_S_")
            bool isAbsTrade = str.startswith(eid, LOGIC_FVG_ABS5 + "_L_") or
                 str.startswith(eid, LOGIC_FVG_ABS5 + "_S_") or
                 str.startswith(eid, LOGIC_FVG_ABS15 + "_L_") or
                 str.startswith(eid, LOGIC_FVG_ABS15 + "_S_")
            bool isZoneTrade = str.startswith(eid, LOGIC_ZONE_RB + "_L_") or
                 str.startswith(eid, LOGIC_ZONE_RB + "_S_") or
                 str.startswith(eid, LOGIC_ZONE_FK + "_L_") or
                 str.startswith(eid, LOGIC_ZONE_FK + "_S_") or
                 str.startswith(eid, LOGIC_ZONE_RT + "_L_") or
                 str.startswith(eid, LOGIC_ZONE_RT + "_S_") or
                 str.startswith(eid, LOGIC_ZONE_BK + "_L_") or
                 str.startswith(eid, LOGIC_ZONE_BK + "_S_")
            float beTrigger = isFvg15Trade ? fvg15BreakEvenTrigger :
                 isAbsTrade ? absBreakEvenTrigger :
                 isZoneTrade ? zoneBreakEvenTrigger : breakEvenTrigger
            if isLong
                reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close >= ep + beTrigger) : (high >= ep + beTrigger)
            else
                reach := breakEvenTriggerMode == "確定足" ? (barstate.isconfirmed and close <= ep - beTrigger) : (low <= ep - beTrigger)
            if wasOn or reach
                gTradeBE.put(eid, true)
                strategy.exit(eid + "X", from_entry = eid, stop = ep, limit = gTradeTP.get(eid),
                     comment_loss = "BE", comment_profit = "TP")

// ---- 8.3 Dynamic TP --------------------------------------------------------
//  ★ TP管理 = "DYNAMIC" のときだけ動く。"FIXED" ではこのブロックへ一切入らない
//    (strategy.exit も呼ばれないので、発注・約定・バックテスト結果は追加前と一致)。
//
//  仕様 : 「保有中に、現在TPより手前に新しい有効な Strong以上のTP Zone が出現した
//         場合のみ、TPをそのZoneへ近づける」。TPを遠ざける変更は絶対に行わない。
//    Long  : newTP < 現在TP のときだけ更新 (かつ newTP > Entry価格)
//    Short : newTP > 現在TP のときだけ更新 (かつ newTP < Entry価格)
//
//  ★ TP候補の探索は ZoneEngine の既存 Structural TP 選択関数をそのまま使う。
//    zn.getLongStructuralTP()  : ST_RESIST のみ / z.bottom > entry /
//                                strength >= tpMinStrength / score >= tpMinScore
//                                → TP = z.bottom - tpBuffer  (最も手前のZone)
//    zn.getShortStructuralTP() : ST_SUPPORT のみ / z.top < entry / 同上
//                                → TP = z.top + tpBuffer     (最も手前のZone)
//    → Entry時 Structural TP と 適格条件も価格定義も完全に同一。独自定義はしない。
//    → どちらも読み取り専用 (ZoneEngine の状態を書き換えない)。
//  ★ zn.buildPlan() は使わない。Active Zone NoTrade / SL Zone / Max SL Distance /
//    Minimum RR / Fallback TP といった Entry可否の再判定を保有中に行わないため。
//  ★ Entry時TPが STRUCTURAL / FALLBACK_RR のどちらでも対象。
//  ★ 現在TPの元Zoneが消滅・弱化・Breakしても、探索結果が今のTPより遠ければ
//    更新条件を満たさないので、TPはそのまま維持される (自動的に不可逆)。
//  ★ 更新は 5分足の確定時 (barstate.isconfirmed) のみ。calc_on_every_tick による
//    形成途中の一時的なZone変化ではTPを動かさない。
//  ★ SLは一切可変化しない。BE未発動なら Entry時 Structural SL (gTradeSL)、
//    BE発動済みなら Entry価格 をそのまま再指定する。
//    → Dynamic TP 更新で BE済みTradeのSLが元のStructural SLへ戻る事故は起きない。
//  Debug用 : [Entry ID, 変更前TP, 変更後TP]
var array<string> gDynTpLast = array.new_string(3, "-")
if tpManagementMode == "DYNAMIC" and barstate.isconfirmed and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string deid = strategy.opentrades.entry_id(i)
        if gTradeTP.contains(deid) and gTradeSL.contains(deid)
            float dEp     = strategy.opentrades.entry_price(i)
            bool  dIsLong = strategy.opentrades.size(i) > 0
            float dCurTp  = gTradeTP.get(deid)
            float dCand   = na
            if dIsLong
                [_dtL, _diL] = zn.getLongStructuralTP(zoneEng, zoneCfg, dEp)
                dCand := _dtL
            else
                [_dtS, _diS] = zn.getShortStructuralTP(zoneEng, zoneCfg, dEp)
                dCand := _dtS
            //  近づける方向のみ。かつ Entry価格の利益側にあること。
            //  ★ さらに「更新時点の現在価格より進行方向側」であることも必須にする。
            //    価格が既に通過したZoneが後からStrongへ昇格しても、その通過済みZoneへ
            //    TPを戻してしまわないため (Long なら dCand > close / Short なら dCand < close)。
            bool dCloser = not na(dCand) and not na(dCurTp) and
                 (dIsLong ? (dCand > close and dCand < dCurTp and dCand > dEp) : (dCand < close and dCand > dCurTp and dCand < dEp))
            if dCloser
                bool  dBeOn  = gTradeBE.contains(deid) and gTradeBE.get(deid)
                float dStop  = dBeOn ? dEp : gTradeSL.get(deid)
                gTradeTP.put(deid, dCand)
                strategy.exit(deid + "X", from_entry = deid, stop = dStop, limit = dCand,
                     comment_loss = dBeOn ? "BE" : "SL", comment_profit = "TP")
                array.set(gDynTpLast, 0, deid)
                array.set(gDynTpLast, 1, f_num(dCurTp, "#.##"))
                array.set(gDynTpLast, 2, f_num(dCand,  "#.##"))
                if useDynamicTpAlert
                    alert("【TP変更 " + (dIsLong ? "LONG" : "SHORT") + "】" +
                         "\nLogic: " + f_logicName(f_logicIdFromEid(deid)) +
                         "\n" + syminfo.ticker +
                         "\nID: " + deid +
                         "\nOld TP: " + f_num(dCurTp, "#.##") +
                         "\nNew TP: " + f_num(dCand,  "#.##") +
                         "\nReason: NEW STRONG ZONE", alert.freq_all)

// ============================================================================
// 09. DISPLAY / DEBUG
// ----------------------------------------------------------------------------
//  表示は全てON/OFF可能。ロジックには一切影響しない。
// ============================================================================
// ---- 9.1 Zone 描画 ---------------------------------------------------------
var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()

f_clearDrawings() =>
    while array.size(gBoxes) > 0
        box.delete(array.pop(gBoxes))
    while array.size(gLabels) > 0
        label.delete(array.pop(gLabels))
    true

f_zoneColor(int st) =>
    st == ST_SUPPORT ? colSupport : st == ST_RESIST ? colResistance : st == ST_ACTIVE ? colActive : colBroken

f_zoneTransp(int strength) =>
    strength == SR_VSTRONG ? trVStrong : strength == SR_STRONG ? trStrong : strength == SR_MEDIUM ? trMedium : trWeak

// ★ Gold Only : Gold以外では Zone Box も Zone Label も生成しない。
if isGold and barstate.islast
    f_clearDrawings()
    if showZones and zn.zoneCount(zoneEng) > 0
        array<int> ord = zn.drawOrder(zoneEng, maxZonesDraw)
        if array.size(ord) > 0
            for k = 0 to array.size(ord) - 1
                zn.Zone z = zn.zoneAt(zoneEng, array.get(ord, k))
                color bc = f_zoneColor(z.state)
                int   tr = f_zoneTransp(z.strength)
                box b = box.new(
                     left         = bar_index - zoneLeftBars,
                     top          = z.top,
                     right        = bar_index + zoneRightBars,
                     bottom       = z.bottom,
                     bgcolor      = color.new(bc, tr),
                     border_color = color.new(bc, math.max(tr - 30, 0)),
                     border_width = z.strength >= SR_STRONG ? 2 : 1,
                     border_style = z.state == ST_BROKEN ? line.style_dashed : line.style_solid,
                     xloc         = xloc.bar_index)
                array.push(gBoxes, b)

                if showLabels
                    string txt = zn.stateName(z.state) + " | " + f_num(z.score, "#.#") + " | " + zn.strengthName(z.strength)
                    txt := txt + " | HTF: " + (z.hasHtf ? z.htfSources : "NO")
                    txt := txt + " | React " + str.tostring(z.reactionCnt)
                    if z.flipped
                        txt := txt + " | FLIP"
                    if showDetailLbl
                        txt := txt + "\n" + z.sources
                    label lb = label.new(
                         x         = bar_index + zoneRightBars,
                         y         = z.top,
                         text      = txt,
                         xloc      = xloc.bar_index,
                         style     = label.style_label_left,
                         color     = color.new(bc, 20),
                         textcolor = color.white,
                         size      = size.small)
                    array.push(gLabels, lb)

// ---- 9.2 MA Source の可視化 -----------------------------------------------
//  ★ Gold Only : Gold以外では na を出力する = 線を描かない。
plot(isGold and showMaLines and useMaSource ? ma1Val : na, "MA #1 (1M)", color = color.new(color.aqua, 25), linewidth = 1)
plot(isGold and showMaLines and useMaSource ? ma2Val : na, "MA #2 (1M)", color = color.new(color.fuchsia, 25), linewidth = 1)

// ---- 9.3 Zone Debug Table --------------------------------------------------
f_tablePos(string s) =>
    s == "Top Left"      ? position.top_left :
     s == "Bottom Right" ? position.bottom_right :
     s == "Bottom Left"  ? position.bottom_left :
     s == "Middle Right" ? position.middle_right : position.top_right

f_textSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

// ★ Gold Only : テーブル自体を Gold のときだけ生成する。
//   Gold以外では dbg が na のまま = 空テーブルすら作られない。
//   table.clear / table.cell / table.merge_cells / f_cell / f_zoneRow は全て
//   下の「if isGold and barstate.islast and showDebugTable」の内側からしか
//   呼ばれないので、na の dbg が使われることはない。
//   Gold では従来どおり最初のバーで1回だけ生成される (引数も従来と同一)。
var table dbg = na
if isGold and na(dbg)
    dbg := table.new(f_tablePos(dbgPosStr), 7, dbgNearestN * 2 + 9,
         border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))

f_cell(int col, int row, string txt, color txtCol, color bgCol) =>
    table.cell(dbg, col, row, txt, text_color = txtCol, bgcolor = bgCol,
         text_size = f_textSize(dbgTextSize), text_halign = text.align_left)

f_zoneRow(int row, string tag, int zi, color tagCol) =>
    zn.Zone z = zn.zoneAt(zoneEng, zi)
    float d = z.center - close
    f_cell(0, row, tag,                                   tagCol,      color.new(tagCol, 88))
    f_cell(1, row, f_num(z.center, "#.##"),               color.white, color.new(tagCol, 92))
    f_cell(2, row, f_num(z.score, "#.#") + " · R" + str.tostring(z.reactionCnt), color.white, color.new(tagCol, 92))
    f_cell(3, row, zn.strengthName(z.strength) + " · HTF " + (z.hasHtf ? z.htfSources : "NO"), color.white, color.new(tagCol, 92))
    f_cell(4, row, zn.stateFull(z.state) + (z.flipped ? " (Flip)" : ""), color.white, color.new(tagCol, 92))
    f_cell(5, row, f_num(math.abs(d), "#.#"),             color.white, color.new(tagCol, 92))
    f_cell(6, row, z.sources,                             color.white, color.new(tagCol, 92))

// ★ Gold Only : Gold以外ではセルを1つも書かない = 何も表示されない。
if isGold and barstate.islast and showDebugTable
    table.clear(dbg, 0, 0, 6, dbgNearestN * 2 + 8)
    color hdr = color.new(color.gray, 70)
    f_cell(0, 0, "Zone",     color.white, hdr)
    f_cell(1, 0, "Center",   color.white, hdr)
    f_cell(2, 0, "Score",    color.white, hdr)
    f_cell(3, 0, "Strength", color.white, hdr)
    f_cell(4, 0, "State",    color.white, hdr)
    f_cell(5, 0, "Distance", color.white, hdr)
    f_cell(6, 0, "Sources",  color.white, hdr)

    array<int> resIdx = zn.nearestIdx(zoneEng, false, dbgNearestN)
    array<int> supIdx = zn.nearestIdx(zoneEng, true,  dbgNearestN)

    int row = 1
    if array.size(resIdx) > 0
        for k = array.size(resIdx) - 1 to 0
            f_zoneRow(row, "RES " + str.tostring(k + 1), array.get(resIdx, k), colResistance)
            row += 1
    if array.size(resIdx) < dbgNearestN
        for k = array.size(resIdx) to dbgNearestN - 1
            f_cell(0, row, "RES -", color.gray, color.new(color.gray, 90))
            row += 1

    f_cell(0, row, "PRICE", color.black, color.new(color.yellow, 20))
    f_cell(1, row, f_num(close, "#.##"), color.black, color.new(color.yellow, 40))
    f_cell(2, row, "Zones: " + str.tostring(zoneCountNow), color.black, color.new(color.yellow, 60))
    f_cell(3, row, "Raw: " + str.tostring(zoneEng.rawCount),   color.black, color.new(color.yellow, 60))
    f_cell(4, row, "MA1 " + f_arrow(zoneEng.ma1Dir) + " MA2 " + f_arrow(zoneEng.ma2Dir), color.black, color.new(color.yellow, 60))
    f_cell(5, row, "MAcl +" + f_num(zoneEng.maClusterBonus, "#.#"), color.black, color.new(color.yellow, 60))
    f_cell(6, row, "Day H/L " + f_num(zoneEng.dayHigh, "#.#") + " / " + f_num(zoneEng.dayLow, "#.#"), color.black, color.new(color.yellow, 60))
    row += 1

    if array.size(supIdx) > 0
        for k = 0 to array.size(supIdx) - 1
            f_zoneRow(row, "SUP " + str.tostring(k + 1), array.get(supIdx, k), colSupport)
            row += 1
    if array.size(supIdx) < dbgNearestN
        for k = array.size(supIdx) to dbgNearestN - 1
            f_cell(0, row, "SUP -", color.gray, color.new(color.gray, 90))
            row += 1

    // ---- 直近TradePlan (Logic / Dir / Entry / SL / TP / RR / TP Type) -----
    if showTradeDebug
        color pc = color.new(color.blue, 70)
        f_cell(0, row, "PLAN", color.white, pc)
        string dynTxt = array.get(gDynTpLast, 0) == "-" ? "" :
             ("  |  DynamicTP " + array.get(gDynTpLast, 0) +
              " Old " + array.get(gDynTpLast, 1) + " → New " + array.get(gDynTpLast, 2))
        f_cell(1, row, array.get(gLastPlan, 0) + "  |  TP MODE: " + tpMode +
             "  |  TP管理: " + tpManagementMode + dynTxt, color.white, pc)
        for c = 2 to 6
            f_cell(c, row, "", color.white, pc)
        table.merge_cells(dbg, 1, row, 6, row)
        row += 1
        f_cell(0, row, "STATUS", color.white, pc)
        // Logic別のSignal状態 (最小限のDebug: どちらのLogicが出したかだけ分かればよい)
        string sigTxt = "  |  SIG FVG " + (fvgSig.longSignal ? "L" : fvgSig.shortSignal ? "S" : "-")
        sigTxt := sigTxt + " / FVG15 " + (fvg15Sig.longSignal ? "L" : fvg15Sig.shortSignal ? "S" : "-")
        sigTxt := sigTxt + " (bos " + (fvg15Sig.bosOkLong ? "L" : "-") + (fvg15Sig.bosOkShort ? "S" : "-") + ")"
        sigTxt := sigTxt + " / ABS5 " + (absSig.long5 ? "L" : absSig.short5 ? "S" : "-") +
             " ABS15 " + (absSig.long15 ? "L" : absSig.short15 ? "S" : "-")
        sigTxt := sigTxt + " (bosL " + (absSig.bos5Ok ? "5" : "-") + (absSig.bos15Ok ? "15" : "-") +
             " bosS " + (absSig.bos5OkS ? "5" : "-") + (absSig.bos15OkS ? "15" : "-") + ")"
        sigTxt := sigTxt + " / ZRB " + (zlSig.reboundLong ? "L" : zlSig.reboundShort ? "S" : "-")
        sigTxt := sigTxt + " ZFK " + (zlSig.fakeLong ? "L" : zlSig.fakeShort ? "S" : "-")
        sigTxt := sigTxt + " ZRT " + (zlSig.retestLong ? "L" : zlSig.retestShort ? "S" : "-")
        sigTxt := sigTxt + " ZBK " + (zlSig.breakLong ? "L" : zlSig.breakShort ? "S" : "-")
        sigTxt := sigTxt + " (evt " + str.tostring(zlSig.evtCount) +
             " touch " + str.tostring(zlSig.candTouch) +
             " fake " + str.tostring(zlSig.candFake) +
             " retest " + str.tostring(zlSig.candRetest) + ")"
        f_cell(1, row, array.get(gLastPlan, 1) + "  |  Open " + str.tostring(strategy.opentrades) +
             "  |  Map " + str.tostring(gTradeTP.size()) + "/" + str.tostring(gTradeBE.size()) +
             "  |  Closed " + str.tostring(strategy.closedtrades) + sigTxt, color.white, pc)
        for c = 2 to 6
            f_cell(c, row, "", color.white, pc)
        table.merge_cells(dbg, 1, row, 6, row)
        row += 1
        // Qty検証行: Risk Capital / SL Distance / Calculated Qty / Expected SL Loss
        //   LastSL = 実際にSLで決済された直近トレードの損益。ExpLoss と突き合わせる。
        color qc = color.new(color.purple, 70)
        f_cell(0, row, "QTY", color.white, qc)
        f_cell(1, row, array.get(gLastPlan, 2) +
             "  ||  LastSL P/L " + f_num(gLastSlLoss, "#.##") + " (qty " + f_num(gLastSlQty, "#.####") + ")",
             color.white, qc)
        for c = 2 to 6
            f_cell(c, row, "", color.white, qc)
        table.merge_cells(dbg, 1, row, 6, row)
        row += 1

    // ---- 環境警告 ---------------------------------------------------------
    string warn = ""
    if timeframe.in_seconds() < timeframe.in_seconds(breakTf)
        warn := warn + "Chart TF < Break TF. "
    if timeframe.in_seconds() < timeframe.in_seconds(hzTf1)
        warn := warn + "Chart TF < Horizontal TF#1. "
    if timeframe.in_seconds() != timeframe.in_seconds("5")
        warn := warn + "本Strategyは5分足チャート前提。"
    if warn != ""
        f_cell(0, row, "WARN", color.white, color.new(color.orange, 40))
        f_cell(1, row, warn, color.white, color.new(color.orange, 60))
        for c = 2 to 6
            f_cell(c, row, "", color.white, color.new(color.orange, 60))
        table.merge_cells(dbg, 1, row, 6, row)

// ---- 9.4 FVG 環境認識 テーブル --------------------------------------------
//  各TFの値は Feed (取得したまま)、15M だけ SignalEngine がゲートした結果を表示する。
f_efvgBiasColor(int b) =>
    b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

f_efvgRow(table t, int row, string tf, bool on, int bias, int reason, int rem) =>
    table.cell(t, 0, row, tf, text_color = color.white, text_size = size.small)
    table.cell(t, 1, row, on ? sg.efvgBiasText(bias) : "-", text_color = color.white,
         bgcolor = on ? f_efvgBiasColor(bias) : color.new(color.gray, 60), text_size = size.small)
    table.cell(t, 2, row, on ? sg.efvgReasonText(reason) : "-", text_color = color.white, text_size = size.small)
    table.cell(t, 3, row, on ? str.tostring(rem) : "-", text_color = color.white, text_size = size.small)

var table efvgTbl = na
// ★ Gold Only
if isGold and efvgShowTable
    if na(efvgTbl)
        efvgTbl := table.new(position.middle_left, 4, 8, border_width = 1)
    if barstate.islast
        color _hb = color.new(color.black, 0)
        table.cell(efvgTbl, 0, 0, "TF",   text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(efvgTbl, 1, 0, "FVG",  text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(efvgTbl, 2, 0, "理由", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(efvgTbl, 3, 0, "残",   text_color = color.white, bgcolor = _hb, text_size = size.small)
        f_efvgRow(efvgTbl, 1, "D",   useEFVGDaily, efvgDBias, efvgDReason, efvgDRem)
        f_efvgRow(efvgTbl, 2, "4H",  useEFVG4H,    efvgHBias, efvgHReason, efvgHRem)
        f_efvgRow(efvgTbl, 3, "1H",  useEFVG1H,    efvgOBias, efvgOReason, efvgORem)
        f_efvgRow(efvgTbl, 4, "15M", useEFVG15M,   fvgSig.mBias, fvgSig.mReason, fvgSig.mRem)
        f_efvgRow(efvgTbl, 5, "5M",  useEFVG5M,    efvg5Bias, efvg5Reason, efvg5Rem)
        f_efvgRow(efvgTbl, 6, "1M",  useEFVG1M,    efvg1Bias, efvg1Reason, efvg1Rem)
        table.cell(efvgTbl, 0, 7, "FINAL FVG BIAS: " + sg.efvgBiasText(fvgSig.efvgFinalBias),
             text_color = color.white, bgcolor = f_efvgBiasColor(fvgSig.efvgFinalBias), text_size = size.small)
        table.cell(efvgTbl, 1, 7, efvgShowDebug ? ("Score:" + str.tostring(fvgSig.efvgScore)) : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 2, 7, efvgShowDebug ? (efvgCombineMode + "/" + efvgIntegrationMode) : "", text_color = color.white, text_size = size.small)
        table.cell(efvgTbl, 3, 7, efvgShowDebug ? ("Trend:" + (fvgSig.trendOk ? "OK" : "NG")) : "", text_color = color.white, text_size = size.small)

// ---- 9.5 日足ボラ中央値 デバッグ ------------------------------------------
var table dailyVolTbl = na
// ★ Gold Only
if isGold and showDailyVolDebug and useDailyRegimeFilter
    if na(dailyVolTbl)
        dailyVolTbl := table.new(position.top_left, 2, 3, border_width = 1)
    if barstate.islast
        color _hb = color.new(color.black, 0)
        table.cell(dailyVolTbl, 0, 0, "日足ボラ (中央値" + str.tostring(dailyVolMedianLength) + "本)", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(dailyVolTbl, 1, 0, "", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(dailyVolTbl, 0, 1, "中央値", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 1, 1, (na(drMedianRange) ? "-" : str.tostring(drMedianRange, "#.#")) + "$", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 0, 2, "判定", text_color = color.white, text_size = size.small)
        table.cell(dailyVolTbl, 1, 2, sg.dailyVolatilityText(fvgSig.drVolCode), text_color = color.white,
             bgcolor = f_efvgBiasColor(nz(fvgSig.drVolCode, 0)), text_size = size.small)

// ---- 9.6 FVG構造管理 BOS デバッグ -----------------------------------------
f_fvgBosText(int s) =>
    s == 1 ? "Bull" : s == -1 ? "Bear" : "Neutral"

f_bosRow(table t, int row, string tf, bool on, int bos) =>
    table.cell(t, 0, row, tf, text_color = color.white, text_size = size.small)
    table.cell(t, 1, row, on ? f_fvgBosText(bos) : "-", text_color = color.white,
         bgcolor = on ? f_efvgBiasColor(bos) : color.new(color.gray, 60), text_size = size.small)

var table fvgBosTbl = na
// ★ Gold Only
if isGold and showFvgBosDebug and useEFVGEnv
    if na(fvgBosTbl)
        fvgBosTbl := table.new(position.bottom_right, 2, 7, border_width = 1)
    if barstate.islast
        color _hb = color.new(color.black, 0)
        table.cell(fvgBosTbl, 0, 0, "FVG構造BOS", text_color = color.white, bgcolor = _hb, text_size = size.small)
        table.cell(fvgBosTbl, 1, 0, useFvgBosFilter ? "ON" : "OFF", text_color = color.white, bgcolor = _hb, text_size = size.small)
        f_bosRow(fvgBosTbl, 1, "D",   useEFVGDaily, efvgDBos)
        f_bosRow(fvgBosTbl, 2, "4H",  useEFVG4H,    efvgHBos)
        f_bosRow(fvgBosTbl, 3, "1H",  useEFVG1H,    efvgOBos)
        // ★ 15M FVG は 5M BOS を参照してゲートする → 参照元 (5M BOS) を表示。
        f_bosRow(fvgBosTbl, 4, "15M→5M", useEFVG15M and useFvgBosFilter, efvg5Bos)
        f_bosRow(fvgBosTbl, 5, "5M",  useEFVG5M,    efvg5Bos)
        f_bosRow(fvgBosTbl, 6, "1M",  useEFVG1M,    efvg1Bos)

// ============================================================================
// 10. ALERTS
// ----------------------------------------------------------------------------
//  ★ このセクションは alert() を呼ぶだけ。既存ロジックには一切影響しない ★
//    (Entryラベルは Section 05 の実発注ブランチ内で描画している。確定アラートと
//     同じ TradePlan の値を使うため、表示値と実注文がズレる構造にはならない。)
//    ・strategy.entry / strategy.exit を呼ばない
//    ・Engine state (armed / consumed / eventId / waiting) を書き換えない
//    ・f_submitSignal() を追加実行しない (実発注につながるため)
//    ・zn.buildPlan() は読み取り専用なので、判定用に呼んでも副作用が無い
//
//  ① 確定アラート
//     Section 07 が返した Entry ID が空でない = 実際に strategy.entry した時だけ。
//     Signal成立 / Direction / TradePlan / Structural SL / TP / Minimum RR /
//     TP Mode / Qty / ポジション制御 を全て通過した場合だけ発火する。
//
//  ② 仮アラート
//     確定アラートの条件から「確定足であること」だけを外したもの。
//     形成中バーで、その値のまま確定すればEntryできる状態になった瞬間に出す。
//     同一Logic・同一方向につき、確定アラートが出るまで最大1回 (varip で保持)。
//     再アームはその Logic・その方向の確定Entryが成立したときだけ。
//
//  ★ Signal条件は Main では一切組み直さない。
//    SignalEngine が確定Signalと同じ式・同じ順序で計算した Preview 出力
//    (FvgSignal.previewLong / Fvg15 は sg.fvg15Preview() / FvgAbsSignal.previewLong5 /
//     ZoneBosSignal.previewLong など) をそのまま受け取る。
//    → Trigger Cooldown / Opposite Trigger NoTrade / 環境条件 / Session / News /
//      Volatility / Daily Regime / Accum / FVG環境 / BOS / Armed / Consumed が
//      全て確定Entryと同一の判定で反映される。確定条件を変えたら Preview も
//      同じ場所で追従するため、将来的にズレる構造にならない。
//    その上に Main 側で Group制御 / 優先順位 / TradePlan / Structural SL・TP /
//      Minimum RR / TP Mode / Qty / Position制御 (= f_canEnter) を通す。
//
//  ★ 実Entry は calc_on_every_tick = true でも従来どおり確定足のみ:
//    5系列すべて SignalEngine の確定Signal側に barstate.isconfirmed が入っており、
//    f_submitSignal() → f_executeTrade() → strategy.entry() はその確定Signalが
//    true のときしか呼ばれない。Event consume / Armed解除も Entry ID が返った
//    ときだけなので、形成中バーでは絶対に起きない。
//      FVG      : baseLongCondition  = barstate.isconfirmed and ...
//      FVG15    : baseLong (= 上記) に 5M BOS Gate を掛けたもの
//      FVGABS5  : l5  / s5  = ... and barstate.isconfirmed and ...
//      FVGABS15 : l15 / s15 = ... and barstate.isconfirmed and ...
//      Zone 4系列: reboundLong = rbL and barstate.isconfirmed (4Logic×2方向とも同様)
//    また Pine は形成中バーの各tick再計算で var / UDT の状態を足の開始時点へ
//    巻き戻すため、途中tickで進んだ Engine state は確定時に必ず再計算される。
//    ヒストリカルでは calc_on_every_tick の有無で評価回数自体が変わらない。
//    → バックテスト結果は追加前と完全に一致する。
//    (巻き戻らないのは varip のみ。ここでは仮アラートの重複防止 gProvSent だけに
//     使っており、Entry判定には一切関与しない。)
// ============================================================================

// ---- 10.1 副作用なしの Entry 可否判定 --------------------------------------
//  f_executeTrade() の判定部分だけを、状態を書き換えずに再現したもの。
//  Entry ID の採番も発注も記録も行わない。純粋に「入れるか」だけを返す。
f_canEnter(string logicId, int dir, float entryPrice) =>
    bool ok = false
    bool dirOk = (dir > 0 and enableLong) or (dir < 0 and enableShort)
    if dir != 0 and dirOk
        zn.TradePlan p = zn.buildPlan(zoneEng, zoneCfg, dir, entryPrice)
        // TP Mode フィルター (f_submitSignal と同一)
        bool planOk = p.valid
        if tpMode == "STRUCTURAL_ONLY" and p.tpType == "FALLBACK_RR"
            planOk := false
        else if tpMode == "FALLBACK_ONLY" and p.tpType == "STRUCTURAL"
            planOk := false
        if planOk
            float qty = f_qty(p.risk)
            bool oppositeConflict = not allowOppositeEntry and
                 ((dir > 0 and strategy.position_size < 0) or (dir < 0 and strategy.position_size > 0))
            bool logicFull = f_openCountForLogic(logicId) >= maxOpenPerLogic
            ok := not logicFull and not oppositeConflict and qty >= qtyMin and qty > 0
    ok

// ---- 10.2 仮アラート本文 ---------------------------------------------------
//  仮アラートは「まだ発注していない」ので TradePlan を確定値として出さない。
//  Logic名と現在値だけを通知する。
f_provAlertMsg(string logicId, int dir) =>
    "【仮 " + (dir > 0 ? "LONG" : "SHORT") + "】" +
     "\nLogic: " + f_logicName(logicId) +
     "\n" + syminfo.ticker +
     "\nE: " + f_num(close, "#.##")

// ---- 10.3 仮アラート 送信済み管理 (Logic × 方向で完全独立) ----------------
//  slot = Logic index * 2 + (dir > 0 ? 0 : 1)  … 8 Logic × 2方向 = 16
//    FVG=0,1 / FVG15=2,3 / FVGABS5=4,5 / FVGABS15=6,7 /
//    ZONEREBOUND=8,9 / ZONEFAKE=10,11 / ZONERETEST=12,13 / ZONEBREAK=14,15
//  ★ 「送信済みか」の bool だけを持つ。bar_index は一切使わない。
//    同一Logic・同一方向につき、確定アラートが出るまで仮アラートは最大1回。
//      ・次のバーへ移行しても false へは戻さない
//      ・Preview条件が一度 false へ戻ってから再成立しても戻さない
//      ・時間経過でも戻さない
//    再アーム条件はただ1つ、「そのLogic・その方向の確定Entryが成立したとき」
//    (f_confirmedAlert が false へ戻す)。
//  ★ varip で持つ。通常の var はリアルタイム足の各tick再計算で足の開始時点へ
//    巻き戻るため、intrabar で立てたフラグが毎tick戻って再発火してしまう。
varip array<bool> gProvSent = array.new_bool(16, false)

f_provSlot(string logicId, int dir) =>
    int li = logicId == LOGIC_FVG ? 0 : logicId == LOGIC_FVG15 ? 1 :
         logicId == LOGIC_FVG_ABS5 ? 2 : logicId == LOGIC_FVG_ABS15 ? 3 :
         logicId == LOGIC_ZONE_RB ? 4 : logicId == LOGIC_ZONE_FK ? 5 :
         logicId == LOGIC_ZONE_RT ? 6 : logicId == LOGIC_ZONE_BK ? 7 : -1
    li < 0 ? -1 : li * 2 + (dir > 0 ? 0 : 1)

// ---- 10.4 確定アラート -----------------------------------------------------
//  Entry ID が返った = 実Entry成立。実Entry 1回につき 1回だけ発火する。
//  ★ E / SL / TP / RR は Section 05 が実発注時に控えた TradePlan の値そのもの。
//    ここでは一切再計算せず、Mapから読むだけ (ラベルと完全に同じ値)。
//    読んだら削除して Map が増え続けないようにする (通知専用の受け渡しなので、
//    削除しても Entry / SL / TP / Break Even には何の影響も無い)。
f_confirmedAlert(string eid, string logicId, int dir) =>
    // ★ Gold Only (Gold以外では eid が常に "" なので二重の保険)
    if isGold and eid != ""
        float aE  = gAlEntry.contains(eid) ? gAlEntry.get(eid) : na
        float aSl = gAlSl.contains(eid)    ? gAlSl.get(eid)    : na
        float aTp = gAlTp.contains(eid)    ? gAlTp.get(eid)    : na
        float aRr = gAlRr.contains(eid)    ? gAlRr.get(eid)    : na
        if useConfirmedAlert
            alert("【確定 " + (dir > 0 ? "LONG" : "SHORT") + "】" +
                 "\nLogic: " + f_logicName(logicId) +
                 "\n" + syminfo.ticker +
                 "\nE: "    + f_num(aE,  "#.##") +
                 "\nSL: "   + f_num(aSl, "#.##") +
                 "\nTP: "   + f_num(aTp, "#.##") +
                 "\nE-SL: " + f_num(math.abs(aE - aSl), "#.##") +
                 "\nRR: "   + f_num(aRr, "#.##") +
                 "\nID: "   + eid, alert.freq_all)
        if gAlEntry.contains(eid)
            gAlEntry.remove(eid)
            gAlSl.remove(eid)
            gAlTp.remove(eid)
            gAlRr.remove(eid)
        // このLogic・この方向の仮アラートだけを再アームする。
        // ★ これが唯一の再アーム条件 (バー更新 / Preview false / 時間経過では戻さない)。
        int slot = f_provSlot(logicId, dir)
        if slot >= 0
            array.set(gProvSent, slot, false)
    true

f_confirmedAlert(fvg15EidLong,  LOGIC_FVG15,     1)
f_confirmedAlert(fvg15EidShort, LOGIC_FVG15,    -1)
f_confirmedAlert(fvgEidLong,    LOGIC_FVG,       1)
f_confirmedAlert(fvgEidShort,   LOGIC_FVG,      -1)
f_confirmedAlert(abs15EidLong,  LOGIC_FVG_ABS15,  1)
f_confirmedAlert(abs15EidShort, LOGIC_FVG_ABS15, -1)
f_confirmedAlert(abs5EidLong,   LOGIC_FVG_ABS5,   1)
f_confirmedAlert(abs5EidShort,  LOGIC_FVG_ABS5,  -1)
f_confirmedAlert(zrbEidLong,    LOGIC_ZONE_RB,   1)
f_confirmedAlert(zrbEidShort,   LOGIC_ZONE_RB,  -1)
f_confirmedAlert(zfkEidLong,    LOGIC_ZONE_FK,   1)
f_confirmedAlert(zfkEidShort,   LOGIC_ZONE_FK,  -1)
f_confirmedAlert(zrtEidLong,    LOGIC_ZONE_RT,   1)
f_confirmedAlert(zrtEidShort,   LOGIC_ZONE_RT,  -1)
f_confirmedAlert(zbkEidLong,    LOGIC_ZONE_BK,   1)
f_confirmedAlert(zbkEidShort,   LOGIC_ZONE_BK,  -1)

// ---- 10.5 仮アラート -------------------------------------------------------
//  raw = 「確定足であること」以外のSignal条件が成立しているか。
//  そのうえで Group Gate と f_canEnter() (TradePlan / Qty / ポジション制御) を通す。
//  ① 「今この瞬間に確定したらEntryできるか」だけを返す (発火はしない)。
//    useProvisionalAlert / raw / gateOk が揃ったときにしか f_canEnter() を
//    呼ばないので、OFF時は zn.buildPlan() の追加呼び出しも発生しない。
f_provWouldEnter(string logicId, int dir, bool raw, bool gateOk) =>
    bool r = false
    if useProvisionalAlert and raw and gateOk and not barstate.isconfirmed
        r := f_canEnter(logicId, dir, close)
    r

//  ② 実際の発火。同一Logic・同一方向につき、確定アラートが出るまで最大1回。
//    バーが変わっても、Preview条件が一度 false へ戻って再成立しても再送しない。
f_provFire(string logicId, int dir, bool would) =>
    // ★ Gold Only : Gold以外では仮アラートを発火しない。
    if isGold and would
        int slot = f_provSlot(logicId, dir)
        if slot >= 0 and not array.get(gProvSent, slot)
            array.set(gProvSent, slot, true)
            alert(f_provAlertMsg(logicId, dir), alert.freq_all)
    true

//  ---- 各Logicの Preview Signal (確定足条件だけを外したSignal) -------------
//  ★ ここでは条件を1つも組み直さない。全て SignalEngine が確定Signalと
//    同じ式・同じ順序で計算した Preview 出力をそのまま受け取る。
//      ・FVG      : sg.updateFvg()      が返す previewLong / previewShort
//      ・FVG15    : sg.fvg15Preview()   が確定Gateと同じ式で合成する
//      ・FVGABS   : sg.updateFvgAbs()   が返す previewLong5 / previewShort5 /
//                     previewLong15 / previewShort15
//      ・Zone 4系列 : sg.updateZoneEvents() が返す pvReboundLong など8本
//    → 確定Entry条件を変更したら Preview も同じ場所で必ず追従するため、
//      Main 側の再構築による「本番Entry条件とのズレ」が構造的に起きない。
//  ★ 含まれている条件 (確定Entryと同一):
//      Trigger条件 / Trigger Cooldown / Opposite Trigger NoTrade /
//      Environment (4H/1H/15M/5M/1M FVG) / Session / News / Volatility /
//      Daily Regime / Accum NoTrade・離脱待機・離脱方向 / BOS順序 /
//      Armed / Consumed / Logic ON-OFF / Enable Long-Short
//  ★ この呼び出しは全て読み取り専用。Engine state / Armed / consumed /
//    Trigger Cooldown を書き換えず、Event も消費しない。
bool provFvgLongRaw   = fvgSig.previewLong
bool provFvgShortRaw  = fvgSig.previewShort

[provFvg15LongRaw, provFvg15ShortRaw] = sg.fvg15Preview(fvg15Base, fvg15Sig)

bool provAbs5LongRaw   = absSig.previewLong5
bool provAbs5ShortRaw  = absSig.previewShort5
bool provAbs15LongRaw  = absSig.previewLong15
bool provAbs15ShortRaw = absSig.previewShort15

bool provZrbLongRaw  = zlSig.pvReboundLong
bool provZrbShortRaw = zlSig.pvReboundShort
bool provZfkLongRaw  = zlSig.pvFakeLong
bool provZfkShortRaw = zlSig.pvFakeShort
bool provZrtLongRaw  = zlSig.pvRetestLong
bool provZrtShortRaw = zlSig.pvRetestShort
bool provZbkLongRaw  = zlSig.pvBreakLong
bool provZbkShortRaw = zlSig.pvBreakShort

//  ---- Group Gate / 優先順位は Section 07 と同じ順序で再現する -------------
//   Section 07 の順序:
//     7.1 FVG15 Long → FVG15 Short (Long が発注できたら Short は出さない)
//     7.2 FVG   Long / Short  (FVG15 が実発注できたバーはSKIP)
//     7.3 ABS15 Long → Short → ABS5 Long → Short
//         (ABS15 が実発注できたら同バーの ABS5 はSKIP)
//     7.4 Zone 4Logic それぞれ Long → Short (Long が発注できたら Short は出さない)
//         4Logicは互いに独立 (どれかが出ても他をブロックしない)
//   形成中バーでは Entry ID がまだ無いので、Section 07 の「Entry ID が空でない」
//   の代わりに「その方向が f_canEnter() を通っているか」を使う。
bool provWFvg15L = f_provWouldEnter(LOGIC_FVG15, 1, provFvg15LongRaw, not fvgGroupBlocked)
bool provWFvg15S = f_provWouldEnter(LOGIC_FVG15, -1, provFvg15ShortRaw,
     not fvgGroupBlocked and not provWFvg15L)
bool provFvg15Entered = provWFvg15L or provWFvg15S

bool provWFvgL = f_provWouldEnter(LOGIC_FVG, 1, provFvgLongRaw,
     not fvgGroupBlocked and not provFvg15Entered)
bool provWFvgS = f_provWouldEnter(LOGIC_FVG, -1, provFvgShortRaw,
     not fvgGroupBlocked and not provFvg15Entered)

bool provWAbs15L = f_provWouldEnter(LOGIC_FVG_ABS15, 1, provAbs15LongRaw, not fvgAbsGroupBlocked)
bool provWAbs15S = f_provWouldEnter(LOGIC_FVG_ABS15, -1, provAbs15ShortRaw,
     not fvgAbsGroupBlocked and not provWAbs15L)
bool provAbs15Entered = provWAbs15L or provWAbs15S
bool provWAbs5L = f_provWouldEnter(LOGIC_FVG_ABS5, 1, provAbs5LongRaw,
     not fvgAbsGroupBlocked and not provAbs15Entered)
bool provWAbs5S = f_provWouldEnter(LOGIC_FVG_ABS5, -1, provAbs5ShortRaw,
     not fvgAbsGroupBlocked and not provAbs15Entered and not provWAbs5L)

//   Zone系の保有ゲートは Section 6.4 で SignalEngine へ渡し済みなので、
//   ここでは true を渡し、方向の重複だけ抑える。
bool provWZrbL = f_provWouldEnter(LOGIC_ZONE_RB, 1, provZrbLongRaw, true)
bool provWZrbS = f_provWouldEnter(LOGIC_ZONE_RB, -1, provZrbShortRaw, not provWZrbL)
bool provWZfkL = f_provWouldEnter(LOGIC_ZONE_FK, 1, provZfkLongRaw, true)
bool provWZfkS = f_provWouldEnter(LOGIC_ZONE_FK, -1, provZfkShortRaw, not provWZfkL)
bool provWZrtL = f_provWouldEnter(LOGIC_ZONE_RT, 1, provZrtLongRaw, true)
bool provWZrtS = f_provWouldEnter(LOGIC_ZONE_RT, -1, provZrtShortRaw, not provWZrtL)
bool provWZbkL = f_provWouldEnter(LOGIC_ZONE_BK, 1, provZbkLongRaw, true)
bool provWZbkS = f_provWouldEnter(LOGIC_ZONE_BK, -1, provZbkShortRaw, not provWZbkL)

f_provFire(LOGIC_FVG15,     1, provWFvg15L)
f_provFire(LOGIC_FVG15,    -1, provWFvg15S)
f_provFire(LOGIC_FVG,       1, provWFvgL)
f_provFire(LOGIC_FVG,      -1, provWFvgS)
f_provFire(LOGIC_FVG_ABS15,  1, provWAbs15L)
f_provFire(LOGIC_FVG_ABS15, -1, provWAbs15S)
f_provFire(LOGIC_FVG_ABS5,   1, provWAbs5L)
f_provFire(LOGIC_FVG_ABS5,  -1, provWAbs5S)
f_provFire(LOGIC_ZONE_RB,   1, provWZrbL)
f_provFire(LOGIC_ZONE_RB,  -1, provWZrbS)
f_provFire(LOGIC_ZONE_FK,   1, provWZfkL)
f_provFire(LOGIC_ZONE_FK,  -1, provWZfkS)
f_provFire(LOGIC_ZONE_RT,   1, provWZrtL)
f_provFire(LOGIC_ZONE_RT,  -1, provWZrtS)
f_provFire(LOGIC_ZONE_BK,   1, provWZbkL)
f_provFire(LOGIC_ZONE_BK,  -1, provWZbkS)

export type Root
    bool alive
    int rootId
    int originKey
    int category
    int subtype
    int tfCode
    int tfMask
    int originTime
    int originEndTime
    int confirmedTime
    float pointPrice
    float nativeBottom
    float nativeTop
    bool isRangeRoot
    bool isDynamic
    int state
    int pairKey
    int direction
    bool fvgFresh
    bool isBroadFvg
    int labelMask
    int lastUpdateSeq
    int slopeSign
    bool inverseMovedAway
    bool inverseRetestSeen
    int lastSourceCloseTime
    // EMA Topology Guard (sections 2-4). Rebuilt in the Slow Path only. While a
    // new EMA value stays inside [emaGuardLow, emaGuardHigh] and the slope sign
    // is unchanged, no Root, FVG, Core or Candidate is examined at all.
    float emaGuardLow
    float emaGuardHigh
    int emaGuardSlopeSign
    bool emaGuardValid
    // Scratch-only selection stamp. It never participates in Zone logic.
    int workStamp

export type SideHistory
    int sideTouchCount
    bool weakByTouch
    bool weakByDepth
    float maxDepthPct
    bool sideFresh
    int phase
    int grade
    int currentTouchNo
    int upcomingTouchNo
    int armedFromSeq
    float lastArmedRangeBottom
    float lastArmedRangeTop
    int lastNormalTouchTime
    int flipAttemptCount
    int inverseAttemptCount
    int lastFlipConfirmSeq
    int currentMarkSeq
    // Section 31. Truncation is tracked per Core and Side. One Core losing a
    // TouchMark must never make another Core's history look incomplete.
    bool historyIncomplete

export type TouchMark
    int baseSeq
    int time
    int side
    float contactBottom
    float contactTop
    float closeAtTouch
    int generationId
    bool isNormalTouch
    // FIX 22.6. A TouchMark now records the whole episode, not just its contact.
    // Merge and Split rebuild SideTouchCount, SideFresh, WeakByTouch, WeakByDepth
    // and maxDepthPct from the marks actually inherited, instead of copying the
    // parent's aggregates wholesale.
    int markSeq
    int touchNo
    int startGrade
    // Section 30. These are the EPISODE's own results, never a copy of the
    // cumulative SideHistory.
    bool episodeWeakByDepth
    float episodeMaxDepthPct


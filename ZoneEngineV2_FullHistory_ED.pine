export type ZoneEngine
    array<Root> roots
    map<int, int> rootIndex
    // Exact live indexes used by the hot path. pointPriceIndex stores Root slots
    // sorted by (pointPrice, rootId), avoiding a map lookup for every price-index
    // read. Slots are removed before reuse, so no stale slot can remain indexed.
    array<int> pointPriceIndex
    // Category-local live slot indexes. They avoid full Root-registry scans on
    // source ingestion, invalidation and storage checks.
    array<int> swingSlots
    array<int> accumSlots
    array<int> timeSlots
    array<int> fvgSlots
    array<int> freeRootSlots
    array<int> freshFvgSlots
    array<int> inverseWaitSlots
    array<ZoneCore> cores
    map<int, int> coreIndex
    array<int> liveCoreSlots
    array<int> freeCoreSlots
    // ---- State-specific work sets (sections 8-13). A normal Base bar iterates
    // ONLY these, never liveCoreSlots.
    array<int> armedSupportSlots
    array<int> armedResistanceSlots
    array<int> activeTouchSlots
    array<int> brokenFlipWaitSlots
    array<int> generationWatchSlots
    array<int> dormantSlots
    array<int> waitingSlots
    array<int> pendingTopoSlots
    // ---- EMA -> Core reverse index (section 6). The EMA Fast Path updates only
    // the Cores listed here.
    array<int> ema2000CoreSlots
    array<int> ema3000CoreSlots
    // Reusable snapshot buffer, so a set can be iterated while transitions
    // mutate it. Cleared and refilled, never reallocated.
    array<int> workSetSnapshot
    // ---- Aggregate Dormant wake guard (section 19). While the bar stays inside
    // this interval, no Dormant Core can wake, so the Dormant set is not walked.
    float dormantGuardLow
    float dormantGuardHigh
    bool dormantGuardValid
    // Scratch for EMA Guard construction (Slow Path only).
    float workGuardLow
    float workGuardHigh
    array<ZoneEvent> events
    array<EndedGeneration> endedGenerations
    int nextRootId
    int nextCoreId
    int nextGenerationId
    int nextMarkSeq
    int lastBaseOpenTime
    int lastBaseSeq
    int lastCfgRevision
    float lastCfgMintick
    bool configValid
    string configError
    bool storagePruned
    int prunedRootCount
    int prunedZoneCount
    bool touchHistoryTruncated
    int candidateCountLast
    int liveRootCount
    int liveCoreCount
    int pendingTopologyCount
    int pendingGenerationCount
    int lastSource1mTime
    int lastSource15mTime
    int lastSource1hTime
    int lastSource4hTime
    int lastSource1dTime
    int sessionKey
    int sessionHighRootId
    int sessionLowRootId
    float sessionHigh
    float sessionLow
    int sessionHighOrigin
    int sessionLowOrigin
    int prevSessionHighRootId
    int prevSessionLowRootId
    int dayKey
    int dayHighRootId
    int dayLowRootId
    float dayHigh
    float dayLow
    int dayHighOrigin
    int dayLowOrigin
    int prevDayHighRootId
    int prevDayLowRootId
    int weekKey
    int weekHighRootId
    int weekLowRootId
    float weekHigh
    float weekLow
    int weekHighOrigin
    int weekLowOrigin
    int prevWeekHighRootId
    int prevWeekLowRootId
    bool topologyDirty
    float dirtyBottom
    float dirtyTop
    // Disjoint dirty bands prevent unrelated Root changes on the same Base bar
    // from expanding into one huge min..max topology rebuild.
    array<float> dirtyBottoms
    array<float> dirtyTops
    array<float> workDirtyBottoms
    array<float> workDirtyTops
    bool eligibilityDirty
    bool storageCheckDirty

    // ---- Performance counters (section 26). Written only when cfg.countersOn.
    int baseBarsProcessed
    int fastPathBars
    int slowPathBars
    int noOpBars
    int candidateRebuildCount
    int candidateWindowEvalCount
    int rootFullScanCount
    int coreFullScanCount
    int dirtyBandCount
    float maxDirtyBandWidth
    int mergeEvalCount
    int splitEvalCount
    int referenceCalcCount
    int maFastUpdates
    int maSlowUpdates
    int maxLiveRoots
    int maxLiveCores
    int coresVisitedLast
    int emaGuardHits
    int emaGuardBreaches
    int fvgFullScanCount

    // Reusable candidate-search scratch. These arrays are capacity buffers only;

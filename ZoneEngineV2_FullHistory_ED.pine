//@version=6
//@description ZoneEngine v2, Full History Event-Driven build. Zone definition v2 logic is preserved; the engine is restructured so that most confirmed Base bars take a Fast Path that performs no candidate search, no clustering and no allocation.
library("ZoneEngineV2_FullHistory_ED", overlay = true)

// ============================================================================
// Build
//
// FULL HISTORY, EVENT DRIVEN.
//
// There is no artificial history cut in this library and none is permitted in
// its harness: no historyDays, no historyStartTime, no inEngineWindow, no HTF
// bootstrap substitute for real replay. State is produced by advancing the
// engine from the first usable confirmed Base bar to the present.
//
// The performance strategy is NOT to do less Zone logic. It is to do the same
// Zone logic only on the bars where structure actually changed:
//
//   Fast Path  - state transitions on a small, pre-filtered set of Cores.
//                No candidate search, no clustering, no Root sweep, no arrays.
//   Slow Path  - entered only when a Root was added, removed, moved across a
//                relationship boundary, or changed quality/direction/label.
//                Rebuilds only the affected price bands.
//
// Derived from ZoneEngineV2_Rebuild. That file is untouched and remains the
// reference build. Differences are intentional and listed in
// ZoneEngineV2_FullHistory_ED_Report.md section D.
// ============================================================================
const string BUILD_ID = "ZEV2-FULLHIST-ED-GUARD-20260920"

// Root change classes. A single topologyDirty flag is deliberately not used:
// each class implies a different, narrower recomputation.
const int RC_NONE              = 0
const int RC_ADDED             = 1
const int RC_REMOVED           = 2
const int RC_PRICE_MOVED       = 3
const int RC_RANGE_CHANGED     = 4
const int RC_QUALITY_CHANGED   = 5
const int RC_DIRECTION_CHANGED = 6
const int RC_LABEL_CHANGED     = 7
const int RC_FVG_STATE_CHANGED = 8

// Categories
const int CAT_MA      = 1
const int CAT_SWING   = 2
const int CAT_ACCUM   = 3
const int CAT_TIME_HL = 4
const int CAT_FVG     = 5
const int CAT_PSYCH   = 6

// Sides
const int SIDE_SUPPORT    = 1
const int SIDE_RESISTANCE = -1
const int SIDE_NONE       = 0

// Phase
const int PH_WAITING      = 1
const int PH_ARMED        = 2
const int PH_ACTIVE_TOUCH = 3
const int PH_BROKEN       = 4
const int PH_FLIP_WAIT    = 5
const int PH_DORMANT      = 6

// Grade
const int GR_STRONG      = 1
const int GR_NEUTRAL     = 2
const int GR_WEAK        = 3
const int GR_UNAVAILABLE = 4

// Density
const int DEN_HIGH          = 1
const int DEN_NORMAL        = 2
const int DEN_BROAD_CONTEXT = 3

// Root state
const int ROOT_CANDIDATE      = 1
const int ROOT_ACTIVE         = 2
const int ROOT_INVALIDATED    = 3
const int ROOT_INVERSE_WAIT   = 4
const int ROOT_INVERSE_ACTIVE = 5
const int ROOT_RETIRED        = 6

// FVG direction
const int FVG_NONE    = 0
const int FVG_BULLISH = 1
const int FVG_BEARISH = -1

// Weak reason
const int WEAK_NONE     = 0
const int WEAK_BY_TOUCH = 1
const int WEAK_BY_DEPTH = 2
const int WEAK_BY_BOTH  = 3

// Event type
const int EV_TOUCH_START      = 1
const int EV_TOUCH_RESET      = 2
const int EV_WEAK_DEPTH       = 3
const int EV_LOCAL_BREAK      = 4
const int EV_GAP_BREAK        = 5
const int EV_FLIP_ATTEMPT     = 6
const int EV_FLIP_CONFIRM     = 7
const int EV_RECLAIM          = 8
const int EV_FVG_INVALIDATE   = 9
const int EV_INVERSE_ATTEMPT  = 10
const int EV_INVERSE_CONFIRM  = 11
const int EV_GENERATION_START = 12
const int EV_MERGE            = 13
const int EV_SPLIT            = 14
const int EV_STORAGE_PRUNE    = 15

// TF codes / masks
const int TF_1M  = 1
const int TF_5M  = 5
const int TF_15M = 15
const int TF_1H  = 60
const int TF_4H  = 240
const int TF_1D  = 1440
const int MASK_5M  = 1
const int MASK_15M = 2
const int MASK_1H  = 4

// Time label mask
const int TL_CUR_SESSION  = 1
const int TL_PREV_SESSION = 2
const int TL_CUR_DAY      = 4
const int TL_PREV_DAY     = 8
const int TL_CUR_WEEK     = 16
const int TL_PREV_WEEK    = 32

// Root subtype
const int SUB_MA_2000       = 1
const int SUB_MA_3000       = 2
const int SUB_SWING_HIGH    = 10
const int SUB_SWING_LOW     = 11
const int SUB_ACCUM_TOP     = 20
const int SUB_ACCUM_BOTTOM  = 21

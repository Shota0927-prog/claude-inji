    // Debug-only instrumentation. Off by default so a production run pays nothing.
    bool countersOn
    // MA Fast Path. ON: an EMA move that provably changes no Root relationship
    // updates its Cores in place instead of triggering a band rebuild.
    // OFF: every EMA tick rebuilds, which is bit-identical to ZoneEngineV2_Rebuild.
    bool maFastPath
    // Increment only when a caller mutates logical configuration without a script reload.
    // TradingView input changes reload the script, so the Visual Harness keeps this at 1.
    int revision


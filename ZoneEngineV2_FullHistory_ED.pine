// ============================================================================
// Source helpers. These contain only source-context calculations and return
// primitive UDTs, so Harness can consolidate requests by source timeframe.
// ============================================================================
export maPackV2(int lookback) =>
    float e2 = ta.ema(close, 2000)
    float e3 = ta.ema(close, 3000)
    MAPack.new(ema2000 = e2, slope2000 = e2 - e2[lookback], ema3000 = e3,
        slope3000 = e3 - e3[lookback], confirmedTime = time_close)

export swingPackV2(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    SwingPack.new(
        pivotHigh = ph,
        highOriginTime = na(ph) ? na : time[len],
        highOriginEndTime = na(ph) ? na : time_close[len],
        highConfirmedTime = na(ph) ? na : time_close,
        pivotLow = pl,
        lowOriginTime = na(pl) ? na : time[len],
        lowOriginEndTime = na(pl) ? na : time_close[len],
        lowConfirmedTime = na(pl) ? na : time_close)

f_accumCond(int n, int b, int atrLen, int minUpper, int minLower, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    float bodyTop = math.max(open, close)
    float bodyBot = math.min(open, close)
    float rangeHigh = ta.highest(bodyTop, n)
    float rangeLow = ta.lowest(bodyBot, n)
    float rangeNow = rangeHigh - rangeLow
    float rangeMid = (rangeHigh + rangeLow) * 0.5
    float rangeBase = ta.highest(bodyTop, b) - ta.lowest(bodyBot, b)
    float atrValue = ta.atr(atrLen)
    int upperCloses = 0
    int lowerCloses = 0
    int bullRun = 0
    int bearRun = 0
    int maxBullRun = 0
    int maxBearRun = 0
    if not na(rangeMid)
        for i = 0 to n - 1
            if close[i] > rangeMid
                upperCloses += 1
            else if close[i] < rangeMid
                lowerCloses += 1
            if close[i] > open[i]
                bullRun += 1
                bearRun := 0
            else if close[i] < open[i]
                bearRun += 1
                bullRun := 0
            else
                bullRun := 0
                bearRun := 0
            maxBullRun := math.max(maxBullRun, bullRun)
            maxBearRun := math.max(maxBearRun, bearRun)
    float startMid = (open[n - 1] + close[n - 1]) * 0.5
    float endMid = (open + close) * 0.5
    float drift = math.abs(endMid - startMid)
    bool condAtr = not na(atrValue) and atrValue > 0 and not na(rangeNow) and rangeNow <= atrValue * atrMult
    bool condBar = not na(rangeBase) and rangeBase > 0 and not na(rangeNow) and rangeNow <= rangeBase * barRatioMax
    bool condBalance = upperCloses >= minUpper and lowerCloses >= minLower
    bool condDrift = not na(rangeNow) and rangeNow > 0 and not na(drift) and drift / rangeNow <= driftMax
    bool condColorRun = maxBullRun <= maxRun and maxBearRun <= maxRun
    [condAtr and condBar and condBalance and condDrift and condColorRun, rangeHigh, rangeLow]

f_accumPackV2(int tfCode, int n, int b, int atrLen, int minUpper, int minLower, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    [isAccum, winTop, winBottom] = f_accumCond(n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    var bool candidate = false
    var float candTop = na
    var float candBottom = na
    var int candStartTime = na
    bool newBox = false
    float outTop = na
    float outBottom = na
    int outStart = na
    int outConfirmed = na
    int outId = na
    if isAccum and not candidate
        candidate := true
        candTop := winTop
        candBottom := winBottom
        candStartTime := time
    else if isAccum and candidate
        float bt = math.max(open, close)
        float bb = math.min(open, close)
        candTop := math.max(candTop, bt)
        candBottom := math.min(candBottom, bb)
    else if not isAccum and candidate
        newBox := true
        outTop := candTop
        outBottom := candBottom
        outStart := candStartTime
        outConfirmed := time_close
        outId := int(tfCode * 10000000000000 + candStartTime)
        candidate := false
        candTop := na
        candBottom := na
        candStartTime := na
    AccumPack.new(newConfirmedBox = newBox, boxTop = outTop, boxBottom = outBottom,
        boxId = outId, candidateStartTime = outStart, confirmedTime = outConfirmed, tfCode = tfCode)

f_fvgPackV2(int tfCode) =>
    bool bull = not na(high[2]) and low > high[2]
    bool bear = not na(low[2]) and high < low[2]
    FvgPack.new(
        newBull = bull, bullBottom = bull ? high[2] : na, bullTop = bull ? low : na,
        bullOriginTime = bull ? time : na, bullConfirmedTime = bull ? time_close : na,
        newBear = bear, bearBottom = bear ? high : na, bearTop = bear ? low[2] : na,
        bearOriginTime = bear ? time : na, bearConfirmedTime = bear ? time_close : na,
        sourceOpen = open, sourceHigh = high, sourceLow = low, sourceClose = close,
        sourceOpenTime = time, sourceCloseTime = time_close, tfCode = tfCode)

export pack1hV2(int swingLen, int n, int b, int atrLen, int minUpper, int minLower, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    SwingPack s = swingPackV2(swingLen)
    AccumPack a = f_accumPackV2(TF_1H, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    FvgPack f = f_fvgPackV2(TF_1H)
    TFPack.new(swing = s, accum = a, fvg = f)

export pack4hV2(int n, int b, int atrLen, int minUpper, int minLower, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    SwingPack s = SwingPack.new(pivotHigh = na, highOriginTime = na, highOriginEndTime = na, highConfirmedTime = na,
        pivotLow = na, lowOriginTime = na, lowOriginEndTime = na, lowConfirmedTime = na)
    AccumPack a = f_accumPackV2(TF_4H, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    FvgPack f = f_fvgPackV2(TF_4H)
    TFPack.new(swing = s, accum = a, fvg = f)

export pack1dV2(int n, int b, int atrLen, int minUpper, int minLower, int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    SwingPack s = SwingPack.new(pivotHigh = na, highOriginTime = na, highOriginEndTime = na, highConfirmedTime = na,
        pivotLow = na, lowOriginTime = na, lowOriginEndTime = na, lowConfirmedTime = na)
    AccumPack a = f_accumPackV2(TF_1D, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    FvgPack f = f_fvgPackV2(TF_1D)
    TFPack.new(swing = s, accum = a, fvg = f)

f_removeBootstrapFvgAt(array<int> dirs, array<float> bottoms, array<float> tops,
                       array<int> origins, array<int> confirmed, array<bool> fresh, int idx) =>
    array.remove(dirs, idx)
    array.remove(bottoms, idx)
    array.remove(tops, idx)
    array.remove(origins, idx)
    array.remove(confirmed, idx)
    array.remove(fresh, idx)
    true

f_htfBootstrapPackV2(int tfCode, int n, int b, int atrLen, int minUpper, int minLower,
                     int maxRun, float atrMult, float barRatioMax, float driftMax) =>
    // Stateful source-context collector. This runs inside request.security() on the
    // 4H / 1D timeframe, so 90d of structure is processed as a few hundred HTF bars,
    // not tens of thousands of 5m chart bars.
    var array<int> accumPairKeys = array.new<int>()
    var array<float> accumTops = array.new<float>()
    var array<float> accumBottoms = array.new<float>()
    var array<int> accumOrigins = array.new<int>()
    var array<int> accumConfirmed = array.new<int>()

    var array<int> fvgDirs = array.new<int>()
    var array<float> fvgBottoms = array.new<float>()
    var array<float> fvgTops = array.new<float>()
    var array<int> fvgOrigins = array.new<int>()
    var array<int> fvgConfirmed = array.new<int>()
    var array<bool> fvgFresh = array.new<bool>()

    AccumPack a = f_accumPackV2(tfCode, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    FvgPack f = f_fvgPackV2(tfCode)

    // Update previously formed FVGs with this confirmed source bar.
    int i = array.size(fvgDirs) - 1
    while i >= 0
        int dir = array.get(fvgDirs, i)
        float fb = array.get(fvgBottoms, i)
        float ft = array.get(fvgTops, i)
        int fc = array.get(fvgConfirmed, i)

        bool invalid = dir == FVG_BULLISH ? close < fb : close > ft
        if invalid
            f_removeBootstrapFvgAt(fvgDirs, fvgBottoms, fvgTops, fvgOrigins, fvgConfirmed, fvgFresh, i)
        else
            // Formation bar has time < confirmedTime. The next source bar starts at
            // confirmedTime, so >= counts the first genuine revisit.
            if array.get(fvgFresh, i) and time >= fc and high >= fb and low <= ft
                array.set(fvgFresh, i, false)
        i -= 1

    if a.newConfirmedBox and not na(a.confirmedTime) and not na(a.boxTop) and not na(a.boxBottom)
        array.push(accumPairKeys, a.boxId)
        array.push(accumTops, a.boxTop)
        array.push(accumBottoms, a.boxBottom)
        array.push(accumOrigins, a.candidateStartTime)
        array.push(accumConfirmed, a.confirmedTime)

    if f.newBull and not na(f.bullConfirmedTime)
        array.push(fvgDirs, FVG_BULLISH)
        array.push(fvgBottoms, f.bullBottom)
        array.push(fvgTops, f.bullTop)
        array.push(fvgOrigins, f.bullOriginTime)
        array.push(fvgConfirmed, f.bullConfirmedTime)
        array.push(fvgFresh, true)

    if f.newBear and not na(f.bearConfirmedTime)
        array.push(fvgDirs, FVG_BEARISH)
        array.push(fvgBottoms, f.bearBottom)
        array.push(fvgTops, f.bearTop)
        array.push(fvgOrigins, f.bearOriginTime)
        array.push(fvgConfirmed, f.bearConfirmedTime)
        array.push(fvgFresh, true)

    HTFBootstrapPack.new(
        accumPairKeys = accumPairKeys,
        accumTops = accumTops,
        accumBottoms = accumBottoms,
        accumOrigins = accumOrigins,
        accumConfirmed = accumConfirmed,
        fvgDirs = fvgDirs,
        fvgBottoms = fvgBottoms,
        fvgTops = fvgTops,
        fvgOrigins = fvgOrigins,
        fvgConfirmed = fvgConfirmed,
        fvgFresh = fvgFresh)

export bootstrap4hPackV2(int n, int b, int atrLen, int minUpper, int minLower, int maxRun,
                         float atrMult, float barRatioMax, float driftMax) =>
    f_htfBootstrapPackV2(TF_4H, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)

export bootstrap1dPackV2(int n, int b, int atrLen, int minUpper, int minLower, int maxRun,
                         float atrMult, float barRatioMax, float driftMax) =>
    f_htfBootstrapPackV2(TF_1D, n, b, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)

export makeFeed(float baseOpen, float baseHigh, float baseLow, float baseClose, float basePrevClose,
                int baseOpenTime, int baseCloseTime, int baseSeq, bool baseConfirmed, float mintick,
                MAPack ma1m, SwingPack swing5m, SwingPack swing15m,
                TFPack oneHour, TFPack fourHour, TFPack oneDay) =>
    ZoneFeed.new(baseOpen = baseOpen, baseHigh = baseHigh, baseLow = baseLow, baseClose = baseClose,
        basePrevClose = basePrevClose, baseOpenTime = baseOpenTime, baseCloseTime = baseCloseTime,
        baseSeq = baseSeq, baseConfirmed = baseConfirmed, mintick = mintick, ma1m = ma1m,
        swing5m = swing5m, swing15m = swing15m, oneHour = oneHour, fourHour = fourHour, oneDay = oneDay)

// ============================================================================
// Root registry and dirty range
// ============================================================================
f_markDirty(ZoneEngine e, float bottom, float top, ZoneCfg c) =>
    if not na(bottom) and not na(top)
        float lo = math.min(bottom, top) - c.clusterMaxWidth
        float hi = math.max(bottom, top) + c.clusterMaxWidth
        // Merge only overlapping already-expanded bands. If two bands remain
        // disjoint, no <=M point cluster can depend on both changed locations.
        int i = array.size(e.dirtyBottoms) - 1
        while i >= 0
            float qb = array.get(e.dirtyBottoms, i)
            float qt = array.get(e.dirtyTops, i)
            bool overlaps = hi >= qb and qt >= lo
            if overlaps
                lo := math.min(lo, qb)
                hi := math.max(hi, qt)
                array.remove(e.dirtyBottoms, i)
                array.remove(e.dirtyTops, i)
            i -= 1
        array.push(e.dirtyBottoms, lo)
        array.push(e.dirtyTops, hi)
        // Keep an aggregate only as a diagnostic/fallback. Active candidate work
        // uses one exact band at a time in f_rebuildDirtyTopology().
        if na(e.dirtyBottom)
            e.dirtyBottom := lo
            e.dirtyTop := hi
        else
            e.dirtyBottom := math.min(e.dirtyBottom, lo)
            e.dirtyTop := math.max(e.dirtyTop, hi)
        e.topologyDirty := true
    true

f_rootSlot(ZoneEngine e, int rootId) =>
    int slot = na
    if map.contains(e.rootIndex, rootId)
        slot := map.get(e.rootIndex, rootId)
    slot

f_getRoot(ZoneEngine e, int rootId) =>
    Root out = na
    int slot = f_rootSlot(e, rootId)
    if not na(slot) and slot >= 0 and slot < array.size(e.roots)
        Root r = array.get(e.roots, slot)
        if r.alive and r.rootId == rootId
            out := r
    out

// --------------------------------------------------------------------------
// Hot-path indexes
// --------------------------------------------------------------------------
f_isIndexedPointRoot(Root r) =>
    not na(r) and r.alive and not r.isRangeRoot and r.category != CAT_FVG and not na(r.pointPrice)

f_pointBefore(Root a, Root b) =>
    a.pointPrice < b.pointPrice or (a.pointPrice == b.pointPrice and a.rootId < b.rootId)

f_pointIndexInsert(ZoneEngine e, int rootId) =>
    int slot = f_rootSlot(e, rootId)
    if not na(slot)
        Root r = array.get(e.roots, slot)
        if f_isIndexedPointRoot(r)
            int lo = 0
            int hi = array.size(e.pointPriceIndex)
            while lo < hi
                int mid = int(math.floor((lo + hi) * 0.5))
                int qSlot = array.get(e.pointPriceIndex, mid)
                Root q = array.get(e.roots, qSlot)
                bool before = not q.alive or f_pointBefore(r, q)
                if before
                    hi := mid
                else
                    lo := mid + 1
            array.insert(e.pointPriceIndex, lo, slot)
    true

f_pointIndexLowerBound(ZoneEngine e, float price) =>
    int lo = 0
    int hi = array.size(e.pointPriceIndex)
    while lo < hi
        int mid = int(math.floor((lo + hi) * 0.5))
        Root q = array.get(e.roots, array.get(e.pointPriceIndex, mid))
        if not q.alive or q.pointPrice >= price
            hi := mid
        else
            lo := mid + 1
    lo

f_pointIndexFindByPrice(ZoneEngine e, int rootId, float price) =>
    int pos = na
    if not na(price)
        int i = f_pointIndexLowerBound(e, price)
        int n = array.size(e.pointPriceIndex)
        bool done = false
        while i < n and not done
            int slot = array.get(e.pointPriceIndex, i)
            Root q = array.get(e.roots, slot)
            if not q.alive or q.pointPrice != price
                done := true
            else
                if q.rootId == rootId
                    pos := i
                    done := true
                else
                    i += 1
    pos

f_pointIndexRepositionAt(ZoneEngine e, int rootId, int pos) =>
    int curPos = pos
    int slot = f_rootSlot(e, rootId)
    if not na(slot) and not na(curPos) and curPos >= 0 and curPos < array.size(e.pointPriceIndex)
        Root r = array.get(e.roots, slot)
        bool moving = true
        while moving and curPos > 0
            int prevSlot = array.get(e.pointPriceIndex, curPos - 1)
            Root prev = array.get(e.roots, prevSlot)
            if prev.alive and f_pointBefore(r, prev)
                array.set(e.pointPriceIndex, curPos - 1, slot)
                array.set(e.pointPriceIndex, curPos, prevSlot)
                curPos -= 1
            else
                moving := false
        moving := true
        while moving and curPos + 1 < array.size(e.pointPriceIndex)
            int nextSlot = array.get(e.pointPriceIndex, curPos + 1)
            Root nxt = array.get(e.roots, nextSlot)
            if nxt.alive and f_pointBefore(nxt, r)
                array.set(e.pointPriceIndex, curPos + 1, slot)
                array.set(e.pointPriceIndex, curPos, nextSlot)
                curPos += 1
            else
                moving := false
    true

f_removeSlotValue(array<int> slots, int slot) =>
    int n = array.size(slots)
    if n > 0
        for i = n - 1 to 0
            if array.get(slots, i) == slot
                array.remove(slots, i)
                break
    true

f_categoryMaskFromIds(ZoneEngine e, array<int> ids) =>
    int mask = 0
    int n = array.size(ids)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(ids, i))
            if not na(r)
                mask := f_maskAdd(mask, f_catBit(r.category))
    mask

f_allocRoot(ZoneEngine e, Root r) =>
    int slot = na
    if array.size(e.freeRootSlots) > 0
        slot := array.pop(e.freeRootSlots)
        array.set(e.roots, slot, r)
    else
        slot := array.size(e.roots)
        array.push(e.roots, r)
    map.put(e.rootIndex, r.rootId, slot)
    if f_isIndexedPointRoot(r)
        f_pointIndexInsert(e, r.rootId)
    if r.category == CAT_SWING
        array.push(e.swingSlots, slot)
    else if r.category == CAT_ACCUM
        array.push(e.accumSlots, slot)
    else if r.category == CAT_TIME_HL
        array.push(e.timeSlots, slot)
    else if r.category == CAT_FVG
        array.push(e.fvgSlots, slot)
    e.liveRootCount += 1
    e.storageCheckDirty := true
    slot

f_newRoot(ZoneEngine e, int fixedId, int originKey, int category, int subtype, int tfCode, int tfMask,
          int originTime, int originEndTime, int confirmedTime, float pointPrice, float nativeBottom,
          float nativeTop, bool isRangeRoot, bool isDynamic, int state, int pairKey, int direction,
          bool fvgFresh, bool isBroadFvg, int labelMask, int seq, int slopeSign) =>
    int id = na(fixedId) ? e.nextRootId : fixedId
    if na(fixedId)
        e.nextRootId += 1
    Root r = Root.new(alive = true, rootId = id, originKey = originKey, category = category, subtype = subtype,
        tfCode = tfCode, tfMask = tfMask, originTime = originTime, originEndTime = originEndTime,
        confirmedTime = confirmedTime, pointPrice = pointPrice, nativeBottom = nativeBottom, nativeTop = nativeTop,
        isRangeRoot = isRangeRoot, isDynamic = isDynamic, state = state, pairKey = pairKey,
        direction = direction, fvgFresh = fvgFresh, isBroadFvg = isBroadFvg, labelMask = labelMask,
        lastUpdateSeq = seq, slopeSign = slopeSign, inverseMovedAway = false, inverseRetestSeen = false,
        lastSourceCloseTime = confirmedTime, emaGuardLow = na, emaGuardHigh = na,
        emaGuardSlopeSign = 0, emaGuardValid = false, workStamp = 0)
    f_allocRoot(e, r)
    id

f_retireRoot(ZoneEngine e, int rootId, ZoneCfg c) =>
    int slot = f_rootSlot(e, rootId)
    if not na(slot)
        Root r = array.get(e.roots, slot)
        if r.alive
            f_markDirty(e, f_rootBottom(r), f_rootTop(r), c)
            if f_isIndexedPointRoot(r)
                // Price-aware lookup avoids a full point-index scan on retirement.
                int pp = f_pointIndexFindByPrice(e, rootId, r.pointPrice)
                if not na(pp)
                    array.remove(e.pointPriceIndex, pp)
            if r.category == CAT_SWING
                f_removeSlotValue(e.swingSlots, slot)
            else if r.category == CAT_ACCUM
                f_removeSlotValue(e.accumSlots, slot)
            else if r.category == CAT_TIME_HL
                f_removeSlotValue(e.timeSlots, slot)
            else if r.category == CAT_FVG
                f_removeSlotValue(e.fvgSlots, slot)
                f_removeSlotValue(e.freshFvgSlots, slot)
                f_removeSlotValue(e.inverseWaitSlots, slot)
            r.alive := false
            r.state := ROOT_RETIRED
            map.remove(e.rootIndex, rootId)
            array.push(e.freeRootSlots, slot)
            e.liveRootCount -= 1
            e.eligibilityDirty := true
    true

f_psychId(float level, float mt) => -2000000000 + f_tick(level, mt)

f_ensurePsychLevel(ZoneEngine e, float level, int seq, int t, ZoneCfg c) =>
    if c.enablePsych
        float p = f_norm(level, c.mintick)
        int id = f_psychId(p, c.mintick)
        if na(f_getRoot(e, id))
            float rem100 = math.abs(p - math.round(p / 100.0) * 100.0)
            bool major = rem100 <= c.mintick * 0.5
            int st = major ? SUB_PSYCH_MAJOR : SUB_PSYCH_STD
            f_newRoot(e, id, id, CAT_PSYCH, st, 0, 0, t, t, t, p, p, p,
                false, false, ROOT_ACTIVE, 0, FVG_NONE, false, false, 0, seq, 0)
            f_markDirty(e, p, p, c)
    true

f_ensurePsychNear(ZoneEngine e, float bottom, float top, int seq, int t, ZoneCfg c) =>
    if c.enablePsych and not na(bottom) and not na(top)
        float lo = math.min(bottom, top) - c.clusterMaxWidth
        float hi = math.max(bottom, top) + c.clusterMaxWidth
        int k0 = int(math.ceil(lo / 50.0))
        int k1 = int(math.floor(hi / 50.0))
        if k1 >= k0
            for k = k0 to k1
                f_ensurePsychLevel(e, k * 50.0, seq, t, c)
    true

// Topology rebuild already owns the active dirty band. Psychological roots that
// are materialized only to evaluate that band must not widen/requeue the same
// rebuild. Source/root ingestion still uses f_ensurePsychNear(), which marks
// genuinely new affected topology in the normal way.
f_ensurePsychLevelForBuild(ZoneEngine e, float level, int seq, int t, ZoneCfg c) =>
    if c.enablePsych
        float p = f_norm(level, c.mintick)
        int id = f_psychId(p, c.mintick)
        if na(f_getRoot(e, id))
            float rem100 = math.abs(p - math.round(p / 100.0) * 100.0)
            bool major = rem100 <= c.mintick * 0.5
            int st = major ? SUB_PSYCH_MAJOR : SUB_PSYCH_STD
            f_newRoot(e, id, id, CAT_PSYCH, st, 0, 0, t, t, t, p, p, p,
                false, false, ROOT_ACTIVE, 0, FVG_NONE, false, false, 0, seq, 0)
    true

f_ensurePsychNearForBuild(ZoneEngine e, float bottom, float top, int seq, int t, ZoneCfg c) =>
    if c.enablePsych and not na(bottom) and not na(top)
        float lo = math.min(bottom, top) - c.clusterMaxWidth
        float hi = math.max(bottom, top) + c.clusterMaxWidth
        int k0 = int(math.ceil(lo / 50.0))
        int k1 = int(math.floor(hi / 50.0))
        if k1 >= k0
            for k = k0 to k1
                f_ensurePsychLevelForBuild(e, k * 50.0, seq, t, c)
    true

f_findSwingMerge(ZoneEngine e, int subtype, int tfCode, float price, int originTime, int originEndTime, ZoneCfg c) =>
    int found = na
    int n = array.size(e.swingSlots)
    if n > 0
        int pt = f_tick(price, c.mintick)
        for k = 0 to n - 1
            int slot = array.get(e.swingSlots, k)
            Root r = array.get(e.roots, slot)
            if r.alive and r.subtype == subtype and f_tick(r.pointPrice, c.mintick) == pt
                bool same = false
                if tfCode > r.tfCode
                    same := r.originTime >= originTime and r.originTime < originEndTime
                else if tfCode < r.tfCode
                    same := originTime >= r.originTime and originTime < r.originEndTime
                else
                    same := originTime == r.originTime
                if same
                    found := slot
                    break
    found

f_ingestSwingEvent(ZoneEngine e, int subtype, int tfCode, float price, int originTime, int originEndTime, int confirmedTime, int seq, ZoneCfg c) =>
    if c.enableSwing and not na(price) and not na(originTime) and not na(confirmedTime)
        float p = f_norm(price, c.mintick)
        int slot = f_findSwingMerge(e, subtype, tfCode, p, originTime, originEndTime, c)
        if not na(slot)
            Root r = array.get(e.roots, slot)
            int oldMask = r.tfMask
            r.tfMask := f_maskAdd(r.tfMask, f_tfMask(tfCode))
            if tfCode > r.tfCode
                r.tfCode := tfCode
                r.originTime := originTime
                r.originEndTime := originEndTime
            r.confirmedTime := math.min(r.confirmedTime, confirmedTime)
            r.lastUpdateSeq := seq
            if r.tfMask != oldMask
                f_markDirty(e, p, p, c)
        else
            int id = f_newRoot(e, na, e.nextRootId, CAT_SWING, subtype, tfCode, f_tfMask(tfCode),
                originTime, originEndTime, confirmedTime, p, p, p, false, false, ROOT_ACTIVE, 0,
                FVG_NONE, false, false, 0, seq, 0)
            Root nr = f_getRoot(e, id)
            nr.originKey := id
            f_markDirty(e, p, p, c)
            f_ensurePsychNear(e, p, p, seq, confirmedTime, c)
    true

f_ingestSwingPack(ZoneEngine e, SwingPack s, int tfCode, int seq, int baseCloseTime, ZoneCfg c) =>
    if not na(s)
        if not na(s.highConfirmedTime) and s.highConfirmedTime <= baseCloseTime
            f_ingestSwingEvent(e, SUB_SWING_HIGH, tfCode, s.pivotHigh, s.highOriginTime, s.highOriginEndTime, s.highConfirmedTime, seq, c)
        if not na(s.lowConfirmedTime) and s.lowConfirmedTime <= baseCloseTime
            f_ingestSwingEvent(e, SUB_SWING_LOW, tfCode, s.pivotLow, s.lowOriginTime, s.lowOriginEndTime, s.lowConfirmedTime, seq, c)
    true

f_ingestAccumPack(ZoneEngine e, AccumPack a, int seq, int baseCloseTime, ZoneCfg c) =>
    if c.enableAccum and not na(a) and a.newConfirmedBox and not na(a.confirmedTime) and a.confirmedTime <= baseCloseTime and not na(a.boxTop) and not na(a.boxBottom)
        bool exists = false
        int n = array.size(e.accumSlots)
        if n > 0
            for k = 0 to n - 1
                Root r = array.get(e.roots, array.get(e.accumSlots, k))
                if r.alive and r.pairKey == a.boxId
                    exists := true
                    break
        if not exists
            float top = f_norm(a.boxTop, c.mintick)
            float bot = f_norm(a.boxBottom, c.mintick)
            int idTop = f_newRoot(e, na, e.nextRootId, CAT_ACCUM, SUB_ACCUM_TOP, a.tfCode, 0,
                a.candidateStartTime, a.confirmedTime, a.confirmedTime, top, top, top, false, false,
                ROOT_ACTIVE, a.boxId, FVG_NONE, false, false, 0, seq, 0)
            Root rt = f_getRoot(e, idTop)
            Root rb = na
            rt.originKey := idTop
            int idBot = f_newRoot(e, na, e.nextRootId, CAT_ACCUM, SUB_ACCUM_BOTTOM, a.tfCode, 0,
                a.candidateStartTime, a.confirmedTime, a.confirmedTime, bot, bot, bot, false, false,
                ROOT_ACTIVE, a.boxId, FVG_NONE, false, false, 0, seq, 0)
            rb := f_getRoot(e, idBot)
            rb.originKey := idBot
            f_markDirty(e, bot, top, c)
            f_ensurePsychNear(e, bot, top, seq, a.confirmedTime, c)
    true

f_findFvg(ZoneEngine e, int tfCode, int originTime, int dir) =>
    int found = na
    int n = array.size(e.fvgSlots)
    if n > 0
        for k = 0 to n - 1
            int slot = array.get(e.fvgSlots, k)
            Root r = array.get(e.roots, slot)
            if r.alive and r.tfCode == tfCode and r.originTime == originTime and r.direction == dir
                found := slot
                break
    found

f_ingestFvgEvent(ZoneEngine e, int tfCode, int dir, float bottom, float top, int originTime, int confirmedTime, int seq, ZoneCfg c) =>
    if c.enableFVG and not na(bottom) and not na(top) and not na(confirmedTime)
        int dup = f_findFvg(e, tfCode, originTime, dir)
        if na(dup)
            float b = f_norm(math.min(bottom, top), c.mintick)
            float t = f_norm(math.max(bottom, top), c.mintick)
            bool broad = f_widthGt(b, t, c.clusterMaxWidth, c.mintick)
            int id = f_newRoot(e, na, e.nextRootId, CAT_FVG, SUB_FVG, tfCode, 0, originTime,
                confirmedTime, confirmedTime, na, b, t, true, false, ROOT_ACTIVE, 0, dir, true,
                broad, 0, seq, 0)
            Root r = f_getRoot(e, id)
            r.originKey := id
            int slot = f_rootSlot(e, id)
            array.push(e.freshFvgSlots, slot)
            f_markDirty(e, b, t, c)
            if not broad
                f_ensurePsychNear(e, b, t, seq, confirmedTime, c)
    true

f_ingestFvgPack(ZoneEngine e, FvgPack p, int seq, int baseCloseTime, ZoneCfg c) =>
    if not na(p)
        if p.newBull and not na(p.bullConfirmedTime) and p.bullConfirmedTime <= baseCloseTime
            f_ingestFvgEvent(e, p.tfCode, FVG_BULLISH, p.bullBottom, p.bullTop, p.bullOriginTime, p.bullConfirmedTime, seq, c)
        if p.newBear and not na(p.bearConfirmedTime) and p.bearConfirmedTime <= baseCloseTime
            f_ingestFvgEvent(e, p.tfCode, FVG_BEARISH, p.bearBottom, p.bearTop, p.bearOriginTime, p.bearConfirmedTime, seq, c)
    true

// Bootstrap injection API. Core Engine logic is unchanged from the /9 base;
// these only seed already-confirmed structural Roots before the 14d Base state run.
export bootstrapAccumRoot(ZoneEngine e, ZoneCfg c, int tfCode, int pairKey,
                          float boxTop, float boxBottom, int originTime,
                          int confirmedTime, int seq, int baseCloseTime) =>
    bool added = false
    if c.enableAccum and not na(boxTop) and not na(boxBottom) and not na(confirmedTime) and confirmedTime <= baseCloseTime
        int before = e.liveRootCount
        AccumPack a = AccumPack.new(newConfirmedBox = true, boxTop = boxTop, boxBottom = boxBottom,
            boxId = pairKey, candidateStartTime = originTime, confirmedTime = confirmedTime, tfCode = tfCode)
        f_ingestAccumPack(e, a, seq, baseCloseTime, c)
        added := e.liveRootCount > before
    added

export bootstrapFvgRoot(ZoneEngine e, ZoneCfg c, int tfCode, int direction,
                        float nativeBottom, float nativeTop, int originTime,
                        int confirmedTime, int seq, int baseCloseTime, bool fresh) =>
    bool added = false
    if c.enableFVG and not na(nativeBottom) and not na(nativeTop) and not na(confirmedTime) and confirmedTime <= baseCloseTime
        int before = e.liveRootCount
        f_ingestFvgEvent(e, tfCode, direction, nativeBottom, nativeTop, originTime, confirmedTime, seq, c)
        int slot = f_findFvg(e, tfCode, originTime, direction)
        if not na(slot)
            Root r = array.get(e.roots, slot)
            if not fresh and r.fvgFresh
                r.fvgFresh := false
                f_removeSlotValue(e.freshFvgSlots, slot)
        added := e.liveRootCount > before
    added

f_emit(ZoneEngine e, int typ, ZoneFeed f, int coreId, int genId, int side, float b, float t,
       int touchNo, int gradeStart, int weakReason, int rootId) =>
    array.push(e.events, ZoneEvent.new(eventType = typ, time = f.baseCloseTime, baseSeq = f.baseSeq,
        coreId = coreId, generationId = genId, side = side, rangeBottom = b, rangeTop = t,
        touchNo = touchNo, gradeAtStart = gradeStart, weakReason = weakReason, rootId = rootId))
    true

f_invalidateFvgsForSource(ZoneEngine e, FvgPack p, ZoneFeed f, ZoneCfg c) =>
    if c.enableFVG and not na(p) and not na(p.sourceCloseTime) and p.sourceCloseTime <= f.baseCloseTime
        // Section 21 gates this to a newly confirmed source bar only, so it is
        // an event scan, not a per-Base-bar scan.
        if c.countersOn
            e.fvgFullScanCount += 1
        int n = array.size(e.fvgSlots)
        if n > 0
            for k = 0 to n - 1
                int slot = array.get(e.fvgSlots, k)
                Root r = array.get(e.roots, slot)
                if r.alive and r.tfCode == p.tfCode and f_isFvgLive(r) and r.lastSourceCloseTime < p.sourceCloseTime
                    bool inv = r.direction == FVG_BULLISH ? f_lt(p.sourceClose, r.nativeBottom, c.mintick) : f_gt(p.sourceClose, r.nativeTop, c.mintick)
                    r.lastSourceCloseTime := p.sourceCloseTime
                    if inv
                        r.state := ROOT_INVERSE_WAIT
                        r.inverseMovedAway := false
                        r.inverseRetestSeen := false
                        r.fvgFresh := false
                        e.eligibilityDirty := true
                        f_markDirty(e, r.nativeBottom, r.nativeTop, c)
                        if not f_arrayHasInt(e.inverseWaitSlots, slot)
                            array.push(e.inverseWaitSlots, slot)
                        f_emit(e, EV_FVG_INVALIDATE, f, na, na, SIDE_NONE, r.nativeBottom, r.nativeTop, 0, GR_UNAVAILABLE, WEAK_NONE, r.rootId)
    true

f_refreshFvgFreshViews(ZoneEngine e, int rootId) =>
    int cn = array.size(e.liveCoreSlots)
    if cn > 0
        for ci = 0 to cn - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, ci))
            if f_arrayHasInt(z.supportView.rootIds, rootId)
                int freshN = 0
                int rn = array.size(z.supportView.rootIds)
                if rn > 0
                    for k = 0 to rn - 1
                        Root r = f_getRoot(e, array.get(z.supportView.rootIds, k))
                        if not na(r) and r.category == CAT_FVG and r.fvgFresh
                            freshN += 1
                z.supportView.fvgFreshCount := freshN
            if f_arrayHasInt(z.resistanceView.rootIds, rootId)
                int freshN = 0
                int rn = array.size(z.resistanceView.rootIds)
                if rn > 0
                    for k = 0 to rn - 1
                        Root r = f_getRoot(e, array.get(z.resistanceView.rootIds, k))
                        if not na(r) and r.category == CAT_FVG and r.fvgFresh
                            freshN += 1
                z.resistanceView.fvgFreshCount := freshN
    true

f_updateFvgFresh(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    int i = array.size(e.freshFvgSlots) - 1
    while i >= 0
        int slot = array.get(e.freshFvgSlots, i)
        bool remove = true
        if slot >= 0 and slot < array.size(e.roots)
            Root r = array.get(e.roots, slot)
            if r.alive and r.category == CAT_FVG and r.fvgFresh and f.baseCloseTime > r.confirmedTime
                bool hit = f_intersects(f.baseLow, f.baseHigh, r.nativeBottom, r.nativeTop, c.mintick)
                if hit
                    // FVG Fresh is diagnostic/output state only. It does not change
                    // C/H/Density, participation or EffectiveRange, so avoid an
                    // expensive topology rebuild and refresh only Views that contain
                    // this Root.
                    r.fvgFresh := false
                    f_refreshFvgFreshViews(e, r.rootId)
                else
                    remove := false
        if remove
            array.remove(e.freshFvgSlots, i)
        i -= 1
    true

f_updateInverseWait(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    int i = array.size(e.inverseWaitSlots) - 1
    while i >= 0
        int slot = array.get(e.inverseWaitSlots, i)
        bool done = true
        if slot >= 0 and slot < array.size(e.roots)
            Root r = array.get(e.roots, slot)
            if r.alive and r.state == ROOT_INVERSE_WAIT
                done := false
                if not r.inverseMovedAway
                    if r.direction == FVG_BULLISH and f_le(f.baseClose, r.nativeBottom - c.touchResetDistance, c.mintick)
                        r.inverseMovedAway := true
                    else if r.direction == FVG_BEARISH and f_ge(f.baseClose, r.nativeTop + c.touchResetDistance, c.mintick)
                        r.inverseMovedAway := true
                else
                    bool retest = f_intersects(f.baseLow, f.baseHigh, r.nativeBottom, r.nativeTop, c.mintick)
                    if retest
                        r.inverseRetestSeen := true
                        bool confirm = r.direction == FVG_BULLISH ? f_le(f.baseClose, r.nativeBottom, c.mintick) : f_ge(f.baseClose, r.nativeTop, c.mintick)
                        if confirm
                            r.direction := -r.direction
                            r.state := ROOT_INVERSE_ACTIVE
                            r.inverseMovedAway := false
                            r.inverseRetestSeen := false
                            e.eligibilityDirty := true
                            f_markDirty(e, r.nativeBottom, r.nativeTop, c)
                            f_emit(e, EV_INVERSE_CONFIRM, f, na, na, r.direction == FVG_BULLISH ? SIDE_SUPPORT : SIDE_RESISTANCE,
                                r.nativeBottom, r.nativeTop, 0, GR_UNAVAILABLE, WEAK_NONE, r.rootId)
                            done := true
                        else
                            f_emit(e, EV_INVERSE_ATTEMPT, f, na, na, r.direction == FVG_BULLISH ? SIDE_RESISTANCE : SIDE_SUPPORT,
                                r.nativeBottom, r.nativeTop, 0, GR_UNAVAILABLE, WEAK_NONE, r.rootId)
        if done
            array.remove(e.inverseWaitSlots, i)
        i -= 1
    true

// ============================================================================
// Session / day / week high-low roots from confirmed 5m bars
// ============================================================================
f_dateKey(int ts, string tz) => year(ts, tz) * 10000 + month(ts, tz) * 100 + dayofmonth(ts, tz)

f_dayKey(int ts, ZoneCfg c) =>
    int shifted = ts - c.dayStartHour * 60 * 60 * 1000
    f_dateKey(shifted, c.zoneTimezone)

f_weekKey(int ts, ZoneCfg c) =>
    int shifted = ts - c.weekStartHour * 60 * 60 * 1000
    int dow = dayofweek(shifted, c.zoneTimezone)
    int delta = (dow - dayofweek.monday + 7) % 7
    int mondayTs = shifted - delta * 24 * 60 * 60 * 1000
    f_dateKey(mondayTs, c.zoneTimezone)

f_sessionKey(int ts, ZoneCfg c) =>
    int h = hour(ts, c.zoneTimezone)
    int sid = 0
    int anchorTs = ts
    if h >= c.asiaStartHour and h < c.asiaEndHour
        sid := 1
    else if h >= c.europeStartHour and h < c.europeEndHour
        sid := 2
    else if h >= c.nyStartHour or h < c.nyEndHour
        sid := 3
        if h < c.nyEndHour
            anchorTs := ts - 24 * 60 * 60 * 1000
    sid == 0 ? na : f_dateKey(anchorTs, c.zoneTimezone) * 10 + sid

f_mergeTimeLabels(ZoneEngine e, int rootId, ZoneCfg c) =>
    Root base = f_getRoot(e, rootId)
    if not na(base)
        int k = array.size(e.timeSlots) - 1
        while k >= 0
            int slot = array.get(e.timeSlots, k)
            Root r = array.get(e.roots, slot)
            bool sameTimeRoot = r.alive and r.rootId != base.rootId
            sameTimeRoot := sameTimeRoot and r.subtype == base.subtype
            sameTimeRoot := sameTimeRoot and r.originTime == base.originTime
            sameTimeRoot := sameTimeRoot and f_eq(r.pointPrice, base.pointPrice, c.mintick)
            if sameTimeRoot
                int rid = r.rootId
                base.labelMask := f_maskUnion(base.labelMask, r.labelMask)
                f_retireRoot(e, rid, c)
            k -= 1
    true

// FIX 22.1a. One real market event produces ONE Time H/L Root carrying every
// label it satisfies. The reference build created a separate Root per label, so
// a single high that was simultaneously the session, day and week high looked
// like three independent origins and wrongly satisfied the Time H/L High
// condition (which requires genuinely different origins).
f_findTimeRootSameOrigin(ZoneEngine e, int subtype, float price, int originTime, ZoneCfg c) =>
    int found = na
    int n = array.size(e.timeSlots)
    if n > 0
        for k = 0 to n - 1
            int slot = array.get(e.timeSlots, k)
            Root r = array.get(e.roots, slot)
            if r.alive and r.subtype == subtype and r.originTime == originTime and f_eq(r.pointPrice, price, c.mintick)
                found := r.rootId
                break
    found

f_newTimeRoot(ZoneEngine e, int subtype, float price, int originTime, int labelMask, ZoneFeed f, ZoneCfg c) =>
    float p = f_norm(price, c.mintick)
    int existing = f_findTimeRootSameOrigin(e, subtype, p, originTime, c)
    int id = na
    if not na(existing)
        Root er = f_getRoot(e, existing)
        int merged = f_maskUnion(er.labelMask, labelMask)
        if merged != er.labelMask
            er.labelMask := merged
            er.lastUpdateSeq := f.baseSeq
            // RC_LABEL_CHANGED: the label set feeds the Time H/L High test, so the
            // Root's own price band is re-evaluated, nothing wider.
            f_markDirty(e, p, p, c)
        id := existing
    else
        id := f_newRoot(e, na, e.nextRootId, CAT_TIME_HL, subtype, TF_5M, 0, originTime,
            f.baseCloseTime, f.baseCloseTime, p, p, p, false, true, ROOT_ACTIVE, 0, FVG_NONE,
            false, false, labelMask, f.baseSeq, 0)
        Root r = f_getRoot(e, id)
        r.originKey := id
        f_markDirty(e, p, p, c)
        f_ensurePsychNear(e, p, p, f.baseSeq, f.baseCloseTime, c)
    id

// FIX 22.1b. Superseding one label must not destroy a Root that other live
// labels still point at. Only this label is removed; the Root is retired solely
// when nothing references it any more. The caller receives the surviving Root
// id, so sessionHighRootId / dayHighRootId / weekHighRootId stay correct.
f_replaceTimeRoot(ZoneEngine e, int oldId, int subtype, float price, int originTime, int labelMask, ZoneFeed f, ZoneCfg c) =>
    if not na(oldId)
        Root old = f_getRoot(e, oldId)
        if not na(old)
            old.labelMask := f_maskRemove(old.labelMask, labelMask)
            if old.labelMask == 0
                f_retireRoot(e, oldId, c)
            else
                f_markDirty(e, old.pointPrice, old.pointPrice, c)
    f_newTimeRoot(e, subtype, price, originTime, labelMask, f, c)

f_moveTimeLabel(ZoneEngine e, int rootId, int fromMask, int toMask, ZoneCfg c) =>
    Root r = f_getRoot(e, rootId)
    if not na(r)
        r.labelMask := f_maskAdd(f_maskRemove(r.labelMask, fromMask), toMask)
        f_mergeTimeLabels(e, rootId, c)
    true

f_dropLabelAndRetireIfEmpty(ZoneEngine e, int rootId, int labelMask, ZoneCfg c) =>
    Root r = f_getRoot(e, rootId)
    if not na(r)
        r.labelMask := f_maskRemove(r.labelMask, labelMask)
        if r.labelMask == 0
            f_retireRoot(e, rootId, c)
    true

f_finalizeSession(ZoneEngine e, ZoneCfg c) =>
    if not na(e.prevSessionHighRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevSessionHighRootId, TL_PREV_SESSION, c)
    if not na(e.prevSessionLowRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevSessionLowRootId, TL_PREV_SESSION, c)
    e.prevSessionHighRootId := e.sessionHighRootId
    e.prevSessionLowRootId := e.sessionLowRootId
    if not na(e.sessionHighRootId)
        f_moveTimeLabel(e, e.sessionHighRootId, TL_CUR_SESSION, TL_PREV_SESSION, c)
    if not na(e.sessionLowRootId)
        f_moveTimeLabel(e, e.sessionLowRootId, TL_CUR_SESSION, TL_PREV_SESSION, c)
    e.sessionHighRootId := na
    e.sessionLowRootId := na
    e.sessionHigh := na
    e.sessionLow := na
    e.sessionHighOrigin := na
    e.sessionLowOrigin := na
    true

f_finalizeDay(ZoneEngine e, ZoneCfg c) =>
    if not na(e.prevDayHighRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevDayHighRootId, TL_PREV_DAY, c)
    if not na(e.prevDayLowRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevDayLowRootId, TL_PREV_DAY, c)
    e.prevDayHighRootId := e.dayHighRootId
    e.prevDayLowRootId := e.dayLowRootId
    if not na(e.dayHighRootId)
        f_moveTimeLabel(e, e.dayHighRootId, TL_CUR_DAY, TL_PREV_DAY, c)
    if not na(e.dayLowRootId)
        f_moveTimeLabel(e, e.dayLowRootId, TL_CUR_DAY, TL_PREV_DAY, c)
    e.dayHighRootId := na
    e.dayLowRootId := na
    e.dayHigh := na
    e.dayLow := na
    e.dayHighOrigin := na
    e.dayLowOrigin := na
    true

f_finalizeWeek(ZoneEngine e, ZoneCfg c) =>
    if not na(e.prevWeekHighRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevWeekHighRootId, TL_PREV_WEEK, c)
    if not na(e.prevWeekLowRootId)
        f_dropLabelAndRetireIfEmpty(e, e.prevWeekLowRootId, TL_PREV_WEEK, c)
    e.prevWeekHighRootId := e.weekHighRootId
    e.prevWeekLowRootId := e.weekLowRootId
    if not na(e.weekHighRootId)
        f_moveTimeLabel(e, e.weekHighRootId, TL_CUR_WEEK, TL_PREV_WEEK, c)
    if not na(e.weekLowRootId)
        f_moveTimeLabel(e, e.weekLowRootId, TL_CUR_WEEK, TL_PREV_WEEK, c)
    e.weekHighRootId := na
    e.weekLowRootId := na
    e.weekHigh := na
    e.weekLow := na
    e.weekHighOrigin := na
    e.weekLowOrigin := na
    true

f_updateTimeHL(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    if c.enableTimeHL
        int sk = f_sessionKey(f.baseOpenTime, c)
        if na(sk)
            if not na(e.sessionKey)
                f_finalizeSession(e, c)
                e.sessionKey := na
        else
            if na(e.sessionKey) or sk != e.sessionKey
                if not na(e.sessionKey)
                    f_finalizeSession(e, c)
                e.sessionKey := sk
                e.sessionHigh := f.baseHigh
                e.sessionLow := f.baseLow
                e.sessionHighOrigin := f.baseOpenTime
                e.sessionLowOrigin := f.baseOpenTime
                e.sessionHighRootId := f_newTimeRoot(e, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_SESSION, f, c)
                e.sessionLowRootId := f_newTimeRoot(e, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_SESSION, f, c)
            else
                if f_gt(f.baseHigh, e.sessionHigh, c.mintick)
                    e.sessionHigh := f.baseHigh
                    e.sessionHighOrigin := f.baseOpenTime
                    e.sessionHighRootId := f_replaceTimeRoot(e, e.sessionHighRootId, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_SESSION, f, c)
                if f_lt(f.baseLow, e.sessionLow, c.mintick)
                    e.sessionLow := f.baseLow
                    e.sessionLowOrigin := f.baseOpenTime
                    e.sessionLowRootId := f_replaceTimeRoot(e, e.sessionLowRootId, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_SESSION, f, c)

        int dk = f_dayKey(f.baseOpenTime, c)
        if na(e.dayKey) or dk != e.dayKey
            if not na(e.dayKey)
                f_finalizeDay(e, c)
            e.dayKey := dk
            e.dayHigh := f.baseHigh
            e.dayLow := f.baseLow
            e.dayHighOrigin := f.baseOpenTime
            e.dayLowOrigin := f.baseOpenTime
            e.dayHighRootId := f_newTimeRoot(e, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_DAY, f, c)
            e.dayLowRootId := f_newTimeRoot(e, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_DAY, f, c)
        else
            if f_gt(f.baseHigh, e.dayHigh, c.mintick)
                e.dayHigh := f.baseHigh
                e.dayHighOrigin := f.baseOpenTime
                e.dayHighRootId := f_replaceTimeRoot(e, e.dayHighRootId, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_DAY, f, c)
            if f_lt(f.baseLow, e.dayLow, c.mintick)
                e.dayLow := f.baseLow
                e.dayLowOrigin := f.baseOpenTime
                e.dayLowRootId := f_replaceTimeRoot(e, e.dayLowRootId, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_DAY, f, c)

        int wk = f_weekKey(f.baseOpenTime, c)
        if na(e.weekKey) or wk != e.weekKey
            if not na(e.weekKey)
                f_finalizeWeek(e, c)
            e.weekKey := wk
            e.weekHigh := f.baseHigh
            e.weekLow := f.baseLow
            e.weekHighOrigin := f.baseOpenTime
            e.weekLowOrigin := f.baseOpenTime
            e.weekHighRootId := f_newTimeRoot(e, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_WEEK, f, c)
            e.weekLowRootId := f_newTimeRoot(e, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_WEEK, f, c)
        else
            if f_gt(f.baseHigh, e.weekHigh, c.mintick)
                e.weekHigh := f.baseHigh
                e.weekHighOrigin := f.baseOpenTime
                e.weekHighRootId := f_replaceTimeRoot(e, e.weekHighRootId, SUB_TIME_HIGH, f.baseHigh, f.baseOpenTime, TL_CUR_WEEK, f, c)
            if f_lt(f.baseLow, e.weekLow, c.mintick)
                e.weekLow := f.baseLow
                e.weekLowOrigin := f.baseOpenTime
                e.weekLowRootId := f_replaceTimeRoot(e, e.weekLowRootId, SUB_TIME_LOW, f.baseLow, f.baseOpenTime, TL_CUR_WEEK, f, c)
    true

// ============================================================================
// Candidate evaluation — FULL lightweight hot path
//
// The previous implementation built Candidate objects and Root-ID arrays for
// every partial window. On long 5m histories that made EMA-driven topology
// rebuilds allocation-heavy. This version keeps the exact three-stage search
// order, but scores partial windows with primitive counters only. Root-ID arrays,
// Candidate UDTs and ReferencePrice are materialized only for selected winners.
// ============================================================================
f_rootEligibleSide(Root r, int side) =>
    bool ok = r.alive and r.state != ROOT_RETIRED
    if ok and r.category == CAT_FVG
        ok := f_isFvgLive(r) and ((side == SIDE_SUPPORT and r.direction == FVG_BULLISH) or (side == SIDE_RESISTANCE and r.direction == FVG_BEARISH))
    ok

f_categoryEnabled(int cat, ZoneCfg c) => cat == CAT_MA ? c.enableMA : cat == CAT_SWING ? c.enableSwing : cat == CAT_ACCUM ? c.enableAccum : cat == CAT_TIME_HL ? c.enableTimeHL : cat == CAT_FVG ? c.enableFVG : cat == CAT_PSYCH ? c.enablePsych : false

f_masksIntersect6(int a, int b) =>
    bool yes = f_hasBit(a, 1) and f_hasBit(b, 1)
    yes := yes or (f_hasBit(a, 2) and f_hasBit(b, 2))
    yes := yes or (f_hasBit(a, 4) and f_hasBit(b, 4))
    yes := yes or (f_hasBit(a, 8) and f_hasBit(b, 8))
    yes := yes or (f_hasBit(a, 16) and f_hasBit(b, 16))
    yes := yes or (f_hasBit(a, 32) and f_hasBit(b, 32))
    yes

// Winner-only point quality aggregation. No temporary category arrays.
f_pointMasks(ZoneEngine e, array<int> ids, int side, float denseWidth, ZoneCfg c) =>
    int catMask = 0
    int highMask = 0
    int minId = 2147483647
    int created = 0
    bool hasNonPsych = false
    int maN = 0
    float ma1 = na
    float ma2 = na
    int maSlope1 = 0
    int maSlope2 = 0
    int accumTfMask = 0
    int accumPair1 = na
    bool accumMultiPair = false
    int timeOrigin1 = na
    bool timeMultiOrigin = false
    int n = array.size(ids)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(ids, i))
            if not na(r) and r.category != CAT_FVG
                catMask := f_maskAdd(catMask, f_catBit(r.category))
                minId := math.min(minId, r.rootId)
                created := math.max(created, r.confirmedTime)
                if r.category != CAT_PSYCH
                    hasNonPsych := true
                if r.category == CAT_MA
                    maN += 1
                    if maN == 1
                        ma1 := r.pointPrice
                        maSlope1 := r.slopeSign
                    else if maN == 2
                        ma2 := r.pointPrice
                        maSlope2 := r.slopeSign
                else if r.category == CAT_SWING
                    bool hiSwing = r.tfCode == TF_1H or (f_hasBit(r.tfMask, MASK_5M) and f_hasBit(r.tfMask, MASK_15M))
                    if hiSwing
                        highMask := f_maskAdd(highMask, f_catBit(CAT_SWING))
                else if r.category == CAT_ACCUM
                    if r.tfCode == TF_4H or r.tfCode == TF_1D
                        highMask := f_maskAdd(highMask, f_catBit(CAT_ACCUM))
                    int tfBit = r.tfCode == TF_1H ? 1 : r.tfCode == TF_4H ? 2 : r.tfCode == TF_1D ? 4 : 0
                    accumTfMask := f_maskAdd(accumTfMask, tfBit)
                    if na(accumPair1)
                        accumPair1 := r.pairKey
                    else if r.pairKey != accumPair1
                        accumMultiPair := true
                else if r.category == CAT_TIME_HL
                    if f_hasBit(r.labelMask, TL_CUR_WEEK) or f_hasBit(r.labelMask, TL_PREV_WEEK) or f_hasBit(r.labelMask, TL_PREV_DAY)
                        highMask := f_maskAdd(highMask, f_catBit(CAT_TIME_HL))
                    if na(timeOrigin1)
                        timeOrigin1 := r.originKey
                    else if r.originKey != timeOrigin1
                        timeMultiOrigin := true
        if maN >= 2 and not na(ma1) and not na(ma2) and f_widthLe(math.min(ma1, ma2), math.max(ma1, ma2), denseWidth, c.mintick)
            bool slopeOk = side == SIDE_SUPPORT ? (maSlope1 > 0 and maSlope2 > 0) : (maSlope1 < 0 and maSlope2 < 0)
            if slopeOk
                highMask := f_maskAdd(highMask, f_catBit(CAT_MA))
        if f_pop6(accumTfMask) >= 2 and accumMultiPair
            highMask := f_maskAdd(highMask, f_catBit(CAT_ACCUM))
        if timeMultiOrigin
            highMask := f_maskAdd(highMask, f_catBit(CAT_TIME_HL))
    [catMask, highMask, hasNonPsych, minId == 2147483647 ? na : minId, created]

// Winner-only FVG attachment. pointIds is owned by the candidate being built and
// may be extended in place because it is never reused after selection.
f_attachFvgs(ZoneEngine e, array<int> pointIds, array<int> fvgIds, int side, float pBottom, float pTop, float attachWidth, ZoneCfg c) =>
    array<int> ids = pointIds
    float bottom = pBottom
    float top = pTop
    bool broadLocalized = false
    float denseWidth = c.clusterMaxWidth * c.denseRatio
    [preMask, preHigh, preNonPsych, preMin, preCreated] = f_pointMasks(e, pointIds, side, denseWidth, c)
    int preC = f_pop6(f_maskRemove(preMask, f_catBit(CAT_FVG)))
    int n = array.size(fvgIds)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(fvgIds, i))
            if not na(r)
                bool inDirty = na(e.dirtyBottom) or f_intersects(r.nativeBottom, r.nativeTop, e.dirtyBottom, e.dirtyTop, c.mintick)
                if inDirty
                    bool anyPointInside = false
                    int insideCatMask = 0
                    int insideHighMask = 0
                    float insideBottom = na
                    float insideTop = na
                    int pn = array.size(pointIds)
                    if pn > 0
                        for k = 0 to pn - 1
                            Root pr = f_getRoot(e, array.get(pointIds, k))
                            if not na(pr) and f_ge(pr.pointPrice, r.nativeBottom, c.mintick) and f_le(pr.pointPrice, r.nativeTop, c.mintick)
                                anyPointInside := true
                                insideCatMask := f_maskAdd(insideCatMask, f_catBit(pr.category))
                                if f_hasBit(preHigh, f_catBit(pr.category))
                                    insideHighMask := f_maskAdd(insideHighMask, f_catBit(pr.category))
                                insideBottom := na(insideBottom) ? pr.pointPrice : math.min(insideBottom, pr.pointPrice)
                                insideTop := na(insideTop) ? pr.pointPrice : math.max(insideTop, pr.pointPrice)
                    float proximal = side == SIDE_SUPPORT ? r.nativeTop : r.nativeBottom
                    bool proximalWithinAttach = false
                    bool proximalDense = false
                    float newBottom = bottom
                    float newTop = top
                    if not na(bottom) and not na(top)
                        if side == SIDE_SUPPORT and f_ge(bottom, proximal, c.mintick)
                            newBottom := proximal
                            newTop := top
                            proximalWithinAttach := f_widthLe(newBottom, newTop, attachWidth, c.mintick)
                            proximalDense := f_widthLe(newBottom, newTop, denseWidth, c.mintick)
                        else if side == SIDE_RESISTANCE and f_le(top, proximal, c.mintick)
                            newBottom := bottom
                            newTop := proximal
                            proximalWithinAttach := f_widthLe(newBottom, newTop, attachWidth, c.mintick)
                            proximalDense := f_widthLe(newBottom, newTop, denseWidth, c.mintick)
                    bool attach = false
                    bool loc = false
                    if not r.isBroadFvg
                        attach := anyPointInside or proximalWithinAttach
                        loc := attach
                    else
                        bool internalHighOther = f_pop6(insideHighMask) >= 1
                        bool internalTwoCats = f_pop6(insideCatMask) >= 2 and not na(insideBottom) and f_widthLe(insideBottom, insideTop, denseWidth, c.mintick)
                        proximalDense := proximalDense and preC >= 1
                        attach := internalHighOther or internalTwoCats or proximalDense
                        loc := attach
                    if attach
                        array.push(ids, r.rootId)
                        if proximalWithinAttach and not anyPointInside
                            bottom := newBottom
                            top := newTop
                        broadLocalized := broadLocalized or (r.isBroadFvg and loc)
    [ids, bottom, top, broadLocalized, preMask, preHigh, preNonPsych, preMin, preCreated]

f_medianScratch(array<float> vals) =>
    float out = na
    int n = array.size(vals)
    if n > 0
        array.sort(vals, order.ascending)
        int mid = int(math.floor(n * 0.5))
        out := n % 2 == 1 ? array.get(vals, mid) : (array.get(vals, mid - 1) + array.get(vals, mid)) * 0.5
    out

// ReferencePrice is computed only for a selected candidate. All temporary float
// arrays are Engine-owned buffers and are cleared/reused between winners.
f_referencePrice(ZoneEngine e, array<int> ids, int side, float bottom, float top) =>
    array.clear(e.refReps)
    array.clear(e.refMa)
    array.clear(e.refNonMa)
    for cat = CAT_MA to CAT_PSYCH
        if cat != CAT_FVG
            array.clear(e.refVals)
            int n = array.size(ids)
            if n > 0
                for i = 0 to n - 1
                    Root r = f_getRoot(e, array.get(ids, i))
                    if not na(r) and r.category == cat and not r.isRangeRoot
                        array.push(e.refVals, r.pointPrice)
                        if cat == CAT_MA
                            array.push(e.refMa, r.pointPrice)
                        else
                            array.push(e.refNonMa, r.pointPrice)
            if array.size(e.refVals) > 0 and cat != CAT_MA
                array.push(e.refReps, f_medianScratch(e.refVals))
    if array.size(e.refMa) > 0
        float maRep = na
        if array.size(e.refNonMa) > 0
            float target = f_medianScratch(e.refNonMa)
            float bestD = 1e20
            int mn = array.size(e.refMa)
            for i = 0 to mn - 1
                float v = array.get(e.refMa, i)
                float d = math.abs(v - target)
                if d < bestD
                    bestD := d
                    maRep := v
        else
            maRep := f_medianScratch(e.refMa)
        array.push(e.refReps, maRep)
    float out = na
    if array.size(e.refReps) > 0
        out := f_medianScratch(e.refReps)
    else
        out := side == SIDE_SUPPORT ? top : bottom
    out

f_evalCandidatePrepared(ZoneEngine e, array<int> ids, int side, float bottom, float top,
                        bool broadContext, bool broadLocalized,
                        int pointCatMask, int pointHighMask, bool pointHasNonPsych,
                        int pointMinId, int pointCreated, ZoneCfg c) =>
    Candidate out = na
    if array.size(ids) > 0
        float denseWidth = c.clusterMaxWidth * c.denseRatio
        int catMask = pointCatMask
        int highMask = pointHighMask
        bool hasNonPsych = pointHasNonPsych
        int minId = na(pointMinId) ? 2147483647 : pointMinId
        int created = pointCreated
        int fvgDirMask = 0
        int fvgCount = 0
        int fvgFreshCount = 0
        int fvgStateMask = 0
        int fvgTfMask = 0
        int n = array.size(ids)
        if n > 0
            for i = 0 to n - 1
                Root r = f_getRoot(e, array.get(ids, i))
                if not na(r) and r.category == CAT_FVG and f_rootEligibleSide(r, side)
                    catMask := f_maskAdd(catMask, f_catBit(CAT_FVG))
                    hasNonPsych := true
                    minId := math.min(minId, r.rootId)
                    created := math.max(created, r.confirmedTime)
                    fvgCount += 1
                    if r.fvgFresh
                        fvgFreshCount += 1
                    fvgDirMask := f_maskAdd(fvgDirMask, r.direction == FVG_BULLISH ? 1 : 2)
                    fvgStateMask := f_maskAdd(fvgStateMask, f_bit(math.min(r.state, 20)))
                    fvgTfMask := f_maskAdd(fvgTfMask, r.tfCode == TF_1H ? 1 : r.tfCode == TF_4H ? 2 : r.tfCode == TF_1D ? 4 : 0)
                    if (not r.isBroadFvg and (r.tfCode == TF_4H or r.tfCode == TF_1D)) or (r.isBroadFvg and broadLocalized)
                        highMask := f_maskAdd(highMask, f_catBit(CAT_FVG))
        if f_pop6(fvgTfMask) >= 2 and fvgCount >= 2
            highMask := f_maskAdd(highMask, f_catBit(CAT_FVG))
        int den = broadContext ? DEN_BROAD_CONTEXT : f_widthLe(bottom, top, denseWidth, c.mintick) ? DEN_HIGH : DEN_NORMAL
        int cc = f_pop6(catMask)
        int hh = f_pop6(highMask)
        bool baseStrong = not broadContext and den == DEN_HIGH and ((cc == 2 and hh >= 1) or cc >= 3)
        if hasNonPsych
            out := Candidate.new(side = side, rootIds = ids, bottom = bottom, top = top,
                referencePrice = na, cCount = cc, hCount = hh, density = den, baseStrong = baseStrong,
                broadContext = broadContext, broadLocalized = broadLocalized, categoryMask = catMask,
                highMask = highMask, fvgDirectionMask = fvgDirMask, fvgRootCount = fvgCount,
                fvgFreshCount = fvgFreshCount, fvgStructuralStateMask = fvgStateMask,
                createdTime = created, minRootId = minId == 2147483647 ? na : minId)
    out

f_finalizeCandidateReference(ZoneEngine e, Candidate cnd) =>
    if not na(cnd) and na(cnd.referencePrice)
        cnd.referencePrice := f_referencePrice(e, cnd.rootIds, cnd.side, cnd.bottom, cnd.top)
        e.referenceCalcCount += 1
    cnd

f_scoreBetter(int cc, int hh, float bottom, float top, int created, int minId,
              int bestC, int bestH, float bestBottom, float bestTop, int bestCreated, int bestMinId, bool bestValid) =>
    bool better = not bestValid
    if bestValid
        if cc != bestC
            better := cc > bestC
        else if hh != bestH
            better := hh > bestH
        else if (top - bottom) != (bestTop - bestBottom)
            better := (top - bottom) < (bestTop - bestBottom)
        else if created != bestCreated
            better := created < bestCreated
        else
            better := minId < bestMinId
    better

f_nextWorkStamp(ZoneEngine e) =>
    e.workStampSeq += 1
    e.workStampSeq

f_candidateUsesStamp(ZoneEngine e, Candidate cnd, int stamp) =>
    bool yes = false
    int n = array.size(cnd.rootIds)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(cnd.rootIds, i))
            if not na(r) and not (r.category == CAT_FVG and r.isBroadFvg) and r.workStamp == stamp
                yes := true
                break
    yes

f_markCandidateUsedStamp(ZoneEngine e, Candidate cnd, int stamp) =>
    int n = array.size(cnd.rootIds)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(cnd.rootIds, i))
            if not na(r) and not (r.category == CAT_FVG and r.isBroadFvg)
                r.workStamp := stamp
    true

f_cacheEnsure(ZoneEngine e, int n) =>
    while array.size(e.cacheEnd) < n
        array.push(e.cacheEnd, -1)
        array.push(e.cacheC, 0)
        array.push(e.cacheH, 0)
        array.push(e.cacheCreated, 0)
        array.push(e.cacheMinId, 2147483647)
        array.push(e.cacheBottom, na)
        array.push(e.cacheTop, na)
    true

f_cacheInvalidate(ZoneEngine e, int i) =>
    array.set(e.cacheEnd, i, -1)
    array.set(e.cacheC, i, 0)
    array.set(e.cacheH, i, 0)
    array.set(e.cacheCreated, i, 0)
    array.set(e.cacheMinId, i, 2147483647)
    array.set(e.cacheBottom, i, na)
    array.set(e.cacheTop, i, na)
    true

f_fvgScratchEnsure(ZoneEngine e, int n) =>
    while array.size(e.fvgInsideMask) < n
        array.push(e.fvgInsideMask, 0)
        array.push(e.fvgInsideBottom, na)
        array.push(e.fvgInsideTop, na)
    true

// Collect live local slots once per Side rebuild. Point order is inherited from
// the global stable price index, so no per-bar sort is performed.
f_collectPointSlots(ZoneEngine e, int side, float lo, float hi, ZoneCfg c) =>
    array.clear(e.workPointSlots)
    int i = f_pointIndexLowerBound(e, lo)
    int n = array.size(e.pointPriceIndex)
    bool done = false
    while i < n and not done
        int slot = array.get(e.pointPriceIndex, i)
        Root r = array.get(e.roots, slot)
        if not r.alive
            i += 1
        else if r.pointPrice > hi
            done := true
        else
            if r.category != CAT_PSYCH and f_categoryEnabled(r.category, c) and f_rootEligibleSide(r, side)
                array.push(e.workPointSlots, slot)
            i += 1
    true

f_collectPsychSlots(ZoneEngine e, int side, float lo, float hi, ZoneCfg c) =>
    array.clear(e.workPsychSlots)
    if c.enablePsych
        int i = f_pointIndexLowerBound(e, lo)
        int n = array.size(e.pointPriceIndex)
        bool done = false
        while i < n and not done
            int slot = array.get(e.pointPriceIndex, i)
            Root r = array.get(e.roots, slot)
            if not r.alive
                i += 1
            else if r.pointPrice > hi
                done := true
            else
                if r.category == CAT_PSYCH and f_rootEligibleSide(r, side)
                    array.push(e.workPsychSlots, slot)
                i += 1
    true

f_collectFvgSlots(ZoneEngine e, int side, float lo, float hi, ZoneCfg c) =>
    array.clear(e.workFvgSlots)
    if c.enableFVG
        float padLo = lo - c.clusterMaxWidth
        float padHi = hi + c.clusterMaxWidth
        int n = array.size(e.fvgSlots)
        if n > 0
            for k = 0 to n - 1
                int slot = array.get(e.fvgSlots, k)
                Root r = array.get(e.roots, slot)
                if r.alive and f_rootEligibleSide(r, side) and f_intersects(r.nativeBottom, r.nativeTop, padLo, padHi, c.mintick)
                    array.push(e.workFvgSlots, slot)
    true

// Scores all windows reachable from one start using only primitive state. The
// best descriptor is written into reusable parallel arrays at startIdx.
f_scoreStartCache(ZoneEngine e, int startIdx, int side, float widthLimit, bool requireStrong, int stamp, ZoneCfg c) =>
    f_cacheInvalidate(e, startIdx)
    int pn = array.size(e.workPointSlots)
    if startIdx >= 0 and startIdx < pn
        int startSlot = array.get(e.workPointSlots, startIdx)
        Root ri = array.get(e.roots, startSlot)
        if ri.alive and ri.workStamp != stamp
            array.clear(e.workPairs)
            // A start can only reach an FVG whose NativeRange/proximal geometry
            // intersects startPrice +/- widthLimit. Build that exact subset once
            // for this start, then reuse it for every end window.
            array.clear(e.workStartFvgSlots)
            float reachLo = ri.pointPrice - widthLimit
            float reachHi = ri.pointPrice + widthLimit
            int allFn = array.size(e.workFvgSlots)
            if allFn > 0
                for fi = 0 to allFn - 1
                    int fs = array.get(e.workFvgSlots, fi)
                    Root frReach = array.get(e.roots, fs)
                    if frReach.alive and f_intersects(frReach.nativeBottom, frReach.nativeTop, reachLo, reachHi, c.mintick)
                        array.push(e.workStartFvgSlots, fs)
            int fn = array.size(e.workStartFvgSlots)
            f_fvgScratchEnsure(e, fn)
            if fn > 0
                for fi = 0 to fn - 1
                    array.set(e.fvgInsideMask, fi, 0)
                    array.set(e.fvgInsideBottom, fi, na)
                    array.set(e.fvgInsideTop, fi, na)

            float bottom = ri.pointPrice
            float top = ri.pointPrice
            int catMask = 0
            int highMask = 0
            int minId = 2147483647
            int created = 0
            int maN = 0
            float ma1 = na
            float ma2 = na
            int maSlope1 = 0
            int maSlope2 = 0
            int accumTfMask = 0
            int timeOrigin1 = na
            bool timeMultiOrigin = false

            bool bestValid = false
            int bestEnd = -1
            int bestC = 0
            int bestH = 0
            int bestCreated = 0
            int bestMinId = 2147483647
            float bestBottom = na
            float bestTop = na

            int j = startIdx
            bool stopStart = false
            while j < pn and not stopStart
                int slotJ = array.get(e.workPointSlots, j)
                Root rj = array.get(e.roots, slotJ)
                if not rj.alive or f_widthGt(bottom, rj.pointPrice, widthLimit, c.mintick)
                    stopStart := true
                else
                    if rj.workStamp != stamp
                        bool pairConflict = rj.category == CAT_ACCUM and rj.pairKey != 0 and f_arrayHasInt(e.workPairs, rj.pairKey)
                        if pairConflict
                            stopStart := true
                        else
                            if rj.category == CAT_ACCUM and rj.pairKey != 0
                                array.push(e.workPairs, rj.pairKey)
                            top := math.max(top, rj.pointPrice)
                            catMask := f_maskAdd(catMask, f_catBit(rj.category))
                            minId := math.min(minId, rj.rootId)
                            created := math.max(created, rj.confirmedTime)
                            if rj.category == CAT_MA
                                maN += 1
                                if maN == 1
                                    ma1 := rj.pointPrice
                                    maSlope1 := rj.slopeSign
                                else if maN == 2
                                    ma2 := rj.pointPrice
                                    maSlope2 := rj.slopeSign
                            else if rj.category == CAT_SWING
                                bool hiSwing = rj.tfCode == TF_1H or (f_hasBit(rj.tfMask, MASK_5M) and f_hasBit(rj.tfMask, MASK_15M))
                                if hiSwing
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_SWING))
                            else if rj.category == CAT_ACCUM
                                if rj.tfCode == TF_4H or rj.tfCode == TF_1D
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_ACCUM))
                                int tfBit = rj.tfCode == TF_1H ? 1 : rj.tfCode == TF_4H ? 2 : rj.tfCode == TF_1D ? 4 : 0
                                accumTfMask := f_maskAdd(accumTfMask, tfBit)
                                if f_pop6(accumTfMask) >= 2 and array.size(e.workPairs) >= 2
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_ACCUM))
                            else if rj.category == CAT_TIME_HL
                                if f_hasBit(rj.labelMask, TL_CUR_WEEK) or f_hasBit(rj.labelMask, TL_PREV_WEEK) or f_hasBit(rj.labelMask, TL_PREV_DAY)
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_TIME_HL))
                                if na(timeOrigin1)
                                    timeOrigin1 := rj.originKey
                                else if rj.originKey != timeOrigin1
                                    timeMultiOrigin := true
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_TIME_HL))
                            if maN >= 2 and not na(ma1) and not na(ma2) and f_widthLe(math.min(ma1, ma2), math.max(ma1, ma2), c.clusterMaxWidth * c.denseRatio, c.mintick)
                                bool maSlopeOk = side == SIDE_SUPPORT ? (maSlope1 > 0 and maSlope2 > 0) : (maSlope1 < 0 and maSlope2 < 0)
                                if maSlopeOk
                                    highMask := f_maskAdd(highMask, f_catBit(CAT_MA))

                            // Increment FVG-inside summaries only when a point Root
                            // actually enters the current unused window.
                            if fn > 0
                                for fi = 0 to fn - 1
                                    Root frInside = array.get(e.roots, array.get(e.workStartFvgSlots, fi))
                                    if f_ge(rj.pointPrice, frInside.nativeBottom, c.mintick) and f_le(rj.pointPrice, frInside.nativeTop, c.mintick)
                                        int im = array.get(e.fvgInsideMask, fi)
                                        im := f_maskAdd(im, f_catBit(rj.category))
                                        array.set(e.fvgInsideMask, fi, im)
                                        float ib = array.get(e.fvgInsideBottom, fi)
                                        float it = array.get(e.fvgInsideTop, fi)
                                        array.set(e.fvgInsideBottom, fi, na(ib) ? rj.pointPrice : math.min(ib, rj.pointPrice))
                                        array.set(e.fvgInsideTop, fi, na(it) ? rj.pointPrice : math.max(it, rj.pointPrice))

                            // Psych roots are tested independently against the
                            // original non-psych point window, matching the prior
                            // implementation exactly.
                            int pCatMask = catMask
                            int pHighMask = highMask
                            int pMinId = minId
                            int pCreated = created
                            float pBottom = bottom
                            float pTop = top
                            bool usedConflict = false
                            int psn = array.size(e.workPsychSlots)
                            if psn > 0
                                for pi = 0 to psn - 1
                                    int pslot = array.get(e.workPsychSlots, pi)
                                    Root pr = array.get(e.roots, pslot)
                                    float nbp = math.min(bottom, pr.pointPrice)
                                    float ntp = math.max(top, pr.pointPrice)
                                    if f_widthLe(nbp, ntp, widthLimit, c.mintick)
                                        pCatMask := f_maskAdd(pCatMask, f_catBit(CAT_PSYCH))
                                        pMinId := math.min(pMinId, pr.rootId)
                                        pCreated := math.max(pCreated, pr.confirmedTime)
                                        pBottom := math.min(pBottom, pr.pointPrice)
                                        pTop := math.max(pTop, pr.pointPrice)
                                        usedConflict := usedConflict or pr.workStamp == stamp

                            float finalBottom = pBottom
                            float finalTop = pTop
                            int finalCatMask = pCatMask
                            int finalHighMask = pHighMask
                            int finalMinId = pMinId
                            int finalCreated = pCreated
                            int fvgTfMask = 0
                            int fvgCount = 0
                            bool broadLocalized = false
                            int preC = f_pop6(f_maskRemove(pCatMask, f_catBit(CAT_FVG)))

                            if fn > 0
                                for fi = 0 to fn - 1
                                    int fslot = array.get(e.workStartFvgSlots, fi)
                                    Root fr = array.get(e.roots, fslot)
                                    bool inDirty = na(e.dirtyBottom) or f_intersects(fr.nativeBottom, fr.nativeTop, e.dirtyBottom, e.dirtyTop, c.mintick)
                                    if inDirty
                                        int insideCatMask = array.get(e.fvgInsideMask, fi)
                                        float insideBottom = array.get(e.fvgInsideBottom, fi)
                                        float insideTop = array.get(e.fvgInsideTop, fi)
                                        bool anyPointInside = insideCatMask != 0

                                        if psn > 0
                                            for pi = 0 to psn - 1
                                                int pslot = array.get(e.workPsychSlots, pi)
                                                Root pr = array.get(e.roots, pslot)
                                                float nbp = math.min(bottom, pr.pointPrice)
                                                float ntp = math.max(top, pr.pointPrice)
                                                bool psychAttached = f_widthLe(nbp, ntp, widthLimit, c.mintick)
                                                if psychAttached and f_ge(pr.pointPrice, fr.nativeBottom, c.mintick) and f_le(pr.pointPrice, fr.nativeTop, c.mintick)
                                                    anyPointInside := true
                                                    insideCatMask := f_maskAdd(insideCatMask, f_catBit(CAT_PSYCH))
                                                    insideBottom := na(insideBottom) ? pr.pointPrice : math.min(insideBottom, pr.pointPrice)
                                                    insideTop := na(insideTop) ? pr.pointPrice : math.max(insideTop, pr.pointPrice)

                                        float proximal = side == SIDE_SUPPORT ? fr.nativeTop : fr.nativeBottom
                                        bool proximalWithinAttach = false
                                        bool proximalDense = false
                                        float newBottom = finalBottom
                                        float newTop = finalTop
                                        if not na(finalBottom) and not na(finalTop)
                                            if side == SIDE_SUPPORT and f_ge(finalBottom, proximal, c.mintick)
                                                newBottom := proximal
                                                newTop := finalTop
                                                proximalWithinAttach := f_widthLe(newBottom, newTop, widthLimit, c.mintick)
                                                proximalDense := f_widthLe(newBottom, newTop, c.clusterMaxWidth * c.denseRatio, c.mintick)
                                            else if side == SIDE_RESISTANCE and f_le(finalTop, proximal, c.mintick)
                                                newBottom := finalBottom
                                                newTop := proximal
                                                proximalWithinAttach := f_widthLe(newBottom, newTop, widthLimit, c.mintick)
                                                proximalDense := f_widthLe(newBottom, newTop, c.clusterMaxWidth * c.denseRatio, c.mintick)
                                        bool attach = false
                                        bool loc = false
                                        if not fr.isBroadFvg
                                            attach := anyPointInside or proximalWithinAttach
                                            loc := attach
                                        else
                                            bool internalHighOther = f_masksIntersect6(insideCatMask, pHighMask)
                                            bool internalTwoCats = f_pop6(insideCatMask) >= 2 and not na(insideBottom) and f_widthLe(insideBottom, insideTop, c.clusterMaxWidth * c.denseRatio, c.mintick)
                                            proximalDense := proximalDense and preC >= 1
                                            attach := internalHighOther or internalTwoCats or proximalDense
                                            loc := attach
                                        if attach
                                            finalCatMask := f_maskAdd(finalCatMask, f_catBit(CAT_FVG))
                                            finalMinId := math.min(finalMinId, fr.rootId)
                                            finalCreated := math.max(finalCreated, fr.confirmedTime)
                                            fvgCount += 1
                                            int tfBitF = fr.tfCode == TF_1H ? 1 : fr.tfCode == TF_4H ? 2 : fr.tfCode == TF_1D ? 4 : 0
                                            fvgTfMask := f_maskAdd(fvgTfMask, tfBitF)
                                            broadLocalized := broadLocalized or (fr.isBroadFvg and loc)
                                            if (not fr.isBroadFvg and (fr.tfCode == TF_4H or fr.tfCode == TF_1D)) or (fr.isBroadFvg and loc)
                                                finalHighMask := f_maskAdd(finalHighMask, f_catBit(CAT_FVG))
                                            if proximalWithinAttach and not anyPointInside
                                                finalBottom := newBottom
                                                finalTop := newTop
                                            if not fr.isBroadFvg and fr.workStamp == stamp
                                                usedConflict := true
                            if f_pop6(fvgTfMask) >= 2 and fvgCount >= 2
                                finalHighMask := f_maskAdd(finalHighMask, f_catBit(CAT_FVG))

                            if c.countersOn
                                e.candidateWindowEvalCount += 1
                            int cc = f_pop6(finalCatMask)
                            int hh = f_pop6(finalHighMask)
                            int den = f_widthLe(finalBottom, finalTop, c.clusterMaxWidth * c.denseRatio, c.mintick) ? DEN_HIGH : DEN_NORMAL
                            bool strong = den == DEN_HIGH and ((cc == 2 and hh >= 1) or cc >= 3)
                            bool valid = not usedConflict and (not requireStrong or strong)
                            if valid and f_scoreBetter(cc, hh, finalBottom, finalTop, finalCreated, finalMinId,
                                bestC, bestH, bestBottom, bestTop, bestCreated, bestMinId, bestValid)
                                bestValid := true
                                bestEnd := j
                                bestC := cc
                                bestH := hh
                                bestBottom := finalBottom
                                bestTop := finalTop
                                bestCreated := finalCreated
                                bestMinId := finalMinId
                    j += 1

            if bestValid
                array.set(e.cacheEnd, startIdx, bestEnd)
                array.set(e.cacheC, startIdx, bestC)
                array.set(e.cacheH, startIdx, bestH)
                array.set(e.cacheCreated, startIdx, bestCreated)
                array.set(e.cacheMinId, startIdx, bestMinId)
                array.set(e.cacheBottom, startIdx, bestBottom)
                array.set(e.cacheTop, startIdx, bestTop)
    true

f_cacheBestIndex(ZoneEngine e, int n) =>
    int bestIdx = na
    if n > 0
        for i = 0 to n - 1
            int en = array.get(e.cacheEnd, i)
            if en >= 0
                bool better = na(bestIdx)
                if not better
                    int bc = array.get(e.cacheC, bestIdx)
                    int bh = array.get(e.cacheH, bestIdx)
                    float bb = array.get(e.cacheBottom, bestIdx)
                    float bt = array.get(e.cacheTop, bestIdx)
                    int bcr = array.get(e.cacheCreated, bestIdx)
                    int bmi = array.get(e.cacheMinId, bestIdx)
                    better := f_scoreBetter(array.get(e.cacheC, i), array.get(e.cacheH, i),
                        array.get(e.cacheBottom, i), array.get(e.cacheTop, i), array.get(e.cacheCreated, i),
                        array.get(e.cacheMinId, i), bc, bh, bb, bt, bcr, bmi, true)
                if better
                    bestIdx := i
    bestIdx

f_materializePointCandidate(ZoneEngine e, int startIdx, int endIdx, int side, float widthLimit, int stamp, ZoneCfg c) =>
    Candidate out = na
    array<int> ids = array.new<int>()
    float bottom = na
    float top = na
    int pn = array.size(e.workPointSlots)
    if startIdx >= 0 and endIdx >= startIdx and endIdx < pn
        for k = startIdx to endIdx
            Root r = array.get(e.roots, array.get(e.workPointSlots, k))
            if r.alive and r.workStamp != stamp
                array.push(ids, r.rootId)
                bottom := na(bottom) ? r.pointPrice : math.min(bottom, r.pointPrice)
                top := na(top) ? r.pointPrice : math.max(top, r.pointPrice)
    if array.size(ids) > 0
        float baseBottom = bottom
        float baseTop = top
        int psn = array.size(e.workPsychSlots)
        if psn > 0
            for pi = 0 to psn - 1
                Root pr = array.get(e.roots, array.get(e.workPsychSlots, pi))
                float nb = math.min(baseBottom, pr.pointPrice)
                float nt = math.max(baseTop, pr.pointPrice)
                if f_widthLe(nb, nt, widthLimit, c.mintick)
                    array.push(ids, pr.rootId)
                    bottom := math.min(bottom, pr.pointPrice)
                    top := math.max(top, pr.pointPrice)
        array.clear(e.workTempIds)
        int fn = array.size(e.workFvgSlots)
        if fn > 0
            for fi = 0 to fn - 1
                Root fr = array.get(e.roots, array.get(e.workFvgSlots, fi))
                array.push(e.workTempIds, fr.rootId)
        [allIds, cb, ct, broadLoc, pointMask, pointHigh, pointNonPsych, pointMin, pointCreated] = f_attachFvgs(e, ids, e.workTempIds, side, bottom, top, widthLimit, c)
        out := f_evalCandidatePrepared(e, allIds, side, cb, ct, false, broadLoc,
            pointMask, pointHigh, pointNonPsych, pointMin, pointCreated, c)
    out

f_startDependsOnSelected(ZoneEngine e, int startIdx, Candidate selected, int stamp, float widthLimit, ZoneCfg c) =>
    bool affected = false
    int pn = array.size(e.workPointSlots)
    if startIdx >= 0 and startIdx < pn
        Root sr = array.get(e.roots, array.get(e.workPointSlots, startIdx))
        float sp = sr.pointPrice
        int rn = array.size(selected.rootIds)
        if rn > 0
            for rix = 0 to rn - 1
                Root r = f_getRoot(e, array.get(selected.rootIds, rix))
                if not na(r) and r.workStamp == stamp
                    if r.category == CAT_FVG
                        float lo = sp - widthLimit
                        float hi = sp + widthLimit
                        affected := f_intersects(r.nativeBottom, r.nativeTop, lo, hi, c.mintick)
                    else if r.category == CAT_PSYCH
                        affected := math.abs(r.pointPrice - sp) <= widthLimit
                    else
                        affected := f_ge(r.pointPrice, sp, c.mintick) and f_widthLe(sp, r.pointPrice, widthLimit, c.mintick)
                if affected
                    break
    affected

f_selectPointCandidatesLight(ZoneEngine e, int side, float widthLimit, bool requireStrong,
                             int stamp, array<Candidate> selected, ZoneCfg c) =>
    int n = array.size(e.workPointSlots)
    f_cacheEnsure(e, n)
    if n > 0
        for i = 0 to n - 1
            f_scoreStartCache(e, i, side, widthLimit, requireStrong, stamp, c)
        bool keepGoing = true
        while keepGoing
            int bestIdx = f_cacheBestIndex(e, n)
            if na(bestIdx)
                keepGoing := false
            else
                int bestEnd = array.get(e.cacheEnd, bestIdx)
                Candidate best = f_materializePointCandidate(e, bestIdx, bestEnd, side, widthLimit, stamp, c)
                bool valid = not na(best) and (not requireStrong or best.baseStrong) and not f_candidateUsesStamp(e, best, stamp)
                if not valid
                    // Exact fallback: invalidate only this cached descriptor and let
                    // the remaining exact cache entries compete. This path should be
                    // rare and never converts an uncertain candidate into an empty result.
                    f_cacheInvalidate(e, bestIdx)
                else
                    f_finalizeCandidateReference(e, best)
                    array.push(selected, best)
                    f_markCandidateUsedStamp(e, best, stamp)
                    for i = 0 to n - 1
                        if f_startDependsOnSelected(e, i, best, stamp, widthLimit, c)
                            f_scoreStartCache(e, i, side, widthLimit, requireStrong, stamp, c)
    true

f_candidateContainsRoot(Candidate cnd, int id) => not na(cnd) and f_arrayHasInt(cnd.rootIds, id)

f_selectedContainsNonBroadRoot(ZoneEngine e, array<Candidate> selected, int rootId) =>
    bool found = false
    Root rr = f_getRoot(e, rootId)
    if not na(rr) and not (rr.category == CAT_FVG and rr.isBroadFvg)
        int n = array.size(selected)
        if n > 0
            for i = 0 to n - 1
                Candidate cnd = array.get(selected, i)
                if f_candidateContainsRoot(cnd, rootId)
                    found := true
                    break
    found

f_buildFvgCandidatesLight(ZoneEngine e, int side, array<Candidate> selected, int stamp, ZoneCfg c) =>
    int fN = array.size(e.workFvgSlots)
    if fN > 0
        for fi = 0 to fN - 1
            Root r = array.get(e.roots, array.get(e.workFvgSlots, fi))
            bool rUsed = not r.isBroadFvg and r.workStamp == stamp
            bool inDirty = na(e.dirtyBottom) or f_intersects(r.nativeBottom, r.nativeTop, e.dirtyBottom, e.dirtyTop, c.mintick)
            bool already = rUsed or f_selectedContainsNonBroadRoot(e, selected, r.rootId)
            if inDirty and (r.isBroadFvg or not already)
                array.clear(e.workTempIds)
                array.push(e.workTempIds, r.rootId)
                float ob = r.nativeBottom
                float ot = r.nativeTop
                if fi + 1 < fN
                    for fj = fi + 1 to fN - 1
                        Root q = array.get(e.roots, array.get(e.workFvgSlots, fj))
                        bool qAvailable = q.isBroadFvg or q.workStamp != stamp
                        if qAvailable and q.rootId != r.rootId and q.direction == r.direction
                            float nb = math.max(ob, q.nativeBottom)
                            float nt = math.min(ot, q.nativeTop)
                            if f_le(nb, nt, c.mintick)
                                f_arrayAddUnique(e.workTempIds, q.rootId)
                                ob := nb
                                ot := nt
                int fn = array.size(e.workTempIds)
                bool context = fn == 1 and r.isBroadFvg
                array<int> ownedIds = f_copyInts(e.workTempIds)
                Candidate fc = f_evalCandidatePrepared(e, ownedIds, side,
                    context ? r.nativeBottom : ob, context ? r.nativeTop : ot,
                    context, false, 0, 0, false, na, 0, c)
                if not na(fc)
                    f_finalizeCandidateReference(e, fc)
                    array.push(selected, fc)
                    // All selected normal Roots are single-use on the same Side.
                    // Broad FVG is the sole sharing exception in the specification.
                    f_markCandidateUsedStamp(e, fc, stamp)
    true

f_buildSideCandidates(ZoneEngine e, int side, ZoneFeed f, ZoneCfg c) =>
    var array<Candidate> selected = array.new<Candidate>()
    array.clear(selected)
    float lo = na(e.dirtyBottom) ? f.baseClose - c.dormantDistance : e.dirtyBottom
    float hi = na(e.dirtyTop) ? f.baseClose + c.dormantDistance : e.dirtyTop
    f_ensurePsychNearForBuild(e, lo, hi, f.baseSeq, f.baseCloseTime, c)

    f_collectPointSlots(e, side, lo, hi, c)
    f_collectPsychSlots(e, side, lo - c.clusterMaxWidth, hi + c.clusterMaxWidth, c)
    f_collectFvgSlots(e, side, lo, hi, c)
    int stamp = f_nextWorkStamp(e)
    float denseWidth = c.clusterMaxWidth * c.denseRatio

    // Stage A: exact Dense Base-Strong greedy selection using primitive caches.
    f_selectPointCandidatesLight(e, side, denseWidth, true, stamp, selected, c)

    // Stage B: FVG standalone/overlap/Broad context. Broad FVG may be shared.
    f_buildFvgCandidatesLight(e, side, selected, stamp, c)

    // Stage C: remaining normal point Roots. Stage-A work stamps stay active.
    f_selectPointCandidatesLight(e, side, c.clusterMaxWidth, false, stamp, selected, c)
    selected


// ============================================================================
// Core identity / allocation / merge-split support
// ============================================================================
// ============================================================================
// State-specific work sets (sections 8-13, 19).
//
// Membership is a flag on the Core, so adding and removing is decided without
// searching. f_syncCoreSets is idempotent and is called wherever a phase, a
// pending flag or liveness can have changed. A normal Base bar then iterates
// only the sets it needs and never liveCoreSlots.
// ============================================================================
f_setAddRemove(array<int> set, int slot, bool want, bool has) =>
    if want != has
        if want
            array.push(set, slot)
        else
            f_removeSlotValue(set, slot)
    true

f_syncCoreSets(ZoneEngine e, int slot, ZoneCfg c) =>
    if slot >= 0 and slot < array.size(e.cores)
        ZoneCore z = array.get(e.cores, slot)
        int sp = z.supportView.history.phase
        int rp = z.resistanceView.history.phase
        bool alive = z.alive

        bool wArmSup = alive and sp == PH_ARMED
        f_setAddRemove(e.armedSupportSlots, slot, wArmSup, z.inArmedSup)
        z.inArmedSup := wArmSup

        bool wArmRes = alive and rp == PH_ARMED
        f_setAddRemove(e.armedResistanceSlots, slot, wArmRes, z.inArmedRes)
        z.inArmedRes := wArmRes

        bool wActive = alive and (sp == PH_ACTIVE_TOUCH or rp == PH_ACTIVE_TOUCH)
        f_setAddRemove(e.activeTouchSlots, slot, wActive, z.inActiveSet)
        z.inActiveSet := wActive

        bool wBreak = alive and (sp == PH_BROKEN or rp == PH_BROKEN or sp == PH_FLIP_WAIT or rp == PH_FLIP_WAIT)
        f_setAddRemove(e.brokenFlipWaitSlots, slot, wBreak, z.inBreakSet)
        z.inBreakSet := wBreak

        bool wGen = alive and z.pendingGeneration
        f_setAddRemove(e.generationWatchSlots, slot, wGen, z.inGenSet)
        z.inGenSet := wGen

        bool wPend = alive and z.pendingTopology
        f_setAddRemove(e.pendingTopoSlots, slot, wPend, z.inPendingTopoSet)
        z.inPendingTopoSet := wPend

        // Dormant: parked behind a price corridor and not walked again until the
        // bar reaches it (section 19).
        bool quiet = alive and not wActive and not wBreak
        bool wDormant = quiet and not z.pendingTopology and not z.pendingGeneration and (sp == PH_DORMANT or rp == PH_DORMANT) and not wArmSup and not wArmRes
        if wDormant != z.inDormantSet
            f_setAddRemove(e.dormantSlots, slot, wDormant, z.inDormantSet)
            z.inDormantSet := wDormant
            if wDormant
                z.dormantWakeLow := na(z.physicalBottom) ? na : z.physicalBottom - c.dormantDistance
                z.dormantWakeHigh := na(z.physicalTop) ? na : z.physicalTop + c.dormantDistance
            // Membership changed, so the aggregate corridor must be rebuilt.
            e.dormantGuardValid := false

        // Everything else quiet still needs the cheap Arm / Dormant refresh.
        bool wWait = quiet and not wDormant
        f_setAddRemove(e.waitingSlots, slot, wWait, z.inWaitSet)
        z.inWaitSet := wWait
    true

// Snapshot a set before iterating it, because transitions mutate the set.
// Reuses one buffer; nothing is allocated after the first bar.
f_snapshotSet(ZoneEngine e, array<int> src) =>
    array.clear(e.workSetSnapshot)
    int n = array.size(src)
    if n > 0
        for i = 0 to n - 1
            array.push(e.workSetSnapshot, array.get(src, i))
    e.workSetSnapshot

// Nearest Dormant corridor edge below and above the reference price. While the
// bar stays strictly between them, no Dormant Core can wake.
f_rebuildDormantGuard(ZoneEngine e, float px) =>
    float lo = na
    float hi = na
    bool blocked = false
    int n = array.size(e.dormantSlots)
    if n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.dormantSlots, k))
            if not na(z.dormantWakeLow) and not na(z.dormantWakeHigh)
                if z.dormantWakeHigh < px
                    lo := na(lo) ? z.dormantWakeHigh : math.max(lo, z.dormantWakeHigh)
                else if z.dormantWakeLow > px
                    hi := na(hi) ? z.dormantWakeLow : math.min(hi, z.dormantWakeLow)
                else
                    blocked := true
            else
                blocked := true
    e.dormantGuardLow := blocked ? na : lo
    e.dormantGuardHigh := blocked ? na : hi
    e.dormantGuardValid := not blocked
    true

f_allocCore(ZoneEngine e, int t, ZoneCfg c) =>
    int coreId = e.nextCoreId
    e.nextCoreId += 1
    int genId = e.nextGenerationId
    e.nextGenerationId += 1
    ZoneCore z = f_emptyCore(coreId, genId, t)
    int slot = na
    if array.size(e.freeCoreSlots) > 0
        slot := array.pop(e.freeCoreSlots)
        array.set(e.cores, slot, z)
    else
        slot := array.size(e.cores)
        array.push(e.cores, z)
    map.put(e.coreIndex, coreId, slot)
    array.push(e.liveCoreSlots, slot)
    e.liveCoreCount += 1
    e.storageCheckDirty := true
    f_syncCoreSets(e, slot, c)
    slot

f_coreHasSharedIdentityRoot(ZoneEngine e, ZoneCore z, Candidate cnd) =>
    bool shared = false
    int n = array.size(cnd.rootIds)
    if n > 0
        for i = 0 to n - 1
            int id = array.get(cnd.rootIds, i)
            Root r = f_getRoot(e, id)
            if not na(r) and not (r.category == CAT_FVG and r.isBroadFvg) and f_arrayHasInt(z.originRootIds, id)
                shared := true
                break
    shared

f_coreMatchesCandidate(ZoneEngine e, ZoneCore z, Candidate cnd, ZoneCfg c) =>
    // Geometry is much cheaper than origin-set intersection. Reject distant cores
    // first; only the few price-continuous cores pay the Root identity scan.
    float gp = na(z.physicalBottom) ? 0.0 : f_gap(z.physicalBottom, z.physicalTop, cnd.bottom, cnd.top)
    bool continuous = na(z.physicalBottom) or int(math.round(gp / c.mintick)) <= int(math.round(c.clusterMaxWidth / c.mintick))
    continuous and f_coreHasSharedIdentityRoot(e, z, cnd)

f_coreHasInverseWait(ZoneEngine e, ZoneCore z) =>
    bool yes = false
    int n = array.size(z.originRootIds)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(z.originRootIds, i))
            if not na(r) and r.category == CAT_FVG and r.state == ROOT_INVERSE_WAIT
                yes := true
                break
    yes

f_isProtectedCore(ZoneEngine e, ZoneCore z) =>
    bool protected = z.pendingTopology or z.pendingGeneration or f_coreHasInverseWait(e, z)
    SideHistory hs = z.supportView.history
    SideHistory hr = z.resistanceView.history
    protected := protected or hs.phase == PH_ACTIVE_TOUCH or hs.phase == PH_BROKEN or hs.phase == PH_FLIP_WAIT
    protected := protected or hr.phase == PH_ACTIVE_TOUCH or hr.phase == PH_BROKEN or hr.phase == PH_FLIP_WAIT
    protected

// Summary of the marks a Side owns, optionally restricted to a price range.
// Returns [count, anyWeakByDepth, maxDepthPct, lastTouchTime].
f_marksSummaryForSide(ZoneCore z, int side, float b, float t, bool useRange, ZoneCfg c) =>
    int cnt = 0
    bool anyDepth = false
    float maxDepth = 0.0
    int lastTime = na
    int n = array.size(z.touchMarks)
    if n > 0
        for i = 0 to n - 1
            TouchMark tm = array.get(z.touchMarks, i)
            if tm.side == side and tm.isNormalTouch
                if not useRange or f_intersects(tm.contactBottom, tm.contactTop, b, t, c.mintick)
                    cnt += 1
                    anyDepth := anyDepth or tm.episodeWeakByDepth
                    maxDepth := math.max(maxDepth, tm.episodeMaxDepthPct)
                    lastTime := na(lastTime) ? tm.time : math.max(lastTime, tm.time)
    [cnt, anyDepth, maxDepth, lastTime]

// Rewrites a Side's history so it cannot contradict the marks it actually owns.
f_rebuildSideHistoryFromMarks(ZoneEngine e, ZoneCore z, SideViewState v, int side, ZoneCfg c) =>
    [cnt, anyDepth, maxDepth, lastTime] = f_marksSummaryForSide(z, side, na, na, false, c)
    bool truncated = v.history.historyIncomplete and v.history.sideTouchCount > cnt
    v.history.sideTouchCount := truncated ? v.history.sideTouchCount : cnt
    v.history.sideFresh := v.history.sideTouchCount == 0
    v.history.weakByDepth := anyDepth or (truncated and v.history.weakByDepth)
    v.history.maxDepthPct := truncated ? math.max(maxDepth, v.history.maxDepthPct) : maxDepth
    v.history.weakByTouch := not c.weakFromTouchOff and v.history.sideTouchCount >= c.weakFromTouch
    v.history.lastNormalTouchTime := truncated ? v.history.lastNormalTouchTime : lastTime
    v.history.upcomingTouchNo := v.history.sideTouchCount + 1
    true

// FIX 22.4. Topology that arrived during an episode is applied once the episode
// ends, whichever way it ended. The reference build flushed only on TouchReset,
// so a Zone that ended its episode with a Local Break kept pendingTopology set
// forever and never re-clustered.
f_flushPendingTopologyIfIdle(ZoneEngine e, ZoneCore z, ZoneCfg c) =>
    if z.pendingTopology and z.supportView.history.phase != PH_ACTIVE_TOUCH and z.resistanceView.history.phase != PH_ACTIVE_TOUCH
        f_markDirty(e, z.pendingAffectedBottom, z.pendingAffectedTop, c)
        z.pendingTopology := false
        z.pendingAffectedBottom := na
        z.pendingAffectedTop := na
    true

f_mergeTouchMarks(ZoneEngine e, ZoneCore dst, ZoneCore src, ZoneCfg c) =>
    int n = array.size(src.touchMarks)
    if n > 0
        for i = 0 to n - 1
            TouchMark tm = array.get(src.touchMarks, i)
            bool dup = false
            int dn = array.size(dst.touchMarks)
            if dn > 0
                for j = 0 to dn - 1
                    TouchMark dm = array.get(dst.touchMarks, j)
                    if dm.time == tm.time and dm.side == tm.side and f_intersects(dm.contactBottom, dm.contactTop, tm.contactBottom, tm.contactTop, c.mintick)
                        dup := true
                        break
            if not dup
                array.push(dst.touchMarks, tm)
    while array.size(dst.touchMarks) > c.maxTouchMarksPerCore
        TouchMark dropped = array.shift(dst.touchMarks)
        if dropped.side == SIDE_SUPPORT
            dst.supportView.history.historyIncomplete := true
        else
            dst.resistanceView.history.historyIncomplete := true
        e.touchHistoryTruncated := true
    true

f_countMarksForSide(ZoneCore z, int side) =>
    int cnt = 0
    int n = array.size(z.touchMarks)
    if n > 0
        for i = 0 to n - 1
            TouchMark tm = array.get(z.touchMarks, i)
            if tm.side == side and tm.isNormalTouch
                cnt += 1
    cnt

f_filterMarksForSideRange(ZoneCore z, int side, float b, float t, ZoneCfg c) =>
    int i = array.size(z.touchMarks) - 1
    while i >= 0
        TouchMark tm = array.get(z.touchMarks, i)
        if tm.side == side and tm.isNormalTouch and not f_intersects(tm.contactBottom, tm.contactTop, b, t, c.mintick)
            array.remove(z.touchMarks, i)
        i -= 1
    true

f_mergeHistory(SideHistory a, SideHistory b) =>
    a.sideTouchCount := math.max(a.sideTouchCount, b.sideTouchCount)
    a.weakByTouch := a.weakByTouch or b.weakByTouch
    a.weakByDepth := a.weakByDepth or b.weakByDepth
    a.maxDepthPct := math.max(a.maxDepthPct, b.maxDepthPct)
    a.sideFresh := a.sideFresh and b.sideFresh
    a.lastNormalTouchTime := na(a.lastNormalTouchTime) ? b.lastNormalTouchTime : na(b.lastNormalTouchTime) ? a.lastNormalTouchTime : math.max(a.lastNormalTouchTime, b.lastNormalTouchTime)
    a.flipAttemptCount += b.flipAttemptCount
    a.inverseAttemptCount += b.inverseAttemptCount
    true

f_retireCoreSlot(ZoneEngine e, int slot, ZoneCfg c) =>
    if slot >= 0 and slot < array.size(e.cores)
        ZoneCore z = array.get(e.cores, slot)
        if z.alive
            z.alive := false
            // Drop the Core from every work set before its slot is reused.
            f_syncCoreSets(e, slot, c)
            map.remove(e.coreIndex, z.coreId)
            f_removeSlotValue(e.liveCoreSlots, slot)
            array.push(e.freeCoreSlots, slot)
            e.liveCoreCount -= 1
    true

f_mergeCoreInto(ZoneEngine e, int dstSlot, int srcSlot, ZoneFeed f, ZoneCfg c) =>
    if dstSlot != srcSlot
        ZoneCore dst = array.get(e.cores, dstSlot)
        ZoneCore src = array.get(e.cores, srcSlot)
        if dst.alive and src.alive
            int rn = array.size(src.originRootIds)
            if rn > 0
                for i = 0 to rn - 1
                    f_arrayAddUnique(dst.originRootIds, array.get(src.originRootIds, i))
            f_mergeHistory(dst.supportView.history, src.supportView.history)
            f_mergeHistory(dst.resistanceView.history, src.resistanceView.history)
            f_mergeTouchMarks(e, dst, src, c)
            // FIX 22.6. Counts, Fresh, WeakByTouch, WeakByDepth and maxDepthPct are
            // derived from the inherited TouchMarks, so the merged Core can never
            // claim a Weak history that no surviving Touch supports, nor forget one
            // that a surviving Touch proves.
            f_rebuildSideHistoryFromMarks(e, dst, dst.supportView, SIDE_SUPPORT, c)
            f_rebuildSideHistoryFromMarks(e, dst, dst.resistanceView, SIDE_RESISTANCE, c)
            dst.zoneFresh := array.size(dst.touchMarks) == 0 and dst.zoneFresh and src.zoneFresh
            dst.physicalBottom := na(dst.physicalBottom) ? src.physicalBottom : na(src.physicalBottom) ? dst.physicalBottom : math.min(dst.physicalBottom, src.physicalBottom)
            dst.physicalTop := na(dst.physicalTop) ? src.physicalTop : na(src.physicalTop) ? dst.physicalTop : math.max(dst.physicalTop, src.physicalTop)
            f_emit(e, EV_MERGE, f, dst.coreId, dst.generationId, SIDE_NONE, dst.physicalBottom, dst.physicalTop, 0, GR_UNAVAILABLE, WEAK_NONE, src.coreId)
            f_retireCoreSlot(e, srcSlot, c)
            f_syncCoreSets(e, dstSlot, c)
    true

// FIX 22.6. The child Zone inherits exactly the episodes whose contact actually
// intersects its new EffectiveRange, and its Weak state is reconstructed from
// those episodes. The reference build copied the parent's WeakByDepth and
// maxDepthPct onto every child regardless of which Touches it inherited.
f_filteredHistoryForSplit(ZoneEngine e, ZoneCore parent, int side, Candidate cnd, ZoneCfg c) =>
    SideHistory src = side == SIDE_SUPPORT ? parent.supportView.history : parent.resistanceView.history
    SideHistory h = f_emptyHistory()
    [assigned, anyDepth, maxDepth, lastTime] = f_marksSummaryForSide(parent, side, cnd.bottom, cnd.top, true, c)
    // Only an actually truncated history may fall back to the parent aggregate.
    bool truncated = src.historyIncomplete and src.sideTouchCount > assigned
    h.sideTouchCount := assigned
    h.sideFresh := assigned == 0 and not truncated
    h.weakByDepth := anyDepth or (truncated and src.weakByDepth)
    h.maxDepthPct := truncated ? math.max(maxDepth, src.maxDepthPct) : maxDepth
    h.weakByTouch := not c.weakFromTouchOff and assigned >= c.weakFromTouch
    h.lastNormalTouchTime := na(lastTime) and truncated ? src.lastNormalTouchTime : lastTime
    h.historyIncomplete := truncated
    h.upcomingTouchNo := h.sideTouchCount + 1
    h

// Moves the episodes that belong to the child out of the parent, so the two
// Cores never both claim the same Touch.
f_moveMarksToChild(ZoneCore parent, ZoneCore child, int side, float b, float t, ZoneCfg c) =>
    int i = array.size(parent.touchMarks) - 1
    while i >= 0
        TouchMark tm = array.get(parent.touchMarks, i)
        if tm.side == side and tm.isNormalTouch and f_intersects(tm.contactBottom, tm.contactTop, b, t, c.mintick)
            array.unshift(child.touchMarks, tm)
            array.remove(parent.touchMarks, i)
        i -= 1
    true

f_updatePhysicalRange(ZoneCore z) =>
    float b = na
    float t = na
    if not na(z.supportView.effectiveBottom)
        b := z.supportView.effectiveBottom
        t := z.supportView.effectiveTop
    if not na(z.resistanceView.effectiveBottom)
        b := na(b) ? z.resistanceView.effectiveBottom : math.min(b, z.resistanceView.effectiveBottom)
        t := na(t) ? z.resistanceView.effectiveTop : math.max(t, z.resistanceView.effectiveTop)
    z.physicalBottom := b
    z.physicalTop := t
    true

// ============================================================================
// EMA Topology Guard (sections 1-7).
//
// EMA2000 / EMA3000 move on almost every Base bar. Examining Roots, psych
// levels, FVGs or Cores on each of those moves is not a Fast Path, so it is
// gone. Instead each EMA Root carries the price interval inside which NO
// topology relationship can change, plus the slope sign it was built with.
//
// Normal Base bar, per EMA Root, O(1):
//
//     newEMA > emaGuardLow and newEMA < emaGuardHigh and slope == guardSlope
//         -> price update + the Cores in the EMA reverse index. Nothing else.
//
// The guard is rebuilt ONLY in the Slow Path.
//
// SECTION 5 - the one accepted compromise. While the guard holds, participating
// Roots, C, H, Density class, FVG participation and MA slope quality are all
// unchanged, so the winner cannot change for any structural reason. The only
// thing the EMA still shifts is a candidate's WIDTH, so two candidates with
// identical C and H could in principle swap the "narrower wins" tie-break. That
// is deliberately not tracked until the next guard event.
// ============================================================================
f_guardOne(ZoneEngine e, float b, float ema, float mt) =>
    if not na(b)
        if f_eq(b, ema, mt)
            // Sitting exactly on a boundary: any move at all must breach.
            e.workGuardLow := ema
            e.workGuardHigh := ema
        else if b < ema
            if na(e.workGuardLow) or b > e.workGuardLow
                e.workGuardLow := b
        else
            if na(e.workGuardHigh) or b < e.workGuardHigh
                e.workGuardHigh := b
    true

// Section 3: every boundary at which a relationship to `base` can change.
f_guardFold(ZoneEngine e, float base, float ema, float mw, float dw, float mt) =>
    f_guardOne(e, base, ema, mt)
    f_guardOne(e, base - mw, ema, mt)
    f_guardOne(e, base + mw, ema, mt)
    f_guardOne(e, base - dw, ema, mt)
    f_guardOne(e, base + dw, ema, mt)
    true

f_buildEmaGuard(ZoneEngine e, Root r, ZoneCfg c) =>
    float ema = r.pointPrice
    float mw = c.clusterMaxWidth
    float dw = c.clusterMaxWidth * c.denseRatio
    e.workGuardLow := na
    e.workGuardHigh := na
    float lo = ema - 3.0 * mw
    float hi = ema + 3.0 * mw

    // Point Roots, including the other EMA.
    int i = f_pointIndexLowerBound(e, lo)
    int n = array.size(e.pointPriceIndex)
    bool done = false
    while i < n and not done
        Root q = array.get(e.roots, array.get(e.pointPriceIndex, i))
        if not q.alive
            i += 1
        else if q.pointPrice > hi
            done := true
        else
            if q.rootId != r.rootId
                f_guardFold(e, q.pointPrice, ema, mw, dw, c.mintick)
            i += 1

    // Section 3: only the two psych levels bracketing the EMA, derived, never
    // scanned across the price range.
    if c.enablePsych
        f_guardFold(e, math.floor(ema / 50.0) * 50.0, ema, mw, dw, c.mintick)
        f_guardFold(e, math.ceil(ema / 50.0) * 50.0, ema, mw, dw, c.mintick)

    // FVG NativeRange edges. Folding both edges also covers the proximal edge of
    // either Side.
    if c.enableFVG
        int fn = array.size(e.fvgSlots)
        if fn > 0
            for k = 0 to fn - 1
                Root fr = array.get(e.roots, array.get(e.fvgSlots, k))
                if fr.alive and f_intersects(fr.nativeBottom - mw, fr.nativeTop + mw, lo, hi, c.mintick)
                    f_guardFold(e, fr.nativeBottom, ema, mw, dw, c.mintick)
                    f_guardFold(e, fr.nativeTop, ema, mw, dw, c.mintick)

    // With nothing within 3M, a move of 2M still cannot bring anything within
    // M or DenseWidth, so that is a safe fallback bound.
    r.emaGuardLow := na(e.workGuardLow) ? ema - 2.0 * mw : e.workGuardLow
    r.emaGuardHigh := na(e.workGuardHigh) ? ema + 2.0 * mw : e.workGuardHigh
    r.emaGuardSlopeSign := r.slopeSign
    r.emaGuardValid := true
    true

// Recomputes one View's geometry from its unchanged membership. Category counts
// and High masks are untouched because the relationship test proved they cannot
// have changed; only the width-derived values and ReferencePrice are redone.
f_maRecomputeView(ZoneEngine e, SideViewState v, int side, ZoneCfg c) =>
    float bottom = na
    float top = na
    int n = array.size(v.rootIds)
    if n > 0
        for i = 0 to n - 1
            Root q = f_getRoot(e, array.get(v.rootIds, i))
            if not na(q) and not q.isRangeRoot and not na(q.pointPrice)
                bottom := na(bottom) ? q.pointPrice : math.min(bottom, q.pointPrice)
                top := na(top) ? q.pointPrice : math.max(top, q.pointPrice)
    if not na(bottom) and n > 0
        // Mirror the proximal extension rule used when the Candidate was built.
        for i = 0 to n - 1
            Root fr = f_getRoot(e, array.get(v.rootIds, i))
            if not na(fr) and fr.category == CAT_FVG
                bool anyInside = false
                for j = 0 to n - 1
                    Root q = f_getRoot(e, array.get(v.rootIds, j))
                    if not na(q) and not q.isRangeRoot and f_ge(q.pointPrice, fr.nativeBottom, c.mintick) and f_le(q.pointPrice, fr.nativeTop, c.mintick)
                        anyInside := true
                        break
                if not anyInside
                    float proximal = side == SIDE_SUPPORT ? fr.nativeTop : fr.nativeBottom
                    if side == SIDE_SUPPORT and f_ge(bottom, proximal, c.mintick)
                        bottom := proximal
                    else if side == SIDE_RESISTANCE and f_le(top, proximal, c.mintick)
                        top := proximal
        v.effectiveBottom := bottom
        v.effectiveTop := top
        if not v.isBroadContext
            v.density := f_widthLe(bottom, top, c.clusterMaxWidth * c.denseRatio, c.mintick) ? DEN_HIGH : DEN_NORMAL
            v.baseStrong := v.density == DEN_HIGH and ((v.cCount == 2 and v.hCount >= 1) or v.cCount >= 3)
        v.referencePrice := f_referencePrice(e, v.rootIds, side, bottom, top)
        if c.countersOn
            e.referenceCalcCount += 1
    true

// Section 6 / 7. Only the Cores in the EMA reverse index are touched, and only
// their LiveStructure. A running TouchStartSnapshot is never modified.
f_emaFastCoreUpdate(ZoneEngine e, Root r, array<int> coreSlots, ZoneCfg c) =>
    int n = array.size(coreSlots)
    if n > 0
        for k = 0 to n - 1
            int slot = array.get(coreSlots, k)
            if slot >= 0 and slot < array.size(e.cores)
                ZoneCore z = array.get(e.cores, slot)
                if z.alive
                    bool touched = false
                    if f_arrayHasInt(z.supportView.rootIds, r.rootId)
                        f_maRecomputeView(e, z.supportView, SIDE_SUPPORT, c)
                        touched := true
                    if f_arrayHasInt(z.resistanceView.rootIds, r.rootId)
                        f_maRecomputeView(e, z.resistanceView, SIDE_RESISTANCE, c)
                        touched := true
                    if touched
                        f_updatePhysicalRange(z)
    true

// Rebuilt at the end of a Slow Path only: membership cannot change without a
// topology event, so the Fast Path may trust it.
f_rebuildEmaCoreIndex(ZoneEngine e) =>
    array.clear(e.ema2000CoreSlots)
    array.clear(e.ema3000CoreSlots)
    int n = array.size(e.liveCoreSlots)
    if n > 0
        for k = 0 to n - 1
            int slot = array.get(e.liveCoreSlots, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                if f_arrayHasInt(z.supportView.rootIds, ROOT_ID_EMA2000) or f_arrayHasInt(z.resistanceView.rootIds, ROOT_ID_EMA2000)
                    array.push(e.ema2000CoreSlots, slot)
                if f_arrayHasInt(z.supportView.rootIds, ROOT_ID_EMA3000) or f_arrayHasInt(z.resistanceView.rootIds, ROOT_ID_EMA3000)
                    array.push(e.ema3000CoreSlots, slot)
    true

f_updateMaRoot(ZoneEngine e, int rootId, float newPrice, int seq, int slopeSign, ZoneCfg c) =>
    Root r = f_getRoot(e, rootId)
    if not na(r)
        float old = r.pointPrice
        float np = f_norm(newPrice, c.mintick)
        bool priceChanged = na(old) or not f_eq(old, np, c.mintick)
        bool slopeChanged = r.slopeSign != slopeSign
        if priceChanged or slopeChanged
            // ---- O(1) guard test. No array is walked here. ----
            bool inGuard = c.maFastPath and r.emaGuardValid and not na(r.emaGuardLow) and not na(r.emaGuardHigh)
            inGuard := inGuard and slopeSign == r.emaGuardSlopeSign
            // Strict comparison, so reaching a boundary breaches (safe side).
            inGuard := inGuard and f_gt(np, r.emaGuardLow, c.mintick) and f_lt(np, r.emaGuardHigh, c.mintick)

            int oldIndexPos = priceChanged ? f_pointIndexFindByPrice(e, rootId, old) : na
            r.pointPrice := np
            r.nativeBottom := np
            r.nativeTop := np
            r.slopeSign := slopeSign
            r.lastUpdateSeq := seq
            if priceChanged
                f_pointIndexRepositionAt(e, rootId, oldIndexPos)

            if inGuard
                f_emaFastCoreUpdate(e, r, rootId == ROOT_ID_EMA2000 ? e.ema2000CoreSlots : e.ema3000CoreSlots, c)
                if c.countersOn
                    e.emaGuardHits += 1
                    e.maFastUpdates += 1
            else
                r.emaGuardValid := false
                f_markDirty(e, old, old, c)
                f_markDirty(e, np, np, c)
                if c.countersOn
                    e.emaGuardBreaches += 1
                    e.maSlowUpdates += 1
    true

f_ensureMA(ZoneEngine e, ZoneCfg c, ZoneFeed f) =>
    // request.security() can yield an undefined UDT reference on the first mapped bar.
    // Guard the object itself before reading fields; this allocates nothing.
    if c.enableMA and not na(f.ma1m) and not na(f.ma1m.ema2000) and not na(f.ma1m.ema3000) and not na(f.ma1m.confirmedTime) and f.ma1m.confirmedTime <= f.baseCloseTime
        if na(f_getRoot(e, ROOT_ID_EMA2000))
            float p2 = f_norm(f.ma1m.ema2000, c.mintick)
            f_newRoot(e, ROOT_ID_EMA2000, ROOT_ID_EMA2000, CAT_MA, SUB_MA_2000, TF_1M, 0,
                f.ma1m.confirmedTime, f.ma1m.confirmedTime, f.ma1m.confirmedTime, p2, p2, p2,
                false, true, ROOT_ACTIVE, 0, FVG_NONE, false, false, 0, f.baseSeq, f_slopeSign(f.ma1m.slope2000))
            f_markDirty(e, p2, p2, c)
        else
            f_updateMaRoot(e, ROOT_ID_EMA2000, f.ma1m.ema2000, f.baseSeq, f_slopeSign(f.ma1m.slope2000), c)
        if na(f_getRoot(e, ROOT_ID_EMA3000))
            float p3 = f_norm(f.ma1m.ema3000, c.mintick)
            f_newRoot(e, ROOT_ID_EMA3000, ROOT_ID_EMA3000, CAT_MA, SUB_MA_3000, TF_1M, 0,
                f.ma1m.confirmedTime, f.ma1m.confirmedTime, f.ma1m.confirmedTime, p3, p3, p3,
                false, true, ROOT_ACTIVE, 0, FVG_NONE, false, false, 0, f.baseSeq, f_slopeSign(f.ma1m.slope3000))
            f_markDirty(e, p3, p3, c)
        else
            f_updateMaRoot(e, ROOT_ID_EMA3000, f.ma1m.ema3000, f.baseSeq, f_slopeSign(f.ma1m.slope3000), c)
    true

f_applyCandidate(ZoneEngine e, ZoneCore z, Candidate cnd, int side, ZoneFeed f, ZoneCfg c, bool remapHistory, bool isSplit, SideHistory splitHistory) =>
    SideViewState v = side == SIDE_SUPPORT ? z.supportView : z.resistanceView
    bool active = v.history.phase == PH_ACTIVE_TOUCH
    // FIX 22.3. An episode freezes its TouchStartSnapshot, never the Zone itself.
    // Identity work (Merge, Split, new Core, new Generation) is deferred while the
    // episode runs, but LiveStructure - participating Roots, EffectiveRange, C, H,
    // Density, BaseStrong, ReferencePrice, eligibility - is refreshed immediately.
    // The reference build froze both, so a Zone whose Roots were invalidated
    // mid-Touch kept publishing dead Roots and a stale range until the episode
    // ended.
    if active
        z.pendingTopology := true
        z.pendingAffectedBottom := na(z.pendingAffectedBottom) ? cnd.bottom : math.min(z.pendingAffectedBottom, cnd.bottom)
        z.pendingAffectedTop := na(z.pendingAffectedTop) ? cnd.top : math.max(z.pendingAffectedTop, cnd.top)
    else if isSplit
        v.history := splitHistory

    // LiveStructure is refreshed on every application, episode or not.
    array.clear(v.rootIds)
    int crn = array.size(cnd.rootIds)
    if crn > 0
        for cri = 0 to crn - 1
            array.push(v.rootIds, array.get(cnd.rootIds, cri))
    v.effectiveBottom := cnd.bottom
    v.effectiveTop := cnd.top
    v.referencePrice := cnd.referencePrice
    v.cCount := cnd.cCount
    v.hCount := cnd.hCount
    v.density := cnd.density
    v.categoryMask := cnd.categoryMask
    v.highMask := cnd.highMask
    v.baseStrong := cnd.baseStrong
    v.hasNonPsychRoot := true
    v.isBroadContext := cnd.broadContext
    v.eligible := true
    v.fvgDirectionMask := cnd.fvgDirectionMask
    v.fvgRootCount := cnd.fvgRootCount
    v.fvgFreshCount := cnd.fvgFreshCount
    v.fvgStructuralStateMask := cnd.fvgStructuralStateMask

    // Everything below belongs to the episode, not to the structure, so it is
    // applied only when no episode is running on this Side.
    if not active
        if v.history.phase != PH_BROKEN and v.history.phase != PH_FLIP_WAIT
            if v.history.phase == PH_DORMANT
                v.history.phase := PH_WAITING
        if remapHistory
            f_filterMarksForSideRange(z, side, cnd.bottom, cnd.top, c)
            int mappedTouches = f_countMarksForSide(z, side)
            if not v.history.historyIncomplete
                v.history.sideTouchCount := mappedTouches
                v.history.sideFresh := mappedTouches == 0
            else
                v.history.sideTouchCount := math.max(v.history.sideTouchCount, mappedTouches)
                if v.history.sideTouchCount > 0
                    v.history.sideFresh := false
        v.history.upcomingTouchNo := v.history.sideTouchCount + 1
        int targetTouch = v.history.phase == PH_ACTIVE_TOUCH ? v.history.currentTouchNo : v.history.upcomingTouchNo
        bool weakTouch = not c.weakFromTouchOff and targetTouch >= c.weakFromTouch
        bool weak = v.history.weakByDepth or v.history.weakByTouch or weakTouch
        v.history.grade := weak ? GR_WEAK : cnd.baseStrong and (c.strongUnlimited or targetTouch <= c.strongUntilTouch) ? GR_STRONG : GR_NEUTRAL
        if z.generationStartCategoryMask == 0
            z.generationStartCategoryMask := cnd.categoryMask
        int baseMask = z.lastTouchCategoryMask != 0 ? z.lastTouchCategoryMask : z.lastBreakCategoryMask != 0 ? z.lastBreakCategoryMask : z.generationStartCategoryMask
        int addedNonPsych = f_newNonPsychCategoryMask(cnd.categoryMask, baseMask)
        SideHistory otherH = side == SIDE_SUPPORT ? z.resistanceView.history : z.supportView.history
        bool oldConsumed = v.history.sideTouchCount > 0 or otherH.sideTouchCount > 0 or v.history.weakByDepth or v.history.weakByTouch or otherH.weakByDepth or otherH.weakByTouch or v.history.phase == PH_BROKEN or v.history.phase == PH_FLIP_WAIT or otherH.phase == PH_BROKEN or otherH.phase == PH_FLIP_WAIT
        if oldConsumed and addedNonPsych != 0 and cnd.baseStrong
            z.pendingGeneration := true
            // Section 29.
            z.generationCandidateSide := side
            z.generationCandidateMask := cnd.categoryMask
            z.generationCandidateBottom := cnd.bottom
            z.generationCandidateTop := cnd.top
            if not z.generationCandidateAway
                bool away = side == SIDE_SUPPORT ? f_ge(f.baseClose, cnd.top + c.touchResetDistance, c.mintick) : f_le(f.baseClose, cnd.bottom - c.touchResetDistance, c.mintick)
                if away
                    z.generationCandidateAway := true
                    z.generationCandidateArmedFromSeq := f.baseSeq + 1
    int rn = array.size(cnd.rootIds)
    if rn > 0
        for i = 0 to rn - 1
            f_arrayAddUnique(z.originRootIds, array.get(cnd.rootIds, i))
    z.lastSeenTime := f.baseCloseTime
    f_updatePhysicalRange(z)
    true

f_collectLocalCoreSlots(ZoneEngine e, ZoneCfg c) =>
    if c.countersOn
        e.coreFullScanCount += 1
    array.clear(e.workLocalCoreSlots)
    float lo = na(e.dirtyBottom) ? na : e.dirtyBottom - c.clusterMaxWidth
    float hi = na(e.dirtyTop) ? na : e.dirtyTop + c.clusterMaxWidth
    int n = array.size(e.liveCoreSlots)
    if n > 0
        for k = 0 to n - 1
            int slot = array.get(e.liveCoreSlots, k)
            ZoneCore z = array.get(e.cores, slot)
            bool local = na(lo) or na(z.physicalBottom) or f_intersects(z.physicalBottom, z.physicalTop, lo, hi, c.mintick)
            if z.alive and local
                array.push(e.workLocalCoreSlots, slot)
    e.workLocalCoreSlots

f_reconcileCandidates(ZoneEngine e, array<Candidate> candidates, int side, ZoneFeed f, ZoneCfg c, array<int> updatedCoreIds, array<int> localCoreSlots) =>
    int n = array.size(candidates)
    if n > 0
        for i = 0 to n - 1
            Candidate cnd = array.get(candidates, i)
            // Reuse one Engine-owned slot buffer instead of allocating a matches
            // array for every Candidate.
            array.clear(e.workTempIds)
            int ln = array.size(localCoreSlots)
            if ln > 0
                for li = 0 to ln - 1
                    int slot = array.get(localCoreSlots, li)
                    if slot >= 0 and slot < array.size(e.cores)
                        ZoneCore mz = array.get(e.cores, slot)
                        if mz.alive and f_coreMatchesCandidate(e, mz, cnd, c)
                            array.push(e.workTempIds, slot)
            int dstSlot = na
            bool didMerge = false
            int matchN = array.size(e.workTempIds)
            if matchN > 0
                int bestId = 2147483647
                for m = 0 to matchN - 1
                    int s = array.get(e.workTempIds, m)
                    ZoneCore mz = array.get(e.cores, s)
                    if mz.alive and mz.coreId < bestId
                        bestId := mz.coreId
                        dstSlot := s
                if matchN > 1 and not na(dstSlot)
                    for m = 0 to matchN - 1
                        int s = array.get(e.workTempIds, m)
                        if s != dstSlot
                            ZoneCore srcz = array.get(e.cores, s)
                            ZoneCore dstz = array.get(e.cores, dstSlot)
                            if c.countersOn
                                e.mergeEvalCount += 1
                            if srcz.alive and dstz.alive and not f_isProtectedCore(e, srcz) and not f_isProtectedCore(e, dstz)
                                f_mergeCoreInto(e, dstSlot, s, f, c)
                                didMerge := true
            bool split = false
            bool splitDeferred = false
            ZoneCore parent = na
            if not na(dstSlot)
                ZoneCore dz = array.get(e.cores, dstSlot)
                if dz.alive and f_arrayHasInt(updatedCoreIds, dz.coreId)
                    if c.countersOn
                        e.splitEvalCount += 1
                    // FIX 22.5. A Split is never materialised while an episode is
                    // live. The reference build created the child Core mid-Touch,
                    // which moved the ground under the running TouchStartSnapshot.
                    // The new Core becomes pending and is created once the episode
                    // ends, at which point TouchMarks decide what it inherits.
                    if dz.supportView.history.phase == PH_ACTIVE_TOUCH or dz.resistanceView.history.phase == PH_ACTIVE_TOUCH
                        splitDeferred := true
                        dz.pendingTopology := true
                        dz.pendingAffectedBottom := na(dz.pendingAffectedBottom) ? cnd.bottom : math.min(dz.pendingAffectedBottom, cnd.bottom)
                        dz.pendingAffectedTop := na(dz.pendingAffectedTop) ? cnd.top : math.max(dz.pendingAffectedTop, cnd.top)
                    else
                        split := true
                        parent := dz
                        dstSlot := f_allocCore(e, f.baseCloseTime, c)
                        ZoneCore nz = array.get(e.cores, dstSlot)
                        nz.generationId := parent.generationId
                        f_emit(e, EV_SPLIT, f, parent.coreId, parent.generationId, side, cnd.bottom, cnd.top, 0, GR_UNAVAILABLE, WEAK_NONE, nz.coreId)
            if not splitDeferred
                if na(dstSlot)
                    dstSlot := f_allocCore(e, f.baseCloseTime, c)
                ZoneCore z = array.get(e.cores, dstSlot)
                // Read the parent's marks before any of them move.
                SideHistory splitHist = split ? f_filteredHistoryForSplit(e, parent, side, cnd, c) : f_emptyHistory()
                if split
                    f_moveMarksToChild(parent, z, side, cnd.bottom, cnd.top, c)
                    SideViewState pv = side == SIDE_SUPPORT ? parent.supportView : parent.resistanceView
                    f_rebuildSideHistoryFromMarks(e, parent, pv, side, c)
                    parent.zoneFresh := array.size(parent.touchMarks) == 0 and parent.zoneFresh
                    z.zoneFresh := array.size(z.touchMarks) == 0
                f_applyCandidate(e, z, cnd, side, f, c, split or didMerge, split, splitHist)
                f_syncCoreSets(e, dstSlot, c)
                f_arrayAddUnique(updatedCoreIds, z.coreId)
                f_arrayAddUnique(localCoreSlots, dstSlot)
    true

f_clearStaleSideInDirty(ZoneEngine e, int side, array<int> updatedCoreIds, ZoneCfg c, array<int> localCoreSlots) =>
    int n = array.size(localCoreSlots)
    if n > 0 and not na(e.dirtyBottom)
        for i = 0 to n - 1
            int slot = array.get(localCoreSlots, i)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                SideViewState v = side == SIDE_SUPPORT ? z.supportView : z.resistanceView
                bool inDirty = not na(v.effectiveBottom) and f_intersects(v.effectiveBottom, v.effectiveTop, e.dirtyBottom, e.dirtyTop, c.mintick)
                if inDirty and not f_arrayHasInt(updatedCoreIds, z.coreId)
                    if v.history.phase == PH_ACTIVE_TOUCH
                        z.pendingTopology := true
                    else
                        bool inverseWait = false
                        int vrn = array.size(v.rootIds)
                        if vrn > 0
                            for q = 0 to vrn - 1
                                Root wr = f_getRoot(e, array.get(v.rootIds, q))
                                if not na(wr) and wr.category == CAT_FVG and wr.state == ROOT_INVERSE_WAIT
                                    inverseWait := true
                                    break
                        if inverseWait
                            v.eligible := false
                            v.hasNonPsychRoot := true
                            v.baseStrong := false
                            v.history.grade := GR_UNAVAILABLE
                        else
                            array.clear(v.rootIds)
                            v.effectiveBottom := na
                            v.effectiveTop := na
                            v.referencePrice := na
                            v.cCount := 0
                            v.hCount := 0
                            v.categoryMask := 0
                            v.highMask := 0
                            v.baseStrong := false
                            v.hasNonPsychRoot := false
                            v.eligible := false
                            v.history.grade := GR_UNAVAILABLE
                            f_updatePhysicalRange(z)
                    f_syncCoreSets(e, slot, c)
    true


f_recomputeCurrentOrigins(ZoneEngine e, array<int> localCoreSlots) =>
    int n = array.size(localCoreSlots)
    if n > 0
        for i = 0 to n - 1
            int slot = array.get(localCoreSlots, i)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                // Preserve the few old InverseWait origins before clearing the
                // reusable Core-owned origin array.
                array.clear(e.workTempIds)
                int on = array.size(z.originRootIds)
                if on > 0
                    for k = 0 to on - 1
                        int id = array.get(z.originRootIds, k)
                        Root r = f_getRoot(e, id)
                        if not na(r) and r.category == CAT_FVG and r.state == ROOT_INVERSE_WAIT
                            f_arrayAddUnique(e.workTempIds, id)
                array.clear(z.originRootIds)
                int sn = array.size(z.supportView.rootIds)
                if sn > 0
                    for k = 0 to sn - 1
                        f_arrayAddUnique(z.originRootIds, array.get(z.supportView.rootIds, k))
                int rn = array.size(z.resistanceView.rootIds)
                if rn > 0
                    for k = 0 to rn - 1
                        f_arrayAddUnique(z.originRootIds, array.get(z.resistanceView.rootIds, k))
                int kn = array.size(e.workTempIds)
                if kn > 0
                    for k = 0 to kn - 1
                        f_arrayAddUnique(z.originRootIds, array.get(e.workTempIds, k))
    true

f_rebuildActiveDirtyRange(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    if c.countersOn
        e.candidateRebuildCount += 1
    array.clear(e.workUpdatedSup)
    array.clear(e.workUpdatedRes)
    array<int> localCoreSlots = f_collectLocalCoreSlots(e, c)

    // Build/reconcile one Side at a time so the opposite Side's Candidate objects
    // do not coexist unnecessarily. Candidate generation reads Roots only, so this
    // preserves the specified Side-independent candidate result.
    array<Candidate> sup = f_buildSideCandidates(e, SIDE_SUPPORT, f, c)
    int candidateN = array.size(sup)
    f_reconcileCandidates(e, sup, SIDE_SUPPORT, f, c, e.workUpdatedSup, localCoreSlots)
    f_clearStaleSideInDirty(e, SIDE_SUPPORT, e.workUpdatedSup, c, localCoreSlots)

    array<Candidate> res = f_buildSideCandidates(e, SIDE_RESISTANCE, f, c)
    candidateN += array.size(res)
    f_reconcileCandidates(e, res, SIDE_RESISTANCE, f, c, e.workUpdatedRes, localCoreSlots)
    f_clearStaleSideInDirty(e, SIDE_RESISTANCE, e.workUpdatedRes, c, localCoreSlots)
    f_recomputeCurrentOrigins(e, localCoreSlots)
    candidateN

f_rebuildDirtyTopology(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    if e.topologyDirty
        // Snapshot queued bands before rebuilding. New dirty facts created later in
        // the bar remain in dirtyBottoms/dirtyTops for the next required rebuild.
        array.clear(e.workDirtyBottoms)
        array.clear(e.workDirtyTops)
        int queued = array.size(e.dirtyBottoms)
        if queued > 0
            for i = 0 to queued - 1
                array.push(e.workDirtyBottoms, array.get(e.dirtyBottoms, i))
                array.push(e.workDirtyTops, array.get(e.dirtyTops, i))
        else
            // First initialization fallback. `na` means use the normal active
            // price window around Base close inside f_buildSideCandidates().
            array.push(e.workDirtyBottoms, e.dirtyBottom)
            array.push(e.workDirtyTops, e.dirtyTop)
        array.clear(e.dirtyBottoms)
        array.clear(e.dirtyTops)
        e.topologyDirty := false
        e.dirtyBottom := na
        e.dirtyTop := na

        int totalCandidates = 0
        int rn = array.size(e.workDirtyBottoms)
        if rn > 0
            for i = 0 to rn - 1
                e.dirtyBottom := array.get(e.workDirtyBottoms, i)
                e.dirtyTop := array.get(e.workDirtyTops, i)
                if c.countersOn
                    e.dirtyBandCount += 1
                    e.maxDirtyBandWidth := math.max(e.maxDirtyBandWidth, e.dirtyTop - e.dirtyBottom)
                totalCandidates += f_rebuildActiveDirtyRange(e, f, c)
        e.candidateCountLast := totalCandidates
        e.dirtyBottom := na
        e.dirtyTop := na

        // PendingTopology is a deferred application marker, not a reason to rerun
        // the same candidate/Core rebuild on every 5m bar. Any genuinely new Root
        // change queues a new exact dirty band through f_markDirty().
    true

// ============================================================================
// Touch, Weak, Break, Flip/Reclaim and generation state machine
// ============================================================================
f_gradeFor(SideViewState v, ZoneCfg c, bool active) =>
    int touchNo = active ? v.history.currentTouchNo : v.history.sideTouchCount + 1
    bool weakTouch = not c.weakFromTouchOff and touchNo >= c.weakFromTouch
    bool weak = v.history.weakByDepth or v.history.weakByTouch or weakTouch
    not v.eligible or not v.hasNonPsychRoot ? GR_UNAVAILABLE : weak ? GR_WEAK : v.baseStrong and (c.strongUnlimited or touchNo <= c.strongUntilTouch) ? GR_STRONG : GR_NEUTRAL

f_copyBreak(BreakSnapshot b) => BreakSnapshot.new(valid = b.valid, coreId = b.coreId, generationId = b.generationId,
    oldSide = b.oldSide, rangeBottom = b.rangeBottom, rangeTop = b.rangeTop, rootIds = f_copyInts(b.rootIds),
    breakSeq = b.breakSeq, breakTime = b.breakTime, wasGapBreak = b.wasGapBreak, movedAway = b.movedAway, retestSeen = b.retestSeen)

f_addTouchMark(ZoneEngine e, ZoneCore z, SideViewState v, ZoneFeed f, int side, float b, float t, int touchNo, int startGrade, ZoneCfg c) =>
    float cb = math.max(f.baseLow, b)
    float ct = math.min(f.baseHigh, t)
    if b == t
        cb := b
        ct := t
    int seq = e.nextMarkSeq
    e.nextMarkSeq += 1
    v.history.currentMarkSeq := seq
    array.push(z.touchMarks, TouchMark.new(baseSeq = f.baseSeq, time = f.baseCloseTime, side = side,
        contactBottom = cb, contactTop = ct, closeAtTouch = f.baseClose, generationId = z.generationId,
        isNormalTouch = true, markSeq = seq, touchNo = touchNo, startGrade = startGrade,
        episodeWeakByDepth = false, episodeMaxDepthPct = 0.0))
    while array.size(z.touchMarks) > c.maxTouchMarksPerCore
        TouchMark dropped = array.shift(z.touchMarks)
        // Section 31: only THIS Core and Side become incomplete.
        if dropped.side == SIDE_SUPPORT
            z.supportView.history.historyIncomplete := true
        else
            z.resistanceView.history.historyIncomplete := true
        e.touchHistoryTruncated := true
    true

// Called once per episode end (Reset or Break). The mark then carries the depth
// facts that a later Merge or Split needs in order to rebuild history honestly.
f_sealTouchMark(ZoneCore z, SideViewState v, ZoneCfg c) =>
    int want = v.history.currentMarkSeq
    if not na(want)
        int n = array.size(z.touchMarks)
        if n > 0
            for i = n - 1 to 0
                TouchMark tm = array.get(z.touchMarks, i)
                if tm.markSeq == want
                    // Section 30: the episode's own depth, never the cumulative
                    // SideHistory.
                    tm.episodeMaxDepthPct := v.touchSnapshot.maxDepthPct
                    tm.episodeWeakByDepth := not c.weakDepthOff and v.touchSnapshot.maxDepthPct >= c.weakDepthPct
                    break
    v.history.currentMarkSeq := na
    true

f_startTouch(ZoneEngine e, ZoneCore z, SideViewState v, int side, float b, float t, ZoneFeed f, ZoneCfg c) =>
    v.history.sideTouchCount += 1
    v.history.currentTouchNo := v.history.sideTouchCount
    v.history.upcomingTouchNo := v.history.sideTouchCount + 1
    if not c.weakFromTouchOff and v.history.currentTouchNo >= c.weakFromTouch
        v.history.weakByTouch := true
    int g = f_gradeFor(v, c, true)
    v.history.grade := g
    v.history.phase := PH_ACTIVE_TOUCH
    v.history.sideFresh := false
    v.history.lastNormalTouchTime := f.baseCloseTime
    v.touchSnapshot := TouchStartSnapshot.new(valid = true, coreId = z.coreId, generationId = z.generationId,
        side = side, rangeBottom = b, rangeTop = t, rootIds = f_copyInts(v.rootIds), categoryMask = v.categoryMask,
        highMask = v.highMask, cCount = v.cCount, hCount = v.hCount, density = v.density, touchStartGrade = g,
        currentTouchNo = v.history.currentTouchNo, approachSide = side, startSeq = f.baseSeq, startTime = f.baseCloseTime,
        deepestClose = f.baseClose, maxDepthPct = 0.0)
    z.zoneFresh := false
    z.lastTouchCategoryMask := v.categoryMask
    z.lastTouchTime := f.baseCloseTime
    f_addTouchMark(e, z, v, f, side, b, t, v.history.currentTouchNo, g, c)
    f_emit(e, EV_TOUCH_START, f, z.coreId, z.generationId, side, b, t, v.history.currentTouchNo, g, f_weakReason(v.history), 0)
    true

f_breakSide(ZoneEngine e, ZoneCore z, SideViewState v, SideViewState opposite, int side, float b, float t, bool gapBreak, ZoneFeed f, ZoneCfg c) =>
    int priorGrade = v.history.grade
    int touchStartGrade = v.touchSnapshot.valid ? v.touchSnapshot.touchStartGrade : priorGrade
    BreakSnapshot bs = BreakSnapshot.new(valid = true, coreId = z.coreId, generationId = z.generationId, oldSide = side,
        rangeBottom = b, rangeTop = t, rootIds = f_copyInts(gapBreak ? v.rootIds : v.touchSnapshot.rootIds),
        breakSeq = f.baseSeq, breakTime = f.baseCloseTime, wasGapBreak = gapBreak, movedAway = false, retestSeen = false)
    v.breakSnapshot := bs
    opposite.breakSnapshot := f_copyBreak(bs)
    if z.lastTouchCategoryMask == 0
        z.lastBreakCategoryMask := f_categoryMaskFromIds(e, bs.rootIds)
    v.history.phase := PH_BROKEN
    v.history.grade := GR_UNAVAILABLE
    f_sealTouchMark(z, v, c)
    v.touchSnapshot.valid := false
    opposite.history.phase := PH_FLIP_WAIT
    opposite.history.grade := GR_UNAVAILABLE
    opposite.eligible := false
    int typ = gapBreak ? EV_GAP_BREAK : EV_LOCAL_BREAK
    f_emit(e, typ, f, z.coreId, z.generationId, side, b, t, v.history.currentTouchNo,
        gapBreak ? priorGrade : touchStartGrade, f_weakReason(v.history), 0)
    true

f_processArmedSide(ZoneEngine e, ZoneCore z, SideViewState v, SideViewState opposite, int side, ZoneFeed f, ZoneCfg c) =>
    if v.history.phase == PH_ARMED and not na(v.history.armedFromSeq) and f.baseSeq >= v.history.armedFromSeq
        float b = v.history.lastArmedRangeBottom
        float t = v.history.lastArmedRangeTop
        bool cross = f_eq(b, t, c.mintick) ? f_le(f.baseLow, b + c.touchTolerance, c.mintick) and f_ge(f.baseHigh, b - c.touchTolerance, c.mintick) : f_ge(f.baseHigh, b, c.mintick) and f_le(f.baseLow, t, c.mintick)
        bool gapBreak = side == SIDE_SUPPORT ? (f_lt(f.baseHigh, b, c.mintick) and f_le(f.baseClose, b - c.breakBuffer, c.mintick)) : (f_gt(f.baseLow, t, c.mintick) and f_ge(f.baseClose, t + c.breakBuffer, c.mintick))
        if gapBreak
            f_breakSide(e, z, v, opposite, side, b, t, true, f, c)
        else if cross
            f_startTouch(e, z, v, side, b, t, f, c)
    true

f_processActiveSide(ZoneEngine e, ZoneCore z, SideViewState v, SideViewState opposite, int side, ZoneFeed f, ZoneCfg c) =>
    if v.history.phase == PH_ACTIVE_TOUCH and v.touchSnapshot.valid
        float b = v.touchSnapshot.rangeBottom
        float t = v.touchSnapshot.rangeTop
        bool broken = side == SIDE_SUPPORT ? f_le(f.baseClose, b - c.breakBuffer, c.mintick) : f_ge(f.baseClose, t + c.breakBuffer, c.mintick)
        if broken
            f_breakSide(e, z, v, opposite, side, b, t, false, f, c)
            // Break has priority over WeakDepth on the same bar.
            v.history.grade := GR_UNAVAILABLE
            f_flushPendingTopologyIfIdle(e, z, c)
        else
            float width = t - b
            if width > 0 and not c.weakDepthOff
                float depth = side == SIDE_SUPPORT ? f_clamp((t - f.baseClose) / width * 100.0, 0.0, 100.0) : f_clamp((f.baseClose - b) / width * 100.0, 0.0, 100.0)
                v.touchSnapshot.maxDepthPct := math.max(v.touchSnapshot.maxDepthPct, depth)
                v.history.maxDepthPct := math.max(v.history.maxDepthPct, depth)
                if not v.history.weakByDepth and depth >= c.weakDepthPct
                    v.history.weakByDepth := true
                    v.history.grade := GR_WEAK
                    f_emit(e, EV_WEAK_DEPTH, f, z.coreId, z.generationId, side, b, t, v.history.currentTouchNo,
                        v.touchSnapshot.touchStartGrade, f_weakReason(v.history), 0)
            bool reset = side == SIDE_SUPPORT ? f_ge(f.baseClose, t + c.touchResetDistance, c.mintick) : f_le(f.baseClose, b - c.touchResetDistance, c.mintick)
            if reset
                v.history.phase := PH_ARMED
                v.history.armedFromSeq := f.baseSeq + 1
                v.history.currentTouchNo := 0
                v.history.upcomingTouchNo := v.history.sideTouchCount + 1
                v.history.lastArmedRangeBottom := v.effectiveBottom
                v.history.lastArmedRangeTop := v.effectiveTop
                f_sealTouchMark(z, v, c)
                v.touchSnapshot.valid := false
                v.history.grade := f_gradeFor(v, c, false)
                f_emit(e, EV_TOUCH_RESET, f, z.coreId, z.generationId, side, b, t, v.history.sideTouchCount,
                    v.history.grade, f_weakReason(v.history), 0)
                f_flushPendingTopologyIfIdle(e, z, c)
    true

f_anyFvgInvalidatedThisBar(ZoneEngine e, BreakSnapshot bs) =>
    bool hit = false
    int en = array.size(e.events)
    if en > 0
        for i = 0 to en - 1
            ZoneEvent ev = array.get(e.events, i)
            if ev.eventType == EV_FVG_INVALIDATE and f_arrayHasInt(bs.rootIds, ev.rootId)
                hit := true
                break
    hit

f_processBreakWait(ZoneEngine e, ZoneCore z, int oldSide, ZoneFeed f, ZoneCfg c) =>
    SideViewState oldV = oldSide == SIDE_SUPPORT ? z.supportView : z.resistanceView
    SideViewState newV = oldSide == SIDE_SUPPORT ? z.resistanceView : z.supportView
    BreakSnapshot bs = oldV.breakSnapshot
    if bs.valid and oldV.history.phase == PH_BROKEN
        bool wasMoved = bs.movedAway
        bool moveNow = oldSide == SIDE_SUPPORT ? f_le(f.baseClose, bs.rangeBottom - c.touchResetDistance, c.mintick) : f_ge(f.baseClose, bs.rangeTop + c.touchResetDistance, c.mintick)
        if not bs.movedAway and moveNow
            bs.movedAway := true
            oldV.breakSnapshot.movedAway := true
            newV.breakSnapshot.movedAway := true
        // FIX 22.2. Reclaim is NOT conditional on movedAway. Reclaim is defined by
        // the BreakSnapshot range plus BreakBuffer alone; movedAway belongs to the
        // Flip path only. The reference build gated both behind movedAway, which
        // silently dropped every immediate reclaim.
        bool invalidatedPriority = f_anyFvgInvalidatedThisBar(e, bs)
        bool reclaim = oldSide == SIDE_SUPPORT ? f_ge(f.baseClose, bs.rangeTop + c.breakBuffer, c.mintick) : f_le(f.baseClose, bs.rangeBottom - c.breakBuffer, c.mintick)
        if reclaim and not invalidatedPriority
            oldV.breakSnapshot.valid := false
            newV.breakSnapshot.valid := false
            oldV.eligible := oldV.hasNonPsychRoot
            bool armedNow = oldSide == SIDE_SUPPORT ? f_ge(f.baseClose, oldV.effectiveTop + c.touchResetDistance, c.mintick) : f_le(f.baseClose, oldV.effectiveBottom - c.touchResetDistance, c.mintick)
            oldV.history.phase := armedNow ? PH_ARMED : PH_WAITING
            oldV.history.armedFromSeq := armedNow ? f.baseSeq + 1 : na
            if armedNow
                oldV.history.lastArmedRangeBottom := oldV.effectiveBottom
                oldV.history.lastArmedRangeTop := oldV.effectiveTop
            oldV.history.grade := f_gradeFor(oldV, c, false)
            newV.eligible := newV.hasNonPsychRoot
            newV.history.phase := PH_WAITING
            newV.history.grade := newV.hasNonPsychRoot ? f_gradeFor(newV, c, false) : GR_UNAVAILABLE
            f_emit(e, EV_RECLAIM, f, z.coreId, z.generationId, oldSide, bs.rangeBottom, bs.rangeTop, 0, oldV.history.grade, f_weakReason(oldV.history), 0)
        else if wasMoved
            // Flip keeps its movedAway precondition: a flip requires the market to
            // have left the broken range and then come back to retest it.
            bool recontact = f_intersects(f.baseLow, f.baseHigh, bs.rangeBottom, bs.rangeTop, c.mintick)
            bool flipConfirm = oldSide == SIDE_SUPPORT ? f_le(f.baseClose, bs.rangeBottom, c.mintick) : f_ge(f.baseClose, bs.rangeTop, c.mintick)
            if recontact
                if flipConfirm
                    int newSide = -oldSide
                    oldV.history.phase := PH_BROKEN
                    oldV.history.grade := GR_UNAVAILABLE
                    newV.eligible := newV.hasNonPsychRoot
                    newV.history.phase := PH_WAITING
                    newV.history.armedFromSeq := na
                    newV.history.grade := f_gradeFor(newV, c, false)
                    oldV.breakSnapshot.valid := false
                    newV.breakSnapshot.valid := false
                    newV.history.lastFlipConfirmSeq := f.baseSeq
                    f_emit(e, EV_FLIP_CONFIRM, f, z.coreId, z.generationId, newSide, bs.rangeBottom, bs.rangeTop, 0, newV.history.grade, f_weakReason(newV.history), 0)
                else
                    newV.history.flipAttemptCount += 1
                    bs.retestSeen := true
                    oldV.breakSnapshot.retestSeen := true
                    newV.breakSnapshot.retestSeen := true
                    f_emit(e, EV_FLIP_ATTEMPT, f, z.coreId, z.generationId, -oldSide, bs.rangeBottom, bs.rangeTop, 0, GR_UNAVAILABLE, WEAK_NONE, 0)
    true

f_startNewGeneration(ZoneEngine e, ZoneCore z, ZoneFeed f, ZoneCfg c) =>
    array.push(e.endedGenerations, EndedGeneration.new(coreId = z.coreId, generationId = z.generationId, endedTime = f.baseCloseTime,
        supportTouches = z.supportView.history.sideTouchCount, resistanceTouches = z.resistanceView.history.sideTouchCount,
        supportWeakReason = f_weakReason(z.supportView.history), resistanceWeakReason = f_weakReason(z.resistanceView.history)))
    while array.size(e.endedGenerations) > c.maxEndedGenerations
        array.shift(e.endedGenerations)
    z.generationId := e.nextGenerationId
    e.nextGenerationId += 1
    z.zoneFresh := true
    z.supportView.history := f_emptyHistory()
    z.resistanceView.history := f_emptyHistory()
    z.supportView.touchSnapshot := f_emptyTouchSnapshot()
    z.resistanceView.touchSnapshot := f_emptyTouchSnapshot()
    z.supportView.breakSnapshot := f_emptyBreakSnapshot()
    z.resistanceView.breakSnapshot := f_emptyBreakSnapshot()
    z.generationStartCategoryMask := z.generationCandidateMask
    z.lastTouchCategoryMask := 0
    z.lastBreakCategoryMask := 0
    z.lastTouchTime := na
    z.pendingGeneration := false
    z.generationCandidateAway := false
    z.generationCandidateArmedFromSeq := na
    z.generationCandidateMask := 0
    z.generationCandidateSide := SIDE_NONE
    f_emit(e, EV_GENERATION_START, f, z.coreId, z.generationId, SIDE_NONE, z.physicalBottom, z.physicalTop, 0, GR_UNAVAILABLE, WEAK_NONE, 0)
    true

f_processGeneration(ZoneEngine e, ZoneCore z, ZoneFeed f, ZoneCfg c) =>
    if z.pendingGeneration
        bool active = z.supportView.history.phase == PH_ACTIVE_TOUCH or z.resistanceView.history.phase == PH_ACTIVE_TOUCH
        if not active
            if not z.generationCandidateAway and not na(z.generationCandidateBottom)
                bool awaySup = f_ge(f.baseClose, z.generationCandidateTop + c.touchResetDistance, c.mintick)
                bool awayRes = f_le(f.baseClose, z.generationCandidateBottom - c.touchResetDistance, c.mintick)
                if awaySup or awayRes
                    z.generationCandidateAway := true
                    z.generationCandidateArmedFromSeq := f.baseSeq + 1
            else if z.generationCandidateAway and f.baseSeq >= z.generationCandidateArmedFromSeq
                bool cross = f_intersects(f.baseLow, f.baseHigh, z.generationCandidateBottom, z.generationCandidateTop, c.mintick)
                if cross
                    f_startNewGeneration(e, z, f, c)
    true

// FIX 22.7. When a new-generation candidate has left by ResetDistance and now
// re-approaches, the generation switches BEFORE the contact is evaluated, so the
// contact is recorded as Generation N, Touch 1. The reference build ran the
// generation check after Touch detection, so the re-contact was counted as the
// old generation's next Touch and the new generation started one Touch late.
f_processGenerationReapproach(ZoneEngine e, ZoneCore z, ZoneFeed f, ZoneCfg c) =>
    if z.pendingGeneration and z.generationCandidateAway and not na(z.generationCandidateArmedFromSeq) and f.baseSeq >= z.generationCandidateArmedFromSeq
        bool active = z.supportView.history.phase == PH_ACTIVE_TOUCH or z.resistanceView.history.phase == PH_ACTIVE_TOUCH
        if not active and not na(z.generationCandidateBottom)
            if f_intersects(f.baseLow, f.baseHigh, z.generationCandidateBottom, z.generationCandidateTop, c.mintick)
                int candidateSide = z.generationCandidateSide
                f_startNewGeneration(e, z, f, c)
                // Section 29. Only the Side that became the candidate is armed
                // from THIS bar, so the contact is that Side's Touch 1. The
                // opposite Side stays Waiting.
                SideViewState gv = candidateSide == SIDE_SUPPORT ? z.supportView : z.resistanceView
                if candidateSide != SIDE_NONE and gv.eligible and not na(gv.effectiveBottom)
                    gv.history.phase := PH_ARMED
                    gv.history.armedFromSeq := f.baseSeq
                    gv.history.lastArmedRangeBottom := gv.effectiveBottom
                    gv.history.lastArmedRangeTop := gv.effectiveTop
    true

f_viewInverseConfirmedThisBar(ZoneEngine e, SideViewState v) =>
    bool yes = false
    int en = array.size(e.events)
    if en > 0
        for i = 0 to en - 1
            ZoneEvent ev = array.get(e.events, i)
            if ev.eventType == EV_INVERSE_CONFIRM and f_arrayHasInt(v.rootIds, ev.rootId)
                yes := true
                break
    yes

f_refreshArmDormant(ZoneEngine e, ZoneCore z, SideViewState v, int side, ZoneFeed f, ZoneCfg c) =>
    if v.hasNonPsychRoot and v.eligible and v.history.phase != PH_ACTIVE_TOUCH and v.history.phase != PH_BROKEN and v.history.phase != PH_FLIP_WAIT
        float d = f_lt(f.baseClose, v.effectiveBottom, c.mintick) ? v.effectiveBottom - f.baseClose : f_gt(f.baseClose, v.effectiveTop, c.mintick) ? f.baseClose - v.effectiveTop : 0.0
        if d > c.dormantDistance and not z.pendingTopology and not z.pendingGeneration
            v.history.phase := PH_DORMANT
            v.history.grade := f_gradeFor(v, c, false)
        else
            if v.history.phase == PH_DORMANT
                v.history.phase := PH_WAITING
            bool confirmationBar = v.history.lastFlipConfirmSeq == f.baseSeq or f_viewInverseConfirmedThisBar(e, v)
            bool reset = not confirmationBar and (side == SIDE_SUPPORT ? f_ge(f.baseClose, v.effectiveTop + c.touchResetDistance, c.mintick) : f_le(f.baseClose, v.effectiveBottom - c.touchResetDistance, c.mintick))
            if v.history.phase == PH_WAITING and reset
                v.history.phase := PH_ARMED
                v.history.armedFromSeq := f.baseSeq + 1
                v.history.lastArmedRangeBottom := v.effectiveBottom
                v.history.lastArmedRangeTop := v.effectiveTop
            else if v.history.phase == PH_ARMED
                v.history.lastArmedRangeBottom := v.effectiveBottom
                v.history.lastArmedRangeTop := v.effectiveTop
            v.history.upcomingTouchNo := v.history.sideTouchCount + 1
            v.history.grade := f_gradeFor(v, c, false)
    true

// ============================================================================
// Phases J-early, A, B, C. Sections 8-12: each phase walks ONLY its own work
// set. liveCoreSlots is never iterated here.
// ============================================================================
f_processExistingState(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    // J (early): a pending new generation that is re-approached now takes effect
    // before any Touch is counted (FIX 22.7).
    array<int> genSnap = f_snapshotSet(e, e.generationWatchSlots)
    int gn = array.size(genSnap)
    if gn > 0
        for k = 0 to gn - 1
            int slot = array.get(genSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processGenerationReapproach(e, z, f, c)
                f_syncCoreSets(e, slot, c)

    // A/B: only Views that were Armed before this bar may start a Touch or a
    // GapBreak. Waiting, Dormant, Broken and ActiveTouch Cores are not searched.
    array<int> armSup = f_snapshotSet(e, e.armedSupportSlots)
    int an = array.size(armSup)
    if an > 0
        for k = 0 to an - 1
            int slot = array.get(armSup, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processArmedSide(e, z, z.supportView, z.resistanceView, SIDE_SUPPORT, f, c)
                f_syncCoreSets(e, slot, c)

    array<int> armRes = f_snapshotSet(e, e.armedResistanceSlots)
    int rn = array.size(armRes)
    if rn > 0
        for k = 0 to rn - 1
            int slot = array.get(armRes, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processArmedSide(e, z, z.resistanceView, z.supportView, SIDE_RESISTANCE, f, c)
                f_syncCoreSets(e, slot, c)

    // C: running episodes, evaluated against their frozen TouchStartSnapshot.
    array<int> actSnap = f_snapshotSet(e, e.activeTouchSlots)
    int cn = array.size(actSnap)
    if cn > 0
        for k = 0 to cn - 1
            int slot = array.get(actSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processActiveSide(e, z, z.supportView, z.resistanceView, SIDE_SUPPORT, f, c)
                f_processActiveSide(e, z, z.resistanceView, z.supportView, SIDE_RESISTANCE, f, c)
                f_syncCoreSets(e, slot, c)
    true

f_refreshLiveEligibility(ZoneEngine e, ZoneCfg c) =>
    int cn = array.size(e.liveCoreSlots)
    if cn > 0
        for ci = 0 to cn - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, ci))
            for side = SIDE_RESISTANCE to SIDE_SUPPORT
                if side != SIDE_NONE
                    SideViewState v = side == SIDE_SUPPORT ? z.supportView : z.resistanceView
                    bool hasLive = false
                    int rn = array.size(v.rootIds)
                    if rn > 0
                        for k = 0 to rn - 1
                            Root r = f_getRoot(e, array.get(v.rootIds, k))
                            if not na(r) and r.category != CAT_PSYCH and f_categoryEnabled(r.category, c) and f_rootEligibleSide(r, side)
                                hasLive := true
                                break
                    v.hasNonPsychRoot := hasLive or v.history.phase == PH_BROKEN or v.history.phase == PH_FLIP_WAIT
                    bool transitionWait = v.history.phase == PH_BROKEN or v.history.phase == PH_FLIP_WAIT
                    v.eligible := hasLive and not transitionWait
                    if not hasLive and not transitionWait
                        v.history.grade := GR_UNAVAILABLE
    true

// ============================================================================
// Phases I, J, K. Sections 11, 12, 19: Break / Flip / Reclaim from the break
// set, Generation from the generation set, Arm / Dormant refresh from the
// waiting set, and the Dormant set only when the aggregate corridor is reached.
// ============================================================================
f_processPostRootTransitions(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    // I: Break / Flip / Reclaim.
    array<int> brkSnap = f_snapshotSet(e, e.brokenFlipWaitSlots)
    int bn = array.size(brkSnap)
    if bn > 0
        for k = 0 to bn - 1
            int slot = array.get(brkSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processBreakWait(e, z, SIDE_SUPPORT, f, c)
                f_processBreakWait(e, z, SIDE_RESISTANCE, f, c)
                f_syncCoreSets(e, slot, c)

    // J: generation candidates only.
    array<int> genSnap = f_snapshotSet(e, e.generationWatchSlots)
    int gn = array.size(genSnap)
    if gn > 0
        for k = 0 to gn - 1
            int slot = array.get(genSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_processGeneration(e, z, f, c)
                f_syncCoreSets(e, slot, c)

    // FIX 22.4 safety net, now bounded to Cores that actually hold pending work.
    array<int> pendSnap = f_snapshotSet(e, e.pendingTopoSlots)
    int pn = array.size(pendSnap)
    if pn > 0
        for k = 0 to pn - 1
            int slot = array.get(pendSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_flushPendingTopologyIfIdle(e, z, c)
                f_syncCoreSets(e, slot, c)

    // K: next-bar Phase / Grade / Armed for the quiet Cores.
    array<int> waitSnap = f_snapshotSet(e, e.waitingSlots)
    int wn = array.size(waitSnap)
    if wn > 0
        for k = 0 to wn - 1
            int slot = array.get(waitSnap, k)
            ZoneCore z = array.get(e.cores, slot)
            if z.alive
                f_refreshArmDormant(e, z, z.supportView, SIDE_SUPPORT, f, c)
                f_refreshArmDormant(e, z, z.resistanceView, SIDE_RESISTANCE, f, c)
                f_syncCoreSets(e, slot, c)

    // Section 19. Dormant Cores are parked behind a price corridor. While the
    // bar stays strictly inside the aggregate guard, not one of them is walked.
    bool dormantMayWake = not e.dormantGuardValid
    if e.dormantGuardValid
        bool belowHit = not na(e.dormantGuardLow) and f.baseLow <= e.dormantGuardLow
        bool aboveHit = not na(e.dormantGuardHigh) and f.baseHigh >= e.dormantGuardHigh
        dormantMayWake := belowHit or aboveHit
    if dormantMayWake and array.size(e.dormantSlots) > 0
        array<int> dorSnap = f_snapshotSet(e, e.dormantSlots)
        int dn = array.size(dorSnap)
        if dn > 0
            for k = 0 to dn - 1
                int slot = array.get(dorSnap, k)
                ZoneCore z = array.get(e.cores, slot)
                if z.alive
                    f_refreshArmDormant(e, z, z.supportView, SIDE_SUPPORT, f, c)
                    f_refreshArmDormant(e, z, z.resistanceView, SIDE_RESISTANCE, f, c)
                    f_syncCoreSets(e, slot, c)
    if dormantMayWake
        f_rebuildDormantGuard(e, f.baseClose)

    e.pendingTopologyCount := array.size(e.pendingTopoSlots)
    e.pendingGenerationCount := array.size(e.generationWatchSlots)
    true

// ============================================================================
// Storage pruning. Protected cores are never deleted. Root pruning only removes
// unreferenced, oldest roots; protected references remain even above target.
// ============================================================================
f_rootReferenced(ZoneEngine e, int rootId) =>
    bool ref = false
    Root rr = f_getRoot(e, rootId)
    if not na(rr) and rr.state == ROOT_INVERSE_WAIT
        ref := true
    int cn = array.size(e.liveCoreSlots)
    if cn > 0
        for k = 0 to cn - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            if f_arrayHasInt(z.originRootIds, rootId) or f_arrayHasInt(z.supportView.rootIds, rootId) or f_arrayHasInt(z.resistanceView.rootIds, rootId)
                ref := true
                break
    ref

f_countCategoryRoots(ZoneEngine e, int cat) =>
    cat == CAT_SWING ? array.size(e.swingSlots) : cat == CAT_ACCUM ? array.size(e.accumSlots) : cat == CAT_TIME_HL ? array.size(e.timeSlots) : cat == CAT_FVG ? array.size(e.fvgSlots) : 0

f_pruneCategory(ZoneEngine e, int cat, int maxCount, ZoneCfg c) =>
    if c.countersOn
        e.rootFullScanCount += 1
    int cnt = f_countCategoryRoots(e, cat)
    while cnt > maxCount
        int oldestId = na
        int oldestTime = na
        int n = array.size(e.roots)
        if n > 0
            for i = 0 to n - 1
                Root r = array.get(e.roots, i)
                if r.alive and r.category == cat and not r.isDynamic and not f_rootReferenced(e, r.rootId)
                    if na(oldestTime) or r.confirmedTime < oldestTime
                        oldestTime := r.confirmedTime
                        oldestId := r.rootId
        if na(oldestId)
            break
        f_retireRoot(e, oldestId, c)
        e.storagePruned := true
        e.prunedRootCount += 1
        cnt -= 1
    true

f_countAccumPairs(ZoneEngine e) =>
    // Every confirmed Accum box registers exactly two live boundaries and pair
    // retirement is atomic, so the live pair count is half the live slot count.
    int(math.floor(array.size(e.accumSlots) * 0.5))

f_pruneAccumPairs(ZoneEngine e, int maxBoxes, ZoneCfg c) =>
    int boxCount = f_countAccumPairs(e)
    while boxCount > maxBoxes
        int victimPair = na
        int victimTime = na
        int n = array.size(e.accumSlots)
        if n > 0
            for i = 0 to n - 1
                Root r = array.get(e.roots, array.get(e.accumSlots, i))
                if r.alive and r.pairKey != 0
                    bool pairProtected = false
                    int pairTime = r.confirmedTime
                    for j = 0 to n - 1
                        Root q = array.get(e.roots, array.get(e.accumSlots, j))
                        if q.alive and q.pairKey == r.pairKey
                            pairProtected := pairProtected or f_rootReferenced(e, q.rootId)
                            pairTime := math.min(pairTime, q.confirmedTime)
                    if not pairProtected and (na(victimTime) or pairTime < victimTime)
                        victimTime := pairTime
                        victimPair := r.pairKey
        if na(victimPair)
            break
        var array<int> removeIds = array.new<int>()
        array.clear(removeIds)
        int rn = array.size(e.accumSlots)
        if rn > 0
            for i = 0 to rn - 1
                Root r = array.get(e.roots, array.get(e.accumSlots, i))
                if r.alive and r.pairKey == victimPair
                    array.push(removeIds, r.rootId)
        int dn = array.size(removeIds)
        if dn > 0
            for i = 0 to dn - 1
                f_retireRoot(e, array.get(removeIds, i), c)
                e.prunedRootCount += 1
        e.storagePruned := true
        boxCount -= 1
    true

f_pruneStorage(ZoneEngine e, ZoneFeed f, ZoneCfg c) =>
    f_pruneCategory(e, CAT_SWING, c.maxSwingRoots, c)
    f_pruneCategory(e, CAT_FVG, c.maxFvgRoots, c)
    f_pruneCategory(e, CAT_TIME_HL, c.maxTimeRoots, c)
    // Accum pair is pruned atomically; never delete only one boundary.
    f_pruneAccumPairs(e, c.maxAccumBoxes, c)
    while e.liveCoreCount > c.maxZoneCores
        int victim = na
        int oldest = na
        int n = array.size(e.liveCoreSlots)
        bool hasDormantVictim = false
        if n > 0
            for k = 0 to n - 1
                int slot = array.get(e.liveCoreSlots, k)
                ZoneCore z = array.get(e.cores, slot)
                if not f_isProtectedCore(e, z)
                    bool dormant = z.supportView.history.phase == PH_DORMANT or z.resistanceView.history.phase == PH_DORMANT
                    hasDormantVictim := hasDormantVictim or dormant
            for k = 0 to n - 1
                int slot = array.get(e.liveCoreSlots, k)
                ZoneCore z = array.get(e.cores, slot)
                if not f_isProtectedCore(e, z)
                    bool dormant = z.supportView.history.phase == PH_DORMANT or z.resistanceView.history.phase == PH_DORMANT
                    if dormant == hasDormantVictim
                        int rootN = array.size(z.originRootIds)
                        if na(oldest) or z.lastSeenTime < oldest or (z.lastSeenTime == oldest and not na(victim) and rootN < array.size(array.get(e.cores, victim).originRootIds))
                            oldest := z.lastSeenTime
                            victim := slot
        if na(victim)
            break
        ZoneCore vz = array.get(e.cores, victim)
        f_emit(e, EV_STORAGE_PRUNE, f, vz.coreId, vz.generationId, SIDE_NONE, vz.physicalBottom, vz.physicalTop, 0, GR_UNAVAILABLE, WEAK_NONE, 0)
        f_retireCoreSlot(e, victim, c)
        e.storagePruned := true
        e.prunedZoneCount += 1

    // If a limit could not be satisfied because all candidates are protected,
    // keep checking on later bars. Otherwise skip the full storage scans until
    // another Root/Core allocation marks storageCheckDirty again.
    bool stillOver = f_countCategoryRoots(e, CAT_SWING) > c.maxSwingRoots
    stillOver := stillOver or f_countCategoryRoots(e, CAT_FVG) > c.maxFvgRoots
    stillOver := stillOver or f_countCategoryRoots(e, CAT_TIME_HL) > c.maxTimeRoots
    stillOver := stillOver or f_countAccumPairs(e) > c.maxAccumBoxes
    stillOver := stillOver or e.liveCoreCount > c.maxZoneCores
    e.storageCheckDirty := stillOver
    true

// ============================================================================
// Confirmed 5-minute update entrypoint
// ============================================================================
export updateConfirmedBase(ZoneEngine e, ZoneCfg c, ZoneFeed f) =>
    bool cfgChanged = na(e.lastCfgRevision) or e.lastCfgRevision != c.revision or na(e.lastCfgMintick) or e.lastCfgMintick != c.mintick
    if cfgChanged
        [cfgOk, cfgErr] = validateCfg(c)
        e.configValid := cfgOk
        e.configError := cfgErr
        e.lastCfgRevision := c.revision
        e.lastCfgMintick := c.mintick
    bool ok = e.configValid
    bool updated = false
    if ok and f.baseConfirmed and (na(e.lastBaseOpenTime) or f.baseOpenTime != e.lastBaseOpenTime)
        updated := true
        array.clear(e.events)
        e.storagePruned := false
        e.prunedRootCount := 0
        e.prunedZoneCount := 0

        // Gate mapped higher-timeframe data so the same confirmed source bar is
        // processed exactly once. request.security(..., gaps_off) repeats the last
        // mapped source value across Base bars; the previous implementation
        // re-scanned Roots on every 5m bar even when the source bar had not changed.
        int src15EventTime = na
        if not na(f.swing15m)
            if not na(f.swing15m.highConfirmedTime)
                src15EventTime := f.swing15m.highConfirmedTime
            if not na(f.swing15m.lowConfirmedTime)
                src15EventTime := na(src15EventTime) ? f.swing15m.lowConfirmedTime : math.max(src15EventTime, f.swing15m.lowConfirmedTime)

        int src1hTime = na
        int src4hTime = na
        int src1dTime = na
        if not na(f.oneHour) and not na(f.oneHour.fvg)
            src1hTime := f.oneHour.fvg.sourceCloseTime
        if not na(f.fourHour) and not na(f.fourHour.fvg)
            src4hTime := f.fourHour.fvg.sourceCloseTime
        if not na(f.oneDay) and not na(f.oneDay.fvg)
            src1dTime := f.oneDay.fvg.sourceCloseTime

        bool new15Event = not na(src15EventTime) and src15EventTime <= f.baseCloseTime and (na(e.lastSource15mTime) or src15EventTime > e.lastSource15mTime)
        bool new1h = not na(src1hTime) and src1hTime <= f.baseCloseTime and (na(e.lastSource1hTime) or src1hTime > e.lastSource1hTime)
        bool new4h = not na(src4hTime) and src4hTime <= f.baseCloseTime and (na(e.lastSource4hTime) or src4hTime > e.lastSource4hTime)
        bool new1d = not na(src1dTime) and src1dTime <= f.baseCloseTime and (na(e.lastSource1dTime) or src1dTime > e.lastSource1dTime)

        // A-D. Existing prior-bar state is resolved before current-bar Roots exist.
        f_processExistingState(e, f, c)

        // E. Root structural facts. Native-TF FVG invalidation is applied before
        // Reclaim/Flip resolution so invalidation wins when simultaneous.
        // FIX 22.8. Phase D (Base-timeframe FVG state machines) runs BEFORE phase F
        // (structural invalidation from a newly confirmed source bar). The
        // reference build invalidated first and then immediately advanced the
        // InverseWait machine, so a Root that became InverseWait on this bar had
        // movedAway / retest / inverseConfirm evaluated against the very Close
        // that invalidated it. A new InverseWait now starts advancing from the
        // NEXT Base bar, as the processing order requires.
        if c.enableFVG
            f_updateFvgFresh(e, f, c)
            f_updateInverseWait(e, f, c)

            if new1h
                f_invalidateFvgsForSource(e, f.oneHour.fvg, f, c)
            if new4h
                f_invalidateFvgsForSource(e, f.fourHour.fvg, f, c)
            if new1d
                f_invalidateFvgsForSource(e, f.oneDay.fvg, f, c)

        if c.enableMA
            f_ensureMA(e, c, f)

        if c.enableSwing
            f_ingestSwingPack(e, f.swing5m, TF_5M, f.baseSeq, f.baseCloseTime, c)
            if new15Event
                f_ingestSwingPack(e, f.swing15m, TF_15M, f.baseSeq, f.baseCloseTime, c)
            if new1h
                f_ingestSwingPack(e, f.oneHour.swing, TF_1H, f.baseSeq, f.baseCloseTime, c)

        if c.enableAccum
            if new1h
                f_ingestAccumPack(e, f.oneHour.accum, f.baseSeq, f.baseCloseTime, c)
            if new4h
                f_ingestAccumPack(e, f.fourHour.accum, f.baseSeq, f.baseCloseTime, c)
            if new1d
                f_ingestAccumPack(e, f.oneDay.accum, f.baseSeq, f.baseCloseTime, c)

        if c.enableFVG
            if new1h
                f_ingestFvgPack(e, f.oneHour.fvg, f.baseSeq, f.baseCloseTime, c)
            if new4h
                f_ingestFvgPack(e, f.fourHour.fvg, f.baseSeq, f.baseCloseTime, c)
            if new1d
                f_ingestFvgPack(e, f.oneDay.fvg, f.baseSeq, f.baseCloseTime, c)

        if c.enableTimeHL
            f_updateTimeHL(e, f, c)

        // Record source adoption after all processing for this Base bar.
        if new15Event
            e.lastSource15mTime := src15EventTime
        if new1h
            e.lastSource1hTime := src1hTime
        if new4h
            e.lastSource4hTime := src4hTime
        if new1d
            e.lastSource1dTime := src1dTime

        // F. Root eligibility changes only when a participating Root is retired
        // or an FVG changes structural direction/state. MA price movement alone
        // does not require a full Core × Root eligibility scan.
        if e.eligibilityDirty
            f_refreshLiveEligibility(e, c)
            e.eligibilityDirty := false

        // G-H. Dirty-local topology rebuild; active touch shapes are deferred.
        //
        // FAST PATH vs SLOW PATH. topologyDirty is set only by a real Root change
        // (added, removed, moved across a relationship boundary, quality,
        // direction or label change). With the MA Fast Path active, an ordinary
        // Base bar leaves it false and no candidate search runs at all.
        bool slowPath = e.topologyDirty
        f_rebuildDirtyTopology(e, f, c)

        // Slow Path only (sections 3, 6, 17, 18): resync the work sets, rebuild
        // the EMA -> Core reverse index, and rebuild each EMA Topology Guard.
        // None of this runs on a Fast Path bar.
        if slowPath
            int csn = array.size(e.liveCoreSlots)
            if csn > 0
                for ci = 0 to csn - 1
                    f_syncCoreSets(e, array.get(e.liveCoreSlots, ci), c)
            f_rebuildEmaCoreIndex(e)
            e.dormantGuardValid := false
            if c.enableMA
                Root ema2 = f_getRoot(e, ROOT_ID_EMA2000)
                if not na(ema2)
                    f_buildEmaGuard(e, ema2, c)
                Root ema3 = f_getRoot(e, ROOT_ID_EMA3000)
                if not na(ema3)
                    f_buildEmaGuard(e, ema3, c)

        // I. Break/Flip/Reclaim/Generation and next-bar Armed state.
        f_processPostRootTransitions(e, f, c)

        // J. Safe storage cleanup only after all current-bar references settle.
        // Full category scans are skipped while storage is known to be within limits.
        if e.storageCheckDirty
            f_pruneStorage(e, f, c)

        if c.countersOn
            e.baseBarsProcessed += 1
            if slowPath
                e.slowPathBars += 1
            else
                e.fastPathBars += 1
            // A No-op Base Bar produced no event and touched no topology.
            bool sourceEvent = new15Event or new1h or new4h or new1d
            if not slowPath and array.size(e.events) == 0 and not sourceEvent
                e.noOpBars += 1
            e.maxLiveRoots := math.max(e.maxLiveRoots, e.liveRootCount)
            e.maxLiveCores := math.max(e.maxLiveCores, e.liveCoreCount)
            e.coresVisitedLast := array.size(e.liveCoreSlots)

        e.lastBaseOpenTime := f.baseOpenTime
        e.lastBaseSeq := f.baseSeq
    updated

// ============================================================================
// Read-only API
// ============================================================================
f_rootSummary(ZoneEngine e, array<int> ids) =>
    string s = ""
    int n = array.size(ids)
    if n > 0
        for i = 0 to n - 1
            Root r = f_getRoot(e, array.get(ids, i))
            if not na(r)
                string tag = r.category == CAT_MA ? "MA" : r.category == CAT_SWING ? "SW" : r.category == CAT_ACCUM ? "AC" : r.category == CAT_TIME_HL ? "TH" : r.category == CAT_FVG ? "FVG" : "PSY"
                s += (str.length(s) == 0 ? "" : ",") + tag + "#" + str.tostring(r.rootId)
    s

f_makeView(ZoneEngine e, ZoneCore z, int side) =>
    SideViewState v = side == SIDE_SUPPORT ? z.supportView : z.resistanceView
    ZoneView.new(coreId = z.coreId, generationId = z.generationId, side = side,
        effectiveBottom = v.effectiveBottom, effectiveTop = v.effectiveTop, referencePrice = v.referencePrice,
        phase = v.history.phase, grade = v.history.grade, cCount = v.cCount, hCount = v.hCount, density = v.density,
        baseStrong = v.baseStrong, currentTouchNo = v.history.currentTouchNo, upcomingTouchNo = v.history.upcomingTouchNo,
        zoneFresh = z.zoneFresh, sideFresh = v.history.sideFresh, weakReason = f_weakReason(v.history), maxDepthPct = v.history.maxDepthPct,
        isBroadContext = v.isBroadContext, fvgDirectionMask = v.fvgDirectionMask, fvgRootCount = v.fvgRootCount,
        fvgFreshCount = v.fvgFreshCount, fvgStructuralStateMask = v.fvgStructuralStateMask, eligible = v.eligible)

export viewCount(ZoneEngine e) =>
    int cnt = 0
    int n = array.size(e.liveCoreSlots)
    if n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            if z.supportView.hasNonPsychRoot or z.supportView.history.phase == PH_ACTIVE_TOUCH or z.supportView.history.phase == PH_BROKEN or z.supportView.history.phase == PH_FLIP_WAIT
                cnt += 1
            if z.resistanceView.hasNonPsychRoot or z.resistanceView.history.phase == PH_ACTIVE_TOUCH or z.resistanceView.history.phase == PH_BROKEN or z.resistanceView.history.phase == PH_FLIP_WAIT
                cnt += 1
    cnt

export viewAt(ZoneEngine e, int index) =>
    ZoneView out = na
    int ordinal = 0
    int n = array.size(e.liveCoreSlots)
    if index >= 0 and n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            bool hasS = z.supportView.hasNonPsychRoot or z.supportView.history.phase == PH_ACTIVE_TOUCH or z.supportView.history.phase == PH_BROKEN or z.supportView.history.phase == PH_FLIP_WAIT
            bool hasR = z.resistanceView.hasNonPsychRoot or z.resistanceView.history.phase == PH_ACTIVE_TOUCH or z.resistanceView.history.phase == PH_BROKEN or z.resistanceView.history.phase == PH_FLIP_WAIT
            if hasS
                if ordinal == index
                    out := f_makeView(e, z, SIDE_SUPPORT)
                    break
                ordinal += 1
            if hasR
                if ordinal == index
                    out := f_makeView(e, z, SIDE_RESISTANCE)
                    break
                ordinal += 1
    out

export viewRootSummary(ZoneEngine e, int index) =>
    string out = ""
    int ordinal = 0
    int n = array.size(e.liveCoreSlots)
    if index >= 0 and n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            bool hasS = z.supportView.hasNonPsychRoot or z.supportView.history.phase == PH_ACTIVE_TOUCH or z.supportView.history.phase == PH_BROKEN or z.supportView.history.phase == PH_FLIP_WAIT
            bool hasR = z.resistanceView.hasNonPsychRoot or z.resistanceView.history.phase == PH_ACTIVE_TOUCH or z.resistanceView.history.phase == PH_BROKEN or z.resistanceView.history.phase == PH_FLIP_WAIT
            if hasS
                if ordinal == index
                    out := f_rootSummary(e, z.supportView.rootIds)
                    break
                ordinal += 1
            if hasR
                if ordinal == index
                    out := f_rootSummary(e, z.resistanceView.rootIds)
                    break
                ordinal += 1
    out

export eventCount(ZoneEngine e) => array.size(e.events)
export eventAt(ZoneEngine e, int index) => index >= 0 and index < array.size(e.events) ? array.get(e.events, index) : na
export rootCount(ZoneEngine e) => e.liveRootCount
export rootAt(ZoneEngine e, int ordinal) =>
    Root out = na
    int k = 0
    int n = array.size(e.roots)
    if ordinal >= 0 and n > 0
        for i = 0 to n - 1
            Root r = array.get(e.roots, i)
            if r.alive
                if k == ordinal
                    out := r
                    break
                k += 1
    out

export liveCoreCount(ZoneEngine e) => e.liveCoreCount
export candidateCountLast(ZoneEngine e) => e.candidateCountLast
export pendingTopologyCount(ZoneEngine e) => e.pendingTopologyCount
export pendingGenerationCount(ZoneEngine e) => e.pendingGenerationCount
export storagePruned(ZoneEngine e) => e.storagePruned
export prunedRootCount(ZoneEngine e) => e.prunedRootCount
export prunedZoneCount(ZoneEngine e) => e.prunedZoneCount
export touchHistoryTruncated(ZoneEngine e) => e.touchHistoryTruncated
export configValid(ZoneEngine e) => e.configValid
export configError(ZoneEngine e) => e.configError

export sideName(int side) => side == SIDE_SUPPORT ? "Support" : side == SIDE_RESISTANCE ? "Resistance" : "None"
export phaseName(int phase) => phase == PH_WAITING ? "Waiting" : phase == PH_ARMED ? "Armed" : phase == PH_ACTIVE_TOUCH ? "ActiveTouch" : phase == PH_BROKEN ? "Broken" : phase == PH_FLIP_WAIT ? "FlipWait" : phase == PH_DORMANT ? "Dormant" : "?"
export gradeName(int grade) => grade == GR_STRONG ? "Strong" : grade == GR_NEUTRAL ? "Neutral" : grade == GR_WEAK ? "Weak" : "Unavailable"
export densityName(int density) => density == DEN_HIGH ? "High" : density == DEN_NORMAL ? "Normal" : "BroadContext"
export weakReasonName(int reason) => reason == WEAK_BY_TOUCH ? "Touch" : reason == WEAK_BY_DEPTH ? "Depth" : reason == WEAK_BY_BOTH ? "Both" : "None"
export eventName(int typ) => typ == EV_TOUCH_START ? "TouchStart" : typ == EV_TOUCH_RESET ? "TouchReset" : typ == EV_WEAK_DEPTH ? "WeakDepth" : typ == EV_LOCAL_BREAK ? "LocalBreak" : typ == EV_GAP_BREAK ? "GapBreak" : typ == EV_FLIP_ATTEMPT ? "FlipAttempt" : typ == EV_FLIP_CONFIRM ? "FlipConfirm" : typ == EV_RECLAIM ? "Reclaim" : typ == EV_FVG_INVALIDATE ? "FVGInvalidate" : typ == EV_INVERSE_ATTEMPT ? "InverseAttempt" : typ == EV_INVERSE_CONFIRM ? "InverseConfirm" : typ == EV_GENERATION_START ? "GenerationStart" : typ == EV_MERGE ? "Merge" : typ == EV_SPLIT ? "Split" : typ == EV_STORAGE_PRUNE ? "StoragePrune" : "?"
// ---- Performance counters (section 26) ----
export baseBarsProcessed(ZoneEngine e) => e.baseBarsProcessed
export fastPathBars(ZoneEngine e) => e.fastPathBars
export slowPathBars(ZoneEngine e) => e.slowPathBars
export noOpBars(ZoneEngine e) => e.noOpBars
export slowPathPct(ZoneEngine e) => e.baseBarsProcessed > 0 ? e.slowPathBars * 100.0 / e.baseBarsProcessed : 0.0
export noOpPct(ZoneEngine e) => e.baseBarsProcessed > 0 ? e.noOpBars * 100.0 / e.baseBarsProcessed : 0.0
export candidateRebuildCount(ZoneEngine e) => e.candidateRebuildCount
export candidateWindowEvalCount(ZoneEngine e) => e.candidateWindowEvalCount
export rootFullScanCount(ZoneEngine e) => e.rootFullScanCount
export coreFullScanCount(ZoneEngine e) => e.coreFullScanCount
export dirtyBandCount(ZoneEngine e) => e.dirtyBandCount
export maxDirtyBandWidth(ZoneEngine e) => e.maxDirtyBandWidth
export mergeEvalCount(ZoneEngine e) => e.mergeEvalCount
export splitEvalCount(ZoneEngine e) => e.splitEvalCount
export referenceCalcCount(ZoneEngine e) => e.referenceCalcCount
export maFastUpdates(ZoneEngine e) => e.maFastUpdates
export maSlowUpdates(ZoneEngine e) => e.maSlowUpdates
export maxLiveRoots(ZoneEngine e) => e.maxLiveRoots
export maxLiveCores(ZoneEngine e) => e.maxLiveCores
export emaGuardHits(ZoneEngine e) => e.emaGuardHits
export emaGuardBreaches(ZoneEngine e) => e.emaGuardBreaches
export fvgFullScanCount(ZoneEngine e) => e.fvgFullScanCount
export armedSetSize(ZoneEngine e, int side) => side == SIDE_SUPPORT ? array.size(e.armedSupportSlots) : array.size(e.armedResistanceSlots)
export activeTouchSetSize(ZoneEngine e) => array.size(e.activeTouchSlots)
export breakFlipSetSize(ZoneEngine e) => array.size(e.brokenFlipWaitSlots)
export generationWatchSetSize(ZoneEngine e) => array.size(e.generationWatchSlots)
export dormantSetSize(ZoneEngine e) => array.size(e.dormantSlots)
export waitingSetSize(ZoneEngine e) => array.size(e.waitingSlots)
export requestContextCount() => 6
export isFullHistory() => true

// ---- State-set sizes, for the Debug panel (section 38) ----
export armedCount(ZoneEngine e, int side) =>
    int cnt = 0
    int n = array.size(e.liveCoreSlots)
    if n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            SideViewState v = side == SIDE_SUPPORT ? z.supportView : z.resistanceView
            if v.history.phase == PH_ARMED
                cnt += 1
    cnt

export phaseCount(ZoneEngine e, int phase) =>
    int cnt = 0
    int n = array.size(e.liveCoreSlots)
    if n > 0
        for k = 0 to n - 1
            ZoneCore z = array.get(e.cores, array.get(e.liveCoreSlots, k))
            if z.supportView.history.phase == phase
                cnt += 1
            if z.resistanceView.history.phase == phase
                cnt += 1
    cnt

export inverseWaitCount(ZoneEngine e) => array.size(e.inverseWaitSlots)
export freshFvgCount(ZoneEngine e) => array.size(e.freshFvgSlots)
export generationWatchCount(ZoneEngine e) => e.pendingGenerationCount
export lastSource15mTime(ZoneEngine e) => e.lastSource15mTime
export lastSource1hTime(ZoneEngine e) => e.lastSource1hTime
export lastSource4hTime(ZoneEngine e) => e.lastSource4hTime
export lastSource1dTime(ZoneEngine e) => e.lastSource1dTime

export lastBaseOpenTime(ZoneEngine e) => e.lastBaseOpenTime
export lastBaseSeq(ZoneEngine e) => e.lastBaseSeq
export sessionKey(ZoneEngine e) => e.sessionKey
export dayKey(ZoneEngine e) => e.dayKey
export weekKey(ZoneEngine e) => e.weekKey

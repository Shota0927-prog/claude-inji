// © ka.mickey15
//
// ============================================================
//  日足ボラティリティ 年別集計インジケーター (XAUUSD)
// ------------------------------------------------------------
//  目的 :
//    日足1本ごとの実際の高安幅 (dailyRange = dailyHigh - dailyLow) を
//    「年別」に集計し、年によってボラティリティ分布がどう変化して
//    いるかを確認する集計専用ツール。
//
//  ★ 既存ストラテジー・既存インジケーターは一切変更しない。独立した別物。
//
//  集計値 (ATRではなく固定ドル値の実高安幅) :
//     dailyRange = dailyHigh - dailyLow
//   ・下位足 (5分足等) でも request.security で確定済み日足の H/L を取得。
//   ・lookahead = barmerge.lookahead_off で未来参照/リペイントを防止。
//   ・日付が変わったタイミングで前日足を「1回だけ」集計 (重複防止)。
//   ・日足チャートでも正常動作。
//
//  ※ overlay = false。
// ============================================================

//@version=5
indicator(
     title      = "日足ボラ 年別集計 (XAUUSD)",
     shorttitle = "Daily Vol/Year",
     overlay    = false,
     max_bars_back = 500,
     max_labels_count = 200
 )

// ============================================================
//  1. 入力 : 集計対象期間 (年単位)
// ------------------------------------------------------------
//  指定年範囲 / 直近N年間 の2モード。年は日足バーの年で判定。
// ============================================================
grpPeriod = "集計対象期間 (年)"
periodMode      = input.string("直近N年間", "期間モード", options = ["指定年範囲", "直近N年間"], group = grpPeriod)
startYear       = input.int(2020, "開始年 (指定年範囲)", minval = 1970, maxval = 2100, group = grpPeriod)
useCurrentAsEnd = input.bool(true, "終了年を現在年にする", group = grpPeriod)
endYearManual   = input.int(2025, "終了年 (現在年を使わない時)", minval = 1970, maxval = 2100, group = grpPeriod)
recentYears     = input.int(5, "直近年数 (直近N年間)", minval = 1, maxval = 100, group = grpPeriod)

// ============================================================
//  2. 入力 : ボラ帯 ランク境界 (固定ドル値)
// ------------------------------------------------------------
//  R1:<b1 / R2:b1〜b2 / R3:b2〜b3 / R4:b3〜b4 / R5:>=b4
//  必ず b1 < b2 < b3 < b4。不正ならランク集計を行わず警告表示。
// ============================================================
grpRank = "ボラ帯 ランク境界"
dailyBound1 = input.float(30.0,  "境界1 ($)", minval = 0.0, step = 1.0, group = grpRank)
dailyBound2 = input.float(50.0,  "境界2 ($)", minval = 0.0, step = 1.0, group = grpRank)
dailyBound3 = input.float(70.0,  "境界3 ($)", minval = 0.0, step = 1.0, group = grpRank)
dailyBound4 = input.float(100.0, "境界4 ($)", minval = 0.0, step = 1.0, group = grpRank)

// ============================================================
//  3. 入力 : 年別比較テーブル
// ============================================================
grpYearTbl = "年別比較テーブル"
showYearTable   = input.bool(true, "年別比較テーブルを表示", group = grpYearTbl)
maxDisplayYears = input.int(5, "最大表示年数", minval = 1, maxval = 50, group = grpYearTbl)
showYoYTable    = input.bool(true, "前年比テーブルを表示", group = grpYearTbl)

// ============================================================
//  4. 入力 : 詳細分布テーブル (選択した1年)
// ============================================================
grpDetail = "詳細分布テーブル (1年)"
showDetailTable = input.bool(true, "詳細分布テーブルを表示", group = grpDetail)
detailYearInput = input.int(0, "詳細分布 対象年 (0=現在年)", minval = 0, maxval = 2100, group = grpDetail)
detailBinStr    = input.string("5ドル", "ビン幅", options = ["5ドル", "10ドル"], group = grpDetail)
detailMaxVal    = input.float(200.0, "最大集計値 ($ / これ以上は最終ビン)", minval = 10.0, step = 5.0, group = grpDetail)

// ============================================================
//  5. 入力 : チャート表示
// ============================================================
grpShow = "チャート表示"
showRangePlot = input.bool(true,  "日足値幅をサブウィンドウにプロット", group = grpShow)
showBounds    = input.bool(true,  "ランク境界の水平線を表示",           group = grpShow)
showYearSep   = input.bool(false, "年の切り替わり位置にラベルを表示",   group = grpShow)

// ============================================================
//  6. 現在年 / 集計年範囲 の決定
// ------------------------------------------------------------
//  年は日足バーの年 (取引所時間) を基準。現在年は year(timenow)。
// ============================================================
int nowYear = year(timenow)
int aggEndYear   = periodMode == "直近N年間" ? nowYear : (useCurrentAsEnd ? nowYear : endYearManual)
int aggStartYear = periodMode == "直近N年間" ? (nowYear - recentYears + 1) : startYear
// 逆転ガード
aggEndYear   := math.max(aggEndYear, aggStartYear)
int nYears   = aggEndYear - aggStartYear + 1

// 境界妥当性 (b1 < b2 < b3 < b4)
bool dailyBoundsValid = dailyBound1 < dailyBound2 and dailyBound2 < dailyBound3 and dailyBound3 < dailyBound4

// 詳細分布 対象年 (0=現在年)
int detailYear = detailYearInput == 0 ? nowYear : detailYearInput

// ============================================================
//  7. 確定済み日足の高安取得 (未来参照/リペイントなし)
// ------------------------------------------------------------
//  [1] を付けて「1本前 (=直近で確定した日足)」の H/L/time を取得する。
//  これにより下位足でも日中に値が動かず (リペイントしない)、確定日足のみ集計。
//  日付 (dTime) が変わった時に、その確定日足を 1回だけ集計する。
// ============================================================
[dHigh, dLow, dTime] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_off)
float dailyRange = dHigh - dLow

// 新しい確定日足が現れたか (日付が切り替わった最初のバーで true)
bool newDailyClosed = not na(dTime) and (na(dTime[1]) or dTime != dTime[1])
int  barYear = na(dTime) ? na : year(dTime)
bool inYearRange = not na(barYear) and barYear >= aggStartYear and barYear <= aggEndYear

// ============================================================
//  8. 年別集計用の永続配列 (日足を1日1回だけ蓄積)
// ------------------------------------------------------------
//  ・dayRange … 各確定日足の値幅 (期間内のみ)
//  ・dayYear  … その日足の年
//  年別配列を「入れ子」にはできないため、値と年を並列配列で保持し、
//  barstate.islast で年ごとに抽出→ソートして統計を出す。
//  ・var で保持し、日付変化時に1回だけ push → 同じ日足を重複追加しない。
//  ・設定変更/時間足変更時は全履歴が再計算され var も初期化される
//    → 二重集計は起きない (lastAggDayTime でも二重を防止)。
// ============================================================
var array<float> dayRange = array.new_float()
var array<int>   dayYear  = array.new_int()
var int lastAggDayTime = na    // 最後に集計した日足time (重複防止)
var int prevAggYear    = na    // 年切り替わりラベル用

if newDailyClosed and inYearRange and (na(lastAggDayTime) or dTime != lastAggDayTime)
    array.push(dayRange, dailyRange)
    array.push(dayYear,  barYear)
    lastAggDayTime := dTime
    // 年切り替わりラベル (任意)
    if showYearSep and (na(prevAggYear) or barYear != prevAggYear)
        label.new(bar_index, 0.0, str.tostring(barYear), style = label.style_label_up, yloc = yloc.bottom, color = color.new(color.blue, 20), textcolor = color.white, size = size.tiny)
    prevAggYear := barYear

// ============================================================
//  9. パーセンタイル計算ヘルパー (昇順ソート済み配列から取得)
// ============================================================
f_percentile(array<float> sortedArr, float p) =>
    int n = array.size(sortedArr)
    float res = na
    if n > 0
        int idx = int(math.round(p / 100.0 * (n - 1)))
        idx := math.max(0, math.min(n - 1, idx))
        res := array.get(sortedArr, idx)
    res

// 整形ヘルパー
f_n1(float v) => na(v) ? "-" : str.tostring(v, "#.0")
f_n2(float v) => na(v) ? "-" : str.tostring(v, "#.00")
f_pctOf(float part, float whole) => whole > 0 ? str.tostring(part / whole * 100.0, "#.0") + "%" : "-"
f_yoy(float cur, float prev) => (na(prev) or prev == 0 or na(cur)) ? "-" : (cur - prev >= 0 ? "+" : "") + str.tostring((cur - prev) / prev * 100.0, "#.0") + "%"

// ============================================================
//  10. チャート描画 (日足値幅プロット / 境界線)
// ============================================================
plot(showRangePlot ? dailyRange : na, "日足値幅", color = color.new(color.blue, 0), linewidth = 1)
plot(showBounds ? dailyBound1 : na, "境界1", color = color.new(color.green,  0), style = plot.style_line)
plot(showBounds ? dailyBound2 : na, "境界2", color = color.new(color.lime,   0), style = plot.style_line)
plot(showBounds ? dailyBound3 : na, "境界3", color = color.new(color.orange, 0), style = plot.style_line)
plot(showBounds ? dailyBound4 : na, "境界4", color = color.new(color.red,    0), style = plot.style_line)

// ============================================================
//  11. テーブル (集計・ソートは barstate.islast のみ)
// ============================================================
var table tblYear = table.new(position.top_right,    13, maxDisplayYears + 3, border_width = 1, frame_width = 1)
var table tblYoY  = table.new(position.middle_left,   5, maxDisplayYears + 2, border_width = 1, frame_width = 1)

// 詳細分布ビン数 (5 or 10 ドル刻み + オーバーフロー1)
float detW      = detailBinStr == "5ドル" ? 5.0 : 10.0
int   nDetMain  = math.max(1, int(math.round(detailMaxVal / detW)))
int   nDetBins  = nDetMain + 1
var table tblDet = table.new(position.bottom_right, 4, nDetBins + 2, border_width = 1, frame_width = 1)

if barstate.islast
    color hdrBg  = color.new(color.blue, 0)
    color cellBg = color.new(color.gray, 30)
    color curBg  = color.new(color.purple, 0)   // 現在年 (途中) 用
    color txt    = color.white

    // ---------- 年別統計を計算 (index 0 = aggStartYear) ----------
    array<int>   ryCount = array.new_int(nYears, 0)
    array<float> ryMean  = array.new_float(nYears, na)
    array<float> ryMed   = array.new_float(nYears, na)
    array<float> ryMin   = array.new_float(nYears, na)
    array<float> ryMax   = array.new_float(nYears, na)
    array<float> ryP25   = array.new_float(nYears, na)
    array<float> ryP75   = array.new_float(nYears, na)
    array<float> ryP90   = array.new_float(nYears, na)
    array<int>   ryR1    = array.new_int(nYears, 0)
    array<int>   ryR2    = array.new_int(nYears, 0)
    array<int>   ryR3    = array.new_int(nYears, 0)
    array<int>   ryR4    = array.new_int(nYears, 0)
    array<int>   ryR5    = array.new_int(nYears, 0)

    int totalDays = array.size(dayRange)
    for k = 0 to nYears - 1
        int Y = aggStartYear + k
        array<float> tmp = array.new_float()
        int c1 = 0
        int c2 = 0
        int c3 = 0
        int c4 = 0
        int c5 = 0
        if totalDays > 0
            for i = 0 to totalDays - 1
                if array.get(dayYear, i) == Y
                    float v = array.get(dayRange, i)
                    array.push(tmp, v)
                    if dailyBoundsValid
                        if v < dailyBound1
                            c1 += 1
                        else if v < dailyBound2
                            c2 += 1
                        else if v < dailyBound3
                            c3 += 1
                        else if v < dailyBound4
                            c4 += 1
                        else
                            c5 += 1
        int cnt = array.size(tmp)
        array.set(ryCount, k, cnt)
        if cnt > 0
            array.sort(tmp, order.ascending)
            array.set(ryMean, k, array.avg(tmp))
            array.set(ryMed,  k, f_percentile(tmp, 50))
            array.set(ryMin,  k, array.get(tmp, 0))
            array.set(ryMax,  k, array.get(tmp, cnt - 1))
            array.set(ryP25,  k, f_percentile(tmp, 25))
            array.set(ryP75,  k, f_percentile(tmp, 75))
            array.set(ryP90,  k, f_percentile(tmp, 90))
        array.set(ryR1, k, c1)
        array.set(ryR2, k, c2)
        array.set(ryR3, k, c3)
        array.set(ryR4, k, c4)
        array.set(ryR5, k, c5)

    // 表示する年の範囲 (直近 maxDisplayYears 年)
    int firstK = math.max(0, nYears - maxDisplayYears)

    // ---------- ① 年別比較テーブル ----------
    if showYearTable
        array<string> heads = array.from("年", "日数", "平均", "中央", "25%", "75%", "90%", "最大", "R1%", "R2%", "R3%", "R4%", "R5%")
        for c = 0 to 12
            table.cell(tblYear, c, 0, array.get(heads, c), text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        int row = 1
        for k = firstK to nYears - 1
            int    Y   = aggStartYear + k
            int    cnt = array.get(ryCount, k)
            bool   isCur = Y == nowYear
            string yLbl = str.tostring(Y) + (isCur ? "(途中)" : "")
            color  rBg  = isCur ? curBg : cellBg
            table.cell(tblYear, 0,  row, yLbl,                 text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 1,  row, str.tostring(cnt),    text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 2,  row, f_n1(array.get(ryMean, k)), text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 3,  row, f_n1(array.get(ryMed, k)),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 4,  row, f_n1(array.get(ryP25, k)),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 5,  row, f_n1(array.get(ryP75, k)),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 6,  row, f_n1(array.get(ryP90, k)),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYear, 7,  row, f_n1(array.get(ryMax, k)),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            if dailyBoundsValid
                table.cell(tblYear, 8,  row, f_pctOf(array.get(ryR1, k), cnt), text_color = txt, bgcolor = rBg, text_size = size.tiny)
                table.cell(tblYear, 9,  row, f_pctOf(array.get(ryR2, k), cnt), text_color = txt, bgcolor = rBg, text_size = size.tiny)
                table.cell(tblYear, 10, row, f_pctOf(array.get(ryR3, k), cnt), text_color = txt, bgcolor = rBg, text_size = size.tiny)
                table.cell(tblYear, 11, row, f_pctOf(array.get(ryR4, k), cnt), text_color = txt, bgcolor = rBg, text_size = size.tiny)
                table.cell(tblYear, 12, row, f_pctOf(array.get(ryR5, k), cnt), text_color = txt, bgcolor = rBg, text_size = size.tiny)
            else
                for c = 8 to 12
                    table.cell(tblYear, c, row, "-", text_color = txt, bgcolor = rBg, text_size = size.tiny)
            row += 1
        // 注記 / 警告行
        string note = not dailyBoundsValid ? "境界不正: b1<b2<b3<b4 にしてください (ランク集計停止)" : "現在年(途中)は年間日数が少ない点に注意"
        color  noteBg = not dailyBoundsValid ? color.new(color.red, 0) : color.new(color.gray, 10)
        table.cell(tblYear, 0, row, note, text_color = txt, bgcolor = noteBg, text_size = size.tiny)
        for c = 1 to 12
            table.cell(tblYear, c, row, "", text_color = txt, bgcolor = noteBg, text_size = size.tiny)

    // ---------- ② 前年比テーブル ----------
    if showYoYTable
        array<string> yh = array.from("年", "平均比", "中央比", "75%比", "90%比")
        for c = 0 to 4
            table.cell(tblYoY, c, 0, array.get(yh, c), text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        int rowY = 1
        for k = firstK to nYears - 1
            int    Y = aggStartYear + k
            bool   hasPrev = k >= 1
            bool   isCur = Y == nowYear
            color  rBg = isCur ? curBg : cellBg
            float  pMean = hasPrev ? array.get(ryMean, k - 1) : na
            float  pMed  = hasPrev ? array.get(ryMed,  k - 1) : na
            float  pP75  = hasPrev ? array.get(ryP75,  k - 1) : na
            float  pP90  = hasPrev ? array.get(ryP90,  k - 1) : na
            table.cell(tblYoY, 0, rowY, str.tostring(Y) + (isCur ? "(途中)" : ""), text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYoY, 1, rowY, f_yoy(array.get(ryMean, k), pMean), text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYoY, 2, rowY, f_yoy(array.get(ryMed,  k), pMed),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYoY, 3, rowY, f_yoy(array.get(ryP75,  k), pP75),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            table.cell(tblYoY, 4, rowY, f_yoy(array.get(ryP90,  k), pP90),  text_color = txt, bgcolor = rBg, text_size = size.tiny)
            rowY += 1

    // ---------- ③ 詳細分布テーブル (選択年) ----------
    if showDetailTable
        // 選択年のデータを集める
        array<float> dsel = array.new_float()
        array<int>   hist = array.new_int(nDetBins, 0)
        if totalDays > 0
            for i = 0 to totalDays - 1
                if array.get(dayYear, i) == detailYear
                    float v = array.get(dayRange, i)
                    array.push(dsel, v)
                    int bi = v >= detailMaxVal ? nDetMain : int(math.floor(v / detW))
                    bi := math.max(0, math.min(nDetBins - 1, bi))
                    array.set(hist, bi, array.get(hist, bi) + 1)
        int dcnt = array.size(dsel)
        bool isCurDet = detailYear == nowYear
        table.cell(tblDet, 0, 0, "値幅帯($) " + str.tostring(detailYear) + (isCurDet ? "(途中)" : ""), text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 1, 0, "日数",   text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 2, 0, "年割合", text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 3, 0, "累積",   text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        int cumD = 0
        for b = 0 to nDetBins - 1
            int    hc = array.get(hist, b)
            cumD += hc
            string band = b == nDetMain ? (f_n1(detailMaxVal) + "以上") : (f_n1(b * detW) + "〜" + f_n1((b + 1) * detW))
            table.cell(tblDet, 0, b + 1, band,                 text_color = txt, bgcolor = cellBg, text_size = size.tiny)
            table.cell(tblDet, 1, b + 1, str.tostring(hc),     text_color = txt, bgcolor = cellBg, text_size = size.tiny)
            table.cell(tblDet, 2, b + 1, f_pctOf(hc, dcnt),    text_color = txt, bgcolor = cellBg, text_size = size.tiny)
            table.cell(tblDet, 3, b + 1, f_pctOf(cumD, dcnt),  text_color = txt, bgcolor = cellBg, text_size = size.tiny)
        table.cell(tblDet, 0, nDetBins + 1, "合計",             text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 1, nDetBins + 1, str.tostring(dcnt), text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 2, nDetBins + 1, "",                 text_color = txt, bgcolor = hdrBg, text_size = size.tiny)
        table.cell(tblDet, 3, nDetBins + 1, "",                 text_color = txt, bgcolor = hdrBg, text_size = size.tiny)

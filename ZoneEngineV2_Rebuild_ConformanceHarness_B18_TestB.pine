// H05 w06CompareWinnersRaw : logical winner contract equality of two Candidate results (no Candidate logic). Order:
// Side counts, failed flags, logical count, root pool length, the failed-Side segment (a -1 Side holds no record), then
// every record in order (all 17 winner fields; exact int / bool / float equality, na equal only to na) and the root ID
// pool in order up to the root length. Transient scratch, Best*, RoundTie, ref scratch lengths and seen epoch tokens are
// not compared. Returns [mismatchCount, firstMismatchField, firstMismatchIndex] ([0, 0, -1] when equal).
w06CompareWinnersRaw(W06FxCand a, int aSupportCount, int aResistanceCount, W06FxCand b, int bSupportCount, int bResistanceCount) =>
    int mismatchCount = 0
    int firstField    = W06CMP_NONE
    int firstIndex    = -1
    array<int> sc = array.from(aSupportCount == bSupportCount ? 0 : W06CMP_SUPPORT_COUNT, aResistanceCount == bResistanceCount ? 0 : W06CMP_RESISTANCE_COUNT, a.candidateFailedSupport == b.candidateFailedSupport ? 0 : W06CMP_FAILED_SUPPORT, a.candidateFailedResistance == b.candidateFailedResistance ? 0 : W06CMP_FAILED_RESISTANCE, a.candidateWinnerLogicalCount == b.candidateWinnerLogicalCount ? 0 : W06CMP_LOGICAL_COUNT, a.candidateWinnerRootIdLength == b.candidateWinnerRootIdLength ? 0 : W06CMP_ROOT_POOL_LENGTH)
    int s = 0
    while s < array.size(sc)
        if array.get(sc, s) != 0
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := array.get(sc, s)
                firstIndex := -1
        s += 1
    // a failed Side (-1) holds no record in either result
    int lane = 0
    while lane < 2
        W06FxCand x = lane == 0 ? a : b
        int xs = lane == 0 ? aSupportCount : bSupportCount
        int xr = lane == 0 ? aResistanceCount : bResistanceCount
        int supportRecords    = 0
        int resistanceRecords = 0
        int k = 0
        while k < x.candidateWinnerLogicalCount and k < array.size(x.candidateWinnerSides)
            int kSide = array.get(x.candidateWinnerSides, k)
            if kSide == W06FX_SIDE_SUPPORT
                supportRecords += 1
            else if kSide == W06FX_SIDE_RESISTANCE
                resistanceRecords += 1
            k += 1
        if (xs == -1 and supportRecords != 0) or (xr == -1 and resistanceRecords != 0)
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_FAILED_SEGMENT
                firstIndex := -1
        lane += 1
    // records in order
    int recA = math.min(a.candidateWinnerLogicalCount, array.size(a.candidateWinnerSides))
    int recB = math.min(b.candidateWinnerLogicalCount, array.size(b.candidateWinnerSides))
    int recN = math.min(recA, recB)
    int i = 0
    while i < recN
        int vSideA = array.get(a.candidateWinnerSides, i)
        int vSideB = array.get(b.candidateWinnerSides, i)
        if not ((na(vSideA) and na(vSideB)) or (not na(vSideA) and not na(vSideB) and vSideA == vSideB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_SIDE
                firstIndex := i
        int vStageA = array.get(a.candidateWinnerStages, i)
        int vStageB = array.get(b.candidateWinnerStages, i)
        if not ((na(vStageA) and na(vStageB)) or (not na(vStageA) and not na(vStageB) and vStageA == vStageB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_STAGE
                firstIndex := i
        int vBottomTickA = array.get(a.candidateWinnerEffectiveBottomTicks, i)
        int vBottomTickB = array.get(b.candidateWinnerEffectiveBottomTicks, i)
        if not ((na(vBottomTickA) and na(vBottomTickB)) or (not na(vBottomTickA) and not na(vBottomTickB) and vBottomTickA == vBottomTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_BOTTOM_TICK
                firstIndex := i
        int vTopTickA = array.get(a.candidateWinnerEffectiveTopTicks, i)
        int vTopTickB = array.get(b.candidateWinnerEffectiveTopTicks, i)
        if not ((na(vTopTickA) and na(vTopTickB)) or (not na(vTopTickA) and not na(vTopTickB) and vTopTickA == vTopTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_TOP_TICK
                firstIndex := i
        int vCA = array.get(a.candidateWinnerCCounts, i)
        int vCB = array.get(b.candidateWinnerCCounts, i)
        if not ((na(vCA) and na(vCB)) or (not na(vCA) and not na(vCB) and vCA == vCB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_C
                firstIndex := i
        int vHA = array.get(a.candidateWinnerHCounts, i)
        int vHB = array.get(b.candidateWinnerHCounts, i)
        if not ((na(vHA) and na(vHB)) or (not na(vHA) and not na(vHB) and vHA == vHB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_H
                firstIndex := i
        int vDensityA = array.get(a.candidateWinnerDensities, i)
        int vDensityB = array.get(b.candidateWinnerDensities, i)
        if not ((na(vDensityA) and na(vDensityB)) or (not na(vDensityA) and not na(vDensityB) and vDensityA == vDensityB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_DENSITY
                firstIndex := i
        bool vBaseStrongA = array.get(a.candidateWinnerBaseStrongFlags, i)
        bool vBaseStrongB = array.get(b.candidateWinnerBaseStrongFlags, i)
        if vBaseStrongA != vBaseStrongB
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_BASE_STRONG
                firstIndex := i
        int vCategoryMaskA = array.get(a.candidateWinnerCategoryMasks, i)
        int vCategoryMaskB = array.get(b.candidateWinnerCategoryMasks, i)
        if not ((na(vCategoryMaskA) and na(vCategoryMaskB)) or (not na(vCategoryMaskA) and not na(vCategoryMaskB) and vCategoryMaskA == vCategoryMaskB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_CATEGORY_MASK
                firstIndex := i
        int vHighMaskA = array.get(a.candidateWinnerHighMasks, i)
        int vHighMaskB = array.get(b.candidateWinnerHighMasks, i)
        if not ((na(vHighMaskA) and na(vHighMaskB)) or (not na(vHighMaskA) and not na(vHighMaskB) and vHighMaskA == vHighMaskB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_HIGH_MASK
                firstIndex := i
        int vCreatedTimeA = array.get(a.candidateWinnerCreatedTimes, i)
        int vCreatedTimeB = array.get(b.candidateWinnerCreatedTimes, i)
        if not ((na(vCreatedTimeA) and na(vCreatedTimeB)) or (not na(vCreatedTimeA) and not na(vCreatedTimeB) and vCreatedTimeA == vCreatedTimeB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_CREATED_TIME
                firstIndex := i
        int vMinRootIdA = array.get(a.candidateWinnerMinRootIds, i)
        int vMinRootIdB = array.get(b.candidateWinnerMinRootIds, i)
        if not ((na(vMinRootIdA) and na(vMinRootIdB)) or (not na(vMinRootIdA) and not na(vMinRootIdB) and vMinRootIdA == vMinRootIdB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_MIN_ROOT_ID
                firstIndex := i
        int vFvgModeA = array.get(a.candidateWinnerFvgModes, i)
        int vFvgModeB = array.get(b.candidateWinnerFvgModes, i)
        if not ((na(vFvgModeA) and na(vFvgModeB)) or (not na(vFvgModeA) and not na(vFvgModeB) and vFvgModeA == vFvgModeB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_FVG_MODE
                firstIndex := i
        int vPsychLevelTickA = array.get(a.candidateWinnerPsychLevelTicks, i)
        int vPsychLevelTickB = array.get(b.candidateWinnerPsychLevelTicks, i)
        if not ((na(vPsychLevelTickA) and na(vPsychLevelTickB)) or (not na(vPsychLevelTickA) and not na(vPsychLevelTickB) and vPsychLevelTickA == vPsychLevelTickB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_PSYCH_LEVEL_TICK
                firstIndex := i
        float vReferencePriceA = array.get(a.candidateWinnerReferencePrices, i)
        float vReferencePriceB = array.get(b.candidateWinnerReferencePrices, i)
        if not ((na(vReferencePriceA) and na(vReferencePriceB)) or (not na(vReferencePriceA) and not na(vReferencePriceB) and vReferencePriceA == vReferencePriceB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_REFERENCE_PRICE
                firstIndex := i
        int vRootIdOffsetA = array.get(a.candidateWinnerRootIdOffsets, i)
        int vRootIdOffsetB = array.get(b.candidateWinnerRootIdOffsets, i)
        if not ((na(vRootIdOffsetA) and na(vRootIdOffsetB)) or (not na(vRootIdOffsetA) and not na(vRootIdOffsetB) and vRootIdOffsetA == vRootIdOffsetB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID_OFFSET
                firstIndex := i
        int vRootIdLengthA = array.get(a.candidateWinnerRootIdLengths, i)
        int vRootIdLengthB = array.get(b.candidateWinnerRootIdLengths, i)
        if not ((na(vRootIdLengthA) and na(vRootIdLengthB)) or (not na(vRootIdLengthA) and not na(vRootIdLengthB) and vRootIdLengthA == vRootIdLengthB))
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID_LENGTH
                firstIndex := i
        i += 1
    // root ID pool in order
    int poolA = math.min(a.candidateWinnerRootIdLength, array.size(a.candidateWinnerRootIds))
    int poolB = math.min(b.candidateWinnerRootIdLength, array.size(b.candidateWinnerRootIds))
    int m = math.min(poolA, poolB)
    int g = 0
    while g < m
        if array.get(a.candidateWinnerRootIds, g) != array.get(b.candidateWinnerRootIds, g)
            mismatchCount += 1
            if firstField == W06CMP_NONE
                firstField := W06CMP_ROOT_ID
                firstIndex := g
        g += 1
    [mismatchCount, firstField, firstIndex]

// ============================================================
// W06 B17 : Reference adapter (H06) and conformance Test A (H07)
// ============================================================
// H06 field codes (Harness-only)
const int W06REF_NONE             = 0
const int W06REF_SUPPORT_COUNT    = 1
const int W06REF_RESISTANCE_COUNT = 2
const int W06REF_SIDE             = 3
const int W06REF_STAGE            = 4
const int W06REF_BOTTOM_TICK      = 5
const int W06REF_TOP_TICK         = 6
const int W06REF_CATEGORY_MASK    = 7
const int W06REF_HIGH_MASK        = 8
const int W06REF_C                = 9
const int W06REF_H                = 10
const int W06REF_DENSITY          = 11
const int W06REF_BASE_STRONG      = 12
const int W06REF_CREATED_TIME     = 13
const int W06REF_MIN_ROOT_ID      = 14
const int W06REF_PSYCH            = 15
const int W06REF_BROAD_CONTEXT    = 16
const int W06REF_REFERENCE_PRICE  = 17
const int W06REF_ROOT_IDS         = 18

// H06 w06CompareWithReferenceRaw : one Candidate result (W06FxCand records, Support then Resistance) against the W04
// Reference results of each Side (refBuildReferenceResults: -1 failure or the result count, results in winner order).
// Compared only where RefResult exposes the field: Side counts, then per record side, stage, effective range, category
// / high mask, C, H, density, baseStrong, createdTime, minRootId, psych presence + tick, Broad Context (fvgMode 5),
// reference price (exact, na only equal to na) and the ascending materialized root ID list. Not exposed by RefResult:
// fvgMode detail, root pool offsets; not exposed by W06 records: psychIsMajor. Returns [mismatchCount, firstField,
// firstIndex] ([0, 0, -1] when equal); the index is the W06 record index.
w06CompareWithReferenceRaw(W06FxCand a, int aSupportCount, int aResistanceCount, int refSupportCount, array<RefResult> refSupport, int refResistanceCount, array<RefResult> refResistance) =>
    int mismatchCount = 0
    int firstField    = W06REF_NONE
    int firstIndex    = -1
    if aSupportCount != refSupportCount
        mismatchCount += 1
        firstField    := W06REF_SUPPORT_COUNT
    if aResistanceCount != refResistanceCount
        mismatchCount += 1
        if firstField == W06REF_NONE
            firstField := W06REF_RESISTANCE_COUNT
    int side = 0
    while side < 2
        int aCount = side == 0 ? aSupportCount : aResistanceCount
        int rCount = side == 0 ? refSupportCount : refResistanceCount
        array<RefResult> refs = side == 0 ? refSupport : refResistance
        int base = side == 0 ? 0 : math.max(aSupportCount, 0)
        int pairs = aCount >= 0 and rCount >= 0 ? math.min(aCount, math.min(rCount, array.size(refs))) : 0
        int i = 0
        while i < pairs
            int idx = base + i
            if idx < a.candidateWinnerLogicalCount and idx < array.size(a.candidateWinnerSides)
                RefResult rr = array.get(refs, i)
                array<int> codes = array.new_int(0)
                int   aStage   = array.get(a.candidateWinnerStages, idx)
                int   aBottom  = array.get(a.candidateWinnerEffectiveBottomTicks, idx)
                int   aTop     = array.get(a.candidateWinnerEffectiveTopTicks, idx)
                int   aDensity = array.get(a.candidateWinnerDensities, idx)
                int   aCreated = array.get(a.candidateWinnerCreatedTimes, idx)
                int   aPsych   = array.get(a.candidateWinnerPsychLevelTicks, idx)
                float aPrice   = array.get(a.candidateWinnerReferencePrices, idx)
                if array.get(a.candidateWinnerSides, idx) != rr.side
                    array.push(codes, W06REF_SIDE)
                if not ((na(aStage) and na(rr.stage)) or (not na(aStage) and not na(rr.stage) and aStage == rr.stage))
                    array.push(codes, W06REF_STAGE)
                if not ((na(aBottom) and na(rr.effectiveBottomTick)) or (not na(aBottom) and not na(rr.effectiveBottomTick) and aBottom == rr.effectiveBottomTick))
                    array.push(codes, W06REF_BOTTOM_TICK)
                if not ((na(aTop) and na(rr.effectiveTopTick)) or (not na(aTop) and not na(rr.effectiveTopTick) and aTop == rr.effectiveTopTick))
                    array.push(codes, W06REF_TOP_TICK)
                if array.get(a.candidateWinnerCategoryMasks, idx) != rr.categoryMask
                    array.push(codes, W06REF_CATEGORY_MASK)
                if array.get(a.candidateWinnerHighMasks, idx) != rr.highMask
                    array.push(codes, W06REF_HIGH_MASK)
                if array.get(a.candidateWinnerCCounts, idx) != rr.cCount
                    array.push(codes, W06REF_C)
                if array.get(a.candidateWinnerHCounts, idx) != rr.hCount
                    array.push(codes, W06REF_H)
                if not ((na(aDensity) and na(rr.density)) or (not na(aDensity) and not na(rr.density) and aDensity == rr.density))
                    array.push(codes, W06REF_DENSITY)
                if array.get(a.candidateWinnerBaseStrongFlags, idx) != rr.baseStrong
                    array.push(codes, W06REF_BASE_STRONG)
                if not ((na(aCreated) and na(rr.createdTime)) or (not na(aCreated) and not na(rr.createdTime) and aCreated == rr.createdTime))
                    array.push(codes, W06REF_CREATED_TIME)
                if array.get(a.candidateWinnerMinRootIds, idx) != rr.minRootId
                    array.push(codes, W06REF_MIN_ROOT_ID)
                if (not na(aPsych)) != rr.psychPresent or (not na(aPsych) and rr.psychPresent and aPsych != rr.psychLevelTick)
                    array.push(codes, W06REF_PSYCH)
                if (array.get(a.candidateWinnerFvgModes, idx) == REF_FVG_RANGE_BROAD_CONTEXT) != rr.isBroadContext
                    array.push(codes, W06REF_BROAD_CONTEXT)
                if not ((na(aPrice) and na(rr.referencePrice)) or (not na(aPrice) and not na(rr.referencePrice) and aPrice == rr.referencePrice))
                    array.push(codes, W06REF_REFERENCE_PRICE)
                int rootOff = array.get(a.candidateWinnerRootIdOffsets, idx)
                int rootLen = array.get(a.candidateWinnerRootIdLengths, idx)
                bool rootsEqual = rootLen == array.size(rr.materializedRootIds) and rootOff >= 0 and rootOff + rootLen <= array.size(a.candidateWinnerRootIds)
                int g = 0
                while rootsEqual and g < rootLen
                    rootsEqual := array.get(a.candidateWinnerRootIds, rootOff + g) == array.get(rr.materializedRootIds, g)
                    g += 1
                if not rootsEqual
                    array.push(codes, W06REF_ROOT_IDS)
                if array.size(codes) > 0
                    mismatchCount += array.size(codes)
                    if firstField == W06REF_NONE
                        firstField := array.get(codes, 0)
                        firstIndex := idx
            i += 1
        side += 1
    [mismatchCount, firstField, firstIndex]

// ============================================================
// W06 B18 : conformance Test B (H08 / H09). Lane A = H03 (cache ON, W06 LOCAL optimized), lane B = H04 (cache OFF,
// W06 forceFull, W05 /2 FULL, W05 /3 FULL), lane C = W04 Reference (refBuildReferenceResults) built directly from the
// current Root state of the lane it is compared with (never from a Candidate result). Every step: A vs B through H05,
// A vs C and B vs C through H06, W05 /2 vs /3 through H05, then the fixture's expected H03 runMode and invariants.
// Harness data only: no Candidate / component logic, no request, no drawing, no string. Runs once on the last bar.
// ============================================================
// First Compare codes (Harness-only)
const int W06TB_COMPARE_NONE               = 0
const int W06TB_COMPARE_LOCAL_VS_FULL      = 1
const int W06TB_COMPARE_LOCAL_VS_REFERENCE = 2
const int W06TB_COMPARE_FULL_VS_REFERENCE  = 3
const int W06TB_COMPARE_W05_V2_VS_V3       = 4
const int W06TB_COMPARE_EXPECTED_RUNMODE   = 5
const int W06TB_COMPARE_FIXTURE_INVARIANT  = 6
// Expected-invariant field codes (Harness-only small codes, never H05 / H06 codes). First Field holds one of them when
// First Compare is 5 or 6, and First Index then holds the observed value (not a record index).
const int W06TB_INV_RUN_MODE                = 1   // H03 runMode (First Compare 5 only)
const int W06TB_INV_LANE_OK                 = 2   // H01 lanes / H03 / H04 ok (expected 1)
const int W06TB_INV_ROOT_LANE               = 3   // lane A / B Root audit equal before the step (expected 1)
const int W06TB_INV_SUPPORT_COUNT           = 4   // lane A Support count (-1 = failed Side)
const int W06TB_INV_RESISTANCE_COUNT        = 5   // lane A Resistance count (-1 = failed Side)
const int W06TB_INV_CACHE_VALID             = 6   // lane A component cache valid after H03 (0 / 1)
const int W06TB_INV_FORCE_FULL              = 7   // lane A forceFull at H03 entry (0 / 1)
const int W06TB_INV_AFFECTED_COUNT          = 8   // lane A candAffectedComponentCount after H03
const int W06TB_INV_LOCAL_SUPPORT_STATUS    = 9   // Support status of the first LOCAL row (-1 = no LOCAL row)
const int W06TB_INV_LOCAL_RESISTANCE_STATUS = 10  // Resistance status of the first LOCAL row (-1 = no LOCAL row)
const int W06TB_INV_BROAD_SUPPORT_STATUS    = 11  // Support status of the first BROAD_ONLY row (-1 = no BROAD_ONLY row)
const int W06TB_INV_NON_OK_STATUS_COUNT     = 12  // row Sides whose status is not OK (0)
const int W06TB_INV_COMPONENT_ROWS          = 13  // component row count
const int W06TB_INV_LOCAL_ROWS              = 14  // LOCAL component row count
const int W06TB_INV_REF_PRICE_CHANGED       = 15  // lane A records whose ReferencePrice differs from the previous step (same index)
const int W06TB_INV_TICK_CHANGED            = 16  // lane A records whose bottom / top tick differs from the previous step (same index)
const int W06TB_INV_BROAD_CONTEXT_RECORDS   = 17  // lane A records with fvgMode BROAD_CONTEXT (5)
const int W06TB_INV_FIRST_ROOT_MASK         = 18  // record 0: sum of 2^(rootId - 1) over its root IDs
const int W06TB_INV_FIRST_BASE_STRONG       = 19  // record 0: baseStrong (0 / 1)
const int W06TB_INV_FIRST_PSYCH             = 20  // record 0: psych level present (0 / 1)
const int W06TB_KIND_LOCAL                  = 1
const int W06TB_KIND_BROAD_ONLY             = 2
const int W06TB_RUN_LOCAL                   = 1
const int W06TB_RUN_FULL_FALLBACK           = 2
const int W06TB_CAP                         = 100000
// F14 minimal LOCAL capacity K of the S2 fixture (Worker /15 Python reproduction over 0 .. 64: 0 .. 31 FULL_FALLBACK,
// 32 .. 64 LOCAL, monotonic). A constant: no capacity search runs in Pine.
const int W06TB_CAPACITY_K                  = 32
const int W06TB_T0                          = 1700000000000

// H09 output: one Test B fixture. Roots are the H01 input (creation order, rootId ascending); per step: cfgRevision,
// capacity, fresh (every lane rebuilt by H01 before the step) and the expected H03 runMode; journal rows (step, logical
// operation, target rootId, NEW_ROOT fields; originKey 0, originTime = confirmedTime); expected invariants (step, code,
// value).
type W06TbFixture
    int            code
    array<RefRoot> roots
    array<int>     originKeys
    int            stepCount = 0
    array<int>     stepCfgRevisions
    array<int>     stepCapacities
    array<bool>    stepFresh
    array<int>     stepExpectedRunModes
    array<int>     rowStep
    array<int>     rowOp
    array<int>     rowGroup
    array<int>     rowTarget
    array<int>     rowCat
    array<int>     rowSub
    array<int>     rowTf
    array<int>     rowConf
    array<float>   rowPrice
    array<float>   rowNb
    array<float>   rowNt
    array<int>     rowDir
    array<bool>    rowBroad
    array<int>     rowMask
    array<int>     rowPair
    array<int>     rowSlope
    array<int>     invStep
    array<int>     invKind
    array<int>     invExpected

// The independent lanes of one fixture (separate H01 calls; nothing shared): A (H03), B (H04), W05 /2 and /3 storage
type W06TbLanes
    W06FxRoots   frA
    W06FxCand    fcA
    W06FxComp    fwA
    W06FxJournal fjA
    W06FxRoots   frB
    W06FxCand    fcB
    W06FxComp    fwB
    W06FxJournal fjB
    W06FxCand    fcV2
    W06FxCand    fcV3
    bool         ok = false

// H08 result (the 13 Test B Data Window values) plus the per-fixture failure flag
type W06TbOut
    int  failures        = 0
    int  fixtureFailures = 0
    int  firstFixture    = 0
    int  firstStep       = -1
    int  firstCompare    = 0
    int  firstField      = 0
    int  firstIndex      = -1
    int  localRuns       = 0
    int  fullRuns        = 0
    int  referenceRuns   = 0
    int  fallbackRuns    = 0
    int  w05Failures     = 0
    int  capacityK       = 0
    bool fixtureFailed   = false

// H09 helper: one fixture Root (confirmedTime = originTime = W06TB_T0 + conf, ACTIVE, originKey 0)
w06TbRootRaw(W06TbFixture fx, int rid, int cat, int sub, int tf, int conf, float price, float nb, float nt, int dir, bool broad, int label, int swingMask, int slope, int pairKey) =>
    array.push(fx.roots, RefRoot.new(rootId = rid, category = cat, subtype = sub, tfCode = tf, originTime = W06TB_T0 + conf, confirmedTime = W06TB_T0 + conf, pointPrice = price, pointTick = int(na), nativeBottom = nb, nativeTop = nt, nativeBottomTick = int(na), nativeTopTick = int(na), state = REF_ROOT_ACTIVE, pairKey = pairKey, direction = dir, isBroadFvg = broad, labelMask = label, swingTfMask = swingMask, maSlopeDir = slope))
    array.push(fx.originKeys, 0)
    true

// H09 helper: one point Root (MA / Swing / Accum / TimeHL)
w06TbPointRaw(W06TbFixture fx, int rid, int cat, int sub, int tf, int conf, float price, int label, int swingMask, int slope, int pairKey) =>
    w06TbRootRaw(fx, rid, cat, sub, tf, conf, price, na, na, 0, false, label, swingMask, slope, pairKey)

// H09 helper: one FVG Root
w06TbFvgRaw(W06TbFixture fx, int rid, int tf, int conf, float nb, float nt, int dir, bool broad) =>
    w06TbRootRaw(fx, rid, REF_CAT_FVG, 0, tf, conf, na, nb, nt, dir, broad, 0, 0, 0, 0)

// H09 helper: one step (cfgRevision, capacity, fresh lanes before the step, expected H03 runMode)
w06TbStepRaw(W06TbFixture fx, int cfg, int capacity, bool fresh, int expectedRunMode) =>
    array.push(fx.stepCfgRevisions, cfg)
    array.push(fx.stepCapacities, capacity)
    array.push(fx.stepFresh, fresh)
    array.push(fx.stepExpectedRunModes, expectedRunMode)
    fx.stepCount := fx.stepCount + 1
    true

// H09 helper: one journal row of `step` (target by rootId; NEW_ROOT ignores the target and takes the next slot / rootId)
w06TbRowRaw(W06TbFixture fx, int step, int op, int grp, int target, int cat, int sub, int tf, int conf, float price, float nb, float nt, int dir, bool broad, int mask, int pairKey, int slope) =>
    array.push(fx.rowStep, step)
    array.push(fx.rowOp, op)
    array.push(fx.rowGroup, grp)
    array.push(fx.rowTarget, target)
    array.push(fx.rowCat, cat)
    array.push(fx.rowSub, sub)
    array.push(fx.rowTf, tf)
    array.push(fx.rowConf, conf == 0 ? 0 : W06TB_T0 + conf)
    array.push(fx.rowPrice, price)
    array.push(fx.rowNb, nb)
    array.push(fx.rowNt, nt)
    array.push(fx.rowDir, dir)
    array.push(fx.rowBroad, broad)
    array.push(fx.rowMask, mask)
    array.push(fx.rowPair, pairKey)
    array.push(fx.rowSlope, slope)
    true

// H09 helper: NEW_ROOT (group E2) of one point Root
w06TbNewPointRowRaw(W06TbFixture fx, int step, int cat, int sub, int tf, int conf, float price, int mask) =>
    w06TbRowRaw(fx, step, W06FX_JOP_NEW_ROOT, 2, 0, cat, sub, tf, conf, price, na, na, 0, false, mask, 0, 0)

// H09 helper: MA_UPDATE (group E3) of MA rootId target: new price, confirmedTime and slope
w06TbMaRowRaw(W06TbFixture fx, int step, int target, int sub, float price, int conf, int slope) =>
    w06TbRowRaw(fx, step, W06FX_JOP_MA_UPDATE, 3, target, REF_CAT_MA, sub, 0, conf, price, na, na, 0, false, 0, 0, slope)

// H09 helper: a row that only names its target (FVG_INVALIDATE E1, SWING_TF_MERGE E3 with the new mask, ROOT_RETIRE E4)
w06TbTargetRowRaw(W06TbFixture fx, int step, int op, int grp, int target, int mask) =>
    w06TbRowRaw(fx, step, op, grp, target, 0, 0, 0, 0, na, na, na, 0, false, mask, 0, 0)

// H09 helper: one expected invariant (step, W06TB_INV_* code, expected value)
w06TbInvRaw(W06TbFixture fx, int step, int kind, int expected) =>
    array.push(fx.invStep, step)
    array.push(fx.invKind, kind)
    array.push(fx.invExpected, expected)
    true

// H09 w06FixtureStepsRaw : the Test B fixture of `code` (1 .. 14 = F01 .. F14; 211 = 21A, 212 = 21B-1, 213 = 21B-2,
// 214 = 21C, 215 = 21D). Roots, step journals (logical operations; each lane resolves its own target slots), per-step
// cfgRevision / capacity / fresh flag / expected H03 runMode and the expected invariants. Fixed data only (values from the
// Worker /15 + W05 /2 /3 + W04 Python reproduction); no Candidate / component logic, no capacity search.
// Constants: mintick 0.01, clusterMaxWidth 2.0 (M = 200 ticks), denseRatio 0.25 (dense = 50 ticks), every category on.
w06FixtureStepsRaw(int code) =>
    W06TbFixture fx = W06TbFixture.new(code = code, roots = array.new<RefRoot>(), originKeys = array.new_int(0), stepCfgRevisions = array.new_int(0), stepCapacities = array.new_int(0), stepFresh = array.new_bool(0), stepExpectedRunModes = array.new_int(0), rowStep = array.new_int(0), rowOp = array.new_int(0), rowGroup = array.new_int(0), rowTarget = array.new_int(0), rowCat = array.new_int(0), rowSub = array.new_int(0), rowTf = array.new_int(0), rowConf = array.new_int(0), rowPrice = array.new_float(0), rowNb = array.new_float(0), rowNt = array.new_float(0), rowDir = array.new_int(0), rowBroad = array.new_bool(0), rowMask = array.new_int(0), rowPair = array.new_int(0), rowSlope = array.new_int(0), invStep = array.new_int(0), invKind = array.new_int(0), invExpected = array.new_int(0))
    if code == 1
        // F01 EMPTY: no Root; build, then no-op. Candidate 0 on both Sides.
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_RESISTANCE_COUNT, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_SUPPORT_COUNT, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_RESISTANCE_COUNT, 0)
    else if code == 2
        // F02 MA float move inside one tick: EMA2000 2010.001 -> 2010.004 (tick 201000 kept, ReferencePrice changes);
        // then EMA3000 to the EMA2000 price (EMA equal price), then EMA3000 below EMA2000 (EMA order swap).
        // Cluster 2: Swing 2020.00 + TimeHL 2020.50 = exactly the dense width (50 ticks).
        w06TbPointRaw(fx, 1, REF_CAT_MA, REF_SUB_MA_EMA2000, 1, 1000, 2010.001, 0, 0, 1, 0)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, 2000, 2010.20, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_MA, REF_SUB_MA_EMA3000, 1, 1500, 2010.30, 0, 0, 1, 0)
        w06TbPointRaw(fx, 4, REF_CAT_SWING, 1, 5, 3000, 2020.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 5, REF_CAT_TIMEHL, 0, 60, 4000, 2020.50, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbMaRowRaw(fx, 1, 1, REF_SUB_MA_EMA2000, 2010.004, 1000, 1)
        w06TbMaRowRaw(fx, 2, 3, REF_SUB_MA_EMA3000, 2010.004, 1500, 1)
        w06TbMaRowRaw(fx, 3, 3, REF_SUB_MA_EMA3000, 2009.95, 1500, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_REF_PRICE_CHANGED, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_TICK_CHANGED, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
        w06TbInvRaw(fx, 2, W06TB_INV_AFFECTED_COUNT, 1)
        w06TbInvRaw(fx, 3, W06TB_INV_AFFECTED_COUNT, 1)
    else if code == 3
        // F03 MA old -> new component: EMA2000 leaves the 2010 cluster for the 2020 cluster (both components affected)
        w06TbPointRaw(fx, 1, REF_CAT_MA, REF_SUB_MA_EMA2000, 1, 1000, 2010.00, 0, 0, 1, 0)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, 2000, 2010.20, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2020.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 4, REF_CAT_TIMEHL, 0, 60, 4000, 2020.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbMaRowRaw(fx, 1, 1, REF_SUB_MA_EMA2000, 2020.10, 5000, 1)
        w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 2)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 2)
        w06TbInvRaw(fx, 1, W06TB_INV_LOCAL_ROWS, 2)
    else if code == 4
        // F04 fixed-point chain: bridge1 2032.00 <-> bridge2 2034.00 <-> C 2036.00 (links of exactly M = 200 ticks);
        // the new Swing A at 2030.00 sees only bridge1: A -> bridge1 -> bridge2 -> C (3 hops, no iteration cap)
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2032.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2034.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2036.00, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbNewPointRowRaw(fx, 1, REF_CAT_SWING, 1, 5, 4000, 2030.00, REF_SWING_TF_MASK_1H)
        w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_SUPPORT_COUNT, 3)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_LOCAL_ROWS, 1)
    else if code == 5
        // F05 same bar: Swing NEW_ROOT (E2) + EMA2000 MA_UPDATE (E3) + TimeHL ROOT_RETIRE (E4), Production group order
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2040.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2040.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_MA, REF_SUB_MA_EMA2000, 1, 3000, 2040.10, 0, 0, 1, 0)
        w06TbPointRaw(fx, 4, REF_CAT_SWING, 1, 5, 4000, 2050.00, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbNewPointRowRaw(fx, 1, REF_CAT_SWING, 2, 5, 5000, 2040.20, REF_SWING_TF_MASK_5M)
        w06TbMaRowRaw(fx, 1, 3, REF_SUB_MA_EMA2000, 2040.15, 5000, 1)
        w06TbTargetRowRaw(fx, 1, W06FX_JOP_ROOT_RETIRE, 4, 2, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
    else if code == 6
        // F06 non-Broad FVG: Bull FVG [2060.00, 2060.40] with Swing / TimeHL inside (INSIDE), Bull FVG [2065.00, 2065.20]
        // with Swing 2065.50 above (PROXIMAL, 30 ticks); then the INSIDE FVG (Support side) is invalidated
        w06TbFvgRaw(fx, 1, 60, 1000, 2060.00, 2060.40, REF_FVG_BULLISH, false)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, 2000, 2060.20, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_TIMEHL, 0, 60, 3000, 2060.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbFvgRaw(fx, 4, 60, 4000, 2065.00, 2065.20, REF_FVG_BULLISH, false)
        w06TbPointRaw(fx, 5, REF_CAT_SWING, 1, 5, 5000, 2065.50, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbTargetRowRaw(fx, 1, W06FX_JOP_FVG_INVALIDATE, 1, 1, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
    else if code == 7
        // F07 shared Broad: two separate LOCAL components (2070.00 / 2070.30 and 2073.00 / 2073.20) both include the Broad
        // Bull FVG [2070.50, 2072.60] (sharing a Broad never joins them); then the Broad is invalidated (both LOCAL rows
        // and the BROAD_ONLY row affected; the Context seen union must equal FULL)
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2070.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2070.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2073.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 4, REF_CAT_TIMEHL, 0, 60, 4000, 2073.20, 0, 0, 0, 0)
        w06TbFvgRaw(fx, 5, 60, 5000, 2070.50, 2072.60, REF_FVG_BULLISH, true)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbTargetRowRaw(fx, 1, W06FX_JOP_FVG_INVALIDATE, 1, 5, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 2)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 3)
        w06TbInvRaw(fx, 1, W06TB_INV_LOCAL_ROWS, 2)
    else if code == 8
        // F08 Broad x Broad + Psych stream tie (Resistance mirror of S3): LOCAL head Swing 1999.20 + Broad Bear b1 TF 60
        // [1999.40, 2000.10] PROXIMAL vs BROAD_ONLY head b1 x Broad Bear b2 TF 1440 [1999.90, 2000.60] + Psych 2000.00:
        // 5 keys equal -> Resistance -1 (no 6th tie-break), FULL_FALLBACK, every row status OK
        w06TbFvgRaw(fx, 1, 60, 3000, 1999.40, 2000.10, REF_FVG_BEARISH, true)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, 1000, 1999.20, 0, 0, 0, 0)
        w06TbFvgRaw(fx, 3, 1440, 2000, 1999.90, 2000.60, REF_FVG_BEARISH, true)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_FULL_FALLBACK)
        w06TbInvRaw(fx, 0, W06TB_INV_RESISTANCE_COUNT, -1)
        w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, 1)
        w06TbInvRaw(fx, 0, W06TB_INV_NON_OK_STATUS_COUNT, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_CACHE_VALID, 1)
    else if code == 9
        // F09 distant Accum pair: upper (subtype 1) 2085.00 / lower (subtype 2) 2080.00, TF 240, pairKey 7 -> one LOCAL
        // component through the pair link; a TimeHL near the upper side, then the lower Accum retires (component splits)
        w06TbPointRaw(fx, 1, REF_CAT_ACCUM, W06FX_SUB_ACCUM_UPPER, REF_TF_4H, 1000, 2085.00, 0, 0, 0, 7)
        w06TbPointRaw(fx, 2, REF_CAT_ACCUM, W06FX_SUB_ACCUM_LOWER, REF_TF_4H, 2000, 2080.00, 0, 0, 0, 7)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2080.30, 0, 0, 0, 0)
        w06TbPointRaw(fx, 4, REF_CAT_SWING, 1, 5, 4000, 2085.20, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbNewPointRowRaw(fx, 1, REF_CAT_TIMEHL, 0, 60, 5000, 2085.10, 0)
        w06TbTargetRowRaw(fx, 2, W06FX_JOP_ROOT_RETIRE, 4, 2, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_LOCAL_ROWS, 1)
        w06TbInvRaw(fx, 2, W06TB_INV_LOCAL_ROWS, 2)
    else if code == 10
        // F10 confirmedTime only: EMA2000 MA_UPDATE with the same price / tick / slope and a new confirmedTime
        w06TbPointRaw(fx, 1, REF_CAT_MA, REF_SUB_MA_EMA2000, 1, 1000, 2090.00, 0, 0, 1, 0)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, 1000, 2090.20, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 2000, 2095.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 4, REF_CAT_TIMEHL, 0, 60, 3000, 2095.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbMaRowRaw(fx, 1, 1, REF_SUB_MA_EMA2000, 2090.00, 6000, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_TICK_CHANGED, 0)
    else if code == 11
        // F11 Swing TF merge: mask 5m (1) -> 5m + 1H (5), Swing becomes High
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2100.00, 0, REF_SWING_TF_MASK_5M, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2100.30, 0, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2105.00, 0, REF_SWING_TF_MASK_5M, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbTargetRowRaw(fx, 1, W06FX_JOP_SWING_TF_MERGE, 3, 1, REF_SWING_TF_MASK_5M + REF_SWING_TF_MASK_1H)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 1)
    else if code == 12
        // F12 cfgRevision 1 -> 2 only (no Root mutation): H03 forceFull, full component rebuild; then a no-op at 2
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2110.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2110.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, 2115.00, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 2, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 2, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbInvRaw(fx, 0, W06TB_INV_FORCE_FULL, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_FORCE_FULL, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_CACHE_VALID, 1)
        w06TbInvRaw(fx, 2, W06TB_INV_FORCE_FULL, 0)
        w06TbInvRaw(fx, 2, W06TB_INV_AFFECTED_COUNT, 0)
    else if code == 13
        // F13 FAILED_AMBIGUOUS (S1): Swing 2000.50 inside two identical non-Broad Bull FVGs [2000.00, 2000.80] TF 60
        // (T0+1000 / T0+2000): a 5-key tie inside one LOCAL component. Step 1 build, step 2 no change (status kept, no
        // component re-run), step 3 id3 retires (key change: OK, LOCAL).
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 3000, 2000.50, 0, 0, 0, 0)
        w06TbFvgRaw(fx, 2, 60, 1000, 2000.00, 2000.80, REF_FVG_BULLISH, false)
        w06TbFvgRaw(fx, 3, 60, 2000, 2000.00, 2000.80, REF_FVG_BULLISH, false)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
        w06TbTargetRowRaw(fx, 2, W06FX_JOP_ROOT_RETIRE, 4, 3, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_SUPPORT_STATUS, 1)
        w06TbInvRaw(fx, 0, W06TB_INV_CACHE_VALID, 1)
        w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, -1)
        w06TbInvRaw(fx, 0, W06TB_INV_RESISTANCE_COUNT, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_LOCAL_SUPPORT_STATUS, 1)
        w06TbInvRaw(fx, 1, W06TB_INV_AFFECTED_COUNT, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_CACHE_VALID, 1)
        w06TbInvRaw(fx, 2, W06TB_INV_LOCAL_SUPPORT_STATUS, 0)
        w06TbInvRaw(fx, 2, W06TB_INV_AFFECTED_COUNT, 1)
    else if code == 14
        // F14 capacity (S2): Swing 2000.10, TimeHL 2000.30 label 8 TF 60, Swing subtype 2 2000.20; every case on fresh
        // lanes: 14A 0 (structural), 14B 2 (small, structural), 14C K (LOCAL), 14D K - 1 (Resistance NOT_STORED),
        // capacity 16 (Support OK / Resistance NOT_STORED), capacity 8 (both NOT_STORED); every fallback invalidates the cache
        w06TbPointRaw(fx, 1, REF_CAT_SWING, 1, 5, 1000, 2000.10, 0, 0, 0, 0)
        w06TbPointRaw(fx, 2, REF_CAT_TIMEHL, 0, 60, 2000, 2000.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 2, 5, 3000, 2000.20, 0, 0, 0, 0)
        w06TbStepRaw(fx, 1, 0, true, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, 2, true, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, W06TB_CAPACITY_K, true, W06TB_RUN_LOCAL)
        w06TbStepRaw(fx, 1, W06TB_CAPACITY_K - 1, true, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, 16, true, W06TB_RUN_FULL_FALLBACK)
        w06TbStepRaw(fx, 1, 8, true, W06TB_RUN_FULL_FALLBACK)
        w06TbInvRaw(fx, 0, W06TB_INV_COMPONENT_ROWS, 0)
        w06TbInvRaw(fx, 0, W06TB_INV_CACHE_VALID, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_COMPONENT_ROWS, 0)
        w06TbInvRaw(fx, 1, W06TB_INV_CACHE_VALID, 0)
        w06TbInvRaw(fx, 2, W06TB_INV_LOCAL_SUPPORT_STATUS, 0)
        w06TbInvRaw(fx, 2, W06TB_INV_LOCAL_RESISTANCE_STATUS, 0)
        w06TbInvRaw(fx, 2, W06TB_INV_CACHE_VALID, 1)
        w06TbInvRaw(fx, 3, W06TB_INV_LOCAL_SUPPORT_STATUS, 0)
        w06TbInvRaw(fx, 3, W06TB_INV_LOCAL_RESISTANCE_STATUS, 2)
        w06TbInvRaw(fx, 3, W06TB_INV_CACHE_VALID, 0)
        w06TbInvRaw(fx, 4, W06TB_INV_LOCAL_SUPPORT_STATUS, 0)
        w06TbInvRaw(fx, 4, W06TB_INV_LOCAL_RESISTANCE_STATUS, 2)
        w06TbInvRaw(fx, 4, W06TB_INV_CACHE_VALID, 0)
        w06TbInvRaw(fx, 5, W06TB_INV_LOCAL_SUPPORT_STATUS, 2)
        w06TbInvRaw(fx, 5, W06TB_INV_LOCAL_RESISTANCE_STATUS, 2)
        w06TbInvRaw(fx, 5, W06TB_INV_CACHE_VALID, 0)
    else if code == 211 or code == 212 or code == 214
        // 21 common Roots in one LOCAL component: Broad Bull b1 TF 60 [1999.90, 2000.60], Broad Bull b2 TF 1440
        // [1999.40, 2000.10] (overlap [1999.90, 2000.10] holds Psych 2000.00), normal Swing, TimeHL, non-Broad Bull 4H FVG
        bool c21 = code == 214
        w06TbFvgRaw(fx, 1, 60, 1000, 1999.90, 2000.60, REF_FVG_BULLISH, true)
        w06TbFvgRaw(fx, 2, REF_TF_D, 2000, 1999.40, 2000.10, REF_FVG_BULLISH, true)
        w06TbPointRaw(fx, 3, REF_CAT_SWING, 1, 5, 3000, c21 ? 1999.45 : 2001.00, 0, 0, 0, 0)
        w06TbPointRaw(fx, 4, REF_CAT_TIMEHL, 0, 60, 4000, c21 ? 1999.20 : 2001.30, REF_TIMEHL_LABEL_PREV_DAY, 0, 0, 0)
        w06TbFvgRaw(fx, 5, REF_TF_4H, 5000, c21 ? 1998.90 : 2001.50, c21 ? 1999.10 : 2001.70, REF_FVG_BULLISH, false)
        if code == 211
            // 21A: b1 x b2 + Psych (OVERLAP, High, baseStrong, width 20) ranks above the normal Swing + TimeHL (width 30)
            w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
            w06TbInvRaw(fx, 0, W06TB_INV_FIRST_ROOT_MASK, 3)
            w06TbInvRaw(fx, 0, W06TB_INV_FIRST_BASE_STRONG, 1)
            w06TbInvRaw(fx, 0, W06TB_INV_FIRST_PSYCH, 1)
            w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 1)
        else if code == 212
            // 21B-1: b3 = a second Daily Bull Broad identical to b2 (same range / confirmedTime): b1 x b2 + Psych and b1 x b3 +
            // Psych have the same direct identity (primary b1, OVERLAP, same range) -> completion count 2 -> Support -1
            // (BROAD_ONLY row FAILED_AMBIGUOUS, FULL_FALLBACK, cache kept)
            w06TbFvgRaw(fx, 6, REF_TF_D, 2000, 1999.40, 2000.10, REF_FVG_BULLISH, true)
            w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_FULL_FALLBACK)
            w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, -1)
            w06TbInvRaw(fx, 0, W06TB_INV_BROAD_SUPPORT_STATUS, 1)
            w06TbInvRaw(fx, 0, W06TB_INV_CACHE_VALID, 1)
        else
            // 21C: Swing 1999.45 / TimeHL 1999.20 / 4H FVG [1998.90, 1999.10]: b1 / b2 are INCLUDED_BROAD but no normal
            // Candidate uses b1; b1 x b2 is seen by the Context scan -> no b1 / b2 BroadContext; seen union = FULL
            w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
            w06TbInvRaw(fx, 0, W06TB_INV_BROAD_CONTEXT_RECORDS, 0)
            w06TbInvRaw(fx, 0, W06TB_INV_FIRST_ROOT_MASK, 28)
            w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 1)
    else if code == 213 or code == 215
        // S3 geometry + the 21 normals: Broad Bull b1 TF 60 [1999.90, 2000.60], Swing 2000.80, Broad Bull b2 TF 1440
        // [1999.40, 2000.10], TimeHL 2001.30 (no label), non-Broad Bull 4H FVG [2001.50, 2001.70]
        bool gap = code == 215
        w06TbFvgRaw(fx, 1, 60, 3000, 1999.90, 2000.60, REF_FVG_BULLISH, true)
        w06TbPointRaw(fx, 2, REF_CAT_SWING, 1, 5, gap ? 4000 : 1000, 2000.80, 0, 0, 0, 0)
        w06TbFvgRaw(fx, 3, REF_TF_D, 2000, 1999.40, 2000.10, REF_FVG_BULLISH, true)
        w06TbPointRaw(fx, 4, REF_CAT_TIMEHL, 0, 60, 1500, 2001.30, 0, 0, 0, 0)
        w06TbFvgRaw(fx, 5, REF_TF_4H, 1600, 2001.50, 2001.70, REF_FVG_BULLISH, false)
        if code == 213
            // 21B-2: LOCAL head Swing + b1 PROXIMAL (Stage A) vs BROAD_ONLY head b1 x b2 + Psych (Stage B): different primary,
            // 5 keys equal (C 2, H 1, width 20, created T0+3000, minRootId 1) -> Support -1, FULL_FALLBACK, statuses OK
            w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_FULL_FALLBACK)
            w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, -1)
            w06TbInvRaw(fx, 0, W06TB_INV_NON_OK_STATUS_COUNT, 0)
            w06TbInvRaw(fx, 0, W06TB_INV_CACHE_VALID, 1)
            w06TbInvRaw(fx, 0, W06TB_INV_LOCAL_ROWS, 1)
        else
            // 21D: time gap (Swing confirmed T0+4000, after b1): b1 x b2 + Psych (created T0+3000) is the global best first;
            // the later Swing + b1 PROXIMAL with the same C / H / width follows without a false tie (LOCAL, no fallback)
            w06TbStepRaw(fx, 1, W06TB_CAP, false, W06TB_RUN_LOCAL)
            w06TbInvRaw(fx, 0, W06TB_INV_SUPPORT_COUNT, 6)
            w06TbInvRaw(fx, 0, W06TB_INV_FIRST_ROOT_MASK, 5)
            w06TbInvRaw(fx, 0, W06TB_INV_NON_OK_STATUS_COUNT, 0)
    fx

// H08 helper: (re)build every lane of a fixture by separate H01 calls; returns ok
w06TbBuildLanesRaw(W06TbLanes ln, W06TbFixture fx, float mintick) =>
    [aR, aC, aW, aJ, aOk] = w06BuildProductionArraysRaw(fx.roots, fx.originKeys, mintick)
    [bR, bC, bW, bJ, bOk] = w06BuildProductionArraysRaw(fx.roots, fx.originKeys, mintick)
    [v2R, v2C, v2W, v2J, v2Ok] = w06BuildProductionArraysRaw(array.new<RefRoot>(), array.new_int(0), mintick)
    [v3R, v3C, v3W, v3J, v3Ok] = w06BuildProductionArraysRaw(array.new<RefRoot>(), array.new_int(0), mintick)
    ln.frA  := aR
    ln.fcA  := aC
    ln.fwA  := aW
    ln.fjA  := aJ
    ln.frB  := bR
    ln.fcB  := bC
    ln.fwB  := bW
    ln.fjB  := bJ
    ln.fcV2 := v2C
    ln.fcV3 := v3C
    ln.ok   := aOk and bOk and v2Ok and v3Ok
    ln.ok

// H08 helper: the step's journal rows into one lane's own journal (targets resolved by rootId in that lane)
w06TbFillJournalRaw(W06FxJournal jj, W06FxRoots rr, W06TbFixture fx, int step) =>
    array.clear(jj.journalOps)
    array.clear(jj.journalGroups)
    array.clear(jj.journalTargetRootSlots)
    array.clear(jj.journalExpectedRootIds)
    array.clear(jj.journalCategories)
    array.clear(jj.journalSubtypes)
    array.clear(jj.journalTfCodes)
    array.clear(jj.journalOriginKeys)
    array.clear(jj.journalOriginTimes)
    array.clear(jj.journalConfirmedTimes)
    array.clear(jj.journalPointPrices)
    array.clear(jj.journalNativeBottoms)
    array.clear(jj.journalNativeTops)
    array.clear(jj.journalDirections)
    array.clear(jj.journalIsBroadFlags)
    array.clear(jj.journalNewMasks)
    array.clear(jj.journalPairKeys)
    array.clear(jj.journalSlopeDirs)
    int filled = 0
    int k = 0
    while k < array.size(fx.rowStep)
        if array.get(fx.rowStep, k) == step
            int op    = array.get(fx.rowOp, k)
            int tid   = array.get(fx.rowTarget, k)
            int tslot = op == W06FX_JOP_NEW_ROOT ? W06FX_SLOT_INVALID : map.contains(rr.rootIdToSlot, tid) ? map.get(rr.rootIdToSlot, tid) : W06FX_SLOT_INVALID
            array.push(jj.journalOps, op)
            array.push(jj.journalGroups, array.get(fx.rowGroup, k))
            array.push(jj.journalTargetRootSlots, tslot)
            array.push(jj.journalExpectedRootIds, op == W06FX_JOP_NEW_ROOT ? W06FX_ID_NONE : tid)
            array.push(jj.journalCategories, array.get(fx.rowCat, k))
            array.push(jj.journalSubtypes, array.get(fx.rowSub, k))
            array.push(jj.journalTfCodes, array.get(fx.rowTf, k))
            array.push(jj.journalOriginKeys, W06FX_ID_NONE)
            array.push(jj.journalOriginTimes, array.get(fx.rowConf, k))
            array.push(jj.journalConfirmedTimes, array.get(fx.rowConf, k))
            array.push(jj.journalPointPrices, array.get(fx.rowPrice, k))
            array.push(jj.journalNativeBottoms, array.get(fx.rowNb, k))
            array.push(jj.journalNativeTops, array.get(fx.rowNt, k))
            array.push(jj.journalDirections, array.get(fx.rowDir, k))
            array.push(jj.journalIsBroadFlags, array.get(fx.rowBroad, k))
            array.push(jj.journalNewMasks, array.get(fx.rowMask, k))
            array.push(jj.journalPairKeys, array.get(fx.rowPair, k))
            array.push(jj.journalSlopeDirs, array.get(fx.rowSlope, k))
            filled += 1
        k += 1
    jj.journalCount := filled
    filled

// H08 helper: lane A / B Root audit (same live Roots: rootId, live flag, category, state, point price / tick, confirmedTime)
w06TbLaneSameRaw(W06FxRoots frA, W06FxRoots frB) =>
    bool laneSame = array.size(frA.rootIds) == array.size(frB.rootIds)
    int  q = 0
    while laneSame and q < array.size(frA.rootIds)
        int   aTick = array.get(frA.rootPointTicks, q)
        int   bTick = array.get(frB.rootPointTicks, q)
        float aPr   = array.get(frA.rootPointPrices, q)
        float bPr   = array.get(frB.rootPointPrices, q)
        int   aConf = array.get(frA.rootConfirmedTimes, q)
        int   bConf = array.get(frB.rootConfirmedTimes, q)
        laneSame := array.get(frA.rootIds, q) == array.get(frB.rootIds, q) and array.get(frA.rootSlotLiveFlags, q) == array.get(frB.rootSlotLiveFlags, q) and array.get(frA.rootCategories, q) == array.get(frB.rootCategories, q) and array.get(frA.rootStates, q) == array.get(frB.rootStates, q)
        laneSame := laneSame and ((na(aTick) and na(bTick)) or (not na(aTick) and not na(bTick) and aTick == bTick)) and ((na(aPr) and na(bPr)) or (not na(aPr) and not na(bPr) and aPr == bPr)) and ((na(aConf) and na(bConf)) or (not na(aConf) and not na(bConf) and aConf == bConf))
        q += 1
    laneSame

// H08 helper (lane C input): the W04 RefRoot array of one lane's current Root state, live slots in slot (= rootId) order,
// every field copied as stored; maSlopeDir = the stored EMA2000 / EMA3000 slope of the slot that EMA reference points at
// (0 for any other MA Root). Nothing is read from a Candidate result.
w06TbRefRootsRaw(W06FxRoots fr) =>
    array<RefRoot> out = array.new<RefRoot>()
    int s = 0
    while s < array.size(fr.rootIds)
        if array.get(fr.rootSlotLiveFlags, s)
            int slope = s == fr.ema2000RootSlot ? fr.ema2000SlopeDir : s == fr.ema3000RootSlot ? fr.ema3000SlopeDir : 0
            array.push(out, RefRoot.new(rootId = array.get(fr.rootIds, s), category = array.get(fr.rootCategories, s), subtype = array.get(fr.rootSubtypes, s), tfCode = array.get(fr.rootTfCodes, s), originTime = array.get(fr.rootOriginTimes, s), confirmedTime = array.get(fr.rootConfirmedTimes, s), pointPrice = array.get(fr.rootPointPrices, s), pointTick = array.get(fr.rootPointTicks, s), nativeBottom = array.get(fr.rootNativeBottoms, s), nativeTop = array.get(fr.rootNativeTops, s), nativeBottomTick = array.get(fr.rootNativeBottomTicks, s), nativeTopTick = array.get(fr.rootNativeTopTicks, s), state = array.get(fr.rootStates, s), pairKey = array.get(fr.rootPairKeys, s), direction = array.get(fr.rootDirections, s), isBroadFvg = array.get(fr.rootIsBroadFvgFlags, s), labelMask = array.get(fr.rootLabelMasks, s), swingTfMask = array.get(fr.rootSwingTfMasks, s), maSlopeDir = slope))
        s += 1
    out

// H08 helper: lane C for one lane: the W04 Reference of both Sides on that lane's Roots (M / dense ticks as the Worker
// derives them from clusterMaxWidth / denseRatio), compared with that lane's Candidate result by H06
w06TbCompareReferenceRaw(W06FxRoots fr, W06FxCand fc, int supportCount, int resistanceCount, float mintick, float clusterMaxWidth, float denseRatio) =>
    array<RefRoot>   refRoots      = w06TbRefRootsRaw(fr)
    int              mTick         = int(math.round(clusterMaxWidth / mintick))
    int              denseTick     = int(math.round((clusterMaxWidth * denseRatio) / mintick))
    array<RefResult> refSupport    = array.new<RefResult>()
    array<RefResult> refResistance = array.new<RefResult>()
    int refSupportCount    = refBuildReferenceResults(refRoots, REF_SIDE_SUPPORT, denseTick, mTick, mintick, refSupport)
    int refResistanceCount = refBuildReferenceResults(refRoots, REF_SIDE_RESISTANCE, denseTick, mTick, mintick, refResistance)
    [m, f, i] = w06CompareWithReferenceRaw(fc, supportCount, resistanceCount, refSupportCount, refSupport, refResistanceCount, refResistance)
    [m, f, i]

// H08 helper: status of the first component row of `kind` (support true: Support Side); -1 when no such row
w06TbRowStatusRaw(W06FxComp fw, int kind, bool support) =>
    int st = -1
    bool found = false
    int r = 0
    while not found and r < array.size(fw.candComponentKinds)
        if array.get(fw.candComponentKinds, r) == kind
            st    := support ? array.get(fw.candComponentSupportStatuses, r) : array.get(fw.candComponentResistanceStatuses, r)
            found := true
        r += 1
    st

// H08 helper: observed value of one invariant code on lane A after the step (stored state only; no Candidate logic)
w06TbObserveRaw(int kind, W06FxComp fw, W06FxCand fc, int supportCount, int resistanceCount, int runMode, bool forceFull, bool laneOk, bool laneSame, array<float> prevPrices, array<int> prevBottoms, array<int> prevTops) =>
    int recN = math.min(fc.candidateWinnerLogicalCount, array.size(fc.candidateWinnerSides))
    int v = int(na)
    if kind == W06TB_INV_RUN_MODE
        v := runMode
    else if kind == W06TB_INV_LANE_OK
        v := laneOk ? 1 : 0
    else if kind == W06TB_INV_ROOT_LANE
        v := laneSame ? 1 : 0
    else if kind == W06TB_INV_SUPPORT_COUNT
        v := supportCount
    else if kind == W06TB_INV_RESISTANCE_COUNT
        v := resistanceCount
    else if kind == W06TB_INV_CACHE_VALID
        v := fw.candComponentCacheValid ? 1 : 0
    else if kind == W06TB_INV_FORCE_FULL
        v := forceFull ? 1 : 0
    else if kind == W06TB_INV_AFFECTED_COUNT
        v := fw.candAffectedComponentCount
    else if kind == W06TB_INV_LOCAL_SUPPORT_STATUS
        v := w06TbRowStatusRaw(fw, W06TB_KIND_LOCAL, true)
    else if kind == W06TB_INV_LOCAL_RESISTANCE_STATUS
        v := w06TbRowStatusRaw(fw, W06TB_KIND_LOCAL, false)
    else if kind == W06TB_INV_BROAD_SUPPORT_STATUS
        v := w06TbRowStatusRaw(fw, W06TB_KIND_BROAD_ONLY, true)
    else if kind == W06TB_INV_NON_OK_STATUS_COUNT or kind == W06TB_INV_COMPONENT_ROWS or kind == W06TB_INV_LOCAL_ROWS
        int n = 0
        int r = 0
        while r < array.size(fw.candComponentKinds)
            if kind == W06TB_INV_NON_OK_STATUS_COUNT
                n += (array.get(fw.candComponentSupportStatuses, r) != 0 ? 1 : 0) + (array.get(fw.candComponentResistanceStatuses, r) != 0 ? 1 : 0)
            else if kind == W06TB_INV_COMPONENT_ROWS
                n += 1
            else if array.get(fw.candComponentKinds, r) == W06TB_KIND_LOCAL
                n += 1
            r += 1
        v := n
    else if kind == W06TB_INV_REF_PRICE_CHANGED or kind == W06TB_INV_TICK_CHANGED
        int n = 0
        int i = 0
        while i < recN and i < array.size(prevPrices)
            if kind == W06TB_INV_REF_PRICE_CHANGED
                float p = array.get(fc.candidateWinnerReferencePrices, i)
                float q = array.get(prevPrices, i)
                n += ((na(p) and na(q)) or (not na(p) and not na(q) and p == q)) ? 0 : 1
            else
                int b0 = array.get(prevBottoms, i)
                int t0 = array.get(prevTops, i)
                int b1 = array.get(fc.candidateWinnerEffectiveBottomTicks, i)
                int t1 = array.get(fc.candidateWinnerEffectiveTopTicks, i)
                bool same = ((na(b0) and na(b1)) or (not na(b0) and not na(b1) and b0 == b1)) and ((na(t0) and na(t1)) or (not na(t0) and not na(t1) and t0 == t1))
                n += same ? 0 : 1
            i += 1
        v := n
    else if kind == W06TB_INV_BROAD_CONTEXT_RECORDS
        int n = 0
        int i = 0
        while i < recN
            n += array.get(fc.candidateWinnerFvgModes, i) == REF_FVG_RANGE_BROAD_CONTEXT ? 1 : 0
            i += 1
        v := n
    else if recN > 0 and kind == W06TB_INV_FIRST_ROOT_MASK
        int off  = array.get(fc.candidateWinnerRootIdOffsets, 0)
        int len  = array.get(fc.candidateWinnerRootIdLengths, 0)
        int mask = 0
        int g = 0
        while g < len and off + g < array.size(fc.candidateWinnerRootIds)
            mask += int(math.pow(2, array.get(fc.candidateWinnerRootIds, off + g) - 1))
            g += 1
        v := mask
    else if recN > 0 and kind == W06TB_INV_FIRST_BASE_STRONG
        v := array.get(fc.candidateWinnerBaseStrongFlags, 0) ? 1 : 0
    else if recN > 0 and kind == W06TB_INV_FIRST_PSYCH
        v := na(array.get(fc.candidateWinnerPsychLevelTicks, 0)) ? 0 : 1
    v

// H08 helper: failure bookkeeping. count > 0 adds to the total; the first failing fixture adds 1 to fixtureFailures once;
// only the first failure's fixture / step / compare / field / index are kept (never overwritten).
w06TbFailRaw(W06TbOut o, int count, int fixture, int step, int compare, int field, int index) =>
    if count > 0
        o.failures := o.failures + count
        if not o.fixtureFailed
            o.fixtureFailed   := true
            o.fixtureFailures := o.fixtureFailures + 1
        if o.firstCompare == W06TB_COMPARE_NONE
            o.firstFixture := fixture
            o.firstStep    := step
            o.firstCompare := compare
            o.firstField   := field
            o.firstIndex   := index
    count > 0

// H08 per-fixture runner: every step of fixture `code` on its own lanes (rebuilt by H01 at step 0 and at every fresh
// step): Root audit, the step journal into each lane's own journal, H03 (lane A), H04 (lane B + W05 /2 /3), H05 A vs B,
// H06 A vs C and B vs C (C built from each lane's Roots), H05 W05 /2 vs /3, expected runMode, invariants.
w06TbRunFixtureRaw(W06TbOut o, int code) =>
    float mintick         = 0.01
    float clusterMaxWidth = 2.0
    float denseRatio      = 0.25
    W06TbFixture fx = w06FixtureStepsRaw(code)
    W06TbLanes   ln = W06TbLanes.new()
    array<float> prevPrices  = array.new_float(0)
    array<int>   prevBottoms = array.new_int(0)
    array<int>   prevTops    = array.new_int(0)
    o.fixtureFailed := false
    int step = 0
    while step < fx.stepCount
        if step == 0 or array.get(fx.stepFresh, step)
            w06TbBuildLanesRaw(ln, fx, mintick)
            array.clear(prevPrices)
            array.clear(prevBottoms)
            array.clear(prevTops)
        bool laneSame = w06TbLaneSameRaw(ln.frA, ln.frB)
        w06TbFillJournalRaw(ln.fjA, ln.frA, fx, step)
        w06TbFillJournalRaw(ln.fjB, ln.frB, fx, step)
        int  cfgRevision = array.get(fx.stepCfgRevisions, step)
        int  capacity    = array.get(fx.stepCapacities, step)
        bool forceFull   = not ln.fwA.candComponentCacheValid or ln.fwA.candComponentCacheCfgRevision != cfgRevision
        [okO, sO, rO, modeO] = w06RunOptimizedRaw(ln.frA, ln.fcA, ln.fwA, ln.fjA, cfgRevision, mintick, clusterMaxWidth, denseRatio, true, true, true, true, true, true, capacity)
        [okC, w6S, w6R, v2S, v2R, v3S, v3R] = w06RunCacheOffRaw(ln.frB, ln.fcB, ln.fwB, ln.fjB, ln.fcV2, ln.fcV3, cfgRevision, mintick, clusterMaxWidth, denseRatio, true, true, true, true, true, true, capacity)
        o.fullRuns := o.fullRuns + 1
        if modeO == W06TB_RUN_LOCAL
            o.localRuns := o.localRuns + 1
        else if modeO == W06TB_RUN_FULL_FALLBACK
            o.fallbackRuns := o.fallbackRuns + 1
        bool laneOk = ln.ok and okO and okC
        [m1, f1, i1] = w06CompareWinnersRaw(ln.fcA, sO, rO, ln.fcB, w6S, w6R)
        w06TbFailRaw(o, m1, code, step, W06TB_COMPARE_LOCAL_VS_FULL, f1, i1)
        [m2, f2, i2] = w06TbCompareReferenceRaw(ln.frA, ln.fcA, sO, rO, mintick, clusterMaxWidth, denseRatio)
        o.referenceRuns := o.referenceRuns + 1
        w06TbFailRaw(o, m2, code, step, W06TB_COMPARE_LOCAL_VS_REFERENCE, f2, i2)
        [m3, f3, i3] = w06TbCompareReferenceRaw(ln.frB, ln.fcB, w6S, w6R, mintick, clusterMaxWidth, denseRatio)
        o.referenceRuns := o.referenceRuns + 1
        w06TbFailRaw(o, m3, code, step, W06TB_COMPARE_FULL_VS_REFERENCE, f3, i3)
        [m4, f4, i4] = w06CompareWinnersRaw(ln.fcV2, v2S, v2R, ln.fcV3, v3S, v3R)
        if m4 > 0
            o.w05Failures := o.w05Failures + 1
        w06TbFailRaw(o, m4, code, step, W06TB_COMPARE_W05_V2_VS_V3, f4, i4)
        w06TbFailRaw(o, modeO == array.get(fx.stepExpectedRunModes, step) ? 0 : 1, code, step, W06TB_COMPARE_EXPECTED_RUNMODE, W06TB_INV_RUN_MODE, modeO)
        w06TbFailRaw(o, laneOk ? 0 : 1, code, step, W06TB_COMPARE_FIXTURE_INVARIANT, W06TB_INV_LANE_OK, 0)
        w06TbFailRaw(o, laneSame ? 0 : 1, code, step, W06TB_COMPARE_FIXTURE_INVARIANT, W06TB_INV_ROOT_LANE, 0)
        int q = 0
        while q < array.size(fx.invStep)
            if array.get(fx.invStep, q) == step
                int kind     = array.get(fx.invKind, q)
                int expected = array.get(fx.invExpected, q)
                int observed = w06TbObserveRaw(kind, ln.fwA, ln.fcA, sO, rO, modeO, forceFull, laneOk, laneSame, prevPrices, prevBottoms, prevTops)
                bool same = (na(observed) and na(expected)) or (not na(observed) and not na(expected) and observed == expected)
                w06TbFailRaw(o, same ? 0 : 1, code, step, W06TB_COMPARE_FIXTURE_INVARIANT, kind, observed)
            q += 1
        // lane A record snapshot for the next step's change invariants
        array.clear(prevPrices)
        array.clear(prevBottoms)
        array.clear(prevTops)
        int r = 0
        while r < ln.fcA.candidateWinnerLogicalCount and r < array.size(ln.fcA.candidateWinnerSides)
            array.push(prevPrices, array.get(ln.fcA.candidateWinnerReferencePrices, r))
            array.push(prevBottoms, array.get(ln.fcA.candidateWinnerEffectiveBottomTicks, r))
            array.push(prevTops, array.get(ln.fcA.candidateWinnerEffectiveTopTicks, r))
            r += 1
        step += 1
    o.fixtureFailed

// H08 w06RunTestB : conformance Test B over every fixture, in order F01 .. F14, 21A, 21B-1, 21B-2, 21C, 21D (one call per
// fixture, no fixture loop). Returns the W06TbOut counters: failures (sum of every H05 / H06 mismatch count and of every
// failed expected runMode / invariant), fixtureFailures (at most 1 per fixture), the first failure (fixture code, step
// inside the fixture, compare code, field code of that compare, index), Local / Fallback Runs (H03 runMode 1 / 2), Full
// Runs (H04 calls), Reference Runs (H06 calls), W05 V2V3 Failures (steps whose /2 vs /3 H05 mismatched) and K.
w06RunTestB() =>
    W06TbOut o = W06TbOut.new()
    o.capacityK := W06TB_CAPACITY_K
    w06TbRunFixtureRaw(o, 1)
    w06TbRunFixtureRaw(o, 2)
    w06TbRunFixtureRaw(o, 3)
    w06TbRunFixtureRaw(o, 4)
    w06TbRunFixtureRaw(o, 5)
    w06TbRunFixtureRaw(o, 6)
    w06TbRunFixtureRaw(o, 7)
    w06TbRunFixtureRaw(o, 8)
    w06TbRunFixtureRaw(o, 9)
    w06TbRunFixtureRaw(o, 10)
    w06TbRunFixtureRaw(o, 11)
    w06TbRunFixtureRaw(o, 12)
    w06TbRunFixtureRaw(o, 13)
    w06TbRunFixtureRaw(o, 14)
    w06TbRunFixtureRaw(o, 211)
    w06TbRunFixtureRaw(o, 212)
    w06TbRunFixtureRaw(o, 213)
    w06TbRunFixtureRaw(o, 214)
    w06TbRunFixtureRaw(o, 215)
    o

// Test B runs once on the last bar (fixture only; chart data is never an input)
varip bool w06TestBDone            = false
varip int  w06TestBFailures        = 0
varip int  w06TestBFixtureFailures = 0
varip int  w06TestBFirstFixture    = 0
varip int  w06TestBFirstStep       = -1
varip int  w06TestBFirstCompare    = 0
varip int  w06TestBFirstField      = 0
varip int  w06TestBFirstIndex      = -1
varip int  w06TestBLocalRuns       = 0
varip int  w06TestBFullRuns        = 0
varip int  w06TestBReferenceRuns   = 0
varip int  w06TestBFallbackRuns    = 0
varip int  w06TestBW05Failures     = 0
varip int  w06TestBCapacityK       = 0
if barstate.islast and not w06TestBDone
    w06TestBDone := true
    W06TbOut w06Tb = w06RunTestB()
    w06TestBFailures        := w06Tb.failures
    w06TestBFixtureFailures := w06Tb.fixtureFailures
    w06TestBFirstFixture    := w06Tb.firstFixture
    w06TestBFirstStep       := w06Tb.firstStep
    w06TestBFirstCompare    := w06Tb.firstCompare
    w06TestBFirstField      := w06Tb.firstField
    w06TestBFirstIndex      := w06Tb.firstIndex
    w06TestBLocalRuns       := w06Tb.localRuns
    w06TestBFullRuns        := w06Tb.fullRuns
    w06TestBReferenceRuns   := w06Tb.referenceRuns
    w06TestBFallbackRuns    := w06Tb.fallbackRuns
    w06TestBW05Failures     := w06Tb.w05Failures
    w06TestBCapacityK       := w06Tb.capacityK
plot(w06TestBFailures,        title = "W06 Test B Failures",               display = display.data_window)
plot(w06TestBFixtureFailures, title = "W06 Test B Fixture Failures",       display = display.data_window)
plot(w06TestBFirstFixture,    title = "W06 Test B First Fail Fixture",     display = display.data_window)
plot(w06TestBFirstStep,       title = "W06 Test B First Fail Step",        display = display.data_window)
plot(w06TestBFirstCompare,    title = "W06 Test B First Compare",          display = display.data_window)
plot(w06TestBFirstField,      title = "W06 Test B First Field",            display = display.data_window)
plot(w06TestBFirstIndex,      title = "W06 Test B First Index",            display = display.data_window)
plot(w06TestBLocalRuns,       title = "W06 Test B Local Runs",             display = display.data_window)
plot(w06TestBFullRuns,        title = "W06 Test B Full Runs",              display = display.data_window)
plot(w06TestBReferenceRuns,   title = "W06 Test B Reference Runs",         display = display.data_window)
plot(w06TestBFallbackRuns,    title = "W06 Test B Fallback Runs",          display = display.data_window)
plot(w06TestBW05Failures,     title = "W06 Test B W05 V2V3 Failures",      display = display.data_window)
plot(w06TestBCapacityK,       title = "W06 Test B Capacity Boundary K",    display = display.data_window)
plot(na, title = "Compile anchor", display = display.none)

breakTf = input.timeframe("5", "Break Evaluation Timeframe", group = G_BF,
     tooltip = "Breakはヒゲではなくこの時間足の確定終値で判定する。")
breakBuffer = input.float(10.0,  "Break Buffer ($)",         step = 0.5, group = G_BF)
flipConfirmDist = input.float(5.0, "Flip Confirm Distance ($)", step = 0.5, group = G_BF)
resetOnReclaim = input.bool(true,  "Reset Broken on Reclaim", group = G_BF,
     tooltip = "Role Reversal Mode = Retest Confirmed のときだけ使う (BROKEN 中に反対側へ明確に戻ったら役割を初期判定に戻す)。\n" +
     "Confirmed Break では使わない (反対方向の明確な Break がそのまま役割を切り替え、確認待ちを破棄する)。")
roleMode = input.string("Retest Confirmed", "Role Reversal Mode", options = ["Retest Confirmed", "Confirmed Break"], group = G_BF,
     tooltip = "Confirmed Break (比較・切り戻し用): Break 評価足の確定終値が top + Break Buffer より上なら Support 候補、bottom - Break Buffer\n" +
     "より下なら Resistance 候補にその足で切り替える (等値は不成立。BROKEN で待たない)。Retest → Flip Confirm の反転確認は別に継続し、\n" +
     "Flip イベント・Flip Bonus は確認成立時だけ。Retest Confirmed (初期): 変更前の方式 (Break → BROKEN → Retest → Flip Confirm)。\n" +
     "Gold Short の比較から採用した初期値。検証継続中で、最適値・将来の有効性は未確認。")
trackStaleBars = input.int(500, "Zone State Retention (bars without match)", minval = 10, group = G_BF)
trackContinuity = input.float(0.5, "Zone Track · Min Source Continuity", minval = 0.01, maxval = 1.0, step = 0.05, group = G_BF)


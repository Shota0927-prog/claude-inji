// ============================================================================
// EXTERNAL DATA FEED
// ============================================================================
// ---- 3.2 Zone Engine Feed --------------------------------------------------
// ★ MA2000 / MA3000 : zn.maPack() を 1分足コンテキストで評価させる。
//   maPack() の中身は ta.ema(close, 2000) 等であり、この close は1分足のclose。
//   → 5分足closeからの再計算ではない。
//  ★ Source が OFF のときは取得自体を行わない (結果不変・下の理由による) ★
//    Library 側は MA / Swing / Accum のどれも
//      「c.useXxxSource が true」かつ「値が na でない」
//    ときにしか Zone を登録しない。OFF のとき取得値は元々一切使われていないため、
//    na を渡すのと実測値を渡すのは Zone 時系列に対して完全に等価。
//    エッジ検出 (nPh1 / nAc1 等) も not na(...) を要求するので false のまま。
float ma1Val   = na
float ma1Delta = na
float ma2Val   = na
float ma2Delta = na
if is5mChart and useMaSource
    [_m1, _m1d, _m2, _m2d] = request.security(syminfo.tickerid, maTf,
         zn.maPack(maType, ma1Len, ma2Len, slopeLookback), lookahead = barmerge.lookahead_off)
    ma1Val   := _m1
    ma1Delta := _m1d
    ma2Val   := _m2
    ma2Delta := _m2d

// ==== NR-S1 Swing (begin) ====================================================
//  Swing 15M / 1H の非リペイント化 (NR-S1)。
//  ・チャート足より上位の Swing TF は、zn.pivotPack の各フィールドを [1] (= 直前の確定 HTF 足) にして
//    lookahead_on で取得する。HTF k の確定値は「次に実在する HTF 期間の最初の5分足」から読める
//    (履歴 / リアルタイムとも同じ)。形成中 HTF 足の値・後で消える Pivot は Engine に届かない。
//  ・Pivot の検知式 / パラメータ (zn.pivotPack / pivLen) は不変。値・Pivot 時刻キーも同じで、届く足だけが変わる:
//      連続取引 +1本 (5分) / HTF 確定がセッション終了と一致 -> 休場 + 5分 / HTF 最後の5分枠が欠損 -> 0。
//  ・チャート足と同じ / 下位の TF は従来の request (lookahead_off) のまま。
f_nrsPivotConfirmed(simple int len) =>
    [_ph, _pt, _pl, _lt] = zn.pivotPack(len)
    [_ph[1], _pt[1], _pl[1], _lt[1]]

f_nrsSwing(simple string tf, simple int len) =>
    float h  = na
    int   ht = na
    float l  = na
    int   lt = na
    if timeframe.in_seconds(tf) > timeframe.in_seconds()
        [_a, _at, _b, _bt] = request.security(syminfo.tickerid, tf, f_nrsPivotConfirmed(len), lookahead = barmerge.lookahead_on)
        h  := _a
        ht := _at
        l  := _b
        lt := _bt
    else
        [_a, _at, _b, _bt] = request.security(syminfo.tickerid, tf, zn.pivotPack(len), lookahead = barmerge.lookahead_off)
        h  := _a
        ht := _at
        l  := _b
        lt := _bt
    [h, ht, l, lt]
// ==== NR-S1 Swing (end) ======================================================

float ph1 = na
int   ph1T = na
float pl1 = na
int   pl1T = na
float ph2 = na
int   ph2T = na
float pl2 = na
int   pl2T = na
float ph3 = na
int   ph3T = na
float pl3 = na
int   pl3T = na
if is5mChart and useHzSource
    [_h1, _h1t, _l1, _l1t] = request.security(syminfo.tickerid, hzTf1, zn.pivotPack(pivLen1), lookahead = barmerge.lookahead_off)
    [_h2, _h2t, _l2, _l2t] = f_nrsSwing(hzTf2, pivLen2)
    [_h3, _h3t, _l3, _l3t] = f_nrsSwing(hzTf3, pivLen3)
    ph1 := _h1
    ph1T := _h1t
    pl1 := _l1
    pl1T := _l1t
    ph2 := _h2
    ph2T := _h2t
    pl2 := _l2
    pl2T := _l2t
    ph3 := _h3
    ph3T := _h3t
    pl3 := _l3
    pl3T := _l3t

// ==== NR-A1 Accum (begin) ====================================================
//  Accum 1H / 4H / D の非リペイント化 (NR-A1)。
//  ・下の f_nra* 4関数は ZoneEnginePractical.pine の f_accumBoxCore / f_accumBoxState /
//    f_accumDetectProvisional / accumPack の写し (形成式・Hi / Lo・ID = time・Provisional は同一)。
//    差分は関数名と、f_accumBoxState の `if barstate.isconfirmed` ガードの除去 (本体を1段浅く) だけ
//    (fixture NR-A1 が Library 本文との機械照合で固定)。ガードの代わりに出力 3 値を HTF 側で [1] にし
//    lookahead_on で取得するので、Engine に届くのは確定した HTF 足の状態だけ (request 内の
//    barstate.isconfirmed に依存しない。var は tick ごとに巻き戻り、確定時の最終値だけが残る)。
//  ・届く足: HTF 確定後の最初の5分足 (連続 +1本 / 休場・週末明け / 最後の5分枠欠損なら 0)。
//  ・チャート足と同じ / 下位の TF は従来の request (zn.accumPack, lookahead_off) のまま。
//  ・1H / 4H / D は別々の request 呼び出し = 別々の var 状態 (TF 間で共有しない)。
f_nraAccumBoxCore(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _atr = ta.atr(atrLen)

    _bodyTop   = math.max(open, close)
    _bodyBot   = math.min(open, close)
    _rangeHigh = ta.highest(_bodyTop, rangeLen)
    _rangeLow  = ta.lowest(_bodyBot, rangeLen)
    _rangeNow  = _rangeHigh - _rangeLow
    _rangeMid  = (_rangeHigh + _rangeLow) * 0.5

    _upperCloses = 0
    _lowerCloses = 0
    _bullRun = 0
    _bearRun = 0
    _maxBullRun = 0
    _maxBearRun = 0

    for i = 0 to rangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        _isBull = close[i] > open[i]
        _isBear = close[i] < open[i]

        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0

        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)

    _startMid = (open[rangeLen - 1] + close[rangeLen - 1]) * 0.5
    _endMid   = (open + close) * 0.5
    _drift    = math.abs(_endMid - _startMid)

    _condAtr = _atr > 0 and _rangeNow <= _atr * atrMult

    _bodyTopNow = math.max(open, close)
    _bodyBotNow = math.min(open, close)
    _rangeShort = ta.highest(_bodyTopNow, rangeLen) - ta.lowest(_bodyBotNow, rangeLen)
    _rangeBase  = ta.highest(_bodyTopNow, baseLen)  - ta.lowest(_bodyBotNow, baseLen)

    _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * barRatioMax
    _condBalance  = _upperCloses >= minUpper and _lowerCloses >= minLower
    _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= driftMax
    _condColorRun = _maxBullRun <= maxRun and _maxBearRun <= maxRun

    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

f_nraAccumBoxState(simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax) =>
    _isAccum   = f_nraAccumBoxCore(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    _accumHigh = ta.highest(math.max(open, close), rangeLen)
    _accumLow  = ta.lowest(math.min(open, close), rangeLen)
    _isStart   = _isAccum and not nz(_isAccum[1], false)

    var float _top = na
    var float _bot = na
    var int   _sid = na

    if _isStart
        _top := _accumHigh
        _bot := _accumLow
        _sid := time
    if _isAccum
        _bt = math.max(open, close)
        _bb = math.min(open, close)
        _top := math.max(nz(_top, _bt), _bt)
        _bot := math.min(nz(_bot, _bb), _bb)

    [_sid, _top, _bot]

f_nraAccumDetectProvisional(simple int len, float mult) =>
    float hh   = ta.highest(high, len)
    float ll   = ta.lowest(low,  len)
    float atrv = ta.atr(len)
    bool  isAcc = not na(atrv) and atrv > 0 and (hh - ll) <= atrv * mult
    [hh, ll, isAcc]

f_nraAccumPack(simple bool usePorted, simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax,
     simple int provLen, float provMult) =>
    [pSid, pTop, pBot] = f_nraAccumBoxState(rangeLen, baseLen, atrLen, minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax)
    [qHi, qLo, qIsAcc] = f_nraAccumDetectProvisional(provLen, provMult)
    bool qNew = qIsAcc and not qIsAcc[1]
    var int qSid = na
    if not nz(qIsAcc[1], false)
        qSid := int(na)
    if nz(qNew[1], false)
        qSid := time[1]

    float upper  = usePorted ? pTop : qHi[1]
    float lower  = usePorted ? pBot : qLo[1]
    int   instId = usePorted ? pSid : qSid
    [upper, lower, instId]

f_nraAccumConfirmed(simple bool usePorted, simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax,
     simple int provLen, float provMult) =>
    [_u, _l, _i] = f_nraAccumPack(usePorted, rangeLen, baseLen, atrLen, minUpper, minLower, maxRun,
         atrMult, barRatioMax, driftMax, provLen, provMult)
    [_u[1], _l[1], _i[1]]

f_nraAccum(simple string tf, simple bool usePorted, simple int rangeLen, simple int baseLen, simple int atrLen,
     simple int minUpper, simple int minLower, simple int maxRun,
     float atrMult, float barRatioMax, float driftMax,
     simple int provLen, float provMult) =>
    float u  = na
    float l  = na
    int   id = na
    if timeframe.in_seconds(tf) > timeframe.in_seconds()
        [_a, _b, _c] = request.security(syminfo.tickerid, tf, f_nraAccumConfirmed(usePorted, rangeLen, baseLen, atrLen,
             minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax, provLen, provMult), lookahead = barmerge.lookahead_on)
        u  := _a
        l  := _b
        id := _c
    else
        [_a, _b, _c] = request.security(syminfo.tickerid, tf, zn.accumPack(usePorted, rangeLen, baseLen, atrLen,
             minUpper, minLower, maxRun, atrMult, barRatioMax, driftMax, provLen, provMult), lookahead = barmerge.lookahead_off)
        u  := _a
        l  := _b
        id := _c
    [u, l, id]
// ==== NR-A1 Accum (end) ======================================================

bool usePortedAccum = accumModule == "Accum Box (ported)"
float acc1Hi = na
float acc1Lo = na
int   acc1Id = na
float acc2Hi = na
float acc2Lo = na
int   acc2Id = na
float acc3Hi = na
float acc3Lo = na
int   acc3Id = na
if is5mChart and useAccSource
    [_a1h, _a1l, _a1i] = f_nraAccum(accTf1,
         usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen1, accMult)
    [_a2h, _a2l, _a2i] = f_nraAccum(accTf2,
         usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen2, accMult)
    [_a3h, _a3l, _a3i] = f_nraAccum(accTf3,
         usePortedAccum, accumRangeLen, accumBaseLen, accumAtrLen, accumMinUpperCloses, accumMinLowerCloses,
         accumMaxSameColorRun, accumAtrMult, accumBarRatioMax, accumDriftMax, accLen3, accMult)
    acc1Hi := _a1h
    acc1Lo := _a1l
    acc1Id := _a1i
    acc2Hi := _a2h
    acc2Lo := _a2l
    acc2Id := _a2i
    acc3Hi := _a3h
    acc3Lo := _a3l
    acc3Id := _a3i

// Break判定は breakTf の「確定終値」のみ (ヒゲでは判定しない)
//  ★ Practical Break authority:
//    Break判定TFの「確定足自身の close」で、その確定イベントのバーに Break を成立させる。
//    旧版は確定足の値を「次のチャートバー」で [1] 参照していたため、評価前に
//    f_naturalState (現在 close) が state を上書きしてしまい、確定足自身の close による
//    Break が成立しなかった (Zoneの幅や位置が動いた時しか Break しない)。
//
//  (1) Break TF == チャート足 : request.security を使わない。
//      brClose = close / brHigh = high / brLow = low / brEval = barstate.isconfirmed
//      Historical は全バー確定。Realtime はバー確定tickだけ評価 (途中tickでは Break しない)。
//  (2) Break TF  > チャート足 : request.security を1本 (lookahead_off = 先読みなし)。
//      上位足を締めるチャートバー (time_close >= time_close(breakTf)) の確定時に、
//      その上位足の確定 close / high / low で1回だけ評価する。
//      lookahead_off の上位足値は、その上位足を締めるチャートバーで確定値になる
//      (Historical / Realtime 確定tick とも)。未確定の上位足 close では評価しない。
//      Break evaluation path はこの1本だけ (別経路での再評価・補完はしない)。
//  (3) Break TF  < チャート足 : 旧版の経路のまま (今回の修正対象外)。
float brClose = na
float brHigh  = na
float brLow   = na
bool  brEval  = false
//  ★ 5分足専用: Break の取得・評価は 5分足チャートでだけ行う (中身は従来どおり)。
//    5分足以外では brClose / brHigh / brLow = na、brEval = false のまま。
if is5mChart
    int   brTfSec   = timeframe.in_seconds(breakTf)
    int   chTfSec   = timeframe.in_seconds()
    bool  brSameTf  = brTfSec == chTfSec
    bool  brHtf     = brTfSec > chTfSec
    float brSrcC = close
    float brSrcH = high
    float brSrcL = low
    if not brSameTf
        [_bc, _bh, _bl] = request.security(syminfo.tickerid, breakTf, [close, high, low],
             lookahead = barmerge.lookahead_off)
        brSrcC := _bc
        brSrcH := _bh
        brSrcL := _bl
    int   brTfTime    = time(breakTf)
    bool  brNewPeriod = bar_index > 0 and not na(brTfTime) and nz(ta.change(brTfTime), 0) != 0
    if brSameTf
        if barstate.isconfirmed
            brClose := close
            brHigh  := high
            brLow   := low
            brEval  := true
    else if brHtf
        bool brClosesNow = not na(time_close(breakTf)) and time_close >= time_close(breakTf)
        if barstate.isconfirmed and brClosesNow
            brClose := brSrcC
            brHigh  := brSrcH
            brLow   := brSrcL
            brEval  := not na(brClose)
    else
        // Break TF < チャート足 : 旧版の経路 (変更なし)
        brClose := brNewPeriod ? brSrcC[1] : na
        brHigh  := brNewPeriod ? brSrcH[1] : na
        brLow   := brNewPeriod ? brSrcL[1] : na
        brEval  := brNewPeriod and not na(brClose)

// 取引日ID (timestamp/hour の timezone は series 不可なので呼び出し側で計算する)
//  ★ 5分足専用: 計算式は従来どおり。5分足以外では na のまま。
int tradingDayId = na
if is5mChart
    int _locY = year(time, dayTz)
    int _locM = month(time, dayTz)
    int _locD = dayofmonth(time, dayTz)
    int _locH = hour(time, dayTz)
    int _calDayNo    = int(timestamp(dayTz, _locY, _locM, _locD, 0, 0) / 86400000)
    tradingDayId := _locH < dayResetHour ? _calDayNo - 1 : _calDayNo

zn.ZoneFeed zoneFeed = zn.ZoneFeed.new(
     ma1 = ma1Val, ma1d = ma1Delta, ma2 = ma2Val, ma2d = ma2Delta,
     ph1 = ph1, ph1t = ph1T, pl1 = pl1, pl1t = pl1T,
     ph2 = ph2, ph2t = ph2T, pl2 = pl2, pl2t = pl2T,
     ph3 = ph3, ph3t = ph3T, pl3 = pl3, pl3t = pl3T,
     acc1Hi = acc1Hi, acc1Lo = acc1Lo, acc1Id = acc1Id,
     acc2Hi = acc2Hi, acc2Lo = acc2Lo, acc2Id = acc2Id,
     acc3Hi = acc3Hi, acc3Lo = acc3Lo, acc3Id = acc3Id,
     dayId = tradingDayId,
     brClose = brClose, brHigh = brHigh, brLow = brLow, brEval = brEval)

//  ★ 5分足専用: 5分足以外では zn.update を呼ばない (空データを入れるのではなく状態遷移自体を行わない)。
int zoneCountNow = 0

//  ★ XA-21: calc_on_every_tick = true でも Engine 更新は確定足だけ (GBPJPY 等と同じ。未確定 tick の更新は巻き戻されるだけで、
//    確定時の結果は同じ)。毎 tick の Engine 更新・Zone 走査をしない。
if is5mChart and barstate.isconfirmed
    zoneCountNow := zn.update(zoneEng, zoneCfg, zoneFeed)

// ==== FVG Batch A (begin) =====================================================
//  FVG (15M / 1H / 4H) の取得・保存・無効化だけ (FVG実装仕様書 v1.0 + A01 + A02 / Batch A)。
//  ・Zone Engine (zn.*) とは一切接続しない。既存 Zone の Source / Score / Track / Touch / 描画は不変。
//  ・HTF 値は request 内で各フィールドを [1] にし lookahead_on で取得 = 直前の確定HTF足だけ。
//    request 内で barstate.isconfirmed は使わない。未確定HTF値は読まない。
//  ・保存状態は確定5M足でだけ更新する (未確定 tick では何も変えない = ロールバックに依存しない)。
//  ・Batch A では表示しない (Box / Label / 相互加点は後続 Batch)。
string FVG_TF15         = "15"
string FVG_TF60         = "60"
string FVG_TF240        = "240"
fvgMinWidth = input.float(3.0, "FVG Min Width ($)", minval = 0.0, step = 0.5, group = "02 · FVG (XAUUSD)",
     tooltip = "15M / 1H / 4H FVG の最小幅 (USD、mintick 正規化後に以上)。初期 3.0 = 従来の固定値。\n" +
     "検知・保存・完全埋め・寿命の処理は同じ。")
fvgDirMatch = input.bool(false, "FVG Direction Match", group = "02 · FVG (XAUUSD)",
     tooltip = "OFF: 従来どおり (向きを問わず重なる FVG から最良 1 個)。\n" +
     "ON: SUPPORT の Zone は上昇 FVG だけ、RESIST の Zone は下降 FVG だけを候補にしてから、上位 TF 優先・同 TF は新しい方で 1 個選ぶ。\n" +
     "その他の State は従来どおり。FVG の保存・寿命・埋め・幅・点数・Confluence・昇格範囲の式は同じ。")
float  FVG_MIN_WIDTH    = fvgMinWidth
int    FVG_SLOTS_PER_TF = 5
int    FVG_HOUR_MS      = 3600000

// HTF context で評価。各フィールドの1本前 (= 確定済みの HTF 足) を返す。
//   dir : +1 上昇FVG / -1 下降FVG / 0 なし
//   上昇 : low > high[2]  top = low     bottom = high[2]
//   下降 : high < low[2]  top = low[2]  bottom = high
//   幅は math.round_to_mintick で最小値幅に正規化して minWidth 以上
//   戻り値 : [形成足の開始時刻 (イベントキー), 形成足の確定時刻, 確定終値, dir, top, bottom]
f_fvgConfirmed(float minWidth) =>
    bool  _bull = low > high[2]
    bool  _bear = high < low[2]
    float _top  = _bull ? low : _bear ? low[2] : na
    float _bot  = _bull ? high[2] : _bear ? high : na
    int   _dir  = (_bull or _bear) and math.round_to_mintick(_top - _bot) >= minWidth ? (_bull ? 1 : -1) : 0
    [time[1], time_close[1], close[1], _dir[1], _top[1], _bot[1]]

// 保存: TF ごとに固定 5 スロット (15M = 0-4 / 1H = 5-9 / 4H = 10-14)。var で1回だけ確保。
var array<float> gFvgTop     = array.new_float(15, na)
var array<float> gFvgBot     = array.new_float(15, na)
var array<int>   gFvgDir     = array.new_int(15, 0)
var array<int>   gFvgOpenT   = array.new_int(15, na)     // 形成足の開始時刻 (= HTF イベントキー)
var array<int>   gFvgCloseT  = array.new_int(15, na)     // 形成足の確定時刻 (寿命の起点)
var array<int>   gFvgExpire  = array.new_int(15, na)
var array<bool>  gFvgAlive   = array.new_bool(15, false)
var array<int>   gFvgLastKey = array.new_int(3, na)      // TF 別: 処理済みの直近 HTF イベントキー
var int          gFvgNextExpire = na                     // 生存 FVG の最小 expire 以下の下限 (na = なし)

// 期限切れ: 確定5M足の終了時刻 >= expire で削除。戻り値 = 残りの最小 expire。
f_fvgExpire(int nowClose) =>
    int nextExp = na
    for s = 0 to 3 * FVG_SLOTS_PER_TF - 1
        if array.get(gFvgAlive, s)
            int ex = array.get(gFvgExpire, s)
            if nowClose >= ex
                array.set(gFvgAlive, s, false)
            else
                nextExp := na(nextExp) ? ex : math.min(nextExp, ex)
    nextExp

// 1 TF 分の HTF 確定イベント処理。新しいイベントキーのときだけ:
//   完全埋め (この確定足の終値。形成足自身は対象外) -> 新規登録 -> 上限 (空きが無ければ最古を置換)
//   戻り値 = 新規登録した FVG の expire (登録なしは na)
f_fvgOnEvent(int tfIdx, int key, int closeT, float htfClose, int dir, float top, float bot, int lifeMs, int nowClose) =>
    int regExpire = na
    int lastKey = array.get(gFvgLastKey, tfIdx)
    if not na(key) and (na(lastKey) or key != lastKey)
        int base = tfIdx * FVG_SLOTS_PER_TF
        for k = 0 to FVG_SLOTS_PER_TF - 1
            int s = base + k
            if array.get(gFvgAlive, s) and array.get(gFvgOpenT, s) < key
                int d = array.get(gFvgDir, s)
                if (d == 1 and htfClose < array.get(gFvgBot, s)) or (d == -1 and htfClose > array.get(gFvgTop, s))
                    array.set(gFvgAlive, s, false)
        if dir != 0 and not na(closeT) and nowClose < closeT + lifeMs
            int slot = -1
            int oldest = -1
            for k = 0 to FVG_SLOTS_PER_TF - 1
                int s = base + k
                // Pine v5 は and / or の両辺を評価するため、-1 判定と array.get を同じ式に書かない
                if not array.get(gFvgAlive, s)
                    if slot < 0
                        slot := s
                else if oldest < 0
                    oldest := s
                else if array.get(gFvgOpenT, s) < array.get(gFvgOpenT, oldest)
                    oldest := s
            if slot < 0
                slot := oldest
            array.set(gFvgTop, slot, top)
            array.set(gFvgBot, slot, bot)
            array.set(gFvgDir, slot, dir)
            array.set(gFvgOpenT, slot, key)
            array.set(gFvgCloseT, slot, closeT)
            array.set(gFvgExpire, slot, closeT + lifeMs)
            array.set(gFvgAlive, slot, true)
            regExpire := closeT + lifeMs
        array.set(gFvgLastKey, tfIdx, key)
    regExpire

f_fvgMinExp(int a, int b) =>
    na(b) ? a : na(a) ? b : math.min(a, b)

if is5mChart
    [q15T, q15Tc, q15C, q15D, q15Top, q15Bot] = request.security(syminfo.tickerid, FVG_TF15,
         f_fvgConfirmed(FVG_MIN_WIDTH), lookahead = barmerge.lookahead_on)
    [q60T, q60Tc, q60C, q60D, q60Top, q60Bot] = request.security(syminfo.tickerid, FVG_TF60,
         f_fvgConfirmed(FVG_MIN_WIDTH), lookahead = barmerge.lookahead_on)
    [q240T, q240Tc, q240C, q240D, q240Top, q240Bot] = request.security(syminfo.tickerid, FVG_TF240,
         f_fvgConfirmed(FVG_MIN_WIDTH), lookahead = barmerge.lookahead_on)
    // 保存状態の更新は確定5M足だけ。順序: 期限切れ -> 15M -> 1H -> 4H (各: 完全埋め -> 登録 -> 上限)
    if barstate.isconfirmed
        int nowClose = time_close
        if not na(gFvgNextExpire) and nowClose >= gFvgNextExpire
            gFvgNextExpire := f_fvgExpire(nowClose)
        gFvgNextExpire := f_fvgMinExp(gFvgNextExpire, f_fvgOnEvent(0, q15T, q15Tc, q15C, q15D, q15Top, q15Bot, 72 * FVG_HOUR_MS, nowClose))
        gFvgNextExpire := f_fvgMinExp(gFvgNextExpire, f_fvgOnEvent(1, q60T, q60Tc, q60C, q60D, q60Top, q60Bot, 168 * FVG_HOUR_MS, nowClose))
        gFvgNextExpire := f_fvgMinExp(gFvgNextExpire, f_fvgOnEvent(2, q240T, q240Tc, q240C, q240D, q240Top, q240Bot, 336 * FVG_HOUR_MS, nowClose))
// ==== FVG Batch A (end) =======================================================

// ==== ZONE Strategy · Zone evaluation (begin) =========================================
//  ZONE-P の FVG 加点 (Batch C) と重複範囲限定昇格の判定を、同じ関数 / 同じ式で Strategy に持つ。
//  下の 6 関数は ZoneVisualPractical.pine の同名関数の byte コピー (fixture st1_sim が固定)。
f_fvcConf(int catCount) =>
    catCount >= 4 ? confBonus4 : catCount == 3 ? confBonus3 : catCount == 2 ? confBonus2 : 0.0


f_fvcStrengthOf(float score, bool hasHtf) =>
    int t = score < thrMedium ? SR_WEAK : score < thrStrong ? SR_MEDIUM : score < thrVStrong ? SR_STRONG : SR_VSTRONG
    if t == SR_VSTRONG and requireHtfForVStrong and not hasHtf
        t := SR_STRONG
    t


f_fvcBase(int slot) =>
    math.floor(slot / FVG_SLOTS_PER_TF) + 1.0


f_fvcOverlap(float aTop, float aBot, float bTop, float bBot) =>
    math.min(aTop, bTop) > math.max(aBot, bBot)


f_fvcZoneDisplay(zn.Zone z) =>
    int best = -1
    // FVG Direction Match: 方向で候補を絞ってから選ぶ (選んだ後に除外しない)。OFF / SUPPORT・RESIST 以外は want = 0
    int want = fvgDirMatch ? (z.state == ST_SUPPORT ? 1 : z.state == ST_RESIST ? -1 : 0) : 0
    for s = 0 to 3 * FVG_SLOTS_PER_TF - 1
        if array.get(gFvgAlive, s) and (want == 0 or array.get(gFvgDir, s) == want)
            if f_fvcOverlap(z.top, z.bottom, array.get(gFvgTop, s), array.get(gFvgBot, s))
                if best < 0
                    best := s
                else if f_fvcBase(s) > f_fvcBase(best)
                    best := s
                else if f_fvcBase(s) == f_fvcBase(best)
                    if array.get(gFvgCloseT, s) > array.get(gFvgCloseT, best)
                        best := s
    float dScore = z.score
    int   dStr   = z.strength
    if best >= 0
        dScore := z.baseSum + f_fvcBase(best) + z.slopeBonus + z.maBonus + z.flipBonus + f_fvcConf(z.catCount + 1)
        dStr   := f_fvcStrengthOf(dScore, z.hasHtf)
    [dScore, dStr]


f_zpoBestFvg(zn.Zone z) =>
    int best = -1
    // FVG Direction Match: 方向で候補を絞ってから選ぶ (選んだ後に除外しない)。OFF / SUPPORT・RESIST 以外は want = 0
    int want = fvgDirMatch ? (z.state == ST_SUPPORT ? 1 : z.state == ST_RESIST ? -1 : 0) : 0
    for s = 0 to 3 * FVG_SLOTS_PER_TF - 1
        if array.get(gFvgAlive, s) and (want == 0 or array.get(gFvgDir, s) == want)
            if f_fvcOverlap(z.top, z.bottom, array.get(gFvgTop, s), array.get(gFvgBot, s))
                if best < 0
                    best := s
                else if f_fvcBase(s) > f_fvcBase(best)
                    best := s
                else if f_fvcBase(s) == f_fvcBase(best)
                    if array.get(gFvgCloseT, s) > array.get(gFvgCloseT, best)
                        best := s
    best


//  ZONE-P と同じ値を Entry 判定用に返す (表示はしない)。
//  ・元 Zone      : zn.zoneAt の z.score / z.strength (Engine 内部値、Zone 全体 [z.bottom, z.top])。
//                   Touch / Track / Break / Flip もこの値に基づく (ZONE-P と同一)。
//  ・FVG 加点後   : f_fvcZoneDisplay (Batch C) の dScore / dStr。採用 FVG = f_zpoBestFvg (同じ選択)。
//  ・昇格範囲     : boosted (dStr > z.strength) のときだけ [max(z.bottom, fvgBot), min(z.top, fvgTop)]
//                   (ZONE-P の重複範囲限定表示と同じ式)。昇格しないときは na。
//  ・FVG 重複範囲 : 採用 FVG があれば昇格の有無に関係なく同じ交差範囲 (無ければ na)。
//  ・Pine v5 は and / or の両辺を評価するため、-1 判定と array.get を同じ式に書かない。
f_stZoneEval(zn.Zone z) =>
    [dScore, dStr] = f_fvcZoneDisplay(z)
    int  best    = f_zpoBestFvg(z)
    bool boosted = best >= 0 and dStr > z.strength
    float oTop = z.top
    float oBot = z.bottom
    if boosted
        oTop := math.min(z.top, array.get(gFvgTop, best))
        oBot := math.max(z.bottom, array.get(gFvgBot, best))
    float bTop = boosted ? oTop : na
    float bBot = boosted ? oBot : na
    float vTop = na
    float vBot = na
    if best >= 0
        vTop := math.min(z.top, array.get(gFvgTop, best))
        vBot := math.max(z.bottom, array.get(gFvgBot, best))
    [dScore, dStr, best, boosted, bTop, bBot, vTop, vBot]

// ---- ST-3 · 反発 Entry (A / B / C / D)、時間帯、反対側 Zone の TP、建値移動 ------------------------------
//  ・選択した Entry Mode だけを実行する。同時に持つ注文 (保留 / 保有) は 1 件、同じ Track は 1 回まで (約定時に記録)。
//  ・候補 Zone: SUPPORT (Long) / RESIST (Short) で、元 Strength >= Strong、または FVG 昇格範囲の Strength >= Strong。
//  ・A: 足 t の更新後の候補で、終値が Zone の外にあるとき指値 L を置く (元 Strong = Zone 端、昇格範囲だけ Strong =
//       昇格範囲の端)。期限・差し替えなし。未約定の間は毎確定足で「同じ Track が live、State 有効、L が Zone 内で
//       L での Strength (元 / 昇格) >= Strong、時間帯内」を確認し、外れたら取り消す (足の途中の約定は取り消せない)。
//  ・B / C: 足 t−1 の確定時に保存した候補に足 t の高値安値が接触し、終値が Zone の外で確定 (Long は > top)。
//       C はさらに包み足またはピンバー。足 t の更新後も Track が live で同じ State のときだけ次足成行。
//  ・D: 確定 1分足が、その 5分足の 1 本前の確定時の候補 Zone に外から接触したら待機を始め、接触から最安値
//       (Short は最高値) までの高値の最大 (Short は安値の最小) を確定 1分足の終値が越えたら BOS。待機は 5分足を
//       またいで持ち越し、接触後の確定 1分足が期限本数に達するか、候補 Zone でなくなったら解除する。BOS が出た
//       5分足の確定時に、Zone が有効で終値が Zone の外なら次足成行で発注する (1分足の BOS 時点では約定させない)。
//  ・新規 Entry (発注と保留中の指値) は時間帯の中だけ。保有中の SL / TP / 建値管理は時間外も続ける。
//  ・SL = 元 Zone の反対端 ∓ Buffer。Entry と同時に発注し、建値移動以外では動かさない。
//  ・TP: 約定を確認した足の確定時に、実約定価格から決める (約定した足の中では TP は無い)。
//       利益方向で最も手前の反対側 Zone (Medium 以上) の RR が Min 未満 → TP を置かず成行決済 (見送り)、
//       Min 以上 Max 未満 → その Zone を TP、Max 以上または該当 Zone なし → 固定 RR。
//       発注前にも参照価格 (A: 指値 / B, C, D: 足 t の終値) で同じ判定をし、Min 未満なら発注しない。
//       リスク <= 0 (約定価格が SL の不適切な側) なら TP を置かず成行決済を試みる。
//  ・建値移動: 確定足の高値 (Long) / 安値 (Short) が約定価格 ± Trigger に届いたら、stop を約定価格へ移す。
//       移した stop は次の足から有効。足の途中で約定した指値の約定足は終値だけで判定する。
var string G_ST = "03 · Strategy Entry"
stMode = input.string("C: Candle Pattern", "Entry Mode",
     options = ["A: Touch Limit", "B: Confirmed Rejection", "C: Candle Pattern", "D: 1M BOS Rebound"], group = G_ST)
stDir = input.string("Short Only", "Direction", options = ["Long Only", "Short Only", "Both"], group = G_ST)
stBuffer = input.float(1.5, "SL Buffer ($)", minval = 0.0, step = 0.5, group = G_ST)
stPinRatio = input.float(2.0, "C · Pin Bar Wick / Body", minval = 0.5, step = 0.5, group = G_ST)
stDWait = input.int(30, "D · BOS Wait (confirmed 1M bars)", minval = 1, group = G_ST)
var string G_STW = "03 · Strategy Entry Timing (SATS)"
stTiming = input.string("SATS Pullback", "Entry Timing", options = ["Current", "SATS Pullback"], group = G_STW,
     tooltip = "Current: 変更前の発注方式 (比較・切り戻し用)。SATS Pullback が初期 (Gold Short の比較から採用した初期値。検証継続中で、最適値・将来の有効性は未確認)。\n" +
     "SATS Pullback: 選択した Entry Mode (A〜D) が発注する条件を満たした足で発注せず待機を始め、次の 5分足以降に SATS 線\n" +
     "(LINE1 / LINE2 / STB) への\n" +
     "接触と終値での戻りを確認してから成行で発注する。SL0 / TP0 は準備時に固定 (約定後に TP を作り直さない)。\n" +
     "P0: A は元の指値価格 (指値注文は出さない) / B・C・D はその確定足の終値。D は既存の 1分足 BOS 確認後に待機を始める。")
stSatsWait = input.int(240, "SATS · 待機期限 (分)", minval = 1, group = G_STW,
     tooltip = "準備した 5分足の終了時刻からの実時間。この分数以上になった確定評価時点で取消 (週末・欠損・時間帯外も時計は止めない)。")
stSatsShow = input.bool(true, "SATS · 線を表示", group = G_STW)
stSatsBody = input.bool(true, "SATS · 反発確認足の陽線／陰線を要求", group = G_STW,
     tooltip = "XA-11 (初期 ON = Gold Short の比較から採用した初期値。検証継続中で、最適値・将来の有効性は未確認。OFF は比較・切り戻し用)。ON: 発注を判断する 5分足自身が Long は close > open / Short は close < open (同値足は不成立)。\n" +
     "その足で既存の反発 A または B と同時に成立したときだけ発注する。不成立でも待機と接触記録は残す (過去の反発は保存しない)。")
stSatsNear = input.bool(true, "SATS · 近接を接触扱い", group = G_STW,
     tooltip = "XA-11 (初期 ON = Gold Short の比較から採用した初期値。検証継続中で、最適値・将来の有効性は未確認。OFF は比較・切り戻し用)。ON: 実接触 (low <= L <= high) に加え、線 L (足 t-1 の確定値) の手前までの接近も接触とする。\n" +
     "Short: high < L かつ L − high <= 許容距離 / Long: low > L かつ low − L <= 許容距離。終値の戻りは元の線 L で判定する。")
stSatsNearD = input.float(1.0, "SATS · 近接許容距離 ($)", minval = 0.0, step = 0.5, group = G_STW,
     tooltip = "XAUUSD の価格差 (ドル)。ATR・pips・終値と線の距離ではない。0 なら実接触だけと同じ。\n" +
     "初期 1.0 (Gold Short の比較から採用した初期値。検証継続中で、最適値・将来の有効性は未確認)。")
stSatsFD  = input.bool(false, "SATS 逆方向一致 · 日足を判定に使用", group = G_STW,
     tooltip = "XA-13 (初期: 4H・1H ON / 日足・15分・5分 OFF = Gold Short の比較から採用した初期値・検証継続中。全て OFF = フィルターなし)。\n" +
     "SATS 反発後の最終発注判定で、ON にした時間足が\n" +
     "すべて逆方向のバンド (Short: 全て青 / Long: 全て赤) のときだけ見送る。無点灯・反対色・計算未成立が 1 つでもあれば見送らない。\n" +
     "バンド = その時間足の終値が LINE1 / LINE2 / STB の 3 本すべてより上 (青) / 下 (赤)。上位足は直近の確定足の状態だけを使う。")
stSatsF4  = input.bool(true, "SATS 逆方向一致 · 4時間足を判定に使用", group = G_STW)
stSatsF1  = input.bool(true, "SATS 逆方向一致 · 1時間足を判定に使用", group = G_STW)
stSatsF15 = input.bool(false, "SATS 逆方向一致 · 15分足を判定に使用", group = G_STW)
stSatsF5  = input.bool(false, "SATS 逆方向一致 · 5分足を判定に使用", group = G_STW,
     tooltip = "5分足は発注を判断するその 5分足の確定時点の SATS バンド (この Strategy の SATS 計算をそのまま使う)。")
stSatsNow = input.bool(true, "SATS · 直近の反発で即時エントリー", group = G_STW,
     tooltip = "XA-16 (初期 ON = Gold Short の比較から採用した初期値。Long・将来の有効性は未確認。OFF は比較・切り戻し用)。SATS Pullback の待機を準備する足 t で、同方向の SATS 反発 (A / B と同じ価格条件、近接 /\n" +
     "陽線陰線の設定を共用) が 接触→反発 0 <= e − q <= Nc で成立済みで、反発→Zone 0 <= t − e <= Nz なら、引きつけずにその足で成行。\n" +
     "この足の時間帯・逆方向一致・注文なし・数量 (終値と SL0)・SL / TP の向きが必要。成立しなければ従来どおり待機を始める。")
stSatsNowC = input.int(1, "SATS · 即時側：接触→反発の有効本数", minval = 0, step = 1, group = G_STW,
     tooltip = "接触足 q から反発成立足 e まで 0 <= e − q <= Nc (境界を含む、5分足の本数。0 = 接触した足の反発だけ)。超えた接触記録\n" +
     "からは B を成立させない (保持中の再接触で q を延ばさない。期限切れ後の新しい接触は新しい起点)。他の本数入力とは独立。")
stSatsNowN = input.int(1, "SATS · 即時側：反発→Zoneの有効本数", minval = 0, step = 1, group = G_STW,
     tooltip = "反発成立足 e から Zone 条件成立足 t まで 0 <= t − e <= Nz (境界を含む、5分足の本数。0 = 反発した足の Zone 成立だけ)。\n" +
     "成立済みの反発は、接触から時間が経っても t − e <= Nz の間は候補に残る。他の本数入力とは独立。")
stSatsTq = input.bool(false, "SATS · 引きつけ側：接触期限を使う", group = G_STW,
     tooltip = "XA-17 比較用 (初期 OFF = 従来の引きつけ待機)。ON: 待機中の最初の適格な接触から t − q > 有効本数 になったら接触記録と\n" +
     "保持線を解除して接触待ちへ戻る (待機自体・待機開始時刻・SATS 待機期限は変えない。再接触で起点を延長しない)。")
stSatsTqN = input.int(1, "SATS · 引きつけ側：接触→反発の有効本数", minval = 0, step = 1, group = G_STW,
     tooltip = "待機中の接触足 q から反発・発注判断足 e まで 0 <= e − q <= N (境界を含む、5分足の本数)。接触期限 ON のときだけ。\n" +
     "反発した足で発注条件を確認する (反発後にさらに待つことはしない)。即時側の本数とは独立。")
var string G_STS = "03 · Strategy Session (新規 Entry のみ)"
stUseSess = input.bool(true, "Limit New Entries to Session", group = G_STS)
stSessTz = input.string("Asia/Tokyo", "Session Timezone", group = G_STS)
stSessStartH = input.int(9, "Session Start Hour", minval = 0, maxval = 23, group = G_STS)
stSessStartM = input.int(0, "Session Start Minute", minval = 0, maxval = 59, group = G_STS)
stSessEndH = input.int(2, "Session End Hour", minval = 0, maxval = 23, group = G_STS)
stSessEndM = input.int(0, "Session End Minute", minval = 0, maxval = 59, group = G_STS)
var string G_STA = "03 · Strategy Alerts"
stAlertProv = input.bool(true, "仮アラート (形成中の5分足・未確定)", group = G_STA,
     tooltip = "XA-21: 形成中の 5分足がこのまま確定したら発注になる条件 (SATS 引きつけ / SATS 即時 / Current) の予告。注文・状態は変えない。\n" +
     "確定時に不成立になる場合あり (そのときは確定アラートなし)。待機の準備だけでは出さない。1 本の 5分足につき最大 1 回。\n" +
     "新規 Entry の時間帯の中だけ (判定足の終了時刻と送信時の実時刻の両方)。TradingView の Alert は「alert() function calls only」で作成。")
stAlertConf = input.bool(true, "確定アラート (5分足確定時の発注成立)", group = G_STA,
     tooltip = "XA-21: 5分足の確定時に strategy.entry を出した分岐 (SATS 引きつけ / SATS 即時 / Current) で 1 回。約定通知ではない。\n" +
     "1 本の 5分足につき最大 1 回 (仮アラートの有無・ON / OFF とは独立)。通知の重複防止は発注を止めない。")
var string G_STT = "03 · Strategy TP / Breakeven"
stTpZone = input.bool(false, "TP · Nearest Opposite Zone (Medium+)", group = G_STT)
stTpMinRR = input.float(1.0, "TP Zone · Min RR (未満は見送り)", minval = 0.0, step = 0.1, group = G_STT)
stTpMaxRR = input.float(3.0, "TP Zone · Max RR (以上は固定 RR)", minval = 0.1, step = 0.1, group = G_STT)
stRR = input.float(1.5, "TP Fixed RR", minval = 0.1, step = 0.1, group = G_STT)
stBE = input.bool(true, "Breakeven Stop", group = G_STT)
stBEDist = input.float(15.0, "Breakeven Trigger ($)", minval = 0.0, step = 0.5, group = G_STT)
stBEMode = input.string("Fixed Distance", "Breakeven Trigger Mode", options = ["Fixed Distance", "Risk Multiple", "TP Progress"], group = G_STT,
     tooltip = "XA-15 比較用 (初期 Fixed Distance = 従来の固定幅 Breakeven Trigger ($))。選択した方式の入力だけを使う。\n" +
     "Risk Multiple: 1R = 実約定価格から初期 SL までの距離。含み益が 1R × 倍率に届いたら建値へ。\n" +
     "TP Progress: 実約定価格から実際に設定した TP までの距離 × 比率 (0.5TP = TP までの半分進んだ)。TP 価格や TP Fixed RR に掛けない。\n" +
     "RR 方式 / TP 比率方式でも判断・注文更新は従来の確定 5分足処理 (Long は high / Short は low、等値で成立、次の足から有効)。")
stBER = input.float(1.0, "Breakeven Trigger (R)", minval = 0.1, step = 0.1, group = G_STT)
stBETp = input.float(0.5, "Breakeven Trigger (TP Ratio)", minval = 0.05, maxval = 1.0, step = 0.05, group = G_STT)
var string G_STQ = "03 · Strategy Position Size (単利・損失予算)"
stCapBase = input.float(300000.0, "元金基準額 (円)", minval = 0.0, step = 10000.0, group = G_STQ,
     tooltip = "単利: 予定損失予算はこの基準額 × 損失率で固定 (strategy.equity・残高に連動しない)。strategy の初期資金とは別の入力。")
stRiskPct = input.float(3.0, "損失率 (%)", minval = 0.0, step = 0.1, group = G_STQ)
stLotOz = input.float(100.0, "1 lot のオンス数", minval = 0.0001, step = 1.0, group = G_STQ)
stLotMin = input.float(0.01, "最小 lot", minval = 0.0001, step = 0.01, group = G_STQ)
stLotStep = input.float(0.01, "lot 刻み", minval = 0.0001, step = 0.01, group = G_STQ,
     tooltip = "lot はこの刻みで切り捨て。最小 lot 未満なら発注しない (切り上げない)。")
float stBudget = stCapBase * stRiskPct / 100.0     // 予定損失予算 (円、毎回固定)

// 数量: 円の予算を strategy.convert_to_symbol で銘柄通貨 (USD) へ換算 (固定 USDJPY なし)。
//  lot = 予算 USD ÷ (SL 距離 × 1 lot のオンス数) を lot 刻みで切り捨て、切り捨て後の予定損失が予算を超えれば 1 刻み下げる。
//  qty (TradingView の数量) = lot × 1 lot のオンス数 ÷ syminfo.pointvalue → SL 距離 × qty × pointvalue = 予定損失 USD
//  (pointvalue = 1 なら 0.03 lot = 3 oz = qty 3)。換算 na / 無効な入力・価格・pointvalue / SL の向き不正 / 距離 0 /
//  最小 lot 未満は na (発注しない)。参照価格 (A: 指値 / B, C, D: 確定足の終値) に対する予定損失であり、
//  約定ずれ・スプレッド・手数料を含む実損失の上限ではない。
f_stQty(int side, float ref, float sl) =>
    float dist   = side == 1 ? ref - sl : sl - ref
    float budSym = stBudget > 0 ? strategy.convert_to_symbol(stBudget) : na     // 予定損失予算 (USD)
    float pv     = syminfo.pointvalue
    float q      = na
    if not na(dist) and dist > 0 and not na(pv) and pv > 0 and stLotOz > 0 and stLotStep > 0 and stLotMin > 0 and not na(budSym) and budSym > 0
        float n = math.floor(budSym / (dist * stLotOz * stLotStep) + 1e-9)     // lot 刻みの個数 (1e-9: 浮動小数の誤差だけ吸収)
        if n * stLotStep * stLotOz * dist > budSym                              // 再確認: 予算超過なら 1 刻み下げる
            n := n - 1
        if n >= 1 and n * stLotStep >= stLotMin * (1 - 1e-9)
            q := n * stLotStep * stLotOz / pv
    q

bool stModeA   = stMode == "A: Touch Limit"
bool stModeC   = stMode == "C: Candle Pattern"
bool stModeD   = stMode == "D: 1M BOS Rebound"
bool stLongOK  = stDir != "Short Only"
bool stShortOK = stDir != "Long Only"

// ---- XA-7 · SATS (SAT BAND LINE1 / LINE2 / STB) ---------------------------------------------------------------------
//  f_satBand() は SATS 移植元 (SAT BAND Reconstruction Test) の関数を一字一句そのまま使う (tests/sats_src/f_satBand.txt)。
//  待機の有無にかかわらず毎バー グローバルで計算する。色・バンド状態は Entry 判定に使わない。
bool stSats = stTiming == "SATS Pullback"
//  XA-10: SATS Pullback は Entry Mode A〜D すべてで使える (C 専用の停止は廃止)。

f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]

[satL1, satL2, satStb, satD1, satD2, satSD, satBand, satBasis, satCommon, satAtr, satA1, satA2] = f_satBand()

// XA-13: 時間足ごとの SATS バンド状態 (1 青 / -1 赤 / 0 無点灯 / na 計算未成立 = LINE1 / LINE2 / STB のどれかが na)。
//  日足 / 4H / 1H / 15分 は各時間足の履歴上で f_satBand 全体を計算し、request 内で [1] + lookahead_on = 直近の確定足の状態だけ
//  (形成途中の上位足・未来の値は使わない)。毎足・無条件に取得する (待機中だけの計算にしない)。5分足は既存の satBand (この足の確定値)。
f_satTfState() =>
    [l1, l2, sb, d1, d2, sd, st, b, cm, at, a1, a2] = f_satBand()
    int s = (na(l1) or na(l2) or na(sb)) ? na : st
    s[1]
int satTfD  = request.security(syminfo.tickerid, "D",   f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf4  = request.security(syminfo.tickerid, "240", f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf1  = request.security(syminfo.tickerid, "60",  f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf15 = request.security(syminfo.tickerid, "15",  f_satTfState(), lookahead = barmerge.lookahead_on)
int satTf5  = (na(satL1) or na(satL2) or na(satStb)) ? na : satBand

// 選択した時間足 (1 つ以上) がすべて want の状態なら true。未選択は影響しない。選択した足に 0 / 反対色 / na が 1 つでもあれば false
f_satAllAgainst(int want) =>
    bool anySel = false
    bool allHit = true
    if stSatsFD
        anySel := true
        allHit := allHit and not na(satTfD) and satTfD == want
    if stSatsF4
        anySel := true
        allHit := allHit and not na(satTf4) and satTf4 == want
    if stSatsF1
        anySel := true
        allHit := allHit and not na(satTf1) and satTf1 == want
    if stSatsF15
        anySel := true
        allHit := allHit and not na(satTf15) and satTf15 == want
    if stSatsF5
        anySel := true
        allHit := allHit and not na(satTf5) and satTf5 == want
    anySel and allHit
bool satSkipS = f_satAllAgainst(1)      // Short を見送る: 選択した時間足がすべて青
bool satSkipL = f_satAllAgainst(-1)     // Long を見送る: 選択した時間足がすべて赤

// XA-16 / XA-17: 準備前の SATS 反発の履歴 (待機 pw* とは独立。毎足・無条件に更新)。足 e の判定には足 e-1 で確定した線 L だけを使う。
//  方向 side × 線 (LINE1 / LINE2 / STB) ごとに: 接触 = low <= L <= high、近接 ON なら Long low > L かつ low − L <= 許容距離 /
//  Short high < L かつ L − high <= 許容距離。A = 接触 + 前足終値が取引方向側 (Long close[1] > L / Short close[1] < L) + 終値が
//  取引方向側 (Long close > L / Short close < L)。B = 同じ線への先行接触の記録 + close[1] <= L < close (Short は close[1] >= L > close)。
//  陽線陰線 ON なら反発足 e 自身が Long close > open / Short close < open。SATS の青 / 赤、P0 / SL0、Zone 資格は使わない。
//  XA-17 / XA-19: 接触記録は接触足 q (bar_index) で持ち、t − q > Nc (即時側 接触→反発) になった記録は判定前に捨てる (同じ足の新しい接触で
//  記録し直せる。保持中の再接触で q を更新しない)。反発の起点 q (XA-18): 期限内の記録があれば A・B ともその q / 無ければ (期限切れで
//  解除後を含む) その足の接触 (反発時刻へ置き換えない)。有効な
//  反発は記録を消費する。戻り値 [反発成立, 起点 q, 次の記録 q]
f_satHist(int side, float L, int q) =>
    bool ok    = not na(L) and not na(close[1])
    bool hit   = ok and low <= L and L <= high
    bool near  = ok and stSatsNear and (side == 1 ? (low > L and low - L <= stSatsNearD) : (high < L and L - high <= stSatsNearD))
    bool fresh = ok and (side == 1 ? close[1] > L : close[1] < L)
    bool live  = not na(q) and bar_index - q <= stSatsNowC     // XA-19: 接触記録の寿命 = Nc (反発成立時に e − q <= Nc)
    bool tch   = (hit or near) and fresh
    bool rA    = tch and (side == 1 ? close > L : close < L)
    bool rB    = live and ok and (side == 1 ? (close[1] <= L and close > L) : (close[1] >= L and close < L))
    bool body  = not stSatsBody or (side == 1 ? close > open : close < open)
    bool reb   = (rA or rB) and body
    int  qUse  = live ? q : bar_index     // XA-18: 保持中の q を優先 (A の再接触でも延長しない)
    int  qNext = reb ? na : live ? q : tch ? bar_index : na
    [reb, qUse, qNext]
var int hTqL1 = na
var int hTqL2 = na
var int hTqL3 = na
var int hTqS1 = na
var int hTqS2 = na
var int hTqS3 = na
[hL1, qL1, nL1] = f_satHist(1, satL1[1], hTqL1)
[hL2, qL2, nL2] = f_satHist(1, satL2[1], hTqL2)
[hL3, qL3, nL3] = f_satHist(1, satStb[1], hTqL3)
[hS1, qS1, nS1] = f_satHist(-1, satL1[1], hTqS1)
[hS2, qS2, nS2] = f_satHist(-1, satL2[1], hTqS2)
[hS3, qS3, nS3] = f_satHist(-1, satStb[1], hTqS3)
// 反発の候補 (方向ごと): 起点 q / 成立足 e / 線の種類。XA-19: 寿命は 反発→Zone (t − e > Nz で消す。接触からの経過では消さない)。
// 採用は 0 <= t − e <= Nz かつ 0 <= e − q <= Nc の候補から最新の e、同じ e は LINE1 -> LINE2 -> STB (期限外が期限内を隠さない)
var array<int> hQsL = array.new_int()
var array<int> hEsL = array.new_int()
var array<int> hKsL = array.new_int()
var array<int> hQsS = array.new_int()
var array<int> hEsS = array.new_int()
var array<int> hKsS = array.new_int()
f_hPrune(array<int> qs, array<int> es, array<int> ks) =>
    int n = array.size(qs)
    if n > 0
        for i = n - 1 to 0
            if bar_index - array.get(es, i) > stSatsNowN
                array.remove(qs, i)
                array.remove(es, i)
                array.remove(ks, i)
    array.size(qs)
f_hPick(array<int> qs, array<int> es, array<int> ks) =>
    int bq = na
    int be = na
    int bk = 0
    int n  = array.size(qs)
    if n > 0
        for i = 0 to n - 1
            int q = array.get(qs, i)
            int e = array.get(es, i)
            int k = array.get(ks, i)
            if bar_index - e >= 0 and bar_index - e <= stSatsNowN and e - q >= 0 and e - q <= stSatsNowC and (na(be) or e > be or (e == be and k < bk))
                bq := q
                be := e
                bk := k
    [bq, be, bk]
// XA-21: 履歴の状態 (接触記録・反発候補) は確定足でだけ書き換える (calc_on_every_tick = true の形成中 tick は読むだけ。SX-2 と同じ)。
//  採用は、この足の反発 (e = 現在足。t − e = 0、e − q <= Nc は記録の寿命で保証) を先に、無ければ確定済み候補から最新の e
//  (XA-20 までの「この足の候補を追加してから選ぶ」と確定足で同じ結果。形成中 tick では仮評価用の読取値)
if barstate.isconfirmed
    hTqL1 := nL1
    hTqL2 := nL2
    hTqL3 := nL3
    hTqS1 := nS1
    hTqS2 := nS2
    hTqS3 := nS3
    int hNL = f_hPrune(hQsL, hEsL, hKsL)
    int hNS = f_hPrune(hQsS, hEsS, hKsS)
    if hL1
        array.push(hQsL, qL1)
        array.push(hEsL, bar_index)
        array.push(hKsL, 1)
    if hL2
        array.push(hQsL, qL2)
        array.push(hEsL, bar_index)
        array.push(hKsL, 2)
    if hL3
        array.push(hQsL, qL3)
        array.push(hEsL, bar_index)
        array.push(hKsL, 3)
    if hS1
        array.push(hQsS, qS1)
        array.push(hEsS, bar_index)
        array.push(hKsS, 1)
    if hS2
        array.push(hQsS, qS2)
        array.push(hEsS, bar_index)
        array.push(hKsS, 2)
    if hS3
        array.push(hQsS, qS3)
        array.push(hEsS, bar_index)
        array.push(hKsS, 3)
[pQL, pEL, pKL] = f_hPick(hQsL, hEsL, hKsL)
[pQS, pES, pKS] = f_hPick(hQsS, hEsS, hKsS)
bool hNowL = hL1 or hL2 or hL3
bool hNowS = hS1 or hS2 or hS3
int  hQL = hNowL ? (hL1 ? qL1 : hL2 ? qL2 : qL3) : pQL     // 即時側で使える Long の反発: 起点 q / 成立足 e / 線 (無ければ na / na / 0)
int  hEL = hNowL ? bar_index : pEL
int  hKL = hNowL ? (hL1 ? 1 : hL2 ? 2 : 3) : pKL
int  hQS = hNowS ? (hS1 ? qS1 : hS2 ? qS2 : qS3) : pQS
int  hES = hNowS ? bar_index : pES
int  hKS = hNowS ? (hS1 ? 1 : hS2 ? 2 : 3) : pKS

// 足 t の判定に使う線: 足 t-1 で確定した 3 本の値と前足終値だけで選ぶ (足 t の値は使わない)。
//  Long: SL0 < L < P0 かつ L < 前足終値 / Short: SL0 > L > P0 かつ L > 前足終値。前足終値に最も近い線、同距離は LINE1 -> LINE2 -> STB。
//  戻り値 [線の種類 (1 / 2 / 3、無ければ 0), 線の価格 (無ければ na)]。na の線は候補にしない。
f_satPick(int side, float p0, float sl0, float pc, float l1, float l2, float l3) =>
    int   bk = 0
    float bp = na
    float bd = na
    for k = 1 to 3
        float v = k == 1 ? l1 : k == 2 ? l2 : l3
        bool ok = not na(v) and not na(pc) and (side == 1 ? (v > sl0 and v < p0 and v < pc) : (v < sl0 and v > p0 and v > pc))
        if ok
            float d = math.abs(pc - v)
            if bk == 0 or d < bd
                bk := k
                bp := v
                bd := d
    [bk, bp]

// XA-8: 実 RR = side × (TP0 − 実約定) ÷ side × (実約定 − SL0)。戻り値 [RR, 理由] (0 = 計算可 / 1 = 約定が SL0 以遠 (risk <= 0) /
//  2 = TP0 が約定価格の先にない (reward <= 0) / 3 = 価格が na)。理由 0 以外の RR は na
f_satRR(int side, float fillPx, float sl0, float tp0) =>
    float rr  = na
    int   why = 0
    if na(fillPx) or na(sl0) or na(tp0)
        why := 3
    else
        float risk = side * (fillPx - sl0)
        float rew  = side * (tp0 - fillPx)
        if risk <= 0
            why := 1
        else if rew <= 0
            why := 2
        else
            rr := rew / risk
    [rr, why]

// C のパターン (5分足ローカル): 実体の包み足、またはヒゲ / 実体 >= stPinRatio のピンバー
float stBody   = math.abs(close - open)
float stWickLo = math.min(open, close) - low
float stWickHi = high - math.max(open, close)
bool  stPatL   = (close > open and close[1] < open[1] and open <= close[1] and close >= open[1]) or (stWickLo > 0 and stWickLo >= stPinRatio * stBody and stWickLo > stWickHi)
bool  stPatS   = (close < open and close[1] > open[1] and open >= close[1] and close <= open[1]) or (stWickHi > 0 and stWickHi >= stPinRatio * stBody and stWickHi > stWickLo)

// D の 1分足 (下位足データ: 足 t の中の確定 1分足の配列)。D のときだけ取得する
array<int>   m1t = na
array<float> m1h = na
array<float> m1l = na
array<float> m1c = na
if stModeD and is5mChart
    [rt, rh, rl, rc] = request.security_lower_tf(syminfo.tickerid, "1", [time, high, low, close])
    m1t := rt
    m1h := rh
    m1l := rl
    m1c := rc

// 新規 Entry の時間帯: 判定足の終了時刻 (= 次足始値の約定時刻) が [開始, 終了) に入るか。開始 > 終了 は日付またぎ
f_stInSession(int t) =>
    int mins = hour(t, stSessTz) * 60 + minute(t, stSessTz)
    int s    = stSessStartH * 60 + stSessStartM
    int e    = stSessEndH * 60 + stSessEndM
    s == e ? true : s < e ? (mins >= s and mins < e) : (mins >= s or mins < e)
bool stSessOK = not stUseSess or f_stInSession(time_close)

// 候補 Zone (確定時の値を保存する。B / C / D は 1 本前の確定時の一覧を使う)
type StCand
    int   side
    int   track
    float top
    float bot
    float bTop
    float bBot
    int   sZ
    int   sB
    float score
    float dScore

// 価格帯 [lo, hi] で採用する Strength / Score: 昇格範囲と交差 (閉区間) すれば FVG 加点後、しなければ元 Zone
f_stAdopt(StCand c, float lo, float hi) =>
    bool inB = not na(c.bTop) and math.max(lo, c.bBot) <= math.min(hi, c.bTop)
    [inB ? c.sB : c.sZ, inB ? c.dScore : c.score]

// a が b より優先なら true。B / C / D: Strength 高 → Score 高 → 距離 小 → trackId 小。A (distFirst): 距離 小 を最初に比べる
f_stBetter(bool distFirst, int aS, float aSc, float aD, int aT, int bS, float bSc, float bD, int bT) =>
    distFirst and aD != bD ? aD < bD : aS != bS ? aS > bS : aSc != bSc ? aSc > bSc : aD != bD ? aD < bD : aT < bT

// D の待機: 接触した候補 Zone (接触時の値)、BOS 水準の追跡、接触後に処理した確定 1分足の本数
type StWait
    StCand c
    float  ext
    float  run
    float  lvl
    int    cnt
    bool   bos
    int    aS
    float  aSc

// TP 価格の候補: 利益方向で最も手前の反対側 Zone 端 (Long は ref より上で最も低い、Short は ref より下で最も高い)
f_stNearest(array<float> edges, int side, float ref) =>
    float best = na
    int   ne   = array.size(edges)
    if ne > 0
        for k = 0 to ne - 1
            float e = array.get(edges, k)
            if side == 1 ? e > ref : e < ref
                if na(best) or (side == 1 ? e < best : e > best)
                    best := e
    best

// RR 判定 (risk > 0 のときだけ呼ぶ): [見送り, TP]。Zone の RR < Min → 見送り、Min <= RR < Max → Zone 端、それ以外 → 固定 RR
f_stTp(int side, float fillPx, float sl, float edge) =>
    float risk = side * (fillPx - sl)
    float tp   = fillPx + side * stRR * risk
    bool  skip = false
    if stTpZone and not na(edge)
        float rrZ = side * (edge - fillPx) / risk
        if rrZ < stTpMinRR
            skip := true
        else if rrZ < stTpMaxRR
            tp := edge
    [skip, tp]

// XA-15: 建値移動に必要な含み益幅。Fixed Distance = stBEDist (従来どおり、距離検査を追加しない) / Risk Multiple = 初期リスク距離
//  side × (実約定価格 − 初期 SL) × R / TP Progress = side × (TP − 実約定価格) × 比率。新方式は基準距離が na / 0 以下なら na (移動しない)
f_beTrig(int side, float fillPx, float sl, float tp) =>
    float r  = side * (fillPx - sl)
    float tg = side * (tp - fillPx)
    stBEMode == "Risk Multiple" ? (not na(r) and r > 0 ? r * stBER : na) :
     stBEMode == "TP Progress" ? (not na(tg) and tg > 0 ? tg * stBETp : na) : stBEDist

var array<StCand>  stPrev = array.new<StCand>()
var map<int, bool> stUsed = map.new<int, bool>()
var array<StWait>  stWaits = array.new<StWait>()
var int            m1LastT = na
var float          m1PrevC = na
var int    oState  = 0       // 0 = なし / 1 = Entry 発注済み (未約定) / 2 = 保有中 / 3 = 成行決済を発注済み
var int    oSeq    = 0
var string oEid    = ""
var string oXid    = ""
var bool   oLimit  = false
var int    oSide   = 0
var int    oTrack  = -1
var float  oL      = na
var float  oSL     = na
var float  oTP     = na
var float  oFill   = na
var float  oStop   = na
var bool   oBE     = false
var int    oClosed = 0
// XA-7 SATS Pullback の待機 (全体で 1 件) と確認用の記録
var int   pwState  = 0       // 0 = 待機なし / 1 = 待機中
var int   pwSide   = 0
var int   pwTrack  = -1
var int   pwBar    = na
var int   pwEndT   = na      // 準備した 5分足の終了時刻 (期限の起点)
var float pwP0     = na
var float pwSL0    = na
var float pwTP0    = na
var float oTP0     = na      // SATS で発注した注文の TP0 (約定確認時の TP)
var int   oPath    = 0       // XA-16: 直近の SATS 発注の経路 (1 = 引きつけ / 2 = 即時)
var int   pwNNow   = 0       // XA-16: 即時エントリーの発注件数
var int   pwNowK   = 0       // XA-16: 即時エントリーで採用した反発の線 (1 LINE1 / 2 LINE2 / 3 STB)
var int   pwNowAge = na      // XA-19: その反発の 反発→Zone 本数 (t − e)
var int   pwNowCq  = na      // XA-19: その反発の 接触→反発 本数 (e − q)
var int   pwNTqExp = 0       // XA-17: 引きつけ側の接触期限切れ件数 (待機は続く。期限切れ・SL0 取消とは別)
var bool  pwTouchSeen = false   // XA-17: この準備で接触を経験したか (接触期限切れ後の再接触を二重に数えない)
var float pwRRPrep = na
var float pwRRPlan = na
var float pwRRFill = na
var int   pwNPrep  = 0
var int   pwNOrder = 0
var int   pwNExp   = 0
var bool  pwTouched  = false   // XA-9: 接触済み (反発待ち)
var int   pwTouchK   = 0       // XA-9: 接触した線の種類 (1 LINE1 / 2 LINE2 / 3 STB)
var int   pwTouchBar = na      // XA-9: 接触した足
var int   pwNTouchPrep = 0     // XA-9: 接触を経験した準備の件数 (同じ準備で何度触れても 1 件)
var int   pwNOrdSame   = 0     // XA-9: 同じ足の接触・反発 (A) で発注した件数 (XA-11: 近接 ON では近接を接触扱いにした同一足反発を含む)
var int   pwNOrdLater  = 0     // XA-9: 接触後の別の足の戻り (B) で発注した件数
var int   pwNSL    = 0
var int   pwNBad   = 0
var int   pwRRWhy  = na      // XA-8: 実 RR の理由 (0 計算可 / 1 risk <= 0 / 2 reward <= 0 / 3 na)
var int   pwNFill  = 0       // XA-8: 実 RR を記録した SATS 約定の件数 (1 約定 1 回)
var int   pwFillPath = 0     // XA-8: 直近の記録経路 (1 = 約定後も保有中 / 2 = 約定足内で決済済み)
int   pwEv    = 0          // この足のイベント: 1 = 準備 / 2 = 発注 / -1 期限 / -2 Track 消失 / -3 候補・Strong 資格なし / -4 SL0 到達
int   pwLineK = 0          // この足の判定に使った線 (1 = LINE1 / 2 = LINE2 / 3 = STB / 0 = なし)
float pwLineP = na         // その線の価格 (足 t-1 の確定値)
var array<float> stTpUpPrev = array.new_float()     // XA-21: 直前の確定時の TP 用 Zone 端 (仮評価の RR 事前判定用)
var array<float> stTpDnPrev = array.new_float()
varip array<int> gProvAlertBar      = array.new_int(1, -1)     // XA-21: 仮アラートを送った 5分足の time (-1 = 未送信)。varip = tick・巻き戻しでも残る
varip array<int> gConfirmedAlertBar = array.new_int(1, -1)     // XA-21: 確定アラートを送った 5分足の time (-1 = 未送信。仮とは別の状態)

// ---- XA-21 仮 / 確定アラート (XAUUSD) -------------------------------------------------------------------------
//  ・確定: 確定足で実際に strategy.entry を出した分岐 (SATS 引きつけ / SATS 即時 / Current) で 1 回。約定・建玉増加は使わない。
//          alert.freq_all + 送信済み time の明示確認 (同じ 5分足では最大 1 回)。送信済みでも発注は止めない
//  ・仮  : 形成中の 5分足 (未確定 tick) だけで、このまま確定したら発注になるかを読取専用で評価。1 本の 5分足につき最大 1 回。
//          仮の送信済み状態と確定の送信済み状態は互いに参照しない (仮なしでも確定は出る / 仮の後に不成立なら確定は出ない)
//  ・本文: Entry (成行は参考価格 = 判断足 / 形成中の終値、Current A は指値価格)、SL、TP (SATS は固定 TP0、Current は発注判断時の
//          予定 TP。最終 TP は約定確認後に実約定価格から決める)、SL 幅 / TP 幅 (表示した Entry との差、USD)、RR (TP 幅 ÷ SL 幅)、
//          日時 (日本時間。確定 = 判断足の終了時刻 / 仮 = 送信時刻)。価格は最小価格刻みの桁。計算できない値は "-"
f_stPx(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

f_stAlertMsg(string kind, int side, float ePx, float sl, float tp, bool isLim, bool isSats) =>
    float slW = side * (ePx - sl)
    float tpW = side * (tp - ePx)
    float rr  = not na(slW) and slW > 0 and not na(tpW) ? tpW / slW : na
    int   tAt = kind == "仮" ? timenow : time_close
    "【" + kind + "】" + syminfo.ticker + " " + (side == 1 ? "LONG" : "SHORT") +
     "\nEntry：" + f_stPx(ePx) + (isLim ? "（指値価格）" : "（成行参考価格）") +
     "\nSL：" + f_stPx(sl) +
     "\nTP：" + f_stPx(tp) + (isSats ? "（固定TP0）" : "（発注判断時の予定TP。最終TPは約定確認後に決定）") +
     "\nSL幅：" + (na(slW) ? "-" : f_stPx(slW) + "ドル") +
     "\nTP幅：" + (na(tpW) ? "-" : f_stPx(tpW) + "ドル") +
     "\nRR：" + (na(rr) ? "-" : "1:" + str.tostring(rr, "0.00")) +
     "\n日時：" + str.format_time(tAt, "yyyy-MM-dd HH:mm:ss", "Asia/Tokyo") + "（日本時間）" +
     (kind == "仮" ? "\n※未確定：5分足確定時に不成立になる場合あり" : "")

// 確定アラート: 発注した分岐から呼ぶ (通知だけ。戻り値 = 送信したか)
f_stConfAlert(int side, float ePx, float sl, float tp, bool isLim, bool isSats) =>
    bool send = stAlertConf and array.get(gConfirmedAlertBar, 0) != time
    if send
        array.set(gConfirmedAlertBar, 0, time)
        alert(f_stAlertMsg("確定", side, ePx, sl, tp, isLim, isSats), alert.freq_all)
    send

// 仮評価 (読み取り専用)。確定時の新規 Entry 判定 (4) から「確定足であること」だけを外したもの。
//  ・候補 Zone: 直前の確定時の一覧 (stPrev)。足 t の更新後の Zone / Track は未確定なので使わない
//  ・終値 / 高値 / 安値: 形成中の現在値。C のパターンも形成中の足で判定
//  ・D: 待機 (stWaits) の値をローカルに写し、この 5分足の未処理の確定 1分足 (期間が終わっていない最後の 1分足は除く) で
//       接触 / BOS を試算する。待機・候補・注文状態・処理済み時刻は一切書き換えない
//  ・RR 事前判定: 直前の確定時の TP 用 Zone 端と、参照価格 (A: 指値 / B, C, D: 現在値)
//  戻り値: [方向 (0 = なし), 参照価格, SL]
f_stProvEval() =>
    int   bkL = -1
    int   bkS = -1
    float bpL = na
    float bpS = na
    int   bsL = 0
    int   bsS = 0
    float bcL = na
    float bcS = na
    float bdL = na
    float bdS = na
    int   btL = -1
    int   btS = -1
    int   m   = array.size(stPrev)
    // 確定済みの 1分足だけ: 後ろに次の 1分足がある要素は確定。最後の要素は 1分の期間が終わっていれば確定
    // (time + 60000 <= timenow)。終わっていなければ形成中として除く (追加 request なし、既存の time 配列を使う)
    int   nb  = 0
    if not na(m1t)
        int sz = array.size(m1t)
        nb := sz
        if sz > 0
            if array.get(m1t, sz - 1) + 60000 > timenow
                nb := sz - 1
    if m > 0
        for k = 0 to m - 1
            StCand c = array.get(stPrev, k)
            bool dirOK = c.side == 1 ? stLongOK : stShortOK
            if dirOK and not map.contains(stUsed, c.track)
                bool  ok  = false
                float px  = na
                int   aS  = 0
                float aSc = na
                float d   = na
                if stModeA
                    px := c.side == 1 ? (c.sZ >= SR_STRONG ? c.top : c.bTop) : (c.sZ >= SR_STRONG ? c.bot : c.bBot)
                    [s1, sc1] = f_stAdopt(c, px, px)
                    aS  := s1
                    aSc := sc1
                    d   := math.abs(close - px)
                    ok  := (c.side == 1 ? close > c.top : close < c.bot) and aS >= SR_STRONG
                else if stModeD
                    bool  armed = false
                    float ext   = na
                    float run   = na
                    float lvl   = na
                    int   cnt   = 0
                    int   nw    = array.size(stWaits)
                    if nw > 0
                        for w = 0 to nw - 1
                            StWait x = array.get(stWaits, w)
                            if x.c.track == c.track
                                armed := true
                                ext   := x.ext
                                run   := x.run
                                lvl   := x.lvl
                                cnt   := x.cnt
                                aS    := x.aS
                                aSc   := x.aSc
                    bool  bos = false
                    float pc  = m1PrevC
                    if nb > 0
                        for j = 0 to nb - 1
                            int tj = array.get(m1t, j)
                            if not bos and (na(m1LastT) or tj > m1LastT)
                                float h  = array.get(m1h, j)
                                float l  = array.get(m1l, j)
                                float cl = array.get(m1c, j)
                                if armed
                                    cnt := cnt + 1
                                    if c.side == 1 ? cl > lvl : cl < lvl
                                        bos := true
                                    else
                                        run := c.side == 1 ? math.max(run, h) : math.min(run, l)
                                        if c.side == 1 ? l < ext : h > ext
                                            ext := c.side == 1 ? l : h
                                            lvl := run
                                        if cnt >= stDWait
                                            armed := false
                                if not armed and not bos and l <= c.top and h >= c.bot and (c.side == 1 ? pc > c.top : pc < c.bot)
                                    [wS, wSc] = f_stAdopt(c, math.max(l, c.bot), math.min(h, c.top))
                                    if wS >= SR_STRONG
                                        armed := true
                                        ext   := c.side == 1 ? l : h
                                        run   := c.side == 1 ? h : l
                                        lvl   := run
                                        cnt   := 0
                                        aS    := wS
                                        aSc   := wSc
                                pc := cl
                    d  := math.abs(close - (c.side == 1 ? c.top : c.bot))
                    ok := bos and (c.side == 1 ? close > c.top : close < c.bot)
                else
                    [s2, sc2] = f_stAdopt(c, math.max(low, c.bot), math.min(high, c.top))
                    aS  := s2
                    aSc := sc2
                    d   := math.abs(close - (c.side == 1 ? c.top : c.bot))
                    ok  := low <= c.top and high >= c.bot and (c.side == 1 ? close > c.top : close < c.bot) and aS >= SR_STRONG and (not stModeC or (c.side == 1 ? stPatL : stPatS))
                if ok and c.side == 1
                    bool take = bkL < 0
                    if not take
                        take := f_stBetter(stModeA, aS, aSc, d, c.track, bsL, bcL, bdL, btL)
                    if take
                        bkL := k
                        bpL := px
                        bsL := aS
                        bcL := aSc
                        bdL := d
                        btL := c.track
                if ok and c.side == -1
                    bool take = bkS < 0
                    if not take
                        take := f_stBetter(stModeA, aS, aSc, d, c.track, bsS, bcS, bdS, btS)
                    if take
                        bkS := k
                        bpS := px
                        bsS := aS
                        bcS := aSc
                        bdS := d
                        btS := c.track
    int side = 0
    if bkL >= 0 and bkS >= 0
        if stModeA and bdL != bdS
            side := bdL < bdS ? 1 : -1
    else if bkL >= 0
        side := 1
    else if bkS >= 0
        side := -1
    float ePx = na
    float sl  = na
    float tpP = na     // 通知 TP: 下の RR 事前判定と同じ f_stTp の結果
    if side != 0
        StCand c = array.get(stPrev, side == 1 ? bkL : bkS)
        ePx := stModeA ? (side == 1 ? bpL : bpS) : close
        sl  := side == 1 ? c.bot - stBuffer : c.top + stBuffer
        [skipRef, tpRef] = f_stTp(side, ePx, sl, f_stNearest(side == 1 ? stTpUpPrev : stTpDnPrev, side, ePx))
        tpP := tpRef
        if skipRef
            side := 0
    [side, ePx, sl, tpP]

// SATS 仮評価 (読み取り専用)。待機中 (直前の確定時の状態) の SATS について、形成中の 5分足がこのまま確定したら発注するかを
//  確定時の (3b) と同じ式で試算する: 期限 / SL0 到達 (取消) → 線の選択 (接触前は足 t-1 の線と前足終値で選び直し、接触後は
//  記録した種類) → 接触 / 近接 (この足の値はローカルだけで、接触記録は書かない) → 反発 A / B → 陽線陰線 / 逆方向一致 (上位足は
//  確定値) / 価格範囲 / 数量。待機・接触記録・件数・Track・注文状態は一切書き換えない。形成中の条件は確定までに消えることがある。
//  戻り値: [方向 (0 = なし), 参照価格 (形成中の終値), SL0, TP0]
f_satProvEval(float pc, float l1p, float l2p, float stbp) =>
    int   side = 0
    float ePx  = na
    float sl   = na
    float tp   = na
    if stSats and pwState == 1 and bar_index > pwBar
        bool cancel = time_close - pwEndT >= stSatsWait * 60000 or (pwSide == 1 ? low <= pwSL0 : high >= pwSL0)
        if not cancel
            // 引きつけ側の接触期限 (ON) を確定時と同じ順で反映 (ローカルだけ。接触記録は書き換えない)
            bool tchd = pwTouched and not (stSatsTq and bar_index - pwTouchBar > stSatsTqN)
            int   lk = 0
            float lp = na
            if not tchd
                [k0, v0] = f_satPick(pwSide, pwP0, pwSL0, pc, l1p, l2p, stbp)
                lk := k0
                lp := v0
            else
                lk := pwTouchK
                lp := pwTouchK == 1 ? l1p : pwTouchK == 2 ? l2p : stbp
            bool inRange   = lk != 0 and not na(lp) and (pwSide == 1 ? (lp > pwSL0 and lp < pwP0) : (lp < pwSL0 and lp > pwP0))
            bool touchHit  = inRange and low <= lp and lp <= high
            bool touchNear = stSatsNear and inRange and (pwSide == 1 ? (low > lp and low - lp <= stSatsNearD) : (high < lp and lp - high <= stSatsNearD))
            bool touchNow  = touchHit or touchNear
            bool rebA      = touchNow and (pwSide == 1 ? close > lp : close < lp)
            bool rebB      = tchd and inRange and (pwSide == 1 ? (pc <= lp and close > lp) : (pc >= lp and close < lp))
            bool priceOK   = pwSide == 1 ? (close > pwSL0 and close < pwP0) : (close < pwSL0 and close > pwP0)
            bool bodyOK    = not stSatsBody or (pwSide == 1 ? close > open : close < open)
            bool mtfOK     = not (pwSide == 1 ? satSkipL : satSkipS)
            if (rebA or rebB) and bodyOK and mtfOK and priceOK and not na(f_stQty(pwSide, close, pwSL0))
                side := pwSide
                ePx  := close
                sl   := pwSL0
                tp   := pwTP0
    else if stSats and stSatsNow and pwState == 0
        // 待機前で即時エントリー ON: 形成中の足の Zone シグナル (Current の仮評価と同じ読取専用の判定) が、このまま確定したら
        //   即時発注になるか (有効な反発 t − e <= Nz・e − q <= Nc、逆方向一致、SL / TP の向き、P0 と終値の両方の数量)。
        //   通常の待機準備になるだけのときは何も返さない (エントリーの仮通知・仮ラベルを出さない)
        [s0, e0, l0, t0] = f_stProvEval()
        if s0 != 0
            int  hBar = s0 == 1 ? hEL : hES
            bool nMtf = not (s0 == 1 ? satSkipL : satSkipS)
            bool nDir = s0 * (close - l0) > 0 and s0 * (t0 - close) > 0
            if not na(hBar) and bar_index - hBar >= 0 and bar_index - hBar <= stSatsNowN and nMtf and nDir
                 and not na(f_stQty(s0, e0, l0)) and not na(f_stQty(s0, close, l0))
                side := s0
                ePx  := close
                sl   := l0
                tp   := t0
    [side, ePx, sl, tp]

int stZones   = 0
int stFvgZone = 0
int stBoosted = 0
if is5mChart and barstate.isconfirmed
    // (1) 発注済み Entry の約定 / 決済を確認する
    bool fillNow = false
    if oState == 1
        int  ot           = strategy.opentrades
        int  ct           = strategy.closedtrades
        bool filledOpen   = false
        bool filledClosed = false
        if ot > 0
            filledOpen := strategy.opentrades.entry_id(ot - 1) == oEid
        if not filledOpen and ct > oClosed
            filledClosed := strategy.closedtrades.entry_id(ct - 1) == oEid
        if filledOpen
            map.put(stUsed, oTrack, true)
            oFill   := strategy.opentrades.entry_price(ot - 1)
            oState  := 2
            fillNow := true
        else if filledClosed
            // 約定した足の中で SL まで成立した
            map.put(stUsed, oTrack, true)
            oState := 0
            if stSats     // XA-8: 決済済みの SATS 約定も実 RR を記録する (TP / 決済の注文は出さない)
                [rrC, whyC] = f_satRR(oSide, strategy.closedtrades.entry_price(ct - 1), oSL, oTP0)
                pwRRFill   := rrC
                pwRRWhy    := whyC
                pwNFill    += 1
                pwFillPath := 2
        else if not oLimit
            strategy.cancel(oEid)
            strategy.cancel(oXid)
            oState := 0
    else if oState >= 2 and strategy.opentrades == 0
        oState := 0

    // (2) Zone の走査 (1 回): 候補一覧、Track の State、保留中の指値の有効性、TP 用の反対側 Zone 端
    int n = zn.zoneCount(zoneEng)
    stZones := n
    array<StCand> cur    = array.new<StCand>()
    array<int>    curTrk = array.new_int()
    array<int>    curSt  = array.new_int()
    array<float>  tpUp   = array.new_float()
    array<float>  tpDn   = array.new_float()
    bool pendOK = false
    if n > 0
        for i = 0 to n - 1
            zn.Zone z = zn.zoneAt(zoneEng, i)
            [eScore, eStr, eBest, eBoost, eBTop, eBBot, eVTop, eVBot] = f_stZoneEval(z)
            if eBest >= 0
                stFvgZone += 1
            if eBoost
                stBoosted += 1
            array.push(curTrk, z.trackId)
            array.push(curSt, z.state)
            int zSide = z.state == ST_SUPPORT ? 1 : z.state == ST_RESIST ? -1 : 0
            if zSide != 0 and (z.strength >= SR_STRONG or (eBoost and eStr >= SR_STRONG))
                array.push(cur, StCand.new(zSide, z.trackId, z.top, z.bottom, eBTop, eBBot, z.strength, eStr, z.score, eScore))
            if oState == 1 and z.trackId == oTrack
                pendOK := zSide == oSide and z.bottom <= oL and oL <= z.top and (z.strength >= SR_STRONG or (eBoost and eStr >= SR_STRONG and eBBot <= oL and oL <= eBTop))
            if zSide != 0
                float edge = na
                if z.strength >= SR_MEDIUM
                    edge := zSide == -1 ? z.bottom : z.top
                else if eBoost and eStr >= SR_MEDIUM
                    edge := zSide == -1 ? eBBot : eBTop
                if not na(edge)
                    array.push(zSide == -1 ? tpUp : tpDn, edge)

    // (2b) 約定を確認した足: 実約定価格から RR と TP を決める (約定した足の中では TP は無い)
    // (2b') XA-7 SATS Pullback: TP は準備時の TP0 のまま (実約定価格から作り直さない)。設定は既存どおり約定確認時。
    //   実約定が SL0 / TP0 の不適切な側 (risk <= 0 または TP0 までの距離 <= 0) なら TP を置かず成行決済 (正常約定として扱わない)
    if fillNow and stSats
        float riskS = oSide * (oFill - oSL)
        float rewS  = oSide * (oTP0 - oFill)
        [rrH, whyH] = f_satRR(oSide, oFill, oSL, oTP0)     // XA-8: 記録だけ (下の注文処理は従来どおり)
        pwRRFill   := rrH
        pwRRWhy    := whyH
        pwNFill    += 1
        pwFillPath := 1
        if riskS > 0 and rewS > 0
            oTP   := oTP0
            oStop := oSL
            strategy.exit(oXid, oEid, stop = oStop, limit = oTP)
        else
            strategy.close(oEid)
            oState := 3
            pwNBad += 1
    else if fillNow
        float risk = oSide * (oFill - oSL)
        if risk > 0
            [skipRR, tp] = f_stTp(oSide, oFill, oSL, f_stNearest(oSide == 1 ? tpUp : tpDn, oSide, oFill))
            if skipRR
                strategy.close(oEid)
                oState := 3
            else
                oTP   := tp
                oStop := oSL
                strategy.exit(oXid, oEid, stop = oStop, limit = oTP)
        else
            strategy.close(oEid)
            oState := 3

    // (2c) 建値移動: この確定足で含み益が Trigger に届いたら stop を約定価格へ (次の足から有効)
    //   XA-15: Trigger 幅は選択した方式 (約定確認時の oFill / 初期 oSL / 設定した oTP から。oStop は使わない)。na なら移動しない
    if stBE and oState == 2 and not oBE
        float fav = oSide == 1 ? high : low
        if fillNow and oLimit and oFill != open
            fav := close
        float beTrig = f_beTrig(oSide, oFill, oSL, oTP)
        if not na(beTrig) and oSide * (fav - oFill) >= beTrig
            oBE   := true
            oStop := oFill
            strategy.exit(oXid, oEid, stop = oStop, limit = oTP)

    // (2d) D: 足 t の確定 1分足を古い順に 1 回ずつ処理する (処理済みの時刻以前は飛ばす)。
    //      1分足ごとに、待機中の BOS / 期限を先に判定し、その後で新しい接触を待機に加える (接触した 1分足では BOS にしない)
    array<StCand> dSrc = array.new<StCand>()
    array<int>    dAS  = array.new_int()
    array<float>  dASc = array.new_float()
    if stModeD
        int nb = na(m1t) ? 0 : array.size(m1t)
        if nb > 0
            for j = 0 to nb - 1
                int tj = array.get(m1t, j)
                if na(m1LastT) or tj > m1LastT
                    m1LastT := tj
                    float h  = array.get(m1h, j)
                    float l  = array.get(m1l, j)
                    float cl = array.get(m1c, j)
                    int nw = array.size(stWaits)
                    if nw > 0
                        for w = nw - 1 to 0
                            StWait x = array.get(stWaits, w)
                            if not x.bos
                                x.cnt := x.cnt + 1
                                if x.c.side == 1 ? cl > x.lvl : cl < x.lvl
                                    x.bos := true
                                else
                                    x.run := x.c.side == 1 ? math.max(x.run, h) : math.min(x.run, l)
                                    if x.c.side == 1 ? l < x.ext : h > x.ext
                                        x.ext := x.c.side == 1 ? l : h
                                        x.lvl := x.run
                                    if x.cnt >= stDWait
                                        array.remove(stWaits, w)
                    int nc = array.size(stPrev)
                    if nc > 0
                        for k = 0 to nc - 1
                            StCand c = array.get(stPrev, k)
                            bool dirOK = c.side == 1 ? stLongOK : stShortOK
                            if dirOK and not map.contains(stUsed, c.track) and l <= c.top and h >= c.bot and (c.side == 1 ? m1PrevC > c.top : m1PrevC < c.bot)
                                bool waiting = false
                                int nw2 = array.size(stWaits)
                                if nw2 > 0
                                    for w = 0 to nw2 - 1
                                        StWait y = array.get(stWaits, w)
                                        if y.c.track == c.track
                                            waiting := true
                                if not waiting
                                    [wS, wSc] = f_stAdopt(c, math.max(l, c.bot), math.min(h, c.top))
                                    if wS >= SR_STRONG
                                        float e0 = c.side == 1 ? l : h
                                        float r0 = c.side == 1 ? h : l
                                        array.push(stWaits, StWait.new(c, e0, r0, r0, 0, false, wS, wSc))
                    m1PrevC := cl
        // 足 t の更新後に候補 Zone (同じ Track、同じ向き、Strong 資格) でなくなった待機は解除。BOS が出た待機は
        // この確定足で Entry 候補にして解除する (終値が Zone の外のときだけ候補)
        int nw3 = array.size(stWaits)
        if nw3 > 0
            for w = nw3 - 1 to 0
                StWait x = array.get(stWaits, w)
                bool valid = false
                int nc3 = array.size(cur)
                if nc3 > 0
                    for k = 0 to nc3 - 1
                        StCand cc = array.get(cur, k)
                        if cc.track == x.c.track and cc.side == x.c.side
                            valid := true
                if not valid
                    array.remove(stWaits, w)
                else if x.bos
                    if (x.c.side == 1 ? close > x.c.top : close < x.c.bot) and not map.contains(stUsed, x.c.track)
                        array.push(dSrc, x.c)
                        array.push(dAS, x.aS)
                        array.push(dASc, x.aSc)
                    array.remove(stWaits, w)

    // (3) 保留中の指値 (A) の取消: Track 消失 / State 無効 / L で Strong 以上の資格を失った / 時間帯の外
    bool cancelBar = false
    if oState == 1 and (not pendOK or not stSessOK)
        strategy.cancel(oEid)
        strategy.cancel(oXid)
        oState    := 0
        cancelBar := true

    // (3b) XA-7 / XA-9 SATS Pullback の待機判定 (準備足の次の足から)。取消を反発より優先する
    //   取消 (XA-9): 期限 (準備足の終了時刻からの実時間) / 固定 SL0 到達 だけ。元 Zone の Strong 資格・Track の存続 / 一致・候補一覧
    //   からの脱落では取り消さない (保存した方向 / P0 / SL0 / TP0 を使い続ける)。取消だけでは使用済み Track にしない
    //   接触前: 毎足、足 t-1 の確定線と前足終値から最寄りの適格線を選び直す。low <= L <= high で接触 → 線の種類を記録
    //   接触後: 記録した種類の線の足 t-1 確定値を毎足使う (別の線へ選び替えない。前足終値との位置関係は再要求しない)。
    //           na / SL0〜P0 の範囲外の足は発注しないが、接触記録は消さない
    //   反発: A = その足で接触して終値が戻る / B = 接触済みで、前足終値 <= L (Short は >=) かつ当足終値 > L (Short は <)
    //   XA-11 ② (近接 ON): 接触 = 実接触 または 線の手前までの接近 (Long low > L かつ low − L <= 許容距離 / Short high < L かつ
    //           L − high <= 許容距離)。接触記録・線の固定・反発 A / B は同じ処理を共用し、終値の基準は元の L のまま
    //   XA-11 ① (陽線 / 陰線 ON): 発注する足自身が Long close > open / Short close < open。同じ足の A または B と同時に必要。
    //           不成立でも待機・接触記録は残す (接触の記録自体は制限しない)
    //   XA-13 (逆方向一致フィルター): 他の発注条件が全て成立した足でも、選択した時間足がすべて逆方向なら発注しない。
    //           何も変えない (待機・接触記録・線の種類・P0 / SL0 / TP0・期限・件数・注文状態はそのまま。反発は保存しない)
    bool  pwCancelBar = false
    if stSats and pwState == 1 and bar_index > pwBar
        int why = 0
        if time_close - pwEndT >= stSatsWait * 60000
            why := -1
        else if pwSide == 1 ? low <= pwSL0 : high >= pwSL0
            why := -4
        if why != 0
            pwState     := 0
            pwCancelBar := true
            pwEv        := why
            pwNExp  += why == -1 ? 1 : 0
            pwNSL   += why == -4 ? 1 : 0
            pwTouched  := false
            pwTouchK   := 0
            pwTouchBar := na
        else
            // XA-17: 引きつけ側の接触期限 (ON のとき)。保持中の接触から t − q > N (接触→反発の専用 N) なら記録と保持線を解除 (待機・開始時刻・期限は不変)。
            //   この後の線の選択はやり直しになり、この足の新しい接触は新しい接触として記録できる (古い接触の B にはならない)
            if stSatsTq and pwTouched and bar_index - pwTouchBar > stSatsTqN
                pwTouched  := false
                pwTouchK   := 0
                pwTouchBar := na
                pwNTqExp   += 1
            int   lk = 0
            float lp = na
            if not pwTouched
                [k0, v0] = f_satPick(pwSide, pwP0, pwSL0, close[1], satL1[1], satL2[1], satStb[1])
                lk := k0
                lp := v0
            else
                lk := pwTouchK
                lp := pwTouchK == 1 ? satL1[1] : pwTouchK == 2 ? satL2[1] : satStb[1]
            pwLineK := lk
            pwLineP := lp
            bool inRange  = lk != 0 and not na(lp) and (pwSide == 1 ? (lp > pwSL0 and lp < pwP0) : (lp < pwSL0 and lp > pwP0))
            bool touchHit  = inRange and low <= lp and lp <= high
            bool touchNear = stSatsNear and inRange and (pwSide == 1 ? (low > lp and low - lp <= stSatsNearD) : (high < lp and lp - high <= stSatsNearD))
            bool touchNow  = touchHit or touchNear
            bool rebA     = touchNow and (pwSide == 1 ? close > lp : close < lp)
            bool rebB     = pwTouched and inRange and (pwSide == 1 ? (close[1] <= lp and close > lp) : (close[1] >= lp and close < lp))
            if touchNow and not pwTouched
                pwTouched    := true
                pwTouchK     := lk
                pwTouchBar   := bar_index
                pwNTouchPrep += pwTouchSeen ? 0 : 1
                pwTouchSeen  := true
            bool priceOK = pwSide == 1 ? (close > pwSL0 and close < pwP0) : (close < pwSL0 and close > pwP0)
            bool bodyOK  = not stSatsBody or (pwSide == 1 ? close > open : close < open)
            bool mtfOK   = not (pwSide == 1 ? satSkipL : satSkipS)
            if (rebA or rebB) and bodyOK and mtfOK and priceOK and stSessOK and oState == 0
                float q = f_stQty(pwSide, close, pwSL0)
                if not na(q)
                    oSeq    += 1
                    oEid    := (pwSide == 1 ? "L" : "S") + str.tostring(oSeq)
                    oXid    := oEid + " SL/TP"
                    oSide   := pwSide
                    oTrack  := pwTrack
                    oLimit  := false
                    oL      := na
                    oSL     := pwSL0
                    oStop   := pwSL0
                    oTP     := na
                    oTP0    := pwTP0
                    oPath   := 1
                    oFill   := na
                    oBE     := false
                    oClosed := strategy.closedtrades
                    oState  := 1
                    strategy.entry(oEid, pwSide == 1 ? strategy.long : strategy.short, qty = q)
                    strategy.exit(oXid, oEid, stop = oSL)
                    f_stConfAlert(pwSide, close, pwSL0, pwTP0, false, true)     // XA-21 確定: 引きつけの発注 (Entry は判断足の終値、SL0 / TP0 は準備時の固定値)
                    pwRRPlan := pwSide * (pwTP0 - close) / (pwSide * (close - pwSL0))
                    pwRRFill := na
                    pwRRWhy  := na
                    pwState  := 0
                    pwEv     := 2
                    pwNOrder += 1
                    pwNOrdSame  += rebA ? 1 : 0
                    pwNOrdLater += rebA ? 0 : 1
                    pwTouched  := false
                    pwTouchK   := 0
                    pwTouchBar := na

    // (4) 新規 Entry (注文が無く、取消をした足でなく、時間帯の中のときだけ)
    if oState == 0 and not cancelBar and stSessOK
        array<StCand> src = stModeA ? cur : stModeD ? dSrc : stPrev
        int   bkL = -1
        int   bkS = -1
        float bpL = na
        float bpS = na
        int   bsL = 0
        int   bsS = 0
        float bcL = na
        float bcS = na
        float bdL = na
        float bdS = na
        int   btL = -1
        int   btS = -1
        int m = array.size(src)
        if m > 0
            for k = 0 to m - 1
                StCand c = array.get(src, k)
                bool dirOK = c.side == 1 ? stLongOK : stShortOK
                if dirOK and not map.contains(stUsed, c.track)
                    bool  ok  = false
                    float px  = na
                    int   aS  = 0
                    float aSc = na
                    float d   = na
                    if stModeA
                        px := c.side == 1 ? (c.sZ >= SR_STRONG ? c.top : c.bTop) : (c.sZ >= SR_STRONG ? c.bot : c.bBot)
                        [s1, sc1] = f_stAdopt(c, px, px)
                        aS  := s1
                        aSc := sc1
                        d   := math.abs(close - px)
                        ok  := (c.side == 1 ? close > c.top : close < c.bot) and aS >= SR_STRONG
                    else if stModeD
                        aS  := array.get(dAS, k)
                        aSc := array.get(dASc, k)
                        d   := math.abs(close - (c.side == 1 ? c.top : c.bot))
                        ok  := true
                    else
                        [s2, sc2] = f_stAdopt(c, math.max(low, c.bot), math.min(high, c.top))
                        aS  := s2
                        aSc := sc2
                        d   := math.abs(close - (c.side == 1 ? c.top : c.bot))
                        bool trkOK = false
                        int  idx   = array.indexof(curTrk, c.track)
                        if idx >= 0
                            trkOK := array.get(curSt, idx) == (c.side == 1 ? ST_SUPPORT : ST_RESIST)
                        ok := low <= c.top and high >= c.bot and (c.side == 1 ? close > c.top : close < c.bot) and aS >= SR_STRONG and trkOK and (not stModeC or (c.side == 1 ? stPatL : stPatS))
                    if ok and c.side == 1
                        bool take = bkL < 0
                        if not take
                            take := f_stBetter(stModeA, aS, aSc, d, c.track, bsL, bcL, bdL, btL)
                        if take
                            bkL := k
                            bpL := px
                            bsL := aS
                            bcL := aSc
                            bdL := d
                            btL := c.track
                    if ok and c.side == -1
                        bool take = bkS < 0
                        if not take
                            take := f_stBetter(stModeA, aS, aSc, d, c.track, bsS, bcS, bdS, btS)
                        if take
                            bkS := k
                            bpS := px
                            bsS := aS
                            bcS := aSc
                            bdS := d
                            btS := c.track
        // Both で Long / Short が同じ足に成立: B / C / D は見送り。A は指値が終値に近い方 (同じ距離なら見送り)
        int side = 0
        if bkL >= 0 and bkS >= 0
            if stModeA and bdL != bdS
                side := bdL < bdS ? 1 : -1
        else if bkL >= 0
            side := 1
        else if bkS >= 0
            side := -1
        if side != 0
            StCand c   = array.get(src, side == 1 ? bkL : bkS)
            float  pL  = stModeA ? (side == 1 ? bpL : bpS) : na
            float  pSL = side == 1 ? c.bot - stBuffer : c.top + stBuffer
            float  ref = stModeA ? pL : close
            // 発注前の RR 判定 (参照価格)。約定後に実約定価格で同じ判定をやり直す
            [skipRef, tpRef] = f_stTp(side, ref, pSL, f_stNearest(side == 1 ? tpUp : tpDn, side, ref))
            // 数量: 同じ参照価格 (A: 指値 / B, C, D: この確定足の終値) と固定 SL から。無効 / 最小 lot 未満は発注しない
            float  pQty = f_stQty(side, ref, pSL)
            if stSats
                // XA-7 / XA-10: 選択した Entry Mode (A〜D) が発注する条件を満たした → 発注せず待機を準備する
                //   (P0 = ref: A は指値価格 pL / B・C・D は確定足の終値。待機中・取消した足では何もしない)
                // XA-16: 直近の反発で即時エントリー (ON のときだけ。待機中・取消した足では判定しない = 割り込みなし)
                //   有効 (XA-19) = 0 <= t − e <= Nz かつ 0 <= e − q <= Nc (期限内で最新の同方向の反発)。この足の逆方向一致・数量 f_stQty(side, close, SL0)・
                //   SL / TP の向き (SL0 と TP0 の間に終値) が必要。過去の反発線の SL0〜P0 範囲・P0 より有利な終値・
                //   この足の再接触 / 実体は要求しない。成立しなければ下の従来の準備 (接触待ちから) へ進む
                bool nowGo = false
                if stSatsNow and not skipRef and not na(pQty) and pwState == 0 and not pwCancelBar
                    int   hBar = side == 1 ? hEL : hES     // XA-19: 採用する反発の成立足 e (t − e <= Nz。e − q <= Nc は候補の採用時に確認済み)
                    int   hAge = na(hBar) ? na : bar_index - hBar
                    float nQty = f_stQty(side, close, pSL)
                    bool  nMtf = not (side == 1 ? satSkipL : satSkipS)
                    bool  nDir = side * (close - pSL) > 0 and side * (tpRef - close) > 0
                    if not na(hAge) and hAge >= 0 and hAge <= stSatsNowN and nMtf and nDir and not na(nQty)
                        oSeq    += 1
                        oEid    := (side == 1 ? "L" : "S") + str.tostring(oSeq)
                        oXid    := oEid + " SL/TP"
                        oSide   := side
                        oTrack  := c.track
                        oLimit  := false
                        oL      := na
                        oSL     := pSL
                        oStop   := pSL
                        oTP     := na
                        oTP0    := tpRef
                        oFill   := na
                        oBE     := false
                        oClosed := strategy.closedtrades
                        oState  := 1
                        oPath   := 2
                        strategy.entry(oEid, side == 1 ? strategy.long : strategy.short, qty = nQty)
                        strategy.exit(oXid, oEid, stop = oSL)
                        f_stConfAlert(side, close, pSL, tpRef, false, true)     // XA-21 確定: 即時の発注 (Entry は判断足の終値、SL0 / TP0 は準備地点の値)
                        pwP0     := ref
                        pwSL0    := pSL
                        pwTP0    := tpRef
                        pwRRPrep := side * (tpRef - ref) / (side * (ref - pSL))
                        pwRRPlan := side * (tpRef - close) / (side * (close - pSL))
                        pwRRFill := na
                        pwRRWhy  := na
                        pwEv     := 3
                        pwNNow   += 1
                        pwNowK   := side == 1 ? hKL : hKS
                        pwNowAge := hAge
                        pwNowCq  := hBar - (side == 1 ? hQL : hQS)
                        nowGo    := true
                if not skipRef and not na(pQty) and pwState == 0 and not pwCancelBar and not nowGo
                    pwState  := 1
                    pwSide   := side
                    pwTrack  := c.track
                    pwBar    := bar_index
                    pwEndT   := time_close
                    pwP0     := ref
                    pwSL0    := pSL
                    pwTP0    := tpRef
                    pwRRPrep := side * (tpRef - ref) / (side * (ref - pSL))
                    pwEv     := 1
                    pwNPrep  += 1
                    pwTouched  := false     // XA-9: 新しい準備は接触待ちから
                    pwTouchSeen := false
                    pwTouchK   := 0
                    pwTouchBar := na
            else if not skipRef and not na(pQty)
                oSeq    += 1
                oEid    := (side == 1 ? "L" : "S") + str.tostring(oSeq)
                oXid    := oEid + " SL/TP"
                oSide   := side
                oTrack  := c.track
                oLimit  := stModeA
                oL      := pL
                oSL     := pSL
                oStop   := pSL
                oTP     := na
                oFill   := na
                oBE     := false
                oClosed := strategy.closedtrades
                oState  := 1
                if stModeA
                    strategy.entry(oEid, side == 1 ? strategy.long : strategy.short, qty = pQty, limit = oL)
                else
                    strategy.entry(oEid, side == 1 ? strategy.long : strategy.short, qty = pQty)
                strategy.exit(oXid, oEid, stop = oSL)
                f_stConfAlert(side, stModeA ? oL : close, pSL, tpRef, stModeA, false)     // XA-21 確定: Current の発注 (A は指値価格、TP は発注判断時の予定)
    stPrev := cur
    stTpUpPrev := tpUp
    stTpDnPrev := tpDn

plot(stZones,   "ST · Zones",             display = display.data_window)
plot(stFvgZone, "ST · Zones with FVG",    display = display.data_window)
plot(stBoosted, "ST · FVG boosted zones", display = display.data_window)
plot(oState == 1 and oLimit ? oL : na, "ST · Pending Limit",     display = display.data_window)
plot(oState >= 1 ? oStop : na,         "ST · Stop (SL / BE)",    display = display.data_window)
plot(oState == 2 ? oTP : na,           "ST · TP",                display = display.data_window)
plot(oState == 2 ? oSide * (oFill - oSL) : na, "ST · BE 1R (実約定価格〜初期 SL)", display = display.data_window)
plot(oState == 2 ? oSide * (oTP - oFill) : na, "ST · BE 実約定価格〜TP の距離", display = display.data_window)
plot(oState == 2 ? f_beTrig(oSide, oFill, oSL, oTP) : na, "ST · BE Trigger 幅 (選択方式)", display = display.data_window)
plot(oState == 2 ? oFill + oSide * f_beTrig(oSide, oFill, oSL, oTP) : na, "ST · BE Trigger 価格", display = display.data_window)
plot(stSessOK ? 1 : 0,                 "ST · Entry Session",     display = display.data_window)
// XA-7 SATS Pullback の確認表示 (データウィンドウ + 小さな印。永続ラベルは追加しない。仮 / 確定アラートは XA-21)
plot(stSats and stSatsShow ? satL1 : na,  "SATS · LINE1", color = color.new(color.teal, 0))
plot(stSats and stSatsShow ? satL2 : na,  "SATS · LINE2", color = color.new(color.orange, 0))
plot(stSats and stSatsShow ? satStb : na, "SATS · STB",   color = color.new(color.purple, 0))
plot(stSats ? pwState : na,                "SATS · 待機中",          display = display.data_window)
plot(stSats ? pwEv : na,                   "SATS · イベント (1 準備 / 2 発注 / -1 期限 / -2 Track / -3 資格 / -4 SL0)", display = display.data_window)
plot(stSats ? pwLineK : na,                "SATS · 対象線 (1 L1 / 2 L2 / 3 STB)", display = display.data_window)
plot(stSats ? pwLineP : na,                "SATS · 対象線の価格 (足 t-1 確定値)", display = display.data_window)
plot(stSats ? pwP0 : na,                   "SATS · P0",              display = display.data_window)
plot(stSats ? pwSL0 : na,                  "SATS · SL0",             display = display.data_window)
plot(stSats ? pwTP0 : na,                  "SATS · TP0",             display = display.data_window)
plot(stSats ? pwRRPrep : na,               "SATS · 準備 RR",          display = display.data_window)
plot(stSats ? pwRRPlan : na,               "SATS · 発注時の予定 RR",   display = display.data_window)
plot(stSats ? pwRRFill : na,               "SATS · 実 RR (実約定価格)", display = display.data_window)
plot(stSats ? pwRRWhy : na,                "SATS · 実 RR の理由 (0 可 / 1 risk<=0 / 2 reward<=0 / 3 na)", display = display.data_window)
plot(stSats ? pwNFill : na,                "SATS · 実 RR 記録件数", display = display.data_window)
plot(stSats ? pwFillPath : na,             "SATS · 記録経路 (1 保有中 / 2 約定足内で決済済み)", display = display.data_window)
plot(stSats ? pwNPrep : na,                "SATS · 準備件数",          display = display.data_window)
plot(stSats ? pwNOrder : na,               "SATS · 発注件数",          display = display.data_window)
plot(stSats ? pwNExp : na,                 "SATS · 期限切れ件数",      display = display.data_window)
plot(stSats ? (pwTouched ? 1 : 0) : na,    "SATS · 接触 (0 接触待ち / 1 接触済み・反発待ち)", display = display.data_window)
plot(stSats ? pwTouchK : na,               "SATS · 保持している線 (1 L1 / 2 L2 / 3 STB / 0 未接触)", display = display.data_window)
plot(stSats ? pwNTouchPrep : na,           "SATS · 接触を経験した準備件数", display = display.data_window)
plot(stSats ? pwNOrdSame : na,             "SATS · 発注 (同じ足の接触・反発。近接 ON は近接の同一足反発を含む)", display = display.data_window)
plot(stSats ? pwNOrdLater : na,            "SATS · 発注 (接触後の別の足の戻り)", display = display.data_window)
plot(stSats ? pwNSL : na,                  "SATS · SL0 到達の取消件数", display = display.data_window)
plot(stSats ? pwNBad : na,                 "SATS · 不適切な約定の決済件数", display = display.data_window)
plot(stSats ? oPath : na,                  "SATS · 直近発注の経路 (1 引きつけ / 2 即時)", display = display.data_window)
plot(stSats ? pwNNow : na,                 "SATS · 即時エントリーの発注件数 (引きつけは「発注件数」)", display = display.data_window)
plot(stSats ? pwNowK : na,                 "SATS · 即時で採用した反発の線 (1 L1 / 2 L2 / 3 STB)", display = display.data_window)
plot(stSats ? pwNowCq : na,                "SATS · 即時で採用した反発の 接触→反発 本数 (e − q)", display = display.data_window)
plot(stSats ? pwNowAge : na,               "SATS · 即時で採用した反発の 反発→Zone 本数 (t − e)", display = display.data_window)
plot(stSats and oPath == 1 ? pwRRPlan : na, "SATS · 引きつけ 予定 RR", display = display.data_window)
plot(stSats and oPath == 1 ? pwRRFill : na, "SATS · 引きつけ 実 RR", display = display.data_window)
plot(stSats and oPath == 2 ? pwRRPlan : na, "SATS · 即時 予定 RR", display = display.data_window)
plot(stSats and oPath == 2 ? pwRRFill : na, "SATS · 即時 実 RR", display = display.data_window)
plot(na(hEL) ? na : bar_index - hEL,      "SATS · Long 即時候補 (期限内で最新の反発) の 反発→現在 本数", display = display.data_window)
plot(na(hES) ? na : bar_index - hES,      "SATS · Short 即時候補 (期限内で最新の反発) の 反発→現在 本数", display = display.data_window)
plot(stSats and pwTouched ? bar_index - pwTouchBar : na, "SATS · 引きつけ側 接触からの本数 (現在 − q)", display = display.data_window)
plot(stSats ? pwNTqExp : na,               "SATS · 引きつけ側 接触期限切れ件数 (待機は継続)", display = display.data_window)
plot(satTfD,                               "SATS 逆方向一致 · 日足 (1 青 / -1 赤 / 0 無点灯 / n/a 未成立)", display = display.data_window)
plot(satTf4,                               "SATS 逆方向一致 · 4H (1 青 / -1 赤 / 0 無点灯 / n/a 未成立)", display = display.data_window)
plot(satTf1,                               "SATS 逆方向一致 · 1H (1 青 / -1 赤 / 0 無点灯 / n/a 未成立)", display = display.data_window)
plot(satTf15,                              "SATS 逆方向一致 · 15分 (1 青 / -1 赤 / 0 無点灯 / n/a 未成立)", display = display.data_window)
plot(satTf5,                               "SATS 逆方向一致 · 5分 (1 青 / -1 赤 / 0 無点灯 / n/a 未成立)", display = display.data_window)
plot(satSkipL ? 1 : 0,                     "SATS 逆方向一致 · Long 見送り判定 (1 見送り / 0 なし)", display = display.data_window)
plot(satSkipS ? 1 : 0,                     "SATS 逆方向一致 · Short 見送り判定 (1 見送り / 0 なし)", display = display.data_window)
plotshape(stSats and pwEv == 1, "SATS · 準備", style = shape.circle, location = location.abovebar, color = color.gray, size = size.tiny)
plotshape(stSats and pwEv == 2, "SATS · 発注", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)
plotshape(stSats and pwEv == 3, "SATS · 即時発注", style = shape.diamond, location = location.abovebar, color = color.blue, size = size.tiny)
plotshape(stSats and pwEv < 0,  "SATS · 取消", style = shape.xcross, location = location.abovebar, color = color.silver, size = size.tiny)

// ---- XA-21 仮アラート: 形成中の 5分足 (未確定 tick) だけ。Engine / Zone / FVG / 反発履歴 / 待機 / 注文 / 使用済み Track は変えない ----
//  ・新規 Entry と同じ制限: 注文・保有なし (直前の確定時の状態)、Direction、同一 Track 1 回、Zone 資格、数量。時間帯は判定足の
//    終了時刻 (確定時と同じ基準) に加えて送信する実時刻 (timenow) も時間帯の中 (例: 8:55〜9:00 の足は 9:00 前に出さない)
//  ・SATS: 待機中の引きつけ発注 / 即時エントリー ON の即時発注だけ (待機の準備だけでは出さない)。Current: 選択した Entry Mode の発注
//  ・1 本の 5分足につき最大 1 回 (varip gProvAlertBar。確定アラートとは別の状態)。送信後は同じ足で評価・再送しない
bool  stPvSess = stSessOK and (not stUseSess or f_stInSession(timenow))
bool  stPvA    = stAlertProv and is5mChart and not barstate.isconfirmed and oState == 0 and stPvSess and array.get(gProvAlertBar, 0) != time
int   pSide    = 0
float pPx      = na
float pSL      = na
float pTP      = na
if stPvA and stSats
    [sS, eS, lS, tS] = f_satProvEval(close[1], satL1[1], satL2[1], satStb[1])
    pSide := sS
    pPx   := eS
    pSL   := lS
    pTP   := tS
if stPvA and not stSats
    [s0, e0, l0, t0] = f_stProvEval()
    pSide := s0
    pPx   := e0
    pSL   := l0
    pTP   := t0
float pvQty = pSide != 0 ? f_stQty(pSide, pPx, pSL) : na     // 参考値 (確定時は判断足の終値で計算し直す)
if stPvA and pSide != 0 and not na(pvQty)
    array.set(gProvAlertBar, 0, time)
    alert(f_stAlertMsg("仮", pSide, pPx, pSL, pTP, not stSats and stModeA, stSats), alert.freq_once_per_bar)
// ==== ZONE Strategy · Zone evaluation (end) ===========================================

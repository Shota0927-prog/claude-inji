// © your_username
//
// ============================================================================
//  Trend Reversal Probability Rank v1
// ----------------------------------------------------------------------------
//  下降→上昇 / 上昇→下降 の「転換可能性」を条件ごとに点数化し、
//  D / C / B / A / S のランクと転換確率を表示するインジケーターです。
//
//  特徴：
//   - 各判定条件は input.bool で個別に ON/OFF 可能
//   - 各条件の配点も input で変更可能
//   - ON にした条件だけでスコアの分母（maxScore）を再計算
//   - ランク別・条件別に「実際に転換成功した確率」を過去検証で計測
//   - BUY / SELL 両方向に対応
//   - チャートラベル表示・アラート対応
//
//  注意：
//   Pine Script の制約上、完全な AI 的確率計算ではなく
//   「ルールベースの統計集計」で実装しています。
//   表示している転換確率（D=20% など）はルール上の目安値であり、
//   実測統計テーブルの数値が「実際の成功率」です。
// ============================================================================

//@version=5
indicator(
     title         = "Trend Reversal Probability Rank v1",
     shorttitle    = "TR Rank v1",
     overlay       = true,
     max_labels_count = 500,
     max_bars_back = 1000
 )

// ============================================================================
// 0. 共通入力（方向・表示・ランク閾値・確率）
// ============================================================================
grpGeneral = "■ 全般設定"
// 判定方向：BUYのみ / SELLのみ / 両方
dirMode = input.string("両方", title = "判定方向", options = ["両方", "BUYのみ", "SELLのみ"], group = grpGeneral)
allowBuy  = dirMode != "SELLのみ"
allowSell = dirMode != "BUYのみ"

// チャートラベルを表示する最低ランク
minRankSel = input.string("C以上", title = "ラベル表示の最低ランク", options = ["D以上", "C以上", "B以上", "A以上", "Sのみ"], group = grpGeneral)
minRankIdx = minRankSel == "Sのみ" ? 4 : minRankSel == "A以上" ? 3 : minRankSel == "B以上" ? 2 : minRankSel == "C以上" ? 1 : 0

grpThresh = "■ ランク閾値（scorePercent 0〜100）"
// scorePercent からランクへ変換する閾値（初期：0-24 D / 25-44 C / 45-64 B / 65-84 A / 85+ S）
thD = input.float(0,  title = "D 最低スコア%", minval = 0, maxval = 100, group = grpThresh)
thC = input.float(25, title = "C 最低スコア%", minval = 0, maxval = 100, group = grpThresh)
thB = input.float(45, title = "B 最低スコア%", minval = 0, maxval = 100, group = grpThresh)
thA = input.float(65, title = "A 最低スコア%", minval = 0, maxval = 100, group = grpThresh)
thS = input.float(85, title = "S 最低スコア%", minval = 0, maxval = 100, group = grpThresh)

grpProb = "■ ランク別 転換確率（表示用の目安）"
probD = input.float(20, title = "D 確率%", group = grpProb)
probC = input.float(35, title = "C 確率%", group = grpProb)
probB = input.float(50, title = "B 確率%", group = grpProb)
probA = input.float(75, title = "A 確率%", group = grpProb)
probS = input.float(90, title = "S 確率%", group = grpProb)

grpTable = "■ テーブル表示"
showStatusTable = input.bool(true, title = "現在の転換状況テーブルを表示", group = grpTable)
showStatsTable  = input.bool(true, title = "実測統計テーブルを表示",       group = grpTable)

// ============================================================================
// 1. 各判定条件の ON/OFF と配点
// ============================================================================
// 【1】トレンド方向判定
grpC1 = "【1】トレンド方向判定 (EMA200)"
cond1On  = input.bool(true, title = "ON/OFF", group = grpC1)
pts1     = input.int(10, title = "配点", minval = 0, group = grpC1)
ema200Len = input.int(200, title = "EMA200 期間", minval = 1, group = grpC1)

// 【2】勢い減速
grpC2 = "【2】勢い減速"
cond2On  = input.bool(true, title = "ON/OFF", group = grpC2)
pts2     = input.int(10, title = "配点", minval = 0, group = grpC2)
momLen   = input.int(14, title = "実体平均の期間", minval = 1, group = grpC2)

// 【3】RSIダイバージェンス
grpC3 = "【3】RSIダイバージェンス"
cond3On  = input.bool(true, title = "ON/OFF", group = grpC3)
pts3     = input.int(10, title = "配点", minval = 0, group = grpC3)
rsiLen   = input.int(14, title = "RSI 期間", minval = 1, group = grpC3)
divLook  = input.int(10, title = "ダイバージェンス比較本数", minval = 1, group = grpC3)

// 【4】流動性スイープ
grpC4 = "【4】流動性スイープ"
cond4On  = input.bool(true, title = "ON/OFF", group = grpC4)
pts4     = input.int(15, title = "配点", minval = 0, group = grpC4)

// 【5】ヒゲ反発
grpC5 = "【5】ヒゲ反発"
cond5On  = input.bool(true, title = "ON/OFF", group = grpC5)
pts5     = input.int(10, title = "配点", minval = 0, group = grpC5)
wickMult = input.float(1.5, title = "ヒゲ/実体 倍率 (wickMultiplier)", minval = 0.1, group = grpC5)

// 【6】FVG吸収
grpC6 = "【6】FVG吸収（簡易）"
cond6On  = input.bool(true, title = "ON/OFF", group = grpC6)
pts6     = input.int(15, title = "配点", minval = 0, group = grpC6)

// 【7】CHOCH / BOS
grpC7 = "【7】CHOCH / BOS"
cond7On  = input.bool(true, title = "ON/OFF", group = grpC7)
pts7     = input.int(15, title = "配点", minval = 0, group = grpC7)

// 【8】EMA突破（EMA20/50/200 個別配点）
grpC8 = "【8】EMA突破"
cond8On  = input.bool(true, title = "ON/OFF", group = grpC8)
ema20Len = input.int(20, title = "EMA20 期間", minval = 1, group = grpC8)
ema50Len = input.int(50, title = "EMA50 期間", minval = 1, group = grpC8)
ptsE20   = input.int(5,  title = "EMA20 突破 配点", minval = 0, group = grpC8)
ptsE50   = input.int(5,  title = "EMA50 突破 配点", minval = 0, group = grpC8)
ptsE200  = input.int(10, title = "EMA200 突破 配点", minval = 0, group = grpC8)

// 【9】押し目 / 戻り確認
grpC9 = "【9】押し目 / 戻り確認"
cond9On  = input.bool(true, title = "ON/OFF", group = grpC9)
pts9     = input.int(15, title = "配点", minval = 0, group = grpC9)
pullbackBars = input.int(10, title = "CHOCH後の有効本数", minval = 1, group = grpC9)

// スイング検出（条件4・7・9 で使用）
grpSwing = "■ スイング検出"
swingLen = input.int(5, title = "スイング左右本数 (pivot)", minval = 1, group = grpSwing)

// ============================================================================
// 2. バックテスト（実測成功率）用 入力
// ============================================================================
grpBT = "■ 実測成功率の計測"
lookaheadBars   = input.int(50,  title = "成否を見る本数 (lookaheadBars)", minval = 1, group = grpBT)
priceMoveTarget = input.float(10.0, title = "成功とみなす値幅 (priceMoveTarget)", minval = 0.0, group = grpBT)
stopMove        = input.float(5.0,  title = "失敗とみなす逆行幅 (stopMove)",     minval = 0.0, group = grpBT)
cooldownBars    = input.int(10,  title = "クールダウン本数 (cooldownBars)", minval = 0, group = grpBT)

// ============================================================================
// 3. 共通テクニカル計算
// ============================================================================
ema20  = ta.ema(close, ema20Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)
rsi    = ta.rsi(close, rsiLen)

// ローソク要素
body   = math.abs(close - open)
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
mid    = (high + low) / 2.0

// 実体平均（勢い減速の判定に使用）
bodyAvg = ta.sma(body, momLen)

// 直近の確定スイング高値・安値を保持
var float lastSwingHigh = na
var float lastSwingLow  = na
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

// ============================================================================
// 4. 各条件の「発火」判定（BUY / SELL）
// ============================================================================

// --- 【1】トレンド方向判定 -------------------------------------------------
// BUY 前提：価格が EMA200 より下、または EMA200 が下向き
// SELL前提：価格が EMA200 より上、または EMA200 が上向き
ema200Down = ema200 < ema200[1]
ema200Up   = ema200 > ema200[1]
buyTrend  = (close < ema200) or ema200Down
sellTrend = (close > ema200) or ema200Up

// --- 【2】勢い減速 ---------------------------------------------------------
// 安値/高値の更新幅が小さくなる、または実体平均が小さくなる
bodyShrink = bodyAvg < bodyAvg[1]
// BUY：下方向への更新幅が縮小
drop1 = low[1] - low
drop2 = low[2] - low[1]
buyNarrow = drop1 > 0 and drop2 > 0 and drop1 < drop2
buyMom  = buyNarrow or bodyShrink
// SELL：上方向への更新幅が縮小
rise1 = high - high[1]
rise2 = high[1] - high[2]
sellNarrow = rise1 > 0 and rise2 > 0 and rise1 < rise2
sellMom = sellNarrow or bodyShrink

// --- 【3】RSIダイバージェンス ---------------------------------------------
// BUY：価格は安値更新（より安い）、RSIは安値切り上げ
buyDiv  = (low < low[divLook]) and (rsi > rsi[divLook])
// SELL：価格は高値更新、RSIは高値切り下げ
sellDiv = (high > high[divLook]) and (rsi < rsi[divLook])

// --- 【4】流動性スイープ ---------------------------------------------------
// BUY：直近スイング安値を下抜けた後、終値でその安値の上に戻る
buySweep  = not na(lastSwingLow)  and (low  < lastSwingLow)  and (close > lastSwingLow)
// SELL：直近スイング高値を上抜けた後、終値でその高値の下に戻る
sellSweep = not na(lastSwingHigh) and (high > lastSwingHigh) and (close < lastSwingHigh)

// --- 【5】ヒゲ反発 ---------------------------------------------------------
// BUY：長い下ヒゲ + 終値が上半分
buyWick  = (dnWick > body * wickMult) and (close > mid)
// SELL：長い上ヒゲ + 終値が下半分
sellWick = (upWick > body * wickMult) and (close < mid)

// --- 【6】FVG吸収（簡易） --------------------------------------------------
// Bull FVG：low > high[2]   Bear FVG：high < low[2]
// BUY：過去の Bear FVG（下抜けギャップ）の上限を終値で上抜け＝吸収
// SELL：過去の Bull FVG（上抜けギャップ）の下限を終値で下抜け＝吸収
var float bearFVGtop = na   // Bear FVG の上限（low[2]）
var float bullFVGbot = na   // Bull FVG の下限（high[2]）
if high < low[2]
    bearFVGtop := low[2]
if low > high[2]
    bullFVGbot := high[2]
buyFVG  = not na(bearFVGtop) and (close > bearFVGtop) and (close[1] <= bearFVGtop)
sellFVG = not na(bullFVGbot) and (close < bullFVGbot) and (close[1] >= bullFVGbot)

// --- 【7】CHOCH / BOS ------------------------------------------------------
// BUY：直近スイング高値を終値で上抜け
// SELL：直近スイング安値を終値で下抜け
buyChoch  = not na(lastSwingHigh) and (close > lastSwingHigh) and (close[1] <= lastSwingHigh)
sellChoch = not na(lastSwingLow)  and (close < lastSwingLow)  and (close[1] >= lastSwingLow)

// --- 【8】EMA突破 ----------------------------------------------------------
// BUY：EMA20/50/200 を上抜け（個別配点）
buyE20  = ta.crossover(close, ema20)
buyE50  = ta.crossover(close, ema50)
buyE200 = ta.crossover(close, ema200)
// SELL：EMA20/50/200 を下抜け（個別配点）
sellE20  = ta.crossunder(close, ema20)
sellE50  = ta.crossunder(close, ema50)
sellE200 = ta.crossunder(close, ema200)
emaBuyPts  = (buyE20 ? ptsE20 : 0) + (buyE50 ? ptsE50 : 0) + (buyE200 ? ptsE200 : 0)
emaSellPts = (sellE20 ? ptsE20 : 0) + (sellE50 ? ptsE50 : 0) + (sellE200 ? ptsE200 : 0)
emaBuyFired  = buyE20 or buyE50 or buyE200
emaSellFired = sellE20 or sellE50 or sellE200
emaMax = ptsE20 + ptsE50 + ptsE200

// --- 【9】押し目 / 戻り確認 -----------------------------------------------
// CHOCH 後、一定本数以内に EMA20/50 付近まで戻して陽線/陰線確定
var int chochBuyBar  = na
var int chochSellBar = na
if buyChoch
    chochBuyBar := bar_index
if sellChoch
    chochSellBar := bar_index
buyPullActive  = not na(chochBuyBar)  and (bar_index - chochBuyBar)  <= pullbackBars
sellPullActive = not na(chochSellBar) and (bar_index - chochSellBar) <= pullbackBars
// BUY：EMA20/50 まで押して陽線確定（安値を割らない＝終値が前足終値より上）
buyPull  = buyPullActive  and (low  <= math.max(ema20, ema50)) and (close > open) and (close >= close[1])
// SELL：EMA20/50 まで戻して陰線確定
sellPull = sellPullActive and (high >= math.min(ema20, ema50)) and (close < open) and (close <= close[1])

// ============================================================================
// 5. スコア計算（ON条件だけで分母を再計算）
// ============================================================================
// 各条件の「ON かつ 発火」フラグ（条件別統計のビットにも使用）
fb1 = cond1On and buyTrend
fb2 = cond2On and buyMom
fb3 = cond3On and buyDiv
fb4 = cond4On and buySweep
fb5 = cond5On and buyWick
fb6 = cond6On and buyFVG
fb7 = cond7On and buyChoch
fb8 = cond8On and emaBuyFired
fb9 = cond9On and buyPull

fs1 = cond1On and sellTrend
fs2 = cond2On and sellMom
fs3 = cond3On and sellDiv
fs4 = cond4On and sellSweep
fs5 = cond5On and sellWick
fs6 = cond6On and sellFVG
fs7 = cond7On and sellChoch
fs8 = cond8On and emaSellFired
fs9 = cond9On and sellPull

// 獲得スコア（ON かつ 発火した条件の配点合計）
scoreBuy = (fb1 ? pts1 : 0) + (fb2 ? pts2 : 0) + (fb3 ? pts3 : 0) + (fb4 ? pts4 : 0) + (fb5 ? pts5 : 0) + (fb6 ? pts6 : 0) + (fb7 ? pts7 : 0) + (cond8On ? emaBuyPts : 0) + (fb9 ? pts9 : 0)
scoreSell = (fs1 ? pts1 : 0) + (fs2 ? pts2 : 0) + (fs3 ? pts3 : 0) + (fs4 ? pts4 : 0) + (fs5 ? pts5 : 0) + (fs6 ? pts6 : 0) + (fs7 ? pts7 : 0) + (cond8On ? emaSellPts : 0) + (fs9 ? pts9 : 0)

// 最大スコア（ON にした条件の満点合計）＝分母
maxScoreBuy = (cond1On ? pts1 : 0) + (cond2On ? pts2 : 0) + (cond3On ? pts3 : 0) + (cond4On ? pts4 : 0) + (cond5On ? pts5 : 0) + (cond6On ? pts6 : 0) + (cond7On ? pts7 : 0) + (cond8On ? emaMax : 0) + (cond9On ? pts9 : 0)
maxScoreSell = maxScoreBuy   // BUY/SELL で ON条件は共通なので分母は同じ

// 100点換算
scorePercentBuy  = maxScoreBuy  > 0 ? scoreBuy  * 100.0 / maxScoreBuy  : 0.0
scorePercentSell = maxScoreSell > 0 ? scoreSell * 100.0 / maxScoreSell : 0.0

// ============================================================================
// 6. ランク判定（関数）
// ============================================================================
// scorePercent → ランクインデックス（-1:なし, 0:D, 1:C, 2:B, 3:A, 4:S）
f_rankIdx(pct) =>
    pct >= thS ? 4 : pct >= thA ? 3 : pct >= thB ? 2 : pct >= thC ? 1 : pct >= thD ? 0 : -1

f_rankStr(idx) =>
    idx == 4 ? "S" : idx == 3 ? "A" : idx == 2 ? "B" : idx == 1 ? "C" : idx == 0 ? "D" : "-"

f_prob(idx) =>
    idx == 4 ? probS : idx == 3 ? probA : idx == 2 ? probB : idx == 1 ? probC : idx == 0 ? probD : 0.0

rankBuyIdx  = f_rankIdx(scorePercentBuy)
rankSellIdx = f_rankIdx(scorePercentSell)
rankBuyStr  = f_rankStr(rankBuyIdx)
rankSellStr = f_rankStr(rankSellIdx)
probBuy  = f_prob(rankBuyIdx)
probSell = f_prob(rankSellIdx)

// ============================================================================
// 7. 実測統計エンジン（ランク別 / 条件別の成功率）
// ============================================================================
// --- カウンタ用配列 -------------------------------------------------------
var int[] buyCnt  = array.new_int(5, 0)   // BUY ランク別 発生数 [D,C,B,A,S]
var int[] buySuc  = array.new_int(5, 0)   // BUY ランク別 成功数
var int[] sellCnt = array.new_int(5, 0)   // SELL ランク別 発生数
var int[] sellSuc = array.new_int(5, 0)   // SELL ランク別 成功数

// 条件別（9条件）BUY / SELL を分けて計測
var int[] condCntBuy  = array.new_int(9, 0)
var int[] condSucBuy  = array.new_int(9, 0)
var int[] condCntSell = array.new_int(9, 0)
var int[] condSucSell = array.new_int(9, 0)

// --- 保留中シグナル（成否判定待ち）---------------------------------------
var int[]   pendDir   = array.new_int()    // 1=BUY, -1=SELL
var float[] pendEntry = array.new_float()  // エントリー価格（シグナル足の終値）
var int[]   pendBar   = array.new_int()    // シグナル発生時の bar_index
var int[]   pendRank  = array.new_int()    // ランクインデックス
var int[]   pendMask  = array.new_int()    // 発火条件のビットマスク

// クールダウン管理
var int lastBuyBar  = na
var int lastSellBar = na

// --- ヘルパー関数 ---------------------------------------------------------
// 配列の指定要素を +1
f_inc(int[] arr, int idx) =>
    array.set(arr, idx, array.get(arr, idx) + 1)

// ビットマスクの立っているビットに対応する配列要素を +1
f_applyMask(int[] arr, int msk) =>
    for i = 0 to 8
        if (math.floor(msk / math.pow(2, i)) % 2) >= 1
            array.set(arr, i, array.get(arr, i) + 1)

// 発火条件からビットマスクを生成
maskBuy  = (fb1 ? 1 : 0) + (fb2 ? 2 : 0) + (fb3 ? 4 : 0) + (fb4 ? 8 : 0) + (fb5 ? 16 : 0) + (fb6 ? 32 : 0) + (fb7 ? 64 : 0) + (fb8 ? 128 : 0) + (fb9 ? 256 : 0)
maskSell = (fs1 ? 1 : 0) + (fs2 ? 2 : 0) + (fs3 ? 4 : 0) + (fs4 ? 8 : 0) + (fs5 ? 16 : 0) + (fs6 ? 32 : 0) + (fs7 ? 64 : 0) + (fs8 ? 128 : 0) + (fs9 ? 256 : 0)

// --- シグナル発生条件（クールダウン込み）---------------------------------
buyCooldownOK  = na(lastBuyBar)  or (bar_index - lastBuyBar)  > cooldownBars
sellCooldownOK = na(lastSellBar) or (bar_index - lastSellBar) > cooldownBars
buySignal  = allowBuy  and rankBuyIdx  >= 0 and scoreBuy  > 0 and buyCooldownOK
sellSignal = allowSell and rankSellIdx >= 0 and scoreSell > 0 and sellCooldownOK

// --- 計測本体（確定足のみ処理して安定化）---------------------------------
if barstate.isconfirmed
    // (a) 保留中シグナルの成否判定（後ろから走査して安全に削除）
    if array.size(pendDir) > 0
        for i = array.size(pendDir) - 1 to 0
            dir   = array.get(pendDir, i)
            entry = array.get(pendEntry, i)
            bbar  = array.get(pendBar, i)
            rnk   = array.get(pendRank, i)
            msk   = array.get(pendMask, i)
            age   = bar_index - bbar
            bool resolved = false
            bool success  = false
            // シグナル足の次足以降で判定（age>=1）
            if age >= 1
                if dir == 1
                    // BUY：先に stopMove 下落＝失敗 / priceMoveTarget 上昇＝成功
                    if low <= entry - stopMove
                        resolved := true
                        success  := false
                    else if high >= entry + priceMoveTarget
                        resolved := true
                        success  := true
                else
                    // SELL：先に stopMove 上昇＝失敗 / priceMoveTarget 下落＝成功
                    if high >= entry + stopMove
                        resolved := true
                        success  := false
                    else if low <= entry - priceMoveTarget
                        resolved := true
                        success  := true
            // lookaheadBars を超えても決着しなければ失敗扱い（期限切れ）
            if not resolved and age >= lookaheadBars
                resolved := true
                success  := false
            // 決着したらカウンタ更新＆保留から除去
            if resolved
                if success
                    if dir == 1
                        f_inc(buySuc, rnk)
                        f_applyMask(condSucBuy, msk)
                    else
                        f_inc(sellSuc, rnk)
                        f_applyMask(condSucSell, msk)
                array.remove(pendDir, i)
                array.remove(pendEntry, i)
                array.remove(pendBar, i)
                array.remove(pendRank, i)
                array.remove(pendMask, i)

    // (b) 新規シグナルの記録（発生数を即カウント）
    if buySignal
        array.push(pendDir, 1)
        array.push(pendEntry, close)
        array.push(pendBar, bar_index)
        array.push(pendRank, rankBuyIdx)
        array.push(pendMask, maskBuy)
        f_inc(buyCnt, rankBuyIdx)
        f_applyMask(condCntBuy, maskBuy)
        lastBuyBar := bar_index
    if sellSignal
        array.push(pendDir, -1)
        array.push(pendEntry, close)
        array.push(pendBar, bar_index)
        array.push(pendRank, rankSellIdx)
        array.push(pendMask, maskSell)
        f_inc(sellCnt, rankSellIdx)
        f_applyMask(condCntSell, maskSell)
        lastSellBar := bar_index

// ============================================================================
// 8. チャートラベル表示
// ============================================================================
// 表示は最低ランク以上のシグナルのみ。下=BUY / 上=SELL。
if barstate.isconfirmed and buySignal and rankBuyIdx >= minRankIdx
    label.new(bar_index, low, "BUY REV " + rankBuyStr + " " + str.tostring(probBuy, "#") + "%", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
if barstate.isconfirmed and sellSignal and rankSellIdx >= minRankIdx
    label.new(bar_index, high, "SELL REV " + rankSellStr + " " + str.tostring(probSell, "#") + "%", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

// 参考：EMA を表示
plot(ema20,  title = "EMA20",  color = color.new(color.yellow, 0))
plot(ema50,  title = "EMA50",  color = color.new(color.orange, 0))
plot(ema200, title = "EMA200", color = color.new(color.blue, 0))

// ============================================================================
// 9. アラート（D以上 / C以上 / B以上 / A以上 / S）
// ============================================================================
alertcondition(buySignal and rankBuyIdx >= 0, title = "BUY転換 D以上", message = "BUY転換 Dランク以上 発生")
alertcondition(buySignal and rankBuyIdx >= 1, title = "BUY転換 C以上", message = "BUY転換 Cランク以上 発生")
alertcondition(buySignal and rankBuyIdx >= 2, title = "BUY転換 B以上", message = "BUY転換 Bランク以上 発生")
alertcondition(buySignal and rankBuyIdx >= 3, title = "BUY転換 A以上", message = "BUY転換 Aランク以上 発生")
alertcondition(buySignal and rankBuyIdx == 4, title = "BUY転換 S",     message = "BUY転換 Sランク 発生")
alertcondition(sellSignal and rankSellIdx >= 0, title = "SELL転換 D以上", message = "SELL転換 Dランク以上 発生")
alertcondition(sellSignal and rankSellIdx >= 1, title = "SELL転換 C以上", message = "SELL転換 Cランク以上 発生")
alertcondition(sellSignal and rankSellIdx >= 2, title = "SELL転換 B以上", message = "SELL転換 Bランク以上 発生")
alertcondition(sellSignal and rankSellIdx >= 3, title = "SELL転換 A以上", message = "SELL転換 Aランク以上 発生")
alertcondition(sellSignal and rankSellIdx == 4, title = "SELL転換 S",     message = "SELL転換 Sランク 発生")

// ============================================================================
// 10. テーブル表示
// ============================================================================
// 成功率文字列を作るヘルパー
f_rate(int suc, int cnt) =>
    cnt > 0 ? str.tostring(suc * 100.0 / cnt, "#0.0") + "%" : "-"

// 条件名（条件別統計の表示に使用）
condNames = array.from("Trend", "勢い減速", "RSIダイバ", "スイープ", "ヒゲ反発", "FVG吸収", "CHOCH", "EMA突破", "押し目")

// ON条件 / 発火条件 の一覧文字列を生成
onArr        = array.from(cond1On, cond2On, cond3On, cond4On, cond5On, cond6On, cond7On, cond8On, cond9On)
firedBuyArr  = array.from(fb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8, fb9)
firedSellArr = array.from(fs1, fs2, fs3, fs4, fs5, fs6, fs7, fs8, fs9)

var string onStr        = ""
var string firingBuyStr = ""
var string firingSellStr = ""
if barstate.islast
    onStr := ""
    firingBuyStr := ""
    firingSellStr := ""
    for i = 0 to 8
        if array.get(onArr, i)
            onStr := onStr + (onStr == "" ? "" : ", ") + array.get(condNames, i)
        if array.get(firedBuyArr, i)
            firingBuyStr := firingBuyStr + (firingBuyStr == "" ? "" : ", ") + array.get(condNames, i)
        if array.get(firedSellArr, i)
            firingSellStr := firingSellStr + (firingSellStr == "" ? "" : ", ") + array.get(condNames, i)
    onStr := onStr == "" ? "(なし)" : onStr
    firingBuyStr := firingBuyStr == "" ? "(なし)" : firingBuyStr
    firingSellStr := firingSellStr == "" ? "(なし)" : firingSellStr

// --- 【現在の転換状況テーブル】右上 --------------------------------------
var table statusTbl = table.new(position.top_right, 2, 10, border_width = 1)
if showStatusTable and barstate.islast
    bgH = color.new(color.gray, 0)
    table.cell(statusTbl, 0, 0, "Trend Reversal", text_color = color.white, bgcolor = bgH)
    table.cell(statusTbl, 1, 0, "状況",            text_color = color.white, bgcolor = bgH)
    // BUY
    table.cell(statusTbl, 0, 1, "BUY スコア", text_color = color.white, bgcolor = color.new(color.green, 70))
    table.cell(statusTbl, 1, 1, str.tostring(scorePercentBuy, "#0.0") + "%", text_color = color.white, bgcolor = color.new(color.green, 70))
    table.cell(statusTbl, 0, 2, "BUY ランク", text_color = color.white, bgcolor = color.new(color.green, 80))
    table.cell(statusTbl, 1, 2, rankBuyStr, text_color = color.white, bgcolor = color.new(color.green, 80))
    table.cell(statusTbl, 0, 3, "BUY 転換確率", text_color = color.white, bgcolor = color.new(color.green, 80))
    table.cell(statusTbl, 1, 3, str.tostring(probBuy, "#") + "%", text_color = color.white, bgcolor = color.new(color.green, 80))
    // SELL
    table.cell(statusTbl, 0, 4, "SELL スコア", text_color = color.white, bgcolor = color.new(color.red, 70))
    table.cell(statusTbl, 1, 4, str.tostring(scorePercentSell, "#0.0") + "%", text_color = color.white, bgcolor = color.new(color.red, 70))
    table.cell(statusTbl, 0, 5, "SELL ランク", text_color = color.white, bgcolor = color.new(color.red, 80))
    table.cell(statusTbl, 1, 5, rankSellStr, text_color = color.white, bgcolor = color.new(color.red, 80))
    table.cell(statusTbl, 0, 6, "SELL 転換確率", text_color = color.white, bgcolor = color.new(color.red, 80))
    table.cell(statusTbl, 1, 6, str.tostring(probSell, "#") + "%", text_color = color.white, bgcolor = color.new(color.red, 80))
    // 条件一覧
    table.cell(statusTbl, 0, 7, "ON条件", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(statusTbl, 1, 7, onStr, text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(statusTbl, 0, 8, "発火(BUY)", text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 1, 8, firingBuyStr, text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 0, 9, "発火(SELL)", text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 1, 9, firingSellStr, text_color = color.white, bgcolor = color.new(color.gray, 70))

// --- 【実測統計テーブル】右下 --------------------------------------------
// 行構成：ランク別(BUY 5 + SELL 5) + 条件別(9) + ヘッダ
var table statsTbl = table.new(position.bottom_right, 4, 22, border_width = 1)
if showStatsTable and barstate.islast
    bgH = color.new(color.gray, 0)
    rankLabels = array.from("D", "C", "B", "A", "S")
    // ヘッダ：ランク別
    table.cell(statsTbl, 0, 0, "ランク別実測", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 1, 0, "発生", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 2, 0, "成功", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 3, 0, "成功率", text_color = color.white, bgcolor = bgH)
    // BUY ランク別
    for r = 0 to 4
        c = array.get(buyCnt, r)
        s = array.get(buySuc, r)
        table.cell(statsTbl, 0, 1 + r, "BUY " + array.get(rankLabels, r), text_color = color.white, bgcolor = color.new(color.green, 80))
        table.cell(statsTbl, 1, 1 + r, str.tostring(c), text_color = color.white, bgcolor = color.new(color.green, 85))
        table.cell(statsTbl, 2, 1 + r, str.tostring(s), text_color = color.white, bgcolor = color.new(color.green, 85))
        table.cell(statsTbl, 3, 1 + r, f_rate(s, c), text_color = color.white, bgcolor = color.new(color.green, 85))
    // SELL ランク別
    for r = 0 to 4
        c = array.get(sellCnt, r)
        s = array.get(sellSuc, r)
        table.cell(statsTbl, 0, 6 + r, "SELL " + array.get(rankLabels, r), text_color = color.white, bgcolor = color.new(color.red, 80))
        table.cell(statsTbl, 1, 6 + r, str.tostring(c), text_color = color.white, bgcolor = color.new(color.red, 85))
        table.cell(statsTbl, 2, 6 + r, str.tostring(s), text_color = color.white, bgcolor = color.new(color.red, 85))
        table.cell(statsTbl, 3, 6 + r, f_rate(s, c), text_color = color.white, bgcolor = color.new(color.red, 85))
    // ヘッダ：条件別
    table.cell(statsTbl, 0, 11, "条件別実測", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 1, 11, "BUY 発生", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 2, 11, "BUY 率", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 3, 11, "SELL 率", text_color = color.white, bgcolor = bgH)
    // 条件別（BUY/SELL 分割）
    for i = 0 to 8
        cb = array.get(condCntBuy, i)
        sb = array.get(condSucBuy, i)
        cs = array.get(condCntSell, i)
        ss = array.get(condSucSell, i)
        table.cell(statsTbl, 0, 12 + i, array.get(condNames, i), text_color = color.white, bgcolor = color.new(color.gray, 70))
        table.cell(statsTbl, 1, 12 + i, str.tostring(cb) + "/" + str.tostring(cs), text_color = color.white, bgcolor = color.new(color.gray, 80))
        table.cell(statsTbl, 2, 12 + i, f_rate(sb, cb), text_color = color.white, bgcolor = color.new(color.green, 85))
        table.cell(statsTbl, 3, 12 + i, f_rate(ss, cs), text_color = color.white, bgcolor = color.new(color.red, 85))

// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © your_username
//
// ============================================================================
//  Trend Reversal Probability (ON/OFF Backtest) v2
// ----------------------------------------------------------------------------
//  下降→上昇 / 上昇→下降 の「転換可能性」を条件ごとに判定し、
//  ★ ランクは付けず ★、ユーザーが ON にした条件の組み合わせで
//  「実際にどれくらいの確率で転換成功したか」を過去検証で測定します。
//
//  考え方：
//   - 自動でランク(D/C/B/A/S)や決め打ちの確率は出しません。
//   - ユーザーが使いたい条件を ON にする。
//   - その ON 条件の組み合わせでシグナルが出たとき、
//     実際の成功率（＝実測の確率）を集計して表示します。
//   - さらに各条件「発火あり/なし」で成功率がどう変わるかを表示します。
//     例：「FVG吸収あり 72% / なし 55%」
//
//  成否判定：
//   BUYシグナル後 lookaheadBars 本以内に priceMoveTarget 以上 上昇＝成功、
//   先に stopMove 以上 下落＝失敗（SELL は逆）。
//
//  注意：Pine Script の制約上、ルールベースの統計集計です。
// ============================================================================

//@version=5
indicator(
     title         = "Trend Reversal Probability (ON/OFF) v2",
     shorttitle    = "TR Prob v2",
     overlay       = true,
     max_labels_count = 500,
     max_bars_back = 1000
 )

// ============================================================================
// 0. 全般設定
// ============================================================================
grpGeneral = "■ 全般設定"
// 判定方向：BUYのみ / SELLのみ / 両方
dirMode = input.string("両方", title = "判定方向", options = ["両方", "BUYのみ", "SELLのみ"], group = grpGeneral)
allowBuy  = dirMode != "SELLのみ"
allowSell = dirMode != "BUYのみ"

// シグナル成立の組み合わせ方法（ランクではなく ON 条件の数で決める）
combineMode = input.string("ON条件のうちN個以上", title = "シグナル成立条件",
     options = ["ON条件すべて一致(AND)", "ON条件のいずれか(OR)", "ON条件のうちN個以上"], group = grpGeneral)
minConds = input.int(2, title = "N個以上（上のN）", minval = 1, group = grpGeneral)

showLabels = input.bool(true, title = "チャートにシグナルラベルを表示", group = grpGeneral)

grpTable = "■ テーブル表示"
showStatusTable = input.bool(true, title = "現在の状況テーブルを表示", group = grpTable)
showStatsTable  = input.bool(true, title = "実測統計テーブルを表示",   group = grpTable)

// ============================================================================
// 1. 各判定条件の ON/OFF（配点・ランクは無し）
// ============================================================================
// 【1】トレンド方向判定
grpC1 = "【1】トレンド方向判定 (EMA200)"
cond1On  = input.bool(true, title = "ON/OFF", group = grpC1)
ema200Len = input.int(200, title = "EMA200 期間", minval = 1, group = grpC1)

// 【2】勢い減速
grpC2 = "【2】勢い減速"
cond2On  = input.bool(true, title = "ON/OFF", group = grpC2)
momLen   = input.int(14, title = "実体平均の期間", minval = 1, group = grpC2)

// 【3】RSIダイバージェンス
grpC3 = "【3】RSIダイバージェンス"
cond3On  = input.bool(true, title = "ON/OFF", group = grpC3)
rsiLen   = input.int(14, title = "RSI 期間", minval = 1, group = grpC3)
divLook  = input.int(10, title = "ダイバージェンス比較本数", minval = 1, group = grpC3)

// 【4】流動性スイープ
grpC4 = "【4】流動性スイープ"
cond4On  = input.bool(true, title = "ON/OFF", group = grpC4)

// 【5】ヒゲ反発
grpC5 = "【5】ヒゲ反発"
cond5On  = input.bool(true, title = "ON/OFF", group = grpC5)
wickMult = input.float(1.5, title = "ヒゲ/実体 倍率 (wickMultiplier)", minval = 0.1, group = grpC5)

// 【6】FVG吸収
grpC6 = "【6】FVG吸収（簡易）"
cond6On  = input.bool(true, title = "ON/OFF", group = grpC6)

// 【7】CHOCH / BOS
grpC7 = "【7】CHOCH / BOS"
cond7On  = input.bool(true, title = "ON/OFF", group = grpC7)

// 【8】EMA突破
grpC8 = "【8】EMA突破"
cond8On  = input.bool(true, title = "ON/OFF", group = grpC8)
ema20Len = input.int(20, title = "EMA20 期間", minval = 1, group = grpC8)
ema50Len = input.int(50, title = "EMA50 期間", minval = 1, group = grpC8)
useE20   = input.bool(true, title = "EMA20 突破を使う", group = grpC8)
useE50   = input.bool(true, title = "EMA50 突破を使う", group = grpC8)
useE200  = input.bool(true, title = "EMA200 突破を使う", group = grpC8)

// 【9】押し目 / 戻り確認
grpC9 = "【9】押し目 / 戻り確認"
cond9On  = input.bool(true, title = "ON/OFF", group = grpC9)
pullbackBars = input.int(10, title = "CHOCH後の有効本数", minval = 1, group = grpC9)

// スイング検出（条件4・7・9 で使用）
grpSwing = "■ スイング検出"
swingLen = input.int(5, title = "スイング左右本数 (pivot)", minval = 1, group = grpSwing)

// ============================================================================
// 2. バックテスト（実測成功率）用 入力
// ============================================================================
grpBT = "■ 実測成功率の計測"
lookaheadBars   = input.int(50,  title = "成否を見る本数 (lookaheadBars)", minval = 1, group = grpBT)
priceMoveTarget = input.float(10.0, title = "成功とみなす値幅 (priceMoveTarget)", minval = 0.0, group = grpBT)
stopMove        = input.float(5.0,  title = "失敗とみなす逆行幅 (stopMove)",     minval = 0.0, group = grpBT)
cooldownBars    = input.int(10,  title = "クールダウン本数 (cooldownBars)", minval = 0, group = grpBT)

// ============================================================================
// 3. 共通テクニカル計算
// ============================================================================
ema20  = ta.ema(close, ema20Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)
rsi    = ta.rsi(close, rsiLen)

// ローソク要素
body   = math.abs(close - open)
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
mid    = (high + low) / 2.0

// 実体平均（勢い減速の判定に使用）
bodyAvg = ta.sma(body, momLen)

// 直近の確定スイング高値・安値を保持
var float lastSwingHigh = na
var float lastSwingLow  = na
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

// ============================================================================
// 4. 各条件の「発火」判定（BUY / SELL）
// ============================================================================

// --- 【1】トレンド方向判定 -------------------------------------------------
ema200Down = ema200 < ema200[1]
ema200Up   = ema200 > ema200[1]
buyTrend  = (close < ema200) or ema200Down
sellTrend = (close > ema200) or ema200Up

// --- 【2】勢い減速 ---------------------------------------------------------
bodyShrink = bodyAvg < bodyAvg[1]
drop1 = low[1] - low
drop2 = low[2] - low[1]
buyNarrow = drop1 > 0 and drop2 > 0 and drop1 < drop2
buyMom  = buyNarrow or bodyShrink
rise1 = high - high[1]
rise2 = high[1] - high[2]
sellNarrow = rise1 > 0 and rise2 > 0 and rise1 < rise2
sellMom = sellNarrow or bodyShrink

// --- 【3】RSIダイバージェンス ---------------------------------------------
buyDiv  = (low < low[divLook]) and (rsi > rsi[divLook])
sellDiv = (high > high[divLook]) and (rsi < rsi[divLook])

// --- 【4】流動性スイープ ---------------------------------------------------
buySweep  = not na(lastSwingLow)  and (low  < lastSwingLow)  and (close > lastSwingLow)
sellSweep = not na(lastSwingHigh) and (high > lastSwingHigh) and (close < lastSwingHigh)

// --- 【5】ヒゲ反発 ---------------------------------------------------------
buyWick  = (dnWick > body * wickMult) and (close > mid)
sellWick = (upWick > body * wickMult) and (close < mid)

// --- 【6】FVG吸収（簡易） --------------------------------------------------
var float bearFVGtop = na
var float bullFVGbot = na
if high < low[2]
    bearFVGtop := low[2]
if low > high[2]
    bullFVGbot := high[2]
buyFVG  = not na(bearFVGtop) and (close > bearFVGtop) and (close[1] <= bearFVGtop)
sellFVG = not na(bullFVGbot) and (close < bullFVGbot) and (close[1] >= bullFVGbot)

// --- 【7】CHOCH / BOS ------------------------------------------------------
buyChoch  = not na(lastSwingHigh) and (close > lastSwingHigh) and (close[1] <= lastSwingHigh)
sellChoch = not na(lastSwingLow)  and (close < lastSwingLow)  and (close[1] >= lastSwingLow)

// --- 【8】EMA突破 ----------------------------------------------------------
buyE20  = ta.crossover(close, ema20)
buyE50  = ta.crossover(close, ema50)
buyE200 = ta.crossover(close, ema200)
sellE20  = ta.crossunder(close, ema20)
sellE50  = ta.crossunder(close, ema50)
sellE200 = ta.crossunder(close, ema200)
emaBuyFired  = (useE20 and buyE20) or (useE50 and buyE50) or (useE200 and buyE200)
emaSellFired = (useE20 and sellE20) or (useE50 and sellE50) or (useE200 and sellE200)

// --- 【9】押し目 / 戻り確認 -----------------------------------------------
var int chochBuyBar  = na
var int chochSellBar = na
if buyChoch
    chochBuyBar := bar_index
if sellChoch
    chochSellBar := bar_index
buyPullActive  = not na(chochBuyBar)  and (bar_index - chochBuyBar)  <= pullbackBars
sellPullActive = not na(chochSellBar) and (bar_index - chochSellBar) <= pullbackBars
buyPull  = buyPullActive  and (low  <= math.max(ema20, ema50)) and (close > open) and (close >= close[1])
sellPull = sellPullActive and (high >= math.min(ema20, ema50)) and (close < open) and (close <= close[1])

// ============================================================================
// 5. 「ON かつ 発火」フラグと、発火条件数
// ============================================================================
// 各条件の ON かつ発火（OFF の条件は常に false）
fb1 = cond1On and buyTrend
fb2 = cond2On and buyMom
fb3 = cond3On and buyDiv
fb4 = cond4On and buySweep
fb5 = cond5On and buyWick
fb6 = cond6On and buyFVG
fb7 = cond7On and buyChoch
fb8 = cond8On and emaBuyFired
fb9 = cond9On and buyPull

fs1 = cond1On and sellTrend
fs2 = cond2On and sellMom
fs3 = cond3On and sellDiv
fs4 = cond4On and sellSweep
fs5 = cond5On and sellWick
fs6 = cond6On and sellFVG
fs7 = cond7On and sellChoch
fs8 = cond8On and emaSellFired
fs9 = cond9On and sellPull

// ON にした条件の数（＝AND/N個以上 の母数）
onCount = (cond1On ? 1 : 0) + (cond2On ? 1 : 0) + (cond3On ? 1 : 0) + (cond4On ? 1 : 0) + (cond5On ? 1 : 0) + (cond6On ? 1 : 0) + (cond7On ? 1 : 0) + (cond8On ? 1 : 0) + (cond9On ? 1 : 0)

// いま発火している ON 条件の数
firedCountBuy  = (fb1 ? 1 : 0) + (fb2 ? 1 : 0) + (fb3 ? 1 : 0) + (fb4 ? 1 : 0) + (fb5 ? 1 : 0) + (fb6 ? 1 : 0) + (fb7 ? 1 : 0) + (fb8 ? 1 : 0) + (fb9 ? 1 : 0)
firedCountSell = (fs1 ? 1 : 0) + (fs2 ? 1 : 0) + (fs3 ? 1 : 0) + (fs4 ? 1 : 0) + (fs5 ? 1 : 0) + (fs6 ? 1 : 0) + (fs7 ? 1 : 0) + (fs8 ? 1 : 0) + (fs9 ? 1 : 0)

// ============================================================================
// 6. シグナル成立（ランク無し。ON条件の組み合わせで決定）
// ============================================================================
f_met(firedCnt) =>
    onCount <= 0 ? false :
     combineMode == "ON条件すべて一致(AND)" ? (firedCnt >= onCount) :
     combineMode == "ON条件のいずれか(OR)" ? (firedCnt >= 1) :
     (firedCnt >= minConds)

buyMet  = f_met(firedCountBuy)
sellMet = f_met(firedCountSell)

// ビットマスク（条件別統計用）
maskBuy  = (fb1 ? 1 : 0) + (fb2 ? 2 : 0) + (fb3 ? 4 : 0) + (fb4 ? 8 : 0) + (fb5 ? 16 : 0) + (fb6 ? 32 : 0) + (fb7 ? 64 : 0) + (fb8 ? 128 : 0) + (fb9 ? 256 : 0)
maskSell = (fs1 ? 1 : 0) + (fs2 ? 2 : 0) + (fs3 ? 4 : 0) + (fs4 ? 8 : 0) + (fs5 ? 16 : 0) + (fs6 ? 32 : 0) + (fs7 ? 64 : 0) + (fs8 ? 128 : 0) + (fs9 ? 256 : 0)
onMask   = (cond1On ? 1 : 0) + (cond2On ? 2 : 0) + (cond3On ? 4 : 0) + (cond4On ? 8 : 0) + (cond5On ? 16 : 0) + (cond6On ? 32 : 0) + (cond7On ? 64 : 0) + (cond8On ? 128 : 0) + (cond9On ? 256 : 0)

// ============================================================================
// 7. 実測統計エンジン
// ============================================================================
// --- 全体カウンタ（現在の ON 構成での成功率＝実測の確率）-----------------
var int buyCntTotal  = 0
var int buySucTotal  = 0
var int sellCntTotal = 0
var int sellSucTotal = 0

// --- 条件別カウンタ（発火あり / なし、BUY+SELL 合算）---------------------
var int[] condFiredCnt = array.new_int(9, 0)   // その条件が発火した状態のシグナル数
var int[] condFiredSuc = array.new_int(9, 0)   // うち成功数
var int[] condNotCnt   = array.new_int(9, 0)   // ON だが発火しなかった状態のシグナル数
var int[] condNotSuc   = array.new_int(9, 0)   // うち成功数

// --- 保留中シグナル（成否判定待ち）---------------------------------------
var int[]   pendDir   = array.new_int()    // 1=BUY, -1=SELL
var float[] pendEntry = array.new_float()  // エントリー価格
var int[]   pendBar   = array.new_int()    // 発生 bar_index
var int[]   pendMask  = array.new_int()    // 発火条件のビットマスク

// クールダウン管理
var int lastBuyBar  = na
var int lastSellBar = na

// --- ヘルパー：発火あり/なしの母数 or 成功数を加算 -----------------------
// onMask で ON の条件について、msk のビットが立っていれば「あり」側、
// 立っていなければ「なし」側に加算する。
f_split(int[] arrFired, int[] arrNot, int msk) =>
    for i = 0 to 8
        onBit = (math.floor(onMask / math.pow(2, i)) % 2) >= 1
        if onBit
            firedBit = (math.floor(msk / math.pow(2, i)) % 2) >= 1
            if firedBit
                array.set(arrFired, i, array.get(arrFired, i) + 1)
            else
                array.set(arrNot, i, array.get(arrNot, i) + 1)

// --- シグナル発生条件（クールダウン込み）---------------------------------
buyCooldownOK  = na(lastBuyBar)  or (bar_index - lastBuyBar)  > cooldownBars
sellCooldownOK = na(lastSellBar) or (bar_index - lastSellBar) > cooldownBars
buySignal  = allowBuy  and buyMet  and buyCooldownOK
sellSignal = allowSell and sellMet and sellCooldownOK

// --- 計測本体（確定足のみ処理）------------------------------------------
if barstate.isconfirmed
    // (a) 保留中シグナルの成否判定
    if array.size(pendDir) > 0
        for i = array.size(pendDir) - 1 to 0
            dir   = array.get(pendDir, i)
            entry = array.get(pendEntry, i)
            bbar  = array.get(pendBar, i)
            msk   = array.get(pendMask, i)
            age   = bar_index - bbar
            bool resolved = false
            bool success  = false
            if age >= 1
                if dir == 1
                    if low <= entry - stopMove
                        resolved := true
                        success  := false
                    else if high >= entry + priceMoveTarget
                        resolved := true
                        success  := true
                else
                    if high >= entry + stopMove
                        resolved := true
                        success  := false
                    else if low <= entry - priceMoveTarget
                        resolved := true
                        success  := true
            if not resolved and age >= lookaheadBars
                resolved := true
                success  := false
            if resolved
                if success
                    if dir == 1
                        buySucTotal := buySucTotal + 1
                    else
                        sellSucTotal := sellSucTotal + 1
                    // 条件別「あり/なし」の成功数（BUY/SELL 合算）
                    f_split(condFiredSuc, condNotSuc, msk)
                array.remove(pendDir, i)
                array.remove(pendEntry, i)
                array.remove(pendBar, i)
                array.remove(pendMask, i)

    // (b) 新規シグナルの記録（発生数を即カウント）
    if buySignal
        array.push(pendDir, 1)
        array.push(pendEntry, close)
        array.push(pendBar, bar_index)
        array.push(pendMask, maskBuy)
        buyCntTotal := buyCntTotal + 1
        f_split(condFiredCnt, condNotCnt, maskBuy)
        lastBuyBar := bar_index
    if sellSignal
        array.push(pendDir, -1)
        array.push(pendEntry, close)
        array.push(pendBar, bar_index)
        array.push(pendMask, maskSell)
        sellCntTotal := sellCntTotal + 1
        f_split(condFiredCnt, condNotCnt, maskSell)
        lastSellBar := bar_index

// ============================================================================
// 8. チャートラベル表示（ランク無し。発火条件数のみ表示）
// ============================================================================
if showLabels and barstate.isconfirmed and buySignal
    label.new(bar_index, low, "BUY REV " + str.tostring(firedCountBuy) + "/" + str.tostring(onCount), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
if showLabels and barstate.isconfirmed and sellSignal
    label.new(bar_index, high, "SELL REV " + str.tostring(firedCountSell) + "/" + str.tostring(onCount), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

// 参考：EMA を表示
plot(ema20,  title = "EMA20",  color = color.new(color.yellow, 0))
plot(ema50,  title = "EMA50",  color = color.new(color.orange, 0))
plot(ema200, title = "EMA200", color = color.new(color.blue, 0))

// ============================================================================
// 9. アラート（ランク無し。転換シグナルそのもの）
// ============================================================================
alertcondition(buySignal,  title = "BUY転換シグナル",  message = "BUY転換シグナル 発生")
alertcondition(sellSignal, title = "SELL転換シグナル", message = "SELL転換シグナル 発生")

// ============================================================================
// 10. テーブル表示
// ============================================================================
// 成功率＋件数の文字列ヘルパー
f_rateN(int suc, int cnt) =>
    cnt > 0 ? str.tostring(suc * 100.0 / cnt, "#0.0") + "% (" + str.tostring(cnt) + ")" : "- (0)"

// 条件名
condNames = array.from("Trend", "勢い減速", "RSIダイバ", "スイープ", "ヒゲ反発", "FVG吸収", "CHOCH", "EMA突破", "押し目")

// ON条件 / 発火条件 の一覧文字列
onArr        = array.from(cond1On, cond2On, cond3On, cond4On, cond5On, cond6On, cond7On, cond8On, cond9On)
firedBuyArr  = array.from(fb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8, fb9)
firedSellArr = array.from(fs1, fs2, fs3, fs4, fs5, fs6, fs7, fs8, fs9)

var string onStr        = ""
var string firingBuyStr = ""
var string firingSellStr = ""
if barstate.islast
    onStr := ""
    firingBuyStr := ""
    firingSellStr := ""
    for i = 0 to 8
        if array.get(onArr, i)
            onStr := onStr + (onStr == "" ? "" : ", ") + array.get(condNames, i)
        if array.get(firedBuyArr, i)
            firingBuyStr := firingBuyStr + (firingBuyStr == "" ? "" : ", ") + array.get(condNames, i)
        if array.get(firedSellArr, i)
            firingSellStr := firingSellStr + (firingSellStr == "" ? "" : ", ") + array.get(condNames, i)
    onStr := onStr == "" ? "(なし)" : onStr
    firingBuyStr := firingBuyStr == "" ? "(なし)" : firingBuyStr
    firingSellStr := firingSellStr == "" ? "(なし)" : firingSellStr

// --- 【現在の状況テーブル】右上 ------------------------------------------
var table statusTbl = table.new(position.top_right, 2, 8, border_width = 1)
if showStatusTable and barstate.islast
    bgH = color.new(color.gray, 0)
    table.cell(statusTbl, 0, 0, "現在の状況",  text_color = color.white, bgcolor = bgH)
    table.cell(statusTbl, 1, 0, combineMode,   text_color = color.white, bgcolor = bgH)
    // BUY：いまの発火数 と この ON 構成の実測確率
    table.cell(statusTbl, 0, 1, "BUY 発火数", text_color = color.white, bgcolor = color.new(color.green, 70))
    table.cell(statusTbl, 1, 1, str.tostring(firedCountBuy) + "/" + str.tostring(onCount), text_color = color.white, bgcolor = color.new(color.green, 70))
    table.cell(statusTbl, 0, 2, "BUY 実測確率", text_color = color.white, bgcolor = color.new(color.green, 80))
    table.cell(statusTbl, 1, 2, f_rateN(buySucTotal, buyCntTotal), text_color = color.white, bgcolor = color.new(color.green, 80))
    // SELL
    table.cell(statusTbl, 0, 3, "SELL 発火数", text_color = color.white, bgcolor = color.new(color.red, 70))
    table.cell(statusTbl, 1, 3, str.tostring(firedCountSell) + "/" + str.tostring(onCount), text_color = color.white, bgcolor = color.new(color.red, 70))
    table.cell(statusTbl, 0, 4, "SELL 実測確率", text_color = color.white, bgcolor = color.new(color.red, 80))
    table.cell(statusTbl, 1, 4, f_rateN(sellSucTotal, sellCntTotal), text_color = color.white, bgcolor = color.new(color.red, 80))
    // 条件一覧
    table.cell(statusTbl, 0, 5, "ON条件", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(statusTbl, 1, 5, onStr, text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(statusTbl, 0, 6, "発火(BUY)", text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 1, 6, firingBuyStr, text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 0, 7, "発火(SELL)", text_color = color.white, bgcolor = color.new(color.gray, 70))
    table.cell(statusTbl, 1, 7, firingSellStr, text_color = color.white, bgcolor = color.new(color.gray, 70))

// --- 【実測統計テーブル】右下 --------------------------------------------
// 全体(BUY/SELL) ＋ 条件別「発火あり/なし」成功率
var table statsTbl = table.new(position.bottom_right, 3, 15, border_width = 1)
if showStatsTable and barstate.islast
    bgH = color.new(color.gray, 0)
    // 全体
    table.cell(statsTbl, 0, 0, "全体実測", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 1, 0, "成功率(件数)", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 2, 0, "", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 0, 1, "BUY",  text_color = color.white, bgcolor = color.new(color.green, 80))
    table.cell(statsTbl, 1, 1, f_rateN(buySucTotal, buyCntTotal), text_color = color.white, bgcolor = color.new(color.green, 85))
    table.cell(statsTbl, 2, 1, "", text_color = color.white, bgcolor = color.new(color.green, 85))
    table.cell(statsTbl, 0, 2, "SELL", text_color = color.white, bgcolor = color.new(color.red, 80))
    table.cell(statsTbl, 1, 2, f_rateN(sellSucTotal, sellCntTotal), text_color = color.white, bgcolor = color.new(color.red, 85))
    table.cell(statsTbl, 2, 2, "", text_color = color.white, bgcolor = color.new(color.red, 85))
    // 条件別ヘッダ
    table.cell(statsTbl, 0, 3, "条件別(BUY+SELL)", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 1, 3, "発火あり", text_color = color.white, bgcolor = bgH)
    table.cell(statsTbl, 2, 3, "発火なし", text_color = color.white, bgcolor = bgH)
    // 各条件：あり/なしの成功率(件数)
    for i = 0 to 8
        table.cell(statsTbl, 0, 4 + i, array.get(condNames, i), text_color = color.white, bgcolor = color.new(color.gray, 70))
        table.cell(statsTbl, 1, 4 + i, f_rateN(array.get(condFiredSuc, i), array.get(condFiredCnt, i)), text_color = color.white, bgcolor = color.new(color.green, 85))
        table.cell(statsTbl, 2, 4 + i, f_rateN(array.get(condNotSuc, i), array.get(condNotCnt, i)), text_color = color.white, bgcolor = color.new(color.gray, 80))

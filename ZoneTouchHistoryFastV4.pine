//@version=6
//@description Zone Touch History FAST V4. Counts how many times each CURRENT BaseStrong Zone was touched over the last N days of 5m bars, and classifies it STRONG or WEAK from that count alone. A historical bar writes four array slots and does nothing else - no Candidate, no Root, no Zone, no clustering, no topology of any kind.
library("ZoneTouchHistoryFastV4", overlay = true)

// ============================================================================
// ZoneTouchHistoryFastV4
//
// WHAT IT ANSWERS
//   "In the last N days, how many separate times did price come to this Zone?"
//   Nothing more. The verdict is pastTouchCount against one threshold.
//
// WHAT IT NEVER DOES
//   It does not reconstruct what a Zone was in the past. No Root build, no
//   Candidate build, no clustering, no Merge / Split, no Generation, no Flip,
//   no Reclaim, no FVG topology, no WeakDepth, no Break handling. A Break in
//   the replayed bars is simply price leaving; once price returns by
//   ResetDistance the Zone arms again and the next visit is a new Touch.
//
// THE APPROXIMATION, STATED PLAINLY
//   The Zone's CURRENT EffectiveRange is fixed and applied backwards over the
//   lookback window. Where the Zone actually sat at each past bar is not known
//   and is not reconstructed.
//
// PERFORMANCE CONTRACT (by construction, not by comment)
//   Historical 5m bar:
//       Candidate ops = 0   (no Candidate code path exists here at all)
//       Root build    = 0
//       Zone loop     = 0
//       Topology      = does not exist
//       work          = 4 x array.set into a pre-allocated ring
//   Confirmed bar:
//       at most MAX_NEW_SCANS_PER_BAR (2) first-time scans, plus ONE
//       incremental bar per Zone already scanned.
//
// AUTHORITY
//   Zone position, EffectiveRange, C, H, Density, BaseStrong and Root
//   composition stay owned by ZoneCoreV2_Common / ZoneCurrentEngineV2. This
//   file never produces a Zone.
// ============================================================================
const string FAST_BUILD_ID = "ZONEFAST-V4-20260920"
export fastBuildId() => FAST_BUILD_ID

import sekine3310/ZoneCoreV2_Common/1 as zc
import sekine3310/ZoneCurrentEngineV2/1 as ze

// Fixed. Not tunable.
const int   HISTORY_BARS          = 12000    // section 2
const float SCAN_DISTANCE         = 150.0    // section 5
const int   MAX_NEW_SCANS_PER_BAR = 2        // section 6
const int   MS_PER_DAY            = 86400000

// Cache capacity. Not a Zone-logic parameter: it only bounds how many distinct
// Zone identities keep a stored count at once.
const int MAX_HISTORY_ENTRIES = 128

// Section 7: three states only. There is no Broken, no FlipWait, no Dormant.
const int PH_WAITING      = 1
const int PH_ARMED        = 2
const int PH_ACTIVE_TOUCH = 3

// Section 4 / 15.
const int ST_UNSCANNED    = 0   // SCANNING
const int ST_INSUFFICIENT = 1   // INSUFFICIENT
const int ST_COMPLETE     = 2   // COMPLETE

export statusUnscanned() => ST_UNSCANNED
export statusInsufficient() => ST_INSUFFICIENT
export statusComplete() => ST_COMPLETE

// ============================================================================
// Types
// ============================================================================
export type ZoneHistory
    bool alive
    int side
    array<string> originKeys
    // Section 8: the Current EffectiveRange, fixed and applied backwards.
    float snapBottom
    float snapTop
    bool baseStrong

    // Section 3 / 4 / 9.
    bool scanned
    bool complete
    int pastTouchCount
    int scanStartTime

    // Section 7: replay state. Armed / Touch / Reset, nothing else.
    int phase
    int armedFromSeq
    int stepSeq

    int lastProcessedTime
    int lastSeenBuildTime
    int scannedBars

export type FastEngine
    // ---- Section 2: fixed-length circular OHLC ring ----
    array<float> histHigh
    array<float> histLow
    array<float> histClose
    array<int>   histTime
    int writeIndex
    int filledCount
    int newestTime

    // ---- Section 17: per-identity cache ----
    array<ZoneHistory> entries

    // ---- Section 19: debug counters ----
    int ringWrites
    int scansDone
    int scansThisBar
    int maxScansOneBar
    int barsScannedTotal
    int inRangeCount
    int strongTargetCount
    int queuedCount
    int liveSteps
    int evictedEntries

export newFastEngine() => FastEngine.new(
     histHigh = array.new<float>(HISTORY_BARS, na),
     histLow = array.new<float>(HISTORY_BARS, na),
     histClose = array.new<float>(HISTORY_BARS, na),
     histTime = array.new<int>(HISTORY_BARS, na),
     writeIndex = 0, filledCount = 0, newestTime = na,
     entries = array.new<ZoneHistory>(),
     ringWrites = 0, scansDone = 0, scansThisBar = 0, maxScansOneBar = 0,
     barsScannedTotal = 0, inRangeCount = 0, strongTargetCount = 0, queuedCount = 0,
     liveSteps = 0, evictedEntries = 0)

// ============================================================================
// Section 2 / 6 / 18: the ONLY thing a historical bar is allowed to do.
// Four array.set calls into a pre-allocated ring. No push, no shift, no
// allocation, no scan, no loop over Zones.
// ============================================================================
export pushBar(FastEngine e, float barHigh, float barLow, float barClose, int barTime) =>
    array.set(e.histHigh, e.writeIndex, barHigh)
    array.set(e.histLow, e.writeIndex, barLow)
    array.set(e.histClose, e.writeIndex, barClose)
    array.set(e.histTime, e.writeIndex, barTime)
    e.writeIndex := e.writeIndex + 1 >= HISTORY_BARS ? 0 : e.writeIndex + 1
    e.filledCount := math.min(e.filledCount + 1, HISTORY_BARS)
    e.newestTime := barTime
    e.ringWrites += 1
    true

// ============================================================================
// Ring addressing. Logical index k runs 0 .. filledCount - 1, oldest first.
// ============================================================================
f_ringStart(FastEngine e) => e.filledCount < HISTORY_BARS ? 0 : e.writeIndex
f_ringAt(FastEngine e, int k) => (f_ringStart(e) + k) % HISTORY_BARS

export ringBars(FastEngine e) => e.filledCount
export ringCapacity() => HISTORY_BARS

export ringOldestTime(FastEngine e) =>
    int t = na
    if e.filledCount > 0
        t := array.get(e.histTime, f_ringAt(e, 0))
    t

export ringNewestTime(FastEngine e) => e.newestTime

// Section 3: the first stored bar at or after `t`, by binary search. A scan
// never walks the ring looking for its own start.
f_lowerBound(FastEngine e, int t) =>
    int lo = 0
    int hi = e.filledCount - 1
    int ans = e.filledCount
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int tv = array.get(e.histTime, f_ringAt(e, mid))
        if na(tv) or tv >= t
            ans := mid
            hi := mid - 1
        else
            lo := mid + 1
    ans

// ============================================================================
// Section 17: identity.
//
// The same rule the Current engine uses for Zone continuity, so a count can
// only follow a Zone that is provably the same Zone: same Side, gap within M,
// and at least one shared stable origin. MA, Psych and Broad FVG contribute no
// key, so a scan result can never be inherited by a different Zone.
// ============================================================================
f_dist(float px, float a, float b) =>
    float lo = math.min(a, b)
    float hi = math.max(a, b)
    px < lo ? lo - px : px > hi ? px - hi : 0.0

f_gapBetween(float a0, float a1, float b0, float b1) =>
    a1 < b0 ? b0 - a1 : b1 < a0 ? a0 - b1 : 0.0

f_shareStableOrigin(array<string> a, array<string> b) =>
    bool yes = false
    int an = array.size(a)
    int bn = array.size(b)
    if an > 0 and bn > 0
        for i = 0 to an - 1
            string ka = array.get(a, i)
            for j = 0 to bn - 1
                if ka == array.get(b, j)
                    yes := true
                    break
            if yes
                break
    yes

f_copyKeys(array<string> dst, array<string> src) =>
    array.clear(dst)
    int n = array.size(src)
    if n > 0
        for i = 0 to n - 1
            array.push(dst, array.get(src, i))
    true

f_newEntry(FastEngine e, int side, int nowTime) =>
    ZoneHistory z = ZoneHistory.new(alive = true, side = side, originKeys = array.new<string>(),
         snapBottom = na, snapTop = na, baseStrong = false,
         scanned = false, complete = false, pastTouchCount = 0, scanStartTime = na,
         phase = PH_WAITING, armedFromSeq = na, stepSeq = 0,
         lastProcessedTime = na, lastSeenBuildTime = nowTime, scannedBars = 0)
    array.push(e.entries, z)
    z

f_findEntry(FastEngine e, int side, float bottom, float top, array<string> keys,
            zc.ZoneCfg c, int nowTime) =>
    ZoneHistory best = na
    float bestGap = 1e12
    int n = array.size(e.entries)
    if n > 0
        for i = 0 to n - 1
            ZoneHistory z = array.get(e.entries, i)
            if z.alive and z.side == side and z.lastSeenBuildTime != nowTime and not na(z.snapBottom)
                float g = f_gapBetween(z.snapBottom, z.snapTop, bottom, top)
                if g <= c.clusterMaxWidth and g < bestGap
                    if f_shareStableOrigin(z.originKeys, keys)
                        bestGap := g
                        best := z
    best

// Cache capacity. Evict the entry that has gone unseen the longest. An entry
// refreshed on this bar is only ever evicted if every entry was.
f_enforceEntryCap(FastEngine e, int nowTime) =>
    while array.size(e.entries) > MAX_HISTORY_ENTRIES
        int worst = 0
        int worstRank = -1
        int worstTime = na
        int n = array.size(e.entries)
        for i = 0 to n - 1
            ZoneHistory z = array.get(e.entries, i)
            int rank = z.lastSeenBuildTime == nowTime ? 0 : 1
            bool worse = rank > worstRank
            if not worse and rank == worstRank
                worse := na(worstTime) or z.lastSeenBuildTime < worstTime
            if worse
                worstRank := rank
                worstTime := z.lastSeenBuildTime
                worst := i
        array.remove(e.entries, worst)
        e.evictedEntries += 1
    true

// ============================================================================
// Sections 8, 9, 10, 11, 14: the whole state machine.
//
// WAITING -> (close leaves by ResetDistance) -> ARMED
// ARMED   -> (bar overlaps the Zone, never on the arming bar) -> ACTIVE_TOUCH
// ACTIVE  -> (close leaves by ResetDistance) -> ARMED, from the NEXT bar
//
// Five bars spent inside the Zone are one Touch. Leaving by ResetDistance and
// coming back is the second Touch. Price blowing straight through the Zone is
// not treated as a Break: it is simply price leaving, and the next return
// after a Reset is the next Touch (section 14).
// ============================================================================
f_stepBar(ZoneHistory z, zc.ZoneCfg c, float barHigh, float barLow, float barClose) =>
    bool support = z.side == zc.sideConstSupport()
    int k = z.stepSeq
    // Section 8 / 10: one and the same distance test arms a WAITING Zone and
    // resets an open Touch.
    bool away = support ? barClose >= z.snapTop + c.touchResetDistance : barClose <= z.snapBottom - c.touchResetDistance
    bool handled = false

    if z.phase == PH_ACTIVE_TOUCH
        if away
            z.phase := PH_ARMED
            // Section 10: the Reset bar itself cannot start the next Touch.
            z.armedFromSeq := k + 1
        handled := true

    // Section 9: a Touch is only counted out of ARMED, and never on the bar
    // that armed it.
    if not handled and z.phase == PH_ARMED and not na(z.armedFromSeq) and k >= z.armedFromSeq
        if barHigh >= z.snapBottom and barLow <= z.snapTop
            z.pastTouchCount += 1
            z.phase := PH_ACTIVE_TOUCH
            z.armedFromSeq := na
            handled := true

    // Section 11: the scan starts in WAITING. A Zone price is already sitting
    // in at the start of the window is NOT counted as Touch 1; it has to leave
    // by ResetDistance first.
    if not handled and z.phase == PH_WAITING and away
        z.phase := PH_ARMED
        z.armedFromSeq := k + 1

    z.stepSeq := k + 1
    true

// ============================================================================
// Sections 3, 4, 6: one full scan for one Zone.
//
// Bounded by the lookback window, and by HISTORY_BARS in the worst case. At
// most MAX_NEW_SCANS_PER_BAR of these run on any one bar.
// ============================================================================
f_scanEntry(FastEngine e, ZoneHistory z, zc.ZoneCfg c, int nowTime, int lookbackDays) =>
    // Section 3: the window is the last lookbackDays, full stop. When the Zone
    // was formed plays no part in it - the question is how often price came to
    // THIS range over that period, not how much of the Zone's own life it
    // covers.
    int scanStart = nowTime - lookbackDays * MS_PER_DAY

    // Section 4: the window is complete when the ring reaches back to
    // scanStart. A Zone being older than the lookback is NOT a reason to call
    // the history incomplete - only a ring that cannot cover the window is.
    int oldest = e.filledCount > 0 ? array.get(e.histTime, f_ringAt(e, 0)) : na
    bool complete = not na(oldest) and oldest <= scanStart

    z.pastTouchCount := 0
    z.phase := PH_WAITING
    z.armedFromSeq := na
    z.stepSeq := 0
    z.scanStartTime := scanStart
    z.complete := complete

    int startK = f_lowerBound(e, scanStart)
    int n = e.filledCount
    int walked = 0
    if n > startK
        for k = startK to n - 1
            int idx = f_ringAt(e, k)
            float bh = array.get(e.histHigh, idx)
            if not na(bh)
                f_stepBar(z, c, bh, array.get(e.histLow, idx), array.get(e.histClose, idx))
                walked += 1

    z.scanned := true
    z.scannedBars := walked
    z.lastProcessedTime := e.newestTime
    e.scansDone += 1
    e.barsScannedTotal += walked
    true

// ============================================================================
// Sections 5, 6, 17: the per-bar entry point.
//
// Call ONLY on the bootstrap bar and on confirmed bars, AFTER ze.buildCurrent.
// A historical bar must never reach it.
// ============================================================================
export syncCurrent(FastEngine e, ze.CurrentEngine ce, zc.ZoneCfg c, float refClose,
                   float barHigh, float barLow, float barClose, int nowTime, int lookbackDays) =>
    e.scansThisBar := 0
    e.inRangeCount := 0
    e.strongTargetCount := 0
    e.queuedCount := 0
    int n = array.size(ce.zones)
    if n > 0
        for i = 0 to n - 1
            ze.CurrentZone cz = array.get(ce.zones, i)
            if cz.alive and not na(cz.bottom)
                ZoneHistory z = f_findEntry(e, cz.side, cz.bottom, cz.top, cz.originKeys, c, nowTime)
                if na(z)
                    z := f_newEntry(e, cz.side, nowTime)
                z.lastSeenBuildTime := nowTime
                z.baseStrong := cz.baseStrong
                f_copyKeys(z.originKeys, cz.originKeys)
                // Section 8: the fixed range follows the Current Zone while no
                // Touch is open, and is held for the length of an open Touch so
                // one approach is judged against one range.
                if z.phase != PH_ACTIVE_TOUCH
                    z.snapBottom := cz.bottom
                    z.snapTop := cz.top

                // Section 5: only Zones within +/- SCAN_DISTANCE of price, and
                // only BaseStrong ones, are scanned. A far Zone is left alone -
                // not scanned, not stepped, and NOT deleted. It is scanned the
                // first time it comes inside.
                float d = f_dist(refClose, cz.bottom, cz.top)
                if d <= SCAN_DISTANCE
                    e.inRangeCount += 1
                    if cz.baseStrong
                        e.strongTargetCount += 1
                        if not z.scanned
                            // Section 6: at most two first-time scans per bar.
                            // Everything else waits for the next confirmed bar.
                            if e.scansThisBar < MAX_NEW_SCANS_PER_BAR
                                f_scanEntry(e, z, c, nowTime, lookbackDays)
                                e.scansThisBar += 1
                            else
                                e.queuedCount += 1
                        else if not na(z.lastProcessedTime) and nowTime > z.lastProcessedTime
                            // One incremental bar. The past is never re-walked
                            // for a Zone that already has a count.
                            f_stepBar(z, c, barHigh, barLow, barClose)
                            z.lastProcessedTime := nowTime
                            e.liveSteps += 1
    f_enforceEntryCap(e, nowTime)
    e.maxScansOneBar := math.max(e.maxScansOneBar, e.scansThisBar)
    true

// ============================================================================
// Sections 12, 15, 16: reading the verdict back out.
// ============================================================================
f_entryAt(FastEngine e, int index) =>
    ZoneHistory z = na
    if index >= 0 and index < array.size(e.entries)
        z := array.get(e.entries, index)
    z

// The entry belonging to Current Zone `currentIndex`, or -1. Same identity rule
// as everywhere else: same Side, gap within M, shared stable origin.
export entryIndex(FastEngine e, ze.CurrentEngine ce, zc.ZoneCfg c, int currentIndex) =>
    int found = -1
    if currentIndex >= 0 and currentIndex < array.size(ce.zones)
        ze.CurrentZone cz = array.get(ce.zones, currentIndex)
        if cz.alive and not na(cz.bottom)
            float bestGap = 1e12
            int n = array.size(e.entries)
            if n > 0
                for i = 0 to n - 1
                    ZoneHistory z = array.get(e.entries, i)
                    if z.alive and z.side == cz.side and not na(z.snapBottom)
                        float g = f_gapBetween(z.snapBottom, z.snapTop, cz.bottom, cz.top)
                        if g <= c.clusterMaxWidth and g < bestGap
                            if f_shareStableOrigin(z.originKeys, cz.originKeys)
                                bestGap := g
                                found := i
    found

export entryCount(FastEngine e) => array.size(e.entries)

export entryStatus(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? ST_UNSCANNED : not z.scanned ? ST_UNSCANNED : z.complete ? ST_COMPLETE : ST_INSUFFICIENT

export entryComplete(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? false : (z.scanned and z.complete)

// Section 13: the raw count of past Touches, NOT a Touch number.
export entryPastTouches(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? na : z.pastTouchCount

export entryScanStartTime(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? na : z.scanStartTime

export entryScannedBars(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? na : z.scannedBars

export entryPhase(FastEngine e, int index) =>
    ZoneHistory z = f_entryAt(e, index)
    na(z) ? na : z.phase

// Section 16: the ONLY Strong a strategy may act on. SCANNING and INSUFFICIENT
// are never Strong. This means the LOOKBACK WINDOW is complete, not that the
// Zone's whole life since birth is known.
export isStrong(FastEngine e, int index, bool currentBaseStrong, int weakFromPastTouches) =>
    bool yes = false
    if currentBaseStrong
        ZoneHistory z = f_entryAt(e, index)
        if not na(z) and z.scanned and z.complete
            yes := z.pastTouchCount < weakFromPastTouches
    yes

// Section 15: the display verdict. There is no "STRUCT STRONG / HIST ?".
//   not BaseStrong          -> NEUTRAL
//   BaseStrong, not scanned -> SCANNING
//   BaseStrong, incomplete  -> INSUFFICIENT
//   complete, count <  thr  -> STRONG
//   complete, count >= thr  -> WEAK
export gradeText(FastEngine e, int index, bool currentBaseStrong, int weakFromPastTouches) =>
    string s = "NEUTRAL"
    if currentBaseStrong
        ZoneHistory z = f_entryAt(e, index)
        if na(z) or not z.scanned
            s := "SCANNING"
        else if not z.complete
            s := "INSUFFICIENT"
        else
            s := z.pastTouchCount < weakFromPastTouches ? "STRONG" : "WEAK"
    s

// ============================================================================
// Section 19: debug counters.
// ============================================================================
export ringWrites(FastEngine e) => e.ringWrites
export scansDone(FastEngine e) => e.scansDone
export scansThisBar(FastEngine e) => e.scansThisBar
export maxScansOneBar(FastEngine e) => e.maxScansOneBar
export maxScansPerBarLimit() => MAX_NEW_SCANS_PER_BAR
export barsScannedTotal(FastEngine e) => e.barsScannedTotal
export inRangeCount(FastEngine e) => e.inRangeCount
export strongTargetCount(FastEngine e) => e.strongTargetCount
export queuedCount(FastEngine e) => e.queuedCount
export liveSteps(FastEngine e) => e.liveSteps
export evictedEntries(FastEngine e) => e.evictedEntries
export scanDistance() => SCAN_DISTANCE

// Historical Candidate operations performed by this library. A literal zero,
// because no code path here builds, scores or clusters a Candidate.
export historicalCandidateOps() => 0

export scannedCount(FastEngine e) =>
    int n = 0
    int m = array.size(e.entries)
    if m > 0
        for i = 0 to m - 1
            if array.get(e.entries, i).scanned
                n += 1
    n

export completeCount(FastEngine e) =>
    int n = 0
    int m = array.size(e.entries)
    if m > 0
        for i = 0 to m - 1
            ZoneHistory z = array.get(e.entries, i)
            if z.scanned and z.complete
                n += 1
    n

export insufficientCount(FastEngine e) =>
    int n = 0
    int m = array.size(e.entries)
    if m > 0
        for i = 0 to m - 1
            ZoneHistory z = array.get(e.entries, i)
            if z.scanned and not z.complete
                n += 1
    n

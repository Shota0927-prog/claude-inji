// ============================================================================
// SAT BAND Reconstruction Test
//   非公開インジケーター「SAT's PANEL」の
//     ・SAT's BAND LINE1
//     ・SAT's BAND LINE2
//   の再現テスト版。
//
//   Python によるブラックボックス解析で特定した構造を、そのまま Pine へ置き換えた
//   だけのファイル。見た目を合わせるための補正・追加平滑化・Confirm・ATR43 などは
//   一切入れていない。
//
//   ※ 既存の SAT 再現ファイル（SAT_PANEL_Approximation.pine）とは完全に独立しており、
//     そちらのロジックは一切流用していない。
//   ※ STB は Donchian 構造（表示 10 本 / 転換 20 本）として実装済み。LINE1 / LINE2 とは
//     完全に独立した State を持ち、互いを参照しない。
//   ※ 解析結果に基づく再現テストであって、元 SAT's PANEL の計算式を特定したと
//     断定するものではない。
//
//   構造：
//     basis  = ta.vwma(hlc3, 5)
//     common = basis * 0.5
//     atr50  = ta.atr(50)[1]
//     src      = close[1] * 0.5
//     trigLow  = low[1]   * 0.5
//     trigHigh = high[1]  * 0.5
//
//     LINE1（k = 5.0）／ LINE2（k = 2.5）とも同じ State 機械：
//       Bull(+1) 中： trigLow  < prevAnchor  → Bear へ反転し anchor = src + k * atr50
//                     それ以外               → anchor = math.max(prevAnchor, src - k * atr50)
//       Bear(-1) 中： trigHigh > prevAnchor  → Bull へ反転し anchor = src - k * atr50
//                     それ以外               → anchor = math.min(prevAnchor, src + k * atr50)
//
//     line = common + anchor
//
//   ■ MTF バンドアラートについて
//     LINE1 / LINE2 / STB / バンド判定の一式を f_satBand() にまとめ、
//     チャート表示と MTF アラートの両方がまったく同じ関数を通るようにしてある
//     （計算式を二重に書いて食い違うのを避けるため。式そのものは従来と同一）。
//     30秒 / 1分 / 5分 / 15分 / 30分 / 1時間 / 4時間 / 日 / 週 の 9 本について
//     バンド状態（🟦 / フラット / 🟥）が切り替わったら alert() を出す。
//     ※ 30秒足チャートに貼って使う前提。チャート足より下位の時間足を
//       request.security() で取ると値が不安定になるため。
// ============================================================================
//@version=6
indicator("SAT BAND Reconstruction Test", shorttitle = "SAT Rebuild", overlay = true)

// ----------------------------------------------------------------------------
// 入力
// ----------------------------------------------------------------------------
debugMode = input.bool(false, "Debug",
     tooltip = "ON にすると basis / common / atr50 / anchor1 / anchor2 / dir1 / dir2 / STB / Band State を\nデータウィンドウへ出力する。チャート上には線を追加しない。")

showSTB  = input.bool(true, "Show STB")
showBand = input.bool(true, "Show Blue / Red Band")

// LINE1 / LINE2 / STB / 背景バンドで共通に使う方向色
bullCol = input.color(#068C8C, "Bull 色（LINE1 / LINE2 / STB / 青バンド共通）")
bearCol = input.color(#F54230, "Bear 色（LINE1 / LINE2 / STB / 赤バンド共通）")
bandTransp = input.int(66, "背景バンドの透明度", minval = 0, maxval = 100,
     tooltip = "0 で不透明、100 で完全に透明。")

// --- アラート設定 ---
string G_ALERT = "アラート"

enableAlerts = input.bool(true, "アラートを有効にする", group = G_ALERT)
goldOnly     = input.bool(true, "ゴールド銘柄のみ鳴らす", group = G_ALERT,
     tooltip = "銘柄名に XAU / GOLD / GC が含まれるときだけアラートを出す。\n判定に失敗する銘柄で使いたい場合は OFF にする。")

alertTf30S = input.bool(true, "30秒足",  group = G_ALERT, inline = "a1")
alertTf1   = input.bool(true, "1分足",   group = G_ALERT, inline = "a1")
alertTf5   = input.bool(true, "5分足",   group = G_ALERT, inline = "a1")
alertTf15  = input.bool(true, "15分足",  group = G_ALERT, inline = "a2")
alertTf30  = input.bool(true, "30分足",  group = G_ALERT, inline = "a2")
alertTf60  = input.bool(true, "1時間足", group = G_ALERT, inline = "a2")
alertTf240 = input.bool(true, "4時間足", group = G_ALERT, inline = "a3")
alertTfD   = input.bool(true, "日足",     group = G_ALERT, inline = "a3")
alertTfW   = input.bool(true, "週足",     group = G_ALERT, inline = "a3")

// ----------------------------------------------------------------------------
// SAT BAND 本体（チャート表示と MTF アラートで共通に使う）
//   戻り値: [line1, line2, stb, dir1, dir2, stbDir, bandState,
//           basis, common, atr50, anchor1, anchor2]
//   bandState は +1 = 🟦 / -1 = 🟥 / 0 = フラット
//
//   ※ 計算式は従来とまったく同じ。関数へ移しただけで、値は変わらない。
//   ※ 関数内の var は呼び出し箇所ごとに独立するため、チャート足用と
//     各 MTF 用の State が互いに混ざることはない。
// ----------------------------------------------------------------------------
f_satBand() =>
    // --- 共通 Basis（SMA でも EMA でもなく VWMA。source は hlc3、length は 5） ---
    float basisV  = ta.vwma(hlc3, 5)
    float commonV = basisV * 0.5

    // --- ATR（ta.atr() なので内部は RMA。現在足ではなく 1 本前の値） ---
    float atr50V = ta.atr(50)[1]

    // --- Anchor 共通 source と State 反転判定用の値（いずれも 1 本前の足から） ---
    float srcV      = close[1] * 0.5
    float trigLowV  = low[1]   * 0.5
    float trigHighV = high[1]  * 0.5

    bool readyV = not na(atr50V) and not na(srcV) and not na(trigLowV) and not na(trigHighV)

    // --- LINE1（k = 5.0） ---
    //   同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
    //   判定前に prevAnchor / prevDir へ退避してから State を更新する。
    float k1V = 5.0
    var float anchor1V = na
    var int   dir1V    = 1
    float prevAnchor1V = anchor1V
    int   prevDir1V    = dir1V
    if readyV
        if na(prevAnchor1V)
            // 初期化：Bull から開始する
            anchor1V := srcV - k1V * atr50V
            dir1V    := 1
        else if prevDir1V == 1
            if trigLowV < prevAnchor1V
                // Bull → Bear
                dir1V    := -1
                anchor1V := srcV + k1V * atr50V
            else
                dir1V    := 1
                anchor1V := math.max(prevAnchor1V, srcV - k1V * atr50V)
        else
            if trigHighV > prevAnchor1V
                // Bear → Bull
                dir1V    := 1
                anchor1V := srcV - k1V * atr50V
            else
                dir1V    := -1
                anchor1V := math.min(prevAnchor1V, srcV + k1V * atr50V)
    float line1V = commonV + anchor1V

    // --- LINE2（k = 2.5。構造は LINE1 と完全に同じで、違うのは倍率だけ） ---
    float k2V = 2.5
    var float anchor2V = na
    var int   dir2V    = 1
    float prevAnchor2V = anchor2V
    int   prevDir2V    = dir2V
    if readyV
        if na(prevAnchor2V)
            // 初期化：Bull から開始する
            anchor2V := srcV - k2V * atr50V
            dir2V    := 1
        else if prevDir2V == 1
            if trigLowV < prevAnchor2V
                // Bull → Bear
                dir2V    := -1
                anchor2V := srcV + k2V * atr50V
            else
                dir2V    := 1
                anchor2V := math.max(prevAnchor2V, srcV - k2V * atr50V)
        else
            if trigHighV > prevAnchor2V
                // Bear → Bull
                dir2V    := 1
                anchor2V := srcV - k2V * atr50V
            else
                dir2V    := -1
                anchor2V := math.min(prevAnchor2V, srcV + k2V * atr50V)
    float line2V = commonV + anchor2V

    // --- STB（Donchian 構造。LINE1 / LINE2 の State とは完全に独立） ---
    //   表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
    //   方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
    //   毎バー high breakout を先に判定し、同じ足で上下両方を突破した場合も
    //   Bull 側（+1）が優先される。どちらも突破していなければ直前の State を維持。
    float stbUpperV = ta.highest(high, 10)
    float stbLowerV = ta.lowest(low, 10)
    float prev20HighV = ta.highest(high, 20)[1]
    float prev20LowV  = ta.lowest(low, 20)[1]
    var int stbDirV = 1
    if not na(prev20HighV) and not na(prev20LowV)
        if high > prev20HighV
            stbDirV := 1
        else if low < prev20LowV
            stbDirV := -1
    // UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
    float stbV = stbDirV == 1 ? stbLowerV : stbUpperV

    // --- 青バンド / 赤バンド ---
    //   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
    //   各ラインの dir は判定に使わない。
    int stateV = 0
    if close > line1V and close > line2V and close > stbV
        stateV := 1
    else if close < line1V and close < line2V and close < stbV
        stateV := -1

    [line1V, line2V, stbV, dir1V, dir2V, stbDirV, stateV, basisV, commonV, atr50V, anchor1V, anchor2V]

// バンド状態だけを返すラッパー（request.security() から呼ぶ用）
f_satBandStateOnly() =>
    [_l1, _l2, _stb, _d1, _d2, _sd, st, _b, _c, _a, _a1, _a2] = f_satBand()
    st

// バンド状態 → アラート文言
f_stateLabel(int st) =>
    string r = "フラット"
    if st == 1
        r := "🟦バンド"
    else if st == -1
        r := "🟥バンド"
    r

// ----------------------------------------------------------------------------
// チャート足の計算
// ----------------------------------------------------------------------------
[line1, line2, stb, dir1, dir2, stbDir, bandStateI, basis, common, atr50, anchor1, anchor2] = f_satBand()

color bandColor = na
if bandStateI == 1
    bandColor := color.new(bullCol, bandTransp)
else if bandStateI == -1
    bandColor := color.new(bearCol, bandTransp)

// 診断用の数値表現（+1 = Blue / -1 = Red / 0 = 背景なし）
float bandState = bandStateI * 1.0

// ----------------------------------------------------------------------------
// 描画
//   plot() はグローバルスコープでのみ呼ぶ。
// ----------------------------------------------------------------------------
// LINE1 / LINE2 / STB とも Bull(+1) は bullCol、Bear(-1) は bearCol。
// 色は dir を参照するだけで、ライン価格の計算には一切関与しない。
color line1Color = dir1 == 1 ? bullCol : bearCol
color line2Color = dir2 == 1 ? bullCol : bearCol
color stbColor   = stbDir == 1 ? bullCol : bearCol

plot(line1, "SAT Rebuild LINE1", color = line1Color, linewidth = 2)
plot(line2, "SAT Rebuild LINE2", color = line2Color, linewidth = 2)
plot(showSTB ? stb : na, "SAT Rebuild STB", color = stbColor, linewidth = 2)

bgcolor(showBand ? bandColor : na, title = "SAT Blue / Red Band")

// ----------------------------------------------------------------------------
// MTF バンド状態（アラート用）
//   形成中の上位足でも即座に反映させたいので [1] は付けず、現在値を取る。
//   lookahead_off なので未来参照はしない。
//   ※ チャート足より下位の時間足を要求すると値が不安定になるため、
//     30秒足チャートに貼って使うこと。
// ----------------------------------------------------------------------------
int st30S = request.security(syminfo.tickerid, "30S", f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st1   = request.security(syminfo.tickerid, "1",   f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st5   = request.security(syminfo.tickerid, "5",   f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st15  = request.security(syminfo.tickerid, "15",  f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st30  = request.security(syminfo.tickerid, "30",  f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st60  = request.security(syminfo.tickerid, "60",  f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int st240 = request.security(syminfo.tickerid, "240", f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int stD   = request.security(syminfo.tickerid, "D",   f_satBandStateOnly(), lookahead = barmerge.lookahead_off)
int stW   = request.security(syminfo.tickerid, "W",   f_satBandStateOnly(), lookahead = barmerge.lookahead_off)

// ----------------------------------------------------------------------------
// アラート
//   バンド状態が切り替わったバーで 1 回だけ alert() を出す。
//   alert.freq_once_per_bar なので、同じバー内で何度条件が成立しても発報は 1 回。
//   alert() はヒストリカルバーでは発報しない（TradingView の仕様）。
// ----------------------------------------------------------------------------
string symUp = str.upper(syminfo.ticker)
bool isGold = str.contains(symUp, "XAU") or str.contains(symUp, "GOLD") or str.startswith(symUp, "GC")

bool alertReady = enableAlerts and (isGold or not goldOnly)

f_tfAlert(bool en, string tfName, int cur, int prv) =>
    if en and alertReady and cur != prv
        alert(tfName + " " + f_stateLabel(cur), alert.freq_once_per_bar)

f_tfAlert(alertTf30S, "30秒足",  st30S, nz(st30S[1], st30S))
f_tfAlert(alertTf1,   "1分足",   st1,   nz(st1[1],   st1))
f_tfAlert(alertTf5,   "5分足",   st5,   nz(st5[1],   st5))
f_tfAlert(alertTf15,  "15分足",  st15,  nz(st15[1],  st15))
f_tfAlert(alertTf30,  "30分足",  st30,  nz(st30[1],  st30))
f_tfAlert(alertTf60,  "1時間足", st60,  nz(st60[1],  st60))
f_tfAlert(alertTf240, "4時間足", st240, nz(st240[1], st240))
f_tfAlert(alertTfD,   "日足",     stD,   nz(stD[1],   stD))
f_tfAlert(alertTfW,   "週足",     stW,   nz(stW[1],   stW))

// ----------------------------------------------------------------------------
// デバッグ表示（データウィンドウのみ）
//   Debug が OFF のときは na を出すので、通常は LINE1 / LINE2 / STB だけが見える。
//   display = display.data_window を指定しているためチャート上に線は出ない。
// ----------------------------------------------------------------------------
plot(debugMode ? basis : na,      "DBG: basis (vwma hlc3 5)", display = display.data_window)
plot(debugMode ? common : na,     "DBG: common (basis*0.5)",  display = display.data_window)
plot(debugMode ? atr50 : na,      "DBG: atr50 (ta.atr(50)[1])", display = display.data_window)
plot(debugMode ? anchor1 : na,    "DBG: anchor1",             display = display.data_window)
plot(debugMode ? anchor2 : na,    "DBG: anchor2",             display = display.data_window)
plot(debugMode ? line1 : na,      "DBG: LINE1",               display = display.data_window)
plot(debugMode ? line2 : na,      "DBG: LINE2",               display = display.data_window)
plot(debugMode ? dir1 * 1.0 : na, "DBG: dir1 (+1 Bull / -1 Bear)", display = display.data_window)
plot(debugMode ? dir2 * 1.0 : na, "DBG: dir2 (+1 Bull / -1 Bear)", display = display.data_window)
plot(debugMode ? stb : na,           "DBG: STB",                     display = display.data_window)
plot(debugMode ? stbDir * 1.0 : na,  "DBG: STB dir (+1 UP / -1 DOWN)", display = display.data_window)
plot(debugMode ? bandState : na,     "DBG: Band State (+1 Blue / -1 Red / 0 Neutral)", display = display.data_window)

plot(debugMode ? st30S * 1.0 : na, "DBG: 30秒足 Band State", display = display.data_window)
plot(debugMode ? st1   * 1.0 : na, "DBG: 1分足 Band State",  display = display.data_window)
plot(debugMode ? st5   * 1.0 : na, "DBG: 5分足 Band State",  display = display.data_window)
plot(debugMode ? st15  * 1.0 : na, "DBG: 15分足 Band State", display = display.data_window)
plot(debugMode ? st30  * 1.0 : na, "DBG: 30分足 Band State", display = display.data_window)
plot(debugMode ? st60  * 1.0 : na, "DBG: 1時間足 Band State", display = display.data_window)
plot(debugMode ? st240 * 1.0 : na, "DBG: 4時間足 Band State", display = display.data_window)
plot(debugMode ? stD   * 1.0 : na, "DBG: 日足 Band State",    display = display.data_window)
plot(debugMode ? stW   * 1.0 : na, "DBG: 週足 Band State",    display = display.data_window)

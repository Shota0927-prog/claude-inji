// ============================================================================
// SAT BAND Reconstruction Test
//   非公開インジケーター「SAT's PANEL」の
//     ・SAT's BAND LINE1
//     ・SAT's BAND LINE2
//   の再現テスト版。
//
//   Python によるブラックボックス解析で特定した構造を、そのまま Pine へ置き換えた
//   だけのファイル。見た目を合わせるための補正・追加平滑化・Confirm・ATR43 などは
//   一切入れていない。
//
//   ※ 既存の SAT 再現ファイル（SAT_PANEL_Approximation.pine）とは完全に独立しており、
//     そちらのロジックは一切流用していない。
//   ※ STB は Donchian 構造（表示 10 本 / 転換 20 本）として実装済み。LINE1 / LINE2 とは
//     完全に独立した State を持ち、互いを参照しない。
//   ※ 解析結果に基づく再現テストであって、元 SAT's PANEL の計算式を特定したと
//     断定するものではない。
//
//   構造：
//     basis  = ta.vwma(hlc3, 5)
//     common = basis * 0.5
//     atr50  = ta.atr(50)[1]
//     src      = close[1] * 0.5
//     trigLow  = low[1]   * 0.5
//     trigHigh = high[1]  * 0.5
//
//     LINE1（k = 5.0）／ LINE2（k = 2.5）とも同じ State 機械：
//       Bull(+1) 中： trigLow  < prevAnchor  → Bear へ反転し anchor = src + k * atr50
//                     それ以外               → anchor = math.max(prevAnchor, src - k * atr50)
//       Bear(-1) 中： trigHigh > prevAnchor  → Bull へ反転し anchor = src - k * atr50
//                     それ以外               → anchor = math.min(prevAnchor, src + k * atr50)
//
//     line = common + anchor
// ============================================================================
//@version=6
indicator("SAT BAND Reconstruction Test", shorttitle = "SAT Rebuild", overlay = true)

// ----------------------------------------------------------------------------
// 入力
// ----------------------------------------------------------------------------
debugMode = input.bool(false, "Debug",
     tooltip = "ON にすると basis / common / atr50 / anchor1 / anchor2 / dir1 / dir2 / STB / Band State を\nデータウィンドウへ出力する。チャート上には線を追加しない。")

showSTB  = input.bool(true, "Show STB")
showBand = input.bool(true, "Show Blue / Red Band")

// LINE1 / LINE2 / STB / 背景バンドで共通に使う方向色
bullCol = input.color(#068C8C, "Bull 色（LINE1 / LINE2 / STB / 青バンド共通）")
bearCol = input.color(#F54230, "Bear 色（LINE1 / LINE2 / STB / 赤バンド共通）")
bandTransp = input.int(66, "背景バンドの透明度", minval = 0, maxval = 100,
     tooltip = "0 で不透明、100 で完全に透明。")

// ----------------------------------------------------------------------------
// 共通 Basis
//   SMA でも EMA でもなく VWMA。source は hlc3、length は 5、common 倍率は 0.5。
// ----------------------------------------------------------------------------
float basis  = ta.vwma(hlc3, 5)
float common = basis * 0.5

// ----------------------------------------------------------------------------
// ATR
//   ta.atr() なので内部は RMA。現在足ではなく 1 本前の値を使う。
// ----------------------------------------------------------------------------
float atr50 = ta.atr(50)[1]

// ----------------------------------------------------------------------------
// Anchor 共通 source と State 反転判定用の値
//   いずれも 1 本前の足から作る。現在足は使わない。
// ----------------------------------------------------------------------------
float src      = close[1] * 0.5
float trigLow  = low[1]   * 0.5
float trigHigh = high[1]  * 0.5

// 計算に必要な値がすべてそろっているか
bool ready = not na(atr50) and not na(src) and not na(trigLow) and not na(trigHigh)

// ----------------------------------------------------------------------------
// LINE1（k = 5.0）
//   ※ 同一バー内で更新済みの anchor / dir を条件判定へ再利用しないよう、
//     判定前に prevAnchor1 / prevDir1 へ退避してから State を更新する。
// ----------------------------------------------------------------------------
float k1 = 5.0

var float anchor1 = na
var int   dir1    = 1

float prevAnchor1 = anchor1
int   prevDir1    = dir1

if ready
    if na(prevAnchor1)
        // 初期化：Bull から開始する
        anchor1 := src - k1 * atr50
        dir1    := 1
    else if prevDir1 == 1
        if trigLow < prevAnchor1
            // Bull → Bear
            dir1    := -1
            anchor1 := src + k1 * atr50
        else
            dir1    := 1
            anchor1 := math.max(prevAnchor1, src - k1 * atr50)
    else
        if trigHigh > prevAnchor1
            // Bear → Bull
            dir1    := 1
            anchor1 := src - k1 * atr50
        else
            dir1    := -1
            anchor1 := math.min(prevAnchor1, src + k1 * atr50)

float line1 = common + anchor1

// ----------------------------------------------------------------------------
// LINE2（k = 2.5）
//   LINE1 と構造は完全に同じ。違うのは倍率だけ。
//   状態変数は LINE1 とは独立しており、互いを参照しない。
// ----------------------------------------------------------------------------
float k2 = 2.5

var float anchor2 = na
var int   dir2    = 1

float prevAnchor2 = anchor2
int   prevDir2    = dir2

if ready
    if na(prevAnchor2)
        // 初期化：Bull から開始する
        anchor2 := src - k2 * atr50
        dir2    := 1
    else if prevDir2 == 1
        if trigLow < prevAnchor2
            // Bull → Bear
            dir2    := -1
            anchor2 := src + k2 * atr50
        else
            dir2    := 1
            anchor2 := math.max(prevAnchor2, src - k2 * atr50)
    else
        if trigHigh > prevAnchor2
            // Bear → Bull
            dir2    := 1
            anchor2 := src - k2 * atr50
        else
            dir2    := -1
            anchor2 := math.min(prevAnchor2, src + k2 * atr50)

float line2 = common + anchor2

// ----------------------------------------------------------------------------
// STB（Donchian 構造）
//   LINE1 / LINE2 の State とは完全に独立しており、互いを参照しない。
//   ATR / EMA / Supertrend は一切使わない。
//
//     表示用     ： ta.highest(high, 10) / ta.lowest(low, 10)
//     方向判定用 ： ta.highest(high, 20)[1] / ta.lowest(low, 20)[1]
//
//   方向転換は毎バー、high breakout を先に判定する。
//   同じ足で上下両方を突破した場合も Bull 側（+1）が優先される（else if のため）。
//   どちらも突破していなければ直前の State を維持する。
// ----------------------------------------------------------------------------
float stbUpper = ta.highest(high, 10)
float stbLower = ta.lowest(low, 10)

float prev20High = ta.highest(high, 20)[1]
float prev20Low  = ta.lowest(low, 20)[1]

var int stbDir = 1

if not na(prev20High) and not na(prev20Low)
    if high > prev20High
        stbDir := 1
    else if low < prev20Low
        stbDir := -1

// UP は下側（lower10）、DOWN は上側（upper10）を表示価格にする
float stb = stbDir == 1 ? stbLower : stbUpper

color stbColor = stbDir == 1 ? bullCol : bearCol

// ----------------------------------------------------------------------------
// 青バンド / 赤バンド
//   現在価格と LINE1 / LINE2 / STB の 3 本の位置関係だけで決める。
//   各ラインの dir は判定に使わない。
//     close が 3 本すべてより上 → Bull 色（既定 #068C8C）
//     close が 3 本すべてより下 → Bear 色（既定 #F54230）
//     それ以外（3 本の間）      → 背景なし
// ----------------------------------------------------------------------------
bool allAbove = close > line1 and close > line2 and close > stb
bool allBelow = close < line1 and close < line2 and close < stb

color bandColor = na
if allAbove
    bandColor := color.new(bullCol, bandTransp)
else if allBelow
    bandColor := color.new(bearCol, bandTransp)

// 診断用の数値表現（+1 = Blue / -1 = Red / 0 = 背景なし）
float bandState = allAbove ? 1.0 : allBelow ? -1.0 : 0.0

// ----------------------------------------------------------------------------
// 描画
//   plot() はグローバルスコープでのみ呼ぶ。
//   背景色・Band 塗り・アラートは今回は入れない。
// ----------------------------------------------------------------------------
// LINE1 / LINE2 / STB とも Bull(+1) は bullCol、Bear(-1) は bearCol。
// 色は dir を参照するだけで、ライン価格の計算には一切関与しない。
color line1Color = dir1 == 1 ? bullCol : bearCol
color line2Color = dir2 == 1 ? bullCol : bearCol

plot(line1, "SAT Rebuild LINE1", color = line1Color, linewidth = 2)
plot(line2, "SAT Rebuild LINE2", color = line2Color, linewidth = 2)
plot(showSTB ? stb : na, "SAT Rebuild STB", color = stbColor, linewidth = 2)

bgcolor(showBand ? bandColor : na, title = "SAT Blue / Red Band")

// ----------------------------------------------------------------------------
// デバッグ表示（データウィンドウのみ）
//   Debug が OFF のときは na を出すので、通常は LINE1 / LINE2 だけが見える。
//   display = display.data_window を指定しているためチャート上に線は出ない。
// ----------------------------------------------------------------------------
plot(debugMode ? basis : na,      "DBG: basis (vwma hlc3 5)", display = display.data_window)
plot(debugMode ? common : na,     "DBG: common (basis*0.5)",  display = display.data_window)
plot(debugMode ? atr50 : na,      "DBG: atr50 (ta.atr(50)[1])", display = display.data_window)
plot(debugMode ? anchor1 : na,    "DBG: anchor1",             display = display.data_window)
plot(debugMode ? anchor2 : na,    "DBG: anchor2",             display = display.data_window)
plot(debugMode ? dir1 * 1.0 : na, "DBG: dir1 (+1 Bull / -1 Bear)", display = display.data_window)
plot(debugMode ? dir2 * 1.0 : na, "DBG: dir2 (+1 Bull / -1 Bear)", display = display.data_window)
plot(debugMode ? stb : na,           "DBG: STB",                     display = display.data_window)
plot(debugMode ? stbDir * 1.0 : na,  "DBG: STB dir (+1 UP / -1 DOWN)", display = display.data_window)
plot(debugMode ? bandState : na,     "DBG: Band State (+1 Blue / -1 Red / 0 Neutral)", display = display.data_window)

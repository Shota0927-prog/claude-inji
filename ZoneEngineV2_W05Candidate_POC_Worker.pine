//@version=6
// W05 B14R R0A: CandidateStore worker interface POC only (no Candidate logic).
library("ZoneEngineV2_W05Candidate_POC_Worker", overlay = false)

export type CandidateStore
    array<int>   candidateScratchSupportNewRootSlots
    int          candidateScratchSupportNewLength        = 0
    array<int>   candidateScratchResistanceNewRootSlots
    int          candidateScratchResistanceNewLength     = 0

    array<int>   candidateSupportScratchPosByRootSlot
    array<int>   candidateResistanceScratchPosByRootSlot
    array<bool>  candidateSupportUsedByRootSlot
    array<bool>  candidateResistanceUsedByRootSlot
    array<int>   candidateSupportFvgRootSlots
    int          candidateSupportFvgLength               = 0
    array<int>   candidateResistanceFvgRootSlots
    int          candidateResistanceFvgLength            = 0

    array<int>   candidateWindowMinRootIdDequeScratchIndexes
    array<int>   candidateWindowMaxConfirmedTimeDequeScratchIndexes

    int          candidateBestSide                = 0
    int          candidateBestStage               = na
    int          candidateBestLeftIndex           = -1
    int          candidateBestRightIndex          = -1
    int          candidateBestEffectiveBottomTick = na
    int          candidateBestEffectiveTopTick    = na
    int          candidateBestCCount              = 0
    int          candidateBestHCount              = 0
    int          candidateBestDensity             = na
    bool         candidateBestBaseStrong          = false
    int          candidateBestCreatedTime         = na
    int          candidateBestMinRootId           = 0
    int          candidateBestFvgMode             = 0
    int          candidateBestFvgRootSlot         = -1
    int          candidateBestCategoryMask        = 0
    int          candidateBestHighMask            = 0

    bool         candidateRoundTie                = false
    bool         candidateFailedSupport           = false
    bool         candidateFailedResistance        = false

    array<int>   candidateWinnerSides
    array<int>   candidateWinnerStages
    array<int>   candidateWinnerEffectiveBottomTicks
    array<int>   candidateWinnerEffectiveTopTicks
    array<int>   candidateWinnerCCounts
    array<int>   candidateWinnerHCounts
    array<int>   candidateWinnerDensities
    array<bool>  candidateWinnerBaseStrongFlags
    array<int>   candidateWinnerCategoryMasks
    array<int>   candidateWinnerHighMasks
    array<int>   candidateWinnerCreatedTimes
    array<int>   candidateWinnerMinRootIds
    array<int>   candidateWinnerFvgModes
    array<int>   candidateWinnerPsychLevelTicks
    array<float> candidateWinnerReferencePrices
    array<int>   candidateWinnerRootIdOffsets
    array<int>   candidateWinnerRootIdLengths

    array<int>   candidateWinnerRootIds

    int          candidateWinnerLogicalCount      = 0
    int          candidateWinnerRootIdLength      = 0

    array<float> candidateWinnerRefValueScratch
    int          candidateWinnerRefValueLength    = 0
    array<float> candidateWinnerRefRepScratch
    int          candidateWinnerRefRepLength      = 0

    int          candidatePoolMode                = 0
    int          candidateBroadSeenEpoch          = 0
    array<int>   candidateBroadSeenEpochByRootSlot

export newStore() =>
    CandidateStore s = CandidateStore.new()
    s.candidateScratchSupportNewRootSlots                := array.new_int(0)
    s.candidateScratchResistanceNewRootSlots             := array.new_int(0)
    s.candidateSupportScratchPosByRootSlot               := array.new_int(0)
    s.candidateResistanceScratchPosByRootSlot            := array.new_int(0)
    s.candidateSupportUsedByRootSlot                     := array.new_bool(0)
    s.candidateResistanceUsedByRootSlot                  := array.new_bool(0)
    s.candidateSupportFvgRootSlots                       := array.new_int(0)
    s.candidateResistanceFvgRootSlots                    := array.new_int(0)
    s.candidateWindowMinRootIdDequeScratchIndexes        := array.new_int(0)
    s.candidateWindowMaxConfirmedTimeDequeScratchIndexes := array.new_int(0)
    s.candidateWinnerSides                               := array.new_int(0)
    s.candidateWinnerStages                              := array.new_int(0)
    s.candidateWinnerEffectiveBottomTicks                := array.new_int(0)
    s.candidateWinnerEffectiveTopTicks                   := array.new_int(0)
    s.candidateWinnerCCounts                             := array.new_int(0)
    s.candidateWinnerHCounts                             := array.new_int(0)
    s.candidateWinnerDensities                           := array.new_int(0)
    s.candidateWinnerBaseStrongFlags                     := array.new_bool(0)
    s.candidateWinnerCategoryMasks                       := array.new_int(0)
    s.candidateWinnerHighMasks                           := array.new_int(0)
    s.candidateWinnerCreatedTimes                        := array.new_int(0)
    s.candidateWinnerMinRootIds                          := array.new_int(0)
    s.candidateWinnerFvgModes                            := array.new_int(0)
    s.candidateWinnerPsychLevelTicks                     := array.new_int(0)
    s.candidateWinnerReferencePrices                     := array.new_float(0)
    s.candidateWinnerRootIdOffsets                       := array.new_int(0)
    s.candidateWinnerRootIdLengths                       := array.new_int(0)
    s.candidateWinnerRootIds                             := array.new_int(0)
    s.candidateWinnerRefValueScratch                     := array.new_float(0)
    s.candidateWinnerRefRepScratch                       := array.new_float(0)
    s.candidateBroadSeenEpochByRootSlot                  := array.new_int(0)
    s

// Probe only: reads every parameter kind, mutates the Store (scalar +1, array tail push), never writes an input.
export probeSelectBothSides(CandidateStore store, array<int> rootIds, array<int> rootCategories, array<int> rootSubtypes, array<int> rootTfCodes, array<int> rootConfirmedTimes, array<float> rootPointPrices, array<int> rootPointTicks, array<float> rootNativeBottoms, array<float> rootNativeTops, array<int> rootNativeBottomTicks, array<int> rootNativeTopTicks, array<int> rootStates, array<int> rootPairKeys, array<int> rootDirections, array<bool> rootIsBroadFvgFlags, array<int> rootLabelMasks, array<bool> rootSlotLiveFlags, array<int> rootPriceOrderSlots, array<int> rootIdOrderSlots, map<int, int> rootIdToSlot, map<int, int> accumPairUpperRootSlotByKey, map<int, int> accumPairLowerRootSlotByKey, array<int> rootSwingTfMasks, int ema2000RootSlot, int ema2000ExpectedRootId, int ema2000SlopeDir, int ema3000RootSlot, int ema3000ExpectedRootId, int ema3000SlopeDir, float clusterMaxWidth, float denseRatio, bool useMa, bool useSwing, bool useAccum, bool useTimeHl, bool useFvg, bool usePsych, float mintick) =>
    int probeChecksum = 0
    probeChecksum += array.size(rootIds)
    probeChecksum += array.size(rootCategories)
    probeChecksum += array.size(rootSubtypes)
    probeChecksum += array.size(rootTfCodes)
    probeChecksum += array.size(rootConfirmedTimes)
    probeChecksum += array.size(rootPointPrices)
    probeChecksum += array.size(rootPointTicks)
    probeChecksum += array.size(rootNativeBottoms)
    probeChecksum += array.size(rootNativeTops)
    probeChecksum += array.size(rootNativeBottomTicks)
    probeChecksum += array.size(rootNativeTopTicks)
    probeChecksum += array.size(rootStates)
    probeChecksum += array.size(rootPairKeys)
    probeChecksum += array.size(rootDirections)
    probeChecksum += array.size(rootIsBroadFvgFlags)
    probeChecksum += array.size(rootLabelMasks)
    probeChecksum += array.size(rootSlotLiveFlags)
    probeChecksum += array.size(rootPriceOrderSlots)
    probeChecksum += array.size(rootIdOrderSlots)
    probeChecksum += array.size(rootSwingTfMasks)
    probeChecksum += map.size(rootIdToSlot)
    probeChecksum += map.size(accumPairUpperRootSlotByKey)
    probeChecksum += map.size(accumPairLowerRootSlotByKey)
    probeChecksum += nz(ema2000RootSlot, 0)
    probeChecksum += nz(ema2000ExpectedRootId, 0)
    probeChecksum += nz(ema2000SlopeDir, 0)
    probeChecksum += nz(ema3000RootSlot, 0)
    probeChecksum += nz(ema3000ExpectedRootId, 0)
    probeChecksum += nz(ema3000SlopeDir, 0)
    probeChecksum += int(math.round(nz(clusterMaxWidth, 0.0) * 1000.0))
    probeChecksum += int(math.round(nz(denseRatio, 0.0) * 1000.0))
    probeChecksum += int(math.round(nz(mintick, 0.0) * 1000.0))
    probeChecksum += useMa ? 1 : 0
    probeChecksum += useSwing ? 1 : 0
    probeChecksum += useAccum ? 1 : 0
    probeChecksum += useTimeHl ? 1 : 0
    probeChecksum += useFvg ? 1 : 0
    probeChecksum += usePsych ? 1 : 0
    store.candidateWinnerLogicalCount := store.candidateWinnerLogicalCount + 1 + probeChecksum
    array.push(store.candidateBroadSeenEpochByRootSlot, probeChecksum)
    int supportWinnerCount    = probeChecksum >= 0 ? 1 : -1
    int resistanceWinnerCount = probeChecksum % 2 == 0 ? 0 : 1
    [supportWinnerCount, resistanceWinnerCount]

export probeLogicalCount(CandidateStore store) =>
    store.candidateWinnerLogicalCount

// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © your_username
//
// 【目的】
//   「前日までの直近 N 本の確定済み日足の High-Low の中央値」を
//   サブウィンドウに描画し、過去チャート上での分布を検証するための
//   分析専用インジケーター。
//   エントリー / LONG-SHORT / FVG / EMA / Accum / トリガー等の
//   売買ロジックは一切含まない（今回は分布確認のみ）。

//@version=5
indicator(
     title         = "Daily Range Median (Volatility Regime)",
     shorttitle    = "RangeMed",
     overlay       = false,     // サブウィンドウ（別パネル）に表示
     max_bars_back = 500
 )

// ============================================================
// 入力パラメーター
// ============================================================
grp_calc = "中央値設定"
// デフォルト 10 日。5 / 10 / 15 / 20 日などを比較検証できるよう変更可能。
medianLength = input.int(10, title = "中央値期間（確定日足の本数 N）", minval = 3, group = grp_calc)

grp_thr = "ボラ基準線"
// 現在の分類基準（80 / 140 ドル）と比較するための水平線。変更可能。
lowVolThreshold  = input.float(80.0,  title = "低ボラ基準（ドル）", minval = 0.0, group = grp_thr)
highVolThreshold = input.float(140.0, title = "高ボラ基準（ドル）", minval = 0.0, group = grp_thr)

grp_disp = "表示設定"
// 前日の確定済み日足 Range も重ねて表示（デフォルト ON）。
showPrevRange   = input.bool(true,  title = "前日の確定日足 Range を表示",   group = grp_disp)
prevRangeAsHist = input.bool(false, title = "前日 Range をヒストグラム表示", group = grp_disp)
showTable       = input.bool(true,  title = "右上に現在値テーブルを表示",     group = grp_disp)

grp_dist = "分布集計（過去N日）"
// 分布を集計する期間。5 分足の本数ではなく「日単位」で遡る日数。
distributionDays = input.int(365, title = "分布集計期間（日）", minval = 30, group = grp_dist)
showDistTable    = input.bool(true, title = "分布集計テーブルを表示（右下）", group = grp_dist)

// ============================================================
// 日足データの取得（★未来参照・リペイント防止★）
// ============================================================
// ■ なぜ現在の日足を含めないのか
//   今日の値動き（形成中の日足 High-Low）で今日の判定値が動いてはいけない。
//   その日の判定値は「昨日までの確定情報」だけで決まり、1 日固定であるべき。
//   そのため (high - low) ではなく (high - low)[1]（＝1 本前の確定日足の値幅）を使う。
//
// ■ なぜ lookahead_on と [1] を組み合わせるのか（非リペイントの根拠）
//   ・lookahead_on を「単体」で使うと、HTF バー確定前にその確定値を先読みする
//     未来参照バグになる。
//   ・しかし [1] で「常に 1 本前＝すでに確定したバー」を参照するため、
//     未来情報は一切使われない。
//   ・この「lookahead_on ＋ [1]」の組み合わせは、TradingView 公式（PineCoders）が
//     推奨する非リペイント（no-repaint）イディオムそのもの。
//   ・したがって 5 分足など日足以下のチャートで使っても、
//     計算元は必ず「確定済み日足」であり、バックテストに未来情報は混入しない。
//
//   例）今日が 8/11 の場合、この値は 8/10（確定済み）の日足 High-Low を返す。
//       今日 8/11 の値動きには一切依存しない。
dailyRangePrev = request.security(
     syminfo.tickerid, "D", (high - low)[1],
     lookahead = barmerge.lookahead_on
 )

// ============================================================
// 直近 N 本の確定日足 Range 中央値（★日足コンテキスト内で直接計算★）
// ============================================================
// ■ 中央値の計算方法
//   日足コンテキストで ta.median(high - low, medianLength) を評価する。
//   これは「日足の直近 N 本の High-Low の中央値」を日足側で直接計算する。
//   （中央値＝昇順に並べたときの真ん中の値。外れ値に強い代表値）
//   5 分足側で配列に蓄積して自作する必要はなく、request.security 1 回で済む。
//
// ■ どの N 本を中央値計算に使っているか（現在の日足を含めない理由）
//   ta.median(...) の末尾に [1] を付けることで「1 本前の日足の時点で確定した
//   中央値」を参照する。つまり中央値の計算対象は 1 本前までの確定日足 N 本であり、
//   形成中の今日の日足は絶対に含まれない。
//   → 今日が 8/11 なら、medianRange は 8/10 以前の確定日足 N 本
//     （8/10, 8/9, ...）の High-Low 中央値。8/11 の値動きには一切依存しない。
//
// ■ 非リペイント（未来参照なし）
//   dailyRangePrev と同様、「lookahead_on ＋ [1]」の組み合わせにより
//   常に確定済みの日足のみを参照する。5 分足で使っても未来情報は混入しない。
//   日中は値が動かないため、その日の中央値は 1 日固定。
float medianRange = request.security(
     syminfo.tickerid, "D", ta.median(high - low, medianLength)[1],
     lookahead = barmerge.lookahead_on
 )

// ============================================================
// ボラティリティ区分（前日までの中央値のみで判定）
// ============================================================
//   medianRange <  80          → 低ボラ（1）
//   80 <= medianRange < 140    → 中ボラ（2）
//   medianRange >= 140         → 高ボラ（3）
int volCategory = na
if not na(medianRange)
    volCategory := medianRange < lowVolThreshold  ? 1 :
                   medianRange < highVolThreshold ? 2 : 3

// ============================================================
// 過去 N 日間の中央値分布集計（★1 日 1 回だけカウント★）
// ============================================================
// ■ 目的
//   過去約 1 年間（distributionDays 日）について、各日の medianRange が
//   どの価格帯に何日入ったかを集計する。
//
// ■ 1 日 1 回カウントの理由と実装
//   本インジは 5 分足でも使うため、同じ日の medianRange を日中バー数
//   （5 分足なら 1 日約 288 本）分カウントしてはいけない。
//   timeframe.change("D") で「新しい日の最初のバー」だけを検出し、
//   その日の medianRange を 1 回だけ集計する。
//
// ■ 集計範囲（過去 distributionDays 日のみ）
//   現在時刻 timenow から distributionDays 日ぶんだけ遡った時刻を cutoff とし、
//   その日の time が cutoff 以上の日だけを対象にする。
//   → チャートに古いデータが読み込まれていても、直近 distributionDays 日だけを集計。
//   timenow は 1 回の計算中は一定なので cutoff も一定＝決定論的に集計される。
//
// ■ 分布帯（境界値は将来変更しやすいよう配列で定義）
//   binEdges の各境界で 8 帯に分ける：
//   <60 / 60-80 / 80-100 / 100-120 / 120-140 / 140-160 / 160-180 / 180+
var array<float> binEdges  = array.from(60.0, 80.0, 100.0, 120.0, 140.0, 160.0, 180.0)
var array<int>   binCounts = array.new_int(8, 0)   // 各帯の日数

// 低 / 中 / 高ボラの日数（現行閾値 lowVolThreshold / highVolThreshold を使用）
var int lowCount   = 0
var int midCount   = 0
var int highCount  = 0
var int validDays  = 0   // 集計対象となった有効日数

// 新しい日の最初のバー判定（5 分足でも日単位で true）
bool newDay = timeframe.change("D")

// 過去 distributionDays 日ぶんの cutoff 時刻（ミリ秒）
int msPerDay = 24 * 60 * 60 * 1000
int cutoff   = timenow - distributionDays * msPerDay

if newDay and not na(medianRange) and time >= cutoff
    // 帯インデックス＝medianRange が超えている境界の数（0〜7）
    int idx = 0
    for i = 0 to array.size(binEdges) - 1
        if medianRange >= array.get(binEdges, i)
            idx += 1
    array.set(binCounts, idx, array.get(binCounts, idx) + 1)

    // 低 / 中 / 高ボラ区分（現行閾値で分類）
    if medianRange < lowVolThreshold
        lowCount += 1
    else if medianRange < highVolThreshold
        midCount += 1
    else
        highCount += 1

    validDays += 1

// ============================================================
// プロット
// ============================================================
// N 日 Range 中央値（メインライン）
plot(
     medianRange,
     title     = "N日Range中央値",
     color     = color.new(color.blue, 0),
     linewidth = 2
 )

// 前日の確定日足 Range（ライン or ヒストグラムで比較表示）
plot(
     showPrevRange and not prevRangeAsHist ? dailyRangePrev : na,
     title = "前日Range(ライン)",
     color = color.new(color.gray, 0),
     style = plot.style_stepline
 )
plot(
     showPrevRange and prevRangeAsHist ? dailyRangePrev : na,
     title = "前日Range(ヒスト)",
     color = color.new(color.gray, 40),
     style = plot.style_columns
 )

// 80 / 140 ドルの基準線（現行分類との比較用）
hline(lowVolThreshold,  title = "低ボラ基準", color = color.new(color.green, 0), linestyle = hline.style_dashed)
hline(highVolThreshold, title = "高ボラ基準", color = color.new(color.red,   0), linestyle = hline.style_dashed)

// 背景色（中央値の現在区分。透明度高めでラインを妨げない）
bgcolor(
     na(volCategory)     ? na :
     volCategory == 1    ? color.new(color.green,  88) :   // 低ボラ → 緑系
     volCategory == 2    ? color.new(color.orange, 88) :   // 中ボラ → オレンジ系
                           color.new(color.red,    88),    // 高ボラ → 赤系
     title = "ボラ区分背景"
 )

// ============================================================
// Data Window 用（TradingView の Data Window から数値確認）
// ============================================================
//   ・前日の Daily Range
//   ・N 日 Daily Range 中央値
//   ・ボラ区分（1 = 低ボラ / 2 = 中ボラ / 3 = 高ボラ）
plot(dailyRangePrev, title = "前日Daily Range",       display = display.data_window)
plot(medianRange,    title = "N日中央値",             display = display.data_window)
plot(volCategory,    title = "ボラ区分(1低/2中/3高)", display = display.data_window)

// ============================================================
// 現在値テーブル（右上）
// ============================================================
string regimeText = na(volCategory) ? "データ蓄積中" :
                    volCategory == 1 ? "低ボラ" :
                    volCategory == 2 ? "中ボラ" : "高ボラ"
color regimeColor = na(volCategory) ? color.gray :
                    volCategory == 1 ? color.green :
                    volCategory == 2 ? color.orange : color.red

var table infoTable = table.new(position.top_right, 2, 4, border_width = 1)

if showTable and barstate.islast
    table.cell(infoTable, 0, 0, "期間",     text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(infoTable, 1, 0, str.tostring(medianLength) + "日", text_color = color.white, bgcolor = color.new(color.gray, 20))

    table.cell(infoTable, 0, 1, "中央値",   text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(infoTable, 1, 1, na(medianRange) ? "―" : str.tostring(medianRange, "#.0") + "ドル",
                 text_color = color.white, bgcolor = color.new(color.gray, 40))

    table.cell(infoTable, 0, 2, "判定",     text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(infoTable, 1, 2, regimeText, text_color = color.white, bgcolor = color.new(regimeColor, 20))

    table.cell(infoTable, 0, 3, "前日Range", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(infoTable, 1, 3, na(dailyRangePrev) ? "―" : str.tostring(dailyRangePrev, "#.0") + "ドル",
                 text_color = color.white, bgcolor = color.new(color.gray, 40))

// ============================================================
// 分布集計テーブル（右下・現在値テーブルとは別）
// ============================================================
// 帯 / 日数 / 割合(%) を 8 帯ぶん、その下に 低 / 中 / 高ボラ、
// 最下段に有効日数を表示する。
// 構成：ヘッダー(1) + 帯(8) + 低中高(3) + 有効日数(1) = 13 行、3 列
var array<string> binLabels = array.from("<60", "60-80", "80-100", "100-120", "120-140", "140-160", "160-180", "180+")
var table distTable = table.new(position.bottom_right, 3, 13, border_width = 1)

// 割合(%)を文字列化するヘルパー（0 除算を回避）
f_pct(int cnt, int total) =>
    total > 0 ? str.tostring(cnt * 100.0 / total, "#.0") + "%" : "―"

if showDistTable and barstate.islast
    // --- ヘッダー行 ---
    table.cell(distTable, 0, 0, "帯",   text_color = color.white, bgcolor = color.new(color.gray, 10))
    table.cell(distTable, 1, 0, "日数", text_color = color.white, bgcolor = color.new(color.gray, 10))
    table.cell(distTable, 2, 0, "割合", text_color = color.white, bgcolor = color.new(color.gray, 10))

    // --- 分布帯（8 行）---
    for i = 0 to array.size(binLabels) - 1
        int cnt = array.get(binCounts, i)
        table.cell(distTable, 0, i + 1, array.get(binLabels, i), text_color = color.white, bgcolor = color.new(color.gray, 45))
        table.cell(distTable, 1, i + 1, str.tostring(cnt) + "日",  text_color = color.white, bgcolor = color.new(color.gray, 45))
        table.cell(distTable, 2, i + 1, f_pct(cnt, validDays),      text_color = color.white, bgcolor = color.new(color.gray, 45))

    // --- 低 / 中 / 高ボラ（3 行）---
    table.cell(distTable, 0, 9, "低ボラ", text_color = color.white, bgcolor = color.new(color.green, 30))
    table.cell(distTable, 1, 9, str.tostring(lowCount) + "日", text_color = color.white, bgcolor = color.new(color.green, 30))
    table.cell(distTable, 2, 9, f_pct(lowCount, validDays),    text_color = color.white, bgcolor = color.new(color.green, 30))

    table.cell(distTable, 0, 10, "中ボラ", text_color = color.white, bgcolor = color.new(color.orange, 30))
    table.cell(distTable, 1, 10, str.tostring(midCount) + "日", text_color = color.white, bgcolor = color.new(color.orange, 30))
    table.cell(distTable, 2, 10, f_pct(midCount, validDays),    text_color = color.white, bgcolor = color.new(color.orange, 30))

    table.cell(distTable, 0, 11, "高ボラ", text_color = color.white, bgcolor = color.new(color.red, 30))
    table.cell(distTable, 1, 11, str.tostring(highCount) + "日", text_color = color.white, bgcolor = color.new(color.red, 30))
    table.cell(distTable, 2, 11, f_pct(highCount, validDays),    text_color = color.white, bgcolor = color.new(color.red, 30))

    // --- 有効日数（最下段）---
    table.cell(distTable, 0, 12, "有効日数", text_color = color.white, bgcolor = color.new(color.gray, 10))
    table.cell(distTable, 1, 12, str.tostring(validDays) + "日", text_color = color.white, bgcolor = color.new(color.gray, 10))
    table.cell(distTable, 2, 12, "", bgcolor = color.new(color.gray, 10))

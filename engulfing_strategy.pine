useEMA4SRFlip = input.bool(false, "EMA2000 SR転換", group = grpEMAWZ)
useEMA5SRFlip = input.bool(false, "EMA3000 SR転換", group = grpEMAWZ)
// シグナル種別 ON/OFF
useEMABounce     = input.bool(true, "反発シグナルを使う",       group = grpEMAWZ)
useEMASRFlipSig  = input.bool(false, "SR転換シグナルを使う (MTF未対応・初期OFF)", group = grpEMAWZ)
useEMABandRetest = input.bool(false, "帯抜けリテストを使う",     group = grpEMAWZ)
useEMAInsideNoTrade = input.bool(false, "ON EMA帯の中はNoTrade", group = grpEMAWZ)
// 接近幅
emaTouchMode   = input.string("Dollar", "EMA接近判定", options = ["Dollar", "ATR"], group = grpEMAWZ)
emaTouchDollar = input.float(3.0,  "EMA接近幅($)",      step = 0.1,  group = grpEMAWZ)
emaTouchATRMult= input.float(0.25, "EMA接近幅 ATR倍率", step = 0.05, group = grpEMAWZ)
emaAtrLen      = input.int(14, "EMA ATR期間", minval = 1, group = grpEMAWZ)
emaSRFlipBars     = input.int(10, "SR転換 有効本数",    minval = 1, group = grpEMAWZ)
emaBandRetestBars = input.int(10, "帯リテスト 有効本数", minval = 1, group = grpEMAWZ)
// --- EMA反発 傾きフィルター (反発シグナルのみ。SR転換/帯リテスト/状態管理/WinZone統合には非適用) ---
//   傾き = 各参照TF上の (EMA値 - emaWZSlopeLookback本前のEMA値)。全EMA共通設定。
//   ロング反発は上向き (slope >= min) / ショート反発は下向き (slope <= -min) のみ許可。
//   OFF なら傾きに関係なく既存の反発判定をそのまま使う (挙動不変)。
useEMABounceSlopeFilter = input.bool(true, "EMA反発 傾きフィルター", group = grpEMAWZ)
emaWZSlopeLookback = input.int(3, "EMA反発 傾き判定本数", minval = 1, group = grpEMAWZ)
emaWZSlopeMin      = input.float(0.5, "EMA反発 最低傾き（価格差）", minval = 0.0, step = 0.1, group = grpEMAWZ)

// --- EMA WinZone: MTF (どの時間足のEMAを反応帯として見るか) ---
//   OFF の時間足は request.security を呼ばない。各TFで ON のEMA種類だけ判定に使う。
grpEMATF = "EMA WinZone: MTF"
useEMA1M  = input.bool(true,  "1分EMAを使う",   group = grpEMATF)
useEMA5M  = input.bool(false,  "5分EMAを使う",   group = grpEMATF)
useEMA15M = input.bool(false,  "15分EMAを使う",  group = grpEMATF)

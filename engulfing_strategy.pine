useCandleConfirm    = input.bool(false, "陽線/陰線 確定",       group = grpFibConf)
usePinbarConfirm    = input.bool(false, "ピンバー (上/下ヒゲ)", group = grpFibConf)
useEngulfingConfirm = input.bool(false, "包み足 (engulfing)",   group = grpFibConf)
useEma20Confirm     = input.bool(false, "close と EMA20 の関係", group = grpFibConf)
useBreakPrevConfirm = input.bool(false, "直近足の高値/安値更新",  group = grpFibConf)
pinbarWickRatio     = input.float(2.0, "pinbarWickRatio (ヒゲ/実体比)", minval = 0, step = 0.1, group = grpFibConf)
engulfingBodyRatio  = input.float(1.0, "engulfingBodyRatio (実体比)",   minval = 0, step = 0.1, group = grpFibConf)

grpFibInv = "フィボ: 無効条件"
useDeepLimitInvalid = input.bool(true, "深限界 (A終了%) 突破で無効", group = grpFibInv)
useOriginInvalid    = input.bool(true, "波の起点突破で無効",         group = grpFibInv)
useEMASettleInvalid = input.bool(false, "EMA定着で無効",             group = grpFibInv)

// --- フィボ: 状態管理 (FVG/出来高と同思想) ---
grpFibState = "フィボ: 状態管理"

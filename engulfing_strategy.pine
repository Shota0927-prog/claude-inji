resetEMAStateAfterEntry = input.bool(true, "エントリー後EMA状態をリセット", group = grpEMAState)

// ============================================================
//  4h. 入力 : 水平線 WinZone (レジサポを反応する場所として)
// ------------------------------------------------------------
//  水平線は Bias ではなく Zone。上だからショート等の方向制限はしない。
//  Pivot / 複数回反応 / 前日H・L / セッションH・L を統合ゾーン化し、
//  反発 / レジサポ転換 / ブレイク / スイープ反転 を場所条件として使う。
//  ・useLineWZ=false の時は ta.atr/pivot・配列・前日/セッション更新・
//    ゾーン統合・各判定・状態管理・描画 を一切走らせない。
// ============================================================
grpLineSrc = "水平線: 検出ソース"
useLineModule    = input.bool(true, "水平線モジュールを使う (WinZone ON時のみ有効)", group = grpLineSrc)
usePivotLine     = input.bool(false, "Pivot High/Low", group = grpLineSrc)
useReactionLine  = input.bool(true, "複数回反応価格帯", group = grpLineSrc)
usePreviousDayHL = input.bool(false, "前日 高値/安値", group = grpLineSrc)
useSessionHL     = input.bool(false, "セッション 高値/安値", group = grpLineSrc)

// --- 水平線 MTF (1M/5M/15M/1H/4H の Pivot水平線を反応帯として) ---
//   OFFの時間足は request.security を呼ばない。前日/セッションH・Lはチャート基準。
grpLineTF = "水平線: MTF"
useLine1M  = input.bool(false,  "1分水平線を使う",   group = grpLineTF)
useLine5M  = input.bool(true,  "5分水平線を使う",   group = grpLineTF)
useLine15M = input.bool(false,  "15分水平線を使う",  group = grpLineTF)
useLine1H  = input.bool(false,  "1時間水平線を使う", group = grpLineTF)
useLine4H  = input.bool(false,  "4時間水平線を使う", group = grpLineTF)
tfLine1M  = input.timeframe("1",   "1分TF",   group = grpLineTF)
tfLine5M  = input.timeframe("5",   "5分TF",   group = grpLineTF)
tfLine15M = input.timeframe("15",  "15分TF",  group = grpLineTF)
tfLine1H  = input.timeframe("60",  "1時間TF", group = grpLineTF)
tfLine4H  = input.timeframe("240", "4時間TF", group = grpLineTF)

grpLinePat = "水平線: パターン"
useLineBounce = input.bool(false, "反発", group = grpLinePat)
useLineFlip   = input.bool(false, "レジサポ転換", group = grpLinePat)
useLineBreak  = input.bool(true, "ブレイク", group = grpLinePat)
useLineSweep  = input.bool(false, "スイープ反転", group = grpLinePat)

grpLineParam = "水平線: パラメータ"
lineAtrLen   = input.int(14, "ATR期間", minval = 1, group = grpLineParam)
lineMaxZones = input.int(20, "水平線 最大保持数", minval = 1, group = grpLineParam)
linePivotLen = input.int(10, "Pivot Length", minval = 1, group = grpLineParam)
reactionLookback     = input.int(300, "反応 参照本数", minval = 1, group = grpLineParam)
reactionToleranceATR = input.float(0.3, "反応 許容幅 ATR倍率", step = 0.05, group = grpLineParam)
reactionMinTouches   = input.int(2, "反応 最小タッチ数", minval = 2, group = grpLineParam)
lineFlipLookback     = input.int(30, "転換 参照本数", minval = 1, group = grpLineParam)
lineFlipConfirmBars  = input.int(2,  "転換 確定本数", minval = 0, group = grpLineParam)
useLineBreakBodyFilter = input.bool(true, "ブレイク 実体フィルター", group = grpLineParam)
lineBreakBodyRatio     = input.float(0.5, "ブレイク 実体率最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineParam)
lineSweepToleranceATR  = input.float(0.2, "スイープ 最小貫通 ATR倍率", minval = 0.0, step = 0.05, group = grpLineParam)
// --- ブレイク改善: 最小バッファ ---
lineBreakBufferMode   = input.string("ATR", "ブレイク 最小バッファ方式", options = ["Dollar", "ATR", "None"], group = grpLineParam)
lineBreakBufferDollar = input.float(0.5,  "ブレイク バッファ(ドル/価格)", minval = 0.0, step = 0.1,  group = grpLineParam)
lineBreakBufferATR    = input.float(0.10, "ブレイク バッファ ATR倍率",   minval = 0.0, step = 0.05, group = grpLineParam)
// --- ブレイク改善: 確定方式 ---
lineBreakConfirmMode  = input.string("CloseOnly", "ブレイク 確定方式", options = ["CloseOnly", "NextBar", "Consecutive"], group = grpLineParam)
lineBreakConfirmBars  = input.int(2, "ブレイク 連続確定本数(Consecutive)", minval = 1, maxval = 10, group = grpLineParam)
// --- ブレイク改善: セッション水平線 有効日数 ---
lineSessionMaxDays    = input.int(2, "セッション水平線 有効日数(当日含む)", minval = 1, maxval = 10, group = grpLineParam)

grpLineFilt = "水平線: 共通フィルター"
useLineDirCandleFilter = input.bool(false,  "方向ローソク", group = grpLineFilt)
useLineWickFilter      = input.bool(false, "ヒゲ確認",     group = grpLineFilt)
useLineBodyFilter      = input.bool(false, "実体率",       group = grpLineFilt)
useLineATRFilter       = input.bool(false, "ATR(値幅)",    group = grpLineFilt)
lineBodyRatioMin       = input.float(0.3, "実体率 最小", minval = 0.0, maxval = 1.0, step = 0.05, group = grpLineFilt)
lineAtrMinMult         = input.float(0.5, "最小値幅 ATR倍率", minval = 0.0, step = 0.05, group = grpLineFilt)

grpLineZone = "水平線: ゾーン"
useLineATRZone     = input.bool(false, "ゾーン幅をATR連動にする", group = grpLineZone)
lineZoneATRMult    = input.float(0.25, "ゾーン幅 ATR倍率", step = 0.05, group = grpLineZone)
lineZoneFixedWidth = input.float(0.1, "ゾーン幅 固定", step = 0.1, group = grpLineZone)
useLineMergeZone   = input.bool(false, "近い水平線をゾーン統合する", group = grpLineZone)
lineMergeToleranceATR = input.float(0.2, "統合許容幅 ATR倍率", step = 0.05, group = grpLineZone)

grpLineSess = "水平線: セッション"
lineSessTZ     = input.string("GMT", "セッション タイムゾーン", group = grpLineSess)
lineAsiaSess   = input.session("0000-0800", "Asia",   group = grpLineSess)
lineLondonSess = input.session("0700-1600", "London", group = grpLineSess)
lineNySess     = input.session("1200-2100", "New York", group = grpLineSess)

grpLineObs = "水平線: 障害物"
useLineObstacleFilter = input.bool(false, "水平線障害物フィルターを使う", group = grpLineObs)
lineObstacleATR       = input.float(0.5, "障害物 近接 ATR倍率", step = 0.05, group = grpLineObs)

grpLineState = "水平線: 状態管理"
useLineStateWindow       = input.bool(true, "水平線状態管理を使う", group = grpLineState)
lineStateMaxBars         = input.int(3, "水平線状態 有効本数", minval = 1, group = grpLineState)
resetLineStateAfterEntry = input.bool(true, "エントリー後水平線状態をリセット", group = grpLineState)

// ============================================================
//  5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open,    close)
float curBodyLo  = math.min(open,    close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
//  5b. FVG 場所検知 (フィルター用)
// ------------------------------------------------------------
//  FVG はエントリートリガーではなく「場所条件」として使う。
//  useFVGFilter を使う時、または box 表示時のみ配列・ループを動かす。
// ============================================================
// WinZone 階層でFVG/出来高を使うかどうか (対象外の側は計算を走らせない = 軽量)
bool useFVGWZ  = useWinZoneModule and useFVGWinZone    and (winZoneMode == "FVG_ONLY"    or winZoneMode == "OR" or winZoneMode == "AND")
bool useVolume = useWinZoneModule and useVolumeWinZone and (winZoneMode == "VOLUME_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
bool useFibWZ  = useWinZoneModule and useFibWinZone    and (winZoneMode == "FIB_ONLY"    or winZoneMode == "OR" or winZoneMode == "AND")
// 水平線 WinZone : マスター かつ 水平線ON かつ モジュールON かつ モード対象。OFFなら全処理を走らせない。
bool useLineWZ = useWinZoneModule and useLineModule and useLineWinZone and (winZoneMode == "LINE_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// EMA WinZone : マスター かつ EMA ON かつ モジュール ON かつ モード対象。OFFなら EMA計算・ATR・cross・状態管理・描画 を一切走らせない。
bool useEMAWZ = useWinZoneModule and useEMAWinZone and useEMAModule and (winZoneMode == "EMA_ONLY" or winZoneMode == "OR" or winZoneMode == "AND")
// FVG 計算は WinZoneでFVGを使う時のみ動かす
bool useFVG = useFVGWZ

// --- USレンジ式 FVG ヘルパー ---
// Accum判定レンジ幅 (実体ベース)
f_fvgAccumRange() =>
    ta.highest(math.max(open, close), fvgAccumRangeLen) - ta.lowest(math.min(open, close), fvgAccumRangeLen)

// Accumulation 中核判定 (ATR幅・短期/基準幅比・上下終値バランス・ドリフト・同色連続の全AND)
f_fvgIsAccumCore() =>
    float _atr = ta.atr(fvgAccumAtrLen)
    float _bodyTop = math.max(open, close)
    float _bodyBot = math.min(open, close)
    float _rangeHigh = ta.highest(_bodyTop, fvgAccumRangeLen)
    float _rangeLow  = ta.lowest(_bodyBot, fvgAccumRangeLen)
    float _rangeNow  = _rangeHigh - _rangeLow
    float _rangeMid  = (_rangeHigh + _rangeLow) * 0.5
    int _upperCloses = 0
    int _lowerCloses = 0
    int _bullRun = 0
    int _bearRun = 0
    int _maxBullRun = 0
    int _maxBearRun = 0
    for i = 0 to fvgAccumRangeLen - 1
        _upperCloses += close[i] > _rangeMid ? 1 : 0
        _lowerCloses += close[i] < _rangeMid ? 1 : 0
        bool _isBull = close[i] > open[i]
        bool _isBear = close[i] < open[i]
        if _isBull
            _bullRun += 1
            _bearRun := 0
        else if _isBear
            _bearRun += 1
            _bullRun := 0
        else
            _bullRun := 0
            _bearRun := 0
        _maxBullRun := math.max(_maxBullRun, _bullRun)
        _maxBearRun := math.max(_maxBearRun, _bearRun)
    float _startMid = (open[fvgAccumRangeLen - 1] + close[fvgAccumRangeLen - 1]) * 0.5
    float _endMid   = (open + close) * 0.5
    float _drift    = math.abs(_endMid - _startMid)
    bool _condAtr = _atr > 0 and _rangeNow <= _atr * fvgAccumAtrMult
    float _rangeShort = ta.highest(_bodyTop, fvgAccumRangeLen) - ta.lowest(_bodyBot, fvgAccumRangeLen)
    float _rangeBase  = ta.highest(_bodyTop, fvgAccumBaseLen)  - ta.lowest(_bodyBot, fvgAccumBaseLen)
    bool _condBar      = _rangeBase > 0 and _rangeShort <= _rangeBase * fvgAccumBarRatioMax
    bool _condBalance  = _upperCloses >= fvgAccumMinUpperCloses and _lowerCloses >= fvgAccumMinLowerCloses
    bool _condDrift    = _rangeNow > 0 and (_drift / _rangeNow) <= fvgAccumDriftMax
    bool _condColorRun = _maxBullRun <= fvgAccumMaxSameColorRun and _maxBearRun <= fvgAccumMaxSameColorRun
    _condAtr and _condBar and _condBalance and _condDrift and _condColorRun

// FVG間距離 (2ゾーンの空白。重なり/接触なら0)
f_fvgZoneGap(float _top1, float _bot1, float _top2, float _bot2) =>
    float _upperGap = _bot1 > _top2 ? (_bot1 - _top2) : 0.0
    float _lowerGap = _bot2 > _top1 ? (_bot2 - _top1) : 0.0
    math.max(_upperGap, _lowerGap)

// --- FVG 保存配列 (USレンジ式: Accum幅基準 + 当バー埋めフラグ。全配列を同一indexで並列管理) ---
var array<float> bullTopArr   = array.new_float()
var array<float> bullBotArr   = array.new_float()
var array<int>   bullBarArr   = array.new_int()
var array<float> bullRefArr   = array.new_float()   // 生成時Accumulation幅 (厚み/近接の正規化基準)
var array<bool>  bullRebUsed  = array.new_bool()
var array<bool>  bullAbsUsed  = array.new_bool()
var array<bool>  bullDeadArr  = array.new_bool()
var array<bool>  bullFilledArr = array.new_bool()   // 当バーに終値で貫通(埋め)されたか

var array<float> bearTopArr   = array.new_float()
var array<float> bearBotArr   = array.new_float()
var array<int>   bearBarArr   = array.new_int()
var array<float> bearRefArr   = array.new_float()
var array<bool>  bearRebUsed  = array.new_bool()
var array<bool>  bearAbsUsed  = array.new_bool()
var array<bool>  bearDeadArr  = array.new_bool()
var array<bool>  bearFilledArr = array.new_bool()

// 逆側 (Bear) FVG が近接かつ十分厚い時だけ Bull反発をブロック (距離+厚みの両方)
f_fvgNearOppBearForBull(float _top, float _bot, float _ref) =>
    bool _blocked = false
    if useOppositeFVGFilter and array.size(bearTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bearTopArr) - 1
            if not array.get(bearDeadArr, j) and not array.get(bearRebUsed, j)
                float _otop = array.get(bearTopArr, j)
                float _obot = array.get(bearBotArr, j)
                float _ow = _otop - _obot
                float _gap = f_fvgZoneGap(_top, _bot, _otop, _obot)
                if (_gap / _ref) <= fvgOppositeNearGapMax and (_ow / _ref) >= fvgOppositeMinThickness
                    _blocked := true
    _blocked

f_fvgNearOppBullForBear(float _top, float _bot, float _ref) =>
    bool _blocked = false
    if useOppositeFVGFilter and array.size(bullTopArr) > 0 and _ref > 0
        for j = 0 to array.size(bullTopArr) - 1
            if not array.get(bullDeadArr, j) and not array.get(bullRebUsed, j)
                float _otop = array.get(bullTopArr, j)
                float _obot = array.get(bullBotArr, j)
                float _ow = _otop - _obot
                float _gap = f_fvgZoneGap(_top, _bot, _otop, _obot)
                if (_gap / _ref) <= fvgOppositeNearGapMax and (_ow / _ref) >= fvgOppositeMinThickness
                    _blocked := true
    _blocked

// FVG シグナル (種類別。単バーイベント)
bool fvgReboundBuy  = false
bool fvgReboundSell = false
bool fvgAbsorbBuy   = false
bool fvgAbsorbSell  = false
bool ifvgBuy        = false
bool ifvgSell       = false

// 新Accum開始でFVG状態保持をリセットするための伝搬フラグ (状態管理ブロックで参照)
bool fvgResetStateNow = false

// --- Accumulation / MSS / 方向ロック 状態 (var: バー跨ぎ保持) ---
var int   fvgAbsorbBias    = 0    // 0=制限なし / 1=BUYのみ許可 / -1=SELLのみ許可 / 2=両方向停止
var bool  fvgIsAccumPrev   = false
var float fvgRunAccumHigh  = na
var float fvgRunAccumLow   = na
var float fvgLastAccumHigh = na
var float fvgLastAccumLow  = na
var float fvgLastAccumWidth= na
var float fvgPhaseAccumRef = na
var bool  fvgPhaseActive   = false
var bool  fvgUpBreakSeen   = false
var float fvgUpCumBody     = 0.0
var bool  fvgUpMssDone     = false
var int   fvgUpMssBar      = na
var bool  fvgDnBreakSeen   = false
var float fvgDnCumBody     = 0.0
var bool  fvgDnMssDone     = false
var int   fvgDnMssBar      = na

if useFVG
    bool _conf = barstate.isconfirmed
    float _accRange   = f_fvgAccumRange()
    bool  fvgIsAccum  = f_fvgIsAccumCore()
    float _accHighNow = ta.highest(math.max(open, close), fvgAccumRangeLen)
    float _accLowNow  = ta.lowest(math.min(open, close), fvgAccumRangeLen)
    bool _newAccum = fvgIsAccum and not fvgIsAccumPrev
    bool _endAccum = not fvgIsAccum and fvgIsAccumPrev

    // 1. 新Accum開始 → 状態リセット + 前フェーズFVG全削除 (box削除→逆順不要の先頭removeで全消去)
    if _newAccum
        fvgLastAccumHigh := na
        fvgLastAccumLow  := na
        fvgLastAccumWidth:= na
        fvgPhaseAccumRef := na
        fvgRunAccumHigh  := _accHighNow
        fvgRunAccumLow   := _accLowNow
        fvgUpBreakSeen := false
        fvgUpCumBody   := 0.0
        fvgUpMssDone   := false
        fvgUpMssBar    := na
        fvgDnBreakSeen := false
        fvgDnCumBody   := 0.0
        fvgDnMssDone   := false
        fvgDnMssBar    := na
        fvgPhaseActive := false
        fvgAbsorbBias  := 0
        fvgResetStateNow := true
        while array.size(bullTopArr) > 0
            array.remove(bullTopArr, 0)
            array.remove(bullBotArr, 0)
            array.remove(bullBarArr, 0)
            array.remove(bullRefArr, 0)
            array.remove(bullRebUsed, 0)
            array.remove(bullAbsUsed, 0)
            array.remove(bullDeadArr, 0)
            array.remove(bullFilledArr, 0)
        while array.size(bearTopArr) > 0
            array.remove(bearTopArr, 0)
            array.remove(bearBotArr, 0)
            array.remove(bearBarArr, 0)
            array.remove(bearRefArr, 0)
            array.remove(bearRebUsed, 0)
            array.remove(bearAbsUsed, 0)
            array.remove(bearDeadArr, 0)
            array.remove(bearFilledArr, 0)

    // 2. Accum継続中 → 実体ベースで高安追跡
    if fvgIsAccum
        float _bt = math.max(open, close)
        float _bb = math.min(open, close)
        fvgRunAccumHigh := na(fvgRunAccumHigh) ? _bt : math.max(fvgRunAccumHigh, _bt)
        fvgRunAccumLow  := na(fvgRunAccumLow)  ? _bb : math.min(fvgRunAccumLow,  _bb)

    // 3. Accum終了 → 確定幅を保存 (フェーズ基準 phaseAccumRef)
    if _endAccum
        fvgLastAccumHigh := fvgRunAccumHigh
        fvgLastAccumLow  := fvgRunAccumLow
        fvgLastAccumWidth:= fvgRunAccumHigh - fvgRunAccumLow
        fvgPhaseAccumRef := fvgLastAccumWidth
        fvgRunAccumHigh  := na
        fvgRunAccumLow   := na

    // 4. MSS (上抜け / 下抜け) → phaseActive 有効化。方向別に成立バーを記録。
    bool _upMSS = false
    if not na(fvgLastAccumHigh) and not na(fvgLastAccumWidth) and fvgLastAccumWidth > 0 and not fvgUpMssDone
        bool _brk = close > fvgLastAccumHigh and close[1] <= fvgLastAccumHigh
        if _brk and not fvgUpBreakSeen
            fvgUpBreakSeen := true
            fvgUpCumBody   := close - open
        else if fvgUpBreakSeen
            fvgUpCumBody := fvgUpCumBody + (close - open)
        bool _imp = math.abs(fvgUpCumBody) >= fvgLastAccumWidth * fvgMssImpulseMult
        _upMSS := _conf and fvgUpBreakSeen and (not fvgMssNeedBodyStrength or _imp)
        if _upMSS
            fvgUpMssDone := true
    if _upMSS
        fvgPhaseActive := true
        fvgUpMssBar    := bar_index
    bool _dnMSS = false
    if not na(fvgLastAccumLow) and not na(fvgLastAccumWidth) and fvgLastAccumWidth > 0 and not fvgDnMssDone
        bool _brk = close < fvgLastAccumLow and close[1] >= fvgLastAccumLow
        if _brk and not fvgDnBreakSeen
            fvgDnBreakSeen := true
            fvgDnCumBody   := open - close
        else if fvgDnBreakSeen
            fvgDnCumBody := fvgDnCumBody + (open - close)
        bool _imp = math.abs(fvgDnCumBody) >= fvgLastAccumWidth * fvgMssImpulseMult
        _dnMSS := _conf and fvgDnBreakSeen and (not fvgMssNeedBodyStrength or _imp)
        if _dnMSS
            fvgDnMssDone := true
    if _dnMSS
        fvgPhaseActive := true
        fvgDnMssBar    := bar_index

    // 5. フェーズ中に形成されたFVGだけ収集 (Bull/Bear両方・方向限定なし)。確定足のみ。厚み=Accum幅比。
    float _ref = nz(fvgPhaseAccumRef, _accRange)
    float _thickMinAny = math.min(fvgThicknessMinRebound, fvgThicknessMinAbsorption)
    bool _newBull = _conf and low > high[2]
    bool _newBear = _conf and high < low[2]
    if fvgPhaseActive and useBullishFVG and _newBull and _ref > 0 and ((low - high[2]) / _ref) >= _thickMinAny
        float _top = low
        float _bot = high[2]
        array.push(bullTopArr, _top)
        array.push(bullBotArr, _bot)
        array.push(bullBarArr, bar_index)
        array.push(bullRefArr, _ref)
        array.push(bullRebUsed, false)
        array.push(bullAbsUsed, false)
        array.push(bullDeadArr, false)
        array.push(bullFilledArr, false)
    if fvgPhaseActive and useBearishFVG and _newBear and _ref > 0 and ((low[2] - high) / _ref) >= _thickMinAny
        float _top = low[2]
        float _bot = high
        array.push(bearTopArr, _top)
        array.push(bearBotArr, _bot)
        array.push(bearBarArr, bar_index)
        array.push(bearRefArr, _ref)
        array.push(bearRebUsed, false)
        array.push(bearAbsUsed, false)
        array.push(bearDeadArr, false)
        array.push(bearFilledArr, false)

    // 6. 最大保持数 (120) 超過 → 最古から削除 (Bull/Bear各配列を同時にshift)
    while array.size(bullTopArr) > maxFVGPerSide
        array.remove(bullTopArr, 0)
        array.remove(bullBotArr, 0)
        array.remove(bullBarArr, 0)
        array.remove(bullRefArr, 0)
        array.remove(bullRebUsed, 0)
        array.remove(bullAbsUsed, 0)
        array.remove(bullDeadArr, 0)
        array.remove(bullFilledArr, 0)
    while array.size(bearTopArr) > maxFVGPerSide
        array.remove(bearTopArr, 0)
        array.remove(bearBotArr, 0)
        array.remove(bearBarArr, 0)
        array.remove(bearRefArr, 0)
        array.remove(bearRebUsed, 0)
        array.remove(bearAbsUsed, 0)
        array.remove(bearDeadArr, 0)
        array.remove(bearFilledArr, 0)

    // 7. 当バー埋めフラグを毎バー初期化
    if array.size(bullFilledArr) > 0
        for i = 0 to array.size(bullFilledArr) - 1
            array.set(bullFilledArr, i, false)
    if array.size(bearFilledArr) > 0
        for i = 0 to array.size(bearFilledArr) - 1
            array.set(bearFilledArr, i, false)

    // 8. 維持 / 無効化 (年齢超過 or Accum中 → dead)。終値貫通=当バー埋めフラグ。逆順ループで安全処理。
    if array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if not array.get(bullDeadArr, i)
                float _bot = array.get(bullBotArr, i)
                int   _bar = array.get(bullBarArr, i)
                if _conf and bar_index > _bar and close < _bot
                    array.set(bullFilledArr, i, true)
                if (bar_index - _bar) > fvgMaxAge or fvgIsAccum
                    array.set(bullDeadArr, i, true)
    if array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if not array.get(bearDeadArr, i)
                float _top = array.get(bearTopArr, i)
                int   _bar = array.get(bearBarArr, i)
                if _conf and bar_index > _bar and close > _top
                    array.set(bearFilledArr, i, true)
                if (bar_index - _bar) > fvgMaxAge or fvgIsAccum
                    array.set(bearDeadArr, i, true)

    // 9. 埋め集計 → 方向ロック (Bear FVG埋め=BUY方向 / Bull FVG埋め=SELL方向)。埋めFVGは反発不可。
    bool _bullFill = false
    bool _bearFill = false
    if array.size(bullFilledArr) > 0
        for i = 0 to array.size(bullFilledArr) - 1
            if array.get(bullFilledArr, i)
                _bullFill := true
                array.set(bullRebUsed, i, true)
    if array.size(bearFilledArr) > 0
        for i = 0 to array.size(bearFilledArr) - 1
            if array.get(bearFilledArr, i)
                _bearFill := true
                array.set(bearRebUsed, i, true)
    if _bearFill
        if fvgAbsorbBias == 0
            fvgAbsorbBias := 1
        else if fvgAbsorbBias == -1
            fvgAbsorbBias := 2
    if _bullFill
        if fvgAbsorbBias == 0
            fvgAbsorbBias := -1
        else if fvgAbsorbBias == 1
            fvgAbsorbBias := 2

    // MSS窓 (反発/吸収の共通ゲート)
    bool _upWinOk = not na(fvgUpMssBar) and (bar_index - fvgUpMssBar <= fvgMssValidBars)
    bool _dnWinOk = not na(fvgDnMssBar) and (bar_index - fvgDnMssBar <= fvgMssValidBars)

    // 10. 吸収スキャン (先に評価 → 反発へ優先)。最新FVG優先。薄い最新+近接した厚い前FVGは前を待つ。
    // --- 吸収BUY = Bear FVG が下向きMSS後に終値上抜け ---
    int _absBuyIdx = -1
    if useFVGAbsorptionFilter and fvgPhaseActive and _dnWinOk and array.size(bearTopArr) > 0
        int _latest = -1
        for i = array.size(bearTopArr) - 1 to 0
            if _latest == -1 and array.get(bearBarArr, i) > fvgDnMssBar and not array.get(bearDeadArr, i) and not array.get(bearAbsUsed, i)
                if array.get(bearFilledArr, i) or (bar_index > array.get(bearBarArr, i) and close > array.get(bearTopArr, i))
                    _latest := i
        if _latest != -1
            float _top  = array.get(bearTopArr, _latest)
            float _bot  = array.get(bearBotArr, _latest)
            float _refL = array.get(bearRefArr, _latest)
            float _w    = _top - _bot
            bool _thin = _refL > 0 and (_w / _refL) <= fvgAbsorbThinRatioMax
            int _prev = -1
            if _latest > 0
                for j = _latest - 1 to 0
                    if _prev == -1 and array.get(bearBarArr, j) > fvgDnMssBar and not array.get(bearDeadArr, j) and not array.get(bearAbsUsed, j)
                        _prev := j
            bool _usePrev = false
            if _thin and _prev != -1
                float _ptop = array.get(bearTopArr, _prev)
                float _pbot = array.get(bearBotArr, _prev)
                float _pw = _ptop - _pbot
                float _gap = f_fvgZoneGap(_top, _bot, _ptop, _pbot)
                if _refL > 0 and (_gap / _refL) <= fvgAbsorbNearGapMax and _pw > _w
                    _usePrev := true
                    if _conf
                        array.set(bearAbsUsed, _latest, true)
            int _chosen = _latest
            if _usePrev
                if _prev != -1 and array.get(bearBarArr, _prev) > fvgDnMssBar and bar_index > array.get(bearBarArr, _prev) and close > array.get(bearTopArr, _prev)
                    _chosen := _prev
                else
                    _chosen := -1
            if _chosen != -1
                float _ctop = array.get(bearTopArr, _chosen)
                float _cref = array.get(bearRefArr, _chosen)
                float _cwidth = _ctop - array.get(bearBotArr, _chosen)
                bool _cThickOk = _cref > 0 and (_cwidth / _cref) >= fvgThicknessMinAbsorption
                float _barRange = high - low
                float _bodyRatio = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
                bool _closeNearHi = _barRange > 0 and (close - low) / _barRange >= absorbCloseEdgeRatio
                if _conf and close > open and close > _ctop and _bodyRatio >= absorbBodyMinRatio and _closeNearHi and _cThickOk
                    _absBuyIdx := _chosen
    // --- 吸収SELL = Bull FVG が上向きMSS後に終値下抜け ---
    int _absSellIdx = -1
    if useFVGAbsorptionFilter and fvgPhaseActive and _upWinOk and array.size(bullTopArr) > 0
        int _latest = -1
        for i = array.size(bullTopArr) - 1 to 0
            if _latest == -1 and array.get(bullBarArr, i) > fvgUpMssBar and not array.get(bullDeadArr, i) and not array.get(bullAbsUsed, i)
                if array.get(bullFilledArr, i) or (bar_index > array.get(bullBarArr, i) and close < array.get(bullBotArr, i))
                    _latest := i
        if _latest != -1
            float _top  = array.get(bullTopArr, _latest)
            float _bot  = array.get(bullBotArr, _latest)
            float _refL = array.get(bullRefArr, _latest)
            float _w    = _top - _bot
            bool _thin = _refL > 0 and (_w / _refL) <= fvgAbsorbThinRatioMax
            int _prev = -1
            if _latest > 0
                for j = _latest - 1 to 0
                    if _prev == -1 and array.get(bullBarArr, j) > fvgUpMssBar and not array.get(bullDeadArr, j) and not array.get(bullAbsUsed, j)
                        _prev := j
            bool _usePrev = false
            if _thin and _prev != -1
                float _ptop = array.get(bullTopArr, _prev)
                float _pbot = array.get(bullBotArr, _prev)
                float _pw = _ptop - _pbot
                float _gap = f_fvgZoneGap(_top, _bot, _ptop, _pbot)
                if _refL > 0 and (_gap / _refL) <= fvgAbsorbNearGapMax and _pw > _w
                    _usePrev := true
                    if _conf
                        array.set(bullAbsUsed, _latest, true)
            int _chosen = _latest
            if _usePrev
                if _prev != -1 and array.get(bullBarArr, _prev) > fvgUpMssBar and bar_index > array.get(bullBarArr, _prev) and close < array.get(bullBotArr, _prev)
                    _chosen := _prev
                else
                    _chosen := -1
            if _chosen != -1
                float _cbot = array.get(bullBotArr, _chosen)
                float _cref = array.get(bullRefArr, _chosen)
                float _cwidth = array.get(bullTopArr, _chosen) - _cbot
                bool _cThickOk = _cref > 0 and (_cwidth / _cref) >= fvgThicknessMinAbsorption
                float _barRange = high - low
                float _bodyRatio = _barRange > 0 ? math.abs(close - open) / _barRange : 0.0
                bool _closeNearLo = _barRange > 0 and (high - close) / _barRange >= absorbCloseEdgeRatio
                if _conf and close < open and close < _cbot and _bodyRatio >= absorbBodyMinRatio and _closeNearLo and _cThickOk
                    _absSellIdx := _chosen

    // 11. 反発スキャン (侵入深度方式 + 前足接触→現在足反転の遅延確定)
    int _rebBuyIdx = -1
    if useFVGReboundFilter and fvgPhaseActive and _upWinOk and array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if _rebBuyIdx == -1 and not array.get(bullDeadArr, i) and not array.get(bullRebUsed, i)
                float _top  = array.get(bullTopArr, i)
                float _bot  = array.get(bullBotArr, i)
                int   _bar  = array.get(bullBarArr, i)
                float _refI = array.get(bullRefArr, i)
                if _refI > 0 and ((_top - _bot) / _refI) >= fvgThicknessMinRebound
                    float _zone = math.max(_top - _bot, syminfo.mintick)
                    float _depth = math.max(0.0, (_top - low) / _zone)
                    bool _touched = bar_index > _bar and low <= _top and high >= _bot
                    bool _blk = f_fvgNearOppBearForBull(_top, _bot, _refI)
                    float _barRange = high - low
                    bool _bodyStrong  = not useFVGReboundStrictCandleBuy or (_barRange > 0 and math.abs(close - open) >= _barRange * fvgReboundBodyMinRatioBuy)
                    bool _closeNearHi = not useFVGReboundStrictCandleBuy or (_barRange > 0 and (close - low) / _barRange >= fvgReboundCloseEdgeRatioBuy)
                    bool _bullBar     = not useFVGReboundStrictCandleBuy or close > open
                    bool _direct = _touched and _depth < fvgReboundConfirmDepthBuy
                    bool _prevTouched = bar_index - 1 > _bar and low[1] <= _top and high[1] >= _bot
                    float _prevDepth  = math.max(0.0, (_top - math.min(open[1], close[1])) / _zone)
                    bool _deferred = _prevTouched and _prevDepth < fvgReboundConfirmDepthBuy
                    if _conf and not _blk and (_direct or _deferred) and _bullBar and _closeNearHi and _bodyStrong
                        _rebBuyIdx := i
    int _rebSellIdx = -1
    if useFVGReboundFilter and fvgPhaseActive and _dnWinOk and array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if _rebSellIdx == -1 and not array.get(bearDeadArr, i) and not array.get(bearRebUsed, i)
                float _top  = array.get(bearTopArr, i)
                float _bot  = array.get(bearBotArr, i)
                int   _bar  = array.get(bearBarArr, i)
                float _refI = array.get(bearRefArr, i)
                if _refI > 0 and ((_top - _bot) / _refI) >= fvgThicknessMinRebound
                    float _zone = math.max(_top - _bot, syminfo.mintick)
                    float _depth = math.max(0.0, (high - _bot) / _zone)
                    bool _touched = bar_index > _bar and high >= _bot and low <= _top
                    bool _blk = f_fvgNearOppBullForBear(_top, _bot, _refI)
                    float _barRange = high - low
                    bool _bodyStrong  = not useFVGReboundStrictCandleSell or (_barRange > 0 and math.abs(close - open) >= _barRange * fvgReboundBodyMinRatioSell)
                    bool _closeNearLo = not useFVGReboundStrictCandleSell or (_barRange > 0 and (high - close) / _barRange >= fvgReboundCloseEdgeRatioSell)
                    bool _bearBar     = not useFVGReboundStrictCandleSell or close < open
                    bool _direct = _touched and _depth < fvgReboundConfirmDepthSell
                    bool _prevTouched = bar_index - 1 > _bar and high[1] >= _bot and low[1] <= _top
                    float _prevDepth  = math.max(0.0, (math.max(open[1], close[1]) - _bot) / _zone)
                    bool _deferred = _prevTouched and _prevDepth < fvgReboundConfirmDepthSell
                    if _conf and not _blk and (_direct or _deferred) and _bearBar and _closeNearLo and _bodyStrong
                        _rebSellIdx := i

    // 12. 確定 (吸収優先 > 反発)。単バーイベント + FVG使用済み。
    if _absBuyIdx != -1
        fvgAbsorbBuy := true
        array.set(bearAbsUsed, _absBuyIdx, true)
    if _absSellIdx != -1
        fvgAbsorbSell := true
        array.set(bullAbsUsed, _absSellIdx, true)
    bool _anyAbsorb = fvgAbsorbBuy or fvgAbsorbSell
    if _rebBuyIdx != -1 and not _anyAbsorb
        fvgReboundBuy := true
        array.set(bullRebUsed, _rebBuyIdx, true)
    if _rebSellIdx != -1 and not _anyAbsorb
        fvgReboundSell := true
        array.set(bearRebUsed, _rebSellIdx, true)

    // 13. iFVG (吸収済みFVGの後日リテスト。既存機能。吸収と別イベントで共存。useIFVGFilterで任意)
    if useIFVGFilter and _conf and array.size(bullTopArr) > 0
        for i = array.size(bullTopArr) - 1 to 0
            if not array.get(bullDeadArr, i) and array.get(bullAbsUsed, i)
                float _top = array.get(bullTopArr, i)
                float _bot = array.get(bullBotArr, i)
                if high >= _bot and close < open and close <= _top
                    ifvgSell := true
                    array.set(bullDeadArr, i, true)
    if useIFVGFilter and _conf and array.size(bearTopArr) > 0
        for i = array.size(bearTopArr) - 1 to 0
            if not array.get(bearDeadArr, i) and array.get(bearAbsUsed, i)
                float _top = array.get(bearTopArr, i)
                float _bot = array.get(bearBotArr, i)
                if low <= _top and close > open and close >= _bot
                    ifvgBuy := true
                    array.set(bearDeadArr, i, true)

    // 14. 前バーAccum状態の保存
    fvgIsAccumPrev := fvgIsAccum

// --- FVGイベントOK (そのバー限定) : 状態管理 OFF 時の従来判定に使う ---
bool longFVGEventOk =
     (useFVGReboundFilter    and fvgReboundBuy) or
     (useFVGAbsorptionFilter and fvgAbsorbBuy) or
     (useIFVGFilter          and ifvgBuy)

bool shortFVGEventOk =
     (useFVGReboundFilter    and fvgReboundSell) or
     (useFVGAbsorptionFilter and fvgAbsorbSell) or
     (useIFVGFilter          and ifvgSell)

// --- FVG状態管理 : イベント発生後、一定本数だけ「FVG条件OK」を保持 ---
//   反発・吸収・iFVG のいずれかが出たら状態ONにし、fvgStateMaxBars 本まで維持。
//   その期間内に包み足が出ればエントリー可能になる (シグナルの単バー限定を緩和)。
//   ※ 状態のセット/リセットのみ。FVG検出・反発・吸収・iFVG判定自体は不変。
var bool   longFVGStateOk    = false
var bool   shortFVGStateOk   = false
var int    longFVGStateBar   = na
var int    shortFVGStateBar  = na
if useFVGStateWindow
    // 1. イベント発生 → 状態ON
    if longFVGEventOk
        longFVGStateOk   := true
        longFVGStateBar  := bar_index
    if shortFVGEventOk
        shortFVGStateOk   := true
        shortFVGStateBar  := bar_index
    // 2. 有効期限切れ → 状態OFF
    if longFVGStateOk and not na(longFVGStateBar) and (bar_index - longFVGStateBar > fvgStateMaxBars)
        longFVGStateOk := false
    if shortFVGStateOk and not na(shortFVGStateBar) and (bar_index - shortFVGStateBar > fvgStateMaxBars)
        shortFVGStateOk := false

// 新Accum開始時はFVG状態保持もリセット (前フェーズの残存シグナルを持ち越さない)
if fvgResetStateNow
    longFVGStateOk  := false
    shortFVGStateOk := false

// --- 吸収後 方向ロック (USレンジ式) ---
//   fvgAbsorbBias : 0=制限なし / 1=BUYのみ / -1=SELLのみ / 2=両方向停止。
//   FVGがWinZoneに使われている(useFVGWZ)時だけ有効。FVG未使用/OFF時は他モジュールを制限しない。
bool allowLongByFVGBias  = fvgAbsorbBias == 0 or fvgAbsorbBias == 1
bool allowShortByFVGBias = fvgAbsorbBias == 0 or fvgAbsorbBias == -1

// --- FVG 場所フィルター条件 ---
//   useFVGFilter = false                          … 常に許可
//   useFVGFilter = true  かつ useFVGStateWindow=false … 従来のイベント単バー判定
//   useFVGFilter = true  かつ useFVGStateWindow=true  … 状態管理フラグを使う
//   さらに useFVGWZ の時のみ 方向ロック(bias) を AND する。
bool longFVGOk =
     not useFVGFilter or
     ((useFVGStateWindow ? longFVGStateOk : longFVGEventOk) and (not useFVGWZ or allowLongByFVGBias))

bool shortFVGOk =
     not useFVGFilter or
     ((useFVGStateWindow ? shortFVGStateOk : shortFVGEventOk) and (not useFVGWZ or allowShortByFVGBias))

// ============================================================
//  5b-2. 出来高 / VPVR / POC モジュール (WinZone 場所条件)
// ------------------------------------------------------------
//  FVG と同じ「場所条件」階層。useVolume=false の時は f_poc / 配列 /
//  ループ / ta系 / シグナル判定 を一切走らせない (軽量)。
//  パターン: A:POC定着 / B:POCリジェクト / C:出来高ブレイク / D:クライマックス反転
//  出力: longVolumeOk / shortVolumeOk (OFF時は false 固定)
// ============================================================

// 疑似 VPVR → POC 算出 (関数。呼ばれない時は実行されない = 軽量)
f_poc(lookback, bins) =>
    float hi = ta.highest(high, lookback)
    float lo = ta.lowest(low, lookback)
    float rangeAll = hi - lo
    float poc = close
    if rangeAll > 0 and bins > 0 and bar_index >= lookback
        array<float> bv = array.new_float(bins, 0.0)
        float bs = rangeAll / bins
        for k = 0 to lookback - 1
            float ch = high[k]
            float cl = low[k]
            float cv = volume[k]
            if not na(ch) and not na(cl) and not na(cv)
                float crange = ch - cl
                if crange <= 0
                    int bidx = math.max(0, math.min(bins - 1, int((cl - lo) / bs)))
                    array.set(bv, bidx, array.get(bv, bidx) + cv)
                else
                    for bi = 0 to bins - 1
                        float binBot = lo + bi * bs
                        float binTop = binBot + bs
                        float ov = math.min(binTop, ch) - math.max(binBot, cl)
                        if ov > 0
                            array.set(bv, bi, array.get(bv, bi) + cv * ov / crange)
        float best = -1.0
        int   bestI = 0
        for bi = 0 to bins - 1
            float v = array.get(bv, bi)
            if v > best
                best := v
                bestI := bi
        poc := lo + (bestI + 0.5) * bs
    poc

// 出力 (OFF時は false / na 固定)
bool  longVolumeOk  = false
bool  shortVolumeOk = false

if useVolume
    float v_atr     = ta.atr(volAtrLen)
    float v_rng     = high - low
    float v_body    = math.abs(close - open)
    float v_upWick  = high - math.max(close, open)
    float v_dnWick  = math.min(close, open) - low
    float v_clPos   = v_rng > 0 ? (close - low) / v_rng : 0.5
    float v_bodyRatio = v_rng > 0 ? v_body / v_rng : 0.0
    float v_volSMA  = ta.sma(volume, volumeSmaLen)
    float poc = f_poc(vpLookback, vpBins)
    float pw  = useVolAdaptivePOCWidth ? v_atr * pocZoneATRMult : pocZoneWidth
    float pUp = poc + pw
    float pLo = poc - pw
    bool  pocActive = not na(poc) and (pUp > pLo)
    float pocFull   = pUp - pLo

    // 共通フィルター
    bool liqOK = not useLowVolumeFilter or (not na(v_volSMA) and volume >= v_volSMA * lowVolumeMult)
    bool smaOK = not useVolumeSMAFilter or (not na(v_volSMA) and volume > v_volSMA)
    bool bOK   = not useBodyFilter or v_bodyRatio >= bodyRatioMin
    bool fOK   = liqOK and smaOK and bOK

    // A: POC アクセプタンス
    bool cameBelow = ta.lowest(close, crossLookback) <= pLo
    bool cameAbove = ta.highest(close, crossLookback) >= pUp
    bool accBuyConf  = (not useDirCandleForAcceptance or close > open) and (not useVolumeConfirmForAcceptance or (not na(v_volSMA) and volume > v_volSMA))
    bool accSellConf = (not useDirCandleForAcceptance or close < open) and (not useVolumeConfirmForAcceptance or (not na(v_volSMA) and volume > v_volSMA))
    var int abovePocCnt = 0
    var int belowPocCnt = 0
    abovePocCnt := close > pUp ? abovePocCnt + 1 : 0
    belowPocCnt := close < pLo ? belowPocCnt + 1 : 0
    bool accBuyCore  = pocActive and cameBelow and abovePocCnt >= acceptBars and accBuyConf
    bool accSellCore = pocActive and cameAbove and belowPocCnt >= acceptBars and accSellConf
    bool accBuyEvt   = accBuyCore  and not accBuyCore[1]
    bool accSellEvt  = accSellCore and not accSellCore[1]
    bool _accB = fOK and usePOCAcceptance and accBuyEvt
    bool _accS = fOK and usePOCAcceptance and accSellEvt
    bool buyAccept  = _accB and (not useFirstSignalOnly or not _accB[1])
    bool sellAccept = _accS and (not useFirstSignalOnly or not _accS[1])

    // B: POC リジェクト (押し目/戻り)
    bool trendL = not useTrendFilter or allowTrendLong
    bool trendS = not useTrendFilter or allowTrendShort
    bool rjTouchBuy = low <= pUp
    float rjDepthBuy = (low < pLo and pocFull > 0) ? (pLo - low) / pocFull : 0.0
    bool rjConfBuy = (not usePOCRejectCandleConfirm or close > open) and (not usePOCRejectWickConfirm or v_dnWick >= v_body) and (not usePOCRejectCloseEdgeConfirm or v_clPos >= 0.5)
    bool rejBuyCore = pocActive and rjTouchBuy and rjDepthBuy <= pocRejectDepthMax and close > pLo and rjConfBuy
    bool rjTouchSell = high >= pLo
    float rjDepthSell = (high > pUp and pocFull > 0) ? (high - pUp) / pocFull : 0.0
    bool rjConfSell = (not usePOCRejectCandleConfirm or close < open) and (not usePOCRejectWickConfirm or v_upWick >= v_body) and (not usePOCRejectCloseEdgeConfirm or v_clPos <= 0.5)
    bool rejSellCore = pocActive and rjTouchSell and rjDepthSell <= pocRejectDepthMax and close < pUp and rjConfSell
    bool _rejB = fOK and usePOCReject and trendL and rejBuyCore
    bool _rejS = fOK and usePOCReject and trendS and rejSellCore
    bool buyReject  = _rejB and (not useFirstSignalOnly or not _rejB[1])
    bool sellReject = _rejS and (not useFirstSignalOnly or not _rejS[1])

    // C: 出来高急増ブレイク (+圧縮→爆発)
    float rHigh = ta.highest(high, breakoutLookback)[1]
    float rLow  = ta.lowest(low,  breakoutLookback)[1]
    bool  volSpike  = not na(v_volSMA) and volume > v_volSMA * volumeSpikeMult
    bool  atrExpand = v_atr > nz(v_atr[breakoutLookback]) * atrExpansionMult
    bool  compressed = (ta.highest(high, compressionLookback) - ta.lowest(low, compressionLookback)) <= v_atr * compressionATRMult
    bool brkBuyCore  = not na(rHigh) and close > rHigh and volSpike and v_bodyRatio >= breakoutBodyRatioMin and (not useATRExpansionFilter or atrExpand) and (not useCompressionFilter or compressed[1])
    bool brkSellCore = not na(rLow)  and close < rLow  and volSpike and v_bodyRatio >= breakoutBodyRatioMin and (not useATRExpansionFilter or atrExpand) and (not useCompressionFilter or compressed[1])
    bool _brkB = fOK and useVolumeBreakout and brkBuyCore
    bool _brkS = fOK and useVolumeBreakout and brkSellCore
    bool buyBreak  = _brkB and (not useFirstSignalOnly or not _brkB[1])
    bool sellBreak = _brkS and (not useFirstSignalOnly or not _brkS[1])

    // D: クライマックス反転
    bool climaxVol = not na(v_volSMA) and volume > v_volSMA * climaxVolumeMult
    bool newLow  = low  <= ta.lowest(low,  climaxLookback)
    bool newHigh = high >= ta.highest(high, climaxLookback)
    bool climaxBuyCore  = climaxVol and v_rng > 0 and v_dnWick >= v_rng * climaxWickRatio and newLow  and v_clPos >= (1.0 - climaxCloseEdgeRatio)
    bool climaxSellCore = climaxVol and v_rng > 0 and v_upWick >= v_rng * climaxWickRatio and newHigh and v_clPos <= climaxCloseEdgeRatio
    bool _clmB = fOK and useClimaxReversal and climaxBuyCore
    bool _clmS = fOK and useClimaxReversal and climaxSellCore
    bool buyClimax  = _clmB and (not useFirstSignalOnly or not _clmB[1])
    bool sellClimax = _clmS and (not useFirstSignalOnly or not _clmS[1])

    // 統合 (優先: Climax(4) > Acceptance(1) > Breakout(3) > Reject(2))
    int vType = (buyClimax or sellClimax) ? 4 : (buyAccept or sellAccept) ? 1 : (buyBreak or sellBreak) ? 3 : (buyReject or sellReject) ? 2 : 0
    int vDir = vType == 4 ? (buyClimax ? 1 : -1) : vType == 1 ? (buyAccept ? 1 : -1) : vType == 3 ? (buyBreak ? 1 : -1) : vType == 2 ? (buyReject ? 1 : -1) : 0
    bool vSig = vType != 0

    longVolumeOk  := vSig and vDir == 1
    shortVolumeOk := vSig and vDir == -1

// --- 出来高 状態管理 : イベント発生後 volumeStateMaxBars 本だけ場所条件OKを保持 ---
//   FVG状態管理と同思想。longVolumeOk/shortVolumeOk は「イベント発生バー」として残し、
//   状態フラグで一定本数保持する。出来高イベント判定ロジック自体は不変。
var bool longVolumeStateOk   = false
var bool shortVolumeStateOk  = false
var int  longVolumeStateBar  = na
var int  shortVolumeStateBar = na

if useVolumeStateWindow
    if longVolumeOk
        longVolumeStateOk   := true
        longVolumeStateBar  := bar_index
    if shortVolumeOk
        shortVolumeStateOk   := true
        shortVolumeStateBar  := bar_index
    if longVolumeStateOk and not na(longVolumeStateBar) and bar_index - longVolumeStateBar > volumeStateMaxBars
        longVolumeStateOk := false
    if shortVolumeStateOk and not na(shortVolumeStateBar) and bar_index - shortVolumeStateBar > volumeStateMaxBars
        shortVolumeStateOk := false

// 出来高 場所条件 (状態管理ON=状態フラグ / OFF=イベント単バー / 出来高未使用=false)
bool longVolumeZoneOk =
     not useVolume ? false :
     useVolumeStateWindow ? longVolumeStateOk : longVolumeOk
bool shortVolumeZoneOk =
     not useVolume ? false :
     useVolumeStateWindow ? shortVolumeStateOk : shortVolumeOk

// ============================================================
//  5b-2b. フィボ WinZone モジュール (戻り売り/押し目買い・場所条件)
// ------------------------------------------------------------
//  FVG/出来高と同じ場所条件階層。useFibWZ=false の時は ta.pivot/atr/ema・
//  波計算・ランク・ゾーン・反転確認を一切走らせない (軽量)。
//  出力: fibBuySignal / fibSellSignal → longFibOk / shortFibOk
//        状態管理後 → longFibZoneOk / shortFibZoneOk
// ============================================================

// ランク判定関数 (pure。呼ばれない時は実行されない)
//   修正②: bufPct = ATRバッファをpct換算した許容幅。各ランク境界へ ±bufPct を織り込み、
//           「少し届かなかった/少し行き過ぎた」pct も同ランク扱いにする。
//           A/B/Cのランク範囲(input値)自体は不変。ATRを後段で見るのではなくランク判定に含める。
f_fibRank(float pct, float bufPct) =>
    int r = 0
    if not na(pct)
        if useRankA and pct >= fibAStart - bufPct and pct <= fibAEnd + bufPct
            r := 3
        else if useRankB and pct >= fibBStart - bufPct and pct < fibBEnd + bufPct
            r := 2
        else if useRankC and pct >= fibCStart - bufPct and pct < fibCEnd + bufPct
            r := 1
    r

// 出力 (if外で初期化)
bool fibBuySignal  = false
bool fibSellSignal = false
// 修正③: 無効条件フラグ (状態管理ブロックで即リセットに使用。if外で初期化)
bool fibInvalidBuy  = false
bool fibInvalidSell = false

if useFibWZ
    float _atr   = ta.atr(fibAtrLen)
    float _ema20 = ta.ema(close, fibEma20Len)
    float _ph = ta.pivothigh(high, swingLookback, swingLookback)
    float _pl = ta.pivotlow(low,  swingLookback, swingLookback)
    var float lastPH    = na
    var int   lastPHbar = na
    var float lastPL    = na
    var int   lastPLbar = na
    if not na(_ph)
        lastPH := _ph
        lastPHbar := bar_index - swingLookback
    if not na(_pl)
        lastPL := _pl
        lastPLbar := bar_index - swingLookback
    bool bothPivots = not na(lastPH) and not na(lastPL)
    // 下降波(高→安=SELL用) / 上昇波(安→高=BUY用)
    bool downWaveValid = bothPivots and (lastPHbar < lastPLbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPHbar) <= waveLookback)
    bool upWaveValid   = bothPivots and (lastPLbar < lastPHbar) and ((lastPH - lastPL) >= _atr * minWaveATR) and ((bar_index - lastPLbar) <= waveLookback)
    float sSwingHigh = lastPH
    float sSwingLow  = lastPL
    float sRange = sSwingHigh - sSwingLow
    float bSwingHigh = lastPH
    float bSwingLow  = lastPL
    float bRange = bSwingHigh - bSwingLow
    // ATRバッファ (価格) と各波でのpct換算。修正②: ランク判定へATRを織り込むため先に算出。
    float buf = _atr * fibZoneBufferATR
    float sBufPct = sRange > 0 ? buf / sRange : 0.0
    float bBufPct = bRange > 0 ? buf / bRange : 0.0
    // 修正①: ランク判定(場所条件)は終値ではなく SELL=high / BUY=low で測る (ヒゲ到達を検知)
    float sRetracePct = downWaveValid and sRange > 0 ? math.max(0.0, math.min(1.0, (high - sSwingLow) / sRange)) : na
    float bRetracePct = upWaveValid and bRange > 0 ? math.max(0.0, math.min(1.0, (bSwingHigh - low) / bRange)) : na
    // 修正②: ATRバッファ込みでランク判定 (ランク後にATRを見るのではなくATR込みで判定)
    int sRank = f_fibRank(sRetracePct, sBufPct)
    int bRank = f_fibRank(bRetracePct, bBufPct)
    // ゾーン価格レベル
    float sZoneLowPrice  = sSwingLow + fibCStart * sRange
    float sZoneHighPrice = sSwingLow + fibAEnd   * sRange
    float sDeepLimit     = sSwingLow + fibAEnd   * sRange
    float bZoneHighPrice = bSwingHigh - fibCStart * bRange
    float bZoneLowPrice  = bSwingHigh - fibAEnd   * bRange
    float bDeepLimit     = bSwingHigh - fibAEnd   * bRange
    bool priceInSellZone = downWaveValid and sRank > 0 and (high >= sZoneLowPrice - buf) and (low <= sZoneHighPrice + buf)
    bool priceInBuyZone  = upWaveValid   and bRank > 0 and (low <= bZoneHighPrice + buf) and (high >= bZoneLowPrice - buf)
    // 反転確認
    float _body     = math.abs(close - open)
    float _bodyPrev = math.abs(close[1] - open[1])
    float _upWick   = high - math.max(close, open)
    float _loWick   = math.min(close, open) - low
    bool _bearCandle   = close < open
    bool _upPinbar     = _body > 0 and _upWick >= pinbarWickRatio * _body and _upWick > _loWick
    bool _fibBearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1] and _body >= engulfingBodyRatio * _bodyPrev
    bool _breakPrevLow = low < low[1]
    bool sellConfirm = (useCandleConfirm and _bearCandle) or (usePinbarConfirm and _upPinbar) or (useEngulfingConfirm and _fibBearEngulf) or (useEma20Confirm and close < _ema20) or (useBreakPrevConfirm and _breakPrevLow)
    bool _bullCandle   = close > open
    bool _dnPinbar     = _body > 0 and _loWick >= pinbarWickRatio * _body and _loWick > _upWick
    bool _fibBullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1] and _body >= engulfingBodyRatio * _bodyPrev
    bool _breakPrevHigh = high > high[1]
    bool buyConfirm = (useCandleConfirm and _bullCandle) or (usePinbarConfirm and _dnPinbar) or (useEngulfingConfirm and _fibBullEngulf) or (useEma20Confirm and close > _ema20) or (useBreakPrevConfirm and _breakPrevHigh)
    // 無効条件
    bool invSell = downWaveValid and ((useDeepLimitInvalid and close > sDeepLimit) or (useOriginInvalid and close > sSwingHigh) or (useEMASettleInvalid and close > _ema20 and close[1] > _ema20))
    bool invBuy  = upWaveValid   and ((useDeepLimitInvalid and close < bDeepLimit) or (useOriginInvalid and close < bSwingLow)  or (useEMASettleInvalid and close < _ema20 and close[1] < _ema20))
    // 修正③: 無効条件を状態管理へ伝搬 (成立で即リセットするため外部スコープへコピー)
    fibInvalidSell := invSell
    fibInvalidBuy  := invBuy
    bool confirmedOK = not requireConfirmedBar or barstate.isconfirmed
    bool sellSetup = useFibSell and priceInSellZone and not invSell
    bool buySetup  = useFibBuy  and priceInBuyZone  and not invBuy
    bool _fibSellSig = sellSetup and (not useRejectConfirm or sellConfirm) and confirmedOK
    bool _fibBuySig  = buySetup  and (not useRejectConfirm or buyConfirm)  and confirmedOK
    // 出力へ反映
    fibSellSignal := _fibSellSig
    fibBuySignal  := _fibBuySig

// 接続: BUYシグナル→longFibOk / SELLシグナル→shortFibOk (反転確認込み)
bool longFibOk  = fibBuySignal
bool shortFibOk = fibSellSignal

// --- フィボ 状態管理 (FVG/出来高と同思想。イベント後 一定本数保持) ---
var bool longFibStateOk   = false
var bool shortFibStateOk  = false
var int  longFibStateBar  = na
var int  shortFibStateBar = na

if useFibWZ and useFibStateWindow
    if fibBuySignal
        longFibStateOk   := true
        longFibStateBar  := bar_index
    if fibSellSignal
        shortFibStateOk   := true
        shortFibStateBar  := bar_index
    if longFibStateOk and not na(longFibStateBar) and bar_index - longFibStateBar > fibStateMaxBars
        longFibStateOk := false
    if shortFibStateOk and not na(shortFibStateBar) and bar_index - shortFibStateBar > fibStateMaxBars
        shortFibStateOk := false
    // 修正③: 無効条件成立で即リセット (状態保持より無効条件を優先。timeout待ちにしない)
    if fibInvalidBuy
        longFibStateOk  := false
        longFibStateBar := na
    if fibInvalidSell
        shortFibStateOk  := false
        shortFibStateBar := na

// フィボ 場所条件 (状態管理ON=状態フラグ / OFF=シグナル単バー / 未使用=false)
bool longFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? longFibStateOk : fibBuySignal
bool shortFibZoneOk =
     not useFibWZ ? false :
     useFibStateWindow ? shortFibStateOk : fibSellSignal

// ============================================================
//  5b-2e. EMA WinZone モジュール (MTF: 1M/5M/15M/1H/4H を反応価格帯として)
// ------------------------------------------------------------
//  EMA は Bias ではなく Zone。上だからロング等の方向制限はしない。
//  各時間足 ON/OFF・各EMA種類 ON/OFF。OFFの時間足は request.security を呼ばない。
//  出力: emaLongWinZone / emaShortWinZone / emaNoTrade / emaSignalType / emaRank /
//        emaHitTF (1/5/15/60/240) / emaHitMA (200/600/1000/2000/3000)
//  ・useEMAWZ=false の時は EMA計算・ATR・security・状態管理 を一切実行しない。
//  ※ security本数節約のため各TFで5EMA+ATRを1タプルで取得。EMA種類OFFは判定側で除外。
// ============================================================

// 参照TF内で 5本のEMA + ATR + 5本の傾き(EMA - N本前EMA) を一括計算 (security 1回で取得)。
//   傾きは各参照TF上の同一EMA系列の差分 = 「参照TF基準の N本前比較」。
//   ※ 同じEMA系列から差分を取るため上位足EMA値が複数チャート足へ複製されても正しく評価される。
f_emaTFBundle() =>
    float _e1 = ta.ema(emaSource, emaLen1)
    float _e2 = ta.ema(emaSource, emaLen2)
    float _e3 = ta.ema(emaSource, emaLen3)
    float _e4 = ta.ema(emaSource, emaLen4)
    float _e5 = ta.ema(emaSource, emaLen5)
    float _a  = ta.atr(emaAtrLen)
    float _s1 = _e1 - _e1[emaWZSlopeLookback]
    float _s2 = _e2 - _e2[emaWZSlopeLookback]
    float _s3 = _e3 - _e3[emaWZSlopeLookback]
    float _s4 = _e4 - _e4[emaWZSlopeLookback]
    float _s5 = _e5 - _e5[emaWZSlopeLookback]
    [_e1, _e2, _e3, _e4, _e5, _a, _s1, _s2, _s3, _s4, _s5]

// 1つの時間足の EMA(5本)+ATR+傾き(5本) を取得し、反発判定と帯レベルを返す (pure + levels配列に追記)。
//   返り値: [bounceLong, bounceShort, hitMALong, hitMAShort, slopeLongHit, slopeShortHit]。OFFのTFは security を呼ばない。
//   傾きフィルター (useEMABounceSlopeFilter) は「反発シグナルのみ」に適用。SR転換/帯リテストは別処理で不変。
f_emaTFEval(bool _tfOn, string _tf, array<float> _levels) =>
    float _e1 = na
    float _e2 = na
    float _e3 = na
    float _e4 = na
    float _e5 = na
    float _atr = na
    float _s1 = na
    float _s2 = na
    float _s3 = na
    float _s4 = na
    float _s5 = na
    if _tfOn
        [_v1, _v2, _v3, _v4, _v5, _v6, _vs1, _vs2, _vs3, _vs4, _vs5] = request.security(syminfo.tickerid, _tf, f_emaTFBundle(), lookahead = barmerge.lookahead_off)
        _e1 := _v1
        _e2 := _v2
        _e3 := _v3
        _e4 := _v4
        _e5 := _v5
        _atr := _v6
        _s1 := _vs1
        _s2 := _vs2
        _s3 := _vs3
        _s4 := _vs4
        _s5 := _vs5
    float _touch = emaTouchMode == "ATR" ? _atr * emaTouchATRMult : emaTouchDollar
    // 傾きOK (反発のみ)。OFFなら常に true (挙動不変)。ON時は履歴不足(na)なら不許可。
    //   ロング=上向き(slope>=min) / ショート=下向き(slope<=-min)。各EMA自身の傾きで判定。
    bool _slL1 = not useEMABounceSlopeFilter or (not na(_s1) and _s1 >=  emaWZSlopeMin)
    bool _slL2 = not useEMABounceSlopeFilter or (not na(_s2) and _s2 >=  emaWZSlopeMin)
    bool _slL3 = not useEMABounceSlopeFilter or (not na(_s3) and _s3 >=  emaWZSlopeMin)
    bool _slL4 = not useEMABounceSlopeFilter or (not na(_s4) and _s4 >=  emaWZSlopeMin)
    bool _slL5 = not useEMABounceSlopeFilter or (not na(_s5) and _s5 >=  emaWZSlopeMin)
    bool _slS1 = not useEMABounceSlopeFilter or (not na(_s1) and _s1 <= -emaWZSlopeMin)
    bool _slS2 = not useEMABounceSlopeFilter or (not na(_s2) and _s2 <= -emaWZSlopeMin)
    bool _slS3 = not useEMABounceSlopeFilter or (not na(_s3) and _s3 <= -emaWZSlopeMin)
    bool _slS4 = not useEMABounceSlopeFilter or (not na(_s4) and _s4 <= -emaWZSlopeMin)
    bool _slS5 = not useEMABounceSlopeFilter or (not na(_s5) and _s5 <= -emaWZSlopeMin)
    // BUY反発: low が EMA に触れ close が EMA上 / SELL反発: high が EMA に触れ close が EMA下 (+ 傾きOK)
    bool _bl1 = _tfOn and useEMA1Zone and not na(_e1) and low <= _e1 + _touch and close > _e1 and close > open and _slL1
    bool _bl2 = _tfOn and useEMA2Zone and not na(_e2) and low <= _e2 + _touch and close > _e2 and close > open and _slL2
    bool _bl3 = _tfOn and useEMA3Zone and not na(_e3) and low <= _e3 + _touch and close > _e3 and close > open and _slL3
    bool _bl4 = _tfOn and useEMA4Zone and not na(_e4) and low <= _e4 + _touch and close > _e4 and close > open and _slL4
    bool _bl5 = _tfOn and useEMA5Zone and not na(_e5) and low <= _e5 + _touch and close > _e5 and close > open and _slL5
    bool _bs1 = _tfOn and useEMA1Zone and not na(_e1) and high >= _e1 - _touch and close < _e1 and close < open and _slS1
    bool _bs2 = _tfOn and useEMA2Zone and not na(_e2) and high >= _e2 - _touch and close < _e2 and close < open and _slS2
    bool _bs3 = _tfOn and useEMA3Zone and not na(_e3) and high >= _e3 - _touch and close < _e3 and close < open and _slS3
    bool _bs4 = _tfOn and useEMA4Zone and not na(_e4) and high >= _e4 - _touch and close < _e4 and close < open and _slS4
    bool _bs5 = _tfOn and useEMA5Zone and not na(_e5) and high >= _e5 - _touch and close < _e5 and close < open and _slS5
    // 帯用: ON の EMA レベルを配列へ追記 (BandTop/Bottom を後で算出)
    if _tfOn and useEMA1Zone and not na(_e1)
        array.push(_levels, _e1)
    if _tfOn and useEMA2Zone and not na(_e2)
        array.push(_levels, _e2)
    if _tfOn and useEMA3Zone and not na(_e3)
        array.push(_levels, _e3)
    if _tfOn and useEMA4Zone and not na(_e4)
        array.push(_levels, _e4)
    if _tfOn and useEMA5Zone and not na(_e5)
        array.push(_levels, _e5)
    bool _bLong  = _bl1 or _bl2 or _bl3 or _bl4 or _bl5
    bool _bShort = _bs1 or _bs2 or _bs3 or _bs4 or _bs5
    [_bLong, _bShort]

// --- EMA WinZone 出力 (if外で初期化) ---
bool emaLongEventOk  = false
bool emaShortEventOk = false
bool emaNoTrade      = false

// 帯ブレイクの保持 (var)
var int emaBandBreakUpBar = na
var int emaBandBreakDnBar = na

if useEMAWZ
    array<float> _emaLevels = array.new_float()
    [_bl1m,  _bs1m]  = f_emaTFEval(useEMA1M,  tfEMA1M,  _emaLevels)
    [_bl5m,  _bs5m]  = f_emaTFEval(useEMA5M,  tfEMA5M,  _emaLevels)
    [_bl15m, _bs15m] = f_emaTFEval(useEMA15M, tfEMA15M, _emaLevels)
    [_bl1h,  _bs1h]  = f_emaTFEval(useEMA1H,  tfEMA1H,  _emaLevels)
    [_bl4h,  _bs4h]  = f_emaTFEval(useEMA4H,  tfEMA4H,  _emaLevels)
    // --- 反発 (どのTFでも反応すればOK) ---
    bool emaBounceLong  = _bl1m or _bl5m or _bl15m or _bl1h or _bl4h
    bool emaBounceShort = _bs1m or _bs5m or _bs15m or _bs1h or _bs4h
    // --- 帯 (全ON TF × 全ON EMA のレベルで BandTop / BandBottom) ---
    //   空配列で array.max/min を呼ぶとエラーになるため if でガード。
    float emaBandTop    = na
    float emaBandBottom = na
    if array.size(_emaLevels) > 0
        emaBandTop    := array.max(_emaLevels)
        emaBandBottom := array.min(_emaLevels)
    bool emaBandValid  = not na(emaBandTop) and not na(emaBandBottom)
    bool aboveEMABand  = emaBandValid and close > emaBandTop
    bool belowEMABand  = emaBandValid and close < emaBandBottom
    bool insideEMABand = emaBandValid and not aboveEMABand and not belowEMABand
    // --- 帯抜けリテスト (チャート足の反応。接近幅はチャートATR) ---
    float _chartAtr  = ta.atr(emaAtrLen)
    float _bandTouch = emaTouchMode == "ATR" ? _chartAtr * emaTouchATRMult : emaTouchDollar
    float _emaBody   = math.abs(close - open)
    float _emaUpWick = high - math.max(open, close)
    float _emaDnWick = math.min(open, close) - low
    bool _emaBullRev = (close > open and close[1] < open[1] and close >= open[1] and open <= close[1]) or (_emaDnWick >= _emaBody and _emaDnWick >= _emaUpWick) or close > open
    bool _emaBearRev = (close < open and close[1] > open[1] and close <= open[1] and open >= close[1]) or (_emaUpWick >= _emaBody and _emaUpWick >= _emaDnWick) or close < open
    if aboveEMABand and not nz(aboveEMABand[1], false)
        emaBandBreakUpBar := bar_index
    if belowEMABand and not nz(belowEMABand[1], false)
        emaBandBreakDnBar := bar_index
    bool emaBandRetestLong  = useEMABandRetest and emaBandValid and not na(emaBandBreakUpBar) and (bar_index - emaBandBreakUpBar) <= emaBandRetestBars and low <= emaBandTop + _bandTouch and close > emaBandTop and _emaBullRev
    bool emaBandRetestShort = useEMABandRetest and emaBandValid and not na(emaBandBreakDnBar) and (bar_index - emaBandBreakDnBar) <= emaBandRetestBars and high >= emaBandBottom - _bandTouch and close < emaBandBottom and _emaBearRev
    // --- SR転換 (MTF未対応。初期は無効。useEMASRFlipSig 既定OFF) ---
    bool emaSRFlipLong  = false
    bool emaSRFlipShort = false
    // --- WinZone イベント (Zone = 場所反応。方向はローソク反応から決まる) ---
    bool _emaRawLong  = (useEMABounce and emaBounceLong)  or emaBandRetestLong  or emaSRFlipLong
    bool _emaRawShort = (useEMABounce and emaBounceShort) or emaBandRetestShort or emaSRFlipShort
    emaNoTrade := useEMAInsideNoTrade and insideEMABand
    emaLongEventOk  := _emaRawLong  and not emaNoTrade
    emaShortEventOk := _emaRawShort and not emaNoTrade

// --- EMA 状態管理 (FVG/Volume/Fib/Line と同思想) ---
var bool emaLongState     = false
var bool emaShortState    = false
var int  emaLongStateBar  = na
var int  emaShortStateBar = na

if useEMAWZ and useEMAStateWindow
    if emaLongEventOk
        emaLongState    := true
        emaLongStateBar := bar_index
    if emaShortEventOk
        emaShortState    := true
        emaShortStateBar := bar_index
    if emaLongState and not na(emaLongStateBar) and bar_index - emaLongStateBar > emaStateMaxBars
        emaLongState := false
    if emaShortState and not na(emaShortStateBar) and bar_index - emaShortStateBar > emaStateMaxBars
        emaShortState := false

// EMA WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool emaLongWinZone  = useEMAWZ ? (useEMAStateWindow ? emaLongState  : emaLongEventOk)  : false
bool emaShortWinZone = useEMAWZ ? (useEMAStateWindow ? emaShortState : emaShortEventOk) : false

// ============================================================
//  5b-2f. 水平線 WinZone モジュール (レジサポを反応する場所として)
// ------------------------------------------------------------
//  Pivot / 複数回反応 / 前日H・L / セッションH・L を統合ゾーン化し、
//  反発 / レジサポ転換 / ブレイク / スイープ反転 を場所条件(Zone)として使う。
//  水平線は Bias ではなく Zone。反応したら WinZone。方向はローソク反応から。
//  ・useLineWZ=false の時は ta.*・配列・前日/セッション更新・各判定・描画 を
//    一切実行しない (全処理を if useLineWZ の中に閉じ込める)。
// ============================================================

// --- 統合水平線ゾーン配列 (var: 状態保持。操作は if useLineWZ 内のみ) ---
var array<float> zPrice   = array.new_float()
var array<int>   zTouch   = array.new_int()
var array<int>   zCreated = array.new_int()
var array<int>   zLast    = array.new_int()
var array<bool>  zPivot   = array.new_bool()
var array<bool>  zPrev    = array.new_bool()
var array<bool>  zSess    = array.new_bool()
var array<int>   zTF      = array.new_int()   // どの時間足由来か (1/5/15/60/240、0=前日/セッション)
var array<bool>  zBreakUsed  = array.new_bool()  // ブレイク改善: この水平線が既にブレイク確定済みか (方向共通1回)
var array<int>   zSessionDay = array.new_int()   // ブレイク改善: 生成日 (セッション水平線の有効日数判定用の連番)
var array<int>   zId         = array.new_int()   // ブレイク改善: 水平線の固有ID (配列shift/removeでindexがずれても追跡可能)
var array<int>   zIdCounter  = array.new_int(1, 0)  // ブレイク改善: 次に払い出す固有ID (関数内で書換えるため1要素配列)
var int          sessDayCounter = 0              // ブレイク改善: セッション水平線 有効日数用の連番
// ブレイク改善: 確定待ち (pending) を方向別に固有IDで管理。
//  index同士が対応: pendingUpZoneIds[k] のゾーンは pendingUpThresholds[k] を固定基準、
//  pendingUpCounts[k] 本連続で外側に残れば確定。
var array<int>   pendingUpZoneIds    = array.new_int()
var array<float> pendingUpThresholds = array.new_float()
var array<int>   pendingUpCounts     = array.new_int()
var array<int>   pendingDnZoneIds    = array.new_int()
var array<float> pendingDnThresholds = array.new_float()
var array<int>   pendingDnCounts     = array.new_int()

// 共通フィルター (ローソク品質)。呼ばれない時は実行されない。
f_lineCommonOK(bool isBuy, float _atr) =>
    float _rng  = high - low
    float _body = math.abs(close - open)
    float _upW  = high - math.max(close, open)
    float _dnW  = math.min(close, open) - low
    float _bRatio = _rng > 0 ? _body / _rng : 0.0
    bool _ok = true
    if useLineDirCandleFilter
        _ok := _ok and (isBuy ? close > open : close < open)
    if useLineWickFilter
        _ok := _ok and (isBuy ? _dnW >= _body : _upW >= _body)
    if useLineBodyFilter
        _ok := _ok and _bRatio >= lineBodyRatioMin
    if useLineATRFilter
        _ok := _ok and _rng >= _atr * lineAtrMinMult
    _ok

// ゾーンへ追加/統合 (srcPivot/srcPrev/srcSess のいずれか1つを true で渡す。_tfCode=由来TF)
f_lineAddZone(float p, bool srcPivot, bool srcPrev, bool srcSess, int _tfCode, float _mergeTol, int _sessDay) =>
    bool _found = false
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not _found and math.abs(array.get(zPrice, i) - p) <= _mergeTol
                int _oldT = array.get(zTouch, i)
                int _newT = _oldT + 1
                array.set(zPrice, i, (array.get(zPrice, i) * _oldT + p) / _newT)
                array.set(zTouch, i, _newT)
                array.set(zLast,  i, bar_index)
                array.set(zPivot, i, array.get(zPivot, i) or srcPivot)
                array.set(zPrev,  i, array.get(zPrev,  i) or srcPrev)
                array.set(zSess,  i, array.get(zSess,  i) or srcSess)
                array.set(zTF,    i, math.max(array.get(zTF, i), _tfCode))   // 統合時は上位TFを採用
                // 統合時: 生成日は再タッチで更新 (セッション水平線を延命)。ブレイク済みフラグは維持。
                array.set(zSessionDay, i, math.max(array.get(zSessionDay, i), _sessDay))
                _found := true
    if not _found
        array.push(zPrice, p)
        array.push(zTouch, 1)
        array.push(zCreated, bar_index)
        array.push(zLast, bar_index)
        array.push(zPivot, srcPivot)
        array.push(zPrev,  srcPrev)
        array.push(zSess,  srcSess)
        array.push(zTF,    _tfCode)
        array.push(zBreakUsed,  false)
        array.push(zSessionDay, _sessDay)
        int _newId = array.get(zIdCounter, 0) + 1   // 配列mutationはfunction内でも許可される
        array.set(zIdCounter, 0, _newId)
        array.push(zId, _newId)   // 新規ゾーンにのみ固有IDを払い出す (統合時は既存IDを維持)
        if array.size(zPrice) > lineMaxZones
            array.shift(zPrice)
            array.shift(zTouch)
            array.shift(zCreated)
            array.shift(zLast)
            array.shift(zPivot)
            array.shift(zPrev)
            array.shift(zSess)
            array.shift(zTF)
            array.shift(zBreakUsed)
            array.shift(zSessionDay)
            array.shift(zId)

// MTF Pivot 取得 → ゾーン追加 (ONのTFだけ request.security を呼ぶ)
f_lineAddTFPivots(bool _tfOn, string _tf, int _tfCode, float _mergeTol, int _sessDay) =>
    if _tfOn
        [_ph, _pl] = request.security(syminfo.tickerid, _tf, [ta.pivothigh(linePivotLen, linePivotLen), ta.pivotlow(linePivotLen, linePivotLen)], lookahead = barmerge.lookahead_off)
        if not na(_ph) and (na(_ph[1]) or _ph != _ph[1])
            f_lineAddZone(_ph, true, false, false, _tfCode, _mergeTol, _sessDay)
        if not na(_pl) and (na(_pl[1]) or _pl != _pl[1])
            f_lineAddZone(_pl, true, false, false, _tfCode, _mergeTol, _sessDay)

// ブレイク改善: ゾーンのソースがONか (ブレイク候補判定用)
f_lineSourceOn(bool _ip, bool _ipr, bool _iss) =>
    (_ip and (usePivotLine or useReactionLine)) or (_ipr and usePreviousDayHL) or (_iss and useSessionHL)

// ブレイク改善: 固有IDから現在の配列インデックスを検索 (なければ na)
f_findZoneIndexById(int _id) =>
    int _idx = na
    if array.size(zId) > 0
        for i = 0 to array.size(zId) - 1
            if array.get(zId, i) == _id
                _idx := i
                break
    _idx

// ブレイク改善: int配列に指定IDが含まれるか
f_idInArray(array<int> _arr, int _id) =>
    bool _f = false
    if array.size(_arr) > 0
        for i = 0 to array.size(_arr) - 1
            if array.get(_arr, i) == _id
                _f := true
                break
    _f

// ブレイク改善: 指定IDのゾーンが今もブレイク確定に有効かを判定し、有効なら現在indexを返す
//  (存在する / 未ブレイク / ソースON / セッション日数制限内)。無効なら na。
f_lineBreakValidIdx(int _id) =>
    int _idx = f_findZoneIndexById(_id)
    int _res = na
    if not na(_idx)
        bool _iss = array.get(zSess, _idx)
        bool _ipv = array.get(zPivot, _idx)
        bool _ipr = array.get(zPrev, _idx)
        bool _pureSess = _iss and not _ipv and not _ipr
        bool _sessOK = not _pureSess or (array.get(zSessionDay, _idx) >= sessDayCounter - (lineSessionMaxDays - 1))
        if not array.get(zBreakUsed, _idx) and f_lineSourceOn(_ipv, _ipr, _iss) and _sessOK
            _res := _idx
    _res

// ブレイク改善: 方向別 pending を完全クリア (Break OFF / モジュールOFF 時)
f_clearPendingUp() =>
    if array.size(pendingUpZoneIds) > 0
        array.clear(pendingUpZoneIds)
        array.clear(pendingUpThresholds)
        array.clear(pendingUpCounts)
f_clearPendingDn() =>
    if array.size(pendingDnZoneIds) > 0
        array.clear(pendingDnZoneIds)
        array.clear(pendingDnThresholds)
        array.clear(pendingDnCounts)

// セッション 高値/安値 追跡
f_lineSession(string sessStr, float prevHi, float prevLo) =>
    bool _inSess  = not na(time(timeframe.period, sessStr, lineSessTZ))
    bool _started = _inSess and not _inSess[1]
    bool _ended   = not _inSess and _inSess[1]
    float _hi = prevHi
    float _lo = prevLo
    if _started
        _hi := high
        _lo := low
    else if _inSess
        _hi := na(prevHi) ? high : math.max(prevHi, high)
        _lo := na(prevLo) ? low  : math.min(prevLo, low)
    [_hi, _lo, _ended]

// --- 水平線 出力 (if外で初期化) ---
bool  lineRawLong        = false
bool  lineRawShort       = false
float nearestSupport     = na
float nearestResistance  = na
bool  lineNoTradeLong    = false
bool  lineNoTradeShort   = false
bool  lineNoTrade        = false

// 前日 / セッション / Flip 状態 (var: バー跨ぎ保持。更新は if useLineWZ 内のみ)
var float curDayHigh = na
var float curDayLow  = na
var float prevHigh   = na
var float prevLow    = na
var float asiaHigh   = na
var float asiaLow    = na
var float londonHigh = na
var float londonLow  = na
var float nyHigh     = na
var float nyLow      = na
var float flipResLevel = na
var int   flipResBar   = na
var float flipSupLevel = na
var int   flipSupBar   = na

if useLineWZ
    float lineAtr = ta.atr(lineAtrLen)
    float lineZoneW = useLineATRZone ? lineAtr * lineZoneATRMult : lineZoneFixedWidth
    float _mergeTol = useLineMergeZone ? lineAtr * lineMergeToleranceATR : lineAtr * reactionToleranceATR
    // ブレイク改善: セッションTZ基準の暦日変化で連番を増やす (セッション水平線の有効日数判定用)
    int _dayId = year(time, lineSessTZ) * 10000 + month(time, lineSessTZ) * 100 + dayofmonth(time, lineSessTZ)
    if not na(_dayId[1]) and _dayId != _dayId[1]
        sessDayCounter := sessDayCounter + 1
    // ① MTF Pivot High/Low → ゾーン (ONのTFだけ request.security)
    if usePivotLine or useReactionLine
        f_lineAddTFPivots(useLine1M,  tfLine1M,  1,   _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine5M,  tfLine5M,  5,   _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine15M, tfLine15M, 15,  _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine1H,  tfLine1H,  60,  _mergeTol, sessDayCounter)
        f_lineAddTFPivots(useLine4H,  tfLine4H,  240, _mergeTol, sessDayCounter)
    // ③ 前日 高値/安値 (チャート基準。TFコード0)
    bool _newDay = ta.change(time("D")) != 0
    if _newDay
        prevHigh := curDayHigh
        prevLow  := curDayLow
        curDayHigh := high
        curDayLow  := low
        if usePreviousDayHL and not na(prevHigh)
            f_lineAddZone(prevHigh, false, true, false, 0, _mergeTol, sessDayCounter)
        if usePreviousDayHL and not na(prevLow)
            f_lineAddZone(prevLow, false, true, false, 0, _mergeTol, sessDayCounter)
    else
        curDayHigh := na(curDayHigh) ? high : math.max(curDayHigh, high)
        curDayLow  := na(curDayLow)  ? low  : math.min(curDayLow, low)
    // ④ セッション 高値/安値
    [_aH, _aL, _aEnd] = f_lineSession(lineAsiaSess, asiaHigh, asiaLow)
    asiaHigh := _aH
    asiaLow  := _aL
    [_lH, _lL, _lEnd] = f_lineSession(lineLondonSess, londonHigh, londonLow)
    londonHigh := _lH
    londonLow  := _lL
    [_nH, _nL, _nEnd] = f_lineSession(lineNySess, nyHigh, nyLow)
    nyHigh := _nH
    nyLow  := _nL
    if useSessionHL
        if _aEnd and not na(asiaHigh)
            f_lineAddZone(asiaHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _aEnd and not na(asiaLow)
            f_lineAddZone(asiaLow, false, false, true, 0, _mergeTol, sessDayCounter)
        if _lEnd and not na(londonHigh)
            f_lineAddZone(londonHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _lEnd and not na(londonLow)
            f_lineAddZone(londonLow, false, false, true, 0, _mergeTol, sessDayCounter)
        if _nEnd and not na(nyHigh)
            f_lineAddZone(nyHigh, false, false, true, 0, _mergeTol, sessDayCounter)
        if _nEnd and not na(nyLow)
            f_lineAddZone(nyLow, false, false, true, 0, _mergeTol, sessDayCounter)
    // ⑤ ブレイク改善: 純セッション水平線 (Pivot/PrevDay を持たない) は有効日数を超えたら削除
    //    (Pivot/Reaction/PrevDay ソースには適用しない。全メタ配列を同一indexで remove)
    if array.size(zPrice) > 0
        for i = array.size(zPrice) - 1 to 0
            bool _pureSess = array.get(zSess, i) and not array.get(zPivot, i) and not array.get(zPrev, i)
            if _pureSess and array.get(zSessionDay, i) < sessDayCounter - (lineSessionMaxDays - 1)
                array.remove(zPrice, i)
                array.remove(zTouch, i)
                array.remove(zCreated, i)
                array.remove(zLast, i)
                array.remove(zPivot, i)
                array.remove(zPrev, i)
                array.remove(zSess, i)
                array.remove(zTF, i)
                array.remove(zBreakUsed, i)
                array.remove(zSessionDay, i)
                array.remove(zId, i)
    // 最近接 Support(<=close) / Resistance(>=close)
    int  _nsCreated = na
    int  _nrCreated = na
    if array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if bar_index >= array.get(zCreated, i)
                float _pr = array.get(zPrice, i)
                if _pr <= close
                    if na(nearestSupport) or _pr > nearestSupport
                        nearestSupport := _pr
                        _nsCreated := array.get(zCreated, i)
                if _pr >= close
                    if na(nearestResistance) or _pr < nearestResistance
                        nearestResistance := _pr
                        _nrCreated := array.get(zCreated, i)
    float _supZoneTop = nearestSupport + lineZoneW
    float _resZoneBot = nearestResistance - lineZoneW
    bool _supUsable = not na(nearestSupport)    and not na(_nsCreated) and bar_index >= _nsCreated
    bool _resUsable = not na(nearestResistance) and not na(_nrCreated) and bar_index >= _nrCreated
    // A: 反発
    bool _buyBounce  = useLineBounce and _supUsable and low  <= _supZoneTop and close > nearestSupport    and f_lineCommonOK(true, lineAtr)
    bool _sellBounce = useLineBounce and _resUsable and high >= _resZoneBot and close < nearestResistance and f_lineCommonOK(false, lineAtr)
    // B: レジサポ転換 (Flip)
    if _resUsable and not na(nearestResistance[1]) and close > nearestResistance[1] and close[1] <= nearestResistance[1]
        flipResLevel := nearestResistance[1]
        flipResBar   := bar_index
    if _supUsable and not na(nearestSupport[1]) and close < nearestSupport[1] and close[1] >= nearestSupport[1]
        flipSupLevel := nearestSupport[1]
        flipSupBar   := bar_index
    bool _buyFlip  = useLineFlip and not na(flipResLevel) and (bar_index - flipResBar) >= lineFlipConfirmBars and (bar_index - flipResBar) <= lineFlipLookback and low <= flipResLevel + lineZoneW and close > flipResLevel and f_lineCommonOK(true, lineAtr)
    bool _sellFlip = useLineFlip and not na(flipSupLevel) and (bar_index - flipSupBar) >= lineFlipConfirmBars and (bar_index - flipSupBar) <= lineFlipLookback and high >= flipSupLevel - lineZoneW and close < flipSupLevel and f_lineCommonOK(false, lineAtr)
    if _buyFlip
        flipResLevel := na
    if _sellFlip
        flipSupLevel := na
    // C: ブレイク (固有ID管理版)
    //  ・水平線ごとに zBreakUsed で1回限り (方向共通)。確定時のみ true にする。
    //  ・今バーで実際に「内側→外側」へ跨いだラインだけを対象にする (価格が既に外側の線は巻き込まない)。
    //  ・確定基準価格(threshold)は跨いだバーで固定 (ATR/ゾーン幅が変わっても再計算しない)。
    //  ・確定方式: CloseOnly(即時) / NextBar(翌足も外側) / Consecutive(N本連続外側)。各IDごとにカウント管理。
    //  ・1本で複数線を跨いだら全て pending に登録し、確定した線を zBreakUsed、シグナルは方向ごと1回。
    bool _breakBodyOK = not useLineBreakBodyFilter or (high - low > 0 and math.abs(close - open) / (high - low) >= lineBreakBodyRatio)
    float _brkBuf = lineBreakBufferMode == "Dollar" ? lineBreakBufferDollar : lineBreakBufferMode == "ATR" ? lineAtr * lineBreakBufferATR : 0.0
    int _confN = lineBreakConfirmMode == "CloseOnly" ? 1 : lineBreakConfirmMode == "NextBar" ? 2 : lineBreakConfirmBars
    bool _buyBreak  = false
    bool _sellBreak = false
    // --- (1) 既存 上pending を処理 (今バー追加分は後段で push するため二重処理しない) ---
    if useLineBreak and array.size(pendingUpZoneIds) > 0
        for k = array.size(pendingUpZoneIds) - 1 to 0
            int   _pid = array.get(pendingUpZoneIds, k)
            float _thr = array.get(pendingUpThresholds, k)
            int   _cnt = array.get(pendingUpCounts, k)
            int   _vidx = f_lineBreakValidIdx(_pid)   // 消滅/ブレイク済/ソースOFF/日数超過なら na
            if na(_vidx)
                array.remove(pendingUpZoneIds, k)
                array.remove(pendingUpThresholds, k)
                array.remove(pendingUpCounts, k)
            else if close > _thr           // 固定基準の外側に定着
                int _newCnt = _cnt + 1
                if _newCnt >= _confN
                    array.set(zBreakUsed, _vidx, true)
                    _buyBreak := true
                    array.remove(pendingUpZoneIds, k)
                    array.remove(pendingUpThresholds, k)
                    array.remove(pendingUpCounts, k)
                else
                    array.set(pendingUpCounts, k, _newCnt)
            else                            // 内側へ戻った → このIDは破棄
                array.remove(pendingUpZoneIds, k)
                array.remove(pendingUpThresholds, k)
                array.remove(pendingUpCounts, k)
    // --- (2) 既存 下pending を処理 ---
    if useLineBreak and array.size(pendingDnZoneIds) > 0
        for k = array.size(pendingDnZoneIds) - 1 to 0
            int   _pid = array.get(pendingDnZoneIds, k)
            float _thr = array.get(pendingDnThresholds, k)
            int   _cnt = array.get(pendingDnCounts, k)
            int   _vidx = f_lineBreakValidIdx(_pid)
            if na(_vidx)
                array.remove(pendingDnZoneIds, k)
                array.remove(pendingDnThresholds, k)
                array.remove(pendingDnCounts, k)
            else if close < _thr
                int _newCnt = _cnt + 1
                if _newCnt >= _confN
                    array.set(zBreakUsed, _vidx, true)
                    _sellBreak := true
                    array.remove(pendingDnZoneIds, k)
                    array.remove(pendingDnThresholds, k)
                    array.remove(pendingDnCounts, k)
                else
                    array.set(pendingDnCounts, k, _newCnt)
            else
                array.remove(pendingDnZoneIds, k)
                array.remove(pendingDnThresholds, k)
                array.remove(pendingDnCounts, k)
    // --- (3) 今バーで新規に跨いだラインを抽出 (内側→外側)。実体フィルターOKのバーのみ ---
    if useLineBreak and _breakBodyOK and array.size(zPrice) > 0
        for i = 0 to array.size(zPrice) - 1
            if not array.get(zBreakUsed, i) and bar_index >= array.get(zCreated, i)
                bool _ipv = array.get(zPivot, i)
                bool _ipr = array.get(zPrev, i)
                bool _iss = array.get(zSess, i)
                bool _pureSess = _iss and not _ipv and not _ipr
                bool _sessOK = not _pureSess or (array.get(zSessionDay, i) >= sessDayCounter - (lineSessionMaxDays - 1))
                if f_lineSourceOn(_ipv, _ipr, _iss) and _sessOK
                    int   _zid   = array.get(zId, i)
                    float _zp    = array.get(zPrice, i)
                    float _thrUp = _zp + lineZoneW + _brkBuf
                    float _thrDn = _zp - lineZoneW - _brkBuf
                    // 上抜け 新規クロス (前足は基準以下、今足は基準超え)
                    if close[1] <= _thrUp and close > _thrUp and not f_idInArray(pendingUpZoneIds, _zid)
                        if _confN <= 1
                            array.set(zBreakUsed, i, true)
                            _buyBreak := true
                        else
                            array.push(pendingUpZoneIds, _zid)
                            array.push(pendingUpThresholds, _thrUp)
                            array.push(pendingUpCounts, 1)
                    // 下抜け 新規クロス (前足は基準以上、今足は基準未満)
                    if close[1] >= _thrDn and close < _thrDn and not f_idInArray(pendingDnZoneIds, _zid)
                        if _confN <= 1
                            array.set(zBreakUsed, i, true)
                            _sellBreak := true
                        else
                            array.push(pendingDnZoneIds, _zid)
                            array.push(pendingDnThresholds, _thrDn)
                            array.push(pendingDnCounts, 1)
    // D: スイープ反転
    float _sweepTol = lineAtr * lineSweepToleranceATR
    bool _buySweep  = useLineSweep and _supUsable and (nearestSupport - low)     >= _sweepTol and close > nearestSupport    and f_lineCommonOK(true, lineAtr)
    bool _sellSweep = useLineSweep and _resUsable and (high - nearestResistance) >= _sweepTol and close < nearestResistance and f_lineCommonOK(false, lineAtr)
    // 統合 (優先: Sweep > Break > Flip > Bounce)
    lineRawLong  := _buyBounce or _buyFlip or _buyBreak or _buySweep
    lineRawShort := _sellBounce or _sellFlip or _sellBreak or _sellSweep
    // E: 障害物 (近すぎるレジサポで NoTrade)
    bool _obsAbove = not na(nearestResistance) and (nearestResistance - close) <= lineAtr * lineObstacleATR
    bool _obsBelow = not na(nearestSupport)    and (close - nearestSupport)    <= lineAtr * lineObstacleATR
    lineNoTradeLong  := useLineObstacleFilter and _obsAbove
    lineNoTradeShort := useLineObstacleFilter and _obsBelow
    lineNoTrade      := lineNoTradeLong or lineNoTradeShort
    // 表示 (line/label/box) は削除済み。判定 (反発/Flip/ブレイク/スイープ/状態管理) のみ維持。

// ブレイク改善: Break OFF / 水平線モジュール OFF 時は方向別 pending を完全クリア
//  (古い仮ブレイクが再ON後に復活しないようにする。useLineWZ は Module/WinZone のON条件を内包)
if not (useLineWZ and useLineBreak)
    f_clearPendingUp()
    f_clearPendingDn()

// --- 水平線 状態管理 (シグナル後 lineStateMaxBars 本だけ WinZone 維持) ---
var int lineLongStateBar  = na
var int lineShortStateBar = na
if useLineWZ and useLineStateWindow
    if lineRawLong
        lineLongStateBar := bar_index
    if lineRawShort
        lineShortStateBar := bar_index
bool lineLongState  = useLineStateWindow and not na(lineLongStateBar)  and (bar_index - lineLongStateBar)  <= lineStateMaxBars
bool lineShortState = useLineStateWindow and not na(lineShortStateBar) and (bar_index - lineShortStateBar) <= lineStateMaxBars

// 水平線 WinZone 出力 (状態管理ON=状態フラグ / OFF=イベント単バー / 未使用=false)
bool lineLongWinZone  = useLineWZ ? (useLineStateWindow ? lineLongState  : lineRawLong)  : false
bool lineShortWinZone = useLineWZ ? (useLineStateWindow ? lineShortState : lineRawShort) : false

// ============================================================
//  5b-3. WinZone 結合 (FVG / 出来高POC / フィボ / 水平線 を場所条件として統合)
// ------------------------------------------------------------
//  FVG_ONLY / VOLUME_ONLY / FIB_ONLY / LINE_ONLY / OR / AND で切り替え。
//  useWinZoneModule=false なら常に許可 (場所条件を無効化)。
//  OR : ONのWinZoneのどれかOKで true。AND : ONのWinZoneが全てOKで true。
//       (OFFのWinZoneはAND条件に含めない = not useXxx or ... で通過)
// ============================================================
bool longWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY"    ? longFVGOk :
     winZoneMode == "VOLUME_ONLY" ? longVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? longFibZoneOk :
     winZoneMode == "EMA_ONLY"    ? emaLongWinZone :
     winZoneMode == "LINE_ONLY"   ? lineLongWinZone :
     winZoneMode == "OR"          ? ((useFVGWinZone and longFVGOk) or (useVolumeWinZone and longVolumeZoneOk) or (useFibWinZone and longFibZoneOk) or (useEMAWinZone and emaLongWinZone) or (useLineWinZone and lineLongWinZone)) :
     winZoneMode == "AND"         ? ((not useFVGWinZone or longFVGOk) and (not useVolumeWinZone or longVolumeZoneOk) and (not useFibWinZone or longFibZoneOk) and (not useEMAWinZone or emaLongWinZone) and (not useLineWinZone or lineLongWinZone)) :
     true

bool shortWinZoneOk =
     not useWinZoneModule ? true :
     winZoneMode == "FVG_ONLY"    ? shortFVGOk :
     winZoneMode == "VOLUME_ONLY" ? shortVolumeZoneOk :
     winZoneMode == "FIB_ONLY"    ? shortFibZoneOk :
     winZoneMode == "EMA_ONLY"    ? emaShortWinZone :
     winZoneMode == "LINE_ONLY"   ? lineShortWinZone :
     winZoneMode == "OR"          ? ((useFVGWinZone and shortFVGOk) or (useVolumeWinZone and shortVolumeZoneOk) or (useFibWinZone and shortFibZoneOk) or (useEMAWinZone and emaShortWinZone) or (useLineWinZone and lineShortWinZone)) :
     winZoneMode == "AND"         ? ((not useFVGWinZone or shortFVGOk) and (not useVolumeWinZone or shortVolumeZoneOk) and (not useFibWinZone or shortFibZoneOk) and (not useEMAWinZone or emaShortWinZone) and (not useLineWinZone or lineShortWinZone)) :
     true

// ============================================================
//  5c. エントリートリガー統合 (包み足 + 追加条件)
// ------------------------------------------------------------
//  複数トリガーを Any/All/MinCount で結合し、最終シグナルを作る。
//  ・包み足は既存の bullEngulf / bearEngulf を再利用 (FVG吸収と共有)。
//  ・BOS / EMAリジェクトの ta.* は「ON の時だけ」呼ぶ (OFFで軽量)。
//  ・下位足確認は useLowerTFTrigger が ON の時だけ request.security。
//  ・出力: allowLongByTrigger / allowShortByTrigger
// ============================================================

// --- 結合判定ヘルパー ---
//   Any     … 1つ以上一致
//   All     … 有効な全トリガーが一致
//   MinCount… minTriggerCount 以上一致
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any"  ? cnt >= 1 :
     triggerMode == "All" ? (enabled > 0 and cnt >= enabled) :
     cnt >= minTriggerCount

// --- 下位足トリガー計算関数 (request.security から呼ばれる) ---
//   戻り値: [bullCount, bearCount]
f_calcTriggers() =>
    float _body      = math.abs(close - open)
    float _range     = high - low
    float _upWick    = high - math.max(open, close)
    float _loWick    = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool  _pUp = close[1] > open[1]
    bool  _pDn = close[1] < open[1]
    float _cHi = math.max(open,    close)
    float _cLo = math.min(open,    close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool  _engBody = _cHi >= _pHi and _cLo <= _pLo
    // 包み足 品質フィルター (現在足と同条件)
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk =
         not useEngulfBodyRatioFilter or
         (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk =
         not useEngulfBodyQualityFilter or
         (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk =
         not useEngulfBodyAtrFilter or
         _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk =
         _engulfRatioOk and
         _engulfBodyQualityOk and
         _engulfBodyAtrOk
    // 包み足 (本体ストラテジーと同じ strict / 反対色ルール + 品質)
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    // ピンバー (実体率・最低レンジ フィルター込み)
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk     = not usePinRangeFilter     or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    // BOS
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    // EMA リジェクト (傾きフィルター込み)
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope    = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope >  _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    // FVG 形成
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    // 強ローソク
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

// --- 有効(ON)トリガー数 ---
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// --- 現在足のローソク基本量 ---
float trBody      = math.abs(close - open)
float trRange     = high - low
float trUpWick    = high - math.max(open, close)
float trLoWick    = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

// --- 各トリガー (現在足) ---
// 包み足 : 既存 bullEngulf / bearEngulf に品質フィルターを AND (トリガー側のみ)
//   ※ FVG吸収で使う bullEngulf / bearEngulf 自体は変更しない。
//   品質 : 1.包み込み率 (実体が前足実体の何倍か) 2.実体率 3.最低実体ATR倍率。
//   ta.atr は 包み足トリガーON かつ 実体ATRフィルターON の時だけ呼ぶ (OFFで軽量)。
float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk =
     not useEngulfBodyRatioFilter or
     (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk =
     not useEngulfBodyQualityFilter or
     (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk =
     not useEngulfBodyAtrFilter or
     curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk =
     engulfRatioOk and
     engulfBodyQualityOk and
     engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

// ピンバー : ヒゲ/実体・反対ヒゲ・終値位置 (既存) + 実体率・最低レンジ (品質)
//   ta.atr は ピンバーON かつ レンジフィルターON の時だけ呼ぶ (OFFで軽量)
float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk     = not usePinRangeFilter     or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

// BOS : ta.highest/lowest は ON の時だけ呼ぶ (OFFで軽量)
float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low,  bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

// EMA リジェクト : ta.ema / ta.atr は ON の時だけ呼ぶ (OFFで軽量)
//   傾きフィルター : ロングは EMA が上向き・ショートは下向きの時のみ許可。
//   水平/逆向き (|slope| <= slopeMin) は除外。slopeMin = ATR * 最低傾きATR倍率。
float emaTrig     = na
float emaSlope    = na
float emaSlopeMin = na
bool  emaRejectSlopeLongOk  = true
bool  emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk  := not useEMARejectSlopeFilter or emaSlope >  emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA =
     useEMARejectTrigger and
     low <= emaTrig and
     close > emaTrig and
     close > open and
     emaRejectSlopeLongOk
bool trBearEMA =
     useEMARejectTrigger and
     high >= emaTrig and
     close < emaTrig and
     close < open and
     emaRejectSlopeShortOk

// FVG 形成 (ta 不要)
bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

// 強ローソク (ta 不要)
bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 下位足トリガー (OFF なら request.security を呼ばない) ---
bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

// --- 現在足 / 下位足 の結合 ---
bool finalBullTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur :
     triggerTFMode == "LowerOnly"       ? trigBullLower :
     triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBullCur or trigBullLower) :
     trigBullCur

bool finalBearTrig =
     not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur :
     triggerTFMode == "LowerOnly"       ? trigBearLower :
     triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) :
     triggerTFMode == "CurrentOrLower"  ? (trigBearCur or trigBearLower) :
     trigBearCur

// --- 逆方向同時発生 NoTrade ---
bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

// --- クールダウン (トリガー発火からの経過本数) ---
var int lastTrigBar = na
bool trigFiredNow   = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// --- 最終トリガー許可 ---
//   トリガーを1つも ON にしていない (enabledTrigCount == 0) 場合は
//   「トリガーフィルターなし」として常に許可する。これにより
//   環境認識 + WinZone + Momentum だけでストラテジーを検証できる。
//   1つ以上 ON のときは従来どおり Any/All/MinCount + NoTrade + クールダウンで判定。
bool allowLongByTrigger  = enabledTrigCount == 0 ? true : (finalBullTrig and not trigNoTrade and trigCooldownOk)
bool allowShortByTrigger = enabledTrigCount == 0 ? true : (finalBearTrig and not trigNoTrade and trigCooldownOk)

// ============================================================
//  6. ボラフィルタ判定
// ------------------------------------------------------------
//  通常ボラ (volMode) と 高速ボラ (fastVolMode) は独立して評価。
//  volMode / fastVolMode は定数入力なので分岐は全バーで一貫し、
//  未使用側の関数 (ta.atr 等) は呼ばれないため軽量。
// ============================================================

// --- 通常ボラ (base) : volMode で選択 ---
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg  = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin
// volMode == OFF のときは baseVolOk = true (通常ボラ無効・関数呼び出しなし)

// --- 高速ボラ (fast) : OFF/ATR/固定値。volMode に関係なく独立して使える ---
bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk    = fastAtr >= fastAtrMin
    bool bodyAvgOk    = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    // ATRを使わず、直近 fastAtrLen 本の値幅を固定しきい値で判定
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk   = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk
// fastVolMode == OFF のときは fastVolPass = true (関数呼び出しなし)

// --- 合成 + 低ボラ解除後の待機 (クールダウン) ---
bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow  = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
//  7. 環境判定関数
// ------------------------------------------------------------
//  request.security から各時間足のコンテキストで呼ばれる。
//  戻り値 : [trend, bullScore, bearScore, rangeScore]
//           trend = 1=上昇 / 0=レンジ / -1=下降 / na=未判定
// ============================================================
f_envTrend(int minScore) =>
    ema20  = ta.ema(close, len20)
    ema50  = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr    = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    // 上昇スコア
    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    // 下降スコア
    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    // レンジスコア
    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    trend

// 環境テーブル用ヘルパー
// 要求文字列 → コード (1=上昇/0=レンジ/-1=下降/na=OFF)
f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// ============================================================
//  8. 環境フィルタ計算
// ------------------------------------------------------------
//  useEnvFilter は定数入力。OFF のときは if ブロックに入らず、
//  request.security を一切呼ばないため軽い。
// ============================================================
bool allowByEnv  = true
int  envEnabled = 0
int  envMatched = 0

if useEnvFilter
    raw4H  = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
    raw1H  = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
    raw15M = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)
    raw5M  = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    raw1M  = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    // 各TF : 有効か / 実際が要求と一致か
    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    // 必要一致数 (0=有効な全TF)。有効TFが無ければ制限なし。
    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

// 環境フィルタ最終判定 (OFF なら常に許可)。ロング/ショート共通の環境テンプレート。
bool envLongOk  = not useEnvFilter or allowByEnv
bool envShortOk = not useEnvFilter or allowByEnv

// ============================================================
//  8b. Momentum モジュール (ストキャス) : 勢い・タイミング確認
// ------------------------------------------------------------
//  ※ 環境認識(トレンド判定)とは完全に独立。allowByEnv / envLongOk /
//     envShortOk には絶対に混ぜない。
//  設計順序上は FVG(場所) の次・Trigger(価格アクション) の前の
//  「勢いが反転したか」の確認。状態保持し、その後 Trigger を待つ。
//  役割: 勢い / 押し目・戻り / エントリータイミング / 逆張り禁止。
//  出力: allowLongByStoch / allowShortByStoch / stochNoTrade
//        → 上位の allowLongByMomentum / allowShortByMomentum に集約。
//  ※ ストキャスの判定ロジックは単体モジュール版と同一。接続のみ追加。
// ============================================================

// ストキャス全体の有効フラグ (Momentumモジュール かつ ストキャスON)
bool sAct = useMomentumModule and useStochMomentum

// --- ストキャス計算 (関数化 → 参照TF切り替え可能) ---
//   useStochTF=false … チャート足で計算 (従来挙動)
//   useStochTF=true  … stochTF で計算 (request.security / lookahead_off で未来参照防止)
f_stochCalc() =>
    float _rawK = ta.stoch(close, high, low, kLen)
    float _k = ta.sma(_rawK, kSmooth)
    float _d = ta.sma(_k, dLen)
    [_k, _d]

// ※ 三項演算子 ?: はタプルを返せないため if/else で分岐 (request.security は useStochTF=true 時のみ)
float stochK = na
float stochD = na
if useStochTF
    [k1, d1] = request.security(syminfo.tickerid, stochTF, f_stochCalc(), lookahead = barmerge.lookahead_off)
    stochK := k1
    stochD := d1
else
    [k2, d2] = f_stochCalc()
    stochK := k2
    stochD := d2

// 共通の傾き / クロス
bool slopeUp     = stochK > stochK[1]
bool slopeDown   = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

// 共通フィルター
f_dirOK(bool isBuy) =>
    bool d = not useKDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool r = not useKDRelationFilter or (isBuy ? stochK > stochD : stochK < stochD)
    d and r

// --- A: Extreme Reversal (90/10 折り返し) ---
bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp)   or (useExtremeKDCross and kdCrossUp)

float stochSlope = stochK - stochK[1]
bool slopeStrengthOK_sell = not useSlopeStrengthFilter or stochSlope <= -stochSlopeMin
bool slopeStrengthOK_buy  = not useSlopeStrengthFilter or stochSlope >=  stochSlopeMin

var bool  wasExtremeHigh       = false
var bool  wasExtremeLow        = false
var bool  extremeHighTriggered = false
var bool  extremeLowTriggered  = false
var float lastExtremeHighValue = na
var float lastExtremeLowValue  = na

if stochK >= extremeHigh
    wasExtremeHigh := true
    lastExtremeHighValue := na(lastExtremeHighValue) ? stochK : math.max(lastExtremeHighValue, stochK)
if stochK <= extremeLow
    wasExtremeLow := true
    lastExtremeLowValue := na(lastExtremeLowValue) ? stochK : math.min(lastExtremeLowValue, stochK)
if stochK <= extremeResetLevelHigh
    wasExtremeHigh := false
    extremeHighTriggered := false
    lastExtremeHighValue := na
if stochK >= extremeResetLevelLow
    wasExtremeLow := false
    extremeLowTriggered := false
    lastExtremeLowValue := na

bool retraceOK_sell = not useExtremeRetraceFilter or (not na(lastExtremeHighValue) and (lastExtremeHighValue - stochK) >= extremeRetraceMin)
bool retraceOK_buy  = not useExtremeRetraceFilter or (not na(lastExtremeLowValue)  and (stochK - lastExtremeLowValue)  >= extremeRetraceMin)

bool exSell = sAct and useExtremeReversal and wasExtremeHigh and (not useExtremeOneShot or not extremeHighTriggered) and turnDown and slopeStrengthOK_sell and retraceOK_sell and f_dirOK(false)
bool exBuy  = sAct and useExtremeReversal and wasExtremeLow  and (not useExtremeOneShot or not extremeLowTriggered)  and turnUp   and slopeStrengthOK_buy  and retraceOK_buy  and f_dirOK(true)

if exSell
    extremeHighTriggered := true
if exBuy
    extremeLowTriggered := true

// --- B: OB/OS Cross (80/20 クロス) ---
bool obSell = sAct and useOBOSCross and stochK > obLevel and kdCrossDown and f_dirOK(false)
bool obBuy  = sAct and useOBOSCross and stochK < osLevel and kdCrossUp   and f_dirOK(true)

// --- C: Middle Cross (50 抜け / 順張り勢い確認) ---
bool midBuy  = sAct and useMiddleCross and ta.crossover(stochK, middleLevel)  and stochK > stochD and f_dirOK(true)
bool midSell = sAct and useMiddleCross and ta.crossunder(stochK, middleLevel) and stochK < stochD and f_dirOK(false)

// --- D: Trend Stickiness (張り付き → 逆張り禁止) ---
var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := stochK >= obLevel ? bullStickCount + 1 : 0
bearStickCount := stochK <= osLevel ? bearStickCount + 1 : 0
bool stochBullSticky = sAct and useStickinessFilter and bullStickCount >= stickBars
bool stochBearSticky = sAct and useStickinessFilter and bearStickCount >= stickBars
bool stochNoSell = stochBullSticky   // 強い上昇中はSELL禁止
bool stochNoBuy  = stochBearSticky   // 強い下降中はBUY禁止

// --- E/F: Divergence (pivot ベース) ---
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low,  divPivotLen, divPivotLen)
float stochAtPivot = stochK[divPivotLen]

var float phPrev    = na
var float phLast    = na
var float shHPrev   = na
var float shHLast   = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev    = na
var float plLast    = na
var float shLPrev   = na
var float shLLast   = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    shHPrev := shHLast
    phBarPrev := phBarLast
    phLast := pricePH
    shHLast := stochAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    shLPrev := shLLast
    plBarPrev := plBarLast
    plLast := pricePL
    shLLast := stochAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

bool regSell = sAct and useRegularDivergence and newPH and phInRange and phLast > phPrev and shHLast < shHPrev
bool regBuy  = sAct and useRegularDivergence and newPL and plInRange and plLast < plPrev and shLLast > shLPrev
bool hidBuy  = sAct and useHiddenDivergence and newPL and plInRange and plLast > plPrev and shLLast < shLPrev
bool hidSell = sAct and useHiddenDivergence and newPH and phInRange and phLast < phPrev and shHLast > shHPrev

// --- Signal Direction (優先: Regular > Hidden > Extreme > OBOS > Middle) ---
bool anyReg = regBuy or regSell
bool anyHid = hidBuy or hidSell
bool anyEx  = exBuy or exSell
bool anyOB  = obBuy or obSell
bool anyMid = midBuy or midSell

int stochDirection = not sAct ? 0 :
                      anyReg ? (regBuy ? 1 : -1) :
                      anyHid ? (hidBuy ? 1 : -1) :
                      anyEx  ? (exBuy ? 1 : -1) :
                      anyOB  ? (obBuy ? 1 : -1) :
                      anyMid ? (midBuy ? 1 : -1) : 0

// --- ストキャス イベント (そのバーで発生したシグナル) ---
bool stochLongEvent  = sAct and stochDirection == 1  and not stochNoBuy
bool stochShortEvent = sAct and stochDirection == -1 and not stochNoSell

// --- ストキャス 状態管理 : イベント発生後 stochStateMaxBars 本 OK を保持 ---
//   タイミングズレ (ストキャス→FVG→トリガー) で弾かれ回数が減るのを緩和。
//   ※ A〜Fパターン判定は不変。イベントを状態化して allow を状態ベースにするだけ。
var bool stochLongStateOk   = false
var bool stochShortStateOk  = false
var int  stochLongStateBar  = na
var int  stochShortStateBar = na

if useStochStateWindow
    if stochLongEvent
        stochLongStateOk   := true
        stochLongStateBar  := bar_index
    if stochShortEvent
        stochShortStateOk   := true
        stochShortStateBar  := bar_index
    if stochLongStateOk and not na(stochLongStateBar) and bar_index - stochLongStateBar > stochStateMaxBars
        stochLongStateOk := false
    if stochShortStateOk and not na(stochShortStateBar) and bar_index - stochShortStateBar > stochStateMaxBars
        stochShortStateOk := false

// --- ストキャス 接続用出力 (状態ベース) ---
//   sAct=false … 通過 (Momentum側でOFF扱い)
//   状態管理ON … 保持中フラグ かつ 逆張り禁止でない
//   状態管理OFF … 従来のイベント単バー
bool allowLongByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochLongStateOk and not stochNoBuy) :
     stochLongEvent
bool allowShortByStoch =
     not sAct ? true :
     useStochStateWindow ? (stochShortStateOk and not stochNoSell) :
     stochShortEvent
bool stochNoTrade = sAct and (stochNoBuy or stochNoSell)

// ============================================================
//  8b-MACD. Momentum : MACD モジュール (勢い / タイミング確認)
// ------------------------------------------------------------
//  ストキャスと並列の Momentum 指標。WinZone/Trigger には混ぜない。
//  A:Signalクロス B:ゼロ上下(方向F) C:ゼロクロス D:Hist拡大
//  E:Hist縮小(Exit警戒) F:Regular Div G:Hidden Div H:収束→拡散
//  useMACDModule=false の時は ta.macd / ta.atr / ta.sma / ta.pivot* /
//  Divergence / Compression / 状態更新 を一切実行しない。
//  機能単位でも : Divergence OFF→pivot無し / ATR正規化 OFF→ta.atr無し /
//    相対収束 OFF→ta.sma無し。
//  変数はすべて macd プレフィックスで既存グローバルとの衝突を回避。
//  出力 : allowLongByMACD / allowShortByMACD / macdNoTrade / macdDirection /
//         macdSignalType / macdRank / macdExitRank / macdExitDirection
// ============================================================

// --- ヘルパー (定義はグローバル。計算呼び出しは if 内のみ) ---
f_macdDirOK(bool isBuy, float _line, float _hist, bool _zOKB, bool _zOKS) =>
    bool z = not useMACDZeroDirectionFilter or ((isBuy ? _line > 0 : _line < 0) and (isBuy ? _zOKB : _zOKS))
    bool h = not useMACDHistDirectionFilter or (isBuy ? _hist > 0 : _hist < 0)
    bool s = not useMACDSlopeFilter or (isBuy ? _line > _line[1] : _line < _line[1])
    z and h and s

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
int  macdDirection  = 0
bool macdNoTrade      = false
bool macdNoTradeLong  = false
bool macdNoTradeShort = false
bool macdMomentumLong  = false
bool macdMomentumShort = false

if useMACDModule
    [macdLine, macdSignal, macdHist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)

    // ② Histogram Slope Strength
    float macdHistSlope = macdHist - macdHist[1]
    bool macdHistSlopeBull = macdHistSlope >=  macdHistSlopeMin
    bool macdHistSlopeBear = macdHistSlope <= -macdHistSlopeMin
    bool macdHistSlopeOKBuy  = not useMACDHistSlopeStrength or macdHistSlopeBull
    bool macdHistSlopeOKSell = not useMACDHistSlopeStrength or macdHistSlopeBear

    // ③ Zero Distance
    float macdZeroDistance = math.abs(macdLine)
    bool macdZeroDistOKBuy  = not useMACDZeroDistanceFilter or (macdLine > 0 and macdZeroDistance >= macdZeroDistanceMin)
    bool macdZeroDistOKSell = not useMACDZeroDistanceFilter or (macdLine < 0 and macdZeroDistance >= macdZeroDistanceMin)

    // ① Relative Compression (相対収束 : ta.sma は相対収束ON時のみ)
    float macdHistAbs    = math.abs(macdHist)
    float macdHistAbsAvg = na
    if useMACDRelativeCompression
        macdHistAbsAvg := ta.sma(macdHistAbs, macdRelativeCompressionLookback)
    bool macdRelComp = useMACDRelativeCompression and not na(macdHistAbsAvg) and macdHistAbs <= macdHistAbsAvg * macdRelativeCompressionMult

    // ATR (収束しきい値のATR正規化ON時のみ ta.atr)
    float macdAtr = na
    if useMACDATRNormalizedThreshold
        macdAtr := ta.atr(macdAtrLen)

    // B: ゼロライン 上/下 (方向フィルター)
    bool macdAboveZero = macdLine > 0
    bool macdBelowZero = macdLine < 0
    bool allowLongByMACDZero  = (not useMACDZeroFilter or macdAboveZero) and macdZeroDistOKBuy
    bool allowShortByMACDZero = (not useMACDZeroFilter or macdBelowZero) and macdZeroDistOKSell

    // A: MACD / Signal クロス
    bool macdBuyCrossSignal  = useMACDSignalCross and ta.crossover(macdLine, macdSignal)  and f_macdDirOK(true,  macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)
    bool macdSellCrossSignal = useMACDSignalCross and ta.crossunder(macdLine, macdSignal) and f_macdDirOK(false, macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)

    // C: ゼロラインクロス
    bool macdBuyZeroCrossSignal  = useMACDZeroCross and ta.crossover(macdLine, 0)  and f_macdDirOK(true,  macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)
    bool macdSellZeroCrossSignal = useMACDZeroCross and ta.crossunder(macdLine, 0) and f_macdDirOK(false, macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)

    // D: ヒストグラム拡大 (勢い確認)
    bool macdHistExpandingBull = macdHist > 0 and macdHist > macdHist[1]
    bool macdHistExpandingBear = macdHist < 0 and macdHist < macdHist[1]
    var int macdBullExpCount = 0
    var int macdBearExpCount = 0
    macdBullExpCount := macdHistExpandingBull ? macdBullExpCount + 1 : 0
    macdBearExpCount := macdHistExpandingBear ? macdBearExpCount + 1 : 0
    bool macdHistBullOK = useMACDHistExpansionConsecutive ? macdBullExpCount >= macdHistExpansionBars : macdHistExpandingBull
    bool macdHistBearOK = useMACDHistExpansionConsecutive ? macdBearExpCount >= macdHistExpansionBars : macdHistExpandingBear
    bool macdBuyHistExpansionSignal  = useMACDHistExpansion and macdHistBullOK and macdHistSlopeOKBuy  and f_macdDirOK(true,  macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)
    bool macdSellHistExpansionSignal = useMACDHistExpansion and macdHistBearOK and macdHistSlopeOKSell and f_macdDirOK(false, macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)

    // F/G: Divergence (pivot ベース / macdLine 値で判定 / Div ON時のみ pivot)
    bool macdUseDiv = useMACDRegularDivergence or useMACDHiddenDivergence
    bool macdRegSell = false
    bool macdRegBuy  = false
    bool macdHidBuy  = false
    bool macdHidSell = false
    if macdUseDiv
        float macdPricePH = ta.pivothigh(high, macdDivPivotLen, macdDivPivotLen)
        float macdPricePL = ta.pivotlow(low,  macdDivPivotLen, macdDivPivotLen)
        float macdAtPivot = macdLine[macdDivPivotLen]
        var float macdPhPrev = na
        var float macdPhLast = na
        var float macdMhPrev = na
        var float macdMhLast = na
        var int   macdPhBarPrev = na
        var int   macdPhBarLast = na
        var float macdPlPrev = na
        var float macdPlLast = na
        var float macdMlPrev = na
        var float macdMlLast = na
        var int   macdPlBarPrev = na
        var int   macdPlBarLast = na
        bool macdNewPH = not na(macdPricePH)
        bool macdNewPL = not na(macdPricePL)
        if macdNewPH
            macdPhPrev := macdPhLast
            macdMhPrev := macdMhLast
            macdPhBarPrev := macdPhBarLast
            macdPhLast := macdPricePH
            macdMhLast := macdAtPivot
            macdPhBarLast := bar_index - macdDivPivotLen
        if macdNewPL
            macdPlPrev := macdPlLast
            macdMlPrev := macdMlLast
            macdPlBarPrev := macdPlBarLast
            macdPlLast := macdPricePL
            macdMlLast := macdAtPivot
            macdPlBarLast := bar_index - macdDivPivotLen
        bool macdPhInRange = not na(macdPhPrev) and (macdPhBarLast - macdPhBarPrev) <= macdDivLookback
        bool macdPlInRange = not na(macdPlPrev) and (macdPlBarLast - macdPlBarPrev) <= macdDivLookback
        macdRegSell := useMACDRegularDivergence and macdNewPH and macdPhInRange and macdPhLast > macdPhPrev and macdMhLast < macdMhPrev
        macdRegBuy  := useMACDRegularDivergence and macdNewPL and macdPlInRange and macdPlLast < macdPlPrev and macdMlLast > macdMlPrev
        macdHidBuy  := useMACDHiddenDivergence and macdNewPL and macdPlInRange and macdPlLast > macdPlPrev and macdMlLast < macdMlPrev
        macdHidSell := useMACDHiddenDivergence and macdNewPH and macdPhInRange and macdPhLast < macdPhPrev and macdMhLast > macdMhPrev

    // H: 収束 → 拡散 (レンジ後の初動)
    float macdCompThresh = useMACDATRNormalizedThreshold ? macdAtr * macdCompressionThreshold : macdCompressionThreshold
    bool macdCompressionCore = (math.abs(macdHist) <= macdCompThresh) or macdRelComp
    var int macdCompCount = 0
    macdCompCount := macdCompressionCore ? macdCompCount + 1 : 0
    bool macdCompression = useMACDCompressionExpansion and macdCompCount >= macdCompressionBars
    bool macdWasCompressed = macdCompression[1]
    bool macdBuyExpansionFromCompression  = useMACDCompressionExpansion and macdWasCompressed and macdHist > 0 and macdHist > macdHist[1] and f_macdDirOK(true,  macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)
    bool macdSellExpansionFromCompression = useMACDCompressionExpansion and macdWasCompressed and macdHist < 0 and macdHist < macdHist[1] and f_macdDirOK(false, macdLine, macdHist, macdZeroDistOKBuy, macdZeroDistOKSell)

    // Direction (優先: RegDiv>HidDiv>CompExp>ZeroCross>SignalCross>HistExp)
    bool macdAnyReg   = macdRegBuy or macdRegSell
    bool macdAnyHid   = macdHidBuy or macdHidSell
    bool macdAnyComp  = macdBuyExpansionFromCompression or macdSellExpansionFromCompression
    bool macdAnyZeroX = macdBuyZeroCrossSignal or macdSellZeroCrossSignal
    bool macdAnySigX  = macdBuyCrossSignal or macdSellCrossSignal
    bool macdAnyHistX = macdBuyHistExpansionSignal or macdSellHistExpansionSignal
    macdDirection  := macdAnyReg ? (macdRegBuy ? 1 : -1) : macdAnyHid ? (macdHidBuy ? 1 : -1) : macdAnyComp ? (macdBuyExpansionFromCompression ? 1 : -1) : macdAnyZeroX ? (macdBuyZeroCrossSignal ? 1 : -1) : macdAnySigX ? (macdBuyCrossSignal ? 1 : -1) : macdAnyHistX ? (macdBuyHistExpansionSignal ? 1 : -1) : 0

    // 接続用出力 (macdNoTrade は横ばい時のみ / 方向非依存 → 両方向へ)
    macdNoTrade      := useMACDFlatNoTrade and macdCompression
    macdNoTradeLong  := macdNoTrade
    macdNoTradeShort := macdNoTrade
    macdMomentumLong  := macdDirection == 1
    macdMomentumShort := macdDirection == -1

// --- MACD 状態管理 ---
//  BUYシグナル(macdMomentumLong) → longMACDStateOk=true / macdStateMaxBars本で期限切れ
//  ※ 更新は useMACDModule かつ useMACDStateWindow の時だけ。
var bool longMACDStateOk  = false
var bool shortMACDStateOk = false
var int  longMACDStateBar  = na
var int  shortMACDStateBar = na
if useMACDModule and useMACDStateWindow
    if macdMomentumLong
        longMACDStateOk := true
        longMACDStateBar := bar_index
    if macdMomentumShort
        shortMACDStateOk := true
        shortMACDStateBar := bar_index
    if longMACDStateOk and not na(longMACDStateBar) and bar_index - longMACDStateBar > macdStateMaxBars
        longMACDStateOk := false
    if shortMACDStateOk and not na(shortMACDStateBar) and bar_index - shortMACDStateBar > macdStateMaxBars
        shortMACDStateOk := false

// --- MACD 許可 ---
//  OFF … 常に許可 / 状態管理OFF … シグナル単バー+NoTrade / 状態管理ON … 保持中+NoTrade
bool allowLongByMACD  = not useMACDModule ? true : useMACDStateWindow ? (longMACDStateOk and not macdNoTradeLong) : (macdMomentumLong and not macdNoTradeLong)
bool allowShortByMACD = not useMACDModule ? true : useMACDStateWindow ? (shortMACDStateOk and not macdNoTradeShort) : (macdMomentumShort and not macdNoTradeShort)

// ============================================================
//  8c. Momentum 集約 (ストキャス + MACD。将来 RSI/CCI/ADX/ROC も同じ構造で追加)
// ------------------------------------------------------------
//  各Momentum指標の long/short 許可を momentumMode(AND/OR)で結合。
//  OFFの指標は AND=中立(通過) / OR=不参加。全部OFFなら常時許可。
//  useMACDModule=false の時は allowLongByMACD=true / macdNoTrade=false のため
//  既存(ストキャスのみ)の結果と一致する。
// ============================================================
bool stochMomentumEnabled = useStochMomentum
bool macdMomentumEnabled  = useMACDModule

// AND中立(通過) / OR不参加 のための通過フラグ
bool momoLongStoch  = not useStochMomentum or allowLongByStoch
bool momoShortStoch = not useStochMomentum or allowShortByStoch
bool momoLongMACD   = not useMACDModule or allowLongByMACD
bool momoShortMACD  = not useMACDModule or allowShortByMACD

// 結合 : AND=有効な全指標一致 / OR=有効な指標のいずれか一致 (全OFFは通過)
bool momoLongCombined = momentumMode == "AND" ? (momoLongStoch and momoLongMACD) : ((stochMomentumEnabled and allowLongByStoch) or (macdMomentumEnabled and allowLongByMACD) or (not stochMomentumEnabled and not macdMomentumEnabled))
bool momoShortCombined = momentumMode == "AND" ? (momoShortStoch and momoShortMACD) : ((stochMomentumEnabled and allowShortByStoch) or (macdMomentumEnabled and allowShortByMACD) or (not stochMomentumEnabled and not macdMomentumEnabled))

// Momentum NoTrade (方向別。ストキャス逆張り禁止 + MACD横ばい NoTrade を織り込む)
bool momoNoTradeLong  = stochNoTrade or macdNoTradeLong
bool momoNoTradeShort = stochNoTrade or macdNoTradeShort

// 最終 Momentum 許可 (OFFなら常に許可。方向別 NoTrade 中はその方向のみ禁止)
bool allowLongByMomentum  = not useMomentumModule or (momoLongCombined  and not momoNoTradeLong)
bool allowShortByMomentum = not useMomentumModule or (momoShortCombined and not momoNoTradeShort)

// ============================================================
//  9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low,  low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// SL方式: パターン=包み足の高安ベース / 固定=一定の価格幅
float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

// 損失許容額 = 基準資金 * リスク%
//   複利 OFF … 元金 (initial_capital) 基準 = 単利
//   複利 ON  … 現在残高 (equity) 基準 = 複利
float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

// リスク幅(価格)から整数ロットを算出 (1未満は 0 → エントリーしない)
f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
//  9b. 日足レジームフィルター (Daily Regime Filter)
// ------------------------------------------------------------
//  日足レベルの相場を「方向(上昇/レンジ/下降) × ボラ(高/中/低)」の
//  9パターンに分類し、選択した日足環境の日だけ既存ストラテジーを
//  バックテストできるようにする独立モジュール。
//    設計順序 : 日足レジーム → 既存の4H/1H/15M環境認識 → WinZone → Momentum → Trigger → Entry
//  ・既存の 環境フィルタ(allowByEnv / envLongOk / envShortOk) には一切混ぜない。
//    最終エントリー条件で dailyRegimeLongOk / dailyRegimeShortOk を独立 AND する。
//  ・日足レジームには方向別の許可差を設けない (両出力とも同値)。
//  ・未来参照防止 :
//     「前日確定ベース」= 確定済み前日日足のみ参照 (正式バックテスト用)。
//     「当日確定後分析」= 完成日足を表示・分析するだけで売買条件には接続しない。
//                        (未来参照を避けるためエントリー制限には使用しない)
//  ・useDailyRegimeFilter=false かつ 表示OFF のときは日足 request.security を
//    呼ばず、重いパーセンタイル等も計算しない (軽量)。
//  ・変数/関数は dailyRegime / dailyReg / dr プレフィックスで既存と衝突回避。
// ============================================================
grpDailyRegime = "日足レジーム"
useDailyRegimeFilter = input.bool(true, "日足レジームフィルターを使う", group = grpDailyRegime)
dailyRegimeMode = input.string("当日進行中ベース", "日足レジーム判定モード", options = ["前日確定ベース", "当日進行中ベース", "当日確定後分析"], group = grpDailyRegime, tooltip = "前日確定ベース=確定済み前日日足で翌日を制限 (正式バックテスト/非リペイント)。当日進行中ベース=当日始値からその足までの累積値幅で分類し、その時点でエントリーを制限 (未来参照なし・非リペイント・エントリー接続)。当日確定後分析=完成日足の事後分類 (未来参照を避けるためエントリー制限には使用しない・表示/背景/集計専用)。")

// 日足方向 / 日足ボラ の要求 (OFF=その軸は制限しない)
reqDailyDirection  = input.string("OFF", "日足方向", options = ["OFF", "上昇", "レンジ", "下降"], group = grpDailyRegime)
reqDailyVolatility = input.string("中ボラ", "日足ボラ", options = ["OFF", "高ボラ", "中ボラ", "低ボラ"], group = grpDailyRegime)

// --- 日足ボラ分類方法 ---
dailyVolatilityMethod = input.string("固定値", "日足ボラ分類方法", options = ["パーセンタイル", "ATR比率", "固定値"], group = grpDailyRegime)
// A. パーセンタイル方式 (相対分布。判定対象日自身は分布に含めない)
dailyVolLookback    = input.int(252, "日足ボラ分布 参照日数", minval = 30, group = grpDailyRegime)
dailyLowPercentile  = input.float(33.0, "低ボラ上限パーセンタイル", minval = 1, maxval = 49, step = 1, group = grpDailyRegime)
dailyHighPercentile = input.float(67.0, "高ボラ下限パーセンタイル", minval = 51, maxval = 99, step = 1, group = grpDailyRegime)
// B. ATR比率方式 (日足値幅 ÷ 日足ATR)
dailyAtrLen       = input.int(14, "日足ATR期間", minval = 1, group = grpDailyRegime)
dailyLowAtrRatio  = input.float(0.80, "低ボラ上限 日足値幅÷ATR", minval = 0.1, step = 0.05, group = grpDailyRegime)
dailyHighAtrRatio = input.float(1.20, "高ボラ下限 日足値幅÷ATR", minval = 0.1, step = 0.05, group = grpDailyRegime)
// C. 固定値方式 (日足値幅 $ しきい値)
dailyLowRangeMax  = input.float(80,  "低ボラ上限値幅($)", minval = 0, step = 0.1, group = grpDailyRegime)
dailyHighRangeMin = input.float(140, "高ボラ下限値幅($)", minval = 0, step = 0.1, group = grpDailyRegime)

// --- 日足方向分類 (陽陰だけでなく実体率・終値位置で判定) ---
dailyDirectionBodyRatio = input.float(0.40, "日足方向 最低実体率", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyBullCloseLocation  = input.float(0.65, "日足上昇 終値位置下限", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyBearCloseLocation  = input.float(0.35, "日足下降 終値位置上限", minval = 0, maxval = 1, step = 0.05, group = grpDailyRegime)
dailyInsufficientAsRange = input.bool(true, "日足データ不足時はレンジ扱い (false=データが揃うまで不一致)", group = grpDailyRegime)

// --- 分類コード → 文字列 (1=上昇/高ボラ, 0=レンジ/中ボラ, -1=下降/低ボラ, na=判定不能) ---
f_dailyDirectionText(int code) =>
    code == 1 ? "上昇" : code == -1 ? "下降" : code == 0 ? "レンジ" : "-"
f_dailyVolatilityText(int code) =>
    code == 1 ? "高ボラ" : code == -1 ? "低ボラ" : code == 0 ? "中ボラ" : "-"

// --- 日足方向コード (実体率 + 終値位置)。値幅0/na はデータ不足 → na ---
f_drDirCode(float o, float h, float l, float c) =>
    float _rng = h - l
    int _code = na
    if not na(o) and not na(h) and not na(l) and not na(c) and _rng > 0
        float _body = math.abs(c - o)
        float _bodyRatio = _body / _rng
        float _closeLoc = (c - l) / _rng
        bool _bull = c > o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc >= dailyBullCloseLocation
        bool _bear = c < o and _bodyRatio >= dailyDirectionBodyRatio and _closeLoc <= dailyBearCloseLocation
        // 上昇と下降は同時成立しない (終値位置しきい値が0.5前後で相互排他だが念のため優先順で確定)
        _code := _bull and not _bear ? 1 : _bear and not _bull ? -1 : 0
    _code

// --- 日足ボラコード (方法別)。判定不能は na ---
f_drVolCode(float rng, float atr, float loThr, float hiThr) =>
    int _code = na
    bool _valid = not na(rng) and rng > 0
    if dailyVolatilityMethod == "パーセンタイル"
        if _valid and not na(loThr) and not na(hiThr) and hiThr >= loThr
            _code := rng >= hiThr ? 1 : rng <= loThr ? -1 : 0
    else if dailyVolatilityMethod == "ATR比率"
        if _valid and not na(atr) and atr > 0
            float _ratio = rng / atr
            float _lo = math.min(dailyLowAtrRatio, dailyHighAtrRatio)
            float _hi = math.max(dailyLowAtrRatio, dailyHighAtrRatio)
            _code := _ratio >= _hi ? 1 : _ratio <= _lo ? -1 : 0
    else
        // 固定値 (しきい値が逆転していても min/max で安全化)
        //   境界 : rng >= _hi → 高ボラ / rng < _lo → 低ボラ / それ以外 → 中ボラ。
        //   (低は < なので 80.0 ちょうどは中ボラ・140.0 ちょうどは高ボラ)
        if _valid
            float _lo = math.min(dailyLowRangeMax, dailyHighRangeMin)
            float _hi = math.max(dailyLowRangeMax, dailyHighRangeMin)
            _code := rng >= _hi ? 1 : rng < _lo ? -1 : 0
    _code

// --- 日足 OHLC / ATR / 値幅 / パーセンタイルしきい値 を 1回の security で取得 ---
//   返り値 : 当日足(判定対象=当日)の8値 + 前日足(判定対象=前日)の8値。
//   パーセンタイルしきい値は判定対象日自身を分布から除外するため [1] を掛ける。
//     _loThrCur = percentile(rng, N)[1] … 当日を除いた過去N日分布の下限しきい値。
//     前日判定用は同式の [1] (= percentile[2]) で前日自身を分布から除外。
//   ※ security は lookahead_off。前日値は式側で [1] を掛けているので非リペイント。
f_drDailyTuple() =>
    float _o = open
    float _h = high
    float _l = low
    float _c = close
    float _a = ta.atr(dailyAtrLen)
    float _r = _h - _l
    float _loThr = na
    float _hiThr = na
    if dailyVolatilityMethod == "パーセンタイル"
        _loThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyLowPercentile)[1]
        _hiThr := ta.percentile_linear_interpolation(_r, dailyVolLookback, dailyHighPercentile)[1]
    [_o, _h, _l, _c, _a, _r, _loThr, _hiThr, _o[1], _h[1], _l[1], _c[1], _a[1], _r[1], _loThr[1], _hiThr[1]]

// --- 出力 (OFF/非アクティブ時の安全デフォルト) ---
bool dailyRegimeLongOk  = true
bool dailyRegimeShortOk = true
bool dailyRegimeOk      = true
// 判定用ホルダ (drDirCodeAdj/drVolCodeAdj は方向・ボラ判定、drRange/drDailyATR はボラ算出に使用)
int   drDirCodeAdj = na
int   drVolCodeAdj = na
float drRange   = na
float drDailyATR = na

// フィルターが有効なときだけ日足を計算する
bool drActive = useDailyRegimeFilter

if drActive
    [_o0, _h0, _l0, _c0, _a0, _r0, _loT0, _hiT0, _o1, _h1, _l1, _c1, _a1, _r1, _loT1, _hiT1] = request.security(syminfo.tickerid, "D", f_drDailyTuple(), lookahead = barmerge.lookahead_off)

    // --- 当日進行中 の累積 始値/高値/安値 (チャートTFで計算・非リペイント) ---
    //   日付が変わったら当日高安をリセットし、以降は現在足まで累積更新する。
    //   参照するのは「その足までに確定した高値/安値」だけ = 未来参照なし。
    var float drCurDayOpen = na
    var float drCurDayHigh = na
    var float drCurDayLow  = na
    bool drNewDay = ta.change(time("D")) != 0
    if drNewDay or na(drCurDayHigh)
        drCurDayOpen := open
        drCurDayHigh := high
        drCurDayLow  := low
    else
        drCurDayHigh := math.max(drCurDayHigh, high)
        drCurDayLow  := math.min(drCurDayLow, low)
    float drIntradayRange = drCurDayHigh - drCurDayLow

    // 判定対象日の選択 :
    //   前日確定ベース   = 確定済み前日足
    //   当日進行中ベース = 当日始値〜現在足の累積 (ボラ=累積値幅 / ATR・percentile は確定済み過去)
    //   当日確定後分析   = 当日(完成)足
    bool drUsePrev  = dailyRegimeMode == "前日確定ベース"
    bool drUseIntra = dailyRegimeMode == "当日進行中ベース"

    // 方向用 OHLC (方向とボラで参照値を分離)
    //   当日進行中は当日累積OHLC (始値=当日始値 / 高安=累積 / 終値=現在close)。未来参照なし。
    float drO = drUsePrev ? _o1 : drUseIntra ? drCurDayOpen : _o0
    float drH = drUsePrev ? _h1 : drUseIntra ? drCurDayHigh : _h0
    float drL = drUsePrev ? _l1 : drUseIntra ? drCurDayLow  : _l0
    float drC = drUsePrev ? _c1 : drUseIntra ? close        : _c0

    // ボラ用 値幅 / ATR / パーセンタイルしきい値
    //   当日進行中の値幅 = 当日累積値幅 (drIntradayRange)。
    //   当日進行中のATR  = 確定済み前日日足ATR (_a1) を使い、当日未確定の日足ATRによる
    //                      未来参照・リペイントを回避。
    //   percentile しきい値 = 当日を分布から除外した当日slot (_loT0/_hiT0)。
    //                        (これは前日確定日足時点の percentile なので当日進行中も非リペイント)
    drRange    := drUsePrev ? _r1 : drUseIntra ? drIntradayRange : _r0
    drDailyATR := drUsePrev ? _a1 : drUseIntra ? _a1 : _a0
    float drLoThr = drUsePrev ? _loT1 : _loT0
    float drHiThr = drUsePrev ? _hiT1 : _hiT0

    // 分類
    int drDirCode = f_drDirCode(drO, drH, drL, drC)
    int drVolCode = f_drVolCode(drRange, drDailyATR, drLoThr, drHiThr)
    bool drDirInsufficient = na(drDirCode)
    bool drVolInsufficient = na(drVolCode)
    // データ不足時の扱い : レンジ扱い(方向=レンジ/ボラ=中) or na のまま
    drDirCodeAdj := drDirInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drDirCode
    drVolCodeAdj := drVolInsufficient ? (dailyInsufficientAsRange ? 0 : na) : drVolCode

    // 一致判定 (要求OFFの軸は常に一致)
    string drDirText = f_dailyDirectionText(drDirCodeAdj)
    string drVolText = f_dailyVolatilityText(drVolCodeAdj)
    bool directionMatch  = reqDailyDirection  == "OFF" or drDirText == reqDailyDirection
    bool volatilityMatch = reqDailyVolatility == "OFF" or drVolText == reqDailyVolatility
    // データ不足を「レンジ扱いしない」設定のとき、要求している軸が不足なら不一致
    bool drDirBlock = reqDailyDirection  != "OFF" and drDirInsufficient and not dailyInsufficientAsRange
    bool drVolBlock = reqDailyVolatility != "OFF" and drVolInsufficient and not dailyInsufficientAsRange
    dailyRegimeOk := not useDailyRegimeFilter or (directionMatch and volatilityMatch and not drDirBlock and not drVolBlock)

// 最終出力 : 前日確定ベース と 当日進行中ベース は売買に接続 (どちらも未来参照なし)。
//   当日確定後分析は常に true = エントリー制限に接続しない (未来参照回避・表示専用)。
bool drTradeConnected = dailyRegimeMode == "前日確定ベース" or dailyRegimeMode == "当日進行中ベース"
if drTradeConnected
    dailyRegimeLongOk  := dailyRegimeOk
    dailyRegimeShortOk := dailyRegimeOk

// ============================================================
//  10. 最終エントリー条件
// ------------------------------------------------------------
//  設計順序 : 日足レジーム → 環境認識 → WinZone(FVG/出来高) → Momentum(勢い) → Trigger(価格) → Entry
//    ・envLongOk           = どちら向きに狙うか (環境認識)
//    ・longWinZoneOk       = どこで狙うか (FVG / 出来高POC・場所条件)
//    ・allowLongByMomentum = 勢いが反転したか (ストキャス・状態保持)
//    ・allowLongByTrigger  = 価格が実際に反応したか (EMA/包み足/ピンバー・最後の引き金)
//    ・volOk / risk / qty  = 執行フィルタ
//  ※ AND条件なので数式結果は順序に依らないが、思想順に並べる。
// ============================================================
bool longSig  = allowLongByTrigger
bool shortSig = allowShortByTrigger

// --- 時間帯フィルタ (東京時間 JST) ---
//   Asia 09:00-16:00 / EU 16:00-21:00 / NY 21:00-翌03:00 の中だけ許可。
int  jstHour   = hour(time, "Asia/Tokyo")
bool inAsia    = jstHour >= 9  and jstHour < 16
bool inEU      = jstHour >= 16 and jstHour < 21
bool inNY      = jstHour >= 21 or  jstHour < 3
bool sessionOk =
     not useSessionFilter or
     (useAsiaSession and inAsia) or
     (useEUSession   and inEU) or
     (useNYSession   and inNY)

bool canLong =
     useLong and
     dailyRegimeLongOk and
     sessionOk and
     envLongOk and
     longWinZoneOk and
     allowLongByMomentum and
     allowLongByTrigger and
     volOk and
     not lineNoTradeLong and
     longRisk > 0 and
     longQty >= 1

bool canShort =
     useShort and
     dailyRegimeShortOk and
     sessionOk and
     envShortOk and
     shortWinZoneOk and
     allowShortByMomentum and
     allowShortByTrigger and
     volOk and
     not lineNoTradeShort and
     shortRisk > 0 and
     shortQty >= 1

// ============================================================
//  11. 発注 (ピラミッディング対応)
// ------------------------------------------------------------
//  ・同方向へは strategy(pyramiding=) の上限まで積み増し可能 (ピラミッディング)。
//    pyramiding=1 なら積み増しなし = 従来動作 (ノーポジ時のみ1回)。
//  ・反対方向を保有中は新規を入れない (ドテンしない)。
//  ・各建玉は固有IDを持ち、SL/TP を1本ずつ独立して管理する。
//  ・同一バーでロング・ショートが両方成立したら、そのバーのローソク方向で
//    1方向に確定し二重発注(ドテン)を防ぐ (陽線→ロング / 陰線→ショート)。
//  ・積み増し上限は strategy() の pyramiding 入力が最終的に強制する
//    (上限到達後の追加 strategy.entry は自動で拒否される)。
// ============================================================
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

// 同一バー両成立は矛盾なので、そのバーのローソク方向で1方向に確定
bool wantLong  = canLong
bool wantShort = canShort
if wantLong and wantShort
    if close >= open
        wantShort := false
    else
        wantLong := false

// 反対方向を保有中は追加しない (ドテン防止)。同方向 or ノーポジのみ追加可。
//   同時に、現在の建玉数が maxPyramiding 未満のときだけ追加を許可する。
//   ※ 反対方向は同時に持たない設計なので strategy.opentrades = 現在方向の建玉数。
bool underPyrLimit = strategy.opentrades < maxPyramiding
bool okAddLong  = (posFlat or posLong)  and underPyrLimit
bool okAddShort = (posFlat or posShort) and underPyrLimit

// 各エントリーへ固有IDを付与 → SL/TP を独立管理。積み増し上限は maxPyramiding が制御。
var int pyrSeq = 0

if okAddLong and wantLong
    pyrSeq += 1
    string _idL = "L" + str.tostring(pyrSeq)
    strategy.entry(_idL, strategy.long, qty = longQty)
    strategy.exit(_idL + "X", from_entry = _idL, stop = longStop, limit = longTP)
    // エントリー後、同じFVG状態で再入しないよう状態をリセット
    if resetFVGStateAfterEntry
        longFVGStateOk := false
    // エントリー後、同じ出来高状態で再入しないよう状態をリセット
    if resetVolumeStateAfterEntry
        longVolumeStateOk := false
    // エントリー後、同じフィボ状態で再入しないよう状態をリセット
    if resetFibStateAfterEntry
        longFibStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochLongStateOk := false
    // エントリー後、同じMACD状態で再入しないよう状態をリセット
    if useMACDModule and resetMACDStateAfterEntry
        longMACDStateOk := false

if okAddShort and wantShort
    pyrSeq += 1
    string _idS = "S" + str.tostring(pyrSeq)
    strategy.entry(_idS, strategy.short, qty = shortQty)
    strategy.exit(_idS + "X", from_entry = _idS, stop = shortStop, limit = shortTP)
    // エントリー後、同じFVG状態で再入しないよう状態をリセット
    if resetFVGStateAfterEntry
        shortFVGStateOk := false
    // エントリー後、同じ出来高状態で再入しないよう状態をリセット
    if resetVolumeStateAfterEntry
        shortVolumeStateOk := false
    // エントリー後、同じフィボ状態で再入しないよう状態をリセット
    if resetFibStateAfterEntry
        shortFibStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochShortStateOk := false
    // エントリー後、同じMACD状態で再入しないよう状態をリセット
    if useMACDModule and resetMACDStateAfterEntry
        shortMACDStateOk := false

// --- 状態管理: エントリー後リセット (エントリー成立足だけ・入った方向だけ) ---
bool didEnterLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool didEnterShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
// EMA WinZone
if useEMAWZ and resetEMAStateAfterEntry and didEnterLong
    emaLongState     := false
    emaLongStateBar  := na
    emaLongWinZone   := false
if useEMAWZ and resetEMAStateAfterEntry and didEnterShort
    emaShortState    := false
    emaShortStateBar := na
    emaShortWinZone  := false
// 水平線 WinZone
if useLineWZ and resetLineStateAfterEntry and didEnterLong
    lineLongStateBar := na
if useLineWZ and resetLineStateAfterEntry and didEnterShort
    lineShortStateBar := na

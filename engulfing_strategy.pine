// --- A: Extreme Reversal ---
grpStochA = "Momentum: A Extreme Reversal"
useExtremeSlopeTurn = input.bool(true, "傾き反転で確認", group = grpStochA)
useExtremeKDCross   = input.bool(true, "K/Dクロスで確認", group = grpStochA)
extremeLookback     = input.int(5, "Extreme 到達 参照本数", minval = 1, group = grpStochA)
useExtremeOneShot   = input.bool(true, "Extreme 一回だけ発火", group = grpStochA)
extremeResetLevelHigh = input.float(80, "High リセットレベル", group = grpStochA)
extremeResetLevelLow  = input.float(20, "Low リセットレベル", group = grpStochA)
useSlopeStrengthFilter = input.bool(false, "折り返し角度フィルター", group = grpStochA)
stochSlopeMin          = input.float(2.0, "最小スロープ(|ΔK|)", minval = 0.0, step = 0.5, group = grpStochA)
useExtremeRetraceFilter = input.bool(false, "戻り量フィルター", group = grpStochA)
extremeRetraceMin       = input.float(5.0, "最小戻り量(ポイント)", minval = 0.0, step = 0.5, group = grpStochA)

// --- D: Stickiness / Divergence / 共通フィルター ---
grpStochD = "Momentum: D/Div/共通"
stickBars   = input.int(5, "Stickiness 張り付き本数", minval = 1, group = grpStochD)
divPivotLen = input.int(5, "Div Pivot 長さ", minval = 1, group = grpStochD)
divLookback = input.int(30, "Div Pivot 間 最大本数", minval = 1, group = grpStochD)
useKDirectionFilter = input.bool(false, "K傾きフィルター", group = grpStochD)
useKDRelationFilter = input.bool(false, "K/D位置フィルター", group = grpStochD)

// ============================================================
// 4. 入力 : リスク / 決済
// ============================================================
grpRisk = "リスク / 決済"
riskPct     = input.float(5.0, "1トレード損失率 (%)", minval = 0.1, step = 0.1, group = grpRisk)
useCompound = input.bool(false, "複利 (残高ベース) ※OFF=元金単利", group = grpRisk)
slMode      = input.string("固定", "SL方式", options = ["パターン", "固定"], group = grpRisk)
slBuf       = input.float(0.0, "SL バッファ (価格) ※パターン時", minval = 0.0, step = 0.1, group = grpRisk)
slFixed     = input.float(10, "固定SL幅 (価格) ※固定時", minval = 0.0, step = 0.1, group = grpRisk)
rrRatio     = input.float(1.0, "リスクリワード比 (TP)", minval = 0.1, step = 0.1, group = grpRisk)

// ============================================================
// 4b. 入力 : 時間帯フィルタ (東京時間 JST 基準)
// ------------------------------------------------------------
// シグナルを出す時間帯をセッション単位で制限する。
// 東京時間 (Asia/Tokyo) で判定 :
//   アジア 09:00-16:00 / EU 16:00-21:00 / NY 21:00-翌03:00
// ※ NY は日跨ぎ。03:00-09:00 はどのセッションにも属さず除外。
// ============================================================
grpSession = "時間帯フィルタ (東京時間)"
useSessionFilter = input.bool(true, "時間帯フィルタを使う", group = grpSession)
useAsiaSession   = input.bool(true, "アジア 09:00-16:00", group = grpSession)
useEUSession     = input.bool(true, "EU 16:00-21:00", group = grpSession)
useNYSession     = input.bool(true, "NY 21:00-翌03:00", group = grpSession)

// ============================================================
// 5. 包み足判定
// ============================================================
bool prevUp = close[1] > open[1]
bool prevDn = close[1] < open[1]
bool curUp  = close > open
bool curDn  = close < open

float curBodyHi  = math.max(open, close)
float curBodyLo  = math.min(open, close)
float prevBodyHi = math.max(open[1], close[1])
float prevBodyLo = math.min(open[1], close[1])

bool engulfBody = curBodyHi >= prevBodyHi and curBodyLo <= prevBodyLo

bool bullEngulf = curUp and (not reqOppColor or prevDn) and (strictEngulf ? engulfBody : close >= prevBodyHi)
bool bearEngulf = curDn and (not reqOppColor or prevUp) and (strictEngulf ? engulfBody : close <= prevBodyLo)

// ============================================================
// 5b. FVG 場所検知 (フィルター用)
// ------------------------------------------------------------
// FVG はエントリートリガーではなく「場所条件」として使う。
// useFVGFilter を使う時、または box 表示時のみ配列・ループを動かす。
// ============================================================
bool useFVG = useFVGFilter or showFVGBoxes

// --- FVGヘルパー ---
f_fvgThick(float width, float atrVal) =>
    not useFVGThicknessFilter or width >= atrVal * fvgMinThicknessATR

f_nearestAbove(array<float> botArr, array<bool> deadArr, float price) =>
    float best = na
    if array.size(botArr) > 0
        for i = 0 to array.size(botArr) - 1
            if not array.get(deadArr, i)
                float b = array.get(botArr, i)
                if b > price
                    best := na(best) ? (b - price) : math.min(best, b - price)
    best

f_nearestBelow(array<float> topArr, array<bool> deadArr, float price) =>
    float best = na
    if array.size(topArr) > 0
        for i = 0 to array.size(topArr) - 1
            if not array.get(deadArr, i)
                float t = array.get(topArr, i)
                if t < price
                    best := na(best) ? (price - t) : math.min(best, price - t)
    best

f_fvgTrim(array<float> topA, array<float> botA, array<int> barA, array<bool> rebA, array<bool> absA, array<bool> deadA, array<box> boxA, array<bool> waitA, array<bool> entryA, array<int> absBarA) =>
    while array.size(topA) > maxFVGPerSide
        box b = array.shift(boxA)
        if not na(b)
            box.delete(b)
        array.shift(topA)
        array.shift(botA)
        array.shift(barA)
        array.shift(rebA)
        array.shift(absA)
        array.shift(deadA)
        array.shift(waitA)
        array.shift(entryA)
        array.shift(absBarA)

// --- FVG 保存配列 ---
var array<float> bullTopArr      = array.new_float()
var array<float> bullBotArr      = array.new_float()
var array<int>   bullBarArr      = array.new_int()
var array<bool>  bullRebUsed     = array.new_bool()
var array<bool>  bullAbsUsed     = array.new_bool()
var array<bool>  bullDeadArr     = array.new_bool()
var array<box>   bullBoxArr      = array.new_box()
var array<bool>  bullAbsWaiting  = array.new_bool()   // 吸収済み・包み足待機中
var array<bool>  bullAbsEntryUsed = array.new_bool()  // 吸収後の包み足エントリー使用済み
var array<int>   bullAbsBar      = array.new_int()    // 吸収成立バー

var array<float> bearTopArr      = array.new_float()
var array<float> bearBotArr      = array.new_float()
var array<int>   bearBarArr      = array.new_int()
var array<bool>  bearRebUsed     = array.new_bool()
var array<bool>  bearAbsUsed     = array.new_bool()
var array<bool>  bearDeadArr     = array.new_bool()
var array<box>   bearBoxArr      = array.new_box()
var array<bool>  bearAbsWaiting  = array.new_bool()
var array<bool>  bearAbsEntryUsed = array.new_bool()
var array<int>   bearAbsBar      = array.new_int()

// FVG シグナル (種類別)
bool fvgReboundBuy  = false
bool fvgReboundSell = false
bool fvgAbsorbBuy   = false
bool fvgAbsorbSell  = false
bool ifvgBuy        = false
bool ifvgSell       = false

// 吸収待機中フラグ (デバッグ用)
bool bullAbsWaitingNow = false
bool bearAbsWaitingNow = false

if useFVG
    float fvgAtr = ta.atr(fvgAtrLen)
    float rng    = high - low
    float bodyF  = math.abs(close - open)
    float clPos  = rng > 0 ? (close - low) / rng : 0.5
    bool  confBar = not useFVGConfirmBar or barstate.isconfirmed

    // ---- Bullish FVG 処理 (反発BUY / 吸収SELL / iFVG SELL) ----
    if useBullishFVG and array.size(bullTopArr) > 0
        for i = 0 to array.size(bullTopArr) - 1
            float top  = array.get(bullTopArr, i)
            float bot  = array.get(bullBotArr, i)
            int   bbar = array.get(bullBarArr, i)
            bool  rUsed = array.get(bullRebUsed, i)
            bool  aUsed = array.get(bullAbsUsed, i)
            bool  dead  = array.get(bullDeadArr, i)
            float width = top - bot
            int   age   = bar_index - bbar
            // 古すぎる FVG を dead 化 (既存)
            if useFVGAgeFilter and not dead and age > fvgMaxAge
                dead := true
                array.set(bullDeadArr, i, true)
            // シグナルを出してよい年齢範囲か
            bool ageWindowOk = not useFVGActiveWindow or (age >= fvgActiveMinAge and age <= fvgActiveMaxAge)
            // 1. 反発/吸収/iFVG 判定 (有効期間内のみ)
            if not dead and confBar and ageWindowOk
                // 反発 BUY (サポート) : 回復位置 close >= bot + width*reboundRecoverRatio。反発は1回まで。
                if useFVGReboundFilter and not rUsed
                    float depth = (low < bot and width > 0) ? (bot - low) / width : 0.0
                    if low <= top and depth <= reboundDepthMax and close >= bot + width * reboundRecoverRatio and close > open
                        bool blocked = false
                        if useOppositeFVGFilter
                            float d = f_nearestAbove(bearBotArr, bearDeadArr, close)
                            blocked := not na(d) and d <= fvgAtr * oppositeFVGNearATR
                        if not blocked
                            fvgReboundBuy := true
                            array.set(bullRebUsed, i, true)
                // 吸収 SELL (下抜け) 成立 : シグナルは出さず「待機状態」にする。吸収は1回まで。
                if useFVGAbsorptionFilter and not aUsed
                    float absorbSellLevel = bot - (useAbsorbCloseBuffer ? fvgAtr * absorbCloseBufferATR : 0.0)
                    bool absorbSellCloseOk = close < absorbSellLevel
                    bool absorbSellConfirmOk = true
                    if useAbsorbConfirmBars
                        for j = 0 to absorbConfirmBars - 1
                            absorbSellConfirmOk := absorbSellConfirmOk and close[j] < absorbSellLevel
                    if absorbSellCloseOk and absorbSellConfirmOk and rng > 0 and (bodyF / rng) >= absorbBodyMinRatio and clPos <= absorbCloseEdgeRatio
                        array.set(bullAbsUsed, i, true)
                        array.set(bullAbsWaiting, i, true)
                        array.set(bullAbsBar, i, bar_index)
                // iFVG SELL (吸収済みをレジスタンス)
                if useIFVGFilter and not dead and array.get(bullAbsUsed, i)
                    if high >= bot and close < open and close <= top
                        ifvgSell := true
                        array.set(bullDeadArr, i, true)
            // 1b. 吸収待機中 → 最初の包み足(bearEngulf)でSELLシグナル。期限切れは待機解除。
            if useFVGAbsorptionFilter and not dead and confBar and array.get(bullAbsWaiting, i) and not array.get(bullAbsEntryUsed, i)
                int  absBar = array.get(bullAbsBar, i)
                bool absorbWindowOk = not useAbsorbEntryWindow or (not na(absBar) and bar_index - absBar <= absorbEntryMaxBars)
                if not absorbWindowOk
                    array.set(bullAbsWaiting, i, false)
                else if bearEngulf and close <= top and bar_index - absBar >= 1
                    fvgAbsorbSell := true
                    array.set(bullAbsEntryUsed, i, true)
                    array.set(bullAbsWaiting, i, false)
            if array.get(bullAbsWaiting, i)
                bullAbsWaitingNow := true
            // 2. 完全埋め (終値基準 close <= bot) なら dead 化。
            //    ヒゲで埋めても終値で埋めるまでは生存。吸収済み(iFVG候補/待機中)は残す。
            if not array.get(bullDeadArr, i) and not array.get(bullAbsUsed, i) and close <= bot
                array.set(bullDeadArr, i, true)

    // ---- Bearish FVG 処理 (反発SELL / 吸収BUY / iFVG BUY) ----
    if useBearishFVG and array.size(bearTopArr) > 0
        for i = 0 to array.size(bearTopArr) - 1
            float top  = array.get(bearTopArr, i)
            float bot  = array.get(bearBotArr, i)
            int   bbar = array.get(bearBarArr, i)
            bool  rUsed = array.get(bearRebUsed, i)
            bool  aUsed = array.get(bearAbsUsed, i)
            bool  dead  = array.get(bearDeadArr, i)
            float width = top - bot
            int   age   = bar_index - bbar
            // 古すぎる FVG を dead 化 (既存)
            if useFVGAgeFilter and not dead and age > fvgMaxAge
                dead := true
                array.set(bearDeadArr, i, true)
            // シグナルを出してよい年齢範囲か
            bool ageWindowOk = not useFVGActiveWindow or (age >= fvgActiveMinAge and age <= fvgActiveMaxAge)
            // 1. 反発/吸収/iFVG 判定 (有効期間内のみ)
            if not dead and confBar and ageWindowOk
                // 反発 SELL (レジスタンス) : 回復位置 close <= top - width*reboundRecoverRatio。反発は1回まで。
                if useFVGReboundFilter and not rUsed
                    float depth = (high > top and width > 0) ? (high - top) / width : 0.0
                    if high >= bot and depth <= reboundDepthMax and close <= top - width * reboundRecoverRatio and close < open
                        bool blocked = false
                        if useOppositeFVGFilter
                            float d = f_nearestBelow(bullTopArr, bullDeadArr, close)
                            blocked := not na(d) and d <= fvgAtr * oppositeFVGNearATR
                        if not blocked
                            fvgReboundSell := true
                            array.set(bearRebUsed, i, true)
                // 吸収 BUY (上抜け) 成立 : シグナルは出さず「待機状態」にする。吸収は1回まで。
                if useFVGAbsorptionFilter and not aUsed
                    float absorbBuyLevel = top + (useAbsorbCloseBuffer ? fvgAtr * absorbCloseBufferATR : 0.0)
                    bool absorbBuyCloseOk = close > absorbBuyLevel
                    bool absorbBuyConfirmOk = true
                    if useAbsorbConfirmBars
                        for j = 0 to absorbConfirmBars - 1
                            absorbBuyConfirmOk := absorbBuyConfirmOk and close[j] > absorbBuyLevel
                    if absorbBuyCloseOk and absorbBuyConfirmOk and rng > 0 and (bodyF / rng) >= absorbBodyMinRatio and clPos >= (1.0 - absorbCloseEdgeRatio)
                        array.set(bearAbsUsed, i, true)
                        array.set(bearAbsWaiting, i, true)
                        array.set(bearAbsBar, i, bar_index)
                // iFVG BUY (吸収済みをサポート)
                if useIFVGFilter and not dead and array.get(bearAbsUsed, i)
                    if low <= top and close > open and close >= bot
                        ifvgBuy := true
                        array.set(bearDeadArr, i, true)
            // 1b. 吸収待機中 → 最初の包み足(bullEngulf)でBUYシグナル。期限切れは待機解除。
            if useFVGAbsorptionFilter and not dead and confBar and array.get(bearAbsWaiting, i) and not array.get(bearAbsEntryUsed, i)
                int  absBar = array.get(bearAbsBar, i)
                bool absorbWindowOk = not useAbsorbEntryWindow or (not na(absBar) and bar_index - absBar <= absorbEntryMaxBars)
                if not absorbWindowOk
                    array.set(bearAbsWaiting, i, false)
                else if bullEngulf and close >= bot and bar_index - absBar >= 1
                    fvgAbsorbBuy := true
                    array.set(bearAbsEntryUsed, i, true)
                    array.set(bearAbsWaiting, i, false)
            if array.get(bearAbsWaiting, i)
                bearAbsWaitingNow := true
            // 2. 完全埋め (終値基準 close >= top) なら dead 化。
            //    ヒゲで埋めても終値で埋めるまでは生存。吸収済み(iFVG候補/待機中)は残す。
            if not array.get(bearDeadArr, i) and not array.get(bearAbsUsed, i) and close >= top
                array.set(bearDeadArr, i, true)

    // ---- 新規 FVG 検出・保存 (判定後 → 生成足では発火しない) ----
    if useBullishFVG and low > high[2]
        float bTop = low
        float bBot = high[2]
        float w = bTop - bBot
        if w > 0 and f_fvgThick(w, fvgAtr)
            box bx = showFVGBoxes ? box.new(bar_index - 2, bTop, bar_index, bBot, border_color = color.new(color.teal, 50), bgcolor = color.new(color.teal, 80)) : na
            array.push(bullTopArr, bTop)
            array.push(bullBotArr, bBot)
            array.push(bullBarArr, bar_index)
            array.push(bullRebUsed, false)
            array.push(bullAbsUsed, false)
            array.push(bullDeadArr, false)
            array.push(bullBoxArr, bx)
            array.push(bullAbsWaiting, false)
            array.push(bullAbsEntryUsed, false)
            array.push(bullAbsBar, na)
            f_fvgTrim(bullTopArr, bullBotArr, bullBarArr, bullRebUsed, bullAbsUsed, bullDeadArr, bullBoxArr, bullAbsWaiting, bullAbsEntryUsed, bullAbsBar)
    if useBearishFVG and high < low[2]
        float sTop = low[2]
        float sBot = high
        float w = sTop - sBot
        if w > 0 and f_fvgThick(w, fvgAtr)
            box bx = showFVGBoxes ? box.new(bar_index - 2, sTop, bar_index, sBot, border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 80)) : na
            array.push(bearTopArr, sTop)
            array.push(bearBotArr, sBot)
            array.push(bearBarArr, bar_index)
            array.push(bearRebUsed, false)
            array.push(bearAbsUsed, false)
            array.push(bearDeadArr, false)
            array.push(bearBoxArr, bx)
            array.push(bearAbsWaiting, false)
            array.push(bearAbsEntryUsed, false)
            array.push(bearAbsBar, na)
            f_fvgTrim(bearTopArr, bearBotArr, bearBarArr, bearRebUsed, bearAbsUsed, bearDeadArr, bearBoxArr, bearAbsWaiting, bearAbsEntryUsed, bearAbsBar)

    // ---- box 右端更新 ----
    if showFVGBoxes
        if array.size(bullBoxArr) > 0
            for i = 0 to array.size(bullBoxArr) - 1
                box bx = array.get(bullBoxArr, i)
                if not na(bx)
                    box.set_right(bx, bar_index)
        if array.size(bearBoxArr) > 0
            for i = 0 to array.size(bearBoxArr) - 1
                box bx = array.get(bearBoxArr, i)
                if not na(bx)
                    box.set_right(bx, bar_index)

// --- 集約 (互換用) ---
bool fvgBuy  = fvgReboundBuy  or fvgAbsorbBuy  or ifvgBuy
bool fvgSell = fvgReboundSell or fvgAbsorbSell or ifvgSell

// --- FVGイベントOK (そのバー限定) : 状態管理 OFF 時の従来判定に使う ---
bool longFVGEventOk  = (useFVGReboundFilter and fvgReboundBuy) or (useFVGAbsorptionFilter and fvgAbsorbBuy) or (useIFVGFilter and ifvgBuy)
bool shortFVGEventOk = (useFVGReboundFilter and fvgReboundSell) or (useFVGAbsorptionFilter and fvgAbsorbSell) or (useIFVGFilter and ifvgSell)

// --- FVG状態管理 : イベント発生後、一定本数だけ「FVG条件OK」を保持 ---
// 反発・吸収・iFVG のいずれかが出たら状態ONにし、fvgStateMaxBars 本まで維持。
// その期間内に包み足が出ればエントリー可能になる (シグナルの単バー限定を緩和)。
// ※ 状態のセット/リセットのみ。FVG検出・反発・吸収・iFVG判定自体は不変。
var bool   longFVGStateOk   = false
var bool   shortFVGStateOk  = false
var int    longFVGStateBar  = na
var int    shortFVGStateBar = na
var string longFVGStateType  = ""
var string shortFVGStateType = ""

if useFVGStateWindow
    // 1. イベント発生 → 状態ON
    if longFVGEventOk
        longFVGStateOk := true
        longFVGStateBar := bar_index
        longFVGStateType := fvgReboundBuy ? "rebound" : fvgAbsorbBuy ? "absorb" : "ifvg"
    if shortFVGEventOk
        shortFVGStateOk := true
        shortFVGStateBar := bar_index
        shortFVGStateType := fvgReboundSell ? "rebound" : fvgAbsorbSell ? "absorb" : "ifvg"
    // 2. 有効期限切れ → 状態OFF
    if longFVGStateOk and not na(longFVGStateBar) and (bar_index - longFVGStateBar > fvgStateMaxBars)
        longFVGStateOk := false
    if shortFVGStateOk and not na(shortFVGStateBar) and (bar_index - shortFVGStateBar > fvgStateMaxBars)
        shortFVGStateOk := false

// --- FVG 場所フィルター条件 ---
// useFVGFilter = false … 常に許可
// useFVGFilter = true かつ useFVGStateWindow=false … 従来のイベント単バー判定
// useFVGFilter = true かつ useFVGStateWindow=true … 状態管理フラグを使う
bool longFVGOk  = not useFVGFilter or (useFVGStateWindow ? longFVGStateOk  : longFVGEventOk)
bool shortFVGOk = not useFVGFilter or (useFVGStateWindow ? shortFVGStateOk : shortFVGEventOk)

// ============================================================
// 5b-2. WinZone : Trendline / Channel モジュール (場所フィルター)
// ------------------------------------------------------------
// FVG と同じ WinZone 階層。「どこで狙うか」の場所条件であり Trigger ではない。
// ※ Trigger (bullTrigCount/bearTrigCount/enabledTrigCount) には一切混ぜない。
// useTrendlineModule = false の時は下の if ブロックに入らず、
// ta.atr / pivot / Trendline・Channel・Quality 計算 / 状態管理更新 /
// line / label / table を一切実行しない (完全素通し・軽量)。
// 出力 : trendEntryBuy / trendEntrySell / trendNoTrade /
//        allowLongByTrendline / allowShortByTrendline /
//        trendSignalType / trendDirection / trendRank / trendlineQuality
// ============================================================

// --- ヘルパー関数 (定義はグローバル。呼び出しは if 内のみ) ---
f_tlNear(float price, float level, float rng) =>
    not na(level) and math.abs(price - level) <= rng

f_tlLineValue(int x1, float y1, int x2, float y2, int xNow) =>
    float slope = (y2 - y1) / math.max(x2 - x1, 1)
    y1 + slope * (xNow - x1)

f_tlQualityScore(int touch, int ageBars, float slopeAbsATR, int broken) =>
    int touchScore = touch >= 4 ? 40 : touch == 3 ? 30 : touch >= 2 ? 20 : 0
    int ageScore = (ageBars >= 20 and ageBars <= 150) ? 20 : (ageBars >= 151 and ageBars <= 300) ? 10 : 0
    int slopeScore = na(slopeAbsATR) ? 0 : (slopeAbsATR < minSlopeATR ? 5 : slopeAbsATR > maxSlopeATR ? 5 : 20)
    int brokenScore = broken == 0 ? 20 : broken == 1 ? 10 : 0
    math.min(100, touchScore + ageScore + slopeScore + brokenScore)

f_tlSlopeATR(float p1, int b1, float p2, int b2, float atrv) =>
    atrv != 0 ? math.abs((p2 - p1) / math.max(b2 - b1, 1)) / atrv : na

f_tlUpdateLine(line ln, bool show, int x1, float y1, int x2, float y2, color col) =>
    line result = ln
    if show and not na(y1) and not na(y2)
        if na(result)
            result := line.new(x1, y1, x2, y2, color = col, width = 1)
        else
            line.set_xy1(result, x1, y1)
            line.set_xy2(result, x2, y2)
            line.set_color(result, col)
    else
        if not na(result)
            line.delete(result)
            result := na
    result

f_tlMkLabel(bool isBuy, string txt, color col) =>
    label.new(bar_index, isBuy ? low : high, txt, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, yloc = isBuy ? yloc.belowbar : yloc.abovebar, size = size.small)

f_tlTypeStr(int t) =>
    t == 1 ? "TL Bounce" : t == 2 ? "TL Break" : t == 3 ? "TL Retest" : t == 4 ? "Fake" : t == 5 ? "CH Bounce" : t == 6 ? "CH Break" : t == 7 ? "CH Retest" : t == 8 ? "CH Bias" : t == 9 ? "WeakLine" : "-"

f_tlStateStr(bool uv, bool dv) =>
    uv and dv ? "Up+Down" : uv ? "Up" : dv ? "Down" : "-"

f_tlSelIdxStr(int i) =>
    i == 0 ? "Short" : i == 1 ? "Middle" : i == 2 ? "Long" : "-"

f_tlSlopeStr(int s) =>
    s == 1 ? "Up" : s == -1 ? "Down" : "Flat"

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool trendEntryBuy     = false
bool trendEntrySell    = false
bool trendNoTrade      = false
bool trendNoTradeLong  = false
bool trendNoTradeShort = false
bool trendQualityOk    = true
int  trendSignalType   = 0
int  trendDirection    = 0
int  trendRank         = 0
int  trendlineQuality  = 0

if useTrendlineModule
    // ---- 基礎 ----
    float atr = ta.atr(14)
    float trendTouchRange = trendTouchMode == "ATR" ? atr * trendTouchATR : trendTouchDollar

    // 反転ローソク
    float tl_body   = math.abs(close - open)
    float tl_upWick = high - math.max(open, close)
    float tl_dnWick = math.min(open, close) - low
    bool tl_bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bool tl_bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    bool tl_pinLower = tl_dnWick >= tl_body and tl_dnWick >= tl_upWick
    bool tl_pinUpper = tl_upWick >= tl_body and tl_upWick >= tl_dnWick
    bool bullishReversal = tl_bullEngulf or tl_pinLower or close > open
    bool bearishReversal = tl_bearEngulf or tl_pinUpper or close < open

    // ---- Pivot検知 (確定Pivot / ATR Swing Filter) 直近4点保持 ----
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    float pl = ta.pivotlow(low, pivotLen, pivotLen)

    var float hp1P = na
    var float hp2P = na
    var float hp3P = na
    var float hp4P = na
    var int   hp1B = na
    var int   hp2B = na
    var int   hp3B = na
    var int   hp4B = na
    var float lp1P = na
    var float lp2P = na
    var float lp3P = na
    var float lp4P = na
    var int   lp1B = na
    var int   lp2B = na
    var int   lp3B = na
    var int   lp4B = na

    bool newHighPivot = false
    bool newLowPivot  = false
    if not na(ph)
        if na(hp1P) or not useATRSwingFilter or math.abs(ph - hp1P) >= atr * minSwingATR
            hp4P := hp3P
            hp4B := hp3B
            hp3P := hp2P
            hp3B := hp2B
            hp2P := hp1P
            hp2B := hp1B
            hp1P := ph
            hp1B := bar_index - pivotLen
            newHighPivot := true
    if not na(pl)
        if na(lp1P) or not useATRSwingFilter or math.abs(pl - lp1P) >= atr * minSwingATR
            lp4P := lp3P
            lp4B := lp3B
            lp3P := lp2P
            lp3B := lp2B
            lp2P := lp1P
            lp2B := lp1B
            lp1P := pl
            lp1B := bar_index - pivotLen
            newLowPivot := true

    // ---- 複数Trendline (短期/中期/長期) + Touch / Broken カウンタ ----
    var int upTouchA = 0
    var int upTouchB = 0
    var int upTouchC = 0
    var int upBrokA = 0
    var int upBrokB = 0
    var int upBrokC = 0
    var int upBelowA = 0
    var int upBelowB = 0
    var int upBelowC = 0
    var int dnTouchA = 0
    var int dnTouchB = 0
    var int dnTouchC = 0
    var int dnBrokA = 0
    var int dnBrokB = 0
    var int dnBrokC = 0
    var int dnAboveA = 0
    var int dnAboveB = 0
    var int dnAboveC = 0
    if newLowPivot
        upTouchA := 0
        upTouchB := 0
        upTouchC := 0
        upBrokA := 0
        upBrokB := 0
        upBrokC := 0
        upBelowA := 0
        upBelowB := 0
        upBelowC := 0
    if newHighPivot
        dnTouchA := 0
        dnTouchB := 0
        dnTouchC := 0
        dnBrokA := 0
        dnBrokB := 0
        dnBrokC := 0
        dnAboveA := 0
        dnAboveB := 0
        dnAboveC := 0

    // --- 上昇ライン値 ---
    bool upValidA = not na(lp1P) and not na(lp2P) and lp1B != lp2B
    bool upValidB = not na(lp1P) and not na(lp3P) and lp1B != lp3B
    bool upValidC = not na(lp1P) and not na(lp4P) and lp1B != lp4B
    float upValA = upValidA ? f_tlLineValue(lp2B, lp2P, lp1B, lp1P, bar_index) : na
    float upValB = upValidB ? f_tlLineValue(lp3B, lp3P, lp1B, lp1P, bar_index) : na
    float upValC = upValidC ? f_tlLineValue(lp4B, lp4P, lp1B, lp1P, bar_index) : na
    if not na(upValA)
        if f_tlNear(low, upValA, trendTouchRange) and bullishReversal and close > upValA
            upTouchA := upTouchA + 1
        upBelowA := close < upValA ? upBelowA + 1 : 0
        if upBelowA == breakConfirmBars
            upBrokA := upBrokA + 1
    if not na(upValB)
        if f_tlNear(low, upValB, trendTouchRange) and bullishReversal and close > upValB
            upTouchB := upTouchB + 1
        upBelowB := close < upValB ? upBelowB + 1 : 0
        if upBelowB == breakConfirmBars
            upBrokB := upBrokB + 1
    if not na(upValC)
        if f_tlNear(low, upValC, trendTouchRange) and bullishReversal and close > upValC
            upTouchC := upTouchC + 1
        upBelowC := close < upValC ? upBelowC + 1 : 0
        if upBelowC == breakConfirmBars
            upBrokC := upBrokC + 1

    // --- 下降ライン値 ---
    bool dnValidA = not na(hp1P) and not na(hp2P) and hp1B != hp2B
    bool dnValidB = not na(hp1P) and not na(hp3P) and hp1B != hp3B
    bool dnValidC = not na(hp1P) and not na(hp4P) and hp1B != hp4B
    float dnValA = dnValidA ? f_tlLineValue(hp2B, hp2P, hp1B, hp1P, bar_index) : na
    float dnValB = dnValidB ? f_tlLineValue(hp3B, hp3P, hp1B, hp1P, bar_index) : na
    float dnValC = dnValidC ? f_tlLineValue(hp4B, hp4P, hp1B, hp1P, bar_index) : na
    if not na(dnValA)
        if f_tlNear(high, dnValA, trendTouchRange) and bearishReversal and close < dnValA
            dnTouchA := dnTouchA + 1
        dnAboveA := close > dnValA ? dnAboveA + 1 : 0
        if dnAboveA == breakConfirmBars
            dnBrokA := dnBrokA + 1
    if not na(dnValB)
        if f_tlNear(high, dnValB, trendTouchRange) and bearishReversal and close < dnValB
            dnTouchB := dnTouchB + 1
        dnAboveB := close > dnValB ? dnAboveB + 1 : 0
        if dnAboveB == breakConfirmBars
            dnBrokB := dnBrokB + 1
    if not na(dnValC)
        if f_tlNear(high, dnValC, trendTouchRange) and bearishReversal and close < dnValC
            dnTouchC := dnTouchC + 1
        dnAboveC := close > dnValC ? dnAboveC + 1 : 0
        if dnAboveC == breakConfirmBars
            dnBrokC := dnBrokC + 1

    // 各ライン Quality
    int upQA = upValidA ? f_tlQualityScore(upTouchA, bar_index - lp2B, f_tlSlopeATR(lp2P, lp2B, lp1P, lp1B, atr), upBrokA) : -1
    int upQB = upValidB ? f_tlQualityScore(upTouchB, bar_index - lp3B, f_tlSlopeATR(lp3P, lp3B, lp1P, lp1B, atr), upBrokB) : -1
    int upQC = upValidC ? f_tlQualityScore(upTouchC, bar_index - lp4B, f_tlSlopeATR(lp4P, lp4B, lp1P, lp1B, atr), upBrokC) : -1
    int dnQA = dnValidA ? f_tlQualityScore(dnTouchA, bar_index - hp2B, f_tlSlopeATR(hp2P, hp2B, hp1P, hp1B, atr), dnBrokA) : -1
    int dnQB = dnValidB ? f_tlQualityScore(dnTouchB, bar_index - hp3B, f_tlSlopeATR(hp3P, hp3B, hp1P, hp1B, atr), dnBrokB) : -1
    int dnQC = dnValidC ? f_tlQualityScore(dnTouchC, bar_index - hp4B, f_tlSlopeATR(hp4P, hp4B, hp1P, hp1B, atr), dnBrokC) : -1

    // 上昇: Quality最高(同点は近い方)を採用
    int   selUpIdx = na
    float upTrendlineValue = na
    int   upTrendlineQuality = 0
    int   upTouchCount = 0
    int   upBrokenCount = 0
    float selUpAnchorP = na
    int   selUpAnchorB = na
    if upValidA
        selUpIdx := 0
        upTrendlineValue := upValA
        upTrendlineQuality := upQA
        upTouchCount := upTouchA
        upBrokenCount := upBrokA
        selUpAnchorP := lp2P
        selUpAnchorB := lp2B
    if upValidB and (na(selUpIdx) or upQB > upTrendlineQuality or (upQB == upTrendlineQuality and math.abs(close - upValB) < math.abs(close - upTrendlineValue)))
        selUpIdx := 1
        upTrendlineValue := upValB
        upTrendlineQuality := upQB
        upTouchCount := upTouchB
        upBrokenCount := upBrokB
        selUpAnchorP := lp3P
        selUpAnchorB := lp3B
    if upValidC and (na(selUpIdx) or upQC > upTrendlineQuality or (upQC == upTrendlineQuality and math.abs(close - upValC) < math.abs(close - upTrendlineValue)))
        selUpIdx := 2
        upTrendlineValue := upValC
        upTrendlineQuality := upQC
        upTouchCount := upTouchC
        upBrokenCount := upBrokC
        selUpAnchorP := lp4P
        selUpAnchorB := lp4B
    bool upValid = not na(upTrendlineValue)

    // 下降: 同様
    int   selDnIdx = na
    float downTrendlineValue = na
    int   downTrendlineQuality = 0
    int   downTouchCount = 0
    int   downBrokenCount = 0
    float selDnAnchorP = na
    int   selDnAnchorB = na
    if dnValidA
        selDnIdx := 0
        downTrendlineValue := dnValA
        downTrendlineQuality := dnQA
        downTouchCount := dnTouchA
        downBrokenCount := dnBrokA
        selDnAnchorP := hp2P
        selDnAnchorB := hp2B
    if dnValidB and (na(selDnIdx) or dnQB > downTrendlineQuality or (dnQB == downTrendlineQuality and math.abs(close - dnValB) < math.abs(close - downTrendlineValue)))
        selDnIdx := 1
        downTrendlineValue := dnValB
        downTrendlineQuality := dnQB
        downTouchCount := dnTouchB
        downBrokenCount := dnBrokB
        selDnAnchorP := hp3P
        selDnAnchorB := hp3B
    if dnValidC and (na(selDnIdx) or dnQC > downTrendlineQuality or (dnQC == downTrendlineQuality and math.abs(close - dnValC) < math.abs(close - downTrendlineValue)))
        selDnIdx := 2
        downTrendlineValue := dnValC
        downTrendlineQuality := dnQC
        downTouchCount := dnTouchC
        downBrokenCount := dnBrokC
        selDnAnchorP := hp4P
        selDnAnchorB := hp4B
    bool downValid = not na(downTrendlineValue)

    trendlineQuality := math.max(upTrendlineQuality, downTrendlineQuality)
    bool tl_highQuality = trendlineQuality >= 80

    // ---- Channel計算 (実Pivotを通る平行線) ----
    float upTLatHP = (upValid and not na(hp1B)) ? f_tlLineValue(selUpAnchorB, selUpAnchorP, lp1B, lp1P, hp1B) : na
    float upOffset = (not na(upTLatHP) and not na(hp1P)) ? math.abs(hp1P - upTLatHP) : na
    float upChannelLower = upTrendlineValue
    float upChannelUpper = (not na(upTrendlineValue) and not na(upOffset)) ? upTrendlineValue + upOffset : na
    float downTLatLP = (downValid and not na(lp1B)) ? f_tlLineValue(selDnAnchorB, selDnAnchorP, hp1B, hp1P, lp1B) : na
    float downOffset = (not na(downTLatLP) and not na(lp1P)) ? math.abs(lp1P - downTLatLP) : na
    float downChannelUpper = downTrendlineValue
    float downChannelLower = (not na(downTrendlineValue) and not na(downOffset)) ? downTrendlineValue - downOffset : na
    float upChannelWidth   = (not na(upChannelUpper) and not na(upChannelLower)) ? upChannelUpper - upChannelLower : na
    float downChannelWidth = (not na(downChannelUpper) and not na(downChannelLower)) ? downChannelUpper - downChannelLower : na

    // Channel Slope (採用ラインの符号付き傾き / 本)
    float upSlopeSigned   = upValid   ? (lp1P - selUpAnchorP) / math.max(lp1B - selUpAnchorB, 1) : na
    float downSlopeSigned = downValid ? (hp1P - selDnAnchorP) / math.max(hp1B - selDnAnchorB, 1) : na
    float slopeFlatTh = atr * minSlopeATR
    bool activeUp = upValid
    float channelSlope = activeUp ? upSlopeSigned : downSlopeSigned
    int channelSlopeState = na(channelSlope) ? 0 : channelSlope > slopeFlatTh ? 1 : channelSlope < -slopeFlatTh ? -1 : 0

    // ---- 接近判定 ----
    bool nearUpTrendline   = f_tlNear(low,  upTrendlineValue, trendTouchRange)
    bool nearDownTrendline = f_tlNear(high, downTrendlineValue, trendTouchRange)
    bool nearUpChannelLower = f_tlNear(low,  upChannelLower, trendTouchRange)
    bool nearUpChannelUpper = f_tlNear(high, upChannelUpper, trendTouchRange)
    bool nearDownChannelUpper = f_tlNear(high, downChannelUpper, trendTouchRange)
    bool nearDownChannelLower = f_tlNear(low,  downChannelLower, trendTouchRange)

    // ---- Quality OK / 最低Touch ----
    bool touchCountOk = (upValid and upTouchCount >= minLineTouches) or (downValid and downTouchCount >= minLineTouches)
    trendQualityOk := not useTrendQualityFilter or (trendlineQuality >= minTrendlineQuality and touchCountOk)

    // 採用ライン (上下のうちQuality高い方) 情報
    bool selUpDominant = upTrendlineQuality >= downTrendlineQuality
    int   selectedTrendlineIndex   = selUpDominant ? (na(selUpIdx) ? -1 : selUpIdx) : (na(selDnIdx) ? -1 : selDnIdx)
    int   selectedTrendlineQuality = trendlineQuality
    float selectedTrendlineValue   = selUpDominant ? upTrendlineValue : downTrendlineValue
    float selectedTrendlineDistance = na(selectedTrendlineValue) ? na : math.abs(close - selectedTrendlineValue)
    float selectedChannelWidth     = activeUp ? upChannelWidth : downChannelWidth
    int   touchCountSelected  = selUpDominant ? upTouchCount : downTouchCount
    int   brokenCountSelected = selUpDominant ? upBrokenCount : downBrokenCount

    // ---- A: Trendline反発 ----
    bool trendBuyBounceSignal  = useTrendBounce and nearUpTrendline   and bullishReversal and close > upTrendlineValue   and trendQualityOk
    bool trendSellBounceSignal = useTrendBounce and nearDownTrendline and bearishReversal and close < downTrendlineValue and trendQualityOk

    // ---- B: Trendlineブレイク (終値) ----
    bool trendBuyBreakSignal  = useTrendBreak and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and close > downTrendlineValue and close[1] <= downTrendlineValue[1]
    bool trendSellBreakSignal = useTrendBreak and not na(upTrendlineValue) and not na(upTrendlineValue[1]) and close < upTrendlineValue and close[1] >= upTrendlineValue[1]

    // ---- C: Trendlineリテスト ----
    var int trendBreakUpBar   = na
    var int trendBreakDownBar = na
    if trendBuyBreakSignal
        trendBreakUpBar := bar_index
    if trendSellBreakSignal
        trendBreakDownBar := bar_index
    bool trendBuyRetestSignal  = useTrendRetest and not na(trendBreakUpBar)   and (bar_index - trendBreakUpBar)   <= trendRetestBars and not na(downTrendlineValue) and f_tlNear(low, downTrendlineValue, trendTouchRange) and close > downTrendlineValue and bullishReversal
    bool trendSellRetestSignal = useTrendRetest and not na(trendBreakDownBar) and (bar_index - trendBreakDownBar) <= trendRetestBars and not na(upTrendlineValue)   and f_tlNear(high, upTrendlineValue, trendTouchRange) and close < upTrendlineValue and bearishReversal

    // ---- D: Fake Break (流動性狩り) ----
    bool trendBuyFakeBreakSignal  = useTrendFakeBreak and not na(upTrendlineValue)   and not na(upTrendlineValue[1])   and low  < upTrendlineValue   and close > upTrendlineValue   and close[1] <= upTrendlineValue[1]   and bullishReversal
    bool trendSellFakeBreakSignal = useTrendFakeBreak and not na(downTrendlineValue) and not na(downTrendlineValue[1]) and high > downTrendlineValue and close < downTrendlineValue and close[1] >= downTrendlineValue[1] and bearishReversal

    // ---- F: Channel反発 ----
    bool channelBuyBounceSignal  = useChannel and useChannelBounce and (nearUpChannelLower or nearDownChannelLower) and bullishReversal
    bool channelSellBounceSignal = useChannel and useChannelBounce and (nearUpChannelUpper or nearDownChannelUpper) and bearishReversal

    // ---- G: Channelブレイク ----
    bool channelBuyBreakSignal  = useChannel and useChannelBreak and ((not na(upChannelUpper) and not na(upChannelUpper[1]) and close > upChannelUpper and close[1] <= upChannelUpper[1]) or (not na(downChannelUpper) and not na(downChannelUpper[1]) and close > downChannelUpper and close[1] <= downChannelUpper[1]))
    bool channelSellBreakSignal = useChannel and useChannelBreak and ((not na(upChannelLower) and not na(upChannelLower[1]) and close < upChannelLower and close[1] >= upChannelLower[1]) or (not na(downChannelLower) and not na(downChannelLower[1]) and close < downChannelLower and close[1] >= downChannelLower[1]))

    // ---- H: Channelリテスト ----
    var int chBreakUpBar = na
    var int chBreakDnBar = na
    if channelBuyBreakSignal
        chBreakUpBar := bar_index
    if channelSellBreakSignal
        chBreakDnBar := bar_index
    bool channelBuyRetestSignal  = useChannel and useChannelRetest and not na(chBreakUpBar) and (bar_index - chBreakUpBar) <= channelRetestBars and bullishReversal and ((not na(upChannelUpper) and f_tlNear(low, upChannelUpper, trendTouchRange) and close > upChannelUpper) or (not na(downChannelUpper) and f_tlNear(low, downChannelUpper, trendTouchRange) and close > downChannelUpper))
    bool channelSellRetestSignal = useChannel and useChannelRetest and not na(chBreakDnBar) and (bar_index - chBreakDnBar) <= channelRetestBars and bearishReversal and ((not na(upChannelLower) and f_tlNear(high, upChannelLower, trendTouchRange) and close < upChannelLower) or (not na(downChannelLower) and f_tlNear(high, downChannelLower, trendTouchRange) and close < downChannelLower))

    // ---- I: Channel内 Position Bias ----
    float channelPosition = (upValid and not na(upChannelWidth) and upChannelWidth > 0) ? (close - upChannelLower) / upChannelWidth * 100.0 : (downValid and not na(downChannelWidth) and downChannelWidth > 0) ? (close - downChannelLower) / downChannelWidth * 100.0 : na
    bool ch_posTop    = not na(channelPosition) and channelPosition >= 67
    bool ch_posBottom = not na(channelPosition) and channelPosition <= 33
    bool ch_posMid    = not na(channelPosition) and channelPosition > 33 and channelPosition < 67
    bool ch_biasOn = useChannelPositionBias and not na(channelPosition)
    bool channelBiasLong  = ch_biasOn and ((channelSlopeState == 1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posBottom))
    bool channelBiasShort = ch_biasOn and ((channelSlopeState == -1 and (ch_posTop or ch_posBottom)) or (channelSlopeState == 0 and ch_posTop))
    bool channelNoTradeMiddle = ch_biasOn and ch_posMid and channelSlopeState == 0

    // ---- NoTrade ----
    bool trendNoTradeWeakLine = useTrendNoTradeWeakLine and trendlineQuality < minTrendlineQuality
    trendNoTrade      := trendNoTradeWeakLine
    trendNoTradeLong  := trendNoTradeWeakLine
    trendNoTradeShort := trendNoTradeWeakLine

    // ---- Bias 出力 ----
    bool trendBiasLong = (channelBiasLong or trendBuyBounceSignal or trendBuyBreakSignal or trendBuyRetestSignal or trendBuyFakeBreakSignal or channelBuyBounceSignal or channelBuyBreakSignal or channelBuyRetestSignal) and not trendNoTradeLong
    bool trendBiasShort = (channelBiasShort or trendSellBounceSignal or trendSellBreakSignal or trendSellRetestSignal or trendSellFakeBreakSignal or channelSellBounceSignal or channelSellBreakSignal or channelSellRetestSignal) and not trendNoTradeShort

    // ---- Entry結合 (Any / All) ----
    int trendEnabledCount = (useTrendBounce ? 1 : 0) + (useTrendBreak ? 1 : 0) + (useTrendRetest ? 1 : 0) + (useTrendFakeBreak ? 1 : 0) + ((useChannel and useChannelBounce) ? 1 : 0) + ((useChannel and useChannelBreak) ? 1 : 0) + ((useChannel and useChannelRetest) ? 1 : 0)
    int trendFiredBuy = (trendBuyBounceSignal ? 1 : 0) + (trendBuyBreakSignal ? 1 : 0) + (trendBuyRetestSignal ? 1 : 0) + (trendBuyFakeBreakSignal ? 1 : 0) + (channelBuyBounceSignal ? 1 : 0) + (channelBuyBreakSignal ? 1 : 0) + (channelBuyRetestSignal ? 1 : 0)
    int trendFiredSell = (trendSellBounceSignal ? 1 : 0) + (trendSellBreakSignal ? 1 : 0) + (trendSellRetestSignal ? 1 : 0) + (trendSellFakeBreakSignal ? 1 : 0) + (channelSellBounceSignal ? 1 : 0) + (channelSellBreakSignal ? 1 : 0) + (channelSellRetestSignal ? 1 : 0)
    trendEntryBuy  := trendEnabledCount > 0 and (trendEntryMode == "All" ? trendFiredBuy  == trendEnabledCount : trendFiredBuy  >= 1)
    trendEntrySell := trendEnabledCount > 0 and (trendEntryMode == "All" ? trendFiredSell == trendEnabledCount : trendFiredSell >= 1)

    // ---- Signal Type / Direction / Rank ----
    bool tl_anyChRetest = channelBuyRetestSignal or channelSellRetestSignal
    bool tl_anyTLRetest = trendBuyRetestSignal or trendSellRetestSignal
    bool tl_anyFake     = trendBuyFakeBreakSignal or trendSellFakeBreakSignal
    bool tl_anyChBreak  = channelBuyBreakSignal or channelSellBreakSignal
    bool tl_anyTLBreak  = trendBuyBreakSignal or trendSellBreakSignal
    bool tl_anyChBounce = channelBuyBounceSignal or channelSellBounceSignal
    bool tl_anyTLBounce = trendBuyBounceSignal or trendSellBounceSignal
    bool tl_anyChBias   = channelBiasLong or channelBiasShort

    trendSignalType := tl_anyChRetest ? 7 : tl_anyTLRetest ? 3 : tl_anyFake ? 4 : tl_anyChBreak ? 6 : tl_anyTLBreak ? 2 : tl_anyChBounce ? 5 : tl_anyTLBounce ? 1 : tl_anyChBias ? 8 : trendNoTradeWeakLine ? 9 : 0
    trendDirection := tl_anyChRetest ? (channelBuyRetestSignal ? 1 : -1) : tl_anyTLRetest ? (trendBuyRetestSignal ? 1 : -1) : tl_anyFake ? (trendBuyFakeBreakSignal ? 1 : -1) : tl_anyChBreak ? (channelBuyBreakSignal ? 1 : -1) : tl_anyTLBreak ? (trendBuyBreakSignal ? 1 : -1) : tl_anyChBounce ? (channelBuyBounceSignal ? 1 : -1) : tl_anyTLBounce ? (trendBuyBounceSignal ? 1 : -1) : tl_anyChBias ? (channelBiasLong ? 1 : -1) : 0
    int trendRankBase = (tl_anyChRetest and tl_highQuality) ? 10 : (tl_anyTLRetest and tl_highQuality) ? 9 : tl_highQuality ? 8 : tl_anyChRetest ? 7 : tl_anyChBounce ? 6 : tl_anyFake ? 5 : tl_anyTLRetest ? 4 : (tl_anyTLBreak or tl_anyChBreak) ? 3 : tl_anyTLBounce ? 2 : (tl_anyChBias or nearUpTrendline or nearDownTrendline) ? 1 : 0
    trendRank := trendRankBase
    if trendRankBase > 0
        int adj = 0
        adj := adj + (selectedTrendlineQuality >= 80 ? 2 : selectedTrendlineQuality >= 60 ? 1 : selectedTrendlineQuality < 40 ? -1 : 0)
        adj := adj + (brokenCountSelected >= 2 ? -2 : 0)
        adj := adj + (touchCountSelected >= 4 ? 2 : 0)
        float selSlopeATR = na(channelSlope) ? na : math.abs(channelSlope) / atr
        adj := adj + ((not na(selSlopeATR) and selSlopeATR >= minSlopeATR and selSlopeATR <= maxSlopeATR) ? 1 : 0)
        trendRank := math.max(0, math.min(10, trendRankBase + adj))

    // ---- 表示 : Trendline / Channel (line.new) ----
    bool tl_show = showTrendlines
    bool ch_show = showChannelLines
    bool showUp   = upValid   and (not showOnlyBestLines or upTrendlineQuality >= downTrendlineQuality)
    bool showDown = downValid and (not showOnlyBestLines or downTrendlineQuality > upTrendlineQuality)

    var line upLine = na
    var line downLine = na
    var line upChUpperLine = na
    var line downChLowerLine = na

    int   upX1   = upValid   ? selUpAnchorB : bar_index
    int   downX1 = downValid ? selDnAnchorB : bar_index
    upLine   := f_tlUpdateLine(upLine,   tl_show and showUp,   upX1, upValid ? selUpAnchorP : na, bar_index, upTrendlineValue, color.new(color.green, 0))
    downLine := f_tlUpdateLine(downLine, tl_show and showDown, downX1, downValid ? selDnAnchorP : na, bar_index, downTrendlineValue, color.new(color.red, 0))
    upChUpperLine   := f_tlUpdateLine(upChUpperLine,   ch_show and showUp,   upX1, (upValid and not na(upOffset)) ? selUpAnchorP + upOffset : na, bar_index, upChannelUpper, color.new(color.green, 50))
    downChLowerLine := f_tlUpdateLine(downChLowerLine, ch_show and showDown, downX1, (downValid and not na(downOffset)) ? selDnAnchorP - downOffset : na, bar_index, downChannelLower, color.new(color.red, 50))

    // ---- 表示 : ラベル ----
    if showTrendLabels
        if trendBuyBounceSignal
            f_tlMkLabel(true,  "TL Bounce↑", color.new(color.green, 0))
        if trendSellBounceSignal
            f_tlMkLabel(false, "TL Bounce↓", color.new(color.red, 0))
        if trendBuyBreakSignal
            f_tlMkLabel(true,  "TL Break↑", color.new(color.lime, 0))
        if trendSellBreakSignal
            f_tlMkLabel(false, "TL Break↓", color.new(color.maroon, 0))
        if trendBuyRetestSignal
            f_tlMkLabel(true,  "TL Retest↑", color.new(color.aqua, 0))
        if trendSellRetestSignal
            f_tlMkLabel(false, "TL Retest↓", color.new(color.orange, 0))
        if trendBuyFakeBreakSignal
            f_tlMkLabel(true,  "Fake↑", color.new(color.blue, 0))
        if trendSellFakeBreakSignal
            f_tlMkLabel(false, "Fake↓", color.new(color.purple, 0))
        if channelBuyBounceSignal
            f_tlMkLabel(true,  "CH Bounce↑", color.new(color.teal, 0))
        if channelSellBounceSignal
            f_tlMkLabel(false, "CH Bounce↓", color.new(color.fuchsia, 0))
        if channelBuyBreakSignal
            f_tlMkLabel(true,  "CH Break↑", color.new(color.green, 30))
        if channelSellBreakSignal
            f_tlMkLabel(false, "CH Break↓", color.new(color.red, 30))
        if channelBuyRetestSignal
            f_tlMkLabel(true,  "CH Retest↑", color.new(color.aqua, 30))
        if channelSellRetestSignal
            f_tlMkLabel(false, "CH Retest↓", color.new(color.orange, 30))

    // ---- 表示 : デバッグテーブル ----
    var table dbg = table.new(position.top_left, 2, 15, border_width = 1)
    if showTrendDebugTable and barstate.islast
        string sDir = trendDirection == 1 ? "BUY" : trendDirection == -1 ? "SELL" : "-"
        table.cell(dbg, 0, 0, "Trendline", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(dbg, 1, 0, trendNoTrade ? "NoTrade" : (trendDirection != 0 ? "SIGNAL" : "-"), text_color = color.white, bgcolor = trendNoTrade ? color.new(color.red, 30) : color.new(color.blue, 0))
        table.cell(dbg, 0, 1, "State", text_color = color.white)
        table.cell(dbg, 1, 1, f_tlStateStr(upValid, downValid), text_color = color.white)
        table.cell(dbg, 0, 2, "Signal Type", text_color = color.white)
        table.cell(dbg, 1, 2, f_tlTypeStr(trendSignalType), text_color = color.white)
        table.cell(dbg, 0, 3, "Direction", text_color = color.white)
        table.cell(dbg, 1, 3, sDir, text_color = color.white)
        table.cell(dbg, 0, 4, "Rank", text_color = color.white)
        table.cell(dbg, 1, 4, str.tostring(trendRank), text_color = color.white)
        table.cell(dbg, 0, 5, "UpTL Q", text_color = color.white)
        table.cell(dbg, 1, 5, str.tostring(upTrendlineQuality), text_color = color.white)
        table.cell(dbg, 0, 6, "DownTL Q", text_color = color.white)
        table.cell(dbg, 1, 6, str.tostring(downTrendlineQuality), text_color = color.white)
        table.cell(dbg, 0, 7, "Touch U/D / OK", text_color = color.white)
        table.cell(dbg, 1, 7, str.tostring(upTouchCount) + " / " + str.tostring(downTouchCount) + " / " + (touchCountOk ? "Y" : "N"), text_color = color.white)
        table.cell(dbg, 0, 8, "Broken U/D", text_color = color.white)
        table.cell(dbg, 1, 8, str.tostring(upBrokenCount) + " / " + str.tostring(downBrokenCount), text_color = color.white)
        table.cell(dbg, 0, 9, "Ch Position", text_color = color.white)
        table.cell(dbg, 1, 9, na(channelPosition) ? "-" : str.tostring(channelPosition, "#.#"), text_color = color.white)
        table.cell(dbg, 0, 10, "NoTrade / Bias L/S", text_color = color.white)
        table.cell(dbg, 1, 10, (trendNoTrade ? "Y" : "N") + " | " + (trendBiasLong ? "L" : "-") + (trendBiasShort ? "S" : "-"), text_color = color.white)
        table.cell(dbg, 0, 11, "TrendEntry B/S", text_color = color.white)
        table.cell(dbg, 1, 11, (trendEntryBuy ? "Y" : "N") + " / " + (trendEntrySell ? "Y" : "N"), text_color = color.white)
        table.cell(dbg, 0, 12, "Selected (Idx/Q/Dist)", text_color = color.white)
        table.cell(dbg, 1, 12, f_tlSelIdxStr(selectedTrendlineIndex) + " / " + str.tostring(selectedTrendlineQuality) + " / " + (na(selectedTrendlineDistance) ? "-" : str.tostring(selectedTrendlineDistance, "#.#")), text_color = color.white)
        table.cell(dbg, 0, 13, "Ch Width / Slope", text_color = color.white)
        table.cell(dbg, 1, 13, (na(selectedChannelWidth) ? "-" : str.tostring(selectedChannelWidth, "#.#")) + " / " + f_tlSlopeStr(channelSlopeState), text_color = color.white)
        table.cell(dbg, 0, 14, "Break Confirm", text_color = color.white)
        table.cell(dbg, 1, 14, str.tostring(breakConfirmBars), text_color = color.white)

// ============================================================
// 5b-3. WinZone-Trendline 状態管理
// ------------------------------------------------------------
// trendEntryBuy/Sell が発火したら状態ON、trendStateMaxBars 本で期限切れ。
// ※ 状態更新は useTrendlineModule かつ useTrendStateWindow の時だけ実行。
//   (OFF時は状態管理更新を一切行わない)
// ============================================================
var bool longTrendStateOk  = false
var bool shortTrendStateOk = false
var int  longTrendStateBar  = na
var int  shortTrendStateBar = na

if useTrendlineModule and useTrendStateWindow
    if trendEntryBuy
        longTrendStateOk := true
        longTrendStateBar := bar_index
    if trendEntrySell
        shortTrendStateOk := true
        shortTrendStateBar := bar_index
    if longTrendStateOk and not na(longTrendStateBar) and bar_index - longTrendStateBar > trendStateMaxBars
        longTrendStateOk := false
    if shortTrendStateOk and not na(shortTrendStateBar) and bar_index - shortTrendStateBar > trendStateMaxBars
        shortTrendStateOk := false

// --- Trendline 許可 ---
// OFF … 常に許可 (完全素通し)
// 状態管理OFF … trendEntryBuy/Sell の単バー判定
// 状態管理ON  … 保持中フラグ
bool allowLongByTrendline  = not useTrendlineModule ? true : useTrendStateWindow ? (longTrendStateOk and trendQualityOk and not trendNoTradeLong) : (trendEntryBuy and trendQualityOk and not trendNoTradeLong)
bool allowShortByTrendline = not useTrendlineModule ? true : useTrendStateWindow ? (shortTrendStateOk and trendQualityOk and not trendNoTradeShort) : (trendEntrySell and trendQualityOk and not trendNoTradeShort)

// ============================================================
// 5b-5. WinZone : DT/DB (Double/Triple Top・Bottom) モジュール
// ------------------------------------------------------------
// FVG・Trendline と並列の WinZone 場所/構造フィルター。Trigger ではない。
// ※ Trigger (bullTrigCount/bearTrigCount/enabledTrigCount) には一切混ぜない。
// useDTDBModule=false の時は if に入らず、ta.atr/ta.sma/pivot/
// request.security/配列/検出/Quality/状態更新/label/table を実行しない。
// 出力 : dtdbBiasLong/Short / dtdbNoTrade(Long/Short) /
//        dtdbSignalType / dtdbDirection / dtdbRank / dtdbQuality
// ============================================================

// --- ヘルパー (定義はグローバル。呼び出しは if 内のみ) ---
f_dtdbFindBetween(array<float> _vals, array<int> _idxs, int _lo, int _hi) =>
    float _res = na
    if array.size(_vals) > 0
        for i = 0 to array.size(_vals) - 1
            int _id = array.get(_idxs, i)
            if _id > _lo and _id < _hi
                _res := array.get(_vals, i)
    _res

f_dtdbTypeStr(int t) =>
    t == 1 ? "DT Pattern" : t == 2 ? "DB Pattern" : t == 3 ? "DT Break" : t == 4 ? "DB Break" : t == 5 ? "DT Retest" : t == 6 ? "DB Retest" : t == 7 ? "DT Invalidation" : t == 8 ? "DB Invalidation" : t == 9 ? "DT Sweep" : t == 10 ? "DB Sweep" : t == 11 ? "NoTrade" : t == 12 ? "TT Pattern" : t == 13 ? "TB Pattern" : t == 14 ? "TT Break" : t == 15 ? "TB Break" : t == 16 ? "TT Retest" : t == 17 ? "TB Retest" : t == 18 ? "TT Invalidation" : t == 19 ? "TB Invalidation" : t == 20 ? "TT Sweep" : t == 21 ? "TB Sweep" : "None"

f_dtdbReasonStr(int r) =>
    r == 1 ? "Conflict" : r == 2 ? "Low Quality" : r == 3 ? "Expired" : r == 4 ? "Right Failed" : r == 5 ? "Invalidated" : "None"

// ネックライン水平線を描く/更新する (plot を使わず line で描画 → plot上限を消費しない)
f_dtdbNeck(line ln, bool show, bool active, float y, int x1, color col) =>
    line r = ln
    if show and active and not na(y)
        int xa = na(x1) ? bar_index : x1
        if na(r)
            r := line.new(xa, y, bar_index, y, color = col, width = 1, style = line.style_dashed)
        else
            line.set_xy1(r, xa, y)
            line.set_xy2(r, bar_index, y)
            line.set_color(r, col)
    else
        if not na(r)
            line.delete(r)
            r := na
    r

// --- 出力 (OFF安全デフォルト。素通し時はこの値のまま) ---
bool dtdbBiasLong     = false
bool dtdbBiasShort    = false
bool dtdbNoTrade      = false
bool dtdbNoTradeLong  = false
bool dtdbNoTradeShort = false
int  dtdbSignalType   = 0
int  dtdbDirection    = 0
int  dtdbRank         = 0
int  dtdbQuality      = 0

if useDTDBModule
    // ---- 共通計算 ----
    float dtdbAtrV = ta.atr(dtdbRetestAtrLen)
    float dtdbRetestRange = dtdbAtrV * dtdbRetestAtrMult

    // ---- HTF Pivot 取得 (確定後のみ / lookahead_off) ----
    [htfPh, htfPl, htfClose, htfTime] = request.security(syminfo.tickerid, dtdbPatternTf, [ta.pivothigh(dtdbPivotLen, dtdbPivotLen), ta.pivotlow(dtdbPivotLen, dtdbPivotLen), close[1], time], lookahead = barmerge.lookahead_off)
    bool newHTF = na(htfTime[1]) ? false : htfTime != htfTime[1]

    // ---- Pivot 配列 ----
    var array<float> phVals = array.new_float()
    var array<int>   phIdx  = array.new_int()
    var array<float> plVals = array.new_float()
    var array<int>   plIdx  = array.new_int()
    var int htfCount     = 0
    var int lastPivotDir = 0

    // ---- パターン状態 (DT) ----
    var float dtFirstTop   = na
    var float dtSecondTop  = na
    var float necklineDT   = na
    var bool  dtPatternFound = false
    var bool  dtBreakDone    = false
    var bool  dtInvalidated  = false
    var bool  dtIsSweep      = false
    var int   dtPatternBar   = na
    var int   dtBreakBar     = na

    // パターン状態 (DB)
    var float dbFirstBottom  = na
    var float dbSecondBottom = na
    var float necklineDB     = na
    var bool  dbPatternFound = false
    var bool  dbBreakDone    = false
    var bool  dbInvalidated  = false
    var bool  dbIsSweep      = false
    var int   dbPatternBar   = na
    var int   dbBreakBar     = na

    // 右山 / 右底 形成ビルド状態 + Stage
    var bool  dtRSBuilding = false
    var float dtBuildTop   = na
    var int   dtStageV     = 0
    var bool  dbRSBuilding = false
    var float dbBuildBot   = na
    var int   dbStageV     = 0

    // スイープ ステート
    var bool dtSweepArmed     = false
    var int  dtSweepBar       = na
    var bool dtSweepConfirmed = false
    var bool dbSweepArmed     = false
    var int  dbSweepBar       = na
    var bool dbSweepConfirmed = false

    // --- Triple Top (TT) 状態 ---
    var float ttTop1 = na
    var float ttTop2 = na
    var float ttTop3 = na
    var float necklineTT = na
    var bool  ttPatternFound = false
    var bool  ttBreakDone    = false
    var bool  ttInvalidated  = false
    var bool  ttIsSweep      = false
    var int   ttPatternBar   = na
    var int   ttBreakBar     = na
    var bool  ttSweepArmed     = false
    var int   ttSweepBar       = na
    var bool  ttSweepConfirmed = false
    var float ttSweepZone      = na
    var bool  ttRSBuilding = false
    var float ttZoneTop    = na

    // --- Triple Bottom (TB) 状態 ---
    var float tbBottom1 = na
    var float tbBottom2 = na
    var float tbBottom3 = na
    var float necklineTB = na
    var bool  tbPatternFound = false
    var bool  tbBreakDone    = false
    var bool  tbInvalidated  = false
    var bool  tbIsSweep      = false
    var int   tbPatternBar   = na
    var int   tbBreakBar     = na
    var bool  tbSweepArmed     = false
    var int   tbSweepBar       = na
    var bool  tbSweepConfirmed = false
    var float tbSweepZone      = na
    var bool  tbRSBuilding = false
    var float tbZoneBot    = na

    // バー内イベント
    bool dtRSFailHTF   = false
    bool dbRSFailHTF   = false
    bool dtExpiredEvent = false
    bool dbExpiredEvent = false
    bool dtCompletedNow = false
    bool dbCompletedNow = false
    bool ttRSFailHTF    = false
    bool tbRSFailHTF    = false
    bool ttExpiredEvent = false
    bool tbExpiredEvent = false
    bool ttCompletedNow = false
    bool tbCompletedNow = false

    // ---- 検出 (newHTF 時) ----
    if newHTF
        htfCount := htfCount + 1
        int _pIdx = htfCount - dtdbPivotLen
        if not na(htfPh)
            if lastPivotDir == 1 and array.size(phVals) > 0
                int _li = array.size(phVals) - 1
                if htfPh > array.get(phVals, _li)
                    array.set(phVals, _li, htfPh)
                    array.set(phIdx,  _li, _pIdx)
            else
                array.push(phVals, htfPh)
                array.push(phIdx,  _pIdx)
                lastPivotDir := 1
                while array.size(phVals) > 10
                    array.shift(phVals)
                    array.shift(phIdx)
        if not na(htfPl)
            if lastPivotDir == -1 and array.size(plVals) > 0
                int _li = array.size(plVals) - 1
                if htfPl < array.get(plVals, _li)
                    array.set(plVals, _li, htfPl)
                    array.set(plIdx,  _li, _pIdx)
            else
                array.push(plVals, htfPl)
                array.push(plIdx,  _pIdx)
                lastPivotDir := -1
                while array.size(plVals) > 10
                    array.shift(plVals)
                    array.shift(plIdx)

        // --- ダブルトップ (直近2 PH) ---
        int nH = array.size(phVals)
        if not na(htfPh) and nH >= 2
            float t1 = array.get(phVals, nH - 2)
            float t2 = array.get(phVals, nH - 1)
            int t1i = array.get(phIdx, nH - 2)
            int t2i = array.get(phIdx, nH - 1)
            float neck = f_dtdbFindBetween(plVals, plIdx, t1i, t2i)
            bool symOk   = math.abs(t1 - t2) / t1 <= doubleTolerancePct
            bool depthOk = not useNeckDepth or (not na(neck) and (math.min(t1, t2) - neck) >= dtdbAtrV * neckDepthMult)
            bool normalDT = symOk and depthOk
            bool sweepRaw = useSweepDTDB and t2 > t1 and t2 <= t1 + dtdbAtrV * dtdbSweepAtrMult and depthOk
            if not na(neck) and (normalDT or sweepRaw)
                dtFirstTop     := t1
                dtSecondTop    := t2
                necklineDT     := neck
                dtPatternFound := true
                dtBreakDone    := false
                dtInvalidated  := false
                dtIsSweep      := sweepRaw and not normalDT
                dtPatternBar   := bar_index
                dtCompletedNow := true
                dtStageV       := 4
                dtSweepConfirmed := false
                if dtIsSweep
                    dtSweepArmed := true
                    dtSweepBar   := bar_index
                else
                    dtSweepArmed := false
            else if not na(neck) and t2 > t1
                dtRSFailHTF := true

        // --- ダブルボトム (直近2 PL) ---
        int nL = array.size(plVals)
        if not na(htfPl) and nL >= 2
            float b1 = array.get(plVals, nL - 2)
            float b2 = array.get(plVals, nL - 1)
            int b1i = array.get(plIdx, nL - 2)
            int b2i = array.get(plIdx, nL - 1)
            float neckB = f_dtdbFindBetween(phVals, phIdx, b1i, b2i)
            bool symOkB   = math.abs(b1 - b2) / b1 <= doubleTolerancePct
            bool depthOkB = not useNeckDepth or (not na(neckB) and (neckB - math.max(b1, b2)) >= dtdbAtrV * neckDepthMult)
            bool normalDB = symOkB and depthOkB
            bool sweepRawB = useSweepDTDB and b2 < b1 and b2 >= b1 - dtdbAtrV * dtdbSweepAtrMult and depthOkB
            if not na(neckB) and (normalDB or sweepRawB)
                dbFirstBottom  := b1
                dbSecondBottom := b2
                necklineDB     := neckB
                dbPatternFound := true
                dbBreakDone    := false
                dbInvalidated  := false
                dbIsSweep      := sweepRawB and not normalDB
                dbPatternBar   := bar_index
                dbCompletedNow := true
                dbStageV       := 4
                dbSweepConfirmed := false
                if dbIsSweep
                    dbSweepArmed := true
                    dbSweepBar   := bar_index
                else
                    dbSweepArmed := false
            else if not na(neckB) and b2 < b1
                dbRSFailHTF := true

        // --- Triple Top (直近3 PH) ---
        int nHt = array.size(phVals)
        if useTripleDTDB and not na(htfPh) and nHt >= 3
            float tp1 = array.get(phVals, nHt - 3)
            float tp2 = array.get(phVals, nHt - 2)
            float tp3 = array.get(phVals, nHt - 1)
            int tp1i = array.get(phIdx, nHt - 3)
            int tp2i = array.get(phIdx, nHt - 2)
            int tp3i = array.get(phIdx, nHt - 1)
            float n1 = f_dtdbFindBetween(plVals, plIdx, tp1i, tp2i)
            float n2 = f_dtdbFindBetween(plVals, plIdx, tp2i, tp3i)
            float necT = na(n1) or na(n2) ? na : math.min(n1, n2)
            float tMin = math.min(tp1, math.min(tp2, tp3))
            bool symT = math.abs(tp1 - tp2) / tp1 <= tripleTolerancePct and math.abs(tp1 - tp3) / tp1 <= tripleTolerancePct and math.abs(tp2 - tp3) / tp2 <= tripleTolerancePct
            bool depthT = not useNeckDepth or (not na(necT) and (tMin - necT) >= dtdbAtrV * neckDepthMult)
            bool afterDoubleT = not useTripleOnlyAfterDouble or dtPatternFound
            bool normalTT = symT and depthT and afterDoubleT
            bool sweepRawT = useSweepDTDB and tp3 > math.max(tp1, tp2) and tp3 <= math.max(tp1, tp2) + dtdbAtrV * dtdbSweepAtrMult and depthT and afterDoubleT
            if not na(necT) and (normalTT or sweepRawT)
                ttTop1 := tp1
                ttTop2 := tp2
                ttTop3 := tp3
                necklineTT := necT
                ttPatternFound := true
                ttBreakDone := false
                ttInvalidated := false
                ttIsSweep := sweepRawT and not normalTT
                ttPatternBar := bar_index
                ttCompletedNow := true
                ttSweepConfirmed := false
                if ttIsSweep
                    ttSweepArmed := true
                    ttSweepBar := bar_index
                    ttSweepZone := math.max(tp1, tp2)
                else
                    ttSweepArmed := false
            else if not na(necT) and tp3 > math.max(tp1, tp2)
                ttRSFailHTF := true

        // --- Triple Bottom (直近3 PL) ---
        int nLt = array.size(plVals)
        if useTripleDTDB and not na(htfPl) and nLt >= 3
            float bt1 = array.get(plVals, nLt - 3)
            float bt2 = array.get(plVals, nLt - 2)
            float bt3 = array.get(plVals, nLt - 1)
            int bt1i = array.get(plIdx, nLt - 3)
            int bt2i = array.get(plIdx, nLt - 2)
            int bt3i = array.get(plIdx, nLt - 1)
            float m1 = f_dtdbFindBetween(phVals, phIdx, bt1i, bt2i)
            float m2 = f_dtdbFindBetween(phVals, phIdx, bt2i, bt3i)
            float necTB = na(m1) or na(m2) ? na : math.max(m1, m2)
            float bMax = math.max(bt1, math.max(bt2, bt3))
            bool symTB = math.abs(bt1 - bt2) / bt1 <= tripleTolerancePct and math.abs(bt1 - bt3) / bt1 <= tripleTolerancePct and math.abs(bt2 - bt3) / bt2 <= tripleTolerancePct
            bool depthTB = not useNeckDepth or (not na(necTB) and (necTB - bMax) >= dtdbAtrV * neckDepthMult)
            bool afterDoubleB = not useTripleOnlyAfterDouble or dbPatternFound
            bool normalTB = symTB and depthTB and afterDoubleB
            bool sweepRawTB = useSweepDTDB and bt3 < math.min(bt1, bt2) and bt3 >= math.min(bt1, bt2) - dtdbAtrV * dtdbSweepAtrMult and depthTB and afterDoubleB
            if not na(necTB) and (normalTB or sweepRawTB)
                tbBottom1 := bt1
                tbBottom2 := bt2
                tbBottom3 := bt3
                necklineTB := necTB
                tbPatternFound := true
                tbBreakDone := false
                tbInvalidated := false
                tbIsSweep := sweepRawTB and not normalTB
                tbPatternBar := bar_index
                tbCompletedNow := true
                tbSweepConfirmed := false
                if tbIsSweep
                    tbSweepArmed := true
                    tbSweepBar := bar_index
                    tbSweepZone := math.min(bt1, bt2)
                else
                    tbSweepArmed := false
            else if not na(necTB) and bt3 < math.min(bt1, bt2)
                tbRSFailHTF := true

        // --- Triple 右側ビルド ---
        if not na(htfPl) and dtPatternFound and not na(dtFirstTop)
            ttRSBuilding := true
            ttZoneTop := math.max(dtFirstTop, dtSecondTop)
        if not na(htfPh) and not ttCompletedNow
            ttRSBuilding := false
        if not na(htfPh) and dbPatternFound and not na(dbFirstBottom)
            tbRSBuilding := true
            tbZoneBot := math.min(dbFirstBottom, dbSecondBottom)
        if not na(htfPl) and not tbCompletedNow
            tbRSBuilding := false

        // --- 右山 / 右底 ビルド + Stage ---
        if not na(htfPh)
            dtBuildTop := htfPh
            dtRSBuilding := false
            if not dtCompletedNow
                dtStageV := 1
        if not na(htfPl)
            if not na(dtBuildTop)
                dtRSBuilding := true
                if not dtCompletedNow
                    dtStageV := 2
        if not na(htfPl)
            dbBuildBot := htfPl
            dbRSBuilding := false
            if not dbCompletedNow
                dbStageV := 1
        if not na(htfPh)
            if not na(dbBuildBot)
                dbRSBuilding := true
                if not dbCompletedNow
                    dbStageV := 2

    // ---- 右山崩れ / 右底崩れ ----
    bool dtPriceFail = dtRSBuilding and not na(dtBuildTop) and high > dtBuildTop + dtdbAtrV * dtdbInvalidationAtrMult
    bool dbPriceFail = dbRSBuilding and not na(dbBuildBot) and low < dbBuildBot - dtdbAtrV * dtdbInvalidationAtrMult
    bool dtRightSideFailed = dtPriceFail or dtRSFailHTF
    bool dbRightSideFailed = dbPriceFail or dbRSFailHTF
    if dtRightSideFailed
        dtRSBuilding := false
        dtBuildTop := na
        dtStageV := 0
    if dbRightSideFailed
        dbRSBuilding := false
        dbBuildBot := na
        dbStageV := 0

    if dtRSBuilding and dtStageV == 2 and not na(dtBuildTop) and high >= dtBuildTop - dtdbRetestRange
        dtStageV := 3
    if dbRSBuilding and dbStageV == 2 and not na(dbBuildBot) and low <= dbBuildBot + dtdbRetestRange
        dbStageV := 3

    if dtSweepArmed
        if not na(dtFirstTop) and close < dtFirstTop
            dtSweepConfirmed := true
        else if not na(dtSweepBar) and (bar_index - dtSweepBar) > dtdbSweepReturnBars
            dtSweepArmed := false
    if dbSweepArmed
        if not na(dbFirstBottom) and close > dbFirstBottom
            dbSweepConfirmed := true
        else if not na(dbSweepBar) and (bar_index - dbSweepBar) > dtdbSweepReturnBars
            dbSweepArmed := false

    int dtStage = dtStageV
    int dbStage = dbStageV

    bool ttPriceFail = ttRSBuilding and not na(ttZoneTop) and high > ttZoneTop + dtdbAtrV * dtdbInvalidationAtrMult
    bool tbPriceFail = tbRSBuilding and not na(tbZoneBot) and low < tbZoneBot - dtdbAtrV * dtdbInvalidationAtrMult
    bool ttRightSideFailed = useTripleDTDB and (ttPriceFail or ttRSFailHTF)
    bool tbRightSideFailed = useTripleDTDB and (tbPriceFail or tbRSFailHTF)
    if ttRightSideFailed
        ttRSBuilding := false
        ttZoneTop := na
    if tbRightSideFailed
        tbRSBuilding := false
        tbZoneBot := na

    if ttSweepArmed
        if not na(ttSweepZone) and close < ttSweepZone
            ttSweepConfirmed := true
        else if not na(ttSweepBar) and (bar_index - ttSweepBar) > dtdbSweepReturnBars
            ttSweepArmed := false
    if tbSweepArmed
        if not na(tbSweepZone) and close > tbSweepZone
            tbSweepConfirmed := true
        else if not na(tbSweepBar) and (bar_index - tbSweepBar) > dtdbSweepReturnBars
            tbSweepArmed := false

    // ---- 反転ローソク ----
    float dtdbBody    = math.abs(close - open)
    float dtdbAvgBody = ta.sma(math.abs(close - open), 20)
    bool dtdbStrongBody = not useDTDBBodyFilter or dtdbBody > dtdbAvgBody * dtdbBodyMult
    bool dtdbBearEngulf = close < open and open >= close[1] and close <= open[1] and dtdbStrongBody
    bool dtdbBullEngulf = close > open and open <= close[1] and close >= open[1] and dtdbStrongBody
    float dtdbBarRng = math.max(high - low, syminfo.mintick)
    float dtdbUpWick = high - math.max(open, close)
    float dtdbDnWick = math.min(open, close) - low
    bool dtdbBearPin = dtdbUpWick / dtdbBarRng >= dtdbPinWickRatio
    bool dtdbBullPin = dtdbDnWick / dtdbBarRng >= dtdbPinWickRatio
    bool dtReversal = not useDTDBReversalCandle or dtdbBearEngulf or dtdbBearPin
    bool dbReversal = not useDTDBReversalCandle or dtdbBullEngulf or dtdbBullPin

    // ---- DT/DB 否定 / ネックラインブレイク ----
    bool dtInvalidation = useDTDBInvalidation and dtPatternFound and not dtBreakDone and not na(dtFirstTop) and not na(dtSecondTop) and close > math.max(dtFirstTop, dtSecondTop) + dtdbAtrV * dtdbInvalidationAtrMult
    bool dbInvalidation = useDTDBInvalidation and dbPatternFound and not dbBreakDone and not na(dbFirstBottom) and not na(dbSecondBottom) and close < math.min(dbFirstBottom, dbSecondBottom) - dtdbAtrV * dtdbInvalidationAtrMult
    bool dtBreak = dtPatternFound and not dtBreakDone and not na(necklineDT) and not na(htfClose) and htfClose < necklineDT
    bool dbBreak = dbPatternFound and not dbBreakDone and not na(necklineDB) and not na(htfClose) and htfClose > necklineDB
    if dtInvalidation
        dtInvalidated  := true
        dtPatternFound := false
    if dbInvalidation
        dbInvalidated  := true
        dbPatternFound := false
    if dtBreak and not dtInvalidation
        dtBreakDone := true
        dtBreakBar  := bar_index
    if dbBreak and not dbInvalidation
        dbBreakDone := true
        dbBreakBar  := bar_index
    if dtPatternFound and dtBreakDone and not na(dtBreakBar) and (bar_index - dtBreakBar > dtdbSetupValidBars)
        dtPatternFound := false
        dtBreakDone    := false
        dtExpiredEvent := true
    else if dtPatternFound and not dtBreakDone and not na(dtPatternBar) and (bar_index - dtPatternBar > dtdbSetupValidBars)
        dtPatternFound := false
        dtExpiredEvent := true
    if dbPatternFound and dbBreakDone and not na(dbBreakBar) and (bar_index - dbBreakBar > dtdbSetupValidBars)
        dbPatternFound := false
        dbBreakDone    := false
        dbExpiredEvent := true
    else if dbPatternFound and not dbBreakDone and not na(dbPatternBar) and (bar_index - dbPatternBar > dtdbSetupValidBars)
        dbPatternFound := false
        dbExpiredEvent := true

    // --- Triple 否定 / ブレイク ---
    bool ttInvalidation = useDTDBInvalidation and useTripleDTDB and ttPatternFound and not ttBreakDone and not na(ttTop1) and close > math.max(ttTop1, math.max(ttTop2, ttTop3)) + dtdbAtrV * dtdbInvalidationAtrMult
    bool tbInvalidation = useDTDBInvalidation and useTripleDTDB and tbPatternFound and not tbBreakDone and not na(tbBottom1) and close < math.min(tbBottom1, math.min(tbBottom2, tbBottom3)) - dtdbAtrV * dtdbInvalidationAtrMult
    bool ttBreak = ttPatternFound and not ttBreakDone and not na(necklineTT) and not na(htfClose) and htfClose < necklineTT
    bool tbBreak = tbPatternFound and not tbBreakDone and not na(necklineTB) and not na(htfClose) and htfClose > necklineTB
    if ttInvalidation
        ttInvalidated  := true
        ttPatternFound := false
    if tbInvalidation
        tbInvalidated  := true
        tbPatternFound := false
    if ttBreak and not ttInvalidation
        ttBreakDone := true
        ttBreakBar  := bar_index
    if tbBreak and not tbInvalidation
        tbBreakDone := true
        tbBreakBar  := bar_index
    if ttPatternFound and ttBreakDone and not na(ttBreakBar) and (bar_index - ttBreakBar > dtdbSetupValidBars)
        ttPatternFound := false
        ttBreakDone    := false
        ttExpiredEvent := true
    else if ttPatternFound and not ttBreakDone and not na(ttPatternBar) and (bar_index - ttPatternBar > dtdbSetupValidBars)
        ttPatternFound := false
        ttExpiredEvent := true
    if tbPatternFound and tbBreakDone and not na(tbBreakBar) and (bar_index - tbBreakBar > dtdbSetupValidBars)
        tbPatternFound := false
        tbBreakDone    := false
        tbExpiredEvent := true
    else if tbPatternFound and not tbBreakDone and not na(tbPatternBar) and (bar_index - tbPatternBar > dtdbSetupValidBars)
        tbPatternFound := false
        tbExpiredEvent := true

    // ---- ネックラインリテスト ----
    bool dtSetupValid = dtPatternFound and dtBreakDone and not na(dtBreakBar) and (bar_index - dtBreakBar <= dtdbSetupValidBars)
    bool dbSetupValid = dbPatternFound and dbBreakDone and not na(dbBreakBar) and (bar_index - dbBreakBar <= dtdbSetupValidBars)
    bool dtRetest = dtSetupValid and not na(necklineDT) and high >= necklineDT - dtdbRetestRange and close <= necklineDT + dtdbRetestRange
    bool dbRetest = dbSetupValid and not na(necklineDB) and low <= necklineDB + dtdbRetestRange and close >= necklineDB - dtdbRetestRange
    bool ttSetupValid = ttPatternFound and ttBreakDone and not na(ttBreakBar) and (bar_index - ttBreakBar <= dtdbSetupValidBars)
    bool tbSetupValid = tbPatternFound and tbBreakDone and not na(tbBreakBar) and (bar_index - tbBreakBar <= dtdbSetupValidBars)
    bool ttRetest = ttSetupValid and not na(necklineTT) and high >= necklineTT - dtdbRetestRange and close <= necklineTT + dtdbRetestRange
    bool tbRetest = tbSetupValid and not na(necklineTB) and low <= necklineTB + dtdbRetestRange and close >= necklineTB - dtdbRetestRange

    // ---- スイープ型 (Pattern 出力) ----
    bool dtSweepPattern = useSweepDTDB and dtPatternFound and dtIsSweep and dtSweepConfirmed
    bool dbSweepPattern = useSweepDTDB and dbPatternFound and dbIsSweep and dbSweepConfirmed
    bool ttSweepPattern = useSweepDTDB and useTripleDTDB and ttPatternFound and ttIsSweep and ttSweepConfirmed
    bool tbSweepPattern = useSweepDTDB and useTripleDTDB and tbPatternFound and tbIsSweep and tbSweepConfirmed

    bool dtPattern = dtPatternFound
    bool dbPattern = dbPatternFound
    bool tripleTopPattern    = useTripleDTDB and ttPatternFound
    bool tripleBottomPattern = useTripleDTDB and tbPatternFound
    int topTouchCount    = ttPatternFound ? 3 : dtPatternFound ? 2 : 0
    int bottomTouchCount = tbPatternFound ? 3 : dbPatternFound ? 2 : 0

    // ---- Quality Score ----
    bool revSpeedOkDt = not na(dtPatternBar) and (bar_index - dtPatternBar) <= quickRevBars
    bool revSpeedOkDb = not na(dbPatternBar) and (bar_index - dbPatternBar) <= quickRevBars
    bool quickOkDt = not useQuickRev or revSpeedOkDt
    bool quickOkDb = not useQuickRev or revSpeedOkDb
    float dtSymPts = (na(dtFirstTop) or na(dtSecondTop) or dtFirstTop == 0 or doubleTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(dtFirstTop - dtSecondTop) / dtFirstTop) / doubleTolerancePct))
    float dbSymPts = (na(dbFirstBottom) or na(dbSecondBottom) or dbFirstBottom == 0 or doubleTolerancePct == 0) ? 0.0 : math.max(0.0, 20.0 * (1.0 - (math.abs(dbFirstBottom - dbSecondBottom) / dbFirstBottom) / doubleTolerancePct))
    bool dtNeckDepthOk = not useNeckDepth or (not na(dtFirstTop) and not na(dtSecondTop) and not na(necklineDT) and (math.min(dtFirstTop, dtSecondTop) - necklineDT) >= dtdbAtrV * neckDepthMult)
    bool dbNeckDepthOk = not useNeckDepth or (not na(dbFirstBottom) and not na(dbSecondBottom) and not na(necklineDB) and (necklineDB - math.max(dbFirstBottom, dbSecondBottom)) >= dtdbAtrV * neckDepthMult)
    int dtQuality = not dtPatternFound ? 0 : math.min(100, math.round(dtSymPts) + (dtNeckDepthOk ? 20 : 0) + (revSpeedOkDt ? 15 : 0) + ((useDTDBReversalCandle and (dtdbBearEngulf or dtdbBearPin)) ? 15 : 0) + (dtBreakDone ? 15 : 0) + (dtRetest ? 10 : 0) + (dtIsSweep ? 5 : 0))
    int dbQuality = not dbPatternFound ? 0 : math.min(100, math.round(dbSymPts) + (dbNeckDepthOk ? 20 : 0) + (revSpeedOkDb ? 15 : 0) + ((useDTDBReversalCandle and (dtdbBullEngulf or dtdbBullPin)) ? 15 : 0) + (dbBreakDone ? 15 : 0) + (dbRetest ? 10 : 0) + (dbIsSweep ? 5 : 0))
    bool revSpeedOkTt = not na(ttPatternBar) and (bar_index - ttPatternBar) <= quickRevBars
    bool revSpeedOkTb = not na(tbPatternBar) and (bar_index - tbPatternBar) <= quickRevBars
    float ttSymPts = (na(ttTop1) or na(ttTop2) or na(ttTop3) or tripleTolerancePct == 0) ? 0.0 : math.max(0.0, 25.0 * (1.0 - ((math.max(ttTop1, math.max(ttTop2, ttTop3)) - math.min(ttTop1, math.min(ttTop2, ttTop3))) / math.max(ttTop1, math.max(ttTop2, ttTop3))) / tripleTolerancePct))
    float tbSymPts = (na(tbBottom1) or na(tbBottom2) or na(tbBottom3) or tripleTolerancePct == 0) ? 0.0 : math.max(0.0, 25.0 * (1.0 - ((math.max(tbBottom1, math.max(tbBottom2, tbBottom3)) - math.min(tbBottom1, math.min(tbBottom2, tbBottom3))) / math.max(tbBottom1, math.max(tbBottom2, tbBottom3))) / tripleTolerancePct))
    bool ttNeckDepthOk = not useNeckDepth or (not na(ttTop1) and not na(necklineTT) and (math.min(ttTop1, math.min(ttTop2, ttTop3)) - necklineTT) >= dtdbAtrV * neckDepthMult)
    bool tbNeckDepthOk = not useNeckDepth or (not na(tbBottom1) and not na(necklineTB) and (necklineTB - math.max(tbBottom1, math.max(tbBottom2, tbBottom3))) >= dtdbAtrV * neckDepthMult)
    int ttQuality = not ttPatternFound ? 0 : math.min(100, math.round(ttSymPts) + (ttNeckDepthOk ? 20 : 0) + 10 + ((useDTDBReversalCandle and (dtdbBearEngulf or dtdbBearPin)) ? 15 : 0) + (ttBreakDone ? 15 : 0) + (ttRetest ? 10 : 0) + (ttIsSweep ? 5 : 0))
    int tbQuality = not tbPatternFound ? 0 : math.min(100, math.round(tbSymPts) + (tbNeckDepthOk ? 20 : 0) + 10 + ((useDTDBReversalCandle and (dtdbBullEngulf or dtdbBullPin)) ? 15 : 0) + (tbBreakDone ? 15 : 0) + (tbRetest ? 10 : 0) + (tbIsSweep ? 5 : 0))
    dtdbQuality := math.max(math.max(dtQuality, dbQuality), math.max(ttQuality, tbQuality))
    bool qualityOk = not useDTDBQualityFilter or dtdbQuality >= minDTDBQuality
    bool quickOkTt = not useQuickRev or revSpeedOkTt
    bool quickOkTb = not useQuickRev or revSpeedOkTb

    // ---- Signal 判定 ----
    bool dtBreakSignal  = dtBreak and dtReversal and qualityOk and quickOkDt
    bool dtRetestSignal = dtRetest and dtReversal and qualityOk and quickOkDt
    bool dtSweepSignal  = dtSweepPattern and dtReversal and qualityOk and quickOkDt
    bool dbBreakSignal  = dbBreak and dbReversal and qualityOk and quickOkDb
    bool dbRetestSignal = dbRetest and dbReversal and qualityOk and quickOkDb
    bool dbSweepSignal  = dbSweepPattern and dbReversal and qualityOk and quickOkDb
    bool ttBreakSignal  = ttBreak and dtReversal and qualityOk and quickOkTt
    bool ttRetestSignal = ttRetest and dtReversal and qualityOk and quickOkTt
    bool ttSweepSignal  = ttSweepPattern and dtReversal and qualityOk and quickOkTt
    bool tbBreakSignal  = tbBreak and dbReversal and qualityOk and quickOkTb
    bool tbRetestSignal = tbRetest and dbReversal and qualityOk and quickOkTb
    bool tbSweepSignal  = tbSweepPattern and dbReversal and qualityOk and quickOkTb

    // 否定は逆方向 Bias
    bool dbByInvalidation = dtInvalidation
    bool dtByInvalidation = dbInvalidation
    bool tbByInvalidation = ttInvalidation
    bool ttByInvalidation = tbInvalidation

    // ---- Bias (dtdbEntryMode を適用) ----
    // Pattern … DT/DB・TT/TB の「形が出た時点」で許可 (ブレイク/リテスト等を待たない)
    //           Long = dbPattern or tripleBottomPattern / Short = dtPattern or tripleTopPattern
    // Any     … 全シグナル / BreakOnly/RetestOnly/… … 各シグナルのみ
    bool dtdbBiasLongRaw  = dbBreakSignal or dbRetestSignal or dbSweepSignal or dbByInvalidation or tbBreakSignal or tbRetestSignal or tbSweepSignal or tbByInvalidation
    bool dtdbBiasShortRaw = dtBreakSignal or dtRetestSignal or dtSweepSignal or dtByInvalidation or ttBreakSignal or ttRetestSignal or ttSweepSignal or ttByInvalidation
    dtdbBiasLong  := dtdbEntryMode == "Pattern" ? (dbPattern or tripleBottomPattern) : dtdbEntryMode == "InvalidationOnly" ? (dbByInvalidation or tbByInvalidation) : dtdbEntryMode == "BreakOnly" ? (dbBreakSignal or tbBreakSignal) : dtdbEntryMode == "RetestOnly" ? (dbRetestSignal or tbRetestSignal) : dtdbEntryMode == "SweepOnly" ? (dbSweepSignal or tbSweepSignal) : dtdbBiasLongRaw
    dtdbBiasShort := dtdbEntryMode == "Pattern" ? (dtPattern or tripleTopPattern) : dtdbEntryMode == "InvalidationOnly" ? (dtByInvalidation or ttByInvalidation) : dtdbEntryMode == "BreakOnly" ? (dtBreakSignal or ttBreakSignal) : dtdbEntryMode == "RetestOnly" ? (dtRetestSignal or ttRetestSignal) : dtdbEntryMode == "SweepOnly" ? (dtSweepSignal or ttSweepSignal) : dtdbBiasShortRaw

    // ---- NoTrade ----
    bool anyTopPattern    = dtPattern or tripleTopPattern
    bool anyBottomPattern = dbPattern or tripleBottomPattern
    bool rConflict = anyTopPattern and anyBottomPattern
    bool rLowQual  = useDTDBQualityFilter and (anyTopPattern or anyBottomPattern) and not qualityOk
    bool rExpired  = dtExpiredEvent or dbExpiredEvent or ttExpiredEvent or tbExpiredEvent
    bool rFailedRS = dtRightSideFailed or dbRightSideFailed or ttRightSideFailed or tbRightSideFailed
    bool rInval    = dtInvalidation or dbInvalidation or ttInvalidation or tbInvalidation
    // Patternモード … 「形が出たらWinZone OK」の思想。基本 rConflict/rLowQual のみ禁止。
    //   rExpired / rFailedRS / rInval は Pattern では NoTrade に入れない。
    // Pattern以外 … 従来通り。ただし rFailedRS は useDTDBRightSideFailNoTrade=true の時だけ。
    bool isDTDBPatternMode = dtdbEntryMode == "Pattern"
    bool rFailedRSNoTrade = useDTDBRightSideFailNoTrade and rFailedRS
    int dtdbNoTradeReason = rConflict ? 1 : rLowQual ? 2 : (not isDTDBPatternMode and rExpired) ? 3 : (not isDTDBPatternMode and rFailedRSNoTrade) ? 4 : (not isDTDBPatternMode and rInval) ? 5 : 0
    dtdbNoTrade      := isDTDBPatternMode ? (rConflict or rLowQual) : (rConflict or rLowQual or rExpired or rFailedRSNoTrade or rInval)
    dtdbNoTradeLong  := dtdbNoTrade
    dtdbNoTradeShort := dtdbNoTrade

    // ---- Signal Type ----
    dtdbSignalType := dtdbNoTrade ? 11 : dtInvalidation ? 7 : dbInvalidation ? 8 : ttInvalidation ? 18 : tbInvalidation ? 19 : dtRetest ? 5 : dbRetest ? 6 : ttRetest ? 16 : tbRetest ? 17 : dtBreak ? 3 : dbBreak ? 4 : ttBreak ? 14 : tbBreak ? 15 : dtSweepPattern ? 9 : dbSweepPattern ? 10 : ttSweepPattern ? 20 : tbSweepPattern ? 21 : tripleTopPattern ? 12 : tripleBottomPattern ? 13 : dtPattern ? 1 : dbPattern ? 2 : 0

    // ---- Direction ----
    dtdbDirection := (dtdbBiasLong and not dtdbBiasShort) ? 1 : (dtdbBiasShort and not dtdbBiasLong) ? -1 : 0

    // ---- Rank (0〜10) ----
    bool anyRetest = dtRetest or dbRetest or ttRetest or tbRetest
    bool anyBreak  = dtBreak or dbBreak or ttBreak or tbBreak
    bool anyInval  = dtInvalidation or dbInvalidation or ttInvalidation or tbInvalidation
    bool anySweep  = dtSweepPattern or dbSweepPattern or ttSweepPattern or tbSweepPattern
    bool anyRev    = dtReversal or dbReversal
    dtdbRank := (anySweep and anyRetest and dtdbQuality >= 80) ? 10 : anyInval ? 9 : dtdbQuality >= 80 ? 8 : dtdbQuality >= 70 ? 7 : anySweep ? 6 : (anyRetest and anyRev) ? 5 : anyRetest ? 4 : anyBreak ? 3 : (qualityOk and dtdbQuality > 0) ? 2 : (dtPattern or dbPattern or tripleTopPattern or tripleBottomPattern) ? 1 : 0

    // ---- 表示 : ネックライン (line で描画 → plot上限を消費しない) ----
    var line lnNeckDT = na
    var line lnNeckDB = na
    var line lnNeckTT = na
    var line lnNeckTB = na
    lnNeckDT := f_dtdbNeck(lnNeckDT, showDTDBLines, dtPatternFound, necklineDT, dtPatternBar, color.new(color.red, 0))
    lnNeckDB := f_dtdbNeck(lnNeckDB, showDTDBLines, dbPatternFound, necklineDB, dbPatternBar, color.new(color.green, 0))
    lnNeckTT := f_dtdbNeck(lnNeckTT, showDTDBLines, ttPatternFound, necklineTT, ttPatternBar, color.new(color.maroon, 0))
    lnNeckTB := f_dtdbNeck(lnNeckTB, showDTDBLines, tbPatternFound, necklineTB, tbPatternBar, color.new(color.teal, 0))

    // ---- 表示 : ラベル (状態変化時のみ) ----
    if showDTDBLabels
        if dtPattern and not dtPattern[1]
            label.new(bar_index, high, "Double Top", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 30), textcolor = color.white, size = size.small)
        if dbPattern and not dbPattern[1]
            label.new(bar_index, low, "Double Bottom", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 30), textcolor = color.white, size = size.small)
        if dtBreak and not dtBreak[1]
            label.new(bar_index, high, "DT Break", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
        if dbBreak and not dbBreak[1]
            label.new(bar_index, low, "DB Break", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.orange, 0), textcolor = color.white, size = size.small)
        if dtRetest and not dtRetest[1]
            label.new(bar_index, high, "DT Retest", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
        if dbRetest and not dbRetest[1]
            label.new(bar_index, low, "DB Retest", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
        if dtInvalidation and not dtInvalidation[1]
            label.new(bar_index, low, "DT Invalid", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
        if dbInvalidation and not dbInvalidation[1]
            label.new(bar_index, high, "DB Invalid", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.blue, 0), textcolor = color.white, size = size.small)
        if dtSweepPattern and not dtSweepPattern[1]
            label.new(bar_index, high, "DT Sweep", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
        if dbSweepPattern and not dbSweepPattern[1]
            label.new(bar_index, low, "DB Sweep", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.purple, 0), textcolor = color.white, size = size.small)
        if tripleTopPattern and not tripleTopPattern[1]
            label.new(bar_index, high, "Triple Top", style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.maroon, 20), textcolor = color.white, size = size.small)
        if tripleBottomPattern and not tripleBottomPattern[1]
            label.new(bar_index, low, "Triple Bottom", style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.teal, 20), textcolor = color.white, size = size.small)

    // ---- 表示 : Debug Table ----
    var table dtdbDbg = table.new(position.middle_right, 2, 28, border_width = 1)
    if showDTDBDebugTable and barstate.islast
        string sDir = dtdbDirection == 1 ? "BUY" : dtdbDirection == -1 ? "SELL" : "-"
        string sState = dtdbNoTrade ? "NoTrade" : dtdbBiasLong ? "BIAS L" : dtdbBiasShort ? "BIAS S" : "-"
        table.cell(dtdbDbg, 0, 0,  "DTDB State", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(dtdbDbg, 1, 0,  sState, text_color = color.white, bgcolor = dtdbNoTrade ? color.new(color.red, 20) : color.new(color.blue, 0))
        table.cell(dtdbDbg, 0, 1,  "SignalType", text_color = color.white)
        table.cell(dtdbDbg, 1, 1,  f_dtdbTypeStr(dtdbSignalType), text_color = color.white)
        table.cell(dtdbDbg, 0, 2,  "Direction", text_color = color.white)
        table.cell(dtdbDbg, 1, 2,  sDir, text_color = color.white)
        table.cell(dtdbDbg, 0, 3,  "Rank / Quality", text_color = color.white)
        table.cell(dtdbDbg, 1, 3,  str.tostring(dtdbRank) + " / " + str.tostring(dtdbQuality), text_color = color.white)
        table.cell(dtdbDbg, 0, 4,  "DT/DB Qual", text_color = color.white)
        table.cell(dtdbDbg, 1, 4,  str.tostring(dtQuality) + " / " + str.tostring(dbQuality), text_color = color.white)
        table.cell(dtdbDbg, 0, 5,  "DT/DB Pat", text_color = color.white)
        table.cell(dtdbDbg, 1, 5,  (dtPattern ? "Y" : "N") + " / " + (dbPattern ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 6,  "DT/DB Break", text_color = color.white)
        table.cell(dtdbDbg, 1, 6,  (dtBreakDone ? "Y" : "N") + " / " + (dbBreakDone ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 7,  "DT/DB Retest", text_color = color.white)
        table.cell(dtdbDbg, 1, 7,  (dtRetest ? "Y" : "N") + " / " + (dbRetest ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 8,  "DT/DB Inval", text_color = color.white)
        table.cell(dtdbDbg, 1, 8,  (dtInvalidated ? "Y" : "N") + " / " + (dbInvalidated ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 9,  "DT/DB Sweep", text_color = color.white)
        table.cell(dtdbDbg, 1, 9,  (dtSweepPattern ? "Y" : "N") + " / " + (dbSweepPattern ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 10, "NoTrade Reason", text_color = color.white)
        table.cell(dtdbDbg, 1, 10, f_dtdbReasonStr(dtdbNoTradeReason), text_color = color.white)
        table.cell(dtdbDbg, 0, 11, "Bias(mode) L/S", text_color = color.white)
        table.cell(dtdbDbg, 1, 11, (dtdbBiasLong ? "L" : "-") + " / " + (dtdbBiasShort ? "S" : "-"), text_color = color.white)
        table.cell(dtdbDbg, 0, 12, "Entry Mode", text_color = color.white)
        table.cell(dtdbDbg, 1, 12, dtdbEntryMode, text_color = color.white)
        table.cell(dtdbDbg, 0, 13, "Stage DT/DB", text_color = color.white)
        table.cell(dtdbDbg, 1, 13, str.tostring(dtStage) + " / " + str.tostring(dbStage), text_color = color.white)
        table.cell(dtdbDbg, 0, 14, "TT/TB Pattern", text_color = color.white)
        table.cell(dtdbDbg, 1, 14, (tripleTopPattern ? "Y" : "N") + " / " + (tripleBottomPattern ? "Y" : "N"), text_color = color.white)
        table.cell(dtdbDbg, 0, 15, "Touch Top/Bot", text_color = color.white)
        table.cell(dtdbDbg, 1, 15, str.tostring(topTouchCount) + " / " + str.tostring(bottomTouchCount), text_color = color.white)
        table.cell(dtdbDbg, 0, 16, "Pivot H/L", text_color = color.white)
        table.cell(dtdbDbg, 1, 16, str.tostring(array.size(phVals)) + " / " + str.tostring(array.size(plVals)), text_color = color.white)
        table.cell(dtdbDbg, 0, 17, "Triple Enabled", text_color = color.white)
        table.cell(dtdbDbg, 1, 17, useTripleDTDB ? "ON" : "OFF", text_color = color.white)

// ============================================================
// 5b-6. WinZone-DTDB 状態管理
// ------------------------------------------------------------
// dtdbBiasLong/Short のイベントが出たら状態ON、dtdbStateMaxBars 本で期限切れ。
// ※ 状態更新は useDTDBModule かつ useDTDBStateWindow の時だけ実行。
// ============================================================
var bool longDTDBStateOk  = false
var bool shortDTDBStateOk = false
var int  longDTDBStateBar  = na
var int  shortDTDBStateBar = na

// 状態発火イベント = entryMode 適用済みの dtdbBias。
// Pattern時は dtdbBiasLong = (dbPattern or tripleBottomPattern) なので
// 「形が出た瞬間」に状態ONになる (= dtdbPatternLongEvent と同値)。
bool dtdbLongEvent  = dtdbBiasLong
bool dtdbShortEvent = dtdbBiasShort

if useDTDBModule and useDTDBStateWindow
    if dtdbLongEvent
        longDTDBStateOk := true
        longDTDBStateBar := bar_index
    if dtdbShortEvent
        shortDTDBStateOk := true
        shortDTDBStateBar := bar_index
    if longDTDBStateOk and not na(longDTDBStateBar) and bar_index - longDTDBStateBar > dtdbStateMaxBars
        longDTDBStateOk := false
    if shortDTDBStateOk and not na(shortDTDBStateBar) and bar_index - shortDTDBStateBar > dtdbStateMaxBars
        shortDTDBStateOk := false

// --- DTDB 許可 ---
// OFF … 常に許可
// 状態管理OFF … dtdbBias (entryMode 適用済み) の単バー。Pattern時は形が出た足で許可。
// 状態管理ON  … 保持中フラグ (dtdbStateMaxBars 本) かつ 逆張り禁止でない
bool allowLongByDTDB  = not useDTDBModule ? true : useDTDBStateWindow ? (longDTDBStateOk and not dtdbNoTradeLong) : dtdbBiasLong
bool allowShortByDTDB = not useDTDBModule ? true : useDTDBStateWindow ? (shortDTDBStateOk and not dtdbNoTradeShort) : dtdbBiasShort

// ============================================================
// 5b-7. WinZone 統合 (FVG + Trendline/Channel + DT/DB)
// ------------------------------------------------------------
// 3モジュールを winZoneMode(AND/OR)で結合。
// AND … 有効な全モジュールの場所条件を満たす
// OR  … 有効なモジュールのどれかが場所条件を満たす (OFFは不参加)
// trendNoTrade / dtdbNoTrade はどちらのモードでも禁止として掛ける。
// ※ 全モジュールOFF (useFVGFilter=false かつ Trend/DTDB OFF) のときのみ
//   第4項で常時許可 (場所フィルター無し扱い)。
// ※ 既定 (FVGのみON) では AND/OR とも longWinZoneOk == longFVGOk で結果不変。
// ============================================================
bool fvgWinZoneEnabled   = useFVGFilter
bool trendWinZoneEnabled = useTrendlineModule
bool dtdbWinZoneEnabled  = useDTDBModule

bool longWinZoneOk  = winZoneMode == "OR" ? (((fvgWinZoneEnabled and longFVGOk) or (trendWinZoneEnabled and allowLongByTrendline) or (dtdbWinZoneEnabled and allowLongByDTDB) or (not fvgWinZoneEnabled and not trendWinZoneEnabled and not dtdbWinZoneEnabled)) and not trendNoTrade and not dtdbNoTrade) : (longFVGOk and allowLongByTrendline and allowLongByDTDB and not trendNoTrade and not dtdbNoTrade)
bool shortWinZoneOk = winZoneMode == "OR" ? (((fvgWinZoneEnabled and shortFVGOk) or (trendWinZoneEnabled and allowShortByTrendline) or (dtdbWinZoneEnabled and allowShortByDTDB) or (not fvgWinZoneEnabled and not trendWinZoneEnabled and not dtdbWinZoneEnabled)) and not trendNoTrade and not dtdbNoTrade) : (shortFVGOk and allowShortByTrendline and allowShortByDTDB and not trendNoTrade and not dtdbNoTrade)

// ============================================================
// 5c. エントリートリガー統合 (包み足 + 追加条件)
// ------------------------------------------------------------
// 複数トリガーを Any/All/MinCount で結合し、最終シグナルを作る。
// ・包み足は既存の bullEngulf / bearEngulf を再利用 (FVG吸収と共有)。
// ・BOS / EMAリジェクトの ta.* は「ON の時だけ」呼ぶ (OFFで軽量)。
// ・下位足確認は useLowerTFTrigger が ON の時だけ request.security。
// ・出力: allowLongByTrigger / allowShortByTrigger
// ============================================================

// --- 結合判定ヘルパー ---
// Any    … 1つ以上一致
// All    … 有効な全トリガーが一致
// MinCount… minTriggerCount 以上一致
f_combineTrig(int cnt, int enabled) =>
    triggerMode == "Any" ? cnt >= 1 : triggerMode == "All" ? (enabled > 0 and cnt >= enabled) : cnt >= minTriggerCount

// --- 下位足トリガー計算関数 (request.security から呼ばれる) ---
// 戻り値: [bullCount, bearCount]
f_calcTriggers() =>
    float _body     = math.abs(close - open)
    float _range    = high - low
    float _upWick   = high - math.max(open, close)
    float _loWick   = math.min(open, close) - low
    float _bodyRatio = _range > 0 ? _body / _range : 0.0
    float _closePos  = _range > 0 ? (close - low) / _range : 0.0
    bool _pUp = close[1] > open[1]
    bool _pDn = close[1] < open[1]
    float _cHi = math.max(open, close)
    float _cLo = math.min(open, close)
    float _pHi = math.max(open[1], close[1])
    float _pLo = math.min(open[1], close[1])
    bool _engBody = _cHi >= _pHi and _cLo <= _pLo
    // 包み足 品質フィルター (現在足と同条件)
    float _curBodySize  = math.abs(close - open)
    float _prevBodySize = math.abs(close[1] - open[1])
    float _curRangeSize = high - low
    float _engulfAtr = ta.atr(engulfAtrLen)
    bool _engulfRatioOk = not useEngulfBodyRatioFilter or (_prevBodySize > 0 and _curBodySize >= _prevBodySize * engulfBodyRatioMin)
    bool _engulfBodyQualityOk = not useEngulfBodyQualityFilter or (_curRangeSize > 0 and _curBodySize / _curRangeSize >= engulfMinBodyRatio)
    bool _engulfBodyAtrOk = not useEngulfBodyAtrFilter or _curBodySize >= _engulfAtr * engulfMinBodyATR
    bool _engulfQualityOk = _engulfRatioOk and _engulfBodyQualityOk and _engulfBodyAtrOk
    // 包み足 (本体ストラテジーと同じ strict / 反対色ルール + 品質)
    bool _bullEng = useEngulfingTrigger and close > open and (not reqOppColor or _pDn) and (strictEngulf ? _engBody : close >= _pHi) and _engulfQualityOk
    bool _bearEng = useEngulfingTrigger and close < open and (not reqOppColor or _pUp) and (strictEngulf ? _engBody : close <= _pLo) and _engulfQualityOk
    // ピンバー (実体率・最低レンジ フィルター込み)
    float _pinAtr = ta.atr(pinRangeAtrLen)
    bool _pinBodyRatioOk = not usePinBodyRatioFilter or _bodyRatio <= pinMaxBodyRatio
    bool _pinRangeOk = not usePinRangeFilter or _range >= _pinAtr * pinMinRangeATR
    bool _bullPin = usePinbarTrigger and _loWick > _body * pinWickBodyMult and _loWick > _upWick * pinOppWickMaxRatio and _closePos >= trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    bool _bearPin = usePinbarTrigger and _upWick > _body * pinWickBodyMult and _upWick > _loWick * pinOppWickMaxRatio and _closePos <= 1.0 - trigCloseEdgeRatio and _pinBodyRatioOk and _pinRangeOk
    // BOS
    bool _bullBOS = useBOSTrigger and close > ta.highest(high, bosLookback)[1]
    bool _bearBOS = useBOSTrigger and close < ta.lowest(low, bosLookback)[1]
    // EMA リジェクト (傾きフィルター込み)
    float _ema = ta.ema(close, emaLenTrigger)
    float _emaSlope = _ema - _ema[emaRejectSlopeLookback]
    float _emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    float _emaSlopeMin = _emaSlopeAtr * emaRejectSlopeMinATR
    bool _bullEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope > _emaSlopeMin
    bool _bearEMASlopeOk = not useEMARejectSlopeFilter or _emaSlope < -_emaSlopeMin
    bool _bullEMA = useEMARejectTrigger and low <= _ema and close > _ema and close > open and _bullEMASlopeOk
    bool _bearEMA = useEMARejectTrigger and high >= _ema and close < _ema and close < open and _bearEMASlopeOk
    // FVG 形成
    bool _bullFVG = useFVGTriggerFormation and low > high[2]
    bool _bearFVG = useFVGTriggerFormation and high < low[2]
    // 強ローソク
    bool _bullStr = useStrongCandleTrigger and close > open and _bodyRatio >= strongBodyRatio and _closePos >= trigCloseEdgeRatio
    bool _bearStr = useStrongCandleTrigger and close < open and _bodyRatio >= strongBodyRatio and _closePos <= 1.0 - trigCloseEdgeRatio
    int _bullCnt = (_bullEng?1:0)+(_bullPin?1:0)+(_bullBOS?1:0)+(_bullEMA?1:0)+(_bullFVG?1:0)+(_bullStr?1:0)
    int _bearCnt = (_bearEng?1:0)+(_bearPin?1:0)+(_bearBOS?1:0)+(_bearEMA?1:0)+(_bearFVG?1:0)+(_bearStr?1:0)
    [_bullCnt, _bearCnt]

// --- 有効(ON)トリガー数 ---
int enabledTrigCount = (useEngulfingTrigger?1:0) + (usePinbarTrigger?1:0) + (useBOSTrigger?1:0) + (useEMARejectTrigger?1:0) + (useFVGTriggerFormation?1:0) + (useStrongCandleTrigger?1:0)

// --- 現在足のローソク基本量 ---
float trBody     = math.abs(close - open)
float trRange    = high - low
float trUpWick   = high - math.max(open, close)
float trLoWick   = math.min(open, close) - low
float trBodyRatio = trRange > 0 ? trBody / trRange : 0.0
float trClosePos  = trRange > 0 ? (close - low) / trRange : 0.0

// --- 各トリガー (現在足) ---
// 包み足 : 既存 bullEngulf / bearEngulf に品質フィルターを AND (トリガー側のみ)
// ※ FVG吸収で使う bullEngulf / bearEngulf 自体は変更しない。
// 品質 : 1.包み込み率 (実体が前足実体の何倍か) 2.実体率 3.最低実体ATR倍率。
// ta.atr は 包み足トリガーON かつ 実体ATRフィルターON の時だけ呼ぶ (OFFで軽量)。
float curBodySize  = math.abs(close - open)
float prevBodySize = math.abs(close[1] - open[1])
float curRangeSize = high - low
float engulfAtr = na
if useEngulfingTrigger and useEngulfBodyAtrFilter
    engulfAtr := ta.atr(engulfAtrLen)
bool engulfRatioOk = not useEngulfBodyRatioFilter or (prevBodySize > 0 and curBodySize >= prevBodySize * engulfBodyRatioMin)
bool engulfBodyQualityOk = not useEngulfBodyQualityFilter or (curRangeSize > 0 and curBodySize / curRangeSize >= engulfMinBodyRatio)
bool engulfBodyAtrOk = not useEngulfBodyAtrFilter or curBodySize >= engulfAtr * engulfMinBodyATR
bool engulfQualityOk = engulfRatioOk and engulfBodyQualityOk and engulfBodyAtrOk
bool trBullEng = useEngulfingTrigger and bullEngulf and engulfQualityOk
bool trBearEng = useEngulfingTrigger and bearEngulf and engulfQualityOk

// ピンバー : ヒゲ/実体・反対ヒゲ・終値位置 (既存) + 実体率・最低レンジ (品質)
// ta.atr は ピンバーON かつ レンジフィルターON の時だけ呼ぶ (OFFで軽量)
float pinAtr = na
if usePinbarTrigger and usePinRangeFilter
    pinAtr := ta.atr(pinRangeAtrLen)
bool pinBodyRatioOk = not usePinBodyRatioFilter or trBodyRatio <= pinMaxBodyRatio
bool pinRangeOk = not usePinRangeFilter or trRange >= pinAtr * pinMinRangeATR
bool trBullPin = usePinbarTrigger and trLoWick > trBody * pinWickBodyMult and trLoWick > trUpWick * pinOppWickMaxRatio and trClosePos >= trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk
bool trBearPin = usePinbarTrigger and trUpWick > trBody * pinWickBodyMult and trUpWick > trLoWick * pinOppWickMaxRatio and trClosePos <= 1.0 - trigCloseEdgeRatio and pinBodyRatioOk and pinRangeOk

// BOS : ta.highest/lowest は ON の時だけ呼ぶ (OFFで軽量)
float bosHigh = na
float bosLow  = na
if useBOSTrigger
    bosHigh := ta.highest(high, bosLookback)[1]
    bosLow  := ta.lowest(low, bosLookback)[1]
bool trBullBOS = useBOSTrigger and close > bosHigh
bool trBearBOS = useBOSTrigger and close < bosLow

// EMA リジェクト : ta.ema / ta.atr は ON の時だけ呼ぶ (OFFで軽量)
// 傾きフィルター : ロングは EMA が上向き・ショートは下向きの時のみ許可。
// 水平/逆向き (|slope| <= slopeMin) は除外。slopeMin = ATR * 最低傾きATR倍率。
float emaTrig = na
float emaSlope = na
float emaSlopeMin = na
bool emaRejectSlopeLongOk  = true
bool emaRejectSlopeShortOk = true
if useEMARejectTrigger
    emaTrig := ta.ema(close, emaLenTrigger)
    emaSlope := emaTrig - emaTrig[emaRejectSlopeLookback]
    float emaSlopeAtr = ta.atr(emaRejectSlopeAtrLen)
    emaSlopeMin := emaSlopeAtr * emaRejectSlopeMinATR
    emaRejectSlopeLongOk := not useEMARejectSlopeFilter or emaSlope > emaSlopeMin
    emaRejectSlopeShortOk := not useEMARejectSlopeFilter or emaSlope < -emaSlopeMin
bool trBullEMA = useEMARejectTrigger and low <= emaTrig and close > emaTrig and close > open and emaRejectSlopeLongOk
bool trBearEMA = useEMARejectTrigger and high >= emaTrig and close < emaTrig and close < open and emaRejectSlopeShortOk

// FVG 形成 (ta 不要)
bool trBullFVG = useFVGTriggerFormation and low > high[2]
bool trBearFVG = useFVGTriggerFormation and high < low[2]

// 強ローソク (ta 不要)
bool trBullStr = useStrongCandleTrigger and close > open and trBodyRatio >= strongBodyRatio and trClosePos >= trigCloseEdgeRatio
bool trBearStr = useStrongCandleTrigger and close < open and trBodyRatio >= strongBodyRatio and trClosePos <= 1.0 - trigCloseEdgeRatio

int bullTrigCount = (trBullEng?1:0)+(trBullPin?1:0)+(trBullBOS?1:0)+(trBullEMA?1:0)+(trBullFVG?1:0)+(trBullStr?1:0)
int bearTrigCount = (trBearEng?1:0)+(trBearPin?1:0)+(trBearBOS?1:0)+(trBearEMA?1:0)+(trBearFVG?1:0)+(trBearStr?1:0)

bool trigBullCur = f_combineTrig(bullTrigCount, enabledTrigCount)
bool trigBearCur = f_combineTrig(bearTrigCount, enabledTrigCount)

// --- 下位足トリガー (OFF なら request.security を呼ばない) ---
bool trigBullLower = false
bool trigBearLower = false
if useLowerTFTrigger
    [ltBullCnt, ltBearCnt] = request.security(syminfo.tickerid, triggerTF, f_calcTriggers(), lookahead = barmerge.lookahead_off)
    trigBullLower := f_combineTrig(ltBullCnt, enabledTrigCount)
    trigBearLower := f_combineTrig(ltBearCnt, enabledTrigCount)

// --- 現在足 / 下位足 の結合 ---
bool finalBullTrig = not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBullCur : triggerTFMode == "LowerOnly" ? trigBullLower : triggerTFMode == "CurrentAndLower" ? (trigBullCur and trigBullLower) : triggerTFMode == "CurrentOrLower" ? (trigBullCur or trigBullLower) : trigBullCur
bool finalBearTrig = not useLowerTFTrigger or triggerTFMode == "CurrentOnly" ? trigBearCur : triggerTFMode == "LowerOnly" ? trigBearLower : triggerTFMode == "CurrentAndLower" ? (trigBearCur and trigBearLower) : triggerTFMode == "CurrentOrLower" ? (trigBearCur or trigBearLower) : trigBearCur

// --- 逆方向同時発生 NoTrade ---
bool trigNoTrade = useOppositeTriggerNoTrade and finalBullTrig and finalBearTrig

// --- クールダウン (トリガー発火からの経過本数) ---
var int lastTrigBar = na
bool trigFiredNow = finalBullTrig or finalBearTrig
bool trigCooldownOk = not useTriggerCooldown or na(lastTrigBar) or (bar_index - lastTrigBar) > triggerCooldownBars
if trigFiredNow and trigCooldownOk
    lastTrigBar := bar_index

// --- 最終トリガー許可 ---
bool allowLongByTrigger  = finalBullTrig and not trigNoTrade and trigCooldownOk
bool allowShortByTrigger = finalBearTrig and not trigNoTrade and trigCooldownOk

// ============================================================
// 6. ボラフィルタ判定
// ------------------------------------------------------------
// 通常ボラ (volMode) と 高速ボラ (fastVolMode) は独立して評価。
// volMode / fastVolMode は定数入力なので分岐は全バーで一貫し、
// 未使用側の関数 (ta.atr 等) は呼ばれないため軽量。
// ============================================================

// --- 通常ボラ (base) : volMode で選択 ---
bool baseVolOk = true
if volMode == "ATR"
    float baseAtr = atrTf == "" ? ta.atr(atrLenBase) : request.security(syminfo.tickerid, atrTf, ta.atr(atrLenBase)[1], lookahead = barmerge.lookahead_off)
    float atrAvg = ta.sma(baseAtr, volAvgLen)
    bool volAbsOk = baseAtr >= minAtrDollar
    bool volRelOk = atrAvg > 0 and baseAtr >= atrAvg * volRatioMin
    baseVolOk := not useMinVol or (volModeRel ? volRelOk : volAbsOk)
else if volMode == "固定値"
    baseVolOk := (high - low) >= fixedMin
// volMode == OFF のときは baseVolOk = true (通常ボラ無効・関数呼び出しなし)

// --- 高速ボラ (fast) : OFF/ATR/固定値。volMode に関係なく独立して使える ---
bool fastVolPass = true
if fastVolMode == "ATR"
    float fastAtr = ta.atr(fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    float rangeWidthV = ta.highest(high, rangeLookback) - ta.lowest(low, rangeLookback)
    float atrRangeRatio = rangeWidthV > 0 ? fastAtr / rangeWidthV : 0.0
    bool fastAtrOk = fastAtr >= fastAtrMin
    bool bodyAvgOk = bodyAvgFast >= bodyAvgMin
    bool rangeRatioOk = not useRangeRatioFilter or atrRangeRatio >= atrRangeRatioMin
    fastVolPass := fastAtrOk and bodyAvgOk and rangeRatioOk
else if fastVolMode == "固定値"
    // ATRを使わず、直近 fastAtrLen 本の値幅を固定しきい値で判定
    float fastRange = ta.highest(high, fastAtrLen) - ta.lowest(low, fastAtrLen)
    float bodyAvgFast = ta.sma(math.abs(close - open), bodyAvgLen)
    bool fastRangeOk = fastRange >= fastFixedMin
    bool bodyAvgOk = bodyAvgFast >= bodyAvgMin
    fastVolPass := fastRangeOk and bodyAvgOk
// fastVolMode == OFF のときは fastVolPass = true (関数呼び出しなし)

// --- 合成 + 低ボラ解除後の待機 (クールダウン) ---
bool volPassRaw = baseVolOk and fastVolPass
bool volLowNow = not volPassRaw
var int volRecoveryStartBar = na
if volLowNow
    volRecoveryStartBar := na
if not volLowNow and nz(volLowNow[1], false)
    volRecoveryStartBar := bar_index
bool volRecoveryOk = not useVolCooldown or na(volRecoveryStartBar) or (bar_index - volRecoveryStartBar) >= volRecoveryBars

bool volOk = volPassRaw and volRecoveryOk

// ============================================================
// 7. 環境判定関数
// ------------------------------------------------------------
// request.security から各時間足のコンテキストで呼ばれる。
// 戻り値 : [trend, bullScore, bearScore, rangeScore]
// trend = 1=上昇 / 0=レンジ / -1=下降 / na=未判定
// ============================================================
f_envTrend(int minScore) =>
    ema20 = ta.ema(close, len20)
    ema50 = ta.ema(close, len50)
    ema200 = ta.ema(close, len200)
    atr = ta.atr(envAtrLen)

    dist     = math.abs(ema20 - ema50)
    distPrev = dist[convDivBars]
    slope20  = ema20 - ema20[slopeBars]
    slope50  = ema50 - ema50[slopeBars]

    cr20 = ta.crossover(close, ema20) or ta.crossunder(close, ema20)
    cr50 = ta.crossover(close, ema50) or ta.crossunder(close, ema50)
    cnt20 = math.sum(cr20 ? 1.0 : 0.0, crossBars)
    cnt50 = math.sum(cr50 ? 1.0 : 0.0, crossBars)

    rangeWidth = ta.highest(high, rangeBars) - ta.lowest(low, rangeBars)

    // 上昇スコア
    bullScore = 0
    bullScore += useEma20Above50Up   and ema20 > ema50                     ? 1 : 0
    bullScore += useEma20SlopeUp      and slope20 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useEma50SlopeUp      and slope50 >=  atr * slopeMinMult    ? 1 : 0
    bullScore += useCloseAboveEma50   and close > ema50                     ? 1 : 0
    bullScore += useCloseAboveEma200  and close > ema200                    ? 1 : 0
    bullScore += useEmaDistanceWideU  and ema20 > ema50 and dist >= atr * distWideMult ? 1 : 0
    bullScore += useEmaExpansionU     and ema20 > ema50 and dist > distPrev            ? 1 : 0

    // 下降スコア
    bearScore = 0
    bearScore += useEma20Below50Dn   and ema20 < ema50                     ? 1 : 0
    bearScore += useEma20SlopeDown    and slope20 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useEma50SlopeDown    and slope50 <= -atr * slopeMinMult    ? 1 : 0
    bearScore += useCloseBelowEma50   and close < ema50                     ? 1 : 0
    bearScore += useCloseBelowEma200  and close < ema200                    ? 1 : 0
    bearScore += useEmaDistanceWideD  and ema20 < ema50 and dist >= atr * distWideMult ? 1 : 0
    bearScore += useEmaExpansionD     and ema20 < ema50 and dist > distPrev            ? 1 : 0

    // レンジスコア
    rangeScore = 0
    rangeScore += useEmaDistanceNarrow and dist <= atr * distNarrowMult              ? 1 : 0
    rangeScore += useEma20SlopeWeak     and math.abs(slope20) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEma50SlopeWeak     and math.abs(slope50) <= atr * slopeMinMult  ? 1 : 0
    rangeScore += useEmaCompression     and dist < distPrev                          ? 1 : 0
    rangeScore += useEma20CrossCount    and cnt20 >= crossMinCount                    ? 1 : 0
    rangeScore += useEma50CrossCount    and cnt50 >= crossMinCount                    ? 1 : 0
    rangeScore += useRangeWidthSmall    and rangeWidth <= atr * rangeMult             ? 1 : 0

    maxScore = math.max(bullScore, math.max(bearScore, rangeScore))
    isBullTop  = bullScore == maxScore
    isBearTop  = bearScore == maxScore
    isRangeTop = rangeScore == maxScore
    topCount   = (isBullTop ? 1 : 0) + (isBearTop ? 1 : 0) + (isRangeTop ? 1 : 0)
    tie        = topCount > 1

    int trend = na
    if maxScore < minScore
        trend := insufficientAsRange ? 0 : na
    else if tie
        trend := tieAsRange ? 0 : na
    else if isBullTop
        trend := 1
    else if isBearTop
        trend := -1
    else
        trend := 0
    [trend, bullScore, bearScore, rangeScore]

// 環境テーブル用ヘルパー
// 要求文字列 → コード (1=上昇/0=レンジ/-1=下降/na=OFF)
f_reqCode(string s) =>
    s == "上昇" ? 1 : s == "レンジ" ? 0 : s == "下降" ? -1 : na

// 実際のトレンド値 → 表示文字列
f_trendTxt(float tr) =>
    na(tr) ? "未判定" : tr == 1 ? "上昇" : tr == -1 ? "下降" : "レンジ"

// 要求文字列 → カラー
f_reqCol(string s) =>
    s == "上昇" ? colUp : s == "下降" ? colDown : s == "レンジ" ? colRange : colOff

// ============================================================
// 8. 環境フィルタ計算
// ------------------------------------------------------------
// useEnvFilter は定数入力。OFF のときは if ブロックに入らず、
// request.security を一切呼ばないため軽い。
// ============================================================
bool allowByEnv = true
int envEnabled = 0
int envMatched = 0

var table envTable = table.new(position.top_right, 3, 6, border_width = 1)

if useEnvFilter
    [raw4H,  bull4H,  bear4H,  range4H ] = request.security(syminfo.tickerid, tf4H,  f_envTrend(minScore4H),  lookahead = barmerge.lookahead_off)
    [raw1H,  bull1H,  bear1H,  range1H ] = request.security(syminfo.tickerid, tf1H,  f_envTrend(minScore1H),  lookahead = barmerge.lookahead_off)
    [raw15M, bull15M, bear15M, range15M] = request.security(syminfo.tickerid, tf15M, f_envTrend(minScore15M), lookahead = barmerge.lookahead_off)
    [raw5M,  bull5M,  bear5M,  range5M ] = request.security(syminfo.tickerid, tf5M,  f_envTrend(minScore5M),  lookahead = barmerge.lookahead_off)
    [raw1M,  bull1M,  bear1M,  range1M ] = request.security(syminfo.tickerid, tf1M,  f_envTrend(minScore1M),  lookahead = barmerge.lookahead_off)

    // 各TF : 有効か / 実際が要求と一致か
    en4H  = reqTrend4H  != "OFF"
    en1H  = reqTrend1H  != "OFF"
    en15M = reqTrend15M != "OFF"
    en5M  = reqTrend5M  != "OFF"
    en1M  = reqTrend1M  != "OFF"

    m4H  = en4H  and not na(raw4H)  and raw4H  == f_reqCode(reqTrend4H)
    m1H  = en1H  and not na(raw1H)  and raw1H  == f_reqCode(reqTrend1H)
    m15M = en15M and not na(raw15M) and raw15M == f_reqCode(reqTrend15M)
    m5M  = en5M  and not na(raw5M)  and raw5M  == f_reqCode(reqTrend5M)
    m1M  = en1M  and not na(raw1M)  and raw1M  == f_reqCode(reqTrend1M)

    envEnabled := (en4H ? 1 : 0) + (en1H ? 1 : 0) + (en15M ? 1 : 0) + (en5M ? 1 : 0) + (en1M ? 1 : 0)
    envMatched := (m4H ? 1 : 0) + (m1H ? 1 : 0) + (m15M ? 1 : 0) + (m5M ? 1 : 0) + (m1M ? 1 : 0)

    // 必要一致数 (0=有効な全TF)。有効TFが無ければ制限なし。
    int needMatch = reqMatchCount == 0 ? envEnabled : reqMatchCount
    allowByEnv := envEnabled == 0 or envMatched >= needMatch

    // 環境テーブル : TF | 要求 | 実際
    if showEnvTable and barstate.islast
        table.cell(envTable, 0, 0, "TF",   text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 1, 0, "要求", text_color = color.white, bgcolor = color.new(color.blue, 0))
        table.cell(envTable, 2, 0, "実際", text_color = color.white, bgcolor = color.new(color.blue, 0))
        labels = array.from("4H", "1H", "15M", "5M", "1M")
        reqArr = array.from(reqTrend4H, reqTrend1H, reqTrend15M, reqTrend5M, reqTrend1M)
        detArr = array.from(raw4H, raw1H, raw15M, raw5M, raw1M)
        for i = 0 to 4
            row  = i + 1
            reqS = array.get(reqArr, i)
            det  = array.get(detArr, i)
            en   = reqS != "OFF"
            matched = en and not na(det) and det == f_reqCode(reqS)
            detCol  = not en ? colOff : matched ? color.new(color.green, 0) : color.new(color.red, 0)
            table.cell(envTable, 0, row, array.get(labels, i), text_color = color.white, bgcolor = color.new(color.gray, 30))
            table.cell(envTable, 1, row, reqS,               text_color = color.white, bgcolor = f_reqCol(reqS))
            table.cell(envTable, 2, row, en ? f_trendTxt(det) : "-", text_color = color.white, bgcolor = detCol)

// 環境フィルタ最終判定 (OFF なら常に許可)。ロング/ショート共通の環境テンプレート。
bool envLongOk  = not useEnvFilter or allowByEnv
bool envShortOk = not useEnvFilter or allowByEnv

// ============================================================
// 8b. Momentum モジュール (ストキャス) : 勢い・タイミング確認
// ------------------------------------------------------------
// ※ 環境認識(トレンド判定)とは完全に独立。allowByEnv / envLongOk /
//   envShortOk には絶対に混ぜない。
// 設計順序上は FVG(場所) の次・Trigger(価格アクション) の前の
// 「勢いが反転したか」の確認。状態保持し、その後 Trigger を待つ。
// 役割: 勢い / 押し目・戻り / エントリータイミング / 逆張り禁止。
// 出力: allowLongByStoch / allowShortByStoch / stochNoTrade
//        → 上位の allowLongByMomentum / allowShortByMomentum に集約。
// ※ ストキャスの判定ロジックは単体モジュール版と同一。接続のみ追加。
// ============================================================

// ストキャス全体の有効フラグ (Momentumモジュール かつ ストキャスON)
bool sAct = useMomentumModule and useStochMomentum

// --- ストキャス計算 (関数化 → 参照TF切り替え可能) ---
// useStochTF=false … チャート足で計算 (従来挙動)
// useStochTF=true  … stochTF で計算 (request.security / lookahead_off で未来参照防止)
f_stochCalc() =>
    float _rawK = ta.stoch(close, high, low, kLen)
    float _k = ta.sma(_rawK, kSmooth)
    float _d = ta.sma(_k, dLen)
    [_k, _d]

// ※ 三項演算子 ?: はタプルを返せないため if/else で分岐 (request.security は useStochTF=true 時のみ)
float stochK = na
float stochD = na
if useStochTF
    [k1, d1] = request.security(syminfo.tickerid, stochTF, f_stochCalc(), lookahead = barmerge.lookahead_off)
    stochK := k1
    stochD := d1
else
    [k2, d2] = f_stochCalc()
    stochK := k2
    stochD := d2

// 共通の傾き / クロス
bool slopeUp    = stochK > stochK[1]
bool slopeDown  = stochK < stochK[1]
bool kdCrossUp   = ta.crossover(stochK, stochD)
bool kdCrossDown = ta.crossunder(stochK, stochD)

// 共通フィルター
f_dirOK(bool isBuy) =>
    bool d = not useKDirectionFilter or (isBuy ? slopeUp : slopeDown)
    bool r = not useKDRelationFilter or (isBuy ? stochK > stochD : stochK < stochD)
    d and r

// --- A: Extreme Reversal (90/10 折り返し) ---
bool turnDown = (useExtremeSlopeTurn and slopeDown) or (useExtremeKDCross and kdCrossDown)
bool turnUp   = (useExtremeSlopeTurn and slopeUp) or (useExtremeKDCross and kdCrossUp)

float stochSlope = stochK - stochK[1]
bool slopeStrengthOK_sell = not useSlopeStrengthFilter or stochSlope <= -stochSlopeMin
bool slopeStrengthOK_buy  = not useSlopeStrengthFilter or stochSlope >= stochSlopeMin

var bool wasExtremeHigh = false
var bool wasExtremeLow = false
var bool extremeHighTriggered = false
var bool extremeLowTriggered = false
var float lastExtremeHighValue = na
var float lastExtremeLowValue = na

if stochK >= extremeHigh
    wasExtremeHigh := true
    lastExtremeHighValue := na(lastExtremeHighValue) ? stochK : math.max(lastExtremeHighValue, stochK)
if stochK <= extremeLow
    wasExtremeLow := true
    lastExtremeLowValue := na(lastExtremeLowValue) ? stochK : math.min(lastExtremeLowValue, stochK)
if stochK <= extremeResetLevelHigh
    wasExtremeHigh := false
    extremeHighTriggered := false
    lastExtremeHighValue := na
if stochK >= extremeResetLevelLow
    wasExtremeLow := false
    extremeLowTriggered := false
    lastExtremeLowValue := na

bool retraceOK_sell = not useExtremeRetraceFilter or (not na(lastExtremeHighValue) and (lastExtremeHighValue - stochK) >= extremeRetraceMin)
bool retraceOK_buy  = not useExtremeRetraceFilter or (not na(lastExtremeLowValue) and (stochK - lastExtremeLowValue) >= extremeRetraceMin)

bool exSell = sAct and useExtremeReversal and wasExtremeHigh and (not useExtremeOneShot or not extremeHighTriggered) and turnDown and slopeStrengthOK_sell and retraceOK_sell and f_dirOK(false)
bool exBuy  = sAct and useExtremeReversal and wasExtremeLow and (not useExtremeOneShot or not extremeLowTriggered) and turnUp and slopeStrengthOK_buy and retraceOK_buy and f_dirOK(true)

if exSell
    extremeHighTriggered := true
if exBuy
    extremeLowTriggered := true

// --- B: OB/OS Cross (80/20 クロス) ---
bool obSell = sAct and useOBOSCross and stochK > obLevel and kdCrossDown and f_dirOK(false)
bool obBuy  = sAct and useOBOSCross and stochK < osLevel and kdCrossUp and f_dirOK(true)

// --- C: Middle Cross (50 抜け / 順張り勢い確認) ---
bool midBuy  = sAct and useMiddleCross and ta.crossover(stochK, middleLevel) and stochK > stochD and f_dirOK(true)
bool midSell = sAct and useMiddleCross and ta.crossunder(stochK, middleLevel) and stochK < stochD and f_dirOK(false)

// --- D: Trend Stickiness (張り付き → 逆張り禁止) ---
var int bullStickCount = 0
var int bearStickCount = 0
bullStickCount := stochK >= obLevel ? bullStickCount + 1 : 0
bearStickCount := stochK <= osLevel ? bearStickCount + 1 : 0
bool stochBullSticky = sAct and useStickinessFilter and bullStickCount >= stickBars
bool stochBearSticky = sAct and useStickinessFilter and bearStickCount >= stickBars
bool stochNoSell = stochBullSticky   // 強い上昇中はSELL禁止
bool stochNoBuy  = stochBearSticky   // 強い下降中はBUY禁止

// --- E/F: Divergence (pivot ベース) ---
float pricePH = ta.pivothigh(high, divPivotLen, divPivotLen)
float pricePL = ta.pivotlow(low, divPivotLen, divPivotLen)
float stochAtPivot = stochK[divPivotLen]

var float phPrev = na
var float phLast = na
var float shHPrev = na
var float shHLast = na
var int   phBarPrev = na
var int   phBarLast = na
var float plPrev = na
var float plLast = na
var float shLPrev = na
var float shLLast = na
var int   plBarPrev = na
var int   plBarLast = na

bool newPH = not na(pricePH)
bool newPL = not na(pricePL)
if newPH
    phPrev := phLast
    shHPrev := shHLast
    phBarPrev := phBarLast
    phLast := pricePH
    shHLast := stochAtPivot
    phBarLast := bar_index - divPivotLen
if newPL
    plPrev := plLast
    shLPrev := shLLast
    plBarPrev := plBarLast
    plLast := pricePL
    shLLast := stochAtPivot
    plBarLast := bar_index - divPivotLen

bool phInRange = not na(phPrev) and (phBarLast - phBarPrev) <= divLookback
bool plInRange = not na(plPrev) and (plBarLast - plBarPrev) <= divLookback

bool regSell = sAct and useRegularDivergence and newPH and phInRange and phLast > phPrev and shHLast < shHPrev
bool regBuy  = sAct and useRegularDivergence and newPL and plInRange and plLast < plPrev and shLLast > shLPrev
bool hidBuy  = sAct and useHiddenDivergence and newPL and plInRange and plLast > plPrev and shLLast < shLPrev
bool hidSell = sAct and useHiddenDivergence and newPH and phInRange and phLast < phPrev and shHLast > shHPrev

// --- Signal Direction (優先: Regular > Hidden > Extreme > OBOS > Middle) ---
bool anyReg = regBuy or regSell
bool anyHid = hidBuy or hidSell
bool anyEx  = exBuy or exSell
bool anyOB  = obBuy or obSell
bool anyMid = midBuy or midSell

int stochDirection = not sAct ? 0 : anyReg ? (regBuy ? 1 : -1) : anyHid ? (hidBuy ? 1 : -1) : anyEx ? (exBuy ? 1 : -1) : anyOB ? (obBuy ? 1 : -1) : anyMid ? (midBuy ? 1 : -1) : 0

// Signal Type (1=Extreme/2=OBOS/3=Middle/4=RegDiv/5=HidDiv)
int stochSignalType = not sAct ? 0 : anyReg ? 4 : anyHid ? 5 : anyEx ? 1 : anyOB ? 2 : anyMid ? 3 : 0

// --- ストキャス イベント (そのバーで発生したシグナル) ---
bool stochLongEvent  = sAct and stochDirection == 1 and not stochNoBuy
bool stochShortEvent = sAct and stochDirection == -1 and not stochNoSell

// --- ストキャス 状態管理 : イベント発生後 stochStateMaxBars 本 OK を保持 ---
// タイミングズレ (ストキャス→FVG→トリガー) で弾かれ回数が減るのを緩和。
// ※ A〜Fパターン判定は不変。イベントを状態化して allow を状態ベースにするだけ。
var bool stochLongStateOk  = false
var bool stochShortStateOk = false
var int  stochLongStateBar  = na
var int  stochShortStateBar = na
var int  stochLongStateType  = 0
var int  stochShortStateType = 0

if useStochStateWindow
    if stochLongEvent
        stochLongStateOk := true
        stochLongStateBar := bar_index
        stochLongStateType := stochSignalType
    if stochShortEvent
        stochShortStateOk := true
        stochShortStateBar := bar_index
        stochShortStateType := stochSignalType
    if stochLongStateOk and not na(stochLongStateBar) and bar_index - stochLongStateBar > stochStateMaxBars
        stochLongStateOk := false
    if stochShortStateOk and not na(stochShortStateBar) and bar_index - stochShortStateBar > stochStateMaxBars
        stochShortStateOk := false

// --- ストキャス 接続用出力 (状態ベース) ---
// sAct=false … 通過 (Momentum側でOFF扱い)
// 状態管理ON … 保持中フラグ かつ 逆張り禁止でない
// 状態管理OFF … 従来のイベント単バー
bool allowLongByStoch  = not sAct ? true : useStochStateWindow ? (stochLongStateOk and not stochNoBuy) : stochLongEvent
bool allowShortByStoch = not sAct ? true : useStochStateWindow ? (stochShortStateOk and not stochNoSell) : stochShortEvent
bool stochNoTrade = sAct and (stochNoBuy or stochNoSell)

// ============================================================
// 8c. Momentum 集約 (将来 RSI/MACD/CCI/ADX/ROC も同じ構造で追加)
// ------------------------------------------------------------
// 各Momentum指標の long/short 許可を momentumMode(AND/OR)で結合。
// 現状はストキャスのみ。指標を足す時は momoLong_i / momoShort_i を
// 追加して f_momCombine に組み込む。
// ============================================================
// 各指標の許可 (OFFの指標は「通過」= AND中立/OR無効)
bool momoLongStoch  = not useStochMomentum or allowLongByStoch
bool momoShortStoch = not useStochMomentum or allowShortByStoch

// 結合 (現状は1指標なのでそのまま。将来は AND=全一致 / OR=いずれか一致)
bool momoLongCombined  = momentumMode == "AND" ? momoLongStoch : momoLongStoch
bool momoShortCombined = momentumMode == "AND" ? momoShortStoch : momoShortStoch

// Momentum NoTrade (現状はストキャスの逆張り禁止のみ)
bool momoNoTrade = stochNoTrade

// 最終 Momentum 許可 (OFFなら常に許可。NoTrade中は禁止)
bool allowLongByMomentum  = not useMomentumModule or (momoLongCombined and not momoNoTrade)
bool allowShortByMomentum = not useMomentumModule or (momoShortCombined and not momoNoTrade)

// ============================================================
// 9. SL / TP / ロット計算
// ============================================================
float patLow  = math.min(low, low[1])
float patHigh = math.max(high, high[1])
float entryEst = close

// SL方式: パターン=包み足の高安ベース / 固定=一定の価格幅
float longStop = slMode == "固定" ? entryEst - slFixed : patLow - slBuf
float longRisk = entryEst - longStop
float longTP   = entryEst + longRisk * rrRatio

float shortStop = slMode == "固定" ? entryEst + slFixed : patHigh + slBuf
float shortRisk = shortStop - entryEst
float shortTP   = entryEst - shortRisk * rrRatio

// 損失許容額 = 基準資金 * リスク%
// 複利 OFF … 元金 (initial_capital) 基準 = 単利
// 複利 ON  … 現在残高 (equity) 基準 = 複利
float baseCapital = useCompound ? strategy.equity : strategy.initial_capital
float riskCapital = baseCapital * riskPct / 100.0

// リスク幅(価格)から整数ロットを算出 (1未満は 0 → エントリーしない)
f_qty(float riskPerUnit) =>
    float raw = riskPerUnit > 0 ? riskCapital / (riskPerUnit * syminfo.pointvalue) : 0.0
    math.floor(raw)

float longQty  = f_qty(longRisk)
float shortQty = f_qty(shortRisk)

// ============================================================
// 10. 最終エントリー条件
// ------------------------------------------------------------
// 設計順序 : 環境認識 → FVG(場所) → Momentum(勢い) → Trigger(価格) → Entry
// ・envLongOk           = どちら向きに狙うか (環境認識)
// ・longWinZoneOk       = どこで狙うか (WinZone = FVG + Trendline/Channel・状態保持)
// ・allowLongByMomentum = 勢いが反転したか (ストキャス・状態保持)
// ・allowLongByTrigger  = 価格が実際に反応したか (EMA/包み足/ピンバー・最後の引き金)
// ・volOk / risk / qty  = 執行フィルタ
// ※ AND条件なので数式結果は順序に依らないが、思想順に並べる。
// ============================================================
bool longSig  = allowLongByTrigger
bool shortSig = allowShortByTrigger

// --- 時間帯フィルタ (東京時間 JST) ---
// Asia 09:00-16:00 / EU 16:00-21:00 / NY 21:00-翌03:00 の中だけ許可。
int jstHour = hour(time, "Asia/Tokyo")
bool inAsia = jstHour >= 9 and jstHour < 16
bool inEU   = jstHour >= 16 and jstHour < 21
bool inNY   = jstHour >= 21 or jstHour < 3
bool sessionOk = not useSessionFilter or (useAsiaSession and inAsia) or (useEUSession and inEU) or (useNYSession and inNY)

bool canLong = useLong and sessionOk and envLongOk and longWinZoneOk and allowLongByMomentum and allowLongByTrigger and volOk and longRisk > 0 and longQty >= 1

bool canShort = useShort and sessionOk and envShortOk and shortWinZoneOk and allowShortByMomentum and allowShortByTrigger and volOk and shortRisk > 0 and shortQty >= 1

// ============================================================
// 11. 発注
// ------------------------------------------------------------
// ポジション保有中は新規シグナルを無視 (ドテンしない)。
// ノーポジ (position_size == 0) のときだけエントリーし、
// 決済は SL / TP のみ。
// ============================================================
bool isFlat = strategy.position_size == 0

if isFlat and canLong
    strategy.entry("Long", strategy.long, qty = longQty)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longTP)
    // エントリー後、同じFVG状態で再入しないよう状態をリセット
    if resetFVGStateAfterEntry
        longFVGStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochLongStateOk := false
    // エントリー後、同じTrendline状態で再入しないよう状態をリセット
    if useTrendlineModule and resetTrendStateAfterEntry
        longTrendStateOk := false
    // エントリー後、同じDTDB状態で再入しないよう状態をリセット
    if useDTDBModule and resetDTDBStateAfterEntry
        longDTDBStateOk := false

if isFlat and canShort
    strategy.entry("Short", strategy.short, qty = shortQty)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortTP)
    // エントリー後、同じFVG状態で再入しないよう状態をリセット
    if resetFVGStateAfterEntry
        shortFVGStateOk := false
    // エントリー後、同じストキャス状態で再入しないよう状態をリセット
    if resetStochStateAfterEntry
        stochShortStateOk := false
    // エントリー後、同じTrendline状態で再入しないよう状態をリセット
    if useTrendlineModule and resetTrendStateAfterEntry
        shortTrendStateOk := false
    // エントリー後、同じDTDB状態で再入しないよう状態をリセット
    if useDTDBModule and resetDTDBStateAfterEntry
        shortDTDBStateOk := false

// ============================================================
// 12. 表示
// ============================================================
// Momentum: ストキャス参照TF 表示 (環境テーブルとは独立)
var table stochTFtbl = table.new(position.bottom_right, 1, 1, border_width = 1)
if barstate.islast and useMomentumModule and useStochMomentum
    string stochTFtxt = useStochTF ? (stochTF == "" ? "chart" : stochTF) : "chart"
    table.cell(stochTFtbl, 0, 0, "Stoch TF: " + stochTFtxt, text_color = color.white, bgcolor = color.new(color.purple, 0))

plotshape(canLong,  "買いエントリー", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(canShort, "売りエントリー", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small)

// Data Window 出力 (デバッグ用) : Env → FVG → Momentum → Trigger → Entry の順

// --- ① 環境認識 (Env) : どちら向きに狙うか ---
plot(envEnabled, "envEnabled", display = display.data_window)
plot(envMatched, "envMatched", display = display.data_window)
plot(envLongOk ? 1 : 0, "envLongOk", display = display.data_window)
plot(envShortOk ? 1 : 0, "envShortOk", display = display.data_window)

// --- ② FVG (WinZone) : どこで狙うか (場所・状態保持) ---
plot(fvgReboundBuy ? 1 : 0, "fvgReboundBuy", display = display.data_window)
plot(fvgReboundSell ? 1 : 0, "fvgReboundSell", display = display.data_window)
plot(fvgAbsorbBuy ? 1 : 0, "fvgAbsorbBuy", display = display.data_window)
plot(fvgAbsorbSell ? 1 : 0, "fvgAbsorbSell", display = display.data_window)
plot(ifvgBuy ? 1 : 0, "ifvgBuy", display = display.data_window)
plot(ifvgSell ? 1 : 0, "ifvgSell", display = display.data_window)
plot(longFVGStateOk ? 1 : 0, "longFVGStateOk", display = display.data_window)
plot(shortFVGStateOk ? 1 : 0, "shortFVGStateOk", display = display.data_window)
plot(longFVGOk ? 1 : 0, "longFVGOk", display = display.data_window)
plot(shortFVGOk ? 1 : 0, "shortFVGOk", display = display.data_window)
// ※ WinZone-Trendline/Channel (trendEntryBuy/Sell, allowLong/ShortByTrendline,
//    longWinZoneOk/shortWinZoneOk, trendSignalType/Direction/Rank/Quality) は
//    Pine の 64 plot 上限に達しているため Data Window には出力していない。
//    → 値は デバッグテーブル(showTrendDebugTable=ON) と エントリー三角(canLong/canShort) で確認する。

// --- ③ Momentum (ストキャス) : 勢いが反転したか (状態保持) ---
plot(stochK, "stochK", display = display.data_window)
plot(stochD, "stochD", display = display.data_window)
plot(useStochTF ? 1 : 0, "useStochTF", display = display.data_window)
plot(stochLongEvent ? 1 : 0, "stochLongEvent", display = display.data_window)
plot(stochShortEvent ? 1 : 0, "stochShortEvent", display = display.data_window)
plot(stochLongStateOk ? 1 : 0, "stochLongStateOk", display = display.data_window)
plot(stochShortStateOk ? 1 : 0, "stochShortStateOk", display = display.data_window)
plot(stochLongStateType, "stochLongStateType", display = display.data_window)
plot(stochShortStateType, "stochShortStateType", display = display.data_window)
plot(allowLongByMomentum ? 1 : 0, "allowLongByMomentum", display = display.data_window)
plot(allowShortByMomentum ? 1 : 0, "allowShortByMomentum", display = display.data_window)
plot(stochNoTrade ? 1 : 0, "stochNoTrade", display = display.data_window)

// --- ④ Trigger : 価格が実際に反応したか (最後の引き金) ---
plot(trBullEng ? 1 : 0, "trBullEng", display = display.data_window)
plot(trBearEng ? 1 : 0, "trBearEng", display = display.data_window)
plot(engulfRatioOk ? 1 : 0, "engulfRatioOk", display = display.data_window)
plot(engulfBodyQualityOk ? 1 : 0, "engulfBodyQualityOk", display = display.data_window)
plot(engulfBodyAtrOk ? 1 : 0, "engulfBodyAtrOk", display = display.data_window)
plot(trBullPin ? 1 : 0, "trBullPin", display = display.data_window)
plot(trBearPin ? 1 : 0, "trBearPin", display = display.data_window)
plot(pinBodyRatioOk ? 1 : 0, "pinBodyRatioOk", display = display.data_window)
plot(pinRangeOk ? 1 : 0, "pinRangeOk", display = display.data_window)
plot(trBullBOS ? 1 : 0, "trBullBOS", display = display.data_window)
plot(trBearBOS ? 1 : 0, "trBearBOS", display = display.data_window)
plot(trBullEMA ? 1 : 0, "trBullEMA", display = display.data_window)
plot(trBearEMA ? 1 : 0, "trBearEMA", display = display.data_window)
plot(useEMARejectSlopeFilter ? 1 : 0, "useEMARejectSlopeFilter", display = display.data_window)
plot(emaSlope, "emaRejectSlope", display = display.data_window)
plot(emaSlopeMin, "emaRejectSlopeMin", display = display.data_window)
plot(emaRejectSlopeLongOk ? 1 : 0, "emaRejectSlopeLongOk", display = display.data_window)
plot(emaRejectSlopeShortOk ? 1 : 0, "emaRejectSlopeShortOk", display = display.data_window)
plot(trBullFVG ? 1 : 0, "trBullFVG", display = display.data_window)
plot(trBearFVG ? 1 : 0, "trBearFVG", display = display.data_window)
plot(trBullStr ? 1 : 0, "trBullStr", display = display.data_window)
plot(trBearStr ? 1 : 0, "trBearStr", display = display.data_window)
plot(bullTrigCount, "bullTrigCount", display = display.data_window)
plot(bearTrigCount, "bearTrigCount", display = display.data_window)
plot(enabledTrigCount, "enabledTrigCount", display = display.data_window)
plot(trigBullLower ? 1 : 0, "trigBullLower", display = display.data_window)
plot(trigBearLower ? 1 : 0, "trigBearLower", display = display.data_window)
plot(allowLongByTrigger ? 1 : 0, "allowLongByTrigger", display = display.data_window)
plot(allowShortByTrigger ? 1 : 0, "allowShortByTrigger", display = display.data_window)
plot(trigNoTrade ? 1 : 0, "trigNoTrade", display = display.data_window)
plot(trigCooldownOk ? 1 : 0, "trigCooldownOk", display = display.data_window)

// --- ⑤ Entry / 執行フィルタ (時間帯・ボラ・ロット) ---
plot(sessionOk ? 1 : 0, "sessionOk", display = display.data_window)
plot(volOk ? 1 : 0, "volOk", display = display.data_window)
plot(longQty, "longQty", display = display.data_window)
plot(shortQty, "shortQty", display = display.data_window)
